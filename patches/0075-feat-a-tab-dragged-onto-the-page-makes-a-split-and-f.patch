new file mode 100644
index 0000000000000..c624df1eda84d
--- /dev/null
+++ b/chrome/browser/ui/views/commandbar/address_row_controls.cc
@@ -0,0 +1,271 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/commandbar/address_row_controls.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/i18n/case_conversion.h"
+#include "base/location.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/extensions/commands/command_service.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/bubble_anchor_util.h"
+#include "chrome/browser/ui/extensions/extensions_container.h"
+#include "chrome/browser/ui/global_media_controls/media_notification_service.h"
+#include "chrome/browser/ui/global_media_controls/media_notification_service_factory.h"
+#include "chrome/browser/ui/page_info/page_info_dialog.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/toolbar/toolbar_action_view_model.h"
+#include "chrome/browser/ui/toolbar/toolbar_actions_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/top_container_view.h"
+#include "chrome/browser/ui/views/global_media_controls/media_dialog_view.h"
+#include "chrome/browser/ui/views/global_media_controls/media_toolbar_button.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "components/global_media_controls/public/constants.h"
+#include "components/global_media_controls/public/media_item_manager.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/common/api/extension_action/action_info.h"
+#include "extensions/common/command.h"
+#include "extensions/common/extension.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/views/bubble/bubble_border.h"
+#include "ui/views/view.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace stedding {
+
+namespace {
+
+const std::vector<ExtensionActionRow>* g_extension_rows_for_testing = nullptr;
+const MediaControlsForTesting* g_media_controls_for_testing = nullptr;
+
+// Runs `task` a turn later, once the command bar that asked has closed: the
+// bar hands the focus back to the page as it closes (commandbar K1), which
+// would close a popup that had opened first.
+void RunAfterTheBarCloses(base::OnceClosure task) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                              std::move(task));
+}
+
+// The extension's own shortcut for its toolbar action, as the menus print
+// it, or empty.
+std::u16string ActionChord(Profile* profile, const std::string& id) {
+  const extensions::Extension* const extension =
+      extensions::ExtensionRegistry::Get(profile)->enabled_extensions().GetByID(
+          id);
+  const extensions::ActionInfo* const info =
+      extension ? extensions::ActionInfo::GetExtensionActionInfo(extension)
+                : nullptr;
+  extensions::CommandService* const commands =
+      extensions::CommandService::Get(profile);
+  if (!info || !commands) {
+    return std::u16string();
+  }
+  extensions::Command command;
+  if (!commands->GetExtensionActionCommand(
+          id, info->type, extensions::CommandService::ACTIVE, &command,
+          /*active=*/nullptr) ||
+      command.accelerator().key_code() == ui::VKEY_UNKNOWN) {
+    return std::u16string();
+  }
+  return command.accelerator().GetShortcutText();
+}
+
+content::WebContents* ActivePage(BrowserWindowInterface* browser) {
+  TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
+  return tabs ? tabs->GetActiveWebContents() : nullptr;
+}
+
+views::View* MediaButtonView(BrowserWindowInterface* browser) {
+  BrowserView* const browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  ToolbarView* const toolbar = browser_view ? browser_view->toolbar() : nullptr;
+  MediaToolbarButton* const button =
+      toolbar ? toolbar->media_button() : nullptr;
+  return button ? button->GetBubbleAnchor().GetIfView() : nullptr;
+}
+
+}  // namespace
+
+ExtensionActionRow::ExtensionActionRow() = default;
+ExtensionActionRow::ExtensionActionRow(const ExtensionActionRow&) = default;
+ExtensionActionRow& ExtensionActionRow::operator=(const ExtensionActionRow&) =
+    default;
+ExtensionActionRow::~ExtensionActionRow() = default;
+
+std::vector<ExtensionActionRow> ExtensionActionRows(
+    BrowserWindowInterface* browser) {
+  if (g_extension_rows_for_testing) {
+    return *g_extension_rows_for_testing;
+  }
+  std::vector<ExtensionActionRow> rows;
+  content::WebContents* const page = ActivePage(browser);
+  ExtensionsContainer* const container =
+      page ? ExtensionsContainer::From(*browser) : nullptr;
+  ToolbarActionsModel* const model =
+      container ? ToolbarActionsModel::Get(browser->GetProfile()) : nullptr;
+  if (!model) {
+    return rows;
+  }
+
+  // The pinned ones as the toolbar orders them, then the rest by name.
+  std::vector<ToolbarActionsModel::ActionId> ids = model->pinned_action_ids();
+  std::vector<ToolbarActionsModel::ActionId> rest;
+  for (const ToolbarActionsModel::ActionId& id : model->action_ids()) {
+    if (!model->IsActionPinned(id)) {
+      rest.push_back(id);
+    }
+  }
+  std::ranges::sort(rest, [&](const ToolbarActionsModel::ActionId& a,
+                              const ToolbarActionsModel::ActionId& b) {
+    return base::i18n::ToLower(model->GetExtensionName(a)) <
+           base::i18n::ToLower(model->GetExtensionName(b));
+  });
+  ids.insert(ids.end(), rest.begin(), rest.end());
+
+  for (const ToolbarActionsModel::ActionId& id : ids) {
+    ToolbarActionViewModel* const action = container->GetActionForId(id);
+    if (!action || !action->IsEnabled(page)) {
+      continue;
+    }
+    ExtensionActionRow row;
+    row.id = id;
+    row.name = action->GetActionName();
+    row.chord = ActionChord(browser->GetProfile(), id);
+    row.run = base::BindRepeating(
+        [](base::WeakPtr<BrowserWindowInterface> browser,
+           const std::string& id) {
+          RunAfterTheBarCloses(base::BindOnce(
+              [](base::WeakPtr<BrowserWindowInterface> browser,
+                 const std::string& id) {
+                ExtensionsContainer* const container =
+                    browser ? ExtensionsContainer::From(*browser) : nullptr;
+                ToolbarActionViewModel* const action =
+                    container ? container->GetActionForId(id) : nullptr;
+                if (action) {
+                  action->ExecuteUserAction(
+                      ToolbarActionViewModel::InvocationSource::kMenuEntry);
+                }
+              },
+              browser, id));
+        },
+        browser->GetWeakPtr(), id);
+    rows.push_back(std::move(row));
+  }
+  return rows;
+}
+
+base::AutoReset<const std::vector<ExtensionActionRow>*>
+SetExtensionActionRowsForTesting(const std::vector<ExtensionActionRow>* rows) {
+  return base::AutoReset<const std::vector<ExtensionActionRow>*>(
+      &g_extension_rows_for_testing, rows);
+}
+
+bool MediaControlsAvailable(BrowserWindowInterface* browser) {
+  if (g_media_controls_for_testing) {
+    return g_media_controls_for_testing->available;
+  }
+  // A media session playing in the profile, as the toolbar's media button
+  // asks, not the button itself: the toolbar's layout hides the button
+  // while the row has no room -- a row hidden since the launch never had any
+  // -- and the bar listed no media controls (2026-10-20).
+  MediaNotificationService* const service =
+      browser ? MediaNotificationServiceFactory::GetForProfile(
+                    browser->GetProfile())
+              : nullptr;
+  return service && service->media_item_manager() &&
+         service->media_item_manager()->HasActiveItems();
+}
+
+void ShowMediaControls(BrowserWindowInterface* browser) {
+  if (g_media_controls_for_testing) {
+    g_media_controls_for_testing->show.Run();
+    return;
+  }
+  RunAfterTheBarCloses(base::BindOnce(
+      [](base::WeakPtr<BrowserWindowInterface> browser) {
+        if (!browser) {
+          return;
+        }
+        // The toolbar's button when it is drawn; else the page card's top
+        // left, under the top container, as an extension's popup (T40). With
+        // the row drawn but too narrow for the button, the dialog hangs from
+        // the row's right end.
+        const views::BubbleAnchor without_the_row =
+            PopupAnchorWithoutTheRow(browser.get());
+        views::View* button = MediaButtonView(browser.get());
+        if (button && !button->IsDrawn()) {
+          BrowserView* const browser_view =
+              BrowserView::GetBrowserViewForBrowser(browser.get());
+          button = browser_view ? browser_view->toolbar() : nullptr;
+        }
+        if (!without_the_row && !button) {
+          return;
+        }
+        Profile* const profile = browser->GetProfile();
+        MediaDialogView::ShowDialog(
+            without_the_row ? without_the_row : views::BubbleAnchor(button),
+            without_the_row ? views::BubbleBorder::TOP_LEFT
+                            : views::BubbleBorder::TOP_RIGHT,
+            MediaNotificationServiceFactory::GetForProfile(profile), profile,
+            /*contents=*/nullptr,
+            global_media_controls::GlobalMediaControlsEntryPoint::kToolbarIcon);
+      },
+      browser->GetWeakPtr()));
+}
+
+base::AutoReset<const MediaControlsForTesting*> SetMediaControlsForTesting(
+    const MediaControlsForTesting* media) {
+  return base::AutoReset<const MediaControlsForTesting*>(
+      &g_media_controls_for_testing, media);
+}
+
+bool SiteInformationAvailable(BrowserWindowInterface* browser) {
+  content::WebContents* const page = ActivePage(browser);
+  content::NavigationEntry* const entry =
+      page ? page->GetController().GetVisibleEntry() : nullptr;
+  if (!entry || entry->IsInitialEntry()) {
+    return false;
+  }
+  const GURL url = entry->GetVirtualURL();
+  return url.SchemeIsHTTPOrHTTPS() || url.SchemeIsFile();
+}
+
+void ShowSiteInformation(BrowserWindowInterface* browser) {
+  RunAfterTheBarCloses(base::BindOnce(
+      [](base::WeakPtr<BrowserWindowInterface> browser) {
+        if (browser) {
+          ShowPageInfoDialog(ActivePage(browser.get()), base::DoNothing(),
+                             bubble_anchor_util::Anchor::kLocationBar);
+        }
+      },
+      browser->GetWeakPtr()));
+}
+
+views::BubbleAnchor PopupAnchorWithoutTheRow(BrowserWindowInterface* browser) {
+  BrowserView* const browser_view =
+      browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+  if (!browser_view || !browser_view->toolbar() ||
+      browser_view->toolbar()->IsDrawn()) {
+    return views::BubbleAnchor();
+  }
+  views::View* const top = browser_view->top_container();
+  if (!top || !top->IsDrawn() || top->bounds().IsEmpty()) {
+    return views::BubbleAnchor();
+  }
+  return views::BubbleAnchor(top);
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/views/commandbar/address_row_controls.h b/chrome/browser/ui/views/commandbar/address_row_controls.h
new file mode 100644
index 0000000000000..830164b683d9f
--- /dev/null
+++ b/chrome/browser/ui/views/commandbar/address_row_controls.h
@@ -0,0 +1,86 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_COMMANDBAR_ADDRESS_ROW_CONTROLS_H_
+#define CHROME_BROWSER_UI_VIEWS_COMMANDBAR_ADDRESS_ROW_CONTROLS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/auto_reset.h"
+#include "base/functional/callback.h"
+#include "ui/views/bubble/bubble_anchor.h"
+
+class BrowserWindowInterface;
+
+namespace stedding {
+
+// What the address row holds that the command bar's actions mode lists too,
+// so it stays reachable while the row is not drawn (docs/features/toolbar.md
+// T13, commandbar K31-K33, BACKLOG S-104): the extension actions, the media
+// controls and the page's site information.
+
+// commandbar K31: one extension action the toolbar offers on the active tab.
+struct ExtensionActionRow {
+  ExtensionActionRow();
+  ExtensionActionRow(const ExtensionActionRow&);
+  ExtensionActionRow& operator=(const ExtensionActionRow&);
+  ~ExtensionActionRow();
+
+  std::string id;
+  // The extension's name, as the extensions menu titles it.
+  std::u16string name;
+  // The extension's own shortcut for its action, as the menus print it, or
+  // empty.
+  std::u16string chord;
+  // Runs the action as a click on its toolbar button does: its popup, its
+  // click event or its side panel.
+  base::RepeatingClosure run;
+};
+
+// The extension actions `browser`'s toolbar offers on its active tab, in the
+// extensions menu's order: the pinned ones as the toolbar orders them, then
+// the rest by name. An action the page disables is left out (K16). A private
+// window lists the extensions allowed in it.
+std::vector<ExtensionActionRow> ExtensionActionRows(
+    BrowserWindowInterface* browser);
+
+// A test window has no toolbar. While the returned value lives,
+// ExtensionActionRows() answers with `rows` instead.
+base::AutoReset<const std::vector<ExtensionActionRow>*>
+SetExtensionActionRowsForTesting(const std::vector<ExtensionActionRow>* rows);
+
+// commandbar K32: whether a media session plays in this profile -- what the
+// toolbar's media button shows for, drawn or not -- and the media dialog,
+// anchored as toolbar T40 says.
+bool MediaControlsAvailable(BrowserWindowInterface* browser);
+void ShowMediaControls(BrowserWindowInterface* browser);
+
+// commandbar K33: whether the active tab's page has site information to show
+// (a web page or a file), and Chromium's page info for it.
+bool SiteInformationAvailable(BrowserWindowInterface* browser);
+void ShowSiteInformation(BrowserWindowInterface* browser);
+
+// A test window has no media button. While the returned value lives, the
+// media controls are available as `media` says, and showing them runs its
+// `show`.
+struct MediaControlsForTesting {
+  bool available = false;
+  base::RepeatingClosure show;
+};
+base::AutoReset<const MediaControlsForTesting*> SetMediaControlsForTesting(
+    const MediaControlsForTesting* media);
+
+// toolbar T40: what a popup the address row anchors hangs from while the row
+// is not drawn: the window's top container, which is the page card's top
+// edge, as the app menu's bubble does before the window shows (T23); with
+// a TOP_LEFT arrow it opens at the card's top left. Null when the row is
+// drawn, or when the top container is not drawn either (full screen), where
+// the caller keeps its own anchor. The extensions container applies the same
+// rule to an extension's popup.
+views::BubbleAnchor PopupAnchorWithoutTheRow(BrowserWindowInterface* browser);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_COMMANDBAR_ADDRESS_ROW_CONTROLS_H_
