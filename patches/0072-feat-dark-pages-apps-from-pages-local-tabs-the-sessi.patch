+// Whether `row`'s border paints anything: an essentials card's 1 DIP edge
+// did, until the card became a tile with no edge (tabs R32).
+bool BorderPaints(views::View* row) {
+  if (!row->GetBorder()) {
+    return false;
+  }
+  gfx::Canvas canvas(row->size(), 1.0f, /*is_opaque=*/false);
+  row->GetBorder()->Paint(*row, &canvas);
+  const SkBitmap& drawn = canvas.GetBitmap();
+  for (int y = 0; y < drawn.height(); ++y) {
+    for (int x = 0; x < drawn.width(); ++x) {
+      if (SkColorGetA(drawn.getColor(x, y)) > 0) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
