new file mode 100644
index 0000000000000..3350b59cb8dd3
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/common/stedding_tab_row_rules.cc
@@ -0,0 +1,29 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/stedding_tab_row_rules.h"
+
+namespace stedding {
+
+bool ShowsCloseGlyph(const TabRowState& row) {
+  if (row.pinned || row.narrow) {
+    return false;
+  }
+  return row.hovered_or_focused;
+}
+
+bool ReservesCloseSlot(const TabRowState& row) {
+  return !row.pinned && !row.narrow;
+}
+
+bool ShowsFavicon(const TabRowState& row) {
+  // Upstream hides a pinned card's icon while an alert shows; Arc keeps it.
+  return true;
+}
+
+bool AlertIsCornerBadge(const TabRowState& row) {
+  return row.pinned && row.alert_showing;
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/views/tabs/common/stedding_tab_row_rules.h b/chrome/browser/ui/views/tabs/common/stedding_tab_row_rules.h
new file mode 100644
index 0000000000000..ca09d82c61287
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/common/stedding_tab_row_rules.h
@@ -0,0 +1,41 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_STEDDING_TAB_ROW_RULES_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_STEDDING_TAB_ROW_RULES_H_
+
+namespace stedding {
+
+// What a sidebar row shows, as Arc shows it (docs/features/tabs.md). The
+// rules are pure functions of the row's state so they can be tested without
+// a TabView; TabViewVerticalLayout::IsChildVisible asks them.
+struct TabRowState {
+  // An essentials card (Chromium-pinned).
+  bool pinned = false;
+  // Narrower than the uncollapsed minimum: the collapsed rail, or a split
+  // half squeezed below it.
+  bool narrow = false;
+  bool active = false;
+  bool hovered_or_focused = false;
+  // The alert indicator (audio, camera, ...) is showing.
+  bool alert_showing = false;
+};
+
+// R1, R3: the close glyph is laid out only while the row is hovered or its
+// close button has keyboard focus; never on an essentials card or the
+// collapsed rail. The active row carries no permanent glyph.
+bool ShowsCloseGlyph(const TabRowState& row);
+
+// R2: on an expanded row the close slot stays reserved whether or not the
+// glyph is drawn, so the title never re-elides on hover.
+bool ReservesCloseSlot(const TabRowState& row);
+
+// R18: an essentials card keeps its favicon whatever the alert; the alert
+// becomes a corner badge instead of replacing the icon.
+bool ShowsFavicon(const TabRowState& row);
+bool AlertIsCornerBadge(const TabRowState& row);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_STEDDING_TAB_ROW_RULES_H_
diff --git a/chrome/browser/ui/views/tabs/common/stedding_tab_row_rules_unittest.cc b/chrome/browser/ui/views/tabs/common/stedding_tab_row_rules_unittest.cc
new file mode 100644
index 0000000000000..1a58f9bd0376a
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/common/stedding_tab_row_rules_unittest.cc
@@ -0,0 +1,88 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/stedding_tab_row_rules.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+// tabs R1: the active row carries no permanent close glyph.
+TEST(TabRowRulesTest, ActiveUnhoveredHidesClose) {
+  TabRowState row;
+  row.active = true;
+  EXPECT_FALSE(ShowsCloseGlyph(row));
+  row.active = false;
+  EXPECT_FALSE(ShowsCloseGlyph(row));
+}
+
+// tabs R1: hovering any expanded row shows it.
+TEST(TabRowRulesTest, HoveredShowsClose) {
+  TabRowState row;
+  row.hovered_or_focused = true;
+  EXPECT_TRUE(ShowsCloseGlyph(row));
+  row.active = true;
+  EXPECT_TRUE(ShowsCloseGlyph(row));
+}
+
+// tabs R1: keyboard focus on the close button counts as hover.
+TEST(TabRowRulesTest, FocusedShowsClose) {
+  TabRowState row;
+  row.active = true;
+  row.hovered_or_focused = true;  // TabView folds focus into this bit.
+  EXPECT_TRUE(ShowsCloseGlyph(row));
+}
+
+// tabs R2: the slot is reserved on an expanded row whether the glyph is drawn
+// or not, so the title's width does not change on hover; it is never reserved
+// where the glyph can never appear.
+TEST(TabRowRulesTest, TitleWidthUnchangedByHover) {
+  TabRowState row;
+  row.active = true;
+  EXPECT_TRUE(ReservesCloseSlot(row));
+  row.hovered_or_focused = true;
+  EXPECT_TRUE(ReservesCloseSlot(row));
+  row.pinned = true;
+  EXPECT_FALSE(ReservesCloseSlot(row));
+  row.pinned = false;
+  row.narrow = true;
+  EXPECT_FALSE(ReservesCloseSlot(row));
+}
+
+// tabs R3: essentials cards and the collapsed rail never show the glyph, even
+// active and hovered.
+TEST(TabRowRulesTest, PinnedAndCollapsedNeverShowClose) {
+  TabRowState pinned;
+  pinned.pinned = true;
+  pinned.active = true;
+  pinned.hovered_or_focused = true;
+  EXPECT_FALSE(ShowsCloseGlyph(pinned));
+
+  TabRowState rail;
+  rail.narrow = true;
+  rail.active = true;
+  rail.hovered_or_focused = true;
+  EXPECT_FALSE(ShowsCloseGlyph(rail));
+}
+
+// tabs R18: a playing or muted essentials card keeps its favicon and shows
+// the alert as a corner badge; an ordinary row's alert is not a badge.
+TEST(TabRowRulesTest, PlayingEssentialKeepsItsFavicon) {
+  TabRowState card;
+  card.pinned = true;
+  card.alert_showing = true;
+  EXPECT_TRUE(ShowsFavicon(card));
+  EXPECT_TRUE(AlertIsCornerBadge(card));
+
+  TabRowState row;
+  row.alert_showing = true;
+  EXPECT_TRUE(ShowsFavicon(row));
+  EXPECT_FALSE(AlertIsCornerBadge(row));
+  card.alert_showing = false;
+  EXPECT_FALSE(AlertIsCornerBadge(card));
+}
+
+}  // namespace
+}  // namespace stedding
