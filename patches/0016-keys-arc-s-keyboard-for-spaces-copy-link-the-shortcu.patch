new file mode 100644
index 0000000000000..543ae4c234fc5
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_commands.cc
@@ -0,0 +1,124 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_commands.h"
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "components/tabs/public/tab_interface.h"
+
+namespace spaces {
+
+namespace {
+
+SpaceModel* ModelForCommands(BrowserWindowInterface* browser) {
+  return SupportsSpaceCommands(browser) ? SpaceModel::From(browser) : nullptr;
+}
+
+tabs::TabInterface* ActiveTab(BrowserWindowInterface* browser) {
+  TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
+  return tabs ? tabs->GetActiveTab() : nullptr;
+}
+
+}  // namespace
+
+bool SupportsSpaceCommands(BrowserWindowInterface* browser) {
+  if (!browser || !SpaceModel::From(browser)) {
+    return false;
+  }
+  Profile* const profile = browser->GetProfile();
+  return !profile || !profile->IsOffTheRecord();
+}
+
+void ActivateSpaceAt(BrowserWindowInterface* browser, size_t index) {
+  if (SpaceModel* const model = ModelForCommands(browser)) {
+    model->SetActiveSpaceByIndex(index);
+  }
+}
+
+void SwitchSpace(BrowserWindowInterface* browser, bool forward) {
+  if (SpaceModel* const model = ModelForCommands(browser)) {
+    model->SwitchToNeighbour(forward);
+  }
+}
+
+void ClearActiveSpace(BrowserWindowInterface* browser) {
+  if (SpaceModel* const model = ModelForCommands(browser)) {
+    model->ClearUnpinnedTabs();
+  }
+}
+
+void ToggleSpacePinOnActiveTab(BrowserWindowInterface* browser) {
+  SpaceModel* const model = ModelForCommands(browser);
+  tabs::TabInterface* const tab = ActiveTab(browser);
+  // An essentials tab sits above every Space; the second pin tier is not for
+  // it (B28), the way folders refuse it too.
+  if (!model || !tab || tab->IsPinned()) {
+    return;
+  }
+  model->SetSpacePinned(tab, !model->IsSpacePinned(tab));
+}
+
+void MoveActiveTabToNeighbourSpace(BrowserWindowInterface* browser,
+                                   bool forward) {
+  SpaceModel* const model = ModelForCommands(browser);
+  tabs::TabInterface* const tab = ActiveTab(browser);
+  if (!model || !tab || tab->IsPinned()) {
+    return;
+  }
+  Space* const target = model->NeighbourSpace(forward);
+  if (!target) {
+    return;
+  }
+  const SpaceId target_id = target->id();
+  model->SetSpaceForTab(tab, target_id);
+  model->SetActiveSpace(target_id);
+  // Follow the tab: it is the one the user was looking at.
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  const int index = tabs->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab && tabs->active_index() != index) {
+    tabs->ActivateTabAt(index, TabStripUserGestureDetails(
+                                   TabStripUserGestureDetails::GestureType::kOther));
+  }
+}
+
+SpaceCommandState::SpaceCommandState(BrowserWindowInterface* browser,
+                                     Setter setter)
+    : browser_(browser), setter_(std::move(setter)) {
+  if (SpaceModel* const model = SpaceModel::From(browser_)) {
+    observation_.Observe(model);
+  }
+  Refresh();
+}
+
+SpaceCommandState::~SpaceCommandState() = default;
+
+void SpaceCommandState::Refresh() {
+  const bool supported = SupportsSpaceCommands(browser_);
+  const size_t count = supported ? SpaceModel::From(browser_)->size() : 0;
+  for (int n = 1; n <= 9; ++n) {
+    setter_.Run(IDC_STEDDING_SPACE_1 + n - 1,
+                supported && static_cast<size_t>(n) <= count);
+  }
+  for (int command : {IDC_STEDDING_SPACE_NEXT, IDC_STEDDING_SPACE_PREVIOUS,
+                      IDC_STEDDING_CLEAR_SPACE, IDC_STEDDING_TOGGLE_SPACE_PIN,
+                      IDC_STEDDING_MOVE_TAB_TO_NEXT_SPACE,
+                      IDC_STEDDING_MOVE_TAB_TO_PREVIOUS_SPACE}) {
+    setter_.Run(command, supported);
+  }
+}
+
+void SpaceCommandState::OnSpaceAdded(const SpaceId& id) {
+  Refresh();
+}
+
+void SpaceCommandState::OnSpaceRemoved(const SpaceId& id) {
+  Refresh();
+}
+
+}  // namespace spaces
