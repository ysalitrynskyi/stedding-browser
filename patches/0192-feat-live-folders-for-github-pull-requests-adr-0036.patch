+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_LIVE_FOLDERS_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_LIVE_FOLDERS_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/ui/live_folders/github_pulls.h"
+#include "chrome/browser/ui/live_folders/live_folder_service.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+class Profile;
+
+// The live folder's block in chrome://settings/stedding
+// (docs/features/live-folders.md Lf1, Lf2, Lf11; settings T70-T72): its state,
+// and making, refreshing, deleting it and replacing its token. The token comes in once, from the
+// field, and never goes back to the page.
+//
+// Messages:
+//   steddingGetLiveFolder(callback) -> state
+//   steddingMakeLiveFolder(callback, token) -> {ok, error}: makes the folder,
+//     or, while it is on, replaces its token (Lf2's Replace Token)
+//   steddingRefreshLiveFolder()
+//   steddingDeleteLiveFolder()
+// Event: "stedding-live-folder-changed" with the state.
+class SteddingLiveFoldersHandler
+    : public settings::SettingsPageUIHandler,
+      public live_folders::LiveFolderService::Observer {
+ public:
+  explicit SteddingLiveFoldersHandler(Profile* profile);
+  SteddingLiveFoldersHandler(const SteddingLiveFoldersHandler&) = delete;
+  SteddingLiveFoldersHandler& operator=(const SteddingLiveFoldersHandler&) =
+      delete;
+  ~SteddingLiveFoldersHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+ private:
+  // live_folders::LiveFolderService::Observer:
+  void OnLiveFolderChanged() override;
+
+  base::DictValue State() const;
+  void HandleGet(const base::ListValue& args);
+  void HandleMake(const base::ListValue& args);
+  void HandleRefresh(const base::ListValue& args);
+  void HandleDelete(const base::ListValue& args);
+  void OnMade(base::Value callback_id, live_folders::Failure failure);
+
+  const raw_ptr<Profile> profile_;
+  base::ScopedObservation<live_folders::LiveFolderService,
+                          live_folders::LiveFolderService::Observer>
+      observation_{this};
+  base::WeakPtrFactory<SteddingLiveFoldersHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_LIVE_FOLDERS_HANDLER_H_
