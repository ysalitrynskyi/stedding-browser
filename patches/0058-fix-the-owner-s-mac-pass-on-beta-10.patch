+
+// Where each drawn row of the list is, by its tab.
+std::map<const tabs::TabInterface*, gfx::Rect> RowBounds(
+    const UnpinnedTabContainerView& list) {
+  std::map<const tabs::TabInterface*, gfx::Rect> rows;
+  for (const views::View* const child : list.children()) {
+    if (const auto* const row = views::AsViewClass<TabView>(child);
+        row && row->GetVisible() && row->GetTabInterface()) {
+      rows[row->GetTabInterface()] = row->bounds();
+    }
+  }
+  return rows;
+}
