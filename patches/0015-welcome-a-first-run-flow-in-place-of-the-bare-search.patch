+
+html,
+body {
+  height: 100%;
+  margin: 0;
+}
+
+#app {
+  --sand: #c8b377;
+  --ink: #1f2330;
+  --ink-muted: rgba(31, 35, 48, 0.62);
+  --card: rgba(255, 255, 255, 0.72);
+  --line: rgba(31, 35, 48, 0.12);
+  --accent: #2f4858;
+  --accent-ink: #f2e9de;
+  background:
+    radial-gradient(1200px 600px at 100% 0%, rgba(232, 176, 75, 0.18), transparent 60%),
+    linear-gradient(180deg, #e9dfc2 0%, var(--sand) 100%);
+  color: var(--ink);
+  display: block;
+  font: 15px/1.45 system-ui, -apple-system, 'Segoe UI', sans-serif;
+  height: 100%;
+}
+
+@media (prefers-color-scheme: dark) {
+  #app {
+    --ink: #edebf2;
+    --ink-muted: rgba(237, 235, 242, 0.62);
+    --card: rgba(255, 255, 255, 0.06);
+    --line: rgba(255, 255, 255, 0.12);
+    --accent: #edebf2;
+    --accent-ink: #21263a;
+    background:
+      radial-gradient(1200px 600px at 100% 0%, rgba(232, 176, 75, 0.1), transparent 60%),
+      linear-gradient(135deg, #21263a 0%, #31243a 100%);
+  }
+}
+
+.frame {
+  box-sizing: border-box;
+  display: grid;
+  grid-template-rows: auto 1fr auto;
+  height: 100%;
+  padding: 36px 44px 28px;
+}
+
+header {
+  align-items: center;
+  display: flex;
+  gap: 14px;
+}
+
+.mark {
+  align-items: center;
+  background: #2f4858;
+  border-radius: 12px;
+  display: inline-flex;
+  height: 44px;
+  justify-content: center;
+  width: 44px;
+}
+
+.mark svg {
+  height: 30px;
+  width: 30px;
+}
+
+.wordmark {
+  font-size: 22px;
+  font-weight: 650;
+  letter-spacing: -0.01em;
+}
+
+.dots {
+  display: flex;
+  gap: 8px;
+  margin-inline-start: auto;
+}
+
+.dots span {
+  background: var(--line);
+  border-radius: 999px;
+  height: 8px;
+  transition: width 200ms ease, background 200ms ease;
+  width: 8px;
+}
+
+.dots span.on {
+  background: var(--ink);
+  width: 26px;
+}
+
+.dots span.done {
+  background: var(--ink-muted);
+}
+
+main {
+  align-content: start;
+  display: grid;
+  gap: 18px;
+  overflow: auto;
+  padding-top: 26px;
+}
+
+h1 {
+  font-size: 30px;
+  font-weight: 650;
+  letter-spacing: -0.02em;
+  line-height: 1.15;
+  margin: 0;
+}
+
+.lead {
+  color: var(--ink-muted);
+  font-size: 16px;
+  margin: 0;
+  max-width: 62ch;
+}
+
+.list {
+  display: grid;
+  gap: 10px;
+  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
+}
+
+.tile {
+  align-items: center;
+  background: var(--card);
+  border: 1.5px solid var(--line);
+  border-radius: 14px;
+  color: var(--ink);
+  cursor: pointer;
+  display: flex;
+  font: inherit;
+  gap: 14px;
+  padding: 14px 16px;
+  text-align: start;
+  transition: border-color 120ms ease, transform 120ms ease;
+}
+
+.tile:hover {
+  transform: translateY(-1px);
+}
+
+.tile[aria-pressed='true'] {
+  border-color: var(--ink);
+}
+
+.tile img,
+.tile .glyph {
+  border-radius: 8px;
+  flex: none;
+  height: 28px;
+  width: 28px;
+}
+
+.tile .glyph {
+  align-items: center;
+  display: inline-flex;
+  font-size: 20px;
+  justify-content: center;
+}
+
+.tile .name {
+  font-weight: 600;
+}
+
+.tile .hint {
+  color: var(--ink-muted);
+  font-size: 13px;
+}
+
+.check {
+  border: 1.5px solid var(--ink-muted);
+  border-radius: 50%;
+  flex: none;
+  height: 18px;
+  margin-inline-start: auto;
+  width: 18px;
+}
+
+.tile[aria-pressed='true'] .check {
+  background: var(--ink);
+  border-color: var(--ink);
+  box-shadow: inset 0 0 0 3px var(--card);
+}
+
+.keys {
+  display: grid;
+  gap: 8px 22px;
+  grid-template-columns: max-content 1fr;
+  max-width: 60ch;
+}
+
+kbd {
+  background: var(--card);
+  border: 1px solid var(--line);
+  border-radius: 7px;
+  font: 600 13px/1 system-ui, sans-serif;
+  padding: 6px 9px;
+  white-space: nowrap;
+}
+
+footer {
+  align-items: center;
+  display: flex;
+  gap: 12px;
+  justify-content: flex-end;
+  padding-top: 18px;
+}
+
+footer .status {
+  color: var(--ink-muted);
+  font-size: 13px;
+  margin-inline-end: auto;
+}
+
+button.primary,
+button.secondary,
+button.quiet {
+  border: 0;
+  border-radius: 10px;
+  cursor: pointer;
+  font: 600 14px/1 system-ui, sans-serif;
+  padding: 11px 18px;
+}
+
+button.primary {
+  background: var(--accent);
+  color: var(--accent-ink);
+}
+
+button.secondary {
+  background: var(--card);
+  border: 1.5px solid var(--line);
+  color: var(--ink);
+}
+
+button.quiet {
+  background: transparent;
+  color: var(--ink-muted);
+}
+
+button:disabled {
+  cursor: default;
+  opacity: 0.5;
+}
+
+.import-row {
+  align-items: center;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+
+.import-row label {
+  align-items: center;
+  display: inline-flex;
+  gap: 6px;
+}
diff --git a/chrome/browser/resources/stedding_welcome/app.ts b/chrome/browser/resources/stedding_welcome/app.ts
new file mode 100644
index 0000000000000..220cc182314ed
--- /dev/null
+++ b/chrome/browser/resources/stedding_welcome/app.ts
@@ -0,0 +1,304 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The first-run flow: five steps, each skippable, Finish at the end. Plain
+// DOM on purpose: no Lit dependency means no visibility hunk upstream.
+//
+// chrome.send rather than Mojo, deliberately: the page reuses Chromium's own
+// ImportDataHandler, which speaks chrome.send, and a Mojo interface for six
+// one-way messages would be more code than the flow itself.
+/* eslint-disable no-restricted-imports, no-restricted-properties */
+
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+
+interface SearchEngine {
+  prepopulateId: number;
+  name: string;
+  iconPath: string;
+}
+
+interface ImportSource {
+  name: string;
+  index: number;
+  profileName: string;
+}
+
+type Step = 'search'|'import'|'appearance'|'default'|'keys';
+const STEPS: Step[] = ['search', 'import', 'appearance', 'default', 'keys'];
+
+const state = {
+  step: 'search' as Step,
+  engines: [] as SearchEngine[],
+  chosenEngine: 0,
+  sources: [] as ImportSource[],
+  chosenSource: -1,
+  importStatus: '',
+  importFavorites: true,
+  importHistory: true,
+  importPasswords: true,
+  scheme: 'system',
+  defaultState: 'unknown',
+};
+
+function el<K extends keyof HTMLElementTagNameMap>(
+    tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  if (className) {
+    node.className = className;
+  }
+  if (text !== undefined) {
+    node.textContent = text;
+  }
+  return node;
+}
+
+function mark(): SVGSVGElement {
+  const ns = 'http://www.w3.org/2000/svg';
+  const svg = document.createElementNS(ns, 'svg');
+  svg.setAttribute('viewBox', '0 0 120 120');
+  svg.setAttribute('aria-hidden', 'true');
+  const path = document.createElementNS(ns, 'path');
+  path.setAttribute('d', 'M26 98 V58 a34 34 0 0 1 68 0 V98');
+  path.setAttribute('fill', 'none');
+  path.setAttribute('stroke', '#F2E9DE');
+  path.setAttribute('stroke-width', '11');
+  path.setAttribute('stroke-linecap', 'round');
+  path.setAttribute('stroke-linejoin', 'round');
+  const dot = document.createElementNS(ns, 'circle');
+  dot.setAttribute('cx', '60');
+  dot.setAttribute('cy', '79');
+  dot.setAttribute('r', '11');
+  dot.setAttribute('fill', '#E8B04B');
+  svg.append(path, dot);
+  return svg;
+}
+
+function tile(opts: {
+  icon?: string, glyph?: string, name: string, hint?: string,
+  pressed: boolean, onClick: () => void,
+}): HTMLButtonElement {
+  const button = el('button', 'tile');
+  button.setAttribute('role', 'radio');
+  button.setAttribute('aria-pressed', String(opts.pressed));
+  if (opts.icon) {
+    const img = el('img');
+    img.src = opts.icon;
+    img.alt = '';
+    button.append(img);
+  } else {
+    button.append(el('span', 'glyph', opts.glyph || ''));
+  }
+  const text = el('span');
+  text.append(el('div', 'name', opts.name));
+  if (opts.hint) {
+    text.append(el('div', 'hint', opts.hint));
+  }
+  button.append(text, el('span', 'check'));
+  button.addEventListener('click', opts.onClick);
+  return button;
+}
+
+function checkbox(label: string, checked: boolean, onChange: (v: boolean) => void):
+    HTMLLabelElement {
+  const wrap = el('label');
+  const input = el('input');
+  input.type = 'checkbox';
+  input.checked = checked;
+  input.addEventListener('change', () => onChange(input.checked));
+  wrap.append(input, document.createTextNode(' ' + label));
+  return wrap;
+}
+
+function renderStep(main: HTMLElement) {
+  main.replaceChildren();
+  const heading = (title: string, lead: string) => {
+    main.append(el('h1', undefined, title), el('p', 'lead', lead));
+  };
+  switch (state.step) {
+    case 'search': {
+      heading('Choose your search engine',
+              'Every search from the address bar and ⌘T goes here. Change it any time in Settings.');
+      const list = el('div', 'list');
+      list.setAttribute('role', 'radiogroup');
+      for (const e of state.engines) {
+        list.append(tile({
+          icon: e.iconPath, name: e.name,
+          pressed: state.chosenEngine === e.prepopulateId,
+          onClick: () => {
+            state.chosenEngine = e.prepopulateId;
+            chrome.send('setSearchEngine', [e.prepopulateId]);
+            render();
+          },
+        }));
+      }
+      main.append(list);
+      break;
+    }
+    case 'import': {
+      heading('Bring your bookmarks and history',
+              'From another browser on this Mac. Nothing leaves the machine; it is copied into your profile.');
+      if (state.sources.length === 0) {
+        main.append(el('p', 'lead', 'No other browser profiles were found.'));
+        break;
+      }
+      const list = el('div', 'list');
+      list.setAttribute('role', 'radiogroup');
+      for (const s of state.sources) {
+        list.append(tile({
+          glyph: '🗂️', name: s.name, hint: s.profileName || '',
+          pressed: state.chosenSource === s.index,
+          onClick: () => {
+            state.chosenSource = s.index;
+            render();
+          },
+        }));
+      }
+      const row = el('div', 'import-row');
+      row.append(
+          checkbox('Bookmarks', state.importFavorites, v => state.importFavorites = v),
+          checkbox('History', state.importHistory, v => state.importHistory = v),
+          checkbox('Passwords', state.importPasswords, v => state.importPasswords = v));
+      const button = el('button', 'secondary',
+          state.importStatus === 'succeeded' ? 'Imported' :
+          state.importStatus === 'inProgress' ? 'Importing…' : 'Import');
+      button.disabled = state.importStatus === 'inProgress';
+      button.addEventListener('click', () => {
+        if (state.chosenSource < 0) {
+          return;
+        }
+        chrome.send('importData', [state.chosenSource, {
+          'import_dialog_autofill_form_data': false,
+          'import_dialog_bookmarks': state.importFavorites,
+          'import_dialog_history': state.importHistory,
+          'import_dialog_saved_passwords': state.importPasswords,
+          'import_dialog_search_engine': false,
+        }]);
+      });
+      row.append(button);
+      main.append(list, row);
+      break;
+    }
+    case 'appearance': {
+      heading('Light or dark',
+              'Sand by day, a blue-to-plum gradient by night. Follow the system, or pick one.');
+      const list = el('div', 'list');
+      list.setAttribute('role', 'radiogroup');
+      const schemes: Array<[string, string, string]> = [
+        ['system', 'Follow the system', '🌗'],
+        ['light', 'Light', '☀️'],
+        ['dark', 'Dark', '🌙'],
+      ];
+      for (const [scheme, name, glyph] of schemes) {
+        list.append(tile({
+          glyph, name, pressed: state.scheme === scheme,
+          onClick: () => {
+            state.scheme = scheme;
+            chrome.send('setAppearance', [scheme]);
+            render();
+          },
+        }));
+      }
+      main.append(list);
+      break;
+    }
+    case 'default': {
+      heading('Make Stedding your default browser',
+              'Links from other apps open here. macOS asks once to confirm.');
+      const row = el('div', 'import-row');
+      const button = el('button', 'secondary',
+          state.defaultState === 'default' ? 'Stedding is the default' : 'Set as default');
+      button.disabled = state.defaultState === 'default';
+      button.addEventListener('click', () => chrome.send('setDefaultBrowser'));
+      row.append(button);
+      main.append(row);
+      break;
+    }
+    case 'keys': {
+      heading('Five keys worth knowing', 'The sidebar is the product; these get you around it.');
+      const keys = el('div', 'keys');
+      const shortcuts: Array<[string, string]> = [
+        ['⌘T', 'Open the bar: search, a URL, or any open tab'],
+        ['⌘S', 'Collapse the sidebar to icons, or bring it back'],
+        ['⌘O', 'Turn a peek into a tab (⇧⌘O: a split)'],
+        ['⌥⌘N', 'Split the current tab with a new one'],
+        ['⇧⌘2', 'Screenshot the page (⌥⇧⌘2 a region, ⇧⌘1 the full page)'],
+      ];
+      for (const [key, what] of shortcuts) {
+        keys.append(el('kbd', undefined, key), el('span', undefined, what));
+      }
+      main.append(keys, el('p', 'lead', 'Two-finger swipe across the sidebar changes Space.'));
+      break;
+    }
+  }
+}
+
+function render() {
+  const app = document.getElementById('app')!;
+  app.replaceChildren();
+  const frame = el('div', 'frame');
+  const index = STEPS.indexOf(state.step);
+
+  const header = el('header');
+  const markWrap = el('span', 'mark');
+  markWrap.append(mark());
+  header.append(markWrap, el('span', 'wordmark', 'Stedding'));
+  const dots = el('div', 'dots');
+  dots.setAttribute('aria-hidden', 'true');
+  STEPS.forEach((_, i) => {
+    dots.append(el('span', i === index ? 'on' : i < index ? 'done' : ''));
+  });
+  header.append(dots);
+
+  const main = el('main');
+  renderStep(main);
+
+  const footer = el('footer');
+  footer.append(el('span', 'status', `Step ${index + 1} of ${STEPS.length}`));
+  const skip = el('button', 'quiet', 'Skip');
+  skip.addEventListener('click', () => chrome.send('finish'));
+  const back = el('button', 'secondary', 'Back');
+  back.disabled = index === 0;
+  back.addEventListener('click', () => {
+    state.step = STEPS[Math.max(0, index - 1)]!;
+    render();
+  });
+  const next = el('button', 'primary', index === STEPS.length - 1 ? 'Finish' : 'Next');
+  next.addEventListener('click', () => {
+    if (index === STEPS.length - 1) {
+      chrome.send('finish');
+    } else {
+      state.step = STEPS[index + 1]!;
+      render();
+    }
+  });
+  footer.append(skip, back, next);
+
+  frame.append(header, main, footer);
+  app.append(frame);
+}
+
+sendWithPromise('getSearchEngines').then((engines: unknown) => {
+  state.engines = engines as SearchEngine[];
+  render();
+});
+sendWithPromise('initializeImportDialog').then((sources: unknown) => {
+  state.sources = sources as ImportSource[];
+  if (state.sources.length > 0) {
+    state.chosenSource = state.sources[0]!.index;
+  }
+  render();
+});
+sendWithPromise('getDefaultBrowserState').then((s: unknown) => {
+  state.defaultState = s as string;
+  render();
+});
+addWebUiListener('import-data-status-changed', (status: unknown) => {
+  state.importStatus = status as string;
+  render();
+});
+addWebUiListener('default-browser-changed', (s: unknown) => {
+  state.defaultState = s as string;
+  render();
+});
+render();
