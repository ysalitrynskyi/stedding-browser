+// Every tab the strip had on screen at any of its changes.
+class TabsShown : public TabStripModelObserver {
+ public:
+  explicit TabsShown(TabStripModel& strip) { strip.AddObserver(this); }
+
+  void OnTabStripModelChanged(
+      TabStripModel* strip,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    if (tabs::TabInterface* const active = strip->GetActiveTab()) {
+      shown_.insert(active->GetHandle());
+    }
+  }
+
+  bool Showed(const tabs::TabInterface* tab) const {
+    return shown_.contains(tab->GetHandle());
+  }
+
+ private:
+  std::set<tabs::TabHandle> shown_;
+};
+
+// tabs R37, spaces B3, B4 (GitHub issue 121; PLAN.md decision 24): Cmd-W on
+// a Space's last tab, with its pin and every essential asleep, as a launch
+// leaves them, shows the Space's page and wakes none of them. The first
+// essential came on screen and loaded, never opened in the window until
+// then. Coming back to the Space wakes none either. With an essential the
+// Space used awake, the close shows that one.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, CmdWOnTheLastTabWakesNothingAsleep) {
+  tabs::TabInterface* const home_tab = tabs().GetActiveTab();
+  ASSERT_TRUE(home_tab);
+  const spaces::SpaceId home = model().active_id();
+  tabs::TabInterface* const essential = AddBlankTab();
+  tabs().SetTabPinned(tabs().GetIndexOfTab(essential), true);
+  tabs::TabInterface* const used = AddBlankTab();
+  tabs().SetTabPinned(tabs().GetIndexOfTab(used), true);
+  ASSERT_EQ(essential, tabs().GetTabAtIndex(0));
+  // Solo: a pin, and one tab below it.
+  const spaces::SpaceId solo = model().AddSpace("Solo", SK_ColorGREEN)->id();
+  tabs::TabInterface* const pin = AddBlankTab();
+  tabs::TabInterface* const last = AddBlankTab();
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(home_tab));
+  model().MoveTabsToSpace({pin, last}, solo);
+  ASSERT_TRUE(model().SetActiveSpace(solo));
+  model().SetSpacePinned(pin, true);
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(last));
+  ASSERT_EQ(last, tabs().GetActiveTab());
+  ASSERT_LT(tabs().GetIndexOfTab(pin), tabs().GetIndexOfTab(last));
+  const auto asleep = [](tabs::TabInterface* tab) {
+    return tab->GetContents()->WasDiscarded();
+  };
+  for (tabs::TabInterface* const tab : {essential, used, pin}) {
+    stedding::UnloadTabNow(tab);
+  }
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return asleep(essential) && asleep(used) && asleep(pin);
+  }));
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  const int count = tabs().count();
+
+  {
+    SCOPED_TRACE("Cmd-W on the Space's last tab");
+    TabsShown shown(tabs());
+    const tabs::TabHandle closing = last->GetHandle();
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);  // Cmd-W
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !closing.Get(); }));
+    tabs::TabInterface* const now = tabs().GetActiveTab();
+    EXPECT_TRUE(stedding::IsEmptySpaceStandIn(now))
+        << "the Space's page did not show";
+    EXPECT_EQ(solo, model().SpaceForTab(now));
+    EXPECT_EQ(solo, model().active_id());
+    EXPECT_EQ(count, tabs().count()) << "the tab closed, the page opened";
+    EXPECT_FALSE(shown.Showed(essential)) << "the first essential came on";
+    EXPECT_FALSE(shown.Showed(used)) << "the other essential came on";
+    EXPECT_FALSE(shown.Showed(pin)) << "the pin above the tab came on";
+    EXPECT_TRUE(asleep(essential) && asleep(used) && asleep(pin))
+        << "an essential or the pin woke";
+  }
+
+  {
+    SCOPED_TRACE("coming back to the Space");
+    ASSERT_TRUE(model().SetActiveSpace(home));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return tabs().GetActiveTab() == home_tab && tabs().count() == count - 1;
+    })) << "Home's tab did not show, or the Space's page stayed";
+    TabsShown shown(tabs());
+    ASSERT_TRUE(model().SetActiveSpace(solo));
+    EXPECT_TRUE(stedding::IsEmptySpaceStandIn(tabs().GetActiveTab()))
+        << "the Space's page did not come back";
+    EXPECT_FALSE(shown.Showed(essential));
+    EXPECT_FALSE(shown.Showed(used));
+    EXPECT_FALSE(shown.Showed(pin)) << "the pin, Solo's only row, came on";
+    EXPECT_TRUE(asleep(essential) && asleep(used) && asleep(pin));
+  }
+
+  {
+    SCOPED_TRACE("an essential the Space used, awake");
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(used));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !asleep(used) && tabs().count() == count - 1;
+    })) << "the essential did not load, or the Space's page stayed";
+    tabs::TabInterface* const another = AddBlankTab();
+    ASSERT_EQ(solo, model().SpaceForTab(another));
+    TabsShown shown(tabs());
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);  // Cmd-W
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return tabs().count() == count - 1; }));
+    EXPECT_EQ(used, tabs().GetActiveTab());
+    EXPECT_FALSE(shown.Showed(essential)) << "the first essential came on";
+    EXPECT_FALSE(shown.Showed(pin));
+    EXPECT_TRUE(asleep(essential) && asleep(pin));
+  }
+}
