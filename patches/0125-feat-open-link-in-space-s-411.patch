+// menus M14, spaces B46 (GitHub issue 75): a link's page menu opens it in
+// another Space of the window, in that Space's jar from the first request,
+// and the window shows that Space. Only the other Spaces are listed. The
+// Space named wins over a route.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, OpenLinkInSpaceCarriesThatSpacesJar) {
+  RouteToWork("routed.test");
+  const auto menu_for = [](content::WebContents* contents, const GURL& link) {
+    content::ContextMenuParams params;
+    params.page_url = contents->GetLastCommittedURL();
+    params.frame_url = params.page_url;
+    params.link_url = link;
+    params.unfiltered_link_url = link;
+    auto menu = std::make_unique<TestRenderViewContextMenu>(
+        *contents->GetPrimaryMainFrame(), params);
+    menu->Init();
+    return menu;
+  };
+
+  {
+    std::unique_ptr<TestRenderViewContextMenu> menu =
+        menu_for(home_tab_.Get()->GetContents(),
+                 Url("b.test", "/echo?menu-work"));
+    const std::optional<std::pair<ui::MenuModel*, size_t>> row =
+        menu->GetMenuModelAndItemIndex(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST);
+    ASSERT_TRUE(row) << "no Open Link in Space row";
+    EXPECT_EQ(1u, row->first->GetItemCount()) << "Home listed itself";
+    EXPECT_NE(std::u16string::npos,
+              row->first->GetLabelAt(row->second).find(u"Work"));
+    ASSERT_TRUE(menu->IsCommandIdEnabled(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST));
+    menu->ExecuteCommand(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST, 0);
+  }
+  EXPECT_EQ("jar=work", FirstCookieFor("/echo?menu-work"))
+      << "the first request did not carry Work's jar";
+  tabs::TabInterface* const opened = tabs()->GetActiveTab();
+  EXPECT_EQ(work_, model_->FindSpaceForTab(opened));
+  EXPECT_EQ(JarOf(work_tab_.Get()), JarOf(opened));
+  EXPECT_TRUE(base::test::RunUntil([&] { return model_->active_id() == work_; }))
+      << "the window stayed on Home";
+  EXPECT_EQ(home_, model_->FindSpaceForTab(home_tab_.Get()));
+
+  {
+    // A route names Work for routed.test; the menu names Home.
+    std::unique_ptr<TestRenderViewContextMenu> menu = menu_for(
+        opened->GetContents(), Url("routed.test", "/echo?menu-home"));
+    // The rows are in a submenu, which IsItemPresent does not look into.
+    ASSERT_TRUE(
+        menu->GetMenuModelAndItemIndex(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST));
+    EXPECT_FALSE(menu->GetMenuModelAndItemIndex(
+        IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST + 1));
+    menu->ExecuteCommand(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST, 0);
+  }
+  EXPECT_EQ("jar=shared", FirstCookieFor("/echo?menu-home"));
+  EXPECT_EQ(home_, model_->FindSpaceForTab(tabs()->GetActiveTab()));
+  EXPECT_TRUE(base::test::RunUntil([&] { return model_->active_id() == home_; }));
+}
