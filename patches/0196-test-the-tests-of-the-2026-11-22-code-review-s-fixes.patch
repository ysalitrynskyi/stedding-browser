+// archive A9: the archive's Restore brings a tab back in its Space, and back
+// in its folder when the folder is still there.
+class ArchiveRestoreB06Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  sessions::TabRestoreService* service() {
+    return TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  }
+
+  GURL Url(const std::string& host) {
+    return embedded_test_server()->GetURL(host, "/title1.html");
+  }
+
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+
+  // A new foreground tab on `host`, loaded.
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url(host), WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // The tab showing `host`, or null.
+  tabs::TabInterface* Find(const std::string& host) {
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      if (ShownUrl(tab->GetContents()).host() == host) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  // The folder `tab` is right in, or null.
+  static const tabs::FolderTabCollection* FolderOf(tabs::TabInterface* tab) {
+    const tabs::TabCollection* const parent = tab->GetParentCollection();
+    return parent && parent->type() == tabs::TabCollection::Type::FOLDER
+               ? static_cast<const tabs::FolderTabCollection*>(parent)
+               : nullptr;
+  }
+
+  // Whether any folder holds `tab`, however deep.
+  static bool InAnyFolder(tabs::TabInterface* tab) {
+    for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+         each = each->GetParentCollection()) {
+      if (each->type() == tabs::TabCollection::Type::FOLDER) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // The recently-closed entry of the tab on `host` closed on its own, or an
+  // invalid id.
+  SessionID ClosedTabEntry(const std::string& host) {
+    for (const std::unique_ptr<sessions::tab_restore::Entry>& entry :
+         service()->entries()) {
+      if (entry->type == sessions::tab_restore::TAB &&
+          RecordedUrl(static_cast<const sessions::tab_restore::Tab&>(*entry))
+                  .host() == host) {
+        return entry->id;
+      }
+    }
+    return SessionID::InvalidValue();
+  }
+
+  // What the archive page's Restore and the command bar's archived row do
+  // with entry `id`; then the tab on `host`, or null.
+  tabs::TabInterface* RestoreFromTheArchive(SessionID id,
+                                            const std::string& host) {
+    EXPECT_TRUE(stedding::RestoreArchivedTab(
+        browser(), BrowserLiveTabContext::From(browser()), service(), id));
+    base::RunLoop().RunUntilIdle();
+    return Find(host);
+  }
+};
+
+// P06-1d; archive A9, folders F37, F47: Restore leaves the tab loose in its
+// Space when the folder it was closed from has moved to another Space since.
+// It went back into that folder, which then held the tabs of two Spaces and
+// showed in both.
+IN_PROC_BROWSER_TEST_F(ArchiveRestoreB06Test,
+                       RestorePassesOverAFolderNowInAnotherSpace) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const SpaceId home = m->active_id();
+  const SpaceId other = m->AddSpace("Other", SK_ColorBLUE)->id();
+  tabs::TabInterface* const closing = Open("one.test");
+  tabs::TabInterface* const staying = Open("two.test");
+  // The strip's last row is a loose tab, so the restored tab, added at the
+  // end of the strip, lands in no folder of its own accord.
+  Open("tail.test");
+  tabs::FolderTabCollection* const docs =
+      tabs()->AddToNewFolder({Index(closing), Index(staying)});
+  ASSERT_TRUE(docs);
+  docs->SetTitle("Docs");
+  ASSERT_EQ(home, m->SpaceForTab(closing));
+  tabs()->CloseWebContentsAt(Index(closing),
+                             TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  const SessionID entry = ClosedTabEntry("one.test");
+  ASSERT_TRUE(entry.is_valid()) << "the close was not recorded";
+
+  // Move to Space on the folder's header.
+  m->MoveFolderToSpace(docs, other);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(other, m->SpaceForTab(staying)) << "the folder did not move";
+  ASSERT_EQ(docs, FolderOf(staying));
+
+  tabs::TabInterface* const back = RestoreFromTheArchive(entry, "one.test");
+  ASSERT_TRUE(back) << "the tab did not come back";
+  EXPECT_EQ(home, m->SpaceForTab(back)) << "back in another Space";
+  EXPECT_FALSE(InAnyFolder(back))
+      << "back in a folder whose tabs are another Space's";
+  EXPECT_EQ(other, m->SpaceForTab(staying));
+  EXPECT_EQ(docs, FolderOf(staying));
+}
+
+// P06-1d; archive A9, pins H14, folders F38: a tab restored into its folder,
+// pinned since, is one of the folder's pins, and the folder stays in the
+// pinned run, as a tab dropped into it does. The restored tab was loose in
+// it, and the folder read as unpinned and fell out of the run.
+IN_PROC_BROWSER_TEST_F(ArchiveRestoreB06Test,
+                       RestoreIntoAPinnedFolderKeepsItPinned) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  tabs::TabInterface* const closing = Open("one.test");
+  tabs::TabInterface* const staying = Open("two.test");
+  Open("tail.test");
+  tabs::FolderTabCollection* const docs =
+      tabs()->AddToNewFolder({Index(closing), Index(staying)});
+  ASSERT_TRUE(docs);
+  tabs()->CloseWebContentsAt(Index(closing),
+                             TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  const SessionID entry = ClosedTabEntry("one.test");
+  ASSERT_TRUE(entry.is_valid()) << "the close was not recorded";
+  m->SetFolderSpacePinned(docs, true);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(m->IsSpacePinned(staying));
+  ASSERT_TRUE(FolderOf(staying));
+  ASSERT_TRUE(m->IsFolderSpacePinned(FolderOf(staying)));
+
+  tabs::TabInterface* const back = RestoreFromTheArchive(entry, "one.test");
+  ASSERT_TRUE(back) << "the tab did not come back";
+  ASSERT_TRUE(FolderOf(back)) << "not back in its folder";
+  EXPECT_EQ(FolderOf(staying), FolderOf(back));
+  EXPECT_TRUE(m->IsFolderSpacePinned(FolderOf(back)))
+      << "the folder fell out of the pinned run";
+  EXPECT_TRUE(m->IsSpacePinned(back)) << "a loose tab in a pinned folder";
+}
+
+// little E8, archive A13: a little window the session keeps comes back at
+// the next launch that continues where this one left off.
+class LittleWindowRestoreB06Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    SessionStartupPref::SetStartupPref(
+        browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  }
+
+  // The little window's page, a path no other window of these runs shows.
+  static constexpr char kLittlePath[] = "/title2.html";
+
+  // Whether `entry` is a closed window that held the little window's page.
+  static bool IsTheLittleWindowsClose(
+      const sessions::tab_restore::Entry& entry) {
+    if (entry.type != sessions::tab_restore::WINDOW) {
+      return false;
+    }
+    for (const std::unique_ptr<sessions::tab_restore::Tab>& tab :
+         static_cast<const sessions::tab_restore::Window&>(entry).tabs) {
+      if (std::string(RecordedUrl(*tab).path()) == kLittlePath) {
+        return true;
+      }
+    }
+    return false;
+  }
+};
+
+// The run before the launch: a little window open, its page loaded, at the
+// quit.
+IN_PROC_BROWSER_TEST_F(LittleWindowRestoreB06Test,
+                       PRE_ALittleWindowOpenAtTheQuitIsNotArchived) {
+  BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+      browser()->GetProfile(), embedded_test_server()->GetURL(kLittlePath),
+      browser(), /*untrusted_launch=*/false);
+  ASSERT_TRUE(little);
+  ASSERT_TRUE(stedding::IsLittleWindow(little));
+  // Loaded, so the session has its page: a tab with none is left out.
+  ASSERT_TRUE(content::WaitForLoadStop(
+      little->GetTabStripModel()->GetActiveWebContents()));
+}
+
+// P06-1c; archive A13, A15, little E8, E13: the quit recorded the little
+// window, and the launch opened it again, so its page is no row of the
+// archive and ⇧⌘T passes over its record. The quit's record carried no mark:
+// the archive listed the page as closed, and ⇧⌘T opened a second copy of
+// the window.
+IN_PROC_BROWSER_TEST_F(LittleWindowRestoreB06Test,
+                       ALittleWindowOpenAtTheQuitIsNotArchived) {
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return std::ranges::any_of(GetAllBrowserWindowInterfaces(),
+                               [](BrowserWindowInterface* window) {
+                                 return stedding::IsLittleWindow(window);
+                               });
+  })) << "the little window did not come back";
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  service->LoadTabsFromLastSession();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return service->IsLoaded(); }));
+  ASSERT_TRUE(std::ranges::any_of(
+      service->entries(),
+      [](const std::unique_ptr<sessions::tab_restore::Entry>& entry) {
+        return IsTheLittleWindowsClose(*entry);
+      }))
+      << "the quit did not record the little window";
+
+  for (const stedding::ArchivedTab& row : stedding::ListArchivedTabs(
+           service->entries(), base::Time::Now(), base::Days(30))) {
+    EXPECT_NE(std::string(kLittlePath), std::string(row.url.path()))
+        << "the little window, open again, is a row of the archive";
+  }
+  const auto most_recent = stedding::MostRecentClose(service->entries());
+  EXPECT_TRUE(most_recent == service->entries().end() ||
+              !IsTheLittleWindowsClose(**most_recent))
+      << "Shift-Cmd-T would open the little window a second time";
+}
