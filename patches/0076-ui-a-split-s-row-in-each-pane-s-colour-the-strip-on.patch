+        EXPECT_NE(colour_of(dark), got) << "at " << x << ", " << y;
+      }
+    }
+    ASSERT_TRUE(
+        chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+    views::test::RunScheduledLayout(view());
+    ASSERT_TRUE(view()->IsToolbarVisible());
+  }
+  {
+    SCOPED_TRACE("the split ended: the active page's colour across");
+    const gfx::Rect end = view()
+                              ->multi_contents_view()
+                              ->contents_container_views()[1]
+                              ->bounds();
+    tabs->RemoveSplit(split);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(view());
+      if (view()->multi_contents_view()->IsInSplitView() ||
+          !row()->color()) {
+        return false;
+      }
+      gfx::RectF toolbar(view()->toolbar()->GetLocalBounds());
+      views::View::ConvertRectToTarget(view()->toolbar(), view(), &toolbar);
+      gfx::Canvas canvas(view()->size(), 1.0f, /*is_opaque=*/true);
