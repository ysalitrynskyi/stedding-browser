+// Dk7: with dark pages on in a light window, the content area under a page
+// that will be darkened is #121212 from the start of its navigation, before
+// any frame; the new tab page keeps the window's colour, and so does a site
+// kept light, also when a darkened address redirects to it. What is read is
+// the content area's own layer, the colour under the page's view: the view's
+// own colour reports the page shown before until the coming page has drawn
+// (on Windows the new tab page's), so it is not this test's to read.
+IN_PROC_BROWSER_TEST_F(DarkPagesTest, TheContentAreaIsDarkBeforeTheFirstFrame) {
+  stedding::SetDarkPagesOn(profile(), true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL(chrome::kChromeUINewTabURL)));
+  ContentsWebView* const area = BrowserView::GetBrowserViewForBrowser(browser())
+                                    ->contents_web_view_for_testing();
+  ASSERT_TRUE(area);
+  const auto area_colour = [&]() {
+    return area->layer()->AsSolidColor()->GetTargetColor().toSkColor();
+  };
+  const SkColor window =
+      area->GetColorProvider()->GetColor(kColorWebContentsBackground);
+  ASSERT_NE(stedding::kDarkPagesCanvas, window)
+      << "the premise: a light window";
+  EXPECT_EQ(window, area_colour()) << "the new tab page is the browser's own";
+
+  const GURL url = Url("a.test");
+  content::TestNavigationManager navigation(page(), url);
+  page()->GetController().LoadURL(url, content::Referrer(),
+                                  ui::PAGE_TRANSITION_TYPED, std::string());
+  ASSERT_TRUE(navigation.WaitForRequestStart());
+  EXPECT_EQ(stedding::kDarkPagesCanvas, area_colour())
+      << "dark before the page has a frame";
+  ASSERT_TRUE(navigation.WaitForNavigationFinished());
+  EXPECT_EQ(stedding::kDarkPagesCanvas, area_colour());
+
+  // A site kept light keeps the window's colour.
+  Keep("b.test");
+  const GURL light = Url("b.test");
+  content::TestNavigationManager to_light(page(), light);
+  page()->GetController().LoadURL(light, content::Referrer(),
+                                  ui::PAGE_TRANSITION_TYPED, std::string());
+  ASSERT_TRUE(to_light.WaitForRequestStart());
+  EXPECT_EQ(window, area_colour());
+  ASSERT_TRUE(to_light.WaitForNavigationFinished());
+  EXPECT_EQ(window, area_colour());
+
+  // A darkened address that redirects to the site kept light: dark from the
+  // start, the window's colour once the redirect names the page that comes.
+  const GURL via =
+      Url("c.test", base::StrCat({"/dark/redirect?", light.spec()}));
+  content::TestNavigationManager redirected(page(), via);
+  page()->GetController().LoadURL(via, content::Referrer(),
+                                  ui::PAGE_TRANSITION_LINK, std::string());
+  ASSERT_TRUE(redirected.WaitForRequestStart());
+  EXPECT_EQ(stedding::kDarkPagesCanvas, area_colour());
+  ASSERT_TRUE(redirected.WaitForResponse());
+  EXPECT_EQ(window, area_colour()) << "the colour of the redirect's end";
+  ASSERT_TRUE(redirected.WaitForNavigationFinished());
+  EXPECT_EQ(light, page()->GetLastCommittedURL());
+  EXPECT_EQ(window, area_colour());
+}
