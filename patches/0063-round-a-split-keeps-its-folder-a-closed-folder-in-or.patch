+// folders F19, BACKLOG S-135: ⇧⌘T from another window judges the order by
+// the window the tabs go back to. The folder's own window kept fewer tabs
+// than the folder's old place, the other window more, and the tabs came back
+// in the folder's window reversed.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       AFolderRestoredFromAnotherWindowKeepsItsOrder) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  for (const char* const host :
+       {"pad1.test", "pad2.test", "pad3.test", "a.test", "b.test", "c.test"}) {
+    OpenLoaded(host);
+  }
+  ASSERT_EQ(7, tab_strip_model()->count());
+  tabs::FolderTabCollection* folder =
+      tab_strip_model()->AddToNewFolder({4, 5, 6});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Reading");
+  tab_strip_model()->ActivateTabAt(0);
+  tab_strip_model()->CloseFolderTabs(folder);
+  folder = nullptr;
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return tab_strip_model()->count() == 4; }));
+  // Closed with no record, so the folder stays the newest close.
+  for (int i = 3; i >= 1; --i) {
+    tab_strip_model()->CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+  }
+  ASSERT_EQ(1, tab_strip_model()->count()) << "fewer than the folder's place";
+
+  // Another window with more tabs than the folder's place.
+  BrowserWindowInterface* const other = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(other);
+  while (other->GetTabStripModel()->count() < 6) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        other, GURL("about:blank"), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  }
+  const int other_count = other->GetTabStripModel()->count();
+
+  // The folder's tabs, by host, in the folder's window.
+  const auto in_reading = [&]() -> std::string {
+    std::string hosts;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      const auto* const parent =
+          tab_strip_model()->GetTabAtIndex(i)->GetParentCollection();
+      const auto* const holder =
+          parent && parent->type() == tabs::TabCollection::Type::FOLDER
+              ? static_cast<const tabs::FolderTabCollection*>(parent)
+              : nullptr;
+      if (holder && holder->title() == "Reading") {
+        hosts += std::string(tab_strip_model()
+                                 ->GetWebContentsAt(i)
+                                 ->GetLastCommittedURL()
+                                 .host()) +
+                 " ";
+      }
+    }
+    return hosts;
+  };
+  chrome::RestoreTab(other);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return in_reading().size() == std::string("a.test b.test c.test ").size();
+  })) << "the folder came back as \"" << in_reading() << "\"";
+  EXPECT_EQ("a.test b.test c.test ", in_reading());
+  EXPECT_EQ(other_count, other->GetTabStripModel()->count())
+      << "the tabs went to the window ⇧⌘T was pressed in";
+}
+
+// folders F19, BACKLOG S-135: ⇧⌘T in a window left with fewer tabs than the
+// folder's old place, though not by as many as the folder holds, brings the
+// folder back in order and a split in it whole. Each tab was put back at the
+// folder's place once the window had grown past it: "a c b", and the last
+// tab inside the split, which split it (found using the build, 2026-10-14).
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, AFolderComesBackInOrderToAShortWindow) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  // The tabs of the folder titled `title`, in the strip's order, by host; a
+  // pane of a split is marked with its split's first pane's host.
+  const auto in_folder = [&](const std::string& title) -> std::string {
+    std::string hosts;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(i);
+      const tabs::TabCollection* parent = tab->GetParentCollection();
+      std::string split;
+      if (parent && parent->type() == tabs::TabCollection::Type::SPLIT) {
+        split = "|";
+        parent = parent->GetParentCollection();
+      }
+      if (parent && parent->type() == tabs::TabCollection::Type::FOLDER &&
+          static_cast<const tabs::FolderTabCollection*>(parent)->title() ==
+              title) {
+        hosts += std::string(
+                     tab->GetContents()->GetLastCommittedURL().host()) +
+                 split + " ";
+      }
+    }
+    return hosts;
+  };
+  // Closes the folder holding the tab at `index`, then the tabs between the
+  // first and it with no record, so the folder stays the newest close.
+  const auto close_folder_and_pad = [&](int index) {
+    const tabs::TabCollection* parent = ParentOf(index);
+    if (parent->type() == tabs::TabCollection::Type::SPLIT) {
+      parent = parent->GetParentCollection();
+    }
+    ASSERT_EQ(tabs::TabCollection::Type::FOLDER, parent->type());
+    tab_strip_model()->ActivateTabAt(0);
+    tab_strip_model()->CloseFolderTabs(const_cast<tabs::FolderTabCollection*>(
+        static_cast<const tabs::FolderTabCollection*>(parent)));
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return tab_strip_model()->count() == index; }));
+    while (tab_strip_model()->count() > 1) {
+      tab_strip_model()->CloseWebContentsAt(1, TabCloseTypes::CLOSE_NONE);
+    }
+  };
+
+  // [x, pad, F[a, b, c]], the folder at 2; [x] after the close.
+  for (const char* const host : {"pad.test", "a.test", "b.test", "c.test"}) {
+    OpenLoaded(host);
+  }
+  tabs::FolderTabCollection* folder =
+      tab_strip_model()->AddToNewFolder({2, 3, 4});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Three");
+  ASSERT_NO_FATAL_FAILURE(close_folder_and_pad(2));
+  chrome::RestoreTab(browser());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return in_folder("Three").size() ==
+           std::string("a.test b.test c.test ").size();
+  })) << "the folder came back as \"" << in_folder("Three") << "\"";
+  EXPECT_EQ("a.test b.test c.test ", in_folder("Three"));
+  EXPECT_EQ("a.test", tab_strip_model()
+                          ->GetActiveWebContents()
+                          ->GetLastCommittedURL()
+                          .host())
+      << "the folder's first tab is shown";
+
+  // Down to [x], then [x, pad, F[split(d, e), f]], the folder at 2 again.
+  while (tab_strip_model()->count() > 1) {
+    tab_strip_model()->CloseWebContentsAt(1, TabCloseTypes::CLOSE_NONE);
+  }
+  for (const char* const host : {"pad.test", "d.test", "e.test", "f.test"}) {
+    OpenLoaded(host);
+  }
+  ASSERT_EQ(5, tab_strip_model()->count());
+  tab_strip_model()->ActivateTabAt(2);
+  tab_strip_model()->AddToNewSplit(
+      {3}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  folder = tab_strip_model()->AddToNewFolder({2, 3, 4});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Pair");
+  ASSERT_EQ("d.test| e.test| f.test ", in_folder("Pair"));
+  ASSERT_NO_FATAL_FAILURE(close_folder_and_pad(2));
+  chrome::RestoreTab(browser());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return in_folder("Pair").size() ==
+           std::string("d.test| e.test| f.test ").size();
+  })) << "the folder came back as \"" << in_folder("Pair") << "\"";
+  EXPECT_EQ("d.test| e.test| f.test ", in_folder("Pair"))
+      << "the split came back whole, before f";
+}
+
+// folders, BACKLOG S-136: a split made of a folder's tabs stays in the
+// folder, in their place: two of its tabs split from the menu, and its last
+// tab split with a new tab. Both left the folder, and a folder they emptied
+// went.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ASplitOfAFoldersTabsStaysInIt) {
+  tabs::FolderTabCollection* const folder = MakeFolder();
+  ASSERT_TRUE(folder);
+  const auto split_home = [&](int index) -> const tabs::TabCollection* {
+    const tabs::TabCollection* const split = ParentOf(index);
+    return split && split->type() == tabs::TabCollection::Type::SPLIT
+               ? split->GetParentCollection()
+               : nullptr;
+  };
+  // F[1, 2]: both of its tabs.
+  tab_strip_model()->ActivateTabAt(1);
+  tab_strip_model()->AddToNewSplit(
+      {2}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  EXPECT_EQ(folder, split_home(1)) << "the split left its folder";
+  EXPECT_EQ(folder, split_home(2));
+  EXPECT_EQ(4, tab_strip_model()->count());
+  tab_strip_model()->RemoveSplit(
+      tab_strip_model()->GetTabAtIndex(1)->GetSplit().value());
+  ASSERT_EQ(folder, ParentOf(2));
+
+  // The folder's last tab, split with a new tab.
+  tab_strip_model()->ActivateTabAt(2);
+  chrome::NewSplitTab(browser(), split_tabs::SplitTabLayout::kSideBySide,
+                      split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
+  ASSERT_EQ(5, tab_strip_model()->count());
+  EXPECT_EQ(folder, split_home(2)) << "the split left its folder";
+  EXPECT_EQ(folder, split_home(3)) << "the new tab is outside the folder";
+  EXPECT_EQ(3, tab_strip_model()->active_index()) << "the new tab is shown";
+  EXPECT_NE(folder, ParentOf(4)) << "the tab after the folder stays out";
+}
+
 }  // namespace
