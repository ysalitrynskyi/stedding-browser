+// commandbar K24: Clear Site Cookies and Reload through the bar's own keys.
+// The row shows its chord, and Enter on it signs the page out: the site's
+// cookie goes, and the page reloads without it. In a private window it acts
+// on the private profile's jar alone, and the normal window stays signed in.
+// On a browser page, which has no site, the row is not offered.
+IN_PROC_BROWSER_TEST_F(CommandBarActionsTest,
+                       TheSiteCookiesRowSignsThePageOut) {
+  const std::u16string kRow = u"Clear Site Cookies and Reload";
+  const GURL echo =
+      embedded_test_server()->GetURL("a.test", "/echoheader?Cookie");
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::NavigateToURL(
+      page, embedded_test_server()->GetURL("a.test", "/set-cookie?signed=in")));
+  ASSERT_TRUE(content::NavigateToURL(page, echo));
+  ASSERT_EQ("signed=in", content::EvalJs(page, "document.body.innerText"));
+
+  // A private window clears its own jar, and only that.
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+  content::WebContents* const secret =
+      incognito->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::NavigateToURL(
+      secret,
+      embedded_test_server()->GetURL("a.test", "/set-cookie?private=1")));
+  ASSERT_TRUE(content::NavigateToURL(secret, echo));
+  ASSERT_EQ("private=1", content::EvalJs(secret, "document.body.innerText"));
+  {
+    content::TestNavigationObserver reloaded(secret);
+    Run(incognito, kRow);
+    reloaded.Wait();
+  }
+  EXPECT_EQ("None", content::EvalJs(secret, "document.body.innerText"));
+  ASSERT_TRUE(content::NavigateToURL(page, echo));
+  EXPECT_EQ("signed=in", content::EvalJs(page, "document.body.innerText"))
+      << "the private window's clear stayed in its own jar";
+
+  // The row carries its chord: Option-Shift-Cmd-R, Ctrl+Alt+Shift+R.
+  {
+    stedding::CommandBarView* const bar = Palette(browser());
+    ASSERT_TRUE(bar);
+    Type(bar, kRow);
+    ASSERT_EQ(1u, bar->row_count_for_testing());
+    EXPECT_EQ(kRow, bar->row_title_for_testing(0));
+    EXPECT_EQ(
+        ui::Accelerator(ui::VKEY_R, ui::EF_PLATFORM_ACCELERATOR |
+                                        ui::EF_SHIFT_DOWN | ui::EF_ALT_DOWN)
+            .GetShortcutText(),
+        bar->row_detail_for_testing(0));
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+  }
+  {
+    content::TestNavigationObserver reloaded(page);
+    Run(browser(), kRow);
+    reloaded.Wait();
+  }
+  EXPECT_EQ("None", content::EvalJs(page, "document.body.innerText"))
+      << "signed out";
+
+  ASSERT_TRUE(content::NavigateToURL(page, GURL("chrome://version")));
+  stedding::CommandBarView* const bar = Palette(browser());
+  ASSERT_TRUE(bar);
+  Type(bar, u"Cookies");
+  EXPECT_FALSE(std::ranges::contains(Titles(bar), kRow))
+      << "a browser page has no site";
+  bar->Close();
+  base::RunLoop().RunUntilIdle();
+}
