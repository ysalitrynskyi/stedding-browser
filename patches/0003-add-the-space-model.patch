+
+#include "components/tab_groups/token_id.h"
+
+namespace spaces {
+
+// Identifies a Space. Its own token type so it cannot be confused with a
+// TabGroupId or a FolderId at a call site.
+//
+// Note this is a runtime identity only. It does not survive a restart: tabs are
+// reassociated with their Space after restore through the session extra_data
+// key, not through this id.
+class SpaceId : public tab_groups::TokenId<SpaceId> {};
+
+}  // namespace spaces
