+// Sf2: what `browser`'s profile has open under a durable id, in this window
+// and every other one of the profile. A pin in a second window was
+// otherwise inserted again into the first. The ids were the tabs' session
+// ids, a number that is new at every launch.
+std::set<std::string> OpenIds(BrowserWindowInterface* browser) {
+  std::set<std::string> ids;
+  AddOpenIds(*browser->GetTabStripModel(), &ids);
+  Profile* const profile = browser->GetProfile();
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        if (window != browser && window->GetProfile() == profile &&
+            window->GetTabStripModel()) {
