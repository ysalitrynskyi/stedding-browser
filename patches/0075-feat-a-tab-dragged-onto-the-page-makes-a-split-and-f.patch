+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/split_drop_rules.h"
+
+namespace stedding {
+
+SplitDropSide SplitDropSideAt(int x_in_page, int page_width, bool rtl) {
+  const bool left_half = 2 * x_in_page < page_width;
+  return left_half != rtl ? SplitDropSide::kStart : SplitDropSide::kEnd;
+}
+
+bool PageTakesSplitDrop(const SplitDropCandidate& candidate) {
+  if (candidate.dragged_tabs != 1 || candidate.dragged_group_header ||
+      candidate.dragged_essential || candidate.dragged_space_pin ||
+      candidate.dragged_split) {
+    return false;
+  }
+  return !candidate.page_missing && !candidate.page_is_dragged &&
+         !candidate.page_essential && !candidate.page_space_pin &&
+         !candidate.page_split && !candidate.page_browser_page;
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/views/spaces/split_drop_rules.h b/chrome/browser/ui/views/spaces/split_drop_rules.h
new file mode 100644
index 0000000000000..82c5fd2c28cda
--- /dev/null
+++ b/chrome/browser/ui/views/spaces/split_drop_rules.h
@@ -0,0 +1,58 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_SPACES_SPLIT_DROP_RULES_H_
+#define CHROME_BROWSER_UI_VIEWS_SPACES_SPLIT_DROP_RULES_H_
+
+namespace stedding {
+
+// docs/features/splits.md J10-J15 (BACKLOG S-113, GitHub issue 7): a tab
+// dragged from either tab strip onto the page makes a split with the page.
+// The rules here decide where and whether, without a window.
+
+// The side of the split the dropped page takes, in the split's own order: the
+// first pane is kStart, drawn on the left in a left-to-right layout.
+enum class SplitDropSide {
+  kStart,
+  kEnd,
+};
+
+// J10: the page's halves are the drop zones. `x_in_page` is the pointer's
+// distance from the page's left edge, in a page `page_width` wide; the middle
+// line belongs to the right half. A right-to-left layout draws the first pane
+// on the right, so there the left half is kEnd.
+SplitDropSide SplitDropSideAt(int x_in_page, int page_width, bool rtl);
+
+// J13: what a drag carries and what it would be dropped beside.
+struct SplitDropCandidate {
+  // The tabs the drag carries, a split's panes counted each.
+  int dragged_tabs = 0;
+  // The drag began on a tab group's header.
+  bool dragged_group_header = false;
+  // The tab dragged is an essential (Chromium's pin), a Space pin, or a pane
+  // of a split.
+  bool dragged_essential = false;
+  bool dragged_space_pin = false;
+  bool dragged_split = false;
+  // The page: the tab that was on screen when the drag began, before the
+  // press that began it selected the dragged tab. Missing when it has gone.
+  bool page_missing = false;
+  bool page_is_dragged = false;
+  bool page_essential = false;
+  bool page_space_pin = false;
+  bool page_split = false;
+  // A browser page (chrome://) other than the New Tab page, which Chromium's
+  // own split drop refuses too.
+  bool page_browser_page = false;
+};
+
+// J13: whether the page takes the drop: one plain tab -- a folder's tab
+// included -- dragged onto a page that is not that tab, not already a split,
+// and not a browser page other than the New Tab page. Essentials and Space
+// pins are refused on either side for now (splits J5; the owner, 2026-10-20).
+bool PageTakesSplitDrop(const SplitDropCandidate& candidate);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SPACES_SPLIT_DROP_RULES_H_
diff --git a/chrome/browser/ui/views/spaces/split_drop_rules_unittest.cc b/chrome/browser/ui/views/spaces/split_drop_rules_unittest.cc
new file mode 100644
index 0000000000000..28449d84f8681
