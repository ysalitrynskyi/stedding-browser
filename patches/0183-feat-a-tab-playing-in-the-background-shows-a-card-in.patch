@@ -0,0 +1,368 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/audio_strip.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding/video_pop_out.h"
+#include "chrome/browser/ui/tab_ui_helper.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+
+namespace stedding {
+
+namespace {
+
+using media_session::mojom::MediaAudioVideoState;
+using media_session::mojom::MediaPictureInPictureState;
+using media_session::mojom::MediaPlaybackState;
+using media_session::mojom::MediaSessionInfo;
+
+bool Eligible(const AudioStripTab& tab, std::optional<int> shown) {
+  return !tab.on_screen && !tab.muted && tab.controllable && !tab.popped_out &&
+         !tab.stopped && (tab.playing || shown == tab.id);
+}
+
+// Sound, or a session that says nothing of what it plays.
+bool HasSound(const MediaSessionInfo& info) {
+  if (!info.audio_video_states) {
+    return true;
+  }
+  return std::ranges::any_of(
+      *info.audio_video_states, [](MediaAudioVideoState state) {
+        return state == MediaAudioVideoState::kAudioOnly ||
+               state == MediaAudioVideoState::kAudioVideo;
+      });
+}
+
+}  // namespace
+
+std::optional<int> ChooseAudioStripTab(base::span<const AudioStripTab> tabs,
+                                       std::optional<int> shown) {
+  const AudioStripTab* best = nullptr;
+  for (const AudioStripTab& tab : tabs) {
+    if (Eligible(tab, shown) && (!best || tab.started > best->started)) {
+      best = &tab;
+    }
+  }
+  return best ? std::optional<int>(best->id) : std::nullopt;
+}
+
+// One tab's page and its media session, as the rules read them.
+class AudioStrip::TabWatch : public content::WebContentsObserver,
+                             public media_session::mojom::MediaSessionObserver {
+ public:
+  TabWatch(AudioStrip& strip, tabs::TabInterface& tab, int id)
+      : strip_(strip), tab_(tab), id_(id) {
+    ObservePage(tab.GetContents());
+    // The row's title or favicon changed; the card shows them too.
+    if (TabUIHelper* const helper = TabUIHelper::From(&tab)) {
+      ui_changed_ = helper->AddTabUIChangeCallback(base::BindRepeating(
+          [](TabWatch* watch) { watch->strip_->OnTabUIChanged(watch->id_); },
+          base::Unretained(this)));
+    }
+  }
+  TabWatch(const TabWatch&) = delete;
+  TabWatch& operator=(const TabWatch&) = delete;
+  ~TabWatch() override = default;
+
+  tabs::TabInterface& tab() const { return *tab_; }
+  int id() const { return id_; }
+  bool playing() const { return playing_; }
+  void set_stopped() { stopped_ = true; }
+
+  // A sleeping tab's page is replaced when it wakes, and the other way.
+  void ObservePage(content::WebContents* contents) {
+    receiver_.reset();
+    playing_ = controllable_ = session_muted_ = popped_out_ = false;
+    Observe(contents);
+    // GetIfExists: watching creates no session for a page that never played.
+    if (content::MediaSession* const session =
+            contents ? content::MediaSession::GetIfExists(contents) : nullptr) {
+      Listen(*session);
+    }
+  }
+
+  AudioStripTab Read(TabStripModel* strip) const {
+    content::WebContents* const contents = web_contents();
+    AudioStripTab tab;
+    tab.id = id_;
+    tab.on_screen = VideoPopOut::IsOnScreen(strip, contents);
+    tab.muted = session_muted_ || (contents && contents->IsAudioMuted());
+    tab.controllable = controllable_;
+    tab.playing = playing_;
+    tab.popped_out =
+        popped_out_ || (contents && contents->HasPictureInPictureVideo());
+    tab.stopped = stopped_;
+    tab.started = started_;
+    return tab;
+  }
+
+ private:
+  void Listen(content::MediaSession& session) {
+    receiver_.reset();
+    session.AddObserver(receiver_.BindNewPipeAndPassRemote());
+  }
+
+  // content::WebContentsObserver:
+  void MediaSessionCreated(content::MediaSession* session) override {
+    Listen(*session);
+  }
+  void DidUpdateAudioMutingState(bool muted) override { strip_->Update(); }
+  void MediaPictureInPictureChanged(bool is_picture_in_picture) override {
+    strip_->Update();
+  }
+  void WebContentsDestroyed() override {
+    receiver_.reset();
+    playing_ = controllable_ = false;
+    strip_->Update();
+  }
+
+  // media_session::mojom::MediaSessionObserver:
+  void MediaSessionInfoChanged(
+      media_session::mojom::MediaSessionInfoPtr info) override {
+    const bool was_playing = playing_;
+    controllable_ = info && info->is_controllable &&
+                    info->state != MediaSessionInfo::SessionState::kInactive;
+    playing_ = controllable_ &&
+               info->playback_state == MediaPlaybackState::kPlaying &&
+               HasSound(*info);
+    session_muted_ = info && info->muted;
+    popped_out_ = info && info->picture_in_picture_state ==
+                              MediaPictureInPictureState::kInPictureInPicture;
+    if (playing_ && !was_playing) {
+      started_ = strip_->NextStart();
+      stopped_ = false;
+    }
+    strip_->Update();
+  }
+  void MediaSessionMetadataChanged(
+      const std::optional<media_session::MediaMetadata>& metadata) override {}
+  void MediaSessionActionsChanged(
+      const std::vector<media_session::mojom::MediaSessionAction>& actions)
+      override {}
+  void MediaSessionImagesChanged(
+      const base::flat_map<media_session::mojom::MediaSessionImageType,
+                           std::vector<media_session::MediaImage>>& images)
+      override {}
+  void MediaSessionPositionChanged(
+      const std::optional<media_session::MediaPosition>& position) override {}
+
+  const raw_ref<AudioStrip> strip_;
+  const raw_ref<tabs::TabInterface> tab_;
+  const int id_;
+  bool playing_ = false;
+  bool controllable_ = false;
+  bool session_muted_ = false;
+  bool popped_out_ = false;
+  bool stopped_ = false;
+  uint64_t started_ = 0;
+  base::CallbackListSubscription ui_changed_;
+  mojo::Receiver<media_session::mojom::MediaSessionObserver> receiver_{this};
+};
+
+DEFINE_USER_DATA(AudioStrip);
+
+// static
+AudioStrip* AudioStrip::From(BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+AudioStrip::AudioStrip(BrowserWindowInterface& browser)
+    : browser_(browser),
+      scoped_user_data_(browser.GetUnownedUserDataHost(), *this) {
+  if (Profile* const profile = browser.GetProfile()) {
+    registrar_.Init(profile->GetPrefs());
+    registrar_.Add(
+        prefs::kPlayerAudioStrip,
+        base::BindRepeating(&AudioStrip::Update, base::Unretained(this),
+                            /*changed=*/true));
+  }
+  if (TabStripModel* const strip = browser.GetTabStripModel()) {
+    strip->AddObserver(this);
+    for (int i = 0; i < strip->count(); ++i) {
+      Watch(strip->GetTabAtIndex(i));
+    }
+  }
+}
+
+AudioStrip::~AudioStrip() = default;
+
+void AudioStrip::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void AudioStrip::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+tabs::TabInterface* AudioStrip::tab() const {
+  TabWatch* const watch = CardWatch();
+  return watch ? &watch->tab() : nullptr;
+}
+
+bool AudioStrip::playing() const {
+  TabWatch* const watch = CardWatch();
+  return watch && watch->playing();
+}
+
+std::u16string AudioStrip::title() const {
+  tabs::TabInterface* const card = tab();
+  const TabUIHelper* const helper = card ? TabUIHelper::From(card) : nullptr;
+  return helper ? helper->GetTitle() : std::u16string();
+}
+
+ui::ImageModel AudioStrip::favicon() const {
+  tabs::TabInterface* const card = tab();
+  TabUIHelper* const helper = card ? TabUIHelper::From(card) : nullptr;
+  return helper ? helper->GetFavicon() : ui::ImageModel();
+}
+
+bool AudioStrip::ShowTab() {
+  tabs::TabInterface* const card = tab();
+  TabStripModel* const strip = browser_->GetTabStripModel();
+  if (!card || !strip) {
+    return false;
+  }
+  const int index = strip->GetIndexOfTab(card);
+  if (index == TabStripModel::kNoTab) {
+    return false;
+  }
+  // The Space follows its active tab, so this shows the tab's Space too.
+  strip->ActivateTabAt(index);
+  return true;
+}
+
+void AudioStrip::PlayOrPause() {
+  tabs::TabInterface* const card = tab();
+  content::MediaSession* const session =
+      card ? content::MediaSession::GetIfExists(card->GetContents()) : nullptr;
+  if (!session) {
+    return;
+  }
+  if (playing()) {
+    session->Suspend(content::MediaSession::SuspendType::kUI);
+  } else {
+    session->Resume(content::MediaSession::SuspendType::kUI);
+  }
+}
+
+void AudioStrip::Stop() {
+  TabWatch* const watch = CardWatch();
+  if (!watch) {
+    return;
+  }
+  watch->set_stopped();
+  if (content::MediaSession* const session =
+          content::MediaSession::GetIfExists(watch->tab().GetContents())) {
+    session->Stop(content::MediaSession::SuspendType::kUI);
+  }
+  Update();
+}
+
+void AudioStrip::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  switch (change.type()) {
+    case TabStripModelChange::kInserted:
+      for (const TabStripModelChange::ContentsWithIndex& inserted :
+           change.GetInsert()->contents) {
+        Watch(inserted.tab);
+      }
+      break;
+    case TabStripModelChange::kRemoved:
+      for (const TabStripModelChange::RemovedTab& removed :
+           change.GetRemove()->contents) {
+        Unwatch(removed.tab);
+      }
+      break;
+    case TabStripModelChange::kReplaced: {
+      const TabStripModelChange::Replace* const replace = change.GetReplace();
+      if (TabWatch* const watch = WatchOf(replace->tab)) {
+        watch->ObservePage(replace->new_contents);
+      }
+      break;
+    }
+    default:
+      break;
+  }
+  // A tab chosen, a Space shown, a split made or undone: what is on screen
+  // may have changed.
+  Update();
+}
+
+void AudioStrip::Watch(tabs::TabInterface* tab) {
+  if (!tab || watches_.contains(tab)) {
+    return;
+  }
+  watches_.emplace(tab, std::make_unique<TabWatch>(*this, *tab, ++next_id_));
+}
+
+void AudioStrip::Unwatch(tabs::TabInterface* tab) {
+  watches_.erase(tab);
+}
+
+AudioStrip::TabWatch* AudioStrip::WatchOf(tabs::TabInterface* tab) const {
+  const auto it = watches_.find(tab);
+  return it == watches_.end() ? nullptr : it->second.get();
+}
+
+AudioStrip::TabWatch* AudioStrip::CardWatch() const {
+  if (!card_) {
+    return nullptr;
+  }
+  for (const auto& [tab, watch] : watches_) {
+    if (watch->id() == *card_) {
+      return watch.get();
+    }
+  }
+  return nullptr;
+}
+
+void AudioStrip::OnTabUIChanged(int id) {
+  if (card_ == id) {
+    Update(/*changed=*/true);
+  }
+}
+
+void AudioStrip::Update(bool changed) {
+  std::optional<int> card;
+  Profile* const profile = browser_->GetProfile();
+  TabStripModel* const strip = browser_->GetTabStripModel();
+  if (profile && strip &&
+      profile->GetPrefs()->GetBoolean(prefs::kPlayerAudioStrip)) {
+    std::vector<AudioStripTab> tabs;
+    tabs.reserve(watches_.size());
+    for (const auto& [tab, watch] : watches_) {
+      tabs.push_back(watch->Read(strip));
+    }
+    card = ChooseAudioStripTab(tabs, card_);
+  }
+  const bool card_changed = card != card_;
+  card_ = card;
+  const bool playing = this->playing();
+  if (!card_changed && !changed && playing == card_playing_) {
+    return;
+  }
+  card_playing_ = playing;
+  for (Observer& observer : observers_) {
+    observer.OnAudioStripChanged();
+  }
+}
+
+}  // namespace stedding
