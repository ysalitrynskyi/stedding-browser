+void SidebarWindowButtons::UpdateMaximize() {
+  // The window's buttons are on the sidebar only on Windows (Y48), where
+  // Restore is a command of its own.
+#if BUILDFLAG(IS_WIN)
+  const bool maximized = GetWidget() && GetWidget()->IsMaximized();
+  constexpr int kRestore = IDC_RESTORE_WINDOW;
+#else
+  const bool maximized = false;
+  constexpr int kRestore = IDC_MAXIMIZE_WINDOW;
