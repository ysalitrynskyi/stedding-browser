+// The header row: chevron + name. Single click collapses, double click
+// renames.
+class FolderView::HeaderView : public views::View {
+  METADATA_HEADER(HeaderView, views::View)
+
+ public:
+  explicit HeaderView(FolderView* owner) : owner_(owner) {
+    auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::VH(0, kHeaderInset), 6));
+    layout->set_cross_axis_alignment(
