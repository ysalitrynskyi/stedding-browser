+// P16-1h; Sf35: an item another computer's batch brought back from a
+// removal -- removed there, edited there after it -- is removed again by
+// Undo, here and in this computer's file. Undo wrote back the values the
+// removed item had, which left it as it was: alive, and its tab open.
+IN_PROC_BROWSER_TEST_F(SidebarSyncW2B13Test,
+                       UndoRemovesAnItemABatchBroughtBack) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  const std::string pin = NewTabIdW2B13();
+  const int64_t start = NowMsW2B13();
+  // The other computer's pin, removed there before this computer joined.
+  sb::State removed = PeerStateW2B13(space, {pin}, start);
+  removed.records[pin].del = sb::Stamp{start + 1'000, kPeerW2B13};
+  WritePeer(removed, 1);
+  ASSERT_NO_FATAL_FAILURE(Join());
+  ASSERT_TRUE(LedgerRecord(pin));
+  ASSERT_FALSE(LedgerRecord(pin)->Alive());
+  ASSERT_FALSE(TabWithToken(pin));
+
+  // The other computer brings it back (reopened there): its fields are
+  // newer than its removal, which it keeps.
+  sb::State revived = PeerStateW2B13(space, {pin}, start + 60'000);
+  revived.records[pin].del = sb::Stamp{start + 1'000, kPeerW2B13};
+  WritePeer(revived, 2);
+  Scan();
+  ASSERT_TRUE(LedgerRecord(pin));
+  ASSERT_TRUE(LedgerRecord(pin)->Alive());
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return TabWithToken(pin) != nullptr; }))
+      << "the pin the batch brought back was not inserted";
+
+  // Settings lists the batch, one added, with Undo.
+  std::string batch;
+  {
+    const base::DictValue status = service()->GetStatus();
+    const base::ListValue* const journal = status.FindList("journal");
+    ASSERT_TRUE(journal);
+    for (const base::Value& row : *journal) {
+      const std::optional<int> added = row.GetDict().FindInt("added");
+      const std::string* const id = row.GetDict().FindString("id");
+      if (added == 1 && id) {
+        batch = *id;
+        break;
+      }
+    }
+  }
+  ASSERT_FALSE(batch.empty()) << "no batch of one addition is listed";
+
+  ASSERT_TRUE(service()->UndoBatch(batch));
+  ASSERT_TRUE(LedgerRecord(pin));
+  EXPECT_FALSE(LedgerRecord(pin)->Alive())
+      << "Undo left the item the batch brought back";
+  EXPECT_TRUE(
+      base::test::RunUntil([&] { return TabWithToken(pin) == nullptr; }))
+      << "Undo left the tab of the item the batch brought back";
+  service()->Stop(/*remove_own_file=*/false);
+}
