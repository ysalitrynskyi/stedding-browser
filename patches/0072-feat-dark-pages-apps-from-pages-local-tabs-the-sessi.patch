@@ -0,0 +1,97 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/common/stedding/web_apps.h"
+
+#include "chrome/common/stedding/space_partitions.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace stedding {
+
+void RecordAppJarForPartition(PrefService& prefs,
+                              std::string_view app_id,
+                              std::string_view partition_domain,
+                              std::string_view partition_name) {
+  if (app_id.empty() || !prefs.FindPreference(kAppJarsPref)) {
+    return;
+  }
+  ScopedDictPrefUpdate update(prefs, kAppJarsPref);
+  // Only a Space's own jar is worth a record: the shared jar is what an app
+  // gets without one, and any other partition (an extension's, an isolated
+  // web app's) is not a session a Space keeps.
+  if (partition_domain == kSpacePartitionDomain && !partition_name.empty()) {
+    update->Set(app_id, partition_name);
+  } else {
+    update->Remove(app_id);
+  }
+}
+
+void ForgetAppJar(PrefService& prefs, std::string_view app_id) {
+  if (!prefs.FindPreference(kAppJarsPref) ||
+      !prefs.GetDict(kAppJarsPref).Find(app_id)) {
+    return;
+  }
+  ScopedDictPrefUpdate update(prefs, kAppJarsPref);
+  update->Remove(app_id);
+}
+
+std::string RecordedAppJar(const PrefService& prefs, std::string_view app_id) {
+  if (!prefs.FindPreference(kAppJarsPref)) {
+    return std::string();
+  }
+  const std::string* const jar = prefs.GetDict(kAppJarsPref).FindString(app_id);
+  return jar ? *jar : std::string();
+}
+
+std::string AppJarInUse(const base::DictValue& jars,
+                        const base::ListValue& registry,
+                        std::string_view app_id) {
+  const std::string* const jar = jars.FindString(app_id);
+  if (!jar || jar->empty()) {
+    return std::string();
+  }
+  // The registry's own keys (spaces::SpaceRegistry::ToValue): "profile" is
+  // the Space's jar name, "isolated" whether its tabs use that jar now; a
+  // registry from before the flag reads a name as on (sessions S19).
+  for (const base::Value& item : registry) {
+    const base::DictValue* const space = item.GetIfDict();
+    const std::string* const name =
+        space ? space->FindString("profile") : nullptr;
+    if (!name || *name != *jar) {
+      continue;
+    }
+    if (space->FindBool("isolated").value_or(true)) {
+      return *jar;
+    }
+  }
+  return std::string();
+}
+
+std::string AppJarInUse(const PrefService& prefs, std::string_view app_id) {
+  if (!prefs.FindPreference(kAppJarsPref) ||
+      !prefs.FindPreference(kSpaceRegistryPref)) {
+    return std::string();
+  }
+  return AppJarInUse(prefs.GetDict(kAppJarsPref),
+                     prefs.GetList(kSpaceRegistryPref), app_id);
+}
+
+std::vector<std::string> AppsRecordingJar(const PrefService& prefs,
+                                          std::string_view jar) {
+  std::vector<std::string> apps;
+  if (jar.empty() || !prefs.FindPreference(kAppJarsPref)) {
+    return apps;
+  }
+  // A dictionary iterates in key order.
+  for (const auto [app_id, value] : prefs.GetDict(kAppJarsPref)) {
+    if (const std::string* const name = value.GetIfString();
+        name && *name == jar) {
+      apps.push_back(app_id);
+    }
+  }
+  return apps;
+}
+
+}  // namespace stedding
