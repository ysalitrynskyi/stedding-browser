+// Accepts a tab dragged onto a folder's header row, and moves it into that
+// folder (docs/features/folders.md, F7).
+//
+// Same shape as SpaceDragTarget, and the same dangerous part: HandleTabDrop
+// takes ownership of the tab it is handed and must put it back. Unlike the
+// Space target this lives inside the tab strip, so the drag controller asks
+// for it before it asks the strip itself; while a header is hovered the tab
+// stays attached to the strip rather than popping out into a window.
+class FolderDragTarget : public TabDragTarget {
+ public:
+  // `tab_strip_root` is the view whose descendants include the FolderViews;
+  // null means hit-testing is the caller's job (tests use SetHoveredFolder).
+  FolderDragTarget(TabStripModel& tabs, views::View* tab_strip_root);
+  FolderDragTarget(const FolderDragTarget&) = delete;
+  FolderDragTarget& operator=(const FolderDragTarget&) = delete;
+  ~FolderDragTarget() override;
+
+  // The FolderView whose header contains `point_in_screen`, or null.
+  FolderView* FolderViewAtScreenPoint(const gfx::Point& point_in_screen) const;
+
+  // Remembers which folder the pointer is over. `view` may be null; it is
+  // only used for the drop highlight.
+  void SetHoveredFolder(const tabs::TabCollection* folder, FolderView* view);
+  void ClearHoveredFolder();
+
+  // The drag session says whether the dragged tab is pinned; a test has no
+  // session, so it says so here.
+  void SetDraggedTabPinnedForTesting(bool pinned) { dragged_pinned_ = pinned; }
+
+  // TabDragTarget:
+  void OnTabDragEntered() override;
+  TabDragContext* OnTabDragUpdated(TabDragTarget::DragController& controller,
+                                   const gfx::Point& point_in_screen) override;
+  void OnTabDragExited(const gfx::Point& point_in_screen) override;
+  void OnTabDragEnded() override;
+  bool CanDropTab() override;
+  void HandleTabDrop(DragController& controller) override;
+  base::CallbackListSubscription RegisterWillDestroyCallback(
+      base::OnceClosure callback) override;
+
+ private:
+  static FolderView* FindFolderView(views::View& parent,
+                                    const gfx::Point& point_in_screen);
+
+  const raw_ref<TabStripModel> tabs_;
+  const raw_ptr<views::View> tab_strip_root_;
+  // A handle, not a pointer: the folder can be peeled out of the tree while
+  // the drag is in flight (its last tab is the one being dragged).
+  std::optional<tabs::TabCollectionHandle> hovered_;
+  raw_ptr<FolderView> hovered_view_ = nullptr;
+  // Whether the tab in flight is an essentials (pinned) tab. Read from the
+  // drag session on each update, because detaching clears the tab's own flag.
+  bool dragged_pinned_ = false;
+  base::OnceClosureList will_destroy_callbacks_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_FOLDER_DRAG_TARGET_H_
diff --git a/chrome/browser/ui/views/tabs/common/folder_drag_target_unittest.cc b/chrome/browser/ui/views/tabs/common/folder_drag_target_unittest.cc
new file mode 100644
index 0000000000000..f814f56d51ef0
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/common/folder_drag_target_unittest.cc
@@ -0,0 +1,134 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/folder_drag_target.h"
+
+#include <memory>
+#include <utility>
+
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/dragging/drag_session_data.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Stands in for the drag machinery. It hands over the tab at a chosen strip
+// index, which is the part that matters: a drop handler that takes a tab and
+// fails to put it back has lost it.
+class FakeDragController : public TabDragTarget::DragController {
+ public:
+  FakeDragController(TabStripModel* tabs, int index)
+      : tabs_(tabs), index_(index) {}
+
+  std::unique_ptr<tabs::TabModel> DetachTabAtForInsertion(
+      int drag_idx) override {
+    return tabs_->DetachTabAtForInsertion(index_);
+  }
+  const DragSessionData& GetSessionData() const override { return data_; }
+  const TabDragContext* GetAttachedContext() const override { return nullptr; }
+
+ private:
+  const raw_ptr<TabStripModel> tabs_;
+  const int index_;
+  DragSessionData data_;
+};
+
+class FolderDragTargetTest : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+
+  // Three tabs; the first two in a folder, the third free. The fixture
+  // inserts at index 0, so add in reverse to keep the strip readable.
+  tabs::FolderTabCollection* SetUpFolderAndAFreeTab() {
+    for (int i = 0; i < 3; ++i) {
+      AddTab(browser(), GURL("https://example.com/"));
+    }
+    tabs::FolderTabCollection* const folder = tabs().AddToNewFolder({0, 1});
+    CHECK(folder);
+    CHECK_EQ(2u, folder->TabCountRecursive());
+    return folder;
+  }
+};
+
+// F7
+TEST_F(FolderDragTargetTest, DroppingOnAFolderHeaderMovesTheTabIntoIt) {
+  tabs::FolderTabCollection* const folder = SetUpFolderAndAFreeTab();
+  tabs::TabInterface* const free_tab = tabs().GetTabAtIndex(2);
+  ASSERT_NE(folder, free_tab->GetParentCollection());
+
+  FolderDragTarget target(tabs(), /*tab_strip_root=*/nullptr);
+  target.SetHoveredFolder(folder, /*view=*/nullptr);
+  ASSERT_TRUE(target.CanDropTab());
+
+  FakeDragController controller(&tabs(), 2);
+  target.HandleTabDrop(controller);
+
+  ASSERT_EQ(3, tabs().count()) << "the drop handler lost the tab";
+  EXPECT_EQ(3u, folder->TabCountRecursive());
+  // The tab object survives the detach/insert round trip.
+  tabs::TabInterface* const joined = tabs().GetTabAtIndex(2);
+  EXPECT_EQ(folder, joined->GetParentCollection());
+  EXPECT_EQ(joined, tabs().GetActiveTab()) << "the dropped tab stays active";
+}
+
+// F7
+TEST_F(FolderDragTargetTest, DroppingNowhereLeavesTheTabAlone) {
+  tabs::FolderTabCollection* const folder = SetUpFolderAndAFreeTab();
+  FolderDragTarget target(tabs(), /*tab_strip_root=*/nullptr);
+  target.ClearHoveredFolder();
+  EXPECT_FALSE(target.CanDropTab());
+
+  FakeDragController controller(&tabs(), 2);
+  target.HandleTabDrop(controller);
+
+  EXPECT_EQ(3, tabs().count());
+  EXPECT_EQ(2u, folder->TabCountRecursive());
+}
+
+// F8
+TEST_F(FolderDragTargetTest, APinnedTabStaysPinnedAndOutOfTheFolder) {
+  tabs::FolderTabCollection* const folder = SetUpFolderAndAFreeTab();
+  tabs().SetTabPinned(2, true);
+  // Pinning moves the tab to the front of the strip.
+  tabs::TabInterface* const pinned = tabs().GetTabAtIndex(0);
+  ASSERT_TRUE(pinned->IsPinned());
+
+  FolderDragTarget target(tabs(), /*tab_strip_root=*/nullptr);
+  target.SetHoveredFolder(folder, /*view=*/nullptr);
+  target.SetDraggedTabPinnedForTesting(true);
+  EXPECT_FALSE(target.CanDropTab()) << "a header is not a target for an essential";
+
+  // Even if the drop is forced through, the tab goes back to the essentials
+  // row and the folder is untouched.
+  FakeDragController controller(&tabs(), 0);
+  target.HandleTabDrop(controller);
+
+  ASSERT_EQ(3, tabs().count());
+  EXPECT_EQ(2u, folder->TabCountRecursive());
+  EXPECT_TRUE(tabs().GetTabAtIndex(0)->IsPinned());
+  EXPECT_NE(folder, tabs().GetTabAtIndex(0)->GetParentCollection());
+}
+
+// F7: the folder's only tab dragged onto its own header does not crash and
+// does not vanish.
+TEST_F(FolderDragTargetTest, DraggingAFoldersOnlyTabOntoItselfKeepsTheTab) {
+  AddTab(browser(), GURL("https://example.com/"));
+  AddTab(browser(), GURL("https://example.com/"));
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder({0});
+  ASSERT_EQ(1u, folder->TabCountRecursive());
+
+  FolderDragTarget target(tabs(), /*tab_strip_root=*/nullptr);
+  target.SetHoveredFolder(folder, /*view=*/nullptr);
+  FakeDragController controller(&tabs(), 0);
+  target.HandleTabDrop(controller);
+
+  EXPECT_EQ(2, tabs().count());
+  EXPECT_FALSE(target.CanDropTab()) << "the emptied folder is gone";
+}
+
+}  // namespace
diff --git a/chrome/browser/ui/views/tabs/common/folder_view.cc b/chrome/browser/ui/views/tabs/common/folder_view.cc
