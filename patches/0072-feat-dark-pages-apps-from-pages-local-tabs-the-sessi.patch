+
+// Dark pages in the Mac menu bar (docs/features/dark-pages.md Dk24): the
+// View menu's "Dark Pages" row carries the chord, Option-Shift-Cmd-D, so a
+// key press reaches the command through the menu, as Mac users look for it
+// there; the window checks the row while dark pages is on, and choosing it
+// turns dark pages off or on. MainMenuBuilderTest checks how the row is
+// built; this runs it in a real window.
+
+#import <Carbon/Carbon.h>
+#import <Cocoa/Cocoa.h>
+
+#include "base/test/run_until.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/dark_pages.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/test/browser_test.h"
+#include "testing/gtest_mac.h"
+#include "ui/events/test/cocoa_test_event_utils.h"
+#include "ui/gfx/native_ui_types.h"
+
+namespace {
+
+using DarkPagesMenuMacTest = InProcessBrowserTest;
+
+// The row in the menu bar the app shows now.
+NSMenuItem* ViewMenuRow() {
+  return [[[NSApp.mainMenu itemWithTag:IDC_VIEW_MENU] submenu]
+      itemWithTag:IDC_STEDDING_TOGGLE_DARK_PAGES];
+}
+
+// Dk24: unchecked while dark pages is off, checked while on, from the
+// window's own validation, the one the menu asks before it opens; choosing
+// the row sends the window's command, which turns dark pages off.
+IN_PROC_BROWSER_TEST_F(DarkPagesMenuMacTest,
+                       TheViewMenuRowIsCheckedWhileOnAndRuns) {
+  NSMenuItem* const row = ViewMenuRow();
+  ASSERT_TRUE(row);
+  NSWindow* const window =
+      browser()->GetWindow()->GetNativeWindow().GetNativeNSWindow();
+  ASSERT_TRUE(window);
+  Profile* const profile = browser()->GetProfile();
+
+  ASSERT_FALSE(stedding::DarkPagesOn(profile));
+  EXPECT_TRUE([window validateUserInterfaceItem:row]) << "enabled";
+  EXPECT_EQ(NSControlStateValueOff, row.state);
+
+  stedding::SetDarkPagesOn(profile, true);
+  EXPECT_TRUE([window validateUserInterfaceItem:row]);
+  EXPECT_EQ(NSControlStateValueOn, row.state) << "checked while on";
+
+  ASSERT_TRUE([NSApp sendAction:row.action to:window from:row]);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !stedding::DarkPagesOn(profile);
+  })) << "the row turns dark pages off";
+  EXPECT_TRUE([window validateUserInterfaceItem:row]);
+  EXPECT_EQ(NSControlStateValueOff, row.state);
+
+  ASSERT_TRUE([NSApp sendAction:row.action to:window from:row]);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return stedding::DarkPagesOn(profile);
+  })) << "and on again";
+}
+
+// Dk18, Dk24: the row shows the chord beside it, and the chord pressed is
+// found in the main menu, so the menu, not a table of keys coded apart from
+// it, runs the command (accelerators_cocoa.mm holds the chord).
+IN_PROC_BROWSER_TEST_F(DarkPagesMenuMacTest, TheChordIsTheViewMenuRows) {
+  NSMenuItem* const row = ViewMenuRow();
+  ASSERT_TRUE(row);
+  // AppKit names a shifted letter by its capital, without the Shift flag.
+  EXPECT_NSEQ(@"D", row.keyEquivalent);
+  EXPECT_EQ(NSEventModifierFlagCommand | NSEventModifierFlagOption,
+            row.keyEquivalentModifierMask);
+
+  NSEvent* const event = cocoa_test_event_utils::KeyEventWithKeyCode(
+      kVK_ANSI_D, 'D', NSEventTypeKeyDown,
+      NSEventModifierFlagCommand | NSEventModifierFlagShift |
+          NSEventModifierFlagOption);
+  CommandForKeyEventResult result = CommandForKeyEvent(event);
+  EXPECT_EQ(IDC_STEDDING_TOGGLE_DARK_PAGES, result.chrome_command);
+  EXPECT_TRUE(result.from_main_menu) << "the menu carries the chord";
+}
+
+}  // namespace
