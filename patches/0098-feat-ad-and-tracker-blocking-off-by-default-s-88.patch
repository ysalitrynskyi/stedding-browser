+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_ACTIVATION_THROTTLE_H_
+#define CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_ACTIVATION_THROTTLE_H_
+
+#include "content/public/browser/navigation_throttle.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+}  // namespace content
+
+namespace stedding {
+
+// docs/features/blocker.md Bk1: decides, for each top-level page, whether
+// Chromium's subresource filter blocks what the lists name. While blocking
+// is on, the subresource filter's throttle manager adds this throttle to a
+// page's navigation in place of its Safe Browsing activation throttle
+// (ContentSubresourceFilterThrottleManager::SetPageActivationThrottleFactory,
+// docs/decisions/0030-ad-and-tracker-blocking.md). At WillProcessResponse,
+// once the final address is known, it hands the decision over the way the
+// Safe Browsing throttle does, through the tab's
+// SubresourceFilterObserverManager:
+//   - kEnabled where blocking applies (BlockerAppliesTo), or where DevTools
+//     forced the filter on, as the Safe Browsing throttle allowed;
+//   - otherwise Chromium's ad-tagging dry run while kAdTagging is on, which
+//     tags ad frames and blocks nothing, and no activation when it is off.
+// It writes nothing for the site visited (Bk7): Chromium's own path through
+// ProfileInteractionManager, which records the site's activation in its
+// ADS_DATA metadata, is not taken.
+class BlockerActivationThrottle : public content::NavigationThrottle {
+ public:
+  // The factory the throttle manager runs for each subresource filter root
+  // navigation.
+  static void MaybeAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit BlockerActivationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  BlockerActivationThrottle(const BlockerActivationThrottle&) = delete;
+  BlockerActivationThrottle& operator=(const BlockerActivationThrottle&) =
+      delete;
+  ~BlockerActivationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillProcessResponse() override;
+  const char* GetNameForLogging() override;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_ACTIVATION_THROTTLE_H_
