+// import I7, archive A11 (P10-1c): Arc's archive holds more pages than the
+// list of closed tabs, 500. The newest come in, and the rest are counted;
+// once the person has restored or forgotten what came, a later import brings
+// the rest. Every later import read the same newest 500, found each one
+// brought over already, and added nothing, however much room the list had.
+TEST_F(ArcArchiveRoomW2B09Test, ArchivedTabsPastTheListComeAtALaterImport) {
+  const size_t room =
+      static_cast<size_t>(sessions::TabRestoreServiceHelper::kMaxEntries);
+  const std::string json = ArchiveOfW2B09(room + 1);
+
+  ArcImportPlan first_plan;
+  ParseArcArchive(json, first_plan);
+  const std::u16string summary = SummariseArcImport(first_plan);
+  EXPECT_NE(std::u16string::npos, summary.find(u"500 archived tabs"))
+      << summary;
+  const ArcImportResult first =
+      ApplyArcImport(browser(), first_plan, ArcImportOptions());
+  EXPECT_EQ(room, first.archived);
+  EXPECT_EQ(1u, first.archived_left_out);
+  ASSERT_EQ(room, closed().held().size());
+
+  closed().Empty();
+  ArcImportPlan second_plan;
+  ParseArcArchive(json, second_plan);
+  const ArcImportResult second =
+      ApplyArcImport(browser(), second_plan, ArcImportOptions());
+  EXPECT_EQ(1u, second.archived) << "the page past the 500 never came";
+  EXPECT_EQ(0u, second.archived_left_out);
+  ASSERT_EQ(1u, closed().held().size());
+  const sessions::tab_restore::Entry& entry = *closed().held().front();
+  ASSERT_EQ(sessions::tab_restore::TAB, entry.type);
+  const auto& tab = static_cast<const sessions::tab_restore::Tab&>(entry);
+  ASSERT_FALSE(tab.navigations.empty());
+  EXPECT_EQ(GURL(base::StrCat(
+                {"https://p", base::NumberToString(room), ".example/"})),
+            tab.navigations[0].virtual_url())
+      << "the oldest page";
+}
+
+// windows G4, import I12 (P10-1b): Arc imported in a Blank Window, whose
+// Spaces are its own, brings nothing of Arc's sidebar into it and remembers
+// nothing in the profile, and the result line says why. A later import in a
+// window of the profile's Spaces then brings both Spaces. The Blank Window's
+// import had remembered every Arc id in the profile: the later one took each
+// Space for one the person deleted, and every tab for one already here.
+TEST_F(ArcImportWindowW2B09Test, AnImportInABlankWindowLeavesTheProfileFree) {
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(kTwoSpacesW2B09);
+  ASSERT_TRUE(plan.has_value());
+  ASSERT_EQ(2u, plan->spaces.size());
+  SpaceModel::SetNextWindowBlank();
+  std::unique_ptr<BrowserWindowInterface> blank =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  SpaceModel* const own = SpaceModel::From(blank.get());
+  ASSERT_TRUE(own);
+  ASSERT_FALSE(own->follows_registry());
+
+  const ArcImportResult in_blank =
+      ApplyArcImport(blank.get(), *plan, ArcImportOptions());
+  EXPECT_EQ(0u, in_blank.spaces);
+  EXPECT_EQ(0u, in_blank.tabs);
+  EXPECT_EQ(1u, own->size()) << "Arc's Spaces were made in the Blank Window";
+  EXPECT_TRUE(in_blank.blank_window);
+  const std::u16string line = DescribeArcImportResult(in_blank);
+  EXPECT_NE(std::u16string::npos, line.find(u"Blank Window")) << line;
+  EXPECT_TRUE(
+      profile()->GetPrefs()->GetList(stedding::prefs::kArcImportedIds).empty())
+      << "the Blank Window's import is remembered in the profile";
+  {
+    // An import of history and passwords alone asked for nothing the Blank
+    // Window leaves out, and its line does not say so.
+    ArcImportOptions data_only;
+    data_only.spaces = false;
+    data_only.pinned = false;
+    data_only.unpinned = false;
+    const ArcImportResult data = ApplyArcImport(blank.get(), *plan, data_only);
+    EXPECT_FALSE(data.blank_window);
+    const std::u16string data_line = DescribeArcImportResult(data);
+    EXPECT_EQ(std::u16string::npos, data_line.find(u"Blank Window"))
+        << data_line;
+  }
+
+  const ArcImportResult here =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(2u, here.spaces);
+  EXPECT_EQ(2u, here.tabs);
+  EXPECT_EQ(0u, here.skipped);
+  EXPECT_FALSE(here.blank_window);
+  EXPECT_TRUE(RegistryNames("Mail"));
+  EXPECT_TRUE(RegistryNames("Docs"));
+  blank->GetTabStripModel()->CloseAllTabs();
+}
+
+// import I13, I16, windows G4 (P10-1b): Turn Bookmarks into Pinned Tabs in a
+// Blank Window turns nothing and counts nothing to turn, so the command bar
+// does not offer it there; in a window of the profile's Spaces it then turns
+// every bookmark. The Blank Window's run had made pins of its own and
+// remembered the bookmarks in the profile, so no other window could turn
+// them.
+TEST_F(ArcImportWindowW2B09Test, BookmarksTurnIntoPinsOnlyWhereTheSpacesAre) {
+  std::vector<NodeW2B09> nodes;
+  int id = 0;
+  for (const char* const url : {"https://a.example/", "https://b.example/"}) {
+    NodeW2B09 node;
+    node.kind = NodeW2B09::Kind::kTab;
+    node.arc_id = "bookmark:" + base::NumberToString(++id);
+    node.url = GURL(url);
+    node.title = u"Page";
+    nodes.push_back(std::move(node));
+  }
+  SpaceModel::SetNextWindowBlank();
+  std::unique_ptr<BrowserWindowInterface> blank =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  ASSERT_TRUE(SpaceModel::From(blank.get()));
+  ASSERT_FALSE(SpaceModel::From(blank.get())->follows_registry());
+
+  EXPECT_EQ(0u, CountNodesToPin(blank.get(), nodes));
+  EXPECT_EQ(0u, ImportNodesAsPins(blank.get(), nodes).tabs);
+  EXPECT_EQ(2u, CountNodesToPin(browser(), nodes));
+  EXPECT_EQ(2u, ImportNodesAsPins(browser(), nodes).tabs)
+      << "the Blank Window's run kept these bookmarks from every other window";
+  blank->GetTabStripModel()->CloseAllTabs();
+}
