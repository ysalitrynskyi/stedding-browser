+// pins H14 (GitHub issue 41): a private window has no Space pins, so a tab
+// dragged to the top of its list takes the top as a tab, under the line:
+// only a Spaces window lets a row into an empty run.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest,
+                       APrivateWindowsTabDraggedToTheTopStaysATab) {
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+  ASSERT_TRUE(incognito);
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      incognito, GURL(url::kAboutBlankURL),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  TabStripModel* const private_tabs = incognito->GetTabStripModel();
+  ASSERT_EQ(2, private_tabs->count());
+  tabs::TabInterface* const second = private_tabs->GetTabAtIndex(1);
+  views::Widget* const private_widget =
+      BrowserView::GetBrowserViewForBrowser(incognito)->GetWidget();
+  stedding::test::KeepAboveOtherWindows(private_widget);
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(private_widget));
+  views::test::RunScheduledLayout(private_widget);
+  const TabView* const row =
+      stedding::test::FindDrawnRow(private_widget->GetRootView(), second);
+  ASSERT_TRUE(row);
+  const auto* const list =
+      views::AsViewClass<UnpinnedTabContainerView>(row->parent());
+  ASSERT_TRUE(list);
+
+  const gfx::Point from = row->GetBoundsInScreen().CenterPoint();
+  const gfx::Point to(from.x(), list->GetBoundsInScreen().y() + 2);
+  stedding::test::SendLeftMouse(private_widget, ui::EventType::kMousePressed,
+                                from);
+  constexpr int kSteps = 20;
+  for (int i = 1; i <= kSteps; ++i) {
+    stedding::test::SendLeftMouse(
+        private_widget, ui::EventType::kMouseDragged,
+        gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                   from.y() + (to.y() - from.y()) * i / kSteps));
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(private_widget));
+  }
+  EXPECT_NE(std::optional<bool>(true), list->dragged_rows_pinned())
+      << "the line was drawn under the dragged row";
+  stedding::test::SendLeftMouse(private_widget, ui::EventType::kMouseReleased,
+                                to);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(stedding::test::WaitForRowsToSettle(private_widget));
+  EXPECT_EQ(0, private_tabs->GetIndexOfTab(second)) << "not at the top";
+  EXPECT_FALSE(second->IsPinned());
+  views::test::RunScheduledLayout(private_widget);
+  const ClearTabsSeparator* const line =
+      stedding::test::FindDrawnClearLine(private_widget->GetRootView());
+  const TabView* const dropped =
+      stedding::test::FindDrawnRow(private_widget->GetRootView(), second);
+  ASSERT_TRUE(line && dropped);
+  EXPECT_LE(line->GetBoundsInScreen().bottom(),
+            dropped->GetBoundsInScreen().y())
+      << "the row is drawn over the line";
+}
