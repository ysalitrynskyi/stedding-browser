+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  // Runs `body` with $1 the id of `space`, and answers what it returns.
+  const auto on_row = [&](const spaces::SpaceId& space, std::string_view body) {
