index 0000000000000..cfc52f56a460e
--- /dev/null
+++ b/chrome/browser/ui/stedding/thanks_pages_unittest.cc
@@ -0,0 +1,95 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/thanks_pages.h"
+
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class ThanksPagesTest : public testing::Test {
+ protected:
+  ThanksPagesTest() { prefs::RegisterLocalStatePrefs(local_state_.registry()); }
+
+  bool AfterUpdate(std::string_view version,
+                   bool first_run_suppressed = false,
+                   bool welcome_pending = false) {
+    return ShouldOpenThanksAfterUpdate(local_state_, version,
+                                       first_run_suppressed, welcome_pending);
+  }
+
+  TestingPrefServiceSimple local_state_;
+};
+
+// updates Up10: a later version opens the page once, on its first launch.
+TEST_F(ThanksPagesTest, ALaterVersionOpensTheUpdatePageOnce) {
+  local_state_.SetString(prefs::kLastRunVersion, "0.2.0-beta.15");
+  EXPECT_TRUE(AfterUpdate("0.2.0-beta.16"));
+  EXPECT_EQ("0.2.0-beta.16", local_state_.GetString(prefs::kLastRunVersion));
+  EXPECT_FALSE(AfterUpdate("0.2.0-beta.16")) << "the second launch";
+  EXPECT_TRUE(AfterUpdate("0.2.0")) << "the release after its betas";
+}
+
+// updates Up10: a profile from before versions were recorded is an update;
+// the install's own first run is not (its page comes with the welcome flow).
+TEST_F(ThanksPagesTest, NoRecordedVersionIsAnUpdateUnlessWelcomeIsToCome) {
+  EXPECT_FALSE(AfterUpdate("0.2.0-beta.16", false, /*welcome_pending=*/true));
+  EXPECT_EQ("0.2.0-beta.16", local_state_.GetString(prefs::kLastRunVersion))
+      << "the install's version is recorded, so its next launch is quiet";
+  EXPECT_FALSE(AfterUpdate("0.2.0-beta.16"));
+
+  local_state_.ClearPref(prefs::kLastRunVersion);
+  EXPECT_TRUE(AfterUpdate("0.2.0-beta.16", false, /*welcome_pending=*/false));
+}
+
+// updates Up10: never for an older or unreadable version, a build with no
+// version, under --no-first-run, or with the setting off; the version that
+// ran is recorded all the same.
+TEST_F(ThanksPagesTest, TheUpdatePageStaysClosedWhenItShould) {
+  local_state_.SetString(prefs::kLastRunVersion, "0.2.0-beta.16");
+  EXPECT_FALSE(AfterUpdate("0.2.0-beta.15")) << "an older version";
+  local_state_.SetString(prefs::kLastRunVersion, "0.2.0-beta.15");
+  EXPECT_FALSE(AfterUpdate("0.2.0-rc.1")) << "not a Stedding version";
+  EXPECT_FALSE(AfterUpdate("")) << "a build with no version";
+  EXPECT_EQ("0.2.0-rc.1", local_state_.GetString(prefs::kLastRunVersion));
+
+  local_state_.SetString(prefs::kLastRunVersion, "0.2.0-beta.15");
+  EXPECT_FALSE(AfterUpdate("0.2.0-beta.16", /*first_run_suppressed=*/true));
+  EXPECT_EQ("0.2.0-beta.16", local_state_.GetString(prefs::kLastRunVersion));
+
+  local_state_.SetString(prefs::kLastRunVersion, "0.2.0-beta.15");
+  local_state_.SetBoolean(prefs::kThanksAfterUpdate, false);
+  EXPECT_FALSE(AfterUpdate("0.2.0-beta.16")) << "the setting is off";
+  EXPECT_EQ("0.2.0-beta.16", local_state_.GetString(prefs::kLastRunVersion));
+}
+
+// updates Up9: the install's page opens once, and not for a forced welcome.
+TEST_F(ThanksPagesTest, TheInstallPageOpensOnce) {
+  EXPECT_FALSE(ShouldOpenThanksAfterInstall(local_state_, "0.2.0-beta.16",
+                                            /*welcome_forced=*/true));
+  EXPECT_FALSE(ShouldOpenThanksAfterInstall(local_state_, "",
+                                            /*welcome_forced=*/false));
+  EXPECT_TRUE(ShouldOpenThanksAfterInstall(local_state_, "0.2.0-beta.16",
+                                           /*welcome_forced=*/false));
+  EXPECT_FALSE(ShouldOpenThanksAfterInstall(local_state_, "0.2.0-beta.16",
+                                            /*welcome_forced=*/false))
+      << "a second profile's welcome flow";
+}
+
+// updates Up10: the version rides in the fragment, which the browser never
+// sends.
+TEST_F(ThanksPagesTest, TheUpdatePageNamesTheVersionInItsFragment) {
+  const GURL url = ThanksAfterUpdateUrl("0.2.0-beta.16");
+  EXPECT_EQ("https://stedding.dev/thanks/updated/#v0.2.0-beta.16", url.spec());
+  EXPECT_EQ("v0.2.0-beta.16", url.ref());
+  EXPECT_FALSE(url.has_query());
+  EXPECT_EQ("https://stedding.dev/thanks/", GURL(kThanksAfterInstallUrl).spec());
+}
+
+}  // namespace
+}  // namespace stedding
