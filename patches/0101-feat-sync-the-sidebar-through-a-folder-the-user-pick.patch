+// --- Pairing at the first join (Sf10). ---
+
+LocalView SpaceWithPin(const char* space,
+                       const char* name,
+                       const char* pin,
+                       const char* home) {
+  LocalView view;
+  view.items[space] = SpaceItem(name);
+  view.items[pin] = PinItem(home, PinsListOf(space));
+  view.lists[kSpacesList] = {space};
+  view.lists[PinsListOf(space)] = {pin};
+  return view;
+}
+
+TEST(SidebarSyncPairTest, SmallerIdWinsOnBothSides) {
+  const State here = StateOf(
+      SpaceWithPin(kHome, "Work", kPinB, "https://mail.example/"), -2, kLaptop);
+  const State there = StateOf(
+      SpaceWithPin(kWork, " work ", kPinA, "https://mail.example/"), -1,
+      kOffice);
+  const std::vector<Pair> from_here = ProposePairs(here, there);
+  const std::vector<Pair> from_there = ProposePairs(there, here);
+  ASSERT_EQ(2u, from_here.size());
+  ASSERT_EQ(2u, from_there.size());
+  EXPECT_EQ(AliasesFor(from_here), AliasesFor(from_there));
+  const std::map<std::string, std::string> aliases = AliasesFor(from_here);
+  EXPECT_EQ(kWork, aliases.at(kHome));
+  EXPECT_EQ(kPinA, aliases.at(kPinB));
+}
