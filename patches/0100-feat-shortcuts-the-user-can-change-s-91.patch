+// shortcuts Z11, Z19: a change of the chords in force tells the page, and a
+// recording ends when the page goes.
+TEST_F(SteddingShortcutsHandlerTest, ChangesReachThePageAndRecordingEnds) {
+  Send("steddingGetShortcutRows", {});
+  shortcuts::UserShortcuts user;
+  user.off.insert(IDC_STEDDING_CLEAR_SPACE);
+  shortcuts::SetCurrent(user);
+  const content::TestWebUI::CallData& call = *web_ui_.call_data().back();
+  EXPECT_EQ("cr.webUIListenerCallback", call.function_name());
+  EXPECT_EQ("stedding-shortcuts-changed", *call.arg1()->GetIfString());
+
+  web_ui_.HandleReceivedMessage("steddingRecordShortcut",
+                                Args({base::Value(true)}));
+  EXPECT_TRUE(handler_->recording_for_testing());
+  web_ui_.HandleReceivedMessage("steddingRecordShortcut",
+                                Args({base::Value(false)}));
+  EXPECT_FALSE(handler_->recording_for_testing());
+  web_ui_.HandleReceivedMessage("steddingRecordShortcut",
+                                Args({base::Value(true)}));
+  handler_->DisallowJavascript();
+  EXPECT_FALSE(handler_->recording_for_testing())
+      << "a reload or a navigation away ends the recording";
+}
