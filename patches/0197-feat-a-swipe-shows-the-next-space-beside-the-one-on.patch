+
+// spaces B35 (the owner, 2026-11-24: the next Space did not show while the
+// fingers moved): the Space a swipe would bring in is drawn beside the one
+// on screen, its title and list joined a list's width away on the side it
+// comes in from, and moves with it, both at full strength. Drawing it
+// enters, shows, selects and scrolls nothing. Swiped back past where it
+// began, the Space the other way is drawn instead. Lifted short, the drawing
+// goes back out with the list and goes; lifted far enough, the Space comes in
+// from where it was drawn.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, ASwipeShowsTheNextSpaceBesideIt) {
+  if (!stedding::ShouldAnimate(browser()->GetProfile()->GetPrefs())) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces());
+  views::Widget* const window = browser_view()->GetWidget();
+  // Two has a row more than One: its drawing is as tall as its own list,
+  // not as the list on screen (the first drawing cut Two's last row off).
+  model()->SetActiveSpace(ids_[1]);
+  AppendTab();
+  model()->SetActiveSpace(ids_[0]);
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(window));
+  VerticalTabStripRegionView* const region =
+      browser_view()->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(region);
+  const TabStripView* const strip = FindTabStripView(region);
+  ASSERT_TRUE(strip);
+  views::ScrollView* const list = strip->unpinned_tabs_scroll_view();
+  views::LabelButton* const title = strip->GetSpaceTitleRow();
+  ASSERT_TRUE(list);
+  ASSERT_TRUE(title);
+  views::test::RunScheduledLayout(window);
+  ASSERT_TRUE(title->GetVisible());
+  gfx::Point at = region->GetBoundsInScreen().CenterPoint();
+  views::View::ConvertPointFromScreen(window->GetRootView(), &at);
+  const gfx::PointF point(at);
+  const auto send = [&](float dx, ui::ScrollEventPhase phase) {
+    ui::ScrollEvent scroll(ui::EventType::kScroll, point, point,
+                           ui::EventTimeForNow(), ui::EF_NONE, dx, 0, dx, 0,
+                           /*finger_count=*/2, ui::EventMomentumPhase::NONE,
+                           phase);
+    window->OnScrollEvent(&scroll);
+  };
+  // The rows the sidebar shows, in tree order.
+  const auto shown_rows = [&]() {
+    std::vector<const views::View*> rows;
+    std::vector<const views::View*> pending = {strip};
+    while (!pending.empty()) {
+      const views::View* const view = pending.back();
+      pending.pop_back();
+      if (views::IsViewClass<TabView>(view)) {
+        if (view->GetVisible()) {
+          rows.push_back(view);
+        }
+        continue;
+      }
+      for (const views::View* const child : view->children()) {
+        pending.push_back(child);
+      }
+    }
+    return rows;
+  };
+  const float width = list->width();
+  tabs::TabInterface* const active = tab_strip_model()->GetActiveTab();
+  const ui::ListSelectionModel selection =
+      tab_strip_model()->selection_model().GetListSelectionModel();
+  const std::vector<const views::View*> rows = shown_rows();
+  const std::u16string name(title->GetText());
+  const int scrolled = list->GetVisibleRect().y();
+
+  // 60 DIPs to the left: the next Space is drawn on the right, joined.
+  send(0, ui::ScrollEventPhase::kBegan);
+  send(-30, ui::ScrollEventPhase::kUpdate);
+  send(-30, ui::ScrollEventPhase::kUpdate);
+  for (const views::View* const view :
+       std::vector<const views::View*>{list, title}) {
+    SCOPED_TRACE(view == list ? "the list" : "the title");
+    ui::Layer* const drawn = SwipePreviewBeside(view);
+    ASSERT_TRUE(drawn) << "the next Space is not drawn beside this one";
+    EXPECT_FLOAT_EQ(-60.0f + width, drawn->transform().To2dTranslation().x())
+        << "it is not joined to the Space on screen";
+    EXPECT_FLOAT_EQ(1.0f, drawn->opacity());
+    EXPECT_FLOAT_EQ(1.0f, view->layer()->opacity())
+        << "the Space on screen fades";
+  }
+  EXPECT_EQ(ids_[0], model()->active_id()) << "the drawing entered the Space";
+  EXPECT_EQ(active, tab_strip_model()->GetActiveTab());
+  const ui::ListSelectionModel& now =
+      tab_strip_model()->selection_model().GetListSelectionModel();
+  EXPECT_EQ(selection.active(), now.active());
+  EXPECT_EQ(selection.selected_indices(), now.selected_indices())
+      << "the drawing changed the selection";
+  EXPECT_EQ(rows, shown_rows()) << "the drawing left other rows shown";
+  EXPECT_EQ(name, title->GetText()) << "the drawing left its name in the title";
+  EXPECT_EQ(scrolled, list->GetVisibleRect().y()) << "the drawing scrolled";
+  EXPECT_TRUE(region->layer() && region->layer()->GetMasksToBounds())
+      << "the drawing is not clipped at the sidebar's edge";
+
+  // Back past where it began, 60 DIPs to the right: the Space before is
+  // drawn on the left instead.
+  for (int i = 0; i < 6; ++i) {
+    send(20, ui::ScrollEventPhase::kUpdate);
+  }
+  for (const views::View* const view :
+       std::vector<const views::View*>{list, title}) {
+    SCOPED_TRACE(view == list ? "the list" : "the title");
+    ui::Layer* const drawn = SwipePreviewBeside(view);
+    ASSERT_TRUE(drawn) << "the Space before is not drawn";
+    EXPECT_FLOAT_EQ(60.0f - width, drawn->transform().To2dTranslation().x());
+  }
+  // Back to 50 DIPs to the left, and lifted: too short to switch. The list
+  // springs back, and the drawing goes back out to the right with it.
+  for (int i = 0; i < 11; ++i) {
+    send(-10, ui::ScrollEventPhase::kUpdate);
+  }
+  send(0, ui::ScrollEventPhase::kEnd);
+  EXPECT_EQ(ids_[0], model()->active_id());
+  if (ui::Layer* const drawn = SwipePreviewBeside(list)) {
+    EXPECT_FLOAT_EQ(width, drawn->GetTargetTransform().To2dTranslation().x())
+        << "the drawing does not go back out with the list";
+  }
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !SwipePreviewBeside(list) && !SwipePreviewBeside(title);
+  })) << "the drawing stayed after the swipe sprang back";
+  EXPECT_EQ(rows, shown_rows());
+
+  // Far enough: the next Space comes in from where it was drawn.
+  send(0, ui::ScrollEventPhase::kBegan);
+  for (int i = 0; i < 5; ++i) {
+    send(-20, ui::ScrollEventPhase::kUpdate);
+  }
+  ui::Layer* const drawn = SwipePreviewBeside(list);
+  ASSERT_TRUE(drawn);
+  const float drawn_at = drawn->transform().To2dTranslation().x();
+  const gfx::Size drawn_size = drawn->bounds().size();
+  EXPECT_GT(drawn_size.height(), list->height())
+      << "the drawing of Two is cut to One's shorter list";
+  EXPECT_NE(strip->layer(), drawn->parent())
+      << "the drawing hangs in the strip, which cuts it to One's height";
+  send(0, ui::ScrollEventPhase::kEnd);
+  ExpectShowing(ids_[1]);
+  EXPECT_EQ(drawn_size, list->size())
+      << "the list that came in is not the size it was drawn";
+  EXPECT_FALSE(SwipePreviewBeside(list))
+      << "the drawing stayed after the switch";
+  ASSERT_TRUE(list->layer());
+  EXPECT_FLOAT_EQ(drawn_at, list->layer()->transform().To2dTranslation().x())
+      << "the Space does not come in from where it was drawn";
+  EXPECT_EQ(model()->DisplayName(ids_[1]), title->GetText());
+}
