@@ -21,12 +22,53 @@ namespace {
 // `allow_active`: Sleep Tab on the row the menu was opened on -- a
 // right-click activates the row first, so the verb would otherwise never
 // apply to it; SleepTabs activates a neighbour before the discard.
+// The on-screen half of the active split is not the active tab, and it is
+// not hidden. Sleeping it drops the call or the video the user is watching.
+bool OnScreenSplitPeer(tabs::TabInterface* tab) {
+  if (!tab || !tab->IsSplit()) {
+    return false;
+  }
+  BrowserWindowInterface* const browser = tab->GetBrowserWindowInterface();
+  TabStripModel* const strip = browser ? browser->GetTabStripModel() : nullptr;
+  tabs::TabInterface* const active = strip ? strip->GetActiveTab() : nullptr;
+  if (!active || active == tab || !active->IsSplit()) {
+    return false;
+  }
+  return active->GetSplit() == tab->GetSplit();
+}
+
+// Audio, capture, picture-in-picture, a fullscreen video, a beforeunload
+// handler and a form the user has typed in are not discarded. Bluetooth and
+// USB stay on performance_manager's policy; those signals are not on the UI
+// thread.
+bool IneligibleToSleep(tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return true;
+  }
+  if (contents->IsCurrentlyAudible() || contents->IsBeingCaptured() ||
+      contents->IsBeingVisiblyCaptured() ||
+      contents->HasPictureInPictureVideo() ||
+      contents->HasPictureInPictureDocument() ||
+      contents->HasActiveEffectivelyFullscreenVideo() ||
+      contents->NeedToFireBeforeUnloadOrUnloadEvents() ||
+      OnScreenSplitPeer(tab)) {
+    return true;
+  }
+  if (FormInteractionTabHelper* const forms =
+          FormInteractionTabHelper::From(tab);
+      forms && forms->had_form_interaction()) {
+    return true;
+  }
+  return false;
+}
