+// Sf61: a route on the other computer arrives on the Space it is paired with
+// here; a route here to a Space that is not synced stays, is never written to
+// the file, and the other computer's routes do not remove it.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest,
+                       ARouteArrivesOnThePairedSpaceAndOneToAnUnsyncedOneStays) {
+  spaces::SpaceModel& model = *spaces::SpaceModel::From(browser());
+  const std::string here = model.active_id().ToString();
+  model.SetSpaceName(model.active_id(), "Work");
+  // The other computer's Space id is the smaller, so the shared id is not
+  // this computer's own (Sf10): the route still lands on this computer's
+  // Work.
+  std::string there = base::Token::CreateRandom().ToString();
+  while (there >= here) {
+    there = base::Token::CreateRandom().ToString();
+  }
+  const int64_t start = NowMs();
+  WritePeer(PeerState(there, start, "Work"), 1);
+  const base::DictValue preview = Preview();
+  const base::ListValue* const pairs = preview.FindList("pairs");
+  ASSERT_TRUE(pairs);
+  ASSERT_EQ(1u, pairs->size());
+  ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/true, "Test computer", {0},
+                                     sb::JoinParts()));
+  ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  const std::string shared = std::min(here, there);
+
+  // A route here to a Space no file knows.
+  const std::string unsynced = base::Token::CreateRandom().ToString();
+  base::ListValue mine;
+  mine.Append(Route("keep.example", unsynced));
+  prefs()->SetList(p::kSpaceRoutes, std::move(mine));
+  service()->CommitSettingsForTesting();
+
+  sb::FileParts parts;
+  base::ListValue theirs;
+  theirs.Append(Route("github.com", shared));
+  parts.settings =
+      Setting(p::kSpaceRoutes, base::Value(std::move(theirs)), start + 60'000);
+  WritePeer(PeerState(there, start, "Work"), 2, parts);
+  Scan();
+
+  const base::ListValue& routes = prefs()->GetList(p::kSpaceRoutes);
+  ASSERT_EQ(2u, routes.size());
+  EXPECT_EQ("github.com", *routes[0].GetDict().FindString("pattern"));
+  EXPECT_EQ(here, *routes[0].GetDict().FindString("space"));
+  EXPECT_EQ("keep.example", *routes[1].GetDict().FindString("pattern"));
+  EXPECT_EQ(unsynced, *routes[1].GetDict().FindString("space"));
+
+  // This computer's file carries the synced route alone, by the shared id,
+  // once it is written after the read.
+  ASSERT_TRUE(OwnFileSays(
+      p::kSpaceRoutes,
+      sb::SettingJson(base::Value(base::ListValue().Append(
+          Route("github.com", shared))))));
+  const std::optional<sb::SettingField> own = OwnSetting(p::kSpaceRoutes);
+  ASSERT_TRUE(own);
+  EXPECT_EQ(std::string::npos, own->json.find("keep.example"));
+  EXPECT_NE(std::string::npos, own->json.find(shared));
+  EXPECT_EQ(std::string::npos, own->json.find(here == shared ? there : here));
+}
