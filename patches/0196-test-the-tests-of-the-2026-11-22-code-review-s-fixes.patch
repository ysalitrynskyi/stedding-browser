+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A split's panes are on screen together, so the pane beside the active one
+// has no clock of its own while the split lasts: its clocks start when it
+// leaves the screen (docs/features/tabs.md R40, archive A2, A12).
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/test/simple_test_clock.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/archive/tab_archiver.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/pin_mirror.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/prefs/pref_service.h"
+#include "components/split_tabs/split_tab_id.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/web_contents_tester.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class TabArchiverSplitB06Test : public BrowserWithTestWindowTest {
+ public:
+  TabArchiverSplitB06Test()
+      : BrowserWithTestWindowTest(
+            base::test::TaskEnvironment::TimeSource::MOCK_TIME) {}
+
+ protected:
+  void SetUp() override {
+    // As in TabArchiverTest: the test window's tab strip is never editable,
+    // which the pin mirror reads as a tab drag that never ends. Nothing here
+    // is about pins.
+    spaces::PinMirror::SetDisabledForTesting(true);
+    BrowserWithTestWindowTest::SetUp();
+    prefs()->SetInteger(prefs::kArchiveIdleHours, 0);
+    prefs()->SetInteger(prefs::kTabsIdleSleepMinutes, 5);
+    clock_.SetNow(base::Time::Now());
+    archiver_ = std::make_unique<TabArchiver>(*browser(), *prefs());
+    archiver_->set_clock_for_testing(&clock_);
+  }
+
+  void TearDown() override {
+    archiver_.reset();
+    BrowserWithTestWindowTest::TearDown();
+    spaces::PinMirror::SetDisabledForTesting(false);
+  }
+
+  PrefService* prefs() { return profile()->GetPrefs(); }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  TabArchiver& archiver() { return *archiver_; }
+  base::SimpleTestClock* clock() { return &clock_; }
+
+  // Time passes on the archiver's wall clock only.
+  void Idle(base::TimeDelta delta) { clock_.Advance(delta); }
+
+  // A background tab at the end of the strip whose page is a test one,
+  // awake.
+  tabs::TabInterface* AppendAwakeTab(const std::string& host) {
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+    content::WebContentsTester::For(contents.get())
+        ->NavigateAndCommit(GURL("https://" + host + "/"));
+    content::WebContents* const raw = contents.get();
+    tabs().AppendTab(
+        std::make_unique<tabs::TabModel>(std::move(contents), &tabs()),
+        /*foreground=*/false);
+    return tabs().GetTabForWebContents(raw);
+  }
+
+  int Index(tabs::TabInterface* tab) { return tabs().GetIndexOfTab(tab); }
+
+  // A sleep replaces a tab's contents: ask the tab, not the old contents.
+  static bool Asleep(tabs::TabInterface* tab) {
+    return tab->GetContents()->WasDiscarded();
+  }
+
+ private:
+  base::SimpleTestClock clock_;
+  std::unique_ptr<TabArchiver> archiver_;
+};
+
+// P07-1a; tabs R40, archive A2, A12: Separate views takes the split's other
+// pane off screen with no change of the active tab. Its idle time and its
+// sleep clock start then, as a tab left does. They had kept the time it was
+// last left, so the next sleep sweep put a pane that had been on screen a
+// moment before to sleep, and the archive's sweep could close it.
+TEST_F(TabArchiverSplitB06Test, SeparateViewsStartsTheOtherPanesClocks) {
+  tabs::TabInterface* const left = AppendAwakeTab("left.example");
+  tabs::TabInterface* const right = AppendAwakeTab("right.example");
+  tabs().ActivateTabAt(Index(left));
+  const split_tabs::SplitTabId split = tabs().AddToNewSplit(
+      {Index(right)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_EQ(left->GetSplit(), right->GetSplit());
+  ASSERT_EQ(left, tabs().GetActiveTab());
+
+  // Ten minutes in the split, the focus in the left pane all along.
+  Idle(base::Minutes(10));
+  tabs().RemoveSplit(split);
+  ASSERT_FALSE(right->IsSplit());
+  ASSERT_EQ(left, tabs().GetActiveTab());
+  EXPECT_EQ(clock()->Now(), archiver().last_active_for_testing(right))
+      << "the archive counts the pane from before it left the screen";
+  EXPECT_EQ(clock()->Now(), archiver().sleep_since_for_testing(right))
+      << "the sleep counts the pane from before it left the screen";
+
+  // A minute off screen is not the five minutes the sleep waits for.
+  Idle(base::Minutes(1));
+  archiver().SleepSweep();
+  EXPECT_FALSE(Asleep(right)) << "a pane on screen a minute ago slept";
+  EXPECT_FALSE(Asleep(left));
+}
+
+}  // namespace
+}  // namespace stedding
