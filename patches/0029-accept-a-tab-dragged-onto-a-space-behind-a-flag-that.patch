+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_DRAG_TARGET_H_
+#define CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_DRAG_TARGET_H_
+
+#include <optional>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ref.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/views/tabs/dragging/tab_drag_target.h"
+
+class Browser;
+
+namespace spaces {
+
+class SpaceModel;
+class SpaceSwitcherView;
+
+// Accepts a tab dragged onto a Space icon, and moves it to that Space.
+//
+// OFF BY DEFAULT, behind stedding::kDragTabsToSpaces, because it has not been
+// verified by an actual drag -- a drag cannot be driven from a screenshot
+// harness. A wrong drop handler loses the tab it was given, which is not a
+// thing to turn on unseen. The context menu on a Space does the same job and is
+// what ships.
+class SpaceDragTarget : public TabDragTarget {
+ public:
+  SpaceDragTarget(SpaceModel& model,
+                  Browser& browser,
+                  SpaceSwitcherView& switcher);
+  SpaceDragTarget(const SpaceDragTarget&) = delete;
+  SpaceDragTarget& operator=(const SpaceDragTarget&) = delete;
+  ~SpaceDragTarget() override;
+
+  // Remembers which Space the pointer is over. Called before the drag machinery
+  // asks whether the drop can be taken.
+  void SetHoveredSpace(std::optional<SpaceId> id);
+
+  // TabDragTarget:
+  void OnTabDragEntered() override;
+  TabDragContext* OnTabDragUpdated(TabDragTarget::DragController& controller,
+                                   const gfx::Point& point_in_screen) override;
+  void OnTabDragExited(const gfx::Point& point_in_screen) override;
+  void OnTabDragEnded() override;
+  bool CanDropTab() override;
+  void HandleTabDrop(DragController& controller) override;
+  base::CallbackListSubscription RegisterWillDestroyCallback(
+      base::OnceClosure callback) override;
+
+ private:
+  const raw_ref<SpaceModel> model_;
+  const raw_ref<Browser> browser_;
+  const raw_ref<SpaceSwitcherView> switcher_;
+  std::optional<SpaceId> hovered_;
+  base::OnceClosureList will_destroy_callbacks_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_DRAG_TARGET_H_
diff --git a/chrome/browser/ui/views/spaces/space_switcher_view.cc b/chrome/browser/ui/views/spaces/space_switcher_view.cc
index 55e980e270250..94244e4cc81ab 100644
--- a/chrome/browser/ui/views/spaces/space_switcher_view.cc
+++ b/chrome/browser/ui/views/spaces/space_switcher_view.cc
@@ -284,6 +284,21 @@ bool SpaceSwitcherView::IsCommandIdEnabled(int command_id) const {
   return true;
 }
 
+std::optional<SpaceId> SpaceSwitcherView::SpaceAtScreenPoint(
+    const gfx::Point& point_in_screen) const {
+  if (!icon_row_) {
+    return std::nullopt;
+  }
+  const auto& children = icon_row_->children();
+  const auto& spaces = model_->spaces();
+  for (size_t i = 0; i < children.size() && i < spaces.size(); ++i) {
+    if (children[i]->GetBoundsInScreen().Contains(point_in_screen)) {
+      return spaces[i]->id();
+    }
+  }
+  return std::nullopt;
+}
