+void TabDragHandler::UpdateEssentialsDropFeedback() {
+  if (essentials_settling_) {
+    return;
+  }
+  auto* const strip = views::AsViewClass<TabStripView>(
+      tab_strip_region_view_->GetTabStripView());
+  PinnedTabContainerView* const grid =
+      strip ? strip->GetPinnedTabsContainer() : nullptr;
+  UnpinnedTabContainerView* const list =
+      strip ? strip->GetUnpinnedTabsContainer() : nullptr;
+  if (!strip || !grid || !list || !drag_controller_ ||
+      !last_drag_point_in_screen_ ||
+      !drag_controller_->GetSessionData().dragging_groups.empty() ||
+      !drag_controller_->GetSessionData().source_view_drag_data()) {
+    EndEssentialsDrag();
+    return;
+  }
+  const DragSessionData& session = drag_controller_->GetSessionData();
+  const bool from_essentials = session.source_view_drag_data()->pinned;
+  // The rows or cards dragged, each once: a split's two panes are one. A
+  // row in a folder or a group is dragged too, but its folder lays it out:
+  // the copy stands in only for the list's own rows and the grid's cards.
+  std::vector<views::View*> dragged;
+  for (views::View* const attached : session.attached_views()) {
+    views::View* const view = GetDraggedViewForAttachedView(attached);
+    if (view && !std::ranges::contains(dragged, view)) {
+      dragged.push_back(view);
+    }
+  }
+  const gfx::Point point = *last_drag_point_in_screen_;
+  const std::optional<gfx::Rect> zone = EssentialsDropZone(strip);
+  std::optional<int> grid_room;
+  std::optional<UnpinnedTabContainerView::RowDropPlace> row_room;
+  gfx::Rect row;
+  gfx::Rect card;
+  const int count = static_cast<int>(dragged.size());
+  if (!dragged.empty() && zone) {
+    if (!from_essentials && zone->Contains(point)) {
+      // A row over the essentials: a card under the pointer, the size of
+      // the place made for it, turning from the row where it is drawn.
+      grid_room = grid->EssentialsDropIndexAt(point, count);
+      card = grid->EssentialsPlaceBoundsInScreen(*grid_room, count);
+      card.set_origin(point -
+                      gfx::Vector2d(card.width() / 2, card.height() / 2));
+      row = dragged.front()->GetBoundsInScreen();
+    } else if (from_essentials && OnTheList(strip, point)) {
+      // An essential over the list: a row under the pointer, turning from
+      // the card where it is drawn.
+      row_room = list->RowDropPlaceAt(point);
+      if (row_room) {
+        row = list->RowBoundsInScreenAt(point.y());
+        card = dragged.front()->GetBoundsInScreen();
+      }
+    }
+  }
+  if (!grid_room && !row_room) {
+    EndEssentialsDrag();
+    return;
+  }
+
+  // The rows or cards dragged are taken out of their container, the copy
+  // standing in for them; a drag of other ones since shows those again.
+  if (!stood_in_.empty() && stood_in_were_essentials_ != from_essentials) {
+    for (const auto& tracker : stood_in_) {
+      SetStoodIn(tracker->view(), false);
+    }
+    stood_in_.clear();
+  }
+  stood_in_were_essentials_ = from_essentials;
+  essentials_count_ = count;
+  for (views::View* const view : dragged) {
+    if (view->parent() != grid && view->parent() != list) {
+      continue;
+    }
+    if (!std::ranges::any_of(stood_in_, [view](const auto& tracker) {
+          return tracker->view() == view;
+        })) {
+      stood_in_.push_back(std::make_unique<views::ViewTracker>(view));
+    }
+    SetStoodIn(view, true);
+  }
+  grid->SetEssentialsDropRoom(grid_room, count);
+  list->SetEssentialsRowRoom(row_room, count);
+  essentials_rooms_open_ = true;
+
+  EssentialsDragGhost* ghost = essentials_ghost();
+  if (ghost && ghost->finishing()) {
+    essentials_ghost_.SetView(nullptr);
+    ghost->parent()->RemoveChildViewT(ghost);
+    ghost = nullptr;
+  }
+  if (!ghost) {
+    tabs::TabInterface* const tab = FirstTabOfView(dragged.front());
+    TabUIHelper* const helper = tab ? TabUIHelper::From(tab) : nullptr;
+    const Profile* const profile = tab_strip_model_->profile();
+    ghost =
+        GhostParent(strip)->AddChildView(std::make_unique<EssentialsDragGhost>(
+            helper ? helper->GetFavicon() : ui::ImageModel(),
+            helper ? helper->GetTitle() : std::u16string(), count,
+            stedding::ShouldAnimate(profile ? profile->GetPrefs() : nullptr)));
+    essentials_ghost_.SetView(ghost);
+  }
+  ghost->Follow(RectFromScreen(ghost->parent(), row),
+                RectFromScreen(ghost->parent(), card),
+                /*as_card=*/grid_room.has_value());
+}
+
+EssentialsDragGhost* TabDragHandler::essentials_ghost() {
+  return views::AsViewClass<EssentialsDragGhost>(essentials_ghost_.view());
+}
+
+void TabDragHandler::SetStoodIn(views::View* view, bool stood_in) {
+  if (!view || view->GetProperty(kHiddenForEssentialsDrag) == stood_in) {
+    return;
+  }
+  view->SetProperty(kHiddenForEssentialsDrag, stood_in);
+  if (!view->layer()) {
+    view->SetPaintToLayer();
+    view->layer()->SetFillsBoundsOpaquely(false);
+  }
+  view->layer()->SetOpacity(stood_in ? 0.0f : 1.0f);
+  if (view->parent()) {
+    view->parent()->InvalidateLayout();
+  }
+}
+
+void TabDragHandler::EndEssentialsDrag() {
+  if (essentials_settling_) {
+    return;
+  }
+  auto* const strip = views::AsViewClass<TabStripView>(
+      tab_strip_region_view_->GetTabStripView());
+  if (EssentialsDragGhost* const ghost = essentials_ghost();
+      ghost && !ghost->finishing()) {
+    // The copy turns back into the row or card it stood in for, where that
+    // is drawn again, and fades over it.
+    views::View* const shown =
+        stood_in_.empty() ? nullptr : stood_in_.front()->view();
+    const gfx::Rect target =
+        shown ? RectFromScreen(ghost->parent(), shown->GetBoundsInScreen())
+              : ghost->shape_bounds();
+    ghost->Finish(
+        target, /*as_card=*/stood_in_were_essentials_,
+        /*settles=*/false,
+        base::BindOnce(&TabDragHandler::RemoveFinishedEssentialsGhost,
+                       weak_factory_.GetWeakPtr()));
+  }
+  for (const auto& tracker : stood_in_) {
+    SetStoodIn(tracker->view(), false);
+  }
+  stood_in_.clear();
+  if (essentials_rooms_open_ && strip) {
+    if (PinnedTabContainerView* const grid = strip->GetPinnedTabsContainer()) {
+      grid->SetEssentialsDropRoom(std::nullopt, 0);
+    }
+    if (UnpinnedTabContainerView* const list =
+            strip->GetUnpinnedTabsContainer()) {
+      list->SetEssentialsRowRoom(std::nullopt, 0);
+    }
+  }
+  essentials_rooms_open_ = false;
+}
+
+void TabDragHandler::RemoveFinishedEssentialsGhost() {
+  EssentialsDragGhost* const ghost = essentials_ghost();
+  if (ghost && ghost->finishing() && ghost->parent()) {
+    essentials_ghost_.SetView(nullptr);
+    ghost->parent()->RemoveChildViewT(ghost);
+  }
+}
+
+void TabDragHandler::OnEssentialsDropSettled() {
+  essentials_settling_ = false;
+  // What the copy stood in for left with the drop, as a row or card the
+  // other container drew anew; one the drop did not move is shown again.
+  for (const auto& tracker : stood_in_) {
+    views::View* const view = tracker->view();
+    const tabs::TabInterface* const tab = view ? FirstTabOfView(view) : nullptr;
+    if (view && (!tab || tab->IsPinned() == stood_in_were_essentials_)) {
+      SetStoodIn(view, false);
+    }
+  }
+  stood_in_.clear();
+  auto* const strip = views::AsViewClass<TabStripView>(
+      tab_strip_region_view_->GetTabStripView());
+  if (essentials_rooms_open_ && strip) {
+    if (PinnedTabContainerView* const grid = strip->GetPinnedTabsContainer()) {
+      grid->SetEssentialsDropRoom(std::nullopt, 0);
+    }
+    if (UnpinnedTabContainerView* const list =
+            strip->GetUnpinnedTabsContainer()) {
+      list->SetEssentialsRowRoom(std::nullopt, 0);
+    }
+  }
+  essentials_rooms_open_ = false;
+}
