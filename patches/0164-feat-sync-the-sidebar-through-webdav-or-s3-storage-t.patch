+// Sf47, Sf48: over the real network stack, each failing step is named, the
+// place is left as it was found, and sync stays off.
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceTest, EachFailingStepIsNamed) {
+  struct Step {
+    const char* failure;
+    bool FakePlace::Knobs::*knob;
+  };
+  const Step kSteps[] = {
+      {"webPage", &FakePlace::Knobs::web_page},
+      {"noSuchPlace", &FakePlace::Knobs::no_root},
+      {"noList", &FakePlace::Knobs::deny_list},
+      {"noRead", &FakePlace::Knobs::deny_read},
+      {"noWrite", &FakePlace::Knobs::deny_write},
+      {"noDelete", &FakePlace::Knobs::deny_delete},
+      {"mismatch", &FakePlace::Knobs::corrupt_read},
+      {"noList", &FakePlace::Knobs::hide_files},
+      {"public", &FakePlace::Knobs::public_list},
+      {"public", &FakePlace::Knobs::public_read},
+  };
+  for (const Step& step : kSteps) {
+    SCOPED_TRACE(step.failure);
+    FakePlace::Knobs knobs;
+    knobs.*step.knob = true;
+    place_->SetKnobs(knobs);
+    EXPECT_EQ(Failure(Test()), step.failure);
+    EXPECT_FALSE(service()->enabled());
+    // A probe stays only where the server would not delete it.
+    if (std::string_view(step.failure) != "noDelete") {
+      EXPECT_TRUE(place_->Files().empty());
+    } else {
+      for (const auto& [name, body] : place_->Files()) {
+        place_->RemoveFile(name);
+      }
+    }
+  }
+  place_->SetKnobs(FakePlace::Knobs());
+  EXPECT_EQ(Failure(Test("wrong")), "signIn");
+  EXPECT_FALSE(service()->enabled());
+}
