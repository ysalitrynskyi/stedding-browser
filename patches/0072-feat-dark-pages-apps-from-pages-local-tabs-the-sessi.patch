+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_ISOLATION_MARK_H_
+#define CHROME_BROWSER_UI_SPACES_ISOLATION_MARK_H_
+
+#include <string>
+#include <string_view>
+
+namespace gfx {
+struct VectorIcon;
+}  // namespace gfx
+
+// sessions S32 (ADR 0019): how a Space with an Independent session is marked,
+// in a glyph and in words, wherever a Space is shown. Pure, with no model and
+// no view behind it, so the tab strip's menu, the toasts and the views draw
+// the same mark without a cycle; whether a Space wears it is
+// IsolationMarkForSpace's to say (space_storage_partition.h).
+namespace spaces {
+
+// The glyph: a cookie, because that is what the Space keeps apart from the
+// others, and the glyph Chromium's own site-data rows wear. A lock, the
+// obvious glyph, reads as security, and a Space with its own session is
+// separate, not safer.
+const gfx::VectorIcon& IsolationMarkIcon();
+
+// The mark's name, where words alone follow a Space's name: a menu row's
+// trailing text.
+std::u16string IsolationMarkName();
+
+// `name`, a Space's, followed by the mark's name: the name floating over a
+// chip, the Mac's menu rows, the routed toast.
+std::u16string NameWithIsolationMark(const std::u16string& name);
+
+// What the mark means: the tooltip and the accessible description of what
+// carries it.
+std::u16string IsolationMarkDescription();
+
+// sessions S34: essentials are in every Space and stay in the shared session
+// (S8), beside a Space whose own session the mark announces. The title row
+// of such a Space says so after the description.
+std::u16string IsolationMarkEssentialsNote();
+
+// A name someone else may have chosen -- a Space's, which sidebar sync and
+// another computer can write, or a site's app name -- as it goes inside a
+// sentence of a question: line breaks and other controls become spaces, and
+// the characters that override or embed the text's direction go, so the
+// name can neither start a sentence of its own nor turn the words after it
+// around. Runs of white space are one space, with none at either end.
+std::u16string NameInSentence(std::u16string_view name);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_ISOLATION_MARK_H_
