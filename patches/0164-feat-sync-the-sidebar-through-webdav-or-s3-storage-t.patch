+
+void SteddingSpacesHandler::HandleCheckSyncSignIn(
+    const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2U);
+  const base::DictValue& fields = args[1].GetDict();
+  const std::string* const kind = fields.FindString("kind");
+  const spaces::sidebar_sync::PlaceForm form =
+      spaces::sidebar_sync::CheckSignInForm(
+          kind && *kind == "s3" ? spaces::sidebar_sync::PlaceKind::kS3
+                                : spaces::sidebar_sync::PlaceKind::kWebDav,
+          fields);
+  ResolveJavascriptCallback(args[0],
+                            FormAnswer(form, form.sign_in.has_value()));
+}
+
+void SteddingSpacesHandler::HandleTestSyncPlace(const base::ListValue& args) {
+  AllowJavascript();
+  CHECK_EQ(args.size(), 2U);
+  std::string callback = args[0].GetString();
+  spaces::SidebarSyncService* const sync = SyncService();
+  if (!sync) {
+    base::DictValue answer;
+    answer.Set("failure", "form");
+    OnSyncPlaceAnswer(std::move(callback), std::move(answer));
+    return;
+  }
+  sync->TestPlace(args[1].GetDict(),
+                  base::BindOnce(&SteddingSpacesHandler::OnSyncPlaceAnswer,
+                                 weak_factory_.GetWeakPtr(),
+                                 std::move(callback)));
+}
+
+void SteddingSpacesHandler::HandleChangeSyncSignIn(
