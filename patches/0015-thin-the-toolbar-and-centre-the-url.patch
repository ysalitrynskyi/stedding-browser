diff --git a/chrome/browser/ui/stedding_ui_metrics.h b/chrome/browser/ui/stedding_ui_metrics.h
index 87e7e3ada377f..d03dfccfb54e8 100644
--- a/chrome/browser/ui/stedding_ui_metrics.h
+++ b/chrome/browser/ui/stedding_ui_metrics.h
@@ -36,6 +36,24 @@ BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabCornerRadius);
 // Height of a pinned tab tile in the sidebar's essentials row, in DIPs.
 BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabPinnedHeight);
 
+// Height of the location bar, in DIPs. With the toolbar margin below, this
+// sets how tall the toolbar strip is: Chromium's 34 plus 6 above and below
+// gives 46, and the reference is thinner than that.
+BASE_DECLARE_FEATURE_PARAM(int, kLocationBarHeight);
+
+// Space above and below the toolbar's contents, in DIPs.
+BASE_DECLARE_FEATURE_PARAM(int, kToolbarVerticalMargin);
+
+// Height of a toolbar button, in DIPs. This, not the location bar, is what
+// actually sets the toolbar's floor -- the strip is as tall as its tallest
+// child, and the back button is that child.
+BASE_DECLARE_FEATURE_PARAM(int, kToolbarButtonHeight);
+
+// Width of the location bar, in DIPs. Chromium lets the bar fill the toolbar,
+// which is why it cannot be centred: there is no leftover width for spacers to
+// take. Capping its preferred width is what makes centring possible.
+BASE_DECLARE_FEATURE_PARAM(int, kLocationBarWidth);
+
 // Tabs to pin when a window opens, counted from the left. Zero in normal use;
 // this exists so the essentials row can be screenshotted, since pinning is
 // otherwise a UI gesture.
diff --git a/chrome/browser/ui/views/toolbar/toolbar_view.cc b/chrome/browser/ui/views/toolbar/toolbar_view.cc
index ec09e6aae6023..2a806f32ea515 100644
--- a/chrome/browser/ui/views/toolbar/toolbar_view.cc
+++ b/chrome/browser/ui/views/toolbar/toolbar_view.cc
@@ -57,6 +57,7 @@
 #include "chrome/browser/ui/global_error/global_error_service_factory.h"
 #include "chrome/browser/ui/intent_picker_tab_helper.h"
 #include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/stedding_ui_metrics.h"
 #include "chrome/browser/ui/omnibox/omnibox_view.h"
 #include "chrome/browser/ui/page_action/page_action_properties_provider.h"
 #include "chrome/browser/ui/tabs/public/tab_features.h"
@@ -1547,6 +1548,45 @@ void ToolbarView::InitLayout() {
                                     location_bar_flex_rule);
     location_bar_view_->SetProperty(views::kMarginsKey,
                                     gfx::Insets::VH(0, location_bar_margin));
+
+    // Stedding centres the location bar rather than letting it fill the row;
+    // see docs/UI-SPEC.md. Two empty views either side take a share of the
+    // leftover width, so the bar sits between the button clusters instead of
+    // being pushed against the leading one. They flex at the same order as the
+    // location bar, so all three grow together and the bar keeps a third of
+    // whatever space is going rather than being pinned to its minimum.
+    if (base::FeatureList::IsEnabled(stedding::kArcStyleWindow)) {
+      // Cap the bar's width with a flex rule of its own. Left to itself it
+      // prefers the whole toolbar, so there is no leftover for the spacers to
+      // take and nothing to centre it in. SetPreferredSize() does not do this:
+      // FlexLayout asks for the preferred size that fits given bounds, which
+      // goes to LocationBarView's own calculation and ignores a stored value.
+      // Below the cap the rule defers to what the bar asks for, so a narrow
+      // window still shrinks it.
+      location_bar_view_->SetProperty(
+          views::kFlexBehaviorKey,
+          views::FlexSpecification(
+              base::BindRepeating(
+                  [](const views::View* view, const views::SizeBounds& bounds) {
+                    gfx::Size size = view->GetPreferredSize(bounds);
+                    size.set_width(std::min(
+                        size.width(), stedding::kLocationBarWidth.Get()));
+                    return size;
+                  }))
+              .WithOrder(location_bar_flex_order));
+
+      const views::FlexSpecification spacer_rule =
+          views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                                   views::MaximumFlexSizeRule::kUnbounded)
+              .WithOrder(location_bar_flex_order);
+      const size_t location_bar_index =
+          GetIndexOf(location_bar_view_.get()).value();
+      AddChildViewAt(std::make_unique<views::View>(), location_bar_index)
+          ->SetProperty(views::kFlexBehaviorKey, spacer_rule);
+      // The location bar has shifted along by one.
+      AddChildViewAt(std::make_unique<views::View>(), location_bar_index + 2)
+          ->SetProperty(views::kFlexBehaviorKey, spacer_rule);
+    }
   }
 
