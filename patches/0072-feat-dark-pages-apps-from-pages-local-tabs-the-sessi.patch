+namespace web_app {
+
+void RecordAppJarOfPage(content::WebContents& contents,
+                        const webapps::AppId& app_id) {
+  content::SiteInstance* const site = contents.GetSiteInstance();
+  Profile* const profile =
+      Profile::FromBrowserContext(contents.GetBrowserContext());
+  if (!site || !profile) {
+    return;
+  }
+  const content::StoragePartitionConfig& partition =
+      site->GetSecurityPrincipal().GetStoragePartitionConfig();
+  stedding::RecordAppJarForPartition(*profile->GetPrefs(), app_id,
+                                     partition.partition_domain(),
+                                     partition.partition_name());
+}
+
+}  // namespace web_app
