+    const content::StoragePartitionConfig config =
+        spaces::StoragePartitionConfigForWebContents(tab->GetContents());
+    EXPECT_TRUE(spaces::IsSpaceStoragePartition(config));
+    content::StoragePartition* const partition =
+        browser()->GetProfile()->GetStoragePartition(config,
+                                                     /*can_create=*/false);
+    EXPECT_TRUE(partition);
+    return partition ? partition->GetPath() : base::FilePath();
+  };
+
+  // Mail keeps its jar, a cookie in it, and has no tab open at the quit.
+  const SpaceId mail = m->AddSpace("Mail", SK_ColorGREEN)->id();
+  m->SetSpaceIsolated(mail, true);
+  ASSERT_TRUE(m->SetActiveSpace(mail));
+  tabs::TabInterface* const mail_page = Open("mail.test");
+  ASSERT_TRUE(content::NavigateToURL(
+      mail_page->GetContents(),
+      embedded_test_server()->GetURL("mail.test",
+                                     "/set-cookie?jar=mail;max-age=86400")));
+  const base::FilePath kept = jar_of(mail_page);
+  ASSERT_FALSE(kept.empty());
+
+  // Work is deleted.
+  const SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+  m->SetSpaceIsolated(work, true);
+  ASSERT_TRUE(m->SetActiveSpace(work));
+  tabs::TabInterface* const page = Open("jar.test");
+  ASSERT_TRUE(content::ExecJs(page->GetContents(),
+                              "document.cookie = 'k=v; max-age=86400'"));
+  const base::FilePath deleted = jar_of(page);
+  ASSERT_FALSE(deleted.empty());
+  ASSERT_NE(kept, deleted);
+  ASSERT_TRUE(m->SetActiveSpace(home));
+  tabs()->CloseWebContentsAt(Index(mail_page), TabCloseTypes::CLOSE_NONE);
+
+  base::RunLoop wiped;
+  ASSERT_TRUE(m->RemoveSpace(work, wiped.QuitClosure()));
+  wiped.Run();
+  // Where the jars are, for the next run: Work and its name are gone.
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  const base::FilePath profile = browser()->GetProfile()->GetPath();
+  ASSERT_TRUE(base::WriteFile(profile.AppendASCII("stedding_deleted_jar"),
+                              deleted.AsUTF8Unsafe()));
+  ASSERT_TRUE(base::WriteFile(profile.AppendASCII("stedding_kept_jar"),
+                              kept.AsUTF8Unsafe()));
+}
