@@ -0,0 +1,166 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/stedding_folder_session.h"
+
+#include <memory>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/sessions/stedding_session_rebuild.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/serialized_navigation_entry_test_helper.h"
+#include "components/sessions/core/session_command.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/sessions/core/session_types.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class FolderSessionTest : public BrowserWithTestWindowTest {};
+
+// Fixture-only twin: folders + nesting in a full test browser window, no
+// service involved. Separates a folder-teardown crash from a service one.
+TEST_F(FolderSessionTest, FoldersSurviveBrowserFixtureTeardown) {
+  for (int i = 0; i < 3; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+  }
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  tabs::FolderTabCollection* const folder = tabs->AddToNewFolder({0, 1});
+  ASSERT_NE(nullptr, folder);
+  tabs->AddToNewFolder({tabs->GetIndexOfTab(tabs->GetTabAtIndex(1))}, folder);
+  EXPECT_EQ(3, tabs->count());
+}
+
+
+// Replays what the session rebuild writes for the window and returns the
+// window as restore would see it (the Spaces twin of this helper lives in
+// session_rebuild_unittest.cc).
+std::unique_ptr<sessions::SessionWindow> RebuildAndRestore(Browser* browser) {
+  TabStripModel* const tabs = browser->tab_strip_model();
+  std::vector<std::unique_ptr<sessions::SessionCommand>> commands;
+  const SessionID window_id = browser->GetSessionID();
+  commands.push_back(sessions::CreateSetWindowTypeCommand(
+      window_id, sessions::SessionWindow::TYPE_NORMAL));
+  for (int i = 0; i < tabs->count(); ++i) {
+    const SessionID tab_id =
+        sessions::SessionTabHelper::IdForTab(tabs->GetTabAtIndex(i)->GetContents());
+    commands.push_back(sessions::CreateSetTabWindowCommand(window_id, tab_id));
+    commands.push_back(sessions::CreateSetTabIndexInWindowCommand(tab_id, i));
+    commands.push_back(sessions::CreateUpdateTabNavigationCommand(
+        tab_id,
+        sessions::SerializedNavigationEntryTestHelper::CreateNavigationForTest()));
+  }
+  commands.push_back(sessions::CreateSetSelectedTabInWindowCommand(window_id, 0));
+  for (auto& command : stedding::CollectSessionRebuildCommands(browser)) {
+    commands.push_back(std::move(command));
+  }
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active = SessionID::InvalidValue();
+  std::string platform_session_id;
+  std::set<SessionID> discarded;
+  sessions::RestoreSessionFromCommands(commands, &windows, &active,
+                                       &platform_session_id, &discarded);
+  CHECK_EQ(1u, windows.size());
+  return std::move(windows[0]);
+}
+
+// F5: a tab's folder path comes back through a rebuild.
+TEST_F(FolderSessionTest, RebuildReemitsFolderPaths) {
+  for (int i = 0; i < 3; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+  }
+  TabStripModel& tabs = *browser()->tab_strip_model();
+  tabs::FolderTabCollection* const folder = tabs.AddToNewFolder({0, 1});
+  ASSERT_NE(nullptr, folder);
+  folder->SetTitle("Reading");
+  tabs::TabInterface* const inside = tabs.GetTabAtIndex(0);
+  tabs::TabInterface* const outside = tabs.GetTabAtIndex(2);
+  ASSERT_FALSE(FolderPathForTab(inside).empty());
+  ASSERT_TRUE(FolderPathForTab(outside).empty());
+
+  const std::unique_ptr<sessions::SessionWindow> window =
+      RebuildAndRestore(browser());
+  int with_path = 0;
+  for (const auto& tab : window->tabs) {
+    const auto it = tab->extra_data.find(kSessionTabFolderPathKey);
+    const std::string path = it == tab->extra_data.end() ? "" : it->second;
+    if (tab->tab_id ==
+        sessions::SessionTabHelper::IdForTab(outside->GetContents())) {
+      EXPECT_TRUE(path.empty()) << "a free tab must carry no folder path";
+    } else if (!path.empty()) {
+      ++with_path;
+      EXPECT_NE(std::string::npos, path.find("Reading"));
+    }
+  }
+  EXPECT_EQ(2, with_path);
+}
+
+// The restore half: paths parked on tabs, exactly as session restore parks
+// them, come back as the same folder tree -- nesting included.
+TEST_F(FolderSessionTest, RebuildsNestedFoldersFromParkedPaths) {
+  for (int i = 0; i < 4; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+  }
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  ASSERT_EQ(4, tabs->count());
+
+  // Tabs 0 and 1 in folder A ("Work"); tab 1 additionally in nested folder B
+  // ("Deep", collapsed). Tabs 2 and 3 free.
+  const std::string outer =
+      R"([{"i":"aaaa","t":"Work","c":false}])";
+  const std::string nested =
+      R"([{"i":"aaaa","t":"Work","c":false},{"i":"bbbb","t":"Deep","c":true}])";
+  spaces::FolderRestorePath::CreateForWebContents(
+      tabs->GetTabAtIndex(0)->GetContents(), outer);
+  spaces::FolderRestorePath::CreateForWebContents(
+      tabs->GetTabAtIndex(1)->GetContents(), nested);
+
+  FolderSessionService service(*browser());
+  service.RebuildFromRestoredTabs();
+
+  EXPECT_EQ(4, tabs->count()) << "rebuilding folders must not lose tabs";
+
+  const tabs::TabCollection* const parent0 =
+      tabs->GetTabAtIndex(tabs->GetIndexOfTab(tabs->GetTabAtIndex(0)))
+          ->GetParentCollection();
+  // Resolve by walking: find the two foldered tabs by parent type.
+  int in_folders = 0;
+  const tabs::FolderTabCollection* outer_folder = nullptr;
+  const tabs::FolderTabCollection* nested_folder = nullptr;
+  for (int i = 0; i < tabs->count(); ++i) {
+    const tabs::TabCollection* c =
+        tabs->GetTabAtIndex(i)->GetParentCollection();
+    if (c && c->type() == tabs::TabCollection::Type::FOLDER) {
+      ++in_folders;
+      const auto* const folder =
+          static_cast<const tabs::FolderTabCollection*>(c);
+      if (folder->title() == "Work") {
+        outer_folder = folder;
+      } else if (folder->title() == "Deep") {
+        nested_folder = folder;
+      }
+    }
+  }
+  EXPECT_EQ(2, in_folders);
+  ASSERT_NE(nullptr, outer_folder);
+  ASSERT_NE(nullptr, nested_folder);
+  EXPECT_TRUE(nested_folder->collapsed());
+  EXPECT_EQ(outer_folder, nested_folder->GetParentCollection())
+      << "the nested folder must sit inside the outer one";
+  EXPECT_EQ(2u, outer_folder->TabCountRecursive());
+  std::ignore = parent0;
+}
+
+}  // namespace
+}  // namespace stedding
