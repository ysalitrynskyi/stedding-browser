+
+namespace {
+
+// The pages: one dark, one light, each one colour from its top edge down.
+constexpr SkColor kDarkPage = SkColorSetRGB(0x14, 0x21, 0x3d);
+constexpr SkColor kLightPage = SkColorSetRGB(0xfa, 0xf6, 0xe8);
+
+std::unique_ptr<net::test_server::HttpResponse> ServePage(
+    const net::test_server::HttpRequest& request) {
+  const std::string path(request.GetURL().path());
+  if (path != "/dark" && path != "/light") {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_content_type("text/html");
+  response->set_content(base::StrCat(
+      {"<!doctype html><title>Page</title><body style=\"margin:0;background:",
+       path == "/dark" ? "#14213d" : "#faf6e8",
+       "\"><p style=\"padding:40px\">A page from another app.</p></body>"}));
+  return response;
+}
+
+// A point of the row and what it is, for a failure message.
+struct Spot {
+  std::string what;
+  gfx::Point point;
+};
+
+class LittleWindowRowTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&ServePage));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    little_ = stedding::OpenLittleWindow(
+        browser()->GetProfile(), embedded_test_server()->GetURL("/light"),
+        /*anchor=*/nullptr, /*untrusted_launch=*/false);
+    ASSERT_TRUE(little_);
+    ASSERT_TRUE(content::WaitForLoadStop(page()));
+    // Smaller than the screen and in its work area, so it can zoom.
+    const gfx::Rect area =
+        display::Screen::Get()->GetPrimaryDisplay().work_area();
+    widget()->SetBounds(gfx::Rect(area.x() + 60, area.y() + 60, 900, 600));
+    stedding::test::KeepAboveOtherWindows(widget());
+    views::test::RunScheduledLayout(widget());
+    original_frame_ = window().frame;
+  }
+
+  void TearDownOnMainThread() override {
+    SetDoubleClickAction(nil);
+    little_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  BrowserView* view() { return BrowserView::GetBrowserViewForBrowser(little_); }
+  views::Widget* widget() { return view()->GetWidget(); }
+  NSWindow* window() { return widget()->GetNativeWindow().GetNativeNSWindow(); }
+  content::WebContents* page() {
+    return little_->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  static gfx::Rect InWidget(const views::View* view) {
+    return view->ConvertRectToWidget(view->GetLocalBounds());
+  }
+
+  void SetDoubleClickAction(NSString* action) {
+    NSUserDefaults* const defaults = [NSUserDefaults standardUserDefaults];
+    if (action) {
+      [defaults setObject:action forKey:@"AppleActionOnDoubleClick"];
+    } else {
+      [defaults removeObjectForKey:@"AppleActionOnDoubleClick"];
+    }
+  }
+
+  // The traffic lights in widget coordinates.
+  std::vector<gfx::Rect> Lights() {
+    std::vector<gfx::Rect> lights;
+    NSView* const content = window().contentView;
+    for (NSWindowButton kind :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      NSButton* const button = [window() standardWindowButton:kind];
+      if (!button || button.hidden) {
+        continue;
+      }
+      const NSRect frame = [button convertRect:button.bounds toView:nil];
+      lights.emplace_back(NSMinX(frame),
+                          NSHeight(content.frame) - NSMaxY(frame),
+                          NSWidth(frame), NSHeight(frame));
+    }
+    return lights;
+  }
+
+  // Every drawn button of the row, a DIP wider all round.
+  static void CollectButtons(const views::View* root,
+                             std::vector<gfx::Rect>* out) {
+    for (const views::View* child : root->children()) {
+      if (!child->GetVisible() || child->bounds().IsEmpty()) {
+        continue;
+      }
+      if (views::IsViewClass<views::Button>(child)) {
+        gfx::Rect rect = InWidget(child);
+        rect.Outset(1);
+        out->push_back(rect);
+        continue;
+      }
+      CollectButtons(child, out);
+    }
+  }
+
+  static bool InAny(const std::vector<gfx::Rect>& rects,
+                    const gfx::Point& point) {
+    return std::ranges::any_of(
+        rects, [&](const gfx::Rect& rect) { return rect.Contains(point); });
+  }
+
+  // The row's empty parts, along its middle: around the lights and between
+  // its buttons. The field is whole, its empty start too (toolbar T34).
+  std::vector<Spot> EmptyRow() {
+    views::test::RunScheduledLayout(widget());
+    std::vector<Spot> spots;
+    ToolbarView* const toolbar = view()->toolbar();
+    const gfx::Rect row = InWidget(toolbar);
+    std::vector<gfx::Rect> taken = Lights();
+    for (gfx::Rect& light : taken) {
+      light.Outset(1);
+    }
+    CollectButtons(toolbar, &taken);
+    const gfx::Rect field = InWidget(view()->GetLocationBarView());
+    const int middle = row.CenterPoint().y();
+    // Clear of the window's edge, where a press resizes the window.
+    for (int x = 6; x < row.x(); x += 3) {
+      const gfx::Point point(x, middle);
+      if (!InAny(taken, point)) {
+        spots.push_back({"around the traffic lights", point});
+      }
+    }
+    for (int x = row.x() + 1; x < row.right() - 1; x += 3) {
+      const gfx::Point point(x, middle);
+      if (InAny(taken, point)) {
+        continue;
+      }
+      if (field.Contains(point)) {
+        continue;
+      }
+      spots.push_back({"the row between its buttons", point});
+    }
+    return spots;
+  }
+
+  std::vector<std::string> NotCaption(const std::vector<Spot>& spots) {
+    std::vector<std::string> wrong;
+    for (const Spot& spot : spots) {
+      const int component = widget()->GetNonClientComponent(spot.point);
+      if (component != HTCAPTION) {
+        wrong.push_back(base::StrCat({spot.what, " at ", spot.point.ToString(),
+                                      ": ", base::NumberToString(component)}));
+      }
+    }
+    return wrong;
+  }
+
+  void DoubleClick(const gfx::Point& point) {
+    const NSPoint at = NSMakePoint(
+        point.x(), NSHeight(window().contentView.frame) - point.y());
+    for (const int count : {1, 2}) {
+      [window() sendEvent:cocoa_test_event_utils::MouseEventAtPointInWindow(
+                              at, NSEventTypeLeftMouseDown, window(), count)];
+      [window() sendEvent:cocoa_test_event_utils::MouseEventAtPointInWindow(
+                              at, NSEventTypeLeftMouseUp, window(), count)];
+    }
+  }
+
+  [[nodiscard]] bool Restore() {
+    if (window().zoomed) {
+      [window() performZoom:nil];
+    }
+    [window() setFrame:original_frame_ display:YES];
+    return base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(widget());
+      return !window().zoomed && NSEqualRects(window().frame, original_frame_);
+    });
+  }
+
+  // Waits for the row to take `colour`, the page's, as the page paints it
+  // (a channel's step either way for the colour space).
+  [[nodiscard]] bool RowColourIs(SkColor colour) {
+    const stedding::PageThemeColorController* const pages =
+        stedding::PageThemeColorController::From(little_);
+    const auto near = [](SkColor a, SkColor b) {
+      return std::abs(static_cast<int>(SkColorGetR(a)) -
+                      static_cast<int>(SkColorGetR(b))) <= 2 &&
+             std::abs(static_cast<int>(SkColorGetG(a)) -
+                      static_cast<int>(SkColorGetG(b))) <= 2 &&
+             std::abs(static_cast<int>(SkColorGetB(a)) -
+                      static_cast<int>(SkColorGetB(b))) <= 2;
+    };
+    return pages && base::test::RunUntil([&] {
+             return pages->color() && near(*pages->color(), colour);
+           });
+  }
+
+  // The system's appearance, as macOS would report it.
+  ui::MockOsSettingsProvider os_settings_;
+  raw_ptr<BrowserWindowInterface, DanglingUntriaged> little_ = nullptr;
+  NSRect original_frame_;
+};
+
+// E8: no title bar strip: the page's window runs under a transparent title
+// bar that shows no title, as the main window's does; an ordinary popup keeps
+// macOS's title bar.
+IN_PROC_BROWSER_TEST_F(LittleWindowRowTest, TheWindowHasNoTitleBarOfItsOwn) {
+  EXPECT_TRUE(window().styleMask & NSWindowStyleMaskFullSizeContentView);
+  EXPECT_TRUE(window().titlebarAppearsTransparent);
+  EXPECT_EQ(NSWindowTitleHidden, window().titleVisibility);
+  EXPECT_EQ(0, InWidget(view()->toolbar()).y()) << "the row is the top";
+
+  BrowserWindowInterface* const popup =
+      CreateBrowserForPopup(browser()->GetProfile());
+  NSWindow* const popup_window =
+      popup->GetWindow()->GetNativeWindow().GetNativeNSWindow();
+  EXPECT_FALSE(popup_window.styleMask & NSWindowStyleMaskFullSizeContentView)
+      << "an ordinary popup keeps its title bar";
+  CloseBrowserSynchronously(popup);
+}
+
+// E8: the traffic lights sit inline at the row's left, centred on it, before
+// Back, Forward and Reload; the field is the main window's, and the button
+// is at the row's right end.
+IN_PROC_BROWSER_TEST_F(LittleWindowRowTest, TheLightsSitInTheRow) {
+  ToolbarView* const toolbar = view()->toolbar();
+  const gfx::Rect row = InWidget(toolbar);
+  ASSERT_FALSE(row.IsEmpty());
+  const std::vector<gfx::Rect> lights = Lights();
+  ASSERT_EQ(3u, lights.size());
+  for (const gfx::Rect& light : lights) {
+    SCOPED_TRACE(light.ToString());
+    EXPECT_LE(light.right(), row.x()) << "before the row's contents";
+    EXPECT_GE(light.y(), 0);
+    EXPECT_LE(light.bottom(), row.bottom()) << "inside the row";
+    EXPECT_NEAR(row.CenterPoint().y(), light.CenterPoint().y(), 2)
+        << "centred on the row";
+  }
+
+  views::View* const back = toolbar->GetViewByID(VIEW_ID_BACK_BUTTON);
+  ASSERT_TRUE(back);
+  EXPECT_TRUE(back->GetVisible());
+  EXPECT_GE(InWidget(back).x(), lights.back().right());
+  EXPECT_TRUE(toolbar->reload_button());
+
+  LocationBarView* const bar = view()->GetLocationBarView();
+  ASSERT_TRUE(bar);
+  EXPECT_FALSE(bar->omnibox_view()->GetReadOnly())
+      << "the main window's field, not a popup's read-only one";
+
+  stedding::LittlePromoteButton* promote = nullptr;
+  for (views::View* const child : toolbar->children()) {
+    if (auto* const found =
+            views::AsViewClass<stedding::LittlePromoteButton>(child)) {
+      promote = found;
+    }
+  }
+  ASSERT_TRUE(promote);
+  EXPECT_TRUE(promote->GetVisible());
+  EXPECT_LE(row.right() - InWidget(promote).right(), 16)
+      << "at the row's right end";
+}
+
+// E8: the row takes the page's colour, from the window's left edge -- under
+// the traffic lights -- to its right, square, the page edge to edge below;
+// its icons take the colour that reads on it, dark or light.
+IN_PROC_BROWSER_TEST_F(LittleWindowRowTest, TheRowTakesThePagesColour) {
+  ASSERT_TRUE(RowColourIs(kLightPage));
+  const gfx::RectF surface = stedding::PageBarSurface(view());
+  const gfx::Rect row = InWidget(view()->toolbar());
+  EXPECT_EQ(0.f, surface.x()) << "under the lights too";
+  EXPECT_EQ(0.f, surface.y());
+  EXPECT_EQ(static_cast<float>(widget()->GetRootView()->width()),
+            surface.right());
+  EXPECT_GE(surface.bottom(), static_cast<float>(row.bottom()));
+  EXPECT_EQ(0, InWidget(view()->contents_container()).x())
+      << "the page edge to edge";
+  const ui::ColorProvider* provider = view()->toolbar()->GetColorProvider();
+  ASSERT_TRUE(provider);
+  EXPECT_TRUE(color_utils::IsDark(provider->GetColor(kColorToolbarButtonIcon)))
+      << "dark icons on a light page";
+
+  ASSERT_TRUE(
+      content::NavigateToURL(page(), embedded_test_server()->GetURL("/dark")));
+  ASSERT_TRUE(RowColourIs(kDarkPage));
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    const ui::ColorProvider* const now = view()->toolbar()->GetColorProvider();
+    return now && !color_utils::IsDark(now->GetColor(kColorToolbarButtonIcon));
+  })) << "light icons on a dark page";
+}
+
+// E8: every empty part of the row is the window's title bar -- around the
+// lights and between the buttons -- and its buttons, the field and the page
+// are not; a double click on each kind zooms the window.
+IN_PROC_BROWSER_TEST_F(LittleWindowRowTest, TheRowIsTheTitleBar) {
+  const std::vector<Spot> spots = EmptyRow();
+  for (const char* const kind : {"around the traffic lights"}) {
+    EXPECT_TRUE(std::ranges::any_of(
+        spots, [&](const Spot& spot) { return spot.what == kind; }))
+        << "no spot " << kind;
+  }
+  const std::vector<std::string> wrong = NotCaption(spots);
+  EXPECT_TRUE(wrong.empty()) << wrong.size() << " of " << spots.size()
+                             << " spots are not the title bar:\n"
+                             << base::JoinString(wrong, "\n");
+
+  ToolbarView* const toolbar = view()->toolbar();
+  EXPECT_EQ(
+      HTCLIENT,
+      widget()->GetNonClientComponent(
+          InWidget(toolbar->GetViewByID(VIEW_ID_BACK_BUTTON)).CenterPoint()))
+      << "Back is a button";
+  EXPECT_EQ(HTCLIENT, widget()->GetNonClientComponent(
+                          InWidget(view()->contents_container()).CenterPoint()))
+      << "the page is the page";
+
+  SetDoubleClickAction(@"Maximize");
+  // One spot of each kind: the middle one of its run.
+  std::vector<Spot> one_of_each;
+  for (size_t i = 0; i < spots.size();) {
+    size_t end = i;
+    while (end < spots.size() && spots[end].what == spots[i].what) {
+      ++end;
+    }
+    one_of_each.push_back(spots[i + (end - i) / 2]);
+    i = end;
+  }
+  for (const Spot& spot : one_of_each) {
+    SCOPED_TRACE(spot.what + " at " + spot.point.ToString());
+    ASSERT_FALSE(window().zoomed);
+    DoubleClick(spot.point);
+    EXPECT_TRUE(window().zoomed) << "a double click did not zoom";
+    ASSERT_TRUE(Restore());
+  }
+}
+
+// E9: the little window is light or dark as the main window is: as the
+// system is while Stedding follows it, and as the owner chose otherwise
+// (Settings > Appearance), and a change reaches an open little window at
+// once. The ground under its row where a page has no colour (the window's
+// frame colour), its native frame -- the traffic lights' background, its
+// corners, its shadow, which take the window's appearance -- and its menus
+// follow. With Dark Pages on, its page is darkened as a tab's is (dark pages
+// Dk1), and the row with it.
+IN_PROC_BROWSER_TEST_F(LittleWindowRowTest, ItIsLightOrDarkAsTheMainWindowIs) {
+  Profile* const profile = browser()->GetProfile();
+  ThemeService* const themes = ThemeServiceFactory::GetForProfile(profile);
+  views::Widget* const main =
+      BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  const auto mode_of = [](views::Widget* window) {
+    return window->GetColorProviderKeyForTesting().color_mode;
+  };
+  // Both windows, the little one's ground and its native frame, all dark or
+  // all light.
+  const auto all_are = [&](bool dark) {
+    const ui::ColorProviderKey::ColorMode mode =
+        dark ? ui::ColorProviderKey::ColorMode::kDark
+             : ui::ColorProviderKey::ColorMode::kLight;
+    const ui::ColorProvider* const provider = widget()->GetColorProvider();
+    NSAppearanceName const frame =
+        [window().effectiveAppearance bestMatchFromAppearancesWithNames:@[
+          NSAppearanceNameAqua, NSAppearanceNameDarkAqua
+        ]];
+    return mode_of(widget()) == mode && mode_of(main) == mode && provider &&
+           color_utils::IsDark(provider->GetColor(ui::kColorFrameActive)) ==
+               dark &&
+           [frame isEqualToString:dark ? NSAppearanceNameDarkAqua
+                                       : NSAppearanceNameAqua];
+  };
+
+  themes->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kSystem);
+  os_settings_.SetPreferredColorScheme(
+      ui::NativeTheme::PreferredColorScheme::kLight);
+  EXPECT_TRUE(base::test::RunUntil([&] { return all_are(false); }))
+      << "light with the system";
+  os_settings_.SetPreferredColorScheme(
+      ui::NativeTheme::PreferredColorScheme::kDark);
+  EXPECT_TRUE(base::test::RunUntil([&] { return all_are(true); }))
+      << "dark at once when the system turns dark";
+
+  themes->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kLight);
+  EXPECT_TRUE(base::test::RunUntil([&] { return all_are(false); }))
+      << "the owner's choice of light over a dark system";
+  os_settings_.SetPreferredColorScheme(
+      ui::NativeTheme::PreferredColorScheme::kLight);
+  themes->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kDark);
+  EXPECT_TRUE(base::test::RunUntil([&] { return all_are(true); }))
+      << "the owner's choice of dark over a light system";
+
+  // The light page darkened, and the row in its darkened colour.
+  ASSERT_TRUE(RowColourIs(kLightPage));
+  stedding::SetDarkPagesOn(profile, true);
+  const stedding::PageThemeColorController* const pages =
+      stedding::PageThemeColorController::From(little_);
+  ASSERT_TRUE(pages);
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    return pages->color() && color_utils::IsDark(*pages->color());
+  })) << "Dark Pages darkens the little window's page";
+  stedding::SetDarkPagesOn(profile, false);
+  EXPECT_TRUE(RowColourIs(kLightPage)) << "and gives it back";
+  themes->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kSystem);
+}
+
+}  // namespace
