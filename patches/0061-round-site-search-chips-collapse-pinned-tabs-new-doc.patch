+  const TemplateURL* best = nullptr;
+  int best_rank = 0;
+  for (const auto& entry : service->GetTemplateURLs()) {
+    const TemplateURL* const site = entry.get();
+    if (!site || !OffersSiteSearch(*site, *service)) {
+      continue;
+    }
+    const std::optional<int> rank =
+        SiteSearchRank(*site, service->search_terms_data(), typed);
+    if (!rank || (typed.size() < kMinSiteSearchPrefix && *rank != 0)) {
+      continue;
