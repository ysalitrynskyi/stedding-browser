+// P20: the peek is the pinned tab's: another tab on screen hides it, and it
+// comes back with its tab; the window's Cmd-O keeps it.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, ThePeekGoesAndComesWithItsTab) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  ASSERT_TRUE(peek->widget()->IsVisible());
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("c.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_NE(pin, tab());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !peek->widget()->IsVisible(); }))
+      << "the peek stayed over another tab";
+  EXPECT_FALSE(stedding::PeekOverPageOfActiveTab(browser()));
+  EXPECT_EQ(peek, stedding::PeekOverlay::ForSource(pin)) << "it closed";
+
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return peek->widget()->IsVisible(); }))
+      << "the peek did not come back with its tab";
+
+  content::WebContents* const page = peek->page();
+  chrome::ExecuteCommand(browser(), IDC_OPEN_FILE);
+  ASSERT_TRUE(WaitForNoPeek(pin));
+  EXPECT_EQ(page, contents());
+}
