+  EXPECT_TRUE(chrome::ExecuteCommand(window, IDC_STEDDING_SPACE_PREVIOUS));
+  EXPECT_EQ(0, tabs->active_index()) << "the previous-Space keys moved no tab";
+
+  bookmarks::BookmarkModel* const bookmarks =
+      BookmarkModelFactory::GetForBrowserContext(window->GetProfile());
+  bookmarks::test::WaitForBookmarkModelToLoad(bookmarks);
+  ASSERT_FALSE(bookmarks->IsBookmarked(page));
+  EXPECT_TRUE(chrome::ExecuteCommand(window, IDC_STEDDING_TOGGLE_SPACE_PIN));
+  EXPECT_TRUE(bookmarks->IsBookmarked(page)) << "the pin key bookmarked nothing";
+}
