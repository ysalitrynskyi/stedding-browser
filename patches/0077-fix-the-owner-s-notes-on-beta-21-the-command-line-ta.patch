+// pins H3, tabs R4 (the owner, 2026-10-21): a pin closed while it plays
+// sound -- a Space pin at its home with Cmd-W, a drifted essential with the
+// tab menu's Close -- is unloaded, and at once its row or card shows no
+// sound: no speaker, and no "Audio playing" in its name. The page had gone,
+// and the row kept both: an unload puts new contents in the tab, and the
+// alert the old contents raised was never lowered.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, AClosedPinShowsNoSound) {
+  const GURL home = embedded_test_server()->GetURL("home.test", "/title1.html");
+  const GURL away = embedded_test_server()->GetURL("away.test", "/title2.html");
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  TabStripModel* const tabs = tab_strip_model();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), away));
+  tabs::TabInterface* const before = tabs->GetActiveTab();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), home, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const pin = tabs->GetActiveTab();
+  model->SetSpacePinned(pin, true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), home, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const essential = tabs->GetActiveTab();
+  tabs->SetTabPinned(tabs->GetIndexOfTab(essential), true);
+
+  // `tab` on screen at `url`, playing a tone, which its alerts say.
+  const auto play = [&](tabs::TabInterface* tab, const GURL& url) {
+    tabs->ActivateTabAt(tabs->GetIndexOfTab(before));
+    tabs->ActivateTabAt(tabs->GetIndexOfTab(tab));
+    ASSERT_TRUE(content::WaitForLoadStop(tab->GetContents()));
+    if (tab->GetContents()->GetLastCommittedURL() != url) {
+      ASSERT_TRUE(content::NavigateToURL(tab->GetContents(), url));
+    }
+    ASSERT_TRUE(content::ExecJs(
+        tab->GetContents(),
+        "window.context = new AudioContext();"
+        "const tone = window.context.createOscillator();"
+        "tone.connect(window.context.destination); tone.start();"
+        "window.context.resume();"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return tabs::TabAlertController::From(tab)->IsAlertActive(
+          tabs::TabAlert::kAudioPlaying);
+    })) << "the tone never played";
+  };
+  // `tab` unloaded, still a pin, and no sound on it or on its row.
+  const auto expect_no_sound = [&](tabs::TabInterface* tab) {
+    const tabs::TabHandle handle = tab->GetHandle();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !handle.Get() || handle.Get()->GetContents()->WasDiscarded();
+    })) << "the pin was not unloaded";
+    ASSERT_TRUE(handle.Get()) << "the close closed the pin";
+    EXPECT_FALSE(tab->GetContents()->GetPrimaryMainFrame()->IsRenderFrameLive())
+        << "the page still runs";
+    const std::optional<tabs::TabAlert> alert =
+        tabs::TabAlertController::From(tab)->GetAlertToShow();
+    EXPECT_FALSE(alert.has_value())
+        << "the unloaded tab still shows alert "
+        << static_cast<int>(alert.value_or(tabs::TabAlert::kNone));
+    ASSERT_NO_FATAL_FAILURE(WaitForRowsToSettle());
+    std::u16string name;
+    bool speaker = true;
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(browser_view()->GetWidget());
+      TabView* const row = RowFor(tabs->GetIndexOfTab(tab));
+      if (!row) {
+        return false;
+      }
+      name = std::u16string(row->GetViewAccessibility().GetCachedName());
+      const AlertIndicatorButton* const indicator =
+          FindView<AlertIndicatorButton>(row);
+      speaker = indicator && indicator->GetVisible() &&
+                indicator->showing_alert_state().has_value();
+      return !speaker && name.find(u"Audio playing") == std::u16string::npos;
+    })) << "the row is \"" << base::UTF16ToUTF8(name) << "\""
+        << (speaker ? ", its speaker still drawn" : "");
+  };
+
+  {
+    SCOPED_TRACE("Cmd-W on a Space pin at its home");
+    ASSERT_NO_FATAL_FAILURE(play(pin, home));
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+    ASSERT_NO_FATAL_FAILURE(expect_no_sound(pin));
+  }
+  {
+    SCOPED_TRACE("the tab menu's Close on a drifted essential");
+    ASSERT_NO_FATAL_FAILURE(play(essential, away));
+    TabContextMenuController controller(essential->GetHandle(),
+                                        vertical_tab_strip_controller());
+    TabMenuModel menu(&controller, TabMenuModelDelegate::From(browser()),
+                      tabs, tabs->GetIndexOfTab(essential));
+    const std::optional<size_t> close =
+        menu.GetIndexOfCommandId(TabStripModel::CommandCloseTab);
+    ASSERT_TRUE(close.has_value()) << "the menu has no Close";
+    menu.ActivatedAt(*close);
+    ASSERT_NO_FATAL_FAILURE(expect_no_sound(essential));
+  }
+}
