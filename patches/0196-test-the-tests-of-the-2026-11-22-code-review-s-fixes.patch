+// P18-1f, pins H1: an imported pin's home is the address asked for, taken
+// before its page has loaded, and the first load settles it on the page the
+// site sends it to. Restored from the session before it ever loaded, the pin
+// still settles on its first load. The mark was in memory only, so after a
+// restart the redirect read as drift for good.
+TEST_F(PinHomeB16Test, AHomeTakenBeforeItsFirstLoadSettlesAfterARestart) {
+  const SpaceId home = model().active_id();
+  const GURL front("https://example.com/");
+  const GURL deeper("https://example.com/deeper");
+  tabs::TabInterface* const imported = ImportPin(front);
+  ASSERT_TRUE(imported);
+  ASSERT_TRUE(model().IsSpacePinned(imported));
+  ASSERT_EQ(std::optional<GURL>(front), model().HomeUrl(imported));
+
+  // The pin's line in the session, read back as a restore reads it.
+  std::map<std::string, std::string> saved;
+  for (const auto& [key, value] :
+       model().SessionExtraDataForTab(imported, home)) {
+    saved[key] = value;
+  }
+  tabs::TabInterface* const restored = InsertUnloadedTabAt(
+      &tabs(), profile(), front, u"Imported", tabs().count(),
+      [&](content::WebContents& contents) {
+        RestoreSpaceFromExtraData(&contents, saved);
+      });
+  ASSERT_TRUE(restored);
+  ASSERT_TRUE(model().IsSpacePinned(restored));
+  ASSERT_EQ(std::optional<GURL>(front), model().HomeUrl(restored));
+
+  // The pin as the import made it settles on its first load.
+  LoadWithRedirect(imported, front, deeper);
+  ASSERT_EQ(std::optional<GURL>(deeper), model().HomeUrl(imported));
+
+  LoadWithRedirect(restored, front, deeper);
+  ASSERT_EQ(deeper, restored->GetContents()->GetLastCommittedURL());
+  EXPECT_EQ(std::optional<GURL>(deeper), model().HomeUrl(restored))
+      << "the restored pin kept the address from before the redirect";
+  EXPECT_FALSE(stedding::HasDriftedFromHome(
+      model().HomeUrl(restored).value_or(front),
+      restored->GetContents()->GetLastCommittedURL()));
+}
