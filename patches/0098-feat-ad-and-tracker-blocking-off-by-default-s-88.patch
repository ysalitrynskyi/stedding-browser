+namespace {
+
+// Google's Subresource Filter Rules component.
+constexpr char kGooglesRulesetComponentId[] =
+    "gcmjkmgdlgnkkcocmoeiminaijmmjnii";
+
+constexpr char kPage[] = "/stedding/blocker/page.html";
+
+// page.html's results: the ad script, the ok script, the tracker, the ad
+// image, the ok image, the ad frame, the ok frame, the ad fetch, the ok
+// fetch.
+constexpr char kAllLoaded[] = "1,1,1,1,1,1,1,1,1";
+constexpr char kListedBlocked[] = "0,1,0,0,1,0,1,0,1";
+
+using Manager = subresource_filter::ContentSubresourceFilterThrottleManager;
+
+class BlockerTest : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    ASSERT_TRUE(list_server_.InitializeAndListen());
+    command_line->AppendSwitchASCII(
+        stedding::kBlockerListBaseSwitch,
+        list_server_.GetURL("/stedding/blocker/").spec());
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    list_server_.RegisterRequestMonitor(base::BindRepeating(
+        &BlockerTest::OnListServerRequest, base::Unretained(this)));
+    list_server_.AddDefaultHandlers(GetChromeTestDataDir());
+    list_server_.StartAcceptingConnections();
+    if (embedded_test_server()->Started()) {
+      embedded_test_server()->StartAcceptingConnections();
+    } else {
+      ASSERT_TRUE(embedded_test_server()->Start());
+    }
+  }
+
+  PrefService* local_state() { return g_browser_process->local_state(); }
+  Profile* profile() { return browser()->GetProfile(); }
+
+  content::WebContents* Active(BrowserWindowInterface* browser = nullptr) {
+    return (browser ? browser : this->browser())
+        ->GetTabStripModel()
+        ->GetActiveWebContents();
+  }
+
+  GURL PageOn(const std::string& host) {
+    return embedded_test_server()->GetURL(host, kPage);
+  }
+
+  void Open(const std::string& host,
+            BrowserWindowInterface* browser = nullptr) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser ? browser : this->browser(), PageOn(host)));
+  }
+
+  static std::string Results(content::WebContents* contents) {
+    return content::EvalJs(contents, "window.blockerResults()")
+        .ExtractString();
+  }
+
+  // Turns blocking on and waits until both lists have arrived and the
+  // ruleset made from them is the one the ruleset service has indexed.
+  void TurnOnAndWait() {
+    local_state()->SetBoolean(stedding::prefs::kBlockerEnabled, true);
+    stedding::BlockerLists* const lists = stedding::BlockerLists::Get();
+    ASSERT_TRUE(lists);
+    subresource_filter::RulesetService* const service =
+        g_browser_process->subresource_filter_ruleset_service();
+    ASSERT_TRUE(service);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      const stedding::BlockerLists::Status status = lists->GetStatus();
+      return !status.busy && status.has_ruleset &&
+             std::ranges::all_of(
+                 status.lists,
+                 [](const stedding::BlockerLists::ListStatus& list) {
+                   return !list.fetched.is_null();
+                 }) &&
+             service->GetMostRecentlyIndexedVersion().content_version ==
+                 status.content_version;
+    }));
+    // The service records the version it indexed, then opens the ruleset on
+    // its dealer's sequence and publishes it from the reply. A turn of that
+    // sequence and back to this one ends after the publication, so the next
+    // page is filtered with the new ruleset.
+    base::RunLoop published;
+    service->GetRulesetDealer()->GetDealerAsync(base::BindOnce(
+        [](scoped_refptr<base::SequencedTaskRunner> ui,
+           base::OnceClosure quit,
+           subresource_filter::VerifiedRulesetDealer*) {
+          ui->PostTask(FROM_HERE, std::move(quit));
+        },
+        base::SequencedTaskRunner::GetCurrentDefault(),
+        published.QuitClosure()));
+    published.Run();
+  }
+
+  // Flips the site's switch for the active tab and waits for its reload.
+  static void ToggleSite(content::WebContents* contents) {
+    content::TestNavigationObserver reload(contents);
+    stedding::ToggleBlockingOnSite(contents);
+    reload.Wait();
+  }
+
+  std::vector<net::test_server::HttpRequest> ListRequests() {
+    base::AutoLock lock(lock_);
+    std::vector<net::test_server::HttpRequest> lists;
+    for (const net::test_server::HttpRequest& request : list_server_requests_) {
+      if (request.GetURL().path().ends_with(".txt")) {
+        lists.push_back(request);
+      }
+    }
+    return lists;
+  }
+
+  net::EmbeddedTestServer list_server_;
+
+ private:
+  void OnListServerRequest(const net::test_server::HttpRequest& request) {
+    base::AutoLock lock(lock_);
+    list_server_requests_.push_back(request);
+  }
+
+  base::Lock lock_;
+  std::vector<net::test_server::HttpRequest> list_server_requests_;
+};
+
+}  // namespace
+
+// Bk1, Bk2, Bk12: a fresh install blocks nothing and fetches nothing; the
+// subresource filter keeps Chromium's own activation.
+IN_PROC_BROWSER_TEST_F(BlockerTest, AFreshProfileFetchesNothing) {
+  EXPECT_FALSE(local_state()->GetBoolean(stedding::prefs::kBlockerEnabled));
+  EXPECT_FALSE(stedding::BlockerOn(local_state()));
+  EXPECT_FALSE(Manager::HasPageActivationThrottleFactory());
+  Open("a.test");
+  EXPECT_EQ(kAllLoaded, Results(Active()));
+  EXPECT_TRUE(ListRequests().empty());
+}
+
+// Bk1: with blocking on, the listed script, tracker, image, frame and fetch
+// do not load; the unlisted ones do.
+IN_PROC_BROWSER_TEST_F(BlockerTest, AListedScriptImageAndFrameAreBlocked) {
+  TurnOnAndWait();
+  EXPECT_TRUE(Manager::HasPageActivationThrottleFactory());
+  Open("a.test");
+  EXPECT_EQ(kListedBlocked, Results(Active()));
+}
+
+// Bk1: turned off again, every page loads everything; the lists stay on
+// disk and nothing more is fetched.
+IN_PROC_BROWSER_TEST_F(BlockerTest, TheSwitchOffLoadsEverything) {
+  TurnOnAndWait();
+  local_state()->SetBoolean(stedding::prefs::kBlockerEnabled, false);
+  EXPECT_FALSE(Manager::HasPageActivationThrottleFactory());
+  const size_t fetched = ListRequests().size();
+  Open("a.test");
+  EXPECT_EQ(kAllLoaded, Results(Active()));
+  stedding::BlockerLists::Get()->UpdateNow();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(fetched, ListRequests().size());
+}
+
+// Bk4: Google's ruleset component is not registered, so the ruleset is
+// Stedding's alone. The test lets the browser register its components, with
+// the update service pointed at the test's own server.
+class BlockerComponentsTest : public BlockerTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    BlockerTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(
+        switches::kComponentUpdater,
+        "url-source=" + list_server_.GetURL("/no-components").spec());
+  }
+
+  // The test launcher turns component updates off after SetUpCommandLine.
+  void SetUpDefaultCommandLine(base::CommandLine* command_line) override {
+    BlockerTest::SetUpDefaultCommandLine(command_line);
+    command_line->RemoveSwitch(switches::kDisableComponentUpdate);
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(BlockerComponentsTest,
+                       GooglesRulesetComponentIsNotRegistered) {
+  const std::vector<std::string> ids =
+      g_browser_process->component_updater()->GetComponentIDs();
+  ASSERT_FALSE(ids.empty()) << "the components were registered";
+  EXPECT_FALSE(std::ranges::contains(ids, kGooglesRulesetComponentId));
+}
+
+// Bk5: turning blocking off on a site loads that site's pages, subdomains
+// too, unfiltered; every other site stays filtered. Turning it back on
+// removes the exception.
+IN_PROC_BROWSER_TEST_F(BlockerTest,
+                       TheSiteSwitchTurnsBlockingOffForThatSiteOnly) {
+  TurnOnAndWait();
+  Open("a.test");
+  ASSERT_EQ(kListedBlocked, Results(Active()));
+  ToggleSite(Active());
+  EXPECT_EQ(kAllLoaded, Results(Active()));
+  EXPECT_FALSE(stedding::IsBlockingOnForSite(Active()));
+  EXPECT_EQ(1u, stedding::GetBlockerExceptions(profile()).size());
+
+  Open("sub.a.test");
+  EXPECT_EQ(kAllLoaded, Results(Active())) << "the site's subdomains too";
+  Open("b.test");
+  EXPECT_EQ(kListedBlocked, Results(Active()));
+
+  Open("a.test");
+  ToggleSite(Active());
+  EXPECT_EQ(kListedBlocked, Results(Active()));
+  EXPECT_TRUE(stedding::GetBlockerExceptions(profile()).empty());
+}
+
+// Bk5: a private window's choice stays in that window's session; the normal
+// profile keeps filtering the site and records nothing.
+IN_PROC_BROWSER_TEST_F(BlockerTest, APrivateWindowsSiteSwitchIsForgotten) {
+  TurnOnAndWait();
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+  Open("a.test", incognito);
+  ASSERT_EQ(kListedBlocked, Results(Active(incognito)));
+  ToggleSite(Active(incognito));
+  EXPECT_EQ(kAllLoaded, Results(Active(incognito)));
+
+  EXPECT_TRUE(stedding::GetBlockerExceptions(profile()).empty());
+  Open("a.test");
+  EXPECT_EQ(kListedBlocked, Results(Active()));
+}
+
+// Bk5 (BACKLOG S-351): on a page a form loaded, the switch's reload asks
+// whether to send the form again. Cancelled, nothing is chosen: the shield
+// and the page both keep the blocking the page loaded with. Sent again, the
+// choice is made and the page reloads with it. The choice was written first,
+// and a cancel left the shield saying blocking was off over a filtered page.
+IN_PROC_BROWSER_TEST_F(BlockerTest, ACancelledResubmitChoosesNothing) {
+  TurnOnAndWait();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("a.test", "/form.html")));
+  {
+    content::TestNavigationObserver posted(Active());
+    ASSERT_TRUE(content::ExecJs(Active(),
+                                "document.getElementById('form').submit()"));
+    posted.Wait();
+  }
+  ASSERT_TRUE(
+      Active()->GetController().GetLastCommittedEntry()->GetHasPostData());
+  ASSERT_TRUE(stedding::IsBlockingOnForSite(Active()));
+
+  views::Widget* question = nullptr;
+  views::AnyWidgetObserver questions(views::test::AnyWidgetTestPasskey{});
+  questions.set_shown_callback(
+      base::BindLambdaForTesting([&](views::Widget* widget) {
+        if (widget->widget_delegate() &&
+            widget->widget_delegate()->AsDialogDelegate()) {
+          question = widget;
+        }
+      }));
+  {
+    SCOPED_TRACE("cancelled");
+    stedding::ToggleBlockingOnSite(Active());
+    ASSERT_TRUE(base::test::RunUntil([&]() { return question != nullptr; }))
+        << "no question about sending the form again";
+    question->widget_delegate()->AsDialogDelegate()->CancelDialog();
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(stedding::IsBlockingOnForSite(Active()))
+        << "the shield says off over the page as it loaded";
+    EXPECT_TRUE(stedding::GetBlockerExceptions(profile()).empty());
+  }
+  {
+    SCOPED_TRACE("sent again");
+    question = nullptr;
+    content::TestNavigationObserver reload(Active());
+    stedding::ToggleBlockingOnSite(Active());
+    ASSERT_TRUE(base::test::RunUntil([&]() { return question != nullptr; }));
+    question->widget_delegate()->AsDialogDelegate()->AcceptDialog();
+    reload.Wait();
+    EXPECT_FALSE(stedding::IsBlockingOnForSite(Active()));
+    EXPECT_EQ(1u, stedding::GetBlockerExceptions(profile()).size());
+  }
+}
+
+// Bk7: blocking keeps no record of the sites visited: no ADS_DATA metadata
+// for a site with blocked requests, and no "ads blocked" icon, also for a
+// page restored from the back-forward cache.
+IN_PROC_BROWSER_TEST_F(BlockerTest, BlockingWritesNothingPerSite) {
+  TurnOnAndWait();
+  HostContentSettingsMap* const map =
+      HostContentSettingsMapFactory::GetForProfile(profile());
+  const auto check = [&](const std::string& host) {
+    SCOPED_TRACE(host);
+    EXPECT_EQ(kListedBlocked, Results(Active()));
+    EXPECT_TRUE(map->GetWebsiteSetting(PageOn(host), GURL(),
+                                       ContentSettingsType::ADS_DATA)
+                    .is_none());
+    content_settings::PageSpecificContentSettings* const page =
+        content_settings::PageSpecificContentSettings::GetForFrame(
+            Active()->GetPrimaryMainFrame());
+    ASSERT_TRUE(page);
+    EXPECT_FALSE(page->IsContentBlocked(ContentSettingsType::ADS));
+  };
+  for (const char* host : {"a.test", "b.test", "c.test"}) {
+    Open(host);
+    check(host);
+  }
+  // Back to b.test, from the back-forward cache where the browser keeps it.
+  content::TestNavigationObserver back(Active());
+  Active()->GetController().GoBack();
+  back.Wait();
+  check("b.test");
+}
+
+// Bk12: a list fetch carries nothing about the user: no cookie, though the
+// list's host has set one, and no query string.
+IN_PROC_BROWSER_TEST_F(BlockerTest, TheListFetchCarriesNothingAboutTheUser) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), list_server_.GetURL("/set-cookie?visitor=1")));
+  TurnOnAndWait();
+  const std::vector<net::test_server::HttpRequest> requests = ListRequests();
+  std::string asked;
+  for (const net::test_server::HttpRequest& request : requests) {
+    asked += request.relative_url + " ";
+  }
+  ASSERT_EQ(2u, requests.size()) << asked;
+  for (const net::test_server::HttpRequest& request : requests) {
+    SCOPED_TRACE(request.relative_url);
+    EXPECT_FALSE(request.headers.contains("Cookie"));
+    EXPECT_TRUE(request.GetURL().query().empty());
+  }
+}
+
+// Bk13: Delete browsing data with "Site settings" ticked clears the
+// exceptions.
+IN_PROC_BROWSER_TEST_F(BlockerTest, DeletingSiteSettingsClearsTheExceptions) {
+  ASSERT_TRUE(stedding::AddBlockerException(profile(), "a.test"));
+  ASSERT_EQ(1u, stedding::GetBlockerExceptions(profile()).size());
+  content::BrowsingDataRemover* const remover =
+      profile()->GetBrowsingDataRemover();
+  content::BrowsingDataRemoverCompletionObserver observer(remover);
+  remover->RemoveAndReply(
+      base::Time(), base::Time::Max(),
+      chrome_browsing_data_remover::DATA_TYPE_CONTENT_SETTINGS,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB, &observer);
+  observer.BlockUntilCompletion();
+  EXPECT_TRUE(stedding::GetBlockerExceptions(profile()).empty());
+}
+
+// Bk11: after a launch with a ruleset indexed at the run before, the first
+// page is filtered, with no list fetched at the launch. A browser test opens
+// its window on a blank page whatever the command line names, so the first
+// page is the first navigation.
+using BlockerLaunchTest = BlockerTest;
+
+IN_PROC_BROWSER_TEST_F(BlockerLaunchTest,
+                       PRE_TheFirstPageAfterALaunchIsFiltered) {
+  TurnOnAndWait();
+}
+
+IN_PROC_BROWSER_TEST_F(BlockerLaunchTest,
+                       TheFirstPageAfterALaunchIsFiltered) {
+  Open("a.test");
+  EXPECT_EQ(kListedBlocked, Results(Active()));
+  EXPECT_TRUE(ListRequests().empty()) << "a list fetched at the launch";
+}
+
+// Bk6: the shield follows the active tab's site, the switch and its own
+// setting, and a click flips the site's switch.
+using BlockerButtonTest = BlockerTest;
+
+IN_PROC_BROWSER_TEST_F(BlockerButtonTest, TheButtonFollowsTheSiteAndFlipsIt) {
+  stedding::BlockerButton* button = nullptr;
+  ToolbarView* const toolbar =
+      BrowserView::GetBrowserViewForBrowser(browser())->toolbar();
+  for (views::View* child : toolbar->children()) {
+    if (auto* const found =
+            views::AsViewClass<stedding::BlockerButton>(child)) {
+      button = found;
+    }
+  }
+  ASSERT_TRUE(button);
+  Open("a.test");
+  EXPECT_FALSE(button->GetVisible()) << "hidden while blocking is off";
+
+  TurnOnAndWait();
+  Open("a.test");
+  EXPECT_TRUE(button->GetVisible());
+  EXPECT_TRUE(button->is_on());
+  EXPECT_EQ(u"Blocking ads and trackers on a.test", button->GetTooltipText());
+
+  content::TestNavigationObserver reload(Active());
+  views::test::ButtonTestApi(button).NotifyClick(ui::MouseEvent(
+      ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+      ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+      ui::EF_LEFT_MOUSE_BUTTON));
+  reload.Wait();
+  EXPECT_FALSE(button->is_on());
+  EXPECT_EQ(u"Blocking is off on a.test", button->GetTooltipText());
+  EXPECT_EQ(kAllLoaded, Results(Active()));
+
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://version/")));
+  EXPECT_FALSE(button->GetVisible()) << "not a web page";
+  Open("b.test");
+  EXPECT_TRUE(button->GetVisible());
+  EXPECT_TRUE(button->is_on());
+  profile()->GetPrefs()->SetBoolean(stedding::prefs::kBlockerButton, false);
+  EXPECT_FALSE(button->GetVisible()) << "its setting hides it";
+}
+
+// Bk9: Settings shows the lists and the exceptions, binds the switch, the
+// two lists and the button's setting, and "Update lists now" fetches.
+using SettingsBlockerTest = BlockerTest;
+
+IN_PROC_BROWSER_TEST_F(SettingsBlockerTest,
+                       TheRowsShowTheListsAndUpdateNow) {
+  TurnOnAndWait();
+  ASSERT_TRUE(stedding::AddBlockerException(profile(), "shop.test"));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://settings/stedding")));
+  content::WebContents* const page = Active();
+
+  EXPECT_EQ("EasyList,EasyPrivacy|shop.test",
+            content::EvalJs(page, R"(
+      import('chrome://resources/js/cr.js')
+          .then(cr => cr.sendWithPromise('steddingGetBlocker'))
+          .then(state => state.lists.map(list => list.name).join(',') + '|' +
+                state.exceptions.map(site => site.name).join(',')))")
+                .ExtractString());
+
+  // Every control of the group, found through every shadow root once the
+  // page has drawn it.
+  constexpr char kFind[] = R"(
+    new Promise(resolve => {
+      const find = root => {
+        for (const element of root.querySelectorAll('*')) {
+          if (element.id === $1 ||
+              element.getAttribute('pref-key') === $1) {
+            return element;
+          }
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot);
+            if (found) {
+              return found;
+            }
+          }
+        }
+        return null;
+      };
+      let tries = 100;
+      const look = () => {
+        const element = find(document);
+        if (element || --tries === 0) {
+          if (element && $2) {
+            element.click();
+          }
+          resolve(!!element);
+        } else {
+          setTimeout(look, 100);
+        }
+      };
+      look();
+    }))";
+  for (const char* key :
+       {"stedding.blocker.enabled", "stedding.blocker.list.easylist",
+        "stedding.blocker.list.easyprivacy", "stedding.page.blocker_button",
+        "blockerExceptions"}) {
+    EXPECT_EQ(true, content::EvalJs(page, content::JsReplace(kFind, key,
+                                                              false)))
+        << key;
+  }
+  const size_t before = ListRequests().size();
+  EXPECT_EQ(true, content::EvalJs(page, content::JsReplace(
+                                            kFind, "blockerUpdateNow", true)));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&] { return ListRequests().size() >= before + 2; }));
+}
+
+// Bk10: the command bar's rows turn blocking off and on for the tab's site
+// and update the lists.
+class BlockerCommandBarTest : public BlockerTest {
+ protected:
+  stedding::CommandBarView* OpenBar() {
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_COMMAND_PALETTE);
+    return stedding::CommandBarView::GetOpenBar(
+        BrowserView::GetBrowserViewForBrowser(browser()));
+  }
+
+  std::vector<std::u16string> Titles(const std::u16string& typed) {
+    stedding::CommandBarView* const bar = OpenBar();
+    EXPECT_TRUE(bar);
+    if (!bar) {
+      return {};
+    }
+    bar->field_for_testing()->SetText(typed);
+    bar->ContentsChanged(bar->field_for_testing(), typed);
+    std::vector<std::u16string> titles;
+    for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+      titles.push_back(bar->row_title_for_testing(i));
+    }
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+    return titles;
+  }
+
+  // Types `title`, walks down to its row and presses Enter.
+  void Run(const std::u16string& title) {
+    stedding::CommandBarView* const bar = OpenBar();
+    ASSERT_TRUE(bar);
+    bar->field_for_testing()->SetText(title);
+    bar->ContentsChanged(bar->field_for_testing(), title);
+    size_t index = 0;
+    while (index < bar->row_count_for_testing() &&
+           bar->row_title_for_testing(index) != title) {
+      ++index;
+    }
+    ASSERT_LT(index, bar->row_count_for_testing()) << "the row is there";
+    views::View* const field = bar->field_for_testing();
+    for (size_t i = 0; i < index; ++i) {
+      field->OnKeyPressed(ui::KeyEvent(ui::EventType::kKeyPressed,
+                                       ui::VKEY_DOWN, ui::EF_NONE));
+    }
+    field->OnKeyPressed(ui::KeyEvent(ui::EventType::kKeyPressed,
+                                     ui::VKEY_RETURN, ui::EF_NONE));
+    base::RunLoop().RunUntilIdle();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(BlockerCommandBarTest, TheBlockerRowsActOnTheSite) {
+  Open("a.test");
+  EXPECT_FALSE(std::ranges::contains(Titles(u"Blocking"),
+                                     u"Turn Off Blocking on This Site"))
+      << "no row while blocking is off";
+
+  TurnOnAndWait();
+  Open("a.test");
+  const std::vector<std::u16string> titles = Titles(u"Blocking");
+  EXPECT_TRUE(std::ranges::contains(titles, u"Turn Off Blocking on This Site"));
+  EXPECT_TRUE(std::ranges::contains(Titles(u"Lists"),
+                                    u"Update Ad and Tracker Lists"));
+
+  content::TestNavigationObserver reload(Active());
+  Run(u"Turn Off Blocking on This Site");
+  reload.Wait();
+  EXPECT_FALSE(stedding::IsBlockingOnForSite(Active()));
+  EXPECT_EQ(kAllLoaded, Results(Active()));
+  EXPECT_TRUE(std::ranges::contains(Titles(u"Blocking"),
+                                    u"Turn On Blocking on This Site"));
+
+  const size_t before = ListRequests().size();
+  Run(u"Update Ad and Tracker Lists");
+  EXPECT_TRUE(base::test::RunUntil(
+      [&] { return ListRequests().size() >= before + 2; }));
+}
