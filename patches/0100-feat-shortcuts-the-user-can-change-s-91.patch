+class ShortcutSettingsTest : public ShortcutRebindTest {
+ protected:
+  content::WebContents* OpenSettings() {
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), GURL("chrome://settings/stedding")));
+    content::WebContents* const page =
+        browser()->GetTabStripModel()->GetActiveWebContents();
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(page, OnTheBlock(R"(
+        return editor.shadowRoot.querySelector('.shortcut-row') ? 'drawn'
+                                                                : '';)"))
+                 .ExtractString() == "drawn";
+    }));
+    return page;
+  }
+
+  std::string Eval(content::WebContents* page, const std::string& body) {
+    return content::EvalJs(page, OnTheBlock(body)).ExtractString();
+  }
+};
