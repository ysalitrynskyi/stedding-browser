+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+
+namespace {
+
+// private V1: an incognito key (dark, grayscale) paints graphite with no
+// Space tint; an ordinary dark key keeps its tint.
+TEST(SteddingColorMixerTest, PrivateWindowsAreGraphite) {
+  base::test::ScopedFeatureList features(stedding::kArcStyleWindow);
+  ui::ColorProviderKey key;
+  key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+  key.user_color_source = ui::ColorProviderKey::UserColorSource::kGrayscale;
+  key.user_color = SK_ColorRED;
+  EXPECT_TRUE(IsPrivateColorKey(key));
+  ui::ColorProvider provider;
+  AddSteddingColorMixer(&provider, key);
+  provider.GenerateColorMapForTesting();
+  EXPECT_EQ(kSteddingPrivateWindow, provider.GetColor(ui::kColorFrameActive));
+
+  key.user_color_source = ui::ColorProviderKey::UserColorSource::kAccent;
+  EXPECT_FALSE(IsPrivateColorKey(key));
+  ui::ColorProvider tinted;
+  AddSteddingColorMixer(&tinted, key);
+  tinted.GenerateColorMapForTesting();
+  EXPECT_NE(kSteddingPrivateWindow, tinted.GetColor(ui::kColorFrameActive));
+}
+
+}  // namespace
