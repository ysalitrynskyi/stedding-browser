+// import I30, I38, I40: on the history database's thread, adds the rows that
+// are not there yet, by URL and visit time.
+class AddNewVisitsTask : public history::HistoryDBTask {
+ public:
+  AddNewVisitsTask(history::URLRows rows,
+                   history::VisitSource source,
+                   base::OnceCallback<void(size_t)> done)
+      : rows_(std::move(rows)), source_(source), done_(std::move(done)) {}
+  AddNewVisitsTask(const AddNewVisitsTask&) = delete;
+  AddNewVisitsTask& operator=(const AddNewVisitsTask&) = delete;
+  ~AddNewVisitsTask() override = default;
+
+  bool RunOnDBThread(history::HistoryBackend* backend,
+                     history::HistoryDatabase* db) override {
+    const base::Time now = base::Time::Now();
+    const base::Time oldest = OldestKeptVisit(now);
+    const base::Time latest = LatestKeptVisit(now);
+    std::set<std::pair<GURL, base::Time>> seen;
+    history::URLRows fresh;
+    for (history::URLRow& row : rows_) {
+      // The history service drops a visit it would not keep anyway; one
+      // dated ahead of now it would keep for good (BACKLOG S-346).
+      if (row.last_visit().is_null() || row.last_visit() < oldest ||
+          row.last_visit() > latest) {
+        continue;
+      }
+      if (!seen.emplace(row.url(), row.last_visit()).second) {
+        continue;
+      }
+      history::URLRow existing;
+      const history::URLID id = db->GetRowForURL(row.url(), &existing);
+      if (id) {
+        history::VisitVector visits;
+        db->GetVisitsForURL(id, &visits);
+        const base::Time when = row.last_visit();
+        if (std::ranges::any_of(visits, [when](const history::VisitRow& v) {
+              return v.visit_time == when;
+            })) {
+          continue;
+        }
+      }
+      fresh.push_back(std::move(row));
+    }
+    added_ = fresh.size();
+    if (!fresh.empty()) {
+      backend->AddPagesWithDetails(fresh, source_);
+    }
+    return true;
+  }
+
+  void DoneRunOnMainThread() override { std::move(done_).Run(added_); }
+
+ private:
+  history::URLRows rows_;
+  const history::VisitSource source_;
+  base::OnceCallback<void(size_t)> done_;
+  size_t added_ = 0;
+};
