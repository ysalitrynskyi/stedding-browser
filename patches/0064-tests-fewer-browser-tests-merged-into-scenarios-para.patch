+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       AFolderClosedInPartComesBackOneRowAtATime) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+
+  const auto host_of = [](const sessions::tab_restore::Tab& tab) {
+    return std::string(tab.navigations.at(tab.normalized_navigation_index())
+                           .virtual_url()
+                           .host());
+  };
+  // Closes F[a, b, c, d] after moving b and d to another Space.
+  const auto close_leaving_b_and_d = [&](const char* space_name,
+                                         SkColor color) {
+    CloseDownToOne();
+    ClearClosedTabs();
+    for (const char* const host : {"a.test", "b.test", "c.test", "d.test"}) {
+      OpenLoaded(host);
+    }
+    ASSERT_EQ(5, tab_strip_model()->count());
+    tabs::FolderTabCollection* const folder =
+        tab_strip_model()->AddToNewFolder({1, 2, 3, 4});
+    ASSERT_TRUE(folder);
+    folder->SetTitle("Part");
+    ASSERT_EQ("a.test b.test c.test d.test ", HostsInFolder("Part", false));
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model);
+    const spaces::SpaceId other = model->AddSpace(space_name, color)->id();
+    model->SetSpaceForTab(tab_strip_model()->GetTabAtIndex(2), other);
+    model->SetSpaceForTab(tab_strip_model()->GetTabAtIndex(4), other);
+    tab_strip_model()->ActivateTabAt(1);
+    tab_strip_model()->CloseFolderTabs(folder);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return HostsInFolder("Part", false) == "b.test d.test ";
+    })) << "the close left \"" << HostsInFolder("Part", false) << "\"";
+  };
+  const auto restore_one = [&](SessionID id) {
+    service->RestoreEntryById(BrowserLiveTabContext::From(browser()), id,
+                              WindowOpenDisposition::NEW_FOREGROUND_TAB);
+  };
+
+  {
+    // ClosedFolderAt lists the close in folder order: a, then c.
+    SCOPED_TRACE("c then a");
+    ASSERT_NO_FATAL_FAILURE(close_leaving_b_and_d("Other", SK_ColorBLUE));
+    ASSERT_FALSE(service->entries().empty());
+    const std::optional<stedding::ClosedFolder> closed =
+        stedding::ClosedFolderAt(service->entries(),
+                                 service->entries().begin());
+    ASSERT_TRUE(closed);
+    ASSERT_EQ(2u, closed->tabs.size());
+    ASSERT_EQ("a.test", host_of(*closed->tabs[0]));
+    ASSERT_EQ("c.test", host_of(*closed->tabs[1]));
+    const SessionID a_id = closed->tabs[0]->id;
+    const SessionID c_id = closed->tabs[1]->id;
+
+    restore_one(c_id);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return HostsInFolder("Part", false) == "b.test c.test d.test ";
+    })) << "c alone came back as \"" << HostsInFolder("Part", false) << "\"";
+
+    restore_one(a_id);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return HostsInFolder("Part", false) == "a.test b.test c.test d.test ";
+    })) << "a then joined as \"" << HostsInFolder("Part", false) << "\"";
+  }
+
+  {
+    SCOPED_TRACE("a then c");
+    ASSERT_NO_FATAL_FAILURE(close_leaving_b_and_d("Else", SK_ColorRED));
+    ASSERT_FALSE(service->entries().empty());
+    const std::optional<stedding::ClosedFolder> closed =
+        stedding::ClosedFolderAt(service->entries(),
+                                 service->entries().begin());
+    ASSERT_TRUE(closed);
+    ASSERT_EQ(2u, closed->tabs.size());
+    ASSERT_EQ("a.test", host_of(*closed->tabs[0]));
+    ASSERT_EQ("c.test", host_of(*closed->tabs[1]));
+    const SessionID a_id = closed->tabs[0]->id;
+    const SessionID c_id = closed->tabs[1]->id;
+
+    restore_one(a_id);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return HostsInFolder("Part", false) == "a.test b.test d.test ";
+    })) << "a alone came back as \"" << HostsInFolder("Part", false) << "\"";
+
+    restore_one(c_id);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return HostsInFolder("Part", false) == "a.test b.test c.test d.test ";
+    })) << "c then joined as \"" << HostsInFolder("Part", false) << "\"";
+  }
+}
+
+// folders F19: shift-click Restore Folder is a new window. Every tab of the
+// folder comes back in that one window, in order, in one folder. The later
+// entries used to go back to the window the menu was opened from.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       AFolderRestoredToANewWindowStaysTogether) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  CloseDownToOne();
+  ClearClosedTabs();
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  for (const char* const host : {"a.test", "b.test", "c.test"}) {
+    OpenLoaded(host);
+  }
+  ASSERT_EQ(4, tab_strip_model()->count());
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({1, 2, 3});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Away");
+  ASSERT_EQ("a.test b.test c.test ", HostsInFolder("Away", false));
+  tab_strip_model()->ActivateTabAt(0);
+  tab_strip_model()->CloseFolderTabs(folder);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return tab_strip_model()->count() == 1; }));
+
+  const sessions::TabRestoreService::Entries& entries = service->entries();
+  ASSERT_FALSE(entries.empty());
+  const std::optional<stedding::ClosedFolder> closed =
+      stedding::ClosedFolderAt(entries, entries.begin());
+  ASSERT_TRUE(closed);
+  ASSERT_EQ(3u, closed->tabs.size());
+
+  std::vector<BrowserWindowInterface*> before;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* window) {
+        before.push_back(window);
+        return true;
+      });
+  stedding::RestoreClosedFolder(*service, BrowserLiveTabContext::From(browser()),
+                                closed->batch, WindowOpenDisposition::NEW_WINDOW);
+  // The later entries used to append into this window.
+  EXPECT_EQ(1, tab_strip_model()->count());
+
+  BrowserWindowInterface* opened = nullptr;
+  int new_windows = 0;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&](BrowserWindowInterface* window) {
+        if (std::ranges::find(before, window) == before.end()) {
+          opened = window;
+          ++new_windows;
+        }
+        return true;
+      });
+  ASSERT_EQ(1, new_windows);
+  ASSERT_TRUE(opened);
+  ASSERT_NE(browser(), opened);
+
+  TabStripModel* const strip = opened->GetTabStripModel();
+  const auto hosts = [&]() {
+    std::string out;
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      const tabs::TabCollection* const parent = tab->GetParentCollection();
+      if (!parent || parent->type() != tabs::TabCollection::Type::FOLDER ||
+          static_cast<const tabs::FolderTabCollection*>(parent)->title() !=
+              "Away") {
+        continue;
+      }
+      out += std::string(tab->GetContents()->GetLastCommittedURL().host());
+      out += " ";
+    }
+    return out;
+  };
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return hosts() == "a.test b.test c.test ";
+  })) << "the folder came back as \"" << hosts() << "\"";
+  const tabs::TabCollection* one_folder = nullptr;
+  int away = 0;
+  for (int i = 0; i < strip->count(); ++i) {
+    tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+    const tabs::TabCollection* const parent = tab->GetParentCollection();
+    if (!parent || parent->type() != tabs::TabCollection::Type::FOLDER ||
+        static_cast<const tabs::FolderTabCollection*>(parent)->title() !=
+            "Away") {
+      continue;
+    }
+    if (!one_folder) {
+      one_folder = parent;
+    }
+    EXPECT_EQ(one_folder, parent);
+    ++away;
+  }
+  EXPECT_EQ(3, away);
+  chrome::CloseWindow(opened);
+  ui_test_utils::WaitForBrowserToClose(opened);
+}
+
 }  // namespace
