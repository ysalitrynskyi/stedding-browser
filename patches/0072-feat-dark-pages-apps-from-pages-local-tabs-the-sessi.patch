+// A13 (BACKLOG S-230): a launch that does not restore the session after
+// all. The quit marked its windows as ones the next launch opens again, and
+// the archive, ⇧⌘T and Recently Closed passed them over though nothing had
+// reopened them. The launch settles the mark at the profile's first window.
+// The last step here starts with no window, as the Mac's browser starts
+// hidden at login, and is given one as the Dock and the menu bar give it,
+// which starts no session restore.
+class ArchiveWindowlessLaunchTest : public ArchiveReopenTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    ArchiveReopenTest::SetUpCommandLine(command_line);
+    if (GetTestPreCount() == 0) {
+      command_line->AppendSwitch(switches::kNoStartupWindow);
+      command_line->AppendSwitch(switches::kKeepAliveForTest);
+    }
+  }
+
+  // The window entries of `profile`'s list that hold a tab on `host`,
+  // newest first.
+  std::vector<const sessions::tab_restore::Window*> WindowsWith(
+      const std::string& host,
+      Profile* profile) {
+    std::vector<const sessions::tab_restore::Window*> windows;
+    for (const std::unique_ptr<sessions::tab_restore::Entry>& entry :
+         TabRestoreServiceFactory::GetForProfile(profile)->entries()) {
+      if (entry->type != sessions::tab_restore::WINDOW) {
+        continue;
+      }
+      const auto& window =
+          static_cast<const sessions::tab_restore::Window&>(*entry);
+      for (const std::unique_ptr<sessions::tab_restore::Tab>& tab :
+           window.tabs) {
+        if (!tab->navigations.empty() &&
+            tab->navigations[tab->normalized_navigation_index()]
+                    .virtual_url()
+                    .host() == host) {
+          windows.push_back(&window);
+          break;
+        }
+      }
+    }
+    return windows;
+  }
+};
