+// settings T41-T43 (GitHub issue 45): the window's look. Neutral grey has no
+// hue; a custom colour is used, kept light enough in the light look and dark
+// enough in the dark one; the Space's tint follows its strength, None
+// leaving the ground untinted; and the rows' tints follow the highlight.
+TEST(SteddingColorMixerTest, TheWindowsLookIsTheUsers) {
+  base::test::ScopedFeatureList features(stedding::kArcStyleWindow);
+  const stedding::WindowLook saved = stedding::GetWindowLook();
+  // The ground and the active row's fill for `look`, in a look, with a
+  // Space's colour when `tinted`.
+  const auto paint = [](const stedding::WindowLook& look, bool dark,
+                        bool tinted) {
+    stedding::SetWindowLook(look);
+    ui::ColorProviderKey key;
+    key.color_mode = dark ? ui::ColorProviderKey::ColorMode::kDark
+                          : ui::ColorProviderKey::ColorMode::kLight;
+    if (tinted) {
+      key.user_color = SkColorSetRGB(0xE5, 0x48, 0x4D);
+    }
+    ui::ColorProvider provider;
+    AddSteddingColorMixer(&provider, key);
+    provider.GenerateColorMapForTesting();
+    return std::pair(provider.GetColor(ui::kColorFrameActive),
+                     provider.GetColor(kColorTabBackgroundActiveFrameActive));
+  };
+  stedding::WindowLook look;
+  {
+    SCOPED_TRACE("Stedding's own");
+    EXPECT_EQ(SkColorSetRGB(0x21, 0x26, 0x3A), paint(look, true, false).first);
+    EXPECT_EQ(SkColorSetRGB(0xCB, 0xD5, 0xE1), paint(look, false, false).first);
+  }
+  {
+    SCOPED_TRACE("Neutral grey");
+    look.colour = stedding::WindowColour::kNeutral;
+    for (const bool dark : {true, false}) {
+      const SkColor ground = paint(look, dark, false).first;
+      EXPECT_EQ(SkColorGetR(ground), SkColorGetG(ground));
+      EXPECT_EQ(SkColorGetG(ground), SkColorGetB(ground)) << "a hue";
+      EXPECT_EQ(dark, color_utils::IsDark(ground));
+    }
+  }
+  {
+    SCOPED_TRACE("Custom, and kept readable");
+    look.colour = stedding::WindowColour::kCustom;
+    look.custom_dark = 0x1E3A5F;
+    look.custom_light = 0xDDEEFF;
+    EXPECT_EQ(SkColorSetRGB(0x1E, 0x3A, 0x5F), paint(look, true, false).first);
+    EXPECT_EQ(SkColorSetRGB(0xDD, 0xEE, 0xFF), paint(look, false, false).first);
+    // White picked for the dark look, black for the light one.
+    look.custom_dark = 0xFFFFFF;
+    look.custom_light = 0x000000;
+    color_utils::HSL hsl;
+    color_utils::SkColorToHSL(paint(look, true, false).first, &hsl);
+    EXPECT_LE(hsl.l, 0.29) << "too light for the dark look";
+    color_utils::SkColorToHSL(paint(look, false, false).first, &hsl);
+    EXPECT_GE(hsl.l, 0.69) << "too dark for the light look";
+  }
+  {
+    SCOPED_TRACE("the Space's tint by its strength");
+    look = stedding::WindowLook();
+    const SkColor plain = paint(look, true, false).first;
+    look.space_tint = stedding::LookStrength::kNone;
+    EXPECT_EQ(plain, paint(look, true, true).first) << "None tints nothing";
+    // Each step takes the ground further toward the Space's red.
+    int last_red = static_cast<int>(SkColorGetR(plain));
+    for (const stedding::LookStrength strength :
+         {stedding::LookStrength::kSubtle, stedding::LookStrength::kNormal,
+          stedding::LookStrength::kStrong}) {
+      look.space_tint = strength;
+      const int red =
+          static_cast<int>(SkColorGetR(paint(look, true, true).first));
+      EXPECT_GT(red, last_red) << static_cast<int>(strength);
+      last_red = red;
+    }
+  }
+  {
+    SCOPED_TRACE("the highlight by its strength");
+    look = stedding::WindowLook();
+    int last_alpha = 0;
+    for (const stedding::LookStrength strength :
+         {stedding::LookStrength::kSubtle, stedding::LookStrength::kNormal,
+          stedding::LookStrength::kStrong}) {
+      look.tab_highlight = strength;
+      const int alpha =
+          static_cast<int>(SkColorGetA(paint(look, true, false).second));
+      EXPECT_GT(alpha, last_alpha) << static_cast<int>(strength);
+      last_alpha = alpha;
+    }
+    EXPECT_EQ(0x24u, SkColorGetA([&] {
+                look.tab_highlight = stedding::LookStrength::kNormal;
+                return paint(look, true, false).second;
+              }()))
+        << "Normal is the row as it was";
+    look.tab_highlight = stedding::LookStrength::kSubtle;
+    EXPECT_LT(SkColorGetA(paint(look, false, false).second), 0xFFu)
+        << "Subtle lets the light ground through the white card";
+  }
+  stedding::SetWindowLook(saved);
+}
