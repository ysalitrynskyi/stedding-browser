+TEST_F(SpaceWindowTest, SecondWindowSeesTheSameSpaces) {
+  ASSERT_TRUE(model().follows_registry());
+  Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  std::unique_ptr<Browser> second =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  SpaceModel* const other = SpaceModel::From(second.get());
+  ASSERT_TRUE(other);
+  ASSERT_EQ(2u, other->size());
+  EXPECT_EQ(model().spaces()[0]->id(), other->spaces()[0]->id());
+  EXPECT_EQ(work->id(), other->spaces()[1]->id());
+  EXPECT_EQ("Work", other->GetSpace(work->id())->name());
+
+  other->SetSpaceName(work->id(), "Office");
+  EXPECT_EQ("Office", work->name()) << "renamed in one, renamed in all";
+  Space* const play = other->AddSpace("Play", SK_ColorGREEN);
+  ASSERT_EQ(3u, model().size());
+  EXPECT_EQ("Play", model().GetSpace(play->id())->name());
+  EXPECT_TRUE(model().MoveSpace(play->id(), -2));
+  EXPECT_EQ(play->id(), other->spaces()[0]->id()) << "the order is shared";
+  second->tab_strip_model()->CloseAllTabs();
