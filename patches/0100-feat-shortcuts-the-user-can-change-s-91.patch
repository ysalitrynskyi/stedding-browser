+
+// Z10: the chord is in Local State, so it is there after a restart.
+IN_PROC_BROWSER_TEST_F(ShortcutRebindTest, PRE_TheChordSurvivesARestart) {
+  ASSERT_EQ(shortcuts::CheckKind::kOk,
+            shortcuts::AddShortcut(LocalState(), Row("clear-space"), kFreeChord,
+                                   /*replace=*/false,
+                                   shortcuts::OutsideHolders())
+                .kind);
+}
