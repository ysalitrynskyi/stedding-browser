+  }
+  {
+    SCOPED_TRACE("the row hidden: no part of it is drawn");
+    ASSERT_TRUE(
+        chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+    views::test::RunScheduledLayout(view());
+    ASSERT_FALSE(view()->IsToolbarVisible());
+    gfx::RectF card(view()->multi_contents_view()->GetLocalBounds());
+    views::View::ConvertRectToTarget(view()->multi_contents_view(), view(),
