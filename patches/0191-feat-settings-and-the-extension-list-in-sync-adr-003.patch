+  const int64_t t = NowMs() - Days(1);
+  sb::State peer = PeerState(base::Token::CreateRandom().ToString(), {}, t);
+  while (peer.records.size() < sb::kMaxRecords) {
+    sb::Record removed(sb::Kind::kTab);
+    removed.del = sb::Stamp{t, kPeer};
+    peer.records[NewTabId()] = removed;
+  }
+  WritePeer(peer, 1);
+  Join(/*combine=*/false);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return service()->GetStatus().FindBool("ready").value_or(false);
+  }));
+  content::RunAllTasksUntilIdle();
+  ASSERT_GT(service()->ledger_for_testing()->state.records.size(),
+            sb::kMaxRecords);
+
+  Scan();
+  const int64_t written = service()->ledger_for_testing()->seq;
+  Scan();
+  Scan();
+  EXPECT_EQ(written, service()->ledger_for_testing()->seq)
+      << "the file was written again at each read of the folder";
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    EXPECT_FALSE(base::PathExists(OwnFile()))
+        << "a file no computer reads was written";
+  }
+  EXPECT_EQ("tooLarge", Problem());
+}
