 #include <vector>
 
 #include "base/memory/raw_ptr.h"
@@ -46,6 +47,25 @@ struct RegistryEntry {
   bool pins_collapsed = false;
 };
 
+// sessions S37 (ADR 0032): a session as the profile has it. `id` is the jar's
+// token, the storage-partition name, so `spaces` are the entries that hold
+// that token as their `profile_id`, in the list's order, each with its session
+// on or off. `name` is what the list `stedding.spaces.sessions` calls it, else
+// the name of the Space that holds it. `spaces` is empty for a session no Space
+// uses any more (S43).
+struct SessionEntry {
+  SessionEntry();
+  SessionEntry(const SessionEntry& other);
+  SessionEntry& operator=(const SessionEntry& other);
+  ~SessionEntry();
+
+  std::string id;
+  std::string name;
+  // Whether the list has a row for it: its name is its own, chosen once.
+  bool has_row = false;
+  std::vector<SpaceId> spaces;
+};
+
 // The profile's Space list -- order, names, icons, colours -- which every
 // window's SpaceModel mirrors (docs/features/windows.md G1, G3). Kept in
 // the preference stedding.spaces.registry, written on every change.
@@ -102,6 +122,31 @@ class SpaceRegistry : public KeyedService {
   // A registry with no PrefService (a Blank Window's) is never written.
   bool persists() const { return prefs_ != nullptr; }
 
+  // sessions S37 (ADR 0032). Every session the profile has: those Spaces
+  // hold, in the order of the first Space that holds each, then those no Space
+  // uses (S43).
+  std::vector<SessionEntry> Sessions() const;
+  // The session with this id, if any Space or row knows it.
+  std::optional<SessionEntry> FindSession(std::string_view id) const;
+  // Whether a Space holds `jar`, its session on or off (S41).
+  bool NamesJar(std::string_view jar) const;
+  // Whether a Space other than `except` holds `jar`.
+  bool ANameOtherThan(const SpaceId& except, std::string_view jar) const;
+  // Whether the sessions list has a row for `id` (S44).
+  bool HasSessionRow(std::string_view id) const;
+  // Makes a session with a new jar and a row, under `name` made fit for the
+  // list (S37), and returns its id. No Space is in it yet.
+  std::string AddSession(std::string_view name);
+  // Gives `id` a row called `name`, for a session that came from elsewhere
+  // (S50, S51). A row it has keeps its name: a name is chosen once.
+  void EnsureSessionRow(const std::string& id, std::string_view name);
+  // Drops the row of `id`, whose jar is being wiped (S41, S45).
+  void ForgetSession(std::string_view id);
+  // Puts Space `id` in `session`, and turns its session on. Empty is Shared,
+  // which keeps the token (S7). The name a joined session has then is written
+  // down (S37), and so is the name of a session its last Space leaves (S43).
+  void SetSession(const SpaceId& id, const std::string& session);
+
   void AddObserver(Observer* observer);
   void RemoveObserver(Observer* observer);
 
@@ -115,11 +160,26 @@ class SpaceRegistry : public KeyedService {
   static std::vector<RegistryEntry> FromValue(const base::ListValue& value);
 
  private:
+  // sessions S37: one row of `stedding.spaces.sessions`.
+  struct SessionRow {
+    std::string id;
+    std::string name;
+  };
+
   RegistryEntry* FindMutable(const SpaceId& id);
   void Changed();
+  // The name a session has now: its row's, else its first Space's as the
+  // sidebar shows it.
+  std::string SessionNameOf(std::string_view id) const;
+  // `name` as the sessions list keeps it for session `id`: one line, not too
+  // long, and no other session's (S37).
+  std::string FitSessionName(std::string_view id, std::string_view name) const;
+  void AddSessionRow(std::string id, std::string name);
+  void WriteSessions();
 
   const raw_ptr<PrefService> prefs_;
   std::vector<RegistryEntry> entries_;
+  std::vector<SessionRow> session_rows_;
   base::ObserverList<Observer> observers_;
 };
 
