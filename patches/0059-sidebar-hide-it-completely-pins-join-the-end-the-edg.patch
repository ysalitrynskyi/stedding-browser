+
+int VerticalTabStripRegionView::CollapsedWidthNow() const {
+  if (!base::FeatureList::IsEnabled(stedding::kArcStyleWindow) ||
+      !browser_view() || !browser_view()->browser() ||
+      !state_controller_->ShouldDisplayVerticalTabs()) {
+    return kCollapsedWidth;
+  }
+  return browser_view()->browser()->GetProfile()->GetPrefs()->GetInteger(
+             stedding::prefs::kSidebarClosedForm) ==
+                 stedding::prefs::kSidebarClosedHidden
+             ? 0
+             : kCollapsedWidth;
+}
+
+// static
+int VerticalTabStripRegionView::SteddingCardGutter(
+    const BrowserView* browser_view) {
+  if (browser_view) {
+    const VerticalTabStripRegionView* const strip = StripOf(browser_view);
+    // A page in a full screen of its own -- a video's button, the Fullscreen
+    // API -- takes the screen edge to edge too: the card's gutters left a
+    // band of the window's ground on three sides of it (BACKLOG S-69). So
+    // does a full screen with neither the address row nor a sidebar drawn:
+    // F11 on Windows hides both, and the gutters and the rounded corners
+    // stayed around the page on four sides (real use, 2026-10-10). macOS's
+    // full screen keeps the sidebar, and its gutters with it, whether or not
+    // the row shows.
+    const bool strip_drawn = strip && strip->GetVisible() && strip->width() > 0;
+    if (browser_view->GetWidget() && browser_view->GetWidget()->IsFullscreen() &&
+        !browser_view->IsToolbarVisible() && !strip_drawn) {
+      return 0;
+    }
+    // The lookup takes a mutable window; nothing here changes it.
+    if (BrowserWindowInterface* const browser =
+            const_cast<BrowserView*>(browser_view)->browser()) {
+      ExclusiveAccessManager* const access =
+          ExclusiveAccessManager::From(browser);
+      if (access && access->fullscreen_controller()->IsTabFullscreen()) {
+        return 0;
+      }
+    }
+    if (strip && strip->IsHiddenCompletely()) {
+      return 0;
+    }
+  }
+  return stedding::kCardGutter.Get();
+}
+
+// static
+const VerticalTabStripRegionView* VerticalTabStripRegionView::StripOf(
+    const BrowserView* browser_view) {
+  if (browser_view) {
+    for (const views::View* const child : browser_view->children()) {
+      if (const auto* const strip =
+              views::AsViewClass<VerticalTabStripRegionView>(child)) {
+        return strip;
+      }
+    }
+  }
+  return nullptr;
+}
+
+// static
+int VerticalTabStripRegionView::ClosedWidthOf(const BrowserView* browser_view) {
+  const VerticalTabStripRegionView* const strip = StripOf(browser_view);
+  return strip ? strip->CollapsedWidthNow() : kCollapsedWidth;
+}
+
+bool VerticalTabStripRegionView::DoesIntersectRect(
+    const views::View* target,
+    const gfx::Rect& rect) const {
+  gfx::Rect bounds = target->GetLocalBounds();
+  // sidebar Y18: the edge a person reads as the sidebar's is the page
+  // card's, past the gutter, so the handle reaches to it: a press on that
+  // edge resizes. It stopped at the strip's own edge until 2026-10-10, so
+  // the cursor changed only a few DIP short of the card (operator). Local
+  // coordinates are physical, left to right on screen: the card is on the
+  // strip's right, or on its left in a right-to-left layout.
+  if ((target == this || target == resize_area_) &&
+      resize_area_->GetVisible()) {
+    const int reach = ResizeHandleReach();
+    if (base::i18n::IsRTL()) {
+      bounds.set_x(bounds.x() - reach);
+    }
+    bounds.set_width(bounds.width() + reach);
+  }
+  return bounds.Intersects(rect);
+}
+
+int VerticalTabStripRegionView::ResizeHandleReach() const {
+  return SteddingCardGutter(browser_view());
+}
+
+void VerticalTabStripRegionView::OnClosedFormChanged() {
+  // An open strip is the same in either form; a closed one takes the new
+  // form's width, and the page card its gutters (sidebar Y19).
+  leading_edge_timer_.Stop();
+  if (state_controller_->IsCollapsed() && is_expanded_on_hover_) {
+    AnimateExpandOnHover(/*expand=*/false);
+  }
+  resize_area_->SetVisible(
+      (!state_controller_->IsCollapsed() ||
+       !state_controller_->IsExpandOnHoverEnabled()) &&
+      !IsHiddenCompletely());
+  PreferredSizeChanged();
+  if (browser_view()) {
+    browser_view()->InvalidateLayout();
+    if (views::View* const contents = browser_view()->multi_contents_view()) {
+      contents->InvalidateLayout();
+    }
+    browser_view()->SchedulePaint();
+  }
+}
+
+bool VerticalTabStripRegionView::CanRevealFromLeadingEdge() const {
+  // Only a hidden sidebar the window shows: in F11 or a page's own full
+  // screen the strip is not drawn at all, and a reveal there left it open
+  // over the page once full screen ended, with no exit to close it.
+  // OnWindowPointerMoved still requires the frame to paint active.
+  // OnPointerAtForTesting sets `reveal_without_pointer_for_testing_` first
+  // and skips that, the way it already skips the real cursor.
+  return IsHiddenCompletely() && !is_expanded_on_hover_ && browser_view() &&
+         GetVisible() && browser_view()->GetVisible() &&
+         (reveal_without_pointer_for_testing_ || IsFrameActive()) &&
+         force_collapse_lock_count_ == 0 && keep_current_state_lock_count_ == 0;
+}
+
+bool VerticalTabStripRegionView::IsAtLeadingEdge(gfx::Point point) const {
+  // `point` is in the browser view's coordinates, which are physical: the
+  // sidebar's edge is the left one, or the right one in a right-to-left
+  // layout.
+  const int width = browser_view()->width();
+  const bool across = base::i18n::IsRTL()
+                          ? point.x() >= width - kLeadingEdgeWidth &&
+                                point.x() < width
+                          : point.x() >= 0 && point.x() < kLeadingEdgeWidth;
+  return across && point.y() >= 0 && point.y() < browser_view()->height();
+}
+
+bool VerticalTabStripRegionView::IsPointerAtLeadingEdge() const {
+  gfx::Point point = display::Screen::Get()->GetCursorScreenPoint();
+  views::View::ConvertPointFromScreen(browser_view(), &point);
+  return IsAtLeadingEdge(point);
+}
+
+void VerticalTabStripRegionView::OnWindowPointerMoved() {
+  if (!CanRevealFromLeadingEdge() || !IsPointerAtLeadingEdge()) {
+    leading_edge_timer_.Stop();
+    return;
+  }
+  if (!leading_edge_timer_.IsRunning()) {
+    leading_edge_timer_.Start(
+        FROM_HERE, kLeadingEdgeRevealDelay,
+        base::BindOnce(&VerticalTabStripRegionView::RevealFromLeadingEdge,
+                       base::Unretained(this)));
+  }
+}
+
+void VerticalTabStripRegionView::RevealFromLeadingEdge() {
+  // Where the pointer is now: only its moves inside the window are heard, so
+  // one that crossed the edge on its way out -- into the next window, or
+  // off the screen -- would otherwise open the sidebar behind it.
+  if (!CanRevealFromLeadingEdge() ||
+      (!reveal_without_pointer_for_testing_ && !IsPointerAtLeadingEdge())) {
+    return;
+  }
+  AnimateExpandOnHover(/*expand=*/true);
+}
+
+void VerticalTabStripRegionView::OnPointerAtForTesting(gfx::Point point) {
+  // Set before either check. CanRevealFromLeadingEdge and
+  // RevealFromLeadingEdge both read the flag: the point stands in for the
+  // cursor, and the frame need not paint active.
+  reveal_without_pointer_for_testing_ = true;
+  if (!CanRevealFromLeadingEdge() || !IsAtLeadingEdge(point)) {
+    leading_edge_timer_.Stop();
+    reveal_without_pointer_for_testing_ = false;
+    return;
+  }
+  RevealFromLeadingEdge();
+  reveal_without_pointer_for_testing_ = false;
+}
