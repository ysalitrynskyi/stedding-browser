+  // it is with the row hidden, as it does under a hidden sidebar sliding in
+  // (sidebar Y19); the row lies over it, sliding down from above the
+  // window's top. Two passes: everything but the row as with the row hidden,
+  // the row as with it shown. The second pass is the one the row's own
+  // measures (row_reserve_ and the rest) come from.
+  BrowserView* const browser_view =
+      views::AsViewClass<BrowserView>(views().browser_view.get());
+  const stedding::TopRowReveal* const reveal =
+      browser_view ? browser_view->stedding_top_row_reveal() : nullptr;
+  stedding::AddressRow* const row =
+      browser_view ? stedding::AddressRow::From(browser_view->browser())
+                   : nullptr;
+  views::View* const top_container = views().top_container;
+  if (!reveal || !row || !top_container ||
+      top_container->parent() != views().browser_view ||
+      !reveal->OverPage() || !delegate().IsToolbarVisible()) {
+    return CalculateLayoutOnce(params);
+  }
+  ProposedLayout under;
+  {
+    const stedding::AddressRow::ScopedLaidOutHidden hidden(*row);
+    under = CalculateLayoutOnce(params);
+  }
+  // The strip beside the row is laid out as with the row hidden, its top
+  // row too: the second pass gives it the toolbar's height read through the
+  // top container's place in the slide's last frame, and on Windows the
+  // rail's toggle and rows jumped 4 DIP up while the row slid, easing back
+  // at its end. A hidden sidebar slid in keeps the height the second pass
+  // gives it, the row's own, which does not move with the slide (sidebar
+  // Y20, CalculateLayoutOnce).
+  VerticalTabStripRegionView* const strip =
+      views().vertical_tab_strip_region_view;
+  const std::optional<int> strip_toolbar_height =
+      strip && !strip->IsHiddenCompletely()
+          ? std::optional<int>(strip->GetToolbarHeightForLayout())
+          : std::nullopt;
+  ProposedLayout layout = CalculateLayoutOnce(params);
+  for (auto& [view, child] : under.children) {
+    if (view == top_container) {
+      continue;
+    }
+    layout.children[view] = std::move(child);
+  }
+  const auto row_layout = layout.children.find(top_container);
+  if (row_layout != layout.children.end()) {
+    gfx::Rect& bounds = row_layout->second.bounds;
+    bounds.Offset(0, -base::ClampRound(std::max(0, bounds.bottom()) *
+                                       (1.0 - reveal->Shown())));
+  }
+  if (strip_toolbar_height) {
+    strip->SetToolbarHeightForLayout(*strip_toolbar_height);
+  }
+  return layout;
+}
