+// Inserts `nodes` into `space`: loose tabs, and folders with their tabs, in
+// order. Returns the loose tabs, for the pinned run.
+std::vector<tabs::TabInterface*> InsertNodes(
+    ApplyContext& ctx,
+    const std::vector<Node>& nodes,
+    const SpaceId& space,
+    tabs::FolderTabCollection* parent_folder) {
+  std::vector<tabs::TabInterface*> loose;
+  for (const Node& node : nodes) {
+    if (ctx.ids->Contains(node.arc_id)) {
+      ++ctx.result->skipped;
+      continue;
+    }
+    if (node.kind == Node::Kind::kTab) {
+      tabs::TabInterface* const tab =
+          InsertUnloaded(ctx.tabs, ctx.profile, node);
+      if (!tab) {
+        continue;
+      }
+      ctx.model->SetSpaceForTab(tab, space);
+      ctx.ids->Add(node.arc_id);
+      ++ctx.result->tabs;
+      if (parent_folder) {
+        const int index = ctx.tabs->GetIndexOfTab(tab);
+        if (index != TabStripModel::kNoTab) {
+          ctx.tabs->MoveTabsToFolder({index}, parent_folder);
+        }
+      } else {
+        loose.push_back(tab);
+      }
+      continue;
+    }
+    // A folder: its direct tabs first, then the folder around them, then the
+    // folders inside it.
+    std::vector<int> indices;
+    std::vector<const Node*> subfolders;
+    for (const Node& child : node.children) {
+      if (child.kind == Node::Kind::kFolder) {
+        subfolders.push_back(&child);
+        continue;
+      }
+      if (ctx.ids->Contains(child.arc_id)) {
+        ++ctx.result->skipped;
+        continue;
+      }
+      tabs::TabInterface* const tab =
+          InsertUnloaded(ctx.tabs, ctx.profile, child);
+      if (!tab) {
+        continue;
+      }
+      ctx.model->SetSpaceForTab(tab, space);
+      ctx.ids->Add(child.arc_id);
+      ++ctx.result->tabs;
+      indices.push_back(ctx.tabs->GetIndexOfTab(tab));
+    }
+    tabs::FolderTabCollection* folder = nullptr;
+    if (!indices.empty()) {
+      std::ranges::sort(indices);
+      folder = ctx.tabs->AddToNewFolder(indices, parent_folder);
+      if (folder) {
+        folder->SetTitle(base::UTF16ToUTF8(node.title));
+        ctx.ids->Add(node.arc_id);
+        ++ctx.result->folders;
+      }
+    }
+    // A folder with no tab of its own cannot be made; its folders come out
+    // beside it.
+    for (const Node* sub : subfolders) {
+      InsertNodes(ctx, {*sub}, space, folder ? folder : parent_folder);
+    }
+  }
+  return loose;
+}
+
+}  // namespace
+
+size_t ArcImportPlan::pinned_tab_count() const {
+  size_t tabs = 0;
+  size_t folders = 0;
+  for (const Space& space : spaces) {
+    CountNodes(space.pinned, &tabs, &folders);
+  }
+  return tabs;
+}
+
+size_t ArcImportPlan::unpinned_tab_count() const {
+  size_t tabs = 0;
+  size_t folders = 0;
+  for (const Space& space : spaces) {
+    CountNodes(space.unpinned, &tabs, &folders);
+  }
+  return tabs;
+}
+
+size_t ArcImportPlan::folder_count() const {
+  size_t tabs = 0;
+  size_t folders = 0;
+  for (const Space& space : spaces) {
+    CountNodes(space.pinned, &tabs, &folders);
+    CountNodes(space.unpinned, &tabs, &folders);
+  }
+  return folders;
+}
+
+std::vector<std::string> ArcImportPlan::dropped_profiles() const {
+  std::vector<std::string> out;
+  for (const Space& space : spaces) {
+    if (!space.profile.empty() &&
+        std::ranges::find(out, space.profile) == out.end()) {
+      out.push_back(space.profile);
+    }
+  }
+  return out;
+}
+
+std::optional<ArcImportPlan> ParseArcSidebar(std::string_view json) {
+  const std::optional<base::Value> root =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!root || !root->is_dict()) {
+    return std::nullopt;
+  }
+  const base::ListValue* containers =
+      root->GetDict().FindListByDottedPath("sidebar.containers");
+  if (!containers) {
+    return std::nullopt;
+  }
+  const base::DictValue* sidebar = nullptr;
+  for (const base::Value& container : *containers) {
+    const base::DictValue* dict = container.GetIfDict();
+    if (dict && dict->FindList("spaces") && dict->FindList("items")) {
+      sidebar = dict;
+      break;
+    }
+  }
+  if (!sidebar) {
+    return std::nullopt;
+  }
+
+  std::map<std::string, ArcItem> items;
+  for (const base::DictValue* dict : DictsOf(sidebar->FindList("items"))) {
+    if (std::optional<ArcItem> item = ParseItem(*dict)) {
+      items.emplace(item->id, std::move(*item));
+    }
+  }
+
+  ArcImportPlan plan;
+  for (const base::DictValue* dict : DictsOf(sidebar->FindList("spaces"))) {
+    ArcImportPlan::Space space;
+    space.arc_id = StringAt(*dict, "id");
+    space.title = StringAt(*dict, "title");
+    if (space.arc_id.empty()) {
+      continue;
+    }
+    if (const base::DictValue* icon =
+            dict->FindDictByDottedPath("customInfo.iconType")) {
+      space.emoji = StringAt(*icon, "emoji_v2");
+      if (space.emoji.empty()) {
+        space.emoji = StringAt(*icon, "emoji");
+      }
+    }
+    space.color = ThemeColor(*dict);
+    if (const base::Value* profile = dict->Find("profile")) {
+      const base::DictValue* bound = profile->GetIfDict();
+      if (bound && !bound->contains("default")) {
+        const std::string name = FirstString(*profile);
+        space.profile = name.empty() ? std::string("custom") : name;
+      }
+    }
+    // The pinned and unpinned containers: a word, then the id it names.
+    if (const base::ListValue* container_ids = dict->FindList("containerIDs")) {
+      std::string which;
+      for (const base::Value& entry : *container_ids) {
+        if (!entry.is_string()) {
+          continue;
+        }
+        const std::string& text = entry.GetString();
+        if (text == "pinned" || text == "unpinned") {
+          which = text;
+          continue;
+        }
+        const auto it = items.find(text);
+        if (it == items.end() || which.empty()) {
+          continue;
+        }
+        std::vector<Node> nodes = BuildChildren(it->second, items, 0);
+        if (which == "pinned") {
+          space.pinned = std::move(nodes);
+        } else {
+          space.unpinned = std::move(nodes);
+        }
+        which.clear();
+      }
+    }
+    plan.spaces.push_back(std::move(space));
+  }
+
+  // The essentials: the top-apps containers, tabs only. Arc names the same
+  // container twice ({default: id} and id): once is enough.
+  std::set<std::string> top_seen;
+  if (const base::ListValue* top = sidebar->FindList("topAppsContainerIDs")) {
+    for (const base::Value& entry : *top) {
+      std::string id;
+      if (entry.is_string()) {
+        id = entry.GetString();
+      } else if (const base::DictValue* dict = entry.GetIfDict()) {
+        id = FirstString(*dict);
+      }
+      const auto it = items.find(id);
+      if (it == items.end() || !top_seen.insert(id).second) {
+        continue;
+      }
+      for (Node& node : BuildChildren(it->second, items, 0)) {
+        if (node.kind == Node::Kind::kTab) {
+          plan.essentials.push_back(std::move(node));
+        }
+      }
+    }
+  }
+  return plan;
+}
+
+std::u16string SummariseArcImport(const ArcImportPlan& plan) {
+  const auto count = [](size_t n, std::u16string_view one,
+                        std::u16string_view many) {
+    return base::StrCat({base::NumberToString16(n), u" ", n == 1 ? one : many});
+  };
+  std::u16string text = base::StrCat(
+      {count(plan.spaces.size(), u"Space", u"Spaces"), u", ",
+       count(plan.pinned_tab_count(), u"pinned tab", u"pinned tabs"), u", ",
+       count(plan.folder_count(), u"folder", u"folders"), u", ",
+       count(plan.unpinned_tab_count(), u"tab", u"tabs")});
+  if (!plan.essentials.empty()) {
+    text += base::StrCat({u" \u00B7 ", count(plan.essentials.size(),
+                                             u"essential", u"essentials")});
+    if (plan.essentials.size() > kMaxEssentials) {
+      text +=
+          base::StrCat({u" (the first ", base::NumberToString16(kMaxEssentials),
+                        u" become essentials)"});
+    }
+  }
+  const std::vector<std::string> profiles = plan.dropped_profiles();
+  if (!profiles.empty()) {
+    text += u" \u00B7 Arc's per-Space profiles are not carried over: ";
+    for (size_t i = 0; i < profiles.size(); ++i) {
+      text += base::StrCat({i ? u", " : u"", base::UTF8ToUTF16(profiles[i])});
+    }
+  }
+  return text;
+}
+
+base::FilePath ArcSidebarPath() {
+  base::FilePath home;
+  if (!base::PathService::Get(base::DIR_HOME, &home)) {
+    return base::FilePath();
+  }
+  return home.Append("Library")
+      .Append("Application Support")
+      .Append("Arc")
+      .Append("StorableSidebar.json");
+}
+
+std::optional<std::string> ReadArcSidebar(const base::FilePath& path) {
+  if (path.empty() || !base::PathExists(path)) {
+    return std::nullopt;
+  }
+  // A copy first: Arc rewrites the file while it runs (I9), and a read of
+  // the copy sees one version.
+  base::ScopedTempDir temp;
+  base::FilePath copy;
+  if (temp.CreateUniqueTempDir()) {
+    copy = temp.GetPath().Append("StorableSidebar.json");
+    if (!base::CopyFile(path, copy)) {
+      copy.clear();
+    }
+  }
+  std::string json;
+  if (!base::ReadFileToString(copy.empty() ? path : copy, &json)) {
+    return std::nullopt;
+  }
+  return json;
+}
+
+bool IsArcRunning() {
+  return base::GetProcessCount(FILE_PATH_LITERAL("Arc"), nullptr) > 0;
+}
+
+SkColor NearestSpaceColor(SkColor arc_color) {
+  SkColor nearest = kSpaceColors.front().color;
+  int best = -1;
+  for (const SpaceColorChoice& choice : kSpaceColors) {
+    const int dr = static_cast<int>(SkColorGetR(choice.color)) -
+                   static_cast<int>(SkColorGetR(arc_color));
+    const int dg = static_cast<int>(SkColorGetG(choice.color)) -
+                   static_cast<int>(SkColorGetG(arc_color));
+    const int db = static_cast<int>(SkColorGetB(choice.color)) -
+                   static_cast<int>(SkColorGetB(arc_color));
+    const int distance = dr * dr + dg * dg + db * db;
+    if (best < 0 || distance < best) {
+      best = distance;
+      nearest = choice.color;
+    }
+  }
+  return nearest;
+}
+
+ArcImportResult ApplyArcImport(BrowserWindowInterface* browser,
+                               const ArcImportPlan& plan,
+                               const ArcImportOptions& options) {
+  ArcImportResult result;
+  SpaceModel* const model = browser ? SpaceModel::From(browser) : nullptr;
+  TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
+  Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  if (!model || !tabs || !profile) {
+    return result;
+  }
+  ImportedIds ids(profile->GetPrefs());
+  ApplyContext ctx{browser, model, tabs, profile, &ids, &result};
+  // Every tab here knows its Space; no route moves it (routing D2).
+  SpaceModel::ScopedRoutingPause no_routing(model);
+
+  // The essentials row first; it is in every Space (I11 caps it).
+  if (options.pinned) {
+    size_t pinned_now = static_cast<size_t>(tabs->IndexOfFirstNonPinnedTab());
+    for (const Node& node : plan.essentials) {
+      if (ids.Contains(node.arc_id)) {
+        ++result.skipped;
+        continue;
+      }
+      if (pinned_now >= kMaxEssentials) {
+        break;
+      }
+      tabs::TabInterface* const tab = InsertUnloaded(tabs, profile, node);
+      if (!tab) {
+        continue;
+      }
+      tabs->SetTabPinned(tabs->GetIndexOfTab(tab), true);
+      ids.Add(node.arc_id);
+      ++result.essentials;
+      ++pinned_now;
+    }
+  }
+
+  if (options.spaces) {
+    bool default_taken = false;
+    for (size_t i = 0; i < plan.spaces.size(); ++i) {
+      const ArcImportPlan::Space& arc_space = plan.spaces[i];
+      Space* space = nullptr;
+      if (const std::optional<SpaceId> known = ids.SpaceFor(arc_space.arc_id)) {
+        space = model->GetSpace(*known);
+      }
+      if (!space) {
+        // A lone unnamed default Space is the first Space's to take.
+        if (!default_taken && model->size() == 1 &&
+            model->spaces().front()->name().empty()) {
+          space = model->spaces().front().get();
+          model->SetSpaceName(space->id(), arc_space.title);
+          default_taken = true;
+        } else {
+          space = model->AddSpace(
+              arc_space.title,
+              arc_space.color.value_or(
+                  kSpaceColors.at(model->size() % kSpaceColors.size()).color));
+        }
+        if (!arc_space.emoji.empty()) {
+          model->SetSpaceIcon(space->id(), arc_space.emoji);
+        }
+        if (arc_space.color) {
+          model->SetSpaceColor(space->id(), *arc_space.color);
+        }
+        ids.Add(arc_space.arc_id);
+        ids.RememberSpace(arc_space.arc_id, space->id());
+        ++result.spaces;
+      } else {
+        ++result.skipped;
+      }
+      const SpaceId id = space->id();
+      if (options.pinned) {
+        // The loose tabs of the pinned run are Space-pinned last to first,
+        // since a pin moves its tab to the top of the run.
+        std::vector<tabs::TabInterface*> loose =
+            InsertNodes(ctx, arc_space.pinned, id, nullptr);
+        for (auto it = loose.rbegin(); it != loose.rend(); ++it) {
+          model->SetSpacePinned(*it, true);
+        }
+      }
+      if (options.unpinned) {
+        InsertNodes(ctx, arc_space.unpinned, id, nullptr);
+      }
+    }
+  }
+  ids.Save();
+  return result;
+}
+
+namespace {
+
+ArcSidebarInfo LoadInfoOnPool() {
+  ArcSidebarInfo info;
+  const std::optional<std::string> json = ReadArcSidebar(ArcSidebarPath());
+  if (!json) {
+    return info;
+  }
+  info.plan = ParseArcSidebar(*json);
+  if (!info.plan) {
+    return info;
+  }
+  info.found = true;
+  info.arc_running = IsArcRunning();
+  info.summary = SummariseArcImport(*info.plan);
+  return info;
+}
+
+void ApplyRead(base::WeakPtr<BrowserWindowInterface> browser,
+               ArcImportOptions options,
+               ArcImportDoneCallback done,
+               std::optional<std::string> json) {
+  if (!browser || !json) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(*json);
+  if (!plan) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  std::move(done).Run(ApplyArcImport(browser.get(), *plan, options));
+}
+
+}  // namespace
+
+namespace {
+bool& ArcSidebarPresence() {
+  static bool present = false;
+  return present;
+}
+}  // namespace
+
+void PrimeArcSidebarPresence() {
+  static bool asked = false;
+  if (asked) {
+    return;
+  }
+  asked = true;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce([] { return base::PathExists(ArcSidebarPath()); }),
+      base::BindOnce([](bool exists) { ArcSidebarPresence() = exists; }));
+}
+
+bool ArcSidebarPresent() {
+  return ArcSidebarPresence();
+}
+
+void LoadArcSidebarInfo(ArcSidebarInfoCallback callback) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&LoadInfoOnPool), std::move(callback));
+}
+
+void ImportFromArcAsync(BrowserWindowInterface* browser,
+                        const ArcImportOptions& options,
+                        ArcImportDoneCallback done) {
+  if (!browser) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadArcSidebar, ArcSidebarPath()),
+      base::BindOnce(&ApplyRead, browser->GetWeakPtr(), options,
+                     std::move(done)));
+}
+
+std::u16string DescribeArcImportResult(const ArcImportResult& result) {
+  const auto count = [](size_t n, std::u16string_view one,
+                        std::u16string_view many) {
+    return base::StrCat({base::NumberToString16(n), u" ", n == 1 ? one : many});
+  };
+  std::u16string text =
+      base::StrCat({u"Imported ", count(result.spaces, u"Space", u"Spaces"),
+                    u", ", count(result.tabs, u"tab", u"tabs"), u", ",
+                    count(result.folders, u"folder", u"folders")});
+  if (result.essentials) {
+    text += base::StrCat(
+        {u", ", count(result.essentials, u"essential", u"essentials")});
+  }
+  if (result.skipped) {
+    text += base::StrCat({u" \u00B7 ", base::NumberToString16(result.skipped),
+                          u" already here"});
+  }
+  return text;
+}
+
+}  // namespace spaces
