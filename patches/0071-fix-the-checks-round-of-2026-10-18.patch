+// How far ahead of the system's wall clock base::Time::Now() reads while a
+// test stands in for a night asleep or a browser left closed. The monotonic
+// clock is left alone: in a Mac's sleep it stands still.
+base::TimeDelta g_wall_clock_ahead;
+
+base::Time WallClockAhead() {
+  return base::subtle::TimeNowIgnoringOverride() + g_wall_clock_ahead;
+}
+
+// Runs `archiver`'s sweep with the wall clock `ahead` of the system's, then
+// lets the closes it made finish.
+void SweepWithTheWallClockAhead(stedding::TabArchiver& archiver,
+                                base::TimeDelta ahead) {
+  g_wall_clock_ahead = ahead;
+  {
+    base::subtle::ScopedTimeClockOverrides wall_clock(
+        &WallClockAhead, /*time_ticks_override=*/nullptr,
+        /*thread_ticks_override=*/nullptr);
+    archiver.Sweep();
+  }
+  base::RunLoop().RunUntilIdle();
+}
