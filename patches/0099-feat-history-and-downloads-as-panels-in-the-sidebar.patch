+#ifndef CHROME_BROWSER_UI_WEBUI_STEDDING_LIBRARY_STEDDING_LIBRARY_UI_H_
+#define CHROME_BROWSER_UI_WEBUI_STEDDING_LIBRARY_STEDDING_LIBRARY_UI_H_
+
+#include <memory>
+
+#include "chrome/browser/ui/webui/downloads/downloads.mojom.h"
+#include "content/public/browser/webui_config.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "ui/webui/mojo_web_ui_controller.h"
+#include "ui/webui/resources/cr_components/history/history.mojom-forward.h"
+
+class BrowsingHistoryHandler;
+class DownloadsDOMHandler;
+
+namespace stedding {
+
+// docs/features/sidebar-panels.md: chrome://stedding-library, the page of
+// the sidebar's History and Downloads panels (/history, /downloads). It
+// reuses Chromium's own handlers for the data -- the History page's
+// (BrowsingHistoryHandler) and the Downloads page's (DownloadsDOMHandler) --
+// and adds the verbs they lack through LibraryHandler. Nothing it shows
+// comes from the network (Pn8).
+class LibraryUI : public ui::MojoWebUIController,
+                  public downloads::mojom::PageHandlerFactory {
+ public:
+  explicit LibraryUI(content::WebUI* web_ui);
+  LibraryUI(const LibraryUI&) = delete;
+  LibraryUI& operator=(const LibraryUI&) = delete;
+  ~LibraryUI() override;
+
+  // Bound through the browser's interface binders, as for chrome://history
+  // and chrome://downloads.
+  void BindInterface(
+      mojo::PendingReceiver<history::mojom::PageHandler> pending_page_handler);
+  void BindInterface(
+      mojo::PendingReceiver<downloads::mojom::PageHandlerFactory> receiver);
+
+ private:
+  // downloads::mojom::PageHandlerFactory:
+  void CreatePageHandler(
+      mojo::PendingRemote<downloads::mojom::Page> page,
+      mojo::PendingReceiver<downloads::mojom::PageHandler> receiver) override;
+
+  std::unique_ptr<BrowsingHistoryHandler> history_handler_;
+  std::unique_ptr<DownloadsDOMHandler> downloads_handler_;
+  mojo::Receiver<downloads::mojom::PageHandlerFactory> downloads_factory_{
+      this};
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+class LibraryUIConfig : public content::DefaultWebUIConfig<LibraryUI> {
+ public:
+  LibraryUIConfig();
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_WEBUI_STEDDING_LIBRARY_STEDDING_LIBRARY_UI_H_
