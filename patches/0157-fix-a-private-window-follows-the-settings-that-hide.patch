+  // sees it; points are in the window's view, as drawn.
+  void CheckTheCornersStrip(int strip) {
+    views::Widget* const widget = browser_view()->GetWidget();
+    views::test::RunScheduledLayout(widget);
+    stedding::WindowCornerButtons* const corner =
+        browser_view()->stedding_corner_buttons_for_testing();
+    ASSERT_TRUE(corner && corner->wanted());
+    ui::test::EventGenerator generator(views::GetRootWindow(widget),
+                                       widget->GetNativeWindow());
+    const auto move_to = [&](gfx::Point point) {
+      views::View::ConvertPointToScreen(browser_view(), &point);
+      generator.MoveMouseTo(point);
+      base::RunLoop().RunUntilIdle();
+    };
+    views::View* const web_view = browser_view()->GetActiveContentsWebView();
+    gfx::Point page_origin;
+    views::View::ConvertPointToTarget(web_view, browser_view(), &page_origin);
+    const gfx::Rect page(page_origin, web_view->size());
+    const gfx::Rect bounds = corner->GetMirroredBounds();
+    const int x = bounds.CenterPoint().x();
+    // Beside the corner, toward the page: the left of it, or its right in a
+    // right-to-left window, whose corner is at the top left.
+    const int beside =
+        base::i18n::IsRTL() ? bounds.right() + 3 : bounds.x() - 3;
+    ASSERT_GT(strip, 0);
+    ASSERT_LT(strip, bounds.height());
+    ASSERT_TRUE(page.Contains(bounds.CenterPoint()))
+        << "the corner is not over the page: " << bounds.ToString()
+        << " and the page " << page.ToString();
+    if (strip > 5) {
+      EXPECT_GE(page.y(), strip) << "the strip is over the page";
+    }
+
+    move_to(page.CenterPoint());
+    ASSERT_FALSE(corner->GetVisible());
+    // The page's corner, under the strip, is the page's: a site's own
+    // controls there take the pointer. A DIP off each side of the strip's
+    // edge, which a fractional scale rounds through pixels.
+    move_to(gfx::Point(x, strip + 1));
+    EXPECT_FALSE(corner->GetVisible()) << "the row under the strip showed them";
+    move_to(bounds.CenterPoint());
+    EXPECT_FALSE(corner->GetVisible()) << "the page's corner showed them";
+
+    // The strip's last row shows them, and the pointer can go down onto
+    // them: they stay while it is anywhere on the corner.
+    move_to(gfx::Point(x, strip - 1));
+    ASSERT_TRUE(corner->GetVisible()) << "the strip did not show them";
+    views::test::RunScheduledLayout(widget);
+    gfx::Point on_close =
+        corner->buttons()->close()->GetLocalBounds().CenterPoint();
+    views::View::ConvertPointToTarget(corner->buttons()->close(),
+                                      browser_view(), &on_close);
+    ASSERT_GT(on_close.y(), strip + 1) << "Close is in the strip";
+    ASSERT_TRUE(page.Contains(on_close)) << "Close is not over the page";
+    move_to(on_close);
+    EXPECT_TRUE(corner->GetVisible()) << "they went under the pointer";
+    move_to(gfx::Point(
+        base::i18n::IsRTL() ? bounds.right() - 2 : bounds.x() + 1,
+        bounds.bottom() - 2));
+    EXPECT_TRUE(corner->GetVisible()) << "they went at the corner's far end";
+    // Off the corner onto the page they go, and do not come back from it.
+    move_to(gfx::Point(beside, bounds.CenterPoint().y()));
+    EXPECT_FALSE(corner->GetVisible()) << "they stayed off the corner";
+    move_to(on_close);
+    EXPECT_FALSE(corner->GetVisible()) << "the hidden Close showed them";
+
+    // The window's very top shows them, as far as the corner reaches; the
+    // top beside the corner does not.
+    move_to(gfx::Point(x, 0));
+    EXPECT_TRUE(corner->GetVisible()) << "the top edge did not show them";
+    move_to(gfx::Point(beside, 0));
+    EXPECT_FALSE(corner->GetVisible()) << "the top past the corner kept them";
+    move_to(gfx::Point(beside, 1));
+    EXPECT_FALSE(corner->GetVisible()) << "the top past the corner showed them";
+    move_to(page.CenterPoint());
+  }
