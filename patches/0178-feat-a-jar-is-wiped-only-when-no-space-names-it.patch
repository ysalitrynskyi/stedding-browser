+  PutCookie(profile(), ConfigFor(jar), url);
+  base::ListValue pending;
+  pending.Append(jar);
+  prefs->SetList(stedding::prefs::kPendingJarWipes, std::move(pending));
+
+  std::unique_ptr<BrowserWindowInterface> second =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return prefs->GetList(stedding::prefs::kPendingJarWipes).empty();
+  }));
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(WasWiped(ConfigFor(jar), url));
+  second->GetTabStripModel()->CloseAllTabs();
+}
