+// PeekOverlay -----------------------------------------------------------------
+
+// static
+PeekOverlay* PeekOverlay::ForSource(const tabs::TabInterface* source) {
+  if (!source) {
+    return nullptr;
+  }
+  for (const std::unique_ptr<PeekOverlay>& overlay : Overlays()) {
+    if (!overlay->destroying_ && overlay->source_.get() == source) {
+      return overlay.get();
+    }
+  }
+  return nullptr;
+}
+
+// static
+PeekOverlay* PeekOverlay::ForPage(const content::WebContents* page) {
+  if (!page) {
+    return nullptr;
+  }
+  for (const std::unique_ptr<PeekOverlay>& overlay : Overlays()) {
+    if (!overlay->destroying_ && overlay->page_.get() == page) {
+      return overlay.get();
+    }
+  }
+  return nullptr;
+}
+
+PeekOverlay::PeekOverlay(tabs::TabInterface* source,
+                         std::unique_ptr<content::WebContents> page)
+    : source_(source->GetWeakPtr()), page_(std::move(page)) {}
+
+PeekOverlay::~PeekOverlay() {
+  // Destroy() ran: the widget is gone, and the page with this, unless a
+  // promotion took it.
+  CHECK(!widget_);
+}
+
+bool PeekOverlay::Show() {
+  tabs::TabInterface* const source = source_.get();
+  if (!source || !source->GetTabFeatures() || !source->CanShowModalUI()) {
+    return false;
+  }
+  tabs::TabDialogManager* const manager =
+      source->GetTabFeatures()->tab_dialog_manager();
+  views::Widget* const host = manager ? manager->GetHostWidget() : nullptr;
+  if (!host) {
+    return false;
+  }
+
+  // The page as a tab's would be -- its passwords, autofill, permissions,
+  // extensions -- whose delegate the peek is until it closes or becomes a
+  // tab, when the window's tab features take over.
+  TabHelpers::AttachTabHelpers(page_.get());
+  page_->SetDelegate(this);
+  Observe(page_.get());
+
+  widget_delegate_ = std::make_unique<views::WidgetDelegate>();
+  auto view = std::make_unique<PeekOverlayView>(this, page_.get());
+  view_ = view.get();
+  widget_delegate_->SetInitiallyFocusedView(view_->web_view());
+  widget_delegate_->SetContentsView(std::move(view));
+
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+  params.delegate = widget_delegate_.get();
+  params.parent = host->GetNativeView();
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+  params.name = "SteddingPeek";
+  params.bounds = PageBoundsInScreen();
+  widget_ = std::make_unique<views::Widget>();
+  widget_->Init(std::move(params));
+  widget_->MakeCloseSynchronous(base::BindOnce(&PeekOverlay::OnWidgetClosed,
+                                               weak_factory_.GetWeakPtr()));
+
+  // The page's own dialogs -- alert(), "Leave site?", a site's sign-in
+  // sheet -- show over the peek.
+  page_->RemoveUserData(
+      javascript_dialogs::TabModalDialogManager::UserDataKey());
+  javascript_dialogs::TabModalDialogManager::CreateForWebContents(
+      page_.get(),
+      std::make_unique<DocumentPipDialogManagerDelegate>(widget_.get()));
+  web_modal::WebContentsModalDialogManager::CreateForWebContents(page_.get());
+  web_modal::WebContentsModalDialogManager::FromWebContents(page_.get())
+      ->SetDelegate(this);
+
+  // Scoped to the pinned tab: its page takes no input and wears the
+  // window's scrim while the peek is up, and the peek hides while another
+  // tab is on screen and comes back with its own.
+  auto dialog = std::make_unique<tabs::TabDialogManager::Params>();
+  dialog->disable_input = true;
+  dialog->close_on_navigate = true;
+  dialog->get_dialog_bounds = base::BindRepeating(
+      &PeekOverlay::PageBoundsInScreen, base::Unretained(this));
+  manager->ShowDialog(widget_.get(), std::move(dialog));
+  view_->UpdateSplit(CanSplit());
+  page_->Focus();
+  return true;
+}
+
+gfx::Rect PeekOverlay::PageBoundsInScreen() const {
+  tabs::TabInterface* const source = source_.get();
+  BrowserWindowInterface* const window =
+      source ? source->GetBrowserWindowInterface() : nullptr;
+  BrowserView* const browser_view =
+      window ? BrowserView::GetBrowserViewForBrowser(window) : nullptr;
+  if (!browser_view) {
+    return widget_ ? widget_->GetWindowBoundsInScreen() : gfx::Rect();
+  }
+  views::View* container =
+      browser_view->GetContentsContainerViewFor(source->GetContents());
+  if (!container) {
+    container = browser_view->GetActiveContentsContainerView();
+  }
+  return container ? container->GetBoundsInScreen()
+                   : browser_view->GetBoundsInScreen();
+}
+
+bool PeekOverlay::CanSplit() const {
+  return PeekSourceCanSplit(source_.get());
+}
+
+void PeekOverlay::Close() {
+  if (destroying_) {
+    return;
+  }
+  // P13: "Leave site?" first, when the page asks; Stay keeps the peek.
+  if (page_ && page_->NeedToFireBeforeUnloadOrUnloadEvents()) {
+    // Its answer comes to BeforeUnloadFired, which closes the peek on Leave.
+    closing_ = true;
+    page_->DispatchBeforeUnload(/*auto_cancel=*/false);
+    return;
+  }
+  Destroy();
+  Erase(this);
+}
+
+bool PeekOverlay::Promote(bool split) {
+  tabs::TabInterface* const source = source_.get();
+  if (destroying_ || !page_ || !source) {
+    return false;
+  }
+  // The page leaves only for a window that can take it: otherwise the peek
+  // stays, with its page.
+  if (!source->GetBrowserWindowInterface()) {
+    return false;
+  }
+  const bool pair = split && CanSplit();
+  std::unique_ptr<content::WebContents> page = std::move(page_);
+  // The page leaves the peek: its dialogs close, and the dialog manager
+  // that showed them over the peek goes; the window's tab features make the
+  // tab's own, and the window becomes its delegate.
+  if (auto* const modal =
+          web_modal::WebContentsModalDialogManager::FromWebContents(
+              page.get())) {
+    modal->CloseAllDialogs();
+    modal->SetDelegate(nullptr);
+  }
+  page->RemoveUserData(
+      javascript_dialogs::TabModalDialogManager::UserDataKey());
+  page->SetDelegate(nullptr);
+  Observe(nullptr);
+  view_->web_view()->SetWebContents(nullptr);
+  // The pinned tab takes input again before the page arrives beside it.
+  Destroy();
+  Erase(this);
+  return PromotePeekPage(source, std::move(page), pair);
+}
+
+void PeekOverlay::OnWidgetClosed(views::Widget::ClosedReason reason) {
+  // Closed from outside -- the tab closing, or navigating away -- the peek
+  // goes with its widget, and its page with it: a window closing at a quit
+  // may not run another task.
+  if (destroying_) {
+    return;
+  }
+  Destroy();
+  Erase(this);
+}
+
+void PeekOverlay::Destroy() {
+  if (destroying_) {
+    return;
+  }
+  destroying_ = true;
+  for (web_modal::ModalDialogHostObserver& observer : modal_observers_) {
+    observer.OnHostDestroying();
+  }
+  if (page_) {
+    if (auto* const modal =
+            web_modal::WebContentsModalDialogManager::FromWebContents(
+                page_.get())) {
+      modal->CloseAllDialogs();
+      modal->SetDelegate(nullptr);
+    }
+    // Its dialogs' manager points at the widget, which goes now.
+    page_->RemoveUserData(
+        javascript_dialogs::TabModalDialogManager::UserDataKey());
+    page_->SetDelegate(nullptr);
+  }
+  Observe(nullptr);
+  if (view_) {
+    view_->web_view()->SetWebContents(nullptr);
+    view_ = nullptr;
+  }
+  // CLIENT_OWNS_WIDGET: the widget closes as it goes, and the tab's dialog
+  // manager lets the pinned page take input again.
+  widget_.reset();
+  widget_delegate_.reset();
+}
+
+// content::WebContentsDelegate ------------------------------------------------
+
+content::WebContents* PeekOverlay::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  if (params.disposition == WindowOpenDisposition::CURRENT_TAB) {
+    // A link inside the peek stays in it, as in a tab.
+    content::NavigationController::LoadURLParams load(params);
+    base::WeakPtr<content::NavigationHandle> handle =
+        page_->GetController().LoadURLWithParams(load);
+    if (handle && navigation_handle_callback) {
+      std::move(navigation_handle_callback).Run(*handle);
+    }
+    return page_.get();
+  }
+  // Anything else goes to the window, as it would from a tab of it.
+  BrowserWindowInterface* const window =
+      source_ ? source_->GetBrowserWindowInterface() : nullptr;
+  if (!window) {
+    return nullptr;
+  }
+  NavigateParams navigate(window, params.url, params.transition);
+  navigate.FillNavigateParamsFromOpenURLParams(params);
+  base::WeakPtr<content::NavigationHandle> handle = Navigate(&navigate);
+  if (handle && navigation_handle_callback) {
+    std::move(navigation_handle_callback).Run(*handle);
+  }
+  return navigate.navigated_or_inserted_contents;
+}
+
+content::WebContents* PeekOverlay::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  // A page the peek's page opens -- a link to a new tab, a popup -- opens
+  // in the window, as one from a tab of it would.
+  BrowserWindowInterface* const window =
+      source_ ? source_->GetBrowserWindowInterface() : nullptr;
+  if (!window) {
+    if (was_blocked) {
+      *was_blocked = true;
+    }
+    return nullptr;
+  }
+  NavigateParams navigate(window, std::move(new_contents));
+  navigate.source_contents = source;
+  navigate.url = target_url;
+  navigate.disposition = disposition;
+  navigate.window_features = window_features;
+  navigate.user_gesture = user_gesture;
+  navigate.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&navigate);
+  return navigate.navigated_or_inserted_contents;
+}
+
+void PeekOverlay::CloseContents(content::WebContents* source) {
+  // window.close(): the page goes once its own call has returned.
+  Destroy();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&Erase, base::Unretained(this)));
+}
+
+void PeekOverlay::BeforeUnloadFired(content::WebContents* source,
+                                    bool proceed,
+                                    bool* proceed_to_fire_unload) {
+  *proceed_to_fire_unload = proceed;
+  // Only the answer to Close's question closes the peek; Stay keeps it open
+  // for another close.
+  const bool closing = std::exchange(closing_, false);
+  if (proceed && closing) {
+    // Leave: the peek closes, once the page's call has returned.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<PeekOverlay> overlay) {
+                         if (overlay && !overlay->destroying_) {
+                           overlay->Destroy();
+                           Erase(overlay.get());
+                         }
+                       },
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+void PeekOverlay::ActivateContents(content::WebContents* contents) {
+  if (widget_) {
+    widget_->Activate();
+  }
+}
+
+bool PeekOverlay::IsContentsActive(content::WebContents* contents) {
+  return widget_ && widget_->IsActive();
+}
