+// found in the LICENSE file.
+
+#include <memory>
+#include <optional>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/stedding/theme/page_theme_color_controller.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/split_tab_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/color/color_recipe.h"
+#include "ui/gfx/color_utils.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+using StackedSplitRowB21Test = BrowserWithTestWindowTest;
+
+// The light window's ground, slate-300 (AddSteddingColorMixer).
+constexpr SkColor kGroundB21 = SkColorSetRGB(0xCB, 0xD5, 0xE1);
+
+// On one of the bar's 16 levels a channel, so the bar is it exactly.
+constexpr SkColor kNavyB21 = SkColorSetRGB(0x11, 0x22, 0x33);
+
+// The colours `supplier` gives a window whose ground is kGroundB21.
+std::unique_ptr<ui::ColorProvider> ProviderOnTheGroundB21(
+    ui::ColorProviderKey::InitializerSupplier* supplier) {
+  auto provider = std::make_unique<ui::ColorProvider>();
+  provider->AddMixer()[ui::kColorFrameActive] = {kGroundB21};
+  ui::ColorProviderKey key;
+  key.color_mode = ui::ColorProviderKey::ColorMode::kLight;
+  supplier->AddColorMixers(provider.get(), key);
+  provider->GenerateColorMapForTesting();
+  return provider;
+}
+
+// How well the toolbar's icons read on `part`.
+float IconsReadOnB21(const ui::ColorProvider& provider, SkColor part) {
+  return color_utils::GetContrastRatio(
+      provider.GetColor(kColorToolbarButtonIcon), part);
+}
+
+// P28-1a, toolbar T41: stacked, the row is the upper pane's colour alone,
+// while the lower pane may be the active one. With one of the two panes
+// without a colour the row's icons and text read on the ground and on the
+// coloured pane alike, whichever pane is active: the row had white icons
+// over the pale ground when the lower, active pane was dark, and no
+// supplier at all, the theme's dark icons on a dark row, when the upper
+// pane was the dark one.
+TEST_F(StackedSplitRowB21Test,
+       AStackedSplitRowsIconsReadWhicheverPaneHasTheColour) {
+  AddTab(browser(), GURL("https://example.com/"));
+  AddTab(browser(), GURL("https://example.org/"));
+  TabStripModel* const model = browser()->tab_strip_model();
+  model->ActivateTabAt(0);
+  model->AddToNewSplit(
+      {1}, split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kStacked),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  // The split's second tab, the lower pane, is the active one.
+  model->ActivateTabAt(1);
+  tabs::TabInterface* const active = model->GetActiveTab();
+  ASSERT_TRUE(active);
+  ASSERT_TRUE(active->IsSplit());
+  ASSERT_EQ(split_tabs::SplitTabLayout::kStacked,
+            model->GetSplitData(*active->GetSplit())
+                ->visual_data()
+                ->split_layout());
+  PageThemeColorController* const controller =
+      PageThemeColorController::From(browser());
+  ASSERT_TRUE(controller);
+  ASSERT_TRUE(controller->partner());
+  {
+    SCOPED_TRACE("the active, lower pane is dark and the upper has no colour");
+    controller->SetColorForTesting(kNavyB21);
+    controller->SetPartnerColorForTesting(std::nullopt);
+    ui::ColorProviderKey::InitializerSupplier* const supplier =
+        controller->bar_supplier();
+    ASSERT_TRUE(supplier);
+    const std::unique_ptr<ui::ColorProvider> provider =
+        ProviderOnTheGroundB21(supplier);
+    // The row is the ground here: the navy's white would not read on it.
+    EXPECT_GE(IconsReadOnB21(*provider, kGroundB21), 2.5);
+    EXPECT_GE(IconsReadOnB21(*provider, kNavyB21), 2.5);
+    EXPECT_EQ(kNavyB21, provider->GetColor(kColorOmniboxResultsBackground))
+        << "the focused field keeps the active pane's colour";
+  }
+  {
+    SCOPED_TRACE("the upper pane is dark and the active one has no colour");
+    controller->SetColorForTesting(std::nullopt);
+    controller->SetPartnerColorForTesting(kNavyB21);
+    ui::ColorProviderKey::InitializerSupplier* const supplier =
+        controller->bar_supplier();
+    ASSERT_TRUE(supplier) << "the theme's icons sit on the dark row";
+    const std::unique_ptr<ui::ColorProvider> provider =
+        ProviderOnTheGroundB21(supplier);
+    EXPECT_GE(IconsReadOnB21(*provider, kNavyB21), 2.5);
+    EXPECT_GE(IconsReadOnB21(*provider, kGroundB21), 2.5);
+    EXPECT_EQ(kGroundB21, provider->GetColor(kColorOmniboxResultsBackground))
+        << "the focused field is the ground the active pane has";
+  }
+  {
+    SCOPED_TRACE("neither pane has a colour");
+    controller->SetColorForTesting(std::nullopt);
+    controller->SetPartnerColorForTesting(std::nullopt);
+    EXPECT_FALSE(controller->bar_supplier()) << "the row keeps the theme's";
+  }
+}
+
+}  // namespace
+}  // namespace stedding
