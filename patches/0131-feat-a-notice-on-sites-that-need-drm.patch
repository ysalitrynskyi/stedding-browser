+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/drm_notice_browser.h"
+
+#include <windows.h>
+
+#include "base/strings/strcat.h"
+#include "base/win/registry.h"
+#include "chrome/browser/platform_util.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+bool OtherBrowserFound() {
+  // Edge registers this protocol wherever it is installed.
+  base::win::RegKey protocol(HKEY_CLASSES_ROOT, L"microsoft-edge",
+                             KEY_QUERY_VALUE);
+  return protocol.Valid() && protocol.HasValue(L"URL Protocol");
+}
+
+void OpenInOtherBrowser(const GURL& url) {
+  const GURL address(base::StrCat({"microsoft-edge:", url.spec()}));
+  if (address.is_valid()) {
+    platform_util::OpenExternal(address);
+  }
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/drm_notice_unittest.cc b/chrome/browser/ui/stedding/drm_notice_unittest.cc
