+// A17 (BACKLOG S-159): a little window closed by hand (little E13). Its
+// session keeps the mark it was made with.
+bool IsLittleWindowClose(const sessions::tab_restore::Window& window) {
+  if (window.window_type != sessions::SessionWindow::TYPE_POPUP) {
+    return false;
+  }
+  const auto it = window.extra_data.find(kSessionLittleWindowKey);
+  return it != window.extra_data.end() && it->second == "1";
+}
+
 // A14 (web apps Wa12): an installed app's window, or a little window an app
 // opened. Its tabs are the app's, in the app's jar: ⇧⌘T brings the window
 // back as the app's, while the archive's Restore would put a page of it in
@@ -794,9 +805,13 @@ std::vector<ArchivedTab> ListArchivedTabs(
         const base::Time closed = window.timestamp.is_null()
                                       ? newest_page(window)
                                       : window.timestamp;
+        // A17: a link closed in a little window, as Arc keeps Little Arc's
+        // in its archive.
+        const char* const closed_with =
+            IsLittleWindowClose(window) ? "little" : "window";
         for (const std::unique_ptr<sessions::tab_restore::Tab>& tab :
              window.tabs) {
-          add(*tab, time_of(*tab, closed), "window", window.tabs.size());
+          add(*tab, time_of(*tab, closed), closed_with, window.tabs.size());
         }
         break;
       }
