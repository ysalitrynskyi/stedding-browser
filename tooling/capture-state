#!/usr/bin/env bash
# Capture a browser state without a hand on the machine.
#
# Usage:
#   tooling/capture-state --out <prefix> [--seed collapsed|grey-dark|light|dark|horizontal|horizontal-light|horizontal-dark]
#                         [--settle <seconds>]
#                         [--features <list>] [--disable-features <list>]
#                         [--size WxH] [--url URL] [--page URL] [--build DIR]
#                         [--sidebar-width N]
#                         [chromium args and URLs...]
#
# Refuses to start while any other process with the app's bundle id runs
# (your own Stedding, or one a crashed run left). Launches the built app on a
# fresh profile (a seeded preference if asked) in the background through
# LaunchServices, waits for the first paint, and captures every window owned
# by that pid or a child (tooling/capture-windows: <prefix>.png, then
# <prefix>-2.png for a dialog). It quits that pid so session files flush, and
# reports an abort from the browser log (<prefix>.log). No synthetic input and
# no focus change -- if the browser makes itself the frontmost app, the run
# stops and captures nothing -- so it is safe while someone is at the machine
# (docs/HANDOFF.md, trap 29). Any exit, Ctrl-C or kill quits the launched pid
# and deletes the profile. tooling/capture-ui execs this script.
#
# --out path.png is the image file. Any other --out is a prefix, and the
# image is <prefix>.png. --size accepts 1400x880 or 1400,880. --build is
# the directory under out/ (default release).
#
# --page opens a page Chromium will not open from its command line, such as
# chrome://settings/stedding (chrome/browser/ui/startup/url_util.cc shows the
# new tab page instead). The browser is launched with
# --remote-debugging-port=0; once it has painted, tooling/devtools-page opens
# the page through the local DevTools endpoint in a new tab, closes the new
# tab page the launch opened, and fails unless the tab reports that address
# and a title. The capture follows after --page-settle seconds (default 5).
# No input and no focus change: the endpoint is on 127.0.0.1, and nothing
# activates a window.
#
# The state comes from feature params on SteddingArcStyleWindow and switches:
#   --features 'SteddingArcStyleWindow:extra_spaces/2/pin_tabs/1/folder_tabs/3'
#   --features 'SteddingArcStyleWindow:space_pin_tabs/1/drift_tabs/1'
#   --features 'SteddingArcStyleWindow:open_command_bar/true'
#   --features 'SteddingArcStyleWindow:split_tabs/1'   the first two tabs side by side
#   --stedding-welcome=import          the welcome flow, on one step
#   --seed collapsed                   the collapsed rail (a profile preference)
#   --seed grey-dark                   dark mode with Customize Chrome's Grey
#   --seed light, --seed dark          the window in light or dark, whatever macOS is set to
#                                      (the key an incognito window has)
#   --seed horizontal                  vertical tabs off: Chromium's horizontal tab strip
#                                      (prefs::kVerticalTabsEnabled); horizontal-light and
#                                      horizontal-dark set the window's scheme as well
#   --sidebar-width N                  the open sidebar N DIP wide, with any seed
# The list of params is in docs/HANDOFF.md.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

CAPTURE_PROFILE=""
# Quits the launched pid (then kills it), and only then deletes the profile it
# was writing to.
capture_cleanup() {
  stop_launched_app 10
  if [ -n "$CAPTURE_PROFILE" ]; then
    # A helper can still be closing a file for a moment after the browser goes.
    rm -rf "$CAPTURE_PROFILE" 2>/dev/null || { sleep 1; rm -rf "$CAPTURE_PROFILE" || true; }
    CAPTURE_PROFILE=""
  fi
}

main() {
  local out="" seed="" settle=18 features="" disable_features="" size="1400,880"
  local build="release" url="" page="" page_settle=5 sidebar_width=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --out=*|--seed=*|--settle=*|--features=*|--size=*|--url=*|--disable-features=*|--build=*|--page=*|--page-settle=*|--sidebar-width=*)
        set -- "${1%%=*}" "${1#*=}" "${@:2}"
        ;;
    esac
    case "$1" in
      --out)      out="$2"; shift 2 ;;
      --seed)     seed="$2"; shift 2 ;;
      --settle)   settle="$2"; shift 2 ;;
      --features) features="$2"; shift 2 ;;
      --disable-features) disable_features="$2"; shift 2 ;;
      --size)     size="$(printf '%s' "$2" | tr 'xX' ',,')"; shift 2 ;;
      --url)      url="$2"; shift 2 ;;
      --page)     page="$2"; shift 2 ;;
      --page-settle) page_settle="$2"; shift 2 ;;
      --build)    build="$2"; shift 2 ;;
      --sidebar-width) sidebar_width="$2"; shift 2 ;;
      -h|--help)  sed -n '2,52p' "$0"; exit 0 ;;
      *)          break ;;
    esac
  done
  [ -n "$out" ] || die "--out <prefix> is required"
  [ -n "$build" ] || die "--build needs a directory name under out/"

  local prefix="$out"
  case "$prefix" in
    *.png) prefix="${prefix%.png}" ;;
  esac
  [ -n "$prefix" ] || die "--out <prefix> is required"
  [ -n "$url" ] && set -- "$@" "$url"
  # Chromium opens no chrome:// page named on its command line
  # (chrome/browser/ui/startup/url_util.cc): the window shows the new tab page
  # instead, and the capture would pass for the page asked for.
  local arg
  for arg in "$@"; do
    case "$arg" in
      chrome://*|chrome-untrusted://*)
        die "Chromium does not open $arg from the command line; pass it as --page $arg" ;;
    esac
  done

  case "$seed" in
    ""|collapsed|grey-dark|light|dark|horizontal|horizontal-light|horizontal-dark) ;;
    *) die "unknown seed: $seed (known: collapsed, grey-dark, light, dark, horizontal, horizontal-light, horizontal-dark)" ;;
  esac
  require_pyobjc

  local app
  app="$(find_app_bundle "$CHROMIUM_SRC/out/$build" || true)"
  [ -n "$app" ] && [ -d "$app" ] || die "no app bundle in out/$build -- tooling/dev build"
  require_no_other_instance "$app"

  local profile
  profile="$(mktemp -d "${TMPDIR:-/tmp}/stedding-state.XXXXXX")"
  # From here on, any exit -- an error, Ctrl-C, a kill -- quits the browser this
  # run launched and deletes this profile.
  CAPTURE_PROFILE="$profile"
  trap capture_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  mkdir -p "$profile/Default"
  case "$seed" in
    collapsed)
      printf '{"vertical_tabs":{"collapsed_state":true}}' > "$profile/Default/Preferences" ;;
    grey-dark)
      # prefs::kBrowserColorScheme (2 is dark) and prefs::kGrayscaleThemeEnabled.
      printf '{"browser":{"theme":{"color_scheme2":2,"is_grayscale2":true}}}' \
        > "$profile/Default/Preferences" ;;
    light|dark)
      # prefs::kBrowserColorScheme: 1 is light, 2 is dark.
      printf '{"browser":{"theme":{"color_scheme2":%d}}}' "$([ "$seed" = light ] && echo 1 || echo 2)" \
        > "$profile/Default/Preferences" ;;
    horizontal)
      printf '{"vertical_tabs":{"enabled":false}}' > "$profile/Default/Preferences" ;;
    horizontal-light|horizontal-dark)
      printf '{"vertical_tabs":{"enabled":false},"browser":{"theme":{"color_scheme2":%d}}}' \
        "$([ "$seed" = horizontal-light ] && echo 1 || echo 2)" > "$profile/Default/Preferences" ;;
  esac
  if [ -n "$sidebar_width" ]; then
    # prefs::kVerticalTabsUncollapsedWidth, merged into the seed's preferences.
    python3 -c 'import json, os, sys
path = sys.argv[1]
prefs = json.load(open(path)) if os.path.exists(path) else {}
prefs.setdefault("vertical_tabs", {})["uncollapsed_width"] = int(sys.argv[2])
json.dump(prefs, open(path, "w"))' "$profile/Default/Preferences" "$sidebar_width"
  fi

  # LaunchServices starts the app in /, so the log path must be absolute.
  local log_file
  log_file="$(absolute_path "$prefix.log")"
  # The browser starts behind whatever is in front, and a covered page would
  # otherwise stop painting and capture blank.
  # --stedding-stay-in-background: the build never makes itself the front app
  # (Chromium's first window would; trap 29).
  set -- --user-data-dir="$profile" --use-mock-keychain --no-first-run --no-default-browser-check \
         --stedding-stay-in-background \
         --disable-backgrounding-occluded-windows \
         --window-size="$size" --window-position=0,0 --enable-logging=stderr "$@"
  # Port 0: the browser picks a free one and writes it to
  # <profile>/DevToolsActivePort, so two runs never share a port (trap 61).
  [ -n "$page" ] && set -- --remote-debugging-port=0 "$@"
  [ -n "$disable_features" ] && set -- --disable-features="$disable_features" "$@"
  [ -n "$features" ] && set -- --enable-features="$features" "$@"

  # trap 136: a pointer resting where the window opens would leave its hover in the
  # picture (the sidebar edge's bar was in most of the README's stills until
  # 0.4.0 beta 1).
  local pointer_there="the pointer is where the window opens, the top left ${size/,/x} points of the main display, and its hover would be in the picture"
  keep_pointer_off_window "$size" ||
    die "$pointer_there; nothing was captured. Move it away, or leave the Mac alone for ten seconds so tooling/park-cursor can"

  local front_before
  front_before="$(frontmost_pid)"
  launch_in_background "$app" "$log_file" "$@"
  local pid="$LAUNCHED_PID"
  log "launched $(basename "$app") pid $pid in the background for $prefix.png"
  # No signal to wait on from outside the process: a plain wait for the paint,
  # watching that the browser never takes the focus from whoever is at the machine.
  local stolen="the launched browser (pid $pid) made itself the frontmost app in place of pid ${front_before:-unknown}, so keys typed meanwhile went to it"
  wait_unfocused "$pid" "$settle" stop || die "$stolen; nothing was captured"
  if [ -n "$page" ]; then
    python3 "$STEDDING_ROOT/tooling/devtools-page" --close-new-tab "$profile" "$page" ||
      die "DevTools did not open $page; nothing was captured (see $log_file)"
    wait_unfocused "$pid" "$page_settle" stop || die "$stolen; nothing was captured"
  fi

  ! pointer_over_window "$size" || die "$pointer_there; it moved there during the wait, so nothing was captured"
  local cap_status=0
  python3 "$STEDDING_ROOT/tooling/capture-windows" "$pid" "$prefix" || cap_status=$?
  [ "$(frontmost_pid)" != "$pid" ] || die "$stolen, during the capture"

  # Quit this pid, not every app whose name contains Stedding.
  stop_launched_app 40
  if grep -i -m3 "bad_variant\|received signal\|check failed\|fatal" "$log_file"; then
    die "the browser aborted; see $log_file"
  fi
  if [ "$cap_status" -ne 0 ] || [ ! -f "$prefix.png" ]; then
    die "capture wrote no $prefix.png (is the screen locked? does this python have Quartz? see $log_file)"
  fi
  log "done: $prefix.png"
}

main "$@"
