+// PLAN.md TST-8 (tabs R20, R21): a selection never holds a row the user
+// cannot see. Rows are chosen as a person chooses them -- a click, then a
+// click with the platform's add-to-selection key -- and a folder collapses at
+// a click on its header. The clipboard is a test clipboard, never the
+// machine's own.
+class SidebarSelectionTest : public SidebarClickTest {
+ protected:
+  void SetUpOnMainThread() override {
+    SidebarClickTest::SetUpOnMainThread();
+    ui::TestClipboard::CreateForCurrentThread();
+  }
+
+  void TearDownOnMainThread() override {
+    ui::Clipboard::DestroyClipboardForCurrentThread();
+    SidebarClickTest::TearDownOnMainThread();
+  }
+
+  // The key a click holds to add a row to the selection (tabs R20).
+  static constexpr int kAddToSelection =
+#if BUILDFLAG(IS_MAC)
+      ui::EF_COMMAND_DOWN;
+#else
+      ui::EF_CONTROL_DOWN;
+#endif
+
+  std::u16string ClipboardText() {
+    base::test::TestFuture<std::u16string> text;
+    ui::Clipboard::GetForCurrentThread()->ReadText(
+        ui::ClipboardBuffer::kCopyPaste, /*data_dst=*/std::nullopt,
+        text.GetCallback());
+    return text.Get();
+  }
+
+  GURL Page(const std::string& host) {
+    return embedded_test_server()->GetURL(host, "/title1.html");
+  }
+
+  // A new foreground tab showing `host`, loaded.
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Page(host), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tab_strip_model()->GetActiveTab();
+  }
+
+  int Index(const tabs::TabInterface* tab) {
+    return tab_strip_model()->GetIndexOfTab(tab);
+  }
+
+  gfx::Point HeaderCentre(const tabs::FolderTabCollection* folder) {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    FolderView* const view = stedding::test::FindDrawnFolder(
+        browser_view()->GetWidget()->GetRootView(), folder);
+    CHECK(view);
+    return view->GetHeaderBoundsInScreen().CenterPoint();
+  }
+
+  // Clicks `inside`, a row of `folder` (opening the folder first when it is
+  // collapsed), adds `outside` with the selection key, which puts `outside`
+  // on screen, then collapses the folder with a click on its header. Leaves
+  // `inside` hidden under the header.
+  void SelectAcrossThenCollapse(tabs::FolderTabCollection* folder,
+                                tabs::TabInterface* inside,
+                                tabs::TabInterface* outside) {
+    if (folder->collapsed()) {
+      ClickAt(HeaderCentre(folder));
+      ASSERT_TRUE(
+          base::test::RunUntil([&]() { return !folder->collapsed(); }));
+    }
+    WaitForRowsToSettle();
+    ClickAt(TitleCentre(Index(inside)));
+    ASSERT_EQ(inside, tab_strip_model()->GetActiveTab());
+    ClickAt(TitleCentre(Index(outside)), kAddToSelection);
+    ASSERT_EQ(outside, tab_strip_model()->GetActiveTab());
+    ASSERT_TRUE(tab_strip_model()->IsTabSelected(Index(inside)))
+        << "the selection key did not add the row";
+    ClickAt(HeaderCentre(folder));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return folder->collapsed(); }));
+    WaitForRowsToSettle();
+    base::RunLoop().RunUntilIdle();
+    ASSERT_TRUE(tab_strip_model()->IsTabHidden(Index(inside)));
+    ASSERT_FALSE(tab_strip_model()->IsTabHidden(Index(outside)));
+  }
+};
+
+// A row the collapse of its folder hides leaves the selection, so Copy Link,
+// the next Space's key and Cmd-W act on the row on screen alone. They had
+// taken the hidden row too: none of them asked whether a selected row is
+// drawn, and a selection made before the collapse kept it. A Space switch
+// leaves no row of the old Space selected.
+IN_PROC_BROWSER_TEST_F(SidebarSelectionTest,
+                       ACollapsedFolderTakesItsRowsOutOfTheSelection) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  // Home: ..., a, Folder[f1, f2], d.
+  tabs::TabInterface* const a = Open("a.test");
+  tabs::TabInterface* const f1 = Open("f1.test");
+  tabs::TabInterface* const f2 = Open("f2.test");
+  tabs::TabInterface* const d = Open("d.test");
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({Index(f1), Index(f2)});
+  ASSERT_TRUE(folder);
+
+  {
+    SCOPED_TRACE("the collapse takes the hidden row out of the selection");
+    ASSERT_NO_FATAL_FAILURE(SelectAcrossThenCollapse(folder, f1, a));
+    EXPECT_FALSE(tab_strip_model()->IsTabSelected(Index(f1)))
+        << "a row the folder hides is still selected";
+    EXPECT_TRUE(tab_strip_model()->IsTabSelected(Index(a)));
+  }
+
+  {
+    SCOPED_TRACE("Copy Link copies the row on screen");
+    ASSERT_NO_FATAL_FAILURE(SelectAcrossThenCollapse(folder, f1, a));
+    chrome::ExecuteCommand(browser(), IDC_COPY_URL);  // ⇧⌘C
+    EXPECT_EQ(base::UTF8ToUTF16(Page("a.test").spec()), ClipboardText())
+        << "the copy took a row the folder hides";
+  }
+
+  {
+    SCOPED_TRACE("the next Space's key moves the row on screen");
+    ASSERT_NO_FATAL_FAILURE(SelectAcrossThenCollapse(folder, f1, a));
+    chrome::ExecuteCommand(browser(),
+                           IDC_STEDDING_MOVE_TAB_TO_NEXT_SPACE);  // ⌥⇧⌘→
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return model->SpaceForTab(a) == work; }));
+    ASSERT_EQ(home, model->SpaceForTab(f1))
+        << "a row the folder hides moved with the selection";
+    EXPECT_TRUE(f1->GetParentCollection() == folder)
+        << "the hidden row left its folder";
+    ASSERT_TRUE(model->SetActiveSpace(home));
+  }
+
+  {
+    SCOPED_TRACE("Cmd-W closes the row on screen");
+    ASSERT_NO_FATAL_FAILURE(SelectAcrossThenCollapse(folder, f1, d));
+    const tabs::TabHandle d_handle = d->GetHandle();
+    const tabs::TabHandle f1_handle = f1->GetHandle();
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);  // ⌘W
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !d_handle.Get(); }))
+        << "Cmd-W did not close the row on screen";
+    EXPECT_TRUE(f1_handle.Get()) << "Cmd-W closed a row the folder hides";
+  }
+
+  {
+    SCOPED_TRACE("a Space switch leaves no row of the old Space selected");
+    ASSERT_TRUE(model->SetActiveSpace(work));
+    tabs::TabInterface* const w2 = Open("w2.test");
+    WaitForRowsToSettle();
+    ClickAt(TitleCentre(Index(a)));
+    ClickAt(TitleCentre(Index(w2)), kAddToSelection);
+    ASSERT_TRUE(tab_strip_model()->IsTabSelected(Index(a)));
+    ASSERT_TRUE(tab_strip_model()->IsTabSelected(Index(w2)));
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_SPACE_1);  // ⌃1
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return model->active_id() == home; }));
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      if (tab_strip_model()->IsTabSelected(i)) {
+        EXPECT_FALSE(tab_strip_model()->IsTabHidden(i))
+            << "tab " << i << " is selected and not on screen";
+      }
+    }
+  }
+}
+
+// PLAN.md TST-8, copy-link L1, tabs R21: a split is one row, so Copy Link on
+// a split with nothing else selected copies the page in focus, as it does
+// for any one row. It had copied both panes: Chromium selects a split's two
+// tabs together, and the copy read every selected tab as a row. With another
+// row added to the selection, every selected page goes, both panes among
+// them.
+IN_PROC_BROWSER_TEST_F(SidebarSelectionTest,
+                       CopyLinkOnASplitTakesThePaneInFocus) {
+  tabs::TabInterface* const other = Open("other.test");
+  tabs::TabInterface* const left = Open("left.test");
+  tabs::TabInterface* const right = Open("right.test");
+  tab_strip_model()->ActivateTabAt(Index(left));
+  tab_strip_model()->AddToNewSplit(
+      {Index(right)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_EQ(left->GetSplit(), right->GetSplit());
+  ASSERT_EQ(left, tab_strip_model()->GetActiveTab());
+  ASSERT_EQ(2u, tab_strip_model()->selection_model().size())
+      << "Chromium selects both panes of the split on screen";
+
+  {
+    SCOPED_TRACE("the split alone");
+    chrome::ExecuteCommand(browser(), IDC_COPY_URL);  // ⇧⌘C
+    EXPECT_EQ(base::UTF8ToUTF16(Page("left.test").spec()), ClipboardText())
+        << "the copy took both panes of one row";
+  }
+
+  {
+    SCOPED_TRACE("the split and another row");
+    WaitForRowsToSettle();
+    ClickAt(TitleCentre(Index(other)), kAddToSelection);
+    ASSERT_EQ(3u, tab_strip_model()->selection_model().size());
+    chrome::ExecuteCommand(browser(), IDC_COPY_URL);
+    EXPECT_EQ(base::UTF8ToUTF16(Page("other.test").spec() + "\n" +
+                                Page("left.test").spec() + "\n" +
+                                Page("right.test").spec()),
+              ClipboardText());
+  }
+}
+
 }  // namespace
