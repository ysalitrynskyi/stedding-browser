+    tabs::TabInterface* const plain = AppendAwakeTab("plain.example");
+    tabs::TabInterface* const essential = AppendAwakeTab("essential.example");
+    tabs::TabInterface* const pin = AppendAwakeTab("pin.example");
+    tabs::TabInterface* const folded = AppendAwakeTab("folded.example");
+    tabs::TabInterface* const sound = AppendAwakeTab("sound.example");
