+// P38-1a, spaces B27 (PLAN.md SPC-6): a chip dragged to another place moves
+// its Space there and leaves the Space on screen as it was, in the open row
+// and in the rail. The dragged chip follows the pointer, so the release lands
+// on it, and the drop was taken as a click on it: the window switched to the
+// dragged Space. A click on a chip still switches.
+IN_PROC_BROWSER_TEST_F(SpaceSwitcherB28Test,
+                       DroppingADraggedChipKeepsTheSpaceOnScreen) {
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces());
+  // The Space tint's theme change, a turn later, rebuilds the row.
+  base::RunLoop().RunUntilIdle();
+  const std::vector<spaces::SpaceId> moved = {ids_[0], ids_[2], ids_[1]};
+
+  {
+    SCOPED_TRACE("the open row");
+    ASSERT_NO_FATAL_FAILURE(DragTheThirdChipSecond());
+    ASSERT_TRUE(base::test::RunUntil([&]() { return Order() == moved; }));
+    EXPECT_EQ(ids_[0], model()->active_id())
+        << "the drop switched to the dragged Space";
+    ASSERT_TRUE(model()->MoveSpace(ids_[1], -1));
+    ASSERT_EQ(ids_, Order());
+  }
+
+  {
+    SCOPED_TRACE("the rail");
+    if (model()->active_id() != ids_[0]) {
+      ASSERT_TRUE(model()->SetActiveSpace(ids_[0]));
+    }
+    base::RunLoop().RunUntilIdle();
+    vertical_tab_strip_state_controller()->SetExpandOnHoverEnabled(false);
+    ASSERT_NO_FATAL_FAILURE(Collapse());
+    ASSERT_NO_FATAL_FAILURE(DragTheThirdChipSecond());
+    ASSERT_TRUE(base::test::RunUntil([&]() { return Order() == moved; }));
+    EXPECT_EQ(ids_[0], model()->active_id())
+        << "the drop switched to the dragged Space";
+  }
+
+  {
+    SCOPED_TRACE("a click still switches");
+    base::RunLoop().RunUntilIdle();
+    std::optional<gfx::Point> two;
+    for (const auto& [centre, id] : Chips()) {
+      if (id == ids_[1]) {
+        two = centre;
+      }
+    }
+    ASSERT_TRUE(two.has_value());
+    stedding::test::ClickLeftMouse(widget(), *two);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(ids_[1], model()->active_id());
+  }
+}
