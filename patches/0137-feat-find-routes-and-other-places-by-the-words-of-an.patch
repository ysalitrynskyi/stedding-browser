@@ -677,7 +677,28 @@ export class SettingsSteddingPageElement extends
   // SettingsPlugin implementation
   async searchContents(query: string) {
     const searchRequest = await getSearchManager().search(query, this);
-    return searchRequest.getSearchResult();
+    const result = searchRequest.getSearchResult();
+    // settings T58: this page is long, and a word that is only a hint is
+    // nowhere to be seen: the first mark comes into view.
+    if (!result.canceled && query) {
+      this.firstMark_(this.shadowRoot)?.scrollIntoView({block: 'center'});
+    }
+    return result;
+  }
+
+  // The first search mark under `root`, through the shadow roots of the rows
+  // and the cards that are elements of their own.
+  private firstMark_(root: ParentNode): Element|null {
+    for (const element of root.querySelectorAll('*')) {
+      if (element.classList.contains('search-highlight-hit')) {
+        return element;
+      }
+      const inside = element.shadowRoot && this.firstMark_(element.shadowRoot);
+      if (inside) {
+        return inside;
+      }
+    }
+    return null;
   }
 }
 
