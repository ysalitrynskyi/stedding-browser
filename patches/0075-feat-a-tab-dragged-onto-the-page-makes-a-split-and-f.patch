+// toolbar T39: Escape pressed while the chord's modifier is still down, as a
+// keyboard sends it -- to the window, with the modifier's flag -- closes the
+// chord's bar and runs nothing, then or when the modifier is let go. On the
+// Mac the bar stayed open until a plain Escape (2026-10-20).
+IN_PROC_BROWSER_TEST_F(HiddenRowControlsTest, EscapeWithTheChordHeldClosesIt) {
+  const scoped_refptr<const extensions::Extension> popup =
+      LoadAction("Stedding Popup Probe", /*popup=*/true);
+  ASSERT_TRUE(popup);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("site.test", "/title1.html")));
+  widget()->Activate();
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_STEDDING_RUN_EXTENSION));
+  stedding::CommandBarView* const bar =
+      stedding::CommandBarView::GetOpenBar(browser_view());
+  ASSERT_TRUE(bar);
+  ASSERT_TRUE(bar->holding_chord_for_testing());
+  EXPECT_TRUE(bar->field_for_testing()->HasFocus());
+
+  ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                     widget()->GetNativeWindow());
+  // On the Mac through the window as the application hands a key over: the
+  // window's key equivalents first, since the modifier is down, then its
+  // first responder.
+  generator.set_target(ui::test::EventGenerator::Target::WINDOW);
+  generator.PressKey(ui::VKEY_ESCAPE, kChordFlags);
+  generator.ReleaseKey(ui::VKEY_ESCAPE, kChordFlags);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !stedding::CommandBarView::GetOpenBar(browser_view());
+  })) << "Escape with the modifier down left the bar open";
+  ToolbarActionViewModel* const action = ActionOf(*popup);
+  ASSERT_TRUE(action);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(action->IsShowingPopup()) << "the chosen extension ran";
+}
+
+#if BUILDFLAG(IS_MAC)
+// commandbar K32, toolbar T40 (2026-10-20): the row hidden with the sidebar
+// in its rail (the setting that hides it with the sidebar, T8; off the Mac
+// the caption buttons keep the row, T22), and a page playing a clip with
+// sound. The row Show Media Controls follows the playing session, not the
+// toolbar's media button: with the button hidden, as the toolbar's layout
+// hides it when the row has no room for it, the row is still listed. The bar
+// had read the button and said "No matching command". Its dialog opens at
