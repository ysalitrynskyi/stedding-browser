+// ("Darken this site" off the Mac), checked while the site is darkened; run,
+// the site is kept light and the page repaints; run again, it is darkened.
+class DarkPagesMenuTest : public DarkPagesTest {
+ protected:
+  std::unique_ptr<TestRenderViewContextMenu> PageMenu() {
+    content::ContextMenuParams params;
+    params.page_url = page()->GetLastCommittedURL();
+    params.frame_url = params.page_url;
+    auto menu = std::make_unique<TestRenderViewContextMenu>(
+        *page()->GetPrimaryMainFrame(), params);
+    menu->Init();
+    return menu;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(DarkPagesMenuTest, ThePageMenuKeepsASiteLight) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  EXPECT_FALSE(
+      PageMenu()->IsItemPresent(IDC_STEDDING_TOGGLE_DARK_PAGES_FOR_SITE))
+      << "not while dark pages is off";
+  stedding::SetDarkPagesOn(profile(), true);
+  ASSERT_TRUE(WaitForProbe(page(), kDark));
+  {
+    std::unique_ptr<TestRenderViewContextMenu> menu = PageMenu();
+    ASSERT_TRUE(menu->IsItemPresent(IDC_STEDDING_TOGGLE_DARK_PAGES_FOR_SITE));
+    const std::optional<std::pair<ui::MenuModel*, size_t>> row =
+        menu->GetMenuModelAndItemIndex(IDC_STEDDING_TOGGLE_DARK_PAGES_FOR_SITE);
+    ASSERT_TRUE(row);
+    EXPECT_EQ(stedding::kDarkenThisSiteLabel,
+              row->first->GetLabelAt(row->second))
+        << "the menu's own case on this platform";
+    EXPECT_TRUE(
+        menu->IsCommandIdChecked(IDC_STEDDING_TOGGLE_DARK_PAGES_FOR_SITE));
+    menu->ExecuteCommand(IDC_STEDDING_TOGGLE_DARK_PAGES_FOR_SITE, 0);
+  }
+  EXPECT_TRUE(WaitForProbe(page(), kLight));
+  EXPECT_EQ(
+      std::vector<ContentSettingsPattern>{
+          *stedding::DarkPagesSitePatternFor(Url("a.test"))},
+      stedding::GetDarkPagesSites(profile(),
+                                  stedding::DarkPagesMode::kAllExcept));
+  {
+    std::unique_ptr<TestRenderViewContextMenu> menu = PageMenu();
+    EXPECT_FALSE(
+        menu->IsCommandIdChecked(IDC_STEDDING_TOGGLE_DARK_PAGES_FOR_SITE));
+    menu->ExecuteCommand(IDC_STEDDING_TOGGLE_DARK_PAGES_FOR_SITE, 0);
+  }
+  EXPECT_TRUE(WaitForProbe(page(), kDark));
+
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://version")));
+  EXPECT_FALSE(
+      PageMenu()->IsItemPresent(IDC_STEDDING_TOGGLE_DARK_PAGES_FOR_SITE))
+      << "a browser page has no site";
+}
+
+// Dk16, Dk17: the moon at the address row's right end.
+class DarkPagesButtonTest : public DarkPagesTest {
+ protected:
+  // The window's moon, found through the window's element context, as
+  // Chromium asks a search of a whole window to be made (BrowserView's own
+  // element search is not for that). A hidden button (Dk17) is found too.
+  static stedding::DarkPagesButton* ButtonOf(BrowserWindowInterface* window) {
+    BrowserElementsViews* const elements = BrowserElementsViews::From(window);
+    return elements ? elements->GetViewAs<stedding::DarkPagesButton>(
+                          stedding::DarkPagesButton::kElementId)
+                    : nullptr;
+  }
+
+  static ax::mojom::CheckedState CheckedState(views::View* view) {
+    ui::AXNodeData data;
+    view->GetViewAccessibility().GetAccessibleNodeData(&data);
+    return data.GetCheckedState();
+  }
+
+  static void Click(stedding::DarkPagesButton* button) {
+    views::test::ButtonTestApi(button).NotifyClick(
+        ui::MouseEvent(ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+                       base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+                       ui::EF_LEFT_MOUSE_BUTTON));
+  }
+};
+
+// Dk16: a click flips the switch; the button is a toggle named "Dark pages",
+// checked while on, with the action and its chord in its tooltip, from the
+// window's first showing (the chord is the window's, which the button is
+// made before); a second window's button follows a change made in the first.
+IN_PROC_BROWSER_TEST_F(DarkPagesButtonTest, TheButtonTogglesAndShowsTheState) {
+  stedding::DarkPagesButton* const button = ButtonOf(browser());
+  ASSERT_TRUE(button);
+  EXPECT_TRUE(button->GetVisible());
+  EXPECT_FALSE(button->is_on());
+  EXPECT_EQ(ax::mojom::CheckedState::kFalse, CheckedState(button));
+  EXPECT_EQ(u"Dark pages", button->GetViewAccessibility().GetCachedName());
+  ui::Accelerator chord;
+  ASSERT_TRUE(
+      BrowserView::GetBrowserViewForBrowser(browser())
+          ->GetAcceleratorForCommandId(IDC_STEDDING_TOGGLE_DARK_PAGES, &chord));
+  const std::u16string with_chord =
+      base::StrCat({u"Turn dark pages on (", chord.GetShortcutText(), u")"});
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return button->GetTooltipText() == with_chord;
+  })) << "the stored tooltip, before any change of state: "
+      << button->GetTooltipText();
+
+  BrowserWindowInterface* const second = CreateBrowser(profile());
+  stedding::DarkPagesButton* const other = ButtonOf(second);
+  ASSERT_TRUE(other);
+
+  Click(button);
+  EXPECT_TRUE(stedding::DarkPagesOn(profile()));
+  EXPECT_TRUE(button->is_on());
+  EXPECT_EQ(ax::mojom::CheckedState::kTrue, CheckedState(button));
+  EXPECT_EQ(0u, button->GetTooltipText().find(u"Turn dark pages off"));
+  EXPECT_TRUE(other->is_on()) << "every window's button follows";
+  EXPECT_EQ(ax::mojom::CheckedState::kTrue, CheckedState(other));
+
+  Click(other);
+  EXPECT_FALSE(stedding::DarkPagesOn(profile()));
+  EXPECT_FALSE(button->is_on());
+  EXPECT_EQ(ax::mojom::CheckedState::kFalse, CheckedState(button));
+}
+
+// Dk16: while dark pages is on and the tab's site is kept light, the tooltip
+// says so.
+IN_PROC_BROWSER_TEST_F(DarkPagesButtonTest, TheTooltipNamesASiteKeptLight) {
+  stedding::SetDarkPagesOn(profile(), true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  stedding::DarkPagesButton* const button = ButtonOf(browser());
+  ASSERT_TRUE(button);
+  EXPECT_EQ(std::u16string::npos,
+            button->GetRenderedTooltipText(gfx::Point()).find(u"kept light"));
+  stedding::SetSiteDarkened(page(), false);
+  const std::u16string tooltip = button->GetRenderedTooltipText(gfx::Point());
+  EXPECT_NE(std::u16string::npos, tooltip.find(u"a.test is kept light"))
+      << tooltip;
+  EXPECT_NE(std::u16string::npos, tooltip.find(u"Turn dark pages off"))
+      << tooltip;
+}
+
+// Dk16: popups have no row of buttons, and so no moon; the chord still runs
+// the switch there.
+IN_PROC_BROWSER_TEST_F(DarkPagesButtonTest, PopupsHaveNoButton) {
+  BrowserWindowInterface* const popup = CreateBrowserForPopup(profile());
+  EXPECT_FALSE(ButtonOf(popup));
+  EXPECT_TRUE(ButtonOf(browser()));
+  ASSERT_TRUE(chrome::ExecuteCommand(popup, IDC_STEDDING_TOGGLE_DARK_PAGES));
+  EXPECT_TRUE(stedding::DarkPagesOn(profile()));
+}
+
+// Dk17: "Show the dark pages button" off hides it in every window at once;
+// the switch still works from the window's command.
+IN_PROC_BROWSER_TEST_F(DarkPagesButtonTest, TheSettingHidesTheButton) {
+  BrowserWindowInterface* const second = CreateBrowser(profile());
+  ASSERT_TRUE(ButtonOf(browser()) && ButtonOf(second));
+  profile()->GetPrefs()->SetBoolean(stedding::prefs::kDarkPagesButton, false);
+  EXPECT_FALSE(ButtonOf(browser())->GetVisible());
+  EXPECT_FALSE(ButtonOf(second)->GetVisible());
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_DARK_PAGES));
+  EXPECT_TRUE(stedding::DarkPagesOn(profile()));
+  profile()->GetPrefs()->SetBoolean(stedding::prefs::kDarkPagesButton, true);
+  EXPECT_TRUE(ButtonOf(browser())->GetVisible());
+  EXPECT_TRUE(ButtonOf(browser())->is_on());
+}
+
+// Dk18: the chord as keys into the window, the way the keyboard's arrive,
+// from the page and from the address field. The Mac's key path goes through
+// Cocoa's key equivalents, which a browser test cannot press; its table row
+// is ShortcutReferenceTest.DarkPagesHasAChordOfItsOwn's, and the key itself
+// is a live check (docs/features/acceptance.md).
+#if !BUILDFLAG(IS_MAC)
+class DarkPagesKeysTest : public DarkPagesTest {};
+
+IN_PROC_BROWSER_TEST_F(DarkPagesKeysTest, TheChordTogglesFromAPageAndAField) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser());
+  views::Widget* const widget = view->GetWidget();
+  const auto press = [&]() {
+    widget->Activate();
+    ui::test::EventGenerator generator(views::GetRootWindow(widget),
+                                       view->GetNativeWindow());
+    generator.PressAndReleaseKey(
+        ui::VKEY_D, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN);
+    base::RunLoop().RunUntilIdle();
+  };
+  {
+    SCOPED_TRACE("from the page");
+    view->GetFocusManager()->ClearFocus();
+    press();
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return stedding::DarkPagesOn(profile()); }));
+    EXPECT_TRUE(WaitForProbe(page(), kDark));
+  }
+  {
+    SCOPED_TRACE("from the address field");
+    chrome::FocusLocationBar(browser());
+    press();
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return !stedding::DarkPagesOn(profile()); }));
+    EXPECT_TRUE(WaitForProbe(page(), kLight));
+  }
+  {
+    SCOPED_TRACE("from a private window");
+    BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+    BrowserView* const private_view =
+        BrowserView::GetBrowserViewForBrowser(incognito);
+    private_view->GetWidget()->Activate();
+    ui::test::EventGenerator generator(
+        views::GetRootWindow(private_view->GetWidget()),
+        private_view->GetNativeWindow());
+    generator.PressAndReleaseKey(
+        ui::VKEY_D, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return stedding::DarkPagesOn(profile());
+    })) << "the profile's switch, from a private window";
+  }
+}
+#endif  // !BUILDFLAG(IS_MAC)
+
+}  // namespace
