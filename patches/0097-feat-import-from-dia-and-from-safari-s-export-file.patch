+// A policy that turns a part on or off: it counts only when it is set by
+// policy, as Chromium's own importers read it.
+bool ManagedOff(const PrefService& prefs, const char* pref) {
+  return prefs.IsManagedPreference(pref) && !prefs.GetBoolean(pref);
+}
+bool ManagedOn(const PrefService& prefs, const char* pref) {
+  return prefs.IsManagedPreference(pref) && prefs.GetBoolean(pref);
+}
+
+bool IsWebPage(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+
+// The folder a merge writes into: the one remembered for `source_key`, else
+// a new one under Other bookmarks, remembered from now on.
+const bookmarks::BookmarkNode* SourceFolder(bookmarks::BookmarkModel& model,
+                                            PrefService& prefs,
+                                            std::string_view source_key,
+                                            const std::u16string& title) {
+  const base::DictValue& folders =
+      prefs.GetDict(prefs::kImportedBookmarkFolders);
+  if (const std::string* const remembered = folders.FindString(source_key)) {
+    const base::Uuid uuid = base::Uuid::ParseLowercase(*remembered);
+    if (uuid.is_valid()) {
+      const bookmarks::BookmarkNode* const node = model.GetNodeByUuid(
+          uuid, bookmarks::BookmarkModel::NodeTypeForUuidLookup::
+                    kLocalOrSyncableNodes);
+      if (node && node->is_folder() && !node->is_permanent_node()) {
+        return node;
+      }
+    }
+  }
+  // import I40: none yet, or the user deleted it; the import was asked for,
+  // so its folder is made (again).
+  const bookmarks::BookmarkNode* const other = model.other_node();
+  const bookmarks::BookmarkNode* const made =
+      model.AddFolder(other, other->children().size(), title);
+  ScopedDictPrefUpdate update(&prefs, prefs::kImportedBookmarkFolders);
+  update->Set(source_key, made->uuid().AsLowercaseString());
+  return made;
+}
+
+// Finds a node's child folders and pages once, as a merge adds to them.
+class FolderIndex {
+ public:
+  explicit FolderIndex(bookmarks::BookmarkModel& model) : model_(model) {}
+
+  // The folder `title` inside `parent`, made when there is none.
+  const bookmarks::BookmarkNode* Folder(const bookmarks::BookmarkNode* parent,
+                                        const std::u16string& title) {
+    Entry& entry = Of(parent);
+    if (const auto found = entry.folders.find(title);
+        found != entry.folders.end()) {
+      return found->second;
+    }
+    const bookmarks::BookmarkNode* const made =
+        model_->AddFolder(parent, parent->children().size(), title);
+    entry.folders.emplace(title, made);
+    return made;
+  }
+
+  // Adds a page to `parent`; false when it holds that page already.
+  bool AddPage(const bookmarks::BookmarkNode* parent,
+               const std::u16string& title,
+               const GURL& url,
+               base::Time created) {
+    Entry& entry = Of(parent);
+    if (!entry.pages.insert(url).second) {
+      return false;
+    }
+    model_->AddURL(parent, parent->children().size(),
+                   title.empty() ? base::UTF8ToUTF16(url.spec()) : title, url,
+                   /*meta_info=*/nullptr,
+                   created.is_null() ? std::nullopt
+                                     : std::optional<base::Time>(created));
+    return true;
+  }
+
+ private:
+  struct Entry {
+    std::map<std::u16string, raw_ptr<const bookmarks::BookmarkNode>> folders;
+    std::set<GURL> pages;
+  };
+
+  Entry& Of(const bookmarks::BookmarkNode* node) {
+    auto [it, inserted] = index_.try_emplace(node->id());
+    if (inserted) {
+      for (const auto& child : node->children()) {
+        if (child->is_folder()) {
+          it->second.folders.try_emplace(child->GetTitle(), child.get());
+        } else {
+          it->second.pages.insert(child->url());
+        }
+      }
+    }
+    return it->second;
+  }
+
+  const raw_ref<bookmarks::BookmarkModel> model_;
+  // By node id.
+  std::map<int64_t, Entry> index_;
+};
