#!/usr/bin/env bash
# Forwards to capture-state. This name does not look up a window.
#
# Older commands still pass the same flags (--out, --size, --url, --features,
# --disable-features, --build). With no --out the image is ui-capture.png in
# the repo root; with no --url and no positional URL the page is example.com.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"

for arg in "$@"; do
  case "$arg" in
    -h|--help) exec "$here/capture-state" --help ;;
  esac
done

has_out=0
has_url=0
has_positional=0
expect=""
for arg in "$@"; do
  if [ -n "$expect" ]; then
    expect=""
    continue
  fi
  case "$arg" in
    --out=*) has_out=1 ;;
    --url=*) has_url=1 ;;
    --out) has_out=1; expect=value ;;
    --url) has_url=1; expect=value ;;
    --*) ;;
    *) has_positional=1 ;;
  esac
done

if [ "$has_out" -eq 0 ]; then
  set -- --out "$root/ui-capture.png" "$@"
fi
if [ "$has_url" -eq 0 ] && [ "$has_positional" -eq 0 ]; then
  set -- --url "https://example.com/" "$@"
fi

exec "$here/capture-state" "$@"
