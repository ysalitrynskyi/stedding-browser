+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_CLEAR_TABS_SEPARATOR_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_CLEAR_TABS_SEPARATOR_H_
+
+#include "base/functional/callback.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/separator.h"
+
+// The line between pinned and unpinned tabs, with a Clear at its trailing end.
+//
+// A views::Separator subclass rather than a sibling view because
+// TabStripViewLayout positions the separator by pointer and type; swapping the
+// instance keeps that layout untouched. With no callback set it paints as a
+// plain hairline, so popups and tests see the stock separator.
+class ClearTabsSeparator : public views::Separator {
+  METADATA_HEADER(ClearTabsSeparator, views::Separator)
+
+ public:
+  ClearTabsSeparator();
+  ~ClearTabsSeparator() override;
+
+  // Shows the Clear affordance and runs `callback` when it is pressed.
+  void SetClearCallback(base::RepeatingClosure callback);
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  std::u16string GetRenderedTooltipText(const gfx::Point& p) const override;
+
+ private:
+  // The rect the Clear label was last painted in, for hit testing.
+  gfx::Rect clear_rect_;
+  bool pressed_in_clear_ = false;
+  base::RepeatingClosure clear_callback_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_CLEAR_TABS_SEPARATOR_H_
