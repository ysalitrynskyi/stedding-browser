+// How many times the container told its delegate that its bars changed.
+class CountingDelegate : public InfoBarContainer::Delegate {
+ public:
+  void InfoBarContainerStateChanged(bool is_animating) override {
+    EXPECT_FALSE(is_animating);
+    ++calls_;
+  }
+
+  int calls() const { return calls_; }
+
+ private:
+  int calls_ = 0;
+};
+
+// Stedding (toolbar T33, BACKLOG S-227): a bar removed without its animation
+// tells the delegate once it is out of the container, as one added without
+// its animation does. The browser window updates the page and a web app's
+// title bar on that word, and an empty band stayed over the page without it.
+TEST(InfoBarContainerTest, ARemovalWithoutAnimationTellsTheDelegate) {
+  CountingDelegate delegate;
+  TestInfoBarContainer container(&delegate);
+  TestInfoBarManager manager;
+  container.ChangeInfoBarManager(&manager);
+
+  auto* infobar = manager.AddInfoBar(
+      std::make_unique<TestInfoBar>(std::make_unique<TestDelegate>()));
+  ASSERT_TRUE(infobar);
+  const int after_add = delegate.calls();
+  EXPECT_GT(after_add, 0) << "an add without its animation tells the delegate";
+
+  manager.RemoveInfoBar(infobar);
+  EXPECT_EQ(1u, container.remove_calls());
+  EXPECT_EQ(after_add + 1, delegate.calls())
+      << "a removal without its animation told the delegate nothing";
+}
+
 }  // namespace
 }  // namespace infobars
