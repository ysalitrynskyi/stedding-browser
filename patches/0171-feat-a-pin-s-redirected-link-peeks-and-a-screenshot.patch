@@ -440,6 +440,52 @@ IN_PROC_BROWSER_TEST_F(PeekTest, ALinkWaitsForThePeeksLeaveSiteAnswer) {
 
 // P2, P4, P11: a link on the pin's own site, or a script's click with no
 // gesture from the user, goes on in the pinned tab.
+// P22 (BACKLOG S-93, PLAN.md CMD-29): a link the server sends to another site
+// opens a peek there, and the pin stays where it was.
+IN_PROC_BROWSER_TEST_F(PeekTest, AServerRedirectToAnotherSiteOpensAPeek) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(
+      OpenPin(Url("a.test", "/server-redirect?" + to.spec())));
+  ClickLink();
+  BrowserWindowInterface* const peek = WaitForPeek();
+  ASSERT_TRUE(peek) << "the redirect stayed in the pin";
+  content::WebContents* const page =
+      peek->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  EXPECT_EQ(to, page->GetLastCommittedURL());
+  EXPECT_EQ(Url("a.test", "/title1.html"), contents()->GetLastCommittedURL());
+  EXPECT_EQ(1, Requests()) << "the page was asked for twice";
+}
+
+// P22, P16: a redirect on the pin's own site stays, and so does one to a
+// sign-in page and whatever a sign-in sends the link to next.
+IN_PROC_BROWSER_TEST_F(PeekTest, ASignInOrSameSiteRedirectStaysInThePin) {
+  {
+    SCOPED_TRACE("the pin's own site");
+    const GURL to = Url("a.test", "/title3.html");
+    ASSERT_NO_FATAL_FAILURE(
+        OpenPin(Url("a.test", "/server-redirect?" + to.spec())));
+    content::TestNavigationObserver done(contents());
+    ClickLink();
+    done.Wait();
+    EXPECT_EQ(to, contents()->GetLastCommittedURL());
+    EXPECT_FALSE(stedding::PeekOver(browser()));
+  }
+  {
+    SCOPED_TRACE("through a sign-in page to another site");
+    const GURL to = Url("b.test", "/title3.html");
+    const GURL sign_in =
+        Url("accounts.c.test", "/server-redirect?" + to.spec());
+    ASSERT_NO_FATAL_FAILURE(
+        OpenPin(Url("a.test", "/server-redirect?" + sign_in.spec())));
+    content::TestNavigationObserver done(contents());
+    ClickLink();
+    done.Wait();
+    EXPECT_EQ(to, contents()->GetLastCommittedURL());
+    EXPECT_FALSE(stedding::PeekOver(browser()));
+  }
+}
+
 IN_PROC_BROWSER_TEST_F(PeekTest, ASameSiteLinkOrAScriptsClickStaysInThePin) {
   {
     SCOPED_TRACE("the pin's own site");
