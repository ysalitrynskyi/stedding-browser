+
+void SafariExportImporter::Prepare(const base::FilePath& path,
+                                   PreparedCallback done) {
+  prepared_ = false;
+  summary_ = SafariExportSummary();
+  bookmarks_.clear();
+  passwords_.clear();
+  worker_.AsyncCall(&SafariExportWorker::Open)
+      .WithArgs(path, base::BindPostTaskToCurrentDefault(base::BindOnce(
+                          &SafariExportImporter::OnOpened,
+                          weak_factory_.GetWeakPtr(), std::move(done))));
+}
+
+void SafariExportImporter::OnOpened(PreparedCallback done,
+                                    SafariExportRead read) {
+  summary_ = read.summary;
+  bookmarks_ = std::move(read.bookmarks);
+  if (read.passwords_csv.empty()) {
+    FinishPrepare(std::move(done));
+    return;
+  }
+  if (!csv_parser_) {
+    if (csv_parser_for_testing_) {
+      csv_parser_.Bind(std::move(csv_parser_for_testing_));
+    } else {
+      csv_parser_ = password_manager::LaunchCSVPasswordParser();
+    }
+    csv_parser_.reset_on_disconnect();
+  }
+  // import I35: in the sandboxed parser. A parser that dies answers with
+  // nothing rather than never.
+  csv_parser_->ParseCSV(
+      std::move(read.passwords_csv),
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&SafariExportImporter::OnPasswordsParsed,
+                         weak_factory_.GetWeakPtr(), std::move(done)),
+          password_manager::mojom::CSVPasswordSequencePtr()));
+}
+
+void SafariExportImporter::OnPasswordsParsed(
+    PreparedCallback done,
+    password_manager::mojom::CSVPasswordSequencePtr seq) {
+  if (!seq) {
+    summary_.passwords_unreadable = true;
+  } else if (seq->csv_passwords.size() > kMaxSafariPasswords) {
+    summary_.too_many_passwords = true;
+  } else {
+    passwords_ = std::move(seq->csv_passwords);
+    summary_.passwords = passwords_.size();
+  }
+  FinishPrepare(std::move(done));
+}
+
+void SafariExportImporter::FinishPrepare(PreparedCallback done) {
+  prepared_ = summary_.opened && summary_.HoldsAnything();
+  std::move(done).Run(summary_);
+}
+
+// static
+void SafariExportImporter::Commit(
+    std::unique_ptr<SafariExportImporter> importer,
+    Profile& profile,
+    SafariExportParts parts,
+    DoneCallback done) {
+  SafariExportResult refused;
+  if (!importer || !importer->prepared_) {
+    refused.not_prepared = true;
+    std::move(done).Run(refused);
+    return;
+  }
+  ImportJobs& jobs = ImportJobs::For(profile);
+  SafariExportImporter* const running = importer.get();
+  if (!jobs.Start(kSafariSourceKey, std::move(importer))) {
+    refused.already_running = true;
+    std::move(done).Run(refused);
+    return;
+  }
+  running->Run(profile, parts, std::move(done));
+}
+
+void SafariExportImporter::Run(Profile& profile,
+                               SafariExportParts parts,
+                               DoneCallback done) {
+  profile_ = profile.GetWeakPtr();
+  done_ = std::move(done);
+  const ImportsAllowed allowed = AllowedImports(*profile.GetPrefs());
+  result_.cards = summary_.cards;
+  result_.passwords_in_file = summary_.passwords;
+  result_.passwords_asked = parts.passwords && allowed.passwords;
+  result_.bookmarks_blocked = parts.bookmarks && !allowed.bookmarks;
+  result_.history_blocked = parts.history && !allowed.history;
+  result_.passwords_blocked = parts.passwords && !allowed.passwords;
+  const bool bookmarks =
+      parts.bookmarks && allowed.bookmarks && !bookmarks_.empty();
+  const bool history = parts.history && allowed.history && summary_.history;
+  const bool passwords =
+      parts.passwords && allowed.passwords && !passwords_.empty();
+  // One more than the parts, so nothing ends before every part has started.
+  pending_ = 1 + bookmarks + history + passwords;
+  if (bookmarks) {
+    bookmarks::BookmarkModel* const model =
+        BookmarkModelFactory::GetForBrowserContext(&profile);
+    if (model) {
+      bookmarks_waiter_ = std::make_unique<BookmarksLoadedWaiter>(
+          model, base::BindOnce(&SafariExportImporter::WriteBookmarks,
+                                weak_factory_.GetWeakPtr()));
+    } else {
+      PartDone();
+    }
+  }
+  if (history) {
+    worker_.AsyncCall(&SafariExportWorker::ReadHistory)
+        .WithArgs(base::Time::Now(), kMaxSafariHistoryRows)
+        .Then(base::BindOnce(&SafariExportImporter::OnHistoryRead,
+                             weak_factory_.GetWeakPtr()));
+  }
+  if (passwords) {
+    passwords_writer_ = std::make_unique<ImportedPasswordsWriter>(profile);
+    passwords_writer_->Write(
+        std::move(passwords_),
+        base::BindOnce(&SafariExportImporter::OnPasswordsWritten,
+                       weak_factory_.GetWeakPtr()));
+  }
+  PartDone();
+}
+
+void SafariExportImporter::WriteBookmarks() {
+  bookmarks::BookmarkModel* const model =
+      profile_ ? BookmarkModelFactory::GetForBrowserContext(profile_.get())
+               : nullptr;
+  if (model) {
+    const BookmarkMergeResult merged = MergeImportedBookmarks(
+        *model, *profile_->GetPrefs(), kSafariSourceKey,
+        u"Imported from Safari", u"Favorites", bookmarks_);
+    result_.bookmarks = merged.added;
+    result_.bookmarks_already = merged.already_there;
+  }
+  PartDone();
+}
+
+void SafariExportImporter::OnHistoryRead(SafariHistoryRead read) {
+  result_.history_capped = read.capped;
+  result_.history_files_too_big = read.files_too_big;
+  history::HistoryService* const service =
+      profile_ ? HistoryServiceFactory::GetForProfile(
+                     profile_.get(), ServiceAccessType::EXPLICIT_ACCESS)
+               : nullptr;
+  if (!service) {
+    PartDone();
+    return;
+  }
+  AddNewVisits(*service, std::move(read.rows),
+               history::SOURCE_SAFARI_IMPORTED, history_tracker_,
+               base::BindOnce(&SafariExportImporter::OnHistoryAdded,
+                              weak_factory_.GetWeakPtr()));
+}
+
+void SafariExportImporter::OnHistoryAdded(size_t added) {
+  result_.history = added;
+  PartDone();
+}
+
+void SafariExportImporter::OnPasswordsWritten(PasswordWriteResult written) {
+  result_.passwords = written;
+  PartDone();
+}
+
+void SafariExportImporter::PartDone() {
+  if (--pending_ > 0) {
+    return;
+  }
+  DoneCallback done = std::move(done_);
+  const SafariExportResult result = result_;
+  // Lets this go after the current task; `done` runs first.
+  if (profile_) {
+    ImportJobs::For(*profile_).Finish(kSafariSourceKey);
+  }
+  if (done) {
+    std::move(done).Run(result);
+  }
+}
