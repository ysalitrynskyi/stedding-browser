+// no fill and no close button. Added back to the window inside the new folder,
+// the row asked the screen for the pointer before the folder had laid it out,
+// at its old place, where the pointer still rested after the menu; it took a
+// hover that the window never ended, and kept it until the pointer crossed
+// it again.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ARowMovedFromUnderThePointerRests) {
+  CloseDownToOne();
+  tabs::FolderTabCollection* const folder = MakeFolder();  // [0, F[1, 2], 3]
+  ASSERT_TRUE(folder);
+  tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(2);
+  tab_strip_model()->ActivateTabAt(2);
+  TabView* row = DrawnRow(tab);
+  ASSERT_TRUE(row);
+
+  // The pointer moves to `point` on the screen, as the window hands a real
+  // move to its views.
+  const auto pointer_to = [&](gfx::Point point) {
+    views::View* const root = widget()->GetRootView();
+    views::View::ConvertPointFromScreen(root, &point);
+    root->OnMouseMoved(ui::MouseEvent(ui::EventType::kMouseMoved, point, point,
+                                      base::TimeTicks::Now(), ui::EF_NONE,
+                                      ui::EF_NONE));
+  };
+  // The pointer rests on the row, as when its menu is opened there.
+  const gfx::Point rest = row->GetBoundsInScreen().CenterPoint();
+  pointer_to(rest);
+  ASSERT_TRUE(row->IsHoverAnimationActive()) << "the row never saw the pointer";
+
+  // Move Tab to New Folder, the pointer still where the menu was.
+  {
+    PointerRestingAt pointer(rest);
+    tab_strip_model()->ExecuteContextMenuCommand(
+        tab_strip_model()->GetIndexOfTab(tab),
+        TabStripModel::CommandMoveTabToNewFolder);
+  }
+  const tabs::TabCollection* const nested = tab->GetParentCollection();
+  ASSERT_EQ(tabs::TabCollection::Type::FOLDER, nested->type());
+  ASSERT_EQ(folder, nested->GetParentCollection())
+      << "the row's new folder is not inside its old one";
+  row = DrawnRow(tab);
+  ASSERT_TRUE(row);
+  ASSERT_FALSE(row->GetBoundsInScreen().Contains(rest))
+      << "the row did not move from under the pointer";
+
+  // The pointer leaves for the page; Sleep Tab from the command bar.
+  pointer_to(BrowserView::GetBrowserViewForBrowser(browser())
+                 ->contents_web_view_for_testing()
+                 ->GetBoundsInScreen()
+                 .CenterPoint());
+  stedding::SleepTabs(browser(), tab, stedding::SleepScope::kThisTab);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return tab->GetContents()->WasDiscarded(); }));
+  ASSERT_NE(tab, tab_strip_model()->GetActiveTab());
+  ASSERT_FALSE(
+      tab_strip_model()->IsTabSelected(tab_strip_model()->GetIndexOfTab(tab)));
+
+  row = DrawnRow(tab);
+  ASSERT_TRUE(row);
+  EXPECT_FALSE(row->IsActive());
+  EXPECT_TRUE(
+      base::test::RunUntil([&]() { return !row->IsHoverAnimationActive(); }))
+      << "the slept row kept a hover the pointer had left";
+  views::test::RunScheduledLayout(widget());
+  EXPECT_FALSE(row->close_button_for_testing()->GetVisible())
+      << "the slept row shows its close button with the pointer away";
+  // Drawn as the first row, which the pointer never visited: no fill.
+  TabView* const resting = DrawnRow(tab_strip_model()->GetTabAtIndex(0));
+  ASSERT_TRUE(resting);
+  ASSERT_FALSE(resting->IsActive());
+  const auto fill = [](TabView* view) {
+    gfx::Canvas canvas(view->size(), 1.0f, /*is_opaque=*/true);
+    canvas.DrawColor(SK_ColorRED);
+    // The row's own paint, its fill: the favicon, the title and the close
+    // button are its children.
+    view->PaintRowForTesting(&canvas);
+    return canvas.GetBitmap().getColor(view->width() / 2, view->height() / 2);
+  };
+  EXPECT_EQ(fill(resting), fill(row))
+      << "the slept row is drawn with a fill the resting row does not have";
+}
