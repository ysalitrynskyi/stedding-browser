+ArcImportResult ImportNodesAsPins(
+    BrowserWindowInterface* browser,
+    const std::vector<ArcImportPlan::Node>& nodes) {
+  ArcImportResult result;
+  SpaceModel* const model = browser ? SpaceModel::From(browser) : nullptr;
+  TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
+  Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  if (!model || !tabs || !profile) {
+    return result;
+  }
+  ImportedIds ids(profile->GetPrefs());
+  ApplyContext ctx{browser, model, tabs, profile, &ids, &result};
+  SpaceModel::ScopedRoutingPause no_routing(model);
+  const SpaceId space = model->active_id();
+  std::vector<tabs::TabInterface*> loose =
+      InsertNodes(ctx, nodes, space, nullptr);
+  for (auto it = loose.rbegin(); it != loose.rend(); ++it) {
+    model->SetSpacePinned(*it, true);
+  }
+  ids.Save();
+  return result;
+}
