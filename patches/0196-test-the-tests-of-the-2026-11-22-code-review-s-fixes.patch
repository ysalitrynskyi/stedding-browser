+namespace {
+
+// tabs R61 ---------------------------------------------------------------
+
+// Over the first window's page, hands a tab drag to `to`, another window's
+// list: what the drag does once the pointer reaches another window's
+// sidebar, without asking the system which window is under the pointer.
+class HandOverTargetB24 : public TabDragTarget {
+ public:
+  explicit HandOverTargetB24(TabDragContext* to) : to_(to) {}
+  HandOverTargetB24(const HandOverTargetB24&) = delete;
+  HandOverTargetB24& operator=(const HandOverTargetB24&) = delete;
+  ~HandOverTargetB24() override { will_destroy_.Notify(); }
+
+  bool handed_over() const { return handed_over_; }
+
+  // TabDragTarget:
+  void OnTabDragEntered() override {}
+  TabDragContext* OnTabDragUpdated(TabDragTarget::DragController& controller,
+                                   const gfx::Point& point_in_screen) override {
+    handed_over_ = true;
+    return to_;
+  }
+  void OnTabDragExited(const gfx::Point& point_in_screen) override {}
+  void OnTabDragEnded() override {}
+  bool CanDropTab() override { return false; }
+  void HandleTabDrop(TabDragTarget::DragController& controller) override {}
+  bool HoldsAttachedTabs() const override { return true; }
+  base::CallbackListSubscription RegisterWillDestroyCallback(
+      base::OnceClosure callback) override {
+    return will_destroy_.Add(std::move(callback));
+  }
+
+ private:
+  const raw_ptr<TabDragContext> to_;
+  bool handed_over_ = false;
+  base::OnceClosureList will_destroy_;
+};
+
+// The drag's targets outside the strips: `target` over the page of `from`,
+// the browser's own everywhere else.
+class HandOverResolverB24 : public TabDragPointResolver {
+ public:
+  HandOverResolverB24(BrowserView* from, TabDragTarget* target)
+      : from_(from), target_(target) {}
+  HandOverResolverB24(const HandOverResolverB24&) = delete;
+  HandOverResolverB24& operator=(const HandOverResolverB24&) = delete;
+  ~HandOverResolverB24() override = default;
+
+  // TabDragPointResolver:
+  TabDragTarget* GetDragTarget(BrowserView& browser_view,
+                               const gfx::Point& point_in_screen) override {
+    if (&browser_view == from_.get() &&
+        browser_view.multi_contents_view()->GetBoundsInScreen().Contains(
+            point_in_screen)) {
+      return target_.get();
+    }
+    return browser_view.GetTabDragTarget(point_in_screen);
+  }
+
+ private:
+  const raw_ptr<BrowserView> from_;
+  const raw_ptr<TabDragTarget> target_;
+};
+
+// `resolver` finds the drag's targets while this lives.
+class ScopedResolverB24 {
+ public:
+  explicit ScopedResolverB24(TabDragPointResolver* resolver) {
+    TabDragController::SetTabDragPointResolverForTesting(resolver);
+  }
+  ScopedResolverB24(const ScopedResolverB24&) = delete;
+  ScopedResolverB24& operator=(const ScopedResolverB24&) = delete;
+  ~ScopedResolverB24() {
+    TabDragController::SetTabDragPointResolverForTesting(nullptr);
+  }
+};
+
+class TabPressDragB24Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    stedding::test::KeepAboveOtherWindows(widget());
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+
+  // A new foreground tab showing `host`, loaded.
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title1.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tab_strip_model()->GetActiveTab();
+  }
+
+  gfx::Point RowCentre(const tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    TabView* const row =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+    CHECK(row);
+    return row->GetBoundsInScreen().CenterPoint();
+  }
+};
+
+// P32-1a, tabs R61: a press on a row whose page is not on screen, dragged
+// into another window and dropped there, leaves the window it left following
+// its active tab again. That window held its page on screen for the drag,
+// and only the window the drag ended in let go of a hold: the window it left
+// kept the held page and its address row whatever row was selected in it
+// afterwards, and Cmd-W closed a tab it did not show.
+IN_PROC_BROWSER_TEST_F(TabPressDragB24Test,
+                       ARowDraggedIntoAnotherWindowLetsItsWindowFollowItsTabs) {
+  tabs::TabInterface* const dragged = Open("dragged-away.test");
+  tabs::TabInterface* const later = Open("picked-later.test");
+  tabs::TabInterface* const shown = Open("shown-first.test");
+  ASSERT_EQ(shown, tab_strip_model()->GetActiveTab());
+
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(second);
+  tabs::VerticalTabStripStateController::From(second)->SetVerticalTabsEnabled(
+      true);
+  BrowserView* const second_view =
+      BrowserView::GetBrowserViewForBrowser(second);
+  ASSERT_TRUE(second_view);
+  views::test::RunScheduledLayout(second_view->GetWidget());
+  VerticalTabStripRegionView* const second_sidebar =
+      second_view->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(second_sidebar);
+  TabDragContext* const second_list = second_sidebar->GetDragContext();
+  ASSERT_TRUE(second_list);
+  // The first window stays above the second, so the drag finds it under
+  // every point it passes over it.
+  stedding::test::KeepAboveOtherWindows(widget());
+  ASSERT_TRUE(stedding::test::WaitUntilUncovered(widget()))
+      << "another window still covers the first";
+  views::test::RunScheduledLayout(widget());
+
+  HandOverTargetB24 target(second_list);
+  HandOverResolverB24 resolver(browser_view(), &target);
+  ScopedResolverB24 scoped_resolver(&resolver);
+
+  // The press on the row not on screen, and a drag in twelve steps to the
+  // page, where the drag goes over to the second window.
+  const tabs::TabHandle dragged_handle = dragged->GetHandle();
+  const gfx::Point from = RowCentre(dragged);
+  const gfx::Rect page =
+      browser_view()->multi_contents_view()->GetBoundsInScreen();
+  const gfx::Point to(page.x() + page.width() / 4, page.CenterPoint().y());
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, from);
+  for (int step = 1; step <= 12; ++step) {
+    stedding::test::SendLeftMouse(
+        widget(), ui::EventType::kMouseDragged,
+        gfx::Point(from.x() + (to.x() - from.x()) * step / 12,
+                   from.y() + (to.y() - from.y()) * step / 12));
+  }
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(target.handed_over()) << "the drag never reached the page";
+  ASSERT_TRUE(TabDragController::IsAttachedTo(second_list))
+      << "the drag did not go over to the second window";
+  ASSERT_TRUE(browser_view()->stedding_page_held())
+      << "the drag held no page in the window it left";
+
+  // The release goes where the drag's capture is: the second window's list,
+  // which took the drag over.
+  gfx::Point at = to;
+  views::View::ConvertPointFromScreen(second_list, &at);
+  const ui::MouseEvent release(ui::EventType::kMouseReleased, at, at,
+                               ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+                               ui::EF_LEFT_MOUSE_BUTTON);
+  second_list->OnMouseReleased(release);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(base::test::RunUntil(
+      []() { return !TabDragController::IsActive(); }))
+      << "the drag did not end";
+  tabs::TabInterface* const moved = dragged_handle.Get();
+  ASSERT_TRUE(moved);
+  EXPECT_NE(TabStripModel::kNoTab,
+            second->GetTabStripModel()->GetIndexOfTab(moved))
+      << "the row did not move into the second window";
+  EXPECT_EQ(TabStripModel::kNoTab, tab_strip_model()->GetIndexOfTab(moved));
+
+  EXPECT_FALSE(browser_view()->stedding_page_held())
+      << "the window the row left still holds its page";
+  tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(later));
+  EXPECT_EQ(later->GetContents(),
+            browser_view()->GetActiveContentsWebView()->web_contents())
+      << "the row selected after the drag did not bring its page";
+}
