new file mode 100644
index 0000000000000..71a937d44b7f1
--- /dev/null
+++ b/chrome/browser/ui/stedding/stedding_version.cc
@@ -0,0 +1,38 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/stedding_version.h"
+
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/version_info/version_info.h"
+#include "chrome/browser/ui/stedding/stedding_version_buildflags.h"
+
+namespace stedding {
+
+std::u16string FormatAboutVersion(std::string_view stedding_version,
+                                  std::string_view chromium_version,
+                                  std::u16string_view processor) {
+  std::u16string line;
+  if (!stedding_version.empty()) {
+    line = base::StrCat(
+        {u"Stedding ", base::UTF8ToUTF16(stedding_version), u" · "});
+  }
+  line += base::StrCat({u"Chromium ", base::UTF8ToUTF16(chromium_version)});
+  if (!processor.empty()) {
+    line += base::StrCat({u" ", processor});
+  }
+  return line;
+}
+
+std::u16string AboutVersionString(std::u16string_view processor) {
+  return FormatAboutVersion(SteddingVersion(), version_info::GetVersionNumber(),
+                            processor);
+}
+
+std::string_view SteddingVersion() {
+  return BUILDFLAG(STEDDING_VERSION);
+}
+
+}  // namespace stedding
