+    devices.video_device = device;
+    std::unique_ptr<content::MediaStreamUI> ui =
+        MediaCaptureDevicesDispatcher::GetInstance()
+            ->GetMediaStreamCaptureIndicator()
+            ->RegisterMediaStream(tab->GetContents(), devices);
+    ui->OnStarted(base::DoNothing(), base::DoNothing(), std::string(), {},
+                  base::DoNothing());
+    return ui;
+  }
+
+  static bool Asleep(tabs::TabInterface* tab) {
+    return tab->GetContents()->WasDiscarded();
+  }
+};
+
+// splits J4, tabs R5: Sleep Tab on the split on screen activates a row
+// outside it, then puts both panes to sleep.
+TEST_F(SleepTabsTest, SleepTabOnTheActiveSplitSleepsBothPanes) {
+  tabs::TabInterface* const plain = OpenTab();
+  tabs::TabInterface* const left = OpenTab();
+  tabs::TabInterface* const right = OpenTab();
+  Split(right, left);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_EQ(right, tabs().GetActiveTab());
+
+  SleepTabs(browser(), right, SleepScope::kThisTab);
+
+  EXPECT_EQ(plain, tabs().GetActiveTab());
+  EXPECT_TRUE(Asleep(left));
+  EXPECT_TRUE(Asleep(right));
+  EXPECT_FALSE(Asleep(plain));
+}
+
+// splits J4, tabs R6: a split sleeps whole or not at all, so a pane holding
+// a USB device keeps both panes awake, and Sleep Tab has nothing to take.
+TEST_F(SleepTabsTest, APaneInUseKeepsItsSplitAwake) {
+  OpenTab();
+  tabs::TabInterface* const left = OpenTab();
+  tabs::TabInterface* const right = OpenTab();
+  Split(right, left);
+  Page(left)->TestIncrementUsbActiveFrameCount();
+
+  EXPECT_TRUE(TabsToSleep(browser(), right, SleepScope::kThisTab).empty());
+  SleepTabs(browser(), right, SleepScope::kThisTab);
+
+  EXPECT_EQ(right, tabs().GetActiveTab());
+  EXPECT_FALSE(Asleep(left));
+  EXPECT_FALSE(Asleep(right));
+}
+
+// tabs R5, splits J4: Sleep Other Tabs, asked from a split's row that a
+// right-click did not activate, sleeps the plain tab and leaves both that
+// row and the split on screen awake.
+TEST_F(SleepTabsTest, SleepOthersKeepsItsOwnRowAndTheScreen) {
+  tabs::TabInterface* const plain = OpenTab();
+  tabs::TabInterface* const asked_left = OpenTab();
+  tabs::TabInterface* const asked_right = OpenTab();
+  tabs::TabInterface* const shown_left = OpenTab();
+  tabs::TabInterface* const shown_right = OpenTab();
+  Split(asked_right, asked_left);
+  Split(shown_right, shown_left);
+  ASSERT_EQ(shown_right, tabs().GetActiveTab());
+
+  SleepTabs(browser(), asked_right, SleepScope::kOthersInSpace);
+
+  EXPECT_TRUE(Asleep(plain));
+  EXPECT_FALSE(Asleep(asked_left));
+  EXPECT_FALSE(Asleep(asked_right));
+  EXPECT_FALSE(Asleep(shown_left));
+  EXPECT_FALSE(Asleep(shown_right));
+  EXPECT_EQ(shown_right, tabs().GetActiveTab());
+}
+
+// tabs R6: when the timer of a Space the user left fires, a plain tab
+// sleeps; a call, a screen share, a USB device and sound keep theirs awake.
+TEST_F(SleepTabsTest, SpaceTimerLeavesTabsInUseAwake) {
+  profile()->GetPrefs()->SetInteger(prefs::kSpaceSleepMinutes, 5);
+  tabs::TabInterface* const plain = OpenTab();
+  tabs::TabInterface* const call = OpenTab();
+  tabs::TabInterface* const share = OpenTab();
+  tabs::TabInterface* const usb = OpenTab();
+  tabs::TabInterface* const playing = OpenTab();
+  const std::unique_ptr<content::MediaStreamUI> camera =
+      Capture(call, blink::MediaStreamDevice(
+                        blink::mojom::MediaStreamType::DEVICE_VIDEO_CAPTURE,
+                        "camera", "camera"));
+  blink::MediaStreamDevice screen(
+      blink::mojom::MediaStreamType::DISPLAY_VIDEO_CAPTURE, "screen",
+      "screen");
+  screen.display_media_info = media::mojom::DisplayMediaInformation::New(
+      media::mojom::DisplayCaptureSurfaceType::MONITOR,
+      /*logical_surface=*/true, media::mojom::CursorCaptureType::NEVER,
+      /*capture_handle=*/nullptr, /*initial_zoom_level=*/100);
+  const std::unique_ptr<content::MediaStreamUI> screen_share =
+      Capture(share, screen);
+  Page(usb)->TestIncrementUsbActiveFrameCount();
+  Page(playing)->SetIsCurrentlyAudible(true);
+
+  space_model().SetActiveSpace(
+      space_model().AddSpace("Other", SK_ColorBLUE)->id());
+  task_environment()->FastForwardBy(base::Minutes(5));
+
+  EXPECT_TRUE(Asleep(plain));
+  EXPECT_FALSE(Asleep(call));
+  EXPECT_FALSE(Asleep(share));
+  EXPECT_FALSE(Asleep(usb));
+  EXPECT_FALSE(Asleep(playing));
+}
+
+// tabs R5-R6: a tab that played sound a moment ago stays awake; once
+// RecentlyAudibleHelper calls it quiet, Sleep Tab puts it to sleep.
+TEST_F(SleepTabsTest, ATabThatJustPlayedSoundStaysAwake) {
+  tabs::TabInterface* const music = OpenTab();
+  OpenTab();
+  Page(music)->SetIsCurrentlyAudible(true);
+  Page(music)->SetIsCurrentlyAudible(false);
+
+  EXPECT_TRUE(TabsToSleep(browser(), music, SleepScope::kThisTab).empty());
+  SleepTabs(browser(), music, SleepScope::kThisTab);
+  EXPECT_FALSE(Asleep(music));
+
+  task_environment()->FastForwardBy(
+      RecentlyAudibleHelper::kRecentlyAudibleTimeout);
+  SleepTabs(browser(), music, SleepScope::kThisTab);
+  EXPECT_TRUE(Asleep(music));
+}
+
+// pins H3: Cmd-W on a pin moves activation on as before; a pin holding a HID
+// device stays loaded behind the new row, and once it lets go, Cmd-W puts
+// the pin to sleep.
+TEST_F(SleepTabsTest, CmdWLeavesAPinInUseLoaded) {
+  tabs::TabInterface* const other = OpenTab();
+  tabs::TabInterface* const pin = OpenTab();
+  space_model().SetSpacePinned(pin, true);
+  Page(pin)->TestIncrementHidActiveFrameCount();
+
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+  EXPECT_EQ(2, tabs().count()) << "the pin stays";
+  EXPECT_EQ(other, tabs().GetActiveTab()) << "activation moved on";
+  EXPECT_FALSE(Asleep(pin));
+
+  Page(pin)->TestDecrementHidActiveFrameCount();
+  Activate(pin);
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+  EXPECT_EQ(other, tabs().GetActiveTab());
+  EXPECT_TRUE(Asleep(pin));
+}
+
+}  // namespace
+}  // namespace stedding
