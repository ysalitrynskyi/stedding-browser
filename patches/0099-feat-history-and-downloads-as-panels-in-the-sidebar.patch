+views::Button* FindButtonWithTooltip(views::View* view,
+                                     const std::u16string& tooltip) {
+  if (auto* const button = views::AsViewClass<views::Button>(view);
+      button && button->GetTooltipText() == tooltip) {
+    return button;
+  }
+  for (views::View* const child : view->children()) {
+    if (views::Button* const found = FindButtonWithTooltip(child, tooltip)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
