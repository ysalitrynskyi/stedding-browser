+
+namespace {
+
+using performance_manager::PerformanceManager;
+using performance_manager::policies::CanDiscardResult;
+using performance_manager::policies::CannotDiscardReason;
+using performance_manager::policies::DiscardEligibilityPolicy;
+using performance_manager::policies::PageDiscardingHelper;
+
+// What makes a page able to ask "Leave site?": a beforeunload handler, run
+// with a user gesture (tabs R6). Chromium's own discards had no such rule.
+constexpr char kAsksBeforeLeaving[] =
+    "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+    "window.addEventListener('beforeunload', window.stay);";
+constexpr char kStopsAsking[] =
+    "window.removeEventListener('beforeunload', window.stay);";
+
+class SleepTimerTestBase
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+
+  // A new tab on screen showing `path` from the test server, loaded; the
+  // tab before it is left, so the order the pages were seen in is the
+  // order they were opened in.
+  tabs::TabInterface* Open(const std::string& path) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(path),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // A sleep replaces the tab's contents: ask the tab.
+  static bool Asleep(tabs::TabInterface* tab) {
+    return tab->GetContents()->WasDiscarded();
+  }
+};
+
+using SleepSweepTest = SleepTimerTestBase;
+
+// tabs R40, R4: the idle sweep, on the window's tabs and the real lifecycle
+// unit, puts the tab nobody has looked at for the chosen time to sleep, and
+// its row is drawn as a slept row; a page that could ask "Leave site?" and a
+// page playing sound stay awake, as does the tab on screen.
+IN_PROC_BROWSER_TEST_F(SleepSweepTest,
+                       AnIdleTabSleepsAndWhatIsInUseStaysAwake) {
+  tabs::TabInterface* const idle = Open("/title1.html");
+  tabs::TabInterface* const asks = Open("/title2.html");
+  ASSERT_TRUE(content::ExecJs(asks->GetContents(), kAsksBeforeLeaving));
+  tabs::TabInterface* const sound = Open("/title3.html");
+  ASSERT_TRUE(
+      content::ExecJs(sound->GetContents(),
+                      "window.context = new AudioContext();"
+                      "const tone = window.context.createOscillator();"
+                      "tone.connect(window.context.destination); tone.start();"
+                      "window.context.resume();"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return sound->GetContents()->IsCurrentlyAudible(); }));
+  tabs::TabInterface* const screen = Open("/title1.html");
+
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetInteger(stedding::prefs::kTabsIdleSleepMinutes, 5);
+  // The window's tabs as an archiver of its own sees them, its clock moved
+  // six minutes on.
+  stedding::TabArchiver archiver(*browser(), *prefs);
+  base::SimpleTestClock clock;
+  clock.SetNow(base::Time::Now() + base::Minutes(6));
+  archiver.set_clock_for_testing(&clock);
+  archiver.SleepSweep();
+
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Asleep(idle); }))
+      << "the idle tab never slept";
+  EXPECT_FALSE(Asleep(asks)) << "it could ask \"Leave site?\"";
+  EXPECT_FALSE(Asleep(sound)) << "playing sound";
+  EXPECT_FALSE(Asleep(screen)) << "on screen";
+  views::Widget* const widget =
+      BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget);
+    TabView* const row =
+        stedding::test::FindDrawnRow(widget->GetRootView(), idle);
+    return row && row->data().is_tab_discarded;
+  })) << "the row is not drawn as a slept row";
+
+  EXPECT_TRUE(content::ExecJs(asks->GetContents(), kStopsAsking));
+  EXPECT_TRUE(content::ExecJs(sound->GetContents(), "window.context.close()"));
+  prefs->SetInteger(stedding::prefs::kTabsIdleSleepMinutes, 0);
+}
+
+// tabs R44, commandbar K34 (BACKLOG S-111): the command bar's "Sleep Other
+// Tabs" puts to sleep, through the real lifecycle unit, the rows of every
+// Space of every window but each window's row on screen and the essentials.
+IN_PROC_BROWSER_TEST_F(SleepSweepTest, SleepOtherTabsRunsFromTheCommandBar) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  tabs::TabInterface* const essential = tabs()->GetActiveTab();
+  tabs()->SetTabPinned(Index(essential), true);
+  tabs::TabInterface* const here = Open("/title2.html");
+  tabs::TabInterface* const elsewhere = Open("/title3.html");
+  tabs::TabInterface* const screen = Open("/title1.html");
+  model->MoveTabsToSpace({elsewhere}, work);
+
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      second, embedded_test_server()->GetURL("/title2.html")));
+  tabs::TabInterface* const there_on_screen =
+      second->GetTabStripModel()->GetActiveTab();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      second, embedded_test_server()->GetURL("/title3.html"),
+      WindowOpenDisposition::NEW_BACKGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const there = second->GetTabStripModel()->GetTabAtIndex(
+      second->GetTabStripModel()->count() - 1);
+  ASSERT_NE(there, there_on_screen);
+
+  // The row, typed into the bar and run with Enter.
+  auto bar = std::make_unique<stedding::CommandBarView>(browser());
+  bar->SetModeForTesting(stedding::CommandBarView::Mode::kActions);
+  bar->ContentsChanged(bar->field_for_testing(), u"Sleep Other Tabs");
+  bool listed = false;
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    listed |= bar->row_title_for_testing(i) == u"Sleep Other Tabs";
+  }
+  ASSERT_TRUE(listed) << "the bar lists no Sleep Other Tabs";
+  while (bar->row_title_for_testing(bar->selected_row_for_testing()) !=
+         u"Sleep Other Tabs") {
+    bar->HandleKeyEvent(bar->field_for_testing(),
+                        ui::KeyEvent(ui::EventType::kKeyPressed,
+                                     ui::VKEY_DOWN, ui::EF_NONE));
+  }
+  bar->HandleKeyEvent(bar->field_for_testing(),
+                      ui::KeyEvent(ui::EventType::kKeyPressed,
+                                   ui::VKEY_RETURN, ui::EF_NONE));
+
+  for (tabs::TabInterface* const tab : {here, elsewhere, there}) {
+    EXPECT_TRUE(base::test::RunUntil([&]() { return Asleep(tab); }));
+  }
+  for (tabs::TabInterface* const tab : {screen, essential, there_on_screen}) {
+    EXPECT_FALSE(Asleep(tab));
+  }
+  EXPECT_EQ(screen, tabs()->GetActiveTab()) << "the screen stays where it was";
+}
+
+class SleepPressureTest : public SleepTimerTestBase {
+ protected:
+  base::WeakPtr<performance_manager::PageNode> PageOf(
+      tabs::TabInterface* tab) {
+    return PerformanceManager::GetPrimaryPageNodeForWebContents(
+        tab->GetContents());
+  }
+
+  // One discard, as Chromium's urgent policy makes it at a critical memory
+  // pressure signal; the minutes a page has been in the background do not
+  // count here.
+  void UrgentDiscard() {
+    PageDiscardingHelper* const helper =
+        PageDiscardingHelper::GetFromGraph(PerformanceManager::GetGraph());
+    ASSERT_TRUE(helper);
+    helper->DiscardAPage(DiscardEligibilityPolicy::DiscardReason::URGENT,
+                         /*ignore_recent_visibility=*/true);
+    base::RunLoop().RunUntilIdle();
+  }
+};
+
+// tabs R42: under memory pressure Chromium's urgent discarding takes the
+// page seen longest ago first, but not a page R6's gate keeps awake: the
+// page that could ask "Leave site?", seen first of all, is protected and
+// stays. A split's pane taken this way brings the other pane with it; the
+// tab on screen stays.
+IN_PROC_BROWSER_TEST_F(SleepPressureTest,
+                       AnUrgentDiscardTakesTheOldestAndSparesWhatIsInUse) {
+  tabs::TabInterface* const asks = Open("/title1.html");
+  ASSERT_TRUE(content::ExecJs(asks->GetContents(), kAsksBeforeLeaving));
+  tabs::TabInterface* const oldest = Open("/title2.html");
+  tabs::TabInterface* const left = Open("/title3.html");
+  tabs::TabInterface* const right = Open("/title1.html");
+  tabs()->ActivateTabAt(Index(left));
+  tabs()->AddToNewSplit({Index(right)}, split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(left->IsSplit());
+  tabs::TabInterface* const newer = Open("/title2.html");
+  tabs::TabInterface* const screen = Open("/title3.html");
+  ASSERT_NE(newer, screen);
+
+  {
+    SCOPED_TRACE("the gate protects the page that could ask");
+    base::WeakPtr<performance_manager::PageNode> page = PageOf(asks);
+    ASSERT_TRUE(page);
+    DiscardEligibilityPolicy* const policy =
+        DiscardEligibilityPolicy::GetFromGraph(PerformanceManager::GetGraph());
+    ASSERT_TRUE(policy);
+    constexpr DiscardEligibilityPolicy::DiscardReason kUrgent =
+        DiscardEligibilityPolicy::DiscardReason::URGENT;
+    std::vector<CannotDiscardReason> reasons;
+    EXPECT_EQ(CanDiscardResult::kProtected,
+              policy->CanDiscard(page.get(), kUrgent,
+                                 /*ignore_recent_visibility=*/true, &reasons));
+    EXPECT_TRUE(
+        std::ranges::contains(reasons, CannotDiscardReason::kOptedOut));
+    base::WeakPtr<performance_manager::PageNode> plain = PageOf(oldest);
+    ASSERT_TRUE(plain);
+    EXPECT_EQ(CanDiscardResult::kEligible,
+              policy->CanDiscard(plain.get(), kUrgent,
+                                 /*ignore_recent_visibility=*/true));
+  }
+  {
+    SCOPED_TRACE("the first discard takes the oldest page it may");
+    UrgentDiscard();
+    EXPECT_TRUE(Asleep(oldest));
+    EXPECT_FALSE(Asleep(asks)) << "it could ask \"Leave site?\"";
+    EXPECT_FALSE(Asleep(left) || Asleep(right) || Asleep(newer));
+  }
+  {
+    SCOPED_TRACE("the next takes a pane, and the split sleeps whole");
+    UrgentDiscard();
+    ASSERT_TRUE(Asleep(left) || Asleep(right)) << "it took the split's pane";
+    EXPECT_TRUE(
+        base::test::RunUntil([&]() { return Asleep(left) && Asleep(right); }))
+        << "the other pane stayed awake";
+    EXPECT_FALSE(Asleep(newer));
+  }
+  {
+    SCOPED_TRACE("then the newer page, never the one that could ask");
+    UrgentDiscard();
+    EXPECT_TRUE(Asleep(newer));
+    UrgentDiscard();
+    EXPECT_FALSE(Asleep(asks));
+    EXPECT_FALSE(Asleep(screen)) << "on screen";
+  }
+  EXPECT_TRUE(content::ExecJs(asks->GetContents(), kStopsAsking));
+}
+
+}  // namespace
