@@ -0,0 +1,205 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/stedding_welcome/stedding_welcome_handler.h"
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engine_choice/search_engine_choice_dialog_service.h"
+#include "chrome/browser/search_engine_choice/search_engine_choice_dialog_service_factory.h"
+#include "chrome/browser/themes/theme_service.h"
+#include "chrome/browser/themes/theme_service_factory.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/search_engine_choice/search_engine_choice_utils.h"
+#include "components/search_engines/search_engine_choice/search_engine_choice_service.h"
+#include "components/search_engines/choice_made_location.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+
+namespace stedding {
+
+WelcomeHandler::WelcomeHandler() = default;
+WelcomeHandler::~WelcomeHandler() = default;
+
+void WelcomeHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getSearchEngines",
+      base::BindRepeating(&WelcomeHandler::HandleGetSearchEngines,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setSearchEngine",
+      base::BindRepeating(&WelcomeHandler::HandleSetSearchEngine,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setAppearance", base::BindRepeating(&WelcomeHandler::HandleSetAppearance,
+                                           base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "getDefaultBrowserState",
+      base::BindRepeating(&WelcomeHandler::HandleGetDefaultBrowserState,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "setDefaultBrowser",
+      base::BindRepeating(&WelcomeHandler::HandleSetDefaultBrowser,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "finish", base::BindRepeating(&WelcomeHandler::HandleFinish,
+                                    base::Unretained(this)));
+}
+
+void WelcomeHandler::HandleGetSearchEngines(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  base::ListValue engines;
+  Profile* const profile = Profile::FromWebUI(web_ui());
+  const auto append = [&engines](const TemplateURL& choice) {
+    base::DictValue engine;
+    engine.Set("prepopulateId", choice.prepopulate_id());
+    engine.Set("name", choice.short_name());
+    engine.Set("iconPath", base::StrCat({"chrome://theme/",
+                                         choice.GetBuiltinImageResourceId()}));
+    engine.Set("url", choice.url());
+    engines.Append(std::move(engine));
+  };
+  if (SearchEngineChoiceDialogService* const service =
+          SearchEngineChoiceDialogServiceFactory::GetForProfile(profile)) {
+    for (const auto& choice : service->GetSearchEngines()) {
+      append(*choice);
+    }
+  } else if (TemplateURLService* const template_urls =
+                 TemplateURLServiceFactory::GetForProfile(profile)) {
+    // Outside the regions where Chromium requires the chooser there is no
+    // dialog service; the list is the same choice-screen data it would use.
+    if (const std::unique_ptr<search_engines::ChoiceScreenData> data =
+            template_urls->GetChoiceScreenData()) {
+      for (const auto& choice : data->search_engines()) {
+        append(*choice);
+      }
+    }
+  }
+  ResolveJavascriptCallback(args[0], engines);
+}
+
+void WelcomeHandler::HandleSetSearchEngine(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  if (!args[0].is_int()) {
+    return;
+  }
+  const int prepopulate_id = args[0].GetInt();
+  Profile* const profile = Profile::FromWebUI(web_ui());
+  if (SearchEngineChoiceDialogService* const service =
+          SearchEngineChoiceDialogServiceFactory::GetForProfile(profile)) {
+    service->NotifyChoiceMade(
+        prepopulate_id, /*save_guest_mode_selection=*/false,
+        SearchEngineChoiceDialogService::EntryPoint::kFirstRunExperience);
+    return;
+  }
+  TemplateURLService* const template_urls =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  if (!template_urls) {
+    return;
+  }
+  for (TemplateURL* const turl : template_urls->GetTemplateURLs()) {
+    if (turl->prepopulate_id() == prepopulate_id) {
+      template_urls->SetUserSelectedDefaultSearchProvider(
+          turl, search_engines::ChoiceMadeLocation::kChoiceScreen);
+      return;
+    }
+  }
+  // Not in the profile's list yet: add it from the choice-screen data.
+  if (const std::unique_ptr<search_engines::ChoiceScreenData> data =
+          template_urls->GetChoiceScreenData()) {
+    for (const auto& choice : data->search_engines()) {
+      if (choice->prepopulate_id() == prepopulate_id) {
+        TemplateURL* const added =
+            template_urls->Add(std::make_unique<TemplateURL>(choice->data()));
+        if (added) {
+          template_urls->SetUserSelectedDefaultSearchProvider(
+              added, search_engines::ChoiceMadeLocation::kChoiceScreen);
+        }
+        return;
+      }
+    }
+  }
+}
+
+void WelcomeHandler::HandleSetAppearance(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  const std::string scheme = args[0].is_string() ? args[0].GetString() : "";
+  ThemeService* const theme =
+      ThemeServiceFactory::GetForProfile(Profile::FromWebUI(web_ui()));
+  if (!theme) {
+    return;
+  }
+  if (scheme == "light") {
+    theme->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kLight);
+  } else if (scheme == "dark") {
+    theme->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kDark);
+  } else {
+    theme->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kSystem);
+  }
+}
+
+void WelcomeHandler::HandleGetDefaultBrowserState(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  const std::string callback_id = args[0].GetString();
+  default_browser_worker_ =
+      base::MakeRefCounted<shell_integration::DefaultBrowserWorker>();
+  default_browser_worker_->StartCheckIsDefault(
+      base::BindOnce(&WelcomeHandler::OnDefaultBrowserState,
+                     weak_factory_.GetWeakPtr(), callback_id));
+}
+
+void WelcomeHandler::HandleSetDefaultBrowser(const base::ListValue& args) {
+  AllowJavascript();
+  default_browser_worker_ =
+      base::MakeRefCounted<shell_integration::DefaultBrowserWorker>();
+  default_browser_worker_->StartSetAsDefault(base::BindOnce(
+      [](base::WeakPtr<WelcomeHandler> self,
+         shell_integration::DefaultWebClientState state) {
+        if (self && self->IsJavascriptAllowed()) {
+          self->FireWebUIListener(
+              "default-browser-changed",
+              base::Value(state == shell_integration::IS_DEFAULT
+                              ? "default"
+                              : "not-default"));
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+}
+
+void WelcomeHandler::HandleFinish(const base::ListValue& args) {
+  AllowJavascript();
+  Profile* const profile = Profile::FromWebUI(web_ui());
+  profile->GetPrefs()->SetBoolean(prefs::kWelcomeShown, true);
+  // The dialog that hosts this page closes on this event.
+  FireWebUIListener("welcome-finished");
+}
+
+void WelcomeHandler::OnDefaultBrowserState(
+    const std::string& callback_id,
+    shell_integration::DefaultWebClientState state) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  const char* value = "unknown";
+  if (state == shell_integration::IS_DEFAULT) {
+    value = "default";
+  } else if (state == shell_integration::NOT_DEFAULT) {
+    value = "not-default";
+  }
+  ResolveJavascriptCallback(base::Value(callback_id), base::Value(value));
+}
+
+}  // namespace stedding
