From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Fri, 6 Nov 2026 12:23:15 -0500
Subject: fix: the lit circle is the size of the chips beside it

At 20 DIP the circle behind a lit shield or moon was right in strength and a
little small. It is 21 DIP now, the size of the address field's chips on the
same row. An odd size has edges between pixels at 1x, so the bounds are a
RectF: the enclosing Rect would have painted 22.

Why: the owner's look on the Mac, 2026-11-06 (BACKLOG S-423, toolbar T60).

Removable when: fold it into the patch that made the circle, once the Mac's
series matches this one.
---
 .../toolbar/stedding_lit_toolbar_button.cc     | 16 ++++++++--------
 .../toolbar/stedding_lit_toolbar_button.h      |  4 ++--
 .../test/stedding/address_band_browsertest.cc  | 18 +++++++++---------
 3 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/chrome/browser/ui/views/toolbar/stedding_lit_toolbar_button.cc b/chrome/browser/ui/views/toolbar/stedding_lit_toolbar_button.cc
index 0170153b317ee..c57c1f1ebd54f 100644
--- a/chrome/browser/ui/views/toolbar/stedding_lit_toolbar_button.cc
+++ b/chrome/browser/ui/views/toolbar/stedding_lit_toolbar_button.cc
@@ -13,7 +13,6 @@
 #include "ui/base/metadata/metadata_impl_macros.h"
 #include "ui/color/color_provider.h"
 #include "ui/gfx/canvas.h"
-#include "ui/gfx/geometry/rect_conversions.h"
 #include "ui/gfx/geometry/rect_f.h"
 #include "ui/gfx/geometry/rrect_f.h"
 #include "ui/gfx/geometry/size_f.h"
@@ -23,10 +22,11 @@ namespace stedding {
 
 namespace {
 
-// toolbar T60: as wide as an address field chip's hover at most (T42), with
-// room in the row above and below, and even, so it centres on a 26 DIP button
-// on whole pixels. The row's other buttons hover at 26 DIP in a 32 DIP row.
-constexpr float kLitCircleSize = 20;
+// toolbar T60: the size of an address field chip's hover (T42), with room in
+// the row above and below. Its middle is the button's and the icon's, and its
+// edges fall between pixels at 1x, where it is drawn antialiased. The row's
+// other buttons hover at 26 DIP in a 32 DIP row.
+constexpr float kLitCircleSize = 21;
 
 class LitCirclePathGenerator : public views::HighlightPathGenerator {
  public:
@@ -49,10 +49,10 @@ LitToolbarButton::LitToolbarButton(PressedCallback callback)
 
 LitToolbarButton::~LitToolbarButton() = default;
 
-gfx::Rect LitToolbarButton::GetLitCircleBounds() const {
+gfx::RectF LitToolbarButton::GetLitCircleBounds() const {
   const std::optional<gfx::RRectF> circle =
       views::HighlightPathGenerator::GetRoundRectForView(this);
-  return circle ? gfx::ToEnclosingRect(circle->rect()) : gfx::Rect();
+  return circle ? circle->rect() : gfx::RectF();
 }
 
 SkColor LitToolbarButton::GetLitCircleColor() const {
@@ -77,7 +77,7 @@ void LitToolbarButton::OnPaintBackground(gfx::Canvas* canvas) {
   if (!lit_) {
     return;
   }
-  const gfx::RectF circle(GetLitCircleBounds());
+  const gfx::RectF circle = GetLitCircleBounds();
   cc::PaintFlags flags;
   flags.setAntiAlias(true);
   flags.setColor(GetLitCircleColor());
diff --git a/chrome/browser/ui/views/toolbar/stedding_lit_toolbar_button.h b/chrome/browser/ui/views/toolbar/stedding_lit_toolbar_button.h
index f6aa0d91bfd40..5726d229ac40e 100644
