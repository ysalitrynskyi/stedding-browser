+class LocalTabsTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    // Every host resolves to the test server; the resolver takes no new rule
+    // once the test body runs.
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  BrowserView* browser_view(BrowserWindowInterface* window = nullptr) {
+    return BrowserView::GetBrowserViewForBrowser(window ? window : browser());
+  }
+  views::Widget* widget(BrowserWindowInterface* window = nullptr) {
+    return browser_view(window)->GetWidget();
+  }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  tabs::VerticalTabStripStateController* controller() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+
+  // A titled page of this machine's server, and one of another site.
+  GURL Local(const std::string& path = "/title2.html") {
+    return embedded_test_server()->GetURL("localhost", path);
+  }
+  GURL Site(const std::string& path = "/title2.html") {
+    return embedded_test_server()->GetURL("a.test", path);
+  }
+  // What a local row of the test server shows under its title.
+  std::u16string LocalHost() {
+    return base::StrCat({u"localhost:", base::NumberToString16(
+                                            embedded_test_server()->port())});
+  }
+
+  // A new tab in front, loaded.
+  tabs::TabInterface* Open(const GURL& url,
+                           BrowserWindowInterface* window = nullptr) {
+    BrowserWindowInterface* const target = window ? window : browser();
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        target, url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return target->GetTabStripModel()->GetActiveTab();
+  }
+  int IndexOf(tabs::TabInterface* tab) {
+    return tab_strip_model()->GetIndexOfTab(tab);
+  }
+  // The tabs' indices in ascending order, as a new folder takes them.
+  std::vector<int> Sorted(const std::vector<tabs::TabInterface*>& of) {
+    std::vector<int> indices;
+    for (tabs::TabInterface* const tab : of) {
+      indices.push_back(IndexOf(tab));
+    }
+    std::ranges::sort(indices);
+    return indices;
+  }
+
+  bool Animating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+
+  // The drawn row of `tab` once the rows are in place, or null.
+  TabView* Row(tabs::TabInterface* tab,
+               BrowserWindowInterface* window = nullptr) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget(window)));
+    views::test::RunScheduledLayout(widget(window));
+    return stedding::test::FindDrawnRow(widget(window)->GetRootView(), tab);
+  }
+  // The drawn row of `tab` as the rows stand now, for the condition of a
+  // RunUntil, which polls it until the rows are in place: Row() waits in a
+  // RunUntil of its own, and one RunUntil inside another's condition waits
+  // in a loop nested in the outer one's idle work, which on the Mac never
+  // returns (every such wait timed out there).
+  TabView* RowNow(tabs::TabInterface* tab,
+                  BrowserWindowInterface* window = nullptr) {
+    views::test::RunScheduledLayout(widget(window));
+    return stedding::test::FindDrawnRow(widget(window)->GetRootView(), tab);
+  }
+  // The host line `row` shows, or nothing when it shows none.
+  static std::u16string HostLineText(TabView* row) {
+    views::Label* const line = row->host_line_for_testing();
+    return line && line->IsDrawn() && !line->bounds().IsEmpty()
+               ? std::u16string(line->GetText())
+               : std::u16string();
+  }
+  // The host line `tab`'s row shows, or nothing when it shows none.
+  std::u16string HostLineOf(tabs::TabInterface* tab,
+                            BrowserWindowInterface* window = nullptr) {
+    TabView* const row = Row(tab, window);
+    if (!row) {
+      ADD_FAILURE() << "the tab has no drawn row";
+      return u"<no row>";
+    }
+    return HostLineText(row);
+  }
+  bool Taped(tabs::TabInterface* tab,
+             BrowserWindowInterface* window = nullptr) {
+    TabView* const row = Row(tab, window);
+    return row && row->WearsLocalTapeForTesting();
+  }
+  // How many drawn rows in the window wear the tape.
+  int TapedRows(BrowserWindowInterface* window = nullptr) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget(window)));
+    views::test::RunScheduledLayout(widget(window));
+    std::vector<TabView*> rows;
+    CollectDrawnRows(widget(window)->GetRootView(), rows);
+    int taped = 0;
+    for (TabView* const row : rows) {
+      taped += row->WearsLocalTapeForTesting() ? 1 : 0;
+    }
+    return taped;
+  }
+  std::u16string DescriptionOf(tabs::TabInterface* tab) {
+    TabView* const row = Row(tab);
+    return row ? row->GetViewAccessibility().GetCachedDescription()
+               : u"<no row>";
+  }
+
+  // The sidebar's density and text size, as Settings and the command bar set
+  // them (sidebar Y1, Y2).
+  void SetDensity(int density, int text_size) {
+    PrefService* const local_state = g_browser_process->local_state();
+    local_state->SetInteger(stedding::prefs::kSidebarDensity, density);
+    local_state->SetInteger(stedding::prefs::kSidebarTextSize, text_size);
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+  }
+
+  void Collapse(bool collapse) {
+    controller()->RequestCollapse(collapse);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    ASSERT_EQ(collapse, controller()->IsCollapsed());
+    views::test::RunScheduledLayout(widget());
+  }
+
+  ui::MouseEvent MouseEvent(ui::EventType type) {
+    const gfx::Point centre = region()->GetLocalBounds().CenterPoint();
+    return ui::MouseEvent(type, centre, centre, base::TimeTicks::Now(),
+                          ui::EF_NONE, ui::EF_NONE);
+  }
+};
