diff --git a/chrome/test/stedding/dark_pages_app_browsertest.cc b/chrome/test/stedding/dark_pages_app_browsertest.cc
new file mode 100644
index 0000000000000..8c0a94f7a1926
--- /dev/null
+++ b/chrome/test/stedding/dark_pages_app_browsertest.cc
@@ -0,0 +1,245 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Dark pages in an app's own window (docs/features/dark-pages.md Dk8,
+// docs/features/web-apps.md Wa9). Blink's dark mode darkens the page but
+// leaves the colour it declares for the window, its `theme-color` or the
+// app's manifest colour, as it is; the title bar takes that colour through
+// the address row's rule, so a light colour gives a dark title bar over a
+// darkened page, from before the page has loaded, and follows the switch and
+// the lists at once.
+
+#include <memory>
+#include <optional>
+#include <string_view>
+#include <utility>
+
+#include "base/test/run_until.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/themes/custom_theme_supplier.h"
+#include "chrome/browser/themes/theme_properties.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/dark_pages.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/web_applications/app_browser_controller.h"
+#include "chrome/browser/web_applications/mojom/user_display_mode.mojom.h"
+#include "chrome/browser/web_applications/web_app_install_info.h"
+#include "chrome/test/stedding/web_app_test_base.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/webapps/common/web_app_id.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/theme_change_waiter.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/color_utils.h"
+#include "url/gurl.h"
+
+namespace {
+
+// A pale blue Blink would invert as a page's background (brightness 238),
+// and Google's blue, a mid-tone it leaves as it is (126): Dk8's two cases.
+constexpr SkColor kPaleBlue = SkColorSetRGB(0xe8, 0xf0, 0xfe);
+constexpr SkColor kGoogleBlue = SkColorSetRGB(0x42, 0x85, 0xf4);
+
+// The page's `theme-color` set to $1, its meta element added the first time.
+constexpr char kDeclareThemeColour[] = R"((() => {
+  let meta = document.querySelector('meta[name="theme-color"]');
+  if (!meta) {
+    meta = document.createElement('meta');
+    meta.name = 'theme-color';
+    document.head.append(meta);
+  }
+  meta.content = $1;
+})())";
+
+// stedding::WebAppBrowserTest: no app window opened here starts a launcher
+// on the Mac (web apps Wa7).
+class DarkPagesAppWindowTest : public stedding::WebAppBrowserTest {
+ protected:
+  // An app that opens `host`'s `path` in a window of its own. With
+  // `manifest_colour` the app's manifest names that theme colour; the page
+  // itself names none.
+  webapps::AppId InstallApp(std::string_view host,
+                            std::string_view path,
+                            std::optional<SkColor> manifest_colour) {
+    const GURL start_url = embedded_https_test_server().GetURL(host, path);
+    auto info =
+        web_app::WebAppInstallInfo::CreateWithStartUrlForTesting(start_url);
+    info->scope = start_url.GetWithoutFilename();
+    info->user_display_mode = web_app::mojom::UserDisplayMode::kStandalone;
+    info->title = u"An App";
+    info->theme_color = manifest_colour;
+    return InstallWebApp(std::move(info));
+  }
+
+  // The app of a.test's page, opened and loaded.
+  BrowserWindowInterface* OpenApp(std::optional<SkColor> manifest_colour) {
+    BrowserWindowInterface* const app = LaunchWebAppBrowserAndWait(
+        InstallApp("a.test", "/title1.html", manifest_colour));
+    if (app) {
+      content::AwaitDocumentOnLoadCompleted(Page(app));
+    }
+    return app;
+  }
+
+  // The app of `host`'s /hung, opened: the test server never answers that
+  // address, so the window keeps the title bar it was opened with, the one
+  // it shows before its first page loads (WebAppDarkModeBrowserTest uses
+  // the same address for the same reason). The launch waits for no load on
+  // it.
+  BrowserWindowInterface* OpenAppThatNeverLoads(std::string_view host) {
+    return LaunchWebAppBrowser(InstallApp(host, "/hung", SK_ColorWHITE));
+  }
+
+  static content::WebContents* Page(BrowserWindowInterface* app) {
+    return app->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  static std::optional<SkColor> ThemeColour(BrowserWindowInterface* app) {
+    return web_app::AppBrowserController::From(app)->GetThemeColor();
+  }
+
+  // The colour the window draws its title bar in: the frame colour of the
+  // theme the app's controller made from the theme colour. Nothing when it
+  // made none (the window keeps Chromium's own ground).
+  static std::optional<SkColor> TitleBarColour(BrowserWindowInterface* app) {
+    CustomThemeSupplier* const theme =
+        web_app::AppBrowserController::From(app)->GetThemeSupplier();
+    SkColor colour = SK_ColorTRANSPARENT;
+    if (!theme ||
+        !theme->GetColor(ThemeProperties::COLOR_FRAME_ACTIVE, &colour)) {
+      return std::nullopt;
+    }
+    return colour;
+  }
+
+  // `colour` as the page's `theme-color`, the way a page declares it, once
+  // the browser has it. Each call must change the colour, or no change is
+  // reported to wait for.
+  static void DeclareThemeColour(content::WebContents* page,
+                                 std::string_view colour) {
+    content::ThemeChangeWaiter declared(page);
+    ASSERT_TRUE(
+        content::ExecJs(page, content::JsReplace(kDeclareThemeColour, colour)));
+    declared.Wait();
+  }
+
+  // Until the title bar is drawn in `expected`: a colour the page declares
+  // reaches the window's theme in the same task, but by a path this test
+  // does not order itself against.
+  [[nodiscard]] static bool WaitForTitleBar(BrowserWindowInterface* app,
+                                            SkColor expected) {
+    return base::test::RunUntil(
+        [&]() { return TitleBarColour(app) == expected; });
+  }
+};
+
+// Dk8, Wa9: a pale `theme-color` gives a pale title bar while dark pages is
+// off, and the colour inverted like the page while it is on: dark, never a
+// light bar over a dark page. A mid-tone is kept. The switch, a site kept
+// light and its removal reach the title bar at once, with no new colour from
+// the page.
+IN_PROC_BROWSER_TEST_F(DarkPagesAppWindowTest,
+                       TheTitleBarFollowsADarkenedPage) {
+  BrowserWindowInterface* const app = OpenApp(/*manifest_colour=*/std::nullopt);
+  ASSERT_TRUE(app);
+  content::WebContents* const page = Page(app);
+
+  DeclareThemeColour(page, "#e8f0fe");
+  ASSERT_TRUE(WaitForTitleBar(app, kPaleBlue));
+  EXPECT_EQ(kPaleBlue, ThemeColour(app)) << "dark pages is off";
+
+  const SkColor darkened = stedding::DarkenLikeBlink(kPaleBlue);
+  ASSERT_TRUE(color_utils::IsDark(darkened));
+  stedding::SetDarkPagesOn(profile(), true);
+  ASSERT_TRUE(stedding::DarkPagesApplyTo(page));
+  EXPECT_EQ(darkened, ThemeColour(app));
+  EXPECT_EQ(darkened, TitleBarColour(app))
+      << "the switch reaches the title bar at once";
+
+  // A mid-tone Blink leaves in the page's header is the title bar's too.
+  DeclareThemeColour(page, "#4285f4");
+  EXPECT_TRUE(WaitForTitleBar(app, kGoogleBlue));
+  EXPECT_EQ(kGoogleBlue, ThemeColour(app));
+
+  DeclareThemeColour(page, "#e8f0fe");
+  EXPECT_TRUE(WaitForTitleBar(app, darkened));
+
+  // Dk13, Dk14: the site kept light, and put back.
+  const std::optional<ContentSettingsPattern> site =
+      stedding::DarkPagesSitePatternFor(page->GetLastCommittedURL());
+  ASSERT_TRUE(site);
+  stedding::AddDarkPagesSite(profile(), stedding::DarkPagesMode::kAllExcept,
+                             *site);
+  ASSERT_FALSE(stedding::DarkPagesApplyTo(page));
+  EXPECT_EQ(kPaleBlue, TitleBarColour(app)) << "a site kept light";
+  stedding::RemoveDarkPagesSite(profile(), *site);
+  EXPECT_EQ(darkened, TitleBarColour(app)) << "and darkened again";
+
+  stedding::SetDarkPagesOn(profile(), false);
+  EXPECT_EQ(kPaleBlue, ThemeColour(app));
+  EXPECT_EQ(kPaleBlue, TitleBarColour(app)) << "the switch off";
+}
+
+// Dk8, Wa9: an app whose page names no colour takes its manifest's, and a
+// light one goes through the same rule: an app opened while dark pages is on
+// has a dark title bar once its page has loaded, and a white one once dark
+// pages is off. TheTitleBarIsDarkBeforeThePageLoads checks the moment before.
+IN_PROC_BROWSER_TEST_F(DarkPagesAppWindowTest,
+                       TheManifestColourFollowsADarkenedPage) {
+  stedding::SetDarkPagesOn(profile(), true);
+  BrowserWindowInterface* const app = OpenApp(SK_ColorWHITE);
+  ASSERT_TRUE(app);
+  ASSERT_TRUE(stedding::DarkPagesApplyTo(Page(app)));
+  ASSERT_FALSE(Page(app)->GetThemeColor()) << "the page names no colour";
+
+  const SkColor darkened = stedding::DarkenLikeBlink(SK_ColorWHITE);
+  EXPECT_TRUE(WaitForTitleBar(app, darkened));
+  EXPECT_EQ(darkened, ThemeColour(app));
+  EXPECT_TRUE(color_utils::IsDark(darkened));
+
+  stedding::SetDarkPagesOn(profile(), false);
+  EXPECT_EQ(SK_ColorWHITE, ThemeColour(app));
+  EXPECT_EQ(SK_ColorWHITE, TitleBarColour(app));
+}
+
+// Dk7, Dk8, Wa9: an app opened while dark pages is on has a dark title bar
+// from the start. The window takes its title bar's colour before it has a
+// tab, and keeps it until its first page has loaded, while the content area
+// is already the darkened canvas; until there is a page, the app's start
+// address decides. On a page that is slow to answer, a light bar over a dark
+// canvas would last the whole wait. A start site kept light opens with the
+// manifest's colour as declared.
+IN_PROC_BROWSER_TEST_F(DarkPagesAppWindowTest,
+                       TheTitleBarIsDarkBeforeThePageLoads) {
+  stedding::SetDarkPagesOn(profile(), true);
+  const SkColor darkened = stedding::DarkenLikeBlink(SK_ColorWHITE);
+  ASSERT_TRUE(color_utils::IsDark(darkened));
+
+  BrowserWindowInterface* const app = OpenAppThatNeverLoads("a.test");
+  ASSERT_TRUE(app);
+  ASSERT_TRUE(
+      Page(app)->GetController().GetLastCommittedEntry()->IsInitialEntry())
+      << "no page has committed";
+  EXPECT_EQ(darkened, TitleBarColour(app)) << "dark before the page loads";
+
+  // Dk13: a start site kept light.
+  const std::optional<ContentSettingsPattern> kept_light =
+      stedding::DarkPagesSitePatternFor(
+          embedded_https_test_server().GetURL("b.test", "/hung"));
+  ASSERT_TRUE(kept_light);
+  stedding::AddDarkPagesSite(profile(), stedding::DarkPagesMode::kAllExcept,
+                             *kept_light);
+  BrowserWindowInterface* const light_app = OpenAppThatNeverLoads("b.test");
+  ASSERT_TRUE(light_app);
+  EXPECT_EQ(SK_ColorWHITE, TitleBarColour(light_app))
+      << "a start site kept light";
+  EXPECT_EQ(darkened, TitleBarColour(app)) << "the other app is unchanged";
+}
+
+}  // namespace
