+// Sf52, Sf53: a refused sign-in stops reads and writes and says so, never in
+// a loop; a changed one, once the test passes, carries on.
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceTest,
+                       ARefusedSignInStopsUntilItChanges) {
+  Join();
+  EXPECT_EQ(Problem(), "");
+  // The server stops knowing this sign-in.
+  place_->SetKnobs([] {
+    FakePlace::Knobs knobs;
+    knobs.fail_status = 401;
+    return knobs;
+  }());
+  Scan();
+  EXPECT_EQ(Problem(), "signInRefused");
+  place_->SetKnobs(FakePlace::Knobs());
+  place_->ResetCounts();
+  Scan();
+  EXPECT_EQ(place_->Count("PROPFIND") + place_->Count("LIST"), 0);
+
+  // A sign-in that fails its test changes nothing.
+  {
+    base::test::TestFuture<base::DictValue> answer;
+    service()->ChangeSignIn(place_->Form(server_.base_url(), "wrong"),
+                            answer.GetCallback());
+    EXPECT_EQ(Failure(answer.Take()), "signIn");
+    EXPECT_EQ(Problem(), "signInRefused");
+  }
+  {
+    base::test::TestFuture<base::DictValue> answer;
+    service()->ChangeSignIn(place_->Form(server_.base_url()),
+                            answer.GetCallback());
+    EXPECT_EQ(Failure(answer.Take()), "");
+  }
+  place_->PutFile(PeerName(), PeerFile(1));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    Scan();
+    return LedgerHasSpaceNamed("Peer Space");
+  }));
+  EXPECT_EQ(Problem(), "");
+}
