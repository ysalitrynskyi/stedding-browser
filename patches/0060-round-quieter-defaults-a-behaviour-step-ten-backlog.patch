diff --git a/chrome/test/stedding/media_keys_browsertest.cc b/chrome/test/stedding/media_keys_browsertest.cc
new file mode 100644
index 0000000000000..c6cc24b66089a
--- /dev/null
+++ b/chrome/test/stedding/media_keys_browsertest.cc
@@ -0,0 +1,292 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The tab's sound and the page's video by key, in a real window
+// (docs/features/tabs.md R29, player.md Mp5, commandbar.md K25; BACKLOG
+// S-122). Off the Mac the chords go through the window's focus manager, the
+// way a key press reaches the accelerator table; on the Mac the test runs the
+// command the Cocoa table maps them to (ShortcutReferenceTest checks those
+// chords). The video is Chromium's own media-session test page, played
+// without a click as Chromium's media controls tests play it.
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/run_loop.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/run_until.h"
+#include "build/build_config.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/media_keys.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/commandbar/command_bar_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/media_start_stop_observer.h"
+#include "media/base/media_switches.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/events/types/event_type.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "url/gurl.h"
+
+#if !BUILDFLAG(IS_MAC)
+#include "ui/views/focus/focus_manager.h"
+#endif
+
+namespace {
+
+using stedding::PictureInPictureKey;
+using stedding::PictureInPictureKeyFor;
+
+constexpr char kVideoPage[] = "/media/session/video-with-metadata.html";
+
+class MediaKeysWindowTest : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(
+        switches::kAutoplayPolicy,
+        switches::autoplay::kNoUserGestureRequiredPolicy);
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+
+  // A new tab on screen showing `path` from the test server, loaded.
+  tabs::TabInterface* Open(const std::string& path) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(path),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // Plays the page's video, and waits until its media session offers picture
+  // in picture: the session's actions follow the player a moment later.
+  void Play(tabs::TabInterface* tab) {
+    content::MediaStartStopObserver started(
+        tab->GetContents(), content::MediaStartStopObserver::Type::kStart);
+    ASSERT_TRUE(content::ExecJs(tab->GetContents(), "play()"));
+    started.Wait();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return PictureInPictureKeyFor(browser()) == PictureInPictureKey::kEnter;
+    })) << "the media session offers picture in picture";
+  }
+
+  static bool InPictureInPicture(tabs::TabInterface* tab) {
+    return tab->GetContents()->HasPictureInPictureVideo();
+  }
+
+  static bool Paused(tabs::TabInterface* tab) {
+    return content::EvalJs(tab->GetContents(),
+                           "document.getElementById('video').paused")
+        .ExtractBool();
+  }
+
+  // ⌃M, Ctrl+M.
+  bool PressMuteKey() {
+#if BUILDFLAG(IS_MAC)
+    return chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_TAB_MUTED);
+#else
+    return Press(ui::Accelerator(ui::VKEY_M, ui::EF_CONTROL_DOWN));
+#endif
+  }
+
+  // ⌥⇧⌘P, Ctrl+Alt+Shift+P. The Ctrl+Alt map is Windows' alone, so Linux
+  // has no chord for it and runs the command, as the Mac does.
+  bool PressPictureInPictureKey() {
+#if BUILDFLAG(IS_WIN)
+    return Press(ui::Accelerator(
+        ui::VKEY_P, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN));
+#else
+    return chrome::ExecuteCommand(browser(),
+                                  IDC_STEDDING_TOGGLE_PICTURE_IN_PICTURE);
+#endif
+  }
+
+  // The bar in actions mode, as ⇧⌘P (Ctrl+Shift+P) opens it.
+  stedding::CommandBarView* Palette() {
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_COMMAND_PALETTE);
+    return stedding::CommandBarView::GetOpenBar(
+        BrowserView::GetBrowserViewForBrowser(browser()));
+  }
+
+  static std::vector<std::u16string> Titles(stedding::CommandBarView* bar) {
+    std::vector<std::u16string> titles;
+    for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+      titles.push_back(bar->row_title_for_testing(i));
+    }
+    return titles;
+  }
+
+  static bool HasRow(stedding::CommandBarView* bar,
+                     const std::u16string& title) {
+    return std::ranges::contains(Titles(bar), title);
+  }
+
+  static void Type(stedding::CommandBarView* bar, const std::u16string& text) {
+    bar->field_for_testing()->SetText(text);
+    bar->ContentsChanged(bar->field_for_testing(), text);
+  }
+
+  static void CloseBar(stedding::CommandBarView* bar) {
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+  }
+
+ private:
+#if !BUILDFLAG(IS_MAC)
+  bool Press(const ui::Accelerator& accelerator) {
+    views::FocusManager* const focus =
+        BrowserView::GetBrowserViewForBrowser(browser())->GetFocusManager();
+    return focus && focus->ProcessAccelerator(accelerator);
+  }
+#endif
+};
+
+// tabs R29: with the right pane of a split on screen and focused, the key
+// mutes both panes' pages and leaves the tab outside the split alone; a
+// second press unmutes both.
+IN_PROC_BROWSER_TEST_F(MediaKeysWindowTest, TheMuteKeyWorksFromInsideASplit) {
+  tabs::TabInterface* const other = Open("/title1.html");
+  tabs::TabInterface* const left = Open("/title2.html");
+  tabs::TabInterface* const right = Open("/title3.html");
+  tabs()->ActivateTabAt(Index(left));
+  tabs()->AddToNewSplit({Index(right)}, split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(right->IsSplit());
+  ASSERT_EQ(left->GetSplit(), right->GetSplit());
+  tabs()->ActivateTabAt(Index(right));
+  right->GetContents()->Focus();
+  ASSERT_EQ(right, tabs()->GetActiveTab());
+
+  EXPECT_TRUE(PressMuteKey());
+  EXPECT_TRUE(left->GetContents()->IsAudioMuted());
+  EXPECT_TRUE(right->GetContents()->IsAudioMuted());
+  EXPECT_FALSE(other->GetContents()->IsAudioMuted());
+
+  EXPECT_TRUE(PressMuteKey());
+  EXPECT_FALSE(left->GetContents()->IsAudioMuted());
+  EXPECT_FALSE(right->GetContents()->IsAudioMuted());
+  EXPECT_FALSE(other->GetContents()->IsAudioMuted());
+}
+
+// player Mp5: on a playing video the key puts it in picture in picture; the
+// next press brings it back, and the video plays on in the page.
+IN_PROC_BROWSER_TEST_F(MediaKeysWindowTest,
+                       ThePictureInPictureKeyTogglesThePagesVideo) {
+  tabs::TabInterface* const video = Open(kVideoPage);
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+
+  EXPECT_TRUE(PressPictureInPictureKey());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return InPictureInPicture(video); }))
+      << "the key entered picture in picture";
+  EXPECT_EQ(PictureInPictureKey::kExit, PictureInPictureKeyFor(browser()));
+
+  EXPECT_TRUE(PressPictureInPictureKey());
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return !InPictureInPicture(video); }))
+      << "the key closed picture in picture";
+  EXPECT_FALSE(Paused(video)) << "the video plays on in the page";
+}
+
+// player Mp5: from another tab of the window, the key closes the picture in
+// picture the video's tab opened, and the tab on screen stays.
+IN_PROC_BROWSER_TEST_F(MediaKeysWindowTest,
+                       ThePictureInPictureKeyClosesItFromAnotherTab) {
+  tabs::TabInterface* const video = Open(kVideoPage);
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+  ASSERT_TRUE(PressPictureInPictureKey());
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return InPictureInPicture(video); }));
+
+  tabs::TabInterface* const blank = Open("/title1.html");
+  ASSERT_NE(video, blank);
+  ASSERT_EQ(blank, tabs()->GetActiveTab());
+  EXPECT_EQ(PictureInPictureKey::kExit, PictureInPictureKeyFor(browser()));
+
+  EXPECT_TRUE(PressPictureInPictureKey());
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return !InPictureInPicture(video); }))
+      << "the key closed the video's picture in picture";
+  EXPECT_EQ(blank, tabs()->GetActiveTab());
+}
+
+// commandbar K25: the bar lists Mute Tab wherever there is a tab, and a
+// picture-in-picture row only while the key would do something: none before
+// the video plays, Enter Picture in Picture with its chord once it does, and
+// Exit Picture in Picture once that has run.
+IN_PROC_BROWSER_TEST_F(MediaKeysWindowTest,
+                       TheBarOffersPictureInPictureOnlyWithAVideo) {
+  tabs::TabInterface* const video = Open(kVideoPage);
+  {
+    stedding::CommandBarView* const bar = Palette();
+    ASSERT_TRUE(bar);
+    EXPECT_TRUE(HasRow(bar, u"Mute Tab"));
+    EXPECT_FALSE(HasRow(bar, u"Enter Picture in Picture"));
+    EXPECT_FALSE(HasRow(bar, u"Exit Picture in Picture"));
+    CloseBar(bar);
+  }
+
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+  {
+    stedding::CommandBarView* const bar = Palette();
+    ASSERT_TRUE(bar);
+    Type(bar, u"picture in picture");
+    ASSERT_EQ(1u, bar->row_count_for_testing());
+    EXPECT_EQ(u"Enter Picture in Picture", bar->row_title_for_testing(0));
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+    EXPECT_EQ(ui::Accelerator(ui::VKEY_P, ui::EF_PLATFORM_ACCELERATOR |
+                                              ui::EF_ALT_DOWN |
+                                              ui::EF_SHIFT_DOWN)
+                  .GetShortcutText(),
+              bar->row_detail_for_testing(0))
+        << base::UTF16ToUTF8(bar->row_detail_for_testing(0));
+#endif
+    bar->HandleKeyEvent(
+        bar->field_for_testing(),
+        ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_RETURN, ui::EF_NONE));
+    base::RunLoop().RunUntilIdle();
+  }
+  ASSERT_TRUE(base::test::RunUntil([&]() { return InPictureInPicture(video); }))
+      << "the row entered picture in picture";
+
+  {
+    stedding::CommandBarView* const bar = Palette();
+    ASSERT_TRUE(bar);
+    EXPECT_TRUE(HasRow(bar, u"Exit Picture in Picture"));
+    EXPECT_FALSE(HasRow(bar, u"Enter Picture in Picture"));
+    CloseBar(bar);
+  }
+
+  // Nothing left open for the window's close to answer.
+  EXPECT_TRUE(PressPictureInPictureKey());
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return !InPictureInPicture(video); }));
+}
+
+}  // namespace
