+// folders F3: a collapsed folder keeps the row on screen, and the folders on
+// the way to it, until another tab is active; expanding brings the rest back.
+TEST_F(FolderRowsTest, CollapsingKeepsThePathToTheActiveTabOnly) {
+  tabs::TabInterface* const loose = OpenTab();
+  tabs::TabInterface* const inner_tab = OpenTab();
+  tabs::TabInterface* const outer_tab = OpenTab();
+  // The strip reads outer_tab, inner_tab, loose.
+  tabs::FolderTabCollection* const outer = tabs().AddToNewFolder({0, 1});
+  ASSERT_NE(nullptr, outer);
+  // The command on a tab already in a folder nests.
+  tabs::FolderTabCollection* const inner =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(inner_tab)});
+  ASSERT_NE(nullptr, inner);
+  ASSERT_EQ(outer, inner->GetParentCollection());
+  Activate(inner_tab);
+
+  std::unique_ptr<views::Widget> widget = MakeWidget();
+  views::View* const root =
+      widget->SetContentsView(std::make_unique<views::View>());
+  FolderView* const outer_view = AddFolderView(*root, outer);
+  FolderView* const inner_view = AddFolderView(*outer_view, inner);
+  spaces::SpaceTabVisibilityController controller(&space_model(), tabs(),
+                                                 *root);
+
+  outer_view->ExecuteCommand(FolderView::kToggleCommand, /*event_flags=*/0);
+  ASSERT_TRUE(outer->collapsed());
+  EXPECT_EQ(inner_tab, tabs().GetActiveTab()) << "collapsing switches nothing";
+  EXPECT_TRUE(outer_view->GetVisible());
+  EXPECT_TRUE(inner_view->GetVisible()) << "it holds the tab on screen";
+  EXPECT_FALSE(IsHidden(inner_tab));
+  EXPECT_TRUE(IsHidden(outer_tab));
