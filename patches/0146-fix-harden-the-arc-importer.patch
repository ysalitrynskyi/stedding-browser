+void LeaveOut(const ArcItem& item, ItemWalk& walk) {
+  std::vector<const ArcItem*> left = {&item};
+  while (!left.empty()) {
+    const ArcItem* const each = left.back();
+    left.pop_back();
+    ++walk.left_out;
+    for (const std::string& id : each->children) {
