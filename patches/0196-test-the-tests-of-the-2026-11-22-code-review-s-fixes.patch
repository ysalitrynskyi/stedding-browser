+// Whether `profile`'s history has a row for `url`.
+bool HistoryHoldsW2B09(Profile* profile, const GURL& url) {
+  history::HistoryService* const history =
+      HistoryServiceFactory::GetForProfile(profile,
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (!history) {
+    ADD_FAILURE() << "no history service";
+    return false;
+  }
+  history::BlockUntilHistoryProcessesPendingRequests(history);
+  base::CancelableTaskTracker tracker;
+  base::test::TestFuture<history::QueryURLResult> found;
+  history->QueryURL(url, found.GetCallback(), &tracker);
+  return found.Get().success;
+}
