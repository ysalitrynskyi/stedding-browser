+// sessions S44: a jar two Spaces name comes once, and a session no Space uses
+// is named by its row, so the collection keeps it and Delete browsing data
+// reaches it.
+TEST(SpacePartitionsTest, ASessionNoSpaceUsesIsNamed) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceSessions);
+  SpaceRegistry registry(&prefs);
+  const SpaceId mail = registry.Add("Mail", SK_ColorBLUE);
+  const SpaceId docs = registry.Add("Docs", SK_ColorRED);
+  const std::string work = registry.AddSession("Work");
+  const std::string unused = registry.AddSession("Unused");
+  registry.SetSession(mail, work);
+  registry.SetSession(docs, work);
+
+  EXPECT_THAT(stedding::SpacePartitionNames(prefs),
+              testing::ElementsAre(work, unused));
+  EXPECT_EQ(std::string_view(stedding::prefs::kSpaceSessions),
+            std::string_view(stedding::kSpaceSessionsPref));
+}
