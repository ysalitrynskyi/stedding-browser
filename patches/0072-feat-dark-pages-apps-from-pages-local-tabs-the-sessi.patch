@@ -0,0 +1,73 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/app_records_keeper.h"
+
+#include <memory>
+
+#include "base/memory/ptr_util.h"
+#include "build/build_config.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/stedding/web_apps.h"
+
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/ui/stedding/app_dock_mac.h"
+#endif
+
+namespace stedding {
+
+namespace {
+
+const char kAppRecordsKeeperKey[] = "stedding.app_records_keeper";
+
+}  // namespace
+
+AppRecordsKeeper::AppRecordsKeeper(
+    Profile* profile,
+    web_app::WebAppInstallManager& install_manager)
+    : profile_(profile) {
+  observation_.Observe(&install_manager);
+}
+
+AppRecordsKeeper::~AppRecordsKeeper() = default;
+
+// static
+void AppRecordsKeeper::EnsureForProfile(
+    Profile* profile,
+    web_app::WebAppInstallManager& install_manager) {
+  if (!profile) {
+    return;
+  }
+  // A profile's web apps can start again with a new install manager after
+  // the old one went (OnWebAppInstallManagerDestroyed), as tests do: the
+  // keeper listens to the one it is given.
+  if (auto* const keeper = static_cast<AppRecordsKeeper*>(
+          profile->GetUserData(kAppRecordsKeeperKey))) {
+    if (!keeper->observation_.IsObservingSource(&install_manager)) {
+      keeper->observation_.Reset();
+      keeper->observation_.Observe(&install_manager);
+    }
+    return;
+  }
+  profile->SetUserData(
+      kAppRecordsKeeperKey,
+      base::WrapUnique(new AppRecordsKeeper(profile, install_manager)));
+}
+
+void AppRecordsKeeper::OnWebAppUninstalled(
+    const webapps::AppId& app_id,
+    webapps::WebappUninstallSource uninstall_source) {
+  // The uninstall has run its course here: its "also clear data" took the
+  // jar it needed before it began (WebAppUiManagerImpl::OnUninstallAccepted).
+  ForgetAppJar(*profile_->GetPrefs(), app_id);
+#if BUILDFLAG(IS_MAC)
+  RemoveAppFromDock(profile_, app_id);
+#endif
+}
+
+void AppRecordsKeeper::OnWebAppInstallManagerDestroyed() {
+  observation_.Reset();
+}
+
+}  // namespace stedding
