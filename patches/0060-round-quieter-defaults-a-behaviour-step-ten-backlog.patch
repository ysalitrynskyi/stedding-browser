+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_FOLDER_COMMANDS_H_
+#define CHROME_BROWSER_UI_SPACES_FOLDER_COMMANDS_H_
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+#include "base/functional/function_ref.h"
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace tabs {
+class FolderTabCollection;
+class TabInterface;
+}  // namespace tabs
+
+namespace spaces {
+
+// folders F30: Collapse All Folders and Expand All Folders, for the chord,
+// the command bar and the tests. The Space's folders are the folders that
+// hold a tab of the active Space, nested ones included (F20); folders of
+// other Spaces keep their state. A window without Spaces (a private window)
+// counts every folder. Popup and app windows have none to act on.
+
+// True while a folder of the Space is open on screen: expanded, with no
+// collapsed folder above it.
+bool CanCollapseAllFolders(BrowserWindowInterface* browser);
+
+// True while a folder of the Space is collapsed.
+bool CanExpandAllFolders(BrowserWindowInterface* browser);
+
+// Collapses, or expands, every folder of the Space. No tab is switched: a
+// collapsed folder keeps the active tab's row under its header (F3).
+void CollapseAllFolders(BrowserWindowInterface* browser);
+void ExpandAllFolders(BrowserWindowInterface* browser);
+
+// folders F30, the chord: collapses every folder of the Space while one is
+// open on screen, and expands them all otherwise.
+void ToggleAllFolders(BrowserWindowInterface* browser);
+
+// folders F31: the order Alphabetize gives `folder`'s own rows, as the
+// current child index of the row that goes first, second and so on. Nested
+// folders come first, by the name their header shows ("New Folder" for an
+// unnamed one), then tabs and splits by `name_of`, a split by its first
+// pane. Case is ignored, and rows with equal names keep their order.
+std::vector<size_t> AlphabeticalOrder(
+    const tabs::FolderTabCollection& folder,
+    base::FunctionRef<std::u16string(const tabs::TabInterface&)> name_of);
+
+// folders F31: sorts `folder`'s own rows by the name each row shows -- the
+// name the user gave the tab (tabs R15), else its page title. Each row moves
+// whole. Nothing happens for a null folder or one with fewer than two rows.
+void AlphabetizeFolder(TabStripModel& strip, tabs::FolderTabCollection* folder);
+
+// folders F32: opens a New Tab page as `folder`'s last row -- after a nested
+// folder, never inside it -- in the active Space, makes it the active tab and
+// expands the folder. Returns the tab, or null when nothing was opened: no
+// folder, a folder that has left the tree (it has no tab, F26), or a strip
+// with no delegate to open tabs.
+tabs::TabInterface* NewTabInFolder(TabStripModel& strip,
+                                   tabs::FolderTabCollection* folder);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_FOLDER_COMMANDS_H_
