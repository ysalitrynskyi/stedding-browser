+std::optional<SpaceId> SourceSpace(SpaceModel& model,
+                                   BrowserWindowInterface* target_window,
+                                   content::WebContents* source,
+                                   bool opened_by_page) {
+  tabs::TabInterface* const tab =
+      source ? tabs::TabInterface::MaybeGetFromContents(source) : nullptr;
+  if (!tab || tab->IsPinned()) {
+    return std::nullopt;
+  }
+  BrowserWindowInterface* const window = tab->GetBrowserWindowInterface();
+  if (!opened_by_page && window == target_window) {
+    return std::nullopt;
+  }
+  SpaceModel* const source_model = window ? SpaceModel::From(window) : nullptr;
+  const std::optional<SpaceId> id =
+      source_model ? source_model->FindSpaceForTab(tab) : std::nullopt;
+  if (!id || !model.GetSpace(*id)) {
+    return std::nullopt;
+  }
+  return id;
+}
+
+}  // namespace
+
+std::optional<NewTabSpaceChoice> ChooseSpaceForNewTab(
+    BrowserWindowInterface* window,
+    content::WebContents* source,
+    const GURL& url,
+    bool essential,
+    bool may_route,
+    bool opened_by_page) {
+  SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+  if (!model) {
+    return std::nullopt;
+  }
+  NewTabSpaceChoice choice{
+      .space = essential ? model->active_id()
+                         : SourceSpace(*model, window, source, opened_by_page)
+                               .value_or(model->active_id()),
+      .essential = essential};
+  if (essential || !may_route) {
+    return choice;
+  }
+  if (const std::optional<SpaceId> routed = model->RouteTargetFor(
+          url, TakeExternalOpen(url), /*search=*/false);
+      routed && *routed != choice.space) {
+    choice.routed_from = choice.space;
+    choice.space = *routed;
+  }
+  return choice;
+}
+
+NewTabSpace::NewTabSpace(content::WebContents* contents,
+                         NewTabSpaceChoice choice)
+    : content::WebContentsUserData<NewTabSpace>(*contents),
+      choice_(std::move(choice)) {}
+
+NewTabSpace::~NewTabSpace() = default;
+
+// static
+std::optional<NewTabSpaceChoice> NewTabSpace::Take(
+    content::WebContents* contents) {
+  const NewTabSpace* const data = contents ? FromWebContents(contents) : nullptr;
+  if (!data) {
+    return std::nullopt;
+  }
+  NewTabSpaceChoice choice = data->choice_;
+  contents->RemoveUserData(UserDataKey());
+  return choice;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(NewTabSpace);
+
+std::unique_ptr<content::WebContents> PlaceOpenedContents(
+    BrowserWindowInterface* window,
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> contents,
+    const GURL& url,
+    WindowOpenDisposition disposition) {
+  if (!contents) {
+    return contents;
+  }
+  // Contents with an opener share its browsing instance, and so must share
+  // its jar: they join its Space as they are. Contents without one have not
+  // loaded anything yet; content loads the page once they are added.
+  const bool without_opener =
+      !contents->HasOpener() &&
+      contents->GetController().IsInitialBlankNavigation() &&
+      !contents->GetController().GetPendingEntry();
+  // Content loads the page into contents other than the ones it made only
+  // on its navigation-capturing path; without that path they stay.
+  const bool may_remake =
+      without_opener &&
+      base::FeatureList::IsEnabled(features::kPwaNavigationCapturing);
+  content::BrowserContext* const context = contents->GetBrowserContext();
+  const auto remake = [&](scoped_refptr<content::SiteInstance> site) {
+    content::WebContents::CreateParams params(context, std::move(site));
+    params.initially_hidden =
+        disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    contents = content::WebContents::Create(params);
+  };
+  std::optional<NewTabSpaceChoice> choice = ChooseSpaceForNewTab(
+      window, source, url, /*essential=*/false,
+      /*may_route=*/without_opener, /*opened_by_page=*/true);
+  if (!choice) {
+    // A window without Spaces -- a popup opened from a Space with its own
+    // jar -- keeps what it opens in that jar too.
+    const content::StoragePartitionConfig opener_jar =
+        StoragePartitionConfigForWebContents(source);
+    if (may_remake && PageBelongsInSpaceJar(url) &&
+        IsSpaceStoragePartition(opener_jar) &&
+        StoragePartitionConfigForWebContents(contents.get()) != opener_jar) {
+      remake(content::SiteInstance::CreateForFixedStoragePartition(
+          context, url, opener_jar));
+    }
+    return contents;
+  }
+  SpaceModel* const model = SpaceModel::From(window);
+  if (may_remake && NeedsOtherJar(contents.get(), url, model->registry(),
+                                  choice->space, /*essential=*/false)) {
+    remake(SiteInstanceForSpaceTab(context, url, model->registry(),
+                                   choice->space, /*essential=*/false));
+  }
+  NewTabSpace::CreateForWebContents(contents.get(), std::move(*choice));
+  return contents;
+}
+
+bool IsFreshTabUrl(const GURL& shown) {
+  if (shown.is_empty() || shown.IsAboutBlank()) {
+    return true;
+  }
+  return shown.SchemeIs(content::kChromeUIScheme) &&
+         (shown.host() == chrome::kChromeUINewTabHost ||
+          shown.host() == chrome::kChromeUINewTabPageHost ||
+          shown.host() == chrome::kChromeUINewTabPageThirdPartyHost);
+}
+
+}  // namespace spaces
