+  model.SetSleepPolicy(base::Minutes(60), record);
+  env.FastForwardBy(base::Minutes(10));
+  EXPECT_TRUE(slept.empty()) << "slept at the old 5 minutes";
+  env.FastForwardBy(base::Minutes(50));
