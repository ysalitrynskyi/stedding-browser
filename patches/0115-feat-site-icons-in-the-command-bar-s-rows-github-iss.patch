+  // A wait on the open bar, looked up again on each turn (S-492): the bar
+  // closes when the window loses the focus, as another test's window can
+  // take it in a parallel run. The wait then stops and says so, and nothing
+  // reads the bar that is gone.
+  [[nodiscard]] bool UntilBar(
+      base::FunctionRef<bool(stedding::CommandBarView*)> done) {
+    bool gone = false;
+    const bool met = base::test::RunUntil([&]() {
+      stedding::CommandBarView* const open = OpenBarNow();
+      if (!open) {
+        gone = true;
+        return true;
+      }
+      return done(open);
+    });
+    EXPECT_FALSE(gone) << "the bar closed in the wait: the window lost the "
+                          "focus";
+    return met && !gone;
+  }
