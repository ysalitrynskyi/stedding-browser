+  // as a log written before the rebuild kept it would be.
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      ::prefs::kVerticalTabsUncollapsedWidth, kLastSetSidebarWidth);
+  ASSERT_EQ(kLastSetSidebarWidth,
+            tabs::VerticalTabStripStateController::From(browser())
