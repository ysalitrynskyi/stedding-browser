Subject: tint the window from the active Space, and let its colour be chosen

Switching Space now changes the colour of the chrome around the page, so which
Space you are in is answered without reading anything. The colour comes from the
Space, through views::Widget::SetUserColorOverride, which feeds the whole colour
pipeline rather than painting any one view.

A window with a single Space is left alone. One unnamed Space is
indistinguishable from an ordinary window, and tinting it would only say that a
feature exists.

The context menu gains the same five colours a new Space is given, so a Space's
colour is no longer fixed at whatever it was created with.

Why: the tint is how the reference says which Space you are in; the switcher
icons are small and easy to miss.
Removable when: Spaces get a settings surface, where colour belongs with name
and icon.
---
 .../ui/views/spaces/space_switcher_view.cc    | 15 ++++++++++++
 .../spaces/space_tab_visibility_controller.cc | 23 +++++++++++++++++++
 .../spaces/space_tab_visibility_controller.h  |  5 ++++
 3 files changed, 43 insertions(+)

diff --git a/chrome/browser/ui/views/spaces/space_switcher_view.cc b/chrome/browser/ui/views/spaces/space_switcher_view.cc
index 37b7e5b856ee7..d84cd63d19a45 100644
--- a/chrome/browser/ui/views/spaces/space_switcher_view.cc
+++ b/chrome/browser/ui/views/spaces/space_switcher_view.cc
@@ -57,6 +57,7 @@ constexpr auto kIconChoices = std::to_array<const char*>({
 
 // Command ids: the icon choices occupy a block, then the rest.
 constexpr int kFirstIconCommand = 100;
+constexpr int kFirstColorCommand = 150;
 constexpr int kRenameSpaceCommand = 199;
 constexpr int kRemoveSpaceCommand = 200;
 
@@ -211,6 +212,13 @@ void SpaceSwitcherView::ShowContextMenuForViewImpl(
                          base::UTF8ToUTF16(std::string(kIconChoices.at(i))));
   }
   menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  static constexpr auto kColorNames = std::to_array<const char16_t*>({
+      u"Slate", u"Plum", u"Moss", u"Clay", u"Rose"});
+  for (size_t i = 0; i < kNewSpaceColors.size(); ++i) {
+    menu_model_->AddItem(kFirstColorCommand + static_cast<int>(i),
+                         kColorNames.at(i));
+  }
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
   menu_model_->AddItem(kRenameSpaceCommand, u"Rename Space");
   menu_model_->AddItem(kRemoveSpaceCommand, u"Delete Space");
 
@@ -232,6 +240,13 @@ void SpaceSwitcherView::ExecuteCommand(int command_id, int event_flags) {
     model_->RemoveSpace(*menu_space_);
     return;
   }
+  if (command_id >= kFirstColorCommand && command_id < kRenameSpaceCommand) {
+    const size_t choice = static_cast<size_t>(command_id - kFirstColorCommand);
+    if (choice < kNewSpaceColors.size()) {
+      model_->SetSpaceColor(*menu_space_, kNewSpaceColors.at(choice));
+    }
+    return;
+  }
   const size_t choice = static_cast<size_t>(command_id - kFirstIconCommand);
   if (choice < kIconChoices.size()) {
     model_->SetSpaceIcon(*menu_space_, std::string(kIconChoices.at(choice)));
