@@ -0,0 +1,348 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/stedding_top_row_reveal.h"
+
+#include <algorithm>
+
+#include "base/functional/bind.h"
+#include "build/build_config.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/address_row.h"
+#include "chrome/browser/ui/stedding/motion.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/views/animations/common_animation_values.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/top_container_view.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "components/prefs/pref_service.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/events/event_observer.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/geometry/point_conversions.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/widget/widget.h"
+
+namespace stedding {
+
+namespace {
+
+// The right edge's share of "Edge that shows a hidden sidebar" (sidebar Y39),
+// which the top edge shares: the page's own controls along its top are
+// there, as its scroll bar is at the right.
+constexpr int kTopEdgeShare = 6;
+constexpr int kTopEdgeMinimum = 2;
+
+}  // namespace
+
+// Every pointer move, press, exit and touch in the window, the page's among
+// them.
+class TopRowReveal::Watcher : public ui::EventObserver {
+ public:
+  explicit Watcher(TopRowReveal* reveal) : reveal_(reveal) {}
+  ~Watcher() override = default;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override {
+    if (event.type() == ui::EventType::kMouseExited) {
+      reveal_->OnPointerLeft();
+      return;
+    }
+    if (event.IsLocatedEvent()) {
+      reveal_->OnPointerAt(
+          event.AsLocatedEvent()->root_location_f(),
+          event.type() == ui::EventType::kMousePressed ||
+              event.type() == ui::EventType::kTouchPressed);
+    }
+  }
+
+ private:
+  const raw_ptr<TopRowReveal> reveal_;
+};
+
+TopRowReveal::TopRowReveal(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  slide_.SetTweenType(gfx::Tween::EASE_OUT);
+  views::Widget* const widget = browser_view_->GetWidget();
+  if (widget && widget->GetNativeWindow()) {
+    watcher_ = std::make_unique<Watcher>(this);
+    monitor_ = views::EventMonitor::CreateWindowMonitor(
+        watcher_.get(), widget->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMouseExited,
+         ui::EventType::kMousePressed, ui::EventType::kTouchPressed});
+  }
+  focus_manager_ = browser_view_->GetFocusManager();
+  if (focus_manager_) {
+    focus_manager_->AddFocusChangeListener(this);
+  }
+}
+
+TopRowReveal::~TopRowReveal() {
+  if (focus_manager_) {
+    focus_manager_->RemoveFocusChangeListener(this);
+  }
+  monitor_.reset();
+  watcher_.reset();
+  // The top container goes back to being drawn in its place.
+  if (layered_ && browser_view_->top_container()) {
+    browser_view_->top_container()->DestroyLayer();
+  }
+}
+
+bool TopRowReveal::OverPage() const {
+  AddressRow* const row = Row();
+  return row && row->revealed() && row->HidesInCompact();
+}
+
+double TopRowReveal::Shown() const {
+  return slide_.GetCurrentValue();
+}
+
+void TopRowReveal::OnWindowLaidOut() {
+  AddressRow* const row = Row();
+  // The sidebar opened, the setting went off, the window went full screen,
+  // shift-cmd-D answered: the row follows its other rules again, and a
+  // reveal it had is forgotten, so the next close of the sidebar hides it.
+  // Nothing to lay out again: the rule no longer reads the reveal.
+  if (row && row->revealed() && !row->HidesInCompact()) {
+    slide_.Reset(0);
+    row->ForgetRevealed();
+  }
+  if (!Hides()) {
+    rest_.Stop();
+  }
+  UpdateLayer();
+}
+
+void TopRowReveal::OnPointerAt(const gfx::PointF& location, bool pressed) {
+  gfx::Point point = gfx::ToFlooredPoint(location);
+#if BUILDFLAG(IS_MAC)
+  // The Mac's monitor gives the window's own coordinates.
+  views::View::ConvertPointFromWidget(browser_view_.get(), &point);
+#else
+  // aura's gives the screen's (sidebar Y54, GitHub issue 45).
+  views::View::ConvertPointFromScreen(browser_view_.get(), &point);
+#endif
+  pointer_ = point;
+  // A press anywhere drops a rest still waiting, as at the sidebar's edge
+  // (sidebar Y39).
+  if (pressed || !Hides()) {
+    rest_.Stop();
+    return;
+  }
+  if (OverPage() && !slide_.IsClosing()) {
+    // Brought in: it stays while the pointer is on it or the keyboard is in
+    // it, and while another of the window's widgets has the activation -- a
+    // bubble opened from the row, an extension's popup -- so the pointer on
+    // its way there over the page does not send it away.
+    if (!OnRow(point) && !FocusInRow() && WindowActive()) {
+      SendAway();
+    }
+    return;
+  }
+  // Sliding away, the pointer back on it brings it back.
+  if (OverPage() && OnRow(point)) {
+    Reveal(/*slide=*/true);
+    return;
+  }
+  if (!AtEdge(point) || !WindowActive()) {
+    rest_.Stop();
+    return;
+  }
+  if (!rest_.IsRunning()) {
+    rest_.Start(FROM_HERE, Rest(),
+                base::BindOnce(&TopRowReveal::OnRest, base::Unretained(this)));
+  }
+}
+
+void TopRowReveal::OnPointerLeft() {
+  // Off the window, a rest still waiting at its edge would bring the row in
+  // behind the pointer: only the moves inside the window are heard.
+  rest_.Stop();
+}
+
+void TopRowReveal::RevealNow() {
+  if (!Hides() ||
+      (OverPage() && Shown() == 1 && !slide_.is_animating())) {
+    return;
+  }
+  Reveal(/*slide=*/false);
+  // Laid out now, so the row is there for the focus that follows.
+  if (views::Widget* const widget = browser_view_->GetWidget()) {
+    widget->LayoutRootViewIfNecessary();
+  }
+}
+
+int TopRowReveal::Edge() const {
+  int width = 12;
+  if (Profile* const profile = browser_view_->GetProfile()) {
+    width = std::clamp(
+        profile->GetPrefs()->GetInteger(prefs::kSidebarRevealEdgeWidth), 6, 24);
+  }
+  return std::max(kTopEdgeMinimum, width / kTopEdgeShare);
+}
+
+base::TimeDelta TopRowReveal::Rest() const {
+  int delay_ms = 100;
+  if (Profile* const profile = browser_view_->GetProfile()) {
+    delay_ms = std::clamp(
+        profile->GetPrefs()->GetInteger(prefs::kSidebarRevealDelayMs), 0, 500);
+  }
+  return base::Milliseconds(delay_ms + prefs::kSidebarRightEdgeExtraMs);
+}
+
+void TopRowReveal::OnDidChangeFocus(views::View* focused_before,
+                                    views::View* focused_now) {
+  views::View* const top = browser_view_->top_container();
+  if (!top || !browser_view_->GetWidget() || !OverPage()) {
+    return;
+  }
+  // The keyboard left the row -- Enter in its field gave the page the focus
+  // -- with the pointer elsewhere: the row goes.
+  const bool was_in = focused_before && top->Contains(focused_before);
+  const bool is_in = focused_now && top->Contains(focused_now);
+  if (was_in && !is_in && !(pointer_ && OnRow(*pointer_))) {
+    SendAway();
+  }
+}
+
+void TopRowReveal::AnimationProgressed(const gfx::Animation* animation) {
+  Relayout();
+}
+
+void TopRowReveal::AnimationEnded(const gfx::Animation* animation) {
+  if (slide_.GetCurrentValue() == 0) {
+    if (AddressRow* const row = Row()) {
+      row->SetRevealed(false);
+    }
+    UpdateLayer();
+  }
+  Relayout();
+}
+
+AddressRow* TopRowReveal::Row() const {
+  return AddressRow::From(browser_view_->browser());
+}
+
+bool TopRowReveal::Hides() const {
+  AddressRow* const row = Row();
+  return row && row->HidesInCompact();
+}
+
+bool TopRowReveal::WindowActive() const {
+  if (ignore_activation_for_testing_) {
+    return true;
+  }
+  const views::Widget* const widget = browser_view_->GetWidget();
+  return widget && widget->IsActive();
+}
+
+bool TopRowReveal::AtEdge(const gfx::Point& point) const {
+  if (point.y() < 0 || point.y() >= Edge() || point.x() < 0 ||
+      point.x() >= browser_view_->width()) {
+    return false;
+  }
+  // Not over the sidebar: the rail's top row, or a hidden sidebar slid in,
+  // has its own top.
+  if (const VerticalTabStripRegionView* const strip =
+          VerticalTabStripRegionView::StripOf(browser_view_.get())) {
+    if (strip->GetVisible() && strip->width() > 0 &&
+        strip->GetMirroredBounds().Contains(point)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool TopRowReveal::OnRow(const gfx::Point& point) const {
+  const views::View* const top = browser_view_->top_container();
+  return top && top->GetVisible() && top->GetMirroredBounds().Contains(point);
+}
+
+bool TopRowReveal::FocusInRow() const {
+  const views::View* const top = browser_view_->top_container();
+  const views::View* const focused =
+      focus_manager_ ? focus_manager_->GetFocusedView() : nullptr;
+  return top && focused && top->Contains(focused);
+}
+
+void TopRowReveal::OnRest() {
+  if (Hides() && !OverPage() && pointer_ && AtEdge(*pointer_) &&
+      WindowActive()) {
+    Reveal(/*slide=*/true);
+  }
+}
+
+void TopRowReveal::Reveal(bool slide) {
+  AddressRow* const row = Row();
+  if (!row) {
+    return;
+  }
+  rest_.Stop();
+  const PrefService* const prefs = browser_view_->GetProfile()
+                                       ? browser_view_->GetProfile()->GetPrefs()
+                                       : nullptr;
+  row->SetRevealed(true);
+  if (slide && ShouldAnimateSidebar(prefs)) {
+    slide_.SetSlideDuration(base::Milliseconds(
+        browser_animations::kFlyoutShowMs * SidebarMotionScale(prefs)));
+    slide_.Show();
+  } else {
+    slide_.Reset(1);
+  }
+  UpdateLayer();
+  Relayout();
+}
+
+void TopRowReveal::SendAway() {
+  AddressRow* const row = Row();
+  if (!row) {
+    return;
+  }
+  rest_.Stop();
+  const PrefService* const prefs = browser_view_->GetProfile()
+                                       ? browser_view_->GetProfile()->GetPrefs()
+                                       : nullptr;
+  if (ShouldAnimateSidebar(prefs) && slide_.GetCurrentValue() > 0) {
+    slide_.SetSlideDuration(base::Milliseconds(
+        browser_animations::kFlyoutHideMs * SidebarMotionScale(prefs)));
+    slide_.Hide();
+    return;
+  }
+  slide_.Reset(0);
+  row->SetRevealed(false);
+  UpdateLayer();
+  Relayout();
+}
+
+void TopRowReveal::UpdateLayer() {
+  views::View* const top = browser_view_->top_container();
+  const bool wanted =
+      top && top->parent() == browser_view_.get() && OverPage();
+  if (wanted == layered_ || !top) {
+    return;
+  }
+  // The z-order changes with the layer (BrowserView::GetChildrenInZOrder):
+  // set first, so the layers are ordered by the new one.
+  layered_ = wanted;
+  if (wanted) {
+    top->SetPaintToLayer();
+    top->layer()->SetFillsBoundsOpaquely(false);
+  } else {
+    top->DestroyLayer();
+  }
+  if (views::Widget* const widget = browser_view_->GetWidget()) {
+    widget->ReorderNativeViews();
+  }
+  top->SchedulePaint();
+}
+
+void TopRowReveal::Relayout() {
+  browser_view_->InvalidateLayout();
+  browser_view_->SchedulePaint();
+}
+
+}  // namespace stedding
