index 0000000000000..e9c3c196e8689
--- /dev/null
+++ b/chrome/browser/ui/stedding/update_feed.h
@@ -0,0 +1,93 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_UPDATE_FEED_H_
+#define CHROME_BROWSER_UI_STEDDING_UPDATE_FEED_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "base/version.h"
+#include "url/gurl.h"
+
+namespace base {
+class Value;
+}  // namespace base
+
+namespace stedding {
+
+// updates Up15 (docs/features/updates.md, ADR 0026): the raw Ed25519 public
+// key, base64, that Windows builds trust for their feed and their installers.
+// Its private half is kept on the Windows release PC
+// (tooling/win/update-key.ps1), never in this repository.
+inline constexpr char kWindowsUpdatePublicKey[] =
+    "B86HyzsGGoQYoxXdaMS8yz4NRGD/GofLyBTFB7e+EAw=";
+
+// The Windows feed (updates Up14), on the repository's main branch, as the
+// Mac's is (ADR 0022).
+inline constexpr char kWindowsUpdateFeedUrl[] =
+    "https://raw.githubusercontent.com/ysalitrynskyi/stedding-browser/main/"
+    "updates/appcast-windows.xml";
+
+// Whether `signature`, base64, is `public_key`'s (base64, raw 32 bytes)
+// Ed25519 signature of `data`. Anything malformed is a no.
+bool SignatureVerifies(base::span<const uint8_t> data,
+                       std::string_view signature,
+                       std::string_view public_key);
+
+// updates Up15: the part of `feed` its trailing signature covers, when that
+// signature verifies against `public_key`. The signature is Sparkle's
+// signed-feed comment, "<!-- sparkle-signatures:\nedSignature: ...\nlength:
+// N\n-->", after exactly N bytes it signs. An unsigned feed, a bad signature,
+// or a length that does not end where the comment starts gives nothing, so
+// nothing in the feed is read.
+std::optional<std::string_view> SignedFeedBody(std::string_view feed,
+                                               std::string_view public_key);
+
+// One Windows release a feed offers.
+struct UpdateItem {
+  UpdateItem();
+  UpdateItem(const UpdateItem&);
+  UpdateItem& operator=(const UpdateItem&);
+  ~UpdateItem();
+
+  // The release's name, as its tag has it: "0.2.0-beta.19".
+  std::string version;
+  // The installer's four-part version (updates Up14): 156.2.0.19.
+  base::Version file_version;
+  GURL url;
+  int64_t length = 0;
+  // The installer's Ed25519 signature, base64.
+  std::string signature;
+};
+
+// updates Up14: the newest Windows x64 item of a parsed feed (data_decoder's
+// XML tree, its root the <rss> element) whose installer version is later than
+// `installed`. An item without a version (a release name of digits, letters,
+// dots and hyphens: it names the download's file), a later file version, a
+// length, a signature, or an https address (http to this computer only, for
+// the update test's local server, and only when `allow_local_http`: a copy
+// pointed at a test feed) is passed over.
+std::optional<UpdateItem> LaterWindowsItem(const base::Value& feed,
+                                           const base::Version& installed,
+                                           bool allow_local_http);
+
+// updates Up15 (BACKLOG S-249): the newest Windows x64 file version a parsed
+// feed lists, whatever is installed; invalid when it lists none. A verified
+// feed whose newest is older than one listed before is an old feed served
+// again, which would hold an installed copy back.
+base::Version NewestWindowsVersion(const base::Value& feed);
+
+// updates Up14 (BACKLOG S-72): the release a Windows file version stands for,
+// <milestone>.<100 x major + minor>.<patch>.<beta n, 999 for a release>:
+// 156.2.0.19 is "0.2.0-beta.19", 156.2.0.999 is "0.2.0". Empty for a version
+// of another shape, Chromium's own (156.0.<build>.<patch>) among them.
+std::string SteddingVersionOfWindowsVersion(const base::Version& version);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_UPDATE_FEED_H_
