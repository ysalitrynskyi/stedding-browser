+// "Add to Dock…" on the Mac (docs/features/web-apps.md Wa1, Wa5, Wa7, Wa18):
+// the File menu's row, the dialog's words, and the one Dock tile an app gets
+// and loses with it. A stand-in takes the Dock's part (AppDockForTesting) and
+// the fixture fakes ~/Applications (OsIntegrationTestOverride) and starts no
+// launcher it makes (stedding::WebAppBrowserTest): no test touches this
+// Mac's Dock or its Applications folder.
+
+#import <Cocoa/Cocoa.h>
+
