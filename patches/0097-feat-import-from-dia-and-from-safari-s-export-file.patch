+base::FilePath CopyChromiumFileForReading(const base::FilePath& source,
+                                          const base::FilePath& into) {
+  if (source.empty() || !base::PathExists(source)) {
+    return base::FilePath();
+  }
+  const base::FilePath copy = into.Append(source.BaseName());
+  if (!base::CopyFile(source, copy)) {
+    return base::FilePath();
+  }
+  // A hot journal rolls back on open; a write-ahead log (and its index) holds
+  // rows the file itself does not have yet, which a copy without it loses.
+  for (const base::FilePath::StringViewType suffix :
+       {FILE_PATH_LITERAL("-journal"), FILE_PATH_LITERAL("-wal"),
+        FILE_PATH_LITERAL("-shm")}) {
+    const base::FilePath beside = WithSuffix(source, suffix);
+    if (base::PathExists(beside)) {
+      base::CopyFile(beside, WithSuffix(copy, suffix));
+    }
+  }
+  return copy;
+}
