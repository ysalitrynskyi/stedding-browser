# Stedding — developer release build (macOS arm64).
#
# What this is for: day-to-day work. Optimised, no debug symbols, single binary.
# Builds in a fraction of the time of an official build and produces a Chromium.app
# that behaves like a shipping browser for functional testing.
#
# What it is NOT: a shipping configuration. Releases use official.gn (PGO + LTO).
# Performance numbers must never be quoted from this config.

target_os  = "mac"
target_cpu = "arm64"

is_debug           = false
is_component_build = false

# Symbols dominate both link time and disk usage and we do not ship this build.
symbol_level       = 0
blink_symbol_level = 0
v8_symbol_level    = 0

# Google's remote execution backends are not available to us (see docs/ARCHITECTURE.md,
# "Build system"). Everything is built locally.
use_remoteexec = false

# Match release semantics: DCHECKs off.
dcheck_always_on = false

# Proprietary codecs: H.264, AAC, MP3, and the MP4 container.
#
# Upstream defaults these off, which is why a vanilla Chromium cannot play a
# large share of the web's video. A browser people are asked to use every day
# has to play what the web actually serves, so they are on.
#
# This is a licensing position, not a build flag. Distributing binaries that
# decode AVC/H.264 and AAC carries patent obligations, administered by Via LA.
# The decision, and who owns it, is recorded in
# docs/decisions/0008-proprietary-codecs.md.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
