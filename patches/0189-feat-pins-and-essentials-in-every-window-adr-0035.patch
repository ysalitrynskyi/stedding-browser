+// windows G15: unpinning in one window closes an asleep copy elsewhere and
+// leaves an open one as a loose tab.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest,
+                       UnpinningInOneWindowLeavesAnOpenPageElsewhere) {
+  tabs::TabInterface* const asleep = PinPage(browser(), Page("/title1.html"));
+  tabs::TabInterface* const open = PinPage(browser(), Page("/title2.html"));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(second).size() == 2u; }));
+  // The second window's copy of `open` is shown and loads.
+  tabs::TabInterface* const open_there = Pins(second)[1];
+  TabStripModel* const strip = second->GetTabStripModel();
+  strip->ActivateTabAt(strip->GetIndexOfTab(open_there));
+  ASSERT_TRUE(content::WaitForLoadStop(open_there->GetContents()));
+  const int tabs_before = strip->count();
+
+  Model(browser()).SetSpacePinned(asleep, false);
+  Model(browser()).SetSpacePinned(open, false);
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(second).empty(); }))
+      << "the second window kept a pin the first unpinned";
+  EXPECT_EQ(tabs_before - 1, strip->count())
+      << "the asleep copy was not closed, or the open one was";
+  EXPECT_NE(TabStripModel::kNoTab, strip->GetIndexOfTab(open_there));
+  EXPECT_EQ(Page("/title2.html"),
+            open_there->GetContents()->GetLastCommittedURL());
+  EXPECT_TRUE(Store().records().empty());
+}
