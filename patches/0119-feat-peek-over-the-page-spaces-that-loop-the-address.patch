+
+// Stedding (toolbar T54): in a Stedding window the bar is a pill under the
+// page, rising over its bottom edge, with room round it for its shadow.
+constexpr float kSteddingPillRadius = 10;
+
+bool IsSteddingPill() {
+  return base::FeatureList::IsEnabled(stedding::kArcStyleWindow);
+}
+
+gfx::Insets SteddingPillMargins() {
+  return gfx::Insets::TLBR(stedding::kPageBarShadowRoom, stedding::kPageBarSide,
+                           stedding::kPageBarBottom, stedding::kPageBarSide);
+}
+
+// The pill, as the bar's background: a pill in the window's colour, a shade
+// off it (kColorInfoBarBackground), lifted off the page by its shadow. As a
+// background it names that colour, so the bar's text, which is all on the
+// pill, counts as drawn on an opaque ground, as it is: the bar's layer is not
+// opaque, and a build with DCHECKs stops on text with subpixel rendering over
+// it with no opaque background under it (views::Label::PaintText).
+class SteddingPillBackground : public views::Background {
+ public:
+  SteddingPillBackground() { set_color(kColorInfoBarBackground); }
+
+  // views::Background:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override {
+    gfx::RectF pill(view->GetLocalBounds());
+    pill.Inset(gfx::InsetsF(SteddingPillMargins()));
+    if (pill.IsEmpty() || !view->GetColorProvider()) {
+      return;
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color().ResolveToSkColor(view->GetColorProvider()));
+    flags.setLooper(gfx::CreateShadowDrawLooper(
+        {gfx::ShadowValue(gfx::Vector2d(0, 1), 3,
+                          SkColorSetA(SK_ColorBLACK, 0x33)),
+         gfx::ShadowValue(gfx::Vector2d(0, 3), 10,
+                          SkColorSetA(SK_ColorBLACK, 0x29))}));
+    canvas->DrawRoundRect(pill, kSteddingPillRadius, flags);
+  }
+};
+
