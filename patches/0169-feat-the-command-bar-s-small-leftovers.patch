+// import I16, commandbar K16 (bug hunt 2026-11-16): the count the row and the
+// dialog go by is what the conversion adds. A bookmark added to a folder an
+// earlier conversion made is counted while that folder is in the window, and
+// comes into it. Once the person has taken the folder apart it stays removed,
+// with what it holds (I12), and the conversion adds nothing; a bookmark added
+// to it since had still been counted, so the row stayed listed for good.
+IN_PROC_BROWSER_TEST_F(CommandBarActionsTest,
+                       ABookmarkInARemovedFolderIsNotLeftToConvert) {
+  Profile* const profile = browser()->GetProfile();
+  bookmarks::BookmarkModel* const bookmarks =
+      BookmarkModelFactory::GetForBrowserContext(profile);
+  ASSERT_TRUE(bookmarks);
+  bookmarks::test::WaitForBookmarkModelToLoad(bookmarks);
+  const bookmarks::BookmarkNode* const docs =
+      bookmarks->AddFolder(bookmarks->bookmark_bar_node(), 0, u"Docs");
+  bookmarks->AddURL(docs, 0, u"A", GURL("https://a.example/"));
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  const auto tab_titled =
+      [&](std::u16string_view title) -> tabs::TabInterface* {
+    for (int i = 0; i < strip->count(); ++i) {
+      if (strip->GetTabAtIndex(i)->GetContents()->GetTitle() == title) {
+        return strip->GetTabAtIndex(i);
+      }
+    }
+    return nullptr;
+  };
+  const auto folder_of =
+      [&](std::u16string_view title) -> tabs::FolderTabCollection* {
+    tabs::TabInterface* const tab = tab_titled(title);
+    const tabs::TabCollection* const parent =
+        tab ? tab->GetParentCollection() : nullptr;
+    return parent && parent->type() == tabs::TabCollection::Type::FOLDER
+               ? const_cast<tabs::FolderTabCollection*>(
+                     static_cast<const tabs::FolderTabCollection*>(parent))
+               : nullptr;
+  };
+
+  EXPECT_EQ(1u, stedding::BookmarksLeftToConvert(browser()));
+  stedding::ConvertBookmarksToPinsAsking(browser());
+  EXPECT_EQ(0u, stedding::BookmarksLeftToConvert(browser()));
+  tabs::FolderTabCollection* const folder = folder_of(u"A");
+  ASSERT_TRUE(folder) << "Docs did not become a folder";
+
+  // While the folder is here, a bookmark added to Docs is left to convert,
+  // and joins it.
+  bookmarks->AddURL(docs, 1, u"B", GURL("https://b.example/"));
+  EXPECT_EQ(1u, stedding::BookmarksLeftToConvert(browser()));
+  stedding::ConvertBookmarksToPinsAsking(browser());
+  EXPECT_EQ(folder, folder_of(u"B"));
+  EXPECT_EQ(0u, stedding::BookmarksLeftToConvert(browser()));
+
+  // The person takes the folder apart (its menu's Move Tabs Out, menus M7),
+  // then adds a bookmark to Docs: nothing comes in, and nothing is left.
+  strip->MoveTabsOutOfFolder(folder);
+  ASSERT_TRUE(tab_titled(u"A"));
+  ASSERT_FALSE(folder_of(u"A")) << "the premise: the folder is gone";
+  bookmarks->AddURL(docs, 2, u"C", GURL("https://c.example/"));
+  EXPECT_EQ(0u, stedding::BookmarksLeftToConvert(browser()))
+      << "counted, though the conversion adds nothing";
+  const int tabs_before = strip->count();
+  stedding::ConvertBookmarksToPinsAsking(browser());
+  EXPECT_EQ(tabs_before, strip->count());
+  EXPECT_FALSE(tab_titled(u"C"));
+
+  // commandbar K16: so there is no row.
+  stedding::CommandBarView* const bar = Palette(browser());
+  ASSERT_TRUE(bar);
+  Type(bar, u"Turn Bookmarks into Pinned Tabs");
+  EXPECT_FALSE(std::ranges::contains(Titles(bar),
+                                     u"Turn Bookmarks into Pinned Tabs"))
+      << "offered with nothing left to convert";
+  Press(bar, ui::VKEY_ESCAPE);
   base::RunLoop().RunUntilIdle();
