From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Tue, 1 Sep 2026 07:47:43 -0400
Subject: float the content card on a mat, all four corners

The reference floats the page on the window background with a gutter all round;
this build only rounded the corner nearest the tab strip, which read as odd
rather than deliberate.

The gutter goes through MultiContentsView's own layout, next to the split-view
insets that already exist, because that is what keeps the web contents' native
layer in step -- the first attempt moved the view's bounds after layout and the
page kept painting into the mat. The background view that paints the mat in
split view now also shows for the card.

The floating tab-strip corners are silenced in card mode: they exist to blend a
flush content edge into the strip, there is no flush edge any more, and what
remained of them was a tinted notch at the top of the seam.

Why: operator feedback on the first DMG called the single rounded corner weird,
and the reference does float the card.
Removable when: upstream's glass mode ships an equivalent inset by default.
---
 .../layout/stedding_browser_view_layout.cc    | 31 ++++++++++---------
 .../ui/views/frame/multi_contents_view.cc     | 14 ++++++++-
 2 files changed, 30 insertions(+), 15 deletions(-)

diff --git a/chrome/browser/ui/views/frame/layout/stedding_browser_view_layout.cc b/chrome/browser/ui/views/frame/layout/stedding_browser_view_layout.cc
index 50af96ef48e64..80d86802f6ccc 100644
--- a/chrome/browser/ui/views/frame/layout/stedding_browser_view_layout.cc
+++ b/chrome/browser/ui/views/frame/layout/stedding_browser_view_layout.cc
@@ -7,9 +7,7 @@
 #include <utility>
 
 #include "chrome/browser/ui/views/frame/layout/browser_view_layout_delegate.h"
-
-#include "base/i18n/rtl.h"
-
+#include "chrome/browser/ui/views/frame/custom_floating_corner.h"
 #include "chrome/browser/ui/views/frame/multi_contents_view.h"
 #include "ui/gfx/geometry/rounded_corners_f.h"
 
@@ -42,21 +40,26 @@ void SteddingBrowserViewLayout::DoPostLayoutVisualAdjustments(
     const BrowserLayoutParams& params) {
   BrowserViewTabbedLayoutImpl::DoPostLayoutVisualAdjustments(params);
 
+  // The floating tab-strip corners exist to blend a flush content edge into
+  // the strip. With the content floating on a mat there is no flush edge, and
+  // what remains of them is a tinted notch at the top of the seam.
+  if (views().vertical_tab_strip_top_corner) {
+    views().vertical_tab_strip_top_corner->SetAlpha(0.f);
+  }
+  if (views().vertical_tab_strip_bottom_corner) {
+    views().vertical_tab_strip_bottom_corner->SetAlpha(0.f);
+  }
+
   MultiContentsView* const contents = views().multi_contents_view;
   if (!contents) {
     return;
   }
 
-  // Upstream only rounds the contents in glass mode, and only the corner at the
-  // bottom of the tab strip. Arc rounds the corner where the toolbar meets the
-  // tab strip instead, so add that corner and keep whatever upstream chose for
-  // the rest -- in split view and under a side panel those radii go with an
-  // inset that has already pulled the contents off the window edge.
-  gfx::RoundedCornersF radii = contents->GetBackgroundRadii();
-  if (base::i18n::IsRTL()) {
-    radii.set_upper_right(stedding::kContentsCornerRadius.Get());
-  } else {
-    radii.set_upper_left(stedding::kContentsCornerRadius.Get());
+  // The content card floats on a mat (see MultiContentsView's layout), so all
+  // four corners are rounded, as the reference does. Radii upstream has already
+  // chosen -- split view, side panel -- are kept.
+  if (contents->GetBackgroundRadii().IsEmpty()) {
+    contents->SetBackgroundRadii(
+        gfx::RoundedCornersF(stedding::kContentsCornerRadius.Get()));
   }
-  contents->SetBackgroundRadii(radii);
 }
diff --git a/chrome/browser/ui/views/frame/multi_contents_view.cc b/chrome/browser/ui/views/frame/multi_contents_view.cc
index 54069adbee055..4c6a9f6195eea 100644
--- a/chrome/browser/ui/views/frame/multi_contents_view.cc
+++ b/chrome/browser/ui/views/frame/multi_contents_view.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/views/frame/multi_contents_view.h"
 
+#include "chrome/browser/ui/stedding_ui_metrics.h"
+
 #include <algorithm>
 #include <cstdlib>
 
@@ -503,8 +505,12 @@ views::ProposedLayout MultiContentsView::CalculateProposedLayout(
 
   gfx::Rect available_space = gfx::Rect(width, height);
 
+  // Stedding floats the content on a mat even outside split view; the
+  // background view paints that mat. See docs/UI-SPEC.md.
+  const bool stedding_card =
+      base::FeatureList::IsEnabled(stedding::kArcStyleWindow);
   const bool show_background =
-      drop_target_view_->GetVisible() || IsInSplitView();
+      drop_target_view_->GetVisible() || IsInSplitView() || stedding_card;
   layouts.child_layouts.emplace_back(background_view_.get(), show_background,
                                      available_space);
 
@@ -518,6 +524,12 @@ views::ProposedLayout MultiContentsView::CalculateProposedLayout(
 
   if (IsInSplitView()) {
     available_space.Inset(split_view_insets_);
+  } else if (stedding_card) {
+    // The gutter between the sidebar and the page, and along the right and
+    // bottom window edges. Going through this layout rather than moving the
+    // view's bounds keeps the web contents' native layer in step -- moving the
+    // bounds after layout left the page painting into the mat.
+    available_space.Inset(gfx::Insets::TLBR(6, 8, 8, 8));
   }
   ViewSizes sizes = GetViewSizes(available_space);
 
