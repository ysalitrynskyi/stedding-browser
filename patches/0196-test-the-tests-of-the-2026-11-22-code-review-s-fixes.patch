+
+// The sidebar's Downloads and History panels
+// (docs/features/sidebar-panels.md Pn6, Pn9): a press held on a row while a
+// download's progress is redrawn still clicks, the keyboard focus stays on
+// the button it was on across a redraw, an interrupted download that
+// Chromium can go on with offers Resume, and a search's rows keep their day
+// headings and their times.
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
