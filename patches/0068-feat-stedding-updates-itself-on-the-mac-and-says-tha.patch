 void BrowserLifetimeHandler::HandleRelaunch(const base::ListValue& args) {
+  // Stedding (updates Up5): with a later version downloaded, Relaunch
+  // restarts through the updater, which installs it while the browser is
+  // closed and then opens it; Chromium's own relaunch would open the old
+  // bundle while the updater replaces it.
