diff --git a/chrome/test/stedding/audio_strip_browsertest.cc b/chrome/test/stedding/audio_strip_browsertest.cc
new file mode 100644
index 0000000000000..2d2a422561804
--- /dev/null
+++ b/chrome/test/stedding/audio_strip_browsertest.cc
@@ -0,0 +1,309 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/player.md Mp3, Mp7-Mp9 (BACKLOG S-95): a tab playing sound
+// in the background shows a card at the sidebar's foot, to go back to it,
+// pause or play it, or stop it; the rail shows its favicon, and
+// Option-Shift-Cmd-M (Ctrl+Alt+Shift+M) shows the tab.
+
+#include "chrome/browser/ui/stedding/audio_strip.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/test/run_until.h"
+#include "base/time/time.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding/video_pop_out.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/views/frame/audio_strip_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/media_start_stop_observer.h"
+#include "media/base/media_switches.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/events/base_event_utils.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/types/event_type.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/test/button_test_api.h"
+#include "ui/views/test/views_test_utils.h"
+
+namespace {
+
+constexpr char kVideoPage[] = "/media/session/video-with-metadata.html";
+
+class AudioStripTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpCommandLine(
+        command_line);
+    command_line->AppendSwitchASCII(
+        switches::kAutoplayPolicy,
+        switches::autoplay::kNoUserGestureRequiredPolicy);
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+  stedding::AudioStrip* strip() {
+    return stedding::AudioStrip::From(browser());
+  }
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  stedding::AudioStripView* card() {
+    return browser_view()
+        ->vertical_tab_strip_region_view_for_testing()
+        ->audio_card_for_testing();
+  }
+  stedding::AudioStripView* rail() {
+    return browser_view()
+        ->vertical_tab_strip_region_view_for_testing()
+        ->audio_rail_for_testing();
+  }
+  void Layout() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+  }
+
+  // A new tab on screen showing `path` from the test server, loaded.
+  tabs::TabInterface* Open(const std::string& path) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(path),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // Plays the page's video, with its sound, and waits until it plays.
+  void Play(tabs::TabInterface* tab) {
+    content::MediaStartStopObserver started(
+        tab->GetContents(), content::MediaStartStopObserver::Type::kStart);
+    ASSERT_TRUE(content::ExecJs(tab->GetContents(), "play()"));
+    started.Wait();
+  }
+
+  static bool Paused(tabs::TabInterface* tab) {
+    return content::EvalJs(tab->GetContents(),
+                           "document.getElementById('video').paused")
+        .ExtractBool();
+  }
+
+  // The card shows `tab`, drawn in the open sidebar.
+  bool CardShows(tabs::TabInterface* tab) {
+    Layout();
+    return strip()->tab() == tab && card() && card()->GetVisible() &&
+           card()->IsDrawn() && !card()->bounds().IsEmpty();
+  }
+  bool NoCard() {
+    Layout();
+    return !strip()->tab() && card() && !card()->GetVisible();
+  }
+
+  // A tab plays with its sound and another is shown: its card.
+  tabs::TabInterface* PlayInTheBackground() {
+    tabs::TabInterface* const video = Open(kVideoPage);
+    Play(video);
+    Open("/title1.html");
+    EXPECT_TRUE(base::test::RunUntil([&]() { return CardShows(video); }))
+        << "a tab playing in the background showed no card";
+    return video;
+  }
+
+  static void Click(views::Button* button) {
+    ASSERT_TRUE(button);
+    views::test::ButtonTestApi(button).NotifyClick(
+        ui::MouseEvent(ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+                       ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+                       ui::EF_LEFT_MOUSE_BUTTON));
+  }
+};
+
+// Mp3: a tab that plays and is left shows the card, with its title, and the
+// tab on screen has none.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, ALeftTabThatPlaysShowsTheCard) {
+  ASSERT_TRUE(strip());
+  ASSERT_TRUE(card());
+  tabs::TabInterface* const video = Open(kVideoPage);
+  Play(video);
+  EXPECT_TRUE(NoCard()) << "the tab on screen showed a card";
+  Open("/title1.html");
+  EXPECT_TRUE(base::test::RunUntil([&]() { return CardShows(video); }));
+  EXPECT_TRUE(strip()->playing());
+  EXPECT_EQ(video->GetContents()->GetTitle(), strip()->title());
+  EXPECT_EQ(strip()->title(), card()->body_for_testing()->GetTooltipText());
+  EXPECT_EQ(u"Pause", card()->play_pause_for_testing()->GetTooltipText());
+}
+
+// Mp3: no card for a muted tab, or for one on screen in a split's other
+// pane.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, NoCardForAMutedOrShownTab) {
+  tabs::TabInterface* const video = PlayInTheBackground();
+  video->GetContents()->SetAudioMuted(true);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return NoCard(); }))
+      << "a muted tab kept its card";
+  video->GetContents()->SetAudioMuted(false);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return CardShows(video); }))
+      << "unmuted, the card did not come back";
+
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs()->ActivateTabAt(Index(video));
+  tabs()->AddToNewSplit({Index(page)}, split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(video->IsSplit() && page->IsSplit());
+  tabs()->ActivateTabAt(Index(page));
+  ASSERT_EQ(page, tabs()->GetActiveTab());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return NoCard(); }))
+      << "a pane on screen showed a card";
+}
+
+// Mp3, settings T62: on by default; off, no card; on again, the card.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, OffShowsNoCard) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  EXPECT_TRUE(prefs->GetBoolean(stedding::prefs::kPlayerAudioStrip));
+  tabs::TabInterface* const video = PlayInTheBackground();
+  prefs->SetBoolean(stedding::prefs::kPlayerAudioStrip, false);
+  EXPECT_TRUE(NoCard()) << "the card stayed with the setting off";
+  prefs->SetBoolean(stedding::prefs::kPlayerAudioStrip, true);
+  EXPECT_TRUE(CardShows(video));
+}
+
+// Mp7: the card's body shows its tab, in its Space, and the card goes.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, TheCardShowsItsTabInItsSpace) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  tabs::TabInterface* const video = Open(kVideoPage);
+  Play(video);
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return CardShows(video); }))
+      << "another Space shown, the card did not show";
+
+  Click(card()->body_for_testing());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return model->active_id() == home && tabs()->GetActiveTab() == video;
+  })) << "the card did not show its tab in its Space";
+  EXPECT_TRUE(NoCard()) << "the card stayed while its tab showed";
+  EXPECT_FALSE(Paused(video));
+}
+
+// Mp7: pause keeps the card, with play; play plays; stop pauses the page and
+// takes the card away until the tab plays again.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, PauseKeepsTheCardAndStopRemovesIt) {
+  tabs::TabInterface* const video = PlayInTheBackground();
+  Click(card()->play_pause_for_testing());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Paused(video); }))
+      << "pause did not pause the page";
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !strip()->playing(); }));
+  EXPECT_TRUE(CardShows(video)) << "a paused card went";
+  EXPECT_EQ(u"Play", card()->play_pause_for_testing()->GetTooltipText());
+
+  Click(card()->play_pause_for_testing());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !Paused(video); }))
+      << "play did not play the page";
+  EXPECT_TRUE(base::test::RunUntil([&]() { return strip()->playing(); }));
+
+  Click(card()->stop_for_testing());
+  EXPECT_TRUE(NoCard()) << "stop left the card";
+  EXPECT_TRUE(base::test::RunUntil([&]() { return Paused(video); }))
+      << "stop did not pause the page";
+
+  // Played again from its page, the tab has its card back.
+  ASSERT_TRUE(content::ExecJs(video->GetContents(),
+                              "document.getElementById('video').play()"));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return CardShows(video); }))
+      << "played again, the stopped tab got no card";
+}
+
+// Mp7: the newest player takes the card; closing it gives the card back to
+// the one still playing.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, TheNewestPlayerTakesTheCard) {
+  tabs::TabInterface* const first = Open(kVideoPage);
+  Play(first);
+  tabs::TabInterface* const second = Open(kVideoPage);
+  Play(second);
+  Open("/title1.html");
+  EXPECT_TRUE(base::test::RunUntil([&]() { return CardShows(second); }));
+  tabs()->CloseWebContentsAt(Index(second), TabCloseTypes::CLOSE_USER_GESTURE);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return CardShows(first); }))
+      << "the card did not pass to the tab still playing";
+}
+
+// Mp7: closing the card's tab or muting it takes the card away.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, ClosingOrMutingRemovesTheCard) {
+  tabs::TabInterface* const video = PlayInTheBackground();
+  tabs()->CloseWebContentsAt(Index(video), TabCloseTypes::CLOSE_USER_GESTURE);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return NoCard(); }))
+      << "the card outlived its tab";
+  tabs::TabInterface* const again = PlayInTheBackground();
+  again->GetContents()->SetAudioMuted(true);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return NoCard(); }))
+      << "muting kept the card";
+}
+
+// Mp8: in the rail, the card is the favicon above History; a click pauses
+// or plays, and the open sidebar's card hides.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, TheRailsCardPausesAndPlays) {
+  tabs::TabInterface* const video = PlayInTheBackground();
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarClosedForm,
+      stedding::prefs::kSidebarClosedToIcons);
+  chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS_COLLAPSE);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    Layout();
+    return rail() && rail()->GetVisible() && rail()->IsDrawn();
+  })) << "the rail showed no card";
+  EXPECT_FALSE(card()->GetVisible()) << "the open card showed in the rail";
+  views::Button* const button = rail()->rail_button_for_testing();
+  EXPECT_EQ(strip()->title() + u": Pause", button->GetTooltipText());
+  Click(button);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return Paused(video); }));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return button->GetTooltipText() == strip()->title() + u": Play";
+  }));
+  Click(button);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !Paused(video); }));
+}
+
+// Mp9: the key shows the playing tab; with no card it does nothing.
+IN_PROC_BROWSER_TEST_F(AudioStripTest, TheKeyShowsThePlayingTab) {
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_GO_TO_PLAYING_TAB);
+  EXPECT_EQ(page, tabs()->GetActiveTab()) << "no card, and the key moved";
+  tabs::TabInterface* const video = PlayInTheBackground();
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_GO_TO_PLAYING_TAB);
+  EXPECT_EQ(video, tabs()->GetActiveTab());
+  EXPECT_TRUE(NoCard());
+}
+
+}  // namespace
