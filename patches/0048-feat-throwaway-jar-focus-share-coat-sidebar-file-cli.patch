@@ -0,0 +1,66 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_file.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace spaces {
+namespace {
+
+TEST(SidebarFileTest, ExportRoundTripsCatalog) {
+  RegistryEntry work(SpaceId::GenerateNew(), "Work", SK_ColorBLUE);
+  work.icon = "W";
+  work.profile_id = "secret-jar-token";
+  RegistryEntry home(SpaceId::GenerateNew(), "Home", SK_ColorRED);
+  std::vector<RegistryEntry> spaces = {work, home};
+  Route route;
+  route.match = Route::Match::kHost;
+  route.pattern = "staging.example.com";
+  route.space = work.id.ToString();
+  const base::DictValue file = SidebarFileFromCatalog(spaces, {route});
+  EXPECT_EQ(kSidebarFileKind, *file.FindString("kind"));
+  EXPECT_EQ(kSidebarFileVersion, file.FindInt("version"));
+  const std::string raw = file.DebugString();
+  EXPECT_EQ(std::string::npos, raw.find("secret-jar-token"))
+      << "jars are not in the file";
+
+  std::vector<RegistryEntry> read_spaces;
+  std::vector<Route> read_routes;
+  ASSERT_TRUE(SidebarFileToCatalog(file, &read_spaces, &read_routes));
+  ASSERT_EQ(2u, read_spaces.size());
+  EXPECT_EQ(work.id, read_spaces[0].id);
+  EXPECT_EQ("Work", read_spaces[0].name);
+  EXPECT_FALSE(read_spaces[0].profile_id.empty()) << "isolated as a boolean";
+  EXPECT_NE("secret-jar-token", read_spaces[0].profile_id);
+  EXPECT_TRUE(read_spaces[1].profile_id.empty());
+  ASSERT_EQ(1u, read_routes.size());
+  EXPECT_EQ(Route::Match::kHost, read_routes[0].match);
+  EXPECT_EQ("staging.example.com", read_routes[0].pattern);
+}
+
+TEST(SidebarFileTest, JarsAreNotInTheFile) {
+  RegistryEntry work(SpaceId::GenerateNew(), "Work", SK_ColorBLUE);
+  work.profile_id = "cookie-jar";
+  const base::DictValue file = SidebarFileFromCatalog({work}, {});
+  const base::ListValue* const list = file.FindList("spaces");
+  ASSERT_TRUE(list);
+  ASSERT_EQ(1u, list->size());
+  const base::DictValue& dict = (*list)[0].GetDict();
+  EXPECT_FALSE(dict.contains("profile"));
+  EXPECT_TRUE(dict.FindBool("isolated").value());
+}
+
+TEST(SidebarFileTest, BadKindIsRejected) {
+  base::DictValue bad;
+  bad.Set("kind", "arc.sidebar");
+  bad.Set("version", 2);
+  std::vector<RegistryEntry> spaces;
+  std::vector<Route> routes;
+  EXPECT_FALSE(SidebarFileToCatalog(bad, &spaces, &routes));
+}
+
+}  // namespace
+}  // namespace spaces
