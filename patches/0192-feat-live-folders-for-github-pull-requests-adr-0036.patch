+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/stedding_live_folders_handler.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/live_folders/live_folder_service_factory.h"
+#include "content/public/browser/web_ui.h"
+
+SteddingLiveFoldersHandler::SteddingLiveFoldersHandler(Profile* profile)
+    : profile_(profile->GetOriginalProfile()) {}
+
+SteddingLiveFoldersHandler::~SteddingLiveFoldersHandler() = default;
+
+void SteddingLiveFoldersHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "steddingGetLiveFolder",
+      base::BindRepeating(&SteddingLiveFoldersHandler::HandleGet,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingMakeLiveFolder",
+      base::BindRepeating(&SteddingLiveFoldersHandler::HandleMake,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingRefreshLiveFolder",
+      base::BindRepeating(&SteddingLiveFoldersHandler::HandleRefresh,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingDeleteLiveFolder",
+      base::BindRepeating(&SteddingLiveFoldersHandler::HandleDelete,
+                          base::Unretained(this)));
+}
+
+void SteddingLiveFoldersHandler::OnJavascriptAllowed() {
+  if (live_folders::LiveFolderService* const service =
+          live_folders::LiveFolderServiceFactory::GetForProfile(profile_);
+      service && !observation_.IsObserving()) {
+    observation_.Observe(service);
+  }
+}
+
+void SteddingLiveFoldersHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+void SteddingLiveFoldersHandler::OnLiveFolderChanged() {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("stedding-live-folder-changed", State());
+  }
+}
+
+base::DictValue SteddingLiveFoldersHandler::State() const {
+  live_folders::LiveFolderService* const service =
+      live_folders::LiveFolderServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    return base::DictValue().Set("on", false).Set("available", false);
+  }
+  return service->StateForSettings().Set("available", true);
+}
+
+void SteddingLiveFoldersHandler::HandleGet(const base::ListValue& args) {
+  if (args.size() != 1U) {
+    return;
+  }
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], State());
+}
+
+void SteddingLiveFoldersHandler::HandleMake(const base::ListValue& args) {
+  if (args.size() != 2U || !args[1].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  live_folders::LiveFolderService* const service =
+      live_folders::LiveFolderServiceFactory::GetForProfile(profile_);
+  if (!service) {
+    ResolveJavascriptCallback(
+        args[0], base::DictValue().Set("ok", false).Set("error", ""));
+    return;
+  }
+  // Lf1: the folder goes into the Space of the window last in front: the
+  // one this page is in, or the one the sidebar's menu was opened in.
+  service->MakeInActiveSpace(
+      args[1].GetString(),
+      base::BindOnce(&SteddingLiveFoldersHandler::OnMade,
+                     weak_factory_.GetWeakPtr(), args[0].Clone()));
+}
+
+void SteddingLiveFoldersHandler::OnMade(base::Value callback_id,
+                                        live_folders::Failure failure) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  ResolveJavascriptCallback(
+      callback_id,
+      base::DictValue()
+          .Set("ok", failure == live_folders::Failure::kNone)
+          .Set("error", live_folders::FailureText(failure)));
+}
+
+void SteddingLiveFoldersHandler::HandleRefresh(const base::ListValue& args) {
+  if (live_folders::LiveFolderService* const service =
+          live_folders::LiveFolderServiceFactory::GetForProfile(profile_)) {
+    service->RefreshNow();
+  }
+}
+
+void SteddingLiveFoldersHandler::HandleDelete(const base::ListValue& args) {
+  if (live_folders::LiveFolderService* const service =
+          live_folders::LiveFolderServiceFactory::GetForProfile(profile_)) {
+    service->Delete();
+  }
+}
