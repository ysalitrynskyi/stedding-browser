+// import I47: an import ends on the page, in front, and it says where things
+// are and what did not come across.
+IN_PROC_BROWSER_TEST_F(FromArcPageTest, AnImportOpensThePageOnce) {
+  WriteSidebar();
+  ASSERT_TRUE(Import());
+  content::WebContents* const page = WaitForThePage();
+  EXPECT_EQ(1, PagesOpen());
+  const std::string text =
+      content::EvalJs(page, "document.body.innerText").ExtractString();
+  for (const char* words :
+       {"Where everything from Arc went", "Essentials", "Little windows",
+        "Sites routed to Spaces", "What did not come across",
+        "Per-Space profiles"}) {
+    EXPECT_NE(std::string::npos, text.find(words)) << words;
+  }
+  EXPECT_EQ("Where everything from Arc went",
+            content::EvalJs(page, "document.title"));
+}
