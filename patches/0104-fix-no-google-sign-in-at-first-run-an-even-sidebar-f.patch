+// commandbar K36 (GitHub issue 37): the bar stands off the page under it, a
+// white one in the light look too: a shadow under it, and a hairline round its
+// edge inside the panel's inset.
+TEST_F(CommandBarViewTest, TheBarStandsOffThePage) {
+  AddTab(browser(), GURL("https://example.com/"));
+  // A host with a layer, as the browser view's is: the bar's layer and the
+  // shadow's are its layer's children.
+  views::View host;
+  host.SetPaintToLayer();
+  const auto scoped_host = CommandBarView::SetHostForTesting(&host);
+  CommandBarView::Show(browser(), CommandBarView::Mode::kTabs);
+  CommandBarView* const bar = CommandBarView::GetOpenBar(&host);
+  ASSERT_TRUE(bar);
+  ASSERT_TRUE(bar->shadow_for_testing()) << "the bar casts no shadow";
+  ASSERT_TRUE(bar->layer());
+  ASSERT_TRUE(bar->layer()->parent());
+  const std::vector<raw_ptr<ui::Layer, VectorExperimental>>& stack =
+      bar->layer()->parent()->children();
+  const auto bar_at = std::ranges::find(stack, bar->layer());
+  const auto shadow_at = std::ranges::find(
+      stack, bar->shadow_for_testing()->shadow()->layer());
+  ASSERT_NE(stack.end(), bar_at);
+  ASSERT_NE(stack.end(), shadow_at) << "the shadow is not drawn";
+  EXPECT_LT(shadow_at, bar_at) << "the shadow is over the bar";
+  ASSERT_TRUE(bar->GetBorder());
+  EXPECT_EQ(gfx::Insets(12), bar->GetBorder()->GetInsets());
+}
+
 // commandbar K28, K15: a normal window offers the blank documents; a private
 // window offers none, in either mode.
 TEST_F(CommandBarViewTest, PrivateWindowsOfferNoNewDocuments) {
