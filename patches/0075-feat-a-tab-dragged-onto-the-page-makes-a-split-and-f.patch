+using HoverCardUpdateType = TabSlotController::HoverCardUpdateType;
+
+// The test server's pages. "/colour?RRGGBB" fills the window with one
+// colour under a line of text, so a picture says which page it shows.
+// "/article" is a page of text, the common case. "/noise" fills the window
+// with random pixels, the worst case for a JPEG.
+std::unique_ptr<net::test_server::HttpResponse> ServePage(
+    const net::test_server::HttpRequest& request) {
+  const GURL url = request.GetURL();
+  std::string body;
+  if (url.path() == "/colour") {
+    body = base::StrCat(
+        {"<!doctype html><title>Colour ", url.query(),
+         "</title><style>html,body{margin:0;height:100%;background:#",
+         url.query(), "}</style><body><p>", url.query(), "</p>"});
+  } else if (url.path() == "/article") {
+    std::string paragraphs;
+    for (int i = 0; i < 12; ++i) {
+      paragraphs += base::StrCat(
+          {"<p>Paragraph ", base::NumberToString(i),
+           ". Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do "
+           "eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut "
+           "enim ad minim veniam, quis nostrud exercitation ullamco laboris "
+           "nisi ut aliquip ex ea commodo consequat.</p>"});
+    }
+    body = base::StrCat(
+        {"<!doctype html><title>Article</title><style>"
+         "body{margin:0;font:16px/1.5 sans-serif;color:#222}"
+         "header{background:#2a5db0;color:#fff;padding:16px 32px;"
+         "font-size:28px}main{columns:2;padding:16px 32px}"
+         "aside{float:right;width:180px;height:120px;margin:8px;"
+         "background:#f0b030}</style><body><header>An article</header>"
+         "<main><aside></aside>",
+         paragraphs, "</main>"});
+  } else if (url.path() == "/noise") {
+    body =
+        "<!doctype html><title>Noise</title><style>body{margin:0}"
+        "canvas{display:block;width:100vw;height:100vh}</style>"
+        "<body><canvas id=c></canvas><script>"
+        "const c = document.getElementById('c');"
+        "c.width = innerWidth * devicePixelRatio;"
+        "c.height = innerHeight * devicePixelRatio;"
+        "const g = c.getContext('2d');"
+        "const d = g.createImageData(c.width, c.height);"
+        "for (let i = 0; i < d.data.length; ++i) {"
+        "  d.data[i] = i % 4 == 3 ? 255 : Math.random() * 256 | 0;"
+        "}"
+        "g.putImageData(d, 0, 0);"
+        "</script>";
+  } else {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_content_type("text/html");
+  response->set_content(body);
+  return response;
+}
+
+// The picture `tab` holds, or null when it has no picture helper.
+ThumbnailImage* PictureOf(tabs::TabInterface* tab) {
+  ThumbnailTabHelper* const helper = ThumbnailTabHelper::From(tab);
+  return helper ? helper->thumbnail().get() : nullptr;
+}
+
+bool HasPicture(tabs::TabInterface* tab) {
+  ThumbnailImage* const picture = PictureOf(tab);
+  return picture && picture->has_data();
+}
+
+class HoverCardPictureTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  // A picture is copied from what the page painted. Off the Mac, a browser
+  // test draws nothing unless it asks (docs/HANDOFF.md, trap 113). The Mac
+  // draws anyway, at the screen's own scale, which the call would force
+  // to 1.
+  HoverCardPictureTest()
+      : animations_(gfx::AnimationTestApi::SetRichAnimationRenderMode(
+            gfx::Animation::RichAnimationRenderMode::FORCE_DISABLED)) {
+#if defined(USE_AURA)
+    EnablePixelOutput();
+#endif
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin::SetUpOnMainThread();
+    TabHoverCardController::set_disable_animations_for_testing(true);
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&ServePage));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    stedding::test::KeepAboveOtherWindows(widget());
+  }
+
+  void TearDownOnMainThread() override {
+    TabHoverCardController::set_disable_animations_for_testing(false);
+    VerticalTabsBrowserTestMixin::TearDownOnMainThread();
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+  spaces::SpaceModel& spaces() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model) << "a normal window has Spaces";
+    return *model;
+  }
+
+  GURL Colour(const std::string& rrggbb) {
+    return embedded_test_server()->GetURL("pictures.test", "/colour?" + rrggbb);
+  }
+
+  // A new tab in the background showing `url`, loaded.
+  tabs::TabInterface* OpenInBackground(const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), url, WindowOpenDisposition::NEW_BACKGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs().GetTabAtIndex(tabs().count() - 1);
+  }
+
+  // Shows `tab` until its page has a frame to copy, then shows `next`: the
+  // picture is taken as `tab` leaves the screen (H21).
+  void ShowThenLeave(tabs::TabInterface* tab, tabs::TabInterface* next) {
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(tab));
+    ASSERT_TRUE(content::WaitForLoadStop(tab->GetContents()));
+    content::WaitForCopyableViewInWebContents(tab->GetContents());
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(next));
+  }
+
+  [[nodiscard]] bool WaitForPicture(tabs::TabInterface* tab) {
+    return base::test::RunUntil([&]() { return HasPicture(tab); });
+  }
+
+  TabHoverCardController* cards() {
+    TabHoverCardController* const controller = hover_card_controller();
+    CHECK(controller) << "the sidebar has no hover card controller";
+    return controller;
+  }
+  TabHoverCardBubbleView* card() { return cards()->hover_card_for_testing(); }
+
+  // Hovers `target` as the pointer would, and waits for its card to show.
+  [[nodiscard]] bool Hover(HoverCardAnchorTarget* target) {
+    views::test::RunScheduledLayout(widget());
+    cards()->UpdateHoverCard(target, HoverCardUpdateType::kHover);
+    return base::test::RunUntil([&]() {
+      return cards()->IsHoverCardShowingForTab(target) && card() &&
+             card()->GetWidget() && card()->GetWidget()->IsVisible();
+    });
+  }
+  TabView* RowOf(tabs::TabInterface* tab) {
+    return stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+  }
+  [[nodiscard]] bool HoverRow(tabs::TabInterface* tab) {
+    TabView* const row = RowOf(tab);
+    EXPECT_TRUE(row) << "the sidebar draws no row for the tab";
+    return row && Hover(row);
+  }
+
+  // Moves the pointer off every row and waits for the card to go.
+  void Unhover() {
+    cards()->UpdateHoverCard(nullptr, HoverCardUpdateType::kHover);
+    EXPECT_TRUE(base::test::RunUntil([&]() { return !card(); }))
+        << "the card is still up";
+  }
+
+  // The card's picture view, if it has one.
+  views::View* PictureView() {
+    return card() ? card()->GetThumbnailViewForTesting() : nullptr;
+  }
+
+  // The image the card's picture view draws: the page's picture, Chromium's
+  // placeholder globe or crashed-tab icon, or nothing.
+  gfx::ImageSkia CardImage() {
+    views::View* const view = PictureView();
+    if (!view || view->children().empty()) {
+      return gfx::ImageSkia();
+    }
+    auto* const image =
+        views::AsViewClass<views::ImageView>(view->children()[0]);
+    return image ? image->GetImage() : gfx::ImageSkia();
+  }
+
+  // Whether the card shows a picture of a page: an image of the card's
+  // picture shape, 16:9 and wider than Chromium's 64 DIP placeholder icon.
+  bool CardShowsAPicture() {
+    const gfx::ImageSkia image = CardImage();
+    return !image.isNull() && image.width() > 64 &&
+           std::abs(image.width() * 9 - image.height() * 16) <=
+               image.width() / 4;
+  }
+
+  // Whether the card has no picture area: no picture view, or one that asks
+  // for no room (Chromium's "none" state; a waiting or placeholder picture
+  // keeps its room).
+  bool CardHasNoPictureArea() {
+    views::View* const view = PictureView();
+    return !view || !view->IsDrawn() || view->GetPreferredSize().IsEmpty();
+  }
+
+  // The colour at the middle of the card's picture.
+  SkColor PictureMiddle() {
+    const gfx::ImageSkia image = CardImage();
+    const SkBitmap bitmap = image.GetRepresentation(1.0f).GetBitmap();
+    return bitmap.drawsNothing()
+               ? SK_ColorTRANSPARENT
+               : bitmap.getColor(bitmap.width() / 2, bitmap.height() / 2);
+  }
+
+  std::u16string CardTitle() {
+    return card() ? std::u16string(card()->GetTitleViewForTesting()->GetText())
+                  : std::u16string();
+  }
+  std::u16string CardDomainLine() {
+    return card() ? std::u16string(card()->GetDomainViewForTesting()->GetText())
+                  : std::u16string();
+  }
+
+  // Hovers `tab`'s row and expects a picture of its page on the card, with
+  // the title and, for a pin, H8's line under it.
+  void ExpectAPictureOnTheCard(tabs::TabInterface* tab,
+                               const std::string& what) {
+    SCOPED_TRACE(what);
+    ASSERT_TRUE(HoverRow(tab)) << "no card for the row";
+    EXPECT_TRUE(base::test::RunUntil([&]() { return CardShowsAPicture(); }))
+        << "no picture of the page; the card shows "
+        << CardImage().size().ToString();
+    EXPECT_EQ(tab->GetContents()->GetTitle(), CardTitle());
+    if (spaces().HomeUrl(tab).has_value()) {
+      EXPECT_NE(std::u16string::npos, CardDomainLine().find(u" home "))
+          << "H8's line left the card: " << CardDomainLine();
+    }
+    Unhover();
+  }
+
+  tabs::VerticalTabStripStateController* sidebar() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+  void CollapseTheSidebar(bool collapse) {
+    sidebar()->RequestCollapse(collapse);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+    ASSERT_EQ(collapse, sidebar()->IsCollapsed());
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  }
+
+  // Lets the browser run for `delay`, so that something that should not
+  // happen has the time to.
+  void RunFor(base::TimeDelta delay) {
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, run_loop.QuitClosure(), delay);
+    run_loop.Run();
+  }
+
+ private:
+  gfx::AnimationTestApi::RenderModeResetter animations_;
+};
+
+// pins H19: every kind of row that is not on screen shows a picture of its
+// page on its card -- an essentials card, a Space pin, a plain row, a
+// folder's row, both panes of a split not on screen, and a row in the
+// collapsed rail -- above the title and the pin's line (H8).
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest,
+                       ARowOffScreenShowsAPictureOfItsPage) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Colour("ffffff")));
+  tabs::TabInterface* const home = tabs().GetActiveTab();
+  tabs::TabInterface* const essential = OpenInBackground(Colour("d02020"));
+  tabs::TabInterface* const space_pin = OpenInBackground(Colour("20a040"));
+  tabs::TabInterface* const plain = OpenInBackground(Colour("2040d0"));
+  tabs::TabInterface* const in_folder = OpenInBackground(Colour("d0a020"));
+  tabs::TabInterface* const left = OpenInBackground(Colour("a020d0"));
+  tabs::TabInterface* const right = OpenInBackground(Colour("20b0b0"));
+  tabs().SetTabPinned(tabs().GetIndexOfTab(essential), true);
+  spaces().SetSpacePinned(space_pin, true);
+  ASSERT_TRUE(tabs().AddToNewFolder({tabs().GetIndexOfTab(in_folder)}));
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(left));
+  tabs().AddToNewSplit({tabs().GetIndexOfTab(right)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(right->IsSplit());
+
+  // Each row on screen once, then off it: the picture is taken as it
+  // leaves. Leaving the split takes its active pane's picture.
+  for (tabs::TabInterface* const tab :
+       {essential, space_pin, plain, in_folder, left}) {
+    ASSERT_NO_FATAL_FAILURE(ShowThenLeave(tab, home));
+    EXPECT_TRUE(WaitForPicture(tab))
+        << "no picture taken as the tab left the screen";
+  }
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+
+  ExpectAPictureOnTheCard(essential, "an essentials card");
+  ExpectAPictureOnTheCard(space_pin, "a Space pin");
+  ExpectAPictureOnTheCard(plain, "a plain row");
+  ExpectAPictureOnTheCard(in_folder, "a folder's row");
+  ExpectAPictureOnTheCard(left, "the split's pane that was active");
+  // The other pane was on screen too, and is captured while its card asks.
+  ExpectAPictureOnTheCard(right, "the split's other pane");
+
+  {
+    SCOPED_TRACE("the picture is of the row's own page");
+    ASSERT_TRUE(HoverRow(plain));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return CardShowsAPicture(); }));
+    const SkColor middle = PictureMiddle();
+    EXPECT_GT(SkColorGetB(middle), SkColorGetR(middle) + 80)
+        << "the plain row's page is blue; the picture's middle is " << std::hex
+        << middle;
+    Unhover();
+  }
+
+  {
+    SCOPED_TRACE("the collapsed rail");
+    ASSERT_NO_FATAL_FAILURE(CollapseTheSidebar(true));
+    ExpectAPictureOnTheCard(plain, "a rail row");
+    ExpectAPictureOnTheCard(space_pin, "a Space pin in the rail");
+    ASSERT_NO_FATAL_FAILURE(CollapseTheSidebar(false));
+  }
+}
+
+// pins H20: nothing on screen gets a picture. The active row's card has no
+// picture area, even once a picture of it was taken; neither pane of the
+// split on screen has one; a tab group header's card has none. A folder's
+// header has no card at all.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest, NothingOnScreenGetsAPicture) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Colour("ffffff")));
+  tabs::TabInterface* const home = tabs().GetActiveTab();
+  tabs::TabInterface* const shown = OpenInBackground(Colour("d02020"));
+  tabs::TabInterface* const left = OpenInBackground(Colour("a020d0"));
+  tabs::TabInterface* const right = OpenInBackground(Colour("20b0b0"));
+  tabs::TabInterface* const grouped = OpenInBackground(Colour("2040d0"));
+
+  {
+    SCOPED_TRACE("the active row, with a picture of it taken before");
+    ASSERT_NO_FATAL_FAILURE(ShowThenLeave(shown, home));
+    ASSERT_TRUE(WaitForPicture(shown));
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(shown));
+    ASSERT_TRUE(HoverRow(shown));
+    RunFor(base::Milliseconds(500));
+    EXPECT_TRUE(CardHasNoPictureArea())
+        << "the card shows " << CardImage().size().ToString();
+    EXPECT_FALSE(CardShowsAPicture());
+    Unhover();
+  }
+
+  {
+    SCOPED_TRACE("both panes of the split on screen");
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(left));
+    tabs().AddToNewSplit({tabs().GetIndexOfTab(right)},
+                         split_tabs::SplitTabVisualData(),
+                         split_tabs::SplitTabCreatedSource::kTabContextMenu);
+    ASSERT_TRUE(right->IsSplit());
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    for (tabs::TabInterface* const pane : {left, right}) {
+      SCOPED_TRACE(pane == left ? "the active pane" : "the other pane");
+      ASSERT_TRUE(HoverRow(pane));
+      RunFor(base::Milliseconds(500));
+      EXPECT_TRUE(CardHasNoPictureArea())
+          << "the card shows " << CardImage().size().ToString();
+      EXPECT_FALSE(CardShowsAPicture());
+      Unhover();
+    }
+  }
+
+  {
+    SCOPED_TRACE("a tab group's header");
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(home));
+    const tab_groups::TabGroupId group =
+        tabs().AddToNewGroup({tabs().GetIndexOfTab(grouped)});
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    TabGroupView* const view =
+        stedding::test::FindDrawnGroup(widget()->GetRootView(), group);
+    ASSERT_TRUE(view && view->group_header()) << "no group header drawn";
+    ASSERT_TRUE(Hover(view->group_header()));
+    RunFor(base::Milliseconds(500));
+    EXPECT_FALSE(CardShowsAPicture());
+    EXPECT_TRUE(CardHasNoPictureArea());
+    Unhover();
+  }
+}
+
+// pins H21: the picture is the page as last seen. A pin that left its home
+// shows where it is. A row put to sleep keeps its picture and a hover does
+// not wake it; a row that went to sleep without being shown has no picture
+// and no picture area, and stays asleep after the hover.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest,
+                       ASleepingRowKeepsItsPictureAndIsNotWoken) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Colour("ffffff")));
+  tabs::TabInterface* const home = tabs().GetActiveTab();
+  tabs::TabInterface* const pin = OpenInBackground(Colour("d02020"));
+  tabs::TabInterface* const unseen = OpenInBackground(Colour("2040d0"));
+  spaces().SetSpacePinned(pin, true);
+
+  {
+    SCOPED_TRACE("a pin away from its home shows where it is");
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Colour("20a040")));
+    ASSERT_NE(spaces().HomeUrl(pin), pin->GetContents()->GetLastCommittedURL())
+        << "the pin did not drift";
+    ASSERT_NO_FATAL_FAILURE(ShowThenLeave(pin, home));
+    ASSERT_TRUE(WaitForPicture(pin));
+    ASSERT_TRUE(HoverRow(pin));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return CardShowsAPicture(); }));
+    const SkColor middle = PictureMiddle();
+    EXPECT_GT(SkColorGetG(middle), SkColorGetR(middle) + 80)
+        << "the pin's page is green and its home red; the picture's middle "
+           "is "
+        << std::hex << middle;
+    Unhover();
+  }
+
+  {
+    // The sidebar's card had kept what it read as it opened until something
+    // else made it read again, such as the tabs' memory being measured; the
+    // horizontal strip's follows its tab at once. A title set on the page's
+    // entry reaches the row in the same task, and the card with it.
+    SCOPED_TRACE("a card open on a row follows the row");
+    ASSERT_TRUE(HoverRow(pin));
+    RunFor(base::Seconds(1));
+    content::WebContents* const page = pin->GetContents();
+    page->UpdateTitleForEntry(page->GetController().GetLastCommittedEntry(),
+                              u"Renamed");
+    ASSERT_EQ(u"Renamed", RowOf(pin)->data().title);
+    EXPECT_EQ(u"Renamed", CardTitle()) << "the card kept the old title";
+    Unhover();
+  }
+
+  {
+    SCOPED_TRACE("Sleep Tab keeps the picture");
+    stedding::SleepTabs(browser(), pin, stedding::SleepScope::kThisTab);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return pin->GetContents()->WasDiscarded();
+    })) << "the pin did not go to sleep";
+    EXPECT_TRUE(HasPicture(pin)) << "the sleeping tab lost its picture";
+    ASSERT_TRUE(HoverRow(pin));
+    EXPECT_TRUE(base::test::RunUntil([&]() { return CardShowsAPicture(); }));
+    RunFor(base::Milliseconds(500));
+    Unhover();
+    EXPECT_TRUE(pin->GetContents()->WasDiscarded()) << "the hover woke it";
+  }
+
+  {
+    SCOPED_TRACE("a row asleep without being shown");
+    ASSERT_FALSE(HasPicture(unseen));
+    // The row reads that its tab is asleep in the same task as the sleep.
+    // It had read it only at the tab's next change of title or favicon, and
+    // a card opened before that waited for a picture under Chromium's globe.
+    stedding::SleepTabList({unseen});
+    ASSERT_TRUE(unseen->GetContents()->WasDiscarded());
+    EXPECT_TRUE(RowOf(unseen)->data().is_tab_discarded)
+        << "the row still reads its tab as awake";
+    ASSERT_TRUE(HoverRow(unseen));
+    EXPECT_TRUE(base::test::RunUntil([&]() { return CardHasNoPictureArea(); }))
+        << "the card shows " << CardImage().size().ToString();
+    RunFor(base::Seconds(1));
+    EXPECT_TRUE(CardHasNoPictureArea())
+        << "the card shows " << CardImage().size().ToString();
+    EXPECT_EQ(u"Colour 2040d0", CardTitle()) << "the card lost its title";
+    Unhover();
+    EXPECT_TRUE(unseen->GetContents()->WasDiscarded()) << "the hover woke it";
+    EXPECT_FALSE(HasPicture(unseen));
+  }
+}
+
+// The bytes every picture of this build starts with: the JPEG's header,
+// which the encoder writes the same for every picture at Chromium's one
+// quality (97), up to the frame's own size.
+constexpr size_t kHeaderBytes = 24;
+
+std::vector<uint8_t> HeaderOf(tabs::TabInterface* tab) {
+  ThumbnailImage* const picture = PictureOf(tab);
+  if (!picture || !picture->has_data()) {
+    return {};
+  }
+  const std::vector<uint8_t>& data = picture->data()->data;
+  return std::vector<uint8_t>(
+      data.begin(), data.begin() + std::min(kHeaderBytes, data.size()));
+}
+
+// The files under `dir` that hold `bytes`.
+std::vector<base::FilePath> FilesHolding(const base::FilePath& dir,
+                                         const std::vector<uint8_t>& bytes) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  std::vector<base::FilePath> found;
+  base::FileEnumerator files(dir, /*recursive=*/true,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty(); path = files.Next()) {
+    if (files.GetInfo().GetSize() > 64 * 1024 * 1024) {
+      continue;
+    }
+    std::optional<std::vector<uint8_t>> contents = base::ReadFileToBytes(path);
+    if (contents &&
+        std::search(contents->begin(), contents->end(), bytes.begin(),
+                    bytes.end()) != contents->end()) {
+      found.push_back(path);
+    }
+  }
+  return found;
+}
+
+// pins H22: pictures are taken, then the browser quits.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest, PRE_APictureDoesNotOutliveTheRun) {
+  SessionStartupPref::SetStartupPref(
+      browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Colour("ffffff")));
+  tabs::TabInterface* const home = tabs().GetActiveTab();
+  std::vector<tabs::TabInterface*> seen = {OpenInBackground(Colour("d02020")),
+                                           OpenInBackground(Colour("2040d0"))};
+  spaces().SetSpacePinned(seen[0], true);
+  for (tabs::TabInterface* const tab : seen) {
+    ASSERT_NO_FATAL_FAILURE(ShowThenLeave(tab, home));
+    ASSERT_TRUE(WaitForPicture(tab));
+  }
+  // Two pictures of two pages start with the same bytes: the header the
+  // next run looks for on the disk.
+  EXPECT_EQ(kHeaderBytes, HeaderOf(seen[0]).size());
+  EXPECT_EQ(HeaderOf(seen[0]), HeaderOf(seen[1]));
+}
+
+// After the restart no restored row has a picture, and no file of the
+// profile holds one: the pictures lived in memory only.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest, APictureDoesNotOutliveTheRun) {
+  ASSERT_GE(tabs().count(), 3) << "the session was not restored";
+  for (int i = 0; i < tabs().count(); ++i) {
+    tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+    EXPECT_FALSE(HasPicture(tab))
+        << "restored tab " << i << " ("
+        << tab->GetContents()->GetVisibleURL().spec() << ") has a picture";
+  }
+
+  // A picture taken now gives the header this build's pictures start with.
+  tabs::TabInterface* const home = tabs().GetActiveTab();
+  tabs::TabInterface* const now = OpenInBackground(Colour("20a040"));
+  ASSERT_NO_FATAL_FAILURE(ShowThenLeave(now, home));
+  ASSERT_TRUE(WaitForPicture(now));
+  const std::vector<uint8_t> header = HeaderOf(now);
+  ASSERT_EQ(kHeaderBytes, header.size());
+  const base::FilePath user_data = browser()->GetProfile()->GetPath().DirName();
+  for (const base::FilePath& path : FilesHolding(user_data, header)) {
+    ADD_FAILURE() << "a picture was written to " << path.value();
+  }
+}
+
+// pins H23: Chrome's own Appearance switch, "Show tab preview images",
+// turns the pictures off: the card keeps the title and the pin's line (H8)
+// with no picture view. Turned on again, the picture comes back.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest,
+                       TheAppearanceSwitchTurnsThePicturesOff) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Colour("ffffff")));
+  tabs::TabInterface* const home = tabs().GetActiveTab();
+  tabs::TabInterface* const pin = OpenInBackground(Colour("d02020"));
+  spaces().SetSpacePinned(pin, true);
+  ASSERT_NO_FATAL_FAILURE(ShowThenLeave(pin, home));
+  ASSERT_TRUE(WaitForPicture(pin));
+  ExpectAPictureOnTheCard(pin, "the switch on");
+
+  PrefService* const local_state = g_browser_process->local_state();
+  {
+    SCOPED_TRACE("the switch off");
+    local_state->SetBoolean(prefs::kHoverCardImagesEnabled, false);
+    ASSERT_TRUE(HoverRow(pin));
+    RunFor(base::Milliseconds(500));
+    EXPECT_FALSE(PictureView()) << "the card still has a picture view";
+    EXPECT_EQ(u"Colour d02020", CardTitle());
+    EXPECT_NE(std::u16string::npos, CardDomainLine().find(u"Pinned in "))
+        << CardDomainLine();
+    Unhover();
+  }
+
+  local_state->SetBoolean(prefs::kHoverCardImagesEnabled, true);
+  ExpectAPictureOnTheCard(pin, "the switch on again");
+}
+
+// What the pictures cost (pins H22): ten article pages, each shown once,
+// hold one JPEG each. On the Mac's 2x screen, with the test window's page of
+// 836 by 947 DIP, a picture of a page of text was 162 KB and one of random
+// pixels 250 KB (2026-10-20); the run prints the numbers. The budget leaves
+// room for a larger page: 256 KB a picture of text, 512 KB the worst case.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest, WhatThePicturesCost) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Colour("ffffff")));
+  tabs::TabInterface* const home = tabs().GetActiveTab();
+  std::vector<tabs::TabInterface*> articles;
+  for (int i = 0; i < 10; ++i) {
+    articles.push_back(OpenInBackground(
+        embedded_test_server()->GetURL("pictures.test", "/article")));
+  }
+  size_t total = 0;
+  size_t largest = 0;
+  for (tabs::TabInterface* const tab : articles) {
+    ASSERT_NO_FATAL_FAILURE(ShowThenLeave(tab, home));
+    ASSERT_TRUE(WaitForPicture(tab));
+    const size_t bytes = PictureOf(tab)->GetCompressedDataSizeInBytes();
+    total += bytes;
+    largest = std::max(largest, bytes);
+  }
+  tabs::TabInterface* const noise = OpenInBackground(
+      embedded_test_server()->GetURL("pictures.test", "/noise"));
+  ASSERT_NO_FATAL_FAILURE(ShowThenLeave(noise, home));
+  ASSERT_TRUE(WaitForPicture(noise));
+  const size_t noise_bytes = PictureOf(noise)->GetCompressedDataSizeInBytes();
+
+  const gfx::Size page =
+      articles.front()->GetContents()->GetContainerBounds().size();
+  LOG(WARNING) << "Stedding H22 measurement: page " << page.ToString()
+               << " DIP at scale "
+               << widget()->GetCompositor()->device_scale_factor()
+               << "; ten article pictures " << total << " bytes (largest "
+               << largest << "); one picture of random pixels " << noise_bytes
+               << " bytes";
+  EXPECT_LE(largest, 256u * 1024);
+  EXPECT_LE(total, 10u * 256 * 1024);
+  EXPECT_LE(noise_bytes, 512u * 1024);
+}
+
+}  // namespace
