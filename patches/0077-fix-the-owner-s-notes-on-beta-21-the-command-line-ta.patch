+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Stedding's animations, frame by frame (docs/features/motion.md O4-O9). Each
+// test runs one animation in a real window and measures what the UI thread
+// did for each frame the window's compositor made while it ran: how many
+// views it laid out and painted, and how long its layout, its paint and the
+// whole main frame took, read from a trace of the views' own events; how
+// many frames the compositor began and presented; and, where the animation
+// is stepped on the UI thread, how many steps it took. A test logs one
+// "[motion]" line per animation and asserts what the fixes made true. Run
+// with --test-launcher-print-test-stdio=always to read the lines of a run
+// that passes. The numbers come from a release build with tracing on, so
+// they compare one run with another, not with a user's machine.
+
+#include <algorithm>
+#include <cstdlib>
+#include <map>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
