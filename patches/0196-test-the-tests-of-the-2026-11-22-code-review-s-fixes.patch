index 0000000000000..d74f171f0c58c
--- /dev/null
+++ b/chrome/browser/ui/stedding/audit_w2_b20_unittest.cc
@@ -0,0 +1,139 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/routing.md D1, D5: the tab menu's "Always Open <site> in"
+// sends the selected tabs to the Space picked, and the site rule it writes
+// decides for those addresses from then on, also when an earlier rule of
+// another kind matches them.
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/run_loop.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_router.h"
+#include "chrome/browser/ui/stedding/tab_menu_verbs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+constexpr int kRouteFirstW2B20 =
+    TabStripModel::CommandSteddingRouteToSpaceFirst;
+constexpr SkColor kGreyW2B20 = SkColorSetRGB(0x80, 0x80, 0x80);
+
+class TabMenuRouteW2B20Test : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  spaces::SpaceModel& space_model() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model) << "a normal window must own a SpaceModel";
+    return *model;
+  }
+
+  // A foreground tab showing `url` (the fixture opens it at index 0).
+  tabs::TabInterface* OpenTab(const GURL& url) {
+    AddTab(browser(), url);
+    return tabs().GetActiveTab();
+  }
+  // Adds unnamed Spaces after the active one until the window has `count`.
+  void HaveSpaces(size_t count) {
+    while (space_model().size() < count) {
+      space_model().AddSpace(std::string(), kGreyW2B20);
+    }
+  }
+  // An "Address contains `text`" rule naming `space`, as Settings adds it.
+  void AddContainsRule(const std::string& text, const spaces::SpaceId& space) {
+    spaces::Route rule;
+    rule.match = spaces::Route::Match::kContains;
+    rule.pattern = text;
+    rule.space = space.ToString();
+    spaces::AddRoute(profile()->GetPrefs(), rule);
+  }
+  std::optional<spaces::SpaceId> RoutedTo(const GURL& url) {
+    return space_model().RouteTargetFor(url, /*external=*/false,
+                                        /*search=*/false);
+  }
+};
+
+// P27-1b (routing D5, D1): with "Address contains google" naming Personal,
+// Always Open google.com in > Work on a docs.google.com tab sends the tab to
+// Work, not Personal, and from then on the site's addresses go to Work. The
+// site rule was written last, behind the rule that matched first, so the tab
+// went to Personal and the rule just made never decided anything.
+TEST_F(TabMenuRouteW2B20Test, TheSpacePickedWinsOverAnEarlierMatchingRule) {
+  const GURL url("https://docs.google.com/document/d/1");
+  tabs::TabInterface* const tab = OpenTab(url);
+  HaveSpaces(3);
+  const spaces::SpaceId home = space_model().spaces()[0]->id();
+  const spaces::SpaceId personal = space_model().spaces()[1]->id();
+  const spaces::SpaceId work = space_model().spaces()[2]->id();
+  ASSERT_EQ(home, space_model().SpaceForTab(tab));
+  AddContainsRule("google", personal);
+  ASSERT_EQ(personal, RoutedTo(url).value_or(home));
+
+  // The route entries are every Space in switcher order: the third is Work.
+  ExecuteTabMenuVerb(tabs(), tabs().GetIndexOfTab(tab), kRouteFirstW2B20 + 2);
+  // The switch that follows a route waits a turn (SpaceModel::RouteTab).
+  base::RunLoop().RunUntilIdle();
+
+  EXPECT_EQ(work, space_model().SpaceForTab(tab))
+      << "the tab went where the earlier rule says";
+  EXPECT_EQ(work, RoutedTo(url).value_or(home))
+      << "the rule just made does not decide for the site";
+  // The other rule stays, behind the new one, for what it alone matches.
+  EXPECT_EQ(personal,
+            RoutedTo(GURL("https://www.google.co.uk/")).value_or(home));
+  const std::vector<spaces::Route> routes =
+      spaces::ReadRoutes(profile()->GetPrefs());
+  ASSERT_EQ(2u, routes.size());
+  EXPECT_EQ(spaces::SiteRouteFor(url, work.ToString()), routes[0]);
+  EXPECT_EQ(spaces::Route::Match::kContains, routes[1].match);
+}
+
+// P27-1b (routing D5, tabs R21): two selected tabs of one site, an earlier
+// rule matching only one of them. Both go to the Space picked, and the one
+// site rule decides for both addresses afterwards: writing it again for the
+// second tab does not move it back behind the rule the first one beat.
+TEST_F(TabMenuRouteW2B20Test, ASelectionOfOneSiteKeepsItsRuleInFront) {
+  const GURL mail("https://mail.google.com/mail/u/0/");
+  const GURL docs("https://docs.google.com/document/d/1");
+  tabs::TabInterface* const mail_tab = OpenTab(mail);
+  tabs::TabInterface* const docs_tab = OpenTab(docs);
+  HaveSpaces(3);
+  const spaces::SpaceId home = space_model().spaces()[0]->id();
+  const spaces::SpaceId personal = space_model().spaces()[1]->id();
+  const spaces::SpaceId work = space_model().spaces()[2]->id();
+  AddContainsRule("docs", personal);
+  // Not SelectTabAt: a test window's strip is not editable, and that
+  // selects nothing.
+  tabs().ExtendSelectionTo(tabs().GetIndexOfTab(mail_tab));
+  ASSERT_TRUE(tabs().IsTabSelected(tabs().GetIndexOfTab(docs_tab)));
+  ASSERT_TRUE(tabs().IsTabSelected(tabs().GetIndexOfTab(mail_tab)));
+
+  ExecuteTabMenuVerb(tabs(), tabs().GetIndexOfTab(docs_tab),
+                     kRouteFirstW2B20 + 2);
+  base::RunLoop().RunUntilIdle();
+
+  EXPECT_EQ(work, space_model().SpaceForTab(docs_tab));
+  EXPECT_EQ(work, space_model().SpaceForTab(mail_tab));
+  EXPECT_EQ(work, RoutedTo(docs).value_or(home))
+      << "the site rule fell behind the rule it beat";
+  EXPECT_EQ(work, RoutedTo(mail).value_or(home));
+  EXPECT_EQ(2u, spaces::ReadRoutes(profile()->GetPrefs()).size())
+      << "one rule for the site, and the other kept";
+}
+
+}  // namespace
+}  // namespace stedding
