+// where a new tab opens -- the end of the list, or its top with the setting
+// on (R62) -- and the essential or the pin stays the only one, from the tab
+// menu and from the command Duplicate Tab alike.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ADuplicateOfAPinIsAPlainTab) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  tabs::TabInterface* const essential = AddBlankTab();
+  tabs().SetTabPinned(Index(essential), true);
+  ASSERT_TRUE(essential->IsPinned());
+  tabs::TabInterface* const pin = AddBlankTab();
+  model().SetSpacePinned(pin, true);
+  ASSERT_TRUE(model().IsSpacePinned(pin));
+  tabs::TabInterface* const plain = AddBlankTab();
+  AddBlankTab();  // A row after `plain`, so that right after it is not the end.
+
+  const auto essentials = [&]() { return tabs().IndexOfFirstNonPinnedTab(); };
+  const auto pins = [&]() {
+    int count = 0;
+    for (int i = 0; i < tabs().count(); ++i) {
+      count += model().IsSpacePinned(tabs().GetTabAtIndex(i)) ? 1 : 0;
+    }
+    return count;
+  };
+  // The tab menu's Duplicate on `tab`'s row; the copy is the tab on screen.
+  const auto duplicate = [&](tabs::TabInterface* tab) -> tabs::TabInterface* {
+    const int before = tabs().count();
+    const int index = Index(tab);
+    EXPECT_TRUE(tabs().IsContextMenuCommandEnabled(
+        index, TabStripModel::CommandDuplicate));
+    tabs().ExecuteContextMenuCommand(index, TabStripModel::CommandDuplicate);
+    EXPECT_EQ(before + 1, tabs().count());
+    tabs::TabInterface* const copy = tabs().GetActiveTab();
+    EXPECT_NE(tab, copy) << "the copy is not on screen";
+    return copy;
+  };
+  // A plain tab of the active Space, neither an essential nor a pin.
+  const auto expect_plain = [&](tabs::TabInterface* copy) {
+    EXPECT_FALSE(copy->IsPinned()) << "the copy is an essential";
+    EXPECT_FALSE(model().IsSpacePinned(copy)) << "the copy is a Space pin";
+    EXPECT_TRUE(model().IsTabInActiveSpace(copy));
+  };
+
+  {
+    SCOPED_TRACE("a plain tab: right after it");
+    tabs::TabInterface* const copy = duplicate(plain);
+    EXPECT_EQ(Index(plain) + 1, Index(copy));
+    expect_plain(copy);
+  }
+  {
+    SCOPED_TRACE("an essential: a plain tab at the end");
+    const int had = essentials();
+    tabs::TabInterface* const copy = duplicate(essential);
+    expect_plain(copy);
+    EXPECT_EQ(had, essentials());
+    EXPECT_EQ(tabs().count() - 1, Index(copy));
+  }
+  {
+    SCOPED_TRACE("a Space pin: a plain tab at the end");
+    const int had = pins();
+    tabs::TabInterface* const copy = duplicate(pin);
+    expect_plain(copy);
+    EXPECT_EQ(had, pins());
+    EXPECT_EQ(tabs().count() - 1, Index(copy));
+  }
+  {
+    SCOPED_TRACE("Duplicate Tab on the essential on screen");
+    tabs().ActivateTabAt(Index(essential));
+    const int had = essentials();
+    const int before = tabs().count();
+    chrome::ExecuteCommand(browser(), IDC_DUPLICATE_TAB);
+    ASSERT_EQ(before + 1, tabs().count());
+    tabs::TabInterface* const copy = tabs().GetActiveTab();
+    ASSERT_NE(essential, copy);
+    expect_plain(copy);
+    EXPECT_EQ(had, essentials());
+  }
+  prefs->SetBoolean(stedding::prefs::kNewTabsAtTop, true);
+  {
+    SCOPED_TRACE("the setting on: a Space pin's copy at the top of the list");
+    tabs::TabInterface* const copy = duplicate(pin);
+    expect_plain(copy);
+    for (int i = 0; i < Index(copy); ++i) {
+      tabs::TabInterface* const above = tabs().GetTabAtIndex(i);
+      EXPECT_TRUE(above->IsPinned() || model().IsSpacePinned(above))
+          << "row " << i << " of the list is above the copy";
+    }
+  }
+  prefs->SetBoolean(stedding::prefs::kNewTabsAtTop, false);
+}
+
 }  // namespace
