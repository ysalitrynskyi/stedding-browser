+void SpaceModel::NotePinOutOfSession(tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab->GetContents();
+  if (!contents || !registry_) {
+    return;
+  }
+  const SpaceId from = SpaceForTab(tab);
+  const GURL url = contents->GetVisibleURL();
+  // sessions S33: only a page in its Space's own jar now, which an essential
+  // leaves (S8). A new-tab page or one of the browser's own pages is in the
+  // shared session already (S20), and so is the page of a Space whose
+  // session is off (S7): pinning either moves nothing.
+  if (!SpaceIsIsolated(from) ||
+      NeedsOtherJar(contents, url, registry_, from, /*essential=*/false) ||
+      !NeedsOtherJar(contents, url, registry_, from, /*essential=*/true)) {
+    return;
+  }
+  if (!announcing_pins_out_of_session_) {
+    // The first of a turn: a menu or a key pins the whole selection at once,
+    // which is one notice and one undo, and an earlier notice's tabs are no
+    // longer what Undo gives back. Posted, so the notice comes before the
+    // rebind MaybeRebindTabJar posts reloads the page (one posted earlier
+    // leaves a noted tab to it), and outside the strip's notification.
+    pins_out_of_session_.clear();
+    announcing_pins_out_of_session_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SpaceModel::AnnouncePinsOutOfSession,
+                                  weak_factory_.GetWeakPtr()));
+  }
+  const bool space_pin = IsSpacePinned(tab);
+  pins_out_of_session_.emplace_back(
+      tab->GetHandle(), from, space_pin,
+      space_pin ? HomeUrl(tab) : std::optional<GURL>());
+}
+
+void SpaceModel::AnnouncePinsOutOfSession() {
+  announcing_pins_out_of_session_ = false;
+  // A tab closed, unpinned or dragged to another window before the turn
+  // ended has left nothing to say.
+  std::erase_if(pins_out_of_session_, [this](const PinOutOfSession& pin) {
+    const tabs::TabInterface* const tab = pin.tab.Get();
+    return !tab || !tab->IsPinned() || !tab_strip_model_ ||
+           tab_strip_model_->GetIndexOfTab(tab) == TabStripModel::kNoTab;
+  });
+  if (pins_out_of_session_.empty()) {
+    return;
+  }
+  observers_.Notify(&Observer::OnTabsPinnedOutOfSession,
+                    pins_out_of_session_.front().from);
+}
+
+bool SpaceModel::UndoPinsOutOfSession() {
+  // Nothing is undone before it has been announced.
+  if (!tab_strip_model_ || announcing_pins_out_of_session_) {
+    return false;
+  }
+  const std::vector<PinOutOfSession> pins = std::move(pins_out_of_session_);
+  pins_out_of_session_.clear();
+  tabs::TabInterface* first = nullptr;
+  SpaceId shown = active_id_;
+  // The last first: an unpinned tab goes to the top of the tabs under the
+  // essentials, so they come back in the order they had.
+  for (auto it = pins.rbegin(); it != pins.rend(); ++it) {
+    tabs::TabInterface* const tab = it->tab.Get();
+    const int index =
+        tab ? tab_strip_model_->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    if (index == TabStripModel::kNoTab || !tab->IsPinned() ||
+        !GetSpace(it->from)) {
+      continue;
+    }
+    // The unpin files it in the Space on screen (OnTabPinnedStateChanged);
+    // it goes back to the one it left, and its rebind into that Space's jar,
+    // where its sign-ins still are.
+    tab_strip_model_->SetTabPinned(index, false);
+    SetSpaceForTab(tab, it->from);
+    if (it->space_pin) {
+      SetSpacePinned(tab, true);
+      if (it->home) {
+        SetHomeUrl(tab, *it->home);
+      }
+    }
+    first = tab;
+    shown = it->from;
+  }
+  if (!first) {
+    return false;
+  }
+  SetActiveSpace(shown, first);
+  const int index = tab_strip_model_->GetIndexOfTab(first);
+  if (index != TabStripModel::kNoTab) {
+    tab_strip_model_->ActivateTabAt(index);
+  }
+  return true;
+}
