+      "open-file",
+      "email-page",
+      "reading-mode",
+      "caret-browsing",
+      "full-screen",
+      "full-screen-toolbar",
+      "back",
+      "forward",
+      "home",
+      "focus-address",
+      "focus-search",
+      "focus-toolbar",
+      "focus-bookmarks",
+      "focus-next-pane",
+      "focus-previous-pane",
+      "focus-page",
+      "focus-bubble",
+      "app-menu",
+      "profile-menu",
+      "focus-menu",
+      "find",
+      "find-next",
+      "find-previous",
+      "close-find-or-stop",
+      "new-window",
+      "new-private-window",
+      "close-window",
+      "minimize",
+      "hide",
+      "quit",
+      "settings",
+      "app-settings",
+      "history",
+      "downloads",
+      "bookmark-manager",
+      "bookmarks-bar",
+      "clear-browsing-data",
+      "task-manager",
+      "help",
+      "help-menu",
+      "feedback",
+      "developer-tools-toggle",
+      "developer-tools",
+      "javascript-console",
+      "inspect",
+      "view-source",
+      "debug-tablet-mode",
+      "debug-view-tree",
+      "debug-view-tree-details",
+      "debug-window-hierarchy",
+      "debug-layer-hierarchy",
+      "copy",
+      "cut",
+      "paste",
+      "paste-and-match-style",
+      "select-all",
+      "undo",
+      "redo",
+      "page-copy",
+      "page-cut",
+      "page-paste",
+  };
+  std::vector<std::string> names;
+  std::set<int> commands;
+  for (const Entry& entry : Catalog()) {
+    names.push_back(entry.name);
+    EXPECT_TRUE(commands.insert(entry.command).second)
+        << entry.name << ": a command on two rows";
+    EXPECT_EQ(&entry, EntryForName(entry.name));
+  }
+  EXPECT_EQ(shipped, names);
+}
+
+// Z16: a fixed row takes no chord and has no switch: Quit, Close Window,
+// text editing, the Escape rows, focusing the menu; on the Mac Close Tab,
+// whose ⌘W row the app moves to Close Window when a window has no tabs, and
+// full screen.
+TEST(ShortcutCatalogTest, FixedRowsAreReadOnly) {
+  for (const char* name :
+       {"quit", "close-window", "hide", "minimize", "copy", "paste", "undo",
+        "little-close", "close-find-or-stop", "focus-menu"}) {
+    const Entry* const entry = EntryForName(name);
+    ASSERT_TRUE(entry) << name;
+    EXPECT_TRUE(IsFixed(*entry)) << name;
+    EXPECT_FALSE(CanRebind(*entry)) << name;
+    EXPECT_FALSE(CanTurnOff(*entry)) << name;
+  }
+#if BUILDFLAG(IS_MAC)
+  EXPECT_TRUE(IsFixed(*EntryForName("close-tab")));
+  EXPECT_TRUE(IsFixed(*EntryForName("full-screen")));
+#else
+  EXPECT_FALSE(IsFixed(*EntryForName("close-tab")));
+#endif
+  // A family has a switch and no recorder; a follower neither.
+  EXPECT_TRUE(CanTurnOff(*EntryForName("tab-by-number")));
+  EXPECT_FALSE(CanRebind(*EntryForName("tab-by-number")));
+  EXPECT_FALSE(CanTurnOff(*EntryForName("recent-tab-back")));
+
+  // The editor refuses every change to a fixed row, whatever is asked.
+  base::DictValue stored;
+  ShortcutEditor editor(stored, DefaultBindings());
+  const Entry& quit = *EntryForName("quit");
+  EXPECT_EQ(CheckKind::kRefused,
+            editor
+                .Add(quit, Chord(ui::VKEY_J, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN),
+                     /*replace=*/true)
+                .kind);
+  EXPECT_FALSE(editor.SetOff(quit, true));
+  EXPECT_FALSE(editor.Reset(quit));
+  EXPECT_FALSE(stored.FindDict(kCommandsKey) &&
+               stored.FindDict(kCommandsKey)->FindDict("quit"));
+}
+
+// Z17: the families are the nine row chords and the nine Space chords.
+TEST(ShortcutCatalogTest, FamiliesHoldNine) {
+  EXPECT_EQ(9u, MembersOf(*EntryForName("tab-by-number")).size());
+  EXPECT_EQ(9u, MembersOf(*EntryForName("space-by-number")).size());
+  EXPECT_EQ(EntryForName("tab-by-number"),
+            EntryForCommand(IDC_SELECT_LAST_TAB));
+  EXPECT_EQ(EntryForName("space-by-number"),
+            EntryForCommand(IDC_STEDDING_SPACE_9));
+}
+
+// Z13: the shipped tables bind no chord to two commands, an alias's second
+// command (Paste in the page's menu beside the Edit menu's, the little
+// window's Escape beside Stop's) counting as its row's.
+TEST(ShortcutTableTest, NoChordBindsTwoCommands) {
+  std::map<Chord, std::set<int>> holders;
+  for (const Binding& binding : DefaultBindings()) {
+    holders[binding.chord].insert(ConflictCommand(binding.command));
+  }
+  for (const auto& [chord, commands] : holders) {
+    EXPECT_EQ(1u, commands.size())
+        << ChordToString(chord) << " binds " << commands.size()
+        << " commands, the first " << *commands.begin();
+  }
+}
+
+}  // namespace
