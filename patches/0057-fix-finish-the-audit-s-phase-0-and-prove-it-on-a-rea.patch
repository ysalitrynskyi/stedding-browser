+// spaces B33, folders F20: a folder shows only in a Space that holds one of
+// its tabs, and expanding it never brings back another Space's rows.
+TEST_F(FolderRowsTest, AFolderShowsOnlyInTheSpacesOfItsTabs) {
+  const spaces::SpaceId home = space_model().active_id();
+  tabs::TabInterface* const loose = OpenTab();
+  tabs::TabInterface* const inner_tab = OpenTab();
+  tabs::TabInterface* const outer_tab = OpenTab();
+  tabs::FolderTabCollection* const outer = tabs().AddToNewFolder({0, 1});
+  ASSERT_NE(nullptr, outer);
+  tabs::FolderTabCollection* const inner =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(inner_tab)});
+  ASSERT_NE(nullptr, inner);
+  Activate(loose);
+  spaces::Space* const work = space_model().AddSpace("Work", kBlue);
+
+  std::unique_ptr<views::Widget> widget = MakeWidget();
+  views::View* const root =
+      widget->SetContentsView(std::make_unique<views::View>());
+  FolderView* const outer_view = AddFolderView(*root, outer);
+  FolderView* const inner_view = AddFolderView(*outer_view, inner);
+  spaces::SpaceTabVisibilityController controller(&space_model(), tabs(),
+                                                 *root);
+  ASSERT_TRUE(inner_view->GetVisible());
+
+  // Move to Space on the nested folder's only tab.
+  space_model().SetSpaceForTab(inner_tab, work->id());
+  EXPECT_TRUE(outer_view->GetVisible());
+  EXPECT_FALSE(inner_view->GetVisible()) << "it holds no tab of this Space";
+
+  outer_view->ExecuteCommand(FolderView::kToggleCommand, /*event_flags=*/0);
+  outer_view->ExecuteCommand(FolderView::kToggleCommand, /*event_flags=*/0);
+  ASSERT_FALSE(outer->collapsed());
+  EXPECT_FALSE(inner_view->GetVisible())
+      << "expanding does not show another Space's folder";
+
+  space_model().SetActiveSpace(work->id());
+  EXPECT_TRUE(outer_view->GetVisible());
+  EXPECT_TRUE(inner_view->GetVisible());
+
+  space_model().SetSpaceForTab(outer_tab, work->id());
+  space_model().SetActiveSpace(home);
+  EXPECT_FALSE(outer_view->GetVisible())
+      << "every tab of the folder is in Work now";
+  EXPECT_FALSE(inner_view->GetVisible());
+}
