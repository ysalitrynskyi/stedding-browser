+void SpaceModel::MoveFolderToSpace(tabs::FolderTabCollection* folder,
+                                   const SpaceId& id) {
+  if (!folder || !tab_strip_model_ || !GetSpace(id) ||
+      folder->TabCountRecursive() == 0) {
+    return;
+  }
+  // The folder's row in the unpinned block: itself, or the folder or group
+  // around it.
+  tabs::TabCollection* row = folder;
+  while (row->GetParentCollection() &&
+         row->GetParentCollection()->type() !=
+             tabs::TabCollection::Type::UNPINNED) {
+    row = row->GetParentCollection();
+  }
+  tabs::TabCollection* const block = row->GetParentCollection();
+  if (!block || std::ranges::all_of(folder->GetTabsRecursive(),
+                                    [&](const tabs::TabInterface* tab) {
+                                      return FindSpaceForTab(tab) == id;
+                                    })) {
+    return;
+  }
+  // folders F37: nested, it comes out first, whole, to just after that row,
+  // so the folder around it stays in its Space.
+  if (row != folder) {
+    const std::optional<size_t> index = block->GetIndexOfCollection(row);
+    if (!index ||
+        !tab_strip_model_->MoveFolderInto(folder, block, *index + 1)) {
+      return;
+    }
+  }
+  // The row on screen last. Filed in another Space it leaves the window to
+  // show something else, and with it first that was the next row of this
+  // folder, then the next: each woke as it went, a pin asleep too.
+  std::vector<tabs::TabInterface*> moving = folder->GetTabsRecursive();
+  tabs::TabInterface* const active = tab_strip_model_->GetActiveTab();
+  if (active) {
+    const std::vector<tabs::TabInterface*> shown = SplitPeers(active);
+    std::ranges::stable_partition(moving, [&](const tabs::TabInterface* tab) {
+      return !std::ranges::contains(shown, tab);
+    });
+  }
+  for (tabs::TabInterface* const tab : moving) {
+    SetSpaceForTab(tab, id);
+  }
+  // By row, not tab by tab: a folder's place is read among that Space's rows
+  // now that it is one of them. A folder with a loose tab keeps its pins, so
+  // this is no SetFolderSpacePinned, which would unpin them.
+  tab_strip_model_->MoveTopLevelFolder(
+      folder, std::min(SlotAtEndOfPinRun(folder), block->ChildCount() - 1));
+  // The row moved; the line and the run are drawn again.
+  for (tabs::TabInterface* const tab : moving) {
+    observers_.Notify(&Observer::OnTabSpaceChanged, tab);
+  }
+}
