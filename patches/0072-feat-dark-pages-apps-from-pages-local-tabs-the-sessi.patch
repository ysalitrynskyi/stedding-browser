+      [&](BrowserWindowInterface* browser) {
+        const BrowserWindowInterface::Type type = browser->GetType();
+        another = browser != closing && browser->GetProfile() == profile &&
+                  (type == BrowserWindowInterface::Type::TYPE_NORMAL ||
+                   type == BrowserWindowInterface::Type::TYPE_POPUP) &&
+                  !BrowserInitState::From(browser)
+                       ->omit_from_session_restore() &&
+                  !browser->IsDeleteScheduled() &&
+                  !browser->GetTabStripModel()->closing_all();
+        return !another;
