+// The drawn row of `tab` under `parent`, or null.
+const TabView* DrawnRowOf(const views::View& parent,
+                          const tabs::TabInterface* tab) {
+  for (const views::View* const child : parent.children()) {
+    if (const auto* const tab_view = views::AsViewClass<TabView>(child)) {
+      if (tab_view->GetTabInterface() == tab) {
+        return tab_view;
+      }
+      continue;
+    }
+    if (const TabView* const found = DrawnRowOf(*child, tab)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
