+// P13-1b, sidebar-file Sf33: a Space's name and a pinned folder's title past
+// what a file holds go into the file cut between two characters, so every
+// computer still reads it, and stay whole here. Written whole, the file was
+// refused by every other computer and read as broken here, where it was
+// written again at every read of the folder.
+IN_PROC_BROWSER_TEST_F(SidebarSyncB11Test,
+                       ALongNameStillMakesAFileEveryComputerReads) {
+  ASSERT_NO_FATAL_FAILURE(Join());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return ReadOwnFile().status == sb::ParseStatus::kOk; }));
+  // Every write the join started is done.
+  content::RunAllTasksUntilIdle();
+  const std::string before = ReadOwnJson();
+  ASSERT_FALSE(before.empty());
+
+  // 200 Cyrillic letters, 400 bytes: 128 of them fit.
+  std::string name;
+  for (int i = 0; i < 200; ++i) {
+    name += "\xD0\x96";
+  }
+  const std::string cut_name = name.substr(0, 128 * 2);
+  const spaces::SpaceId id = model().active_id();
+  model().SetSpaceName(id, name);
+  // 300 letters: 256 of them fit.
+  const std::string title(300, 'a');
+  tabs::TabInterface* const pin = OpenPin();
+  ASSERT_TRUE(pin);
+  tabs::FolderTabCollection* const folder = MakePinnedFolder({pin});
+  ASSERT_TRUE(folder);
+  folder->SetTitle(title);
+  const std::string folder_id = spaces::FolderSyncId(folder->id());
+  service()->CommitForTesting();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const std::string json = ReadOwnJson();
+    if (json.empty() || json == before) {
+      return false;
+    }
+    const sb::ParsedFile own = sb::ParseSyncFile(json);
+    return own.status != sb::ParseStatus::kOk ||
+           (own.state.records.contains(folder_id) &&
+            own.state.records.contains(id.ToString()) &&
+            !own.state.records.at(id.ToString())
+                 .Get(sb::kFieldName)
+                 .empty());
+  }));
+  content::RunAllTasksUntilIdle();
+  const sb::ParsedFile own = ReadOwnFile();
+  ASSERT_EQ(sb::ParseStatus::kOk, own.status)
+      << "every computer refuses this computer's file";
+  ASSERT_TRUE(own.state.records.contains(id.ToString()));
+  EXPECT_EQ(cut_name,
+            own.state.records.at(id.ToString()).Get(sb::kFieldName));
+  ASSERT_TRUE(own.state.records.contains(folder_id));
+  EXPECT_EQ(title.substr(0, sb::kMaxTextLength),
+            own.state.records.at(folder_id).Get(sb::kFieldTitle));
+
+  // Read as this computer's own, the file is not written again at each read
+  // of the folder, and the cut copies do not cut the names here.
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  content::RunAllTasksUntilIdle();
+  const int64_t written = service()->ledger_for_testing()->seq;
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  EXPECT_EQ(written, service()->ledger_for_testing()->seq)
+      << "the file was written again at each read of the folder";
+  ASSERT_TRUE(registry().Find(id));
+  EXPECT_EQ(name, registry().Find(id)->name) << "the name here was cut";
+  EXPECT_EQ(title, folder->title()) << "the title here was cut";
+}
