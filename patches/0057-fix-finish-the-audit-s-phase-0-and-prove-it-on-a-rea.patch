--- /dev/null
+++ b/chrome/browser/ui/stedding/tab_menu_verbs.h
@@ -0,0 +1,55 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_TAB_MENU_VERBS_H_
+#define CHROME_BROWSER_UI_STEDDING_TAB_MENU_VERBS_H_
+
+class TabStripModel;
+
+namespace stedding {
+
+// Stedding's verbs in the tab menu (docs/features/menus.md M1, M7, M8),
+// answered and run here for both tab strips: the sidebar's
+// TabStripCollectionController asks directly, and the horizontal strip's
+// BrowserTabStripController through TabStripModel's context-menu API, so the
+// two cannot drift apart (PLAN.md TAB-18, CMD-2).
+//
+// The verbs are the per-Space pin pair, Rename, Sleep Tab and Sleep Others,
+// Reset to Pinned Page and Make This the Pinned Page, Copy Link and Copy as
+// Markdown outside a web app's window (a web app keeps Chromium's Copy URL),
+// and "Move to Space" and "Always Open <site> in": both submenu rows and
+// every id in their ranges, the ids between First and Last that no enumerator
+// names included. The Space commands need the window's SpaceModel; in a window
+// without one (a popup, an app, a private window) they are disabled.
+
+// Whether the strip that asks can rename a row in place (tabs R14). The
+// sidebar's rows can; the horizontal strip has no row to rename in.
+enum class RenameInPlace { kUnavailable, kAvailable };
+
+// Whether `command_id` is one of the verbs above in the window of `tabs`.
+bool IsTabMenuVerb(const TabStripModel& tabs, int command_id);
+
+// Whether the verb is enabled on the menu opened on the tab at `index`. False
+// for an index the strip no longer has, for a command that is not a verb, and
+// for a Move to Space or Always Open entry past the Spaces the window has now:
+// the menu is built from a list that can shrink while it is open.
+bool IsTabMenuVerbEnabled(const TabStripModel& tabs,
+                          int index,
+                          int command_id,
+                          RenameInPlace rename);
+
+// Runs the verb on the menu opened on the tab at `index`, on the whole
+// selection when that tab is part of it (tabs R21). Does nothing when the
+// verb is disabled, and nothing for Rename, which only the strip that draws
+// the row can start.
+void ExecuteTabMenuVerb(TabStripModel& tabs, int index, int command_id);
+
+// Whether the menu row `command_id` shows for the tab at `index`, by the kind
+// of row the tab is (menus M7: an essential, a Space-pinned row, a plain
+// row). True for every command that rule does not name.
+bool IsTabMenuRowVisible(const TabStripModel& tabs, int index, int command_id);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_TAB_MENU_VERBS_H_
diff --git a/chrome/browser/ui/stedding/tab_menu_verbs_unittest.cc b/chrome/browser/ui/stedding/tab_menu_verbs_unittest.cc
