+std::vector<int> SwitcherDragOffsets(const std::vector<SwitcherSpan>& spans,
+                                     size_t from,
+                                     int pointer) {
+  std::vector<int> offsets(spans.size(), 0);
+  if (from >= spans.size()) {
+    return offsets;
+  }
+  std::vector<int> centres;
+  for (const SwitcherSpan& span : spans) {
+    centres.push_back(span.start + span.extent / 2);
+  }
+  const size_t to = SwitcherDropIndex(centres, pointer);
+  // The row as it will be once the chip lands: the same chips, the same gap
+  // apart, from the same first edge.
+  const int gap = spans.size() > 1
+                      ? spans[1].start - (spans[0].start + spans[0].extent)
+                      : 0;
+  std::vector<size_t> order;
+  for (size_t i = 0; i < spans.size(); ++i) {
+    if (i != from) {
+      order.push_back(i);
+    }
+  }
+  order.insert(order.begin() + static_cast<std::ptrdiff_t>(to), from);
+  int position = spans.front().start;
+  for (const size_t chip : order) {
+    offsets[chip] = position - spans[chip].start;
+    position += spans[chip].extent + gap;
+  }
+  // The dragged chip follows the pointer, kept within the row.
+  const SwitcherSpan& dragged = spans[from];
+  const int first = spans.front().start;
+  const int last = std::max(
+      first, spans.back().start + spans.back().extent - dragged.extent);
+  offsets[from] =
+      std::clamp(pointer - dragged.extent / 2, first, last) - dragged.start;
+  return offsets;
+}
+
 }  // namespace spaces
