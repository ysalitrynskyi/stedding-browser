+namespace {
+
+// Lets `delay` of real time go by with the browser running.
+void WaitW2B27(base::TimeDelta delay) {
+  base::RunLoop wait;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, wait.QuitClosure(), delay);
+  wait.Run();
+}
+
+// Pinned pages at a.test with links to other sites, set up as peek_browsertest
+// sets up its own, with "Open a peek with" set to a press held 0.3 s.
+class PeekW2B27Test : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    // A frame from another site is in a process of its own, with its own
+    // widget, on every platform the test runs on.
+    content::IsolateAllSitesForTesting(command_line);
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_https_test_server().SetSSLConfig(
+        net::EmbeddedTestServer::CERT_TEST_NAMES);
+    // The link whose server answers only when the test says so.
+    slow_out_ = std::make_unique<net::test_server::ControllableHttpResponse>(
+        &embedded_https_test_server(), "/slow-out");
+    ASSERT_TRUE(embedded_https_test_server().Start());
+    PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+    prefs->SetBoolean(stedding::prefs::kPeekEnabled, true);
+    prefs->SetInteger(stedding::prefs::kPeekStyle,
+                      stedding::prefs::kPeekStyleSmallWindow);
+    prefs->SetInteger(stedding::prefs::kPeekHoldDelayMs, 300);
+  }
+
+  void TearDownOnMainThread() override {
+    slow_out_.reset();
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  content::WebContents* contents() { return tabs().GetActiveWebContents(); }
+
+  GURL Url(const std::string& host, const std::string& path) {
+    return embedded_https_test_server().GetURL(host, path);
+  }
+
+  // The script that puts a link to `to`, as `target`, at the top of a page.
+  static std::string AddLinkScript(const GURL& to, const std::string& target) {
+    return base::StringPrintf(
+        "const a = document.createElement('a');"
+        "a.id = 'link'; a.href = '%s'; a.target = '%s';"
+        "a.textContent = 'the link';"
+        "a.style = 'display:block;font-size:40px;padding:20px';"
+        "document.body.prepend(a);",
+        to.spec().c_str(), target.c_str());
+  }
+
+  // The page at a.test in a tab of its own, pinned, with one link, to `to`.
+  void OpenPin(const GURL& to) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("a.test", "/title1.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    ASSERT_TRUE(content::ExecJs(contents(), AddLinkScript(to, ""),
+                                content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    tabs().SetTabPinned(tabs().active_index(), true);
+    ASSERT_EQ(Url("a.test", "/title1.html"), contents()->GetLastCommittedURL());
+  }
+
+  // The page at a.test in a tab of its own, pinned, with a frame from c.test
+  // over its top left corner, 320 by 240 DIP; the frame holds one link, to
+  // `to`, for a new tab. Returns the frame.
+  content::RenderFrameHost* OpenPinWithFrame(const GURL& to) {
+    if (!ui_test_utils::NavigateToURLWithDisposition(
+            browser(), Url("a.test", "/title1.html"),
+            WindowOpenDisposition::kNewForegroundTab,
+            ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP)) {
+      ADD_FAILURE() << "the pin did not load";
+      return nullptr;
+    }
+    EXPECT_EQ(true,
+              content::EvalJs(
+                  contents(),
+                  base::StringPrintf(
+                      "new Promise(resolve => {"
+                      "  const f = document.createElement('iframe');"
+                      "  f.src = '%s';"
+                      "  f.style = 'position:fixed;left:0;top:0;width:320px;"
+                      "height:240px;border:0;margin:0;z-index:1';"
+                      "  f.onload = () => resolve(true);"
+                      "  document.body.prepend(f);"
+                      "});",
+                      Url("c.test", "/title2.html").spec().c_str()),
+                  content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    content::RenderFrameHost* const frame =
+        content::ChildFrameAt(contents()->GetPrimaryMainFrame(), 0);
+    if (!frame) {
+      ADD_FAILURE() << "no frame";
+      return nullptr;
+    }
+    EXPECT_TRUE(content::ExecJs(frame, AddLinkScript(to, "_blank"),
+                                content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    tabs().SetTabPinned(tabs().active_index(), true);
+    return frame;
+  }
+
+  // The user's left button held down at `point` of the page, in DIP from the
+  // page's top left corner, for `held`, then let up. Routed as the window
+  // routes a real press: to the frame under the point.
+  void PressAt(const gfx::Point& point, base::TimeDelta held) {
+    content::SimulateMouseEvent(contents(),
+                                blink::WebInputEvent::Type::kMouseDown,
+                                blink::WebMouseEvent::Button::kLeft, point);
+    if (held.is_positive()) {
+      WaitW2B27(held);
+    }
+    content::SimulateMouseEvent(contents(),
+                                blink::WebInputEvent::Type::kMouseUp,
+                                blink::WebMouseEvent::Button::kLeft, point);
+  }
+
+  // The peek over the window, once its page has loaded.
+  BrowserWindowInterface* WaitForPeek() {
+    if (!base::test::RunUntil(
+            [&]() { return stedding::PeekOver(browser()) != nullptr; })) {
+      ADD_FAILURE() << "no peek: the active tab is at "
+                    << contents()->GetLastCommittedURL();
+      return nullptr;
+    }
+    BrowserWindowInterface* const peek = stedding::PeekOver(browser());
+    content::WebContents* const page =
+        peek->GetTabStripModel()->GetActiveWebContents();
+    return page && content::WaitForLoadStop(page) ? peek : nullptr;
+  }
+
+  std::unique_ptr<net::test_server::ControllableHttpResponse> slow_out_;
+};
+
+// P35-1b; peek P18, P22. With a held press asked for, a press held 0.45 s
+// on the pin follows a link on the pin's own site, and the server sends it to
+// another site 1.2 s after the button came up. The redirect is judged with
+// the press the link was followed with, and peeks. The press was read again
+// when the redirect came, by then more than the second a press is kept, so
+// the pin itself went to the other site.
+IN_PROC_BROWSER_TEST_F(PeekW2B27Test,
+                       AHeldPressPeeksALinkTheServerRedirectsLate) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("a.test", "/slow-out")));
+
+  // Beside the link, so the press itself follows nothing.
+  PressAt(gfx::Point(400, 300), base::Milliseconds(450));
+  ASSERT_TRUE(
+      content::ExecJs(contents(), "document.getElementById('link').click();"));
+  slow_out_->WaitForRequest();
+  WaitW2B27(base::Milliseconds(1200));
+  slow_out_->Send(net::HTTP_FOUND, "text/html", /*content=*/"",
+                  /*cookies=*/{}, {"Location: " + to.spec()});
+  slow_out_->Done();
+
+  BrowserWindowInterface* const peek = WaitForPeek();
+  ASSERT_TRUE(peek) << "the late redirect of a held press stayed in the pin";
+  EXPECT_EQ(
+      to,
+      peek->GetTabStripModel()->GetActiveWebContents()->GetLastCommittedURL());
+  EXPECT_EQ(Url("a.test", "/title1.html"), contents()->GetLastCommittedURL());
+}
+
+// P36-1f; peek P18. A press held 0.45 s on a frame from another site, then
+// its link for a new tab, peeks the link; a held press on the page and then
+// a quick one on the frame is a quick press, and the link opens its tab. The
+// press was kept from the main frame's widget alone: the frame's own was
+// never seen, so a held press there followed the link as a click, and a
+// quick one there left the page's held press to peek.
+IN_PROC_BROWSER_TEST_F(PeekW2B27Test, AHeldPressInACrossSiteFramePeeksItsLink) {
+  const GURL to = Url("b.test", "/title3.html");
+  content::RenderFrameHost* const frame = OpenPinWithFrame(to);
+  ASSERT_TRUE(frame);
+  ASSERT_NE(contents()->GetPrimaryMainFrame()->GetRenderWidgetHost(),
+            frame->GetRenderWidgetHost())
+      << "the premise: the frame has a widget of its own";
+  content::WaitForHitTestData(frame);
+  const int count = tabs().count();
+  // In the frame, below its link; and on the page, beside the frame.
+  const gfx::Point in_frame(160, 180);
+  const gfx::Point on_page(400, 300);
+
+  {
+    SCOPED_TRACE("a held press on the frame");
+    PressAt(in_frame, base::Milliseconds(450));
+    ASSERT_TRUE(
+        content::ExecJs(frame, "document.getElementById('link').click();"));
+    BrowserWindowInterface* const peek = WaitForPeek();
+    ASSERT_TRUE(peek) << "a press held for 0.45 s on the frame did not peek";
+    EXPECT_EQ(to, peek->GetTabStripModel()
+                      ->GetActiveWebContents()
+                      ->GetLastCommittedURL());
+    EXPECT_EQ(count, tabs().count()) << "the link opened a tab";
+    EXPECT_EQ(Url("a.test", "/title1.html"),
+              contents()->GetLastCommittedURL());
+    peek->GetWindow()->Close();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return stedding::PeekOver(browser()) == nullptr; }));
+  }
+  {
+    SCOPED_TRACE("a held press on the page, then a quick one on the frame");
+    PressAt(on_page, base::Milliseconds(450));
+    PressAt(in_frame, base::TimeDelta());
+    ASSERT_TRUE(
+        content::ExecJs(frame, "document.getElementById('link').click();"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      for (int i = 0; i < tabs().count(); ++i) {
+        if (tabs().GetWebContentsAt(i)->GetLastCommittedURL() == to) {
+          return true;
+        }
+      }
+      return false;
+    })) << "the link did not open its tab";
+    content::RunAllTasksUntilIdle();
+    EXPECT_FALSE(stedding::PeekOver(browser())) << "a quick press peeked";
+    EXPECT_EQ(count + 1, tabs().count());
+  }
+}
+
+spaces::SpaceModel& ModelW2B27(BrowserWindowInterface* browser) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  CHECK(model);
+  return *model;
+}
+
+// Done, as the dialog's own button does, and the window gone. The widget is
+// not read after the button: on Windows it is freed as it closes.
+void AcceptEditSpaceW2B27(spaces::EditSpaceView* view) {
+  views::Widget* const widget = view->GetWidget();
+  ASSERT_TRUE(widget);
+  views::DialogDelegate* const dialog =
+      widget->widget_delegate()->AsDialogDelegate();
+  ASSERT_TRUE(dialog);
+  views::test::WidgetDestroyedWaiter destroyed(widget);
+  dialog->AcceptDialog();
+  destroyed.Wait();
+}
+
+using EditSpaceW2B27Test = InProcessBrowserTest;
+
+// P36-1e; spaces B43. Text that is not a hex colour leaves the colour as it
+// was: six Cyrillic letters, as typed with a Ukrainian or Russian layout on
+// the keys of "ffffff", are none. Each was narrowed to its low byte, U+0430
+// to '0', so they read as black, which Done saved; a build with DCHECKs
+// stopped.
+IN_PROC_BROWSER_TEST_F(EditSpaceW2B27Test, NonAsciiTextInTheHexFieldIsNoColour) {
+  spaces::SpaceModel& model = ModelW2B27(browser());
+  const spaces::SpaceId id = model.AddSpace("Work", SK_ColorGRAY)->id();
+  constexpr SkColor kTyped = SkColorSetRGB(0x3E, 0x63, 0xDD);
+
+  spaces::EditSpaceView* const view =
+      spaces::ShowEditSpaceDialog(browser(), id);
+  ASSERT_TRUE(view);
+  view->TypeHexForTesting(u"#3e63dd");
+  ASSERT_EQ(kTyped, view->light_color()) << "the premise: a hex is a colour";
+  view->TypeHexForTesting(u"аааааа");
+  EXPECT_EQ(kTyped, view->light_color()) << "Cyrillic letters made a colour";
+  view->TypeHexForTesting(u"#аааааа");
+  EXPECT_EQ(kTyped, view->light_color())
+      << "Cyrillic letters after a # made a colour";
+  ASSERT_NO_FATAL_FAILURE(AcceptEditSpaceW2B27(view));
+
+  const spaces::Space* const space = model.GetSpace(id);
+  ASSERT_TRUE(space);
+  EXPECT_EQ(kTyped, space->color());
+}
+
+}  // namespace
