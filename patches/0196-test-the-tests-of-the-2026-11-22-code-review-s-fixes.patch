+using user_data_importer::ImportedBookmarkEntry;
+
+// The most UTF-16 characters of folder names a read copies into its
+// entries' paths, 16M.
+constexpr size_t kPathBudgetW2B10 = 16u * 1024 * 1024;
+
+// P11-1c, import I29: every entry carries its whole folder path, so a folder
+// with a long name over many pages and empty folders was copied once per
+// entry: a file of a megabyte or so asked for gigabytes. The copies stop at
+// a budget, and what lies past it is counted as left out.
+TEST(ChromiumBookmarksW2B10Test, ALongFolderNameIsNotCopiedPastTheBudget) {
+  constexpr size_t kNameLength = 32 * 1024;
+  constexpr size_t kPages = 1000;
+  constexpr size_t kEmptyFolders = 200;
+  std::string json =
+      R"json({"roots": {"other": {"type": "folder", "name": "Other",)json"
+      R"json( "children": [{"type": "folder", "name": ")json";
+  json.append(kNameLength, 'a');
+  json.append(R"json(", "children": [)json");
+  for (size_t i = 0; i < kPages; ++i) {
+    json.append(i ? "," : "");
+    json.append(R"json({"type": "url", "name": "P", "url": "https://p)json");
+    json.append(base::NumberToString(i));
+    json.append(R"json(.example/"})json");
+  }
+  for (size_t i = 0; i < kEmptyFolders; ++i) {
+    json.append(R"json(,{"type": "folder", "name": "E", "children": []})json");
+  }
+  json.append(R"json(]}]}}, "version": 1})json");
+
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath file = dir.GetPath().AppendASCII("Bookmarks");
+  ASSERT_TRUE(base::WriteFile(file, json));
+  ASSERT_LT(json.size(), 200u * 1024) << "the file itself is small";
+
+  const ChromiumBookmarks read = ReadChromiumBookmarks(file);
+  EXPECT_FALSE(read.unreadable);
+  size_t copied = 0;
+  for (const ImportedBookmarkEntry& entry : read.entries) {
+    for (const std::u16string& name : entry.path) {
+      copied += name.size();
+    }
+  }
+  EXPECT_LE(copied, kPathBudgetW2B10)
+      << "the folder's name was copied into every entry";
+  EXPECT_GT(read.left_out, 0u) << "nothing past the budget was counted";
+  // What came in and what was left out are every entry the folder holds.
+  EXPECT_EQ(kPages + kEmptyFolders, read.entries.size() + read.left_out);
+  // The first pages, up to the budget, still come in whole.
+  ASSERT_FALSE(read.entries.empty());
+  ASSERT_EQ(1u, read.entries.front().path.size());
+  EXPECT_EQ(kNameLength, read.entries.front().path.front().size());
+  EXPECT_FALSE(read.entries.front().is_folder);
+}
+
+}  // namespace
+}  // namespace spaces
