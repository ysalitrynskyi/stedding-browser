+SiteControlsStripView::SiteControlsStripView(std::unique_ptr<Delegate> delegate)
+    : delegate_(std::move(delegate)) {
+  SetProperty(views::kElementIdentifierKey, kElementId);
+  auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal,
+      gfx::Insets::VH(0, kStripSideInset), kStripSpacing));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  // Si11: the order Tab goes through them is the order they are drawn in.
+  copy_link_ = AddIconButton(Action::kCopyLink, kCopyLinkElementId, this);
+  copy_title_ = AddIconButton(Action::kCopyTitle, kCopyTitleElementId, this);
+  mute_ = AddIconButton(Action::kToggleMute, kMuteElementId, this);
+  picture_in_picture_ = AddIconButton(Action::kTogglePictureInPicture,
+                                      kPictureInPictureElementId, this);
+
+  views::View* const gap = AddChildView(std::make_unique<views::View>());
+  layout->SetFlexForView(gap, 1);
+
+  zoom_out_ = AddIconButton(Action::kZoomOut, kZoomOutElementId, this);
+  zoom_reset_ = AddChildView(std::make_unique<views::LabelButton>(
+      base::BindRepeating(&SiteControlsStripView::OnPressed,
+                          base::Unretained(this), Action::kZoomReset),
+      std::u16string()));
+  zoom_reset_->SetProperty(views::kElementIdentifierKey, kZoomResetElementId);
+  zoom_reset_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  // Wide enough for "500%", so the stepper does not shift as it zooms.
+  zoom_reset_->SetMinSize(gfx::Size(48, 0));
+  zoom_in_ = AddIconButton(Action::kZoomIn, kZoomInElementId, this);
+
+  delegate_->SetStrip(this);
+  Update();
+}
+
+SiteControlsStripView::~SiteControlsStripView() {
+  // The delegate observes the page and calls back into this view.
+  delegate_->SetStrip(nullptr);
+}
