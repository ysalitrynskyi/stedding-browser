+
+#ifndef CHROME_BROWSER_UI_SPACES_ARC_SIDEBAR_IMPORTER_H_
+#define CHROME_BROWSER_UI_SPACES_ARC_SIDEBAR_IMPORTER_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+
+namespace spaces {
+
+// docs/features/import.md I1: Arc's sidebar, StorableSidebar.json, as a plan
+// Stedding can apply -- Spaces with their icon and nearest colour, the
+// essentials row, and per Space the pinned and unpinned items, folders
+// nesting as Arc's lists do.
+struct ArcImportPlan {
+  struct Node {
+    enum class Kind { kTab, kFolder };
+    Node();
+    Node(const Node& other);
+    Node(Node&& other);
+    Node& operator=(const Node& other);
+    Node& operator=(Node&& other);
+    ~Node();
+
+    Kind kind = Kind::kTab;
+    std::string arc_id;
+    std::u16string title;
+    GURL url;
+    std::vector<Node> children;
+  };
+
+  struct Space {
+    Space();
+    Space(const Space& other);
+    Space(Space&& other);
+    Space& operator=(const Space& other);
+    Space& operator=(Space&& other);
+    ~Space();
+
+    std::string arc_id;
+    std::string title;
+    std::string emoji;
+    // I10: the nearest Stedding swatch, when Arc had a theme.
+    std::optional<SkColor> color;
+    // I8: Arc's per-Space profile, which Stedding does not carry over.
+    std::string profile;
+    std::vector<Node> pinned;
+    std::vector<Node> unpinned;
+  };
+
+  ArcImportPlan();
+  ArcImportPlan(const ArcImportPlan& other);
+  ArcImportPlan(ArcImportPlan&& other);
+  ArcImportPlan& operator=(const ArcImportPlan& other);
+  ArcImportPlan& operator=(ArcImportPlan&& other);
+  ~ArcImportPlan();
+
+  std::vector<Space> spaces;
+  std::vector<Node> essentials;
+
+  // The counts the summary shows (I2).
+  size_t pinned_tab_count() const;
+  size_t unpinned_tab_count() const;
+  size_t folder_count() const;
+  std::vector<std::string> dropped_profiles() const;
+};
+
+// The essentials row holds this many at most (I11).
+inline constexpr size_t kMaxEssentials = 12;
+
+// Parses the file's JSON. Nullopt when it is not Arc's sidebar.
+std::optional<ArcImportPlan> ParseArcSidebar(std::string_view json);
+
+// The one line the welcome flow and the settings row show before anything
+// is applied (I2), with the dropped profiles (I8) and the essentials beyond
+// twelve (I11) named.
+std::u16string SummariseArcImport(const ArcImportPlan& plan);
+
+// ~/Library/Application Support/Arc/StorableSidebar.json.
+base::FilePath ArcSidebarPath();
+
+// I9: reads a copy of the file, because Arc rewrites it while it runs.
+// Blocking: call from the thread pool. Nullopt when there is no file.
+std::optional<std::string> ReadArcSidebar(const base::FilePath& path);
+
+// I9: whether Arc is running now, so the flow can say the file may be
+// mid-write. Blocking: call from the thread pool.
+bool IsArcRunning();
+
+// The nearest Stedding swatch to an Arc theme colour (I10).
+SkColor NearestSpaceColor(SkColor arc_color);
+
+struct ArcImportOptions {
+  bool spaces = true;
+  bool pinned = true;
+  bool unpinned = true;
+};
+
+struct ArcImportResult {
+  size_t spaces = 0;
+  size_t tabs = 0;
+  size_t folders = 0;
+  size_t essentials = 0;
+  // I12: already present from an earlier import.
+  size_t skipped = 0;
+};
+
+// Applies `plan` to `browser`'s window (I3): Spaces, essentials (capped at
+// twelve, I11), the pinned runs, folders, every tab inserted unloaded. A
+// second run adds nothing already present: Arc's ids are remembered in the
+// profile (I12).
+ArcImportResult ApplyArcImport(BrowserWindowInterface* browser,
+                               const ArcImportPlan& plan,
+                               const ArcImportOptions& options);
+
+// I4: whether this Mac has the file, learned once off the UI thread at the
+// first window, so the bar can offer the import from its first opening.
+void PrimeArcSidebarPresence();
+bool ArcSidebarPresent();
+
+// What the entry points ask before offering an import (I2, I9).
+struct ArcSidebarInfo {
+  ArcSidebarInfo();
+  ArcSidebarInfo(const ArcSidebarInfo& other);
+  ~ArcSidebarInfo();
+  bool found = false;
+  bool arc_running = false;
+  std::u16string summary;
+  std::optional<ArcImportPlan> plan;
+};
+using ArcSidebarInfoCallback = base::OnceCallback<void(ArcSidebarInfo)>;
+
+// Reads and parses the file on the thread pool and answers on the caller's
+// sequence.
+void LoadArcSidebarInfo(ArcSidebarInfoCallback callback);
+
+using ArcImportDoneCallback =
+    base::OnceCallback<void(std::optional<ArcImportResult>)>;
+
+// The whole thing for the settings row and the bar: read on the thread pool,
+// then apply to `browser` with `options`. Nullopt when there is no file, it
+// does not parse, or the window went away.
+void ImportFromArcAsync(BrowserWindowInterface* browser,
+                        const ArcImportOptions& options,
+                        ArcImportDoneCallback done);
+
+// A one-line account of what an import did, for the flow and the toast.
+std::u16string DescribeArcImportResult(const ArcImportResult& result);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_ARC_SIDEBAR_IMPORTER_H_
