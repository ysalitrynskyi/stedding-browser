+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+
+class BrowserWindowInterface;
+
+namespace spaces {
+
+// Arc's keyboard for Spaces (docs/features/spaces.md B18-B23), as free
+// functions the command controller and the menu bar call. Each is a no-op in
+// a window without Spaces.
+
+// True in a window that takes the Space commands: a normal, non-private
+// window with a SpaceModel (B29). Popup and app windows have no Spaces (B14);
+// private windows will have none.
+bool SupportsSpaceCommands(BrowserWindowInterface* browser);
+
+// Ctrl-1..9: the Space at `index` in switcher order; past the end, nothing
+// (B18).
+void ActivateSpaceAt(BrowserWindowInterface* browser, size_t index);
+
+// Option-Cmd-Right / Left: the next / previous Space, no wrap (B19).
+void SwitchSpace(BrowserWindowInterface* browser, bool forward);
+
+// Shift-Cmd-K and the sidebar's Clear line (B20).
+void ClearActiveSpace(BrowserWindowInterface* browser);
+
+// Cmd-D: pin the active tab in its Space, or unpin it. An essentials
+// (Chromium-pinned) tab is left alone (B21, B28).
+void ToggleSpacePinOnActiveTab(BrowserWindowInterface* browser);
+
+// Option-Shift-Cmd-Right / Left: the active tab moves one Space over and the
+// window follows it (B22). Essentials tabs are in every Space and do not move.
+void MoveActiveTabToNeighbourSpace(BrowserWindowInterface* browser,
+                                   bool forward);
+
+// Keeps the enabled state of the Space commands current: Space N only while
+// N <= size() (B23), everything off where SupportsSpaceCommands is false
+// (B29). `setter` is the command updater's UpdateCommandEnabled; the class
+// takes a callback rather than the updater so it stays out of
+// //chrome/browser's dependency tangle.
+class SpaceCommandState : public SpaceModel::Observer {
+ public:
+  using Setter = base::RepeatingCallback<void(int command_id, bool enabled)>;
+
+  SpaceCommandState(BrowserWindowInterface* browser, Setter setter);
+  SpaceCommandState(const SpaceCommandState&) = delete;
+  SpaceCommandState& operator=(const SpaceCommandState&) = delete;
+  ~SpaceCommandState() override;
+
+  void Refresh();
+
+  // SpaceModel::Observer:
+  void OnSpaceAdded(const SpaceId& id) override;
+  void OnSpaceRemoved(const SpaceId& id) override;
+
+ private:
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const Setter setter_;
+  base::ScopedObservation<SpaceModel, SpaceModel::Observer> observation_{this};
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_COMMANDS_H_
