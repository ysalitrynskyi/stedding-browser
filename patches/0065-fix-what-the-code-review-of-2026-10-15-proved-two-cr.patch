+void SpaceModel::WipeIsolatedJarOnceLeft(std::string jar,
+                                         base::OnceClosure done) {
+  if (jar.empty()) {
+    std::move(done).Run();
+    return;
+  }
+  waiting_wipes_.push_back(
+      {std::move(jar), std::move(done), BrowserContextForWipe()});
+  RetryWaitingWipes();
+}
+
+void SpaceModel::RetryWaitingWipes() {
+  if (waiting_wipes_.empty()) {
+    return;
+  }
+  std::vector<WaitingWipe> waiting;
+  std::vector<WaitingWipe> ready;
+  for (WaitingWipe& wipe : waiting_wipes_) {
+    if (!wipe.context) {
+      wipe.context = BrowserContextForWipe();
+    }
+    (wipe.context && IsJarInUse(wipe.context, wipe.jar) ? waiting : ready)
+        .push_back(std::move(wipe));
+  }
+  waiting_wipes_ = std::move(waiting);
+  // A window without Spaces -- a popup -- tells no model when its page goes,
+  // so a wait also asks again every few seconds.
+  if (waiting_wipes_.empty()) {
+    wipe_retry_timer_.Stop();
+  } else if (!wipe_retry_timer_.IsRunning()) {
+    wipe_retry_timer_.Start(FROM_HERE, base::Seconds(3), this,
+                            &SpaceModel::RetryWaitingWipes);
+  }
+  for (WaitingWipe& wipe : ready) {
+    if (wipe.context) {
+      WipeIsolatedSpacePartition(wipe.context, wipe.jar, std::move(wipe.done));
+    } else {
+      std::move(wipe.done).Run();
+    }
+  }
+}
+
+void SpaceModel::PostRetryWaitingWipes() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<SpaceModel> model) {
+                       if (!model) {
+                         return;
+                       }
+                       model->RetryWaitingWipes();
+                       ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+                           [&](BrowserWindowInterface* window) {
+                             SpaceModel* const other = SpaceModel::From(window);
+                             if (other && other != model.get()) {
+                               other->RetryWaitingWipes();
+                             }
+                             return true;
+                           });
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
