+TEST_F(SharedSessionWindowTest, DeletingTheLastSpaceOfASessionWipesItAndItsName) {
+  const SpaceId home = model().active_id();
+  const SpaceId mail = model().AddSpace("Mail", kBlue)->id();
+  const SpaceId docs = model().AddSpace("Docs", kBlue)->id();
+  const std::string jar = ShareSession(mail, docs);
+  OpenTabIn(mail);
+  const GURL url("https://example.com/");
+  PutCookie(profile(), ConfigFor(jar), url);
+  model().SetActiveSpace(home);
+  {
+    base::RunLoop loop;
+    ASSERT_TRUE(model().RemoveSpace(mail, loop.QuitClosure()));
+    loop.Run();
+  }
+  ASSERT_FALSE(WasWiped(ConfigFor(jar), url));
+  {
+    base::RunLoop loop;
+    ASSERT_TRUE(model().RemoveSpace(docs, loop.QuitClosure()));
+    loop.Run();
+  }
+  EXPECT_TRUE(WasWiped(ConfigFor(jar), url));
+  EXPECT_FALSE(model().registry()->FindSession(jar));
+  EXPECT_TRUE(profile()
+                  ->GetPrefs()
+                  ->GetList(stedding::prefs::kPendingJarWipes)
+                  .empty());
+}
