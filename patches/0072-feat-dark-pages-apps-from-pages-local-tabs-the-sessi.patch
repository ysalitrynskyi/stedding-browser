+// The second of two launches at once, on a thread of its own: the move it
+// makes, and when it is done.
+class SecondLaunch : public base::DelegateSimpleThread::Delegate {
+ public:
+  explicit SecondLaunch(const LegacyProfileFixture& fixture)
+      : legacy_(fixture.legacy()), target_(fixture.target()) {}
+
+  // base::DelegateSimpleThread::Delegate:
+  void Run() override {
+    outcome_ = MigrateLegacyUserDataDirectory(legacy_, target_);
+    done_.Signal();
+  }
+
+  base::WaitableEvent& done() { return done_; }
+  LegacyProfileMigration outcome() const { return outcome_; }
+
+ private:
+  const base::FilePath legacy_;
+  const base::FilePath target_;
+  base::WaitableEvent done_;
+  LegacyProfileMigration outcome_ = LegacyProfileMigration::kNoLegacyFolder;
+};
+
+SecondLaunch* g_second_launch = nullptr;
+std::optional<base::DelegateSimpleThread>* g_second_launch_thread = nullptr;
+int g_copies = 0;
+
+// The first launch has made its copy and not yet replaced the target: the
+// second launch starts now, and has to wait for the first one's move.
+void StartTheSecondLaunch() {
+  if (++g_copies > 1) {
+    return;  // The second launch's own copy.
+  }
+  g_second_launch_thread->emplace(g_second_launch, "SecondLaunch");
+  (*g_second_launch_thread)->Start();
+  EXPECT_FALSE(
+      g_second_launch->done().TimedWait(TestTimeouts::tiny_timeout()))
+      << "the second launch did not wait for the first one's move";
+}
+
+const base::FilePath* g_new_profile_target = nullptr;
+
+// Another launch, which went on with a new profile, starts it in Stedding's
+// folder while this one copies.
+void StartANewProfileMeanwhile() {
+  LegacyProfileFixture::WriteProfile(*g_new_profile_target, "Default", "{}");
+}
+
+}  // namespace
+
+// BACKLOG S-341: of two launches at once, the second waits while the first
+// moves the profile, then finds it in Stedding's folder and leaves it be,
+// with what the first launch has written in it since. Both had found the
+// folder empty before the process singleton existed, and the second deleted
+// the profile the first had just moved in and started on.
+TEST(ChromePaths, ASecondLaunchWaitsForTheMoveAndKeepsTheMovedProfile) {
+  LegacyProfileFixture fixture;
+  LegacyProfileFixture::WriteProfile(fixture.legacy(), "Default",
+                                     LegacyProfileFixture::kSteddingPrefs);
+  SecondLaunch second(fixture);
+  std::optional<base::DelegateSimpleThread> thread;
+  g_second_launch = &second;
+  g_second_launch_thread = &thread;
+  g_copies = 0;
+  SetLegacyProfileCopiedHookForTesting(&StartTheSecondLaunch);
+
+  EXPECT_EQ(LegacyProfileMigration::kMigrated,
+            MigrateLegacyUserDataDirectory(fixture.legacy(), fixture.target()));
+  // What the first launch writes in the profile it moved, once it runs on it.
+  const base::FilePath written =
+      fixture.target().Append("Default").Append("Bookmarks");
+  EXPECT_TRUE(base::WriteFile(written, "{}"));
+  if (thread) {
+    thread->Join();
+  }
+  SetLegacyProfileCopiedHookForTesting(nullptr);
+  g_second_launch_thread = nullptr;
+  g_second_launch = nullptr;
+
+  ASSERT_TRUE(thread) << "the first launch made no copy";
+  EXPECT_EQ(1, g_copies) << "the second launch copied the old folder too";
+  EXPECT_EQ(LegacyProfileMigration::kTargetHasUserData, second.outcome());
+  EXPECT_TRUE(base::PathExists(written))
+      << "the second launch replaced the profile the first had moved";
+  EXPECT_TRUE(base::PathExists(
+      fixture.target().Append("Default").Append("Preferences")));
+}
+
+// BACKLOG S-341: a profile started in Stedding's folder while the old one is
