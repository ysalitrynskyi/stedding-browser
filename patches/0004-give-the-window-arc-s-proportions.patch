--- /dev/null
+++ b/chrome/browser/ui/views/frame/layout/stedding_browser_view_layout.h
@@ -0,0 +1,43 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_LAYOUT_STEDDING_BROWSER_VIEW_LAYOUT_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_LAYOUT_STEDDING_BROWSER_VIEW_LAYOUT_H_
+
+#include <memory>
+
+#include "base/feature_list.h"
+#include "chrome/browser/ui/views/frame/layout/browser_view_tabbed_layout_impl.h"
+
+namespace stedding {
+
+// Stedding's window chrome: the web contents are rounded away from the corner
+// where the toolbar meets the tab strip, so the window background reads as a
+// mat around the page. See docs/UI-SPEC.md.
+BASE_DECLARE_FEATURE(kArcStyleWindow);
+
+// The radius of the contents corner nearest the tab strip, in DIPs.
+inline constexpr float kContentsCornerRadius = 12.f;
+
+}  // namespace stedding
+
+// Layout for normal tabbed browsers in Stedding. Everything about where views
+// go is inherited; this class only adjusts visuals after layout has run, which
+// keeps it clear of `BrowserViewTabbedLayoutImpl`'s hot layout code.
+class SteddingBrowserViewLayout : public BrowserViewTabbedLayoutImpl {
+ public:
+  SteddingBrowserViewLayout(std::unique_ptr<BrowserViewLayoutDelegate> delegate,
+                            BrowserViewLayoutViews views);
+  SteddingBrowserViewLayout(const SteddingBrowserViewLayout&) = delete;
+  SteddingBrowserViewLayout& operator=(const SteddingBrowserViewLayout&) =
+      delete;
+  ~SteddingBrowserViewLayout() override;
+
+ protected:
+  // BrowserViewTabbedLayoutImpl:
+  void DoPostLayoutVisualAdjustments(
+      const BrowserLayoutParams& params) override;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_LAYOUT_STEDDING_BROWSER_VIEW_LAYOUT_H_
