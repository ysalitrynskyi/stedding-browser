+// PLAN.md SPC-8: contents replaced under a tab -- a sleep through Chromium's
+// own lifecycle unit, a jar rebind -- get the tab's Space, pin, home and name
+// written again, so what the session file holds, once saved, brings both
+// tabs back as they were, whatever ends the run.
+IN_PROC_BROWSER_TEST_F(RestoreTest, ReplacedContentsAreWrittenAgain) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  m->AddSpace("Two", SK_ColorGREEN);
+  const SpaceId three = m->AddSpace("Three", SK_ColorBLUE)->id();
+  ASSERT_TRUE(m->SetActiveSpace(three));
+  tabs::TabInterface* const pinned = Open("pinned.test");
+  m->SetSpacePinned(pinned, true);
+  stedding::SetTabName(browser(), pinned, u"Mail");
+  tabs::TabInterface* const other = Open("other.test");
+
+  // The pin asleep through Chromium's lifecycle unit, not Stedding's verb.
+  resource_coordinator::TabLifecycleUnitExternal* const unit =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+          pinned->GetContents());
+  ASSERT_TRUE(unit);
+  ASSERT_TRUE(unit->DiscardTab(::mojom::LifecycleUnitDiscardReason::EXTERNAL));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return pinned->GetContents()->WasDiscarded(); }));
+  // The other tab rebinds when Three gets a session of its own.
+  m->SetSpaceIsolated(three, true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return spaces::IsSpaceStoragePartition(
+        spaces::StoragePartitionConfigForWebContents(other->GetContents()));
+  }));
+  base::RunLoop().RunUntilIdle();
+
+  // What a restart would read: the pending commands written, the file moved
+  // aside as the last session, and read back the way session restore reads
+  // it.
+  SessionService* const service =
+      SessionServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  SessionServiceTestHelper helper(service);
+  sessions::CommandStorageManager* const storage =
+      helper.command_storage_manager();
+  service->MoveCurrentSessionToLastSession();
+  base::test::TestFuture<std::vector<std::unique_ptr<sessions::SessionCommand>>,
+                         bool>
+      read;
+  storage->GetLastSessionCommands(read.GetCallback());
+  auto [commands, read_error] = read.Take();
+  ASSERT_FALSE(read_error);
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active = SessionID::InvalidValue();
+  std::string platform;
+  std::set<SessionID> discarded;
+  sessions::RestoreSessionFromCommands(commands, &windows, &active, &platform,
+                                       &discarded);
+
+  const sessions::SessionTab* saved_pin = nullptr;
+  const sessions::SessionTab* saved_other = nullptr;
+  for (const auto& window : windows) {
+    for (const auto& tab : window->tabs) {
+      if (tab->navigations.empty()) {
+        continue;
+      }
+      const std::string host(
+          tab->navigations[tab->normalized_navigation_index()]
+              .virtual_url()
+              .host());
+      if (host == "pinned.test") {
+        saved_pin = tab.get();
+      } else if (host == "other.test") {
+        saved_other = tab.get();
+      }
+    }
+  }
+  ASSERT_TRUE(saved_pin);
+  ASSERT_TRUE(saved_other);
+  const auto value = [](const sessions::SessionTab* tab, const char* key) {
+    const auto it = tab->extra_data.find(key);
+    return it == tab->extra_data.end() ? std::string() : it->second;
+  };
+  EXPECT_EQ(three.ToString(), value(saved_pin, spaces::kSessionTabSpaceKey));
+  EXPECT_EQ("1", value(saved_pin, spaces::kSessionTabSpacePinKey));
+  EXPECT_EQ("pinned.test",
+            GURL(value(saved_pin, spaces::kSessionTabHomeKey)).host());
+  EXPECT_EQ("Mail", value(saved_pin, stedding::kSessionTabNameKey));
+  EXPECT_EQ(three.ToString(), value(saved_other, spaces::kSessionTabSpaceKey));
+}
