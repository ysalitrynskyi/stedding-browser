+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_THEME_PAGE_BAR_COLOR_SUPPLIER_H_
+#define CHROME_BROWSER_UI_STEDDING_THEME_PAGE_BAR_COLOR_SUPPLIER_H_
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_provider_key.h"
+
+namespace stedding {
+
+// The toolbar's foreground colours for a page-coloured address row
+// (docs/features/toolbar.md T7). The window's ColorProviderKey carries one of
+// these as its app controller while the active page has a colour; the mixer
+// it adds recolours the toolbar's icons and text for contrast with the bar,
+// the way Safari flips its icons on a dark page. Toolbar ids only: the
+// sidebar's buttons use the tab-strip control ids and keep their colours.
+//
+// One supplier per colour, never freed: the ColorProviderManager caches
+// providers by the supplier's address, so an address must not be reused for
+// a different colour.
+class PageBarColorSupplier : public ui::ColorProviderKey::InitializerSupplier {
+ public:
+  explicit PageBarColorSupplier(SkColor page);
+  PageBarColorSupplier(const PageBarColorSupplier&) = delete;
+  PageBarColorSupplier& operator=(const PageBarColorSupplier&) = delete;
+  ~PageBarColorSupplier() override;
+
+  SkColor page() const { return page_; }
+
+  // ui::ColorProviderKey::InitializerSupplier:
+  void AddColorMixers(ui::ColorProvider* provider,
+                      const ui::ColorProviderKey& key) const override;
+
+ private:
+  const SkColor page_;
+};
+
+// The bar's alpha over the window ground: the same blend
+// SteddingWindowBackground paints, so the icons are computed against the
+// colour that is actually on screen.
+inline constexpr SkAlpha kPageBarAlpha = 0xD9;  // 0.85
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_THEME_PAGE_BAR_COLOR_SUPPLIER_H_
