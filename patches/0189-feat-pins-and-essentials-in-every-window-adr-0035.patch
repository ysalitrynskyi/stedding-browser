+void OnHistoryIcon(tabs::TabHandle handle,
+                   const GURL& page,
+                   const favicon_base::FaviconRawBitmapResult& result) {
+  tabs::TabInterface* const tab = handle.Get();
+  if (!tab || !result.is_valid()) {
+    return;
+  }
+  content::WebContents* const contents = tab->GetContents();
+  content::NavigationController& controller = contents->GetController();
+  content::NavigationEntry* const entry = controller.GetLastCommittedEntry();
+  if (!entry || !controller.NeedsReload() || entry->GetURL() != page ||
+      entry->GetFavicon().valid) {
+    return;
+  }
+  const gfx::Image image = favicon_base::SelectFaviconFramesFromPNGs(
+      {result}, favicon_base::GetFaviconScales(), gfx::kFaviconSize);
+  if (image.IsEmpty()) {
+    return;
+  }
+  content::FaviconStatus& favicon = entry->GetFavicon();
+  favicon.image = image;
+  favicon.url = result.icon_url;
+  favicon.valid = true;
+  contents->NotifyNavigationStateChanged(content::INVALIDATE_TYPE_TAB);
+}
