+std::optional<FolderView::TabDropPlace> FolderView::TabDropPlaceAt(
+    const gfx::Point& screen_point,
+    const std::set<const tabs::TabInterface*>& dragged) const {
+  const tabs::FolderTabCollection* const into = folder();
+  const UnpinnedTabContainerView* const container =
+      NearestOfClass<UnpinnedTabContainerView>(this);
+  if (!into || !container || !HasDrawnRows()) {
+    return std::nullopt;
+  }
+  // As a folder's header dragged among the rows takes its place (F39), the
+  // place counted in tabs as the folder reads without the dragged ones.
+  const std::map<const tabs::TabInterface*, const views::View*> row_of_tab =
+      RowsByTab(*this);
+  TabDropPlace place;
+  const views::View* previous = nullptr;
+  const views::View* next = nullptr;
+  int tabs_before = 0;
+  for (const tabs::Child& child : into->GetChildren()) {
+    int count = 0;
+    bool all_dragged = false;
+    if (const auto* const tab = std::get_if<tabs::ScopedTab>(&child)) {
+      count = 1;
+      all_dragged = dragged.contains(tab->get());
+    } else {
+      const tabs::TabCollection* const collection =
+          std::get<std::unique_ptr<tabs::TabCollection>>(child).get();
+      count = collection->TabCountRecursive();
+      all_dragged = count > 0;
+      for (const tabs::TabInterface* const each :
+           collection->GetTabsRecursive()) {
+        all_dragged &= dragged.contains(each);
+      }
+    }
+    // A dragged row is no place: a tab, or a folder or split every tab of
+    // which is dragged. One that keeps a tab is a place and counts whole,
+    // its dragged tabs too, as the strip counts the slot it is handed
+    // (TabStripModel::MoveTabsToFolderAt). Left out, a nested folder one of
+    // whose tabs was dragged put the drop a folder short of the bar (folders
+    // F40, BACKLOG S-350).
+    if (all_dragged) {
+      continue;
+    }
+    if (const views::View* const row = DrawnRowOf(row_of_tab, child);
+        row && !next) {
+      if (screen_point.y() < row->GetBoundsInScreen().CenterPoint().y()) {
+        place.slot = tabs_before;
+        next = row;
+      } else {
+        previous = row;
+        place.slot = tabs_before + count;
+      }
+    }
+    tabs_before += count;
+  }
+  constexpr int kHalfGap = 1;
+  gfx::Point bar(0, next       ? next->bounds().y() - kHalfGap
+                    : previous ? previous->bounds().bottom() + kHalfGap
+                               : header_->bounds().bottom() + kHalfGap);
