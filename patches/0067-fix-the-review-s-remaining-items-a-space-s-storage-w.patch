+// import I23 (BACKLOG S-346): with more logins than the cap, the most
+// recently used are read, a row left out takes no place, and the rows past
+// the cap are counted. The query had no order and its LIMIT counted every
+// row: the first rows SQLite gave were read, an unreadable one among them
+// cost a valid one, and nothing said what was left.
+TEST(ArcDataImporterTest, ACapKeepsTheLoginsInUseAndCountsTheRest) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().AppendASCII("Login Data");
+  const std::vector<uint8_t> key = DeriveArcKey("peanuts");
+  {
+    sql::Database db(sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(path));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE logins(origin_url VARCHAR NOT NULL, action_url VARCHAR, "
+        "username_element VARCHAR, username_value VARCHAR, password_element "
+        "VARCHAR, password_value BLOB, signon_realm VARCHAR NOT NULL, "
+        "date_created INTEGER NOT NULL, blacklisted_by_user INTEGER NOT NULL, "
+        "scheme INTEGER NOT NULL, date_last_used INTEGER NOT NULL DEFAULT 0, "
+        "date_password_modified INTEGER NOT NULL DEFAULT 0)"));
+    const auto insert = [&db](const char* origin, std::string sealed,
+                              int64_t last_used) {
+      sql::Statement s(db.GetUniqueStatement(
+          "INSERT INTO logins VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"));
+      s.BindString(0, origin);
+      s.BindString(1, origin);
+      s.BindString(2, "user");
+      s.BindString(3, "ann");
+      s.BindString(4, "pass");
+      s.BindBlob(5, std::move(sealed));
+      s.BindString(6, std::string(origin));
+      s.BindInt64(7, 13300000000000000);
+      s.BindInt(8, 0);
+      s.BindInt(9, 0);
+      s.BindInt64(10, last_used);
+      s.BindInt64(11, 13300000000000000);
+      ASSERT_TRUE(s.Run());
+    };
+    // In the order of the table: an unreadable row first, then a login last
+    // used long ago, then the one in use.
+    insert("https://broken.example/", "v10junk", 13300000000000003);
+    insert("https://old.example/", Seal("old", key), 13300000000000001);
