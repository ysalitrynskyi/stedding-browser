+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+// The project's page on GitHub Sponsors (.github/FUNDING.yml).
+constexpr char kSupportURL[] = "https://github.com/sponsors/ysalitrynskyi";
+
+BrowserWindowInterface* WindowOf(content::WebUI* web_ui) {
+  content::WebContents* const contents =
+      web_ui ? web_ui->GetWebContents() : nullptr;
+  tabs::TabInterface* const tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  return tab ? tab->GetBrowserWindowInterface() : nullptr;
+}
+
+}  // namespace
+
+SpacePageHandler::SpacePageHandler() = default;
+
+SpacePageHandler::~SpacePageHandler() = default;
+
+void SpacePageHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getSpace", base::BindRepeating(&SpacePageHandler::HandleGetSpace,
+                                      base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "openSupport", base::BindRepeating(&SpacePageHandler::HandleOpenSupport,
+                                         base::Unretained(this)));
+}
+
+void SpacePageHandler::OnJavascriptAllowed() {
+  if (spaces::SpaceModel* const model = Model();
+      model && !observation_.IsObserving()) {
+    observation_.Observe(model);
+  }
+}
+
+void SpacePageHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+}
+
+void SpacePageHandler::OnActiveSpaceChanged(const spaces::SpaceId& from,
+                                            const spaces::SpaceId& to) {
+  // The stand-in closes as the window leaves its Space; until it has, the
+  // page keeps naming the Space it was opened for.
+}
+
+void SpacePageHandler::OnSpaceMetadataChanged(const spaces::SpaceId& id) {
+  spaces::SpaceModel* const model = Model();
+  if (model && IsJavascriptAllowed() && id == model->active_id()) {
+    FireWebUIListener("space-changed", Describe());
+  }
+}
+
+void SpacePageHandler::OnSpaceModelDestroying() {
+  observation_.Reset();
+}
+
+spaces::SpaceModel* SpacePageHandler::Model() {
+  BrowserWindowInterface* const window = WindowOf(web_ui());
+  return window ? spaces::SpaceModel::From(window) : nullptr;
+}
+
+base::DictValue SpacePageHandler::Describe() {
+  base::DictValue space;
+  std::string name = "this Space";
+  SkColor color = SkColorSetRGB(0x5B, 0x6B, 0x8C);
+  if (spaces::SpaceModel* const model = Model()) {
+    if (const spaces::Space* const active = model->active_space()) {
+      const std::u16string shown = model->DisplayName(active->id());
+      if (!shown.empty()) {
+        name = base::UTF16ToUTF8(shown);
+      }
+      color = active->color();
+    }
+  }
+  space.Set("name", name);
+  space.Set("color", base::StringPrintf("#%02X%02X%02X", SkColorGetR(color),
+                                        SkColorGetG(color),
+                                        SkColorGetB(color)));
+  space.Set("mac", BUILDFLAG(IS_MAC));
+  return space;
+}
+
+void SpacePageHandler::HandleGetSpace(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], Describe());
+}
+
+void SpacePageHandler::HandleOpenSupport(const base::ListValue& args) {
+  // Only on the user's click; the page fetches nothing before it.
+  BrowserWindowInterface* const window = WindowOf(web_ui());
+  if (!window) {
+    return;
+  }
+  NavigateParams params(window, GURL(kSupportURL), ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+}
+
+}  // namespace stedding
