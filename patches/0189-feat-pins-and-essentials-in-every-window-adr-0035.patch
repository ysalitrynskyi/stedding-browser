+  // As the sidebar's lists do: a row added fades in.
+  ON_CALL(*layout_manager_delegate(), ShouldAnimateOpacityForAddAndRemove)
+      .WillByDefault(testing::Return(true));
+  widget()->SetBounds(gfx::Rect(0, 0, 100, 100));
+  widget()->LayoutRootViewIfNecessary();
+  task_environment()->FastForwardBy(base::Seconds(1));
+  std::vector<views::View*> rows;
+  {
+    TabCollectionAnimatingLayoutManager::ScopedDeferTargets defer;
+    for (int i = 0; i < 3; ++i) {
+      rows.push_back(
+          host_view()->AddChildView(std::make_unique<views::View>()));
+      EXPECT_FALSE(rows.back()->layer())
+          << "a row added while deferred fades in";
+    }
+    EXPECT_FALSE(layout_manager()->is_animating());
+  }
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_FALSE(layout_manager()->is_animating()) << "the rows animate in";
+  for (const views::View* const row : rows) {
+    const views::ChildLayout* const target =
+        layout_manager()->target_layout().GetLayoutFor(row);
+    ASSERT_TRUE(target);
+    EXPECT_EQ(target->bounds, row->bounds());
+  }
+  // Outside a deferral a row still fades in.
+  views::View* const later =
+      host_view()->AddChildView(std::make_unique<views::View>());
+  EXPECT_TRUE(later->layer());
+}
