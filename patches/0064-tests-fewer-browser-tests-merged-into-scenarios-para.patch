+  EXPECT_EQ(1u, folder->GetIndexOfTabRecursive(b).value());
+  EXPECT_LT(tabstrip()->GetIndexOfTab(k1), tabstrip()->GetIndexOfTab(b));
+  EXPECT_LT(tabstrip()->GetIndexOfTab(b), tabstrip()->GetIndexOfTab(k2));
+  EXPECT_LT(tabstrip()->GetIndexOfTab(k2), tabstrip()->GetIndexOfTab(k3));
