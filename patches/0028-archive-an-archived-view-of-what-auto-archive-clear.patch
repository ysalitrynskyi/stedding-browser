+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_ARCHIVE_ARCHIVED_TABS_H_
+#define CHROME_BROWSER_UI_ARCHIVE_ARCHIVED_TABS_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "components/sessions/core/session_id.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class PrefService;
+
+namespace sessions {
+class LiveTabContext;
+}
+
+namespace spaces {
+class SpaceModel;
+}
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace stedding {
+
+// docs/features/archive.md A8: the Space's name, written beside its id so
+// the archive can name it and bring it back when it is gone (A9).
+inline constexpr char kArchiveSpaceNameKey[] = "stedding.spacename";
+
+// What Chromium's recently-closed list carries for `tab`, in Stedding's
+// terms: the archive reason when the tab was marked, and its Space's name.
+void PopulateArchiveExtraData(tabs::TabInterface* tab,
+                              std::map<std::string, std::string>* extra_data);
+
+// One row of the archive (A9).
+struct ArchivedTab {
+  ArchivedTab();
+  ArchivedTab(const ArchivedTab& other);
+  ArchivedTab& operator=(const ArchivedTab& other);
+  ~ArchivedTab();
+
+  SessionID id = SessionID::InvalidValue();
+  std::u16string title;
+  GURL url;
+  base::Time time;
+  std::string space_id;
+  std::string space_name;
+  std::string folder_path;
+  // "auto", "clear", or empty for a plain close.
+  std::string reason;
+};
+
+// The closed tabs of `entries` no older than `keep`, newest first (A11).
+std::vector<ArchivedTab> ListArchivedTabs(
+    const sessions::TabRestoreService::Entries& entries,
+    base::Time now,
+    base::TimeDelta keep);
+
+base::DictValue ArchivedTabToValue(const ArchivedTab& tab);
+
+// stedding.archive.keep_days as a duration.
+base::TimeDelta ArchiveRetention(const PrefService* prefs);
+
+// A9: where a restored tab goes -- the Space it was in, else one with its
+// old name, else a new Space of that name; the active Space when nothing is
+// known.
+spaces::SpaceId SpaceForRestore(spaces::SpaceModel* model,
+                                const std::string& space_id,
+                                const std::string& space_name);
+
+// Restores entry `id` into `browser`'s window and its Space, then shows
+// that Space. False when the entry is gone.
+bool RestoreArchivedTab(BrowserWindowInterface* browser,
+                        sessions::LiveTabContext* context,
+                        sessions::TabRestoreService* service,
+                        SessionID id);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_ARCHIVE_ARCHIVED_TABS_H_
