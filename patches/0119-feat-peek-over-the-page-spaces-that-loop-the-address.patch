+// P20: the peek code's way to the peeks over the page.
+class PeekOverPage : public PeekOverPageHost {
+ public:
+  bool Show(tabs::TabInterface* source,
+            std::unique_ptr<content::WebContents> page) override {
+    if (!source || !page) {
+      return false;
+    }
+    PeekOverlay* const overlay = Overlays()
+                                     .emplace_back(base::WrapUnique(
+                                         new PeekOverlay(source, std::move(page))))
+                                     .get();
+    if (!overlay->Show()) {
+      overlay->Destroy();
+      Erase(overlay);
+      return false;
+    }
+    return true;
+  }
+
+  content::WebContents* PageOver(const tabs::TabInterface* source) override {
+    PeekOverlay* const overlay = PeekOverlay::ForSource(source);
+    return overlay ? overlay->page() : nullptr;
+  }
+
+  void Close(tabs::TabInterface* source) override {
+    if (PeekOverlay* const overlay = PeekOverlay::ForSource(source)) {
+      overlay->Close();
+    }
+  }
+
+  bool Promote(tabs::TabInterface* source, bool split) override {
+    PeekOverlay* const overlay = PeekOverlay::ForSource(source);
+    return overlay && overlay->Promote(split);
+  }
+};
+
+void RegisterPeekOverPage() {
+  static base::NoDestructor<PeekOverPage> host;
+  SetPeekOverPageHost(host.get());
+}
