+class HiddenRowControlsTest : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    // The media controls follow a page that plays without a gesture.
+    command_line->AppendSwitchASCII(
+        switches::kAutoplayPolicy,
+        switches::autoplay::kNoUserGestureRequiredPolicy);
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    stedding::test::KeepAboveOtherWindows(widget());
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+  content::WebContents* page() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  // An extension with an action: a popup when `popup`, else a click handler
+  // that opens a tab at `about:blank#clicked`.
+  scoped_refptr<const extensions::Extension> LoadAction(const std::string& name,
+                                                        bool popup) {
+    extensions::TestExtensionDir& dir = dirs_.emplace_back();
+    if (popup) {
+      dir.WriteManifest(R"({"manifest_version": 3, "name": ")" + name +
+                        R"(", "version": "1", "action": {"default_title": ")" +
+                        name + R"(", "default_popup": "popup.html"}})");
+      dir.WriteFile(FILE_PATH_LITERAL("popup.html"),
+                    "<!doctype html><body style='margin:0;width:240px;"
+                    "height:160px'>Popup");
+    } else {
+      dir.WriteManifest(R"({"manifest_version": 3, "name": ")" + name +
+                        R"(", "version": "1", "action": {"default_title": ")" +
+                        name +
+                        R"("}, "background": {"service_worker": "bg.js"}})");
+      dir.WriteFile(FILE_PATH_LITERAL("bg.js"),
+                    "chrome.action.onClicked.addListener(() => "
+                    "chrome.tabs.create({url: 'about:blank#clicked'}));");
+    }
+    extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+    return loader.LoadExtension(dir.UnpackedPath());
+  }
+
+  ToolbarActionViewModel* ActionOf(const extensions::Extension& extension) {
+    ExtensionsContainer* const container =
+        ExtensionsContainer::From(*browser());
+    return container ? container->GetActionForId(extension.id()) : nullptr;
+  }
+
+  // The widget of `action`'s popup, or null. The popup's native view is its
+  // page's, inside the popup's widget: on the Mac any view of a window finds
+  // the window's widget, but on Aura only the widget's own window does, and
+  // the page's is a child of it, so the lookup walks up to the popup, a
+  // window of its own and never the browser's.
+  views::Widget* PopupWidget(ToolbarActionViewModel* action) {
+    views::Widget* const popup =
+        action->IsShowingPopup()
+            ? views::Widget::GetTopLevelWidgetForNativeView(
+                  action->GetPopupNativeView())
+            : nullptr;
+    return popup != widget() ? popup : nullptr;
+  }
+
+  void HideTheRow() {
+    ASSERT_TRUE(
+        chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+    views::test::RunScheduledLayout(widget());
+    ASSERT_FALSE(browser_view()->IsToolbarVisible());
+    ASSERT_FALSE(browser_view()->toolbar()->IsDrawn());
+  }
+
+  void ExpectTheRowHidden() {
+    views::test::RunScheduledLayout(widget());
+    EXPECT_FALSE(browser_view()->toolbar()->IsDrawn())
+        << "running a row showed the address row";
+  }
+
+  stedding::CommandBarView* OpenActions() {
+    stedding::CommandBarView::Show(browser(),
+                                   stedding::CommandBarView::Mode::kActions);
+    return stedding::CommandBarView::GetOpenBar(browser_view());
+  }
+
+  static std::vector<std::u16string> Titles(stedding::CommandBarView* bar) {
+    std::vector<std::u16string> titles;
+    for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+      titles.push_back(bar->row_title_for_testing(i));
+    }
+    return titles;
+  }
+
+  // Opens actions mode, types `title` and presses Enter on its row, which
+  // must be the only one.
+  void RunRow(const std::u16string& title) {
+    stedding::CommandBarView* const bar = OpenActions();
+    ASSERT_TRUE(bar);
+    views::Textfield* const field = bar->field_for_testing();
+    field->SetText(title);
+    bar->ContentsChanged(field, title);
+    ASSERT_EQ(std::vector<std::u16string>{title}, Titles(bar));
+    bar->HandleKeyEvent(field, ui::KeyEvent(ui::EventType::kKeyPressed,
+                                            ui::VKEY_RETURN, ui::EF_NONE));
+  }
+
+  // Whether `bounds` lie inside the window, below the top of the page card
+  // and in its top half.
+  void ExpectInTheCardsTopHalf(const gfx::Rect& bounds,
+                               const std::string& what) {
+    SCOPED_TRACE(what);
+    const gfx::Rect window = widget()->GetWindowBoundsInScreen();
+    const gfx::Rect card =
+        browser_view()->contents_container()->GetBoundsInScreen();
+    EXPECT_TRUE(window.Contains(bounds))
+        << bounds.ToString() << " outside the window " << window.ToString();
+    // A bubble's shadow reaches a few DIP past its content.
+    EXPECT_GE(bounds.y(), card.y() - 16)
+        << bounds.ToString() << " above the card " << card.ToString();
+    EXPECT_LT(bounds.y(), card.CenterPoint().y())
+        << bounds.ToString() << " not in the card's top half "
+        << card.ToString();
+    EXPECT_GE(bounds.x(), card.x() - 16)
+        << bounds.ToString() << " over the sidebar, left of the card "
+        << card.ToString();
+  }
+
+  // Whether the page's view has the window's focus, or will have it when
+  // the window is next active: a test window is not always the active one
+  // (docs/HANDOFF.md, trap 88).
+  bool PageHasFocus() {
+    views::FocusManager* const focus = widget()->GetFocusManager();
+    views::View* const focused = focus->GetFocusedView()
+                                     ? focus->GetFocusedView()
+                                     : focus->GetStoredFocusView();
+    return focused && focused == browser_view()->GetActiveContentsWebView();
+  }
+
+  std::vector<extensions::TestExtensionDir> dirs_;
+};
+
+// toolbar T13, T39; commandbar K31-K33: with the row hidden by Shift-Cmd-D's
+// command, the extension actions, the media controls and the site
+// information are rows of actions mode, and each runs: the popup shows, the
+// click handler runs, the media dialog and page info open. The chord opens
+// the bar on the extensions alone and its release runs the chosen one. The
+// row stays hidden after each.
+IN_PROC_BROWSER_TEST_F(HiddenRowControlsTest, TheBarReachesWhatTheRowHeld) {
+  const scoped_refptr<const extensions::Extension> popup =
+      LoadAction("Stedding Popup Probe", /*popup=*/true);
+  const scoped_refptr<const extensions::Extension> click =
+      LoadAction("Stedding Click Probe", /*popup=*/false);
+  ASSERT_TRUE(popup && click);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("site.test", "/title1.html")));
+  ASSERT_NO_FATAL_FAILURE(HideTheRow());
+
+  {
+    SCOPED_TRACE("the extension rows, in the extensions menu's order");
+    stedding::CommandBarView* const bar = OpenActions();
+    ASSERT_TRUE(bar);
+    const std::vector<std::u16string> titles = Titles(bar);
+    const auto click_row = std::ranges::find(titles, u"Stedding Click Probe");
+    const auto popup_row = std::ranges::find(titles, u"Stedding Popup Probe");
+    ASSERT_NE(titles.end(), click_row);
+    ASSERT_NE(titles.end(), popup_row);
+    EXPECT_LT(click_row, popup_row) << "neither is pinned: by name";
+    EXPECT_TRUE(std::ranges::contains(titles, u"View Site Information"));
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+  }
+
+  {
+    SCOPED_TRACE("an extension's popup");
+    ASSERT_NO_FATAL_FAILURE(RunRow(u"Stedding Popup Probe"));
+    ToolbarActionViewModel* const action = ActionOf(*popup);
+    ASSERT_TRUE(action);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::Widget* const shown = PopupWidget(action);
+      return shown && shown->IsVisible();
+    })) << "no popup";
+    ExpectTheRowHidden();
+    action->HidePopup();
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return !action->IsShowingPopup(); }));
+  }
+
+  {
+    SCOPED_TRACE("an extension's click");
+    const int tabs_before = browser()->GetTabStripModel()->count();
+    ASSERT_NO_FATAL_FAILURE(RunRow(u"Stedding Click Probe"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return browser()->GetTabStripModel()->count() == tabs_before + 1;
+    })) << "the click handler did not run";
+    EXPECT_EQ("clicked", page()->GetVisibleURL().ref())
+        << page()->GetVisibleURL().spec();
+    ExpectTheRowHidden();
+    browser()->GetTabStripModel()->CloseWebContentsAt(
+        browser()->GetTabStripModel()->active_index(),
+        TabCloseTypes::CLOSE_NONE);
+  }
+
+  {
+    SCOPED_TRACE("the chord: the extensions alone, the release runs one");
+    ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_STEDDING_RUN_EXTENSION));
+    stedding::CommandBarView* const bar =
+        stedding::CommandBarView::GetOpenBar(browser_view());
+    ASSERT_TRUE(bar);
+    EXPECT_EQ((std::vector<std::u16string>{u"Stedding Click Probe",
+                                           u"Stedding Popup Probe"}),
+              Titles(bar));
+    EXPECT_TRUE(bar->holding_chord_for_testing());
+    // A second press of the chord chooses the popup's row.
+    ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_STEDDING_RUN_EXTENSION));
+    EXPECT_EQ(1u, bar->selected_row_for_testing());
+    bar->OnHeldChordEvent(
+        ui::KeyEvent(ui::EventType::kKeyReleased, kChordKey, ui::EF_NONE));
+    ToolbarActionViewModel* const action = ActionOf(*popup);
+    ASSERT_TRUE(action);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return action->IsShowingPopup();
+    })) << "letting go ran no popup";
+    ExpectTheRowHidden();
+    action->HidePopup();
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return !action->IsShowingPopup(); }));
+  }
+
+  {
+    SCOPED_TRACE("the page's site information");
+    ASSERT_NO_FATAL_FAILURE(RunRow(u"View Site Information"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return PageInfoBubbleViewBase::GetShownBubbleType() ==
+             PageInfoBubbleViewBase::BUBBLE_PAGE_INFO;
+    })) << "no page info";
+    ExpectTheRowHidden();
+    PageInfoBubbleViewBase::GetPageInfoBubbleForTesting()
+        ->GetWidget()
+        ->CloseNow();
+  }
+
+  {
+    SCOPED_TRACE("the media controls");
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(),
+        embedded_test_server()->GetURL(
+            "site.test", "/media/session/video-with-metadata.html")));
