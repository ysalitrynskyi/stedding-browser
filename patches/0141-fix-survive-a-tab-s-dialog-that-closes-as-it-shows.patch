+// P9 (bug hunt 2026-11-16): a peek whose pinned tab has gone -- an extension
+// closed it, which no click on the window does, so the peek stayed -- offers
+// no split, and Open in Split View gives the page a tab of its own. It had
+// paired the page with whatever tab was active in the window.
+IN_PROC_BROWSER_TEST_F(PeekTest, OpenInSplitViewWithItsPinGoneOpensATab) {
+  // A tab a split could take: a page of its own, not pinned, in the Space on
+  // screen.
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Url("c.test", "/title2.html")));
+  tabs::TabInterface* const other = tab();
+  ASSERT_NO_FATAL_FAILURE(
+      OpenPin(Url("b.test", "/title3.html"), "", /*in_space=*/true));
+  tabs::TabInterface* const pin = tab();
+  ASSERT_NE(other, pin);
+  ClickLink();
+  BrowserWindowInterface* const peek = WaitForPeek();
+  ASSERT_TRUE(peek);
+  ASSERT_TRUE(stedding::LittleWindowOffersSplit(peek));
+  content::WebContents* const page =
+      peek->GetTabStripModel()->GetActiveWebContents();
+
+  const tabs::TabHandle gone = pin->GetHandle();
+  tabs().CloseWebContentsAt(tabs().GetIndexOfTab(pin),
+                            TabCloseTypes::CLOSE_NONE);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !gone.Get(); }))
+      << "the pinned tab did not close";
+  ASSERT_EQ(1, PeekCount()) << "the peek went with its pin";
+  EXPECT_EQ(nullptr, stedding::PeekSourceOf(peek));
+  EXPECT_FALSE(stedding::LittleWindowOffersSplit(peek));
+  tabs().ActivateTab(other);
+  ASSERT_EQ(other, tab());
+
+  chrome::ExecuteCommand(peek, IDC_STEDDING_LITTLE_PROMOTE_SPLIT);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    tabs::TabInterface* const moved =
+        tabs::TabInterface::MaybeGetFromContents(page);
+    return moved && moved->GetBrowserWindowInterface() == browser();
+  })) << "the page did not move into the window";
+  EXPECT_FALSE(tabs::TabInterface::MaybeGetFromContents(page)->IsSplit());
+  EXPECT_FALSE(other->IsSplit()) << "the page paired with the active tab";
+  EXPECT_EQ(page, contents());
+}
