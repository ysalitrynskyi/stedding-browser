+// The auto-archive menu as the page draws it, through every shadow root:
+// "<selected value>|<the values it offers>", or "" until its preference has
+// arrived and the selection follows it. "Custom", the value-not-found
+// option, is disabled while the value is one the menu offers.
+constexpr char kArchiveMenu[] = R"(
+  (() => {
+    const find = root => {
+      for (const element of root.querySelectorAll('*')) {
+        if (element.localName === 'settings-dropdown-menu' &&
+            element.getAttribute('pref-key') ===
+                'stedding.archive.idle_hours') {
+          return element;
+        }
+        if (element.shadowRoot) {
+          const found = find(element.shadowRoot);
+          if (found) {
+            return found;
+          }
+        }
+      }
+      return null;
+    };
+    const menu = find(document);
+    const select = menu && menu.shadowRoot &&
+        menu.shadowRoot.querySelector('select');
+    if (!select || !menu.pref || select.value !== String(menu.pref.value)) {
+      return '';
+    }
+    const offered = [...select.options].filter(option => !option.disabled)
+                        .map(option => option.value);
+    return select.value + '|' + offered.join(',');
+  })()
+)";
