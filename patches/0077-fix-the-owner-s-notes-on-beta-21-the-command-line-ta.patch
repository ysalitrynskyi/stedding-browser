 class FolderTabsTest
@@ -871,6 +902,156 @@ IN_PROC_BROWSER_TEST_F(FolderTabsTest, ARowMovedFromUnderThePointerRests) {
       << "the slept row is drawn with a fill the resting row does not have";
 }
 
+// tabs R1, R14, folders F4 (the owner, 2026-10-21): a double click renames a
+// row, or a folder, only when both of its presses land on it. A folder
+// collapsed while one of its rows is active keeps that row under its header;
+// the first press of a double click on the row below selects it, the
+// folder's row hides, and the list moves up under the pointer, so the second
+// press lands on the next row. That press is a plain click there: it selects
+// that row and renames nothing. The row that moved away from under the
+// pointer is drawn at rest: no hover fill and no close button. The second
+// press renamed the next row (its release still carried the system's count
+// of two), and the row moved away kept its hover and its close button until
+// the pointer next moved.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       ADoubleClickRenamesOnlyWhatBothPressesHit) {
+  CloseDownToOne();
+  tabs::FolderTabCollection* const folder = MakeFolder();  // [0, F[1, 2], 3]
+  ASSERT_TRUE(folder);
+  AppendTab();
+  AppendTab();  // [0, F[1, 2], 3, 4, 5]
+  ASSERT_EQ(6, tab_strip_model()->count());
+  tabs::TabInterface* const in_folder = tab_strip_model()->GetTabAtIndex(2);
+  tabs::TabInterface* const first = tab_strip_model()->GetTabAtIndex(3);
+  tabs::TabInterface* const next = tab_strip_model()->GetTabAtIndex(4);
+
+  views::View* const root = widget()->GetRootView();
+  // The pointer moves to `point` on the screen, as the window hands a real
+  // move to its views.
+  const auto pointer_to = [&](gfx::Point point) {
+    views::View::ConvertPointFromScreen(root, &point);
+    root->OnMouseMoved(ui::MouseEvent(ui::EventType::kMouseMoved, point, point,
+                                      base::TimeTicks::Now(), ui::EF_NONE,
+                                      ui::EF_NONE));
+  };
+  // A left press and release at `point` whose click count is `clicks`,
+  // handed to the root view as the window hands it a real one: the platform
+  // counts a press as a double click's second by its time and place alone,
+  // and gives the release the same count.
+  const auto click = [&](gfx::Point point, int clicks) {
+    views::View::ConvertPointFromScreen(root, &point);
+    ui::MouseEvent press(ui::EventType::kMousePressed, point, point,
+                         ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+                         ui::EF_LEFT_MOUSE_BUTTON);
+    press.SetClickCount(clicks);
+    ui::MouseEvent release(ui::EventType::kMouseReleased, point, point,
+                           ui::EventTimeForNow(), ui::EF_LEFT_MOUSE_BUTTON,
+                           ui::EF_LEFT_MOUSE_BUTTON);
+    release.SetClickCount(clicks);
+    root->OnMousePressed(press);
+    root->OnMouseReleased(release);
+  };
+  // Collapsed with its second row active, the folder keeps that row.
+  const auto collapse_on = [&](tabs::TabInterface* tab) {
+    tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(tab));
+    folder->SetCollapsed(true);
+    ASSERT_TRUE(DrawnRow(tab)) << "the collapsed folder hid its active row";
+  };
+
+  {
+    SCOPED_TRACE("the second press lands on the next row");
+    ASSERT_NO_FATAL_FAILURE(collapse_on(in_folder));
+    TabView* row = DrawnRow(first);
+    ASSERT_TRUE(row);
+    const gfx::Point at =
+        row->title_for_testing()->GetBoundsInScreen().CenterPoint();
+    PointerRestingAt pointer(at);
+    pointer_to(at);
+    ASSERT_TRUE(row->IsHoverAnimationActive())
+        << "the row never saw the pointer";
+
+    click(at, 1);
+    EXPECT_EQ(first, tab_strip_model()->GetActiveTab());
+    ASSERT_FALSE(DrawnRow(in_folder))
+        << "the folder's row stayed: the list did not move";
+    TabView* const below = DrawnRow(next);
+    ASSERT_TRUE(below);
+    ASSERT_TRUE(below->title_for_testing()->GetBoundsInScreen().Contains(at))
+        << "the next row did not move under the pointer";
+
+    click(at, 2);
+    views::test::RunScheduledLayout(widget());
+    EXPECT_FALSE(below->IsRenaming())
+        << "the row the second press landed on was renamed";
+    EXPECT_EQ(next, tab_strip_model()->GetActiveTab())
+        << "the second press was not a click on the row under it";
+    row = DrawnRow(first);
+    ASSERT_TRUE(row);
+    EXPECT_FALSE(row->IsRenaming());
+    EXPECT_TRUE(
+        base::test::RunUntil([&]() { return !row->IsHoverAnimationActive(); }))
+        << "the row that moved away from under the pointer kept its hover";
+    views::test::RunScheduledLayout(widget());
+    EXPECT_FALSE(row->close_button_for_testing()->GetVisible())
+        << "the row that moved away shows its close button";
+    EXPECT_TRUE(below->IsHoverAnimationActive())
+        << "the row under the pointer has no hover";
+  }
+
+  {
+    SCOPED_TRACE("both presses on one row still rename it");
+    TabView* const row = DrawnRow(next);
+    ASSERT_TRUE(row);
+    const gfx::Point at =
+        row->title_for_testing()->GetBoundsInScreen().CenterPoint();
+    PointerRestingAt pointer(at);
+    click(at, 1);
+    click(at, 2);
+    EXPECT_TRUE(row->IsRenaming())
+        << "a double click on a row's title did not rename it";
+    row->HandleKeyEvent(row->rename_field_for_testing(),
+                        ui::KeyEvent(ui::EventType::kKeyPressed,
+                                     ui::VKEY_ESCAPE, ui::EF_NONE));
+    EXPECT_FALSE(row->IsRenaming());
+  }
+
+  {
+    SCOPED_TRACE("the second press lands on a folder's name");
+    folder->SetCollapsed(false);
+    tabs::FolderTabCollection* const lower =
+        tab_strip_model()->AddToNewFolder({4});  // [0, F[1, 2], 3, G[4], 5]
+    ASSERT_TRUE(lower);
+    lower->SetTitle("Lower");
+    ASSERT_NO_FATAL_FAILURE(collapse_on(in_folder));
+    TabView* const row = DrawnRow(first);
+    FolderView* const header = DrawnFolder(lower);
+    ASSERT_TRUE(row && header);
+    // Across, the middle of the lower folder's name; down, the row's middle.
+    views::Label* const name = header->name_for_testing();
+    gfx::Rect text = name->GetBoundsInScreen();
+    text.set_width(std::min(text.width(), name->GetPreferredSize().width()));
+    const gfx::Point at(text.CenterPoint().x(),
+                        row->GetBoundsInScreen().CenterPoint().y());
+    ASSERT_TRUE(row->title_for_testing()->GetBoundsInScreen().Contains(at))
+        << "the point is off the row's title";
+    PointerRestingAt pointer(at);
+    pointer_to(at);
+
+    click(at, 1);
+    ASSERT_FALSE(DrawnRow(in_folder));
+    ASSERT_TRUE(DrawnFolder(lower));
+    ASSERT_TRUE(header->GetHeaderBoundsInScreen().Contains(at))
+        << "the folder's header did not move under the pointer";
+    const bool collapsed = lower->collapsed();
+    click(at, 2);
+    views::test::RunScheduledLayout(widget());
+    EXPECT_FALSE(header->rename_field_for_testing()->GetVisible())
+        << "the folder the second press landed on was renamed";
+    EXPECT_NE(collapsed, lower->collapsed())
+        << "the second press was not a click on the header";
+  }
+}
