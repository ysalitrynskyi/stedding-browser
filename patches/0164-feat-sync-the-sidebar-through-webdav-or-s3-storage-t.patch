+// Sf46: a certificate the system does not trust has no way past it.
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceTest, AnUntrustedCertificateIsRefused) {
+  net::EmbeddedTestServer secure(net::EmbeddedTestServer::TYPE_HTTPS);
