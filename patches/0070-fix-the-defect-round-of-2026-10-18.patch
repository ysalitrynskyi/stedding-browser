+// Every tab the strip makes active while it watches, in order.
+class ActivationRecorder : public TabStripModelObserver {
+ public:
+  explicit ActivationRecorder(TabStripModel* strip) {
+    strip->AddObserver(this);
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* strip,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    if (selection.active_tab_changed() && selection.new_tab) {
+      activated_.push_back(selection.new_tab->GetHandle());
+    }
+  }
+
+  bool Saw(const tabs::TabInterface* tab) const {
+    return std::ranges::any_of(activated_, [tab](const tabs::TabHandle& each) {
+      return each.Get() == tab;
+    });
+  }
+
+ private:
+  std::vector<tabs::TabHandle> activated_;
+};
