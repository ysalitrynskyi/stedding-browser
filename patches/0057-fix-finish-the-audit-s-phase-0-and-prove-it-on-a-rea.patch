+bool HasDrawnRow(views::View* view, const tabs::TabInterface* tab) {
+  if (TabView* const row = views::AsViewClass<TabView>(view);
+      row && row->GetTabInterface() == tab && row->IsDrawn()) {
+    return true;
+  }
+  for (views::View* child : view->children()) {
+    if (HasDrawnRow(child, tab)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+spaces::SpaceSwitcherView* FindDrawnSwitcher(views::View* view) {
+  if (auto* const switcher = views::AsViewClass<spaces::SpaceSwitcherView>(view);
+      switcher && switcher->IsDrawn()) {
+    return switcher;
+  }
+  for (views::View* child : view->children()) {
+    if (spaces::SpaceSwitcherView* const found = FindDrawnSwitcher(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
