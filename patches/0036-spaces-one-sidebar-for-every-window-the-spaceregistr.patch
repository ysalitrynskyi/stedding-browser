+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_registry.h"
+
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+namespace {
+
+// G3, G5: what goes into the preference comes back whole, the empty
+// profile id included; the mutators write through.
+TEST(SpaceRegistryTest, RoundTrip) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  SpaceId work_id = SpaceId::GenerateNew();
+  {
+    SpaceRegistry registry(&prefs);
+    EXPECT_TRUE(registry.empty());
+    work_id = registry.Add("Work", SK_ColorBLUE);
+    const SpaceId play = registry.Add("Play", SK_ColorGREEN);
+    registry.SetIcon(work_id, "💼");
+    registry.SetColor(play, SK_ColorRED, /*chosen=*/true);
+    EXPECT_TRUE(registry.Move(play, -1));
+    ASSERT_EQ(2u, registry.entries().size());
+    EXPECT_EQ(play, registry.entries()[0].id);
+    EXPECT_TRUE(registry.entries()[0].profile_id.empty()) << "G5";
+    EXPECT_FALSE(registry.Remove(SpaceId::GenerateNew())) << "unknown";
+  }
+  SpaceRegistry again(&prefs);
+  ASSERT_EQ(2u, again.entries().size());
+  EXPECT_EQ("Play", again.entries()[0].name);
+  EXPECT_EQ(SK_ColorRED, again.entries()[0].color);
+  EXPECT_TRUE(again.entries()[0].color_chosen);
+  EXPECT_EQ("Work", again.entries()[1].name);
+  EXPECT_EQ("💼", again.entries()[1].icon);
+  EXPECT_EQ(work_id, again.entries()[1].id);
+  EXPECT_TRUE(again.entries()[1].profile_id.empty());
+  EXPECT_TRUE(again.Remove(again.entries()[0].id));
+  EXPECT_FALSE(again.Remove(work_id)) << "never the last one";
+  ASSERT_EQ(1u, again.entries().size());
+
+  // A window's session brings a Space the registry lacks: kept with its id.
+  RegistryEntry restored(SpaceId::GenerateNew(), "Study", SK_ColorYELLOW);
+  again.AddExisting(restored);
+  again.AddExisting(restored);
+  EXPECT_EQ(2u, again.entries().size());
+  EXPECT_EQ(
+      2u,
+      SpaceRegistry::FromValue(SpaceRegistry::ToValue(again.entries())).size());
+}
+
+}  // namespace
+}  // namespace spaces
