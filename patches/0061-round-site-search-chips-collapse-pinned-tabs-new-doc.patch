+bool SpaceModel::ArePinsCollapsed(const SpaceId& id) const {
+  const auto it = std::ranges::find_if(
+      spaces_,
+      [&id](const std::unique_ptr<Space>& s) { return s->id() == id; });
+  return it != spaces_.end() && (*it)->pins_collapsed();
+}
+
+void SpaceModel::SetPinsCollapsed(const SpaceId& id, bool collapsed) {
+  if (registry_) {
+    // The registry's change comes back through SyncWithRegistry in every
+    // window, which tells the observers there and writes the session.
+    registry_->SetPinsCollapsed(id, collapsed);
+    return;
+  }
+  Space* const space = GetSpace(id);
+  if (!space || space->pins_collapsed() == collapsed) {
+    return;
+  }
+  space->set_pins_collapsed(collapsed);
+  observers_.Notify(&Observer::OnSpacePinsCollapsedChanged, id);
+  SaveToSession();
+}
+
+bool SpaceModel::HasSpacePins(const SpaceId& id) const {
+  for (const auto& pin : space_pin_homes_) {
+    const tabs::TabInterface* const tab = pin.first.Get();
+    if (!tab || tab->IsPinned()) {
+      continue;
+    }
+    if (const auto it = tab_spaces_.find(pin.first);
+        it != tab_spaces_.end() && it->second == id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool SpaceModel::HidesTab(const tabs::TabInterface* tab) const {
+  if (!IsTabInActiveSpace(tab)) {
+    return true;
+  }
+  // pins H17: a pin of the active Space's collapsed run. An essential sits
+  // above every Space and is never one (B6).
+  if (!tab || tab->IsPinned() || !IsSpacePinned(tab) ||
+      !ArePinsCollapsed(active_id_)) {
+    return false;
+  }
+  // The selected pin keeps its row, and so does the pane beside it in a
+  // split: what is on screen stays in the list, as under a collapsed folder
+  // (folders F3).
+  const tabs::TabInterface* const active =
+      tab_strip_model_ ? tab_strip_model_->GetActiveTab() : nullptr;
+  if (!active) {
+    return true;
+  }
+  const bool on_screen =
+      tab == active ||
+      (tab->IsSplit() && tab->GetSplit() == active->GetSplit());
+  return !on_screen;
+}
