+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/shortcuts.md Z11 on the Mac: the menu bar is built with the
+// user's chords already, so a row changed or turned off before launch gets
+// its shipped key back when that change is undone in a later run.
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_MAC)
+
+#include "base/check.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
+#include "chrome/browser/ui/stedding/shortcut_catalog.h"
+#include "chrome/browser/ui/stedding/shortcut_chord.h"
+#include "chrome/browser/ui/stedding/shortcut_editor.h"
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+#include "chrome/browser/ui/stedding/shortcut_service.h"
+#include "chrome/browser/ui/stedding/shortcut_test_util_mac.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/test_launcher.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace {
+
+namespace shortcuts = stedding::shortcuts;
+
+// Print on ⌃⌘P, which no shipped table binds.
+constexpr shortcuts::Chord kControlCommandPB20(
+    ui::VKEY_P,
+    ui::EF_CONTROL_DOWN | ui::EF_COMMAND_DOWN);
+// ⌃⌥⇧J, which no shipped table binds either.
+constexpr shortcuts::Chord kFreeChordB20(ui::VKEY_J,
+                                         ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                                             ui::EF_SHIFT_DOWN);
+
+PrefService* LocalStateB20() {
+  return g_browser_process->local_state();
+}
+
+const shortcuts::Entry& RowB20(const char* name) {
+  const shortcuts::Entry* const entry = shortcuts::EntryForName(name);
+  CHECK(entry) << name;
+  return *entry;
+}
+
+// Leaves `row` with `chord` alone, its shipped chords taken off.
+void MoveRowB20(const char* row, const shortcuts::Chord& chord) {
+  ASSERT_EQ(shortcuts::CheckKind::kOk,
+            shortcuts::AddShortcut(LocalStateB20(), RowB20(row), chord,
+                                   /*replace=*/false,
+                                   shortcuts::OutsideHolders())
+                .kind)
+      << row;
+  for (const shortcuts::Chord& shipped :
+       shortcuts::DefaultChordsFor(RowB20(row).command)) {
+    shortcuts::RemoveShortcut(LocalStateB20(), RowB20(row), shipped);
+  }
+}
+
+class ShortcutMenuRestartB20Test : public InProcessBrowserTest {
+ protected:
+  void TearDownOnMainThread() override {
+    // A PRE_ test leaves its changes for the test after the restart.
+    if (!content::IsPreTest()) {
+      shortcuts::ResetAllShortcuts(LocalStateB20());
+    }
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+};
+
+// P26-1a: the changes the menu bar is built with after the restart.
+IN_PROC_BROWSER_TEST_F(ShortcutMenuRestartB20Test,
+                       PRE_ARowChangedBeforeLaunchGetsItsShippedKeyBack) {
+  ASSERT_NO_FATAL_FAILURE(MoveRowB20("print", kControlCommandPB20));
+  ASSERT_NO_FATAL_FAILURE(MoveRowB20("save-page", kFreeChordB20));
+  ASSERT_TRUE(
+      shortcuts::SetShortcutOff(LocalStateB20(), RowB20("dark-pages"), true));
+}
+
+// P26-1a, Z11: a reset row gets its shipped key back, also when the change
+// was made before launch. The menu bar is built with the stored chords, and
+// the walk left a row it had not changed in this run as it was (Print kept
+// ⌃⌘P, and ⌘P did nothing), left a row that was off at launch with no key,
+// and took the key a row had when first changed in this run for its shipped
+// one (Save Page As… got the user's chord back on Reset).
+IN_PROC_BROWSER_TEST_F(ShortcutMenuRestartB20Test,
+                       ARowChangedBeforeLaunchGetsItsShippedKeyBack) {
+  ui::Accelerator print;
+  ASSERT_TRUE(GetDefaultMacMenuAcceleratorForCommandId(IDC_PRINT, &print));
+  ui::Accelerator dark_pages;
+  ASSERT_TRUE(GetDefaultMacMenuAcceleratorForCommandId(
+      IDC_STEDDING_TOGGLE_DARK_PAGES, &dark_pages));
+  ui::Accelerator save_page;
+  ASSERT_TRUE(
+      GetDefaultMacMenuAcceleratorForCommandId(IDC_SAVE_PAGE, &save_page));
+  ASSERT_TRUE(shortcuts::test::MainMenuShowsChord(
+      IDC_PRINT, shortcuts::ToAccelerator(kControlCommandPB20)))
+      << "built with the stored chord";
+  ASSERT_TRUE(shortcuts::test::MainMenuShowsChord(
+      IDC_SAVE_PAGE, shortcuts::ToAccelerator(kFreeChordB20)));
+  ASSERT_TRUE(
+      shortcuts::test::MainMenuShowsNoChord(IDC_STEDDING_TOGGLE_DARK_PAGES))
+      << "built with the row off";
+
+  // Reset on a row no change in this run has touched.
+  ASSERT_TRUE(shortcuts::ResetShortcut(LocalStateB20(), RowB20("print")));
+  EXPECT_TRUE(shortcuts::test::MainMenuShowsChord(IDC_PRINT, print));
+  EXPECT_EQ(IDC_PRINT, shortcuts::test::CommandForChord(print))
+      << "the shipped key prints again";
+  EXPECT_NE(IDC_PRINT, shortcuts::test::CommandForChord(
+                           shortcuts::ToAccelerator(kControlCommandPB20)));
+  EXPECT_TRUE(shortcuts::test::MainMenuRowIsFolded(IDC_BASIC_PRINT))
+      << "Print Using System Dialog folds under Print again";
+
+  // A row that was off at launch, turned on.
+  ASSERT_TRUE(
+      shortcuts::SetShortcutOff(LocalStateB20(), RowB20("dark-pages"), false));
+  EXPECT_TRUE(shortcuts::test::MainMenuShowsChord(
+      IDC_STEDDING_TOGGLE_DARK_PAGES, dark_pages));
+
+  // A row changed again in this run, then reset.
+  ASSERT_TRUE(
+      shortcuts::SetShortcutOff(LocalStateB20(), RowB20("save-page"), true));
+  EXPECT_TRUE(shortcuts::test::MainMenuShowsNoChord(IDC_SAVE_PAGE));
+  ASSERT_TRUE(shortcuts::ResetShortcut(LocalStateB20(), RowB20("save-page")));
+  EXPECT_TRUE(shortcuts::test::MainMenuShowsChord(IDC_SAVE_PAGE, save_page));
+}
+
+}  // namespace
+
+#endif  // BUILDFLAG(IS_MAC)
