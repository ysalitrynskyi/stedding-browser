new file mode 100644
index 0000000000000..4eaf7cf4fa8af
--- /dev/null
+++ b/chrome/browser/ui/views/peek/peek_press.cc
@@ -0,0 +1,138 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/peek/peek_press.h"
+
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "third_party/blink/public/common/input/web_keyboard_event.h"
+#include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace stedding {
+
+namespace {
+
+// A click's navigation starts as its button comes up; a press older than
+// this is not the one a link is being followed for.
+constexpr base::TimeDelta kPressFreshFor = base::Seconds(1);
+
+bool IsLeftButton(const blink::WebInputEvent& event) {
+  return static_cast<const blink::WebMouseEvent&>(event).button ==
+         blink::WebPointerProperties::Button::kLeft;
+}
+
+// A modifier held for a click is part of it, not a key of its own.
+bool IsModifierKey(const blink::WebInputEvent& event) {
+  switch (static_cast<const blink::WebKeyboardEvent&>(event).windows_key_code) {
+    case ui::VKEY_SHIFT:
+    case ui::VKEY_CONTROL:
+    case ui::VKEY_MENU:
+    case ui::VKEY_LWIN:
+    case ui::VKEY_RWIN:
+    case ui::VKEY_LSHIFT:
+    case ui::VKEY_RSHIFT:
+    case ui::VKEY_LCONTROL:
+    case ui::VKEY_RCONTROL:
+    case ui::VKEY_LMENU:
+    case ui::VKEY_RMENU:
+      return true;
+    default:
+      return false;
+  }
+}
+
+}  // namespace
+
+PeekPress::PeekPress(content::WebContents* contents)
+    : content::WebContentsObserver(contents),
+      content::WebContentsUserData<PeekPress>(*contents) {
+  Watch(contents->GetPrimaryMainFrame());
+}
+
+PeekPress::~PeekPress() {
+  Unwatch();
+}
+
+std::optional<base::TimeDelta> PeekPress::LastPressBefore(
+    base::TimeTicks now) const {
+  if (down_.is_null() || up_.is_null() || now - up_ > kPressFreshFor) {
+    return std::nullopt;
+  }
+  return up_ - down_;
+}
+
+void PeekPress::OnInputEvent(const content::RenderWidgetHost& widget,
+                             const blink::WebInputEvent& event,
+                             input::InputEventSource source) {
+  switch (event.GetType()) {
+    case blink::WebInputEvent::Type::kMouseDown:
+      if (IsLeftButton(event)) {
+        down_ = base::TimeTicks::Now();
+        up_ = base::TimeTicks();
+      }
+      break;
+    case blink::WebInputEvent::Type::kMouseUp:
+      if (IsLeftButton(event) && !down_.is_null() && up_.is_null()) {
+        up_ = base::TimeTicks::Now();
+      }
+      break;
+    case blink::WebInputEvent::Type::kRawKeyDown:
+    case blink::WebInputEvent::Type::kKeyDown:
+      // peek P18 (BACKLOG S-319): a key after the press -- Enter on a focused
+      // link -- is what follows the link, not the press: a press held to
+      // select text, then an Enter within the second, had peeked.
+      if (!IsModifierKey(event)) {
+        down_ = base::TimeTicks();
+        up_ = base::TimeTicks();
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+void PeekPress::RenderFrameHostChanged(content::RenderFrameHost* old_host,
+                                       content::RenderFrameHost* new_host) {
+  if (new_host && new_host->IsInPrimaryMainFrame()) {
+    Watch(new_host);
+  }
+}
+
+void PeekPress::RenderWidgetHostDestroyed(content::RenderWidgetHost* widget) {
+  if (widget == watched_) {
+    Unwatch();
+  }
+}
+
+void PeekPress::WebContentsDestroyed() {
+  Unwatch();
+}
+
+void PeekPress::Watch(content::RenderFrameHost* host) {
+  content::RenderWidgetHost* const widget =
+      host ? host->GetRenderWidgetHost() : nullptr;
+  if (widget == watched_) {
+    return;
+  }
+  Unwatch();
+  if (widget) {
+    widget->AddInputEventObserver(this);
+    widget->AddObserver(this);
+    watched_ = widget;
+  }
+}
+
+void PeekPress::Unwatch() {
+  if (watched_) {
+    watched_->RemoveInputEventObserver(this);
+    watched_->RemoveObserver(this);
+    watched_ = nullptr;
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PeekPress);
+
+}  // namespace stedding
