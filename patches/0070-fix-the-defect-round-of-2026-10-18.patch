+// What the user sees of `icon`: the strongest alpha it paints with, times
+// the opacity of a layer it paints to.
+float DrawnStrength(views::View* icon) {
+  // The dim the icon paints itself with (TabIcon::SetDimmedOpacity), times a
+  // layer's opacity on the icon, which is where the dim used to be. The
+  // icon is not painted here: painted on its own, away from its place in
+  // the row, it trips views' paint-offset DCHECK.
+  const float layer = icon->layer() ? icon->layer()->opacity() : 1.0f;
+  return layer * views::AsViewClass<TabIcon>(icon)->dimmed_opacity_for_testing();
+}
