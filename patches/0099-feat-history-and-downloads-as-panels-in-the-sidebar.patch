@@ -0,0 +1,192 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/sidebar_panels_view.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "content/public/browser/context_menu_params.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/page.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/controls/webview/unhandled_keyboard_event_handler.h"
+#include "ui/views/controls/webview/web_contents_set_background_color.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/layout/fill_layout.h"
+
+namespace stedding {
+
+// The panel's web view, and its WebContents' delegate.
+class SidebarPanelView::PanelWebView : public views::WebView {
+  METADATA_HEADER(PanelWebView, views::WebView)
+
+ public:
+  PanelWebView(BrowserWindowInterface& browser,
+               GURL url,
+               base::RepeatingClosure close)
+      : views::WebView(browser.GetProfile()),
+        url_(std::move(url)),
+        close_(std::move(close)) {
+    content::WebContents* const contents = GetWebContents();
+    // The page's handlers find the window they open pages in through this,
+    // as the organizer panel's do.
+    webui::SetBrowserWindowInterface(contents, &browser);
+    // Pn16: the sidebar's own ground shows through: the window's gradient
+    // beside the page, the strip's opaque ground slid out over it.
+    views::WebContentsSetBackgroundColor::CreateForWebContentsWithColor(
+        contents, SK_ColorTRANSPARENT);
+    LoadInitialURL(url_);
+  }
+  PanelWebView(const PanelWebView&) = delete;
+  PanelWebView& operator=(const PanelWebView&) = delete;
+  ~PanelWebView() override = default;
+
+  // content::WebContentsDelegate:
+  bool HandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override {
+    // Pn5: Escape the page did not take closes the panel. The sidebar drops
+    // this view later, never under this call.
+    if (event.GetType() == input::NativeWebKeyboardEvent::Type::kRawKeyDown &&
+        event.windows_key_code == ui::VKEY_ESCAPE) {
+      if (close_) {
+        close_.Run();
+      }
+      return true;
+    }
+    // A chord the page does not take is the window's: a bare web view drops
+    // it, and ⌘Y pressed again, ⌘S, ⌘T, ⌘W and F6 did nothing with the
+    // focus in the panel.
+    views::FocusManager* const focus_manager = GetFocusManager();
+    if (!focus_manager) {
+      return false;
+    }
+    return unhandled_keyboard_event_handler_.HandleKeyboardEvent(
+        event, focus_manager);
+  }
+
+  // Pn7: the page never leaves chrome://stedding-library. Its rows open
+  // pages through the panel's handler, in the window; a link it would follow
+  // itself, a window it would open, a cross-process navigation of its own
+  // and anything dropped on it are refused, and a navigation that slips by
+  // brings the panel's page back.
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override {
+    return nullptr;
+  }
+  bool ShouldAllowRendererInitiatedCrossProcessNavigation(
+      bool is_outermost_main_frame_navigation) override {
+    return false;
+  }
+  bool CanDragEnter(content::WebContents* source,
+                    const content::DropData& data,
+                    blink::DragOperationsMask operations_allowed) override {
+    return false;
+  }
+  // The browser's page menu (Back, Reload, Inspect) is not the panel's; the
+  // search field keeps its own (Cut, Copy, Paste).
+  bool HandleContextMenu(content::RenderFrameHost& render_frame_host,
+                         const content::ContextMenuParams& params) override {
+    return !params.is_editable;
+  }
+
+ protected:
+  // content::WebContentsObserver:
+  void PrimaryPageChanged(content::Page& page) override {
+    views::WebView::PrimaryPageChanged(page);
+    if (page.GetMainDocument().GetLastCommittedURL().host() !=
+        kLibraryHost) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&PanelWebView::LoadThePanelAgain,
+                                    weak_factory_.GetWeakPtr()));
+    }
+  }
+
+ private:
+  void LoadThePanelAgain() {
+    if (content::WebContents* const contents = web_contents()) {
+      contents->GetController().LoadURL(url_, content::Referrer(),
+                                        ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
+                                        std::string());
+    }
+  }
+
+  const GURL url_;
+  base::RepeatingClosure close_;
+  views::UnhandledKeyboardEventHandler unhandled_keyboard_event_handler_;
+  base::WeakPtrFactory<PanelWebView> weak_factory_{this};
+};
+
+BEGIN_METADATA(SidebarPanelView, PanelWebView)
+END_METADATA
+
+SidebarPanelView::SidebarPanelView(BrowserWindowInterface& browser,
+                                   SidebarPanel panel,
+                                   base::RepeatingClosure close)
+    : panel_(panel) {
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+  web_view_ = AddChildView(
+      std::make_unique<PanelWebView>(browser, UrlFor(panel), std::move(close)));
+  // Pn16: a pane a screen reader names, which F6 reaches.
+  GetViewAccessibility().SetRole(ax::mojom::Role::kPane);
+  GetViewAccessibility().SetName(NameFor(panel));
+}
+
+SidebarPanelView::~SidebarPanelView() = default;
+
+// static
+GURL SidebarPanelView::UrlFor(SidebarPanel panel) {
+  switch (panel) {
+    case SidebarPanel::kHistory:
+      return GURL(kLibraryHistoryURL);
+    case SidebarPanel::kDownloads:
+      return GURL(kLibraryDownloadsURL);
+    case SidebarPanel::kNone:
+      break;
+  }
+  return GURL(kLibraryURL);
+}
+
+// static
+std::u16string SidebarPanelView::NameFor(SidebarPanel panel) {
+  switch (panel) {
+    case SidebarPanel::kHistory:
+      return u"History";
+    case SidebarPanel::kDownloads:
+      return u"Downloads";
+    case SidebarPanel::kNone:
+      break;
+  }
+  return std::u16string();
+}
+
+void SidebarPanelView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::View::OnBoundsChanged(previous_bounds);
+  // Pn4: not drawn while the column is too narrow to read it in.
+  web_view_->SetVisible(width() >= kSidebarPanelDrawnMinWidth);
+}
+
+BEGIN_METADATA(SidebarPanelView)
+END_METADATA
+
+}  // namespace stedding
