+// pins H14 (GitHub issue 29): a link opened from an essential when the run
+// begins with a pinned folder lands under the line, after the run, whether
+// the run ends with a pin or with the folder. The check looked for a pin of
+// the list's own level right after the new tab, so a folder at the run's head
+// let it stay above the run, and every pin and pinned folder was drawn under
+// the Clear line until the tab closed.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ALinkFromAnEssentialPassesAPinnedFolder) {
+  tabs::TabInterface* const essential = tabs().GetActiveTab();
+  ASSERT_TRUE(essential);
+  tabs().SetTabPinned(tabs().GetIndexOfTab(essential), true);
+  ASSERT_TRUE(essential->IsPinned());
+  tabs::TabInterface* const first = AddBlankTab();
+  tabs::TabInterface* const second = AddBlankTab();
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(
+      {tabs().GetIndexOfTab(first), tabs().GetIndexOfTab(second)});
+  ASSERT_TRUE(folder);
+  ASSERT_TRUE(model().CanPinFolder(folder));
+  model().SetFolderSpacePinned(folder, true);
+  tabs::TabInterface* const pin = AddBlankTab();
+  model().SetSpacePinned(pin, true);
+  // A row that stays under the line throughout, so the line is drawn.
+  tabs::TabInterface* const loose = AddBlankTab();
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  ASSERT_EQ(tabs().GetIndexOfTab(essential) + 1, tabs().GetIndexOfTab(first))
+      << "the folder is not the run's first row";
+  ASSERT_TRUE(IsAboveTheLine(first));
+  ASSERT_TRUE(IsAboveTheLine(pin));
+
+  const auto in_the_folder = [&](const tabs::TabInterface* tab) {
+    return tab->GetParentCollection() == folder;
+  };
+  // The run's last tab: the pin, then, once it is unpinned, the folder's.
+  tabs::TabInterface* last = pin;
+  for (const bool ends_with_the_folder : {false, true}) {
+    if (ends_with_the_folder) {
+      model().SetSpacePinned(pin, false);
+      ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+      last = second;
+    }
+    for (const WindowOpenDisposition disposition :
+         {WindowOpenDisposition::NEW_BACKGROUND_TAB,
+          WindowOpenDisposition::NEW_FOREGROUND_TAB}) {
+      SCOPED_TRACE(base::StrCat(
+          {ends_with_the_folder ? "a run of the folder alone"
+                                : "a run of the folder and a pin",
+           disposition == WindowOpenDisposition::NEW_BACKGROUND_TAB
+               ? ", in the background"
+               : ", in front"}));
+      tabs().ActivateTabAt(tabs().GetIndexOfTab(essential));
+      NavigateParams params(browser(), GURL("about:blank#child"),
+                            ui::PAGE_TRANSITION_LINK);
+      params.disposition = disposition;
+      params.source_contents = essential->GetContents();
+      Navigate(&params);
+      tabs::TabInterface* const opened =
+          tabs().GetTabForWebContents(params.navigated_or_inserted_contents);
+      ASSERT_TRUE(opened);
+      ASSERT_TRUE(base::test::RunUntil([&]() {
+        return tabs().GetIndexOfTab(opened) == tabs().GetIndexOfTab(last) + 1;
+      })) << "the new tab stayed above the run";
+      ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+      EXPECT_FALSE(in_the_folder(opened)) << "the new tab went into the folder";
+      EXPECT_FALSE(model().IsSpacePinned(opened));
+      EXPECT_TRUE(model().IsFolderSpacePinned(folder));
+      EXPECT_TRUE(IsAboveTheLine(first)) << "the folder was drawn under the line";
+      EXPECT_TRUE(IsAboveTheLine(second));
+      EXPECT_EQ(!ends_with_the_folder, IsAboveTheLine(pin));
+      EXPECT_FALSE(IsAboveTheLine(opened));
+      EXPECT_FALSE(IsAboveTheLine(loose));
+      tabs().CloseWebContentsAt(tabs().GetIndexOfTab(opened),
+                                TabCloseTypes::CLOSE_NONE);
+      ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    }
+  }
+}
