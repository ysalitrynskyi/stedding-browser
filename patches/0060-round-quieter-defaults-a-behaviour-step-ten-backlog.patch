+std::string SearchEngineMarkKey(const TemplateURL& engine) {
+  // An engine the user added carries no engine's mark.
+  if (engine.prepopulate_id() == 0) {
+    return std::string();
+  }
+  // By keyword first, which tells Yahoo Japan from the other Yahoos; by
+  // prepopulate id when the keyword was changed.
+  const TemplateURLPrepopulateData::PrepopulatedEngine* built_in =
+      TemplateURLPrepopulateData::GetPrepopulatedEngineFromBuiltInData(
+          engine.keyword(), /*regional_prepopulated_engines=*/{},
+          /*regional_variants=*/{});
+  if (!built_in) {
+    built_in = TemplateURLPrepopulateData::GetPrepopulatedEngineFromBuiltInData(
+        engine.prepopulate_id(), /*regional_prepopulated_engines=*/{},
+        /*regional_variants=*/{});
+  }
+  if (!built_in || !built_in->base_builtin_resource_id) {
+    return std::string();
+  }
+  const std::string_view id = built_in->base_builtin_resource_id;
+  return base::ToLowerASCII(
+      base::RemovePrefix(id, "SEARCH_ENGINE_").value_or(id));
+}
