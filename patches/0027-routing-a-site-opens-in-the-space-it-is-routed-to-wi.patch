new file mode 100644
index 0000000000000..2e6ebdb87f891
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_router.h
@@ -0,0 +1,65 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_ROUTER_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_ROUTER_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+#include "url/gurl.h"
+
+class PrefService;
+
+namespace spaces {
+
+// docs/features/routing.md D1: a rule that sends an address to a Space.
+struct Route {
+  enum class Match { kSite, kContains, kEquals };
+  Match match = Match::kSite;
+  std::string pattern;
+  // The Space's id, as SpaceId::ToString() writes it.
+  std::string space;
+  friend bool operator==(const Route&, const Route&) = default;
+};
+
+// The registrable domain of an address (github.com for gist.github.com), or
+// its host when it has no registry (localhost, an IP).
+std::string SiteOf(const GURL& url);
+
+bool RouteMatches(const Route& route, const GURL& url);
+
+// The Space of the first matching route. A link that peeks is never routed
+// (D6), so `peeking` short-circuits to nothing.
+std::optional<std::string> RouteFor(const std::vector<Route>& routes,
+                                    const GURL& url,
+                                    bool peeking = false);
+
+// D5: the rule the tab menu writes -- the address's site, no regex.
+Route SiteRouteFor(const GURL& url, const std::string& space);
+
+const char* MatchName(Route::Match match);
+std::optional<Route::Match> MatchFromName(std::string_view name);
+
+std::vector<Route> RoutesFromValue(const base::ListValue& value);
+base::ListValue RoutesToValue(const std::vector<Route>& routes);
+
+// The profile pref stedding.spaces.routes.
+std::vector<Route> ReadRoutes(const PrefService* prefs);
+void WriteRoutes(PrefService* prefs, const std::vector<Route>& routes);
+// Adds `route`, replacing a rule with the same match and pattern.
+void AddRoute(PrefService* prefs, Route route);
+void RemoveRoute(PrefService* prefs, size_t index);
+
+// D3: an address handed over by another app is remembered for a moment, so
+// the tab it opens can land in the default Space. Take returns true once.
+void MarkExternalOpen(const GURL& url);
+bool TakeExternalOpen(const GURL& url);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_ROUTER_H_
