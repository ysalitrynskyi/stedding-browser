+// The Space chips of an open sidebar, and the name that floats over the one
+// under the pointer.
+class SpaceChipPillW2B26Test : public SidebarStatesW2B26Test {
+ protected:
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+
+  int TabsIn(const spaces::SpaceId& id) {
+    int count = 0;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      if (model()->SpaceForTab(tab_strip_model()->GetTabAtIndex(i)) == id) {
+        ++count;
+      }
+    }
+    return count;
+  }
+
+  // Three Spaces of two tabs each, the first one active.
+  void MakeThreeSpaces() {
+    AppendTab();
+    ids_.push_back(model()->active_id());
+    ids_.push_back(model()->AddSpace("Two", SK_ColorBLUE)->id());
+    ids_.push_back(model()->AddSpace("Three", SK_ColorGREEN)->id());
+    for (size_t i = 1; i < ids_.size(); ++i) {
+      model()->SetActiveSpace(ids_[i]);
+      while (TabsIn(ids_[i]) < 2) {
+        AppendTab();
+      }
+    }
+    model()->SetActiveSpace(ids_[0]);
+    ASSERT_EQ(6, tab_strip_model()->count());
+  }
+
+  // The pointer comes to rest on `view`, through the window's root view.
+  void RestOn(views::View* view) {
+    views::View* const root = window()->GetRootView();
+    gfx::Point point = view->GetBoundsInScreen().CenterPoint();
+    views::View::ConvertPointFromScreen(root, &point);
+    ui::MouseEvent move(ui::EventType::kMouseMoved, point, point,
+                        ui::EventTimeForNow(), ui::EF_NONE, ui::EF_NONE);
+    root->OnMouseMoved(move);
+  }
+
+  // P34-1e, sidebar Y14: the name floats centred over the chip under the
+  // pointer, on screen.
+  void ExpectTheNameOverTheChip() {
+    ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces());
+    views::test::RunScheduledLayout(window());
+    ASSERT_FALSE(controller()->IsCollapsed());
+    views::Label* const pill = region()->space_hover_pill_for_testing();
+    ASSERT_TRUE(pill);
+    spaces::SpaceSwitcherView* const switcher =
+        stedding::test::FindDrawnSwitcher(window()->GetRootView());
+    ASSERT_TRUE(switcher);
+    views::View* const chip = switcher->ChipForTesting(ids_[1]);
+    ASSERT_TRUE(chip);
+    RestOn(chip);
+    ASSERT_TRUE(pill->GetVisible()) << "no floating name";
+    EXPECT_EQ(model()->DisplayName(ids_[1]), pill->GetText());
+    const gfx::Rect chip_bounds = chip->GetBoundsInScreen();
+    const gfx::Rect pill_bounds = pill->GetBoundsInScreen();
+    EXPECT_NEAR(chip_bounds.CenterPoint().x(), pill_bounds.CenterPoint().x(),
+                1)
+        << "the chip at " << chip_bounds.ToString() << ", its name at "
+        << pill_bounds.ToString();
+    EXPECT_LE(pill_bounds.bottom(), chip_bounds.y()) << "not above the chip";
+  }
+
+  std::vector<spaces::SpaceId> ids_;
+};
+
+IN_PROC_BROWSER_TEST_F(SpaceChipPillW2B26Test, TheNameFloatsOverTheChip) {
+  ASSERT_FALSE(base::i18n::IsRTL());
+  ExpectTheNameOverTheChip();
+}
+
+class SpaceChipPillRtlW2B26Test : public SpaceChipPillW2B26Test {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    SpaceChipPillW2B26Test::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(switches::kForceUIDirection,
+                                    switches::kForceDirectionRTL);
+  }
+};
