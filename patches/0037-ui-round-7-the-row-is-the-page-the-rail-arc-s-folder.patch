@@ -0,0 +1,66 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/theme/page_theme_color_controller.h"
+
+#include "base/callback_list.h"
+#include "base/test/bind.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+using PageThemeColorControllerTest = BrowserWithTestWindowTest;
+
+// folders F12 (the crash at quit, 2026-09-05): the window is re-themed one
+// turn after the colour changes, never inside the tab strip's own change,
+// and several changes in one turn re-theme once.
+TEST_F(PageThemeColorControllerTest, ReThemesAfterTheChangeNotInsideIt) {
+  AddTab(browser(), GURL("https://example.com/"));
+  PageThemeColorController* const controller =
+      PageThemeColorController::From(browser());
+  ASSERT_TRUE(controller);
+  int notified = 0;
+  const base::CallbackListSubscription subscription =
+      controller->AddChangedCallback(
+          base::BindLambdaForTesting([&notified] { ++notified; }));
+  controller->SetColorForTesting(SK_ColorWHITE);
+  controller->SetColorForTesting(SK_ColorBLACK);
+  EXPECT_EQ(0, notified) << "nothing until the turn ends";
+  EXPECT_EQ(SK_ColorBLACK, controller->color());
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(1, notified) << "two changes in one turn re-theme once";
+}
+
+TEST_F(PageThemeColorControllerTest, ClosingEveryTabReThemesAfterwards) {
+  AddTab(browser(), GURL("https://example.com/"));
+  AddTab(browser(), GURL("https://example.org/"));
+  PageThemeColorController* const controller =
+      PageThemeColorController::From(browser());
+  ASSERT_TRUE(controller);
+  int notified = 0;
+  bool saw_closing_all = false;
+  TabStripModel* const model = browser()->tab_strip_model();
+  const base::CallbackListSubscription subscription =
+      controller->AddChangedCallback(base::BindLambdaForTesting([&] {
+        ++notified;
+        saw_closing_all |= model->closing_all();
+      }));
+  controller->SetColorForTesting(SK_ColorWHITE);
+  model->CloseAllTabs();
+  EXPECT_EQ(0, notified) << "nothing re-themes inside CloseAllTabs";
+  task_environment()->RunUntilIdle();
+  // The model stays in its closing-all state once it has emptied itself (the
+  // window goes next), so the posted re-theme finds nothing to do.
+  EXPECT_EQ(0, notified);
+  EXPECT_FALSE(saw_closing_all);
+}
+
+}  // namespace
+}  // namespace stedding
