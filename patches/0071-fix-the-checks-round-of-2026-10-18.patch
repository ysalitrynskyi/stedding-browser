+// PLAN.md TAB-34, TAB-F39 (BACKLOG S-141): in a short window, under a full
+// essentials grid, the tab list keeps to the strip: nothing is laid out past
+// the strip's bottom edge, and the last row scrolls fully into view. The
+// pinned container was sized before the Space title row was counted, and
+// could take the room the tab list's own minimum needs, so the list ran past
+// the strip's bottom, where the strip cut its last row off and no scroll
+// could bring that row into view.
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, AShortWindowCutsNoRowOff) {
+  // A second Space, so the title row shows over the pinned run (one unnamed
+  // Space is an ordinary window).
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  ASSERT_TRUE(model->AddSpace("Work", SK_ColorBLUE));
+  // Twelve essentials, the grid's six rows, over two tabs.
+  for (int i = 0; i < 12; ++i) {
+    AppendPinnedTab();
+  }
+  AppendTab();
+  TabStripModel* const tabs = tab_strip_model();
+  ASSERT_EQ(14, tabs->count());
+  tabs::TabInterface* const last = tabs->GetActiveTab();
+  ASSERT_FALSE(tabs->IsTabPinned(tabs->GetIndexOfTab(last)));
+  views::Widget* const widget = browser_view()->GetWidget();
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+  TabStripView* const strip = stedding::test::FindView<TabStripView>(region());
+  ASSERT_TRUE(strip);
+  ASSERT_TRUE(strip->GetSpaceTitleRow() &&
+              strip->GetSpaceTitleRow()->GetVisible())
+      << "the premise: the Space title row shows";
+
+  // From a tall window down to the shortest the window allows, 4 DIP at a
+  // time, every height where a row is cut off.
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetPrimaryDisplay().work_area();
+  const int width = std::min(1200, work_area.width());
+  const int frame =
+      widget->GetWindowBoundsInScreen().height() - browser_view()->height();
+  const int shortest =
+      std::max(200, browser_view()->GetMinimumSize().height() + frame);
+  std::vector<std::string> cut;
+  int shortest_strip = strip->height();
+  int tallest_strip = 0;
+  for (int height = std::min(720, work_area.height()); height >= shortest;
+       height -= 4) {
+    widget->SetBounds(gfx::Rect(work_area.origin(), gfx::Size(width, height)));
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+    shortest_strip = std::min(shortest_strip, strip->height());
+    tallest_strip = std::max(tallest_strip, strip->height());
+    const std::string at = base::StrCat(
+        {"a window ", base::NumberToString(height), " DIP tall, a strip of ",
+         base::NumberToString(strip->height())});
+    const int list_bottom =
+        strip->unpinned_tabs_scroll_view()->bounds().bottom();
+    if (list_bottom > strip->height()) {
+      cut.push_back(base::StrCat(
+          {at, ": the tab list ends at ", base::NumberToString(list_bottom)}));
+    }
+    TabView* const row =
+        stedding::test::FindDrawnRow(widget->GetRootView(), last);
+    if (!row) {
+      cut.push_back(base::StrCat({at, ": the last tab has no drawn row"}));
+      continue;
+    }
+    row->ScrollViewToVisible();
+    views::test::RunScheduledLayout(widget);
+    const gfx::Rect in_strip =
+        views::View::ConvertRectToTarget(row, strip, row->GetLocalBounds());
+    if (!strip->GetLocalBounds().Contains(in_strip)) {
+      cut.push_back(base::StrCat({at, ": the last row, scrolled into view, is ",
+                                  in_strip.ToString()}));
+    }
+  }
+  // The run squeezed the strip: down to the window's minimum, which on the
+  // Mac already keeps a strip this full above where the list ran past it.
+  EXPECT_LT(shortest_strip, tallest_strip)
+      << "the strip never got shorter than " << tallest_strip << " DIP";
+  EXPECT_TRUE(cut.empty()) << base::JoinString(cut, "\n");
+}
