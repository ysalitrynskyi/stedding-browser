+// toolbar T40: a popup asked for while the row is not drawn opens inside the
+// window, in the page card's top half and not over the sidebar: an
+// extension's popup and the media dialog hang from the top container at the
+// card's top left, page info from the card's corner. The row stays hidden,
+// and when the popup closes the page has the focus (commandbar K1).
+IN_PROC_BROWSER_TEST_F(HiddenRowControlsTest,
+                       APopupWithoutTheRowOpensInsideThePage) {
+  const scoped_refptr<const extensions::Extension> popup =
+      LoadAction("Stedding Popup Probe", /*popup=*/true);
+  ASSERT_TRUE(popup);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("site.test", "/title1.html")));
+  ASSERT_NO_FATAL_FAILURE(HideTheRow());
+
+  {
+    SCOPED_TRACE("an extension's popup");
+    ASSERT_NO_FATAL_FAILURE(RunRow(u"Stedding Popup Probe"));
+    ToolbarActionViewModel* const action = ActionOf(*popup);
+    ASSERT_TRUE(action);
+    views::Widget* shown = nullptr;
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      shown = PopupWidget(action);
+      // The popup shows small and grows to its page's size.
+      return shown && shown->IsVisible() &&
+             shown->GetWindowBoundsInScreen().width() >= 240 &&
+             shown->GetWindowBoundsInScreen().height() >= 160;
+    })) << "no popup of its page's size";
+    ExpectInTheCardsTopHalf(shown->GetWindowBoundsInScreen(), "the popup");
+    const gfx::Rect card =
+        browser_view()->contents_container()->GetBoundsInScreen();
+    // At the card's top left, its shadow aside.
+    EXPECT_LE(shown->GetWindowBoundsInScreen().x(), card.x() + 16)
+        << "the popup is not at the card's left";
+    ExpectTheRowHidden();
+    action->HidePopup();
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return !action->IsShowingPopup(); }));
+    EXPECT_TRUE(base::test::RunUntil([&]() { return PageHasFocus(); }))
+        << "the page does not have the focus after the popup";
+  }
+
+  {
+    SCOPED_TRACE("page info");
+    ASSERT_NO_FATAL_FAILURE(RunRow(u"View Site Information"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::BubbleDialogDelegateView* const bubble =
+          PageInfoBubbleViewBase::GetPageInfoBubbleForTesting();
+      return bubble && bubble->GetWidget() && bubble->GetWidget()->IsVisible();
+    })) << "no page info";
+    views::Widget* const bubble =
+        PageInfoBubbleViewBase::GetPageInfoBubbleForTesting()->GetWidget();
+    ExpectInTheCardsTopHalf(bubble->GetWindowBoundsInScreen(), "page info");
+    ExpectTheRowHidden();
+    bubble->CloseNow();
+    EXPECT_TRUE(base::test::RunUntil([&]() { return PageHasFocus(); }))
+        << "the page does not have the focus after page info";
+  }
+
+  {
+    SCOPED_TRACE("the media dialog");
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(),
+        embedded_test_server()->GetURL(
+            "site.test", "/media/session/video-with-metadata.html")));
+    content::MediaStartStopObserver started(
+        page(), content::MediaStartStopObserver::Type::kStart);
+    page()->GetPrimaryMainFrame()->ExecuteJavaScriptForTests(
+        u"play()", base::NullCallback(), content::ISOLATED_WORLD_ID_GLOBAL);
+    started.Wait();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return stedding::MediaControlsAvailable(browser());
+    })) << "the media button never showed";
+    ASSERT_NO_FATAL_FAILURE(RunRow(u"Show Media Controls"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      MediaDialogView* const dialog =
+          MediaDialogView::GetDialogViewForTesting();
+      return dialog && dialog->GetWidget() && dialog->GetWidget()->IsVisible();
+    })) << "no media dialog";
+    ExpectInTheCardsTopHalf(MediaDialogView::GetDialogViewForTesting()
+                                ->GetWidget()
+                                ->GetWindowBoundsInScreen(),
+                            "the media dialog");
+    ExpectTheRowHidden();
+    MediaDialogView::HideDialog();
+  }
+}
