+
+  // The chip of `id` wears the badge, drawn with a size inside the chip, and
+  // says what it means as its accessible description; or neither.
+  void ExpectChipMarked(const spaces::SpaceId& id, bool marked) {
+    views::View* const chip = Chip(id);
+    ASSERT_TRUE(chip) << "no chip for the Space";
+    stedding::IsolationMarkView* const badge =
+        stedding::FindShownIsolationMark(chip);
