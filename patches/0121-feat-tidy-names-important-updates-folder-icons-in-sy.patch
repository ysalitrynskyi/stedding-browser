+// updates Up24 (ADR 0031; the owner, 2026-11-03: strong, never forced): an
+// important update turns the pill red, says why, and puts a bar under the
+// page once per launch, in a normal window. Nothing restarts until asked.
+IN_PROC_BROWSER_TEST_F(UpdatesTest,
+                       AnImportantUpdateIsShownStronglyAndNotForced) {
+  stedding::ResetImportantUpdateBarForTesting();
+  const auto bars_of = [](BrowserWindowInterface* window) {
+    return infobars::ContentInfoBarManager::FromWebContents(
+        window->GetTabStripModel()->GetActiveWebContents());
+  };
+  infobars::ContentInfoBarManager* const bars = bars_of(browser());
+  stedding::UpdatePill* const pill = Pill();
+  ASSERT_TRUE(pill);
+
+  // An ordinary update: the pill as it always was, and no bar.
+  updater_->Set(State::kReady, u"0.4.0-beta.9");
+  ASSERT_TRUE(pill->GetVisible());
+  EXPECT_EQ(u"New Stedding Version Available", pill->GetText());
+  EXPECT_TRUE(bars->infobars().empty());
+
+  // A private window shows no bar, and leaves it to the next normal one.
+  BrowserWindowInterface* const private_window = CreateIncognitoBrowser();
+  updater_->SetImportant(u"It fixes a hole in the updater.");
+  EXPECT_TRUE(bars_of(private_window)->infobars().empty());
+  CloseBrowserSynchronously(private_window);
+
+  EXPECT_EQ(u"Important Update", pill->GetText());
+  EXPECT_NE(std::u16string::npos,
+            pill->GetTooltipText().find(u"It fixes a hole in the updater."))
+      << pill->GetTooltipText();
+  ASSERT_EQ(1u, bars->infobars().size());
+  ConfirmInfoBarDelegate* bar =
+      bars->infobars()[0]->delegate()->AsConfirmInfoBarDelegate();
+  ASSERT_TRUE(bar);
+  EXPECT_EQ(infobars::InfoBarDelegate::STEDDING_IMPORTANT_UPDATE_INFOBAR_DELEGATE,
+            bar->GetIdentifier());
+  EXPECT_EQ(
+      u"An important update to Stedding is ready: It fixes a hole in the "
+      u"updater.",
+      bar->GetMessageText());
+  EXPECT_EQ(u"Restart Now",
+            bar->GetButtonLabel(ConfirmInfoBarDelegate::BUTTON_OK));
+  // Never forced: nothing restarts by itself.
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, updater_->installs);
+
+  // Closed, it stays closed for the rest of the launch: another change, or
+  // another window, shows none.
+  bars->RemoveInfoBar(bars->infobars()[0]);
+  updater_->Set(State::kReady, u"0.4.0-beta.10");
+  EXPECT_TRUE(bars->infobars().empty());
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  EXPECT_TRUE(bars_of(second)->infobars().empty());
+  CloseBrowserSynchronously(second);
+  EXPECT_EQ(u"Important Update", pill->GetText()) << "the pill still says so";
+
+  // A private window is refused on its own account, not because a normal
+  // window asked first.
+  {
+    stedding::ResetImportantUpdateBarForTesting();
+    BrowserWindowInterface* const quiet = CreateIncognitoBrowser();
+    stedding::MaybeShowImportantUpdateBar(quiet, *updater_);
+    EXPECT_TRUE(bars_of(quiet)->infobars().empty());
+    CloseBrowserSynchronously(quiet);
+    // The normal window, in front again, may have shown it since.
+    while (!bars->infobars().empty()) {
+      bars->RemoveInfoBar(bars->infobars()[0]);
+    }
+  }
+
+  // Restart Now restarts, as the pill does.
+  stedding::ResetImportantUpdateBarForTesting();
+  updater_->SetImportant(u"It fixes a hole in the updater, and one more.");
+  ASSERT_EQ(1u, bars->infobars().size());
+  bar = bars->infobars()[0]->delegate()->AsConfirmInfoBarDelegate();
+  bar->Accept();
+  EXPECT_EQ(1, updater_->installs);
+  bars->RemoveInfoBar(bars->infobars()[0]);
+
+  // An ordinary update after it: the pill as it always was.
+  updater_->SetImportant(std::u16string());
+  EXPECT_EQ(u"New Stedding Version Available", pill->GetText());
+  updater_->Set(State::kUpToDate);
+  EXPECT_FALSE(pill->GetVisible());
+}
