+// toolbar T64: the keyboard focus in the row keeps it over the page with the
+// pointer gone; the focus back on the page sends it away. The command to put
+// the keyboard on the row brings it in first (Move the focus to the
+// toolbar). Cmd-L opens the command bar over the hidden row, as always
+// (commandbar K12), and leaves the row hidden.
+IN_PROC_BROWSER_TEST_F(CompactRowTest, TheKeyboardInTheRowKeepsIt) {
+  ASSERT_NO_FATAL_FAILURE(CloseTo(stedding::prefs::kSidebarClosedHidden));
+  ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                     widget()->GetNativeWindow());
+  const gfx::Rect page = Page();
+
+  ASSERT_NO_FATAL_FAILURE(RevealFromTheTop(generator));
+  views::FocusManager* const focus = widget()->GetFocusManager();
+  browser_view()->GetLocationBarView()->FocusLocation(
+      /*is_user_initiated=*/true, /*clear_focus_if_failed=*/false);
+  ASSERT_TRUE(browser_view()->top_container()->Contains(
+      focus->GetFocusedView()))
+      << "the field took no focus";
+  MoveTo(generator, page.CenterPoint());
+  PastTheRest();
+  EXPECT_TRUE(RowShows()) << "the row went with the focus in its field";
+  browser_view()->GetActiveContentsWebView()->RequestFocus();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return !RowShows();
+  })) << "the focus on the page left the row over it";
+
+  // Move the focus to the toolbar.
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_FOCUS_TOOLBAR));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return RowShows() && reveal()->OverPage();
+  })) << "the keyboard could not reach the hidden row";
+  EXPECT_EQ(page, Page());
+  browser_view()->GetActiveContentsWebView()->RequestFocus();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return !RowShows();
+  }));
+
+  // Cmd-L: the command bar over the hidden row.
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_FOCUS_LOCATION));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return stedding::CommandBarView::GetOpenBar(browser_view()) != nullptr;
+  })) << "Cmd-L opened no command bar";
+  views::test::RunScheduledLayout(widget());
+  EXPECT_FALSE(RowShows()) << "Cmd-L brought the hidden row in";
+}
+
+// toolbar T64: the find bar, a window of its own over the page, hangs under
+// the row while the row is over the page.
+IN_PROC_BROWSER_TEST_F(CompactRowTest, TheFindBarHangsUnderTheRow) {
+  ASSERT_NO_FATAL_FAILURE(CloseTo(stedding::prefs::kSidebarClosedHidden));
+  const gfx::Rect hidden = browser_view()->GetFindBarBoundingBox();
+  ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                     widget()->GetNativeWindow());
