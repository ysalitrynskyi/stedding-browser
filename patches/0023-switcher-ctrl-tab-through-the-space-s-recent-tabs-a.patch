+RecentTabsSwitcherView::~RecentTabsSwitcherView() = default;
+
+void RecentTabsSwitcherView::Refresh() {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser_);
+  if (closing_ || !model) {
+    return;
+  }
+  if (!model->in_cycle()) {
+    Close();
+    return;
+  }
+  RemoveAllChildViews();
+  cells_.clear();
+  const std::vector<tabs::TabInterface*> tabs = model->cycle_tabs();
+  highlighted_ = model->cycle_position();
+  const ui::ColorProvider* const provider = GetColorProvider();
+  const SkColor text =
+      provider ? provider->GetColor(ui::kColorLabelForeground) : SK_ColorWHITE;
+  const spaces::Space* const space = model->active_space();
+  const SkColor dot = space ? space->color() : text;
+  for (size_t i = 0; i < tabs.size(); ++i) {
+    tabs::TabInterface* const tab = tabs[i];
+    auto cell = std::make_unique<views::View>();
+    auto* const layout =
+        cell->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kVertical, gfx::Insets::VH(14, 12),
+            8));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    cell->SetPreferredSize(gfx::Size(kCellWidth, kCellHeight));
+    if (i == highlighted_) {
+      cell->SetBackground(views::CreateRoundedRectBackground(
+          SkColorSetA(text, kHighlightAlpha), kCellRadius));
+    }
+
+    auto favicon = std::make_unique<views::ImageView>();
+    if (TabUIHelper* const helper = TabUIHelper::From(tab)) {
+      favicon->SetImage(helper->GetFavicon());
+    }
+    favicon->SetImageSize(gfx::Size(kFaviconSize, kFaviconSize));
+    cell->AddChildView(std::move(favicon));
+
+    // The title with the Space's colour beside it.
+    auto row = std::make_unique<views::View>();
+    auto* const row_layout =
+        row->SetLayoutManager(std::make_unique<views::BoxLayout>(
+            views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), 6));
+    row_layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto swatch = std::make_unique<views::View>();
+    swatch->SetPreferredSize(gfx::Size(kDotSize, kDotSize));
+    swatch->SetBackground(
+        views::CreateRoundedRectBackground(dot, kDotSize / 2));
+    row->AddChildView(std::move(swatch));
+    const TabUIHelper* const helper = TabUIHelper::From(tab);
+    auto title = std::make_unique<views::Label>(
+        helper ? helper->GetTitle() : tab->GetContents()->GetTitle());
+    title->SetElideBehavior(gfx::ELIDE_TAIL);
+    title->SetMaximumWidthSingleLine(kCellWidth - 2 * 12 - kDotSize - 6);
+    title->SetEnabledColor(ui::kColorLabelForeground);
+    row->AddChildView(std::move(title));
+    cell->AddChildView(std::move(row));
+
+    cells_.push_back(AddChildView(std::move(cell)));
+  }
+  InvalidateLayout();
+  UpdateBounds();
+}
+
+void RecentTabsSwitcherView::OnWatchedEvent(const ui::Event& event) {
+  if (closing_) {
+    return;
+  }
+  if (event.IsMouseEvent()) {
+    Commit();
+    return;
+  }
+  if (!event.IsKeyEvent()) {
+    return;
+  }
+  const ui::KeyEvent& key = *event.AsKeyEvent();
+  if (key.type() == ui::EventType::kKeyReleased) {
+    if (IsControl(key)) {
+      Commit();
+    }
+    return;
+  }
+  if (key.type() != ui::EventType::kKeyPressed) {
+    return;
+  }
+  if (key.key_code() == ui::VKEY_ESCAPE) {
+    Cancel();
+    return;
+  }
+  // Tab with Ctrl is the accelerator that steps the run; Show() refreshes.
+  if (key.key_code() == ui::VKEY_TAB || IsControl(key)) {
+    return;
+  }
+  if (!key.IsControlDown()) {
+    // A key without Ctrl: the release was missed, the run is over.
+    Commit();
+  }
+}
+
+void RecentTabsSwitcherView::AddedToWidget() {
+  views::View::AddedToWidget();
+  if (views::Widget* const widget = GetWidget();
+      widget && widget->GetNativeWindow()) {
+    watcher_ = std::make_unique<Watcher>(this);
+    monitor_ = views::EventMonitor::CreateWindowMonitor(
+        watcher_.get(), widget->GetNativeWindow(),
+        {ui::EventType::kKeyPressed, ui::EventType::kKeyReleased,
+         ui::EventType::kMousePressed});
+  }
+}
+
+void RecentTabsSwitcherView::RemovedFromWidget() {
+  monitor_.reset();
+  watcher_.reset();
+  hold_timer_.Stop();
+  views::View::RemovedFromWidget();
+}
+
+void RecentTabsSwitcherView::OnKeyEventForTesting(const ui::KeyEvent& event) {
+  OnWatchedEvent(event);
+}
+
+void RecentTabsSwitcherView::FireHoldTimerForTesting() {
+  hold_timer_.Stop();
+  Reveal();
+}
+
+void RecentTabsSwitcherView::Reveal() {
+  if (closing_ || revealed_) {
+    return;
+  }
+  revealed_ = true;
+  UpdateBounds();
+  SetVisible(true);
+  if (layer() && browser_ &&
+      ShouldAnimate(browser_->GetProfile()->GetPrefs())) {
+    layer()->SetOpacity(0.0f);
+    ui::ScopedLayerAnimationSettings settings(layer()->GetAnimator());
+    settings.SetTransitionDuration(base::Milliseconds(80));
+    layer()->SetOpacity(1.0f);
+  }
+}
+
+void RecentTabsSwitcherView::Commit() {
+  if (spaces::SpaceModel* const model = spaces::SpaceModel::From(browser_)) {
+    model->EndCycle();
+  }
+  Close();
+}
+
+void RecentTabsSwitcherView::Cancel() {
+  if (spaces::SpaceModel* const model = spaces::SpaceModel::From(browser_)) {
+    model->CancelCycle();
+  }
+  Close();
+}
+
+void RecentTabsSwitcherView::Close() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  hold_timer_.Stop();
+  monitor_.reset();
+  watcher_.reset();
+  SetVisible(false);
+  // Deleting a view from inside an event it observes is not safe; a turn
+  // later it is.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<RecentTabsSwitcherView> strip) {
+                       if (strip && strip->parent()) {
+                         std::unique_ptr<views::View> owned =
+                             strip->parent()->RemoveChildViewT(strip.get());
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void RecentTabsSwitcherView::UpdateBounds() {
+  views::View* const window = parent();
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser_);
+  if (!window || !browser_view) {
+    return;
+  }
+  gfx::RectF contents_f(browser_view->contents_container()->GetLocalBounds());
+  views::View::ConvertRectToTarget(browser_view->contents_container(), window,
+                                   &contents_f);
+  const gfx::Rect contents = gfx::ToEnclosingRect(contents_f);
+  const gfx::Size size = GetPreferredSize();
+  SetBoundsRect(gfx::Rect(contents.x() + (contents.width() - size.width()) / 2,
+                          contents.y() + contents.height() / 3, size.width(),
+                          size.height()));
+}
+
+BEGIN_METADATA(RecentTabsSwitcherView)
+END_METADATA
+
+}  // namespace stedding
