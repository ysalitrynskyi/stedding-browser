+// sidebar-file Sf15, Sf21, folders F37: another computer moved the pinned
+// folder G to another Space, and the folder F, inside H inside G here, up
+// into G. F's record is read before G's, and G's own move waits while the
+// user is on a pin of G. F waits for G: it does not go to the other Space
+// alone, into a G still in this one. Once the user leaves that pin G moves
+// whole, F's record is read before G's again and still waits, and at the next
+// read F moves into G there. F was moved to the other Space first, into a
+// folder of this one, or out of a G the move left empty and gone.
+IN_PROC_BROWSER_TEST_F(SidebarSyncB11Test,
+                       AFolderMovedIntoAMovedFolderWaitsForThatFolder) {
+  ASSERT_NO_FATAL_FAILURE(Join());
+  const spaces::SpaceId first = model().active_id();
+  spaces::Space* const made = model().AddSpace("Second", SK_ColorBLUE);
+  ASSERT_TRUE(made);
+  const spaces::SpaceId second = made->id();
+  // A tab of the first Space in no folder, to leave G's pin for.
+  tabs::TabInterface* const elsewhere = tabs().GetActiveTab();
+  ASSERT_TRUE(elsewhere);
+  tabs::TabInterface* const g_pin = OpenPin();
+  ASSERT_TRUE(g_pin);
+  tabs::TabInterface* const h_pin = OpenPin();
+  ASSERT_TRUE(h_pin);
+  tabs::TabInterface* const f_pin = OpenPin();
+  ASSERT_TRUE(f_pin);
+
+  // Records are read in the order of their ids: these put F before H, and H
+  // before G.
+  const tabs::FolderId f_id = tabs::FolderId::FromRawToken(base::Token(0, 1));
+  const tabs::FolderId h_id = tabs::FolderId::FromRawToken(base::Token(0, 2));
+  const tabs::FolderId g_id =
+      tabs::FolderId::FromRawToken(base::Token(0xFFFFFFFFFFFFFFFFu, 1));
+  const std::string f_sync = spaces::FolderSyncId(f_id);
+  const std::string h_sync = spaces::FolderSyncId(h_id);
+  const std::string g_sync = spaces::FolderSyncId(g_id);
+  ASSERT_LT(f_sync, g_sync);
+  const auto folder_of = [&](const tabs::FolderId& id) {
+    return spaces::FindFolderById(*tabs().Root(), id);
+  };
+
+  // G { g, H { h, F { f } } }, a pinned folder of the first Space.
+  ASSERT_TRUE(tabs().AddToNewFolder(
+      {tabs().GetIndexOfTab(g_pin), tabs().GetIndexOfTab(h_pin),
+       tabs().GetIndexOfTab(f_pin)},
+      nullptr, g_id));
+  ASSERT_TRUE(folder_of(g_id));
+  ASSERT_TRUE(tabs().AddToNewFolder(
+      {tabs().GetIndexOfTab(h_pin), tabs().GetIndexOfTab(f_pin)},
+      folder_of(g_id), h_id));
+  ASSERT_TRUE(folder_of(h_id));
+  ASSERT_TRUE(tabs().AddToNewFolder({tabs().GetIndexOfTab(f_pin)},
+                                    folder_of(h_id), f_id));
+  ASSERT_TRUE(folder_of(f_id));
+  model().SetFolderSpacePinned(folder_of(g_id), true);
+  ASSERT_TRUE(model().IsFolderSpacePinned(folder_of(g_id)));
+  ASSERT_EQ(folder_of(g_id), g_pin->GetParentCollection());
+  ASSERT_EQ(folder_of(g_id), folder_of(h_id)->GetParentCollection());
+  ASSERT_EQ(folder_of(h_id), h_pin->GetParentCollection());
+  ASSERT_EQ(folder_of(h_id), folder_of(f_id)->GetParentCollection());
+  ASSERT_EQ(folder_of(f_id), f_pin->GetParentCollection());
+  ASSERT_EQ(first, model().FindSpaceForTab(f_pin));
+  // The user is on G's own pin: G's move waits until they leave it (Sf21).
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(g_pin));
+  ASSERT_EQ(g_pin, tabs().GetActiveTab());
+  service()->CommitForTesting();
+  ASSERT_TRUE(LedgerRecord(g_sync));
+  ASSERT_TRUE(LedgerRecord(h_sync));
+  ASSERT_TRUE(LedgerRecord(f_sync));
+  ASSERT_EQ(sb::PinsListOf(first.ToString()),
+            LedgerRecord(g_sync)->Get(sb::kFieldParent));
+  ASSERT_EQ(h_sync, LedgerRecord(f_sync)->Get(sb::kFieldParent));
+
+  // The other computer moves G to the second Space and F up into G.
+  sb::State office = service()->ledger_for_testing()->state;
+  const sb::Stamp later{NowMsB11() + 60'000, kOfficeB11};
+  office.records[g_sync].f[sb::kFieldParent] =
+      sb::Field{sb::PinsListOf(second.ToString()), later};
+  std::erase(office.lists[sb::PinsListOf(first.ToString())].order, g_sync);
+  office.lists[sb::PinsListOf(first.ToString())].s = later;
+  office.lists[sb::PinsListOf(second.ToString())].order = {g_sync};
+  office.lists[sb::PinsListOf(second.ToString())].s = later;
+  office.records[f_sync].f[sb::kFieldParent] = sb::Field{g_sync, later};
+  std::erase(office.lists[h_sync].order, f_sync);
+  office.lists[h_sync].s = later;
+  office.lists[g_sync].order.push_back(f_sync);
+  office.lists[g_sync].s = later;
+  ASSERT_NO_FATAL_FAILURE(WriteOffice(office, 1));
+  ASSERT_NO_FATAL_FAILURE(Scan());
+
+  // G waits for the user; F waits for G, where it was.
+  ASSERT_EQ(g_pin, tabs().GetActiveTab());
+  ASSERT_TRUE(folder_of(g_id));
+  ASSERT_TRUE(folder_of(h_id));
+  ASSERT_TRUE(folder_of(f_id));
+  ASSERT_EQ(first, model().FindSpaceForTab(f_pin))
+      << "F went to the other Space before the folder it goes into";
+  ASSERT_EQ(folder_of(h_id), folder_of(f_id)->GetParentCollection())
+      << "F went into G while G is in the first Space";
+  ASSERT_EQ(first, model().FindSpaceForTab(g_pin));
+
+  // The user leaves G's pin: G moves, then F moves into it.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(elsewhere));
+  ASSERT_EQ(elsewhere, tabs().GetActiveTab());
+  const auto f_in_g = [&] {
+    const tabs::FolderTabCollection* const f = folder_of(f_id);
+    const tabs::FolderTabCollection* const g = folder_of(g_id);
+    return f && g && f->GetParentCollection() == g;
+  };
+  for (int i = 0; i < 3 && !f_in_g(); ++i) {
+    ASSERT_NO_FATAL_FAILURE(Scan());
+  }
+
+  tabs::FolderTabCollection* const g_now = folder_of(g_id);
+  tabs::FolderTabCollection* const h_now = folder_of(h_id);
+  tabs::FolderTabCollection* const f_now = folder_of(f_id);
+  ASSERT_TRUE(g_now) << "G is gone";
+  ASSERT_TRUE(h_now) << "H is gone";
+  ASSERT_TRUE(f_now) << "F is gone";
+  EXPECT_EQ(g_now, f_now->GetParentCollection()) << "F is not in G";
+  EXPECT_EQ(g_now, h_now->GetParentCollection());
+  EXPECT_EQ(g_now, g_pin->GetParentCollection());
+  EXPECT_EQ(h_now, h_pin->GetParentCollection());
+  EXPECT_EQ(f_now, f_pin->GetParentCollection());
+  ASSERT_TRUE(g_now->GetParentCollection());
+  EXPECT_EQ(tabs::TabCollection::Type::UNPINNED,
+            g_now->GetParentCollection()->type());
+  for (tabs::TabInterface* const pin : {g_pin, h_pin, f_pin}) {
+    EXPECT_EQ(second, model().FindSpaceForTab(pin));
+    EXPECT_TRUE(model().IsSpacePinned(pin));
+  }
+  EXPECT_TRUE(model().IsFolderSpacePinned(g_now));
+  const sb::LocalView view = sb::BuildLocalView(browser()->GetProfile(), {});
+  ASSERT_TRUE(view.items.contains(g_sync));
+  ASSERT_TRUE(view.items.contains(h_sync));
+  ASSERT_TRUE(view.items.contains(f_sync));
+  EXPECT_EQ(sb::PinsListOf(second.ToString()),
+            view.items.at(g_sync).fields.at(sb::kFieldParent));
+  EXPECT_EQ(g_sync, view.items.at(h_sync).fields.at(sb::kFieldParent));
+  EXPECT_EQ(g_sync, view.items.at(f_sync).fields.at(sb::kFieldParent));
+}
+
+}  // namespace
