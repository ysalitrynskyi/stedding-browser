+// windows G10 (BACKLOG S-323, GitHub issue 43): whatever On startup says, a
+// launch brings the sidebar back -- the essentials, each Space's pins, and
+// its folders with their tabs -- and the choice decides the loose tabs alone,
+// as in Arc. With the New Tab page the loose tabs stay closed and a New Tab
+// page is the tab on screen; with specific pages those pages open instead.
+// The essentials come back once: Chromium reopens its own list of pinned
+// tabs for these two choices, which would have doubled them.
+class StartupKeepsTheSidebarTest : public RestoreTest {
+ public:
+  // A launch with no address of its own, as a person's is: the fixture's
+  // about:blank would take the place of the New Tab page or the pages.
+  StartupKeepsTheSidebarTest() { set_open_about_blank_on_browser_launch(false); }
+
+ protected:
+  void SetUpOnMainThread() override {
+    RestoreTest::SetUpOnMainThread();
+    if (browser()) {
+      SessionStartupPref::SetStartupPref(browser()->GetProfile(), Choice());
+    }
+  }
+
+  virtual SessionStartupPref Choice() {
+    return SessionStartupPref(SessionStartupPref::DEFAULT);
+  }
+
+  // How many tabs of the window show `host`.
+  int Count(const std::string& host) {
+    int count = 0;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      content::WebContents* const contents = tabs()->GetWebContentsAt(i);
+      const content::NavigationEntry* const entry =
+          contents->GetController().GetLastCommittedEntry();
+      const GURL url = entry ? entry->GetURL() : contents->GetVisibleURL();
+      count += url.host() == host;
+    }
+    return count;
+  }
+
+  // The run before the launch: an essential; in Home a loose tab and a folder
+  // holding one; in Work a Space pin and a loose tab, Work on screen.
+  void BuildTheSidebar() {
+    spaces::SpaceModel* const m = model();
+    ASSERT_TRUE(m);
+    m->SetSpaceName(m->active_id(), "Home");
+    const SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("essential.test")));
+    tabs()->SetTabPinned(0, true);
+    Open("loose.test");
+    tabs::TabInterface* const filed = Open("filed.test");
+    tabs::FolderTabCollection* const folder =
+        tabs()->AddToNewFolder({Index(filed)});
+    ASSERT_TRUE(folder);
+    folder->SetTitle("Kept");
+    ASSERT_TRUE(m->SetActiveSpace(work));
+    tabs::TabInterface* const pin = Open("pin.test");
+    m->SetSpacePinned(pin, true);
+    Open("loose-work.test");
+  }
+
+  void ExpectTheSidebarWithoutTheLooseTabs() {
+    ASSERT_EQ(1u, GetAllBrowserWindowInterfaces().size());
+    spaces::SpaceModel* const m = model();
+    ASSERT_TRUE(m);
+    ASSERT_EQ(2u, m->size());
+    const SpaceId home = m->spaces()[0]->id();
+    const SpaceId work = m->spaces()[1]->id();
+    EXPECT_EQ("Home", m->spaces()[0]->name());
+
+    EXPECT_EQ(1, Count("essential.test")) << "the essential came back twice";
+    tabs::TabInterface* const essential = Find("essential.test");
+    ASSERT_TRUE(essential);
+    EXPECT_TRUE(essential->IsPinned());
+
+    tabs::TabInterface* const filed = Find("filed.test");
+    ASSERT_TRUE(filed) << "a folder's tab stayed behind";
+    const tabs::FolderTabCollection* const folder = FolderOf(filed);
+    ASSERT_TRUE(folder);
+    EXPECT_EQ("Kept", folder->title());
+    EXPECT_EQ(home, m->SpaceForTab(filed));
+
+    tabs::TabInterface* const pin = Find("pin.test");
+    ASSERT_TRUE(pin) << "a Space's pin stayed behind";
+    EXPECT_TRUE(m->IsSpacePinned(pin));
+    EXPECT_EQ(work, m->SpaceForTab(pin));
+
+    EXPECT_EQ(0, Count("loose.test")) << "a loose tab came back";
+    EXPECT_EQ(0, Count("loose-work.test")) << "a loose tab came back";
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StartupKeepsTheSidebarTest,
+                       PRE_TheNewTabPageKeepsTheSidebar) {
+  BuildTheSidebar();
+}
+
+IN_PROC_BROWSER_TEST_F(StartupKeepsTheSidebarTest,
+                       TheNewTabPageKeepsTheSidebar) {
+  ExpectTheSidebarWithoutTheLooseTabs();
+  const GURL shown = tabs()->GetActiveWebContents()->GetVisibleURL();
+  EXPECT_TRUE(shown == GURL(chrome::kChromeUINewTabURL) ||
+              shown.host() == chrome::kChromeUINewTabHost ||
+              shown.host() == chrome::kChromeUINewTabPageThirdPartyHost)
+      << "the tab on screen is " << shown;
+  EXPECT_EQ(model()->spaces()[1]->id(), model()->active_id())
+      << "the Space on screen at the quit is on screen again";
+  EXPECT_EQ(model()->active_id(),
+            model()->SpaceForTab(tabs()->GetActiveTab()));
+}
+
+class StartupPagesKeepTheSidebarTest : public StartupKeepsTheSidebarTest {
+ protected:
+  SessionStartupPref Choice() override {
+    SessionStartupPref pages(SessionStartupPref::URLS);
+    pages.urls = {GURL(chrome::kChromeUIVersionURL)};
+    return pages;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(StartupPagesKeepTheSidebarTest,
+                       PRE_SpecificPagesKeepTheSidebar) {
+  BuildTheSidebar();
+}
+
+IN_PROC_BROWSER_TEST_F(StartupPagesKeepTheSidebarTest,
+                       SpecificPagesKeepTheSidebar) {
+  ExpectTheSidebarWithoutTheLooseTabs();
+  EXPECT_EQ(GURL(chrome::kChromeUIVersionURL),
+            tabs()->GetActiveWebContents()->GetVisibleURL());
+  EXPECT_EQ(1, Count(chrome::kChromeUIVersionHost));
+}
