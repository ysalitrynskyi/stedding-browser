+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_ids.h"
+
+#include <memory>
+#include <string_view>
+#include <variant>
+
+#include "base/strings/string_util.h"
+#include "base/token.h"
+#include "base/uuid.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/stedding/tab_parents.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_collection_types.h"
+
+namespace spaces {
+
+std::string TokenOf(const std::string& id) {
+  constexpr std::string_view kPrefix = "tab:";
+  if (!base::StartsWith(id, kPrefix)) {
+    return std::string();
+  }
+  std::string token = id.substr(kPrefix.size());
+  return base::Uuid::ParseLowercase(token).is_valid() ? token : std::string();
+}
+
+std::optional<tabs::FolderId> FolderIdOf(const std::string& id) {
+  constexpr std::string_view kPrefix = "folder:";
+  if (!base::StartsWith(id, kPrefix)) {
+    return std::nullopt;
+  }
+  const std::optional<base::Token> token =
+      base::Token::FromString(std::string_view(id).substr(kPrefix.size()));
+  if (!token) {
+    return std::nullopt;
+  }
+  return tabs::FolderId::FromRawToken(*token);
+}
+
+std::string TabSyncId(const std::string& token) {
+  return "tab:" + token;
+}
+
+std::string FolderSyncId(const tabs::FolderId& id) {
+  return "folder:" + id.ToString();
+}
+
+tabs::FolderTabCollection* FindFolderById(const tabs::TabCollection& collection,
+                                          const tabs::FolderId& id) {
+  for (const tabs::Child& child : collection.GetChildren()) {
+    const std::unique_ptr<tabs::TabCollection>* const sub =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (!sub || !*sub) {
+      continue;
+    }
+    tabs::TabCollection* const node = sub->get();
+    if (node->type() == tabs::TabCollection::Type::FOLDER) {
+      auto* const folder = static_cast<tabs::FolderTabCollection*>(node);
+      if (folder->id() == id) {
+        return folder;
+      }
+    }
+    if (tabs::FolderTabCollection* const found = FindFolderById(*node, id)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+void AddFolderIds(const tabs::TabCollection& collection,
+                  std::set<std::string>* ids) {
+  for (const tabs::Child& child : collection.GetChildren()) {
+    const std::unique_ptr<tabs::TabCollection>* const sub =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (!sub || !*sub) {
+      continue;
+    }
+    const tabs::TabCollection* const node = sub->get();
+    if (node->type() == tabs::TabCollection::Type::FOLDER) {
+      ids->insert(FolderSyncId(
+          static_cast<const tabs::FolderTabCollection*>(node)->id()));
+    }
+    AddFolderIds(*node, ids);
+  }
+}
+
+std::set<std::string> CollectPresentIds(Profile* profile) {
+  std::set<std::string> ids;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        const TabStripModel* const strip =
+            window->GetProfile() == profile ? window->GetTabStripModel()
+                                            : nullptr;
+        if (!strip) {
+          return true;
+        }
+        for (int i = 0; i < strip->count(); ++i) {
+          if (const std::string token =
+                  stedding::TabToken(strip->GetWebContentsAt(i));
+              !token.empty()) {
+            ids.insert(TabSyncId(token));
+          }
+        }
+        if (strip->Root()) {
+          AddFolderIds(*strip->Root(), &ids);
+        }
+        return true;
+      });
+  return ids;
+}
+
+}  // namespace spaces
