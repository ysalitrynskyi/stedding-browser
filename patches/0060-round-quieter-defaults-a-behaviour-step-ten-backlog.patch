+void WelcomeHandler::HandleGetBehaviour(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  const PrefService* const pref_service =
+      Profile::FromWebUI(web_ui())->GetPrefs();
+  base::DictValue behaviour;
+  behaviour.Set("archiveHours",
+                pref_service->GetInteger(prefs::kArchiveIdleHours));
+  behaviour.Set("closedForm",
+                pref_service->GetInteger(prefs::kSidebarClosedForm));
+  behaviour.Set("sleepMinutes",
+                pref_service->GetInteger(prefs::kSpaceSleepMinutes));
+  ResolveJavascriptCallback(args[0], behaviour);
+}
+
+void WelcomeHandler::HandleSetBehaviour(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  const std::string* const name = args[0].GetIfString();
+  const std::optional<int> value = args[1].GetIfInt();
+  if (!name || !value) {
+    return;
+  }
+  // The values Settings › Stedding, the command bar and the step offer, and
+  // nothing else: auto-archive (archive A6), the closed sidebar (sidebar
+  // Y19) and the Space sleep timer (tabs R6).
+  const char* pref = nullptr;
+  bool offered = false;
+  if (*name == "archiveHours") {
+    pref = prefs::kArchiveIdleHours;
+    offered = std::ranges::contains(prefs::kArchiveIdleHoursChoices, *value);
+  } else if (*name == "closedForm") {
+    pref = prefs::kSidebarClosedForm;
+    offered = std::ranges::contains(kClosedForms, *value);
+  } else if (*name == "sleepMinutes") {
+    pref = prefs::kSpaceSleepMinutes;
+    offered = std::ranges::contains(prefs::kSpaceSleepMinutesChoices, *value);
+  }
+  if (!pref || !offered) {
+    return;
+  }
+  // The archiver, the sidebar and the Space model watch these preferences,
+  // so the choice takes effect now, as the appearance step's do.
+  Profile::FromWebUI(web_ui())->GetPrefs()->SetInteger(pref, *value);
+}
