+class AppJarTest : public stedding::WebAppBrowserTest {
+ protected:
+  void SetUp() override {
+    embedded_https_test_server().RegisterRequestMonitor(
+        base::BindRepeating(&AppJarTest::OnRequest, base::Unretained(this)));
+    stedding::WebAppBrowserTest::SetUp();
+  }
+
+  void TearDownOnMainThread() override {
+    // The model belongs to the window, which closes before the fixture goes.
+    model_ = nullptr;
+    app_window_ = nullptr;
+    stedding::WebAppBrowserTest::TearDownOnMainThread();
+  }
+
+  // Home, the Space on screen, shares the profile's jar; Work has a session
+  // of its own. Each jar gets its cookie for a.test, kept a day so that a
+  // restart keeps it too.
+  void SetUpSpaces() {
+    model_ = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model_);
+    home_ = model_->active_id();
+    work_ = model_->AddSpace("Work", SK_ColorBLUE)->id();
+    model_->SetSpaceIsolated(work_, true);
+    ASSERT_TRUE(model_->SpaceIsIsolated(work_));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), Url("/set-cookie?jar=shared;max-age=86400")));
+    ASSERT_TRUE(model_->SetActiveSpace(work_));
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("/set-cookie?jar=work;max-age=86400"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    ASSERT_EQ(work_, model_->FindSpaceForTab(tabs()->GetActiveTab()));
+    ASSERT_TRUE(model_->SetActiveSpace(home_));
+  }
+
+  GURL Url(const std::string& path) {
+    return embedded_https_test_server().GetURL("a.test", path);
+  }
+  // A "do it yourself" app: a page with no manifest, its scope the host.
+  GURL AppUrl() { return Url("/title1.html"); }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  std::string WorkJar() {
+    const spaces::RegistryEntry* const entry = model_->registry()->Find(work_);
+    return entry ? entry->profile_id : std::string();
+  }
+
+  // A tab of `space` at `url`, loaded, its web-app checks done.
+  content::WebContents* OpenIn(const spaces::SpaceId& space, const GURL& url) {
+    EXPECT_TRUE(model_->SetActiveSpace(space));
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    content::WebContents* const contents = tabs()->GetActiveWebContents();
+    EXPECT_EQ(space, model_->FindSpaceForTab(tabs()->GetActiveTab()));
+    EXPECT_TRUE(web_app::test::WebAppPageWaiter(contents)
+                    .ExpectUrl(url)
+                    .ManifestOrLoadedNoManifest()
+                    .WaitAndFlushCommands());
+    return contents;
+  }
+
+  // Makes the app from a tab of `space`, as the menus do, and brings Home
+  // back on screen.
+  webapps::AppId MakeAppIn(const spaces::SpaceId& space) {
+    return MakeAppAt(space, AppUrl());
+  }
+  webapps::AppId MakeAppAt(const spaces::SpaceId& space, const GURL& url) {
+    OpenIn(space, url);
+    const webapps::AppId app_id =
+        web_app::InstallWebAppFromPage(browser(), url);
+    EXPECT_TRUE(model_->SetActiveSpace(home_));
+    return app_id;
+  }
+
+  // The question the window shows while `ask` runs, by its text; empty when
+  // none was shown. `accept` answers it.
+  std::u16string QuestionDuring(base::OnceClosure ask, bool accept) {
+    views::Widget* question = nullptr;
+    views::AnyWidgetObserver questions(views::test::AnyWidgetTestPasskey{});
+    questions.set_shown_callback(
+        base::BindLambdaForTesting([&](views::Widget* widget) {
+          if (widget->widget_delegate() &&
+              widget->widget_delegate()->AsDialogDelegate()) {
+            question = widget;
+          }
+        }));
+    std::move(ask).Run();
+    if (!base::test::RunUntil([&]() { return question != nullptr; })) {
+      return std::u16string();
+    }
+    const std::u16string text = TextUnder(question->GetRootView());
+    views::DialogDelegate* const delegate =
+        question->widget_delegate()->AsDialogDelegate();
+    if (accept) {
+      delegate->AcceptDialog();
+    } else {
+      delegate->CancelDialog();
+    }
+    return text;
+  }
+
+  // The app's page, launched at `path` in a window of its own, which
+  // `app_window_` holds after.
+  content::WebContents* Launch(const webapps::AppId& app_id,
+                               const std::string& path) {
+    BrowserWindowInterface* const window =
+        web_app::LaunchWebAppToURL(profile(), app_id, Url(path));
+    app_window_ = window;
+    EXPECT_TRUE(window);
+    if (!window) {
+      return nullptr;
+    }
+    EXPECT_TRUE(web_app::AppBrowserController::IsForWebApp(window, app_id));
+    content::WebContents* const page =
+        window->GetTabStripModel()->GetActiveWebContents();
+    EXPECT_TRUE(content::WaitForLoadStop(page));
+    return page;
+  }
+
+  static std::string JarOf(content::WebContents* contents) {
+    return spaces::StoragePartitionConfigForWebContents(contents)
+        .partition_name();
+  }
+
+  static std::string CookieOf(content::WebContents* contents) {
+    return content::EvalJs(contents, "document.cookie").ExtractString();
+  }
+
+  // The cookies for a.test in the jar `partition` holds.
+  std::vector<std::string> CookiesIn(
+      const content::StoragePartitionConfig& partition) {
+    base::test::TestFuture<const std::vector<net::CanonicalCookie>&> cookies;
+    profile()
+        ->GetStoragePartition(partition)
+        ->GetCookieManagerForBrowserProcess()
+        ->GetAllCookies(cookies.GetCallback());
+    std::vector<std::string> found;
+    for (const net::CanonicalCookie& cookie : cookies.Get()) {
+      if (cookie.Domain() == "a.test") {
+        found.push_back(cookie.Name() + "=" + cookie.Value());
+      }
+    }
+    return found;
+  }
+
+  // The app windows open now.
+  int AppWindowCount() {
+    int count = 0;
+    for (BrowserWindowInterface* const window :
+         GetAllBrowserWindowInterfaces()) {
+      if (web_app::AppBrowserController::IsWebApp(window)) {
+        ++count;
+      }
+    }
+    return count;
+  }
+
+  // The server's thread.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    const std::string path = request.GetURL().PathForRequest();
+    base::AutoLock lock(lock_);
+    if (cookies_.contains(path)) {
+      return;
+    }
+    const auto cookie = request.headers.find("Cookie");
+    cookies_[path] = cookie == request.headers.end() ? "" : cookie->second;
+  }
+
+  // The Cookie header of the first request for `path` (with its query).
+  std::string FirstCookieFor(const std::string& path) {
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      base::AutoLock lock(lock_);
+      return cookies_.contains(path);
+    })) << path;
+    base::AutoLock lock(lock_);
+    return cookies_[path];
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  raw_ptr<BrowserWindowInterface, AcrossTasksDanglingUntriaged> app_window_ =
+      nullptr;
+  spaces::SpaceId home_ = spaces::SpaceId::GenerateNew();
+  spaces::SpaceId work_ = spaces::SpaceId::GenerateNew();
+
+  base::Lock lock_;
+  std::map<std::string, std::string> cookies_ GUARDED_BY(lock_);
+
+  // A relaunch a test asks for (chrome::AttemptRestart) ends the run without
+  // starting another browser; the test's next step is the next start.
+  std::optional<upgrade_util::ScopedRelaunchChromeBrowserOverride> relaunch_;
+};
+
+// web apps Wa11: an app made in a Space with an Independent session records
+// that Space's jar, and its page opens there whenever it is launched: the
+// first request already carries the Space's cookie.
+IN_PROC_BROWSER_TEST_F(AppJarTest, AnAppMadeInAnIsolatedSpaceKeepsItsSession) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  EXPECT_EQ(WorkJar(),
+            stedding::RecordedAppJar(*profile()->GetPrefs(), app_id));
+
+  content::WebContents* const page = Launch(app_id, "/title1.html?launch");
+  ASSERT_TRUE(page);
+  EXPECT_EQ(WorkJar(), JarOf(page));
+  EXPECT_EQ("jar=work", FirstCookieFor("/title1.html?launch"));
+  EXPECT_EQ("jar=work", CookieOf(page));
+}
+
+// web apps Wa11: one made in a Space that shares the profile's jar records
+// none and opens in the shared jar, as Chromium's apps do.
+IN_PROC_BROWSER_TEST_F(AppJarTest, AnAppMadeInASharedSpaceUsesTheSharedJar) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(home_);
+  ASSERT_FALSE(app_id.empty());
+  EXPECT_EQ("", stedding::RecordedAppJar(*profile()->GetPrefs(), app_id));
+
+  content::WebContents* const page = Launch(app_id, "/title1.html?launch");
+  ASSERT_TRUE(page);
+  EXPECT_EQ("", JarOf(page));
+  EXPECT_EQ("jar=shared", FirstCookieFor("/title1.html?launch"));
+}
