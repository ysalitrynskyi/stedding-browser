+TEST(ChromiumFamilyImporterTest, FindsEachBrowserOfTheFamily) {
+  base::ScopedTempDir home;
+  ASSERT_TRUE(home.CreateUniqueTempDir());
+#if BUILDFLAG(IS_WIN)
+  base::ScopedPathOverride path_override(base::DIR_LOCAL_APP_DATA, home.GetPath());
+  const base::FilePath root = home.GetPath();
+  const struct {
+    raw_ptr<const ChromiumFamilySource> source;
+    std::vector<std::string> parts;
+  } kPlaces[] = {
+      {&kChromeSource, {"Google", "Chrome", "User Data"}},
+      {&kEdgeSource, {"Microsoft", "Edge", "User Data"}},
+      {&kBraveSource, {"BraveSoftware", "Brave-Browser", "User Data"}},
+      {&kVivaldiSource, {"Vivaldi", "User Data"}},
+  };
+#elif BUILDFLAG(IS_MAC)
+  base::ScopedPathOverride path_override(base::DIR_HOME, home.GetPath());
+  const base::FilePath root = home.GetPath()
+                                  .AppendASCII("Library")
+                                  .AppendASCII("Application Support");
+  const struct {
+    raw_ptr<const ChromiumFamilySource> source;
+    std::vector<std::string> parts;
+  } kPlaces[] = {
+      {&kChromeSource, {"Google", "Chrome"}},
+      {&kEdgeSource, {"Microsoft Edge"}},
+      {&kBraveSource, {"BraveSoftware", "Brave-Browser"}},
+      {&kVivaldiSource, {"Vivaldi"}},
+  };
+#else
+  GTEST_SKIP() << "the family is looked for on the Mac and Windows";
+#endif
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
+  for (const auto& place : kPlaces) {
+    SCOPED_TRACE(place.source->key);
+    EXPECT_EQ(place.source.get(), FindChromiumFamilySource(place.source->key));
+    EXPECT_TRUE(FindUserDataDir(*place.source).empty());
+    base::FilePath dir = root;
+    for (const std::string& part : place.parts) {
+      dir = dir.AppendASCII(part);
+    }
