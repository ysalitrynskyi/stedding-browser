+  views::Widget* const widget = browser_view()->GetWidget();
+  TabStripModel* const strip = tab_strip_model();
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  // The essentials' drawn cards per row, top to bottom.
+  const auto rows = [&]() {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+    views::test::RunScheduledLayout(widget);
+    std::map<int, std::vector<gfx::Rect>> by_y;
+    for (int i = 0; i < strip->count(); ++i) {
+      if (!strip->IsTabPinned(i)) {
+        continue;
+      }
+      TabView* const card = stedding::test::FindDrawnRow(
+          widget->GetRootView(), strip->GetTabAtIndex(i));
+      if (!card) {
+        ADD_FAILURE() << "an essential has no drawn card";
+        continue;
+      }
+      by_y[views::View::ConvertRectToTarget(card, region(),
+                                            card->GetLocalBounds())
+               .y()]
+          .push_back(views::View::ConvertRectToTarget(
+              card, region(), card->GetLocalBounds()));
+    }
+    std::vector<size_t> counts;
+    for (auto& [y, row] : by_y) {
+      for (const gfx::Rect& card : row) {
+        EXPECT_EQ(by_y.begin()->second.front().width(), card.width())
+            << "a card of another width";
+      }
+      counts.push_back(row.size());
+    }
+    return counts;
+  };
+  int essentials = 0;
+  const auto essentials_to = [&](int count) {
+    while (essentials < count) {
+      AppendPinnedTab();
+      ++essentials;
+    }
+  };
+  EXPECT_EQ(0, prefs->GetInteger(stedding::prefs::kSidebarEssentialsPerRow));
+  essentials_to(2);
+  prefs->SetInteger(stedding::prefs::kSidebarEssentialsPerRow, 3);
+  EXPECT_EQ(std::vector<size_t>({2}), rows()) << "two share the row";
+  essentials_to(5);
+  EXPECT_EQ(std::vector<size_t>({3, 2}), rows()) << "up to 3";
+  prefs->SetInteger(stedding::prefs::kSidebarEssentialsPerRow, 4);
+  EXPECT_EQ(std::vector<size_t>({4, 1}), rows()) << "up to 4";
+  prefs->SetInteger(stedding::prefs::kSidebarEssentialsPerRow, 0);
+  EXPECT_EQ(std::vector<size_t>({3, 2}), rows()) << "Automatic: Y33's rule";
+  prefs->SetInteger(stedding::prefs::kSidebarEssentialsPerRow, 3);
+  essentials_to(6);
+  EXPECT_EQ(std::vector<size_t>({3, 3}), rows());
+  prefs->ClearPref(stedding::prefs::kSidebarEssentialsPerRow);
+}
