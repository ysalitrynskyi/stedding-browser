+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return std::ranges::any_of(view->GetTabGroupData().tab_data,
+                                 [&](const tabs::TabGroupTabData& data) {
+                                   return data.last_committed_url == url;
+                                 });
+    })) << "the group's view never heard of the load";
+    EXPECT_TRUE(drawn(g1));
+    EXPECT_FALSE(drawn(g2)) << "a load in the group drew Work's tab in One";
+  }
+
+  {
+    SCOPED_TRACE("the group collapsed and expanded from its header");
+    ASSERT_NO_FATAL_FAILURE(start());
+    TabGroupView* const view = stedding::test::FindDrawnGroup(root, group);
+    ASSERT_TRUE(view);
+    const gfx::Point header =
+        view->group_header()->GetBoundsInScreen().CenterPoint();
+    stedding::test::ClickLeftMouse(window, header);
+    ASSERT_TRUE(tab_strip_model()->IsGroupCollapsed(group))
+        << "a click on the header did not collapse the group";
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(window));
+    EXPECT_FALSE(drawn(g1)) << "the collapsed group kept its row";
+    stedding::test::ClickLeftMouse(window, header);
+    ASSERT_FALSE(tab_strip_model()->IsGroupCollapsed(group))
+        << "a second click did not expand the group";
+    EXPECT_TRUE(drawn(g1));
+    EXPECT_FALSE(drawn(g2)) << "expanding the group drew Work's tab in One";
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(window));
+  }
+
+  {
+    SCOPED_TRACE("the window goes inactive and back");
+    ASSERT_NO_FATAL_FAILURE(start());
+    // Inactive, then painted as active whatever the machine's other windows
+    // do: at least one change of how the window paints, which the group's view
+    // hears, as when another app takes the keyboard and gives it back.
+    window->OnNativeWidgetActivationChanged(false);
+    std::unique_ptr<views::Widget::PaintAsActiveLock> active =
+        window->LockPaintAsActive();
+    EXPECT_FALSE(drawn(g2))
+        << "a change of the window's activation drew Work's tab in One";
+    active.reset();
+    window->OnNativeWidgetActivationChanged(true);
+  }
+}
