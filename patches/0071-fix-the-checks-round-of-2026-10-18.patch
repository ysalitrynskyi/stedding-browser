+// What macOS draws in `title_bar` -- its full-screen title bar window --
+// that is no taller than a point and runs across most of it: a visible
+// separator view, or a visible layer that paints, outside `own`, the layer
+// of the content Chromium draws there. Described for a failure message.
+std::vector<std::string> TitleBarHairlines(NSWindow* title_bar, CALayer* own) {
+  std::vector<std::string> found;
+  NSView* const frame_view = title_bar.contentView.superview;
+  if (!frame_view) {
+    return found;
+  }
+  const CGFloat width = NSWidth(title_bar.frame);
+  const auto thin_and_wide = [width](CGRect rect) {
+    return rect.size.height > 0 && rect.size.height <= 1.0 &&
+           rect.size.width >= 0.9 * width;
+  };
+  Class const separator_class = NSClassFromString(@"NSTitlebarSeparatorView");
+  std::vector<NSView*> views = {frame_view};
+  while (!views.empty()) {
+    NSView* const view = views.back();
+    views.pop_back();
+    if (view.hidden || view.alphaValue <= 0) {
+      continue;
+    }
+    if (separator_class && [view isKindOfClass:separator_class] &&
+        thin_and_wide([view convertRect:view.bounds toView:nil])) {
+      found.push_back(base::SysNSStringToUTF8(
+          [NSString stringWithFormat:@"%@ at %@", NSStringFromClass([view class]),
+                                     NSStringFromRect([view convertRect:view.bounds
+                                                                 toView:nil])]));
+    }
+    for (NSView* const child in view.subviews) {
+      views.push_back(child);
+    }
+  }
+  CALayer* const root = frame_view.layer;
+  std::vector<CALayer*> layers;
+  if (root) {
+    layers.push_back(root);
+  }
+  while (!layers.empty()) {
+    CALayer* const layer = layers.back();
+    layers.pop_back();
+    if (layer == own || layer.hidden || layer.opacity <= 0) {
+      continue;
+    }
+    const CGRect rect = [layer convertRect:layer.bounds toLayer:root];
+    const bool paints = layer.backgroundColor || layer.contents ||
+                        layer.compositingFilter;
+    if (paints && thin_and_wide(rect)) {
+      // The view that owns the layer, and the views it sits in.
+      NSMutableString* const owner = [NSMutableString string];
+      CALayer* held = layer;
+      while (held && ![held.delegate isKindOfClass:[NSView class]]) {
+        held = held.superlayer;
+      }
+      for (id holder = held.delegate; [holder isKindOfClass:[NSView class]];
+           holder = [holder superview]) {
+        [owner appendFormat:@" < %@", NSStringFromClass([holder class])];
+      }
+      found.push_back(base::SysNSStringToUTF8([NSString
+          stringWithFormat:@"%@ %@ at %@%@%@", NSStringFromClass([layer class]),
+                           layer.name ?: @"", NSStringFromRect(NSRectFromCGRect(rect)),
+                           layer.compositingFilter ? @" (blended)" : @"", owner]));
+    }
+    for (CALayer* const sublayer in layer.sublayers) {
+      layers.push_back(sublayer);
+    }
+  }
+  return found;
+}
