+constexpr size_t kMaxFieldLength = 512;
+constexpr size_t kMaxNameLength = 255;
+constexpr char kKindWebDav[] = "webdav";
+constexpr char kKindS3[] = "s3";
+
+std::string Trimmed(const base::DictValue& form, std::string_view key) {
+  const std::string* const value = form.FindString(key);
+  if (!value) {
+    return std::string();
+  }
+  std::string trimmed;
+  base::TrimWhitespaceASCII(*value, base::TRIM_ALL, &trimmed);
+  return trimmed;
+}
+
+std::string Exact(const base::DictValue& form, std::string_view key) {
+  const std::string* const value = form.FindString(key);
+  return value ? *value : std::string();
+}
+
+bool IsPrintableAscii(std::string_view text) {
+  return std::ranges::all_of(
+      text, [](char c) { return c > 0x20 && c < 0x7f; });
+}
+
+bool HasControl(std::string_view text) {
+  return std::ranges::any_of(text, [](char c) {
+    return static_cast<unsigned char>(c) < 0x20 || c == 0x7f;
+  });
+}
+
+// S3's rules for a bucket: 3 to 63 lower-case letters, digits, dots and
+// hyphens, beginning and ending in a letter or digit.
+bool IsBucketName(std::string_view name) {
+  if (name.size() < 3 || name.size() > 63 ||
+      !base::IsAsciiAlphaNumeric(name.front()) ||
+      !base::IsAsciiAlphaNumeric(name.back())) {
+    return false;
+  }
+  return std::ranges::all_of(name, [](char c) {
+    return base::IsAsciiLower(c) || base::IsAsciiDigit(c) || c == '.' ||
+           c == '-';
+  });
+}
+
+bool IsRegionName(std::string_view name) {
+  return !name.empty() && name.size() <= 64 &&
+         std::ranges::all_of(name, [](char c) {
+           return base::IsAsciiAlphaNumeric(c) || c == '-' || c == '_';
+         });
+}
+
+// Slashes at the ends go; `.`, `..`, a backslash, a control character or a
+// question mark make it no path.
+std::optional<std::string> CleanPath(std::string_view typed) {
+  std::string_view path = base::TrimString(typed, "/", base::TRIM_ALL);
+  if (path.size() > kMaxFieldLength || HasControl(path) ||
+      path.find('\\') != std::string_view::npos ||
+      path.find('?') != std::string_view::npos ||
+      path.find('#') != std::string_view::npos) {
+    return std::nullopt;
+  }
+  if (path.empty()) {
+    return std::string();
+  }
+  for (std::string_view segment : base::SplitStringPiece(
+           path, "/", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+    if (segment.empty() || segment == "." || segment == "..") {
+      return std::nullopt;
+    }
+  }
+  return std::string(path);
+}
+
+std::string HostAndPort(const GURL& url) {
+  std::string host = url.GetHost();
+  if (url.has_port()) {
+    host += ":" + url.GetPort();
+  }
+  return host;
+}
+
+// The local part of an element's tag: a server picks its own prefixes.
+std::string LocalName(const base::Value& element) {
+  std::string tag;
+  if (!data_decoder::GetXmlElementTagName(element, &tag)) {
+    return std::string();
+  }
+  const size_t colon = tag.rfind(':');
+  return colon == std::string::npos ? tag : tag.substr(colon + 1);
+}
+
+const base::Value* Child(const base::Value& element, std::string_view local) {
+  const base::ListValue* const children =
+      data_decoder::GetXmlElementChildren(element);
+  if (!children) {
+    return nullptr;
+  }
+  for (const base::Value& child : *children) {
+    if (LocalName(child) == local) {
+      return &child;
+    }
+  }
+  return nullptr;
+}
+
+std::string ChildText(const base::Value& element, std::string_view local) {
+  const base::Value* const child = Child(element, local);
+  std::string text;
+  if (child) {
+    data_decoder::GetXmlElementText(*child, &text);
+  }
+  return text;
+}
+
+std::string VersionOf(std::string etag,
+                      const std::string& modified,
+                      int64_t size) {
+  std::string tag = VersionOfETag(std::move(etag));
+  if (!tag.empty()) {
+    return tag;
+  }
+  if (modified.empty()) {
+    return std::string();
+  }
+  return base::StrCat({modified, "|", base::NumberToString(size)});
+}
+
+}  // namespace
+
+std::string VersionOfETag(std::string etag) {
+  // A weak validator is the same validator here.
+  if (base::StartsWith(etag, "W/")) {
+    etag.erase(0, 2);
+  }
+  std::string trimmed;
+  base::TrimString(etag, "\"", &trimmed);
+  return trimmed;
+}
+
+std::string_view PlaceKindName(PlaceKind kind) {
+  return kind == PlaceKind::kS3 ? kKindS3 : kKindWebDav;
+}
