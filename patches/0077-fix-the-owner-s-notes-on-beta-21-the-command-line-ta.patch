+// motion O8: a popup hidden while the location bar moved opens at the field,
+// at the field's width, when it opens right after the change, before its
+// deferred update has had the time to run: after a collapse, an expand and a
+// resize of the window, and after a move of the window.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest,
+                       TheOmniboxDropdownOpensAtTheFieldAfterTheWindowChanges) {
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(2));
+  const auto expect_aligned = [&]() {
+    views::Widget* const dropdown = Dropdown();
+    ASSERT_TRUE(dropdown);
+    EXPECT_TRUE(AlignedToTheField(dropdown)) << Describe(dropdown);
+    const int content_width =
+        location_bar()->GetBoundsInScreen().width() +
+        RoundedOmniboxResultsFrame::GetLocationBarAlignmentInsets().width();
+    EXPECT_EQ(content_width, DropdownPageWidth(content_width))
+        << "the dropdown's page is laid out at another width than the field's";
+  };
+  for (const bool collapse : {true, false}) {
+    vertical_tab_strip_state_controller()->RequestCollapse(collapse);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !StripAnimating() &&
+             vertical_tab_strip_state_controller()->IsCollapsed() == collapse;
+    }));
+  }
+  {
+    SCOPED_TRACE("after a collapse, an expand and a resize");
+    const int width = location_bar()->GetBoundsInScreen().width();
+    gfx::Rect bounds = widget()->GetWindowBoundsInScreen();
+    bounds.Inset(gfx::Insets::TLBR(0, 0, 0, 160));
+    widget()->SetBounds(bounds);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return location_bar()->GetBoundsInScreen().width() != width;
+    })) << "the resize did not narrow the location bar";
+    ASSERT_TRUE(OpenTheDropdown()) << "no dropdown";
+    ASSERT_NO_FATAL_FAILURE(expect_aligned());
+    ASSERT_TRUE(CloseTheDropdown());
+  }
+  {
+    SCOPED_TRACE("after a move of the window");
+    const gfx::Rect field = location_bar()->GetBoundsInScreen();
+    widget()->SetBounds(widget()->GetWindowBoundsInScreen() +
+                        gfx::Vector2d(40, 30));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return location_bar()->GetBoundsInScreen() != field;
+    })) << "the window did not move";
+    ASSERT_TRUE(OpenTheDropdown()) << "no dropdown";
+    ASSERT_NO_FATAL_FAILURE(expect_aligned());
+  }
+}
