index 0000000000000..7c04840743e52
--- /dev/null
+++ b/chrome/browser/ui/views/stedding/altgr_chords.h
@@ -0,0 +1,70 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_STEDDING_ALTGR_CHORDS_H_
+#define CHROME_BROWSER_UI_VIEWS_STEDDING_ALTGR_CHORDS_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_observer.h"
+#include "ui/events/event_handler.h"
+
+namespace views {
+class Widget;
+}  // namespace views
+
+namespace stedding {
+
+// Windows (docs/features/windows.md N14, BACKLOG S-189): on a keyboard layout
+// with AltGr, Windows reports AltGr as Ctrl+Alt, and a key that the layout
+// gives a character with Ctrl+Alt arrives as that AltGr character -- on Polish
+// (Programmers) Ctrl+Alt+Shift+C is Ć -- so the window's chord on that key
+// never ran. Made with a Ctrl and the left Alt, such a chord now runs the
+// window's command; made with AltGr, the right Alt, it types its character as
+// before. Chords no command of the window's uses are left to the layout.
+class AltGrChords : public ui::EventHandler, public aura::WindowObserver {
+ public:
+  // Whether Ctrl and the left Alt are held, and the right one is not: the
+  // keyboard as it is while its key event is handled. A test answers for it.
+  using LeftAltHeld = base::RepeatingCallback<bool()>;
+
+  // Watches the key events of `widget`'s window, its views and its pages
+  // both, before they reach either.
+  AltGrChords(views::Widget* widget, LeftAltHeld left_alt_held);
+  AltGrChords(const AltGrChords&) = delete;
+  AltGrChords& operator=(const AltGrChords&) = delete;
+  ~AltGrChords() override;
+
+  // Gives `widget`'s window one that answers from the keyboard and goes
+  // with the window.
+  static void AttachTo(views::Widget* widget);
+
+  // The keyboard's own answer.
+  static bool LeftAltHeldNow();
+
+  // ui::EventHandler:
+  void OnKeyEvent(ui::KeyEvent* event) override;
+
+  // aura::WindowObserver:
+  void OnWindowDestroying(aura::Window* window) override;
+
+ private:
+  // Weak: a browser window's widget goes before its native window does, and
+  // a raw pointer to it dangled until OnWindowDestroying (the dangling-pointer
+  // detector's find in the Windows checks build, 2026-10-16).
+  base::WeakPtr<views::Widget> widget_;
+  raw_ptr<aura::Window> window_;
+  const LeftAltHeld left_alt_held_;
+  // Made by AttachTo(): deletes itself as its window goes.
+  bool owned_by_window_ = false;
+  base::ScopedObservation<aura::Window, aura::WindowObserver> observation_{
+      this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STEDDING_ALTGR_CHORDS_H_
