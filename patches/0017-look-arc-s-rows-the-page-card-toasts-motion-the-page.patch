-// Writes `png` under `directory`, choosing a free name.
-void WritePng(const base::FilePath& directory,
-              const base::FilePath& name,
-              std::vector<uint8_t> png) {
+base::FilePath& LastCapturePathStorage() {
+  static base::NoDestructor<base::FilePath> path;
+  return *path;
+}
+
+// Writes `png` under `directory`, choosing a free name. Returns the path
+// written, or an empty path when the write failed.
+base::FilePath WritePng(const base::FilePath& directory,
+                        const base::FilePath& name,
+                        std::vector<uint8_t> png) {
   base::CreateDirectory(directory);
   base::FilePath path = directory.Append(name);
   for (int i = 2; base::PathExists(path) && i < 100; ++i) {
     path = directory.Append(name.InsertBeforeExtensionASCII(" " + base::NumberToString(i)));
   }
-  base::WriteFile(path, png);
+  return base::WriteFile(path, png) ? path : base::FilePath();
+}
+
+// Back on the UI thread once the file exists: remember it for the toast's
+// "Show in Finder" and raise the toast (screenshot C5). The tab may have
+// closed meanwhile; then the file is still there and only the toast is lost.
+void OnPngWritten(base::WeakPtr<content::WebContents> contents,
+                  const base::FilePath& path) {
+  if (path.empty()) {
+    return;
+  }
+  LastCapturePathStorage() = path;
+  ToastController* const toasts =
+      contents ? ToastController::MaybeGetForWebContents(contents.get())
+               : nullptr;
+  if (toasts) {
+    toasts->MaybeShowToast(ToastParams(ToastId::kSteddingCaptureSaved));
+  }
+}
+
+// Saves `png` to Downloads off the UI thread, then OnPngWritten.
+void SavePng(Profile* profile,
+             content::WebContents* contents,
+             std::vector<uint8_t> png) {
+  const base::FilePath directory =
+      DownloadPrefs::FromBrowserContext(profile)->DownloadPath();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&WritePng, directory, FileNameFor(contents),
+                     std::move(png)),
+      base::BindOnce(&OnPngWritten,
+                     contents ? contents->GetWeakPtr()
+                              : base::WeakPtr<content::WebContents>()));
 }
 
