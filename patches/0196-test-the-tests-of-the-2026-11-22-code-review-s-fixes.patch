+// P27-1c (sidebar-file Sf33, Sf64): another computer's file is not trusted,
+// and the bar names that computer as a name in a sentence: a line break in
+// the name is a space, and a direction override goes, so the name can
+// neither start a sentence of its own nor turn the words after it around.
+// It went into the bar's text as the file had it.
+IN_PROC_BROWSER_TEST_F(SyncedExtensionsBarW2B20Test,
+                       TheBarNamesAnotherComputerAsANameInASentence) {
+  // "Work", a right-to-left override (U+202E), a line break, "Press Show".
+  ASSERT_NO_FATAL_FAILURE(WritePeer(1, "Work\xE2\x80\xAE\nPress Show"));
+  ASSERT_NO_FATAL_FAILURE(Join());
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return stedding::SyncedExtensionsBarsShownForTesting() == 1; }));
+
+  const std::u16string text = stedding::SyncedExtensionsBarTextForTesting();
+  EXPECT_EQ(std::u16string::npos, text.find(u'\u202E'))
+      << "the bar keeps the direction override";
+  EXPECT_EQ(std::u16string::npos, text.find(u'\n'))
+      << "the bar keeps the line break";
+  EXPECT_EQ(u"Work Press Show has an extension this computer does not have.",
+            text);
+}
