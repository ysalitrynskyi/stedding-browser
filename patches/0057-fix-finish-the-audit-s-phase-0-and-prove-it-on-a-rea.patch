new file mode 100644
index 0000000000000..4c743276f0282
--- /dev/null
+++ b/chrome/browser/ui/views/stedding/rename_field_watcher.cc
@@ -0,0 +1,134 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/rename_field_watcher.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/sequenced_task_runner.h"
+#include "ui/events/event.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/widget/widget.h"
+
+namespace stedding {
+
+RenameFieldWatcher::RenameFieldWatcher(views::Textfield* field,
+                                       base::RepeatingClosure on_walked_away)
+    : field_(field), on_walked_away_(std::move(on_walked_away)) {
+  CHECK(field_);
+  observation_.Observe(field_);
+  UpdateRoot();
+}
+
+RenameFieldWatcher::~RenameFieldWatcher() {
+  if (root_) {
+    root_->RemovePreTargetHandler(this);
+    root_ = nullptr;
+  }
+}
+
+void RenameFieldWatcher::OnViewVisibilityChanged(views::View* observed_view,
+                                                 views::View* starting_view,
+                                                 bool visible) {
+  UpdateRoot();
+}
+
+void RenameFieldWatcher::OnViewAddedToWidget(views::View* observed_view) {
+  UpdateRoot();
+}
+
+void RenameFieldWatcher::OnViewRemovedFromWidget(views::View* observed_view) {
+  if (root_) {
+    root_->RemovePreTargetHandler(this);
+    root_ = nullptr;
+  }
+}
+
+void RenameFieldWatcher::OnViewBlurred(views::View* observed_view) {
+  if (IsOpen()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&RenameFieldWatcher::EndAfterBlur,
+                                  weak_factory_.GetWeakPtr()));
+  }
+}
+
+void RenameFieldWatcher::OnViewIsDeleting(views::View* observed_view) {
+  if (root_) {
+    root_->RemovePreTargetHandler(this);
+    root_ = nullptr;
+  }
+  observation_.Reset();
+  field_ = nullptr;
+}
+
+void RenameFieldWatcher::OnMouseEvent(ui::MouseEvent* event) {
+  if (event->type() == ui::EventType::kMousePressed) {
+    OnPressAt(event);
+  }
+}
+
+void RenameFieldWatcher::OnGestureEvent(ui::GestureEvent* event) {
+  if (event->type() == ui::EventType::kGestureTapDown) {
+    OnPressAt(event);
+  }
+}
+
+bool RenameFieldWatcher::IsOpen() const {
+  return field_ && field_->GetVisible() && field_->GetWidget();
+}
+
+void RenameFieldWatcher::UpdateRoot() {
+  views::View* const root =
+      IsOpen() ? field_->GetWidget()->GetRootView() : nullptr;
+  if (root == root_) {
+    return;
+  }
+  if (root_) {
+    root_->RemovePreTargetHandler(this);
+  }
+  root_ = root;
+  if (root_) {
+    root_->AddPreTargetHandler(this);
+  }
+}
+
+void RenameFieldWatcher::OnPressAt(ui::Event* event) {
+  if (!IsOpen()) {
+    return;
+  }
+  // A press in the field moves the caret or selects; the rename goes on.
+  views::View* const target = static_cast<views::View*>(event->target());
+  if (target && field_->Contains(target)) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RenameFieldWatcher::EndAfterPress,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void RenameFieldWatcher::EndAfterPress() {
+  // A press elsewhere does not always take the focus -- a tab row does not --
+  // so the press alone ends the rename.
+  if (IsOpen()) {
+    on_walked_away_.Run();
+  }
+}
+
+void RenameFieldWatcher::EndAfterBlur() {
+  if (!IsOpen() || field_->HasFocus()) {
+    return;
+  }
+  // The window went inactive with the rename open. Its focus manager keeps
+  // the field to give the focus back when the window returns.
+  if (views::FocusManager* const focus_manager = field_->GetFocusManager();
+      focus_manager && focus_manager->GetStoredFocusView() == field_) {
+    return;
+  }
+  on_walked_away_.Run();
+}
+
+}  // namespace stedding
