new file mode 100644
index 0000000000000..8f7a66e093b55
--- /dev/null
+++ b/chrome/browser/ui/stedding/drm_notice.cc
@@ -0,0 +1,286 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/drm_notice.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "build/build_config.h"
+#include "chrome/browser/infobars/confirm_infobar_creator.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/drm_notice_browser.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+#if !BUILDFLAG(IS_MAC) && !BUILDFLAG(IS_WIN)
+bool OtherBrowserFound() {
+  return false;
+}
+
+void OpenInOtherBrowser(const GURL& url) {}
+#endif
+
+namespace {
+
+// Stedding's own strings are not localised yet.
+constexpr char16_t kMessage[] =
+    u"This site uses DRM to protect its video, which Stedding can't play yet.";
+constexpr char16_t kDontShowAgain[] = u"Don't show again";
+#if BUILDFLAG(IS_MAC)
+constexpr char16_t kOpenElsewhere[] = u"Open in Safari";
+#elif BUILDFLAG(IS_WIN)
+constexpr char16_t kOpenElsewhere[] = u"Open in Edge";
+#else
+constexpr char16_t kOpenElsewhere[] = u"";
+#endif
+
+enum class Match {
+  // The host and its subdomains, on a dot boundary.
+  kDomain,
+  kExactHost,
+};
+
+struct DrmSite {
+  std::string_view host;
+  Match match;
+};
+
+// drm-notice Dn2. A table, not detection of Encrypted Media Extensions: ad and
+// fingerprinting scripts ask for a key system on ordinary pages.
+constexpr DrmSite kDrmSites[] = {
+    {"netflix.com", Match::kDomain},
+    {"disneyplus.com", Match::kDomain},
+    {"primevideo.com", Match::kDomain},
+    {"hulu.com", Match::kDomain},
+    {"max.com", Match::kDomain},
+    {"hbomax.com", Match::kDomain},
+    {"peacocktv.com", Match::kDomain},
+    {"paramountplus.com", Match::kDomain},
+    {"tv.apple.com", Match::kDomain},
+    {"crunchyroll.com", Match::kDomain},
+    {"open.spotify.com", Match::kExactHost},
+};
+
+std::optional<DrmNoticeOpener>& OpenerForTesting() {
+  static base::NoDestructor<std::optional<DrmNoticeOpener>> opener;
+  return *opener;
+}
+
+// drm-notice Dn4.
+bool CanOpenElsewhere() {
+  const std::optional<DrmNoticeOpener>& opener = OpenerForTesting();
+  return opener ? !opener->is_null() : OtherBrowserFound();
+}
+
+void OpenElsewhere(const GURL& url) {
+  const std::optional<DrmNoticeOpener>& opener = OpenerForTesting();
+  if (opener) {
+    opener->Run(url);
+    return;
+  }
+  OpenInOtherBrowser(url);
+}
+
+class DrmNoticeDelegate : public ConfirmInfoBarDelegate {
+ public:
+  DrmNoticeDelegate() : can_open_elsewhere_(CanOpenElsewhere()) {}
+  DrmNoticeDelegate(const DrmNoticeDelegate&) = delete;
+  DrmNoticeDelegate& operator=(const DrmNoticeDelegate&) = delete;
+  ~DrmNoticeDelegate() override = default;
+
+  // ConfirmInfoBarDelegate:
+  InfoBarIdentifier GetIdentifier() const override {
+    return STEDDING_DRM_NOTICE_INFOBAR_DELEGATE;
+  }
+  std::u16string GetMessageText() const override { return kMessage; }
+  int GetButtons() const override {
+    return can_open_elsewhere_ ? BUTTON_OK : BUTTON_NONE;
+  }
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return kOpenElsewhere;
+  }
+  // drm-notice Dn3: the page the tab shows now, and the tab stays on it.
+  bool Accept() override {
+    const GURL& url = Page()->GetLastCommittedURL();
+    if (url.SchemeIsHTTPOrHTTPS()) {
+      OpenElsewhere(url);
+    }
+    return true;
+  }
+  std::u16string GetLinkText() const override { return kDontShowAgain; }
+  bool LinkClicked(WindowOpenDisposition disposition) override {
+    DrmNoticeTabHelper::FromWebContents(Page())->OnDontShowAgain();
+    return true;
+  }
+  // drm-notice Dn7: the helper takes the bar down when the tab leaves the
+  // site. Left to itself the bar would go at the site's next page, and Dn7
+  // would never show it again.
+  bool ShouldExpire(const NavigationDetails& details) const override {
+    return false;
+  }
+
+ private:
+  content::WebContents* Page() {
+    return infobars::ContentInfoBarManager::WebContentsFromInfoBar(infobar());
+  }
+
+  const bool can_open_elsewhere_;
+};
+
+}  // namespace
+
+std::string_view DrmSiteOf(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return {};
+  }
+  std::string_view host = url.host();
+  if (host.ends_with('.')) {
+    host.remove_suffix(1);
+  }
+  for (const DrmSite& site : kDrmSites) {
+    if (site.match == Match::kExactHost ? host == site.host
+                                        : url.DomainIs(site.host)) {
+      return site.host;
+    }
+  }
+  return {};
+}
+
+bool IsDrmSiteDismissed(const PrefService& prefs, std::string_view site) {
+  return prefs.GetList(prefs::kDrmNoticeDismissedSites).contains(site);
+}
+
+void DismissDrmSite(PrefService& prefs, std::string_view site) {
+  if (!IsDrmSiteDismissed(prefs, site)) {
+    ScopedListPrefUpdate(&prefs, prefs::kDrmNoticeDismissedSites)->Append(site);
+  }
+}
+
+DrmNoticeTabHelper::DrmNoticeTabHelper(content::WebContents* page)
+    : content::WebContentsObserver(page),
+      content::WebContentsUserData<DrmNoticeTabHelper>(*page) {
+  registrar_.Init(&prefs());
+  registrar_.Add(
+      prefs::kDrmNoticeDismissedSites,
+      base::BindRepeating(&DrmNoticeTabHelper::OnDismissedSitesChanged,
+                          base::Unretained(this)));
+  // drm-notice Dn12: a peek over the page is made a tab after it has loaded,
+  // and commits nothing more.
+  content::RenderFrameHost* const frame = page->GetPrimaryMainFrame();
+  if (frame->IsRenderFrameLive()) {
+    OnPageChanged(frame->GetLastCommittedURL(), !frame->IsErrorDocument());
+  }
+}
+
+DrmNoticeTabHelper::~DrmNoticeTabHelper() = default;
+
+// static
+void DrmNoticeTabHelper::CreateForReplacement(content::WebContents* from,
+                                              content::WebContents* to) {
+  CreateForWebContents(to);
+  if (const DrmNoticeTabHelper* const old = FromWebContents(from)) {
+    FromWebContents(to)->shown_ = old->shown_;
+  }
+}
+
+void DrmNoticeTabHelper::OnDontShowAgain() {
+  // The press closes this tab's bar. Taking it down here too, from the watch
+  // on the list, would delete the bar under the press.
+  const std::string_view site = bar_site_;
+  bar_site_ = {};
+  DismissDrmSite(prefs(), site);
+}
+
+void DrmNoticeTabHelper::DidFinishNavigation(
+    content::NavigationHandle* navigation) {
+  if (navigation->IsInPrimaryMainFrame() && navigation->HasCommitted() &&
+      !navigation->IsSameDocument()) {
+    OnPageChanged(navigation->GetURL(), !navigation->IsErrorPage());
+  }
+}
+
+void DrmNoticeTabHelper::OnPageChanged(const GURL& url, bool can_show) {
+  const std::string_view site = DrmSiteOf(url);
+  if (site != bar_site_) {
+    RemoveBar();
+  }
+  if (site.empty() || !can_show || shown_.contains(site) || IsDismissed(site)) {
+    return;
+  }
+  infobars::ContentInfoBarManager* const manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents());
+  if (!manager) {
+    return;
+  }
+  shown_.insert(site);
+  bar_site_ = site;
+  manager->AddInfoBar(
+      CreateConfirmInfoBar(std::make_unique<DrmNoticeDelegate>()));
+}
+
+void DrmNoticeTabHelper::OnDismissedSitesChanged() {
+  if (!bar_site_.empty() && IsDismissed(bar_site_)) {
+    RemoveBar();
+  }
+}
+
+void DrmNoticeTabHelper::RemoveBar() {
+  bar_site_ = {};
+  infobars::ContentInfoBarManager* const manager =
+      infobars::ContentInfoBarManager::FromWebContents(web_contents());
+  if (!manager) {
+    return;
+  }
+  for (infobars::InfoBar* const bar : manager->infobars()) {
+    if (bar->delegate()->GetIdentifier() ==
+        infobars::InfoBarDelegate::STEDDING_DRM_NOTICE_INFOBAR_DELEGATE) {
+      manager->RemoveInfoBar(bar);
+      return;
+    }
+  }
+}
+
+bool DrmNoticeTabHelper::IsDismissed(std::string_view site) const {
+  // drm-notice Dn10: once a private window has written the list, its copy in
+  // memory hides what the profile's list gains later.
+  return IsDrmSiteDismissed(prefs(), site) ||
+         IsDrmSiteDismissed(
+             *Profile::FromBrowserContext(web_contents()->GetBrowserContext())
+                  ->GetOriginalProfile()
+                  ->GetPrefs(),
+             site);
+}
+
+PrefService& DrmNoticeTabHelper::prefs() const {
+  return *Profile::FromBrowserContext(web_contents()->GetBrowserContext())
+              ->GetPrefs();
+}
+
+ScopedDrmNoticeOpenerForTesting::ScopedDrmNoticeOpenerForTesting(
+    DrmNoticeOpener opener) {
+  OpenerForTesting() = std::move(opener);
+}
+
+ScopedDrmNoticeOpenerForTesting::~ScopedDrmNoticeOpenerForTesting() {
+  OpenerForTesting().reset();
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(DrmNoticeTabHelper);
+
+}  // namespace stedding
