+// R60: Close Other Tabs keeps the children of the tab it is asked on, and
+// theirs, and closes the rest.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, CloseOtherTabsKeepsATabsChildren) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  tabs::TabInterface* const grandchild = OpenLinkFrom(child, "c.test");
+  ASSERT_TRUE(grandchild);
+  chrome::AddTabAt(browser(), Url("d.test"), /*index=*/-1,
+                   /*foreground=*/false);
+  ASSERT_EQ(4, tabs()->count());
+
+  tabs()->ExecuteContextMenuCommand(tabs()->GetIndexOfTab(page),
+                                    TabStripModel::CommandCloseOtherTabs);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return tabs()->count() == 3; }))
+      << tabs()->count() << " tabs left";
+  EXPECT_NE(TabStripModel::kNoTab, tabs()->GetIndexOfTab(child));
+  EXPECT_NE(TabStripModel::kNoTab, tabs()->GetIndexOfTab(grandchild));
+
+  tabs()->ExecuteContextMenuCommand(tabs()->GetIndexOfTab(child),
+                                    TabStripModel::CommandCloseOtherTabs);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return tabs()->count() == 2; }))
+      << "the parent stayed: only what is under the tab is kept";
+  EXPECT_NE(TabStripModel::kNoTab, tabs()->GetIndexOfTab(grandchild));
+}
