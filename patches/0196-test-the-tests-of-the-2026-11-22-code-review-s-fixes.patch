+// Runs `ask` and returns the dialog it shows, still open; null when none
+// showed. Watched as it shows: on the Mac a browser-modal dialog is a sheet,
+// which the window's child widgets leave out.
+views::Widget* DialogShownDuringW2B28(base::OnceClosure ask) {
+  views::Widget* shown = nullptr;
+  views::AnyWidgetObserver dialogs(views::test::AnyWidgetTestPasskey{});
+  dialogs.set_shown_callback(
+      base::BindLambdaForTesting([&](views::Widget* widget) {
+        if (widget->widget_delegate() &&
+            widget->widget_delegate()->AsDialogDelegate()) {
+          shown = widget;
+        }
+      }));
+  std::move(ask).Run();
+  if (!base::test::RunUntil([&]() { return shown != nullptr; })) {
+    return nullptr;
+  }
+  return shown;
+}
+
+// The title `dialog` shows.
+std::u16string TitleOfW2B28(views::Widget* dialog) {
+  return dialog && dialog->widget_delegate()
+             ? dialog->widget_delegate()->GetWindowTitle()
+             : std::u16string();
+}
+
+// Answers `dialog` as its default button or Cancel does.
+void AnswerW2B28(views::Widget* dialog, bool accept) {
+  views::DialogDelegate* const delegate =
+      dialog->widget_delegate()->AsDialogDelegate();
+  if (accept) {
+    delegate->AcceptDialog();
+  } else {
+    delegate->CancelDialog();
+  }
+}
+
+// The first text field under `view`, or null.
+views::Textfield* TextfieldUnderW2B28(views::View* view) {
+  if (auto* const field = views::AsViewClass<views::Textfield>(view)) {
+    return field;
+  }
+  for (views::View* const child : view->children()) {
+    if (views::Textfield* const found = TextfieldUnderW2B28(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// The welcome flows open now, by their pages, in any window.
+int WelcomePagesW2B28() {
+  int pages = 0;
+  for (content::WebContents* const contents : content::GetAllWebContents()) {
+    if (contents->GetVisibleURL().host() == "stedding-welcome") {
+      ++pages;
+    }
+  }
+  return pages;
+}
