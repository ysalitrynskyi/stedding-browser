+
+std::optional<bool> FolderView::IsAboveClearLine(
+    const gfx::Point& screen_point) const {
+  // The Space's line, drawn in the strip this header is in.
+  const views::View* strip = parent();
+  while (strip && !views::IsViewClass<TabStripView>(strip)) {
+    strip = strip->parent();
+  }
+  if (!strip) {
+    return std::nullopt;
+  }
+  std::vector<const views::View*> pending = {strip};
+  while (!pending.empty()) {
+    const views::View* const view = pending.back();
+    pending.pop_back();
+    if (views::IsViewClass<ClearTabsSeparator>(view) && view->IsDrawn()) {
+      return screen_point.y() < view->GetBoundsInScreen().CenterPoint().y();
+    }
+    for (const views::View* const child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+  // No line is drawn under a run with no rows after it; the "+ New Tab" row
+  // still ends the run there.
+  if (const auto* const container =
+          views::AsViewClass<UnpinnedTabContainerView>(parent())) {
+    const views::View* const new_tab_row =
+        container->space_boundary_new_tab_row();
+    if (new_tab_row && new_tab_row->IsDrawn()) {
+      return screen_point.y() < new_tab_row->GetBoundsInScreen().y();
+    }
+  }
+  return std::nullopt;
+}
