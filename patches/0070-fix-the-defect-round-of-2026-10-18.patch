+    if (!shown.IsEmpty() && view.layer()->type() != ui::LAYER_NOT_DRAWN) {
+      // Only the part that shows: the rows' layer is as tall as every row
+      // of the Space. Painted as its layer is (View::PaintFromPaintRoot),
+      // moved so that part starts at the bitmap's origin.
+      const gfx::Rect part = shown - bounds.OffsetFromOrigin();
+      SkBitmap bitmap;
+      {
+        ui::CanvasPainter painter(&bitmap, part.size(), scale,
+                                  SK_ColorTRANSPARENT, pixel_canvas);
+        ui::TransformRecorder shift(painter.context());
+        const float units = pixel_canvas ? scale : 1.0f;
+        gfx::Transform transform;
+        transform.Translate(-part.x() * units, -part.y() * units);
+        shift.Transform(transform);
+        view.Paint(views::PaintInfo::CreateRootPaintInfo(
+            painter.context(), view.layer()->size()));
+      }
+      canvas.DrawImageInt(gfx::ImageSkia::CreateFromBitmap(bitmap, scale),
+                          shown.x(), shown.y(),
+                          base::ClampRound<uint8_t>(opacity * 255));
+    }
+    DrawLayersUnder(root, view, opacity, clip, scale, pixel_canvas, canvas);
+  }
+
+  // The views under `view` that paint to layers of their own, in the order
+  // their layers are stacked.
+  static void DrawLayersUnder(views::View& root,
+                              views::View& view,
+                              float opacity,
+                              const gfx::Rect& clip,
+                              float scale,
+                              bool pixel_canvas,
+                              gfx::Canvas& canvas) {
+    for (views::View* const child : view.GetChildrenInZOrder()) {
+      if (!child->GetVisible()) {
+        continue;
+      }
+      if (child->layer()) {
+        DrawLayerTree(root, *child, opacity, clip, scale, pixel_canvas,
+                      canvas);
+      } else {
+        DrawLayersUnder(root, *child, opacity, clip, scale, pixel_canvas,
+                        canvas);
+      }
+    }
+  }
+
+  gfx::ImageSkia image_;
+  base::OnceClosure on_done_;
+  std::unique_ptr<ui::Layer> layer_;
+};
