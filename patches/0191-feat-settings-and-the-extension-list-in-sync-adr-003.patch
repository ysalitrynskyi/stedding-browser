+  service()->SetPart("settings", true, sb::StartFrom::kHere);
+  ASSERT_TRUE(OwnFileSays(p::kSidebarDensity, "2"));
+
+  const base::FilePath folder = service()->folder();
+  prefs()->ClearPref(p::kSidebarSyncFolder);
+  local_state()->SetInteger(p::kSidebarDensity, 1);
+  prefs()->SetFilePath(p::kSidebarSyncFolder, folder);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return service()->GetStatus().FindBool("ready").value_or(false);
+  }));
+  EXPECT_EQ(1, local_state()->GetInteger(p::kSidebarDensity));
+  ASSERT_TRUE(OwnFileSays(p::kSidebarDensity, "1"));
+  EXPECT_EQ(OwnInstall(), OwnSetting(p::kSidebarDensity)->s.w);
+}
+
+// Sf60 (review finding): a value the ledger holds and this computer already
+// shows counts as applied at a start, so a value another profile's sync
+// applies later is not set back.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest,
+                       AValueInForceAtAStartCountsAsApplied) {
+  sb::FileParts parts;
+  parts.settings = Setting(p::kSidebarDensity, base::Value(1), NowMs());
+  WritePeer(PeerState(base::Token::CreateRandom().ToString(), NowMs()), 1,
+            parts);
+  Join(sb::JoinParts());
+  ASSERT_EQ(1, local_state()->GetInteger(p::kSidebarDensity));
+  service()->SetPart("settings", false, sb::StartFrom::kAuto);
+  service()->SetPart("settings", true, sb::StartFrom::kThere);
+  ASSERT_EQ(1, local_state()->GetInteger(p::kSidebarDensity));
+  spaces::SidebarSyncService::ApplyBrowserValueForTesting(p::kSidebarDensity,
+                                                          base::Value(3));
+  Scan();
+  EXPECT_EQ(3, local_state()->GetInteger(p::kSidebarDensity));
+}
+
+// Sf69 (review finding): a file seen only as a cloud stub at the first read
+// after the update is read whole once it is downloaded, though unchanged.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest,
+                       AFileThatWasACloudStubIsReadWholeOnceBack) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  sb::FileParts parts;
+  parts.settings = Setting(p::kUiAnimate, base::Value(false), NowMs());
+  WritePeer(PeerState(space, NowMs()), 1, parts);
+  const base::FilePath file = sync_dir().AppendASCII(sb::FileNameFor(kPeer));
+  const base::FilePath stub = sync_dir().AppendASCII(
+      "." + sb::FileNameFor(kPeer) + ".icloud");
+  std::string with_parts;
+  base::Time mtime;
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(base::ReadFileToString(file, &with_parts));
+    std::string unread = with_parts;
+    const size_t at = unread.find("\"settings\":");
+    ASSERT_NE(std::string::npos, at);
+    unread.replace(at, 11, "\"setxxxxx\":");
+    ASSERT_TRUE(base::WriteFile(file, unread));
+    mtime = base::Time::Now() - base::Hours(1);
+    ASSERT_TRUE(base::TouchFile(file, mtime, mtime));
+  }
+  sb::JoinParts off;
+  off.settings = false;
+  off.extensions = false;
+  Join(off);
+  Scan();
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(base::WriteFile(file, with_parts));
+    ASSERT_TRUE(base::TouchFile(file, mtime, mtime));
+    // At the first read after the update, the file is only a stub.
+    ASSERT_TRUE(base::Move(file, stub));
+  }
+  service()->ForgetPartsReadForTesting();
+  Scan();
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(base::Move(stub, file));
+    ASSERT_TRUE(base::TouchFile(file, mtime, mtime));
+  }
+  Scan();
+  const base::DictValue status = service()->GetStatus();
+  const base::ListValue* const there = status.FindList("settingsThere");
+  ASSERT_TRUE(there);
+  ASSERT_EQ(1u, there->size());
+  EXPECT_EQ("Office PC", (*there)[0].GetString());
+}
+
