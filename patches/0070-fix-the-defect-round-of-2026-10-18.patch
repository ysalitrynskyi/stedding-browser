+  ASSERT_TRUE(model);
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_TRUE(prefs->GetBoolean(stedding::prefs::kPinsCloseSleeps));
+
+  // Rests the pointer on `tab`'s row and clicks the close button it shows.
+  const auto press_close_button = [&](tabs::TabInterface* tab) {
+    ASSERT_NO_FATAL_FAILURE(WaitForRowsToSettle());
+    TabView* const row = RowFor(tab_strip_model()->GetIndexOfTab(tab));
+    ASSERT_TRUE(row);
+    row->UpdateHovered(true);
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    views::View* const button = row->close_button_for_testing();
+    ASSERT_TRUE(button->GetVisible()) << "the hovered row has no close button";
+    ClickAt(button->GetBoundsInScreen().CenterPoint());
+  };
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page));
+  tabs::TabInterface* const pin = tab_strip_model()->GetActiveTab();
+  model->SetSpacePinned(pin, true);
+  const tabs::TabHandle pin_handle = pin->GetHandle();
+  AppendTab();
+  tabs::TabInterface* const plain = tab_strip_model()->GetActiveTab();
+  const int count = tab_strip_model()->count();
+
+  {
+    SCOPED_TRACE("the close button on an awake Space pin sleeps it");
+    ASSERT_NO_FATAL_FAILURE(press_close_button(pin));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !pin_handle.Get() ||
+             pin_handle.Get()->GetContents()->WasDiscarded();
+    }));
+    ASSERT_TRUE(pin_handle.Get()) << "the close button closed the pin";
+    EXPECT_EQ(count, tab_strip_model()->count());
+    EXPECT_TRUE(model->IsSpacePinned(pin));
+    EXPECT_EQ(plain, tab_strip_model()->GetActiveTab());
+  }
+
+  {
+    SCOPED_TRACE("the close button on a sleeping Space pin closes it");
+    ASSERT_NO_FATAL_FAILURE(press_close_button(pin));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !pin_handle.Get(); }))
+        << "the close button on a sleeping pin did nothing";
+    EXPECT_EQ(count - 1, tab_strip_model()->count());
+  }
+
+  {
+    SCOPED_TRACE("with Cmd-W's setting off the close button closes a pin");
+    prefs->SetBoolean(stedding::prefs::kPinsCloseSleeps, false);
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), page, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const awake = tab_strip_model()->GetActiveTab();
+    model->SetSpacePinned(awake, true);
+    const tabs::TabHandle awake_handle = awake->GetHandle();
+    tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(plain));
+    ASSERT_NO_FATAL_FAILURE(press_close_button(awake));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !awake_handle.Get(); }))
+        << "the close button slept a pin with Cmd-W's setting off";
+    prefs->SetBoolean(stedding::prefs::kPinsCloseSleeps, true);
