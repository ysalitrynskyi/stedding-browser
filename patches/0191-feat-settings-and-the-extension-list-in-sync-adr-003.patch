+// Sf60 (Sf15's clock): each setting keeps its later edit; the install id
+// breaks a tie the same way everywhere, and the order of merging does not
+// matter.
+TEST(SidebarSyncSettingsTest, TheLaterEditWins) {
+  Settings here =
+      OneSetting(stedding::prefs::kPeekEnabled, base::Value(true), 200, kLaptop);
+  const Settings older = OneSetting(stedding::prefs::kPeekEnabled,
+                                    base::Value(false), 100, kOffice);
