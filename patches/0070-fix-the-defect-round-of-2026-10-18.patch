+    ASSERT_FALSE(spaces::SpaceModel::From(app)) << "a web app has no Spaces";
+    TabStripModel* const app_tabs = app->GetTabStripModel();
+    // Straight into the strip: a window without a tab strip of its own sends
+    // a second tab opened the usual way to a normal window. It goes in
+    // pinned, as a tabbed web app's home tab does: a pin changed in an app
+    // window is something Chromium's session code asserts never happens.
+    app_tabs->InsertWebContentsAt(
