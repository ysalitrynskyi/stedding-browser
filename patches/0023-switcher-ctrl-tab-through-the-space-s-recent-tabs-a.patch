+// Stedding (docs/features/switcher.md X4).
+bool TabStripCollection::FindRowNode(size_t tab_index, RowNode* out) {
+  if (tab_index >= TabCountRecursive()) {
+    return false;
+  }
+  TabInterface* const tab = GetTabAtIndexRecursive(tab_index);
+  TabCollection* const parent = tab->GetParentCollection(GetPassKey());
+  if (!parent) {
+    return false;
+  }
+  if (parent->type() == TabCollection::Type::SPLIT) {
+    TabCollection* const container = parent->GetParentCollection();
+    if (!container) {
+      return false;
+    }
+    out->node = DanglingUntriagedTabCollection(parent);
+    out->container = container;
+    out->child_index = container->GetIndexOfCollection(parent).value();
+    out->tab_count = parent->TabCountRecursive();
+    out->first_tab_index =
+        GetIndexOfTabRecursive(parent->GetTabAtIndexRecursive(0)).value();
+    return true;
+  }
+  out->node = DanglingUntriagedTabInterface(tab);
+  out->container = parent;
+  out->child_index = parent->GetIndexOfTab(tab).value();
+  out->tab_count = 1;
+  out->first_tab_index = tab_index;
+  return true;
+}
+
+namespace {
+
+// The child of `container` that holds `tab`: how many tabs it spans and
+// whether it is a folder. Nullopt if `tab` is not under `container`.
+struct NeighbourRow {
+  size_t tab_count = 1;
+  bool folder = false;
+};
+std::optional<NeighbourRow> NeighbourRowOf(const TabCollection* container,
+                                           const TabInterface* tab) {
+  const TabCollection* node = tab->GetParentCollection();
+  if (node == container) {
+    return NeighbourRow{1, false};
+  }
+  while (node && node->GetParentCollection() != container) {
+    node = node->GetParentCollection();
+  }
+  if (!node) {
+    return std::nullopt;
+  }
+  return NeighbourRow{node->TabCountRecursive(),
+                      node->type() == TabCollection::Type::FOLDER};
+}
+
+}  // namespace
+
+std::optional<TabStripCollection::RelativeMove>
+TabStripCollection::PlanRelativeMoveInFolder(size_t tab_index, int delta) {
+  RowNode row;
+  if (delta == 0 || !FindRowNode(tab_index, &row)) {
+    return std::nullopt;
+  }
+  const bool in_folder = row.container->type() == TabCollection::Type::FOLDER;
+  const size_t count = row.container->ChildCount();
+  const bool at_edge =
+      delta < 0 ? row.child_index == 0 : row.child_index + 1 >= count;
+  if (at_edge) {
+    // A row inside a folder stays inside it; elsewhere Chromium decides.
+    if (in_folder) {
+      return RelativeMove{.moves = false, .destination = row.first_tab_index};
+    }
+    return std::nullopt;
+  }
+  const size_t probe =
+      delta < 0 ? row.first_tab_index - 1 : row.first_tab_index + row.tab_count;
+  if (probe >= TabCountRecursive()) {
+    return std::nullopt;
+  }
+  const std::optional<NeighbourRow> neighbour =
+      NeighbourRowOf(row.container, GetTabAtIndexRecursive(probe));
+  if (!neighbour || (!in_folder && !neighbour->folder)) {
+    return std::nullopt;
+  }
+  return RelativeMove{
+      .moves = true,
+      .destination = delta < 0 ? row.first_tab_index - neighbour->tab_count
+                               : row.first_tab_index + neighbour->tab_count};
+}
+
+void TabStripCollection::MoveTabRelativeInContainer(size_t tab_index,
+                                                    int delta) {
+  RowNode row;
+  if (delta == 0 || !FindRowNode(tab_index, &row)) {
+    return;
+  }
+  const size_t count = row.container->ChildCount();
+  if (delta < 0 ? row.child_index == 0 : row.child_index + 1 >= count) {
+    return;
+  }
+  // The Impl functions take one off the index when the node leaves a slot
+  // before its destination, so "after the next child" is child_index + 2.
+  TabCollection::Position position{
+      row.container->GetHandle(),
+      delta < 0 ? row.child_index - 1 : row.child_index + 2};
+  if (auto* const tab = std::get_if<DanglingUntriagedTabInterface>(&row.node)) {
+    MoveTabImpl(tab->get(), position);
+  } else {
+    MoveCollectionImpl(std::get<DanglingUntriagedTabCollection>(row.node).get(),
+                       position);
+  }
+}
+
 }  // namespace tabs
