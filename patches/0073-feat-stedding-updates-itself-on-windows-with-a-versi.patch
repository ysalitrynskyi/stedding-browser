diff --git a/chrome/browser/ui/stedding/update_feed.cc b/chrome/browser/ui/stedding/update_feed.cc
new file mode 100644
index 0000000000000..9770b6370d3a6
--- /dev/null
+++ b/chrome/browser/ui/stedding/update_feed.cc
@@ -0,0 +1,230 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/update_feed.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "net/base/url_util.h"
+#include "services/data_decoder/public/cpp/safe_xml_parser.h"
+#include "services/data_decoder/public/mojom/xml_parser.mojom.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr std::string_view kSignatureMark = "<!-- sparkle-signatures:";
+constexpr char kSparkleNamespace[] =
+    "http://www.andymatuschak.org/xml-namespaces/sparkle";
+constexpr char kWindowsOs[] = "windows-x64";
+
+// The value after `key` on its own line of `comment`, trimmed.
+std::optional<std::string_view> LineValue(std::string_view comment,
+                                          std::string_view key) {
+  const size_t at = comment.find(key);
+  if (at == std::string_view::npos) {
+    return std::nullopt;
+  }
+  std::string_view rest = comment.substr(at + key.size());
+  const size_t end = rest.find_first_of("\r\n");
+  if (end != std::string_view::npos) {
+    rest = rest.substr(0, end);
+  }
+  return base::TrimWhitespaceASCII(rest, base::TRIM_ALL);
+}
+
+std::string ChildText(const base::Value& element, const std::string& tag) {
+  const base::Value* const child =
+      data_decoder::GetXmlElementChildWithTag(element, tag);
+  std::string text;
+  // The element's own text: the helper finds its text child.
+  if (!child || !data_decoder::GetXmlElementText(*child, &text)) {
+    return std::string();
+  }
+  return std::string(base::TrimWhitespaceASCII(text, base::TRIM_ALL));
+}
+
+// A release's name as its tag has it ("0.2.0-beta.19"): it names the
+// download's file, so nothing but digits, letters, dots and hyphens.
+bool IsReleaseName(std::string_view name) {
+  return !name.empty() && name.size() <= 32 &&
+         std::ranges::all_of(name, [](char c) {
+           return base::IsAsciiAlphaNumeric(c) || c == '.' || c == '-';
+         });
+}
+
+bool AcceptableAddress(const GURL& url, bool allow_local_http) {
+  return url.is_valid() &&
+         (url.SchemeIs(url::kHttpsScheme) ||
+          (allow_local_http && url.SchemeIs(url::kHttpScheme) &&
+           net::IsLocalhost(url)));
+}
+
+// A Windows x64 item of a parsed feed: the item and its enclosure.
+using WindowsEntry = std::pair<const base::Value*, const base::Value*>;
+
+// The feed's Windows x64 items, and `prefix` set to the feed's prefix for
+// Sparkle's tags and attributes.
+std::vector<WindowsEntry> WindowsEntries(const base::Value& feed,
+                                         std::string* prefix) {
+  if (!data_decoder::IsXmlElementNamed(feed, "rss")) {
+    return {};
+  }
+  // The parser keeps a tag as written ("sparkle:version") and, here, no
+  // record of the xmlns declaration: the feed's own prefix when it is
+  // recorded, else Sparkle's, which tooling/appcast.py always writes.
+  if (!data_decoder::GetXmlElementNamespacePrefix(feed, kSparkleNamespace,
+                                                  prefix)) {
+    *prefix = "sparkle";
+  }
+  const base::Value* const channel =
+      data_decoder::GetXmlElementChildWithTag(feed, "channel");
+  std::vector<const base::Value*> items;
+  if (!channel ||
+      !data_decoder::GetAllXmlElementChildrenWithTag(*channel, "item",
+                                                     &items)) {
+    return {};
+  }
+  std::vector<WindowsEntry> entries;
+  for (const base::Value* const item : items) {
+    const base::Value* const enclosure =
+        data_decoder::GetXmlElementChildWithTag(*item, "enclosure");
+    if (enclosure &&
+        data_decoder::GetXmlElementAttribute(
+            *enclosure, data_decoder::GetXmlQualifiedName(*prefix, "os")) ==
+            kWindowsOs) {
+      entries.emplace_back(item, enclosure);
+    }
+  }
+  return entries;
+}
+
+}  // namespace
+
+UpdateItem::UpdateItem() = default;
+UpdateItem::UpdateItem(const UpdateItem&) = default;
+UpdateItem& UpdateItem::operator=(const UpdateItem&) = default;
+UpdateItem::~UpdateItem() = default;
+
+bool SignatureVerifies(base::span<const uint8_t> data,
+                       std::string_view signature,
+                       std::string_view public_key) {
+  const std::optional<std::vector<uint8_t>> key =
+      base::Base64Decode(public_key);
+  const std::optional<std::vector<uint8_t>> sig =
+      base::Base64Decode(signature);
+  if (!key || key->size() != ED25519_PUBLIC_KEY_LEN || !sig ||
+      sig->size() != ED25519_SIGNATURE_LEN) {
+    return false;
+  }
+  return ED25519_verify(data.data(), data.size(), sig->data(), key->data()) ==
+         1;
+}
+
+std::optional<std::string_view> SignedFeedBody(std::string_view feed,
+                                               std::string_view public_key) {
+  const size_t at = feed.rfind(kSignatureMark);
+  if (at == std::string_view::npos) {
+    return std::nullopt;
+  }
+  const std::string_view comment = feed.substr(at);
+  const std::optional<std::string_view> signature =
+      LineValue(comment, "edSignature:");
+  const std::optional<std::string_view> length = LineValue(comment, "length:");
+  size_t signed_length = 0;
+  if (!signature || !length ||
+      !base::StringToSizeT(*length, &signed_length) || signed_length != at) {
+    return std::nullopt;
+  }
+  const std::string_view body = feed.substr(0, at);
+  if (!SignatureVerifies(base::as_byte_span(body), *signature, public_key)) {
+    return std::nullopt;
+  }
+  return body;
+}
+
+std::optional<UpdateItem> LaterWindowsItem(const base::Value& feed,
+                                           const base::Version& installed,
+                                           bool allow_local_http) {
+  if (!installed.IsValid()) {
+    return std::nullopt;
+  }
+  std::string prefix;
+  const auto sparkle = [&](const std::string& name) {
+    return data_decoder::GetXmlQualifiedName(prefix, name);
+  };
+  std::optional<UpdateItem> best;
+  for (const auto& [item, enclosure] : WindowsEntries(feed, &prefix)) {
+    UpdateItem candidate;
+    candidate.version = ChildText(*item, sparkle("shortVersionString"));
+    candidate.file_version = base::Version(ChildText(*item, sparkle("version")));
+    candidate.url =
+        GURL(data_decoder::GetXmlElementAttribute(*enclosure, "url"));
+    candidate.signature =
+        data_decoder::GetXmlElementAttribute(*enclosure, sparkle("edSignature"));
+    if (!IsReleaseName(candidate.version) ||
+        !candidate.file_version.IsValid() ||
+        candidate.file_version.components().size() != 4 ||
+        candidate.file_version.CompareTo(installed) <= 0 ||
+        !AcceptableAddress(candidate.url, allow_local_http) ||
+        candidate.signature.empty() ||
+        !base::StringToInt64(
+            data_decoder::GetXmlElementAttribute(*enclosure, "length"),
+            &candidate.length) ||
+        candidate.length <= 0) {
+      continue;
+    }
+    if (!best || candidate.file_version.CompareTo(best->file_version) > 0) {
+      best = std::move(candidate);
+    }
+  }
+  return best;
+}
+
+base::Version NewestWindowsVersion(const base::Value& feed) {
+  std::string prefix;
+  base::Version newest;
+  for (const auto& [item, enclosure] : WindowsEntries(feed, &prefix)) {
+    const base::Version version(
+        ChildText(*item, data_decoder::GetXmlQualifiedName(prefix, "version")));
+    if (version.IsValid() && version.components().size() == 4 &&
+        (!newest.IsValid() || version.CompareTo(newest) > 0)) {
+      newest = version;
+    }
+  }
+  return newest;
+}
+
+std::string SteddingVersionOfWindowsVersion(const base::Version& version) {
+  if (!version.IsValid() || version.components().size() != 4) {
+    return std::string();
+  }
+  const uint32_t product = version.components()[1];
+  const uint32_t patch = version.components()[2];
+  const uint32_t n = version.components()[3];
+  // Chromium's own numbers carry a build in the thousands where the product's
+  // patch is, and a minor of 0.
+  if (product == 0 || patch > 999 || n == 0 || n > 999) {
+    return std::string();
+  }
+  std::string name = base::StrCat(
+      {base::NumberToString(product / 100), ".",
+       base::NumberToString(product % 100), ".", base::NumberToString(patch)});
+  if (n != 999) {
+    base::StrAppend(&name, {"-beta.", base::NumberToString(n)});
+  }
+  return name;
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/update_feed.h b/chrome/browser/ui/stedding/update_feed.h
