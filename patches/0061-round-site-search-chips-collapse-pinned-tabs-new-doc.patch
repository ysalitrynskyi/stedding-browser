+// One service's blank document, as the command bar offers it
+// (docs/features/commandbar.md K28; BACKLOG S-116).
+struct NewDocument {
+  // The row's title, exactly as the command bar draws it.
+  std::u16string_view title;
+  // The service's own new-document address: opening it makes a blank
+  // document there. Always https, and nothing of what was typed goes with it.
+  std::string_view url;
+};
