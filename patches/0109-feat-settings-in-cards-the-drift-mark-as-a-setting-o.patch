+// sessions S10 (BACKLOG S-318): the switch on a Space's row in
+// chrome://settings/stedding asks the question the Space menu and the command
+// bar ask, naming the apps, also when no page of the Space is open. It asked
+// its own question, about pages alone, so with only apps it turned the
+// session off at once and never named them.
+IN_PROC_BROWSER_TEST_F(AppJarTest, TheSettingsSwitchNamesTheAppsToo) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app = MakeAppIn(work_);
+  ASSERT_FALSE(app.empty());
+  const std::u16string name =
+      base::UTF8ToUTF16(provider().registrar_unsafe().GetAppShortName(app));
+  for (int i = tabs()->count() - 1; i >= 0; --i) {
+    if (model_->FindSpaceForTab(tabs()->GetTabAtIndex(i)) == work_) {
+      tabs()->CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+    }
+  }
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return model_->CountPagesAJarChangeReloads(work_) == 0; }));
+  ASSERT_TRUE(model_->SetActiveSpace(home_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://settings/stedding")));
+  content::WebContents* const page = tabs()->GetActiveWebContents();
+  // Presses Work's switch, once the page lists the Spaces; false until then.
+  const std::string press = content::JsReplace(R"((() => {
+    const find = (root, selector) => {
+      const hit = root.querySelector(selector);
+      if (hit) {
+        return hit;
+      }
+      for (const element of root.querySelectorAll('*')) {
+        const inner = element.shadowRoot && find(element.shadowRoot, selector);
+        if (inner) {
+          return inner;
+        }
+      }
+      return null;
+    };
+    const toggle =
+        find(document, 'cr-toggle.space-isolated[data-id="' + $1 + '"]');
+    if (!toggle) {
+      return false;
+    }
+    toggle.click();
+    return true;
+  })())",
+                                               work_.ToString());
+  const auto press_the_switch = [&]() {
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return content::EvalJs(page, press).ExtractBool(); }))
+        << "the page never listed Work";
+  };
+
+  {
+    SCOPED_TRACE("cancelled, the session stays on");
+    const std::u16string text = QuestionDuring(
+        base::BindLambdaForTesting(press_the_switch), /*accept=*/false);
+    EXPECT_NE(std::u16string::npos,
+              text.find(name + u" will use the shared session while it is "
+                               u"off."))
+        << "no question, or one without the app: " << text;
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(model_->SpaceIsIsolated(work_));
+  }
+  {
+    SCOPED_TRACE("answered Turn Off, the session goes");
+    const std::u16string text = QuestionDuring(
+        base::BindLambdaForTesting(press_the_switch), /*accept=*/true);
+    EXPECT_FALSE(text.empty()) << "no question";
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return !model_->SpaceIsIsolated(work_); }));
+    EXPECT_EQ("", stedding::AppJarInUse(*profile()->GetPrefs(), app));
+  }
+}
