+std::string SettingJson(const base::Value& value) {
+  std::string json;
+  base::JSONWriter::Write(value, &json);
+  return json;
+}
+
+base::DictValue SettingsToValue(const Settings& settings) {
+  base::DictValue out;
+  for (const auto& [path, field] : settings) {
+    std::optional<base::Value> value =
+        base::JSONReader::Read(field.json, base::JSON_PARSE_RFC);
+    if (!value) {
+      continue;
+    }
+    base::ListValue triple;
+    triple.Append(std::move(*value));
+    triple.Append(static_cast<double>(field.s.t));
+    triple.Append(field.s.w);
+    out.Set(path, std::move(triple));
+  }
+  return out;
+}
+
+std::optional<Settings> SettingsFromValue(const base::Value& value) {
+  const base::DictValue* const dict = value.GetIfDict();
+  if (!dict || dict->size() > kMaxPartEntries) {
+    return std::nullopt;
+  }
+  Settings settings;
+  for (const auto [path, entry] : *dict) {
+    // Only what this version syncs: never a setting that stays, whatever a
+    // file says (Sf59).
+    if (!IsSyncedSetting(path)) {
+      continue;
+    }
+    const base::ListValue* const triple = entry.GetIfList();
+    if (!triple) {
+      continue;
+    }
+    const std::optional<Stamp> stamp = StampOf(*triple);
+    if (!stamp) {
+      continue;
+    }
+    std::string json = SettingJson((*triple)[0]);
+    if (json.empty() || json.size() > kMaxSettingBytes) {
+      continue;
+    }
+    settings[path] = SettingField{std::move(json), *stamp};
+  }
+  return settings;
+}
+
+std::vector<std::string> MergeSettings(Settings& into, const Settings& peer) {
+  std::vector<std::string> changed;
+  for (const auto& [path, field] : peer) {
+    auto it = into.find(path);
+    if (it == into.end()) {
+      into.emplace(path, field);
+      changed.push_back(path);
+      continue;
+    }
+    if (field.s > it->second.s) {
+      const bool differs = it->second.json != field.json;
+      it->second = field;
+      if (differs) {
+        changed.push_back(path);
+      }
+    }
+  }
+  return changed;
+}
