+  EXPECT_EQ("true", here[stedding::prefs::kPeekEnabled].json);
+
+  const Settings newer = OneSetting(stedding::prefs::kPeekEnabled,
+                                    base::Value(false), 300, kOffice);
+  EXPECT_EQ(std::vector<std::string>{stedding::prefs::kPeekEnabled},
+            MergeSettings(here, newer));
+  EXPECT_EQ("false", here[stedding::prefs::kPeekEnabled].json);
+  EXPECT_EQ(kOffice, here[stedding::prefs::kPeekEnabled].s.w);
