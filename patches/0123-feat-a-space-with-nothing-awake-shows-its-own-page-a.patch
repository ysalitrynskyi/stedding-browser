+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/views/view.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace gfx {
+class Canvas;
+}  // namespace gfx
+
+namespace views {
+class Widget;
+}  // namespace views
+
+// docs/features/sidebar-panels.md Pn18 (BACKLOG S-400): when a download
+// starts in a window whose sidebar shows its downloads button, a round chip
+// with a download arrow flies from the middle of the page to that button,
+// shrinking to the button's size and fading as it lands. Chromium's own
+// animation, a 26 DIP icon flying to the toolbar's button, was hard to see,
+// and in a window with the sidebar it flew to a button that is not shown. The
+// frames are stedding::DownloadFlightAt's. Like Chromium's, it is made with
+// new, floats in a popup that takes no events and no focus, and deletes
+// itself when it is done.
+class SteddingDownloadFlightViews : public DownloadStartedAnimationViews {
+  METADATA_HEADER(SteddingDownloadFlightViews, DownloadStartedAnimationViews)
+
+ public:
+  // Tests: run as each flight starts, with the page's bounds and the
+  // button's, in the screen's coordinates.
+  using StartedCallback =
+      base::RepeatingCallback<void(const gfx::Rect& page,
+                                   const gfx::Rect& button)>;
+  static void SetStartedCallbackForTesting(StartedCallback callback);
+
+  // `button_bounds` are the sidebar's downloads button's, in the screen's
+  // coordinates. The chip is `chip_color` with the arrow in `arrow_color`.
+  SteddingDownloadFlightViews(content::WebContents* web_contents,
+                              const gfx::Rect& button_bounds,
+                              SkColor chip_color,
+                              SkColor arrow_color);
+  SteddingDownloadFlightViews(const SteddingDownloadFlightViews&) = delete;
+  SteddingDownloadFlightViews& operator=(const SteddingDownloadFlightViews&) =
+      delete;
+  ~SteddingDownloadFlightViews() override;
+
+ private:
+  // The chip's image -- its circle, the arrow and the shadow round it -- and
+  // where the circle starts in that image.
+  struct Chip {
+    ui::ImageModel image;
+    gfx::Vector2d circle_origin;
+  };
+  static Chip MakeChip(SkColor chip_color, SkColor arrow_color);
+
+  SteddingDownloadFlightViews(content::WebContents* web_contents,
+                              const gfx::Rect& button_bounds,
+                              const Chip& chip);
+
+  // DownloadStartedAnimationViews:
+  int GetX() const override;
+  int GetY() const override;
+  int GetWidth() const override;
+  int GetHeight() const override;
+  float GetOpacity() const override;
+
+  // views::ImageViewBase:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+
+  // Where the whole image is now, its shadow included.
+  gfx::Rect FrameBounds() const;
+
+  const gfx::Rect button_bounds_;
+  const gfx::Size image_size_;
+  const gfx::Vector2d circle_origin_;
+};
+
+// docs/features/sidebar-panels.md Pn18: the ring round the sidebar's
+// downloads button as the chip lands: it grows to 1.8 times the button and
+// fades in 400 ms. With motion off (motion O1) there is no flight, and this
+// ring alone holds still round the button for a second. The frames are
+// stedding::DownloadRingAt's. Made with new; it deletes itself when done.
+class SteddingDownloadRingViews : public gfx::LinearAnimation,
+                                  public views::View {
+  METADATA_HEADER(SteddingDownloadRingViews, views::View)
+
+ public:
+  // The ring's popup, by name.
+  static constexpr char kWidgetName[] = "SteddingDownloadRing";
+
+  // Tests: run as each ring starts, with the button's bounds in the screen's
+  // coordinates and whether it holds still.
+  using StartedCallback =
+      base::RepeatingCallback<void(const gfx::Rect& button, bool still)>;
+  static void SetStartedCallbackForTesting(StartedCallback callback);
+
+  // `parent` is the button's window; `button_bounds` the button's, in the
+  // screen's coordinates.
+  SteddingDownloadRingViews(views::Widget* parent,
+                            const gfx::Rect& button_bounds,
+                            SkColor color,
+                            bool still);
+  SteddingDownloadRingViews(const SteddingDownloadRingViews&) = delete;
+  SteddingDownloadRingViews& operator=(const SteddingDownloadRingViews&) =
+      delete;
+  ~SteddingDownloadRingViews() override;
+
+ private:
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // gfx::LinearAnimation:
+  void AnimateToState(double state) override;
+
+  raw_ptr<views::Widget> popup_ = nullptr;
+  const gfx::Rect button_bounds_;
+  const SkColor color_;
+  const bool still_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_DOWNLOAD_BUBBLE_STEDDING_DOWNLOAD_FLIGHT_VIEWS_H_
