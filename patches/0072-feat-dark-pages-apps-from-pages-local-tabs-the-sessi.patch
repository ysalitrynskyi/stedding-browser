+// Stedding (BACKLOG S-220): the environment variable through which a test
+// process hands its user-data directory to the processes it starts that run
+// the suite again, a death test's child and a multi-process test's child.
+// They write where it does, and leave deleting the directory to it: a death
+// test's child never reaches Shutdown(), and each would otherwise leave a
+// directory behind.
+constexpr char kUserDataDirVariable[] = "STEDDING_UNIT_TESTS_USER_DATA_DIR";
+
+// The name every such directory starts with.
+constexpr base::FilePath::CharType kUserDataDirPrefix[] =
+    FILE_PATH_LITERAL("stedding_unit_tests_user_data");
+
+// Whether `dir`, named by kUserDataDirVariable, is a directory a test process
+// made and may be used: one of this suite's, in the system's temporary
+// folder, and still there. The variable could also be left over in a shell or
+// a CI job's environment and name any folder, the person's own data folder
+// among them, where every test would then write with nothing to delete it.
+bool IsTestProcessUserDataDir(const base::FilePath& dir) {
+  if (dir.empty() || !dir.BaseName().value().starts_with(kUserDataDirPrefix)) {
+    return false;
+  }
+  base::FilePath temp_dir;
+  if (!base::GetTempDir(&temp_dir)) {
+    return false;
+  }
+  // Both with links resolved: on the Mac the temporary folder is reached
+  // through /var, a link to /private/var.
+  const base::FilePath absolute_dir = base::MakeAbsoluteFilePath(dir);
+  const base::FilePath absolute_temp_dir = base::MakeAbsoluteFilePath(temp_dir);
+  return !absolute_dir.empty() && !absolute_temp_dir.empty() &&
+         absolute_temp_dir.IsParent(absolute_dir) &&
+         base::DirectoryExists(absolute_dir);
+}
