+bool GetShippedMacAcceleratorForCommandId(int command_id,
+                                          ui::Accelerator* accelerator) {
+  for (const auto& shortcut : GetDefaultShortcutsNotPresentInMainMenu()) {
+    if (shortcut.chrome_command == command_id) {
+      *accelerator = AcceleratorFromShortcut(shortcut);
+      return true;
+    }
+  }
+  return GetDefaultMacMenuAcceleratorForCommandId(command_id, accelerator);
+}
+
+bool GetDefaultMacMenuAcceleratorForCommandId(int command_id,
+                                              ui::Accelerator* accelerator) {
+  const ui::Accelerator* const shipped =
+      AcceleratorsCocoa::GetInstance()->GetDefaultAcceleratorForCommand(
+          command_id);
+  if (shipped) {
+    *accelerator = *shipped;
+  }
+  return shipped != nullptr;
+}
