new file mode 100644
index 0000000000000..47bd602fa0a16
--- /dev/null
+++ b/content/browser/notifications/stedding_notification_partition.cc
@@ -0,0 +1,81 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/notifications/stedding_notification_partition.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "content/browser/notifications/notification_id_generator.h"
+
+namespace content {
+namespace {
+
+// As in notification_id_generator.cc.
+constexpr char kNotificationTagSeparator = '#';
+constexpr char kPartitionMarker[] = "@";
+constexpr char kPartitionFieldSeparator[] = ".";
+constexpr char kPartitionInMemory[] = "m";
+
+}  // namespace
+
+std::string NameNotificationPartition(
+    std::string notification_id,
+    const StoragePartitionConfig& partition) {
+  if (partition.is_default() ||
+      !NotificationIdGenerator::IsPersistentNotification(notification_id)) {
+    return notification_id;
+  }
+  const size_t separator = notification_id.find(kNotificationTagSeparator);
+  if (separator == std::string::npos) {
+    return notification_id;
+  }
+  std::string name = base::StrCat(
+      {kPartitionMarker, partition.partition_domain(), kPartitionFieldSeparator,
+       base::HexEncode(partition.partition_name())});
+  if (partition.in_memory()) {
+    base::StrAppend(&name, {kPartitionFieldSeparator, kPartitionInMemory});
+  }
+  notification_id.insert(separator, name);
+  return notification_id;
+}
+
+std::optional<StoragePartitionConfig> NotificationPartitionFromId(
+    BrowserContext* browser_context,
+    std::string_view notification_id) {
+  if (!browser_context ||
+      !NotificationIdGenerator::IsPersistentNotification(notification_id)) {
+    return std::nullopt;
+  }
+  const size_t separator = notification_id.find(kNotificationTagSeparator);
+  const size_t marker = notification_id.find(kPartitionMarker);
+  if (separator == std::string_view::npos ||
+      marker == std::string_view::npos || marker > separator) {
+    return std::nullopt;
+  }
+  const std::vector<std::string_view> fields = base::SplitStringPiece(
+      notification_id.substr(marker + 1, separator - marker - 1),
+      kPartitionFieldSeparator, base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  // A partition's domain is [a-z]+ (StoragePartitionConfig::Create).
+  if (fields.size() < 2 || fields.size() > 3 || fields[0].empty() ||
+      !std::ranges::all_of(fields[0],
+                           [](char c) { return c >= 'a' && c <= 'z'; })) {
+    return std::nullopt;
+  }
+  const bool in_memory = fields.size() == 3;
+  if (in_memory && fields[2] != kPartitionInMemory) {
+    return std::nullopt;
+  }
+  std::string name;
+  if (!fields[1].empty() && !base::HexStringToString(fields[1], &name)) {
+    return std::nullopt;
+  }
+  return StoragePartitionConfig::Create(browser_context, fields[0], name,
+                                        in_memory);
+}
+
+}  // namespace content
