@@ -0,0 +1,549 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// "On startup, load" (docs/features/tabs.md R45-R48, BACKLOG S-110): after a
+// relaunch with "Continue where you left off", only the selected tab -- both
+// panes of its split -- loads, and the essentials too or every row of the
+// Space on screen when the user chose so; every other restored tab comes
+// back asleep, with its title and favicon, and loads when it is selected.
+// One window of three Spaces: an essential, a split selected in Home, a plain
+// row of Home, a row in a collapsed folder of Home, a row of Work and one of
+// Play. Each step is a browser run on the profile the run before it left,
+// with the choice that run set; the first run builds the window.
+//
+// The pages live in the profile's folder, where the run after a restart finds
+// them at the addresses the session saved, with a favicon of their own.
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/notreached.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/cancelable_task_tracker.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/browser/favicon/favicon_service_factory.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/profile.h"
