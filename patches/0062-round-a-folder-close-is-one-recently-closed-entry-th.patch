+// PLAN.md TAB-13: the folder a tab was closed with, for one close.
+class FolderCloseMark : public content::WebContentsObserver,
+                        public content::WebContentsUserData<FolderCloseMark> {
+ public:
+  ~FolderCloseMark() override = default;
+
+  std::optional<ClosedFolderMark>& mark() { return mark_; }
+
+  // content::WebContentsObserver: a close told to stay did not happen.
+  void BeforeUnloadFired(bool proceed) override {
+    if (!proceed) {
+      mark_.reset();
+    }
+  }
+  void BeforeUnloadDialogCancelled() override { mark_.reset(); }
+
+ private:
+  friend class content::WebContentsUserData<FolderCloseMark>;
+  FolderCloseMark(content::WebContents* contents, ClosedFolderMark mark)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<FolderCloseMark>(*contents),
+        mark_(std::move(mark)) {}
+
+  std::optional<ClosedFolderMark> mark_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(FolderCloseMark);
+
 ArchiveMarkObserver& ObserverForTesting() {
   static base::NoDestructor<ArchiveMarkObserver> observer;
   return *observer;
@@ -116,6 +146,29 @@ void ClearArchiveMark(content::WebContents* contents) {
   }
 }
 
+void MarkClosedWithFolder(content::WebContents* contents,
+                          ClosedFolderMark mark) {
+  if (!contents) {
+    return;
+  }
+  if (FolderCloseMark* const existing =
+          FolderCloseMark::FromWebContents(contents)) {
+    existing->mark() = std::move(mark);
+  } else {
+    FolderCloseMark::CreateForWebContents(contents, std::move(mark));
+  }
+}
+
+std::optional<ClosedFolderMark> TakeClosedFolderMark(
+    content::WebContents* contents) {
+  FolderCloseMark* const holder =
+      contents ? FolderCloseMark::FromWebContents(contents) : nullptr;
+  if (!holder) {
+    return std::nullopt;
+  }
+  return std::exchange(holder->mark(), std::nullopt);
+}
+
 void SetArchiveMarkObserverForTesting(ArchiveMarkObserver observer) {
   ObserverForTesting() = std::move(observer);
 }
