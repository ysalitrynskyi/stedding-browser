+int SpaceModel::CountPagesAJarChangeReloads(const SpaceId& id) const {
+  int pages = 0;
+  const auto count_in = [&](const SpaceModel& model) {
+    TabStripModel* const tabs = model.tab_strip_model_;
+    if (!tabs) {
+      return;
+    }
+    for (int i = 0; i < tabs->count(); ++i) {
+      tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+      content::WebContents* const contents = tab->GetContents();
+      // A new-tab page reloads too, but holds nothing to tell anyone.
+      if (!tab->IsPinned() && contents && !contents->WasDiscarded() &&
+          model.FindSpaceForTab(tab) == id &&
+          PageBelongsInSpaceJar(contents->GetVisibleURL()) &&
+          !IsFreshTabUrl(contents->GetVisibleURL())) {
+        ++pages;
+      }
+    }
+  };
+  count_in(*this);
+  if (!registry_) {
+    return pages;
+  }
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        const SpaceModel* const other = SpaceModel::From(window);
+        if (other && other != this && other->registry_ == registry_) {
+          count_in(*other);
+        }
+        return true;
+      });
+  return pages;
+}
