+// folders F49 (the owner, 2026-11-06; BACKLOG S-442): a press on the - leaves
+// the list where it is, with the header under the pointer, though the row
+// that comes to the front is far down a long list, past pins asleep. The list
+// went to that row.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, TheMinusLeavesTheListWhereItIs) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  CloseDownToOne();
+  tabs::TabInterface* const below = tab_strip_model()->GetActiveTab();
+  tabs::TabInterface* const first = OpenPin("a.test");
+  tabs::TabInterface* const second = OpenPin("b.test");
+  tabs::FolderTabCollection* const folder = FolderOf({first, second});
+  ASSERT_TRUE(folder);
+  for (int pin = 0; pin < 36; ++pin) {
+    tabs::TabInterface* const asleep =
+        OpenPin(base::StringPrintf("p%d.test", pin));
+    tab_strip_model()->ActivateTabAt(IndexOf(first));
+    stedding::UnloadTabNow(asleep);
+    ASSERT_TRUE(WaitUntilAsleep(asleep));
+  }
+  // The tab that stays awake comes after every pin, and then the last used
+  // is in the folder, so the row that shows next is far down the list.
+  tab_strip_model()->ActivateTabAt(IndexOf(below));
+  tab_strip_model()->ActivateTabAt(IndexOf(first));
+  views::test::RunScheduledLayout(widget());
+
+  TabStripView* const strip = stedding::test::FindView<TabStripView>(
+      BrowserView::GetBrowserViewForBrowser(browser())
+          ->vertical_tab_strip_region_view_for_testing());
+  ASSERT_TRUE(strip);
+  views::ScrollView* const list = strip->unpinned_tabs_scroll_view();
+  ASSERT_TRUE(list);
+  ASSERT_GT(list->contents()->height(), 2 * list->GetVisibleRect().height())
+      << "not a long list";
+  // The list at its top, with the header in view: the activations above left
+  // it with the folder's first row at the top edge.
+  list->ScrollToOffset(gfx::PointF());
+  views::test::RunScheduledLayout(widget());
+  const int offset = list->GetVisibleRect().y();
+  const int header = DrawnFolder(folder)->GetHeaderBoundsInScreen().y();
+
+  ASSERT_TRUE(PressMinus(folder));
+  ASSERT_TRUE(WaitUntilAsleep(first));
+  ASSERT_TRUE(WaitUntilAsleep(second));
+  ASSERT_EQ(below, tab_strip_model()->GetActiveTab());
+  // Through the rows' folding and the layouts a scroll would come in.
+  for (int turn = 0; turn < 24; ++turn) {
+    base::RunLoop wait;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, wait.QuitClosure(), base::Milliseconds(25));
+    wait.Run();
+    views::test::RunScheduledLayout(widget());
+    ASSERT_EQ(offset, list->GetVisibleRect().y())
+        << "the list moved, turn " << turn;
+    ASSERT_EQ(header, DrawnFolder(folder)->GetHeaderBoundsInScreen().y())
+        << "the header left the pointer, turn " << turn;
+  }
+}
