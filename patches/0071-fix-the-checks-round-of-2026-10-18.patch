+// Stedding (BACKLOG S-250): a page whose answer to "must its unload handlers
+// run before it closes?" changes once the strip has asked it to run them, as
+// a page waiting on its handlers becomes ready to close when its beforeunload
+// timeout runs out. The handlers never hold the close up.
+class UnloadAnswerChangesTabStripModelDelegate
+    : public TestTabStripModelDelegate {
+ public:
+  UnloadAnswerChangesTabStripModelDelegate(bool before, bool after)
+      : before_(before), after_(after) {}
+
+  bool ShouldRunUnloadListenerBeforeClosing(WebContents* contents) override {
+    return asked_to_run_ ? after_ : before_;
+  }
+  bool RunUnloadListenerBeforeClosing(WebContents* contents) override {
+    asked_to_run_ = true;
+    return false;
+  }
+
+ private:
+  const bool before_;
+  const bool after_;
+  bool asked_to_run_ = false;
+};
+
+}  // namespace
+
+// Stedding (BACKLOG S-250): a closed tab is told of its detach for deletion
+// exactly once, before it is deleted, even when its unload answer changes
+// while it closes. A tab that needed its handlers at first and not later was
+// told nothing, and the sidebar row's TabDataObserver kept a pointer to the
+// deleted tab (the checks build's dangling-pointer detector); the other way
+// round it was told twice.
+TEST_F(TabStripModelTest, AClosedTabIsToldOfItsDetachOnce) {
+  for (const auto [before, after] : {std::pair(true, false),
+                                     std::pair(false, true)}) {
+    SCOPED_TRACE(testing::Message() << "needs its handlers first: " << before
+                                    << ", then: " << after);
+    UnloadAnswerChangesTabStripModelDelegate delegate(before, after);
+    TabStripModel tabstrip(&delegate, profile());
+    tabstrip.AppendWebContents(CreateWebContents(), true);
+    tabstrip.AppendWebContents(CreateWebContents(), true);
+
+    std::vector<tabs::TabInterface::DetachReason> told;
+    base::CallbackListSubscription subscription =
+        tabstrip.GetTabAtIndex(1)->RegisterWillDetach(base::BindRepeating(
+            [](std::vector<tabs::TabInterface::DetachReason>* told,
+               tabs::TabInterface* tab,
+               tabs::TabInterface::DetachReason reason) {
+              told->push_back(reason);
+            },
+            &told));
+    tabstrip.CloseWebContentsAt(1, TabCloseTypes::CLOSE_NONE);
+
+    EXPECT_EQ(1, tabstrip.count()) << "the tab closed";
+    EXPECT_EQ(std::vector{tabs::TabInterface::DetachReason::kDelete}, told);
+    tabstrip.CloseAllTabs();
+  }
+}
