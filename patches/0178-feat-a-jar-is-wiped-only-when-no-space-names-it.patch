+// sessions S44: a wipe waiting on a page in the jar is asked again when it
+// runs. A window's session can bring back a Space that names the jar while it
+// waits (S2), and that jar is that Space's.
+TEST_F(SharedSessionWindowTest, AWaitingWipeIsDroppedWhenASpaceNamesTheJarAgain) {
+  PrefService* const prefs = profile()->GetPrefs();
+  const SpaceId home = model().active_id();
+  const SpaceId work = model().AddSpace("Work", kBlue)->id();
+  model().SetSpaceIsolated(work, true);
+  const std::string jar = model().registry()->Find(work)->profile_id;
+  OpenTabIn(work);
+  const GURL url("https://example.com/");
+  PutCookie(profile(), ConfigFor(jar), url);
+  model().SetActiveSpace(home);
+
+  // A popup holds a page in the jar, so the wipe waits (S17).
+  std::unique_ptr<BrowserWindowInterface> popup =
+      CreateBrowser(profile(), Browser::TYPE_POPUP, /*hosted_app=*/false);
+  content::WebContents::CreateParams params(
+      profile(), content::SiteInstance::CreateForFixedStoragePartition(
+                     profile(), url, ConfigFor(jar)));
+  TabStripModel* const popup_tabs = popup->GetTabStripModel();
+  popup_tabs->AppendTab(
+      std::make_unique<tabs::TabModel>(content::WebContents::Create(params),
+                                       popup_tabs),
+      /*foreground=*/true);
+
+  ASSERT_TRUE(model().RemoveSpace(work));
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(1u, prefs->GetList(stedding::prefs::kPendingJarWipes).size());
+
+  RegistryEntry back(SpaceId::GenerateNew(), "Back", kBlue);
+  back.profile_id = jar;
+  back.isolated = true;
+  registry().AddExisting(back);
+  popup->GetTabStripModel()->CloseAllTabs();
+
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return prefs->GetList(stedding::prefs::kPendingJarWipes).empty();
+  })) << "the wipe never ran";
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(WasWiped(ConfigFor(jar), url)) << "a jar a Space names";
+}
