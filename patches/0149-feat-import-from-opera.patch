+// file is read up to what the device's left of the cap. Blocking.
+ChromiumBookmarks ReadProfileBookmarks(const base::FilePath& profile_dir) {
+  ChromiumBookmarks out =
+      ReadChromiumBookmarks(profile_dir.Append(FILE_PATH_LITERAL("Bookmarks")));
+  ChromiumBookmarks account = ReadChromiumBookmarks(
+      profile_dir.Append(FILE_PATH_LITERAL("AccountBookmarks")),
+      kMaxChromiumBookmarks -
+          std::min(out.entries.size(), kMaxChromiumBookmarks));
+  std::set<std::tuple<bool, std::vector<std::u16string>, std::string>> pages;
+  for (const ImportedBookmarkEntry& entry : out.entries) {
+    if (!entry.is_folder) {
+      pages.insert(
+          std::make_tuple(entry.in_toolbar, entry.path, entry.url.spec()));
+    }
+  }
+  for (ImportedBookmarkEntry& entry : account.entries) {
+    if (!entry.is_folder &&
+        pages.contains(std::make_tuple(entry.in_toolbar, entry.path,
+                                       entry.url.spec()))) {
+      continue;
+    }
+    out.entries.push_back(std::move(entry));
+  }
+  out.left_out += account.left_out;
+  out.unreadable = out.unreadable || account.unreadable;
+  return out;
+}
