 class PeekOverPageTest : public InProcessBrowserTest {
  protected:
+  // The PNG files a capture left in `folder`.
+  static std::vector<base::FilePath> PngsIn(const base::FilePath& folder) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    std::vector<base::FilePath> found;
+    base::FileEnumerator files(folder, /*recursive=*/false,
+                               base::FileEnumerator::FILES,
+                               FILE_PATH_LITERAL("*.png"));
+    for (base::FilePath path = files.Next(); !path.empty();
+         path = files.Next()) {
+      found.push_back(path);
+    }
+    return found;
+  }
