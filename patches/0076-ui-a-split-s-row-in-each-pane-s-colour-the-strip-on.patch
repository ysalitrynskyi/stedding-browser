+// T31, T3, Dk8: the colour of the row over `contents` -- its top edge's
+// when the edge was read as one colour, else its declared theme colour, else
+// its background -- and in `edge_read` whether the edge has been read at all.
+std::optional<SkColor> PageColourOf(content::WebContents& contents,
+                                    bool& edge_read) {
+  const PageTopSample* const sample =
+      PageTopSample::GetForPage(contents.GetPrimaryPage());
+  edge_read = sample;
+  if (sample && sample->color) {
+    return sample->color;
+  }
+  std::optional<SkColor> page = contents.GetThemeColor();
+  if (page) {
+    // dark-pages Dk8: the declared colour is the author's, which dark
+    // pages does not darken; the document background already is.
+    page = PageThemeColorController::RowColorForThemeColor(
+        *page, DarkPagesApplyTo(&contents));
+  } else {
+    page = contents.GetBackgroundColor();
+  }
+  if (!page || SkColorGetA(*page) == SK_AlphaTRANSPARENT) {
+    return std::nullopt;
+  }
+  // The bar is an opaque surface.
+  return SkColorSetA(*page, SK_AlphaOPAQUE);
+}
