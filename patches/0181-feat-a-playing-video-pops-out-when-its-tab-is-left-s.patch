@@ -0,0 +1,141 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/video_pop_out.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/split_tab_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/web_contents.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+
+namespace stedding {
+
+namespace {
+
+using media_session::mojom::MediaAudioVideoState;
+using media_session::mojom::MediaPictureInPictureState;
+using media_session::mojom::MediaPlaybackState;
+using media_session::mojom::MediaSessionAction;
+
+bool ShowsPictureInPicture(content::WebContents* contents) {
+  return contents->HasPictureInPictureVideo() ||
+         contents->HasPictureInPictureDocument();
+}
+
+}  // namespace
+
+VideoPopOut::VideoPopOut(BrowserWindowInterface& browser) : browser_(browser) {
+  if (TabStripModel* const strip = browser.GetTabStripModel()) {
+    strip->AddObserver(this);
+  }
+}
+
+VideoPopOut::~VideoPopOut() = default;
+
+// static
+bool VideoPopOut::PlaysVideoWithSound(content::WebContents* contents) {
+  if (!contents || contents->IsAudioMuted() ||
+      ShowsPictureInPicture(contents)) {
+    return false;
+  }
+  // GetIfExists: asking creates no session for a page that never played.
+  content::MediaSession* const session =
+      content::MediaSession::GetIfExists(contents);
+  if (!session) {
+    return false;
+  }
+  const media_session::mojom::MediaSessionInfoPtr info =
+      session->GetMediaSessionInfoSync();
+  if (!info || info->playback_state != MediaPlaybackState::kPlaying ||
+      info->muted ||
+      info->picture_in_picture_state ==
+          MediaPictureInPictureState::kInPictureInPicture ||
+      !info->audio_video_states ||
+      !std::ranges::contains(*info->audio_video_states,
+                             MediaAudioVideoState::kAudioVideo)) {
+    return false;
+  }
+  // The signal Chromium's media controls draw their picture-in-picture
+  // button from, as the key reads it (Mp5).
+  return std::ranges::contains(session->GetMediaSessionActionsSync(),
+                               MediaSessionAction::kEnterPictureInPicture);
+}
+
+void VideoPopOut::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (!selection.active_tab_changed()) {
+    return;
+  }
+  // Mp4: its tab is shown again, and the video goes back into the page,
+  // playing on.
+  if (popped_ && IsShown(popped_.get())) {
+    content::WebContents* const page = popped_.get();
+    popped_.reset();
+    if (ShowsPictureInPicture(page)) {
+      content::MediaSession::Get(page)->ExitPictureInPicture();
+    }
+  }
+  if (!IsOn()) {
+    return;
+  }
+  content::WebContents* const left = selection.old_contents;
+  if (!left || left == selection.new_contents || IsShown(left)) {
+    return;
+  }
+  // A tab being closed is not left: its page goes with it.
+  if (change.type() == TabStripModelChange::kRemoved) {
+    for (const TabStripModelChange::RemovedTab& removed :
+         change.GetRemove()->contents) {
+      if (removed.contents == left) {
+        return;
+      }
+    }
+  }
+  if (!PlaysVideoWithSound(left)) {
+    return;
+  }
+  content::MediaSession::Get(left)->EnterPictureInPicture();
+  popped_ = left->GetWeakPtr();
+}
+
+bool VideoPopOut::IsShown(content::WebContents* contents) const {
+  TabStripModel* const strip = browser_->GetTabStripModel();
+  tabs::TabInterface* const active = strip ? strip->GetActiveTab() : nullptr;
+  if (!active || !contents) {
+    return false;
+  }
+  if (active->GetContents() == contents) {
+    return true;
+  }
+  if (!active->IsSplit()) {
+    return false;
+  }
+  split_tabs::SplitTabData* const split =
+      strip->GetSplitData(*active->GetSplit());
+  if (!split) {
+    return false;
+  }
+  const std::vector<tabs::TabInterface*> panes = split->ListTabs();
+  return std::ranges::any_of(panes, [contents](tabs::TabInterface* pane) {
+    return pane->GetContents() == contents;
+  });
+}
+
+bool VideoPopOut::IsOn() const {
+  Profile* const profile = browser_->GetProfile();
+  return profile && profile->GetPrefs()->GetBoolean(prefs::kPlayerPopOut);
+}
+
+}  // namespace stedding
