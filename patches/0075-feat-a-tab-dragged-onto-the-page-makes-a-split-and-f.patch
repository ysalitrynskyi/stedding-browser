+
+namespace views {
+class View;
+}  // namespace views
+
+namespace spaces {
+
+class SpaceModel;
+
+// docs/features/splits.md J10-J15 (BACKLOG S-113, GitHub issue 7): a tab
+// dragged from either tab strip -- a sidebar row, a horizontal tab -- onto
+// the page makes a split of it and the page that was on screen when the
+// drag began.
+//
+// While the pointer is over the page that page is on screen again (the press
+// that began the drag had selected the dragged tab), and the half the
+// dropped page would take is lit in the Space's colour. The dragged tabs stay
+// attached and hold their places, so the strip is not reordered and no window
+// opens. A drop makes the split in place, with nothing detached; the dropped
+// page is the active pane.
+class PageSplitDragTarget : public TabDragTarget {
+ public:
+  DECLARE_USER_DATA(PageSplitDragTarget);
+
+  PageSplitDragTarget(BrowserView& browser_view, SpaceModel& model);
+  PageSplitDragTarget(const PageSplitDragTarget&) = delete;
+  PageSplitDragTarget& operator=(const PageSplitDragTarget&) = delete;
+  ~PageSplitDragTarget() override;
+
+  static PageSplitDragTarget* From(BrowserWindowInterface* browser);
+
+  // The target for a tab drag at `point_in_screen` over `browser_view`'s
+  // window, once the strips' own targets have declined it: this window's,
+  // anywhere in the window (J14), or null -- no Spaces, or Chrome's "split
+  // view drag and drop" switch off (J15). BrowserView::GetTabDragTarget asks
+  // it, for either tab strip.
+  static TabDragTarget* ForPoint(BrowserView& browser_view,
+                                 const gfx::Point& point_in_screen);
+
+  // TabDragTarget:
+  void OnTabDragEntered() override;
+  TabDragContext* OnTabDragUpdated(TabDragTarget::DragController& controller,
+                                   const gfx::Point& point_in_screen) override;
+  void OnTabDragExited(const gfx::Point& point_in_screen) override;
+  void OnTabDragEnded() override;
+  bool CanDropTab() override;
+  void HandleTabDrop(DragController& controller) override;
+  bool HoldsAttachedTabs() const override;
+  base::CallbackListSubscription RegisterWillDestroyCallback(
+      base::OnceClosure callback) override;
+
+  // The side lit for the drop, if any, and where its highlight is drawn.
+  std::optional<stedding::SplitDropSide> lit_side() const { return lit_side_; }
+  gfx::Rect GetHighlightBoundsInScreenForTesting() const;
+
+ private:
+  // The page's bounds on screen: the contents area, both panes of a split.
+  gfx::Rect PageBoundsInScreen() const;
+  // Puts the page back on screen, or the dragged tab once the drag leaves.
+  void ShowPage();
+  void ShowDraggedTab();
+  // Lights `side`'s half, or none.
+  void Light(std::optional<stedding::SplitDropSide> side);
+  // J11: the split of the two, the dropped page on `side`; posted by
+  // HandleTabDrop.
+  void MakeSplit(tabs::TabHandle dragged,
+                 tabs::TabHandle page,
+                 stedding::SplitDropSide side);
+
+  const raw_ref<BrowserView> browser_view_;
+  const raw_ref<SpaceModel> model_;
+  ui::ScopedUnownedUserData<PageSplitDragTarget> scoped_user_data_;
+  // While a drop is possible: the dragged tab and the page it would join.
+  tabs::TabHandle dragged_;
+  tabs::TabHandle page_;
+  // Whether the page is on screen because of this drag.
+  bool showed_page_ = false;
+  std::optional<stedding::SplitDropSide> lit_side_;
+  // The highlight, a child of the browser view while it shows.
+  views::ViewTracker highlight_;
+  base::OnceClosureList will_destroy_callbacks_;
+  base::WeakPtrFactory<PageSplitDragTarget> weak_factory_{this};
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SPACES_PAGE_SPLIT_DRAG_TARGET_H_
