+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_PIN_HOME_H_
+#define CHROME_BROWSER_UI_STEDDING_PIN_HOME_H_
+
+#include "url/gurl.h"
+
+namespace stedding {
+
+// docs/features/pins.md H13 (PLAN.md TAB-17): the one rule for a pin's home
+// page. Only a web page, http or https, may be one. A pin goes home by
+// loading it, so a javascript: home would run script in the pin's page and a
+// file: home would open a local file, and a browser page is no site to come
+// back to. Every way a home comes in -- pinning, "Make This the Pinned Page",
+// the session, the Arc importer, a sidebar file -- and every use of one asks
+// this. A pin whose page is anything else stays a pin, without a home.
+bool IsAllowedPinHome(const GURL& url);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_PIN_HOME_H_
