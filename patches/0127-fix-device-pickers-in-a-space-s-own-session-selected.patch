+// site-controls Si15, sidebar Y51 (BACKLOG S-414, GitHub issue 45, a comment
+// on 0.4.0 beta 8): while the sidebar's top line is too narrow for Back,
+// Forward and Reload, the site panel's strip starts with them, and they run
+// the window's commands; with them on the line, the strip has none. The keys
+// were the three's only place.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, ThePanelHasThePagesButtonsOffTheLine) {
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Page("a.test", "/title1.html")));
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Page("b.test", "/title2.html")));
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !browser_view()->IsToolbarVisible(); }));
+  Settle();
+  ASSERT_TRUE(Shows(nav()));
+
+  stedding::SidebarAddressField* const address = field();
+  ASSERT_TRUE(address);
+  const auto open_strip = [&]() -> stedding::SiteControlsStripView* {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    if (!browser_view()->ShowSteddingSitePanel(
+            address->site_button_for_testing())) {
+      return nullptr;
+    }
+    views::BubbleDialogDelegateView* const panel =
+        PageInfoBubbleViewBase::GetPageInfoBubbleForTesting();
+    if (!panel) {
+      return nullptr;
+    }
+    return views::AsViewClass<stedding::SiteControlsStripView>(
+        views::ElementTrackerViews::GetInstance()->GetFirstMatchingView(
+            stedding::SiteControlsStripView::kElementId,
+            views::ElementTrackerViews::GetContextForView(
+                panel->GetContentsView())));
+  };
+  const auto close_panel = [&]() {
+    if (views::BubbleDialogDelegateView* const panel =
+            PageInfoBubbleViewBase::GetPageInfoBubbleForTesting()) {
+      panel->GetWidget()->CloseNow();
+    }
+  };
+
+  {
+    SCOPED_TRACE("the line has the three");
+    stedding::SiteControlsStripView* const strip = open_strip();
+    ASSERT_TRUE(strip) << "no site panel strip";
+    EXPECT_FALSE(strip->back()->GetVisible());
+    EXPECT_FALSE(strip->forward()->GetVisible());
+    EXPECT_FALSE(strip->reload()->GetVisible());
+    close_panel();
+  }
+
+  bool stepped_out = false;
+  for (int width = 400; width >= 160 && !stepped_out; width -= 10) {
+    controller()->SetUncollapsedWidth(width);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(browser_view()->GetWidget());
+      return region()->width() <= width + 24;
+    })) << "the sidebar did not narrow to " << width;
+    stepped_out = !Shows(nav());
+  }
+  ASSERT_TRUE(stepped_out) << "Back, Forward and Reload never stepped out";
+  ASSERT_TRUE(Shows(address->site_button_for_testing()));
+
+  stedding::SiteControlsStripView* const strip = open_strip();
+  ASSERT_TRUE(strip) << "no site panel strip on the narrow line";
+  EXPECT_TRUE(strip->back()->GetVisible()) << "the panel has no Back";
+  EXPECT_TRUE(strip->forward()->GetVisible());
+  EXPECT_TRUE(strip->reload()->GetVisible());
+  EXPECT_TRUE(strip->back()->GetEnabled()) << "Back has a page to go to";
+  EXPECT_FALSE(strip->forward()->GetEnabled()) << "Forward has none";
+  EXPECT_LT(strip->back()->x(), strip->copy_link()->x())
+      << "the page's buttons do not come first";
+
+  // Back runs the window's Back.
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  content::TestNavigationObserver went_back(page);
+  Press(strip->back());
+  went_back.Wait();
+  EXPECT_EQ(Page("a.test", "/title1.html"), page->GetLastCommittedURL());
+  close_panel();
+}
+
+// sidebar Y51 (BACKLOG S-415, GitHub issue 45, a comment on 0.4.0 beta 8):
+// every button of the sidebar's top line and of its field draws its icon at
+// the centre of the button, where its hover circle is. Left aligned, the
+// 18 DIP icons sat at the border's 6 DIP inset, a DIP left of centre: a
+// pixel and more at 125%.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, EachButtonsIconIsCentred) {
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Page("a.test", "/title1.html")));
+  views::test::RunScheduledLayout(browser_view());
+
+  std::vector<views::View*> pending = {browser_view()};
+  int checked = 0;
+  while (!pending.empty()) {
+    views::View* const view = pending.back();
+    pending.pop_back();
+    for (views::View* const child : view->children()) {
+      pending.push_back(child);
+    }
+    auto* const button = views::AsViewClass<TopContainerButton>(view);
+    if (!button || !button->IsDrawn() || button->size().IsEmpty()) {
+      continue;
+    }
+    // The button's own image comes first; Downloads draws a badge after it.
+    views::View* image = nullptr;
+    for (views::View* const child : button->children()) {
+      if (views::IsViewClass<views::ImageView>(child)) {
+        image = child;
+        break;
+      }
+    }
+    if (!image || image->size().IsEmpty()) {
+      continue;
+    }
+    ++checked;
+    EXPECT_EQ(button->GetLocalBounds().CenterPoint(),
+              image->bounds().CenterPoint())
+        << button->GetClassName() << " \"" << button->GetTooltipText()
+        << "\" is " << button->size().ToString() << ", its icon at "
+        << image->bounds().ToString();
+  }
+  // The toggle, Back, Forward, Reload, the site button and Copy Link.
+  EXPECT_GE(checked, 6);
+}
