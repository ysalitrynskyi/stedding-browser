+}  // namespace
+
+std::u16string GroupTitle(Group group) {
+  switch (group) {
+    case Group::kSpaces:
+      return u"Sidebar and Spaces";
+    case Group::kTabs:
+      return u"Tabs and the bar";
+    case Group::kPage:
+      return u"Page";
+    case Group::kNavigation:
+      return u"Moving around";
+    case Group::kFind:
+      return u"Find";
+    case Group::kWindows:
+      return u"Windows and the app";
+    case Group::kDeveloper:
+      return u"Developer tools";
+    case Group::kTextEditing:
+      return u"Text editing";
+  }
+  return std::u16string();
+}
+
+base::span<const Entry> Catalog() {
+  return kEntries;
+}
+
+const Entry* EntryForCommand(int command) {
+  for (const Entry& entry : kEntries) {
+    if (entry.command == command) {
+      return &entry;
+    }
+    if (entry.flags & kFamily) {
+      for (int member : MembersOf(entry)) {
+        if (member == command) {
+          return &entry;
+        }
+      }
+    }
+  }
+  return nullptr;
+}
+
+const Entry* EntryForName(std::string_view name) {
+  for (const Entry& entry : kEntries) {
+    if (name == entry.name) {
+      return &entry;
+    }
+  }
+  return nullptr;
+}
+
+std::vector<int> MembersOf(const Entry& entry) {
+  if (entry.flags & kFamily) {
+    if (entry.command == IDC_SELECT_TAB_0) {
+      return std::vector<int>(std::begin(kRowNumberCommands),
+                              std::end(kRowNumberCommands));
+    }
+    if (entry.command == IDC_STEDDING_SPACE_1) {
+      return std::vector<int>(std::begin(kSpaceCommands),
+                              std::end(kSpaceCommands));
+    }
+  }
+  return {entry.command};
+}
+
+int LeaderOf(const Entry& entry) {
+  return entry.command == IDC_CYCLE_TO_PREV_TAB ? IDC_CYCLE_TO_NEXT_TAB : 0;
+}
+
+bool IsFixed(const Entry& entry) {
+  if (entry.flags & kFixed) {
+    return true;
+  }
+#if BUILDFLAG(IS_MAC)
+  if (entry.flags & kFixedOnMac) {
+    return true;
+  }
+#endif
+  return false;
+}
+
+bool CanRebind(const Entry& entry) {
+  return !IsFixed(entry) && !(entry.flags & (kFamily | kFollows | kHidden));
+}
+
+bool CanTurnOff(const Entry& entry) {
+  return !IsFixed(entry) && !(entry.flags & (kFollows | kHidden));
+}
+
+int ConflictCommand(int command) {
+  const Entry* const entry = EntryForCommand(command);
+  return entry && entry->alias_of ? entry->alias_of : command;
+}
+
+std::vector<Binding> DefaultBindings() {
+  std::vector<Binding> bindings;
+#if BUILDFLAG(IS_MAC)
+  for (const auto& [command, accelerator] : GetDefaultMacBindings()) {
+    bindings.push_back({command, FromAccelerator(accelerator)});
+  }
+#else
+  for (int command : {IDC_CUT, IDC_COPY, IDC_PASTE}) {
+    ui::Accelerator accelerator;
+    if (GetStandardAcceleratorForCommandId(command, &accelerator)) {
+      bindings.push_back({command, FromAccelerator(accelerator)});
+    }
+  }
+#endif
+  for (const AcceleratorMapping& mapping : GetDefaultAcceleratorList()) {
+    bindings.push_back(
+        {mapping.command_id, Chord(mapping.keycode, mapping.modifiers)});
+  }
+  return bindings;
+}
+
+std::vector<Chord> DefaultChordsFor(int command,
+                                    const std::vector<Binding>& defaults) {
+  std::vector<Chord> chords;
+  for (const Binding& binding : defaults) {
+    if (binding.command == command) {
+      AddUnique(chords, binding.chord);
+    }
+  }
+  return chords;
+}
+
+std::vector<Chord> DefaultChordsFor(int command) {
+  return DefaultChordsFor(command, DefaultBindings());
+}
+
+std::optional<Chord> DefaultMenuChordFor(int command) {
+  ui::Accelerator accelerator;
+#if BUILDFLAG(IS_MAC)
+  if (GetShippedMacAcceleratorForCommandId(command, &accelerator)) {
+    return FromAccelerator(accelerator);
+  }
+#else
+  if (GetStandardAcceleratorForCommandId(command, &accelerator)) {
+    return FromAccelerator(accelerator);
+  }
+  for (const AcceleratorMapping& mapping : GetDefaultAcceleratorList()) {
+    if (mapping.command_id == command) {
+      return Chord(mapping.keycode, mapping.modifiers);
+    }
+  }
+#endif
+  return std::nullopt;
+}
+
+}  // namespace stedding::shortcuts
