+// toolbar T41: a split row has one foreground for its two parts. Two light
+// pages give the near-black one light page gets, two dark ones white, and a
+// white page beside a dark one a grey with the same contrast against each,
+// where either extreme would vanish on one part.
+TEST(PageBarColorSupplierTest, ASplitRowsForegroundReadsOnBothParts) {
+  constexpr SkColor kPeach = SkColorSetRGB(0xFF, 0xE0, 0xB2);
+  constexpr SkColor kGitHubDark = SkColorSetRGB(0x0D, 0x11, 0x17);
+  constexpr SkColor kPlum = SkColorSetRGB(0x30, 0x20, 0x40);
+  EXPECT_EQ(color_utils::GetColorWithMaxContrast(SK_ColorWHITE),
+            SplitRowForeground(SK_ColorWHITE, kPeach));
+  EXPECT_EQ(SK_ColorWHITE, SplitRowForeground(kGitHubDark, kPlum));
+
+  const SkColor grey = SplitRowForeground(SK_ColorWHITE, kGitHubDark);
+  EXPECT_EQ(grey, SplitRowForeground(kGitHubDark, SK_ColorWHITE))
+      << "the order of the panes does not matter";
+  EXPECT_EQ(SkColorGetR(grey), SkColorGetG(grey));
+  EXPECT_EQ(SkColorGetG(grey), SkColorGetB(grey));
+  EXPECT_GT(color_utils::GetContrastRatio(grey, SK_ColorWHITE), 4.3f);
+  EXPECT_GT(color_utils::GetContrastRatio(grey, kGitHubDark), 4.3f);
+  EXPECT_LT(color_utils::GetContrastRatio(
+                color_utils::GetColorWithMaxContrast(SK_ColorWHITE),
+                kGitHubDark),
+            1.5f)
+      << "the near-black alone would vanish on the dark part";
+
+  // The supplier puts the shared colour on the row's icons and text; the
+  // focused field and the dropdown keep the active page's colour.
+  ui::ColorProviderKey key;
+  key.color_mode = ui::ColorProviderKey::ColorMode::kLight;
+  ui::ColorProvider provider;
+  PageBarColorSupplier split(SK_ColorWHITE, grey);
+  split.AddColorMixers(&provider, key);
+  provider.GenerateColorMapForTesting();
+  EXPECT_EQ(grey, provider.GetColor(kColorToolbarButtonIcon));
+  EXPECT_EQ(grey, provider.GetColor(kColorOmniboxText));
+  EXPECT_EQ(grey, provider.GetColor(kColorOmniboxActionIcon));
+  EXPECT_EQ(SK_ColorWHITE, provider.GetColor(kColorOmniboxResultsBackground));
+}
