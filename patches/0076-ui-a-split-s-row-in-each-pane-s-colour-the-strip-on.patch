+    })) << SplitRowReads(view(), colour_of(dark), colour_of(light)).message();
+  }
+  {
+    SCOPED_TRACE("the other pane navigates: both light, the icons dark");
+    ASSERT_NE(dark, tabs->GetActiveWebContents());
+    ASSERT_TRUE(content::NavigateToURL(dark, page("ffe0b2")));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return has(dark, SkColorSetRGB(0xff, 0xe0, 0xb2)) &&
+             SplitRowReads(view(), colour_of(dark), colour_of(light)) &&
+             icons() == color_utils::GetColorWithMaxContrast(SK_ColorWHITE);
+    })) << SplitRowReads(view(), colour_of(dark), colour_of(light)).message()
+        << "; the icons are " << color_utils::SkColorToRgbaString(icons());
+  }
+  {
+    SCOPED_TRACE("dark pages darkens both parts, and the icons go white");
+    stedding::SetDarkPagesOn(profile, true);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return row()->ColorOf(dark) && color_utils::IsDark(colour_of(dark)) &&
+             row()->ColorOf(light) && color_utils::IsDark(colour_of(light)) &&
+             SplitRowReads(view(), colour_of(dark), colour_of(light)) &&
+             icons() == SK_ColorWHITE;
