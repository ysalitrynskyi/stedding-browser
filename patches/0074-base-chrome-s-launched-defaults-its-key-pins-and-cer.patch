+using component_updater::PKIMetadataComponentInstallerService;
+
+// Each check visits a host of its own, so that no connection or verification
+// is reused from the check before. The test server's certificate names all.
+// A public authority's certificate names hosts under a real top-level domain;
+// one for a name like "a.test" is refused for that reason alone.
+constexpr char kLocalHost[] = "local.test";
+constexpr char kLocalGoogleHost[] = "local-pins.google.com";
+constexpr char kPublicHost[] = "public.example.com";
+constexpr char kPublicGoogleHost[] = "pins.google.com";
+constexpr char kStaleHost[] = "stale.example.com";
+
+int64_t SecondsSinceEpoch(base::Time time) {
+  return (time - base::Time::UnixEpoch()).InSeconds();
+}
+
+class CertificateChecksTest
+    : public InProcessBrowserTest,
+      public PKIMetadataComponentInstallerService::Observer {
+ protected:
+  // The certificate component, as it is on disk before the browser starts:
+  // a log list and a pin list, both dated now. The pin list names one key
+  // for every google.com site, a key no test certificate has, as Chrome's
+  // own list names Google's.
+  void SetUpInProcessBrowserTestFixture() override {
+    InProcessBrowserTest::SetUpInProcessBrowserTestFixture();
+    PKIMetadataComponentInstallerService::GetInstance()->AddObserver(this);
+    ASSERT_TRUE(component_dir_.CreateUniqueTempDir());
+
+    chrome_browser_certificate_transparency::CTConfig logs;
+    logs.mutable_log_list()->mutable_timestamp()->set_seconds(
+        SecondsSinceEpoch(base::Time::Now()));
+    ASSERT_TRUE(PKIMetadataComponentInstallerService::GetInstance()
+                    ->WriteCTDataForTesting(component_dir_.GetPath(),
+                                            logs.SerializeAsString()));
+
+    chrome_browser_key_pinning::PinList pins;
+    pins.mutable_timestamp()->set_seconds(SecondsSinceEpoch(base::Time::Now()));
+    chrome_browser_key_pinning::PinSet* const google = pins.add_pinsets();
+    google->set_name("google");
+    google->add_static_spki_hashes_sha256(std::string(32, '\x5a'));
+    chrome_browser_key_pinning::PinSetInfo* const pinned =
+        pins.add_host_pins();
+    pinned->set_hostname("google.com");
+    pinned->set_pinset_name("google");
+    pinned->set_include_subdomains(true);
+    // The component's file name, kKPConfigProtoFileName in
+    // pki_metadata_component_installer.cc.
+    ASSERT_TRUE(base::WriteFile(
+        component_dir_.GetPath().AppendASCII("kp_pinslist.pb"),
+        pins.SerializeAsString()));
+  }
+
+  void TearDownInProcessBrowserTestFixture() override {
+    PKIMetadataComponentInstallerService::GetInstance()->RemoveObserver(this);
+    InProcessBrowserTest::TearDownInProcessBrowserTestFixture();
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    net::EmbeddedTestServer::ServerCertificateConfig certificate;
+    certificate.dns_names = {kLocalHost, kLocalGoogleHost, kPublicHost,
+                             kPublicGoogleHost, kStaleHost};
+    https_.SetSSLConfig(certificate);
+    https_.AddDefaultHandlers(GetChromeTestDataDir());
+    ASSERT_TRUE(https_.Start());
+  }
+
+  // PKIMetadataComponentInstallerService::Observer:
+  void OnCTLogListConfigured() override { ++log_lists_loaded_; }
+
+  content::WebContents* page() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  // Visits `host` and returns the navigation's error: net::OK when the page
+  // loaded.
+  int Visit(const char* host) {
+    content::TestNavigationObserver observer(page());
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), https_.GetURL(host, "/title1.html")));
+    return observer.last_net_error_code();
+  }
+
+  net::CertStatus CertificateErrors() {
+    content::NavigationEntry* const entry =
+        page()->GetController().GetLastCommittedEntry();
+    return entry ? entry->GetSSL().cert_status & net::CERT_STATUS_ALL_ERRORS
+                 : 0;
+  }
+
+  int log_lists_loaded_ = 0;
+
+ private:
+  base::ScopedTempDir component_dir_;
+  net::EmbeddedTestServer https_{net::EmbeddedTestServer::TYPE_HTTPS};
+};
+
+IN_PROC_BROWSER_TEST_F(CertificateChecksTest,
+                       UnloggedAndUnpinnedCertificatesAreRefused) {
+  ASSERT_TRUE(SystemNetworkContextManager::IsCertificateTransparencyEnabled())
+      << "kCertificateTransparencyAskBeforeEnabling is off";
+  {
+    // The component's log list reached the certificate verifier; its pin
+    // list went to the network service on the same pass.
+    SCOPED_TRACE("the component's lists load");
+    ASSERT_TRUE(base::test::RunUntil([&]() { return log_lists_loaded_ > 0; }))
+        << "the component's log list was never loaded";
+    content::RunAllTasksUntilIdle();
+    content::FlushNetworkServiceInstanceForTesting();
+  }
+  {
+    SCOPED_TRACE("a root the user added needs no log and no pin");
+    EXPECT_EQ(net::OK, Visit(kLocalHost));
+    EXPECT_EQ(0u, CertificateErrors());
+    EXPECT_EQ(net::OK, Visit(kLocalGoogleHost));
+    EXPECT_EQ(0u, CertificateErrors());
+  }
+
+  // From here on the test server's root counts as a public authority's, as
+  // the roots in the root store do.
+  scoped_refptr<net::X509Certificate> root =
+      net::ImportCertFromFile(net::EmbeddedTestServer::GetRootCertPemPath());
+  ASSERT_TRUE(root);
+  net::ScopedTestKnownRoot public_root(root.get());
+  {
+    SCOPED_TRACE("a fresh log list refuses an unlogged certificate");
+    EXPECT_EQ(net::ERR_CERTIFICATE_TRANSPARENCY_REQUIRED, Visit(kPublicHost));
+    ssl_test_util::CheckSecurityState(
+        page(), net::CERT_STATUS_CERTIFICATE_TRANSPARENCY_REQUIRED,
+        security_state::DANGEROUS,
+        ssl_test_util::AuthState::SHOWING_INTERSTITIAL);
+  }
+  {
+    // The pin error wins over the log error the same connection has.
+    SCOPED_TRACE("a Google site refuses a key Google did not pin");
+    EXPECT_EQ(net::ERR_SSL_PINNED_KEY_NOT_IN_CERT_CHAIN,
+              Visit(kPublicGoogleHost));
+    EXPECT_TRUE(CertificateErrors() & net::CERT_STATUS_PINNED_KEY_MISSING);
+  }
+  {
+    // Ten weeks without an update: Chromium stops enforcing rather than
+    // refuse certificates from logs it no longer knows.
+    SCOPED_TRACE("a stale log list enforces nothing");
+    base::test::TestFuture<void> loaded;
+    content::GetCertVerifierServiceFactory()->UpdateCtLogList(
+        {}, base::Time::Now() - base::Days(71), loaded.GetCallback());
+    ASSERT_TRUE(loaded.Wait());
+    EXPECT_EQ(net::OK, Visit(kStaleHost));
+    EXPECT_EQ(0u, CertificateErrors());
+  }
+}
+
+// Three SCTs a public certificate carries, from three logs.
+void AddScts(net::SignedCertificateTimestampAndStatusList* scts) {
+  for (char log : {'\x01', '\x02', '\x03'}) {
+    auto sct = base::MakeRefCounted<net::ct::SignedCertificateTimestamp>();
+    sct->version = net::ct::SignedCertificateTimestamp::V1;
+    sct->log_id = std::string(32, log);
+    sct->timestamp = base::Time::Now();
+    sct->signature.signature_data = std::string("signature") + log;
+    sct->origin = net::ct::SignedCertificateTimestamp::SCT_EMBEDDED;
+    scts->push_back(
+        net::SignedCertificateTimestampAndStatus(sct, net::ct::SCT_STATUS_OK));
+  }
+}
