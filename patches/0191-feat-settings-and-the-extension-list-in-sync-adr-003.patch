+std::string DeclineKey(std::string_view install, std::string_view id) {
+  std::string key(install);
+  key += '/';
+  key += id;
+  return key;
+}
+
+std::vector<ExtensionOffer> ExtensionOffers(
+    const std::map<std::string, std::vector<ExtensionEntry>>& peers,
+    const std::set<std::string>& installed_here,
+    const std::set<std::string>& declined,
+    const std::set<std::string>& uninstalled_here) {
+  std::map<std::string, ExtensionOffer> by_id;
+  for (const auto& [install, list] : peers) {
+    for (const ExtensionEntry& entry : list) {
+      if (installed_here.contains(entry.id) ||
+          uninstalled_here.contains(entry.id) ||
+          declined.contains(DeclineKey(install, entry.id))) {
+        continue;
+      }
+      ExtensionOffer& offer = by_id[entry.id];
+      offer.id = entry.id;
+      if (offer.name.empty()) {
+        offer.name = entry.name;
+      }
+      offer.installs.push_back(install);
+    }
+  }
+  std::vector<ExtensionOffer> out;
+  for (auto& [id, offer] : by_id) {
+    out.push_back(std::move(offer));
+  }
+  return out;
+}
