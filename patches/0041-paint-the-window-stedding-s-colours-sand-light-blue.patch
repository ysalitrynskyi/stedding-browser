+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_WINDOW_BACKGROUND_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_WINDOW_BACKGROUND_H_
+
+#include "ui/views/background.h"
+
+namespace stedding {
+
+// The ground every piece of window chrome sits on: a #21263A to #31243A
+// gradient running top-left to bottom-right in dark mode, flat #C8B377 sand in
+// light. The sidebar, the top container and the content mat are transparent in
+// Arc mode, so this paints once for all of them and nothing seams.
+class SteddingWindowBackground : public views::Background {
+ public:
+  SteddingWindowBackground();
+  ~SteddingWindowBackground() override;
+
+  // views::Background:
+  void Paint(gfx::Canvas* canvas, views::View* view) const override;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_WINDOW_BACKGROUND_H_
