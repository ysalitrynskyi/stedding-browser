+bool TabStripCollection::MoveTabsIntoFolderAtChild(
+    const std::vector<int>& tab_indices,
+    FolderTabCollection* folder,
+    size_t child_index) {
+  if (!CanMoveTabsIntoFolder(tab_indices, folder)) {
+    return false;
+  }
+  // A strip index inside a split or a nested folder is not this. That path
+  // (MoveTabsIntoFolderAtRecursive) descends, and a slot in the middle of a
+  // split has no position there: the index walks past it and CHECKs. The
+  // slot lands before that row, which is a direct child of this folder.
+  if (child_index > folder->ChildCount()) {
+    child_index = folder->ChildCount();
+  }
+  MoveNodesIntoFolder(
+      GetTabsAndCollectionsForMove(tab_indices, FolderMoveRetainSet()), folder,
+      {folder->GetHandle(), child_index});
+  return true;
+}
