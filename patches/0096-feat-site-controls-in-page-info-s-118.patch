+using Action = SiteControlsStripView::Action;
+using PictureInPicture = SiteControlsStripView::PictureInPicture;
+
+// The window's chords as a test sets them, and every action run.
+class FakeStripDelegate : public SiteControlsStripView::Delegate {
+ public:
+  explicit FakeStripDelegate(SiteControlsStripView::State* state,
+                             std::vector<Action>* runs)
+      : state_(state), runs_(runs) {}
+
+  SiteControlsStripView::State GetState() override { return *state_; }
+  std::u16string ChordFor(int command_id) override {
+    switch (command_id) {
+      case IDC_COPY_URL:
+        return u"Shift+Ctrl+C";
+      case IDC_STEDDING_TOGGLE_TAB_MUTED:
+        return u"Ctrl+M";
+      case IDC_STEDDING_TOGGLE_PICTURE_IN_PICTURE:
+        return u"Ctrl+Alt+Shift+P";
+      case IDC_ZOOM_MINUS:
+        return u"Ctrl+Minus";
+      case IDC_ZOOM_NORMAL:
+        return u"Ctrl+0";
+      case IDC_ZOOM_PLUS:
+        return u"Ctrl+Plus";
+      default:
+        return std::u16string();
+    }
+  }
+  void Run(Action action) override { runs_->push_back(action); }
+
+ private:
+  raw_ptr<SiteControlsStripView::State> state_;
+  raw_ptr<std::vector<Action>> runs_;
+};
+
+class FakeRowsDelegate : public SiteControlsRowsView::Delegate {
+ public:
+  explicit FakeRowsDelegate(SiteControlsRowsView::State* state)
+      : state_(state) {}
+
+  SiteControlsRowsView::State GetState() override { return *state_; }
+  void ClearSiteData() override { ++clears_; }
+  void SetDarkPagesOn(bool on) override { state_->dark_pages_on = on; }
+  void SetSiteDarkened(bool darkened) override {
+    state_->site_darkened = darkened;
+  }
+
+  int clears_ = 0;
+
+ private:
+  raw_ptr<SiteControlsRowsView::State> state_;
+};
+
+class SiteControlsViewTest : public ChromeViewsTestBase {
+ protected:
+  void SetUp() override {
+    ChromeViewsTestBase::SetUp();
+    widget_ = CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    auto panel = std::make_unique<views::View>();
+    panel->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical));
+    strip_ = panel->AddChildView(std::make_unique<SiteControlsStripView>(
+        std::make_unique<FakeStripDelegate>(&strip_state_, &runs_)));
+    rows_state_.session = SessionName{u"Work · Independent session", true};
+    rows_state_.clear_data = true;
+    rows_state_.dark_switch = true;
+    rows_state_.dark_pages_on = true;
+    rows_state_.dark_site = u"example.com";
+    auto rows_delegate = std::make_unique<FakeRowsDelegate>(&rows_state_);
+    rows_delegate_ = rows_delegate.get();
+    rows_ = panel->AddChildView(
+        std::make_unique<SiteControlsRowsView>(std::move(rows_delegate)));
+    widget_->SetContentsView(std::move(panel));
+    widget_->SetBounds(gfx::Rect(0, 0, 360, 400));
+    widget_->Show();
+  }
+
+  void TearDown() override {
+    strip_ = nullptr;
+    rows_ = nullptr;
+    rows_delegate_ = nullptr;
+    widget_.reset();
+    ChromeViewsTestBase::TearDown();
+  }
+
+  static std::u16string NameOf(views::View* view) {
+    return view->GetViewAccessibility().GetCachedName();
+  }
+
+  SiteControlsStripView::State strip_state_;
+  std::vector<Action> runs_;
+  SiteControlsRowsView::State rows_state_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<SiteControlsStripView> strip_ = nullptr;
+  raw_ptr<SiteControlsRowsView> rows_ = nullptr;
+  raw_ptr<FakeRowsDelegate> rows_delegate_ = nullptr;
+};
+
+// site-controls Si2, Si4, Si5, Si11: every control is named for its action,
+// and its tooltip adds the window's chord when it has one; Mute and Picture
+// in picture take the words of what they would do; the zoom is a button
+// named for the reset with the percentage; an Option-click (Alt-click) on
+// Copy link asks for the Markdown link.
+TEST_F(SiteControlsViewTest, EveryControlIsNamedAndShowsItsChord) {
+  EXPECT_EQ(u"Copy link", NameOf(strip_->copy_link()));
+  EXPECT_EQ(u"Copy link (Shift+Ctrl+C)", strip_->copy_link()->GetTooltipText());
+  EXPECT_EQ(u"Copy title", NameOf(strip_->copy_title()));
+  EXPECT_EQ(u"Copy title", strip_->copy_title()->GetTooltipText())
+      << "Copy title has no chord";
+  EXPECT_EQ(u"Mute tab", NameOf(strip_->mute()));
+  EXPECT_EQ(u"Mute tab (Ctrl+M)", strip_->mute()->GetTooltipText());
+  EXPECT_EQ(u"Picture in picture", NameOf(strip_->picture_in_picture()));
+  EXPECT_FALSE(strip_->picture_in_picture()->GetEnabled())
+      << "nothing to put in picture in picture";
+  EXPECT_EQ(u"Zoom out", NameOf(strip_->zoom_out()));
+  EXPECT_EQ(u"Zoom out (Ctrl+Minus)", strip_->zoom_out()->GetTooltipText());
+  EXPECT_EQ(u"Zoom in (Ctrl+Plus)", strip_->zoom_in()->GetTooltipText());
+  EXPECT_EQ(u"100%", strip_->zoom_reset()->GetText());
+  EXPECT_EQ(u"Reset zoom, 100%", NameOf(strip_->zoom_reset()));
+  EXPECT_EQ(u"Reset zoom (Ctrl+0)", strip_->zoom_reset()->GetTooltipText());
+
+  strip_state_.mute_would_mute = false;
+  strip_state_.picture_in_picture = PictureInPicture::kExit;
+  strip_state_.zoom_percent = 110;
+  strip_state_.copy_link_enabled = false;
+  strip_->Update();
+  EXPECT_EQ(u"Unmute tab", NameOf(strip_->mute()));
+  EXPECT_EQ(u"Unmute tab (Ctrl+M)", strip_->mute()->GetTooltipText());
+  EXPECT_EQ(u"Exit picture in picture", NameOf(strip_->picture_in_picture()));
+  EXPECT_TRUE(strip_->picture_in_picture()->GetEnabled());
+  EXPECT_EQ(u"110%", strip_->zoom_reset()->GetText());
+  EXPECT_EQ(u"Reset zoom, 110%", NameOf(strip_->zoom_reset()));
+  EXPECT_FALSE(strip_->copy_link()->GetEnabled())
+      << "the policy that turns off the command turns off the button";
+  strip_state_.copy_link_enabled = true;
+  strip_->Update();
+
+  const ui::MouseEvent click(
+      ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+      base::TimeTicks(), ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+  const ui::MouseEvent alt_click(ui::EventType::kMousePressed, gfx::Point(),
+                                 gfx::Point(), base::TimeTicks(),
+                                 ui::EF_LEFT_MOUSE_BUTTON | ui::EF_ALT_DOWN,
+                                 ui::EF_LEFT_MOUSE_BUTTON);
+  views::test::ButtonTestApi(strip_->copy_link()).NotifyClick(click);
+  views::test::ButtonTestApi(strip_->copy_link()).NotifyClick(alt_click);
+  views::test::ButtonTestApi(strip_->copy_title()).NotifyClick(click);
+  views::test::ButtonTestApi(strip_->mute()).NotifyClick(click);
+  views::test::ButtonTestApi(strip_->zoom_in()).NotifyClick(click);
+  views::test::ButtonTestApi(strip_->zoom_reset()).NotifyClick(click);
+  EXPECT_EQ((std::vector<Action>{Action::kCopyLink, Action::kCopyMarkdownLink,
+                                 Action::kCopyTitle, Action::kToggleMute,
+                                 Action::kZoomIn, Action::kZoomReset}),
+            runs_);
+
+  // Si7, Si9: the rows' names.
+  EXPECT_EQ(u"Work · Independent session",
+            rows_->session_row()->GetTitleForTesting());
+  EXPECT_EQ(u"Work · Independent session", NameOf(rows_->session_row()));
+  EXPECT_EQ(spaces::IsolationMarkDescription(),
+            rows_->session_row()->GetViewAccessibility().GetCachedDescription())
+      << "the mark's meaning, read once with the row";
+  EXPECT_EQ(spaces::IsolationMarkDescription(),
+            rows_->session_row()->GetTooltipText());
+  EXPECT_TRUE(rows_->session_mark()->GetVisible());
+  EXPECT_EQ(u"Clear site data…", rows_->clear_data()->GetTitleText());
+  EXPECT_EQ(u"Dark pages", NameOf(rows_->dark_pages()));
+  EXPECT_TRUE(rows_->dark_pages()->GetIsOn());
+  EXPECT_EQ(u"Darken example.com", NameOf(rows_->dark_site()));
+  EXPECT_EQ(u"Darken example.com",
+            rows_->dark_site_row()->GetTitleForTesting());
+}
+
+// site-controls Si7-Si9: the rows follow their state: the shared session has
+// no mark and no description; Clear goes on a page with no site; Darken
+// <site> goes when dark pages is off and comes back when it is on; the
+// switches report what they were turned to.
+TEST_F(SiteControlsViewTest, TheRowsFollowTheirState) {
+  rows_state_.session = SessionName{u"Shared session", false};
+  rows_state_.clear_data = false;
+  rows_state_.dark_pages_on = false;
+  rows_state_.dark_site.reset();
+  rows_->Update();
+  EXPECT_EQ(u"Shared session", rows_->session_row()->GetTitleForTesting());
+  EXPECT_FALSE(rows_->session_mark()->GetVisible());
+  EXPECT_TRUE(rows_->session_row()
+                  ->GetViewAccessibility()
+                  .GetCachedDescription()
+                  .empty());
+  EXPECT_FALSE(rows_->clear_data()->GetVisible());
+  EXPECT_TRUE(rows_->dark_pages_row()->GetVisible());
+  EXPECT_FALSE(rows_->dark_pages()->GetIsOn());
+  EXPECT_FALSE(rows_->dark_site_row()->GetVisible());
+
+  views::test::ButtonTestApi(rows_->dark_pages())
+      .NotifyClick(ui::MouseEvent(ui::EventType::kMousePressed, gfx::Point(),
+                                  gfx::Point(), base::TimeTicks(),
+                                  ui::EF_LEFT_MOUSE_BUTTON,
+                                  ui::EF_LEFT_MOUSE_BUTTON));
+  EXPECT_TRUE(rows_state_.dark_pages_on) << "the switch turned on reports on";
+
+  rows_state_.session.reset();
+  rows_->Update();
+  EXPECT_FALSE(rows_->session_row()->GetVisible())
+      << "a private window and a Blank Window have no session row";
+}
+
+// site-controls Si11: Tab goes through the strip in order -- the copies,
+// mute, picture in picture, then the zoom -- and on to the rows: Clear site
+// data, then the switches.
+TEST_F(SiteControlsViewTest, TabOrderFollowsThePanel) {
+  strip_state_.picture_in_picture = PictureInPicture::kEnter;
+  strip_->Update();
+  views::FocusManager* const focus = widget_->GetFocusManager();
+  focus->SetKeyboardAccessible(true);
+  std::vector<views::View*> order;
+  views::View* view = nullptr;
+  for (int i = 0; i < 20; ++i) {
+    view = focus->GetNextFocusableView(view, widget_.get(), /*reverse=*/false,
+                                       /*dont_loop=*/true);
+    if (!view) {
+      break;
+    }
+    order.push_back(view);
+  }
+  const std::vector<views::View*> expected = {
+      strip_->copy_link(), strip_->copy_title(),
+      strip_->mute(),      strip_->picture_in_picture(),
+      strip_->zoom_out(),  strip_->zoom_reset(),
+      strip_->zoom_in(),   rows_->clear_data(),
+      rows_->dark_pages(), rows_->dark_site()};
+  EXPECT_EQ(expected, order);
+}
