+// found in the LICENSE file.
+
+// docs/features/site-controls.md (BACKLOG S-402, GitHub issue 73): a site's
+// request for a device shows Chromium's picker, as in Chrome. With an ESP32
+// attached, navigator.serial.requestPort() from a click rejected at once with
+// "No port selected by the user" and no picker showed. Web Serial, WebUSB,
+// WebHID and Web Bluetooth share that picker; each window state a page can
+// be in here -- a loose tab, a pinned tab, an essential, the address in the
+// sidebar -- is tried.
+
+#include <string>
+
+#include "base/test/run_until.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/serial/serial_chooser_context.h"
+#include "chrome/browser/serial/serial_chooser_context_factory.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/chooser_bubble_testapi.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "services/device/public/cpp/test/fake_serial_port_manager.h"
+#include "services/device/public/mojom/serial.mojom.h"
+
+namespace {
+
+// The request, raced against two seconds: a shown picker leaves it pending,
+// a refused one rejects at once with the error's name.
+constexpr char kRequestPort[] = R"(
+  Promise.race([
+    navigator.serial.requestPort({}).then(() => 'chosen', e => e.name),
+    new Promise(done => setTimeout(() => done('pending'), 2000)),
+  ]))";
+
+class DevicePickerTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    embedded_test_server()->ServeFilesFromSourceDirectory("content/test/data");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    mojo::PendingRemote<device::mojom::SerialPortManager> port_manager;
+    port_manager_.AddReceiver(port_manager.InitWithNewPipeAndPassReceiver());
+    SerialChooserContextFactory::GetForProfile(browser()->GetProfile())
+        ->SetPortManagerForTesting(std::move(port_manager));
+  }
+
+  // Opens the test page in a new tab on screen, and returns its contents.
+  content::WebContents* OpenPage() {
+    const GURL url =
+        embedded_test_server()->GetURL("localhost", "/simple_page.html");
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return browser()->tab_strip_model()->GetActiveWebContents();
+  }
+
+  // The picker shows for a request from `contents`, and closes again.
+  void ExpectThePicker(content::WebContents* contents) {
+    auto waiter = test::ChooserBubbleUiWaiter::Create();
+    EXPECT_EQ("pending", content::EvalJs(contents, kRequestPort))
+        << "the request was refused without a picker";
+    if (!waiter->has_shown()) {
+      waiter->WaitForChange();
+    }
+    EXPECT_TRUE(waiter->has_shown()) << "no picker showed";
+    // Leaving the page closes the picker, which rejects the request.
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  }
+
+ private:
+  device::FakeSerialPortManager port_manager_;
+};
+
+IN_PROC_BROWSER_TEST_F(DevicePickerTest, ASerialRequestShowsThePicker) {
+  {
+    SCOPED_TRACE("a tab of the Space");
+    ExpectThePicker(OpenPage());
+  }
+  {
+    SCOPED_TRACE("a pinned tab");
+    content::WebContents* const page = OpenPage();
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model);
+    model->SetSpacePinned(browser()->tab_strip_model()->GetActiveTab(), true);
+    ExpectThePicker(page);
+  }
+  {
+    SCOPED_TRACE("an essential");
+    content::WebContents* const page = OpenPage();
+    TabStripModel* const tabs = browser()->tab_strip_model();
+    tabs->SetTabPinned(tabs->GetIndexOfWebContents(page), true);
+    tabs->ActivateTabAt(tabs->GetIndexOfWebContents(page));
+    ExpectThePicker(page);
+  }
+  {
+    SCOPED_TRACE("the address in the sidebar");
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kSidebarAddressInSidebar, true);
+    ExpectThePicker(OpenPage());
+  }
+}
+
+}  // namespace
