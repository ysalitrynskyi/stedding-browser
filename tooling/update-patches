#!/usr/bin/env bash
# Regenerate patches/ from the commits on the working branch above the pin.
#
# Usage: tooling/update-patches
#
# The workflow this supports:
#   1. tooling/apply-patches            — series becomes commits on stedding-work
#   2. edit, commit (or rebase/reorder) — commits are the source of truth here
#   3. tooling/update-patches           — commits become patches/ again
#
# Every commit must carry the header fields the project requires of a patch
# (docs/ARCHITECTURE.md, "Patch discipline"). They live in the commit message:
#
#     Subject line: one logical change
#
#     Prose explaining the change.
#
#     Why: the reason this patch exists at all.
#     Removable when: the condition that would let us delete this patch.
#
# The patch discipline in docs/ARCHITECTURE.md also asks which upstream files a patch
# touches. That is not a required field here because `git format-patch` writes a
# diffstat immediately under the message, which answers it exactly and cannot drift
# from the patch the way a hand-written list would.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

PATCH_DIR="$STEDDING_ROOT/patches"
WORK_BRANCH="stedding-work"

[ -d "$CHROMIUM_SRC/.git" ] || die "no checkout at $CHROMIUM_SRC — run tooling/sync-chromium"

cd "$CHROMIUM_SRC" || die "cannot enter $CHROMIUM_SRC"

current="$(git rev-parse --abbrev-ref HEAD)"
[ "$current" = "$WORK_BRANCH" ] \
  || die "expected to be on '$WORK_BRANCH', but the checkout is on '$current'"

base="$(git rev-parse "refs/tags/$CHROMIUM_TAG^{commit}")"
count="$(git rev-list --count "$base..HEAD")"
log "$count commit(s) on $WORK_BRANCH above $CHROMIUM_TAG"

if [ "$count" -eq 0 ]; then
  warn "nothing to export; leaving $PATCH_DIR untouched"
  exit 0
fi

# Reject commits missing the required header before writing anything, so the series
# on disk is never left half-valid.
missing=0
while read -r sha; do
  body="$(git log -1 --format=%B "$sha")"
  for field in "Why:" "Removable when:"; do
    case "$body" in
      *"$field"*) ;;
      *) warn "$(git log -1 --format='%h %s' "$sha") is missing '$field'"; missing=$(( missing + 1 )) ;;
    esac
  done
done < <(git rev-list --reverse "$base..HEAD")
[ "$missing" -eq 0 ] || die "$missing missing header field(s); fix the commit messages first"

log "regenerating $PATCH_DIR"
mkdir -p "$PATCH_DIR"
find "$PATCH_DIR" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.patch' -delete

git format-patch \
  --no-signature \
  --zero-commit \
  --no-numbered \
  --keep-subject \
  --output-directory "$PATCH_DIR" \
  "$base..HEAD" >/dev/null

# git format-patch numbers with as many digits as it needs; the project requires four.
for f in "$PATCH_DIR"/*.patch; do
  base_name="$(basename "$f")"
  num="${base_name%%-*}"
  rest="${base_name#*-}"
  padded="$(printf '%04d' "$((10#$num))")"
  [ "$base_name" = "$padded-$rest" ] || mv "$f" "$PATCH_DIR/$padded-$rest"
done

log "wrote $(find "$PATCH_DIR" -maxdepth 1 -name '*.patch' | wc -l | tr -d ' ') patch(es)"
log "verify with: tooling/check-repo patches"
