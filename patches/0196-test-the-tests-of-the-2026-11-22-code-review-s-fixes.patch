+
+constexpr SkColor kBlueB16 = SkColorSetRGB(0x00, 0x00, 0xFF);
+
+// Counts the navigations `contents` begins in its main frame. A reload is
+// one, and so is the load of a tab that had not loaded.
+class NavigationStartsB16 : public content::WebContentsObserver {
+ public:
+  explicit NavigationStartsB16(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+
+  int count() const { return count_; }
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame()) {
+      ++count_;
+    }
+  }
+
+ private:
+  int count_ = 0;
+};
+
+class SpaceWindowB16Test : public BrowserWithTestWindowTest {
+ protected:
+  SpaceModel& model() {
+    SpaceModel* const model = SpaceModel::From(browser());
+    CHECK(model) << "a normal window must own a SpaceModel";
+    return *model;
+  }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  SpaceRegistry& registry() {
+    return *SpaceRegistryFactory::GetForProfile(profile());
+  }
+  int IndexOf(tabs::TabInterface* tab) { return tabs().GetIndexOfTab(tab); }
+
+  // A tab opened the way the fixture opens one (foreground, index 0), loaded.
+  tabs::TabInterface* OpenTab(const GURL& url) {
+    AddTab(browser(), url);
+    return tabs().GetActiveTab();
+  }
+
+  content::StoragePartitionConfig ConfigFor(const std::string& jar) {
+    return *StoragePartitionConfigForProfileId(profile(), jar);
+  }
+
+  // A tab in the Space on screen whose page loaded in `jar`, as a page of a
+  // Space with that session does.
+  tabs::TabInterface* OpenInJar(const std::string& jar, const GURL& url) {
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContentsTester::CreateTestWebContents(
+            profile(), content::SiteInstance::CreateForFixedStoragePartition(
+                           profile(), url, ConfigFor(jar)));
+    content::WebContentsTester::For(contents.get())->NavigateAndCommit(url);
+    tabs().AppendTab(
+        std::make_unique<tabs::TabModel>(std::move(contents), &tabs()),
+        /*foreground=*/true);
+    return tabs().GetActiveTab();
+  }
+
+  // A Space pin made the way an import makes one: a tab that has not loaded,
+  // pinned in the Space on screen, its address taken as its home.
+  tabs::TabInterface* ImportPin(const GURL& url) {
+    tabs::TabInterface* const tab =
+        InsertUnloadedTab(&tabs(), profile(), url, u"Imported");
+    if (tab) {
+      model().SetSpacePinned(tab, true);
+    }
+    return tab;
+  }
+
+  // The first load of `tab`: asked for `asked`, sent on by the site to
+  // `landed`, and finished.
+  void LoadWithRedirect(tabs::TabInterface* tab,
+                        const GURL& asked,
+                        const GURL& landed) {
+    std::unique_ptr<content::NavigationSimulator> load =
+        content::NavigationSimulator::CreateBrowserInitiated(
+            asked, tab->GetContents());
+    load->Start();
+    load->Redirect(landed);
+    load->Commit();
+    task_environment()->RunUntilIdle();
+  }
+
+  static bool IsInAFolder(const tabs::TabInterface* tab) {
+    for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+         each = each->GetParentCollection()) {
+      if (each->type() == tabs::TabCollection::Type::FOLDER) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  static void PutCookie(content::BrowserContext* context,
+                        const content::StoragePartitionConfig& config,
+                        const GURL& url) {
+    content::StoragePartition* const partition =
+        context->GetStoragePartition(config);
+    ASSERT_TRUE(partition);
+    network::mojom::CookieManager* const cookies =
+        partition->GetCookieManagerForBrowserProcess();
+    std::unique_ptr<net::CanonicalCookie> cookie =
+        net::CanonicalCookie::CreateForTesting(
+            url, "k=v", base::Time::Now(), net::CookieSourceType::kOther);
+    ASSERT_TRUE(cookie);
+    net::CookieOptions options;
+    options.set_include_httponly();
+    options.set_same_site_cookie_context(
+        net::CookieOptions::SameSiteCookieContext::MakeInclusive());
+    base::RunLoop loop;
+    cookies->SetCanonicalCookie(*cookie, url, options,
+                                base::BindLambdaForTesting(
+                                    [&](net::CookieAccessResult) { loop.Quit(); }));
+    loop.Run();
+  }
+
+  static size_t CookieCount(content::BrowserContext* context,
+                            const content::StoragePartitionConfig& config,
+                            const GURL& url) {
+    content::StoragePartition* const partition =
+        context->GetStoragePartition(config);
+    if (!partition) {
+      return 0;
+    }
+    network::mojom::CookieManager* const cookies =
+        partition->GetCookieManagerForBrowserProcess();
+    net::CookieOptions options;
+    options.set_include_httponly();
+    options.set_same_site_cookie_context(
+        net::CookieOptions::SameSiteCookieContext::MakeInclusive());
+    base::RunLoop loop;
+    size_t n = 0;
+    cookies->GetCookieList(
+        url, options, net::CookiePartitionKeyCollection(),
+        base::BindLambdaForTesting(
+            [&](const net::CookieAccessResultList& included,
+                const net::CookieAccessResultList&) {
+              n = included.size();
+              loop.Quit();
+            }));
+    loop.Run();
+    return n;
+  }
+
+  bool WasWiped(const content::StoragePartitionConfig& config,
+                const GURL& url) {
+    return CookieCount(profile(), config, url) == 0u;
+  }
+};
+
+using SessionWipeB16Test = SpaceWindowB16Test;
+using PinHomeB16Test = SpaceWindowB16Test;
+using RoutingB16Test = SpaceWindowB16Test;
+
+// P18-1a, sessions S44: a wipe waiting for its jar to be left goes, when its
+// window closes, to the profile's window used last, a Blank Window too. That
+// window has no list of the profile's Spaces of its own, and the wipe is
+// still checked against the profile's when it runs: a Space that came to
+// name the jar meanwhile keeps its sign-ins. The Blank Window wiped them.
+TEST_F(SessionWipeB16Test, AWipeABlankWindowTakesOverSparesAJarNamedAgain) {
+  PrefService* const prefs = profile()->GetPrefs();
+  const SpaceId work = model().AddSpace("Work", kBlueB16)->id();
+  model().SetSpaceIsolated(work, true);
+  const std::string jar = model().registry()->Find(work)->profile_id;
+  ASSERT_FALSE(jar.empty());
+  const GURL url("https://example.com/");
+  PutCookie(profile(), ConfigFor(jar), url);
+
+  // A popup holds a page in the jar, so a wipe of it waits (S17).
+  std::unique_ptr<BrowserWindowInterface> popup =
+      CreateBrowser(profile(), Browser::TYPE_POPUP, /*hosted_app=*/false);
+  content::WebContents::CreateParams params(
+      profile(), content::SiteInstance::CreateForFixedStoragePartition(
+                     profile(), url, ConfigFor(jar)));
+  TabStripModel* const popup_tabs = popup->GetTabStripModel();
+  popup_tabs->AppendTab(
+      std::make_unique<tabs::TabModel>(content::WebContents::Create(params),
+                                       popup_tabs),
+      /*foreground=*/true);
+
+  // Work is deleted in a second window, where its wipe waits.
+  std::unique_ptr<BrowserWindowInterface> second =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  SpaceModel* const deleting = SpaceModel::From(second.get());
+  ASSERT_TRUE(deleting);
+  AddTab(second.get(), url);
+  ASSERT_TRUE(deleting->RemoveSpace(work));
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(1u, prefs->GetList(stedding::prefs::kPendingJarWipes).size());
+
+  // A Blank Window is the window used last when the second one closes, so
+  // the wait goes to it.
+  SpaceModel::SetNextWindowBlank();
+  std::unique_ptr<BrowserWindowInterface> blank =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  SpaceModel* const blank_model = SpaceModel::From(blank.get());
+  ASSERT_TRUE(blank_model);
+  ASSERT_FALSE(blank_model->follows_registry());
+  BrowserActiveStateManager::From(blank.get())->DidBecomeActive();
+  ASSERT_EQ(blank.get(),
+            GlobalBrowserCollection::GetInstance()->GetLastActiveBrowser());
+  second->GetTabStripModel()->CloseAllTabs();
+  second.reset();
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(1u, prefs->GetList(stedding::prefs::kPendingJarWipes).size())
+      << "the wipe ran while the popup still showed the jar";
+  ASSERT_FALSE(WasWiped(ConfigFor(jar), url));
