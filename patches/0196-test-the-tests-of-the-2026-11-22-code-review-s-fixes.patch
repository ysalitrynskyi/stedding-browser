+      ]}}, "version": 1})json"));
+    // Should the import look for a key, it is refused at once: nothing asks
+    // the keychain or reads Local State for one.
+    spaces::SetChromiumFamilyKeyForTesting(
+        std::optional<std::optional<std::vector<uint8_t>>>(std::in_place,
+                                                           std::nullopt));
+  }
+
+  void TearDownOnMainThread() override {
+    spaces::SetChromiumFamilyKeyForTesting(std::nullopt);
+    roaming_override_.reset();
+    home_override_.reset();
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      EXPECT_TRUE(home_.Delete());
+    }
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  base::ScopedTempDir home_;
+  std::optional<base::ScopedPathOverride> home_override_;
+  std::optional<base::ScopedPathOverride> roaming_override_;
+};
