 namespace stedding {
 namespace {
 
-// T8, T10, T11, T12, T22: one row of ShouldShowAddressRow per input.
+// T8, T10, T11, T12, T22, T50: one row of ShouldShowAddressRow per input.
 TEST(AddressRowRulesTest, Visibility) {
   struct Case {
     const char* name;
@@ -57,6 +57,54 @@ TEST(AddressRowRulesTest, Visibility) {
     signals.in_full_screen_title_bar = true;
     EXPECT_TRUE(ShouldShowAddressRow(signals));
   }
+  // T50 (GitHub issue 45): with the address in the sidebar the open sidebar
+  // shows it, so the row hides while the sidebar is open and comes back when
+  // it closes. A window with no sidebar keeps the row. T8's exceptions hold:
+  // a localhost page, the frame's own buttons over the row, shift-cmd-D and
+  // macOS's full screen keep or decide it. With "Hide the address row with
+  // the sidebar" on as well, the row hides both ways.
+  struct SidebarCase {
+    const char* name;
+    bool open;
+    bool collapsed;
+    bool hide_with_sidebar;
+    bool localhost;
+    bool caption_buttons_over_row;
+    std::optional<bool> override;
+    bool full_screen;
+    bool show;
+  };
+  const SidebarCase kSidebarCases[] = {
+      {"open: the sidebar has it", true, false, false, false, false,
+       std::nullopt, false, false},
+      {"closed: the row comes back", false, true, false, false, false,
+       std::nullopt, false, true},
+      {"no sidebar: the row stays", false, false, false, false, false,
+       std::nullopt, false, true},
+      {"T11: localhost keeps it", true, false, false, true, false,
+       std::nullopt, false, true},
+      {"T22: the caption buttons keep it", true, false, false, false, true,
+       std::nullopt, false, true},
+      {"T10: the toggle shows it", true, false, false, false, false, true,
+       false, true},
+      {"T8: full screen keeps it", true, false, false, false, false,
+       std::nullopt, true, true},
+      {"T12 too: closed hides it", false, true, true, false, false,
+       std::nullopt, false, false},
+  };
+  for (const SidebarCase& row : kSidebarCases) {
+    SCOPED_TRACE(row.name);
+    AddressRowSignals signals;
+    signals.address_in_sidebar = true;
+    signals.sidebar_open = row.open;
+    signals.sidebar_collapsed = row.collapsed;
+    signals.hide_with_sidebar = row.hide_with_sidebar;
+    signals.localhost = row.localhost;
+    signals.caption_buttons_over_row = row.caption_buttons_over_row;
+    signals.override = row.override;
+    signals.in_full_screen_title_bar = row.full_screen;
+    EXPECT_EQ(row.show, ShouldShowAddressRow(signals));
+  }
   // Which pages are localhost pages is the local-tabs rule, tested with it
   // (LocalPagesTest.LocalIsTheLoopbackHostsOverHttp).
 }
