+// sidebar Y19: hidden, the window has no sidebar column, and the traffic
+// lights sit on the address row: the row's contents start past them, as in
+// a window without a sidebar, and its page-coloured bar runs on under them.
+// They sat on a patch of the window's ground beside the row (2026-10-12).
+IN_PROC_BROWSER_TEST_F(WindowButtonsTest, HiddenTheLightsSitOnTheRowsBar) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  VerticalTabStripRegionView* const strip =
+      browser_view->vertical_tab_strip_region_view_for_testing();
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarClosedForm,
+      stedding::prefs::kSidebarClosedHidden);
+  tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    views::test::RunScheduledLayout(browser_view->GetWidget());
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+               TabStripAnimations::kVerticalTabStrip) &&
+           strip->IsHiddenCompletely() && strip->width() == 0;
+  }));
+
+  gfx::Rect bar = gfx::ToEnclosingRect(stedding::PageBarSurface(browser_view));
+  ASSERT_FALSE(bar.IsEmpty());
+  views::View::ConvertRectToScreen(browser_view, &bar);
+  const int contents_left = browser_view->toolbar()->GetBoundsInScreen().x();
+  NSWindow* const window =
+      browser_view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  for (NSWindowButton kind :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    NSButton* const button = [window standardWindowButton:kind];
+    ASSERT_TRUE(button);
+    const gfx::Rect frame = ScreenFrame(window, button);
+    EXPECT_TRUE(bar.Contains(frame))
+        << "window button " << kind << " at " << frame.ToString()
+        << " is off the row's bar " << bar.ToString();
+    EXPECT_LT(frame.right(), contents_left)
+        << "the row's contents run under window button " << kind;
+  }
+}
