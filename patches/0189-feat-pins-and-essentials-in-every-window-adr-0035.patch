+
+// windows G16: how soon what waited for a tab drag is tried again.
+constexpr base::TimeDelta kDragRetry = base::Milliseconds(200);
+
+// windows G16 (BACKLOG S-546): a window with more records than this to make
+// makes them a Space at a time (ReconcileNow).
+constexpr size_t kMakeAtOnceUpTo = 40;
+
+}  // namespace
+
+DEFINE_USER_DATA(PinMirror);
+
+PinMirror::PinMirror(BrowserWindowInterface& window, SpaceModel& model)
+    : window_(window),
+      model_(&model),
+      store_(PinStoreFactory::GetForProfile(window.GetProfile())),
+      scoped_user_data_(window.GetUnownedUserDataHost(), *this) {
+  if (!store_ || !model_->follows_registry() || g_disabled_for_testing) {
+    return;
+  }
+  store_observation_.Observe(store_.get());
+  model_->AddObserver(this);
+  window_->GetTabStripModel()->AddObserver(this);
+  root_ = window_->GetTabStripModel()->Root();
+  root_->AddObserver(this);
+  if (SessionRestore::IsRestoring(window_->GetProfile())) {
+    waiting_for_restore_ = true;
+    restored_subscription_ = SessionRestore::RegisterOnSessionRestoredCallback(
+        base::BindRepeating(&PinMirror::OnSessionRestored,
+                            base::Unretained(this)));
+  } else {
+    // A turn later: the window says by then whether it is a little window or
+    // a peek's, and a tab moved into it is in. A window a tab drag tears off
+    // settles once the drag is over (Settle).
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PinMirror::Settle, weak_factory_.GetWeakPtr()));
+  }
+}
+
+PinMirror::~PinMirror() {
+  if (root_) {
+    root_->RemoveObserver(this);
+  }
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+}
+
+// static
+void PinMirror::SetDisabledForTesting(bool disabled) {
+  g_disabled_for_testing = disabled;
+}
+
+// static
+void PinMirror::SetTabDragForTesting(bool under_way) {
+  g_tab_drag_for_testing = under_way;
+}
+
+// static
+PinMirror* PinMirror::From(BrowserWindowInterface* window) {
+  return window ? Get(window->GetUnownedUserDataHost()) : nullptr;
+}
+
+bool PinMirror::Active() const {
+  // A window on its way out takes no tab and gives no record (a window
+  // closing removes nothing, G16).
+  return takes_part_ && model_ && store_ && !window_->IsDeleteScheduled() &&
+         !window_->GetTabStripModel()->closing_all();
+}
+
+bool PinMirror::DragUnderWay() const {
+  if (g_tab_drag_for_testing) {
+    return true;
+  }
+  // A strip is not editable while a tab drag is attached to it, the strip of
+  // the window a drag tears off included.
+  for (BrowserWindowInterface* const window :
+       sidebar_sync::RegistryWindows(window_->GetProfile())) {
+    TabStripModelDelegate* const delegate =
+        window->GetTabStripModel()->delegate();
+    if (delegate && !delegate->IsTabStripEditable()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void PinMirror::WaitForTheDrag() {
+  if (drag_retry_posted_) {
+    return;
+  }
+  drag_retry_posted_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&PinMirror::AfterTheDrag, weak_factory_.GetWeakPtr()),
+      kDragRetry);
+}
+
+void PinMirror::AfterTheDrag() {
+  drag_retry_posted_ = false;
+  if (DragUnderWay()) {
+    WaitForTheDrag();
+    return;
+  }
+  // A change made here during the drag goes first, then this window is
+  // brought in line with what changed elsewhere.
+  if (publish_scheduled_) {
+    Publish();
+  }
+  if (reconcile_after_drag_) {
+    reconcile_after_drag_ = false;
+    Reconcile();
+  }
+}
+
+void PinMirror::Hold(std::vector<PinRecord> records,
+                     const std::set<std::string>& removed) {
+  std::set<std::string> ids;
+  std::erase_if(records, [&](const PinRecord& record) {
+    return !ids.insert(record.id).second;
+  });
+  // windows G13: a record whose tab is still here but no row of the run for
+  // now (its pinned folder holds a row that is no pin yet) stays held, in its
+  // place, so an edit made to it meanwhile goes out once it is a row again
+  // rather than being taken for a tab from another window.
+  std::set<std::string> here;
+  TabStripModel* const strip = window_->GetTabStripModel();
+  for (int i = 0; i < strip->count(); ++i) {
+    here.insert(stedding::TabToken(strip->GetTabAtIndex(i)->GetContents()));
+  }
+  for (size_t i = 0; i < held_.size(); ++i) {
+    const PinRecord& before = held_[i];
+    if (ids.contains(before.id) || removed.contains(before.id) ||
+        !here.contains(before.id) || !store_->Find(before.id)) {
+      continue;
+    }
+    // After the record it followed, or first.
+    auto at = records.begin();
+    for (size_t j = i; j > 0; --j) {
+      const std::string& previous = held_[j - 1].id;
+      const auto it = std::ranges::find_if(
+          records,
+          [&](const PinRecord& record) { return record.id == previous; });
+      if (it != records.end()) {
+        at = it + 1;
+        break;
+      }
+    }
+    records.insert(at, before);
+    ids.insert(before.id);
+  }
+  held_ = std::move(records);
+}
+
+bool PinMirror::IsMirrored(const tabs::TabInterface* tab) const {
+  if (!tab || !model_) {
+    return false;
+  }
+  // Chromium's essentials take no folder (folders F38).
+  if (tab->IsPinned()) {
+    return !InFolder(tab);
+  }
+  if (!model_->IsSpacePinned(tab)) {
+    return false;
+  }
+  const tabs::FolderTabCollection* const top = OutermostFolder(tab);
+  return !top || model_->IsFolderSpacePinned(top);
+}
+
+PinRecord PinMirror::RecordOf(tabs::TabInterface* tab) const {
+  PinRecord record;
+  record.id = stedding::EnsureTabToken(tab);
+  content::WebContents* const contents = tab->GetContents();
+  if (tab->IsPinned()) {
+    record.tier = PinTier::kEssential;
+    if (model_->IsOwnEssential(tab)) {
+      if (const std::optional<SpaceId> space = model_->FindSpaceForTab(tab)) {
+        record.space = *space;
+        record.has_space = true;
+      }
+    }
+  } else {
+    record.tier = PinTier::kSpacePin;
+    if (const std::optional<SpaceId> space = model_->FindSpaceForTab(tab)) {
+      record.space = *space;
+      record.has_space = true;
+    }
+    // folders F38: the folders it is in, with their names, icons and open
+    // or closed state, as the session keeps them.
+    record.folder_path = stedding::FolderPathForTab(tab);
+  }
+  record.home = model_->HomeUrl(tab).value_or(GURL());
+  // pins H13: a row with no web home (a local file) is opened elsewhere at
+  // the page it shows.
+  if (!record.home.is_valid()) {
+    record.page = contents->GetLastCommittedURL().is_valid()
+                      ? contents->GetLastCommittedURL()
+                      : contents->GetVisibleURL();
+  }
+  record.name = stedding::TabName(contents);
+  record.title = contents->GetTitle();
+  record.separator = stedding::HasSeparatorAbove(contents);
+  return record;
+}
+
+std::vector<PinRecord> PinMirror::BuildRecords() const {
+  std::vector<PinRecord> records;
+  if (!model_) {
+    return records;
+  }
+  TabStripModel* const strip = window_->GetTabStripModel();
+  for (int i = 0; i < strip->count(); ++i) {
+    tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+    if (IsMirrored(tab)) {
+      PinRecord record = RecordOf(tab);
+      // A Space pin with no Space here is not one this window can describe.
+      if (record.tier == PinTier::kSpacePin && !record.has_space) {
+        continue;
+      }
+      records.push_back(std::move(record));
+    }
+  }
+  return records;
+}
+
+void PinMirror::SchedulePublish() {
+  if (!Active() || reconciling_ || g_filling || waiting_for_restore_ ||
+      publish_scheduled_) {
+    return;
+  }
+  publish_scheduled_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&PinMirror::Publish, weak_factory_.GetWeakPtr()));
+}
+
+void PinMirror::Publish() {
+  if (!Active() || !store_->ready() || reconciling_ || waiting_for_restore_ ||
+      g_filling) {
+    publish_scheduled_ = false;
+    removed_.clear();
+    return;
+  }
+  // windows G16: what a drag changes is published once, as the drag ends.
+  if (DragUnderWay()) {
+    publish_scheduled_ = true;
+    WaitForTheDrag();
+    return;
+  }
+  publish_scheduled_ = false;
+  const std::vector<PinRecord> records = BuildRecords();
+  std::set<std::string> here;
+  for (const PinRecord& record : records) {
+    here.insert(record.id);
+  }
+  // windows G15: what stopped being a pin here by the person's hand and is not
+  // one here now (an essential made a Space pin is still here).
+  std::set<std::string> removed;
+  for (const std::string& id : removed_) {
+    if (!here.contains(id)) {
+      removed.insert(id);
+    }
+  }
+  removed_.clear();
+  // windows G13: only what changed here since this window last held its
+  // records is sent. A record this window did not touch is never written
+  // back from it, so a change or a removal made elsewhere since, which this
+  // window has not followed yet, is not undone (G15).
+  const PinChanges changes = store_->ChangesSince(held_, records);
+  // Held before the store tells anyone: a reconcile it sets off here holds
+  // what it leaves.
+  Hold(records, removed);
+  store_->Publish(changes.order, changes.changed, removed);
+}
+
+void PinMirror::NoteRemoved(const std::string& id) {
+  if (!id.empty() && store_ && store_->Find(id)) {
+    removed_.insert(id);
+  }
+}
+
+void PinMirror::OnPinStoreChanged() {
+  if (!Active() || g_filling || waiting_for_restore_ || !settled_) {
+    return;
+  }
+  Reconcile();
+}
+
+void PinMirror::OnSpaceAdded(const SpaceId& id) {
+  // A record of a Space this window lacked (a Space from another computer,
+  // an import) is shown once its Space is here, a turn later.
+  if (!Active() || reconciling_ || g_filling || !settled_) {
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&PinMirror::Reconcile, weak_factory_.GetWeakPtr()));
+}
+
+void PinMirror::OnTabSpaceChanged(tabs::TabInterface* tab) {
+  if (IsMirrored(tab)) {
+    SchedulePublish();
+  }
+}
+
+void PinMirror::OnTabSpacePinChanged(tabs::TabInterface* tab, bool pinned) {
+  if (reconciling_ || g_filling || !tab) {
+    return;
+  }
+  if (!pinned) {
+    NoteRemoved(stedding::TabToken(tab->GetContents()));
+  }
+  SchedulePublish();
+}
+
+void PinMirror::OnSpaceModelDestroying() {
+  if (model_) {
+    model_->RemoveObserver(this);
+  }
+  model_ = nullptr;
+  store_observation_.Reset();
+}
+
+void PinMirror::OnTabStripModelChanged(
+    TabStripModel* strip,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (!Active() || reconciling_ || g_filling) {
+    return;
+  }
+  switch (change.type()) {
+    case TabStripModelChange::kRemoved: {
+      bool moved_away = false;
+      for (const TabStripModelChange::RemovedTab& removed :
+           change.GetRemove()->contents) {
+        const std::string id = stedding::TabToken(removed.contents);
+        if (id.empty() || !store_->Find(id)) {
+          continue;
+        }
+        // windows G16: a window closing removes nothing; a tab moved to
+        // another window leaves its record here, asleep.
+        if (removed.remove_reason ==
+                TabRemovedReason::kDeleted &&
+            !strip->closing_all()) {
+          NoteRemoved(id);
+          SchedulePublish();
+        } else if (removed.remove_reason ==
+                   TabRemovedReason::kInsertedIntoOtherTabStrip) {
+          moved_away = true;
+        }
+      }
+      if (moved_away) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce(&PinMirror::Reconcile,
+                                      weak_factory_.GetWeakPtr()));
+      }
+      break;
+    }
+    case TabStripModelChange::kMoved:
+      if (IsMirrored(change.GetMove()->tab)) {
+        SchedulePublish();
+      }
+      break;
+    case TabStripModelChange::kInserted:
+      for (const TabStripModelChange::ContentsWithIndex& inserted :
+           change.GetInsert()->contents) {
+        if (IsMirrored(inserted.tab)) {
+          // windows G16: a tab of a record dropped in from another window may
+          // be this window's second tab of it, which a turn later settles.
+          SchedulePublish();
+          base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE, base::BindOnce(&PinMirror::Reconcile,
+                                        weak_factory_.GetWeakPtr()));
+          break;
+        }
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+void PinMirror::OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) {
+  if (!Active() || reconciling_ || g_filling || !tab) {
+    return;
+  }
+  if (!tab->IsPinned() && !model_->IsSpacePinned(tab)) {
+    NoteRemoved(stedding::TabToken(tab->GetContents()));
+  }
+  SchedulePublish();
+}
+
+void PinMirror::OnTabChangedAt(tabs::TabInterface* tab,
+                               TabChangeType change_type) {
+  if (!Active() || reconciling_ || g_filling) {
+    return;
+  }
+  // A name, a separator, a title: the record is sent again; the store keeps
+  // a title alone without telling anyone.
+  if (IsMirrored(tab)) {
+    SchedulePublish();
+  }
+}
