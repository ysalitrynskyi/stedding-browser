+namespace {
+
+// One press of `button` and its release at `screen_point`, handed to
+// `widget`'s root view as the window hands it a real one, as
+// stedding::test::ClickLeftMouse does with the left button. The Mac's event
+// generator gives a press no middle button, so every platform takes this path.
+void ClickWithButtonB29(views::Widget* widget,
+                        int button,
+                        const gfx::Point& screen_point) {
+  views::View* const root = widget->GetRootView();
+  gfx::Point in_root = screen_point;
+  views::View::ConvertPointFromScreen(root, &in_root);
+  const ui::MouseEvent press(ui::EventType::kMousePressed, in_root, in_root,
+                             ui::EventTimeForNow(), button, button);
+  const ui::MouseEvent release(ui::EventType::kMouseReleased, in_root, in_root,
+                               ui::EventTimeForNow(), button, button);
+  root->OnMousePressed(press);
+  root->OnMouseReleased(release);
+}
+
+class ClearLineButtonsB29Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  int TabCount() { return browser()->GetTabStripModel()->count(); }
+
+  // At least two tabs, so a Clear that runs has a loose tab to close.
+  void HaveTwoTabs() {
+    while (TabCount() < 2) {
+      const int before = TabCount();
+      ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+          browser(), GURL(url::kAboutBlankURL),
+          WindowOpenDisposition::kNewForegroundTab,
+          ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+      ASSERT_GT(TabCount(), before);
+    }
+  }
+
+  // The middle of the Clear line's word on screen, where a person clicks it,
+  // once the rows have moved into place.
+  void FindTheClearWord(gfx::Point* screen_point) {
+    views::Widget* const widget = browser_view()->GetWidget();
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+    views::test::RunScheduledLayout(widget);
+    ClearTabsSeparator* const line =
+        stedding::test::FindDrawnClearLine(widget->GetRootView());
+    ASSERT_TRUE(line) << "the sidebar shows no Clear line";
+    ASSERT_FALSE(line->GetClearRect().IsEmpty()) << "Clear has no word";
+    *screen_point = line->GetClearRect().CenterPoint();
+    views::View::ConvertPointToScreen(line, screen_point);
+  }
+};
+
+// P39-1a; spaces B17, sidebar Y24: Clear is a button, and a button runs on a
+// left click. A right click on the word, or a middle one, closes none of the
+// Space's tabs and opens nothing; a left click there closes the loose tabs.
+// The word took a press of any button and cleared the Space on its release.
+IN_PROC_BROWSER_TEST_F(ClearLineButtonsB29Test,
+                       OnlyALeftClickOnTheWordClearsTheSpace) {
+  views::Widget* const widget = browser_view()->GetWidget();
+  struct Case {
+    const char* trace;
+    int button;
+  };
+  const Case cases[] = {
+      {"a right click on Clear", ui::EF_RIGHT_MOUSE_BUTTON},
+      {"a middle click on Clear", ui::EF_MIDDLE_MOUSE_BUTTON},
+  };
+  for (const Case& each : cases) {
+    SCOPED_TRACE(each.trace);
+    ASSERT_NO_FATAL_FAILURE(HaveTwoTabs());
+    const int before = TabCount();
+    gfx::Point word;
+    ASSERT_NO_FATAL_FAILURE(FindTheClearWord(&word));
+    ClickWithButtonB29(widget, each.button, word);
+    // A Clear that ran adds the Space's page and closes the tabs at once;
+    // anything it posted has run by now.
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(before, TabCount()) << "the click cleared the Space";
+    EXPECT_FALSE(stedding::CommandBarView::GetOpenBar(browser_view()))
+        << "the click on Clear opened the command bar";
+  }
+
+  {
+    SCOPED_TRACE("a left click on Clear");
+    ASSERT_NO_FATAL_FAILURE(HaveTwoTabs());
+    gfx::Point word;
+    ASSERT_NO_FATAL_FAILURE(FindTheClearWord(&word));
+    stedding::test::ClickLeftMouse(widget, word);
+    TabStripModel* const tabs = browser()->GetTabStripModel();
+    ASSERT_TRUE(base::test::RunUntil([&]() { return tabs->count() == 1; }))
+        << "a left click on Clear left " << tabs->count() << " tabs";
+    EXPECT_TRUE(stedding::IsEmptySpaceStandIn(tabs->GetActiveTab()))
+        << "Clear left a tab that is not the Space's page";
+  }
+}
+
+class AddressFieldRtlB29Test : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(switches::kForceUIDirection,
+                                    switches::kForceDirectionRTL);
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // In the screen's work area, as AddressBandTest places its window: on
+    // the Mac (0, 0) is under the menu bar.
+    view()->GetWidget()->SetBounds(gfx::Rect(
+        display::Screen::Get()->GetPrimaryDisplay().work_area().origin(),
+        gfx::Size(1600, 900)));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+    views::test::RunScheduledLayout(view());
+  }
+
+  // Looked up each time: the window goes before the fixture does.
+  BrowserView* view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  LocationBarView* bar() { return view()->GetLocationBarView(); }
+};
+
+// P44-1a; toolbar T49: right to left, side by side, the field is the active
+// pane's at every width, over that pane on whichever side of the window it
+// is drawn, and it follows the focus to the other pane. The
+// pane's edges were read on screen and laid out as the row's left-to-right
+// places, so the field was drawn over the other pane.
+IN_PROC_BROWSER_TEST_F(AddressFieldRtlB29Test,
+                       RightToLeftASplitsFieldSitsOverTheActivePane) {
+  ASSERT_TRUE(base::i18n::IsRTL());
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("b.test", "/title1.html"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs->ActivateTabAt(0);
+  tabs->AddToNewSplit({1}, split_tabs::SplitTabVisualData(),
+                      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(tabs->GetTabAtIndex(1)->IsSplit());
+  MultiContentsView* const panes = view()->multi_contents_view();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(view());
+    return panes->IsInSplitView() &&
+           panes->GetSplitLayout() == split_tabs::SplitTabLayout::kSideBySide;
+  }));
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  for (const int width : {0, 800, 480}) {
+    prefs->SetInteger(stedding::prefs::kToolbarFieldWidth, width);
+    for (const int active : {0, 1}) {
+      SCOPED_TRACE(base::StringPrintf("width %d, pane %d", width, active));
+      tabs->ActivateTabAt(active);
+      const auto pane = [&]() {
+        return panes->GetActiveContentsContainerView()->GetBoundsInScreen();
+      };
+      const auto over_the_pane = [&]() {
+        views::test::RunScheduledLayout(view());
+        const gfx::Rect field = bar()->GetBoundsInScreen();
+        return field.x() >= pane().x() && field.right() <= pane().right();
+      };
+      EXPECT_TRUE(base::test::RunUntil(over_the_pane))
+          << "the field at " << bar()->GetBoundsInScreen().ToString()
+          << " is not over the active pane at " << pane().ToString();
+      if (width) {
+        EXPECT_LE(bar()->width(), width);
+      }
+    }
+  }
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/audit_b30_browsertest.cc b/chrome/test/stedding/audit_b30_browsertest.cc
new file mode 100644
index 0000000000000..d664ef7a7abe3
--- /dev/null
+++ b/chrome/test/stedding/audit_b30_browsertest.cc
@@ -0,0 +1,272 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Two pages that name Spaces and must follow them as they change: the Spaces
+// list in chrome://settings/stedding, in a Blank Window and in a window made
+// after the page loaded (settings T9), and an empty Space's own page,
+// chrome://stedding-space, when the window switches from one empty Space to
+// another and keeps the same page on screen (tabs R66).
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/test/run_until.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/empty_space.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kSettingsSteddingB30[] = "chrome://settings/stedding";
+
+// The Spaces section as the page draws it, through every shadow root: the
+// name field of each row, in order, joined by commas. What the page shows,
+// not what a fresh request would answer.
+constexpr char kDrawnSpaceNamesB30[] = R"(
+  (() => {
+    const names = [];
+    const walk = root => {
+      for (const element of root.querySelectorAll('*')) {
+        if (element.matches('cr-input.space-name')) {
+          names.push(element.value);
+        }
+        if (element.shadowRoot) {
+          walk(element.shadowRoot);
+        }
+      }
+    };
+    walk(document);
+    return names.join(',');
+  })()
+)";
+
+std::string DrawnSpaceNamesB30(content::WebContents* page) {
+  return content::EvalJs(page, kDrawnSpaceNamesB30).ExtractString();
+}
+
+// The heading of an empty Space's page, and the Space colour it is drawn in.
+std::string SpacePageTitleB30(content::WebContents* page) {
+  return content::EvalJs(page, "document.getElementById('title').textContent")
+      .ExtractString();
+}
+
+std::string SpacePageColourB30(content::WebContents* page) {
+  return content::EvalJs(page,
+                         "document.documentElement.style"
+                         ".getPropertyValue('--space').trim().toUpperCase()")
+      .ExtractString();
+}
+
+// Opens a Blank Window as File > New Blank Window does.
+BrowserWindowInterface* OpenBlankWindowB30(BrowserWindowInterface* from) {
+  // The window opens inside the command, so the waiter comes first.
+  ui_test_utils::BrowserCreatedObserver opened;
+  chrome::ExecuteCommand(from, IDC_STEDDING_NEW_BLANK_WINDOW);
+  return opened.Wait();
+}
+
+// Moves the tab showing `contents` from `from` to `to`, as a drag between
+// windows does: the page is not reloaded.
+void MoveTabB30(BrowserWindowInterface* from,
+                BrowserWindowInterface* to,
+                content::WebContents* contents) {
+  std::unique_ptr<tabs::TabModel> tab =
+      from->GetTabStripModel()->DetachTabAtForInsertion(
+          from->GetTabStripModel()->GetIndexOfWebContents(contents));
+  to->GetTabStripModel()->InsertDetachedTabAt(0, std::move(tab),
+                                              AddTabTypes::ADD_ACTIVE);
+}
+
+class SettingsSpacesB30Test : public InProcessBrowserTest {};
+
+// P45-1b, settings T9: a Blank Window's Spaces are its own and never reach
+// the profile's list. Settings opened there still follows a rename, a
+// deletion and a new Space made in that window. The list stayed as it was
+// when the page loaded, a deleted Space's row and its bin with it.
+IN_PROC_BROWSER_TEST_F(SettingsSpacesB30Test,
+                       ABlankWindowsListFollowsItsSpaces) {
+  BrowserWindowInterface* const blank = OpenBlankWindowB30(browser());
+  ASSERT_TRUE(blank);
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(blank);
+  ASSERT_TRUE(model);
+  ASSERT_FALSE(model->follows_registry());
+  model->SetSpaceName(model->active_id(), "First");
+  const spaces::SpaceId mine = model->AddSpace("Mine", SK_ColorRED)->id();
+  const spaces::SpaceId gone = model->AddSpace("Gone", SK_ColorGREEN)->id();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(blank, GURL(kSettingsSteddingB30)));
+  content::WebContents* const page =
+      blank->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "First,Mine,Gone"; }))
+      << "the page never listed the window's Spaces: "
+      << DrawnSpaceNamesB30(page);
+
+  model->SetSpaceName(mine, "Ours");
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "First,Ours,Gone"; }))
+      << "the rename did not reach the list: " << DrawnSpaceNamesB30(page);
+
+  ASSERT_TRUE(model->RemoveSpace(gone));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "First,Ours"; }))
+      << "the deleted Space kept its row: " << DrawnSpaceNamesB30(page);
+
+  model->AddSpace("Late", SK_ColorBLUE);
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "First,Ours,Late"; }))
+      << "the new Space has no row: " << DrawnSpaceNamesB30(page);
+
+  CloseBrowserSynchronously(blank);
+}
+
+// P45-1b, settings T9: the list follows its tab into a Blank Window. It
+// lists that window's own Spaces from then on, and follows them.
+IN_PROC_BROWSER_TEST_F(SettingsSpacesB30Test,
+                       TheListFollowsTheTabIntoABlankWindow) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  model->SetSpaceName(model->active_id(), "Home");
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL(kSettingsSteddingB30),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "Home"; }))
+      << DrawnSpaceNamesB30(page);
+
+  BrowserWindowInterface* const blank = OpenBlankWindowB30(browser());
+  ASSERT_TRUE(blank);
+  spaces::SpaceModel* const blank_model = spaces::SpaceModel::From(blank);
+  ASSERT_TRUE(blank_model);
+  ASSERT_FALSE(blank_model->follows_registry());
+  blank_model->SetSpaceName(blank_model->active_id(), "Mine");
+  MoveTabB30(browser(), blank, page);
+
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "Mine"; }))
+      << "the list still shows the first window's Spaces: "
+      << DrawnSpaceNamesB30(page);
+  blank_model->AddSpace("Later", SK_ColorRED);
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "Mine,Later"; }))
+      << "the Blank Window's new Space has no row: "
+      << DrawnSpaceNamesB30(page);
+
+  CloseBrowserSynchronously(blank);
+}
+
+// P45-1a, settings T9: the Settings tab moved, without a reload, into a
+// window made after the page loaded still shows each change as it is made.
+// That window's Spaces caught up with the profile's after the page had read
+// them, so the list showed every change one change late: a renamed Space
+// kept its old name, a deleted one its row.
+IN_PROC_BROWSER_TEST_F(SettingsSpacesB30Test,
+                       AChangeShowsAfterTheTabMovesToANewerWindow) {
+  BrowserWindowInterface* const first = browser();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(first);
+  ASSERT_TRUE(model);
+  model->SetSpaceName(model->active_id(), "Home");
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  const spaces::SpaceId play = model->AddSpace("Play", SK_ColorGREEN)->id();
+  // The first window keeps a tab of its own, so it stays open when the
+  // settings tab leaves.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      first, GURL(kSettingsSteddingB30),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page =
+      first->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "Home,Work,Play"; }))
+      << DrawnSpaceNamesB30(page);
+
+  BrowserWindowInterface* const second = CreateBrowser(first->GetProfile());
+  ASSERT_TRUE(second);
+  spaces::SpaceModel* const second_model = spaces::SpaceModel::From(second);
+  ASSERT_TRUE(second_model);
+  ASSERT_TRUE(second_model->follows_registry());
+  MoveTabB30(first, second, page);
+
+  second_model->SetSpaceName(play, "Games");
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    const spaces::Space* const games = second_model->GetSpace(play);
+    return games && games->name() == "Games";
+  }));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "Home,Work,Games"; }))
+      << "the rename shows late: " << DrawnSpaceNamesB30(page);
+
+  ASSERT_TRUE(second_model->RemoveSpace(work));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !second_model->GetSpace(work) && !model->GetSpace(work);
+  }));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return DrawnSpaceNamesB30(page) == "Home,Games"; }))
+      << "the deleted Space kept its row: " << DrawnSpaceNamesB30(page);
+
+  second->GetTabStripModel()->CloseWebContentsAt(
+      second->GetTabStripModel()->GetIndexOfWebContents(page),
+      TabCloseTypes::CLOSE_NONE);
+}
+
+class EmptySpacePageB30Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {};
+
+// P04-1a, tabs R66: a switch from one empty Space to another keeps the same
+// page on screen and files it under the Space shown now. The page names that
+// Space and takes its colour. It kept the name and colour of the Space left
+// until the new one was renamed or recoloured.
+IN_PROC_BROWSER_TEST_F(EmptySpacePageB30Test,
+                       ThePageNamesTheEmptySpaceSwitchedTo) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  const spaces::SpaceId play = model->AddSpace("Play", SK_ColorGREEN)->id();
+
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  tabs::TabInterface* const page = strip->GetActiveTab();
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(stedding::IsEmptySpaceStandIn(page)) << "a New Tab opened";
+  content::WebContents* const contents = page->GetContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return SpacePageTitleB30(contents) == "Nothing open in Work"; }))
+      << SpacePageTitleB30(contents);
+  EXPECT_EQ("#0000FF", SpacePageColourB30(contents));
+
+  ASSERT_TRUE(model->SetActiveSpace(play));
+  ASSERT_EQ(page, strip->GetActiveTab()) << "the switch opened another page";
+  ASSERT_TRUE(stedding::IsEmptySpaceStandIn(page));
+  ASSERT_EQ(play, model->SpaceForTab(page));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return SpacePageTitleB30(contents) == "Nothing open in Play"; }))
+      << "the page still names the Space left: "
+      << SpacePageTitleB30(contents);
+  EXPECT_EQ("#00FF00", SpacePageColourB30(contents))
+      << "the page keeps the colour of the Space left";
+}
