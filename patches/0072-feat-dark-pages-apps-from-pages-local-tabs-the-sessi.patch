+// web apps Wa13: deleting the Space an app was made in says what becomes of
+// the app; from its next page on the app has the shared session.
+IN_PROC_BROWSER_TEST_F(AppJarTest, DeletingTheSpaceMovesTheAppToTheSharedJar) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  const std::u16string name =
+      base::UTF8ToUTF16(provider().registrar_unsafe().GetAppShortName(app_id));
+
+  views::Widget* question = nullptr;
+  views::AnyWidgetObserver questions(views::test::AnyWidgetTestPasskey{});
+  questions.set_shown_callback(
+      base::BindLambdaForTesting([&](views::Widget* widget) {
+        if (widget->widget_delegate() &&
+            widget->widget_delegate()->AsDialogDelegate()) {
+          question = widget;
+        }
+      }));
+  spaces::DeleteSpaceAfterAsking(browser(), work_);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return question != nullptr; }));
+  const std::u16string text = TextUnder(question->GetRootView());
+  EXPECT_NE(std::u16string::npos,
+            text.find(name + u" will then use the shared session."))
+      << text;
+  question->widget_delegate()->AsDialogDelegate()->AcceptDialog();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !model_->GetSpace(work_); }));
+
+  EXPECT_EQ("", stedding::AppJarInUse(*profile()->GetPrefs(), app_id));
+  content::WebContents* const page = Launch(app_id, "/title1.html?after");
+  ASSERT_TRUE(page);
+  EXPECT_EQ("", JarOf(page));
+  EXPECT_EQ("jar=shared", FirstCookieFor("/title1.html?after"));
+}
