@@ -176,9 +183,37 @@ void ChromeBrowserMainPartsMac::PreProfileInit() {
   g_browser_process->platform_part()->app_shim_listener()->Init();
 }
 
+namespace {
+
+// updates Up3 (docs/features/updates.md): what chrome::AttemptRestart does
+// before it quits, so the version the updater installs opens on the session
+// it replaced, with nothing of it cleared on exit.
+void PrepareUpdateRestart() {
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [](BrowserWindowInterface* browser) {
+        browser->GetProfile()->SaveSessionState();
+        if (SessionDataService* const service =
+                SessionDataServiceFactory::GetForProfile(
+                    browser->GetProfile())) {
+          service->SetForceKeepSessionState();
+        }
+        return true;
+      });
+  PrefService* const local_state = g_browser_process->local_state();
+  local_state->SetBoolean(prefs::kWasRestarted, true);
+  local_state->CommitPendingWrite();
+}
+
+}  // namespace
+
 void ChromeBrowserMainPartsMac::PostProfileInit(Profile* profile,
                                                 bool is_initial_profile) {
   ChromeBrowserMainPartsPosix::PostProfileInit(profile, is_initial_profile);
+  // Stedding's updater: Sparkle, once per process (ADR 0022).
+  if (is_initial_profile) {
+    stedding::StartAppUpdater(g_browser_process->local_state(),
+                              base::BindRepeating(&PrepareUpdateRestart));
+  }
 }
 
 void ChromeBrowserMainPartsMac::DidEndMainMessageLoop() {
