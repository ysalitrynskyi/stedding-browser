diff --git a/chrome/browser/ui/tabs/tab_favicon_theming_unittest.cc b/chrome/browser/ui/tabs/tab_favicon_theming_unittest.cc
new file mode 100644
index 0000000000000..374386b113372
--- /dev/null
+++ b/chrome/browser/ui/tabs/tab_favicon_theming_unittest.cc
@@ -0,0 +1,71 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/tabs/tab_favicon_theming.h"
+
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_recipe.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace tabs {
+namespace {
+
+constexpr SkColor kDarkGround = SkColorSetRGB(0x26, 0x2b, 0x3a);
+constexpr SkColor kLightGround = SkColorSetRGB(0xee, 0xe6, 0xd8);
+
+// A grey single-colour icon, like the default globe.
+gfx::ImageSkia GreyIcon() {
+  SkBitmap bitmap;
+  bitmap.allocN32Pixels(16, 16);
+  bitmap.eraseColor(SK_ColorGRAY);
+  return gfx::ImageSkia::CreateFrom1xBitmap(bitmap);
+}
+
+SkColor Masked(const gfx::ImageSkia& image) {
+  return image.bitmap()->getColor(8, 8);
+}
+
+// The sidebar's colours: the active row a tint of the text colour over the
+// ground in dark, the white card in light; inactive rows no fill.
+void Fill(ui::ColorProvider& provider, bool dark) {
+  ui::ColorMixer& mixer = provider.AddMixer();
+  mixer[ui::kColorFrameActive] = {dark ? kDarkGround : kLightGround};
+  mixer[kColorTabBackgroundActiveFrameActive] = {
+      dark ? SkColorSetA(SK_ColorWHITE, 0x24) : SK_ColorWHITE};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {SK_ColorTRANSPARENT};
+  provider.GenerateColorMapForTesting();
+}
+
+// BACKLOG S-73: a single-colour icon on a translucent row is masked for the
+// row as it is seen, over the frame: light on the dark sidebar's active row,
+// where it came out near-black (about 1.4:1), and dark on the light
+// sidebar's inactive rows, where it came out white.
+TEST(TabFaviconThemingTest, ATranslucentRowIsReadOverTheFrame) {
+  ui::ColorProvider dark;
+  Fill(dark, /*dark=*/true);
+  EXPECT_EQ(SK_ColorWHITE,
+            Masked(ThemeMonochromeFaviconForTab(GreyIcon(), dark, true)))
+      << "the dark sidebar's active row";
+  EXPECT_EQ(SK_ColorWHITE,
+            Masked(ThemeMonochromeFaviconForTab(GreyIcon(), dark, false)))
+      << "the dark sidebar's other rows";
+
+  ui::ColorProvider light;
+  Fill(light, /*dark=*/false);
+  EXPECT_NE(SK_ColorWHITE,
+            Masked(ThemeMonochromeFaviconForTab(GreyIcon(), light, true)))
+      << "the light sidebar's white card";
+  EXPECT_NE(SK_ColorWHITE,
+            Masked(ThemeMonochromeFaviconForTab(GreyIcon(), light, false)))
+      << "the light sidebar's other rows, on the sand ground";
+}
+
+}  // namespace
+}  // namespace tabs
