+// windows G13: a rename, a new home, a new pin and an order made in one
+// window reach the other.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest, AChangeInOneWindowReachesTheOther) {
+  tabs::TabInterface* const a = PinPage(browser(), Page("/title1.html"));
+  tabs::TabInterface* const b = PinPage(browser(), Page("/title2.html"));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(second).size() == 2u; }));
+
+  stedding::SetTabName(browser(), a, u"Alpha");
+  // Each change goes out on its own: the new home is not carried by the
+  // rename's publish.
+  base::RunLoop().RunUntilIdle();
+  Model(browser()).SetHomeUrl(b, Page("/title3.html"));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const std::vector<tabs::TabInterface*> there = Pins(second);
+    return there.size() == 2u &&
+           stedding::TabName(there[0]->GetContents()) == u"Alpha" &&
+           Model(second).HomeUrl(there[1]) == Page("/title3.html");
+  })) << "the rename or the new home stayed in the first window";
+
+  // A pin made in the second window reaches the first.
+  tabs::TabInterface* const c = PinPage(second, Page("/empty.html"));
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(browser()).size() == 3u; }));
+  EXPECT_EQ(Token(c), Token(Pins(browser()).back()));
+
+  // The first window's order, c first, reaches the second.
+  Model(browser()).MoveToSpacePinBoundary(Pins(browser())[0]);
+  Model(browser()).MoveToSpacePinBoundary(Pins(browser())[0]);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const std::vector<tabs::TabInterface*> here = Pins(browser());
+    const std::vector<tabs::TabInterface*> there = Pins(second);
+    if (here.size() != 3u || there.size() != 3u) {
+      return false;
+    }
+    for (size_t i = 0; i < 3; ++i) {
+      if (Token(here[i]) != Token(there[i])) {
+        return false;
+      }
+    }
+    return true;
+  })) << "the order stayed in the first window";
+  EXPECT_EQ(Token(c), Token(Pins(second).front()));
+}
