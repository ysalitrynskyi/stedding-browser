+std::vector<std::string> SpacePartitionNames(const base::ListValue& registry,
+                                             const base::ListValue& sessions) {
+  std::vector<std::string> names = SpacePartitionNames(registry);
+  for (const base::Value& item : sessions) {
+    const base::DictValue* const session = item.GetIfDict();
+    const std::string* const name = session ? session->FindString("id") : nullptr;
+    if (name && !name->empty() && !std::ranges::contains(names, *name)) {
+      names.push_back(*name);
+    }
+  }
+  return names;
+}
