+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(
+        base::DeleteFile(sync_dir().AppendASCII(sb::FileNameFor(kPeer))));
+  }
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  EXPECT_FALSE(Offered(kExtensionId));
+}
+
+// Sf64 (review finding): new offers from two computers: the bar's count is
+// true, and it names neither alone.
+IN_PROC_BROWSER_TEST_F(SidebarSyncExtensionsTest,
+                       TheBarSaysWhoHasTheExtensions) {
+  ASSERT_NO_FATAL_FAILURE(WritePeer(1, TheList()));
+  ASSERT_NO_FATAL_FAILURE(WritePeer(
+      1,
+      std::vector<sb::ExtensionEntry>{
+          {"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "Another extension"}},
+      "fedcba9876543210", "Laptop"));
+  ASSERT_NO_FATAL_FAILURE(Join());
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return stedding::SyncedExtensionsBarsShownForTesting() == 1; }));
+  EXPECT_EQ(u"Your other computers have 2 extensions this computer does not "
+            u"have.",
+            stedding::SyncedExtensionsBarTextForTesting());
+}
+
+// Sf64 (review finding): another computer's file that the cloud has not
+// downloaded, an iCloud ".icloud" stub, still offers what it listed.
+IN_PROC_BROWSER_TEST_F(SidebarSyncExtensionsTest,
+                       AFileTheCloudHasNotDownloadedKeepsItsOffers) {
+  ASSERT_NO_FATAL_FAILURE(WritePeer(1, TheList()));
+  ASSERT_NO_FATAL_FAILURE(Join());
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  ASSERT_TRUE(base::test::RunUntil([&] { return Offered(kExtensionId); }));
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    const std::string name = sb::FileNameFor(kPeer);
+    ASSERT_TRUE(base::Move(sync_dir().AppendASCII(name),
+                           sync_dir().AppendASCII("." + name + ".icloud")));
+  }
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  EXPECT_TRUE(Offered(kExtensionId));
+}
+
