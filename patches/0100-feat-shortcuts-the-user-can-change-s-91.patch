+std::vector<std::pair<int, ui::Accelerator>> GetDefaultMacBindings() {
+  std::vector<std::pair<int, ui::Accelerator>> bindings;
+  AcceleratorsCocoa* const keymap = AcceleratorsCocoa::GetInstance();
+  for (auto it = keymap->begin(); it != keymap->end(); ++it) {
+    bindings.emplace_back(it->first, it->second);
+  }
+  for (const auto& shortcut : GetDefaultShortcutsNotPresentInMainMenu()) {
+    bindings.emplace_back(shortcut.chrome_command,
+                          AcceleratorFromShortcut(shortcut));
+  }
+  return bindings;
+}
