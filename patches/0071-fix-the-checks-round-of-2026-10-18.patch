+// welcome W1, W7 (PLAN.md TST-21, WEB-37) with Chromium's first-run switch
+// gone, as on a person's launch. The harness passes --no-first-run, and the
+// window it opens has no flow; once the switch is gone the next normal
+// window gets it -- once, however many windows open, and never a private
+// window or a popup. Its swatch tints the first Space, and after Finish the
+// flow does not open again, in this run or after a restart. W1 cited a test
+// of the preference's registration, which never opened a window.
+class WelcomeFirstRunTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    // The install's thank-you page follows the flow (updates Up9); it is
+    // another test's.
+    g_browser_process->local_state()->SetBoolean(
+        stedding::prefs::kThanksAfterInstallShown, true);
+  }
+
+  // The welcome pages open now, in any window.
+  static size_t WelcomeCount() {
+    size_t count = 0;
+    for (content::WebContents* const contents : content::GetAllWebContents()) {
+      if (contents->GetVisibleURL().host() == "stedding-welcome") {
+        ++count;
+      }
+    }
+    return count;
+  }
+
+  // The same once the turn that would open one has run: the flow opens a
+  // turn after its window shows.
+  static size_t WelcomeCountSettled() {
+    base::RunLoop().RunUntilIdle();
+    return WelcomeCount();
+  }
+
+  // A launch with no --no-first-run, from here on.
+  static void LikeAPersonsLaunch() {
+    base::CommandLine::ForCurrentProcess()->RemoveSwitch(switches::kNoFirstRun);
+  }
+
+  // A new normal window, as Cmd-N opens it.
+  BrowserWindowInterface* NewWindow() {
+    ui_test_utils::BrowserCreatedObserver created;
+    chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+    return created.Wait();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(WelcomeFirstRunTest,
+                       PRE_TheFlowOpensOnceAndNotAfterFinish) {
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_FALSE(profile->GetPrefs()->GetBoolean(stedding::prefs::kWelcomeShown));
+  EXPECT_EQ(0u, WelcomeCountSettled()) << "--no-first-run suppresses the flow";
+  LikeAPersonsLaunch();
+  {
+    SCOPED_TRACE("not over a private window or a popup");
+    ASSERT_TRUE(CreateIncognitoBrowser());
+    EXPECT_EQ(0u, WelcomeCountSettled());
+    ASSERT_TRUE(CreateBrowserForPopup(profile));
+    EXPECT_EQ(0u, WelcomeCountSettled());
+  }
+  BrowserWindowInterface* const window = NewWindow();
+  ASSERT_TRUE(window);
+  {
+    SCOPED_TRACE("once, however many windows open");
+    ASSERT_TRUE(base::test::RunUntil([&]() { return WelcomeCount() == 1u; }))
+        << "a normal window of a profile that has not seen the flow";
+    ASSERT_TRUE(NewWindow());
+    EXPECT_EQ(1u, WelcomeCountSettled());
+  }
+  content::WebContents* page = nullptr;
+  for (content::WebContents* const contents : content::GetAllWebContents()) {
+    if (contents->GetVisibleURL().host() == "stedding-welcome") {
+      page = contents;
+    }
+  }
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  ASSERT_EQ("object",
+            content::EvalJs(page, "typeof steddingWelcomeTest").ExtractString())
+      << "the welcome page has no test hook: resources.pak is older than "
+         "this test binary";
+  {
+    SCOPED_TRACE("W7: a swatch tints the first Space");
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(page,
+                             "steddingWelcomeTest.state.spaceColors.length")
+                 .ExtractInt() > 2;
+    })) << "the swatches never came";
+    ASSERT_EQ("", GoTo(page, ".swatches"));
+    ASSERT_TRUE(content::ExecJs(
+        page, "document.querySelector('[data-focus=\"swatch-2\"]').click()"));
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+    ASSERT_TRUE(model);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return model->spaces().front()->color() ==
+             spaces::kSpaceColors.at(2).color;
+    }));
+  }
+  {
+    SCOPED_TRACE("Finish closes the flow and marks it seen");
+    ASSERT_EQ("", GoTo(page, ".keys")) << "the last step";
+    ASSERT_EQ("Finish", content::EvalJs(page, R"(
+        document.querySelector('footer button.primary').textContent)"));
+    ASSERT_TRUE(content::ExecJs(
+        page, "document.querySelector('footer button.primary').click()"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return profile->GetPrefs()->GetBoolean(stedding::prefs::kWelcomeShown);
+    }));
+    EXPECT_TRUE(base::test::RunUntil([&]() { return WelcomeCount() == 0u; }))
+        << "the flow stayed open after Finish";
+  }
+  {
+    SCOPED_TRACE("not again in this run");
+    ASSERT_TRUE(NewWindow());
+    EXPECT_EQ(0u, WelcomeCountSettled());
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(WelcomeFirstRunTest, TheFlowOpensOnceAndNotAfterFinish) {
+  Profile* const profile = browser()->GetProfile();
+  EXPECT_TRUE(profile->GetPrefs()->GetBoolean(stedding::prefs::kWelcomeShown));
+  LikeAPersonsLaunch();
+  ASSERT_TRUE(NewWindow());
+  EXPECT_EQ(0u, WelcomeCountSettled()) << "the flow came back after a restart";
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  EXPECT_EQ(spaces::kSpaceColors.at(2).color, model->spaces().front()->color())
+      << "the swatch chosen in the flow did not last the restart";
+}
