@@ -0,0 +1,159 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_service.h"
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/values.h"
+#include "build/build_config.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/ui/stedding/shortcut_hotkeys_mac.h"
+#include "chrome/browser/ui/stedding/shortcut_menu_mac.h"
+#endif
+
+namespace stedding::shortcuts {
+
+namespace {
+
+void Load(PrefService* local_state) {
+  SetCurrent(Resolve(local_state->GetDict(prefs::kShortcutsUser)));
+}
+
+void OnPrefChanged(PrefService* local_state) {
+  Load(local_state);
+#if BUILDFLAG(IS_MAC)
+  // Z11: the menu bar's rows; the windows reloaded through the callbacks.
+  ApplyShortcutsToMainMenu();
+#endif
+}
+
+std::optional<std::vector<Chord>>& SystemHotKeysForTesting() {
+  static base::NoDestructor<std::optional<std::vector<Chord>>> hot_keys;
+  return *hot_keys;
+}
+
+// The watch on the user's chords in Local State (Z11).
+std::unique_ptr<PrefChangeRegistrar>& Registrar() {
+  static base::NoDestructor<std::unique_ptr<PrefChangeRegistrar>> registrar;
+  return *registrar;
+}
+
+// The stored value, copied: a check writes nothing.
+base::DictValue StoredCopy(PrefService* local_state) {
+  return local_state->GetDict(prefs::kShortcutsUser).Clone();
+}
+
+}  // namespace
+
+void EnsureShortcutsInstalled(PrefService* local_state) {
+  std::unique_ptr<PrefChangeRegistrar>& registrar = Registrar();
+  if (!local_state || registrar ||
+      !local_state->FindPreference(prefs::kShortcutsUser)) {
+    return;
+  }
+  registrar = std::make_unique<PrefChangeRegistrar>();
+  registrar->Init(local_state);
+  registrar->Add(prefs::kShortcutsUser,
+                 base::BindRepeating(&OnPrefChanged, local_state));
+  Load(local_state);
+}
+
+void StopWatchingShortcuts() {
+  Registrar().reset();
+}
+
+RowState RowStateOf(PrefService* local_state, const Entry& entry) {
+  base::DictValue stored = StoredCopy(local_state);
+  return ShortcutEditor(stored, DefaultBindings()).StateOf(entry);
+}
+
+CheckResult CheckShortcut(PrefService* local_state,
+                          const Entry& entry,
+                          const Chord& chord,
+                          const OutsideHolders& outside) {
+  base::DictValue stored = StoredCopy(local_state);
+  return ShortcutEditor(stored, DefaultBindings())
+      .Check(entry, chord, outside);
+}
+
+CheckResult AddShortcut(PrefService* local_state,
+                        const Entry& entry,
+                        const Chord& chord,
+                        bool replace,
+                        const OutsideHolders& outside) {
+  // Asked first on a copy, so a refusal leaves the preference untouched and
+  // fires no change.
+  const CheckResult check = CheckShortcut(local_state, entry, chord, outside);
+  if (check.kind == CheckKind::kRefused || check.kind == CheckKind::kSame ||
+      (check.kind == CheckKind::kConflict && !replace)) {
+    return check;
+  }
+  ScopedDictPrefUpdate update(local_state, prefs::kShortcutsUser);
+  return ShortcutEditor(update.Get(), DefaultBindings())
+      .Add(entry, chord, replace, outside);
+}
+
+bool RemoveShortcut(PrefService* local_state,
+                    const Entry& entry,
+                    const Chord& chord) {
+  ScopedDictPrefUpdate update(local_state, prefs::kShortcutsUser);
+  return ShortcutEditor(update.Get(), DefaultBindings()).Remove(entry, chord);
+}
+
+bool SetShortcutOff(PrefService* local_state, const Entry& entry, bool off) {
+  ScopedDictPrefUpdate update(local_state, prefs::kShortcutsUser);
+  return ShortcutEditor(update.Get(), DefaultBindings()).SetOff(entry, off);
+}
+
+bool ResetShortcut(PrefService* local_state, const Entry& entry) {
+  ScopedDictPrefUpdate update(local_state, prefs::kShortcutsUser);
+  return ShortcutEditor(update.Get(), DefaultBindings()).Reset(entry);
+}
+
+void ResetAllShortcuts(PrefService* local_state) {
+  ScopedDictPrefUpdate update(local_state, prefs::kShortcutsUser);
+  ShortcutEditor(update.Get(), DefaultBindings()).ResetAll();
+}
+
+bool SetNumberKeys(PrefService* local_state, NumberKeys layout) {
+  if (!CanChangeNumberKeys()) {
+    return false;
+  }
+  ScopedDictPrefUpdate update(local_state, prefs::kShortcutsUser);
+  return ShortcutEditor(update.Get(), DefaultBindings()).SetNumberKeys(layout);
+}
+
+bool IsSystemHotKey(const Chord& chord) {
+  if (const std::optional<std::vector<Chord>>& injected =
+          SystemHotKeysForTesting()) {
+    return std::ranges::find(*injected, chord) != injected->end();
+  }
+#if BUILDFLAG(IS_MAC)
+  const std::vector<Chord> hot_keys = ReadEnabledSystemHotKeys();
+  return std::ranges::find(hot_keys, chord) != hot_keys.end();
+#else
+  return false;
+#endif
+}
+
+void SetSystemHotKeysForTesting(const std::vector<Chord>* hot_keys) {
+  if (hot_keys) {
+    SystemHotKeysForTesting() = *hot_keys;
+  } else {
+    SystemHotKeysForTesting().reset();
+  }
+}
+
