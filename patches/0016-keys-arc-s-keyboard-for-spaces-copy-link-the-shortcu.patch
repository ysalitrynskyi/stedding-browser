+++ b/chrome/browser/ui/stedding/clean_link.cc
@@ -0,0 +1,80 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/clean_link.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+// The whole table. A parameter is dropped when its lower-cased name matches
+// an entry exactly, or starts with an entry ending in "_" (the utm_ family).
+constexpr std::string_view kTrackingParameters[] = {
+    "utm_",     "fbclid",  "gclid",  "dclid",   "msclkid", "mc_eid",
+    "mc_cid",   "igshid",  "_hsenc", "_hsmi",   "mkt_tok", "yclid",
+    "twclid",   "ref_src",
+};
+
+// Parameters that track only on one site.
+constexpr std::string_view kYouTubeShareId = "si";
+
+bool IsYouTube(const GURL& url) {
+  return url.DomainIs("youtube.com") || url.DomainIs("youtu.be");
+}
+
+bool IsTracking(std::string_view raw_name, const GURL& url) {
+  const std::string name = base::ToLowerASCII(raw_name);
+  for (std::string_view entry : kTrackingParameters) {
+    if (entry.back() == '_' ? base::StartsWith(name, entry) : name == entry) {
+      return true;
+    }
+  }
+  return name == kYouTubeShareId && IsYouTube(url);
+}
+
+}  // namespace
+
+GURL CleanLink(const GURL& url) {
+  if (!url.is_valid() || !url.has_query()) {
+    return url;
+  }
+  // Work on the raw query so what survives keeps its encoding byte for byte.
+  std::vector<std::string_view> kept;
+  bool changed = false;
+  for (std::string_view part :
+       base::SplitStringPiece(url.query(), "&", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    const std::string_view name = part.substr(0, part.find('='));
+    if (IsTracking(name, url)) {
+      changed = true;
+    } else {
+      kept.push_back(part);
+    }
+  }
+  if (!changed) {
+    return url;
+  }
+  GURL::Replacements replacements;
+  const std::string query = base::JoinString(kept, "&");
+  if (query.empty()) {
+    replacements.ClearQuery();
+  } else {
+    replacements.SetQueryStr(query);
+  }
+  return url.ReplaceComponents(replacements);
+}
+
+bool HasTrackingParameters(const GURL& url) {
+  return CleanLink(url) != url;
+}
+
+}  // namespace stedding
