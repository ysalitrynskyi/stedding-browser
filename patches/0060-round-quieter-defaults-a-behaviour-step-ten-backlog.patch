 #include "chrome/browser/ui/stedding/pin_home.h"
 
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "components/url_formatter/url_fixer.h"
+#include "net/base/url_util.h"
+#include "url/url_constants.h"
+
 namespace stedding {
 
 bool IsAllowedPinHome(const GURL& url) {
   return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
 }
 
+std::optional<GURL> PinHomeFromTyped(std::u16string_view typed) {
+  const std::u16string_view trimmed =
+      base::TrimWhitespace(typed, base::TRIM_ALL);
+  if (trimmed.empty()) {
+    return std::nullopt;
+  }
+  // Whether the person named the scheme themselves: then it is kept as typed.
+  const bool typed_web_scheme =
+      base::StartsWith(trimmed, u"http://",
+                       base::CompareCase::INSENSITIVE_ASCII) ||
+      base::StartsWith(trimmed, u"https://",
+                       base::CompareCase::INSENSITIVE_ASCII);
+  GURL url = url_formatter::FixupURL(base::UTF16ToUTF8(trimmed), std::string());
+  // pins H15: a scheme the fixup supplied is https, as HTTPS-First would
+  // commit it, except for a host that has no certificate to show.
+  if (!typed_web_scheme && url.is_valid() && url.SchemeIs(url::kHttpScheme) &&
+      !net::IsLocalhost(url) && !url.HostIsIPAddress() &&
+      !net::IsHostnameNonUnique(url.host())) {
+    GURL::Replacements replacements;
+    replacements.SetSchemeStr(url::kHttpsScheme);
+    url = url.ReplaceComponents(replacements);
+  }
+  if (!IsAllowedPinHome(url)) {
+    return std::nullopt;
+  }
+  return url;
+}
+
 }  // namespace stedding
