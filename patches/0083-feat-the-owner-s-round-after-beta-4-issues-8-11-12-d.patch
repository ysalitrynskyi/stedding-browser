+
+std::optional<size_t> SwitcherChipForTabDrop(
+    const std::vector<SwitcherSpan>& spans,
+    int before,
+    int after,
+    int position) {
+  if (spans.empty()) {
+    return std::nullopt;
+  }
+  // The run of chips, wider at each end by the room the row keeps there. Its
+  // first point is left out: a spacer closed up to nothing sits there, and
+  // its centre is not a chip's.
+  const SwitcherSpan& first = spans.front();
+  const SwitcherSpan& last = spans.back();
+  if (position <= first.start - before ||
+      position >= last.start + last.extent + after) {
+    return std::nullopt;
+  }
+  for (size_t i = 0; i + 1 < spans.size(); ++i) {
+    const int end = spans[i].start + spans[i].extent;
+    // The first half of the gap to the next chip is this chip's.
+    if (position < end + (spans[i + 1].start - end) / 2) {
+      return i;
+    }
+  }
+  return spans.size() - 1;
+}
