+// Stedding (BACKLOG S-73): a tab's background as it is seen. A translucent
+// one is read over the frame it sits on: the dark sidebar's active row is a
+// light tint at 14% over a dark ground, and its inactive rows have no fill
+// at all. Read by its own channels the active row counted as white, and a
+// single-colour icon on it -- the default globe -- was masked near-black,
+// about 1.4:1 against the row; the inactive rows counted as black, which
+// gave the icon white on the light sand ground.
+SkColor TabBackground(const ui::ColorProvider& color_provider,
+                      ui::ColorId id) {
+  const SkColor color = color_provider.GetColor(id);
+  if (SkColorGetA(color) == SK_AlphaOPAQUE) {
+    return color;
+  }
+  return color_utils::GetResultingPaintColor(
+      color, color_provider.GetColor(ui::kColorFrameActive));
+}
