+// sidebar Y33 (BACKLOG S-276, GitHub issue 15): as more essentials are added
+// the grid puts more cards on a row before it takes more rows, as Arc's does:
+// up to four on one row, then two rows, the first the fuller; every card the
+// same width and none narrower than the rail's square, and each full row
+// spanning the grid, as a lone essential does. They were two to a row
+// whatever their number, so eight essentials made four rows of wide cards.
+IN_PROC_BROWSER_TEST_F(SidebarRailTest, TheEssentialsShrinkToFitTwoRows) {
+  AppendTab();
+  views::Widget* const widget = browser_view()->GetWidget();
+  TabStripModel* const strip = tab_strip_model();
+  // The essentials' drawn cards in the sidebar's coordinates, row by row,
+  // each row from left to right.
+  const auto rows = [&]() {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+    views::test::RunScheduledLayout(widget);
+    std::map<int, std::vector<gfx::Rect>> by_y;
+    for (int i = 0; i < strip->count(); ++i) {
+      if (!strip->IsTabPinned(i)) {
+        continue;
+      }
+      TabView* const card = stedding::test::FindDrawnRow(
+          widget->GetRootView(), strip->GetTabAtIndex(i));
+      if (!card) {
+        ADD_FAILURE() << "an essential has no drawn card";
+        continue;
+      }
+      const gfx::Rect bounds = views::View::ConvertRectToTarget(
+          card, region(), card->GetLocalBounds());
+      by_y[bounds.y()].push_back(bounds);
+    }
+    std::vector<std::vector<gfx::Rect>> drawn;
+    for (auto& [y, row] : by_y) {
+      std::ranges::sort(row, {}, &gfx::Rect::x);
+      drawn.push_back(row);
+    }
+    return drawn;
+  };
+
+  int essentials = 0;
+  gfx::Rect lone;
+  for (const int count : {1, 2, 3, 4, 5, 6, 8}) {
+    SCOPED_TRACE(base::StringPrintf("%d essentials", count));
+    while (essentials < count) {
+      AppendPinnedTab();
+      ++essentials;
+    }
+    const std::vector<std::vector<gfx::Rect>> drawn = rows();
+    const size_t per_row = count <= 4 ? count : (count + 1) / 2;
+    ASSERT_FALSE(drawn.empty());
+    EXPECT_EQ(per_row, drawn[0].size()) << "cards on the first row";
+    EXPECT_EQ((count + per_row - 1) / per_row, drawn.size()) << "rows";
+    if (count == 1) {
+      lone = drawn[0][0];
+    }
+    for (const std::vector<gfx::Rect>& row : drawn) {
+      EXPECT_EQ(lone.x(), row.front().x()) << "a row starts off the grid";
+      for (const gfx::Rect& card : row) {
+        EXPECT_EQ(drawn[0][0].width(), card.width()) << card.ToString();
+        EXPECT_EQ(drawn[0][0].height(), card.height()) << card.ToString();
+        EXPECT_GE(card.width(), stedding::RailRowSide())
+            << "narrower than the rail's square: " << card.ToString();
+      }
+    }
+    // A full row spans the grid, to the rounding of its cards' widths.
+    EXPECT_NEAR(lone.right(), drawn[0].back().right(),
+                static_cast<int>(per_row))
+        << "the first row stops short of the grid";
+  }
+}
