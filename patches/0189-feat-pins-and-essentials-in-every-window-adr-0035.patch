+// windows G21: a deleted Space's pins move once, after the last record of
+// the Space that takes them; its own essentials stay own only on a Space with
+// a session of its own (ADR 0028).
+TEST_F(PinStoreTest, ADeletedSpacesPinsMoveOnce) {
+  const SpaceId gone = NewSpace();
+  const SpaceId taker = NewSpace();
+  PinRecord own = Essential("e", "https://e.example/");
+  own.space = gone;
+  own.has_space = true;
+  {
+    PinStore store(&prefs_);
+    Ready(store, {Pin("a", gone, "https://a.example/"), own,
+                  Pin("t", taker, "https://t.example/"),
+                  Essential("s", "https://s.example/")});
+    Counter counter;
+    base::ScopedObservation<PinStore, PinStore::Observer> watch(&counter);
+    watch.Observe(&store);
+    store.MoveSpace(gone, taker, /*to_has_own_session=*/false);
+    EXPECT_EQ(1, counter.changes);
+    EXPECT_THAT(Ids(store), ElementsAre("t", "a", "e", "s"));
+    EXPECT_EQ(taker, store.Find("a")->space);
+    EXPECT_EQ(PinTier::kSpacePin, store.Find("e")->tier);
+    EXPECT_EQ(taker, store.Find("e")->space);
+    // Nothing of the deleted Space is left to move.
+    store.MoveSpace(gone, taker, false);
+    EXPECT_EQ(1, counter.changes);
+  }
+  prefs_.ClearPref(stedding::prefs::kPinStore);
+  prefs_.ClearPref(stedding::prefs::kPinStoreReady);
+  PinStore store(&prefs_);
+  Ready(store, {own});
+  store.MoveSpace(gone, taker, /*to_has_own_session=*/true);
+  EXPECT_EQ(PinTier::kEssential, store.Find("e")->tier);
+  EXPECT_EQ(taker, store.Find("e")->space);
+}
