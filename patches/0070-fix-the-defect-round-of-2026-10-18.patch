+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest,
+                       TheSpaceLeftSlidesOutAsTheNewOneComesIn) {
+  if (!stedding::ShouldAnimate(browser()->GetProfile()->GetPrefs())) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
