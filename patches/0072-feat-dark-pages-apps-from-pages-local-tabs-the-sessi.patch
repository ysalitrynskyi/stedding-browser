+void SessionTabHelper::TitleWasSet(content::NavigationEntry* entry) {
+  // Stedding: the session hears of a page's title when the page sets it.
+  // Upstream wrote an entry at its commit, before the page has a title, and
+  // again only when the renderer sent the page's state (after a scroll, a
+  // form change or a history call, or as the page is left) or the whole
+  // session was rebuilt, so a page that none of those happened to kept an
+  // empty title in the session. A tab the next start restored without
+  // loading then read its address ("d.html") in place of its title until it
+  // was clicked (tabs R31, BACKLOG S-229).
+  if (!GetDelegate() || !entry || entry->IsInitialEntry()) {
+    return;
+  }
+  const int entry_id = entry->GetUniqueID();
+  if (entry_id != title_entry_id_) {
+    // An entry's first title is written at once: it is the one its commit
+    // could not carry. The title another entry is still owed goes first.
+    if (title_write_timer_.IsRunning()) {
+      title_write_timer_.FireNow();
+    }
+    WriteTitle(entry_id);
+    return;
+  }
+  // The same entry again: a page that keeps changing its title is written at
+  // most every kTitleWriteInterval, with the last title it set once the
+  // interval ends, so a clock or a blinking title cannot turn every change
+  // into a session write and bring the session's full rebuild early.
+  if (title_write_timer_.IsRunning()) {
+    return;
+  }
+  const base::TimeDelta wait =
+      title_written_at_ + kTitleWriteInterval - base::TimeTicks::Now();
+  if (wait.is_positive()) {
+    title_write_timer_.Start(FROM_HERE, wait,
+                             base::BindOnce(&SessionTabHelper::WriteTitle,
+                                            base::Unretained(this), entry_id));
+    return;
+  }
+  WriteTitle(entry_id);
+}
+
+void SessionTabHelper::WriteTitle(int entry_id) {
+  SessionTabHelperDelegate* delegate = GetDelegate();
+  if (!delegate) {
+    return;
+  }
+  // The entry is found by its id, at the index it has now. A new pending
+  // entry is not in the list yet, and its commit writes it, title and all;
+  // an entry pruned or deleted since its title was set is not written.
+  content::NavigationController& controller = web_contents()->GetController();
+  for (int index = 0; index < controller.GetEntryCount(); ++index) {
+    content::NavigationEntry* entry = controller.GetEntryAtIndex(index);
+    if (entry->GetUniqueID() != entry_id) {
+      continue;
+    }
+    if (entry_id == title_entry_id_ && entry->GetTitle() == written_title_) {
+      return;
+    }
+    delegate->UpdateTabNavigation(
+        window_id(), session_id(),
+        ContentSerializedNavigationBuilder::FromNavigationEntry(index, entry));
+    title_entry_id_ = entry_id;
+    written_title_ = entry->GetTitle();
+    title_written_at_ = base::TimeTicks::Now();
+    return;
+  }
+}
+
 SessionTabHelperDelegate* SessionTabHelper::GetDelegate() {
   return delegate_lookup_ ? delegate_lookup_.Run(web_contents()) : nullptr;
 }
