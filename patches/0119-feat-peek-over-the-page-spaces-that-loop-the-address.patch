+void SidebarAddressField::UpdateButtons() {
+  // The site button for a page with a site panel: a web page or a file
+  // (address row controls' SiteInformationAvailable).
+  const bool web = url_.SchemeIsHTTPOrHTTPS();
+  const bool site = web || url_.SchemeIsFile();
+  // Install App is in the site panel (site-controls Si14; BACKLOG S-403).
+  const bool copy =
+      web && copy_link_pref_.prefs() &&
+      copy_link_pref_.prefs()->GetBoolean(prefs::kCopyLinkButton);
+  bool changed = false;
+  if (site_button_->GetVisible() != site) {
+    site_button_->SetVisible(site);
+    changed = true;
+  }
+  if (copy_link_->GetVisible() != copy) {
+    copy_link_->SetVisible(copy);
+    changed = true;
+  }
+  // The words start the field's inset in when there is no site button. Set
+  // only when it changes: this runs on every toolbar update (BACKLOG S-399,
+  // the fourth item).
+  const gfx::Insets margins = gfx::Insets::TLBR(
+      0, site ? 2 : kFieldTextInset - kFieldButtonInset, 0, 0);
+  const gfx::Insets* const current = label_->GetProperty(views::kMarginsKey);
+  if (!current || *current != margins) {
+    label_->SetProperty(views::kMarginsKey, margins);
+    changed = true;
+  }
+  // The field lays itself out by hand, so neither a child's visibility nor a
+  // margin asks for it: a change here does (the Copy Link setting turned off
+  // left a gap where the button was).
+  if (changed) {
+    InvalidateLayout();
+  }
+}
