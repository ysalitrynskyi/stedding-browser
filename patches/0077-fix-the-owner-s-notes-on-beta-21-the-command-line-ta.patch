+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_LITTLE_PROMOTE_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_LITTLE_PROMOTE_BUTTON_H_
+
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "ui/base/interaction/element_identifier.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/button/label_button.h"
+
+class BrowserWindowInterface;
+
+namespace stedding {
+
+// docs/features/little.md E7, E8: "Open in Stedding" at the right end of a
+// little window's row, as Little Arc has it. A click moves the page into a tab
+// of the main window as it is (no reload, its history kept), or into a new
+// window when none is open: the window's IDC_STEDDING_LITTLE_PROMOTE, the
+// command its page menu runs and Cmd-O does. Quiet: the address's own colours
+// and the row's buttons' hover, on the page's colour, light or dark. Its
+// tooltip says what it does and gives the chord; to assistive technology it is
+// a button named "Open in Stedding". Every popup's bar has one, shown in a
+// little window alone. A little window is marked before its views are made
+// (E8); the button looks again when a tab arrives, for a window marked after.
+class LittlePromoteButton : public views::LabelButton,
+                            public TabStripModelObserver {
+  METADATA_HEADER(LittlePromoteButton, views::LabelButton)
+
+ public:
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kElementId);
+
+  explicit LittlePromoteButton(BrowserWindowInterface* browser);
+  LittlePromoteButton(const LittlePromoteButton&) = delete;
+  LittlePromoteButton& operator=(const LittlePromoteButton&) = delete;
+  ~LittlePromoteButton() override;
+
+  // "Move this page into a tab of the main window (⌘O)": the action and the
+  // window's chord for it; the action alone when the window has none.
+  std::u16string TooltipText() const;
+
+  // views::View:
+  void AddedToWidget() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  void OnPressed();
+  // Shown in a little window alone, with the tooltip read again: the chord
+  // is the window's, which the button is made before.
+  void Update();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_LITTLE_PROMOTE_BUTTON_H_
