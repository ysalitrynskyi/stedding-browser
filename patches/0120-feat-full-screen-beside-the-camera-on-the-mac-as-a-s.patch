+// toolbar T61 (GitHub issue 98): the bookmarks bar is part of the address
+// row. Its text and icons are the row's, readable on the ground in both
+// colour modes, and the colour its labels read against is the ground's; a
+// page-coloured row's text recolours it too (the supplier's mixer comes after
+// every other). Material's own surface and on-surface colours had made it a
+// grey band, its text dark on a dark page's row.
+TEST(SteddingColorMixerTest, TheBookmarksBarTakesTheRowsColours) {
+  base::test::ScopedFeatureList features(stedding::kArcStyleWindow);
+  for (const auto mode : {ui::ColorProviderKey::ColorMode::kDark,
+                          ui::ColorProviderKey::ColorMode::kLight}) {
+    ui::ColorProviderKey key;
+    key.color_mode = mode;
+    for (const std::optional<SkColor> page_text :
+         {std::optional<SkColor>(), std::optional<SkColor>(SK_ColorWHITE),
+          std::optional<SkColor>(SK_ColorBLACK)}) {
+      SCOPED_TRACE(testing::Message()
+                   << "mode " << static_cast<int>(mode) << ", page text "
+                   << (page_text ? color_utils::SkColorToRgbaString(*page_text)
+                                 : std::string("none")));
+      ui::ColorProvider provider;
+      ui::AddColorMixers(&provider, key);
+      AddChromeColorMixers(&provider, key);
+      if (page_text) {
+        ui::ColorMixer& page = provider.AddMixer();
+        page[kColorToolbarText] = ui::ColorTransform(SkColor{*page_text});
+        page[kColorToolbarButtonIcon] = ui::ColorTransform(SkColor{*page_text});
+      }
+      provider.GenerateColorMapForTesting();
+      EXPECT_EQ(provider.GetColor(kColorToolbarText),
+                provider.GetColor(kColorBookmarkBarForeground));
+      EXPECT_EQ(provider.GetColor(kColorToolbarButtonIcon),
+                provider.GetColor(kColorBookmarkButtonIcon));
+      EXPECT_EQ(provider.GetColor(kColorToolbarButtonIcon),
+                provider.GetColor(kColorBookmarkFolderIcon));
+      if (!page_text) {
+        const SkColor ground = provider.GetColor(ui::kColorFrameActive);
+        EXPECT_EQ(provider.GetColor(kColorToolbar),
+                  provider.GetColor(kColorBookmarkBarBackground));
+        EXPECT_GE(color_utils::GetContrastRatio(
+                      provider.GetColor(kColorBookmarkBarForeground), ground),
+                  4.5f);
+      }
+    }
+  }
+}
