+  const spaces::SpaceId clients =
+      model()->AddSpace("Clients", SK_ColorRED)->id();
+  const spaces::SpaceId play = model()->AddSpace("Play", SK_ColorGRAY)->id();
+  const spaces::SpaceId docs = model()->AddSpace("Docs", SK_ColorYELLOW)->id();
+  const spaces::SpaceId family =
+      model()->AddSpace("Family", SK_ColorMAGENTA)->id();
+  const std::string work_session = model()->MakeSession("Work");
+  const std::string personal_session = model()->MakeSession("Personal");
+  for (const spaces::SpaceId& id : {work_, clients, docs}) {
+    model()->SetSpaceSession(id, work_session);
+  }
+  for (const spaces::SpaceId& id : {personal, family}) {
+    model()->SetSpaceSession(id, personal_session);
+  }
+  spaces::SpaceSwitcherView* const switcher =
+      stedding::test::FindDrawnSwitcher(widget()->GetRootView());
+  ASSERT_TRUE(switcher);
+  Layout();
+  const std::vector<spaces::SwitcherSessionLine> lines =
+      switcher->SessionLines();
+  ASSERT_EQ(2u, lines.size());
+  EXPECT_EQ(work_session, lines[0].session);
+  EXPECT_EQ(0, lines[0].lane);
+  EXPECT_EQ(3u, lines[0].segments.size());
+  EXPECT_EQ(2u, lines[0].connectors.size());
+  EXPECT_EQ(personal_session, lines[1].session);
+  EXPECT_EQ(1, lines[1].lane) << "Personal's line crosses Work's";
+  EXPECT_EQ(2u, lines[1].segments.size());
+  EXPECT_EQ(1u, lines[1].connectors.size());
+  for (const spaces::SpaceId& id : {work_, clients, docs, personal, family}) {
+    ASSERT_TRUE(LineUnder(Chip(id)));
+    EXPECT_EQ(model()->SessionOf(id), LineUnder(Chip(id))->session);
+    EXPECT_FALSE(stedding::FindShownIsolationMark(Chip(id)));
+  }
+  EXPECT_FALSE(LineUnder(Chip(home_)));
+  EXPECT_FALSE(LineUnder(Chip(play)));
+  EXPECT_NE(SessionSlotOf(work_), SessionSlotOf(personal));
+  EXPECT_EQ(SessionSlotOf(work_), SessionSlotOf(docs));
+
+  // Work on screen: the rail's one full chip among dots.
+  ASSERT_TRUE(model()->SetActiveSpace(work_));
+  tabs::VerticalTabStripStateController* const controller =
+      tabs::VerticalTabStripStateController::From(browser());
+  controller->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+  ASSERT_TRUE(controller->IsCollapsed());
+  EXPECT_TRUE(switcher->SessionLines().empty()) << "a line in the rail";
+  // The rail shows its first chips full and the rest as dots (sidebar Y13):
+  // every full chip of a session wears its disc.
+  int discs = 0;
+  for (const spaces::SpaceId& id :
+       {home_, work_, personal, clients, play, docs, family}) {
+    views::View* const chip = Chip(id);
+    ASSERT_TRUE(chip);
+    stedding::IsolationMarkView* const badge =
+        stedding::FindShownIsolationMark(chip);
+    if (model()->SessionOf(id).empty()) {
+      EXPECT_FALSE(badge);
+      continue;
+    }
+    if (badge) {
+      ++discs;
+      EXPECT_EQ(SessionSlotOf(id), badge->session_slot());
+    } else {
+      EXPECT_EQ(spaces::kSwitcherDot, chip->width()) << "a full chip unmarked";
+    }
+  }
+  EXPECT_GT(discs, 0);
+}
