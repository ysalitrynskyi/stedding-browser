+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/clear_tabs_row_view.h"
+
+#include <memory>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/background.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/flex_layout_types.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/layout/layout_types.h"
+
+namespace spaces {
+namespace {
+constexpr int kRowHeight = 24;
+constexpr int kRowInset = 10;
+
+// The reference's divider is barely there: a hairline at about a tenth
+// strength, not a rule.
+constexpr SkColor kHairlineColor = SkColorSetARGB(0x2B, 0xFF, 0xFF, 0xFF);
+}  // namespace
+
+ClearTabsRowView::ClearTabsRowView(Browser* browser) : browser_(browser) {
+  // BoxLayout rather than FlexLayout: FlexLayout stretched the hairline to the
+  // row's height whatever preferred size or cross-axis alignment it was given,
+  // which drew a bar instead of a line.
+  auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal,
+      gfx::Insets::VH(0, kRowInset), kRowInset));
+  layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+
+  // A plain view rather than views::Separator: Separator paints its whole
+  // bounds whatever preferred size it is given.
+  auto* const line = AddChildView(std::make_unique<views::View>());
+  line->SetPreferredSize(gfx::Size(0, 1));
+  line->SetBackground(views::CreateSolidBackground(kHairlineColor));
+  layout->SetFlexForView(line, 1);
+
+  auto clear = std::make_unique<views::LabelButton>(
+      base::BindRepeating(&ClearTabsRowView::OnClearPressed,
+                          base::Unretained(this)),
+      u"Clear");
+  clear->SetPreferredSize(gfx::Size(56, kRowHeight));
+  clear->SetTooltipText(u"Close this Space's tabs");
+  AddChildView(std::move(clear));
+
+  SetPreferredSize(gfx::Size(0, kRowHeight));
+  SetProperty(views::kFlexBehaviorKey,
+              views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                                       views::MaximumFlexSizeRule::kPreferred));
+}
+
+ClearTabsRowView::~ClearTabsRowView() = default;
+
+void ClearTabsRowView::OnClearPressed() {
+  TabStripModel* const tabs = browser_->tab_strip_model();
+  SpaceModel* const model = SpaceModel::From(browser_);
+
+  // Collect first, close after: closing shifts every index behind it.
+  std::vector<content::WebContents*> doomed;
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    // Pinned tabs are the essentials row and belong to every Space, so Clear
+    // leaves them where they are.
+    if (tab->IsPinned()) {
+      continue;
+    }
+    if (model && !model->IsTabInActiveSpace(tab)) {
+      continue;
+    }
+    doomed.push_back(tab->GetContents());
+  }
+
+  for (content::WebContents* contents : doomed) {
+    const int index = tabs->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      tabs->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  }
+}
+
+BEGIN_METADATA(ClearTabsRowView)
+END_METADATA
+
+}  // namespace spaces
