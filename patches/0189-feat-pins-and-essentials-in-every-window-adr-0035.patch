+    const std::vector<tabs::TabInterface*> there = Pins(second);
+    return there.size() == 1u &&
+           stedding::TabName(there.front()->GetContents()) == u"Renamed";
+  })) << "the second window kept the unpinned pin or the old name";
+  ASSERT_EQ(1u, Pins(browser()).size());
+  EXPECT_EQ(y, Pins(browser()).front());
