+// sidebar Y49 (GitHub issue 45, a comment of 2026-11-03; BACKLOG S-399, the
+// fourth item, S-403): at every width, on every page, nothing the field
+// draws runs past its end. Short of room the site's name keeps its minimum
+// and the pinned extensions' icons give way to their menu; the site's name
+// had given way first, all of it, and the icons then ran out of the field.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest,
+                       TheLentExtensionsStayInsideTheField) {
+  ToolbarActionsModel* const actions =
+      ToolbarActionsModel::Get(browser()->GetProfile());
+  std::vector<std::unique_ptr<extensions::TestExtensionDir>> dirs;
+  std::vector<std::string> ids;
+  for (int i = 0; i < 4; ++i) {
+    auto dir = std::make_unique<extensions::TestExtensionDir>();
+    dir->WriteManifest(base::StringPrintf(
+        R"({"manifest_version": 3, "name": "Pinned %d", "version": "1",)"
+        R"( "action": {}})",
+        i));
+    const scoped_refptr<const extensions::Extension> extension =
+        extensions::ChromeTestExtensionLoader(browser()->GetProfile())
+            .LoadExtension(dir->UnpackedPath());
+    ASSERT_TRUE(extension);
+    // Chromium 157 pins an extension's button when it is installed
+    // (docs/HANDOFF.md trap 134); pinning it again fails a DCHECK.
+    if (!actions->IsActionPinned(extension->id())) {
+      actions->SetActionVisibility(extension->id(), true);
+    }
+    ids.push_back(extension->id());
+    dirs.push_back(std::move(dir));
+  }
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !browser_view()->IsToolbarVisible(); }));
+  ExtensionsToolbarDesktop* const extensions =
+      browser_view()->toolbar()->extensions_container_for_testing();
+  ASSERT_TRUE(extensions);
+
+  const auto check = [&](const std::string& where) {
