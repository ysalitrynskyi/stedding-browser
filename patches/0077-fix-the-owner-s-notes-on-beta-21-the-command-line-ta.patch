+void FolderView::OnHeaderDragged(const gfx::Point& screen_point) {
+  header_dragging_ = true;
+  ShowDropIndicator(DropPlaceAt(screen_point));
+}
+
+void FolderView::OnHeaderDragEnded(const gfx::Point& screen_point,
+                                   bool drop) {
+  header_dragging_ = false;
+  ShowDropIndicator(std::nullopt);
+  if (!drop) {
+    return;
+  }
+  // After the release's own dispatch: the move lays the rows out again.
+  if (const std::optional<DropPlace> place = DropPlaceAt(screen_point);
+      place && place->moves) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&FolderView::PlaceAt, weak_factory_.GetWeakPtr(),
+                       place->pinned, place->slot));
+  }
+}
