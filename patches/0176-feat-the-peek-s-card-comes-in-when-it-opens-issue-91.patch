+// Stedding (docs/features/peek.md P26, GitHub issue 102): whether `page`, the
+// page of a peek shown over a window's active tab, matches `query` in that
+// tab's place: no tab strip holds it, so it is in no group or split, and not
+// pinned, discarded or frozen; it is the active, highlighted tab. Its title,
+// address, state and sound are its own.
+bool PeekPageMatches(const api::tabs::Query::Params::QueryInfo& query,
+                     const Extension* extension,
+                     mojom::ContextType context,
+                     content::WebContents& page,
+                     const URLPatternSet& target_url_patterns) {
+  if (!MatchesBool(query.active, true) ||
+      !MatchesBool(query.highlighted, true) ||
+      !MatchesBool(query.pinned, false) ||
+      !MatchesBool(query.discarded, false) ||
+      !MatchesBool(query.frozen, false) ||
+      !MatchesBool(query.muted, page.IsAudioMuted()) ||
+      !MatchesBool(query.audible, page.IsCurrentlyAudible())) {
+    return false;
+  }
+  if ((query.group_id && *query.group_id != -1) ||
+      (query.split_view_id && *query.split_view_id != -1)) {
+    return false;
+  }
+  const ExtensionTabUtil::ScrubTabBehavior scrub =
+      ExtensionTabUtil::GetScrubTabBehavior(extension, context, &page);
+  if (query.title && !query.title->empty() &&
+      (scrub.committed_info == ExtensionTabUtil::kScrubTabFully ||
+       !base::MatchPattern(page.GetTitle(), base::UTF8ToUTF16(*query.title)))) {
+    return false;
+  }
+  if (!target_url_patterns.is_empty() &&
+      (scrub.committed_info == ExtensionTabUtil::kScrubTabFully ||
+       !target_url_patterns.MatchesURL(page.GetLastCommittedURL()))) {
+    return false;
+  }
+  return query.status == api::tabs::TabStatus::kNone ||
+         query.status == ExtensionTabUtil::GetLoadingStatus(&page);
+}
