+
+  // What the mark says on the bar's first row whose title, or with
+  // `by_detail` whose detail, is `text`; "<no row>" without one. The bar
+  // opens with `command`: ⌘T lists tabs, ⇧⌘P commands. A row that says
+  // something draws the mark; one that says nothing draws none.
+  std::u16string BarRowMark(int command,
+                            const std::u16string& text,
+                            bool by_detail = false) {
+    chrome::ExecuteCommand(browser(), command);
+    stedding::CommandBarView* const bar =
+        stedding::CommandBarView::GetOpenBar(browser_view());
+    if (!bar) {
+      return u"<no bar>";
+    }
+    std::u16string says = u"<no row>";
+    for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+      const std::u16string& key = by_detail ? bar->row_detail_for_testing(i)
+                                            : bar->row_title_for_testing(i);
+      if (key != text) {
+        continue;
+      }
+      says = bar->row_mark_for_testing(i);
+      views::View* const row = bar->row_view_for_testing(i);
+      EXPECT_TRUE(row);
+      if (row) {
+        EXPECT_EQ(!says.empty(), !!stedding::FindShownIsolationMark(row))
+            << base::UTF16ToUTF8(text);
+        EXPECT_EQ(says, row->GetViewAccessibility().GetCachedDescription());
+      }
+      break;
+    }
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+    return says;
+  }
+
+  // What the tab menu of the active tab, through the window's own delegate,
+  // says on the row of the Space named `space` in its submenu `submenu`:
+  // its accessible name when the row wears the cookie and its words, "" when
+  // it wears neither, "<half>" when it wears one alone, "<no row>" without
+  // such a row.
+  std::u16string TabMenuRowMark(TabStripModel::ContextMenuCommand submenu,
+                                const std::u16string& space) {
+    ReadOnlyMenu commands;
+    TabMenuModel menu(&commands, TabMenuModelDelegate::From(browser()),
+                      tabs(), tabs()->active_index());
+    const std::optional<size_t> at = menu.GetIndexOfCommandId(submenu);
+    ui::MenuModel* const rows = at ? menu.GetSubmenuModelAt(*at) : nullptr;
+    if (!rows) {
+      return u"<no row>";
+    }
+    for (size_t i = 0; i < rows->GetItemCount(); ++i) {
+      if (!rows->GetLabelAt(i).starts_with(space)) {
+        continue;
+      }
+      const bool icon = !rows->GetIconAt(i).IsEmpty();
+      const bool words =
+          base::StrCat({rows->GetLabelAt(i), u" ", rows->GetMinorTextAt(i)})
+              .find(spaces::IsolationMarkName()) != std::u16string::npos;
+      if (icon != words) {
+        return u"<half>";
+      }
+      return icon ? rows->GetAccessibleNameAt(i) : std::u16string();
+    }
+    return u"<no row>";
+  }
+
+  // `script`'s answer on `page` once it is `expected`, or what it answered
+  // last.
+  std::string Read(content::WebContents* page,
+                   const std::string& script,
+                   const std::string& expected) {
+    std::string answer;
+    std::ignore = base::test::RunUntil([&]() {
+      answer = content::EvalJs(page, script).ExtractString();
+      return answer == expected;
+    });
+    return answer;
+  }
+
+  // The Settings row of `id` on `page`, as kSettingsRow reads it, once the
+  // page has drawn the row as `expected`. Answers what it last read.
+  std::string SettingsRow(content::WebContents* page,
+                          const spaces::SpaceId& id,
+                          const std::string& expected) {
+    return Read(page, content::JsReplace(kSettingsRow, id.ToString()),
+                expected);
+  }
+
+  // Settings' choices for links from other apps, once they hold `choice`.
+  std::vector<std::string> ExternalChoices(content::WebContents* page,
+                                           const std::u16string& choice) {
+    std::vector<std::string> choices;
+    std::ignore = base::test::RunUntil([&]() {
+      choices = base::SplitString(
+          content::EvalJs(page, kSettingsExternalChoices).ExtractString(),
+          "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+      return std::ranges::find(choices, base::UTF16ToUTF8(choice)) !=
+             choices.end();
+    });
+    return choices;
+  }
+
+  // The marks drawn anywhere in `window`.
+  static int DrawnMarks(views::View* view) {
+    int marks = 0;
+    if (const auto* const mark =
+            views::AsViewClass<stedding::IsolationMarkView>(view);
+        mark && mark->IsDrawn()) {
+      ++marks;
+    }
+    for (views::View* const child : view->children()) {
+      marks += DrawnMarks(child);
+    }
+    return marks;
+  }
+  static int DrawnMarks(BrowserWindowInterface* window) {
+    views::Widget* const widget =
+        BrowserView::GetBrowserViewForBrowser(window)->GetWidget();
+    views::test::RunScheduledLayout(widget);
+    return DrawnMarks(widget->GetRootView());
+  }
+
+  bool Animating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+
+  // The toast `id`, reading `text`, with its button, held up for the steps
+  // that follow: on a slow build Chromium's 8 seconds can run out.
+  void WaitForToast(ToastId id, const std::u16string& text) {
+    ASSERT_TRUE(toasts());
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      toasts::ToastView* const view = toasts()->GetToastViewForTesting();
+      return toasts()->IsShowingToast() &&
+             toasts()->GetCurrentToastId() == id && view &&
+             view->label_for_testing() &&
+             view->label_for_testing()->GetText() == text;
+    })) << "no toast reading " << base::UTF16ToUTF8(text);
+    ASSERT_TRUE(toasts()->GetToastViewForTesting()->action_button_for_testing())
+        << "with its button";
+    toasts()->GetToastCloseTimerForTesting()->Stop();
+  }
+
+  // Runs what is already posted: a pin's notice is posted in the pin's turn,
+  // so after this it shows or it never will.
+  static void RunPostedTasks() {
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, run_loop.QuitClosure());
+    run_loop.Run();
+  }
+
+  // `url` typed into the tab on screen, as into the address bar, and loaded.
+  // A fresh tab of a Space with an Independent session gets new contents in
+  // that Space's jar before the address loads (routing D2, PLAN.md CMD-8), so
+  // the wait follows the tab: ui_test_utils::NavigateToURL waits on the
+  // contents the tab had, which load nothing, and timed out.
+  void TypeAddress(const GURL& url) {
+    tabs::TabInterface* const tab = tabs()->GetActiveTab();
+    ASSERT_TRUE(tab);
+    browser()->OpenURL(content::OpenURLParams::CreateBrowserInitiated(
+                           url, WindowOpenDisposition::CURRENT_TAB,
+                           ui::PAGE_TRANSITION_TYPED),
+                       /*navigation_handle_callback=*/{});
+    ASSERT_TRUE(content::WaitForLoadStop(tab->GetContents()));
+    ASSERT_EQ(url, tab->GetContents()->GetLastCommittedURL());
+  }
+
+  bool InASpacesJar(tabs::TabInterface* tab) {
+    return spaces::IsSpaceStoragePartition(
+        spaces::StoragePartitionConfigForWebContents(tab->GetContents()));
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  spaces::SpaceId home_ = spaces::SpaceId::CreateEmpty();
+  spaces::SpaceId work_ = spaces::SpaceId::CreateEmpty();
+};
+
+// sessions S32, S34, spaces B38: with Work's session on, every surface of the
+// sidebar, the command bar and Settings that shows Work marks it and none
+// marks Home; turned off, the mark goes from each.
+IN_PROC_BROWSER_TEST_F(IsolationMarkTest,
+                       EverySurfaceMarksTheSpaceUntilItsSessionIsOff) {
+  model()->SetSpaceIsolated(work_, true);
+  ASSERT_TRUE(model()->SpaceIsIsolated(work_));
+  // A switch to an empty Space opens a tab there: Work holds one of its own.
+  ASSERT_TRUE(model()->SetActiveSpace(work_));
+  ASSERT_TRUE(model()->SetActiveSpace(home_));
+  const std::u16string work_name = model()->DisplayName(work_);
+  const std::u16string home_name = model()->DisplayName(home_);
+
+  {
+    SCOPED_TRACE("the switcher's chips");
+    ExpectChipMarked(work_, true);
+    ExpectChipMarked(home_, false);
+  }
+  {
+    SCOPED_TRACE("the name floating over a chip");
+    EXPECT_EQ(spaces::NameWithIsolationMark(work_name), FloatingName(work_));
+    EXPECT_EQ(home_name, FloatingName(home_));
+  }
+  {
+    SCOPED_TRACE("the title row");
+    ExpectTitleMarked(false);
+    ASSERT_TRUE(model()->SetActiveSpace(work_));
+    ExpectTitleMarked(true, Form::kGlyph);
+    ExpectChipMarked(work_, true);
+    ASSERT_TRUE(model()->SetActiveSpace(home_));
+  }
+  {
+    SCOPED_TRACE("the command bar");
+    EXPECT_EQ(Says(), BarRowMark(IDC_STEDDING_COMMAND_PALETTE,
+                                 base::StrCat({u"Move Tab to ", work_name})));
+    EXPECT_EQ(Says(), BarRowMark(IDC_NEW_TAB, work_name, /*by_detail=*/true))
+        << "Work's tab, listed from Home with its Space named";
+  }
+  // Settings opens in Home, beside its tab.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const settings =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  const std::string says = base::UTF16ToUTF8(Says());
+  const std::string marked = base::StrCat({says, "|switch|", says});
+  const std::u16string marked_work = spaces::NameWithIsolationMark(work_name);
+  {
+    SCOPED_TRACE("Settings' Space rows");
+    EXPECT_EQ(marked, SettingsRow(settings, work_, marked));
+    EXPECT_EQ("|switch|", SettingsRow(settings, home_, "|switch|"));
+  }
+  {
+    SCOPED_TRACE("Settings' choice for links from other apps");
+    const std::vector<std::string> choices =
+        ExternalChoices(settings, marked_work);
+    EXPECT_TRUE(std::ranges::find(choices, base::UTF16ToUTF8(marked_work)) !=
+                choices.end())
+        << base::JoinString(choices, ", ");
+    EXPECT_TRUE(std::ranges::find(choices, base::UTF16ToUTF8(home_name)) !=
+                choices.end())
+        << "Home, unmarked: " << base::JoinString(choices, ", ");
+  }
+  {
+    SCOPED_TRACE("the rail");
+    tabs::VerticalTabStripStateController* const controller =
+        tabs::VerticalTabStripStateController::From(browser());
+    controller->RequestCollapse(true);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    ASSERT_TRUE(controller->IsCollapsed());
+    ExpectChipMarked(work_, true);
+    ExpectChipMarked(home_, false);
+    EXPECT_EQ(base::StrCat({work_name, u"\n", Says()}),
+              Chip(work_)->GetTooltipText())
+        << "the rail's tooltip names the Space, then its session";
+    EXPECT_EQ(home_name, Chip(home_)->GetTooltipText());
+    ASSERT_TRUE(model()->SetActiveSpace(work_));
+    ExpectTitleMarked(true, Form::kBadge, work_name);
+    ASSERT_TRUE(model()->SetActiveSpace(home_));
+    controller->RequestCollapse(false);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    ASSERT_FALSE(controller->IsCollapsed());
+  }
+  {
+    // spaces B24: at overflow an inactive chip is a dot, with no room for the
+    // badge; it still says it, and the pointer on the row brings it back.
+    SCOPED_TRACE("a dot");
+    for (int i = 0; i < 40 && Chip(work_) &&
+                    Chip(work_)->width() > spaces::kSwitcherDot;
+         ++i) {
+      model()->AddSpace(std::string(), SK_ColorGREEN);
+    }
+    ASSERT_EQ(home_, model()->active_id());
+    views::View* const dot = Chip(work_);
+    ASSERT_TRUE(dot);
+    ASSERT_EQ(spaces::kSwitcherDot, dot->width()) << "no overflow";
+    EXPECT_FALSE(stedding::FindShownIsolationMark(dot));
+    EXPECT_EQ(Says(), dot->GetViewAccessibility().GetCachedDescription());
+    PointerOn(dot);
+    ExpectChipMarked(work_, true);
+    PointerOn(nullptr);
+    std::vector<spaces::SpaceId> added;
+    for (const auto& space : model()->spaces()) {
+      if (space->id() != home_ && space->id() != work_) {
+        added.push_back(space->id());
+      }
+    }
+    for (const spaces::SpaceId& id : added) {
+      ASSERT_TRUE(model()->RemoveSpace(id));
+    }
+    ASSERT_EQ(2u, model()->size());
+  }
+
+  model()->SetSpaceIsolated(work_, false);
+  ASSERT_FALSE(model()->SpaceIsIsolated(work_));
+  {
+    SCOPED_TRACE("the session turned off");
+    ExpectChipMarked(work_, false);
+    EXPECT_EQ(work_name, FloatingName(work_));
+    EXPECT_EQ(u"", BarRowMark(IDC_STEDDING_COMMAND_PALETTE,
+                              base::StrCat({u"Move Tab to ", work_name})));
+    EXPECT_EQ(u"", BarRowMark(IDC_NEW_TAB, work_name, /*by_detail=*/true));
+    EXPECT_EQ("|switch|", SettingsRow(settings, work_, "|switch|"));
+    const std::vector<std::string> choices =
+        ExternalChoices(settings, work_name);
+    EXPECT_TRUE(std::ranges::find(choices, base::UTF16ToUTF8(marked_work)) ==
+                choices.end())
+        << base::JoinString(choices, ", ");
+    ASSERT_TRUE(model()->SetActiveSpace(work_));
+    ExpectTitleMarked(false);
+  }
+}
+
+// sessions S32: the tab menu's Move to Space and Always Open rows, the toast
+// of a tab a route moved and the archive page mark Work, through the
+// browser's own delegate, handler and page, and none marks Home; with Work's
+// session off, none marks Work.
+IN_PROC_BROWSER_TEST_F(IsolationMarkTest,
+                       TheMenusTheToastAndTheArchiveMarkTheSpace) {
+  model()->SetSpaceIsolated(work_, true);
+  const std::u16string work_name = model()->DisplayName(work_);
+  const std::u16string home_name = model()->DisplayName(home_);
+  const std::u16string marked_row = base::StrCat({work_name, u", ", Says()});
+  // Home's tab shows a web page, so its menu offers Always Open.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("home.test")));
+  {
+    SCOPED_TRACE("the tab menu");
+    EXPECT_EQ(marked_row,
+              TabMenuRowMark(TabStripModel::CommandSteddingMoveToSpaceMenu,
+                             work_name));
+    EXPECT_EQ(marked_row,
+              TabMenuRowMark(TabStripModel::CommandSteddingRouteToSpaceMenu,
+                             work_name));
+    EXPECT_EQ(u"",
+              TabMenuRowMark(TabStripModel::CommandSteddingRouteToSpaceMenu,
+                             home_name));
+  }
+  {
+    SCOPED_TRACE("the routed toast");
+    spaces::Route route;
+    route.match = spaces::Route::Match::kHost;
+    route.pattern = "routed.test";
+    route.space = work_.ToString();
+    spaces::AddRoute(browser()->GetProfile()->GetPrefs(), route);
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("routed.test"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    ASSERT_NO_FATAL_FAILURE(WaitForToast(
+        ToastId::kSteddingRouted,
+        l10n_util::GetStringFUTF16(IDS_STEDDING_ROUTED_TOAST_BODY,
+                                   spaces::NameWithIsolationMark(work_name))));
+  }
+  const std::string says = base::UTF16ToUTF8(Says());
+  const std::string marked_work =
+      base::UTF16ToUTF8(spaces::NameWithIsolationMark(work_name));
+  const std::string row_script =
+      content::JsReplace(kArchiveRow, "Title Of Awesomeness");
+  content::WebContents* archive = nullptr;
+  {
+    SCOPED_TRACE("the archive page");
+    tabs::TabInterface* const routed = tabs()->GetActiveTab();
+    ASSERT_EQ(work_, model()->SpaceForTab(routed));
+    tabs()->CloseWebContentsAt(tabs()->GetIndexOfTab(routed),
+                               TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), GURL("chrome://stedding-archive"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    archive = tabs()->GetActiveWebContents();
+    const std::string read = Read(
+        archive, row_script,
+        base::StrCat({base::UTF16ToUTF8(work_name), "|", says, "\nAll Spaces\n",
+                      base::UTF16ToUTF8(home_name), "\n", marked_work}));
+    EXPECT_EQ(base::StrCat({base::UTF16ToUTF8(work_name), "|", says,
+                            "\nAll Spaces\n", base::UTF16ToUTF8(home_name),
+                            "\n", marked_work}),
+              read)
+        << "the row's Space wears the mark, and the filter's choice says it";
+  }
+
+  model()->SetSpaceIsolated(work_, false);
+  {
+    SCOPED_TRACE("the session turned off");
+    ASSERT_TRUE(model()->SetActiveSpace(home_));
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("home.test"), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    EXPECT_EQ(u"",
+              TabMenuRowMark(TabStripModel::CommandSteddingMoveToSpaceMenu,
+                             work_name));
+    EXPECT_EQ(u"",
+              TabMenuRowMark(TabStripModel::CommandSteddingRouteToSpaceMenu,
+                             work_name));
+    // The page reads the archive again as it loads.
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), GURL("chrome://stedding-archive"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    archive = tabs()->GetActiveWebContents();
+    const std::string unmarked =
+        base::StrCat({base::UTF16ToUTF8(work_name), "|\nAll Spaces\n",
+                      base::UTF16ToUTF8(home_name), "\n",
+                      base::UTF16ToUTF8(work_name)});
+    EXPECT_EQ(unmarked, Read(archive, row_script, unmarked));
+  }
+}
+
+// sessions S33 (docs/history/plan-2026-09-26.md SPC-38, SPC-F73): a tab of
+// Work, signed into Work's own jar, made an essential from the tab menu --
+// which a drag into the essentials and an extension's pin also do -- leaves
+// Work's session. The window says so before the page reloads in the shared
+// jar, and the notice outlives that reload, which replaces the tab's
+// contents; its Undo puts the tab back in Work and in Work's jar. Pinning a
+// shared Space's tab says nothing.
+IN_PROC_BROWSER_TEST_F(IsolationMarkTest,
+                       PinningAWorkTabSaysItLeavesTheSession) {
+  model()->SetSpaceIsolated(work_, true);
+  // The switch to the empty Work opens a new tab there, and the address is
+  // typed into it.
+  ASSERT_TRUE(model()->SetActiveSpace(work_));
+  ASSERT_NO_FATAL_FAILURE(TypeAddress(Url("work.test")));
+  tabs::TabInterface* const tab = tabs()->GetActiveTab();
+  ASSERT_EQ(work_, model()->SpaceForTab(tab));
+  ASSERT_TRUE(InASpacesJar(tab));
+  const std::u16string notice = l10n_util::GetStringFUTF16(
+      IDS_STEDDING_PIN_LEFT_SESSION_TOAST_BODY, model()->DisplayName(work_));
+  {
+    SCOPED_TRACE("Add to Essentials");
+    const int index = tabs()->GetIndexOfTab(tab);
+    ASSERT_TRUE(tabs()->IsContextMenuCommandEnabled(
+        index, TabStripModel::CommandTogglePinned));
+    tabs()->ExecuteContextMenuCommand(index,
+                                      TabStripModel::CommandTogglePinned);
+    ASSERT_TRUE(tab->IsPinned());
+    ASSERT_NO_FATAL_FAILURE(
+        WaitForToast(ToastId::kSteddingPinLeftSession, notice));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !InASpacesJar(tab); }))
+        << "the essential stayed in Work's jar";
+    RunPostedTasks();
+    EXPECT_TRUE(toasts()->IsShowingToast() &&
+                toasts()->GetCurrentToastId() ==
+                    ToastId::kSteddingPinLeftSession)
+        << "the reload in the shared jar closed the notice";
+  }
+  {
+    SCOPED_TRACE("Undo");
+    ASSERT_TRUE(model()->SetActiveSpace(home_));
+    views::MdTextButton* const undo =
+        toasts()->GetToastViewForTesting()->action_button_for_testing();
+    views::test::ButtonTestApi(undo).NotifyClick(ui::MouseEvent(
+        ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+        base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+        ui::EF_LEFT_MOUSE_BUTTON));
+    EXPECT_FALSE(tab->IsPinned());
+    EXPECT_EQ(work_, model()->SpaceForTab(tab));
+    EXPECT_EQ(work_, model()->active_id());
+    EXPECT_EQ(tab, tabs()->GetActiveTab());
+    EXPECT_TRUE(base::test::RunUntil([&]() { return InASpacesJar(tab); }))
+        << "back in Work, not in Work's jar";
+  }
+  {
+    SCOPED_TRACE("a shared Space's tab");
+    ASSERT_TRUE(model()->SetActiveSpace(home_));
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("home.test"), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const shared = tabs()->GetActiveTab();
+    ASSERT_EQ(home_, model()->SpaceForTab(shared));
+    tabs()->ExecuteContextMenuCommand(tabs()->GetIndexOfTab(shared),
+                                      TabStripModel::CommandTogglePinned);
+    ASSERT_TRUE(shared->IsPinned());
+    RunPostedTasks();
+    EXPECT_FALSE(toasts()->IsShowingToast() &&
+                 toasts()->GetCurrentToastId() ==
+                     ToastId::kSteddingPinLeftSession)
+        << "a pin that leaves no session of its own was announced";
+  }
+}
+
+// sessions S32, sidebar Y14: the floating name of a Space with an
+// Independent session is its name and the mark's words, which do not fit a
+// narrow sidebar beside a long name: it is elided inside the sidebar, where
+// it had run past the edge, cut off.
+IN_PROC_BROWSER_TEST_F(IsolationMarkTest,
+                       TheFloatingNameIsElidedInsideTheSidebar) {
+  model()->SetSpaceIsolated(work_, true);
+  // Long enough to overflow the sidebar in any platform's font: Windows'
+  // Segoe UI drew the first name of this test, 38 letters, inside it.
+  model()->SetSpaceName(
+      work_, "Quarterly planning, the long review and every team's budget");
+  views::View* const chip = Chip(work_);
+  views::Label* const pill = region()->space_hover_pill_for_testing();
+  ASSERT_TRUE(chip && pill);
+  PointerOn(chip);
+  ASSERT_TRUE(pill->GetVisible()) << "no floating name";
+  EXPECT_EQ(spaces::NameWithIsolationMark(model()->DisplayName(work_)),
+            pill->GetText());
+  EXPECT_GT(pill->GetPreferredSize().width(), region()->width())
+      << "the name fits: the test asks nothing";
+  EXPECT_TRUE(region()->GetLocalBounds().Contains(pill->bounds()))
+      << pill->bounds().ToString() << " in " << region()->size().ToString();
+  PointerOn(nullptr);
+}
+
+// sessions S32, spaces B38: the badge is the sidebar's own text colour on the
+// sidebar's ground, which Stedding's colour mixer keeps apart by Chromium's
+// contrast for the rows' text whatever the Space's tint. In light and in
+// dark, under every colour a Space can take, the disc stands off its ring and
+// the glyph cut in it by at least 3:1, the least asked of the parts of a
+// graphic that says something (WCAG 1.4.11).
+IN_PROC_BROWSER_TEST_F(IsolationMarkTest,
+                       TheBadgeReadsInLightAndDarkOnEveryTint) {
+  model()->SetSpaceIsolated(work_, true);
+  ThemeService* const theme =
+      ThemeServiceFactory::GetForProfile(browser()->GetProfile());
+  for (const auto& [scheme, mode] :
+       {std::pair(ThemeService::BrowserColorScheme::kLight,
+                  ui::ColorProviderKey::ColorMode::kLight),
+        std::pair(ThemeService::BrowserColorScheme::kDark,
+                  ui::ColorProviderKey::ColorMode::kDark)}) {
+    theme->SetBrowserColorScheme(scheme);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return widget()->GetColorProviderKeyForTesting().color_mode == mode;
+    }));
+    for (const spaces::SpaceColorChoice& choice : spaces::kSpaceColors) {
+      SCOPED_TRACE(base::StrCat(
+          {mode == ui::ColorProviderKey::ColorMode::kDark ? "dark, "
+                                                           : "light, ",
+           base::UTF16ToUTF8(choice.name)}));
+      model()->SetSpaceColor(work_, choice.color);
+      ASSERT_TRUE(model()->SetActiveSpace(work_));
+      ASSERT_TRUE(base::test::RunUntil([&]() {
+        return widget()->GetColorProviderKeyForTesting().user_color ==
+               choice.color;
+      })) << "the window wears no tint of the Space's colour";
+      views::View* const chip = Chip(work_);
+      ASSERT_TRUE(chip);
+      stedding::IsolationMarkView* const badge =
+          stedding::FindShownIsolationMark(chip);
+      ASSERT_TRUE(badge);
+      const ui::ColorProvider* const colors = badge->GetColorProvider();
+      ASSERT_TRUE(colors);
+      EXPECT_GE(color_utils::GetContrastRatio(colors->GetColor(badge->ink()),
+                                              colors->GetColor(badge->ground())),
+                3.0f);
+      ASSERT_TRUE(model()->SetActiveSpace(home_));
+    }
+  }
+}
+
+// sessions S18, S32: a Blank Window has no registry and so no jars, and a
+// private window has no Spaces: neither marks anything, even with the
+// profile's Work marked in its own window, and Settings opened in a Blank
+// Window offers no switch for a session it cannot have.
+IN_PROC_BROWSER_TEST_F(IsolationMarkTest,
+                       ABlankWindowAndAPrivateWindowMarkNothing) {
+  model()->SetSpaceIsolated(work_, true);
+  EXPECT_GT(DrawnMarks(browser()), 0) << "the profile's window marks Work";
+  {
+    SCOPED_TRACE("a Blank Window");
+    // The window opens inside the command, so the waiter comes first.
+    ui_test_utils::BrowserCreatedObserver opened;
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_NEW_BLANK_WINDOW);
+    BrowserWindowInterface* const blank = opened.Wait();
+    ASSERT_TRUE(blank);
+    spaces::SpaceModel* const blank_model = spaces::SpaceModel::From(blank);
+    ASSERT_TRUE(blank_model);
+    ASSERT_FALSE(blank_model->registry());
+    const spaces::SpaceId mine =
+        blank_model->AddSpace("Mine", SK_ColorRED)->id();
+    blank_model->SetSpaceIsolated(mine, true);
+    ASSERT_TRUE(blank_model->SetActiveSpace(mine));
+    ShowTheSidebar(blank);
+    EXPECT_EQ(0, DrawnMarks(blank));
+    ASSERT_TRUE(
+        ui_test_utils::NavigateToURL(blank, GURL("chrome://settings/stedding")));
+    content::WebContents* const page =
+        blank->GetTabStripModel()->GetActiveWebContents();
+    EXPECT_EQ("|no switch|", SettingsRow(page, mine, "|no switch|"));
+    chrome::CloseWindow(blank);
+    ui_test_utils::WaitForBrowserToClose(blank);
+  }
+  {
+    SCOPED_TRACE("a private window");
+    BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+    ASSERT_TRUE(incognito);
+    EXPECT_FALSE(spaces::SpaceModel::From(incognito));
+    ShowTheSidebar(incognito);
+    EXPECT_EQ(0, DrawnMarks(incognito));
+  }
+}
