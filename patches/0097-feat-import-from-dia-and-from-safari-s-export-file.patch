+std::u16string DescribeChromiumFamilyResult(
+    const ChromiumFamilyResult& result) {
+  const std::u16string name(result.name);
+  if (result.already_running) {
+    return u"An import from " + name + u" is running already.";
+  }
+  if (result.not_found) {
+    return name + u"'s profile was not found.";
+  }
+  std::vector<std::u16string> parts;
+  if (result.bookmarks > 0) {
+    parts.push_back(
+        stedding::CountOf(result.bookmarks, u"bookmark", u"bookmarks"));
+  }
+  if (result.history > 0) {
+    parts.push_back(stedding::CountOf(result.history, u"history entry",
+                                      u"history entries"));
+  }
+  if (result.passwords.added > 0) {
+    parts.push_back(
+        stedding::CountOf(result.passwords.added, u"password", u"passwords"));
+  }
+  std::u16string line =
+      parts.empty() ? u"Nothing new came in from " + name + u"."
+                    : u"Brought in from " + name + u": " +
+                          stedding::ListInWords(parts) + u".";
+  const auto add = [&line](const std::u16string& sentence) {
+    line.push_back(u' ');
+    line.append(sentence);
+  };
+  if (result.bookmarks_already > 0) {
+    add(stedding::CountOf(result.bookmarks_already, u"bookmark was",
+                          u"bookmarks were") +
+        u" there already.");
+  }
+  if (result.bookmarks_left_out > 0) {
+    add(stedding::CountOf(result.bookmarks_left_out, u"bookmark", u"bookmarks") +
+        u" that " + (result.bookmarks_left_out == 1 ? u"is" : u"are") +
+        u" not a web page, or past the limit, " +
+        (result.bookmarks_left_out == 1 ? u"was" : u"were") + u" left out.");
+  }
+  if (result.bookmarks_unreadable) {
+    add(name + u"'s bookmarks file could not be read.");
+  }
+  if (result.key_denied) {
+#if BUILDFLAG(IS_MAC)
+    add(u"The keychain did not give Stedding " + name +
+        u"'s key, so no password came over.");
+#else
+    add(name + u"'s key could not be read, so no password came over.");
+#endif
+  }
+  if (result.passwords_bound > 0) {
+    add(stedding::CountOf(result.passwords_bound, u"password", u"passwords") +
+        u" sealed for " + name + u" alone could not be read.");
+  }
+  if (result.passwords_unreadable > 0) {
+    add(stedding::CountOf(result.passwords_unreadable, u"password",
+                          u"passwords") +
+        u" could not be unsealed.");
+  }
+  // The least recently used, past the 10,000 read (BACKLOG S-346).
+  if (result.passwords_past_the_cap > 0) {
+    add(stedding::CountOf(result.passwords_past_the_cap, u"password",
+                          u"passwords") +
+        u" past the limit of 10,000 " +
+        (result.passwords_past_the_cap == 1 ? u"was" : u"were") +
+        u" left out.");
+  }
+  if (result.passwords.kept > 0) {
+    add(stedding::CountOf(result.passwords.kept, u"password", u"passwords") +
+        u" saved with another password " +
+        (result.passwords.kept == 1 ? u"was" : u"were") + u" kept as saved.");
+  }
+  if (result.passwords.already_saved > 0) {
+    add(stedding::CountOf(result.passwords.already_saved, u"password was",
+                          u"passwords were") +
+        u" saved already.");
+  }
+  if (result.passwords.refused > 0) {
+    add(stedding::CountOf(result.passwords.refused, u"login", u"logins") +
+        u" could not be used.");
+  }
+  if (result.passwords.unavailable) {
+    add(u"This profile cannot save passwords.");
+  }
+  if (result.bookmarks_blocked) {
+    add(u"Your administrator has turned off importing bookmarks.");
+  }
+  if (result.history_blocked) {
+    add(u"Your administrator has turned off importing history.");
+  }
+  if (result.passwords_blocked) {
+    add(u"Your administrator has turned off importing passwords.");
+  }
+  return line;
+}
+
+void ImportChromiumFamilyAsync(
+    Profile& profile,
+    const ChromiumFamilySource& source,
+    const ChromiumProfile& source_profile,
+    ChromiumFamilyParts parts,
+    base::OnceCallback<void(ChromiumFamilyResult)> done) {
+  stedding::ImportJobs& jobs = stedding::ImportJobs::For(profile);
+  if (jobs.IsRunning(source.key)) {
+    ChromiumFamilyResult refused;
+    refused.name = source.name;
+    refused.already_running = true;
+    std::move(done).Run(refused);
+    return;
+  }
+  auto job = std::make_unique<ChromiumFamilyImport>(
+      profile, source, source_profile, parts, std::move(done));
+  ChromiumFamilyImport* const running = job.get();
+  jobs.Start(source.key, std::move(job));
+  running->Start(profile);
+}
