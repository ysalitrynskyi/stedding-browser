+void WelcomeHandler::HandleGetDiaImport(const base::ListValue& args) {
+  if (args.size() != 1U) {
+    return;
+  }
+  const std::string* const callback_id = args[0].GetIfString();
+  if (!callback_id) {
+    return;
+  }
+  AllowJavascript();
+  spaces::LoadChromiumFamilyInfo(
+      spaces::kDiaSource,
+      base::BindOnce(&WelcomeHandler::OnDiaInfo, weak_factory_.GetWeakPtr(),
+                     *callback_id));
+}
+
+void WelcomeHandler::OnDiaInfo(const std::string& callback_id,
+                               spaces::ChromiumFamilyInfo info) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  dia_profiles_.clear();
+  base::ListValue profiles;
+  for (const spaces::ChromiumProfileSummary& summary : info.profiles) {
+    base::DictValue entry;
+    entry.Set("name", summary.profile.name);
+    entry.Set("summary", spaces::SummariseChromiumProfile(summary));
+    entry.Set("lastUsed", summary.profile.last_used);
+    profiles.Append(std::move(entry));
+    dia_profiles_.push_back(summary.profile);
+  }
+  base::DictValue reply;
+  reply.Set("found", info.found && !dia_profiles_.empty());
+  reply.Set("running", info.running);
+  reply.Set("profiles", std::move(profiles));
+  ResolveJavascriptCallback(base::Value(callback_id), reply);
+}
+
+void WelcomeHandler::HandleImportFromDia(const base::ListValue& args) {
+  if (args.size() != 5U) {
+    return;
+  }
+  const std::string* const callback_id = args[0].GetIfString();
+  if (!callback_id) {
+    return;
+  }
+  AllowJavascript();
+  const std::optional<int> index = args[1].GetIfInt();
+  if (!index || *index < 0 ||
+      static_cast<size_t>(*index) >= dia_profiles_.size()) {
+    ResolveJavascriptCallback(base::Value(*callback_id),
+                              base::Value(u"Dia's profile was not found."));
+    return;
+  }
+  spaces::ChromiumFamilyParts parts;
+  parts.bookmarks = args[2].GetIfBool().value_or(true);
+  parts.history = args[3].GetIfBool().value_or(true);
+  parts.passwords = args[4].GetIfBool().value_or(true);
+  spaces::ImportChromiumFamilyAsync(
+      *Profile::FromWebUI(web_ui()), spaces::kDiaSource,
+      dia_profiles_[static_cast<size_t>(*index)], parts,
+      base::BindOnce(&WelcomeHandler::OnDiaImportDone,
+                     weak_factory_.GetWeakPtr(), *callback_id));
+}
+
+void WelcomeHandler::OnDiaImportDone(const std::string& callback_id,
+                                     spaces::ChromiumFamilyResult result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  ResolveJavascriptCallback(
+      base::Value(callback_id),
+      base::Value(spaces::DescribeChromiumFamilyResult(result)));
+}
+
+void WelcomeHandler::HandleChooseSafariExport(const base::ListValue& args) {
+  if (args.size() != 2U) {
+    return;
+  }
+  const std::string* const callback_id = args[0].GetIfString();
+  const std::string* const kind = args[1].GetIfString();
+  if (!callback_id || !kind) {
+    return;
+  }
+  AllowJavascript();
+  if (select_file_dialog_ || choose_callback_id_) {
+    // One dialog at a time: the open one answers its own promise.
+    base::DictValue busy;
+    busy.Set("chosen", false);
+    ResolveJavascriptCallback(base::Value(*callback_id), busy);
+    return;
+  }
+  choose_callback_id_ = *callback_id;
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this,
+      std::make_unique<ChromeSelectFilePolicy>(web_ui()->GetWebContents()));
+  // The page lives in the welcome dialog: the file dialog takes its window,
+  // as the bookmarks file's does (BACKLOG S-186).
+  const gfx::NativeWindow parent =
+      web_ui()->GetWebContents()->GetTopLevelNativeWindow();
+  if (*kind == "folder") {
+    select_file_dialog_->SelectFile(
+        ui::SelectFileDialog::SELECT_EXISTING_FOLDER, std::u16string(),
+        base::FilePath(), nullptr, 0, base::FilePath::StringType(), parent);
+    return;
+  }
+  ui::SelectFileDialog::FileTypeInfo types;
+  types.extensions.push_back({FILE_PATH_LITERAL("zip")});
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_FILE, std::u16string(),
+      base::FilePath(), &types, 1, FILE_PATH_LITERAL("zip"), parent);
+}
+
+void WelcomeHandler::FileSelected(const ui::SelectedFileInfo& file,
+                                  int index) {
+  select_file_dialog_ = nullptr;
+  if (!choose_callback_id_) {
+    return;
+  }
+  const std::string callback_id = *choose_callback_id_;
+  choose_callback_id_.reset();
+  // import I36: a fresh read of the chosen export; the one before is let go.
+  safari_export_ = std::make_unique<SafariExportImporter>();
+  safari_export_->Prepare(
+      file.path(),
+      base::BindOnce(&WelcomeHandler::OnSafariExportPrepared,
+                     weak_factory_.GetWeakPtr(), callback_id));
+}
+
+void WelcomeHandler::FileSelectionCanceled() {
+  select_file_dialog_ = nullptr;
+  if (!choose_callback_id_) {
+    return;
+  }
+  const std::string callback_id = *choose_callback_id_;
+  choose_callback_id_.reset();
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::DictValue reply;
+  reply.Set("chosen", false);
+  ResolveJavascriptCallback(base::Value(callback_id), reply);
+}
+
+void WelcomeHandler::OnSafariExportPrepared(
+    const std::string& callback_id,
+    const SafariExportSummary& summary) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::DictValue reply;
+  reply.Set("chosen", true);
+  reply.Set("ready", safari_export_ && safari_export_->prepared());
+  reply.Set("summary", SummariseSafariExport(summary));
+  reply.Set("bookmarks", static_cast<int>(summary.bookmarks));
+  reply.Set("history", summary.history);
+  reply.Set("passwords", static_cast<int>(summary.passwords));
+  reply.Set("cards", summary.cards);
+  ResolveJavascriptCallback(base::Value(callback_id), reply);
+}
+
+void WelcomeHandler::HandleImportSafariExport(const base::ListValue& args) {
+  if (args.size() != 4U) {
+    return;
+  }
+  const std::string* const callback_id = args[0].GetIfString();
+  if (!callback_id) {
+    return;
+  }
+  AllowJavascript();
+  SafariExportParts parts;
+  parts.bookmarks = args[1].GetIfBool().value_or(true);
+  parts.history = args[2].GetIfBool().value_or(true);
+  // import I36, I39: passwords only when the box was ticked.
+  parts.passwords = args[3].GetIfBool().value_or(false);
+  SafariExportImporter::Commit(
+      std::move(safari_export_), *Profile::FromWebUI(web_ui()), parts,
+      base::BindOnce(&WelcomeHandler::OnSafariImportDone,
+                     weak_factory_.GetWeakPtr(), *callback_id));
+}
+
+void WelcomeHandler::OnSafariImportDone(const std::string& callback_id,
+                                        const SafariExportResult& result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  ResolveJavascriptCallback(base::Value(callback_id),
+                            base::Value(DescribeSafariExportResult(result)));
+}
+
+void WelcomeHandler::HandleCancelSafariExport(const base::ListValue& args) {
+  AllowJavascript();
+  safari_export_.reset();
+}
