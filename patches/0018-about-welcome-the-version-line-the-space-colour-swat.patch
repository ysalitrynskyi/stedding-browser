@@ -0,0 +1,30 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/stedding_version.h"
+
+#include "base/strings/utf_string_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+// settings T10: the About line names both versions and never says
+// "(Developer Build)".
+TEST(SteddingVersionTest, AboutStringNamesBothVersions) {
+  EXPECT_EQ(u"Stedding 0.2.0-beta.4 · Chromium 150.0.1234.5 (arm64)",
+            FormatAboutVersion("0.2.0-beta.4", "150.0.1234.5", u"(arm64)"));
+  EXPECT_EQ(u"Chromium 150.0.1234.5 (arm64)",
+            FormatAboutVersion("", "150.0.1234.5", u"(arm64)"));
+  EXPECT_EQ(u"Stedding 1.0 · Chromium 150.0.1234.5",
+            FormatAboutVersion("1.0", "150.0.1234.5", u""));
+  const std::u16string line = AboutVersionString(u"(arm64)");
+  EXPECT_EQ(std::u16string::npos, line.find(u"Developer Build"))
+      << base::UTF16ToUTF8(line);
+  EXPECT_NE(std::u16string::npos, line.find(u"Chromium "))
+      << base::UTF16ToUTF8(line);
+}
+
+}  // namespace
+}  // namespace stedding
