+// A made-up Arc: two Spaces and a tab.
+constexpr char kSidebar[] = R"json({
+  "sidebar": {"containers": [
+    {"global": {}},
+    {
+      "spaces": [
+        "space-work", {
+          "id": "space-work", "title": "Work",
+          "containerIDs": ["pinned", "work-pinned", "unpinned", "work-unpinned"]
+        },
+        "space-play", {
+          "id": "space-play", "title": "Play",
+          "containerIDs": ["pinned", "play-pinned", "unpinned", "play-unpinned"]
+        }
+      ],
+      "items": [
+        "work-pinned", {"id": "work-pinned", "parentID": null,
+          "childrenIds": [], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "work-unpinned", {"id": "work-unpinned", "parentID": null,
+          "childrenIds": ["tab-mail"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "play-pinned", {"id": "play-pinned", "parentID": null,
+          "childrenIds": [], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "play-unpinned", {"id": "play-unpinned", "parentID": null,
+          "childrenIds": [], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "tab-mail", {"id": "tab-mail", "parentID": "work-unpinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "https://mail.example/", "savedTitle": "Mail"}}}
+      ],
+      "topAppsContainerIDs": []
+    }
+  ]}
+})json";
+
+// `body`, run on a settings page with `pick(selector)`, through every shadow
+// root.
+std::string OnThePage(std::string_view body) {
+  return base::StrCat({R"(
+    (() => {
+      const find = (root, selector) => {
+        const hit = root.querySelector(selector);
+        if (hit) {
+          return hit;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot, selector);
+            if (found) {
+              return found;
+            }
+          }
+        }
+        return null;
+      };
+      const pick = selector => find(document, selector);
+  )",
+                       body, "\n    })()"});
+}
+
+class FromArcPageTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(home_.CreateUniqueTempDir());
+#if BUILDFLAG(IS_WIN)
+    home_override_.emplace(base::DIR_LOCAL_APP_DATA, home_.GetPath());
+    arc_ = home_.GetPath()
+               .Append(FILE_PATH_LITERAL("Packages"))
+               .Append(FILE_PATH_LITERAL("TheBrowserCompany.Arc_ttt1ap7aakyb4"))
+               .Append(FILE_PATH_LITERAL("LocalCache"))
+               .Append(FILE_PATH_LITERAL("Local"))
+               .Append(FILE_PATH_LITERAL("Arc"));
+#else
+    home_override_.emplace(base::DIR_HOME, home_.GetPath());
+    arc_ = home_.GetPath()
+               .Append(FILE_PATH_LITERAL("Library"))
+               .Append(FILE_PATH_LITERAL("Application Support"))
+               .Append(FILE_PATH_LITERAL("Arc"));
+#endif
+    ASSERT_TRUE(base::CreateDirectory(arc_));
+  }
+
+  void TearDownOnMainThread() override {
+    home_override_.reset();
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      EXPECT_TRUE(home_.Delete());
+    }
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  void WriteSidebar() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::WriteFile(
+        arc_.Append(FILE_PATH_LITERAL("StorableSidebar.json")), kSidebar));
+  }
+
+  // The import the settings row and the bar's row run.
+  std::optional<spaces::ArcImportResult> Import() {
+    base::test::TestFuture<std::optional<spaces::ArcImportResult>> done;
+    spaces::ArcImportOptions options;
+    options.history = false;
+    options.passwords = false;
+    spaces::ImportFromArcAsync(browser(), options, done.GetCallback());
+    return done.Get();
+  }
+
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+
+  // How many of the window's tabs show the page.
+  int PagesOpen() {
+    int pages = 0;
+    for (int i = 0; i < tabs().count(); ++i) {
+      if (tabs().GetWebContentsAt(i)->GetVisibleURL() == GURL(kPage)) {
+        ++pages;
+      }
+    }
+    return pages;
+  }
+
+  content::WebContents* WaitForThePage() {
+    EXPECT_TRUE(base::test::RunUntil([&]() { return PagesOpen() == 1; }));
+    content::WebContents* const page = tabs().GetActiveWebContents();
+    EXPECT_EQ(GURL(kPage), page->GetVisibleURL());
+    EXPECT_TRUE(content::WaitForLoadStop(page));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(page, "!!document.querySelector('.places')")
+          .ExtractBool();
+    })) << "the page drew nothing";
+    return page;
+  }
+
+  base::FilePath arc_;
+  base::ScopedTempDir home_;
+  std::optional<base::ScopedPathOverride> home_override_;
+};
