+
+#ifndef CHROME_BROWSER_UI_STEDDING_SIDEBAR_PANELS_VIEW_H_
+#define CHROME_BROWSER_UI_STEDDING_SIDEBAR_PANELS_VIEW_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/stedding/sidebar_panels.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+
+namespace views {
+class WebView;
+}  // namespace views
+
+namespace stedding {
+
+// docs/features/sidebar-panels.md: one panel in the sidebar's column,
+// chrome://stedding-library/history or /downloads in a web view, between the
+// sidebar's top row and its foot. The sidebar (VerticalTabStripRegionView)
+// makes one when the window's SidebarPanels opens a panel and drops it when
+// that panel closes.
+//
+// The web view is its own WebContents' delegate, and it is a panel of the
+// window's, so it answers what a bare web view would drop or let through:
+// a chord the page does not take reaches the window's accelerators (⌘Y,
+// ⌘S, ⌘T, ⌘W, F6 with the focus in the panel), Escape closes the panel, and
+// the page never leaves chrome://stedding-library -- no link, drop or
+// script navigates it away (Pn5, Pn7).
+class SidebarPanelView : public views::View {
+  METADATA_HEADER(SidebarPanelView, views::View)
+
+ public:
+  // `close` closes the panel; the view runs it for Escape.
+  SidebarPanelView(BrowserWindowInterface& browser,
+                   SidebarPanel panel,
+                   base::RepeatingClosure close);
+  SidebarPanelView(const SidebarPanelView&) = delete;
+  SidebarPanelView& operator=(const SidebarPanelView&) = delete;
+  ~SidebarPanelView() override;
+
+  // The page a panel shows.
+  static GURL UrlFor(SidebarPanel panel);
+  // What a screen reader calls the pane (Pn16).
+  static std::u16string NameFor(SidebarPanel panel);
+
+  SidebarPanel panel() const { return panel_; }
+  views::WebView* web_view() { return web_view_; }
+
+  // views::View:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+
+ private:
+  class PanelWebView;
+
+  const SidebarPanel panel_;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SIDEBAR_PANELS_VIEW_H_
