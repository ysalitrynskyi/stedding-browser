+std::optional<CameraRowFullscreenMac::Housing>& HousingForTesting() {
+  static std::optional<CameraRowFullscreenMac::Housing> housing;
+  return housing;
+}
+
+AddressRow* RowOf(BrowserView* browser_view) {
+  return browser_view && browser_view->browser()
