@@ -36,5 +36,23 @@ TEST(SwitcherRulesTest, OverflowShrinksInactiveChips) {
   EXPECT_EQ(kSwitcherChip, SwitcherChipWidth(true, false, true));
 }
 
+// sidebar Y13: the rail's stack goes by the count, and measures itself.
+TEST(SwitcherRulesTest, StackOverflowsByCountAndMeasuresItself) {
+  EXPECT_FALSE(SwitcherStackOverflows(1));
+  EXPECT_FALSE(SwitcherStackOverflows(kSwitcherStackFullChips));
+  EXPECT_TRUE(SwitcherStackOverflows(kSwitcherStackFullChips + 1));
+  // Three full chips and the plus: four rows of chip and gap, and the pad.
+  EXPECT_EQ(4 * (kSwitcherChip + kSwitcherChipGap) + kSwitcherStackPad,
+            SwitcherStackHeight({kSwitcherChip, kSwitcherChip, kSwitcherChip}));
+  // The active chip full, six dots and the plus.
+  EXPECT_EQ(2 * (kSwitcherChip + kSwitcherChipGap) +
+                6 * (kSwitcherDot + kSwitcherChipGap) + kSwitcherStackPad,
+            SwitcherStackHeight({kSwitcherChip, kSwitcherDot, kSwitcherDot,
+                                 kSwitcherDot, kSwitcherDot, kSwitcherDot,
+                                 kSwitcherDot}));
+  EXPECT_EQ(kSwitcherChip + kSwitcherChipGap + kSwitcherStackPad,
+            SwitcherStackHeight({}));
+}
