+SiteControlsWindow SiteControlsWindowFor(content::WebContents* contents) {
+  if (!contents || !base::FeatureList::IsEnabled(kArcStyleWindow)) {
+    return SiteControlsWindow::kOther;
+  }
+  BrowserWindowInterface* const browser = BrowserFor(contents);
+  // A popup, an app window and the picture-in-picture window are windows of
+  // other types; a little window and a peek are normal windows marked as
+  // theirs; a side panel's page is not a tab at all.
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      IsLittleWindow(browser) || IsPeekWindow(browser)) {
+    return SiteControlsWindow::kOther;
+  }
+  if (contents->GetBrowserContext()->IsOffTheRecord()) {
+    return SiteControlsWindow::kPrivateTab;
+  }
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  return model && model->follows_registry()
+             ? SiteControlsWindow::kTab
+             : SiteControlsWindow::kTabWithoutSpaces;
+}
+
+base::RepeatingClosure SiteControlsExtensionsCallback(
+    content::WebContents* contents) {
+  BrowserWindowInterface* const browser = BrowserFor(contents);
+  if (SiteControlsWindowFor(contents) == SiteControlsWindow::kOther ||
+      !ExtensionsMenuAvailable(browser)) {
+    return base::RepeatingClosure();
+  }
+  // Page info closes after running it (PageInfoMainView's Extensions row);
+  // the window may close first.
+  return base::BindRepeating(
+      [](base::WeakPtr<BrowserWindowInterface> browser) {
+        if (browser) {
+          ShowExtensionsMenu(browser.get());
+        }
+      },
+      browser->GetWeakPtr());
+}
