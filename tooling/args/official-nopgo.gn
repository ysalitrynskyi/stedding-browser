# Stedding — diagnostic configuration: official, with PGO disabled.
#
# NOT a shipping configuration. This exists to bisect a defect found at M0: the
# `official` build launches, creates a tab with the right URL, and then never loads
# any network page — `https://example.com` yields an empty title while the same URL
# loads normally in the `release` build. chrome:// pages work in both, so the browser
# UI is fine and only network navigation is dead.
#
# official.gn differs from release.gn by turning on is_official_build, which enables
# PGO, ThinLTO and the rest of the shipping optimisation pipeline at once. This config
# removes PGO alone, so a passing result implicates the profile and a failing one
# implicates LTO or something else under is_official_build.
#
# Delete this file once the cause is known and recorded.

target_os  = "mac"
target_cpu = "arm64"

is_official_build  = true
is_component_build = false

# The one variable under test.
chrome_pgo_phase = 0

symbol_level       = 0
blink_symbol_level = 0
v8_symbol_level    = 0

use_remoteexec = false
