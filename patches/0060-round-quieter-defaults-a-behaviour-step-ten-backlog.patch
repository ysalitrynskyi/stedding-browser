diff --git a/chrome/browser/ui/stedding/media_keys.cc b/chrome/browser/ui/stedding/media_keys.cc
new file mode 100644
index 0000000000000..b4ddcc96e72ca
--- /dev/null
+++ b/chrome/browser/ui/stedding/media_keys.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/media_keys.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_muted_utils.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/split_tab_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/media_session.h"
+#include "content/public/browser/web_contents.h"
+#include "services/media_session/public/mojom/media_session.mojom.h"
+
+namespace stedding {
+
+namespace {
+
+TabStripModel* StripOf(BrowserWindowInterface* browser) {
+  return browser ? browser->GetTabStripModel() : nullptr;
+}
+
+// The active row's pages, the focused pane first: the active tab, then the
+// other pane of its split.
+std::vector<content::WebContents*> ActiveRow(TabStripModel& strip) {
+  std::vector<content::WebContents*> pages;
+  tabs::TabInterface* const active = strip.GetActiveTab();
+  if (!active) {
+    return pages;
+  }
+  if (content::WebContents* const contents = active->GetContents()) {
+    pages.push_back(contents);
+  }
+  if (active->IsSplit()) {
+    for (tabs::TabInterface* const pane :
+         strip.GetSplitData(*active->GetSplit())->ListTabs()) {
+      if (pane != active && pane->GetContents()) {
+        pages.push_back(pane->GetContents());
+      }
+    }
+  }
+  return pages;
+}
+
+// A video of the page, or a document it opened, is in picture in picture.
+bool ShowsPictureInPicture(content::WebContents* contents) {
+  return contents && (contents->HasPictureInPictureVideo() ||
+                      contents->HasPictureInPictureDocument());
+}
+
+// The page's media session offers picture in picture: the signal Chromium's
+// media controls draw their button from. GetIfExists, so asking creates no
+// session for a page that never played anything.
+bool CanEnterPictureInPicture(content::WebContents* contents) {
+  content::MediaSession* const session =
+      contents ? content::MediaSession::GetIfExists(contents) : nullptr;
+  if (!session) {
+    return false;
+  }
+  const std::vector<media_session::mojom::MediaSessionAction> actions =
+      session->GetMediaSessionActionsSync();
+  return std::ranges::contains(
+      actions,
+      media_session::mojom::MediaSessionAction::kEnterPictureInPicture);
+}
+
+// What the key would do, and the page it would do it through.
+struct Target {
+  PictureInPictureKey key = PictureInPictureKey::kNothing;
+  raw_ptr<content::WebContents> contents = nullptr;
+};
+
+// player Mp5's order: close it on the active row, else enter it there, else
+// close one a tab of this window opened.
+Target FindTarget(BrowserWindowInterface* browser) {
+  TabStripModel* const strip = StripOf(browser);
+  if (!strip) {
+    return Target();
+  }
+  const std::vector<content::WebContents*> row = ActiveRow(*strip);
+  for (content::WebContents* const page : row) {
+    if (ShowsPictureInPicture(page)) {
+      return Target{PictureInPictureKey::kExit, page};
+    }
+  }
+  for (content::WebContents* const page : row) {
+    if (CanEnterPictureInPicture(page)) {
+      return Target{PictureInPictureKey::kEnter, page};
+    }
+  }
+  for (int i = 0; i < strip->count(); ++i) {
+    content::WebContents* const page = strip->GetTabAtIndex(i)->GetContents();
+    if (ShowsPictureInPicture(page)) {
+      return Target{PictureInPictureKey::kExit, page};
+    }
+  }
+  return Target();
+}
+
+}  // namespace
+
+std::vector<tabs::TabInterface*> TabsToMute(BrowserWindowInterface* browser) {
+  TabStripModel* const strip = StripOf(browser);
+  if (!strip) {
+    return {};
+  }
+  const int active = strip->active_index();
+  if (active == TabStripModel::kNoTab) {
+    return {};
+  }
+  // The context menu's own answer (tabs R21): the selection when the active
+  // tab is in it, which always holds both panes of a split, without the rows
+  // the sidebar hides.
+  return strip->GetTabsForContextMenuCommand(active);
+}
+
+bool MuteKeyWouldMute(BrowserWindowInterface* browser) {
+  const std::vector<tabs::TabInterface*> taken = TabsToMute(browser);
+  return std::ranges::any_of(taken, [](tabs::TabInterface* tab) {
+    content::WebContents* const contents = tab->GetContents();
+    return contents && !contents->IsAudioMuted();
+  });
+}
+
+void ToggleMuteOnSelectedTabs(BrowserWindowInterface* browser) {
+  // One direction for every tab: a split with one pane muted mutes the other
+  // pane rather than swapping the two.
+  const bool mute = MuteKeyWouldMute(browser);
+  for (tabs::TabInterface* const tab : TabsToMute(browser)) {
+    if (content::WebContents* const contents = tab->GetContents()) {
+      SetTabAudioMuted(contents, mute, TabMutedReason::kAudioIndicator,
+                       std::string());
+    }
+  }
+}
+
+PictureInPictureKey PictureInPictureKeyFor(BrowserWindowInterface* browser) {
+  return FindTarget(browser).key;
+}
+
+void TogglePictureInPicture(BrowserWindowInterface* browser) {
+  // The single place the card player (player Mp1) takes over once it exists:
+  // then the key opens the video there instead of in Chromium's overlay.
+  const Target target = FindTarget(browser);
+  switch (target.key) {
+    case PictureInPictureKey::kEnter:
+      content::MediaSession::Get(target.contents.get())
+          ->EnterPictureInPicture();
+      break;
+    case PictureInPictureKey::kExit:
+      // Through the page's delegate to Chromium's window manager, which
+      // closes the window without pausing the video.
+      content::MediaSession::Get(target.contents.get())
+          ->ExitPictureInPicture();
+      break;
+    case PictureInPictureKey::kNothing:
+      break;
+  }
+}
+
+}  // namespace stedding
