+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/stedding_welcome/stedding_welcome_ui.h"
+
+#include <memory>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/settings/import_data_handler.h"
+#include "chrome/browser/ui/webui/stedding_welcome/stedding_welcome_handler.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/stedding_welcome_resources.h"
+#include "chrome/grit/stedding_welcome_resources_map.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "content/public/common/url_constants.h"
+#include "services/network/public/mojom/content_security_policy.mojom.h"
+#include "ui/webui/webui_util.h"
+
+namespace stedding {
+
+WelcomeUI::WelcomeUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  Profile* const profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* const source = content::WebUIDataSource::CreateAndAdd(
+      profile, kWelcomeHost);
+  webui::SetupWebUIDataSource(source, kSteddingWelcomeResources,
+                              IDR_STEDDING_WELCOME_STEDDING_WELCOME_HTML);
+  // The search-engine icons come from chrome://theme.
+  source->OverrideContentSecurityPolicy(
+      network::mojom::CSPDirectiveName::ImgSrc,
+      "img-src chrome://theme chrome://resources 'self' data:;");
+  web_ui->AddMessageHandler(std::make_unique<WelcomeHandler>());
+  // Chromium's own importer UI logic: "initializeImportDialog", "importData".
+  web_ui->AddMessageHandler(std::make_unique<settings::ImportDataHandler>());
+}
+
+WelcomeUI::~WelcomeUI() = default;
+
+WelcomeUIConfig::WelcomeUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kWelcomeHost) {}
+
+}  // namespace stedding
