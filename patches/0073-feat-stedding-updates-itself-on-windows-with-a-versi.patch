+namespace {
+
+using State = AppUpdater::State;
+
+// updates Up14: as the Mac's, ten seconds after launch when a day has passed
+// since the last check, then once a day.
+constexpr base::TimeDelta kStartDelay = base::Seconds(10);
+constexpr base::TimeDelta kCheckInterval = base::Days(1);
+// A quit the browser cancelled ("Leave site?", downloads) brings the pill
+// back (updates Up3).
+constexpr base::TimeDelta kQuitGrace = base::Seconds(20);
+// The feed is a few kilobytes; the installer about 170 MB.
+constexpr size_t kMaxFeedSize = 1024 * 1024;
+// A request that stalls ends, so the next check can run: the feed in a
+// minute, the installer within two hours (170 MB at under 0.2 Mbit/s).
+constexpr base::TimeDelta kFeedTimeout = base::Minutes(1);
+constexpr base::TimeDelta kDownloadTimeout = base::Hours(2);
+// A check that could not reach the feed tries again within the hour rather
+// than a day later: a copy offline at launch is not left a day behind.
+constexpr base::TimeDelta kRetryDelay = base::Hours(1);
+// What the downloads' folders are called (base::CreateNewTempDirectory adds
+// to it), and how old one must be before a launch clears it away.
+constexpr base::FilePath::CharType kDownloadDirPrefix[] =
+    FILE_PATH_LITERAL("stedding_update");
+constexpr base::TimeDelta kStaleDownloadAge = base::Days(1);
+// A failed install's log, kept in the temporary folder for a report (the
+// folder it was written to goes with the installer).
+constexpr base::FilePath::CharType kFailedInstallLog[] =
+    FILE_PATH_LITERAL("stedding_update_failed_install.log");
+
+// The update test's own feed (docs/HANDOFF.md, "The updater"): the feed and
+// the installer are still checked against the key the build carries.
+constexpr char kUpdateFeedSwitch[] = "stedding-update-feed";
+
+// What the installer leaves beside a running chrome.exe for the restart to
+// swap in (installer::kChromeNewExe).
+constexpr wchar_t kNewChromeExe[] = L"new_chrome.exe";
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("stedding_windows_update", R"(
+        semantics {
+          sender: "Stedding updater"
+          description:
+            "Once a day, and when the user asks, Stedding on Windows reads "
+            "its signed update feed from the project's GitHub repository and, "
+            "when a later version is listed, downloads its installer from the "
+            "project's GitHub releases."
+          trigger:
+            "Ten seconds after launch when a day has passed since the last "
+            "check, once a day after that, or the user's Check for Updates."
+          data: "None: the request carries no cookies and no machine data."
+          destination: OTHER
+          destination_other:
+            "raw.githubusercontent.com, github.com, and the host GitHub "
+            "redirects a release download to "
+            "(release-assets.githubusercontent.com)."
+          # Contact: the repository's Security tab (SECURITY.md).
+          user_data { type: NONE }
+          last_reviewed: "2026-10-19"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Settings > Stedding > Updates > Update Stedding automatically."
+          policy_exception_justification:
+            "Not implemented: the setting turns it off."
+        })");
+
+std::unique_ptr<network::SimpleURLLoader> MakeLoader(
+    const GURL& url,
+    base::TimeDelta timeout) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  loader->SetTimeoutDuration(timeout);
+  return loader;
+}
+
+// Off the UI thread: a new folder for the download, or an empty path.
+base::FilePath NewDownloadDir() {
+  base::FilePath dir;
+  if (!base::CreateNewTempDirectory(kDownloadDirPrefix, &dir)) {
+    return base::FilePath();
+  }
+  return dir;
+}
+
+// Off the UI thread, at launch: download folders a day old or older, left by
+// a quit during a download or by an earlier build. A younger one may belong to
+// another copy's download under way.
+void ClearStaleDownloads() {
+  base::FilePath temp;
+  if (!base::GetTempDir(&temp)) {
+    return;
+  }
+  base::FileEnumerator folders(temp, /*recursive=*/false,
+                               base::FileEnumerator::DIRECTORIES,
+                               base::StrCat({kDownloadDirPrefix,
+                                             FILE_PATH_LITERAL("*")}));
+  for (base::FilePath folder = folders.Next(); !folder.empty();
+       folder = folders.Next()) {
+    if (base::Time::Now() - folders.GetInfo().GetLastModifiedTime() >=
+        kStaleDownloadAge) {
+      base::DeletePathRecursively(folder);
+    }
+  }
+}
+
+base::FilePath ExeDir() {
+  base::FilePath exe;
+  base::PathService::Get(base::FILE_EXE, &exe);
+  return exe.DirName();
+}
+
+// The version the installer recorded (the Clients key's "pv"): after an
+// update while the browser ran, the one waiting for the restart.
+base::Version InstalledVersion() {
+  base::win::RegKey key(HKEY_CURRENT_USER,
+                        install_static::GetClientsKeyPath().c_str(),
+                        KEY_QUERY_VALUE | KEY_WOW64_32KEY);
+  std::wstring version;
+  if (key.ReadValue(L"pv", &version) != ERROR_SUCCESS) {
+    return base::Version();
+  }
+  return base::Version(base::WideToUTF8(version));
+}
+
+// What became of a downloaded installer (updates Up16, Up17).
+struct InstallResult {
+  bool verified = false;
+  // The installer's exit code, or -1; set only when it verified.
+  int exit_code = -1;
+};
+
+// Off the UI thread: the download's length and signature, then the
+// installer, on one handle that denies writing to the file and deleting or
+// renaming it until the installer has run: what runs is what was checked.
+InstallResult VerifyAndInstall(
+    const base::FilePath& path,
+    int64_t length,
+    const std::string& signature,
+    const std::string& public_key,
+    const base::RepeatingCallback<int(const base::FilePath&)>& run_installer) {
+  InstallResult result;
+  base::File file(path, base::File::FLAG_OPEN | base::File::FLAG_READ |
+                            base::File::FLAG_WIN_EXCLUSIVE_WRITE);
+  if (!file.IsValid() || file.GetLength() != length) {
+    return result;
+  }
+  std::vector<uint8_t> bytes(static_cast<size_t>(length));
+  if (!file.ReadAndCheck(0, bytes) ||
+      !SignatureVerifies(bytes, signature, public_key)) {
+    return result;
+  }
+  result.verified = true;
+  result.exit_code = run_installer.Run(path);
+  return result;
+}
+
+// The downloaded installer, through RunUpdateInstaller.
+int RunInstaller(const base::FilePath& installer) {
+  return RunUpdateInstaller(base::CommandLine(installer));
+}
+
+class WinAppUpdater : public AppUpdater {
+ public:
+  WinAppUpdater(PrefService* local_state,
+                base::RepeatingClosure restart,
+                scoped_refptr<network::SharedURLLoaderFactory> loader_factory,
+                WinUpdaterEnvironment environment)
+      : local_state_(local_state),
+        restart_(std::move(restart)),
+        loader_factory_(std::move(loader_factory)),
+        env_(std::move(environment)) {
+    registrar_.Init(local_state_);
+    registrar_.Add(prefs::kUpdatesAutomatic,
+                   base::BindRepeating(&WinAppUpdater::OnAutomaticChanged,
+                                       base::Unretained(this)));
+    SetInstance(this);
+    base::ThreadPool::PostTask(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(&ClearStaleDownloads));
+    // An update this run or an earlier one installed and no restart has
+    // taken yet: the pill shows at once (updates Up17).
+    if (base::PathExists(env_.exe_dir.Append(kNewChromeExe))) {
+      SetVersion(base::UTF8ToUTF16(
+          SteddingVersionOfWindowsVersion(env_.installed_version.Run())));
+      SetState(State::kReady);
+      return;
+    }
+    ScheduleCheck();
+  }
+
+  ~WinAppUpdater() override = default;
+
+  // AppUpdater:
+  void CheckNow() override {
+    switch (state()) {
+      case State::kChecking:
+      case State::kDownloading:
+      case State::kAvailable:
+      case State::kReady:
+      case State::kInstalling:
+        return;
+      case State::kIdle:
+      case State::kUpToDate:
+      case State::kFailed:
+        break;
+    }
+    user_asked_ = true;
+    SetState(State::kChecking);
+    if (!busy_) {
+      // The timer's check would start a second one over this.
+      timer_.Stop();
+      Check();
+    }
+  }
+
+  void InstallNow() override {
+    if (state() != State::kReady) {
+      return;
+    }
+    SetState(State::kInstalling);
+    quit_grace_.Start(FROM_HERE, kQuitGrace,
+                      base::BindOnce(&WinAppUpdater::OnQuitTookTooLong,
+                                     weak_factory_.GetWeakPtr()));
+    restart_.Run();
+  }
+
+ private:
+  bool Automatic() const {
+    return local_state_->GetBoolean(prefs::kUpdatesAutomatic);
+  }
+
+  // updates Up14, Up20: the next check, a day after the last one and never
+  // sooner than ten seconds after launch; with automatic updates off, none.
+  void ScheduleCheck() {
+    timer_.Stop();
+    if (!Automatic()) {
+      return;
+    }
+    const base::Time last = local_state_->GetTime(prefs::kUpdatesLastCheck);
+    base::TimeDelta delay = kStartDelay;
+    if (!last.is_null()) {
+      delay = std::max(delay, last + kCheckInterval - base::Time::Now());
+    }
+    timer_.Start(FROM_HERE, delay,
+                 base::BindOnce(&WinAppUpdater::Check, base::Unretained(this)));
+  }
+
+  void OnAutomaticChanged() {
+    if (busy_ || state() == State::kReady || state() == State::kInstalling) {
+      return;
+    }
+    ScheduleCheck();
+  }
+
+  void Check() {
+    // One check at a time: a second would replace the loader and restart a
+    // download that is under way.
+    if (busy_) {
+      return;
+    }
+    busy_ = true;
+    loader_ = MakeLoader(env_.feed_url, kFeedTimeout);
+    loader_->DownloadToString(
+        loader_factory_.get(),
+        base::BindOnce(&WinAppUpdater::OnFeed, weak_factory_.GetWeakPtr()),
+        kMaxFeedSize);
+  }
+
+  void OnFeed(std::optional<std::string> body) {
+    loader_.reset();
+    if (!body) {
+      // Not the day's check: the next one comes within the hour.
+      retry_soon_ = true;
+      Fail(u"Stedding could not reach its update server.");
+      return;
+    }
+    // updates Up14: the server answered, so this was the day's check.
+    local_state_->SetTime(prefs::kUpdatesLastCheck, base::Time::Now());
+    // updates Up15: nothing in a feed is read until its signature verifies.
+    const std::optional<std::string_view> signed_body =
+        SignedFeedBody(*body, env_.public_key);
+    if (!signed_body) {
+      Fail(u"The update feed is not signed with Stedding's key.");
+      return;
+    }
+    data_decoder::DataDecoder::ParseXmlIsolated(
+        std::string(*signed_body),
+        data_decoder::mojom::XmlParser::WhitespaceBehavior::kIgnore,
+        base::BindOnce(&WinAppUpdater::OnParsed, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnParsed(data_decoder::DataDecoder::ValueOrError feed) {
+    if (!feed.has_value()) {
+      Fail(u"The update feed could not be read.");
+      return;
+    }
+    // updates Up15 (BACKLOG S-249): a signed feed older than one read before
+    // is an old feed served again, which would hold this copy back.
+    const base::Version newest = NewestWindowsVersion(*feed);
+    const base::Version newest_seen(
+        local_state_->GetString(prefs::kUpdatesNewestListed));
+    if (newest.IsValid() && newest_seen.IsValid() &&
+        newest.CompareTo(newest_seen) < 0) {
+      Fail(u"The update feed is older than one Stedding has already read.");
+      return;
+    }
+    if (newest.IsValid()) {
+      local_state_->SetString(prefs::kUpdatesNewestListed,
+                              newest.GetString());
+    }
+    const std::optional<UpdateItem> item =
+        LaterWindowsItem(*feed, env_.running, env_.allow_local_http);
+    if (!item) {
+      Finish(State::kUpToDate);
+      return;
+    }
+    item_ = *item;
+    SetVersion(base::UTF8ToUTF16(item_.version));
+    SetProgress(0);
+    SetState(State::kDownloading);
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&NewDownloadDir),
+        base::BindOnce(&WinAppUpdater::OnDownloadDir,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+  void OnDownloadDir(const base::FilePath& dir) {
+    if (dir.empty()) {
+      Fail(u"Stedding could not make room for the new version.");
+      return;
+    }
+    // item_.version is the release's name, checked against its installer's
+    // version (LaterWindowsItem): digits, dots and "-beta.".
+    download_ = dir.AppendASCII(
+        base::StrCat({"Stedding-", item_.version, "-win-x64.exe"}));
+    loader_ = MakeLoader(item_.url, kDownloadTimeout);
+    loader_->SetOnDownloadProgressCallback(base::BindRepeating(
+        &WinAppUpdater::OnProgress, weak_factory_.GetWeakPtr()));
+    loader_->DownloadToFile(
+        loader_factory_.get(),
+        base::BindOnce(&WinAppUpdater::OnDownloaded,
+                       weak_factory_.GetWeakPtr()),
+        download_, item_.length + 1);
+  }
+
+  void OnProgress(uint64_t current) {
+    if (item_.length > 0) {
+      SetProgress(static_cast<int>(
+          std::min<uint64_t>(100, current * 100 / item_.length)));
+    }
+  }
+
+  void OnDownloaded(base::FilePath path) {
+    loader_.reset();
+    if (path.empty()) {
+      Forget(download_, /*keep_log=*/false);
+      Fail(u"The new version could not be downloaded.");
+      return;
+    }
+    // updates Up20 (BACKLOG S-249): automatic updates turned off while a
+    // check the user did not ask for was downloading: nothing is installed.
+    if (!user_asked_ && !Automatic()) {
+      Forget(path, /*keep_log=*/false);
+      Finish(State::kIdle);
+      return;
+    }
+    // CONTINUE_ON_SHUTDOWN: a quit during the install must not wait for it;
+    // the installer finishes on its own, and the next start finds its work.
+    // Until then the check stays busy, so no second installer starts over
+    // this one (RunUpdateInstaller).
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE,
+        {base::MayBlock(), base::WithBaseSyncPrimitives(),
+         base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN},
+        base::BindOnce(&VerifyAndInstall, path, item_.length, item_.signature,
+                       env_.public_key, env_.run_installer),
+        base::BindOnce(&WinAppUpdater::OnInstalled, weak_factory_.GetWeakPtr(),
+                       path));
+  }
+
+  void OnInstalled(const base::FilePath& path, InstallResult result) {
+    if (!result.verified) {
+      // updates Up16: an installer that is not the release's never runs.
+      Forget(path, /*keep_log=*/false);
+      Fail(u"The download is not signed with Stedding's key.");
+      return;
+    }
+    Forget(path, /*keep_log=*/result.exit_code != 0);
+    busy_ = false;
+    if (result.exit_code != 0) {
+      Fail(base::StrCat({u"The new version could not be installed (",
+                         base::NumberToString16(result.exit_code), u")."}));
+      return;
+    }
+    // updates Up17: the new version waits beside this one; the pill offers
+    // the restart that swaps it in.
+    SetState(State::kReady);
+  }
+
+  // The installer's folder, with its log; a failed install's log is first
+  // kept in the temporary folder for a report. A quit waits for it: the pill asks
+  // for the restart as soon as the install is done, and a best-effort task
+  // was skipped at that quit, leaving the 170 MB installer behind.
+  static void Forget(const base::FilePath& path, bool keep_log) {
+    if (path.empty()) {
+      return;
+    }
+    base::ThreadPool::PostTask(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+        base::BindOnce(
+            [](const base::FilePath& path, bool keep_log) {
+              // The temporary folder by name, not the download's parent: an
+              // elevated process makes its folders in the system's.
+              base::FilePath temp;
+              if (keep_log && base::GetTempDir(&temp)) {
+                base::CopyFile(
+                    path.ReplaceExtension(FILE_PATH_LITERAL(".log")),
+                    temp.Append(kFailedInstallLog));
+              }
+              base::DeletePathRecursively(path.DirName());
+            },
+            path, keep_log));
+  }
+
+  // A check that found nothing, or failed: an answer for the user who asked,
+  // or for anyone watching once a download had begun (the pill, About), and
+  // the next check a day on. A background check that found nothing, or could
+  // not reach the feed, says nothing.
+  void Finish(State result) {
+    busy_ = false;
+    if (user_asked_ || state() == State::kChecking ||
+        state() == State::kDownloading) {
+      user_asked_ = false;
+      SetState(result);
+    } else {
+      SetState(State::kIdle);
+    }
+    if (retry_soon_ && Automatic()) {
+      retry_soon_ = false;
+      timer_.Start(FROM_HERE, kRetryDelay,
+                   base::BindOnce(&WinAppUpdater::Check,
+                                  base::Unretained(this)));
+      return;
+    }
+    retry_soon_ = false;
+    ScheduleCheck();
+  }
+
+  void Fail(std::u16string why) {
+    LOG(WARNING) << "Stedding update: " << why;
+    SetError(std::move(why));
+    Finish(State::kFailed);
+  }
+
+  void OnQuitTookTooLong() {
+    if (state() == State::kInstalling) {
+      SetState(State::kReady);
+    }
+  }
+
+  const raw_ptr<PrefService> local_state_;
+  const base::RepeatingClosure restart_;
+  const scoped_refptr<network::SharedURLLoaderFactory> loader_factory_;
+  const WinUpdaterEnvironment env_;
+  PrefChangeRegistrar registrar_;
+  base::OneShotTimer timer_;
+  base::OneShotTimer quit_grace_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  UpdateItem item_;
+  base::FilePath download_;
+  bool busy_ = false;
+  bool user_asked_ = false;
+  // The last check could not reach the feed (Finish retries within the hour).
+  bool retry_soon_ = false;
+  base::WeakPtrFactory<WinAppUpdater> weak_factory_{this};
+};
+
+// Only a copy the installer put in place updates itself: a build run from an
+// output folder never replaces the installed one (updates Up21).
+bool IsInstalledCopy() {
+  if (install_static::IsSystemInstall()) {
+    return false;
+  }
+  base::FilePath local_app_data;
+  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local_app_data)) {
+    return false;
+  }
+  const base::FilePath expected =
+      local_app_data.Append(install_static::GetChromeInstallSubDirectory())
+          .Append(FILE_PATH_LITERAL("Application"));
+  return base::FilePath::CompareEqualIgnoreCase(ExeDir().value(),
+                                               expected.value());
+}
+
+}  // namespace
+
+// The installer shows no window: mini_installer and setup.exe are windowed
+// programs with no UI of their own. It is waited for however long it runs
+// (BACKLOG S-343). An install slowed by a virus scan still finishes, and only
+// then is its result said and its folder deleted. Giving up after ten minutes
+// called a running install failed, deleted its folder under it, and let the
+// next check start a second installer beside it.
+int RunUpdateInstaller(base::CommandLine command) {
+  const base::FilePath installer = command.GetProgram();
+  command.AppendSwitch("do-not-launch-chrome");
+  command.AppendSwitch("verbose-logging");
+  command.AppendSwitchPath("log-file",
+                           installer.ReplaceExtension(FILE_PATH_LITERAL(".log")));
+  base::LaunchOptions options;
+  options.start_hidden = true;
+  // A per-user install: never a system one, whatever the environment says.
+  options.environment[L"GoogleUpdateIsMachine"] = std::wstring();
+  base::Process process = base::LaunchProcess(command, options);
+  int exit_code = -1;
+  if (!process.IsValid() || !process.WaitForExit(&exit_code)) {
+    return -1;
+  }
+  return exit_code;
+}
+
+WinUpdaterEnvironment::WinUpdaterEnvironment() = default;
+WinUpdaterEnvironment::WinUpdaterEnvironment(WinUpdaterEnvironment&&) = default;
+WinUpdaterEnvironment& WinUpdaterEnvironment::operator=(
+    WinUpdaterEnvironment&&) = default;
+WinUpdaterEnvironment::~WinUpdaterEnvironment() = default;
+
+std::unique_ptr<AppUpdater> CreateWinAppUpdater(
+    PrefService* local_state,
+    base::RepeatingClosure restart,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+    WinUpdaterEnvironment environment) {
+  return std::make_unique<WinAppUpdater>(local_state, std::move(restart),
+                                         std::move(url_loader_factory),
+                                         std::move(environment));
+}
+
+void StartAppUpdater(
+    PrefService* local_state,
+    base::RepeatingClosure restart,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory) {
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  // One per process; none in tests, in a build made outside the tooling (no
+  // version to compare), or in a copy the installer did not put in place.
+  if (AppUpdater::Get() || !local_state || !url_loader_factory ||
+      SteddingVersion().empty() ||
+      command_line.HasSwitch(switches::kTestType) || !IsInstalledCopy()) {
+    return;
+  }
+  GURL feed_url(kWindowsUpdateFeedUrl);
+  if (command_line.HasSwitch(kUpdateFeedSwitch)) {
+    feed_url = GURL(command_line.GetSwitchValueASCII(kUpdateFeedSwitch));
+  }
+  if (!feed_url.is_valid()) {
+    return;
+  }
+  WinUpdaterEnvironment environment;
+  environment.public_key = kWindowsUpdatePublicKey;
+  environment.feed_url = feed_url;
+  environment.running = version_info::GetVersion();
+  environment.exe_dir = ExeDir();
+  environment.installed_version = base::BindRepeating(&InstalledVersion);
+  environment.run_installer = base::BindRepeating(&RunInstaller);
+  environment.allow_local_http = command_line.HasSwitch(kUpdateFeedSwitch);
+  // Owned by the process, as the Mac's.
+  CreateWinAppUpdater(local_state, std::move(restart),
+                      std::move(url_loader_factory), std::move(environment))
+      .release();
+}
