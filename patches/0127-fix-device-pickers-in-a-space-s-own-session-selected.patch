+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_DOMAIN_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_DOMAIN_H_
+
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/storage_partition_config.h"
+
+namespace spaces {
+
+// Partition domain for isolated Spaces (ADR 0019). Must be [a-z]*.
+inline constexpr char kSpacePartitionDomain[] = "spaces";
+
+// True for the jar of a Space with an independent session. It keeps that
+// Space's sign-ins apart, and nothing else: the Space's site permissions are
+// the profile's, as in every other Space. Chromium refuses the device and
+// file pickers (Web Serial, WebUSB, WebHID, Web Bluetooth, File System
+// Access) and the on-device translation and speech services to a web page in
+// any partition but the profile's default, because their grants are the
+// profile's and a <webview>'s partition must not share them. A Space's jar is
+// one of the profile's own, so those checks count it as the default
+// (spaces B47, GitHub issue 73).
+inline bool IsSpacePartition(const content::StoragePartition* partition) {
+  if (!partition) {
+    return false;
+  }
+  const content::StoragePartitionConfig& config = partition->GetConfig();
+  return config.partition_domain() == kSpacePartitionDomain &&
+         !config.partition_name().empty();
+}
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_PARTITION_DOMAIN_H_
