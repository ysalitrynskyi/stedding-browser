+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/pin_store_factory.h"
+
+#include <memory>
+
+#include <string>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/pin_store.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/tab_parents.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+
+namespace spaces {
+
+// static
+PinStore* PinStoreFactory::GetForProfile(Profile* profile) {
+  return static_cast<PinStore*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
+
+// static
+PinStoreFactory* PinStoreFactory::GetInstance() {
+  static base::NoDestructor<PinStoreFactory> instance;
+  return instance.get();
+}
+
+PinStoreFactory::PinStoreFactory()
+    : ProfileKeyedServiceFactory(
+          "spaces::PinStore",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kOriginalOnly)
+              .Build()) {}
+
+PinStoreFactory::~PinStoreFactory() = default;
+
+std::unique_ptr<KeyedService>
+PinStoreFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  return std::make_unique<PinStore>(
+      Profile::FromBrowserContext(context)->GetPrefs());
+}
+
+tabs::TabInterface* OwnTabOfRecord(BrowserWindowInterface* window,
+                                   const tabs::TabInterface* tab) {
+  if (!window || !tab || !tab->GetContents()) {
+    return nullptr;
+  }
+  const SpaceModel* const model = SpaceModel::From(window);
+  const PinStore* const store =
+      model && model->follows_registry()
+          ? PinStoreFactory::GetForProfile(window->GetProfile())
+          : nullptr;
+  const std::string id = stedding::TabToken(tab->GetContents());
+  if (!store || !store->ready() || id.empty() || !store->Find(id)) {
+    return nullptr;
+  }
+  TabStripModel* const strip = window->GetTabStripModel();
+  for (int i = 0; i < strip->count(); ++i) {
+    tabs::TabInterface* const own = strip->GetTabAtIndex(i);
+    if (own != tab && (own->IsPinned() || model->IsSpacePinned(own)) &&
+        stedding::TabToken(own->GetContents()) == id) {
+      return own;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace spaces
