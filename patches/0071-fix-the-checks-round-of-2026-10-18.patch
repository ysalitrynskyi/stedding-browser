+    spaces::SpaceSwitcherView* const switcher =
+        FindDrawnSwitcher(widget->GetRootView());
+    ASSERT_TRUE(switcher) << "no Space switcher";
+    ui::SimpleMenuModel* const menu = switcher->BuildMenuForTesting(id, origin);
+    ASSERT_TRUE(menu);
