+// tabs R50: a split is two pills, the sidebar's 2 DIP apart, each with its
+// four corners round and each painted once: nothing between them, and no
+// part of either drawn twice, which the translucent fill of the dark window
+// showed as a bright bar between the halves.
+IN_PROC_BROWSER_TEST_F(HorizontalStripTest, ASplitIsTwoPillsAHairApart) {
+  Open("left.test");
+  Open("right.test");
+  const int left_index = tab_strip_model()->count() - 2;
+  tab_strip_model()->ActivateTabAt(left_index);
+  tab_strip_model()->AddToNewSplit(
+      {left_index + 1}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(tab_strip_model()->GetTabAtIndex(left_index)->IsSplit());
+  for (const Scheme scheme : {Scheme::kLight, Scheme::kDark}) {
+    SCOPED_TRACE(Name(scheme));
+    ShowStrip(scheme);
+    Tab* const left = strip()->tab_at(left_index);
+    Tab* const right = strip()->tab_at(left_index + 1);
+    ASSERT_TRUE(left && right && left->IsDrawn() && right->IsDrawn());
+    ASSERT_TRUE(left->IsActive() && right->IsActive())
+        << "both halves of the split on screen are drawn active";
+
+    // Each half's pill in the strip's coordinates.
+    const auto pill_of = [](const Tab* tab) {
+      SkRect pill =
+          tab->tab_style_views()
+              ->GetPath(TabStyle::PathType::kActiveTab, 1.0f, {})
+              .getBounds();
+      pill.offset(tab->x(), tab->y());
+      return pill;
+    };
+    const SkRect first = pill_of(left);
+    const SkRect second = pill_of(right);
+    EXPECT_NEAR(2.f, second.left() - first.right(), 0.6f)
+        << "the halves " << first.left() << "-" << first.right() << " and "
+        << second.left() << "-" << second.right();
+    for (const Tab* const half : {left, right}) {
+      SkRRect shape;
+      ASSERT_TRUE(half->tab_style_views()
+                      ->GetPath(TabStyle::PathType::kActiveTab, 1.0f, {})
+                      .isRRect(&shape));
+      for (const SkRRect::Corner corner :
+           {SkRRect::kUpperLeft_Corner, SkRRect::kUpperRight_Corner,
+            SkRRect::kLowerRight_Corner, SkRRect::kLowerLeft_Corner}) {
+        EXPECT_GT(shape.radii(corner).x(), 0) << "corner " << corner;
+      }
+    }
+
+    // Both halves painted where the strip has them, read along their middle.
+    const int x0 = left->x();
+    const int width = right->bounds().right() - x0;
+    gfx::Canvas canvas(gfx::Size(width, left->height()), 1.0f,
+                       /*is_opaque=*/false);
+    PaintInto(canvas, left, gfx::Vector2d(0, 0));
+    PaintInto(canvas, right, gfx::Vector2d(right->x() - x0, 0));
+    const SkBitmap& painted = canvas.GetBitmap();
+    const SkAlpha fill = SkColorGetA(left->GetColorProvider()->GetColor(
+        kColorTabBackgroundActiveFrameActive));
+    const int y = static_cast<int>(first.centerY());
+    const int from = static_cast<int>(first.left()) + 12 - x0;
+    const int to = static_cast<int>(second.right()) - 12 - x0;
+    int gap = 0;
+    for (int x = from; x < to; ++x) {
+      const SkAlpha alpha = SkColorGetA(painted.getColor(x, y));
+      if (alpha == SK_AlphaTRANSPARENT) {
+        ++gap;
+        continue;
+      }
+      EXPECT_LE(alpha, fill + 2) << "drawn twice at x " << x + x0;
+      if (alpha > fill + 2) {
+        break;
+      }
+    }
+    EXPECT_GE(gap, 1) << "nothing between the halves";
+  }
+}
+
+// tabs R51: the strip's controls have no disc or tile of their own and
+// their glyphs are in the tabs' text colour; the dividers between tabs are a
+// tint of that colour. Chromium's were a pale blue tile and a blue glyph for
+// the tab search chevron, the flat window colour round the new tab button on
+// the dark gradient, and blue or grey dividers.
+IN_PROC_BROWSER_TEST_F(HorizontalStripTest, TheControlsAndDividersSitOnTheGround) {
+  Open("a.test");
+  for (const Scheme scheme : {Scheme::kLight, Scheme::kDark}) {
+    SCOPED_TRACE(Name(scheme));
+    ShowStrip(scheme);
+    const ui::ColorProvider* const colours = browser_view()->GetColorProvider();
+    const SkColor text =
+        colours->GetColor(kColorTabForegroundInactiveFrameActive);
+    for (const ui::ColorId id :
+         {kColorNewTabButtonBackgroundFrameActive,
+          kColorNewTabButtonBackgroundFrameInactive,
+          kColorNewTabButtonCRBackgroundFrameActive,
+          kColorNewTabButtonCRBackgroundFrameInactive}) {
+      EXPECT_EQ(SK_AlphaTRANSPARENT, SkColorGetA(colours->GetColor(id)))
+          << "control background " << id;
+    }
+    EXPECT_EQ(text,
+              colours->GetColor(kColorTabSearchButtonCRForegroundFrameActive));
+    // tabs R53: the address row's divider before the pinned actions is a
+    // quarter of the row's icon colour, and an engaged action is that colour,
+    // not Material's blue.
+    const SkColor icon = colours->GetColor(kColorToolbarButtonIcon);
+    EXPECT_EQ(SkColorSetA(icon, 0x40),
+              colours->GetColor(kColorToolbarExtensionSeparatorEnabled));
+    EXPECT_EQ(icon, colours->GetColor(kColorToolbarActionItemEngaged));
+    // The divider shows with an extension's button beside it; the test
+    // window has none, so it is given its size to be painted.
+    ToolbarDivider* const divider =
+        FindFirst<ToolbarDivider>(browser_view()->toolbar());
+    ASSERT_TRUE(divider);
+    if (divider->size().IsEmpty()) {
+      divider->SetSize(divider->GetPreferredSize());
+    }
+    gfx::Canvas row_canvas(divider->size(), 1.0f, /*is_opaque=*/false);
+    divider->background()->Paint(&row_canvas, divider);
+    const SkColor drawn = row_canvas.GetBitmap().getColor(
+        divider->width() / 2, divider->height() / 2);
+    EXPECT_NEAR(0x40, SkColorGetA(drawn), 2) << "the divider as drawn";
+    EXPECT_FALSE(SkColorGetB(drawn) > SkColorGetR(drawn) + 40)
+        << "a blue divider: " << color_utils::SkColorToRgbaString(drawn);
+    // Opaque: the strip paints a divider at its own opacity.
