@@ -0,0 +1,148 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Making an app from a page fetches only what the page names, from the
+// page's own server: its manifest, the icons that lists, its favicons
+// (docs/features/web-apps.md Wa20, docs/PRIVACY.md "The user's own
+// browsing"). No Google service is in the path: no install model, no sync.
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/functional/callback.h"
+#include "base/synchronization/lock.h"
+#include "base/test/bind.h"
+#include "base/thread_annotations.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/web_applications/app_browser_controller.h"
+#include "chrome/browser/ui/web_applications/web_app_dialogs.h"
+#include "chrome/browser/web_applications/test/web_app_page_waiter.h"
+#include "chrome/browser/web_applications/web_app_command_manager.h"
+#include "chrome/browser/web_applications/web_app_provider.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/web_app_test_base.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/url_loader_interceptor.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+class MakeAppQuietTest : public stedding::WebAppBrowserTest {
+ protected:
+  // Browser sign-in is not allowed, as in a Stedding build: the build carries
+  // no OAuth client, and the test suite pretends one exists (ChromeTestSuite),
+  // which the switch takes back. Where sign-in is allowed, Chromium's Google
+  // account check (accounts.google.com/ListAccounts) may run at any moment,
+  // and on Windows it ran while the app was being made.
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    stedding::WebAppBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII("allow-browser-signin", "false");
+  }
+
+  // The watch is on before the test opens any page. URLLoaderInterceptor
+  // hooks the loader factories made after it: a page's frame gets its own at
+  // commit, and the banner page's service worker, which answers that page's
+  // requests by fetching them, when it starts. A watch begun with the page
+  // already open saw neither, and so nothing of the install.
+  void SetUpOnMainThread() override {
+    stedding::WebAppBrowserTest::SetUpOnMainThread();
+    // Called on the UI or the IO thread, by the factory it hooked.
+    watch_.emplace(base::BindLambdaForTesting(
+        [this](content::URLLoaderInterceptor::RequestParams* params) {
+          base::AutoLock hold(lock_);
+          if (recording_) {
+            seen_.push_back(params->url_request.url);
+          }
+          return false;
+        }));
+  }
+
+  void TearDownOnMainThread() override {
+    watch_.reset();
+    stedding::WebAppBrowserTest::TearDownOnMainThread();
+  }
+
+  // Every web address requested while `step` runs.
+  std::vector<GURL> RequestsDuring(base::OnceClosure step) {
+    {
+      base::AutoLock hold(lock_);
+      seen_.clear();
+      recording_ = true;
+    }
+    std::move(step).Run();
+    base::AutoLock hold(lock_);
+    recording_ = false;
+    return seen_;
+  }
+
+ private:
+  std::optional<content::URLLoaderInterceptor> watch_;
+  base::Lock lock_;
+  bool recording_ GUARDED_BY(lock_) = false;
+  std::vector<GURL> seen_ GUARDED_BY(lock_);
+};
+
+// web apps Wa20: making an app of a page with a manifest, and of one without,
+// contacts nothing but the page's own server. The round is seen: for the
+// page with a manifest, the manifest or one of its icons was fetched while
+// the watch was on.
+IN_PROC_BROWSER_TEST_F(MakeAppQuietTest, MakingAnAppContactsOnlyThePagesServer) {
+  auto accept = web_app::SetPwaInstallationAutoRespondForTesting(
+      web_app::InstallDialogTestResponse::kAcceptAndLaunch);
+  for (const std::string path :
+       {"/banners/manifest_test_page.html", "/title1.html"}) {
+    SCOPED_TRACE(path);
+    const GURL url = embedded_https_test_server().GetURL("a.test", path);
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    ASSERT_TRUE(web_app::test::WebAppPageWaiter(
+                    browser()->GetTabStripModel()->GetActiveWebContents())
+                    .ExpectUrl(url)
+                    .ManifestOrLoadedNoManifest()
+                    .WaitAndFlushCommands());
+
+    const std::vector<GURL> requests =
+        RequestsDuring(base::BindLambdaForTesting([&]() {
+          ui_test_utils::BrowserCreatedObserver created;
+          chrome::ExecuteCommand(browser(), IDC_STEDDING_MAKE_APP);
+          BrowserWindowInterface* const app = created.Wait();
+          EXPECT_TRUE(web_app::AppBrowserController::IsWebApp(app));
+          provider().command_manager().AwaitAllCommandsCompleteForTesting();
+          content::WebContents* const page =
+              app->GetTabStripModel()->GetActiveWebContents();
+          EXPECT_TRUE(page && content::WaitForLoadStop(page));
+        }));
+    // The watch saw the round: for the page with a manifest the install
+    // read the manifest or an icon it lists from the page's server. The page
+    // itself moves into the app's window without a reload, and a page with
+    // no manifest and no icon may need nothing fetched at all.
+    bool manifest_or_icon_seen = false;
+    for (const GURL& request : requests) {
+      if (request.SchemeIsHTTPOrHTTPS() || request.SchemeIsWSOrWSS()) {
+        EXPECT_EQ("a.test", request.host()) << request.spec();
+      }
+      if (request.host() != "a.test") {
+        continue;
+      }
+      manifest_or_icon_seen |= request.path().ends_with(".json") ||
+                               request.path().ends_with(".png");
+    }
+    if (url.path() == "/banners/manifest_test_page.html") {
+      EXPECT_TRUE(manifest_or_icon_seen)
+          << "no request for the manifest or an icon was seen";
+    }
+  }
+}
+
+}  // namespace
