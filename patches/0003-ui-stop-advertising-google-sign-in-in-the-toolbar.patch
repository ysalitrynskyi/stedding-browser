   ret.choice_screen_eligibility_config->restrict_to_associated_countries = true;
   return ret;
@@ -101,6 +111,11 @@ bool IsInProgramRegion(Program program,
   if (program == Program::kDefault) {
     return true;  // All countries can be associated with the default program.
   }
+  // Stedding: every country is in the choice-screen program (docs/PRIVACY.md:
+  // the user chooses the search engine at first run, in a shuffled list).
+  if (program == Program::kWaffle) {
+    return true;
+  }
 
   return std::ranges::contains(
       GetSettingsForProgram(program).associated_countries, country_id);
@@ -144,11 +159,10 @@ const ProgramSettings& GetSettingsForProgram(Program program) {
       NOTREACHED();
 #endif
     case Program::kWaffle:
-      if (base::FeatureList::IsEnabled(
-              switches::kWaffleRestrictToAssociatedCountries)) {
-        return kWaffleWithLocationRestrictionSettings;
-      }
-      return kWaffleSettings;
+      // Stedding: the program is worldwide, so the location restriction that
+      // upstream enables by default would only ever hide the chooser from a
+      // user whose country cannot be determined.
+      return kSteddingSettings;
     case Program::kDefault:
       return kDefaultSettings;
   }
