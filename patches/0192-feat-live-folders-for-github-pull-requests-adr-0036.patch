+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsSteddingLiveFoldersCardElement} from './stedding_live_folders_card.js';
+
+export function getHtml(this: SettingsSteddingLiveFoldersCardElement) {
+  return html`<!--_html_template_start_-->
+<div class="settings-box hr stacked" id="liveFolder">
+  <div class="flex">
+    <div class="label">Live folder: GitHub pull requests</div>
+    <div class="secondary" id="liveFolderLine">
+      A pinned folder of your open pull requests on GitHub: the ones you
+      opened, are assigned, are asked to review or are mentioned in. Stedding
+      asks api.github.com for the list every 10 minutes, and when a window
+      comes to the front, with a read-only token you make. Merged and closed
+      ones leave the folder.
+    </div>
+  </div>
+  ${this.state_.on ? html`
+    <div class="secondary" id="liveFolderState">${this.stateLine_()}</div>
+    ${this.state_.error ? html`
+      <div class="secondary" id="liveFolderFailure">${this.state_.error}</div>` :
+      ''}
+    <div class="button-row">
+      <cr-button id="liveFolderRefresh" @click="${this.onRefreshClick_}">
+        Refresh Now
+      </cr-button>
+      <cr-button id="liveFolderDelete" @click="${this.onDeleteClick_}">
+        Delete Live Folder
+      </cr-button>
+    </div>
+    <div class="secondary">
+      When GitHub no longer takes the token, make a new one and paste it here.
+      The folder keeps its name, icon and rows.
+      <a id="liveFolderTokenPage" href="${this.state_.tokenPage}"
+          target="_blank">Make a token on GitHub</a>
+    </div>` : html`
+    <div class="secondary">
+      Make a fine-grained token on GitHub with read-only access to pull
+      requests, then paste it here.
+      <a id="liveFolderTokenPage" href="${this.state_.tokenPage}"
+          target="_blank">Make a token on GitHub</a>
+    </div>`}
+  <div id="liveFolderMakeRow">
+    <cr-input id="liveFolderToken" type="password" spellcheck="false"
+        aria-label="GitHub token" placeholder="github_pat_…"
+        .value="${this.token_}" ?disabled="${this.state_.making}"
+        @input="${this.onTokenInput_}"
+        @keydown="${this.onTokenKeydown_}">
+    </cr-input>
+    <cr-button id="${this.state_.on ? 'liveFolderReplace' : 'liveFolderMake'}"
+        class="action-button"
+        ?disabled="${this.state_.making || !this.token_.trim()}"
+        @click="${this.onMakeClick_}">
+      ${this.state_.on ? 'Replace Token' : 'Make Live Folder'}
+    </cr-button>
+  </div>
+  ${this.makeError_ ? html`
+    <div class="secondary" id="liveFolderError">${this.makeError_}</div>` :
+    ''}
+</div>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/settings/stedding_page/stedding_live_folders_card.ts b/chrome/browser/resources/settings/stedding_page/stedding_live_folders_card.ts
new file mode 100644
index 0000000000000..1ee044d562fe8
--- /dev/null
+++ b/chrome/browser/resources/settings/stedding_page/stedding_live_folders_card.ts
@@ -0,0 +1,142 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-stedding-live-folders-card' makes, refreshes and deletes the
+ * profile's live folder of GitHub pull requests, and replaces its token
+ * (docs/features/live-folders.md Lf1, Lf2, Lf11; settings T70-T72). A token
+ * is sent once, to make the folder or replace the old one, and the page is
+ * never given it back.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './stedding_live_folders_card.css.js';
+import {getHtml} from './stedding_live_folders_card.html.js';
+
+/** What the handler sends: never the token. */
+export interface SteddingLiveFolderState {
+  available: boolean;
+  on: boolean;
+  making: boolean;
+  tokenPage: string;
+  space?: string;
+  rows?: number;
+  refreshed?: string;
+  error?: string;
+}
+
+interface MadeAnswer {
+  ok: boolean;
+  error: string;
+}
+
+const SettingsSteddingLiveFoldersCardElementBase =
+    WebUiListenerMixinLit(CrLitElement);
+
+export class SettingsSteddingLiveFoldersCardElement extends
+    SettingsSteddingLiveFoldersCardElementBase {
+  static get is() {
+    return 'settings-stedding-live-folders-card';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      state_: {type: Object},
+      token_: {type: String},
+      makeError_: {type: String},
+    };
+  }
+
+  protected accessor state_: SteddingLiveFolderState = {
+    available: false,
+    on: false,
+    making: false,
+    tokenPage: '',
+  };
+  protected accessor token_: string = '';
+  protected accessor makeError_: string = '';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'stedding-live-folder-changed',
+        (state: SteddingLiveFolderState) => this.state_ = state);
+    sendWithPromise('steddingGetLiveFolder').then((state: unknown) => {
+      this.state_ = state as SteddingLiveFolderState;
+    });
+  }
+
+  // live-folders Lf11: "Pull Requests in Work: 3 open, refreshed at 14:05."
+  protected stateLine_(): string {
+    const count = this.state_.rows ?? 0;
+    const open = count === 1 ? '1 open pull request' :
+                               `${count} open pull requests`;
+    const where = this.state_.space ? ` in ${this.state_.space}` : '';
+    const when =
+        this.state_.refreshed ? `, refreshed at ${this.state_.refreshed}` : '';
+    return `On${where}: ${open}${when}.`;
+  }
+
+  protected onTokenInput_(e: Event) {
+    this.token_ = (e.target as CrInputElement).value;
+    this.makeError_ = '';
+  }
+
+  protected onTokenKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      this.onMakeClick_();
+    }
+  }
+
+  protected onMakeClick_() {
+    const token = this.token_.trim();
+    if (!token || this.state_.making) {
+      return;
+    }
+    this.makeError_ = '';
+    sendWithPromise('steddingMakeLiveFolder', token).then((answer: unknown) => {
+      const made = answer as MadeAnswer;
+      if (made.ok) {
+        // The field forgets it as the folder is made.
+        this.token_ = '';
+      } else {
+        this.makeError_ = made.error;
+      }
+    });
+  }
+
+  protected onRefreshClick_() {
+    chrome.send('steddingRefreshLiveFolder');
+  }
+
+  protected onDeleteClick_() {
+    chrome.send('steddingDeleteLiveFolder');
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-stedding-live-folders-card':
+        SettingsSteddingLiveFoldersCardElement;
+  }
+}
+
+customElements.define(
+    SettingsSteddingLiveFoldersCardElement.is,
+    SettingsSteddingLiveFoldersCardElement);
