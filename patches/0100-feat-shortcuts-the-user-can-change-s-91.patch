+namespace shortcuts = stedding::shortcuts;
+
+// A chord no shipped table binds, on every platform: ⌃⌥⇧J, Ctrl+Alt+Shift+J.
+constexpr shortcuts::Chord kFreeChord(ui::VKEY_J,
+                                  ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                                      ui::EF_SHIFT_DOWN);
+
+PrefService* LocalState() {
+  return g_browser_process->local_state();
+}
+
+const shortcuts::Entry& Row(const char* name) {
+  const shortcuts::Entry* const entry = shortcuts::EntryForName(name);
+  CHECK(entry) << name;
+  return *entry;
+}
+
+ui::Accelerator Accel(const shortcuts::Chord& chord) {
+  return shortcuts::ToAccelerator(chord);
+}
+
+BrowserView* ViewOf(BrowserWindowInterface* window) {
+  return BrowserView::GetBrowserViewForBrowser(window);
+}
+
+// Presses `chord` in `window` the way the platform reads a key: the window's
+// accelerator table on Windows and Linux, CommandForKeyEvent on the Mac.
+// Whether a command ran.
+bool Press(BrowserWindowInterface* window, const shortcuts::Chord& chord) {
+#if BUILDFLAG(IS_MAC)
+  const int command = shortcuts::test::CommandForChord(Accel(chord));
+  return command != 0 && chrome::ExecuteCommand(window, command);
+#else
+  return ViewOf(window)->AcceleratorPressed(Accel(chord));
+#endif
+}
+
+// The command `chord` reaches in `window`, or 0.
+int CommandOn(BrowserWindowInterface* window, const shortcuts::Chord& chord) {
+#if BUILDFLAG(IS_MAC)
+  return shortcuts::test::CommandForChord(Accel(chord));
+#else
+  if (!ViewOf(window)->IsAcceleratorRegistered(Accel(chord))) {
+    return 0;
+  }
+  for (const AcceleratorMapping& mapping : GetAcceleratorList()) {
+    if (shortcuts::Chord(mapping.keycode, mapping.modifiers) == chord) {
+      return mapping.command_id;
+    }
+  }
+  return 0;
+#endif
+}
+
+// The chord the window's menus and tooltips name for `command`, or nothing.
+std::u16string NamedChord(BrowserWindowInterface* window, int command) {
+  ui::Accelerator accelerator;
+  return ViewOf(window)->GetAcceleratorForCommandId(command, &accelerator)
+             ? accelerator.GetShortcutText()
+             : std::u16string();
+}
+
+class ShortcutRebindTest : public InProcessBrowserTest {
+ protected:
+  void TearDownOnMainThread() override {
+    // A PRE_ test leaves its chord for the test after the restart.
+    if (!content::IsPreTest()) {
+      shortcuts::ResetAllShortcuts(LocalState());
+    }
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  // Gives `row` the free chord and takes its shipped chords away.
+  void MoveToTheFreeChord(const char* row) {
+    ASSERT_EQ(shortcuts::CheckKind::kOk,
+              shortcuts::AddShortcut(LocalState(), Row(row), kFreeChord,
+                                     /*replace=*/false,
+                                     shortcuts::OutsideHolders())
+                  .kind);
+    for (const shortcuts::Chord& chord :
+         shortcuts::DefaultChordsFor(Row(row).command)) {
+      shortcuts::RemoveShortcut(LocalState(), Row(row), chord);
+    }
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+};
