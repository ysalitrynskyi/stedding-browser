+  const std::optional<SpaceId> space = FindSpaceForTab(tab);
+  for (int i = index + 1; i < tab_strip_model_->count(); ++i) {
+    const tabs::TabInterface* const next = tab_strip_model_->GetTabAtIndex(i);
+    // Another Space's loose tab is no row here, and the pins may go on after
+    // it (pins H14, BACKLOG S-314).
+    if (!IsSpacePinned(next) && FindSpaceForTab(next) != space) {
