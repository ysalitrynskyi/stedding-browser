+gfx::Rect LittleWindowBounds(const gfx::Rect& over,
+                             const gfx::Size& remembered,
+                             const gfx::Rect& work_area) {
+  gfx::Size size = remembered;
+  if (size.IsEmpty()) {
+    // Smaller than the window it opens over, so it reads as a window of its
+    // own and the browser shows round it.
+    const gfx::Rect& basis = over.IsEmpty() ? work_area : over;
+    size = gfx::Size(basis.width() * 4 / 5, basis.height() * 4 / 5);
+  }
+  size.SetToMax(gfx::Size(kLittleMinWidth, kLittleMinHeight));
+  if (!work_area.IsEmpty()) {
+    size.SetToMin(work_area.size());
+  }
+  const gfx::Point centre =
+      over.IsEmpty() ? work_area.CenterPoint() : over.CenterPoint();
+  gfx::Rect bounds(centre.x() - size.width() / 2,
+                   centre.y() - size.height() / 2, size.width(),
+                   size.height());
+  if (!work_area.IsEmpty()) {
+    bounds.AdjustToFit(work_area);
+  }
+  return bounds;
+}
+
+void LittleWindowPlaced(BrowserWindowInterface* window,
+                        const gfx::Size& size,
+                        bool closing) {
+  if (!window) {
+    return;
+  }
+  std::map<SessionID, OpenedLittleWindow>& windows = OpenedLittleWindows();
+  const auto it = windows.find(window->GetSessionID());
+  if (it == windows.end()) {
+    return;
+  }
+  if (std::abs(size.width() - it->second.opened.width()) > kLittleSizeSlack ||
+      std::abs(size.height() - it->second.opened.height()) >
+          kLittleSizeSlack) {
+    it->second.resized = true;
+  }
+  if (it->second.resized && !size.IsEmpty()) {
+    PrefService* const pref_service = window->GetProfile()->GetPrefs();
+    pref_service->SetInteger(prefs::kLittleWidth, size.width());
+    pref_service->SetInteger(prefs::kLittleHeight, size.height());
+  }
+  if (closing) {
+    windows.erase(it);
+  }
+}
