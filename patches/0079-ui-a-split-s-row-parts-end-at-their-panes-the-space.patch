+// The row's width a form takes for `count` chips and the "+": the dots'
+// row with the active chip full.
+int RowWidth(const SwitcherRowForm& form, int count) {
+  const int chips = form.dots ? 2 * form.chip + (count - 1) * kSwitcherDot
+                              : (count + 1) * form.chip;
+  return form.inset + kSwitcherTrailingInset + chips + count * form.gap;
