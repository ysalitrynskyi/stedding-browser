+// toolbar T48 (GitHub issue 14): Settings > Stedding > Address field. A
+// centred width holds the field at that width on the page's middle, in every
+// state, with the row either side of it the window's to drag; full width
+// gives the field the row again. Each takes effect at once.
+IN_PROC_BROWSER_TEST_F(AddressBandTest, TheFieldsWidthIsASetting) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_EQ(0, prefs->GetInteger(stedding::prefs::kToolbarFieldWidth))
+      << "the field is not full width by default";
+  views::test::RunScheduledLayout(view());
+  const int full = bar()->width();
+
+  prefs->SetInteger(stedding::prefs::kToolbarFieldWidth, 480);
+  views::test::RunScheduledLayout(view());
+  EXPECT_EQ(480, bar()->width()) << "the compact field is not 480 DIP";
+  ASSERT_LT(bar()->width(), full);
+  const gfx::Rect field = bar()->GetBoundsInScreen();
+  const gfx::Rect page = view()->contents_container()->GetBoundsInScreen();
+  EXPECT_NEAR(page.CenterPoint().x(), field.CenterPoint().x(), 2)
+      << "the field is not on the page's middle";
+  // The row just before the field holds nothing, and moves the window.
+  gfx::Point beside(bar()->x() - 6, bar()->y() + bar()->height() / 2);
+  EXPECT_TRUE(view()->toolbar()->IsPositionInWindowCaption(beside))
+      << "the empty row beside a centred field is not the window's to drag";
+
+  bar()->omnibox_view()->RequestFocus();
+  views::test::RunScheduledLayout(view());
+  EXPECT_EQ(field, bar()->GetBoundsInScreen())
+      << "the field moved or grew when it took focus";
+
+  prefs->SetInteger(stedding::prefs::kToolbarFieldWidth, 0);
+  views::test::RunScheduledLayout(view());
+  EXPECT_EQ(full, bar()->width()) << "full width did not give the row back";
+}
+
+// toolbar T48 (GitHub issue 14, a comment on 0.4.0 beta 1): in a centred
+// field the buttons at its end, Copy Link among them, answer a press as they
+// do at full width. On Windows they did not respond in a centred field
+// (BACKLOG S-357). The frame took a press there as a click; the press then
+// went to the right spacer, which still lay where the layout had put it, over
+// the end of a field moved toward the caption buttons it runs on under
+// (toolbar T19): a press goes to the last view under it. The Mac's row has
+// no caption buttons, so the test lends it Windows' reserve.
+IN_PROC_BROWSER_TEST_F(AddressBandTest, ACentredFieldsButtonsAnswerAPress) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  views::NonClientView* const frame = view()->GetWidget()->non_client_view();
+  views::View* const root = view()->GetWidget()->GetRootView();
+  ToolbarView* const row = view()->toolbar();
+  // About the width of Windows' three caption buttons.
+  constexpr int kCaptionButtons = 140;
+  for (const int width : {0, 800, 480}) {
+    SCOPED_TRACE(base::StringPrintf("width %d", width));
+    prefs->SetInteger(stedding::prefs::kToolbarFieldWidth, width);
+    views::test::RunScheduledLayout(view());
+    page_actions::PageActionContainerView* const actions =
+        bar()->page_action_container();
+    ASSERT_TRUE(actions);
+    std::vector<views::View*> buttons;
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      buttons.clear();
+      for (views::View* const child : actions->children()) {
+        if (child->GetVisible() && !child->bounds().IsEmpty()) {
+          buttons.push_back(child);
+        }
+      }
+      return !buttons.empty();
+    })) << "no button at the field's end";
+    for (views::View* const button : buttons) {
+      gfx::Point centre = button->GetLocalBounds().CenterPoint();
+      views::View::ConvertPointToTarget(button, frame, &centre);
+      EXPECT_EQ(HTCLIENT, frame->NonClientHitTest(centre))
+          << button->GetClassName() << " at " << centre.ToString()
+          << " is the window's to drag";
+    }
+    // The press itself, with the row's reserve as on Windows: laid out here,
+    // the toolbar alone, before the window's layout sets the Mac's back.
+    row->SetSteddingTrailingReserve(kCaptionButtons);
+    row->DeprecatedLayoutImmediately();
+    for (views::View* const button : buttons) {
+      gfx::Point centre = button->GetLocalBounds().CenterPoint();
+      views::View::ConvertPointToTarget(button, root, &centre);
+      views::View* const target = root->GetEventHandlerForPoint(centre);
+      EXPECT_TRUE(target && button->Contains(target))
+          << "a press on " << button->GetClassName() << " at "
+          << centre.ToString() << " goes to "
+          << (target ? target->GetClassName() : "nothing");
+    }
+    row->SetSteddingTrailingReserve(0);
+  }
+}
+
+// toolbar T49 (GitHub issue 14, a comment on 0.4.0 beta 2): side by side, the
+// field is the active pane's at every width: over that pane alone, no wider
+// than the setting, with the row over the gap the window's to drag, and it
+// follows the focus to the other pane. It spanned both panes, the left
+// pane's address drawn across the gap.
+IN_PROC_BROWSER_TEST_F(AddressBandTest, ASplitsFieldSitsOverTheActivePane) {
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("b.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs->ActivateTabAt(0);
+  tabs->AddToNewSplit({1}, split_tabs::SplitTabVisualData(),
+                      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(tabs->GetTabAtIndex(1)->IsSplit());
+  MultiContentsView* const panes = view()->multi_contents_view();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(view());
+    return panes->IsInSplitView() &&
+           panes->GetSplitLayout() == split_tabs::SplitTabLayout::kSideBySide;
+  }));
+  ToolbarView* const row = view()->toolbar();
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  for (const int width : {0, 800, 480}) {
+    prefs->SetInteger(stedding::prefs::kToolbarFieldWidth, width);
+    for (const int active : {0, 1}) {
+      SCOPED_TRACE(base::StringPrintf("width %d, pane %d", width, active));
+      tabs->ActivateTabAt(active);
+      const auto pane = [&]() {
+        return panes->GetActiveContentsContainerView()->GetBoundsInScreen();
+      };
+      const auto over_the_pane = [&]() {
+        views::test::RunScheduledLayout(view());
+        const gfx::Rect field = bar()->GetBoundsInScreen();
+        return field.x() >= pane().x() && field.right() <= pane().right();
+      };
+      EXPECT_TRUE(base::test::RunUntil(over_the_pane))
+          << "the field at " << bar()->GetBoundsInScreen().ToString()
+          << " is not over the active pane at " << pane().ToString();
+      if (width) {
+        EXPECT_LE(bar()->width(), width);
+      }
+      // The field's own ends are the field's; the row over the gap between
+      // the panes is the window's.
+      const int middle = bar()->y() + bar()->height() / 2;
+      EXPECT_FALSE(
+          row->IsPositionInWindowCaption(gfx::Point(bar()->x() + 4, middle)))
+          << "the field's start is the window's to drag";
+      EXPECT_FALSE(row->IsPositionInWindowCaption(
+          gfx::Point(bar()->bounds().right() - 4, middle)))
+          << "the field's end is the window's to drag";
+      const gfx::Rect left = panes->contents_container_views()[0]
+                                 ->GetBoundsInScreen();
+      const gfx::Rect right = panes->contents_container_views()[1]
+                                  ->GetBoundsInScreen();
+      gfx::Point gap((left.right() + right.x()) / 2, 0);
+      views::View::ConvertPointFromScreen(row, &gap);
+      gap.set_y(middle);
+      EXPECT_TRUE(row->IsPositionInWindowCaption(gap))
+          << "the row over the gap is not the window's to drag";
+    }
+  }
+}
