 }
 
+// splits J7: in a split each pane is the page itself, as the one page is
+// outside a split: the pages start right under the address row where the
+// page did, keep its gutters to the window's edges, and lie one card gutter
+// apart, the resize handle drawn between them. Chromium padded each pane for
+// its ring: a band of the mat ran between the row and both pages, and the
+// pages were 20 DIP apart (operator, 2026-10-13). The same with the sidebar
+// hidden, where the page meets the window's edges.
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, SplitPanesAreThePageAGutterApart) {
+  AppendTab();
+  Settle();
+  MultiContentsView* const multi = browser_view()->multi_contents_view();
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  for (const bool hidden : {false, true}) {
+    SCOPED_TRACE(hidden ? "the sidebar hidden" : "the sidebar open");
+    if (hidden) {
+      CloseTo(stedding::prefs::kSidebarClosedHidden);
+    }
+    const gfx::Rect page = Page();
+    tabs->ActivateTabAt(0);
+    const split_tabs::SplitTabId split = tabs->AddToNewSplit(
+        {1}, split_tabs::SplitTabVisualData(),
+        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(browser_view()->GetWidget());
+      return multi->IsInSplitView();
+    }));
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    const gfx::Rect start =
