+// Stedding (docs/features/archive.md A13): a key set on a window's tabs after
+// the window was recorded and written is on them after a restart, and a key
+// erased so is gone after one; an id that names no window changes nothing.
+TEST_F(TabRestoreServiceImplWithMockClientTest,
+       SetWindowTabsExtraDataOutlivesTheRun) {
+  ON_CALL(*mock_tab_restore_service_client_, ShouldTrackURLForRestore(_))
+      .WillByDefault(Return(true));
+  const SerializedNavigationEntry navigation_entry =
+      SerializedNavigationEntryTestHelper::CreateNavigationForTest();
+  testing::NiceMock<MockLiveTab> first_tab;
+  testing::NiceMock<MockLiveTab> second_tab;
+  for (MockLiveTab* const tab : {&first_tab, &second_tab}) {
+    ON_CALL(*tab, GetSessionID).WillByDefault(Return(SessionID::NewUnique()));
+    ON_CALL(*tab, GetEntryCount).WillByDefault(Return(1));
+    ON_CALL(*tab, GetEntryAtIndex).WillByDefault(Return(navigation_entry));
+  }
+  testing::NiceMock<MockLiveTabContext> context;
+  ON_CALL(context, GetSessionID).WillByDefault(Return(SessionID::NewUnique()));
+  ON_CALL(context, GetWindowType)
+      .WillByDefault(Return(sessions::SessionWindow::TYPE_NORMAL));
+  ON_CALL(context, GetTabCount).WillByDefault(Return(2));
+  ON_CALL(context, GetLiveTabAt(0)).WillByDefault(Return(&first_tab));
+  ON_CALL(context, GetLiveTabAt(1)).WillByDefault(Return(&second_tab));
+  service_->BrowserClosing(&context);
+  ASSERT_EQ(1u, service_->entries().size());
+
+  // Each of the window's tabs holds `value` under the key, or no key.
+  const auto expect_tabs = [&](const std::optional<std::string>& value) {
+    ASSERT_EQ(1u, service_->entries().size());
+    const Entry& entry = *service_->entries().front();
+    ASSERT_EQ(sessions::tab_restore::Type::WINDOW, entry.type);
+    const Window& window = static_cast<const Window&>(entry);
+    ASSERT_EQ(2u, window.tabs.size());
+    for (const std::unique_ptr<sessions::tab_restore::Tab>& tab :
+         window.tabs) {
+      const auto it = tab->extra_data.find("stedding.test");
+      if (value) {
+        ASSERT_NE(tab->extra_data.end(), it);
+        EXPECT_EQ(*value, it->second);
+      } else {
+        EXPECT_EQ(tab->extra_data.end(), it);
+      }
+    }
+  };
+
+  // A restart makes a new client: it keeps every address, as the first one
+  // does and as the browser's does for a web page. A client left to the
+  // mock's default keeps none, so the window read back after the first
+  // restart was never written again, and the second read nothing.
+  const auto restart = [&]() {
+    RecreateService();
+    ON_CALL(*mock_tab_restore_service_client_, ShouldTrackURLForRestore(_))
+        .WillByDefault(Return(true));
+  };
+
+  // Written first, as the save timer writes a new entry.
+  service_->command_storage_manager_for_testing()->Save();
+  service_->SetWindowTabsExtraData(SessionID::NewUnique(), "stedding.test",
+                                   "1");
+  expect_tabs(std::nullopt);
+  service_->SetWindowTabsExtraData(service_->entries().front()->id,
+                                   "stedding.test", "1");
+  expect_tabs("1");
+  restart();
+  expect_tabs("1");
+
+  // The entries read back are written out again; the erase comes after.
+  service_->command_storage_manager_for_testing()->Save();
+  service_->SetWindowTabsExtraData(service_->entries().front()->id,
+                                   "stedding.test", std::nullopt);
+  expect_tabs(std::nullopt);
+  restart();
+  expect_tabs(std::nullopt);
+}
