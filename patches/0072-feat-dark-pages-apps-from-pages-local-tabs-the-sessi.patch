+  tabs::TabInterface* const b1 = Open("b1-nested.test");
+  tabs::FolderTabCollection* const outer =
+      tab_strip_model()->AddToNewFolder({Index(a1), Index(b1)});
+  ASSERT_TRUE(outer);
+  tabs::FolderTabCollection* const inner =
+      tab_strip_model()->AddToNewFolder({Index(b1)}, outer);
+  ASSERT_TRUE(inner);
+  ASSERT_EQ(inner, b1->GetParentCollection());
+  tabs::TabInterface* const after = Open("after-nested.test");
