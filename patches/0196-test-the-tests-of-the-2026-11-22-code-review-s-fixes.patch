+// docs/features/tabs.md R16, docs/features/splits.md J1: a split that sleeps
+// (on the desktop a discard swaps in new contents) keeps each pane's own
+// name. Settling the new contents wrote one pane's name onto the other.
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+class SplitNamesW2B20Test : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+
+  // Opens a tab the way the fixture does (foreground, index 0) and returns it.
+  tabs::TabInterface* OpenTab(const GURL& url) {
+    AddTab(browser(), url);
+    return tabs().GetActiveTab();
+  }
+
+  // Splits the active tab with `other`.
+  void SplitActiveWith(tabs::TabInterface* other) {
+    tabs().AddToNewSplit({tabs().GetIndexOfTab(other)},
+                         split_tabs::SplitTabVisualData(),
+                         split_tabs::SplitTabCreatedSource::kToolbarButton);
+  }
+
+  // What a discard does on the desktop: new contents from the profile alone,
+  // carrying the page's history, in the tab's place.
+  void Sleep(tabs::TabInterface* tab) {
+    std::unique_ptr<content::WebContents> fresh = content::WebContents::Create(
+        content::WebContents::CreateParams(profile()));
+    fresh->GetController().CopyStateFrom(&tab->GetContents()->GetController(),
+                                         /*needs_reload=*/false);
+    tabs().DiscardWebContents(tab->GetContents(), std::move(fresh)).reset();
+  }
+
+  static std::u16string NameOf(tabs::TabInterface* tab) {
+    return stedding::TabName(tab->GetContents());
+  }
+};
+
+// P27-1a (tabs R16, splits J1): one pane named "Foo", the other unnamed. The
+// split sleeps: the named pane keeps "Foo" and the other stays unnamed, so
+// its row reads its page's title. It read "Foo" too.
+TEST_F(SplitNamesW2B20Test, ASleepingSplitLeavesAnUnnamedPaneUnnamed) {
+  ASSERT_TRUE(SpaceModel::From(browser()));
+  tabs::TabInterface* const named = OpenTab(GURL("https://a.example/"));
+  stedding::SetTabName(browser(), named, u"Foo");
+  tabs::TabInterface* const unnamed = OpenTab(GURL("https://b.example/"));
+  ASSERT_TRUE(NameOf(unnamed).empty());
+  SplitActiveWith(named);
+  ASSERT_TRUE(named->IsSplit());
+  ASSERT_TRUE(unnamed->IsSplit());
+  ASSERT_TRUE(named->GetSplit() == unnamed->GetSplit());
+  ASSERT_TRUE(NameOf(unnamed).empty()) << "the split named its panes";
+  OpenTab(GURL("https://c.example/"));  // Another tab is in front.
+
+  Sleep(named);
+  Sleep(unnamed);
+  // The new contents are settled a turn later (SpaceModel).
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(u"Foo", NameOf(named));
+  EXPECT_TRUE(NameOf(unnamed).empty())
+      << "the unnamed pane took its peer's name: " << NameOf(unnamed);
+}
+
+// P27-1a (tabs R16, splits J1): each pane named before the split, "Foo" and
+// "Bar". The split sleeps, and each keeps its own name.
+TEST_F(SplitNamesW2B20Test, ASleepingSplitKeepsEachPanesOwnName) {
+  tabs::TabInterface* const foo = OpenTab(GURL("https://a.example/"));
+  stedding::SetTabName(browser(), foo, u"Foo");
+  tabs::TabInterface* const bar = OpenTab(GURL("https://b.example/"));
+  stedding::SetTabName(browser(), bar, u"Bar");
+  ASSERT_EQ(u"Foo", NameOf(foo));
+  SplitActiveWith(foo);
+  ASSERT_TRUE(foo->IsSplit());
+  ASSERT_TRUE(bar->IsSplit());
+  OpenTab(GURL("https://c.example/"));
+
+  Sleep(foo);
+  Sleep(bar);
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(u"Foo", NameOf(foo));
+  EXPECT_EQ(u"Bar", NameOf(bar));
+}
+
+}  // namespace
+}  // namespace spaces
