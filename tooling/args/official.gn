# Stedding — official build (macOS arm64).
#
# What this is for: anything a user or a benchmark will ever see. is_official_build
# turns on the full shipping optimisation pipeline: PGO with upstream's profile for
# the pinned version, ThinLTO, and CFI where applicable.
#
# Cost: substantially longer than release.gn, and the link step is memory-hungry.
# Measured times for both configurations are recorded in docs/ARCHITECTURE.md.

target_os  = "mac"
target_cpu = "arm64"

is_official_build  = true
is_component_build = false

# Shipping builds are stripped; symbols are archived separately when we start
# symbolising crash reports (not before M7 — see docs/PRIVACY.md on crash reporting).
symbol_level       = 0
blink_symbol_level = 0
v8_symbol_level    = 0

enable_nacl    = false
use_remoteexec = false
