--- /dev/null
+++ b/chrome/test/stedding/sidebar_sync_settings_browsertest.cc
@@ -0,0 +1,1036 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Stedding's settings and the routes in sync (docs/features/sidebar-file.md
+// Sf58-Sf62, ADR 0037), as a person uses them: a folder in a temporary
+// directory stands for the shared one, and another computer's file is
+// written into it by the test.
+
+#include <algorithm>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/time/time.h"
+#include "base/token.h"
+#include "base/values.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_parts.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_service.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_service_factory.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_state.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+namespace sb = spaces::sidebar_sync;
+namespace p = stedding::prefs;
+
+constexpr char kPeer[] = "0123456789abcdef";
+
+int64_t NowMs() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+// Another computer's sidebar: one Space, no pins.
+sb::State PeerState(const std::string& space,
+                    int64_t t,
+                    const std::string& name = "Peer Space") {
+  sb::State state;
+  const sb::Stamp stamp{t, kPeer};
+  sb::Record record(sb::Kind::kSpace);
+  record.f[sb::kFieldName] = sb::Field{name, stamp};
+  record.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+  record.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+  state.records[space] = record;
+  state.lists[sb::kSpacesList].order = {space};
+  state.lists[sb::kSpacesList].s = stamp;
+  state.lists[sb::PinsListOf(space)].s = stamp;
+  return state;
+}
+
+base::DictValue Route(const std::string& pattern, const std::string& space) {
+  base::DictValue route;
+  route.Set("match", "site");
+  route.Set("pattern", pattern);
+  route.Set("space", space);
+  return route;
+}
+
+class SidebarSyncPartsTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  PrefService* local_state() { return g_browser_process->local_state(); }
+  base::FilePath sync_dir() {
+    return shared_.GetPath().AppendASCII(sb::kSyncFolderName);
+  }
+
+  // Another computer's file, with its parts.
+  void WritePeer(const sb::State& state,
+                 int64_t seq,
+                 const sb::FileParts& parts = sb::FileParts()) {
+    base::ScopedAllowBlockingForTesting allow;
+    sb::FileMeta meta;
+    meta.install = kPeer;
+    meta.device = "Office PC";
+    meta.seq = seq;
+    meta.nonce = sb::MakeInstallId();
+    meta.written_ms = NowMs();
+    meta.hlc = state.MaxTime();
+    meta.joined_ms = 1;
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(
+        base::WriteFile(sync_dir().AppendASCII(sb::FileNameFor(kPeer)),
+                        sb::SerializeSyncFile(state, meta, parts)));
+  }
+
+  base::DictValue Preview() {
+    base::test::TestFuture<base::DictValue> preview;
+    service()->PreviewJoin(shared_.GetPath(), preview.GetCallback());
+    return preview.Take();
+  }
+
+  // The join is made once its backup is written (Sf9).
+  void Join(sb::JoinParts parts,
+            bool combine = false,
+            std::vector<size_t> accepted = {}) {
+    base::DictValue preview = Preview();
+    ASSERT_FALSE(preview.FindString("refusal"));
+    ASSERT_TRUE(service()->ConfirmJoin(combine, "Test computer", accepted,
+                                       parts));
+    ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  void StartOver() {
+    service()->CancelJoin();
+    if (service()->enabled()) {
+      service()->Stop(/*remove_own_file=*/false);
+    }
+    ASSERT_FALSE(service()->enabled());
+    base::ScopedAllowBlockingForTesting allow;
+    left_.push_back(std::move(shared_));
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  std::string OwnInstall() {
+    return prefs()->GetString(p::kSidebarSyncInstallId);
+  }
+
+  sb::ParsedFile ReadOwnFile() {
+    base::ScopedAllowBlockingForTesting allow;
+    std::string json;
+    if (!base::ReadFileToString(
+            sync_dir().AppendASCII(sb::FileNameFor(OwnInstall())), &json)) {
+      return sb::ParsedFile();
+    }
+    return sb::ParseSyncFile(json);
+  }
+
+  // This computer's file as it was written, not as a reader filters it.
+  std::optional<base::DictValue> RawOwnFile() {
+    base::ScopedAllowBlockingForTesting allow;
+    std::string json;
+    if (!base::ReadFileToString(
+            sync_dir().AppendASCII(sb::FileNameFor(OwnInstall())), &json)) {
+      return std::nullopt;
+    }
+    return base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  }
+
+  // Turns sync off and on again without Stop: the ledger is read from disk,
+  // as at the next launch of this profile.
+  void Reload() {
+    const base::FilePath folder = service()->folder();
+    prefs()->ClearPref(p::kSidebarSyncFolder);
+    ASSERT_FALSE(service()->observing_for_testing());
+    prefs()->SetFilePath(p::kSidebarSyncFolder, folder);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return service()->GetStatus().FindBool("ready").value_or(false);
+    }));
+  }
+
+  // This computer's file's value of `path`, once the file has one.
+  std::optional<sb::SettingField> OwnSetting(const std::string& path) {
+    std::optional<sb::SettingField> found;
+    const bool written = base::test::RunUntil([&] {
+      const sb::ParsedFile own = ReadOwnFile();
+      if (!own.parts.settings || !own.parts.settings->contains(path)) {
+        return false;
+      }
+      found = own.parts.settings->at(path);
+      return true;
+    });
+    return written ? found : std::nullopt;
+  }
+
+  // Waits until this computer's file holds `json` for `path`.
+  bool OwnFileSays(const std::string& path, const std::string& json) {
+    return base::test::RunUntil([&] {
+      const sb::ParsedFile own = ReadOwnFile();
+      return own.parts.settings && own.parts.settings->contains(path) &&
+             own.parts.settings->at(path).json == json;
+    });
+  }
+
+  static sb::Settings Setting(const std::string& path,
+                              base::Value value,
+                              int64_t t) {
+    sb::Settings settings;
+    settings[path] =
+        sb::SettingField{sb::SettingJson(value), sb::Stamp{t, kPeer}};
+    return settings;
+  }
+
+  base::ScopedTempDir shared_;
+  std::vector<base::ScopedTempDir> left_;
+};
+
+// Sf58, Sf59, Sf60: a setting changed on the other computer arrives here, a
+// browser-wide one too; a Mac-only one does not, whatever the file says.
+// An edit here is stamped here and travels; a value that arrived keeps the
+// other computer's stamp; the later edit wins.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest,
+                       ASettingChangedElsewhereArrivesAndAMacOnlyOneDoesNot) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  const int64_t start = NowMs();
+  WritePeer(PeerState(space, start), 1);
+  Join(sb::JoinParts());
+  ASSERT_TRUE(service()->settings_on());
+  // This computer's settings, all at their defaults, are in its file.
+  ASSERT_TRUE(OwnFileSays(p::kPeekEnabled, "true"));
+
+  sb::FileParts parts;
+  parts.settings = Setting(p::kPeekEnabled, base::Value(false), start + 60'000);
+  parts.settings->merge(
+      Setting(p::kSidebarDensity, base::Value(1), start + 60'000));
+  // A file that offers a Mac-only setting: never read.
+  parts.settings->merge(
+      Setting(p::kCameraRowFullscreen, base::Value(true), start + 60'000));
+  WritePeer(PeerState(space, start), 2, parts);
+  Scan();
+
+  EXPECT_FALSE(prefs()->GetBoolean(p::kPeekEnabled));
+  EXPECT_EQ(1, local_state()->GetInteger(p::kSidebarDensity));
+  EXPECT_FALSE(prefs()->GetBoolean(p::kCameraRowFullscreen));
+
+  // What arrived is not an edit made here: it keeps the other computer's
+  // stamp in this computer's file.
+  ASSERT_TRUE(OwnFileSays(p::kPeekEnabled, "false"));
+  EXPECT_EQ(kPeer, OwnSetting(p::kPeekEnabled)->s.w);
+  {
+    const sb::ParsedFile own = ReadOwnFile();
+    ASSERT_TRUE(own.parts.settings);
+    EXPECT_FALSE(own.parts.settings->contains(p::kCameraRowFullscreen));
+  }
+
+  // An edit here is stamped here, later than what arrived, and travels.
+  prefs()->SetBoolean(p::kPeekEnabled, true);
+  service()->CommitSettingsForTesting();
+  ASSERT_TRUE(OwnFileSays(p::kPeekEnabled, "true"));
+  EXPECT_EQ(OwnInstall(), OwnSetting(p::kPeekEnabled)->s.w);
+  EXPECT_GT(OwnSetting(p::kPeekEnabled)->s.t, start + 60'000);
+
+  // An older edit from the other computer does not undo it.
+  parts.settings = Setting(p::kPeekEnabled, base::Value(false), start + 1);
+  WritePeer(PeerState(space, start), 3, parts);
+  Scan();
+  EXPECT_TRUE(prefs()->GetBoolean(p::kPeekEnabled));
+
+  // A value of another type than the setting's is never applied.
+  parts.settings =
+      Setting(p::kUiAnimate, base::Value("not a switch"), start + 120'000);
+  WritePeer(PeerState(space, start), 4, parts);
+  Scan();
+  EXPECT_TRUE(prefs()->GetBoolean(p::kUiAnimate));
+
+  // Sf59, Sf68: as written, not as a reader filters it: this computer's
+  // file holds synced settings alone, and none of sync's own.
+  const std::optional<base::DictValue> raw = RawOwnFile();
+  ASSERT_TRUE(raw);
+  const base::DictValue* const written =
+      raw->FindDictByDottedPath("stedding_sync.settings");
+  ASSERT_TRUE(written);
+  EXPECT_GT(written->size(), 40u);
+  for (const auto [path, value] : *written) {
+    EXPECT_TRUE(sb::IsSyncedSetting(path)) << path << " was written";
+  }
+  std::string text;
+  ASSERT_TRUE(base::JSONWriter::Write(*raw, &text));
+  for (const char* never :
+       {p::kSidebarSyncPlaceSignIn, p::kSidebarSyncPlace,
+        p::kSidebarSyncInstallId, p::kSidebarSyncFolder,
+        p::kCameraRowFullscreen, p::kShortcutsUser, p::kLittleWidth,
+        p::kUpdatesAutomatic, p::kSidebarSyncBrowserApplied}) {
+    EXPECT_EQ(std::string::npos, text.find(never)) << never;
+  }
+}
+
+// Sf61: a route to a Space the other computer has and this one does not yet
+// lands here with the first read after the Space arrives.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest,
+                       ARouteArrivesWithTheFirstReadAfterItsSpace) {
+  const std::string first = base::Token::CreateRandom().ToString();
+  const std::string later = base::Token::CreateRandom().ToString();
+  const int64_t start = NowMs();
+  WritePeer(PeerState(first, start), 1);
+  Join(sb::JoinParts());
+
+  base::ListValue theirs;
+  theirs.Append(Route("news.example", later));
+  sb::FileParts parts;
+  parts.settings =
+      Setting(p::kSpaceRoutes, base::Value(theirs.Clone()), start + 60'000);
+  WritePeer(PeerState(first, start), 2, parts);
+  Scan();
+  EXPECT_TRUE(prefs()->GetList(p::kSpaceRoutes).empty());
+
+  sb::State both = PeerState(first, start);
+  const sb::State second = PeerState(later, start + 60'000, "Later");
+  both.records[later] = second.records.at(later);
+  both.lists[sb::kSpacesList].order = {first, later};
+  both.lists[sb::kSpacesList].s = sb::Stamp{start + 60'000, kPeer};
+  both.lists[sb::PinsListOf(later)] = second.lists.at(sb::PinsListOf(later));
+  WritePeer(both, 3, parts);
+  Scan();
+  const base::ListValue& routes = prefs()->GetList(p::kSpaceRoutes);
+  ASSERT_EQ(1u, routes.size());
+  EXPECT_EQ(later, *routes[0].GetDict().FindString("space"));
+}
+
+// Sf61 (review finding): a route this computer made before another computer
+// paired its Space under a smaller id keeps its Space here, and this
+// computer's file names the Space by the shared id from then on.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest, ARouteMadeBeforeAPairKeepsItsSpace) {
+  spaces::SpaceModel& model = *spaces::SpaceModel::From(browser());
+  const std::string here = model.active_id().ToString();
+  Join(sb::JoinParts());
+  base::ListValue mine;
+  mine.Append(Route("github.com", here));
+  prefs()->SetList(p::kSpaceRoutes, mine.Clone());
+  service()->CommitSettingsForTesting();
+  ASSERT_TRUE(OwnFileSays(p::kSpaceRoutes,
+                          sb::SettingJson(base::Value(mine.Clone()))));
+
+  // The other computer joined and paired its Work, whose id is the smaller,
+  // with this one: its file carries the alias.
+  std::string there = base::Token::CreateRandom().ToString();
+  while (there >= here) {
+    there = base::Token::CreateRandom().ToString();
+  }
+  sb::State state = PeerState(there, NowMs(), "Work");
+  state.aliases[here] = there;
+  WritePeer(state, 1);
+  Scan();
+
+  const base::ListValue& routes = prefs()->GetList(p::kSpaceRoutes);
+  ASSERT_EQ(1u, routes.size()) << "the route was lost";
+  EXPECT_EQ(here, *routes[0].GetDict().FindString("space"));
+  base::ListValue shared;
+  shared.Append(Route("github.com", there));
+  EXPECT_TRUE(OwnFileSays(p::kSpaceRoutes,
+                          sb::SettingJson(base::Value(std::move(shared)))));
+}
+
+// Sf60 (review finding): a browser-wide setting the person changed while this
+// profile was closed is stamped as an edit at its next launch, not put back.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest,
+                       ABrowserWideEditMadeWhileAwayIsKeptAndTravels) {
+  WritePeer(PeerState(base::Token::CreateRandom().ToString(), NowMs()), 1);
+  Join(sb::JoinParts());
+  ASSERT_TRUE(OwnFileSays(p::kSidebarDensity, "0"));
+  const base::FilePath folder = service()->folder();
+  prefs()->ClearPref(p::kSidebarSyncFolder);
+  // In another profile, with this one closed.
+  local_state()->SetInteger(p::kSidebarDensity, 2);
+  prefs()->SetFilePath(p::kSidebarSyncFolder, folder);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return service()->GetStatus().FindBool("ready").value_or(false);
+  }));
+  EXPECT_EQ(2, local_state()->GetInteger(p::kSidebarDensity));
+  ASSERT_TRUE(OwnFileSays(p::kSidebarDensity, "2"));
+  EXPECT_EQ(OwnInstall(), OwnSetting(p::kSidebarDensity)->s.w);
+}
+
+// Sf60 (review finding): a browser-wide value another profile's sync applies
+// is no edit here, whether this profile is open then or not, so two profiles
+// syncing with different computers do not trade it.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest,
+                       ABrowserWideValueAnotherProfilesSyncAppliedIsNoEdit) {
