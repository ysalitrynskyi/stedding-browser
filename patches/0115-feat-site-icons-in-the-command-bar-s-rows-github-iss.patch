+void CommandBarView::OnBeforePaste(
+    views::Textfield* sender,
+    base::OnceCallback<void(std::optional<std::u16string>)> callback) {
+  // commandbar K46 (bug hunt 2026-11-16): Cmd-L's bar stands in for the
+  // address bar and loads what it holds into the page, so a paste is cleaned
+  // as the address bar cleans one: a leading "javascript:" goes, and line
+  // breaks a mail or a terminal put in are taken out. A page that asked the
+  // user to paste a script there ran it in itself.
+  ui::Clipboard::GetForCurrentThread()->ReadText(
+      ui::ClipboardBuffer::kCopyPaste, /*data_dst=*/std::nullopt,
+      base::BindOnce(
+          [](base::OnceCallback<void(std::optional<std::u16string>)> callback,
+             std::u16string text) {
+            std::move(callback).Run(omnibox::SanitizeTextForPaste(text));
+          },
+          std::move(callback)));
+}
+
+views::View::DropCallback CommandBarView::CreateDropCallback(
+    const ui::DropTargetEvent& event) {
+  // Text dragged within the field moves as the field moves it.
+  if (!field_ || field_->HasTextBeingDragged()) {
+    return base::NullCallback();
+  }
+  return base::BindOnce(&CommandBarView::DropCleaned,
+                        weak_factory_.GetWeakPtr());
+}
+
+void CommandBarView::DropCleaned(
+    const ui::DropTargetEvent& event,
+    ui::mojom::DragOperation& output_drag_op,
+    std::unique_ptr<ui::LayerTreeOwner> drag_image_layer_owner) {
+  // K46: a drop from outside is cleaned as a paste is, and takes the whole
+  // field, as a drop on the address bar does.
+  const ui::OSExchangeData& data = event.data();
+  std::u16string text;
+  const std::vector<ui::ClipboardUrlInfo> urls =
+      data.GetURLs(ui::FilenameToURLPolicy::CONVERT_FILENAMES);
+  if (!urls.empty()) {
+    text = omnibox::StripJavascriptSchemas(
+        base::UTF8ToUTF16(urls.front().url.spec()));
+  } else if (const std::optional<std::u16string> dropped = data.GetString()) {
+    text = omnibox::StripJavascriptSchemas(
+        base::CollapseWhitespace(*dropped, /*trim_sequences_with_line_breaks=*/
+                                 true));
+  } else {
+    output_drag_op = ui::mojom::DragOperation::kNone;
+    return;
+  }
+  if (!field_) {
+    output_drag_op = ui::mojom::DragOperation::kNone;
+    return;
+  }
+  if (!field_->HasFocus()) {
+    field_->RequestFocus();
+  }
+  field_->SetText(text);
+  field_->SelectAll(/*reversed=*/false);
+  ContentsChanged(field_, text);
+  output_drag_op = ui::mojom::DragOperation::kCopy;
+}
