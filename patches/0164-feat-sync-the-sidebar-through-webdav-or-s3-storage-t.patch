+void SidebarSyncService::MakeBridge() {
+  if (bridge_) {
+    return;
+  }
+  PrefService* const prefs = profile_->GetPrefs();
+  const base::DictValue& value =
+      prefs->GetDict(stedding::prefs::kSidebarSyncPlace);
+  if (value.empty()) {
+    return;
+  }
+  std::optional<sidebar_sync::Place> place =
+      sidebar_sync::Place::FromValue(value);
+  if (!place) {
+    return;
+  }
+  bridge_ = std::make_unique<sidebar_sync::PlaceBridge>(
+      std::move(*place), PlaceFactory(), clock_, profile_->GetPath(),
+      write_runner_);
+  // A profile that moved keeps its place; its mirror moved with it.
