+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/clean_link.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// copy-link L2: every family in the table goes, and nothing else does.
+TEST(CleanLinkTest, StripsEachFamily) {
+  const char* const cases[][2] = {
+      {"https://a.test/p?utm_source=x&utm_medium=y&q=1", "https://a.test/p?q=1"},
+      {"https://a.test/p?UTM_Campaign=x&q=1", "https://a.test/p?q=1"},
+      {"https://a.test/p?fbclid=abc", "https://a.test/p"},
+      {"https://a.test/p?q=1&gclid=1&dclid=2&msclkid=3", "https://a.test/p?q=1"},
+      {"https://a.test/p?mc_eid=1&mc_cid=2&igshid=3&q=1", "https://a.test/p?q=1"},
+      {"https://a.test/p?_hsenc=1&_hsmi=2&mkt_tok=3&yclid=4&twclid=5&q=1",
+       "https://a.test/p?q=1"},
+      {"https://a.test/p?ref_src=twsrc", "https://a.test/p"},
+      {"https://www.youtube.com/watch?v=abc&si=track", "https://www.youtube.com/watch?v=abc"},
+      {"https://youtu.be/abc?si=track", "https://youtu.be/abc"},
+      {"https://a.test/p?a=1&fbclid=x#frag", "https://a.test/p?a=1#frag"},
+  };
+  for (const auto& [in, out] : cases) {
+    EXPECT_EQ(GURL(out), CleanLink(GURL(in))) << in;
+    EXPECT_TRUE(HasTrackingParameters(GURL(in))) << in;
+  }
+}
+
+// copy-link L2: unknown parameters keep their order and their encoding; the
+// YouTube share id is only tracking on YouTube.
+TEST(CleanLinkTest, KeepsUnknownParameters) {
+  const char* const same[] = {
+      "https://a.test/p?q=1&page=2",
+      "https://a.test/p?q=a%20b&r=%2F",
+      "https://a.test/p?si=keep",
+      "https://a.test/p?utm=notafamily",
+      "https://a.test/p",
+      "https://a.test/p?",
+  };
+  for (const char* url : same) {
+    EXPECT_EQ(GURL(url), CleanLink(GURL(url))) << url;
+    EXPECT_FALSE(HasTrackingParameters(GURL(url))) << url;
+  }
+  EXPECT_EQ(GURL("https://a.test/p?z=1&a=2"),
+            CleanLink(GURL("https://a.test/p?z=1&utm_x=1&a=2")));
+}
+
+}  // namespace
+}  // namespace stedding
