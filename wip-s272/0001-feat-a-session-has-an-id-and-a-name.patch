+// sessions S37 (ADR 0032): a session made with a name keeps it in the
+// sessions list, under an id that is a jar's token, and two Spaces can hold it.
+// Its name is chosen once: renaming a Space in it changes nothing.
+TEST(SpaceRegistryTest, ASessionHasAnIdAndANameChosenOnce) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceSessions);
+  SpaceRegistry registry(&prefs);
+  const SpaceId mail = registry.Add("Mail", SK_ColorBLUE);
+  const SpaceId docs = registry.Add("Docs", SK_ColorGREEN);
+  registry.Add("Home", SK_ColorRED);
+
+  const std::string work = registry.AddSession("Work");
+  ASSERT_TRUE(base::Token::FromString(work)) << work;
+  EXPECT_TRUE(registry.HasSessionRow(work));
+  EXPECT_FALSE(registry.NamesJar(work)) << "no Space is in it yet";
+  registry.SetSession(mail, work);
+  registry.SetSession(docs, work);
+
+  EXPECT_EQ(work, registry.Find(mail)->profile_id);
+  EXPECT_TRUE(registry.Find(mail)->isolated);
+  EXPECT_EQ(work, registry.Find(docs)->profile_id);
+  EXPECT_TRUE(registry.NamesJar(work));
+  EXPECT_TRUE(registry.ANameOtherThan(mail, work));
+  ASSERT_EQ(1u, registry.Sessions().size());
+  EXPECT_EQ("Work", registry.Sessions()[0].name);
+  EXPECT_TRUE(registry.Sessions()[0].has_row);
+  EXPECT_THAT(registry.Sessions()[0].spaces, testing::ElementsAre(mail, docs));
+
+  registry.SetName(mail, "Letters");
+  EXPECT_EQ("Work", registry.FindSession(work)->name) << "chosen once";
+
+  // S7: Shared keeps the token, and the Space still names the jar.
+  registry.SetSession(docs, std::string());
+  EXPECT_FALSE(registry.Find(docs)->isolated);
+  EXPECT_EQ(work, registry.Find(docs)->profile_id);
+  EXPECT_THAT(registry.FindSession(work)->spaces,
+              testing::ElementsAre(mail, docs));
+}
+
+// sessions S37: a token with no row, which is every Independent session from
+// before this, is a session named after its Space, and nothing is written to
+// read it so. It follows the Space's name while it is that Space's alone. A
+// second Space joining writes the name down.
+TEST(SpaceRegistryTest, AnOldTokenIsASessionNamedAfterItsSpace) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceSessions);
+  base::ListValue old;
+  base::DictValue space;
+  const std::string token = base::Token::CreateRandom().ToString();
+  const SpaceId id = SpaceId::GenerateNew();
+  space.Set("id", id.ToString());
+  space.Set("name", "Work");
+  space.Set("profile", token);
+  space.Set("isolated", true);
+  old.Append(std::move(space));
+  prefs.SetList(stedding::prefs::kSpaceRegistry, std::move(old));
+
+  SpaceRegistry registry(&prefs);
+  ASSERT_EQ(1u, registry.Sessions().size());
+  EXPECT_EQ(token, registry.Sessions()[0].id);
+  EXPECT_EQ("Work", registry.Sessions()[0].name);
+  EXPECT_FALSE(registry.Sessions()[0].has_row);
+  EXPECT_TRUE(prefs.GetList(stedding::prefs::kSpaceSessions).empty())
+      << "nothing is migrated";
+
+  registry.SetName(id, "Office");
+  EXPECT_EQ("Office", registry.Sessions()[0].name);
+
+  const SpaceId joined = registry.Add("Mail", SK_ColorBLUE);
+  registry.SetSession(joined, token);
+  EXPECT_TRUE(registry.HasSessionRow(token));
+  registry.SetName(id, "Elsewhere");
+  EXPECT_EQ("Office", registry.FindSession(token)->name);
+}
+
+// sessions S37: what the list keeps is one line of text, not too long, and
+// never the name of another session.
+TEST(SpaceRegistryTest, ASessionNameIsTrimmedCappedAndUnique) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceSessions);
+  SpaceRegistry registry(&prefs);
+  const auto name_of = [&](const std::string& id) {
+    return registry.FindSession(id)->name;
+  };
+  EXPECT_EQ("Work", name_of(registry.AddSession("  Work\n")));
+  EXPECT_EQ("Work 2", name_of(registry.AddSession("Work")));
+  EXPECT_EQ("WORK 3", name_of(registry.AddSession("WORK")));
+  EXPECT_EQ("Session", name_of(registry.AddSession("   ")));
+  EXPECT_EQ(64u, name_of(registry.AddSession(std::string(100, 'x'))).size());
+  // A Space's own session holds its name as well.
+  const SpaceId home = registry.Add("Home", SK_ColorBLUE);
+  registry.EnsureIsolated(home);
+  EXPECT_EQ("Home 2", name_of(registry.AddSession("Home")));
+}
+
+// sessions S37: the sessions list survives a restart, and a row keeps the
+// name it has when one is asked for again (S50, S51). A row that is not a
+// session is left out.
+TEST(SpaceRegistryTest, ASessionRoundTrips) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceSessions);
+  const std::string other = base::Token::CreateRandom().ToString();
+  std::string work;
+  {
+    SpaceRegistry registry(&prefs);
+    registry.Add("Home", SK_ColorBLUE);
+    work = registry.AddSession("Work");
+    registry.EnsureSessionRow(other, "Other");
+    registry.EnsureSessionRow(other, "Renamed elsewhere");
+    registry.EnsureSessionRow("not-a-token", "Nothing");
+  }
+  SpaceRegistry again(&prefs);
+  EXPECT_EQ("Work", again.FindSession(work)->name);
+  EXPECT_EQ("Other", again.FindSession(other)->name);
+  EXPECT_FALSE(again.FindSession("not-a-token"));
+  EXPECT_EQ(2u, again.Sessions().size());
+  again.ForgetSession(other);
+  EXPECT_FALSE(again.HasSessionRow(other));
+  EXPECT_EQ(1u, SpaceRegistry(&prefs).Sessions().size());
+}
+
+// sessions S43: the last Space leaving a session leaves it with its name, its
+// own session's too, so it stays a choice and the collection keeps its jar.
+TEST(SpaceRegistryTest, TheLastSpaceLeavingKeepsTheSession) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceSessions);
+  SpaceRegistry registry(&prefs);
+  const SpaceId work = registry.Add("Work", SK_ColorBLUE);
+  registry.EnsureIsolated(work);
+  const std::string own = registry.Find(work)->profile_id;
+  const std::string personal = registry.AddSession("Personal");
+  ASSERT_FALSE(registry.HasSessionRow(own));
+
+  registry.SetSession(work, personal);
+  EXPECT_EQ(personal, registry.Find(work)->profile_id);
+  EXPECT_FALSE(registry.NamesJar(own));
+  ASSERT_TRUE(registry.FindSession(own));
+  EXPECT_EQ("Work", registry.FindSession(own)->name);
+  EXPECT_TRUE(registry.FindSession(own)->spaces.empty());
+  EXPECT_THAT(stedding::SpacePartitionNames(prefs),
+              testing::UnorderedElementsAre(own, personal));
+
+  registry.SetSession(work, own);
+  EXPECT_EQ(own, registry.Find(work)->profile_id);
+  EXPECT_TRUE(registry.Find(work)->isolated);
+}
+
 }  // namespace
 }  // namespace spaces
