+// tabs R7, folders F12 (the owner, 2026-10-22): a folder's header never looks
+// asleep. With every tab under it asleep, a nested folder's included -- as
+// every tab but the one on screen is after a relaunch -- its title and its
+// glyph keep the rows' text colour, and a row telling the header of its
+// sleep draws nothing. The header took the slept colour then, so every
+// folder looked grey after a relaunch.
+TEST_F(FolderRowsTest, AHeaderNeverLooksAsleep) {
+  tabs::TabInterface* const loose = OpenTab();
+  tabs::TabInterface* const inner_tab = OpenTab();
+  tabs::TabInterface* const outer_tab = OpenTab();
+  // The strip reads outer_tab, inner_tab, loose.
+  tabs::FolderTabCollection* const outer = tabs().AddToNewFolder({0, 1});
+  ASSERT_NE(nullptr, outer);
+  ASSERT_NE(nullptr,
+            tabs().AddToNewFolder({tabs().GetIndexOfTab(inner_tab)}));
+  Activate(loose);
+
+  std::unique_ptr<views::Widget> widget = MakeWidget();
+  views::View* const root =
+      widget->SetContentsView(std::make_unique<views::View>());
+  FolderView* const view = AddFolderView(*root, outer);
+  // Drawn in the window's colours, which it has now.
+  view->UpdateHeaderForTesting();
+  const ui::ColorProvider* const provider = widget->GetColorProvider();
+  ASSERT_TRUE(provider);
+  const SkColor text =
+      provider->GetColor(kColorTabForegroundInactiveFrameActive);
+  ASSERT_EQ(text, view->name_for_testing()->GetEnabledColor());
+  const size_t draws = view->look_draws_for_testing();
+
+  for (tabs::TabInterface* const tab : {outer_tab, inner_tab}) {
+    tab->GetContents()->SetWasDiscarded(true);
+  }
+  // The header redraws itself, as when its tabs fell asleep.
+  view->UpdateHeaderForTesting();
+  EXPECT_EQ(text, view->name_for_testing()->GetEnabledColor())
+      << "the title took the slept colour";
+  EXPECT_EQ(stedding::FolderGlyph(text, 15),
+            view->glyph_for_testing()->GetImageModel())
+      << "the glyph took the slept colour";
+  EXPECT_EQ(draws, view->look_draws_for_testing())
+      << "the tabs' sleep drew the header again";
+}
