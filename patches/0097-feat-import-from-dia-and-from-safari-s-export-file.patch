+// static
+ImportJobs& ImportJobs::For(Profile& profile) {
+  auto* jobs = static_cast<ImportJobs*>(profile.GetUserData(kImportJobsKey));
+  if (!jobs) {
+    std::unique_ptr<ImportJobs> made = base::WrapUnique(new ImportJobs(profile));
+    jobs = made.get();
+    profile.SetUserData(kImportJobsKey, std::move(made));
+  }
+  return *jobs;
