+// The page as a tab's would be -- its passwords, autofill, permissions,
+// extensions -- while no tab holds it. Chromium attaches these in TabFeatures,
+// which needs a tab, so a peek names the ones a page shows itself through;
+// when the peek becomes a tab, TabFeatures finds them in place and adds the
+// rest.
+void AttachPageHelpers(content::WebContents* page) {
+  CreateSessionServiceTabHelper(page);
+  zoom::ZoomController::CreateForWebContents(page);
+  infobars::ContentInfoBarManager::CreateForWebContents(page);
+
+  autofill::AutofillClientProvider& autofill_client_provider =
+      autofill::AutofillClientProviderFactory::GetForProfile(
+          Profile::FromBrowserContext(page->GetBrowserContext()));
+  autofill_client_provider.CreateClientForWebContents(page);
+  if (!autofill_client_provider.uses_platform_autofill()) {
+    ChromePasswordManagerClient::CreateForWebContents(page);
+  }
+
+  content_settings::PageSpecificContentSettings::CreateForWebContents(
+      page, std::make_unique<PageSpecificContentSettingsDelegate>(page));
+  permissions::PermissionRequestManager::CreateForWebContents(page);
+  permissions::PermissionRecoverySuccessRateTracker::CreateForWebContents(page);
+  extensions::TabHelper::CreateForWebContents(page);
+}
+
+// Every peek over a page that is open, or on its way out.
+std::vector<std::unique_ptr<PeekOverlay>>& Overlays() {
+  static base::NoDestructor<std::vector<std::unique_ptr<PeekOverlay>>>
+      overlays;
+  return *overlays;
+}
+
+// Lets `overlay` go, and its page unless a promotion took it. After
+// PeekOverlay::Destroy, from a call that is not the page's own.
+void Erase(PeekOverlay* overlay) {
+  std::erase_if(Overlays(),
+                [overlay](const auto& each) { return each.get() == overlay; });
+}
+
+// The size of the bar's icons, and the room a button takes.
+constexpr int kBarIconSize = 16;
+
+// P21: what is drawn round the card, outside it, so its edge shows on a page
+// as dark or as light as the card: a line of `ring_width` DIP and, for the
+// soft glow, a white halo. The card's own shadow is drawn under each.
+struct CardEdge {
+  SkColor ring = SK_ColorTRANSPARENT;
+  float ring_width = 0;
+  SkColor glow = SK_ColorTRANSPARENT;
+  int glow_blur = 0;
+};
+
+CardEdge CardEdgeFor(int choice, bool dark) {
+  CardEdge edge;
+  switch (choice) {
+    case prefs::kPeekEdgeNone:
+      break;
+    case prefs::kPeekEdgeSoftGlow:
+      edge.ring = dark ? SkColorSetA(SK_ColorWHITE, 0x40)
+                       : SkColorSetA(SK_ColorBLACK, 0x24);
+      edge.ring_width = 1;
+      edge.glow = SkColorSetA(SK_ColorWHITE, dark ? 0x73 : 0xA6);
+      edge.glow_blur = 22;
+      break;
+    default:
+      // The frosted rim, the default; also any value this build does not
+      // know.
+      edge.ring = SkColorSetA(SK_ColorWHITE, dark ? 0x2E : 0x99);
+      edge.ring_width = 5;
+      break;
+  }
+  return edge;
+}
+
+// What the peek's own keys do: Escape and Cmd-W close it, Cmd-O keeps the
+// page as a tab, Shift-Cmd-O in a split -- Ctrl on Windows -- as they do in
+// the small window (P7, P9, P15).
+ui::Accelerator CloseKey() {
+  return ui::Accelerator(ui::VKEY_W, ui::EF_PLATFORM_ACCELERATOR);
+}
+ui::Accelerator OpenAsTabKey() {
+  return ui::Accelerator(ui::VKEY_O, ui::EF_PLATFORM_ACCELERATOR);
+}
+ui::Accelerator OpenInSplitKey() {
+  return ui::Accelerator(ui::VKEY_O,
+                         ui::EF_PLATFORM_ACCELERATOR | ui::EF_SHIFT_DOWN);
+}
+
+// The peek's command for `key`, if it is one of the peek's own.
+std::optional<PeekCommand> CommandFor(const ui::Accelerator& key) {
+  if (key == ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE) || key == CloseKey()) {
+    return PeekCommand::kClose;
+  }
+  if (key == OpenAsTabKey()) {
+    return PeekCommand::kOpenAsTab;
+  }
+  if (key == OpenInSplitKey()) {
+    return PeekCommand::kOpenInSplit;
+  }
+  return std::nullopt;
+}
+
+// The tooltip of a bar button, with its key.
+std::u16string WithKey(int message_id, const ui::Accelerator& key) {
+  return base::StrCat({l10n_util::GetStringUTF16(message_id), u" (",
+                       key.GetShortcutText(), u")"});
+}
+
+// The peek's command, run after the press or key that asked for it has
+// returned: it takes the widget down, and the button that was pressed with
+// it.
+void RunSoon(base::WeakPtr<PeekOverlay> overlay, PeekCommand command) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<PeekOverlay> overlay,
+                        PeekCommand command) {
+                       if (!overlay) {
+                         return;
+                       }
+                       switch (command) {
+                         case PeekCommand::kOpenAsTab:
+                           overlay->Promote(/*split=*/false);
+                           break;
+                         case PeekCommand::kOpenInSplit:
+                           overlay->Promote(overlay->CanSplit());
+                           break;
+                         case PeekCommand::kClose:
+                           overlay->Close();
+                           break;
+                       }
+                     },
+                     overlay, command));
+}
