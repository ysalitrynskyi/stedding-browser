+// import I48, I49: a route goes to the Space its Arc Space became, and one
+// whose Space did not come across is counted with those left out. A second
+// import brings no route twice, and one the person removed stays removed.
+TEST_F(ArcSidebarImportWindowTest, ARuleWithNoSpaceIsLeftOutAndCounted) {
+  std::optional<ArcImportPlan> plan = ParseArcSidebar(kSidebar);
+  ASSERT_TRUE(plan.has_value());
+  const std::string arc_space = plan->spaces.front().arc_id;
+  plan->routes.push_back({.arc_id = "one",
+                          .match = Route::Match::kContains,
+                          .pattern = "one.example",
+                          .arc_space = arc_space});
+  plan->routes.push_back({.arc_id = "two",
+                          .match = Route::Match::kSite,
+                          .pattern = "two.example",
+                          .arc_space = arc_space});
+  plan->routes.push_back({.arc_id = "gone",
+                          .match = Route::Match::kContains,
+                          .pattern = "gone.example",
+                          .arc_space = "a-space-of-no-import"});
+  plan->routes_left_out = 2;
+  PrefService* const prefs = profile()->GetPrefs();
+  const ArcImportResult first =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(2u, first.routes);
+  EXPECT_EQ(3u, first.routes_left_out);
+  std::vector<Route> routes = ReadRoutes(prefs);
+  ASSERT_EQ(2u, routes.size());
+  EXPECT_EQ("one.example", routes[0].pattern);
+  SpaceModel* const model = SpaceModel::From(browser());
+  EXPECT_EQ(plan->spaces.front().title,
+            model
+                ->GetSpace(*SpaceId::FromOptionalToken(
+                    base::Token::FromString(routes[0].space)))
+                ->name());
+
+  ASSERT_TRUE(RemoveRouteEqualTo(prefs, routes[0]));
+  const ArcImportResult second =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(0u, second.routes);
+  routes = ReadRoutes(prefs);
+  ASSERT_EQ(1u, routes.size());
+  EXPECT_EQ("two.example", routes[0].pattern);
+}
