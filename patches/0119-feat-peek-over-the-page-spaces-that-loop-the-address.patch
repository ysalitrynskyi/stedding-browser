+gfx::Point PeekOverlay::GetDialogPosition(const gfx::Size& size) {
+  if (!view_) {
+    return gfx::Point();
+  }
+  views::WebView* const web_view = view_->web_view();
+  const gfx::Rect area =
+      web_view->ConvertRectToWidget(web_view->GetLocalBounds());
+  const int x = std::max(area.x(), area.CenterPoint().x() - size.width() / 2);
+  return gfx::Point(x, area.y());
+}
