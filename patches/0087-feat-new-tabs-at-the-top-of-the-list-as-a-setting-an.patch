+        })())"));
+  EXPECT_EQ("6 glyphs", content::EvalJs(page, R"(
+        (() => {
+          let glyphs = 0;
+          const back = () => document.querySelector('footer button.secondary');
+          while (!back().disabled) back().click();
+          for (let i = 0; i < 6; ++i) {
+            if (document.querySelector('main .heading .step-icon svg path')) {
+              ++glyphs;
+            }
+            const next = document.querySelector('footer button.primary');
+            if (next.textContent === 'Finish') break;
+            next.click();
+          }
+          return glyphs + ' glyphs';
+        })())"));
