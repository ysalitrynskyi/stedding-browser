+
+// docs/features/sidebar-file.md Sf58-Sf69 (ADR 0037): the two parts a sync
+// file may carry beside the sidebar, each a box of sync: Stedding's own
+// settings, with the routes, and the list of extensions installed from the
+// Chrome Web Store. Pure: no browser object, no preference service.
+//
+// Both live in the "stedding_sync" block under keys an older Stedding never
+// reads (ParseSyncFile reads the block's own fields, `records`, `lists` and
+// `aliases` alone), so a computer on an older version ignores them and its
+// sidebar still syncs (Sf69).
+namespace spaces::sidebar_sync {
+
+inline constexpr char kSettingsPartKey[] = "settings";
+inline constexpr char kExtensionsPartKey[] = "extensions";
+
+// A part holds at most this many entries; past it the part is not read.
+inline constexpr size_t kMaxPartEntries = 1000;
+// A setting's value, as JSON text, is at most this long.
+inline constexpr size_t kMaxSettingBytes = 64 * 1024;
+
+// ---------------------------------------------------------------------------
+// Settings (Sf58-Sf62).
+
+enum class SettingScope {
+  // The profile's preferences.
+  kProfile,
+  // The browser's own (local state), shared by every profile.
+  kBrowser,
+};
+
+enum class SettingShape {
+  // The value travels as it is.
+  kPlain,
+  // The id of a Space: it travels as the synced Space's shared id, and only
+  // when it names a synced Space (or none).
+  kSpace,
+  // The routes: each rule travels by the synced Space it names; a rule to a
+  // Space that is not synced stays here (Sf61).
+  kRoutes,
+};
+
+// One Stedding setting and whether it travels. Every Stedding preference is
+// in exactly one of the two lists (Sf59): `reason` is empty for one that
+// travels and says why for one that stays.
+struct SettingRule {
+  const char* path;
+  SettingScope scope;
+  SettingShape shape;
+  // Empty: the setting travels. Otherwise why it stays on this computer.
+  const char* stays_because;
+
+  bool synced() const { return !stays_because || !*stays_because; }
+};
+
+// The table, in the order of stedding_prefs.cc.
+base::span<const SettingRule> SettingRules();
+const SettingRule* FindSettingRule(std::string_view path);
+bool IsSyncedSetting(std::string_view path);
+
+// One setting's value, as canonical JSON text, and the time of its last
+// edit (Sf15's clock).
+struct SettingField {
+  std::string json;
+  Stamp s;
+
+  friend bool operator==(const SettingField&, const SettingField&) = default;
+};
+// By preference path.
+using Settings = std::map<std::string, SettingField>;
+
+// The canonical JSON text of `value`: the same value is the same text.
+std::string SettingJson(const base::Value& value);
+
+// {"<path>": [value, time, install], ...}.
+base::DictValue SettingsToValue(const Settings& settings);
+// Only settings this version syncs are read; another path, a value too long
+// or a bad stamp drops that entry alone. Nullopt when `value` is no dict or
+// holds more than kMaxPartEntries entries.
+std::optional<Settings> SettingsFromValue(const base::Value& value);
+
+// Sf60: per setting, the later stamp wins. The paths whose value changed in
+// `into`.
+std::vector<std::string> MergeSettings(Settings& into, const Settings& peer);
+
+// The latest time a setting carries.
+int64_t MaxTime(const Settings& settings);
+
+// Sf61: a Space here and its id among the synced ones. Only synced Spaces
+// are in either map.
+struct SpaceMap {
+  SpaceMap();
+  SpaceMap(const SpaceMap& other);
+  SpaceMap& operator=(const SpaceMap& other);
+  ~SpaceMap();
+
+  // This computer's Space id to the shared id.
+  std::map<std::string, std::string> to_shared;
+  // The shared id to this computer's.
+  std::map<std::string, std::string> to_local;
+  // The ledger's aliases, resolved: an id a setting was stamped with before a
+  // join's pair is read as the id the pair gave it (Sf61).
+  std::map<std::string, std::string> resolved;
+};
+
+// The value `local` travels as, or nullopt when it does not travel (a Space
+// setting that names a Space that is not synced).
+std::optional<base::Value> SettingToWire(const SettingRule& rule,
+                                         const base::Value& local,
+                                         const SpaceMap& spaces);
+// The value to set here for `wire`, given what is here now, or nullopt when
+// it cannot be applied (it names a Space this computer does not have). The
+// routes keep this computer's rules to Spaces that are not synced, after the
+// synced ones.
+std::optional<base::Value> SettingFromWire(const SettingRule& rule,
+                                           const base::Value& wire,
+                                           const base::Value& local,
+                                           const SpaceMap& spaces);
+
+// Sf61: every Space id the settings name, under its resolved alias, each
+// setting keeping its stamp, so a file names the shared id after a join's
+// pair as before it. True when something changed.
+bool CanonicalizeSettings(Settings& settings,
+                          const std::map<std::string, std::string>& resolved);
+
+// ---------------------------------------------------------------------------
+// Extensions (Sf63-Sf68).
+
+// An extension installed from the Chrome Web Store, by its id and name.
+struct ExtensionEntry {
+  std::string id;
+  std::string name;
+
+  friend bool operator==(const ExtensionEntry&,
+                         const ExtensionEntry&) = default;
+};
+
+// 32 characters a to p, as the Web Store's ids are.
+bool IsExtensionId(std::string_view id);
+
+// [{"id": ..., "name": ...}, ...], by id.
+base::ListValue ExtensionsToValue(const std::vector<ExtensionEntry>& list);
+// A bad entry is dropped alone; nullopt when `value` is no list or holds more
+// than kMaxPartEntries entries.
+std::optional<std::vector<ExtensionEntry>> ExtensionsFromValue(
+    const base::Value& value);
+
+// One extension another computer has and this one lacks.
+struct ExtensionOffer {
+  ExtensionOffer();
+  ExtensionOffer(const ExtensionOffer& other);
+  ExtensionOffer& operator=(const ExtensionOffer& other);
+  ~ExtensionOffer();
+
+  std::string id;
+  std::string name;
+  // The installs whose files list it.
+  std::vector<std::string> installs;
+
+  friend bool operator==(const ExtensionOffer&,
+                         const ExtensionOffer&) = default;
+};
+
+// "<install>/<extension id>": an offer declined from that computer.
+std::string DeclineKey(std::string_view install, std::string_view id);
+
+// Sf64-Sf66: what this computer offers, by id: each extension another
+// computer's list holds that is not installed here, was not uninstalled here
+// and was not declined from that computer.
+std::vector<ExtensionOffer> ExtensionOffers(
+    const std::map<std::string, std::vector<ExtensionEntry>>& peers,
+    const std::set<std::string>& installed_here,
+    const std::set<std::string>& declined,
+    const std::set<std::string>& uninstalled_here);
+
+// ---------------------------------------------------------------------------
+// The parts of one file.
+
+struct FileParts {
+  FileParts();
+  FileParts(const FileParts& other);
+  FileParts(FileParts&& other);
+  FileParts& operator=(const FileParts& other);
+  FileParts& operator=(FileParts&& other);
+  ~FileParts();
+
+  // Absent: that computer's box is off, or it runs an older Stedding.
+  std::optional<Settings> settings;
+  std::optional<std::vector<ExtensionEntry>> extensions;
+
+  friend bool operator==(const FileParts&, const FileParts&) = default;
+};
+
+// Adds the parts present to `block`, the file's "stedding_sync" block.
+void PartsToBlock(const FileParts& parts, base::DictValue& block);
+// The parts of `block`. A part that is not well formed is absent; it never
+// refuses the file (Sf69).
+FileParts PartsFromBlock(const base::DictValue& block);
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_PARTS_H_
