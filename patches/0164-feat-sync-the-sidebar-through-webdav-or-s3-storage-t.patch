+Place::Place() = default;
+Place::Place(const Place& other) = default;
+Place& Place::operator=(const Place& other) = default;
+Place::~Place() = default;
+
+bool Place::operator==(const Place& other) const {
+  return kind == other.kind && address == other.address &&
+         region == other.region && bucket == other.bucket &&
+         path == other.path;
+}
+
+base::DictValue Place::ToValue() const {
+  base::DictValue value;
+  value.Set("kind", PlaceKindName(kind));
+  value.Set("address", address.spec());
+  if (kind == PlaceKind::kS3) {
+    value.Set("region", region);
+    value.Set("bucket", bucket);
+    value.Set("path", path);
+  }
+  return value;
+}
+
+// static
+std::optional<Place> Place::FromValue(const base::DictValue& value) {
+  const std::string* const kind = value.FindString("kind");
+  const std::string* const address = value.FindString("address");
+  if (!kind || !address) {
+    return std::nullopt;
+  }
+  Place place;
+  const AddressCheck check = CheckAddress(*address, &place.address);
+  if (check != AddressCheck::kEncrypted &&
+      check != AddressCheck::kUnencrypted) {
+    return std::nullopt;
+  }
+  if (*kind == kKindWebDav) {
+    return place;
+  }
+  if (*kind != kKindS3) {
+    return std::nullopt;
+  }
+  place.kind = PlaceKind::kS3;
+  place.region = Exact(value, "region");
+  place.bucket = Exact(value, "bucket");
+  place.path = Exact(value, "path");
+  if (!IsRegionName(place.region) || !IsBucketName(place.bucket) ||
+      !CleanPath(place.path)) {
+    return std::nullopt;
+  }
+  return place;
+}
+
+std::string Place::Label() const {
+  if (kind == PlaceKind::kS3) {
+    std::string label = base::StrCat({HostAndPort(address), "/", bucket});
+    if (!path.empty()) {
+      base::StrAppend(&label, {"/", path});
+    }
+    return label;
+  }
+  // A label is text; a path that does not decode to any stays escaped.
+  std::string decoded = base::UnescapeBinaryURLComponent(address.path());
+  if (!base::IsStringUTF8(decoded)) {
+    decoded = address.path();
+  }
+  std::string label = HostAndPort(address) + decoded;
+  if (label.size() > 1 && label.back() == '/') {
+    label.pop_back();
+  }
+  return label;
+}
