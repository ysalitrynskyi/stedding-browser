diff --git a/chrome/browser/ui/spaces/space_registry.cc b/chrome/browser/ui/spaces/space_registry.cc
new file mode 100644
index 0000000000000..8d216273c8413
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_registry.cc
@@ -0,0 +1,175 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_registry.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/token.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_service.h"
+
+namespace spaces {
+
+RegistryEntry::RegistryEntry(SpaceId id, std::string name, SkColor color)
+    : id(id), name(std::move(name)), color(color) {}
+RegistryEntry::RegistryEntry(const RegistryEntry& other) = default;
+RegistryEntry& RegistryEntry::operator=(const RegistryEntry& other) = default;
+RegistryEntry::~RegistryEntry() = default;
+
+SpaceRegistry::SpaceRegistry(PrefService* prefs) : prefs_(prefs) {
+  if (prefs_) {
+    entries_ = FromValue(prefs_->GetList(stedding::prefs::kSpaceRegistry));
+  }
+}
+
+SpaceRegistry::~SpaceRegistry() = default;
+
+const RegistryEntry* SpaceRegistry::Find(const SpaceId& id) const {
+  const auto it = std::ranges::find_if(
+      entries_, [&](const RegistryEntry& entry) { return entry.id == id; });
+  return it == entries_.end() ? nullptr : &*it;
+}
+
+RegistryEntry* SpaceRegistry::FindMutable(const SpaceId& id) {
+  const auto it = std::ranges::find_if(
+      entries_, [&](const RegistryEntry& entry) { return entry.id == id; });
+  return it == entries_.end() ? nullptr : &*it;
+}
+
+SpaceId SpaceRegistry::Add(std::string name, SkColor color) {
+  const SpaceId id = SpaceId::GenerateNew();
+  entries_.emplace_back(id, std::move(name), color);
+  Changed();
+  return id;
+}
+
+void SpaceRegistry::AddExisting(const RegistryEntry& entry) {
+  if (Find(entry.id)) {
+    return;
+  }
+  entries_.push_back(entry);
+  Changed();
+}
+
+bool SpaceRegistry::Remove(const SpaceId& id) {
+  if (entries_.size() <= 1u || !Find(id)) {
+    return false;
+  }
+  std::erase_if(entries_,
+                [&](const RegistryEntry& entry) { return entry.id == id; });
+  Changed();
+  return true;
+}
+
+bool SpaceRegistry::Move(const SpaceId& id, int delta) {
+  const auto it = std::ranges::find_if(
+      entries_, [&](const RegistryEntry& entry) { return entry.id == id; });
+  if (it == entries_.end() || delta == 0) {
+    return false;
+  }
+  const int from = static_cast<int>(it - entries_.begin());
+  const int to =
+      std::clamp(from + delta, 0, static_cast<int>(entries_.size()) - 1);
+  if (to == from) {
+    return false;
+  }
+  RegistryEntry entry = *it;
+  entries_.erase(it);
+  entries_.insert(entries_.begin() + to, std::move(entry));
+  Changed();
+  return true;
+}
+
+void SpaceRegistry::SetName(const SpaceId& id, std::string name) {
+  if (RegistryEntry* const entry = FindMutable(id)) {
+    entry->name = std::move(name);
+    Changed();
+  }
+}
+
+void SpaceRegistry::SetIcon(const SpaceId& id, std::string icon) {
+  if (RegistryEntry* const entry = FindMutable(id)) {
+    entry->icon = std::move(icon);
+    Changed();
+  }
+}
+
+void SpaceRegistry::SetColor(const SpaceId& id, SkColor color, bool chosen) {
+  if (RegistryEntry* const entry = FindMutable(id)) {
+    entry->color = color;
+    entry->color_chosen = chosen;
+    Changed();
+  }
+}
+
+void SpaceRegistry::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SpaceRegistry::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SpaceRegistry::Changed() {
+  if (prefs_) {
+    prefs_->SetList(stedding::prefs::kSpaceRegistry, ToValue(entries_));
+  }
+  observers_.Notify(&Observer::OnRegistryChanged);
+}
+
+// static
+base::ListValue SpaceRegistry::ToValue(
+    const std::vector<RegistryEntry>& entries) {
+  base::ListValue list;
+  for (const RegistryEntry& entry : entries) {
+    base::DictValue dict;
+    dict.Set("id", entry.id.ToString());
+    dict.Set("name", entry.name);
+    dict.Set("icon", entry.icon);
+    dict.Set("color", static_cast<int>(entry.color));
+    dict.Set("color_chosen", entry.color_chosen);
+    dict.Set("profile", entry.profile_id);
+    list.Append(std::move(dict));
+  }
+  return list;
+}
+
+// static
+std::vector<RegistryEntry> SpaceRegistry::FromValue(
+    const base::ListValue& value) {
+  std::vector<RegistryEntry> entries;
+  for (const base::Value& item : value) {
+    const base::DictValue* const dict = item.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* const id_text = dict->FindString("id");
+    const std::optional<base::Token> token =
+        id_text ? base::Token::FromString(*id_text) : std::nullopt;
+    if (!token) {
+      continue;
+    }
+    const std::string* const name = dict->FindString("name");
+    RegistryEntry entry(
+        SpaceId::FromRawToken(*token), name ? *name : std::string(),
+        static_cast<SkColor>(dict->FindInt("color").value_or(0)));
+    if (const std::string* const icon = dict->FindString("icon")) {
+      entry.icon = *icon;
+    }
+    entry.color_chosen = dict->FindBool("color_chosen").value_or(false);
+    if (const std::string* const profile = dict->FindString("profile")) {
+      entry.profile_id = *profile;
+    }
+    if (std::ranges::none_of(entries, [&](const RegistryEntry& existing) {
+          return existing.id == entry.id;
+        })) {
+      entries.push_back(std::move(entry));
+    }
+  }
+  return entries;
+}
+
+}  // namespace spaces
