+  const gfx::Point to(chips[1].first.x() + 2, chips[1].first.y());
+
+  const gfx::Point from = chips[2].first;
+  SendMouse(ui::EventType::kMousePressed, from);
+  for (int step = 1; step <= 8; ++step) {
+    SendMouse(ui::EventType::kMouseDragged,
+              gfx::Point(from.x() + (to.x() - from.x()) * step / 8,
+                         from.y() + (to.y() - from.y()) * step / 8));
+  }
+  EXPECT_EQ(chips[2].first, second->GetBoundsInScreen().CenterPoint())
+      << "the chip passed steps into the dragged chip's place";
+  EXPECT_NEAR(to.x(), third->GetBoundsInScreen().CenterPoint().x(), 1)
+      << "the dragged chip follows the pointer";
+  EXPECT_EQ(ids_, Order()) << "nothing moves before the drop";
+  SendMouse(ui::EventType::kMouseReleased, to);
+  const std::vector<spaces::SpaceId> expected = {ids_[0], ids_[2], ids_[1]};
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Order() == expected; }));
