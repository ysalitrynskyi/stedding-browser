+// little E7: the ways from a little window into the main window. Each moves
+// the page as it is -- the same WebContents, its history, nothing loaded
+// again -- into the active Space of the last-active normal window, or of a
+// new one when none is open, and the little window closes. Never the Open
+// File dialog.
+class LittleWindowPromoteTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // Any Open File dialog is a fake, and is counted.
+    ui::FakeSelectFileDialog::Factory* const dialogs =
+        ui::FakeSelectFileDialog::RegisterFactory();
+    dialogs->SetOpenCallback(
+        base::BindLambdaForTesting([this]() { ++file_dialogs_; }));
+    profile_ = browser()->GetProfile();
+  }
+
+  void TearDownOnMainThread() override {
+    // The page goes with the windows, after this.
+    page_ = nullptr;
+    little_ = nullptr;
+    profile_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  // A little window as a link from another app opens one, its page walked on
+  // to a second address so it has history, and marked from script: a reload
+  // would lose the mark.
+  void OpenLittle() {
+    little_ = stedding::OpenLittleWindow(
+        profile_, embedded_test_server()->GetURL("/title1.html"),
+        /*anchor=*/nullptr, /*untrusted_launch=*/false);
+    ASSERT_TRUE(little_);
+    ASSERT_TRUE(stedding::IsLittleWindow(little_));
+    page_ = little_->GetTabStripModel()->GetActiveWebContents();
+    ASSERT_TRUE(page_);
+    ASSERT_TRUE(content::WaitForLoadStop(page_));
+    ASSERT_TRUE(content::NavigateToURL(
+        page_, embedded_test_server()->GetURL("/title2.html")));
+    ASSERT_TRUE(content::ExecJs(page_, "window.kept = 'yes';"));
+    entry_id_ = page_->GetController().GetLastCommittedEntry()->GetUniqueID();
+  }
+
+  // Closes every normal window, so a little window is all that is open.
+  void CloseNormalWindows() {
+    while (BrowserWindowInterface* const window =
+               stedding::LastActiveNormalWindow(profile_)) {
+      CloseBrowserSynchronously(window);
+    }
+  }
+
+  static bool LittleWindowOpen() {
+    bool found = false;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* window) {
+          found = stedding::IsLittleWindow(window);
+          return !found;
+        });
+    return found;
+  }
+
+  // The page is the active tab of `window`, in its active Space, as it was;
+  // the little window is gone.
+  void ExpectMovedInto(BrowserWindowInterface* window) {
+    ASSERT_TRUE(window);
+    EXPECT_EQ(BrowserWindowInterface::Type::TYPE_NORMAL, window->GetType());
+    EXPECT_EQ(page_.get(), window->GetTabStripModel()->GetActiveWebContents())
+        << "the same WebContents";
+    EXPECT_EQ("yes", content::EvalJs(page_, "window.kept"))
+        << "the page was not loaded again";
+    content::NavigationController& history = page_->GetController();
+    EXPECT_EQ(2, history.GetEntryCount()) << "its history came with it";
+    EXPECT_EQ(1, history.GetLastCommittedEntryIndex());
+    EXPECT_TRUE(history.CanGoBack());
+    EXPECT_EQ(entry_id_, history.GetLastCommittedEntry()->GetUniqueID())
+        << "no new navigation";
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+    ASSERT_TRUE(model);
+    EXPECT_EQ(model->active_id(),
+              model->SpaceForTab(window->GetTabStripModel()->GetActiveTab()))
+        << "in the Space on screen";
+    EXPECT_TRUE(base::test::RunUntil([]() { return !LittleWindowOpen(); }))
+        << "the little window closed";
+    EXPECT_EQ(0, file_dialogs_) << "never the Open File dialog";
+  }
+
+  // The window that took the page when none was open.
+  BrowserWindowInterface* NewNormalWindow() {
+    BrowserWindowInterface* window = nullptr;
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      window = stedding::LastActiveNormalWindow(profile_);
