+// A made-up StorableLinkRouting.json, in Arc's shape (import I48, I49): one
+// rule to a Space, with three sources, then each kind that stays out.
+constexpr char kRouting[] = R"json({
+  "version": 1,
+  "defaultDestination": {"littleArc": {"_0": {"mostRecent": {}}}},
+  "rules": [
+    {
+      "id": "rule-work",
+      "destination": {"space": {"_0": {"space": {"_0": "space-work"}}}},
+      "sourceComponents": [
+        {"id": "from-text", "componentType": {"urlMatch": {
+          "_0": {"contains": {}}, "_1": "figma.example"}}},
+        {"id": "from-host", "componentType": {"urlMatch": {
+          "_0": {"matches": {}}, "_1": "Mail.example"}}},
+        {"id": "from-page", "componentType": {"urlMatch": {
+          "_0": {"matches": {}}, "_1": "https://docs.example/a"}}}
+      ]
+    },
+    {
+      "id": "rule-last-space",
+      "destination": {"space": {"_0": {"mostRecent": {}}}},
+      "sourceComponents": [{"id": "last-space", "componentType": {"urlMatch": {
+        "_0": {"contains": {}}, "_1": "meet.example"}}}]
+    },
+    {
+      "id": "rule-little",
+      "destination": {"littleArc": {"_0": {"mostRecent": {}}}},
+      "sourceComponents": [{"id": "little", "componentType": {"urlMatch": {
+        "_0": {"contains": {}}, "_1": "small.example"}}}]
+    },
+    {
+      "id": "rule-profile",
+      "destination": {"space": {"_0": {"profile": {"_0": {"default": true}}}}},
+      "sourceComponents": [{"id": "profile", "componentType": {"urlMatch": {
