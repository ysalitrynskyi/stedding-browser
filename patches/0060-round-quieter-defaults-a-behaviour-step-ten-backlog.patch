+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/base/models/dialog_model_field.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+DEFINE_LOCAL_ELEMENT_IDENTIFIER_VALUE(kPinHomeFieldId);
+
+// What the field starts with (pins H15): the pin's home, or for a pin without
+// one the page it shows when that is a web page, else nothing.
+std::u16string InitialText(tabs::TabInterface* tab) {
+  const GURL start = PinnedSiteFor(tab->GetBrowserWindowInterface(), tab);
+  return IsAllowedPinHome(start) ? base::UTF8ToUTF16(start.spec())
+                                 : std::u16string();
+}
+
+// Save. Returns whether the dialog closes: not while the text names no web
+// page (H15), so nothing changes and the person can correct it. A tab closed
+// meanwhile, or no longer a pin, closes the dialog with nothing loaded.
+bool Save(base::WeakPtr<tabs::TabInterface> tab, ui::DialogModel* model) {
+  if (!tab) {
+    return true;
+  }
+  const std::optional<GURL> home = PinHomeFromTyped(
+      model->GetTextfieldByUniqueId(kPinHomeFieldId)->text());
+  if (!home) {
+    return false;
+  }
+  SetHomeAndGo(tab->GetBrowserWindowInterface(), tab.get(), *home);
+  return true;
+}
+
+std::unique_ptr<ui::DialogModel> CreateModel(tabs::TabInterface* tab) {
+  ui::DialogModel::Builder builder;
+  // Keeps the dialog open while Save refuses the text.
+  base::RepeatingCallback<bool()> save = base::BindRepeating(
+      &Save, tab->GetWeakPtr(), base::Unretained(builder.model()));
+  return builder.SetInternalName("SteddingPinHomeDialog")
+      .SetTitle(l10n_util::GetStringUTF16(IDS_STEDDING_EDIT_HOME_TITLE))
+      .AddParagraph(ui::DialogModelLabel(IDS_STEDDING_EDIT_HOME_BODY))
+      .AddTextfield(kPinHomeFieldId, std::u16string(), InitialText(tab),
+                    ui::DialogModelTextfield::Params().SetAccessibleName(
+                        l10n_util::GetStringUTF16(
+                            IDS_STEDDING_EDIT_HOME_FIELD)))
+      .AddOkButton(std::move(save),
+                   ui::DialogModel::Button::Params().SetLabel(
+                       l10n_util::GetStringUTF16(IDS_STEDDING_EDIT_HOME_SAVE)))
+      .AddCancelButton(base::DoNothing())
+      .SetInitiallyFocusedField(kPinHomeFieldId)
+      .Build();
+}
+
+}  // namespace
+
+void ShowPinHomeDialog(BrowserWindowInterface* browser,
+                       tabs::TabInterface* tab) {
+  if (!browser || !tab || !browser->GetWindow()) {
+    return;
+  }
+  chrome::ShowBrowserModal(browser, CreateModel(tab));
+}
+
+std::unique_ptr<ui::DialogModel> CreatePinHomeDialogModelForTesting(
+    tabs::TabInterface* tab) {
+  return CreateModel(tab);
+}
+
+}  // namespace stedding
