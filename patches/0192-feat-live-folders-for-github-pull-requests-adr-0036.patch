+
+// The setup's keys (kGitHubFolderPref).
+constexpr char kOn[] = "on";
+constexpr char kSpace[] = "space";
+constexpr char kFolder[] = "folder";
+constexpr char kDismissed[] = "dismissed";
+constexpr char kRefreshed[] = "refreshed";
+constexpr char kFailure[] = "failure";
+
+// Lf5: the folder's name until the person renames it, as Arc's was.
+constexpr char kFolderTitle[] = "Pull Requests";
+// Lf5: the one row of an empty list.
+constexpr char kNoneRow[] = "none";
+constexpr char16_t kNoneRowName[] = u"No open pull requests";
+
+constexpr base::TimeDelta kRequestTimeout = base::Seconds(30);
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("stedding_live_folder_github", R"(
+        semantics {
+          sender: "Stedding live folder"
+          description:
+            "Asks GitHub's API for the open pull requests the user opened, "
+            "is assigned, is asked to review or is mentioned in, to list them "
+            "in a folder of the sidebar."
+          trigger:
+            "The user makes the live folder in Settings; then every 10 "
+            "minutes while a window is open, when a window comes to the "
+            "front, and on Refresh, never more than once a minute."
+          data:
+            "The read-only token the user made on github.com, in the "
+            "Authorization header. No cookies, no browsing data."
+          destination: OTHER
+          destination_other: "api.github.com"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Off until the user makes a live folder. Deleting the folder, "
+            "from its menu or from Settings > Stedding, stops it and forgets "
+            "the token."
+          policy_exception_justification: "No policy controls this."
+        })");
+
+scoped_refptr<network::SharedURLLoaderFactory>& FactoryForTesting() {
+  static base::NoDestructor<scoped_refptr<network::SharedURLLoaderFactory>>
+      factory;
+  return *factory;
+}
+
+std::string RowId(const std::string& node_id) {
+  return base::StrCat({kRowTokenPrefix, node_id});
+}
+
+// Lf8: how long after the person takes the folder out of the run its rows
+// leaving the store count as the folder going.
+constexpr base::TimeDelta kFolderGoingWindow = base::Seconds(10);
+// Lf5: the most removed rows remembered.
+constexpr size_t kMaxDismissed = 500;
+
+// The id of the outermost folder `tab` is in, or empty.
+std::string OutermostFolderId(const tabs::TabInterface* tab) {
+  std::string id;
+  for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+       each = each->GetParentCollection()) {
+    if (each->type() == tabs::TabCollection::Type::FOLDER) {
+      id = static_cast<const tabs::FolderTabCollection*>(each)->id().ToString();
+    }
+  }
+  return id;
+}
+
+// Whether `tab` has no page loaded: discarded, or never shown.
+bool Asleep(tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab->GetContents();
+  return contents &&
+         (contents->WasDiscarded() || contents->GetController().NeedsReload());
+}
+
+std::optional<spaces::SpaceId> SpaceFromString(const std::string& text) {
+  const std::optional<base::Token> token = base::Token::FromString(text);
+  if (!token || token->is_zero()) {
+    return std::nullopt;
+  }
+  return spaces::SpaceId::FromRawToken(*token);
+}
+
+}  // namespace
+
+// Lf3: one refresh's four searches.
+struct LiveFolderService::Fetch {
+  std::vector<std::unique_ptr<network::SimpleURLLoader>> loaders;
+  std::vector<std::vector<PullRequest>> answers;
+  size_t pending = 0;
+  Failure failure = Failure::kNone;
+  bool complete = true;
+  FetchDone done;
+};
+
+LiveFolderService::LiveFolderService(Profile* profile,
+                                     spaces::PinStore* store)
+    : profile_(profile),
+      store_(store),
+      scheduler_(base::BindRepeating(&LiveFolderService::Refresh,
+                                     base::Unretained(this)),
+                 base::BindRepeating(&LiveFolderService::HasWindow,
+                                     base::Unretained(this))) {
+  Load();
+  if (!on_) {
+    return;
+  }
+  if (store_) {
+    store_observation_.Observe(store_.get());
+    const std::vector<std::string> ids = LiveIdsInStore();
+    live_ids_ = std::set<std::string>(ids.begin(), ids.end());
+  }
+  browsers_observation_.Observe(GlobalBrowserCollection::GetInstance());
+  InstallCommandHandler();
+  UpdateNote();
+  // Lf2: the token is opened once, with the system's key store.
+  g_browser_process->os_crypt_async()->GetInstance(
+      base::BindOnce(&LiveFolderService::OnEncryptorToRead,
+                     weak_factory_.GetWeakPtr(), generation_));
+}
+
+LiveFolderService::~LiveFolderService() = default;
+
+// static
+void LiveFolderService::SetURLLoaderFactoryForTesting(
+    scoped_refptr<network::SharedURLLoaderFactory> factory) {
+  FactoryForTesting() = std::move(factory);
+}
+
+void LiveFolderService::Shutdown() {
+  ++generation_;
+  fetch_.reset();
+  scheduler_.Stop();
+  browsers_observation_.Reset();
+  store_observation_.Reset();
+  SetCommandHandler(profile_, CommandHandler());
+  SetNote(profile_, std::string(), std::nullopt);
+}
+
+void LiveFolderService::Load() {
+  const base::DictValue& setup =
+      profile_->GetPrefs()->GetDict(kGitHubFolderPref);
+  const std::string* const folder = setup.FindString(kFolder);
+  const std::string* const space = setup.FindString(kSpace);
+  const std::optional<spaces::SpaceId> space_id =
+      space ? SpaceFromString(*space) : std::nullopt;
+  if (!setup.FindBool(kOn).value_or(false) || !folder || folder->empty() ||
+      !space_id) {
+    return;
+  }
+  on_ = true;
+  folder_id_ = *folder;
+  space_ = *space_id;
+  if (const base::ListValue* const dismissed = setup.FindList(kDismissed)) {
+    for (const base::Value& id : *dismissed) {
+      if (id.is_string()) {
+        Dismiss(id.GetString());
+      }
+    }
+  }
+  refreshed_ = base::ValueToTime(setup.Find(kRefreshed)).value_or(base::Time());
+  const int failure = setup.FindInt(kFailure).value_or(0);
+  failure_ = failure >= 0 && failure <= static_cast<int>(Failure::kKeyStore)
+                 ? static_cast<Failure>(failure)
+                 : Failure::kNone;
+}
+
+void LiveFolderService::Save() {
+  PrefService* const prefs = profile_->GetPrefs();
+  if (!on_) {
+    prefs->ClearPref(kGitHubFolderPref);
+    prefs->ClearPref(kGitHubTokenPref);
+    return;
+  }
+  base::ListValue dismissed;
+  for (const std::string& id : dismissed_) {
+    dismissed.Append(id);
+  }
+  prefs->SetDict(kGitHubFolderPref,
+                 base::DictValue()
+                     .Set(kOn, true)
+                     .Set(kSpace, space_.ToString())
+                     .Set(kFolder, folder_id_)
+                     .Set(kDismissed, std::move(dismissed))
+                     .Set(kRefreshed, base::TimeToValue(refreshed_))
+                     .Set(kFailure, static_cast<int>(failure_)));
+}
+
+void LiveFolderService::OnEncryptorToRead(
+    int generation,
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  if (generation != generation_ || !on_ || !token_.empty()) {
+    return;
+  }
+  std::string sealed;
+  std::string token;
+  if (!base::Base64Decode(profile_->GetPrefs()->GetString(kGitHubTokenPref),
+                          &sealed) ||
+      !encryptor->DecryptString(sealed, &token) || !LooksLikeAToken(token)) {
+    // Lf2: a profile copied to another computer cannot open it; the folder
+    // keeps its last list and says so, until a token is pasted again
+    // (ReplaceToken).
+    token_lost_ = true;
+    failure_ = Failure::kToken;
+    UpdateNote();
+    Changed();
+    return;
+  }
+  token_ = std::move(token);
+  scheduler_.Start(/*ran_now=*/false);
+  // Lf4: a window already in front asks at once.
+  if (HasWindow()) {
+    scheduler_.Ask();
+  }
+}
+
+std::optional<spaces::SpaceId> LiveFolderService::ActiveSpace() const {
+  std::optional<spaces::SpaceId> space;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        if (window->GetProfile() != profile_ ||
+            window->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+          return true;
+        }
+        spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+        if (!model || !model->follows_registry()) {
+          return true;
+        }
+        space = model->active_id();
+        return false;
+      });
+  if (!space) {
+    if (const spaces::SpaceRegistry* const registry =
+            spaces::SpaceRegistryFactory::GetForProfile(profile_);
+        registry && !registry->entries().empty()) {
+      space = registry->entries().front().id;
+    }
+  }
+  return space;
+}
+
+bool LiveFolderService::SpaceExists(const spaces::SpaceId& space) const {
+  const spaces::SpaceRegistry* const registry =
+      spaces::SpaceRegistryFactory::GetForProfile(profile_);
+  return registry &&
+         std::ranges::any_of(registry->entries(),
+                             [&](const spaces::RegistryEntry& entry) {
+                               return entry.id == space;
+                             });
+}
+
+void LiveFolderService::MakeInActiveSpace(const std::string& token,
+                                          MadeCallback done) {
+  if (on_) {
+    ReplaceToken(token, std::move(done));
+    return;
+  }
+  const std::optional<spaces::SpaceId> space = ActiveSpace();
+  if (!space) {
+    std::move(done).Run(Failure::kServer);
+    return;
+  }
+  Make(token, *space, std::move(done));
+}
+
+void LiveFolderService::Make(const std::string& typed,
+                             const spaces::SpaceId& space,
+                             MadeCallback done) {
+  if (on_) {
+    ReplaceToken(typed, std::move(done));
+    return;
+  }
+  const std::string token(
+      base::TrimWhitespaceASCII(typed, base::TRIM_ALL));
+  if (making_) {
+    std::move(done).Run(Failure::kServer);
+    return;
+  }
+  // Lf1: nothing is asked of GitHub with what cannot be a token.
+  if (!LooksLikeAToken(token)) {
+    std::move(done).Run(Failure::kToken);
+    return;
+  }
+  making_ = true;
+  Changed();
+  StartFetch(token, base::BindOnce(&LiveFolderService::OnMadeFetch,
+                                   weak_factory_.GetWeakPtr(), generation_,
+                                   token, std::optional<spaces::SpaceId>(space),
+                                   std::move(done)));
+}
+
+void LiveFolderService::ReplaceToken(const std::string& typed,
+                                     MadeCallback done) {
+  const std::string token(
+      base::TrimWhitespaceASCII(typed, base::TRIM_ALL));
+  if (!on_ || making_) {
+    std::move(done).Run(Failure::kServer);
+    return;
+  }
+  if (!LooksLikeAToken(token)) {
+    std::move(done).Run(Failure::kToken);
+    return;
+  }
+  making_ = true;
+  Changed();
+  // The new token's first list stands in for any refresh under way.
+  StartFetch(token, base::BindOnce(&LiveFolderService::OnMadeFetch,
+                                   weak_factory_.GetWeakPtr(), generation_,
+                                   token, std::optional<spaces::SpaceId>(),
+                                   std::move(done)));
+}
+
+void LiveFolderService::OnMadeFetch(int generation,
+                                    std::string token,
+                                    std::optional<spaces::SpaceId> space,
+                                    MadeCallback done,
+                                    Failure failure,
+                                    std::vector<PullRequest> pulls,
+                                    bool complete) {
+  if (generation != generation_) {
+    std::move(done).Run(Failure::kServer);
+    return;
+  }
+  if (failure != Failure::kNone) {
+    making_ = false;
+    Changed();
+    std::move(done).Run(failure);
+    return;
+  }
+  g_browser_process->os_crypt_async()->GetInstance(base::BindOnce(
+      &LiveFolderService::OnEncryptorToMake, weak_factory_.GetWeakPtr(),
+      generation, std::move(token), space, std::move(pulls), complete,
+      std::move(done)));
+}
+
+void LiveFolderService::OnEncryptorToMake(
+    int generation,
+    std::string token,
+    std::optional<spaces::SpaceId> space,
+    std::vector<PullRequest> pulls,
+    bool complete,
+    MadeCallback done,
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  if (generation != generation_) {
+    std::move(done).Run(Failure::kServer);
+    return;
+  }
+  making_ = false;
+  // Lf2: sealed with the system's key store, or not kept, and no folder.
+  std::string sealed;
+  if (!encryptor->IsEncryptionAvailable() ||
+      !encryptor->EncryptString(token, &sealed)) {
+    Changed();
+    std::move(done).Run(Failure::kKeyStore);
+    return;
+  }
+  const bool replacing = !space.has_value();
+  if (replacing && !on_) {
+    // Deleted while the new token was being checked.
+    Changed();
+    std::move(done).Run(Failure::kServer);
+    return;
+  }
+  if (!replacing) {
+    // Lf1: the Space chosen may have been deleted during the request; the
+    // folder then goes to the Space on screen now.
+    if (!SpaceExists(*space)) {
+      space = ActiveSpace();
+    }
+    if (!space) {
+      Changed();
+      std::move(done).Run(Failure::kServer);
+      return;
+    }
+    on_ = true;
+    space_ = *space;
+    folder_id_ = base::Token::CreateRandom().ToString();
+    dismissed_.clear();
+    live_ids_.clear();
+    last_folder_path_.clear();
+    if (store_ && !store_observation_.IsObserving()) {
+      store_observation_.Observe(store_.get());
+    }
+    if (!browsers_observation_.IsObserving()) {
+      browsers_observation_.Observe(GlobalBrowserCollection::GetInstance());
+    }
+    InstallCommandHandler();
+  }
+  token_ = std::move(token);
+  token_lost_ = false;
+  failure_ = Failure::kNone;
+  refreshed_ = base::Time::Now();
+  profile_->GetPrefs()->SetString(kGitHubTokenPref,
+                                  base::Base64Encode(sealed));
+  last_pulls_ = pulls;
+  Apply(pulls, complete);
+  Save();
+  // Lf4: the refresh that made it counts as the first.
+  scheduler_.Stop();
+  scheduler_.Start(/*ran_now=*/true);
+  UpdateNote();
+  Changed();
+  std::move(done).Run(Failure::kNone);
+}
+
+void LiveFolderService::InstallCommandHandler() {
+  // Lf13: the folder header's Refresh and Delete rows, and Lf8's note that
+  // the folder itself is going.
+  SetCommandHandler(profile_,
+                    base::BindRepeating(
+                        [](base::WeakPtr<LiveFolderService> service,
+                           Command command) {
+                          if (!service) {
+                            return;
+                          }
+                          switch (command) {
+                            case Command::kRefresh:
+                              service->RefreshNow();
+                              break;
+                            case Command::kDelete:
+                              service->Delete();
+                              break;
+                            case Command::kFolderGoing:
+                              service->NoteFolderGoing();
+                              break;
+                          }
+                        },
+                        weak_factory_.GetWeakPtr()));
+}
+
+void LiveFolderService::RefreshNow() {
+  scheduler_.Ask();
+}
+
+void LiveFolderService::Delete() {
+  TurnOff(/*remove_rows=*/true);
+}
+
+void LiveFolderService::NoteFolderGoing() {
+  if (on_) {
+    folder_going_until_ = base::TimeTicks::Now() + kFolderGoingWindow;
+  }
+}
+
+bool LiveFolderService::Dismiss(const std::string& id) {
+  if (IsDismissed(id)) {
+    return false;
+  }
+  dismissed_.push_back(id);
+  // The newest are kept: an id forgotten here is of a row removed long ago.
+  if (dismissed_.size() > kMaxDismissed) {
+    dismissed_.erase(dismissed_.begin(),
+                     dismissed_.begin() +
+                         static_cast<std::ptrdiff_t>(dismissed_.size() -
+                                                     kMaxDismissed));
+  }
+  return true;
+}
+
+bool LiveFolderService::IsDismissed(const std::string& id) const {
+  return std::ranges::find(dismissed_, id) != dismissed_.end();
+}
+
+bool LiveFolderService::FolderGoing() const {
+  return !folder_going_until_.is_null() &&
+         base::TimeTicks::Now() < folder_going_until_;
+}
+
+void LiveFolderService::TurnOff(bool remove_rows) {
+  ++generation_;
+  const bool was = on_ || making_;
+  fetch_.reset();
+  scheduler_.Stop();
+  if (remove_rows) {
+    RemoveRows();
+  }
+  on_ = false;
+  making_ = false;
+  token_.clear();
+  token_lost_ = false;
+  folder_id_.clear();
+  dismissed_.clear();
+  live_ids_.clear();
+  last_pulls_.clear();
+  last_folder_path_.clear();
+  waiting_list_.reset();
+  folder_going_until_ = base::TimeTicks();
+  failure_ = Failure::kNone;
+  refreshed_ = base::Time();
+  // Lf8: the token is forgotten with the setup, on disk at once: a crash
+  // right after must not bring it back.
+  Save();
+  profile_->GetPrefs()->CommitPendingWrite();
+  store_observation_.Reset();
+  browsers_observation_.Reset();
+  SetCommandHandler(profile_, CommandHandler());
+  SetNote(profile_, std::string(), std::nullopt);
+  // Lf8: what is left of the rows in any window, a turn later: asleep, it
+  // closes; open, it is the person's own tab.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&LiveFolderService::ReleaseLooseRows,
+                                weak_factory_.GetWeakPtr(),
+                                /*close_asleep=*/true));
+  if (was) {
+    Changed();
+  }
+}
+
+size_t LiveFolderService::rows() const {
+  if (!store_) {
+    return 0;
+  }
+  return static_cast<size_t>(std::ranges::count_if(
+      store_->records(), [](const spaces::PinRecord& record) {
+        return IsLiveRowToken(record.id) && record.id != RowId(kNoneRow);
+      }));
+}
+
+void LiveFolderService::OnBrowserActivated(BrowserWindowInterface* browser) {
+  // Lf4: a window of this profile coming to the front.
+  if (!on_ || token_.empty() || !browser ||
+      browser->GetProfile() != profile_ ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  scheduler_.Ask();
+}
+
+bool LiveFolderService::HasWindow() const {
+  bool any = false;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        any = window->GetProfile() == profile_ &&
+              window->GetType() == BrowserWindowInterface::TYPE_NORMAL;
+        return !any;
+      });
+  return any;
+}
+
+scoped_refptr<network::SharedURLLoaderFactory> LiveFolderService::Factory() {
+  if (FactoryForTesting()) {
+    return FactoryForTesting();
+  }
+  // Lf3: the browser's own network context, as sync's places use: no
+  // cookies, no cache shared with pages, and no extension sees it.
+  return g_browser_process->system_network_context_manager()
+      ->GetSharedURLLoaderFactory();
+}
+
+void LiveFolderService::StartFetch(const std::string& token,
+                                   FetchDone done) {
+  // One fetch at a time: a new one (a token being replaced) stands in for
+  // the one under way.
+  fetch_.reset();
+  scoped_refptr<network::SharedURLLoaderFactory> factory = Factory();
+  if (!factory) {
+    std::move(done).Run(Failure::kNetwork, {}, false);
+    return;
+  }
+  fetch_ = std::make_unique<Fetch>();
+  fetch_->done = std::move(done);
+  const std::vector<GURL> urls = SearchUrls();
+  fetch_->answers.resize(urls.size());
+  fetch_->pending = urls.size();
+  for (size_t i = 0; i < urls.size(); ++i) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = urls[i];
+    request->method = "GET";
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    SetRequestHeaders(token, &request->headers);
+    std::unique_ptr<network::SimpleURLLoader> loader =
+        network::SimpleURLLoader::Create(std::move(request),
+                                         kTrafficAnnotation);
+    loader->SetAllowHttpErrorResults(true);
+    loader->SetTimeoutDuration(kRequestTimeout);
+    // Lf3: the token goes to api.github.com alone, even when GitHub sends
+    // the request elsewhere.
+    loader->SetOnRedirectCallback(base::BindRepeating(
+        [](const GURL& url_before_redirect,
+           const net::RedirectInfo& redirect_info,
+           const network::mojom::URLResponseHead& response_head,
+           std::vector<std::string>* removed_headers) {
+          if (DropsAuthorizationOnRedirectTo(redirect_info.new_url)) {
+            removed_headers->push_back(
+                net::HttpRequestHeaders::kAuthorization);
+          }
+        }));
+    network::SimpleURLLoader* const raw = loader.get();
+    fetch_->loaders.push_back(std::move(loader));
+    raw->DownloadToString(
+        factory.get(),
+        base::BindOnce(&LiveFolderService::OnAnswer,
+                       weak_factory_.GetWeakPtr(), i),
+        kMaxAnswerBytes);
+  }
+}
+
+void LiveFolderService::OnAnswer(size_t index,
+                                 std::optional<std::string> body) {
+  if (!fetch_ || index >= fetch_->loaders.size()) {
+    return;
+  }
+  const network::SimpleURLLoader* const loader = fetch_->loaders[index].get();
+  const network::mojom::URLResponseHead* const head = loader->ResponseInfo();
+  const net::HttpResponseHeaders* const headers =
+      head ? head->headers.get() : nullptr;
+  Failure failure = FailureOf(loader->NetError(),
+                              headers ? headers->response_code() : 0, headers);
+  if (failure == Failure::kNone) {
+    bool complete = false;
+    std::optional<std::vector<PullRequest>> pulls =
+        body ? ParseSearchAnswer(*body, &complete) : std::nullopt;
+    if (pulls) {
+      fetch_->answers[index] = std::move(*pulls);
+      fetch_->complete &= complete;
+    } else {
+      failure = Failure::kServer;
+    }
+  }
+  // The first reason found is the one given.
+  if (fetch_->failure == Failure::kNone) {
+    fetch_->failure = failure;
+  }
+  if (--fetch_->pending > 0) {
+    return;
+  }
+  std::unique_ptr<Fetch> fetch = std::move(fetch_);
+  std::vector<PullRequest> merged;
+  bool complete = false;
+  if (fetch->failure == Failure::kNone) {
+    bool capped = false;
+    merged = MergeAnswers(fetch->answers, &capped);
+    complete = fetch->complete && !capped;
+  }
+  std::move(fetch->done).Run(fetch->failure, std::move(merged), complete);
+}
+
+void LiveFolderService::Refresh() {
+  if (!on_ || token_.empty() || fetch_ || making_) {
+    return;
+  }
+  StartFetch(token_, base::BindOnce(&LiveFolderService::OnRefreshed,
+                                    weak_factory_.GetWeakPtr(), generation_));
+}
+
+void LiveFolderService::OnRefreshed(int generation,
+                                    Failure failure,
+                                    std::vector<PullRequest> pulls,
+                                    bool complete) {
+  if (generation != generation_ || !on_) {
+    return;
+  }
+  failure_ = failure;
+  if (failure == Failure::kNone) {
+    refreshed_ = base::Time::Now();
+    last_pulls_ = pulls;
+    Apply(pulls, complete);
+  }
+  // Lf7: a failure keeps the last list as it is.
+  Save();
+  UpdateNote();
+  Changed();
+}
+
+std::vector<std::string> LiveFolderService::LiveIdsInStore() const {
+  std::vector<std::string> ids;
+  if (!store_) {
+    return ids;
+  }
+  for (const spaces::PinRecord& record : store_->records()) {
+    if (IsLiveRowToken(record.id)) {
+      ids.push_back(record.id);
+    }
+  }
+  return ids;
+}
+
+std::string LiveFolderService::FolderPath() const {
+  // The folder's name, icon and open or closed state, as the person left
+  // them, from a row already in it.
+  if (store_) {
+    for (const spaces::PinRecord& record : store_->records()) {
+      if (!IsLiveRowToken(record.id) || record.folder_path.empty()) {
+        continue;
+      }
+      const std::vector<stedding::FolderPathEntry> path =
+          stedding::ParseFolderPath(record.folder_path);
+      if (path.size() == 1 && path.front().id == folder_id_) {
+        return record.folder_path;
+      }
+    }
+  }
+  // The folder's path as its last row had it, when no row is left.
+  if (!last_folder_path_.empty()) {
+    const std::vector<stedding::FolderPathEntry> path =
+        stedding::ParseFolderPath(last_folder_path_);
+    if (path.size() == 1 && path.front().id == folder_id_) {
+      return last_folder_path_;
+    }
+  }
+  // As the session writes a folder's path (stedding_folder_session.cc), so
+  // a window's tab and its record read the same.
+  base::ListValue list;
+  list.Append(base::DictValue()
+                  .Set("i", folder_id_)
+                  .Set("t", kFolderTitle)
+                  .Set("c", false));
+  std::string path;
+  base::JSONWriter::Write(list, &path);
+  return path;
+}
+
+void LiveFolderService::Apply(const std::vector<PullRequest>& pulls,
+                              bool complete) {
+  if (!store_ || !on_) {
+    return;
+  }
+  if (!store_->ready()) {
+    waiting_list_ = pulls;
+    waiting_complete_ = complete;
+    return;
+  }
+  waiting_list_.reset();
+  // Lf5: a removed pull request that left GitHub's list is forgotten, but
+  // only when the list holds every match: one past the 50 rows, or in an
+  // answer GitHub cut short, is still open.
+  if (complete) {
+    std::set<std::string> open;
+    for (const PullRequest& pull : pulls) {
+      open.insert(RowId(pull.node_id));
+    }
+    std::erase_if(dismissed_,
+                  [&](const std::string& id) { return !open.contains(id); });
+  }
+
+  const std::string folder_path = FolderPath();
+  last_folder_path_ = folder_path;
+  std::vector<spaces::PinRecord> rows;
+  for (const PullRequest& pull : pulls) {
+    const std::string id = RowId(pull.node_id);
+    if (IsDismissed(id)) {
+      continue;
+    }
+    spaces::PinRecord row;
+    row.id = id;
+    row.tier = spaces::PinTier::kSpacePin;
+    row.space = space_;
+    row.has_space = true;
+    row.home = pull.url;
+    row.name = RowName(pull);
+    row.title = row.name;
+    row.folder_path = folder_path;
+    rows.push_back(std::move(row));
+  }
+  // A folder holds a row at least: an empty list, or one whose every row
+  // was removed, is one row that says so.
+  if (rows.empty()) {
+    spaces::PinRecord row;
+    row.id = RowId(kNoneRow);
+    row.tier = spaces::PinTier::kSpacePin;
+    row.space = space_;
+    row.has_space = true;
+    row.home = GURL(kPullsPage);
+    row.name = kNoneRowName;
+    row.title = row.name;
+    row.folder_path = folder_path;
+    rows.push_back(std::move(row));
+  }
+
+  // The rows take the place of the folder's rows in the store's order, or
+  // the end of it the first time.
+  std::vector<std::string> order;
+  std::set<std::string> fresh;
+  for (const spaces::PinRecord& row : rows) {
+    fresh.insert(row.id);
+  }
+  bool placed = false;
+  std::set<std::string> removed;
+  for (const spaces::PinRecord& record : store_->records()) {
+    if (!IsLiveRowToken(record.id)) {
+      order.push_back(record.id);
+      continue;
+    }
+    if (!fresh.contains(record.id)) {
+      removed.insert(record.id);
+    }
+    if (!placed) {
+      for (const spaces::PinRecord& row : rows) {
+        order.push_back(row.id);
+      }
+      placed = true;
+    }
+  }
+  if (!placed) {
+    for (const spaces::PinRecord& row : rows) {
+      order.push_back(row.id);
+    }
+  }
+  {
+    publishing_ = true;
+    store_->Publish(order, rows, removed);
+    publishing_ = false;
+  }
+  live_ids_ = fresh;
+}
+
+void LiveFolderService::ApplyLast() {
+  if (!on_ || !store_ || !store_->ready() || !LiveIdsInStore().empty()) {
+    return;
+  }
+  Apply(last_pulls_, /*complete=*/false);
+  Save();
+}
+
+void LiveFolderService::RemoveRows() {
+  if (!store_ || !store_->ready()) {
+    return;
+  }
+  const std::vector<std::string> ids = LiveIdsInStore();
+  if (ids.empty()) {
+    return;
+  }
+  std::vector<std::string> order;
+  for (const spaces::PinRecord& record : store_->records()) {
+    if (!IsLiveRowToken(record.id)) {
+      order.push_back(record.id);
+    }
+  }
+  publishing_ = true;
+  store_->Publish(order, {}, std::set<std::string>(ids.begin(), ids.end()));
+  publishing_ = false;
+}
+
+void LiveFolderService::ReleaseLooseRows(bool close_asleep) {
+  // Once the folder is off, its own release (close_asleep) decides; one asked
+  // for before it went would keep an asleep row that should close.
+  if (!close_asleep && !on_) {
+    return;
+  }
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        TabStripModel* const strip = window->GetTabStripModel();
+        if (window->GetProfile() != profile_ || !strip) {
+          return true;
+        }
+        const spaces::SpaceModel* const model =
+            spaces::SpaceModel::From(window);
+        for (int i = strip->count() - 1; i >= 0; --i) {
+          tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+          const std::string token = stedding::TabToken(tab->GetContents());
+          if (!IsLiveRowToken(token)) {
+            continue;
+          }
+          // A row of the folder that is on stays one.
+          const bool row = on_ && store_ && store_->Find(token) && model &&
+                           (model->IsSpacePinned(tab) || tab->IsPinned());
+          if (row) {
+            continue;
+          }
+          if (close_asleep && Asleep(tab) && strip->GetActiveTab() != tab) {
+            strip->CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+            continue;
+          }
+          stedding::SetTabToken(tab, stedding::NewTabToken());
+          // While the folder is on, a tab the person took out of it leaves
+          // it: the last row unpinned stays in its folder, which would then
+          // be no row of the run, and the folder's one row could not come
+          // back there.
+          if (on_ && OutermostFolderId(tab) == folder_id_) {
+            strip->MoveTabOutOfFolders(i);
+          }
+        }
+        return true;
+      });
+}
+
+void LiveFolderService::OnPinStoreChanged() {
+  if (publishing_ || !on_ || !store_) {
+    return;
+  }
+  if (waiting_list_ && store_->ready()) {
+    const std::vector<PullRequest> list = *waiting_list_;
+    Apply(list, waiting_complete_);
+    return;
+  }
+  const std::vector<std::string> ids = LiveIdsInStore();
+  const std::set<std::string> now(ids.begin(), ids.end());
+  std::set<std::string> gone;
+  for (const std::string& id : live_ids_) {
+    if (!now.contains(id)) {
+      gone.insert(id);
+    }
+  }
+  live_ids_ = now;
+  // The folder's name, icon and open or closed state as the person left
+  // them, for a row made when none is left.
+  if (const std::string path = FolderPath(); !now.empty()) {
+    last_folder_path_ = path;
+  }
+  if (!gone.empty() && FolderGoing()) {
+    // Lf8: the person took the folder itself out of the run (Unpin Folder,
+    // a drop below the Clear line or into a folder there, Close Folder's
+    // Tabs): it is deleted, a row that was outside it at the time included.
+    // A turn later, once every window has followed this change.
+    folder_going_until_ = base::TimeTicks();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<LiveFolderService> service) {
+              if (service && service->on_) {
+                service->TurnOff(/*remove_rows=*/true);
+              }
+            },
+            weak_factory_.GetWeakPtr()));
+    return;
+  }
+  bool save = false;
+  // Lf5: a row brought back is shown again; a row removed is not, while its
+  // pull request is open.
+  for (const std::string& id : now) {
+    save |= std::erase(dismissed_, id) > 0;
+  }
+  for (const std::string& id : gone) {
+    if (id != RowId(kNoneRow)) {
+      save |= Dismiss(id);
+    }
+  }
+  // Lf8: the folder moved to another Space, or its Space was deleted and its
+  // pins moved (windows G21): every row in the folder is in the other Space.
+  // One row moved alone goes back into the folder at the next refresh.
+  std::optional<spaces::SpaceId> moved_to;
+  bool all_moved = false;
+  for (const spaces::PinRecord& record : store_->records()) {
+    if (!IsLiveRowToken(record.id) || !record.has_space) {
+      continue;
+    }
+    const std::vector<stedding::FolderPathEntry> path =
+        stedding::ParseFolderPath(record.folder_path);
+    if (path.empty() || path.front().id != folder_id_) {
+      continue;
+    }
+    if (record.space == space_ ||
+        (moved_to && record.space != *moved_to)) {
+      all_moved = false;
+      break;
+    }
+    moved_to = record.space;
+    all_moved = true;
+  }
+  if (all_moved && moved_to) {
+    space_ = *moved_to;
+    save = true;
+  }
+  if (!gone.empty()) {
+    // Lf5: the tab of a row the person took out is theirs: a token of its
+    // own, so pinning it again makes no live row. A turn later, once every
+    // window has settled.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&LiveFolderService::ReleaseLooseRows,
+                                  weak_factory_.GetWeakPtr(),
+                                  /*close_asleep=*/false));
+  }
+  if (now.empty() && !gone.empty()) {
+    // Lf5: the last row went: the folder stays, with its one row.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&LiveFolderService::ApplyLast,
+                                  weak_factory_.GetWeakPtr()));
+  }
+  if (save) {
+    Save();
+    Changed();
+  }
+}
+
+std::u16string LiveFolderService::Tooltip() const {
+  std::u16string when;
+  if (!refreshed_.is_null()) {
+    when = base::StrCat(
+        {u"Refreshed at ", base::TimeFormatTimeOfDay(refreshed_), u"."});
+  }
+  if (failure_ == Failure::kNone) {
+    return base::StrCat({u"Your open pull requests on GitHub. ", when});
+  }
+  return base::StrCat({FailureText(failure_), u" ", when});
+}
+
+void LiveFolderService::UpdateNote() {
+  if (!on_) {
+    SetNote(profile_, std::string(), std::nullopt);
+    return;
+  }
+  FolderNote note;
+  note.failed = failure_ != Failure::kNone;
+  note.tooltip = std::u16string(
+      base::TrimWhitespace(Tooltip(), base::TRIM_TRAILING));
+  SetNote(profile_, folder_id_, std::move(note));
+}
+
+base::DictValue LiveFolderService::StateForSettings() const {
+  base::DictValue state;
+  state.Set("on", on_);
+  state.Set("making", making_);
+  state.Set("tokenPage", kTokenPage);
+  if (!on_) {
+    return state;
+  }
+  std::string space_name;
+  if (const spaces::SpaceRegistry* const registry =
+          spaces::SpaceRegistryFactory::GetForProfile(profile_)) {
+    for (const spaces::RegistryEntry& entry : registry->entries()) {
+      if (entry.id == space_) {
+        space_name = entry.name;
+      }
+    }
+  }
+  state.Set("space", space_name);
+  state.Set("rows", static_cast<int>(rows()));
+  state.Set("refreshed", refreshed_.is_null()
+                             ? std::u16string()
+                             : base::TimeFormatTimeOfDay(refreshed_));
+  state.Set("error", FailureText(failure_));
+  return state;
+}
+
+void LiveFolderService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void LiveFolderService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void LiveFolderService::Changed() {
+  for (Observer& observer : observers_) {
+    observer.OnLiveFolderChanged();
+  }
+}
