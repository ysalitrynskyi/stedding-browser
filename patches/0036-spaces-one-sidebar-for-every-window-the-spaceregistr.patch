+void SpaceModel::SyncWithRegistry(bool seed) {
+  if (!registry_) {
+    return;
+  }
+  if (seed) {
+    // What this window brought joins the registry, kept by id: the first
+    // window of a profile fills it with whatever it has; a later window adds
+    // only Spaces its session gave a name, an icon or a chosen colour, never
+    // the bare default Space every new window starts with.
+    const bool first = registry_->empty();
+    for (const std::unique_ptr<Space>& space : spaces_) {
+      if (!first && space->name().empty() && space->icon().empty() &&
+          !space->color_chosen()) {
+        continue;
+      }
+      RegistryEntry entry(space->id(), space->name(), space->color());
+      entry.icon = space->icon();
+      entry.color_chosen = space->color_chosen();
+      registry_->AddExisting(entry);
+    }
+  }
+  // Then the window is the registry: kept objects updated, new ones made,
+  // gone ones dropped with their tabs moved, all in the registry's order.
+  std::vector<std::unique_ptr<Space>> old = std::move(spaces_);
+  spaces_.clear();
+  std::vector<SpaceId> added;
+  std::vector<SpaceId> changed;
+  for (const RegistryEntry& entry : registry_->entries()) {
+    auto it = std::ranges::find_if(old, [&](const std::unique_ptr<Space>& s) {
+      return s && s->id() == entry.id;
+    });
+    if (it != old.end()) {
+      Space* const space = it->get();
+      const bool differs = space->name() != entry.name ||
+                           space->icon() != entry.icon ||
+                           space->color() != entry.color;
+      space->SetName(entry.name);
+      space->SetIcon(entry.icon);
+      space->SetColor(entry.color);
+      space->set_color_chosen(entry.color_chosen);
+      if (differs) {
+        changed.push_back(entry.id);
+      }
+      spaces_.push_back(std::move(*it));
+    } else {
+      auto space = std::make_unique<Space>(entry.id, entry.name, entry.color);
+      space->SetIcon(entry.icon);
+      space->set_color_chosen(entry.color_chosen);
+      spaces_.push_back(std::move(space));
+      added.push_back(entry.id);
+    }
+  }
+  if (spaces_.empty()) {
+    // A registry with nothing in it: this window's own list stays.
+    spaces_ = std::move(old);
+    return;
+  }
+  std::vector<SpaceId> removed;
+  for (std::unique_ptr<Space>& space : old) {
+    if (space) {
+      removed.push_back(space->id());
+    }
+  }
+  if (!GetSpace(active_id_)) {
+    active_id_ = spaces_.front()->id();
+  }
+  std::vector<tabs::TabInterface*> moved;
+  for (const SpaceId& id : removed) {
+    last_active_.erase(id);
+    history_.erase(id);
+    for (auto& [handle, space_id] : tab_spaces_) {
+      if (space_id == id) {
+        space_id = active_id_;
+        if (tabs::TabInterface* const tab = handle.Get()) {
+          SaveTabToSession(tab, active_id_);
+          moved.push_back(tab);
+        }
+      }
+    }
+  }
+  for (tabs::TabInterface* const tab : moved) {
+    observers_.Notify(&Observer::OnTabSpaceChanged, tab);
+  }
+  for (const SpaceId& id : added) {
+    observers_.Notify(&Observer::OnSpaceAdded, id);
+  }
+  for (const SpaceId& id : removed) {
+    observers_.Notify(&Observer::OnSpaceRemoved, id);
+  }
+  for (const SpaceId& id : changed) {
+    observers_.Notify(&Observer::OnSpaceMetadataChanged, id);
+  }
+  if (added.empty() && removed.empty() && changed.empty()) {
+    // An order change: the switcher rebuilds on any metadata change.
+    observers_.Notify(&Observer::OnSpaceMetadataChanged, active_id_);
+  }
+  SaveToSession();
+}
