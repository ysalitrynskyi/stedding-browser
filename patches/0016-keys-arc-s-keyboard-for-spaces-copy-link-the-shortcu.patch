--- /dev/null
+++ b/chrome/browser/ui/stedding/copy_link.cc
@@ -0,0 +1,90 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/copy_link.h"
+
+#include <string>
+
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/clean_link.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/toasts/api/toast_id.h"
+#include "chrome/browser/ui/toasts/toast_controller.h"
+#include "chrome/browser/ui/toasts/toast_features.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/clipboard/clipboard_buffer.h"
+#include "ui/base/clipboard/scoped_clipboard_writer.h"
+
+namespace stedding {
+
+namespace {
+
+// The page title, or the host when the page has none, on one line.
+std::u16string TitleFor(content::WebContents* contents, const GURL& url) {
+  std::u16string title;
+  base::TrimWhitespace(contents->GetTitle(), base::TRIM_ALL, &title);
+  base::ReplaceChars(title, u"\r\n", u" ", &title);
+  if (title.empty()) {
+    title = base::UTF8ToUTF16(url.host());
+  }
+  return title;
+}
+
+}  // namespace
+
+CopyLinkResult WriteLinkToClipboard(const PrefService* prefs,
+                                    content::WebContents* contents,
+                                    LinkFormat format) {
+  if (!contents) {
+    return {};
+  }
+  const GURL original = contents->GetVisibleURL();
+  if (!original.is_valid()) {
+    return {};
+  }
+  const bool strip = !prefs || prefs->GetBoolean(prefs::kCopyStripTracking);
+  CopyLinkResult result;
+  result.url = strip ? CleanLink(original) : original;
+  result.stripped = result.url != original;
+
+  const std::u16string spec = base::UTF8ToUTF16(result.url.spec());
+  ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+  if (format == LinkFormat::kPlain) {
+    writer.WriteText(spec);
+    return result;
+  }
+  const std::u16string title = TitleFor(contents, result.url);
+  // In Markdown a closing bracket ends the label; the anchor gets the title
+  // as written, and WriteHyperlink escapes it for HTML.
+  std::u16string label;
+  base::ReplaceChars(title, u"]", u"\\]", &label);
+  writer.WriteText(u"[" + label + u"](" + spec + u")");
+  writer.WriteHyperlink(title, result.url.spec());
+  return result;
+}
+
+void CopyLink(BrowserWindowInterface* browser,
+              content::WebContents* contents,
+              LinkFormat format) {
+  Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  const CopyLinkResult result =
+      WriteLinkToClipboard(profile ? profile->GetPrefs() : nullptr, contents,
+                           format);
+  if (result.url.is_empty() ||
+      !toast_features::IsEnabled(toast_features::kLinkCopiedToast)) {
+    return;
+  }
+  ToastController* const toasts = ToastController::From(browser);
+  if (toasts) {
+    toasts->MaybeShowToast(ToastParams(result.stripped
+                                           ? ToastId::kSteddingLinkCopiedClean
+                                           : ToastId::kLinkCopied));
+  }
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/copy_link.h b/chrome/browser/ui/stedding/copy_link.h
new file mode 100644
index 0000000000000..e4af95c4c48b9
--- /dev/null
+++ b/chrome/browser/ui/stedding/copy_link.h
@@ -0,0 +1,51 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_COPY_LINK_H_
+#define CHROME_BROWSER_UI_STEDDING_COPY_LINK_H_
+
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class PrefService;
+
+namespace content {
+class WebContents;
+}
+
+namespace stedding {
+
+// Copy link (docs/features/copy-link.md): Shift-Cmd-C copies the page's URL,
+// Option-Shift-Cmd-C a Markdown link with a rich-text twin, both without
+// tracking parameters while the preference is on.
+
+enum class LinkFormat {
+  // The URL alone (L1).
+  kPlain,
+  // "[title](url)" as text, plus an anchor as HTML, so Slack, Notion and Docs
+  // paste a live link (L3).
+  kMarkdown,
+};
+
+struct CopyLinkResult {
+  // What went on the clipboard, or empty when nothing did.
+  GURL url;
+  // Whether tracking parameters were removed (L2, L5).
+  bool stripped = false;
+};
+
+// The copy itself. `prefs` is the profile's; null means the default, which
+// strips (L2, L6).
+CopyLinkResult WriteLinkToClipboard(const PrefService* prefs,
+                                    content::WebContents* contents,
+                                    LinkFormat format);
+
+// The command: the copy, then the toast that confirms it (L5).
+void CopyLink(BrowserWindowInterface* browser,
+              content::WebContents* contents,
+              LinkFormat format);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_COPY_LINK_H_
