+// Z11: with the shipped chords taken off, they do nothing.
+IN_PROC_BROWSER_TEST_F(ShortcutRebindTest, TheOldChordStopsWorking) {
+  const std::vector<shortcuts::Chord> shipped =
+      shortcuts::DefaultChordsFor(IDC_SELECT_NEXT_TAB);
+  ASSERT_FALSE(shipped.empty());
+  EXPECT_EQ(IDC_SELECT_NEXT_TAB, CommandOn(browser(), shipped.front()));
+  ASSERT_NO_FATAL_FAILURE(MoveToTheFreeChord("next-tab"));
+  for (const shortcuts::Chord& chord : shipped) {
+    EXPECT_NE(IDC_SELECT_NEXT_TAB, CommandOn(browser(), chord))
+        << shortcuts::ChordToString(chord);
+  }
+  EXPECT_EQ(IDC_SELECT_NEXT_TAB, CommandOn(browser(), kFreeChord));
+}
