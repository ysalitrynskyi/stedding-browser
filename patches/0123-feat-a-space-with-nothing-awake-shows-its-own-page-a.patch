+
+#ifndef CHROME_BROWSER_UI_VIEWS_DOWNLOAD_BUBBLE_STEDDING_DOWNLOAD_FLIGHT_VIEWS_H_
+#define CHROME_BROWSER_UI_VIEWS_DOWNLOAD_BUBBLE_STEDDING_DOWNLOAD_FLIGHT_VIEWS_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/views/download/download_started_animation_views.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
