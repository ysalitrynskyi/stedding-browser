+class ImportTestBase : public InProcessBrowserTest {
+ protected:
+  // The visits the profile's history holds for `url`.
+  size_t VisitsTo(const GURL& url) {
+    history::HistoryService* const history =
+        HistoryServiceFactory::GetForProfile(
+            browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+    if (!history) {
+      ADD_FAILURE() << "no history service";
+      return 0;
+    }
+    history::BlockUntilHistoryProcessesPendingRequests(history);
+    base::CancelableTaskTracker tracker;
+    base::test::TestFuture<history::QueryURLAndVisitsResult> result;
+    history->QueryURLAndVisits(url, history::VisitQuery404sPolicy::kInclude404s,
+                               result.GetCallback(), &tracker);
+    return result.Get().success ? result.Get().visits.size() : 0;
+  }
+
+  bookmarks::BookmarkModel* Bookmarks() {
+    bookmarks::BookmarkModel* const model =
+        BookmarkModelFactory::GetForBrowserContext(browser()->GetProfile());
+    bookmarks::test::WaitForBookmarkModelToLoad(model);
+    return model;
+  }
+
+  // The folders under Other bookmarks named `title`.
+  size_t FoldersNamed(std::u16string_view title) {
+    size_t count = 0;
+    for (const auto& child : Bookmarks()->other_node()->children()) {
+      count += child->is_folder() && child->GetTitle() == title;
+    }
+    return count;
+  }
+};
+
+class SafariExportImportTest : public ImportTestBase {
+ protected:
+  void SetUpOnMainThread() override {
+    ImportTestBase::SetUpOnMainThread();
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    const base::FilePath folder = dir_.GetPath().AppendASCII("Safari Export");
+    ASSERT_TRUE(base::CreateDirectory(folder));
+    ASSERT_TRUE(base::WriteFile(folder.AppendASCII("Bookmarks.html"),
+                                kExportBookmarks));
+    ASSERT_TRUE(base::WriteFile(folder.AppendASCII("History.json"),
+                                ExportHistory()));
+    ASSERT_TRUE(base::WriteFile(folder.AppendASCII("Passwords.csv"),
+                                kExportPasswords));
+    ASSERT_TRUE(base::WriteFile(folder.AppendASCII("PaymentCards.json"),
+                                kExportCards));
+    zip_ = dir_.GetPath().AppendASCII("Safari Export.zip");
+    ASSERT_TRUE(zip::Zip(folder, zip_, /*include_hidden_files=*/false));
+  }
+
+  void TearDownOnMainThread() override {
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      EXPECT_TRUE(dir_.Delete());
+    }
+    ImportTestBase::TearDownOnMainThread();
+  }
+
+  // On the welcome flow's import step: Choose File..., the archive, and the
+  // summary the row then shows.
+  void ChooseExport(content::WebContents* page) {
+    ui::FakeSelectFileDialog::Factory* const dialogs =
+        ui::FakeSelectFileDialog::RegisterFactory();
+    dialogs->SetOpenCallback(base::DoNothing());
+    ASSERT_TRUE(content::ExecJs(
+        page, "document.querySelector('[data-focus=\"safari-file\"]').click()"));
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return dialogs->GetLastDialog() != nullptr; }))
+        << "no file dialog opened";
+    ASSERT_TRUE(dialogs->GetLastDialog()->CallFileSelected(zip_, "zip"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(page,
+                             "!!(steddingWelcomeTest.state.safari && "
+                             "steddingWelcomeTest.state.safari.chosen)")
+          .ExtractBool();
+    })) << "the export was never summed up";
+  }
+
+  // The importer itself: the export read, then the ticked parts brought in.
+  stedding::SafariExportResult ImportDirectly(
+      stedding::SafariExportParts parts) {
+    auto importer = std::make_unique<stedding::SafariExportImporter>();
+    base::test::TestFuture<stedding::SafariExportSummary> prepared;
+    importer->Prepare(
+        zip_, prepared.GetCallback<const stedding::SafariExportSummary&>());
+    EXPECT_TRUE(prepared.Wait());
+    base::test::TestFuture<stedding::SafariExportResult> done;
+    stedding::SafariExportImporter::Commit(
+        std::move(importer), *browser()->GetProfile(), parts,
+        done.GetCallback<const stedding::SafariExportResult&>());
+    return done.Get();
+  }
+
+  base::ScopedTempDir dir_;
+  base::FilePath zip_;
+};
