+views::ImageButton* SiteControlsStripView::AddIconButton(
+    Action action,
+    ui::ElementIdentifier id,
+    views::View* parent) {
+  const State state;
+  std::unique_ptr<views::ImageButton> button =
+      views::CreateVectorImageButtonWithNativeTheme(
+          base::BindRepeating(&SiteControlsStripView::OnPressed,
+                              base::Unretained(this), action),
+          IconFor(action, state), kStripIconSize);
+  button->SetProperty(views::kElementIdentifierKey, id);
+  const std::u16string name = NameFor(action, state);
+  button->GetViewAccessibility().SetName(name);
+  button->SetTooltipText(Tooltip(name, CommandFor(action)));
+  return parent->AddChildView(std::move(button));
+}
+
+std::u16string SiteControlsStripView::Tooltip(const std::u16string& name,
+                                              int command_id) {
+  const std::u16string chord =
+      command_id ? delegate_->ChordFor(command_id) : std::u16string();
+  return chord.empty()
+             ? name
+             : l10n_util::GetStringFUTF16(
+                   IDS_STEDDING_SITE_CONTROLS_NAME_WITH_CHORD, name, chord);
+}
+
+void SiteControlsStripView::OnPressed(Action action, const ui::Event& event) {
+  // Si2, copy-link L7: an Option-click (Alt-click) on Copy link copies the
+  // Markdown link.
+  if (action == Action::kCopyLink && event.IsAltDown()) {
+    action = Action::kCopyMarkdownLink;
+  }
+  // The delegate may close the panel, which deletes this view a turn later;
+  // nothing of it is read after the call.
+  delegate_->Run(action);
+}
+
+void SiteControlsStripView::Update() {
+  const State state = delegate_->GetState();
+
+  copy_link_->SetEnabled(state.copy_link_enabled);
+
+  const std::u16string mute = NameFor(Action::kToggleMute, state);
+  SetIcon(mute_, IconFor(Action::kToggleMute, state));
+  mute_->GetViewAccessibility().SetName(mute);
+  mute_->SetTooltipText(Tooltip(mute, CommandFor(Action::kToggleMute)));
+
+  const std::u16string pip = NameFor(Action::kTogglePictureInPicture, state);
+  SetIcon(picture_in_picture_, IconFor(Action::kTogglePictureInPicture, state));
+  picture_in_picture_->GetViewAccessibility().SetName(pip);
+  picture_in_picture_->SetTooltipText(
+      Tooltip(pip, CommandFor(Action::kTogglePictureInPicture)));
+  picture_in_picture_->SetEnabled(state.picture_in_picture !=
+                                  PictureInPicture::kNothing);
+
+  const std::u16string percent = base::FormatPercent(state.zoom_percent);
+  zoom_reset_->SetText(percent);
+  zoom_reset_->GetViewAccessibility().SetName(l10n_util::GetStringFUTF16(
+      IDS_STEDDING_SITE_CONTROLS_RESET_ZOOM_NAME, percent));
+  zoom_reset_->SetTooltipText(Tooltip(NameFor(Action::kZoomReset, state),
+                                      CommandFor(Action::kZoomReset)));
+}
