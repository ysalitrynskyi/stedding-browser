+++ b/chrome/test/stedding/downloads_browsertest.cc
@@ -0,0 +1,368 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The sidebar's downloads button (toolbar T14, T27). While the sidebar shows,
+// its button carries a download -- the in-progress icon, the ring, the count
+// in its tooltip and in the name a screen reader reads -- and the bubble
+// opens from it. With horizontal tabs, or the sidebar hidden, Chromium's own
+// toolbar button shows during a download and the bubble opens from that one,
+// and a change of strip mid-download hands the download over at once, also
+// one that sends no more progress (docs/history/plan-2026-09-26.md WIN-16,
+// WIN-F6).
+
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/actions/chrome_action_id.h"
+#include "chrome/browser/ui/animation/browser_animation_controller.h"
+#include "chrome/browser/ui/browser_actions.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/views/animations/tab_strip_animations.h"
+#include "chrome/browser/ui/views/download/bubble/download_toolbar_ui_controller.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/toolbar_button_provider.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/browser/ui/views/toolbar/pinned_toolbar_actions_container.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "chrome/grit/generated_resources.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "components/download/public/common/download_item.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/download_manager.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/download_test_observer.h"
+#include "content/public/test/slow_download_http_response.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/actions/actions.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/gfx/animation/animation_test_api.h"
+#include "ui/gfx/vector_icon_types.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/bubble/bubble_dialog_delegate_view.h"
+#include "ui/views/controls/button/button.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/layout/animating_layout_manager.h"
+#include "ui/views/layout/animating_layout_manager_test_util.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/any_widget_observer.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+
+namespace {
+
+class SteddingDownloadsTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        &content::SlowDownloadHttpResponse::HandleSlowDownloadRequest));
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  void TearDownOnMainThread() override {
+    // A download still in progress would hold the browser's shutdown.
+    content::DownloadManager::DownloadVector items;
+    manager()->GetAllDownloads(&items);
+    for (download::DownloadItem* const item : items) {
+      if (item->GetState() == download::DownloadItem::IN_PROGRESS) {
+        item->Cancel(/*user_cancel=*/true);
+      }
+    }
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* window() { return browser_view()->GetWidget(); }
+  content::DownloadManager* manager() {
+    return browser()->GetProfile()->GetDownloadManager();
+  }
+  DownloadToolbarUIController* downloads() {
+    return DownloadToolbarUIController::From(browser());
+  }
+  actions::ActionItem* downloads_action() {
+    return actions::ActionManager::Get().FindAction(
+        kActionShowDownloads,
+        BrowserActions::From(browser())->root_action_item());
+  }
+
+  // The sidebar's button, at the left of the Space switcher's row.
+  views::LabelButton* sidebar_button() {
+    VerticalTabStripRegionView* const strip =
+        browser_view()->vertical_tab_strip_region_view_for_testing();
+    return strip ? views::AsViewClass<views::LabelButton>(
+                       strip->downloads_button())
+                 : nullptr;
+  }
+
+  // Chromium's own button at the toolbar's right, or null while it is not
+  // there.
+  ToolbarButton* toolbar_button() {
+    return browser_view()->toolbar_button_provider()->GetDownloadButton();
+  }
+  bool ToolbarButtonShows() {
+    ToolbarButton* const button = toolbar_button();
+    return button && button->GetVisible();
+  }
+  // Lets the toolbar's button finish sliding in or out.
+  void SettleToolbar() {
+    ToolbarButtonProvider* const toolbar =
+        browser_view()->toolbar_button_provider();
+    views::test::WaitForAnimatingLayoutManager(
+        static_cast<PinnedToolbarActionsContainer*>(
+            toolbar->GetPinnedToolbarActions()));
+    views::test::RunScheduledLayout(window());
+  }
+
+  bool StripAnimating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+  // The strip change a person makes: the View menu's row, or the tab
+  // strip's own menu (menus M9).
+  void ToggleTabStrip() {
+    chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS);
+    RunScheduledLayouts();
+  }
+  // Cmd+S / Ctrl+S: the sidebar closes to its chosen form, or opens.
+  void ToggleSidebar() {
+    chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS_COLLAPSE);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !StripAnimating(); }));
+    views::test::RunScheduledLayout(window());
+  }
+
+  // Starts a download that stays in progress until the test ends it, and
+  // returns it once it is under way.
+  download::DownloadItem* StartSlowDownload() {
+    content::DownloadTestObserverInProgress in_progress(manager(), 1);
+    ui_test_utils::NavigateToURLWithDisposition(
+        browser(),
+        embedded_test_server()->GetURL(
+            content::SlowDownloadHttpResponse::kKnownSizeUrl),
+        WindowOpenDisposition::CURRENT_TAB,
+        ui_test_utils::BROWSER_TEST_NO_WAIT);
+    in_progress.WaitForFinished();
+    content::DownloadManager::DownloadVector items;
+    manager()->GetAllDownloads(&items);
+    return items.size() == 1 ? items.front().get() : nullptr;
+  }
+
+  // Clicks `button` through the window, as a person does, and returns the
+  // view the bubble that opens is anchored to.
+  views::View* ClickForTheBubble(views::View* button) {
+    if (downloads()->IsShowingDetails()) {
+      downloads()->HideDetails();
+    }
+    views::NamedWidgetShownWaiter waiter(
+        views::test::AnyWidgetTestPasskey{},
+        DownloadToolbarUIController::kBubbleName);
+    views::test::RunScheduledLayout(window());
+    stedding::test::ClickLeftMouse(window(),
+                                   button->GetBoundsInScreen().CenterPoint());
+    views::Widget* const bubble = waiter.WaitIfNeededAndGet();
+    if (!bubble || !bubble->widget_delegate() ||
+        !bubble->widget_delegate()->AsBubbleDialogDelegate()) {
+      return nullptr;
+    }
+    views::View* const anchor =
+        bubble->widget_delegate()->AsBubbleDialogDelegate()->GetAnchorView();
+    bubble->CloseNow();
+    return anchor;
+  }
+
+  // Whether the button the downloads are on now draws a ring: dormant when
+  // the window is not the profile's last active one, which a test window may
+  // not be.
+  bool RingShows() {
+    return downloads()->IsProgressRingInDownloadingStateForTesting() ||
+           downloads()->IsProgressRingInDormantStateForTesting();
+  }
+
+  std::u16string InProgressTooltip(int count) {
+    return l10n_util::GetPluralStringFUTF16(
+        IDS_DOWNLOAD_BUBBLE_TOOLTIP_IN_PROGRESS_COUNT, count);
+  }
+};
+
+// toolbar T27: with horizontal tabs, Chromium's own toolbar button shows
+// during a download, carries its ring, and the bubble opens from it.
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
+                       HorizontalTabsUseTheToolbarButton) {
+  ToggleTabStrip();
+  ASSERT_FALSE(
+      vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+  ASSERT_FALSE(ToolbarButtonShows());
+
+  ASSERT_TRUE(StartSlowDownload());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return ToolbarButtonShows(); }))
+      << "with horizontal tabs a download shows nowhere";
+  SettleToolbar();
+  EXPECT_TRUE(toolbar_button()->IsDrawn());
+  EXPECT_TRUE(RingShows()) << "the toolbar's button has no ring";
+  EXPECT_EQ(toolbar_button(), ClickForTheBubble(toolbar_button()))
+      << "the bubble did not open from the toolbar's button";
+}
+
+// toolbar T27, BACKLOG S-250: the toolbar's button appears when the row is
+// first laid out while it slides in, not only when the slide has not begun.
+// The row measured the part-slid container against its own height, which the
+// 28 DIP button does not fit, hid it at no width, and the container snapped
+// to a layout with no room for the button: it never appeared. A loaded
+// machine laid the row out that late about one run in ten.
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
+                       TheToolbarButtonAppearsWhenLaidOutPartWay) {
+  // The slide is what the fault needs; a remote desktop session, as the PC's
+  // runs are, turns rich animations off, and nothing would slide.
+  const auto rich_animations =
+      gfx::AnimationTestApi::SetRichAnimationRenderMode(
+          gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  ToggleTabStrip();
+  ASSERT_FALSE(
+      vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+  ASSERT_FALSE(ToolbarButtonShows());
+  auto* const container = static_cast<PinnedToolbarActionsContainer*>(
+      browser_view()->toolbar_button_provider()->GetPinnedToolbarActions());
+  views::AnimatingLayoutManager* const layout =
+      container->GetAnimatingLayoutManager();
+  gfx::AnimationContainerTestApi clock(
+      layout->GetAnimationContainerForTesting());
+
+  // What a download starting does, then a third of the slide before the row
+  // is laid out, then the rest.
+  downloads()->Show();
+  ASSERT_TRUE(ToolbarButtonShows());
+  ASSERT_TRUE(layout->is_animating());
+  clock.IncrementTime(base::Milliseconds(100));
+  views::test::RunScheduledLayout(window());
+  clock.IncrementTime(base::Seconds(1));
+  views::test::RunScheduledLayout(window());
+
+  EXPECT_FALSE(layout->is_animating());
+  EXPECT_TRUE(toolbar_button()->IsDrawn());
+  EXPECT_FALSE(toolbar_button()->size().IsEmpty())
+      << toolbar_button()->bounds().ToString();
+}
+
+// toolbar T14, docs/history/plan-2026-09-26.md WIN-16: in the sidebar, its
+// own button carries the download: the toolbar's does not appear, the ring
+// is on the sidebar's, the icon and the tooltip are the download's -- the
+// in-progress arrow, "1 download in progress" -- and so is the name a screen
+// reader reads, and the bubble opens from it. The icon and the tooltip were a
+// copy of the action's taken when the sidebar was built.
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
+                       TheSidebarButtonCarriesTheDownload) {
+  views::LabelButton* const button = sidebar_button();
+  ASSERT_TRUE(button);
+  ASSERT_TRUE(button->IsDrawn());
+  actions::ActionItem* const action = downloads_action();
+  ASSERT_TRUE(action);
+  const gfx::VectorIcon* const idle_icon =
+      action->GetImage().GetVectorIcon().vector_icon();
+
+  ASSERT_TRUE(StartSlowDownload());
+  // The action is what the toolbar's button would show; the sidebar's
+  // button must show the same.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return action->GetTooltipText() == InProgressTooltip(1);
+  }));
+  base::RunLoop().RunUntilIdle();
+  SettleToolbar();
+
+  EXPECT_FALSE(ToolbarButtonShows())
+      << "the toolbar's button appeared beside the sidebar's";
+  EXPECT_TRUE(RingShows()) << "the sidebar's button has no ring";
+  EXPECT_EQ(InProgressTooltip(1), button->GetTooltipText());
+  EXPECT_EQ(InProgressTooltip(1),
+            button->GetViewAccessibility().GetCachedName());
+  const gfx::VectorIcon* const progress_icon =
+      action->GetImage().GetVectorIcon().vector_icon();
+  ASSERT_NE(idle_icon, progress_icon);
+  const std::optional<ui::ImageModel>& drawn =
+      button->GetImageModel(views::Button::STATE_NORMAL);
+  ASSERT_TRUE(drawn.has_value());
+  ASSERT_TRUE(drawn->IsVectorIcon());
+  EXPECT_EQ(progress_icon, drawn->GetVectorIcon().vector_icon())
+      << "the sidebar's button still shows the idle icon";
+
+  EXPECT_EQ(button, ClickForTheBubble(button))
+      << "the bubble did not open from the sidebar's button";
+}
+
+// toolbar T27: a change of strip mid-download hands the download over at
+// once. A paused download sends no more progress, so nothing but the change
+// itself can move it: to the toolbar with horizontal tabs, and back to the
+// sidebar's button, with the toolbar's gone, with the sidebar.
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
+                       AStripChangeHandsTheDownloadOver) {
+  download::DownloadItem* const item = StartSlowDownload();
+  ASSERT_TRUE(item);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return RingShows(); }));
+  item->Pause();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return item->IsPaused(); }));
+  base::RunLoop().RunUntilIdle();
+  SettleToolbar();
+  ASSERT_FALSE(ToolbarButtonShows());
+
+  ToggleTabStrip();
+  ASSERT_FALSE(
+      vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return ToolbarButtonShows(); }))
+      << "with horizontal tabs the paused download shows nowhere";
+  SettleToolbar();
+  EXPECT_EQ(toolbar_button(), ClickForTheBubble(toolbar_button()));
+
+  ToggleTabStrip();
+  ASSERT_TRUE(
+      vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(window());
+    return !ToolbarButtonShows();
+  })) << "back in the sidebar, the toolbar's button stayed at the top right";
+  ASSERT_TRUE(sidebar_button());
+  EXPECT_EQ(sidebar_button(), ClickForTheBubble(sidebar_button()));
+}
+
+// toolbar T27, sidebar Y19: closed to nothing, the sidebar draws its button
+// nowhere, so the toolbar's shows during a download and the bubble opens
+// from it; opened again, the sidebar's button takes the download back.
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
+                       AHiddenSidebarLeavesTheDownloadToTheToolbar) {
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarClosedForm,
+      stedding::prefs::kSidebarClosedHidden);
+  ASSERT_NO_FATAL_FAILURE(ToggleSidebar());
+  ASSERT_TRUE(vertical_tab_strip_state_controller()->IsCollapsed());
+  ASSERT_EQ(0, browser_view()->vertical_tab_strip_region_view_for_testing()
+                   ->width());
+
+  ASSERT_TRUE(StartSlowDownload());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return ToolbarButtonShows(); }))
+      << "the sidebar is hidden and its button took the download";
+  SettleToolbar();
+  EXPECT_EQ(toolbar_button(), ClickForTheBubble(toolbar_button()));
+
+  ASSERT_NO_FATAL_FAILURE(ToggleSidebar());
+  ASSERT_FALSE(vertical_tab_strip_state_controller()->IsCollapsed());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(window());
+    return !ToolbarButtonShows();
+  })) << "the sidebar is open again and the toolbar kept the download";
+}
