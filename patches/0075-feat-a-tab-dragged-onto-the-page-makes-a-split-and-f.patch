+    views::View* const button = row->close_button_for_testing();
+    ASSERT_TRUE(button->GetVisible()) << "the hovered row has no close button";
+    ClickAt(button->GetBoundsInScreen().CenterPoint());
+    // Not c, below it.
+    ASSERT_NO_FATAL_FAILURE(expect_shown_after(b_handle, d));
+  }
+  {
+    SCOPED_TRACE("a middle click on d's row");
+    ASSERT_NO_FATAL_FAILURE(WaitForRowsToSettle());
+    TabView* const row = RowFor(index(d));
+    ASSERT_TRUE(row);
+    MiddleClickAt(row->GetBoundsInScreen().CenterPoint());
+    // Not c, above it.
+    ASSERT_NO_FATAL_FAILURE(expect_shown_after(d_handle, a));
+  }
+  {
+    SCOPED_TRACE("a's page closes itself");
+    content::ExecuteScriptAsync(a->GetContents(), "window.close();");
+    // Not c.
+    ASSERT_NO_FATAL_FAILURE(expect_shown_after(a_handle, first));
+  }
+  EXPECT_EQ(2, tab_strip_model()->count());
+}
