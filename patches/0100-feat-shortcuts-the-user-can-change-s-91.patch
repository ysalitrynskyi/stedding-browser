+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SHORTCUT_CHORD_H_
+#define CHROME_BROWSER_UI_STEDDING_SHORTCUT_CHORD_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+
+namespace ui {
+class Accelerator;
+}
+
+namespace stedding::shortcuts {
+
+// docs/features/shortcuts.md Z10: a chord as Local State stores it. The
+// modifiers come first, always in this order -- Ctrl, Alt, AltGr, Shift, Cmd,
+// Fn -- then one key token: a letter or digit, a key name ("Right",
+// "PageDown", "F5", "Comma", "Numpad1"), or "VK" and two hex digits for any
+// other key code. "Cmd" is ui::EF_COMMAND_DOWN: Command on the Mac, the
+// Windows key elsewhere. The text is never shown to the user; the page shows
+// ChordText.
+std::string ChordToString(const Chord& chord);
+
+// The chord `text` names, or nothing when it cannot be read: an unknown
+// token, a modifier twice or out of order, no key.
+std::optional<Chord> ChordFromString(std::string_view text);
+
+// The chord as the menus print it: "⇧⌘K" on the Mac, "Ctrl+Shift+K"
+// elsewhere.
+std::u16string ChordText(const Chord& chord);
+
+ui::Accelerator ToAccelerator(const Chord& chord);
+Chord FromAccelerator(const ui::Accelerator& accelerator);
+
+// Why a chord cannot be taken, before any other row is asked (Z14).
+enum class ChordShape {
+  kOk,
+  // A modifier key alone, or no key at all.
+  kNoKey,
+  // No ⌘ or ⌃ on the Mac, no Ctrl or Alt elsewhere, and not an F-key.
+  kNeedsModifier,
+  // The system's own: macOS's or Windows'.
+  kSystem,
+  // Copy, paste, cut, select all, undo, redo.
+  kTextEditing,
+  // Escape alone: it closes, cancels and leaves full screen everywhere.
+  kEscape,
+  // A chord with the Windows key: Windows keeps them.
+  kWindowsKey,
+};
+
+// The checks of this platform.
+ChordShape CheckChordShape(const Chord& chord);
+// The same checks for the Mac (`mac`) or for Windows and Linux, so both
+// platforms' rules are tested on either.
+ChordShape CheckChordShapeFor(const Chord& chord, bool mac);
+
+// A sentence for the page: why `shape` refuses a chord.
+std::u16string ChordShapeMessage(ChordShape shape);
+
+}  // namespace stedding::shortcuts
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SHORTCUT_CHORD_H_
diff --git a/chrome/browser/ui/stedding/shortcut_chord_unittest.cc b/chrome/browser/ui/stedding/shortcut_chord_unittest.cc
new file mode 100644
index 0000000000000..d564dee8022dd
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_chord_unittest.cc
@@ -0,0 +1,144 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_chord.h"
+
+#include <optional>
+#include <string>
+
+#include "chrome/browser/ui/stedding/shortcut_catalog.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace stedding::shortcuts {
+namespace {
+
+constexpr int kCtrl = ui::EF_CONTROL_DOWN;
+constexpr int kAlt = ui::EF_ALT_DOWN;
+constexpr int kShift = ui::EF_SHIFT_DOWN;
+constexpr int kCmd = ui::EF_COMMAND_DOWN;
+
+// docs/features/shortcuts.md Z10: every chord this platform's shipped tables
+// bind is written and read back as itself, so any of them can be stored.
+TEST(ShortcutChordTest, RoundTripsEveryKeyTheTablesUse) {
+  const std::vector<Binding> defaults = DefaultBindings();
+  ASSERT_FALSE(defaults.empty());
+  for (const Binding& binding : defaults) {
+    const std::string text = ChordToString(binding.chord);
+    SCOPED_TRACE(text);
+    const std::optional<Chord> back = ChordFromString(text);
+    ASSERT_TRUE(back.has_value());
+    EXPECT_EQ(binding.chord, *back);
+  }
+  // Every key code, with every modifier, round-trips too.
+  for (int code = 1; code <= 0xFE; ++code) {
+    const Chord chord(static_cast<ui::KeyboardCode>(code),
+                      kCtrl | kAlt | kShift | kCmd);
+    const std::optional<Chord> back = ChordFromString(ChordToString(chord));
+    if (back) {
+      EXPECT_EQ(chord, *back) << ChordToString(chord);
+    }
+  }
+}
+
+// Z10: the stored text, as the ADR's format writes it.
+TEST(ShortcutChordTest, WritesTheModifiersInOneOrder) {
+  EXPECT_EQ("Ctrl+Alt+Right", ChordToString(Chord(ui::VKEY_RIGHT,
+                                                  kAlt | kCtrl)));
+  EXPECT_EQ("Shift+Cmd+K", ChordToString(Chord(ui::VKEY_K, kCmd | kShift)));
+  EXPECT_EQ("Ctrl+F5", ChordToString(Chord(ui::VKEY_F5, kCtrl)));
+  EXPECT_EQ("Cmd+Comma", ChordToString(Chord(ui::VKEY_OEM_COMMA, kCmd)));
+  EXPECT_EQ("Ctrl+Numpad1", ChordToString(Chord(ui::VKEY_NUMPAD1, kCtrl)));
+  EXPECT_EQ(Chord(ui::VKEY_RIGHT, kCtrl | kAlt),
+            ChordFromString("Ctrl+Alt+Right"));
+}
+
+// Z10: text that cannot be read is no chord at all, never a wrong one.
+TEST(ShortcutChordTest, ReadsNothingFromBadText) {
+  for (const char* text :
+       {"", "+", "Ctrl+", "Alt+Ctrl+K", "Ctrl+Ctrl+K", "Hyper+K", "Ctrl+KK",
+        "Ctrl+F25", "Ctrl+F01", "VK00", "Ctrl+VKZZ", "ctrl+k", "Ctrl+Shift",
+        "Ctrl+VK10"}) {
+    SCOPED_TRACE(text);
+    EXPECT_FALSE(ChordFromString(text).has_value());
+  }
+}
+
+// Z14: a chord needs ⌘ or ⌃ on the Mac and Ctrl or Alt elsewhere, unless it
+// is an F-key; a modifier alone is no chord.
+TEST(ShortcutChordTest, RefusesAChordWithoutAModifier) {
+  for (bool mac : {true, false}) {
+    SCOPED_TRACE(mac ? "Mac" : "Windows and Linux");
+    EXPECT_EQ(ChordShape::kNeedsModifier,
+              CheckChordShapeFor(Chord(ui::VKEY_K, 0), mac));
+    EXPECT_EQ(ChordShape::kNeedsModifier,
+              CheckChordShapeFor(Chord(ui::VKEY_K, kShift), mac));
+    EXPECT_EQ(ChordShape::kOk, CheckChordShapeFor(Chord(ui::VKEY_F8, 0), mac));
+    EXPECT_EQ(ChordShape::kOk,
+              CheckChordShapeFor(Chord(ui::VKEY_K, kCtrl | kShift), mac));
+    EXPECT_EQ(ChordShape::kNoKey,
+              CheckChordShapeFor(Chord(ui::VKEY_CONTROL, kCtrl), mac));
+    EXPECT_EQ(ChordShape::kEscape,
+              CheckChordShapeFor(Chord(ui::VKEY_ESCAPE, 0), mac));
+    EXPECT_EQ(ChordShape::kNeedsModifier,
+              CheckChordShapeFor(Chord(ui::VKEY_K, ui::EF_ALTGR_DOWN), mac));
+  }
+  // Option alone types characters on the Mac; Alt is a modifier elsewhere.
+  EXPECT_EQ(ChordShape::kNeedsModifier,
+            CheckChordShapeFor(Chord(ui::VKEY_K, kAlt), /*mac=*/true));
+  EXPECT_EQ(ChordShape::kOk,
+            CheckChordShapeFor(Chord(ui::VKEY_K, kAlt), /*mac=*/false));
+  EXPECT_EQ(ChordShape::kOk,
+            CheckChordShapeFor(Chord(ui::VKEY_K, kCmd), /*mac=*/true));
+}
+
+// Z14: the system's own chords are refused.
+TEST(ShortcutChordTest, RefusesTheSystemsChords) {
+  for (const Chord& chord :
+       {Chord(ui::VKEY_Q, kCmd), Chord(ui::VKEY_H, kCmd),
+        Chord(ui::VKEY_H, kCmd | kAlt), Chord(ui::VKEY_M, kCmd),
+        Chord(ui::VKEY_TAB, kCmd), Chord(ui::VKEY_OEM_3, kCmd),
+        Chord(ui::VKEY_SPACE, kCmd), Chord(ui::VKEY_SPACE, kCtrl),
+        Chord(ui::VKEY_3, kCmd | kShift), Chord(ui::VKEY_6, kCmd | kShift),
+        Chord(ui::VKEY_Q, kCmd | kCtrl), Chord(ui::VKEY_LEFT, kCtrl)}) {
+    EXPECT_EQ(ChordShape::kSystem, CheckChordShapeFor(chord, /*mac=*/true))
+        << ChordToString(chord);
+  }
+  for (const Chord& chord :
+       {Chord(ui::VKEY_F4, kAlt), Chord(ui::VKEY_TAB, kAlt),
+        Chord(ui::VKEY_ESCAPE, kAlt), Chord(ui::VKEY_SPACE, kAlt),
+        Chord(ui::VKEY_ESCAPE, kCtrl), Chord(ui::VKEY_ESCAPE, kCtrl | kShift),
+        Chord(ui::VKEY_DELETE, kCtrl | kAlt)}) {
+    EXPECT_EQ(ChordShape::kSystem, CheckChordShapeFor(chord, /*mac=*/false))
+        << ChordToString(chord);
+  }
+  EXPECT_EQ(ChordShape::kWindowsKey,
+            CheckChordShapeFor(Chord(ui::VKEY_E, kCmd), /*mac=*/false));
+}
+
+// Z14: copy, paste, cut, select all, undo and redo stay as they are.
+TEST(ShortcutChordTest, RefusesTextEditingChords) {
+  for (ui::KeyboardCode key :
+       {ui::VKEY_C, ui::VKEY_V, ui::VKEY_X, ui::VKEY_A, ui::VKEY_Z}) {
+    EXPECT_EQ(ChordShape::kTextEditing,
+              CheckChordShapeFor(Chord(key, kCmd), /*mac=*/true));
+    EXPECT_EQ(ChordShape::kTextEditing,
+              CheckChordShapeFor(Chord(key, kCtrl), /*mac=*/false));
+  }
+  EXPECT_EQ(ChordShape::kTextEditing,
+            CheckChordShapeFor(Chord(ui::VKEY_Z, kCmd | kShift), true));
+  EXPECT_EQ(ChordShape::kTextEditing,
+            CheckChordShapeFor(Chord(ui::VKEY_Y, kCtrl), false));
+  EXPECT_EQ(ChordShape::kTextEditing,
+            CheckChordShapeFor(Chord(ui::VKEY_INSERT, kShift), false));
+  EXPECT_EQ(ChordShape::kTextEditing,
+            CheckChordShapeFor(Chord(ui::VKEY_DELETE, kShift), false));
+  // Ctrl+C is a chord like any other on the Mac, where ⌘C copies.
+  EXPECT_EQ(ChordShape::kOk,
+            CheckChordShapeFor(Chord(ui::VKEY_C, kCtrl), /*mac=*/true));
+}
+
+}  // namespace
+}  // namespace stedding::shortcuts
