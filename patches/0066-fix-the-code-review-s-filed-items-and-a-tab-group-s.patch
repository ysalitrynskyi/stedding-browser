+// pins H14: while its label is drawn, Clear is a button the keyboard and a
+// screen reader reach: focusable, named Clear, run by Enter, Space and the
+// screen reader's press. In the rail, with no label, there is nothing to
+// reach. It was text painted on the line, which only a pointer could press
+// (BACKLOG S-205).
+TEST_F(ClearLineTest, ClearIsAButtonTheKeyboardReaches) {
+  int cleared = 0;
+  // In a widget, as in the sidebar: the platform's accessibility has a view
+  // outside one report nothing.
+  std::unique_ptr<views::Widget> widget =
+      CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+  ClearTabsSeparator* const line =
+      widget->SetContentsView(std::make_unique<ClearTabsSeparator>());
+  line->SetClearCallback(base::BindLambdaForTesting([&]() { ++cleared; }));
+  line->SetBounds(0, 0, 240, 22);
+
+  EXPECT_TRUE(line->GetViewAccessibility().IsAccessibilityFocusable());
+  ui::AXNodeData data;
+  line->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_EQ(ax::mojom::Role::kButton, data.role);
+  EXPECT_EQ(u"Clear",
+            data.GetString16Attribute(ax::mojom::StringAttribute::kName));
+  EXPECT_FALSE(data.IsIgnored());
+
+  EXPECT_TRUE(line->OnKeyPressed(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_RETURN, ui::EF_NONE)));
+  EXPECT_TRUE(line->OnKeyPressed(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_SPACE, ui::EF_NONE)));
+  EXPECT_FALSE(line->OnKeyPressed(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_A, ui::EF_NONE)));
+  ui::AXActionData press;
+  press.action = ax::mojom::Action::kDoDefault;
+  EXPECT_TRUE(line->HandleAccessibleAction(press));
+  EXPECT_EQ(3, cleared);
+
+  line->SetBounds(0, 0, 44, 22);  // the rail's column (sidebar Y8)
+  EXPECT_FALSE(line->GetViewAccessibility().IsAccessibilityFocusable());
+  EXPECT_FALSE(line->OnKeyPressed(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_RETURN, ui::EF_NONE)));
+  EXPECT_EQ(3, cleared);
+}
