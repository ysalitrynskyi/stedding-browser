+SiteControlsRowsView::SiteControlsRowsView(std::unique_ptr<Delegate> delegate)
+    : delegate_(std::move(delegate)) {
+  SetProperty(views::kElementIdentifierKey, kElementId);
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  // Si7: the session row, its words and its mark set by Update(). Its
+  // tooltip and accessible description are the mark's (sessions S32): the
+  // mark itself is drawn and never named, so a screen reader hears the row's
+  // name and the description once.
+  auto session = std::make_unique<RichControlsContainerView>();
+  session->SetProperty(views::kElementIdentifierKey, kSessionElementId);
+  session->SetIcon(PageInfoViewFactory::GetImageModel(kGridViewIcon));
+  session->SetTitleTextStyleAndColor(views::style::STYLE_BODY_3_MEDIUM,
+                                     kColorPageInfoForeground);
+  session->GetViewAccessibility().SetRole(ax::mojom::Role::kStaticText);
+  session->GetViewAccessibility().SetIsLeaf(true);
+  session_mark_ = session->AddControl(std::make_unique<IsolationMarkView>(
+      IsolationMarkView::Form::kGlyph, kColorPageInfoForeground,
+      ui::kColorDialogBackground));
+  session_mark_->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(0, IsolationMarkView::kGapAfterText, 0, 0));
+  session_row_ = AddChildView(std::move(session));
+
+  // Si8: Clear site data, a row that opens a question, as Chromium's rows
+  // that open a subpage are buttons.
+  auto clear = std::make_unique<RichHoverButton>(
+      base::BindRepeating(
+          [](SiteControlsRowsView* rows) { rows->delegate_->ClearSiteData(); },
+          base::Unretained(this)),
+      PageInfoViewFactory::GetImageModel(
+          features::IsRoundedIconsEnabled() ? kDeleteIcon : kDeleteOldIcon),
+      l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_CLEAR_DATA),
+      std::u16string());
+  clear->SetProperty(views::kElementIdentifierKey, kClearDataElementId);
+  clear->SetTitleTextStyleAndColor(views::style::STYLE_BODY_3_MEDIUM,
+                                   kColorPageInfoForeground);
+  clear_data_ = AddChildView(std::move(clear));
+
+  // Si9: the switch, and the site's choice under it.
+  dark_pages_row_ = AddToggleRow(
+      this, kMoonIcon, kDarkPagesElementId,
+      base::BindRepeating(
+          [](SiteControlsRowsView* rows) {
+            rows->delegate_->SetDarkPagesOn(rows->dark_pages_->GetIsOn());
+          },
+          base::Unretained(this)),
+      &dark_pages_);
+  dark_pages_row_->SetTitle(
+      l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_DARK_PAGES));
+  dark_pages_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_DARK_PAGES));
+
+  dark_site_row_ = AddToggleRow(
+      this, kMoonIcon, kDarkSiteElementId,
+      base::BindRepeating(
+          [](SiteControlsRowsView* rows) {
+            rows->delegate_->SetSiteDarkened(rows->dark_site_->GetIsOn());
+          },
+          base::Unretained(this)),
+      &dark_site_);
+
+  delegate_->SetRows(this);
+  Update();
+}
+
+SiteControlsRowsView::~SiteControlsRowsView() {
+  delegate_->SetRows(nullptr);
+}
+
+void SiteControlsRowsView::Update() {
+  const State state = delegate_->GetState();
+
+  session_row_->SetVisible(state.session.has_value());
+  if (state.session) {
+    session_row_->SetTitle(state.session->text);
+    session_mark_->SetVisible(state.session->marked);
+    const std::u16string description = state.session->marked
+                                           ? spaces::IsolationMarkDescription()
+                                           : std::u16string();
+    session_row_->SetTooltipText(description);
+    session_row_->GetViewAccessibility().SetName(state.session->text);
+    if (description.empty()) {
+      session_row_->GetViewAccessibility().RemoveDescription();
+    } else {
+      session_row_->GetViewAccessibility().SetDescription(description);
+    }
+  }
+
+  clear_data_->SetVisible(state.clear_data);
+
+  dark_pages_row_->SetVisible(state.dark_switch);
+  dark_pages_->SetIsOn(state.dark_pages_on);
+
+  dark_site_row_->SetVisible(state.dark_switch && state.dark_site.has_value());
+  if (state.dark_site) {
+    const std::u16string title = l10n_util::GetStringFUTF16(
+        IDS_STEDDING_SITE_CONTROLS_DARKEN_SITE, *state.dark_site);
+    dark_site_row_->SetTitle(title);
+    dark_site_->GetViewAccessibility().SetName(title);
+    dark_site_->SetIsOn(state.site_darkened);
+  }
+
+  // A row shown or hidden changes the panel's height.
+  PreferredSizeChanged();
+}
