diff --git a/chrome/test/stedding/address_band_browsertest.cc b/chrome/test/stedding/address_band_browsertest.cc
index b64085ec43c22..be20f58f6b63e 100644
--- a/chrome/test/stedding/address_band_browsertest.cc
+++ b/chrome/test/stedding/address_band_browsertest.cc
@@ -286,6 +286,40 @@ IN_PROC_BROWSER_TEST_F(AddressBandTest, TheFieldIsWholeInEveryState) {
       << "a click on the field's empty start did not focus the address";
 }
 
+// toolbar T48 (GitHub issue 14): Settings > Stedding > Address field. A
+// centred width holds the field at that width on the page's middle, in every
+// state, with the row either side of it the window's to drag; full width
+// gives the field the row again. Each takes effect at once.
+IN_PROC_BROWSER_TEST_F(AddressBandTest, TheFieldsWidthIsASetting) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_EQ(0, prefs->GetInteger(stedding::prefs::kToolbarFieldWidth))
+      << "the field is not full width by default";
+  views::test::RunScheduledLayout(view());
+  const int full = bar()->width();
+
+  prefs->SetInteger(stedding::prefs::kToolbarFieldWidth, 480);
+  views::test::RunScheduledLayout(view());
+  EXPECT_EQ(480, bar()->width()) << "the compact field is not 480 DIP";
+  ASSERT_LT(bar()->width(), full);
+  const gfx::Rect field = bar()->GetBoundsInScreen();
+  const gfx::Rect page = view()->contents_container()->GetBoundsInScreen();
+  EXPECT_NEAR(page.CenterPoint().x(), field.CenterPoint().x(), 2)
+      << "the field is not on the page's middle";
+  // The row just before the field holds nothing, and moves the window.
+  gfx::Point beside(bar()->x() - 6, bar()->y() + bar()->height() / 2);
+  EXPECT_TRUE(view()->toolbar()->IsPositionInWindowCaption(beside))
+      << "the empty row beside a centred field is not the window's to drag";
+
+  bar()->omnibox_view()->RequestFocus();
+  views::test::RunScheduledLayout(view());
+  EXPECT_EQ(field, bar()->GetBoundsInScreen())
+      << "the field moved or grew when it took focus";
+
+  prefs->SetInteger(stedding::prefs::kToolbarFieldWidth, 0);
+  views::test::RunScheduledLayout(view());
+  EXPECT_EQ(full, bar()->width()) << "full width did not give the row back";
+}
+
 // The field while it is edited or hovered, and a toast, all leave the
 // address readable (toolbar T34, T35).
 IN_PROC_BROWSER_TEST_F(AddressBandTest,
