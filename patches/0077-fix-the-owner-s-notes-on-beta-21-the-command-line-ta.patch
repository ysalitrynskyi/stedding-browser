+
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+
+namespace {
+
+const TabStripView* FindTabStripView(const views::View* view) {
+  if (const auto* const strip = views::AsViewClass<TabStripView>(view)) {
+    return strip;
+  }
+  for (const views::View* const child : view->children()) {
+    if (const TabStripView* const found = FindTabStripView(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+class SpaceWheelTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+#if BUILDFLAG(IS_WIN)
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    // The host resolver's rules are frozen once the set-up has run
+    // (docs/HANDOFF.md, trap 119).
+    host_resolver()->AddRule("*", "127.0.0.1");
+  }
+#endif
+
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+
+  // Three Spaces, the first active with `first_tabs` tabs, the others with
+  // one each.
+  void MakeThreeSpaces(int first_tabs) {
+    ids_.push_back(model()->active_id());
+    while (tab_strip_model()->count() < first_tabs) {
+      chrome::AddTabAt(browser(), GURL(url::kAboutBlankURL), -1,
+                       /*foreground=*/true);
+    }
+    ids_.push_back(model()->AddSpace("Two", SK_ColorBLUE)->id());
+    ids_.push_back(model()->AddSpace("Three", SK_ColorGREEN)->id());
+    for (size_t i = 1; i < ids_.size(); ++i) {
+      model()->SetActiveSpace(ids_[i]);
+      if (!model()->IsTabInActiveSpace(tab_strip_model()->GetActiveTab())) {
+        chrome::AddTabAt(browser(), GURL(url::kAboutBlankURL), -1,
+                         /*foreground=*/true);
+      }
+    }
+    model()->SetActiveSpace(ids_[0]);
+    ASSERT_EQ(ids_[0], model()->active_id());
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  }
+
+  // The Space on screen, by its place in the switcher: 0, 1 or 2.
+  int Showing() {
+    for (size_t i = 0; i < ids_.size(); ++i) {
+      if (ids_[i] == model()->active_id()) {
+        return static_cast<int>(i);
+      }
+    }
+    return -1;
+  }
+
+  views::ScrollView* list() {
+    VerticalTabStripRegionView* const region =
+        browser_view()->vertical_tab_strip_region_view_for_testing();
+    const TabStripView* const strip =
+        region ? FindTabStripView(region) : nullptr;
+    return strip ? strip->unpinned_tabs_scroll_view() : nullptr;
+  }
+  gfx::Point ListCentre() {
+    views::test::RunScheduledLayout(widget());
+    return list()->GetBoundsInScreen().CenterPoint();
+  }
+  gfx::Point SwitcherCentre() {
+    views::test::RunScheduledLayout(widget());
+    views::View* const switcher =
+        stedding::test::FindDrawnSwitcher(widget()->GetRootView());
+    return switcher ? switcher->GetBoundsInScreen().CenterPoint()
+                    : gfx::Point();
+  }
+  int ListTop() { return list()->GetVisibleRect().y(); }
+
+  // The list slides in as it does for the keys (B32): from the right for
+  // the next Space, from the left for the one before.
+  void ExpectSlideFrom(int side) {
+    if (!stedding::ShouldAnimate(browser()->GetProfile()->GetPrefs())) {
+      return;
+    }
+    ui::Layer* const layer = list()->layer();
+    ASSERT_TRUE(layer) << "no slide";
+    EXPECT_TRUE(layer->GetAnimator()->is_animating()) << "no slide";
+    const float x = layer->transform().To2dTranslation().x();
+    EXPECT_TRUE(side > 0 ? x > 0 : x < 0) << "the slide starts at " << x;
+  }
+
+  // One notch of a mouse's wheel at `at`, in screen DIPs, `ms` after the
+  // event before: `right` and `down` notches, each -1, 0 or 1; `flags`
+  // ui::EF_SHIFT_DOWN and ui::EF_CONTROL_DOWN for the keys held.
+  void Notch(const gfx::Point& at,
+             int right,
+             int down,
+             int flags = ui::EF_NONE,
+             int ms = 300) {
+    now_ += base::Milliseconds(ms);
+#if BUILDFLAG(IS_MAC)
+    Send(at, stedding::test::MakeMacScrollEvent(
+                 right, down, /*precise=*/false,
+                 stedding::test::MacScrollPhase::kNone,
+                 flags & ui::EF_SHIFT_DOWN, flags & ui::EF_CONTROL_DOWN));
+#elif BUILDFLAG(IS_WIN)
+    // A wheel turned up, and a tilt to the right, are positive.
+    if (right) {
+      SendWin(at, WM_MOUSEHWHEEL, right * WHEEL_DELTA, flags);
+    } else {
+      SendWin(at, WM_MOUSEWHEEL, -down * WHEEL_DELTA, flags);
+    }
+#endif
+  }
+
+  // A continuous stream at `at`, each move 8 ms after the one before, by
+  // `right` and `down` pixels or wheel units: on the Mac a trackpad's
+  // two-finger scroll, with its phases, its lift and a little coasting; on
+  // Windows the wheel messages a precision touchpad sends for one.
+  void Stream(const gfx::Point& at, const std::vector<gfx::Vector2dF>& moves) {
+#if BUILDFLAG(IS_MAC)
+    using stedding::test::MacScrollPhase;
+    const auto send = [&](const gfx::Vector2dF& move, MacScrollPhase phase) {
+      now_ += base::Milliseconds(8);
+      Send(at, stedding::test::MakeMacScrollEvent(move.x(), move.y(),
+                                                  /*precise=*/true, phase,
+                                                  false, false));
+    };
+    send({}, MacScrollPhase::kBegan);
+    for (const gfx::Vector2dF& move : moves) {
+      send(move, MacScrollPhase::kChanged);
+    }
+    send({}, MacScrollPhase::kEnded);
+    const gfx::Vector2dF coast = moves.back();
+    send(coast, MacScrollPhase::kMomentumBegan);
+    send(gfx::ScaleVector2d(coast, 0.5f), MacScrollPhase::kMomentumChanged);
+    send({}, MacScrollPhase::kMomentumEnded);
+#elif BUILDFLAG(IS_WIN)
+    for (const gfx::Vector2dF& move : moves) {
+      now_ += base::Milliseconds(8);
+      if (move.x() != 0) {
+        SendWin(at, WM_MOUSEHWHEEL, static_cast<int>(move.x()), ui::EF_NONE);
+      }
+      if (move.y() != 0) {
+        SendWin(at, WM_MOUSEWHEEL, -static_cast<int>(move.y()), ui::EF_NONE);
+      }
+    }
+#endif
+    now_ += base::Milliseconds(400);
+  }
+
+#if BUILDFLAG(IS_MAC)
+  void Send(const gfx::Point& at, std::unique_ptr<ui::ScrollEvent> event) {
+    gfx::Point in_root = at;
+    views::View::ConvertPointFromScreen(widget()->GetRootView(), &in_root);
+    event->set_location(in_root);
+    event->set_root_location(in_root);
+    ui::Event::DispatcherApi(event.get()).set_time_stamp(now_);
+    widget()->OnScrollEvent(event.get());
+  }
+#elif BUILDFLAG(IS_WIN)
+  void SendWin(const gfx::Point& at, UINT message, int delta, int flags) {
+    const HWND hwnd = views::HWNDForWidget(widget());
+    const gfx::Point pixels = display::win::GetScreenWin()->DIPToScreenPoint(at);
+    WORD keys = 0;
+    if (flags & ui::EF_SHIFT_DOWN) {
+      keys |= MK_SHIFT;
+    }
+    if (flags & ui::EF_CONTROL_DOWN) {
+      keys |= MK_CONTROL;
+    }
+    CHROME_MSG msg = {};
+    msg.hwnd = hwnd;
+    msg.message = message;
+    msg.wParam = MAKEWPARAM(keys, static_cast<WORD>(static_cast<short>(delta)));
+    msg.lParam = MAKELPARAM(pixels.x(), pixels.y());
+    msg.pt.x = pixels.x();
+    msg.pt.y = pixels.y();
+    ui::MouseWheelEvent wheel(msg);
+    ui::Event::DispatcherApi(&wheel).set_time_stamp(now_);
+    std::ignore = widget()
+                      ->GetNativeWindow()
+                      ->GetHost()
+                      ->GetEventSink()
+                      ->OnEventFromSource(&wheel);
+  }
+#endif
+
+  std::vector<spaces::SpaceId> ids_;
+  base::TimeTicks now_ = base::TimeTicks::Now();
+};
+
+// Sideways, a notch a Space: over the list, the switcher and the rail, Shift
+// with the wheel as the tilt does, a fast wheel stepping once a cooldown, no
+// wrap past either end, and the keys' slide, or none under reduced motion.
+IN_PROC_BROWSER_TEST_F(SpaceWheelTest, ASidewaysWheelStepsThroughTheSpaces) {
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces(2));
+  const gfx::Point over_list = ListCentre();
+
+  Notch(over_list, 1, 0);
+  EXPECT_EQ(1, Showing()) << "a tilt to the right: the next Space";
+  ExpectSlideFrom(+1);
+  Notch(over_list, 1, 0, ui::EF_NONE, 50);
+  Notch(over_list, 1, 0, ui::EF_NONE, 50);
+  EXPECT_EQ(1, Showing()) << "notches within the cooldown step no further";
+  Notch(over_list, 1, 0);
+  EXPECT_EQ(2, Showing());
+  Notch(over_list, 1, 0);
+  EXPECT_EQ(2, Showing()) << "no wrap past the last Space";
+  Notch(over_list, -1, 0);
+  EXPECT_EQ(1, Showing()) << "a tilt to the left: the Space before";
+  ExpectSlideFrom(-1);
+
+  // Shift with a vertical wheel, down as to the right; on the Mac the
+  // system turns it into a sideways scroll before it comes, as the tilt
+  // above, or sends it as it is, with Shift held.
+  Notch(over_list, 0, 1, ui::EF_SHIFT_DOWN);
+  EXPECT_EQ(2, Showing()) << "Shift and the wheel down: the next Space";
+  Notch(over_list, 0, -1, ui::EF_SHIFT_DOWN);
+  Notch(over_list, 0, -1, ui::EF_SHIFT_DOWN);
+  EXPECT_EQ(0, Showing()) << "Shift and the wheel up: back";
+  Notch(over_list, 0, -1, ui::EF_SHIFT_DOWN);
+  EXPECT_EQ(0, Showing()) << "no wrap past the first Space";
+
+  // Over the switcher: sideways steps, a plain vertical wheel does not.
+  const gfx::Point over_switcher = SwitcherCentre();
+  ASSERT_FALSE(over_switcher.IsOrigin());
+  Notch(over_switcher, 0, 1);
+  Notch(over_switcher, 0, -1);
+  EXPECT_EQ(0, Showing()) << "a vertical wheel over the chips switches";
+  Notch(over_switcher, 1, 0);
+  EXPECT_EQ(1, Showing());
+
+  // In the rail.
+  vertical_tab_strip_state_controller()->SetExpandOnHoverEnabled(false);
+  vertical_tab_strip_state_controller()->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }));
+  ASSERT_TRUE(vertical_tab_strip_state_controller()->IsCollapsed());
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  views::test::RunScheduledLayout(widget());
+  const gfx::Point over_rail = browser_view()
+                                   ->vertical_tab_strip_region_view_for_testing()
+                                   ->GetBoundsInScreen()
+                                   .CenterPoint();
+  Notch(over_rail, 1, 0);
+  EXPECT_EQ(2, Showing()) << "the rail";
+  Notch(SwitcherCentre(), 0, -1);
+  EXPECT_EQ(2, Showing()) << "a vertical wheel over the rail's chips switches";
+  Notch(SwitcherCentre(), -1, 0);
+  EXPECT_EQ(1, Showing()) << "the rail's chips";
+  vertical_tab_strip_state_controller()->RequestCollapse(false);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }));
+  ASSERT_FALSE(vertical_tab_strip_state_controller()->IsCollapsed());
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+
+  // Reduced motion: the step, with no slide.
+  browser()->GetProfile()->GetPrefs()->SetBoolean(stedding::prefs::kUiAnimate,
+                                                  false);
+  Notch(ListCentre(), 1, 0);
+  EXPECT_EQ(2, Showing());
+  EXPECT_TRUE(!list()->layer() || !list()->layer()->GetAnimator()->is_animating())
+      << "a slide under reduced motion";
+}
+
+// A vertical scroll is the list's: a wheel's notches and a touchpad's or
+// trackpad's two-finger scroll, one drifting sideways included, scroll the
+// list and change no Space. A sideways two-finger scroll switches once: the
+// Mac's swipe (B35), or on Windows one step for the whole stream.
+IN_PROC_BROWSER_TEST_F(SpaceWheelTest, AVerticalScrollStillScrollsTheList) {
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces(40));
+  const gfx::Point over_list = ListCentre();
+  // The last tab opened is the active one, and the list keeps the active row
+  // in view, so it rests at its foot; the first row made active brings it
+  // back to its top, where the steps below scroll down from.
+  // The rows above the first tab's may keep it a little short of 0.
+  tab_strip_model()->ActivateTabAt(0);
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  int start = -1;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    const int now = ListTop();
+    const bool still = now == start;
+    start = now;
+    return still && now < 200;
+  })) << "the list did not come back near its top: " << ListTop();
+
+  Notch(over_list, 0, 1);
+  Notch(over_list, 0, 1);
+  EXPECT_EQ(0, Showing());
+  const int after_notches = ListTop();
+  EXPECT_GT(after_notches, start) << "the wheel did not scroll the list";
+
+  std::vector<gfx::Vector2dF> drifting;
+  for (int i = 0; i < 20; ++i) {
+    drifting.emplace_back(i % 3 == 0 ? 6.0f : 0.0f, 12.0f);
+  }
+  Stream(over_list, drifting);
+  EXPECT_EQ(0, Showing()) << "a vertical two-finger scroll switched";
+  EXPECT_GT(ListTop(), after_notches)
+      << "the two-finger scroll did not scroll the list";
+
+  Stream(over_list, std::vector<gfx::Vector2dF>(15, gfx::Vector2dF(20, 1)));
+  EXPECT_EQ(1, Showing()) << "a sideways two-finger scroll: the next Space";
+  Stream(over_list, std::vector<gfx::Vector2dF>(15, gfx::Vector2dF(20, 1)));
+  EXPECT_EQ(2, Showing()) << "and another, the one after";
+  Stream(over_list, std::vector<gfx::Vector2dF>(15, gfx::Vector2dF(-20, 1)));
+  EXPECT_EQ(1, Showing()) << "back, one Space for the whole stream";
+}
+
+#if BUILDFLAG(IS_MAC)
+// No ⌃ with the wheel on the Mac (the owner, 2026-10-21): it scrolls the
+// list as a plain wheel does.
+IN_PROC_BROWSER_TEST_F(SpaceWheelTest, ControlWithTheWheelIsTheListsOnTheMac) {
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces(2));
+  Notch(ListCentre(), 0, 1, ui::EF_CONTROL_DOWN);
+  Notch(ListCentre(), 0, -1, ui::EF_CONTROL_DOWN);
+  EXPECT_EQ(0, Showing());
+}
+#endif
+
+#if BUILDFLAG(IS_WIN)
+// On Windows Ctrl with the wheel steps over the sidebar and the rail, a
+// plain mouse having no sideways wheel (the owner, 2026-10-21), and leaves
+// the list where it was; over the page it still zooms the page.
+IN_PROC_BROWSER_TEST_F(SpaceWheelTest, CtrlWheelStepsOverTheSidebarOnly) {
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces(40));
+  const gfx::Point over_list = ListCentre();
+  Notch(over_list, 0, 1, ui::EF_CONTROL_DOWN);
+  EXPECT_EQ(1, Showing()) << "Ctrl and the wheel down: the next Space";
+  Notch(over_list, 0, -1, ui::EF_CONTROL_DOWN);
+  EXPECT_EQ(0, Showing()) << "Ctrl and the wheel up: back";
+  EXPECT_EQ(0, ListTop()) << "Ctrl and the wheel scrolled the list";
+
+  ASSERT_TRUE(embedded_test_server()->Start());
+  content::WebContents* const page = browser_view()->GetActiveWebContents();
+  ASSERT_TRUE(content::NavigateToURL(
+      page, embedded_test_server()->GetURL("a.test", "/title1.html")));
+  content::WaitForHitTestData(page->GetPrimaryMainFrame());
+  const double zoom = content::HostZoomMap::GetZoomLevel(page);
+  Notch(page->GetContainerBounds().CenterPoint(), 0, -1, ui::EF_CONTROL_DOWN);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return content::HostZoomMap::GetZoomLevel(page) != zoom; }))
+      << "Ctrl and the wheel over the page did not zoom it";
+  EXPECT_EQ(0, Showing()) << "Ctrl and the wheel over the page switched";
+}
+#endif
+
+}  // namespace
+
+#endif  // BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
