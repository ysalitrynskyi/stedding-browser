+    ASSERT_TRUE(base::test::RunUntil(toast_up)) << "no undo toast";
+    ASSERT_TRUE(base::test::RunUntil(bars_up)) << "the bar went with the tab";
+    // It stays up for the steps below.
+    toasts->GetToastCloseTimerForTesting()->Stop();
+    EXPECT_TRUE(base::test::RunUntil(under_the_bars))
+        << "the toast's visible top is at " << toast_top()
+        << ", the infobars end at " << bars->GetBoundsInScreen().bottom();
+
+    manager->RemoveAllInfoBars(/*animate=*/false);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !bars_up(); }));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return toast_top() >= row_bottom() && toast_top() <= row_bottom() + 2;
+    })) << "with no bar the toast goes back under the row: its top at "
+        << toast_top() << ", the row ends at " << row_bottom();
+
+    ASSERT_NO_FATAL_FAILURE(show_bar());
+    EXPECT_TRUE(base::test::RunUntil(under_the_bars))
