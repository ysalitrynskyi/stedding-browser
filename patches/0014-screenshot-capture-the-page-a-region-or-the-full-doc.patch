+#ifndef CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CAPTURE_H_
+#define CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CAPTURE_H_
+
+class BrowserWindowInterface;
+
+namespace stedding {
+
+// What to capture of the active tab. Every mode ends the same way: a PNG in
+// the profile's Downloads folder named after the page, and the same image on
+// the clipboard (docs/features/screenshot.md).
+enum class CaptureMode {
+  // The page as shown, viewport only.
+  kVisible,
+  // The user drags out a rectangle over the page first.
+  kRegion,
+  // The whole document, past the viewport, through the DevTools protocol.
+  kFullPage,
+};
+
+void CaptureScreenshot(BrowserWindowInterface* browser, CaptureMode mode);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CAPTURE_H_
