--- /dev/null
+++ b/chrome/browser/ui/stedding/download_flight.cc
@@ -0,0 +1,76 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/download_flight.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include "ui/gfx/geometry/point.h"
+
+namespace stedding {
+
+namespace {
+
+int Lerp(int from, int to, double t) {
+  return static_cast<int>(std::lround(from + (to - from) * t));
+}
+
+}  // namespace
+
+double DownloadEaseInOut(double t) {
+  t = std::clamp(t, 0.0, 1.0);
+  if (t < 0.5) {
+    return 4.0 * t * t * t;
+  }
+  const double rest = -2.0 * t + 2.0;
+  return 1.0 - rest * rest * rest / 2.0;
+}
+
+DownloadFlightFrame DownloadFlightAt(double t,
+                                     const gfx::Rect& page,
+                                     const gfx::Rect& button) {
+  t = std::clamp(t, 0.0, 1.0);
+  const double along = DownloadEaseInOut(t);
+  const gfx::Point from = page.CenterPoint();
+  const gfx::Point to = button.CenterPoint();
+  const gfx::Point centre(Lerp(from.x(), to.x(), along),
+                          Lerp(from.y(), to.y(), along));
+  const int landing = std::max(kDownloadChipSmallestDip,
+                               std::min(button.width(), button.height()));
+  // The chip keeps its size over the page and shrinks over the second half,
+  // as it reaches the sidebar.
+  const double shrink = DownloadEaseInOut((t - 0.5) * 2.0);
+  const int diameter = Lerp(kDownloadChipDip, landing, shrink);
+
+  DownloadFlightFrame frame;
+  frame.chip = gfx::Rect(centre.x() - diameter / 2, centre.y() - diameter / 2,
+                         diameter, diameter);
+  if (t < 0.125) {
+    frame.opacity = static_cast<float>(t / 0.125);
+  } else if (t > 0.75) {
+    frame.opacity = static_cast<float>((1.0 - t) / 0.25);
+  } else {
+    frame.opacity = 1.0f;
+  }
+  return frame;
+}
+
+DownloadRingFrame DownloadRingAt(double t, bool still) {
+  DownloadRingFrame frame;
+  if (still) {
+    frame.scale = kDownloadRingStill;
+    frame.opacity = kDownloadRingOpacity;
+    return frame;
+  }
+  t = std::clamp(t, 0.0, 1.0);
+  // Out fast, settling as it fades.
+  const double grown = 1.0 - (1.0 - t) * (1.0 - t);
+  frame.scale =
+      static_cast<float>(1.0 + (kDownloadRingLargest - 1.0) * grown);
+  frame.opacity = static_cast<float>(kDownloadRingOpacity * (1.0 - t));
+  return frame;
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/download_flight.h b/chrome/browser/ui/stedding/download_flight.h
