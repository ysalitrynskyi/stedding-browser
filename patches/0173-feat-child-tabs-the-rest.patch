+// R56: a pin is no one's child and folds nothing, whatever it was before it
+// was pinned, and the link stays for when it is unpinned.
+bool IsPin(const tabs::TabInterface* tab) {
+  if (tab->IsPinned()) {
+    return true;
+  }
+  BrowserWindowInterface* const window =
+      const_cast<tabs::TabInterface*>(tab)->GetBrowserWindowInterface();
+  const spaces::SpaceModel* const model =
+      window ? spaces::SpaceModel::From(window) : nullptr;
+  return model && model->IsSpacePinned(tab);
+}
+
+// Whether "Show tabs under the tab that opened them" is on for `model`'s
+// profile.
+bool NestsChildren(const TabStripModel& model) {
+  const Profile* const profile = model.profile();
+  return profile &&
+         profile->GetPrefs()->GetBoolean(prefs::kNestChildTabs);
+}
+
+// The tab of `model` that `contents` was opened from, or null.
+tabs::TabInterface* ParentInStrip(const TabStripModel& model,
+                                  const content::WebContents* contents) {
+  const std::string parent = TabParentToken(contents);
+  if (parent.empty()) {
+    return nullptr;
+  }
+  for (int i = 0; i < model.count(); ++i) {
+    tabs::TabInterface* const tab = model.GetTabAtIndex(i);
+    if (tab->GetContents() != contents &&
+        TabToken(tab->GetContents()) == parent) {
+      return tab;
+    }
+  }
+  return nullptr;
+}
+
+// Whether `ancestor` is above `tab` in the tree, within `model`. A tree read
+// from a session may hold a loop, so the walk stops after every row.
+bool DescendsFrom(const TabStripModel& model,
+                  const tabs::TabInterface* tab,
+                  const tabs::TabInterface* ancestor) {
+  const tabs::TabInterface* step = tab;
+  for (int depth = 0; step && depth < model.count(); ++depth) {
+    step = ParentInStrip(model, step->GetContents());
+    if (step == ancestor) {
+      return step != nullptr;
+    }
+  }
+  return false;
+}
+
 // The windows told that a tab of theirs has a new parent (R59).
