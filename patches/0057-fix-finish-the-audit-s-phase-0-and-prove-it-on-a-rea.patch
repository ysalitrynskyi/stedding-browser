@@ -0,0 +1,81 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_STEDDING_RENAME_FIELD_WATCHER_H_
+#define CHROME_BROWSER_UI_VIEWS_STEDDING_RENAME_FIELD_WATCHER_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "ui/events/event_handler.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+
+namespace views {
+class Textfield;
+}  // namespace views
+
+namespace stedding {
+
+// Ends a rename in place that the user walked away from.
+//
+// A tab row, a folder header and the Space switcher rename in place: a text
+// field takes the title's slot while it shows. Enter commits and Escape
+// cancels, and until 2026-09-28 those were the only ways out. A field left
+// open stayed over its row, and every later click on the row went to the
+// field, so the tab could no longer be selected; an open Space rename hid
+// every Space chip (PLAN.md TAB-1).
+//
+// While the field shows, a press anywhere else in its window, or the focus
+// moving to another view there, runs `on_walked_away`, which ends the rename
+// and keeps what was typed, as Finder and Arc do. A window that only goes
+// inactive keeps the rename open: its focus manager gives the field its focus
+// back when the window returns.
+//
+// `on_walked_away` runs from a posted task, never inside the event that
+// caused it, so the owner may rebuild its views there.
+class RenameFieldWatcher : public views::ViewObserver, public ui::EventHandler {
+ public:
+  // `field` must outlive this watcher; owners hold both, with the field as a
+  // child view and this as a member.
+  RenameFieldWatcher(views::Textfield* field,
+                     base::RepeatingClosure on_walked_away);
+  RenameFieldWatcher(const RenameFieldWatcher&) = delete;
+  RenameFieldWatcher& operator=(const RenameFieldWatcher&) = delete;
+  ~RenameFieldWatcher() override;
+
+  // views::ViewObserver:
+  void OnViewVisibilityChanged(views::View* observed_view,
+                               views::View* starting_view,
+                               bool visible) override;
+  void OnViewAddedToWidget(views::View* observed_view) override;
+  void OnViewRemovedFromWidget(views::View* observed_view) override;
+  void OnViewBlurred(views::View* observed_view) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+  // ui::EventHandler, as a pre-target handler on the window's root view: sees
+  // every press in the window before the view it lands on.
+  void OnMouseEvent(ui::MouseEvent* event) override;
+  void OnGestureEvent(ui::GestureEvent* event) override;
+
+ private:
+  bool IsOpen() const;
+  // Watches the root view of the field's window while the field shows, and
+  // nothing otherwise.
+  void UpdateRoot();
+  void OnPressAt(ui::Event* event);
+  void EndAfterPress();
+  void EndAfterBlur();
+
+  raw_ptr<views::Textfield> field_;
+  base::RepeatingClosure on_walked_away_;
+  raw_ptr<views::View> root_ = nullptr;
+  base::ScopedObservation<views::View, views::ViewObserver> observation_{this};
+  base::WeakPtrFactory<RenameFieldWatcher> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STEDDING_RENAME_FIELD_WATCHER_H_
diff --git a/chrome/browser/ui/views/stedding/rename_field_watcher_unittest.cc b/chrome/browser/ui/views/stedding/rename_field_watcher_unittest.cc
