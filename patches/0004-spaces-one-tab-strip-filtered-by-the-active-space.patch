@@ -0,0 +1,56 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_TAB_SPACE_RESTORE_DATA_H_
+#define CHROME_BROWSER_UI_SPACES_TAB_SPACE_RESTORE_DATA_H_
+
+#include <map>
+#include <string>
+
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace spaces {
+
+// The key a tab's Space is written under in the session's per-tab extra data.
+inline constexpr char kSessionTabSpaceKey[] = "stedding.space";
+
+// Carries a restored tab's Space from session restore to the SpaceModel.
+//
+// A tab is rebuilt before it belongs to a window, so there is no SpaceModel to
+// tell at that point. The id is parked here and collected the first time
+// anything asks which Space the tab is in.
+class TabSpaceRestoreData
+    : public content::WebContentsUserData<TabSpaceRestoreData> {
+ public:
+  ~TabSpaceRestoreData() override;
+
+  const std::string& space_id() const { return space_id_; }
+  bool space_pinned() const { return space_pinned_; }
+
+ private:
+  friend class content::WebContentsUserData<TabSpaceRestoreData>;
+
+  TabSpaceRestoreData(content::WebContents* contents,
+                      std::string space_id,
+                      bool space_pinned);
+
+  const std::string space_id_;
+  const bool space_pinned_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// Parks the Space id from `extra_data` on `web_contents`, if it has one. Called
+// while a session's tabs are being rebuilt.
+void RestoreSpaceFromExtraData(
+    content::WebContents* web_contents,
+    const std::map<std::string, std::string>& extra_data);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_TAB_SPACE_RESTORE_DATA_H_
