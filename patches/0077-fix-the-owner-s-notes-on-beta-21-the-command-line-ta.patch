+    views::test::RunScheduledLayout(widget);
+    region()->SetHoveredForTesting(false);
+    region()->OnPointerAtForTesting(LeadingEdge());
+    ASSERT_TRUE(region()->is_expanded_on_hover()) << HoverState();
+    region()->SetHoveredForTesting(true);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return region()->is_expanded_on_hover() && !Animating(); }))
+        << HoverState();
+    views::test::RunScheduledLayout(widget);
+    // The band ends where the page's container starts, as the strip reads it
+    // (VerticalTabStripRegionView::TitleBarBottom), or below the strip's own
+    // top row where that is lower; the slid-out strip shows no top row.
+    const int band = InRoot(browser_view()->contents_container()).y() -
+                     Strip().y();
+    for (int index = 0; index < essentials; ++index) {
+      SCOPED_TRACE(testing::Message() << "card " << index);
+      TabView* const card =
+          stedding::test::FindDrawnRow(root(), strip->GetTabAtIndex(index));
+      ASSERT_TRUE(card);
+      const gfx::Rect bounds = InRoot(card);
+      ASSERT_FALSE(bounds.IsEmpty());
+      if (bounds.y() - Strip().y() < band) {
+        reached_the_band = true;
+      }
+      seen += base::StrCat({"card ", bounds.ToString(), " strip ",
+                            Strip().ToString(), " band ",
+                            base::NumberToString(band), " page ",
+                            InRoot(browser_view()->contents_container())
+                                .ToString(),
+                            " row ", Row().ToString(), "; "});
+      for (const gfx::Point& point :
+           {gfx::Point(bounds.CenterPoint().x(), bounds.y() + 2),
+            bounds.CenterPoint(),
+            gfx::Point(bounds.CenterPoint().x(), bounds.bottom() - 3)}) {
+        EXPECT_EQ(HTCLIENT, widget->GetNonClientComponent(point))
+            << point.ToString() << " in " << bounds.ToString()
+            << ", the band ending " << band << " below the strip's top at "
+            << Strip().y();
+      }
+    }
+    region()->SetHoveredForTesting(false);
+    region()->OnMouseExited(ui::MouseEvent(
+        ui::EventType::kMouseExited, gfx::Point(), gfx::Point(),
+        base::TimeTicks::Now(), ui::EF_NONE, ui::EF_NONE));
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return !region()->is_expanded_on_hover() && !Animating(); }))
+        << HoverState();
+    region()->SetHoveredForTesting(std::nullopt);
+  }
+  EXPECT_TRUE(reached_the_band)
+      << "no card reached the title bar's band, so this checked nothing: "
+      << seen;
+}
+
 }  // namespace
