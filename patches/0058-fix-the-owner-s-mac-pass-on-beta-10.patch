+constexpr base::TimeDelta kSampleLate = base::Milliseconds(1500);
+constexpr base::TimeDelta kSampleScroll = base::Milliseconds(250);
+constexpr base::TimeDelta kSampleScrollMid = base::Milliseconds(700);
+constexpr base::TimeDelta kSampleScrollEnd = base::Milliseconds(1600);
+constexpr base::TimeDelta kSampleTimeout = base::Seconds(1);
+
+}  // namespace
 
