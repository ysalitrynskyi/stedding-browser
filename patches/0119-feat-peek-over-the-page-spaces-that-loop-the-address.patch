+// sidebar Y51: on a top line too narrow for Back, Forward, Reload and the
+// window's menu, the three step out and the menu stays: with the address row
+// gone it is the menu's only place.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, TheMenuStaysOnANarrowTopLine) {
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Page("a.test", "/title1.html")));
