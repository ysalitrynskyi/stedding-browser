+// The row's surface: `surface` in `bar`, its top corners rounded as the
+// card's are, and one hairline along its bottom where the row meets the page,
+// a tenth of the contrast colour: row and page are one colour, so the line
+// is what tells them apart (toolbar T15).
+void PaintBarSurface(gfx::Canvas* canvas,
+                     const gfx::RectF& surface,
+                     SkColor bar) {
+  const float radius =
+      static_cast<float>(stedding::kContentsCornerRadius.Get());
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(bar);
+  SkRRect rrect;
+  const SkVector radii[4] = {
+      {radius, radius}, {radius, radius}, {0, 0}, {0, 0}};
+  rrect.setRectRadii(gfx::RectFToSkRect(surface), radii);
+  canvas->DrawPath(SkPath::RRect(rrect), flags);
+  const SkColor hairline = color_utils::AlphaBlend(
+      color_utils::GetColorWithMaxContrast(bar), bar, 0.10f);
+  canvas->FillRect(gfx::Rect(static_cast<int>(surface.x()),
+                             static_cast<int>(surface.bottom()) - 1,
+                             static_cast<int>(surface.width()), 1),
+                   hairline);
+}
