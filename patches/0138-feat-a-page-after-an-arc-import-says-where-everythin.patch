+                                           GURL("chrome://settings/stedding")));
+  page = tabs().GetActiveWebContents();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnThePage("return !!pick('#fromArc cr-button');"))
+        .ExtractBool();
+  })) << "the row is not there";
+  ASSERT_TRUE(content::ExecJs(
+      page, OnThePage("pick('#fromArc cr-button').click();")));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return PagesOpen() >= 1; }));
+}
+
+// import I47, welcome W20: Move everything from Arc on step 2 leaves the flow
+// where it was, with the page in the window behind it.
+IN_PROC_BROWSER_TEST_F(FromArcPageTest, TheWelcomeFlowLeavesThePageBehindIt) {
+  WriteSidebar();
+  stedding::ShowWelcomeDialog(*browser(), "import");
+  content::WebContents* flow = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    for (content::WebContents* const contents :
+         content::GetAllWebContents()) {
+      if (contents->GetVisibleURL().host() == "stedding-welcome") {
+        flow = contents;
+      }
+    }
+    return flow && !flow->IsLoading();
+  }));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(flow, R"(
+        [...document.querySelectorAll('.arc-import button')].some(
+            button => /Move everything from Arc/.test(button.textContent)))")
+        .ExtractBool();
+  })) << "step 2 offers no Arc";
+  ASSERT_TRUE(content::ExecJs(flow, R"(
+      [...document.querySelectorAll('.arc-import label')].forEach(label => {
+        if (/History|Passwords/.test(label.textContent)) {
+          const box = label.querySelector('input');
+          if (box.checked) {
+            box.click();
+          }
+        }
+      });
+      [...document.querySelectorAll('.arc-import button')].find(
+          button => /Move everything from Arc/.test(button.textContent)).click();
+  )"));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return PagesOpen() == 1; }))
+      << "the import opened no page";
+  EXPECT_EQ("import", content::EvalJs(flow, "location.hash.slice(1)"));
+  EXPECT_TRUE(content::EvalJs(flow, "!!document.querySelector('.arc-import')")
+                  .ExtractBool())
+      << "the flow left its step";
+}
+
+}  // namespace
