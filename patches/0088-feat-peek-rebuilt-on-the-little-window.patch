+  static constexpr auto kSteps = std::to_array<std::string_view>(
+      {"login", "logon", "signin", "sign_in", "sign-in", "oauth", "oauth2",
+       "sso", "authorize", "saml", "auth"});
+  std::string_view path = url.path();
+  while (!path.empty()) {
+    const size_t start = path.find_first_not_of('/');
+    if (start == std::string_view::npos) {
+      break;
+    }
+    path.remove_prefix(start);
+    const size_t end = path.find('/');
+    const std::string_view step = path.substr(0, end);
+    for (const std::string_view sign_in : kSteps) {
+      if (step == sign_in) {
+        return true;
+      }
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    path.remove_prefix(end);
+  }
+  return false;
+}
