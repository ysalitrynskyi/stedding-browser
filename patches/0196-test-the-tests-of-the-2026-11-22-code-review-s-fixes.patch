+// P28-1e, tabs R60: a parent whose only child is a pin, or is in another
+// Space, has nothing on its list to fold. Fold Child Tabs is not offered, and
+// a fold made counts nothing. The menu offered it, and the row then said +1
+// with no row gone.
+IN_PROC_BROWSER_TEST_F(ChildTabsW2B21Test,
+                       AParentWithNoChildOnItsListOffersNoFold) {
+  constexpr int kFold = TabStripModel::CommandSteddingFoldChildTabs;
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  tabs()->ActivateTabAt(index(page));
+  ASSERT_TRUE(stedding::IsTabMenuRowVisible(*tabs(), index(page), kFold))
+      << "the premise: a child to fold";
+
+  {
+    SCOPED_TRACE("the only child is a pin");
+    model->SetSpacePinned(child, true);
+    EXPECT_FALSE(stedding::HasChildTabs(*tabs(), page));
+    EXPECT_FALSE(stedding::IsTabMenuRowVisible(*tabs(), index(page), kFold))
+        << "Fold Child Tabs offered for a pin";
+    stedding::SetChildrenFolded(page, true);
+    EXPECT_EQ(0, stedding::FoldedChildCount(*tabs(), page));
+    stedding::SetChildrenFolded(page, false);
+    model->SetSpacePinned(child, false);
+    ASSERT_TRUE(stedding::HasChildTabs(*tabs(), page))
+        << "unpinned, the child is the page's again";
+  }
+  {
+    SCOPED_TRACE("the only child is in another Space");
+    const spaces::SpaceId other = model->AddSpace("Other", SK_ColorBLUE)->id();
+    model->SetSpaceForTab(child, other);
+    ASSERT_EQ(other, model->SpaceForTab(child));
+    EXPECT_FALSE(stedding::HasChildTabs(*tabs(), page));
+    EXPECT_FALSE(stedding::IsTabMenuRowVisible(*tabs(), index(page), kFold))
+        << "Fold Child Tabs offered for a tab of another Space";
+    stedding::SetChildrenFolded(page, true);
+    EXPECT_EQ(0, stedding::FoldedChildCount(*tabs(), page));
+  }
+}
