+// P34-1e: right to left the name floated about the downloads button's width
+// to the side of the hovered chip, over a neighbour, which looked named.
+IN_PROC_BROWSER_TEST_F(SpaceChipPillRtlW2B26Test,
+                       RightToLeftTheNameFloatsOverTheChip) {
+  ASSERT_TRUE(base::i18n::IsRTL());
+  ExpectTheNameOverTheChip();
+}
