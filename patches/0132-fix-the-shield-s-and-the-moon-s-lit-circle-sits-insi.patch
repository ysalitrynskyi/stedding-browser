+// toolbar T60 (the owner, 2026-11-05, from a capture; BACKLOG S-423): the
+// circle behind a lit shield or moon was the buttons' ink drop in its active
+// state: as wide as the row is tall and as strong as a press. It sits inside
+// the row now, no larger than a neighbour's hover circle, with room above and
+// below and its icon on its middle, one size and one colour for both, dimmer
+// than a press and still plain, in a light window and a dark one, on a row of
+// any colour.
+IN_PROC_BROWSER_TEST_F(PageColourRowTest, TheLitCircleSitsInsideTheRow) {
+  Profile* const profile = browser()->GetProfile();
+  g_browser_process->local_state()->SetBoolean(
+      stedding::prefs::kBlockerEnabled, true);
+  // Dark pages on with no site on its list: the moon is lit, and each page
+  // keeps the colour this test gives it.
+  stedding::SetDarkPagesMode(profile, stedding::DarkPagesMode::kOnlyThese);
+  stedding::SetDarkPagesOn(profile, true);
+  BrowserElementsViews* const elements = BrowserElementsViews::From(browser());
+  ASSERT_TRUE(elements);
+  stedding::BlockerButton* const shield =
+      elements->GetViewAs<stedding::BlockerButton>(
+          stedding::BlockerButton::kElementId);
+  stedding::DarkPagesButton* const moon =
+      elements->GetViewAs<stedding::DarkPagesButton>(
+          stedding::DarkPagesButton::kElementId);
+  ASSERT_TRUE(shield && moon);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return shield->is_on() && moon->is_on() && shield->GetVisible() &&
+           moon->GetVisible();
+  })) << "the shield and the moon are not lit";
+  views::View* const back = view()->toolbar_button_provider()->GetBackButton();
+  ASSERT_TRUE(back);
+  // A neighbour's hover circle: its ink drop's highlight path.
+  const gfx::Rect hover =
+      gfx::ToEnclosingRect(
+      gfx::SkRectToRectF(views::GetHighlightPath(back).getBounds()));
+
+  for (const auto scheme : {ThemeService::BrowserColorScheme::kLight,
+                            ThemeService::BrowserColorScheme::kDark}) {
+    ThemeServiceFactory::GetForProfile(profile)->SetBrowserColorScheme(scheme);
+    const bool dark = scheme == ThemeService::BrowserColorScheme::kDark;
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return view()->GetWidget()->GetColorProviderKeyForTesting().color_mode ==
+             (dark ? ui::ColorProviderKey::ColorMode::kDark
+                   : ui::ColorProviderKey::ColorMode::kLight);
+    }));
+    for (const SkColor page_colour :
+         {SK_ColorWHITE, SkColorSetRGB(0x99, 0x99, 0x99),
+          SkColorSetRGB(0x10, 0x20, 0x30)}) {
+      SCOPED_TRACE(base::StrCat(
+          {dark ? "dark window, " : "light window, ",
+           color_utils::SkColorToRgbaString(page_colour), " page"}));
+      ASSERT_TRUE(content::ExecJs(
+          page(), "document.documentElement.style.background = 'rgb(" +
+                      color_utils::SkColorToRgbString(page_colour) + ")';"));
+      ASSERT_TRUE(WaitForTheRow(page_colour));
+      views::test::RunScheduledLayout(view());
+      const SkColor row_colour = *row()->color();
+      const gfx::Rect toolbar = view()->toolbar()->GetBoundsInScreen();
+
+      const auto check = [&](stedding::LitToolbarButton* button,
+                             std::string_view name) {
+        SCOPED_TRACE(name);
+        const gfx::Rect circle = button->GetLitCircleBounds();
+        gfx::Rect on_screen = circle;
+        views::View::ConvertRectToScreen(button, &on_screen);
+        EXPECT_EQ(circle.width(), circle.height()) << "not a circle";
+        // No larger than the address field's chips, 21 DIP (T42), beside it
+        // on the row, and smaller than the row's buttons' hover.
+        EXPECT_LE(circle.width(), 21) << "larger than a chip's hover";
+        EXPECT_LT(circle.width(), hover.width())
+            << "as large as a neighbour's hover circle";
+        EXPECT_GE(on_screen.y() - toolbar.y(), 5)
+            << "too little room above: the row is " << toolbar.ToString()
+            << ", the circle " << on_screen.ToString();
+        EXPECT_GE(toolbar.bottom() - on_screen.bottom(), 5)
+            << "too little room below: the row is " << toolbar.ToString()
+            << ", the circle " << on_screen.ToString();
+        // The icon's box, the only child the button lays out with no text.
+        for (const views::View* const child : button->children()) {
+          if (child->GetVisible() && !child->bounds().IsEmpty()) {
+            EXPECT_EQ(circle.CenterPoint(), child->bounds().CenterPoint())
+                << "the icon is off the circle's middle";
+          }
+        }
+        const ui::ColorProvider* const colours = button->GetColorProvider();
+        const double lit =
+            HighlightContrast(button->GetLitCircleColor(), 1.0f, row_colour);
+        const double press = HighlightContrast(
+            colours->GetColor(kColorToolbarInkDropRipple), 1.0f, row_colour);
+        EXPECT_GE(lit, 1.1) << "the lit circle hardly shows";
+        EXPECT_LT(lit, press) << "the lit circle is as strong as a press";
+      };
+      check(shield, "the shield");
+      check(moon, "the moon");
+      EXPECT_EQ(shield->GetLitCircleBounds().size(),
+                moon->GetLitCircleBounds().size());
+      EXPECT_EQ(shield->GetLitCircleColor(), moon->GetLitCircleColor());
+    }
+  }
+}
