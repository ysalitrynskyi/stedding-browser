+// import I42: one line that counts what came in and names what did not.
+TEST(ChromiumFamilyImporterTest, DescribeCountsEveryPart) {
+  ChromiumFamilyResult result;
+  result.name = u"Dia";
+  result.bookmarks = 2;
+  result.history = 1;
+  result.passwords.added = 3;
+  result.passwords_bound = 1;
+  result.passwords.kept = 1;
+  EXPECT_EQ(
+      u"Brought in from Dia: 2 bookmarks, 1 history entry and 3 passwords. 1 "
+      u"password sealed for Dia alone could not be read. 1 password saved "
+      u"with another password was kept as saved.",
+      DescribeChromiumFamilyResult(result));
+
+  // BACKLOG S-346: logins past the limit are named.
+  ChromiumFamilyResult capped;
+  capped.name = u"Dia";
+  capped.passwords.added = 10000;
+  capped.passwords_past_the_cap = 2;
+  EXPECT_EQ(
+      u"Brought in from Dia: 10000 passwords. 2 passwords past the limit of "
+      u"10,000 were left out.",
+      DescribeChromiumFamilyResult(capped));
+
+  ChromiumFamilyResult denied;
+  denied.name = u"Dia";
+  denied.passwords_asked = true;
+  denied.key_denied = true;
+  const std::u16string line = DescribeChromiumFamilyResult(denied);
+  EXPECT_EQ(0u, line.find(u"Nothing new came in from Dia."));
+  EXPECT_NE(std::u16string::npos, line.find(u"no password came over"));
+
+  ChromiumFamilyResult busy;
+  busy.name = u"Dia";
+  busy.already_running = true;
+  EXPECT_EQ(u"An import from Dia is running already.",
+            DescribeChromiumFamilyResult(busy));
+}
