+// Stedding (toolbar S-41): DownloadButtonViews' ring and badge, on the sidebar's
+// downloads button.
+class SteddingDownloadButtonViews : public DownloadButton {
+ public:
+  SteddingDownloadButtonViews(views::View& view,
+                              actions::ActionItem& action_item)
+      : view_(view), action_item_(action_item) {}
+  SteddingDownloadButtonViews(const SteddingDownloadButtonViews&) = delete;
+  SteddingDownloadButtonViews& operator=(const SteddingDownloadButtonViews&) =
+      delete;
+  ~SteddingDownloadButtonViews() override = default;
+
+  // DownloadButton:
+  bool IsShowing() const override { return view_->IsDrawn(); }
+
+  SkColor GetColor(ui::ColorId color_id) const override {
+    const ui::ColorProvider* const color_provider = view_->GetColorProvider();
+    return color_provider ? color_provider->GetColor(color_id)
+                          : SK_ColorTRANSPARENT;
+  }
+
+  void AnnounceAccessibleAlert(const std::u16string& text) override {
+    view_->GetViewAccessibility().AnnounceText(text);
+  }
+
+  // The colours as DownloadButtonViews::UpdateProgressRing picks them.
+  void UpdateProgressRing(ActionItemProgressRingStatus status,
+                          int progress_percentage) override {
+    DownloadProgressRing& progress_ring =
+        DownloadProgressRing::GetOrInstall(*view_);
+    if (status == ActionItemProgressRingStatus::kIdle) {
+      progress_ring.SetIdle();
+      return;
+    }
+    const bool is_disabled =
+        status == ActionItemProgressRingStatus::kDormant ||
+        !action_item_->GetEnabled();
+    const bool is_active =
+        action_item_->GetProperty(kActionItemUnderlineIndicatorKey);
+    const SkColor disabled_color = GetColor(kColorToolbarButtonIconInactive);
+    const SkColor background_color =
+        is_disabled ? disabled_color
+                    : GetColor(kColorDownloadToolbarButtonRingBackground);
+    const SkColor progress_color =
+        is_disabled ? disabled_color
+                    : GetColor(is_active ? kColorDownloadToolbarButtonActive
+                                         : kColorDownloadToolbarButtonInactive);
+    progress_ring.UpdateColors(background_color, progress_color);
+    switch (status) {
+      case ActionItemProgressRingStatus::kIdle:
+        NOTREACHED();
+      case ActionItemProgressRingStatus::kDormant:
+        progress_ring.SetDormant();
+        break;
+      case ActionItemProgressRingStatus::kScanning:
+        progress_ring.SetScanning();
+        break;
+      case ActionItemProgressRingStatus::kDownloading:
+        progress_ring.SetDownloading(progress_percentage);
+        break;
+    }
+  }
+
+  void UpdateBadge(bool is_active,
+                   int progress_download_count,
+                   SkColor text_color,
+                   SkColor background_color) override {
+    DownloadsImageBadge::GetOrInstall(*view_).UpdateImage(
+        is_active, progress_download_count, text_color, background_color);
+  }
+
+  gfx::Rect GetBoundsInScreen() const override {
+    return view_->GetBoundsInScreen();
+  }
+
+  void SetElementIdentifier(ui::ElementIdentifier element_id) override {
+    view_->SetProperty(views::kElementIdentifierKey, element_id);
+  }
+
+  ActionItemProgressRingStatus GetProgressRingStatusForTesting() override {
+    return DownloadProgressRing::GetOrInstall(*view_).GetStatus();
+  }
+
+  views::ImageView* GetImageBadgeForTesting() override {
+    return &DownloadsImageBadge::GetOrInstall(*view_);
+  }
+
+ private:
+  const raw_ref<views::View> view_;
+  const raw_ref<actions::ActionItem> action_item_;
+};
+
