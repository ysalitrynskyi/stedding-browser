+// P13-1e, sidebar-file Sf21, Sf35: a pin another computer removed stays open
+// here as an ordinary tab when it was opened here; Undo on that batch pins
+// that tab again. The pin came back on every other computer, but here the tab
+// stayed unpinned, and Bring them here did not count it.
+IN_PROC_BROWSER_TEST_F(SidebarSyncB11Test,
+                       APinBroughtBackByUndoIsPinnedAgainWhileOpenHere) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  std::vector<std::string> pins;
+  for (int i = 0; i < 4; ++i) {
+    pins.push_back(NewTabIdB11());
+  }
+  const int64_t start = NowMsB11();
+  ASSERT_NO_FATAL_FAILURE(WriteOffice(OfficeStateB11(space, pins, start), 1));
+  ASSERT_NO_FATAL_FAILURE(Join());
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  tabs::TabInterface* const tab = TabWithToken(pins[0]);
+  ASSERT_TRUE(tab);
+  ASSERT_TRUE(model().IsSpacePinned(tab));
+
+  // Opened here, then left for another tab.
+  ASSERT_TRUE(model().SetActiveSpace(SpaceOfB11(space)));
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(tab));
+  ASSERT_EQ(tab, tabs().GetActiveTab());
+  ASSERT_TRUE(OpenTabInFront());
+  ASSERT_NE(tab, tabs().GetActiveTab());
+  ASSERT_FALSE(
+      service()->ledger_for_testing()->inserted_unopened.contains(pins[0]));
+
+  // The other computer removes it: one of four, so it applies at once, and
+  // the tab stays open here as an ordinary tab.
+  sb::State removed = OfficeStateB11(space, pins, start);
+  removed.records[pins[0]].del = sb::Stamp{start + 60'000, kOfficeB11};
+  ASSERT_NO_FATAL_FAILURE(WriteOffice(removed, 2));
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  ASSERT_FALSE(Decision(std::string("batch:") + kOfficeB11));
+  ASSERT_EQ(tab, TabWithToken(pins[0])) << "the opened pin was closed";
+  ASSERT_FALSE(model().IsSpacePinned(tab));
+  ASSERT_FALSE(tab->IsPinned());
+
+  // Undo on that batch, as Settings lists it.
+  const std::vector<sb::JournalEntry>& journal =
+      service()->ledger_for_testing()->journal;
+  const auto entry =
+      std::ranges::find_if(journal, [&](const sb::JournalEntry& each) {
+        return each.removed == 1 && each.before.records.contains(pins[0]);
+      });
+  ASSERT_TRUE(entry != journal.end());
+  const std::string undo = entry->id;
+  ASSERT_TRUE(service()->UndoBatch(undo));
+  ASSERT_TRUE(LedgerRecord(pins[0]));
+  ASSERT_TRUE(LedgerRecord(pins[0])->Alive());
+
+  EXPECT_EQ(tab, TabWithToken(pins[0])) << "a second tab of the pin was made";
+  EXPECT_TRUE(model().IsSpacePinned(tab))
+      << "the pin is back on every computer but this one";
+  EXPECT_EQ(SpaceOfB11(space), model().FindSpaceForTab(tab));
+}
