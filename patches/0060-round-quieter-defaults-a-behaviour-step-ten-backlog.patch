+  // Typed twice, an hour ago: what the address bar completes to.
+  history->AddPageWithDetails(GURL("https://inlinesite.test/"), u"Inline site",
+                              /*visit_count=*/3, /*typed_count=*/2,
+                              base::Time::Now() - base::Hours(1),
+                              /*hidden=*/false, history::SOURCE_BROWSED);
+  history::BlockUntilHistoryProcessesPendingRequests(history);
+
+  stedding::CommandBarView* const bar = OpenBar();
+  ASSERT_TRUE(bar);
+  views::Textfield* const field = bar->field_for_testing();
+  Type(bar, u"inlines");
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return field->GetText().starts_with(u"inlinesite.test");
+  })) << "it reads " << base::UTF16ToUTF8(field->GetText());
+  EXPECT_EQ(u"inlinesite.test", field->GetText());
+  EXPECT_EQ(u"ite.test", field->GetSelectedText());
+  EXPECT_EQ(7u, field->GetCursorPosition());
+  EXPECT_EQ(u"Open", bar->row_detail_for_testing(0));
+
+  Press(bar, ui::VKEY_BACK);
+  EXPECT_EQ(u"inlines", field->GetText());
+  EXPECT_FALSE(field->HasSelection());
+  // The omnibox's later answers for the text.
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(u"inlines", field->GetText()) << "nothing completes after it";
+  EXPECT_TRUE(bar->inline_completion_for_testing().empty());
+
+  Type(bar, u"inlinesi");
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return field->GetText() == u"inlinesite.test"; }))
+      << "it reads " << base::UTF16ToUTF8(field->GetText());
+  Press(bar, ui::VKEY_RETURN);
+  // The host only: whether a tab opens is K21's to say.
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return browser()
+               ->GetTabStripModel()
+               ->GetActiveWebContents()
+               ->GetVisibleURL()
+               .host() == "inlinesite.test";
+  }));
+}
