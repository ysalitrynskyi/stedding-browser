+// static
+bool VerticalTabStripRegionView::IsMostlyOverStrip(
+    const BrowserView* browser_view,
+    const gfx::Rect& rect_in_screen) {
+  const VerticalTabStripRegionView* const strip = StripOf(browser_view);
+  if (!strip || !strip->IsDrawn() || strip->width() <= 0 ||
+      rect_in_screen.IsEmpty()) {
+    return false;
+  }
+  const gfx::Rect column = strip->GetBoundsInScreen();
+  const int centre = rect_in_screen.CenterPoint().x();
+  return centre >= column.x() && centre < column.right();
+}
+
+void VerticalTabStripRegionView::OnSideChanged() {
+  // sidebar Y36: nothing waits for the old edge -- a reveal pending there,
+  // or the sidebar slid out from it -- and the rail's rows take their
+  // centre against the card on the new side (UpdateInteriorMargin).
+  leading_edge_timer_.Stop();
+  if (state_controller_->IsCollapsed() && is_expanded_on_hover_) {
+    AnimateExpandOnHover(/*expand=*/false);
+  }
+  UpdateInteriorMargin(state_controller_->GetCollapseState() !=
+                       tabs::VerticalTabStripCollapseState::kExpanded);
+  // The strip keeps its width, so nothing else lays the window out again.
+  // The strip lays out its handle on its other edge (Layout); the browser
+  // view moves the strip, the card, the address row and the page's own
+  // surface in one layout; the frame lays out and paints Windows' caption
+  // buttons, whose colours follow what is under them (sidebar Y42).
+  InvalidateLayout();
+  top_button_container_->InvalidateLayout();
+  if (!browser_view()) {
+    return;
+  }
+  browser_view()->InvalidateLayout();
+  if (views::View* const contents = browser_view()->multi_contents_view()) {
+    contents->InvalidateLayout();
+  }
+  browser_view()->SchedulePaint();
+  if (TopContainerView* const top = browser_view()->top_container()) {
+    top->InvalidateLayout();
+    top->SchedulePaint();
+  }
+  if (views::Widget* const widget = GetWidget();
+      widget && widget->non_client_view() &&
+      widget->non_client_view()->frame_view()) {
+    widget->non_client_view()->frame_view()->InvalidateLayout();
+    widget->non_client_view()->frame_view()->SchedulePaint();
+  }
+}
