+void BrowserView::HoldPageForSteddingDrag() {
+  if (stedding_page_hold_) {
+    return;
+  }
+  stedding_page_hold_ = true;
+  stedding_active_changed_while_held_ = false;
+  tabs::TabInterface* const page = browser()->GetTabStripModel()->GetActiveTab();
+  stedding_held_page_ = page ? page->GetHandle() : tabs::TabHandle();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  stedding_held_space_ =
+      model ? std::optional<spaces::SpaceId>(model->active_id()) : std::nullopt;
+  if (model) {
+    model->HoldRecency(true);
+  }
+  // BACKLOG S-290: what in the window's chrome follows the active tab -- the
+  // address row's address, chip, colour and page buttons, the back and
+  // forward buttons -- stays with the page on screen, not the tab the drag
+  // selects. Before the drag selects it, so the page's buttons stay lit.
+  PointChromeAtSteddingPage(page);
+}
+
+void BrowserView::PointChromeAtSteddingPage(tabs::TabInterface* page) {
+  content::WebContents* const contents = page ? page->GetContents() : nullptr;
+  if (BrowserLocationBarModelDelegate* const delegate =
+          browser()->GetFeatures().location_bar_model_delegate()) {
+    delegate->SetSteddingShownContents(contents);
+  }
+  if (stedding::PageThemeColorController* const colours =
+          stedding::PageThemeColorController::From(browser())) {
+    colours->SetSteddingHeldContents(contents);
+  }
+  if (chrome::BrowserCommandController* const commands =
+          chrome::BrowserCommandController::From(browser())) {
+    commands->SetSteddingHeldContents(contents);
+  }
+  if (tabs::TabFeatures* const features =
+          page ? page->GetTabFeatures() : nullptr;
+      features && features->page_action_controller()) {
+    features->page_action_controller()->SetSteddingHeldOnScreen(true);
+  }
+}
+
+tabs::TabInterface* BrowserView::stedding_held_tab() {
+  if (!stedding_page_hold_) {
+    return nullptr;
+  }
+  tabs::TabInterface* const page = stedding_held_page_.Get();
+  return page && browser()->GetTabStripModel()->GetIndexOfTab(page) !=
+                     TabStripModel::kNoTab
+             ? page
+             : nullptr;
+}
+
+void BrowserView::ReleaseSteddingPageHold() {
+  if (!stedding_page_hold_) {
+    return;
+  }
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  tabs::TabInterface* const page = stedding_held_page_.Get();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  const bool same_space =
+      !model || !stedding_held_space_ || model->active_id() == *stedding_held_space_;
+  if (page && same_space && !strip->empty()) {
+    const int index = strip->GetIndexOfTab(page);
+    if (index != TabStripModel::kNoTab && strip->active_index() != index) {
+      strip->ActivateTabAt(index);
+    }
+  }
+  // The held page's buttons follow its state again: lit if it is the page on
+  // screen now, put out if the drop showed another (S-290).
+  if (tabs::TabFeatures* const features =
+          page ? page->GetTabFeatures() : nullptr;
+      features && features->page_action_controller()) {
+    features->page_action_controller()->SetSteddingHeldOnScreen(false);
+  }
+  stedding_page_hold_ = false;
+  stedding_held_page_ = tabs::TabHandle();
+  PointChromeAtSteddingPage(nullptr);
+  stedding_held_space_.reset();
+  if (model) {
+    model->HoldRecency(false);
+  }
+  if (!std::exchange(stedding_active_changed_while_held_, false) ||
+      strip->empty()) {
+    return;
+  }
+  content::WebContents* const active = strip->GetActiveWebContents();
+  if (!active) {
+    return;
+  }
+  OnActiveTabChanged(GetActiveContentsWebView()->web_contents(), active,
+                     strip->active_index(),
+                     TabStripModelObserver::CHANGE_REASON_NONE);
+  UpdateToolbar(active);
+}
