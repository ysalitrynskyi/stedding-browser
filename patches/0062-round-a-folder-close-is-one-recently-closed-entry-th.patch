+  lists_no_extension();
+
+  {
+    extensions::TestExtensionRegistryObserver reloaded(registry, id);
+    extensions::ExtensionRegistrar::Get(profile)->ReloadExtension(id);
+    ASSERT_TRUE(reloaded.WaitForExtensionLoaded());
+  }
+  ASSERT_EQ(bar, stedding::CommandBarView::GetOpenBar(
