@@ -0,0 +1,423 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Making an app from a page (docs/features/web-apps.md): the command and
+// its rows, where it is offered, the install moving the page into the app's
+// window, and how that window is drawn. Chromium's own install runs; the
+// test fixture fakes the operating system's side (OsIntegrationTestOverride),
+// so nothing reaches ~/Applications, the Dock or the Start menu.
+
+#include "chrome/browser/ui/stedding/make_app.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <tuple>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/bind.h"
+#include "base/test/run_until.h"
+#include "build/build_config.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_command_controller.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/app_jar.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_commands.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/toolbar/app_menu_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/multi_contents_view.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "chrome/browser/ui/web_applications/app_browser_controller.h"
+#include "chrome/browser/ui/web_applications/test/web_app_browsertest_util.h"
+#include "chrome/browser/ui/web_applications/web_app_dialogs.h"
+#include "chrome/browser/ui/web_applications/web_app_menu_model.h"
+#include "chrome/browser/ui/web_applications/web_app_ui_utils.h"
+#include "chrome/browser/web_applications/test/web_app_page_waiter.h"
+#include "chrome/browser/web_applications/web_app_provider.h"
+#include "chrome/browser/web_applications/web_app_registrar.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/web_app_test_base.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/page_type.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/test/widget_test.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/any_widget_observer.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_delegate.h"
+#include "ui/views/window/dialog_delegate.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Every label's text under `view`, one per line.
+std::u16string TextUnder(views::View* view) {
+  std::u16string text;
+  if (const views::Label* const label =
+          views::AsViewClass<views::Label>(view)) {
+    text += label->GetText();
+    text += u"\n";
+  }
+  for (views::View* const child : view->children()) {
+    text += TextUnder(child);
+  }
+  return text;
+}
+
+class MakeAppTest : public stedding::WebAppBrowserTest {
+ protected:
+  GURL PageUrl(const std::string& host,
+               const std::string& path = "/title1.html") {
+    return embedded_https_test_server().GetURL(host, path);
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  // `url` in a new tab of the Space on screen, loaded, its web-app checks
+  // done.
+  content::WebContents* OpenPage(const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    content::WebContents* const contents = tabs()->GetActiveWebContents();
+    EXPECT_TRUE(web_app::test::WebAppPageWaiter(contents)
+                    .ExpectUrl(url)
+                    .ManifestOrLoadedNoManifest()
+                    .WaitAndFlushCommands());
+    return contents;
+  }
+
+  // The app menu's label for `command_id` in `window`, empty when the menu
+  // has no such row.
+  std::u16string AppMenuLabel(BrowserWindowInterface* window, int command_id) {
+    AppMenuModel menu(/*provider=*/nullptr, window);
+    menu.Init();
+    ui::MenuModel* model = &menu;
+    size_t index = 0;
+    if (!menu.GetModelAndIndexForCommandId(command_id, &model, &index)) {
+      return std::u16string();
+    }
+    return model->GetLabelAt(index);
+  }
+
+  // Whether `window` offers the command, enabled, here.
+  bool Offers(BrowserWindowInterface* window) {
+    chrome::BrowserCommandController* const commands =
+        chrome::BrowserCommandController::From(window);
+    if (commands) {
+      commands->TabStateChanged();
+    }
+    return chrome::IsCommandEnabled(window, IDC_STEDDING_MAKE_APP) &&
+           stedding::CanMakeApp(window);
+  }
+
+  // Runs the command on the active tab, as the File menu and the command bar
+  // do, and gives the text of the install dialog it opens -- the do it
+  // yourself one, the simple one or the detailed one -- which is then
+  // cancelled. Empty when no dialog opens.
+  std::u16string InstallDialogText() {
+    views::Widget* dialog = nullptr;
+    views::AnyWidgetObserver dialogs(views::test::AnyWidgetTestPasskey{});
+    dialogs.set_shown_callback(
+        base::BindLambdaForTesting([&](views::Widget* widget) {
+          const std::string& name = widget->GetName();
+          if (name == "WebAppDiyInstallDialog" ||
+              name == "WebAppSimpleInstallDialog" ||
+              name == "WebAppDetailedInstallDialog") {
+            dialog = widget;
+          }
+        }));
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_MAKE_APP);
+    EXPECT_TRUE(base::test::RunUntil([&]() { return dialog != nullptr; }))
+        << "no install dialog opened";
+    if (!dialog) {
+      return std::u16string();
+    }
+    const std::u16string text = TextUnder(dialog->GetRootView());
+    views::test::WidgetDestroyedWaiter closed(dialog);
+    dialog->widget_delegate()->AsDialogDelegate()->CancelDialog();
+    closed.Wait();
+    return text;
+  }
+};
+
+// web apps Wa1, Wa2, Wa6: the app menu's row says "Add to Dock…" on the Mac
+// and Chromium's "Install page as app…" elsewhere; accepting the dialog
+// installs the page as an app and moves it into the app's window as it is --
+// the same contents, no reload -- and out of the Space it was in.
+IN_PROC_BROWSER_TEST_F(MakeAppTest, TheAppMenuRowInstallsAndMovesThePage) {
+  const GURL url = PageUrl("a.test");
+  content::WebContents* const page = OpenPage(url);
+  const int entry_id =
+      page->GetController().GetLastCommittedEntry()->GetUniqueID();
+  const int before = tabs()->count();
+  ASSERT_GE(before, 2);
+  EXPECT_TRUE(Offers(browser()));
+#if BUILDFLAG(IS_MAC)
+  EXPECT_EQ(u"Add to Dock…", AppMenuLabel(browser(), IDC_INSTALL_PWA));
+#else
+  // Chromium's own label; its "&" marks the I as the menu's mnemonic.
+  EXPECT_EQ(u"&Install page as app…", AppMenuLabel(browser(), IDC_INSTALL_PWA));
+#endif
+
+  auto accept = web_app::SetPwaInstallationAutoRespondForTesting(
+      web_app::InstallDialogTestResponse::kAcceptAndLaunch);
+  ui_test_utils::BrowserCreatedObserver created;
+  chrome::ExecuteCommand(browser(), IDC_INSTALL_PWA);
+  BrowserWindowInterface* const app = created.Wait();
+  ASSERT_TRUE(app);
+  ASSERT_TRUE(web_app::AppBrowserController::IsWebApp(app));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return app->GetTabStripModel()->GetActiveWebContents(); }));
+  EXPECT_EQ(page, app->GetTabStripModel()->GetActiveWebContents())
+      << "the page itself moves";
+  EXPECT_EQ(entry_id,
+            page->GetController().GetLastCommittedEntry()->GetUniqueID())
+      << "and is not loaded again";
+  EXPECT_EQ(before - 1, tabs()->count());
+  EXPECT_EQ(TabStripModel::kNoTab, tabs()->GetIndexOfWebContents(page));
+}
+
+// web apps Wa3: on a page that is an installed app's, the row reads "Open in
+// <App>" everywhere and moves the tab into the app.
+IN_PROC_BROWSER_TEST_F(MakeAppTest, APageThatIsAlreadyAnAppOffersOpenIn) {
+  const GURL url = PageUrl("a.test");
+  const webapps::AppId app_id = web_app::InstallWebAppFromPage(browser(), url);
+  ASSERT_FALSE(app_id.empty());
+  const std::string name =
+      provider().registrar_unsafe().GetAppShortName(app_id);
+  content::WebContents* const page = OpenPage(url);
+  EXPECT_TRUE(Offers(browser()));
+  const std::u16string open = u"Open in " + base::UTF8ToUTF16(name);
+  EXPECT_EQ(open,
+            stedding::MakeAppTitle(browser(), stedding::MakeAppSurface::kMenu));
+  EXPECT_EQ(open, stedding::MakeAppTitle(
+                      browser(), stedding::MakeAppSurface::kCommandBar));
+
+  ui_test_utils::BrowserCreatedObserver created;
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_MAKE_APP);
+  BrowserWindowInterface* const app = created.Wait();
+  ASSERT_TRUE(web_app::AppBrowserController::IsForWebApp(app, app_id));
+  EXPECT_EQ(page, app->GetTabStripModel()->GetActiveWebContents());
+}
+
+// web apps Wa4: no enabled row in a private window, a Guest window, a popup
+// (a little window is one), on a browser page or on an error page.
+IN_PROC_BROWSER_TEST_F(MakeAppTest, PrivateGuestAndBrowserPagesOfferNoRow) {
+  const GURL url = PageUrl("a.test");
+  OpenPage(url);
+  ASSERT_TRUE(Offers(browser())) << "the page itself can become an app";
+
+  BrowserWindowInterface* const private_window = CreateIncognitoBrowser();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(private_window, url));
+  EXPECT_FALSE(Offers(private_window));
+
+#if !BUILDFLAG(IS_CHROMEOS)
+  BrowserWindowInterface* const guest = CreateGuestBrowser();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(guest, url));
+  EXPECT_FALSE(Offers(guest));
+#endif
+
+  BrowserWindowInterface* const popup =
+      CreateBrowserForPopup(browser()->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(popup, url));
+  EXPECT_FALSE(Offers(popup));
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL(chrome::kChromeUISettingsURL)));
+  EXPECT_FALSE(Offers(browser()));
+
+  std::ignore = ui_test_utils::NavigateToURL(
+      browser(), PageUrl("a.test", "/close-socket"));
+  ASSERT_EQ(content::PAGE_TYPE_ERROR, tabs()
+                                          ->GetActiveWebContents()
+                                          ->GetController()
+                                          .GetLastCommittedEntry()
+                                          ->GetPageType());
+  EXPECT_FALSE(Offers(browser())) << "an error page";
+}
+
+// web apps Wa5: the dialog names the session the app will open in when the
+// page is in a Space with an Independent session, and says nothing of it
+// from a Space that shares the profile's. Both dialogs a page can get show
+// the line on every platform: the do it yourself one for a page without a
+// manifest, the simple one (or the detailed one) for a page with one.
+IN_PROC_BROWSER_TEST_F(MakeAppTest, TheDialogNamesTheSessionItWillUse) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const GURL manifest_page =
+      PageUrl("a.test", "/banners/manifest_test_page.html");
+  for (const GURL& url : {PageUrl("a.test"), manifest_page}) {
+    SCOPED_TRACE(url.spec());
+    content::WebContents* const shared_page = OpenPage(url);
+    EXPECT_EQ(u"", spaces::AppSessionLine(shared_page));
+    const std::u16string text = InstallDialogText();
+    EXPECT_EQ(std::u16string::npos, text.find(u"session")) << text;
+  }
+
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->SetSpaceIsolated(work, true);
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  for (const GURL& url : {PageUrl("a.test"), manifest_page}) {
+    SCOPED_TRACE(url.spec());
+    content::WebContents* const work_page = OpenPage(url);
+    ASSERT_EQ(work, model->FindSpaceForTab(tabs()->GetActiveTab()));
+    EXPECT_EQ(u"Opens with the session of “Work”.",
+              spaces::AppSessionLine(work_page));
+    const std::u16string text = InstallDialogText();
+    EXPECT_NE(std::u16string::npos,
+              text.find(u"Opens with the session of “Work”."))
+        << text;
+  }
+}
+
+// web apps Wa6: an essential and a Space pin are not moved into the app: they
+// stay in the sidebar, and the app opens a window of its own at the page's
+// address.
+IN_PROC_BROWSER_TEST_F(MakeAppTest, APinnedTabStaysAndTheAppOpensItsOwnWindow) {
+  for (const bool essential : {true, false}) {
+    SCOPED_TRACE(essential ? "an essential" : "a Space pin");
+    const GURL url = PageUrl(essential ? "a.test" : "b.test", "/title2.html");
+    content::WebContents* const page = OpenPage(url);
+    if (essential) {
+      tabs()->SetTabPinned(tabs()->GetIndexOfWebContents(page), true);
+    } else {
+      spaces::ToggleSpacePinOnActiveTab(browser());
+      ASSERT_TRUE(spaces::SpaceModel::From(browser())->IsSpacePinned(
+          tabs::TabInterface::GetFromContents(page)));
+    }
+    ASSERT_EQ(page, tabs()->GetActiveWebContents());
+    const int before = tabs()->count();
+
+    ui_test_utils::BrowserCreatedObserver created;
+    const webapps::AppId app_id = web_app::InstallWebAppFromPage(
+        browser(), url, {.launch_or_reparent_page_to_app = true});
+    BrowserWindowInterface* const app = created.Wait();
+    ASSERT_TRUE(web_app::AppBrowserController::IsForWebApp(app, app_id));
+    EXPECT_EQ(before, tabs()->count()) << "the tab stays";
+    EXPECT_NE(TabStripModel::kNoTab, tabs()->GetIndexOfWebContents(page));
+    content::WebContents* const app_page =
+        app->GetTabStripModel()->GetActiveWebContents();
+    ASSERT_TRUE(app_page);
+    EXPECT_NE(page, app_page);
+    EXPECT_TRUE(content::WaitForLoadStop(app_page));
+    EXPECT_EQ(url, app_page->GetLastCommittedURL()) << "at the page's address";
+  }
+}
+
+// web apps Wa6: a pane of a split is not moved into the app either: the
+// split stays as the user made it, and the app opens a window of its own at
+// the page's address.
+IN_PROC_BROWSER_TEST_F(MakeAppTest, ASplitPaneStaysAndTheAppOpensItsOwnWindow) {
+  const GURL url = PageUrl("a.test", "/title2.html");
+  content::WebContents* const other = OpenPage(PageUrl("b.test"));
+  content::WebContents* const page = OpenPage(url);
+  tabs()->AddToNewSplit({tabs()->GetIndexOfWebContents(other)},
+                        split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  tabs::TabInterface* const pane = tabs::TabInterface::GetFromContents(page);
+  ASSERT_TRUE(pane->IsSplit());
+  ASSERT_EQ(page, tabs()->GetActiveWebContents());
+  const int before = tabs()->count();
+
+  ui_test_utils::BrowserCreatedObserver created;
+  const webapps::AppId app_id = web_app::InstallWebAppFromPage(
+      browser(), url, {.launch_or_reparent_page_to_app = true});
+  BrowserWindowInterface* const app = created.Wait();
+  ASSERT_TRUE(web_app::AppBrowserController::IsForWebApp(app, app_id));
+  EXPECT_EQ(before, tabs()->count()) << "the pane stays";
+  EXPECT_TRUE(pane->IsSplit()) << "and so does its split";
+  EXPECT_TRUE(tabs::TabInterface::GetFromContents(other)->IsSplit());
+  content::WebContents* const app_page =
+      app->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(app_page);
+  EXPECT_NE(page, app_page);
+  EXPECT_TRUE(content::WaitForLoadStop(app_page));
+  EXPECT_EQ(url, app_page->GetLastCommittedURL()) << "at the page's address";
+}
+
+// web apps Wa3, Wa4: what the command offers is what it runs. On a page that
+// names an installed app's manifest from outside that app's scope, Chromium
+// offers neither an install nor "Open in <App>" by their labels, though the
+// page can become an app; the row is enabled with the install's words, and
+// running it opens the install dialog. It had done nothing.
+IN_PROC_BROWSER_TEST_F(MakeAppTest, ARowWithNeitherLabelStillInstalls) {
+  // Installed from its own page, as the menu does: the site has no service
+  // worker, which InstallWebAppFromManifest waits for.
+  const webapps::AppId installed = web_app::InstallWebAppFromPage(
+      browser(),
+      PageUrl("a.test", "/web_apps/scoped_install/in_scope/index.html"));
+  ASSERT_FALSE(installed.empty());
+  OpenPage(PageUrl("a.test", "/web_apps/scoped_install/out_of_scope.html"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return web_app::GetInstallPWALabel(browser()).empty();
+  })) << "the page's own app is installed already";
+  ASSERT_TRUE(web_app::GetOpenPWALabel(browser()).empty())
+      << "the page is outside the app's scope";
+  ASSERT_TRUE(Offers(browser()));
+#if BUILDFLAG(IS_MAC)
+  EXPECT_EQ(u"Add to Dock…",
+            stedding::MakeAppTitle(browser(), stedding::MakeAppSurface::kMenu));
+#else
+  EXPECT_EQ(
+      u"Install Page as App…",
+      stedding::MakeAppTitle(browser(), stedding::MakeAppSurface::kCommandBar));
+#endif
+  EXPECT_FALSE(InstallDialogText().empty());
+}
+
+// web apps Wa9, Wa10 (BACKLOG S-165): an app's window has no Spaces, no
+// sidebar and no card around its page: the page and the find bar's box run
+// edge to edge. Its menu is Chromium's app menu, with no Stedding browser
+// row.
+IN_PROC_BROWSER_TEST_F(MakeAppTest, TheAppWindowHasNoSidebarSpacesOrCard) {
+  const webapps::AppId app_id =
+      web_app::InstallWebAppFromPage(browser(), PageUrl("a.test"));
+  ASSERT_FALSE(app_id.empty());
+  BrowserWindowInterface* const app =
+      web_app::LaunchWebAppBrowserAndWait(browser()->GetProfile(), app_id);
+  ASSERT_TRUE(app);
+  EXPECT_FALSE(spaces::SpaceModel::From(app));
+  EXPECT_FALSE(tabs::VerticalTabStripStateController::From(app));
+  EXPECT_FALSE(Offers(app));
+
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(app);
+  ASSERT_TRUE(view);
+  EXPECT_EQ(0, VerticalTabStripRegionView::SteddingCardGutter(view));
+  MultiContentsView* const page = view->multi_contents_view();
+  ASSERT_TRUE(page);
+  EXPECT_EQ(
+      page->GetMirroredRect(page->ConvertRectToWidget(page->GetLocalBounds())),
+      view->GetFindBarBoundingBox());
+
+  WebAppMenuModel menu(/*provider=*/nullptr, app);
+  menu.Init();
+  EXPECT_TRUE(menu.GetIndexOfCommandId(WebAppMenuModel::kUninstallAppCommandId)
+                  .has_value());
+  EXPECT_TRUE(menu.GetIndexOfCommandId(IDC_OPEN_IN_CHROME).has_value());
+  ui::MenuModel* model = &menu;
+  size_t index = 0;
+  EXPECT_FALSE(
+      menu.GetModelAndIndexForCommandId(IDC_STEDDING_MAKE_APP, &model, &index));
+}
+
+}  // namespace
