+
+namespace stedding {
+namespace {
+
+// toolbar T39: a key of the extensions chord's modifier, Cmd on the Mac and
+// Ctrl+Alt elsewhere.
+#if BUILDFLAG(IS_MAC)
+constexpr ui::KeyboardCode kChordKeyW2B23 = ui::VKEY_COMMAND;
+#else
+constexpr ui::KeyboardCode kChordKeyW2B23 = ui::VKEY_CONTROL;
+#endif
+
+ui::KeyEvent ChordKeyReleasedW2B23() {
+  return ui::KeyEvent(ui::EventType::kKeyReleased, kChordKeyW2B23,
+                      ui::EF_NONE);
+}
+
+ui::KeyEvent PressW2B23(ui::KeyboardCode code) {
+  return ui::KeyEvent(ui::EventType::kKeyPressed, code, ui::EF_NONE);
+}
+
+// Enter on the chosen row, through the bar's own key handling.
+bool EnterW2B23(CommandBarView& bar) {
+  return bar.HandleKeyEvent(bar.field_for_testing(),
+                            PressW2B23(ui::VKEY_RETURN));
+}
+
+void DownW2B23(CommandBarView& bar, size_t times) {
+  for (size_t i = 0; i < times; ++i) {
+    bar.HandleKeyEvent(bar.field_for_testing(), PressW2B23(ui::VKEY_DOWN));
+  }
+}
+
+// An edit as the field reports one, with the caret at the end of the text.
+void TypeIntoW2B23(CommandBarView& bar, const std::u16string& text) {
+  views::Textfield* const field = bar.field_for_testing();
+  bar.OnBeforeUserAction(field);
+  field->SetText(text);
+  bar.ContentsChanged(field, text);
+}
+
+std::vector<std::u16string> TitlesW2B23(CommandBarView& bar) {
+  std::vector<std::u16string> titles;
+  for (size_t i = 0; i < bar.row_count_for_testing(); ++i) {
+    titles.push_back(bar.row_title_for_testing(i));
+  }
+  return titles;
+}
+
+bool HasTitleW2B23(CommandBarView& bar, const std::u16string& title) {
+  for (const std::u16string& each : TitlesW2B23(bar)) {
+    if (each == title) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The index of the first row titled `title`; the row count when there is
+// none.
+size_t RowIndexW2B23(CommandBarView& bar, const std::u16string& title) {
+  for (size_t i = 0; i < bar.row_count_for_testing(); ++i) {
+    if (bar.row_title_for_testing(i) == title) {
+      return i;
+    }
+  }
+  return bar.row_count_for_testing();
+}
+
+// The index of the first row whose title ends with `end`; the row count when
+// there is none.
+size_t RowEndingWithW2B23(CommandBarView& bar, const std::u16string& end) {
+  for (size_t i = 0; i < bar.row_count_for_testing(); ++i) {
+    if (bar.row_title_for_testing(i).ends_with(end)) {
+      return i;
+    }
+  }
+  return bar.row_count_for_testing();
+}
+
+// The titles, one per line, for a failure's message.
+std::string JoinedW2B23(const std::vector<std::u16string>& titles) {
+  std::string joined;
+  for (const std::u16string& title : titles) {
+    joined += "\n  " + base::UTF16ToUTF8(title);
+  }
+  return joined;
+}
+
+AutocompleteResult ResultOfW2B23(const ACMatches& matches) {
+  AutocompleteResult result;
+  result.AppendMatches(matches);
+  return result;
+}
+
+// One of the omnibox's answers.
+AutocompleteMatch MatchW2B23(omnibox::AutocompleteMatchType type,
+                             const GURL& url,
+                             const std::u16string& contents,
+                             const std::u16string& description) {
+  AutocompleteMatch match(/*provider=*/nullptr, /*relevance=*/1000,
+                          /*deletable=*/false, type);
+  match.destination_url = url;
+  match.contents = contents;
+  match.description = description;
+  match.fill_into_edit = contents;
+  return match;
+}
+
+class CommandBarW2B23Test : public BrowserWithTestWindowTest {};
+
+// P31-1g; commandbar K8, K14, toolbar T39. Shift-Cmd-P on the bar Cmd-E
+// opened kept the extension rows alone: with no extension action, "Manage
+// Extensions" was all it listed, and Escape closed the bar instead of
+// leaving actions mode. Shift-Cmd-P gives the commands, every one of them.
+TEST_F(CommandBarW2B23Test, TheCommandsChordOnTheExtensionsBarListsCommands) {
+  AddTab(browser(), GURL("https://example.com/"));
+  const std::vector<ExtensionActionRow> none;
+  const auto scoped_rows = SetExtensionActionRowsForTesting(&none);
+  views::View host;
+  const auto scoped_host = CommandBarView::SetHostForTesting(&host);
+
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_RUN_EXTENSION);
+  CommandBarView* const bar = CommandBarView::GetOpenBar(&host);
+  ASSERT_TRUE(bar);
+  ASSERT_EQ(std::vector<std::u16string>{u"Manage Extensions"},
+            TitlesW2B23(*bar))
+      << "the premise: the chord's bar offers Manage Extensions alone";
+  // Letting go of the chord runs nothing, and the bar stays open (T39).
+  bar->OnHeldChordEvent(ChordKeyReleasedW2B23());
+  ASSERT_FALSE(bar->closing_for_testing());
+
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_COMMAND_PALETTE);
+  ASSERT_EQ(bar, CommandBarView::GetOpenBar(&host));
+  EXPECT_EQ(CommandBarView::Mode::kActions, bar->mode_for_testing());
+  {
+    SCOPED_TRACE("the rows:" + JoinedW2B23(TitlesW2B23(*bar)));
+    EXPECT_GT(bar->row_count_for_testing(), 1u)
+        << "the bar still lists the extension rows alone";
+    EXPECT_TRUE(HasTitleW2B23(*bar, u"Import from Another Browser"))
+        << "a command is missing";
+  }
+  // K14: Escape leaves actions mode first, as it does on any actions bar.
+  EXPECT_TRUE(
+      bar->AcceleratorPressed(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE)));
+  EXPECT_FALSE(bar->closing_for_testing()) << "Escape closed the bar";
+  EXPECT_EQ(CommandBarView::Mode::kTabs, bar->mode_for_testing());
+  bar->Close();
+  base::RunLoop().RunUntilIdle();
+}
+
+// P31-1g; commandbar K8, toolbar T39. With the chord's modifier still down
+// from Cmd-E, Shift-Cmd-P left the hold on: letting go of the modifier then
+// ran the chosen extension from a bar that had been turned to the commands.
+// The commands chord ends the hold, and letting go runs nothing.
+TEST_F(CommandBarW2B23Test, TheCommandsChordEndsTheExtensionsChordsHold) {
+  AddTab(browser(), GURL("https://example.com/"));
+  std::vector<std::u16string> runs;
+  std::vector<ExtensionActionRow> rows;
+  for (const char16_t* name : {u"Alpha", u"Beta"}) {
+    ExtensionActionRow row;
+    row.id = base::UTF16ToUTF8(name);
+    row.name = name;
+    row.run = base::BindLambdaForTesting(
+        [&runs, name]() { runs.push_back(std::u16string(name)); });
+    rows.push_back(std::move(row));
+  }
+  const auto scoped_rows = SetExtensionActionRowsForTesting(&rows);
+  views::View host;
+  const auto scoped_host = CommandBarView::SetHostForTesting(&host);
+
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_RUN_EXTENSION);
+  CommandBarView* const bar = CommandBarView::GetOpenBar(&host);
+  ASSERT_TRUE(bar);
+  ASSERT_TRUE(bar->holding_chord_for_testing())
+      << "the premise: the chord's modifier is held";
+  ASSERT_EQ((std::vector<std::u16string>{u"Alpha", u"Beta"}),
+            TitlesW2B23(*bar));
+
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_COMMAND_PALETTE);
+  ASSERT_EQ(bar, CommandBarView::GetOpenBar(&host));
+  EXPECT_FALSE(bar->holding_chord_for_testing())
+      << "the extensions chord's hold goes on";
+  {
+    SCOPED_TRACE("the rows:" + JoinedW2B23(TitlesW2B23(*bar)));
+    EXPECT_TRUE(HasTitleW2B23(*bar, u"Import from Another Browser"))
+        << "the bar still lists the extension rows alone";
+    EXPECT_TRUE(HasTitleW2B23(*bar, u"Alpha"))
+        << "the extensions are commands too (K31)";
+  }
+  bar->OnHeldChordEvent(ChordKeyReleasedW2B23());
+  EXPECT_TRUE(runs.empty()) << "letting go ran an extension";
+  EXPECT_FALSE(bar->closing_for_testing());
+  bar->Close();
+  base::RunLoop().RunUntilIdle();
+}
+
+// P31-1d; commandbar K17, K39. A preference row stays chosen once it has
+// run. "Pop Out Playing Videos" and "Show What's Playing in the Sidebar" are
+// also places of Settings (K39), listed above the preference rows, and the
+// row that ran was found again by its name: the highlight jumped to the
+// place, and Enter again opened Settings and closed the bar instead of
+// turning the preference back.
+TEST_F(CommandBarW2B23Test, APreferenceRowStaysChosenOverAPlaceOfItsName) {
+  AddTab(browser(), GURL("https://example.com/"));
+  PrefService* const prefs = profile()->GetPrefs();
+  struct Toggle {
+    const char* pref;
+    const char16_t* label;
+  };
+  const Toggle kToggles[] = {
+      {stedding::prefs::kPlayerPopOut, u"Pop Out Playing Videos"},
+      {stedding::prefs::kPlayerAudioStrip,
+       u"Show What\u2019s Playing in the Sidebar"},
+  };
+  for (const Toggle& toggle : kToggles) {
+    const std::u16string label(toggle.label);
+    SCOPED_TRACE(base::UTF16ToUTF8(label));
+    const auto titled = [&](bool on) {
+      return label + (on ? u": On" : u": Off");
+    };
+    const bool was = prefs->GetBoolean(toggle.pref);
+    auto bar = std::make_unique<CommandBarView>(browser());
+    bar->SetModeForTesting(CommandBarView::Mode::kActions);
+    TypeIntoW2B23(*bar, u"play");
+    SCOPED_TRACE("the rows:" + JoinedW2B23(TitlesW2B23(*bar)));
+    const size_t place = RowIndexW2B23(*bar, label);
+    const size_t row = RowIndexW2B23(*bar, titled(was));
+    ASSERT_LT(row, bar->row_count_for_testing()) << "the toggle is not listed";
+    ASSERT_LT(place, row)
+        << "the premise: the place of the same name is listed above it";
+
+    DownW2B23(*bar, row);
+    ASSERT_EQ(row, bar->selected_row_for_testing());
+    EXPECT_TRUE(EnterW2B23(*bar));
+    EXPECT_EQ(!was, prefs->GetBoolean(toggle.pref)) << "Enter did not toggle";
+    ASSERT_FALSE(bar->closing_for_testing());
+    ASSERT_EQ(titled(!was),
+              bar->row_title_for_testing(bar->selected_row_for_testing()))
+        << "the highlight left the row that ran";
+
+    EXPECT_TRUE(EnterW2B23(*bar));
+    EXPECT_FALSE(bar->closing_for_testing()) << "Enter again closed the bar";
+    EXPECT_EQ(was, prefs->GetBoolean(toggle.pref))
+        << "Enter again did not turn it back";
+    EXPECT_EQ(titled(was),
+              bar->row_title_for_testing(bar->selected_row_for_testing()));
+  }
+}
