diff --git a/chrome/browser/ui/views/download/bubble/stedding_download_flight_views.cc b/chrome/browser/ui/views/download/bubble/stedding_download_flight_views.cc
new file mode 100644
index 0000000000000..7a4f177c00051
--- /dev/null
+++ b/chrome/browser/ui/views/download/bubble/stedding_download_flight_views.cc
@@ -0,0 +1,235 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/download/bubble/stedding_download_flight_views.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/stedding/download_flight.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_operations.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+// The arrow inside the 48 DIP chip, and how far the chip seems to float.
+constexpr int kArrowDip = 26;
+constexpr int kChipElevation = 8;
+// The ring's line, and the faint disc inside it, as a share of its opacity.
+constexpr float kRingStrokeDip = 3.0f;
+constexpr float kRingFillShare = 0.18f;
+
+SteddingDownloadFlightViews::StartedCallback& FlightStartedForTesting() {
+  static base::NoDestructor<SteddingDownloadFlightViews::StartedCallback>
+      callback;
+  return *callback;
+}
+
+SteddingDownloadRingViews::StartedCallback& RingStartedForTesting() {
+  static base::NoDestructor<SteddingDownloadRingViews::StartedCallback>
+      callback;
+  return *callback;
+}
+
+SkColor WithOpacity(SkColor color, float opacity) {
+  return SkColorSetA(color, static_cast<U8CPU>(std::lround(
+                                SkColorGetA(color) *
+                                std::clamp(opacity, 0.0f, 1.0f))));
+}
+
+}  // namespace
+
+// static
+void SteddingDownloadFlightViews::SetStartedCallbackForTesting(
+    StartedCallback callback) {
+  FlightStartedForTesting() = std::move(callback);
+}
+
+SteddingDownloadFlightViews::SteddingDownloadFlightViews(
+    content::WebContents* web_contents,
+    const gfx::Rect& button_bounds,
+    SkColor chip_color,
+    SkColor arrow_color)
+    : SteddingDownloadFlightViews(web_contents,
+                                  button_bounds,
+                                  MakeChip(chip_color, arrow_color)) {}
+
+SteddingDownloadFlightViews::SteddingDownloadFlightViews(
+    content::WebContents* web_contents,
+    const gfx::Rect& button_bounds,
+    const Chip& chip)
+    : DownloadStartedAnimationViews(web_contents,
+                                    stedding::kDownloadFlightDuration,
+                                    chip.image),
+      button_bounds_(button_bounds),
+      image_size_(chip.image.Size()),
+      circle_origin_(chip.circle_origin) {
+  if (const StartedCallback& started = FlightStartedForTesting(); started) {
+    started.Run(web_contents_bounds(), button_bounds_);
+  }
+}
+
+SteddingDownloadFlightViews::~SteddingDownloadFlightViews() = default;
+
+// static
+SteddingDownloadFlightViews::Chip SteddingDownloadFlightViews::MakeChip(
+    SkColor chip_color,
+    SkColor arrow_color) {
+  const gfx::ImageSkia arrow = gfx::CreateVectorIcon(
+      gfx::IconDescription(kDownloadIcon, kArrowDip, arrow_color));
+  const gfx::ImageSkia circle =
+      gfx::ImageSkiaOperations::CreateImageWithCircleBackground(
+          stedding::kDownloadChipDip / 2, chip_color, arrow);
+  const gfx::ShadowValues shadows =
+      gfx::ShadowValue::MakeMdShadowValues(kChipElevation);
+  const gfx::ImageSkia image =
+      gfx::ImageSkiaOperations::CreateImageWithDropShadow(circle, shadows);
+  // The margins are negative: the shadow lies outside the circle.
+  const gfx::Insets margin = gfx::ShadowValue::GetMargin(shadows);
+  return Chip{ui::ImageModel::FromImageSkia(image),
+              gfx::Vector2d(-margin.left(), -margin.top())};
+}
+
+gfx::Rect SteddingDownloadFlightViews::FrameBounds() const {
+  const stedding::DownloadFlightFrame frame = stedding::DownloadFlightAt(
+      GetCurrentValue(), web_contents_bounds(), button_bounds_);
+  // The image scales with the chip's circle, its shadow with it.
+  const float scale =
+      static_cast<float>(frame.chip.width()) / stedding::kDownloadChipDip;
+  const gfx::Size size = gfx::ScaleToRoundedSize(image_size_, scale);
+  const gfx::Vector2d offset(
+      static_cast<int>(std::lround(circle_origin_.x() * scale)),
+      static_cast<int>(std::lround(circle_origin_.y() * scale)));
+  return gfx::Rect(frame.chip.origin() - offset, size);
+}
+
+int SteddingDownloadFlightViews::GetX() const {
+  return FrameBounds().x();
+}
+
+int SteddingDownloadFlightViews::GetY() const {
+  return FrameBounds().y();
+}
+
+int SteddingDownloadFlightViews::GetWidth() const {
+  return FrameBounds().width();
+}
+
+int SteddingDownloadFlightViews::GetHeight() const {
+  return FrameBounds().height();
+}
+
+float SteddingDownloadFlightViews::GetOpacity() const {
+  return stedding::DownloadFlightAt(GetCurrentValue(), web_contents_bounds(),
+                                    button_bounds_)
+      .opacity;
+}
+
+void SteddingDownloadFlightViews::OnBoundsChanged(
+    const gfx::Rect& previous_bounds) {
+  // The popup shrinks as the chip lands: the image is drawn at its size.
+  SetImageSize(size());
+  DownloadStartedAnimationViews::OnBoundsChanged(previous_bounds);
+}
+
+BEGIN_METADATA(SteddingDownloadFlightViews)
+END_METADATA
+
+// static
+void SteddingDownloadRingViews::SetStartedCallbackForTesting(
+    StartedCallback callback) {
+  RingStartedForTesting() = std::move(callback);
+}
+
+SteddingDownloadRingViews::SteddingDownloadRingViews(
+    views::Widget* parent,
+    const gfx::Rect& button_bounds,
+    SkColor color,
+    bool still)
+    : gfx::LinearAnimation(still ? stedding::kDownloadStillRingDuration
+                                 : stedding::kDownloadRingDuration,
+                           gfx::LinearAnimation::kDefaultFrameRate,
+                           /*delegate=*/nullptr),
+      button_bounds_(button_bounds),
+      color_(color),
+      still_(still) {
+  if (const StartedCallback& started = RingStartedForTesting(); started) {
+    started.Run(button_bounds_, still_);
+  }
+  // The popup is square, room for the ring at its largest round the
+  // button's middle.
+  const int side =
+      static_cast<int>(std::ceil(
+          std::max(button_bounds_.width(), button_bounds_.height()) *
+          stedding::kDownloadRingLargest)) +
+      2 * static_cast<int>(std::ceil(kRingStrokeDip));
+  const gfx::Point centre = button_bounds_.CenterPoint();
+
+  popup_ = new views::Widget;
+  views::Widget::InitParams params(
+      views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_POPUP);
+  params.name = kWidgetName;
+  params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+  params.accept_events = false;
+  params.activatable = views::Widget::InitParams::Activatable::kNo;
+  params.parent = parent->GetNativeView();
+  params.bounds = gfx::Rect(centre.x() - side / 2, centre.y() - side / 2,
+                            side, side);
+  popup_->Init(std::move(params));
+  popup_->SetContentsView(this);
+  popup_->ShowInactive();
+
+  Start();
+}
+
+SteddingDownloadRingViews::~SteddingDownloadRingViews() = default;
+
+void SteddingDownloadRingViews::OnPaint(gfx::Canvas* canvas) {
+  const stedding::DownloadRingFrame frame =
+      stedding::DownloadRingAt(GetCurrentValue(), still_);
+  const float radius =
+      std::max(button_bounds_.width(), button_bounds_.height()) *
+      frame.scale / 2.0f;
+  const gfx::PointF centre = gfx::RectF(GetLocalBounds()).CenterPoint();
+
+  cc::PaintFlags fill;
+  fill.setAntiAlias(true);
+  fill.setStyle(cc::PaintFlags::kFill_Style);
+  fill.setColor(WithOpacity(color_, kRingFillShare * frame.opacity));
+  canvas->DrawCircle(centre, radius, fill);
+
+  cc::PaintFlags ring;
+  ring.setAntiAlias(true);
+  ring.setStyle(cc::PaintFlags::kStroke_Style);
+  ring.setStrokeWidth(kRingStrokeDip);
+  ring.setColor(WithOpacity(color_, frame.opacity));
+  canvas->DrawCircle(centre, radius - kRingStrokeDip / 2.0f, ring);
+}
+
+void SteddingDownloadRingViews::AnimateToState(double state) {
+  if (state >= 1.0) {
+    popup_->Close();
+    return;
+  }
+  SchedulePaint();
+}
+
+BEGIN_METADATA(SteddingDownloadRingViews)
+END_METADATA
