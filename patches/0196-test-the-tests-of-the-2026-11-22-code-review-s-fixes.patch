+#include "ui/events/test/event_generator.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_utils.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The strip of recent tabs, held by Ctrl after Ctrl-Tab, with three Spaces of
+// two tabs each.
+class RecentTabsStripW2B29Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpCommandLine(
+        command_line);
+    stedding::test::ForceScaleOneForEventGenerator(command_line);
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    // The window paints as active for as long as a step wants it to,
+    // whatever other windows on the machine do meanwhile: a window that
+    // stops being active ends the run on its own (switcher X3).
+    active_ = widget()->LockPaintAsActive();
+  }
+
+  void TearDownOnMainThread() override {
+    active_.reset();
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+
+  // Three Spaces of two tabs each, the first one active.
+  void MakeThreeSpaces() {
+    AppendTab();
+    ids_.push_back(model()->active_id());
+    ids_.push_back(model()->AddSpace("Two", SK_ColorBLUE)->id());
+    ids_.push_back(model()->AddSpace("Three", SK_ColorGREEN)->id());
+    for (size_t i = 1; i < ids_.size(); ++i) {
+      model()->SetActiveSpace(ids_[i]);
+      while (TabsIn(ids_[i]) < 2) {
+        AppendTab();
+      }
+    }
+    model()->SetActiveSpace(ids_[0]);
+    ASSERT_EQ(6, tab_strip_model()->count());
+    for (const spaces::SpaceId& id : ids_) {
+      ASSERT_EQ(2, TabsIn(id));
+    }
+  }
+
+  int TabsIn(const spaces::SpaceId& id) {
+    int count = 0;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      if (model()->SpaceForTab(tab_strip_model()->GetTabAtIndex(i)) == id) {
+        ++count;
+      }
+    }
+    return count;
+  }
+
+  // Every tab of `id` used once, in the strip's order, so a run in that
+  // Space has both of its tabs to walk.
+  void UseTabsOf(const spaces::SpaceId& id) {
+    std::vector<tabs::TabInterface*> own;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(i);
+      if (model()->SpaceForTab(tab) == id) {
+        own.push_back(tab);
+      }
+    }
+    for (tabs::TabInterface* const tab : own) {
+      tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(tab));
+    }
+  }
+
+  void Run(int command_id) {
+    SCOPED_TRACE(testing::Message() << "command " << command_id);
+    chrome::ExecuteCommand(browser(), command_id);
+  }
+
+  // Ctrl down or up where the strip's window monitor hears it, as the
+  // keyboard's are: on the Mac through -[NSApp sendEvent:], elsewhere into
+  // the window.
+  void Control(bool down) {
+    ui::test::EventGenerator events(views::GetRootWindow(widget()),
+                                    widget()->GetNativeWindow());
+#if BUILDFLAG(IS_MAC)
+    events.set_target(ui::test::EventGenerator::Target::APPLICATION);
+#else
+    widget()->Activate();
+    browser_view()->GetFocusManager()->ClearFocus();
+#endif
+    if (down) {
+      events.PressKey(ui::VKEY_CONTROL, ui::EF_CONTROL_DOWN);
+    } else {
+      events.ReleaseKey(ui::VKEY_CONTROL, ui::EF_NONE);
+    }
+    base::RunLoop().RunUntilIdle();
+  }
+
+  // The strip, a layered child of the BrowserView, found by its class name
+  // so the test needs no dependency on its target. Present while it is a
+  // child at all; up while it is also shown.
+  views::View* Strip() {
+    for (views::View* const child : browser_view()->children()) {
+      if (std::string_view(child->GetClassName()) == "RecentTabsSwitcherView") {
+        return child;
+      }
+    }
+    return nullptr;
+  }
+  bool StripUp() {
+    views::View* const strip = Strip();
+    return strip && strip->GetVisible();
+  }
+
+  // Lets `delay` pass with the loop running.
+  static void Wait(base::TimeDelta delay) {
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, run_loop.QuitClosure(), delay);
+    run_loop.Run();
+  }
+
+  std::vector<spaces::SpaceId> ids_;
+
+ private:
+  std::unique_ptr<views::Widget::PaintAsActiveLock> active_;
+};
+
+// P39-1c, switcher X1, X3: a Space switch ends a run where it is, and that
+// takes the strip down at once, with Ctrl still held. On the Mac, Ctrl-2 is
+// Space 2's chord and comes with the run's own Ctrl down, so the strip's
+// monitor let it pass: the strip stayed over the new Space's page with the
+// old Space's tabs until Ctrl was let go. A switch made before the hold
+// delay showed the strip 150 ms later over the new Space, its run already
+// over.
+IN_PROC_BROWSER_TEST_F(RecentTabsStripW2B29Test,
+                       ASpaceSwitchThatEndsTheRunTakesTheStripDown) {
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces());
+  UseTabsOf(ids_[0]);
+
+  {
+    SCOPED_TRACE("a switch while the strip is up");
+    ASSERT_NO_FATAL_FAILURE(Control(/*down=*/true));
+    Run(IDC_CYCLE_TO_NEXT_TAB);
+    ASSERT_TRUE(model()->in_cycle());
+    ASSERT_TRUE(base::test::RunUntil([&]() { return StripUp(); }))
+        << "holding Ctrl showed no strip";
+    Run(IDC_STEDDING_SPACE_2);
+    EXPECT_EQ(ids_[1], model()->active_id());
+    EXPECT_FALSE(model()->in_cycle()) << "the switch did not end the run";
+    base::RunLoop().RunUntilIdle();
+    EXPECT_FALSE(StripUp())
+        << "the strip stayed over the new Space's page while Ctrl was held";
+    ASSERT_NO_FATAL_FAILURE(Control(/*down=*/false));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Strip(); }));
+  }
+
+  {
+    SCOPED_TRACE("a switch before the hold delay");
+    UseTabsOf(ids_[1]);
+    ASSERT_NO_FATAL_FAILURE(Control(/*down=*/true));
+    Run(IDC_CYCLE_TO_NEXT_TAB);
+    ASSERT_TRUE(model()->in_cycle());
+    ASSERT_FALSE(StripUp()) << "the premise: the hold delay has not passed";
+    Run(IDC_STEDDING_SPACE_1);
+    EXPECT_EQ(ids_[0], model()->active_id());
+    EXPECT_FALSE(model()->in_cycle()) << "the switch did not end the run";
+    // Well past the hold delay (150 ms).
+    Wait(base::Milliseconds(500));
+    EXPECT_FALSE(StripUp())
+        << "the hold delay showed the strip of a run that had ended";
+    ASSERT_NO_FATAL_FAILURE(Control(/*down=*/false));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Strip(); }));
+  }
+}
+
+// Child tabs in the horizontal strip, with "Show tabs under the tab that
+// opened them" on (settings T26).
+class ChildTabsHorizontalW2B29Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    prefs()->SetBoolean(stedding::prefs::kNestChildTabs, true);
+  }
+
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  TabStripModel* tabs() { return browser()->tab_strip_model(); }
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+
+  GURL Url(const std::string& host) {
+    return embedded_test_server()->GetURL(host, "/title1.html");
+  }
+
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+  bool Hidden(tabs::TabInterface* tab) {
+    return tabs()->IsTabHidden(Index(tab));
+  }
+
+  // A link opened from `from` in a background tab, as a middle click or
+  // Cmd-click opens one (Chromium's OpenURLFromTab).
+  tabs::TabInterface* OpenLinkFrom(tabs::TabInterface* from,
+                                   const std::string& host) {
+    tabs()->ActivateTabAt(Index(from));
+    NavigateParams params(browser(), Url(host), ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::kNewBackgroundTab;
+    params.source_contents = from->GetContents();
+    Navigate(&params);
+    content::WebContents* const opened = params.navigated_or_inserted_contents;
+    EXPECT_TRUE(opened && content::WaitForLoadStop(opened));
+    const int index = tabs()->GetIndexOfWebContents(opened);
+    return index == TabStripModel::kNoTab ? nullptr
+                                          : tabs()->GetTabAtIndex(index);
+  }
+
+  TabStrip* strip() {
+    return browser_view()->horizontal_tab_strip_for_testing();
+  }
+
+  // `tab`'s tab in the horizontal strip.
+  Tab* StripTab(tabs::TabInterface* tab) {
+    return strip() ? strip()->tab_at(Index(tab)) : nullptr;
+  }
+
+  // Whether the strip draws `tab`, once what a change posted has run and the
+  // strip has laid out.
+  bool Drawn(tabs::TabInterface* tab) {
+    base::RunLoop().RunUntilIdle();
+    views::test::RunScheduledLayout(widget());
+    Tab* const view = StripTab(tab);
+    return view && view->GetVisible();
+  }
+
+  // Lays the strip out with the filter read again, as any later relayout of
+  // it does, so each step below starts from a strip that agrees with the
+  // model; what the step itself changes must reach the strip on its own.
+  void BringTheStripInLine() {
+    strip()->OnTabFilterChanged(/*animate=*/false);
+    views::test::RunScheduledLayout(widget());
+  }
+};
+
+// P39-1b, tabs R60, spaces B34: with horizontal tabs, Fold Child Tabs takes
+// the children's tabs out of the strip and Unfold brings them back; turning
+// the nesting setting off shows a folded child and on again hides it; and a
+// folded child that comes on screen has its tab, which goes again when
+// another tab does. The strip heard none of these: the children stayed drawn
+// until some unrelated relayout, and a folded child made active had no tab.
+IN_PROC_BROWSER_TEST_F(ChildTabsHorizontalW2B29Test,
+                       HorizontalTabsFollowAFoldOfChildTabs) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  ASSERT_EQ(stedding::TabToken(page->GetContents()),
+            stedding::TabParentToken(child->GetContents()));
+
+  ExitVerticalTabsMode();
+  ASSERT_FALSE(
+      vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+  ASSERT_TRUE(strip());
+  tabs()->ActivateTabAt(Index(page));
+  ASSERT_TRUE(Drawn(child)) << "the premise: the child has its tab";
+
+  constexpr int kFold = TabStripModel::CommandSteddingFoldChildTabs;
+  constexpr int kUnfold = TabStripModel::CommandSteddingUnfoldChildTabs;
+
+  {
+    SCOPED_TRACE("Fold Child Tabs");
+    ASSERT_TRUE(stedding::IsTabMenuRowVisible(*tabs(), Index(page), kFold));
+    stedding::ExecuteTabMenuVerb(*tabs(), Index(page), kFold);
+    ASSERT_TRUE(stedding::ChildrenFolded(page->GetContents()));
+    ASSERT_TRUE(Hidden(child));
+    EXPECT_FALSE(Drawn(child)) << "the folded child stayed drawn";
+    EXPECT_TRUE(Drawn(page));
+  }
+
+  {
+    SCOPED_TRACE("Unfold Child Tabs");
+    BringTheStripInLine();
+    ASSERT_FALSE(Drawn(child));
+    stedding::ExecuteTabMenuVerb(*tabs(), Index(page), kUnfold);
+    ASSERT_FALSE(stedding::ChildrenFolded(page->GetContents()));
+    ASSERT_FALSE(Hidden(child));
+    EXPECT_TRUE(Drawn(child)) << "the unfolded child stayed hidden";
+  }
+
+  {
+    SCOPED_TRACE("the setting off and on with the children folded");
+    stedding::ExecuteTabMenuVerb(*tabs(), Index(page), kFold);
+    ASSERT_TRUE(stedding::ChildrenFolded(page->GetContents()));
+    BringTheStripInLine();
+    ASSERT_FALSE(Drawn(child));
+    prefs()->SetBoolean(stedding::prefs::kNestChildTabs, false);
+    ASSERT_FALSE(Hidden(child));
+    EXPECT_TRUE(Drawn(child))
+        << "turning the setting off left the folded child hidden";
+    BringTheStripInLine();
+    ASSERT_TRUE(Drawn(child));
+    prefs()->SetBoolean(stedding::prefs::kNestChildTabs, true);
+    ASSERT_TRUE(Hidden(child));
+    EXPECT_FALSE(Drawn(child))
+        << "turning the setting on left the folded child drawn";
+  }
+
+  {
+    SCOPED_TRACE("a folded child on screen, then another tab");
+    BringTheStripInLine();
+    ASSERT_FALSE(Drawn(child));
+    tabs()->ActivateTabAt(Index(child));
+    ASSERT_FALSE(Hidden(child)) << "the tab on screen keeps its place";
+    ASSERT_TRUE(Drawn(child)) << "the active tab has no tab in the strip";
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return StripTab(child)->width() > 0;
+    })) << "the active tab's tab takes no room";
+
+    tabs()->ActivateTabAt(Index(page));
+    ASSERT_TRUE(Hidden(child));
+    EXPECT_FALSE(Drawn(child))
+        << "the folded child kept its tab after another tab came on screen";
+  }
+}
+
+}  // namespace
