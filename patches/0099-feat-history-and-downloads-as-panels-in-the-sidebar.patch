+      safe_browsing::ScopedMarkAllFilesDangerousForTesting();
+  content::DownloadTestObserverTerminal waiter(
+      manager(), 1, content::DownloadTestObserver::ON_DANGEROUS_DOWNLOAD_QUIT);
+  ui_test_utils::NavigateToURLWithDisposition(
+      browser(),
+      embedded_test_server()->GetURL("/downloads/dangerous/dangerous.swf"),
+      WindowOpenDisposition::CURRENT_TAB, ui_test_utils::BROWSER_TEST_NO_WAIT);
+  waiter.WaitForFinished();
+  content::DownloadManager::DownloadVector items;
+  manager()->GetAllDownloads(&items);
+  ASSERT_EQ(1u, items.size());
+  download::DownloadItem* const item = items.front().get();
+  ASSERT_TRUE(item->IsDangerous());
+  const std::string id = base::NumberToString(item->GetId());
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_DOWNLOADS));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kDownloads));
+  ASSERT_TRUE(WaitForRows(1));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(), RowFor("id", id) +
+                                             ".classList.contains('dangerous')")
+        .ExtractBool();
+  }));
+  EXPECT_EQ(1, content::EvalJs(panel_page(),
+                               RowFor("id", id) +
+                                   ".querySelectorAll('[data-action]').length"))
+      << "a dangerous row offers more than the way to the page";
+  EXPECT_EQ(false, content::EvalJs(panel_page(),
+                                   "!!" + RowFor("id", id) +
+                                       ".querySelector('.menu-button')"));
+
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(),
+      RowFor("id", id) + ".querySelector('[data-action=review]').click()"));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kNone));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return tabs()->GetActiveWebContents()->GetVisibleURL().host() ==
+           "downloads";
+  }));
+  EXPECT_TRUE(item->IsDangerous()) << "the panel decided for the user";
