+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsSteddingShortcutsEditorElement} from './stedding_shortcuts_editor.js';
+
+export function getHtml(this: SettingsSteddingShortcutsEditorElement) {
+  return html`<!--_html_template_start_-->
+<div class="box tools">
+  <cr-input id="shortcutSearch" type="search"
+      placeholder="$i18n{steddingShortcutsSearch}"
+      aria-label="$i18n{steddingShortcutsSearch}"
+      .value="${this.search_}" @input="${this.onSearchInput_}">
+  </cr-input>
+  <select id="shortcutGroup" aria-label="$i18n{steddingShortcutsGroup}"
+      @change="${this.onGroupChange_}">
+    <option value="" ?selected="${!this.groupFilter_}">
+      $i18n{steddingShortcutsAllGroups}
+    </option>
+    ${this.groups_.map(group => html`
+      <option value="${group.title}"
+          ?selected="${this.groupFilter_ === group.title}">
+        ${group.title}
+      </option>`)}
+  </select>
+</div>
+<div id="shortcutPrompt" role="status" aria-live="polite">${this.prompt_}</div>
+${this.noMatch_() ? html`
+  <div class="box note" id="shortcutNoMatch">
+    $i18n{steddingShortcutsNoMatch}
+  </div>` : ''}
+${this.visibleGroups_().map(group => html`
+  <div class="box shortcut-group">
+    <div class="shortcut-group-title">${group.title}</div>
+    ${group.rows.map(row => html`
+      <div class="shortcut-row ${row.off ? 'off' : ''}" data-name="${row.name}">
+        <span class="what">${row.label}</span>
+        <span class="chords">
+          ${row.off ? html`
+            <span class="note off-note">$i18n{steddingShortcutsOff}</span>` :
+            ''}
+          ${row.chords.map(chord => html`
+            <span class="chip">
+              <kbd class="chord">${chord.text}</kbd>
+              ${row.rebind && !row.off && !row.macos ? html`
+                <cr-icon-button class="icon-clear remove-chord"
+                    data-name="${row.name}" data-value="${chord.value}"
+                    title="${this.removeLabel_(chord)}"
+                    aria-label="${this.removeLabel_(chord)}"
+                    @click="${this.onRemoveClick_}">
+                </cr-icon-button>` : ''}
+            </span>`)}
+          ${!row.off && row.chords.length === 0 ? html`
+            <span class="note none-note">$i18n{steddingShortcutsNone}</span>` :
+            ''}
+        </span>
+        ${row.changed ? html`
+          <span class="note default-note">${this.defaultsLine_(row)}</span>` :
+          ''}
+        ${row.lost.length ? html`
+          <span class="note lost-note">${this.lostLine_(row)}</span>` : ''}
+        ${row.macos ? html`
+          <span class="note macos-note">$i18n{steddingShortcutsMacos}</span>` :
+          ''}
+        ${!row.rebind && !row.toggle ? html`
+          <span class="note fixed-note">$i18n{steddingShortcutsFixed}</span>` :
+          ''}
+        ${row.rebind && !row.macos ? html`
+          <cr-button class="add-button ${this.isRecording_(row) ?
+              'recording' : ''}"
+              data-name="${row.name}"
+              aria-pressed="${this.isRecording_(row)}"
+              @click="${this.onAddClick_}">
+            ${this.addLabel_(row)}
+          </cr-button>` : ''}
+        ${row.changed && row.toggle ? html`
+          <cr-button class="reset-button" data-name="${row.name}"
+              @click="${this.onResetClick_}">
+            $i18n{steddingShortcutsReset}
+          </cr-button>` : ''}
+        ${row.toggle ? html`
+          <cr-toggle class="row-switch" data-name="${row.name}"
+              ?checked="${!row.off}"
+              title="${row.label}" aria-label="${row.label}"
+              @change="${this.onSwitchChange_}">
+          </cr-toggle>` : ''}
+      </div>
+      ${row.layouts ? html`
+        <div class="number-keys">
+          <span class="what">$i18n{steddingShortcutsNumberKeys}</span>
+          <select id="numberKeys" aria-label="$i18n{steddingShortcutsNumberKeys}"
+              @change="${this.onNumberKeysChange_}">
+            ${row.layouts.map(layout => html`
+              <option value="${layout.value}" ?selected="${layout.selected}">
+                ${layout.text}
+              </option>`)}
+          </select>
+          ${row.layoutNote ? html`
+            <span class="note number-keys-note">${row.layoutNote}</span>` :
+            ''}
+        </div>` : ''}
+      ${this.pendingFor_(row) ? html`
+        <div class="shortcut-conflict" role="alert" data-name="${row.name}">
+          <span class="message">${this.pendingFor_(row)!.message}</span>
+          ${this.pendingFor_(row)!.kind === 'conflict' ? html`
+            <cr-button class="replace-button action-button"
+                @click="${this.onReplaceClick_}">
+              $i18n{steddingShortcutsReplace}
+            </cr-button>
+            <cr-button class="cancel-button"
+                @click="${this.onPendingDismissClick_}">
+              $i18n{steddingShortcutsCancel}
+            </cr-button>` : html`
+            <cr-button class="dismiss-button"
+                @click="${this.onPendingDismissClick_}">
+              $i18n{steddingShortcutsOk}
+            </cr-button>`}
+        </div>` : ''}`)}
+  </div>`)}
+<div class="box tools">
+  <cr-button id="resetAll" @click="${this.onResetAllClick_}">
+    $i18n{steddingShortcutsResetAll}
+  </cr-button>
+</div>
+${this.reference_.map(group => html`
+  <div class="box shortcut-group shortcut-reference">
+    <div class="shortcut-group-title">${group.title}</div>
+    ${group.rows.map(row => html`
+      <div class="shortcut-reference-row">
+        <kbd class="chord">${row.chord}</kbd>
+        <span class="what">${row.what}</span>
+        ${row.chromium ? html`
+          <span class="chromium">Chromium: ${row.chromium}</span>` : ''}
+      </div>`)}
+  </div>`)}
+<cr-dialog id="resetAllDialog">
+  <div slot="title">$i18n{steddingShortcutsResetAllTitle}</div>
+  <div slot="body">$i18n{steddingShortcutsResetAllBody}</div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" @click="${this.onResetAllCancelClick_}">
+      $i18n{steddingShortcutsCancel}
+    </cr-button>
+    <cr-button class="action-button" id="resetAllConfirm"
+        @click="${this.onResetAllConfirmClick_}">
+      $i18n{steddingShortcutsResetAll}
+    </cr-button>
+  </div>
+</cr-dialog>
+<!--_html_template_end_-->`;
+}
diff --git a/chrome/browser/resources/settings/stedding_page/stedding_shortcuts_editor.ts b/chrome/browser/resources/settings/stedding_page/stedding_shortcuts_editor.ts
