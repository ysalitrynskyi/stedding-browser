+      return;
+    }
+  }
+
+  if (fingers_down) {
+    if (gesture_state_ == GestureState::kHorizontalSwipe) {
+      // A swipe whose lift never came: it ends where it is.
+      EndSpaceSwipe();
+    }
+    ResetGesture();
+  }
+
+  if (lift) {
+    if (gesture_state_ == GestureState::kHorizontalSwipe) {
+      event->SetHandled();
+      event->StopPropagation();
