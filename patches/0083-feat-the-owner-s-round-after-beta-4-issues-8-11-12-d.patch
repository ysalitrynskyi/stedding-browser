+bool WaitForRowsToSettleAtFramePace(views::Widget* widget) {
+  const base::TimeTicks give_up =
+      base::TimeTicks::Now() + TestTimeouts::action_timeout();
+  while (base::TimeTicks::Now() < give_up) {
+    base::RunLoop frame;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, frame.QuitClosure(), base::Milliseconds(16));
+    frame.Run();
+    views::test::RunScheduledLayout(widget);
+    if (!AnyRowMoves(widget->GetRootView())) {
+      return true;
+    }
+  }
+  return false;
