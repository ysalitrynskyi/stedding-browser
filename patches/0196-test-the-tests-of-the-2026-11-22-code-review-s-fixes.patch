+// The test store: Chromium's own Web Store test data, the crx and its key,
+// as the synced-extensions tests use it.
+constexpr char kWebstoreDomainW2B20[] = "cws.com";
+constexpr char kAppDomainW2B20[] = "app.com";
+constexpr char kNonAppDomainW2B20[] = "nonapp.com";
+constexpr char kTestDataPathW2B20[] =
+    "extensions/api_test/webstore_inline_install";
+constexpr char kCrxFilenameW2B20[] = "extension.crx";
+constexpr char kExtensionIdW2B20[] = "ecglahbcnmdpdciemllbhojghbkagdje";
+constexpr char kExtensionNameW2B20[] = "Inline Install Test Extension";
+constexpr char kManifestW2B20[] = R"({
+  "name": "Inline Install Test Extension",
+  "version": "0.1",
+  "manifest_version": 2,
+  "icons": {"128": "icon.png"},
+  "permissions":["tabs"]
+})";
+
+// The other computer.
+constexpr char kPeerW2B20[] = "0123456789abcdef";
+
+int64_t NowMsW2B20() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+std::unique_ptr<extensions::FetchItemSnippetResponse> StoreAnswerW2B20() {
+  auto answer = std::make_unique<extensions::FetchItemSnippetResponse>();
+  answer->set_item_id(kExtensionIdW2B20);
+  answer->set_title(kExtensionNameW2B20);
+  answer->set_manifest(kManifestW2B20);
+  answer->set_logo_uri("webstore_inline_install/extension/icon.png");
+  answer->set_user_count_string("371,674");
+  answer->set_rating_count_string("788");
+  answer->set_rating_count(788);
+  answer->set_average_rating(4.36);
+  return answer;
+}
+
+// The other computer's sidebar: one Space, no pins.
+sb::State PeerStateW2B20(const std::string& space, int64_t t) {
+  sb::State state;
+  const sb::Stamp stamp{t, kPeerW2B20};
+  sb::Record record(sb::Kind::kSpace);
+  record.f[sb::kFieldName] = sb::Field{"Peer Space", stamp};
+  record.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+  record.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+  state.records[space] = record;
+  state.lists[sb::kSpacesList].order = {space};
+  state.lists[sb::kSpacesList].s = stamp;
+  state.lists[sb::PinsListOf(space)].s = stamp;
+  return state;
+}
