+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_ID_H_
diff --git a/chrome/browser/ui/spaces/space_model.cc b/chrome/browser/ui/spaces/space_model.cc
new file mode 100644
index 0000000000000..02f101d7c4435
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_model.cc
@@ -0,0 +1,106 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_model.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/check.h"
+
+namespace spaces {
+
+namespace {
+// Every window starts with one Space so that "no Space" is never a state a
+// caller has to handle. It is deliberately unnamed: a single unnamed Space is
+// indistinguishable from an ordinary window, which is what a user who has never
+// heard of Spaces should see.
+constexpr SkColor kDefaultSpaceColor = SkColorSetRGB(0x5B, 0x6B, 0x8C);
+}  // namespace
+
+// SpaceId has no default constructor by design — an id that names nothing is not
+// a state worth representing — so the default Space's id is generated first and
+// used for both the Space and the active pointer. No observer can exist yet, so
+// this deliberately does not notify.
+SpaceModel::SpaceModel() : active_id_(SpaceId::GenerateNew()) {
+  spaces_.push_back(std::make_unique<Space>(active_id_, std::string(),
+                                            kDefaultSpaceColor));
+}
+
+SpaceModel::~SpaceModel() = default;
+
+void SpaceModel::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SpaceModel::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+Space* SpaceModel::active_space() {
+  Space* space = GetSpace(active_id_);
+  CHECK(space) << "active_id_ must always name a live Space";
+  return space;
+}
+
+Space* SpaceModel::GetSpace(const SpaceId& id) {
+  auto it = std::ranges::find_if(
+      spaces_, [&id](const std::unique_ptr<Space>& s) { return s->id() == id; });
+  return it == spaces_.end() ? nullptr : it->get();
+}
+
+Space* SpaceModel::AddSpace(std::string name, SkColor color) {
+  spaces_.push_back(
+      std::make_unique<Space>(SpaceId::GenerateNew(), std::move(name), color));
+  Space* added = spaces_.back().get();
+  observers_.Notify(&Observer::OnSpaceAdded, added->id());
+  return added;
+}
+
+bool SpaceModel::RemoveSpace(const SpaceId& id) {
+  // A window must always have somewhere for its tabs to live, and removing the
+  // active Space would orphan the tabs currently in the tab strip. Both are
+  // refused rather than half-handled.
+  if (spaces_.size() <= 1u || id == active_id_) {
+    return false;
+  }
+  auto it = std::ranges::find_if(
+      spaces_, [&id](const std::unique_ptr<Space>& s) { return s->id() == id; });
+  if (it == spaces_.end()) {
+    return false;
+  }
+  spaces_.erase(it);
+  observers_.Notify(&Observer::OnSpaceRemoved, id);
+  return true;
+}
+
+void SpaceModel::SetActiveSpace(const SpaceId& id) {
+  CHECK(GetSpace(id)) << "cannot activate a Space this window does not have";
+  if (id == active_id_) {
+    return;
+  }
+  const SpaceId previous = active_id_;
+  active_id_ = id;
+  observers_.Notify(&Observer::OnActiveSpaceChanged, previous, active_id_);
+}
+
+void SpaceModel::SetSpaceName(const SpaceId& id, std::string name) {
+  Space* space = GetSpace(id);
+  if (!space) {
+    return;
+  }
+  space->SetName(std::move(name));
+  observers_.Notify(&Observer::OnSpaceMetadataChanged, id);
+}
+
+void SpaceModel::SetSpaceColor(const SpaceId& id, SkColor color) {
+  Space* space = GetSpace(id);
+  if (!space) {
+    return;
+  }
+  space->SetColor(color);
+  observers_.Notify(&Observer::OnSpaceMetadataChanged, id);
+}
+
+}  // namespace spaces
diff --git a/chrome/browser/ui/spaces/space_model.h b/chrome/browser/ui/spaces/space_model.h
new file mode 100644
index 0000000000000..8c986491acaaa
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_model.h
@@ -0,0 +1,79 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_MODEL_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_MODEL_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+
+namespace spaces {
+
+// The Spaces belonging to one browser window, and which of them is active.
+//
+// One window has exactly one SpaceModel and always at least one Space, so
+// "no Space" is not a state any caller has to handle.
+//
+// Deliberately not a window and not a tab group. A Space is a parked
+// TabStripCollection, so a window keeps one TabStripModel and Chrome's tab
+// groups keep working unchanged. Modelling a Space as a window would multiply
+// windows; modelling it as a group would inherit the contiguity and
+// single-group-per-tab assumptions that groups carry throughout the codebase.
+class SpaceModel {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnSpaceAdded(const SpaceId& id) {}
+    virtual void OnSpaceRemoved(const SpaceId& id) {}
+    virtual void OnActiveSpaceChanged(const SpaceId& from, const SpaceId& to) {}
+    virtual void OnSpaceMetadataChanged(const SpaceId& id) {}
+  };
+
+  SpaceModel();
+  ~SpaceModel();
+  SpaceModel(const SpaceModel&) = delete;
+  SpaceModel& operator=(const SpaceModel&) = delete;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Never empty: a default Space is created on construction.
+  const std::vector<std::unique_ptr<Space>>& spaces() const { return spaces_; }
+  size_t size() const { return spaces_.size(); }
+
+  const SpaceId& active_id() const { return active_id_; }
+  Space* active_space();
+
+  // Null if no Space carries this id.
+  Space* GetSpace(const SpaceId& id);
+
+  Space* AddSpace(std::string name, SkColor color);
+
+  // Removing the active Space, or the last one, is refused: a window must
+  // always have somewhere for its tabs to be. Returns false without changing
+  // anything.
+  bool RemoveSpace(const SpaceId& id);
+
+  // Records the new active Space. Moving the tabs is the caller's job — this
+  // object owns the arrangement, not the tab strip.
+  void SetActiveSpace(const SpaceId& id);
+
+  void SetSpaceName(const SpaceId& id, std::string name);
+  void SetSpaceColor(const SpaceId& id, SkColor color);
+
+ private:
+  std::vector<std::unique_ptr<Space>> spaces_;
+  SpaceId active_id_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_MODEL_H_
diff --git a/chrome/browser/ui/spaces/space_model_unittest.cc b/chrome/browser/ui/spaces/space_model_unittest.cc
new file mode 100644
index 0000000000000..1151fee68b44c
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_model_unittest.cc
@@ -0,0 +1,114 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_model.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+namespace {
+
+constexpr SkColor kRed = SkColorSetRGB(0xFF, 0x00, 0x00);
+constexpr SkColor kBlue = SkColorSetRGB(0x00, 0x00, 0xFF);
+
+TEST(SpaceModelTest, StartsWithExactlyOneActiveSpace) {
+  SpaceModel model;
+  EXPECT_EQ(1u, model.size());
+  ASSERT_TRUE(model.active_space());
+  EXPECT_EQ(model.active_space()->id(), model.active_id());
+  // The default Space is active, so it holds no parked tree.
+  EXPECT_TRUE(model.active_space()->is_active());
+}
+
+TEST(SpaceModelTest, AddsAndFindsSpaces) {
+  SpaceModel model;
+  Space* work = model.AddSpace("Work", kRed);
+  ASSERT_TRUE(work);
+  EXPECT_EQ(2u, model.size());
+  EXPECT_EQ(work, model.GetSpace(work->id()));
+  EXPECT_EQ("Work", work->name());
+  EXPECT_EQ(kRed, work->color());
+}
+
+TEST(SpaceModelTest, DistinctSpacesGetDistinctIds) {
+  SpaceModel model;
+  EXPECT_NE(model.AddSpace("A", kRed)->id(), model.AddSpace("B", kBlue)->id());
+}
+
+TEST(SpaceModelTest, ActivatingChangesActiveId) {
+  SpaceModel model;
+  const SpaceId original = model.active_id();
+  Space* other = model.AddSpace("Other", kBlue);
+  model.SetActiveSpace(other->id());
+  EXPECT_EQ(other->id(), model.active_id());
+  EXPECT_NE(original, model.active_id());
+}
+
+// A window must always have somewhere for its tabs to be, so these two removals
+// are refused rather than half-handled.
+TEST(SpaceModelTest, RefusesToRemoveTheLastSpace) {
+  SpaceModel model;
+  EXPECT_FALSE(model.RemoveSpace(model.active_id()));
+  EXPECT_EQ(1u, model.size());
+}
+
+TEST(SpaceModelTest, RefusesToRemoveTheActiveSpace) {
+  SpaceModel model;
+  model.AddSpace("Other", kBlue);
+  EXPECT_FALSE(model.RemoveSpace(model.active_id()));
+  EXPECT_EQ(2u, model.size());
+}
+
+TEST(SpaceModelTest, RemovesAnInactiveSpace) {
+  SpaceModel model;
+  Space* other = model.AddSpace("Other", kBlue);
+  const SpaceId id = other->id();
+  EXPECT_TRUE(model.RemoveSpace(id));
+  EXPECT_EQ(1u, model.size());
+  EXPECT_FALSE(model.GetSpace(id));
+}
+
+TEST(SpaceModelTest, RenameAndRecolour) {
+  SpaceModel model;
+  Space* space = model.AddSpace("Old", kRed);
+  model.SetSpaceName(space->id(), "New");
+  model.SetSpaceColor(space->id(), kBlue);
+  EXPECT_EQ("New", space->name());
+  EXPECT_EQ(kBlue, space->color());
+}
+
+class CountingObserver : public SpaceModel::Observer {
+ public:
+  void OnSpaceAdded(const SpaceId& id) override { ++added; }
+  void OnSpaceRemoved(const SpaceId& id) override { ++removed; }
+  void OnActiveSpaceChanged(const SpaceId& from, const SpaceId& to) override {
+    ++activated;
+  }
+  int added = 0;
+  int removed = 0;
+  int activated = 0;
+};
+
+TEST(SpaceModelTest, NotifiesObservers) {
+  SpaceModel model;
+  CountingObserver observer;
+  model.AddObserver(&observer);
+
+  Space* space = model.AddSpace("Work", kRed);
+  EXPECT_EQ(1, observer.added);
+
+  model.SetActiveSpace(space->id());
+  EXPECT_EQ(1, observer.activated);
+
+  // Re-activating the same Space is not a change and must not notify.
+  model.SetActiveSpace(space->id());
+  EXPECT_EQ(1, observer.activated);
+
+  model.RemoveObserver(&observer);
+}
+
+}  // namespace
