+// The address row in its page's colour, as the window's background paints
+// it. The colour is read from what the page paints, and a window covered by
+// another paints nothing: the window stays above the others, and the fixture
+// runs in the serial leg, as PageColourRowTest does.
+class StackedSplitRowW2B25Test : public InProcessBrowserTest {
+ protected:
+  StackedSplitRowW2B25Test() {
+#if defined(USE_AURA)
+    // Off the Mac a browser test draws nothing unless it asks, and the row
+    // reads the page's top edge (trap 113).
+    EnablePixelOutput();
+#endif
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    // In the screen's work area, wide enough for the sidebar, two panes and
+    // a side panel.
+    view()->GetWidget()->SetBounds(gfx::Rect(
+        display::Screen::Get()->GetPrimaryDisplay().work_area().origin(),
+        gfx::Size(1600, 900)));
+    views::test::RunScheduledLayout(view());
+    stedding::test::KeepAboveOtherWindows(view()->GetWidget());
+  }
+
+  // Looked up each time: a pointer kept in the fixture outlives the window.
+  BrowserView* view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  stedding::PageThemeColorController* row() {
+    return stedding::PageThemeColorController::From(browser());
+  }
