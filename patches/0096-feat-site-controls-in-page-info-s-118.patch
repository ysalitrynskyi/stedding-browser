+
+BrowserWindowInterface* BrowserFor(content::WebContents* contents) {
+  tabs::TabInterface* const tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  return tab ? tab->GetBrowserWindowInterface() : nullptr;
+}
+
+Profile* ProfileFor(content::WebContents* contents) {
+  return contents ? Profile::FromBrowserContext(contents->GetBrowserContext())
+                  : nullptr;
+}
+
+// Si7: the profile's Spaces as the session row names them: the name the
+// sidebar shows, "Space N" for one never named (SpaceModel::DisplayName).
+std::vector<SpaceJarEntry> SpaceJarEntriesFor(Profile* profile) {
+  std::vector<SpaceJarEntry> entries;
+  spaces::SpaceRegistry* const registry =
+      profile && !profile->IsOffTheRecord()
+          ? spaces::SpaceRegistryFactory::GetForProfile(profile)
+          : nullptr;
+  if (!registry) {
+    return entries;
+  }
+  int position = 0;
+  for (const spaces::RegistryEntry& entry : registry->entries()) {
+    ++position;
+    entries.push_back({entry.name.empty()
+                           ? u"Space " + base::NumberToString16(position)
+                           : base::UTF8ToUTF16(entry.name),
+                       entry.profile_id, entry.isolated});
+  }
+  return entries;
+}
+
+SiteControlsContext ContextFor(content::WebContents* contents) {
+  SiteControlsContext context;
+  context.window = SiteControlsWindowFor(contents);
+  if (contents) {
+    context.url = contents->GetLastCommittedURL();
+    context.dark_pages_on = DarkPagesOn(ProfileFor(contents));
+  }
+  return context;
+}
+
+// The words and the icon of a strip button for `action`.
+std::u16string NameFor(SiteControlsStripView::Action action,
+                       const SiteControlsStripView::State& state) {
+  switch (action) {
+    case SiteControlsStripView::Action::kCopyLink:
+    case SiteControlsStripView::Action::kCopyMarkdownLink:
+      return l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_COPY_LINK);
+    case SiteControlsStripView::Action::kCopyTitle:
+      return l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_COPY_TITLE);
+    case SiteControlsStripView::Action::kToggleMute:
+      return l10n_util::GetStringUTF16(state.mute_would_mute
+                                           ? IDS_STEDDING_SITE_CONTROLS_MUTE
+                                           : IDS_STEDDING_SITE_CONTROLS_UNMUTE);
+    case SiteControlsStripView::Action::kTogglePictureInPicture:
+      return l10n_util::GetStringUTF16(
+          state.picture_in_picture ==
+                  SiteControlsStripView::PictureInPicture::kExit
+              ? IDS_STEDDING_SITE_CONTROLS_EXIT_PICTURE_IN_PICTURE
+              : IDS_STEDDING_SITE_CONTROLS_PICTURE_IN_PICTURE);
+    case SiteControlsStripView::Action::kZoomOut:
+      return l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_ZOOM_OUT);
+    case SiteControlsStripView::Action::kZoomReset:
+      return l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_RESET_ZOOM);
+    case SiteControlsStripView::Action::kZoomIn:
+      return l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_ZOOM_IN);
+  }
+  NOTREACHED();
+}
+
+const gfx::VectorIcon& IconFor(SiteControlsStripView::Action action,
+                               const SiteControlsStripView::State& state) {
+  switch (action) {
+    case SiteControlsStripView::Action::kCopyLink:
+    case SiteControlsStripView::Action::kCopyMarkdownLink:
+      return vector_icons::kLinkIcon;
+    case SiteControlsStripView::Action::kCopyTitle:
+      return vector_icons::kContentCopyIcon;
+    case SiteControlsStripView::Action::kToggleMute:
+      // The sound as it would be after the press, as a tab's speaker shows.
+      return state.mute_would_mute ? vector_icons::kVolumeOffIcon
+                                   : vector_icons::kVolumeUpIcon;
+    case SiteControlsStripView::Action::kTogglePictureInPicture:
+      return state.picture_in_picture ==
+                     SiteControlsStripView::PictureInPicture::kExit
+                 ? vector_icons::kPipExitIcon
+                 : vector_icons::kPictureInPictureIcon;
+    case SiteControlsStripView::Action::kZoomOut:
+      return kZoomOutIcon;
+    case SiteControlsStripView::Action::kZoomReset:
+    case SiteControlsStripView::Action::kZoomIn:
+      return kZoomInIcon;
+  }
+  NOTREACHED();
+}
+
+// The window command whose chord a strip button shows, or 0 for none.
+int CommandFor(SiteControlsStripView::Action action) {
+  switch (action) {
+    case SiteControlsStripView::Action::kCopyLink:
+      return IDC_COPY_URL;
+    case SiteControlsStripView::Action::kCopyMarkdownLink:
+      return IDC_STEDDING_COPY_MARKDOWN_LINK;
+    case SiteControlsStripView::Action::kCopyTitle:
+      return 0;
+    case SiteControlsStripView::Action::kToggleMute:
+      return IDC_STEDDING_TOGGLE_TAB_MUTED;
+    case SiteControlsStripView::Action::kTogglePictureInPicture:
+      return IDC_STEDDING_TOGGLE_PICTURE_IN_PICTURE;
+    case SiteControlsStripView::Action::kZoomOut:
+      return IDC_ZOOM_MINUS;
+    case SiteControlsStripView::Action::kZoomReset:
+      return IDC_ZOOM_NORMAL;
+    case SiteControlsStripView::Action::kZoomIn:
+      return IDC_ZOOM_PLUS;
+  }
+  NOTREACHED();
+}
