@@ -0,0 +1,119 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Arc's logins written into a profile that already holds a login with no
+// username at the address of a site Arc was told never to save for
+// (docs/features/import.md I23).
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/run_loop.h"
+#include "base/test/test_future.h"
+#include "chrome/browser/password_manager/factories/profile_password_store_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/arc_data_importer.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/keyed_service/core/service_access_type.h"
+#include "components/password_manager/core/browser/password_form.h"
+#include "components/password_manager/core/browser/password_store/password_form_converters.h"
+#include "components/password_manager/core/browser/password_store/password_store_interface.h"
+#include "components/password_manager/core/browser/password_store/password_store_results_observer.h"
+#include "components/password_manager/core/browser/password_store/stored_credential.h"
+#include "components/password_manager/core/browser/password_string.h"
+#include "content/public/test/browser_test.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kRootB09[] = "https://arc-root.example/";
+constexpr char kNeverB09[] = "https://arc-never-b09.example/";
+
+// The logins in the profile's own store.
+std::vector<password_manager::StoredCredential> LoginsB09(Profile* profile) {
+  scoped_refptr<password_manager::PasswordStoreInterface> store =
+      ProfilePasswordStoreFactory::GetForProfile(
+          profile, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!store) {
+    ADD_FAILURE() << "no password store";
+    return {};
+  }
+  password_manager::PasswordStoreResultsObserver observer;
+  store->GetAllLogins(observer.GetWeakPtr());
+  return observer.WaitForResults();
+}
+
+// A login for `site` as the password manager's own "Add" and a file import
+// build one: the address, the realm and the username, no element names.
+password_manager::PasswordForm LoginB09(std::string_view site,
+                                        std::u16string_view username,
+                                        std::u16string_view password) {
+  password_manager::PasswordForm form;
+  form.url = GURL(site);
+  form.signon_realm = std::string(site);
+  form.username_value = std::u16string(username);
+  form.password_value =
+      password_manager::PasswordString(std::u16string(password));
+  form.in_store = password_manager::PasswordForm::Store::kProfileStore;
+  return form;
+}
+
+// A site blocked in Arc, as ReadArcLogins hands it over: the origin, no
+// username, no password, no element names.
+password_manager::PasswordForm BlockedB09(std::string_view site) {
+  password_manager::PasswordForm form = LoginB09(site, u"", u"");
+  form.blocked_by_user = true;
+  return form;
+}
+
+using ArcLoginsBlockedSiteB09Test = InProcessBrowserTest;
+
+// P09-1c, import I23: a site Arc never saves for comes in blocked, but a
+// login saved here at that site's address with no username keeps its
+// password and is not blocked. The blocked row has the store's key of such a
+// login, and replaced it.
+IN_PROC_BROWSER_TEST_F(ArcLoginsBlockedSiteB09Test,
+                       ABlockedSiteDoesNotReplaceALoginWithNoUsername) {
+  Profile* const profile = browser()->GetProfile();
+  scoped_refptr<password_manager::PasswordStoreInterface> store =
+      ProfilePasswordStoreFactory::GetForProfile(
+          profile, ServiceAccessType::EXPLICIT_ACCESS);
+  ASSERT_TRUE(store);
+  base::RunLoop added;
+  store->AddLogin(
+      password_manager::FromPasswordForm(LoginB09(kRootB09, u"", u"keep")),
+      added.QuitClosure());
+  added.Run();
+
+  std::vector<password_manager::PasswordForm> arc;
+  arc.push_back(BlockedB09(kRootB09));
+  arc.push_back(BlockedB09(kNeverB09));
+  base::test::TestFuture<size_t> written;
+  spaces::WriteArcLogins(*profile, std::move(arc), written.GetCallback());
+  EXPECT_EQ(0u, written.Get()) << "a blocked site is no login that came in";
+
+  std::optional<std::u16string> kept;
+  bool root_blocked = false;
+  bool never_blocked = false;
+  for (const password_manager::StoredCredential& login : LoginsB09(profile)) {
+    if (login.signon_realm == kRootB09) {
+      root_blocked |= login.blocked_by_user;
+      if (!login.blocked_by_user && login.username_value.empty()) {
+        kept = login.password_value.value();
+      }
+    }
+    never_blocked |= login.signon_realm == kNeverB09 && login.blocked_by_user;
+  }
+  EXPECT_EQ(u"keep", kept)
+      << "the blocked site went over the login saved here";
+  EXPECT_FALSE(root_blocked);
+  EXPECT_TRUE(never_blocked) << "a site blocked in Arc is not blocked here";
+}
+
