+// A real window's rows, pressed, dragged in steps and released through the
+// window's root view, as tab_drop_browsertest.cc does.
+class PageSplitSpaceDropB27Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    stedding::test::KeepAboveOtherWindows(widget());
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+  views::View* root() { return widget()->GetRootView(); }
+  int Index(tabs::TabInterface* tab) {
+    return tab_strip_model()->GetIndexOfTab(tab);
+  }
+
+  // A new foreground tab showing `host`, loaded.
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title1.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tab_strip_model()->GetActiveTab();
+  }
+
+  gfx::Point RowCentre(const tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    TabView* const row = stedding::test::FindDrawnRow(root(), tab);
+    CHECK(row);
+    return row->GetBoundsInScreen().CenterPoint();
+  }
+
+  // Whether a layer under `view` is animating: a Space's slide, or a fade.
+  static bool AnyLayerMoves(views::View* view) {
+    if (view->layer() && view->layer()->GetAnimator()->is_animating()) {
+      return true;
+    }
+    return std::ranges::any_of(view->children(), [](views::View* child) {
+      return AnyLayerMoves(child);
+    });
+  }
+
+  // Waits for a Space switch to come to rest: its slide ended and the rows
+  // still.
+  [[nodiscard]] bool WaitForTheSwitchToSettle() {
+    return base::test::RunUntil([&]() { return !AnyLayerMoves(root()); }) &&
+           stedding::test::WaitForRowsToSettle(widget());
+  }
+
+  // Whether the rows of `tabs` are drawn whole, none scrolled out of the list.
+  bool ShownWhole(std::initializer_list<const tabs::TabInterface*> tabs) {
+    if (!WaitForTheSwitchToSettle()) {
+      return false;
+    }
+    for (const tabs::TabInterface* const tab : tabs) {
+      TabView* const row = stedding::test::FindDrawnRow(root(), tab);
+      if (!row || row->GetVisibleBounds() != row->GetLocalBounds()) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // The centre of `id`'s chip, where a drag rests on it.
+  std::optional<gfx::Point> ChipCentre(const spaces::SpaceId& id) {
+    views::test::RunScheduledLayout(widget());
+    spaces::SpaceSwitcherView* const switcher =
+        stedding::test::FindDrawnSwitcher(root());
+    views::View* const chip = switcher ? switcher->ChipForTesting(id) : nullptr;
+    if (!chip || !chip->IsDrawn()) {
+      return std::nullopt;
+    }
+    const gfx::Point centre = chip->GetBoundsInScreen().CenterPoint();
+    if (switcher->SpaceAtScreenPoint(centre) != id) {
+      return std::nullopt;
+    }
+    return centre;
+  }
+
+  // Twelve even moves from `from` to `to` with the button down, then the
+  // tasks they left.
+  void MoveHeld(const gfx::Point& from, const gfx::Point& to) {
+    for (int step = 1; step <= 12; ++step) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * step / 12,
+                     from.y() + (to.y() - from.y()) * step / 12));
+    }
+    base::RunLoop().RunUntilIdle();
+  }
+
+  // The press at `from` and the moves to `to`, the button left down.
+  void PressAndMove(const gfx::Point& from, const gfx::Point& to) {
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, from);
+    MoveHeld(from, to);
+  }
+
+  // The release at `to`.
+  void Release(const gfx::Point& to) {
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, to);
+    base::RunLoop().RunUntilIdle();
+  }
+};
+
+// P36-1c, splits J13, spaces B12: a row dragged onto another Space's chip
+// and held there is filed in that Space, which comes on screen. Dragged on
+// over the page, it lights no half and makes no split with the page that
+// was on screen when the drag began, which is in the Space left behind: the
+// window stays on the Space the row went to. The page was shown again, which
+// took the window back to the Space left, the row hidden there, and the drop
+// made one split of two pages in two Spaces.
+IN_PROC_BROWSER_TEST_F(PageSplitSpaceDropB27Test,
+                       ARowFiledInAnotherSpaceMakesNoSplitWithThePageLeft) {
+  const base::AutoReset<base::TimeDelta> rest =
+      spaces::SpaceDragTarget::SetHoverSwitchDelayForTesting(
+          base::Milliseconds(50));
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const spaces::SpaceId home = m->active_id();
+  tabs::TabInterface* const dragged = Open("dragged-b27.test");
+  tabs::TabInterface* const page = Open("page-b27.test");
+  const spaces::SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+  ASSERT_TRUE(m->SetActiveSpace(work));
+  Open("work-b27.test");
+  ASSERT_TRUE(m->SetActiveSpace(home));
+  tab_strip_model()->ActivateTabAt(Index(page));
+  ASSERT_EQ(home, m->SpaceForTab(page));
+  ASSERT_EQ(home, m->SpaceForTab(dragged));
+  ASSERT_TRUE(ShownWhole({dragged, page}))
+      << "the window is too short for the test's rows";
+  spaces::PageSplitDragTarget* const target =
+      spaces::PageSplitDragTarget::From(browser());
+  ASSERT_TRUE(target);
+  const std::optional<gfx::Point> chip = ChipCentre(work);
+  ASSERT_TRUE(chip);
+
+  PressAndMove(RowCentre(dragged), *chip);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return m->active_id() == work; }))
+      << "a rest on Work's chip did not switch to Work";
+  ASSERT_EQ(work, m->SpaceForTab(dragged));
+  ASSERT_TRUE(WaitForTheSwitchToSettle());
+  {
+    // No rest on the way switches again.
+    const base::AutoReset<base::TimeDelta> no_rest =
+        spaces::SpaceDragTarget::SetHoverSwitchDelayForTesting(base::Hours(1));
+    const gfx::Rect bounds =
+        browser_view()->multi_contents_view()->GetBoundsInScreen();
+    const gfx::Point start_half(bounds.x() + bounds.width() / 4,
+                                bounds.CenterPoint().y());
+    MoveHeld(*chip, start_half);
+    EXPECT_EQ(std::nullopt, target->lit_side())
+        << "a half lit for a page of the Space left behind";
+    EXPECT_EQ(work, m->active_id())
+        << "the drag over the page took the window back to Home";
+    EXPECT_EQ(dragged, tab_strip_model()->GetActiveTab())
+        << "the page of the Space left behind came on screen";
+    Release(start_half);
+  }
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(dragged->IsSplit()) << "the drop paired pages of two Spaces";
+  EXPECT_FALSE(page->IsSplit());
+  EXPECT_EQ(work, m->active_id());
+  EXPECT_EQ(work, m->SpaceForTab(dragged));
+  EXPECT_EQ(home, m->SpaceForTab(page));
+  EXPECT_EQ(1u, GetAllBrowserWindowInterfaces().size()) << "a window tore off";
+}
