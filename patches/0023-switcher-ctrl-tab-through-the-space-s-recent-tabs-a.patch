+// Stedding switcher X4: Option-Shift-Cmd-Down / Up move the row among the
+// rows the user sees -- a folder beside it is one row to jump, and a row
+// inside a folder stays inside it.
+TEST_F(TabStripModelTest, MoveTabRelativeStaysInsideItsFolder) {
+  ASSERT_NO_FATAL_FAILURE(
+      PrepareTabstripForSelectionTest(tabstrip(), 4, 0, {0}));
+  tabs::TabInterface* const a = tabstrip()->GetTabAtIndex(0);
+  tabs::TabInterface* const b = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const c = tabstrip()->GetTabAtIndex(2);
+  tabs::TabInterface* const d = tabstrip()->GetTabAtIndex(3);
+  tabs::FolderTabCollection* const folder = tabstrip()->AddToNewFolder({1, 2});
+  ASSERT_NE(nullptr, folder);
+  const auto activate = [&](tabs::TabInterface* tab) {
+    tabstrip()->ActivateTabAt(
+        tabstrip()->GetIndexOfTab(tab),
+        TabStripUserGestureDetails(
+            TabStripUserGestureDetails::GestureType::kOther));
+  };
+
+  // Inside the folder: c is its last row, so down is a no-op; b moves under c
+  // and both stay in the folder.
+  activate(c);
+  tabstrip()->MoveTabNext();
+  EXPECT_EQ(2, tabstrip()->GetIndexOfTab(c));
+  EXPECT_EQ(folder, c->GetParentCollection());
+  activate(b);
+  tabstrip()->MoveTabNext();
+  EXPECT_EQ(2, tabstrip()->GetIndexOfTab(b));
+  EXPECT_EQ(1, tabstrip()->GetIndexOfTab(c));
+  EXPECT_EQ(folder, b->GetParentCollection());
+  EXPECT_EQ(2u, folder->TabCountRecursive());
+  tabstrip()->MoveTabPrevious();
+  EXPECT_EQ(1, tabstrip()->GetIndexOfTab(b));
+  EXPECT_EQ(folder, b->GetParentCollection());
+
+  // Beside the folder: a jumps over it as one row and comes back; d jumps up
+  // over it too. The folder never gains or loses a tab.
+  activate(a);
+  tabstrip()->MoveTabNext();
+  EXPECT_EQ(2, tabstrip()->GetIndexOfTab(a));
+  EXPECT_NE(folder, a->GetParentCollection());
+  EXPECT_EQ(3, tabstrip()->GetIndexOfTab(d));
+  tabstrip()->MoveTabPrevious();
+  EXPECT_EQ(0, tabstrip()->GetIndexOfTab(a));
+  activate(d);
+  tabstrip()->MoveTabPrevious();
+  EXPECT_EQ(1, tabstrip()->GetIndexOfTab(d));
+  EXPECT_NE(folder, d->GetParentCollection());
+  EXPECT_EQ(2u, folder->TabCountRecursive());
+  EXPECT_EQ(4, tabstrip()->count());
+}
