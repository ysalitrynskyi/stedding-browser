+
+// The registry's entry for `space`, kept by its id.
+RegistryEntry RegistryEntryFor(const Space& space) {
+  RegistryEntry entry(space.id(), space.name(), space.color());
+  entry.icon = space.icon();
+  entry.color_chosen = space.color_chosen();
+  entry.pins_collapsed = space.pins_collapsed();
+  return entry;
