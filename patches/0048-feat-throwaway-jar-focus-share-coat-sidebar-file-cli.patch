@@ -0,0 +1,41 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/clipboard_fence.h"
+
+#include "base/no_destructor.h"
+
+namespace spaces {
+namespace {
+
+std::string& LastCopiedJar() {
+  static base::NoDestructor<std::string> jar;
+  return *jar;
+}
+
+bool& HasCopy() {
+  static bool has = false;
+  return has;
+}
+
+}  // namespace
+
+void RecordCopyFromJar(std::string_view profile_id) {
+  LastCopiedJar() = std::string(profile_id);
+  HasCopy() = true;
+}
+
+bool PasteNeedsConfirm(std::string_view dest_profile_id) {
+  if (dest_profile_id.empty() || !HasCopy()) {
+    return false;
+  }
+  return LastCopiedJar() != dest_profile_id;
+}
+
+void ResetClipboardFenceForTesting() {
+  LastCopiedJar().clear();
+  HasCopy() = false;
+}
+
+}  // namespace spaces
