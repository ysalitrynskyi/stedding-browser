diff --git a/chrome/browser/ui/views/peek/peek_navigation_throttle.cc b/chrome/browser/ui/views/peek/peek_navigation_throttle.cc
new file mode 100644
index 0000000000000..633aeeabbb0ed
--- /dev/null
+++ b/chrome/browser/ui/views/peek/peek_navigation_throttle.cc
@@ -0,0 +1,128 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/peek/peek_navigation_throttle.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/views/peek/peek_view.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+PeekNavigationThrottle::Opener& OpenerOverride() {
+  static base::NoDestructor<PeekNavigationThrottle::Opener> opener;
+  return *opener;
+}
+
+void OpenPeek(base::WeakPtr<tabs::TabInterface> source, const GURL& url) {
+  if (!source) {
+    return;
+  }
+  if (OpenerOverride()) {
+    OpenerOverride().Run(source.get(), url);
+    return;
+  }
+  PeekView::Show(source.get(), url);
+}
+
+bool IsPinnedAnywhere(tabs::TabInterface* tab) {
+  if (tab->IsPinned()) {
+    return true;
+  }
+  spaces::SpaceModel* const spaces =
+      spaces::SpaceModel::From(tab->GetBrowserWindowInterface());
+  return spaces && spaces->IsSpacePinned(tab);
+}
+
+}  // namespace
+
+bool ShouldPeek(const PeekSignals& signals, const GURL& from, const GURL& to) {
+  if (!signals.tab_is_pinned || !signals.renderer_initiated ||
+      !signals.link_click || signals.is_post) {
+    return false;
+  }
+  if (!from.SchemeIsHTTPOrHTTPS() || !to.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  return !net::registry_controlled_domains::SameDomainOrHost(
+      from, to,
+      net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+}
+
+// static
+void PeekNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  if (!handle.IsInPrimaryMainFrame() || !handle.IsRendererInitiated()) {
+    return;
+  }
+  tabs::TabInterface* const tab =
+      tabs::TabInterface::MaybeGetFromContents(handle.GetWebContents());
+  if (!tab) {
+    return;
+  }
+  BrowserWindowInterface* const browser = tab->GetBrowserWindowInterface();
+  if (!browser || browser->GetType() != BrowserWindowInterface::TYPE_NORMAL) {
+    return;
+  }
+  if (!IsPinnedAnywhere(tab)) {
+    return;
+  }
+  registry.AddThrottle(std::make_unique<PeekNavigationThrottle>(registry));
+}
+
+// static
+void PeekNavigationThrottle::SetOpenerForTesting(Opener opener) {
+  OpenerOverride() = std::move(opener);
+}
+
+PeekNavigationThrottle::PeekNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+PeekNavigationThrottle::~PeekNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+PeekNavigationThrottle::WillStartRequest() {
+  content::NavigationHandle* const handle = navigation_handle();
+  tabs::TabInterface* const tab =
+      tabs::TabInterface::MaybeGetFromContents(handle->GetWebContents());
+  if (!tab) {
+    return PROCEED;
+  }
+  PeekSignals signals;
+  signals.tab_is_pinned = IsPinnedAnywhere(tab);
+  signals.renderer_initiated = handle->IsRendererInitiated();
+  signals.link_click = handle->WasInitiatedByLinkClick();
+  signals.is_post = handle->IsPost();
+  const GURL& from = handle->GetWebContents()->GetLastCommittedURL();
+  if (!ShouldPeek(signals, from, handle->GetURL())) {
+    return PROCEED;
+  }
+  // Not from inside the throttle check: opening a view while the navigation
+  // is being torn down is asking for re-entrancy.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&OpenPeek, tab->GetWeakPtr(), handle->GetURL()));
+  return CANCEL_AND_IGNORE;
+}
+
+const char* PeekNavigationThrottle::GetNameForLogging() {
+  return "SteddingPeekNavigationThrottle";
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/views/peek/peek_navigation_throttle.h b/chrome/browser/ui/views/peek/peek_navigation_throttle.h
new file mode 100644
index 0000000000000..44e168c5ce370
--- /dev/null
+++ b/chrome/browser/ui/views/peek/peek_navigation_throttle.h
@@ -0,0 +1,73 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_NAVIGATION_THROTTLE_H_
+
+#include "base/functional/callback.h"
+#include "content/public/browser/navigation_throttle.h"
+
+class GURL;
+
+namespace content {
+class NavigationThrottleRegistry;
+}
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace stedding {
+
+// What the throttle knows about a navigation when it decides. Kept as plain
+// data so the decision is a pure function a test can drive without a
+// navigation.
+struct PeekSignals {
+  // The tab is pinned: Chromium-pinned (the essentials row) or pinned within
+  // its Space.
+  bool tab_is_pinned = false;
+  // The page asked for the navigation (a link, a script), not the user through
+  // the omnibox or a bookmark.
+  bool renderer_initiated = false;
+  // The navigation came from the user clicking a link, as opposed to a script
+  // redirect: sign-in flows bounce through other sites by script and must not
+  // be caught.
+  bool link_click = false;
+  bool is_post = false;
+};
+
+// True when a navigation with `signals` from `from` to `to` should open in a
+// peek instead of navigating the pinned tab away: a link click from a pinned
+// tab to a different site (eTLD+1), http(s) both sides.
+bool ShouldPeek(const PeekSignals& signals, const GURL& from, const GURL& to);
+
+// A pinned tab behaves like an app: a link that would leave its site opens a
+// peek over the window instead of replacing the pinned page
+// (docs/PRODUCT.md, "Peek"). This throttle is what enforces that. It is
+// registered for renderer-initiated main-frame navigations in pinned tabs
+// only, and cancels the ones ShouldPeek() says so, opening the peek instead.
+class PeekNavigationThrottle : public content::NavigationThrottle {
+ public:
+  // Opens a peek for `url` from `source`. The default opens PeekView.
+  using Opener =
+      base::RepeatingCallback<void(tabs::TabInterface* source, const GURL& url)>;
+
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  // Replaces the opener; an empty callback restores the default.
+  static void SetOpenerForTesting(Opener opener);
+
+  explicit PeekNavigationThrottle(content::NavigationThrottleRegistry& registry);
+  PeekNavigationThrottle(const PeekNavigationThrottle&) = delete;
+  PeekNavigationThrottle& operator=(const PeekNavigationThrottle&) = delete;
+  ~PeekNavigationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  const char* GetNameForLogging() override;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_NAVIGATION_THROTTLE_H_
diff --git a/chrome/browser/ui/views/peek/peek_unittest.cc b/chrome/browser/ui/views/peek/peek_unittest.cc
new file mode 100644
index 0000000000000..0d0336458b5e0
--- /dev/null
+++ b/chrome/browser/ui/views/peek/peek_unittest.cc
@@ -0,0 +1,195 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/run_loop.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/peek/peek_navigation_throttle.h"
+#include "chrome/browser/ui/views/peek/peek_view.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_throttle.h"
+#include "content/public/test/navigation_simulator.h"
+#include "content/public/test/test_navigation_throttle_inserter.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+PeekSignals LinkClickFromPinnedTab() {
+  PeekSignals signals;
+  signals.tab_is_pinned = true;
+  signals.renderer_initiated = true;
+  signals.link_click = true;
+  return signals;
+}
+
+// P1: a link click from a pinned tab to another site peeks.
+TEST(ShouldPeekTest, LinkToAnotherSiteFromAPinnedTab) {
+  EXPECT_TRUE(ShouldPeek(LinkClickFromPinnedTab(),
+                         GURL("https://mail.example.com/inbox"),
+                         GURL("https://example.org/article")));
+}
+
+// P2: staying on the pinned site never peeks: other paths, subdomains, http
+// to https.
+TEST(ShouldPeekTest, StayingOnTheSiteNavigatesTheTab) {
+  const PeekSignals signals = LinkClickFromPinnedTab();
+  EXPECT_FALSE(ShouldPeek(signals, GURL("https://mail.example.com/inbox"),
+                          GURL("https://mail.example.com/settings")));
+  EXPECT_FALSE(ShouldPeek(signals, GURL("https://mail.example.com/"),
+                          GURL("https://docs.example.com/")));
+  EXPECT_FALSE(ShouldPeek(signals, GURL("http://example.com/"),
+                          GURL("https://example.com/")));
+}
+
+// P3: only pinned tabs peek; an ordinary tab follows the link.
+TEST(ShouldPeekTest, UnpinnedTabsFollowLinks) {
+  PeekSignals signals = LinkClickFromPinnedTab();
+  signals.tab_is_pinned = false;
+  EXPECT_FALSE(ShouldPeek(signals, GURL("https://example.com/"),
+                          GURL("https://example.org/")));
+}
+
+// P4: what the user asks for through the omnibox, and what scripts do
+// (sign-in bounces, form posts), navigates the pinned tab.
+TEST(ShouldPeekTest, TypedUrlsScriptRedirectsAndPostsNavigateTheTab) {
+  PeekSignals typed = LinkClickFromPinnedTab();
+  typed.renderer_initiated = false;
+  typed.link_click = false;
+  EXPECT_FALSE(ShouldPeek(typed, GURL("https://example.com/"),
+                          GURL("https://example.org/")));
+
+  PeekSignals script = LinkClickFromPinnedTab();
+  script.link_click = false;
+  EXPECT_FALSE(ShouldPeek(script, GURL("https://example.com/"),
+                          GURL("https://accounts.example.net/signin")));
+
+  PeekSignals post = LinkClickFromPinnedTab();
+  post.is_post = true;
+  EXPECT_FALSE(ShouldPeek(post, GURL("https://example.com/"),
+                          GURL("https://pay.example.org/")));
+}
+
+// P5: only web pages peek; chrome://, file: and blank pages do not.
+TEST(ShouldPeekTest, OnlyHttpPagesPeek) {
+  const PeekSignals signals = LinkClickFromPinnedTab();
+  EXPECT_FALSE(ShouldPeek(signals, GURL("chrome://newtab/"),
+                          GURL("https://example.org/")));
+  EXPECT_FALSE(ShouldPeek(signals, GURL("https://example.com/"),
+                          GURL("chrome://settings/")));
+  EXPECT_FALSE(ShouldPeek(signals, GURL(), GURL("https://example.org/")));
+}
+
+class PeekThrottleTest : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  spaces::SpaceModel& spaces() { return *spaces::SpaceModel::From(browser()); }
+
+  // Registers the throttle the way the browser client does, for every
+  // navigation in `contents`.
+  std::unique_ptr<content::TestNavigationThrottleInserter> Insert(
+      content::WebContents* contents) {
+    return std::make_unique<content::TestNavigationThrottleInserter>(
+        contents, base::BindRepeating(&PeekNavigationThrottle::MaybeCreateAndAdd));
+  }
+
+  // Simulates a renderer-initiated navigation and returns the throttles'
+  // verdict.
+  content::NavigationThrottle::ThrottleCheckResult Navigate(
+      content::WebContents* contents,
+      const GURL& to) {
+    auto simulator = content::NavigationSimulator::CreateRendererInitiated(
+        to, contents->GetPrimaryMainFrame());
+    simulator->SetTransition(ui::PAGE_TRANSITION_LINK);
+    simulator->SetHasUserGesture(true);
+    simulator->Start();
+    return simulator->GetLastThrottleCheckResult();
+  }
+};
+
+// P3 at the throttle: an unpinned tab gets no throttle and the navigation
+// proceeds untouched.
+TEST_F(PeekThrottleTest, UnpinnedTabIsNotThrottled) {
+  AddTab(browser(), GURL("https://example.com/"));
+  content::WebContents* const contents = tabs().GetActiveWebContents();
+  auto inserter = Insert(contents);
+  EXPECT_EQ(content::NavigationThrottle::PROCEED,
+            Navigate(contents, GURL("https://example.org/")).action());
+}
+
+// P2 at the throttle: a pinned tab's navigation within its site proceeds,
+// and the peek opener is never asked.
+TEST_F(PeekThrottleTest, PinnedTabStaysOnItsSite) {
+  AddTab(browser(), GURL("https://example.com/"));
+  tabs().SetTabPinned(0, true);
+  content::WebContents* const contents = tabs().GetActiveWebContents();
+  auto inserter = Insert(contents);
+  int opened = 0;
+  PeekNavigationThrottle::SetOpenerForTesting(base::BindRepeating(
+      [](int* opened, tabs::TabInterface*, const GURL&) { ++*opened; },
+      &opened));
+  EXPECT_EQ(content::NavigationThrottle::PROCEED,
+            Navigate(contents, GURL("https://example.com/page")).action());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, opened);
+  PeekNavigationThrottle::SetOpenerForTesting({});
+}
+
+// P4 at the throttle: the simulator cannot mark a navigation as a link click,
+// so a renderer-initiated cross-site navigation in a pinned tab is treated
+// as a script redirect and proceeds. (The link-click path is P1 plus the live
+// check in docs/features/peek.md.)
+TEST_F(PeekThrottleTest, ScriptRedirectFromPinnedTabProceeds) {
+  AddTab(browser(), GURL("https://example.com/"));
+  tabs().SetTabPinned(0, true);
+  content::WebContents* const contents = tabs().GetActiveWebContents();
+  auto inserter = Insert(contents);
+  EXPECT_EQ(content::NavigationThrottle::PROCEED,
+            Navigate(contents, GURL("https://example.org/")).action());
+}
+
+class PeekViewTest : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+};
+
+// P6: a peek owns a page of its own, loading the URL it was given, and the
+// window's tabs are untouched.
+TEST_F(PeekViewTest, PeekLoadsItsOwnPage) {
+  AddTab(browser(), GURL("https://example.com/"));
+  // Not shown in a window; the model half needs no widget.
+  auto peek = std::make_unique<PeekView>(browser());
+  peek->Load(GURL("https://example.org/article"));
+  ASSERT_TRUE(peek->web_contents());
+  EXPECT_EQ(GURL("https://example.org/article"),
+            peek->web_contents()->GetVisibleURL());
+  EXPECT_EQ(1, tabs().count());
+  EXPECT_EQ(GURL("https://example.com/"),
+            tabs().GetActiveWebContents()->GetLastCommittedURL());
+}
+
+// P7: promoting moves the very same page into a new active tab; the peek is
+// left with nothing.
+TEST_F(PeekViewTest, PromotingMovesThePageIntoANewActiveTab) {
+  AddTab(browser(), GURL("https://example.com/"));
+  auto peek = std::make_unique<PeekView>(browser());
+  peek->Load(GURL("https://example.org/article"));
+  content::WebContents* const page = peek->web_contents();
+
+  peek->PromoteToTab();
+
+  EXPECT_EQ(nullptr, peek->web_contents());
+  ASSERT_EQ(2, tabs().count());
+  EXPECT_EQ(page, tabs().GetActiveWebContents());
+  EXPECT_EQ(GURL("https://example.org/article"), page->GetVisibleURL());
+}
+
+}  // namespace
+}  // namespace stedding
