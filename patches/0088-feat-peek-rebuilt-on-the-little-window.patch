diff --git a/chrome/test/stedding/peek_browsertest.cc b/chrome/test/stedding/peek_browsertest.cc
new file mode 100644
index 0000000000000..accba78c8784e
--- /dev/null
+++ b/chrome/test/stedding/peek_browsertest.cc
@@ -0,0 +1,420 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/peek.md: a link that leaves a pinned tab's site opens in a
+// peek, a little window over the window, and the pinned tab stays.
+
+#include "chrome/browser/ui/stedding/peek.h"
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/run_loop.h"
+#include "base/strings/stringprintf.h"
+#include "base/synchronization/lock.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/test/run_until.h"
+#include "base/thread_annotations.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_active_state_manager/browser_active_state_manager.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/stedding/little_window.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/interaction/browser_elements_views.h"
+#include "chrome/browser/ui/views/toolbar/stedding_little_promote_button.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/test_navigation_observer.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "ui/base/base_window.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace {
+
+class PeekTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    // HTTPS: a page sends its Sec-Fetch- headers to secure sites alone.
+    embedded_https_test_server().SetSSLConfig(
+        net::EmbeddedTestServer::CERT_TEST_NAMES);
+    embedded_https_test_server().RegisterRequestMonitor(
+        base::BindRepeating(&PeekTest::OnRequest, base::Unretained(this)));
+    ASSERT_TRUE(embedded_https_test_server().Start());
+    // Peek is off on a fresh profile (P10); these are a user's who turned
+    // it on.
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kPeekEnabled, true);
+  }
+
+  // The server's thread: what the peeked page asked with.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    if (request.GetURL().path() != "/title3.html") {
+      return;
+    }
+    base::AutoLock lock(lock_);
+    const auto site = request.headers.find("Sec-Fetch-Site");
+    fetch_site_ = site == request.headers.end() ? "" : site->second;
+    const auto referrer = request.headers.find("Referer");
+    referrer_ = referrer == request.headers.end() ? "" : referrer->second;
+  }
+
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  content::WebContents* contents() { return tabs().GetActiveWebContents(); }
+  tabs::TabInterface* tab() { return tabs().GetActiveTab(); }
+
+  GURL Url(const std::string& host, const std::string& path) {
+    return embedded_https_test_server().GetURL(host, path);
+  }
+
+  // The pinned page at a.test, in a tab of its own, with one link, to `to`,
+  // as `target`; an essential, or with `in_space` pinned in its Space.
+  void OpenPin(const GURL& to,
+               const std::string& target = "",
+               bool in_space = false) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("a.test", "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    ASSERT_TRUE(content::ExecJs(
+        contents(),
+        base::StringPrintf(
+            "const a = document.createElement('a');"
+            "a.id = 'link'; a.href = '%s'; a.target = '%s';"
+            "a.textContent = 'the link';"
+            "a.style = 'display:block;font-size:40px;padding:20px';"
+            "document.body.prepend(a);",
+            to.spec().c_str(), target.c_str()),
+        // No activation from the setup itself: the clicks below say whose
+        // gesture they are.
+        content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    if (in_space) {
+      spaces::SpaceModel::From(browser())->SetSpacePinned(tab(), true);
+    } else {
+      tabs().SetTabPinned(tabs().active_index(), true);
+    }
+    ASSERT_EQ(Url("a.test", "/title1.html"), contents()->GetLastCommittedURL());
+  }
+
+  // The user's click on the link: the link's click with the user's
+  // activation, as a page sees a real one. A synthetic mouse event never
+  // reached a page that Windows' occlusion tracker counted as covered, beside
+  // other tests' windows.
+  void ClickLink() {
+    EXPECT_TRUE(content::ExecJs(contents(),
+                                "document.getElementById('link').click();"));
+  }
+
+  // The peek over the window, once its page has loaded.
+  BrowserWindowInterface* WaitForPeek() {
+    if (!base::test::RunUntil(
+            [&]() { return stedding::PeekOver(browser()) != nullptr; })) {
+      int windows = 0;
+      ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+          [&](BrowserWindowInterface*) {
+            ++windows;
+            return true;
+          });
+      ADD_FAILURE() << "no peek: the pin is at "
+                    << contents()->GetLastCommittedURL() << ", " << windows
+                    << " windows, the pin's window "
+                    << (browser()->IsActive() ? "active" : "inactive");
+      return nullptr;
+    }
+    BrowserWindowInterface* const peek = stedding::PeekOver(browser());
+    content::WebContents* const page =
+        peek->GetTabStripModel()->GetActiveWebContents();
+    return page && content::WaitForLoadStop(page) ? peek : nullptr;
+  }
+
+  // A click that leaves the page where it is: the pin's navigation is
+  // caught, or a script's click is not the user's. The watch starts before
+  // the click, whose navigation starts while its script runs.
+  void ClickLinkAndWaitForItsNavigation() {
+    content::TestNavigationObserver observer(
+        contents(), 1, content::MessageLoopRunner::QuitMode::IMMEDIATE,
+        /*ignore_uncommitted_navigations=*/false);
+    ClickLink();
+    observer.WaitForNavigationFinished();
+  }
+
+  static stedding::LittlePromoteButton* ButtonOf(
+      BrowserWindowInterface* window,
+      ui::ElementIdentifier id) {
+    BrowserElementsViews* const elements = BrowserElementsViews::From(window);
+    return elements ? elements->GetViewAs<stedding::LittlePromoteButton>(id)
+                    : nullptr;
+  }
+
+  base::Lock lock_;
+  std::string fetch_site_ GUARDED_BY(lock_);
+  std::string referrer_ GUARDED_BY(lock_);
+};
+
+// P1, P6, P11, P12, P13: the link opens in a peek over the window, a whole
+// page in a window of its own, loaded as the page's link -- cross-site, with
+// its referrer -- and the pinned tab stays where it was. The next link
+// replaces it.
+IN_PROC_BROWSER_TEST_F(PeekTest, ALinkLeavingThePinOpensAPeekOverTheWindow) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(OpenPin(to));
+  tabs::TabInterface* const pin = tab();
+  const int count = tabs().count();
+  ClickLink();
+  BrowserWindowInterface* const peek = WaitForPeek();
+  ASSERT_TRUE(peek) << "no peek opened";
+
+  EXPECT_TRUE(stedding::IsLittleWindow(peek));
+  EXPECT_TRUE(stedding::IsPeekWindow(peek));
+  EXPECT_EQ(pin, stedding::PeekSourceOf(peek));
+  content::WebContents* const page =
+      peek->GetTabStripModel()->GetActiveWebContents();
+  EXPECT_EQ(to, page->GetLastCommittedURL());
+  ASSERT_TRUE(page->GetRenderWidgetHostView());
+  EXPECT_GT(page->GetRenderWidgetHostView()->GetViewBounds().height(), 0)
+      << "the page is laid out 0 px tall (CMD-9)";
+  EXPECT_EQ(count, tabs().count());
+  EXPECT_EQ(Url("a.test", "/title1.html"), contents()->GetLastCommittedURL());
+  EXPECT_TRUE(browser()->GetWindow()->GetBounds().Contains(
+      peek->GetWindow()->GetBounds()))
+      << "the peek is not over its window";
+  {
+    base::AutoLock lock(lock_);
+    EXPECT_EQ("cross-site", fetch_site_);
+    EXPECT_NE(std::string::npos, referrer_.find("a.test")) << referrer_;
+  }
+  // An essential cannot take a split; its peek offers Open as Tab alone.
+  stedding::LittlePromoteButton* const as_tab =
+      ButtonOf(peek, stedding::LittlePromoteButton::kElementId);
+  ASSERT_TRUE(as_tab);
+  EXPECT_TRUE(as_tab->GetVisible());
+  EXPECT_EQ(stedding::PeekOpenAsTabLabel(), as_tab->GetText());
+  stedding::LittlePromoteButton* const split =
+      ButtonOf(peek, stedding::LittlePromoteButton::kSplitElementId);
+  ASSERT_TRUE(split);
+  EXPECT_FALSE(split->GetVisible());
+
+  // P13: the link again, with the peek still up, replaces it.
+  ClickLink();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    int peeks = 0;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* window) {
+          peeks += stedding::IsPeekWindow(window) ? 1 : 0;
+          return true;
+        });
+    BrowserWindowInterface* const now = stedding::PeekOver(browser());
+    return peeks == 1 && now && now != peek;
+  })) << "not one peek, the new one";
+}
+
+// P2, P4, P11: a link on the pin's own site, or a script's click with no
+// gesture from the user, goes on in the pinned tab.
+IN_PROC_BROWSER_TEST_F(PeekTest, ASameSiteLinkOrAScriptsClickStaysInThePin) {
+  {
+    SCOPED_TRACE("the pin's own site");
+    const GURL to = Url("a.test", "/title2.html");
+    ASSERT_NO_FATAL_FAILURE(OpenPin(to));
+    content::TestNavigationObserver observer(contents());
+    ClickLink();
+    observer.Wait();
+    EXPECT_EQ(to, contents()->GetLastCommittedURL());
+  }
+  {
+    SCOPED_TRACE("a script's click");
+    const GURL to = Url("b.test", "/title2.html");
+    ASSERT_NO_FATAL_FAILURE(OpenPin(to));
+    content::TestNavigationObserver observer(contents());
+    ASSERT_TRUE(content::ExecJs(contents(),
+                                "document.getElementById('link').click();",
+                                content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    observer.Wait();
+    EXPECT_EQ(to, contents()->GetLastCommittedURL());
+  }
+  EXPECT_FALSE(stedding::PeekOver(browser()));
+}
+
+// P7: Open as Tab moves the very page into a tab of the window, without
+// loading it again, and the peek is gone.
+IN_PROC_BROWSER_TEST_F(PeekTest, OpenAsTabMovesThePageAsItIs) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(OpenPin(to));
+  const int count = tabs().count();
+  ClickLink();
+  BrowserWindowInterface* const peek = WaitForPeek();
+  ASSERT_TRUE(peek);
+  content::WebContents* const page =
+      peek->GetTabStripModel()->GetActiveWebContents();
+  const int entry = page->GetController().GetLastCommittedEntry()->GetUniqueID();
+
+  chrome::ExecuteCommand(peek, IDC_STEDDING_LITTLE_PROMOTE);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return stedding::PeekOver(browser()) == nullptr; }));
+  EXPECT_EQ(count + 1, tabs().count());
+  EXPECT_EQ(page, contents()) << "not the same page, or not the active tab";
+  EXPECT_EQ(entry, page->GetController().GetLastCommittedEntry()->GetUniqueID())
+      << "the page loaded again";
+  EXPECT_FALSE(stedding::IsPeekWindow(browser()));
+}
+
+// P9: from a tab pinned in its Space, Open in Split View puts the page in a
+// split beside it.
+IN_PROC_BROWSER_TEST_F(PeekTest, OpenInSplitViewPairsThePageWithItsPin) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(OpenPin(to, "", /*in_space=*/true));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  BrowserWindowInterface* const peek = WaitForPeek();
+  ASSERT_TRUE(peek);
+  EXPECT_TRUE(stedding::PeekCanSplit(peek));
+  stedding::LittlePromoteButton* const split =
+      ButtonOf(peek, stedding::LittlePromoteButton::kSplitElementId);
+  ASSERT_TRUE(split);
+  EXPECT_TRUE(split->GetVisible());
+  content::WebContents* const page =
+      peek->GetTabStripModel()->GetActiveWebContents();
+
+  chrome::ExecuteCommand(peek, IDC_STEDDING_LITTLE_PROMOTE_SPLIT);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return stedding::PeekOver(browser()) == nullptr; }));
+  tabs::TabInterface* const moved =
+      tabs::TabInterface::MaybeGetFromContents(page);
+  ASSERT_TRUE(moved);
+  EXPECT_EQ(browser(), moved->GetBrowserWindowInterface());
+  EXPECT_TRUE(moved->IsSplit());
+  EXPECT_TRUE(pin->IsSplit());
+  EXPECT_EQ(moved->GetSplit(), pin->GetSplit());
+}
+
+// P14: a click on the window closes the peek, and when the click was on
+// the very link, the link does not open it again.
+IN_PROC_BROWSER_TEST_F(PeekTest, AClickOnTheWindowClosesThePeek) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(OpenPin(to));
+  ClickLink();
+  ASSERT_TRUE(WaitForPeek());
+
+  // The press of a click activates the window before the link sees it; a
+  // click, not the window taking the activation back as the peek appears,
+  // which the peek lets pass for its first 750 ms.
+  {
+    base::RunLoop grace;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, grace.QuitClosure(), base::Seconds(1));
+    grace.Run();
+  }
+  BrowserActiveStateManager::From(browser())->DidBecomeActive();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return stedding::PeekOver(browser()) == nullptr; }))
+      << "the peek stayed";
+  ClickLinkAndWaitForItsNavigation();
+  content::RunAllTasksUntilIdle();
+  EXPECT_FALSE(stedding::PeekOver(browser())) << "the link opened it again";
+  EXPECT_EQ(Url("a.test", "/title1.html"), contents()->GetLastCommittedURL());
+
+  // Another click later is a new one.
+  ClickLink();
+  EXPECT_TRUE(WaitForPeek());
+}
+
+// private V6: a peek from a private window is private, and Open as Tab
+// keeps the page in that window.
+IN_PROC_BROWSER_TEST_F(PeekTest, APeekFromAPrivateWindowStaysPrivate) {
+  BrowserWindowInterface* const incognito =
+      CreateIncognitoBrowser(browser()->GetProfile());
+  ASSERT_TRUE(incognito);
+  incognito->GetProfile()->GetPrefs()->SetBoolean(stedding::prefs::kPeekEnabled,
+                                                  true);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(incognito, Url("a.test", "/title1.html")));
+  TabStripModel* const tabs = incognito->GetTabStripModel();
+  content::WebContents* const pin = tabs->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(
+      pin,
+      base::StringPrintf("const a = document.createElement('a');"
+                         "a.id = 'link'; a.href = '%s';"
+                         "a.textContent = 'the link';"
+                         "document.body.prepend(a);",
+                         Url("b.test", "/title3.html").spec().c_str()),
+      content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+  tabs->SetTabPinned(tabs->active_index(), true);
+  ASSERT_TRUE(
+      content::ExecJs(pin, "document.getElementById('link').click();"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return stedding::PeekOver(incognito) != nullptr; }))
+      << "no peek from the private window";
+  BrowserWindowInterface* const peek = stedding::PeekOver(incognito);
+  EXPECT_TRUE(peek->GetProfile()->IsOffTheRecord());
+  EXPECT_EQ(incognito->GetProfile(), peek->GetProfile());
+  content::WebContents* const page =
+      peek->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+
+  chrome::ExecuteCommand(peek, IDC_STEDDING_LITTLE_PROMOTE);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return stedding::PeekOver(incognito) == nullptr; }));
+  EXPECT_EQ(page, tabs->GetActiveWebContents())
+      << "the page left the private window";
+}
+
+// P8: a link that asks for a new tab peeks too, and no tab is added.
+IN_PROC_BROWSER_TEST_F(PeekTest, ALinkForANewTabPeeks) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(OpenPin(to, "_blank"));
+  const int count = tabs().count();
+  ClickLink();
+  BrowserWindowInterface* const peek = WaitForPeek();
+  ASSERT_TRUE(peek);
+  EXPECT_EQ(to, peek->GetTabStripModel()
+                    ->GetActiveWebContents()
+                    ->GetLastCommittedURL());
+  EXPECT_EQ(count, tabs().count());
+}
+
+// P11 (PLAN.md CMD-9): a pin in a Space with a session of its own peeks in
+// that session's jar.
+IN_PROC_BROWSER_TEST_F(PeekTest, APinInASpaceWithItsOwnJarPeeksInIt) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->SetSpaceIsolated(work, true);
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("a.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_EQ(work, model->FindSpaceForTab(tab()));
+  const content::StoragePartitionConfig jar =
+      spaces::StoragePartitionConfigForWebContents(contents());
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(jar));
+
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html"), "",
+                                  /*in_space=*/true));
+  ClickLink();
+  BrowserWindowInterface* const peek = WaitForPeek();
+  ASSERT_TRUE(peek);
+  EXPECT_EQ(jar, spaces::StoragePartitionConfigForWebContents(
+                     peek->GetTabStripModel()->GetActiveWebContents()))
+      << "the peek is not in the Space's jar";
+}
