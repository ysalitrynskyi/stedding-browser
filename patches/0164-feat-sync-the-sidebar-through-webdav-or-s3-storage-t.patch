+
+class GURL;
+
+namespace base {
+class Clock;
+}  // namespace base
+
+namespace net {
+struct RedirectInfo;
+}  // namespace net
+
+namespace network {
+class SharedURLLoaderFactory;
+namespace mojom {
+class URLResponseHead;
+}  // namespace mojom
+}  // namespace network
+
+namespace spaces::sidebar_sync {
+
+// docs/features/sidebar-file.md Sf47, Sf52, Sf54, Sf56: every request to a
+// place, through Chromium's network stack from the browser process. No
+// cookies, no referrer, no cache, and nothing a page, an extension or DevTools
+// sees. A response is cut off at its cap before it is read, a redirect that
+// leaves the host or drops encryption is refused, and a server's XML is parsed
+// in the sandboxed data decoder. The sign-in goes only to the address typed.
+// Lives on the UI thread.
+class PlaceClient {
+ public:
+  using Done = base::OnceCallback<void(PlaceFailure)>;
+  using HasFolderDone = base::OnceCallback<void(PlaceFailure, bool exists)>;
+  using ListDone = base::OnceCallback<void(PlaceFailure, PlaceList)>;
+  using ReadDone = base::OnceCallback<void(PlaceFailure, std::string body)>;
+  using WriteDone = base::OnceCallback<void(PlaceFailure, std::string version)>;
+
+  // Sf48: the test asks once more with no sign-in, to see what anyone sees.
+  enum class Sign { kYes, kNo };
+
+  PlaceClient(Place place,
+              PlaceSignIn sign_in,
+              scoped_refptr<network::SharedURLLoaderFactory> factory,
+              base::Clock* clock);
+  PlaceClient(const PlaceClient&) = delete;
+  PlaceClient& operator=(const PlaceClient&) = delete;
+  ~PlaceClient();
+
+  // Sf47: the sign-in works and the place is a WebDAV folder or an S3 bucket.
+  void CheckRoot(Done done);
+  // `Stedding Sidebar`. On S3 a prefix needs no making, so it is always there.
+  void HasFolder(HasFolderDone done);
+  void MakeFolder(Done done);
+  void List(Sign sign, ListDone done);
+  void Read(Sign sign, const std::string& name, ReadDone done);
+  void Write(const std::string& name, std::string body, WriteDone done);
+  // A file that is already gone counts as removed.
+  void Remove(const std::string& name, Done done);
+  // Sf49: only while `Stedding Sidebar` holds nothing. Nothing on S3.
+  void RemoveFolderIfEmpty(Done done);
+
+  // Sf47: the region a server named when it said this was the wrong one.
+  const std::string& named_region() const { return named_region_; }
+
+  static void SetTimeoutForTesting(base::TimeDelta timeout);
+
+ private:
+  struct Reply {
+    int net_error = 0;
+    int status = 0;
+    std::string body;
+    std::string etag;
+    std::string bucket_region;
+    bool basic_offered = true;
+    bool redirect_refused = false;
+
+    bool Succeeded() const;
+  };
+  using ReplyDone = base::OnceCallback<void(Reply)>;
+
+  struct Request {
+    Request();
+    Request(Request&& other);
+    ~Request();
+
+    std::string method;
+    GURL url;
+    std::string body;
+    std::string content_type;
+    std::vector<std::pair<std::string, std::string>> headers;
+    size_t cap = 0;
+    Sign sign = Sign::kYes;
+  };
+  struct Pending;
+
+  void Send(Request request, ReplyDone done);
+  void OnRedirect(Pending* pending,
+                  const GURL& url_before_redirect,
+                  const net::RedirectInfo& redirect_info,
+                  const network::mojom::URLResponseHead& response_head,
+                  std::vector<std::string>* removed_headers);
+  void OnBody(Pending* pending, std::optional<std::string> body);
+  void Finish(Pending* pending);
+
+  // Turns a reply that did not succeed into its failure.
+  void Classify(PlaceOp op, Reply reply, Done done);
+  void OnS3ErrorParsed(PlaceOp op,
+                       int status,
+                       Done done,
+                       data_decoder::DataDecoder::ValueOrError result);
+
+  void SendList(PlaceOp op, Sign sign, int max_keys, int depth, ListDone done);
+  void OnListReply(PlaceOp op, GURL folder, ListDone done, Reply reply);
+  void OnListParsed(GURL folder,
+                    ListDone done,
+                    data_decoder::DataDecoder::ValueOrError result);
+  void OnRootListed(Done done, PlaceFailure failure, PlaceList list);
+  void OnFolderReply(HasFolderDone done, Reply reply);
+  void OnMakeReply(Done done, Reply reply);
+  void OnReadReply(ReadDone done, Reply reply);
+  void OnWriteReply(WriteDone done, Reply reply);
+  void OnRemoveReply(PlaceOp op, Done done, Reply reply);
+  void OnFolderListed(Done done, PlaceFailure failure, PlaceList list);
+
+  GURL FileUrl(const std::string& name) const;
+
+  const Place place_;
+  const PlaceSignIn sign_in_;
+  const scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  const raw_ptr<base::Clock> clock_;
+  std::string named_region_;
+  std::list<std::unique_ptr<Pending>> pending_;
+  base::WeakPtrFactory<PlaceClient> weak_factory_{this};
+};
+
+// docs/features/sidebar-file.md Sf47, Sf48: **Test and continue**. In order,
+// stopping at the first step that fails: the sign-in and the kind of place;
+// `Stedding Sidebar`, made only when missing; a probe file written, read back
+// byte for byte, listed and deleted. Once the probe is up, what anyone can
+// read with no sign-in is checked before it goes. A failed test leaves no
+// probe, and removes a `Stedding Sidebar` it made.
+class PlaceCheck {
+ public:
+  struct Result {
+    PlaceFailure failure = PlaceFailure::kNone;
+    // Sf47: the right region, when the server named it.
+    std::string region;
+    // Sf49: the test made `Stedding Sidebar`.
+    bool made_folder = false;
+  };
+  using Done = base::OnceCallback<void(Result)>;
+
+  // `client` outlives this.
+  PlaceCheck(PlaceClient* client, Done done);
+  PlaceCheck(const PlaceCheck&) = delete;
+  PlaceCheck& operator=(const PlaceCheck&) = delete;
+  ~PlaceCheck();
+
+  void Start();
+
+ private:
+  void OnRoot(PlaceFailure failure);
+  void OnHasFolder(PlaceFailure failure, bool exists);
+  void OnFolderMade(PlaceFailure failure);
+  void WriteProbe();
+  void OnProbeWritten(PlaceFailure failure, std::string version);
+  void OnProbeRead(PlaceFailure failure, std::string body);
+  void OnListed(PlaceFailure failure, PlaceList list);
+  void OnListedByAnyone(PlaceFailure failure, PlaceList list);
+  void OnReadByAnyone(PlaceFailure failure, std::string body);
+  void RemoveProbe(PlaceFailure failure);
+  void OnProbeRemoved(PlaceFailure failure);
+  void Stop(PlaceFailure failure);
+  void OnCleanedUp(PlaceFailure failure);
+
+  const raw_ptr<PlaceClient> client_;
+  Done done_;
+  Result result_;
