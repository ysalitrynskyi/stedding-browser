@@ -0,0 +1,140 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Defaults a fresh profile must have, run the way a user meets them.
+//
+// Peek is off until it is rebuilt (PLAN.md CMD-4, owner decision 2): a
+// link that leaves a pinned tab's site navigates the tab, and no peek opens.
+//
+// "Close all windows", then Stay at a page's "Leave site?", leaves the
+// session service shut down under live windows; the Space and folder
+// bookkeeping fetched a service it had cached and wrote into freed memory
+// (PLAN.md TAB-7, SPC-2). After Stay, opening a tab, renaming and collapsing
+// a folder, switching Space, pinning a tab to the Space (⌘D) and moving a
+// tab to another Space must all go through.
+
+#include "base/test/run_until.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_window.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/javascript_dialogs/app_modal_dialog_controller.h"
+#include "components/javascript_dialogs/app_modal_dialog_view.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/test_navigation_observer.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+class DefaultsTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+};
+
+IN_PROC_BROWSER_TEST_F(DefaultsTest, ALinkFromAPinnedTabNavigatesIt) {
+  EXPECT_FALSE(browser()->GetProfile()->GetPrefs()->GetBoolean(
+      stedding::prefs::kPeekEnabled));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(),
+      embedded_test_server()->GetURL("pinned.test", "/title1.html")));
+  tabs()->SetTabPinned(0, true);
+  content::WebContents* const pinned = tabs()->GetWebContentsAt(0);
+  const GURL away = embedded_test_server()->GetURL("away.test", "/title2.html");
+  content::TestNavigationObserver navigated(pinned);
+  ASSERT_TRUE(content::ExecJs(
+      pinned, content::JsReplace("const a = document.createElement('a');"
+                                 "a.href = $1; document.body.appendChild(a);"
+                                 "a.click();",
+                                 away)));
+  navigated.Wait();
+  EXPECT_EQ(away, pinned->GetLastCommittedURL()) << "the tab went, no peek";
+  EXPECT_EQ(1, tabs()->count());
+}
+
+IN_PROC_BROWSER_TEST_F(DefaultsTest,
+                       StayingAfterCloseAllKeepsEverythingWorking) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("asks.test", "/title1.html")));
+  content::WebContents* const asking = tabs()->GetActiveWebContents();
+  tabs::TabInterface* const asking_tab = tabs()->GetActiveTab();
+  ASSERT_TRUE(content::ExecJs(
+      asking,
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+
+  content::PrepContentsForBeforeUnloadTest(asking);
+  profiles::CloseProfileWindows(browser()->GetProfile());
+  javascript_dialogs::AppModalDialogController* const dialog =
+      ui_test_utils::WaitForAppModalDialog();
+  ASSERT_TRUE(dialog);
+  dialog->view()->CancelAppModalDialog();  // Stay.
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(1, tabs()->count()) << "the window stayed";
+
+  // What the owner did next: a tab, a folder renamed and collapsed, a Space.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("next.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::FolderTabCollection* const folder = tabs()->AddToNewFolder({1});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("After Stay");
+  folder->SetCollapsed(true);
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  const spaces::SpaceId other = model->AddSpace("Other", SK_ColorBLUE)->id();
+  ASSERT_TRUE(model->SetActiveSpace(other));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("other.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const tab = tabs()->GetActiveTab();
+  ASSERT_EQ(other, model->SpaceForTab(tab));
+
+  ASSERT_TRUE(
+      chrome::IsCommandEnabled(browser(), IDC_STEDDING_TOGGLE_SPACE_PIN));
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_SPACE_PIN);  // ⌘D
+  EXPECT_TRUE(model->IsSpacePinned(tab));
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_SPACE_PIN);
+  EXPECT_FALSE(model->IsSpacePinned(tab));
+
+  ASSERT_TRUE(chrome::IsCommandEnabled(
+      browser(), IDC_STEDDING_MOVE_TAB_TO_PREVIOUS_SPACE));
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_MOVE_TAB_TO_PREVIOUS_SPACE);
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return model->SpaceForTab(tab) == home; }));
+  base::RunLoop().RunUntilIdle();
+
+  // The page that asks goes last, on screen and without its question.
+  ASSERT_TRUE(model->SetActiveSpace(home));
+  tabs()->ActivateTabAt(tabs()->GetIndexOfTab(asking_tab));
+  ASSERT_TRUE(content::ExecJs(
+      asking, "window.removeEventListener('beforeunload', window.stay);"));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/external_extensions_browsertest.cc b/chrome/test/stedding/external_extensions_browsertest.cc
new file mode 100644
index 0000000000000..166abb563ded8
--- /dev/null
+++ b/chrome/test/stedding/external_extensions_browsertest.cc
@@ -0,0 +1,123 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Extensions a vendor registered for Google Chrome are not Stedding's
+// (PLAN.md WEB-3, privacy Q9). On the Mac, Chrome's machine-wide folder,
+// /Library/Application Support/Google/Chrome/External Extensions, is not
+// read; Stedding's own per-user folder, under its user-data directory, is.
+// Each folder is given one extension, and the providers a profile gets are
+// asked what they find.
+
+#include <set>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/path_service.h"
+#include "base/test/run_until.h"
+#include "base/test/scoped_path_override.h"
+#include "base/threading/thread_restrictions.h"
+#include "build/build_config.h"
+#include "chrome/browser/extensions/external_provider_impl.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/common/chrome_paths.h"
+#include "chrome/common/chrome_switches.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/test/browser_test.h"
+#include "extensions/browser/external_install_info.h"
+#include "extensions/browser/external_provider_interface.h"
+
+namespace {
+
+// Two ids in the a-p alphabet extension ids use.
+constexpr char kChromesExtension[] = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+constexpr char kSteddingsExtension[] = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
+// The entry a vendor's installer writes: an id's file names an update URL.
+constexpr char kEntry[] =
+    R"({"external_update_url": "https://update.invalid/"})";
+
+// What the providers report, and how many of them have finished.
+class Visitor : public extensions::ExternalProviderInterface::VisitorInterface {
+ public:
+  bool OnExternalExtensionFileFound(
+      const extensions::ExternalInstallInfoFile& info) override {
+    found.insert(info.extension_id);
+    return true;
+  }
+  bool OnExternalExtensionUpdateUrlFound(
+      const extensions::ExternalInstallInfoUpdateUrl& info,
+      bool force_update) override {
+    found.insert(info.extension_id);
+    return true;
+  }
+  void OnExternalProviderReady(
+      const extensions::ExternalProviderInterface* provider) override {
+    ready.insert(provider);
+  }
+  void OnExternalProviderUpdateComplete(
+      const extensions::ExternalProviderInterface* provider,
+      const std::vector<extensions::ExternalInstallInfoUpdateUrl>&
+          update_url_extensions,
+      const std::vector<extensions::ExternalInstallInfoFile>& file_extensions,
+      const std::set<std::string>& removed_extensions) override {}
+
+  std::set<std::string> found;
+  std::set<const extensions::ExternalProviderInterface*> ready;
+};
+
+using ExternalExtensionsTest = InProcessBrowserTest;
+
+IN_PROC_BROWSER_TEST_F(ExternalExtensionsTest, ChromesFolderIsNotRead) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::ScopedTempDir chromes_folder;
+  ASSERT_TRUE(chromes_folder.CreateUniqueTempDir());
+  ASSERT_TRUE(base::WriteFile(chromes_folder.GetPath().AppendASCII(
+                                  std::string(kChromesExtension) + ".json"),
+                              kEntry));
+  // Wherever upstream would look for Chrome's folder, it finds this one.
+  base::ScopedPathOverride chromes_path(chrome::DIR_EXTERNAL_EXTENSIONS,
+                                        chromes_folder.GetPath());
+
+  base::FilePath own_folder;
+  ASSERT_TRUE(base::PathService::Get(chrome::DIR_USER_EXTERNAL_EXTENSIONS,
+                                     &own_folder));
+  base::FilePath user_data;
+  ASSERT_TRUE(base::PathService::Get(chrome::DIR_USER_DATA, &user_data));
+  ASSERT_TRUE(user_data.IsParent(own_folder))
+      << "Stedding's folder is its own, under its user-data directory";
+  ASSERT_TRUE(base::CreateDirectory(own_folder));
+  ASSERT_TRUE(base::WriteFile(
+      own_folder.AppendASCII(std::string(kSteddingsExtension) + ".json"),
+      kEntry));
+
+  // Tests start with the external providers off; a person's browser has
+  // them, so the list is made as it is for them.
+  base::CommandLine::ForCurrentProcess()->RemoveSwitch(
+      switches::kDisableDefaultApps);
+  Visitor visitor;
+  extensions::ProviderCollection providers;
+  extensions::ExternalProviderImpl::CreateExternalProviders(
+      &visitor, browser()->GetProfile(), &providers);
+  ASSERT_FALSE(providers.empty());
+  for (const auto& provider : providers) {
+    provider->VisitRegisteredExtension();
+  }
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return visitor.ready.size() == providers.size(); }));
+
+  EXPECT_TRUE(visitor.found.contains(kSteddingsExtension))
+      << "Stedding's own folder is read";
+#if BUILDFLAG(IS_MAC)
+  EXPECT_FALSE(visitor.found.contains(kChromesExtension))
+      << "Chrome's machine-wide folder is not";
+#endif
+  for (const auto& provider : providers) {
+    provider->ServiceShutdown();
+  }
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/folder_tabs_browsertest.cc b/chrome/test/stedding/folder_tabs_browsertest.cc
new file mode 100644
index 0000000000000..81260179109c2
--- /dev/null
+++ b/chrome/test/stedding/folder_tabs_browsertest.cc
@@ -0,0 +1,454 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Tabs that land next to a tab inside a folder (PLAN.md TST-5, TAB-6).
+//
+// A link opened in the background, a duplicate and a restored tab all insert
+// at an index strictly inside a folder. The tab collections used to CHECK on
+// such an index. Each case here runs the path a user takes, so a crash fails
+// the test.
+//
+// And what a folder does with its rows and its tabs: collapsed, it stays
+// collapsed whatever happens around it, and keeps the row of the tab on
+// screen (PLAN.md SPC-5, TAB-11, decision 6); Close Folder's Tabs closes
+// what the folder holds in this Space and wakes nothing (TAB-13).
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/run_loop.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/run_until.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/extensions/api/tabs/tabs_api.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/sleep_tabs.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/commandbar/command_bar_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/tabs/common/tab_view.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/common/referrer.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "extensions/browser/api_test_utils.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/extension_builder.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Counts the navigations its contents start until they are gone.
+class NavigationCounter : public content::WebContentsObserver {
+ public:
+  NavigationCounter(content::WebContents* contents, int* count)
+      : content::WebContentsObserver(contents), count_(count) {}
+
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    ++*count_;
+  }
+
+ private:
+  raw_ptr<int> count_;
+};
+
+class FolderTabsTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  views::Widget* widget() {
+    return BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  }
+
+  // The row of `tab` as drawn once the rows are in place, or null.
+  TabView* DrawnRow(tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    return stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+  }
+
+  // A tab at the end on a page of the test server, loaded. It loads on
+  // screen: a background tab's renderer runs at a low priority on the Mac.
+  tabs::TabInterface* OpenLoaded(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tab_strip_model()->GetActiveTab();
+  }
+
+  // Four tabs, the middle two in a folder.
+  tabs::FolderTabCollection* MakeFolder() {
+    AppendTab();
+    AppendTab();
+    AppendTab();
+    EXPECT_EQ(4, tab_strip_model()->count());
+    return tab_strip_model()->AddToNewFolder({1, 2});
+  }
+
+  const tabs::TabCollection* ParentOf(int index) {
+    return tab_strip_model()->GetTabAtIndex(index)->GetParentCollection();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ALinkFromAFolderTabOpensBesideIt) {
+  tabs::FolderTabCollection* const folder = MakeFolder();
+  ASSERT_TRUE(folder);
+  tab_strip_model()->ActivateTabAt(1);
+  content::WebContents* const opener = tab_strip_model()->GetWebContentsAt(1);
+
+  NavigateParams params(browser(), GURL("about:blank#child"),
+                        ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  params.source_contents = opener;
+  Navigate(&params);
+
+  ASSERT_EQ(5, tab_strip_model()->count());
+  const int child = tab_strip_model()->GetIndexOfWebContents(
+      params.navigated_or_inserted_contents);
+  EXPECT_EQ(2, child) << "right after its opener";
+  EXPECT_EQ(folder, ParentOf(child)) << "inside its opener's folder";
+  EXPECT_EQ(1, tab_strip_model()->active_index()) << "a background tab";
+}
+
+// folders F25: a link opened from a folder's last tab joins the folder too.
+// The slot right after it would otherwise belong to the folder's parent.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ALinkFromAFoldersLastTabJoinsIt) {
+  tabs::FolderTabCollection* const folder = MakeFolder();
+  ASSERT_TRUE(folder);
+  tab_strip_model()->ActivateTabAt(2);
+  content::WebContents* const opener = tab_strip_model()->GetWebContentsAt(2);
+
+  NavigateParams params(browser(), GURL("about:blank#child"),
+                        ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  params.source_contents = opener;
+  Navigate(&params);
+
+  ASSERT_EQ(5, tab_strip_model()->count());
+  const int child = tab_strip_model()->GetIndexOfWebContents(
+      params.navigated_or_inserted_contents);
+  EXPECT_EQ(3, child) << "right after its opener";
+  EXPECT_EQ(folder, ParentOf(child)) << "inside its opener's folder";
+  EXPECT_NE(folder, ParentOf(4)) << "the tab after the folder stays out";
+}
+
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, DuplicatingAFolderTabKeepsItInside) {
+  tabs::FolderTabCollection* const folder = MakeFolder();
+  ASSERT_TRUE(folder);
+
+  content::WebContents* const copy = chrome::DuplicateTabAt(browser(), 1);
+
+  ASSERT_TRUE(copy);
+  ASSERT_EQ(5, tab_strip_model()->count());
+  const int index = tab_strip_model()->GetIndexOfWebContents(copy);
+  EXPECT_EQ(2, index);
+  EXPECT_EQ(folder, ParentOf(index));
+}
+
+// Decision 6 (PLAN.md TAB-11): collapsing the folder that holds the tab on
+// screen keeps that tab, and its row under the header, highlighted; the
+// folder's other rows hide. Once another tab is on screen the folder shows
+// no row at all.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       CollapsingTheActiveTabsFolderKeepsItsRow) {
+  tabs::FolderTabCollection* const folder = MakeFolder();
+  ASSERT_TRUE(folder);
+  tab_strip_model()->ActivateTabAt(2);
+  tabs::TabInterface* const active = tab_strip_model()->GetTabAtIndex(2);
+  tabs::TabInterface* const sibling = tab_strip_model()->GetTabAtIndex(1);
+
+  folder->SetCollapsed(true);
+  EXPECT_EQ(active, tab_strip_model()->GetActiveTab()) << "no tab switch";
+  TabView* const row = DrawnRow(active);
+  ASSERT_TRUE(row) << "the tab on screen keeps its row under the header";
+  EXPECT_TRUE(row->IsActive());
+  EXPECT_FALSE(DrawnRow(sibling));
+  EXPECT_EQ(
+      active->GetContents(),
+      BrowserView::GetBrowserViewForBrowser(browser())->GetActiveWebContents());
+
+  tab_strip_model()->ActivateTabAt(0);
+  EXPECT_FALSE(DrawnRow(active)) << "the folder is fully collapsed now";
+  EXPECT_TRUE(folder->collapsed());
+}
+
+// PLAN.md SPC-5: a collapsed folder stays collapsed through ⌘T, a new tab, a
+// Space switch and back, and a moved tab.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ACollapsedFolderStaysCollapsed) {
+  tabs::FolderTabCollection* const folder = MakeFolder();
+  ASSERT_TRUE(folder);
+  tabs::TabInterface* const first = tab_strip_model()->GetTabAtIndex(1);
+  tabs::TabInterface* const second = tab_strip_model()->GetTabAtIndex(2);
+  tab_strip_model()->ActivateTabAt(3);
+  folder->SetCollapsed(true);
+  const auto expect_collapsed = [&](const char* after) {
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(folder->collapsed()) << after;
+    EXPECT_FALSE(DrawnRow(first)) << after;
+    EXPECT_FALSE(DrawnRow(second)) << after;
+  };
+  expect_collapsed("collapsing");
+
+  chrome::ExecuteCommand(browser(), IDC_NEW_TAB);  // ⌘T: the command bar.
+  stedding::CommandBarView* const bar = stedding::CommandBarView::GetOpenBar(
+      BrowserView::GetBrowserViewForBrowser(browser()));
+  ASSERT_TRUE(bar);
+  bar->Close();
+  expect_collapsed("the command bar");
+
+  chrome::NewTab(browser(), NewTabTypes::kNewTabCommand);
+  expect_collapsed("a new tab");
+
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  const spaces::SpaceId other = model->AddSpace("Other", SK_ColorBLUE)->id();
+  ASSERT_TRUE(model->SetActiveSpace(other));
+  ASSERT_TRUE(model->SetActiveSpace(home));
+  expect_collapsed("a Space switch and back");
+
+  tab_strip_model()->MoveWebContentsAt(0, tab_strip_model()->count() - 1,
+                                       /*select_after_move=*/false);
+  expect_collapsed("a moved tab");
+}
+
+// PLAN.md TAB-13: Close Folder's Tabs closes what the folder holds in this
+// Space. A folder tab moved to another Space stays open there.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       ClosingAFoldersTabsKeepsOneInAnotherSpace) {
+  tabs::FolderTabCollection* const folder = MakeFolder();
+  ASSERT_TRUE(folder);
+  tabs::TabInterface* const stays = tab_strip_model()->GetTabAtIndex(1);
+  tabs::TabInterface* const moved = tab_strip_model()->GetTabAtIndex(2);
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId other = model->AddSpace("Other", SK_ColorBLUE)->id();
+  model->SetSpaceForTab(moved, other);  // Move to Space.
+  ASSERT_EQ(other, model->SpaceForTab(moved));
+  tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(stays));
+
+  tab_strip_model()->CloseFolderTabs(folder);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return tab_strip_model()->GetIndexOfTab(stays) == TabStripModel::kNoTab;
+  }));
+  EXPECT_NE(TabStripModel::kNoTab, tab_strip_model()->GetIndexOfTab(moved))
+      << "the other Space's tab is still open";
+  EXPECT_EQ(other, model->SpaceForTab(moved));
+  EXPECT_TRUE(model->IsTabInActiveSpace(tab_strip_model()->GetActiveTab()));
+}
+
+// PLAN.md TAB-13: closing a folder of sleeping tabs, the tab on screen among
+// them, starts no load in any of them: none is woken on its way out.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ClosingAFolderOfSleepingTabsWakesNone) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  std::vector<tabs::TabInterface*> sleepers;
+  for (int i = 0; i < 10; ++i) {
+    sleepers.push_back(
+        OpenLoaded("sleeper" + base::NumberToString(i) + ".test"));
+  }
+  tabs::TabInterface* const awake = OpenLoaded("awake.test");
+  std::vector<int> indices;
+  for (int i = 1; i < tab_strip_model()->count(); ++i) {
+    indices.push_back(i);
+  }
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder(indices);
+  ASSERT_TRUE(folder);
+  ASSERT_EQ(11u, folder->TabCountRecursive());
+  tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(awake));
+  stedding::SleepTabList(sleepers);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return std::ranges::all_of(sleepers, [](tabs::TabInterface* tab) {
+      return tab->GetContents()->WasDiscarded();
+    });
+  }));
+
+  int loads = 0;
+  std::vector<std::unique_ptr<NavigationCounter>> counters;
+  for (tabs::TabInterface* const tab : sleepers) {
+    counters.push_back(
+        std::make_unique<NavigationCounter>(tab->GetContents(), &loads));
+  }
+  tab_strip_model()->CloseFolderTabs(folder);
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return tab_strip_model()->count() == 1; }));
+  EXPECT_EQ(0, loads) << "a sleeping tab was woken on its way out";
+}
+
+// TAB-6: a target=_blank link from a folder's first tab opens right after
+// it, inside the folder.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ABlankTargetLinkFromAFolderTabJoinsIt) {
+  tabs::FolderTabCollection* const folder = MakeFolder();
+  ASSERT_TRUE(folder);
+  tab_strip_model()->ActivateTabAt(1);
+  content::ExecuteScriptAsync(
+      tab_strip_model()->GetWebContentsAt(1),
+      "const a = document.createElement('a');"
+      "a.href = 'about:blank#blank'; a.target = '_blank';"
+      "document.body.appendChild(a); a.click();");
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return tab_strip_model()->count() == 5; }));
+  EXPECT_EQ(folder, ParentOf(2)) << "right after its opener, in the folder";
+  EXPECT_NE(folder, ParentOf(4));
+}
+
+// TAB-6: a folder of three tabs; its middle one closed and brought back
+// with ⇧⌘T returns to its place in the folder.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, AMiddleTabReopenedComesBackInPlace) {
+  AppendTab();
+  AppendTab();
+  AppendTab();
+  AppendTab();
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({1, 2, 3});
+  ASSERT_TRUE(folder);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  tab_strip_model()->ActivateTabAt(0);
+  content::NavigationController& middle =
+      tab_strip_model()->GetWebContentsAt(2)->GetController();
+  middle.LoadURL(GURL("about:blank#middle"), content::Referrer(),
+                 ui::PAGE_TRANSITION_TYPED, std::string());
+  ASSERT_TRUE(content::WaitForLoadStop(tab_strip_model()->GetWebContentsAt(2)));
+  tab_strip_model()->CloseWebContentsAt(
+      2, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  ASSERT_EQ(4, tab_strip_model()->count());
+
+  ui_test_utils::TabAddedWaiter added(browser());
+  chrome::RestoreTab(browser());
+  added.Wait();
+  ASSERT_EQ(5, tab_strip_model()->count());
+  const int back = tab_strip_model()->GetIndexOfWebContents(
+      tab_strip_model()->GetActiveWebContents());
+  EXPECT_EQ(2, back) << "in its place";
+  EXPECT_EQ(folder, ParentOf(back)) << "in its folder";
+}
+
+// TAB-6: Move Tab to New Folder on a split inside F[X, split, Y] nests the
+// split, whole and in place.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ASplitInsideAFolderNestsInPlace) {
+  for (int i = 0; i < 4; ++i) {
+    AppendTab();
+  }
+  // F[1, split(2, 3), 4]
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({1, 2, 3, 4});
+  ASSERT_TRUE(folder);
+  tab_strip_model()->ActivateTabAt(2);
+  tab_strip_model()->AddToNewSplit(
+      {3}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  tabs::TabInterface* const left = tab_strip_model()->GetTabAtIndex(2);
+  tabs::TabInterface* const right = tab_strip_model()->GetTabAtIndex(3);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_EQ(left->GetSplit(), right->GetSplit());
+
+  tabs::FolderTabCollection* const nested =
+      tab_strip_model()->AddToNewFolder({2, 3}, folder);
+  ASSERT_TRUE(nested);
+  EXPECT_EQ(static_cast<const tabs::TabCollection*>(folder),
+            nested->GetParentCollection());
+  EXPECT_TRUE(left->IsSplit()) << "the split stays whole";
+  EXPECT_EQ(left->GetSplit(), right->GetSplit());
+  EXPECT_EQ(2, tab_strip_model()->GetIndexOfTab(left)) << "in place";
+  EXPECT_EQ(folder, ParentOf(1));
+  EXPECT_EQ(folder, ParentOf(4));
+}
+
+// TAB-6: Move Tabs Out of Folder on a nested folder that has a later sibling
+// leaves its tabs in the parent folder, where they were.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, MovingTabsOutOfANestedFolderKeepsThem) {
+  for (int i = 0; i < 3; ++i) {
+    AppendTab();
+  }
+  // Outer[1, Inner[2], 3]
+  tabs::FolderTabCollection* const outer =
+      tab_strip_model()->AddToNewFolder({1, 2, 3});
+  ASSERT_TRUE(outer);
+  tabs::FolderTabCollection* const inner =
+      tab_strip_model()->AddToNewFolder({2}, outer);
+  ASSERT_TRUE(inner);
+  tabs::TabInterface* const moved = tab_strip_model()->GetTabAtIndex(2);
+
+  tab_strip_model()->MoveTabsOutOfFolder(inner);
+  EXPECT_EQ(2, tab_strip_model()->GetIndexOfTab(moved)) << "where it was";
+  EXPECT_EQ(outer, ParentOf(2)) << "in the parent folder";
+  EXPECT_EQ(outer, ParentOf(1));
+  EXPECT_EQ(outer, ParentOf(3));
+}
+
+// TAB-6: an extension's tabs.create and tabs.move at an index inside a
+// folder land there, in the folder.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, AnExtensionCreatesAndMovesIntoAFolder) {
+  tabs::FolderTabCollection* const folder = MakeFolder();  // [0, F[1, 2], 3]
+  ASSERT_TRUE(folder);
+  scoped_refptr<const extensions::Extension> extension =
+      extensions::ExtensionBuilder("Stedding folder test").Build();
+
+  auto create = base::MakeRefCounted<extensions::TabsCreateFunction>();
+  create->set_extension(extension.get());
+  std::optional<base::Value> created =
+      extensions::api_test_utils::RunFunctionAndReturnSingleResult(
+          create, R"([{"index": 2, "url": "about:blank#created"}])",
+          browser()->GetProfile());
+  ASSERT_TRUE(created.has_value());
+  ASSERT_EQ(5, tab_strip_model()->count());
+  EXPECT_EQ(folder, ParentOf(2)) << "created inside the folder";
+
+  // The last tab, outside the folder, moved to the folder's middle.
+  tabs::TabInterface* const last = tab_strip_model()->GetTabAtIndex(4);
+  const int tab_id =
+      extensions::ExtensionTabUtil::GetTabId(last->GetContents());
+  auto move = base::MakeRefCounted<extensions::TabsMoveFunction>();
+  move->set_extension(extension.get());
+  std::optional<base::Value> moved =
+      extensions::api_test_utils::RunFunctionAndReturnSingleResult(
+          move, "[" + base::NumberToString(tab_id) + R"(, {"index": 2}])",
+          browser()->GetProfile());
+  ASSERT_TRUE(moved.has_value());
+  EXPECT_EQ(2, tab_strip_model()->GetIndexOfTab(last));
+  EXPECT_EQ(folder, ParentOf(2)) << "moved inside the folder";
+}
+
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, RestoringAClosedFolderTabDoesNotCrash) {
+  ASSERT_TRUE(MakeFolder());
+  tab_strip_model()->CloseWebContentsAt(
+      2, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  ASSERT_EQ(3, tab_strip_model()->count());
+
+  ui_test_utils::TabAddedWaiter added(browser());
+  chrome::RestoreTab(browser());
+  added.Wait();
+
+  EXPECT_EQ(4, tab_strip_model()->count());
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/https_first_browsertest.cc b/chrome/test/stedding/https_first_browsertest.cc
new file mode 100644
index 0000000000000..2e16106c9f27c
--- /dev/null
+++ b/chrome/test/stedding/https_first_browsertest.cc
@@ -0,0 +1,148 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// HTTPS-First, balanced mode, on in a fresh profile (PLAN.md TAB-16,
+// docs/PRIVACY.md, privacy Q2). A site whose HTTPS does not work shows the
+// HTTPS-First warning before its HTTP page loads, and Settings -> Stedding's
+// row and chrome://settings/security's control read the same setting.
+//
+// Upstream's own pattern: an HTTP server and an HTTPS server on the ports
+// the upgrade uses, and a certificate that fails for the site's name, so
+// the upgrade to HTTPS fails as it does for a site that serves only HTTP.
+
+#include "base/command_line.h"
+#include "base/values.h"
+#include "chrome/browser/interstitials/security_interstitial_page_test_utils.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ssl/generated_https_first_mode_pref.h"
+#include "chrome/browser/ssl/https_first_mode_settings_tracker.h"
+#include "chrome/browser/ssl/https_upgrades_interceptor.h"
+#include "chrome/browser/ssl/https_upgrades_util.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/extensions/api/settings_private.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/test/base/chrome_test_utils.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/content_mock_cert_verifier.h"
+#include "net/base/net_errors.h"
+#include "net/cert/cert_status_flags.h"
+#include "net/cert/cert_verify_result.h"
+#include "net/cert/x509_certificate.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace {
+
+class HttpsFirstTest : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    mock_cert_verifier_.SetUpCommandLine(command_line);
+  }
+
+  void SetUpInProcessBrowserTestFixture() override {
+    InProcessBrowserTest::SetUpInProcessBrowserTestFixture();
+    mock_cert_verifier_.SetUpInProcessBrowserTestFixture();
+  }
+
+  void TearDownInProcessBrowserTestFixture() override {
+    mock_cert_verifier_.TearDownInProcessBrowserTestFixture();
+    InProcessBrowserTest::TearDownInProcessBrowserTestFixture();
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    mock_cert_verifier_.mock_cert_verifier()->set_default_result(net::OK);
+    host_resolver()->AddRule("*", "127.0.0.1");
+    // http-only.com: its certificate names another host, so HTTPS fails.
+    const scoped_refptr<net::X509Certificate> cert =
+        https_server_.GetCertificate();
+    net::CertVerifyResult verify_result;
+    verify_result.is_issued_by_known_root = false;
+    verify_result.verified_cert = cert;
+    verify_result.cert_status = net::CERT_STATUS_COMMON_NAME_INVALID;
+    mock_cert_verifier_.mock_cert_verifier()->AddResultForCertAndHost(
+        cert, "http-only.com", verify_result,
+        net::ERR_CERT_COMMON_NAME_INVALID);
+
+    http_server_.AddDefaultHandlers(GetChromeTestDataDir());
+    https_server_.AddDefaultHandlers(GetChromeTestDataDir());
+    ASSERT_TRUE(http_server_.Start());
+    ASSERT_TRUE(https_server_.Start());
+    HttpsUpgradesInterceptor::SetHttpsPortForTesting(https_server_.port());
+    HttpsUpgradesInterceptor::SetHttpPortForTesting(http_server_.port());
+  }
+
+  void TearDownOnMainThread() override {
+    HttpsUpgradesInterceptor::SetHttpsPortForTesting(0);
+    HttpsUpgradesInterceptor::SetHttpPortForTesting(0);
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  // What chrome://settings/security's HTTPS-First control shows.
+  int SecurityPageValue() {
+    GeneratedHttpsFirstModePref generated(browser()->GetProfile());
+    const auto pref = generated.GetPrefObject();
+    return pref.value && pref.value->is_int() ? pref.value->GetInt() : -1;
+  }
+
+  // A link to `url` in the tab on screen, with the upgrade and its fallback
+  // run to the end.
+  content::WebContents* FollowLinkTo(const GURL& url) {
+    content::WebContents* const contents =
+        browser()->GetTabStripModel()->GetActiveWebContents();
+    content::NavigationController::LoadURLParams params(url);
+    params.transition_type = ui::PAGE_TRANSITION_LINK;
+    content::NavigateToURLBlockUntilNavigationsComplete(
+        contents, params,
+        /*number_of_navigations=*/1);
+    return contents;
+  }
+
+  net::EmbeddedTestServer http_server_{net::EmbeddedTestServer::TYPE_HTTP};
+  net::EmbeddedTestServer https_server_{net::EmbeddedTestServer::TYPE_HTTPS};
+  content::ContentMockCertVerifier mock_cert_verifier_;
+};
+
+IN_PROC_BROWSER_TEST_F(HttpsFirstTest, AnHttpOnlySiteShowsTheWarningFirst) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  // A fresh profile: the Stedding row's preference is on, the upgrades
+  // follow it, and the security page shows balanced mode.
+  EXPECT_TRUE(prefs->GetBoolean(prefs::kHttpsFirstBalancedMode));
+  EXPECT_TRUE(IsBalancedModeEnabled(prefs));
+  EXPECT_EQ(static_cast<int>(HttpsFirstModeSetting::kEnabledBalanced),
+            SecurityPageValue());
+
+  const GURL http_url = http_server_.GetURL("http-only.com", "/simple.html");
+  content::WebContents* const contents = FollowLinkTo(http_url);
+  EXPECT_EQ(http_url, contents->GetLastCommittedURL());
+  EXPECT_TRUE(chrome_browser_interstitials::IsShowingHttpsFirstModeInterstitial(
+      contents))
+      << "the warning comes before the HTTP page";
+}
+
+IN_PROC_BROWSER_TEST_F(HttpsFirstTest, TurnedOffTheSiteLoadsAndBothPagesAgree) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(prefs::kHttpsFirstBalancedMode, false);
+  EXPECT_FALSE(IsBalancedModeEnabled(prefs));
+  EXPECT_EQ(static_cast<int>(HttpsFirstModeSetting::kDisabled),
+            SecurityPageValue());
+
+  const GURL http_url = http_server_.GetURL("http-only.com", "/simple.html");
+  content::WebContents* const contents = FollowLinkTo(http_url);
+  EXPECT_EQ(http_url, contents->GetLastCommittedURL());
+  EXPECT_FALSE(
+      chrome_browser_interstitials::IsShowingHttpsFirstModeInterstitial(
+          contents));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/import_browsertest.cc b/chrome/test/stedding/import_browsertest.cc
new file mode 100644
index 0000000000000..0a07a07a96980
--- /dev/null
+++ b/chrome/test/stedding/import_browsertest.cc
@@ -0,0 +1,154 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Pins that come in from a file (PLAN.md TAB-17, pins H13, import I20). A
+// sidebar file -- Arc's, or a Stedding backup in the same shape -- that pins
+// a bookmarklet and a local file brings in no pin whose home is not a web
+// page, and resetting every pin afterwards runs no script.
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/test/test_future.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/arc_sidebar_importer.h"
+#include "chrome/browser/ui/spaces/sidebar_backup.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/pin_home.h"
+#include "chrome/browser/ui/stedding/pin_lifecycle.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace {
+
+// One Space whose pinned run holds a web page, a bookmarklet and a local
+// file, a bookmarklet among its loose tabs, and one among the essentials.
+constexpr char kSidebarWithOddPages[] = R"json({
+  "sidebar": {"containers": [
+    {"global": {}},
+    {
+      "spaces": [
+        "space-work", {
+          "id": "space-work", "title": "Work",
+          "containerIDs": ["pinned", "cont-pinned", "unpinned", "cont-unpinned"]
+        }
+      ],
+      "items": [
+        "cont-pinned", {"id": "cont-pinned", "parentID": null,
+          "childrenIds": ["tab-web", "tab-js", "tab-file"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-unpinned", {"id": "cont-unpinned", "parentID": null,
+          "childrenIds": ["tab-js2"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-top", {"id": "cont-top", "parentID": null,
+          "childrenIds": ["tab-js3"], "title": "",
+          "data": {"itemContainer": {"containerType": {"topApps": {}}}}},
+        "tab-web", {"id": "tab-web", "parentID": "cont-pinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "https://mail.example/", "savedTitle": "Mail"}}},
+        "tab-js", {"id": "tab-js", "parentID": "cont-pinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "javascript:document.title='ran'",
+            "savedTitle": "Bookmarklet"}}},
+        "tab-file", {"id": "tab-file", "parentID": "cont-pinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "file:///tmp/notes.html",
+            "savedTitle": "Notes"}}},
+        "tab-js2", {"id": "tab-js2", "parentID": "cont-unpinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "javascript:void(0)", "savedTitle": "Loose"}}},
+        "tab-js3", {"id": "tab-js3", "parentID": "cont-top",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "javascript:void(1)", "savedTitle": "Top"}}}
+      ],
+      "topAppsContainerIDs": [{"default": "cont-top"}, "cont-top"]
+    }
+  ]}
+})json";
+
+constexpr char kNotes[] = "file:///tmp/notes.html";
+
+class SidebarImportTest : public InProcessBrowserTest {
+ protected:
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  // No tab shows a javascript: address, every pin of either tier has a web
+  // home or none, the local file is a pin with no home, and resetting every
+  // pin runs no script.
+  void ExpectOnlyWebHomes() {
+    ASSERT_TRUE(model());
+    bool notes_found = false;
+    int pins = 0;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      const GURL shown = tab->GetContents()->GetVisibleURL();
+      EXPECT_FALSE(shown.SchemeIs(url::kJavaScriptScheme)) << shown.spec();
+      if (const std::optional<GURL> home = model()->HomeUrl(tab)) {
+        EXPECT_TRUE(stedding::IsAllowedPinHome(*home)) << home->spec();
+      }
+      if (tab->IsPinned() || model()->IsSpacePinned(tab)) {
+        ++pins;
+      }
+      if (shown == GURL(kNotes)) {
+        notes_found = true;
+        EXPECT_TRUE(model()->IsSpacePinned(tab));
+        EXPECT_FALSE(model()->HomeUrl(tab).has_value());
+      }
+    }
+    EXPECT_TRUE(notes_found) << "a local file is a page, and comes in";
+    EXPECT_EQ(2, pins) << "the web page and the local file";
+
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      if (!tab->IsPinned() && !model()->IsSpacePinned(tab)) {
+        continue;
+      }
+      stedding::ResetToHome(browser(), tab);
+      content::WebContents* const contents = tab->GetContents();
+      EXPECT_FALSE(contents->GetVisibleURL().SchemeIs(url::kJavaScriptScheme));
+      EXPECT_NE(u"ran", contents->GetTitle()) << "no bookmarklet ran";
+    }
+  }
+};
+
+// The importer's own path: Arc's file, parsed and applied.
+IN_PROC_BROWSER_TEST_F(SidebarImportTest, AnArcImportBringsInOnlyWebHomes) {
+  const std::optional<spaces::ArcImportPlan> plan =
+      spaces::ParseArcSidebar(kSidebarWithOddPages);
+  ASSERT_TRUE(plan.has_value());
+  spaces::ArcImportOptions options;
+  options.history = false;
+  options.passwords = false;
+  spaces::ApplyArcImport(browser(), *plan, options);
+  ExpectOnlyWebHomes();
+}
+
+// A Stedding backup, read from disk the way Settings' "Import sidebar…"
+// reads it.
+IN_PROC_BROWSER_TEST_F(SidebarImportTest, ABackupFileBringsInOnlyWebHomes) {
+  base::ScopedTempDir dir;
+  base::FilePath file;
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(dir.CreateUniqueTempDir());
+    file = dir.GetPath().AppendASCII("Work.json");
+    ASSERT_TRUE(base::WriteFile(file, kSidebarWithOddPages));
+  }
+  base::test::TestFuture<std::optional<spaces::ArcImportResult>> done;
+  spaces::ImportSidebarFileAsync(browser(), file, done.GetCallback());
+  ASSERT_TRUE(done.Get().has_value());
+  ExpectOnlyWebHomes();
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/link_drop_browsertest.cc b/chrome/test/stedding/link_drop_browsertest.cc
new file mode 100644
index 0000000000000..3f882025f557e
--- /dev/null
+++ b/chrome/test/stedding/link_drop_browsertest.cc
@@ -0,0 +1,294 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Links dropped on the sidebar over folders (PLAN.md TAB-5): over a
+// top-level folder, over a nested folder, and above the list when a folder
+// is the first row. Each drop runs BrowserRootView's own path -- the one a
+// drag from a page, the address bar or Finder takes -- so a crash in the
+// folder code fails here, and the link must open where the indicator was.
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/memory/raw_ptr.h"
+#include "base/test/run_until.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_root_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/tabs/common/folder_view.h"
+#include "chrome/browser/ui/views/tabs/common/tab_view.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "components/webui/chrome_urls/pref_names.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/base/filename_util.h"
+#include "ui/base/dragdrop/drag_drop_types.h"
+#include "ui/base/dragdrop/drop_target_event.h"
+#include "ui/base/dragdrop/mojom/drag_drop_types.mojom.h"
+#include "ui/base/dragdrop/os_exchange_data.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/compositor/layer_tree_owner.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/views/view.h"
+#include "url/gurl.h"
+
+namespace {
+
+class LinkDropTest : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  BrowserRootView* root_view() {
+    return static_cast<BrowserRootView*>(
+        browser_view()->GetWidget()->GetRootView());
+  }
+
+  // A point in the root view, `fraction` of the way down `view`, once the
+  // rows are where a person would see them.
+  gfx::Point PointIn(views::View* view, double fraction) {
+    EXPECT_TRUE(
+        stedding::test::WaitForRowsToSettle(browser_view()->GetWidget()));
+    gfx::Point point(view->width() / 2,
+                     static_cast<int>(view->height() * fraction));
+    views::View::ConvertPointToTarget(view, root_view(), &point);
+    return point;
+  }
+
+  TabView* RowFor(int index) {
+    EXPECT_TRUE(
+        stedding::test::WaitForRowsToSettle(browser_view()->GetWidget()));
+    return stedding::test::FindDrawnRow(
+        root_view(), tab_strip_model()->GetTabAtIndex(index));
+  }
+
+  FolderView* ViewFor(const tabs::FolderTabCollection* folder) {
+    EXPECT_TRUE(
+        stedding::test::WaitForRowsToSettle(browser_view()->GetWidget()));
+    return stedding::test::FindDrawnFolder(root_view(), folder);
+  }
+
+  // Drops `url` at `point` the way a drag does: it enters, the dropped
+  // address is filtered, the position is updated and the drop runs.
+  void DropAt(const GURL& url, const gfx::Point& point) {
+    ui::OSExchangeData data;
+    data.SetURL(url, std::u16string());
+    DropDataAt(data, point);
+  }
+
+  // The same for a file dragged from the Finder.
+  void DropFileAt(const base::FilePath& file, const gfx::Point& point) {
+    ui::OSExchangeData data;
+    data.SetFilename(file);
+    DropDataAt(data, point);
+  }
+
+  // A local page to drop.
+  base::FilePath MakeFile(const std::string& name) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    if (!files_.IsValid()) {
+      EXPECT_TRUE(files_.CreateUniqueTempDir());
+    }
+    const base::FilePath file = files_.GetPath().AppendASCII(name);
+    EXPECT_TRUE(base::WriteFile(file, "<title>dropped</title>"));
+    return file;
+  }
+
+  void DropDataAt(const ui::OSExchangeData& data, const gfx::Point& point) {
+    const ui::DropTargetEvent event(data, gfx::PointF(point),
+                                    gfx::PointF(point),
+                                    ui::DragDropTypes::DRAG_COPY |
+                                        ui::DragDropTypes::DRAG_LINK);
+    root_view()->OnDragEntered(event);
+    // The dropped address is checked off the UI thread first; until then an
+    // update offers no drop.
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return root_view()->OnDragUpdated(event) != ui::DragDropTypes::DRAG_NONE;
+    })) << "the sidebar refused the drop";
+    ui::mojom::DragOperation operation = ui::mojom::DragOperation::kNone;
+    root_view()->GetDropCallback(event).Run(event, operation,
+                                            /*drag_image_layer_owner=*/nullptr);
+  }
+
+  const tabs::TabCollection* ParentOf(int index) {
+    return tab_strip_model()->GetTabAtIndex(index)->GetParentCollection();
+  }
+
+  // Outer[1, 2, Inner[3], 4] with 0 above it and 5 below.
+  void BuildNestedFolders() {
+    for (int i = 0; i < 5; ++i) {
+      AppendTab();
+    }
+    ASSERT_EQ(6, tab_strip_model()->count());
+    outer_ = tab_strip_model()->AddToNewFolder({1, 2, 3, 4});
+    ASSERT_TRUE(outer_);
+    inner_ = tab_strip_model()->AddToNewFolder({3}, outer_);
+    ASSERT_TRUE(inner_);
+  }
+
+  // Waits for the navigation a drop over a row starts in that row's tab.
+  void ExpectShows(int index, const GURL& url) {
+    content::WebContents* const contents =
+        tab_strip_model()->GetWebContentsAt(index);
+    EXPECT_TRUE(content::WaitForLoadStop(contents));
+    EXPECT_EQ(url, contents->GetLastCommittedURL());
+  }
+
+  raw_ptr<tabs::FolderTabCollection> outer_ = nullptr;
+  raw_ptr<tabs::FolderTabCollection> inner_ = nullptr;
+  base::ScopedTempDir files_;
+};
+
+// The middle of a row inside a folder: the link replaces that tab's page,
+// and the tab stays in the folder.
+IN_PROC_BROWSER_TEST_F(LinkDropTest, OnARowInAFolderReplacesItsPage) {
+  BuildNestedFolders();
+  const GURL url("about:blank#dropped-on-2");
+  TabView* const row = RowFor(2);
+  ASSERT_TRUE(row);
+  DropAt(url, PointIn(row, 0.5));
+  EXPECT_EQ(6, tab_strip_model()->count());
+  ExpectShows(2, url);
+  EXPECT_EQ(outer_, ParentOf(2));
+}
+
+// The same, one folder deeper.
+IN_PROC_BROWSER_TEST_F(LinkDropTest, OnARowInANestedFolderReplacesItsPage) {
+  BuildNestedFolders();
+  const GURL url("about:blank#dropped-on-3");
+  TabView* const row = RowFor(3);
+  ASSERT_TRUE(row);
+  DropAt(url, PointIn(row, 0.5));
+  EXPECT_EQ(6, tab_strip_model()->count());
+  ExpectShows(3, url);
+  EXPECT_EQ(inner_, ParentOf(3));
+}
+
+// The top edge of a folder's second row: a new tab opens there, inside the
+// folder.
+IN_PROC_BROWSER_TEST_F(LinkDropTest, AboveARowInAFolderOpensInTheFolder) {
+  BuildNestedFolders();
+  const GURL url("about:blank#between-1-and-2");
+  TabView* const row = RowFor(2);
+  ASSERT_TRUE(row);
+  DropAt(url, PointIn(row, 0.05));
+  ASSERT_EQ(7, tab_strip_model()->count());
+  ExpectShows(2, url);
+  EXPECT_EQ(outer_, ParentOf(2));
+}
+
+// The folder's header: the link opens before the folder, not in it.
+IN_PROC_BROWSER_TEST_F(LinkDropTest, OnAFolderHeaderOpensBeforeTheFolder) {
+  BuildNestedFolders();
+  const GURL url("about:blank#before-outer");
+  FolderView* const folder = ViewFor(outer_);
+  ASSERT_TRUE(folder);
+  const gfx::Rect header = folder->GetHeaderBoundsInScreen();
+  gfx::Point point = header.CenterPoint();
+  views::View::ConvertPointFromScreen(root_view(), &point);
+  DropAt(url, point);
+  ASSERT_EQ(7, tab_strip_model()->count());
+  ExpectShows(1, url);
+  EXPECT_NE(outer_, ParentOf(1));
+  EXPECT_EQ(outer_, ParentOf(2)) << "the folder's own tabs stay in it";
+}
+
+// A folder as the list's first row, and a link dropped at the very top of
+// the list: it opens above the folder.
+IN_PROC_BROWSER_TEST_F(LinkDropTest, AboveAFolderThatIsTheFirstRow) {
+  AppendTab();
+  AppendTab();
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({0, 1});
+  ASSERT_TRUE(folder);
+  FolderView* const folder_view = ViewFor(folder);
+  ASSERT_TRUE(folder_view);
+  const GURL url("about:blank#top");
+  DropAt(url, PointIn(folder_view, 0.02));
+  ASSERT_EQ(4, tab_strip_model()->count());
+  ExpectShows(0, url);
+  EXPECT_NE(folder, ParentOf(0));
+  EXPECT_EQ(folder, ParentOf(1));
+}
+
+// A file from the Finder, over a row inside the nested folder: it opens in
+// that tab, which stays in the folder.
+IN_PROC_BROWSER_TEST_F(LinkDropTest, AFileOnARowInANestedFolderOpensThere) {
+  BuildNestedFolders();
+  const base::FilePath file = MakeFile("nested.html");
+  TabView* const row = RowFor(3);
+  ASSERT_TRUE(row);
+  DropFileAt(file, PointIn(row, 0.5));
+  EXPECT_EQ(6, tab_strip_model()->count());
+  ExpectShows(3, net::FilePathToFileURL(file));
+  EXPECT_EQ(inner_, ParentOf(3));
+}
+
+// A file over a folder's header opens before the folder; over the top of a
+// list whose first row is a folder, above it.
+IN_PROC_BROWSER_TEST_F(LinkDropTest, AFileOnAFolderHeaderOpensBeforeIt) {
+  BuildNestedFolders();
+  const base::FilePath file = MakeFile("header.html");
+  FolderView* const folder = ViewFor(outer_);
+  ASSERT_TRUE(folder);
+  gfx::Point point = folder->GetHeaderBoundsInScreen().CenterPoint();
+  views::View::ConvertPointFromScreen(root_view(), &point);
+  DropFileAt(file, point);
+  ASSERT_EQ(7, tab_strip_model()->count());
+  ExpectShows(1, net::FilePathToFileURL(file));
+  EXPECT_NE(outer_, ParentOf(1));
+  EXPECT_EQ(outer_, ParentOf(2));
+}
+
+IN_PROC_BROWSER_TEST_F(LinkDropTest, AFileAboveAFolderThatIsTheFirstRow) {
+  AppendTab();
+  AppendTab();
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({0, 1});
+  ASSERT_TRUE(folder);
+  FolderView* const folder_view = ViewFor(folder);
+  ASSERT_TRUE(folder_view);
+  const base::FilePath file = MakeFile("top.html");
+  DropFileAt(file, PointIn(folder_view, 0.02));
+  ASSERT_EQ(4, tab_strip_model()->count());
+  ExpectShows(0, net::FilePathToFileURL(file));
+  EXPECT_NE(folder, ParentOf(0));
+}
+
+// chrome://tab-strip-internals, with the internal pages on, opens on a
+// window with a folder. It met the folder with a NOTREACHED.
+IN_PROC_BROWSER_TEST_F(LinkDropTest, TheTabStripInternalsPageShowsAFolder) {
+  BuildNestedFolders();
+  g_browser_process->local_state()->SetBoolean(
+      chrome_urls::kInternalOnlyUisEnabled, true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://tab-strip-internals"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page =
+      tab_strip_model()->GetActiveWebContents();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page,
+                           "document.getElementById('treeViewPane')"
+                           ".textContent.includes('TabStrip Tree')")
+        .ExtractBool();
+  }));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/little_window_browsertest.cc b/chrome/test/stedding/little_window_browsertest.cc
new file mode 100644
index 0000000000000..144652d8a1132
--- /dev/null
+++ b/chrome/test/stedding/little_window_browsertest.cc
@@ -0,0 +1,120 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The little window for links from other apps (docs/features/little.md,
+// PLAN.md CMD-7): an address nothing vouches for opens without the trust of
+// a typed one, and a profile that may not open a window gets none instead of
+// a crash.
+
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/synchronization/lock.h"
+#include "base/test/run_until.h"
+#include "base/thread_annotations.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/little_window.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/policy/core/common/policy_pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/browser_test.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "url/gurl.h"
+
+namespace {
+
+class LittleWindowTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestMonitor(base::BindRepeating(
+        &LittleWindowTest::OnRequest, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // A cookie only a page the user reached themselves may send.
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL(
+                       "/set-cookie?strict=1;SameSite=Strict")));
+  }
+
+  // The server's thread: what the little window's page asked with.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    if (request.GetURL().path() != "/little") {
+      return;
+    }
+    base::AutoLock lock(lock_);
+    seen_ = true;
+    const auto site = request.headers.find("Sec-Fetch-Site");
+    fetch_site_ = site == request.headers.end() ? "" : site->second;
+    const auto cookie = request.headers.find("Cookie");
+    cookie_ = cookie == request.headers.end() ? "" : cookie->second;
+  }
+
+  // Opens the little window and waits for its page's request.
+  void OpenAndWait(bool untrusted_launch) {
+    BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+        browser()->GetProfile(), embedded_test_server()->GetURL("/little"),
+        /*anchor=*/nullptr, untrusted_launch);
+    ASSERT_TRUE(little);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      base::AutoLock lock(lock_);
+      return seen_;
+    }));
+  }
+
+  std::string FetchSite() {
+    base::AutoLock lock(lock_);
+    return fetch_site_;
+  }
+
+  std::string Cookie() {
+    base::AutoLock lock(lock_);
+    return cookie_;
+  }
+
+ private:
+  base::Lock lock_;
+  bool seen_ GUARDED_BY(lock_) = false;
+  std::string fetch_site_ GUARDED_BY(lock_);
+  std::string cookie_ GUARDED_BY(lock_);
+};
+
+// An address from another app with nothing to vouch for it (a custom scheme)
+// is not treated as typed: the request is cross-site and carries no
+// SameSite=Strict cookie, as upstream's startup tabs do.
+IN_PROC_BROWSER_TEST_F(LittleWindowTest, AnUntrustedAddressOpensAsCrossSite) {
+  OpenAndWait(/*untrusted_launch=*/true);
+  EXPECT_NE("none", FetchSite());
+  EXPECT_FALSE(FetchSite().empty());
+  EXPECT_EQ(std::string::npos, Cookie().find("strict=1")) << Cookie();
+}
+
+// The same address handed over as an ordinary link keeps the user's trust,
+// so the check above is not passing by accident.
+IN_PROC_BROWSER_TEST_F(LittleWindowTest, ATrustedAddressOpensAsTyped) {
+  OpenAndWait(/*untrusted_launch=*/false);
+  EXPECT_EQ("none", FetchSite());
+  EXPECT_NE(std::string::npos, Cookie().find("strict=1")) << Cookie();
+}
+
+// A policy that allows only private windows leaves the profile unable to
+// open a window of its own: the caller gets nothing and opens the address
+// the ordinary way, where CreateBrowserWindow would have CHECKed.
+IN_PROC_BROWSER_TEST_F(LittleWindowTest, AProfileThatMayNotOpenWindowsGetsNone) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetInteger(policy::policy_prefs::kIncognitoModeAvailability,
+                    static_cast<int>(policy::IncognitoModeAvailability::kForced));
+  EXPECT_EQ(nullptr,
+            stedding::OpenLittleWindow(
+                browser()->GetProfile(),
+                embedded_test_server()->GetURL("/little"),
+                /*anchor=*/nullptr, /*untrusted_launch=*/false));
+  prefs->SetInteger(
+      policy::policy_prefs::kIncognitoModeAvailability,
+      static_cast<int>(policy::IncognitoModeAvailability::kEnabled));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/private_coat_browsertest.cc b/chrome/test/stedding/private_coat_browsertest.cc
new file mode 100644
index 0000000000000..de00f318afa2b
--- /dev/null
+++ b/chrome/test/stedding/private_coat_browsertest.cc
@@ -0,0 +1,110 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Which windows wear the private coat (PLAN.md WIN-4, private V1, V2, V7).
+// A real window's whole colour pipeline -- its colour key, Chromium's
+// mixers, Stedding's, the theme -- paints the graphite ground for an
+// incognito window alone. Not for a normal window in dark mode with
+// Customize Chrome's Grey, whose key is dark and grayscale as incognito's
+// is, and which the mixer used to paint graphite; and not for a Guest
+// window, whose profile is off the record too. Only the incognito window
+// says "Private", in its title and on its sidebar's title row.
+
+#include <string>
+
+#include "base/test/run_until.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/themes/theme_service.h"
+#include "chrome/browser/themes/theme_service_factory.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/color/stedding_color_mixer.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/test/browser_test.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+class PrivateCoatTest : public InProcessBrowserTest {
+ protected:
+  static views::Widget* Widget(BrowserWindowInterface* browser) {
+    return BrowserView::GetBrowserViewForBrowser(browser)->GetWidget();
+  }
+
+  // The ground the sidebar and the page card sit on.
+  static SkColor Ground(BrowserWindowInterface* browser) {
+    return Widget(browser)->GetColorProvider()->GetColor(ui::kColorFrameActive);
+  }
+
+  static std::u16string Title(BrowserWindowInterface* browser) {
+    return BrowserView::GetBrowserViewForBrowser(browser)->GetWindowTitle();
+  }
+
+  // Whether any button or label in the window reads `text`.
+  static bool Shows(const views::View* view, const std::u16string& text) {
+    if (const auto* const button = views::AsViewClass<views::LabelButton>(
+            const_cast<views::View*>(view));
+        button && button->GetText() == text) {
+      return true;
+    }
+    if (const auto* const label =
+            views::AsViewClass<views::Label>(const_cast<views::View*>(view));
+        label && label->GetText() == text) {
+      return true;
+    }
+    for (const views::View* const child : view->children()) {
+      if (Shows(child, text)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  static bool SaysPrivate(BrowserWindowInterface* browser) {
+    return Shows(Widget(browser)->GetRootView(), u"Private");
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(PrivateCoatTest, OnlyAnIncognitoWindowIsGraphite) {
+  // A normal window in dark mode with Customize Chrome's Grey: the key is
+  // dark and grayscale, as an incognito window's is.
+  ThemeService* const theme =
+      ThemeServiceFactory::GetForProfile(browser()->GetProfile());
+  theme->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kDark);
+  theme->SetIsGrayscale(true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    const ui::ColorProviderKey key =
+        Widget(browser())->GetColorProviderKeyForTesting();
+    return key.color_mode == ui::ColorProviderKey::ColorMode::kDark &&
+           key.user_color_source ==
+               ui::ColorProviderKey::UserColorSource::kGrayscale;
+  }));
+  EXPECT_NE(kSteddingPrivateWindow, Ground(browser()))
+      << "a dark window with the Grey colour keeps its history, and its coat";
+  EXPECT_EQ(std::u16string::npos, Title(browser()).find(u"Private"));
+  EXPECT_FALSE(SaysPrivate(browser()));
+
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+  ASSERT_TRUE(incognito);
+  EXPECT_EQ(kSteddingPrivateWindow, Ground(incognito));
+  EXPECT_NE(std::u16string::npos, Title(incognito).find(u" – Private"));
+  EXPECT_TRUE(SaysPrivate(incognito)) << "the sidebar's title row";
+
+  BrowserWindowInterface* const guest = CreateGuestBrowser();
+  ASSERT_TRUE(guest);
+  ASSERT_TRUE(guest->GetProfile()->IsOffTheRecord());
+  EXPECT_NE(kSteddingPrivateWindow, Ground(guest))
+      << "a Guest window wears the ordinary coat";
+  EXPECT_EQ(std::u16string::npos, Title(guest).find(u"Private"));
+  EXPECT_FALSE(SaysPrivate(guest));
+}
+
+}  // namespace
