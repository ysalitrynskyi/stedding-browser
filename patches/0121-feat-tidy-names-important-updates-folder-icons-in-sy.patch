+  given.items[kFolder].fields[kFieldIcon] = "📚";
+  RecordLocalEdits(state, &now, given, {}, Stamp{300, kOffice});
+  EXPECT_EQ("📚", state.records.at(kFolder).Get(kFieldIcon));
