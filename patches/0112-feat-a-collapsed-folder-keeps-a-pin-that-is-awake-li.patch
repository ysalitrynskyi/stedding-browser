+// A network context whose pipe closes as the HTTP cache clear arrives, as a
+// network service that restarts drops it: the clear's callback never runs.
+class DroppingNetworkContext : public network::TestNetworkContext {
+ public:
+  mojo::PendingRemote<network::mojom::NetworkContext> Bind() {
+    return receiver_.BindNewPipeAndPassRemote();
+  }
+
+  // network::TestNetworkContext:
+  void ClearHttpCache(base::Time start_time,
+                      base::Time end_time,
+                      network::mojom::ClearDataFilterPtr filter,
+                      ClearHttpCacheCallback callback) override {
+    receiver_.reset();
+  }
+
+ private:
+  mojo::Receiver<network::mojom::NetworkContext> receiver_{this};
+};
+
+// sessions S13 (BACKLOG S-345): Clear Independent Session finishes when the
+// network service's pipe drops before the HTTP cache is cleared, as it does
+// when the service restarts. It waited for the clear's callback, which a
+// dropped pipe never runs, and the Space's pages were never reloaded.
+TEST_F(SpaceWindowTest, ClearingASessionFinishesWhenTheCacheClearIsDropped) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceIsolated(work->id(), true);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const tab = OpenTab();
+  const content::StoragePartitionConfig config = PartitionOf(tab);
+  ASSERT_TRUE(IsSpaceStoragePartition(config));
+  DroppingNetworkContext dropping;
+  profile()->GetStoragePartition(config)->SetNetworkContextForTesting(
+      dropping.Bind());
+
+  base::test::TestFuture<void> wiped;
+  EXPECT_TRUE(model().WipeIsolatedSession(work->id(), wiped.GetCallback()));
+  EXPECT_TRUE(wiped.Wait()) << "the clear never finished";
+  EXPECT_EQ(work->id(), model().SpaceForTab(tab));
+}
+
+// A network context that drops every HTTP cache clear, as a network service
+// that restarts each time it is asked: the partition is handed a new pipe to
+// it after each drop.
+class AlwaysDroppingNetworkContext : public network::TestNetworkContext {
+ public:
+  explicit AlwaysDroppingNetworkContext(content::StoragePartition* partition)
+      : partition_(partition) {}
+
+  void Attach() {
+    partition_->SetNetworkContextForTesting(
+        receiver_.BindNewPipeAndPassRemote());
+  }
+
+  int drops() const { return drops_; }
+
+  // network::TestNetworkContext:
+  void ClearHttpCache(base::Time start_time,
+                      base::Time end_time,
+                      network::mojom::ClearDataFilterPtr filter,
+                      ClearHttpCacheCallback callback) override {
+    ++drops_;
+    receiver_.reset();
+    Attach();
+  }
+
+ private:
+  const raw_ptr<content::StoragePartition> partition_;
+  mojo::Receiver<network::mojom::NetworkContext> receiver_{this};
+  int drops_ = 0;
+};
+
+// sessions S17 (BACKLOG S-345): a deleted Space's jar whose HTTP cache was
+// not cleared -- the clear dropped, and dropped again when asked once more --
+// stays on the profile's pending list for its next window to wipe, and the
+// deletion still finishes. The wipe was taken as done and the jar forgotten,
+// its cache still on disk.
+TEST_F(SpaceWindowTest, AJarWhoseCacheWasNotClearedStaysPending) {
+  const SpaceId home = model().active_id();
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceIsolated(work->id(), true);
+  model().SetActiveSpace(work->id());
+  const content::StoragePartitionConfig config = PartitionOf(OpenTab());
+  ASSERT_TRUE(IsSpaceStoragePartition(config));
+  AlwaysDroppingNetworkContext dropping(
+      profile()->GetStoragePartition(config));
+  dropping.Attach();
+  model().SetActiveSpace(home);
+  const SpaceId work_id = work->id();
+
+  base::test::TestFuture<void> removed;
+  ASSERT_TRUE(model().RemoveSpace(work_id, removed.GetCallback()));
+  EXPECT_TRUE(removed.Wait()) << "the deletion never finished";
+  EXPECT_EQ(2, dropping.drops()) << "the clear was not asked again";
+  EXPECT_TRUE(profile()
+                  ->GetPrefs()
+                  ->GetList(stedding::prefs::kPendingJarWipes)
+                  .contains(config.partition_name()))
+      << "the jar left the pending list with its cache";
+}
