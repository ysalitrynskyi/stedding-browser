+void SteddingBrowserViewLayout::ConfigureTopContainerBackground(
+    const BrowserLayoutParams& params,
+    CustomCornersBackground* background) {
+  // Let upstream configure corners and cutouts as usual, then paint nothing:
+  // the top container sits on the window's own gradient ground, and a flat
+  // toolbar-theme rectangle here would cover it.
+  BrowserViewTabbedLayoutImpl::ConfigureTopContainerBackground(params,
