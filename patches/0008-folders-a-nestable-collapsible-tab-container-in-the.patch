+namespace stedding {
+namespace {
+
+// The folder ancestry of `tab`, outermost first, as the JSON written into the
+// session. Empty string when the tab is in no folder.
+std::string BuildPath(const tabs::TabInterface* tab) {
+  std::vector<const tabs::FolderTabCollection*> chain;
+  for (const tabs::TabCollection* collection = tab->GetParentCollection();
+       collection; collection = collection->GetParentCollection()) {
+    if (collection->type() == tabs::TabCollection::Type::FOLDER) {
+      chain.push_back(
+          static_cast<const tabs::FolderTabCollection*>(collection));
+    }
+  }
+  if (chain.empty()) {
+    return std::string();
+  }
+  base::ListValue list;
+  for (auto it = chain.rbegin(); it != chain.rend(); ++it) {
+    base::DictValue entry;
+    entry.Set("i", (*it)->id().ToString());
+    entry.Set("t", (*it)->title());
+    entry.Set("c", (*it)->collapsed());
+    list.Append(std::move(entry));
+  }
+  std::string out;
+  base::JSONWriter::Write(list, &out);
+  return out;
+}
+
+struct RestoredEntry {
+  std::string id;
+  std::string title;
+  bool collapsed = false;
+};
+
+std::vector<RestoredEntry> ParsePath(const std::string& data) {
+  std::vector<RestoredEntry> path;
+  const std::optional<base::Value> parsed =
+      base::JSONReader::Read(data, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_list()) {
+    return path;
+  }
+  for (const base::Value& item : parsed->GetList()) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::DictValue& entry = item.GetDict();
+    const std::string* const id = entry.FindString("i");
+    if (!id) {
+      continue;
+    }
+    const std::string* const title = entry.FindString("t");
+    path.push_back({*id, title ? *title : std::string(),
+                    entry.FindBool("c").value_or(false)});
+  }
+  return path;
+}
+
+}  // namespace
+
+FolderSessionService::FolderSessionService(Browser& browser)
+    : browser_(browser) {
+  // Once per process: the session rebuild must re-emit folder paths or they
+  // survive exactly one restart (stedding_session_rebuild.h).
+  static const bool registered = [] {
+    AddSessionRebuildProvider(
+        "folders", base::BindRepeating(
+                       &FolderSessionService::AppendRebuildCommands));
+    return true;
+  }();
+  std::ignore = registered;
+
+  session_service_ = SessionServiceFactory::GetForProfile(browser.GetProfile());
+  session_id_ = browser.GetSessionID();
+  browser.tab_strip_model()->AddObserver(this);
+  session_restored_subscription_ =
+      SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+          [](FolderSessionService* self, Profile* profile, int tab_count) {
+            self->RebuildFromRestoredTabs();
+          },
+          base::Unretained(this)));
+}
+
+FolderSessionService::~FolderSessionService() {
+  browser_->tab_strip_model()->RemoveObserver(this);
+}
+
+void FolderSessionService::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  PersistAllPaths();
+}
+
+std::string FolderSessionService::PathForTab(
+    const tabs::TabInterface* tab) const {
+  return BuildPath(tab);
+}
+
+std::string FolderPathForTab(const tabs::TabInterface* tab) {
+  return BuildPath(tab);
+}
+
+// static
+void FolderSessionService::AppendRebuildCommands(
+    BrowserWindowInterface* browser,
+    SessionRebuildCommands* commands) {
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  for (int i = 0; i < tabs->count(); ++i) {
+    const tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    const std::string path = BuildPath(tab);
+    if (path.empty()) {
+      continue;
+    }
+    const SessionID tab_id =
+        sessions::SessionTabHelper::IdForTab(tab->GetContents());
+    if (tab_id.is_valid()) {
+      commands->push_back(sessions::CreateAddTabExtraDataCommand(
+          tab_id, kSessionTabFolderPathKey, path));
+    }
+  }
+}
+
+void FolderSessionService::PersistAllPaths() {
+  if (!session_service_ || !session_id_.is_valid()) {
+    return;
+  }
+  TabStripModel* const tabs = browser_->tab_strip_model();
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    const std::string path = PathForTab(tab);
+    const auto it = written_.find(tab->GetHandle());
+    if (it != written_.end() && it->second == path) {
+      continue;
+    }
+    content::WebContents* const contents = tab->GetContents();
+    if (!contents) {
+      continue;
+    }
+    const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+    if (!tab_id.is_valid()) {
+      continue;
+    }
+    session_service_->AddTabExtraData(session_id_, tab_id,
+                                      kSessionTabFolderPathKey, path);
+    written_[tab->GetHandle()] = path;
+  }
+}
+
+void FolderSessionService::RebuildFromRestoredTabs() {
+  if (rebuilt_) {
+    return;
+  }
+  rebuilt_ = true;
+
+  TabStripModel* const tabs = browser_->tab_strip_model();
+
+
+  // Depth-first: at each depth, gather the tabs whose restored path names the
+  // same folder id at that depth, fold them together, then recurse. Folders
+  // are rebuilt through the same AddToNewFolder the menu uses.
+  // Collect paths once; the map from id to created folder makes nesting land
+  // in the right parent.
+  std::map<int, std::vector<RestoredEntry>> paths_by_tab;
+  for (int i = 0; i < tabs->count(); ++i) {
+    content::WebContents* const contents =
+        tabs->GetTabAtIndex(i)->GetContents();
+    if (!contents) {
+      continue;
+    }
+    const spaces::FolderRestorePath* const restored =
+        spaces::FolderRestorePath::FromWebContents(contents);
+    if (!restored || restored->path().empty()) {
+      continue;
+    }
+    paths_by_tab[i] = ParsePath(restored->path());
+  }
+  if (paths_by_tab.empty()) {
+    return;
+  }
+
+  // Rebuild level by level. Tabs move as folders are made, so indices are
+  // re-resolved through the tab pointers each round.
+  std::map<std::string, tabs::FolderTabCollection*> made;
+  bool progressed = true;
+  for (size_t depth = 0; progressed; ++depth) {
+    progressed = false;
+    // folder id at this depth -> tab indices, resolved fresh.
+    std::map<std::string, std::pair<std::vector<int>, RestoredEntry>> buckets;
+    for (int i = 0; i < tabs->count(); ++i) {
+      content::WebContents* const contents =
+          tabs->GetTabAtIndex(i)->GetContents();
+      if (!contents) {
+        continue;
+      }
+      const spaces::FolderRestorePath* const restored =
+          spaces::FolderRestorePath::FromWebContents(contents);
+      if (!restored) {
+        continue;
+      }
+      const std::vector<RestoredEntry> path = ParsePath(restored->path());
+      if (path.size() <= depth) {
+        continue;
+      }
+      buckets[path[depth].id].first.push_back(i);
+      buckets[path[depth].id].second = path[depth];
+    }
+    for (auto& [id, bucket] : buckets) {
+      if (made.contains(id)) {
+        continue;
+      }
+      tabs::FolderTabCollection* parent = nullptr;
+      // The parent is whatever folder this bucket's first tab sits in now,
+      // which is the folder made at the previous depth.
+      const tabs::TabCollection* const current =
+          tabs->GetTabAtIndex(bucket.first.front())->GetParentCollection();
+      if (current &&
+          current->type() == tabs::TabCollection::Type::FOLDER) {
+        parent = const_cast<tabs::FolderTabCollection*>(
+            static_cast<const tabs::FolderTabCollection*>(current));
+      }
+      tabs::FolderTabCollection* const folder =
+          tabs->AddToNewFolder(bucket.first, parent);
+      if (!folder) {
+        continue;
+      }
+      folder->SetTitle(bucket.second.title);
+      folder->SetCollapsed(bucket.second.collapsed);
+      made[id] = folder;
+      progressed = true;
+    }
+  }
+  PersistAllPaths();
+}
+
+}  // namespace stedding
