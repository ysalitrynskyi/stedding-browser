+void CommandBarView::BuildActions() {
+  actions_.clear();
+  const bool normal_window =
+      browser_->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+      !browser_->GetProfile()->IsOffTheRecord();
+  TabStripModel* const tabs = browser_->tab_strip_model();
+  spaces::SpaceModel* const spaces = spaces::SpaceModel::From(browser_);
+  tabs::TabInterface* const active = tabs->GetActiveTab();
+  PrefService* const prefs = browser_->GetProfile()->GetPrefs();
+  chrome::BrowserCommandController* const commands =
+      chrome::BrowserCommandController::From(browser_);
+
+  const auto command = [&](int id, std::u16string title) {
+    if (!commands || !commands->IsCommandEnabled(id)) {
+      return;
+    }
+    actions_.push_back(
+        {std::move(title), ChordFor(id),
+         base::BindRepeating([](chrome::BrowserCommandController* controller,
+                                int id) { controller->ExecuteCommand(id); },
+                             base::Unretained(commands), id)});
+  };
+
+  // Stedding's rows first: the sidebar's verbs (K9), only where they have a
+  // target (K15: no Spaces, pins or folders in private and popup windows;
+  // K16: nothing tab-scoped without a tab, nothing Space-scoped for an
+  // essentials tab).
+  if (normal_window && spaces) {
+    if (active && !active->IsPinned()) {
+      const spaces::SpaceId own = spaces->SpaceForTab(active);
+      for (const auto& space : spaces->spaces()) {
+        if (space->id() == own) {
+          continue;
+        }
+        const spaces::SpaceId id = space->id();
+        actions_.push_back(
+            {u"Move Tab to " + spaces->DisplayName(id), std::u16string(),
+             base::BindRepeating(
+                 [](spaces::SpaceModel* model, TabStripModel* strip,
+                    spaces::SpaceId id) {
+                   if (tabs::TabInterface* const tab = strip->GetActiveTab()) {
+                     model->SetSpaceForTab(tab, id);
+                     model->SetActiveSpace(id);
+                   }
+                 },
+                 base::Unretained(spaces), base::Unretained(tabs), id)});
+      }
+      command(IDC_STEDDING_TOGGLE_SPACE_PIN, spaces->IsSpacePinned(active)
+                                                 ? u"Unpin from This Space"
+                                                 : u"Pin to This Space");
+      actions_.push_back({u"Move Tab to New Folder", std::u16string(),
+                          base::BindRepeating(
+                              [](TabStripModel* strip) {
+                                const int index = strip->active_index();
+                                if (index != TabStripModel::kNoTab) {
+                                  strip->ExecuteContextMenuCommand(
+                                      index,
+                                      TabStripModel::CommandMoveTabToNewFolder);
+                                }
+                              },
+                              base::Unretained(tabs))});
+      if (!stedding::TabsToSleep(browser_, active, SleepScope::kThisTab)
+               .empty()) {
+        actions_.push_back(
+            {u"Sleep Tab", std::u16string(),
+             base::BindRepeating(
+                 [](Browser* browser) {
+                   if (tabs::TabInterface* const tab =
+                           browser->tab_strip_model()->GetActiveTab()) {
+                     stedding::SleepTabs(browser, tab, SleepScope::kThisTab);
+                   }
+                 },
+                 base::Unretained(browser_))});
+      }
+    }
+    command(IDC_STEDDING_CLEAR_SPACE, u"Clear This Space");
+    command(IDC_STEDDING_SPACE_NEXT, u"Next Space");
+    command(IDC_STEDDING_SPACE_PREVIOUS, u"Previous Space");
+    actions_.push_back(
+        {u"New Space", std::u16string(),
+         base::BindRepeating(
+             [](spaces::SpaceModel* model) {
+               const auto& choice = spaces::kSpaceColors.at(
+                   model->size() % spaces::kSpaceColors.size());
+               model->SetActiveSpace(
+                   model->AddSpace(std::string(), choice.color)->id());
+             },
+             base::Unretained(spaces))});
+  }
+  if (normal_window) {
+    command(IDC_STEDDING_CAPTURE_VISIBLE, u"Capture the Page");
+    command(IDC_STEDDING_CAPTURE_REGION, u"Capture a Region");
+    command(IDC_STEDDING_CAPTURE_FULL_PAGE, u"Capture the Full Document");
+    command(IDC_COPY_URL, u"Copy Link");
+    command(IDC_STEDDING_COPY_MARKDOWN_LINK, u"Copy Link as Markdown");
+    command(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+            u"Collapse or Expand the Sidebar");
+    actions_.push_back({u"Show Keyboard Shortcuts", std::u16string(),
+                        base::BindRepeating(
+                            [](Browser* browser) {
+                              browser->OpenGURL(
+                                  GURL("chrome://settings/stedding"),
+                                  WindowOpenDisposition::NEW_FOREGROUND_TAB);
+                            },
+                            base::Unretained(browser_))});
+
+    // One on/off row per Stedding preference, and a cycling row per
+    // dropdown (K17): the bar stays open and the row re-reads.
+    if (prefs) {
+      struct BoolPref {
+        const char* key;
+        const char16_t* label;
+      };
+      static constexpr BoolPref kBools[] = {
+          {stedding::prefs::kPeekEnabled,
+           u"Peek links that leave a pinned tab's site"},
+          {stedding::prefs::kUiAnimate, u"Animate the sidebar and overlays"},
+          {stedding::prefs::kCopyStripTracking,
+           u"Copy links without tracking parameters"},
+          {stedding::prefs::kPinsCloseSleeps,
+           u"\u2318W on a pinned tab puts it to sleep"},
+          {stedding::prefs::kMenusShort, u"Short context menus"},
+          {stedding::prefs::kHoldCmdNumbers,
+           u"Row numbers while \u2318 is held"},
+          {stedding::prefs::kNewTabShowHint,
+           u"Command-bar hint on the new tab page"},
+          {stedding::prefs::kNewTabShowShortcuts,
+           u"Shortcuts on the new tab page"},
+      };
+      for (const BoolPref& pref : kBools) {
+        const bool on = prefs->GetBoolean(pref.key);
+        Action action;
+        action.title = std::u16string(pref.label) + (on ? u": On" : u": Off");
+        action.keeps_bar_open = true;
+        action.run = base::BindRepeating(
+            [](PrefService* prefs, const char* key) {
+              prefs->SetBoolean(key, !prefs->GetBoolean(key));
+            },
+            base::Unretained(prefs), pref.key);
+        actions_.push_back(std::move(action));
+      }
+      struct IntPref {
+        const char* key;
+        const char16_t* label;
+        std::vector<PrefChoice> choices;
+      };
+      const IntPref kInts[] = {
+          {stedding::prefs::kArchiveIdleHours,
+           u"Archive idle tabs after",
+           {{0, u"Never"},
+            {6, u"6 hours"},
+            {12, u"12 hours"},
+            {24, u"1 day"},
+            {72, u"3 days"}}},
+          {stedding::prefs::kSpaceSleepMinutes,
+           u"A left Space sleeps after",
+           {{0, u"Never"},
+            {5, u"5 minutes"},
+            {15, u"15 minutes"},
+            {60, u"1 hour"}}},
+      };
+      for (const IntPref& pref : kInts) {
+        const int value = prefs->GetInteger(pref.key);
+        std::u16string name = u"?";
+        size_t at = 0;
+        for (size_t i = 0; i < pref.choices.size(); ++i) {
+          if (pref.choices[i].value == value) {
+            name = pref.choices[i].name;
+            at = i;
+          }
+        }
