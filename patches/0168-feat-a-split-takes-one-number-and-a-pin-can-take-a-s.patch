+void SpaceModel::OnSplitTabChanged(const SplitTabChange& change) {
+  // splits J5: a tab that joins a Space pin in a split stays in the pinned run
+  // with it, pinned too, since a split is one row (J1).
+  if ((change.type != SplitTabChange::Type::kAdded &&
+       change.type != SplitTabChange::Type::kContentsChanged) ||
+      !tab_strip_model_ ||
+      !tab_strip_model_->ContainsSplit(change.split_id)) {
+    return;
+  }
+  const std::vector<tabs::TabInterface*> panes =
+      tab_strip_model_->GetSplitData(change.split_id)->ListTabs();
+  if (std::ranges::any_of(panes, [this](const tabs::TabInterface* pane) {
+        return IsSpacePinned(pane);
+      })) {
+    for (tabs::TabInterface* const pane : panes) {
+      if (!IsSpacePinned(pane) && !pane->IsPinned()) {
+        SetSpacePinnedOnOneTab(pane, /*pinned=*/true, /*move=*/false);
+      }
+    }
+  }
+}
