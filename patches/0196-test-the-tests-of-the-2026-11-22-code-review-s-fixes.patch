+// The place tests: a server in memory behind an embedded test server, as in
+// sidebar_sync_place_browsertest.cc, which can fail every request made after
+// the test's probe is deleted.
+struct PlaceFaultsB13 {
+  // Every request after the probe's deletion answers 503.
+  std::atomic<bool> fail_after_probe{false};
+  std::atomic<bool> probe_removed{false};
+};
+
+std::string PeerFileB13(int64_t seq) {
+  const std::string space = "0123456789ABCDEF0123456789ABCDEF";
+  const std::string pin =
+      spaces::TabSyncId(base::Uuid::GenerateRandomV4().AsLowercaseString());
+  const sb::State state = PeerStateB13(space, {pin}, NowMsB13());
+  sb::FileMeta meta;
+  meta.install = kPeerB13;
+  meta.device = "Office PC";
+  meta.seq = seq;
+  meta.nonce = sb::MakeInstallId();
+  meta.written_ms = NowMsB13();
+  meta.hlc = state.MaxTime();
+  meta.joined_ms = 1;
+  return sb::SerializeSyncFile(state, meta);
+}
+
+std::unique_ptr<net::test_server::HttpResponse> AnswerOrFailB13(
+    FakePlace* place,
+    PlaceFaultsB13* faults,
+    const net::test_server::HttpRequest& request) {
+  if (faults->fail_after_probe && faults->probe_removed) {
+    auto failed = std::make_unique<net::test_server::BasicHttpResponse>();
+    failed->set_code(net::HTTP_SERVICE_UNAVAILABLE);
+    return failed;
+  }
+  std::map<std::string, std::string> headers;
+  for (const auto& [name, value] : request.headers) {
+    headers[base::ToLowerASCII(name)] = value;
+  }
+  // The address the request was sent to, as a signature covers it.
+  const GURL url(
+      base::StrCat({"http://", headers["host"], request.relative_url}));
+  const FakePlace::Reply reply =
+      place->Handle(request.method_string, url, headers, request.content);
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_code(static_cast<net::HttpStatusCode>(reply.status));
+  response->set_content(reply.body);
+  for (const auto& [name, value] : reply.headers) {
+    response->AddCustomHeader(name, value);
+  }
+  // The test's last request, once it has passed, deletes its probe.
+  if (request.method_string == "DELETE") {
+    faults->probe_removed = true;
+  }
+  return response;
+}
