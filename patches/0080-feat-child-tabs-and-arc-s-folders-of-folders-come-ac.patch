diff --git a/chrome/browser/ui/stedding/tab_parents.cc b/chrome/browser/ui/stedding/tab_parents.cc
new file mode 100644
index 0000000000000..144b1604afd62
--- /dev/null
+++ b/chrome/browser/ui/stedding/tab_parents.cc
@@ -0,0 +1,286 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/tab_parents.h"
+
+#include <algorithm>
+#include <map>
+#include <string>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/uuid.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/sessions/stedding_session_rebuild.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/base/page_transition_types.h"
+
+namespace stedding {
+namespace {
+
+// The tokens ride on the WebContents, so they are there before the
+// TabInterface exists on restore, as a tab's name is (tab_names.cc).
+class TabParentData : public content::WebContentsUserData<TabParentData> {
+ public:
+  ~TabParentData() override = default;
+
+  const std::string& token() const { return token_; }
+  const std::string& parent() const { return parent_; }
+  void set_token(std::string token) { token_ = std::move(token); }
+  void set_parent(std::string parent) { parent_ = std::move(parent); }
+
+ private:
+  friend class content::WebContentsUserData<TabParentData>;
+  explicit TabParentData(content::WebContents* contents)
+      : content::WebContentsUserData<TabParentData>(*contents) {}
+
+  std::string token_;
+  std::string parent_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabParentData);
+
+TabParentData& DataFor(content::WebContents* contents) {
+  return *TabParentData::GetOrCreateForWebContents(contents);
+}
+
+// Writes `key` = `value` for `contents` to its window's session; an empty
+// value clears what an earlier write said.
+void Write(BrowserWindowInterface* browser,
+           content::WebContents* contents,
+           const char* key,
+           const std::string& value) {
+  if (!browser || !contents) {
+    return;
+  }
+  SessionService* const session_service =
+      SessionServiceFactory::GetForProfile(browser->GetProfile());
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (session_service && tab_id.is_valid()) {
+    session_service->AddTabExtraData(browser->GetSessionID(), tab_id, key,
+                                     value);
+  }
+}
+
+// Writes the places of `child` and of its parent, as they are by then, to
+// their windows' sessions.
+void WritePlaces(tabs::TabHandle child, tabs::TabHandle parent) {
+  if (tabs::TabInterface* const tab = parent.Get()) {
+    Write(tab->GetBrowserWindowInterface(), tab->GetContents(),
+          kSessionTabTokenKey, TabToken(tab->GetContents()));
+  }
+  if (tabs::TabInterface* const tab = child.Get()) {
+    Write(tab->GetBrowserWindowInterface(), tab->GetContents(),
+          kSessionTabParentKey, TabParentToken(tab->GetContents()));
+  }
+}
+
+void AppendRebuildCommands(BrowserWindowInterface* browser,
+                           SessionRebuildCommands* commands) {
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  for (int i = 0; i < tabs->count(); ++i) {
+    content::WebContents* const contents = tabs->GetWebContentsAt(i);
+    const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+    if (!tab_id.is_valid()) {
+      continue;
+    }
+    if (const std::string token = TabToken(contents); !token.empty()) {
+      commands->push_back(sessions::CreateAddTabExtraDataCommand(
+          tab_id, kSessionTabTokenKey, token));
+    }
+    if (const std::string parent = TabParentToken(contents); !parent.empty()) {
+      commands->push_back(sessions::CreateAddTabExtraDataCommand(
+          tab_id, kSessionTabParentKey, parent));
+    }
+  }
+}
+
+}  // namespace
+
+std::string TabToken(const content::WebContents* contents) {
+  const TabParentData* const data =
+      contents ? TabParentData::FromWebContents(contents) : nullptr;
+  return data ? data->token() : std::string();
+}
+
+std::string TabParentToken(const content::WebContents* contents) {
+  const TabParentData* const data =
+      contents ? TabParentData::FromWebContents(contents) : nullptr;
+  return data ? data->parent() : std::string();
+}
+
+tabs::TabInterface* ParentOfNewTab(const TabStripModel& model, int index) {
+  if (index < 0 || index >= model.count() || model.IsTabPinned(index)) {
+    return nullptr;
+  }
+  tabs::TabInterface* const tab = model.GetTabAtIndex(index);
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return nullptr;
+  }
+  tabs::TabInterface* parent = nullptr;
+  if (content::RenderFrameHost* const frame = contents->GetOpener()) {
+    // A page's own window.open names its page. Chromium takes the tab on
+    // screen as the new tab's opener, which is another tab when a page in
+    // the background opens one.
+    const int source = model.GetIndexOfWebContents(
+        content::WebContents::FromRenderFrameHost(frame));
+    parent = source == TabStripModel::kNoTab ? model.GetOpenerOfTabAt(index)
+                                             : model.GetTabAtIndex(source);
+  } else {
+    // A link opened in a new tab (a middle click, Cmd-click, "Open link in
+    // new tab") starts its first load as a link, from the tab on screen.
+    // Chromium gives a new tab, a typed address opened beside the tab and a
+    // duplicate an opener too, so that closing them returns to it; none of
+    // those is a child.
+    const content::NavigationEntry* const entry =
+        contents->GetController().GetPendingEntry();
+    if (entry && ui::PageTransitionCoreTypeIs(entry->GetTransitionType(),
+                                              ui::PAGE_TRANSITION_LINK)) {
+      parent = model.GetOpenerOfTabAt(index);
+    }
+  }
+  if (!parent || parent == tab || parent->IsPinned()) {
+    return nullptr;
+  }
+  return parent;
+}
+
+void SetTabParent(BrowserWindowInterface* browser,
+                  tabs::TabInterface* child,
+                  tabs::TabInterface* parent) {
+  content::WebContents* const child_contents =
+      child ? child->GetContents() : nullptr;
+  content::WebContents* const parent_contents =
+      parent ? parent->GetContents() : nullptr;
+  if (!child_contents || !parent_contents || child == parent) {
+    return;
+  }
+  TabParentData& parent_data = DataFor(parent_contents);
+  if (parent_data.token().empty()) {
+    parent_data.set_token(base::Uuid::GenerateRandomV4().AsLowercaseString());
+  }
+  DataFor(child_contents).set_parent(parent_data.token());
+  // Written a turn later, once every observer of the insertion, the
+  // session's own among them, has seen the new tab.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WritePlaces, child->GetHandle(), parent->GetHandle()));
+}
+
+void ReparentChildrenOf(BrowserWindowInterface* browser,
+                        const content::WebContents* closed) {
+  const std::string token = TabToken(closed);
+  if (!browser || token.empty()) {
+    return;
+  }
+  const std::string grandparent = TabParentToken(closed);
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  for (int i = 0; i < tabs->count(); ++i) {
+    content::WebContents* const contents = tabs->GetWebContentsAt(i);
+    if (contents == closed || TabParentToken(contents) != token) {
+      continue;
+    }
+    // Not written to the session here, so that tabs taken out as a window
+    // closes never rewrite the places the next launch restores. The next
+    // rewrite of the session log carries the new place
+    // (AppendRebuildCommands); until then a restart finds the child under a
+    // parent that is gone, at the left.
+    DataFor(contents).set_parent(grandparent);
+  }
+}
+
+void CarryTabParent(content::WebContents* from, content::WebContents* to) {
+  const std::string token = TabToken(from);
+  const std::string parent = TabParentToken(from);
+  if (!to || (token.empty() && parent.empty())) {
+    return;
+  }
+  TabParentData& data = DataFor(to);
+  data.set_token(token);
+  data.set_parent(parent);
+}
+
+void RestoreTabParentFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  if (!contents) {
+    return;
+  }
+  const auto token = extra_data.find(kSessionTabTokenKey);
+  const auto parent = extra_data.find(kSessionTabParentKey);
+  const bool has_token = token != extra_data.end() && !token->second.empty();
+  const bool has_parent =
+      parent != extra_data.end() && !parent->second.empty();
+  if (!has_token && !has_parent) {
+    return;
+  }
+  TabParentData& data = DataFor(contents);
+  if (has_token) {
+    data.set_token(token->second);
+  }
+  if (has_parent) {
+    data.set_parent(parent->second);
+  }
+}
+
+void RegisterTabParentSessionRebuild() {
+  static const bool registered = [] {
+    AddSessionRebuildProvider("tab_parents",
+                              base::BindRepeating(&AppendRebuildCommands));
+    return true;
+  }();
+  std::ignore = registered;
+}
+
+std::vector<int> NestDepths(const std::vector<NestRow>& rows) {
+  std::vector<int> depths;
+  depths.reserve(rows.size());
+  // The rows above the current one that it could still nest under: each
+  // entry's token and depth, the deepest last.
+  std::vector<std::pair<const std::string*, int>> chain;
+  uintptr_t run = 0;
+  for (const NestRow& row : rows) {
+    if (row.run != run) {
+      chain.clear();
+      run = row.run;
+    }
+    int depth = 0;
+    if (!row.parent.empty()) {
+      while (!chain.empty() && *chain.back().first != row.parent) {
+        chain.pop_back();
+      }
+      if (!chain.empty()) {
+        depth = std::min(chain.back().second + 1, std::max(row.limit, 0));
+      }
+    } else {
+      chain.clear();
+    }
+    if (depth == 0) {
+      chain.clear();
+    }
+    depths.push_back(depth);
+    chain.emplace_back(&row.token, depth);
+  }
+  return depths;
+}
+
+}  // namespace stedding
