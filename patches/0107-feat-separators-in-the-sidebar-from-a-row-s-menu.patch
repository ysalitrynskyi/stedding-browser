diff --git a/chrome/browser/ui/stedding/tab_separators.cc b/chrome/browser/ui/stedding/tab_separators.cc
new file mode 100644
index 0000000000000..b73575b82406e
--- /dev/null
+++ b/chrome/browser/ui/stedding/tab_separators.cc
@@ -0,0 +1,124 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/tab_separators.h"
+
+#include <tuple>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/sessions/stedding_session_rebuild.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_change_type.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace stedding {
+namespace {
+
+// The mark rides on the WebContents, so it is there before the TabInterface
+// exists on restore, as a tab's name is (tab_names.cc).
+class TabSeparatorData
+    : public content::WebContentsUserData<TabSeparatorData> {
+ public:
+  ~TabSeparatorData() override = default;
+
+ private:
+  friend class content::WebContentsUserData<TabSeparatorData>;
+  explicit TabSeparatorData(content::WebContents* contents)
+      : content::WebContentsUserData<TabSeparatorData>(*contents) {}
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabSeparatorData);
+
+// "1": a separator; nothing, or "", none. A label may come later under its
+// own key.
+constexpr char kSeparatorValue[] = "1";
+
+void AppendRebuildCommands(BrowserWindowInterface* browser,
+                           SessionRebuildCommands* commands) {
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  for (int i = 0; i < tabs->count(); ++i) {
+    content::WebContents* const contents = tabs->GetWebContentsAt(i);
+    if (!HasSeparatorAbove(contents)) {
+      continue;
+    }
+    const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+    if (!tab_id.is_valid()) {
+      continue;
+    }
+    commands->push_back(sessions::CreateAddTabExtraDataCommand(
+        tab_id, kSessionTabSeparatorKey, kSeparatorValue));
+  }
+}
+
+}  // namespace
+
+bool HasSeparatorAbove(const content::WebContents* contents) {
+  return contents && TabSeparatorData::FromWebContents(contents);
+}
+
+void SetSeparatorAbove(BrowserWindowInterface* browser,
+                       tabs::TabInterface* tab,
+                       bool separator) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents || HasSeparatorAbove(contents) == separator) {
+    return;
+  }
+  if (separator) {
+    TabSeparatorData::CreateForWebContents(contents);
+  } else {
+    contents->RemoveUserData(TabSeparatorData::UserDataKey());
+  }
+  if (!browser) {
+    return;
+  }
+  if (SessionService* const session_service =
+          SessionServiceFactory::GetForProfile(browser->GetProfile())) {
+    const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+    if (tab_id.is_valid()) {
+      session_service->AddTabExtraData(browser->GetSessionID(), tab_id,
+                                       kSessionTabSeparatorKey,
+                                       separator ? kSeparatorValue : "");
+    }
+  }
+  // The row reads the mark when its tab's data changes (TabView).
+  browser->GetTabStripModel()->NotifyTabChanged(tab, TabChangeType::kAll);
+}
+
+void CarryTabSeparator(content::WebContents* from, content::WebContents* to) {
+  if (to && HasSeparatorAbove(from) && !HasSeparatorAbove(to)) {
+    TabSeparatorData::CreateForWebContents(to);
+  }
+}
+
+void RestoreTabSeparatorFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  const auto it = extra_data.find(kSessionTabSeparatorKey);
+  if (!contents || it == extra_data.end() || it->second != kSeparatorValue ||
+      HasSeparatorAbove(contents)) {
+    return;
+  }
+  TabSeparatorData::CreateForWebContents(contents);
+}
+
+void RegisterTabSeparatorSessionRebuild() {
+  static const bool registered = [] {
+    AddSessionRebuildProvider("tab_separators",
+                              base::BindRepeating(&AppendRebuildCommands));
+    return true;
+  }();
+  std::ignore = registered;
+}
+
+}  // namespace stedding
