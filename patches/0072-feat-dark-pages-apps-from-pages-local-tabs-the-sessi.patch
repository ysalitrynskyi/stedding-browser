+      << "Clear stayed loud after the pointer left";
+
+  // The Archived row, found by the name its tooltip gives it.
+  views::LabelButton* archived = nullptr;
+  std::vector<views::View*> pending = {widget->GetRootView()};
+  while (!pending.empty() && !archived) {
+    views::View* const view = pending.back();
+    pending.pop_back();
+    if (auto* const button = views::AsViewClass<views::LabelButton>(view);
+        button && button->GetVisible() &&
+        button->GetTooltipText() == u"Archived tabs") {
+      archived = button;
+    }
+    for (views::View* const child : view->children()) {
+      pending.push_back(child);
+    }
+  }
+  ASSERT_TRUE(archived) << "the sidebar shows no Archived row";
+  EXPECT_EQ(quiet, archived->GetCurrentTextColor())
+      << "the Archived row is not quiet";
+  archived->SetState(views::Button::STATE_HOVERED);
+  EXPECT_EQ(full, archived->GetCurrentTextColor())
+      << "the hovered Archived row is still quiet";
+  archived->SetState(views::Button::STATE_NORMAL);
+  EXPECT_EQ(quiet, archived->GetCurrentTextColor());
+}
