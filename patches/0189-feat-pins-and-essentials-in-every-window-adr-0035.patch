+  const std::vector<PinRecord> held = {Essential("e", "https://e.example/"),
+                                       Pin("a", work, "https://a.example/"),
+                                       Pin("b", work, "https://b.example/"),
+                                       Pin("c", work, "https://c.example/"),
+                                       Pin("p", play, "https://p.example/"),
+                                       Pin("q", play, "https://q.example/")};
+  Ready(store, held);
+  PinRecord a = Pin("a", work, "https://a.example/");
+  a.name = u"Alpha";
+  PinRecord q = Pin("q", play, "https://q.example/");
+  q.title = u"Q (2)";
+  const PinChanges changes =
+      store.ChangesSince(held, {Essential("e", "https://e.example/"), a,
+                                Pin("c", work, "https://c.example/"),
+                                Pin("b", work, "https://b.example/"),
+                                Pin("n", work, "https://n.example/"),
+                                Pin("p", play, "https://p.example/"), q});
+  ASSERT_EQ(3u, changes.changed.size());
+  EXPECT_EQ("a", changes.changed[0].id);
+  EXPECT_EQ("n", changes.changed[1].id);
+  EXPECT_EQ("q", changes.changed[2].id);
