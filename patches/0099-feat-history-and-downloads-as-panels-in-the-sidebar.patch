+
+/* The sidebar's panels (docs/features/sidebar-panels.md Pn16): no ground of
+ * their own -- the sidebar's shows through -- and the sidebar rows' text
+ * colour, in either scheme. */
+
+@import url(chrome://theme/colors.css?sets=ui,chrome);
+
+:root {
+  --text: var(--color-tab-foreground-inactive-frame-active, #1f2430);
+  --muted: color-mix(in srgb, var(--text) 66%, transparent);
+  --hover: color-mix(in srgb, var(--text) 8%, transparent);
+  --pressed: color-mix(in srgb, var(--text) 14%, transparent);
+  --line: color-mix(in srgb, var(--text) 14%, transparent);
+  --field: color-mix(in srgb, var(--text) 7%, transparent);
+  --warning: #b3261e;
+  --menu-bg: var(--color-menu-background, #fff);
+  --menu-text: var(--color-menu-item-foreground, #1f2430);
+  --focus: var(--color-sys-state-focus-ring, #0b57d0);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --text: var(--color-tab-foreground-inactive-frame-active, #eceaf4);
+    --warning: #f2b8b5;
+    --menu-bg: var(--color-menu-background, #2c3048);
+    --menu-text: var(--color-menu-item-foreground, #eceaf4);
+    --focus: var(--color-sys-state-focus-ring, #a8c7fa);
+  }
+}
+
+html,
+body {
+  background: transparent;
+  color: var(--text);
+  font: 13px/1.35 system-ui, -apple-system, sans-serif;
+  height: 100%;
+  margin: 0;
+  overflow: hidden;
+}
+
