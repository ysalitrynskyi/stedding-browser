+// sessions S32, spaces B38 (GitHub issue 99, BACKLOG S-477): the open row
+// marks the Spaces of a named session by a line under their chips, in the
+// session's colour, so the Spaces that share cookies read as one group
+// wherever they stand in the row; a Space on the Shared session has none. A
+// run of neighbouring chips of one session has one segment under it, ending
+// kSwitcherSessionInset inside the run's outer chips (a quarter of a chip as
+// small as a dot), and a faint connector runs from each segment of a session
+// to its next, under the chips in between. A session whose span, its first
+// segment's start to its last segment's end, crosses the span of an earlier
+// session on the first lane goes on the second, one lane lower, so neither
+// session's line runs over the other's. Two lanes fit under the row; a third
+// session crossing both takes the second again.
+inline constexpr int kSwitcherSessionInset = 3;
+// The segment's thickness, the connector's, and how far one lane is below
+// the one before, all in DIP.
+inline constexpr int kSwitcherSessionStroke = 2;
+inline constexpr int kSwitcherSessionConnector = 1;
+inline constexpr int kSwitcherSessionLanePitch = 4;
+
+struct SwitcherSessionLine {
+  // The session's id, as the chips gave it.
+  std::string session;
+  // 0, or 1 one lane lower.
+  int lane = 0;
+  // Along the row, in the chips' coordinates.
+  std::vector<SwitcherSpan> segments;
+  std::vector<SwitcherSpan> connectors;
+
+  bool operator==(const SwitcherSessionLine&) const = default;
+};
