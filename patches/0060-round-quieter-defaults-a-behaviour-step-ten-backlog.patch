diff --git a/chrome/test/stedding/address_band_browsertest.cc b/chrome/test/stedding/address_band_browsertest.cc
new file mode 100644
index 0000000000000..ccc8c5937ead9
--- /dev/null
+++ b/chrome/test/stedding/address_band_browsertest.cc
@@ -0,0 +1,169 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// toolbar T34. With the chip and the address gathered on the page's middle
+// (T18) in a field that takes the whole row (T29), the field's hover band ran
+// from the row's far left, where there is nothing, to the page actions; and
+// the address painted the band's translucent colour a second time under its
+// own text, a lighter pill cut to the text whose rounded edge went through the
+// first letter (the operator, 2026-10-11). The band now starts at the chip,
+// and the address paints no background of its own over a translucent one.
+
+#include <algorithm>
+#include <optional>
+
+#include "base/location.h"
+#include "base/test/run_until.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/toasts/toast_controller.h"
+#include "chrome/browser/ui/toasts/toast_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/omnibox/omnibox_view_views.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
