+// The sidebar in one look, tinted with `color`: the Space's glyph and name
+// over three rows (spaces B41).
+class EditSpaceView::LookPreview : public views::View {
+  METADATA_HEADER(LookPreview, views::View)
+
+ public:
+  // `pressed` chooses this look to colour, while the Space has a pair.
+  LookPreview(bool dark, base::RepeatingClosure pressed)
+      : dark_(dark), pressed_(std::move(pressed)) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kImage);
+    GetViewAccessibility().SetName(dark ? u"The sidebar in the dark look"
+                                        : u"The sidebar in the light look");
+  }
+
+  void SetChosen(bool chosen) {
+    if (chosen_ != chosen) {
+      chosen_ = chosen;
+      SchedulePaint();
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    pressed_.Run();
+    return true;
+  }
+
+  void Set(SkColor color, std::u16string glyph, std::u16string name) {
+    color_ = color;
+    glyph_ = std::move(glyph);
+    name_ = std::move(name);
+    SchedulePaint();
+  }
+
+  SkColor ground() const {
+    return color_utils::AlphaBlend(
+        color_, dark_ ? kDarkGround : kLightGround,
+        static_cast<SkAlpha>((dark_ ? kDarkTint : kLightTint) * 255));
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kPreviewWidth, kPreviewHeight);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::RectF bounds(GetLocalBounds());
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(ground());
+    canvas->DrawRoundRect(bounds, 10, flags);
+    if (chosen_) {
+      const ui::ColorProvider* const provider = GetColorProvider();
+      cc::PaintFlags ring;
+      ring.setAntiAlias(true);
+      ring.setStyle(cc::PaintFlags::kStroke_Style);
+      ring.setStrokeWidth(2);
+      ring.setColor(provider ? provider->GetColor(ui::kColorFocusableBorderFocused)
+                             : SK_ColorBLUE);
+      gfx::RectF inset = bounds;
+      inset.Inset(1);
+      canvas->DrawRoundRect(inset, 9, ring);
+    }
+    const SkColor ink =
+        dark_ ? SkColorSetRGB(0xED, 0xEB, 0xF2) : SkColorSetRGB(0x1F, 0x23, 0x30);
+    // The Space's title row: its glyph, or a dot in its colour, and its name.
+    const gfx::FontList font;
+    const int title_y = 6;
+    if (glyph_.empty()) {
+      flags.setColor(color_);
+      canvas->DrawCircle(gfx::PointF(20, title_y + 9), 5, flags);
+    } else {
+      canvas->DrawStringRect(glyph_, font.DeriveWithSizeDelta(3), ink,
+                             gfx::Rect(10, title_y, 22, 20));
+    }
+    canvas->DrawStringRect(name_, font.DeriveWithWeight(gfx::Font::Weight::BOLD),
+                           ink, gfx::Rect(36, title_y, kPreviewWidth - 46, 20));
+    // Two rows, the first the one on screen.
+    constexpr std::array<int, 2> kRowWidths = {140, 108};
+    for (size_t i = 0; i < kRowWidths.size(); ++i) {
+      const float y = 30 + i * 16;
+      if (i == 0) {
+        flags.setColor(SkColorSetA(ink, 0x1C));
+        canvas->DrawRoundRect(gfx::RectF(8, y - 4, kPreviewWidth - 16, 16), 6,
+                              flags);
+      }
+      flags.setColor(SkColorSetA(ink, 0x70));
+      canvas->DrawRoundRect(gfx::RectF(16, y + 1, 8, 8), 2, flags);
+      flags.setColor(SkColorSetA(ink, 0x3C));
+      canvas->DrawRoundRect(gfx::RectF(30, y + 2, kRowWidths[i], 6), 3, flags);
+    }
+  }
+
+ private:
+  const bool dark_;
+  const base::RepeatingClosure pressed_;
+  bool chosen_ = false;
+  SkColor color_ = SK_ColorGRAY;
+  std::u16string glyph_;
+  std::u16string name_;
+};
