+// little E11, peek P13 (bug hunt 2026-11-16): with "Show a peek" in a small
+// window, a link from another app that comes while the peek over the window
+// asks "Leave site?" waits for the answer, as a pinned tab's link does, and
+// nothing else opens; Leave opens it in the next peek. A little window had
+// opened with the link at once, and on Leave the link opened a second time,
+// in the peek.
+IN_PROC_BROWSER_TEST_F(LittleWindowTest,
+                       ALinkFromAnotherAppWaitsForThePeeksLeaveSite) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(stedding::prefs::kLittleAsPeek, true);
+  prefs->SetInteger(stedding::prefs::kPeekStyle,
+                    stedding::prefs::kPeekStyleSmallWindow);
+  // The link brings the window to the front (E11); that activation keeps the
+  // peek however slow the build, not only in its first 750 ms (peek P14).
+  stedding::SetPeekOpeningGraceForTesting(base::Seconds(30));
+  const GURL first_url = embedded_test_server()->GetURL("/title2.html");
+  const GURL next_url = embedded_test_server()->GetURL("/title3.html");
+  const auto little_windows = [&]() {
+    int count = 0;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* window) {
+          count += stedding::IsLittleWindow(window) &&
+                   !stedding::IsPeekWindow(window);
+          return true;
+        });
+    return count;
+  };
+  // How many pages of every window show `url`.
+  const auto pages_at = [&](const GURL& url) {
+    int count = 0;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* window) {
+          TabStripModel* const tabs = window->GetTabStripModel();
+          for (int i = 0; tabs && i < tabs->count(); ++i) {
+            count += tabs->GetWebContentsAt(i)->GetVisibleURL() == url;
+          }
+          return true;
+        });
+    return count;
+  };
+  const int tabs_before = browser()->GetTabStripModel()->count();
+
+  // The peek, its page asking before it is left: the user's activation
+  // "Leave site?" needs, and no hang timer.
+  BrowserWindowInterface* const first = stedding::OpenLittleWindow(
+      browser()->GetProfile(), first_url, /*anchor=*/nullptr,
+      /*untrusted_launch=*/false);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(stedding::IsPeekWindow(first));
+  content::WebContents* const page =
+      first->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  ASSERT_TRUE(content::ExecJs(page,
+                              "window.addEventListener('beforeunload', e => {"
+                              "  e.preventDefault(); e.returnValue = ''; });"));
+  content::PrepContentsForBeforeUnloadTest(page);
+
+  // A null window would have the caller open the link as a tab as well.
+  EXPECT_TRUE(stedding::OpenLittleWindow(browser()->GetProfile(), next_url,
+                                         /*anchor=*/nullptr,
+                                         /*untrusted_launch=*/false));
+  javascript_dialogs::AppModalDialogController* const dialog =
+      ui_test_utils::WaitForAppModalDialog();
+  ASSERT_TRUE(dialog);
+  ASSERT_TRUE(dialog->is_before_unload_dialog());
+  EXPECT_EQ(0, little_windows()) << "a little window opened while the link "
+                                    "waited for the peek's answer";
+  EXPECT_EQ(0, pages_at(next_url));
+  EXPECT_EQ(tabs_before, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(first, stedding::PeekOver(browser()));
+
+  dialog->view()->AcceptAppModalDialog();  // Leave.
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    BrowserWindowInterface* const now = stedding::PeekOver(browser());
+    return now && now != first &&
+           now->GetTabStripModel()->GetActiveWebContents()->GetVisibleURL() ==
+               next_url;
+  })) << "the link did not open once the peek had gone";
+  EXPECT_EQ(1, pages_at(next_url)) << "the link opened twice";
+  EXPECT_EQ(0, little_windows());
+  EXPECT_EQ(tabs_before, browser()->GetTabStripModel()->count());
+  stedding::SetPeekOpeningGraceForTesting(base::Milliseconds(750));
+}
