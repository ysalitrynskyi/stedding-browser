@@ -0,0 +1,31 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_STEDDING_VERSION_H_
+#define CHROME_BROWSER_UI_STEDDING_STEDDING_VERSION_H_
+
+#include <string>
+#include <string_view>
+
+namespace stedding {
+
+// The About page's version line (docs/features/settings.md T10):
+// "Stedding <version> · Chromium <version> (arm64)". Without a
+// Stedding version (a build made outside the tooling, which sets the GN
+// argument) it is "Chromium <version> (arm64)". Never "(Developer
+// Build)": that is Chromium's word for a non-official build, and a release is
+// a release.
+std::u16string FormatAboutVersion(std::string_view stedding_version,
+                                  std::string_view chromium_version,
+                                  std::u16string_view processor);
+
+// This build's line. `processor` is the About page's "(arm64)" string.
+std::u16string AboutVersionString(std::u16string_view processor);
+
+// This build's Stedding version, empty when the build was made without it.
+std::string_view SteddingVersion();
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_STEDDING_VERSION_H_
