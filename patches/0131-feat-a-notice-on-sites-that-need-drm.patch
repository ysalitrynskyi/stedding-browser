@@ -0,0 +1,39 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/drm_notice_browser.h"
+
+#import <AppKit/AppKit.h>
+
+#include "base/apple/foundation_util.h"
+#include "base/functional/callback_helpers.h"
+#include "base/mac/launch_application.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// By bundle id, not by path: current macOS keeps Safari on a cryptex volume.
+NSURL* SafariAddress() {
+  return [NSWorkspace.sharedWorkspace
+      URLForApplicationWithBundleIdentifier:@"com.apple.Safari"];
+}
+
+}  // namespace
+
+bool OtherBrowserFound() {
+  return SafariAddress() != nil;
+}
+
+void OpenInOtherBrowser(const GURL& url) {
+  NSURL* const safari = SafariAddress();
+  if (!safari) {
+    return;
+  }
+  base::mac::LaunchApplication(base::apple::NSURLToFilePath(safari),
+                               /*command_line_args=*/{}, {url.spec()},
+                               /*options=*/{}, base::DoNothing());
+}
+
+}  // namespace stedding
