+
+  // The row off the middle of the window's top: where it is drawn and where
+  // a left-to-right layout has it are apart, as in every right-to-left
+  // window whose row has an end it keeps clear (the sidebar's column, the
+  // traffic lights, the window's buttons).
+  [[nodiscard]] bool RowOffTheMiddle() {
+    return base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
