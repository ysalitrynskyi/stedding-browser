           .c_str());
 }
 
+bool LooksSynced(const base::FilePath& folder,
+                 const base::FilePath& home,
+                 const std::vector<base::FilePath>& synced_roots) {
+  for (const base::FilePath& root : synced_roots) {
+    if (!root.empty() && (root == folder || root.IsParent(folder))) {
+      return true;
+    }
+  }
+  if (home.empty() || !home.IsParent(folder)) {
+    return true;
+  }
+  base::FilePath relative;
+  if (!home.AppendRelativePath(folder, &relative)) {
+    return true;
+  }
+  const std::vector<base::FilePath::StringType> parts =
+      relative.GetComponents();
+  if (parts.empty()) {
+    return false;
+  }
+  const std::string first = base::FilePath(parts[0]).AsUTF8Unsafe();
+  if (base::EqualsCaseInsensitiveASCII(first, "Library") && parts.size() > 1) {
+    const std::string second = base::FilePath(parts[1]).AsUTF8Unsafe();
+    return base::EqualsCaseInsensitiveASCII(second, "Mobile Documents") ||
+           base::EqualsCaseInsensitiveASCII(second, "CloudStorage");
+  }
+  // The Mac's iCloud keeps Documents and Desktop themselves, by those names
+  // alone: "Documents Backup" is a folder of its own.
+  for (std::string_view name : {"Documents", "Desktop"}) {
+    if (base::EqualsCaseInsensitiveASCII(first, name)) {
+      return true;
+    }
+  }
+  // A sync app's folder: its name whole, or followed by a space, as in
+  // "Dropbox (Team)" and "OneDrive - Company"; "Boxes" is not synced. Any
+  // folder works for sync; these are the folders the common apps make, so
+  // that one of them gets no note (Syncthing's is "Sync").
+  static constexpr std::string_view kSyncAppFolders[] = {
+      "Dropbox",       "OneDrive",      "Google Drive",   "GoogleDrive",
+      "Box",           "iCloudDrive",   "iCloud Drive",   "Sync",
+      "Nextcloud",     "ownCloud",      "MEGA",           "MEGAsync",
+      "Seafile",       "SynologyDrive", "Synology Drive", "Proton Drive",
+      "Tresorit",      "pCloud Drive",  "Resilio Sync"};
+  return std::ranges::any_of(kSyncAppFolders, [&](std::string_view name) {
+    return base::StartsWith(first, name,
+                            base::CompareCase::INSENSITIVE_ASCII) &&
+           (first.size() == name.size() || first[name.size()] == ' ');
+  });
+}
