+// found in the LICENSE file.
+
+#ifndef CHROME_TEST_STEDDING_SCROLL_EVENTS_MAC_H_
+#define CHROME_TEST_STEDDING_SCROLL_EVENTS_MAC_H_
+
+#include <memory>
+
+namespace ui {
+class ScrollEvent;
+}
+
+namespace stedding::test {
+
+// Where a trackpad's scroll is: AppKit's phase and momentum phase, as the
+// system sets them on the event.
+enum class MacScrollPhase {
+  kNone,
+  kBegan,
+  kChanged,
+  kEnded,
+  kMomentumBegan,
+  kMomentumChanged,
+  kMomentumEnded,
+};
+
+// The ui::ScrollEvent the window makes (BridgedContentView) from the event
+// AppKit hands it. With `precise` false, a mouse's wheel: `right` and `down`
+// notches (lines), no phase. With `precise` true, a trackpad or a Magic
+// Mouse: `right` and `down` pixels, in `phase`. `shift` and `control`: the
+// keys held. Positive `right` and `down` scroll toward the right and the
+// bottom. Its location is the caller's to set.
+std::unique_ptr<ui::ScrollEvent> MakeMacScrollEvent(float right,
+                                                    float down,
+                                                    bool precise,
+                                                    MacScrollPhase phase,
+                                                    bool shift,
+                                                    bool control);
+
+}  // namespace stedding::test
+
+#endif  // CHROME_TEST_STEDDING_SCROLL_EVENTS_MAC_H_
diff --git a/chrome/test/stedding/scroll_events_mac.mm b/chrome/test/stedding/scroll_events_mac.mm
new file mode 100644
index 0000000000000..d427ab83ea42d
--- /dev/null
+++ b/chrome/test/stedding/scroll_events_mac.mm
@@ -0,0 +1,73 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/test/stedding/scroll_events_mac.h"
+
+#import <AppKit/AppKit.h>
+#include <ApplicationServices/ApplicationServices.h>
+#include <stdint.h>
+
+#include "base/apple/owned_objc.h"
+#include "base/apple/scoped_cftyperef.h"
+#include "ui/events/event.h"
+
+namespace stedding::test {
+
+std::unique_ptr<ui::ScrollEvent> MakeMacScrollEvent(float right,
+                                                    float down,
+                                                    bool precise,
+                                                    MacScrollPhase phase,
+                                                    bool shift,
+                                                    bool control) {
+  // The system's deltas are positive up and to the left.
+  base::apple::ScopedCFTypeRef<CGEventRef> scroll(CGEventCreateScrollWheelEvent(
+      nullptr, precise ? kCGScrollEventUnitPixel : kCGScrollEventUnitLine,
+      /*wheelCount=*/2, static_cast<int32_t>(-down),
+      static_cast<int32_t>(-right)));
+  // Set always: without flags, +[NSEvent eventWithCGEvent:] reads the
+  // keyboard's state.
+  CGEventFlags flags = 0;
+  if (shift) {
+    flags |= kCGEventFlagMaskShift;
+  }
+  if (control) {
+    flags |= kCGEventFlagMaskControl;
+  }
+  CGEventSetFlags(scroll.get(), flags);
+  int64_t scroll_phase = 0;
+  int64_t momentum_phase = kCGMomentumScrollPhaseNone;
+  switch (phase) {
+    case MacScrollPhase::kNone:
+      break;
+    case MacScrollPhase::kBegan:
+      scroll_phase = kCGScrollPhaseBegan;
+      break;
+    case MacScrollPhase::kChanged:
+      scroll_phase = kCGScrollPhaseChanged;
+      break;
+    case MacScrollPhase::kEnded:
+      scroll_phase = kCGScrollPhaseEnded;
+      break;
+    case MacScrollPhase::kMomentumBegan:
+      momentum_phase = kCGMomentumScrollPhaseBegin;
+      break;
+    case MacScrollPhase::kMomentumChanged:
+      momentum_phase = kCGMomentumScrollPhaseContinue;
+      break;
+    case MacScrollPhase::kMomentumEnded:
+      momentum_phase = kCGMomentumScrollPhaseEnd;
+      break;
+  }
+  if (phase != MacScrollPhase::kNone) {
+    CGEventSetIntegerValueField(scroll.get(), kCGScrollWheelEventScrollPhase,
+                                scroll_phase);
+    CGEventSetIntegerValueField(scroll.get(),
+                                kCGScrollWheelEventMomentumPhase,
+                                momentum_phase);
+  }
+  NSEvent* const event = [NSEvent eventWithCGEvent:scroll.get()];
+  return std::make_unique<ui::ScrollEvent>(base::apple::OwnedNSEvent(event));
+}
+
+}  // namespace stedding::test
