+// A made-up Arc sidebar of pinned folders (import I3, folders F38): Work's
+// pinned run is a pin, a folder with a folder inside it and a folder of folders
+// only, then a pin after them; Play, which is not the Space on screen, pins one
+// folder. $1 is what Docs holds.
+constexpr char kPinnedLists[] = R"json({
+  "version": 1,
+  "sidebar": {"containers": [
+    {"global": {}},
+    {
+      "spaces": [
+        "space-work", {"id": "space-work", "title": "Work",
+          "containerIDs": ["pinned", "work-pinned", "unpinned", "work-unpinned"]},
+        "space-play", {"id": "space-play", "title": "Play",
+          "containerIDs": ["pinned", "play-pinned", "unpinned", "play-unpinned"]}
+      ],
+      "items": [
+        "work-pinned", {"id": "work-pinned", "parentID": null,
+          "childrenIds": ["tab-a", "list-docs", "list-outer", "tab-z"],
+          "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "work-unpinned", {"id": "work-unpinned", "parentID": null,
+          "childrenIds": ["tab-d"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "play-pinned", {"id": "play-pinned", "parentID": null,
+          "childrenIds": ["list-play"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "play-unpinned", {"id": "play-unpinned", "parentID": null,
+          "childrenIds": [], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "tab-a", {"id": "tab-a", "parentID": "work-pinned", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://a.example/", "savedTitle": "A"}}},
+        "list-docs", {"id": "list-docs", "parentID": "work-pinned",
+          "childrenIds": [$1], "title": "Docs", "data": {"list": {}}},
+        "tab-b", {"id": "tab-b", "parentID": "list-docs", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://b.example/", "savedTitle": "B"}}},
+        "tab-b2", {"id": "tab-b2", "parentID": "list-docs", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://b2.example/", "savedTitle": "B2"}}},
+        "list-inner", {"id": "list-inner", "parentID": "list-docs",
+          "childrenIds": ["tab-c"], "title": "Inner", "data": {"list": {}}},
+        "tab-c", {"id": "tab-c", "parentID": "list-inner", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://c.example/", "savedTitle": "C"}}},
+        "list-outer", {"id": "list-outer", "parentID": "work-pinned",
+          "childrenIds": ["list-x"], "title": "Outer", "data": {"list": {}}},
+        "list-x", {"id": "list-x", "parentID": "list-outer",
+          "childrenIds": ["tab-x"], "title": "X", "data": {"list": {}}},
+        "tab-x", {"id": "tab-x", "parentID": "list-x", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://x.example/", "savedTitle": "X1"}}},
+        "tab-z", {"id": "tab-z", "parentID": "work-pinned", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://z.example/", "savedTitle": "Z"}}},
+        "tab-d", {"id": "tab-d", "parentID": "work-unpinned", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://d.example/", "savedTitle": "D"}}},
+        "list-play", {"id": "list-play", "parentID": "play-pinned",
+          "childrenIds": ["tab-p"], "title": "Games", "data": {"list": {}}},
+        "tab-p", {"id": "tab-p", "parentID": "list-play", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://p.example/", "savedTitle": "P"}}}
+      ],
+      "topAppsContainerIDs": []
+    }
+  ]}
+})json";
+
+// import I3, folders F38 (BACKLOG S-107): a list of Arc's pinned section is a
+// folder of the pinned run, in Arc's order among the pins, with every tab
+// under it a pin with its home. It came in under the Clear line with plain
+// tabs, so a pin after it was drawn before it. A second import adds nothing,
+// and a tab Arc added to the list joins it as a pin.
+TEST_F(ArcSidebarImportWindowTest, ListsOfThePinnedSectionArePinnedFolders) {
+  const auto sidebar = [](std::string_view docs) {
+    return ParseArcSidebar(base::ReplaceStringPlaceholders(
+        kPinnedLists, {std::string(docs)}, nullptr));
+  };
+  const std::optional<ArcImportPlan> plan =
+      sidebar(R"("tab-b", "list-inner")");
+  ASSERT_TRUE(plan.has_value());
+  const ArcImportResult result =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(7u, result.tabs);
+  EXPECT_EQ(5u, result.folders);
+  EXPECT_EQ(0u, result.skipped);
+
+  const Space* const work = SpaceNamed("Work");
+  const Space* const play = SpaceNamed("Play");
+  ASSERT_TRUE(work);
+  ASSERT_TRUE(play);
+  const auto tab_titled = [&](std::u16string_view title) -> tabs::TabInterface* {
+    for (int i = 0; i < tabs().count(); ++i) {
+      if (tabs().GetTabAtIndex(i)->GetContents()->GetTitle() == title) {
+        return tabs().GetTabAtIndex(i);
+      }
+    }
+    return nullptr;
+  };
+  const auto folder_of =
+      [](const tabs::TabCollection* collection) -> tabs::FolderTabCollection* {
+    return collection && collection->type() == tabs::TabCollection::Type::FOLDER
+               ? const_cast<tabs::FolderTabCollection*>(
+                     static_cast<const tabs::FolderTabCollection*>(collection))
+               : nullptr;
+  };
+  // Every tab of the section is a pin of its Space, with its home, and D,
+  // under the line in Arc, is not.
+  for (const std::u16string_view title : {u"A", u"B", u"C", u"X1", u"Z", u"P"}) {
+    tabs::TabInterface* const tab = tab_titled(title);
+    ASSERT_TRUE(tab) << title;
+    EXPECT_TRUE(model().IsSpacePinned(tab)) << title;
+    EXPECT_TRUE(model().HomeUrl(tab).has_value()) << title;
+    EXPECT_TRUE(tab->GetContents()->WasDiscarded()) << title;
+    EXPECT_FALSE(tab->IsPinned()) << title << " is no essential";
+  }
+  tabs::TabInterface* const loose = tab_titled(u"D");
+  ASSERT_TRUE(loose);
+  EXPECT_FALSE(model().IsSpacePinned(loose));
+
+  // Docs is in the run, and Inner stays a folder inside it.
+  tabs::TabInterface* const b = tab_titled(u"B");
+  tabs::TabInterface* const c = tab_titled(u"C");
+  ASSERT_TRUE(b);
+  ASSERT_TRUE(c);
+  tabs::FolderTabCollection* const docs = folder_of(b->GetParentCollection());
+  ASSERT_TRUE(docs);
+  EXPECT_EQ("Docs", docs->title());
+  EXPECT_TRUE(model().IsFolderSpacePinned(docs));
+  const tabs::FolderTabCollection* const inner =
+      folder_of(c->GetParentCollection());
+  ASSERT_TRUE(inner);
+  EXPECT_EQ("Inner", inner->title());
+  EXPECT_EQ(docs, folder_of(inner->GetParentCollection()));
+
+  // A list of lists only is pinned whole as well.
+  tabs::TabInterface* const x = tab_titled(u"X1");
+  ASSERT_TRUE(x);
+  const tabs::FolderTabCollection* const x_list =
+      folder_of(x->GetParentCollection());
+  ASSERT_TRUE(x_list);
+  EXPECT_EQ("X", x_list->title());
+  tabs::FolderTabCollection* const outer =
+      folder_of(x_list->GetParentCollection());
+  ASSERT_TRUE(outer);
+  EXPECT_EQ("Outer", outer->title());
+  EXPECT_TRUE(model().IsFolderSpacePinned(outer));
+
+  // A Space that is not on screen pins its folder too.
+  tabs::TabInterface* const p = tab_titled(u"P");
+  ASSERT_TRUE(p);
+  EXPECT_EQ(play->id(), model().SpaceForTab(p));
+  tabs::FolderTabCollection* const games = folder_of(p->GetParentCollection());
+  ASSERT_TRUE(games);
+  EXPECT_TRUE(model().IsFolderSpacePinned(games));
+
+  // Arc's order: A, Docs, Outer, Z, and D under the line.
+  const auto index_of = [&](std::u16string_view title) {
+    return tabs().GetIndexOfTab(tab_titled(title));
+  };
+  EXPECT_LT(index_of(u"A"), index_of(u"B"));
+  EXPECT_LT(index_of(u"B"), index_of(u"C"));
+  EXPECT_LT(index_of(u"C"), index_of(u"X1"));
+  EXPECT_LT(index_of(u"X1"), index_of(u"Z")) << "the pin after the folders";
+  EXPECT_LT(index_of(u"Z"), index_of(u"D"));
+
+  // I12: nothing twice, and what Arc added since is a pin of the folder.
+  const ArcImportResult again =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(0u, again.tabs);
+  EXPECT_EQ(0u, again.folders);
+  const std::optional<ArcImportPlan> grown =
+      sidebar(R"("tab-b", "tab-b2", "list-inner")");
+  ASSERT_TRUE(grown.has_value());
+  const ArcImportResult added =
+      ApplyArcImport(browser(), *grown, ArcImportOptions());
+  EXPECT_EQ(1u, added.tabs);
+  tabs::TabInterface* const joined = tab_titled(u"B2");
+  ASSERT_TRUE(joined);
+  EXPECT_EQ(docs, folder_of(joined->GetParentCollection()));
+  EXPECT_TRUE(model().IsSpacePinned(joined));
+  EXPECT_TRUE(model().IsFolderSpacePinned(docs));
+}
+
