+         ImageCentreX(region()->downloads_button())},
+    };
+    for (const auto& [name, chip] : chips()) {
+      glyphs.push_back({name, InkCentreX(chip)});
+    }
+    glyphs.push_back({"the New Space plus",
+                      ImageCentreX(FindButtonWithTooltip(switcher,
+                                                         u"New Space"))});
+    expect_on(column, glyphs);
+#if BUILDFLAG(IS_MAC)
+    {
+      // tabs R11: with ⌘ held each chip shows its chord, as wide as its text
+      // (BACKLOG S-144), and the column of chips is as wide as the widest.
+      SCOPED_TRACE("⌘ held");
+      switcher->SetNumberBadges(true);
+      views::test::RunScheduledLayout(widget);
+      std::vector<Glyph> held;
+      for (const auto& [name, chip] : chips()) {
+        held.push_back({name, chip ? std::optional<double>(CentreX(
+                                         chip->GetBoundsInScreen()))
+                                   : std::nullopt});
+      }
+      held.push_back({"the New Space plus",
+                      ImageCentreX(FindButtonWithTooltip(switcher,
+                                                         u"New Space"))});
+      held.push_back({"the downloads button's icon",
+                      ImageCentreX(region()->downloads_button())});
+      expect_on(column, held);
+      switcher->SetNumberBadges(false);
+      views::test::RunScheduledLayout(widget);
+    }
+#endif
+  };
+
+  ThemeService* const themes =
+      ThemeServiceFactory::GetForProfile(browser()->GetProfile());
+  constexpr struct {
+    ThemeService::BrowserColorScheme scheme;
+    ui::ColorProviderKey::ColorMode mode;
+    const char* name;
+  } kThemes[] = {
+      {ThemeService::BrowserColorScheme::kDark,
+       ui::ColorProviderKey::ColorMode::kDark, "dark"},
+      {ThemeService::BrowserColorScheme::kLight,
+       ui::ColorProviderKey::ColorMode::kLight, "light"},
+  };
+  constexpr struct {
+    int pref;
+    const char* name;
+  } kDensities[] = {{0, "Comfortable"}, {1, "Compact"}, {2, "Dense"}};
+  for (const auto& theme : kThemes) {
+    SCOPED_TRACE(theme.name);
+    themes->SetBrowserColorScheme(theme.scheme);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return widget->GetColorProviderKeyForTesting().color_mode == theme.mode;
+    }));
+    for (const auto& density : kDensities) {
+      SCOPED_TRACE(density.name);
+      // As Settings and the command bar's actions set it (sidebar Y1, Y4).
+      local_state->SetInteger(stedding::prefs::kSidebarDensity, density.pref);
+      ASSERT_NO_FATAL_FAILURE(settle());
+      check_the_open_column();
+      ASSERT_NO_FATAL_FAILURE(collapse(true));
+      check_the_rail();
+      ASSERT_NO_FATAL_FAILURE(collapse(false));
+    }
+  }
+  {
+    // sidebar Y23: with the page flush the column is the rail's own centre.
+    SCOPED_TRACE("the page flush, Comfortable");
+    local_state->SetInteger(stedding::prefs::kSidebarDensity, 0);
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kSidebarPageFlush, true);
+    ASSERT_NO_FATAL_FAILURE(collapse(true));
+    check_the_rail();
+    ASSERT_NO_FATAL_FAILURE(collapse(false));
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kSidebarPageFlush, false);
+  }
