+    return true;
+  }
+#if BUILDFLAG(IS_WIN)
+  // The frame's caption buttons show where the sidebar's do not.
+  if (const BrowserFrameView* const frame = GetFrameView()) {
+    if (frame->SteddingCaptionButtonsInSidebar() !=
+        SteddingWindowButtonsInSidebar()) {
+      return true;
+    }
+  }
+#endif
+  return false;
+}
+
+void BrowserView::UpdateSteddingSidebarChrome() {
+  if (!toolbar_ || !GetWidget() || GetWidget()->IsClosed()) {
+    return;
+  }
+  toolbar_->SetSteddingButtonsHost(SteddingButtonsHostWanted());
+#if BUILDFLAG(IS_WIN)
+  if (BrowserFrameView* const frame = GetFrameView()) {
+    frame->InvalidateLayout();
+    frame->SchedulePaint();
+  }
+#endif
+  InvalidateLayout();
+}
