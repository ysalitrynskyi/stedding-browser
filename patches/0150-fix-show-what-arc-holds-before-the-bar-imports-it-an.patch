+// import I4 (BACKLOG S-101, docs/history/plan-2026-09-26.md WEB-17): the
+// command bar's row shows what Arc holds first, on the welcome flow's import
+// step, and nothing comes in until that step's button. It imported at once and
+// said nothing, so a person could not see what was about to arrive, or leave
+// anything out.
+IN_PROC_BROWSER_TEST_F(ArcImportTest, TheCommandBarRowShowsWhatArcHoldsFirst) {
+  ASSERT_NO_FATAL_FAILURE(WriteSidebar(R"("tab-doc-a")"));
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const size_t spaces_before = model->spaces().size();
+  spaces::SetArcSidebarPresentForTesting(true);
+  const bool ran =
+      stedding::test::RunCommandBarRow(browser(), u"Import from Arc");
+  spaces::SetArcSidebarPresentForTesting(false);
+  ASSERT_TRUE(ran) << "no row in the bar";
+
+  content::WebContents* welcome = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    for (content::WebContents* const contents : content::GetAllWebContents()) {
+      if (contents->GetVisibleURL().host() == "stedding-welcome") {
+        welcome = contents;
+      }
+    }
+    return welcome != nullptr;
+  })) << "the row opened no summary";
+  ASSERT_TRUE(content::WaitForLoadStop(welcome));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(welcome,
+                           "typeof steddingWelcomeTest === 'object' && "
+                           "steddingWelcomeTest.state.step === 'import' && "
+                           "!!steddingWelcomeTest.state.arc && "
+                           "!!steddingWelcomeTest.state.arc.summary")
+        .ExtractBool();
+  })) << "the flow shows no summary of Arc";
+  EXPECT_EQ(spaces_before, model->spaces().size()) << "it imported at once";
+}
