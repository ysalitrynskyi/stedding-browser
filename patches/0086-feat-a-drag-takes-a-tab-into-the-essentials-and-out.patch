+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/essentials_drag_ghost.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/tabs/tab_style.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/favicon_size.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/scoped_canvas.h"
+#include "ui/gfx/shadow_value.h"
+#include "ui/gfx/skia_paint_util.h"
+#include "ui/gfx/text_elider.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+// Room around the shape for its shadow, which lifts it off the sidebar.
+constexpr int kShadowRoom = 10;
+constexpr SkAlpha kShadowAlpha = 0x40;
+constexpr int kShadowBlur = 12;
+constexpr int kShadowOffset = 3;
+// The gap between the favicon and the title, as a row has it.
+constexpr int kTitleGap = 8;
+
+constexpr base::TimeDelta kShapeDuration = base::Milliseconds(160);
+constexpr base::TimeDelta kSettleDuration = base::Milliseconds(200);
+constexpr base::TimeDelta kLeaveDuration = base::Milliseconds(140);
+// A settling copy holds its opacity over the first part of the move, so it
+// is seen arriving, then fades as the real card or row fades in under it.
+constexpr double kSettleFadeFrom = 0.5;
+
+}  // namespace
+
+EssentialsDragGhost::EssentialsDragGhost(ui::ImageModel favicon,
+                                         std::u16string title,
+                                         int count,
+                                         bool animate)
+    : views::AnimationDelegateViews(this),
+      favicon_(std::move(favicon)),
+      title_(std::move(title)),
+      count_(count),
+      animate_(animate) {
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  SetCanProcessEventsWithinSubtree(false);
+  SetProperty(views::kViewIgnoredByLayoutKey, true);
+  GetViewAccessibility().SetIsIgnored(true);
+  shape_.SetSlideDuration(animate_ ? kShapeDuration : base::TimeDelta());
+  shape_.SetTweenType(gfx::Tween::EASE_OUT);
+  finish_.SetTweenType(gfx::Tween::EASE_OUT);
+}
+
+EssentialsDragGhost::~EssentialsDragGhost() = default;
+
+void EssentialsDragGhost::Follow(const gfx::Rect& row,
+                                 const gfx::Rect& card,
+                                 bool as_card) {
+  if (finishing_) {
+    return;
+  }
+  const bool first = row_.IsEmpty() && card_.IsEmpty();
+  row_ = row;
+  card_ = card;
+  if (first) {
+    // The copy appears as the shape it leaves, then turns.
+    shape_.Reset(as_card ? 0.0 : 1.0);
+  }
+  if (as_card != as_card_ || first) {
+    as_card_ = as_card;
+    if (as_card) {
+      shape_.Show();
+    } else {
+      shape_.Hide();
+    }
+  }
+  UpdateBounds();
+}
+
+void EssentialsDragGhost::Finish(const gfx::Rect& target,
+                                 bool as_card,
+                                 bool settles,
+                                 base::OnceClosure done) {
+  finishing_ = true;
+  settles_ = settles;
+  done_ = std::move(done);
+  finish_from_ = shape_bounds_;
+  finish_to_ = target;
+  if (as_card != as_card_) {
+    as_card_ = as_card;
+    if (as_card) {
+      shape_.Show();
+    } else {
+      shape_.Hide();
+    }
+  }
+  if (!animate_) {
+    shape_.Reset(as_card ? 1.0 : 0.0);
+    finish_.Reset(1.0);
+    UpdateBounds();
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                             std::move(done_));
+    return;
+  }
+  finish_.SetSlideDuration(settles ? kSettleDuration : kLeaveDuration);
+  finish_.Reset(0.0);
+  finish_.Show();
+}
+
+void EssentialsDragGhost::UpdateBounds() {
+  const double finish = finish_.GetCurrentValue();
+  if (finishing_) {
+    shape_bounds_ =
+        gfx::Tween::RectValueBetween(finish, finish_from_, finish_to_);
+    const double fade =
+        settles_
+            ? std::clamp((finish - kSettleFadeFrom) / (1 - kSettleFadeFrom),
+                         0.0, 1.0)
+            : finish;
+    layer()->SetOpacity(static_cast<float>(1.0 - fade));
+  } else {
+    shape_bounds_ =
+        gfx::Tween::RectValueBetween(shape_.GetCurrentValue(), row_, card_);
+  }
+  gfx::Rect bounds = shape_bounds_;
+  bounds.Outset(kShadowRoom);
+  SetBoundsRect(bounds);
+  SchedulePaint();
+}
+
+void EssentialsDragGhost::OnPaint(gfx::Canvas* canvas) {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  if (!provider) {
+    return;
+  }
+  const double card = shape_.GetCurrentValue();
+  gfx::RectF shape(GetLocalBounds());
+  shape.Inset(kShadowRoom);
+  // The active row's fill, which may let the ground through, over the
+  // sidebar's ground, so the rows the copy passes over do not show through.
+  const SkColor ground = provider->GetColor(ui::kColorFrameActive);
+  const SkColor fill = TabStyle::Get()->GetCurrentTabBackgroundColor(
+      TabStyle::TabSelectionState::kActive, /*hovered=*/false,
+      /*hover_animation_value=*/0, /*frame_active=*/true,
+      /*frame_glass=*/false, provider);
+  const SkColor text = provider->GetColor(kColorTabForegroundActiveFrameActive);
+  const float radius =
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius);
+
+  // The card or row, lifted: the active row's look and a soft shadow.
+  {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(SkColorSetA(ground, SK_AlphaOPAQUE));
+    flags.setLooper(gfx::CreateShadowDrawLooper(
+        {gfx::ShadowValue(gfx::Vector2d(0, kShadowOffset), kShadowBlur,
+                          SkColorSetA(SK_ColorBLACK, kShadowAlpha))}));
+    canvas->DrawRoundRect(shape, radius, flags);
+    flags.setLooper(nullptr);
+    flags.setColor(fill);
+    canvas->DrawRoundRect(shape, radius, flags);
+  }
+
+  // The favicon: at the row's start, as a row has it, moving to the card's
+  // middle as the copy turns into one.
+  const int icon = gfx::kFaviconSize;
+  const float row_icon_x =
+      shape.x() + std::max(0.0f, (shape.height() - icon) / 2);
+  const float card_icon_x = shape.CenterPoint().x() - icon / 2.0f;
+  const int icon_x = static_cast<int>(
+      gfx::Tween::FloatValueBetween(card, row_icon_x, card_icon_x));
+  const int icon_y = static_cast<int>(shape.CenterPoint().y() - icon / 2.0f);
+  if (!favicon_.IsEmpty()) {
+    const gfx::ImageSkia image = favicon_.Rasterize(provider);
+    if (!image.isNull()) {
+      canvas->DrawImageInt(image, 0, 0, image.width(), image.height(), icon_x,
+                           icon_y, icon, icon, /*filter=*/true);
+    }
+  }
+
+  // The title, a row's alone: it fades over the first half of the turn.
+  const double title_alpha = std::clamp(1.0 - 2.0 * card, 0.0, 1.0);
+  if (title_alpha > 0 && !title_.empty()) {
+    const gfx::FontList font_list;
+    const int title_x = icon_x + icon + kTitleGap;
+    const int title_width =
+        static_cast<int>(shape.right()) - kTitleGap - title_x;
+    if (title_width > 0) {
+      const gfx::Rect title_bounds(title_x, static_cast<int>(shape.y()),
+                                   title_width,
+                                   static_cast<int>(shape.height()));
+      canvas->DrawStringRect(
+          gfx::ElideText(title_, font_list, title_width, gfx::ELIDE_TAIL),
+          font_list,
+          SkColorSetA(text,
+                      static_cast<SkAlpha>(title_alpha * SkColorGetA(text))),
+          title_bounds);
+    }
+  }
+
+  // Several tabs dragged together: their number, on the copy's corner.
+  if (count_ > 1) {
+    const std::u16string number = base::NumberToString16(count_);
+    const gfx::FontList font_list = gfx::FontList().DeriveWithSizeDelta(-2);
+    const int side = std::max(16, font_list.GetHeight() + 2);
+    const int width = std::max(
+        side, gfx::Canvas::GetStringWidth(number, font_list) + side / 2);
+    const gfx::Rect badge(static_cast<int>(shape.right()) - width + 4,
+                          static_cast<int>(shape.y()) - 4, width, side);
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(text);
+    canvas->DrawRoundRect(badge, side / 2, flags);
+    canvas->DrawStringRectWithFlags(number, font_list,
+                                    SkColorSetA(ground, SK_AlphaOPAQUE), badge,
+                                    gfx::Canvas::TEXT_ALIGN_CENTER);
+  }
+}
+
+void EssentialsDragGhost::AnimationProgressed(const gfx::Animation* animation) {
+  UpdateBounds();
+}
+
+void EssentialsDragGhost::AnimationEnded(const gfx::Animation* animation) {
+  UpdateBounds();
+  if (animation == &finish_ && done_) {
+    // `done` may delete this: run it after the animation's own call.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                             std::move(done_));
+  }
+}
+
+BEGIN_METADATA(EssentialsDragGhost)
+END_METADATA
