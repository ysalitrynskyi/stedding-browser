diff --git a/chrome/browser/ui/views/frame/stedding_window_background.cc b/chrome/browser/ui/views/frame/stedding_window_background.cc
new file mode 100644
index 0000000000000..00508a3aad3fb
--- /dev/null
+++ b/chrome/browser/ui/views/frame/stedding_window_background.cc
@@ -0,0 +1,52 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/stedding_window_background.h"
+
+#include "cc/paint/paint_flags.h"
+#include "cc/paint/paint_shader.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkPoint.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/native_theme/native_theme.h"
+#include "ui/views/view.h"
+
+namespace stedding {
+namespace {
+
+constexpr SkColor kLight = SkColorSetRGB(0xC8, 0xB3, 0x77);
+constexpr SkColor kDarkFrom = SkColorSetRGB(0x21, 0x26, 0x3A);
+constexpr SkColor kDarkTo = SkColorSetRGB(0x31, 0x24, 0x3A);
+
+}  // namespace
+
+SteddingWindowBackground::SteddingWindowBackground() = default;
+SteddingWindowBackground::~SteddingWindowBackground() = default;
+
+void SteddingWindowBackground::Paint(gfx::Canvas* canvas,
+                                     views::View* view) const {
+  const gfx::Rect bounds = view->GetLocalBounds();
+  const ui::NativeTheme* const theme = view->GetNativeTheme();
+  const bool dark =
+      theme && theme->preferred_color_scheme() ==
+                   ui::NativeTheme::PreferredColorScheme::kDark;
+  if (!dark) {
+    canvas->DrawColor(kLight);
+    return;
+  }
+
+  const SkPoint points[2] = {
+      SkPoint::Make(bounds.x(), bounds.y()),
+      SkPoint::Make(bounds.right(), bounds.bottom()),
+  };
+  const SkColor4f colors[2] = {SkColor4f::FromColor(kDarkFrom),
+                               SkColor4f::FromColor(kDarkTo)};
+  cc::PaintFlags flags;
+  flags.setShader(cc::PaintShader::MakeLinearGradient(points, colors, nullptr,
+                                                      2, SkTileMode::kClamp));
+  canvas->DrawRect(gfx::RectF(bounds), flags);
+}
+
+}  // namespace stedding
