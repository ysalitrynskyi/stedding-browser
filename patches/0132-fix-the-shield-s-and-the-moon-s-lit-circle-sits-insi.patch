@@ -0,0 +1,90 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/stedding_lit_toolbar_button.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/rrect_f.h"
+#include "ui/gfx/geometry/size_f.h"
+#include "ui/views/controls/highlight_path_generator.h"
+
+namespace stedding {
+
+namespace {
+
+// toolbar T60: as wide as an address field chip's hover at most (T42), with
+// room in the row above and below, and even, so it centres on a 26 DIP button
+// on whole pixels. The row's other buttons hover at 26 DIP in a 32 DIP row.
+constexpr float kLitCircleSize = 20;
+
+class LitCirclePathGenerator : public views::HighlightPathGenerator {
+ public:
+  // views::HighlightPathGenerator:
+  std::optional<gfx::RRectF> GetRoundRect(const gfx::RectF& rect) override {
+    gfx::RectF circle = rect;
+    circle.ClampToCenteredSize(gfx::SizeF(kLitCircleSize, kLitCircleSize));
+    return gfx::RRectF(circle, circle.width() / 2);
+  }
+};
+
+}  // namespace
+
+LitToolbarButton::LitToolbarButton(PressedCallback callback)
+    : ToolbarButton(std::move(callback)) {
+  // In place of the row's, which is as tall as the button.
+  views::HighlightPathGenerator::Install(
+      this, std::make_unique<LitCirclePathGenerator>());
+}
+
+LitToolbarButton::~LitToolbarButton() = default;
+
+gfx::Rect LitToolbarButton::GetLitCircleBounds() const {
+  const std::optional<gfx::RRectF> circle =
+      views::HighlightPathGenerator::GetRoundRectForView(this);
+  return circle ? gfx::ToEnclosingRect(circle->rect()) : gfx::Rect();
+}
+
+SkColor LitToolbarButton::GetLitCircleColor() const {
+  // A hover's strength, under the icon: the row's text colour as a state
+  // layer, 1.3:1 from a painted row (toolbar T44), where the ink drop's
+  // active state had a press's, 1.6:1.
+  const ui::ColorProvider* const colours = GetColorProvider();
+  return colours ? colours->GetColor(kColorToolbarInkDropHover)
+                 : SK_ColorTRANSPARENT;
+}
+
+void LitToolbarButton::SetLit(bool lit) {
+  if (lit_ == lit) {
+    return;
+  }
+  lit_ = lit;
+  SchedulePaint();
+}
+
+void LitToolbarButton::OnPaintBackground(gfx::Canvas* canvas) {
+  ToolbarButton::OnPaintBackground(canvas);
+  if (!lit_) {
+    return;
+  }
+  const gfx::RectF circle(GetLitCircleBounds());
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(GetLitCircleColor());
+  canvas->DrawCircle(circle.CenterPoint(), circle.width() / 2, flags);
+}
+
+BEGIN_METADATA(LitToolbarButton)
+END_METADATA
+
+}  // namespace stedding
