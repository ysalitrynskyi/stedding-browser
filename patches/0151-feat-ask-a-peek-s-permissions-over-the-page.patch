+  // Asks for notifications from `page`, with the user's activation, and
+  // waits for the prompt. window.answer holds the answer once it comes.
+  void AskForNotifications(content::WebContents* page) {
+    ASSERT_TRUE(permissions::PermissionRequestManager::FromWebContents(page))
