index 3bdc8e3810e87..fe7932843a7e2 100644
--- a/chrome/browser/ui/archive/closed_folder.cc
+++ b/chrome/browser/ui/archive/closed_folder.cc
@@ -292,4 +292,54 @@ WindowOpenDisposition FolderRestoreDispositionForClick(
              : WindowOpenDisposition::UNKNOWN;
 }
 
+bool NextLaunchReopened(const sessions::tab_restore::Entry& entry) {
+  if (entry.type != sessions::tab_restore::WINDOW) {
+    return false;
+  }
+  for (const std::unique_ptr<sessions::tab_restore::Tab>& tab :
+       static_cast<const sessions::tab_restore::Window&>(entry).tabs) {
+    const auto it = tab->extra_data.find(kArchiveReopensKey);
+    if (it == tab->extra_data.end()) {
+      continue;
+    }
+    if (it->second == kArchiveReopensUnlessAWindowOpens) {
+      // Read from the list's file: the run that recorded it ended before
+      // another window opened, so this launch reopens the window, unless its
+      // first window shows that it did not restore the session, which takes
+      // the mark off (SettleWhatTheLaunchReopened). Recorded in this run: the
+      // window is closed still.
+      return entry.original_id.is_valid();
+    }
+    return true;
+  }
+  return false;
+}
+
+sessions::TabRestoreService::Entries::const_iterator MostRecentClose(
+    const sessions::TabRestoreService::Entries& entries) {
+  return std::ranges::find_if_not(
+      entries, [](const std::unique_ptr<sessions::tab_restore::Entry>& entry) {
+        return NextLaunchReopened(*entry);
+      });
+}
+
+std::vector<sessions::LiveTab*> RestoreMostRecentClose(
+    sessions::TabRestoreService& service,
+    sessions::LiveTabContext* context) {
+  const sessions::TabRestoreService::Entries& entries = service.entries();
+  const auto it = MostRecentClose(entries);
+  if (it == entries.end()) {
+    return {};
+  }
+  // PLAN.md TAB-13: a close made by Close Folder's Tabs comes back whole, as
+  // Recently Closed shows it.
+  if (const std::optional<ClosedFolder> folder = ClosedFolderAt(entries, it)) {
+    return RestoreClosedFolder(service, context, folder->batch,
+                               WindowOpenDisposition::UNKNOWN);
+  }
+  return service
+      .RestoreEntryById(context, (*it)->id, WindowOpenDisposition::UNKNOWN)
+      .value_or(std::vector<sessions::LiveTab*>());
+}
+
 }  // namespace stedding
