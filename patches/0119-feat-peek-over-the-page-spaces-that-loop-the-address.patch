+// sidebar Y47 (GitHub issue 65): the sidebar's width comes back after every
+// restart. The session log is rebuilt from the live windows at startup and
+// every 250 writes, and a restore after a rebuild -- an update's restart, say
+// -- found no width in it and opened the sidebar at Chromium's default. And a
+// window whose log has no width it can read takes the one last set.
+constexpr int kRestoredSidebarWidth = 250;
+constexpr int kLastSetSidebarWidth = 270;
+
+// Writes the session log out now, from the commands it holds.
+void SaveTheSession(Profile* profile) {
+  SessionServiceTestHelper(SessionServiceFactory::GetForProfile(profile))
+      .SaveNow();
+}
+
+IN_PROC_BROWSER_TEST_F(RestoreTest, PRE_PRE_PRE_TheSidebarsWidthComesBack) {
+  tabs::VerticalTabStripStateController* const controller =
+      tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(controller);
+  ASSERT_NE(kRestoredSidebarWidth, controller->GetUncollapsedWidth());
+  controller->SetUncollapsedWidth(kRestoredSidebarWidth);
+}
 
+IN_PROC_BROWSER_TEST_F(RestoreTest, PRE_PRE_TheSidebarsWidthComesBack) {
+  EXPECT_EQ(std::optional<int>(kRestoredSidebarWidth),
+            BrowserInitState::From(browser())
+                ->get_vertical_tabs_initial_uncollapsed_width());
+  EXPECT_EQ(kRestoredSidebarWidth,
+            tabs::VerticalTabStripStateController::From(browser())
+                ->GetUncollapsedWidth());
+  // The log rebuilt from the live window, as at startup or after 250 writes,
+  // with nothing after it changing the width.
+  SessionServiceFactory::GetForProfile(browser()->GetProfile())
+      ->ResetFromCurrentBrowsers();
+  SaveTheSession(browser()->GetProfile());
+}
+
+IN_PROC_BROWSER_TEST_F(RestoreTest, PRE_TheSidebarsWidthComesBack) {
+  EXPECT_EQ(std::optional<int>(kRestoredSidebarWidth),
+            BrowserInitState::From(browser())
+                ->get_vertical_tabs_initial_uncollapsed_width())
+      << "the rebuilt log lost the width";
+  EXPECT_EQ(kRestoredSidebarWidth,
+            tabs::VerticalTabStripStateController::From(browser())
+                ->GetUncollapsedWidth());
+  // The width set last, then a log whose last word on it reads as no width,
+  // as a log written before the rebuild kept it would be.
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      ::prefs::kVerticalTabsUncollapsedWidth, kLastSetSidebarWidth);
+  ASSERT_EQ(kLastSetSidebarWidth,
+            tabs::VerticalTabStripStateController::From(browser())
+                ->GetUncollapsedWidth());
+  SessionServiceFactory::GetForProfile(browser()->GetProfile())
+      ->AddWindowExtraData(
+          browser()->GetSessionID(),
+          tabs::VerticalTabStripStateController::kUncollapsedWidthKey, "");
+  SaveTheSession(browser()->GetProfile());
+}
+
+IN_PROC_BROWSER_TEST_F(RestoreTest, TheSidebarsWidthComesBack) {
+  EXPECT_FALSE(BrowserInitState::From(browser())
+                   ->get_vertical_tabs_initial_uncollapsed_width()
+                   .has_value());
+  EXPECT_EQ(kLastSetSidebarWidth,
+            tabs::VerticalTabStripStateController::From(browser())
+                ->GetUncollapsedWidth())
+      << "a log with no width opened the sidebar at another width than the "
+         "one last set";
+}
