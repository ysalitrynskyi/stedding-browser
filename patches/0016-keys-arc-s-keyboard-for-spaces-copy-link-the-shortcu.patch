diff --git a/chrome/browser/ui/webui/settings/stedding_shortcuts_handler.cc b/chrome/browser/ui/webui/settings/stedding_shortcuts_handler.cc
new file mode 100644
index 0000000000000..c5b56133b2c11
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/stedding_shortcuts_handler.cc
@@ -0,0 +1,214 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/stedding_shortcuts_handler.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
+#include "chrome/browser/ui/views/peek/peek_accelerators.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace stedding {
+
+namespace {
+
+// The chord the menu bar prints for `command`, or empty when nothing binds it.
+std::u16string ChordFor(int command) {
+  ui::Accelerator accelerator;
+  return GetDefaultMacAcceleratorForCommandId(command, &accelerator)
+             ? accelerator.GetShortcutText()
+             : std::u16string();
+}
+
+// The chord the not-in-main-menu table binds to `command` on `mac_key_code`
+// (a kVK_ code). ChordFor prefers the menu's binding, so a command with a
+// second, table-only chord -- Next tab is ⇧⌘] in the menu and ⌥⌘↓ in the
+// table -- names the menu one; the divergence rows are about the table one.
+// The table keys on Carbon's virtual key codes; the two arrows this reference
+// needs, so the Carbon umbrella (Objective-C headers) stays out of this C++
+// file.
+constexpr int kMacKeyDownArrow = 0x7D;  // kVK_DownArrow
+constexpr int kMacKeyUpArrow = 0x7E;    // kVK_UpArrow
+
+std::u16string TableChordFor(int command,
+                             int mac_key_code,
+                             ui::KeyboardCode key_code) {
+  for (const KeyboardShortcutData& data : GetShortcutsNotPresentInMainMenu()) {
+    if (data.chrome_command != command || data.vkey_code != mac_key_code) {
+      continue;
+    }
+    int modifiers = ui::EF_NONE;
+    if (data.command_key) {
+      modifiers |= ui::EF_COMMAND_DOWN;
+    }
+    if (data.shift_key) {
+      modifiers |= ui::EF_SHIFT_DOWN;
+    }
+    if (data.cntrl_key) {
+      modifiers |= ui::EF_CONTROL_DOWN;
+    }
+    if (data.opt_key) {
+      modifiers |= ui::EF_ALT_DOWN;
+    }
+    return ui::Accelerator(key_code, modifiers).GetShortcutText();
+  }
+  return std::u16string();
+}
+
+// A row for `command`, dropped when it has no chord: the reference lists what
+// the binary binds, not what a document says it should.
+void Add(ShortcutGroup& group,
+         int command,
+         std::u16string what,
+         std::u16string chromium = std::u16string()) {
+  std::u16string chord = ChordFor(command);
+  if (!chord.empty()) {
+    group.rows.push_back(
+        {std::move(chord), std::move(what), std::move(chromium)});
+  }
+}
+
+void AddChord(ShortcutGroup& group,
+              std::u16string chord,
+              std::u16string what,
+              std::u16string chromium = std::u16string()) {
+  if (!chord.empty()) {
+    group.rows.push_back(
+        {std::move(chord), std::move(what), std::move(chromium)});
+  }
+}
+
+// "⌃1 – ⌃9": one row for the nine Space keys.
+std::u16string SpaceRange() {
+  const std::u16string first = ChordFor(IDC_STEDDING_SPACE_1);
+  const std::u16string last = ChordFor(IDC_STEDDING_SPACE_9);
+  return first.empty() || last.empty() ? std::u16string()
+                                       : base::StrCat({first, u" – ", last});
+}
+
+}  // namespace
+
+std::vector<ShortcutGroup> ShortcutReference() {
+  std::vector<ShortcutGroup> groups;
+
+  ShortcutGroup& sidebar = groups.emplace_back();
+  sidebar.title = u"Sidebar and Spaces";
+  Add(sidebar, IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+      u"Collapse the sidebar to icons, or bring it back");
+  AddChord(sidebar, SpaceRange(), u"Jump to Space 1 to 9");
+  Add(sidebar, IDC_STEDDING_SPACE_NEXT, u"Next Space");
+  Add(sidebar, IDC_STEDDING_SPACE_PREVIOUS, u"Previous Space");
+  Add(sidebar, IDC_STEDDING_TOGGLE_SPACE_PIN,
+      u"Pin the tab in its Space, or unpin it");
+  Add(sidebar, IDC_STEDDING_CLEAR_SPACE,
+      u"Clear: close the Space’s unpinned tabs");
+  Add(sidebar, IDC_STEDDING_MOVE_TAB_TO_NEXT_SPACE,
+      u"Move the tab to the next Space");
+  Add(sidebar, IDC_STEDDING_MOVE_TAB_TO_PREVIOUS_SPACE,
+      u"Move the tab to the previous Space");
+
+  ShortcutGroup& tabs = groups.emplace_back();
+  tabs.title = u"Tabs and the bar";
+  Add(tabs, IDC_NEW_TAB, u"Open the bar: search, a URL, or any open tab");
+  Add(tabs, IDC_SELECT_NEXT_TAB, u"Next tab");
+  Add(tabs, IDC_SELECT_PREVIOUS_TAB, u"Previous tab");
+  AddChord(tabs,
+           TableChordFor(IDC_SELECT_NEXT_TAB, kMacKeyDownArrow, ui::VKEY_DOWN),
+           u"Next tab, down the sidebar");
+  AddChord(tabs,
+           TableChordFor(IDC_SELECT_PREVIOUS_TAB, kMacKeyUpArrow, ui::VKEY_UP),
+           u"Previous tab, up the sidebar");
+  Add(tabs, IDC_NEW_SPLIT_TAB, u"Split the current tab with a new one");
+  AddChord(tabs, PeekPromoteAccelerator().GetShortcutText(),
+           u"Turn a peek into a tab");
+  AddChord(tabs, PeekSplitAccelerator().GetShortcutText(),
+           u"Turn a peek into a split");
+
+  ShortcutGroup& page = groups.emplace_back();
+  page.title = u"Page";
+  Add(page, IDC_COPY_URL, u"Copy the link, without its tracking parameters");
+  Add(page, IDC_STEDDING_COPY_MARKDOWN_LINK, u"Copy the link as Markdown");
+  Add(page, IDC_STEDDING_CAPTURE_VISIBLE, u"Screenshot the page as shown");
+  Add(page, IDC_STEDDING_CAPTURE_REGION, u"Screenshot a region you drag out");
+  Add(page, IDC_STEDDING_CAPTURE_FULL_PAGE, u"Screenshot the whole document");
+
+  // Z2: every Chromium chord Stedding rebinds, with both bindings.
+  ShortcutGroup& diverges = groups.emplace_back();
+  diverges.title = u"Where Stedding differs from Chromium";
+  Add(diverges, IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+      u"Collapse or expand the sidebar", u"Save Page As…");
+  Add(diverges, IDC_SAVE_PAGE, u"Save Page As…", u"unbound");
+  Add(diverges, IDC_STEDDING_TOGGLE_SPACE_PIN, u"Pin the tab in its Space",
+      u"Bookmark This Tab… (keeps its menu row, loses the key)");
+  AddChord(diverges, u"⇧⌘D", u"unbound",
+           u"Bookmark All Tabs… (keeps its menu row)");
+  Add(diverges, IDC_COPY_URL, u"Copy the link",
+      u"Inspect Elements, as a second chord (⌥⌘C stays)");
+  AddChord(diverges,
+           TableChordFor(IDC_SELECT_NEXT_TAB, kMacKeyDownArrow, ui::VKEY_DOWN),
+           u"Next tab", u"Focus the next pane (now F6)");
+  AddChord(diverges,
+           TableChordFor(IDC_SELECT_PREVIOUS_TAB, kMacKeyUpArrow, ui::VKEY_UP),
+           u"Previous tab", u"Focus the previous pane (now ⇧F6)");
+  Add(diverges, IDC_STEDDING_SPACE_NEXT, u"Next Space", u"Next tab");
+  Add(diverges, IDC_STEDDING_SPACE_PREVIOUS, u"Previous Space",
+      u"Previous tab");
+  Add(diverges, IDC_STEDDING_CLEAR_SPACE, u"Clear the Space", u"unbound");
+
+  // Z3: the collision with Mission Control.
+  ShortcutGroup& notes = groups.emplace_back();
+  notes.title = u"Notes";
+  AddChord(notes, SpaceRange(),
+           u"macOS Mission Control takes these for “Switch to Desktop "
+           u"N” once a second desktop exists; the Spaces menu keeps "
+           u"the commands reachable, and nothing is remapped in this round.");
+  return groups;
+}
+
+base::ListValue ShortcutReferenceAsValue(
+    const std::vector<ShortcutGroup>& groups) {
+  base::ListValue list;
+  for (const ShortcutGroup& group : groups) {
+    base::ListValue rows;
+    for (const ShortcutRow& row : group.rows) {
+      base::DictValue entry;
+      entry.Set("chord", row.chord);
+      entry.Set("what", row.what);
+      entry.Set("chromium", row.chromium);
+      rows.Append(std::move(entry));
+    }
+    base::DictValue entry;
+    entry.Set("title", group.title);
+    entry.Set("rows", std::move(rows));
+    list.Append(std::move(entry));
+  }
+  return list;
+}
+
+}  // namespace stedding
+
+SteddingShortcutsHandler::SteddingShortcutsHandler() = default;
+SteddingShortcutsHandler::~SteddingShortcutsHandler() = default;
+
+void SteddingShortcutsHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "steddingGetShortcuts",
+      base::BindRepeating(&SteddingShortcutsHandler::HandleGetShortcuts,
+                          base::Unretained(this)));
+}
+
+void SteddingShortcutsHandler::HandleGetShortcuts(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], stedding::ShortcutReferenceAsValue(
+                                         stedding::ShortcutReference()));
+}
