+// Sf49-Sf51, Sf12, Sf17: the whole loop. This computer's file goes up under
+// the folder's name, another computer's comes down, and an unchanged file is
+// not read twice. The sign-in stays out of everything but the sealed pref.
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceTest, TheWholeLoop) {
+  place_->PutFile(PeerName(), PeerFile(1));
+  Join();
+  EXPECT_TRUE(service()->GetStatus().FindString("place"));
+  EXPECT_NE(*service()->GetStatus().FindString("folder"),
+            sb::PlaceBridge::MirrorFor(browser()->GetProfile()->GetPath())
+                .AsUTF8Unsafe());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return LedgerHasSpaceNamed("Peer Space"); }));
+
+  // What went up is a whole sidebar in the format, by this install.
+  const sb::ParsedFile own = sb::ParseSyncFile(place_->Files()[OwnName()]);
+  EXPECT_EQ(own.status, sb::ParseStatus::kOk);
+  EXPECT_EQ(own.meta.device, "This one");
+
+  // Sf51: nothing changed, nothing is read.
+  Scan();
+  place_->ResetCounts();
+  Scan();
+  EXPECT_EQ(place_->Count("GET"), 0);
+
+  // Another computer renames its Space.
+  place_->PutFile(PeerName(), PeerFile(2, "Renamed Elsewhere"));
+  Scan();
+  EXPECT_TRUE(LedgerHasSpaceNamed("Renamed Elsewhere"));
+  EXPECT_EQ(place_->Count("GET"), 1);
+
+  // Sf55.
+  const std::string sealed =
+      prefs()->GetString(stedding::prefs::kSidebarSyncPlaceSignIn);
+  EXPECT_FALSE(sealed.empty());
+  EXPECT_EQ(sealed.find(FakePlace::kSecret), std::string::npos);
+  EXPECT_EQ(place_->Files()[OwnName()].find(FakePlace::kSecret),
+            std::string::npos);
+  std::string place_prefs;
+  base::JSONWriter::Write(prefs()->GetDict(stedding::prefs::kSidebarSyncPlace),
+                          &place_prefs);
+  EXPECT_EQ(place_prefs.find(FakePlace::kSecret), std::string::npos);
+  EXPECT_EQ(place_prefs.find(FakePlace::kUser), std::string::npos);
+  const std::string status_text = [&] {
+    std::string text;
+    base::JSONWriter::Write(service()->GetStatus(), &text);
+    return text;
+  }();
+  EXPECT_EQ(status_text.find(FakePlace::kSecret), std::string::npos);
+  EXPECT_EQ(status_text.find(FakePlace::kUser), std::string::npos);
+
+  // Sf56.
+  for (const std::string& header : place_->SeenHeaders()) {
+    EXPECT_FALSE(base::StartsWith(header, "cookie:")) << header;
+    EXPECT_FALSE(base::StartsWith(header, "referer:")) << header;
+    EXPECT_FALSE(base::StartsWith(header, "origin:")) << header;
+  }
+}
