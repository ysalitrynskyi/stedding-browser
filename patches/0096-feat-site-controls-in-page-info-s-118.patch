+  const auto find_view = [](views::View* root, ui::ElementIdentifier id) {
+    std::vector<views::View*> stack = {root};
+    while (!stack.empty()) {
+      views::View* const view = stack.back();
+      stack.pop_back();
+      if (!view) {
+        continue;
+      }
+      if (view->GetProperty(views::kElementIdentifierKey) == id) {
+        return view;
+      }
+      for (views::View* child : view->children()) {
+        stack.push_back(child);
+      }
+    }
+    return static_cast<views::View*>(nullptr);
+  };
+  const auto text_under = [](views::View* root) {
+    std::u16string text;
+    std::vector<views::View*> stack = {root};
+    while (!stack.empty()) {
+      views::View* const view = stack.back();
+      stack.pop_back();
+      if (auto* const label = views::AsViewClass<views::Label>(view)) {
+        text += std::u16string(label->GetText()) + u"\n";
+      }
+      if (auto* const styled = views::AsViewClass<views::StyledLabel>(view)) {
+        text += std::u16string(styled->GetText()) + u"\n";
+      }
+      for (views::View* child : view->children()) {
+        stack.push_back(child);
+      }
+    }
