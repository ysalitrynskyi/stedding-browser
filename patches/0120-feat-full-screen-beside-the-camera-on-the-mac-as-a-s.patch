+  // A row shorter than this is the row hidden (toolbar T8): the lights then
+  // keep the title bar's own strip, which shows only with the menu bar, as
+  // before.
+  constexpr int kMinRowHeight = 20;
+  const bool want = overlay_in_titlebar_ && initialized_ &&
+                    last_used_style_ == mojom::ToolbarVisibilityStyle::kAlways &&
+                    overlay_height_ >= kMinRowHeight;
+  if (want == overlay_is_in_titlebar_) {
+    return;
+  }
+  overlay_is_in_titlebar_ = want;
+  ImmersiveModeTitlebarViewController* const controller =
+      immersive_mode_titlebar_view_controller_;
+  const bool attached = [browser_window_.titlebarAccessoryViewControllers
+      containsObject:controller];
+  if (attached) {
+    [controller removeFromParentViewController];
