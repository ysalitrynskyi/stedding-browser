+// Every pointer move, exit and touch in the window, the page's among them.
+class WindowCornerButtons::Watcher : public ui::EventObserver {
+ public:
+  explicit Watcher(WindowCornerButtons* corner) : corner_(corner) {}
+  ~Watcher() override = default;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override {
+    if (event.IsLocatedEvent()) {
+      corner_->OnPointerAt(event.AsLocatedEvent()->root_location_f());
+    }
+  }
+
+ private:
+  const raw_ptr<WindowCornerButtons> corner_;
+};
+
+WindowCornerButtons::WindowCornerButtons(BrowserWindowInterface* browser) {
+  // Over the page, which is drawn in a layer of its own.
+  SetPaintToLayer();
+  layer()->SetFillsBoundsOpaquely(false);
+  SetNotifyEnterExitOnChild(true);
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+  // Less room toward the window's edges than toward the page.
+  SetBorder(views::CreateEmptyBorder(
+      gfx::Insets::TLBR(kPadding / 2, kPadding, kPadding, kPadding / 2)));
+  buttons_ = AddChildView(std::make_unique<SidebarWindowButtons>(browser));
+  buttons_->SetRevealed(true);
+  SetVisible(false);
+}
+
+WindowCornerButtons::~WindowCornerButtons() = default;
+
+gfx::Size WindowCornerButtons::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  return buttons_->GetPreferredSize() +
+         gfx::Size(GetInsets().width(), GetInsets().height());
+}
+
+void WindowCornerButtons::Place(bool wanted) {
+  wanted_ = wanted;
+  if (parent()) {
+    const gfx::Size size = GetPreferredSize();
+    // At the trailing corner: views mirrors these bounds in RTL.
+    SetBoundsRect(gfx::Rect(std::max(0, parent()->width() - size.width()), 0,
+                            size.width(), size.height()));
+  }
+  if (!wanted_) {
+    SetRevealed(false);
+  }
+}
+
+bool WindowCornerButtons::InCorner(const gfx::Point& point) const {
+  return wanted_ && GetMirroredBounds().Contains(point);
+}
+
+void WindowCornerButtons::OnPointerAt(const gfx::PointF& root_location) {
+  if (!wanted_ || !parent() || !GetWidget()) {
+    return;
+  }
+  gfx::Point point = gfx::ToFlooredPoint(root_location);
+  views::View::ConvertPointFromWidget(parent(), &point);
+  SetRevealed(InCorner(point));
+}
+
+void WindowCornerButtons::OnMouseExited(const ui::MouseEvent& event) {
+  SetRevealed(false);
+}
+
+void WindowCornerButtons::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  UpdateGround();
+}
+
+void WindowCornerButtons::AddedToWidget() {
+  views::View::AddedToWidget();
+  if (GetWidget()->GetNativeWindow()) {
+    watcher_ = std::make_unique<Watcher>(this);
+    monitor_ = views::EventMonitor::CreateWindowMonitor(
+        watcher_.get(), GetWidget()->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMouseExited,
+         ui::EventType::kTouchPressed});
+  }
+  paint_as_active_subscription_ =
+      GetWidget()->RegisterPaintAsActiveChangedCallback(base::BindRepeating(
+          &WindowCornerButtons::UpdateGround, base::Unretained(this)));
+  UpdateGround();
+}
+
+void WindowCornerButtons::RemovedFromWidget() {
+  monitor_.reset();
+  watcher_.reset();
+  paint_as_active_subscription_ = {};
+  views::View::RemovedFromWidget();
+}
+
+void WindowCornerButtons::SetRevealed(bool revealed) {
+  revealed = revealed && wanted_;
+  if (revealed_ == revealed) {
+    return;
+  }
+  revealed_ = revealed;
+  SetVisible(revealed_);
+}
+
+void WindowCornerButtons::UpdateGround() {
+  if (!GetWidget()) {
+    return;
+  }
+  // The window's own ground, as the sidebar the buttons came from has it,
+  // with the corner toward the page rounded.
+  const bool active = GetWidget()->ShouldPaintAsActive();
+  SetBackground(views::CreateRoundedRectBackground(
+      active ? ui::kColorFrameActive : ui::kColorFrameInactive,
+      base::i18n::IsRTL() ? gfx::RoundedCornersF(0, 0, kRadius, 0)
+                          : gfx::RoundedCornersF(0, 0, 0, kRadius)));
+}
