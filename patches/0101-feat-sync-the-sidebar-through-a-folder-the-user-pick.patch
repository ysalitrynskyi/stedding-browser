+// Sf12, Sf13: the debounces, the activation rescan's floor and the poll
+// while a window is in front.
+constexpr base::TimeDelta kCommitDelay = base::Seconds(2);
+constexpr base::TimeDelta kScanDelay = base::Seconds(2);
+constexpr base::TimeDelta kActivationScanFloor = base::Seconds(5);
+constexpr base::TimeDelta kPollInterval = base::Seconds(10);
+// Sf31: a failed write is tried again twice, then waits for the next change.
+constexpr base::TimeDelta kFirstRetry = base::Seconds(10);
+constexpr base::TimeDelta kSecondRetry = base::Seconds(60);
+
+}  // namespace
+
+// Sf13: FSEvents on the Mac (a recursive watch sees a file rewritten in
+// place, which a kqueue watch of the folder does not), ReadDirectoryChangesW
+// on Windows. Lives on the service's file sequence.
+class FolderWatcher {
+ public:
+  FolderWatcher(const base::FilePath& dir, base::RepeatingClosure changed)
+      : changed_(std::move(changed)) {
+    watching_ = watcher_.Watch(
+        dir, base::FilePathWatcher::Type::kRecursive,
+        base::BindRepeating(&FolderWatcher::OnChange, base::Unretained(this)));
+  }
+  FolderWatcher(const FolderWatcher&) = delete;
+  FolderWatcher& operator=(const FolderWatcher&) = delete;
+  ~FolderWatcher() = default;
+
+  bool watching() const { return watching_; }
+
+ private:
+  void OnChange(const base::FilePath& path, bool error) { changed_.Run(); }
+
+  base::FilePathWatcher watcher_;
+  base::RepeatingClosure changed_;
+  bool watching_ = false;
+};
+
+// Sf18: one registry window's strip and Space model, heard for edits and
+// for the user's removals.
+class WindowWatch : public TabStripModelObserver, public SpaceModel::Observer {
+ public:
+  WindowWatch(SidebarSyncService* service, BrowserWindowInterface* window)
+      : service_(service), strip_(window->GetTabStripModel()) {
+    strip_->AddObserver(this);
+    if (SpaceModel* const model = SpaceModel::From(window)) {
+      model_observation_.Observe(model);
+    }
+  }
+  WindowWatch(const WindowWatch&) = delete;
+  WindowWatch& operator=(const WindowWatch&) = delete;
+  ~WindowWatch() override = default;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* strip,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    if (change.type() == TabStripModelChange::kRemoved) {
+      for (const TabStripModelChange::RemovedTab& removed :
+           change.GetRemove()->contents) {
+        if (removed.remove_reason == TabRemovedReason::kDeleted &&
+            removed.contents) {
+          service_->OnTabRemovedFromStrip(removed.contents, strip);
+        }
+      }
+    }
+    if (selection.active_tab_changed() && selection.new_tab) {
+      service_->OnActiveTabChanged(selection.new_tab);
+    }
+    service_->OnSidebarMaybeChanged();
+  }
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override {
+    if (!tab->IsPinned() && strip_) {
+      service_->OnTabLeftItsRole(tab, strip_);
+    }
+    service_->OnSidebarMaybeChanged();
+  }
+  void WillCloseAllTabs(TabStripModel* strip) override {
+    service_->OnWindowWillCloseAllTabs();
+  }
+  void OnTabStripModelDestroyed(TabStripModel* strip) override {
+    strip_ = nullptr;
+  }
+
+  // SpaceModel::Observer:
+  void OnSpaceMetadataChanged(const SpaceId& id) override {
+    service_->OnSidebarMaybeChanged();
+  }
+  void OnTabSpaceChanged(tabs::TabInterface* tab) override {
+    service_->OnSidebarMaybeChanged();
+  }
+  void OnTabSpacePinChanged(tabs::TabInterface* tab, bool pinned) override {
+    if (!pinned && strip_) {
+      service_->OnTabLeftItsRole(tab, strip_);
+    }
+    service_->OnSidebarMaybeChanged();
+  }
+  void OnFolderSpacePinChanged(const tabs::FolderId& folder,
+                               bool pinned) override {
+    if (!pinned && strip_) {
+      service_->OnFolderLeftTheRun(FolderSyncId(folder), strip_);
+    }
+    service_->OnSidebarMaybeChanged();
+  }
+  void OnSpaceModelDestroying() override { model_observation_.Reset(); }
+
+ private:
+  const raw_ptr<SidebarSyncService> service_;
+  raw_ptr<TabStripModel> strip_;
+  base::ScopedObservation<SpaceModel, SpaceModel::Observer> model_observation_{
+      this};
+};
+
+struct PeerRead {
+  PeerRead() = default;
+  PeerRead(PeerRead&&) = default;
+  PeerRead& operator=(PeerRead&&) = default;
+  ~PeerRead() = default;
+
+  std::string name;
+  std::string install;
+  int64_t mtime_ms = 0;
+  int64_t size = 0;
+  bool placeholder = false;
+  ParsedFile parsed;
+};
+
+struct ScanResult {
+  ScanResult() = default;
+  ScanResult(ScanResult&&) = default;
+  ScanResult& operator=(ScanResult&&) = default;
+  ~ScanResult() = default;
+
+  bool reachable = true;
+  bool denied = false;
+  std::vector<PeerRead> peers;
+  std::vector<std::string> conflict_copies;
+  std::optional<FileMeta> own;
+};
+
+struct JoinScan {
+  enum class Refusal { kNone, kMissing, kUnwritable, kDenied };
+  JoinScan() = default;
+  JoinScan(JoinScan&&) = default;
+  JoinScan& operator=(JoinScan&&) = default;
+  ~JoinScan() = default;
+
+  Refusal refusal = Refusal::kNone;
+  base::FilePath dir;
+  std::vector<PeerRead> peers;
+  std::vector<std::string> conflict_copies;
+  std::optional<FileMeta> own;
+};
+
+namespace {
+
+using StatCache = std::map<std::string, std::pair<int64_t, int64_t>>;
+
+// Sf28, Sf30, Sf33: lists `dir` and reads the files that changed since the
+// last read, parsing each whole. Runs on the file sequence.
+void ReadFolder(const base::FilePath& dir,
+                const std::string& own_install,
+                const StatCache& cache,
+                std::vector<PeerRead>* peers,
+                std::vector<std::string>* conflict_copies,
+                std::optional<FileMeta>* own,
+                bool* denied) {
+  base::FileEnumerator files(dir, /*recursive=*/false,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty();
+       path = files.Next()) {
+    if (base::IsLink(path)) {
+      continue;
+    }
+    const std::string name = path.BaseName().AsUTF8Unsafe();
+    switch (ClassifyFolderEntry(name, own_install)) {
+      case EntryKind::kIgnore:
+        break;
+      case EntryKind::kConflictCopy:
+        conflict_copies->push_back(name);
+        break;
+      case EntryKind::kOwn: {
+        std::string json;
+        if (base::ReadFileToStringWithMaxSize(path, &json, kMaxFileBytes)) {
+          ParsedFile parsed = ParseSyncFile(json);
+          if (parsed.status == ParseStatus::kOk) {
+            *own = parsed.meta;
+          }
+        }
+        break;
+      }
+      case EntryKind::kPeer: {
+        PeerRead read;
+        read.name = name;
+        read.install = InstallOfName(name);
+        base::File::Info info;
+        if (base::GetFileInfo(path, &info)) {
+          read.mtime_ms = info.last_modified.InMillisecondsSinceUnixEpoch();
+          read.size = info.size;
+        }
+        const auto cached = cache.find(read.install);
+        if (cached != cache.end() &&
+            cached->second == std::make_pair(read.mtime_ms, read.size)) {
+          break;
+        }
+        read.placeholder = IsPlaceholderFile(path);
+        std::string json;
+        if (base::ReadFileToStringWithMaxSize(path, &json, kMaxFileBytes)) {
+          read.parsed = ParseSyncFile(json);
+        } else {
+          read.parsed.status = static_cast<size_t>(read.size) > kMaxFileBytes
+                                   ? ParseStatus::kTooLarge
+                                   : ParseStatus::kMalformed;
+        }
+        peers->push_back(std::move(read));
+        break;
+      }
+    }
+  }
+  *denied = files.GetError() == base::File::FILE_ERROR_ACCESS_DENIED;
+}
+
+ScanResult ScanOnSequence(const base::FilePath& dir,
+                          const std::string& own_install,
+                          const StatCache& cache) {
+  ScanResult result;
+  // Sf31: the picked folder itself is gone (an unmounted share): nothing is
+  // made in its place and nothing is deleted.
+  if (!base::DirectoryExists(dir.DirName())) {
+    result.reachable = false;
+    return result;
+  }
+  if (!base::DirectoryExists(dir)) {
+    return result;
+  }
+  ReadFolder(dir, own_install, cache, &result.peers, &result.conflict_copies,
+             &result.own, &result.denied);
+  return result;
+}
+
+JoinScan ScanForJoin(const base::FilePath& picked,
+                     const std::string& own_install) {
+  JoinScan scan;
+  if (!base::DirectoryExists(picked)) {
+    scan.refusal = JoinScan::Refusal::kMissing;
+    return scan;
+  }
+  bool holds_files = false;
+  {
+    base::FileEnumerator names(picked, false, base::FileEnumerator::FILES);
+    for (base::FilePath path = names.Next(); !path.empty();
+         path = names.Next()) {
+      holds_files |= ClassifyFolderEntry(path.BaseName().AsUTF8Unsafe(),
+                                         own_install) != EntryKind::kIgnore;
+    }
+    if (names.GetError() == base::File::FILE_ERROR_ACCESS_DENIED) {
+      scan.refusal = JoinScan::Refusal::kDenied;
+      return scan;
+    }
+  }
+  if (!base::PathIsWritable(picked)) {
+    scan.refusal = JoinScan::Refusal::kUnwritable;
+    return scan;
+  }
+  scan.dir = SyncDirFor(picked, holds_files);
+  if (base::DirectoryExists(scan.dir)) {
+    bool denied = false;
+    ReadFolder(scan.dir, own_install, StatCache(), &scan.peers,
+               &scan.conflict_copies, &scan.own, &denied);
+    if (denied) {
+      scan.refusal = JoinScan::Refusal::kDenied;
+    }
+  }
+  return scan;
+}
+
+// Sf12: this install's file, atomically, in the folder it already is in.
+// Never makes the folder the user picked, only "Stedding Sidebar" in it.
+bool WriteOwnFileOnSequence(const base::FilePath& dir,
+                            const std::string& name,
+                            const std::string& json) {
+  if (!base::DirectoryExists(dir.DirName()) || !base::CreateDirectory(dir)) {
+    return false;
+  }
+  return base::ImportantFileWriter::WriteFileAtomically(dir.AppendASCII(name),
+                                                        json);
+}
+
+base::DictValue Counts(const State& state) {
+  size_t spaces = 0;
+  size_t pins = 0;
+  size_t folders = 0;
+  size_t essentials = 0;
+  for (const auto& [id, record] : state.records) {
+    if (!record.Alive()) {
+      continue;
+    }
+    switch (record.kind) {
+      case Kind::kSpace:
+        ++spaces;
+        break;
+      case Kind::kFolder:
+        ++folders;
+        break;
+      case Kind::kTab: {
+        const std::string& parent = record.Get(kFieldParent);
+        if (parent == kEssentialsList ||
+            (!SpaceOfList(parent).empty() &&
+             parent == OwnEssentialsListOf(SpaceOfList(parent)))) {
+          ++essentials;
+        } else {
+          ++pins;
+        }
+        break;
+      }
+    }
+  }
+  base::DictValue counts;
+  counts.Set("spaces", static_cast<int>(spaces));
+  counts.Set("pins", static_cast<int>(pins));
+  counts.Set("folders", static_cast<int>(folders));
+  counts.Set("essentials", static_cast<int>(essentials));
+  return counts;
+}
