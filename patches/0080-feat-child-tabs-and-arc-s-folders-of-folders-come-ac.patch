+bool SpaceTabVisibilityController::NestsChildTabs() const {
+  const Profile* const profile = tab_strip_model_->profile();
+  return profile &&
+         profile->GetPrefs()->GetBoolean(stedding::prefs::kNestChildTabs);
+}
+
+void SpaceTabVisibilityController::AdoptChildren(
+    const TabStripModelChange& change) {
+  if (!NestsChildTabs()) {
+    return;
+  }
+  TabStripModel& strip = *tab_strip_model_;
+  for (const TabStripModelChange::ContentsWithIndex& inserted :
+       change.GetInsert()->contents) {
+    tabs::TabInterface* const tab = inserted.tab;
+    const int index = tab ? strip.GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    // A tab that comes back (a restore, an undo, a drop from another window)
+    // brings its own place.
+    if (index == TabStripModel::kNoTab ||
+        !stedding::TabParentToken(tab->GetContents()).empty()) {
+      continue;
+    }
+    tabs::TabInterface* const opener = stedding::ParentOfNewTab(strip, index);
+    // pins H1: a Space's pin takes no children, as an essential takes none.
+    if (!opener || (model_ && (model_->IsSpacePinned(opener) ||
+                               model_->IsSpacePinned(tab)))) {
+      continue;
+    }
+    stedding::SetTabParent(tab->GetBrowserWindowInterface(), tab, opener);
+  }
+}
+
+void SpaceTabVisibilityController::ReparentClosedParents(
+    const TabStripModelChange& change) {
+  TabStripModel& strip = *tab_strip_model_;
+  BrowserWindowInterface* browser = nullptr;
+  for (int i = 0; i < strip.count() && !browser; ++i) {
+    browser = strip.GetTabAtIndex(i)->GetBrowserWindowInterface();
+  }
+  if (!browser) {
+    return;
+  }
+  for (const TabStripModelChange::RemovedTab& removed :
+       change.GetRemove()->contents) {
+    // A tab moved to another window keeps its children's places: they stay
+    // its children, at the left in this window (R57).
+    if (removed.remove_reason == TabRemovedReason::kDeleted ||
+        removed.remove_reason == TabRemovedReason::kDeletedAndExpandSidePanel) {
+      stedding::ReparentChildrenOf(browser, removed.contents);
+    }
+  }
+}
+
+void SpaceTabVisibilityController::UpdateNestIndents() {
+  nest_indents_.clear();
+  TabStripModel& strip = *tab_strip_model_;
+  if (strip.closing_all() || !NestsChildTabs()) {
+    return;
+  }
+  // As far in as a folder's rows (folder_view.cc), a level at a time.
+  constexpr int kNestIndent = 14;
+  std::vector<stedding::NestRow> rows;
+  std::vector<const tabs::TabInterface*> row_tabs;
+  for (int i = 0; i < strip.count(); ++i) {
+    const tabs::TabInterface* const tab = strip.GetTabAtIndex(i);
+    // Only rows on screen take part: another Space's tab, or one folded
+    // into a collapsed folder, neither nests nor parts a parent from its
+    // child. An essential, a Space's pin and a split's pane take no place.
+    if (!tab || strip.IsTabPinned(i) || strip.IsTabHidden(i) ||
+        tab->IsSplit() || (model_ && model_->IsSpacePinned(tab))) {
+      continue;
+    }
+    const tabs::TabCollection* const run = tab->GetParentCollection();
+    int folders = 0;
+    for (const tabs::TabCollection* collection = run; collection;
+         collection = collection->GetParentCollection()) {
+      if (collection->type() == tabs::TabCollection::Type::FOLDER) {
+        ++folders;
+      }
+    }
+    const content::WebContents* const contents = tab->GetContents();
+    rows.push_back({stedding::TabToken(contents),
+                    stedding::TabParentToken(contents),
+                    reinterpret_cast<uintptr_t>(run),
+                    stedding::kMaxNestDepth - folders});
+    row_tabs.push_back(tab);
+  }
+  const std::vector<int> depths = stedding::NestDepths(rows);
+  for (size_t i = 0; i < depths.size(); ++i) {
+    if (depths[i] > 0) {
+      nest_indents_[row_tabs[i]] = depths[i] * kNestIndent;
+    }
+  }
+}
