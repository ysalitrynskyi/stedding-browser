+
+void CollectSubpixelLabelsOnClearLayers(views::View* view,
+                                        std::vector<std::string>& out) {
+  if (auto* const label = views::AsViewClass<views::Label>(view);
+      label && label->IsDrawn() && !label->GetText().empty() &&
+      label->GetSubpixelRenderingEnabled() &&
+      IsOpaqueColor(label->GetBackgroundColor()) &&
+      !label->GetSkipSubpixelRenderingOpacityCheck()) {
+    // Label::PaintText's own walk: an opaque background on the way up ends
+    // it, and otherwise the first layer must fill its bounds opaquely.
+    for (const views::View* at = label; at; at = at->parent()) {
+      const views::Background* const background = at->background();
+      const ui::ColorProvider* const colors = at->GetColorProvider();
+      if (background && colors &&
+          IsOpaqueColor(background->color().ResolveToSkColor(colors))) {
+        break;
+      }
+      if (at->layer()) {
+        if (!at->layer()->fills_bounds_opaquely()) {
+          out.push_back(base::StrCat(
+              {label->GetClassName(), " \"",
+               base::UTF16ToUTF8(label->GetText()), "\" on the layer of ",
+               at->GetClassName()}));
+        }
+        break;
+      }
+    }
+  }
+  for (views::View* const child : view->children()) {
+    CollectSubpixelLabelsOnClearLayers(child, out);
+  }
+}
