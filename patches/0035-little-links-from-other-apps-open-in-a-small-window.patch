+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_LITTLE_WINDOW_H_
+#define CHROME_BROWSER_UI_STEDDING_LITTLE_WINDOW_H_
+
+#include <optional>
+
+#include "chrome/browser/ui/spaces/space_id.h"
+
+class BrowserWindowInterface;
+class GURL;
+class PrefService;
+class Profile;
+
+namespace stedding {
+
+// docs/features/little.md: a link from another application opens small, in
+// a popup-type window marked as Stedding's little window; cmd-O sends the
+// page into the last-active normal window's active Space, shift-cmd-O into
+// a split, ctrl-1..9 into Space N, Escape closes it.
+
+// E1, E4: whether `url` opens little -- the setting on, and no route naming
+// a Space (routing D3: a route wins).
+bool ShouldOpenLittle(const PrefService* prefs, const GURL& url);
+
+// E1: opens `url` in a little window over `anchor` (the last-active normal
+// window when null). Returns the window.
+BrowserWindowInterface* OpenLittleWindow(Profile* profile,
+                                         const GURL& url,
+                                         BrowserWindowInterface* anchor);
+
+// Marks `window` as little (a popup opened this way), and asks.
+void MarkLittleWindow(BrowserWindowInterface* window);
+bool IsLittleWindow(const BrowserWindowInterface* window);
+
+// The last-active normal window of `profile`, the one a promotion targets;
+// null when there is none.
+BrowserWindowInterface* LastActiveNormalWindow(Profile* profile);
+
+// E2: moves the little window's page into `target`'s Space `space` (its
+// active Space when nullopt), as a tab or into a split with the active tab,
+// and closes the little window. False when nothing moved.
+bool PromoteLittleWindow(BrowserWindowInterface* little,
+                         BrowserWindowInterface* target,
+                         std::optional<spaces::SpaceId> space,
+                         bool split);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_LITTLE_WINDOW_H_
