+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_NOTIFICATIONS_STEDDING_NOTIFICATION_PARTITION_H_
+#define CONTENT_BROWSER_NOTIFICATIONS_STEDDING_NOTIFICATION_PARTITION_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "content/common/content_export.h"
+#include "content/public/browser/storage_partition_config.h"
+
+namespace content {
+
+class BrowserContext;
+
+// Stedding (BACKLOG S-180): a persistent notification shown from a partition
+// other than the default -- a Space's own jar -- names that partition in its
+// id, so a click on it and its close are dispatched into the partition that
+// holds it and its worker. Its origin maps to the default partition, which
+// holds no such notification, or another one under the same id: each
+// partition's database numbers its own.
+
+// `notification_id`, a persistent notification's, with `partition` named in
+// it between the flags and the first separator: "p@<domain>.<the name in
+// hex>[.m]#<origin>#...". The default partition's ids are left as they are.
+CONTENT_EXPORT std::string NameNotificationPartition(
+    std::string notification_id,
+    const StoragePartitionConfig& partition);
+
+// The partition `notification_id` names, if it names one.
+CONTENT_EXPORT std::optional<StoragePartitionConfig>
+NotificationPartitionFromId(BrowserContext* browser_context,
+                            std::string_view notification_id);
+
+class PlatformNotificationContextImpl;
+
+// Names `partition` as the one `context` writes for, as Initialize() does for
+// a context of a partition other than the default; tests make one without a
+// partition behind it. Defined beside the map it writes, in
+// platform_notification_context_impl.cc.
+CONTENT_EXPORT void SetNotificationContextPartitionForTesting(
+    const PlatformNotificationContextImpl* context,
+    const StoragePartitionConfig& partition);
+
+}  // namespace content
+
+#endif  // CONTENT_BROWSER_NOTIFICATIONS_STEDDING_NOTIFICATION_PARTITION_H_
