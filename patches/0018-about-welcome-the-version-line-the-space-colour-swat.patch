@@ -79,6 +79,28 @@ TEST(SpaceModelTest, RenameAndRecolour) {
   EXPECT_EQ(kBlue, space->color());
 }
 
+// spaces B31: a colour the user chose is remembered as chosen, so the window
+// tints the ground for it even while it is the only Space, and the choice
+// survives a session round trip with the colour.
+TEST(SpaceModelTest, AChosenColourOnALoneSpaceIsRemembered) {
+  SpaceModel written;
+  ASSERT_EQ(1u, written.size());
+  EXPECT_FALSE(written.active_space()->color_chosen());
+  written.SetSpaceColor(written.active_id(), kBlue);
+  EXPECT_TRUE(written.active_space()->color_chosen());
+
+  SpaceModel read;
+  read.RestoreFrom(written.Serialize());
+  ASSERT_EQ(1u, read.size());
+  EXPECT_EQ(kBlue, read.active_space()->color());
+  EXPECT_TRUE(read.active_space()->color_chosen());
+  // A Space nobody coloured stays unchosen through the same trip.
+  SpaceModel plain;
+  SpaceModel plain_read;
+  plain_read.RestoreFrom(plain.Serialize());
+  EXPECT_FALSE(plain_read.active_space()->color_chosen());
+}
