+// Sf15, Sf33 (bug hunt 2026-11-16): Clients into Projects on one computer,
+// Projects into a new folder Work on the other, each within five folders in
+// its own file, nested a folder six deep once merged. This computer's file
+// then held it, and every other computer refused the file whole. The folder
+// past the fifth level goes, with what it holds, to the end of its Space's
+// pinned run, alike on both computers; both moves stand.
+TEST(SidebarSyncFileTest, AFolderTwoComputersNestTooDeepIsLiftedAlike) {
+  const std::string projects = "folder:" + std::string(32, '1');
+  const std::string drafts = "folder:" + std::string(32, '2');
+  const std::string clients = "folder:" + std::string(32, '3');
+  const std::string current = "folder:" + std::string(32, '4');
+  const std::string invoices = "folder:" + std::string(32, '5');
+  const std::string work = "folder:" + std::string(32, '6');
+  const auto folder = [](const std::string& title, const std::string& parent) {
+    LocalItem item;
+    item.kind = Kind::kFolder;
+    item.fields[kFieldTitle] = title;
+    item.fields[kFieldParent] = parent;
+    return item;
+  };
+  // Projects > Drafts, and Clients > Current > Invoices.
+  LocalView base = WorkView();
+  base.items[projects] = folder("Projects", PinsListOf(kWork));
+  base.items[drafts] = folder("Drafts", projects);
+  base.items[clients] = folder("Clients", PinsListOf(kWork));
+  base.items[current] = folder("Current", clients);
+  base.items[invoices] = folder("Invoices", current);
+  base.lists[PinsListOf(kWork)] = {kPinA, kPinB, projects, clients};
+  base.lists[projects] = {drafts};
+  base.lists[clients] = {current};
+  base.lists[current] = {invoices};
+  const State start = StateOf(base, 100, kOffice);
+
+  // Clients into Drafts: Projects > Drafts > Clients > Current > Invoices.
+  LocalView into_drafts = base;
+  into_drafts.items[clients].fields[kFieldParent] = drafts;
+  into_drafts.lists[PinsListOf(kWork)] = {kPinA, kPinB, projects};
+  into_drafts.lists[drafts] = {clients};
+  State office = start;
+  ASSERT_TRUE(
+      RecordLocalEdits(office, &base, into_drafts, {}, Stamp{200, kOffice}));
+  // Projects into a new folder: Work > Projects > Drafts.
+  LocalView wrapped = base;
+  wrapped.items[work] = folder("Work", PinsListOf(kWork));
+  wrapped.items[projects].fields[kFieldParent] = work;
+  wrapped.lists[PinsListOf(kWork)] = {kPinA, kPinB, work, clients};
+  wrapped.lists[work] = {projects};
+  State laptop = start;
+  ASSERT_TRUE(
+      RecordLocalEdits(laptop, &base, wrapped, {}, Stamp{300, kLaptop}));
+  ASSERT_EQ(ParseStatus::kOk,
+            ParseSyncFile(SerializeSyncFile(office, Meta(kOffice))).status);
+  ASSERT_EQ(ParseStatus::kOk,
+            ParseSyncFile(SerializeSyncFile(laptop, Meta(kLaptop))).status);
+
+  // Merged as the service merges: cycles first, then the depth.
+  State on_office = office;
+  MergeState(on_office, laptop);
+  EXPECT_FALSE(BreakFolderCycles(on_office, Stamp{400, kOffice}));
+  EXPECT_TRUE(LiftFoldersNestedTooDeep(on_office, Stamp{400, kOffice}));
+  State on_laptop = laptop;
+  MergeState(on_laptop, office);
+  EXPECT_FALSE(BreakFolderCycles(on_laptop, Stamp{410, kLaptop}));
+  EXPECT_TRUE(LiftFoldersNestedTooDeep(on_laptop, Stamp{410, kLaptop}));
+  for (const State* state : {&on_office, &on_laptop}) {
+    EXPECT_EQ(ParseStatus::kOk,
+              ParseSyncFile(SerializeSyncFile(*state, Meta(kOffice))).status)
+        << "the merged sidebar is a file no computer reads";
+    EXPECT_EQ(PinsListOf(kWork), state->records.at(invoices).Get(kFieldParent))
+        << "the folder six deep stayed where it was";
+    EXPECT_EQ(drafts, state->records.at(clients).Get(kFieldParent));
+    EXPECT_EQ(work, state->records.at(projects).Get(kFieldParent));
+    EXPECT_EQ((std::vector<std::string>{kPinA, kPinB, work, invoices}),
+              state->ChildrenOf(PinsListOf(kWork)));
+    EXPECT_TRUE(state->ChildrenOf(current).empty());
+  }
+
+  // Each reads the other's file and they settle on one sidebar, with nothing
+  // left too deep.
+  State settled_office = on_office;
+  MergeState(settled_office, on_laptop);
+  State settled_laptop = on_laptop;
+  MergeState(settled_laptop, on_office);
+  EXPECT_EQ(settled_office.records, settled_laptop.records);
+  EXPECT_FALSE(LiftFoldersNestedTooDeep(settled_office, Stamp{500, kOffice}));
+}
