+// Dk7: a page that crosses a decision is created with the new one. Chromium
+// recomputes a tab's preferences once a navigation has finished, so a page
+// of a darkened site opened from a browser page (never darkened) was given
+// the browser page's "light" and painted its first frame white. The
+// preferences hold the coming page's decision before it commits, from a
+// browser page to a darkened site and from a darkened site to one kept
+// light; the outgoing page's process and the coming one's both get it.
+IN_PROC_BROWSER_TEST_F(DarkPagesTest,
+                       APageCrossingADecisionIsCreatedWithTheNewOne) {
+  stedding::SetDarkPagesOn(profile(), true);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://version")));
+  ASSERT_FALSE(ForcedDark(page())) << "the premise: a browser page";
+
+  // The preferences at the moment the coming page reports its commit,
+  // before the browser has handled it.
+  const auto at_commit = [&](const GURL& url) -> std::optional<bool> {
+    std::optional<bool> forced_dark;
+    content::CommitMessageDelayer commit(
+        page(), url, base::BindLambdaForTesting([&](content::RenderFrameHost*) {
+          forced_dark = ForcedDark(page());
+        }));
+    page()->GetController().LoadURL(url, content::Referrer(),
+                                    ui::PAGE_TRANSITION_TYPED, std::string());
+    commit.Wait();
+    EXPECT_TRUE(content::WaitForLoadStop(page()));
+    return forced_dark;
+  };
+
+  const GURL dark = Url("a.test");
+  EXPECT_EQ(true, at_commit(dark))
+      << "the coming page was given the browser page's preferences";
+  EXPECT_EQ(dark, page()->GetLastCommittedURL());
+  EXPECT_EQ(kDark, Probe(page()));
+
+  Keep("b.test");
+  const GURL light = Url("b.test");
+  EXPECT_EQ(false, at_commit(light))
+      << "a site kept light was given the darkened page's preferences";
+  EXPECT_EQ(kLight, Probe(page()));
+}
