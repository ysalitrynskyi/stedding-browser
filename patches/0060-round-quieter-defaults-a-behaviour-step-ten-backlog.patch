+namespace {
+
+// Stedding (folders F31): what a folder's child is -- the tab, or the split
+// or nested folder -- so it can be found again after other rows moved.
+const void* RowIdentity(const tabs::Child& child) {
+  if (const auto* tab = std::get_if<tabs::ScopedTab>(&child)) {
+    return tab->get();
+  }
+  return std::get<std::unique_ptr<tabs::TabCollection>>(child).get();
+}
+
+// The first tab of a folder's child, and how many tabs it spans.
+tabs::TabInterface* FirstTabOfRow(const tabs::Child& child) {
+  if (const auto* tab = std::get_if<tabs::ScopedTab>(&child)) {
+    return tab->get();
+  }
+  return std::get<std::unique_ptr<tabs::TabCollection>>(child)
+      ->GetTabAtIndexRecursive(0);
+}
+
+size_t TabCountOfRow(const tabs::Child& child) {
+  if (std::holds_alternative<tabs::ScopedTab>(child)) {
+    return 1;
+  }
+  return std::get<std::unique_ptr<tabs::TabCollection>>(child)
+      ->TabCountRecursive();
+}
+
+}  // namespace
+
+void TabStripModel::ReorderFolder(tabs::FolderTabCollection* folder,
+                                  const std::vector<size_t>& order) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  CHECK(folder);
+  const size_t rows = folder->ChildCount();
+  CHECK_EQ(order.size(), rows);
+  {
+    std::vector<size_t> sorted = order;
+    std::ranges::sort(sorted);
+    for (size_t i = 0; i < rows; ++i) {
+      CHECK_EQ(sorted[i], i);
+    }
+  }
+  std::vector<const void*> wanted;
+  wanted.reserve(rows);
+  for (const size_t from : order) {
+    wanted.push_back(RowIdentity(folder->GetChildren()[from]));
+  }
+  // Slot by slot from the top, the row that belongs in the slot is pulled up
+  // into it, whole and alone: one leftward move of one contiguous run of
+  // tabs, which every observer of the strip reads as an ordinary move.
+  for (size_t i = 0; i < rows; ++i) {
+    const tabs::ChildrenVector& children = folder->GetChildren();
+    size_t j = i;
+    while (j < rows && RowIdentity(children[j]) != wanted[i]) {
+      ++j;
+    }
+    CHECK_LT(j, rows);
+    if (j == i) {
+      continue;
+    }
+    const int first = GetIndexOfTab(FirstTabOfRow(children[j]));
+    const int tab_count = static_cast<int>(TabCountOfRow(children[j]));
+    std::vector<int> block;
+    block.reserve(static_cast<size_t>(tab_count));
+    for (int k = 0; k < tab_count; ++k) {
+      block.push_back(first + k);
+    }
+    const int destination = GetIndexOfTab(FirstTabOfRow(children[i]));
+    MoveTabsWithNotifications(
+        std::move(block), destination,
+        base::BindOnce(&tabs::TabStripCollection::MoveFolderChild,
+                       base::Unretained(contents_data_.get()), folder, j, i));
+  }
+}
