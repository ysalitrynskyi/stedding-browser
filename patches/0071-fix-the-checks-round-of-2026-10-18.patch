+// routing D2, D3, sessions S26 (PLAN.md TST-17): an address another app
+// hands over opens in the Space chosen for links from other apps, and when
+// that Space has a session of its own, the page's first request already
+// carries that Space's cookies: the tab is made in its jar.
+class ExternalOpenJarTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestMonitor(base::BindRepeating(
+        &ExternalOpenJarTest::OnRequest, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // The AppController is the application's delegate.
+    std::ignore = AppController.sharedController;
+  }
+
+  // The server's thread: the Cookie header of the first request for the
+  // address the other app hands over.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    if (request.GetURL().path() != "/from-another-app") {
+      return;
+    }
+    base::AutoLock lock(lock_);
+    if (!cookie_) {
+      const auto cookie = request.headers.find("Cookie");
+      cookie_ = cookie == request.headers.end() ? "" : cookie->second;
+    }
+  }
+
+  std::optional<std::string> FirstCookie() {
+    base::AutoLock lock(lock_);
+    return cookie_;
+  }
+
+ private:
+  base::Lock lock_;
+  std::optional<std::string> cookie_ GUARDED_BY(lock_);
+};
