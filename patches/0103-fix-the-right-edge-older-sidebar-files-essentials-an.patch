+// I1: a list that names itself, or an item named twice, comes across once;
+// before, each level of such a list doubled the tree, to sixteen levels.
+TEST(ArcSidebarImporterTest, AnItemNamedTwiceComesAcrossOnce) {
+  std::string sidebar(kSidebar);
+  constexpr std::string_view kDocs = R"("childrenIds": ["tab-b", "tab-c"])";
+  const size_t at = sidebar.find(kDocs);
+  ASSERT_NE(std::string::npos, at);
+  sidebar.replace(
+      at, kDocs.size(),
+      R"("childrenIds": ["tab-b", "list-docs", "tab-c", "list-docs", "tab-b"])");
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(sidebar);
+  ASSERT_TRUE(plan.has_value());
+  const ArcImportPlan::Space& work = plan->spaces[0];
+  ASSERT_EQ(2u, work.pinned.size());
+  const ArcImportPlan::Node& docs = work.pinned[1];
+  EXPECT_EQ(u"Docs", docs.title);
+  ASSERT_EQ(2u, docs.children.size()) << "the list holds B and C, once each";
+  EXPECT_EQ(u"B", docs.children[0].title);
+  EXPECT_EQ(u"C", docs.children[1].title);
+  EXPECT_EQ(1u, plan->folder_count());
+  EXPECT_EQ(3u, plan->pinned_tab_count());
+}
