diff --git a/chrome/test/stedding/tidy_names_browsertest.cc b/chrome/test/stedding/tidy_names_browsertest.cc
new file mode 100644
index 0000000000000..ac1ad4cd10dc9
--- /dev/null
+++ b/chrome/test/stedding/tidy_names_browsertest.cc
@@ -0,0 +1,192 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/tabs.md R65 and sidebar-panels.md Pn17 (BACKLOG S-398): tidy
+// names, by rules on the device. A pinned tab's row shows its page's title
+// without the site's name, counts and accounts; a downloaded file whose name
+// says nothing is saved under its page's title. Both are off by default.
+
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/strcat.h"
+#include "base/test/run_until.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/browser/download/download_prefs.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "chrome/browser/ui/tab_ui_helper.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/tabs/common/tab_view.h"
+#include "chrome/browser/ui/views/tabs/tab/tab_title.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "components/download/public/common/download_item.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/download_manager.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/download_test_observer.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "net/test/embedded_test_server/http_response.h"
+#include "ui/views/test/views_test_utils.h"
+
+namespace {
+
+// A page whose title has the parts a tidy title drops, and a download whose
+// name says nothing.
+std::unique_ptr<net::test_server::HttpResponse> Serve(
+    const net::test_server::HttpRequest& request) {
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  if (request.relative_url == "/inbox") {
+    response->set_content_type("text/html");
+    response->set_content(
+        "<title>Inbox (3) - you@example.com - Mailbox</title>"
+        "<a href=/download.pdf>Invoice</a>");
+    return response;
+  }
+  if (request.relative_url == "/invoice") {
+    response->set_content_type("text/html");
+    response->set_content(
+        "<title>Invoice 4182 - Billing</title>"
+        "<a id=get href=/download.pdf>Download</a>");
+    return response;
+  }
+  if (request.relative_url == "/download.pdf") {
+    response->set_content_type("application/pdf");
+    response->AddCustomHeader("Content-Disposition",
+                              "attachment; filename=\"download.pdf\"");
+    response->set_content("%PDF-1.4\n%%EOF\n");
+    return response;
+  }
+  return nullptr;
+}
+
+class TidyNamesTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(&Serve));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      ASSERT_TRUE(downloads_.CreateUniqueTempDir());
+    }
+    PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+    prefs->SetBoolean(prefs::kPromptForDownload, false);
+    DownloadPrefs::FromBrowserContext(browser()->GetProfile())
+        ->SetDownloadPath(downloads_.GetPath());
+  }
+
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+
+  // Names `tab` as the row's rename does (tabs R14): the name, then the
+  // tab's UI told of it.
+  void Name(tabs::TabInterface* tab, const std::u16string& name) {
+    stedding::SetTabName(browser(), tab, name);
+    if (TabUIHelper* const helper = TabUIHelper::From(tab)) {
+      helper->TabNameChanged();
+    }
+  }
+
+  // The row of `tab` as the sidebar draws it.
+  std::u16string RowTitle(tabs::TabInterface* tab) {
+    views::Widget* const widget =
+        BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+    views::test::RunScheduledLayout(widget);
+    TabView* const row =
+        stedding::test::FindDrawnRow(widget->GetRootView(), tab);
+    return row ? std::u16string(row->title_for_testing()->GetText())
+               : u"(no row)";
+  }
+
+  // Downloads /download.pdf from the page at `path` and returns the name it
+  // was saved under.
+  base::FilePath Download(const std::string& path) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL(path)));
+    content::DownloadManager* const manager =
+        browser()->GetProfile()->GetDownloadManager();
+    content::DownloadTestObserverTerminal done(
+        manager, 1, content::DownloadTestObserver::ON_DANGEROUS_DOWNLOAD_FAIL);
+    EXPECT_TRUE(content::ExecJs(
+        browser()->tab_strip_model()->GetActiveWebContents(),
+        "document.querySelector('a').click()"));
+    done.WaitForFinished();
+    content::DownloadManager::DownloadVector items;
+    manager->GetAllDownloads(&items);
+    // The list has no order: the newest download has the highest id.
+    download::DownloadItem* newest = nullptr;
+    for (download::DownloadItem* item : items) {
+      if (!newest || item->GetId() > newest->GetId()) {
+        newest = item;
+      }
+    }
+    return newest ? newest->GetTargetFilePath().BaseName() : base::FilePath();
+  }
+
+ private:
+  base::ScopedTempDir downloads_;
+};
+
+// tabs R65: a pinned tab's row tidies its title while the setting is on; a
+// loose tab's does not, and a name the user gave stays.
+IN_PROC_BROWSER_TEST_F(TidyNamesTest, APinnedRowShowsItsTidyTitle) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/inbox")));
+  tabs::TabInterface* const tab = browser()->tab_strip_model()->GetActiveTab();
+  const std::u16string whole = u"Inbox (3) - you@example.com - Mailbox";
+  ASSERT_TRUE(base::test::RunUntil([&] { return RowTitle(tab) == whole; }));
+
+  // Off by default: the pinned row keeps the page's title.
+  spaces::SpaceModel::From(browser())->SetSpacePinned(tab, true);
+  EXPECT_EQ(whole, RowTitle(tab));
+
+  prefs()->SetBoolean(stedding::prefs::kTabsTidyTitles, true);
+  EXPECT_TRUE(base::test::RunUntil([&] { return RowTitle(tab) == u"Inbox"; }))
+      << RowTitle(tab);
+  // The page and its tab keep the whole title.
+  EXPECT_EQ(whole, tab->GetContents()->GetTitle());
+
+  // A name the user gave wins.
+  Name(tab, u"Support mail");
+  EXPECT_TRUE(
+      base::test::RunUntil([&] { return RowTitle(tab) == u"Support mail"; }))
+      << RowTitle(tab);
+  Name(tab, std::u16string());
+
+  // Unpinned, the row shows the whole title again.
+  spaces::SpaceModel::From(browser())->SetSpacePinned(tab, false);
+  EXPECT_TRUE(base::test::RunUntil([&] { return RowTitle(tab) == whole; }))
+      << RowTitle(tab);
+
+  // Turning the setting off puts the whole title back on a pinned row.
+  spaces::SpaceModel::From(browser())->SetSpacePinned(tab, true);
+  ASSERT_TRUE(base::test::RunUntil([&] { return RowTitle(tab) == u"Inbox"; }));
+  prefs()->SetBoolean(stedding::prefs::kTabsTidyTitles, false);
+  EXPECT_TRUE(base::test::RunUntil([&] { return RowTitle(tab) == whole; }))
+      << RowTitle(tab);
+}
+
+// sidebar-panels Pn17: "download.pdf" from a page titled "Invoice 4182 -
+// Billing" is saved as "Invoice 4182.pdf" while the setting is on, and keeps
+// its name while it is off.
+IN_PROC_BROWSER_TEST_F(TidyNamesTest, ADownloadIsSavedUnderItsPagesTitle) {
+  EXPECT_EQ(base::FilePath::FromASCII("download.pdf"), Download("/invoice"));
+  prefs()->SetBoolean(stedding::prefs::kDownloadsTidyNames, true);
+  EXPECT_EQ(base::FilePath::FromASCII("Invoice 4182.pdf"),
+            Download("/invoice"));
+}
+
+}  // namespace
