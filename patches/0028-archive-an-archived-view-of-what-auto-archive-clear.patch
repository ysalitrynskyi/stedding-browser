@@ -0,0 +1,145 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/stedding_archive/stedding_archive_handler.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/tab_restore_service_factory.h"
+#include "chrome/browser/ui/archive/archived_tabs.h"
+#include "chrome/browser/ui/browser_live_tab_context.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+
+namespace stedding {
+
+ArchiveHandler::ArchiveHandler() = default;
+ArchiveHandler::~ArchiveHandler() = default;
+
+void ArchiveHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getArchivedTabs",
+      base::BindRepeating(&ArchiveHandler::HandleGetArchivedTabs,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "restoreArchivedTab",
+      base::BindRepeating(&ArchiveHandler::HandleRestoreArchivedTab,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "removeArchivedTab",
+      base::BindRepeating(&ArchiveHandler::HandleRemoveArchivedTab,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "clearArchive", base::BindRepeating(&ArchiveHandler::HandleClearArchive,
+                                          base::Unretained(this)));
+}
+
+void ArchiveHandler::OnJavascriptAllowed() {
+  if (sessions::TabRestoreService* const service = GetService()) {
+    observation_.Observe(service);
+  }
+}
+
+void ArchiveHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+}
+
+void ArchiveHandler::TabRestoreServiceChanged(
+    sessions::TabRestoreService* service) {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("archive-changed", Snapshot());
+  }
+}
+
+void ArchiveHandler::TabRestoreServiceDestroyed(
+    sessions::TabRestoreService* service) {
+  observation_.Reset();
+}
+
+BrowserWindowInterface* ArchiveHandler::GetBrowser() {
+  return GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+      web_ui()->GetWebContents());
+}
+
+sessions::TabRestoreService* ArchiveHandler::GetService() {
+  return TabRestoreServiceFactory::GetForProfile(Profile::FromWebUI(web_ui()));
+}
+
+base::DictValue ArchiveHandler::Snapshot() {
+  base::DictValue snapshot;
+  base::ListValue tabs;
+  if (sessions::TabRestoreService* const service = GetService()) {
+    for (const ArchivedTab& tab : ListArchivedTabs(
+             service->entries(), base::Time::Now(),
+             ArchiveRetention(Profile::FromWebUI(web_ui())->GetPrefs()))) {
+      tabs.Append(ArchivedTabToValue(tab));
+    }
+  }
+  snapshot.Set("tabs", std::move(tabs));
+  base::ListValue spaces;
+  BrowserWindowInterface* const browser = GetBrowser();
+  if (spaces::SpaceModel* const model =
+          browser ? spaces::SpaceModel::From(browser) : nullptr) {
+    for (const std::unique_ptr<spaces::Space>& space : model->spaces()) {
+      base::DictValue entry;
+      entry.Set("id", space->id().ToString());
+      entry.Set("name", model->DisplayName(space->id()));
+      spaces.Append(std::move(entry));
+    }
+  }
+  snapshot.Set("spaces", std::move(spaces));
+  return snapshot;
+}
+
+void ArchiveHandler::HandleGetArchivedTabs(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  ResolveJavascriptCallback(base::Value(args[0].GetString()), Snapshot());
+}
+
+void ArchiveHandler::HandleRestoreArchivedTab(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  int32_t raw = 0;
+  if (!base::StringToInt(args[0].GetString(), &raw)) {
+    return;
+  }
+  BrowserWindowInterface* const browser = GetBrowser();
+  if (!browser) {
+    return;
+  }
+  RestoreArchivedTab(
+      browser, BrowserLiveTabContext::FindContextWithID(browser->GetSessionID()),
+      GetService(), SessionID::FromSerializedValue(raw));
+}
+
+void ArchiveHandler::HandleRemoveArchivedTab(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  int32_t raw = 0;
+  if (!base::StringToInt(args[0].GetString(), &raw)) {
+    return;
+  }
+  if (sessions::TabRestoreService* const service = GetService()) {
+    service->RemoveEntryById(SessionID::FromSerializedValue(raw));
+  }
+}
+
+void ArchiveHandler::HandleClearArchive(const base::ListValue& args) {
+  AllowJavascript();
+  if (sessions::TabRestoreService* const service = GetService()) {
+    service->ClearEntries();
+  }
+}
+
+}  // namespace stedding
