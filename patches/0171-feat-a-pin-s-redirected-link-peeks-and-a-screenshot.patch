diff --git a/chrome/browser/ui/views/peek/peek_navigation_throttle.cc b/chrome/browser/ui/views/peek/peek_navigation_throttle.cc
index d9dbec25d447c..793d585170ab5 100644
--- a/chrome/browser/ui/views/peek/peek_navigation_throttle.cc
+++ b/chrome/browser/ui/views/peek/peek_navigation_throttle.cc
@@ -289,6 +289,25 @@ PeekNavigationThrottle::~PeekNavigationThrottle() = default;
 
 content::NavigationThrottle::ThrottleCheckResult
 PeekNavigationThrottle::WillStartRequest() {
+  return PeekIfLeavingThePin();
+}
+
+// P22 (BACKLOG S-93, PLAN.md CMD-29): where a server sends the link is judged
+// as the link is, and the peek starts there, so the address that redirected
+// is not asked twice. P16: a sign-in that began in the pin ends in the pin,
+// wherever the steps after it lead.
+content::NavigationThrottle::ThrottleCheckResult
+PeekNavigationThrottle::WillRedirectRequest() {
+  for (const GURL& step : navigation_handle()->GetRedirectChain()) {
+    if (IsSignInAddress(step)) {
+      return PROCEED;
+    }
+  }
+  return PeekIfLeavingThePin();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+PeekNavigationThrottle::PeekIfLeavingThePin() {
   content::NavigationHandle* const handle = navigation_handle();
   tabs::TabInterface* const tab =
       tabs::TabInterface::MaybeGetFromContents(handle->GetWebContents());
diff --git a/chrome/browser/ui/views/peek/peek_navigation_throttle.h b/chrome/browser/ui/views/peek/peek_navigation_throttle.h
index b8dd18c68a3f1..f66337925da9f 100644
--- a/chrome/browser/ui/views/peek/peek_navigation_throttle.h
+++ b/chrome/browser/ui/views/peek/peek_navigation_throttle.h
@@ -104,7 +104,13 @@ class PeekNavigationThrottle : public content::NavigationThrottle {
 
   // content::NavigationThrottle:
   ThrottleCheckResult WillStartRequest() override;
+  ThrottleCheckResult WillRedirectRequest() override;
   const char* GetNameForLogging() override;
+
+ private:
+  // Opens a peek for where the navigation stands, and stops it, when that
+  // leaves the pin (P1, P15, P16, P22).
+  ThrottleCheckResult PeekIfLeavingThePin();
 };
 
 }  // namespace stedding
