+// sidebar -- the window's menu on the top line after Reload, the extensions
+// and their menu and the pinned actions at the end of the address field --
+// and go home to the row when it comes back: the sidebar closed, or the
+// setting off. They are the row's own buttons, so their menus open from where
+// they are.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, TheRowsButtonsFollowTheAddress) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Page("a.test", "/title1.html")));
+  ToolbarView* const toolbar = browser_view()->toolbar();
+  ASSERT_TRUE(toolbar);
+  views::View* const menu = toolbar->app_menu_button_for_testing();
+  views::View* const extensions = toolbar->extensions_container_for_testing();
+  ASSERT_TRUE(menu);
+  views::View* const row = top()->sidebar_toolbar_buttons_for_testing();
+  ASSERT_TRUE(row);
+  EXPECT_EQ(field(), row->parent()) << "the buttons are not the field's";
+  EXPECT_EQ(toolbar, menu->parent()) << "the menu is the row's while it shows";
+  const auto lent = [&]() {
+    return menu->parent() && menu->parent()->parent() == top() &&
+           (!extensions || extensions->parent() == row);
+  };
+  const auto home = [&]() {
+    return menu->parent() == toolbar &&
+           (!extensions || extensions->parent() == toolbar);
+  };
+
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !browser_view()->IsToolbarVisible() && lent();
+  })) << "the buttons stayed in the gone row";
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  EXPECT_TRUE(menu->IsDrawn());
+  EXPECT_FALSE(menu->bounds().IsEmpty());
+  // The menu after Reload, on its line; the extensions inside the field.
+  const gfx::Rect menu_box = menu->GetBoundsInScreen();
+  const gfx::Rect reload_box = nav()->reload()->GetBoundsInScreen();
+  EXPECT_GE(menu_box.x(), reload_box.right()) << "the menu is not after Reload";
+  EXPECT_NEAR(reload_box.CenterPoint().y(), menu_box.CenterPoint().y(), 2);
+  if (extensions && extensions->GetVisible()) {
+    EXPECT_TRUE(field()->GetBoundsInScreen().Contains(
+        extensions->GetBoundsInScreen().CenterPoint()))
+        << "the extensions are not in the field";
+  }
+  EXPECT_FALSE(top()->IsPositionInWindowCaption(
+      views::View::ConvertPointToTarget(menu, top(),
+                                        menu->GetLocalBounds().CenterPoint())))
+      << "the menu button is pressed, not dragged by";
+
+  // Closed to the rail: the row is back, and its buttons in it.
+  controller()->RequestCollapse(true);
+  Settle();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return browser_view()->IsToolbarVisible() && home();
+  })) << "the buttons did not come home";
+  controller()->RequestCollapse(false);
+  Settle();
+  EXPECT_TRUE(base::test::RunUntil(lent)) << "nor go back to the sidebar";
+
+  // A localhost page keeps the row (toolbar T11), and so its buttons.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("localhost", "/title2.html")));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return browser_view()->IsToolbarVisible() && home();
+  }));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Page("a.test", "/title1.html")));
+  EXPECT_TRUE(base::test::RunUntil(lent));
+
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, false);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return browser_view()->IsToolbarVisible() && home();
+  }));
+  EXPECT_TRUE(row->children().empty());
+}
