+// user has moved or resized it. `closing` at the last save.
+gfx::Rect LittleWindowBoundsToSave(BrowserWindowInterface* window,
+                                   const gfx::Rect& measured,
+                                   bool closing);
+
 // E1: `window` has been placed at `size` (its view, at every save of its
 // placement; `closing` at the last one). A little window OpenLittleWindow
 // opened that the user has resized hands its size to the next one. The
diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
index a19391aaba266..7d4c50a3d7754 100644
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -4350,7 +4350,16 @@ void BrowserView::SaveWindowPlacement(const gfx::Rect& bounds,
                                GetWidget()->IsClosed());
   WidgetDelegate::SaveWindowPlacement(bounds, show_state);
   gfx::Rect saved_bounds = bounds;
-  if (chrome::SavedBoundsAreContentBounds(browser_.get())) {
+  // Stedding little E12 (BACKLOG S-456): a little window keeps its window's
+  // bounds, not its page's. A popup's restore adds the frame to its page's
+  // size, and on Windows at 150% that came back 8 by 20 DIP bigger at every
+  // launch; session restore gives a little window its bounds once it is
+  // made. They are the bounds it was given while it measures within a DIP of
+  // them, or a DIP of rounding grew it at every launch.
+  if (stedding::IsLittleWindow(browser_.get())) {
+    saved_bounds = stedding::LittleWindowBoundsToSave(
+        browser_.get(), bounds, GetWidget()->IsClosed());
+  } else if (chrome::SavedBoundsAreContentBounds(browser_.get())) {
     // Invert the transformation done in GetSavedWindowPlacement().
     gfx::Size client_size = GetFrameView()->GetBoundsForClientView().size();
     if (IsToolbarVisible()) {
diff --git a/chrome/test/stedding/little_window_browsertest.cc b/chrome/test/stedding/little_window_browsertest.cc
index 1a86c815dae05..83d822684808d 100644
--- a/chrome/test/stedding/little_window_browsertest.cc
+++ b/chrome/test/stedding/little_window_browsertest.cc
@@ -751,10 +751,43 @@ class LittleWindowRestoreTest : public InProcessBrowserTest {
     SessionStartupPref::SetStartupPref(
         browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
   }
+
+  void ExpectALittleWindowCameBack() {
+    BrowserWindowInterface* popup = nullptr;
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      for (BrowserWindowInterface* const window :
+           GetAllBrowserWindowInterfaces()) {
+        if (window->GetType() == BrowserWindowInterface::TYPE_POPUP) {
+          popup = window;
+        }
+      }
+      return popup != nullptr;
+    })) << "the little window did not come back";
+    EXPECT_TRUE(stedding::IsLittleWindow(popup))
+        << "it came back as a plain popup";
+    const PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+    const gfx::Size was(prefs->GetInteger(stedding::prefs::kLittleWidth),
+                        prefs->GetInteger(stedding::prefs::kLittleHeight));
+    const gfx::Size is = popup->GetWindow()->GetBounds().size();
+    // little E12 (BACKLOG S-456): within a DIP. At a fractional scale
+    // (Windows at 150%) the window's bounds and the placement its session
+    // keeps are each rounded from pixels, and can be a DIP apart; a restored
+    // window a frame bigger, as on Windows before, is 8 by 20 DIP.
+    EXPECT_LE(std::abs(was.width() - is.width()), 1)
+        << "it came back at another size: " << is.ToString() << ", not "
+        << was.ToString();
+    EXPECT_LE(std::abs(was.height() - is.height()), 1)
+        << "it came back at another size: " << is.ToString() << ", not "
+        << was.ToString();
+    EXPECT_EQ(embedded_test_server()->GetURL("/title1.html").path(),
+              popup->GetTabStripModel()->GetActiveWebContents()
+                  ->GetVisibleURL()
+                  .path());
+  }
 };
 
