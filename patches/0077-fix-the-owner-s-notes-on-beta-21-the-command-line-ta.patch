+
+// toolbar T41: the other pane's page replaced -- a discard gives its tab a
+// new page -- is the one watched, whose colour the row's part over it takes.
+// The page that left took the watch with it, and the part stayed the ground
+// until the split changed.
+TEST_F(PageThemeColorControllerTest, AReplacedPanesPageIsWatched) {
+  AddTab(browser(), GURL("https://example.com/"));
+  AddTab(browser(), GURL("https://example.org/"));
+  TabStripModel* const model = browser()->tab_strip_model();
+  SplitTheFirstTwo(model);
+  PageThemeColorController* const controller =
+      PageThemeColorController::From(browser());
+  ASSERT_TRUE(controller);
+  content::WebContents* const other = model->GetWebContentsAt(1);
+  ASSERT_EQ(other, controller->partner());
+
+  std::unique_ptr<content::WebContents> page =
+      content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+  content::WebContents* const replacement = page.get();
+  std::unique_ptr<content::WebContents> left =
+      model->DiscardWebContents(other, std::move(page));
+  left.reset();
+  EXPECT_EQ(replacement, model->GetWebContentsAt(1));
+  EXPECT_EQ(replacement, controller->partner())
+      << "the pane's new page is not watched";
