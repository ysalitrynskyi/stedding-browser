@@ -0,0 +1,54 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_recording.h"
+
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/views/focus/focus_manager.h"
+
+namespace stedding::shortcuts {
+
+ScopedShortcutRecording::ScopedShortcutRecording(
+    content::WebContents* contents) {
+  if (!contents) {
+    return;
+  }
+  views::Widget* const widget =
+      views::Widget::GetTopLevelWidgetForNativeView(contents->GetNativeView());
+  if (!widget) {
+    return;
+  }
+  widget_ = widget;
+  observation_.Observe(widget);
+  if (views::FocusManager* const focus_manager = widget->GetFocusManager()) {
+    was_suspended_ = focus_manager->shortcut_handling_suspended();
+    focus_manager->set_shortcut_handling_suspended(true);
+  }
+  SetRecordingTarget(widget);
+}
+
+ScopedShortcutRecording::~ScopedShortcutRecording() {
+  End();
+}
+
+void ScopedShortcutRecording::OnWidgetDestroying(views::Widget* widget) {
+  End();
+}
+
+void ScopedShortcutRecording::End() {
+  if (!widget_) {
+    return;
+  }
+  if (views::FocusManager* const focus_manager = widget_->GetFocusManager()) {
+    focus_manager->set_shortcut_handling_suspended(was_suspended_);
+  }
+  if (IsRecordingIn(widget_.get())) {
+    SetRecordingTarget(nullptr);
+  }
+  observation_.Reset();
+  widget_ = nullptr;
+}
+
+}  // namespace stedding::shortcuts
diff --git a/chrome/browser/ui/stedding/shortcut_recording.h b/chrome/browser/ui/stedding/shortcut_recording.h
new file mode 100644
index 0000000000000..0fe21239740ef
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_recording.h
@@ -0,0 +1,52 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SHORTCUT_RECORDING_H_
+#define CHROME_BROWSER_UI_STEDDING_SHORTCUT_RECORDING_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace stedding::shortcuts {
+
+// docs/features/shortcuts.md Z19: while it lives, the window that shows
+// `contents` hands every key to the page, the browser's own chords included,
+// so a Shortcuts row can record ⌘T or Ctrl+W. The window's focus manager
+// stops handling shortcuts (Windows and Linux: BrowserView's pre-handling and
+// the accelerators; the Mac's views keys), and on the Mac the command
+// dispatcher leaves the window's key equivalents to the page
+// (chrome_command_dispatcher_delegate.mm). It ends when destroyed or when
+// the window goes; the focus manager gets back the state it had, since
+// chrome://extensions/shortcuts suspends it too.
+class ScopedShortcutRecording : public views::WidgetObserver {
+ public:
+  explicit ScopedShortcutRecording(content::WebContents* contents);
+  ScopedShortcutRecording(const ScopedShortcutRecording&) = delete;
+  ScopedShortcutRecording& operator=(const ScopedShortcutRecording&) = delete;
+  ~ScopedShortcutRecording() override;
+
+  // Whether it holds a window.
+  bool active() const { return widget_ != nullptr; }
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override;
+
+ private:
+  void End();
+
+  raw_ptr<views::Widget> widget_ = nullptr;
+  bool was_suspended_ = false;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{
+      this};
+};
+
+}  // namespace stedding::shortcuts
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SHORTCUT_RECORDING_H_
