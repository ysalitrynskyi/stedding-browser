+// sessions S47: an essential stays with its session, where it is signed in,
+// while another Space is still in it. Otherwise it goes with its Space.
+TEST_F(SharedSessionWindowTest, AnEssentialStaysInItsSessionWhenItsSpaceLeaves) {
+  const SpaceId mail = model().AddSpace("Mail", kBlue)->id();
+  const SpaceId docs = model().AddSpace("Docs", kBlue)->id();
+  const std::string jar = ShareSession(mail, docs);
+  tabs::TabInterface* const own = OpenTabIn(mail);
+  tabs().SetTabPinned(tabs().GetIndexOfTab(own), true);
+  task_environment()->RunUntilIdle();
+  model().SetActiveSpace(docs);
+
+  model().SetSpaceSession(mail, std::string());
+  task_environment()->RunUntilIdle();
+  EXPECT_TRUE(model().IsOwnEssential(own));
+  EXPECT_EQ(docs, model().SpaceForTab(own));
+  EXPECT_EQ(jar, PartitionOf(own).partition_name());
+
+  // Docs is the last in it: the essential goes with Docs to the shared jar,
+  // a pin of that Space (ADR 0028).
+  model().SetSpaceSession(docs, std::string());
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(model().IsOwnEssential(own));
+  EXPECT_TRUE(model().IsSpacePinned(own));
+  EXPECT_FALSE(IsSpaceStoragePartition(PartitionOf(own)));
+}
