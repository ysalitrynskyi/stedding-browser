+  ASSERT_GE(menu->GetItemCount(), 2u);
+  EXPECT_EQ(FolderView::kLiveRefreshCommand, menu->GetCommandIdAt(0));
+  EXPECT_EQ(u"Refresh Pull Requests", menu->GetLabelAt(0));
+  EXPECT_EQ(FolderView::kLiveDeleteCommand, menu->GetCommandIdAt(1));
+  EXPECT_EQ(u"Delete Live Folder", menu->GetLabelAt(1));
