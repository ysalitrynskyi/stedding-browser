@@ -0,0 +1,550 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_editor.h"
+
+#include <algorithm>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/notreached.h"
+#include "base/strings/strcat.h"
+#include "build/build_config.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/stedding/shortcut_chord.h"
+
+namespace stedding::shortcuts {
+
+namespace {
+
+bool Contains(const std::vector<Chord>& chords, const Chord& chord) {
+  return std::ranges::find(chords, chord) != chords.end();
+}
+
+bool Contains(const std::vector<int>& commands, int command) {
+  return std::ranges::find(commands, command) != commands.end();
+}
+
+Chord WithShift(const Chord& chord) {
+  return Chord(chord.key, chord.modifiers | ui::EF_SHIFT_DOWN);
+}
+
+// The chords of an entry's "keys" list that can be read.
+std::vector<Chord> ReadKeys(const base::DictValue& entry) {
+  std::vector<Chord> chords;
+  const base::ListValue* const keys = entry.FindList(kKeysKey);
+  if (!keys) {
+    return chords;
+  }
+  for (const base::Value& key : *keys) {
+    if (!key.is_string()) {
+      continue;
+    }
+    if (std::optional<Chord> chord = ChordFromString(key.GetString());
+        chord && !Contains(chords, *chord)) {
+      chords.push_back(*chord);
+    }
+  }
+  return chords;
+}
+
+// The row a binding's command is on, aliases folded into their row (Z13).
+const Entry* RowOf(int command) {
+  return EntryForCommand(ConflictCommand(command));
+}
+
+// The command that has `chord` in `effective` and is not on `entry`'s row,
+// or null.
+const Binding* OtherHolder(const std::vector<Binding>& effective,
+                           const Entry& entry,
+                           const Chord& chord) {
+  const std::vector<int> members = MembersOf(entry);
+  for (const Binding& binding : effective) {
+    if (binding.chord == chord &&
+        !Contains(members, ConflictCommand(binding.command))) {
+      return &binding;
+    }
+  }
+  return nullptr;
+}
+
+std::u16string Quoted(const Entry& entry) {
+  return base::StrCat({u"“", entry.label, u"”"});
+}
+
+#if BUILDFLAG(IS_MAC)
+// Z16: ⌘← and ⌘→ go back and forward when the page does not use them, from a
+// table of their own that the user's chords do not change.
+bool IsDelayedChord(const Chord& chord) {
+  return chord.modifiers == ui::EF_COMMAND_DOWN &&
+         (chord.key == ui::VKEY_LEFT || chord.key == ui::VKEY_RIGHT);
+}
+#endif
+
+}  // namespace
+
+bool CanChangeNumberKeys() {
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+  return true;
+#else
+  return false;
+#endif
+}
+
+NumberKeys NumberKeysOf(const base::DictValue& stored) {
+  if (!CanChangeNumberKeys()) {
+    return NumberKeys::kRowsFirst;
+  }
+  const std::string* const name = stored.FindString(kNumberKeysKey);
+  return name ? NumberKeysNamed(*name).value_or(NumberKeys::kRowsFirst)
+              : NumberKeys::kRowsFirst;
+}
+
+// The names are what Local State keeps: once shipped, never changed.
+std::string NumberKeysName(NumberKeys layout) {
+  switch (layout) {
+    case NumberKeys::kRowsFirst:
+      return "rows-first";
+    case NumberKeys::kSpacesFirst:
+      return "spaces-first";
+    case NumberKeys::kRowsFirstSpacesThird:
+      return "rows-first-spaces-third";
+    case NumberKeys::kSpacesFirstRowsThird:
+      return "spaces-first-rows-third";
+  }
+  NOTREACHED();
+}
+
+std::optional<NumberKeys> NumberKeysNamed(std::string_view name) {
+  for (NumberKeys layout : kAllNumberKeys) {
+    if (name == NumberKeysName(layout)) {
+      return layout;
+    }
+  }
+  return std::nullopt;
+}
+
+int NumberKeysModifiers(const Entry& family, NumberKeys layout) {
+#if BUILDFLAG(IS_MAC)
+  constexpr int kFirst = ui::EF_COMMAND_DOWN;
+  constexpr int kSecond = ui::EF_CONTROL_DOWN;
+  constexpr int kThird = ui::EF_CONTROL_DOWN | ui::EF_COMMAND_DOWN;
+#else
+  // Ctrl+Alt is AltGr on many keyboards, which types with digits: the
+  // third key is Alt+Shift.
+  constexpr int kFirst = ui::EF_CONTROL_DOWN;
+  constexpr int kSecond = ui::EF_ALT_DOWN;
+  constexpr int kThird = ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN;
+#endif
+  const bool rows = family.command == IDC_SELECT_TAB_0;
+  switch (layout) {
+    case NumberKeys::kRowsFirst:
+      return rows ? kFirst : kSecond;
+    case NumberKeys::kSpacesFirst:
+      return rows ? kSecond : kFirst;
+    case NumberKeys::kRowsFirstSpacesThird:
+      return rows ? kFirst : kThird;
+    case NumberKeys::kSpacesFirstRowsThird:
+      return rows ? kThird : kFirst;
+  }
+  NOTREACHED();
+}
+
+std::vector<std::vector<Chord>> NumberKeysChords(
+    const Entry& family,
+    NumberKeys layout,
+    const std::vector<Binding>& defaults) {
+  const std::vector<int> members = MembersOf(family);
+  std::vector<std::vector<Chord>> chords;
+  chords.reserve(members.size());
+  const int modifiers = NumberKeysModifiers(family, layout);
+  for (size_t i = 0; i < members.size(); ++i) {
+    if (layout == NumberKeys::kRowsFirst) {
+      chords.push_back(DefaultChordsFor(members[i], defaults));
+      continue;
+    }
+    const int offset = static_cast<int>(i);
+    chords.push_back(
+        {Chord(static_cast<ui::KeyboardCode>(ui::VKEY_1 + offset), modifiers),
+         Chord(static_cast<ui::KeyboardCode>(ui::VKEY_NUMPAD1 + offset),
+               modifiers)});
+  }
+  return chords;
+}
+
+UserShortcuts Resolve(const base::DictValue& stored) {
+  UserShortcuts user;
+  const base::DictValue* const commands = stored.FindDict(kCommandsKey);
+  std::set<Chord> claimed;
+  // Z23: another layout gives each family that is on its nine chords first;
+  // while on, no other row may hold them (Z17). The defaults are not needed
+  // here: the shipped layout changes nothing.
+  if (const NumberKeys layout = NumberKeysOf(stored);
+      layout != NumberKeys::kRowsFirst) {
+    for (const Entry& entry : Catalog()) {
+      if (!(entry.flags & kFamily)) {
+        continue;
+      }
+      const base::DictValue* const raw =
+          commands ? commands->FindDict(entry.name) : nullptr;
+      if (raw && raw->FindBool(kOffKey).value_or(false)) {
+        continue;
+      }
+      const std::vector<int> members = MembersOf(entry);
+      std::vector<std::vector<Chord>> chords =
+          NumberKeysChords(entry, layout, /*defaults=*/{});
+      for (size_t i = 0; i < members.size(); ++i) {
+        for (const Chord& chord : chords[i]) {
+          claimed.insert(chord);
+        }
+        user.chords[members[i]] = std::move(chords[i]);
+      }
+    }
+  }
+  if (!commands) {
+    return user;
+  }
+  for (const Entry& entry : Catalog()) {
+    if (!CanTurnOff(entry)) {
+      continue;
+    }
+    const base::DictValue* const raw = commands->FindDict(entry.name);
+    if (!raw) {
+      continue;
+    }
+    if (raw->FindBool(kOffKey).value_or(false)) {
+      for (int member : MembersOf(entry)) {
+        user.off.insert(member);
+      }
+      continue;
+    }
+    if (!CanRebind(entry) || !raw->FindList(kKeysKey)) {
+      continue;
+    }
+    std::vector<Chord> chords;
+    for (const Chord& chord : ReadKeys(*raw)) {
+      if (claimed.insert(chord).second) {
+        chords.push_back(chord);
+      }
+    }
+    user.chords[entry.command] = std::move(chords);
+  }
+  // Z18: Previous of the recent tabs is Next's chords with Shift.
+  for (const Entry& entry : Catalog()) {
+    if (!(entry.flags & kFollows)) {
+      continue;
+    }
+    const int leader = LeaderOf(entry);
+    if (user.IsOff(leader)) {
+      user.off.insert(entry.command);
+    } else if (auto it = user.chords.find(leader); it != user.chords.end()) {
+      std::vector<Chord> chords;
+      for (const Chord& chord : it->second) {
+        if (claimed.insert(WithShift(chord)).second) {
+          chords.push_back(WithShift(chord));
+        }
+      }
+      user.chords[entry.command] = std::move(chords);
+    }
+  }
+  return user;
+}
+
+RowState::RowState() = default;
+RowState::RowState(const RowState&) = default;
+RowState& RowState::operator=(const RowState&) = default;
+RowState::~RowState() = default;
+
+ShortcutEditor::ShortcutEditor(base::DictValue& stored,
+                               std::vector<Binding> defaults)
+    : stored_(stored), defaults_(std::move(defaults)) {}
+
+ShortcutEditor::~ShortcutEditor() = default;
+
+base::DictValue& ShortcutEditor::Commands() {
+  if (!stored_->FindInt(kVersionKey)) {
+    stored_->Set(kVersionKey, kFormatVersion);
+  }
+  return *stored_->EnsureDict(kCommandsKey);
+}
+
+const base::DictValue* ShortcutEditor::FindCommands() const {
+  return stored_->FindDict(kCommandsKey);
+}
+
+RowState ShortcutEditor::StateOf(const Entry& entry) const {
+  RowState state;
+  for (int member : MembersOf(entry)) {
+    for (const Chord& chord : DefaultChordsFor(member, defaults_)) {
+      if (!Contains(state.defaults, chord)) {
+        state.defaults.push_back(chord);
+      }
+    }
+  }
+  const UserShortcuts user = Resolve(*stored_);
+  if (entry.flags & kFollows) {
+    // Read-only: what Resolve gave it, or its defaults.
+    state.off = user.IsOff(entry.command);
+    auto it = user.chords.find(entry.command);
+    state.chords = it != user.chords.end() ? it->second : state.defaults;
+    state.changed = state.off || it != user.chords.end();
+    return state;
+  }
+  state.chords = state.defaults;
+  if (entry.flags & kFamily) {
+    // Z23: the layout's chords, which the row shows while off too.
+    state.chords.clear();
+    for (const std::vector<Chord>& member :
+         NumberKeysChords(entry, NumberKeysOf(*stored_), defaults_)) {
+      for (const Chord& chord : member) {
+        if (!Contains(state.chords, chord)) {
+          state.chords.push_back(chord);
+        }
+      }
+    }
+  }
+  const base::DictValue* const commands = FindCommands();
+  const base::DictValue* const raw =
+      commands && CanTurnOff(entry) ? commands->FindDict(entry.name) : nullptr;
+  if (raw) {
+    state.off = raw->FindBool(kOffKey).value_or(false);
+    if (CanRebind(entry) && raw->FindList(kKeysKey)) {
+      state.chords = ReadKeys(*raw);
+    }
+    // A family's chords are the layout's, which has its own control (Z23):
+    // its Reset is for its switch.
+    state.changed = state.off || (!(entry.flags & kFamily) &&
+                                  state.chords != state.defaults);
+  }
+  if (!state.off && !(entry.flags & kFamily)) {
+    // Z20: a chord the user gave another row is that row's.
+    if (auto it = user.chords.find(entry.command);
+        it != user.chords.end()) {
+      std::erase_if(state.chords, [&](const Chord& chord) {
+        return !Contains(it->second, chord);
+      });
+    }
+    if (!user.IsChanged(entry.command)) {
+      for (const Chord& chord : state.defaults) {
+        const int holder = user.CommandFor(chord);
+        if (holder != 0 && holder != entry.command) {
+          state.lost.push_back(chord);
+          std::erase(state.chords, chord);
+        }
+      }
+    }
+  }
+  return state;
+}
+
+CheckResult ShortcutEditor::Check(const Entry& entry,
+                                  const Chord& chord,
+                                  const OutsideHolders& outside) const {
+  CheckResult result;
+  result.kind = CheckKind::kRefused;
+  if (!CanRebind(entry)) {
+    result.message = u"This row cannot be changed.";
+    return result;
+  }
+  if (const ChordShape shape = CheckChordShape(chord);
+      shape != ChordShape::kOk) {
+    result.message = ChordShapeMessage(shape);
+    return result;
+  }
+  if ((entry.flags & kHeld) && HeldModifiers(chord.modifiers) == 0) {
+#if BUILDFLAG(IS_MAC)
+    result.message =
+        u"This one works by holding its keys, so it needs ⌘, ⌃ or ⌥.";
+#else
+    result.message =
+        u"This one works by holding its keys, so it needs Ctrl or Alt.";
+#endif
+    return result;
+  }
+  if ((entry.flags & kNoShift) && (chord.modifiers & ui::EF_SHIFT_DOWN)) {
+    result.message =
+        u"Shift goes the other way round with this one, so choose a "
+        u"shortcut without Shift.";
+    return result;
+  }
+#if BUILDFLAG(IS_MAC)
+  if (IsDelayedChord(chord)) {
+    result.message =
+        u"⌘← and ⌘→ go back and forward when the page does not use them.";
+    return result;
+  }
+#endif
+  if (outside.system_hotkey) {
+    result.message =
+        u"macOS takes this shortcut first: it is on in System Settings, "
+        u"Keyboard, Keyboard Shortcuts.";
+    return result;
+  }
+  if (!outside.extension.empty()) {
+    result.message = base::StrCat(
+        {u"The extension “", outside.extension,
+         u"” uses this shortcut. You can change it at "
+         u"chrome://extensions/shortcuts."});
+    return result;
+  }
+
+  const RowState state = StateOf(entry);
+  if (!state.off && Contains(state.chords, chord)) {
+    result.kind = CheckKind::kSame;
+    return result;
+  }
+  const std::vector<Binding> effective = Apply(defaults_, Resolve(*stored_));
+  if (const Binding* const holder = OtherHolder(effective, entry, chord)) {
+    const Entry* const other = RowOf(holder->command);
+    result.other = other;
+    if (!other) {
+      result.message = u"Another command uses this shortcut.";
+      return result;
+    }
+    if (other->flags & kFamily) {
+      result.message =
+          base::StrCat({u"It belongs to ", Quoted(*other),
+                        u". Turn that row off to use it here."});
+      return result;
+    }
+    if (!CanRebind(*other)) {
+      result.message = base::StrCat(
+          {Quoted(*other), u" keeps this shortcut, so it stays as it is."});
+      return result;
+    }
+    result.kind = CheckKind::kConflict;
+    result.message =
+        base::StrCat({ChordText(chord), u" is ", Quoted(*other), u"’s."});
+    return result;
+  }
+  if (entry.flags & kNoShift) {
+    // Z18: with Shift it is the way back, which must be free too.
+    const Entry* const follower = EntryForCommand(IDC_CYCLE_TO_PREV_TAB);
+    for (const Binding& binding : effective) {
+      if (binding.chord != WithShift(chord)) {
+        continue;
+      }
+      const Entry* const other = RowOf(binding.command);
+      if (other == &entry || other == follower) {
+        continue;
+      }
+      result.other = other;
+      result.message = base::StrCat(
+          {u"With Shift it goes the other way round, and ",
+           ChordText(WithShift(chord)), u" is ",
+           other ? Quoted(*other) : std::u16string(u"another command"),
+           u"’s."});
+      return result;
+    }
+  }
+  result.kind = CheckKind::kOk;
+  return result;
+}
+
+CheckResult ShortcutEditor::Add(const Entry& entry,
+                                const Chord& chord,
+                                bool replace,
+                                const OutsideHolders& outside) {
+  CheckResult result = Check(entry, chord, outside);
+  if (result.kind == CheckKind::kRefused || result.kind == CheckKind::kSame ||
+      (result.kind == CheckKind::kConflict && !replace)) {
+    return result;
+  }
+  if (result.kind == CheckKind::kConflict && result.other) {
+    // Z12: the other row loses the chord and keeps the rest; with none
+    // left, it is off.
+    const Entry& other = *result.other;
+    RowState other_state = StateOf(other);
+    std::erase(other_state.chords, chord);
+    Write(other, other_state.chords, other_state.chords.empty());
+  }
+  RowState state = StateOf(entry);
+  if (!Contains(state.chords, chord)) {
+    state.chords.push_back(chord);
+  }
+  Write(entry, state.chords, /*off=*/false);
+  return result;
+}
+
+bool ShortcutEditor::Remove(const Entry& entry, const Chord& chord) {
+  if (!CanRebind(entry)) {
+    return false;
+  }
+  RowState state = StateOf(entry);
+  if (!Contains(state.chords, chord)) {
+    return false;
+  }
+  std::erase(state.chords, chord);
+  Write(entry, state.chords, state.off);
+  return true;
+}
+
+bool ShortcutEditor::SetOff(const Entry& entry, bool off) {
+  if (!CanTurnOff(entry)) {
+    return false;
+  }
+  const RowState state = StateOf(entry);
+  if (state.off == off) {
+    return false;
+  }
+  Write(entry, state.chords, off);
+  return true;
+}
+
+bool ShortcutEditor::Reset(const Entry& entry) {
+  if (!CanTurnOff(entry)) {
+    return false;
+  }
+  return Commands().Remove(entry.name);
+}
+
+void ShortcutEditor::ResetAll() {
+  base::DictValue& commands = Commands();
+  for (const Entry& entry : Catalog()) {
+    commands.Remove(entry.name);
+  }
+  stored_->Remove(kNumberKeysKey);
+}
+
+bool ShortcutEditor::SetNumberKeys(NumberKeys layout) {
+  if (!CanChangeNumberKeys()) {
+    return false;
+  }
+  if (layout == NumberKeys::kRowsFirst) {
+    stored_->Remove(kNumberKeysKey);
+    return true;
+  }
+  if (!stored_->FindInt(kVersionKey)) {
+    stored_->Set(kVersionKey, kFormatVersion);
+  }
+  stored_->Set(kNumberKeysKey, NumberKeysName(layout));
+  return true;
+}
+
+void ShortcutEditor::Write(const Entry& entry,
+                           const std::vector<Chord>& chords,
+                           bool off) {
+  base::DictValue& commands = Commands();
+  if (!off && ((entry.flags & kFamily) ||
+               chords == DefaultChordsFor(entry.command, defaults_))) {
+    commands.Remove(entry.name);
+    return;
+  }
+  base::DictValue value;
+  if (off) {
+    value.Set(kOffKey, true);
+  }
+  if (!(entry.flags & kFamily)) {
+    base::ListValue keys;
+    for (const Chord& chord : chords) {
+      keys.Append(ChordToString(chord));
+    }
+    value.Set(kKeysKey, std::move(keys));
+  }
+  commands.Set(entry.name, std::move(value));
+}
+
+}  // namespace stedding::shortcuts
diff --git a/chrome/browser/ui/stedding/shortcut_editor.h b/chrome/browser/ui/stedding/shortcut_editor.h
new file mode 100644
index 0000000000000..1098cba843cd1
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_editor.h
@@ -0,0 +1,180 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SHORTCUT_EDITOR_H_
+#define CHROME_BROWSER_UI_STEDDING_SHORTCUT_EDITOR_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/raw_ref.h"
+#include "base/values.h"
+#include "chrome/browser/ui/stedding/shortcut_catalog.h"
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+
+namespace stedding::shortcuts {
+
+// docs/features/shortcuts.md Z10: the stored form of the user's chords, the
+// value of stedding.shortcuts.user in Local State:
+//   {"v": 1, "commands": {"<stable name>": {"keys": ["Ctrl+Alt+Right"]}}}
+// or, for a row turned off, {"off": true, "keys": [...]}: the chords it had,
+// kept for when it is turned back on. A row with no entry has its defaults.
+inline constexpr char kVersionKey[] = "v";
+inline constexpr char kCommandsKey[] = "commands";
+inline constexpr char kKeysKey[] = "keys";
+inline constexpr char kOffKey[] = "off";
+inline constexpr int kFormatVersion = 1;
+
+// Z23 (GitHub issue 13): which keys the two sets of nine numbered keys take
+// (Z17), stored by name under "number_keys"; the shipped layout stores
+// nothing, and a name it cannot read is the shipped layout. "First" is ⌘ on
+// the Mac and Ctrl elsewhere, "second" ⌃ and Alt, "third" ⌃⌘ and Alt+Shift,
+// for when the system has the second (macOS gives ⌃1 to ⌃9 to its
+// desktops). The Mac and Windows only: elsewhere the rows have both keys.
+inline constexpr char kNumberKeysKey[] = "number_keys";
+enum class NumberKeys {
+  // The shipped tables: the rows on the first key, the Spaces on the second.
+  kRowsFirst,
+  // The Spaces on the first key, the rows on the second.
+  kSpacesFirst,
+  // The rows on the first key, the Spaces on the third.
+  kRowsFirstSpacesThird,
+  // The Spaces on the first key, the rows on the third.
+  kSpacesFirstRowsThird,
+};
+inline constexpr NumberKeys kAllNumberKeys[] = {
+    NumberKeys::kRowsFirst,
+    NumberKeys::kSpacesFirst,
+    NumberKeys::kRowsFirstSpacesThird,
+    NumberKeys::kSpacesFirstRowsThird,
+};
+
+// Whether this platform lets the layout change.
+bool CanChangeNumberKeys();
+NumberKeys NumberKeysOf(const base::DictValue& stored);
+// The stored name of `layout`, and the layout of a stored name.
+std::string NumberKeysName(NumberKeys layout);
+std::optional<NumberKeys> NumberKeysNamed(std::string_view name);
+// The modifiers `family` (one of the two family rows) takes in `layout`.
+int NumberKeysModifiers(const Entry& family, NumberKeys layout);
+// The chords of `family` in `layout`, member by member: the digit and the
+// number pad's twin; for the shipped layout, the shipped tables' own.
+std::vector<std::vector<Chord>> NumberKeysChords(
+    const Entry& family,
+    NumberKeys layout,
+    const std::vector<Binding>& defaults);
+
+// What the stored value says, applied to the catalog: every changed row's
+// chords and every row turned off, for the commands each row stands for. An
+// entry naming no row, an entry for a fixed row and a chord that cannot be
+// read are ignored and left where they are (Z10). When two rows claim one
+// chord, the first in the catalog's order keeps it (Z20). The follower of a
+// held row (Previous of the recent tabs) takes its leader's chords with
+// Shift (Z18). A layout of the number keys other than the shipped one gives
+// each family that is on its chords before any other row (Z17, Z23).
+UserShortcuts Resolve(const base::DictValue& stored);
+
+// One row as the block shows it.
+struct RowState {
+  RowState();
+  RowState(const RowState&);
+  RowState& operator=(const RowState&);
+  ~RowState();
+
+  // The chords the row has while on: the user's, or the defaults.
+  std::vector<Chord> chords;
+  std::vector<Chord> defaults;
+  // Default chords another row took (Z20): the row says so.
+  std::vector<Chord> lost;
+  bool off = false;
+  // The row differs from its defaults: Reset shows (Z5, Z21).
+  bool changed = false;
+};
+
+// What the block hears back on a chord.
+enum class CheckKind {
+  // Free: Add takes it.
+  kOk,
+  // The row already has it.
+  kSame,
+  // Another row has it: Replace moves it (Z12).
+  kConflict,
+  // It cannot be taken, `message` says why (Z14, Z15, Z18).
+  kRefused,
+};
+
+struct CheckResult {
+  CheckKind kind = CheckKind::kOk;
+  std::u16string message;
+  // The row that has the chord, for kConflict and some refusals.
+  raw_ptr<const Entry> other = nullptr;
+};
+
+// What holds a chord outside the tables, found by the caller: an enabled
+// shortcut of macOS's, an extension's command in a profile on this machine.
+struct OutsideHolders {
+  bool system_hotkey = false;
+  std::u16string extension;
+};
+
+// Reads and writes the stored value, row by row. Every write leaves an
+// entry only where a row differs from its defaults.
+class ShortcutEditor {
+ public:
+  // `stored` is the stored value, `defaults` this platform's shipped table
+  // (DefaultBindings()).
+  ShortcutEditor(base::DictValue& stored, std::vector<Binding> defaults);
+  ShortcutEditor(const ShortcutEditor&) = delete;
+  ShortcutEditor& operator=(const ShortcutEditor&) = delete;
+  ~ShortcutEditor();
+
+  RowState StateOf(const Entry& entry) const;
+
+  // Whether `chord` can go on `entry`'s row (Z12, Z14, Z15, Z18).
+  CheckResult Check(const Entry& entry,
+                    const Chord& chord,
+                    const OutsideHolders& outside = OutsideHolders()) const;
+
+  // Adds `chord` to the row; a row that was off is on again. With a
+  // conflict, nothing changes unless `replace`: then the other row loses
+  // that chord and keeps its others, and with none left it is off (Z12).
+  CheckResult Add(const Entry& entry,
+                  const Chord& chord,
+                  bool replace,
+                  const OutsideHolders& outside = OutsideHolders());
+
+  // Takes `chord` off the row. False when the row cannot be changed or has
+  // no such chord.
+  bool Remove(const Entry& entry, const Chord& chord);
+
+  // Turns the row's keys off, keeping them for later, or on again.
+  bool SetOff(const Entry& entry, bool off);
+
+  // Puts the row's defaults back.
+  bool Reset(const Entry& entry);
+
+  // Puts every row's defaults back, and the shipped layout of the number
+  // keys. Entries naming no row stay.
+  void ResetAll();
+
+  // Z23: the layout of the number keys. False where it cannot change.
+  bool SetNumberKeys(NumberKeys layout);
+
+ private:
+  base::DictValue& Commands();
+  const base::DictValue* FindCommands() const;
+  // Stores `chords` for the row, off or on; no entry when that is the
+  // defaults, on.
+  void Write(const Entry& entry, const std::vector<Chord>& chords, bool off);
+
+  const raw_ref<base::DictValue> stored_;
+  const std::vector<Binding> defaults_;
+};
+
+}  // namespace stedding::shortcuts
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SHORTCUT_EDITOR_H_
