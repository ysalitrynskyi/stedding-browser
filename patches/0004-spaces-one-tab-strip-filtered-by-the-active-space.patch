@@ -0,0 +1,150 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_tab_visibility_controller.h"
+
+#include "chrome/browser/ui/stedding_ui_metrics.h"
+#include <algorithm>
+#include <optional>
+
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/common/tab_view.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/views/view.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace spaces {
+
+SpaceTabVisibilityController::SpaceTabVisibilityController(
+    SpaceModel& model,
+    TabStripModel& tab_strip_model,
+    views::View& tab_strip_root)
+    : model_(model),
+      tab_strip_model_(tab_strip_model),
+      tab_strip_root_(tab_strip_root) {
+  observation_.Observe(&model);
+  tab_strip_model.AddObserver(this);
+
+  if (stedding::kPinTabsForTesting.Get() > 0) {
+    // Deferred: this controller is built when the tab strip view is set, which
+    // is before the window's first tabs are inserted, so pinning here would
+    // find an empty strip.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&SpaceTabVisibilityController::PinTabsForTesting,
+                       weak_factory_.GetWeakPtr()),
+        base::Seconds(1));
+  }
+
+  UpdateTabVisibility();
+  // The restored active Space's colour must show from the first frame, not
+  // from the first switch. The widget may not exist yet, so try now and again
+  // one turn later.
+  UpdateWindowTint();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&SpaceTabVisibilityController::UpdateWindowTint,
+                     weak_factory_.GetWeakPtr()));
+}
+
+SpaceTabVisibilityController::~SpaceTabVisibilityController() {
+  TabStripModelObserver::StopObservingAll(this);
+}
+
+void SpaceTabVisibilityController::PinTabsForTesting() {
+  // Pinning is a UI gesture, so the essentials row could otherwise only be
+  // looked at by hand. Zero in normal use.
+  const int to_pin =
+      std::min(stedding::kPinTabsForTesting.Get(), tab_strip_model_->count());
+  for (int i = 0; i < to_pin; ++i) {
+    tab_strip_model_->SetTabPinned(i, true);
+  }
+  UpdateTabVisibility();
+  UpdateWindowTint();
+}
+
+void SpaceTabVisibilityController::UpdateWindowTint() {
+  views::Widget* const widget = tab_strip_root_->GetWidget();
+  if (!widget) {
+    return;
+  }
+  const Space* const active = model_->active_space();
+  // A window with one unnamed Space should look like an ordinary window, so
+  // only tint once the user has more than one Space to tell apart.
+  widget->SetUserColorOverride(model_->size() > 1 && active
+                                   ? std::optional<SkColor>(active->color())
+                                   : std::nullopt);
+}
+
+void SpaceTabVisibilityController::UpdateTabVisibility() {
+  UpdateSubtree(*tab_strip_root_);
+}
+
+void SpaceTabVisibilityController::UpdateSubtree(views::View& parent) {
+  for (views::View* child : parent.children()) {
+    if (auto* const tab_view = views::AsViewClass<TabView>(child)) {
+      const tabs::TabInterface* const tab = tab_view->GetTabInterface();
+      if (!tab) {
+        continue;
+      }
+      if (!model_->IsTabInActiveSpace(tab)) {
+        tab_view->SetVisible(false);
+        continue;
+      }
+      // Belongs to the active Space, but a collapsed group may still be hiding
+      // it. Asking the model rather than assuming keeps the two reasons a tab
+      // can be hidden from fighting each other.
+      const int index = tab_strip_model_->GetIndexOfTab(tab);
+      const bool collapsed = index != TabStripModel::kNoTab &&
+                             tab_strip_model_->IsTabCollapsed(index);
+      tab_view->SetVisible(!collapsed);
+      continue;
+    }
+    // Group and folder views hold tabs of their own.
+    UpdateSubtree(*child);
+  }
+}
+
+void SpaceTabVisibilityController::OnActiveSpaceChanged(const SpaceId& from,
+                                                        const SpaceId& to) {
+  UpdateTabVisibility();
+  UpdateWindowTint();
+}
+
+void SpaceTabVisibilityController::OnSpaceMetadataChanged(const SpaceId& id) {
+  UpdateWindowTint();
+}
+
+void SpaceTabVisibilityController::OnSpaceRemoved(const SpaceId& id) {
+  UpdateTabVisibility();
+  UpdateWindowTint();
+}
+
+void SpaceTabVisibilityController::OnTabSpaceChanged(tabs::TabInterface* tab) {
+  UpdateTabVisibility();
+}
+
+void SpaceTabVisibilityController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() != TabStripModelChange::Type::kInserted &&
+      change.type() != TabStripModelChange::Type::kMoved) {
+    return;
+  }
+  // The tab strip view is an observer too, and which of the two hears first is
+  // not ours to decide; its TabView may not exist yet. One turn later it does.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&SpaceTabVisibilityController::UpdateTabVisibility,
+                     weak_factory_.GetWeakPtr()));
+}
+
+}  // namespace spaces
