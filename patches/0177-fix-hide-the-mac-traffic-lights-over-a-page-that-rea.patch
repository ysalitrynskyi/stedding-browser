+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_WINDOW_BUTTONS_MAC_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_WINDOW_BUTTONS_MAC_H_
+
+#import <Foundation/Foundation.h>
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_multi_source_observation.h"
+#include "ui/events/event_observer.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+
+class BrowserView;
+@class NSWindow;
+
+namespace views {
+class EventMonitor;
+}  // namespace views
+
+namespace stedding {
+
+// docs/features/sidebar.md Y55 (GitHub issue 93): with the sidebar hidden
+// completely (Y19) and the address row hidden too (toolbar T8, T10, T50),
+// nothing of the window is left at its top: the page runs to the window's
+// top edge, and macOS's traffic lights sat on the page, over what a site
+// keeps at its top left. In that state the lights are hidden, and they show
+// while the pointer is near their place, at the window's top left. Anywhere
+// else -- the sidebar open, as the rail or slid in over the page, the row
+// shown, full screen -- they show as always (Y53).
+//
+// One per in-process browser window, owned by its BrowserNativeWidgetMac.
+class WindowButtonsOverPageMac : public ui::EventObserver,
+                                 public views::ViewObserver {
+ public:
+  // How far past the lights' own frames the pointer shows them, in points.
+  static constexpr int kRevealMargin = 8;
+
+  // Tests stand a point on the screen in for the real pointer; nullopt goes
+  // back to the real one. UpdateAllForTesting re-reads every window, as a
+  // pointer move would.
+  static void SetPointerForTesting(std::optional<gfx::Point> screen_point);
+  static void UpdateAllForTesting();
+
+  WindowButtonsOverPageMac(BrowserView* browser_view, NSWindow* window);
+  WindowButtonsOverPageMac(const WindowButtonsOverPageMac&) = delete;
+  WindowButtonsOverPageMac& operator=(const WindowButtonsOverPageMac&) =
+      delete;
+  ~WindowButtonsOverPageMac() override;
+
+  // Hides or shows the lights for the window's state and the pointer.
+  void Update();
+
+  // ui::EventObserver: the pointer moving anywhere in the window, the page
+  // included, where no view of the browser's hears it.
+  void OnEvent(const ui::Event& event) override;
+
+  // views::ViewObserver: the sidebar opening, closing or sliding in, and the
+  // address row hiding or showing.
+  void OnViewBoundsChanged(views::View* observed_view) override;
+  void OnViewVisibilityChanged(views::View* observed_view,
+                               views::View* starting_view, bool visible) override;
+  void OnViewIsDeleting(views::View* observed_view) override;
+
+ private:
+  void ObserveViews();
+  // The state in which nothing of the window is under the lights.
+  bool LightsAreOverThePage() const;
+  bool PointerIsNearTheLights() const;
+  void SetLightsHidden(bool hidden);
+
+  raw_ptr<BrowserView> browser_view_;
+  NSWindow* __weak window_;
+  std::unique_ptr<views::EventMonitor> pointer_monitor_;
+  base::ScopedMultiSourceObservation<views::View, views::ViewObserver>
+      view_observations_{this};
+  bool lights_hidden_ = false;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_WINDOW_BUTTONS_MAC_H_
