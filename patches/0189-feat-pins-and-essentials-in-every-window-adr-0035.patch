+    spaces::PinMirror::SetTabDragForTesting(true);
+    BrowserWindowInterface* const torn = TearOff(dragged);
+    RunFor(base::Milliseconds(800));
+    EXPECT_TRUE(Pins(torn).empty()) << "the drag's window took a pin";
+    EXPECT_TRUE(Essentials(torn).empty())
