+std::optional<size_t> SwitcherChipForTabDropInStack(
+    const std::vector<gfx::Rect>& boxes,
+    int before,
+    int after,
+    const gfx::Point& point) {
+  // The lines, top to bottom: each box joins the line before while the two
+  // overlap down the stack. A dot lit for the drop fills its cell and stands
+  // 2 DIP higher than the dot beside it, on the same line.
+  std::vector<SwitcherSpan> lines;
+  std::vector<std::vector<size_t>> members;
+  for (size_t i = 0; i < boxes.size(); ++i) {
+    const gfx::Rect& box = boxes[i];
+    if (!lines.empty()) {
+      SwitcherSpan& line = lines.back();
+      const int line_end = line.start + line.extent;
+      if (box.y() < line_end && box.bottom() > line.start) {
+        const int start = std::min(line.start, box.y());
+        line.extent = std::max(line_end, box.bottom()) - start;
+        line.start = start;
+        members.back().push_back(i);
+        continue;
+      }
+    }
+    lines.push_back({box.y(), box.height()});
+    members.push_back({i});
+  }
+  const std::optional<size_t> line =
+      SwitcherChipForTabDrop(lines, before, after, point.y());
+  if (!line) {
+    return std::nullopt;
+  }
+  size_t nearest = members[*line].front();
+  for (size_t i : members[*line]) {
+    if (std::abs(boxes[i].CenterPoint().x() - point.x()) <
+        std::abs(boxes[nearest].CenterPoint().x() - point.x())) {
+      nearest = i;
+    }
+  }
+  return nearest;
+}
