+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, ADraggedChipShowsWhereItLands) {
+  MakeThreeSpaces();
+  // The Space tint's theme change, a turn later, rebuilds the row.
+  base::RunLoop().RunUntilIdle();
+  const auto chips = Chips();
+  ASSERT_EQ(3u, chips.size());
