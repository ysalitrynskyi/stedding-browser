+// windows G8: over a full-screen window an extension's popup, as a password
+// manager opens for a passkey, joins the full-screen space as an auxiliary
+// window and shows there.
+IN_PROC_BROWSER_TEST_F(PopupOverFullScreenTest,
+                       AnExtensionsPopupOpensOverAFullScreenWindow) {
+  ui::test::ScopedFakeNSWindowFullscreen fake_fullscreen;
+  ASSERT_TRUE(EnterFullScreen());
+  ASSERT_EQ(browser(), GetLastActiveBrowserWindowInterfaceWithAnyProfile())
+      << "the full-screen window is not the one in front";
+  NSWindow* const full_screen = WindowOf(browser());
+  BrowserWindowInterface* const popup = OpenAnExtensionsPopup();
+  ASSERT_TRUE(popup);
+  EXPECT_TRUE(popup->GetType() == BrowserWindowInterface::TYPE_POPUP ||
+              popup->GetType() == BrowserWindowInterface::TYPE_APP_POPUP)
+      << "a window of type " << popup->GetType();
+  NSWindow* const window = WindowOf(popup);
+  ASSERT_TRUE(base::test::RunUntil([&] { return window.visible; }))
+      << "the popup never showed";
+  const NSWindowCollectionBehavior behavior = window.collectionBehavior;
+  EXPECT_TRUE(behavior & NSWindowCollectionBehaviorFullScreenAuxiliary)
+      << "the popup is not an auxiliary window of the full screen: "
+      << behavior;
+  EXPECT_FALSE(behavior & NSWindowCollectionBehaviorFullScreenPrimary);
+  EXPECT_TRUE(window.onActiveSpace);
+  EXPECT_TRUE(full_screen.onActiveSpace)
+      << "the full-screen window left the space in front";
+  EXPECT_TRUE(browser()->GetWindow()->IsFullscreen());
+}
+
+// windows G8: beside a window not in full screen, a popup is an ordinary
+// window, as Chromium's is.
+IN_PROC_BROWSER_TEST_F(PopupOverFullScreenTest,
+                       APopupBesideAnOrdinaryWindowIsOrdinary) {
+  ASSERT_FALSE(browser()->GetWindow()->IsFullscreen());
+  for (const bool from_an_extension : {true, false}) {
+    SCOPED_TRACE(from_an_extension ? "an extension's popup" : "a page's popup");
+    BrowserWindowInterface* const popup =
+        from_an_extension ? OpenAnExtensionsPopup() : OpenAPagesPopup();
