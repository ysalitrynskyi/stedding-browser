@@ -0,0 +1,24 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_CLEAN_LINK_H_
+#define CHROME_BROWSER_UI_STEDDING_CLEAN_LINK_H_
+
+#include "url/gurl.h"
+
+namespace stedding {
+
+// Returns |url| without the query parameters that only exist to track the
+// reader: the utm_* family, the ad-click ids (fbclid, gclid, ...), the mail
+// merge ids, and YouTube's share id. Everything else keeps its order and its
+// encoding. This is used for copying a link (docs/features/copy-link.md L2)
+// and never for navigation: a page is loaded with the URL it was given.
+GURL CleanLink(const GURL& url);
+
+// True when CleanLink(|url|) would remove something.
+bool HasTrackingParameters(const GURL& url);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_CLEAN_LINK_H_
