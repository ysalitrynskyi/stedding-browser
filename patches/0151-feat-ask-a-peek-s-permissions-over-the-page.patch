+// P20 (BACKLOG S-376): a page in a peek that asks for a permission gets the
+// prompt, over the peek, for the page's own site, and the answer reaches the
+// page. A peek's page had no one to ask: the request manager comes with a tab,
+// and the request was answered as if the prompt had been ignored.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, APermissionIsAskedOverThePeek) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("localhost", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  ASSERT_NO_FATAL_FAILURE(AskForNotifications(page));
+  views::Widget* const prompt = PromptOf(page);
+  ASSERT_TRUE(prompt) << "no prompt came";
+  EXPECT_TRUE(prompt->IsVisible());
+  EXPECT_TRUE(peek->widget()->GetWindowBoundsInScreen().Contains(
+      prompt->GetWindowBoundsInScreen().origin()))
+      << "the prompt is not over the peek";
+  EXPECT_EQ(Url("localhost", "/").GetWithEmptyPath(),
+            permissions::PermissionRequestManager::FromWebContents(page)
+                ->GetRequestingOrigin());
+
+  permissions::PermissionRequestManager::FromWebContents(page)->Accept(
+      /*prompt_options=*/std::monostate());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, "window.answer").ExtractString() == "granted";
+  })) << "the page has no answer";
+  EXPECT_FALSE(PromptOf(page));
+}
+
+// P20 (BACKLOG S-376): the prompt goes and comes with the peek, whose tab
+// another tab on screen hides, and the question is still open when it is back.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, APromptGoesAndComesWithItsTab) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("localhost", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  const int pin_index = tabs().active_index();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  ASSERT_NO_FATAL_FAILURE(AskForNotifications(page));
+  ASSERT_TRUE(PromptOf(page));
+
+  const int other = pin_index == 0 ? 1 : 0;
+  ASSERT_GT(tabs().count(), other);
+  tabs().ActivateTabAt(other);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::Widget* const prompt = PromptOf(page);
+    return !prompt || !prompt->IsVisible();
+  })) << "the prompt stayed over another tab";
+
+  tabs().ActivateTabAt(pin_index);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::Widget* const prompt = PromptOf(page);
+    return prompt && prompt->IsVisible();
+  })) << "the prompt did not come back with its tab";
+}
+
+// P7, P20 (BACKLOG S-376): Open as Tab with the prompt up keeps the question:
+// the page asks it again in its tab, as a tab asks.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, APromptFollowsThePageIntoATab) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("localhost", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  ASSERT_NO_FATAL_FAILURE(AskForNotifications(page));
+  ASSERT_TRUE(PromptOf(page));
+
+  // A tab's question may be a chip in the address row, not a bubble.
+  permissions::PermissionRequestObserver asked_again(page);
+  Press(peek->view()->open_as_tab_button());
+  ASSERT_TRUE(WaitForNoPeek(pin));
+  ASSERT_EQ(page, contents());
+  asked_again.Wait();
+  ASSERT_TRUE(asked_again.request_shown())
+      << "the page's question went with the peek";
+  permissions::PermissionRequestManager::FromWebContents(page)->Accept(
+      /*prompt_options=*/std::monostate());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, "window.answer").ExtractString() == "granted";
+  })) << "the page has no answer";
+}
+
+// P20 (BACKLOG S-376): a peek closed with the prompt up takes it along, and
+// the pin takes input again.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, AClosedPeekTakesItsPromptWithIt) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("localhost", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  ASSERT_NO_FATAL_FAILURE(AskForNotifications(page));
+  views::Widget* const prompt = PromptOf(page);
+  ASSERT_TRUE(prompt);
+  views::test::WidgetDestroyedWaiter gone(prompt);
+
+  Press(peek->view()->close_button());
+  gone.Wait();
+  EXPECT_TRUE(WaitForNoPeek(pin));
+}
