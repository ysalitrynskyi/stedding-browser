+// The welcome flow, opened over the window on `step` (the welcome screen
+// when empty), with its page loaded and the test hook the page's script sets
+// at its end.
+content::WebContents* OpenWelcomeW2B05(BrowserWindowInterface& browser,
+                                       std::string_view step) {
+  stedding::ShowWelcomeDialog(browser, step);
+  content::WebContents* page = nullptr;
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    for (content::WebContents* const contents : content::GetAllWebContents()) {
+      if (contents->GetVisibleURL().host() == "stedding-welcome") {
+        page = contents;
+      }
+    }
+    return page != nullptr;
+  })) << "no welcome flow";
+  if (!page) {
+    return nullptr;
+  }
+  EXPECT_TRUE(content::WaitForLoadStop(page));
+  const std::string hook =
+      content::EvalJs(page, "typeof steddingWelcomeTest").ExtractString();
+  EXPECT_EQ("object", hook)
+      << "the welcome page has no test hook: resources.pak is older than "
+         "this test binary, or the page's script stopped before its end";
+  return hook == "object" ? page : nullptr;
+}
+
+// The page's own getBehaviour, asked again. The browser answers the page's
+// messages in the order they came, and those the page sent as it loaded are
+// answered at once (the engines, the colours, the profile's look and
+// behaviour), so once this answer is here theirs are drawn.
+constexpr char kSettledW2B05[] = R"(
+    import('chrome://resources/js/cr.js')
+        .then(cr => cr.sendWithPromise('getBehaviour'))
+        .then(() => 'settled'))";
