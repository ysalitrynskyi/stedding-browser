+// archive A13 (BACKLOG S-230): Chromium records the windows a quit closes
+// in its recently-closed list, and the next launch opens them again. The
+// archive listed each of their tabs as closed beside the tab open again:
+// the command bar showed "Page F -- Archived · Play" under "Page F -- Play".
+class ArchiveReopenTest : public RestoreTest {
+ protected:
+  sessions::TabRestoreService* service() {
+    return TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  }
+
+  // Waits until the list holds what the runs before this one left in it.
+  void WaitForTheLastRunsEntries() {
+    sessions::TabRestoreService* const list = service();
+    ASSERT_TRUE(list);
+    list->LoadTabsFromLastSession();
+    ASSERT_TRUE(base::test::RunUntil([&]() { return list->IsLoaded(); }));
+  }
+
+  // The archive's rows for tabs on `host`, as the page lists them.
+  size_t ArchiveRowsFor(const std::string& host) {
+    size_t rows = 0;
+    for (const stedding::ArchivedTab& tab : stedding::ListArchivedTabs(
+             service()->entries(), base::Time::Now(),
+             stedding::ArchiveRetention(
+                 browser()->GetProfile()->GetPrefs()))) {
+      if (tab.url.host() == host) {
+        ++rows;
+      }
+    }
+    return rows;
+  }
+
+  // The "Archived" rows ⌘T's bar draws for `text`.
+  size_t BarArchivedRowsFor(const std::u16string& text) {
+    BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser());
+    chrome::ExecuteCommand(browser(), IDC_NEW_TAB);  // ⌘T
+    stedding::CommandBarView* const bar =
+        stedding::CommandBarView::GetOpenBar(view);
+    EXPECT_TRUE(bar);
+    if (!bar) {
+      return 0;
+    }
+    bar->field_for_testing()->InsertText(
+        text,
+        ui::TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+    const size_t archived = bar->archived_count_for_testing();
+    // Gone before the next ⌘T, which would take a closing bar up again.
+    bar->Close();
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return !stedding::CommandBarView::GetOpenBar(view); }));
+    return archived;
+  }
+
+  // Whether Chromium's list holds a window closed whole with a tab on
+  // `host`. The list keeps a window the next launch opened again; ⇧⌘T and
+  // the Recently Closed menus pass it over (A15).
+  bool ListHoldsAWindowWith(const std::string& host) {
+    return WindowWith(host) != nullptr;
+  }
+
+  // The window entry of `profile`'s list, the browser()'s by default, that
+  // holds a tab on `host`, or null.
+  const sessions::tab_restore::Window* WindowWith(const std::string& host,
+                                                  Profile* profile = nullptr) {
+    sessions::TabRestoreService* const list =
+        profile ? TabRestoreServiceFactory::GetForProfile(profile) : service();
+    if (!list) {
+      return nullptr;
+    }
+    for (const std::unique_ptr<sessions::tab_restore::Entry>& entry :
+         list->entries()) {
+      if (entry->type != sessions::tab_restore::WINDOW) {
+        continue;
+      }
+      const auto& window =
+          static_cast<const sessions::tab_restore::Window&>(*entry);
+      for (const std::unique_ptr<sessions::tab_restore::Tab>& tab :
+           window.tabs) {
+        if (!tab->navigations.empty() &&
+            tab->navigations[tab->normalized_navigation_index()]
+                    .virtual_url()
+                    .host() == host) {
+          return &window;
+        }
+      }
+    }
+    return nullptr;
+  }
+
+  // A13's mark on the tabs of `window`: the value every tab carries, "" for
+  // none. A window whose tabs disagree gives "mixed".
+  static std::string MarkOf(const sessions::tab_restore::Window& window) {
+    std::optional<std::string> mark;
+    for (const std::unique_ptr<sessions::tab_restore::Tab>& tab :
+         window.tabs) {
+      const auto it = tab->extra_data.find(stedding::kArchiveReopensKey);
+      const std::string value =
+          it == tab->extra_data.end() ? std::string() : it->second;
+      if (mark && *mark != value) {
+        return "mixed";
+      }
+      mark = value;
+    }
+    return mark.value_or(std::string());
+  }
+
+  // The tabs on `host` in every window.
+  size_t TabsOn(const std::string& host) {
+    size_t count = 0;
+    for (BrowserWindowInterface* const window :
+         GetAllBrowserWindowInterfaces()) {
+      TabStripModel* const strip = window->GetTabStripModel();
+      for (int i = 0; i < strip->count(); ++i) {
+        content::WebContents* const contents =
+            strip->GetTabAtIndex(i)->GetContents();
+        const content::NavigationEntry* const entry =
+            contents->GetController().GetLastCommittedEntry();
+        if ((entry ? entry->GetURL() : contents->GetVisibleURL()).host() ==
+            host) {
+          ++count;
+        }
+      }
+    }
+    return count;
+  }
+
+  // Whether the Recently Closed menu of browser() has an item for the window
+  // entry `window`: Chromium labels it with its number of tabs.
+  bool MenuListsTheWindow(const sessions::tab_restore::Window& window) {
+    RecentTabsSubMenuModel menu(nullptr, browser());
+    const std::u16string label = l10n_util::GetPluralStringFUTF16(
+        IDS_RECENTLY_CLOSED_WINDOW, static_cast<int>(window.tabs.size()));
+    for (size_t i = 0; i < menu.GetItemCount(); ++i) {
+      if (menu.GetLabelAt(i) == label) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Keeps the run going with no window of the profile open, as the Mac's
+  // browser runs on after its last window closes, and as an app in the
+  // background keeps it going elsewhere. Upstream's session restore tests
+  // close their last window under the same two keep-alives.
+  struct RunGoesOn {
+    explicit RunGoesOn(Profile* profile)
+        : browser_keep_alive(KeepAliveOrigin::SESSION_RESTORE,
+                             KeepAliveRestartOption::DISABLED),
+          profile_keep_alive(profile, ProfileKeepAliveOrigin::kBrowserWindow) {
+    }
+    ScopedKeepAlive browser_keep_alive;
+    ScopedProfileKeepAlive profile_keep_alive;
+  };
+
+  // The S-229 fixture's tabs after a restart: Page A in Home, Page F in
+  // Play, and none of them an archive row or an "Archived" row of the bar.
+  void ExpectTheOpenTabsAreNotArchived() {
+    tabs::TabInterface* const page_f = Find("page-f.test");
+    ASSERT_TRUE(page_f) << "the session did not come back";
+    ASSERT_TRUE(Find("page-a.test"));
+    const std::optional<SpaceId> play = SpaceNamed("Play");
+    ASSERT_TRUE(play.has_value());
+    EXPECT_EQ(*play, model()->SpaceForTab(page_f));
+    EXPECT_EQ(0u, ArchiveRowsFor("page-f.test"))
+        << "a tab open again is listed as closed";
+    EXPECT_EQ(0u, ArchiveRowsFor("page-a.test"))
+        << "a tab open again is listed as closed";
+    EXPECT_EQ(0u, BarArchivedRowsFor(u"page-f"))
+        << "the bar lists the open tab as archived too";
+    EXPECT_EQ(1u, ArchiveRowsFor("closed.test"))
+        << "the tab closed with Cmd-W before the quit is a closed tab";
+    EXPECT_EQ(1u, BarArchivedRowsFor(u"closed.test"));
+  }
+};
+
+// The first run: the S-229 fixture. Page F moves on to Play with the
+// keyboard, the window following it; a tab closed with ⌘W; then the quit.
+IN_PROC_BROWSER_TEST_F(ArchiveReopenTest,
+                       PRE_PRE_ATabTheRelaunchReopensIsNotArchived) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const SpaceId home = m->active_id();
+  m->SetSpaceName(home, "Home");
+  const SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+  const SpaceId play = m->AddSpace("Play", SK_ColorGREEN)->id();
+  Open("page-a.test");
+  tabs::TabInterface* const page_f = Open("page-f.test");
+  for (const SpaceId& next : {work, play}) {
+    chrome::ExecuteCommand(browser(),
+                           IDC_STEDDING_MOVE_TAB_TO_NEXT_SPACE);  // ⌥⇧⌘→
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return m->SpaceForTab(page_f) == next; }));
+    ASSERT_EQ(next, m->active_id()) << "the window follows the tab";
+  }
+
+  tabs::TabInterface* const closed = Open("closed.test");
+  const tabs::TabHandle closed_handle = closed->GetHandle();
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);  // ⌘W
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !closed_handle.Get(); }));
+  EXPECT_EQ(0u, ArchiveRowsFor("page-f.test")) << "a move is not a close";
+  ASSERT_EQ(1u, ArchiveRowsFor("closed.test"));
+}
+
+// The second run: the session came back. The window the quit closed is in
+// Chromium's list, and none of its tabs is in the archive. A window closed
+// while another stays open is a close, and the archive lists its tab.
+IN_PROC_BROWSER_TEST_F(ArchiveReopenTest,
+                       PRE_ATabTheRelaunchReopensIsNotArchived) {
+  ASSERT_NO_FATAL_FAILURE(WaitForTheLastRunsEntries());
+  EXPECT_TRUE(ListHoldsAWindowWith("page-f.test"))
+      << "Chromium's list dropped the quit's window";
+  ASSERT_NO_FATAL_FAILURE(ExpectTheOpenTabsAreNotArchived());
+  const sessions::tab_restore::Window* const quit = WindowWith("page-f.test");
+  ASSERT_TRUE(quit);
+  EXPECT_EQ(stedding::kArchiveReopensYes, MarkOf(*quit))
+      << "the launch that restored the session left the quit's window "
+         "unsettled (BACKLOG S-230)";
+
+  BrowserWindowInterface* const second =
+      CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(second, Url("other-window.test")));
+  CloseBrowserSynchronously(second);
+  EXPECT_EQ(1u, ArchiveRowsFor("other-window.test"))
+      << "a window closed while another stays open is a close";
+}
+
+// The third run: both quits' windows are in the list now, the first written
+// again by the second run, and still none of their tabs is archived.
+IN_PROC_BROWSER_TEST_F(ArchiveReopenTest,
+                       ATabTheRelaunchReopensIsNotArchived) {
+  ASSERT_NO_FATAL_FAILURE(WaitForTheLastRunsEntries());
+  ASSERT_NO_FATAL_FAILURE(ExpectTheOpenTabsAreNotArchived());
+  EXPECT_EQ(1u, ArchiveRowsFor("other-window.test"));
+}
