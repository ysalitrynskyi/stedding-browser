+
+  ASSERT_TRUE(left->IsSplit()) << "a pane was taken out of its split";
+  EXPECT_EQ(left->GetSplit(), right->GetSplit());
+  const tabs::TabCollection* const split = left->GetParentCollection();
+  EXPECT_EQ(split, right->GetParentCollection());
+  const tabs::FolderTabCollection* const folder =
+      AsFolder(split->GetParentCollection());
+  ASSERT_NE(nullptr, folder) << "the split is not inside the folder";
+  EXPECT_EQ(work_id, folder->id());
+  EXPECT_EQ("Work", folder->title());
+  EXPECT_EQ(folder, sibling->GetParentCollection());
+  EXPECT_EQ(3u, folder->TabCountRecursive());
+  EXPECT_EQ(nullptr, AsFolder(outside->GetParentCollection()));
+  EXPECT_EQ(order, Strip(*tabs));
+}
+
+// F5, F15: a split in a collapsed folder nested in another is saved as one
+// path on both panes and comes back, in a new window, as one split in the
+// same nested folder, with the same ids, names, collapse and order.
+TEST_F(FolderSessionTest, SplitInCollapsedNestedFolderRoundTrips) {
+  for (int i = 0; i < 4; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+  }
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  // Outer[0, Inner(collapsed)[split(1, 2)]], 3.
+  tabs->RestoreSplit(split_tabs::SplitTabId::GenerateNew(), {1, 2},
+                     split_tabs::SplitTabVisualData());
+  tabs::FolderTabCollection* const outer = tabs->AddToNewFolder({0, 1, 2});
+  ASSERT_NE(nullptr, outer);
+  outer->SetTitle("Outer");
+  tabs::FolderTabCollection* const inner = tabs->AddToNewFolder({1, 2}, outer);
+  ASSERT_NE(nullptr, inner);
+  inner->SetTitle("Inner");
+  inner->SetCollapsed(true);
+  const tabs::TabCollection* const split_before =
+      tabs->GetTabAtIndex(1)->GetParentCollection();
+  ASSERT_EQ(outer, tabs->GetTabAtIndex(0)->GetParentCollection());
+  ASSERT_EQ(inner, split_before->GetParentCollection());
+  const tabs::FolderId outer_id = outer->id();
+  const tabs::FolderId inner_id = inner->id();
+
+  const std::vector<std::string> paths = SavedPaths(browser());
+  ASSERT_EQ(4u, paths.size());
+  EXPECT_EQ(paths[1], paths[2]) << "the panes of a split carry one path";
+  EXPECT_TRUE(paths[3].empty());
+
+  // The next start: a new window with the same tabs, their paths parked and
+  // the split rejoined, as session restore leaves them for its callback.
+  std::unique_ptr<BrowserWindowInterface> restored_window =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  for (int i = 0; i < 4; ++i) {
+    AddTab(restored_window.get(), GURL("https://example.com/"));
+  }
+  TabStripModel* const restored = restored_window->GetTabStripModel();
+  for (int i = 0; i < 4; ++i) {
+    Park(restored->GetTabAtIndex(i), paths[i]);
+  }
+  restored->RestoreSplit(split_tabs::SplitTabId::GenerateNew(), {1, 2},
+                         split_tabs::SplitTabVisualData());
+  const std::vector<tabs::TabInterface*> order = Strip(*restored);
+  {
+    FolderSessionService service(*restored_window);
+    service.OnSessionRestored(profile(), restored->count());
+  }
+
+  const tabs::FolderTabCollection* const outer_again =
+      AsFolder(order[0]->GetParentCollection());
+  ASSERT_NE(nullptr, outer_again);
+  EXPECT_EQ(outer_id, outer_again->id());
+  EXPECT_EQ("Outer", outer_again->title());
+  EXPECT_FALSE(outer_again->collapsed());
+  ASSERT_TRUE(order[1]->IsSplit());
+  EXPECT_EQ(order[1]->GetSplit(), order[2]->GetSplit());
+  const tabs::TabCollection* const split = order[1]->GetParentCollection();
+  EXPECT_EQ(split, order[2]->GetParentCollection());
+  const tabs::FolderTabCollection* const inner_again =
+      AsFolder(split->GetParentCollection());
+  ASSERT_NE(nullptr, inner_again);
+  EXPECT_EQ(inner_id, inner_again->id());
+  EXPECT_EQ("Inner", inner_again->title());
+  EXPECT_TRUE(inner_again->collapsed());
+  EXPECT_EQ(outer_again, inner_again->GetParentCollection());
+  EXPECT_EQ(nullptr, AsFolder(order[3]->GetParentCollection()));
+  EXPECT_EQ(order, Strip(*restored));
+  restored->CloseAllTabs();
+}
+
+// F16: every restore reports the profile it restored. A window rebuilds for
+// its own profile only, on each restore that parked something in it, and
+// uses each parked path once.
+TEST_F(FolderSessionTest, RebuildsForItsOwnProfileOnEachRestore) {
+  AddTab(browser(), GURL("https://example.com/"));
+  AddTab(browser(), GURL("https://example.com/"));
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  tabs::TabInterface* const first = tabs->GetTabAtIndex(0);
+  tabs::TabInterface* const second = tabs->GetTabAtIndex(1);
+  FolderSessionService service(*browser());
+
+  // A restore that parked nothing here does not use up the window's turn.
+  service.OnSessionRestored(profile(), 0);
+
+  const tabs::FolderId work_id = tabs::FolderId::GenerateNew();
+  Park(first, "[" + Folder(work_id, "Work", false) + "]");
+  service.OnSessionRestored(profile_manager()->CreateTestingProfile("Other"),
+                            1);
+  EXPECT_EQ(nullptr, AsFolder(first->GetParentCollection()))
+      << "another profile's restore rebuilt this window";
+  EXPECT_TRUE(IsParked(first));
+
+  service.OnSessionRestored(profile(), 1);
+  const tabs::FolderTabCollection* const work =
+      AsFolder(first->GetParentCollection());
+  ASSERT_NE(nullptr, work);
+  EXPECT_EQ(work_id, work->id());
+  EXPECT_FALSE(IsParked(first)) << "a parked path is used once";
+
+  // A later restore into this window moves only the tab it parked, and
+  // leaves the folder rebuilt before as it is.
+  const tabs::FolderId later_id = tabs::FolderId::GenerateNew();
+  Park(second, "[" + Folder(later_id, "Later", false) + "]");
+  service.OnSessionRestored(profile(), 1);
+  const tabs::FolderTabCollection* const later =
+      AsFolder(second->GetParentCollection());
+  ASSERT_NE(nullptr, later);
+  EXPECT_EQ(later_id, later->id());
+  EXPECT_EQ(work, first->GetParentCollection());
+  EXPECT_EQ(nullptr, AsFolder(work->GetParentCollection()));
+}
+
+// F16: the essentials row never holds a folder, so an essential stays pinned
+// and out of folders whatever path was saved for it.
+TEST_F(FolderSessionTest, PinnedTabStaysOutOfItsSavedFolder) {
+  AddTab(browser(), GURL("https://example.com/"));
+  AddTab(browser(), GURL("https://example.com/"));
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  tabs::TabInterface* const essential = tabs->GetTabAtIndex(0);
+  tabs::TabInterface* const other = tabs->GetTabAtIndex(1);
+  tabs->SetTabPinned(0, true);
+  ASSERT_TRUE(essential->IsPinned());
+  const std::string work =
+      "[" + Folder(tabs::FolderId::GenerateNew(), "Work", false) + "]";
+  Park(essential, work);
+  Park(other, work);
+
+  FolderSessionService service(*browser());
+  service.OnSessionRestored(profile(), tabs->count());
+
+  EXPECT_TRUE(essential->IsPinned());
+  EXPECT_EQ(nullptr, AsFolder(essential->GetParentCollection()));
+  EXPECT_FALSE(IsParked(essential));
+  const tabs::FolderTabCollection* const folder =
+      AsFolder(other->GetParentCollection());
+  ASSERT_NE(nullptr, folder);
+  EXPECT_EQ(1u, folder->TabCountRecursive());
 }
 
