+  EXPECT_EQ(u"", host->FindSingleTextfield()->text());
+  host->SetSingleTextfieldText(u" https://notes.example.com/today ");
+  ui::TestDialogModelHost::Accept(std::move(host));
+
+  const GURL notes("https://notes.example.com/today");
+  EXPECT_EQ(std::optional<GURL>(notes), space_model().HomeUrl(essential));
+  EXPECT_EQ(notes, PendingUrl(essential));
+  EXPECT_EQ(essential, tabs().GetActiveTab()) << "the selection moved";
+}
+
+// pins H15: Save with anything but a web address keeps the home and loads
+// nothing, and so does Cancel. A tab that is no pin gets no home.
+TEST_F(PinHomeWindowTest, EditPinnedAddressTakesOnlyAWebPage) {
+  const GURL home("https://mail.example.com/inbox");
+  tabs::TabInterface* const pin = OpenTab(home);
+  space_model().SetSpacePinned(pin, true);
+  ASSERT_EQ(std::optional<GURL>(home), space_model().HomeUrl(pin));
+
+  for (const char16_t* const typed :
+       {u"javascript:alert(document.cookie)", u"file:///etc/hosts",
+        u"chrome://settings", u"data:text/html,<b>hi</b>", u"", u"   "}) {
+    SCOPED_TRACE(base::UTF16ToUTF8(typed));
+    std::unique_ptr<ui::TestDialogModelHost> host = DialogFor(pin);
+    host->SetSingleTextfieldText(typed);
+    ui::TestDialogModelHost::Accept(std::move(host));
+    EXPECT_EQ(std::optional<GURL>(home), space_model().HomeUrl(pin));
+    EXPECT_EQ(GURL(), PendingUrl(pin)) << "a load started";
+  }
+
+  std::unique_ptr<ui::TestDialogModelHost> host = DialogFor(pin);
+  host->SetSingleTextfieldText(u"https://calendar.example.com/");
+  ui::TestDialogModelHost::Cancel(std::move(host));
+  EXPECT_EQ(std::optional<GURL>(home), space_model().HomeUrl(pin));
+  EXPECT_EQ(GURL(), PendingUrl(pin)) << "Cancel started a load";
+
+  // The last gate refuses what the dialog never sends.
+  EXPECT_FALSE(SetHomeAndGo(browser(), pin, GURL("javascript:alert(1)")));
+  EXPECT_EQ(std::optional<GURL>(home), space_model().HomeUrl(pin));
+
+  tabs::TabInterface* const plain = OpenTab(GURL("https://example.com/"));
+  EXPECT_FALSE(
+      SetHomeAndGo(browser(), plain, GURL("https://calendar.example.com/")));
+  EXPECT_FALSE(space_model().HomeUrl(plain).has_value());
+  EXPECT_EQ(GURL(), PendingUrl(plain));
+}
+
+// pins H16: a middle click on a row closes a plain tab, sends a pin of either
+// tier with a web home home, and does nothing on a pin without one -- also
+// with Cmd-W's sleep setting (H9) off, when Cmd-W closes pins.
+TEST_F(PinHomeWindowTest, AMiddleClickSendsAPinHomeAndClosesOnlyAPlainTab) {
+  tabs::TabInterface* const plain = OpenTab(GURL("https://example.com/"));
+  tabs::TabInterface* const space_pin =
+      OpenTab(GURL("https://mail.example.com/"));
+  space_model().SetSpacePinned(space_pin, true);
+  tabs::TabInterface* const essential =
+      OpenTab(GURL("https://calendar.example.com/"));
+  PinAsEssential(essential);
+  tabs::TabInterface* const homeless = OpenTab(GURL("about:blank"));
+  PinAsEssential(homeless);
+  ASSERT_TRUE(space_model().HomeUrl(space_pin).has_value());
+  ASSERT_TRUE(space_model().HomeUrl(essential).has_value());
+  ASSERT_FALSE(space_model().HomeUrl(homeless).has_value());
+
+  for (const bool close_sleeps : {true, false}) {
+    SCOPED_TRACE(close_sleeps ? "Cmd-W sleeps pins" : "Cmd-W closes pins");
+    profile()->GetPrefs()->SetBoolean(prefs::kPinsCloseSleeps, close_sleeps);
+    EXPECT_EQ(MiddleClickAction::kClose,
+              MiddleClickActionFor(browser(), plain));
+    EXPECT_EQ(MiddleClickAction::kGoHome,
+              MiddleClickActionFor(browser(), space_pin));
+    EXPECT_EQ(MiddleClickAction::kGoHome,
+              MiddleClickActionFor(browser(), essential));
+    EXPECT_EQ(MiddleClickAction::kNothing,
+              MiddleClickActionFor(browser(), homeless));
+    EXPECT_EQ(MiddleClickAction::kNothing,
+              MiddleClickActionFor(browser(), nullptr));
+  }
+}
+
 }  // namespace
 }  // namespace stedding
diff --git a/chrome/browser/ui/stedding/site_cookies.cc b/chrome/browser/ui/stedding/site_cookies.cc
new file mode 100644
index 0000000000000..163d67643208d
--- /dev/null
+++ b/chrome/browser/ui/stedding/site_cookies.cc
@@ -0,0 +1,169 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/site_cookies.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/toasts/api/toast_id.h"
+#include "chrome/browser/ui/toasts/toast_controller.h"
+#include "components/url_formatter/url_formatter.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/browsing_data_filter_builder.h"
+#include "content/public/browser/browsing_data_remover.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+// A removal that names its jar may only ask for data that lives in one
+// (BrowsingDataRemoverImpl checks it).
+constexpr uint64_t kOnAPartition =
+    content::BrowsingDataRemover::DATA_TYPE_ON_STORAGE_PARTITION;
+static_assert((kSiteCookieRemoveMask & ~kOnAPartition) == 0,
+              "the site's cookies are removed from one StoragePartition");
+
+// After the removal (commandbar K24): the toast, then the reload, for a tab
+// that is still there, awake and on the site whose cookies went. A page that
+// went to sleep or to another site in the meantime is left as it is.
+void ShowAndReload(content::WebContents* contents, const std::string& domain) {
+  if (!contents || contents->WasDiscarded() ||
+      SiteCookieDomain(contents->GetLastCommittedURL()) != domain) {
+    return;
+  }
+  // A reload looks the same with or without the cookies, so the toast says
+  // what happened, and to which domain. It stays through the reload.
+  if (ToastController* const toasts =
+          ToastController::MaybeGetForWebContents(contents)) {
+    ToastParams params(ToastId::kSteddingSiteCookiesCleared);
+    params.body_string_replacement_params = {
+        url_formatter::IDNToUnicode(domain)};
+    toasts->MaybeShowToast(std::move(params));
+  }
+  // A normal reload: a page that came from a form asks before it sends it
+  // again, as Ctrl+R does.
+  contents->GetController().Reload(content::ReloadType::NORMAL,
+                                   /*check_for_repost=*/true);
+}
+
+// One command's removal while it runs. It owns itself, as content's
+// SiteDataClearer does, and is deleted when BrowsingDataRemover reports its
+// task done; the remover reports every task still pending when the profile
+// goes away, as failed.
+class SiteCookieClearer : public content::BrowsingDataRemover::Observer {
+ public:
+  SiteCookieClearer(content::WebContents* contents, std::string domain)
+      : contents_(contents->GetWeakPtr()), domain_(std::move(domain)) {}
+  SiteCookieClearer(const SiteCookieClearer&) = delete;
+  SiteCookieClearer& operator=(const SiteCookieClearer&) = delete;
+  ~SiteCookieClearer() override = default;
+
+  void Start(content::BrowsingDataRemover* remover,
+             const content::StoragePartitionConfig& config) {
+    // The remover tells only an observer it knows that its task is done, so
+    // the observation comes first.
+    observation_.Observe(remover);
+    remover->RemoveWithFilterAndReply(
+        base::Time(), base::Time::Max(), kSiteCookieRemoveMask,
+        content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB |
+            content::BrowsingDataRemover::ORIGIN_TYPE_PROTECTED_WEB,
+        SiteCookieFilter(domain_, config), this);
+  }
+
+ private:
+  // content::BrowsingDataRemover::Observer:
+  void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+    const base::WeakPtr<content::WebContents> contents = contents_;
+    const std::string domain = domain_;
+    const bool removed =
+        !(failed_data_types & content::BrowsingDataRemover::DATA_TYPE_COOKIES);
+    // Deleting ends the observation.
+    delete this;
+    if (removed) {
+      ShowAndReload(contents.get(), domain);
+    }
+  }
+
+  const base::WeakPtr<content::WebContents> contents_;
+  const std::string domain_;
+  base::ScopedObservation<content::BrowsingDataRemover,
+                          content::BrowsingDataRemover::Observer>
+      observation_{this};
+};
+
+}  // namespace
+
+std::string SiteCookieDomain(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty()) {
+    return std::string();
+  }
+  // The rule of content's SiteDataClearer (Clear-Site-Data), which is how
+  // net scopes a cookie's domain too.
+  std::string domain = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  if (domain.empty()) {
+    // An IP address, or a host with no known registry.
+    domain = std::string(url.host());
+  }
+  return domain;
+}
+
+std::unique_ptr<content::BrowsingDataFilterBuilder> SiteCookieFilter(
+    const std::string& domain,
+    const content::StoragePartitionConfig& config) {
+  std::unique_ptr<content::BrowsingDataFilterBuilder> filter =
+      content::BrowsingDataFilterBuilder::Create(
+          content::BrowsingDataFilterBuilder::Mode::kDelete);
+  filter->AddRegisterableDomain(domain);
+  // No cookie partition key collection is set: by default the domain's
+  // partitioned cookies go from every partition, as its other cookies do.
+  //
+  // The jar is named even when it is the profile's default one (sessions
+  // S27): ChromeBrowsingDataRemoverDelegate makes a removal that names no
+  // StoragePartition again for every Space's own jar (sessions S24), which
+  // would clear the site in every Space with an Independent session.
+  filter->SetStoragePartitionConfig(config);
+  return filter;
+}
+
+bool CanClearSiteCookies(content::WebContents* contents) {
+  // An error page for a web address keeps that address as its last committed
+  // URL, so a redirect loop a cookie causes can be cleared too.
+  return contents && !SiteCookieDomain(contents->GetLastCommittedURL()).empty();
+}
+
+void ClearSiteCookiesAndReload(content::WebContents* contents) {
+  if (!CanClearSiteCookies(contents)) {
+    return;
+  }
+  content::BrowsingDataRemover* const remover =
+      contents->GetBrowserContext()->GetBrowsingDataRemover();
+  if (!remover) {
+    return;
+  }
+  // The jar the page was created in, and no other (sessions S27): a Space's
+  // own for a page of a Space with an Independent session; the profile's for
+  // a shared Space and for an essential, which is always on it (S8); the
+  // private profile's, kept in memory, in a private window.
+  const content::StoragePartitionConfig config =
+      spaces::StoragePartitionConfigForWebContents(contents);
+  (new SiteCookieClearer(contents,
+                         SiteCookieDomain(contents->GetLastCommittedURL())))
+      ->Start(remover, config);
+}
+
+}  // namespace stedding
