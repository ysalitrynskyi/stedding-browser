+class CompactRowActivationB24Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUp() override {
+#if defined(USE_MOCK_ACTIVATION_CONTROLLER)
+    // The window's activation, and a bubble's taking it, as the test sets
+    // them, whatever else runs beside the test.
