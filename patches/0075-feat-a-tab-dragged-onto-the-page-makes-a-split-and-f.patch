+IN_PROC_BROWSER_TEST_F(HiddenRowControlsTest,
+                       TheMediaRowFollowsThePlayingSessionNotTheButton) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL(
+                     "site.test", "/media/session/video-with-metadata.html")));
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      stedding::prefs::kToolbarHideWithSidebar, true);
+  tabs::VerticalTabStripStateController* const sidebar =
