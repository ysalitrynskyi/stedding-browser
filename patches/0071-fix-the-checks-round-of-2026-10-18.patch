+  {
+    ASSERT_NO_FATAL_FAILURE(reset());
+    stedding::CommandBarView* const bar = zeta();
+    ASSERT_TRUE(bar);
+    titles = Titles(bar);
+    size_t tab_rows = 0;
+    size_t archived_rows = 0;
+    for (size_t i = 0; i < titles.size(); ++i) {
+      tab_rows += open.contains(titles[i]);
+      archived_rows += bar->row_detail_for_testing(i).starts_with(u"Archived");
+    }
+    ASSERT_FALSE(titles.empty());
+    ASSERT_EQ(u"Zeta", titles.front()) << "the typed text comes first";
+    ASSERT_EQ(2u, archived_rows) << "the recently-closed tabs are not listed";
+    ASSERT_GT(tab_rows, 1u);
+    // Nothing else: the pages are data: pages, which history does not keep.
+    ASSERT_EQ(1 + tab_rows + archived_rows, titles.size());
+  }
+
+  for (const std::u16string& title : titles) {
+    SCOPED_TRACE(base::UTF16ToUTF8(title));
+    ASSERT_NO_FATAL_FAILURE(reset());
+    const int count = tabs->count();
+    stedding::CommandBarView* const bar = zeta();
+    ASSERT_TRUE(bar);
+    const std::vector<std::u16string> now = Titles(bar);
+    std::vector<std::u16string> sorted_now = now;
+    std::vector<std::u16string> sorted_titles = titles;
+    std::ranges::sort(sorted_now);
+    std::ranges::sort(sorted_titles);
+    // An archived tab closed again is newest: only the order may change.
+    ASSERT_EQ(sorted_titles, sorted_now) << "the rows changed between steps";
+    const size_t row =
+        static_cast<size_t>(std::ranges::find(now, title) - now.begin());
+    const size_t last = now.size() - 1;
+    // Down past the last row, then Up to the row.
+    for (size_t i = 0; i <= last; ++i) {
+      Key(bar, ui::VKEY_DOWN);
+    }
+    ASSERT_EQ(last, bar->selected_row_for_testing());
+    for (size_t i = last; i > row; --i) {
+      Key(bar, ui::VKEY_UP);
+    }
+    ASSERT_EQ(row, bar->selected_row_for_testing());
+    EXPECT_EQ(row, DrawnChosenRow(bar)) << "another row is drawn chosen";
+    Key(bar, ui::VKEY_RETURN);
+    base::RunLoop().RunUntilIdle();
+
+    if (const auto it = open.find(title); it != open.end()) {
+      tabs::TabInterface* const tab = it->second.Get();
+      ASSERT_TRUE(tab);
+      EXPECT_EQ(tab, tabs->GetActiveTab());
+      // An essential is in every Space, so it shows in the Space on screen.
+      EXPECT_EQ(tab->IsPinned() ? home : model->SpaceForTab(tab),
+                model->active_id());
+    } else if (title == u"Zeta") {
+      // The typed text: a search for it, in a tab of its own.
+      ASSERT_EQ(count + 1, tabs->count());
+      EXPECT_NE(std::string::npos,
+                tabs->GetActiveWebContents()->GetVisibleURL().spec().find(
+                    "Zeta"));
+      tabs->CloseWebContentsAt(tabs->active_index(),
+                               TabCloseTypes::CLOSE_NONE);
+    } else {
+      // An archived tab comes back, to Home where it was closed, and is
+      // shown. It is closed again for the steps after this one.
+      tabs::TabInterface* back = nullptr;
+      ASSERT_TRUE(base::test::RunUntil([&]() {
+        back = TabTitled(title);
+        return back != nullptr;
+      })) << "the archived tab did not come back";
+      EXPECT_EQ(home, model->SpaceForTab(back));
+      EXPECT_EQ(back, tabs->GetActiveTab());
+      tabs->CloseWebContentsAt(tabs->GetIndexOfTab(back),
+                               TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+      ASSERT_TRUE(base::test::RunUntil([&]() { return !TabTitled(title); }));
+    }
+  }
+
+  {
+    SCOPED_TRACE("AnAtSpaceListsThatSpaceAndTheEssential");
+    ASSERT_NO_FATAL_FAILURE(reset());
+    chrome::ExecuteCommand(browser(), IDC_NEW_TAB);  // ⌘T
+    stedding::CommandBarView* const bar = OpenBarNow();
+    ASSERT_TRUE(bar);
+    TypeIn(bar, u"@Two Zeta");
+    bool saw_two = false;
+    bool saw_essential = false;
+    for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+      SCOPED_TRACE(base::UTF16ToUTF8(bar->row_title_for_testing(i)));
+      EXPECT_FALSE(bar->row_detail_for_testing(i).starts_with(u"Archived"))
+          << "a tab archived in Home is listed under @Two";
+      const auto it = open.find(bar->row_title_for_testing(i));
+      if (it == open.end()) {
+        continue;
+      }
+      tabs::TabInterface* const tab = it->second.Get();
+      ASSERT_TRUE(tab);
+      if (tab->IsPinned()) {
+        saw_essential = true;
+      } else {
+        EXPECT_EQ(two, model->SpaceForTab(tab));
+        saw_two = true;
+      }
+    }
+    EXPECT_TRUE(saw_essential) << "an essential matches every Space's filter";
+    EXPECT_TRUE(saw_two);
+  }
+
+  {
+    SCOPED_TRACE("AnEssentialHasNoMoveOrPinRows");
+    ASSERT_NO_FATAL_FAILURE(reset());
+    stedding::CommandBarView* bar = Palette(browser());  // ⇧⌘P
+    ASSERT_TRUE(bar);
+    EXPECT_TRUE(std::ranges::contains(Titles(bar),
+                                      std::u16string(u"Move Tab to Two")))
+        << "a tab of Home can move to Two";
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+    tabs::TabInterface* const pinned = open[u"Zeta essential"].Get();
+    ASSERT_TRUE(pinned);
+    tabs->ActivateTabAt(tabs->GetIndexOfTab(pinned));
+    bar = Palette(browser());
+    ASSERT_TRUE(bar);
+    const std::vector<std::u16string> rows = Titles(bar);
+    EXPECT_FALSE(
+        std::ranges::contains(rows, std::u16string(u"Move Tab to Two")));
+    EXPECT_FALSE(
+        std::ranges::contains(rows, std::u16string(u"Pin to This Space")));
+    EXPECT_TRUE(std::ranges::contains(rows, std::u16string(u"New Space")));
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+  }
+}
+
+// commandbar K2 (the owner's decision of 2026-10-18): the bar lists at most
+// four tabs, the active Space's matches first, in the strip's order, then
+// the other Spaces'. Five matching tabs of another Space come before the
+// active Space's two in the strip; typed text that matches all seven lists
+// the active Space's two, then the first two of the other Space. The first
+// four matches of the strip were listed: the other Space's four, and none
+// of the Space on screen.
+IN_PROC_BROWSER_TEST_F(CommandBarKeysTest, TheActiveSpacesTabsAreListedFirst) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  const spaces::SpaceId other = model->AddSpace("Other", SK_ColorBLUE)->id();
+  ASSERT_TRUE(model->SetActiveSpace(other));
+  for (const char* title : {"Kappa other one", "Kappa other two",
+                            "Kappa other three", "Kappa other four",
+                            "Kappa other five"}) {
+    tabs::TabInterface* const tab = OpenTitled(title);
+    ASSERT_EQ(other, model->SpaceForTab(tab)) << title;
+  }
+  ASSERT_TRUE(model->SetActiveSpace(home));
+  int first_home_index = -1;
+  for (const char* title : {"Kappa home one", "Kappa home two"}) {
+    tabs::TabInterface* const tab = OpenTitled(title);
+    ASSERT_EQ(home, model->SpaceForTab(tab)) << title;
+    if (first_home_index < 0) {
+      first_home_index = browser()->GetTabStripModel()->GetIndexOfTab(tab);
+    }
+  }
+  // The premise: every tab of Other comes before Home's two in the strip.
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  for (int i = first_home_index; i < tabs->count(); ++i) {
+    ASSERT_NE(other, model->SpaceForTab(tabs->GetTabAtIndex(i)))
+        << "a tab of Other after Home's first, at " << i;
+  }
+
+  stedding::CommandBarView* const bar = OpenWith(u"Kappa");
+  ASSERT_TRUE(bar);
+  // The tab rows, as drawn: those naming no Space are the Space on screen's,
+  // the others name Other. The typed row and the omnibox's suggestions say
+  // what they are instead.
+  std::vector<std::u16string> listed;
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    const std::u16string detail = bar->row_detail_for_testing(i);
+    if (detail == u"Switch to Tab" || detail == u"Other") {
+      listed.push_back(bar->row_title_for_testing(i) + u" | " + detail);
+    }
+  }
+  const std::vector<std::u16string> expected = {
+      u"Kappa home one | Switch to Tab", u"Kappa home two | Switch to Tab",
+      u"Kappa other one | Other", u"Kappa other two | Other"};
+  EXPECT_EQ(expected, listed);
+  bar->Close();
+  base::RunLoop().RunUntilIdle();
+}
+
 }  // namespace
