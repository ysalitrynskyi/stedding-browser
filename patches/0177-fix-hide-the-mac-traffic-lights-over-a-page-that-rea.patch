 }
 
+
+// sidebar Y55 (GitHub issue 93): with the sidebar hidden completely and the
+// address row hidden too, the page runs to the window's top and the traffic
+// lights sat on it, over what the site has at its top left. There they are
+// hidden, and show while the pointer is near their place; the row coming
+// back, or the sidebar opening, shows them for good.
+IN_PROC_BROWSER_TEST_F(WindowButtonsTest,
+                       HiddenWithTheRowHiddenTheLightsShowOnHover) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  VerticalTabStripRegionView* const strip =
+      browser_view->vertical_tab_strip_region_view_for_testing();
+  NSWindow* const window =
+      browser_view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  ASSERT_TRUE(window);
+  const auto lights_hidden = [&] {
+    views::test::RunScheduledLayout(browser_view->GetWidget());
+    stedding::WindowButtonsOverPageMac::UpdateAllForTesting();
+    bool all = true;
+    bool any = false;
+    for (const NSWindowButton kind :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      const bool hidden = [[window standardWindowButton:kind] isHidden];
+      all = all && hidden;
+      any = any || hidden;
+    }
+    EXPECT_EQ(all, any) << "some of the lights are hidden, not all";
+    return all;
+  };
+  // The pointer in the middle of the page, away from the lights.
+  const gfx::Point away = browser_view->GetBoundsInScreen().CenterPoint();
+  stedding::WindowButtonsOverPageMac::SetPointerForTesting(away);
+
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarClosedForm,
+      stedding::prefs::kSidebarClosedHidden);
+  tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    views::test::RunScheduledLayout(browser_view->GetWidget());
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+               TabStripAnimations::kVerticalTabStrip) &&
+           strip->IsHiddenCompletely() && strip->width() == 0;
+  }));
+  ASSERT_TRUE(browser_view->IsToolbarVisible());
+  EXPECT_FALSE(lights_hidden())
+      << "the row is shown: the lights sit on its bar (Y19)";
+
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+  views::test::RunScheduledLayout(browser_view->GetWidget());
+  ASSERT_FALSE(browser_view->IsToolbarVisible());
+  EXPECT_TRUE(lights_hidden()) << "the lights are drawn over the page";
+
+  // The pointer at the close button shows them, and leaving hides them.
+  stedding::WindowButtonsOverPageMac::SetPointerForTesting(
+      ScreenFrame(window, [window standardWindowButton:NSWindowCloseButton])
+          .CenterPoint());
+  EXPECT_FALSE(lights_hidden()) << "the pointer at the lights left them hidden";
+  stedding::WindowButtonsOverPageMac::SetPointerForTesting(away);
+  EXPECT_TRUE(lights_hidden()) << "the pointer leaving left the lights shown";
+
+  // The row back: the lights show wherever the pointer is.
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+  views::test::RunScheduledLayout(browser_view->GetWidget());
+  ASSERT_TRUE(browser_view->IsToolbarVisible());
+  EXPECT_FALSE(lights_hidden()) << "the row came back, the lights did not";
+
+  // Hidden again, then the sidebar opening: the same.
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+  views::test::RunScheduledLayout(browser_view->GetWidget());
+  ASSERT_TRUE(lights_hidden());
+  tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+      false);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    views::test::RunScheduledLayout(browser_view->GetWidget());
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+               TabStripAnimations::kVerticalTabStrip) &&
+           !strip->IsHiddenCompletely();
+  }));
+  EXPECT_FALSE(lights_hidden()) << "the sidebar opened, the lights did not";
+
+  stedding::WindowButtonsOverPageMac::SetPointerForTesting(std::nullopt);
+}
+
 }  // namespace
