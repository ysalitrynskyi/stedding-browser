+// import I49: the page says how many routes came and how many did not.
+IN_PROC_BROWSER_TEST_F(FromArcPageTest, ThePageCountsTheRoutes) {
+  WriteSidebar();
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::WriteFile(
+        arc_.Append(FILE_PATH_LITERAL("StorableLinkRouting.json")), R"json({
+          "rules": [{
+            "id": "rule",
+            "destination": {"space": {"_0": {"space": {"_0": "space-work"}}}},
+            "sourceComponents": [
+              {"id": "one", "componentType": {"urlMatch":
+                {"_0": {"contains": {}}, "_1": "one.example"}}},
+              {"id": "two", "componentType": {"urlMatch":
+                {"_0": {"contains": {}}, "_1": "two.example"}}}
+            ]
+          }, {
+            "id": "little",
+            "destination": {"littleArc": {"_0": {"mostRecent": {}}}},
+            "sourceComponents": [{"id": "three", "componentType": {"urlMatch":
+              {"_0": {"contains": {}}, "_1": "three.example"}}}]
+          }]
+        })json"));
+  }
+  ASSERT_TRUE(Import());
+  content::WebContents* const page = WaitForThePage();
+  const std::string text =
+      content::EvalJs(page, "document.body.innerText").ExtractString();
+  EXPECT_NE(std::string::npos, text.find("2 routes came across")) << text;
+  EXPECT_NE(std::string::npos, text.find("1 route.")) << text;
+}
