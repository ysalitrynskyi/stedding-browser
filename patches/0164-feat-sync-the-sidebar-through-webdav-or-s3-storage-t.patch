+// Sf9, Sf12, Sf17, Sf50: two profiles stand for two computers, each with its
+// own mirror, sign-in and file, and a pin made on each reaches the other
+// through the place alone.
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceTest, TwoProfilesSyncThroughOnePlace) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  Join();
+  const auto holds = [](spaces::SidebarSyncService* sync,
+                        const std::string& home) {
+    const sb::Ledger* const ledger = sync->ledger_for_testing();
+    if (!ledger) {
+      return false;
+    }
+    for (const auto& [id, record] : ledger->state.records) {
+      if (record.Alive() && record.Get(sb::kFieldHome) == home) {
+        return true;
+      }
+    }
+    return false;
+  };
+  const auto pin = [&](BrowserWindowInterface* window, const GURL& url) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        window, url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    spaces::SpaceModel::From(window)->SetSpacePinned(
+        window->GetTabStripModel()->GetActiveTab(), true);
+  };
+  const GURL here = embedded_test_server()->GetURL("/title1.html");
+  pin(browser(), here);
