+namespace {
+
+using Node = spaces::ArcImportPlan::Node;
+
+// Where the first run keeps its export for the second: the profile's own
+// folder, which the restart keeps.
+constexpr char kExportName[] = "Exported sidebar.json";
+
+// The page's own request, as the row's "Export all Spaces..." makes it.
+constexpr char kExportAll[] = R"(
+  import('chrome://resources/js/cr.js')
+      .then(cr => cr.sendWithPromise('steddingExportAllSpaces'))
+)";
+
+Node Tab(const char* id, const char* url) {
+  Node node;
+  node.kind = Node::Kind::kTab;
+  node.arc_id = id;
+  node.url = GURL(url);
+  return node;
+}
+
+Node Folder(const char* id, const char16_t* title, std::vector<Node> children) {
+  Node node;
+  node.kind = Node::Kind::kFolder;
+  node.arc_id = id;
+  node.title = title;
+  node.children = std::move(children);
+  return node;
+}
+
+// The ids of every tab and folder `nodes` hold, nested ones too.
+void CollectIds(const std::vector<Node>& nodes,
+                std::vector<std::string>* tabs,
+                std::vector<std::string>* folders) {
+  for (const Node& node : nodes) {
+    (node.kind == Node::Kind::kTab ? tabs : folders)->push_back(node.arc_id);
+    CollectIds(node.children, tabs, folders);
+  }
+}
+
+class SidebarFileTest : public InProcessBrowserTest {
+ protected:
+  spaces::SpaceModel& model() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model) << "a normal window has Spaces";
+    return *model;
+  }
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+  base::FilePath ExportPath() {
+    return browser()->GetProfile()->GetPath().AppendASCII(kExportName);
+  }
+};
+
+// The first run: a sidebar as a person has one, brought in unloaded (no
+// page needs a server): in the first Space a pin, a pinned folder with a
+// folder in it and a loose tab; a second Space with a pin of its own; an
+// essential. Then the window is exported, and the run ends.
+IN_PROC_BROWSER_TEST_F(SidebarFileTest,
+                       PRE_TheSameFileAfterARestartAddsNothing) {
+  SessionStartupPref::SetStartupPref(
+      browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  spaces::ArcImportPlan start;
+  spaces::ArcImportPlan::Space home;
+  home.arc_id = "start-home";
+  home.pinned.push_back(Tab("start-pin", "https://pin.example/"));
+  home.pinned.push_back(Folder(
+      "start-reading", u"Reading",
+      {Tab("start-outer", "https://outer.example/"),
+       Folder("start-deep", u"Deep",
+              {Tab("start-inner", "https://inner.example/")})}));
+  home.unpinned.push_back(Tab("start-loose", "https://loose.example/"));
+  start.spaces.push_back(std::move(home));
+  spaces::ArcImportPlan::Space work;
+  work.arc_id = "start-work";
+  work.title = "Work";
+  work.pinned.push_back(Tab("start-work-pin", "https://work-pin.example/"));
+  start.spaces.push_back(std::move(work));
+  start.essentials.push_back(
+      Tab("start-essential", "https://essential.example/"));
+  spaces::ArcImportOptions options;
+  options.history = false;
+  options.passwords = false;
+  const spaces::ArcImportResult made =
+      spaces::ApplyArcImport(browser(), start, options);
+  ASSERT_EQ(5u, made.tabs);
+  ASSERT_EQ(1u, made.essentials);
+  ASSERT_EQ(2u, made.folders);
+
+  // The Reading folder goes into the pinned run (folders F38).
+  tabs::FolderTabCollection* reading = nullptr;
+  for (int i = 0; i < tabs().count() && !reading; ++i) {
+    tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+    if (tab->GetContents()->GetVisibleURL() == GURL("https://outer.example/")) {
+      const tabs::TabCollection* const parent = tab->GetParentCollection();
+      ASSERT_EQ(tabs::TabCollection::Type::FOLDER, parent->type());
+      reading = const_cast<tabs::FolderTabCollection*>(
+          static_cast<const tabs::FolderTabCollection*>(parent));
+    }
+  }
+  ASSERT_TRUE(reading);
+  model().SetFolderSpacePinned(reading, true);
+  ASSERT_TRUE(model().IsFolderSpacePinned(reading));
+
+  const std::string json =
+      spaces::PlanToJson(spaces::SnapshotWindow(browser()));
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::WriteFile(ExportPath(), json));
+  }
+  // The tokens the export made reach the session a turn later.
+  base::RunLoop().RunUntilIdle();
+}
+
+// The second run: the window came back from the session, and the file
+// written before the restart names what is open now, by the same ids.
+// Imported, it adds no Space, tab, folder or essential.
+IN_PROC_BROWSER_TEST_F(SidebarFileTest, TheSameFileAfterARestartAddsNothing) {
+  std::string json;
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::ReadFileToString(ExportPath(), &json));
+  }
+  const std::optional<spaces::ArcImportPlan> plan =
+      spaces::ParseArcSidebar(json);
+  ASSERT_TRUE(plan.has_value());
+  ASSERT_TRUE(plan->written_by_stedding);
+  ASSERT_EQ(2u, plan->spaces.size());
+
+  // Every id the file gives a tab is a tab open now; every folder's, a
+  // folder here.
+  std::vector<std::string> tab_ids;
+  std::vector<std::string> folder_ids;
+  for (const spaces::ArcImportPlan::Space& space : plan->spaces) {
+    const std::optional<spaces::SpaceId> id =
+        spaces::SpaceId::FromOptionalToken(
+            base::Token::FromString(space.arc_id));
+    ASSERT_TRUE(id.has_value()) << space.arc_id;
+    EXPECT_TRUE(model().GetSpace(*id))
+        << "the Space's id survived the restart";
+    CollectIds(space.pinned, &tab_ids, &folder_ids);
+    CollectIds(space.unpinned, &tab_ids, &folder_ids);
+  }
+  CollectIds(plan->essentials, &tab_ids, &folder_ids);
+  EXPECT_EQ(2u, folder_ids.size());
+  std::vector<std::string> open_ids;
+  for (int i = 0; i < tabs().count(); ++i) {
+    open_ids.push_back("tab:" +
+                       stedding::TabToken(tabs().GetWebContentsAt(i)));
+  }
+  for (const std::string& id : tab_ids) {
+    EXPECT_TRUE(std::ranges::find(open_ids, id) != open_ids.end()) << id << " is not open";
+  }
+
+  const int before = tabs().count();
+  const size_t spaces_before = model().size();
+  base::test::TestFuture<std::optional<spaces::ArcImportResult>> done;
+  spaces::ImportSidebarFileAsync(browser(), ExportPath(), done.GetCallback());
+  const std::optional<spaces::ArcImportResult> result = done.Get();
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(0u, result->spaces);
+  EXPECT_EQ(0u, result->tabs);
+  EXPECT_EQ(0u, result->folders);
+  EXPECT_EQ(0u, result->essentials);
+  EXPECT_EQ(before, tabs().count()) << "no tab came in twice";
+  EXPECT_EQ(spaces_before, model().size());
+}
+
+// Sf6: the page's "Export all Spaces..." writes "Stedding sidebar <date>
+// <time>.json" to Downloads, holding every Space of the window in the
+// switcher's order, with their pins and the essentials.
+IN_PROC_BROWSER_TEST_F(SidebarFileTest, ExportAllSpacesWritesEverySpace) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::ScopedTempDir downloads;
+  ASSERT_TRUE(downloads.CreateUniqueTempDir());
+  base::ScopedPathOverride downloads_override(chrome::DIR_DEFAULT_DOWNLOADS,
+                                              downloads.GetPath());
+  spaces::ArcImportPlan start;
+  start.essentials.push_back(
+      Tab("start-essential", "https://essential.example/"));
+  spaces::ArcImportOptions options;
+  options.spaces = false;
+  options.history = false;
+  options.passwords = false;
+  spaces::ApplyArcImport(browser(), start, options);
+  spaces::Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  ASSERT_TRUE(work);
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page = tabs().GetActiveWebContents();
+  const std::string written = content::EvalJs(page, kExportAll).ExtractString();
+  ASSERT_FALSE(written.empty()) << "nothing was written";
+  const base::FilePath path = base::FilePath::FromUTF8Unsafe(written);
+  // The path service resolves the folder it is given (on the Mac, /var is
+  // /private/var), so both sides are compared resolved.
+  EXPECT_EQ(base::MakeAbsoluteFilePath(downloads.GetPath()),
+            base::MakeAbsoluteFilePath(path.DirName()));
+  EXPECT_TRUE(base::StartsWith(path.BaseName().AsUTF8Unsafe(),
+                               "Stedding sidebar "));
+
+  std::string json;
+  ASSERT_TRUE(base::ReadFileToString(path, &json));
+  const std::optional<spaces::ArcImportPlan> plan =
+      spaces::ParseArcSidebar(json);
+  ASSERT_TRUE(plan.has_value());
+  EXPECT_TRUE(plan->written_by_stedding);
+  ASSERT_EQ(model().size(), plan->spaces.size());
+  for (size_t i = 0; i < model().size(); ++i) {
+    EXPECT_EQ(model().spaces()[i]->id().ToString(), plan->spaces[i].arc_id);
+  }
+  EXPECT_EQ("Work", plan->spaces.back().title);
+  ASSERT_EQ(1u, plan->essentials.size());
+  EXPECT_EQ(GURL("https://essential.example/"), plan->essentials[0].url);
+}
