+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, AClickOnAChipShowsThatSpace) {
+  MakeThreeSpaces();
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  spaces::SpaceSwitcherView* const switcher =
+      FindDrawnSwitcher(browser_view()->GetWidget()->GetRootView());
