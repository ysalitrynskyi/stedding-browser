+std::vector<std::string> IdsOf(const std::vector<PinRecord>& records) {
+  std::vector<std::string> ids;
+  ids.reserve(records.size());
+  for (const PinRecord& record : records) {
+    ids.push_back(record.id);
+  }
+  return ids;
+}
+
+// windows G19: what makes a later window's row the same record as an earlier
+// window's. A row with no web home is never matched: it is its own record.
+struct MergeKey {
+  PinTier tier;
+  bool has_space;
+  SpaceId space;
+  std::string home;
+
+  bool operator==(const MergeKey& other) const = default;
+};
+
+std::optional<MergeKey> KeyOf(const PinRecord& record) {
+  if (!record.home.is_valid() || !record.home.SchemeIsHTTPOrHTTPS()) {
+    return std::nullopt;
+  }
+  return MergeKey{record.tier, record.has_space, record.space,
+                  record.home.spec()};
+}
+
+// The run a record is a row of: the essentials, or its Space's pins.
+std::string RunOf(const PinRecord& record) {
+  return record.tier == PinTier::kEssential ? std::string()
+                                            : record.space.ToString();
+}
