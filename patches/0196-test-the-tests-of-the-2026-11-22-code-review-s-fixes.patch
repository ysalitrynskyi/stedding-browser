diff --git a/chrome/browser/ui/spaces/audit_b09_unittest.cc b/chrome/browser/ui/spaces/audit_b09_unittest.cc
new file mode 100644
index 0000000000000..c93dc3d4c3bb1
--- /dev/null
+++ b/chrome/browser/ui/spaces/audit_b09_unittest.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A sidebar file brought back into a window whose lone Space is the unnamed
+// default the file holds too (docs/features/import.md I18, I20; sidebar-file
+// Sf2): a Space of the file deleted here comes back as a Space of its own.
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/arc_sidebar_importer.h"
+#include "chrome/browser/ui/spaces/sidebar_backup.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_colors.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+// The Space of `model` named `name`, or null.
+const Space* SpaceNamedB09(SpaceModel& model, std::string_view name) {
+  for (const std::unique_ptr<Space>& space : model.spaces()) {
+    if (space->name() == name) {
+      return space.get();
+    }
+  }
+  return nullptr;
+}
+
+// The tab of `strip` showing `url`, or null.
+tabs::TabInterface* TabShowingB09(TabStripModel& strip, const char* url) {
+  for (int i = 0; i < strip.count(); ++i) {
+    if (strip.GetWebContentsAt(i)->GetVisibleURL() == GURL(url)) {
+      return strip.GetTabAtIndex(i);
+    }
+  }
+  return nullptr;
+}
+
+class SidebarFileDefaultSpaceB09Test : public BrowserWithTestWindowTest {
+ protected:
+  SpaceModel& model() { return *SpaceModel::From(browser()); }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+
+  tabs::TabInterface* Open(const char* url) {
+    AddTab(browser(), GURL(url));
+    return tabs().GetActiveTab();
+  }
+
+  // Closes every tab that is not a web page: the New Tab page a switch to a
+  // Space with no tab of its own opens there.
+  void CloseTabsThatAreNotWebPages() {
+    for (int i = tabs().count() - 1; i >= 0; --i) {
+      if (!tabs().GetWebContentsAt(i)->GetVisibleURL().SchemeIsHTTPOrHTTPS()) {
+        tabs().CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+      }
+    }
+  }
+
+  // The window's own Spaces: the unnamed default with a page, and "Work"
+  // with a pin. Returns Work's id.
+  SpaceId MakeDefaultAndWork() {
+    const SpaceId home = model().active_id();
+    Open("https://kept.example/");
+    Space* const work = model().AddSpace("Work", kSpaceColors[4].color);
+    const SpaceId work_id = work->id();
+    model().SetActiveSpace(work_id);
+    tabs::TabInterface* const pin = Open("https://work-pin.example/");
+    model().SetSpacePinned(pin, true);
+    model().SetActiveSpace(home);
+    CloseTabsThatAreNotWebPages();
+    task_environment()->RunUntilIdle();
+    return work_id;
+  }
+
+  // Deletes Work, and closes its pin, which the delete moved to the default
+  // Space: the file is then the only place either is kept.
+  void DeleteWork(const SpaceId& work_id) {
+    ASSERT_TRUE(model().RemoveSpace(work_id));
+    tabs::TabInterface* const moved =
+        TabShowingB09(tabs(), "https://work-pin.example/");
+    ASSERT_TRUE(moved);
+    tabs().CloseWebContentsAt(tabs().GetIndexOfTab(moved),
+                              TabCloseTypes::CLOSE_NONE);
+    ASSERT_EQ(1u, model().size());
+    ASSERT_EQ("", model().spaces().front()->name());
+  }
+
+  // What the window holds after the file is imported: the default unnamed
+  // and kept, Work made again with its pin in it.
+  void ExpectWorkCameBack(const SpaceId& home, const ArcImportResult& result) {
+    task_environment()->RunUntilIdle();
+    EXPECT_EQ(2u, model().size())
+        << "the file's Work went over the default Space instead of coming "
+           "back as a Space of its own";
+    EXPECT_EQ(1u, result.spaces) << "Work alone is made";
+    const Space* const default_space = model().GetSpace(home);
+    ASSERT_TRUE(default_space) << "the default Space is gone";
+    EXPECT_EQ("", default_space->name()) << "the default Space was renamed";
+    const Space* const work = SpaceNamedB09(model(), "Work");
+    ASSERT_TRUE(work);
+    EXPECT_NE(home, work->id());
+    tabs::TabInterface* const pin =
+        TabShowingB09(tabs(), "https://work-pin.example/");
+    ASSERT_TRUE(pin) << "Work's pin did not come back";
+    EXPECT_EQ(std::optional<SpaceId>(work->id()),
+              model().FindSpaceForTab(pin))
+        << "Work's pin is not in Work";
+  }
+};
+
+// P10-1a, import I18 and I20: Export all Spaces, delete a Space, import the
+// file. The default Space is the file's own and stays itself; the deleted
+// Space comes back as a Space of its own. It took the default Space over:
+// renamed it, and put its pins there.
+TEST_F(SidebarFileDefaultSpaceB09Test,
+       ADeletedSpaceComesBackBesideTheDefaultSpace) {
+  const SpaceId home = model().active_id();
+  const SpaceId work_id = MakeDefaultAndWork();
+  const std::string json = PlanToJson(SnapshotWindow(browser()));
+  DeleteWork(work_id);
+
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(json);
+  ASSERT_TRUE(plan.has_value());
+  ASSERT_EQ(2u, plan->spaces.size());
+  const ArcImportResult result =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  ExpectWorkCameBack(home, result);
+}
+
+// P10-1a, import I18 and I20: the same with the deleted Space ahead of the
+// default one in the file. The first Space of the file not here does not
+// take over a default Space the file names further on.
+TEST_F(SidebarFileDefaultSpaceB09Test,
+       ADeletedSpaceAheadOfTheDefaultSpaceComesBackBesideIt) {
+  const SpaceId home = model().active_id();
+  const SpaceId work_id = MakeDefaultAndWork();
+  ASSERT_TRUE(model().MoveSpace(work_id, -1));
+  ASSERT_EQ(work_id, model().spaces().front()->id());
+  const std::string json = PlanToJson(SnapshotWindow(browser()));
+  DeleteWork(work_id);
+
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(json);
+  ASSERT_TRUE(plan.has_value());
+  ASSERT_EQ(2u, plan->spaces.size());
+  ASSERT_EQ("Work", plan->spaces[0].title) << "Work is first in the file";
+  const ArcImportResult result =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  ExpectWorkCameBack(home, result);
+}
+
+}  // namespace
+}  // namespace spaces
