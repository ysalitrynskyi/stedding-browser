+// Z23: `family`'s chords in `layout`, every member's, as one list.
+std::vector<shortcuts::Chord> LayoutChords(
+    const shortcuts::Entry& family,
+    shortcuts::NumberKeys layout,
+    const std::vector<shortcuts::Binding>& defaults) {
+  std::vector<shortcuts::Chord> chords;
+  for (const std::vector<shortcuts::Chord>& member :
+       shortcuts::NumberKeysChords(family, layout, defaults)) {
+    for (const shortcuts::Chord& chord : member) {
+      if (std::ranges::find(chords, chord) == chords.end()) {
+        chords.push_back(chord);
+      }
+    }
+  }
+  return chords;
+}
+
+// Z23: the layouts of the number keys as the menu under the Space row lists
+// them, each naming both sets' keys; the shipped one says so.
+base::ListValue NumberKeysAsValue(
+    shortcuts::NumberKeys current,
+    const std::vector<shortcuts::Binding>& defaults) {
+  const shortcuts::Entry* const rows =
+      shortcuts::EntryForCommand(IDC_SELECT_TAB_0);
+  const shortcuts::Entry* const spaces =
+      shortcuts::EntryForCommand(IDC_STEDDING_SPACE_1);
+  base::ListValue layouts;
+  if (!rows || !spaces) {
+    return layouts;
+  }
+  for (shortcuts::NumberKeys layout : shortcuts::kAllNumberKeys) {
+    const std::u16string rows_text =
+        FamilyText(LayoutChords(*rows, layout, defaults));
+    const std::u16string spaces_text =
+        FamilyText(LayoutChords(*spaces, layout, defaults));
+    const bool spaces_first = layout == shortcuts::NumberKeys::kSpacesFirst ||
+                              layout ==
+                                  shortcuts::NumberKeys::kSpacesFirstRowsThird;
+    std::u16string text =
+        spaces_first
+            ? base::StrCat({u"Spaces on ", spaces_text, u", rows on ",
+                            rows_text})
+            : base::StrCat({u"Rows on ", rows_text, u", Spaces on ",
+                            spaces_text});
+    if (layout == shortcuts::NumberKeys::kRowsFirst) {
+      text += u" (default)";
+    }
+    base::DictValue value;
+    value.Set("value", shortcuts::NumberKeysName(layout));
+    value.Set("text", text);
+    value.Set("selected", layout == current);
+    layouts.Append(std::move(value));
+  }
+  return layouts;
+}
