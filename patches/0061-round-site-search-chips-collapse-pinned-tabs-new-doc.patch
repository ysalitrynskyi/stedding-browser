+  SpaceId work = SpaceId::GenerateNew();
+  {
+    SpaceRegistry registry(&prefs);
+    work = registry.Add("Work", SK_ColorBLUE);
+    registry.Add("Play", SK_ColorGREEN);
+    ChangeCounter counter;
+    registry.AddObserver(&counter);
+    registry.SetPinsCollapsed(work, true);
+    registry.SetPinsCollapsed(work, true);
+    registry.SetPinsCollapsed(SpaceId::GenerateNew(), true);
+    registry.RemoveObserver(&counter);
+    EXPECT_EQ(1, counter.changes);
+  }
+  SpaceRegistry again(&prefs);
+  ASSERT_EQ(2u, again.entries().size());
+  ASSERT_TRUE(again.Find(work));
