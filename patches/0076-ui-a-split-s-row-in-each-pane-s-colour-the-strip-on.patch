+// The horizontal centre of `rect`, to the half DIP: a box an odd number of
+// DIP wide centres between two.
+double CentreX(const gfx::Rect& rect) {
+  return rect.x() + rect.width() / 2.0;
+}
+
+// The centre across the screen of the image `button` draws, or nothing when
+// it draws none. LabelButton keeps its image view protected; it is a child.
+std::optional<double> ImageCentreX(views::View* button) {
+  if (!button || !button->IsDrawn()) {
+    return std::nullopt;
+  }
+  for (views::View* const child : button->children()) {
+    if (auto* const image = views::AsViewClass<views::ImageView>(child);
+        image && image->GetVisible() && !image->size().IsEmpty()) {
+      return CentreX(image->GetBoundsInScreen());
+    }
+  }
+  return std::nullopt;
+}
+
+// Paints every view under `parent` that has a layer of its own, and what
+// draws in that layer, onto `canvas` over what is there: the compositor
+// stacks a child's layer over its parent's, and a view's own paint leaves
+// out the views with layers under it. `canvas` holds `origin`'s pixels at
+// `scale`.
+void PaintChildLayers(views::View* parent,
+                      views::View* origin,
+                      float scale,
+                      SkCanvas& canvas) {
+  for (views::View* const child : parent->children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    ui::Layer* const layer = child->layer();
+    if (!layer) {
+      PaintChildLayers(child, origin, scale, canvas);
+      continue;
+    }
+    if (!layer->GetTargetVisibility() || layer->GetTargetOpacity() == 0.f ||
+        child->size().IsEmpty()) {
+      continue;
+    }
+    SkBitmap own;
+    {
+      ui::CanvasPainter painter(&own, child->size(), scale, SK_ColorTRANSPARENT,
+                                /*is_pixel_canvas=*/false);
+      child->Paint(views::PaintInfo::CreateRootPaintInfo(painter.context(),
+                                                         child->size()));
+    }
+    const gfx::Point at =
+        views::View::ConvertPointToTarget(child, origin, gfx::Point());
+    canvas.drawImage(own.asImage(), at.x() * scale, at.y() * scale);
+    PaintChildLayers(child, origin, scale, canvas);
+  }
+}
+
+// The runs of ink `view` draws, left to right, each as its left and right
+// edges across the screen in DIP: stretches of pixel columns with ink in
+// them, two runs at least 2 DIP apart. `view` is painted with the rest of
+// its layer, at twice its size as the Mac draws it, with the views in it
+// that have layers of their own over it, as the screen shows them -- on
+// Windows a LabelButton's image is on a layer of its own, and the Space title
+// row's glyph read as missing without it -- and only the pixels inside it are
+// read. Ink is any pixel well unlike the one at its top left corner, the
+// ground it is drawn on.
+std::vector<std::pair<double, double>> InkRuns(views::View* view) {
+  std::vector<std::pair<double, double>> runs;
+  if (!view || !view->IsDrawn()) {
+    return runs;
+  }
+  views::View* layer_root = view;
+  while (layer_root->parent() && !layer_root->layer()) {
+    layer_root = layer_root->parent();
+  }
+  constexpr float kScale = 2.f;
+  SkBitmap bitmap;
+  {
+    ui::CanvasPainter painter(&bitmap, layer_root->size(), kScale,
+                              SK_ColorTRANSPARENT, /*is_pixel_canvas=*/false);
+    layer_root->Paint(views::PaintInfo::CreateRootPaintInfo(
+        painter.context(), layer_root->size()));
+  }
+  {
+    SkCanvas canvas(bitmap);
+    PaintChildLayers(view, layer_root, kScale, canvas);
+  }
+  gfx::Rect pixels = gfx::ScaleToEnclosedRect(
+      views::View::ConvertRectToTarget(view, layer_root,
+                                       view->GetLocalBounds()),
+      kScale);
+  pixels.Intersect(gfx::Rect(bitmap.width(), bitmap.height()));
+  if (pixels.IsEmpty()) {
+    return runs;
+  }
+  const SkColor ground = bitmap.getColor(pixels.x(), pixels.y());
+  const auto inked = [&](int x) {
+    for (int y = pixels.y(); y < pixels.bottom(); ++y) {
+      const SkColor pixel = bitmap.getColor(x, y);
+      const int difference =
+          std::abs(static_cast<int>(SkColorGetA(pixel)) -
+                   static_cast<int>(SkColorGetA(ground))) +
+          std::abs(static_cast<int>(SkColorGetR(pixel)) -
+                   static_cast<int>(SkColorGetR(ground))) +
+          std::abs(static_cast<int>(SkColorGetG(pixel)) -
+                   static_cast<int>(SkColorGetG(ground))) +
+          std::abs(static_cast<int>(SkColorGetB(pixel)) -
+                   static_cast<int>(SkColorGetB(ground)));
+      if (difference > 96) {
+        return true;
+      }
+    }
+    return false;
+  };
+  const double left = view->GetBoundsInScreen().x();
+  const auto edges = [&](int first, int last) {
+    return std::make_pair(left + (first - pixels.x()) / kScale,
+                          left + (last + 1 - pixels.x()) / kScale);
+  };
+  std::optional<int> first;
+  int last = 0;
+  for (int x = pixels.x(); x < pixels.right(); ++x) {
+    if (!inked(x)) {
+      continue;
+    }
+    if (first && x - last > 2 * kScale) {
+      runs.push_back(edges(*first, last));
+      first.reset();
+    }
+    if (!first) {
+      first = x;
+    }
+    last = x;
+  }
+  if (first) {
+    runs.push_back(edges(*first, last));
+  }
+  return runs;
+}
+
+// The centre across the screen of the `index`th run of ink `view` draws.
+std::optional<double> InkCentreX(views::View* view, size_t index = 0) {
+  const std::vector<std::pair<double, double>> runs = InkRuns(view);
+  if (runs.size() <= index) {
+    return std::nullopt;
+  }
+  return (runs[index].first + runs[index].second) / 2;
+}
