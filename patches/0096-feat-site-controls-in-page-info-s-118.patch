+// site-controls Si8: Clear asks first, page info gone, the question naming
+// the site; Cancel keeps the cookie. A page that left the site while the
+// question was open is not cleared: the question named another site.
+IN_PROC_BROWSER_TEST_F(SiteControlsTest,
+                       ClearAsksFirstAndCancelKeepsEverything) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), Url("site.test", "/set-cookie?kept=1")));
+  ASSERT_EQ("kept=1", CookieHeader(page(), "site.test"));
+  {
+    SCOPED_TRACE("Cancel");
+    SiteControlsRowsView* const rows = Rows(OpenFromTheChip());
+    ASSERT_TRUE(rows);
+    views::Widget* const question = QuestionAfter(
+        base::BindLambdaForTesting([&]() { Click(rows->clear_data()); }));
+    ASSERT_TRUE(question);
+    EXPECT_TRUE(PanelGoes()) << "page info stays under the question";
+    EXPECT_EQ(u"Clear data for site.test?",
+              question->widget_delegate()->GetWindowTitle());
+    EXPECT_NE(std::u16string::npos,
+              TextUnder(question->GetRootView()).find(u"signed out"));
+    views::test::CancelDialog(question);
+    EXPECT_EQ("kept=1", CookieHeader(page(), "site.test"))
+        << "Cancel cleared the site";
+  }
+  {
+    SCOPED_TRACE("the page left the site while the question was open");
+    SiteControlsRowsView* const rows = Rows(OpenFromTheChip());
+    ASSERT_TRUE(rows);
+    views::Widget* const question = QuestionAfter(
+        base::BindLambdaForTesting([&]() { Click(rows->clear_data()); }));
+    ASSERT_TRUE(question);
+    ASSERT_TRUE(content::NavigateToURL(page(), Url("other.test")));
+    views::test::AcceptDialog(question);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ("kept=1", CookieHeader(page(), "site.test"))
+        << "the question named site.test in this page; it had left";
+  }
+}
