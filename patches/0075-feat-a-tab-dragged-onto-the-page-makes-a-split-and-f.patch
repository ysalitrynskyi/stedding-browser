+// The highlight sits a card's gutter inside its half, with the page card's
+// corners, and says what a drop does.
+constexpr int kGutter = 6;
+constexpr float kRadius = 10.f;
+constexpr float kStroke = 2.f;
+constexpr SkAlpha kFillAlpha = 0x38;
+constexpr SkAlpha kStrokeAlpha = 0xE6;
+
+// splits J10 (GitHub issue 7): the half the dropped page will take, lit in
+// the active Space's colour, with Chromium's "Create split view" in a pill of
+// that colour. It takes no events: the drag has the pointer.
+class SplitDropHighlight : public views::View {
+  METADATA_HEADER(SplitDropHighlight, views::View)
+
+ public:
+  explicit SplitDropHighlight(SkColor color) : color_(color) {
+    SetPaintToLayer();
+    layer()->SetFillsBoundsOpaquely(false);
+    layer()->SetName("SteddingSplitDropHighlight");
+    SetCanProcessEventsWithinSubtree(false);
+    auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical));
+    layout->set_main_axis_alignment(
+        views::BoxLayout::MainAxisAlignment::kCenter);
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    auto label = std::make_unique<views::Label>(
+        l10n_util::GetStringUTF16(IDS_SPLIT_VIEW_DRAG_ENTRYPOINT_LABEL));
+    label->SetAutoColorReadabilityEnabled(false);
+    label->SetEnabledColor(color_utils::GetColorWithMaxContrast(color));
+    label->SetBackground(views::CreateRoundedRectBackground(color, 14));
+    label->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(6, 14)));
+    AddChildView(std::move(label));
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    gfx::RectF bounds(GetLocalBounds());
+    flags.setColor(SkColorSetA(color_, kFillAlpha));
+    canvas->DrawRoundRect(bounds, kRadius, flags);
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(kStroke);
+    flags.setColor(SkColorSetA(color_, kStrokeAlpha));
+    bounds.Inset(kStroke / 2);
+    canvas->DrawRoundRect(bounds, kRadius, flags);
+  }
+
+ private:
+  const SkColor color_;
+};
