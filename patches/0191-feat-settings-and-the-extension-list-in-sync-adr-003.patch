+// Sf61: a route travels by the synced Space it names, under the shared id
+// the join gave it, and lands on the paired Space here; a route to a Space
+// that is not synced stays here, and another computer's routes never
+// remove it.
+TEST(SidebarSyncSettingsTest, RoutesTravelByTheSyncedSpace) {
+  const SettingRule* const routes =
+      FindSettingRule(stedding::prefs::kSpaceRoutes);
+  ASSERT_TRUE(routes);
+  SpaceMap office;
+  office.to_shared = {{"OFFICE_WORK", "SHARED_WORK"}};
+  office.to_local = {{"SHARED_WORK", "OFFICE_WORK"}};
+  base::ListValue office_routes;
+  office_routes.Append(Route("github.com", "OFFICE_WORK"));
+  office_routes.Append(Route("bank.example", "OFFICE_PRIVATE"));
+  const std::optional<base::Value> wire =
+      SettingToWire(*routes, base::Value(office_routes.Clone()), office);
+  ASSERT_TRUE(wire);
+  ASSERT_EQ(1u, wire->GetList().size());
+  EXPECT_EQ("SHARED_WORK", *wire->GetList()[0].GetDict().FindString("space"));
+
+  SpaceMap laptop;
+  laptop.to_shared = {{"LAPTOP_WORK", "SHARED_WORK"}};
+  laptop.to_local = {{"SHARED_WORK", "LAPTOP_WORK"}};
+  base::ListValue laptop_routes;
+  laptop_routes.Append(Route("news.example", "LAPTOP_ONLY"));
+  const std::optional<base::Value> applied = SettingFromWire(
+      *routes, *wire, base::Value(std::move(laptop_routes)), laptop);
+  ASSERT_TRUE(applied);
+  const base::ListValue& list = applied->GetList();
+  ASSERT_EQ(2u, list.size());
+  EXPECT_EQ("github.com", *list[0].GetDict().FindString("pattern"));
+  EXPECT_EQ("LAPTOP_WORK", *list[0].GetDict().FindString("space"));
+  EXPECT_EQ("LAPTOP_ONLY", *list[1].GetDict().FindString("space"));
+
+  // The default Space for links from other apps: by the shared id, and not
+  // at all when it names a Space that is not synced.
+  const SettingRule* const external =
+      FindSettingRule(stedding::prefs::kExternalDefaultSpace);
+  ASSERT_TRUE(external);
+  EXPECT_EQ(base::Value("SHARED_WORK"),
+            *SettingToWire(*external, base::Value("OFFICE_WORK"), office));
+  EXPECT_FALSE(SettingToWire(*external, base::Value("OFFICE_PRIVATE"), office));
+  EXPECT_EQ(base::Value("LAPTOP_WORK"),
+            *SettingFromWire(*external, base::Value("SHARED_WORK"),
+                             base::Value(""), laptop));
+  EXPECT_FALSE(SettingFromWire(*external, base::Value("SHARED_ELSE"),
+                               base::Value(""), laptop));
+}
