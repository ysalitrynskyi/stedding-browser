+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_recipe.h"
+#include "ui/color/color_transform.h"
+
+namespace stedding {
+
+PageBarColorSupplier::PageBarColorSupplier(SkColor page) : page_(page) {}
+
+PageBarColorSupplier::~PageBarColorSupplier() = default;
+
+void PageBarColorSupplier::AddColorMixers(
+    ui::ColorProvider* provider,
+    const ui::ColorProviderKey& key) const {
+  ui::ColorMixer& mixer = provider->AddMixer();
+  // The bar as painted: the page colour over the toolbar's ground.
+  const ui::ColorTransform bar =
+      ui::AlphaBlend(ui::ColorTransform(page_), kColorToolbar, kPageBarAlpha);
+  // White on a dark bar, near-black on a light one.
+  const ui::ColorTransform fg = ui::GetColorWithMaxContrast(bar);
+  mixer[kColorToolbarButtonIcon] = fg;
+  mixer[kColorToolbarButtonIconHovered] = fg;
+  mixer[kColorToolbarButtonIconPressed] = fg;
+  mixer[kColorToolbarButtonIconInactive] = ui::SetAlpha(fg, 0x99);
+  mixer[kColorToolbarText] = fg;
+  mixer[kColorToolbarTextDisabled] = ui::SetAlpha(fg, 0x66);
+  mixer[kColorOmniboxText] = fg;
+  mixer[kColorOmniboxTextDimmed] = ui::SetAlpha(fg, 0xB3);
+  mixer[kColorOmniboxSecurityChipDefault] = fg;
+  mixer[kColorOmniboxSecurityChipSecure] = fg;
+  // The quiet hover tint behind the URL text follows the text (UI-SPEC), as
+  // does the page-info chip's capsule (a white capsule sat on a dark bar).
+  mixer[kColorLocationBarBackgroundHovered] = ui::SetAlpha(fg, 0x14);
+  mixer[kColorOmniboxIconBackground] = ui::SetAlpha(fg, 0x1A);
+  // No hairline between the bar and the card: the separator is the bar.
+  mixer[kColorToolbarContentAreaSeparator] = bar;
+}
+
+}  // namespace stedding
