@@ -299,5 +299,61 @@ TEST_F(FolderCommandsTest, APrivateWindowsFoldersCollapseToo) {
   strip->CloseAllTabs();
 }
 
+// folders F37 (BACKLOG S-139): Move to Space on a tab inside a folder takes
+// the tab out of every folder it is in, to just after the outermost one, and
+// files it in the other Space. The folder keeps its other tabs and stays in
+// its Space; tabs moved together keep their order; a folder the move empties
+// leaves the tree. The tab stayed in its folder, which then showed in both
+// Spaces with one name and one collapsed state.
+TEST_F(FolderCommandsTest, MoveToSpaceTakesATabOutOfItsFolder) {
+  // The strip reads a, b, c, d, loose.
+  tabs::TabInterface* const loose = OpenTab(GURL("https://loose.test/"));
+  tabs::TabInterface* const d = OpenTab(GURL("https://d.test/"));
+  tabs::TabInterface* const c = OpenTab(GURL("https://c.test/"));
+  tabs::TabInterface* const b = OpenTab(GURL("https://b.test/"));
+  tabs::TabInterface* const a = OpenTab(GURL("https://a.test/"));
+  ASSERT_EQ(5, tabs().count());
+  // a and b in a folder, c in a folder nested in it.
+  tabs::FolderTabCollection* const outer = tabs().AddToNewFolder({0, 1, 2});
+  ASSERT_TRUE(outer);
+  tabs::FolderTabCollection* const inner =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(c)}, outer);
+  ASSERT_TRUE(inner);
+  ASSERT_EQ(3u, outer->TabCountRecursive());
+  const SpaceId home = model().active_id();
+  const SpaceId work = model().AddSpace("Work", kBlue)->id();
+
+  const auto in_a_folder = [](const tabs::TabInterface* tab) {
+    for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+         each = each->GetParentCollection()) {
+      if (each->type() == tabs::TabCollection::Type::FOLDER) {
+        return true;
+      }
+    }
+    return false;
+  };
+
+  model().MoveTabsToSpace({b, c}, work);
+  EXPECT_FALSE(in_a_folder(b));
+  EXPECT_FALSE(in_a_folder(c)) << "a nested folder's tab stayed in a folder";
+  EXPECT_TRUE(in_a_folder(a)) << "the folder lost a tab that did not move";
+  EXPECT_EQ(1u, outer->TabCountRecursive());
+  EXPECT_EQ(1u, outer->GetChildren().size())
+      << "the nested folder the move emptied stayed in the tree";
+  // Just after the folder, in their order.
+  EXPECT_EQ(0, tabs().GetIndexOfTab(a));
+  EXPECT_EQ(1, tabs().GetIndexOfTab(b));
+  EXPECT_EQ(2, tabs().GetIndexOfTab(c));
+  EXPECT_EQ(3, tabs().GetIndexOfTab(d));
+  EXPECT_EQ(work, model().SpaceForTab(b));
+  EXPECT_EQ(work, model().SpaceForTab(c));
+  EXPECT_EQ(home, model().SpaceForTab(a));
+
+  // A tab in no folder moves as before, staying where it is in the strip.
+  model().MoveTabsToSpace({loose}, work);
+  EXPECT_EQ(4, tabs().GetIndexOfTab(loose));
+  EXPECT_EQ(work, model().SpaceForTab(loose));
+}
+
