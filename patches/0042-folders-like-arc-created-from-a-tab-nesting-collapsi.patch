+FolderTabCollection* TabStripCollection::MoveTabsToNewFolderRecursive(
+    const std::vector<int>& tab_indices,
+    size_t destination_index,
+    std::unique_ptr<FolderTabCollection> folder,
+    FolderTabCollection* parent_folder) {
+  CHECK(folder);
+  FolderTabCollection* const folder_ptr = folder.get();
+
+  // Whole selected folders and splits move as units, exactly as splits do in
+  // MoveTabsRecursive.
+  static const TabCollection::TypeEnumSet kRetain = {
+      TabCollection::Type::SPLIT, TabCollection::Type::FOLDER};
+  ChildrenPtrs tab_or_collections =
+      GetTabsAndCollectionsForMove(tab_indices, kRetain);
+
+  // Attach the folder: in the unpinned area at the destination, or appended
+  // inside an existing folder, which is what nesting is.
+  TabCollection::Position folder_position;
+  if (parent_folder) {
+    folder_position = {parent_folder->GetHandle(),
+                       parent_folder->ChildCount()};
+  } else {
+    folder_position = GetMovePosition(tab_or_collections, destination_index,
+                                      std::nullopt, false);
+  }
+  AddTabCollectionImpl(std::move(folder), folder_position);
+
+  TabCollection::Position move_position = {folder_ptr->GetHandle(), 0};
+  for (auto& tab_or_collection : tab_or_collections) {
+    TabCollection* src_parent_collection = nullptr;
+    if (std::holds_alternative<DanglingUntriagedTabInterface>(
+            tab_or_collection)) {
+      TabInterface* tab_ptr =
+          std::get<DanglingUntriagedTabInterface>(tab_or_collection);
+      src_parent_collection = tab_ptr->GetParentCollection(GetPassKey());
+      MoveTabImpl(tab_ptr, move_position);
+    } else {
+      TabCollection* collection_ptr =
+          std::get<DanglingUntriagedTabCollection>(tab_or_collection);
+      src_parent_collection = collection_ptr->GetParentCollection();
+      MoveCollectionImpl(collection_ptr, move_position);
+    }
+
+    // Remove previous collection if needed. This also notifies the
+    // collection is removed.
+    if (src_parent_collection != unpinned_collection_ &&
+        src_parent_collection != pinned_collection_ &&
+        src_parent_collection->TabCountRecursive() == 0) {
+      RemoveTabCollectionImpl(src_parent_collection);
+    }
+
+    move_position = GetNodePosition(tab_or_collection);
+    move_position.index += 1;
+  }
+  return folder_ptr;
+}
