+++ b/chrome/browser/ui/stedding/site_controls.cc
@@ -0,0 +1,123 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/site_controls.h"
+
+#include <algorithm>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "chrome/browser/ui/spaces/isolation_mark.h"
+#include "chrome/grit/generated_resources.h"
+#include "net/base/is_potentially_trustworthy.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+bool InATab(SiteControlsWindow window) {
+  return window != SiteControlsWindow::kOther;
+}
+
+// The Space whose storage-partition token is `partition_name`, or null.
+const SpaceJarEntry* SpaceOwning(std::string_view partition_name,
+                                 const std::vector<SpaceJarEntry>& spaces) {
+  if (partition_name.empty()) {
+    return nullptr;
+  }
+  const auto it = std::ranges::find_if(
+      spaces, [partition_name](const SpaceJarEntry& space) {
+        return space.profile_id == partition_name;
+      });
+  return it == spaces.end() ? nullptr : &*it;
+}
+
+}  // namespace
+
+SiteControlsRows RowsFor(const SiteControlsContext& context) {
+  SiteControlsRows rows;
+  if (!InATab(context.window)) {
+    return rows;
+  }
+  const bool web = context.url.is_valid() && context.url.SchemeIsHTTPOrHTTPS();
+  rows.strip = true;
+  // sessions S32: only a window with the profile's Spaces has jars to name.
+  rows.session = context.window == SiteControlsWindow::kTab;
+  // commandbar K24's rule: a site is a web page's registrable domain.
+  rows.clear_data = web;
+  // dark-pages Dk9: the browser's own pages never reach this panel; page
+  // info shows them its internal bubble.
+  rows.dark_switch = true;
+  // Dk15, Dk19: a site's choice, while the switch is on, for a web page.
+  rows.dark_site = context.dark_pages_on && web;
+  return rows;
+}
+
+SessionName SessionNameFor(bool space_jar,
+                           std::string_view partition_name,
+                           const std::vector<SpaceJarEntry>& spaces) {
+  if (!space_jar) {
+    return {
+        l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_SHARED_SESSION),
+        /*marked=*/false};
+  }
+  const SpaceJarEntry* const space = SpaceOwning(partition_name, spaces);
+  if (!space) {
+    return {spaces::IsolationMarkName(), /*marked=*/false};
+  }
+  if (!space->isolated) {
+    return {l10n_util::GetStringFUTF16(
+                IDS_STEDDING_SITE_CONTROLS_PREVIOUS_SESSION, space->name),
+            /*marked=*/false};
+  }
+  return {spaces::NameWithIsolationMark(space->name), /*marked=*/true};
+}
+
+ClearSiteDataQuestion ClearSiteDataQuestionFor(
+    std::u16string_view domain,
+    bool off_the_record,
+    bool space_jar,
+    std::string_view partition_name,
+    const std::vector<SpaceJarEntry>& spaces) {
+  const std::u16string site(domain);
+  ClearSiteDataQuestion question;
+  question.title = l10n_util::GetStringFUTF16(
+      IDS_STEDDING_SITE_CONTROLS_CLEAR_QUESTION_TITLE, site);
+  question.action =
+      l10n_util::GetStringUTF16(IDS_STEDDING_SITE_CONTROLS_CLEAR_QUESTION_OK);
+  if (off_the_record) {
+    question.body = l10n_util::GetStringFUTF16(
+        IDS_STEDDING_SITE_CONTROLS_CLEAR_QUESTION_PRIVATE, site);
+    return question;
+  }
+  if (!space_jar) {
+    question.body = l10n_util::GetStringFUTF16(
+        IDS_STEDDING_SITE_CONTROLS_CLEAR_QUESTION_SHARED, site);
+    return question;
+  }
+  // A Space's own jar is named by its Space whether or not its session is on
+  // now: the data goes from the jar the page lives in (Si7).
+  if (const SpaceJarEntry* const space = SpaceOwning(partition_name, spaces)) {
+    question.body = l10n_util::GetStringFUTF16(
+        IDS_STEDDING_SITE_CONTROLS_CLEAR_QUESTION_SPACE, site, space->name);
+    return question;
+  }
+  question.body = l10n_util::GetStringFUTF16(
+      IDS_STEDDING_SITE_CONTROLS_CLEAR_QUESTION_INDEPENDENT, site);
+  return question;
+}
+
+std::vector<ContentSettingsType> AlwaysListedPermissions(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+      !net::IsUrlPotentiallyTrustworthy(url)) {
+    return {};
+  }
+  return {ContentSettingsType::MEDIASTREAM_CAMERA,
+          ContentSettingsType::MEDIASTREAM_MIC};
+}
+
+}  // namespace stedding
