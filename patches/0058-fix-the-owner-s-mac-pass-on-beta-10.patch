+bool VerticalTabStripRegionView::SpaceSwipeHasNeighbour(bool forward) const {
+  const spaces::SpaceModel* const model =
+      spaces::SpaceModel::From(browser_view()->browser());
+  if (!model) {
+    return false;
+  }
+  const auto& all = model->spaces();
+  for (size_t i = 0; i < all.size(); ++i) {
+    if (all[i]->id() == model->active_id()) {
+      return forward ? i + 1 < all.size() : i > 0;
+    }
+  }
+  return false;
+}
+
+std::vector<views::View*> VerticalTabStripRegionView::SpaceSwipeViews() {
+  std::vector<views::View*> views;
+  auto* const strip = static_cast<TabStripView*>(tab_strip_view());
+  if (!strip) {
+    return views;
+  }
+  if (views::View* const title = strip->GetSpaceTitleRow();
+      title && title->GetVisible()) {
+    views.push_back(title);
+  }
+  if (views::View* const list = strip->unpinned_tabs_scroll_view()) {
+    views.push_back(list);
+  }
+  for (views::View* const view : views) {
+    if (!view->layer()) {
+      view->SetPaintToLayer();
+      view->layer()->SetFillsBoundsOpaquely(false);
+    }
+  }
+  return views;
+}
+
+void VerticalTabStripRegionView::OnSpaceSwipeProgress(float offset) {
+  space_swipe_switching_ = false;
+  if (!stedding::ShouldAnimate(browser_view()->GetProfile()->GetPrefs())) {
+    return;
+  }
+  const std::vector<views::View*> moving = SpaceSwipeViews();
+  if (moving.empty()) {
+    return;
+  }
+  // Swiping left brings in the next Space; mirrored right to left.
+  const bool forward = (offset < 0) != base::i18n::IsRTL();
+  const bool has_neighbour = SpaceSwipeHasNeighbour(forward);
+  const float width = static_cast<float>(moving.back()->width());
+  gfx::Transform shift;
+  shift.Translate(stedding::SpaceSwipeShift(offset, width, has_neighbour), 0);
+  const float opacity =
+      stedding::SpaceSwipeOpacity(offset, width, has_neighbour);
+  for (views::View* const view : moving) {
+    ui::Layer* const layer = view->layer();
+    layer->GetAnimator()->StopAnimating();
+    layer->SetTransform(shift);
+    layer->SetOpacity(opacity);
+  }
+}
+
+void VerticalTabStripRegionView::OnSpaceSwipeEnd(float offset, bool flick) {
+  spaces::SpaceModel* const model =
+      spaces::SpaceModel::From(browser_view()->browser());
+  const std::vector<views::View*> moving = SpaceSwipeViews();
+  const bool forward = (offset < 0) != base::i18n::IsRTL();
+  const float width =
+      moving.empty() ? 0.0f : static_cast<float>(moving.back()->width());
+  if (model && SpaceSwipeHasNeighbour(forward) &&
+      stedding::SpaceSwipeCommits(offset, width, flick)) {
+    // SlideInSpaceList runs inside the switch and brings the new Space in
+    // from the side the fingers left.
+    space_swipe_switching_ =
+        stedding::ShouldAnimate(browser_view()->GetProfile()->GetPrefs());
+    const spaces::SpaceId before = model->active_id();
+    model->SwitchToNeighbour(forward);
+    const bool slid = !space_swipe_switching_;
+    space_swipe_switching_ = false;
+    if (slid && model->active_id() != before) {
+      return;
+    }
+  }
+  // Back where they were: a swipe too short to switch, the end of the
+  // switcher, or a switch that brought nothing in.
+  for (views::View* const view : moving) {
+    ui::Layer* const layer = view->layer();
+    if (layer->transform().IsIdentity() && layer->opacity() == 1.0f) {
+      continue;
+    }
+    ui::ScopedLayerAnimationSettings settings(layer->GetAnimator());
+    settings.SetPreemptionStrategy(
+        ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET);
+    settings.SetTransitionDuration(
+        base::Milliseconds(stedding::kSpaceSwipeSettleMs));
+    settings.SetTweenType(gfx::Tween::EASE_OUT);
+    layer->SetTransform(gfx::Transform());
+    layer->SetOpacity(1.0f);
+  }
 }
 
