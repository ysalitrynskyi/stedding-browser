+        VerticalTabStripRegionView::IsMostlyOverStrip(browser_view(), buttons))
+        << "over the rail they keep the bar's colours";
+  }
+}
+#endif  // BUILDFLAG(IS_WIN)
+
+// Y43: right to left, the sidebar is on the right by default, and Left
+// moves it to the window's left with every mirror above reversed: the
+// handle on its right and the left edge revealing it.
+class SidebarRightRtlTest : public SidebarFormsRtlTest {
+ protected:
+  void SetUpOnMainThread() override {
+    SidebarFormsRtlTest::SetUpOnMainThread();
+    ASSERT_TRUE(prefs()->GetBoolean(stedding::prefs::kSidebarOnRight))
+        << "the right, by default, right to left";
+    prefs()->SetBoolean(stedding::prefs::kSidebarOnRight, false);
+    RunScheduledLayouts();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SidebarRightRtlTest, LeftInARightToLeftLayout) {
+  ASSERT_TRUE(base::i18n::IsRTL());
+  AppendTab();
+  Settle();
+  ASSERT_TRUE(region()->IsAtTrailingEdge());
+  ASSERT_FALSE(region()->IsOnRight());
+  EXPECT_EQ(Window().x(), Strip().x());
+  EXPECT_EQ(Strip().right() + stedding::kCardGutter.Get(), Page().x());
+
+  views::View* const handle = region()->resize_area_for_testing();
+  ASSERT_TRUE(handle->GetVisible());
+  const int y = Page().CenterPoint().y();
+  for (int x = Strip().right() - 4; x < Page().x(); ++x) {
+    EXPECT_EQ(handle, root()->GetEventHandlerForPoint(gfx::Point(x, y)))
+        << "x " << x << ": the strip ends at " << Strip().right()
+        << ", the card starts at " << Page().x();
+  }
+
+  CloseTo(stedding::prefs::kSidebarClosedHidden);
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  region()->SetHoveredForTesting(false);
+  region()->OnPointerAtForTesting(
+      gfx::Point(browser_view()->width() - 2, browser_view()->height() / 2));
+  EXPECT_FALSE(region()->is_expanded_on_hover()) << "not the right edge";
+  region()->OnPointerAtForTesting(LeadingEdge());
+  ASSERT_TRUE(region()->is_expanded_on_hover()) << HoverState();
+  region()->SetHoveredForTesting(true);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return region()->is_expanded_on_hover() && !Animating(); }))
+      << HoverState();
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  EXPECT_EQ(Window().x(), Strip().x()) << "in from the left";
+  region()->SetHoveredForTesting(false);
+  const gfx::Point centre = region()->GetLocalBounds().CenterPoint();
+  region()->OnMouseExited(ui::MouseEvent(ui::EventType::kMouseExited, centre,
+                                         centre, base::TimeTicks::Now(),
+                                         ui::EF_NONE, ui::EF_NONE));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !region()->is_expanded_on_hover() && !Animating(); }))
+      << HoverState();
+  region()->SetHoveredForTesting(std::nullopt);
+}
+
+// Y40 and Y43, mirrored: right to left with the sidebar on the left and the
+// window against the screen's left edge, the arrow that would point from
+// left of the sidebar turns and points from inside its right edge, on the
+// screen.
+IN_PROC_BROWSER_TEST_F(SidebarRightRtlTest, TheDropArrowStaysOnTheScreen) {
+  ASSERT_TRUE(base::i18n::IsRTL());
+  AppendTab();
+  Settle();
+  ASSERT_FALSE(region()->IsOnRight());
+  const gfx::Rect screen =
+      display::Screen::Get()
+          ->GetDisplayNearestView(browser_view()->GetWidget()->GetNativeView())
+          .bounds();
+  const int width = std::min(900, screen.width() - 100);
+  const int height = std::min(700, screen.height());
+  ui_test_utils::SetAndWaitForBounds(
+      *browser(), gfx::Rect(screen.x(), screen.y(), width, height));
+  Settle();
+  gfx::Rect room =
+      display::Screen::Get()
+          ->GetDisplayNearestView(browser_view()->GetWidget()->GetNativeView())
+          .bounds();
+  DropArrow::MaybeAdjustDisplayBounds(room);
+
+  BrowserRootView::DropIndex index;
+  index.index = browser()->tab_strip_model()->count();
+  index.relative_to_index =
+      BrowserRootView::DropIndex::RelativeToIndex::kInsertBeforeIndex;
+  DropArrow::Direction direction = DropArrow::Direction::kDown;
+  const gfx::Point at = region()->GetLinkDropArrowPosition(index, &direction);
+  ASSERT_EQ(DropArrow::Direction::kRight, direction);
+  ASSERT_LT(at.x() - DropArrow::kSize, room.x())
+      << "the window does not reach the screen's left edge, so this checked "
+         "nothing: the strip starts at "
+      << at.x() << ", the screen at " << room.x();
+
+  const gfx::Rect arrow =
+      region()->GetLinkDropBoundsForTesting(index, &direction);
+  EXPECT_EQ(DropArrow::Direction::kLeft, direction)
+      << "the arrow turns to point from the sidebar's right edge";
+  EXPECT_EQ(region()->GetBoundsInScreen().right(), arrow.x());
+  EXPECT_TRUE(room.Contains(arrow))
+      << arrow.ToString() << " is not on the screen " << room.ToString();
+}
