+      views::CreateSolidBackground(ui::kColorDialogBackground));
+
+  bar_ = card_->AddChildView(std::make_unique<views::View>());
+  auto* const bar_layout =
+      bar_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal,
+          gfx::Insets::TLBR(0, 14, 0, 6), /*between_child_spacing=*/2));
+  bar_layout->set_cross_axis_alignment(
