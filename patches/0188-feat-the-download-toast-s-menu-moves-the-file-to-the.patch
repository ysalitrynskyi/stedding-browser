+                          : base::BindRepeating(&MoveWithTheRealTrash);
+  CreateFileTrashTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const DownloadedFile& file, const MoveFunction& move) {
+            return IsStillTheDownloadsFile(file) && move.Run(file.path);
+          },
+          file, std::move(move)),
+      std::move(done));
+}
