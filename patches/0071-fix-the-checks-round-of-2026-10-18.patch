+// Stedding (BACKLOG S-250): an animating container's flex rule, measured
+// against the row's width alone. Stedding's row is as tall as its back
+// button -- an 18 DIP icon and 4 DIP insets, 26 DIP -- while the containers
+// lay their buttons out at kToolbarButtonHeight, 28 DIP, and the row centres
+// them over its margins. Bounded by the row's height as well, no size a
+// container offered fitted, so the rule measured it again in the width it
+// was given, part of the way through its slide-in, where its button had no
+// room: the row hid the container, the container snapped to no width, and
+// the button it was showing never appeared. Chromium's row is as tall as
+// its buttons, and there the height never decides.
+views::FlexRule MeasuredByWidth(views::FlexRule rule) {
+  return base::BindRepeating(
+      [](const views::FlexRule& rule, const views::View* view,
+         const views::SizeBounds& bounds) {
+        return rule.Run(view,
+                        views::SizeBounds(bounds.width(), views::SizeBound()));
+      },
+      std::move(rule));
+}
