+
+namespace stedding {
+
+// docs/features/private.md V1, V9: a private window's colour key carries, in
+// its app-controller slot, a supplier that marks the window private, and the
+// Stedding mixer paints such a key graphite (IsPrivateColorKey). The slot
+// holds one supplier: SteddingPrivateWindowMark() until the window's address
+// row has a page colour, then the row's own supplier (toolbar T7), which
+// flips the row's icons for contrast with the page and is marked here to
+// stand for the mark as well. A supplier is marked for its whole life and
+// unmarks itself before it goes. UI thread only.
+void SetMarksPrivateWindow(
+    const ui::ColorProviderKey::InitializerSupplier* supplier,
+    bool marks);
+bool MarksPrivateWindow(
+    const ui::ColorProviderKey::InitializerSupplier* supplier);
+
+}  // namespace stedding
