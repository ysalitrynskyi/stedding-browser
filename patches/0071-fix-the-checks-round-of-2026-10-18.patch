+    // The row laid out in the rail's form, as it is by the time a pointer
+    // can reach a chip: the collapse's last frame leaves the layout pending.
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget);
