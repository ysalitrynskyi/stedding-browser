+// sidebar Y50 (BACKLOG S-385): closing to nothing slides the sidebar out
+// whole, and coming back slides it in: at every frame the rows keep the open
+// width and their titles, moved with the edge, and the strip clips them. Laid
+// out at each frame's width they squeezed and turned into the rail on the
+// way. To the rail, the rows still follow the width (Y8).
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, ClosingToNothingSlidesTheRowsWhole) {
+  AppendTab();
+  Settle();
+  ASSERT_FALSE(controller()->IsCollapsed());
+  prefs()->SetInteger(stedding::prefs::kSidebarClosedForm,
+                      stedding::prefs::kSidebarClosedHidden);
+  views::Widget* const window = browser_view()->GetWidget();
+  tabs::TabInterface* const tab = browser()->tab_strip_model()->GetTabAtIndex(0);
+  const auto row = [&]() {
+    return stedding::test::FindDrawnRow(window->GetRootView(), tab);
+  };
+  ASSERT_TRUE(row());
+  const int open_row_width = row()->width();
+  const int open_width = region()->width();
+  ASSERT_GT(open_row_width, 0);
+
+  // Animated whatever the machine's own motion settings say: a remote
+  // session turns rich animations off and may ask for reduced motion.
+  auto rich_animation = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  auto container = base::MakeRefCounted<gfx::AnimationContainer>();
+  BrowserAnimationController::From(browser())->SetAnimationContainerForTesting(
+      TabStripAnimations::kVerticalTabStrip, container.get());
+  gfx::AnimationContainerTestApi clock(container.get());
+  for (const bool collapse : {true, false}) {
+    SCOPED_TRACE(collapse ? "sliding out" : "sliding in");
+    controller()->RequestCollapse(collapse);
+    ASSERT_TRUE(Animating());
+    int frames_between = 0;
+    std::optional<int> slid_row_width;
+    for (int frame = 0; frame < 400 && Animating(); ++frame) {
+      clock.IncrementTime(base::Milliseconds(4));
+      views::test::RunScheduledLayout(window);
+      const int shown = region()->width();
+      if (shown <= 0 || shown >= open_width) {
+        continue;
+      }
+      ++frames_between;
+      TabView* const drawn = row();
+      ASSERT_TRUE(drawn) << "no row at width " << shown;
+      // One width through the slide, about the open one: the rows of a
+      // closing strip lose the card's gutter on the way (Y23).
+      if (!slid_row_width) {
+        slid_row_width = drawn->width();
+      }
+      EXPECT_EQ(*slid_row_width, drawn->width())
+          << "the row squeezed at width " << shown;
+      EXPECT_NEAR(open_row_width, drawn->width(), 8)
+          << "the row is not laid out at the open width at " << shown;
+      EXPECT_TRUE(drawn->title_for_testing()->GetVisible() &&
+                  drawn->title_for_testing()->width() > 0)
+          << "the row took the rail's form at width " << shown;
+    }
+    EXPECT_GT(frames_between, 2) << "no frames between the ends";
+    clock.IncrementTime(base::Seconds(1));
+    Settle();
+    EXPECT_EQ(collapse, controller()->IsCollapsed());
+  }
+  gfx::Animation::UpdatePrefersReducedMotion();
+}
