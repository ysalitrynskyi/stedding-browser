+// Whether the extension `id`'s background has heard `what`, asked for up to
+// ten seconds. `told` gets what it said last.
+bool HeardW2B18(Profile* profile,
+                const extensions::ExtensionId& id,
+                const std::string& what,
+                std::string& told) {
+  for (int i = 0; i < 100; ++i) {
+    base::Value said = extensions::BackgroundScriptExecutor::ExecuteScript(
+        profile, id, "chrome.test.sendScriptResult(told());",
+        extensions::BackgroundScriptExecutor::ResultCapture::kSendScriptResult);
+    told = said.is_string() ? said.GetString() : std::string();
+    if (base::StrCat({",", told, ","}).find(base::StrCat({",", what, ","})) !=
+        std::string::npos) {
+      return true;
+    }
+    base::RunLoop wait;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, wait.QuitClosure(), base::Milliseconds(100));
+    wait.Run();
+  }
+  return false;
+}
