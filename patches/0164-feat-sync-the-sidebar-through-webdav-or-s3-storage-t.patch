+// A server in memory behind a fake loader factory.
+class FakeServer {
+ public:
+  explicit FakeServer(PlaceKind kind)
+      : place(kind),
+        shared(base::MakeRefCounted<
+               network::WeakWrapperSharedURLLoaderFactory>(&factory)) {
+    factory.SetInterceptor(base::BindRepeating(&FakeServer::Answer,
+                                               base::Unretained(this)));
+  }
+
+  std::unique_ptr<PlaceClient> Client(const std::string& secret) {
+    const PlaceForm form =
+        CheckPlaceForm(place.Form(GURL("https://place.example.net/"), secret));
+    return std::make_unique<PlaceClient>(*form.place, *form.sign_in, shared,
+                                         base::DefaultClock::GetInstance());
+  }
+
+  FakePlace place;
+  network::TestURLLoaderFactory factory;
+  scoped_refptr<network::SharedURLLoaderFactory> shared;
+  // Past `FakePlace`, a body this server answers lists with.
+  std::string list_body;
+
+ private:
+  void Answer(const network::ResourceRequest& request) {
+    std::map<std::string, std::string> headers;
+    for (const net::HttpRequestHeaders::HeaderKeyValuePair& header :
+         request.headers.GetHeaderVector()) {
+      headers[base::ToLowerASCII(header.key)] = header.value;
+    }
+    std::string body;
+    if (request.request_body && !request.request_body->elements()->empty()) {
+      body = std::string(request.request_body->elements()
+                             ->front()
+                             .As<network::DataElementBytes>()
+                             .AsStringPiece());
+    }
+    FakePlace::Reply reply =
+        place.Handle(request.method, request.url, headers, body);
+    if (!list_body.empty() && request.method == "PROPFIND") {
+      reply.status = 207;
+      reply.body = list_body;
+    }
+    auto head = network::CreateURLResponseHead(
+        static_cast<net::HttpStatusCode>(reply.status));
+    for (const auto& [name, value] : reply.headers) {
+      head->headers->AddHeader(name, value);
+    }
+    factory.AddResponse(request.url, std::move(head), reply.body,
+                        network::URLLoaderCompletionStatus());
+  }
+};
