+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_SIDEBAR_SYMBOLS_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_SIDEBAR_SYMBOLS_H_
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/image/image_skia.h"
+
+namespace stedding {
+
+// The glyph of a folder row (folders F12): macOS's own "folder" symbol, the
+// family Arc draws its sidebar with, in `color` at `size` points; Chromium's
+// folder icon where the symbol is not available.
+ui::ImageModel FolderGlyph(SkColor color, int size);
+
+// An SF Symbol as an image in `color` at `size` points, or an empty image
+// where there are none (every platform but macOS, or a name macOS does not
+// know).
+gfx::ImageSkia SystemSymbolImage(const char* name, int size, SkColor color);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_SIDEBAR_SYMBOLS_H_
