+
+#ifndef CHROME_BROWSER_UI_VIEWS_STEDDING_SIDEBAR_RESIZE_HANDLE_H_
+#define CHROME_BROWSER_UI_VIEWS_STEDDING_SIDEBAR_RESIZE_HANDLE_H_
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/views/controls/resize_area.h"
+
+namespace gfx {
+class Rect;
+}  // namespace gfx
+
+namespace ui {
+class GestureEvent;
+class MouseEvent;
+}  // namespace ui
+
+namespace views {
+class ResizeAreaDelegate;
+class View;
+}  // namespace views
+
+namespace stedding {
+
+// The edge that resizes the sidebar (sidebar Y18), which shows where to drag
+// it and resets it (sidebar Y22).
+//
+// The edge itself is invisible: only the resize cursor told a person it was
+// there. When the pointer stays on it for kRestDelay, a thin bar is drawn
+// along it; a pointer that only crosses it draws nothing, and leaving it takes
+// the bar away. A press shows the bar at once and it stays through the drag.
+// The bar is kBarThickness DIP wide and rounded, runs the edge's height less
+// kBarEndInset at each end, and lies in the middle of the stretch past the
+// handle that the handle answers for (SetReach: the card's gutter), or along
+// the handle's own trailing edge when that stretch is narrower than the bar.
+// It is on a layer of its own because it is drawn past this view's bounds,
+// and it takes no events and is ignored by the accessibility tree, so hit
+// testing and the handle's name and role are as before.
+//
+// A left double click on the edge, or a double tap, runs `reset` (the owner
+// returns the sidebar to its default width), unless the second press dragged:
+// that stays a resize, as with Chromium's split-view handle.
+//
+// Nothing here depends on the browser: the colour and the reset come from the
+// owner, VerticalTabStripRegionView.
+class SidebarResizeHandle : public views::ResizeArea {
+  METADATA_HEADER(SidebarResizeHandle, views::ResizeArea)
+
+ public:
+  // How long the pointer stays on the edge before the bar shows.
+  static constexpr base::TimeDelta kRestDelay = base::Milliseconds(250);
+  // The bar's width, and how far short of the edge's ends it stops.
+  static constexpr int kBarThickness = 3;
+  static constexpr int kBarEndInset = 8;
+
+  // `delegate` hears the drags, as for any views::ResizeArea. `bar_color` is
+  // the bar's colour. `reset` runs on a double click or a double tap.
+  SidebarResizeHandle(views::ResizeAreaDelegate* delegate,
+                      ui::ColorId bar_color,
+                      base::RepeatingClosure reset);
+  SidebarResizeHandle(const SidebarResizeHandle&) = delete;
+  SidebarResizeHandle& operator=(const SidebarResizeHandle&) = delete;
+  ~SidebarResizeHandle() override;
+
+  // How far past this view's trailing edge the edge reaches, in DIP: the
+  // stretch the bar is centred in. Zero puts it inside the trailing edge.
+  void SetReach(int reach);
+
+  bool IsBarShowing() const;
+  views::View* bar_for_testing() { return bar_; }
+
+  // views::ResizeArea:
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  void OnMouseReleased(const ui::MouseEvent& event) override;
+  void OnMouseCaptureLost() override;
+  void OnGestureEvent(ui::GestureEvent* event) override;
+
+  // views::View:
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+  void OnMouseMoved(const ui::MouseEvent& event) override;
+  void OnMouseExited(const ui::MouseEvent& event) override;
+
+ protected:
+  // views::View:
+  void OnBoundsChanged(const gfx::Rect& previous_bounds) override;
+  void VisibilityChanged(views::View* starting_from, bool is_visible) override;
+
+ private:
+  // Places the bar from this view's size and the reach, in logical
+  // coordinates: views mirrors them right to left, so the bar is always on
+  // the side toward the page.
+  void LayoutBar();
+  // Shows the bar while a drag is under way, or while the pointer is on the
+  // edge and has rested there (or pressed).
+  void UpdateBar();
+  // Starts the rest, unless it is over or already under way.
+  void StartRest();
+  void OnRested();
+  // The pointer is no longer on the edge, as far as the bar is concerned.
+  void ForgetPointer();
+
+  const base::RepeatingClosure reset_;
+  raw_ptr<views::View> bar_ = nullptr;
+  int reach_ = 0;
+  // Whether the pointer is on the edge, from the enter and exit events (not
+  // IsMouseHovered, which reads the real cursor), and whether it has rested
+  // there for kRestDelay or pressed.
+  bool hovered_ = false;
+  bool rested_ = false;
+  base::OneShotTimer rest_timer_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STEDDING_SIDEBAR_RESIZE_HANDLE_H_
