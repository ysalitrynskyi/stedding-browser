 INSTANTIATE_TEST_SUITE_P(, WelcomeChooserTest, testing::Values("FR", "CN"));
 
+// welcome W9: the first window carries no "Google API keys are missing"
+// infobar. The keys are for Google's services, which Stedding does not use;
+// the bar told every first window that some functionality would be disabled
+// and linked to Google's page about it (patch 0044). privacy Q10: nor, on
+// Windows, the "launch when Windows starts" bar, which Chromium's field-trial
+// testing config switched on. The window is opened the way a launch opens
+// one, with a launch's own command line: the test's --test-type keeps every
+// startup bar away, so the window the test starts with proves nothing.
+using FirstWindowTest = InProcessBrowserTest;
+
+IN_PROC_BROWSER_TEST_F(FirstWindowTest, CarriesNoBarAboutGoogle) {
+  // Chromium shows the bar whenever no key is built in. These builds carry
+  // none; with one, this test would see no bar either way.
+  ASSERT_FALSE(google_apis::HasAPIKeyConfigured());
+  // Migrated, the bar would be the window's, not the tab's.
+  ASSERT_FALSE(infobars::IsInfoBarMigrated(
+      infobars::InfoBarDelegate::GOOGLE_API_KEYS_INFOBAR_DELEGATE));
+
+  base::HistogramTester histograms;
+  base::CommandLine launch_line(base::CommandLine::NO_PROGRAM);
+  // No default-browser check: it asks the operating system.
+  launch_line.AppendSwitch(switches::kNoDefaultBrowserCheck);
+  ui_test_utils::BrowserCreatedObserver created;
+  StartupBrowserCreatorImpl launch(base::FilePath(), launch_line,
+                                   chrome::startup::IsFirstRun::kNo);
+  launch.Launch(browser()->GetProfile(),
+                chrome::startup::IsProcessStartup::kNo,
+                /*restore_tabbed_browser=*/true);
+  BrowserWindowInterface* const window = created.Wait();
+  ASSERT_TRUE(window);
+  // The launch asked for its window's startup bars: the first thing it does
+  // there is record whether the crash bubble shows.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return histograms.GetBucketCount("Startup.CrashBubbleShown", 0) > 0;
+  })) << "the launch never asked for its startup bars";
+
+  content::WebContents* const contents =
+      window->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(contents);
+  infobars::ContentInfoBarManager* const bars =
+      infobars::ContentInfoBarManager::FromWebContents(contents);
+  ASSERT_TRUE(bars);
+  for (const infobars::InfoBar* const bar : bars->infobars()) {
+    EXPECT_NE(infobars::InfoBarDelegate::GOOGLE_API_KEYS_INFOBAR_DELEGATE,
+              bar->GetIdentifier())
+        << "W9: the Google API keys bar";
+#if BUILDFLAG(IS_WIN)
+    EXPECT_NE(infobars::InfoBarDelegate::STARTUP_LAUNCH_INFOBAR_DELEGATE,
+              bar->GetIdentifier())
+        << "Q10: the launch-at-startup bar";
+#endif
+  }
+}
