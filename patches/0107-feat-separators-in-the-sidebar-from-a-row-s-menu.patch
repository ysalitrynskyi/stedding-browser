+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_TAB_SEPARATORS_H_
+#define CHROME_BROWSER_UI_STEDDING_TAB_SEPARATORS_H_
+
+#include <map>
+#include <string>
+
+class BrowserWindowInterface;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace stedding {
+
+// docs/features/sidebar.md Y45 (GitHub issue 19): a sidebar row can have a
+// separator above it, a thin line that groups the rows above from the rows
+// below without a folder. It is the row's: it moves with the row, goes with
+// a closed row, and is kept across restarts as per-tab session extra data
+// under this key.
+inline constexpr char kSessionTabSeparatorKey[] = "stedding.separator_above";
+
+// Whether `contents`'s row has a separator above it.
+bool HasSeparatorAbove(const content::WebContents* contents);
+
+// Adds or removes the separator above `tab`'s row, writes it to the
+// session, and has the row drawn again.
+void SetSeparatorAbove(BrowserWindowInterface* browser,
+                       tabs::TabInterface* tab,
+                       bool separator);
+
+// The separator rides on the WebContents: a replaced tab's contents (a jar
+// change, a pin's reset) take it with them.
+void CarryTabSeparator(content::WebContents* from, content::WebContents* to);
+
+// Session restore: adopt the separator stored with a restored tab, if any.
+void RestoreTabSeparatorFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data);
+
+// Registers the session-rebuild provider once per process
+// (chrome/browser/sessions/stedding_session_rebuild.h).
+void RegisterTabSeparatorSessionRebuild();
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_TAB_SEPARATORS_H_
