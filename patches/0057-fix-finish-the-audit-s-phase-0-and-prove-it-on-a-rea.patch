+constexpr int kMoveFirst = TabStripModel::CommandSteddingMoveToSpaceFirst;
+constexpr int kMoveLast = TabStripModel::CommandSteddingMoveToSpaceLast;
+constexpr int kRouteFirst = TabStripModel::CommandSteddingRouteToSpaceFirst;
+constexpr int kRouteLast = TabStripModel::CommandSteddingRouteToSpaceLast;
+
+constexpr SkColor kGrey = SkColorSetRGB(0x80, 0x80, 0x80);
+
+TabStripModel::ContextMenuCommand AsCommand(int command_id) {
+  return static_cast<TabStripModel::ContextMenuCommand>(command_id);
+}
+
+// Answers every row from the model, as BrowserTabStripController does for the
+// horizontal strip.
+class ModelMenuDelegate : public ui::SimpleMenuModel::Delegate {
+ public:
+  ModelMenuDelegate(TabStripModel& tabs, int index)
+      : tabs_(tabs), index_(index) {}
+
+  bool IsCommandIdEnabled(int command_id) const override {
+    return tabs_->IsContextMenuCommandEnabled(index_, AsCommand(command_id));
+  }
+  void ExecuteCommand(int command_id, int event_flags) override {
+    tabs_->ExecuteContextMenuCommand(index_, AsCommand(command_id));
+  }
+
+ private:
+  const raw_ref<TabStripModel> tabs_;
+  const int index_;
+};
+
+// The window's Space names, as the browser's delegate lists them, without
+// depending on which windows the test process has activated.
+class SpaceNamesDelegate : public TabMenuModelDelegate {
+ public:
+  SpaceNamesDelegate(ui::UnownedUserDataHost& host,
+                     const spaces::SpaceModel& model)
+      : TabMenuModelDelegate(host), model_(model) {}
+
+  std::vector<BrowserWindowInterface*> GetOtherBrowserWindows(
+      bool is_app) override {
+    return {};
+  }
+  tab_groups::TabGroupSyncService* GetTabGroupSyncService() override {
+    return nullptr;
+  }
+  std::vector<std::u16string> GetOtherSpaceNames() override {
+    std::vector<std::u16string> names;
+    for (const auto& space : model_->spaces()) {
+      if (space->id() != model_->active_id()) {
+        names.push_back(model_->DisplayName(space->id()));
+      }
+    }
+    return names;
+  }
+  std::vector<std::u16string> GetAllSpaceNames() override {
+    std::vector<std::u16string> names;
+    for (const auto& space : model_->spaces()) {
+      names.push_back(model_->DisplayName(space->id()));
+    }
+    return names;
+  }
+
+ private:
+  const raw_ref<const spaces::SpaceModel> model_;
+};
