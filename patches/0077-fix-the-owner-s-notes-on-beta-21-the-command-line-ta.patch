+// docs/features/spaces.md B39 (the owner, 2026-10-21, Arc's way): over the
+// sidebar or the rail, scrolling sideways steps to the next Space or the one
+// before, with the slide the keys take (B32): a mouse's tilt wheel, Shift
+// with the wheel, and on Windows a precision touchpad's two-finger scroll
+// and Ctrl with the wheel. SpaceWheel reads one window's stream of wheel
+// events and answers each one. It knows nothing of views, so its rules are
+// tested on their own (SpaceWheelTest).
+class SpaceWheel {
+ public:
+  // One wheel event, in the sidebar's terms.
+  struct Event {
+    base::TimeTicks time;
+    // How far it scrolls toward the right and toward the bottom, in the
+    // platform's wheel units (on Windows, 120 a notch); negative toward the
+    // left and the top.
+    float right = 0.0f;
+    float down = 0.0f;
+    // Shift held: a vertical wheel scrolls sideways, down as to the right.
+    bool shift = false;
+    // Ctrl held (Windows only): the wheel steps whichever way it turns, down
+    // as to the next Space.
+    bool control = false;
+    // A notch or more of a wheel, as against one part of a continuous stream
+    // (a precision touchpad, a high-resolution wheel).
+    bool notch = false;
+  };
+
+  enum class Answer {
+    // Not the Spaces': the list scrolls as it did.
+    kLeave,
+    // The Spaces', with no step: within the cooldown, short of a notch, or
+    // a stream that has stepped already.
+    kTake,
+    kNext,
+    kPrevious,
+  };
+
+  // `notch_size`: how far a continuous stream goes for one step.
+  explicit SpaceWheel(float notch_size);
+  SpaceWheel(const SpaceWheel&) = delete;
+  SpaceWheel& operator=(const SpaceWheel&) = delete;
+  ~SpaceWheel();
+
+  // `rtl`: the switcher runs right to left, so scrolling to the left steps
+  // to the next Space.
+  Answer OnWheel(const Event& event, bool rtl);
+
+  // After a step, the wheel steps again only this much later, so a fast
+  // wheel does not race through the Spaces; the slide lasts as long
+  // (kSpaceSlideDurationMs).
+  static constexpr base::TimeDelta kCooldown = base::Milliseconds(200);
+  // A continuous stream ends after a pause this long. It steps once at most,
+  // so one swipe and its coasting take one Space.
+  static constexpr base::TimeDelta kStreamGap = base::Milliseconds(300);
+  // How far a continuous stream goes before its direction is known; a
+  // stream that is more vertical than sideways by then is the list's to its
+  // end, so a vertical scroll that drifts sideways never steps.
+  static constexpr float kAxisLock = 15.0f;
+
+ private:
+  enum class Axis { kNone, kSideways, kVertical };
+
+  Answer Step(base::TimeTicks time, bool next);
+
+  const float notch_size_;
+  base::TimeTicks last_event_;
+  base::TimeTicks last_step_;
+  // The continuous stream under way.
+  Axis axis_ = Axis::kNone;
+  float sideways_ = 0.0f;
+  float vertical_ = 0.0f;
+  float toward_next_ = 0.0f;
+  bool stepped_ = false;
+};
+
 }  // namespace stedding
 
 #endif  // CHROME_BROWSER_UI_STEDDING_MOTION_H_
diff --git a/chrome/browser/ui/stedding/motion_unittest.cc b/chrome/browser/ui/stedding/motion_unittest.cc
