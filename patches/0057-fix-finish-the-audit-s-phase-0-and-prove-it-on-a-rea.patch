+// TST-3 (spaces B3, B4, folders F3): by every path a switch takes -- the
+// Ctrl-N command (the Spaces menu runs the same), next and previous, a
+// chip, a tab row in the command bar, closing a Space's last tab -- the
+// active tab is never one the sidebar hides, at any notification on the
+// way; a Space comes back to the tab last used in it, here one opened in
+// the foreground that is not first in the strip; a collapsed folder keeps
+// its rows hidden, and another Space's folder shows no header.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, NoSwitchEverShowsAHiddenTab) {
+  MakeThreeSpaces();
+  views::View* const root = browser_view()->GetWidget()->GetRootView();
+
+  // Two: its first tab in a collapsed folder, and the tab last used there
+  // opened in the foreground, after the others.
+  Run(IDC_STEDDING_SPACE_2);
+  int first_in_two = -1;
+  for (int i = 0; i < tab_strip_model()->count() && first_in_two < 0; ++i) {
+    if (model()->SpaceForTab(tab_strip_model()->GetTabAtIndex(i)) == ids_[1]) {
+      first_in_two = i;
+    }
+  }
+  ASSERT_GE(first_in_two, 0);
+  tabs::TabInterface* const folded =
+      tab_strip_model()->GetTabAtIndex(first_in_two);
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({first_in_two});
+  ASSERT_TRUE(folder);
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("about:blank#opened"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const opened = tab_strip_model()->GetActiveTab();
+  ASSERT_EQ(ids_[1], model()->SpaceForTab(opened));
+  folder->SetCollapsed(true);
+
+  // Three: a tab the command bar can find by its title.
+  Run(IDC_STEDDING_SPACE_3);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Far away</title>")));
+  tabs::TabInterface* const far = tab_strip_model()->GetActiveTab();
+  ASSERT_EQ(ids_[2], model()->SpaceForTab(far));
+  Run(IDC_STEDDING_SPACE_1);
+
+  HiddenActiveTabWatcher watcher(tab_strip_model(), model());
+  const auto folder_shows = [&]() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    return stedding::test::FindDrawnFolder(root, folder) != nullptr;
+  };
+
+  // Ctrl-2, from One: Two's last-used tab, the folder's header and not its
+  // collapsed row.
+  watcher.set_step("Ctrl-2");
+  EXPECT_FALSE(folder_shows()) << "another Space's folder shows its header";
+  Run(IDC_STEDDING_SPACE_2);
+  ExpectShowing(ids_[1]);
+  EXPECT_EQ(opened, tab_strip_model()->GetActiveTab());
+  EXPECT_TRUE(folder_shows());
+  EXPECT_FALSE(HasDrawnRow(root, folded)) << "a collapsed folder's row shows";
+
+  // Next and previous.
+  watcher.set_step("next and previous");
+  Run(IDC_STEDDING_SPACE_NEXT);
+  ExpectShowing(ids_[2]);
+  EXPECT_EQ(far, tab_strip_model()->GetActiveTab());
+  EXPECT_FALSE(folder_shows());
+  Run(IDC_STEDDING_SPACE_PREVIOUS);
+  ExpectShowing(ids_[1]);
+  EXPECT_EQ(opened, tab_strip_model()->GetActiveTab());
+  EXPECT_TRUE(folder_shows());
+  EXPECT_FALSE(HasDrawnRow(root, folded));
+
+  // A chip: One's.
+  watcher.set_step("a chip");
+  const auto chips = Chips();
+  ASSERT_EQ(3u, chips.size());
+  views::Widget* const widget = browser_view()->GetWidget();
+  ui::test::EventGenerator generator(views::GetRootWindow(widget),
+                                     browser_view()->GetNativeWindow());
+  generator.MoveMouseTo(chips[0].first);
+  generator.ClickLeftButton();
+  ExpectShowing(ids_[0]);
+
+  // A tab row in the command bar: Three's tab, from One.
+  watcher.set_step("the command bar");
+  chrome::ExecuteCommand(browser(), IDC_NEW_TAB);
+  stedding::CommandBarView* const bar =
+      stedding::CommandBarView::GetOpenBar(browser_view());
+  ASSERT_TRUE(bar);
+  bar->field_for_testing()->SetText(u"Far away");
+  bar->ContentsChanged(bar->field_for_testing(), u"Far away");
+  // The tab's row names its Space; the search row above it has the same
+  // title.
+  size_t row = bar->row_count_for_testing();
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    if (bar->row_title_for_testing(i) == u"Far away" &&
+        bar->row_detail_for_testing(i) == u"Three") {
+      row = i;
+      break;
+    }
+  }
+  ASSERT_LT(row, bar->row_count_for_testing()) << "no row for the tab";
+
+  views::View* const field = bar->field_for_testing();
+  while (bar->selected_row_for_testing() < row) {
+    field->OnKeyPressed(
+        ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_DOWN, ui::EF_NONE));
+  }
+  ASSERT_EQ(row, bar->selected_row_for_testing());
+  field->OnKeyPressed(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_RETURN, ui::EF_NONE));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return tab_strip_model()->GetActiveTab() == far; }));
+  ExpectShowing(ids_[2]);
+
+  // A two-finger swipe across the sidebar: to the right is the Space before,
+  // to the left the one after, as in Arc.
+  watcher.set_step("a swipe");
+  const auto swipe = [&](float dx) {
+    views::Widget* const window = browser_view()->GetWidget();
+    views::View* const region =
+        browser_view()->vertical_tab_strip_region_view_for_testing();
+    ASSERT_TRUE(region);
+    gfx::Point at = region->GetBoundsInScreen().CenterPoint();
+    views::View::ConvertPointFromScreen(window->GetRootView(), &at);
+    const gfx::PointF point(at);
+    for (const ui::ScrollEventPhase phase :
+         {ui::ScrollEventPhase::kBegan, ui::ScrollEventPhase::kUpdate,
+          ui::ScrollEventPhase::kUpdate, ui::ScrollEventPhase::kUpdate,
+          ui::ScrollEventPhase::kEnd}) {
+      const float step = phase == ui::ScrollEventPhase::kEnd ? 0 : dx / 4;
+      ui::ScrollEvent scroll(ui::EventType::kScroll, point, point,
+                             ui::EventTimeForNow(), ui::EF_NONE, step, 0, step,
+                             0, /*finger_count=*/2,
+                             ui::EventMomentumPhase::NONE, phase);
+      window->OnScrollEvent(&scroll);
+    }
+  };
+  swipe(100);
+  ExpectShowing(ids_[1]);
+  EXPECT_EQ(opened, tab_strip_model()->GetActiveTab());
+  swipe(-100);
+  ExpectShowing(ids_[2]);
+  EXPECT_EQ(far, tab_strip_model()->GetActiveTab());
+
+  // Closing Three's tabs, the active one each time -- from a row's close
+  // button, then with Cmd-W, the strip's two ways in -- leaves a new tab in
+  // Three, and never another Space's tab on screen, not even for a turn.
+  watcher.set_step("closing Three's tabs");
+  ASSERT_EQ(2, TabsIn(ids_[2]));
+  // Every tab of the other Spaces asleep: one made active for a turn would
+  // wake and reload.
+  std::vector<tabs::TabInterface*> others;
+  for (int i = 0; i < tab_strip_model()->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(i);
+    if (model()->SpaceForTab(tab) != ids_[2]) {
+      others.push_back(tab);
+    }
+  }
+  stedding::SleepTabList(others);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return std::ranges::all_of(others, [](tabs::TabInterface* tab) {
+      return tab->GetContents()->WasDiscarded();
+    });
+  }));
+  ASSERT_EQ(ids_[2], model()->SpaceForTab(tab_strip_model()->GetActiveTab()));
+  tab_strip_model()->CloseWebContentsAt(tab_strip_model()->active_index(),
+                                        TabCloseTypes::CLOSE_USER_GESTURE);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(1, TabsIn(ids_[2]));
+  ASSERT_EQ(ids_[2], model()->SpaceForTab(tab_strip_model()->GetActiveTab()));
+  Run(IDC_CLOSE_TAB);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return TabsIn(ids_[2]) == 1 &&
+           model()->SpaceForTab(tab_strip_model()->GetActiveTab()) == ids_[2];
+  }));
+  ExpectShowing(ids_[2]);
+
+  for (tabs::TabInterface* const tab : others) {
+    EXPECT_TRUE(tab->GetContents()->WasDiscarded())
+        << "a sleeping tab of another Space woke";
+  }
+  EXPECT_TRUE(watcher.seen().empty())
+      << "the active tab was a hidden one at " << watcher.seen().size()
+      << " notification(s), the first at " << watcher.seen().front();
+}
