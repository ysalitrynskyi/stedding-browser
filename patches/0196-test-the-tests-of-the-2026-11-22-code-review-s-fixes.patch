+// P02-1e, privacy Q2: with Chromium's strict HTTPS-First mode chosen on the
+// Security page, the row reads on, and turning it off turns HTTPS-First off,
+// both of its preferences: an HTTP-only page loads without the warning.
+IN_PROC_BROWSER_TEST_F(HttpsFirstRowW2B02Test,
+                       TheRowReadsStrictModeAndTurnsItOff) {
+  Profile* const profile = browser()->GetProfile();
+  PrefService* const prefs = profile->GetPrefs();
+  // What the Security page's "warn for all insecure sites" writes.
+  ASSERT_TRUE(HttpsFirstModeServiceFactory::GetForProfile(profile)->UpdatePrefs(
+      HttpsFirstModeSetting::kEnabledFull));
+  ASSERT_TRUE(prefs->GetBoolean(prefs::kHttpsOnlyModeEnabled));
+  ASSERT_FALSE(prefs->GetBoolean(prefs::kHttpsFirstBalancedMode));
+  const GURL http_url = http_server_.GetURL("http-only.com", "/simple.html");
+  ASSERT_TRUE(chrome_browser_interstitials::IsShowingHttpsFirstModeInterstitial(
+      FollowLinkInANewTab(http_url)))
+      << "strict mode warns before an HTTP-only page";
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL(kSettingsUrl), WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnThePageW2B02(R"(
+      const row = pick('settings-toggle-button#httpsFirst');
+      return !!row && !!row.pref && row.checked === true;)"))
+        .ExtractBool();
+  })) << "the row reads off while every HTTP page warns";
+
+  ASSERT_TRUE(content::ExecJs(page, OnThePageW2B02(R"(
+      pick('settings-toggle-button#httpsFirst').click();
+      return '';)")));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !prefs->GetBoolean(prefs::kHttpsOnlyModeEnabled) &&
+           !prefs->GetBoolean(prefs::kHttpsFirstBalancedMode);
+  })) << "strict " << prefs->GetBoolean(prefs::kHttpsOnlyModeEnabled)
+      << ", balanced " << prefs->GetBoolean(prefs::kHttpsFirstBalancedMode);
+  content::WebContents* const loaded = FollowLinkInANewTab(http_url);
+  EXPECT_EQ(http_url, loaded->GetLastCommittedURL());
+  EXPECT_FALSE(
+      chrome_browser_interstitials::IsShowingHttpsFirstModeInterstitial(
+          loaded))
+      << "the row reads off and the warning stays";
+}
