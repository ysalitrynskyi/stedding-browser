+// spaces B10 and B21, pins H6, tabs R17 and archive A8 on tabs that came
+// back from a session (PLAN.md TST-4). What the user does to a restored tab
+// holds as it does on a tab opened in this run, and holds across the next
+// restart. The first run builds the profile. The second acts on the tabs it
+// got back: a named essential taken out of the essentials and put back, ⌘D
+// three times, Reset to Pinned Page and Make This the Pinned Page from the
+// tab menu, the Clear line pressed while a page asks and is told to stay,
+// ⇧⌘T, and ⌘W on the page that stayed. The third finds what the second did.
+class RestoredVerbsTest : public RestoreTest {
+ protected:
+  void SetUpOnMainThread() override {
+    RestoreTest::SetUpOnMainThread();
+    tabs::VerticalTabStripStateController::From(browser())
+        ->SetVerticalTabsEnabled(true);
+  }
+
+  views::Widget* widget() {
+    return BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  }
+
+  // Whether every Space pin of `space` comes before every loose tab of it in
+  // the strip: the pinned run sits above the Clear line (spaces B10, pins
+  // H14).
+  bool PinsComeFirst(const SpaceId& space) {
+    bool loose_seen = false;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      if (tab->IsPinned() || model()->SpaceForTab(tab) != space) {
+        continue;
+      }
+      if (!model()->IsSpacePinned(tab)) {
+        loose_seen = true;
+      } else if (loose_seen) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  // Whether the drawn row of `tab` is above the Clear line the sidebar draws,
+  // once the rows are in place; nothing when either is not drawn.
+  std::optional<bool> AboveTheClearLine(tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    TabView* const row =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+    ClearTabsSeparator* const line =
+        stedding::test::FindDrawnClearLine(widget()->GetRootView());
+    if (!row || !line) {
+      return std::nullopt;
+    }
+    return row->GetBoundsInScreen().bottom() <= line->GetBoundsInScreen().y();
+  }
+
+  // Presses the Clear line with the mouse, where a person would.
+  void PressTheClearLine() {
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    ClearTabsSeparator* const line =
+        stedding::test::FindDrawnClearLine(widget()->GetRootView());
+    ASSERT_TRUE(line) << "the sidebar shows no Clear line";
+    ASSERT_FALSE(line->GetClearRect().IsEmpty());
+    gfx::Point point = line->GetClearRect().CenterPoint();
+    views::View::ConvertPointToScreen(line, &point);
+    stedding::test::ClickLeftMouse(widget(), point);
+  }
+
+  // The newest recently-closed entry of a tab on `host`, or null.
+  const sessions::tab_restore::Tab* ClosedTabOn(const std::string& host) {
+    sessions::TabRestoreService* const service =
+        TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+    if (!service) {
+      return nullptr;
+    }
+    for (const auto& entry : service->entries()) {
+      if (entry->type != sessions::tab_restore::TAB) {
+        continue;
+      }
+      const auto* const tab =
+          static_cast<const sessions::tab_restore::Tab*>(entry.get());
+      if (!tab->navigations.empty() &&
+          tab->navigations[tab->normalized_navigation_index()]
+                  .virtual_url()
+                  .host() == host) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  static std::string ExtraData(const sessions::tab_restore::Tab* tab,
+                               const char* key) {
+    const auto it = tab->extra_data.find(key);
+    return it == tab->extra_data.end() ? std::string() : it->second;
+  }
+};
