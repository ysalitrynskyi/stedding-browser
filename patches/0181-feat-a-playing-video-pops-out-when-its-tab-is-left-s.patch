+#include "base/time/time.h"
+#include "chrome/browser/picture_in_picture/picture_in_picture_window_manager.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding/video_pop_out.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/media_start_stop_observer.h"
+#include "media/base/media_switches.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace {
+
+constexpr char kVideoPage[] = "/media/session/video-with-metadata.html";
+
+class MiniPlayerTest : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(
+        switches::kAutoplayPolicy,
+        switches::autoplay::kNoUserGestureRequiredPolicy);
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+
+  void TurnOn() {
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kPlayerPopOut, true);
+  }
+
+  // A new tab on screen showing `path` from the test server, loaded.
+  tabs::TabInterface* Open(const std::string& path) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(path),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // Plays the page's video, and waits until it counts as a video with sound
+  // that picture in picture can take: the session's state follows the player
+  // a moment later.
+  void Play(tabs::TabInterface* tab) {
+    content::MediaStartStopObserver started(
+        tab->GetContents(), content::MediaStartStopObserver::Type::kStart);
+    ASSERT_TRUE(content::ExecJs(tab->GetContents(), "play()"));
+    started.Wait();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return stedding::VideoPopOut::PlaysVideoWithSound(tab->GetContents());
+    })) << "the page never counted as playing a video with sound";
+  }
+
+  static bool Out(tabs::TabInterface* tab) {
+    return tab->GetContents()->HasPictureInPictureVideo();
+  }
+
+  static bool Paused(tabs::TabInterface* tab) {
+    return content::EvalJs(tab->GetContents(),
+                           "document.getElementById('video').paused")
+        .ExtractBool();
+  }
+
+  // Whether the video is still in its page a second later: a pop-out comes
+  // within a few turns of the loop.
+  static bool StaysIn(tabs::TabInterface* tab) {
+    base::RunLoop wait;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, wait.QuitClosure(), base::Seconds(1));
+    wait.Run();
+    return !Out(tab);
+  }
+};
+
+// Mp2: off on a fresh profile, and while off nothing pops out.
+IN_PROC_BROWSER_TEST_F(MiniPlayerTest, OffByDefault) {
+  EXPECT_FALSE(browser()->GetProfile()->GetPrefs()->GetBoolean(
+      stedding::prefs::kPlayerPopOut));
+  tabs::TabInterface* const video = Open(kVideoPage);
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+  Open("/title1.html");
+  EXPECT_TRUE(StaysIn(video)) << "a video popped out with the setting off";
+}
+
+// Mp2: on, leaving the tab pops the video out, and it keeps playing.
+IN_PROC_BROWSER_TEST_F(MiniPlayerTest, LeavingAPlayingVideoPopsItOut) {
+  TurnOn();
+  tabs::TabInterface* const video = Open(kVideoPage);
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+  Open("/title1.html");
+  EXPECT_TRUE(base::test::RunUntil([&]() { return Out(video); }))
+      << "leaving the tab did not pop the video out";
+  EXPECT_FALSE(Paused(video));
+}
+
+// Mp4: showing the tab again puts the video back in the page, playing on.
+IN_PROC_BROWSER_TEST_F(MiniPlayerTest, ComingBackPutsItBack) {
+  TurnOn();
+  tabs::TabInterface* const video = Open(kVideoPage);
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+  Open("/title1.html");
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Out(video); }));
+  tabs()->ActivateTabAt(Index(video));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !Out(video); }))
+      << "the video stayed out after its tab came back";
+  EXPECT_FALSE(Paused(video)) << "the video stopped when it came back";
+}
+
+// Mp2: a muted tab and a paused video stay where they are.
+IN_PROC_BROWSER_TEST_F(MiniPlayerTest, AMutedOrPausedVideoStays) {
+  TurnOn();
+  {
+    SCOPED_TRACE("muted");
+    tabs::TabInterface* const video = Open(kVideoPage);
+    ASSERT_NO_FATAL_FAILURE(Play(video));
+    video->GetContents()->SetAudioMuted(true);
+    Open("/title1.html");
+    EXPECT_TRUE(StaysIn(video)) << "a muted video popped out";
+  }
+  {
+    SCOPED_TRACE("paused");
+    tabs::TabInterface* const video = Open(kVideoPage);
+    ASSERT_NO_FATAL_FAILURE(Play(video));
+    ASSERT_TRUE(content::ExecJs(video->GetContents(),
+                                "document.getElementById('video').pause()"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !stedding::VideoPopOut::PlaysVideoWithSound(video->GetContents());
+    }));
+    Open("/title1.html");
+    EXPECT_TRUE(StaysIn(video)) << "a paused video popped out";
+  }
+}
+
+// Mp2: a split's other pane is still on screen, so choosing it does not
+// leave the video's pane.
+IN_PROC_BROWSER_TEST_F(MiniPlayerTest, ASplitsOtherPaneIsNotLeft) {
+  TurnOn();
+  tabs::TabInterface* const page = Open("/title1.html");
+  tabs::TabInterface* const video = Open(kVideoPage);
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+  tabs()->AddToNewSplit({Index(page)}, split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(video->IsSplit() && page->IsSplit());
+  tabs()->ActivateTabAt(Index(page));
+  ASSERT_EQ(page, tabs()->GetActiveTab());
+  EXPECT_TRUE(StaysIn(video)) << "choosing the other pane popped it out";
+}
+
+// Mp2, Mp4: showing another Space leaves the tab; the window's way back to
+// the tab shows the tab in its Space, and the video goes back in.
+IN_PROC_BROWSER_TEST_F(MiniPlayerTest, BackToTabShowsItsSpace) {
+  TurnOn();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  tabs::TabInterface* const video = Open(kVideoPage);
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Out(video); }))
+      << "showing another Space did not pop the video out";
+
+  PictureInPictureWindowManager::GetInstance()->FocusInitiator();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return model->active_id() == home && tabs()->GetActiveTab() == video;
+  })) << "back to the tab did not show it in its Space";
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !Out(video); }))
+      << "the video stayed out once its tab showed";
+}
+
+// Mp4: closing the tab closes the window its video went to.
+IN_PROC_BROWSER_TEST_F(MiniPlayerTest, ClosingTheTabClosesThePlayer) {
+  TurnOn();
+  tabs::TabInterface* const video = Open(kVideoPage);
+  ASSERT_NO_FATAL_FAILURE(Play(video));
+  Open("/title1.html");
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Out(video); }));
+  tabs()->CloseWebContentsAt(Index(video), TabCloseTypes::CLOSE_USER_GESTURE);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !PictureInPictureWindowManager::GetInstance()->GetWebContents();
+  })) << "the player outlived its tab";
+}
+
+}  // namespace
