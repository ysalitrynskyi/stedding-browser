+// I1, I8, I10: the shape comes across, the profile is named, the theme maps.
+TEST(ArcSidebarImporterTest, ParsesSpacesFoldersAndEssentials) {
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(kSidebar);
+  ASSERT_TRUE(plan.has_value());
+  ASSERT_EQ(2u, plan->spaces.size());
+  const ArcImportPlan::Space& work = plan->spaces[0];
+  EXPECT_EQ("Work", work.title);
+  EXPECT_EQ("💼", work.emoji);
+  ASSERT_TRUE(work.color.has_value());
+  EXPECT_EQ(kSpaceColors[1].color, *work.color) << "Plum is nearest";
+  EXPECT_TRUE(work.profile.empty());
+  ASSERT_EQ(2u, work.pinned.size());
+  EXPECT_EQ(ArcImportPlan::Node::Kind::kTab, work.pinned[0].kind);
+  EXPECT_EQ(GURL("https://a.example/"), work.pinned[0].url);
+  EXPECT_EQ(u"A", work.pinned[0].title);
+  EXPECT_EQ(ArcImportPlan::Node::Kind::kFolder, work.pinned[1].kind);
+  EXPECT_EQ(u"Docs", work.pinned[1].title);
+  ASSERT_EQ(2u, work.pinned[1].children.size());
+  EXPECT_EQ(u"C", work.pinned[1].children[1].title);
+  ASSERT_EQ(1u, work.unpinned.size());
+  EXPECT_EQ(u"D", work.unpinned[0].title);
+
+  const ArcImportPlan::Space& play = plan->spaces[1];
+  EXPECT_EQ("Personal", play.profile);
+  EXPECT_FALSE(play.color.has_value());
+  EXPECT_TRUE(play.pinned.empty());
+  ASSERT_EQ(1u, play.unpinned.size());
+
+  ASSERT_EQ(1u, plan->essentials.size());
+  EXPECT_EQ(u"E", plan->essentials[0].title);
+  EXPECT_EQ(3u, plan->pinned_tab_count());
+  EXPECT_EQ(2u, plan->unpinned_tab_count());
+  EXPECT_EQ(1u, plan->folder_count());
+  EXPECT_EQ(std::vector<std::string>{"Personal"}, plan->dropped_profiles());
+  EXPECT_FALSE(ParseArcSidebar("{\"nope\": 1}").has_value());
+}
+
+// I2, I8: the summary before anything is applied.
+TEST(ArcSidebarImporterTest, SummaryCountsThePlan) {
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(kSidebar);
+  ASSERT_TRUE(plan.has_value());
+  const std::u16string summary = SummariseArcImport(*plan);
+  EXPECT_NE(std::u16string::npos,
+            summary.find(u"2 Spaces, 3 pinned tabs, 1 folder, 2 tabs"))
+      << summary;
+  EXPECT_NE(std::u16string::npos, summary.find(u"1 essential")) << summary;
+  EXPECT_NE(std::u16string::npos, summary.find(u"not carried over: Personal"))
+      << summary;
+}
+
+// I10: every theme lands on one of the five swatches, the nearest.
+TEST(ArcSidebarImporterTest, ThemeMapsToTheNearestSwatch) {
+  EXPECT_EQ(kSpaceColors[1].color, NearestSpaceColor(kSpaceColors[1].color));
+  EXPECT_EQ(kSpaceColors[2].color,
+            NearestSpaceColor(SkColorSetRGB(0x50, 0x90, 0x70)));
+  EXPECT_EQ(kSpaceColors[4].color,
+            NearestSpaceColor(SkColorSetRGB(0x90, 0x50, 0x60)));
+}
+
+// I9: the file is read through a copy.
+TEST(ArcSidebarImporterTest, ReadsACopy) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().Append("StorableSidebar.json");
+  ASSERT_TRUE(base::WriteFile(path, kSidebar));
+  const std::optional<std::string> json = ReadArcSidebar(path);
+  ASSERT_TRUE(json.has_value());
+  EXPECT_EQ(std::string(kSidebar), *json);
+  EXPECT_FALSE(
+      ReadArcSidebar(dir.GetPath().Append("missing.json")).has_value());
+}
+
+class ArcSidebarImportWindowTest : public BrowserWithTestWindowTest {
+ protected:
+  SpaceModel& model() {
+    SpaceModel* const model = SpaceModel::From(browser());
+    CHECK(model);
+    return *model;
+  }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  const Space* SpaceNamed(const std::string& name) {
+    for (const auto& space : model().spaces()) {
+      if (space->name() == name) {
+        return space.get();
+      }
+    }
+    return nullptr;
+  }
+  std::vector<tabs::TabInterface*> TabsIn(const SpaceId& id) {
+    std::vector<tabs::TabInterface*> out;
+    for (int i = 0; i < tabs().count(); ++i) {
+      tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+      if (!tab->IsPinned() && model().SpaceForTab(tab) == id) {
+        out.push_back(tab);
+      }
+    }
+    return out;
+  }
+};
+
+// I3: Spaces, essentials, the pinned run, a folder, unloaded tabs.
+TEST_F(ArcSidebarImportWindowTest, AppliesSpacesPinsAndFolders) {
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(kSidebar);
+  ASSERT_TRUE(plan.has_value());
+  ASSERT_EQ(1u, model().size());
+  const ArcImportResult result =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(2u, result.spaces);
+  EXPECT_EQ(5u, result.tabs);
+  EXPECT_EQ(1u, result.folders);
+  EXPECT_EQ(1u, result.essentials);
+  EXPECT_EQ(0u, result.skipped);
+
+  // The lone unnamed default Space became Work; Play was added.
+  ASSERT_EQ(2u, model().size());
+  const Space* const work = SpaceNamed("Work");
+  const Space* const play = SpaceNamed("Play");
+  ASSERT_TRUE(work);
+  ASSERT_TRUE(play);
+  EXPECT_EQ("💼", work->icon());
+  EXPECT_EQ(kSpaceColors[1].color, work->color());
+  EXPECT_EQ("🎮", play->icon());
+
+  // The essential is a Chromium-pinned tab; A is Space-pinned in Work; the
+  // folder holds B and C; D and F are plain, each in its Space.
+  EXPECT_EQ(1, tabs().IndexOfFirstNonPinnedTab());
+  EXPECT_EQ(u"E", tabs().GetTabAtIndex(0)->GetContents()->GetTitle());
+  const std::vector<tabs::TabInterface*> in_work = TabsIn(work->id());
+  ASSERT_EQ(4u, in_work.size());
+  EXPECT_EQ(u"A", in_work[0]->GetContents()->GetTitle());
+  EXPECT_TRUE(model().IsSpacePinned(in_work[0]));
+  EXPECT_TRUE(model().HomeUrl(in_work[0]).has_value());
+  EXPECT_FALSE(model().IsSpacePinned(in_work[1]));
+  const tabs::TabCollection* const folder = in_work[1]->GetParentCollection();
+  ASSERT_TRUE(folder);
+  EXPECT_EQ(tabs::TabCollection::Type::FOLDER, folder->type());
+  EXPECT_EQ("Docs",
+            static_cast<const tabs::FolderTabCollection*>(folder)->title());
+  EXPECT_EQ(folder, in_work[2]->GetParentCollection());
+  EXPECT_NE(folder, in_work[3]->GetParentCollection());
+  EXPECT_EQ(u"D", in_work[3]->GetContents()->GetTitle());
+  EXPECT_TRUE(in_work[3]->GetContents()->WasDiscarded()) << "inserted unloaded";
+  const std::vector<tabs::TabInterface*> in_play = TabsIn(play->id());
+  ASSERT_EQ(1u, in_play.size());
+  EXPECT_EQ(u"F", in_play[0]->GetContents()->GetTitle());
+}
+
+// I12: a second import adds nothing.
+TEST_F(ArcSidebarImportWindowTest, SecondImportAddsNothing) {
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(kSidebar);
+  ASSERT_TRUE(plan.has_value());
+  ApplyArcImport(browser(), *plan, ArcImportOptions());
+  const int tabs_after_first = tabs().count();
+  const size_t spaces_after_first = model().size();
+  const ArcImportResult again =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(0u, again.spaces);
+  EXPECT_EQ(0u, again.tabs);
+  EXPECT_EQ(0u, again.folders);
+  EXPECT_EQ(0u, again.essentials);
+  EXPECT_GT(again.skipped, 0u);
+  EXPECT_EQ(tabs_after_first, tabs().count());
+  EXPECT_EQ(spaces_after_first, model().size());
+}
+
+// I11: the essentials row takes twelve at most.
+TEST_F(ArcSidebarImportWindowTest, FavoritesCapAtTwelve) {
+  ArcImportPlan plan;
+  for (int i = 0; i < 14; ++i) {
+    ArcImportPlan::Node node;
+    node.arc_id = "top-" + base::NumberToString(i);
+    node.title = u"Top";
+    node.url = GURL("https://top.example/" + base::NumberToString(i));
+    plan.essentials.push_back(node);
+  }
+  EXPECT_NE(std::u16string::npos,
+            SummariseArcImport(plan).find(u"the first 12 become essentials"));
+  const ArcImportResult result =
+      ApplyArcImport(browser(), plan, ArcImportOptions());
+  EXPECT_EQ(12u, result.essentials);
+  EXPECT_EQ(12, tabs().IndexOfFirstNonPinnedTab());
+}
