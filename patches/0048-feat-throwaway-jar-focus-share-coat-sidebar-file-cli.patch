--- /dev/null
+++ b/chrome/browser/ui/spaces/space_query.cc
@@ -0,0 +1,35 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_query.h"
+
+#include "base/strings/string_util.h"
+
+namespace spaces {
+
+SpaceQuery ParseSpaceQuery(std::u16string_view query) {
+  SpaceQuery parsed;
+  if (query.empty() || query[0] != u'@') {
+    parsed.rest = std::u16string(query);
+    return parsed;
+  }
+  const size_t space = query.find(u' ');
+  if (space == std::u16string_view::npos) {
+    parsed.space_prefix = std::u16string(query.substr(1));
+    return parsed;
+  }
+  parsed.space_prefix = std::u16string(query.substr(1, space - 1));
+  parsed.rest = std::u16string(query.substr(space + 1));
+  return parsed;
+}
+
+bool SpaceNameMatchesPrefix(std::u16string_view name,
+                            std::u16string_view prefix) {
+  if (prefix.empty()) {
+    return true;
+  }
+  return base::StartsWith(name, prefix, base::CompareCase::INSENSITIVE_ASCII);
+}
+
+}  // namespace spaces
