+#if BUILDFLAG(IS_MAC)
+// The two-finger swipe across the sidebar (spaces B35): each scroll event
+// moves the list's layer; the lift switches and the new Space settles.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest, SpaceSwipe) {
+  if (!Animates()) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(10));
+  const spaces::SpaceId second = model->AddSpace("Two", SK_ColorBLUE)->id();
+  model->SetActiveSpace(second);
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(10));
+  model->SetActiveSpace(model->spaces().front()->id());
+  views::View* const list = strip()->unpinned_tabs_scroll_view();
+  gfx::Point at = region()->GetBoundsInScreen().CenterPoint();
+  views::View::ConvertPointFromScreen(widget()->GetRootView(), &at);
+  const gfx::PointF point(at);
+  const auto send = [&](float dx, ui::ScrollEventPhase phase) {
+    ui::ScrollEvent scroll(ui::EventType::kScroll, point, point,
+                           ui::EventTimeForNow(), ui::EF_NONE, dx, 0, dx, 0,
+                           /*finger_count=*/2, ui::EventMomentumPhase::NONE,
+                           phase);
+    widget()->OnScrollEvent(&scroll);
+  };
+  FrameMeter meter;
+  meter.Start(compositor());
+  send(0, ui::ScrollEventPhase::kBegan);
+  base::ElapsedTimer moving;
+  int frames = meter.steps();
+  for (int i = 0; i < 12; ++i) {
+    send(-10, ui::ScrollEventPhase::kUpdate);
+    // One event a frame, as a trackpad sends them.
+    ASSERT_TRUE(base::test::RunUntil([&]() { return meter.steps() > frames; }));
+    frames = meter.steps();
+  }
+  const double per_event_ms = moving.Elapsed().InMillisecondsF() / 12;
+  send(0, ui::ScrollEventPhase::kEnd);
+  ASSERT_TRUE(
+      RunUntilSettled(meter, base::BindLambdaForTesting([&]() {
+                        return model->active_id() == second && list->layer() &&
+                               !list->layer()->GetAnimator()->is_animating();
+                      })));
+  meter.Stop();
+  Log(meter, base::StringPrintf("space swipe and settle (%.2f ms a frame "
+                                "while the fingers move)",
+                                per_event_ms));
+}
