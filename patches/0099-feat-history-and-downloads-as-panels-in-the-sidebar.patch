new file mode 100644
index 0000000000000..b7bb1f7cc8bdb
--- /dev/null
+++ b/chrome/browser/ui/stedding/file_trash_unittest.cc
@@ -0,0 +1,92 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/file_trash.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/run_loop.h"
+#include "base/test/task_environment.h"
+#include "build/build_config.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "base/win/scoped_com_initializer.h"
+#endif
+
+namespace stedding {
+namespace {
+
+// Pn11: the file goes to the system's Trash or Recycle Bin, whole, and no
+// copy stays behind; a file that is not there is refused. The test takes
+// its own file back out of the Trash where the system says where it went.
+TEST(FileTrashTest, MovesTheFileAndLeavesNoCopy) {
+#if !BUILDFLAG(IS_MAC) && !BUILDFLAG(IS_WIN)
+  GTEST_SKIP() << "no Trash on this platform yet";
+#else
+#if BUILDFLAG(IS_WIN)
+  base::win::ScopedCOMInitializer com;
+  ASSERT_TRUE(com.Succeeded());
+#endif
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath file =
+      dir.GetPath().AppendASCII("stedding-file-trash-test.txt");
+  ASSERT_TRUE(base::WriteFile(file, "Pn11"));
+
+  base::FilePath trashed;
+  ASSERT_TRUE(MoveToTrash(file, &trashed));
+  EXPECT_FALSE(base::PathExists(file)) << "the file is still where it was";
+  if (!trashed.empty()) {
+    std::string contents;
+    EXPECT_TRUE(base::ReadFileToString(trashed, &contents))
+        << "nothing at " << trashed;
+    EXPECT_EQ("Pn11", contents);
+    base::DeleteFile(trashed);
+  }
+
+  EXPECT_FALSE(MoveToTrash(dir.GetPath().AppendASCII("not-there.txt"),
+                           /*trashed_path=*/nullptr));
+#endif
+}
+
+// Pn11: the move runs off the calling sequence and answers on it; a
+// browser test's stand-in takes the real Trash's place.
+TEST(FileTrashTest, TheStandInAnswersOnTheCallingSequence) {
+  base::test::TaskEnvironment task_environment;
+  std::vector<base::FilePath> moved;
+  SetMoveToTrashForTesting(base::BindRepeating(
+      [](std::vector<base::FilePath>* moved, const base::FilePath& path) {
+        moved->push_back(path);
+        return true;
+      },
+      base::Unretained(&moved)));
+
+  const base::FilePath path(FILE_PATH_LITERAL("stedding-not-a-real-file"));
+  base::RunLoop run_loop;
+  bool answer = false;
+  MoveToTrashThen(path, base::BindOnce(
+                            [](bool* answer, base::OnceClosure quit,
+                               bool result) {
+                              *answer = result;
+                              std::move(quit).Run();
+                            },
+                            base::Unretained(&answer),
+                            run_loop.QuitClosure()));
+  run_loop.Run();
+  SetMoveToTrashForTesting(base::NullCallback());
+
+  EXPECT_TRUE(answer);
+  ASSERT_EQ(1u, moved.size());
+  EXPECT_EQ(path, moved.front());
+}
+
+}  // namespace
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/file_trash_win.cc b/chrome/browser/ui/stedding/file_trash_win.cc
new file mode 100644
index 0000000000000..5b0ae9535a57c
--- /dev/null
+++ b/chrome/browser/ui/stedding/file_trash_win.cc
@@ -0,0 +1,179 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/file_trash.h"
+
+#include <windows.h>
+
+#include <objbase.h>
+#include <shellapi.h>
+#include <shobjidl.h>
+#include <wrl/client.h>
+#include <wrl/implements.h>
+
+#include "base/task/single_thread_task_runner.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+#include "base/win/com_init_util.h"
+#include "base/win/scoped_co_mem.h"
+
+namespace stedding {
+
+namespace {
+
+// Watches the shell's delete. The shell, asked to recycle, still deletes a
+// file it cannot recycle -- on a volume with no Recycle Bin, or larger than
+// the bin takes -- outright and without a word with the dialogs off. Before
+// each item it says whether it will recycle it; one it will not is
+// refused, so the operation fails and the file stays where it was (Pn11).
+class RecycleOnlySink
+    : public Microsoft::WRL::RuntimeClass<
+          Microsoft::WRL::RuntimeClassFlags<Microsoft::WRL::ClassicCom>,
+          IFileOperationProgressSink> {
+ public:
+  RecycleOnlySink() = default;
+  RecycleOnlySink(const RecycleOnlySink&) = delete;
+  RecycleOnlySink& operator=(const RecycleOnlySink&) = delete;
+
+  bool refused() const { return refused_; }
+  HRESULT result() const { return result_; }
+  const base::FilePath& recycled_path() const { return recycled_path_; }
+
+  // IFileOperationProgressSink:
+  IFACEMETHODIMP PreDeleteItem(DWORD flags, IShellItem*) override {
+    if (!(flags & TSF_DELETE_RECYCLE_IF_POSSIBLE)) {
+      refused_ = true;
+      return E_ABORT;
+    }
+    return S_OK;
+  }
+  IFACEMETHODIMP PostDeleteItem(DWORD,
+                                IShellItem*,
+                                HRESULT hr,
+                                IShellItem* newly_created) override {
+    if (SUCCEEDED(result_)) {
+      result_ = hr;
+    }
+    if (SUCCEEDED(hr) && newly_created) {
+      base::win::ScopedCoMem<wchar_t> path;
+      if (SUCCEEDED(newly_created->GetDisplayName(SIGDN_FILESYSPATH, &path)) &&
+          path) {
+        recycled_path_ = base::FilePath(path.get());
+      }
+    }
+    return S_OK;
+  }
+  IFACEMETHODIMP FinishOperations(HRESULT hr) override {
+    if (SUCCEEDED(result_)) {
+      result_ = hr;
+    }
+    return S_OK;
+  }
+  IFACEMETHODIMP StartOperations() override { return S_OK; }
+  IFACEMETHODIMP PauseTimer() override { return S_OK; }
+  IFACEMETHODIMP ResetTimer() override { return S_OK; }
+  IFACEMETHODIMP ResumeTimer() override { return S_OK; }
+  IFACEMETHODIMP UpdateProgress(UINT, UINT) override { return S_OK; }
+  IFACEMETHODIMP PreCopyItem(DWORD, IShellItem*, IShellItem*, PCWSTR) override {
+    return E_NOTIMPL;
+  }
+  IFACEMETHODIMP PostCopyItem(DWORD,
+                              IShellItem*,
+                              IShellItem*,
+                              PCWSTR,
+                              HRESULT,
+                              IShellItem*) override {
+    return E_NOTIMPL;
+  }
+  IFACEMETHODIMP PreMoveItem(DWORD, IShellItem*, IShellItem*, PCWSTR) override {
+    return E_NOTIMPL;
+  }
+  IFACEMETHODIMP PostMoveItem(DWORD,
+                              IShellItem*,
+                              IShellItem*,
+                              PCWSTR,
+                              HRESULT,
+                              IShellItem*) override {
+    return E_NOTIMPL;
+  }
+  IFACEMETHODIMP PreNewItem(DWORD, IShellItem*, PCWSTR) override {
+    return E_NOTIMPL;
+  }
+  IFACEMETHODIMP PostNewItem(DWORD,
+                             IShellItem*,
+                             PCWSTR,
+                             PCWSTR,
+                             DWORD,
+                             HRESULT,
+                             IShellItem*) override {
+    return E_NOTIMPL;
+  }
+  IFACEMETHODIMP PreRenameItem(DWORD, IShellItem*, PCWSTR) override {
+    return E_NOTIMPL;
+  }
+  IFACEMETHODIMP
+  PostRenameItem(DWORD, IShellItem*, PCWSTR, HRESULT, IShellItem*) override {
+    return E_NOTIMPL;
+  }
+
+ protected:
+  ~RecycleOnlySink() override = default;
+
+ private:
+  bool refused_ = false;
+  HRESULT result_ = S_OK;
+  base::FilePath recycled_path_;
+};
+
+}  // namespace
+
+bool MoveToTrash(const base::FilePath& path, base::FilePath* trashed_path) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  base::win::AssertComInitialized();
+
+  Microsoft::WRL::ComPtr<IShellItem> item;
+  HRESULT hr = SHCreateItemFromParsingName(path.value().c_str(), nullptr,
+                                           IID_PPV_ARGS(&item));
+  Microsoft::WRL::ComPtr<IFileOperation> operation;
+  if (SUCCEEDED(hr)) {
+    hr = CoCreateInstance(CLSID_FileOperation, nullptr, CLSCTX_INPROC_SERVER,
+                          IID_PPV_ARGS(&operation));
+  }
+  if (SUCCEEDED(hr)) {
+    // To the Recycle Bin, with no dialog of the shell's: the panel says what
+    // happened (Pn11). FOFX_EARLYFAILURE stops at the first refusal.
+    hr = operation->SetOperationFlags(FOF_ALLOWUNDO | FOF_NO_UI |
+                                      FOFX_RECYCLEONDELETE |
+                                      FOFX_EARLYFAILURE);
+  }
+  Microsoft::WRL::ComPtr<RecycleOnlySink> sink =
+      Microsoft::WRL::Make<RecycleOnlySink>();
+  if (SUCCEEDED(hr)) {
+    hr = operation->DeleteItem(item.Get(), sink.Get());
+  }
+  if (SUCCEEDED(hr)) {
+    hr = operation->PerformOperations();
+  }
+  if (FAILED(hr) || sink->refused() || FAILED(sink->result())) {
+    return false;
+  }
+  BOOL aborted = TRUE;
+  if (FAILED(operation->GetAnyOperationsAborted(&aborted)) || aborted) {
+    return false;
+  }
+  if (trashed_path) {
+    *trashed_path = sink->recycled_path();
+  }
+  return true;
+}
+
+scoped_refptr<base::SequencedTaskRunner> CreateFileTrashTaskRunner() {
+  // The shell's file operation is COM.
+  return base::ThreadPool::CreateCOMSTATaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+}
+
+}  // namespace stedding
