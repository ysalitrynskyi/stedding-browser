+// spaces B34 (BACKLOG S-350): with horizontal tabs, another Space's tabs,
+// which the strip does not draw, take no keyboard selection or focus:
+// Shift+Right on the Space's last tab selects nothing past it and leaves the
+// Space as it is, and the reorder key does not move the tab past tabs it
+// cannot see. Shift+Right selected the next Space's tab and switched to that
+// Space.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, HorizontalKeysPassAnotherSpacesTabs) {
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces());
+  ExitVerticalTabsMode();
+  TabStrip* const strip = browser_view()->horizontal_tab_strip_for_testing();
+  ASSERT_TRUE(strip);
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  ASSERT_EQ(ids_[0], model()->active_id());
+  // One's tabs are the strip's first two, Two's the next two.
+  tabs::TabInterface* const last_of_one = tab_strip_model()->GetTabAtIndex(1);
+  ASSERT_EQ(ids_[0], model()->SpaceForTab(last_of_one));
+  ASSERT_EQ(ids_[1],
+            model()->SpaceForTab(tab_strip_model()->GetTabAtIndex(2)));
+  tab_strip_model()->ActivateTabAt(1);
+  Tab* const tab = strip->tab_at(1);
+  ASSERT_TRUE(tab);
+  strip->GetFocusManager()->SetFocusedView(tab);
+
+  EXPECT_TRUE(tab->OnKeyPressed(ui::KeyEvent(
+      ui::EventType::kKeyPressed, ui::VKEY_RIGHT, ui::EF_SHIFT_DOWN)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(tab_strip_model()->IsTabSelected(2))
+      << "another Space's tab joined the selection";
