+// Safari's export, as Safari 18 writes it: two bookmarks (one among the
+// Favorites), a visit and a redirect hop, two logins, and a cards file that
+// holds none. $1 and $2 are a day and an hour ago, in microseconds since the
+// Unix epoch: the visits must be newer than the 90 days history keeps.
+constexpr char kExportBookmarks[] = R"(<!DOCTYPE NETSCAPE-Bookmark-file-1>
+<HTML>
+<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">
+<TITLE>Bookmarks</TITLE>
+<H1>Bookmarks</H1>
+<DT><H3 id="BookmarksBar">Favorites</H3>
+<DL><p>
+	<DT><A HREF="https://safari-fav.example/">Fav</A>
+</DL><p>
+<DT><A HREF="https://safari-loose.example/">Loose</A>
+</HTML>
+)";
+
+constexpr char kExportPasswords[] =
+    "Title,URL,Username,Password,Notes,OTPAuth\n"
+    "a,https://safari-login.example/,ann,fromsafari,,\n"
+    "b,https://safari-other.example/,bob,newone,,\n";
+
+constexpr char kExportCards[] =
+    R"({"metadata": {"browser_name": "Safari", "data_type": "payment_cards",
+        "schema_version": 1}, "payment_cards": []})";
+
+constexpr char kFavorite[] = "https://safari-fav.example/";
+constexpr char kLoose[] = "https://safari-loose.example/";
+constexpr char kSeen[] = "https://safari-seen.example/";
+constexpr char kHop[] = "http://safari-hop.example/";
+
+std::string UsecAgo(base::TimeDelta ago) {
+  return base::NumberToString(
+      ((base::Time::Now() - ago) - base::Time::UnixEpoch()).InMicroseconds());
+}
+
+std::string ExportHistory() {
+  return base::StrCat(
+      {R"({"metadata": {"browser_name": "Safari", "data_type": "history",
+          "schema_version": 1}, "history": [
+         {"url": "https://safari-seen.example/", "title": "Seen",
+          "visit_count": 2, "time_usec": )",
+       UsecAgo(base::Days(1)),
+       R"(},
+         {"url": "http://safari-hop.example/", "visit_count": 1,
+          "destination_url": "https://safari-hop.example/",
+          "time_usec": )",
+       UsecAgo(base::Hours(1)), R"(}]})"});
+}
+
+constexpr char kOpenImportStep[] = R"(
+  for (let i = 0;
+       i < 3 && !document.querySelector('[data-focus="safari-file"]');
+       ++i) {
+    document.querySelector('footer button.primary').click();
+  })";
+
+// The welcome flow, opened over the window, on its import step.
+content::WebContents* OpenWelcomeImportStep(BrowserWindowInterface& browser) {
+  stedding::ShowWelcomeDialog(browser);
+  content::WebContents* page = nullptr;
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    for (content::WebContents* const contents : content::GetAllWebContents()) {
+      if (contents->GetVisibleURL().host() == "stedding-welcome") {
+        page = contents;
+      }
+    }
+    return page != nullptr;
+  })) << "no welcome flow";
+  if (!page) {
+    return nullptr;
+  }
+  EXPECT_TRUE(content::WaitForLoadStop(page));
+  EXPECT_EQ("object",
+            content::EvalJs(page, "typeof steddingWelcomeTest").ExtractString())
+      << "the welcome page has no test hook: resources.pak is older than "
+         "this test binary";
+  EXPECT_TRUE(content::ExecJs(page, kOpenImportStep));
+  return page;
+}
+
+// The page's state, as a string.
+std::string State(content::WebContents* page, std::string_view field) {
+  return content::EvalJs(
+             page, base::StrCat({"String(steddingWelcomeTest.state.", field,
+                                 ")"}))
+      .ExtractString();
+}
+
+// The logins in the profile's own store.
+std::vector<password_manager::StoredCredential> Logins(Profile* profile) {
+  scoped_refptr<password_manager::PasswordStoreInterface> store =
+      ProfilePasswordStoreFactory::GetForProfile(
+          profile, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!store) {
+    ADD_FAILURE() << "no password store";
+    return {};
+  }
+  password_manager::PasswordStoreResultsObserver observer;
+  store->GetAllLogins(observer.GetWeakPtr());
+  return observer.WaitForResults();
+}
+
+std::optional<std::u16string> PasswordFor(Profile* profile,
+                                          std::string_view realm,
+                                          std::u16string_view username) {
+  for (const password_manager::StoredCredential& login : Logins(profile)) {
+    if (login.signon_realm == realm && login.username_value == username) {
+      return login.password_value.value();
+    }
+  }
+  return std::nullopt;
+}
