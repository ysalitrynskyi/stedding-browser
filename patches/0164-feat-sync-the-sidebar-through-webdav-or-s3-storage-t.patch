+// Sf52: the list that stops at its cap says nothing about what it left out.
+TEST_F(SidebarSyncBridgeTest, ASignInThatCannotBeReadAnswersRefused) {
+  FakeServer server(PlaceKind::kWebDav);
+  const PlaceForm form = CheckPlaceForm(server.place.Form(
+      GURL("https://place.example.net/"), FakePlace::kSecret));
