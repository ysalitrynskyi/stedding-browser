 namespace spaces {
 
@@ -53,6 +56,20 @@ void SpaceTabVisibilityController::PinTabsForTesting() {
     tab_strip_model_->SetTabPinned(i, true);
   }
   UpdateTabVisibility();
+  UpdateWindowTint();
+}
+
+void SpaceTabVisibilityController::UpdateWindowTint() {
+  views::Widget* const widget = tab_strip_root_->GetWidget();
+  if (!widget) {
+    return;
+  }
+  const Space* const active = model_->active_space();
+  // A window with one unnamed Space should look like an ordinary window, so
+  // only tint once the user has more than one Space to tell apart.
+  widget->SetUserColorOverride(model_->size() > 1 && active
+                                   ? std::optional<SkColor>(active->color())
+                                   : std::nullopt);
 }
 
 void SpaceTabVisibilityController::UpdateTabVisibility() {
@@ -87,10 +104,16 @@ void SpaceTabVisibilityController::UpdateSubtree(views::View& parent) {
 void SpaceTabVisibilityController::OnActiveSpaceChanged(const SpaceId& from,
                                                         const SpaceId& to) {
   UpdateTabVisibility();
+  UpdateWindowTint();
+}
+
+void SpaceTabVisibilityController::OnSpaceMetadataChanged(const SpaceId& id) {
+  UpdateWindowTint();
 }
 
 void SpaceTabVisibilityController::OnSpaceRemoved(const SpaceId& id) {
   UpdateTabVisibility();
+  UpdateWindowTint();
 }
 
 }  // namespace spaces
