+// Stedding (windows G10, BACKLOG S-323): whether `tab` is part of a sidebar:
+// an essential (Chromium's pinned tab), a Space's pin, or a tab in a folder.
+bool IsSidebarTab(const sessions::SessionTab& tab) {
+  if (tab.pinned) {
+    return true;
+  }
+  const auto pin = tab.extra_data.find(spaces::kSessionTabSpacePinKey);
+  if (pin != tab.extra_data.end() && pin->second == "1") {
+    return true;
+  }
+  const auto path = tab.extra_data.find(stedding::kSessionTabFolderPathKey);
+  return path != tab.extra_data.end() && !path->second.empty() &&
+         path->second != "[]";
+}
+
+// Stedding (windows G10, BACKLOG S-323): with On startup set to the New Tab
+// page or to specific pages, a launch brings back each normal window's
+// sidebar and leaves its loose tabs closed, as Arc does. A split comes back
+// whole when any of its tabs is kept. Popups and apps' windows stay closed,
+// as they did, and so does a window left with no tab.
+void KeepTheSidebarsOnly(
+    std::vector<std::unique_ptr<sessions::SessionWindow>>* windows) {
+  std::erase_if(*windows, [](const std::unique_ptr<sessions::SessionWindow>&
+                                 window) {
+    if (window->type != sessions::SessionWindow::TYPE_NORMAL) {
+      return true;
+    }
+    std::set<split_tabs::SplitTabId> kept_splits;
+    for (const std::unique_ptr<sessions::SessionTab>& tab : window->tabs) {
+      if (tab->split_id && IsSidebarTab(*tab)) {
+        kept_splits.insert(*tab->split_id);
+      }
+    }
+    const int selected = window->selected_tab_index;
+    int kept_before_selected = 0;
+    int index = 0;
+    std::erase_if(window->tabs,
+                  [&](const std::unique_ptr<sessions::SessionTab>& tab) {
+                    const bool kept =
+                        IsSidebarTab(*tab) ||
+                        (tab->split_id && kept_splits.contains(*tab->split_id));
+                    if (kept && index < selected) {
+                      ++kept_before_selected;
+                    }
+                    ++index;
+                    return !kept;
+                  });
+    if (window->tabs.empty()) {
+      return true;
+    }
+    window->selected_tab_index =
+        std::min(kept_before_selected,
+                 static_cast<int>(window->tabs.size()) - 1);
+    return false;
+  });
+}
+
