index 0000000000000..97ccd0629bf99
--- /dev/null
+++ b/chrome/browser/ui/stedding/blocker/blocker_rules.h
@@ -0,0 +1,107 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_RULES_H_
+#define CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_RULES_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "url/gurl.h"
+
+class HostContentSettingsMap;
+class PrefService;
+class Profile;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace stedding {
+
+// Ad and tracker blocking (docs/features/blocker.md): which pages are
+// filtered. The switch and the two lists live in local state, since the
+// ruleset is the browser's, one for every profile (Bk1, Bk2). The exceptions
+// for a site are Chromium's own ADS content setting of the profile, where
+// ALLOW for a site turns blocking off there (Bk5). Only an entry for a site
+// counts: the content setting's default, which Chromium's own "Intrusive
+// ads" page and policy can change, is not read, so it can never turn
+// blocking off everywhere while Stedding's switch says it is on.
+
+// Bk1, Bk2: the switch is on and at least one list is on. Blocking with
+// neither list on is the same as blocking off: nothing is fetched and no page
+// is filtered.
+bool BlockerOn(const PrefService* local_state);
+
+// Bk8: a page with the shape of a sign-in step is never filtered, so a
+// login that goes through a tracker-like host still works: a path segment
+// "oauth", "oauth2", "authorize" or "openid-connect", or a query that carries
+// both client_id and redirect_uri.
+bool IsSignInFlow(const GURL& url);
+
+// Bk5: whether `map` holds an entry for the site of `url` that turns
+// blocking off there. The default is not an entry.
+bool SiteHasBlockingOff(const HostContentSettingsMap* map, const GURL& url);
+
+// Bk1, Bk5, Bk8: whether a top-level page at `url` is filtered, given the
+// switch in `local_state` and the exceptions in `map`: the switch is on, the
+// page is http or https, it is not a sign-in step, and its site has no
+// exception.
+bool BlockerAppliesTo(const PrefService* local_state,
+                      const HostContentSettingsMap* map,
+                      const GURL& url);
+
+// The same for a page of `profile`, with the browser's local state. A
+// private window's map reads its own entries first, then the normal
+// profile's (Bk5).
+bool BlockerAppliesTo(Profile* profile, const GURL& url);
+
+// Bk5: turns blocking on or off for the site of `url` in `map`. Every entry
+// of the map's own that names the page goes first (one typed for a
+// subdomain would outrank the site's own); then the site gets an entry only
+// when the result is not yet what was asked: ALLOW to turn blocking off,
+// BLOCK to turn it back on over an exception a private window inherits.
+// `off_the_record` says whether `map` is a private session's, whose own
+// entries live in memory and go with it.
+void SetBlockingOnSiteInMap(HostContentSettingsMap* map,
+                            bool off_the_record,
+                            const GURL& url,
+                            bool on);
+
+// Bk6, Bk10: whether the page `contents` shows can have blocking turned on
+// or off for its site: the switch is on and the page is an http or https
+// page with a site.
+bool CanChooseBlockingForSite(content::WebContents* contents);
+
+// Bk6, Bk10: whether blocking applies to the site of the page `contents`
+// shows, by the map of the profile the tab belongs to.
+bool IsBlockingOnForSite(content::WebContents* contents);
+
+// Bk5, Bk6, Bk10: flips the site's switch in the map of the tab's own
+// profile (a private window's stays in memory) and reloads the tab so the
+// page shows the change.
+void ToggleBlockingOnSite(content::WebContents* contents);
+
+// How the site of the page `contents` shows is named on the button and in
+// the command bar: its registrable domain ("example.com"). Empty when the
+// page has none.
+std::u16string BlockerSiteName(content::WebContents* contents);
+
+// Bk9: the sites where the user turned blocking off, of the original
+// profile, sorted by name.
+std::vector<ContentSettingsPattern> GetBlockerExceptions(Profile* profile);
+
+// Bk9: adds a site typed in Settings (a host, a web address or `*.host`).
+// False, and nothing written, when what was typed is no site.
+bool AddBlockerException(Profile* profile, std::string_view typed);
+
+// Bk9: removes an exception, turning blocking back on for that site.
+void RemoveBlockerException(Profile* profile,
+                            const ContentSettingsPattern& pattern);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_RULES_H_
diff --git a/chrome/browser/ui/stedding/blocker/blocker_rules_unittest.cc b/chrome/browser/ui/stedding/blocker/blocker_rules_unittest.cc
new file mode 100644
index 0000000000000..aa203ce66134c
--- /dev/null
+++ b/chrome/browser/ui/stedding/blocker/blocker_rules_unittest.cc
@@ -0,0 +1,160 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/blocker/blocker_rules.h"
+
+#include <vector>
+
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/test/base/testing_profile.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/prefs/testing_pref_service.h"
+#include "content/public/test/browser_task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+class BlockerRulesTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    prefs::RegisterLocalStatePrefs(local_state_.registry());
+  }
+
+  void TurnOn() { local_state_.SetBoolean(prefs::kBlockerEnabled, true); }
+
+  HostContentSettingsMap* map() {
+    return HostContentSettingsMapFactory::GetForProfile(&profile_);
+  }
+
+  bool Applies(const char* url) {
+    return BlockerAppliesTo(&local_state_, map(), GURL(url));
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  TestingProfile profile_;
+  TestingPrefServiceSimple local_state_;
+};
+
+}  // namespace
+
+// Bk1, Bk5: off by default; on, every http and https page is filtered and no
+// browser page or file; a site's own exception turns it off there, for its
+// subdomains too, and nowhere else; the content setting's default does not
+// count; with both lists off nothing is filtered.
+TEST_F(BlockerRulesTest, TheSwitchTheSchemeAndTheSiteDecideEachPage) {
+  EXPECT_FALSE(BlockerOn(&local_state_)) << "off in a fresh install";
+  EXPECT_FALSE(Applies("https://www.example.com/"));
+
+  TurnOn();
+  EXPECT_TRUE(BlockerOn(&local_state_));
+  EXPECT_TRUE(Applies("https://www.example.com/"));
+  EXPECT_TRUE(Applies("http://news.example.com/a?b=c"));
+  EXPECT_FALSE(Applies("chrome://settings/"));
+  EXPECT_FALSE(Applies("file:///tmp/page.html"));
+  EXPECT_FALSE(Applies("about:blank"));
+
+  SetBlockingOnSiteInMap(map(), /*off_the_record=*/false,
+                         GURL("https://www.example.com/page"), /*on=*/false);
+  EXPECT_FALSE(Applies("https://www.example.com/"));
+  EXPECT_FALSE(Applies("http://news.example.com/")) << "the whole site";
+  EXPECT_TRUE(Applies("https://other.test/"));
+
+  // Chromium's own "Intrusive ads" default is not an exception for a site.
+  map()->SetDefaultContentSetting(ContentSettingsType::ADS,
+                                  CONTENT_SETTING_ALLOW);
+  EXPECT_TRUE(Applies("https://other.test/"));
+  map()->SetDefaultContentSetting(ContentSettingsType::ADS,
+                                  CONTENT_SETTING_BLOCK);
+
+  SetBlockingOnSiteInMap(map(), false, GURL("https://news.example.com/"),
+                         /*on=*/true);
+  EXPECT_TRUE(Applies("https://www.example.com/")) << "the exception went";
+  EXPECT_TRUE(GetBlockerExceptions(&profile_).empty());
+
+  local_state_.SetBoolean(prefs::kBlockerEasyList, false);
+  EXPECT_TRUE(Applies("https://www.example.com/")) << "one list is enough";
+  local_state_.SetBoolean(prefs::kBlockerEasyPrivacy, false);
+  EXPECT_FALSE(BlockerOn(&local_state_));
+  EXPECT_FALSE(Applies("https://www.example.com/"));
+}
+
+// Bk8: a sign-in step is let through.
+TEST_F(BlockerRulesTest, SignInFlowsAreLetThrough) {
+  TurnOn();
+  for (const char* url : {
+           "https://login.example.com/oauth/start",
+           "https://login.example.com/OAuth2/v2.0/token",
+           "https://id.example.com/authorize?x=1",
+           "https://id.example.com/realms/a/openid-connect/auth",
+           "https://sso.example.com/start?client_id=a&redirect_uri=https%3A%2F",
+       }) {
+    EXPECT_TRUE(IsSignInFlow(GURL(url))) << url;
+    EXPECT_FALSE(Applies(url)) << url;
+  }
+  for (const char* url : {
+           "https://www.example.com/",
+           "https://www.example.com/authorized-dealers",
+           "https://www.example.com/?client_id=a",
+           "https://www.example.com/?redirect_uri=b",
+       }) {
+    EXPECT_FALSE(IsSignInFlow(GURL(url))) << url;
+    EXPECT_TRUE(Applies(url)) << url;
+  }
+}
+
+// Bk5: a private window's choice stays in its own session; turning blocking
+// back on there over an exception it inherits writes its own entry.
+TEST_F(BlockerRulesTest, APrivateSessionsChoiceStaysInIt) {
+  TurnOn();
+  Profile* const otr = profile_.GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  HostContentSettingsMap* const otr_map =
+      HostContentSettingsMapFactory::GetForProfile(otr);
+  const GURL page("https://www.example.com/");
+
+  SetBlockingOnSiteInMap(otr_map, /*off_the_record=*/true, page, false);
+  EXPECT_FALSE(BlockerAppliesTo(&local_state_, otr_map, page));
+  EXPECT_TRUE(BlockerAppliesTo(&local_state_, map(), page))
+      << "the normal profile is untouched";
+  EXPECT_TRUE(GetBlockerExceptions(&profile_).empty());
+  SetBlockingOnSiteInMap(otr_map, true, page, true);
+  EXPECT_TRUE(BlockerAppliesTo(&local_state_, otr_map, page));
+
+  SetBlockingOnSiteInMap(map(), false, page, false);
+  EXPECT_FALSE(BlockerAppliesTo(&local_state_, otr_map, page))
+      << "the normal profile's exception is inherited";
+  SetBlockingOnSiteInMap(otr_map, true, page, true);
+  EXPECT_TRUE(BlockerAppliesTo(&local_state_, otr_map, page));
+  EXPECT_FALSE(BlockerAppliesTo(&local_state_, map(), page))
+      << "and the normal profile keeps it";
+}
+
+// Bk9: Settings lists the user's exceptions by name, adds a typed site and
+// removes one.
+TEST_F(BlockerRulesTest, ExceptionsAreListedAddedAndRemoved) {
+  TurnOn();
+  EXPECT_FALSE(AddBlockerException(&profile_, "chrome://settings"));
+  EXPECT_FALSE(AddBlockerException(&profile_, ""));
+  ASSERT_TRUE(AddBlockerException(&profile_, "https://shop.test/basket"));
+  ASSERT_TRUE(AddBlockerException(&profile_, "*.alpha.test"));
+  const std::vector<ContentSettingsPattern> sites =
+      GetBlockerExceptions(&profile_);
+  ASSERT_EQ(2u, sites.size());
+  EXPECT_EQ(ContentSettingsPattern::FromString("[*.]alpha.test"), sites[0]);
+  EXPECT_EQ(ContentSettingsPattern::FromString("[*.]shop.test"), sites[1]);
+  EXPECT_FALSE(Applies("https://www.shop.test/"));
+
+  RemoveBlockerException(&profile_, sites[1]);
+  EXPECT_TRUE(Applies("https://www.shop.test/"));
+  EXPECT_EQ(1u, GetBlockerExceptions(&profile_).size());
+}
+
+}  // namespace stedding
