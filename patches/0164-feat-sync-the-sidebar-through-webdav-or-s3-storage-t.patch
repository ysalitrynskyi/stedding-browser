new file mode 100644
index 0000000000000..ea0db3afc234e
--- /dev/null
+++ b/chrome/browser/ui/spaces/sidebar_sync_fake_place.cc
@@ -0,0 +1,421 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_sync_fake_place.h"
+
+#include "base/base64.h"
+#include "base/strings/escape.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+constexpr char kWebPage[] =
+    "<!doctype html><html><head><title>A site</title></head>"
+    "<body>Welcome</body></html>";
+constexpr char kWebDavRoot[] = "/dav/";
+
+std::string Find(const std::map<std::string, std::string>& headers,
+                 const std::string& name) {
+  const auto it = headers.find(name);
+  return it == headers.end() ? std::string() : it->second;
+}
+
+FakePlace::Reply S3Failure(int status,
+                           const std::string& code,
+                           const std::string& region = std::string()) {
+  FakePlace::Reply reply;
+  reply.status = status;
+  reply.body = base::StrCat({"<?xml version=\"1.0\"?><Error><Code>", code,
+                             "</Code><Message>No.</Message>"});
+  if (!region.empty()) {
+    base::StrAppend(&reply.body, {"<Region>", region, "</Region>"});
+  }
+  reply.body += "</Error>";
+  return reply;
+}
+
+std::string DavRow(const std::string& href,
+                   bool collection,
+                   const std::string& etag,
+                   size_t size) {
+  std::string row =
+      base::StrCat({"<d:response><d:href>", href,
+                    "</d:href><d:propstat><d:prop><d:resourcetype>"});
+  if (collection) {
+    row += "<d:collection/>";
+  }
+  row += "</d:resourcetype>";
+  if (!collection) {
+    base::StrAppend(&row, {"<d:getetag>\"", etag, "\"</d:getetag>",
+                           "<d:getcontentlength>",
+                           base::NumberToString(size),
+                           "</d:getcontentlength>"});
+  }
+  row +=
+      "</d:prop><d:status>HTTP/1.1 200 OK</d:status></d:propstat>"
+      "</d:response>";
+  return row;
+}
+
+}  // namespace
+
+FakePlace::Reply::Reply() = default;
+FakePlace::Reply::Reply(const Reply& other) = default;
+FakePlace::Reply::~Reply() = default;
+FakePlace::Knobs::Knobs() = default;
+FakePlace::Knobs::Knobs(const Knobs& other) = default;
+FakePlace::Knobs::~Knobs() = default;
+
+FakePlace::FakePlace(PlaceKind kind) : kind_(kind) {}
+FakePlace::~FakePlace() = default;
+
+std::string FakePlace::AddressOn(const GURL& base) const {
+  return kind_ == PlaceKind::kS3 ? base.GetWithEmptyPath().spec()
+                                 : base.Resolve(kWebDavRoot).spec();
+}
+
+base::DictValue FakePlace::Form(const GURL& base,
+                                const std::string& secret) const {
+  base::DictValue form;
+  if (kind_ == PlaceKind::kS3) {
+    form.Set("kind", "s3");
+    form.Set("endpoint", AddressOn(base));
+    form.Set("region", kRegion);
+    form.Set("bucket", kBucket);
+    form.Set("accessKey", kUser);
+    form.Set("secretKey", secret);
+  } else {
+    form.Set("kind", "webdav");
+    form.Set("address", AddressOn(base));
+    form.Set("user", kUser);
+    form.Set("password", secret);
+  }
+  return form;
+}
+
+void FakePlace::SetKnobs(const Knobs& knobs) {
+  base::AutoLock lock(lock_);
+  knobs_ = knobs;
+}
+
+std::map<std::string, std::string> FakePlace::Files() {
+  base::AutoLock lock(lock_);
+  return files_;
+}
+
+void FakePlace::PutFile(const std::string& name, const std::string& body) {
+  base::AutoLock lock(lock_);
+  folder_ = true;
+  files_[name] = body;
+  etags_[name] = NextETag();
+}
+
+void FakePlace::RemoveFile(const std::string& name) {
+  base::AutoLock lock(lock_);
+  files_.erase(name);
+  etags_.erase(name);
+}
+
+bool FakePlace::HasFolder() {
+  base::AutoLock lock(lock_);
+  return folder_;
+}
+
+int FakePlace::Count(const std::string& method) {
+  base::AutoLock lock(lock_);
+  return counts_[method];
+}
+
+void FakePlace::ResetCounts() {
+  base::AutoLock lock(lock_);
+  counts_.clear();
+}
+
+std::vector<std::string> FakePlace::SeenHeaders() {
+  base::AutoLock lock(lock_);
+  return seen_headers_;
+}
+
+std::string FakePlace::NextETag() {
+  return "etag-" + base::NumberToString(next_etag_++);
+}
+
+FakePlace::Reply FakePlace::Handle(
+    const std::string& method,
+    const GURL& url,
+    const std::map<std::string, std::string>& headers,
+    const std::string& body) {
+  base::AutoLock lock(lock_);
+  for (const auto& [name, value] : headers) {
+    seen_headers_.push_back(base::StrCat({name, ": ", value}));
+  }
+  if (!knobs_.redirect_to.empty()) {
+    Reply reply;
+    reply.status = 302;
+    reply.headers.emplace_back("Location", knobs_.redirect_to);
+    return reply;
+  }
+  if (knobs_.fail_status) {
+    Reply reply;
+    reply.status = knobs_.fail_status;
+    return reply;
+  }
+  if (knobs_.anyone_status && Find(headers, "authorization").empty()) {
+    Reply reply;
+    reply.status = knobs_.anyone_status;
+    return reply;
+  }
+  if (knobs_.see_other_on_write && method == "PUT") {
+    Reply reply;
+    reply.status = 303;
+    reply.headers.emplace_back("Location", url.spec());
+    return reply;
+  }
+  if (!knobs_.fail_file.empty() && method == "GET" &&
+      url.path().ends_with(knobs_.fail_file)) {
+    Reply reply;
+    reply.status = 500;
+    return reply;
+  }
+  if (knobs_.web_page) {
+    Reply reply;
+    reply.body = kWebPage;
+    reply.headers.emplace_back("Content-Type", "text/html");
+    return reply;
+  }
+  return kind_ == PlaceKind::kS3 ? HandleS3(method, url, headers, body)
+                                 : HandleWebDav(method, url, headers, body);
+}
+
+FakePlace::Reply FakePlace::HandleWebDav(
+    const std::string& method,
+    const GURL& url,
+    const std::map<std::string, std::string>& headers,
+    const std::string& body) {
+  ++counts_[method];
+  Reply reply;
+  const std::string expected = base::StrCat(
+      {"Basic ", base::Base64Encode(base::StrCat({kUser, ":", kSecret}))});
+  const std::string authorization = Find(headers, "authorization");
+  const bool signed_in = authorization == expected;
+  const bool open = (method == "PROPFIND" && knobs_.public_list) ||
+                    (method == "GET" && knobs_.public_read);
+  if (!signed_in && !open) {
+    reply.status = 401;
+    reply.headers.emplace_back(
+        "WWW-Authenticate",
+        knobs_.digest_only ? "Digest realm=\"x\", nonce=\"y\""
+                           : "Basic realm=\"x\"");
+    return reply;
+  }
+  if (knobs_.no_root) {
+    reply.status = 404;
+    return reply;
+  }
+  const std::string path = base::UnescapeBinaryURLComponent(url.path());
+  const std::string root = kWebDavRoot;
+  const std::string folder = base::StrCat({root, kFolder, "/"});
+  const bool at_root = path == root;
+  const bool at_folder = path == folder;
+  const std::string name = base::StartsWith(path, folder) && !at_folder
+                               ? path.substr(folder.size())
+                               : std::string();
+  if (method == "PROPFIND") {
+    if (knobs_.deny_list) {
+      reply.status = 403;
+      return reply;
+    }
+    if (at_folder && !folder_) {
+      reply.status = 404;
+      return reply;
+    }
+    reply.status = 207;
+    reply.headers.emplace_back("Content-Type", "application/xml");
+    reply.body =
+        "<?xml version=\"1.0\"?><d:multistatus xmlns:d=\"DAV:\">";
+    reply.body += DavRow(url.GetPath(), /*collection=*/true, "", 0);
+    if (at_folder && Find(headers, "depth") == "1" && !knobs_.hide_files) {
+      for (const auto& [file, content] : files_) {
+        reply.body +=
+            DavRow(base::StrCat({url.path(), base::EscapePath(file)}),
+                   /*collection=*/false, etags_[file], content.size());
+      }
+    }
+    reply.body += "</d:multistatus>";
+    return reply;
+  }
+  if (method == "MKCOL") {
+    if (knobs_.deny_write) {
+      reply.status = 403;
+    } else if (folder_ || !at_folder) {
+      reply.status = 405;
+    } else {
+      folder_ = true;
+      reply.status = 201;
+    }
+    return reply;
+  }
+  if (method == "PUT") {
+    if (knobs_.deny_write) {
+      reply.status = 403;
+    } else if (!folder_ || name.empty()) {
+      reply.status = 409;
+    } else {
+      files_[name] = body;
+      etags_[name] = NextETag();
+      if (!knobs_.no_etag) {
+        reply.headers.emplace_back("ETag", "\"" + etags_[name] + "\"");
+      }
+      reply.status = 201;
+    }
+    return reply;
+  }
+  if (method == "GET") {
+    const auto file = files_.find(name);
+    if (knobs_.deny_read) {
+      reply.status = 403;
+    } else if (file == files_.end()) {
+      reply.status = 404;
+    } else {
+      reply.body = file->second + (knobs_.corrupt_read ? "x" : "");
+    }
+    return reply;
+  }
+  if (method == "DELETE") {
+    if (at_folder) {
+      folder_ = false;
+      reply.status = 204;
+    } else if (knobs_.deny_delete) {
+      reply.status = 403;
+    } else if (files_.erase(name)) {
+      etags_.erase(name);
+      reply.status = 204;
+    } else {
+      reply.status = 404;
+    }
+    return reply;
+  }
+  reply.status = at_root ? 405 : 501;
+  return reply;
+}
+
+FakePlace::Reply FakePlace::HandleS3(
+    const std::string& method,
+    const GURL& url,
+    const std::map<std::string, std::string>& headers,
+    const std::string& body) {
+  const bool list = method == "GET" && url.has_query();
+  ++counts_[list ? std::string("LIST") : method];
+  const std::string authorization = Find(headers, "authorization");
+  if (authorization.empty()) {
+    if ((list && knobs_.public_list) ||
+        (method == "GET" && !list && knobs_.public_read)) {
+      // Falls through to the answer anyone gets.
+    } else {
+      return S3Failure(403, "AccessDenied");
+    }
+  } else {
+    if (authorization.find(base::StrCat({"Credential=", kUser, "/"})) ==
+        std::string::npos) {
+      return S3Failure(403, "InvalidAccessKeyId");
+    }
+    if (knobs_.clock_skew) {
+      return S3Failure(403, "RequestTimeTooSkewed");
+    }
+    if (knobs_.wrong_region) {
+      return S3Failure(400, "AuthorizationHeaderMalformed", "elsewhere-2");
+    }
+    if (knobs_.moved_region) {
+      Reply moved = S3Failure(301, "PermanentRedirect");
+      moved.headers.emplace_back("x-amz-bucket-region", "elsewhere-2");
+      return moved;
+    }
+    // The signature as this request's own bytes make it.
+    SigV4Input input;
+    input.method = method;
+    input.url = url;
+    input.payload_hash = Find(headers, "x-amz-content-sha256");
+    input.amz_date = Find(headers, "x-amz-date");
+    input.region = kRegion;
+    input.service = "s3";
+    input.access_key = kUser;
+    input.secret_key = kSecret;
+    input.headers["x-amz-content-sha256"] = input.payload_hash;
+    input.headers["x-amz-date"] = input.amz_date;
+    if (authorization != SigV4Authorization(input) ||
+        input.payload_hash != Sha256Hex(body)) {
+      return S3Failure(403, "SignatureDoesNotMatch");
+    }
+  }
+  if (knobs_.no_root) {
+    return S3Failure(404, "NoSuchBucket");
+  }
+  const std::string path = base::UnescapeBinaryURLComponent(url.path());
+  const std::string prefix =
+      base::StrCat({"/", kBucket, "/", kFolder, "/"});
+  if (list) {
+    if (knobs_.deny_list) {
+      return S3Failure(403, "AccessDenied");
+    }
+    Reply reply;
+    reply.headers.emplace_back("Content-Type", "application/xml");
+    reply.body =
+        "<?xml version=\"1.0\"?><ListBucketResult xmlns=\"http://s3\">"
+        "<IsTruncated>false</IsTruncated>";
+    if (!knobs_.hide_files) {
+      for (const auto& [file, content] : files_) {
+        base::StrAppend(
+            &reply.body,
+            {"<Contents><Key>", kFolder, "/", file, "</Key><ETag>&quot;",
+             etags_[file], "&quot;</ETag><Size>",
+             base::NumberToString(content.size()), "</Size></Contents>"});
+      }
+    }
+    reply.body += "</ListBucketResult>";
+    return reply;
+  }
+  if (!base::StartsWith(path, prefix)) {
+    return S3Failure(404, "NoSuchKey");
+  }
+  const std::string name = path.substr(prefix.size());
+  Reply reply;
+  if (method == "PUT") {
+    if (knobs_.deny_write) {
+      return S3Failure(403, "AccessDenied");
+    }
+    files_[name] = body;
+    etags_[name] = NextETag();
+    if (!knobs_.no_etag) {
+      reply.headers.emplace_back("ETag", "\"" + etags_[name] + "\"");
+    }
+    return reply;
+  }
+  if (method == "GET") {
+    if (knobs_.deny_read) {
+      return S3Failure(403, "AccessDenied");
+    }
+    const auto file = files_.find(name);
+    if (file == files_.end()) {
+      return S3Failure(404, "NoSuchKey");
+    }
+    reply.body = file->second + (knobs_.corrupt_read ? "x" : "");
+    return reply;
+  }
+  if (method == "DELETE") {
+    if (knobs_.deny_delete) {
+      return S3Failure(403, "AccessDenied");
+    }
+    files_.erase(name);
+    etags_.erase(name);
+    reply.status = 204;
+    return reply;
+  }
+  return S3Failure(405, "MethodNotAllowed");
+}
+
+}  // namespace spaces::sidebar_sync
diff --git a/chrome/browser/ui/spaces/sidebar_sync_fake_place.h b/chrome/browser/ui/spaces/sidebar_sync_fake_place.h
new file mode 100644
index 0000000000000..7a55fc162d9b0
--- /dev/null
+++ b/chrome/browser/ui/spaces/sidebar_sync_fake_place.h
@@ -0,0 +1,138 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_FAKE_PLACE_H_
+#define CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_FAKE_PLACE_H_
+
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/synchronization/lock.h"
+#include "base/thread_annotations.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_place.h"
+#include "url/gurl.h"
+
+namespace spaces::sidebar_sync {
+
+// A WebDAV server or S3 service in memory, for the tests of Sf43-Sf57: what
+// the real ones answer, including their failures, and nothing else. A test
+// puts it behind a fake URL loader factory or an embedded test server. S3's
+// signature is checked against the request as it arrived.
+class FakePlace {
+ public:
+  static constexpr char kFolder[] = "Stedding Sidebar";
+  static constexpr char kUser[] = "someone";
+  static constexpr char kSecret[] = "a-secret-nobody-guesses";
+  static constexpr char kBucket[] = "a-bucket";
+  static constexpr char kRegion[] = "somewhere-1";
+
+  struct Reply {
+    Reply();
+    Reply(const Reply& other);
+    ~Reply();
+
+    int status = 200;
+    std::string body;
+    std::vector<std::pair<std::string, std::string>> headers;
+  };
+
+  // What the server does. A test turns one on at a time.
+  struct Knobs {
+    Knobs();
+    Knobs(const Knobs& other);
+    ~Knobs();
+
+    // An ordinary web page, for every request.
+    bool web_page = false;
+    // The folder or bucket is not there.
+    bool no_root = false;
+    bool deny_list = false;
+    bool deny_read = false;
+    bool deny_write = false;
+    bool deny_delete = false;
+    // The file read back is not the file written.
+    bool corrupt_read = false;
+    // A list leaves files out.
+    bool hide_files = false;
+    // Anyone may list, or read.
+    bool public_list = false;
+    bool public_read = false;
+    // WebDAV: Digest is all it offers.
+    bool digest_only = false;
+    // S3: the bucket is elsewhere, said in the error's body; or by a 301
+    // with a header; or the time is too far off.
+    bool wrong_region = false;
+    bool moved_region = false;
+    bool clock_skew = false;
+    // Every request is answered with this status.
+    int fail_status = 0;
+    // Every request is redirected here.
+    std::string redirect_to;
+    // A write gives no ETag back.
+    bool no_etag = false;
+    // A request with no sign-in is answered with this status.
+    int anyone_status = 0;
+    // A read of this file answers 500.
+    std::string fail_file;
+    // A write is sent to its own address with a 303.
+    bool see_other_on_write = false;
+  };
+
+  explicit FakePlace(PlaceKind kind);
+  FakePlace(const FakePlace&) = delete;
+  FakePlace& operator=(const FakePlace&) = delete;
+  ~FakePlace();
+
+  // The WebDAV folder or S3 endpoint to type, on `base`.
+  std::string AddressOn(const GURL& base) const;
+  // The form that signs in, with `secret` as its password or secret key.
+  base::DictValue Form(const GURL& base,
+                       const std::string& secret = kSecret) const;
+
+  // `headers` have lower-case names.
+  Reply Handle(const std::string& method,
+               const GURL& url,
+               const std::map<std::string, std::string>& headers,
+               const std::string& body);
+
+  void SetKnobs(const Knobs& knobs);
+  std::map<std::string, std::string> Files();
+  void PutFile(const std::string& name, const std::string& body);
+  void RemoveFile(const std::string& name);
+  bool HasFolder();
+  // How many requests used `method` (a list on S3 is "LIST").
+  int Count(const std::string& method);
+  void ResetCounts();
+  // Every header any request carried, lower-case, as `name: value`.
+  std::vector<std::string> SeenHeaders();
+
+ private:
+  Reply HandleWebDav(const std::string& method,
+                     const GURL& url,
+                     const std::map<std::string, std::string>& headers,
+                     const std::string& body)
+      EXCLUSIVE_LOCKS_REQUIRED(lock_);
+  Reply HandleS3(const std::string& method,
+                 const GURL& url,
+                 const std::map<std::string, std::string>& headers,
+                 const std::string& body) EXCLUSIVE_LOCKS_REQUIRED(lock_);
+  std::string NextETag() EXCLUSIVE_LOCKS_REQUIRED(lock_);
+
+  const PlaceKind kind_;
+  base::Lock lock_;
+  Knobs knobs_ GUARDED_BY(lock_);
+  bool folder_ GUARDED_BY(lock_) = false;
+  // Name to body, and name to ETag.
+  std::map<std::string, std::string> files_ GUARDED_BY(lock_);
+  std::map<std::string, std::string> etags_ GUARDED_BY(lock_);
+  std::map<std::string, int> counts_ GUARDED_BY(lock_);
+  std::vector<std::string> seen_headers_ GUARDED_BY(lock_);
+  int next_etag_ GUARDED_BY(lock_) = 1;
+};
