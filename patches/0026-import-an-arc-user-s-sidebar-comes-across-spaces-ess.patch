+void SteddingSpacesHandler::HandleGetArcImport(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  spaces::LoadArcSidebarInfo(
+      base::BindOnce(&SteddingSpacesHandler::OnArcSidebarInfo,
+                     weak_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void SteddingSpacesHandler::OnArcSidebarInfo(const std::string& callback_id,
+                                             spaces::ArcSidebarInfo info) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  ResolveJavascriptCallback(
+      base::Value(callback_id),
+      base::Value(info.found ? info.summary : std::u16string()));
+}
+
+void SteddingSpacesHandler::HandleImportFromArc(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  spaces::ImportFromArcAsync(
+      browser, spaces::ArcImportOptions(),
+      base::BindOnce(&SteddingSpacesHandler::OnArcImportDone,
+                     weak_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void SteddingSpacesHandler::OnArcImportDone(
+    const std::string& callback_id,
+    std::optional<spaces::ArcImportResult> result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  PushSpaces();
+  ResolveJavascriptCallback(
+      base::Value(callback_id),
+      base::Value(result ? spaces::DescribeArcImportResult(*result)
+                         : u"Nothing was imported."));
+}
