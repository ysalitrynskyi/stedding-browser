+// I7: how much of the first two panes of a split the first takes. Arc keeps
+// `itemWidthFactors`, a list of pane ids each followed by its share, the pane
+// a split nobody resized gives alone; a pane with no share has an equal share
+// of what is left. Numbers alone are read by the panes' order. Anything else,
+// or a share out of range, is half and half.
+double FirstPaneShare(const base::DictValue& split,
+                      const std::vector<std::string>& panes) {
+  constexpr double kHalf = 0.5;
+  const base::ListValue* const factors = split.FindList("itemWidthFactors");
+  if (!factors || panes.size() < 2) {
+    return kHalf;
+  }
+  std::map<std::string, double> shares;
+  for (size_t i = 0; i < factors->size(); ++i) {
+    const base::Value& value = (*factors)[i];
+    if (value.is_string() && i + 1 < factors->size() &&
+        (*factors)[i + 1].is_double()) {
+      shares[value.GetString()] = (*factors)[i + 1].GetDouble();
+      ++i;
+    } else if (value.is_double() && i < panes.size()) {
+      shares[panes[i]] = value.GetDouble();
+    } else {
+      return kHalf;
+    }
+  }
+  double known = 0;
+  size_t missing = 0;
+  for (const std::string& pane : panes) {
+    const auto it = shares.find(pane);
+    if (it == shares.end()) {
+      ++missing;
+    } else {
+      known += it->second;
+    }
+  }
+  const double rest = missing > 0 ? (1 - known) / missing : 0;
+  const auto share_of = [&](const std::string& pane) {
+    const auto it = shares.find(pane);
+    return it == shares.end() ? rest : it->second;
+  };
+  const double first = share_of(panes[0]);
+  const double second = share_of(panes[1]);
+  if (!(first > 0) || !(second > 0)) {
+    return kHalf;
+  }
+  return first / (first + second);
+}
