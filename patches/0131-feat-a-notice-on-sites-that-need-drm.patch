+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The DRM notice in a real window (docs/features/drm-notice.md): which pages
+// show the bar, what its button, its link and its close box do, how often it
+// comes, Settings' list, and the windows that have one and the page that has
+// none. Hosts on the table are mapped to the test server, which answers https
+// because a listed site is reached over https.
+
+#include "chrome/browser/ui/stedding/drm_notice.h"
+
+#include <string>
