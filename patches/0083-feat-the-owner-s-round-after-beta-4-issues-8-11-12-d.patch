+// copy-link L7 (BACKLOG S-273, GitHub issue 11): the button lets its hover go
+// after a click. The pointer moved onto it lights it; a press and a release
+// there copy the link; the pointer moved off over the page, the fill goes,
+// and it stays gone once the check mark has turned back into the link. The
+// fill stayed on after a click, with the pointer gone.
+IN_PROC_BROWSER_TEST_F(CopyLinkTest, TheButtonLetsGoOfItsHoverAfterAClick) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("shop.test", "/title1.html")));
+  ASSERT_TRUE(WaitForButton(browser(), true));
+  page_actions::PageActionView* const button = ButtonOf(browser());
+  views::Widget* const widget = button->GetWidget();
+  ASSERT_TRUE(widget);
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  // Where the button is when asked: another page action showing beside it
+  // once the page has loaded moves it along the field.
+  const auto on = [&]() { return button->GetBoundsInScreen().CenterPoint(); };
+  const auto aside = [&]() {
+    return on() - gfx::Vector2d(2 * button->width(), 0);
+  };
+  const gfx::Point off =
+      browser_view->contents_container()->GetBoundsInScreen().CenterPoint();
+  // Asked for each time: the button makes its ink drop again whenever its
+  // background is set again (ConfigureInkDropForRefresh2023), so one held
+  // across the click was a freed one (AddressSanitizer, 2026-10-22).
+  const auto ink = [&]() { return views::InkDrop::Get(button)->GetInkDrop(); };
+  const auto lit = [&]() {
+    return ink()->IsHighlightFadingInOrVisible() ||
+           (ink()->GetTargetInkDropState() != views::InkDropState::HIDDEN &&
+            ink()->GetTargetInkDropState() != views::InkDropState::DEACTIVATED);
+  };
+
+  // The pointer onto the button, and onto the field's text beside it and
+  // back until the button is lit: an ink drop made again after the pointer
+  // came -- the address row taking the page's colour, late on a slow build --
+  // does not know it is hovered.
+  SendMouse(widget, ui::EventType::kMouseMoved, on());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    if (lit()) {
+      return true;
+    }
+    SendMouse(widget, ui::EventType::kMouseMoved, aside());
+    SendMouse(widget, ui::EventType::kMouseMoved, on());
+    return false;
+  })) << "no hover fill under the pointer";
+  const gfx::Point at = on();
+  SendMouse(widget, ui::EventType::kMousePressed, at);
+  SendMouse(widget, ui::EventType::kMouseReleased, at);
+  EXPECT_TRUE(ShowsTheCheckMark(button))
+      << "the click copied nothing: clipboard \"" << ClipboardText() << "\"";
+  SendMouse(widget, ui::EventType::kMouseMoved, off);
