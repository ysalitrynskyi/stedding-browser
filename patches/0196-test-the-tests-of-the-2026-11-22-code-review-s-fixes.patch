+
+namespace {
+
+using stedding::SidebarPanel;
+
+// The panel's row for `key` (a page's address or a download's id), as a
+// script expression.
+std::string RowForB04(const std::string& attribute, const std::string& key) {
+  return content::JsReplace(
+      "[...document.querySelectorAll('#list .row')].find("
+      "    row => row.dataset[$1] === $2)",
+      attribute, key);
+}
+
+class SidebarPanelsB04Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        &content::SlowDownloadHttpResponse::HandleSlowDownloadRequest));
+    embedded_test_server()->ServeFilesFromSourceDirectory("chrome/test/data");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  void TearDownOnMainThread() override {
+    // A download still in progress would hold the browser's shutdown.
+    content::DownloadManager::DownloadVector items;
+    manager()->GetAllDownloads(&items);
+    for (download::DownloadItem* const item : items) {
+      if (item->GetState() == download::DownloadItem::IN_PROGRESS) {
+        item->Cancel(/*user_cancel=*/true);
+      }
+    }
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* window() { return browser_view()->GetWidget(); }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  stedding::SidebarPanelView* panel_view() {
+    return region()->sidebar_panel_view_for_testing();
+  }
+  content::WebContents* panel_page() {
+    return panel_view() ? panel_view()->web_view()->GetWebContents() : nullptr;
+  }
+  content::DownloadManager* manager() {
+    return browser()->GetProfile()->GetDownloadManager();
+  }
+  history::HistoryService* history() {
+    return HistoryServiceFactory::GetForProfile(
+        browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  }
+
+  // Waits until `panel` is the one in the sidebar's column and its page has
+  // built itself.
+  [[nodiscard]] bool WaitForPanel(SidebarPanel panel) {
+    if (!base::test::RunUntil([&]() {
+          views::test::RunScheduledLayout(window());
+          stedding::SidebarPanelView* const view = panel_view();
+          return view != nullptr && view->panel() == panel;
+        })) {
+      return false;
+    }
+    content::WebContents* const page = panel_page();
+    if (!content::WaitForLoadStop(page)) {
+      return false;
+    }
+    return base::test::RunUntil([&]() {
+      return content::EvalJs(page, "document.body.dataset.panel || ''")
+                 .ExtractString() != "";
+    });
+  }
+
+  int RowCount() {
+    return content::EvalJs(panel_page(),
+                           "document.querySelectorAll('#list .row').length")
+        .ExtractInt();
+  }
+  [[nodiscard]] bool WaitForRows(int count) {
+    return base::test::RunUntil([&]() { return RowCount() == count; });
+  }
+  // Types `text` into the panel's search field, as a person does.
+  void Search(const std::string& text) {
+    ASSERT_TRUE(content::ExecJs(
+        panel_page(),
+        content::JsReplace("{ const field = document.getElementById('search');"
+                           "  field.value = $1;"
+                           "  field.dispatchEvent(new Event('input')); }",
+                           text)));
+  }
+  // Lets the panel's page draw two frames: a redraw it has asked for has run.
+  [[nodiscard]] bool WaitForTwoFrames() {
+    return content::ExecJs(panel_page(),
+                           "new Promise(r => requestAnimationFrame(() => "
+                           "requestAnimationFrame(r)))");
+  }
+
+  // Starts a download that stays in progress until the test ends it.
+  download::DownloadItem* StartSlowDownload() {
+    content::DownloadTestObserverInProgress in_progress(manager(), 1);
+    ui_test_utils::NavigateToURLWithDisposition(
+        browser(),
+        embedded_test_server()->GetURL(
+            content::SlowDownloadHttpResponse::kKnownSizeUrl),
+        WindowOpenDisposition::kCurrentTab,
+        ui_test_utils::BROWSER_TEST_NO_WAIT);
+    in_progress.WaitForFinished();
+    content::DownloadManager::DownloadVector items;
+    manager()->GetAllDownloads(&items);
+    for (download::DownloadItem* const item : items) {
+      if (item->GetState() == download::DownloadItem::IN_PROGRESS) {
+        return item;
+      }
+    }
+    return nullptr;
+  }
+  // A finished download in the history, "listed-<i>.txt", `i` minutes old,
+  // its file on disk: the panel's page marks a download whose file is
+  // missing deleted.
+  download::DownloadItem* AddFinishedDownload(int i) {
+    const base::Time now = base::Time::Now();
+    const std::string name = "listed-" + base::NumberToString(i) + ".txt";
+    const base::FilePath path =
+        browser()->GetProfile()->GetPath().AppendASCII(name);
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      if (!base::WriteFile(path, "0123456789")) {
+        return nullptr;
+      }
+    }
+    return manager()->CreateDownloadItem(
+        base::Uuid::GenerateRandomV4().AsLowercaseString(),
+        /*id=*/10000 + i, path, path,
+        {embedded_test_server()->GetURL("a.test", "/" + name)}, GURL(),
+        content::StoragePartitionConfig::CreateDefault(browser()->GetProfile()),
+        GURL(), GURL(), std::nullopt, "text/plain", "text/plain",
+        now - base::Minutes(i), now - base::Minutes(i), std::string(),
+        std::string(), /*received_bytes=*/10, /*total_bytes=*/10,
+        std::string(), download::DownloadItem::COMPLETE,
+        download::DOWNLOAD_DANGER_TYPE_NOT_DANGEROUS,
+        download::DOWNLOAD_INTERRUPT_REASON_NONE, /*opened=*/false, now,
+        /*transient=*/false, {}, /*display_name=*/base::FilePath());
+  }
+
+  // From here on, counts the Downloads page's updates as the panel's page
+  // receives them, on the panel's own connection, and the presses the page
+  // receives.
+  [[nodiscard]] bool CountUpdatesAndPresses() {
+    return content::ExecJs(panel_page(), R"(
+        (async () => {
+          const url = new URL('downloads.mojom-webui.js', location.href).href;
+          const {browserProxyFactory} = await import(url);
+          window.updatesB04 = 0;
+          browserProxyFactory.getInstance().callbackRouter.updateItem
+              .addListener(() => { ++window.updatesB04; });
+          window.pressesB04 = 0;
+          document.addEventListener(
+              'mousedown', () => { ++window.pressesB04; }, true);
+        })())");
+  }
+  int Updates() {
+    return content::EvalJs(panel_page(), "window.updatesB04").ExtractInt();
+  }
+  int Presses() {
+    return content::EvalJs(panel_page(), "window.pressesB04").ExtractInt();
+  }
+  // Waits until the panel has drawn a download's update that came after now.
+  [[nodiscard]] bool WaitForAnUpdateDrawn() {
+    const int updates = Updates();
+    return base::test::RunUntil([&]() { return Updates() > updates; }) &&
+           WaitForTwoFrames();
+  }
+
+  // The left button's press or release at `point` of the panel's page, as
+  // its widget receives a person's.
+  void SendPanelMouse(blink::WebInputEvent::Type type,
+                      const gfx::PointF& point) {
+    const int modifiers = type == blink::WebInputEvent::Type::kMouseDown
+                              ? blink::WebInputEvent::kLeftButtonDown
+                              : blink::WebInputEvent::kNoModifiers;
+    const blink::WebMouseEvent event(
+        type, point, point, blink::WebPointerProperties::Button::kLeft,
+        /*click_count_param=*/1, modifiers, base::TimeTicks::Now());
+    panel_page()
+        ->GetPrimaryMainFrame()
+        ->GetRenderWidgetHost()
+        ->ForwardMouseEvent(event);
+  }
+  // Presses `element` (a script expression), holds the press until the
+  // panel has drawn a download's update, and lets go: a person's click with
+  // an update between its press and its release.
+  [[nodiscard]] bool PressAcrossAnUpdate(const std::string& element) {
+    const std::string rect = "(" + element + ").getBoundingClientRect()";
+    const int x =
+        content::EvalJs(panel_page(),
+                        "(r => Math.round(r.left + r.width / 2))(" + rect + ")")
+            .ExtractInt();
+    const int y =
+        content::EvalJs(panel_page(),
+                        "(r => Math.round(r.top + r.height / 2))(" + rect + ")")
+            .ExtractInt();
+    // The point is on the element, not on something drawn over it.
+    if (!content::EvalJs(panel_page(),
+                         content::JsReplace(
+                             "(" + element +
+                                 ").contains(document.elementFromPoint($1, $2))",
+                             x, y))
+             .ExtractBool()) {
+      return false;
+    }
+    const gfx::PointF point(static_cast<float>(x), static_cast<float>(y));
+    const int presses = Presses();
+    SendPanelMouse(blink::WebInputEvent::Type::kMouseDown, point);
+    if (!base::test::RunUntil([&]() { return Presses() > presses; })) {
+      return false;
+    }
+    if (!WaitForAnUpdateDrawn()) {
+      return false;
+    }
+    SendPanelMouse(blink::WebInputEvent::Type::kMouseUp, point);
+    return true;
+  }
+
+  // Opens the Downloads panel and waits for the row of the download `id` in
+  // progress, with its Pause.
+  [[nodiscard]] bool OpenDownloadsOver(const std::string& id) {
+    if (!chrome::ExecuteCommand(browser(), IDC_SHOW_DOWNLOADS) ||
+        !WaitForPanel(SidebarPanel::kDownloads)) {
+      return false;
+    }
+    content::SimulateEndOfPaintHoldingOnPrimaryMainFrame(panel_page());
+    return base::test::RunUntil([&]() {
+      return content::EvalJs(panel_page(),
+                             "!!" + RowForB04("id", id) +
+                                 "?.querySelector('[data-action=pause]')")
+          .ExtractBool();
+    });
+  }
+
+  void AddVisit(const GURL& url, const std::u16string& title, base::Time when) {
+    history()->AddPageWithDetails(url, title, /*visit_count=*/1,
+                                  /*typed_count=*/0, when, /*hidden=*/false,
+                                  history::SOURCE_BROWSED);
+  }
+};
+
+// P04-1b, Pn9: a press on Pause held while the panel draws the download's
+// next update still pauses it. Every update drew every row anew, and Blink
+// sends no click when the pressed button left the page before the release,
+// so a click with a redraw inside it was lost.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsB04Test,
+                       APressOnPauseHeldAcrossAnUpdateStillPauses) {
+  download::DownloadItem* const item = StartSlowDownload();
+  ASSERT_TRUE(item);
+  const std::string id = base::NumberToString(item->GetId());
+  ASSERT_TRUE(OpenDownloadsOver(id));
+  ASSERT_TRUE(CountUpdatesAndPresses());
+
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(), "window.pauseB04 = " + RowForB04("id", id) +
+                        ".querySelector('[data-action=pause]');"));
+  ASSERT_TRUE(WaitForAnUpdateDrawn());
+  EXPECT_EQ(true, content::EvalJs(panel_page(),
+                                  "window.pauseB04.isConnected && "
+                                  "window.pauseB04 === " +
+                                      RowForB04("id", id) +
+                                      ".querySelector('[data-action=pause]')"))
+      << "an update drew the row's Pause anew";
+
+  ASSERT_TRUE(PressAcrossAnUpdate(RowForB04("id", id) +
+                                  ".querySelector('[data-action=pause]')"));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return item->IsPaused(); }))
+      << "the press was lost to the redraw";
+}
+
+// P04-1b, Pn9: a press on a finished row's menu button held while the panel
+// draws another download's update still opens the menu: that row, which the
+// update does not change, is not drawn anew either.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsB04Test,
+                       APressOnAFinishedRowsMenuHeldAcrossAnUpdateOpensIt) {
+  download::DownloadItem* const finished = AddFinishedDownload(1);
+  ASSERT_TRUE(finished);
+  const std::string finished_id = base::NumberToString(finished->GetId());
+  download::DownloadItem* const item = StartSlowDownload();
+  ASSERT_TRUE(item);
+  ASSERT_TRUE(OpenDownloadsOver(base::NumberToString(item->GetId())));
+  ASSERT_TRUE(WaitForRows(2));
+  ASSERT_TRUE(CountUpdatesAndPresses());
+  ASSERT_EQ(true,
+            content::EvalJs(panel_page(), "document.getElementById('menu')"
+                                          ".hidden"));
+
+  ASSERT_TRUE(PressAcrossAnUpdate(RowForB04("id", finished_id) +
+                                  ".querySelector('.menu-button')"));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !content::EvalJs(panel_page(),
+                            "document.getElementById('menu').hidden")
+                .ExtractBool();
+  })) << "the press was lost to the redraw";
+}
+
+// P04-1e, Pn9: the keyboard's focus on a download's Cancel stays on Cancel
+// while the download's updates are drawn and when a new row joins the list.
+// The redraw put it back by the first of the button's classes, which Pause
+// shares, so Enter then paused the download instead of cancelling it.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsB04Test,
+                       TheFocusOnCancelStaysThereAcrossARedraw) {
+  download::DownloadItem* const item = StartSlowDownload();
+  ASSERT_TRUE(item);
+  const std::string id = base::NumberToString(item->GetId());
+  ASSERT_TRUE(OpenDownloadsOver(id));
+  ASSERT_TRUE(CountUpdatesAndPresses());
+
+  const std::string focused =
+      "(() => {"
+      "  const focused = document.activeElement;"
+      "  const row = focused && focused.closest('.row');"
+      "  return (row ? row.dataset.id : '') + ':' +"
+      "      (focused.dataset.action || '');"
+      "})()";
+  ASSERT_TRUE(content::ExecJs(panel_page(),
+                              RowForB04("id", id) +
+                                  ".querySelector('[data-action=cancel]')"
+                                  ".focus();"));
+  ASSERT_EQ(id + ":cancel", content::EvalJs(panel_page(), focused));
+
+  {
+    SCOPED_TRACE("an update of the download");
+    ASSERT_TRUE(WaitForAnUpdateDrawn());
+    ASSERT_TRUE(WaitForAnUpdateDrawn());
+    EXPECT_EQ(id + ":cancel", content::EvalJs(panel_page(), focused));
+  }
+  {
+    SCOPED_TRACE("a new row in the list");
+    ASSERT_TRUE(AddFinishedDownload(1));
+    ASSERT_TRUE(WaitForRows(2));
+    ASSERT_TRUE(WaitForTwoFrames());
+    EXPECT_EQ(id + ":cancel", content::EvalJs(panel_page(), focused));
+  }
+}
+
+// P04-1c, Pn9: a download interrupted by the network, which Chromium can
+// go on with at the user's word, offers Resume in its row's menu, and Resume
+// sets it going again. The row offered only Remove from List: Retry is for
+// a download that cannot go on, and Resume was drawn only for a paused one.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsB04Test,
+                       AnInterruptedDownloadThatCanGoOnOffersResume) {
+  download::DownloadItem* const item = StartSlowDownload();
+  ASSERT_TRUE(item);
+  const std::string id = base::NumberToString(item->GetId());
+  ASSERT_TRUE(OpenDownloadsOver(id));
+
+  item->SimulateErrorForTesting(
+      download::DOWNLOAD_INTERRUPT_REASON_NETWORK_FAILED);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return item->GetState() == download::DownloadItem::INTERRUPTED;
+  }));
+  ASSERT_TRUE(item->CanResume()) << "the kind of download this is about";
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(),
+                           RowForB04("id", id) + "?.dataset.state || ''")
+               .ExtractString() == "kInterrupted";
+  }));
+
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(),
+      RowForB04("id", id) + ".querySelector('.menu-button').click();"));
+  ASSERT_EQ(true, content::EvalJs(panel_page(),
+                                  "!!document.querySelector("
+                                  "    '#menu [data-action=resume]')"))
+      << "the menu offers "
+      << content::EvalJs(panel_page(),
+                         "[...document.querySelectorAll('#menu [data-action]')]"
+                         ".map(item => item.dataset.action).join(',')")
+             .ExtractString();
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(),
+      "document.querySelector('#menu [data-action=resume]').click();"));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return item->GetState() == download::DownloadItem::IN_PROGRESS;
+  })) << "Resume did not set the download going";
+}
+
+// P04-1d, Pn6: a search's rows are grouped by day, as the list's are, and
+// each shows its time. Chromium leaves a search result's day and time empty,
