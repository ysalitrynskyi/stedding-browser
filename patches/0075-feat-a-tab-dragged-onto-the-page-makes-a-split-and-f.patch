@@ -0,0 +1,227 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/tabs.md R45-R48 (BACKLOG S-110): which restored tabs load at
+// launch. The rule is a pure function; the hook is entered as the session
+// restore enters it, on a window of restored, not yet loaded tabs.
+
+#include "chrome/browser/ui/stedding/startup_load.h"
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/prefs/pref_service.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/restore_type.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "content/public/test/web_contents_tester.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// tabs R45, R46: the three choices against every kind of restored row. The
+// other pane of the selected split has the selected tab's facts: both are on
+// screen. An essential is shown in every Space; a tab of another Space and
+// one in a collapsed folder are not shown.
+TEST(StartupLoadRulesTest, TheChoiceDecidesWhichRestoredTabsLoad) {
+  struct Row {
+    const char* trace;
+    RestoredTabFacts facts;
+    bool selected_tab;
+    bool and_essentials;
+    bool active_space;
+  };
+  const Row rows[] = {
+      {"the selected tab, or the other pane of its split",
+       {.on_screen = true, .shown_in_active_space = true}, true, true, true},
+      {"an essential",
+       {.essential = true, .shown_in_active_space = true}, false, true, true},
+      {"a tab of the active Space", {.shown_in_active_space = true}, false,
+       false, true},
+      {"a tab in a collapsed folder of the active Space", {}, false, false,
+       false},
+      {"a tab of another Space", {}, false, false, false},
+  };
+  for (const Row& row : rows) {
+    SCOPED_TRACE(row.trace);
+    EXPECT_EQ(row.selected_tab,
+              LoadsAtStartup(StartupLoad::kSelectedTab, row.facts));
+    EXPECT_EQ(row.and_essentials,
+              LoadsAtStartup(StartupLoad::kSelectedTabAndEssentials,
+                             row.facts));
+    EXPECT_EQ(row.active_space,
+              LoadsAtStartup(StartupLoad::kActiveSpace, row.facts));
+  }
+}
+
+// tabs R45: the preference's three values, and a value no build writes, which
+// reads as the default.
+TEST(StartupLoadRulesTest, AValueNoBuildWritesReadsAsTheSelectedTab) {
+  EXPECT_EQ(StartupLoad::kSelectedTab, StartupLoadFromPref(0));
+  EXPECT_EQ(StartupLoad::kSelectedTabAndEssentials, StartupLoadFromPref(1));
+  EXPECT_EQ(StartupLoad::kActiveSpace, StartupLoadFromPref(2));
+  for (const int value : {-1, 3, 240}) {
+    SCOPED_TRACE(value);
+    EXPECT_EQ(StartupLoad::kSelectedTab, StartupLoadFromPref(value));
+  }
+  for (const int value : prefs::kStartupLoadChoices) {
+    EXPECT_EQ(value, static_cast<int>(StartupLoadFromPref(value)));
+  }
+}
+
+class StartupLoadWindowTest : public BrowserWithTestWindowTest,
+                              public testing::WithParamInterface<StartupLoad> {
+ protected:
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+
+  // A tab as a session restore makes it: its entry restored, nothing loaded,
+  // added in the background.
+  tabs::TabInterface* AddRestored(const std::string& host) {
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+    std::vector<std::unique_ptr<content::NavigationEntry>> entries;
+    entries.push_back(content::NavigationController::CreateNavigationEntry(
+        GURL("https://" + host + "/"), content::Referrer(), std::nullopt,
+        std::nullopt, ui::PAGE_TRANSITION_RELOAD, false, std::string(),
+        profile(), nullptr));
+    contents->GetController().Restore(0, content::RestoreType::kRestored,
+                                      &entries);
+    content::WebContents* const raw = contents.get();
+    tabs().AppendTab(
+        std::make_unique<tabs::TabModel>(std::move(contents), &tabs()),
+        /*foreground=*/false);
+    return tabs().GetTabForWebContents(raw);
+  }
+
+  int Index(tabs::TabInterface* tab) { return tabs().GetIndexOfTab(tab); }
+};
+
+// tabs R46, R48: the hook reads the choice and, of a window's restored tabs,
+// hands the loader what the choice names; every other tab is put to sleep,
+// with no load begun or left running. The essential, a plain row of the
+// Space on screen, a row in a collapsed folder of that Space, a row the
+// session puts back into a collapsed folder (the restore makes its folder
+// after the hook), a row of another Space, and a row of the Space on screen
+// whose load began as the restore filled the window (on the Mac the first tab
+// a window gets is shown for a moment), against each choice. The selected
+// tab and the other pane of its split are handed over whatever the choice
+// says.
+TEST_P(StartupLoadWindowTest,
+       ARestoreLoadsWhatTheChoiceNamesAndSleepsTheRest) {
+  profile()->GetPrefs()->SetInteger(prefs::kStartupLoad,
+                                    static_cast<int>(GetParam()));
+  tabs::TabInterface* const essential = AddRestored("essential.test");
+  tabs().SetTabPinned(Index(essential), true);
+  tabs::TabInterface* const left = AddRestored("left.test");
+  tabs::TabInterface* const right = AddRestored("right.test");
+  tabs::TabInterface* const plain = AddRestored("plain.test");
+  tabs::TabInterface* const folded = AddRestored("folded.test");
+  tabs::TabInterface* const refolded = AddRestored("refolded.test");
+  tabs::TabInterface* const elsewhere = AddRestored("elsewhere.test");
+  tabs::TabInterface* const begun = AddRestored("begun.test");
+  tabs::FolderTabCollection* const folder =
+      tabs().AddToNewFolder({Index(folded)});
+  ASSERT_TRUE(folder);
+  folder->SetCollapsed(true);
+  spaces::FolderRestorePath::CreateForWebContents(
+      refolded->GetContents(), R"([{"i":"1","t":"Later","c":false},)"
+                               R"({"i":"2","t":"Inner","c":true}])");
+  const spaces::SpaceId work = model().AddSpace("Work", SK_ColorBLUE)->id();
+  model().SetSpaceForTab(elsewhere, work);
+  tabs().ActivateTabAt(Index(left));
+  tabs().AddToNewSplit({Index(right)}, split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_TRUE(tabs().IsTabHidden(Index(folded)));
+  ASSERT_TRUE(tabs().IsTabHidden(Index(elsewhere)));
+  ASSERT_FALSE(tabs().IsTabHidden(Index(plain)));
+  ASSERT_FALSE(tabs().IsTabHidden(Index(refolded)));
+  for (tabs::TabInterface* const tab :
+       {essential, plain, folded, refolded, elsewhere, begun}) {
+    ASSERT_TRUE(tab->GetContents()->GetController().NeedsReload());
+  }
+  begun->GetContents()->GetController().LoadIfNecessary();
+  ASSERT_FALSE(begun->GetContents()->GetController().NeedsReload());
+  ASSERT_TRUE(begun->GetContents()->IsLoading());
+
+  const std::vector<content::WebContents*> load = TabsToLoadAtStartup({
+      {essential->GetContents(), false},
+      {left->GetContents(), true},
+      {right->GetContents(), false},
+      {plain->GetContents(), false},
+      {folded->GetContents(), false},
+      {refolded->GetContents(), false},
+      {elsewhere->GetContents(), false},
+      {begun->GetContents(), false},
+  });
+
+  const bool essentials = GetParam() != StartupLoad::kSelectedTab;
+  const bool space = GetParam() == StartupLoad::kActiveSpace;
+  const struct {
+    const char* trace;
+    raw_ptr<tabs::TabInterface> tab;
+    bool loads;
+  } expected[] = {
+      {"the essential", essential, essentials},
+      {"the selected tab", left, true},
+      {"the other pane of its split", right, true},
+      {"a plain row of the Space on screen", plain, space},
+      {"a row in a collapsed folder", folded, false},
+      {"a row the session puts back in a collapsed folder", refolded, false},
+      {"a row of another Space", elsewhere, false},
+      {"a row whose load began", begun, space},
+  };
+  std::vector<content::WebContents*> in_order;
+  for (const auto& row : expected) {
+    SCOPED_TRACE(row.trace);
+    content::WebContents* const contents = row.tab->GetContents();
+    EXPECT_EQ(row.loads, std::ranges::contains(load, contents));
+    EXPECT_EQ(!row.loads, contents->WasDiscarded()) << "asleep or not";
+    if (row.loads) {
+      in_order.push_back(contents);
+    } else {
+      EXPECT_TRUE(contents->GetController().NeedsReload())
+          << "it loads when it is selected";
+      EXPECT_FALSE(contents->IsLoading()) << "nothing loading";
+    }
+  }
+  EXPECT_EQ(in_order, load) << "in the restore's order";
+  for (tabs::TabInterface* const tab :
+       {essential, plain, folded, refolded, elsewhere}) {
+    EXPECT_TRUE(tab->GetContents()->GetController().NeedsReload())
+        << "nothing loads in the hook itself";
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(,
+                         StartupLoadWindowTest,
+                         testing::Values(StartupLoad::kSelectedTab,
+                                         StartupLoad::kSelectedTabAndEssentials,
+                                         StartupLoad::kActiveSpace));
+
+}  // namespace
+}  // namespace stedding
