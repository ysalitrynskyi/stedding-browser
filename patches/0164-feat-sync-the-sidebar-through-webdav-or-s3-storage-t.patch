+std::string SignInToText(const PlaceSignIn& sign_in) {
+  base::DictValue value;
+  value.Set("name", sign_in.name);
+  value.Set("secret", sign_in.secret);
+  std::string text;
+  base::JSONWriter::Write(value, &text);
+  return text;
+}
+
+std::optional<PlaceSignIn> SignInFromText(std::string_view text) {
+  std::optional<base::Value> value = base::JSONReader::Read(
+      text, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!value || !value->is_dict()) {
+    return std::nullopt;
+  }
+  const std::string* const name = value->GetDict().FindString("name");
+  const std::string* const secret = value->GetDict().FindString("secret");
+  if (!name || !secret || name->empty() || secret->empty()) {
+    return std::nullopt;
+  }
+  return PlaceSignIn{*name, *secret};
+}
+
+bool IsPrivateNetworkHost(const GURL& url) {
+  if (net::IsLocalhost(url)) {
+    return true;
+  }
+  const std::string host = base::ToLowerASCII(url.HostNoBracketsPiece());
+  if (const std::optional<net::IPAddress> ip =
+          net::IPAddress::FromIPLiteral(host)) {
+    return !ip->IsPubliclyRoutable();
+  }
+  if (host.empty() || host.find('.') == std::string::npos) {
+    return !host.empty();
+  }
+  for (const char* const suffix :
+       {".local", ".lan", ".internal", ".home.arpa"}) {
+    if (base::EndsWith(host, suffix)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+AddressCheck CheckAddress(std::string_view typed, GURL* address) {
+  const GURL url{typed};
+  if (!url.is_valid() || url.host().empty() ||
+      !(url.SchemeIs(url::kHttpsScheme) || url.SchemeIs(url::kHttpScheme))) {
+    return AddressCheck::kMalformed;
+  }
+  if (url.has_username() || url.has_password()) {
+    return AddressCheck::kNameInside;
+  }
+  if (url.has_query() || url.has_ref()) {
+    return AddressCheck::kMalformed;
+  }
+  const bool encrypted = url.SchemeIs(url::kHttpsScheme);
+  if (!encrypted && !IsPrivateNetworkHost(url)) {
+    return AddressCheck::kNotHttps;
+  }
+  std::string path = url.GetPath();
+  if (path.empty() || path.back() != '/') {
+    path.push_back('/');
+  }
+  GURL::Replacements replacements;
+  replacements.SetPathStr(path);
+  *address = url.ReplaceComponents(replacements);
+  return encrypted ? AddressCheck::kEncrypted : AddressCheck::kUnencrypted;
+}
+
+PlaceForm::PlaceForm() = default;
+PlaceForm::PlaceForm(const PlaceForm& other) = default;
+PlaceForm& PlaceForm::operator=(const PlaceForm& other) = default;
+PlaceForm::~PlaceForm() = default;
+
+namespace {
+
+void CheckAddressField(std::string_view typed,
+                       GURL* address,
+                       PlaceForm* form,
+                       bool* filled) {
+  if (typed.empty()) {
+    *filled = false;
+    return;
+  }
+  switch (CheckAddress(typed, address)) {
+    case AddressCheck::kEncrypted:
+      break;
+    case AddressCheck::kUnencrypted:
+      form->unencrypted = true;
+      break;
+    case AddressCheck::kMalformed:
+      form->problem = "address";
+      break;
+    case AddressCheck::kNotHttps:
+      form->problem = "notHttps";
+      break;
+    case AddressCheck::kNameInside:
+      form->problem = "nameInside";
+      break;
+  }
+}
+
+// Sf45: a WebDAV user name may be any text but `:`, which Basic sign-in
+// cannot carry; a password any text. An S3 key is printable ASCII.
+std::optional<PlaceSignIn> CheckSignInFields(PlaceKind kind,
+                                             const base::DictValue& fields,
+                                             PlaceForm* form,
+                                             bool* filled) {
+  const bool s3 = kind == PlaceKind::kS3;
+  const std::string name = Trimmed(fields, s3 ? "accessKey" : "user");
+  const std::string secret = s3 ? Trimmed(fields, "secretKey")
+                                : Exact(fields, "password");
+  if (name.empty() || secret.empty()) {
+    *filled = false;
+  }
+  const bool name_good =
+      name.size() <= kMaxFieldLength &&
+      (s3 ? IsPrintableAscii(name)
+          : !HasControl(name) && name.find(':') == std::string::npos);
+  const bool secret_good =
+      secret.size() <= kMaxFieldLength &&
+      (s3 ? IsPrintableAscii(secret) : !HasControl(secret));
+  if (form->problem.empty() && !name_good) {
+    form->problem = "name";
+  } else if (form->problem.empty() && !secret_good) {
+    form->problem = "secret";
+  }
+  if (!*filled || !name_good || !secret_good) {
+    return std::nullopt;
+  }
+  return PlaceSignIn{name, secret};
+}
+
+}  // namespace
+
+PlaceForm CheckSignInForm(PlaceKind kind, const base::DictValue& fields) {
+  PlaceForm form;
+  bool filled = true;
+  form.sign_in = CheckSignInFields(kind, fields, &form, &filled);
+  return form;
+}
+
+PlaceForm CheckPlaceForm(const base::DictValue& fields) {
+  PlaceForm form;
+  Place place;
+  bool filled = true;
+  const std::string kind = Trimmed(fields, "kind");
+  if (kind == kKindS3) {
+    place.kind = PlaceKind::kS3;
+    const std::string endpoint = Trimmed(fields, "endpoint");
+    place.region = Trimmed(fields, "region");
+    place.bucket = Trimmed(fields, "bucket");
+    CheckAddressField(endpoint, &place.address, &form, &filled);
+    // An endpoint is a host: a bucket and a path have their own fields.
+    if (form.problem.empty() && filled && place.address.path() != "/") {
+      form.problem = "address";
+    }
+    filled &= !place.region.empty() && !place.bucket.empty();
+    if (form.problem.empty() && !place.region.empty() &&
+        !IsRegionName(place.region)) {
+      form.problem = "region";
+    }
+    if (form.problem.empty() && !place.bucket.empty() &&
+        !IsBucketName(place.bucket)) {
+      form.problem = "bucket";
+    }
+    const std::optional<std::string> path =
+        CleanPath(Trimmed(fields, "path"));
+    if (path) {
+      place.path = *path;
+    } else if (form.problem.empty()) {
+      form.problem = "path";
+    }
+  } else if (kind == kKindWebDav) {
+    CheckAddressField(Trimmed(fields, "address"), &place.address, &form,
+                      &filled);
+  } else {
+    filled = false;
+  }
+  std::optional<PlaceSignIn> sign_in =
+      CheckSignInFields(place.kind, fields, &form, &filled);
+  if (filled && form.problem.empty()) {
+    form.place = std::move(place);
+    form.sign_in = std::move(sign_in);
+  }
+  return form;
+}
+
+GURL WebDavFolderUrl(const Place& place) {
+  const std::string folder = UriEncode(kSyncFolderName, /*keep_slash=*/false);
+  const std::string_view path = place.address.path();
+  if (base::EndsWith(path, "/" + folder + "/")) {
+    return place.address;
+  }
+  return place.address.Resolve(folder + "/");
+}
+
+std::string S3KeyPrefix(const Place& place) {
+  if (place.path.empty() || place.path == kSyncFolderName) {
+    return base::StrCat({kSyncFolderName, "/"});
+  }
+  if (base::EndsWith(place.path, base::StrCat({"/", kSyncFolderName}))) {
+    return place.path + "/";
+  }
+  return base::StrCat({place.path, "/", kSyncFolderName, "/"});
+}
+
+GURL S3ListUrl(const Place& place, int max_keys) {
+  // In the order a signature wants them.
+  const std::string query = base::StrCat(
+      {"delimiter=%2F&list-type=2&max-keys=", base::NumberToString(max_keys),
+       "&prefix=", UriEncode(S3KeyPrefix(place), /*keep_slash=*/false)});
+  GURL::Replacements replacements;
+  const std::string path = "/" + place.bucket;
+  replacements.SetPathStr(path);
+  replacements.SetQueryStr(query);
+  return place.address.ReplaceComponents(replacements);
+}
+
+GURL S3ObjectUrl(const Place& place, std::string_view name) {
+  GURL::Replacements replacements;
+  const std::string path =
+      base::StrCat({"/", place.bucket, "/",
+                    UriEncode(S3KeyPrefix(place), /*keep_slash=*/true),
+                    UriEncode(name, /*keep_slash=*/false)});
+  replacements.SetPathStr(path);
+  return place.address.ReplaceComponents(replacements);
+}
+
+std::string UriEncode(std::string_view text, bool keep_slash) {
+  std::string encoded;
+  for (const char c : text) {
+    if (base::IsAsciiAlphaNumeric(c) || c == '-' || c == '.' || c == '_' ||
+        c == '~' || (keep_slash && c == '/')) {
+      encoded.push_back(c);
+    } else {
+      base::StringAppendF(&encoded, "%%%02X", static_cast<unsigned char>(c));
+    }
+  }
+  return encoded;
+}
+
+SigV4Input::SigV4Input() = default;
+SigV4Input::SigV4Input(const SigV4Input& other) = default;
+SigV4Input& SigV4Input::operator=(const SigV4Input& other) = default;
+SigV4Input::~SigV4Input() = default;
+
+std::string Sha256Hex(std::string_view data) {
+  return base::HexEncodeLower(crypto::hash::Sha256(data));
+}
+
+std::string AmzDate(base::Time time) {
+  base::Time::Exploded parts;
+  time.UTCExplode(&parts);
+  return base::StringPrintf("%04d%02d%02dT%02d%02d%02dZ", parts.year,
+                            parts.month, parts.day_of_month, parts.hour,
+                            parts.minute, parts.second);
+}
+
+std::string SigV4Authorization(const SigV4Input& input) {
+  std::map<std::string, std::string> headers = input.headers;
+  headers["host"] = HostAndPort(input.url);
+  std::string canonical_headers;
+  std::string signed_headers;
+  for (const auto& [name, value] : headers) {
+    base::StrAppend(&canonical_headers, {name, ":", value, "\n"});
+    if (!signed_headers.empty()) {
+      signed_headers.push_back(';');
+    }
+    signed_headers += name;
+  }
+  // A query's pairs, each as `key=value`, in the order of their bytes. The
+  // URL holds them encoded already.
+  std::vector<std::string> pairs;
+  for (std::string_view pair :
+       base::SplitStringPiece(input.url.query(), "&", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    pairs.emplace_back(pair.find('=') == std::string_view::npos
+                           ? base::StrCat({pair, "="})
+                           : std::string(pair));
+  }
+  std::ranges::sort(pairs);
+  const std::string canonical = base::StrCat(
+      {input.method, "\n", input.url.path(), "\n",
+       base::JoinString(pairs, "&"), "\n", canonical_headers, "\n",
+       signed_headers, "\n", input.payload_hash});
+  const std::string_view date = std::string_view(input.amz_date).substr(0, 8);
+  const std::string scope = base::StrCat(
+      {date, "/", input.region, "/", input.service, "/aws4_request"});
+  const std::string to_sign =
+      base::StrCat({"AWS4-HMAC-SHA256\n", input.amz_date, "\n", scope, "\n",
+                    Sha256Hex(canonical)});
+  const std::string first = "AWS4" + input.secret_key;
+  const auto hmac = [](base::span<const uint8_t> key, std::string_view data) {
+    return crypto::hmac::SignSha256(key, base::as_byte_span(data));
+  };
+  const auto date_key = hmac(base::as_byte_span(first), date);
+  const auto region_key = hmac(date_key, input.region);
+  const auto service_key = hmac(region_key, input.service);
+  const auto signing_key = hmac(service_key, "aws4_request");
+  const auto signature = hmac(signing_key, to_sign);
+  return base::StrCat({"AWS4-HMAC-SHA256 Credential=", input.access_key, "/",
+                       scope, ",SignedHeaders=", signed_headers,
+                       ",Signature=", base::HexEncodeLower(signature)});
+}
+
+PlaceList::PlaceList() = default;
+PlaceList::PlaceList(PlaceList&& other) = default;
+PlaceList& PlaceList::operator=(PlaceList&& other) = default;
+PlaceList::~PlaceList() = default;
+
+bool IsSafeEntryName(std::string_view name) {
+  if (name.empty() || name.size() > kMaxNameLength || name == "." ||
+      name == ".." || HasControl(name) || !base::IsStringUTF8(name)) {
+    return false;
+  }
+  return name.find_first_of("/\\<>:\"|?*") == std::string_view::npos;
+}
+
+std::optional<PlaceList> ParseWebDavList(const base::Value& root,
+                                         const GURL& folder) {
+  if (LocalName(root) != "multistatus") {
+    return std::nullopt;
+  }
+  PlaceList list;
+  const base::ListValue* const children =
+      data_decoder::GetXmlElementChildren(root);
+  if (!children) {
+    return list;
+  }
+  for (const base::Value& response : *children) {
+    if (LocalName(response) != "response") {
+      continue;
+    }
+    if (list.entries.size() >= kMaxListEntries) {
+      list.cut_short = true;
+      break;
+    }
+    const GURL href = folder.Resolve(ChildText(response, "href"));
+    std::string path = base::UnescapeBinaryURLComponent(href.path());
+    const bool slash = !path.empty() && path.back() == '/';
+    if (slash) {
+      path.pop_back();
+    }
+    PlaceEntry entry;
+    entry.name = path.substr(path.rfind('/') + 1);
+    entry.folder = slash;
+    std::string etag;
+    std::string modified;
+    const base::ListValue* const parts =
+        data_decoder::GetXmlElementChildren(response);
+    if (!parts) {
+      continue;
+    }
+    for (const base::Value& part : *parts) {
+      if (LocalName(part) != "propstat") {
+        continue;
+      }
+      const base::Value* const prop = Child(part, "prop");
+      if (!prop) {
+        continue;
+      }
+      if (const base::Value* const type = Child(*prop, "resourcetype")) {
+        entry.folder |= Child(*type, "collection") != nullptr;
+      }
+      etag = etag.empty() ? ChildText(*prop, "getetag") : etag;
+      modified =
+          modified.empty() ? ChildText(*prop, "getlastmodified") : modified;
+      int64_t size = 0;
+      if (base::StringToInt64(ChildText(*prop, "getcontentlength"), &size)) {
+        entry.size = size;
+      }
+    }
+    entry.version = VersionOf(std::move(etag), modified, entry.size);
+    if (entry.folder || IsSafeEntryName(entry.name)) {
+      list.entries.push_back(std::move(entry));
+    }
+  }
+  return list;
+}
+
+std::optional<PlaceList> ParseS3List(const base::Value& root,
+                                     std::string_view prefix) {
+  if (LocalName(root) != "ListBucketResult") {
+    return std::nullopt;
+  }
+  PlaceList list;
+  list.cut_short = ChildText(root, "IsTruncated") == "true";
+  const base::ListValue* const children =
+      data_decoder::GetXmlElementChildren(root);
+  if (!children) {
+    return list;
+  }
+  for (const base::Value& child : *children) {
+    if (LocalName(child) != "Contents") {
+      continue;
+    }
+    if (list.entries.size() >= kMaxListEntries) {
+      list.cut_short = true;
+      break;
+    }
+    const std::string key = ChildText(child, "Key");
+    if (!base::StartsWith(key, prefix)) {
+      continue;
+    }
+    PlaceEntry entry;
+    entry.name = key.substr(prefix.size());
+    if (!base::StringToInt64(ChildText(child, "Size"), &entry.size)) {
+      entry.size = -1;
+    }
+    entry.version = VersionOf(ChildText(child, "ETag"),
+                              ChildText(child, "LastModified"), entry.size);
+    if (IsSafeEntryName(entry.name)) {
+      list.entries.push_back(std::move(entry));
+    }
+  }
+  return list;
+}
+
+S3Error ParseS3Error(const base::Value& root) {
+  S3Error error;
+  if (LocalName(root) == "Error") {
+    error.code = ChildText(root, "Code");
+    error.region = ChildText(root, "Region");
+  }
+  return error;
+}
+
+PlaceFailure FailureOfStatus(PlaceOp op, int http_status, bool basic_offered) {
+  switch (http_status) {
+    case 401:
+      return basic_offered ? PlaceFailure::kSignIn : PlaceFailure::kSignInKind;
+    case 403:
+      switch (op) {
+        case PlaceOp::kRoot:
+        case PlaceOp::kList:
+          return PlaceFailure::kNoList;
+        case PlaceOp::kRead:
+          return PlaceFailure::kNoRead;
+        case PlaceOp::kWrite:
+          return PlaceFailure::kNoWrite;
+        case PlaceOp::kDelete:
+          return PlaceFailure::kNoDelete;
+      }
+      break;
+    case 404:
+    case 410:
+      return PlaceFailure::kNoSuchPlace;
+    case 405:
+    case 501:
+      switch (op) {
+        case PlaceOp::kRoot:
+        case PlaceOp::kList:
+          return PlaceFailure::kWebPage;
+        case PlaceOp::kRead:
+          return PlaceFailure::kNoRead;
+        case PlaceOp::kWrite:
+          return PlaceFailure::kNoWrite;
+        case PlaceOp::kDelete:
+          return PlaceFailure::kNoDelete;
+      }
+      break;
+    default:
+      break;
+  }
+  return PlaceFailure::kServerError;
+}
+
+PlaceFailure FailureOfS3Error(PlaceOp op,
+                              int http_status,
+                              std::string_view code) {
+  for (std::string_view refused :
+       {"InvalidAccessKeyId", "SignatureDoesNotMatch", "InvalidToken",
+        "ExpiredToken", "InvalidSecurity", "TokenRefreshRequired",
+        "AccountProblem", "InvalidAccessKey"}) {
+    if (code == refused) {
+      return PlaceFailure::kSignIn;
+    }
+  }
+  if (code == "RequestTimeTooSkewed" || code == "RequestExpired") {
+    return PlaceFailure::kClock;
+  }
+  if (code == "AuthorizationHeaderMalformed" || code == "PermanentRedirect" ||
+      code == "TemporaryRedirect" || code == "IllegalLocationConstraint" ||
+      http_status == 301) {
+    return PlaceFailure::kWrongRegion;
+  }
+  if (code == "NoSuchBucket") {
+    return PlaceFailure::kNoSuchPlace;
+  }
+  if (code == "NoSuchKey" && op == PlaceOp::kRead) {
+    return PlaceFailure::kNoSuchPlace;
+  }
+  return FailureOfStatus(op, http_status, /*basic_offered=*/true);
+}
+
+PlaceFailure FailureOfNetError(int net_error) {
+  if (net_error == net::ERR_TIMED_OUT ||
+      net_error == net::ERR_CONNECTION_TIMED_OUT) {
+    return PlaceFailure::kTimedOut;
+  }
+  if (net::IsCertificateError(net_error) ||
+      net_error == net::ERR_SSL_PROTOCOL_ERROR) {
+    return PlaceFailure::kCertificate;
+  }
+  if (net_error == net::ERR_INSUFFICIENT_RESOURCES) {
+    return PlaceFailure::kTooLarge;
+  }
+  return PlaceFailure::kUnreachable;
+}
+
+std::string_view PlaceFailureName(PlaceFailure failure) {
+  switch (failure) {
+    case PlaceFailure::kNone:
+      return "";
+    case PlaceFailure::kSignIn:
+      return "signIn";
+    case PlaceFailure::kSignInKind:
+      return "signInKind";
+    case PlaceFailure::kWebPage:
+      return "webPage";
+    case PlaceFailure::kNoSuchPlace:
+      return "noSuchPlace";
+    case PlaceFailure::kNoWrite:
+      return "noWrite";
+    case PlaceFailure::kNoRead:
+      return "noRead";
+    case PlaceFailure::kNoList:
+      return "noList";
+    case PlaceFailure::kNoDelete:
+      return "noDelete";
+    case PlaceFailure::kWrongRegion:
+      return "wrongRegion";
+    case PlaceFailure::kClock:
+      return "clock";
+    case PlaceFailure::kTimedOut:
+      return "timedOut";
+    case PlaceFailure::kUnreachable:
+      return "unreachable";
+    case PlaceFailure::kCertificate:
+      return "certificate";
+    case PlaceFailure::kRedirect:
+      return "redirect";
+    case PlaceFailure::kPublic:
+      return "public";
+    case PlaceFailure::kMismatch:
+      return "mismatch";
+    case PlaceFailure::kServerError:
+      return "serverError";
+    case PlaceFailure::kTooLarge:
+      return "tooLarge";
+  }
+}
+
+}  // namespace spaces::sidebar_sync
