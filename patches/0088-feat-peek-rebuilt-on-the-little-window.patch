+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/stedding/little_window.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/blink/public/mojom/window_features/window_features.mojom.h"
+#include "ui/base/base_window.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace stedding {
+
+namespace {
+
+// P12: a peek leaves this much of its window showing around it, so the page
+// it came from frames it.
+constexpr int kSideMargin = 72;
+constexpr int kTopMargin = 48;
+
+// P14: the source's window may take the activation back while the peek's
+// window appears -- Windows does when the browser is not the foreground
+// process -- and that is not the user's click on it.
+constexpr base::TimeDelta kOpeningGrace = base::Milliseconds(750);
+
+// P14: a click on the source's window that closes a peek is the press of a
+// click; when it lands on the very link the peek showed, the link's release
+// follows within this, and closes rather than opens it again.
+constexpr base::TimeDelta kSameLinkWindow = base::Seconds(2);
+
+// The peek a click on its source's window last closed.
+struct Dismissal {
+  tabs::TabHandle source;
+  GURL url;
+  base::TimeTicks when;
+};
+
+std::optional<Dismissal>& LastDismissal() {
+  static base::NoDestructor<std::optional<Dismissal>> dismissal;
+  return *dismissal;
+}
+
+// True, once, when `url` from `source` is the link whose peek a click on the
+// source's window has just closed.
+bool TakeDismissal(tabs::TabInterface* source, const GURL& url) {
+  std::optional<Dismissal>& last = LastDismissal();
+  const bool same = last && last->source == source->GetHandle() &&
+                    last->url == url &&
+                    base::TimeTicks::Now() - last->when < kSameLinkWindow;
+  last.reset();
+  return same;
+}
+
+// The window a page is a tab of now; null while it is not in one.
+BrowserWindowInterface* WindowOf(content::WebContents* contents) {
+  tabs::TabInterface* const tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  return tab ? tab->GetBrowserWindowInterface() : nullptr;
+}
+
+// What makes a page a peek's: the pinned tab it came from, and the watch on
+// that tab's window, whose activation closes the peek (P14).
+class PeekPage : public content::WebContentsUserData<PeekPage> {
+ public:
+  PeekPage(const PeekPage&) = delete;
+  PeekPage& operator=(const PeekPage&) = delete;
+  ~PeekPage() override = default;
+
+  tabs::TabInterface* source() const { return source_.get(); }
+  BrowserWindowInterface* source_window() const {
+    return source_ ? source_->GetBrowserWindowInterface() : nullptr;
+  }
+
+ private:
+  friend class content::WebContentsUserData<PeekPage>;
+
+  PeekPage(content::WebContents* contents,
+           tabs::TabInterface* source,
+           const GURL& url)
+      : content::WebContentsUserData<PeekPage>(*contents),
+        source_(source->GetWeakPtr()),
+        source_handle_(source->GetHandle()),
+        url_(url),
+        opened_(base::TimeTicks::Now()) {
+    if (BrowserWindowInterface* const window =
+            source->GetBrowserWindowInterface()) {
+      activated_ = window->RegisterDidBecomeActive(base::BindRepeating(
+          &PeekPage::SourceWindowBecameActive, base::Unretained(this)));
+    }
+  }
+
+  // P14: a click on the window the peek came from closes it, as a click
+  // outside a sheet does. Not from inside the activation: the window that
+  // closes may be the one taking the activation from.
+  void SourceWindowBecameActive(BrowserWindowInterface*) {
+    if (base::TimeTicks::Now() - opened_ < kOpeningGrace) {
+      return;
+    }
+    LastDismissal() =
+        Dismissal{source_handle_, url_, base::TimeTicks::Now()};
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<content::WebContents> contents) {
+              // Still a peek's page, in its little window: a promotion took
+              // the mark off the page before it moved.
+              if (!contents || !FromWebContents(contents.get())) {
+                return;
+              }
+              BrowserWindowInterface* const window = WindowOf(contents.get());
+              if (window && IsLittleWindow(window) && window->GetWindow()) {
+                window->GetWindow()->Close();
+              }
+            },
+            GetWebContents().GetWeakPtr()));
+  }
+
+  base::WeakPtr<tabs::TabInterface> source_;
+  const tabs::TabHandle source_handle_;
+  const GURL url_;
+  const base::TimeTicks opened_;
+  base::CallbackListSubscription activated_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(PeekPage);
+
+const PeekPage* PageOf(const BrowserWindowInterface* window) {
+  if (!window || !IsLittleWindow(window)) {
+    return nullptr;
+  }
+  // A little window is not const in its tab strip's eyes; nothing changes.
+  TabStripModel* const tabs =
+      const_cast<BrowserWindowInterface*>(window)->GetTabStripModel();
+  content::WebContents* const contents =
+      tabs ? tabs->GetActiveWebContents() : nullptr;
+  return contents ? PeekPage::FromWebContents(contents) : nullptr;
+}
+
+// P12: the peek's bounds over the window it came from, nearly all of it.
+gfx::Rect BoundsOver(BrowserWindowInterface* window) {
+  const gfx::Rect over = window->GetWindow()->GetBounds();
+  gfx::Rect bounds = over;
+  bounds.Inset(gfx::Insets::VH(kTopMargin, kSideMargin));
+  bounds.set_width(std::max(400, bounds.width()));
+  bounds.set_height(std::max(300, bounds.height()));
+  bounds.set_x(over.x() + (over.width() - bounds.width()) / 2);
+  bounds.set_y(over.y() + (over.height() - bounds.height()) / 2);
+  return bounds;
+}
+
+// The peek's window, `contents` its one tab, over the source's window; not
+// shown yet.
+BrowserWindowInterface* MakePeek(tabs::TabInterface* source,
+                                 std::unique_ptr<content::WebContents> contents,
+                                 const GURL& url) {
+  BrowserWindowInterface* const over = source->GetBrowserWindowInterface();
+  if (!over || !over->GetWindow()) {
+    return nullptr;
+  }
+  // P13: one peek over a window; the next link replaces it.
+  if (BrowserWindowInterface* const open = PeekOver(over);
+      open && open->GetWindow()) {
+    open->GetWindow()->Close();
+  }
+  BrowserWindowInterface* const window =
+      CreateLittleWindow(over->GetProfile(), BoundsOver(over));
+  if (!window) {
+    return nullptr;
+  }
+  PeekPage::CreateForWebContents(contents.get(), source, url);
+  chrome::AddWebContents(window, nullptr, std::move(contents), url,
+                         WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                         blink::mojom::WindowFeatures());
+  return window;
+}
+
+// P14: the peek shows with its page focused, not its address: shown on a
+// blank tab, the window gave the field the focus, and the field kept the
+// Escape that closes the peek.
+void ShowPeek(BrowserWindowInterface* window, content::WebContents* page) {
+  window->GetWindow()->Show();
+  page->Focus();
+}
+
+}  // namespace
+
+PeekLink::PeekLink() = default;
+PeekLink::PeekLink(const PeekLink&) = default;
+PeekLink& PeekLink::operator=(const PeekLink&) = default;
+PeekLink::~PeekLink() = default;
+
+BrowserWindowInterface* OpenPeek(tabs::TabInterface* source,
+                                 const PeekLink& link) {
+  if (!source || !source->GetContents() || TakeDismissal(source, link.url)) {
+    return nullptr;
+  }
+  // P11 (PLAN.md CMD-9): the page is made in the pinned tab's own jar, so a
+  // pin in a Space with its own session peeks with that session's cookies.
+  // The shared jar is the profile's own.
+  content::WebContents* const from = source->GetContents();
+  content::BrowserContext* const context = from->GetBrowserContext();
+  const content::StoragePartitionConfig jar =
+      spaces::StoragePartitionConfigForWebContents(from);
+  scoped_refptr<content::SiteInstance> site;
+  if (spaces::IsSpaceStoragePartition(jar) &&
+      spaces::PageBelongsInSpaceJar(link.url)) {
+    site = content::SiteInstance::CreateForFixedStoragePartition(
+        context, link.url, jar);
+  }
+  content::WebContents::CreateParams create(context, std::move(site));
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(create);
+  content::WebContents* const page = contents.get();
+  BrowserWindowInterface* const window =
+      MakePeek(source, std::move(contents), link.url);
+  if (!window) {
+    return nullptr;
+  }
+  // P11 (PLAN.md CMD-10): the link as the page asked for it -- its
+  // initiator, referrer and gesture -- not as if the user had typed it.
+  content::NavigationController::LoadURLParams load(link.url);
+  load.transition_type = ui::PAGE_TRANSITION_LINK;
+  load.is_renderer_initiated = true;
+  load.referrer = link.referrer;
+  load.initiator_origin = link.initiator_origin;
+  load.initiator_frame_token = link.initiator_frame_token;
+  load.initiator_process_id = link.initiator_process_id;
+  load.source_site_instance = link.source_site_instance;
+  load.has_user_gesture = link.user_gesture;
+  page->GetController().LoadURLWithParams(load);
+  ShowPeek(window, page);
+  return window;
+}
+
+BrowserWindowInterface* OpenPeekWithContents(
+    tabs::TabInterface* source,
+    std::unique_ptr<content::WebContents> contents,
+    const GURL& url) {
+  if (!source || !contents || TakeDismissal(source, url)) {
+    return nullptr;
+  }
+  content::WebContents* const page = contents.get();
+  BrowserWindowInterface* const window =
+      MakePeek(source, std::move(contents), url);
+  if (window) {
+    ShowPeek(window, page);
+  }
+  return window;
+}
+
+bool IsPeekWindow(const BrowserWindowInterface* window) {
+  return PageOf(window) != nullptr;
+}
+
+tabs::TabInterface* PeekSourceOf(const BrowserWindowInterface* window) {
+  const PeekPage* const page = PageOf(window);
+  return page ? page->source() : nullptr;
+}
+
+bool PeekCanSplit(const BrowserWindowInterface* window) {
+  const tabs::TabInterface* const source = PeekSourceOf(window);
+  return source && !source->IsPinned() && !source->IsSplit();
+}
+
+BrowserWindowInterface* PeekOver(const BrowserWindowInterface* window) {
+  if (!window) {
+    return nullptr;
+  }
+  BrowserWindowInterface* found = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* candidate) {
+        const PeekPage* const page = PageOf(candidate);
+        if (page && page->source_window() == window) {
+          found = candidate;
+          return false;
+        }
+        return true;
+      });
+  return found;
+}
+
+void ForgetPeek(content::WebContents* contents) {
+  if (contents) {
+    contents->RemoveUserData(PeekPage::UserDataKey());
+  }
+}
+
+std::u16string PeekOpenAsTabLabel() {
+  return l10n_util::GetStringUTF16(IDS_STEDDING_PEEK_OPEN_AS_TAB);
+}
+
+std::u16string PeekOpenInSplitLabel() {
+  return l10n_util::GetStringUTF16(IDS_STEDDING_LITTLE_OPEN_IN_SPLIT);
+}
+
+}  // namespace stedding
