From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Mon, 31 Aug 2026 22:04:13 -0400
Subject: let a window start with more than one Space, for screenshots and
 tests

Verifying the Space switcher means having more than one Space, and making one
is a UI gesture. An extra_spaces parameter on kArcStyleWindow creates them at
startup instead:

  tooling/capture-ui --features 'SteddingArcStyleWindow:extra_spaces/2'

Zero in normal use. This is the same trade as the metrics parameters in patch
0007: a value that only exists so the result can be looked at.

Not to be confused with seeding pinned tabs, which was tried and abandoned --
that meant defeating Chromium's tracked-preference protection, which is a real
security feature. This adds a parameter to our own code and defeats nothing.

Why: the switcher could otherwise only be checked by hand, which means it would
stop being checked.
Removable when: there are interactive tests driving the switcher, or Spaces can
be created from the command line for real.
---
 chrome/browser/ui/spaces/BUILD.gn        | 1 +
 chrome/browser/ui/spaces/space_model.cc  | 7 +++++++
 chrome/browser/ui/stedding_ui_metrics.cc | 3 +++
 chrome/browser/ui/stedding_ui_metrics.h  | 6 ++++++
 4 files changed, 17 insertions(+)

diff --git a/chrome/browser/ui/spaces/BUILD.gn b/chrome/browser/ui/spaces/BUILD.gn
index 4eee562994df5..1343d497b2fe8 100644
--- a/chrome/browser/ui/spaces/BUILD.gn
+++ b/chrome/browser/ui/spaces/BUILD.gn
@@ -21,6 +21,7 @@ source_set("spaces") {
   ]
 
   deps = [
+    "//chrome/browser/ui:stedding_ui_metrics",
     "//chrome/browser/ui/browser_window",
     "//chrome/browser/ui/tabs:tab_strip",
   ]
diff --git a/chrome/browser/ui/spaces/space_model.cc b/chrome/browser/ui/spaces/space_model.cc
index ee6c3f5fd63d6..ec722b9e61bfa 100644
--- a/chrome/browser/ui/spaces/space_model.cc
+++ b/chrome/browser/ui/spaces/space_model.cc
@@ -10,6 +10,7 @@
 #include "base/check.h"
 #include "base/functional/bind.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding_ui_metrics.h"
 #include "chrome/browser/ui/tabs/tab_strip_model.h"
 
 namespace spaces {
@@ -46,6 +47,12 @@ SpaceModel::SpaceModel(BrowserWindowInterface& browser) : SpaceModel() {
   // next both consult this, so no keystroke lands on a tab from another Space.
   // Unretained is safe: the model is owned by the window's features and so
   // outlives its own tab strip.
+  // A window can be asked to start with more than one Space so that multi-Space
+  // states can be screenshotted and tested. Zero in normal use.
+  for (int i = 0; i < stedding::kExtraSpacesForTesting.Get(); ++i) {
+    AddSpace(std::string(), kDefaultSpaceColor);
+  }
+
   browser.GetTabStripModel()->SetHiddenTabPredicate(base::BindRepeating(
       [](SpaceModel* model, const tabs::TabInterface* tab) {
         return !model->IsTabInActiveSpace(tab);
diff --git a/chrome/browser/ui/stedding_ui_metrics.cc b/chrome/browser/ui/stedding_ui_metrics.cc
index e3ba46933dc02..6970fa8c2a563 100644
--- a/chrome/browser/ui/stedding_ui_metrics.cc
+++ b/chrome/browser/ui/stedding_ui_metrics.cc
@@ -18,4 +18,7 @@ BASE_FEATURE_PARAM(int, kVerticalTabHeight, &kArcStyleWindow,
 BASE_FEATURE_PARAM(int, kVerticalTabCornerRadius, &kArcStyleWindow,
                    "vertical_tab_corner_radius", 10);
 
+BASE_FEATURE_PARAM(int, kExtraSpacesForTesting, &kArcStyleWindow,
+                   "extra_spaces", 0);
+
 }  // namespace stedding
diff --git a/chrome/browser/ui/stedding_ui_metrics.h b/chrome/browser/ui/stedding_ui_metrics.h
index 4c376aac6a5a1..93b7d7393e2b0 100644
--- a/chrome/browser/ui/stedding_ui_metrics.h
+++ b/chrome/browser/ui/stedding_ui_metrics.h
@@ -33,6 +33,12 @@ BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabHeight);
 // Radius of the active tab's pill in the vertical tab strip, in DIPs.
 BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabCornerRadius);
 
+// Extra Spaces to create in each new window, on top of the one every window
+// starts with. Zero in normal use. This exists so multi-Space states can be
+// screenshotted and tested without a UI gesture, the same reason the metrics
+// above are parameters.
+BASE_DECLARE_FEATURE_PARAM(int, kExtraSpacesForTesting);
+
 }  // namespace stedding
 
 #endif  // CHROME_BROWSER_UI_STEDDING_UI_METRICS_H_
