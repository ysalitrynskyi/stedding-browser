index 0000000000000..1ab97aea5c073
--- /dev/null
+++ b/chrome/browser/ui/stedding/copy_link_unittest.cc
@@ -0,0 +1,97 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/copy_link.h"
+
+#include <string>
+
+#include "base/test/test_future.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/test/base/chrome_render_view_host_test_harness.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "content/public/test/web_contents_tester.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/clipboard/clipboard.h"
+#include "ui/base/clipboard/clipboard_buffer.h"
+#include "ui/base/clipboard/test/test_clipboard.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class CopyLinkTest : public ChromeRenderViewHostTestHarness {
+ protected:
+  void SetUp() override {
+    ChromeRenderViewHostTestHarness::SetUp();
+    ui::TestClipboard::CreateForCurrentThread();
+    prefs::RegisterProfilePrefs(prefs_.registry());
+  }
+  void TearDown() override {
+    ui::Clipboard::DestroyClipboardForCurrentThread();
+    ChromeRenderViewHostTestHarness::TearDown();
+  }
+
+  void Load(const std::string& url, const std::u16string& title) {
+    content::WebContentsTester::For(web_contents())
+        ->NavigateAndCommit(GURL(url));
+    content::WebContentsTester::For(web_contents())->SetTitle(title);
+  }
+
+  std::u16string ClipboardText() {
+    base::test::TestFuture<std::u16string> future;
+    ui::Clipboard::GetForCurrentThread()->ReadText(
+        ui::ClipboardBuffer::kCopyPaste, std::nullopt, future.GetCallback());
+    return future.Get();
+  }
+
+  std::u16string ClipboardHtml() {
+    base::test::TestFuture<std::u16string, GURL, uint32_t, uint32_t> future;
+    ui::Clipboard::GetForCurrentThread()->ReadHTML(
+        ui::ClipboardBuffer::kCopyPaste, std::nullopt, future.GetCallback());
+    return future.Get<0>();
+  }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+};
+
+// copy-link L1, L2, L3: the plain copy is the clean URL; the Markdown copy
+// carries "[title](url)" as text and a live anchor as HTML.
+TEST_F(CopyLinkTest, PlainMarkdownAndHtmlFlavours) {
+  Load("https://a.test/page?q=1&utm_source=mail", u"A [Page]");
+
+  CopyLinkResult plain =
+      WriteLinkToClipboard(&prefs_, web_contents(), LinkFormat::kPlain);
+  EXPECT_EQ(GURL("https://a.test/page?q=1"), plain.url);
+  EXPECT_TRUE(plain.stripped);
+  EXPECT_EQ(u"https://a.test/page?q=1", ClipboardText());
+
+  CopyLinkResult markdown =
+      WriteLinkToClipboard(&prefs_, web_contents(), LinkFormat::kMarkdown);
+  EXPECT_TRUE(markdown.stripped);
+  EXPECT_EQ(u"[A [Page\\]](https://a.test/page?q=1)", ClipboardText());
+  const std::u16string html = ClipboardHtml();
+  EXPECT_NE(std::u16string::npos, html.find(u"<a href=\"https://a.test/page?q=1\">"))
+      << html;
+  EXPECT_NE(std::u16string::npos, html.find(u"A [Page]</a>")) << html;
+}
+
+// copy-link L3: a page without a title is linked by its host.
+TEST_F(CopyLinkTest, UntitledPageUsesTheHost) {
+  Load("https://b.test/x", u"");
+  WriteLinkToClipboard(&prefs_, web_contents(), LinkFormat::kMarkdown);
+  EXPECT_EQ(u"[b.test](https://b.test/x)", ClipboardText());
+}
+
+// copy-link L6: setting off copies the URL verbatim, tracking and all.
+TEST_F(CopyLinkTest, SettingOffCopiesVerbatim) {
+  Load("https://a.test/page?fbclid=abc", u"A");
+  prefs_.SetBoolean(prefs::kCopyStripTracking, false);
+  CopyLinkResult result =
+      WriteLinkToClipboard(&prefs_, web_contents(), LinkFormat::kPlain);
+  EXPECT_FALSE(result.stripped);
+  EXPECT_EQ(u"https://a.test/page?fbclid=abc", ClipboardText());
+}
+
+}  // namespace
+}  // namespace stedding
