+// windows G15 (BACKLOG S-499): the open copy another window keeps takes a
+// token sync takes, so pinned again it is a pin this computer's sync file
+// carries, and another computer reads that file.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest,
+                       AnOpenCopyLetGoAndPinnedAgainStillSyncs) {
+  tabs::TabInterface* const pin = PinPage(browser(), Page("/title2.html"));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(second).size() == 1u; }));
+  tabs::TabInterface* const open_there = Pins(second).front();
+  TabStripModel* const strip = second->GetTabStripModel();
+  strip->ActivateTabAt(strip->GetIndexOfTab(open_there));
+  ASSERT_TRUE(content::WaitForLoadStop(open_there->GetContents()));
+
+  // Sync on, in a folder of its own.
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+  spaces::SidebarSyncService* const sync =
+      spaces::SidebarSyncServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(sync);
+  base::test::TestFuture<base::DictValue> preview;
+  sync->PreviewJoin(shared_.GetPath(), preview.GetCallback());
+  ASSERT_FALSE(preview.Get().FindString("refusal"));
+  ASSERT_TRUE(sync->ConfirmJoin(/*combine=*/false, "Test computer", {}));
+  ASSERT_TRUE(base::test::RunUntil([&] { return sync->enabled(); }));
+
+  Model(browser()).SetSpacePinned(pin, false);
+  ASSERT_TRUE(base::test::RunUntil([&] { return Pins(second).empty(); }));
+  ASSERT_NE(TabStripModel::kNoTab, strip->GetIndexOfTab(open_there))
+      << "the open copy was closed";
+  const std::string token = Token(open_there);
+  EXPECT_EQ(token, spaces::TokenOf(spaces::TabSyncId(token)))
+      << "the page let go has a token sync refuses";
+
+  Model(second).SetSpacePinned(open_there, true);
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(browser()).size() == 1u; }));
+  EXPECT_TRUE(Store().Find(token));
+  sync->CommitForTesting();
+  const base::FilePath own =
+      shared_.GetPath()
+          .AppendASCII(spaces::sidebar_sync::kSyncFolderName)
+          .AppendASCII(spaces::sidebar_sync::FileNameFor(
+              browser()->GetProfile()->GetPrefs()->GetString(
+                  stedding::prefs::kSidebarSyncInstallId)));
+  std::string json;
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    base::ScopedAllowBlockingForTesting allow;
+    return base::ReadFileToString(own, &json) &&
+           json.find(token) != std::string::npos;
+  })) << "this computer's file never carried the pin";
+  const spaces::sidebar_sync::ParsedFile parsed =
+      spaces::sidebar_sync::ParseSyncFile(json);
+  EXPECT_EQ(spaces::sidebar_sync::ParseStatus::kOk, parsed.status)
+      << "another computer refuses this computer's file";
+  EXPECT_TRUE(parsed.state.records.contains(spaces::TabSyncId(token)));
+}
