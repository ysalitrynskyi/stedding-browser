index 0000000000000..79a27d724e7dc
--- /dev/null
+++ b/chrome/browser/ui/spaces/audit_w2_b13_unittest.cc
@@ -0,0 +1,171 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/sidebar-file.md Sf15, Sf16: the folder sync's merge, without
+// a browser. Three computers that each merged a newer Space list into a
+// different older one settle on one order; and a folder cycle cut at a
+// folder one computer removed leaves that folder removed.
+
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_state.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces::sidebar_sync {
+namespace {
+
+constexpr char kWorkW2B13[] = "0123456789ABCDEF0123456789ABCDEF";
+constexpr char kPinAW2B13[] = "tab:11111111-1111-4111-8111-111111111111";
+constexpr char kReadingW2B13[] = "folder:AAAAAAAAAAAAAAAABBBBBBBBBBBBBBBB";
+constexpr char kLaterW2B13[] = "folder:CCCCCCCCCCCCCCCCDDDDDDDDDDDDDDDD";
+
+constexpr char kOfficeW2B13[] = "aaaaaaaaaaaaaaaa";
+constexpr char kLaptopW2B13[] = "bbbbbbbbbbbbbbbb";
+constexpr char kTabletW2B13[] = "cccccccccccccccc";
+
+FileMeta MetaW2B13(const char* install) {
+  FileMeta meta;
+  meta.install = install;
+  meta.device = "Office PC";
+  meta.seq = 3;
+  meta.nonce = "0011223344556677";
+  meta.written_ms = 1000;
+  meta.hlc = 200;
+  meta.joined_ms = 10;
+  return meta;
+}
+
+// One computer's Space list, as its last edit left it.
+State SpacesW2B13(const std::vector<std::string>& order,
+                  int64_t t,
+                  const char* install) {
+  State state;
+  state.lists[kSpacesList].order = order;
+  state.lists[kSpacesList].s = Stamp{t, install};
+  return state;
+}
+
+// P17-1e; Sf15, Sf16: Spaces a, b, c. The office adds x first (t=5); the
+// tablet takes that and moves x second (t=7); the laptop, which never saw x,
+// reorders (t=10). The office and the tablet each take the laptop's newer
+// list, placing x by where it sat in their own older one; both then carry
+// the laptop's stamp with different orders. Each kept its own on that tie,
+// and the Spaces stayed in a different order on each computer until someone
+// reordered them again.
+TEST(SidebarSyncOrderW2B13Test, ThreeComputersSettleOnOneSpaceOrder) {
+  State office = SpacesW2B13({"x", "a", "b", "c"}, 5, kOfficeW2B13);
+  State tablet = SpacesW2B13({"a", "x", "b", "c"}, 7, kTabletW2B13);
+  const State laptop = SpacesW2B13({"a", "c", "b"}, 10, kLaptopW2B13);
+
+  ASSERT_TRUE(MergeState(office, laptop));
+  ASSERT_TRUE(MergeState(tablet, laptop));
+  ASSERT_EQ(office.lists[kSpacesList].s, tablet.lists[kSpacesList].s);
+
+  // Each reads the other's file, in either order.
+  State office_after = office;
+  MergeState(office_after, tablet);
+  State tablet_after = tablet;
+  MergeState(tablet_after, office);
+  EXPECT_EQ(office_after.lists[kSpacesList].order,
+            tablet_after.lists[kSpacesList].order)
+      << "two computers kept two orders under one stamp";
+  EXPECT_EQ(office_after.lists[kSpacesList].s,
+            tablet_after.lists[kSpacesList].s);
+  EXPECT_EQ(4u, office_after.lists[kSpacesList].order.size());
+
+  // Settled: another exchange changes nothing on either.
+  State office_again = office_after;
+  EXPECT_FALSE(MergeState(office_again, tablet_after));
+  State tablet_again = tablet_after;
+  EXPECT_FALSE(MergeState(tablet_again, office_after));
+}
+
+// P17-1d; Sf15: the office drags Reading into Later (t=200); the laptop, not
+// yet synced, drags Later into Reading (t=300); the office then removes
+// Reading (t=350). Merged, the two moves make a cycle, and Reading, placed
+// first, gives way. It stays removed, alike on both computers: the cut was
+// stamped after the removal, and brought Reading back on every computer,
+// counted as an addition on the office.
+TEST(SidebarSyncCycleW2B13Test, ACycleCutAtARemovedFolderLeavesItRemoved) {
+  const auto folder = [](const std::string& title) {
+    LocalItem item;
+    item.kind = Kind::kFolder;
+    item.fields[kFieldTitle] = title;
+    item.fields[kFieldParent] = PinsListOf(kWorkW2B13);
+    return item;
+  };
+  LocalView base;
+  base.items[kWorkW2B13].kind = Kind::kSpace;
+  base.items[kWorkW2B13].fields[kFieldName] = "Work";
+  base.items[kWorkW2B13].fields[kFieldColor] = "#3366FF";
+  base.items[kWorkW2B13].fields[kFieldIsolated] = "0";
+  base.items[kPinAW2B13].kind = Kind::kTab;
+  base.items[kPinAW2B13].fields[kFieldHome] = "https://a.example/";
+  base.items[kPinAW2B13].fields[kFieldName] = "";
+  base.items[kPinAW2B13].fields[kFieldParent] = PinsListOf(kWorkW2B13);
+  base.items[kReadingW2B13] = folder("Reading");
+  base.items[kLaterW2B13] = folder("Later");
+  base.lists[kSpacesList] = {kWorkW2B13};
+  base.lists[PinsListOf(kWorkW2B13)] = {kPinAW2B13, kReadingW2B13,
+                                        kLaterW2B13};
+  State start;
+  ASSERT_TRUE(
+      RecordLocalEdits(start, nullptr, base, {}, Stamp{100, kOfficeW2B13}));
+
+  // The office: Reading into Later, then Reading removed.
+  LocalView into_later = base;
+  into_later.items[kReadingW2B13].fields[kFieldParent] = kLaterW2B13;
+  into_later.lists[PinsListOf(kWorkW2B13)] = {kPinAW2B13, kLaterW2B13};
+  into_later.lists[kLaterW2B13] = {kReadingW2B13};
+  State office = start;
+  ASSERT_TRUE(RecordLocalEdits(office, &base, into_later, {},
+                               Stamp{200, kOfficeW2B13}));
+  LocalView removed = into_later;
+  removed.items.erase(kReadingW2B13);
+  removed.lists[kLaterW2B13] = {};
+  ASSERT_TRUE(RecordLocalEdits(office, &into_later, removed, {kReadingW2B13},
+                               Stamp{350, kOfficeW2B13}));
+  ASSERT_FALSE(office.records.at(kReadingW2B13).Alive());
+
+  // The laptop: Later into Reading.
+  LocalView into_reading = base;
+  into_reading.items[kLaterW2B13].fields[kFieldParent] = kReadingW2B13;
+  into_reading.lists[PinsListOf(kWorkW2B13)] = {kPinAW2B13, kReadingW2B13};
+  into_reading.lists[kReadingW2B13] = {kLaterW2B13};
+  State laptop = start;
+  ASSERT_TRUE(RecordLocalEdits(laptop, &base, into_reading, {},
+                               Stamp{300, kLaptopW2B13}));
+  ASSERT_EQ(ParseStatus::kOk,
+            ParseSyncFile(SerializeSyncFile(office, MetaW2B13(kOfficeW2B13)))
+                .status);
+  ASSERT_EQ(ParseStatus::kOk,
+            ParseSyncFile(SerializeSyncFile(laptop, MetaW2B13(kLaptopW2B13)))
+                .status);
+
+  State on_office = office;
+  MergeState(on_office, laptop);
+  EXPECT_TRUE(BreakFolderCycles(on_office, Stamp{400, kOfficeW2B13}));
+  State on_laptop = laptop;
+  MergeState(on_laptop, office);
+  EXPECT_TRUE(BreakFolderCycles(on_laptop, Stamp{410, kLaptopW2B13}));
+  for (const State* state : {&on_office, &on_laptop}) {
+    EXPECT_FALSE(state->records.at(kReadingW2B13).Alive())
+        << "cutting the cycle brought the removed folder back";
+    EXPECT_EQ(ParseStatus::kOk,
+              ParseSyncFile(SerializeSyncFile(*state, MetaW2B13(kOfficeW2B13)))
+                  .status)
+        << "the merged sidebar is a file no computer reads";
+    EXPECT_EQ(kReadingW2B13, state->records.at(kLaterW2B13).Get(kFieldParent))
+        << "the later move, Later into Reading, stands";
+  }
+  EXPECT_TRUE(Diff(office, on_office).added.empty())
+      << "the removed folder came back to the office as an addition";
+  EXPECT_EQ(on_office.records, on_laptop.records)
+      << "the cycle was cut differently on the two computers";
+}
+
+}  // namespace
+}  // namespace spaces::sidebar_sync
diff --git a/chrome/browser/ui/spaces/audit_w2_b16_unittest.cc b/chrome/browser/ui/spaces/audit_w2_b16_unittest.cc
new file mode 100644
index 0000000000000..f214f7f88d354
--- /dev/null
+++ b/chrome/browser/ui/spaces/audit_w2_b16_unittest.cc
@@ -0,0 +1,340 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Spaces against a real Browser and TabStripModel, as in
+// space_model_window_unittest.cc: what Clear shows while it closes the
+// Space's loose tabs (docs/features/spaces.md B20, tabs.md R37), Clear
+// Session Data reaching every window when the one it was asked in closes
+// first (sessions.md S13), and what the question before deleting a Space
+// counts (spaces.md B5, tabs.md R66).
+
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/run_loop.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_commands.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/stedding/empty_space.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/test/web_contents_tester.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+constexpr SkColor kBlueW2B16 = SkColorSetRGB(0x00, 0x00, 0xFF);
+
+// A row with a page at the end of `strip`, made the active tab when
+// `foreground`; one opened in the background is never used.
+tabs::TabInterface* AppendRowW2B16(TabStripModel& strip,
+                                   content::BrowserContext* context,
+                                   bool foreground = false) {
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContentsTester::CreateTestWebContents(context, nullptr);
+  content::WebContentsTester::For(contents.get())
+      ->NavigateAndCommit(GURL("https://example.com/"));
+  strip.AppendTab(std::make_unique<tabs::TabModel>(std::move(contents), &strip),
+                  foreground);
+  return strip.GetTabAtIndex(strip.count() - 1);
+}
+
+// The user selects `tab`'s row.
+void UseW2B16(TabStripModel& strip, tabs::TabInterface* tab) {
+  strip.ActivateTabAt(strip.GetIndexOfTab(tab),
+                      TabStripUserGestureDetails(
+                          TabStripUserGestureDetails::GestureType::kOther));
+}
+
+// Every tab the strip had on screen at any of its notifications, kept by
+// handle, so a tab closed since can still be asked about.
+class ShownTabsW2B16 : public TabStripModelObserver {
+ public:
+  explicit ShownTabsW2B16(TabStripModel& strip) { strip.AddObserver(this); }
+
+  void OnTabStripModelChanged(
+      TabStripModel* strip,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    if (tabs::TabInterface* const active = strip->GetActiveTab()) {
+      shown_.insert(active->GetHandle());
+    }
+  }
+
+  bool Showed(const tabs::TabHandle& handle) const {
+    return shown_.contains(handle);
+  }
+
+ private:
+  std::set<tabs::TabHandle> shown_;
+};
+
+// Counts the navigations `contents` begins in its main frame. A reload is
+// one, and so is the load of a tab that had not loaded.
+class NavigationStartsW2B16 : public content::WebContentsObserver {
+ public:
+  explicit NavigationStartsW2B16(content::WebContents* contents)
+      : content::WebContentsObserver(contents) {}
+
+  int count() const { return count_; }
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame()) {
+      ++count_;
+    }
+  }
+
+ private:
+  int count_ = 0;
+};
+
+// The Spaces whose cleared session the registry told every window of.
+class HeardWipesW2B16 : public SpaceRegistry::Observer {
+ public:
+  // SpaceRegistry::Observer:
+  void OnSpaceJarWiped(const SpaceId& id) override { ids.push_back(id); }
+
+  std::vector<SpaceId> ids;
+};
+
+class SpaceWindowW2B16Test : public BrowserWithTestWindowTest {
+ protected:
+  SpaceModel& model() {
+    SpaceModel* const model = SpaceModel::From(browser());
+    CHECK(model) << "a normal window must own a SpaceModel";
+    return *model;
+  }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  SpaceRegistry& registry() {
+    return *SpaceRegistryFactory::GetForProfile(profile());
+  }
+  int IndexOf(tabs::TabInterface* tab) { return tabs().GetIndexOfTab(tab); }
+
+  content::StoragePartitionConfig ConfigFor(const std::string& jar) {
+    return *StoragePartitionConfigForProfileId(profile(), jar);
+  }
+
+  // A tab in the Space on screen whose page loaded in `jar`, as a page of a
+  // Space with that session does.
+  tabs::TabInterface* OpenInJar(const std::string& jar, const GURL& url) {
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContentsTester::CreateTestWebContents(
+            profile(), content::SiteInstance::CreateForFixedStoragePartition(
+                           profile(), url, ConfigFor(jar)));
+    content::WebContentsTester::For(contents.get())->NavigateAndCommit(url);
+    tabs().AppendTab(
+        std::make_unique<tabs::TabModel>(std::move(contents), &tabs()),
+        /*foreground=*/true);
+    return tabs().GetActiveTab();
+  }
+};
+
+using ClearSpaceW2B16Test = SpaceWindowW2B16Test;
+using SessionWipeW2B16Test = SpaceWindowW2B16Test;
+using DeleteSpaceW2B16Test = SpaceWindowW2B16Test;
+
+// P18-1e, spaces B20, tabs R37 (GitHub issue 72): Clear on a tab with loose
+// tabs asleep below it closes them without showing them: the tab on screen
+// goes last, and its close shows the Space's pin that is awake. Each close
+// of the tab on screen showed the next tab Clear takes, which woke, its page
+// loading, only for the next close to take it.
+TEST_F(ClearSpaceW2B16Test, ClearShowsNoTabItClosesAndWakesNone) {
+  tabs::TabInterface* const on_screen =
+      AppendRowW2B16(tabs(), profile(), /*foreground=*/true);
+  tabs::TabInterface* const pin = AppendRowW2B16(tabs(), profile());
+  model().SetSpacePinned(pin, true);
+  // Two loose tabs below the one on screen: one put to sleep, one brought
+  // back by a restore and not opened since.
+  tabs::TabInterface* const slept = AppendRowW2B16(tabs(), profile());
+  tabs::TabInterface* const unopened = AppendRowW2B16(tabs(), profile());
+  task_environment()->RunUntilIdle();
+  slept->GetContents()->SetWasDiscarded(true);
+  unopened->GetContents()->GetController().SetNeedsReload();
+  UseW2B16(tabs(), on_screen);
+  ASSERT_EQ(on_screen, tabs().GetActiveTab());
+  ASSERT_TRUE(model().IsSpacePinned(pin));
+  ASSERT_FALSE(pin->GetContents()->WasDiscarded());
+  ASSERT_LT(IndexOf(on_screen), IndexOf(slept));
+  ASSERT_LT(IndexOf(on_screen), IndexOf(unopened));
+  ASSERT_EQ(4, tabs().count());
+  const tabs::TabHandle slept_handle = slept->GetHandle();
+  const tabs::TabHandle unopened_handle = unopened->GetHandle();
+  NavigationStartsW2B16 slept_loads(slept->GetContents());
+  NavigationStartsW2B16 unopened_loads(unopened->GetContents());
+
+  ShownTabsW2B16 shown(tabs());
+  ClearActiveSpace(browser());  // ⇧⌘K
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(1, tabs().count()) << "Clear left a loose tab";
+  EXPECT_EQ(pin, tabs().GetActiveTab()) << "not the pin that is awake";
+  EXPECT_FALSE(shown.Showed(slept_handle))
+      << "a tab asleep came on screen on its way out";
+  EXPECT_FALSE(shown.Showed(unopened_handle))
+      << "a tab not opened since the restore did";
+  EXPECT_EQ(0, slept_loads.count()) << "the tab asleep loaded its page";
+  EXPECT_EQ(0, unopened_loads.count()) << "the tab not opened loaded its page";
+}
+
+// P18-1e, spaces B20, tabs R37, R66: with nothing awake left to show -- an
+// essential asleep and no pin -- Clear shows the Space's page, and neither a
+// tab it closes nor the essential comes on screen on the way.
+TEST_F(ClearSpaceW2B16Test, ClearWithNothingAwakeLeftShowsOnlyTheSpacesPage) {
+  tabs::TabInterface* const on_screen =
+      AppendRowW2B16(tabs(), profile(), /*foreground=*/true);
+  tabs::TabInterface* const essential = AppendRowW2B16(tabs(), profile());
+  tabs().SetTabPinned(IndexOf(essential), true);
+  tabs::TabInterface* const slept = AppendRowW2B16(tabs(), profile());
+  tabs::TabInterface* const unopened = AppendRowW2B16(tabs(), profile());
+  task_environment()->RunUntilIdle();
+  essential->GetContents()->SetWasDiscarded(true);
+  slept->GetContents()->SetWasDiscarded(true);
+  unopened->GetContents()->GetController().SetNeedsReload();
+  UseW2B16(tabs(), on_screen);
+  ASSERT_EQ(on_screen, tabs().GetActiveTab());
+  ASSERT_TRUE(essential->IsPinned());
+  ASSERT_LT(IndexOf(on_screen), IndexOf(slept));
+  ASSERT_LT(IndexOf(on_screen), IndexOf(unopened));
+  ASSERT_EQ(4, tabs().count());
+  const tabs::TabHandle slept_handle = slept->GetHandle();
+  const tabs::TabHandle unopened_handle = unopened->GetHandle();
+  NavigationStartsW2B16 slept_loads(slept->GetContents());
+  NavigationStartsW2B16 unopened_loads(unopened->GetContents());
+
+  ShownTabsW2B16 shown(tabs());
+  ClearActiveSpace(browser());  // ⇧⌘K
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(2, tabs().count()) << "not the essential and the Space's page";
+  EXPECT_TRUE(stedding::IsEmptySpaceStandIn(tabs().GetActiveTab()))
+      << "the Space did not show its page";
+  EXPECT_FALSE(shown.Showed(slept_handle))
+      << "a tab asleep came on screen on its way out";
+  EXPECT_FALSE(shown.Showed(unopened_handle))
+      << "a tab not opened since the restore did";
+  EXPECT_FALSE(shown.Showed(essential->GetHandle()))
+      << "the essential asleep came on screen";
+  EXPECT_TRUE(essential->GetContents()->WasDiscarded());
+  EXPECT_EQ(0, slept_loads.count()) << "the tab asleep loaded its page";
+  EXPECT_EQ(0, unopened_loads.count()) << "the tab not opened loaded its page";
+}
+
+// P18-1b, sessions S13: Clear Session Data reloads the Space's tabs in every
+// window, also when the window it was asked in closes before the clear has
+// finished: the other windows still hear of it. Only the window that asked
+// told them, so with it gone their tabs stayed on screen signed in.
+TEST_F(SessionWipeW2B16Test,
+       ClearSessionDataReachesEveryWindowAfterItsOwnCloses) {
+  const SpaceId work = model().AddSpace("Work", kBlueW2B16)->id();
+  model().SetSpaceIsolated(work, true);
+  ASSERT_TRUE(model().SetActiveSpace(work));
+  task_environment()->RunUntilIdle();
+  const std::string jar = model().registry()->Find(work)->profile_id;
+  ASSERT_FALSE(jar.empty());
+  tabs::TabInterface* const signed_in =
+      OpenInJar(jar, GURL("https://example.com/"));
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(work, model().SpaceForTab(signed_in));
+  ASSERT_EQ(ConfigFor(jar),
+            StoragePartitionConfigForWebContents(signed_in->GetContents()));
+
+  // The clear is asked for in a second window of the profile.
+  std::unique_ptr<BrowserWindowInterface> second =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  SpaceModel* const asking = SpaceModel::From(second.get());
+  ASSERT_TRUE(asking);
+  ASSERT_TRUE(asking->follows_registry());
+  AddTab(second.get(), GURL("https://example.org/"));
+  task_environment()->RunUntilIdle();
+
+  HeardWipesW2B16 heard;
+  base::ScopedObservation<SpaceRegistry, SpaceRegistry::Observer> watching(
+      &heard);
+  watching.Observe(&registry());
+  NavigationStartsW2B16 reloads(signed_in->GetContents());
+  base::RunLoop wiped;
+  ASSERT_TRUE(asking->WipeIsolatedSession(work, wiped.QuitClosure()));
+  ASSERT_TRUE(heard.ids.empty())
+      << "the clear finished before its window could close";
+
+  // That window closes while the clear runs.
+  second->GetTabStripModel()->CloseAllTabs();
+  second.reset();
+  wiped.Run();
+  task_environment()->RunUntilIdle();
+
+  EXPECT_THAT(heard.ids, testing::ElementsAre(work))
+      << "no window heard that the Space's session was cleared";
+  EXPECT_EQ(1, reloads.count())
+      << "the other window's tab of the Space did not reload";
+}
+
+// P18-1g, spaces B5, tabs R66: the question before deleting a Space says how
+// many tabs it holds, and the Space's page -- what an empty Space shows,
+// which the sidebar does not list -- is not one of them: "It has no open
+// tabs.", in this window and with the Space on its page in two. The page was
+// counted, so the question said its tab stays open and moves, or that two
+// tabs did.
+TEST_F(DeleteSpaceW2B16Test, TheDeleteQuestionDoesNotCountTheSpacesPage) {
+  const SpaceId home = model().active_id();
+  AddTab(browser(), GURL("https://example.com/"));
+  const SpaceId work = model().AddSpace("Work", kBlueW2B16)->id();
+  ASSERT_TRUE(model().SetActiveSpace(work));
+  task_environment()->RunUntilIdle();
+  tabs::TabInterface* const page = tabs().GetActiveTab();
+  ASSERT_TRUE(stedding::IsEmptySpaceStandIn(page));
+  ASSERT_EQ(work, model().FindSpaceForTab(page));
+  EXPECT_EQ(0, model().CountTabsOf(work, /*every_window=*/false))
+      << "the Space's page counted as a tab";
+  EXPECT_EQ(0, model().CountTabsOf(work, /*every_window=*/true));
+
+  // A second window on the same empty Space shows its page too.
+  std::unique_ptr<BrowserWindowInterface> second =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  SpaceModel* const other = SpaceModel::From(second.get());
+  ASSERT_TRUE(other);
+  ASSERT_TRUE(other->SetActiveSpace(home));
+  AddTab(second.get(), GURL("https://example.org/"));
+  ASSERT_TRUE(other->SetActiveSpace(work));
+  task_environment()->RunUntilIdle();
+  tabs::TabInterface* const other_page =
+      second->GetTabStripModel()->GetActiveTab();
+  ASSERT_TRUE(stedding::IsEmptySpaceStandIn(other_page));
+  ASSERT_EQ(work, other->FindSpaceForTab(other_page));
+
+  EXPECT_EQ(0, model().CountTabsOf(work, /*every_window=*/true))
+      << "the page each window shows counted as the Space's tabs";
+  EXPECT_EQ(0, other->CountTabsOf(work, /*every_window=*/false));
+  second->GetTabStripModel()->CloseAllTabs();
+}
+
+}  // namespace
+}  // namespace spaces
diff --git a/chrome/browser/ui/spaces/audit_w2_b17_unittest.cc b/chrome/browser/ui/spaces/audit_w2_b17_unittest.cc
new file mode 100644
index 0000000000000..d85844e87913a
--- /dev/null
+++ b/chrome/browser/ui/spaces/audit_w2_b17_unittest.cc
@@ -0,0 +1,218 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// sessions S32: a session's colour slot is kept as other sessions are made,
+// as Spaces join it and move, and across a restart -- for a Space's own
+// session, which has no row in the sessions list, as for a named one.
+
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/hash/hash.h"
+#include "base/token.h"
+#include "base/values.h"
+#include "chrome/browser/ui/spaces/isolation_mark.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace spaces {
+namespace {
+
+// The slot session `id` lands on when no other session is in the way.
+int HashSlotW2B17(std::string_view id) {
+  return static_cast<int>(base::PersistentHash(id) % kSessionSlots);
+}
+
+// A new session token whose id hashes to `slot`; one in six does.
+std::string TokenHashingToW2B17(int slot) {
+  for (int tries = 0; tries < 10000; ++tries) {
+    std::string token = base::Token::CreateRandom().ToString();
+    if (HashSlotW2B17(token) == slot) {
+      return token;
+    }
+  }
+  ADD_FAILURE() << "no token hashes to slot " << slot;
+  return std::string();
+}
+
+void RegisterPrefsW2B17(TestingPrefServiceSimple& prefs) {
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceSessions);
+}
+
+// The slot Space `id` wears, or -1 for none.
+int SlotOfSpaceW2B17(const SpaceRegistry& registry, const SpaceId& id) {
+  return SessionSlotForSpace(&registry, id).value_or(-1);
+}
+
+// One Space of the registry's list as a profile from before kept it: on its
+// own session `session`, with no slot written down.
+base::DictValue OldSpaceW2B17(const SpaceId& id,
+                              std::string_view name,
+                              std::string_view session) {
+  base::DictValue space;
+  space.Set("id", id.ToString());
+  space.Set("name", name);
+  space.Set("color", static_cast<int>(SK_ColorBLUE));
+  space.Set("profile", session);
+  space.Set("isolated", true);
+  return space;
+}
+
+// P19-1c, sessions S32: a Space's own session, which has no row in the
+// sessions list, keeps its colour when a named session is made on its slot,
+// when a Space before it gets an own session on that slot, and when another
+// Space joins it; and every session has its colour again after a restart.
+TEST(SessionSlotW2B17Test, ASpacesOwnSessionKeepsItsColourAsSessionsAreMade) {
+  TestingPrefServiceSimple prefs;
+  RegisterPrefsW2B17(prefs);
+  SpaceRegistry registry(&prefs);
+  const SpaceId first = registry.Add("First", SK_ColorBLUE);
+  const SpaceId own = registry.Add("Own", SK_ColorRED);
+  const SpaceId joiner = registry.Add("Joiner", SK_ColorGREEN);
+  registry.EnsureIsolated(own);
+  const std::string own_session = registry.Find(own)->profile_id;
+  ASSERT_FALSE(own_session.empty());
+  ASSERT_FALSE(registry.HasSessionRow(own_session));
+  const int slot = SlotOfSpaceW2B17(registry, own);
+  ASSERT_GE(slot, 0);
+  EXPECT_EQ(HashSlotW2B17(own_session), slot)
+      << "alone, a session has the slot its id hashes to";
+
+  // A named session whose id hashes to the same slot.
+  const std::string named = TokenHashingToW2B17(slot);
+  ASSERT_FALSE(named.empty());
+  registry.EnsureSessionRow(named, "Clients");
+  ASSERT_TRUE(registry.HasSessionRow(named));
+  EXPECT_EQ(slot, SlotOfSpaceW2B17(registry, own))
+      << "a named session made later took the Space's colour";
+  EXPECT_NE(slot, SessionSlot(registry, named))
+      << "the new session wears the colour of one before it";
+
+  // A Space before it in the list gets an own session on that slot too.
+  const std::string first_session = TokenHashingToW2B17(slot);
+  ASSERT_FALSE(first_session.empty());
+  registry.SetProfileId(first, first_session);
+  registry.SetIsolated(first, true);
+  EXPECT_EQ(slot, SlotOfSpaceW2B17(registry, own))
+      << "an own session given to a Space before it took its colour";
+  const int named_slot = SessionSlot(registry, named);
+  const int first_slot = SlotOfSpaceW2B17(registry, first);
+  EXPECT_EQ(3u, (std::set<int>{SlotOfSpaceW2B17(registry, own), named_slot,
+                               first_slot})
+                    .size())
+      << "two of three sessions share a colour";
+
+  // Another Space joins the own session, which has a row from now on.
+  registry.SetSession(joiner, own_session);
+  ASSERT_TRUE(registry.HasSessionRow(own_session));
+  EXPECT_EQ(slot, SlotOfSpaceW2B17(registry, own))
+      << "the session changed colour when a second Space joined it";
+  EXPECT_EQ(slot, SlotOfSpaceW2B17(registry, joiner));
+  EXPECT_EQ(named_slot, SessionSlot(registry, named));
+  EXPECT_EQ(first_slot, SlotOfSpaceW2B17(registry, first))
+      << "a join changed another session's colour";
+
+  // After a restart every session wears the colour it wore.
+  SpaceRegistry again(&prefs);
+  EXPECT_EQ(slot, SlotOfSpaceW2B17(again, own));
+  EXPECT_EQ(slot, SlotOfSpaceW2B17(again, joiner));
+  EXPECT_EQ(named_slot, SessionSlot(again, named));
+  EXPECT_EQ(first_slot, SlotOfSpaceW2B17(again, first));
+}
+
+// P19-1c, sessions S32: two Spaces whose own sessions hash to one slot keep
+// their colours when one is moved before the other in the switcher.
+TEST(SessionSlotW2B17Test, TwoOwnSessionsKeepTheirColoursWhenTheirSpacesMove) {
+  TestingPrefServiceSimple prefs;
+  RegisterPrefsW2B17(prefs);
+  SpaceRegistry registry(&prefs);
+  registry.Add("Home", SK_ColorBLUE);
+  const SpaceId left = registry.Add("Left", SK_ColorRED);
+  const SpaceId right = registry.Add("Right", SK_ColorGREEN);
+  constexpr int kSlot = 3;
+  const std::string left_session = TokenHashingToW2B17(kSlot);
+  const std::string right_session = TokenHashingToW2B17(kSlot);
+  ASSERT_FALSE(left_session.empty());
+  ASSERT_FALSE(right_session.empty());
+  registry.SetProfileId(left, left_session);
+  registry.SetIsolated(left, true);
+  registry.SetProfileId(right, right_session);
+  registry.SetIsolated(right, true);
+  const int left_slot = SlotOfSpaceW2B17(registry, left);
+  const int right_slot = SlotOfSpaceW2B17(registry, right);
+  ASSERT_GE(left_slot, 0);
+  ASSERT_GE(right_slot, 0);
+  EXPECT_NE(left_slot, right_slot);
+
+  ASSERT_TRUE(registry.Move(right, -1));
+  ASSERT_EQ(right, registry.entries()[1].id);
+  EXPECT_EQ(left_slot, SlotOfSpaceW2B17(registry, left))
+      << "moving a Space changed its session's colour";
+  EXPECT_EQ(right_slot, SlotOfSpaceW2B17(registry, right));
+
+  ASSERT_TRUE(registry.Move(right, -1));
+  ASSERT_EQ(right, registry.entries()[0].id);
+  EXPECT_EQ(left_slot, SlotOfSpaceW2B17(registry, left));
+  EXPECT_EQ(right_slot, SlotOfSpaceW2B17(registry, right));
+}
+
+// P19-1c, sessions S32: a profile from before the slots were written down
+// shows the colours it showed then -- the named rows first, in the list's
+// order, then the sessions with no row by their first Space -- and keeps
+// them from then on: when its Spaces move, and after a restart.
+TEST(SessionSlotW2B17Test, AProfileFromBeforeKeepsTheColoursItShowed) {
+  constexpr int kSlot = 1;
+  const std::string named = TokenHashingToW2B17(kSlot);
+  const std::string one_session = TokenHashingToW2B17(kSlot);
+  const std::string two_session = TokenHashingToW2B17(kSlot);
+  ASSERT_FALSE(named.empty());
+  ASSERT_FALSE(one_session.empty());
+  ASSERT_FALSE(two_session.empty());
+  const SpaceId one = SpaceId::GenerateNew();
+  const SpaceId two = SpaceId::GenerateNew();
+  TestingPrefServiceSimple prefs;
+  RegisterPrefsW2B17(prefs);
+  base::ListValue rows;
+  base::DictValue row;
+  row.Set("id", named);
+  row.Set("name", "Clients");
+  rows.Append(std::move(row));
+  prefs.SetList(stedding::prefs::kSpaceSessions, std::move(rows));
+  base::ListValue list;
+  list.Append(OldSpaceW2B17(one, "One", one_session));
+  list.Append(OldSpaceW2B17(two, "Two", two_session));
+  prefs.SetList(stedding::prefs::kSpaceRegistry, std::move(list));
+
+  SpaceRegistry registry(&prefs);
+  ASSERT_EQ(2u, registry.entries().size());
+  const int next = (kSlot + 1) % static_cast<int>(kSessionSlots);
+  const int after = (kSlot + 2) % static_cast<int>(kSessionSlots);
+  EXPECT_EQ(kSlot, SessionSlot(registry, named));
+  EXPECT_EQ(next, SlotOfSpaceW2B17(registry, one));
+  EXPECT_EQ(after, SlotOfSpaceW2B17(registry, two));
+
+  ASSERT_TRUE(registry.Move(two, -1));
+  EXPECT_EQ(kSlot, SessionSlot(registry, named));
+  EXPECT_EQ(next, SlotOfSpaceW2B17(registry, one))
+      << "moving a Space swapped two sessions' colours";
+  EXPECT_EQ(after, SlotOfSpaceW2B17(registry, two));
+
+  SpaceRegistry again(&prefs);
+  EXPECT_EQ(kSlot, SessionSlot(again, named));
+  EXPECT_EQ(next, SlotOfSpaceW2B17(again, one));
+  EXPECT_EQ(after, SlotOfSpaceW2B17(again, two));
+}
+
+}  // namespace
+}  // namespace spaces
