+
+FolderDragTarget::FolderDragTarget(TabStripModel& tabs,
+                                   views::View* tab_strip_root)
+    : tabs_(tabs), tab_strip_root_(tab_strip_root) {}
+
+FolderDragTarget::~FolderDragTarget() {
+  will_destroy_callbacks_.Notify();
+}
+
+// static
+FolderView* FolderDragTarget::FindFolderView(views::View& parent,
+                                             const gfx::Point& point_in_screen) {
+  for (views::View* child : parent.children()) {
+    if (!child->GetVisible()) {
+      continue;
+    }
+    if (auto* const folder_view = views::AsViewClass<FolderView>(child)) {
+      if (folder_view->GetHeaderBoundsInScreen().Contains(point_in_screen)) {
+        return folder_view;
+      }
+      // A nested folder's header sits inside its parent's body.
+    }
+    if (FolderView* const nested = FindFolderView(*child, point_in_screen)) {
+      return nested;
+    }
+  }
+  return nullptr;
+}
+
+FolderView* FolderDragTarget::FolderViewAtScreenPoint(
+    const gfx::Point& point_in_screen) const {
+  return tab_strip_root_ ? FindFolderView(*tab_strip_root_, point_in_screen)
+                         : nullptr;
+}
+
+void FolderDragTarget::SetHoveredFolder(const tabs::TabCollection* folder,
+                                        FolderView* view) {
+  if (hovered_view_ && hovered_view_ != view) {
+    hovered_view_->SetDropHighlight(false);
+  }
+  if (!folder || folder->type() != tabs::TabCollection::Type::FOLDER) {
+    ClearHoveredFolder();
+    return;
+  }
+  hovered_ = folder->GetHandle();
+  hovered_view_ = view;
+  if (hovered_view_) {
+    hovered_view_->SetDropHighlight(true);
+  }
+}
+
+void FolderDragTarget::ClearHoveredFolder() {
+  if (hovered_view_) {
+    hovered_view_->SetDropHighlight(false);
+  }
+  hovered_.reset();
+  hovered_view_ = nullptr;
+}
+
+void FolderDragTarget::OnTabDragEntered() {}
+
+TabDragContext* FolderDragTarget::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  const DragSessionData& session = controller.GetSessionData();
+  dragged_pinned_ = !session.tab_drag_data_.empty() &&
+                    session.tab_drag_data_.front().pinned;
+  FolderView* const view = FolderViewAtScreenPoint(point_in_screen);
+  // Essentials tabs never enter a folder, so a header is not a target for one.
+  SetHoveredFolder(dragged_pinned_ ? nullptr : (view ? view->folder() : nullptr),
+                   view);
+  // Keep the tab where it is. The header is inside the strip the tab is
+  // already attached to; returning null here would pop it out into a window
+  // of its own for as long as the header is hovered.
+  return const_cast<TabDragContext*>(controller.GetAttachedContext());
+}
+
+void FolderDragTarget::OnTabDragExited(const gfx::Point& point_in_screen) {
+  ClearHoveredFolder();
+}
+
+void FolderDragTarget::OnTabDragEnded() {
+  ClearHoveredFolder();
+  dragged_pinned_ = false;
+}
+
+bool FolderDragTarget::CanDropTab() {
+  return !dragged_pinned_ && hovered_ && hovered_->Get() != nullptr;
+}
+
+void FolderDragTarget::HandleTabDrop(DragController& controller) {
+  if (!hovered_) {
+    return;
+  }
+
+  // Only the first dragged tab, as SpaceDragTarget does: a multi-tab drop on
+  // a folder is not a gesture the reference has, and reading DragSessionData
+  // would make this untestable without a real drag session.
+  std::unique_ptr<tabs::TabModel> tab = controller.DetachTabAtForInsertion(0);
+  if (!tab) {
+    ClearHoveredFolder();
+    return;
+  }
+
+  // Back into the strip first, so the tab exists whatever happens next. A
+  // pinned tab goes back to the essentials row and stays out of the folder.
+  tabs::TabInterface* const inserted = tab.get();
+  // Detaching clears the tab's own pinned flag (it follows the collection the
+  // tab sits in), so the record taken from the drag session is the one to
+  // trust. A pinned tab should not get here (CanDropTab refuses it), but if
+  // it does it goes back where it came from.
+  const bool pinned = dragged_pinned_ || tab->IsPinned();
+  const int index = pinned ? tabs_->IndexOfFirstNonPinnedTab() : tabs_->count();
+  tabs_->InsertDetachedTabAt(
+      index, std::move(tab),
+      AddTabTypes::ADD_ACTIVE | (pinned ? AddTabTypes::ADD_PINNED
+                                        : AddTabTypes::ADD_NONE));
+
+  // Re-resolve: detaching the folder's only tab peeled the folder away, in
+  // which case there is nothing to join and the tab simply stays put.
+  tabs::TabCollection* const collection = hovered_->Get();
+  if (!pinned && collection &&
+      collection->type() == tabs::TabCollection::Type::FOLDER) {
+    tabs_->MoveTabsToFolder(
+        {tabs_->GetIndexOfTab(inserted)},
+        static_cast<tabs::FolderTabCollection*>(collection));
+  }
+  ClearHoveredFolder();
+}
+
+base::CallbackListSubscription FolderDragTarget::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return will_destroy_callbacks_.Add(std::move(callback));
+}
