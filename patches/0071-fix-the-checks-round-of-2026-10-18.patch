+// pins H3, H11 (the owner, 2026-10-18): the row shown when the pin on
+// screen, `active`, goes to sleep with `doomed`: the next visible row of the
+// Space below it, else the nearest visible row above it. Never an essential,
+// a row being slept, the other pane of the active split, or a row the
+// sidebar hides (another Space's, a collapsed folder's or pinned run's: the
+// one rule for which rows show, spaces B33). Null when the Space has no
+// other row, and a new tab opens there. TabStripModel::SelectNextTab chose
+// it: it wrapped round the strip, and from a Space's last row it landed on
+// the first essential.
+tabs::TabInterface* RowShownAfterSleep(
+    TabStripModel* tabs,
+    tabs::TabInterface* active,
+    const std::vector<tabs::TabInterface*>& doomed) {
+  const int from = tabs->GetIndexOfTab(active);
+  const auto takes = [&](int index) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(index);
+    return !tab->IsPinned() && !tabs->IsTabHidden(index) &&
+           !std::ranges::contains(doomed, tab) &&
+           !(active->IsSplit() && tab->GetSplit() == active->GetSplit());
+  };
+  for (int index = from + 1; index < tabs->count(); ++index) {
+    if (takes(index)) {
+      return tabs->GetTabAtIndex(index);
+    }
+  }
+  for (int index = from - 1; index >= 0; --index) {
+    if (takes(index)) {
+      return tabs->GetTabAtIndex(index);
+    }
+  }
+  return nullptr;
