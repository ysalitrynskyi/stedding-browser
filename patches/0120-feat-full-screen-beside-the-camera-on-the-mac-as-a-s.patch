@@ -0,0 +1,114 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_CAMERA_ROW_MAC_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_CAMERA_ROW_MAC_H_
+
+#import <Foundation/Foundation.h>
+
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/gfx/geometry/rect.h"
+
+class BrowserView;
+@class NativeWidgetMacNSWindow;
+@class NSScreen;
+
+namespace stedding {
+
+// docs/features/toolbar.md T55-T59 (BACKLOG S-392): Stedding's own full
+// screen on a Mac whose screen has a camera housing. macOS's full screen
+// keeps the row beside the camera for the menu bar, a black band over the
+// page; no public switch gives that row to the window. So with the switch on
+// (stedding.window.camera_row_fullscreen), full screen the person starts
+// turns the window into a borderless one over the whole screen, hides the
+// menu bar and the Dock while it is the main window, and tells the window
+// (stedding::AddressRow::SetCameraRow) where the row and the housing are,
+// for the address row to sit beside the camera. Leaving puts the window back
+// as it was. A page's own full screen stays macOS's (T58): the window turns
+// ordinary for it and comes back after.
+//
+// One per in-process browser window, owned by its BrowserNativeWidgetMac.
+class CameraRowFullscreenMac {
+ public:
+  // The row beside the camera on a screen, in points from the screen's left
+  // edge; a test sets one for the screen under test, whatever its hardware,
+  // and one with no height stands for a screen without a housing.
+  struct Housing {
+    int height = 0;
+    int left = 0;
+    int right = 0;
+  };
+  static void SetHousingForTesting(std::optional<Housing> housing);
+  static std::optional<Housing> HousingOn(NSScreen* screen);
+
+  CameraRowFullscreenMac(BrowserView* browser_view,
+                         NativeWidgetMacNSWindow* window);
+  CameraRowFullscreenMac(const CameraRowFullscreenMac&) = delete;
+  CameraRowFullscreenMac& operator=(const CameraRowFullscreenMac&) = delete;
+  ~CameraRowFullscreenMac();
+
+  // In it now; not while a page's own full screen has it turned ordinary.
+  bool active() const { return active_; }
+
+  // T55: full screen the person starts. Leaves it, or enters it when the
+  // switch is on and the window's screen has a housing; no means macOS's
+  // full screen goes ahead.
+  bool Toggle();
+
+  // T58: macOS's full screen is about to start for the window (a page asked
+  // for it). The window turns ordinary over the same frame, and comes back
+  // when that full screen has ended (NativeFullscreenEnded).
+  void WillEnterNativeFullscreen();
+  void NativeFullscreenEnded();
+
+  // T59: the frame the window had before; what the session saves, and what
+  // a window made from it (a tab torn out) starts from.
+  std::optional<gfx::Rect> RestoredBounds() const;
+
+ private:
+  bool CanEnter() const;
+  void Enter();
+  // `restore_frame`: the frame from before; no keeps the window where it is,
+  // for macOS's own full screen to start from.
+  void Leave(bool restore_frame);
+  // Over the screen the window is on, with the row there; leaves when that
+  // screen has no housing.
+  void FitScreen();
+  void OnMainChanged(bool main);
+  void SetHidesMenuBar(bool hides);
+  // The frame from before, moved onto a screen that is still there: a lid
+  // closed or a display unplugged meanwhile may have taken its own away.
+  NSRect FrameToRestore() const;
+  void OnSwitchChanged();
+  void OnScreenChanged();
+
+  const raw_ptr<BrowserView> browser_view_;
+  NativeWidgetMacNSWindow* __weak window_;
+  bool active_ = false;
+  // Turned ordinary for a page's own full screen; comes back after (T58).
+  bool suspended_ = false;
+  bool hides_menu_bar_ = false;
+  // The window as it was, put back on leaving.
+  NSRect saved_frame_ = {};
+  NSUInteger saved_style_ = 0;
+  BOOL saved_movable_ = YES;
+  BOOL saved_shadow_ = YES;
+  // The presentation options this class added, and only those, taken off
+  // again on leaving: another part of the app (a kiosk launch) keeps its own.
+  NSUInteger added_presentation_ = 0;
+  PrefChangeRegistrar switch_registrar_;
+  id __strong main_observer_;
+  id __strong resign_main_observer_;
+  id __strong screen_observer_;
+  id __strong screens_observer_;
+  base::WeakPtrFactory<CameraRowFullscreenMac> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_STEDDING_CAMERA_ROW_MAC_H_
