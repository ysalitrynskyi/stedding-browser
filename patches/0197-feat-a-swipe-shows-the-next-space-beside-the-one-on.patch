+void VerticalTabStripRegionView::ShowSwipePreview(bool forward,
+                                                  float shift,
+                                                  float width) {
+  const int way = forward ? 1 : -1;
+  if (swipe_preview_way_ != way) {
+    // Swiped back past where it began: the Space the other way instead.
+    DropSwipePreview();
+    swipe_preview_way_ = way;
+    DrawSwipePreview(forward);
+  }
+  if (swipe_preview_.empty()) {
+    return;
+  }
+  // Joined to the Space on screen a whole width away, on the side the switch
+  // brings it in from (SlideInSpaceList), so the lift goes on from here.
+  const int direction =
+      stedding::SpaceSlideDirection(1, 1 + way, base::i18n::IsRTL());
+  gfx::Transform at;
+  at.Translate(shift + direction * width, 0);
+  for (const std::unique_ptr<SpaceSlideSnapshot>& drawn : swipe_preview_) {
+    drawn->layer()->GetAnimator()->StopAnimating();
+    drawn->layer()->SetTransform(at);
+  }
+}
+
+void VerticalTabStripRegionView::DrawSwipePreview(bool forward) {
+  TRACE_EVENT0("views", "Stedding::DrawSwipePreview");
+  spaces::SpaceModel* const model =
+      spaces::SpaceModel::From(browser_view()->browser());
+  auto* const strip = static_cast<TabStripView*>(tab_strip_view());
+  views::ScrollView* const list =
+      strip ? strip->unpinned_tabs_scroll_view() : nullptr;
+  const spaces::Space* const next =
+      model ? model->NeighbourSpace(forward) : nullptr;
+  if (!next || !list || !list->contents() || !space_tab_visibility_ ||
+      !list->IsDrawn() || list->bounds().IsEmpty()) {
+    return;
+  }
+  // A row with the keyboard's focus would lose it while the rows are swapped
+  // for the drawing; the Space then comes in at the lift, as it did before.
+  if (views::FocusManager* const focus = GetFocusManager()) {
+    if (const views::View* const focused = focus->GetFocusedView();
+        focused && strip->Contains(focused)) {
+      return;
+    }
+  }
+  const spaces::SpaceId shown = next->id();
+  const int scrolled = list->GetVisibleRect().y();
+  // The rows and the title of the Space the model answers for, in their
+  // places at once, with no row easing into its place (B37), and the list as
+  // tall as they are: the rows come to their places in the first pass, and
+  // the list takes their height in the second. One pass left the list the
+  // height of the Space on screen, which cut a longer Space's rows off.
+  const auto lay_out = [&]() {
+    space_tab_visibility_->DrawRowsOfShownSpace();
+    UpdateSpaceTitle();
+    for (int pass = 0; pass < 2; ++pass) {
+      if (UnpinnedTabContainerView* const rows =
+              strip->GetUnpinnedTabsContainer()) {
+        rows->SnapRowsToTargetLayout();
+      }
+      list->contents()->InvalidateLayout();
+      list->InvalidateLayout();
+      if (views::Widget* const widget = GetWidget()) {
+        widget->LayoutRootViewIfNecessary();
+      }
+    }
+  };
+  {
+    spaces::SpaceModel::ScopedDrawnSpace drawn(*model, shown);
+    lay_out();
+    // Scrolled where the Space was left in this window (B48), as the switch
+    // brings it.
+    const auto saved = space_scroll_offsets_.find(shown.ToString());
+    const int end = std::max(
+        0, list->contents()->height() - list->GetVisibleRect().height());
+    list->ScrollToOffset(gfx::PointF(
+        0, std::clamp(saved == space_scroll_offsets_.end() ? 0 : saved->second,
+                      0, end)));
+    for (views::View* const view : SpaceSwipeViews()) {
+      if (view->layer()->parent() && !view->bounds().IsEmpty()) {
+        swipe_preview_.push_back(std::make_unique<SpaceSlideSnapshot>(*view));
+        swipe_preview_.back()->layer()->SetName("SpaceSwipePreview");
+        swipe_preview_.back()->layer()->SetOpacity(1.0f);
+      }
+    }
+  }
+  // The strip clips what it holds to its own height, which is the Space on
+  // screen's: a longer Space's last rows were cut off. The drawing hangs from
+  // the layer above the strip instead, at the same place; the region clips it
+  // at the sidebar's edge (below).
+  if (ui::Layer* const strip_layer = strip->layer();
+      strip_layer && strip_layer->parent()) {
+    ui::Layer* const host = strip_layer->parent();
+    for (const std::unique_ptr<SpaceSlideSnapshot>& drawn : swipe_preview_) {
+      ui::Layer* const layer = drawn->layer();
+      if (layer->parent() != strip_layer) {
+        continue;
+      }
+      const gfx::Rect bounds =
+          layer->bounds() + strip_layer->bounds().OffsetFromOrigin();
+      strip_layer->Remove(layer);
+      host->Add(layer);
+      host->StackAbove(layer, strip_layer);
+      layer->SetBounds(bounds);
+    }
+  }
+  // The Space on screen, as it was.
+  lay_out();
+  list->ScrollToOffset(gfx::PointF(0, scrolled));
+  // The drawing crosses the sidebar's edge as the fingers bring it in: the
+  // region clips it, as it clips a switch's slide (B32, sidebar Y19).
+  if (!swipe_preview_.empty() && !space_slide_clipped_) {
+    space_slide_clipped_ = true;
+    UpdateHiddenClip(/*animating=*/false);
+  }
+}
+
+void VerticalTabStripRegionView::DropSwipePreview() {
+  // Moved out first, so nothing that runs while the layers go finds them.
+  std::vector<std::unique_ptr<SpaceSlideSnapshot>> dropped;
+  dropped.swap(swipe_preview_);
+  swipe_preview_way_ = 0;
+  ++swipe_preview_generation_;
+  // A switch's slide, while one runs, keeps the clip until it ends.
+  if (!dropped.empty() && outgoing_space_.empty() && space_slide_clipped_) {
+    space_slide_clipped_ = false;
+    UpdateHiddenClip(/*animating=*/false);
+  }
+}
+
+void VerticalTabStripRegionView::DropSwipePreviewAfterSlide(int generation) {
+  if (generation == swipe_preview_generation_) {
+    DropSwipePreview();
+  }
+}
