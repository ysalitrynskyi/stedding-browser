+namespace {
+
+using WelcomeFlowTest = InProcessBrowserTest;
+
+// The dialog's page, loaded.
+content::WebContents* OpenWelcome(BrowserWindowInterface& browser) {
+  stedding::ShowWelcomeDialog(browser);
+  for (content::WebContents* const contents : content::GetAllWebContents()) {
+    if (contents->GetVisibleURL().host() == "stedding-welcome" &&
+        content::WaitForLoadStop(contents)) {
+      return contents;
+    }
+  }
+  return nullptr;
+}
+
+// welcome W6 (S-76): the keys step fits the dialog, nothing under its footer,
+// and teaches no key of a withdrawn feature: Peek is off until it is rebuilt
+// (PLAN.md, decision 2), so "turn a peek into a tab" is not among the keys.
+// Its last line ran under the footer (2026-10-02).
+IN_PROC_BROWSER_TEST_F(WelcomeFlowTest, TheKeysStepFitsAndTeachesNoPeek) {
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  EXPECT_EQ("keys fit", content::EvalJs(page, R"(
+      (() => {
+        for (let i = 0; i < 4; ++i) {
+          document.querySelector('button.primary').click();
+        }
+        const main = document.querySelector('main');
+        if (!main.querySelector('.keys')) {
+          return 'not on the keys step';
+        }
+        return main.scrollHeight <= main.clientHeight
+            ? 'keys fit'
+            : `keys run ${main.scrollHeight - main.clientHeight}px under`;
+      })())"));
+  const std::string keys =
+      content::EvalJs(page, "document.querySelector('.keys').textContent")
+          .ExtractString();
+  EXPECT_EQ(std::string::npos, keys.find("peek")) << keys;
+}
+
+// welcome W11 (S-76): a step whose content runs on under the footer -- the
+// import step under a long Arc block, any step on a small screen -- fades out
+// at the bottom while there is more below, and stops once it is scrolled to
+// its end. The import step's cards were cut off mid-card with nothing to say
+// that the step scrolls (2026-10-02).
+IN_PROC_BROWSER_TEST_F(WelcomeFlowTest, AStepThatRunsOnFadesOutUntilItsEnd) {
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  EXPECT_EQ("short:false long:true end:false", content::EvalJs(page, R"(
+      (() => {
+        const main = document.querySelector('main');
+        const fits = main.classList.contains('more');
+        for (let i = 0; i < 40; ++i) {
+          const line = document.createElement('p');
+          line.textContent = 'More of the step';
+          main.append(line);
+        }
+        main.dispatchEvent(new Event('scroll'));
+        const runsOn = main.classList.contains('more');
+        main.scrollTop = main.scrollHeight;
+        main.dispatchEvent(new Event('scroll'));
+        const atEnd = main.classList.contains('more');
+        return `short:${fits} long:${runsOn} end:${atEnd}`;
+      })())"));
+}
+
+}  // namespace
