+  const std::u16string kRow = u"Install Page as App…";
+#endif
+  chrome::BrowserCommandController* const commands =
+      chrome::BrowserCommandController::From(browser());
+  ASSERT_TRUE(commands);
+  AddTab(browser(), GURL("about:blank"));
+  commands->TabStateChanged();
+  EXPECT_FALSE(chrome::IsCommandEnabled(browser(), IDC_STEDDING_MAKE_APP))
+      << "about:blank can become no app";
+  auto bar = std::make_unique<CommandBarView>(browser());
+  bar->SetModeForTesting(CommandBarView::Mode::kActions);
+  EXPECT_FALSE(HasTitle(*bar, kRow));
+
+  // The row follows the command, whatever the page.
+  chrome::UpdateCommandEnabled(browser(), IDC_STEDDING_MAKE_APP, true);
+  bar->SetModeForTesting(CommandBarView::Mode::kActions);
+  EXPECT_TRUE(HasTitle(*bar, kRow));
+  // Each word from the start of one of the row's words, in its title or its
+  // keywords.
+#if BUILDFLAG(IS_MAC)
+  for (const char16_t* word :
+       {u"dock", u"App", u"install", u"ins", u"add app"}) {
+#else
+  for (const char16_t* word : {u"App", u"install", u"ins", u"page app"}) {
+#endif
+    bar->ContentsChanged(bar->field_for_testing(), word);
+    EXPECT_LT(RowIndex(*bar, kRow), bar->row_count_for_testing()) << word;
+  }
+  bar->ContentsChanged(bar->field_for_testing(), u"zebra");
+  EXPECT_FALSE(HasTitle(*bar, kRow)) << "the keywords match as the title does";
+  bar.reset();
+
+  auto peeking = std::make_unique<CommandBarView>(browser());
+  peeking->SetPeekOpenForTesting(true);
+  peeking->SetModeForTesting(CommandBarView::Mode::kActions);
+  EXPECT_FALSE(HasTitle(*peeking, kRow));
+  peeking.reset();
+
+  Profile* const otr =
+      profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  std::unique_ptr<BrowserWindowInterface> private_window =
+      CreateBrowser(otr, Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  AddTab(private_window.get(), GURL("https://example.org/"));
+  chrome::UpdateCommandEnabled(private_window.get(), IDC_STEDDING_MAKE_APP,
+                               true);
+  {
+    auto private_bar = std::make_unique<CommandBarView>(private_window.get());
+    private_bar->SetModeForTesting(CommandBarView::Mode::kActions);
+    EXPECT_FALSE(HasTitle(*private_bar, kRow));
+    EXPECT_FALSE(HasTitle(*private_bar, u"Manage Apps"));
+  }
+  private_window->GetTabStripModel()->CloseAllTabs();
+}
+
+// web apps Wa18: "Manage Apps" opens chrome://apps, where an app is opened,
+// set up or removed; typing "uninstall" finds it. A keyword answers from its
+// start only (K10): "move", the start of every Move Tab row, is inside
+// "remove", and "all" inside "install" and "uninstall", and neither lists
+// the two app rows.
+TEST_F(CommandBarViewTest, TheManageAppsRowOpensTheAppsPage) {
+#if BUILDFLAG(IS_MAC)
+  const std::u16string kMakeAppRow = u"Add to Dock…";
+#else
+  const std::u16string kMakeAppRow = u"Install Page as App…";
+#endif
+  AddTab(browser(), GURL("https://example.com/"));
+  chrome::UpdateCommandEnabled(browser(), IDC_STEDDING_MAKE_APP, true);
+  auto bar = std::make_unique<CommandBarView>(browser());
+  bar->SetModeForTesting(CommandBarView::Mode::kActions);
+  ASSERT_TRUE(HasTitle(*bar, kMakeAppRow));
+  bar->ContentsChanged(bar->field_for_testing(), u"move");
+  EXPECT_FALSE(HasTitle(*bar, u"Manage Apps"));
+  EXPECT_FALSE(HasTitle(*bar, kMakeAppRow));
+  bar->ContentsChanged(bar->field_for_testing(), u"all");
+  EXPECT_FALSE(HasTitle(*bar, u"Manage Apps"));
+#if BUILDFLAG(IS_MAC)
+  // Elsewhere the row's own title, "Install…", has "all" in it (K10's
+  // title rule).
+  EXPECT_FALSE(HasTitle(*bar, kMakeAppRow));
+#endif
+  bar->ContentsChanged(bar->field_for_testing(), u"uninstall");
+  ASSERT_EQ(1u, bar->row_count_for_testing());
+  EXPECT_EQ(u"Manage Apps", bar->row_title_for_testing(0));
+  EXPECT_TRUE(bar->row_detail_for_testing(0).empty()) << "no chord";
+  EXPECT_TRUE(Enter(*bar));
+  tabs::TabInterface* const opened = tabs().GetActiveTab();
+  ASSERT_TRUE(opened);
+  EXPECT_EQ(GURL(chrome::kChromeUIAppsURL),
+            opened->GetContents()->GetVisibleURL());
+}
