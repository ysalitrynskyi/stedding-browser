+// P24 (BACKLOG S-469, GitHub issue 102): an extension reaches a peek's page
+// by the tab id its content script sends as, as a password manager does to
+// fill the form its menu was opened on. The content script tells the
+// extension it is there; the extension answers the sender's tab by its id.
+// The pinned tab under the peek gets its own answer as any tab does; the
+// peek's page got none, its id belonging to no tab strip.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest,
+                       AnExtensionReachesThePeeksPageByItsTabId) {
+  extensions::TestExtensionDir dir;
+  dir.WriteManifest(R"({
+      "name": "Answers the sender",
+      "version": "1",
+      "manifest_version": 3,
+      "background": {"service_worker": "background.js"},
+      "host_permissions": ["<all_urls>"],
+      "content_scripts": [{"matches": ["<all_urls>"], "js": ["page.js"]}]
+  })");
+  dir.WriteFile(FILE_PATH_LITERAL("background.js"),
+                "chrome.runtime.onMessage.addListener((message, sender) => {"
+                "  if (message === 'here' && sender.tab) {"
+                "    chrome.tabs.sendMessage(sender.tab.id, 'answered');"
+                "  }"
+                "});");
+  dir.WriteFile(FILE_PATH_LITERAL("page.js"),
+                "chrome.runtime.onMessage.addListener((message) => {"
+                "  document.documentElement.dataset.answer = message;"
+                "});"
+                "chrome.runtime.sendMessage('here');");
+  extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+  ASSERT_TRUE(loader.LoadExtension(dir.UnpackedPath()));
+
+  // The answer a page got, or "none" after ten seconds.
+  const auto answer_in = [](content::WebContents* page) {
+    return content::EvalJs(
+        page,
+        "new Promise(done => { const until = Date.now() + 10000;"
+        "  const look = () => {"
+        "    const answer = document.documentElement.dataset.answer;"
+        "    if (answer) { done(answer); }"
+        "    else if (Date.now() > until) { done('none'); }"
+        "    else { setTimeout(look, 50); } };"
+        "  look(); })");
+  };
+
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title2.html")));
+  tabs::TabInterface* const pin = tab();
+  EXPECT_EQ("answered", answer_in(pin->GetContents()))
+      << "the extension does not answer a tab";
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  EXPECT_EQ("answered", answer_in(peek->page()))
+      << "the extension could not reach the peek's page by its tab id";
+}
