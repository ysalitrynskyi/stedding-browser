+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_LIT_TOOLBAR_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_LIT_TOOLBAR_BUTTON_H_
+
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace gfx {
+class Canvas;
+}  // namespace gfx
+
+namespace stedding {
+
+// docs/features/toolbar.md T60 (the owner, 2026-11-05; BACKLOG S-423): an
+// address row button that stays lit while something it switches is on, the
+// shield and the moon. Lit, it draws a circle under its icon, one size and
+// one colour for both. Its hover and press use the same circle, so the lit
+// look and a hover over it are one shape.
+class LitToolbarButton : public ToolbarButton {
+  METADATA_HEADER(LitToolbarButton, ToolbarButton)
+
+ public:
+  explicit LitToolbarButton(PressedCallback callback);
+  LitToolbarButton(const LitToolbarButton&) = delete;
+  LitToolbarButton& operator=(const LitToolbarButton&) = delete;
+  ~LitToolbarButton() override;
+
+  // The circle, in this view's coordinates, centred on the button and so on
+  // its icon, and its fill.
+  gfx::Rect GetLitCircleBounds() const;
+  SkColor GetLitCircleColor() const;
+
+ protected:
+  void SetLit(bool lit);
+
+  // views::View:
+  void OnPaintBackground(gfx::Canvas* canvas) override;
+
+ private:
+  bool lit_ = false;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_LIT_TOOLBAR_BUTTON_H_
