+// welcome W14 (BACKLOG S-349): Skip setup closes a flow opened again over a
+// profile that has finished it, as --stedding-welcome opens it. The
+// preference Finish and Skip write was already set, so the dialog, which
+// closes when it changes, heard nothing and stayed open.
+IN_PROC_BROWSER_TEST_F(WelcomeFlowTest, SkipClosesAFlowAlreadySeen) {
+  // The install's thank-you page follows the flow (updates Up9).
+  g_browser_process->local_state()->SetBoolean(
+      stedding::prefs::kThanksAfterInstallShown, true);
+  Profile* const profile = browser()->GetProfile();
+  profile->GetPrefs()->SetBoolean(stedding::prefs::kWelcomeShown, true);
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  const auto flows_open = []() {
+    size_t count = 0;
+    for (content::WebContents* const contents :
+         content::GetAllWebContents()) {
+      if (contents->GetVisibleURL().host() == "stedding-welcome") {
+        ++count;
+      }
+    }
+    return count;
+  };
+  ASSERT_EQ(1u, flows_open());
+  ASSERT_TRUE(content::ExecJs(
+      page, "document.querySelector('[data-focus=\"skip\"]').click()"));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return flows_open() == 0u; }))
+      << "the flow stayed open after Skip setup";
+  EXPECT_TRUE(profile->GetPrefs()->GetBoolean(stedding::prefs::kWelcomeShown));
+}
