@@ -510,6 +510,21 @@ class TabStripModel {
 
   bool IsTabCollapsed(int index) const;
 
+  // Returns true if the user cannot currently see the tab at `index`: it is in
+  // a collapsed group, or an embedder-supplied predicate says so.
+  //
+  // Tab traversal and the choice of which tab to activate next both skip these,
+  // so a tab the user cannot see is never silently activated. Prefer this over
+  // IsTabCollapsed() anywhere the question is "can the user see this".
+  bool IsTabHidden(int index) const;
+
+  // Lets the embedder hide tabs that are in this model but should not be shown
+  // -- Stedding uses it for tabs belonging to a Space other than the active
+  // one. The predicate must be cheap; it is called during traversal.
+  using HiddenTabPredicate =
+      base::RepeatingCallback<bool(const tabs::TabInterface*)>;
+  void SetHiddenTabPredicate(HiddenTabPredicate predicate);
+
   bool IsGroupCollapsed(const tab_groups::TabGroupId& group) const;
 
   // Returns true if the tab at `index` is blocked by a tab modal dialog.
@@ -1470,6 +1485,9 @@ class TabStripModel {
 
