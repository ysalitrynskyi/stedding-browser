@@ -0,0 +1,58 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_TEST_STEDDING_SIDEBAR_TEST_UTIL_H_
+#define CHROME_TEST_STEDDING_SIDEBAR_TEST_UTIL_H_
+
+#include "ui/events/types/event_type.h"
+
+class FolderView;
+class TabView;
+
+namespace gfx {
+class Point;
+}  // namespace gfx
+
+namespace tabs {
+class FolderTabCollection;
+class TabInterface;
+}  // namespace tabs
+
+namespace views {
+class View;
+class Widget;
+}  // namespace views
+
+namespace stedding::test {
+
+// The drawn row of `tab` anywhere under `root`, or null. The search walks the
+// whole window, so a test does not depend on which container holds a row.
+TabView* FindDrawnRow(views::View* root, const tabs::TabInterface* tab);
+
+// The drawn view of `folder` anywhere under `root`, or null.
+FolderView* FindDrawnFolder(views::View* root,
+                            const tabs::FolderTabCollection* folder);
+
+// Waits until no container in `widget` still moves its rows into place: a
+// new folder or split grows from nothing over 200 ms, and a click or a drop
+// lands where a person's would only once a row has its size. False if the
+// rows never settle.
+[[nodiscard]] bool WaitForRowsToSettle(views::Widget* widget);
+
+// Hands one left-button mouse event at `screen_point` to `widget`'s views,
+// as the window does with a real one once it has passed the platform's
+// checks: a press, a drag or a release. The Mac event generator keeps a
+// window point as a screen point between the steps of a drag, so its pointer
+// wanders mid-drag, and the widget itself asks the system whether a button
+// is really down; the root view does neither.
+void SendLeftMouse(views::Widget* widget,
+                   ui::EventType type,
+                   const gfx::Point& screen_point);
+
+// A press and a release at `screen_point`.
+void ClickLeftMouse(views::Widget* widget, const gfx::Point& screen_point);
+
+}  // namespace stedding::test
+
+#endif  // CHROME_TEST_STEDDING_SIDEBAR_TEST_UTIL_H_
diff --git a/chrome/test/stedding/sleep_gate_browsertest.cc b/chrome/test/stedding/sleep_gate_browsertest.cc
new file mode 100644
index 0000000000000..42e41544a0581
--- /dev/null
+++ b/chrome/test/stedding/sleep_gate_browsertest.cc
@@ -0,0 +1,137 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// What keeps a tab awake when Stedding puts it to sleep (tabs R5-R6,
+// PLAN.md TAB-14).
+//
+// A sleep discards the page. Only a page that could ask "Leave site?" -- a
+// beforeunload handler and a user gesture in the same frame -- has something
+// a discard would lose without asking; an unload handler alone asks nothing.
+// A unit test cannot give a frame a handler or a gesture, so these run a
+// real page.
+
+#include <string>
+#include <vector>
+
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/sleep_tabs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+class SleepGateTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  // The first tab loads a page and runs `script` in it, with or without a
+  // user gesture; a second tab then takes the screen, as a sleep needs.
+  tabs::TabInterface* PageInTheBackground(const std::string& script,
+                                          bool gesture) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("/title1.html")));
+    tabs::TabInterface* const tab = tabs()->GetActiveTab();
+    EXPECT_TRUE(content::ExecJs(
+        tab->GetContents(), script,
+        gesture ? content::EXECUTE_SCRIPT_DEFAULT_OPTIONS
+                : content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL("/title2.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    EXPECT_NE(tab, tabs()->GetActiveTab());
+    return tab;
+  }
+
+  bool Slept(tabs::TabInterface* tab) {
+    return tab->GetContents() && tab->GetContents()->WasDiscarded();
+  }
+
+  // A sleep that is refused leaves nothing pending; one that goes ahead
+  // finishes within the run loop.
+  void SleepAndSettle(tabs::TabInterface* tab) {
+    stedding::SleepTabList({tab});
+    base::RunLoop().RunUntilIdle();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SleepGateTest, APlainPageSleeps) {
+  tabs::TabInterface* const tab = PageInTheBackground("1", /*gesture=*/true);
+  stedding::SleepTabList({tab});
+  EXPECT_TRUE(base::test::RunUntil([&]() { return Slept(tab); }));
+}
+
+IN_PROC_BROWSER_TEST_F(SleepGateTest, APageThatCouldAskToStayIsKeptAwake) {
+  tabs::TabInterface* const tab = PageInTheBackground(
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);",
+      /*gesture=*/true);
+  SleepAndSettle(tab);
+  EXPECT_FALSE(Slept(tab)) << "a discard would drop the user's unsaved work";
+  EXPECT_TRUE(stedding::TabIsInUse(tab));
+  // The window could not close at the end of the test with the page asking.
+  EXPECT_TRUE(content::ExecJs(
+      tab->GetContents(),
+      "window.removeEventListener('beforeunload', window.stay);"));
+}
+
+IN_PROC_BROWSER_TEST_F(SleepGateTest, BeforeunloadWithoutAGestureSleeps) {
+  tabs::TabInterface* const tab = PageInTheBackground(
+      "window.addEventListener('beforeunload', e => {"
+      "  e.preventDefault(); e.returnValue = ''; });",
+      /*gesture=*/false);
+  stedding::SleepTabList({tab});
+  EXPECT_TRUE(base::test::RunUntil([&]() { return Slept(tab); }))
+      << "without a gesture the page could never ask, so nothing is lost";
+}
+
+IN_PROC_BROWSER_TEST_F(SleepGateTest, AnUnloadHandlerAloneSleeps) {
+  tabs::TabInterface* const tab =
+      PageInTheBackground("window.addEventListener('unload', () => {});",
+                          /*gesture=*/true);
+  stedding::SleepTabList({tab});
+  EXPECT_TRUE(base::test::RunUntil([&]() { return Slept(tab); }));
+}
+
+// A tab playing sound is in use (tabs R5): a sleep would stop it.
+IN_PROC_BROWSER_TEST_F(SleepGateTest, APlayingPageIsKeptAwake) {
+  tabs::TabInterface* const tab = PageInTheBackground(
+      "window.context = new AudioContext();"
+      "const tone = window.context.createOscillator();"
+      "tone.connect(window.context.destination); tone.start();"
+      "window.context.resume();",
+      /*gesture=*/true);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return tab->GetContents()->IsCurrentlyAudible(); }));
+  SleepAndSettle(tab);
+  EXPECT_FALSE(Slept(tab)) << "a sleep would stop the sound";
+  EXPECT_TRUE(stedding::TabIsInUse(tab));
+  ASSERT_TRUE(content::ExecJs(tab->GetContents(), "window.context.close();"));
+}
+
+// The tab on screen never sleeps, whatever asks.
+IN_PROC_BROWSER_TEST_F(SleepGateTest, TheTabOnScreenStaysAwake) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  tabs::TabInterface* const tab = tabs()->GetActiveTab();
+  SleepAndSettle(tab);
+  EXPECT_FALSE(Slept(tab));
+}
+
+}  // namespace
