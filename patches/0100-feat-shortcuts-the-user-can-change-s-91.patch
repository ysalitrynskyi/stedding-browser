+  ASSERT_TRUE(second);
+  ASSERT_NO_FATAL_FAILURE(MoveToTheFreeChord("clear-space"));
+  BrowserWindowInterface* const third = CreateBrowser(browser()->GetProfile());
+  for (BrowserWindowInterface* window : {static_cast<BrowserWindowInterface*>(
+                                             browser()),
+                                         second, third}) {
+    EXPECT_EQ(shortcuts::ChordText(kFreeChord),
+              NamedChord(window, IDC_STEDDING_CLEAR_SPACE));
+    EXPECT_EQ(IDC_STEDDING_CLEAR_SPACE, CommandOn(window, kFreeChord));
+  }
