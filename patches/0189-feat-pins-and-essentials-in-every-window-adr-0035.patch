+// windows G13, G15: a window that has not yet followed a change made in
+// another window sends nothing of it back. A record removed there stays
+// removed, and a rename there stays.
+TEST_F(PinStoreTest, AWindowBehindSendsNothingBack) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
