+void ToolbarView::ApplySteddingFieldWidth() {
+  if (!location_bar_view_ || !stedding_left_spacer_ ||
+      !stedding_right_spacer_) {
+    return;
+  }
+  const int cap = stedding::LocationBarCap(stedding_field_width_.GetValue());
+  stedding_field_centred_ = cap > 0;
+  // The same order InitLayout gives the bar: it shrinks to its soft minimum
+  // first, and the spacers with it.
+  const int order =
+      base::FeatureList::IsEnabled(features::kOmniboxResizingPrioritization)
+          ? 1
+          : 1000 + 1;
+  if (stedding_field_centred_) {
+    // Cap the bar's width with a flex rule of its own. Left to itself it
+    // prefers the whole toolbar, so there is no leftover for the spacers to
+    // take and nothing to centre it in. Below the cap the rule defers to what
+    // the bar asks for, so a narrow window still shrinks it, never below its
+    // own minimum (toolbar T5, T18; the operator, 2026-09-05).
+    location_bar_view_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(
+            base::BindRepeating(
+                [](int cap, const views::View* view,
+                   const views::SizeBounds& bounds) {
+                  gfx::Size size = view->GetPreferredSize(bounds);
+                  size.set_width(stedding::LocationBarWidthForCap(
+                      size.width(), view->GetMinimumSize().width(),
+                      bounds.width().is_bounded()
+                          ? std::optional<int>(bounds.width().value())
+                          : std::nullopt,
+                      cap));
+                  return size;
+                },
+                cap))
+            .WithOrder(order));
+  } else {
+    // The whole row between the button clusters (toolbar T29); the address
+    // reads as centred on the page all the same (T18).
+    location_bar_view_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::LayoutOrientation::kHorizontal,
+                                 views::MinimumFlexSizeRule::kScaleToMinimum,
+                                 views::MaximumFlexSizeRule::kUnbounded)
+            .WithOrder(order));
+  }
+  stedding_left_spacer_->SetVisible(stedding_field_centred_);
+  stedding_right_spacer_->SetVisible(stedding_field_centred_);
+  // A centred bar gathers its contents on its own middle, which is the
+  // page's once Layout has placed it there.
+  location_bar_view_->ClearSteddingCentre();
+  InvalidateLayout();
+}
