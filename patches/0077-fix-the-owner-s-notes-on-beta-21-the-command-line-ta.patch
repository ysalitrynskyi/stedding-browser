+std::u16string LittlePromoteButton::TooltipText() const {
+  std::u16string text =
+      l10n_util::GetStringUTF16(IDS_STEDDING_LITTLE_OPEN_IN_TOOLTIP);
+  // Cmd-O is Open File's chord, which moves the page in a little window
+  // (little E2); as the menus print it.
+  ui::Accelerator chord;
+  if (BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser_);
+      view && view->GetWidget() &&
+      view->GetAcceleratorForCommandId(IDC_OPEN_FILE, &chord)) {
+    base::StrAppend(&text, {u" (", chord.GetShortcutText(), u")"});
