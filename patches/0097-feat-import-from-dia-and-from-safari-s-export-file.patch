+std::string SealOnWindows(std::string_view plain,
+                          const std::vector<uint8_t>& key,
+                          std::string_view prefix) {
+  std::vector<uint8_t> nonce(
+      crypto::aead::NonceSizeFor(crypto::aead::AES_256_GCM), 3);
+  const std::vector<uint8_t> body =
+      crypto::aead::Seal(crypto::aead::AES_256_GCM, key,
+                         base::as_byte_span(plain), nonce,
+                         base::span<const uint8_t>());
+  std::string sealed(prefix);
+  sealed.append(nonce.begin(), nonce.end());
+  sealed.append(body.begin(), body.end());
+  return sealed;
+}
+
+// A Login Data file of `sealed` values, one site each, and `blocked_rows`
+// sites the user blocked.
+void WriteLogins(const base::FilePath& file,
+                 const std::vector<std::string>& sealed_values,
+                 int blocked_rows = 0) {
+  sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                   sql::Database::Tag("Test"));
+  ASSERT_TRUE(db.Open(file));
+  ASSERT_TRUE(db.Execute(
+      "CREATE TABLE logins(origin_url VARCHAR NOT NULL, action_url VARCHAR, "
+      "username_element VARCHAR, username_value VARCHAR, password_element "
+      "VARCHAR, password_value BLOB, signon_realm VARCHAR NOT NULL, "
+      "date_created INTEGER NOT NULL, blacklisted_by_user INTEGER NOT NULL, "
+      "scheme INTEGER NOT NULL, date_last_used INTEGER NOT NULL DEFAULT 0, "
+      "date_password_modified INTEGER NOT NULL DEFAULT 0)"));
+  int index = 0;
+  const auto insert = [&db, &index](const std::string& sealed, int blocked) {
+    const std::string origin =
+        "https://site" + std::to_string(++index) + ".example/";
+    sql::Statement s(db.GetUniqueStatement(
+        "INSERT INTO logins VALUES (?, ?, 'user', ?, 'pass', ?, ?, 0, ?, 0, "
+        "0, 0)"));
+    s.BindString(0, origin);
+    s.BindString(1, origin);
+    s.BindString(2, blocked ? "" : "ann");
+    s.BindBlob(3, base::as_byte_span(sealed));
+    s.BindString(4, origin);
+    s.BindInt(5, blocked);
+    ASSERT_TRUE(s.Run());
+  };
+  for (const std::string& sealed : sealed_values) {
+    insert(sealed, 0);
+  }
+  for (int i = 0; i < blocked_rows; ++i) {
+    insert(std::string(), 1);
+  }
+}
