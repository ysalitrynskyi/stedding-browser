diff --git a/chrome/test/stedding/settings_spaces_browsertest.cc b/chrome/test/stedding/settings_spaces_browsertest.cc
index 36e41584c77de..6cc0e6d674ede 100644
--- a/chrome/test/stedding/settings_spaces_browsertest.cc
+++ b/chrome/test/stedding/settings_spaces_browsertest.cc
@@ -1053,4 +1053,85 @@ IN_PROC_BROWSER_TEST_F(SettingsDarkPagesTest,
   })) << "a site clears the line";
 }
 
+// sessions S35, settings T29 (BACKLOG S-274, GitHub issue 8): "Give every new
+// Space its own session", through the page. Turned on, it asks whether the
+// Spaces that still share the session should have their own too, naming how
+// many and how many open pages would reload, and "Turn On for All" gives each
+// its own; a Space added while it is on starts with its own. Turned off, it
+// asks nothing, a new Space shares the session again, and the others keep
+// what they have.
+IN_PROC_BROWSER_TEST_F(SettingsSpacesTest, EveryNewSpaceCanHaveItsOwnSession) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_FALSE(prefs->GetBoolean(stedding::prefs::kSpacesOwnSession))
+      << "off by default";
+  // The page itself is in a Space with a session of its own already, so the
+  // answer reloads no page the test reads.
+  const spaces::SpaceId home = model->active_id();
+  model->SetSpaceIsolated(home, true);
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  const spaces::SpaceId mail = model->AddSpace("Mail", SK_ColorGREEN)->id();
+  ASSERT_FALSE(model->SpaceIsIsolated(work)) << "a new Space shares";
+  // Work holds one web page; Mail holds none.
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_TRUE(model->SetActiveSpace(home));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://settings/stedding")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  const auto run = [&](std::string_view body) {
+    return content::EvalJs(page, OnThePage(body));
+  };
+  const auto question_open = [&]() {
+    return run("const d = pick('#ownSessionDialog'); return !!d && d.open;")
+        .ExtractBool();
+  };
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return run("return !!pick('#spacesOwnSession');").ExtractBool();
+  })) << "the page has no such switch";
+
+  {
+    SCOPED_TRACE("turned on, it asks about the Spaces that share");
+    EXPECT_EQ("", run("pick('#spacesOwnSession').click(); return '';"));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return prefs->GetBoolean(stedding::prefs::kSpacesOwnSession);
+    }));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return question_open(); }))
+        << "no question for the Spaces that share";
+    const std::string body =
+        run("return pick('#ownSessionDialog .secondary').textContent.trim();")
+            .ExtractString();
+    EXPECT_NE(std::string::npos, body.find("2 Spaces still share")) << body;
+    EXPECT_NE(std::string::npos, body.find("One open page reloads")) << body;
+    EXPECT_EQ("", run("pick('#ownSessionDialog .action-button').click(); "
+                      "return '';"));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return model->SpaceIsIsolated(work) && model->SpaceIsIsolated(mail);
+    })) << "Turn On for All left a Space sharing";
+    EXPECT_FALSE(question_open());
+  }
+  {
+    SCOPED_TRACE("a Space added while it is on has its own session");
+    const spaces::SpaceId play = model->AddSpace("Play", SK_ColorRED)->id();
+    EXPECT_TRUE(model->SpaceIsIsolated(play));
+  }
+  {
+    SCOPED_TRACE("turned off, a new Space shares and the others stay");
+    EXPECT_EQ("", run("pick('#spacesOwnSession').click(); return '';"));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return !prefs->GetBoolean(stedding::prefs::kSpacesOwnSession);
+    }));
+    EXPECT_FALSE(question_open()) << "turning it off asked something";
+    const spaces::SpaceId later = model->AddSpace("Later", SK_ColorCYAN)->id();
+    EXPECT_FALSE(model->SpaceIsIsolated(later));
+    EXPECT_TRUE(model->SpaceIsIsolated(work) && model->SpaceIsIsolated(mail));
+  }
+}
