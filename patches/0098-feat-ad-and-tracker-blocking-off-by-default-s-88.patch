diff --git a/chrome/browser/ui/webui/settings/stedding_blocker_handler.cc b/chrome/browser/ui/webui/settings/stedding_blocker_handler.cc
new file mode 100644
index 0000000000000..0840d77f3018d
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/stedding_blocker_handler.cc
@@ -0,0 +1,160 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/stedding_blocker_handler.h"
+
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/i18n/time_formatting.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/blocker/blocker_rules.h"
+#include "chrome/browser/ui/stedding/dark_pages.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "content/public/browser/web_ui.h"
+
+namespace {
+
+std::u16string FormatTime(base::Time time) {
+  return time.is_null() ? std::u16string()
+                        : base::TimeFormatShortDateAndTime(time);
+}
+
+}  // namespace
+
+SteddingBlockerHandler::SteddingBlockerHandler(Profile* profile)
+    : profile_(profile->GetOriginalProfile()) {}
+
+SteddingBlockerHandler::~SteddingBlockerHandler() = default;
+
+void SteddingBlockerHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "steddingGetBlocker",
+      base::BindRepeating(&SteddingBlockerHandler::HandleGetBlocker,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingUpdateBlockerLists",
+      base::BindRepeating(&SteddingBlockerHandler::HandleUpdateBlockerLists,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingAddBlockerException",
+      base::BindRepeating(&SteddingBlockerHandler::HandleAddBlockerException,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingRemoveBlockerException",
+      base::BindRepeating(
+          &SteddingBlockerHandler::HandleRemoveBlockerException,
+          base::Unretained(this)));
+}
+
+void SteddingBlockerHandler::OnJavascriptAllowed() {
+  if (HostContentSettingsMap* const map =
+          HostContentSettingsMapFactory::GetForProfile(profile_);
+      map && !settings_observation_.IsObserving()) {
+    settings_observation_.Observe(map);
+  }
+  if (stedding::BlockerLists* const lists = stedding::BlockerLists::Get();
+      lists && !lists_observation_.IsObserving()) {
+    lists_observation_.Observe(lists);
+  }
+}
+
+void SteddingBlockerHandler::OnJavascriptDisallowed() {
+  settings_observation_.Reset();
+  lists_observation_.Reset();
+}
+
+void SteddingBlockerHandler::OnContentSettingChanged(
+    const ContentSettingsPattern& primary_pattern,
+    const ContentSettingsPattern& secondary_pattern,
+    ContentSettingsTypeSet content_type_set) {
+  // Bk9: a site turned off from the button or the command bar shows here at
+  // once.
+  if (content_type_set.Contains(ContentSettingsType::ADS) &&
+      IsJavascriptAllowed()) {
+    FireWebUIListener("stedding-blocker-changed", State());
+  }
+}
+
+void SteddingBlockerHandler::OnBlockerListsChanged() {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("stedding-blocker-changed", State());
+  }
+}
+
+base::DictValue SteddingBlockerHandler::State() const {
+  base::DictValue state;
+  const stedding::BlockerLists* const lists = stedding::BlockerLists::Get();
+  const stedding::BlockerLists::Status status =
+      lists ? lists->GetStatus() : stedding::BlockerLists::Status();
+  state.Set("busy", status.busy);
+  state.Set("hasRuleset", status.has_ruleset);
+  state.Set("updated", FormatTime(status.updated));
+  state.Set("urlRules", status.url_rules);
+  state.Set("skippedLines", status.skipped_lines);
+  base::ListValue list_rows;
+  for (const stedding::BlockerLists::ListStatus& list : status.lists) {
+    base::DictValue row;
+    row.Set("id", list.id);
+    row.Set("name", list.name);
+    row.Set("homepage", list.homepage);
+    row.Set("licence", list.licence);
+    row.Set("fetched", FormatTime(list.fetched));
+    row.Set("failing", list.failing);
+    list_rows.Append(std::move(row));
+  }
+  state.Set("lists", std::move(list_rows));
+  base::ListValue exceptions;
+  for (const ContentSettingsPattern& pattern :
+       stedding::GetBlockerExceptions(profile_)) {
+    base::DictValue entry;
+    entry.Set("name", stedding::DarkPagesSiteName(pattern));
+    entry.Set("pattern", pattern.ToString());
+    exceptions.Append(std::move(entry));
+  }
+  state.Set("exceptions", std::move(exceptions));
+  return state;
+}
+
+void SteddingBlockerHandler::HandleGetBlocker(const base::ListValue& args) {
+  if (args.size() != 1U) {
+    return;
+  }
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], State());
+}
+
+void SteddingBlockerHandler::HandleUpdateBlockerLists(
+    const base::ListValue& args) {
+  // Bk9: nothing while the switch is off (BlockerLists::UpdateNow).
+  if (stedding::BlockerLists* const lists = stedding::BlockerLists::Get()) {
+    lists->UpdateNow();
+  }
+}
+
+void SteddingBlockerHandler::HandleAddBlockerException(
+    const base::ListValue& args) {
+  if (args.size() != 2U || !args[1].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  // What is no site is refused and nothing is written; the page says so
+  // under the field.
+  const bool added =
+      stedding::AddBlockerException(profile_, args[1].GetString());
+  ResolveJavascriptCallback(args[0], base::Value(added));
+}
+
+void SteddingBlockerHandler::HandleRemoveBlockerException(
+    const base::ListValue& args) {
+  if (args.size() != 1U || !args[0].is_string()) {
+    return;
+  }
+  const ContentSettingsPattern pattern =
+      ContentSettingsPattern::FromString(args[0].GetString());
+  stedding::RemoveBlockerException(profile_, pattern);
+}
