+void TabStripModel::MoveTopLevelFolder(tabs::FolderTabCollection* folder,
+                                       size_t slot) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  CHECK(folder);
+  tabs::TabCollection* const top = contents_data_->unpinned_collection();
+  CHECK_EQ(folder->GetParentCollection(), top);
+  const std::optional<size_t> from = top->GetIndexOfCollection(folder);
+  CHECK(from.has_value());
+  CHECK_LT(slot, top->ChildCount());
+  if (*from == slot) {
+    return;
+  }
+  const int tab_count = static_cast<int>(folder->TabCountRecursive());
+  CHECK_GT(tab_count, 0);
+  const int first = GetIndexOfTab(folder->GetTabAtIndexRecursive(0));
+  std::vector<int> block;
+  block.reserve(static_cast<size_t>(tab_count));
+  for (int k = 0; k < tab_count; ++k) {
+    block.push_back(first + k);
+  }
+  // Where the folder's first tab lands: after the essentials and the tabs of
+  // the rows that come before `slot` once the folder has left its place.
+  int destination = IndexOfFirstNonPinnedTab();
+  size_t rows_before = 0;
+  for (const tabs::Child& child : top->GetChildren()) {
+    if (rows_before == slot) {
+      break;
+    }
+    if (RowIdentity(child) == folder) {
+      continue;
+    }
+    destination += static_cast<int>(TabCountOfRow(child));
+    ++rows_before;
+  }
+  MoveTabsWithNotifications(
+      std::move(block), destination,
+      base::BindOnce(&tabs::TabStripCollection::MoveTopLevelFolder,
+                     base::Unretained(contents_data_.get()), folder, slot));
+}
