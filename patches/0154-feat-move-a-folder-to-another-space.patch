+void FolderView::MoveToSpace(spaces::SpaceId space) {
+  tabs::FolderTabCollection* const f = folder();
+  BrowserWindowInterface* const window = GetBrowserWindow();
+  TabStripModel* const strip = window ? window->GetTabStripModel() : nullptr;
+  spaces::SpaceModel* const space_model =
+      window ? spaces::SpaceModel::From(window) : nullptr;
+  if (!f || !strip || !space_model) {
+    return;
+  }
+  // The window follows, as it does for a tab (menus M1, spaces B12), and a tab
+  // of the folder on screen stays there.
+  tabs::TabInterface* const active = strip->GetActiveTab();
+  tabs::TabInterface* const show =
+      std::ranges::contains(f->GetTabsRecursive(), active) ? active : nullptr;
+  // A nested folder's view can go with the move: nothing below uses `this`.
+  space_model->MoveFolderToSpace(f, space);
+  space_model->SetActiveSpace(space, show);
+}
