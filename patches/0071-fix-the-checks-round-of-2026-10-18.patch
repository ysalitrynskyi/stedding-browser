+        BrowserView::GetBrowserViewForBrowser(window)->GetWidget());
+  }
+
+  // The menu of `space`'s chip in `window`'s sidebar, as a right click on
+  // the chip opens it.
+  static ui::SimpleMenuModel* SpaceMenu(BrowserWindowInterface* window,
+                                        const spaces::SpaceId& space) {
+    views::Widget* const widget =
+        BrowserView::GetBrowserViewForBrowser(window)->GetWidget();
+    views::test::RunScheduledLayout(widget);
+    spaces::SpaceSwitcherView* const switcher =
+        stedding::test::FindDrawnSwitcher(widget->GetRootView());
+    return switcher ? switcher->BuildMenuForTesting(space) : nullptr;
+  }
+
+  static std::optional<size_t> RowOf(ui::SimpleMenuModel* menu,
+                                     const std::u16string& label) {
+    for (size_t i = 0; menu && i < menu->GetItemCount(); ++i) {
+      if (menu->GetLabelAt(i) == label) {
+        return i;
+      }
+    }
+    return std::nullopt;
+  }
+
+  // Runs the row `label` of `space`'s menu in this window and answers the
+  // question it asks with the button that goes ahead. Returns the question's
+  // title, empty when none was asked.
+  std::u16string RunAndConfirm(const spaces::SpaceId& space,
+                               const std::u16string& label) {
+    ui::SimpleMenuModel* const menu = SpaceMenu(browser(), space);
+    EXPECT_TRUE(menu) << "the sidebar has no Space switcher";
+    const std::optional<size_t> row = RowOf(menu, label);
+    EXPECT_TRUE(row.has_value()) << "the menu has no such row";
+    if (!menu || !row) {
+      return std::u16string();
+    }
+    EXPECT_TRUE(menu->IsEnabledAt(*row)) << "the row is disabled";
+    views::Widget* question = nullptr;
+    views::AnyWidgetObserver shown(views::test::AnyWidgetTestPasskey{});
+    shown.set_shown_callback(
+        base::BindLambdaForTesting([&question](views::Widget* widget) {
+          views::WidgetDelegate* const delegate = widget->widget_delegate();
+          if (delegate && delegate->AsDialogDelegate() &&
+              delegate->GetModalType() == ui::mojom::ModalType::kWindow) {
+            question = widget;
+          }
+        }));
+    menu->ActivatedAt(*row);
+    EXPECT_TRUE(base::test::RunUntil([&]() { return question != nullptr; }))
+        << "the row asked nothing";
+    if (!question) {
+      return std::u16string();
+    }
+    const std::u16string title = question->widget_delegate()->GetWindowTitle();
+    views::test::AcceptDialog(question);
+    return title;
+  }
+
+  // Whether `window`'s actions mode lists a row whose title starts with
+  // `title`.
+  static bool ListedInTheBar(BrowserWindowInterface* window,
+                             const std::u16string& title) {
+    chrome::ExecuteCommand(window, IDC_STEDDING_COMMAND_PALETTE);  // ⇧⌘P
