+
+bool CommandBarView::ActiveTabIsUntouchedNewTab() const {
+  // K21: a New Tab page with nothing behind it and nothing loading -- the
+  // first window's, or one "+ New Tab" made -- takes what the bar opens, as
+  // Arc's does. The bar opened a second tab beside it and left the empty one
+  // in the list (S-78). A pinned tab keeps its page, wherever it is pinned.
+  TabStripModel* const tabs = browser_->GetTabStripModel();
+  if (!tabs || tabs->active_index() == TabStripModel::kNoTab ||
+      tabs->IsTabPinned(tabs->active_index())) {
+    return false;
+  }
+  const spaces::SpaceModel* const spaces = spaces::SpaceModel::From(browser_);
+  if (spaces && spaces->IsSpacePinned(tabs->GetActiveTab())) {
+    return false;
+  }
+  content::WebContents* const contents = tabs->GetActiveWebContents();
+  if (!contents) {
+    return false;
+  }
+  content::NavigationController& history = contents->GetController();
+  return history.GetEntryCount() <= 1 && !history.GetPendingEntry() &&
+         contents->GetVisibleURL() == GURL(chrome::kChromeUINewTabURL);
 }
 
