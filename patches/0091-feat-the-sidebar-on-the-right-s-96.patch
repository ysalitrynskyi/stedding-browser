+bool VerticalTabStripRegionView::IsAtTrailingEdge() const {
+  if (!base::FeatureList::IsEnabled(stedding::kArcStyleWindow) ||
+      !browser_view()) {
+    return false;
+  }
+  const BrowserWindowInterface* const browser =
+      static_cast<const BrowserView*>(browser_view())->browser();
+  const Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  if (!profile) {
+    return false;
+  }
+  // sidebar Y34: the choice is the side on screen; the layout places the
+  // strip by the language's reading direction, so the two together say
+  // which logical edge it takes.
+  return profile->GetOriginalProfile()->GetPrefs()->GetBoolean(
+             stedding::prefs::kSidebarOnRight) != base::i18n::IsRTL();
+}
+
+bool VerticalTabStripRegionView::IsOnRight() const {
+  return base::i18n::IsRTL() != IsAtTrailingEdge();
+}
