+TEST(SpaceQueryTest, AtSpacePrefixFiltersOpenAndArchived) {
+  const SpaceQuery plain = ParseSpaceQuery(u"rust");
+  EXPECT_FALSE(plain.space_prefix);
+  EXPECT_EQ(u"rust", plain.rest);
+
+  const SpaceQuery only = ParseSpaceQuery(u"@Work");
+  ASSERT_TRUE(only.space_prefix);
+  EXPECT_EQ(u"Work", *only.space_prefix);
+  EXPECT_TRUE(only.rest.empty());
+
+  const SpaceQuery both = ParseSpaceQuery(u"@Work rust iterators");
+  ASSERT_TRUE(both.space_prefix);
+  EXPECT_EQ(u"Work", *both.space_prefix);
+  EXPECT_EQ(u"rust iterators", both.rest);
+
+  EXPECT_TRUE(SpaceNameMatchesPrefix(u"Work", u"wo"));
+  EXPECT_FALSE(SpaceNameMatchesPrefix(u"Home", u"Work"));
+}
