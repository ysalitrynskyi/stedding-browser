diff --git a/chrome/browser/ui/spaces/space_model.cc b/chrome/browser/ui/spaces/space_model.cc
index 815ec87bf0909..1c24fef0d4498 100644
--- a/chrome/browser/ui/spaces/space_model.cc
+++ b/chrome/browser/ui/spaces/space_model.cc
@@ -2183,13 +2183,9 @@ bool SpaceModel::CycleRecent(int delta) {
     position += n;
   }
   cycle_->position = static_cast<size_t>(position);
-  const int index =
-      tab_strip_model_->GetIndexOfTab(cycle_->tabs[cycle_->position].Get());
-  if (index != TabStripModel::kNoTab) {
-    tab_strip_model_->ActivateTabAt(
-        index, TabStripUserGestureDetails(
-                   TabStripUserGestureDetails::GestureType::kKeyboard));
-  }
+  // switcher X3 (GitHub issue 123, BACKLOG S-547): a step moves the strip's
+  // highlight, and the tab changes when the run ends (EndCycle), as in Arc,
+  // so the pages stepped past do not flash by. A tap is a step and an end.
   return true;
 }
 
@@ -2197,10 +2193,25 @@ void SpaceModel::EndCycle() {
   if (!cycle_) {
     return;
   }
+  tabs::TabInterface* const reached =
+      cycle_->position < cycle_->tabs.size()
+          ? cycle_->tabs[cycle_->position].Get()
+          : nullptr;
   cycle_.reset();
-  if (tab_strip_model_) {
-    RecordActivation(tab_strip_model_->GetActiveTab());
+  if (!tab_strip_model_) {
+    return;
+  }
+  // The tab the run reached (switcher X3), if it is still there.
+  if (reached) {
+    const int index = tab_strip_model_->GetIndexOfTab(reached);
+    if (index != TabStripModel::kNoTab &&
+        index != tab_strip_model_->active_index()) {
+      tab_strip_model_->ActivateTabAt(
+          index, TabStripUserGestureDetails(
+                     TabStripUserGestureDetails::GestureType::kKeyboard));
+    }
   }
+  RecordActivation(tab_strip_model_->GetActiveTab());
 }
 
 void SpaceModel::CancelCycle() {
diff --git a/chrome/browser/ui/spaces/space_model.h b/chrome/browser/ui/spaces/space_model.h
index 1ecc923d64dfe..95f256df5c902 100644
--- a/chrome/browser/ui/spaces/space_model.h
+++ b/chrome/browser/ui/spaces/space_model.h
@@ -355,8 +355,9 @@ class SpaceModel : public TabStripModelObserver,
   // switcher X1, X2: Ctrl-Tab. The first call of a run starts it: the recent
   // list of the active Space freezes so a held Ctrl walks it -- one step is
   // the previous tab, the next the one before that, wrapping -- and `delta`
-  // moves the position. EndCycle() commits the run: the tab the user is on
-  // becomes the most recent. CancelCycle() goes back to the tab the run
+  // moves the position; the tab on screen stays until the run ends (switcher
+  // X3, BACKLOG S-547). EndCycle() commits the run: the tab it reached is
+  // shown and becomes the most recent. CancelCycle() leaves the tab the run
   // started on. False without a window or with fewer than two tabs to walk.
   bool CycleRecent(int delta);
   void EndCycle();
