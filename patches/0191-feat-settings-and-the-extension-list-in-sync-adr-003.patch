+// Sf63, Sf64, Sf65: the other computer's extension is offered, named, with
+// the computer that has it. The offer installs nothing; Install goes through
+// Chromium's own Web Store confirmation, and only its yes installs. Once
+// installed it is offered no more, and it is a Web Store install, so this
+// computer's own list carries it in turn.
+IN_PROC_BROWSER_TEST_F(
+    SidebarSyncExtensionsTest,
+    AnExtensionIsOfferedAndInstalledOnlyAfterTheConfirmation) {
+  ASSERT_NO_FATAL_FAILURE(WritePeer(1, TheList()));
+  ASSERT_NO_FATAL_FAILURE(Join());
+  ASSERT_NO_FATAL_FAILURE(Scan());
+
+  ASSERT_TRUE(base::test::RunUntil([&] { return Offered(kExtensionId); }));
+  {
+    SCOPED_TRACE("the offer names the extension and the computer");
+    const std::optional<base::DictValue> offer = Offer(kExtensionId);
+    ASSERT_TRUE(offer);
+    ASSERT_TRUE(offer->FindString("name"));
+    EXPECT_EQ(kExtensionName, *offer->FindString("name"));
+    const base::ListValue* const devices = offer->FindList("devices");
+    ASSERT_TRUE(devices);
+    ASSERT_EQ(1u, devices->size());
+    ASSERT_TRUE((*devices)[0].is_string());
+    EXPECT_EQ(kPeerDevice, (*devices)[0].GetString());
+  }
+  EXPECT_FALSE(Installed(kExtensionId)) << "installed before the confirmation";
+  // Sf64: a bar once for the new offer, not again at the next read.
+  EXPECT_EQ(1, stedding::SyncedExtensionsBarsShownForTesting());
+  EXPECT_EQ(u"Office PC has an extension this computer does not have.",
+            stedding::SyncedExtensionsBarTextForTesting());
+  ASSERT_NO_FATAL_FAILURE(WritePeer(2, TheList()));
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  EXPECT_EQ(1, stedding::SyncedExtensionsBarsShownForTesting());
+
+  AutoAcceptInstall();
+  ASSERT_NO_FATAL_FAILURE(PressInstall(kExtensionId));
+  ASSERT_TRUE(base::test::RunUntil([&] { return Enabled(kExtensionId); }));
+  const extensions::Extension* const installed =
+      registry()->enabled_extensions().GetByID(kExtensionId);
+  ASSERT_TRUE(installed);
+  EXPECT_TRUE(sb::IsWebStoreExtension(*installed));
+  EXPECT_TRUE(base::test::RunUntil([&] { return !Offered(kExtensionId); }));
+  // Sf63: this computer's own list carries it in turn.
+  EXPECT_TRUE(base::test::RunUntil([&] { return OwnListHas(kExtensionId); }));
+}
