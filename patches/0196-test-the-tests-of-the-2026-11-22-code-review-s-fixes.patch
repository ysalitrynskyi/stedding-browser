+// P36-1a, peek P20: a page in a peek over the page opens no new tab and no
+// popup the user did not ask for, as in a tab, where the popup blocker stops
+// them; one the user's click opens still opens in the window. The window's
+// popup blocker is a tab's, and missed the peek's page, which is in no tab:
+// a script on a timer opened as many tabs and windows as it liked.
+IN_PROC_BROWSER_TEST_F(PeekOverPageB27Test,
+                       APeeksPageOpensNoPopupWithoutAClick) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  const int count = tabs().count();
+  const int windows = WindowCountB27();
+
+  // With no click behind them, as a timer runs them: a new tab, a popup.
+  ASSERT_TRUE(content::ExecJs(page,
+                              "window.open('/title2.html');"
+                              "window.open('/title1.html', '', 'popup');",
+                              content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+  // Then one the user's click opens. Once its tab is in, the page's earlier
+  // requests have been answered too.
+  const GURL clicked = Url("b.test", "/title2.html?clicked");
+  ASSERT_TRUE(content::ExecJs(
+      page, content::JsReplace("window.open($1);", clicked.spec())));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    for (int i = 0; i < tabs().count(); ++i) {
+      if (tabs().GetWebContentsAt(i)->GetVisibleURL() == clicked) {
+        return true;
+      }
+    }
+    return false;
+  })) << "the user's own window.open opened nothing";
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(count + 1, tabs().count())
+      << "a tab opened with no click behind it";
+  EXPECT_EQ(windows, WindowCountB27())
+      << "a popup opened with no click behind it";
+}
