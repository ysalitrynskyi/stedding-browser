+// Lt9: an essentials split is one card of two panes. While it is on screen
+// its local pane wears the tape inside the card's edge, which it leaves
+// unpainted, round the pane's own rounded shape: along all four of its
+// edges, not in its middle, and within the shape the pane is clipped to, so
+// no stretch of the line is cut away. The other pane wears none, nor does
+// the split in the background.
+IN_PROC_BROWSER_TEST_F(LocalTabsTest, AnEssentialSplitTapesItsLocalPane) {
+  tabs::TabInterface* const local = Open(Local());
+  tab_strip_model()->SetTabPinned(IndexOf(local), true);
+  tabs::TabInterface* const site = Open(Site());
+  tab_strip_model()->ActivateTabAt(IndexOf(local));
+  tab_strip_model()->AddToNewSplit(
+      {IndexOf(site)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(local->IsSplit());
+  ASSERT_TRUE(site->IsPinned()) << "the split takes the card's place";
+
+  TabView* const pane = Row(local);
+  ASSERT_TRUE(pane);
+  const views::View* const card = pane->parent();
+  ASSERT_TRUE(views::IsViewClass<SplitTabView>(card)) << "one card";
+  EXPECT_TRUE(pane->WearsLocalTapeForTesting());
+  EXPECT_FALSE(Taped(site));
+  EXPECT_EQ(1, TapedRows());
+  EXPECT_EQ(u"", HostLineOf(local)) << "a card has no title";
+  // Upstream lays an essentials split's panes over the card's 1 DIP edge
+  // and gives each pane insets of the edge's width (TabView::UpdateBorder).
+  // The card draws no edge now (tabs R32) and keeps its insets, so it is
+  // the pane's inside, and with it the tape, that lies inside the card's
+  // insets.
+  EXPECT_FALSE(BorderPaints(const_cast<views::View*>(card)))
+      << "the merged card has no edge (tabs R32)";
+  const gfx::Insets insets = pane->GetInsets();
+  ASSERT_GT(insets.top(), 0) << "the pane's insets keep the card's";
+  gfx::Rect inside = pane->bounds();
+  inside.Inset(insets);
+  EXPECT_TRUE(card->GetContentsBounds().Contains(inside))
+      << "the pane's inside " << inside.ToString() << " within the card's "
+      << card->GetContentsBounds().ToString();
+
+  gfx::Canvas canvas(pane->size(), 1.0f, /*is_opaque=*/false);
+  pane->PaintLocalTapeForTesting(&canvas);
+  const SkBitmap& drawn = canvas.GetBitmap();
+  const int width = drawn.width();
+  const int height = drawn.height();
+  ASSERT_GT(width, 8);
+  ASSERT_GT(height, 8);
+  const auto alpha = [&](int x, int y) {
+    return SkColorGetA(drawn.getColor(x, y));
+  };
+  // The shape the pane is clipped to, a rounded rectangle, and the band the
+  // line may cover inside it: the pane's insets, which it leaves to the
+  // card's edge, then the 2 DIP stroke and a pixel for anti-aliasing.
+  const SkPath& shape = pane->clip_path();
+  SkRRect clip;
+  ASSERT_TRUE(shape.isRRect(&clip)) << "the pane is clipped to its shape";
+  const float band = insets.top() + stedding::kLocalTapeStroke + 1;
+  SkRRect inner;
+  clip.inset(band, band, &inner);
+  const std::string geometry = base::StrCat(
+      {"pane ", pane->bounds().ToString(), ", insets ", insets.ToString(),
+       ", clip ", gfx::SkRectToRectF(clip.rect()).ToString(), " radius ",
+       base::NumberToString(clip.getSimpleRadii().x())});
+
+  // Each edge's middle half, on the 2 DIP line just inside the insets.
+  bool top = false;
+  bool bottom = false;
+  bool left = false;
+  bool right = false;
+  for (int x = width / 4; x < 3 * width / 4; ++x) {
+    top |= alpha(x, insets.top()) > 0 || alpha(x, insets.top() + 1) > 0;
+    bottom |= alpha(x, height - 1 - insets.bottom()) > 0 ||
+              alpha(x, height - 2 - insets.bottom()) > 0;
+  }
+  for (int y = height / 4; y < 3 * height / 4; ++y) {
+    left |= alpha(insets.left(), y) > 0 || alpha(insets.left() + 1, y) > 0;
+    right |= alpha(width - 1 - insets.right(), y) > 0 ||
+             alpha(width - 2 - insets.right(), y) > 0;
+  }
+  EXPECT_TRUE(top && bottom && left && right)
+      << "top " << top << ", bottom " << bottom << ", left " << left
+      << ", right " << right << "; " << geometry;
+  // The first few pixels that break a rule, to see where.
+  std::vector<std::string> on_the_edge;
+  std::vector<std::string> middle;
+  std::vector<std::string> outside_the_shape;
+  const auto note = [&](std::vector<std::string>& list, int x, int y) {
+    if (list.size() < 6) {
+      list.push_back(base::StrCat({base::NumberToString(x), ",",
+                                   base::NumberToString(y), " alpha ",
+                                   base::NumberToString(alpha(x, y))}));
+    }
+  };
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x) {
+      const SkPoint centre = SkPoint::Make(x + 0.5f, y + 0.5f);
+      if ((x < insets.left() || x >= width - insets.right() ||
+           y < insets.top() || y >= height - insets.bottom()) &&
+          alpha(x, y) > 0) {
+        note(on_the_edge, x, y);
+      }
+      if (inner.contains(centre) && alpha(x, y) > 0) {
+        note(middle, x, y);
+      }
+      // A pixel the line mostly covers has its centre in the shape.
+      if (alpha(x, y) >= 0xC0 && !clip.contains(centre)) {
+        note(outside_the_shape, x, y);
+      }
+    }
+  }
+  EXPECT_TRUE(on_the_edge.empty())
+      << "the card keeps its edge: " << base::JoinString(on_the_edge, "; ")
+      << "; " << geometry;
+  EXPECT_TRUE(middle.empty()) << "a line round the pane: "
+                              << base::JoinString(middle, "; ") << "; "
+                              << geometry;
+  EXPECT_TRUE(outside_the_shape.empty())
+      << "the pane's clip would cut the line: "
+      << base::JoinString(outside_the_shape, "; ") << "; " << geometry;
+  EXPECT_EQ(0u, alpha(insets.left(), insets.top())) << "the corners are round";
+
+  Open(Site("/title3.html"));
+  EXPECT_EQ(0, TapedRows()) << "the split in the background";
+}
