From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Tue, 1 Sep 2026 19:17:14 -0400
Subject: ui: stop advertising Google sign-in in the toolbar

The sign-in promo is off by default.

A fresh profile searches with DuckDuckGo rather than Google. That one default
is also what keeps the new tab page local -- a non-Google default routes
chrome://newtab to Chromium's third-party page -- and keeps Google's AI Mode
entry points out of the omnibox. docs/PRIVACY.md wants a first-run chooser;
until it exists, this is the default it would preselect.

Why: the default contradicts a stated product principle, and it was the
single most prominent non-Arc element left in the window.
Removable when: upstream stops enabling the promo by default, or Stedding grows
its own onboarding that makes the question ours to ask.
---
 components/search_engines/template_url_prepopulate_data.cc | 7 ++++++-
 components/signin/public/base/signin_switches.cc           | 5 ++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/components/search_engines/template_url_prepopulate_data.cc b/components/search_engines/template_url_prepopulate_data.cc
index fbc685a198ab8..7e811c63e0e45 100644
--- a/components/search_engines/template_url_prepopulate_data.cc
+++ b/components/search_engines/template_url_prepopulate_data.cc
@@ -307,8 +307,13 @@ std::unique_ptr<TemplateURLData> GetPrepopulatedFallbackSearch(
     PrefService& prefs,
     const std::vector<raw_ptr<const PrepopulatedEngine>>&
         regional_prepopulated_engines) {
+  // Stedding: a fresh profile searches with DuckDuckGo, not Google. This is
+  // also what keeps the new tab page local (a non-Google default routes
+  // chrome://newtab to the third-party page) and keeps Google's AI Mode entry
+  // points out of the omnibox. docs/PRIVACY.md wants a first-run chooser; until
+  // it exists, this is the default it would preselect.
   return FindPrepopulatedEngineInternal(prefs, regional_prepopulated_engines,
-                                        google.id,
+                                        duckduckgo.id,
                                         /*use_first_as_fallback=*/true);
 }
 
diff --git a/components/signin/public/base/signin_switches.cc b/components/signin/public/base/signin_switches.cc
index 775f70052cc76..d142690a910f3 100644
--- a/components/signin/public/base/signin_switches.cc
+++ b/components/signin/public/base/signin_switches.cc
@@ -842,7 +842,10 @@ BASE_FEATURE(kSignInPromoMaterialNextUI, base::FEATURE_ENABLED_BY_DEFAULT);
 #endif  // BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX)
 
 #if BUILDFLAG(ENABLE_DICE_SUPPORT)
-BASE_FEATURE(kSigninPromoOnAvatarPill, base::FEATURE_ENABLED_BY_DEFAULT);
+// Stedding does not advertise Google sign-in. The pill is a promotion, not a
+// control: signing in stays available from the profile menu, and everything
+// that depends on it works unchanged. See docs/PRIVACY.md.
+BASE_FEATURE(kSigninPromoOnAvatarPill, base::FEATURE_DISABLED_BY_DEFAULT);
 BASE_FEATURE_PARAM(base::TimeDelta,
                    kSigninPromoOnAvatarPillStartupDelayForPromoShow,
                    &kSigninPromoOnAvatarPill,
