+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest,
+                       TheFirstLaunchMergesEveryWindowsPins) {
+  ASSERT_TRUE(base::test::RunUntil([&] { return Store().ready(); }))
+      << "the store was never filled";
+  ASSERT_EQ(3u, Store().records().size());
+  // The test server's port is new after a restart: the path is the page.
+  const std::set<std::string> want = {"/title1.html", "/title2.html",
+                                      "/title3.html"};
+  ASSERT_EQ(2u, Windows(browser()->GetProfile()).size());
+  for (BrowserWindowInterface* window : Windows(browser()->GetProfile())) {
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return Pins(window).size() == 3u; }))
+        << "a window lacks a pin the other had, or has one twice";
+    std::set<std::string> paths;
+    for (const GURL& home : HomesOf(window, Pins(window))) {
+      paths.insert(std::string(home.path()));
+    }
+    EXPECT_EQ(want, paths);
+  }
+}
