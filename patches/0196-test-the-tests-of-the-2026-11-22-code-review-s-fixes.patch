+// The AccountBookmarks file a Chromium keeps beside it for a user signed in
+// to it who keeps bookmarks in the account, in the same form: a page in
+// Other bookmarks, and the device's page in the same place, which both files
+// may hold.
+constexpr char kAccountBookmarksB10[] = R"json({
+  "roots": {
+    "bookmark_bar": {"type": "folder", "name": "Bookmarks bar", "children": [
+      {"type": "url", "name": "Device", "url": "https://device.example/"}
+    ]},
+    "other": {"type": "folder", "name": "Other bookmarks", "children": [
+      {"type": "url", "name": "Account", "url": "https://account.example/"}
+    ]}
+  },
+  "version": 1
+})json";
+
+// Dia's Default profile under a home the test owns, where the importer looks
+// for it (import I28), with both bookmarks files.
+class AccountBookmarksB10Test : public testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_TRUE(home_.CreateUniqueTempDir());
+#if BUILDFLAG(IS_WIN)
+    home_override_ = std::make_unique<base::ScopedPathOverride>(
+        base::DIR_LOCAL_APP_DATA, home_.GetPath());
+    const base::FilePath user_data =
+        home_.GetPath().AppendASCII("Dia").AppendASCII("User Data");
+#else
+    home_override_ = std::make_unique<base::ScopedPathOverride>(
+        base::DIR_HOME, home_.GetPath());
+    const base::FilePath user_data = home_.GetPath()
+                                         .AppendASCII("Library")
+                                         .AppendASCII("Application Support")
+                                         .AppendASCII("Dia")
+                                         .AppendASCII("User Data");
+#endif
+    const base::FilePath profile = user_data.AppendASCII("Default");
+    ASSERT_TRUE(base::CreateDirectory(profile));
+    ASSERT_TRUE(
+        base::WriteFile(profile.AppendASCII("Bookmarks"), kDeviceBookmarksB10));
+    ASSERT_TRUE(base::WriteFile(profile.AppendASCII("AccountBookmarks"),
+                                kAccountBookmarksB10));
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  base::ScopedTempDir home_;
+  std::unique_ptr<base::ScopedPathOverride> home_override_;
+};
+
+// P11-1b, import I29, I32: the welcome flow's summary counts the bookmarks
+// kept in the account as well as those kept on the device, a page both
+// files hold once. It counted the device's file alone.
+TEST_F(AccountBookmarksB10Test, TheSummaryCountsTheAccountsBookmarks) {
+  base::test::TestFuture<ChromiumFamilyInfo> info;
+  LoadChromiumFamilyInfo(kDiaSource, info.GetCallback());
+  ASSERT_TRUE(info.Get().found);
+  ASSERT_EQ(1u, info.Get().profiles.size());
+  EXPECT_EQ(2u, info.Get().profiles[0].bookmarks)
+      << "the account's bookmarks were not counted";
+}
+
+// P11-1b, import I29: "Move everything" brings the account's bookmarks in
+// with the device's, a page both files hold once, so nothing is said to be
+// there already. None of the account's came over, and the result line said
+// nothing was left.
+TEST_F(AccountBookmarksB10Test, TheImportBringsTheAccountsBookmarks) {
+  TestingProfile::Builder builder;
+  builder.AddTestingFactory(BookmarkModelFactory::GetInstance(),
+                            BookmarkModelFactory::GetDefaultFactory());
+  std::unique_ptr<TestingProfile> profile = builder.Build();
+
+  ChromiumProfile source_profile;
+  source_profile.dir = base::FilePath(FILE_PATH_LITERAL("Default"));
+  source_profile.name = u"Default";
+  source_profile.last_used = true;
+  ChromiumFamilyParts parts;
+  parts.history = false;
+  parts.passwords = false;
+  base::test::TestFuture<ChromiumFamilyResult> done;
+  ImportChromiumFamilyAsync(*profile, kDiaSource, source_profile, parts,
+                            done.GetCallback());
+  const ChromiumFamilyResult result = done.Get();
+  EXPECT_FALSE(result.not_found);
+  EXPECT_EQ(2u, result.bookmarks) << "the account's bookmarks stayed behind";
+  EXPECT_EQ(0u, result.bookmarks_already);
+  EXPECT_FALSE(result.bookmarks_unreadable);
+
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(profile.get());
+  ASSERT_TRUE(model);
+  bookmarks::test::WaitForBookmarkModelToLoad(model);
+  EXPECT_TRUE(model->IsBookmarked(GURL("https://device.example/")));
+  EXPECT_TRUE(model->IsBookmarked(GURL("https://account.example/")));
+}
+
+#endif  // BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
