From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Fri, 6 Nov 2026 23:53:20 -0500
Subject: fix: the command bar's Move Tab row takes the selection

It moved the active tab alone, while every other row of the bar acts on the
selection the bar was opened with.

Why: S-127 (tabs R22).

Removable when: the bar's rows stop taking the selection.
---
 .../ui/views/commandbar/command_bar_view.cc   | 12 ++++++--
 .../commandbar/command_bar_view_unittest.cc   | 28 +++++++++++++++++++
 2 files changed, 38 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/ui/views/commandbar/command_bar_view.cc b/chrome/browser/ui/views/commandbar/command_bar_view.cc
index e46430daa97ef..a41b353504ea9 100644
--- a/chrome/browser/ui/views/commandbar/command_bar_view.cc
+++ b/chrome/browser/ui/views/commandbar/command_bar_view.cc
@@ -865,8 +865,16 @@ void CommandBarView::BuildActions() {
              base::BindRepeating(
                  [](spaces::SpaceModel* model, TabStripModel* strip,
                     spaces::SpaceId id) {
-                   if (tabs::TabInterface* const tab = strip->GetActiveTab()) {
-                     model->MoveTabsToSpace({tab}, id);
+                   // tabs R22 (BACKLOG S-127): the selection, as the bar's
+                   // other rows take it.
+                   std::vector<tabs::TabInterface*> selected;
+                   for (int i = 0; i < strip->count(); ++i) {
+                     if (strip->IsTabSelected(i)) {
+                       selected.push_back(strip->GetTabAtIndex(i));
+                     }
+                   }
+                   if (!selected.empty()) {
+                     model->MoveTabsToSpace(selected, id);
                      model->SetActiveSpace(id);
                    }
                  },
diff --git a/chrome/browser/ui/views/commandbar/command_bar_view_unittest.cc b/chrome/browser/ui/views/commandbar/command_bar_view_unittest.cc
index c03a698093279..6b6bc09661e74 100644
--- a/chrome/browser/ui/views/commandbar/command_bar_view_unittest.cc
+++ b/chrome/browser/ui/views/commandbar/command_bar_view_unittest.cc
@@ -599,6 +599,34 @@ TEST_F(CommandBarViewTest, ASuggestionAlwaysShowsTheAddressItOpens) {
   EXPECT_EQ(2u, found);
 }
 
+// tabs R22 (BACKLOG S-127): a Move Tab row takes the selection, as the bar's
+// other rows do, and leaves the rest of the Space where it is.
+TEST_F(CommandBarViewTest, TheMoveTabRowTakesTheSelection) {
+  AddTab(browser(), GURL("https://a.example/"));
+  AddTab(browser(), GURL("https://b.example/"));
+  AddTab(browser(), GURL("https://c.example/"));
+  const spaces::SpaceId work = model().AddSpace("Work", SK_ColorBLUE)->id();
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  tabs::TabInterface* const first = tabs->GetTabAtIndex(0);
+  tabs::TabInterface* const second = tabs->GetTabAtIndex(1);
+  tabs::TabInterface* const third = tabs->GetTabAtIndex(2);
+  tabs->ActivateTabAt(0);
+  tabs->ExtendSelectionTo(1);
+  ASSERT_TRUE(tabs->IsTabSelected(0));
+  ASSERT_TRUE(tabs->IsTabSelected(1));
+  auto bar = std::make_unique<CommandBarView>(browser());
+  bar->SetModeForTesting(CommandBarView::Mode::kActions);
+  const size_t row = RowIndex(*bar, u"Move Tab to Work");
+  ASSERT_LT(row, bar->row_count_for_testing());
+  Down(*bar, static_cast<int>(row));
+  ASSERT_EQ(row, bar->selected_row_for_testing());
+  EXPECT_TRUE(Enter(*bar));
+  EXPECT_EQ(work, model().SpaceForTab(first));
+  EXPECT_EQ(work, model().SpaceForTab(second)) << "the row moved one tab";
+  EXPECT_NE(work, model().SpaceForTab(third));
+  EXPECT_EQ(work, model().active_id());
+}
+
 // commandbar K9: the rows list Stedding's verbs and the window's commands --
 // a row per other Space, the captures, the sidebar, one per preference.
 TEST_F(CommandBarViewTest, ActionRowsListSpacesAndCaptures) {
