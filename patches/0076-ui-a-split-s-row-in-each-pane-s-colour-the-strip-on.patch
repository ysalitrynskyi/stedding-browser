+    SCOPED_TRACE("a pane with no colour yet leaves the ground over it");
+    const SkColor light_colour = colour_of(light);
+    const SkColor dark_colour = colour_of(dark);
+    ASSERT_EQ(light, tabs->GetActiveWebContents());
+    for (const bool left_known : {true, false}) {
+      SCOPED_TRACE(left_known ? "the right pane's colour unknown"
+                              : "the left pane's colour unknown");
+      row()->SetColorForTesting(left_known ? std::optional(light_colour)
+                                           : std::nullopt);
+      row()->SetPartnerColorForTesting(left_known ? std::nullopt
+                                                  : std::optional(dark_colour));
+      views::test::RunScheduledLayout(view());
+      const auto bounds_of = [&](int index) {
+        views::View* const pane =
+            view()->multi_contents_view()->contents_container_views()[index];
+        gfx::RectF bounds(pane->GetLocalBounds());
+        views::View::ConvertRectToTarget(pane, view(), &bounds);
