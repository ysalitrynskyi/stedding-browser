+// pins H14 (BACKLOG S-314): a pin that ends the walk inside a row of Home's, a
+// split with a loose pane, does not take a new pin into that row.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ANewPinStaysOutOfAnotherSpacesSplit) {
+  const spaces::SpaceId work = model().active_id();
+  tabs::TabInterface* const first = tabs().GetActiveTab();
+  ASSERT_TRUE(first);
+  model().SetSpacePinned(first, true);
+
+  spaces::Space* const home = model().AddSpace("Home", SK_ColorBLUE);
+  ASSERT_TRUE(home);
+  const spaces::SpaceId home_id = home->id();
+  model().SetActiveSpace(home_id);
+  tabs::TabInterface* const home_pin = AddBlankTab();
+  model().SetSpacePinned(home_pin, true);
+  tabs::TabInterface* const home_tab = AddBlankTab();
+  tabs().ActivateTabAt(Index(home_pin));
+  tabs().AddToNewSplit({Index(home_tab)}, split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(home_pin->IsSplit());
+
+  model().SetActiveSpace(work);
+  tabs::TabInterface* const loose = AddBlankTab();
+  AddBlankTab();
+  tabs().ActivateTabAt(Index(loose));
+  spaces::ToggleSpacePinOnActiveTab(browser());
+  ASSERT_TRUE(model().IsSpacePinned(loose));
+
+  EXPECT_FALSE(loose->IsSplit());
+  EXPECT_TRUE(home_pin->IsSplit());
+  EXPECT_EQ(home_pin->GetSplit(), home_tab->GetSplit());
+  EXPECT_EQ(Index(home_pin) + 1, Index(home_tab)) << "a split stays whole";
+  EXPECT_EQ(Index(first) + 1, Index(loose)) << "the end of Work's pins";
+  EXPECT_TRUE(IsAboveTheLine(loose));
+}
