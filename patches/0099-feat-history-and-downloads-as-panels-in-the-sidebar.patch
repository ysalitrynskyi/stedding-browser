+// Pn8: no request leaves the machine while both panels list rows whose
+// sites have no icon in the cache: not to the sites, not to a favicon
+// server.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsTest, NoRequestLeavesTheMachine) {
+  ui_test_utils::WaitForHistoryToLoad(history());
+  for (int i = 0; i < 5; ++i) {
+    AddVisit(GURL("https://no-icon-" + base::NumberToString(i) + ".test/"),
+             u"A page with no icon", base::Time::Now() - base::Seconds(i));
+  }
+  history::BlockUntilHistoryProcessesPendingRequests(history());
+
+  base::Lock lock;
+  std::vector<GURL> outbound;
+  content::URLLoaderInterceptor interceptor(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* params) {
+        const GURL& url = params->url_request.url;
+        // The rows' pages and any icon server (Google's favicon service is
+        // on gstatic.com and google.com/s2/favicons). Chromium's own account
+        // check at google.com is not the panel's.
+        if (url.SchemeIsHTTPOrHTTPS() &&
+            (url.host().ends_with(".test") ||
+             url.host().find("gstatic") != std::string::npos ||
+             url.path().find("favicon") != std::string::npos)) {
+          base::AutoLock hold(lock);
+          outbound.push_back(url);
+        }
+        return false;
+      }));
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kHistory));
+  ASSERT_TRUE(WaitForRows(5));
+  // Every row's icon has been asked for.
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(), "new Promise(r => requestAnimationFrame(() => "
+                    "requestAnimationFrame(r)))"));
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_DOWNLOADS));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kDownloads));
+  base::RunLoop().RunUntilIdle();
+
+  base::AutoLock hold(lock);
+  EXPECT_TRUE(outbound.empty()) << outbound.front();
+}
