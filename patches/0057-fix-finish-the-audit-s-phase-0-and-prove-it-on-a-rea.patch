+// menus M8 (PLAN.md TAB-18's check): on the horizontal strip's menu both
+// submenus open, every entry in them is enabled, and choosing the third
+// "Move to Space" entry moves the tab there.
+TEST_F(TabMenuVerbsTest, TheHorizontalMenuOpensItsSubmenus) {
+  tabs::TabInterface* const tab = OpenTab(GURL("https://docs.example.com/a"));
+  HaveSpaces(4);
+  const int index = IndexOf(tab);
+  ui::UnownedUserDataHost host;
+  SpaceNamesDelegate names(host, space_model());
+  ModelMenuDelegate delegate(tabs(), index);
+  TabMenuModel menu(&delegate, &names, &tabs(), index);
+
+  const std::optional<size_t> move_at =
+      menu.GetIndexOfCommandId(TabStripModel::CommandSteddingMoveToSpaceMenu);
+  ASSERT_TRUE(move_at.has_value());
+  EXPECT_TRUE(menu.IsEnabledAt(*move_at));
+  ui::MenuModel* const move = menu.GetSubmenuModelAt(*move_at);
+  ASSERT_TRUE(move);
+  ASSERT_EQ(3u, move->GetItemCount());
+  for (size_t i = 0; i < move->GetItemCount(); ++i) {
+    EXPECT_TRUE(move->IsEnabledAt(i)) << "Move to Space entry " << i;
+  }
+
+  const std::optional<size_t> route_at =
+      menu.GetIndexOfCommandId(TabStripModel::CommandSteddingRouteToSpaceMenu);
+  ASSERT_TRUE(route_at.has_value());
+  EXPECT_TRUE(menu.IsEnabledAt(*route_at));
+  ui::MenuModel* const route = menu.GetSubmenuModelAt(*route_at);
+  ASSERT_TRUE(route);
+  ASSERT_EQ(4u, route->GetItemCount());
+  for (size_t i = 0; i < route->GetItemCount(); ++i) {
+    EXPECT_TRUE(route->IsEnabledAt(i)) << "Always Open entry " << i;
+  }
+
+  // The Rename row is there, and off: this strip has no row to rename in.
+  const std::optional<size_t> rename_at =
+      menu.GetIndexOfCommandId(TabStripModel::CommandSteddingRenameTab);
+  ASSERT_TRUE(rename_at.has_value());
+  EXPECT_FALSE(menu.IsEnabledAt(*rename_at));
+
+  const spaces::SpaceId third_other = space_model().spaces()[3]->id();
+  move->ActivatedAt(2);
+  EXPECT_EQ(third_other, space_model().SpaceForTab(tab));
+  EXPECT_EQ(third_other, space_model().active_id());
+}
