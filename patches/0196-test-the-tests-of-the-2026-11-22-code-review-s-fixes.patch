+// The elements matching $1 whose text, read in order, does not run left to
+// right: the last character is not drawn right of the one before it, or
+// the last of a key's chord right of its first. "in order" when none.
+constexpr char kOutOfOrderW2B05[] = R"(
+    (() => {
+      const box = (text, at) => {
+        const range = document.createRange();
+        range.setStart(text, at);
+        range.setEnd(text, at + 1);
+        return range.getBoundingClientRect();
+      };
+      const wrong = [];
+      for (const element of document.querySelectorAll($1)) {
+        const text = element.firstChild;
+        if (!text || text.nodeType !== Node.TEXT_NODE || text.length < 2) {
+          continue;
+        }
+        const last = box(text, text.length - 1);
+        const first = element.tagName === 'KBD' ? box(text, 0)
+                                                : box(text, text.length - 2);
+        if (last.left < first.right - 1) {
+          wrong.push(text.data);
+        }
+      }
+      return wrong.length ? wrong.join(' | ') : 'in order';
+    })())";
+
+// P05-1h, welcome W21: under a right-to-left interface the flow is laid out
+// right to left, and its English text still reads left to right: the
+// tagline's full stop ends it on the right, each key's chord keeps its
+// order, a description's closing bracket stays at its end, and the steps'
+// names sit at the header's far end from the wordmark. The full stop and
+// the brackets were drawn at the line's left end, the chords backwards, and
+// the names crowded the wordmark.
+IN_PROC_BROWSER_TEST_F(WelcomeRtlW2B05Test,
+                       TheEnglishTextKeepsItsOrderRightToLeft) {
+  ASSERT_TRUE(base::i18n::IsRTL());
+  content::WebContents* const page = OpenWelcomeW2B05(*browser(), {});
+  ASSERT_TRUE(page);
+  ASSERT_EQ("rtl", content::EvalJs(page, "document.documentElement.dir"));
+  {
+    SCOPED_TRACE("the tagline's full stop");
+    EXPECT_EQ("in order", content::EvalJs(page, content::JsReplace(
+                                                    kOutOfOrderW2B05,
+                                                    "main .tagline")));
+  }
+  {
+    SCOPED_TRACE("the steps' names at the far end");
+    EXPECT_EQ("far end", content::EvalJs(page, R"(
+        (() => {
+          const header =
+              document.querySelector('header').getBoundingClientRect();
+          const word =
+              document.querySelector('.wordmark').getBoundingClientRect();
+          const steps =
+              document.querySelector('.progress').getBoundingClientRect();
+          if (word.left < steps.right) {
+            return 'the wordmark is not right of the steps';
+          }
+          const short = Math.round(steps.left - header.left);
+          return short < 2 ? 'far end' : `${short}px short of the far end`;
+        })())"));
+  }
+  {
+    SCOPED_TRACE("the keys step");
+    ASSERT_TRUE(content::ExecJs(page, R"(
+        steddingWelcomeTest.state.step = 'keys';
+        steddingWelcomeTest.applyBehaviour({});)"));
+    ASSERT_TRUE(content::EvalJs(page, "!!document.querySelector('main kbd')")
+                    .ExtractBool());
+    EXPECT_EQ("in order", content::EvalJs(page, content::JsReplace(
+                                                    kOutOfOrderW2B05,
+                                                    "main kbd")));
+    EXPECT_EQ("in order", content::EvalJs(page, content::JsReplace(
+                                                    kOutOfOrderW2B05,
+                                                    "main .keys > span")));
+  }
+}
