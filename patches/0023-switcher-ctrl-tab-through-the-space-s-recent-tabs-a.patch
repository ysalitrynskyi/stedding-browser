+  tabs::TabInterface* const a = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const c = OpenTab();
+  const std::vector<tabs::TabInterface*> in_work =
+      model().RecentTabs(work->id());
+  ASSERT_FALSE(in_work.empty());
+  EXPECT_EQ(c, in_work.front());
+  EXPECT_EQ(in_work.end(), std::ranges::find(in_work, a));
+  EXPECT_EQ(in_work.end(), std::ranges::find(in_work, b));
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{b, a}), model().RecentTabs(home));
+
+  model().SetActiveSpace(home);
+  EXPECT_EQ(b, tabs().GetActiveTab());
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{b, a}), model().RecentTabs(home));
+
+  // An essential used here counts here; a closed tab drops out.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(a),
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+  tabs().SetTabPinned(tabs().GetIndexOfTab(a), true);
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{a, b}), model().RecentTabs(home));
+  tabs().CloseWebContentsAt(tabs().GetIndexOfTab(b),
+                            TabCloseTypes::CLOSE_USER_GESTURE);
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{a}), model().RecentTabs(home));
+}
+
+// switcher X1: tabs the user never activated follow the history in sidebar
+// order, so Ctrl-Tab has somewhere to go in a fresh window.
+TEST_F(SpaceWindowTest, RecentTabsFallBackToSidebarOrder) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  const auto open_in_background = [&] {
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContents::Create(
+            content::WebContents::CreateParams(profile()));
+    tabs().AppendTab(
+        std::make_unique<tabs::TabModel>(std::move(contents), &tabs()),
+        /*foreground=*/false);
+    return tabs().GetTabAtIndex(tabs().count() - 1);
+  };
+  tabs::TabInterface* const b = open_in_background();
+  tabs::TabInterface* const c = open_in_background();
+  ASSERT_EQ(a, tabs().GetActiveTab());
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{a, b, c}),
+            model().RecentTabs(home));
+
+  // A tap goes to b, the next in sidebar order; the next tap comes back.
+  EXPECT_TRUE(model().CycleRecent(1));
+  model().EndCycle();
+  EXPECT_EQ(b, tabs().GetActiveTab());
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{b, a, c}),
+            model().RecentTabs(home));
+  EXPECT_TRUE(model().CycleRecent(1));
+  model().EndCycle();
+  EXPECT_EQ(a, tabs().GetActiveTab());
+}
+
+// switcher X1: through the command, as the key arrives.
+TEST_F(SpaceWindowTest, CtrlTabWalksRecentTabsOfTheActiveSpace) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  OpenTab();
+  model().SetActiveSpace(home);
+  ASSERT_EQ(c, tabs().GetActiveTab());
+
+  chrome::ExecuteCommand(browser(), IDC_CYCLE_TO_NEXT_TAB);
+  EXPECT_EQ(b, tabs().GetActiveTab());
+  EXPECT_TRUE(model().in_cycle());
+  EXPECT_EQ(1u, model().cycle_position());
+  chrome::ExecuteCommand(browser(), IDC_CYCLE_TO_NEXT_TAB);
+  EXPECT_EQ(a, tabs().GetActiveTab());
+  chrome::ExecuteCommand(browser(), IDC_CYCLE_TO_NEXT_TAB);
+  EXPECT_EQ(c, tabs().GetActiveTab()) << "wraps; never a tab of Work";
+  chrome::ExecuteCommand(browser(), IDC_CYCLE_TO_PREV_TAB);
+  EXPECT_EQ(a, tabs().GetActiveTab());
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, b, a}), model().cycle_tabs());
+
+  model().EndCycle();
+  EXPECT_FALSE(model().in_cycle());
+  EXPECT_EQ(a, tabs().GetActiveTab());
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{a, c, b}),
+            model().RecentTabs(home));
+}
+
+// switcher X2: a tap is one step and a commit; the next tap comes back.
+TEST_F(SpaceWindowTest, CtrlTabTapGoesToPreviousTab) {
+  OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  ASSERT_EQ(c, tabs().GetActiveTab());
+  EXPECT_TRUE(model().CycleRecent(1));
+  model().EndCycle();
+  EXPECT_EQ(b, tabs().GetActiveTab());
+  EXPECT_TRUE(model().CycleRecent(1));
+  model().EndCycle();
+  EXPECT_EQ(c, tabs().GetActiveTab());
+
+  // Escape mid-run: back where the run started.
+  EXPECT_TRUE(model().CycleRecent(1));
+  EXPECT_EQ(b, tabs().GetActiveTab());
+  model().CancelCycle();
+  EXPECT_FALSE(model().in_cycle());
+  EXPECT_EQ(c, tabs().GetActiveTab());
+}
+
+// switcher X5: the setting off returns Ctrl-Tab to sidebar order.
+TEST_F(SpaceWindowTest, CtrlTabSettingOffUsesStripOrder) {
+  tabs::TabInterface* const a = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  // Recent order c, a, b; sidebar order c, b, a.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(a),
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(c),
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+  profile()->GetPrefs()->SetBoolean(stedding::prefs::kCtrlTabMru, false);
+  chrome::ExecuteCommand(browser(), IDC_CYCLE_TO_NEXT_TAB);
+  EXPECT_EQ(b, tabs().GetActiveTab()) << "sidebar order, not the recent one";
+  EXPECT_FALSE(model().in_cycle());
+
+  profile()->GetPrefs()->SetBoolean(stedding::prefs::kCtrlTabMru, true);
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(c),
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+  chrome::ExecuteCommand(browser(), IDC_CYCLE_TO_NEXT_TAB);
+  EXPECT_EQ(b, tabs().GetActiveTab());
+  model().EndCycle();
+}
+
+// splits J2: a split's panes are one entry of the recent list.
+TEST_F(SpaceWindowTest, RecentTabsCountASplitOnce) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  // c is active; the split takes c and b.
+  tabs().AddToNewSplit({tabs().GetIndexOfTab(b)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(b->IsSplit());
+  ASSERT_TRUE(c->IsSplit());
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(a),
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(b),
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+  const std::vector<tabs::TabInterface*> recent = model().RecentTabs(home);
+  ASSERT_EQ(2u, recent.size());
+  EXPECT_TRUE(recent[0]->IsSplit());
+  EXPECT_EQ(a, recent[1]);
+}
