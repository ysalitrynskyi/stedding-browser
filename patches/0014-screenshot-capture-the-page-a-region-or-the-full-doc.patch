+namespace {
+
+// A file name from the page: "Stedding example.org 2026-09-03 14.05.12.png".
+base::FilePath FileNameFor(content::WebContents* contents) {
+  std::string host =
+      contents ? std::string(contents->GetLastCommittedURL().host()) : "";
+  if (host.empty()) {
+    host = "page";
+  }
+  const std::string stamp = base::UnlocalizedTimeFormatWithPattern(
+      base::Time::Now(), "yyyy-MM-dd HH.mm.ss");
+  return base::FilePath("Stedding " + host + " " + stamp + ".png");
+}
+
+// Writes `png` under `directory`, choosing a free name.
+void WritePng(const base::FilePath& directory,
+              const base::FilePath& name,
+              std::vector<uint8_t> png) {
+  base::CreateDirectory(directory);
+  base::FilePath path = directory.Append(name);
+  for (int i = 2; base::PathExists(path) && i < 100; ++i) {
+    path = directory.Append(name.InsertBeforeExtensionASCII(" " + base::NumberToString(i)));
+  }
+  base::WriteFile(path, png);
+}
+
+// The shared ending: clipboard, then Downloads.
+void Deliver(Profile* profile,
+             content::WebContents* contents,
+             const SkBitmap& bitmap) {
+  VLOG(1) << "Deliver bitmap " << bitmap.width() << "x" << bitmap.height();
+  if (bitmap.drawsNothing()) {
+    return;
+  }
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste).WriteImage(bitmap);
+  std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, /*discard_transparency=*/false);
+  if (!png) {
+    return;
+  }
+  const base::FilePath directory =
+      DownloadPrefs::FromBrowserContext(profile)->DownloadPath();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&WritePng, directory, FileNameFor(contents),
+                     std::move(*png)));
+}
+
+void DeliverPng(Profile* profile,
+                content::WebContents* contents,
+                std::vector<uint8_t> png) {
+  if (png.empty()) {
+    return;
+  }
+  const SkBitmap bitmap = gfx::PNGCodec::Decode(png);
+  if (!bitmap.drawsNothing()) {
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteImage(bitmap);
+  }
+  const base::FilePath directory =
+      DownloadPrefs::FromBrowserContext(profile)->DownloadPath();
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&WritePng, directory, FileNameFor(contents),
+                     std::move(png)));
+}
+
+// Copies the visible surface of `contents`, optionally cropped to `region`
+// (in view coordinates), and hands the bitmap to `done`.
+void CopyVisible(content::WebContents* contents,
+                 const gfx::Rect& region,
+                 base::OnceCallback<void(const SkBitmap&)> done) {
+  content::RenderWidgetHostView* const view =
+      contents ? contents->GetRenderWidgetHostView() : nullptr;
+  if (!view) {
+    std::move(done).Run(SkBitmap());
+    return;
+  }
+  // Keep the renderer producing frames while we copy (the precedent in
+  // tab_contextualization_controller.cc does the same); the runner releases
+  // it when the callback is destroyed.
+  base::ScopedClosureRunner capturing = contents->IncrementCapturerCount(
+      gfx::Size(), /*stay_hidden=*/true, /*stay_awake=*/false,
+      /*is_activity=*/false);
+  view->CopyFromSurface(
+      region, gfx::Size(), base::TimeDelta(),
+      base::BindPostTask(
+          base::SequencedTaskRunner::GetCurrentDefault(),
+          base::BindOnce(
+              [](base::ScopedClosureRunner capturing,
+                 base::OnceCallback<void(const SkBitmap&)> done,
+                 const content::CopyFromSurfaceResult& result) {
+                std::move(done).Run(result.has_value() ? result->bitmap
+                                                       : SkBitmap());
+              },
+              std::move(capturing), std::move(done))));
+}
+
+// The full document through the DevTools protocol: attach a trusted client,
+// ask for Page.captureScreenshot beyond the viewport, detach. No infobar:
+// this is the browser itself, not an extension or a remote debugger.
+class FullPageCapturer : public content::DevToolsAgentHostClient {
+ public:
+  static void Start(content::WebContents* contents,
+                    base::OnceCallback<void(std::vector<uint8_t>)> done) {
+    // Deletes itself when the reply arrives or the host goes away.
+    new FullPageCapturer(contents, std::move(done));
+  }
+
+  // content::DevToolsAgentHostClient:
+  void DispatchProtocolMessage(content::DevToolsAgentHost* host,
+                               base::span<const uint8_t> message) override {
+    std::optional<base::DictValue> parsed = base::JSONReader::ReadDict(
+        std::string_view(reinterpret_cast<const char*>(message.data()),
+                         message.size()),
+        base::JSON_PARSE_RFC);
+    if (!parsed) {
+      return;
+    }
+    const base::DictValue& dict = *parsed;
+    if (dict.FindInt("id") != kRequestId) {
+      return;  // an event, not our reply
+    }
+    std::vector<uint8_t> png;
+    if (const base::DictValue* result = dict.FindDict("result")) {
+      if (const std::string* data = result->FindString("data")) {
+        std::optional<std::vector<uint8_t>> bytes = base::Base64Decode(*data);
+        if (bytes) {
+          png = std::move(*bytes);
+        }
+      }
+    }
+    Finish(std::move(png));
+  }
+  void AgentHostClosed(content::DevToolsAgentHost* host) override {
+    Finish({});
+  }
+  bool IsTrusted() override { return true; }
+  bool MayWriteLocalFiles() override { return false; }
+  bool AllowUnsafeOperations() override { return false; }
+  std::string GetTypeForMetrics() override { return "Stedding"; }
+
+ private:
+  static constexpr int kRequestId = 1;
+
+  FullPageCapturer(content::WebContents* contents,
+                   base::OnceCallback<void(std::vector<uint8_t>)> done)
+      : done_(std::move(done)) {
+    host_ = content::DevToolsAgentHost::GetOrCreateFor(contents);
+    if (!host_ || !host_->AttachClient(this)) {
+      Finish({});
+      return;
+    }
+    base::DictValue params;
+    params.Set("format", "png");
+    params.Set("captureBeyondViewport", true);
+    params.Set("fromSurface", true);
+    base::DictValue request;
+    request.Set("id", kRequestId);
+    request.Set("method", "Page.captureScreenshot");
+    request.Set("params", std::move(params));
+    std::optional<std::string> json = base::WriteJson(request);
+    host_->DispatchProtocolMessage(this, base::as_byte_span(*json));
+  }
+  ~FullPageCapturer() override = default;
+
+  void Finish(std::vector<uint8_t> png) {
+    if (host_) {
+      host_->DetachClient(this);
+      host_ = nullptr;
+    }
+    if (done_) {
+      std::move(done_).Run(std::move(png));
+    }
+    delete this;
+  }
+
+  scoped_refptr<content::DevToolsAgentHost> host_;
+  base::OnceCallback<void(std::vector<uint8_t>)> done_;
+};
+
+// Holds the region-selection flow alive until the user finishes.
+class RegionCapture {
+ public:
+  static void Start(Profile* profile, content::WebContents* contents) {
+    new RegionCapture(profile, contents);
+  }
+
+ private:
+  RegionCapture(Profile* profile, content::WebContents* contents)
+      : profile_(profile),
+        contents_(contents->GetWeakPtr()),
+        flow_(std::make_unique<image_editor::ScreenshotFlow>(contents)) {
+    flow_->StartForRegionSelection(base::BindOnce(
+        &RegionCapture::OnRegion, base::Unretained(this)));
+  }
+
+  void OnRegion(const image_editor::RegionSelectionResult& result) {
+    content::WebContents* const contents = contents_.get();
+    if (!contents || result.selected_rect.IsEmpty()) {
+      delete this;
+      return;
+    }
+    CopyVisible(contents, result.selected_rect,
+                base::BindOnce(
+                    [](RegionCapture* self, const SkBitmap& bitmap) {
+                      Deliver(self->profile_, self->contents_.get(), bitmap);
+                      delete self;
+                    },
+                    this));
+  }
+
+  const raw_ptr<Profile> profile_;
+  base::WeakPtr<content::WebContents> contents_;
+  std::unique_ptr<image_editor::ScreenshotFlow> flow_;
+};
+
+}  // namespace
+
+void CaptureScreenshot(BrowserWindowInterface* browser, CaptureMode mode) {
+  VLOG(1) << "CaptureScreenshot mode=" << static_cast<int>(mode);
+  if (!browser) {
+    return;
+  }
+  tabs::TabInterface* const tab = browser->GetTabStripModel()->GetActiveTab();
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  Profile* const profile = browser->GetProfile();
+  switch (mode) {
+    case CaptureMode::kVisible:
+      CopyVisible(contents, gfx::Rect(),
+                  base::BindOnce(&Deliver, profile, contents));
+      break;
+    case CaptureMode::kRegion:
+      RegionCapture::Start(profile, contents);
+      break;
+    case CaptureMode::kFullPage:
+      FullPageCapturer::Start(contents,
+                              base::BindOnce(&DeliverPng, profile, contents));
+      break;
+  }
+}
+
+}  // namespace stedding
