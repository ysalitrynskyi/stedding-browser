   void SetSpaceName(const SpaceId& id, std::string name);
   void SetSpaceColor(const SpaceId& id, SkColor color);
 
+
+  // Which Space `tab` belongs to.
+  //
+  // A tab that has never been asked about joins the active Space, which is what
+  // makes a newly opened tab appear where the user is looking. Tabs are keyed
+  // by handle rather than pointer so a closed tab cannot be confused with a
+  // later one at the same address.
+  const SpaceId& SpaceForTab(tabs::TabInterface* tab);
+
+  // Moves `tab` to `id`. Does nothing if `id` is not a Space in this model.
+  void SetSpaceForTab(tabs::TabInterface* tab, const SpaceId& id);
+
+  // True if `tab` is in the active Space, and so should be visible. Tabs this
+  // model has never seen count as visible: a window whose tabs predate Spaces
+  // must not blink out of existence.
+  bool IsTabInActiveSpace(const tabs::TabInterface* tab) const;
+
+  // Drops entries for tabs that no longer exist. Called when Spaces change; the
+  // map is small and this keeps it from growing for the life of the window.
+  void ForgetClosedTabs();
+
  private:
   std::vector<std::unique_ptr<Space>> spaces_;
   SpaceId active_id_;
   base::ObserverList<Observer> observers_;
+  std::map<tabs::TabHandle, SpaceId> tab_spaces_;
   std::optional<ui::ScopedUnownedUserData<SpaceModel>> scoped_user_data_;
 };
 
