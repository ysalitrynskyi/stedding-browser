+// found in the LICENSE file.
+
+// The short tab menu's last row on the horizontal strip, Close Folder's Tabs
+// beside a folded child, the tabs a menu verb takes for a tab that has left
+// the strip, against a real Browser and TabStripModel; and the sidebar width
+// that windows of one profile share through its preferences, against the
+// real state controllers.
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/i18n/rtl.h"
+#include "chrome/browser/ui/browser.h"
