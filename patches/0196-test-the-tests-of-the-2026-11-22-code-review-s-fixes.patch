+// P05-1c, welcome W11, W12: a late answer's redraw of the step keeps where
+// it was scrolled to. The flow drew the step again from its top, so an
+// import's progress at the bottom of a long import step went out of sight.
+IN_PROC_BROWSER_TEST_F(WelcomeFlowW2B05Test, ARedrawKeepsTheStepsScroll) {
+  content::WebContents* const page = OpenWelcomeW2B05(*browser(), "behaviour");
+  ASSERT_TRUE(page);
