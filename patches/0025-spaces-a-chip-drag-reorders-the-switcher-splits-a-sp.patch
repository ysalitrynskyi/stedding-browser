+void SpaceSwitcherView::OnChipDragged(size_t chip_index,
+                                      const ui::MouseEvent& event) {
+  if (chip_index >= chips_.size()) {
+    return;
+  }
+  drag_chip_ = chip_index;
+  // The pointer, in the row's coordinates (spaces B27).
+  gfx::Point point = event.location();
+  views::View::ConvertPointToTarget(chips_[chip_index].first, icon_row_,
+                                    &point);
+  last_drag_point_ = point;
+}
+
+void SpaceSwitcherView::OnChipReleased(size_t chip_index,
+                                       const ui::MouseEvent& event) {
+  if (drag_chip_ && *drag_chip_ == chip_index && chip_index < chips_.size()) {
+    gfx::Point point = event.location();
+    views::View::ConvertPointToTarget(chips_[chip_index].first, icon_row_,
+                                      &point);
+    last_drag_point_ = point;
+  }
+  FinishDrag(chip_index);
+}
+
+void SpaceSwitcherView::OnChipCaptureLost(size_t chip_index) {
+  FinishDrag(chip_index);
+}
+
+void SpaceSwitcherView::FinishDrag(size_t chip_index) {
+  if (!drag_chip_ || *drag_chip_ != chip_index || chip_index >= chips_.size()) {
+    drag_chip_.reset();
+    return;
+  }
+  drag_chip_.reset();
+  std::vector<int> centres;
+  for (const auto& chip : chips_) {
+    centres.push_back(chip.first->bounds().CenterPoint().x());
+  }
+  const size_t target = SwitcherDropIndex(centres, last_drag_point_.x());
+  if (target == chip_index) {
+    return;
+  }
+  // The model's move rebuilds the row, which deletes the chip whose event
+  // this is: a turn later.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<SpaceSwitcherView> self, SpaceId id, int delta) {
+            if (self) {
+              self->model_->MoveSpace(id, delta);
+            }
+          },
+          weak_factory_.GetWeakPtr(), chips_[chip_index].second,
+          static_cast<int>(target) - static_cast<int>(chip_index)));
+}
