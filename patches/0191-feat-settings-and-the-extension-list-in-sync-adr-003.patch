+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/stedding_extension_install.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "chrome/browser/extensions/webstore_install_with_prompt.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/web_contents.h"
+#include "extensions/browser/webstore_install_result.h"
+#include "ui/gfx/native_ui_types.h"
+
+namespace stedding {
+
+namespace {
+
+void OnInstallDone(SyncedInstallDone done,
+                   bool success,
+                   const std::string& error,
+                   extensions::webstore_install::Result result) {
+  std::move(done).Run(success,
+                      result == extensions::webstore_install::USER_CANCELLED);
+}
+
+}  // namespace
+
+void InstallFromWebStore(Profile* profile,
+                         content::WebContents* settings_page,
+                         const std::string& id,
+                         SyncedInstallDone done) {
+  // A bad id is refused by the installer itself (INVALID_ID).
+  if (!profile) {
+    std::move(done).Run(/*installed=*/false, /*cancelled=*/false);
+    return;
+  }
+  const gfx::NativeWindow parent =
+      settings_page ? settings_page->GetTopLevelNativeWindow()
+                    : gfx::NativeWindow();
+  // The installer keeps itself alive until it is done, and answers once:
+  // with the person's yes and the install, their no, or a failure.
+  auto installer = base::MakeRefCounted<extensions::WebstoreInstallWithPrompt>(
+      id, profile, parent, base::BindOnce(&OnInstallDone, std::move(done)));
+  installer->BeginInstall();
+}
+
+}  // namespace stedding
