+// The focused view: what a page or a text field would get.
+class KeyRecorder : public views::View {
+ public:
+  KeyRecorder() { SetFocusBehavior(FocusBehavior::ALWAYS); }
+
+  bool OnKeyPressed(const ui::KeyEvent& event) override {
+    ++keys;
+    return true;
+  }
+
+  int keys = 0;
+};
+
+class AltGrChordsTest : public views::ViewsTestBase {
+ protected:
+  void SetUp() override {
+    views::ViewsTestBase::SetUp();
+    widget_ = CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    recorder_ = widget_->SetContentsView(std::make_unique<KeyRecorder>());
+    widget_->Show();
+    widget_->Activate();
+    recorder_->RequestFocus();
+    widget_->GetFocusManager()->RegisterAccelerator(
+        ui::Accelerator(ui::VKEY_C, kCtrlAltShift),
+        ui::AcceleratorManager::kNormalPriority, &target_);
+    // Space 1 on Windows: Alt+1 (spaces B18, windows N7).
+    widget_->GetFocusManager()->RegisterAccelerator(
+        ui::Accelerator(ui::VKEY_1, ui::EF_ALT_DOWN),
+        ui::AcceleratorManager::kNormalPriority, &space_);
+    chords_ = std::make_unique<AltGrChords>(
+        widget_.get(), base::BindLambdaForTesting([&]() { return left_alt_; }));
+    generator_ = std::make_unique<ui::test::EventGenerator>(
+        widget_->GetNativeWindow()->GetRootWindow());
+  }
+
+  void TearDown() override {
+    generator_.reset();
+    chords_.reset();
+    widget_->GetFocusManager()->UnregisterAccelerators(&target_);
+    widget_->GetFocusManager()->UnregisterAccelerators(&space_);
+    recorder_ = nullptr;
+    widget_.reset();
+    views::ViewsTestBase::TearDown();
+  }
+
+  CountingTarget target_;
+  CountingTarget space_;
+  bool left_alt_ = false;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<KeyRecorder> recorder_ = nullptr;
+  std::unique_ptr<AltGrChords> chords_;
+  std::unique_ptr<ui::test::EventGenerator> generator_;
+};
+
+TEST_F(AltGrChordsTest, TheLeftAltRunsTheChordAndAltGrTypes) {
+  {
+    SCOPED_TRACE("Ctrl and the left Alt: the command");
+    left_alt_ = true;
+    generator_->PressKey(ui::VKEY_C, kAltGrShift);
+    EXPECT_EQ(1, target_.presses);
+    EXPECT_EQ(0, recorder_->keys) << "the key went on to be typed too";
+  }
+  {
+    SCOPED_TRACE("AltGr: the character");
+    left_alt_ = false;
+    generator_->PressKey(ui::VKEY_C, kAltGrShift);
+    EXPECT_EQ(1, target_.presses);
+    EXPECT_EQ(1, recorder_->keys);
+  }
+  {
+    SCOPED_TRACE("a chord no command uses: the character");
+    left_alt_ = true;
+    generator_->PressKey(ui::VKEY_X, kAltGrShift);
+    EXPECT_EQ(1, target_.presses);
+    EXPECT_EQ(2, recorder_->keys);
+  }
+  {
+    // Straight to the handler: the focus manager runs such a chord on its
+    // own, and the handler must not run it a second time.
+    SCOPED_TRACE("a layout that gives the key nothing: the focus manager's");
+    left_alt_ = true;
+    ui::KeyEvent chord(ui::EventType::kKeyPressed, ui::VKEY_C, kCtrlAltShift);
+    chord.SetFlags(kCtrlAltShift);
+    chords_->OnKeyEvent(&chord);
+    EXPECT_FALSE(chord.stopped_propagation());
+    EXPECT_EQ(1, target_.presses);
+  }
+}
+
+// windows N13: on a layout with AltGr the right Alt is AltGr, and with a digit
+// it types the layout's character -- a brace on German -- and switches no
+// Space; the handler leaves it to the layout, as it does Ctrl and the left Alt
+// with a digit, which is no chord of the window's.
+TEST_F(AltGrChordsTest, TheRightAltWithADigitTypes) {
+  generator_->PressKey(ui::VKEY_1, ui::EF_ALTGR_DOWN);
+  EXPECT_EQ(0, space_.presses);
+  EXPECT_EQ(1, recorder_->keys);
+  for (const bool left : {false, true}) {
+    SCOPED_TRACE(left ? "Ctrl and the left Alt" : "AltGr");
+    left_alt_ = left;
+    ui::KeyEvent digit(ui::EventType::kKeyPressed, ui::VKEY_1,
+                       ui::EF_ALTGR_DOWN);
+    digit.SetFlags(ui::EF_ALTGR_DOWN);
+    chords_->OnKeyEvent(&digit);
+    EXPECT_FALSE(digit.stopped_propagation());
+    EXPECT_EQ(0, space_.presses);
+  }
+}
+
+}  // namespace
+}  // namespace stedding
