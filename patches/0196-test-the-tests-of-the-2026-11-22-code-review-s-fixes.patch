+// How many browser windows are open, popups among them.
+int WindowCountB27() {
+  int windows = 0;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface*) {
+        ++windows;
+        return true;
+      });
+  return windows;
+}
