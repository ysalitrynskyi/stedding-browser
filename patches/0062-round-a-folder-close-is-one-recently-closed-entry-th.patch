new file mode 100644
index 0000000000000..45c37f3567239
--- /dev/null
+++ b/chrome/browser/ui/color/stedding_private_key.cc
@@ -0,0 +1,40 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/color/stedding_private_key.h"
+
+#include "base/containers/flat_set.h"
+#include "base/no_destructor.h"
+
+namespace stedding {
+namespace {
+
+base::flat_set<const ui::ColorProviderKey::InitializerSupplier*>& Marked() {
+  static base::NoDestructor<
+      base::flat_set<const ui::ColorProviderKey::InitializerSupplier*>>
+      marked;
+  return *marked;
+}
+
+}  // namespace
+
+void SetMarksPrivateWindow(
+    const ui::ColorProviderKey::InitializerSupplier* supplier,
+    bool marks) {
+  if (!supplier) {
+    return;
+  }
+  if (marks) {
+    Marked().insert(supplier);
+  } else {
+    Marked().erase(supplier);
+  }
+}
+
+bool MarksPrivateWindow(
+    const ui::ColorProviderKey::InitializerSupplier* supplier) {
+  return supplier && Marked().contains(supplier);
+}
+
+}  // namespace stedding
