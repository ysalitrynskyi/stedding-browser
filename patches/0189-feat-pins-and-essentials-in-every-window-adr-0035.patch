+// windows G2, G16 (BACKLOG S-496): a new window's asleep pins show the icons
+// history keeps for their pages, or for their sites, before they load. They
+// showed the generic globe until chosen.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest, ANewWindowsAsleepPinsShowTheirIcons) {
+  const GURL page = Page("/favicon/page_with_favicon.html");
+  PinPage(browser(), page);
+  // The page's icon reaches history a little after the page loads.
+  favicon::FaviconService* const icons = FaviconServiceFactory::GetForProfile(
+      browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  ASSERT_TRUE(icons);
+  base::CancelableTaskTracker tracker;
+  bool stored = false;
+  for (int i = 0; i < 100 && !stored; ++i) {
+    base::test::TestFuture<const favicon_base::FaviconImageResult&> icon;
+    icons->GetFaviconImageForPageURL(page, icon.GetCallback(), &tracker);
+    stored = !icon.Get().image.IsEmpty();
+    if (!stored) {
+      RunFor(base::Milliseconds(100));
+    }
+  }
+  ASSERT_TRUE(stored) << "history never kept the page's icon";
+  // A pin on a site history has an icon for, at a page it has none for: the
+  // site's icon. History finds a site by host with no port, so the site is
+  // one with none (the test server always has one), its front page added to
+  // history with an icon.
+  const GURL site("https://pins.test/");
+  history::HistoryService* const history =
+      HistoryServiceFactory::GetForProfile(browser()->GetProfile(),
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  ASSERT_TRUE(history);
+  history->AddPage(site, base::Time::Now(), history::SOURCE_BROWSED);
+  SkBitmap red;
+  red.allocN32Pixels(16, 16);
+  red.eraseColor(SK_ColorRED);
+  icons->SetFavicons({site}, GURL("https://pins.test/favicon.ico"),
+                     favicon_base::IconType::kFavicon,
+                     gfx::Image::CreateFrom1xBitmap(red));
+  stored = false;
+  for (int i = 0; i < 100 && !stored; ++i) {
+    base::test::TestFuture<const favicon_base::FaviconImageResult&> icon;
+    icons->GetFaviconImageForPageURL(site, icon.GetCallback(), &tracker);
+    stored = !icon.Get().image.IsEmpty();
+    if (!stored) {
+      RunFor(base::Milliseconds(100));
+    }
+  }
+  ASSERT_TRUE(stored) << "history never kept the site's icon";
+  spaces::PinRecord unvisited;
+  unvisited.id = stedding::NewTabToken();
+  unvisited.space = Model(browser()).active_id();
+  unvisited.has_space = true;
+  unvisited.home = GURL("https://pins.test/never/opened");
+  unvisited.title = u"Never opened";
+  Store().Publish({}, {unvisited}, {});
+  ASSERT_TRUE(base::test::RunUntil([&] { return Pins(browser()).size() == 2u; }));
+
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(base::test::RunUntil([&] { return Pins(second).size() == 2u; }));
+  for (tabs::TabInterface* const pin : Pins(second)) {
+    SCOPED_TRACE(Model(second).HomeUrl(pin).value_or(GURL()).spec());
+    const favicon::FaviconDriver* const driver =
+        favicon::ContentFaviconDriver::FromWebContents(pin->GetContents());
+    ASSERT_TRUE(driver);
+    EXPECT_TRUE(base::test::RunUntil([&] { return driver->FaviconIsValid(); }))
+        << "the asleep pin shows the generic globe";
+    EXPECT_FALSE(driver->GetFavicon().IsEmpty());
+    // Still asleep: the icon came from history, not from a load.
+    EXPECT_TRUE(pin->GetContents()->GetController().NeedsReload());
+    EXPECT_FALSE(pin->GetContents()->GetPrimaryMainFrame()->IsRenderFrameLive());
+  }
+}
