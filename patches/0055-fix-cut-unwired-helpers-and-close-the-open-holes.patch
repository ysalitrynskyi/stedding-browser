+std::vector<user_data_importer::SourceProfile> DetectChromiumProfiles(
+    const ChromiumBrowserLocation& browser) {
+  std::vector<user_data_importer::SourceProfile> out;
+  if (!base::DirectoryExists(browser.user_data_dir)) {
+    return out;
+  }
+  base::FileEnumerator dirs(browser.user_data_dir, /*recursive=*/false,
+                            base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath dir = dirs.Next(); !dir.empty(); dir = dirs.Next()) {
+    if (!ProfileDirHasData(dir)) {
+      continue;
+    }
+    const std::string dir_name = dir.BaseName().AsUTF8Unsafe();
+    if (dir_name == "System Profile" || dir_name == "Guest Profile" ||
+        dir_name == "Crashpad") {
+      continue;
+    }
+    user_data_importer::SourceProfile source;
+    source.importer_name = base::UTF8ToUTF16(browser.display_name);
+    source.importer_type = user_data_importer::TYPE_CHROMIUM;
+    source.source_path = dir;
+    source.profile = base::UTF8ToUTF16(
+        ProfileDisplayName(browser.user_data_dir, dir_name));
+    source.services_supported = user_data_importer::FAVORITES |
+                                user_data_importer::HISTORY |
+                                user_data_importer::PASSWORDS;
+    source.locale = browser.keychain_service + "\n" + browser.keychain_account;
+    out.push_back(std::move(source));
+  }
+  return out;
+}
