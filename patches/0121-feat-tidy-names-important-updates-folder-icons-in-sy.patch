+constexpr std::array<std::string_view, 8> kNamesThatSayNothing = {
+    "download", "file",   "document", "untitled",
+    "attachment", "export", "image",  "unnamed"};
+
+// One part of a title and the separator written before it.
+struct Part {
+  std::u16string separator;
+  std::u16string text;
+};
+
+std::vector<Part> SplitAtSeparators(std::u16string_view title) {
+  std::vector<Part> parts(1);
+  size_t i = 0;
+  while (i < title.size()) {
+    bool split = false;
+    for (std::u16string_view separator : kSeparators) {
+      if (title.substr(i).starts_with(separator)) {
+        parts.push_back(Part{std::u16string(separator), std::u16string()});
+        i += separator.size();
+        split = true;
+        break;
+      }
+    }
+    if (!split) {
+      parts.back().text.push_back(title[i]);
+      ++i;
+    }
+  }
+  return parts;
+}
+
+bool IsDigits(std::u16string_view text) {
+  return !text.empty() && std::all_of(text.begin(), text.end(), [](char16_t c) {
+    return base::IsAsciiDigit(c);
+  });
+}
+
+// "(3)" or "(99+)": one to three digits, so a year such as "(2024)" stays.
+bool IsCount(std::u16string_view text) {
+  if (text.size() < 3 || text.front() != u'(' || text.back() != u')') {
+    return false;
+  }
+  std::u16string_view inside = text.substr(1, text.size() - 2);
+  if (!inside.empty() && inside.back() == u'+') {
+    inside.remove_suffix(1);
+  }
+  return inside.size() <= 3 && IsDigits(inside);
+}
+
+// A part without a count of unread items at its start or its end.
+std::u16string WithoutCounts(std::u16string_view text) {
+  std::u16string_view rest =
+      base::TrimWhitespace(text, base::TRIM_ALL);
+  const size_t first_space = rest.find(u' ');
+  if (first_space != std::u16string_view::npos &&
+      IsCount(rest.substr(0, first_space))) {
+    rest = base::TrimWhitespace(rest.substr(first_space), base::TRIM_ALL);
+  }
+  const size_t last_space = rest.rfind(u' ');
+  if (last_space != std::u16string_view::npos &&
+      IsCount(rest.substr(last_space + 1))) {
+    rest = base::TrimWhitespace(rest.substr(0, last_space), base::TRIM_ALL);
+  }
+  if (IsCount(rest)) {
+    return std::u16string();
+  }
+  return std::u16string(rest);
+}
+
+bool IsEmailAddress(std::u16string_view text) {
+  const size_t at = text.find(u'@');
+  return at != std::u16string_view::npos && at > 0 &&
+         text.find(u' ') == std::u16string_view::npos &&
+         text.find(u'.', at) != std::u16string_view::npos;
+}
+
+// The part's letters and digits, lower-cased: "GitHub" is "github".
+std::string Letters(std::u16string_view text) {
+  std::string letters;
+  for (char16_t c : text) {
+    if (base::IsAsciiAlphaNumeric(c)) {
+      letters.push_back(base::ToLowerASCII(static_cast<char>(c)));
+    }
+  }
+  return letters;
+}
+
+// The site's names: each label of its host but "www", and its registrable
+// name without the registry ("google" for mail.google.com).
+std::set<std::string> SiteNames(const GURL& url) {
+  std::set<std::string> names;
+  if (!url.is_valid() || !url.has_host()) {
+    return names;
+  }
+  const std::string host = base::ToLowerASCII(url.host());
+  for (const std::string& label :
+       base::SplitString(host, ".", base::TRIM_WHITESPACE,
+                         base::SPLIT_WANT_NONEMPTY)) {
+    if (label != "www") {
+      names.insert(label);
+    }
+  }
+  // The registrable domain's first label: "google" for mail.google.com,
+  // "bbc" for www.bbc.co.uk.
+  const std::string domain =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  const size_t dot = domain.find('.');
+  if (dot != std::string::npos && dot > 0) {
+    names.insert(Letters(base::UTF8ToUTF16(domain.substr(0, dot))));
+  }
+  return names;
+}
+
+// A name Windows keeps for a device, whatever its extension: "AUX.pdf",
+// "com1.txt". Checked on every platform, since files travel.
+bool IsReservedOnWindows(std::u16string_view name) {
+  static constexpr std::array<std::string_view, 25> kReserved = {
+      "con",  "prn",  "aux",  "nul",  "com1", "com2",   "com3",
+      "com4", "com5", "com6", "com7", "com8", "com9",   "lpt1",
+      "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7",   "lpt8",
+      "lpt9", "conin$", "conout$", "clock$"};
+  std::u16string_view stem = name.substr(0, name.find(u'.'));
+  stem = base::TrimWhitespace(stem, base::TRIM_TRAILING);
+  const std::string lower = base::ToLowerASCII(base::UTF16ToUTF8(stem));
+  return std::ranges::find(kReserved, lower) != kReserved.end();
+}
+
+size_t WordCount(std::u16string_view text) {
+  return base::SplitStringPiece(text, u" ", base::TRIM_WHITESPACE,
+                                base::SPLIT_WANT_NONEMPTY)
+      .size();
+}
+
+}  // namespace
+
+std::u16string TidyTitle(std::u16string_view title, const GURL& url) {
+  std::vector<Part> parts = SplitAtSeparators(title);
+  for (Part& part : parts) {
+    part.text = WithoutCounts(part.text);
+  }
+  std::erase_if(parts, [](const Part& part) {
+    return part.text.empty() || IsEmailAddress(part.text);
+  });
+  const std::set<std::string> site = SiteNames(url);
+  std::vector<Part> without_site = parts;
+  std::erase_if(without_site, [&site](const Part& part) {
+    return site.contains(Letters(part.text));
+  });
+  const bool site_named = without_site.size() != parts.size();
+  // The site's name alone ("(5) Messenger" on messenger.com) stays.
+  if (!without_site.empty()) {
+    parts = std::move(without_site);
+  }
+  // No part was the site's name: a short last part usually is ("Gmail").
+  if (!site_named && parts.size() >= 2 &&
+      WordCount(parts.back().text) <= 2) {
+    parts.pop_back();
+  }
+  std::u16string tidy;
+  for (const Part& part : parts) {
+    if (!tidy.empty()) {
+      tidy += part.separator.empty() ? u" " : part.separator;
+    }
+    tidy += part.text;
+  }
+  tidy = std::u16string(base::TrimWhitespace(tidy, base::TRIM_ALL));
+  if (tidy.size() <= 1) {
+    return std::u16string(title);
+  }
+  return tidy;
+}
+
+bool FileNameSaysNothing(const base::FilePath& name) {
+  const std::u16string base_name =
+      base::ToLowerASCII(name.BaseName().RemoveExtension().AsUTF16Unsafe());
+  std::u16string_view rest = base::TrimWhitespace(base_name, base::TRIM_ALL);
+  if (rest.empty() || IsDigits(rest)) {
+    return true;
+  }
+  // A hash or an id: one long run of letters, digits, '-' and '_', with a
+  // digit in it, that is hexadecimal (a hash, a UUID) or has more digits
+  // than letters (an id). "annual-report-2026" and
+  // "googlechromestandaloneenterprise64" say something.
+  if (rest.size() >= 16 &&
+      std::all_of(rest.begin(), rest.end(),
+                  [](char16_t c) {
+                    return base::IsAsciiAlphaNumeric(c) || c == u'-' ||
+                           c == u'_';
+                  }) &&
+      std::any_of(rest.begin(), rest.end(),
+                  [](char16_t c) { return base::IsAsciiDigit(c); })) {
+    const bool hex = std::all_of(rest.begin(), rest.end(), [](char16_t c) {
+      return base::IsHexDigit(c) || c == u'-' || c == u'_';
+    });
+    const auto digits = std::count_if(rest.begin(), rest.end(), [](char16_t c) {
+      return base::IsAsciiDigit(c);
+    });
+    const auto letters =
+        std::count_if(rest.begin(), rest.end(),
+                      [](char16_t c) { return base::IsAsciiAlpha(c); });
+    if (hex || digits > letters) {
+      return true;
+    }
+  }
+  // "download (3)", "download(3)", "file_2", "image-4", "export3".
+  if (!rest.empty() && rest.back() == u')') {
+    const size_t open = rest.rfind(u'(');
+    if (open != std::u16string_view::npos &&
+        IsDigits(rest.substr(open + 1, rest.size() - open - 2))) {
+      rest = base::TrimWhitespace(rest.substr(0, open), base::TRIM_ALL);
+    }
+  }
+  size_t end = rest.size();
+  while (end > 0 && base::IsAsciiDigit(rest[end - 1])) {
+    --end;
+  }
+  if (end > 0 && end < rest.size() &&
+      (rest[end - 1] == u'_' || rest[end - 1] == u'-' ||
+       rest[end - 1] == u' ')) {
+    --end;
+  }
+  rest = rest.substr(0, end);
+  for (std::string_view word : kNamesThatSayNothing) {
+    if (rest == base::ASCIIToUTF16(word)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+base::FilePath TidyDownloadName(const base::FilePath& name,
+                                std::u16string_view page_title,
+                                const GURL& page_url) {
+  // A name with no extension keeps it: the title's last dot would become
+  // one ("Setup.exe").
+  if (name.Extension().empty() || !FileNameSaysNothing(name)) {
+    return base::FilePath();
+  }
+  std::u16string safe;
+  for (char16_t c : TidyTitle(page_title, page_url)) {
+    const bool unsafe = c < 0x20 || c == 0x7F ||
+                        std::u16string_view(u"\\/:*?\"<>|").find(c) !=
+                            std::u16string_view::npos;
+    const char16_t kept = unsafe ? u' ' : c;
+    if (kept == u' ' && (safe.empty() || safe.back() == u' ')) {
+      continue;
+    }
+    safe.push_back(kept);
+  }
+  constexpr size_t kLongest = 120;
+  if (safe.size() > kLongest) {
+    size_t cut = kLongest;
+    // Not between the halves of a surrogate pair.
+    if ((safe[cut - 1] & 0xFC00) == 0xD800) {
+      --cut;
+    }
+    safe.resize(cut);
+  }
+  safe = std::u16string(base::TrimString(safe, u" .", base::TRIM_ALL));
+  if (safe.empty()) {
+    return base::FilePath();
+  }
+  // The checks Chromium's own name generation makes, which a name set after
+  // it would skip: no control or format characters (a right-to-left override
+  // would show "fdp.exe" as "exe.pdf"), and no name Windows reserves.
+  base::FilePath::StringType checked =
+      base::FilePath::FromUTF16Unsafe(safe).value();
+  base::i18n::ReplaceIllegalCharactersInPath(&checked, ' ');
+  safe = std::u16string(base::TrimWhitespace(
+      base::FilePath(checked).AsUTF16Unsafe(), base::TRIM_ALL));
+  safe = std::u16string(base::TrimString(safe, u" .", base::TRIM_ALL));
+  if (safe.empty()) {
+    return base::FilePath();
+  }
+  base::FilePath tidy = base::FilePath::FromUTF16Unsafe(safe);
+  if (FileNameSaysNothing(tidy)) {
+    return base::FilePath();
+  }
+  // A title that already ends in the extension ("Q3 report.pdf") keeps one.
+  const base::FilePath::StringType extension = name.Extension();
+  if (!base::EndsWith(safe, base::FilePath(extension).AsUTF16Unsafe(),
+                      base::CompareCase::INSENSITIVE_ASCII)) {
+    tidy = tidy.AddExtension(extension);
+  }
+  if (IsReservedOnWindows(tidy.BaseName().AsUTF16Unsafe())) {
+    return base::FilePath();
+  }
+  return tidy;
+}
+
+}  // namespace stedding
