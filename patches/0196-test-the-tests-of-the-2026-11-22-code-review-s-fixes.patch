+// P16-1b (Sf47, Sf49): a test of the place that passes, then a read for the
+// sheet that fails, names the failure and leaves sync off; the next test
+// passes. The read's own bridge was freed while it was still running, and
+// then written to (on S3 always, on WebDAV when `Stedding Sidebar` was there
+// already).
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceB13Test,
+                       AFailedReadAfterAPassingTestLeavesSyncOff) {
+  // Another computer's file: on WebDAV, `Stedding Sidebar` is there already
+  // and the test makes nothing.
+  place_->PutFile(sb::FileNameFor(kPeerB13), PeerFileB13(1));
+  faults_.fail_after_probe = true;
+  const base::DictValue answer = Test();
+  EXPECT_TRUE(faults_.probe_removed.load()) << "the test itself did not pass";
+  EXPECT_EQ("serverError", Failure(answer)) << answer.DebugString();
+  EXPECT_FALSE(service()->enabled());
