+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/security_principal.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/web_contents.h"
+
+namespace spaces {
+
+std::optional<content::StoragePartitionConfig>
+StoragePartitionConfigForProfileId(content::BrowserContext* browser_context,
+                                   std::string_view profile_id) {
+  if (!browser_context || profile_id.empty()) {
+    return std::nullopt;
+  }
+  return content::StoragePartitionConfig::Create(
+      browser_context, kSpacePartitionDomain, profile_id,
+      /*in_memory=*/false);
+}
+
+std::optional<content::StoragePartitionConfig> StoragePartitionConfigForSpace(
+    content::BrowserContext* browser_context,
+    const SpaceRegistry* registry,
+    const SpaceId& id) {
+  if (!registry) {
+    return std::nullopt;
+  }
+  const RegistryEntry* const entry = registry->Find(id);
+  if (!entry) {
+    return std::nullopt;
+  }
+  return StoragePartitionConfigForProfileId(browser_context, entry->profile_id);
+}
+
+bool IsSpaceStoragePartition(const content::StoragePartitionConfig& config) {
+  return config.partition_domain() == kSpacePartitionDomain &&
+         !config.partition_name().empty();
+}
+
+content::StoragePartitionConfig StoragePartitionConfigForWebContents(
+    content::WebContents* web_contents) {
+  if (!web_contents || !web_contents->GetSiteInstance()) {
+    return content::StoragePartitionConfig();
+  }
+  return web_contents->GetSiteInstance()
+      ->GetSecurityPrincipal()
+      .GetStoragePartitionConfig();
+}
+
+}  // namespace spaces
