+void FolderView::LightSpaceChip(std::optional<spaces::SpaceId> space) {
+  auto* const region =
+      space ? NearestOfClass<VerticalTabStripRegionView>(this)
+            : views::AsViewClass<VerticalTabStripRegionView>(
+                  chip_lit_in_.view());
+  chip_lit_in_.SetView(space ? region : nullptr);
+  if (region) {
+    region->LightSpaceChip(space);
+  }
+}
