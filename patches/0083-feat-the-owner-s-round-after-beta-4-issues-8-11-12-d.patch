+  tabs::TabInterface* const b = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const c = tabstrip()->GetTabAtIndex(2);
+  // a, Outer[Inner[Moving[b]]], c
+  tabs::FolderTabCollection* const outer = tabstrip()->AddToNewFolder({1});
+  ASSERT_NE(nullptr, outer);
+  tabs::FolderTabCollection* const inner = tabstrip()->AddToNewFolder({1});
+  ASSERT_NE(nullptr, inner);
+  tabs::FolderTabCollection* const moving = tabstrip()->AddToNewFolder({1});
+  ASSERT_NE(nullptr, moving);
+  ASSERT_EQ(inner, moving->GetParentCollection());
+  ASSERT_EQ(outer, inner->GetParentCollection());
+  tabs::TabCollection* const top = outer->GetParentCollection();
+  ASSERT_EQ(3u, top->ChildCount());
+
+  // Before c, as the block's rows read now: a, Moving[b], c.
+  EXPECT_TRUE(tabstrip()->MoveFolderInto(moving, top, 2));
+  EXPECT_EQ(top, moving->GetParentCollection());
+  EXPECT_EQ(3u, top->ChildCount()) << "Outer and Inner left the tree";
+  EXPECT_EQ(std::optional<size_t>(1), top->GetIndexOfCollection(moving));
+  EXPECT_EQ(moving, b->GetParentCollection());
