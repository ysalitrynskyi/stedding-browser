+// tabs R63, pins H14 (GitHub issue 26): a row dragged up onto the top half
+// of the first row under the Clear line takes the first place there, under
+// the line, and stays a tab. The side of the line was read from the dragged
+// rows' offset, which is zero while they follow the pointer, and laid out
+// only when the rows' order changed, so a row dropped in the first place
+// under the line became a pin, and none could be put there.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ARowDroppedOnTheFirstRowTakesTheTop) {
+  tabs::TabInterface* const pin = tabs().GetActiveTab();
+  model().SetSpacePinned(pin, true);
+  tabs::TabInterface* const one = AddBlankTab();
+  tabs::TabInterface* const two = AddBlankTab();
+  tabs::TabInterface* const three = AddBlankTab();
+  ASSERT_TRUE(IsAboveTheLine(pin));
+  ASSERT_FALSE(IsAboveTheLine(one));
+  stedding::test::KeepAboveOtherWindows(widget());
+
+  for (tabs::TabInterface* const dragged : {two, three}) {
+    SCOPED_TRACE(dragged == two ? "the second row" : "the last row");
+    tabs::TabInterface* const first =
+        tabs().GetTabAtIndex(tabs().GetIndexOfTab(pin) + 1);
+    ASSERT_NE(dragged, first);
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    const TabView* const row =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), dragged);
+    ASSERT_TRUE(row) << "the sidebar shows no row for the tab";
+    const gfx::Point from = row->GetBoundsInScreen().CenterPoint();
+    const gfx::Point to = JustInsideTheTopOf(first);
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, from);
+    constexpr int kSteps = 20;
+    for (int i = 1; i <= kSteps; ++i) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                     from.y() + (to.y() - from.y()) * i / kSteps));
+      EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    }
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, to);
+    base::RunLoop().RunUntilIdle();
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_EQ(tabs().GetIndexOfTab(pin) + 1, tabs().GetIndexOfTab(dragged))
+        << "the row did not take the first place under the line";
+    EXPECT_FALSE(model().IsSpacePinned(dragged)) << "the row became a pin";
+    EXPECT_FALSE(IsAboveTheLine(dragged));
+    EXPECT_TRUE(IsAboveTheLine(pin));
+    EXPECT_FALSE(IsAboveTheLine(first));
+  }
+}
