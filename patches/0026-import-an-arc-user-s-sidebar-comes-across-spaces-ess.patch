+void WelcomeHandler::HandleGetArcImport(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  spaces::LoadArcSidebarInfo(base::BindOnce(&WelcomeHandler::OnArcSidebarInfo,
+                                            weak_factory_.GetWeakPtr(),
+                                            args[0].GetString()));
+}
+
+void WelcomeHandler::OnArcSidebarInfo(const std::string& callback_id,
+                                      spaces::ArcSidebarInfo info) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::DictValue reply;
+  reply.Set("found", info.found);
+  reply.Set("arcRunning", info.arc_running);
+  reply.Set("summary", info.summary);
+  ResolveJavascriptCallback(base::Value(callback_id), reply);
+}
+
+void WelcomeHandler::HandleImportFromArc(const base::ListValue& args) {
+  CHECK_EQ(4U, args.size());
+  AllowJavascript();
+  const WelcomeHost* const host =
+      WelcomeHost::FromWebContents(web_ui()->GetWebContents());
+  BrowserWindowInterface* const browser = host ? host->browser() : nullptr;
+  spaces::ArcImportOptions options;
+  options.spaces = args[1].GetIfBool().value_or(true);
+  options.pinned = args[2].GetIfBool().value_or(true);
+  options.unpinned = args[3].GetIfBool().value_or(true);
+  spaces::ImportFromArcAsync(
+      browser, options,
+      base::BindOnce(&WelcomeHandler::OnArcImportDone,
+                     weak_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void WelcomeHandler::OnArcImportDone(
+    const std::string& callback_id,
+    std::optional<spaces::ArcImportResult> result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  ResolveJavascriptCallback(
+      base::Value(callback_id),
+      base::Value(result ? spaces::DescribeArcImportResult(*result)
+                         : u"Nothing was imported."));
+}
