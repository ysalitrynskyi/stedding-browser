+  TemplateURLService& engines = UseSearchEngines();
+  TemplateURLData extension;
+  extension.SetShortName(u"Extkeys");
+  extension.SetKeyword(u"ek");
+  extension.SetURL(
+      "chrome-extension://abcdefghijklmnopabcdefghijklmnop/?q={searchTerms}");
+  ASSERT_TRUE(engines.Add(std::make_unique<TemplateURL>(
+      extension, TemplateURL::OMNIBOX_API_EXTENSION,
+      "abcdefghijklmnopabcdefghijklmnop", base::Time::Now(),
+      /*wants_to_be_default_engine=*/false)));
+  AddTab(browser(), GURL("https://example.com/"));
+  const int tabs = browser()->GetTabStripModel()->count();
+  stedding::SetExtensionKeywordHandler(
+      {.can_hand_over = &MayHear, .hand_over = &Hear});
+  Heard().clear();
+  auto bar = std::make_unique<CommandBarView>(browser());
+
+  TypeInto(*bar, u"ek hello world");
+  ASSERT_GT(bar->row_count_for_testing(), 0u);
+  EXPECT_EQ(u"Extkeys", bar->row_detail_for_testing(0));
+  bar->HandleKeyEvent(bar->field_for_testing(), Press(ui::VKEY_RETURN));
+  stedding::SetExtensionKeywordHandler({});
+  ASSERT_EQ(1u, Heard().size());
+  EXPECT_EQ("abcdefghijklmnopabcdefghijklmnop", Heard()[0].extension_id);
+  EXPECT_EQ("hello world", Heard()[0].input);
+  EXPECT_EQ(tabs, browser()->GetTabStripModel()->count()) << "nothing opened";
+}
