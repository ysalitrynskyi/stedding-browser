+
+void PinMirror::OnSessionRestored(Profile* profile, int tab_count) {
+  if (profile != window_->GetProfile() || !waiting_for_restore_) {
+    return;
+  }
+  // A turn later: the restore's folders and splits are rebuilt first
+  // (FolderSessionService), and every window of it is in.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PinMirror::Settle, weak_factory_.GetWeakPtr()));
+}
+
+void PinMirror::Settle() {
+  Profile* const profile = window_->GetProfile();
+  if (SessionRestore::IsRestoring(profile)) {
+    // Another restore is under way (the crash bubble's Restore): wait for it.
+    if (!waiting_for_restore_) {
+      waiting_for_restore_ = true;
+      restored_subscription_ =
+          SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+              &PinMirror::OnSessionRestored, base::Unretained(this)));
+    }
+    return;
+  }
+  waiting_for_restore_ = false;
+  restored_subscription_ = {};
+  // windows G16: the window a tab drag tears off settles once the drag is
+  // over. Emptied by the drag, it closes and never does; kept, it gets every
+  // pin then. A window with no tab yet waits for one.
+  if (DragUnderWay() || window_->GetTabStripModel()->empty()) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&PinMirror::Settle, weak_factory_.GetWeakPtr()),
+        kDragRetry);
+    return;
+  }
+  settled_ = true;
+  takes_part_ = model_ && store_ &&
+                sidebar_sync::IsRegistryWindow(&window_.get(), profile);
+  if (!takes_part_) {
+    store_observation_.Reset();
+    if (root_) {
+      root_->RemoveObserver(this);
+      root_ = nullptr;
+    }
+    return;
+  }
+  if (!store_->ready()) {
+    FillStoreFromWindows(profile);
+    return;
+  }
+  Reconcile();
+}
+
+// static
+void PinMirror::FillStoreFromWindows(Profile* profile) {
+  PinStore* const store = PinStoreFactory::GetForProfile(profile);
+  if (!store || store->ready() || g_filling) {
+    return;
+  }
+  std::vector<BrowserWindowInterface*> windows =
+      sidebar_sync::RegistryWindows(profile);
+  // Once the restore is over, a window whose own turn to settle has not come
+  // yet is read too: it would else bring its pins back as loose tabs.
+  std::erase_if(windows, [](BrowserWindowInterface* window) {
+    PinMirror* const mirror = PinMirror::From(window);
+    return !mirror || !mirror->model_ || !mirror->store_ ||
+           window->GetTabStripModel()->closing_all();
+  });
+  std::ranges::sort(windows, [](BrowserWindowInterface* a,
+                                BrowserWindowInterface* b) {
+    return a->GetSessionID().id() < b->GetSessionID().id();
+  });
+  // windows G19: every window's sidebar is kept as it was, as sync's join
+  // keeps one (sidebar-file Sf9), before anything is merged.
+  for (BrowserWindowInterface* window : windows) {
+    const ArcImportPlan plan = SnapshotWindow(window);
+    if (plan.spaces.empty()) {
+      continue;
+    }
+    base::ThreadPool::PostTask(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(base::IgnoreResult(&sidebar_sync::WriteBackup),
+                       profile->GetPath(), PlanToJson(plan),
+                       base::Time::Now()));
+  }
+  std::vector<std::vector<PinRecord>> rows;
+  rows.reserve(windows.size());
+  for (BrowserWindowInterface* window : windows) {
+    rows.push_back(PinMirror::From(window)->BuildRecords());
+  }
+  {
+    base::AutoReset<bool> filling(&g_filling, true);
+    const std::vector<std::map<std::string, std::string>> ids =
+        store->Fill(rows);
+    // A tab that is a record an earlier window gave takes that record's id.
+    for (size_t w = 0; w < windows.size(); ++w) {
+      TabStripModel* const strip = windows[w]->GetTabStripModel();
+      PinMirror* const mirror = PinMirror::From(windows[w]);
+      for (int i = 0; i < strip->count(); ++i) {
+        tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+        if (!mirror->IsMirrored(tab)) {
+          continue;
+        }
+        const std::string token = stedding::TabToken(tab->GetContents());
+        const auto it = ids[w].find(token);
+        if (it != ids[w].end() && it->second != token) {
+          stedding::SetTabToken(tab, it->second);
+        }
+      }
+    }
+  }
+  for (BrowserWindowInterface* window : windows) {
+    PinMirror::From(window)->Reconcile();
+  }
+}
+
+void PinMirror::Reconcile() {
+  // A window with no tab left is closing: it takes none.
+  if (!Active() || !store_->ready() || waiting_for_restore_ || g_filling ||
+      reconciling_ || window_->GetTabStripModel()->empty()) {
+    return;
+  }
+  // windows G16: no window is brought in line while a tab drag runs.
+  if (DragUnderWay()) {
+    reconcile_after_drag_ = true;
+    WaitForTheDrag();
+    return;
+  }
+  // A change made here and not yet published goes first, so the store has it
+  // before this window is brought in line: a pin just made here, or one
+  // dropped in from a Blank Window, would else look like a record removed
+  // elsewhere.
+  if (publish_scheduled_) {
+    Publish();
+    if (!Active() || reconciling_) {
+      return;
+    }
+  }
+  if (ReconcileNow()) {
+    SchedulePublish();
+  }
+}
+
+bool PinMirror::ReconcileNow() {
+  base::AutoReset<bool> reconciling(&reconciling_, true);
+  SpaceModel::ScopedRoutingPause pause(model_.get());
+  // windows G16 (BACKLOG S-546): the sidebar redoes its list once, at the
+  // end, not for every tab made, filed or folded here.
+  SpaceModel::ScopedBulkFiling bulk(model_.get());
+  TabStripModel* const strip = window_->GetTabStripModel();
+
+  // The records this window can show: a record's Space must be here, and a
+  // folder it is in must not be one this window has under the Clear line
+  // (folders F38): that folder and its tabs stay as this window has them.
+  const std::map<std::string, tabs::FolderTabCollection*> folders =
+      FoldersById(*strip);
+  std::vector<const PinRecord*> wanted;
+  std::set<std::string> wanted_ids;
+  for (const PinRecord& record : store_->records()) {
+    if (record.has_space && !model_->GetSpace(record.space)) {
+      continue;
+    }
+    if (!record.folder_path.empty()) {
+      const std::vector<stedding::FolderPathEntry> path =
+          stedding::ParseFolderPath(record.folder_path);
+      const auto found =
+          path.empty() ? folders.end() : folders.find(path.front().id);
+      if (found != folders.end() &&
+          (found->second->GetParentCollection() != UnpinnedBlock(*strip) ||
+           !model_->IsFolderSpacePinned(found->second))) {
+        continue;
+      }
+    }
+    wanted.push_back(&record);
+    wanted_ids.insert(record.id);
+  }
+
+  // This window's tab of each record, and the tabs that are no record's.
+  std::map<std::string, tabs::TabInterface*> have;
+  // A record removed while this window had it (G15), and a tab that came back
+  // with an id the store no longer has, from a restore or History (G18).
+  std::vector<tabs::TabInterface*> let_go;
+  std::vector<tabs::TabInterface*> came_back;
+  // The ids of this window's tabs that are no row of the run: a pin whose
+  // folder here is under the Clear line keeps its id, and no second tab of
+  // its record is made.
+  std::set<std::string> held_here;
+  for (int i = 0; i < strip->count(); ++i) {
+    tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+    if (!IsMirrored(tab)) {
+      const std::string id = stedding::TabToken(tab->GetContents());
+      if (!id.empty()) {
+        held_here.insert(id);
+      }
+      continue;
+    }
+    const std::string id = stedding::TabToken(tab->GetContents());
+    if (id.empty()) {
+      continue;
+    }
+    if (!wanted_ids.contains(id)) {
+      // A record whose Space this window lacks is left as it is.
+      if (!store_->Find(id)) {
+        (seen_.contains(id) ? let_go : came_back).push_back(tab);
+      }
+      continue;
+    }
+    auto [it, fresh] = have.emplace(id, tab);
+    if (!fresh) {
+      // windows G16: two tabs of one record, one moved in from another
+      // window. The one awake, or on screen, stays the record's.
+      tabs::TabInterface* const other = it->second;
+      const bool keep_new = strip->GetActiveTab() == tab ||
+                            (Asleep(other) && !Asleep(tab));
+      it->second = keep_new ? tab : other;
+      let_go.push_back(keep_new ? other : tab);
+    }
+  }
+  for (tabs::TabInterface* tab : let_go) {
+    LetGo(tab, /*removed_here=*/true);
+  }
+  for (tabs::TabInterface* tab : came_back) {
+    LetGo(tab, /*removed_here=*/false);
+  }
+  // windows G16 (BACKLOG S-546): with many records to make (a new window of
+  // a profile with hundreds of pins) this pass makes the essentials and one
+  // Space's pins, the Space on screen first, then each other Space in the
+  // model's order, a task each. The window shows its own Space's pins at
+  // once, and the browser answers between Spaces: made all in one task, the
+  // window and every other stood still for seconds.
+  std::optional<SpaceId> making;
+  {
+    std::set<SpaceId> lacking;
+    size_t missing = 0;
+    for (const PinRecord* record : wanted) {
+      if (have.contains(record->id) || held_here.contains(record->id)) {
+        continue;
+      }
+      ++missing;
+      if (record->tier == PinTier::kSpacePin) {
+        lacking.insert(record->space);
+      }
+    }
+    if (missing > kMakeAtOnceUpTo && !lacking.empty()) {
+      if (lacking.contains(model_->active_id())) {
+        making = model_->active_id();
+      } else {
+        for (const std::unique_ptr<Space>& space : model_->spaces()) {
+          if (lacking.contains(space->id())) {
+            making = space->id();
+            break;
+          }
+        }
+      }
+    }
+  }
+  bool made_every_record = true;
+  // Each Space pin made here comes in after the essentials and the Space
+  // pins made before it, ahead of the loose tabs (Make); Order puts a run
+  // that holds older pins too in the store's order.
+  int space_pin_index = strip->IndexOfFirstNonPinnedTab();
+  for (const PinRecord* record : wanted) {
+    auto it = have.find(record->id);
+    if (it == have.end() && held_here.contains(record->id)) {
+      continue;
+    }
+    if (it == have.end() && making && record->tier == PinTier::kSpacePin &&
+        record->space != *making) {
+      made_every_record = false;
+      continue;
+    }
+    tabs::TabInterface* const tab =
+        it != have.end() ? it->second : Make(*record, space_pin_index);
+    if (it == have.end() && tab && record->tier == PinTier::kSpacePin) {
+      space_pin_index = strip->GetIndexOfTab(tab) + 1;
+    }
+    if (tab) {
+      Align(tab, *record);
+    }
+  }
+  Fold(wanted);
+  Order(wanted);
+  seen_ = std::move(wanted_ids);
+  // The next Space's pins, a task later.
+  if (!made_every_record) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&PinMirror::Reconcile, weak_factory_.GetWeakPtr()));
+  }
+  // What this window now holds. A tab given its id just now (a pin with
+  // none yet) is no record the store knows: it is published as one made
+  // here.
+  std::vector<PinRecord> records = BuildRecords();
+  const size_t all = records.size();
+  std::erase_if(records, [&](const PinRecord& record) {
+    return !store_->Find(record.id);
+  });
+  const bool made_here = records.size() != all;
+  Hold(std::move(records), {});
+  return made_here;
+}
+
+void PinMirror::LetGo(tabs::TabInterface* tab, bool removed_here) {
+  TabStripModel* const strip = window_->GetTabStripModel();
+  if (strip->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+    return;
+  }
+  // splits J4: the record let go is this pane's alone. A pane whose split's
+  // other pane is still a record leaves the split, which stays a pin.
+  if (const std::optional<split_tabs::SplitTabId> split = tab->GetSplit()) {
+    for (tabs::TabInterface* const peer : model_->SplitPeers(tab)) {
+      if (peer != tab &&
+          store_->Find(stedding::TabToken(peer->GetContents()))) {
+        strip->RemoveSplit(*split);
+        break;
+      }
+    }
+  }
+  const int index = strip->GetIndexOfTab(tab);
+  // windows G15: asleep, it closes without a trace; awake, it stays, a loose
+  // tab of its Space, with an id of its own. G18: one that came back with an
+  // id the store no longer has always stays, a loose tab.
+  if (removed_here && Asleep(tab) && strip->GetActiveTab() != tab) {
+    strip->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+    return;
+  }
+  stedding::SetTabToken(tab, stedding::NewTabToken());
+  if (tab->IsPinned()) {
+    strip->SetTabPinned(index, false);
+    return;
+  }
+  // A pin of a pinned folder leaves the folder first, so the folder stays
+  // all pins (folders F38) and the page lands with the loose tabs (H14).
+  if (InFolder(tab)) {
+    strip->MoveTabOutOfFolders(index);
+  }
+  model_->SetSpacePinned(tab, false);
+}
+
+tabs::TabInterface* PinMirror::Make(const PinRecord& record,
+                                    int space_pin_index) {
+  const GURL url = record.home.is_valid()   ? record.home
+                   : record.page.is_valid() ? record.page
+                                            : GURL(url::kAboutBlankURL);
+  const std::u16string& title = record.title.empty() ? record.name
+                                                     : record.title;
+  TabStripModel* const strip = window_->GetTabStripModel();
+  if (record.tier != PinTier::kSpacePin || !model_->GetSpace(record.space)) {
+    return InsertUnloadedTab(strip, window_->GetProfile(), url, title);
+  }
+  // windows G16 (BACKLOG S-546): a Space pin comes in filed, as a restored one
+  // does: in its Space, a pin, with its home, and ahead of the window's loose
+  // tabs, where its Space's run is. Made at the strip's end and then filed,
+  // pinned and moved into the run, each pin was a refiling and a move the
+  // sidebar redid its rows for, and a window of 443 pins took seconds.
+  // Align still checks every field.
+  return InsertUnloadedTabAt(
+      strip, window_->GetProfile(), url, title, space_pin_index,
+      [&](content::WebContents& contents) {
+        TabSpaceRestoreData::CreateForWebContents(
+            &contents, record.space.ToString(), /*space_pinned=*/true,
+            record.home.is_valid() ? record.home.spec() : std::string(),
+            /*own_essential=*/false);
+      });
+}
+
+void PinMirror::LeaveSplitUnlessPeersFollow(tabs::TabInterface* tab,
+                                            const PinRecord& record) {
+  const std::optional<split_tabs::SplitTabId> split = tab->GetSplit();
+  if (!split) {
+    return;
+  }
+  for (tabs::TabInterface* const peer : model_->SplitPeers(tab)) {
+    if (peer == tab) {
+      continue;
+    }
+    // The other pane's record calls for the same tier, Space and folders:
+    // the split moves whole.
+    const PinRecord* const theirs =
+        store_->Find(stedding::TabToken(peer->GetContents()));
+    if (!theirs || theirs->tier != record.tier ||
+        theirs->has_space != record.has_space ||
+        (record.has_space && theirs->space != record.space) ||
+        theirs->folder_path != record.folder_path) {
+      window_->GetTabStripModel()->RemoveSplit(*split);
+      return;
+    }
+  }
+}
+
+void PinMirror::Align(tabs::TabInterface* tab, const PinRecord& record) {
+  TabStripModel* const strip = window_->GetTabStripModel();
+  const auto index = [&] { return strip->GetIndexOfTab(tab); };
+  // splits J4: SpaceModel's verbs below take both panes of a split.
+  const bool moves =
+      record.tier == PinTier::kEssential
+          ? (model_->IsSpacePinned(tab) || !tab->IsPinned() ||
+             model_->IsOwnEssential(tab) != record.has_space ||
+             (record.has_space && model_->FindSpaceForTab(tab) != record.space))
+          : (tab->IsPinned() || !model_->IsSpacePinned(tab) ||
+             model_->FindSpaceForTab(tab) != record.space);
+  if (moves) {
+    LeaveSplitUnlessPeersFollow(tab, record);
+  }
+  if (record.tier == PinTier::kEssential) {
+    const bool own = record.has_space;
+    if (model_->IsSpacePinned(tab)) {
+      model_->SetSpacePinned(tab, false);
+    }
+    // spaces B6: whether an essential is its Space's own is settled when it
+    // is pinned, so one whose part changed is let go and pinned again.
+    if (tab->IsPinned() && model_->IsOwnEssential(tab) != own) {
+      strip->SetTabPinned(index(), false);
+    }
+    if (!tab->IsPinned()) {
+      if (own) {
+        model_->SetSpaceForTab(tab, record.space);
+      } else if (const std::optional<SpaceId> shared =
+                     model_->SpaceForSharedEssentials()) {
+        model_->SetSpaceForTab(tab, *shared);
+      }
+      strip->SetTabPinned(index(), true);
+      if (!own) {
+        model_->ShareEssential(tab);
+      }
+    } else if (own && model_->FindSpaceForTab(tab) != record.space) {
+      // windows G13, G21: an own essential moved to another Space elsewhere
+      // is refiled there, and stays that Space's own (ADR 0028).
+      model_->SetSpaceForTab(tab, record.space);
+    }
+  } else {
+    if (tab->IsPinned()) {
+      strip->SetTabPinned(index(), false);
+    }
+    if (model_->FindSpaceForTab(tab) != record.space) {
+      model_->SetSpaceForTab(tab, record.space);
+    }
+    if (!model_->IsSpacePinned(tab)) {
+      model_->SetSpacePinned(tab, true);
+    }
+  }
+  if (record.home.is_valid() && model_->HomeUrl(tab) != record.home) {
+    model_->SetHomeUrl(tab, record.home);
+  }
+  if (stedding::TabName(tab->GetContents()) != record.name) {
+    stedding::SetTabName(&window_.get(), tab, record.name);
+  }
+  if (stedding::HasSeparatorAbove(tab->GetContents()) != record.separator) {
+    stedding::SetSeparatorAbove(&window_.get(), tab, record.separator);
+  }
+  // Last: a Space with a session of its own gives a tab new contents when it
+  // is filed there, and the token rides on the contents.
+  if (stedding::TabToken(tab->GetContents()) != record.id) {
+    stedding::SetTabToken(tab, record.id);
+  }
+}
+
+void PinMirror::Fold(const std::vector<const PinRecord*>& records) {
+  TabStripModel* const strip = window_->GetTabStripModel();
+  std::map<std::string, tabs::TabInterface*> by_id;
+  for (int i = 0; i < strip->count(); ++i) {
+    tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+    if (IsMirrored(tab)) {
+      by_id[stedding::TabToken(tab->GetContents())] = tab;
+    }
+  }
+  for (const PinRecord* record : records) {
+    if (record->tier != PinTier::kSpacePin) {
+      continue;
+    }
+    const auto it = by_id.find(record->id);
+    if (it == by_id.end()) {
+      continue;
+    }
+    tabs::TabInterface* const tab = it->second;
+    if (strip->GetIndexOfTab(tab) == TabStripModel::kNoTab ||
+        !model_->IsSpacePinned(tab) ||
+        stedding::FolderPathForTab(tab) == record->folder_path) {
+      continue;
+    }
+    const std::vector<stedding::FolderPathEntry> path =
+        stedding::ParseFolderPath(record->folder_path);
+    std::vector<std::string> wanted_ids;
+    for (const stedding::FolderPathEntry& entry : path) {
+      wanted_ids.push_back(entry.id);
+    }
+    // splits J4: a split moves into or out of a folder whole.
+    LeaveSplitUnlessPeersFollow(tab, *record);
+    // In the wrong folders: out of every one first, to the top level just
+    // after the outermost (folders F37), then into the record's.
+    if (FolderIdsOf(tab) != wanted_ids && InFolder(tab)) {
+      strip->MoveTabOutOfFolders(strip->GetIndexOfTab(tab));
+    }
+    if (path.empty()) {
+      continue;
+    }
+    std::map<std::string, tabs::FolderTabCollection*> folders =
+        FoldersById(*strip);
+    tabs::FolderTabCollection* parent = nullptr;
+    for (const stedding::FolderPathEntry& entry : path) {
+      tabs::FolderTabCollection* folder = nullptr;
+      if (const auto found = folders.find(entry.id); found != folders.end()) {
+        folder = found->second;
+        // A folder moved into another one, or out of it, elsewhere goes
+        // whole (folders F39).
+        tabs::TabCollection* const container =
+            parent ? static_cast<tabs::TabCollection*>(parent)
+                   : UnpinnedBlock(*strip);
+        if (container && folder->GetParentCollection() != container) {
+          strip->MoveFolderInto(folder, container, container->ChildCount());
+        }
+      } else {
+        std::optional<tabs::FolderId> id;
+        if (const std::optional<base::Token> token =
+                base::Token::FromString(entry.id)) {
+          id = tabs::FolderId::FromRawToken(*token);
+        }
+        folder = strip->AddToNewFolder(IndicesMovingWith(*strip, *tab),
+                                       parent, id);
+        if (!folder) {
+          break;
+        }
+        folders.emplace(entry.id, folder);
+      }
+      if (!folder) {
+        break;
+      }
+      parent = folder;
+    }
+    if (parent && FolderIdsOf(tab) != wanted_ids) {
+      strip->MoveTabsToFolder(IndicesMovingWith(*strip, *tab), parent);
+    }
+  }
+  // Each folder's name, icon and open or closed state, as its records have
+  // it (windows G13). Every record of one folder carries the same.
+  const std::map<std::string, tabs::FolderTabCollection*> folders =
+      FoldersById(*strip);
+  for (const PinRecord* record : records) {
+    if (record->folder_path.empty()) {
+      continue;
+    }
+    for (const stedding::FolderPathEntry& entry :
+         stedding::ParseFolderPath(record->folder_path)) {
+      const auto found = folders.find(entry.id);
+      if (found == folders.end()) {
+        continue;
+      }
+      tabs::FolderTabCollection* const folder = found->second;
+      folder->SetTitle(entry.title);
+      folder->SetIcon(entry.icon);
+      folder->SetCollapsed(entry.collapsed);
+    }
+  }
+}
+
+void PinMirror::Order(const std::vector<const PinRecord*>& records) {
+  TabStripModel* const strip = window_->GetTabStripModel();
+  std::map<std::string, tabs::TabInterface*> by_id;
+  for (int i = 0; i < strip->count(); ++i) {
+    tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+    if (IsMirrored(tab)) {
+      by_id[stedding::TabToken(tab->GetContents())] = tab;
+    }
+  }
+  // The essentials: the pinned block, in the store's order.
+  std::vector<tabs::TabInterface*> essentials;
+  // Each Space's rows, in the store's order: a pin, a split, or a pinned
+  // folder, which is one row of the run (folders F38). And each folder's own
+  // rows, in the same order.
+  std::map<SpaceId, std::vector<Node>> runs;
+  std::map<const tabs::TabCollection*, std::vector<Node>> inside;
+  // A Space whose run has a split as a row: its panes are left in place.
+  std::set<SpaceId> with_split;
+  for (const PinRecord* record : records) {
+    const auto it = by_id.find(record->id);
+    if (it == by_id.end()) {
+      continue;
+    }
+    tabs::TabInterface* const tab = it->second;
+    if (record->tier == PinTier::kEssential) {
+      if (tab->IsPinned()) {
+        essentials.push_back(tab);
+      }
+      continue;
+    }
+    if (!model_->IsSpacePinned(tab)) {
+      continue;
+    }
+    Node node = tab;
+    bool split_row = false;
+    for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+         each = each->GetParentCollection()) {
+      if (each->type() == tabs::TabCollection::Type::SPLIT) {
+        split_row = true;
+        node = each;
+      } else if (each->type() == tabs::TabCollection::Type::FOLDER) {
+        AppendOnce(inside[each], node);
+        node = each;
+        split_row = false;
+      } else {
+        break;
+      }
+    }
+    if (split_row) {
+      with_split.insert(record->space);
+    }
+    AppendOnce(runs[record->space], node);
+  }
+  for (size_t k = 0; k < essentials.size(); ++k) {
+    const int from = strip->GetIndexOfTab(essentials[k]);
+    if (from != TabStripModel::kNoTab && from != static_cast<int>(k)) {
+      strip->MoveWebContentsAt(from, static_cast<int>(k), false);
+    }
+  }
+  // A folder's rows out of the store's order are put in it, whole, the rest
+  // after them (folders F31's reorder).
+  if (!inside.empty()) {
+    const std::map<std::string, tabs::FolderTabCollection*> folders =
+        FoldersById(*strip);
+    for (const auto& [id, folder] : folders) {
+      const auto wanted = inside.find(folder);
+      if (wanted == inside.end()) {
+        continue;
+      }
+      std::vector<Node> now;
+      for (const tabs::Child& child : folder->GetChildren()) {
+        now.push_back(NodeOf(child));
+      }
+      std::vector<size_t> order;
+      for (const Node& node : wanted->second) {
+        if (const auto at = std::ranges::find(now, node); at != now.end()) {
+          order.push_back(static_cast<size_t>(at - now.begin()));
+        }
+      }
+      for (size_t i = 0; i < now.size(); ++i) {
+        if (std::ranges::find(order, i) == order.end()) {
+          order.push_back(i);
+        }
+      }
+      bool same = true;
+      for (size_t i = 0; i < order.size(); ++i) {
+        same &= order[i] == i;
+      }
+      if (!same && order.size() == now.size()) {
+        strip->ReorderFolder(folder, order);
+      }
+    }
+  }
+  // Each Space's run: when its rows' order is not the store's, each row goes
+  // to the end of the run in turn (pins H14), a pinned folder whole. A split's
+  // panes are left in place.
+  const std::map<std::string, tabs::FolderTabCollection*> folders =
+      FoldersById(*strip);
+  for (auto& [space, run] : runs) {
+    std::vector<Node> now = run;
+    std::ranges::sort(now, [&](const Node& a, const Node& b) {
+      return strip->GetIndexOfTab(FirstTabOf(a)) <
+             strip->GetIndexOfTab(FirstTabOf(b));
+    });
+    if (now == run || with_split.contains(space)) {
+      continue;
+    }
+    for (const Node& row : run) {
+      if (const auto* const tab = std::get_if<tabs::TabInterface*>(&row)) {
+        model_->MoveToSpacePinBoundary(*tab);
+        continue;
+      }
+      const auto* const collection = std::get<const tabs::TabCollection*>(row);
+      for (const auto& [id, folder] : folders) {
+        if (folder == collection) {
+          model_->SetFolderSpacePinned(folder, true);
+          break;
+        }
+      }
+    }
+  }
+}
+
