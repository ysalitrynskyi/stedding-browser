+// routing D13: a rule's text, edited where it is listed.
+
+// `body`, run on the settings page with `card`, the routes card's own shadow
+// root, once it is drawn; null while it is not.
+std::string OnTheCardW2B02(std::string_view body) {
+  return OnThePageW2B02(base::StrCat({R"(
+      const host = pick('settings-stedding-routes-card');
+      const card = host ? host.shadowRoot : null;
+  )",
+                                      body}));
+}
+
+// Sets the text field of the row whose text is $1 to $2, as a person leaves
+// a field they typed in.
+constexpr char kEditTextW2B02[] = R"(
+  const row = [...card.querySelectorAll('.route-rule')].find(
+      each => each.querySelector('cr-input.route-text').value === $1);
+  const field = row.querySelector('cr-input.route-text');
+  field.value = $2;
+  field.dispatchEvent(new Event('change'));
+  return '';
+)";
+
+class RoutesCardW2B02Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model);
+    home_ = model->active_id().ToString();
+    prefs_ = browser()->GetProfile()->GetPrefs();
+  }
+
+  void TearDownOnMainThread() override {
+    prefs_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  // The first row's field: "<its text>|<whether it says it was refused>".
+  static std::string FirstField(content::WebContents* page) {
+    return content::EvalJs(page, OnTheCardW2B02(R"(
+        const field = card &&
+            card.querySelector('.route-rule cr-input.route-text');
+        return field ? field.value + '|' + String(field.invalid) : '';)"))
+        .ExtractString();
+  }
+
+  raw_ptr<PrefService> prefs_ = nullptr;
+  std::string home_;
+};
+
+// P03-1d, routing D13: an edit the browser takes that comes to the rule as
+// it was (a subdomain of its site, the site as an address) changes no
+// preference; the field shows the rule that is stored, not what was typed.
+IN_PROC_BROWSER_TEST_F(RoutesCardW2B02Test,
+                       AnEditThatComesToTheSameRuleShowsTheStoredRule) {
+  spaces::Route rule;
+  rule.match = spaces::Route::Match::kSite;
+  rule.pattern = "github.com";
+  rule.space = home_;
+  spaces::AddRoute(prefs_, rule);
+  content::WebContents* const page =
+      OpenSettingsW2B02(browser(), "settings-stedding-routes-card");
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return FirstField(page) == "github.com|false"; }))
+      << FirstField(page);
+
+  for (const char* typed : {"gist.github.com", "https://GitHub.com/org"}) {
+    SCOPED_TRACE(typed);
+    ASSERT_TRUE(content::ExecJs(
+        page, OnTheCardW2B02(
+                  content::JsReplace(kEditTextW2B02, "github.com", typed))));
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return FirstField(page) == "github.com|false"; }))
+        << "the field shows a rule that does not exist: " << FirstField(page);
+    const std::vector<spaces::Route> rules = spaces::ReadRoutes(prefs_);
+    ASSERT_EQ(1u, rules.size());
+    EXPECT_EQ("github.com", rules[0].pattern);
+    EXPECT_EQ(spaces::Route::Match::kSite, rules[0].match);
+  }
+}
