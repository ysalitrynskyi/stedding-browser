+void PageThemeColorController::SampleTop() {
+  content::WebContents* const contents = web_contents();
+  if (!contents || sample_in_flight_ ||
+      contents->GetVisibility() != content::Visibility::VISIBLE) {
+    return;
+  }
+  content::RenderWidgetHostView* const view =
+      contents->GetRenderWidgetHostView();
+  if (!view || !view->IsSurfaceAvailableForCopy()) {
+    return;
+  }
+  const gfx::Size viewport = view->GetVisibleViewportSize();
+  const int width = viewport.width() - kPageTopRightMargin;
+  if (width < kPageTopMinSamples * kPageTopSampleSpacing ||
+      viewport.height() < kPageTopStripHeight) {
+    return;
+  }
+  sample_in_flight_ = true;
+  // The result may come back on another sequence; the controller and the
+  // page live on this one.
+  view->CopyFromSurface(
+      gfx::Rect(0, 0, width, kPageTopStripHeight),
+      gfx::Size(width / kPageTopSampleSpacing, kPageTopStripHeight),
+      kSampleTimeout,
+      base::BindPostTask(
+          base::SequencedTaskRunner::GetCurrentDefault(),
+          base::BindOnce(&PageThemeColorController::OnTopSampled,
+                         weak_factory_.GetWeakPtr(),
+                         contents->GetPrimaryPage().GetWeakPtr())));
