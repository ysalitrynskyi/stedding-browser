+// Dn9: every http and https request from the page's load to after the press
+// is one the page itself makes. The interceptor sees them all, whatever their
+// host.
+IN_PROC_BROWSER_TEST_F(DrmNoticeTest, TheBarAsksTheNetworkForNothing) {
+  base::Lock lock;
+  std::vector<GURL> asked;
+  content::URLLoaderInterceptor watch(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* params) {
+        base::AutoLock hold(lock);
+        asked.push_back(params->url_request.url);
+        return false;
+      }));
+  bool pressed = false;
+  stedding::ScopedDrmNoticeOpenerForTesting opener(
+      base::BindLambdaForTesting([&](const GURL&) { pressed = true; }));
+
+  const GURL url = Url("www.netflix.com");
+  ASSERT_NO_FATAL_FAILURE(Open(url));
+  ASSERT_TRUE(BarOn(contents()));
+  ASSERT_NO_FATAL_FAILURE(PressTheButton(BarOn(contents())));
+  ASSERT_TRUE(pressed);
+  // A round trip to the page, so that anything the press sent has been seen.
+  ASSERT_TRUE(content::ExecJs(contents(), "fetch('/title1.html')"));
+
+  const GURL favicon = Url("www.netflix.com", "/favicon.ico");
+  const GURL round_trip = Url("www.netflix.com", "/title1.html");
+  base::AutoLock hold(lock);
+  for (const GURL& request : asked) {
+    if (request.SchemeIsHTTPOrHTTPS()) {
+      EXPECT_TRUE(request == url || request == favicon || request == round_trip)
+          << request;
+    }
+  }
+}
