+bool ImportJobs::IsRunning(std::string_view source) const {
+  return running_.find(source) != running_.end();
+}
+
+bool ImportJobs::Start(std::string_view source,
+                       std::unique_ptr<ImportJob> job) {
+  if (IsRunning(source)) {
+    return false;
+  }
+  running_.emplace(std::string(source), std::move(job));
+  return true;
+}
+
+void ImportJobs::Finish(std::string_view source) {
+  const auto found = running_.find(source);
+  if (found == running_.end()) {
+    return;
+  }
+  std::unique_ptr<ImportJob> job = std::move(found->second);
+  running_.erase(found);
+  if (job) {
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               std::move(job));
+  }
+}
+
+void ImportJobs::OnProfileWillBeDestroyed(Profile* profile) {
+  observation_.Reset();
+  // Before the profile's services go: the jobs hold the presenter and the
+  // importers that use them.
+  running_.clear();
+}
+
+std::u16string CountOf(size_t count,
+                       std::u16string_view one,
+                       std::u16string_view many) {
+  std::u16string text = base::NumberToString16(count);
+  text.push_back(u' ');
+  text.append(count == 1 ? one : many);
+  return text;
+}
+
+std::u16string ListInWords(const std::vector<std::u16string>& parts) {
+  std::u16string text;
+  for (size_t i = 0; i < parts.size(); ++i) {
+    if (i > 0) {
+      text.append(i + 1 == parts.size() ? u" and " : u", ");
+    }
+    text.append(parts[i]);
+  }
+  return text;
+}
+
+}  // namespace stedding
