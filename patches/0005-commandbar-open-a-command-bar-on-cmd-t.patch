+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class CommandBarViewTest : public BrowserWithTestWindowTest {
+ protected:
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+};
+
+// spaces B13: the bar lists tabs from every Space, and choosing one in
+// another Space switches to that Space and activates the tab.
+TEST_F(CommandBarViewTest, ChoosingATabInAnotherSpaceSwitchesToIt) {
+  const spaces::SpaceId home = model().active_id();
+  AddTab(browser(), GURL("https://example.com/"));
+  tabs::TabInterface* const in_home = tabs().GetActiveTab();
+  spaces::Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  model().SetActiveSpace(work->id());
+  AddTab(browser(), GURL("https://example.org/"));
+  tabs::TabInterface* const in_work = tabs().GetActiveTab();
+  model().SetActiveSpace(home);
+  ASSERT_EQ(in_home, tabs().GetActiveTab());
+
+  // Not shown in a window; the model half needs no widget.
+  auto bar = std::make_unique<CommandBarView>(browser());
+  // Every tab, in strip order: the fixture inserts at index 0, so the Work
+  // tabs come first. The tab the switch opened in Work is there too.
+  ASSERT_EQ(static_cast<size_t>(tabs().count()), bar->result_count_for_testing());
+
+  bar->GoToResultForTesting(
+      static_cast<size_t>(tabs().GetIndexOfTab(in_work)));
+  EXPECT_EQ(work->id(), model().active_id());
+  EXPECT_EQ(in_work, tabs().GetActiveTab());
+}
+
+// spaces B13: typing filters by title, and the field is the bar's own.
+TEST_F(CommandBarViewTest, TypingFiltersByTitle) {
+  AddTab(browser(), GURL("https://example.com/"));
+  auto bar = std::make_unique<CommandBarView>(browser());
+  ASSERT_EQ(1u, bar->result_count_for_testing());
+  bar->ContentsChanged(bar->field_for_testing(), u"no such title");
+  EXPECT_EQ(0u, bar->result_count_for_testing());
+}
+
+}  // namespace
+}  // namespace stedding
