new file mode 100644
index 0000000000000..52fb61157c35f
--- /dev/null
+++ b/chrome/browser/ui/stedding/blocker/blocker_convert.cc
@@ -0,0 +1,222 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/blocker/blocker_convert.h"
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "components/subresource_filter/core/common/unindexed_ruleset.h"
+#include "components/subresource_filter/tools/rule_parser/rule.h"
+#include "components/subresource_filter/tools/rule_parser/rule_parser.h"
+#include "crypto/hash.h"
+#include "third_party/protobuf/src/google/protobuf/io/zero_copy_stream_impl_lite.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr base::TimeDelta kShortestExpiry = base::Days(1);
+constexpr base::TimeDelta kLongestExpiry = base::Days(14);
+constexpr base::TimeDelta kExpiryWhenMissing = base::Days(4);
+
+// The header of a list is its first lines; the Expires line sits there.
+constexpr size_t kHeaderLines = 60;
+
+constexpr std::string_view kUtf8Bom = "\xEF\xBB\xBF";
+
+std::string_view WithoutBom(std::string_view text) {
+  if (text.starts_with(kUtf8Bom)) {
+    text.remove_prefix(kUtf8Bom.size());
+  }
+  return text;
+}
+
+void DeleteOtherVersions(const base::FilePath& dir,
+                         const base::FilePath& keep_ruleset,
+                         const base::FilePath& keep_license) {
+  for (const base::FilePath::StringType& pattern :
+       {base::FilePath::StringType(FILE_PATH_LITERAL("rules-*.dat")),
+        base::FilePath::StringType(FILE_PATH_LITERAL("LICENSE-*.txt"))}) {
+    base::FileEnumerator files(dir, /*recursive=*/false,
+                               base::FileEnumerator::FILES, pattern);
+    for (base::FilePath file = files.Next(); !file.empty();
+         file = files.Next()) {
+      if (file != keep_ruleset && file != keep_license) {
+        // A file the ruleset service still reads may not go on Windows; it
+        // goes with the next conversion.
+        base::DeleteFile(file);
+      }
+    }
+  }
+}
+
+}  // namespace
+
+ConvertResult::ConvertResult() = default;
+ConvertResult::ConvertResult(const ConvertResult&) = default;
+ConvertResult& ConvertResult::operator=(const ConvertResult&) = default;
+ConvertResult::~ConvertResult() = default;
+
+base::TimeDelta ListExpiry(std::string_view text) {
+  size_t lines = 0;
+  for (std::string_view line :
+       base::SplitStringPiece(WithoutBom(text), "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (++lines > kHeaderLines) {
+      break;
+    }
+    if (!line.starts_with("!")) {
+      continue;
+    }
+    line.remove_prefix(1);
+    line = base::TrimWhitespaceASCII(line, base::TRIM_LEADING);
+    constexpr std::string_view kExpires = "expires:";
+    if (line.size() < kExpires.size() ||
+        !base::EqualsCaseInsensitiveASCII(line.substr(0, kExpires.size()),
+                                          kExpires)) {
+      continue;
+    }
+    line.remove_prefix(kExpires.size());
+    const std::vector<std::string_view> words = base::SplitStringPiece(
+        line, " \t", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    int amount = 0;
+    if (words.size() < 2 || !base::StringToInt(words[0], &amount) ||
+        amount <= 0) {
+      return kExpiryWhenMissing;
+    }
+    const std::string unit = base::ToLowerASCII(words[1]);
+    base::TimeDelta expiry = kExpiryWhenMissing;
+    if (unit.starts_with("day")) {
+      expiry = base::Days(amount);
+    } else if (unit.starts_with("hour")) {
+      expiry = base::Hours(amount);
+    }
+    return std::clamp(expiry, kShortestExpiry, kLongestExpiry);
+  }
+  return kExpiryWhenMissing;
+}
+
+bool LooksLikeFilterList(std::string_view text) {
+  text = base::TrimWhitespaceASCII(WithoutBom(text), base::TRIM_LEADING);
+  return text.starts_with("[Adblock");
+}
+
+ConvertResult ConvertLists(const std::vector<ListSource>& lists,
+                           const base::FilePath& out_dir,
+                           std::string_view salt,
+                           size_t minimum_rules) {
+  ConvertResult result;
+  if (lists.empty() || !base::CreateDirectory(out_dir)) {
+    return result;
+  }
+
+  std::string ruleset;
+  // The StringOutputStream must outlive the writer, and the string is whole
+  // once the writer has finished.
+  std::string fingerprint;
+  {
+    google::protobuf::io::StringOutputStream output(&ruleset);
+    subresource_filter::UnindexedRulesetWriter writer(&output);
+    subresource_filter::RuleParser parser;
+    // Bk11: a list that fails stops the conversion, but the writer is
+    // finished all the same below: it CHECKs, on its way out, that no rule it
+    // took is left unwritten, and a broken download crashed the browser.
+    bool failed = false;
+    for (const ListSource& list : lists) {
+      std::string text;
+      if (!base::ReadFileToString(list.path, &text) ||
+          !LooksLikeFilterList(text)) {
+        failed = true;
+        break;
+      }
+      base::StrAppend(
+          &fingerprint,
+          {list.id, ":", base::HexEncodeLower(crypto::hash::Sha256(text)),
+           "\n"});
+      size_t list_rules = 0;
+      for (std::string_view line :
+           base::SplitStringPiece(WithoutBom(text), "\n",
+                                  base::TRIM_WHITESPACE,
+                                  base::SPLIT_WANT_NONEMPTY)) {
+        // The header line and comments carry no rule.
+        if (line.starts_with("[") || line.starts_with("!")) {
+          continue;
+        }
+        switch (parser.Parse(line)) {
+          case url_pattern_index::proto::RULE_TYPE_URL:
+            if (!writer.AddUrlRule(parser.url_rule().ToProtobuf())) {
+              failed = true;
+              break;
+            }
+            ++list_rules;
+            break;
+          case url_pattern_index::proto::RULE_TYPE_STYLE:
+            ++result.cosmetic_rules;
+            break;
+          case url_pattern_index::proto::RULE_TYPE_COMMENT:
+            break;
+          default:
+            if (parser.parse_error().error_code !=
+                subresource_filter::RuleParser::ParseError::EMPTY_RULE) {
+              ++result.skipped_lines;
+            }
+            break;
+        }
+        if (failed) {
+          break;
+        }
+      }
+      // A list cut short, or one that is something else under the right
+      // header, gives far fewer rules than the real one.
+      if (failed || list_rules < minimum_rules) {
+        failed = true;
+        break;
+      }
+      result.url_rules += static_cast<int>(list_rules);
+    }
+    // A writer that met an error has nothing pending, and may not be
+    // finished.
+    const bool finished = !writer.had_error() && writer.Finish();
+    if (failed || !finished) {
+      return result;
+    }
+  }
+
+  base::StrAppend(&fingerprint, {"salt:", salt});
+  result.content_version =
+      base::HexEncodeLower(crypto::hash::Sha256(fingerprint)).substr(0, 16);
+  result.ruleset_path = out_dir.AppendASCII(
+      base::StrCat({"rules-", result.content_version, ".dat"}));
+  result.license_path = out_dir.AppendASCII(
+      base::StrCat({"LICENSE-", result.content_version, ".txt"}));
+
+  std::string license =
+      "The rules in this folder were converted on this computer from the "
+      "filter lists below, fetched from their own homepages. Each list keeps "
+      "its own licence.\n\n";
+  for (const ListSource& list : lists) {
+    base::StrAppend(&license, {list.name, "\n  Homepage: ", list.homepage,
+                               "\n  Licence: ", list.licence, "\n\n"});
+  }
+  if (!base::ImportantFileWriter::WriteFileAtomically(result.ruleset_path,
+                                                      ruleset) ||
+      !base::ImportantFileWriter::WriteFileAtomically(result.license_path,
+                                                      license)) {
+    return result;
+  }
+  DeleteOtherVersions(out_dir, result.ruleset_path, result.license_path);
+  result.ok = true;
+  return result;
+}
+
+}  // namespace stedding
