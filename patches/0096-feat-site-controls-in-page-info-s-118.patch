+// site-controls Si7 (BACKLOG S-118), sessions S32: the site controls' session
+// row names the jar the page lives in. A page in Work with its session on
+// reads "Work · Independent session" with the cookie mark, its description
+// the mark's; a page in Home reads "Shared session", unmarked; with Work's
+// session turned off, its page moves to the shared jar and reads "Shared
+// session" too.
+IN_PROC_BROWSER_TEST_F(IsolationMarkTest, TheSiteControlsNameTheJar) {
+  // The site controls' rows for the active tab, from the site chip; the
+  // panel closes when `check` has run.
+  const auto with_rows =
+      [&](base::FunctionRef<void(stedding::SiteControlsRowsView*)> check) {
+        ASSERT_TRUE(
+            browser_view()->GetLocationBarView()->ShowPageInfoDialog());
+        views::BubbleDialogDelegateView* panel = nullptr;
+        ASSERT_TRUE(base::test::RunUntil([&]() {
+          panel = PageInfoBubbleViewBase::GetPageInfoBubbleForTesting();
+          return panel && panel->GetWidget() &&
+                 panel->GetWidget()->IsVisible();
+        })) << "no page info";
+        std::vector<views::View*> stack = {panel};
+        stedding::SiteControlsRowsView* rows = nullptr;
+        while (!stack.empty() && !rows) {
+          views::View* const view = stack.back();
+          stack.pop_back();
+          rows = views::AsViewClass<stedding::SiteControlsRowsView>(view);
+          for (views::View* child : view->children()) {
+            stack.push_back(child);
+          }
+        }
+        ASSERT_TRUE(rows) << "no site controls in page info";
+        check(rows);
+        panel->GetWidget()->CloseNow();
+        ASSERT_TRUE(base::test::RunUntil([]() {
+          return !PageInfoBubbleViewBase::GetPageInfoBubbleForTesting();
+        }));
+      };
+
+  model()->SetSpaceIsolated(work_, true);
+  ASSERT_TRUE(model()->SetActiveSpace(work_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("a.test"), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const work_tab = tabs()->GetActiveTab();
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(
+      spaces::StoragePartitionConfigForWebContents(work_tab->GetContents())));
+  {
+    SCOPED_TRACE("Work, its session on");
+    with_rows([&](stedding::SiteControlsRowsView* rows) {
+      ASSERT_TRUE(rows->session_row()->GetVisible());
+      EXPECT_EQ(spaces::NameWithIsolationMark(u"Work"),
+                rows->session_row()->GetTitleForTesting());
+      EXPECT_TRUE(rows->session_mark()->GetVisible()) << "no cookie mark";
+      EXPECT_EQ(
+          Says(),
+          rows->session_row()->GetViewAccessibility().GetCachedDescription());
+      EXPECT_EQ(Says(), rows->session_row()->GetTooltipText());
+    });
+  }
+
+  ASSERT_TRUE(model()->SetActiveSpace(home_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("a.test"), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  {
+    SCOPED_TRACE("Home");
+    with_rows([&](stedding::SiteControlsRowsView* rows) {
+      ASSERT_TRUE(rows->session_row()->GetVisible());
+      EXPECT_EQ(u"Shared session", rows->session_row()->GetTitleForTesting());
+      EXPECT_FALSE(rows->session_mark()->GetVisible());
+    });
+  }
+
+  model()->SetSpaceIsolated(work_, false);
+  ASSERT_TRUE(model()->SetActiveSpace(work_));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    content::WebContents* const contents =
+        tabs()->GetActiveTab()->GetContents();
+    return !spaces::IsSpaceStoragePartition(
+               spaces::StoragePartitionConfigForWebContents(contents)) &&
+           !contents->IsLoading();
+  })) << "Work's page did not move to the shared jar";
+  {
+    SCOPED_TRACE("Work, its session off");
+    with_rows([&](stedding::SiteControlsRowsView* rows) {
+      EXPECT_EQ(u"Shared session", rows->session_row()->GetTitleForTesting());
+      EXPECT_FALSE(rows->session_mark()->GetVisible())
+          << "S32 marks only a session that is on";
+    });
+  }
+}
+
 }  // namespace
