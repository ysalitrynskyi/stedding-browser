+// sessions S47 (ADR 0028, ADR 0032): an essential of a session shows in every
+// Space on that jar, using it there brings no other Space, and a Space on
+// another jar does not show it.
+TEST_F(SharedSessionWindowTest, SpacesOfOneSessionShareTheirEssentials) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const shared = OpenTab();
+  tabs().SetTabPinned(tabs().GetIndexOfTab(shared), true);
+  const SpaceId mail = model().AddSpace("Mail", kBlue)->id();
+  const SpaceId docs = model().AddSpace("Docs", kBlue)->id();
+  ShareSession(mail, docs);
+  tabs::TabInterface* const own = OpenTabIn(mail);
+  tabs().SetTabPinned(tabs().GetIndexOfTab(own), true);
+  task_environment()->RunUntilIdle();
+  ASSERT_TRUE(model().IsOwnEssential(own));
+
+  model().SetActiveSpace(docs);
+  EXPECT_FALSE(model().HidesTab(own)) << "Mail's essential in Docs";
+  EXPECT_TRUE(model().HidesTab(shared));
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(own));
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(docs, model().active_id()) << "using it brought its Space";
+
+  model().SetActiveSpace(home);
+  EXPECT_TRUE(model().HidesTab(own));
+  EXPECT_FALSE(model().HidesTab(shared));
+}
