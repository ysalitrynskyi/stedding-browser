+  // blocker Bk2, Bk9: what a list blocks, where it comes from and under what
+  // licence, and when it was last fetched.
+  protected blockerListLine_(id: string): string {
+    const what = loadTimeData.getString(
+        id === 'easylist' ? 'steddingBlockerEasyListWhat' :
+                            'steddingBlockerEasyPrivacyWhat');
+    const list = this.blocker_.lists.find(entry => entry.id === id);
+    if (!list) {
+      return what;
+    }
+    const parts = [
+      what,
+      loadTimeData.getStringF(
+          'steddingBlockerListSource', list.homepage, list.licence),
+    ];
+    if (list.failing) {
+      parts.push(loadTimeData.getString('steddingBlockerListFailing'));
+    } else if (list.fetched) {
+      parts.push(
+          loadTimeData.getStringF('steddingBlockerListFetched', list.fetched));
+    }
+    return parts.join(' ');
+  }
+
+  // blocker Bk9: when the ruleset was last made, and from how many rules.
