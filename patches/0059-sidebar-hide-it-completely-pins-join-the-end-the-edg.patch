+namespace {
+
+// Stedding (BACKLOG S-73): whether the background behind a default favicon
+// is dark. A translucent background is read over the frame it sits on: the
+// dark sidebar's active row is a light tint at 14% over a dark ground, and
+// read as light by its own channels it took the light scheme's dark globe,
+// about 1.4:1 against the row.
+bool IsDarkBehind(const ui::ColorProvider* provider, ui::ColorId bg_color) {
+  SkColor background = provider->GetColor(bg_color);
+  if (SkColorGetA(background) != SK_AlphaOPAQUE) {
+    background = color_utils::GetResultingPaintColor(
+        background, provider->GetColor(ui::kColorFrameActive));
+  }
+  return color_utils::IsDark(background);
+}
+
+}  // namespace
+
 ui::ImageModel GetDefaultFaviconModel(ui::ColorId bg_color) {
   return ui::ImageModel::FromImageGenerator(
       base::BindRepeating(
           [](ui::ColorId bg_color, const ui::ColorProvider* provider) {
             return *GetDefaultFaviconForColorScheme(
-                        color_utils::IsDark(provider->GetColor(bg_color)))
+                        IsDarkBehind(provider, bg_color))
                         .ToImageSkia();
           },
           bg_color),
@@ -122,7 +141,7 @@ ui::ImageModel GetDefaultFaviconModel(
