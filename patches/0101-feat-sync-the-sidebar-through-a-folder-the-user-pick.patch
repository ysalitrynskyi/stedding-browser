+// found in the LICENSE file.
+
+// Sync through a folder (docs/features/sidebar-file.md Sf7-Sf41, ADR 0029),
+// as a person uses it: a folder in a temporary directory stands for the
+// shared one, and another computer's file is written into it by the test.
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/path_service.h"
