+namespace stedding {
+
+// Safari's export file (docs/features/import.md I34-I42): the archive
+// Safari 18 and later writes with File > Export Browsing Data to File, or the
+// folder it unzips to. Its bookmarks, history and passwords come in;
+// payment cards never do. Read off the UI thread: the archive by Chromium's
+// Rust reader, the bookmarks page in the utility process, the passwords file
+// in the sandboxed CSV parser.
+
+// The key of Safari's bookmark folder (stedding.import.bookmark_folders) and
+// of its import in ImportJobs.
+inline constexpr char kSafariSourceKey[] = "safari";
+
+// import I35: each part's size is checked before it is read.
+inline constexpr uint64_t kMaxSafariBookmarksBytes = 32 * 1024 * 1024;
+// PasswordImporter's own limit on one file.
+inline constexpr uint64_t kMaxSafariPasswordsBytes = 1000 * 1024;
+// In an unzipped folder, each history file is read whole.
+inline constexpr uint64_t kMaxSafariHistoryFileBytes = 64 * 1024 * 1024;
+// PasswordImporter's own limit on one file's rows.
+inline constexpr size_t kMaxSafariPasswords = 3000;
+// import I38: at most this many history entries, the newest.
+inline constexpr size_t kMaxSafariHistoryRows = 100000;
+
+// import I36: what the export holds, before anything is applied.
+struct SafariExportSummary {
+  // The path was a ZIP archive or a folder that could be read.
+  bool opened = false;
+  // Web pages among the bookmarks and the Reading List.
+  size_t bookmarks = 0;
+  bool history = false;
+  size_t passwords = 0;
+  // Payment cards are never read; only that the file holds some.
+  bool cards = false;
+  bool bookmarks_too_big = false;
+  bool passwords_too_big = false;
+  bool too_many_passwords = false;
+  bool passwords_unreadable = false;
+  // In a folder: history files over kMaxSafariHistoryFileBytes.
+  size_t history_files_too_big = 0;
+
+  bool HoldsAnything() const;
+};
+
+// import I36: "In the file: 812 bookmarks, history and 96 passwords." and
+// what will not come in.
+std::u16string SummariseSafariExport(const SafariExportSummary& summary);
+
+// import I36: which parts to bring in. Passwords start unticked.
+struct SafariExportParts {
+  bool bookmarks = true;
+  bool history = true;
+  bool passwords = false;
+};
+
+// import I42: what an import did.
+struct SafariExportResult {
+  // Another page is importing Safari's export now.
+  bool already_running = false;
+  // No export was read first.
+  bool not_prepared = false;
+  size_t bookmarks = 0;
+  size_t bookmarks_already = 0;
+  size_t history = 0;
+  bool history_capped = false;
+  size_t history_files_too_big = 0;
+  bool passwords_asked = false;
+  size_t passwords_in_file = 0;
+  PasswordWriteResult passwords;
+  bool cards = false;
+  // Parts a policy turned off (ImportsAllowed).
+  bool bookmarks_blocked = false;
+  bool history_blocked = false;
+  bool passwords_blocked = false;
+};
+
+// import I42: the one result line.
+std::u16string DescribeSafariExportResult(const SafariExportResult& result);
+
+// One history entry of the export, as the archive's reader or a history
+// file in a folder gives it.
+struct SafariVisit {
+  std::string url;
+  std::string title;
+  std::string source_url;
+  std::string destination_url;
+  // Microseconds since the Unix epoch.
+  uint64_t time_usec = 0;
+  uint64_t visit_count = 0;
+};
+
+// import I38: the history row a visit becomes, or none: only http and https
+// pages, no redirect hop, nothing older than the history Chromium keeps
+// (90 days before `now`). The row keeps the title, the visit count and the
+// last visit; its typed count is 0.
+std::optional<history::URLRow> SafariHistoryRow(const SafariVisit& visit,
+                                                base::Time now);
+
+// Sorts `rows` newest first and keeps at most `cap`.
+void KeepNewestRows(history::URLRows& rows, size_t cap);
+
+// import I38: the history of an unzipped export.
+struct SafariHistoryRead {
+  SafariHistoryRead();
+  SafariHistoryRead(SafariHistoryRead&&);
+  SafariHistoryRead& operator=(SafariHistoryRead&&);
+  ~SafariHistoryRead();
+
+  // Newest first.
+  history::URLRows rows;
+  // More entries than kMaxSafariHistoryRows; the newest were kept.
+  bool capped = false;
+  size_t files_too_big = 0;
+};
+
+// import I34, I38: every history file in the folder `dir` (picked by what
+// its metadata says it holds, not by its name), each at most `max_file_bytes`,
+// read whole. Blocking.
+SafariHistoryRead ReadSafariHistoryFolder(
+    const base::FilePath& dir,
+    base::Time now,
+    size_t cap = kMaxSafariHistoryRows,
+    uint64_t max_file_bytes = kMaxSafariHistoryFileBytes);
+
+// import I34: what a file in an unzipped export is. Hidden files (an export
+// unzipped on Windows can carry "._" files beside each) are none of these. A
+// JSON file is told by the data type its metadata names. Blocking.
+enum class SafariExportFile {
+  kOther,
+  kBookmarks,
+  kPasswords,
+  kHistory,
+  kPaymentCards,
+};
+SafariExportFile KindOfSafariExportFile(const base::FilePath& file);
+
+// What the blocking side read for a summary.
+struct SafariExportRead {
+  SafariExportRead();
+  SafariExportRead(SafariExportRead&&);
+  SafariExportRead& operator=(SafariExportRead&&);
+  ~SafariExportRead();
+
+  SafariExportSummary summary;
+  std::vector<user_data_importer::ImportedBookmarkEntry> bookmarks;
+  // Held in memory only, until it is parsed.
+  std::string passwords_csv;
+};
+
+class SafariExportWorker;
+
+// One export, from its summary to its import. Prepare reads it and parses
+// its parts; Commit brings the ticked parts in, kept alive by the profile's
+// ImportJobs rather than by the page.
+class SafariExportImporter : public ImportJob {
+ public:
+  using PreparedCallback = base::OnceCallback<void(const SafariExportSummary&)>;
+  using DoneCallback = base::OnceCallback<void(const SafariExportResult&)>;
+
+  // The parsers in the utility process.
+  SafariExportImporter();
+  // For tests: in-process parsers.
+  SafariExportImporter(
+      std::unique_ptr<user_data_importer::ContentBookmarkParser>
+          bookmark_parser,
+      mojo::PendingRemote<password_manager::mojom::CSVPasswordParser>
+          csv_parser);
+  SafariExportImporter(const SafariExportImporter&) = delete;
+  SafariExportImporter& operator=(const SafariExportImporter&) = delete;
+  ~SafariExportImporter() override;
+
+  // import I34-I36: reads `path`, a ZIP archive or the folder it unzips to,
+  // and runs `done` with what it holds. Nothing is applied.
+  void Prepare(const base::FilePath& path, PreparedCallback done);
+
+  bool prepared() const { return prepared_; }
+  const SafariExportSummary& summary() const { return summary_; }
+  // The bookmarks read, with the Reading List under "Reading List".
+  const std::vector<user_data_importer::ImportedBookmarkEntry>& bookmarks()
+      const {
+    return bookmarks_;
+  }
+  const std::vector<password_manager::CSVPassword>& passwords() const {
+    return passwords_;
+  }
+
+  // import I37-I40: brings the ticked `parts` of a prepared `importer` into
+  // `profile`. The profile's ImportJobs holds it until `done` has run, so the
+  // page that asked may go away. A second import while one runs, or one of
+  // an export not read, does nothing and says so.
+  static void Commit(std::unique_ptr<SafariExportImporter> importer,
+                     Profile& profile,
+                     SafariExportParts parts,
+                     DoneCallback done);
+
+ private:
+  void OnOpened(PreparedCallback done, SafariExportRead read);
+  void OnPasswordsParsed(PreparedCallback done,
+                         password_manager::mojom::CSVPasswordSequencePtr seq);
+  void FinishPrepare(PreparedCallback done);
+
+  void Run(Profile& profile, SafariExportParts parts, DoneCallback done);
+  void WriteBookmarks();
+  void OnHistoryRead(SafariHistoryRead read);
+  void OnHistoryAdded(size_t added);
+  void OnPasswordsWritten(PasswordWriteResult written);
+  void PartDone();
+
+  base::SequenceBound<SafariExportWorker> worker_;
+  mojo::PendingRemote<password_manager::mojom::CSVPasswordParser>
+      csv_parser_for_testing_;
+  mojo::Remote<password_manager::mojom::CSVPasswordParser> csv_parser_;
+
+  bool prepared_ = false;
+  SafariExportSummary summary_;
+  std::vector<user_data_importer::ImportedBookmarkEntry> bookmarks_;
+  std::vector<password_manager::CSVPassword> passwords_;
+
+  // While Commit runs.
+  base::WeakPtr<Profile> profile_;
+  SafariExportResult result_;
+  DoneCallback done_;
+  int pending_ = 0;
+  std::unique_ptr<BookmarksLoadedWaiter> bookmarks_waiter_;
+  std::unique_ptr<ImportedPasswordsWriter> passwords_writer_;
+  base::CancelableTaskTracker history_tracker_;
+
+  base::WeakPtrFactory<SafariExportImporter> weak_factory_{this};
+};
+
