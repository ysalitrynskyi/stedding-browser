+ui::ImageModel CommandBarView::RowIcon(const Row& row) {
+  // K38 (GitHub issue 58): actions mode lists commands, read by their
+  // names, so its rows draw no icon and none of them is indented.
+  if (mode_ != Mode::kTabs) {
+    return ui::ImageModel();
+  }
+  const auto glyph = [](const gfx::VectorIcon& icon) {
+    return ui::ImageModel::FromVectorIcon(
+        icon, ui::kColorLabelForegroundSecondary, gfx::kFaviconSize);
+  };
+  switch (row.kind) {
+    case RowKind::kTab: {
+      // The icon the sidebar draws for the tab, a sleeping one's included.
+      tabs::TabInterface* const tab = row.tab.Get();
+      TabUIHelper* const helper = tab ? TabUIHelper::From(tab) : nullptr;
+      const ui::ImageModel favicon =
+          helper ? helper->GetFavicon() : ui::ImageModel();
+      if (favicon.IsEmpty()) {
+        return favicon::GetDefaultFaviconModel(ui::kColorDialogBackground);
+      }
+      // A browser page's icon is a glyph drawn for the tab strip's colours.
+      // The bar draws it in its own, as the split's mini toolbar does, or a
+      // dark glyph vanishes against a dark bar.
+      if (helper->ShouldThemifyFavicon()) {
+        return ui::ImageModel::FromImageGenerator(
+            base::BindRepeating(
+                [](const ui::ImageModel& source,
+                   const ui::ColorProvider* provider) {
+                  return gfx::ImageSkiaOperations::CreateColorMask(
+                      source.Rasterize(provider),
+                      provider->GetColor(ui::kColorLabelForegroundSecondary));
+                },
+                favicon),
+            gfx::Size(gfx::kFaviconSize, gfx::kFaviconSize));
+      }
+      return favicon;
+    }
+    case RowKind::kSiteSearch:
+      return glyph(vector_icons::kSearchIcon);
+    case RowKind::kSiteInformation:
+      return glyph(vector_icons::kInfoIcon);
+    case RowKind::kTyped:
+    case RowKind::kSuggestion:
+      if (!row.icon_page.is_valid()) {
+        return glyph(vector_icons::kSearchIcon);
+      }
+      return SiteIcon(row.icon_page);
+    case RowKind::kArchived:
+    case RowKind::kNewDocument:
+      return SiteIcon(row.icon_page);
+    case RowKind::kAction:
+      return ui::ImageModel();
+  }
+  NOTREACHED();
+}
+
+ui::ImageModel CommandBarView::SiteIcon(const GURL& page) {
+  const auto known = site_icons_.find(page);
+  if (known == site_icons_.end()) {
+    // Asked once: an empty entry stands for the lookup until it answers,
+    // and for a page the profile has no icon for after.
+    site_icons_[page];
+    // A private window reads the profile's icons, as its address field does,
+    // and writes none.
+    favicon::FaviconService* const service =
+        page.is_valid() ? FaviconServiceFactory::GetForProfile(
+                              browser_->GetProfile(),
+                              ServiceAccessType::EXPLICIT_ACCESS)
+                        : nullptr;
+    if (service) {
+      service->GetFaviconImageForPageURL(
+          page,
+          base::BindOnce(&CommandBarView::OnSiteIcon,
+                         weak_factory_.GetWeakPtr(), page),
+          &site_icon_tracker_);
+    }
+  } else if (!known->second.IsEmpty()) {
+    return ui::ImageModel::FromImage(known->second);
+  }
+  return favicon::GetDefaultFaviconModel(ui::kColorDialogBackground);
+}
+
+void CommandBarView::OnSiteIcon(
+    const GURL& page,
+    const favicon_base::FaviconImageResult& result) {
+  if (result.image.IsEmpty()) {
+    return;
+  }
+  site_icons_[page] = result.image;
+  // The rows that wait for it take it in place: the list is not rebuilt, so
+  // the chosen row and a click in progress stay where they are (K5).
+  for (size_t i = 0; i < rows_.size(); ++i) {
+    if (rows_[i].icon_page != page) {
+      continue;
+    }
+    if (auto* const view = views::AsViewClass<ResultRow>(RowView(i))) {
+      view->SetImageModel(views::Button::STATE_NORMAL, RowIcon(rows_[i]));
+    }
+  }
+}
+
+ui::ImageModel CommandBarView::row_icon_for_testing(size_t index) {
+  auto* const view = views::AsViewClass<ResultRow>(RowView(index));
+  if (!view || !view->GetImageModel(views::Button::STATE_NORMAL)) {
+    return ui::ImageModel();
+  }
+  return *view->GetImageModel(views::Button::STATE_NORMAL);
+}
