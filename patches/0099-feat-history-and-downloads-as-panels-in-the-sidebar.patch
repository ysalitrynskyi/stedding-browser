+// Pn1: ⌘Y (Ctrl+H) opens History in the sidebar's column, in the tab list's
+// place, with the Archived row and the bottom row still there; the other
+// panel's key switches, the same key again closes it, and the list is back.
+// With the focus in the panel the key still reaches the window: a bare web
+// view dropped it.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsTest,
+                       TheKeyOpensHistoryInTheSidebarColumn) {
+  ASSERT_TRUE(panels());
+  const int tab_count = tabs()->count();
+  TabStripView* const list = stedding::test::FindView<TabStripView>(region());
+  ASSERT_TRUE(list);
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kHistory));
+  EXPECT_EQ(tab_count, tabs()->count()) << "History opened as a page";
+  EXPECT_EQ(GURL(stedding::kLibraryHistoryURL),
+            panel_page()->GetLastCommittedURL());
+  EXPECT_FALSE(list->IsDrawn()) << "the tab list shows under the panel";
+  EXPECT_TRUE(panel_view()->IsDrawn());
+  views::View* const archived =
+      FindButtonWithTooltip(region(), u"Archived tabs");
+  ASSERT_TRUE(archived);
+  EXPECT_TRUE(archived->IsDrawn());
+  ASSERT_TRUE(region()->downloads_button());
+  EXPECT_TRUE(region()->downloads_button()->IsDrawn());
+  const gfx::Rect panel = panel_view()->GetBoundsInScreen();
+  EXPECT_LE(panel.bottom(), archived->GetBoundsInScreen().y())
+      << "the panel runs over the foot";
+  EXPECT_LE(panel.bottom(),
+            region()->downloads_button()->GetBoundsInScreen().y());
+  EXPECT_GT(panel.height(), 100);
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_DOWNLOADS));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kDownloads));
+  EXPECT_EQ(tab_count, tabs()->count());
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_DOWNLOADS));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kNone));
+  EXPECT_TRUE(list->IsDrawn()) << "the tab list did not come back";
+
+#if !BUILDFLAG(IS_MAC)
+  // The Mac's key equivalents come through the menu bar, not this path;
+  // there it is a check by hand (docs/features/acceptance.md).
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kHistory));
+  // Ctrl+H as the panel's page leaves it, the way it comes back from the
+  // page to the panel's delegate. content's SimulateKeyPress marks its keys
+  // to be dropped when the page does not take them, so they never come back.
+  input::NativeWebKeyboardEvent ctrl_h(blink::WebInputEvent::Type::kRawKeyDown,
+                                       blink::WebInputEvent::kControlKey,
+                                       base::TimeTicks::Now());
+  ctrl_h.windows_key_code = ui::VKEY_H;
+  ctrl_h.dom_key = ui::DomKey::FromCharacter('h');
+  ctrl_h.dom_code = static_cast<int>(ui::DomCode::US_H);
+  ASSERT_TRUE(panel_page()->GetDelegate());
+  panel_page()->GetDelegate()->HandleKeyboardEvent(panel_page(), ctrl_h);
+  EXPECT_TRUE(WaitForPanel(SidebarPanel::kNone))
+      << "Ctrl+H with the focus in the panel did not reach the window";
+#endif
+}
