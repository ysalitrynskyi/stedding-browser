@@ -0,0 +1,76 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/unloaded_tab.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/sessions/content/content_serialized_navigation_builder.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/restore_type.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace spaces {
+
+tabs::TabInterface* InsertUnloadedTab(TabStripModel* tabs,
+                                      Profile* profile,
+                                      const GURL& url,
+                                      const std::u16string& title) {
+  if (!tabs || !profile) {
+    return nullptr;
+  }
+  content::WebContents::CreateParams params(profile);
+  params.initially_hidden = true;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(params);
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries;
+  std::unique_ptr<content::NavigationEntry> entry =
+      content::NavigationController::CreateNavigationEntry(
+          url, content::Referrer(), std::nullopt, std::nullopt,
+          ui::PAGE_TRANSITION_TYPED, false, std::string(), profile, nullptr);
+  entry->SetTitle(title);
+  entries.push_back(std::move(entry));
+  contents->GetController().Restore(0, content::RestoreType::kRestored,
+                                    &entries);
+  contents->SetWasDiscarded(true);
+  content::WebContents* const raw = contents.get();
+  tabs->AppendTab(std::make_unique<tabs::TabModel>(std::move(contents), tabs),
+                  /*foreground=*/false);
+  // sidebar-file Sf2, import I18: the session writes a tab's pages as they
+  // commit, and a tab that never loads commits none; until the session was
+  // next written whole from the windows, a quit lost every tab an import or a
+  // sync had made. The page is written now.
+  if (SessionService* const session =
+          SessionServiceFactory::GetForProfile(profile)) {
+    const SessionID window_id =
+        sessions::SessionTabHelper::IdForWindowContainingTab(raw);
+    const SessionID tab_id = sessions::SessionTabHelper::IdForTab(raw);
+    content::NavigationEntry* const page =
+        raw->GetController().GetEntryAtIndex(0);
+    if (window_id.is_valid() && tab_id.is_valid() && page) {
+      session->UpdateTabNavigation(
+          window_id, tab_id,
+          sessions::ContentSerializedNavigationBuilder::FromNavigationEntry(
+              0, page));
+      session->SetSelectedNavigationIndex(window_id, tab_id, 0);
+    }
+  }
+  return tabs->GetTabForWebContents(raw);
+}
+
+}  // namespace spaces
