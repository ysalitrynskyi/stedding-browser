+class NumberKeysMenuW2B02Test : public InProcessBrowserTest {
+ protected:
+  void TearDownOnMainThread() override {
+    stedding::shortcuts::ResetAllShortcuts(LocalState());
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  static PrefService* LocalState() { return g_browser_process->local_state(); }
+
+  static stedding::shortcuts::NumberKeys StoredLayout() {
+    return stedding::shortcuts::NumberKeysOf(
+        LocalState()->GetDict(stedding::prefs::kShortcutsUser));
+  }
+
+  // "<the menu's value>|<the layout the editor's rows mark chosen>", or ""
+  // until the menu is drawn. With `layout` a layout's name, the menu takes
+  // it first, as a choice in its open list lands, and the answer is
+  // "picked".
+  static std::string Menu(content::WebContents* page,
+                          const std::string& layout = std::string()) {
+    static constexpr char kMenu[] = R"(
+        const editor = pick('settings-stedding-shortcuts-editor');
+        const select =
+            editor && editor.shadowRoot.querySelector('#numberKeys');
+        if (!select) {
+          return '';
+        }
+        if ($1) {
+          select.value = $1;
+          select.dispatchEvent(new Event('change'));
+          return 'picked';
+        }
+        const row = editor.groups_.flatMap(group => group.rows)
+                        .find(each => !!each.layouts);
+        const chosen = row && row.layouts.find(each => each.selected);
+        return select.value + '|' + (chosen ? chosen.value : '');)";
+    return content::EvalJs(page,
+                           OnThePageW2B02(content::JsReplace(kMenu, layout)))
+        .ExtractString();
+  }
+
+  // The person picks `layout`, and the menu is drawn again from what the
+  // browser stored.
+  static bool PickAndWait(content::WebContents* page,
+                          const std::string& layout) {
+    return Menu(page, layout) == "picked" &&
+           base::test::RunUntil(
+               [&]() { return Menu(page) == layout + "|" + layout; });
+  }
+};
+
+// P03-1c, shortcuts Z23: after the person has picked both the default and
+// another layout, Reset all puts the default back in the menu as in the
+// keys.
+IN_PROC_BROWSER_TEST_F(NumberKeysMenuW2B02Test,
+                       ResetAllPutsTheDefaultBackInTheMenu) {
+  const std::string shipped = stedding::shortcuts::NumberKeysName(
+      stedding::shortcuts::NumberKeys::kRowsFirst);
+  const std::string spaces_first = stedding::shortcuts::NumberKeysName(
+      stedding::shortcuts::NumberKeys::kSpacesFirst);
+  content::WebContents* const page =
+      OpenSettingsW2B02(browser(), "settings-stedding-shortcuts-editor");
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return Menu(page) == shipped + "|" + shipped; }))
+      << Menu(page);
+
+  ASSERT_TRUE(PickAndWait(page, spaces_first)) << Menu(page);
+  ASSERT_EQ(stedding::shortcuts::NumberKeys::kSpacesFirst, StoredLayout());
+  ASSERT_TRUE(PickAndWait(page, shipped)) << Menu(page);
+  ASSERT_EQ(stedding::shortcuts::NumberKeys::kRowsFirst, StoredLayout());
+  ASSERT_TRUE(PickAndWait(page, spaces_first)) << Menu(page);
+  ASSERT_EQ(stedding::shortcuts::NumberKeys::kSpacesFirst, StoredLayout());
+
+  ASSERT_TRUE(content::ExecJs(page, OnThePageW2B02(R"(
+      pick('settings-stedding-shortcuts-editor').shadowRoot
+          .querySelector('#resetAll').click();
+      return '';)")));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnThePageW2B02(R"(
+        const dialog = pick('settings-stedding-shortcuts-editor').shadowRoot
+                           .querySelector('#resetAllDialog');
+        return !!dialog && dialog.open;)"))
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(content::ExecJs(page, OnThePageW2B02(R"(
+      pick('settings-stedding-shortcuts-editor').shadowRoot
+          .querySelector('#resetAllConfirm').click();
+      return '';)")));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !LocalState()
+                ->GetDict(stedding::prefs::kShortcutsUser)
+                .contains(stedding::shortcuts::kNumberKeysKey);
+  })) << "Reset all leaves a layout stored";
+  EXPECT_EQ(stedding::shortcuts::NumberKeys::kRowsFirst, StoredLayout());
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return Menu(page) == shipped + "|" + shipped; }))
+      << "the menu shows another layout than the keys have: " << Menu(page);
+}
