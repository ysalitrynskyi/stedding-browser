+class TabMenuB22Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  // Runs the row `command` of the menu a right click on `tab`'s sidebar row
+  // opens, as a click on that row runs it. Fails when the menu has no such
+  // row or the row is greyed out.
+  void RunTabMenuRowB22(tabs::TabInterface* tab,
+                        TabStripModel::ContextMenuCommand command) {
+    TabStripModel* const strip = tab_strip_model();
+    TabContextMenuController controller(tab->GetHandle(),
+                                        vertical_tab_strip_controller());
+    TabMenuModel menu(&controller, TabMenuModelDelegate::From(browser()),
+                      strip, strip->GetIndexOfTab(tab));
+    const std::optional<size_t> row = menu.GetIndexOfCommandId(command);
+    ASSERT_TRUE(row.has_value()) << "the menu has no row " << command;
+    ASSERT_TRUE(menu.IsVisibleAt(*row)) << "row " << command << " is hidden";
+    ASSERT_TRUE(menu.IsEnabledAt(*row)) << "row " << command << " is greyed";
+    menu.ActivatedAt(*row);
+  }
+};
+
+// P29-1a; menus M1, splits J1. With a split on screen, the menu of a plain
+// row outside it offers to swap that row into the split, as Chromium's long
+// menu does, and the swap works. It offered "New Split View with Current
+// Tab", which makes a split with the tab on screen; that tab is already a
+// pane, and the tab strip stops the browser on a tab joining a second split.
+IN_PROC_BROWSER_TEST_F(TabMenuB22Test, APlainRowSwapsIntoTheSplitOnScreen) {
+  TabStripModel* const strip = tab_strip_model();
+  tabs::TabInterface* const left = strip->GetActiveTab();
+  AppendTab();
+  tabs::TabInterface* const right = strip->GetActiveTab();
+  AppendTab();
+  tabs::TabInterface* const plain = strip->GetActiveTab();
+  ASSERT_EQ(3, strip->count());
+  strip->ActivateTabAt(strip->GetIndexOfTab(left));
+  strip->AddToNewSplit({strip->GetIndexOfTab(right)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_EQ(left->GetSplit(), right->GetSplit());
+  ASSERT_FALSE(plain->IsSplit());
+  ASSERT_EQ(left, strip->GetActiveTab());
+  ASSERT_FALSE(strip->IsTabSelected(strip->GetIndexOfTab(plain)))
+      << "a right click does not select the row";
+
+  TabContextMenuController controller(plain->GetHandle(),
+                                      vertical_tab_strip_controller());
+  TabMenuModel menu(&controller, TabMenuModelDelegate::From(browser()), strip,
+                    strip->GetIndexOfTab(plain));
+  // Checked before anything runs: the row would stop the browser.
+  ASSERT_FALSE(
+      menu.GetIndexOfCommandId(TabStripModel::CommandAddToSplit).has_value())
+      << "the menu offers a new split with the tab on screen, which is "
+         "already in one";
+  const std::optional<size_t> swap =
+      menu.GetIndexOfCommandId(TabStripModel::CommandSwapWithActiveSplit);
+  ASSERT_TRUE(swap.has_value()) << "the menu offers no swap into the split";
+  EXPECT_TRUE(menu.IsVisibleAt(*swap));
+  EXPECT_TRUE(menu.IsEnabledAt(*swap));
+  ui::MenuModel* const panes = menu.GetSubmenuModelAt(*swap);
+  ASSERT_TRUE(panes);
+  ASSERT_EQ(2u, panes->GetItemCount()) << "one row for each pane";
+
+  // The second row swaps the row in for the split's second pane.
+  panes->ActivatedAt(1);
+  ASSERT_TRUE(plain->IsSplit()) << "the row did not join the split";
+  EXPECT_EQ(left->GetSplit(), plain->GetSplit());
+  EXPECT_FALSE(right->IsSplit()) << "the pane swapped out is still split";
+  EXPECT_EQ(left, strip->GetActiveTab());
+  EXPECT_EQ(3, strip->count());
+}
+
+// P30-1a; pins H3, menus M5, spaces B20. Close Other Tabs and Close Tabs
+// Below leave the Space's pins, as they leave the essentials and as Clear
+// leaves the pins; they close the plain tabs as before. Both had closed every
+// pin of the open run for good.
+IN_PROC_BROWSER_TEST_F(TabMenuB22Test, ClosingOthersOrBelowKeepsTheSpacesPins) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  TabStripModel* const strip = tab_strip_model();
+  tabs::TabInterface* const doomed = strip->GetActiveTab();
+  AppendTab();
+  tabs::TabInterface* const first_pin = strip->GetActiveTab();
+  AppendTab();
+  tabs::TabInterface* const second_pin = strip->GetActiveTab();
+  AppendTab();
+  tabs::TabInterface* const kept = strip->GetActiveTab();
+  ASSERT_EQ(4, strip->count());
+  model->SetSpacePinned(first_pin, true);
+  model->SetSpacePinned(second_pin, true);
+  ASSERT_TRUE(model->IsSpacePinned(first_pin));
+  ASSERT_TRUE(model->IsSpacePinned(second_pin));
+  // The run is open: its pins are on screen, so the commands may reach them.
+  model->SetPinsCollapsed(model->active_id(), false);
+  ASSERT_FALSE(strip->IsTabHidden(strip->GetIndexOfTab(first_pin)));
+  ASSERT_FALSE(strip->IsTabHidden(strip->GetIndexOfTab(second_pin)));
+  ASSERT_LT(strip->GetIndexOfTab(first_pin), strip->GetIndexOfTab(second_pin));
+  ASSERT_LT(strip->GetIndexOfTab(second_pin), strip->GetIndexOfTab(kept));
+  strip->ActivateTabAt(strip->GetIndexOfTab(kept));
+  const tabs::TabHandle first_handle = first_pin->GetHandle();
+  const tabs::TabHandle second_handle = second_pin->GetHandle();
+  const tabs::TabHandle doomed_handle = doomed->GetHandle();
+  const tabs::TabHandle kept_handle = kept->GetHandle();
+
+  ASSERT_NO_FATAL_FAILURE(
+      RunTabMenuRowB22(kept, TabStripModel::CommandCloseOtherTabs));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !doomed_handle.Get(); }))
+      << "Close Other Tabs left the plain tab";
+  ASSERT_TRUE(first_handle.Get()) << "Close Other Tabs closed a pin";
+  ASSERT_TRUE(second_handle.Get()) << "Close Other Tabs closed a pin";
+  EXPECT_TRUE(model->IsSpacePinned(first_pin));
+  EXPECT_TRUE(model->IsSpacePinned(second_pin));
+  ASSERT_TRUE(kept_handle.Get());
+  EXPECT_EQ(3, strip->count());
+
+  // Below the first pin: the second pin, then the plain tab.
+  ASSERT_NO_FATAL_FAILURE(
+      RunTabMenuRowB22(first_pin, TabStripModel::CommandCloseTabsToRight));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !kept_handle.Get(); }))
+      << "Close Tabs Below left the plain tab under the pins";
+  ASSERT_TRUE(first_handle.Get());
+  ASSERT_TRUE(second_handle.Get()) << "Close Tabs Below closed the pin below";
+  EXPECT_TRUE(model->IsSpacePinned(first_pin));
+  EXPECT_TRUE(model->IsSpacePinned(second_pin));
+}
