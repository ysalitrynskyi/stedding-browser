+// Whether `point` is on the list's own rows, in its scroll view: a Space's
+// chip under the list, or the rows' room past it, is not the list.
+bool OnTheList(TabStripView* strip, const gfx::Point& point) {
+  views::ScrollView* const list =
+      strip ? strip->unpinned_tabs_scroll_view() : nullptr;
+  return list && list->IsDrawn() && list->GetBoundsInScreen().Contains(point);
+}
+
+// pins H27 (BACKLOG S-289): the tab a dragged row or card shows first, a
+// split's first pane.
+tabs::TabInterface* FirstTabOfView(const views::View* view) {
+  if (const auto* const tab = views::AsViewClass<TabView>(view)) {
+    return tab->GetTabInterface() ? tab->GetTabInterface()->GetHandle().Get()
+                                  : nullptr;
+  }
+  if (const auto* const split = views::AsViewClass<SplitTabView>(view);
+      split && split->collection_node()) {
+    const tabs::ConstChildPtr data = split->collection_node()->GetNodeData();
+    if (const auto* const collection =
+            std::get_if<tabs::ConstDanglingUntriagedTabCollection>(&data)) {
+      return (*collection)->GetTabAtIndexRecursive(0);
+    }
+  }
+  return nullptr;
+}
+
+// pins H27 (BACKLOG S-289): where the floating copy lies, the sidebar as a
+// whole, so it is drawn over the essentials, the list and the sidebar's top
+// row alike; on the strip it was cut off at the strip's top edge.
+views::View* GhostParent(views::View* strip) {
+  for (views::View* view = strip; view; view = view->parent()) {
+    if (views::IsViewClass<VerticalTabStripRegionView>(view)) {
+      return view;
+    }
+  }
+  return strip;
+}
+
+// `bounds`, in screen coordinates, in `view`'s.
+gfx::Rect RectFromScreen(const views::View* view, const gfx::Rect& bounds) {
+  gfx::Point origin = bounds.origin();
+  views::View::ConvertPointFromScreen(view, &origin);
+  return gfx::Rect(origin, bounds.size());
+}
+
+// Pins H27: dropped over the essentials, the dragged tabs become essentials,
+// at the place the grid made room for them, before the card after it or
+// after the last; dropped on the list, dragged essentials leave the
+// essentials for the place the list made room for, and over the Clear line
+// they are the Space's pins there.
+struct EssentialsMove {
+  bool into = false;
+  std::vector<tabs::TabHandle> tabs;
+  std::optional<tabs::TabHandle> before;
+  bool over_line = false;
+};
+
+void MoveAcrossTheEssentials(const EssentialsMove& move) {
+  for (const tabs::TabHandle& handle : move.tabs) {
+    tabs::TabInterface* const tab = handle.Get();
+    BrowserWindowInterface* const window =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    TabStripModel* const model = window ? window->GetTabStripModel() : nullptr;
+    if (!model || model->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+      continue;
+    }
+    tabs::TabInterface* const before =
+        move.before ? move.before->Get() : nullptr;
+    if (move.into) {
+      if (!tab->IsPinned()) {
+        model->SetTabPinned(model->GetIndexOfTab(tab), true);
+      }
+      if (!tab->IsPinned() || !before || before == tab || !before->IsPinned()) {
+        continue;
+      }
+    } else {
+      if (tab->IsPinned()) {
+        model->SetTabPinned(model->GetIndexOfTab(tab), false);
+      }
+      if (tab->IsPinned()) {
+        continue;
+      }
+    }
+    const int from = model->GetIndexOfTab(tab);
+    int to = before && model->GetIndexOfTab(before) != TabStripModel::kNoTab
+                 ? model->GetIndexOfTab(before)
+                 : model->count();
+    if (from < to) {
+      --to;
+    }
+    if (to != from) {
+      model->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+    }
+    if (!move.into && move.over_line) {
+      if (spaces::SpaceModel* const spaces = spaces::SpaceModel::From(window)) {
+        spaces->SetSpacePinnedInPlace(tab, true);
+      }
+    }
+  }
+}
