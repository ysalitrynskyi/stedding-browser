+// little E11 (GitHub issue 74; the owner, 2026-11-04): with "Open links from
+// other apps as a peek" on, such a link opens as a peek over the active tab
+// of the window, over the page by default and in a small window when "Show a
+// peek" says so, and no little window opens. Off, the default, it opens in a
+// little window as before.
+IN_PROC_BROWSER_TEST_F(LittleWindowTest, ALinkFromAnotherAppCanOpenAsAPeek) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_FALSE(prefs->GetBoolean(stedding::prefs::kLittleAsPeek));
+  const GURL url = embedded_test_server()->GetURL("/title2.html");
+  const auto little_windows = [&]() {
+    int count = 0;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* window) {
+          count += stedding::IsLittleWindow(window) &&
+                   !stedding::IsPeekWindow(window);
+          return true;
+        });
+    return count;
+  };
+  const int tabs_before = browser()->GetTabStripModel()->count();
+
+  prefs->SetBoolean(stedding::prefs::kLittleAsPeek, true);
+  {
+    SCOPED_TRACE("over the page");
+    BrowserWindowInterface* const opened = stedding::OpenLittleWindow(
+        browser()->GetProfile(), url, /*anchor=*/nullptr,
+        /*untrusted_launch=*/false);
+    ASSERT_TRUE(opened);
+    content::WebContents* page = nullptr;
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      page = stedding::PeekOverPageOfActiveTab(browser());
+      return page != nullptr;
+    })) << "no peek over the window's page";
+    EXPECT_EQ(url, page->GetVisibleURL());
+    EXPECT_EQ(0, little_windows()) << "a little window opened as well";
+    EXPECT_EQ(tabs_before, browser()->GetTabStripModel()->count());
+    ASSERT_TRUE(stedding::RunPeekOverPageCommand(
+        browser(), stedding::PeekCommand::kClose));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return stedding::PeekOverPageOfActiveTab(browser()) == nullptr;
+    }));
+  }
+  {
+    SCOPED_TRACE("Show a peek: In a small window");
+    prefs->SetInteger(stedding::prefs::kPeekStyle, 1);
+    BrowserWindowInterface* const peek = stedding::OpenLittleWindow(
+        browser()->GetProfile(), url, /*anchor=*/nullptr,
+        /*untrusted_launch=*/false);
+    ASSERT_TRUE(peek);
+    EXPECT_TRUE(stedding::IsPeekWindow(peek));
+    EXPECT_EQ(0, little_windows());
+    CloseBrowserSynchronously(peek);
+    prefs->ClearPref(stedding::prefs::kPeekStyle);
+  }
+  prefs->SetBoolean(stedding::prefs::kLittleAsPeek, false);
+  {
+    SCOPED_TRACE("the setting off");
+    BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+        browser()->GetProfile(), url, /*anchor=*/nullptr,
+        /*untrusted_launch=*/false);
+    ASSERT_TRUE(little);
+    EXPECT_TRUE(stedding::IsLittleWindow(little));
+    EXPECT_FALSE(stedding::IsPeekWindow(little));
+    EXPECT_EQ(nullptr, stedding::PeekOverPageOfActiveTab(browser()));
+    CloseBrowserSynchronously(little);
+  }
+}
+
+// little E11 and E6: a link from another app keeps its trust as a peek. One
+// nothing vouches for is cross-site; one that is vouched for is the browser's
+// own navigation, not a page's with no initiator.
+IN_PROC_BROWSER_TEST_F(LittleWindowTest, ALinkAsAPeekKeepsItsTrust) {
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      stedding::prefs::kLittleAsPeek, true);
+  {
+    SCOPED_TRACE("untrusted is cross-site");
+    ASSERT_NO_FATAL_FAILURE(OpenAndWait(/*untrusted_launch=*/true));
+    EXPECT_NE("none", FetchSite());
+    EXPECT_FALSE(FetchSite().empty());
+    EXPECT_EQ(std::string::npos, Cookie().find("strict=1")) << Cookie();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return stedding::PeekOverPageOfActiveTab(browser()) != nullptr;
+    }));
+    ASSERT_TRUE(stedding::RunPeekOverPageCommand(
+        browser(), stedding::PeekCommand::kClose));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return stedding::PeekOverPageOfActiveTab(browser()) == nullptr;
+    }));
+  }
+  {
+    SCOPED_TRACE("trusted sends the cookie");
+    ResetRequest();
+    ASSERT_NO_FATAL_FAILURE(OpenAndWait(/*untrusted_launch=*/false));
+    EXPECT_EQ("none", FetchSite());
+    EXPECT_NE(std::string::npos, Cookie().find("strict=1")) << Cookie();
+  }
+}
+
