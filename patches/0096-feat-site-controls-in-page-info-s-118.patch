+// The strip's delegate for a page in a tab: the window's own commands and
+// functions, as its keys run them, and the page's state, watched while the
+// panel is open.
+class PageStripDelegate : public SiteControlsStripView::Delegate,
+                          public content::WebContentsObserver,
+                          public zoom::ZoomObserver {
+ public:
+  PageStripDelegate(content::WebContents* contents,
+                    PageInfoNavigationHandler* navigation_handler)
+      : content::WebContentsObserver(contents),
+        navigation_handler_(navigation_handler) {
+    if (zoom::ZoomController* const controller =
+            zoom::ZoomController::FromWebContents(contents)) {
+      zoom_observation_.Observe(controller);
+    }
+  }
+  PageStripDelegate(const PageStripDelegate&) = delete;
+  PageStripDelegate& operator=(const PageStripDelegate&) = delete;
+  ~PageStripDelegate() override = default;
+
+  // SiteControlsStripView::Delegate:
+  void SetStrip(SiteControlsStripView* strip) override { strip_ = strip; }
+
+  SiteControlsStripView::State GetState() override {
+    SiteControlsStripView::State state;
+    BrowserWindowInterface* const browser = BrowserFor(web_contents());
+    if (!browser) {
+      return state;
+    }
+    state.copy_link_enabled = chrome::IsCommandEnabled(browser, IDC_COPY_URL);
+    state.mute_would_mute = MuteKeyWouldMute(browser);
+    switch (PictureInPictureKeyFor(browser)) {
+      case PictureInPictureKey::kNothing:
+        state.picture_in_picture =
+            SiteControlsStripView::PictureInPicture::kNothing;
+        break;
+      case PictureInPictureKey::kEnter:
+        state.picture_in_picture =
+            SiteControlsStripView::PictureInPicture::kEnter;
+        break;
+      case PictureInPictureKey::kExit:
+        state.picture_in_picture =
+            SiteControlsStripView::PictureInPicture::kExit;
+        break;
+    }
+    if (zoom::ZoomController* const controller =
+            zoom::ZoomController::FromWebContents(web_contents())) {
+      state.zoom_percent = controller->GetZoomPercent();
+    }
+    return state;
+  }
+
+  std::u16string ChordFor(int command_id) override {
+    BrowserWindowInterface* const browser = BrowserFor(web_contents());
+    BrowserView* const browser_view =
+        browser ? BrowserView::GetBrowserViewForBrowser(browser) : nullptr;
+    ui::Accelerator accelerator;
+    return browser_view && browser_view->GetAcceleratorForCommandId(
+                               command_id, &accelerator)
+               ? accelerator.GetShortcutText()
+               : std::u16string();
+  }
+
+  void Run(SiteControlsStripView::Action action) override {
+    content::WebContents* const contents = web_contents();
+    BrowserWindowInterface* const browser = BrowserFor(contents);
+    if (!browser) {
+      return;
+    }
+    switch (action) {
+      // Si2: the copies and picture in picture close the panel, as the
+      // keys leave none open; mute and zoom leave it open.
+      case SiteControlsStripView::Action::kCopyLink:
+        // What IDC_COPY_URL runs (browser_commands.cc CopyURL).
+        CopyLink(browser, contents, LinkFormat::kPlain);
+        Close();
+        return;
+      case SiteControlsStripView::Action::kCopyMarkdownLink:
+        CopyLink(browser, contents, LinkFormat::kMarkdown);
+        Close();
+        return;
+      case SiteControlsStripView::Action::kCopyTitle:
+        CopyTitle(browser, contents);
+        Close();
+        return;
+      case SiteControlsStripView::Action::kToggleMute:
+        ToggleMuteOnSelectedTabs(browser);
+        Refresh();
+        return;
+      case SiteControlsStripView::Action::kTogglePictureInPicture:
+        TogglePictureInPicture(browser);
+        Close();
+        return;
+      case SiteControlsStripView::Action::kZoomOut:
+        Zoom(content::PAGE_ZOOM_OUT);
+        return;
+      case SiteControlsStripView::Action::kZoomReset:
+        Zoom(content::PAGE_ZOOM_RESET);
+        return;
+      case SiteControlsStripView::Action::kZoomIn:
+        Zoom(content::PAGE_ZOOM_IN);
+        return;
+    }
+  }
+
+  // content::WebContentsObserver: Si2, Si4, the mute and picture-in-picture
+  // buttons follow the page while the panel is open.
+  void DidUpdateAudioMutingState(bool muted) override { Refresh(); }
+  void OnAudioStateChanged(bool audible) override { Refresh(); }
+  void MediaPictureInPictureChanged(bool is_picture_in_picture) override {
+    Refresh();
+  }
+  void MediaStartedPlaying(const MediaPlayerInfo& video_type,
+                           const content::MediaPlayerId& id) override {
+    RefreshSoon();
+  }
+  void MediaStoppedPlaying(
+      const MediaPlayerInfo& video_type,
+      const content::MediaPlayerId& id,
+      WebContentsObserver::MediaStoppedReason reason) override {
+    RefreshSoon();
+  }
+
+  // zoom::ZoomObserver: Si5, the zoom follows Cmd-plus and the rest.
+  void OnZoomControllerDestroyed(zoom::ZoomController* controller) override {
+    zoom_observation_.Reset();
+  }
+  void OnZoomChanged(
+      const zoom::ZoomController::ZoomChangedEventData& data) override {
+    Refresh();
+  }
+
+ private:
+  void Refresh() {
+    if (strip_) {
+      strip_->Update();
+    }
+  }
+
+  // The media session learns what a page can do a moment after the page
+  // starts or stops playing; picture in picture is read once it has.
+  void RefreshSoon() {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&PageStripDelegate::Refresh,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Close() {
+    if (navigation_handler_) {
+      navigation_handler_->CloseBubble();
+    }
+  }
+
+  // Si5: Chromium's zoom steps, without Chromium's zoom bubble, which would
+  // open over the panel and take its activation, closing it. The bubble is
+  // held back for this one change only: a change from the keys still shows
+  // it.
+  void Zoom(content::PageZoom step) {
+    content::WebContents* const contents = web_contents();
+    zoom::ZoomController* const controller =
+        contents ? zoom::ZoomController::FromWebContents(contents) : nullptr;
+    if (!controller) {
+      return;
+    }
+    controller->SetShowsNotificationBubble(false);
+    zoom::PageZoom::Zoom(contents, step);
+    controller->SetShowsNotificationBubble(true);
+    Refresh();
+  }
+
+  raw_ptr<SiteControlsStripView> strip_ = nullptr;
+  const raw_ptr<PageInfoNavigationHandler> navigation_handler_;
+  base::ScopedObservation<zoom::ZoomController, zoom::ZoomObserver>
+      zoom_observation_{this};
+  base::WeakPtrFactory<PageStripDelegate> weak_factory_{this};
+};
+
+// Si8: asks the question over `browser`, once page info has closed, and on
+// Clear removes what it named, if the page is still where it was.
+void AskToClearSiteData(base::WeakPtr<BrowserWindowInterface> browser,
+                        base::WeakPtr<content::WebContents> contents,
+                        std::string domain,
+                        content::StoragePartitionConfig config,
+                        ClearSiteDataQuestion question) {
+  if (!browser || !contents) {
+    return;
+  }
+  spaces::ConfirmInWindow(
+      browser.get(), std::move(question.title), std::move(question.body),
+      std::move(question.action),
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             const std::string& domain,
+             const content::StoragePartitionConfig& config) {
+            // Nothing goes when the page left the site or the jar the
+            // question named while it was open.
+            ClearSiteDataAndReload(contents.get(), domain, config);
+          },
+          std::move(contents), std::move(domain), std::move(config)));
+}
