+
+namespace {
+
+constexpr char16_t kMessage[] =
+    u"This site uses DRM to protect its video, which Stedding can't play yet.";
+
+// The page's DRM bars: one at most, whatever the test did.
+std::vector<infobars::InfoBar*> BarsOn(content::WebContents* page) {
+  std::vector<infobars::InfoBar*> bars;
+  const infobars::ContentInfoBarManager* const manager =
+      infobars::ContentInfoBarManager::FromWebContents(page);
+  if (manager) {
+    for (infobars::InfoBar* const bar : manager->infobars()) {
+      if (bar->delegate()->GetIdentifier() ==
+          infobars::InfoBarDelegate::STEDDING_DRM_NOTICE_INFOBAR_DELEGATE) {
+        bars.push_back(bar);
+      }
+    }
+  }
+  return bars;
+}
+
+infobars::InfoBar* BarOn(content::WebContents* page) {
+  const std::vector<infobars::InfoBar*> bars = BarsOn(page);
+  EXPECT_LE(bars.size(), 1u);
+  return bars.empty() ? nullptr : bars.front();
+}
+
+ConfirmInfoBarDelegate* DelegateOf(infobars::InfoBar* bar) {
+  return bar->delegate()->AsConfirmInfoBarDelegate();
+}
+
+ConfirmInfoBar* ViewOf(infobars::InfoBar* bar) {
+  return static_cast<ConfirmInfoBar*>(bar);
+}
+
+// The user's press on the bar's button, through the button on screen.
+void PressTheButton(infobars::InfoBar* bar) {
+  views::Button* const button = ViewOf(bar)->ok_button_for_testing();
+  ASSERT_TRUE(button);
+  const gfx::Point centre = button->GetLocalBounds().CenterPoint();
+  views::test::ButtonTestApi(button).NotifyClick(ui::MouseEvent(
+      ui::EventType::kMousePressed, centre, centre, base::TimeTicks::Now(),
+      ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON));
+}
+
+// What InfoBarView does with a press on the link.
+void PressDontShowAgain(infobars::InfoBar* bar) {
+  EXPECT_EQ(u"Don't show again", DelegateOf(bar)->GetLinkText());
+  if (DelegateOf(bar)->LinkClicked(WindowOpenDisposition::CURRENT_TAB)) {
+    bar->RemoveSelf();
+  }
+}
+
+// What InfoBarView does with a press on the close box.
+void PressClose(infobars::InfoBar* bar) {
+  bar->delegate()->InfoBarDismissed();
+  bar->RemoveSelf();
+}
+
+// `body`, run on the settings page with `pick(selector)`: the first element
+// that matches anywhere on the page, through every shadow root, or null.
+std::string OnThePage(std::string_view body) {
+  return base::StrCat({R"(
+    (() => {
+      const find = (root, selector) => {
+        const found = root.querySelector(selector);
+        if (found) {
+          return found;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const inner = find(element.shadowRoot, selector);
+            if (inner) {
+              return inner;
+            }
+          }
+        }
+        return null;
+      };
+      const pick = selector => find(document, selector);
+    )",
+                       body, R"(
+    })()
+  )"});
+}
