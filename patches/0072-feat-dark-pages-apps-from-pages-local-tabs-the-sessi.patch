+  ASSERT_FALSE(view()->IsToolbarVisible());
+  EXPECT_TRUE(bar->GetVisible() && bar->height() > 0)
+      << "the bar went with the row";
+  EXPECT_FALSE(drawn()) << "a line with no row over it, at "
