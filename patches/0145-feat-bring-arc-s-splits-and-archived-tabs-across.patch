+  EXPECT_TRUE(model().IsSpacePinned(tab_titled(u"PR")));
+  EXPECT_TRUE(model().HomeUrl(pane).has_value());
+  EXPECT_LT(tabs().GetIndexOfTab(tab_titled(u"Pin")),
+            tabs().GetIndexOfTab(pane));
+  EXPECT_LT(tabs().GetIndexOfTab(pane),
+            tabs().GetIndexOfTab(tab_titled(u"First")));
+
+  // In its folder (J8).
+  tabs::TabInterface* const in_folder = tab_titled(u"FL");
+  ASSERT_TRUE(in_folder);
+  const tabs::TabCollection* const split = in_folder->GetParentCollection();
+  ASSERT_TRUE(split);
+  EXPECT_EQ(tabs::TabCollection::Type::SPLIT, split->type());
+  const tabs::TabCollection* const folder = split->GetParentCollection();
+  ASSERT_TRUE(folder);
+  ASSERT_EQ(tabs::TabCollection::Type::FOLDER, folder->type());
+  EXPECT_EQ("Docs",
+            static_cast<const tabs::FolderTabCollection*>(folder)->title());
+
+  // Chromium's split holds two.
+  EXPECT_FALSE(tab_titled(u"P3")->IsSplit());
+  EXPECT_FALSE(tab_titled(u"P4")->IsSplit());
+  EXPECT_EQ(tabs().GetIndexOfTab(tab_titled(u"P2")) + 1,
+            tabs().GetIndexOfTab(tab_titled(u"P3")));
+  EXPECT_FALSE(tab_titled(u"Solo")->IsSplit());
+
+  // I12.
+  const ArcImportResult again =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(0u, again.tabs);
+  EXPECT_EQ(0u, again.splits);
+}
