+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/shortcuts.md Z10, Z11 on the Mac: the View menu's "Close or
+// reopen the sidebar" row as the menu bar is built at launch. The row takes
+// its key from the shipped table (⌘S) and the user's chords; with the row
+// turned off, or with every chord taken off it, before a restart, the menu is
+// built with no key on that row, and Chromium's old ⇧⌘L does nothing.
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_MAC)
+
+#include <vector>
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
+#include "chrome/browser/ui/stedding/shortcut_catalog.h"
+#include "chrome/browser/ui/stedding/shortcut_chord.h"
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+#include "chrome/browser/ui/stedding/shortcut_service.h"
+#include "chrome/browser/ui/stedding/shortcut_test_util_mac.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/test_launcher.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace {
+
+namespace shortcuts = stedding::shortcuts;
+
+// Chromium's own chord for the command, which Stedding does not ship.
+constexpr shortcuts::Chord kUpstreamChordW2B07(ui::VKEY_L,
+                                               ui::EF_COMMAND_DOWN |
+                                                   ui::EF_SHIFT_DOWN);
+
+PrefService* LocalStateW2B07() {
+  return g_browser_process->local_state();
+}
+
+const shortcuts::Entry& SidebarRowW2B07() {
+  const shortcuts::Entry* const entry =
+      shortcuts::EntryForName("toggle-sidebar");
+  CHECK(entry);
+  return *entry;
+}
+
+// The key the shipped tables give the menu row: ⌘S.
+ui::Accelerator ShippedMenuKeyW2B07() {
+  ui::Accelerator shipped;
+  CHECK(GetDefaultMacMenuAcceleratorForCommandId(
+      IDC_TOGGLE_VERTICAL_TABS_COLLAPSE, &shipped));
+  return shipped;
+}
+
+class SidebarMenuKeyW2B07Test : public InProcessBrowserTest {
+ protected:
+  void TearDownOnMainThread() override {
+    // A PRE_ test leaves its change for the test after the restart.
+    if (!content::IsPreTest()) {
+      shortcuts::ResetAllShortcuts(LocalStateW2B07());
+    }
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  // The row as the menu was built with the sidebar's command left without a
+  // chord: no key on the row, and ⇧⌘L runs nothing. Reset gives the row its
+  // shipped key back.
+  void ExpectTheRowShowsNoKeyThenResets() {
+    EXPECT_TRUE(shortcuts::test::MainMenuShowsNoChord(
+        IDC_TOGGLE_VERTICAL_TABS_COLLAPSE))
+        << "the menu was built with Chromium's own key on the row";
+    EXPECT_FALSE(shortcuts::test::MainMenuShowsChord(
+        IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+        shortcuts::ToAccelerator(kUpstreamChordW2B07)));
+    EXPECT_NE(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+              shortcuts::test::CommandForChord(
+                  shortcuts::ToAccelerator(kUpstreamChordW2B07)))
+        << shortcuts::ChordToString(kUpstreamChordW2B07)
+        << " still closes the sidebar";
+
+    ASSERT_TRUE(shortcuts::ResetShortcut(LocalStateW2B07(), SidebarRowW2B07()));
+    EXPECT_TRUE(shortcuts::test::MainMenuShowsChord(
+        IDC_TOGGLE_VERTICAL_TABS_COLLAPSE, ShippedMenuKeyW2B07()))
+        << "Reset gives the row its shipped key back";
+    EXPECT_EQ(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+              shortcuts::test::CommandForChord(ShippedMenuKeyW2B07()));
+  }
+};
+
+// P26-1d, Z10 and Z11: the row turned off before a restart.
+IN_PROC_BROWSER_TEST_F(SidebarMenuKeyW2B07Test,
+                       PRE_TheSidebarRowTurnedOffHasNoKeyAfterARestart) {
+  EXPECT_TRUE(shortcuts::test::MainMenuShowsChord(
+      IDC_TOGGLE_VERTICAL_TABS_COLLAPSE, ShippedMenuKeyW2B07()))
+      << "the row ships with ⌘S";
+  ASSERT_TRUE(
+      shortcuts::SetShortcutOff(LocalStateW2B07(), SidebarRowW2B07(), true));
+}
+
+IN_PROC_BROWSER_TEST_F(SidebarMenuKeyW2B07Test,
+                       TheSidebarRowTurnedOffHasNoKeyAfterARestart) {
+  ASSERT_TRUE(shortcuts::IsOff(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE))
+      << "the row did not stay off across the restart";
+  ExpectTheRowShowsNoKeyThenResets();
+}
+
+// P26-1d, Z10 and Z11: every chord taken off the row before a restart.
+IN_PROC_BROWSER_TEST_F(
+    SidebarMenuKeyW2B07Test,
+    PRE_TheSidebarRowWithNoChordsHasNoKeyAfterARestart) {
+  const std::vector<shortcuts::Chord> shipped =
+      shortcuts::DefaultChordsFor(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE);
+  ASSERT_FALSE(shipped.empty());
+  for (const shortcuts::Chord& chord : shipped) {
+    EXPECT_TRUE(shortcuts::RemoveShortcut(LocalStateW2B07(), SidebarRowW2B07(),
+                                          chord))
+        << shortcuts::ChordToString(chord);
+  }
+  EXPECT_TRUE(
+      shortcuts::test::MainMenuShowsNoChord(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE));
+}
+
+IN_PROC_BROWSER_TEST_F(SidebarMenuKeyW2B07Test,
+                       TheSidebarRowWithNoChordsHasNoKeyAfterARestart) {
+  ASSERT_TRUE(shortcuts::Current().IsChanged(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE))
+      << "the row's change did not survive the restart";
+  ExpectTheRowShowsNoKeyThenResets();
+}
+
+}  // namespace
+
+#endif  // BUILDFLAG(IS_MAC)
