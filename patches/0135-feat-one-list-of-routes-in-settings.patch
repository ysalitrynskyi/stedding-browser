+std::optional<Route> RouteFromTyped(Route::Match match,
+                                    std::string_view typed,
+                                    const std::string& space) {
+  const std::string text(base::TrimWhitespaceASCII(typed, base::TRIM_ALL));
+  if (text.empty()) {
+    return std::nullopt;
+  }
+  Route route;
+  route.match = match;
+  route.space = space;
+  // A site, a host and an address hold no spaces; GURL would escape them. An
+  // address needs a scheme to parse; what names none is taken as https.
+  const bool one_word = std::ranges::none_of(
+      text, [](char c) { return base::IsAsciiWhitespace(c); });
+  const GURL as_url(text.find("://") == std::string::npos ? "https://" + text
+                                                          : text);
+  switch (match) {
+    case Route::Match::kSite:
+      // "/docs/" parses as the host "docs", and is no site.
+      route.pattern = one_word && !text.starts_with('/') ? SiteOf(as_url)
+                                                         : std::string();
+      break;
+    case Route::Match::kContains:
+      route.pattern = text;
+      break;
+    case Route::Match::kEquals:
+      route.pattern =
+          one_word && as_url.is_valid() ? as_url.spec() : std::string();
+      break;
+    case Route::Match::kHost:
+    case Route::Match::kHostSuffix:
+      if (one_word && text.find('/') == std::string::npos) {
+        route.pattern = base::ToLowerASCII(text);
+      }
+      break;
+  }
+  if (route.pattern.empty()) {
+    return std::nullopt;
+  }
+  return route;
+}
+
+bool ReplaceRoute(PrefService* prefs,
+                  const Route& old_rule,
+                  const Route& new_rule) {
+  std::vector<Route> routes = ReadRoutes(prefs);
+  const auto it = std::ranges::find(routes, old_rule);
+  if (it == routes.end() || new_rule.pattern.empty()) {
+    return false;
+  }
+  *it = new_rule;
+  std::vector<Route> kept;
+  for (const Route& rule : routes) {
+    const bool repeats = &rule != &*it && rule.match == new_rule.match &&
+                         base::ToLowerASCII(rule.pattern) ==
+                             base::ToLowerASCII(new_rule.pattern);
+    if (!repeats) {
+      kept.push_back(rule);
+    }
+  }
+  WriteRoutes(prefs, kept);
+  return true;
+}
+
+bool RemoveRouteEqualTo(PrefService* prefs, const Route& rule) {
+  std::vector<Route> routes = ReadRoutes(prefs);
+  const auto it = std::ranges::find(routes, rule);
+  if (it == routes.end()) {
+    return false;
+  }
+  routes.erase(it);
+  WriteRoutes(prefs, routes);
+  return true;
+}
