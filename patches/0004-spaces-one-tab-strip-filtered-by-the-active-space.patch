@@ -33,6 +33,9 @@ BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabHeight);
 // Radius of the active tab's pill in the vertical tab strip, in DIPs.
 BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabCornerRadius);
 
+// Height of a pinned tab tile in the sidebar's essentials row, in DIPs.
+BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabPinnedHeight);
+
 // Height of the location bar, in DIPs. With the toolbar margin below, this
 // sets how tall the toolbar strip is: Chromium's 34 plus 6 above and below
 // gives 46, and the reference is thinner than that.
@@ -64,6 +67,23 @@ BASE_DECLARE_FEATURE_PARAM(int, kTabFaviconSize);
 // what brings the toolbar to the reference's height.
 BASE_DECLARE_FEATURE_PARAM(int, kToolbarButtonIconSize);
 
+// Accept a tab dragged onto a Space icon. The part that could lose a tab -- the
+// drop handler taking one and putting it back -- is covered by
