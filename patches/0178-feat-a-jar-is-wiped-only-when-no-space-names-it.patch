+// sessions S42: a Space leaving for the shared jar takes its own tabs and
+// leaves the jar and the other Space's tabs as they are.
+TEST_F(SharedSessionWindowTest, TurningASessionOffLeavesItsOtherSpacesAlone) {
+  const SpaceId mail = model().AddSpace("Mail", kBlue)->id();
+  const SpaceId docs = model().AddSpace("Docs", kBlue)->id();
+  const std::string jar = ShareSession(mail, docs);
+  tabs::TabInterface* const in_mail = OpenTabIn(mail);
+  tabs::TabInterface* const in_docs = OpenTabIn(docs);
+  const content::WebContents* const docs_contents = in_docs->GetContents();
+  const GURL url("https://example.com/");
+  PutCookie(profile(), ConfigFor(jar), url);
+  const int wipes = SpacePartitionWipesBegunForTesting();
+
+  model().SetSpaceSession(mail, std::string());
+  task_environment()->RunUntilIdle();
+
+  EXPECT_FALSE(IsSpaceStoragePartition(PartitionOf(in_mail)));
+  EXPECT_EQ(jar, PartitionOf(in_docs).partition_name());
+  EXPECT_EQ(docs_contents, in_docs->GetContents()) << "Docs' tab was rebound";
+  EXPECT_EQ(wipes, SpacePartitionWipesBegunForTesting());
+  EXPECT_FALSE(WasWiped(ConfigFor(jar), url));
+}
