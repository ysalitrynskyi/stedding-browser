+NextLaunch NextLaunchReopens(BrowserWindowInterface* closing) {
+  if (!closing ||
+      closing->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+      BrowserInitState::From(closing)->omit_from_session_restore()) {
+    return NextLaunch::kLeavesItClosed;
