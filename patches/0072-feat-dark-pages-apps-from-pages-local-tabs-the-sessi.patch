+    Release(to);
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_FALSE(IsIn(m1, folder)) << "the row stayed in its folder";
+    EXPECT_LT(Index(m1), Index(f1)) << "the row did not land above the folder";
+    ExpectKept(m1, kept);
+    EXPECT_EQ(1u, WindowCount()) << "a window tore off";
+  }
+
+  {
+    SCOPED_TRACE("a middle row dragged down lands after the folder");
+    const Kept kept = KeptOf(m2);
+    const gfx::Point to = RowCentre(after);
+    PointerPressAndMove(RowCentre(m2), to);
+    TabView* const row = stedding::test::FindDrawnRow(root(), m2);
+    ASSERT_TRUE(row);
+    EXPECT_TRUE(row->GetBoundsInScreen().Contains(to))
+        << "the dragged row is not drawn under the pointer";
+    Release(to);
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_FALSE(IsIn(m2, folder)) << "the row stayed in its folder";
+    EXPECT_LT(Index(f4), Index(m2)) << "the row did not land below the folder";
