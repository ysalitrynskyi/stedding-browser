@@ -0,0 +1,99 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_NEW_TAB_SPACE_H_
+#define CHROME_BROWSER_UI_SPACES_NEW_TAB_SPACE_H_
+
+#include <memory>
+#include <optional>
+
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "ui/base/window_open_disposition.h"
+
+class BrowserWindowInterface;
+class GURL;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace spaces {
+
+// Where a tab about to be made belongs (PLAN.md SPC-12, CMD-8). The Space,
+// and so the cookie jar, is chosen before the tab's contents exist: their
+// first request already carries that Space's cookies.
+struct NewTabSpaceChoice {
+  SpaceId space;
+  // Set when a route named `space`: the Space the tab would have opened in
+  // without it, so the window can say where the tab went and undo it.
+  std::optional<SpaceId> routed_from;
+  // An essential (a Chromium pin) lives on the profile's shared jar.
+  bool essential = false;
+};
+
+// Chooses the Space for a tab about to be made in `window` to open `url`,
+// opened from `source` (null when no tab opened it). An essential takes the
+// window's active Space and the shared jar. Otherwise the tab takes the
+// window's active Space, or the Space of `source` when a page opened it
+// (`opened_by_page`: a target=_blank link, a popup, a page in a background
+// tab) or when it opens in another window (a Shift-click) -- unless a route
+// names another Space (routing D2), or it is a link from another app with a
+// default Space for those (D3, spent by this one tab). Within a window,
+// Chromium names the tab on screen as the source of a new tab even while
+// a Space switch is making one for the Space coming on screen, so the source
+// alone decides nothing there. `may_route`: false for a page that shares a
+// browsing instance with its opener, which must stay in its opener's jar.
+// Nullopt in a window without Spaces.
+std::optional<NewTabSpaceChoice> ChooseSpaceForNewTab(
+    BrowserWindowInterface* window,
+    content::WebContents* source,
+    const GURL& url,
+    bool essential,
+    bool may_route,
+    bool opened_by_page);
+
+// The choice, carried by the contents made for it until the window that
+// first files the tab takes it.
+class NewTabSpace : public content::WebContentsUserData<NewTabSpace> {
+ public:
+  NewTabSpace(const NewTabSpace&) = delete;
+  NewTabSpace& operator=(const NewTabSpace&) = delete;
+  ~NewTabSpace() override;
+
+  // Returns the choice made for `contents`, if any, and removes it.
+  static std::optional<NewTabSpaceChoice> Take(content::WebContents* contents);
+
+ private:
+  friend WebContentsUserData;
+  NewTabSpace(content::WebContents* contents, NewTabSpaceChoice choice);
+
+  const NewTabSpaceChoice choice_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// PLAN.md SPC-12: a page that a tab in `window` opens (`source`) joins that
+// tab's Space. One opened without an opener -- a target=_blank link, a
+// noopener popup -- goes where a route names, if one does, and content made
+// it in the profile's shared jar: when its Space keeps a jar of its own, it
+// is made again there before it loads anything, and the contents returned
+// are the ones to add; content loads the page into those. `disposition` is
+// where it opens. The contents returned carry the choice.
+std::unique_ptr<content::WebContents> PlaceOpenedContents(
+    BrowserWindowInterface* window,
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> contents,
+    const GURL& url,
+    WindowOpenDisposition disposition);
+
+// PLAN.md CMD-8: whether a tab showing `shown` has no page of its own -- a
+// new-tab page, a blank page, or nothing committed yet. A typed address in
+// such a tab may follow a route; a settings page, or any page the user is
+// on, is never moved under them.
+bool IsFreshTabUrl(const GURL& shown);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_NEW_TAB_SPACE_H_
