+#define CHROME_BROWSER_UI_STEDDING_STEDDING_COMMAND_IDS_H_
+
+// Stedding command ids that live outside chrome/app/chrome_command_ids.h:
+// that header is included by most of the browser, and a new line there is a
+// rebuild of it all. Ids here sit in Stedding's 551xx block, past the ones
+// chrome_command_ids.h holds (55100-55122) and the app menu's placeholders
+// (55140, 55141).
+
+// toolbar T10: shift-cmd-D shows or hides the address row for the window.
+inline constexpr int IDC_STEDDING_TOGGLE_ADDRESS_ROW = 55142;
+
+#endif  // CHROME_BROWSER_UI_STEDDING_STEDDING_COMMAND_IDS_H_
