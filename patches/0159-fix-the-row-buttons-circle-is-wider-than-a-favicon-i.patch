From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Fri, 6 Nov 2026 10:56:14 -0500
Subject: fix: the row buttons' circle is wider than a favicon, its glyph on
 the centre

A LabelButton centres its image only down. A row's close button is wider than
its 14 DIP glyph, so the glyph stood a DIP left of the circle's centre, on a
pin's row and on a folder's header. The circle under the pointer was also 16
DIP at most, which read smaller than the favicon beside it.

The glyph is centred across too, and the circle is 20 DIP. It stays on the
rows' close column, so the title and the name keep their room but for the two
DIP more a folder's - takes while it shows.

Why: a comment on GitHub issue 78, and the owner's yes (BACKLOG S-441, folders
F44, pins H29).

Removable when: the sidebar's rows no longer use TabCloseButton.
---
 .../ui/views/tabs/common/folder_view.cc       | 21 +++++++++++++------
 .../tabs/common/tab_view_vertical_layout.cc   |  1 +
 .../ui/views/tabs/tab/tab_close_button.cc     | 13 ++++++++++++
 .../ui/views/tabs/tab/tab_close_button.h      |  7 +++++++
 .../test/stedding/folder_tabs_browsertest.cc  | 20 +++++++++++++++++-
 5 files changed, 55 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/ui/views/tabs/common/folder_view.cc b/chrome/browser/ui/views/tabs/common/folder_view.cc
index 8323e537e99e5..f9a8176a21297 100644
--- a/chrome/browser/ui/views/tabs/common/folder_view.cc
+++ b/chrome/browser/ui/views/tabs/common/folder_view.cc
@@ -512,6 +512,8 @@ FolderView::FolderView(TabCollectionNode* collection_node)
   // The whole of the favicons' column takes a press: a row's border has no
   // use here.
   minus->SetBorder(nullptr);
+  minus->SetPreferredSize(
+      gfx::Size(TabCloseButton::kRowCircle, TabCloseButton::kRowCircle));
   minus->set_context_menu_controller(this);
   minus->SetVisible(false);
   close_open_pins_button_ = header->AddChildView(std::move(minus));
@@ -592,10 +594,21 @@ void FolderView::UpdateCloseOpenPinsButton() {
   // every folder on every pass of the rows' visibility.
   TabStripCollectionController* const controller =
       collection_node_ ? collection_node_->GetController() : nullptr;
-  close_open_pins_button_->SetVisible(
+  const bool shows =
       header_hovered_ && controller && folder() && !rail_ &&
       !header_dragging_ && !drop_highlighted_ &&
-      !rename_field_->GetVisible() && controller->FolderHoldsOpenPins(folder()));
+      !rename_field_->GetVisible() && controller->FolderHoldsOpenPins(folder());
+  // On the rows' close column: wider than the column, and over its edge by as
+  // much on each side (BACKLOG S-441). The rail has insets of its own.
+  if (!rail_) {
+    const int over =
+        (TabCloseButton::kRowCircle - stedding::SidebarFaviconSize()) / 2;
+    static_cast<views::BoxLayout*>(
+        close_open_pins_button_->parent()->GetLayoutManager())
+        ->set_inside_border_insets(gfx::Insets::TLBR(
+            0, kHeaderInset, 0, kHeaderInset - (shows ? over : 0)));
+  }
+  close_open_pins_button_->SetVisible(shows);
 }
 
