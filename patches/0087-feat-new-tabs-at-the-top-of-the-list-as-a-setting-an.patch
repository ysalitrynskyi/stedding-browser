+std::u16string HexOf(SkColor color) {
+  return base::ASCIIToUTF16(base::StringPrintf(
+      "#%02X%02X%02X", SkColorGetR(color), SkColorGetG(color),
+      SkColorGetB(color)));
+}
+
+// "#3E63DD" or "3e63dd", spaces around it allowed; anything else is none.
+std::optional<SkColor> ColorFromHex(std::u16string_view text) {
+  std::u16string_view hex = base::TrimWhitespace(text, base::TRIM_ALL);
+  if (!hex.empty() && hex.front() == u'#') {
+    hex.remove_prefix(1);
+  }
+  uint32_t value = 0;
+  if (hex.size() != 6 ||
+      !base::HexStringToUInt(base::UTF16ToASCII(hex), &value)) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB((value >> 16) & 0xFF, (value >> 8) & 0xFF,
+                       value & 0xFF);
+}
