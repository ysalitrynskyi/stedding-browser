+// commandbar K38 (GitHub issue 58): a tab's row draws the tab's own icon at
+// its start, and what it says at its right -- "Switch to Tab", or the Space
+// -- apart at the row's end, smaller than the title, which gives up its end
+// first. Assistive technology still hears the title, then the detail.
+TEST_F(CommandBarViewTest, ATabRowDrawsItsIconAndWhereItGoesAtItsEnd) {
+  AddTab(browser(), GURL("https://example.com/"));
+  SetTabName(browser(), tabs().GetActiveTab(),
+             u"A tab with a name long enough to run the whole width of a row "
+             u"and on, past where the row says where it goes");
+  auto bar = std::make_unique<CommandBarView>(browser());
+  ASSERT_LE(1u, bar->row_count_for_testing());
+  ASSERT_EQ(u"Switch to Tab", bar->row_detail_for_testing(0));
+  const ui::ImageModel icon = bar->row_icon_for_testing(0);
+  EXPECT_FALSE(icon.IsEmpty()) << "the tab's row draws no icon";
+  EXPECT_FALSE(icon.IsVectorIcon()) << "a glyph, not the tab's icon";
+
+  views::View* const row = bar->row_view_for_testing(0);
+  ASSERT_TRUE(row);
+  row->SetSize(gfx::Size(600, 44));
+  views::test::RunScheduledLayout(row);
+  std::vector<const views::Label*> labels;
+  for (const views::View* child : row->children()) {
+    const auto* const label = views::AsViewClass<views::Label>(child);
+    if (label && label->GetVisible()) {
+      labels.push_back(label);
+    }
+  }
+  ASSERT_EQ(2u, labels.size()) << "the title and the detail";
+  const views::Label* const title = labels[0];
+  const views::Label* const detail = labels[1];
+  EXPECT_EQ(u"Switch to Tab", detail->GetText());
+  EXPECT_EQ(row->width() - row->GetInsets().right(), detail->bounds().right())
+      << "the detail is not at the row's end";
+  EXPECT_EQ(detail->GetPreferredSize({}).width(), detail->width())
+      << "the detail gave up its words to the title";
+  EXPECT_LT(title->bounds().right(), detail->x()) << "the title runs into it";
+  EXPECT_LT(detail->font_list().GetFontSize(),
+            title->font_list().GetFontSize());
+  const std::u16string name(row->GetViewAccessibility().GetCachedName());
+  EXPECT_TRUE(name.starts_with(bar->row_title_for_testing(0)) &&
+              name.ends_with(u"Switch to Tab"))
+      << base::UTF16ToUTF8(name);
+}
+
+// commandbar K38, sessions S32: a tab of another Space says the Space at the
+// row's end, and the mark of its Independent session follows the Space's
+// name there, inside the row.
+TEST_F(CommandBarViewTest, TheMarkFollowsTheSpaceAtTheRowsEnd) {
+  const spaces::SpaceId home = model().active_id();
+  spaces::Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  model().SetSpaceIsolated(work->id(), true);
+  model().SetActiveSpace(work->id());
+  AddTab(browser(), GURL("https://work.example/"));
+  model().SetActiveSpace(home);
+
+  auto bar = std::make_unique<CommandBarView>(browser());
+  size_t in_work = bar->row_count_for_testing();
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    if (bar->row_detail_for_testing(i) == u"Work") {
+      in_work = i;
+    }
+  }
+  ASSERT_LT(in_work, bar->row_count_for_testing());
+  ASSERT_FALSE(bar->row_mark_for_testing(in_work).empty());
+  views::View* const row = bar->row_view_for_testing(in_work);
+  ASSERT_TRUE(row);
+  row->SetSize(gfx::Size(600, 44));
+  views::test::RunScheduledLayout(row);
+  const views::View* const mark = FindShownIsolationMark(row);
+  ASSERT_TRUE(mark) << "the row draws no mark";
+  const views::Label* detail = nullptr;
+  for (const views::View* child : row->children()) {
+    const auto* const label = views::AsViewClass<views::Label>(child);
+    if (label && label->GetVisible() && label->GetText() == u"Work") {
+      detail = label;
+    }
+  }
+  ASSERT_TRUE(detail) << "the Space is not drawn apart";
+  EXPECT_GE(mark->x(), detail->bounds().right()) << "after the Space";
+  EXPECT_EQ(row->width() - row->GetInsets().right(), mark->bounds().right())
+      << "the mark is not at the row's end";
+}
+
+// commandbar K38: a search draws the magnifier, a closed tab its page's icon
+// (the default page icon here: a unit test's profile has no favicons), and
+// actions mode, which lists commands, draws none.
+TEST_F(CommandBarViewTest, EachRowDrawsWhatItOpens) {
+  AddTab(browser(), GURL("https://example.com/"));
+  auto bar = std::make_unique<CommandBarView>(browser());
+  bar->SetArchivedSourceForTesting(base::BindLambdaForTesting([] {
+                                     ArchivedTab closed;
+                                     closed.id =
+                                         SessionID::FromSerializedValue(77);
+                                     closed.title = u"Old page";
+                                     closed.url = GURL("https://old.example/");
+                                     return std::vector<ArchivedTab>{closed};
+                                   }),
+                                   base::BindRepeating([](SessionID) {}));
+  bar->PrefillForTesting(u"old page");
+  ASSERT_LE(2u, bar->row_count_for_testing());
+  const ui::ImageModel typed = bar->row_icon_for_testing(0);
+  ASSERT_TRUE(typed.IsVectorIcon()) << "the typed search draws no glyph";
+  EXPECT_EQ(&vector_icons::kSearchIcon, typed.GetVectorIcon().vector_icon());
+  const size_t closed = RowIndex(*bar, u"Old page");
+  ASSERT_LT(closed, bar->row_count_for_testing());
+  const ui::ImageModel page = bar->row_icon_for_testing(closed);
+  EXPECT_FALSE(page.IsEmpty()) << "the closed tab's row draws no icon";
+  EXPECT_FALSE(page.IsVectorIcon() &&
+               page.GetVectorIcon().vector_icon() == &vector_icons::kSearchIcon)
+      << "a page drawn as a search";
+
+  auto actions = std::make_unique<CommandBarView>(browser());
+  actions->SetModeForTesting(CommandBarView::Mode::kActions);
+  ASSERT_LE(1u, actions->row_count_for_testing());
+  for (size_t i = 0; i < actions->row_count_for_testing(); ++i) {
+    EXPECT_TRUE(actions->row_icon_for_testing(i).IsEmpty())
+        << base::UTF16ToUTF8(actions->row_title_for_testing(i));
+  }
+}
