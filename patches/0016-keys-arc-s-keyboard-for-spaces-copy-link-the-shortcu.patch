+<?xml version="1.0" encoding="utf-8"?>
+<!-- Stedding's own strings. One file, included from generated_resources.grd,
+     so the upstream file carries a single-line hunk. English only for now:
+     Stedding's UI is not localised yet (docs/QUALITY.md). -->
+<grit-part>
+  <!-- The Spaces menu in the macOS menu bar (docs/features/spaces.md B23). -->
+  <message name="IDS_STEDDING_SPACES_MENU_MAC" desc="In Title Case: The menu title of the Mac Spaces menu." meaning="Top-level menu">
+    Spaces
+  </message>
+  <message name="IDS_STEDDING_NEXT_SPACE_MAC" desc="In Title Case: The Mac menu item that activates the next Space.">
+    Next Space
+  </message>
+  <message name="IDS_STEDDING_PREVIOUS_SPACE_MAC" desc="In Title Case: The Mac menu item that activates the previous Space.">
+    Previous Space
+  </message>
+  <message name="IDS_STEDDING_CLEAR_SPACE_MAC" desc="In Title Case: The Mac menu item that closes the unpinned tabs of the active Space.">
+    Clear This Space
+  </message>
+  <message name="IDS_STEDDING_TOGGLE_SPACE_PIN_MAC" desc="In Title Case: The Mac menu item that pins the active tab in its Space, or unpins it; checked while pinned.">
+    Pin Tab in This Space
+  </message>
+  <message name="IDS_STEDDING_MOVE_TAB_TO_NEXT_SPACE_MAC" desc="In Title Case: The Mac menu item that moves the active tab to the next Space.">
+    Move Tab to Next Space
+  </message>
+  <message name="IDS_STEDDING_MOVE_TAB_TO_PREVIOUS_SPACE_MAC" desc="In Title Case: The Mac menu item that moves the active tab to the previous Space.">
+    Move Tab to Previous Space
+  </message>
+  <message name="IDS_STEDDING_SPACE_N_MAC" desc="In Title Case: The Mac menu item that activates the Nth Space.">
+    Space <ph name="NUMBER">$1<ex>1</ex></ph>
+  </message>
+
+  <!-- Copy link (docs/features/copy-link.md). -->
+  <message name="IDS_STEDDING_COPY_LINK" desc="In Title Case: The menu item that copies the page's link.">
+    Copy Link
+  </message>
+  <message name="IDS_STEDDING_COPY_MARKDOWN_LINK" desc="In Title Case: The menu item that copies the page's link as a Markdown link.">
+    Copy Link as Markdown
+  </message>
+  <message name="IDS_STEDDING_LINK_COPIED_CLEAN_TOAST_BODY" desc="Toast text after a link was copied with its tracking parameters removed.">
+    Link copied, tracking removed
+  </message>
+
+  <!-- Screenshots (docs/features/screenshot.md C5). -->
+  <message name="IDS_STEDDING_CAPTURE_TOAST_BODY" desc="Toast text after a screenshot was copied to the clipboard and saved to the Downloads folder.">
+    Copied · Saved to Downloads
+  </message>
+  <message name="IDS_STEDDING_CAPTURE_TOAST_BUTTON" desc="The toast button that reveals the saved screenshot in the Finder.">
+    Show in Finder
+  </message>
+</grit-part>
