 TEST(ChromePaths, DefaultUserDataDirectory) {
+  // Stedding (BACKLOG S-220): unit_tests run on a user-data directory of their
+  // own (ChromeUnitTestSuite), never the default one.
+  EXPECT_FALSE(IsUsingDefaultDataDirectory().value());
+
+  SetUsingDefaultUserDataDirectoryForTesting(true);
   EXPECT_TRUE(IsUsingDefaultDataDirectory().value());
 
   SetUsingDefaultUserDataDirectoryForTesting(false);
   EXPECT_FALSE(IsUsingDefaultDataDirectory().value());
 
   SetUsingDefaultUserDataDirectoryForTesting(std::nullopt);
-  EXPECT_TRUE(IsUsingDefaultDataDirectory().value());
+  EXPECT_FALSE(IsUsingDefaultDataDirectory().value());
+}
+
+// BACKLOG S-220: a unit test never writes to the person's own data folder. A
+// TestingProfile made without a path lives under chrome::DIR_USER_DATA while
+// its test runs, and one whose test crashed on 2026-10-15 stayed in
+// ~/Library/Application Support/Stedding. DIR_USER_DATA is a folder of the
+// test process's own, in the system's temporary folder.
+TEST(ChromePaths, UnitTestsKeepOutOfThePersonsDataFolder) {
+  base::FilePath user_data_dir;
+  ASSERT_TRUE(base::PathService::Get(DIR_USER_DATA, &user_data_dir));
+  base::FilePath default_user_data_dir;
+  ASSERT_TRUE(GetDefaultUserDataDirectory(&default_user_data_dir));
+  EXPECT_NE(default_user_data_dir, user_data_dir);
+  EXPECT_FALSE(default_user_data_dir.IsParent(user_data_dir)) << user_data_dir;
+
+  // PathService::Override made the path absolute, with links resolved.
+  base::FilePath temp_dir;
+  ASSERT_TRUE(base::GetTempDir(&temp_dir));
+  temp_dir = base::MakeAbsoluteFilePath(temp_dir);
+  EXPECT_TRUE(temp_dir.IsParent(user_data_dir))
+      << user_data_dir << " is not under " << temp_dir;
+}
+
+namespace {
+
+// The variable through which a unit test process hands its user-data folder
+// to the processes it starts (ChromeUnitTestSuite), and the one each
+// platform's base::GetTempDir reads first.
+constexpr base::FilePath::CharType kUserDataDirVariable[] =
+    FILE_PATH_LITERAL("STEDDING_UNIT_TESTS_USER_DATA_DIR");
+#if BUILDFLAG(IS_WIN)
+constexpr base::FilePath::CharType kTempDirVariable[] = L"TMP";
+#elif BUILDFLAG(IS_APPLE)
+constexpr base::FilePath::CharType kTempDirVariable[] = "MAC_CHROMIUM_TMPDIR";
+#else
+constexpr base::FilePath::CharType kTempDirVariable[] = "TMPDIR";
+#endif
+
+// The folder the child below was offered through kUserDataDirVariable.
+constexpr char kOfferedSwitch[] = "offered-user-data-dir";
+
+// What the child found its DIR_USER_DATA to be.
+constexpr int kTookTheOffer = 0;
+constexpr int kMadeItsOwn = 1;
+constexpr int kElsewhere = 2;
+
+}  // namespace
+
+// A unit test process offered a user-data folder: whether its DIR_USER_DATA
+// is that folder, one the suite made for it in its temporary folder, or
+// anything else.
+MULTIPROCESS_TEST_MAIN(ChromePathsOfferedUserDataDirChild) {
+  const base::FilePath offered = base::MakeAbsoluteFilePath(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          kOfferedSwitch));
+  base::FilePath user_data_dir;
+  base::FilePath temp_dir;
+  if (!base::PathService::Get(DIR_USER_DATA, &user_data_dir) ||
+      !base::GetTempDir(&temp_dir)) {
+    return kElsewhere;
+  }
+  if (!offered.empty() && user_data_dir == offered) {
+    return kTookTheOffer;
+  }
+  return base::MakeAbsoluteFilePath(temp_dir).IsParent(user_data_dir) &&
+                 user_data_dir.BaseName().value().starts_with(
+                     FILE_PATH_LITERAL("stedding_unit_tests_user_data"))
+             ? kMadeItsOwn
+             : kElsewhere;
+}
+
+// BACKLOG S-220: a unit test process takes the user-data folder its parent
+// hands it only when the parent's suite could have made it: named as the
+// suite names them, in the temporary folder. The variable could be left over
+// in a shell or a CI job's environment and name any folder, the person's own
+// data folder among them, and every test would write there with nothing to
+// delete it.
+TEST(ChromePaths, UnitTestsTakeOnlyATestFolderFromTheEnvironment) {
+  base::ScopedTempDir scratch;
+  ASSERT_TRUE(scratch.CreateUniqueTempDir());
+  // The child's temporary folder, and three folders offered to it.
+  const base::FilePath child_temp =
+      scratch.GetPath().Append(FILE_PATH_LITERAL("tmp"));
+  const base::FilePath named_right = child_temp.Append(
+      FILE_PATH_LITERAL("stedding_unit_tests_user_data_offered"));
+  const base::FilePath named_wrong =
+      child_temp.Append(FILE_PATH_LITERAL("Default"));
+  const base::FilePath outside = scratch.GetPath().Append(
+      FILE_PATH_LITERAL("stedding_unit_tests_user_data_outside"));
+  ASSERT_TRUE(base::CreateDirectory(named_right));
+  ASSERT_TRUE(base::CreateDirectory(named_wrong));
+  ASSERT_TRUE(base::CreateDirectory(outside));
+
+  const auto offer = [&](const base::FilePath& offered) {
+    base::CommandLine command_line =
+        base::GetMultiProcessTestChildBaseCommandLine();
+    command_line.AppendSwitchPath(kOfferedSwitch, offered);
+    base::LaunchOptions options;
+    options.environment[kTempDirVariable] = child_temp.value();
+    options.environment[kUserDataDirVariable] = offered.value();
+    base::Process child = base::SpawnMultiProcessTestChild(
+        "ChromePathsOfferedUserDataDirChild", command_line, options);
+    int exit_code = -1;
+    if (!child.IsValid() ||
+        !base::WaitForMultiprocessTestChildExit(
+            child, TestTimeouts::action_max_timeout(), &exit_code)) {
+      return -1;
+    }
+    return exit_code;
+  };
+
+  EXPECT_EQ(kTookTheOffer, offer(named_right))
+      << "a folder the suite could have made is used";
+  EXPECT_EQ(kMadeItsOwn, offer(named_wrong))
+      << "a folder not named as the suite names them is not";
+  EXPECT_EQ(kMadeItsOwn, offer(outside))
+      << "nor one outside the temporary folder";
 }
 
