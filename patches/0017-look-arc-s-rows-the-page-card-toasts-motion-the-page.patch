index 0000000000000..e1f0cfcc1917a
--- /dev/null
+++ b/chrome/browser/ui/stedding/motion_unittest.cc
@@ -0,0 +1,52 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/motion.h"
+
+#include "base/test/scoped_feature_list.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding_ui_metrics.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/animation/animation.h"
+
+namespace stedding {
+namespace {
+
+class MotionTest : public testing::Test {
+ protected:
+  MotionTest() { prefs::RegisterProfilePrefs(prefs_.registry()); }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+};
+
+// motion O1, O3: on by default; the preference alone stills it.
+TEST_F(MotionTest, PreferenceOffStillsIt) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  EXPECT_TRUE(ShouldAnimate(&prefs_));
+  EXPECT_TRUE(ShouldAnimate(nullptr));
+  prefs_.SetBoolean(prefs::kUiAnimate, false);
+  EXPECT_FALSE(ShouldAnimate(&prefs_));
+}
+
+// motion O1, O3: the system's Reduce Motion wins whatever the preference says.
+TEST_F(MotionTest, SystemReduceMotionStillsIt) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  EXPECT_FALSE(ShouldAnimate(&prefs_));
+  EXPECT_FALSE(ShouldAnimate(nullptr));
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  EXPECT_TRUE(ShouldAnimate(&prefs_));
+}
+
+// motion O2: the capture parameter forces the still path.
+TEST_F(MotionTest, CaptureParameterStillsIt) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  base::test::ScopedFeatureList features;
+  features.InitAndEnableFeatureWithParameters(kArcStyleWindow,
+                                              {{"reduce_motion", "true"}});
+  EXPECT_FALSE(ShouldAnimate(&prefs_));
+}
+
+}  // namespace
+}  // namespace stedding
