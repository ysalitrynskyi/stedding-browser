@@ -0,0 +1,48 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_TIDY_NAMES_H_
+#define CHROME_BROWSER_UI_STEDDING_TIDY_NAMES_H_
+
+#include <string>
+#include <string_view>
+
+#include "base/files/file_path.h"
+
+class GURL;
+
+namespace stedding {
+
+// docs/features/tabs.md R65 and sidebar-panels.md Pn17 (BACKLOG S-398): what
+// Arc's Tidy Tab Titles and Tidy Downloads did with a model, done by rules on
+// the device alone (ADR 0020). Nothing here reads the network or a model.
+
+// A pinned tab's title as its row shows it: a count of unread items at the
+// start or end of a part goes ("(3) Inbox", "Inbox (3)"); the title's parts,
+// split at " - ", " – ", " — ", " | " and " · ", lose any that is an email
+// address and the site's own name -- a part whose letters are one of the
+// host's labels or its registrable name, or, when no part was, the last of two
+// or more parts if it is one or two words. What is left keeps its words and
+// separators as written. A title the rules would empty, or leave at one
+// character, comes back unchanged.
+std::u16string TidyTitle(std::u16string_view title, const GURL& url);
+
+// Whether a file's name, without its extension, says nothing: "download",
+// "file", "document", "untitled", "attachment", "export", "image" or
+// "unnamed", with or without a number (" (3)", "_2", "-2", "3"); a run of 16
+// or more letters, digits, "-" and "_" with no space and at least one digit,
+// as a hash or an id; or digits alone.
+bool FileNameSaysNothing(const base::FilePath& name);
+
+// The name to save a download called `name` under: when `name` says nothing,
+// the page's title tidied as TidyTitle does, made safe for a file name, at
+// most 120 characters, with `name`'s extension. Empty when the name stays: it
+// says something, or the page has no title that does.
+base::FilePath TidyDownloadName(const base::FilePath& name,
+                                std::u16string_view page_title,
+                                const GURL& page_url);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_TIDY_NAMES_H_
diff --git a/chrome/browser/ui/stedding/tidy_names_unittest.cc b/chrome/browser/ui/stedding/tidy_names_unittest.cc
new file mode 100644
index 0000000000000..1bf3865537fd6
--- /dev/null
+++ b/chrome/browser/ui/stedding/tidy_names_unittest.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/tidy_names.h"
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/strings/utf_string_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// docs/features/tabs.md R65: the site's name, unread counts and accounts go;
+// the page's own words stay; a title the rules would empty stays whole.
+TEST(TidyNamesTest, TitlesLoseTheSiteCountersAndAccounts) {
+  struct Case {
+    const char16_t* title;
+    const char* url;
+    const char16_t* tidy;
+  };
+  const Case kCases[] = {
+      // The example of the owner's row (BACKLOG S-398).
+      {u"Inbox (3) – you@x.com – Gmail", "https://mail.google.com/",
+       u"Inbox"},
+      {u"(12) Inbox - you@example.com - Gmail", "https://mail.google.com/",
+       u"Inbox"},
+      // The site's name by a label of its host.
+      {u"Pull requests · torvalds/linux · GitHub",
+       "https://github.com/torvalds/linux/pulls",
+       u"Pull requests · torvalds/linux"},
+      {u"Apollo 11 - Wikipedia", "https://en.wikipedia.org/wiki/Apollo_11",
+       u"Apollo 11"},
+      // By its registrable name.
+      {u"Design review | Figma", "https://www.figma.com/file/x", u"Design review"},
+      // No part is the site's: a short last part is dropped.
+      {u"Q3 plan - Google Docs", "https://docs.google.com/document/d/x",
+       u"Q3 plan"},
+      // A long last part is the page's own words.
+      {u"Meeting notes - the plan for the October release",
+       "https://example.com/", u"Meeting notes - the plan for the October release"},
+      // One part: nothing to drop but a count.
+      {u"(5) Messenger", "https://www.messenger.com/", u"Messenger"},
+      {u"Slack", "https://app.slack.com/", u"Slack"},
+      // The rules would empty it, or leave one character.
+      {u"GitHub", "https://github.com/", u"GitHub"},
+      {u"X", "https://x.com/", u"X"},
+      {u"(3)", "https://example.com/", u"(3)"},
+      // A year in brackets is the title's, not a count.
+      {u"Dune: Part Two (2024) - IMDb", "https://www.imdb.com/title/x",
+       u"Dune: Part Two (2024)"},
+  };
+  for (const Case& c : kCases) {
+    SCOPED_TRACE(base::UTF16ToUTF8(c.title));
+    EXPECT_EQ(std::u16string(c.tidy), TidyTitle(c.title, GURL(c.url)));
+  }
+}
+
+// sidebar-panels Pn17: a name that says nothing takes the page's title, with
+// the file's extension; a name that says something stays.
+TEST(TidyNamesTest, AFileNameThatSaysNothingTakesThePagesTitle) {
+  for (const char* says_nothing :
+       {"download.pdf", "download (3).pdf", "Download(2).zip", "file_2.csv",
+        "image-4.png", "untitled.txt", "export3.xlsx", "attachment.bin",
+        "unnamed.jpg", "document.docx", "1699900000123.pdf",
+        "3f2a9c7e1b4d8a6f0e5c.pdf", "a1b2c3d4-e5f6-7890-abcd-ef1234567890.zip"}) {
+    SCOPED_TRACE(says_nothing);
+    EXPECT_TRUE(FileNameSaysNothing(base::FilePath::FromASCII(says_nothing)));
+  }
+  for (const char* says_something :
+       {"Invoice October.pdf", "report-2026.pdf", "setup.exe",
+        "downloads-guide.pdf", "my file.txt", "photo of the cat.jpg",
+        "annual-report-2026.pdf", "bank_statement_2026_10.pdf",
+        "googlechromestandaloneenterprise64.msi"}) {
+    SCOPED_TRACE(says_something);
+    EXPECT_FALSE(FileNameSaysNothing(base::FilePath::FromASCII(says_something)));
+  }
+
+  const GURL page("https://billing.example.com/invoices/4182");
+  EXPECT_EQ(base::FilePath::FromASCII("Invoice 4182.pdf"),
+            TidyDownloadName(base::FilePath::FromASCII("download (3).pdf"),
+                             u"Invoice 4182 - Example Billing", page));
+  // The name stays when it says something, or the page's title says nothing.
+  EXPECT_TRUE(TidyDownloadName(base::FilePath::FromASCII("Invoice.pdf"),
+                               u"Invoice 4182", page)
+                  .empty());
+  EXPECT_TRUE(TidyDownloadName(base::FilePath::FromASCII("download.pdf"),
+                               u"Download", page)
+                  .empty());
+  EXPECT_TRUE(TidyDownloadName(base::FilePath::FromASCII("download.pdf"),
+                               u"", page)
+                  .empty());
+  // Made safe for a file name, and at most 120 characters before the
+  // extension.
+  EXPECT_EQ(base::FilePath::FromASCII("Q3 plan draft v2.pdf"),
+            TidyDownloadName(base::FilePath::FromASCII("file.pdf"),
+                             u"Q3: plan / draft? v2", page));
+  const base::FilePath long_name = TidyDownloadName(
+      base::FilePath::FromASCII("file.pdf"), std::u16string(300, u'a'), page);
+  EXPECT_EQ(124u, long_name.AsUTF16Unsafe().size());
+  // No extension: the name stays, so a title's dot never becomes one.
+  EXPECT_TRUE(TidyDownloadName(base::FilePath::FromASCII("download"),
+                               u"Setup.exe", page)
+                  .empty());
+  // A title that ends in the extension keeps one.
+  EXPECT_EQ(base::FilePath::FromASCII("Q3 report.pdf"),
+            TidyDownloadName(base::FilePath::FromASCII("download.pdf"),
+                             u"Q3 report.pdf - Dropbox",
+                             GURL("https://www.dropbox.com/s/x")));
+  // The checks Chromium's own names pass: no right-to-left override, and no
+  // name Windows keeps for a device.
+  const base::FilePath bidi =
+      TidyDownloadName(base::FilePath::FromASCII("download.exe"),
+                       u"Invoice \u202Efdp", page);
+  EXPECT_EQ(std::u16string::npos, bidi.AsUTF16Unsafe().find(u'\u202E'))
+      << bidi.AsUTF8Unsafe();
+  EXPECT_TRUE(TidyDownloadName(base::FilePath::FromASCII("download.pdf"),
+                               u"AUX - Docs",
+                               GURL("https://docs.example.com/x"))
+                  .empty());
+}
+
+}  // namespace
+}  // namespace stedding
