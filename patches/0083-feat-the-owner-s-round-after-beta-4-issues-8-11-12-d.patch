+// pins H25 (the owner, 2026-10-22): once a card has stayed on a tab for its
+// wait, a line at its foot shows what the tab uses -- memory, CPU and
+// network -- and follows the tab while the card stays: a busy page reads its
+// CPU. The card's accessible description is the line. The card moved to
+// another row shows no line until that row's own wait is over, and then that
+// row's figures. A row asleep reads "Asleep", and the hover does not wake
+// it. A private window's card has the line too. The wait is shortened here;
+// the figures are read every second, as in use.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest, ACardShowsItsTabsUseAfterAPause) {
+  constexpr base::TimeDelta kWait = base::Milliseconds(400);
+  const auto shortened_wait =
+      TabHoverCardController::SetResourceLineDelayForTesting(kWait);
+  // A loop that keeps the page's renderer on one core for four seconds.
+  constexpr char kBusy[] =
+      "(() => { const end = Date.now() + 4000; while (Date.now() < end) {} "
+      "})();";
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Colour("ffffff")));
+  tabs::TabInterface* const busy =
+      OpenInBackground(Page("busy.test", "d02020"));
+  tabs::TabInterface* const idle =
+      OpenInBackground(Page("idle.test", "2040d0"));
+  tabs::TabInterface* const sleeper =
+      OpenInBackground(Page("sleeper.test", "20a040"));
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  ASSERT_FALSE(TaskManagerRuns()) << "the task manager runs with no card up";
+
+  {
+    SCOPED_TRACE("no line as the card shows; the tab's use after the wait");
+    const base::TimeTicks shown_at = base::TimeTicks::Now();
+    ASSERT_TRUE(ShowCardNow(cards(), RowOf(busy)));
+    EXPECT_EQ(u"", ResourceLine()) << "the line came with the card";
+    EXPECT_EQ(u"", CardDescription());
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !ResourceLine().empty(); }))
+        << "no line";
+    EXPECT_GE(base::TimeTicks::Now() - shown_at, kWait)
+        << "the line came before the wait was over";
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return HasEveryFigure(ResourceLine()); }))
+        << "the line reads " << ResourceLine();
+    EXPECT_TRUE(IsAMemoryFigure(PartsOf(ResourceLine())[0])) << ResourceLine();
+    EXPECT_EQ(ResourceLine(), CardDescription())
+        << "the card's accessible description is not the line";
+    EXPECT_TRUE(TaskManagerRuns()) << "nothing counts the tab's bytes";
+  }
+
+  {
+    SCOPED_TRACE("the line follows the tab: a busy page reads its CPU");
+    content::ExecuteScriptAsync(busy->GetContents(), kBusy);
+    EXPECT_TRUE(
+        base::test::RunUntil([&]() { return CpuOf(ResourceLine()) >= 30; }))
+        << "the line reads " << ResourceLine();
+    EXPECT_TRUE(HasEveryFigure(ResourceLine())) << ResourceLine();
+  }
+
+  {
+    // The busy page stays busy while the card reads the idle one, which has
+    // a renderer of its own: the idle row's line reads its own CPU.
+    SCOPED_TRACE("moved to another row: no line until that row has waited");
+    content::ExecuteScriptAsync(busy->GetContents(), kBusy);
+    const base::TimeTicks moved_at = base::TimeTicks::Now();
+    ASSERT_TRUE(ShowCardNow(cards(), RowOf(idle)));
+    EXPECT_EQ(u"", ResourceLine()) << "the busy row's line stayed";
+    EXPECT_EQ(u"", CardDescription());
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !ResourceLine().empty(); }))
+        << "no line on the second row";
+    EXPECT_GE(base::TimeTicks::Now() - moved_at, kWait)
+        << "the line came before the second row's wait was over";
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return HasEveryFigure(ResourceLine()); }))
+        << "the line reads " << ResourceLine();
+    EXPECT_LT(CpuOf(ResourceLine()), 30)
+        << "the idle row reads the busy row's CPU: " << ResourceLine();
+    Unhover();
+    EXPECT_FALSE(TaskManagerRuns()) << "the task manager runs on with no card";
+  }
+
+  {
+    SCOPED_TRACE("a row asleep reads Asleep, and the hover does not wake it");
+    stedding::SleepTabList({sleeper});
+    ASSERT_TRUE(sleeper->GetContents()->WasDiscarded());
+    ASSERT_TRUE(ShowCardNow(cards(), RowOf(sleeper)));
+    EXPECT_EQ(u"", ResourceLine()) << "the line came with the card";
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !ResourceLine().empty(); }))
+        << "no line on the sleeping row";
+    EXPECT_EQ(u"Asleep", ResourceLine());
+    EXPECT_EQ(u"Asleep", CardDescription());
+    RunFor(base::Milliseconds(1500));
+    EXPECT_EQ(u"Asleep", ResourceLine()) << "figures came for a tab asleep";
+    EXPECT_FALSE(TaskManagerRuns()) << "a tab asleep is being measured";
+    Unhover();
+    EXPECT_TRUE(sleeper->GetContents()->WasDiscarded()) << "the hover woke it";
+  }
+
+  {
+    SCOPED_TRACE("a private window's card has the line");
+    BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+    ASSERT_TRUE(incognito);
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        incognito, Page("private.test", "d0a020"),
+        WindowOpenDisposition::NEW_BACKGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    TabStripModel* const private_tabs = incognito->GetTabStripModel();
+    tabs::TabInterface* const tab =
+        private_tabs->GetTabAtIndex(private_tabs->count() - 1);
+    BrowserView* const private_view =
+        BrowserView::GetBrowserViewForBrowser(incognito);
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(private_view->GetWidget()));
+    TabHoverCardController* const private_cards =
+        private_view->tab_strip_view()->GetHoverCardController();
+    ASSERT_TRUE(private_cards) << "the private window has no hover cards";
+    ASSERT_TRUE(ShowCardNow(
+        private_cards, stedding::test::FindDrawnRow(
+                           private_view->GetWidget()->GetRootView(), tab)));
+    EXPECT_EQ(u"", LineOf(private_cards)) << "the line came with the card";
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return HasEveryFigure(LineOf(private_cards)); }))
+        << "the line reads " << LineOf(private_cards);
+    private_cards->UpdateHoverCard(nullptr, HoverCardUpdateType::kHover);
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return !private_cards->hover_card_for_testing(); }));
+    EXPECT_FALSE(TaskManagerRuns()) << "the task manager runs on with no card";
+  }
+}
+
