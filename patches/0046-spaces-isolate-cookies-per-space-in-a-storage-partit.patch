+void SpaceModel::SetSpaceIsolated(const SpaceId& id, bool isolated) {
+  if (!registry_) {
+    return;
+  }
+  if (isolated) {
+    registry_->EnsureIsolated(id);
+  } else {
+    registry_->SetProfileId(id, std::string());
+  }
+  observers_.Notify(&Observer::OnSpaceMetadataChanged, id);
+  RebindTabsInSpace(id);
+}
+
+bool SpaceModel::SpaceIsIsolated(const SpaceId& id) const {
+  if (!registry_) {
+    return false;
+  }
+  const RegistryEntry* const entry = registry_->Find(id);
+  return entry && !entry->profile_id.empty();
+}
+
 const SpaceId& SpaceModel::SpaceForTab(tabs::TabInterface* tab) {
   CHECK(tab);
   const auto [it, inserted] =
       tab_spaces_.try_emplace(tab->GetHandle(), SpaceIdForNewTab(tab));
   if (inserted) {
     SaveTabToSession(tab, it->second);
+    MaybeRebindTabJar(tab);
   }
   return it->second;
 }
@@ -1022,6 +1045,7 @@ void SpaceModel::SetSpaceForOneTab(tabs::TabInterface* tab, const SpaceId& id) {
   tab_spaces_.insert_or_assign(tab->GetHandle(), id);
   SaveTabToSession(tab, id);
   observers_.Notify(&Observer::OnTabSpaceChanged, tab);
+  MaybeRebindTabJar(tab);
 }
 
