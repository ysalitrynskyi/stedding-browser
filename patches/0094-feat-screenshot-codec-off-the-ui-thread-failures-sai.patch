+                            ->GetDeviceScaleFactor();
+    stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kFullPage);
+    ASSERT_NO_FATAL_FAILURE(WaitForToast(
+        browser(), ToastId::kSteddingCaptureSaved,
+        l10n_util::GetStringUTF16(IDS_STEDDING_CAPTURE_CROPPED_TOAST_BODY)));
+    const SkBitmap copied = ClipboardPicture();
+    ASSERT_FALSE(copied.drawsNothing());
+    EXPECT_EQ(width, copied.width()) << "the page's whole width";
+    EXPECT_LE(copied.height(), stedding::kMaxCaptureSide);
+    EXPECT_GE(copied.height(),
+              stedding::kMaxCaptureSide - static_cast<int>(std::ceil(scale)))
+        << "as much of the page as the limit allows";
+  }
+  for (const SkBitmap& picture : Pictures()) {
+    EXPECT_LE(picture.height(), stedding::kMaxCaptureSide);
+  }
+}
+
+// screenshot C11: each toast's button reveals the file that toast announced,
+// not the last file any window saved.
+IN_PROC_BROWSER_TEST_F(ScreenshotCaptureTest, EachToastRevealsItsOwnFile) {
+  stedding::SetRevealCaptureForTesting(base::BindRepeating(
+      [](std::vector<base::FilePath>* into, const base::FilePath& path) {
+        into->push_back(path);
+      },
+      &revealed_));
+  const std::u16string saved =
+      l10n_util::GetStringUTF16(IDS_STEDDING_CAPTURE_TOAST_BODY);
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kVisible);
+  ASSERT_NO_FATAL_FAILURE(
+      WaitForToast(browser(), ToastId::kSteddingCaptureSaved, saved));
+
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      second, embedded_test_server()->GetURL("/title2.html")));
+  stedding::CaptureScreenshot(second, stedding::CaptureMode::kVisible);
+  ASSERT_NO_FATAL_FAILURE(
+      WaitForToast(second, ToastId::kSteddingCaptureSaved, saved));
+  ASSERT_EQ(2, PngCount());
+  ASSERT_EQ(std::optional<ToastId>(ToastId::kSteddingCaptureSaved),
+            ToastController::From(browser())->GetCurrentToastId())
+      << "the first window's toast went away";
+
+  // The later capture's button first, then the earlier one's: with one path
+  // for the whole browser, both would reveal the second window's file.
+  ASSERT_NO_FATAL_FAILURE(PressToastButton(second));
+  ASSERT_NO_FATAL_FAILURE(PressToastButton(browser()));
+  ASSERT_EQ(2u, revealed_.size());
+  EXPECT_NE(revealed_[0], revealed_[1]);
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  for (const base::FilePath& path : revealed_) {
+    EXPECT_EQ(downloads_.GetPath(), path.DirName()) << path;
+    EXPECT_TRUE(path.MatchesExtension(FILE_PATH_LITERAL(".png"))) << path;
+    EXPECT_TRUE(base::PathExists(path)) << path;
+  }
+}
