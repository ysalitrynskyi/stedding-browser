+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::RectF bounds(GetLocalBounds());
+    SkScalar pure_hsv[3] = {hue_, 1, 1};
+    const SkPoint across[2] = {{bounds.x(), bounds.y()},
+                               {bounds.right(), bounds.y()}};
+    const SkColor4f across_colors[2] = {
+        SkColors::kWhite, SkColor4f::FromColor(SkHSVToColor(pure_hsv))};
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setShader(cc::PaintShader::MakeLinearGradient(
+        across, across_colors, nullptr, 2, SkTileMode::kClamp));
+    canvas->DrawRoundRect(bounds, 6, flags);
+    const SkPoint down[2] = {{bounds.x(), bounds.y()},
+                             {bounds.x(), bounds.bottom()}};
+    const SkColor4f down_colors[2] = {SkColors::kTransparent,
+                                      SkColors::kBlack};
+    flags.setShader(cc::PaintShader::MakeLinearGradient(
+        down, down_colors, nullptr, 2, SkTileMode::kClamp));
+    canvas->DrawRoundRect(bounds, 6, flags);
+    cc::PaintFlags ring;
+    ring.setAntiAlias(true);
+    ring.setStyle(cc::PaintFlags::kStroke_Style);
+    ring.setStrokeWidth(2);
+    ring.setColor(value_ > 0.6f && saturation_ < 0.4f ? SK_ColorBLACK
+                                                       : SK_ColorWHITE);
+    canvas->DrawCircle(
+        gfx::PointF(bounds.x() + saturation_ * bounds.width(),
+                    bounds.y() + (1 - value_) * bounds.height()),
+        6, ring);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    Pick(event.location());
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    Pick(event.location());
+    return true;
+  }
+
+ private:
+  void Pick(const gfx::Point& point) {
+    if (width() <= 0 || height() <= 0) {
+      return;
+    }
+    const float saturation =
+        std::clamp(static_cast<float>(point.x()) / width(), 0.f, 1.f);
+    const float value =
+        1 - std::clamp(static_cast<float>(point.y()) / height(), 0.f, 1.f);
+    changed_.Run(saturation, value);
+  }
+
+  const Changed changed_;
+  float hue_ = 0;
+  float saturation_ = 0;
+  float value_ = 0;
+};
