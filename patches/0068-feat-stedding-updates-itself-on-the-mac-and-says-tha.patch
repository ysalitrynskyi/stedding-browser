--- a/chrome/browser/ui/stedding/stedding_version.h
+++ b/chrome/browser/ui/stedding/stedding_version.h
@@ -5,6 +5,7 @@
 #ifndef CHROME_BROWSER_UI_STEDDING_STEDDING_VERSION_H_
 #define CHROME_BROWSER_UI_STEDDING_STEDDING_VERSION_H_
 
+#include <optional>
 #include <string>
 #include <string_view>
 
@@ -26,6 +27,26 @@ std::u16string AboutVersionString(std::u16string_view processor);
 // This build's Stedding version, empty when the build was made without it.
 std::string_view SteddingVersion();
 
+// updates Up11 (docs/features/updates.md): a Stedding version as VERSION and
+// the release tags write it, <major>.<minor>.<patch>, with -beta.<n> for a beta
+// (ADR 0014's tag shape). A beta comes before the release it leads to, and
+// betas follow their numbers.
+struct SteddingVersionNumber {
+  int major = 0;
+  int minor = 0;
+  int patch = 0;
+  // 0 for a release.
+  int beta = 0;
+};
+std::optional<SteddingVersionNumber> ParseSteddingVersion(
+    std::string_view version);
+// Whether `version` is later than `than`. False when either is not a Stedding
+// version: a version nobody can read is never an update.
+bool IsLaterSteddingVersion(std::string_view version, std::string_view than);
+
+// Tests: what SteddingVersion() answers until it is reset with nullopt.
+void SetSteddingVersionForTesting(std::optional<std::string> version);
+
 }  // namespace stedding
 
 #endif  // CHROME_BROWSER_UI_STEDDING_STEDDING_VERSION_H_
diff --git a/chrome/browser/ui/stedding/stedding_version_unittest.cc b/chrome/browser/ui/stedding/stedding_version_unittest.cc
index 7b929bba60949..84e73ec630fb3 100644
--- a/chrome/browser/ui/stedding/stedding_version_unittest.cc
+++ b/chrome/browser/ui/stedding/stedding_version_unittest.cc
@@ -26,5 +26,54 @@ TEST(SteddingVersionTest, AboutStringNamesBothVersions) {
       << base::UTF16ToUTF8(line);
 }
 
+// updates Up11: the versions VERSION and the tags write, in release order.
+TEST(SteddingVersionTest, VersionsCompareInReleaseOrder) {
+  const std::optional<SteddingVersionNumber> beta =
+      ParseSteddingVersion("0.2.0-beta.16");
+  ASSERT_TRUE(beta);
+  EXPECT_EQ(0, beta->major);
+  EXPECT_EQ(2, beta->minor);
+  EXPECT_EQ(0, beta->patch);
+  EXPECT_EQ(16, beta->beta);
+  EXPECT_EQ(0, ParseSteddingVersion("1.0.0")->beta);
+
+  // Each pair: the later version first.
+  const char* const kLater[][2] = {
+      {"0.2.0-beta.16", "0.2.0-beta.15"},
+      {"0.2.0-beta.10", "0.2.0-beta.9"},
+      {"0.2.0", "0.2.0-beta.99"},
+      {"0.2.1-beta.1", "0.2.0"},
+      {"0.3.0-beta.1", "0.2.9"},
+      {"1.0.0-beta.1", "0.99.99"},
+      {"0.10.0", "0.9.0"},
+  };
+  for (const auto& pair : kLater) {
+    EXPECT_TRUE(IsLaterSteddingVersion(pair[0], pair[1]))
+        << pair[0] << " after " << pair[1];
+    EXPECT_FALSE(IsLaterSteddingVersion(pair[1], pair[0]))
+        << pair[1] << " before " << pair[0];
+  }
+  EXPECT_FALSE(IsLaterSteddingVersion("0.2.0-beta.16", "0.2.0-beta.16"));
+}
+
+// updates Up11: anything else is not a Stedding version, and never an update.
+TEST(SteddingVersionTest, OtherStringsAreNotVersions) {
+  for (const char* text :
+       {"", "0.2", "0.2.0.1", "0.2.0-rc.1", "0.2.0-beta", "0.2.0-beta.",
+        "0.2.0-beta.0", "0.2.0-beta.1x", "0.2.0-beta.1-2", "v0.2.0", " 0.2.0",
+        "0.2.0 ", "0.-2.0", "0.+2.0", "150.0.1234.5", "0..0"}) {
+    EXPECT_FALSE(ParseSteddingVersion(text)) << '"' << text << '"';
+    EXPECT_FALSE(IsLaterSteddingVersion(text, "0.0.1")) << text;
+    EXPECT_FALSE(IsLaterSteddingVersion("9.0.0", text)) << text;
+  }
+}
+
+TEST(SteddingVersionTest, TestsCanSetTheVersion) {
+  SetSteddingVersionForTesting("0.2.0-beta.40");
+  EXPECT_EQ("0.2.0-beta.40", SteddingVersion());
+  SetSteddingVersionForTesting(std::nullopt);
+  EXPECT_NE("0.2.0-beta.40", SteddingVersion());
+}
+
 }  // namespace
 }  // namespace stedding
