+// Stedding pins H27 (BACKLOG S-277, S-289, GitHub issue 16): where a tab
+// dropped becomes an essential, as in Arc: over the essentials, and the room
+// above the Space's title row, down to the list, from the sidebar's top row
+// down. With no essentials the grid has no height, and the top row is where
+// a drag makes the first one. Nothing outside the open sidebar.
+std::optional<gfx::Rect> EssentialsDropZone(TabStripView* strip) {
+  if (!strip || !base::FeatureList::IsEnabled(stedding::kArcStyleWindow)) {
+    return std::nullopt;
+  }
+  views::ScrollView* const list = strip->unpinned_tabs_scroll_view();
+  if (!list || !list->IsDrawn()) {
+    return std::nullopt;
+  }
+  int bottom = list->GetBoundsInScreen().y();
+  if (views::View* const title = strip->GetSpaceTitleRow();
+      title && title->IsDrawn()) {
+    bottom = std::min(bottom, title->GetBoundsInScreen().y());
+  }
+  const gfx::Rect bounds = strip->GetBoundsInScreen();
+  int top = bounds.y();
+  for (const views::View* view = strip; view; view = view->parent()) {
+    if (views::IsViewClass<VerticalTabStripRegionView>(view)) {
+      top = std::min(top, view->GetBoundsInScreen().y());
+      break;
+    }
+  }
+  if (bottom <= top) {
+    return std::nullopt;
+  }
+  return gfx::Rect(bounds.x(), top, bounds.width(), bottom - top);
+}
