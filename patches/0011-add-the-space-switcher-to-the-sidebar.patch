+#ifndef CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_VIEW_H_
+
+#include "base/memory/raw_ref.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+namespace spaces {
+
+// The row of Space pills at the top of the sidebar.
+//
+// One pill per Space, the active one filled in that Space's colour, plus a
+// button that makes a new Space. Clicking a pill switches to that Space, which
+// changes which tabs the sidebar shows -- see SpaceTabVisibilityController.
+class SpaceSwitcherView : public views::View, public SpaceModel::Observer {
+  METADATA_HEADER(SpaceSwitcherView, views::View)
+
+ public:
+  explicit SpaceSwitcherView(SpaceModel& model);
+  SpaceSwitcherView(const SpaceSwitcherView&) = delete;
+  SpaceSwitcherView& operator=(const SpaceSwitcherView&) = delete;
+  ~SpaceSwitcherView() override;
+
+  // SpaceModel::Observer:
+  void OnSpaceAdded(const SpaceId& id) override;
+  void OnSpaceRemoved(const SpaceId& id) override;
+  void OnActiveSpaceChanged(const SpaceId& from, const SpaceId& to) override;
+  void OnSpaceMetadataChanged(const SpaceId& id) override;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+ private:
+  // Discards the pills and builds them again from the model. The row is at most
+  // a handful of buttons, so rebuilding is simpler and less error-prone than
+  // reconciling, and it happens only when Spaces change.
+  void Rebuild();
+
+  void OnSpacePressed(const SpaceId& id);
+  void OnNewSpacePressed();
+
+  const raw_ref<SpaceModel> model_;
+  base::ScopedObservation<SpaceModel, SpaceModel::Observer> observation_{this};
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_VIEW_H_
