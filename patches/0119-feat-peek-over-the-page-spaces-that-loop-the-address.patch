+    return testing::AssertionSuccess();
+  };
+  for (const bool in_sidebar : {false, true}) {
+    prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, in_sidebar);
+    for (const bool rail : {true, false}) {
+      controller()->RequestCollapse(rail);
+      Settle();
+      EXPECT_TRUE(own()) << "address in the sidebar " << in_sidebar
+                         << ", rail " << rail;
+    }
+  }
