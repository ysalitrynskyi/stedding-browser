+// toolbar T61 (GitHub issue 98): the bookmarks bar is part of the address
+// row's surface. It paints nothing of its own, so the window's ground lies
+// under it, or the page's colour while the row takes one, and its text and
+// icons are the row's. With the row hidden the bar alone is the page-coloured
+// strip, and the page starts square under it as under the row. The bar had
+// kept Material's own surface: a grey band between a dark page's row and the
+// page.
+IN_PROC_BROWSER_TEST_F(PageColourRowTest, TheBookmarksBarIsPartOfTheRow) {
+  constexpr SkColor kPage = SkColorSetRGB(0x11, 0x22, 0x33);
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(browser()->GetProfile());
+  bookmarks::test::WaitForBookmarkModelToLoad(model);
+  model->AddURL(model->bookmark_bar_node(), 0, u"Example",
+                GURL("https://example.com/"));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(),
+      GURL("data:text/html,<style>html{background:%23112233}</style>")));
+  ASSERT_TRUE(WaitForTheRow(kPage));
+  BookmarkBarController* const controller =
+      BookmarkBarController::From(browser());
+  ASSERT_TRUE(controller);
+  if (controller->bookmark_bar_state() != BookmarkBar::SHOW) {
+    chrome::ExecuteCommand(browser(), IDC_SHOW_BOOKMARK_BAR);  // the chord
+  }
+  BookmarkBarView* const bookmarks = view()->bookmark_bar();
+  ASSERT_TRUE(bookmarks);
+  const auto settled = [&] {
+    views::test::RunScheduledLayout(view());
+    return !view()->IsBookmarkBarAnimating();
+  };
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return settled() && controller->bookmark_bar_state() == BookmarkBar::SHOW &&
+           view()->IsBookmarkBarVisible() && !bookmarks->bounds().IsEmpty();
+  })) << "the premise: the bookmarks bar shows";
+  const auto bar_in_view = [&] {
+    gfx::RectF bounds(bookmarks->GetLocalBounds());
+    views::View::ConvertRectToTarget(bookmarks, view(), &bounds);
+    return bounds;
+  };
+  const auto top_radius = [&] {
+    return view()->multi_contents_view()->GetBackgroundRadii().upper_left();
+  };
+  // The bar's text, its buttons' icons and its folders' icons.
+  const auto expect_bar_foreground = [&](SkColor expected) {
+    const ui::ColorProvider* const colors =
+        view()->GetWidget()->GetColorProvider();
+    for (const ui::ColorId id : {kColorBookmarkBarForeground,
+                                 kColorBookmarkButtonIcon,
+                                 kColorBookmarkFolderIcon}) {
+      EXPECT_EQ(color_utils::SkColorToRgbaString(expected),
+                color_utils::SkColorToRgbaString(colors->GetColor(id)))
+          << "colour id " << id;
+    }
+  };
+  const SkColor on_page = color_utils::GetColorWithMaxContrast(kPage);
+  // Every button of the bar inside the bar: one that hangs below it is cut
+  // by the page.
+  const auto expect_buttons_inside = [&] {
+    // Laid out afresh, as at a launch with the row already hidden: the
+    // bar keeps its last layout while its own size stays the same.
+    bookmarks->InvalidateLayout();
+    views::test::RunScheduledLayout(view());
+    for (const views::View* const child : bookmarks->children()) {
+      if (child->GetVisible() && !child->bounds().IsEmpty() &&
+          views::IsViewClass<views::LabelButton>(child)) {
+        EXPECT_TRUE(bookmarks->GetLocalBounds().Contains(child->bounds()))
+            << "a button at " << child->bounds().ToString()
+            << " hangs out of the bar, " << bookmarks->GetLocalBounds().ToString();
+      }
+    }
+  };
+
+  [&] {
+    SCOPED_TRACE("under the row");
+    ASSERT_TRUE(view()->IsToolbarVisible());
+    const gfx::RectF surface = stedding::PageBarSurface(view());
+    EXPECT_TRUE(surface.Contains(bar_in_view()))
+        << "the page's colour stops short of the bar: the row's surface is "
+        << surface.ToString() << ", the bar " << bar_in_view().ToString();
+    EXPECT_FALSE(bookmarks->background())
+        << "the bar paints a colour of its own over the row's";
+    expect_bar_foreground(on_page);
+    expect_buttons_inside();
+    EXPECT_EQ(0.f, top_radius()) << "the page's top is rounded under the bar";
+  }();
+
+  [&] {
+    SCOPED_TRACE("the address in the sidebar, the bar shown");
+    PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+    prefs->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return settled() && !view()->IsToolbarVisible(); }));
+    ASSERT_TRUE(view()->IsBookmarkBarVisible());
+    const gfx::RectF surface = stedding::PageBarSurface(view());
+    EXPECT_TRUE(surface.Contains(bar_in_view()))
+        << "no page colour under the bar: the strip is " << surface.ToString()
+        << ", the bar " << bar_in_view().ToString();
+    expect_bar_foreground(on_page);
+    expect_buttons_inside();
+    EXPECT_EQ(0.f, top_radius()) << "the page's top is rounded under the bar";
+    prefs->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, false);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return settled() && view()->IsToolbarVisible(); }));
+  }();
+
+  [&] {
+    SCOPED_TRACE("the row hidden, the bar shown");
+    stedding::AddressRow* const address = stedding::AddressRow::From(browser());
+    ASSERT_TRUE(address);
+    address->Toggle();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return settled() && !view()->IsToolbarVisible(); }));
+    ASSERT_TRUE(view()->IsBookmarkBarVisible());
+    const gfx::RectF surface = stedding::PageBarSurface(view());
+    EXPECT_TRUE(surface.Contains(bar_in_view()))
+        << "no page colour under the bar: the strip is " << surface.ToString()
+        << ", the bar " << bar_in_view().ToString();
+    EXPECT_FLOAT_EQ(bar_in_view().y(), surface.y())
+        << "the strip starts above the bar";
+    expect_bar_foreground(on_page);
+    expect_buttons_inside();
+    EXPECT_EQ(0.f, top_radius()) << "the page's top is rounded under the bar";
+    address->Toggle();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return settled() && view()->IsToolbarVisible(); }));
+  }();
+}
