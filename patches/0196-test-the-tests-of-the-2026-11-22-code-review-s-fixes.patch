+// P16-1i; Sf31, Sf34 (and Sf27, Sf30 alike): a computer whose file is
+// deleted from the folder is no longer named in Settings' warning, nor in
+// its list of computers. The warning stayed until a restart, hiding any
+// problem ranked below it, and the computer stayed in the list for good,
+// kept in the ledger.
+IN_PROC_BROWSER_TEST_F(SidebarSyncW2B13Test,
+                       AComputerWhoseFileIsGoneLeavesTheWarningAndTheList) {
+  ASSERT_NO_FATAL_FAILURE(Join());
+  Scan();
+  const std::string before = Problem();
+  ASSERT_NE("unreadable", before);
+  ASSERT_NE("newer", before);
+
+  // Sf31: a file another computer left that cannot be read, then deleted.
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(
+        base::WriteFile(PeerFile(kPeerW2B13), "{ \"not\": \"a sidebar\""));
+  }
+  Scan();
+  ASSERT_EQ("unreadable", Problem());
+  ASSERT_TRUE(PeersName(kPeerW2B13));
+  ASSERT_NO_FATAL_FAILURE(RemovePeerFile(kPeerW2B13));
+  Scan();
+  EXPECT_EQ(before, Problem())
+      << "the deleted file is still said to be unreadable";
+  EXPECT_FALSE(PeersName(kPeerW2B13))
+      << "the computer whose file was deleted is still listed";
+
+  // Sf34: a later Stedding's file, then deleted.
+  WritePeer(PeerStateW2B13(base::Token::CreateRandom().ToString(), {},
+                           NowMsW2B13()),
+            1, kNewerPeerW2B13, sb::kFormat + 1);
+  Scan();
+  ASSERT_EQ("newer", Problem());
+  ASSERT_TRUE(PeersName("Laptop"));
+  ASSERT_NO_FATAL_FAILURE(RemovePeerFile(kNewerPeerW2B13));
+  Scan();
+  EXPECT_EQ(before, Problem())
+      << "the deleted file still asks for an update";
+  EXPECT_FALSE(PeersName("Laptop"))
+      << "the computer whose file was deleted is still listed";
+  const sb::Ledger* const ledger = service()->ledger_for_testing();
+  ASSERT_TRUE(ledger);
+  EXPECT_FALSE(ledger->peers.contains(kPeerW2B13));
+  EXPECT_FALSE(ledger->peers.contains(kNewerPeerW2B13));
+}
