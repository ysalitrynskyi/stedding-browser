+// P20, P13: closing a peek whose page asks "Leave site?" asks first, over the
+// card. Stay keeps the peek; Leave closes it. A link the page follows inside
+// the peek goes on in the peek, which stays.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, LeaveSiteAsksBeforeThePeekCloses) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  // The page asks before it is left: the handler, the user's activation
+  // "Leave site?" needs, and no hang timer.
+  const auto ask = [&]() {
+    ASSERT_TRUE(content::ExecJs(
+        page, "window.onbeforeunload = (e) => { e.preventDefault(); "
+              "e.returnValue = ''; };"));
+    content::PrepContentsForBeforeUnloadTest(page);
+  };
+  ASSERT_NO_FATAL_FAILURE(ask());
+
+  {
+    SCOPED_TRACE("Close, then Stay");
+    Press(peek->view()->close_button());
+    javascript_dialogs::AppModalDialogController* const dialog =
+        ui_test_utils::WaitForAppModalDialog();
+    ASSERT_TRUE(dialog);
+    ASSERT_TRUE(dialog->is_before_unload_dialog());
+    dialog->view()->CancelAppModalDialog();  // Stay.
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(peek, stedding::PeekOverlay::ForSource(pin)) << "Stay closed it";
+    EXPECT_TRUE(pin->IsBlocked());
+  }
+  {
+    // The page's own link goes on in the peek, Leave answered if the page
+    // asked: only Close's question closes the peek.
+    SCOPED_TRACE("a link inside the peek");
+    ASSERT_NO_FATAL_FAILURE(ask());
+    const GURL next = Url("b.test", "/title2.html");
+    content::ExecuteScriptAsync(
+        page, content::JsReplace("location.href = $1;", next));
+    auto* const queue = javascript_dialogs::AppModalDialogQueue::GetInstance();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      if (queue->HasActiveDialog()) {
+        queue->active_dialog()->view()->AcceptAppModalDialog();  // Leave.
+      }
+      return page->GetLastCommittedURL() == next;
+    })) << "the link did not go on in the peek";
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(peek, stedding::PeekOverlay::ForSource(pin))
+        << "the page's own link closed the peek";
+  }
+  {
+    SCOPED_TRACE("Close, then Leave");
+    ASSERT_NO_FATAL_FAILURE(ask());
+    Press(peek->view()->close_button());
+    javascript_dialogs::AppModalDialogController* const dialog =
+        ui_test_utils::WaitForAppModalDialog();
+    ASSERT_TRUE(dialog);
+    dialog->view()->AcceptAppModalDialog();  // Leave.
+    EXPECT_TRUE(WaitForNoPeek(pin));
+  }
+}
