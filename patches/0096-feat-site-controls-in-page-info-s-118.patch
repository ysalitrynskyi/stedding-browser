+// site-controls Si4: Mute is the mute key: it mutes the tab, its words flip,
+// the panel stays, and the key pressed with the panel open flips them back.
+// Picture in picture is off on a page with nothing to play, comes on while
+// the panel is open once a video plays, and opens the window.
+IN_PROC_BROWSER_TEST_F(SiteControlsTest, MuteAndPictureInPictureFollowTheKeys) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), Url("site.test", "/media/session/video-with-metadata.html")));
+  views::BubbleDialogDelegateView* const panel = OpenFromTheChip();
+  SiteControlsStripView* const strip = Strip(panel);
+  ASSERT_TRUE(strip);
+  EXPECT_EQ(u"Mute tab", strip->mute()->GetViewAccessibility().GetCachedName());
+  EXPECT_FALSE(strip->picture_in_picture()->GetEnabled())
+      << "nothing plays yet";
+
+  Click(strip->mute());
+  EXPECT_TRUE(page()->IsAudioMuted());
+  EXPECT_EQ(u"Unmute tab",
+            strip->mute()->GetViewAccessibility().GetCachedName());
+  EXPECT_EQ(panel, PageInfoBubbleViewBase::GetPageInfoBubbleForTesting())
+      << "Mute leaves the panel open";
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_TAB_MUTED));
+  EXPECT_FALSE(page()->IsAudioMuted());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return strip->mute()->GetViewAccessibility().GetCachedName() == u"Mute tab";
+  })) << "the key pressed with the panel open, the words did not follow";
+
+  content::MediaStartStopObserver started(
+      page(), content::MediaStartStopObserver::Type::kStart);
+  ASSERT_TRUE(content::ExecJs(page(), "play()"));
+  started.Wait();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return strip->picture_in_picture()->GetEnabled();
+  })) << "a playing video did not turn Picture in picture on";
+  Click(strip->picture_in_picture());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return page()->HasPictureInPictureVideo();
+  })) << "no picture in picture";
+  EXPECT_TRUE(PanelGoes());
+}
