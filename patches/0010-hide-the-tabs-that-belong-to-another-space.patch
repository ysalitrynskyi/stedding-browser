diff --git a/chrome/browser/ui/spaces/space_model_unittest.cc b/chrome/browser/ui/spaces/space_model_unittest.cc
index 1151fee68b44c..d60358b227f80 100644
--- a/chrome/browser/ui/spaces/space_model_unittest.cc
+++ b/chrome/browser/ui/spaces/space_model_unittest.cc
@@ -6,6 +6,7 @@
 
 #include <string>
 
+#include "components/tabs/public/mock_tab_interface.h"
 #include "testing/gtest/include/gtest/gtest.h"
 
 namespace spaces {
@@ -110,5 +111,71 @@ TEST(SpaceModelTest, NotifiesObservers) {
   model.RemoveObserver(&observer);
 }
 
+
+// Tab membership. Spaces filter one tab strip (ADR 0015), so which Space a tab
+// belongs to is a fact this model owns.
+
+TEST(SpaceModelTest, TabJoinsTheActiveSpaceTheFirstTimeItIsAsked) {
+  SpaceModel model;
+  tabs::MockTabInterface tab;
+  EXPECT_EQ(model.active_id(), model.SpaceForTab(&tab));
+}
+
+TEST(SpaceModelTest, TabStaysInItsSpaceWhenTheActiveSpaceChanges) {
+  SpaceModel model;
+  tabs::MockTabInterface tab;
+  const SpaceId home = model.SpaceForTab(&tab);
+
+  Space* const work = model.AddSpace("Work", kRed);
+  model.SetActiveSpace(work->id());
+
+  EXPECT_EQ(home, model.SpaceForTab(&tab))
+      << "switching Space must not move tabs between Spaces";
+  EXPECT_FALSE(model.IsTabInActiveSpace(&tab));
+
+  model.SetActiveSpace(home);
+  EXPECT_TRUE(model.IsTabInActiveSpace(&tab));
+}
+
+TEST(SpaceModelTest, NewTabsJoinWhicheverSpaceIsActive) {
+  SpaceModel model;
+  Space* const work = model.AddSpace("Work", kRed);
+  model.SetActiveSpace(work->id());
+
+  tabs::MockTabInterface tab;
+  EXPECT_EQ(work->id(), model.SpaceForTab(&tab));
+  EXPECT_TRUE(model.IsTabInActiveSpace(&tab));
+}
+
+TEST(SpaceModelTest, MovesATabBetweenSpaces) {
+  SpaceModel model;
+  tabs::MockTabInterface tab;
+  model.SpaceForTab(&tab);
+
+  Space* const work = model.AddSpace("Work", kRed);
+  model.SetSpaceForTab(&tab, work->id());
+
+  EXPECT_EQ(work->id(), model.SpaceForTab(&tab));
+  EXPECT_FALSE(model.IsTabInActiveSpace(&tab));
+}
+
+TEST(SpaceModelTest, RefusesToMoveATabToASpaceThatDoesNotExist) {
+  SpaceModel model;
+  tabs::MockTabInterface tab;
+  const SpaceId home = model.SpaceForTab(&tab);
+
+  model.SetSpaceForTab(&tab, SpaceId::GenerateNew());
+
+  EXPECT_EQ(home, model.SpaceForTab(&tab));
+}
+
+TEST(SpaceModelTest, ATabTheModelHasNeverSeenIsVisible) {
+  SpaceModel model;
+  tabs::MockTabInterface stranger;
+  // A window whose tabs predate Spaces must not blink out of existence.
+  EXPECT_TRUE(model.IsTabInActiveSpace(&stranger));
+  EXPECT_TRUE(model.IsTabInActiveSpace(nullptr));
+}
+
 }  // namespace
 }  // namespace spaces
