+void ClearTabsSeparator::UpdateClearControl() {
+  const bool clear = clear_callback_ && !GetClearRect().IsEmpty();
+  views::ViewAccessibility& accessibility = GetViewAccessibility();
+  // Ignored first: an ignored view is never focusable, and the focus
+  // behaviour below reads it.
+  accessibility.SetIsIgnored(!clear);
+  if (clear) {
+    accessibility.SetRole(ax::mojom::Role::kButton);
+    accessibility.SetName(std::u16string(kLabel));
+    accessibility.SetDescription(std::u16string(kTooltip));
+  }
+  // The rows' own behaviour: on the Mac, Tab reaches them with Full Keyboard
+  // Access on, as it reaches any button.
+  SetFocusBehavior(clear ? FocusBehavior::ACCESSIBLE_ONLY
+                         : FocusBehavior::NEVER);
+  accessibility.UpdateFocusableState();
+  if (views::FocusRing* const ring = views::FocusRing::Get(this)) {
+    ring->InvalidateLayout();
+    ring->SchedulePaint();
+  }
+}
+
+void ClearTabsSeparator::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::Separator::OnBoundsChanged(previous_bounds);
+  UpdateClearControl();
+}
+
+bool ClearTabsSeparator::OnKeyPressed(const ui::KeyEvent& event) {
+  if (!clear_callback_ || GetClearRect().IsEmpty() ||
+      (event.key_code() != ui::VKEY_RETURN &&
+       event.key_code() != ui::VKEY_SPACE)) {
+    return views::Separator::OnKeyPressed(event);
+  }
+  clear_callback_.Run();
+  return true;
+}
+
+bool ClearTabsSeparator::HandleAccessibleAction(
+    const ui::AXActionData& action_data) {
+  if (action_data.action == ax::mojom::Action::kDoDefault && clear_callback_ &&
+      !GetClearRect().IsEmpty()) {
+    clear_callback_.Run();
+    return true;
+  }
+  return views::Separator::HandleAccessibleAction(action_data);
+}
