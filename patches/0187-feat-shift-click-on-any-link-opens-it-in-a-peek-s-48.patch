+// peek P27 (GitHub discussion 115): Shift-click on any link, from a tab that
+// is not pinned, to the same site or another, opens a peek over the page, as
+// Arc's does; a link that opens a page of its own (target=_blank) too. With
+// "Shift-click a link to peek at it" off, Shift-click opens a window, as in
+// Chromium.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, AShiftClickPeeksFromAnyTab) {
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Url("a.test", "/title1.html")));
+  ASSERT_TRUE(content::ExecJs(
+      contents(),
+      base::StringPrintf(
+          "for (const [id, to, target] of [['same', '%s', ''],"
+          "                                ['blank', '%s', '_blank']]) {"
+          "  const a = document.createElement('a');"
+          "  a.id = id; a.href = to; a.textContent = id;"
+          "  if (target) a.target = target;"
+          "  a.style = 'display:block;font-size:40px;padding:20px';"
+          "  document.body.prepend(a);"
+          "}",
+          Url("a.test", "/title2.html").spec().c_str(),
+          Url("b.test", "/title3.html").spec().c_str()),
+      content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+  // A page just loaded takes no input until its first frame is shown (paint
+  // holding), and a click is routed by the compositor's hit-test data. The
+  // ASan build had neither when it clicked, and the click never reached the
+  // page: no peek, no window, the tab where it was.
+  content::SimulateEndOfPaintHoldingOnPrimaryMainFrame(contents());
+  content::WaitForHitTestData(contents()->GetPrimaryMainFrame());
+  tabs::TabInterface* const source = tab();
+  ASSERT_FALSE(source->IsPinned());
+  const int windows = WindowCount();
+  const int tab_count = tabs().count();
+  // A real Shift-click, the user's own, in the middle of the link `id`.
+  const auto shift_click = [&](const char* id) {
+    const std::string box = base::StringPrintf(
+        "document.getElementById('%s').getBoundingClientRect()", id);
+    const int x =
+        content::EvalJs(contents(), "Math.round(" + box + ".left + 20)")
+            .ExtractInt();
+    const int y = content::EvalJs(contents(), "Math.round(" + box + ".top + " +
+                                                  box + ".height / 2)")
+                      .ExtractInt();
+    content::SimulateMouseClickAt(contents(), blink::WebInputEvent::kShiftKey,
+                                  blink::WebMouseEvent::Button::kLeft,
+                                  gfx::Point(x, y));
+  };
+  for (const auto& [id, to] :
+       {std::pair{"same", Url("a.test", "/title2.html")},
+        std::pair{"blank", Url("b.test", "/title3.html")}}) {
+    SCOPED_TRACE(id);
+    shift_click(id);
+    stedding::PeekOverlay* const peek = WaitForPeek(source);
+    ASSERT_TRUE(peek);
+    EXPECT_EQ(to, peek->page()->GetLastCommittedURL());
+    EXPECT_EQ(windows, WindowCount()) << "a window opened";
+    EXPECT_EQ(tab_count, tabs().count()) << "a tab opened";
+    EXPECT_EQ(Url("a.test", "/title1.html"), contents()->GetLastCommittedURL())
+        << "the tab followed the link";
+    Press(peek->view()->close_button());
+    ASSERT_TRUE(WaitForNoPeek(source));
+  }
+  {
+    SCOPED_TRACE("the setting off");
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kPeekShiftClick, false);
+    shift_click("same");
+    ASSERT_TRUE(ui_test_utils::WaitForBrowserToOpen())
+        << "Shift-click opened no window";
+    EXPECT_EQ(windows + 1, WindowCount());
+    EXPECT_FALSE(stedding::PeekOverlay::ForSource(source));
+  }
+}
