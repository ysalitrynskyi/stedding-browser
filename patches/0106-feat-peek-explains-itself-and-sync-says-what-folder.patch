new file mode 100644
index 0000000000000..eb98731b292ba
--- /dev/null
+++ b/chrome/browser/ui/stedding/peek_notice.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/peek_notice.h"
+
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/infobars/confirm_infobar_creator.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// Settings, searched for the peek rows: the switch and "Open a peek with".
+constexpr char kPeekSettingsURL[] = "chrome://settings/stedding?search=peek";
+
+// The profile's own: a private window's prefs are forgotten when the last
+// private window closes, and the note would come back after it.
+PrefService* PrefsOf(content::WebContents* page) {
+  Profile* const profile =
+      page ? Profile::FromBrowserContext(page->GetBrowserContext()) : nullptr;
+  return profile ? profile->GetOriginalProfile()->GetPrefs() : nullptr;
+}
+
+void MarkAnswered(PrefService* prefs) {
+  if (prefs) {
+    prefs->SetBoolean(prefs::kPeekNoticeAnswered, true);
+  }
+}
+
+class PeekNoticeDelegate : public ConfirmInfoBarDelegate {
+ public:
+  explicit PeekNoticeDelegate(PrefService* prefs) : prefs_(prefs) {}
+  PeekNoticeDelegate(const PeekNoticeDelegate&) = delete;
+  PeekNoticeDelegate& operator=(const PeekNoticeDelegate&) = delete;
+  ~PeekNoticeDelegate() override = default;
+
+  // ConfirmInfoBarDelegate:
+  InfoBarIdentifier GetIdentifier() const override {
+    return STEDDING_PEEK_NOTICE_INFOBAR_DELEGATE;
+  }
+  std::u16string GetMessageText() const override {
+    return l10n_util::GetStringUTF16(IDS_STEDDING_PEEK_NOTICE);
+  }
+  int GetButtons() const override { return BUTTON_OK; }
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return l10n_util::GetStringUTF16(IDS_STEDDING_PEEK_NOTICE_GOT_IT);
+  }
+  std::u16string GetLinkText() const override {
+    return l10n_util::GetStringUTF16(IDS_STEDDING_PEEK_NOTICE_SETTINGS);
+  }
+  GURL GetLinkURL() const override { return GURL(kPeekSettingsURL); }
+  // A peek has no tabs: the page opens in a tab of a normal window.
+  bool LinkClicked(WindowOpenDisposition disposition) override {
+    MarkAnswered(prefs_);
+    ConfirmInfoBarDelegate::LinkClicked(
+        WindowOpenDisposition::NEW_FOREGROUND_TAB);
+    return true;
+  }
+  bool Accept() override {
+    MarkAnswered(prefs_);
+    return true;
+  }
+  void InfoBarDismissed() override { MarkAnswered(prefs_); }
+  // It stays while the peek follows links: it is about the window.
+  bool ShouldExpire(const NavigationDetails& details) const override {
+    return false;
+  }
+
+ private:
+  // The profile's, which outlives every page of it.
+  const raw_ptr<PrefService> prefs_;
+};
+
+infobars::InfoBar* FindNotice(content::WebContents* page) {
+  infobars::ContentInfoBarManager* const manager =
+      page ? infobars::ContentInfoBarManager::FromWebContents(page) : nullptr;
+  if (!manager) {
+    return nullptr;
+  }
+  for (infobars::InfoBar* const infobar : manager->infobars()) {
+    if (infobar->delegate()->GetIdentifier() ==
+        infobars::InfoBarDelegate::STEDDING_PEEK_NOTICE_INFOBAR_DELEGATE) {
+      return infobar;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+void MaybeShowPeekNotice(content::WebContents* page) {
+  PrefService* const prefs = PrefsOf(page);
+  if (!prefs || prefs->GetBoolean(prefs::kPeekNoticeAnswered) ||
+      prefs->GetInteger(prefs::kPeekNoticeShown) >=
+          prefs::kPeekNoticeMaxShown ||
+      FindNotice(page)) {
+    return;
+  }
+  infobars::ContentInfoBarManager* const manager =
+      infobars::ContentInfoBarManager::FromWebContents(page);
+  if (!manager) {
+    return;
+  }
+  prefs->SetInteger(prefs::kPeekNoticeShown,
+                    prefs->GetInteger(prefs::kPeekNoticeShown) + 1);
+  manager->AddInfoBar(
+      CreateConfirmInfoBar(std::make_unique<PeekNoticeDelegate>(prefs)));
+}
+
+void OnPeekPageKept(content::WebContents* page) {
+  // Keeping a peek shows it is understood, the note on it or not.
+  MarkAnswered(PrefsOf(page));
+  if (infobars::InfoBar* const notice = FindNotice(page)) {
+    notice->RemoveSelf();
+  }
+}
+
+bool HasPeekNoticeForTesting(content::WebContents* page) {
+  return FindNotice(page) != nullptr;
+}
+
+}  // namespace stedding
