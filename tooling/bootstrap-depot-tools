#!/usr/bin/env bash
# Install or update Chromium's depot_tools, and verify the macOS host toolchain.
#
# Usage: tooling/bootstrap-depot-tools
#
# Idempotent: safe to re-run. Prints the depot_tools revision it ended up on so a
# build can be attributed to an exact toolchain state.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

require_macos_arm64

log "checking host toolchain"

command -v git >/dev/null    || die "git not found"
command -v python3 >/dev/null || die "python3 not found"

# The Command Line Tools ship their own xcodebuild, so `command -v xcodebuild` proves
# nothing about whether full Xcode is present. What matters is where xcode-select
# points, so check that first and let it produce the useful message.
xcode_path="$(xcode-select -p 2>/dev/null || true)"
case "$xcode_path" in
  */Xcode.app/*) : ;;
  "")
    die "xcode-select is not configured. Chromium needs the full Xcode, not just the
     Command Line Tools. Install Xcode from the App Store, then:
       sudo xcode-select --switch /Applications/Xcode.app/Contents/Developer" ;;
  *)
    if [ -d /Applications/Xcode.app ]; then
      die "xcode-select points at '$xcode_path', which is not full Xcode.
     Xcode is installed, so just point at it:
       sudo xcode-select --switch /Applications/Xcode.app/Contents/Developer"
    fi
    die "xcode-select points at '$xcode_path', which is the Command Line Tools.
     Chromium needs the full Xcode. Install it from the App Store, launch it once so
     it installs its additional components, then:
       sudo xcode-select --switch /Applications/Xcode.app/Contents/Developer" ;;
esac

command -v xcodebuild >/dev/null || die "xcodebuild not found under $xcode_path"

# xcrun fails for two different reasons and the remedies are different, so say both
# rather than guessing. An unaccepted licence is the documented one; a first launch
# that never installed Xcode's additional components is at least as common.
if ! /usr/bin/xcrun --find clang >/dev/null 2>&1; then
  die "xcrun cannot find clang under $xcode_path. Usually one of:
       sudo xcodebuild -license accept      # licence not accepted yet
       sudo xcodebuild -runFirstLaunch      # additional components not installed
     Running both is harmless if only one was needed."
fi

log "Xcode:  $(xcodebuild -version | head -1) ($xcode_path)"
log "macOS:  $(sw_vers -productVersion) $(uname -m)"
log "python: $(python3 --version 2>&1)"
log "git:    $(git --version)"

if [ -d "$DEPOT_TOOLS_DIR/.git" ]; then
  log "updating depot_tools at $DEPOT_TOOLS_DIR"
  git -C "$DEPOT_TOOLS_DIR" fetch --depth 1 origin main
  git -C "$DEPOT_TOOLS_DIR" reset --hard FETCH_HEAD
else
  log "cloning depot_tools into $DEPOT_TOOLS_DIR"
  git clone --depth 1 https://chromium.googlesource.com/chromium/tools/depot_tools.git \
    "$DEPOT_TOOLS_DIR"
fi

add_depot_tools_to_path

log "depot_tools revision: $(git -C "$DEPOT_TOOLS_DIR" rev-parse HEAD)"
log "depot_tools date:     $(git -C "$DEPOT_TOOLS_DIR" log -1 --format=%cI)"

cat >&2 <<EOF

depot_tools is installed at $DEPOT_TOOLS_DIR.

Add it to your PATH for interactive use (the Stedding scripts do this themselves):

    export PATH="$DEPOT_TOOLS_DIR:\$PATH"

Next: tooling/sync-chromium
EOF
