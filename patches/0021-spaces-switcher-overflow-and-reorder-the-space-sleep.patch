+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_switcher_rules.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+namespace {
+
+// spaces B24-B26: a full sidebar (352) holds eight chips and the plus; twelve
+// overflow; below the threshold nothing changes.
+TEST(SwitcherRulesTest, OverflowShrinksInactiveChips) {
+  EXPECT_FALSE(SwitcherOverflows(352, 5));
+  EXPECT_FALSE(SwitcherOverflows(352, 8));
+  EXPECT_TRUE(SwitcherOverflows(352, 12));
+  EXPECT_TRUE(SwitcherOverflows(126, 3));
+
+  EXPECT_EQ(kSwitcherChip, SwitcherChipWidth(false, false, false));
+  EXPECT_EQ(kSwitcherDot, SwitcherChipWidth(true, false, false));
+  EXPECT_EQ(kSwitcherChip, SwitcherChipWidth(true, true, false));
+  // Hovering the row grows them back (B25).
+  EXPECT_EQ(kSwitcherChip, SwitcherChipWidth(true, false, true));
+}
+
+}  // namespace
+}  // namespace spaces
