new file mode 100644
index 0000000000000..4fd7313b93d34
--- /dev/null
+++ b/chrome/browser/ui/stedding/site_cookies.h
@@ -0,0 +1,68 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SITE_COOKIES_H_
+#define CHROME_BROWSER_UI_STEDDING_SITE_COOKIES_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "content/public/browser/browsing_data_remover.h"
+
+class GURL;
+
+namespace content {
+class BrowsingDataFilterBuilder;
+class StoragePartitionConfig;
+class WebContents;
+}  // namespace content
+
+namespace stedding {
+
+// Clear Site Cookies and Reload (docs/features/commandbar.md K24,
+// docs/features/sessions.md S27): Option-Shift-Cmd-R, Ctrl+Alt+Shift+R on
+// Windows, and the command bar's row of that name delete the cookies of the
+// selected tab's site from the jar its page lives in, then reload the tab.
+
+// What the command removes: the site's cookies, and the device-bound sessions
+// that would otherwise renew them. Site storage, cache, history and passwords
+// stay. Every type here lives on a StoragePartition, which
+// BrowsingDataRemoverImpl requires of a removal that names one.
+inline constexpr uint64_t kSiteCookieRemoveMask =
+    content::BrowsingDataRemover::DATA_TYPE_COOKIES |
+    content::BrowsingDataRemover::DATA_TYPE_DEVICE_BOUND_SESSIONS;
+
+// The site whose cookies the command removes for a page at `url`: its
+// registrable domain, private registries counted (www.news.example.co.uk
+// gives example.co.uk, foo.github.io stays foo.github.io), or the host as it
+// is for an IP address or a host with no known registry (localhost, b.test),
+// the way Chromium's Clear-Site-Data scopes cookies. Empty unless `url` is an
+// http or https address (K24: web pages only).
+std::string SiteCookieDomain(const GURL& url);
+
+// The removal's filter: `domain`'s cookies in every cookie partition, in the
+// jar `config` names and in no other. The jar is always named, the profile's
+// default one too: ChromeBrowsingDataRemoverDelegate repeats a removal that
+// names none into every Space's own jar (sessions S24), and this one must
+// stay in the jar the page lives in (S27).
+std::unique_ptr<content::BrowsingDataFilterBuilder> SiteCookieFilter(
+    const std::string& domain,
+    const content::StoragePartitionConfig& config);
+
+// Whether the command can act on `contents`: an http or https page, error
+// pages for such an address included. The window's command, and with it the
+// bar's row (K10), is enabled by this.
+bool CanClearSiteCookies(content::WebContents* contents);
+
+// The command. Removes the cookies of `contents`'s site from the jar its page
+// was created in and, once BrowsingDataRemover reports the removal done,
+// shows the "Cookies cleared for <site>" toast and reloads the page. Nothing
+// is reloaded if, in the meantime, the tab closed, its page went to sleep or
+// to another site, or the cookies could not be removed.
+void ClearSiteCookiesAndReload(content::WebContents* contents);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SITE_COOKIES_H_
diff --git a/chrome/browser/ui/stedding/site_cookies_unittest.cc b/chrome/browser/ui/stedding/site_cookies_unittest.cc
new file mode 100644
index 0000000000000..19ad5ea88ca12
--- /dev/null
+++ b/chrome/browser/ui/stedding/site_cookies_unittest.cc
@@ -0,0 +1,128 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/site_cookies.h"
+
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/test/base/testing_profile.h"
+#include "content/public/browser/browsing_data_filter_builder.h"
+#include "content/public/browser/browsing_data_remover.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/test/browser_task_environment.h"
+#include "net/cookies/cookie_partition_key_collection.h"
+#include "services/network/public/mojom/cookie_manager.mojom.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// One fixture for the suite: gtest wants every test of a suite on the same
+// one, and the filter's jars need a profile.
+class SiteCookiesTest : public testing::Test {
+ protected:
+  content::BrowserTaskEnvironment task_environment_;
+  TestingProfile profile_;
+};
+
+// commandbar K24: the site is the page's registrable domain, private
+// registries counted; an IP address or a host with no known registry is
+// taken as it is, as Clear-Site-Data takes it.
+TEST_F(SiteCookiesTest, TheSiteIsTheRegistrableDomain) {
+  EXPECT_EQ("example.co.uk",
+            SiteCookieDomain(GURL("https://www.news.example.co.uk/a?b=c")));
+  EXPECT_EQ("example.com", SiteCookieDomain(GURL("http://example.com:8080/")));
+  EXPECT_EQ("example.com",
+            SiteCookieDomain(GURL("https://accounts.example.com/login")));
+  EXPECT_EQ("foo.github.io", SiteCookieDomain(GURL("https://foo.github.io/")))
+      << "github.io is a private registry";
+  EXPECT_EQ("foo.github.io",
+            SiteCookieDomain(GURL("https://www.foo.github.io/")));
+  EXPECT_EQ("127.0.0.1", SiteCookieDomain(GURL("http://127.0.0.1:8000/x")));
+  EXPECT_EQ("localhost", SiteCookieDomain(GURL("http://localhost/")));
+  EXPECT_EQ("b.test", SiteCookieDomain(GURL("http://b.test/echoheader")));
+}
+
+// commandbar K24: only an http or https page has a site, so the command is
+// off on the browser's own pages, the new tab page, file, data and blank
+// pages, and extension pages.
+TEST_F(SiteCookiesTest, OnlyTheWebHasASite) {
+  for (const char* spec :
+       {"about:blank", "chrome://settings/", "chrome://newtab/",
+        "chrome://new-tab-page/", "file:///C:/page.html", "file:///tmp/a.html",
+        "data:text/html,<p>x</p>",
+        "chrome-extension://abcdefghijklmnopabcdefghijklmnop/page.html",
+        "blob:https://example.com/0f6a1f9e-2c4c-4d6e-9f3e-1b7c3a5d2e10",
+        "javascript:void(0)", "not a url"}) {
+    EXPECT_EQ(std::string(), SiteCookieDomain(GURL(spec))) << spec;
+  }
+  EXPECT_EQ(std::string(), SiteCookieDomain(GURL()));
+  EXPECT_FALSE(CanClearSiteCookies(nullptr));
+}
+
+// commandbar K24, sessions S27: for the profile's jar and for a Space's own,
+// the filter deletes exactly the domain, names exactly that jar (so the
+// S24 copy into every Space's jar does not run), matches the domain's
+// cookies in every cookie partition, and the mask holds only data that lives
+// on a partition (so BrowsingDataRemoverImpl accepts a named jar).
+TEST_F(SiteCookiesTest, TheFilterNamesItsJarAndNothingElse) {
+  const std::optional<content::StoragePartitionConfig> space_jar =
+      spaces::StoragePartitionConfigForProfileId(&profile_, "5f0c2d1e9a7b4c3d");
+  ASSERT_TRUE(space_jar.has_value());
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(*space_jar));
+  const content::StoragePartitionConfig jars[] = {
+      content::StoragePartitionConfig::CreateDefault(&profile_), *space_jar};
+
+  for (const content::StoragePartitionConfig& jar : jars) {
+    SCOPED_TRACE(jar.partition_name());
+    std::unique_ptr<content::BrowsingDataFilterBuilder> filter =
+        SiteCookieFilter("example.com", jar);
+    ASSERT_TRUE(filter);
+    EXPECT_EQ(content::BrowsingDataFilterBuilder::Mode::kDelete,
+              filter->GetMode());
+    EXPECT_EQ(std::set<std::string>({"example.com"}),
+              filter->GetRegisterableDomains());
+    EXPECT_TRUE(filter->GetOrigins().empty());
+    EXPECT_FALSE(filter->MatchesNothing());
+    EXPECT_FALSE(filter->MatchesMostOriginsAndDomains());
+    EXPECT_FALSE(filter->PartitionedCookiesOnly());
+
+    const std::optional<content::StoragePartitionConfig> named =
+        filter->GetStoragePartitionConfig();
+    ASSERT_TRUE(named.has_value())
+        << "a removal that names no jar reaches every Space's";
+    EXPECT_EQ(jar, *named);
+
+    const network::mojom::CookieDeletionFilterPtr cookies =
+        filter->BuildCookieDeletionFilter();
+    ASSERT_TRUE(cookies);
+    ASSERT_TRUE(cookies->including_domains.has_value());
+    EXPECT_EQ(std::vector<std::string>({"example.com"}),
+              *cookies->including_domains);
+    EXPECT_FALSE(cookies->excluding_domains.has_value());
+    EXPECT_FALSE(cookies->partitioned_state_only);
+    EXPECT_TRUE(!cookies->cookie_partition_key_collection.has_value() ||
+                cookies->cookie_partition_key_collection->ContainsAllKeys())
+        << "the domain's cookies in every partition";
+  }
+
+  using Remover = content::BrowsingDataRemover;
+  EXPECT_EQ(0u,
+            kSiteCookieRemoveMask & ~Remover::DATA_TYPE_ON_STORAGE_PARTITION);
+  EXPECT_TRUE(kSiteCookieRemoveMask & Remover::DATA_TYPE_COOKIES);
+  EXPECT_TRUE(kSiteCookieRemoveMask & Remover::DATA_TYPE_DEVICE_BOUND_SESSIONS);
+  EXPECT_FALSE(kSiteCookieRemoveMask & Remover::DATA_TYPE_DOM_STORAGE)
+      << "the site's storage stays";
+  EXPECT_FALSE(kSiteCookieRemoveMask & Remover::DATA_TYPE_CACHE)
+      << "the cache stays";
+}
+
+}  // namespace
+}  // namespace stedding
