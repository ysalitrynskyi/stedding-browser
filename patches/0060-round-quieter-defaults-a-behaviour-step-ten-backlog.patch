diff --git a/chrome/browser/ui/stedding/pin_lifecycle.cc b/chrome/browser/ui/stedding/pin_lifecycle.cc
index 8664c97876696..15e1769804a31 100644
--- a/chrome/browser/ui/stedding/pin_lifecycle.cc
+++ b/chrome/browser/ui/stedding/pin_lifecycle.cc
@@ -157,4 +157,39 @@ GURL PinnedSiteFor(BrowserWindowInterface* browser, tabs::TabInterface* tab) {
   return contents ? contents->GetLastCommittedURL() : GURL();
 }
 
+bool SetHomeAndGo(BrowserWindowInterface* browser,
+                  tabs::TabInterface* tab,
+                  const GURL& home) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  if (!IsAllowedPinHome(home) || !model || !IsPinnedAnywhere(browser, tab)) {
+    return false;
+  }
+  // The model keeps the home for a Space pin and for an essential, even one
+  // that had none, and writes it to the session; the drift mark repaints.
+  model->SetHomeUrl(tab, home);
+  if (model->HomeUrl(tab) != home) {
+    return false;
+  }
+  // A sleeping pin wakes up to load it, as a reset does.
+  ResetToHome(browser, tab);
+  return true;
+}
+
+MiddleClickAction MiddleClickActionFor(BrowserWindowInterface* browser,
+                                       const tabs::TabInterface* tab) {
+  if (!tab) {
+    return MiddleClickAction::kNothing;
+  }
+  if (!IsPinnedAnywhere(browser, tab)) {
+    return MiddleClickAction::kClose;
+  }
+  // H16: a pin is never closed by a middle click, whatever Cmd-W's setting
+  // (H9) says; a pin in a window without Spaces (a private window) does
+  // nothing, as Cmd-W does there (H3).
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  return (model && model->HomeUrl(tab).has_value())
+             ? MiddleClickAction::kGoHome
+             : MiddleClickAction::kNothing;
+}
+
 }  // namespace stedding
