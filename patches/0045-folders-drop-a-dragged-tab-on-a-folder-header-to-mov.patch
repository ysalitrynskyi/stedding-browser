       << "the nested tab still counts inside the outer folder";
 }
 
+// Stedding folders: a tab dropped on a folder joins it at the end; tabs move
+// one by one so the tree stays valid; pinned tabs are refused untouched.
+TEST_F(TabStripModelTest, MoveTabsToFolderAppendsNestsAndRefusesPins) {
+  ASSERT_NO_FATAL_FAILURE(
+      PrepareTabstripForSelectionTest(tabstrip(), 4, 0, {0}));
+  tabs::FolderTabCollection* const folder = tabstrip()->AddToNewFolder({1, 2});
+  ASSERT_NE(nullptr, folder);
+  tabs::TabInterface* const joiner = tabstrip()->GetTabAtIndex(3);
+
+  EXPECT_TRUE(tabstrip()->MoveTabsToFolder({3}, folder));
+  EXPECT_EQ(4, tabstrip()->count()) << "moving into a folder loses nothing";
+  EXPECT_EQ(3u, folder->TabCountRecursive());
+  EXPECT_EQ(folder, joiner->GetParentCollection());
+  EXPECT_EQ(3, tabstrip()->GetIndexOfTab(joiner)) << "appended at the end";
+
+  // A tab already at the front of the strip joins too, and lands last.
+  tabs::TabInterface* const front = tabstrip()->GetTabAtIndex(0);
+  EXPECT_TRUE(tabstrip()->MoveTabsToFolder({0}, folder));
+  EXPECT_EQ(4u, folder->TabCountRecursive());
+  EXPECT_EQ(3, tabstrip()->GetIndexOfTab(front));
+
+  // Moving every tab of the outer folder into a folder nested inside it moves
+  // the tabs, one by one, and leaves a valid tree: the nested folder still
+  // sits inside the outer one, which now holds everything through it.
+  tabs::FolderTabCollection* const child =
+      tabstrip()->AddToNewFolder({tabstrip()->GetIndexOfTab(front)}, folder);
+  ASSERT_NE(nullptr, child);
+  EXPECT_TRUE(tabstrip()->MoveTabsToFolder({0, 1, 2, 3}, child));
+  EXPECT_EQ(4, tabstrip()->count());
+  EXPECT_EQ(4u, child->TabCountRecursive());
+  EXPECT_EQ(4u, folder->TabCountRecursive());
+  EXPECT_EQ(folder, child->GetParentCollection());
+
+  // Pinned tabs are the essentials row and never enter a folder.
+  tabs::TabInterface* const pinned = tabstrip()->GetTabAtIndex(1);
+  tabstrip()->SetTabPinned(1, true);
+  EXPECT_FALSE(tabstrip()->MoveTabsToFolder({0}, folder));
+  EXPECT_TRUE(pinned->IsPinned());
+  EXPECT_NE(folder, pinned->GetParentCollection());
+
+  tabstrip()->CloseAllTabs();
+}
