+// switcher X3 (BACKLOG S-350): a step that ends the run -- its other tab
+// closed while Ctrl is held -- takes the strip down. It stayed over the page
+// with the closed tab's cell until Ctrl was let go, and every Ctrl-Tab after
+// it left it so.
+IN_PROC_BROWSER_TEST_F(NumberBadgeTest, AStripWhoseRunEndedComesDown) {
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces());
+  Run(IDC_STEDDING_SPACE_2);
+  ASSERT_NO_FATAL_FAILURE(ExpectShowing(ids_[1]));
+  std::vector<tabs::TabInterface*> two;
+  for (int i = 0; i < tab_strip_model()->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(i);
+    if (model()->SpaceForTab(tab) == ids_[1]) {
+      two.push_back(tab);
+    }
+  }
+  ASSERT_EQ(2u, two.size());
+  // Both used, two[1] last.
+  for (tabs::TabInterface* const tab : two) {
+    tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(tab));
+  }
+  const auto generator = [&]() {
+    auto events = std::make_unique<ui::test::EventGenerator>(
+        views::GetRootWindow(widget()), widget()->GetNativeWindow());
+#if BUILDFLAG(IS_MAC)
+    events->set_target(ui::test::EventGenerator::Target::APPLICATION);
+#else
+    widget()->Activate();
+    browser_view()->GetFocusManager()->ClearFocus();
+#endif
+    return events;
+  };
+  const auto strip_up = [&]() -> bool {
+    for (views::View* const child : browser_view()->children()) {
+      if (std::string_view(child->GetClassName()) ==
+              "RecentTabsSwitcherView" &&
+          child->GetVisible()) {
+        return true;
+      }
+    }
+    return false;
+  };
+
+  generator()->PressKey(ui::VKEY_CONTROL, ui::EF_CONTROL_DOWN);
+  base::RunLoop().RunUntilIdle();
+  Run(IDC_CYCLE_TO_NEXT_TAB);
+  EXPECT_EQ(two[0], tab_strip_model()->GetActiveTab());
+  ASSERT_TRUE(base::test::RunUntil(strip_up)) << "holding Ctrl showed no strip";
+  tab_strip_model()->CloseWebContentsAt(
+      tab_strip_model()->GetIndexOfTab(two[1]),
+      TabCloseTypes::CLOSE_USER_GESTURE);
+  Run(IDC_CYCLE_TO_NEXT_TAB);
+  EXPECT_FALSE(model()->in_cycle());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !strip_up(); }))
+      << "the strip stayed up after its run ended";
+  generator()->ReleaseKey(ui::VKEY_CONTROL, ui::EF_NONE);
+  base::RunLoop().RunUntilIdle();
+}
