+TEST_F(AddressRowTest, TheHeldPageDecidesTheLocalhostException) {
+  tabs::VerticalTabStripStateController* const state = controller();
+  ASSERT_TRUE(state);
+  AddressRow* const row = AddressRow::From(browser());
+  ASSERT_TRUE(row);
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  AddTab(browser(), GURL("https://example.com/"));
+  content::WebContents* const plain = tabs->GetActiveWebContents();
+  AddTab(browser(), GURL("http://localhost:8000/"));
+  content::WebContents* const local = tabs->GetActiveWebContents();
+  ASSERT_NE(plain, local);
+  state->RequestCollapse(true);
+  ASSERT_TRUE(state->IsCollapsed());
+  ASSERT_TRUE(row->IsVisible()) << "a localhost page keeps the row";
