+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/web_applications/os_integration/mac/apps_folder_support.h"
+
+#include "base/files/file_path.h"
+#include "chrome/browser/shell_integration.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace web_app {
+namespace {
+
+// Stedding web apps Wa7: an app's launcher goes into a folder of Stedding's
+// own in ~/Applications, not the "Chromium Apps.localized" every unbranded
+// build shares with a real Chromium. The Finder shows it by the folder's own
+// strings, which map the name without ".localized" to Stedding's.
+TEST(AppsFolderTest, TheFolderIsSteddingsOwn) {
+  const base::FilePath name = GetLocalizableAppShortcutsSubdirNameForTesting();
+  EXPECT_EQ("Stedding Apps.localized", name.value());
+  EXPECT_EQ(".localized", name.Extension());
+  EXPECT_EQ("Stedding Apps", name.RemoveExtension().value());
+  EXPECT_EQ(u"Stedding Apps", shell_integration::GetAppShortcutsSubdirName());
+}
+
+}  // namespace
