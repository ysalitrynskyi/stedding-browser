+void SidebarSyncService::TestPlace(const base::DictValue& form,
+                                   PreviewCallback done) {
+  pending_join_.reset();
+  ForgetPendingPlace();
+  own_file_stayed_ = false;
+  backup_failed_ = false;
+  // Sf43: one place at a time; Stop syncing comes first.
+  if (enabled()) {
+    std::move(done).Run(FailureAnswer("inUse"));
+    return;
+  }
+  // A test still running is not doubled, and the last place's own file is
+  // gone, or known to have stayed, before another mirror starts.
+  if (pending_place_ || leaving_bridge_) {
+    std::move(done).Run(FailureAnswer("busy"));
+    return;
+  }
+  sidebar_sync::PlaceForm checked = sidebar_sync::CheckPlaceForm(form);
+  if (!checked.place || !checked.sign_in) {
+    std::move(done).Run(FailureAnswer("form"));
+    return;
+  }
+  pending_place_ =
+      MakePendingPlace(std::move(*checked.place), std::move(*checked.sign_in));
+  pending_place_->check = std::make_unique<sidebar_sync::PlaceCheck>(
+      pending_place_->client.get(),
+      base::BindOnce(
+          [](base::WeakPtr<SidebarSyncService> service, PreviewCallback done,
+             sidebar_sync::PlaceCheck::Result result) {
+            if (!service) {
+              return;
+            }
+            service->pending_place_->made_folder = result.made_folder;
+            service->OnPlaceChecked(std::move(done), CheckAnswer(result));
+          },
+          weak_factory_.GetWeakPtr(), std::move(done)));
+  pending_place_->check->Start();
+}
+
+void SidebarSyncService::OnPlaceChecked(PreviewCallback done,
+                                        base::DictValue failure) {
+  const bool cancelled = pending_place_->cancelled;
+  // The check is on the stack that called here, and touches nothing more.
+  pending_place_->check.reset();
+  if (cancelled || !failure.empty()) {
+    ForgetPendingPlace();
+    std::move(done).Run(cancelled ? FailureAnswer("cancelled")
+                                  : std::move(failure));
+    return;
+  }
+  g_browser_process->os_crypt_async()->GetInstance(
+      base::BindOnce(&SidebarSyncService::OnEncryptorToJoin,
+                     weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void SidebarSyncService::OnEncryptorToJoin(
+    PreviewCallback done,
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  if (!pending_place_) {
+    std::move(done).Run(FailureAnswer("cancelled"));
+    return;
+  }
+  // Sf55: encrypted with the system's key store, or not kept at all.
+  std::string sealed;
+  if (!encryptor->IsEncryptionAvailable() ||
+      !encryptor->EncryptString(
+          sidebar_sync::SignInToText(pending_place_->sign_in), &sealed)) {
+    ForgetPendingPlace();
+    std::move(done).Run(FailureAnswer("keyStore"));
+    return;
+  }
+  pending_place_->sealed = base::Base64Encode(sealed);
+  write_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&sidebar_sync::PlaceBridge::ResetMirror,
+                     profile_->GetPath(), /*make=*/true),
+      base::BindOnce(&SidebarSyncService::OnMirrorReset,
+                     weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void SidebarSyncService::OnMirrorReset(PreviewCallback done, bool reset) {
+  if (!pending_place_) {
+    std::move(done).Run(FailureAnswer("cancelled"));
+    return;
+  }
+  if (!reset) {
+    ForgetPendingPlace();
+    std::move(done).Run(FailureAnswer(sidebar_sync::PlaceFailureName(
+        sidebar_sync::PlaceFailure::kServerError)));
+    return;
+  }
+  PrefService* const prefs = profile_->GetPrefs();
+  if (!sidebar_sync::IsInstallId(
+          prefs->GetString(stedding::prefs::kSidebarSyncInstallId))) {
+    prefs->SetString(stedding::prefs::kSidebarSyncInstallId,
+                     sidebar_sync::MakeInstallId());
+  }
+  pending_place_->bridge = std::make_unique<sidebar_sync::PlaceBridge>(
+      pending_place_->place, PlaceFactory(), clock_, profile_->GetPath(),
+      write_runner_);
+  pending_place_->bridge->SetSignIn(pending_place_->sign_in);
+  // Sf49: the join is a folder's, read from the mirror.
+  pending_place_->bridge->Pull(
+      prefs->GetString(stedding::prefs::kSidebarSyncInstallId),
+      base::BindOnce(&SidebarSyncService::OnPlacePulledForJoin,
+                     weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void SidebarSyncService::OnPlacePulledForJoin(
+    PreviewCallback done,
+    sidebar_sync::PlaceFailure failure) {
+  if (!pending_place_) {
+    std::move(done).Run(FailureAnswer("cancelled"));
+    return;
+  }
+  if (failure != sidebar_sync::PlaceFailure::kNone) {
+    ForgetPendingPlace();
+    std::move(done).Run(FailureAnswer(sidebar_sync::PlaceFailureName(failure)));
+    return;
+  }
+  PreviewJoinAt(sidebar_sync::PlaceBridge::MirrorFor(profile_->GetPath()),
+                base::BindOnce(&SidebarSyncService::OnPlacePreview,
+                               weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void SidebarSyncService::OnPlacePreview(PreviewCallback done,
+                                        base::DictValue preview) {
+  if (!pending_place_) {
+    pending_join_.reset();
+    std::move(done).Run(FailureAnswer("cancelled"));
+    return;
+  }
+  // Sf49: the sheet names the place, not the mirror.
+  preview.Set("dir", pending_place_->place.Label());
+  preview.Set("place", sidebar_sync::PlaceKindName(pending_place_->place.kind));
+  std::move(done).Run(std::move(preview));
+}
+
+void SidebarSyncService::ChangeSignIn(const base::DictValue& form,
+                                      PreviewCallback done) {
+  if (!bridge_) {
+    std::move(done).Run(FailureAnswer("form"));
+    return;
+  }
+  if (new_sign_in_) {
+    std::move(done).Run(FailureAnswer("busy"));
+    return;
+  }
+  sidebar_sync::PlaceForm checked =
+      sidebar_sync::CheckSignInForm(bridge_->place().kind, form);
+  if (!checked.sign_in) {
+    std::move(done).Run(FailureAnswer("form"));
+    return;
+  }
+  // Sf53: the same place; there is no field for another.
+  new_sign_in_ =
+      MakePendingPlace(bridge_->place(), std::move(*checked.sign_in));
+  new_sign_in_->check = std::make_unique<sidebar_sync::PlaceCheck>(
+      new_sign_in_->client.get(),
+      base::BindOnce(
+          [](base::WeakPtr<SidebarSyncService> service, PreviewCallback done,
+             sidebar_sync::PlaceCheck::Result result) {
+            if (service) {
+              service->OnNewSignInChecked(std::move(done), CheckAnswer(result));
+            }
+          },
+          place_weak_factory_.GetWeakPtr(), std::move(done)));
+  new_sign_in_->check->Start();
+}
+
+bool SidebarSyncService::NewSignInStillWanted() const {
+  return bridge_ && new_sign_in_ && !new_sign_in_->cancelled &&
+         bridge_->place().Label() == new_sign_in_->place.Label();
+}
+
+void SidebarSyncService::OnNewSignInChecked(PreviewCallback done,
+                                            base::DictValue failure) {
+  const bool wanted = NewSignInStillWanted();
+  if (!wanted || !failure.empty()) {
+    new_sign_in_->check.reset();
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+        FROM_HERE, std::move(new_sign_in_));
+    std::move(done).Run(wanted ? std::move(failure)
+                               : FailureAnswer("cancelled"));
+    return;
+  }
+  g_browser_process->os_crypt_async()->GetInstance(
+      base::BindOnce(&SidebarSyncService::OnEncryptorToChange,
+                     place_weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void SidebarSyncService::OnEncryptorToChange(
+    PreviewCallback done,
+    scoped_refptr<os_crypt_async::Encryptor> encryptor) {
+  const bool wanted = NewSignInStillWanted();
+  std::unique_ptr<PendingPlace> changed = std::move(new_sign_in_);
+  std::string sealed;
+  if (!wanted) {
+    std::move(done).Run(FailureAnswer("cancelled"));
+    return;
+  }
+  if (!encryptor->IsEncryptionAvailable() ||
+      !encryptor->EncryptString(sidebar_sync::SignInToText(changed->sign_in),
+                                &sealed)) {
+    std::move(done).Run(FailureAnswer("keyStore"));
+    return;
+  }
+  profile_->GetPrefs()->SetString(stedding::prefs::kSidebarSyncPlaceSignIn,
+                                  base::Base64Encode(sealed));
+  bridge_->SetSignIn(std::move(changed->sign_in));
+  sign_in_lost_ = false;
+  SyncNow();
+  NotifyObservers();
+  std::move(done).Run(base::DictValue());
