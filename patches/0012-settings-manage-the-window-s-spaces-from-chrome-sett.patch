+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_SPACES_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_SPACES_HANDLER_H_
+
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+// Space management for chrome://settings/stedding: lists the Spaces of the
+// window the settings tab is in, renames and deletes them, and pushes a fresh
+// list whenever the sidebar changes one (docs/features/settings.md T9).
+class SteddingSpacesHandler : public settings::SettingsPageUIHandler,
+                              public spaces::SpaceModel::Observer {
+ public:
+  SteddingSpacesHandler();
+  SteddingSpacesHandler(const SteddingSpacesHandler&) = delete;
+  SteddingSpacesHandler& operator=(const SteddingSpacesHandler&) = delete;
+  ~SteddingSpacesHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // spaces::SpaceModel::Observer:
+  void OnSpaceAdded(const spaces::SpaceId& id) override;
+  void OnSpaceRemoved(const spaces::SpaceId& id) override;
+  void OnActiveSpaceChanged(const spaces::SpaceId& from,
+                            const spaces::SpaceId& to) override;
+  void OnSpaceMetadataChanged(const spaces::SpaceId& id) override;
+
+ private:
+  // The Space model of the window this settings page lives in, or null for a
+  // page hosted somewhere without Spaces (a popup, a detached tab).
+  spaces::SpaceModel* GetModel();
+
+  base::ListValue ListSpaces();
+  void PushSpaces();
+
+  void HandleGetSpaces(const base::ListValue& args);
+  void HandleRenameSpace(const base::ListValue& args);
+  void HandleDeleteSpace(const base::ListValue& args);
+
+  base::ScopedObservation<spaces::SpaceModel, spaces::SpaceModel::Observer>
+      observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_SPACES_HANDLER_H_
