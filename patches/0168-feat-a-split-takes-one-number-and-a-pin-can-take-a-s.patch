+// splits J2, tabs R10, R19: a split is one row and takes one number, which
+// goes to the pane used last. Each pane took a number of its own, so the rows
+// under a split were numbered one too high.
+TEST_F(TabNumbersTest, ASplitTakesOneNumber) {
+  AddTab(browser(), GURL("https://example.com/a"));
+  tabs::TabInterface* const after = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://example.com/b"));
+  tabs::TabInterface* const left = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://example.com/c"));
+  tabs::TabInterface* const right = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://example.com/d"));
+  tabs::TabInterface* const other = tabs().GetActiveTab();
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(right));
+  tabs().AddToNewSplit({tabs().GetIndexOfTab(left)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_TRUE(right->IsSplit());
+
+  const std::vector<tabs::TabInterface*> numbered = NumberedTabs(&tabs());
+  ASSERT_EQ(3u, numbered.size()) << "each pane took a number of its own";
+  EXPECT_NE(numbered.end(), std::ranges::find(numbered, after));
+  EXPECT_NE(numbered.end(), std::ranges::find(numbered, other));
+
+  // The key goes to the pane used last, whichever pane shows the number.
+  const auto split_key = static_cast<int>(
+      std::ranges::find_if(numbered, [](tabs::TabInterface* tab) {
+        return tab->IsSplit();
+      }) -
+      numbered.begin());
+  for (tabs::TabInterface* const pane : {left, right}) {
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(pane));
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(other));
+    chrome::SelectNumberedTab(browser(), split_key);
+    EXPECT_EQ(pane, tabs().GetActiveTab());
+  }
+}
