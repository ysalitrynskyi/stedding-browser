+++ b/chrome/browser/ui/stedding/find_words.h
@@ -0,0 +1,40 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_FIND_WORDS_H_
+#define CHROME_BROWSER_UI_STEDDING_FIND_WORDS_H_
+
+#include <string_view>
+
+#include "base/containers/span.h"
+
+namespace stedding {
+
+// A place in Settings and the words that find it there and in the command bar
+// (docs/features/settings.md T58, commandbar.md K39; BACKLOG S-422). The words
+// are what a person who comes from another browser types. They are search
+// terms and nothing else: no label, heading or feature takes one.
+struct FindWords {
+  // The command bar's row, under Stedding's own name for the place.
+  std::u16string_view title;
+  // The card of chrome://settings/stedding?card=<card> the place is on.
+  std::string_view card;
+  // The string the settings page's rows read their search hint from.
+  std::string_view hint_id;
+  // The words, each found from its start in the bar, and anywhere, as a
+  // phrase, in Settings' search box.
+  std::u16string_view words;
+  // Whether the row's title finds it too. Off for a place the bar has a row
+  // for already, a preference's, which its title would only repeat.
+  bool title_finds = false;
+};
+
+// Every place, in the order the command bar lists them. Keep it small: a word
+// goes in when a person looking for that place would type it. Pure data, so it
+// can be tested with no window.
+base::span<const FindWords> FindWordsTable();
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_FIND_WORDS_H_
