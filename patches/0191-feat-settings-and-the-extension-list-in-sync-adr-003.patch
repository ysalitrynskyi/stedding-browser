+// Sf9, Sf33 (bug hunt 2026-11-16): this computer's name is cut to what a file
+// holds between two characters, at the join and when it is changed. Cut
+// inside a character, it went into the file with U+FFFD in its place, past
+// the cap, and every computer refused this computer's file, its own read of
+// the folder included. Settings' name fields take no more than always fits.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, ALongNameIsCutBetweenCharacters) {
+  // 86 characters of three bytes, 258 bytes: 85 of them fit.
+  std::string joined;
+  for (int i = 0; i < 86; ++i) {
+    joined += "\xE6\x9B\xB8";
+  }
+  const base::DictValue preview = Preview(shared_.GetPath());
+  ASSERT_FALSE(preview.FindString("refusal"));
+  ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/false, joined, {}));
+  ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    const sb::ParsedFile own = ReadOwnFile();
+    return own.status == sb::ParseStatus::kOk &&
+           own.meta.device == joined.substr(0, 85 * 3);
+  })) << "the name given at the join made a file no computer reads";
+
+  // Five bytes and 63 characters of four, 257 bytes: 62 of them fit.
+  std::string renamed = "Desk ";
+  for (int i = 0; i < 63; ++i) {
+    renamed += "\xF0\x9F\x93\x9A";
+  }
+  const std::string kept = renamed.substr(0, 5 + 62 * 4);
+  service()->SetDeviceName(renamed);
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    const sb::ParsedFile own = ReadOwnFile();
+    return own.status == sb::ParseStatus::kOk && own.meta.device == kept;
+  })) << "the new name made a file no computer reads";
+  const base::DictValue status = service()->GetStatus();
+  ASSERT_TRUE(status.FindString("device"));
+  EXPECT_EQ(kept, *status.FindString("device"));
+
+  // The two name fields, under the sync row and on the join sheet.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  constexpr char kLimits[] = R"(
+    (async () => {
+      const deep = (root, selector) => {
+        const found = root.querySelector(selector);
+        if (found) {
+          return found;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          const inner =
+              element.shadowRoot && deep(element.shadowRoot, selector);
+          if (inner) {
+            return inner;
+          }
+        }
+        return null;
+      };
+      for (let i = 0; i < 200; ++i) {
+        const section = deep(document, 'settings-stedding-sync-section');
+        const field =
+            section && section.shadowRoot.querySelector('#syncDevice');
+        if (field) {
+          const sheet = section.shadowRoot.querySelector('#joinDevice');
+          return [field.maxlength, sheet && sheet.maxlength].join(' ');
+        }
+        await new Promise(done => setTimeout(done, 25));
+      }
+      return 'no name field';
+    })()
+  )";
+  EXPECT_EQ("85 85", content::EvalJs(tabs().GetActiveWebContents(), kLimits));
+}
