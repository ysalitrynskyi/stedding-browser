+// windows G13: what changed in a window is sent: a record changed there, a
+// record made there, and the order of a run whose order changed there. A
+// run whose order did not change sends none.
+TEST_F(PinStoreTest, OnlyWhatChangedInTheWindowIsSent) {
+  const SpaceId work = NewSpace();
+  const SpaceId play = NewSpace();
