+bool IsSpaceContextMenuCommand(int command_id) {
+  const int move_first =
+      static_cast<int>(TabStripModel::CommandSteddingMoveToSpaceFirst);
+  const int move_last =
+      static_cast<int>(TabStripModel::CommandSteddingMoveToSpaceLast);
+  const int route_first =
+      static_cast<int>(TabStripModel::CommandSteddingRouteToSpaceFirst);
+  const int route_last =
+      static_cast<int>(TabStripModel::CommandSteddingRouteToSpaceLast);
+  return (command_id >= move_first && command_id <= move_last) ||
+         (command_id >= route_first && command_id <= route_last);
+}
+
+bool IsSpaceContextMenuCommandEnabled(const SpaceModel* model,
+                                     const TabStripModel* tabs,
+                                     int index,
+                                     int command_id) {
+  if (!IsSpaceContextMenuCommand(command_id) || !model || !tabs ||
+      !tabs->ContainsIndex(index)) {
+    return false;
+  }
+  tabs::TabInterface* const tab = tabs->GetTabAtIndex(index);
+  return tab && !tab->IsPinned();
+}
+
+void ExecuteSpaceContextMenuCommand(SpaceModel* model,
+                                    const TabStripModel* tabs,
+                                    int index,
+                                    int command_id) {
+  if (!IsSpaceContextMenuCommandEnabled(model, tabs, index, command_id)) {
+    return;
+  }
+  const int route_first =
+      static_cast<int>(TabStripModel::CommandSteddingRouteToSpaceFirst);
+  const int route_last =
+      static_cast<int>(TabStripModel::CommandSteddingRouteToSpaceLast);
+  if (command_id >= route_first && command_id <= route_last) {
+    const size_t which = command_id - route_first;
+    if (which >= model->size()) {
+      return;
+    }
+    const SpaceId target = model->spaces()[which]->id();
+    for (tabs::TabInterface* each : tabs->GetTabsForContextMenuCommand(index)) {
+      content::WebContents* const contents = each->GetContents();
+      if (each->IsPinned() || !contents) {
+        continue;
+      }
+      const GURL url = contents->GetLastCommittedURL();
+      if (!url.SchemeIsHTTPOrHTTPS()) {
+        continue;
+      }
+      BrowserWindowInterface* const browser = each->GetBrowserWindowInterface();
+      if (!browser || !browser->GetProfile()) {
+        continue;
+      }
+      AddRoute(browser->GetProfile()->GetPrefs(),
+               SiteRouteFor(url, target.ToString()));
+      model->RouteTab(each, url, /*foreground=*/true, /*external=*/false);
+    }
+    return;
+  }
+  std::vector<SpaceId> others;
+  for (const std::unique_ptr<Space>& space : model->spaces()) {
+    if (space->id() != model->active_id()) {
+      others.push_back(space->id());
+    }
+  }
+  const size_t which =
+      command_id -
+      static_cast<int>(TabStripModel::CommandSteddingMoveToSpaceFirst);
+  if (which >= others.size()) {
+    return;
+  }
+  for (tabs::TabInterface* each : tabs->GetTabsForContextMenuCommand(index)) {
+    if (!each->IsPinned()) {
+      model->SetSpaceForTab(each, others[which]);
+    }
   }
+  model->SetActiveSpace(others[which]);
 }
 
 }  // namespace spaces
