+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/layout/stedding_browser_view_layout.h"
+
+#include <utility>
+
+#include "base/i18n/rtl.h"
+
+#include "chrome/browser/ui/views/frame/multi_contents_view.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+
+namespace stedding {
+
+BASE_FEATURE(kArcStyleWindow, "SteddingArcStyleWindow",
+             base::FEATURE_ENABLED_BY_DEFAULT);
+
+}  // namespace stedding
+
+SteddingBrowserViewLayout::SteddingBrowserViewLayout(
+    std::unique_ptr<BrowserViewLayoutDelegate> delegate,
+    BrowserViewLayoutViews views)
+    : BrowserViewTabbedLayoutImpl(std::move(delegate), std::move(views)) {}
+
+SteddingBrowserViewLayout::~SteddingBrowserViewLayout() = default;
+
+void SteddingBrowserViewLayout::DoPostLayoutVisualAdjustments(
+    const BrowserLayoutParams& params) {
+  BrowserViewTabbedLayoutImpl::DoPostLayoutVisualAdjustments(params);
+
+  MultiContentsView* const contents = views().multi_contents_view;
+  if (!contents) {
+    return;
+  }
+
+  // Upstream only rounds the contents in glass mode, and only the corner at the
+  // bottom of the tab strip. Arc rounds the corner where the toolbar meets the
+  // tab strip instead, so add that corner and keep whatever upstream chose for
+  // the rest -- in split view and under a side panel those radii go with an
+  // inset that has already pulled the contents off the window edge.
+  gfx::RoundedCornersF radii = contents->GetBackgroundRadii();
+  if (base::i18n::IsRTL()) {
+    radii.set_upper_right(stedding::kContentsCornerRadius);
+  } else {
+    radii.set_upper_left(stedding::kContentsCornerRadius);
+  }
+  contents->SetBackgroundRadii(radii);
+}
diff --git a/chrome/browser/ui/views/frame/layout/stedding_browser_view_layout.h b/chrome/browser/ui/views/frame/layout/stedding_browser_view_layout.h
