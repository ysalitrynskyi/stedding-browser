+// pins H14 (GitHub issue 41): with no loose tab in the Space, a pin dragged
+// down past the run's end leaves it and is a tab under the line: dropped on
+// the New Tab row's upper half, its lower half, or the room under the list.
+// There was no line to cross, and the pin stayed in the run.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, APinLeavesTheRunWithNoTabUnderIt) {
+  tabs::TabInterface* const a = tabs().GetActiveTab();
+  model().SetSpacePinned(a, true);
+  tabs::TabInterface* const b = AddBlankTab();
+  stedding::test::KeepAboveOtherWindows(widget());
+
+  // Where to drop `b`'s row, from the New Tab row's bounds.
+  const struct {
+    const char* where;
+    int (*y)(const gfx::Rect& new_tab_row);
+  } kDrops[] = {
+      {"the New Tab row's upper half",
+       [](const gfx::Rect& r) { return r.y() + r.height() / 4; }},
+      {"the New Tab row's lower half",
+       [](const gfx::Rect& r) { return r.y() + r.height() * 3 / 4; }},
+      {"the room under the list",
+       [](const gfx::Rect& r) { return r.bottom() + r.height() * 2; }},
+  };
+  for (const auto& drop : kDrops) {
+    SCOPED_TRACE(drop.where);
+    model().SetSpacePinned(b, true);
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    const TabView* const row =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), b);
+    ASSERT_TRUE(row);
+    const auto* const list =
+        views::AsViewClass<UnpinnedTabContainerView>(row->parent());
+    ASSERT_TRUE(list);
+    const views::View* const new_tab_row =
+        list->space_boundary_new_tab_row();
+    ASSERT_TRUE(new_tab_row && new_tab_row->GetVisible());
+    // With no loose tab there is no Clear line: the run ends at the New Tab
+    // row.
+    ASSERT_FALSE(ClearLineShown());
+    const gfx::Rect under = new_tab_row->GetBoundsInScreen();
+    ASSERT_LE(row->GetBoundsInScreen().bottom(), under.y());
+
+    const gfx::Point from = row->GetBoundsInScreen().CenterPoint();
+    const gfx::Point to(from.x(), drop.y(under));
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed,
+                                  from);
+    constexpr int kSteps = 20;
+    for (int i = 1; i <= kSteps; ++i) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                     from.y() + (to.y() - from.y()) * i / kSteps));
+      EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    }
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, to);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_TRUE(model().IsSpacePinned(a));
+    EXPECT_FALSE(model().IsSpacePinned(b)) << "the pin stayed in the run";
+    EXPECT_FALSE(IsAboveTheLine(b));
+  }
+}
