+// Z15: an extension's chord, in a profile open on this machine, is found
+// with the extension's name, and the block refuses it.
+IN_PROC_BROWSER_TEST_F(ShortcutRebindTest, AnExtensionsChordIsRefused) {
+  extensions::TestExtensionDir dir;
+  dir.WriteManifest(R"({
+    "manifest_version": 3,
+    "name": "Notes Keeper",
+    "version": "1",
+    "commands": {
+      "open-notes": {
+        "suggested_key": {"default": "Ctrl+Shift+Y"},
+        "description": "Open the notes"
+      }
+    }
+  })");
+  const scoped_refptr<const extensions::Extension> extension =
+      extensions::ChromeTestExtensionLoader(browser()->GetProfile())
+          .LoadExtension(dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  // "Ctrl" in a manifest is ⌘ on the Mac.
+  const shortcuts::Chord chord(
+      ui::VKEY_Y, ui::EF_PLATFORM_ACCELERATOR | ui::EF_SHIFT_DOWN);
+  EXPECT_EQ(u"Notes Keeper", stedding::ExtensionHoldingChord(chord));
+  shortcuts::OutsideHolders outside;
+  outside.extension = stedding::ExtensionHoldingChord(chord);
+  EXPECT_EQ(shortcuts::CheckKind::kRefused,
+            shortcuts::CheckShortcut(LocalState(), Row("clear-space"), chord,
+                                     outside)
+                .kind);
+}
