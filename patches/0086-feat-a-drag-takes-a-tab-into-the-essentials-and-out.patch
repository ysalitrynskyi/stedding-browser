+// pins H27 (BACKLOG S-277, GitHub issue 16): as in Arc, a tab's row dragged
+// onto the essentials becomes an essential, before the card it is dropped on;
+// an essential dragged into the list leaves the essentials for the place the
+// bar shows, under the Clear line a tab, over it a pin of the Space. Only the
+// tab's menu did either.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ADragTakesATabIntoTheEssentialsAndOut) {
+  tabs::TabInterface* const essential = tabs().GetActiveTab();
+  tabs::TabInterface* const pin = AddBlankTab();
+  model().SetSpacePinned(pin, true);
+  tabs::TabInterface* const loose = AddBlankTab();
+  tabs::TabInterface* const tail = AddBlankTab();
+  tabs::TabInterface* const last = AddBlankTab();
+  tabs().SetTabPinned(tabs().GetIndexOfTab(essential), true);
+  ASSERT_TRUE(essential->IsPinned());
+  ASSERT_TRUE(IsAboveTheLine(pin));
+  ASSERT_FALSE(IsAboveTheLine(loose));
+  stedding::test::KeepAboveOtherWindows(widget());
+
+  // A press on `tab`'s row or card and a drag in steps to `to`, the window
+  // laying out between two, then the release there.
+  const auto drag_to = [&](const tabs::TabInterface* tab,
+                           const gfx::Point& to) {
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    const TabView* const row =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+    ASSERT_TRUE(row) << "the sidebar shows no row for the tab";
+    const gfx::Point from = row->GetBoundsInScreen().CenterPoint();
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, from);
+    constexpr int kSteps = 20;
+    for (int i = 1; i <= kSteps; ++i) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                     from.y() + (to.y() - from.y()) * i / kSteps));
+      EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    }
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, to);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  };
+  const auto card_centre = [&](const tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    const TabView* const card =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+    EXPECT_TRUE(card) << "no card for the essential";
+    return card ? card->GetBoundsInScreen().CenterPoint() : gfx::Point();
+  };
+
+  {
+    SCOPED_TRACE("a tab dropped on an essential's card");
+    ASSERT_NO_FATAL_FAILURE(drag_to(loose, card_centre(essential)));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return loose->IsPinned(); }))
+        << "the tab did not become an essential";
+    EXPECT_FALSE(model().IsSpacePinned(loose));
+    EXPECT_EQ(Index(loose) + 1, Index(essential))
+        << "not before the card it was dropped on";
+    EXPECT_TRUE(IsAboveTheLine(pin)) << "the pin left the run";
+  }
+  {
+    SCOPED_TRACE("an essential dropped under the line");
+    ASSERT_NO_FATAL_FAILURE(drag_to(loose, JustInsideTheTopOf(last)));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !loose->IsPinned(); }))
