+        GURL(std::string(url::kViewSourceScheme) + ":" + page.spec()),
+        GURL(url::kAboutBlankURL)}) {
+    SCOPED_TRACE(elsewhere.spec());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page));
+    EXPECT_TRUE(WaitForButton(browser(), true)) << "no button on a web page";
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), elsewhere));
+    EXPECT_TRUE(WaitForButton(browser(), false)) << "a button on this page";
+  }
+}
+
+// copy-link L7, settings T28: "Show the Copy Link button" off hides it in
+// every window at once, and ⇧⌘C still copies; on, it is back.
+IN_PROC_BROWSER_TEST_F(CopyLinkTest, TheSettingHidesTheButton) {
+  const GURL page = embedded_test_server()->GetURL("a.test", "/title1.html");
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  for (BrowserWindowInterface* const window : {browser(), second}) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(window, page));
+    ASSERT_TRUE(WaitForButton(window, true));
+  }
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_TRUE(prefs->GetBoolean(stedding::prefs::kCopyLinkButton))
+      << "the button is on by default";
+  prefs->SetBoolean(stedding::prefs::kCopyLinkButton, false);
+  EXPECT_TRUE(WaitForButton(browser(), false));
+  EXPECT_TRUE(WaitForButton(second, false));
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_COPY_URL));
+  EXPECT_EQ(base::UTF8ToUTF16(page.spec()), ClipboardText());
+  prefs->SetBoolean(stedding::prefs::kCopyLinkButton, true);
+  EXPECT_TRUE(WaitForButton(browser(), true));
+  EXPECT_TRUE(WaitForButton(second, true));
+}
+
+// copy-link L7, L3: a private window has the button too, and its copy is
+// marked off the record, so the clipboard history keeps none of it; a
+// normal window's copy is not marked.
+IN_PROC_BROWSER_TEST_F(CopyLinkTest, APrivateWindowsButtonCopiesOffTheRecord) {
+  const GURL page = embedded_test_server()->GetURL("p.test", "/title1.html");
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(incognito, page));
+  ASSERT_TRUE(WaitForButton(incognito, true))
+      << "no Copy Link button in a private window";
+  Click(ButtonOf(incognito), ui::EF_NONE);
+  EXPECT_EQ(base::UTF8ToUTF16(page.spec()), ClipboardText());
+  EXPECT_TRUE(clipboard()->last_write_off_the_record());
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page));
+  ASSERT_TRUE(WaitForButton(browser(), true));
+  Click(ButtonOf(browser()), ui::EF_NONE);
+  EXPECT_EQ(base::UTF8ToUTF16(page.spec()), ClipboardText());
+  EXPECT_FALSE(clipboard()->last_write_off_the_record());
+}
