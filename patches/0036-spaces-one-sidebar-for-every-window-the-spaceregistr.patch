+  other->AddSpace("Mine", SK_ColorRED);
+  EXPECT_EQ(2u, other->size());
+  EXPECT_EQ(2u, model().size()) << "nothing reaches the registry";
+  blank->tab_strip_model()->CloseAllTabs();
+}
