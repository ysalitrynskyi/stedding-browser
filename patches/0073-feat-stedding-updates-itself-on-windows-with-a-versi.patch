+namespace stedding {
+
+class AppUpdater;
+
+// What the Windows updater takes from the machine, so a test can stand in for
+// it (updates Up14-Up17). StartAppUpdater fills it from the installed copy.
+struct WinUpdaterEnvironment {
+  WinUpdaterEnvironment();
+  WinUpdaterEnvironment(WinUpdaterEnvironment&&);
+  WinUpdaterEnvironment& operator=(WinUpdaterEnvironment&&);
+  ~WinUpdaterEnvironment();
+
+  // The Ed25519 public key, base64, the feed and the installer must verify
+  // with.
+  std::string public_key;
+  GURL feed_url;
+  // The version running.
+  base::Version running;
+  // Where chrome.exe is: an installed update waiting for the restart leaves
+  // new_chrome.exe here.
+  base::FilePath exe_dir;
+  // The version the installer recorded last ("pv"), for the waiting update's
+  // name.
+  base::RepeatingCallback<base::Version()> installed_version;
+  // Runs the verified installer, off the UI thread; its exit code.
+  base::RepeatingCallback<int(const base::FilePath&)> run_installer;
+  // Whether the feed may list an installer on plain http to this computer:
+  // only a copy pointed at a test feed (--stedding-update-feed) allows it.
+  bool allow_local_http = false;
+};
+
+// Off the UI thread: runs `command`, an update installer, hidden, per user and
+// beside the running browser, telling it not to launch the browser and to log
+// next to itself. Waits until it has exited, however long that takes; its exit
+// code, or -1 when it did not start (updates Up17, BACKLOG S-343). The
+// browser's run_installer runs the downloaded installer through it.
+int RunUpdateInstaller(base::CommandLine command);
+
+// The updater, made with `environment`; it is AppUpdater::Get() while it
+// lives. For tests: the browser makes it through StartAppUpdater.
+std::unique_ptr<AppUpdater> CreateWinAppUpdater(
+    PrefService* local_state,
+    base::RepeatingClosure restart,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory,
+    WinUpdaterEnvironment environment);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_APP_UPDATER_WIN_H_
