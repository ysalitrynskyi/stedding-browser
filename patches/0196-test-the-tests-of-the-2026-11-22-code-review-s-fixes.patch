+// A profile's own Bookmarks file: one page on the bookmark bar.
+constexpr char kDeviceBookmarksB10[] = R"json({
+  "roots": {
+    "bookmark_bar": {"type": "folder", "name": "Bookmarks bar", "children": [
+      {"type": "url", "name": "Device", "url": "https://device.example/"}
+    ]}
