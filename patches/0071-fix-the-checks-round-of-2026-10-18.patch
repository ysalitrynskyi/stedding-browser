+                                            row->GetLocalBounds()),
+           title->GetVisible() && title->width() > 0});
+    }
+    return drawn;
+  };
+  // Two cards side by side on the first row, the third under them, each the
+  // same width and none with a title.
+  const auto expect_the_grid = [&]() {
+    const std::vector<Card> drawn = cards();
