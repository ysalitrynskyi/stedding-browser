+      slot = (slot + 1) % kSessionSlots;
+    }
+    if (id == session) {
+      return static_cast<int>(slot);
+    }
+    taken.set(slot);
+  }
+  // A session the registry does not know yet: the slot its id hashes to.
+  return static_cast<int>(base::PersistentHash(session) % kSessionSlots);
+}
+
+std::optional<int> SessionSlotForSpace(const SpaceRegistry* registry,
+                                       const SpaceId& id) {
+  const RegistryEntry* const entry = registry ? registry->Find(id) : nullptr;
+  if (!entry || !entry->isolated || entry->profile_id.empty()) {
+    return std::nullopt;
+  }
+  return SessionSlot(*registry, entry->profile_id);
 }
 
