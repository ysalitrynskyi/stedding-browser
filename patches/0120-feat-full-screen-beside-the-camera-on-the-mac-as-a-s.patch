+    bool any = false;
+    for (const NSWindowButton type :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      any = any || [[window standardWindowButton:type] isHidden];
+    }
+    return any;
+  };
+  const auto lights = [&] {
+    NSRect in_window = NSZeroRect;
+    for (const NSWindowButton type :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      NSButton* const button = [window standardWindowButton:type];
+      in_window = NSUnionRect(in_window,
+                              [button convertRect:button.bounds toView:nil]);
+    }
+    return gfx::ScreenRectFromNSRect([window convertRectToScreen:in_window]);
+  };
+  // A pointer move the window's monitor hears, at `point` in screen
+  // coordinates.
+  const auto pointer_at = [&](const gfx::Point& point) {
+    region->PlayWindowPointerForTesting(point, /*pressed=*/false);
+  };
+  sidebar->SetExpandOnHoverEnabled(false);
+  prefs->SetInteger(stedding::prefs::kSidebarClosedForm,
+                    stedding::prefs::kSidebarClosedHidden);
+  prefs->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  prefs->SetBoolean(stedding::prefs::kToolbarHideWithSidebar, true);
+  ASSERT_FALSE(sidebar->IsCollapsed());
+  settle();
+  const gfx::Rect window_bounds = browser_view->GetBoundsInScreen();
+  const gfx::Point on_page = window_bounds.CenterPoint();
+  pointer_at(on_page);
+  EXPECT_FALSE(hidden()) << "the open sidebar lies under the lights";
+
+  sidebar->RequestCollapse(true);
+  settle();
+  ASSERT_TRUE(sidebar->IsCollapsed());
+  ASSERT_FALSE(browser_view->IsToolbarVisible());
+  ASSERT_TRUE(lights().Intersects(
+      browser_view->contents_container()->GetBoundsInScreen()))
+      << "the page does not reach the lights";
+  EXPECT_TRUE(hidden()) << "the lights cover the page's top left corner";
+
+  // Under the lights, but not at the window's top: the page's own corner.
+  const gfx::Rect at = lights();
+  pointer_at(gfx::Point(at.CenterPoint().x(), at.bottom() + 2));
+  EXPECT_TRUE(hidden()) << "the page's own corner showed the lights";
+
+  // A rest at the window's top over them shows them, after the reveal's
+  // pause, and they stay while the pointer is on them.
+  pointer_at(gfx::Point(at.CenterPoint().x(), window_bounds.y() + 2));
+  EXPECT_TRUE(hidden()) << "shown before the pause";
+  EXPECT_TRUE(base::test::RunUntil([&] { return !hidden(); }))
+      << "a rest at the window's top did not show them";
+  pointer_at(at.CenterPoint());
+  EXPECT_FALSE(hidden()) << "the pointer on the lights hid them";
+  pointer_at(on_page);
+  EXPECT_TRUE(hidden()) << "the pointer left the lights and they stayed";
+
+  // A rest at the top elsewhere does nothing.
+  pointer_at(gfx::Point(on_page.x(), window_bounds.y() + 2));
+  base::RunLoop loop;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, loop.QuitClosure(), base::Milliseconds(300));
+  loop.Run();
+  EXPECT_TRUE(hidden()) << "a rest at the top's middle showed the lights";
+
+  // The row shown (Shift-Cmd-D) lies under them.
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW);
+  views::test::RunScheduledLayout(widget);
+  ASSERT_TRUE(browser_view->IsToolbarVisible());
+  pointer_at(on_page);
+  EXPECT_FALSE(hidden()) << "the row lies under the lights";
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW);
+  views::test::RunScheduledLayout(widget);
+  ASSERT_FALSE(browser_view->IsToolbarVisible());
+  EXPECT_TRUE(hidden());
+
+  // The sidebar slid in from the edge lies under them.
+  region->OnPointerAtForTesting(
+      gfx::Point(region->IsOnRight() ? browser_view->width() - 2 : 2,
+                 browser_view->height() / 2));
+  ASSERT_TRUE(region->is_expanded_on_hover());
+  EXPECT_FALSE(hidden()) << "the slid-in sidebar lies under the lights";
+  region->SetPointerForTesting(std::nullopt);
+
+  // Closed to the rail, the rail lies under them.
+  sidebar->RequestCollapse(false);
+  settle();
+  sidebar->RequestCollapse(true);
+  settle();
+  prefs->SetInteger(stedding::prefs::kSidebarClosedForm,
+                    stedding::prefs::kSidebarClosedToIcons);
+  settle();
+  pointer_at(on_page);
+  EXPECT_FALSE(hidden()) << "the rail lies under the lights";
+  prefs->SetInteger(stedding::prefs::kSidebarClosedForm,
+                    stedding::prefs::kSidebarClosedHidden);
+  settle();
+  pointer_at(on_page);
+  EXPECT_TRUE(hidden()) << "hidden again with the sidebar";
+
+  // Opened again, the sidebar lies under them.
+  sidebar->RequestCollapse(false);
+  settle();
+  pointer_at(on_page);
+  EXPECT_FALSE(hidden()) << "the lights stayed hidden over the open sidebar";
+}
