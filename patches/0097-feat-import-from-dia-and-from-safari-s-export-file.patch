+namespace stedding {
+
+// What the imports from another browser's files share (docs/features/
+// import.md I28-I42): Dia's (spaces::ImportChromiumFamilyAsync) and Safari's
+// export file's (SafariExportImporter). Bookmarks are merged into one folder
+// per source, history adds only visits the profile does not have, passwords
+// go through Chromium's own importer, which replaces nothing, and an import
+// keeps running when the page that started it goes away.
+
+// import I40: the import parts a policy turns off. A part is off when its
+// import policy is set to false, or when the profile may not hold that kind
+// of data at all (bookmark editing off, history saving off, the password
+// manager off), the checks Chromium's own importers make.
+struct ImportsAllowed {
+  bool bookmarks = true;
+  bool history = true;
+  bool passwords = true;
+};
+ImportsAllowed AllowedImports(const PrefService& prefs);
+
+// import I37, I40: what a bookmark merge did.
+struct BookmarkMergeResult {
+  // Bookmarks added.
+  size_t added = 0;
+  // Bookmarks already at their place in the source's folder, left alone.
+  size_t already_there = 0;
+};
+
+// import I29, I37, I40: merges `entries` into the source's own folder under
+// Other bookmarks, named `folder_title`, keeping each entry's folders. The
+// folder is the one an earlier import of `source_key` made, found by the
+// UUID stedding.import.bookmark_folders keeps for it, wherever the user has
+// moved it; one the user deleted is made again. An entry whose URL is already
+// at its place there is not added again. An entry marked as on the toolbar
+// goes into a `toolbar_title` folder inside it. Only web pages (http and
+// https) come in. Nothing becomes a pin, and stedding.bookmarks.converted is
+// not touched (I13, I14). `model` must be loaded.
+BookmarkMergeResult MergeImportedBookmarks(
+    bookmarks::BookmarkModel& model,
+    PrefService& prefs,
+    std::string_view source_key,
+    const std::u16string& folder_title,
+    const std::u16string& toolbar_title,
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& entries);
+
+// Runs `loaded` once `model` has loaded: at once when it has, or never when
+// the model goes away first. Destroying the waiter drops `loaded`.
+class BookmarksLoadedWaiter {
+ public:
+  BookmarksLoadedWaiter(bookmarks::BookmarkModel* model,
+                        base::OnceClosure loaded);
+  BookmarksLoadedWaiter(const BookmarksLoadedWaiter&) = delete;
+  BookmarksLoadedWaiter& operator=(const BookmarksLoadedWaiter&) = delete;
+  ~BookmarksLoadedWaiter();
+
+ private:
+  class Observer;
+  std::unique_ptr<Observer> observer_;
+};
+
+// import I30, I38: the oldest visit the history service keeps; an older one
+// would be dropped as expired.
+base::Time OldestKeptVisit(base::Time now);
+
+// import I22, I30, I38 (BACKLOG S-346): the latest visit an import keeps:
+// `now`, and a few minutes more for another machine's clock. A visit dated
+// later is no visit yet. Kept, it listed as the newest page, the history's
+// expiry, which looks only for visits too old, never dropped it, and a read
+// of the newest visits first took it ahead of every real one.
+base::Time LatestKeptVisit(base::Time now);
+
+// import I30, I38, I40: adds those of `rows` the profile's history does not
+// already hold a visit for, at that row's time, to that row's URL, as
+// `source`; `done` gets how many were added. Run on the history database's
+// own thread, so two imports of the same visits add them once. `tracker`
+// cancels the reply only: the rows are added even when it goes away first.
+void AddNewVisits(history::HistoryService& history,
+                  history::URLRows rows,
+                  history::VisitSource source,
+                  base::CancelableTaskTracker& tracker,
+                  base::OnceCallback<void(size_t)> done);
+
+// import I39, I42: what a password import did.
+struct PasswordWriteResult {
+  // Logins that came in.
+  size_t added = 0;
+  // Logins already saved with the same password: nothing to do.
+  size_t already_saved = 0;
+  // Logins saved for the same site and username with another password: the
+  // saved one is kept as it was.
+  size_t kept = 0;
+  // Rows Chromium's importer would not take: no password, no or a bad
+  // address, a field too long.
+  size_t refused = 0;
+  // The profile has no password store.
+  bool unavailable = false;
+};
+
+// import I39 (BACKLOG S-346): the rows of `incoming` ClassifyIncomingPasswords
+// counts as saved already -- the same site, username and password -- lose
+// their note, so Chromium's importer leaves the saved login as it is. It
+// adds a duplicate's note to the saved one's, and the login the result line
+// counted as saved already was changed.
+void DropNotesOfSavedLogins(
+    const std::vector<password_manager::CredentialUIEntry>& saved,
+    std::vector<password_manager::CSVPassword>& incoming);
+
+// import I39: sorts `incoming` against the logins `saved` in the profile's
+// own store: the result's `already_saved` and `kept` count them (`added`
+// counts the rest that would come in). A row whose parse failed counts as
+// refused.
+PasswordWriteResult ClassifyIncomingPasswords(
+    const std::vector<password_manager::CredentialUIEntry>& saved,
+    const std::vector<password_manager::CSVPassword>& incoming);
+
+// import I31, I39: writes logins into the profile's own password store
+// through Chromium's PasswordImporter, asked to wait for a confirmation: its
+// first pass checks every row against the saved logins (read in full first)
+// and writes nothing; the confirmation then replaces none of them. A login
+// that would replace a saved one with another password is kept as saved.
+class ImportedPasswordsWriter {
+ public:
+  using DoneCallback = base::OnceCallback<void(PasswordWriteResult)>;
+
+  explicit ImportedPasswordsWriter(Profile& profile);
+  ImportedPasswordsWriter(const ImportedPasswordsWriter&) = delete;
+  ImportedPasswordsWriter& operator=(const ImportedPasswordsWriter&) = delete;
+  ~ImportedPasswordsWriter();
+
+  // Writes `passwords`; `done` runs once, unless this is destroyed first.
+  void Write(std::vector<password_manager::CSVPassword> passwords,
+             DoneCallback done);
+
+ private:
+  void OnSavedPasswordsRead();
+  void OnChecked(const password_manager::ImportResults& results);
+  void OnWritten(const password_manager::ImportResults& results);
+  void Finish();
+
+  std::unique_ptr<password_manager::SavedPasswordsPresenter> presenter_;
+  std::unique_ptr<password_manager::PasswordImporter> importer_;
+  std::vector<password_manager::CSVPassword> passwords_;
+  PasswordWriteResult result_;
+  DoneCallback done_;
+  base::WeakPtrFactory<ImportedPasswordsWriter> weak_factory_{this};
+};
+
+// One import that is writing into a profile.
+class ImportJob {
+ public:
+  virtual ~ImportJob() = default;
+};
+
+// import I40: the imports writing into a profile, one per source at a time,
+// held here rather than by the page that started them, so a page that goes
+// away (a reload, the welcome dialog closed, Settings left) does not stop an
+// import halfway. Two pages cannot run the same import at once. Every import
+// is dropped when the profile is about to go away.
+class ImportJobs : public base::SupportsUserData::Data, public ProfileObserver {
+ public:
+  ImportJobs(const ImportJobs&) = delete;
+  ImportJobs& operator=(const ImportJobs&) = delete;
+  ~ImportJobs() override;
+
+  // The profile's imports, made on first use.
+  static ImportJobs& For(Profile& profile);
+
+  // Whether an import of `source` is running.
+  bool IsRunning(std::string_view source) const;
+  // Holds `job` as the import of `source`; false, and nothing held, when one
+  // is running already. `job` may be null for an import that needs nothing
+  // kept, only the flag.
+  bool Start(std::string_view source, std::unique_ptr<ImportJob> job);
+  // The import of `source` has ended: it is let go after the current task, so
+  // the job may call this from its own callbacks.
+  void Finish(std::string_view source);
+
+ private:
+  explicit ImportJobs(Profile& profile);
+
+  // ProfileObserver:
+  void OnProfileWillBeDestroyed(Profile* profile) override;
+
+  std::map<std::string, std::unique_ptr<ImportJob>, std::less<>> running_;
+  base::ScopedObservation<Profile, ProfileObserver> observation_{this};
+};
+
+// "1 bookmark", "812 bookmarks".
+std::u16string CountOf(size_t count,
+                       std::u16string_view one,
+                       std::u16string_view many);
+// "a", "a and b", "a, b and c"; empty for none.
+std::u16string ListInWords(const std::vector<std::u16string>& parts);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_IMPORTED_BOOKMARKS_H_
