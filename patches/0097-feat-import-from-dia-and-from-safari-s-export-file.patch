+  };
+  const file = el('button', 'secondary', 'Choose File\u2026');
+  file.dataset['focus'] = 'safari-file';
+  file.disabled = state.safariChoosing || state.safariStatus === 'inProgress';
+  file.addEventListener('click', () => choose('file'));
+  const folder = el('button', 'secondary', 'Choose Folder\u2026');
+  folder.dataset['focus'] = 'safari-folder';
+  folder.disabled = file.disabled;
+  folder.addEventListener('click', () => choose('folder'));
+  pick.append(file, folder);
+  block.append(pick);
+  const chosen = state.safari;
+  if (!chosen || !chosen.chosen) {
+    return block;
+  }
+  const summary = el('div', 'hint', chosen.summary);
+  summary.dataset['result'] = 'safari-summary';
+  block.append(summary);
+  if (!chosen.ready) {
+    return block;
+  }
+  const choices = el('div', 'import-row');
+  if (chosen.bookmarks > 0) {
+    choices.append(checkbox('Bookmarks', state.safariBookmarks,
