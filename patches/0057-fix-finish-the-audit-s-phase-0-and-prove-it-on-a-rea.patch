+// Tabs under `child` that stay where they are during a move.
+size_t RemainingTabs(const Child& child,
+                     const std::set<TabInterface*>& tabs_moved,
+                     const std::set<TabCollection*>& collections_moved) {
+  if (const auto* tab = std::get_if<ScopedTab>(&child)) {
+    return tabs_moved.contains(tab->get()) ? 0 : 1;
