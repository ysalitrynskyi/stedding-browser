+<DT><H3 id="com.apple.ReadingList">Reading List</H3>
+<DL><p>
+	<DT><A HREF="https://later.example/">Later</A>
+</DL><p>
+<DT><A HREF="https://loose.example/">Loose</A>
+</HTML>
+)";
+
+constexpr char kPasswordsCsv[] =
+    "Title,URL,Username,Password,Notes,OTPAuth\n"
+    "a,https://a.example/,ann,one,,\n"
+    "b,https://b.example/,bob,two,,\n";
+
+// import I34, I37: the folder an export unzips to, read file by file: each
+// file told by what it holds, a hidden "._" twin skipped, Safari's Favorites
+// and Reading List each a folder.
+TEST_F(SafariExportImporterPrepareTest, ReadsAnUnzippedFolder) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath folder = dir.GetPath();
+  ASSERT_TRUE(base::WriteFile(folder.AppendASCII("Bookmarks.html"),
+                              kBookmarksHtml));
+  ASSERT_TRUE(base::WriteFile(folder.AppendASCII("._Bookmarks.html"),
+                              "binary resource fork"));
+  ASSERT_TRUE(
+      base::WriteFile(folder.AppendASCII("Passwords.csv"), kPasswordsCsv));
+  const base::Time now = base::Time::Now();
+  // A history file whose name says nothing: its metadata says what it is.
+  ASSERT_TRUE(base::WriteFile(
+      folder.AppendASCII("Verlauf.json"),
+      HistoryJson({{"https://seen.example/", UsecBefore(now, base::Days(1))}})));
+  ASSERT_TRUE(base::WriteFile(
+      folder.AppendASCII("PaymentCards.json"),
+      R"({"metadata": {"data_type": "payment_cards"}, "payment_cards": []})"));
+
+  EXPECT_EQ(SafariExportFile::kBookmarks,
+            KindOfSafariExportFile(folder.AppendASCII("Bookmarks.html")));
+  EXPECT_EQ(SafariExportFile::kOther,
+            KindOfSafariExportFile(folder.AppendASCII("._Bookmarks.html")));
+  EXPECT_EQ(SafariExportFile::kHistory,
+            KindOfSafariExportFile(folder.AppendASCII("Verlauf.json")));
+  EXPECT_EQ(SafariExportFile::kPaymentCards,
+            KindOfSafariExportFile(folder.AppendASCII("PaymentCards.json")));
+
+  std::unique_ptr<SafariExportImporter> importer = MakeImporter();
+  const SafariExportSummary summary = Prepare(*importer, folder);
+  EXPECT_TRUE(summary.opened);
+  EXPECT_EQ(3u, summary.bookmarks);
+  EXPECT_TRUE(summary.history);
+  EXPECT_EQ(2u, summary.passwords);
+  EXPECT_TRUE(summary.cards);
+  EXPECT_TRUE(importer->prepared());
+  bool favorite = false;
+  bool later = false;
+  for (const user_data_importer::ImportedBookmarkEntry& entry :
+       importer->bookmarks()) {
+    if (entry.url == GURL("https://fav.example/")) {
+      favorite = entry.path == std::vector<std::u16string>{u"Favorites"};
+    }
+    if (entry.url == GURL("https://later.example/")) {
+      later = entry.path == std::vector<std::u16string>{u"Reading List"};
+    }
+  }
+  EXPECT_TRUE(favorite) << "Favorites are not a folder";
+  EXPECT_TRUE(later) << "the Reading List is not a folder";
+
+  const SafariHistoryRead history = ReadSafariHistoryFolder(folder, now);
+  ASSERT_EQ(1u, history.rows.size());
+  EXPECT_EQ(GURL("https://seen.example/"), history.rows[0].url());
+}
+
+// import I35: a part over its limit is named, and not read: a passwords
+// file over PasswordImporter's 1,000 KB, a history file over its cap.
+TEST_F(SafariExportImporterPrepareTest, OversizedPartsAreRefusedBeforeReading) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath folder = dir.GetPath();
+  std::string big = "Title,URL,Username,Password,Notes,OTPAuth\n";
+  while (big.size() <= kMaxSafariPasswordsBytes) {
+    big += "x,https://x.example/,user,password,,\n";
+  }
+  ASSERT_TRUE(base::WriteFile(folder.AppendASCII("Passwords.csv"), big));
+  const base::Time now = base::Time::Now();
+  ASSERT_TRUE(base::WriteFile(
+      folder.AppendASCII("History.json"),
+      HistoryJson({{"https://seen.example/", UsecBefore(now, base::Days(1))}})));
+  std::unique_ptr<SafariExportImporter> importer = MakeImporter();
+  const SafariExportSummary summary = Prepare(*importer, folder);
+  EXPECT_TRUE(summary.passwords_too_big);
+  EXPECT_EQ(0u, summary.passwords);
+  EXPECT_TRUE(importer->passwords().empty());
+  EXPECT_NE(std::u16string::npos,
+            SummariseSafariExport(summary).find(u"over 1,000 KB"));
+
+  const SafariHistoryRead history =
+      ReadSafariHistoryFolder(folder, now, kMaxSafariHistoryRows,
+                              /*max_file_bytes=*/16);
+  EXPECT_EQ(1u, history.files_too_big);
+  EXPECT_TRUE(history.rows.empty());
+}
+
+#if BUILDFLAG(IS_POSIX)
+// import I34, I35 (BACKLOG S-346): an unzipped export's own files are read,
+// and a link in the folder is followed to nothing. A passwords file linked
+// from elsewhere had been read in when the folder was chosen, before
+// Passwords was ticked, and one linked to /dev/zero read without end.
+TEST_F(SafariExportImporterPrepareTest, AFolderFollowsNoLink) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath elsewhere = dir.GetPath().AppendASCII("elsewhere");
+  const base::FilePath folder = dir.GetPath().AppendASCII("export");
+  ASSERT_TRUE(base::CreateDirectory(elsewhere));
+  ASSERT_TRUE(base::CreateDirectory(folder));
+  ASSERT_TRUE(
+      base::WriteFile(elsewhere.AppendASCII("Passwords.csv"), kPasswordsCsv));
+  const base::Time now = base::Time::Now();
+  ASSERT_TRUE(base::WriteFile(
+      elsewhere.AppendASCII("History.json"),
+      HistoryJson({{"https://seen.example/", UsecBefore(now, base::Days(1))}})));
+  ASSERT_TRUE(base::CreateSymbolicLink(elsewhere.AppendASCII("Passwords.csv"),
+                                       folder.AppendASCII("Passwords.csv")));
+  ASSERT_TRUE(base::CreateSymbolicLink(elsewhere.AppendASCII("History.json"),
+                                       folder.AppendASCII("History.json")));
+
+  std::unique_ptr<SafariExportImporter> importer = MakeImporter();
+  const SafariExportSummary summary = Prepare(*importer, folder);
+  EXPECT_EQ(0u, summary.passwords) << "the linked passwords file was read";
+  EXPECT_TRUE(importer->passwords().empty());
+  EXPECT_FALSE(summary.history) << "the linked history file was counted";
+  EXPECT_TRUE(ReadSafariHistoryFolder(folder, now).rows.empty())
+      << "the linked history file was read";
+}
+#endif  // BUILDFLAG(IS_POSIX)
+
+// import I36: the summary names what comes in, and that cards do not.
+TEST(SafariExportImporterTest, SummaryNamesPasswordsAndCards) {
+  SafariExportSummary summary;
+  summary.opened = true;
+  summary.bookmarks = 812;
+  summary.history = true;
+  summary.passwords = 96;
+  summary.cards = true;
+  EXPECT_EQ(u"In the file: 812 bookmarks, history and 96 passwords. Payment "
+            u"cards in the file are not imported.",
+            SummariseSafariExport(summary));
+  summary.cards = false;
+  summary.passwords = 0;
+  summary.too_many_passwords = true;
+  EXPECT_EQ(u"In the file: 812 bookmarks and history. It holds more than "
+            u"3,000 passwords, more than Stedding brings in at once.",
+            SummariseSafariExport(summary));
+}
+
+// import I42: one line that counts what came in and names what did not.
+TEST(SafariExportImporterTest, DescribeCountsEveryPart) {
+  SafariExportResult result;
+  result.bookmarks = 12;
+  result.bookmarks_already = 3;
+  result.history = 40;
+  result.passwords_asked = true;
+  result.passwords_in_file = 5;
+  result.passwords.added = 1;
+  result.passwords.kept = 2;
+  result.passwords.already_saved = 1;
+  result.passwords.refused = 1;
+  result.cards = true;
+  EXPECT_EQ(
+      u"Brought in from Safari: 12 bookmarks, 40 history entries and 1 "
+      u"password. 3 bookmarks were there already. 2 passwords saved with "
+      u"another password were kept as saved. 1 password was saved already. "
+      u"1 row of the passwords file could not be used. The export holds your "
+      u"passwords as plain text; you can delete it now. Payment cards are "
+      u"not imported.",
+      DescribeSafariExportResult(result));
+
+  SafariExportResult nothing;
+  nothing.passwords_in_file = 2;
+  EXPECT_EQ(u"Nothing new came in from Safari. Passwords were left out: tick "
+            u"Passwords to bring them in.",
+            DescribeSafariExportResult(nothing));
+
+  SafariExportResult busy;
+  busy.already_running = true;
+  EXPECT_EQ(u"Safari's export is being imported already.",
+            DescribeSafariExportResult(busy));
+}
