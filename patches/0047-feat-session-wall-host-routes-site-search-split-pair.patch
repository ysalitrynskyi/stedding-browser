+bool SpaceModel::WipeIsolatedSession(const SpaceId& id) {
+  return WipeIsolatedSession(id, base::DoNothing());
+}
+
+bool SpaceModel::WipeIsolatedSession(const SpaceId& id,
+                                     base::OnceClosure done) {
+  if (!tab_strip_model_ || !SpaceIsIsolated(id)) {
+    if (done) {
+      std::move(done).Run();
+    }
+    return false;
+  }
+  const RegistryEntry* const entry = registry_ ? registry_->Find(id) : nullptr;
+  if (!entry || entry->profile_id.empty()) {
+    if (done) {
+      std::move(done).Run();
+    }
+    return false;
+  }
+  isolated_jars_[id] = entry->profile_id;
+  return WipeIsolatedSpacePartition(
+      BrowserContextForWipe(), entry->profile_id,
+      base::BindOnce(
+          [](base::WeakPtr<SpaceModel> self, SpaceId id,
+             base::OnceClosure done) {
+            if (self) {
+              self->ReloadTabsInSpace(id);
+            }
+            if (done) {
+              std::move(done).Run();
+            }
+          },
+          weak_factory_.GetWeakPtr(), id, std::move(done)));
+}
+
+content::BrowserContext* SpaceModel::BrowserContextForWipe() const {
+  if (!tab_strip_model_) {
+    return nullptr;
+  }
+  for (int i = 0; i < tab_strip_model_->count(); ++i) {
+    if (content::WebContents* const contents =
+            tab_strip_model_->GetWebContentsAt(i)) {
+      return contents->GetBrowserContext();
+    }
+  }
+  return nullptr;
+}
+
+void SpaceModel::ReloadTabsInSpace(const SpaceId& id) {
+  if (!tab_strip_model_) {
+    return;
+  }
+  for (int i = 0; i < tab_strip_model_->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(i);
+    if (SpaceForTab(tab) != id) {
+      continue;
+    }
+    if (content::WebContents* const contents = tab->GetContents()) {
+      contents->GetController().Reload(content::ReloadType::NORMAL,
+                                       /*check_for_repost=*/false);
+    }
+  }
+}
+
+void SpaceModel::WipeIsolatedJar(std::string_view profile_id,
+                                 base::OnceClosure done) {
+  if (profile_id.empty()) {
+    if (done) {
+      std::move(done).Run();
+    }
+    return;
+  }
+  WipeIsolatedSpacePartition(BrowserContextForWipe(), profile_id,
+                             std::move(done));
+}
+
+void SpaceModel::MaybeRestoreSplit(tabs::TabInterface* tab) {
+  if (!tab || !tab_strip_model_) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<SpaceModel> model,
+                        tabs::TabHandle handle) {
+                       if (!model || !model->tab_strip_model_) {
+                         return;
+                       }
+                       tabs::TabInterface* const tab = handle.Get();
+                       if (!tab || tab->IsSplit()) {
+                         return;
+                       }
+                       content::WebContents* const contents =
+                           tab->GetContents();
+                       const TabSpaceRestoreData* const restored =
+                           contents ? TabSpaceRestoreData::FromWebContents(
+                                          contents)
+                                    : nullptr;
+                       if (!restored || restored->split_id().empty()) {
+                         return;
+                       }
+                       const std::optional<base::Token> token =
+                           base::Token::FromString(restored->split_id());
+                       if (!token) {
+                         return;
+                       }
+                       std::vector<int> indices;
+                       for (int i = 0; i < model->tab_strip_model_->count();
+                            ++i) {
+                         tabs::TabInterface* const other =
+                             model->tab_strip_model_->GetTabAtIndex(i);
+                         if (other->IsSplit()) {
+                           continue;
+                         }
+                         content::WebContents* const other_contents =
+                             other->GetContents();
+                         const TabSpaceRestoreData* const other_restored =
+                             other_contents
+                                 ? TabSpaceRestoreData::FromWebContents(
+                                       other_contents)
+                                 : nullptr;
+                         if (other_restored && other_restored->split_id() ==
+                                                   restored->split_id()) {
+                           indices.push_back(i);
+                         }
+                       }
+                       if (indices.size() != 2u) {
+                         return;
+                       }
+                       model->tab_strip_model_->RestoreSplit(
+                           split_tabs::SplitTabId::FromRawToken(*token),
+                           indices, split_tabs::SplitTabVisualData());
+                     },
+                     weak_factory_.GetWeakPtr(), handle));
+}
+
+tabs::TabInterface* SpaceModel::CopyTabToSpace(tabs::TabInterface* tab,
+                                               const SpaceId& dest) {
+  if (!tab || !tab_strip_model_ || !GetSpace(dest) || tab->IsPinned()) {
+    return nullptr;
+  }
+  content::WebContents* const source = tab->GetContents();
+  if (!source) {
+    return nullptr;
+  }
+  content::BrowserContext* const context = source->GetBrowserContext();
+  GURL url = source->GetLastCommittedURL();
+  if (url.is_empty()) {
+    url = source->GetVisibleURL();
+  }
+  if (url.is_empty()) {
+    url = GURL("about:blank");
+  }
+  scoped_refptr<content::SiteInstance> site_instance = SiteInstanceForSpaceTab(
+      context, url, registry_, dest, /*essential=*/false);
+  content::WebContents::CreateParams params(context, site_instance);
+  std::unique_ptr<content::WebContents> fresh =
+      content::WebContents::Create(params);
+  if (!url.IsAboutBlank()) {
+    fresh->GetController().LoadURL(url, content::Referrer(),
+                                   ui::PAGE_TRANSITION_TYPED, std::string());
+  }
+  const int index = tab_strip_model_->count();
+  tab_strip_model_->InsertWebContentsAt(index, std::move(fresh),
+                                        AddTabTypes::ADD_NONE);
+  tabs::TabInterface* const copy = tab_strip_model_->GetTabAtIndex(index);
+  SetSpaceForTab(copy, dest);
+  return copy;
+}
