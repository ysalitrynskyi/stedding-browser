+// import I43: Opera, where its installer keeps its data, and not in the
+// folders Chrome's table names.
+TEST(ChromiumFamilyImporterTest, FindsOpera) {
+  base::ScopedTempDir home;
+  ASSERT_TRUE(home.CreateUniqueTempDir());
+#if BUILDFLAG(IS_WIN)
+  base::ScopedPathOverride path_override(base::DIR_ROAMING_APP_DATA,
+                                         home.GetPath());
+  const base::FilePath dir =
+      home.GetPath().AppendASCII("Opera Software").AppendASCII("Opera Stable");
+#elif BUILDFLAG(IS_MAC)
+  base::ScopedPathOverride path_override(base::DIR_HOME, home.GetPath());
+  const base::FilePath dir = home.GetPath()
+                                 .AppendASCII("Library")
+                                 .AppendASCII("Application Support")
+                                 .AppendASCII("com.operasoftware.Opera");
+#else
+  GTEST_SKIP() << "the family is looked for on the Mac and Windows";
+#endif
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
+  EXPECT_EQ(&kOperaSource, FindChromiumFamilySource("opera"));
+  EXPECT_TRUE(FindUserDataDir(kOperaSource).empty());
+  ASSERT_TRUE(base::CreateDirectory(dir));
+  EXPECT_EQ(base::MakeAbsoluteFilePath(dir),
+            base::MakeAbsoluteFilePath(FindUserDataDir(kOperaSource)));
+#endif
+}
+
+// import I43: a version of Opera from before it had profiles keeps the
+// profile's files in its folder, with no list of profiles. A profile folder
+// or a list wins, and nothing is offered from a folder that holds neither.
+TEST(ChromiumFamilyImporterTest, AProfileMayBeAtTheTopOfItsFolder) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath user_data = dir.GetPath();
+  EXPECT_TRUE(ListChromiumProfiles(user_data, true).empty());
+
+  for (const char* const file : {"Bookmarks", "History", "Login Data"}) {
+    SCOPED_TRACE(file);
+    const base::FilePath path = user_data.AppendASCII(file);
+    ASSERT_TRUE(base::WriteFile(path, "{}"));
+    EXPECT_TRUE(ListChromiumProfiles(user_data).empty())
+        << "no other browser's folder is a profile";
+    const std::vector<ChromiumProfile> profiles =
+        ListChromiumProfiles(user_data, true);
+    ASSERT_EQ(1u, profiles.size());
+    EXPECT_TRUE(profiles[0].dir.empty());
+    EXPECT_EQ(u"Default", profiles[0].name);
+    EXPECT_TRUE(profiles[0].last_used);
+    ASSERT_TRUE(base::DeleteFile(path));
+  }
+
+  ASSERT_TRUE(base::WriteFile(user_data.AppendASCII("Bookmarks"), "{}"));
+  ASSERT_TRUE(base::CreateDirectory(user_data.AppendASCII("Default")));
+  const std::vector<ChromiumProfile> profiles =
+      ListChromiumProfiles(user_data, true);
+  ASSERT_EQ(1u, profiles.size());
+  EXPECT_EQ(base::FilePath::FromASCII("Default"), profiles[0].dir);
+}
+
+// import I43: Opera keeps most of its bookmarks in roots of its own, under
+// custom_root. Its folders and its unsorted bookmarks are the person's; its
+// Speed Dial, trash and pinboards are not read.
+TEST(ChromiumFamilyImporterTest, ReadsOperasOwnRoots) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const ChromiumBookmarks read =
+      ReadChromiumBookmarks(WriteBookmarks(dir.GetPath(), R"json({
+    "roots": {
+      "bookmark_bar": {"type": "folder", "children": [
+        {"type": "url", "name": "Bar", "url": "https://bar.example/"}]},
+      "custom_root": {
+        "userRoot": {"type": "folder", "children": [
+          {"type": "url", "name": "Mine", "url": "https://mine.example/"},
+          {"type": "folder", "name": "Work", "children": [
+            {"type": "url", "name": "Docs", "url": "https://docs.example/"}]}]},
+        "unsorted": {"type": "folder", "children": [
+          {"type": "url", "name": "Later", "url": "https://later.example/"}]},
+        "speedDial": {"type": "folder", "children": [
+          {"type": "url", "name": "Dial", "url": "https://dial.example/"}]},
+        "trash": {"type": "folder", "children": [
+          {"type": "url", "name": "Gone", "url": "https://gone.example/"}]},
+        "pinboard": {"type": "folder", "children": [
+          {"type": "url", "name": "Pin", "url": "https://pin.example/"}]}
+      }
+    },
+    "version": 1})json"));
+  EXPECT_FALSE(read.unreadable);
+  EXPECT_EQ(0u, read.left_out);
+
+  const ImportedBookmarkEntry* const bar =
+      FindPage(read.entries, "https://bar.example/");
+  ASSERT_TRUE(bar);
+  EXPECT_TRUE(bar->in_toolbar);
+  const ImportedBookmarkEntry* const mine =
+      FindPage(read.entries, "https://mine.example/");
+  ASSERT_TRUE(mine);
+  EXPECT_FALSE(mine->in_toolbar);
+  EXPECT_TRUE(mine->path.empty());
+  const ImportedBookmarkEntry* const docs =
+      FindPage(read.entries, "https://docs.example/");
+  ASSERT_TRUE(docs);
+  EXPECT_EQ(std::vector<std::u16string>{u"Work"}, docs->path);
+  const ImportedBookmarkEntry* const later =
+      FindPage(read.entries, "https://later.example/");
+  ASSERT_TRUE(later);
+  EXPECT_EQ(std::vector<std::u16string>{u"Unsorted bookmarks"}, later->path);
+  EXPECT_FALSE(FindPage(read.entries, "https://dial.example/"));
+  EXPECT_FALSE(FindPage(read.entries, "https://gone.example/"));
+  EXPECT_FALSE(FindPage(read.entries, "https://pin.example/"));
+}
