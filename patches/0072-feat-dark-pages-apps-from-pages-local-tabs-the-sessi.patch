+// tabs R32: an essentials card is a frosted tile with no edge, as Arc draws
+// its favourites: white over the ground, 35% in light and 9% in dark; a
+// plain row in the background has no fill (R23). Its 1 DIP edge was
+// Chromium's outline, whose Material colour took the Space's hue.
+using EssentialCardTest = LocalTabsTest;
+IN_PROC_BROWSER_TEST_F(EssentialCardTest, ACardIsAFrostedTileWithNoEdge) {
+  tabs::TabInterface* const card = Open(Site());
+  tab_strip_model()->SetTabPinned(IndexOf(card), true);
+  tabs::TabInterface* const plain = Open(Site("/title3.html"));
+  std::ignore = Open(Site("/title1.html"));
+  ThemeService* const theme =
+      ThemeServiceFactory::GetForProfile(browser()->GetProfile());
+  for (const auto& [scheme, frost] :
+       {std::pair(ThemeService::BrowserColorScheme::kLight,
+                  stedding::kEssentialCardFrostLight),
+        std::pair(ThemeService::BrowserColorScheme::kDark,
+                  stedding::kEssentialCardFrostDark)}) {
+    SCOPED_TRACE(scheme == ThemeService::BrowserColorScheme::kLight ? "light"
+                                                                     : "dark");
+    theme->SetBrowserColorScheme(scheme);
+    TabView* const row = Row(card);
+    ASSERT_TRUE(row);
+    EXPECT_FALSE(BorderPaints(row)) << "no edge";
+    // The row's own paint over red: a point on the card's left side, inside
+    // its insets and clear of the favicon, is the frost over red.
+    const auto paint = [](TabView* view) {
+      gfx::Canvas canvas(view->size(), 1.0f, /*is_opaque=*/true);
+      canvas.DrawColor(SK_ColorRED);
+      view->PaintRowForTesting(&canvas);
+      return canvas.GetBitmap();
+    };
+    const SkBitmap drawn = paint(row);
+    const int x = row->GetInsets().left() + 2;
+    const SkColor tile = drawn.getColor(x, drawn.height() / 2);
+    const SkColor expected =
+        color_utils::AlphaBlend(SK_ColorWHITE, SK_ColorRED, frost);
+    for (const auto& [got, want] :
+         {std::pair(SkColorGetR(tile), SkColorGetR(expected)),
+          std::pair(SkColorGetG(tile), SkColorGetG(expected)),
+          std::pair(SkColorGetB(tile), SkColorGetB(expected))}) {
+      EXPECT_NEAR(static_cast<int>(want), static_cast<int>(got), 3)
+          << color_utils::SkColorToRgbaString(tile) << ", not "
+          << color_utils::SkColorToRgbaString(expected);
+    }
+    TabView* const plain_row = Row(plain);
+    ASSERT_TRUE(plain_row);
+    const SkBitmap bare = paint(plain_row);
+    EXPECT_EQ(SK_ColorRED, bare.getColor(x, bare.height() / 2))
+        << "a plain row in the background has no fill";
+  }
+}
