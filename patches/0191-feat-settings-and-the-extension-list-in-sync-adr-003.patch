+
+void SidebarSyncService::UpdatePartObservers() {
+  // Sf60: the synced settings are heard only while sync is on and the
+  // Settings box is ticked.
+  const bool hear_settings = observing_ && settings_on();
+  if (hear_settings && settings_prefs_.IsEmpty()) {
+    settings_prefs_.Init(profile_->GetPrefs());
+    if (PrefService* const local = g_browser_process->local_state()) {
+      local_settings_prefs_.Init(local);
+    }
+    for (const sidebar_sync::SettingRule& rule :
+         sidebar_sync::SettingRules()) {
+      if (!rule.synced()) {
+        continue;
+      }
+      PrefChangeRegistrar& registrar =
+          rule.scope == sidebar_sync::SettingScope::kBrowser
+              ? local_settings_prefs_
+              : settings_prefs_;
+      if (!registrar.prefs()) {
+        continue;
+      }
+      registrar.Add(rule.path,
+                    PrefChangeRegistrar::NamedChangeCallback(
+                        base::BindRepeating(
+                            &SidebarSyncService::OnSettingChanged,
+                            base::Unretained(this))));
+    }
+  } else if (!hear_settings && !settings_prefs_.IsEmpty()) {
+    settings_prefs_.Reset();
+    local_settings_prefs_.Reset();
+    pending_settings_.clear();
+    settings_timer_.Stop();
+  }
+  // Sf63, Sf66: this computer's list, and what the person uninstalls here,
+  // heard while sync is on whatever the Extensions box says, so an uninstall
+  // made with the box off is not offered again once it is on.
+  const bool hear_extensions = observing_;
+  if (hear_extensions && !extension_watch_) {
+    extension_watch_ = std::make_unique<sidebar_sync::ExtensionListWatch>(
+        profile_,
+        base::BindRepeating(&SidebarSyncService::OnExtensionListChanged,
+                            base::Unretained(this)),
+        base::BindRepeating(&SidebarSyncService::OnExtensionUninstalledHere,
+                            base::Unretained(this)));
+  } else if (!hear_extensions) {
+    extension_watch_.reset();
+  }
+}
+
+void SidebarSyncService::OnSettingChanged(const std::string& path) {
+  // Sf60: a value applied from another computer is no edit made here.
+  if (applying_settings_ || !settings_on()) {
+    return;
+  }
+  // Nor is one another profile's sync applies to a browser-wide setting.
+  if (sidebar_sync::g_applying_browser_settings > 0) {
+    const sidebar_sync::SettingRule* const rule =
+        sidebar_sync::FindSettingRule(path);
+    if (ledger_ && rule) {
+      if (const PrefService::Preference* const pref =
+              PrefsFor(*rule)->FindPreference(path)) {
+        ledger_->browser_seen[path] =
+            sidebar_sync::SettingJson(*pref->GetValue());
+      }
+    }
+    return;
+  }
+  pending_settings_.insert(path);
+  if (ready_) {
+    settings_timer_.Start(FROM_HERE, sidebar_sync::kCommitDelay,
+                          base::BindOnce(&SidebarSyncService::CommitSettings,
+                                         base::Unretained(this)));
+  }
+}
+
+int64_t SidebarSyncService::MaxSeen() const {
+  return std::max({ledger_->hlc, ledger_->state.MaxTime(),
+                   sidebar_sync::MaxTime(ledger_->settings)});
+}
+
+PrefService* SidebarSyncService::PrefsFor(
+    const sidebar_sync::SettingRule& rule) const {
+  return rule.scope == sidebar_sync::SettingScope::kBrowser
+             ? g_browser_process->local_state()
+             : profile_->GetPrefs();
+}
+
+std::optional<base::Value> SidebarSyncService::WireNow(
+    const sidebar_sync::SettingRule& rule,
+    const sidebar_sync::SpaceMap& spaces) const {
+  PrefService* const prefs = PrefsFor(rule);
+  const PrefService::Preference* const pref =
+      prefs ? prefs->FindPreference(rule.path) : nullptr;
+  if (!pref || !pref->GetValue()) {
+    return std::nullopt;
+  }
+  return sidebar_sync::SettingToWire(rule, *pref->GetValue(), spaces);
+}
+
+sidebar_sync::SpaceMap SidebarSyncService::Spaces() const {
+  sidebar_sync::SpaceMap map;
+  SpaceRegistry* const registry =
+      SpaceRegistryFactory::GetForProfile(profile_);
+  if (!registry || !ledger_) {
+    return map;
+  }
+  // Sf61: a Space here travels by the id the join's pairs gave it.
+  const std::map<std::string, std::string> resolved = Resolved();
+  for (const RegistryEntry& entry : registry->entries()) {
+    const std::string local = entry.id.ToString();
+    const std::string shared = sidebar_sync::Canonical(resolved, local);
+    const Record* const record = ledger_->state.FindAlive(shared);
+    if (!record || record->kind != Kind::kSpace) {
+      continue;
+    }
+    map.to_shared[local] = shared;
+    // Two Spaces here under one shared id: the person's own, whose id is not
+    // the shared one, rather than one made under the shared id.
+    const auto it = map.to_local.find(shared);
+    if (it == map.to_local.end() || it->second == shared) {
+      map.to_local[shared] = local;
+    }
+  }
+  map.resolved = resolved;
+  return map;
+}
+
+bool SidebarSyncService::SettingsAllDefault() const {
+  for (const sidebar_sync::SettingRule& rule : sidebar_sync::SettingRules()) {
+    if (!rule.synced()) {
+      continue;
+    }
+    PrefService* const prefs = PrefsFor(rule);
+    const PrefService::Preference* const pref =
+        prefs ? prefs->FindPreference(rule.path) : nullptr;
+    if (pref && !pref->IsDefaultValue()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void SidebarSyncService::CommitSettings() {
+  settings_timer_.Stop();
+  if (!ready_ || !ledger_ || !settings_on() || pending_settings_.empty()) {
+    return;
+  }
+  // A Space made with its route is in the ledger before the route is read.
+  Commit();
+  const sidebar_sync::SpaceMap spaces = Spaces();
+  const Stamp stamp{
+      sidebar_sync::NextTime(NowMs(), MaxSeen()),
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId)};
+  bool changed = false;
+  for (const std::string& path : pending_settings_) {
+    const sidebar_sync::SettingRule* const rule =
+        sidebar_sync::FindSettingRule(path);
+    if (!rule || !rule->synced()) {
+      continue;
+    }
+    const std::optional<base::Value> wire = WireNow(*rule, spaces);
+    if (!wire) {
+      continue;
+    }
+    std::string json = sidebar_sync::SettingJson(*wire);
+    if (rule->scope == sidebar_sync::SettingScope::kBrowser) {
+      ledger_->browser_seen[path] = json;
+      ledger_->browser_applied[path] = json;
+      // Sf60: the value is the person's now, not sync's: set back later, to
+      // a value sync once applied, it is still an edit.
+      if (PrefService* const local = g_browser_process->local_state()) {
+        ScopedDictPrefUpdate(local, stedding::prefs::kSidebarSyncBrowserApplied)
+            ->Remove(path);
+      }
+    }
+    const auto it = ledger_->settings.find(path);
+    if (it != ledger_->settings.end() && it->second.json == json) {
+      continue;
+    }
+    ledger_->settings[path] = sidebar_sync::SettingField{std::move(json), stamp};
+    changed = true;
+  }
+  pending_settings_.clear();
+  if (!changed) {
+    return;
+  }
+  ledger_->hlc = std::max(ledger_->hlc, stamp.t);
+  ledger_->folder_behind = true;
+  SaveLedger();
+  WriteOwnFile();
+  NotifyObservers();
+}
+
+void SidebarSyncService::ApplySettings() {
+  if (!ledger_ || !settings_on()) {
+    return;
+  }
+  const sidebar_sync::SpaceMap spaces = Spaces();
+  base::AutoReset<bool> applying(&applying_settings_, true);
+  for (const auto& [path, field] : ledger_->settings) {
+    const sidebar_sync::SettingRule* const rule =
+        sidebar_sync::FindSettingRule(path);
+    if (!rule || !rule->synced()) {
+      continue;
+    }
+    PrefService* const prefs = PrefsFor(*rule);
+    const PrefService::Preference* const pref =
+        prefs ? prefs->FindPreference(path) : nullptr;
+    if (!pref || !pref->GetValue() || !pref->IsUserModifiable()) {
+      continue;
+    }
+    const std::optional<base::Value> wire =
+        base::JSONReader::Read(field.json, base::JSON_PARSE_RFC);
+    if (!wire) {
+      continue;
+    }
+    std::optional<base::Value> value = sidebar_sync::SettingFromWire(
+        *rule, *wire, *pref->GetValue(), spaces);
+    // Another computer's file is not trusted: a value of another type is
+    // never set.
+    if (!value || value->type() != pref->GetType()) {
+      continue;
+    }
+    const bool browser_wide =
+        rule->scope == sidebar_sync::SettingScope::kBrowser;
+    if (*value == *pref->GetValue()) {
+      // Sf60: the ledger's value is in force here already: it counts as
+      // applied, so another profile's later value is not set back.
+      if (browser_wide) {
+        ledger_->browser_applied[path] = field.json;
+      }
+      continue;
+    }
+    // Sf60: a browser-wide value is applied once for each new value of the
+    // ledger's, so that two profiles syncing with different computers do not
+    // take turns setting it at every read.
+    if (browser_wide) {
+      const auto applied = ledger_->browser_applied.find(path);
+      if (applied != ledger_->browser_applied.end() &&
+          applied->second == field.json) {
+        continue;
+      }
+      ++sidebar_sync::g_applying_browser_settings;
+    }
+    const base::Value* const fallback = prefs->GetDefaultPrefValue(path);
+    if (fallback && *fallback == *value) {
+      prefs->ClearPref(path);
+    } else {
+      prefs->Set(path, std::move(*value));
+    }
+    if (browser_wide) {
+      --sidebar_sync::g_applying_browser_settings;
+      const std::string now = sidebar_sync::SettingJson(*pref->GetValue());
+      ledger_->browser_applied[path] = field.json;
+      ledger_->browser_seen[path] = now;
+      // A launch of another profile finds it applied by sync, not edited.
+      ScopedDictPrefUpdate(prefs, stedding::prefs::kSidebarSyncBrowserApplied)
+          ->Set(path, now);
+    }
+  }
+}
+
+void SidebarSyncService::NoteBrowserEditsWhileAway() {
+  if (!ledger_ || !settings_on()) {
+    return;
+  }
+  // Sf60: a browser-wide setting changed while this profile was closed, by
+  // the person in another profile, is an edit to stamp; one another
+  // profile's sync applied is not.
+  PrefService* const local = g_browser_process->local_state();
+  if (!local) {
+    return;
+  }
+  const base::DictValue& by_sync =
+      local->GetDict(stedding::prefs::kSidebarSyncBrowserApplied);
+  for (const sidebar_sync::SettingRule& rule : sidebar_sync::SettingRules()) {
+    if (!rule.synced() || rule.scope != sidebar_sync::SettingScope::kBrowser) {
+      continue;
+    }
+    const PrefService::Preference* const pref = local->FindPreference(rule.path);
+    if (!pref) {
+      continue;
+    }
+    const std::string now = sidebar_sync::SettingJson(*pref->GetValue());
+    const auto seen = ledger_->browser_seen.find(rule.path);
+    if (seen != ledger_->browser_seen.end() && seen->second != now) {
+      const std::string* const applied = by_sync.FindString(rule.path);
+      if (!applied || *applied != now) {
+        pending_settings_.insert(rule.path);
+      }
+    }
+    ledger_->browser_seen[rule.path] = now;
+  }
+}
+
+void SidebarSyncService::NoteBrowserSettingsSeen() {
+  PrefService* const local = g_browser_process->local_state();
+  if (!ledger_ || !local) {
+    return;
+  }
+  for (const sidebar_sync::SettingRule& rule : sidebar_sync::SettingRules()) {
+    if (rule.synced() && rule.scope == sidebar_sync::SettingScope::kBrowser) {
+      if (const PrefService::Preference* const pref =
+              local->FindPreference(rule.path)) {
+        ledger_->browser_seen[rule.path] =
+            sidebar_sync::SettingJson(*pref->GetValue());
+      }
+    }
+  }
+}
+
+// static
+void SidebarSyncService::ApplyBrowserValueForTesting(const std::string& path,
+                                                     base::Value value) {
+  PrefService* const local = g_browser_process->local_state();
+  ++sidebar_sync::g_applying_browser_settings;
+  local->Set(path, value);
+  --sidebar_sync::g_applying_browser_settings;
+  ScopedDictPrefUpdate(local, stedding::prefs::kSidebarSyncBrowserApplied)
+      ->Set(path, sidebar_sync::SettingJson(value));
+}
+
+void SidebarSyncService::ForgetPartsReadForTesting() {
+  if (ledger_) {
+    ledger_->parts_read = false;
+  }
+}
+
+void SidebarSyncService::StartSettings(sidebar_sync::StartFrom start_from) {
+  if (!ledger_) {
+    return;
+  }
+  const std::string self =
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId);
+  bool others_have = false;
+  for (const auto& [path, field] : ledger_->settings) {
+    others_have |= field.s.w != self;
+  }
+  sidebar_sync::StartFrom choice = start_from;
+  if (choice == sidebar_sync::StartFrom::kAuto) {
+    // Sf62: a fresh install takes the other computers' settings unasked.
+    choice = others_have && SettingsAllDefault()
+                 ? sidebar_sync::StartFrom::kThere
+                 : sidebar_sync::StartFrom::kHere;
+  }
+  NoteBrowserSettingsSeen();
+  // Sf62: what this profile applied before its box was last off says nothing
+  // of what the person chose meanwhile; the start applies the chosen values.
+  ledger_->browser_applied.clear();
+  // Sf60: a browser-wide value sync applied before, which the person has
+  // changed since, is no longer sync's: set back to it later, it is an edit.
+  if (PrefService* const local = g_browser_process->local_state()) {
+    ScopedDictPrefUpdate by_sync(local,
+                                 stedding::prefs::kSidebarSyncBrowserApplied);
+    for (const auto& [path, now] : ledger_->browser_seen) {
+      const std::string* const recorded = by_sync->FindString(path);
+      if (recorded && *recorded != now) {
+        by_sync->Remove(path);
+      }
+    }
+  }
+  if (choice == sidebar_sync::StartFrom::kThere && others_have) {
+    pending_settings_.clear();
+    ApplySettings();
+    return;
+  }
+  // This computer's settings, every one, newer than anything seen.
+  const sidebar_sync::SpaceMap spaces = Spaces();
+  const Stamp stamp{sidebar_sync::NextTime(NowMs(), MaxSeen()), self};
+  for (const sidebar_sync::SettingRule& rule : sidebar_sync::SettingRules()) {
+    if (!rule.synced()) {
+      continue;
+    }
+    if (std::optional<base::Value> wire = WireNow(rule, spaces)) {
+      std::string json = sidebar_sync::SettingJson(*wire);
+      if (rule.scope == sidebar_sync::SettingScope::kBrowser) {
+        ledger_->browser_applied[rule.path] = json;
+      }
+      ledger_->settings[rule.path] =
+          sidebar_sync::SettingField{std::move(json), stamp};
+    }
+  }
+  pending_settings_.clear();
+  ledger_->hlc = std::max(ledger_->hlc, stamp.t);
+  ledger_->folder_behind = true;
+}
+
+void SidebarSyncService::SetPart(const std::string& part,
+                                 bool on,
+                                 sidebar_sync::StartFrom start_from) {
+  if (!enabled() || !ledger_ || (part != "settings" && part != "extensions")) {
+    return;
+  }
+  PrefService* const prefs = profile_->GetPrefs();
+  if (part == "settings") {
+    const bool was = settings_on();
+    prefs->SetBoolean(stedding::prefs::kSidebarSyncSettings, on);
+    if (on && !was) {
+      StartSettings(start_from);
+    }
+  } else {
+    prefs->SetBoolean(stedding::prefs::kSidebarSyncExtensions, on);
+  }
+  // The part is written, or no longer written, at once.
+  ledger_->folder_behind = true;
+  SaveLedger();
+  WriteOwnFile();
+  NotifyObservers();
+}
+
+void SidebarSyncService::MergePeerParts(const std::string& install,
+                                        const ParsedFile& parsed) {
+  if (parsed.parts.settings) {
+    if (!sidebar_sync::MergeSettings(ledger_->settings,
+                                     *parsed.parts.settings)
+             .empty()) {
+      ledger_->hlc = std::max(ledger_->hlc,
+                              sidebar_sync::MaxTime(*parsed.parts.settings));
+      if (settings_on()) {
+        ledger_->folder_behind = true;
+      }
+    }
+  }
+  // Sf63: a computer whose box is off, or on an older Stedding, offers
+  // nothing.
+  if (parsed.parts.extensions) {
+    ledger_->peer_extensions[install] = *parsed.parts.extensions;
+  } else {
+    ledger_->peer_extensions.erase(install);
+  }
+}
+
+sidebar_sync::FileParts SidebarSyncService::OwnParts() const {
+  sidebar_sync::FileParts parts;
+  if (settings_on() && ledger_) {
+    parts.settings = ledger_->settings;
+  }
+  // Sf63, Sf68: ids and names alone.
+  if (extensions_on()) {
+    parts.extensions = sidebar_sync::WebStoreExtensions(profile_);
+  }
+  return parts;
+}
+
+std::vector<sidebar_sync::ExtensionOffer> SidebarSyncService::Offers() const {
+  if (!ledger_) {
+    return {};
+  }
+  extensions::ExtensionRegistry* const registry =
+      extensions::ExtensionRegistry::Get(profile_);
+  std::set<std::string> installed;
+  for (const auto& [install, list] : ledger_->peer_extensions) {
+    for (const sidebar_sync::ExtensionEntry& entry : list) {
+      if (registry && registry->GetInstalledExtension(entry.id)) {
+        installed.insert(entry.id);
+      }
+    }
+  }
+  return sidebar_sync::ExtensionOffers(ledger_->peer_extensions, installed,
+                                       ledger_->extension_declined,
+                                       ledger_->extension_uninstalled);
+}
+
+bool SidebarSyncService::IsExtensionOffered(const std::string& id) {
+  if (!extensions_on()) {
+    return false;
+  }
+  for (const sidebar_sync::ExtensionOffer& offer : Offers()) {
+    if (offer.id == id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SidebarSyncService::OnExtensionOfferAnswered(const std::string& id,
+                                                  bool installed,
+                                                  bool cancelled) {
+  if (!ledger_) {
+    return;
+  }
+  // Sf65: declined at Chromium's own confirmation: not offered again from
+  // any computer that offers it now.
+  if (cancelled) {
+    for (const auto& [install, list] : ledger_->peer_extensions) {
+      for (const sidebar_sync::ExtensionEntry& entry : list) {
+        if (entry.id == id) {
+          ledger_->extension_declined.insert(
+              sidebar_sync::DeclineKey(install, id));
+        }
+      }
+    }
+    SaveLedger();
+  }
+  if (installed) {
+    ledger_->extension_uninstalled.erase(id);
+    SaveLedger();
+  }
+  NotifyObservers();
+}
+
+void SidebarSyncService::OnExtensionListChanged() {
+  if (!ready_ || !ledger_ || !extensions_on()) {
+    return;
+  }
+  ledger_->folder_behind = true;
+  WriteOwnFile();
+  NotifyObservers();
+}
+
+void SidebarSyncService::OnExtensionUninstalledHere(const std::string& id) {
+  if (!ledger_) {
+    return;
+  }
+  // Sf66: not offered again on this computer.
+  ledger_->extension_uninstalled.insert(id);
+  SaveLedger();
+}
+
+void SidebarSyncService::MaybeShowExtensionsNotice() {
+  if (!ready_ || !ledger_ || !extensions_on()) {
+    return;
+  }
+  // Sf64: once for each set of new offers, not at every start, naming the
+  // computer when one computer has them all.
+  std::vector<std::string> fresh;
+  std::set<std::string> devices;
+  size_t count = 0;
+  for (const sidebar_sync::ExtensionOffer& offer : Offers()) {
+    bool is_new = false;
+    for (const std::string& install : offer.installs) {
+      const std::string key = sidebar_sync::DeclineKey(install, offer.id);
+      if (!ledger_->extension_noticed.contains(key)) {
+        fresh.push_back(key);
+        devices.insert(DeviceOf(install));
+        is_new = true;
+      }
+    }
+    count += is_new ? 1 : 0;
+  }
+  if (fresh.empty()) {
+    return;
+  }
+  const std::vector<BrowserWindowInterface*> windows =
+      sidebar_sync::RegistryWindows(profile_);
+  if (windows.empty()) {
+    return;
+  }
+  BrowserWindowInterface* window = windows.front();
+  for (BrowserWindowInterface* const each : windows) {
+    if (each->IsActive()) {
+      window = each;
+      break;
+    }
+  }
+  // Marked once shown: a bar that could not be added is tried again.
+  if (!stedding::ShowSyncedExtensionsBar(
+          window, count,
+          std::vector<std::string>(devices.begin(), devices.end()))) {
+    return;
+  }
+  ledger_->extension_noticed.insert(fresh.begin(), fresh.end());
+  SaveLedger();
+}
+
+std::string SidebarSyncService::DeviceOf(const std::string& install) const {
+  if (ledger_) {
+    const auto stat = ledger_->peers.find(install);
+    if (stat != ledger_->peers.end() && !stat->second.device.empty()) {
+      return stat->second.device;
+    }
+  }
+  return install;
+}
