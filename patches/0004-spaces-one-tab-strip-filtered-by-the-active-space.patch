+#include "ui/views/context_menu_controller.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+#include "ui/views/view.h"
+
+class Browser;
+
+namespace views {
+class MenuRunner;
+class Textfield;
+}  // namespace views
+
+namespace spaces {
+
+// The row of Space icons at the bottom of the sidebar.
+//
+// One small icon per Space -- the emoji the user chose, on a chip in that
+// Space's colour -- plus a button that makes a new Space. The active Space's
+// chip is full strength and the rest are muted. Clicking one switches to that
+// Space, which changes which tabs the sidebar shows; see
+// SpaceTabVisibilityController.
+//
+// This sits at the bottom, not the top. An earlier version of this view was a
+// row of named pills at the top of the sidebar, which is not what the reference
+// does and made the sidebar top-heavy.
+class SpaceSwitcherView : public views::View,
+                          public SpaceModel::Observer,
+                          public views::ContextMenuController,
+                          public ui::SimpleMenuModel::Delegate,
+                          public views::TextfieldController {
+  METADATA_HEADER(SpaceSwitcherView, views::View)
+
+ public:
+  SpaceSwitcherView(SpaceModel& model, Browser& browser);
+
+  // Called with the hovered Space's name and the chip's bounds in the
+  // switcher's parent coordinates, and with an empty name on exit. The region
+  // view floats a pill above the row from this, as the reference does.
+  using HoverCallback =
+      base::RepeatingCallback<void(const std::u16string&, const gfx::Rect&)>;
+  void SetHoverCallback(HoverCallback callback) {
+    hover_callback_ = std::move(callback);
+  }
+  SpaceSwitcherView(const SpaceSwitcherView&) = delete;
+  SpaceSwitcherView& operator=(const SpaceSwitcherView&) = delete;
+  ~SpaceSwitcherView() override;
+
+  // SpaceModel::Observer:
+  void OnSpaceAdded(const SpaceId& id) override;
+  void OnSpaceRemoved(const SpaceId& id) override;
+  void OnActiveSpaceChanged(const SpaceId& from, const SpaceId& to) override;
+  void OnSpaceMetadataChanged(const SpaceId& id) override;
+
+  // The Space whose icon is at `point_in_screen`, if any. Used by the drag
+  // target to say which Space a tab was dropped on.
+  std::optional<SpaceId> SpaceAtScreenPoint(
+      const gfx::Point& point_in_screen) const;
+
+  // views::View:
+  void OnThemeChanged() override;
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(views::View* source,
+                                  const gfx::Point& point,
+                                  ui::mojom::MenuSourceType source_type) override;
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override;
+  bool IsCommandIdEnabled(int command_id) const override;
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override;
+
+ private:
+  // Discards the pills and builds them again from the model. The row is at most
+  // a handful of buttons, so rebuilding is simpler and less error-prone than
+  // reconciling, and it happens only when Spaces change.
+  void Rebuild();
+
+  void OnSpacePressed(const SpaceId& id);
+  void OnNewSpacePressed();
+
+  // Swaps the name row for an editable field, and back again.
+  void BeginRename(const SpaceId& id);
+  void EndRename(bool commit);
+
+  // Which Space the open context menu belongs to.
+  std::optional<SpaceId> menu_space_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+
+  const raw_ref<SpaceModel> model_;
+  const raw_ref<Browser> browser_;
+  raw_ptr<views::Textfield> rename_field_ = nullptr;
+  std::optional<SpaceId> renaming_;
+  raw_ptr<views::View> icon_row_ = nullptr;
+
+  // The chip for each Space, in model order. Parallel to model_->spaces() and
+  // rebuilt with it; spacer views between chips make lookups by child index
+  // wrong, so hit tests and the context menu go through this instead.
+  std::vector<std::pair<views::View*, SpaceId>> chips_;
+  HoverCallback hover_callback_;
+  base::ScopedObservation<SpaceModel, SpaceModel::Observer> observation_{this};
+};
