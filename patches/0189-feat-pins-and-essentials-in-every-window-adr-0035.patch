+PinRecord::PinRecord(PinRecord&& other) = default;
+PinRecord& PinRecord::operator=(PinRecord&& other) = default;
+PinRecord::~PinRecord() = default;
+
+bool PinRecord::operator==(const PinRecord& other) const {
+  return SameExceptTitle(other) && title == other.title;
+}
+
+bool PinRecord::SameExceptTitle(const PinRecord& other) const {
+  return id == other.id && tier == other.tier && has_space == other.has_space &&
+         (!has_space || space == other.space) && home == other.home &&
+         page == other.page &&
+         name == other.name && folder_path == other.folder_path &&
+         separator == other.separator;
+}
