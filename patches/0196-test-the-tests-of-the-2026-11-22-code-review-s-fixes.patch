+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !region()->is_expanded_on_hover() && !Animating();
+    })) << HoverStateB26();
+    region()->SetHoveredForTesting(std::nullopt);
+    region()->SetPointerForTesting(std::nullopt);
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+  }
+};
+
+// P34-1b; sidebar Y19 ("Leaving slides it away"). The hidden sidebar slides
+// in while the pointer is over the page, so the strip may never hear the
+// pointer enter, and then no exit of its own ever comes. A pointer that went
+// on over the page while it slid in, or that rested at the edge and then
+// left the window or crossed to the page in one step, left the sidebar out
+// over the page until the pointer happened to cross it.
+IN_PROC_BROWSER_TEST_F(SidebarEdgeB26Test,
+                       AnEdgeRevealGoesOnceThePointerIsElsewhere) {
+  AppendTab();
+  SettleB26();
+  ASSERT_NO_FATAL_FAILURE(HideTheSidebarB26());
+  ASSERT_LT(controller()->GetUncollapsedWidth() + 60, browser_view()->width())
+      << "the window is too narrow for a point past the open sidebar";
+
+  {
+    SCOPED_TRACE("the pointer went on over the page while it slid in");
+    ASSERT_NO_FATAL_FAILURE(RevealB26());
+    // The window hears the move; the sliding strip, not under it, does not.
+    region()->PlayWindowPointerForTesting(PastTheOpenSidebarB26(),
+                                          /*pressed=*/false);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    base::RunLoop().RunUntilIdle();
+    EXPECT_FALSE(region()->is_expanded_on_hover())
+        << "the sidebar stayed out with the pointer over the page: "
+        << HoverStateB26();
+    ASSERT_NO_FATAL_FAILURE(SlideAwayB26());
+    EXPECT_EQ(0, region()->width());
+  }
+
+  {
+    SCOPED_TRACE("the pointer rested at the edge, then left the window");
+    ASSERT_NO_FATAL_FAILURE(RevealB26());
+    // It slid in under the still pointer, which is on it now.
+    region()->SetHoveredForTesting(true);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(region()->is_expanded_on_hover())
+        << "the pointer resting where it slid in sent it away: "
+        << HoverStateB26();
+    // A move on the sidebar keeps it out.
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    region()->PlayWindowPointerForTesting(
+        region()->GetBoundsInScreen().CenterPoint(), /*pressed=*/false);
+    EXPECT_TRUE(region()->is_expanded_on_hover())
+        << "a move on the sidebar sent it away: " << HoverStateB26();
+    region()->SetPointerForTesting(ToScreenB26(LeadingEdgeB26()));
+    // Out past the window's edge in one step: no move lands in the window,
+    // which hears the pointer leave.
+    region()->SetHoveredForTesting(false);
+    region()->PlayWindowPointerExitForTesting(OutOfTheWindowB26());
+    EXPECT_FALSE(region()->is_expanded_on_hover())
+        << "the sidebar stayed out after the pointer left the window: "
+        << HoverStateB26();
+    ASSERT_NO_FATAL_FAILURE(SlideAwayB26());
+  }
+
+  {
+    SCOPED_TRACE("the pointer rested at the edge, then jumped to the page");
+    ASSERT_NO_FATAL_FAILURE(RevealB26());
+    region()->SetHoveredForTesting(true);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    base::RunLoop().RunUntilIdle();
+    ASSERT_TRUE(region()->is_expanded_on_hover()) << HoverStateB26();
+    // One move from the edge to the page, which lands on the page alone.
+    region()->SetHoveredForTesting(false);
+    region()->PlayWindowPointerForTesting(PastTheOpenSidebarB26(),
+                                          /*pressed=*/false);
+    EXPECT_FALSE(region()->is_expanded_on_hover())
+        << "the sidebar stayed out with the pointer over the page: "
+        << HoverStateB26();
+    ASSERT_NO_FATAL_FAILURE(SlideAwayB26());
+    EXPECT_EQ(0, region()->width());
+  }
+}
