+bool ShouldAnimate(const PrefService* prefs) {
+  if (kReduceMotionForTesting.Get()) {
+    return false;
+  }
+  if (gfx::Animation::PrefersReducedMotion()) {
+    return false;
+  }
+  return !prefs || prefs->GetBoolean(prefs::kUiAnimate);
+}
