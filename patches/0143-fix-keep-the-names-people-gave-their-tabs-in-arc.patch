 // The page's own request for the line its "Import from Arc..." row shows
 // before anything is imported (I2).
 constexpr char kArcSummary[] = R"(
@@ -781,6 +824,63 @@ IN_PROC_BROWSER_TEST_F(ArcImportTest, ImportingAgainBringsOnlyWhatArcGained) {
