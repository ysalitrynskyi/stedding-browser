+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_sync_place_client.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/base64.h"
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/time/clock.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "net/url_request/redirect_info.h"
+#include "services/data_decoder/public/mojom/xml_parser.mojom.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+constexpr int kListKeys = 1000;
+constexpr char kPropfind[] =
+    "<?xml version=\"1.0\" encoding=\"utf-8\"?>"
+    "<D:propfind xmlns:D=\"DAV:\"><D:prop><D:resourcetype/><D:getetag/>"
+    "<D:getcontentlength/><D:getlastmodified/></D:prop></D:propfind>";
+constexpr char kProbePrefix[] = "stedding-sidebar-probe-";
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("stedding_sidebar_sync_place", R"(
+        semantics {
+          sender: "Stedding sidebar sync"
+          description:
+            "Reads and writes this computer's sidebar file, and the other "
+            "computers' files, on the WebDAV folder or S3 bucket the user "
+            "set up."
+          trigger:
+            "The user sets up the place, a Stedding window comes to the "
+            "front, a timer while one is in front, a change to the sidebar, "
+            "or Sync now."
+          data:
+            "Space names, pinned addresses and the sign-in the user typed, "
+            "to the address the user typed."
+          destination: OTHER
+          destination_other: "The server the user typed."
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Off by default. Settings > Stedding > Sync and import > Stop "
+            "syncing turns it off."
+          policy_exception_justification: "No policy controls this."
+        })");
+
+base::TimeDelta g_timeout = kPlaceRequestTimeout;
+
+}  // namespace
+
+namespace {
+
+// A server's words reach strings that must be text.
+std::string TextHeader(const net::HttpResponseHeaders& headers,
+                       std::string_view name) {
+  std::string value = headers.GetNormalizedHeader(name).value_or(std::string());
+  return base::IsStringUTF8(value) ? value : std::string();
+}
+
+}  // namespace
+
+struct PlaceClient::Pending {
+  std::unique_ptr<network::SimpleURLLoader> loader;
+  std::string method;
+  ReplyDone done;
+  Reply reply;
+};
+
+bool PlaceClient::Reply::Succeeded() const {
+  return !redirect_refused && net_error == net::OK && status >= 200 &&
+         status < 300;
+}
+
+PlaceClient::Request::Request() = default;
+PlaceClient::Request::Request(Request&& other) = default;
+PlaceClient::Request::~Request() = default;
+
+PlaceClient::PlaceClient(Place place,
+                         PlaceSignIn sign_in,
+                         scoped_refptr<network::SharedURLLoaderFactory> factory,
+                         base::Clock* clock)
+    : place_(std::move(place)),
+      sign_in_(std::move(sign_in)),
+      factory_(std::move(factory)),
+      clock_(clock) {}
+
+PlaceClient::~PlaceClient() = default;
+
+// static
+void PlaceClient::SetTimeoutForTesting(base::TimeDelta timeout) {
+  g_timeout = timeout;
+}
+
+void PlaceClient::Send(Request request, ReplyDone done) {
+  auto resource = std::make_unique<network::ResourceRequest>();
+  resource->url = request.url;
+  resource->method = request.method;
+  // Sf56: no cookies, no referrer, nothing kept.
+  resource->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  resource->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  for (const auto& [name, value] : request.headers) {
+    resource->headers.SetHeader(name, value);
+  }
+  if (request.sign == Sign::kYes) {
+    if (place_.kind == PlaceKind::kS3) {
+      SigV4Input input;
+      input.method = request.method;
+      input.url = request.url;
+      input.payload_hash = Sha256Hex(request.body);
+      input.amz_date = AmzDate(clock_->Now());
+      input.region = place_.region;
+      input.service = "s3";
+      input.access_key = sign_in_.name;
+      input.secret_key = sign_in_.secret;
+      input.headers["x-amz-content-sha256"] = input.payload_hash;
+      input.headers["x-amz-date"] = input.amz_date;
+      resource->headers.SetHeader("x-amz-content-sha256", input.payload_hash);
+      resource->headers.SetHeader("x-amz-date", input.amz_date);
+      resource->headers.SetHeader("Authorization", SigV4Authorization(input));
+    } else {
+      resource->headers.SetHeader(
+          "Authorization",
+          "Basic " + base::Base64Encode(base::StrCat(
+                         {sign_in_.name, ":", sign_in_.secret})));
+    }
+  }
+  auto pending = std::make_unique<Pending>();
+  pending->method = resource->method;
+  pending->done = std::move(done);
+  pending->loader = network::SimpleURLLoader::Create(std::move(resource),
+                                                     kTrafficAnnotation);
+  network::SimpleURLLoader* const loader = pending->loader.get();
+  loader->SetAllowHttpErrorResults(true);
+  loader->SetTimeoutDuration(g_timeout);
+  if (!request.body.empty()) {
+    loader->AttachStringForUpload(std::move(request.body),
+                                  request.content_type);
+  }
+  Pending* const raw = pending.get();
+  pending_.push_back(std::move(pending));
+  loader->SetOnRedirectCallback(base::BindRepeating(
+      &PlaceClient::OnRedirect, weak_factory_.GetWeakPtr(), raw));
+  loader->DownloadToString(
+      factory_.get(),
+      base::BindOnce(&PlaceClient::OnBody, weak_factory_.GetWeakPtr(), raw),
+      request.cap);
+}
+
+void PlaceClient::OnRedirect(
+    Pending* pending,
+    const GURL& url_before_redirect,
+    const net::RedirectInfo& redirect_info,
+    const network::mojom::URLResponseHead& response_head,
+    std::vector<std::string>* removed_headers) {
+  // Sf54: the sign-in reaches only the address the user typed.
+  const GURL& to = redirect_info.new_url;
+  const bool drops_encryption =
+      url_before_redirect.SchemeIs(url::kHttpsScheme) &&
+      !to.SchemeIs(url::kHttpsScheme);
+  const bool same_server =
+      to.host() == url_before_redirect.host() &&
+      (to.scheme() != url_before_redirect.scheme() ||
+       to.EffectiveIntPort() == url_before_redirect.EffectiveIntPort());
+  // A 303 turns a write into a read, whose 200 would say the write was made.
+  const bool same_method = redirect_info.new_method == pending->method;
+  if (same_server && !drops_encryption && same_method) {
+    return;
+  }
+  pending->reply.redirect_refused = true;
+  if (response_head.headers) {
+    pending->reply.bucket_region =
+        TextHeader(*response_head.headers, "x-amz-bucket-region");
+  }
+  Finish(pending);
+}
+
+void PlaceClient::OnBody(Pending* pending, std::optional<std::string> body) {
+  Reply& reply = pending->reply;
+  reply.net_error = pending->loader->NetError();
+  reply.body = std::move(body).value_or(std::string());
+  const network::mojom::URLResponseHead* const head =
+      pending->loader->ResponseInfo();
+  if (head && head->headers) {
+    const net::HttpResponseHeaders& headers = *head->headers;
+    reply.status = headers.response_code();
+    reply.etag = TextHeader(headers, "etag");
+    reply.bucket_region = TextHeader(headers, "x-amz-bucket-region");
+    size_t iter = 0;
+    std::string challenge;
+    bool any = false;
+    bool basic = false;
+    while (headers.EnumerateHeader(&iter, "www-authenticate", &challenge)) {
+      any = true;
+      basic |= base::StartsWith(challenge, "basic",
+                                base::CompareCase::INSENSITIVE_ASCII);
+    }
+    reply.basic_offered = !any || basic;
+  }
+  Finish(pending);
+}
+
+void PlaceClient::Finish(Pending* pending) {
+  ReplyDone done = std::move(pending->done);
+  Reply reply = std::move(pending->reply);
+  // The loader may be what is calling; it says that is safe.
+  std::erase_if(pending_,
+                [pending](const std::unique_ptr<Pending>& each) {
+                  return each.get() == pending;
+                });
+  std::move(done).Run(std::move(reply));
+}
+
+void PlaceClient::Classify(PlaceOp op, Reply reply, Done done) {
+  if (!reply.bucket_region.empty()) {
+    named_region_ = reply.bucket_region;
+  }
+  if (reply.redirect_refused) {
+    std::move(done).Run(reply.bucket_region.empty()
+                            ? PlaceFailure::kRedirect
+                            : PlaceFailure::kWrongRegion);
+    return;
+  }
+  if (reply.net_error != net::OK) {
+    std::move(done).Run(FailureOfNetError(reply.net_error));
+    return;
+  }
+  if (place_.kind != PlaceKind::kS3) {
+    std::move(done).Run(
+        FailureOfStatus(op, reply.status, reply.basic_offered));
+    return;
+  }
+  if (reply.body.empty()) {
+    std::move(done).Run(FailureOfS3Error(op, reply.status, std::string()));
+    return;
+  }
+  data_decoder::DataDecoder::ParseXmlIsolated(
+      reply.body, data_decoder::mojom::XmlParser::WhitespaceBehavior::kIgnore,
+      base::BindOnce(&PlaceClient::OnS3ErrorParsed,
+                     weak_factory_.GetWeakPtr(), op, reply.status,
+                     std::move(done)));
+}
+
+void PlaceClient::OnS3ErrorParsed(
+    PlaceOp op,
+    int status,
+    Done done,
+    data_decoder::DataDecoder::ValueOrError result) {
+  S3Error error;
+  if (result.has_value()) {
+    error = ParseS3Error(*result);
+  }
+  if (!error.region.empty()) {
+    named_region_ = error.region;
+  }
+  std::move(done).Run(FailureOfS3Error(op, status, error.code));
+}
+
+void PlaceClient::CheckRoot(Done done) {
+  SendList(PlaceOp::kRoot, Sign::kYes, /*max_keys=*/1, /*depth=*/0,
+           base::BindOnce(&PlaceClient::OnRootListed,
+                          weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void PlaceClient::OnRootListed(Done done,
+                               PlaceFailure failure,
+                               PlaceList list) {
+  // A file at the address answers the method too, and is no folder.
+  if (failure == PlaceFailure::kNone && place_.kind == PlaceKind::kWebDav &&
+      (list.entries.empty() || !list.entries.front().folder)) {
+    failure = PlaceFailure::kWebPage;
+  }
+  std::move(done).Run(failure);
+}
+
+void PlaceClient::SendList(PlaceOp op,
+                           Sign sign,
+                           int max_keys,
+                           int depth,
+                           ListDone done) {
+  Request request;
+  request.cap = kMaxListBytes;
+  request.sign = sign;
+  GURL folder;
+  if (place_.kind == PlaceKind::kS3) {
+    request.method = "GET";
+    request.url = S3ListUrl(place_, max_keys);
+  } else {
+    request.method = "PROPFIND";
+    request.url = op == PlaceOp::kRoot ? place_.address
+                                       : WebDavFolderUrl(place_);
+    folder = request.url;
+    request.body = kPropfind;
+    request.content_type = "application/xml; charset=utf-8";
+    request.headers.emplace_back("Depth", base::NumberToString(depth));
+  }
+  Send(std::move(request),
+       base::BindOnce(&PlaceClient::OnListReply, weak_factory_.GetWeakPtr(),
+                      op, std::move(folder), std::move(done)));
+}
+
+void PlaceClient::OnListReply(PlaceOp op,
+                              GURL folder,
+                              ListDone done,
+                              Reply reply) {
+  if (!reply.Succeeded()) {
+    Classify(op, std::move(reply),
+             base::BindOnce(
+                 [](ListDone done, PlaceFailure failure) {
+                   std::move(done).Run(failure, PlaceList());
+                 },
+                 std::move(done)));
+    return;
+  }
+  // Sf47: a web server answers an unknown method with its page.
+  if (place_.kind == PlaceKind::kWebDav && reply.status != 207) {
+    std::move(done).Run(PlaceFailure::kWebPage, PlaceList());
+    return;
+  }
+  data_decoder::DataDecoder::ParseXmlIsolated(
+      reply.body, data_decoder::mojom::XmlParser::WhitespaceBehavior::kIgnore,
+      base::BindOnce(&PlaceClient::OnListParsed, weak_factory_.GetWeakPtr(),
+                     std::move(folder), std::move(done)));
+}
+
+void PlaceClient::OnListParsed(
+    GURL folder,
+    ListDone done,
+    data_decoder::DataDecoder::ValueOrError result) {
+  std::optional<PlaceList> list;
+  if (result.has_value()) {
+    list = place_.kind == PlaceKind::kS3
+               ? ParseS3List(*result, S3KeyPrefix(place_))
+               : ParseWebDavList(*result, folder);
+  }
+  if (!list) {
+    std::move(done).Run(PlaceFailure::kWebPage, PlaceList());
+    return;
+  }
+  std::move(done).Run(PlaceFailure::kNone, std::move(*list));
+}
+
+void PlaceClient::HasFolder(HasFolderDone done) {
+  if (place_.kind == PlaceKind::kS3) {
+    std::move(done).Run(PlaceFailure::kNone, true);
+    return;
+  }
+  Request request;
+  request.method = "PROPFIND";
+  request.url = WebDavFolderUrl(place_);
+  request.body = kPropfind;
+  request.content_type = "application/xml; charset=utf-8";
+  request.headers.emplace_back("Depth", "0");
+  request.cap = kMaxListBytes;
+  Send(std::move(request),
+       base::BindOnce(&PlaceClient::OnFolderReply, weak_factory_.GetWeakPtr(),
+                      std::move(done)));
+}
+
+void PlaceClient::OnFolderReply(HasFolderDone done, Reply reply) {
+  if (reply.Succeeded()) {
+    std::move(done).Run(PlaceFailure::kNone, true);
+    return;
+  }
+  if (reply.net_error == net::OK && reply.status == 404) {
+    std::move(done).Run(PlaceFailure::kNone, false);
+    return;
+  }
+  Classify(PlaceOp::kList, std::move(reply),
+           base::BindOnce(
+               [](HasFolderDone done, PlaceFailure failure) {
+                 std::move(done).Run(failure, false);
+               },
+               std::move(done)));
+}
+
+void PlaceClient::MakeFolder(Done done) {
+  Request request;
+  request.method = "MKCOL";
+  request.url = WebDavFolderUrl(place_);
+  request.cap = kMaxListBytes;
+  Send(std::move(request),
+       base::BindOnce(&PlaceClient::OnMakeReply, weak_factory_.GetWeakPtr(),
+                      std::move(done)));
+}
+
+void PlaceClient::OnMakeReply(Done done, Reply reply) {
+  // 405: it is there after all.
+  if (reply.Succeeded() ||
+      (reply.net_error == net::OK && reply.status == 405)) {
+    std::move(done).Run(PlaceFailure::kNone);
+    return;
+  }
+  Classify(PlaceOp::kWrite, std::move(reply), std::move(done));
+}
+
+GURL PlaceClient::FileUrl(const std::string& name) const {
+  return place_.kind == PlaceKind::kS3
+             ? S3ObjectUrl(place_, name)
+             : WebDavFolderUrl(place_).Resolve(
+                   UriEncode(name, /*keep_slash=*/false));
+}
+
+void PlaceClient::List(Sign sign, ListDone done) {
+  SendList(PlaceOp::kList, sign, kListKeys, /*depth=*/1, std::move(done));
+}
+
+void PlaceClient::Read(Sign sign, const std::string& name, ReadDone done) {
+  Request request;
+  request.method = "GET";
+  request.url = FileUrl(name);
+  request.cap = kMaxFileBytes;
+  request.sign = sign;
+  Send(std::move(request),
+       base::BindOnce(&PlaceClient::OnReadReply, weak_factory_.GetWeakPtr(),
+                      std::move(done)));
+}
+
+void PlaceClient::OnReadReply(ReadDone done, Reply reply) {
+  if (reply.Succeeded()) {
+    std::move(done).Run(PlaceFailure::kNone, std::move(reply.body));
+    return;
+  }
+  Classify(PlaceOp::kRead, std::move(reply),
+           base::BindOnce(
+               [](ReadDone done, PlaceFailure failure) {
+                 std::move(done).Run(failure, std::string());
+               },
+               std::move(done)));
+}
+
+void PlaceClient::Write(const std::string& name,
+                        std::string body,
+                        WriteDone done) {
+  Request request;
+  request.method = "PUT";
+  request.url = FileUrl(name);
+  request.body = std::move(body);
+  request.content_type = "application/json";
+  request.cap = kMaxListBytes;
+  Send(std::move(request),
+       base::BindOnce(&PlaceClient::OnWriteReply, weak_factory_.GetWeakPtr(),
+                      std::move(done)));
+}
+
+void PlaceClient::OnWriteReply(WriteDone done, Reply reply) {
+  if (reply.Succeeded()) {
+    std::move(done).Run(PlaceFailure::kNone,
+                        VersionOfETag(std::move(reply.etag)));
+    return;
+  }
+  Classify(PlaceOp::kWrite, std::move(reply),
+           base::BindOnce(
+               [](WriteDone done, PlaceFailure failure) {
+                 std::move(done).Run(failure, std::string());
+               },
+               std::move(done)));
+}
+
+void PlaceClient::Remove(const std::string& name, Done done) {
+  Request request;
+  request.method = "DELETE";
+  request.url = FileUrl(name);
+  request.cap = kMaxListBytes;
+  Send(std::move(request),
+       base::BindOnce(&PlaceClient::OnRemoveReply, weak_factory_.GetWeakPtr(),
+                      PlaceOp::kDelete, std::move(done)));
+}
+
+void PlaceClient::OnRemoveReply(PlaceOp op, Done done, Reply reply) {
+  if (reply.Succeeded() ||
+      (reply.net_error == net::OK && reply.status == 404)) {
+    std::move(done).Run(PlaceFailure::kNone);
+    return;
+  }
+  Classify(op, std::move(reply), std::move(done));
+}
+
+void PlaceClient::RemoveFolderIfEmpty(Done done) {
+  if (place_.kind == PlaceKind::kS3) {
+    std::move(done).Run(PlaceFailure::kNone);
+    return;
+  }
+  List(Sign::kYes, base::BindOnce(&PlaceClient::OnFolderListed,
+                                  weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void PlaceClient::OnFolderListed(Done done,
+                                 PlaceFailure failure,
+                                 PlaceList list) {
+  // The folder's own row, and nothing else. A DELETE takes a folder whole.
+  if (failure != PlaceFailure::kNone || list.cut_short ||
+      list.entries.size() > 1 ||
+      std::ranges::any_of(list.entries, [](const PlaceEntry& entry) {
+        return !entry.folder;
+      })) {
+    std::move(done).Run(failure);
+    return;
+  }
+  Request request;
+  request.method = "DELETE";
+  request.url = WebDavFolderUrl(place_);
+  request.cap = kMaxListBytes;
+  Send(std::move(request),
+       base::BindOnce(&PlaceClient::OnRemoveReply, weak_factory_.GetWeakPtr(),
+                      PlaceOp::kDelete, std::move(done)));
+}
+
+PlaceCheck::PlaceCheck(PlaceClient* client, Done done)
+    : client_(client), done_(std::move(done)) {}
+
+PlaceCheck::~PlaceCheck() = default;
+
+void PlaceCheck::Start() {
+  // Sf47: the name other computers ignore (Sf28): it ends in `.tmp`.
+  const std::string token = MakeInstallId();
+  probe_name_ = base::StrCat({kProbePrefix, token, ".tmp"});
+  probe_body_ = base::StrCat({"Stedding sidebar sync test ", token, "\n"});
+  client_->CheckRoot(
+      base::BindOnce(&PlaceCheck::OnRoot, weak_factory_.GetWeakPtr()));
+}
+
+void PlaceCheck::OnRoot(PlaceFailure failure) {
+  if (failure != PlaceFailure::kNone) {
+    Stop(failure);
+    return;
+  }
+  client_->HasFolder(
+      base::BindOnce(&PlaceCheck::OnHasFolder, weak_factory_.GetWeakPtr()));
+}
+
+void PlaceCheck::OnHasFolder(PlaceFailure failure, bool exists) {
+  if (failure != PlaceFailure::kNone) {
+    Stop(failure);
+  } else if (exists) {
+    WriteProbe();
+  } else {
+    client_->MakeFolder(
+        base::BindOnce(&PlaceCheck::OnFolderMade, weak_factory_.GetWeakPtr()));
+  }
+}
+
+void PlaceCheck::OnFolderMade(PlaceFailure failure) {
+  if (failure != PlaceFailure::kNone) {
+    Stop(failure);
+    return;
+  }
+  result_.made_folder = true;
+  WriteProbe();
+}
+
+void PlaceCheck::WriteProbe() {
+  client_->Write(probe_name_, probe_body_,
+                 base::BindOnce(&PlaceCheck::OnProbeWritten,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void PlaceCheck::OnProbeWritten(PlaceFailure failure, std::string version) {
+  if (failure != PlaceFailure::kNone) {
+    Stop(failure);
+    return;
+  }
+  client_->Read(PlaceClient::Sign::kYes, probe_name_,
+                base::BindOnce(&PlaceCheck::OnProbeRead,
+                               weak_factory_.GetWeakPtr()));
+}
+
+void PlaceCheck::OnProbeRead(PlaceFailure failure, std::string body) {
+  if (failure == PlaceFailure::kNone && body != probe_body_) {
+    failure = PlaceFailure::kMismatch;
+  }
+  if (failure != PlaceFailure::kNone) {
+    RemoveProbe(failure);
+    return;
+  }
+  client_->List(PlaceClient::Sign::kYes,
+                base::BindOnce(&PlaceCheck::OnListed,
+                               weak_factory_.GetWeakPtr()));
+}
+
+void PlaceCheck::OnListed(PlaceFailure failure, PlaceList list) {
+  if (failure == PlaceFailure::kNone &&
+      !std::ranges::any_of(list.entries, [this](const PlaceEntry& entry) {
+        return entry.name == probe_name_;
+      })) {
+    failure = PlaceFailure::kNoList;
+  }
+  if (failure != PlaceFailure::kNone) {
+    RemoveProbe(failure);
+    return;
+  }
+  // Sf48: what anyone sees, with the probe there to be seen.
+  client_->List(PlaceClient::Sign::kNo,
+                base::BindOnce(&PlaceCheck::OnListedByAnyone,
+                               weak_factory_.GetWeakPtr()));
+}
+
+void PlaceCheck::OnListedByAnyone(PlaceFailure failure, PlaceList list) {
+  if (failure == PlaceFailure::kNone) {
+    RemoveProbe(PlaceFailure::kPublic);
+    return;
+  }
+  client_->Read(PlaceClient::Sign::kNo, probe_name_,
+                base::BindOnce(&PlaceCheck::OnReadByAnyone,
+                               weak_factory_.GetWeakPtr()));
+}
+
+void PlaceCheck::OnReadByAnyone(PlaceFailure failure, std::string body) {
+  switch (failure) {
+    case PlaceFailure::kNone:
+      RemoveProbe(body == probe_body_ ? PlaceFailure::kPublic
+                                      : PlaceFailure::kNone);
+      return;
+    // Sf48: no answer is not a refusal, and a place that may be open to
+    // anyone does not pass.
+    case PlaceFailure::kTimedOut:
+    case PlaceFailure::kUnreachable:
+    case PlaceFailure::kServerError:
+      RemoveProbe(failure);
+      return;
+    default:
+      RemoveProbe(PlaceFailure::kNone);
+      return;
+  }
+}
+
+void PlaceCheck::RemoveProbe(PlaceFailure failure) {
+  result_.failure = failure;
+  client_->Remove(probe_name_, base::BindOnce(&PlaceCheck::OnProbeRemoved,
+                                              weak_factory_.GetWeakPtr()));
+}
+
+void PlaceCheck::OnProbeRemoved(PlaceFailure failure) {
+  // The first failure is the one said; a probe that would not go is said when
+  // nothing else went wrong.
+  Stop(result_.failure != PlaceFailure::kNone ? result_.failure : failure);
+}
+
+void PlaceCheck::Stop(PlaceFailure failure) {
+  result_.failure = failure;
+  // A failed test leaves what it found.
+  if (failure != PlaceFailure::kNone && result_.made_folder) {
+    result_.made_folder = false;
+    client_->RemoveFolderIfEmpty(base::BindOnce(
+        &PlaceCheck::OnCleanedUp, weak_factory_.GetWeakPtr()));
+    return;
+  }
+  OnCleanedUp(PlaceFailure::kNone);
+}
+
+void PlaceCheck::OnCleanedUp(PlaceFailure failure) {
+  result_.region = client_->named_region();
+  std::move(done_).Run(result_);
+}
+
+}  // namespace spaces::sidebar_sync
