+++ b/chrome/browser/ui/views/spaces/space_tab_visibility_controller.cc
@@ -0,0 +1,66 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_tab_visibility_controller.h"
+
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/common/tab_view.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/views/view.h"
+#include "ui/views/view_utils.h"
+
+namespace spaces {
+
+SpaceTabVisibilityController::SpaceTabVisibilityController(
+    SpaceModel& model,
+    TabStripModel& tab_strip_model,
+    views::View& tab_strip_root)
+    : model_(model),
+      tab_strip_model_(tab_strip_model),
+      tab_strip_root_(tab_strip_root) {
+  observation_.Observe(&model);
+  UpdateTabVisibility();
+}
+
+SpaceTabVisibilityController::~SpaceTabVisibilityController() = default;
+
+void SpaceTabVisibilityController::UpdateTabVisibility() {
+  UpdateSubtree(*tab_strip_root_);
+}
+
+void SpaceTabVisibilityController::UpdateSubtree(views::View& parent) {
+  for (views::View* child : parent.children()) {
+    if (auto* const tab_view = views::AsViewClass<TabView>(child)) {
+      const tabs::TabInterface* const tab = tab_view->GetTabInterface();
+      if (!tab) {
+        continue;
+      }
+      if (!model_->IsTabInActiveSpace(tab)) {
+        tab_view->SetVisible(false);
+        continue;
+      }
+      // Belongs to the active Space, but a collapsed group may still be hiding
+      // it. Asking the model rather than assuming keeps the two reasons a tab
+      // can be hidden from fighting each other.
+      const int index = tab_strip_model_->GetIndexOfTab(tab);
+      const bool collapsed = index != TabStripModel::kNoTab &&
+                             tab_strip_model_->IsTabCollapsed(index);
+      tab_view->SetVisible(!collapsed);
+      continue;
+    }
+    // Group and folder views hold tabs of their own.
+    UpdateSubtree(*child);
+  }
+}
+
+void SpaceTabVisibilityController::OnActiveSpaceChanged(const SpaceId& from,
+                                                        const SpaceId& to) {
+  UpdateTabVisibility();
+}
+
+void SpaceTabVisibilityController::OnSpaceRemoved(const SpaceId& id) {
+  UpdateTabVisibility();
+}
+
+}  // namespace spaces
