+// little E3: a little window closes after its own, shorter, idle.
+TEST_F(TabArchiverTest, LittleWindowUsesItsOwnThreshold) {
+  std::unique_ptr<Browser> little =
+      CreateBrowser(profile(), Browser::TYPE_POPUP, /*hosted_app=*/false);
+  MarkLittleWindow(little.get());
+  AddTab(little.get(), GURL("https://little.example/"));
+  TabArchiver archiver(*little, *prefs());
+  base::SimpleTestTickClock clock;
+  clock.SetNowTicks(base::TimeTicks::Now());
+  archiver.set_tick_clock_for_testing(&clock);
+  // The active tab is protected; the window's page must be idle, so a
+  // second tab takes the activation.
+  AddTab(little.get(), GURL("https://other.example/"));
+  clock.Advance(base::Hours(7));
+  archiver.Sweep();
+  EXPECT_EQ(1, little->tab_strip_model()->count()) << "6 h is the little idle";
+  little->tab_strip_model()->CloseAllTabs();
+}
