+void TabStripModel::MoveTabOutOfFolders(int index) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  if (!ContainsIndex(index)) {
+    return;
+  }
+  tabs::TabInterface* const tab = GetTabAtIndex(index);
+  const tabs::TabCollection* outermost = nullptr;
+  for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+       each = each->GetParentCollection()) {
+    if (each->type() == tabs::TabCollection::Type::FOLDER) {
+      outermost = each;
+    }
+  }
+  if (!outermost) {
+    return;
+  }
+  std::vector<int> indices;
+  if (const std::optional<split_tabs::SplitTabId> split = tab->GetSplit()) {
+    for (tabs::TabInterface* const pane : GetSplitData(*split)->ListTabs()) {
+      indices.push_back(GetIndexOfTab(pane));
+    }
+  } else {
+    indices.push_back(index);
+  }
+  std::ranges::sort(indices);
+  // Just past the folder's last tab, as the strip reads before the move: a
+  // position right after a folder is the folder's parent's (the move looks
+  // through a folder only for a place strictly inside it).
+  int past_the_folder = 0;
+  for (const tabs::TabInterface* const each : outermost->GetTabsRecursive()) {
+    past_the_folder = std::max(past_the_folder, GetIndexOfTab(each) + 1);
+  }
+  MoveTabsAndSetPropertiesImpl(indices, past_the_folder, std::nullopt,
+                               /*pinned=*/false, /*folder=*/nullptr);
+}
