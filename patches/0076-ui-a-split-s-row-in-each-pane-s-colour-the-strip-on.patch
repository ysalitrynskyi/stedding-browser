+      gfx::Point probe = end.CenterPoint();
+      views::View::ConvertPointToTarget(view()->multi_contents_view(), view(),
+                                        &probe);
+      return canvas.GetBitmap().getColor(
+                 probe.x(), static_cast<int>(toolbar.CenterPoint().y())) ==
+             *row()->color();
+    }));
+  }
+}
