@@ -0,0 +1,47 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_PIN_STORE_FACTORY_H_
+#define CHROME_BROWSER_UI_SPACES_PIN_STORE_FACTORY_H_
+
+#include "base/no_destructor.h"
+#include "chrome/browser/profiles/profile_keyed_service_factory.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace spaces {
+
+class PinStore;
+
+// windows G2 (ADR 0035): one pin store per regular profile, beside its Space
+// registry; none for a private profile, whose windows have no Spaces.
+class PinStoreFactory : public ProfileKeyedServiceFactory {
+ public:
+  static PinStore* GetForProfile(Profile* profile);
+  static PinStoreFactory* GetInstance();
+
+ private:
+  friend base::NoDestructor<PinStoreFactory>;
+  PinStoreFactory();
+  ~PinStoreFactory() override;
+
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override;
+};
+
+// windows G17 (ADR 0035): `window`'s own tab of the pin or essential that
+// `tab`, another window's tab, is a tab of: a record of the profile's store,
+// in a window that shows the store's records. Null when `tab` is no record's
+// or `window` has no tab of it.
+tabs::TabInterface* OwnTabOfRecord(BrowserWindowInterface* window,
+                                   const tabs::TabInterface* tab);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_PIN_STORE_FACTORY_H_
diff --git a/chrome/browser/ui/spaces/pin_store_unittest.cc b/chrome/browser/ui/spaces/pin_store_unittest.cc
new file mode 100644
index 0000000000000..0328e70f536b8
--- /dev/null
+++ b/chrome/browser/ui/spaces/pin_store_unittest.cc
@@ -0,0 +1,353 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/pin_store.h"
+
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/scoped_observation.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/token.h"
+#include "base/values.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+using ::testing::ElementsAre;
+
+SpaceId NewSpace() {
+  return SpaceId::FromRawToken(base::Token::CreateRandom());
+}
+
+PinRecord Pin(const std::string& id, const SpaceId& space, const char* home) {
+  PinRecord record;
+  record.id = id;
+  record.tier = PinTier::kSpacePin;
+  record.space = space;
+  record.has_space = true;
+  record.home = GURL(home);
+  return record;
+}
+
+PinRecord Essential(const std::string& id, const char* home) {
+  PinRecord record;
+  record.id = id;
+  record.tier = PinTier::kEssential;
+  record.home = GURL(home);
+  return record;
+}
+
+std::vector<std::string> Ids(const PinStore& store) {
+  std::vector<std::string> ids;
+  for (const PinRecord& record : store.records()) {
+    ids.push_back(record.id);
+  }
+  return ids;
+}
+
+// A window that changed every record it has.
+void PublishAll(PinStore& store,
+                const std::vector<PinRecord>& records,
+                const std::set<std::string>& removed) {
+  std::vector<std::string> order;
+  for (const PinRecord& record : records) {
+    order.push_back(record.id);
+  }
+  store.Publish(order, records, removed);
+}
+
+class Counter : public PinStore::Observer {
+ public:
+  void OnPinStoreChanged() override { ++changes; }
+  int changes = 0;
+};
+
+class PinStoreTest : public testing::Test {
+ protected:
+  PinStoreTest() {
+    prefs_.registry()->RegisterListPref(stedding::prefs::kPinStore);
+    prefs_.registry()->RegisterBooleanPref(stedding::prefs::kPinStoreReady,
+                                           false);
+  }
+
+  // A store already filled with `records`, as after G19's first launch.
+  void Ready(PinStore& store, const std::vector<PinRecord>& records) {
+    store.Fill({records});
+  }
+
+  TestingPrefServiceSimple prefs_;
+};
+
+// windows G2: every field of a record comes back from the preference.
+TEST_F(PinStoreTest, RoundTripsThroughThePreference) {
+  const SpaceId work = NewSpace();
+  {
+    PinStore store(&prefs_);
+    PinRecord pin = Pin("a", work, "https://mail.example/");
+    pin.name = u"Mail";
+    pin.title = u"Inbox (3)";
+    pin.folder_path = R"([{"id":"f","title":"Work"}])";
+    pin.separator = true;
+    PinRecord local = Pin("l", work, "");
+    local.page = GURL("file:///notes.txt");
+    PinRecord own = Essential("b", "https://calendar.example/");
+    own.space = work;
+    own.has_space = true;
+    Ready(store, {pin, own, Essential("c", "https://chat.example/"), local});
+  }
+  PinStore again(&prefs_);
+  EXPECT_TRUE(again.ready());
+  ASSERT_EQ(4u, again.records().size());
+  EXPECT_EQ(GURL("file:///notes.txt"), again.records()[3].page);
+  EXPECT_FALSE(again.records()[3].home.is_valid());
+  EXPECT_FALSE(again.records()[0].page.is_valid());
+  const PinRecord& pin = again.records()[0];
+  EXPECT_EQ("a", pin.id);
+  EXPECT_EQ(PinTier::kSpacePin, pin.tier);
+  EXPECT_EQ(work, pin.space);
+  EXPECT_EQ(GURL("https://mail.example/"), pin.home);
+  EXPECT_EQ(u"Mail", pin.name);
+  EXPECT_EQ(u"Inbox (3)", pin.title);
+  EXPECT_EQ(R"([{"id":"f","title":"Work"}])", pin.folder_path);
+  EXPECT_TRUE(pin.separator);
+  EXPECT_EQ(PinTier::kEssential, again.records()[1].tier);
+  EXPECT_TRUE(again.records()[1].has_space);
+  EXPECT_FALSE(again.records()[2].has_space);
+}
+
+// windows G2: a record the store cannot place is not shown in a wrong Space,
+// and an id is one record.
+TEST_F(PinStoreTest, ADuplicateOrSpacelessRecordIsDropped) {
+  base::ListValue list;
+  list.Append(base::DictValue().Set("id", "a").Set("tier", "pin").Set(
+      "home", "https://a.example/"));
+  list.Append(base::DictValue().Set("id", "b").Set("tier", "essential").Set(
+      "home", "https://b.example/"));
+  list.Append(base::DictValue().Set("id", "b").Set("tier", "essential").Set(
+      "home", "https://other.example/"));
+  const std::vector<PinRecord> records = PinStore::FromValue(list);
+  ASSERT_EQ(1u, records.size());
+  EXPECT_EQ("b", records[0].id);
+  EXPECT_EQ(GURL("https://b.example/"), records[0].home);
+}
+
+// windows G19: two windows that had the same pin show one record, and the
+// later window's tab takes its id.
+TEST_F(PinStoreTest, TheMergeCountsTheSamePinOnce) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  const std::vector<std::map<std::string, std::string>> ids = store.Fill({
+      {Pin("a", work, "https://mail.example/"),
+       Pin("b", work, "https://docs.example/")},
+      {Pin("x", work, "https://docs.example/"),
+       Pin("y", work, "https://chat.example/")},
+  });
+  EXPECT_TRUE(store.ready());
+  EXPECT_THAT(Ids(store), ElementsAre("a", "b", "y"));
+  ASSERT_EQ(2u, ids.size());
+  EXPECT_EQ("b", ids[1].at("x"));
+  EXPECT_EQ("y", ids[1].at("y"));
+  EXPECT_EQ("a", ids[0].at("a"));
+}
+
+// windows G19: the same home in another Space, or as an essential, is a
+// different record; two pins of one home in one window stay two.
+TEST_F(PinStoreTest, OnlyTheSameTierSpaceAndHomeMerge) {
+  const SpaceId work = NewSpace();
+  const SpaceId home = NewSpace();
+  PinStore store(&prefs_);
+  store.Fill({
+      {Pin("a", work, "https://mail.example/"),
+       Pin("b", work, "https://mail.example/")},
+      {Pin("c", home, "https://mail.example/"),
+       Essential("d", "https://mail.example/"),
+       Pin("e", work, "https://mail.example/"),
+       Pin("f", work, "https://mail.example/"),
+       Pin("g", work, "https://mail.example/")},
+  });
+  // e and f are a and b; g is a third pin of that home.
+  EXPECT_THAT(Ids(store), ElementsAre("c", "d", "a", "b", "g"));
+}
+
+// windows G19: a pin only a later window had goes after the row it followed
+// there, and the earlier window's order stays.
+TEST_F(PinStoreTest, ANewRowGoesAfterTheRowItFollowed) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  store.Fill({
+      {Pin("a", work, "https://a.example/"),
+       Pin("b", work, "https://b.example/")},
+      {Pin("x", work, "https://x.example/"),
+       Pin("a2", work, "https://a.example/"),
+       Pin("y", work, "https://y.example/"),
+       Pin("b2", work, "https://b.example/")},
+  });
+  EXPECT_THAT(Ids(store), ElementsAre("x", "a", "y", "b"));
+}
+
+// windows G19: a row with no web home is never matched, and a token two
+// windows share becomes two records with ids of their own.
+TEST_F(PinStoreTest, ARowWithNoWebHomeIsItsOwnRecord) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  const std::vector<std::map<std::string, std::string>> ids = store.Fill({
+      {Pin("a", work, "chrome://settings/")},
+      {Pin("a", work, "chrome://settings/")},
+  });
+  ASSERT_EQ(2u, store.records().size());
+  EXPECT_EQ("a", ids[0].at("a"));
+  EXPECT_NE("a", ids[1].at("a"));
+  EXPECT_EQ(ids[1].at("a"), store.records()[1].id);
+}
+
+// windows G19: the fill happens once, and a profile with nothing to read is
+// ready with no records.
+TEST_F(PinStoreTest, TheFillHappensOnce) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  store.Fill({});
+  EXPECT_TRUE(store.ready());
+  EXPECT_TRUE(store.records().empty());
+  store.Fill({{Pin("a", work, "https://a.example/")}});
+  EXPECT_TRUE(store.records().empty());
+  EXPECT_TRUE(prefs_.GetBoolean(stedding::prefs::kPinStoreReady));
+}
+
+// windows G19: before the fill, a window's publishing changes nothing.
+TEST_F(PinStoreTest, NothingIsPublishedBeforeTheFill) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  PublishAll(store, {Pin("a", work, "https://a.example/")}, {});
+  EXPECT_TRUE(store.records().empty());
+  EXPECT_FALSE(store.ready());
+}
+
+// windows G13: a window's change reaches the store and every observer once.
+TEST_F(PinStoreTest, APublishedChangeTellsEveryWindow) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  Ready(store, {Pin("a", work, "https://a.example/")});
+  Counter counter;
+  base::ScopedObservation<PinStore, PinStore::Observer> watch(&counter);
+  watch.Observe(&store);
+
+  PinRecord renamed = Pin("a", work, "https://a.example/");
+  renamed.name = u"Alpha";
+  PublishAll(store, {renamed}, {});
+  EXPECT_EQ(1, counter.changes);
+  EXPECT_EQ(u"Alpha", store.Find("a")->name);
+
+  // The same again changes nothing and tells nobody.
+  PublishAll(store, {renamed}, {});
+  EXPECT_EQ(1, counter.changes);
+}
+
+// windows G13: a title alone tells no window and waits for the next change
+// to be written.
+TEST_F(PinStoreTest, ATitleAloneTellsNoWindow) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  Ready(store, {Pin("a", work, "https://a.example/")});
+  Counter counter;
+  base::ScopedObservation<PinStore, PinStore::Observer> watch(&counter);
+  watch.Observe(&store);
+
+  PinRecord titled = Pin("a", work, "https://a.example/");
+  titled.title = u"Alpha (2)";
+  PublishAll(store, {titled}, {});
+  EXPECT_EQ(0, counter.changes);
+  EXPECT_EQ(u"Alpha (2)", store.Find("a")->title);
+  EXPECT_TRUE(PinStore::FromValue(prefs_.GetList(stedding::prefs::kPinStore))
+                  .front()
+                  .title.empty());
+
+  // The next real change writes it.
+  titled.name = u"Alpha";
+  PublishAll(store, {titled}, {});
+  EXPECT_EQ(1, counter.changes);
+  EXPECT_EQ(u"Alpha (2)", PinStore::FromValue(prefs_.GetList(
+                                                  stedding::prefs::kPinStore))
+                              .front()
+                              .title);
+}
+
+// windows G15, G16: a record missing from a window's view is not removed;
+// only what the window names as removed goes.
+TEST_F(PinStoreTest, OnlyARemovalRemoves) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  Ready(store, {Pin("a", work, "https://a.example/"),
+                Pin("b", work, "https://b.example/"),
+                Pin("c", work, "https://c.example/")});
+  // A window whose tab of b moved away publishes a and c.
+  PublishAll(store, {Pin("a", work, "https://a.example/"),
+                 Pin("c", work, "https://c.example/")},
+                {});
+  EXPECT_THAT(Ids(store), ElementsAre("a", "b", "c"));
+  // b unpinned there.
+  PublishAll(store, {Pin("a", work, "https://a.example/"),
+                 Pin("c", work, "https://c.example/")},
+                {"b"});
+  EXPECT_THAT(Ids(store), ElementsAre("a", "c"));
+}
+
+// windows G13: the window's order wins for what it has; what it lacks keeps
+// its place after the record it followed.
+TEST_F(PinStoreTest, TheOrderMergesAroundWhatAWindowLacks) {
+  EXPECT_THAT(PinStore::MergeOrder({"a", "b", "c", "d"}, {"c", "a", "d"}, {}),
+              ElementsAre("c", "a", "b", "d"));
+  EXPECT_THAT(PinStore::MergeOrder({"x", "a", "b"}, {"b", "a"}, {}),
+              ElementsAre("x", "b", "a"));
+  EXPECT_THAT(PinStore::MergeOrder({"a", "b", "c"}, {"a", "n", "c"}, {"a"}),
+              ElementsAre("b", "n", "c"));
+  EXPECT_THAT(PinStore::MergeOrder({}, {"n", "m"}, {}), ElementsAre("n", "m"));
+}
+
+// windows G21: a deleted Space's pins move once, after the last record of
+// the Space that takes them; its own essentials stay own only on a Space with
+// a session of its own (ADR 0028).
+TEST_F(PinStoreTest, ADeletedSpacesPinsMoveOnce) {
+  const SpaceId gone = NewSpace();
+  const SpaceId taker = NewSpace();
+  PinRecord own = Essential("e", "https://e.example/");
+  own.space = gone;
+  own.has_space = true;
+  {
+    PinStore store(&prefs_);
+    Ready(store, {Pin("a", gone, "https://a.example/"), own,
+                  Pin("t", taker, "https://t.example/"),
+                  Essential("s", "https://s.example/")});
+    Counter counter;
+    base::ScopedObservation<PinStore, PinStore::Observer> watch(&counter);
+    watch.Observe(&store);
+    store.MoveSpace(gone, taker, /*to_has_own_session=*/false);
+    EXPECT_EQ(1, counter.changes);
+    EXPECT_THAT(Ids(store), ElementsAre("t", "a", "e", "s"));
+    EXPECT_EQ(taker, store.Find("a")->space);
+    EXPECT_EQ(PinTier::kSpacePin, store.Find("e")->tier);
+    EXPECT_EQ(taker, store.Find("e")->space);
+    // Nothing of the deleted Space is left to move.
+    store.MoveSpace(gone, taker, false);
+    EXPECT_EQ(1, counter.changes);
+  }
+  prefs_.ClearPref(stedding::prefs::kPinStore);
+  prefs_.ClearPref(stedding::prefs::kPinStoreReady);
+  PinStore store(&prefs_);
+  Ready(store, {own});
+  store.MoveSpace(gone, taker, /*to_has_own_session=*/true);
+  EXPECT_EQ(PinTier::kEssential, store.Find("e")->tier);
+  EXPECT_EQ(taker, store.Find("e")->space);
+}
