+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+
+#include <utility>
+
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "content/public/browser/web_contents.h"
+
+namespace spaces {
+
+TabSpaceRestoreData::TabSpaceRestoreData(content::WebContents* contents,
+                                         std::string space_id,
+                                         bool space_pinned)
+    : content::WebContentsUserData<TabSpaceRestoreData>(*contents),
+      space_id_(std::move(space_id)),
+      space_pinned_(space_pinned) {}
+
+TabSpaceRestoreData::~TabSpaceRestoreData() = default;
+
+void RestoreSpaceFromExtraData(
+    content::WebContents* web_contents,
+    const std::map<std::string, std::string>& extra_data) {
+  const auto it = extra_data.find(kSessionTabSpaceKey);
+  if (it == extra_data.end() || it->second.empty()) {
+    return;
+  }
+  const auto pin = extra_data.find(kSessionTabSpacePinKey);
+  TabSpaceRestoreData::CreateForWebContents(
+      web_contents, it->second,
+      pin != extra_data.end() && pin->second == "1");
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabSpaceRestoreData);
+
+}  // namespace spaces
