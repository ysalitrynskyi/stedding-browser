+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// A tab entry of the recently-closed list, on `url`, closed by the folder
+// close `batch` of the folder `name`, or by any other close for "".
+std::unique_ptr<sessions::tab_restore::Tab> Closed(const std::string& url,
+                                                   const std::string& batch,
+                                                   const std::string& name) {
+  auto tab = std::make_unique<sessions::tab_restore::Tab>();
+  sessions::SerializedNavigationEntry navigation;
+  navigation.set_virtual_url(GURL(url));
+  tab->navigations.push_back(navigation);
+  if (!batch.empty()) {
+    tab->extra_data[kClosedFolderKey] = batch;
+    tab->extra_data[kClosedFolderNameKey] = name;
+  }
+  return tab;
+}
+
+std::string Urls(const ClosedFolder& folder) {
+  std::string urls;
+  for (const auto& tab : folder.tabs) {
+    urls += std::string(tab->navigations.front().virtual_url().host()) + " ";
+  }
+  return urls;
+}
+
+// PLAN.md TAB-13: the list is newest first. A folder close of a, b, c (in
+// that order) sits under a later plain close; any of its entries finds the
+// whole close, in the folder's order, with the folder's name, and a plain
+// close is no folder's.
+TEST(ClosedFolderTest, AnyEntryOfAFolderCloseFindsItWhole) {
+  sessions::TabRestoreService::Entries entries;
+  entries.push_back(Closed("https://later.test/", "", ""));
+  entries.push_back(Closed("https://c.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://b.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://a.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://earlier.test/", "", ""));
+
+  auto it = entries.begin();
+  EXPECT_EQ(std::nullopt, ClosedFolderAt(entries, it)) << "a plain close";
+  ++it;
+  const std::optional<ClosedFolder> folder = ClosedFolderAt(entries, it);
+  ASSERT_TRUE(folder);
+  EXPECT_EQ("batch-1", folder->batch);
+  EXPECT_EQ(u"Reading", folder->name);
+  EXPECT_EQ("a.test b.test c.test ", Urls(*folder));
+  ++it;
+  ++it;
+  const std::optional<ClosedFolder> from_last = ClosedFolderAt(entries, it);
+  ASSERT_TRUE(from_last);
+  EXPECT_EQ("a.test b.test c.test ", Urls(*from_last));
+  EXPECT_EQ(std::nullopt, ClosedFolderAt(entries, entries.end()));
+}
+
+// Two folder closes stay apart, even of folders with the same name.
+TEST(ClosedFolderTest, TwoClosesOfOneNameStayApart) {
+  sessions::TabRestoreService::Entries entries;
+  entries.push_back(Closed("https://d.test/", "batch-2", "Reading"));
+  entries.push_back(Closed("https://b.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://a.test/", "batch-1", "Reading"));
+
+  const std::optional<ClosedFolder> newer =
+      ClosedFolderAt(entries, entries.begin());
+  ASSERT_TRUE(newer);
+  EXPECT_EQ("d.test ", Urls(*newer));
+  const std::optional<ClosedFolder> older =
+      ClosedFolderAt(entries, std::next(entries.begin()));
+  ASSERT_TRUE(older);
+  EXPECT_EQ("a.test b.test ", Urls(*older));
+}
+
+// folders F19: a split inside the folder is closed as a split entry of its
+// own. It is part of the folder's close: found from it, and its tabs in the
+// folder, in place. A folder holding a split left the split behind.
+TEST(ClosedFolderTest, ASplitClosedWithTheFolderIsPartOfIt) {
+  sessions::TabRestoreService::Entries entries;
+  auto split = std::make_unique<sessions::tab_restore::Split>();
+  split->tabs.push_back(Closed("https://b.test/", "batch-1", "Reading"));
+  split->tabs.push_back(Closed("https://c.test/", "batch-1", "Reading"));
+  entries.push_back(Closed("https://d.test/", "batch-1", "Reading"));
+  entries.push_back(std::move(split));
+  entries.push_back(Closed("https://a.test/", "batch-1", "Reading"));
+
+  for (auto it = entries.begin(); it != entries.end(); ++it) {
+    const std::optional<ClosedFolder> folder = ClosedFolderAt(entries, it);
+    ASSERT_TRUE(folder);
+    EXPECT_EQ("a.test b.test c.test d.test ", Urls(*folder));
+    EXPECT_EQ(u"Reading", folder->name);
+  }
+  EXPECT_EQ("batch-1", ClosedFolderBatchOf(**std::next(entries.begin())));
+}
+
