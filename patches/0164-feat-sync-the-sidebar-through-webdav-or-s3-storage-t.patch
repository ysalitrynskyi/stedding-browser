+// Sf43-Sf46: the rows, and a form that opens empty and leads only to a test.
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceTest, TheFormOpensEmptyAndTheTestWaits) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  const bool s3 = GetParam() == PlaceKind::kS3;
+  const std::string script = base::StrCat(
+      {R"(
+    (async () => {
+      const deep = (root, selector) => {
+        const found = root.querySelector(selector);
+        if (found) {
+          return found;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          const inner =
+              element.shadowRoot && deep(element.shadowRoot, selector);
+          if (inner) {
+            return inner;
+          }
+        }
+        return null;
+      };
+      const wait = async what => {
+        for (let i = 0; i < 200; ++i) {
+          const value = what();
+          if (value) {
+            return value;
+          }
+          await new Promise(done => setTimeout(done, 25));
+        }
+        return null;
+      };
+      const section = await wait(
+          () => deep(document, 'settings-stedding-sync-section'));
+      const button = await wait(
+          () => section.shadowRoot.querySelector('#syncSetUp-)",
+       s3 ? "s3" : "webdav", R"('));
+      button.click();
+      await section.updateComplete;
+      const root = section.shadowRoot;
+      const dialog = root.querySelector('#placeDialog');
+      const inputs = [...dialog.querySelectorAll('cr-input')];
+      const test = root.querySelector('#placeTest');
+      const out = [dialog.open, inputs.length,
+                   inputs.every(input => input.value === ''),
+                   test.disabled];
+      const fill = async (name, value) => {
+        const input = dialog.querySelector(`[data-field="${name}"]`);
+        input.value = value;
+        input.dispatchEvent(new Event('input', {bubbles: true}));
+        await input.updateComplete;
+      };
+      const send = {)",
+       s3 ? R"(endpoint: 'http://public.example.net/', region: 'r',
+                     bucket: 'a-bucket', accessKey: 'k', secretKey: 's')"
+          : R"(address: 'http://public.example.net/', user: 'u',
+                     password: 'p')",
+       R"(};
+      for (const [name, value] of Object.entries(send)) {
+        await fill(name, value);
+      }
+      await wait(() => section.shadowRoot.querySelector('#placeProblem'));
+      out.push(test.disabled, !!root.querySelector('#placeProblem'));
+      await fill()",
+       s3 ? "'endpoint'" : "'address'", R"(, 'http://192.168.1.2/');
+      await wait(() => !test.disabled);
+      out.push(test.disabled, !!root.querySelector('#placeNote'));
+      root.querySelector('#placeDialog .cancel-button').click();
+      await wait(() => !dialog.open);
+      await wait(() => Object.keys(section.placeForm_).length === 0);
+      out.push(dialog.open, Object.keys(section.placeForm_).length);
+      return out.join(' ');
+    })()
+  )"});
+  EXPECT_EQ(base::StrCat({"true ", s3 ? "6" : "3",
+                          " true true true true false true false 0"}),
+            content::EvalJs(page, script));
+}
