#!/usr/bin/env bash
# Configure and build Chromium from the pinned checkout.
#
# Usage:
#   tooling/build-chromium [release|debug|official] [ninja target ...]
#
#   tooling/build-chromium                  # release build of the browser
#   tooling/build-chromium official          # shipping configuration
#   tooling/build-chromium release chrome unit_tests
#   tooling/build-chromium release chrome --budget 45   # allow 45 minutes; 0 = unlimited
#
# Budget: a build gets 15 minutes of wall clock by default. Every minute the
# wrapper prints elapsed time, object count and active compilers, and when the
# budget runs out it kills the build and says so. Anything longer is a decision
# an agent must not make alone: ask the operator, then pass --budget explicitly.
# This exists because a 3.5 h vanilla build once ran with nobody watching but
# a sleep loop (docs/HANDOFF.md, trap 5).
#
# gn args come from tooling/args/<config>.gn and are copied verbatim into the output
# directory, so the args used for any build are recoverable from the build itself.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

# NOTE: the body lives in main() and is called on the last line. bash reads a script
# incrementally, by byte offset, as it executes — so editing a script while it is
# running makes the live shell resume mid-file and die on a syntax error. Wrapping the
# body means bash parses all of it before running any of it, which makes the script
# safe to edit during a multi-hour build. This is not a style choice; it cost us a
# completed Chromium build whose result went unnoticed for three hours.
main() {

    require_macos_arm64
    add_depot_tools_to_path

    BUDGET_MIN="${STEDDING_BUILD_BUDGET_MIN:-15}"
    positional=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --budget) shift; BUDGET_MIN="${1:?--budget needs minutes}" ;;
        --budget=*) BUDGET_MIN="${1#--budget=}" ;;
        *) positional+=("$1") ;;
      esac
      shift
    done
    set -- "${positional[@]}"
    case "$BUDGET_MIN" in ''|*[!0-9]*) die "--budget takes whole minutes, got '$BUDGET_MIN'" ;; esac

    CONFIG="${1:-release}"
    shift || true
    TARGETS=("$@")
    [ "${#TARGETS[@]}" -eq 0 ] && TARGETS=(chrome)

    ARGS_FILE="$STEDDING_ROOT/tooling/args/$CONFIG.gn"
    [ -f "$ARGS_FILE" ] || die "no gn args for config '$CONFIG' (expected $ARGS_FILE)"
    [ -d "$CHROMIUM_SRC" ] || die "no checkout at $CHROMIUM_SRC — run tooling/sync-chromium"
    require_no_ancestor_node_modules "$CHROMIUM_ROOT"

    # The sync-time floor covered the checkout. A build writes tens of GB more, and
    # running the volume dry three hours in wastes the whole run. Measured output sizes
    # are in docs/ARCHITECTURE.md.
    require_free_gb "$CHROMIUM_ROOT" 60

    OUT_DIR="out/$CONFIG"
    ABS_OUT="$CHROMIUM_SRC/$OUT_DIR"

    cd "$CHROMIUM_SRC" || die "cannot enter $CHROMIUM_SRC"

    # A build whose provenance is unclear is worse than no build. Two trees are legitimate:
    # vanilla at the pin, and the patch series applied on top of the pin. Anything else —
    # a stray branch, a different pin, upstream commits mixed in — is refused.
    #
    # Note what this must NOT do: tell someone with a patched tree to run sync-chromium.
    # That resets to vanilla and destroys the branch they are working on.
    head_commit="$(git rev-parse HEAD)"
    tag_commit="$(git rev-parse "refs/tags/$CHROMIUM_TAG^{commit}" 2>/dev/null || echo unknown)"
    patch_count=0

    if [ "$head_commit" = "$tag_commit" ]; then
      log "tree:    vanilla, at the pin"
    elif [ "$tag_commit" != unknown ] \
         && [ "$(git merge-base "$head_commit" "$tag_commit")" = "$tag_commit" ]; then
      patch_count="$(git rev-list --count "$tag_commit..$head_commit")"
      branch="$(git rev-parse --abbrev-ref HEAD)"
      log "tree:    $branch, $patch_count commit(s) on top of the pin"
    else
      die "the checkout is at $head_commit, which is neither the pin $CHROMIUM_TAG
         ($tag_commit) nor a descendant of it.

         If this is a vanilla tree that has drifted:  tooling/sync-chromium
         If you have patches here, do NOT run that — it resets to vanilla and takes your
         branch with it. Rebase onto the pin instead, or export the series first with
         tooling/update-patches."
    fi

    log "config:  $CONFIG"
    log "src:     $CHROMIUM_SRC @ $CHROMIUM_TAG"
    log "out:     $ABS_OUT"
    log "targets: ${TARGETS[*]}"

    mkdir -p "$ABS_OUT"

    # Two builds in one output directory corrupt each other: the second `gn gen` rewrites
    # the ninja files under the first one's feet. Hold a lock naming the owning process,
    # and treat a lock whose process is gone as stale rather than as a permanent block.
    # mkdir is atomic, so acquiring the lock cannot race the way a test-then-write
    # does. The pid inside is for reporting and staleness only.
    LOCK="$ABS_OUT/.stedding-build.lock.d"
    if ! mkdir "$LOCK" 2>/dev/null; then
      other="$(cat "$LOCK/pid" 2>/dev/null || echo)"
      # A live pid is not enough: pids get reused, and the number that once meant a
      # build may now be somebody's editor. Require it to still be a build-chromium.
      if [ -n "$other" ] && kill -0 "$other" 2>/dev/null \
         && ps -o command= -p "$other" 2>/dev/null | grep -q 'build-chromium'; then
        die "a build is already running in $ABS_OUT (pid $other).
     Wait for it, or stop it with: kill $other"
      fi
      warn "removing a stale lock from pid ${other:-unknown}"
      rm -rf "$LOCK"
      mkdir "$LOCK" 2>/dev/null || die "cannot create the build lock at $LOCK"
    fi
    echo $$ > "$LOCK/pid"
    # shellcheck disable=SC2064  # expand $LOCK now, not at trap time
    trap "rm -rf '$LOCK'" EXIT INT TERM

    cp "$ARGS_FILE" "$ABS_OUT/args.gn"

    log "gn gen"
    gn gen "$OUT_DIR"

    log "resolved gn args:"
    gn args "$OUT_DIR" --list --short --overrides-only | sed 's/^/    /' >&2

    # Fingerprint the source tree so we can tell afterwards whether it moved
    # under the build. siso stats the tree once, near the start; a source edited
    # during or after that pass is silently left out of the build, and the only
    # symptom is a binary that does not match the source. That cost hours once:
    # three constants were edited a few minutes after a build started, the build
    # succeeded, and the running browser simply did not have them.
    tree_fingerprint() {
      ( cd "$CHROMIUM_SRC" && git status --porcelain && git rev-parse HEAD ) \
        | shasum | cut -d' ' -f1
    }
    before="$(tree_fingerprint)"

    start=$(date +%s)
    if [ "$BUDGET_MIN" -eq 0 ]; then
      log "autoninja -C $OUT_DIR ${TARGETS[*]}  (no budget: the operator said so)"
    else
      log "autoninja -C $OUT_DIR ${TARGETS[*]}  (budget: $BUDGET_MIN min; progress every minute)"
    fi
    autoninja -C "$OUT_DIR" "${TARGETS[@]}" &
    build_pid=$!
    build_status=""
    first_objects=""
    while kill -0 "$build_pid" 2>/dev/null; do
      sleep 60
      kill -0 "$build_pid" 2>/dev/null || break
      elapsed=$(( $(date +%s) - start ))
      objects="$(find "$ABS_OUT/obj" -name '*.o' 2>/dev/null | wc -l | tr -d ' ')"
      compilers="$(pgrep -c -f 'llvm-build/Release\+Asserts/bin/clang' 2>/dev/null || echo 0)"
      log "progress: $((elapsed / 60)) min, $objects objects, $compilers compilers"
      [ -n "$first_objects" ] || first_objects="$objects"
      if [ "$BUDGET_MIN" -gt 0 ] && [ "$elapsed" -ge $((BUDGET_MIN * 60)) ]; then
        warn "build budget of $BUDGET_MIN min exceeded at $objects objects; stopping it."
        kill "$build_pid" 2>/dev/null
        pkill -f "siso ninja .* -C $OUT_DIR" 2>/dev/null || true
        wait "$build_pid" 2>/dev/null || true
        if [ "$objects" != "$first_objects" ] || [ "$compilers" != "0" ]; then
          die "stopped by the budget while still making progress; a rerun resumes where it stopped. Ask the operator, then rerun with --budget <minutes> (0 = unlimited)."
        fi
        die "stopped by the budget with no object count moving and no compiler running: treat as stuck, not slow. Look at $OUT_DIR/siso.INFO before rerunning."
      fi
    done
    wait "$build_pid" || build_status=$?
    [ -z "$build_status" ] || die "autoninja failed (exit $build_status)"
    end=$(date +%s)

    if [ "$(tree_fingerprint)" != "$before" ]; then
      warn "the source tree changed while this build was running."
      warn "siso stats sources once, near the start, so edits made after that are"
      warn "NOT in this binary even though the build succeeded. Build again before"
      warn "trusting what you see."
    fi

    elapsed=$(( end - start ))
    log "build finished in $(( elapsed / 3600 ))h $(( (elapsed % 3600) / 60 ))m $(( elapsed % 60 ))s"

    APP="$(find_app_bundle "$ABS_OUT" || true)"
    if [ -n "$APP" ] && [ -d "$APP" ]; then
      log "app:  $APP"
      log "size: $(du -sh "$APP" | cut -f1)"
      log "run:  open '$APP'"
    fi

}

main "$@"