+std::u16string TextUnder(views::View* view) {
+  std::u16string text;
+  if (const auto* const label = views::AsViewClass<views::Label>(view)) {
+    text += std::u16string(label->GetText()) + u"\n";
+  } else if (const auto* const styled =
+                 views::AsViewClass<views::StyledLabel>(view)) {
+    text += std::u16string(styled->GetText()) + u"\n";
+  }
+  for (views::View* const child : view->children()) {
+    text += TextUnder(child);
+  }
+  return text;
