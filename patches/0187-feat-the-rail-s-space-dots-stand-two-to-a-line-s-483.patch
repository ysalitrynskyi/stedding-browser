+// sidebar Y13, Y56 (BACKLOG S-483): the rail's stack, down the column in the
+// children's order, each where SwitcherStackPlaces puts it: a full chip and
+// the "+" centred with their margins above and below, the dots of a run two
+// to a line. A vertical FlexLayout stacked every dot on a line of its own.
+class SwitcherStackLayout : public views::LayoutManagerBase {
+ protected:
+  views::ProposedLayout CalculateProposedLayout(
+      const views::SizeBounds& size_bounds) const override {
+    std::vector<views::View*> children;
+    std::vector<SwitcherStackItem> items;
+    int widest = 0;
+    for (views::View* const child : host_view()->children()) {
+      if (!IsChildIncludedInLayout(child)) {
+        continue;
+      }
+      const gfx::Size size = child->GetPreferredSize({});
+      const gfx::Insets* const margins = child->GetProperty(views::kMarginsKey);
+      items.push_back({size, margins ? margins->top() : 0,
+                       margins ? margins->bottom() : 0});
+      children.push_back(child);
+      widest = std::max(widest, size.width());
+    }
+    const int width =
+        size_bounds.width().is_bounded() ? size_bounds.width().value() : widest;
+    const std::vector<gfx::Rect> places = SwitcherStackPlaces(items, width);
+    views::ProposedLayout layout;
+    int bottom = 0;
+    for (size_t i = 0; i < children.size(); ++i) {
+      layout.child_layouts.push_back(
+          {children[i], true, places[i], views::SizeBounds(places[i].size())});
+      bottom = std::max(bottom, places[i].bottom() + items[i].margin_below);
+    }
+    layout.host_size = gfx::Size(width, bottom);
+    return layout;
+  }
+};
