+// The list of closed tabs as far as these tests need it: what it is given
+// goes behind what it holds, as many as it has room for, as the list's own
+// AddClosedTabs does.
+class ClosedListW2B09 : public MockTabRestoreService {
+ public:
+  ClosedListW2B09() {
+    ON_CALL(*this, IsLoaded()).WillByDefault(testing::Return(true));
+    ON_CALL(*this, entries()).WillByDefault(testing::ReturnRef(held_));
+  }
+
+  void AddClosedTabs(
+      std::vector<std::unique_ptr<sessions::tab_restore::Tab>> tabs,
+      std::vector<SessionID>* added) override {
+    const size_t room =
+        static_cast<size_t>(sessions::TabRestoreServiceHelper::kMaxEntries);
+    for (std::unique_ptr<sessions::tab_restore::Tab>& tab : tabs) {
+      if (held_.size() >= room) {
+        return;
+      }
+      added->push_back(tab->id);
+      held_.push_back(std::move(tab));
+    }
+  }
+
+  // The person restored or forgot every row: the list has room again.
+  void Empty() { held_.clear(); }
+  const Entries& held() const { return held_; }
+
+ private:
+  Entries held_;
+};
