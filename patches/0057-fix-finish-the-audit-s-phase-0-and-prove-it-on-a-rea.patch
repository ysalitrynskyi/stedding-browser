@@ -0,0 +1,182 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/rename_field_watcher.h"
+
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/run_loop.h"
+#include "base/time/time.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/events/event.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/events/event_constants.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/test/views_test_base.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace stedding {
+namespace {
+
+// A view that takes presses and never the focus, as a tab row does.
+class PressedView : public views::View {
+  METADATA_HEADER(PressedView, views::View)
+
+ public:
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    ++presses;
+    return true;
+  }
+  int presses = 0;
+};
+
+BEGIN_METADATA(PressedView)
+END_METADATA
+
+// A window with a rename field and two other views: one that takes the focus
+// and one that does not, as a tab row does not.
+class RenameFieldWatcherTest : public views::ViewsTestBase {
+ protected:
+  void SetUp() override {
+    views::ViewsTestBase::SetUp();
+    widget_ = CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    widget_->SetBounds(gfx::Rect(0, 0, 300, 120));
+    auto contents = std::make_unique<views::View>();
+    field_ = contents->AddChildView(std::make_unique<views::Textfield>());
+    field_->SetBounds(0, 0, 300, 30);
+    focusable_ = contents->AddChildView(std::make_unique<views::View>());
+    focusable_->SetBounds(0, 40, 300, 30);
+    focusable_->SetFocusBehavior(views::View::FocusBehavior::ALWAYS);
+    row_ = contents->AddChildView(std::make_unique<PressedView>());
+    row_->SetBounds(0, 80, 300, 30);
+    widget_->SetContentsView(std::move(contents));
+    widget_->Show();
+
+    watcher_ = std::make_unique<RenameFieldWatcher>(
+        field_, base::BindRepeating(&RenameFieldWatcherTest::WalkedAway,
+                                    base::Unretained(this)));
+  }
+
+  void TearDown() override {
+    watcher_.reset();
+    field_ = nullptr;
+    focusable_ = nullptr;
+    row_ = nullptr;
+    widget_.reset();
+    views::ViewsTestBase::TearDown();
+  }
+
+  // What the owners do: show the field and give it the focus.
+  void BeginRename() {
+    field_->SetVisible(true);
+    field_->RequestFocus();
+    ASSERT_TRUE(field_->HasFocus());
+  }
+
+  void PressAt(const views::View* view) {
+    gfx::Point point = view->GetLocalBounds().CenterPoint();
+    views::View::ConvertPointToWidget(view, &point);
+    ui::MouseEvent press(ui::EventType::kMousePressed, point, point,
+                         base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+                         ui::EF_LEFT_MOUSE_BUTTON);
+    widget_->OnMouseEvent(&press);
+    ui::MouseEvent release(ui::EventType::kMouseReleased, point, point,
+                           base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+                           ui::EF_LEFT_MOUSE_BUTTON);
+    widget_->OnMouseEvent(&release);
+  }
+
+  void Settle() { base::RunLoop().RunUntilIdle(); }
+
+  void WalkedAway() {
+    ++walked_away_;
+    // As the owners do: the rename ends and the field hides.
+    field_->SetVisible(false);
+  }
+
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::Textfield> field_ = nullptr;
+  raw_ptr<views::View> focusable_ = nullptr;
+  raw_ptr<PressedView> row_ = nullptr;
+  std::unique_ptr<RenameFieldWatcher> watcher_;
+  int walked_away_ = 0;
+};
+
+TEST_F(RenameFieldWatcherTest, APressOnARowEndsTheRenameAndStillReachesIt) {
+  BeginRename();
+  PressAt(row_);
+  EXPECT_EQ(1, row_->presses) << "the press must still reach the row";
+  Settle();
+  EXPECT_EQ(1, walked_away_);
+  EXPECT_FALSE(field_->GetVisible());
+}
+
+TEST_F(RenameFieldWatcherTest, APressInTheFieldKeepsTheRename) {
+  BeginRename();
+  PressAt(field_);
+  Settle();
+  EXPECT_EQ(0, walked_away_);
+  EXPECT_TRUE(field_->GetVisible());
+}
+
+TEST_F(RenameFieldWatcherTest, TheFocusMovingElsewhereEndsTheRename) {
+  BeginRename();
+  focusable_->RequestFocus();
+  ASSERT_TRUE(focusable_->HasFocus());
+  Settle();
+  EXPECT_EQ(1, walked_away_);
+}
+
+TEST_F(RenameFieldWatcherTest, AWindowGoingInactiveKeepsTheRename) {
+  BeginRename();
+  views::FocusManager* const focus_manager = field_->GetFocusManager();
+  focus_manager->StoreFocusedView(/*clear_native_focus=*/true);
+  ASSERT_FALSE(field_->HasFocus());
+  Settle();
+  EXPECT_EQ(0, walked_away_);
+  EXPECT_TRUE(field_->GetVisible());
+
+  ASSERT_TRUE(focus_manager->RestoreFocusedView());
+  EXPECT_TRUE(field_->HasFocus()) << "the rename resumes where it was";
+}
+
+TEST_F(RenameFieldWatcherTest, AClosedRenameIgnoresPressesAndFocus) {
+  field_->SetVisible(false);
+  PressAt(row_);
+  focusable_->RequestFocus();
+  Settle();
+  EXPECT_EQ(0, walked_away_);
+}
+
+TEST_F(RenameFieldWatcherTest, EndingTheRenameRunsTheCallbackOnce) {
+  BeginRename();
+  // A press elsewhere that also takes the focus: both would end the rename,
+  // and the second must find it already ended.
+  PressAt(row_);
+  focusable_->RequestFocus();
+  Settle();
+  EXPECT_EQ(1, walked_away_);
+
+  // Enter or Escape in the owner hides the field while it has the focus.
+  BeginRename();
+  field_->SetVisible(false);
+  Settle();
+  EXPECT_EQ(1, walked_away_) << "a rename the owner ended is not walked away";
+}
+
+TEST_F(RenameFieldWatcherTest, TheWatcherCanGoBeforeItsField) {
+  BeginRename();
+  PressAt(row_);
+  watcher_.reset();
+  Settle();
+  EXPECT_EQ(0, walked_away_);
+}
+
+}  // namespace
+}  // namespace stedding
