+void TabStripCollectionController::CloseFolderTabs(
+    tabs::FolderTabCollection* folder) {
+  if (!folder) {
+    return;
+  }
+  // The list is a copy: each close shifts the indices, so look every tab up
+  // again; the folder leaves the tree with its last tab.
+  for (tabs::TabInterface* const tab : folder->GetTabsRecursive()) {
+    const int index = model_->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      model_->CloseWebContentsAt(
+          index, TabCloseTypes::CLOSE_USER_GESTURE |
+                     TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+}
