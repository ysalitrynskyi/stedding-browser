+void TabView::UpdateLocalMark() {
+  // local tabs Lt1, Lt13, Lt14: the sidebar's rows alone, while the setting
+  // is on; the horizontal strip shares this view and marks nothing.
+  bool local = false;
+  if (orientation_ == TabStripOrientation::kVertical &&
+      base::FeatureList::IsEnabled(stedding::kArcStyleWindow) &&
+      stedding::IsLocalPage(tab_data_.last_committed_url)) {
+    tabs::TabInterface* const tab =
+        const_cast<tabs::TabInterface*>(GetTabInterface());
+    BrowserWindowInterface* const window =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    Profile* const profile = window ? window->GetProfile() : nullptr;
+    local = profile &&
+            profile->GetPrefs()->GetBoolean(stedding::prefs::kMarkLocalTabs);
+  }
+  const std::u16string host =
+      local ? stedding::LocalHostLine(tab_data_.last_committed_url)
+            : std::u16string();
+  std::u16string untitled =
+      local ? stedding::UntitledLocalTitle(tab_data_.last_committed_url)
+            : std::u16string();
+  if (untitled != untitled_title_) {
+    untitled_title_ = std::move(untitled);
+    InvalidateLayout();
+  }
+  if (local == local_ && (!host_line_ || host_line_->GetText() == host)) {
+    return;
+  }
+  const bool was_local = local_;
+  local_ = local;
+
+  if (local_ && !host_line_) {
+    auto line = std::make_unique<views::Label>();
+    line->SetVisible(false);
+    // As the title is drawn (TabTitle): its alignment, so the line follows
+    // it in a right-to-left layout, and no colour of its own choosing.
+    line->SetHorizontalAlignment(gfx::ALIGN_TO_HEAD);
+    // The head goes first, so a narrow split pane keeps the port.
+    line->SetElideBehavior(gfx::ELIDE_HEAD);
+    line->SetHandlesTooltips(false);
+    line->SetAutoColorReadabilityEnabled(false);
+    line->SetBackgroundColor(SK_ColorTRANSPARENT);
+    line->SetCanProcessEventsWithinSubtree(false);
+    // On the ground the sidebar paints: no opaque region under the text, so
+    // grayscale text, and no DCHECK about subpixel text on a transparent one
+    // (docs/HANDOFF.md trap 92).
+    line->SetSkipSubpixelRenderingOpacityCheck(true);
+    line->SetSubpixelRenderingEnabled(false);
+    // The row's description says it (Lt12); the line itself is not read.
+    line->GetViewAccessibility().SetIsIgnored(true);
