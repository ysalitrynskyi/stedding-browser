+      StoragePartitionConfigForProfileId(context, jar);
+  if (!config) {
+    return false;
+  }
+  // Every window of the profile, not only those with Spaces: a popup a page
+  // opened keeps its opener's jar (sessions S11), and a Blank Window has no
+  // registry (2026-10-15).
+  bool in_use = false;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        TabStripModel* const strip = window->GetTabStripModel();
+        if (!strip || window->GetProfile() != context) {
+          return true;
+        }
+        for (int i = 0; i < strip->count(); ++i) {
+          content::WebContents* const contents = strip->GetWebContentsAt(i);
+          if (contents &&
+              StoragePartitionConfigForWebContents(contents) == *config) {
+            in_use = true;
+            return false;
+          }
+        }
+        return true;
+      });
