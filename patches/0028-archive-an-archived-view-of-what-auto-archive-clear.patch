diff --git a/chrome/browser/resources/stedding_archive/app.ts b/chrome/browser/resources/stedding_archive/app.ts
new file mode 100644
index 0000000000000..8dd776bb9e33f
--- /dev/null
+++ b/chrome/browser/resources/stedding_archive/app.ts
@@ -0,0 +1,193 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The archived view (docs/features/archive.md A9): what auto-archive, Clear
+// and a plain close left in Chromium's recently-closed list, by day, filtered
+// by Space, searched, each row restorable to its Space. Plain DOM, as the
+// welcome flow is; buttons and inputs, so the keyboard and VoiceOver come
+// from the DOM.
+/* eslint-disable no-restricted-imports, no-restricted-properties */
+
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+
+interface ArchivedTab {
+  id: string;
+  title: string;
+  url: string;
+  time: number;
+  spaceId: string;
+  spaceName: string;
+  folderPath: string;
+  reason: string;
+}
+
+interface SpaceEntry {
+  id: string;
+  name: string;
+}
+
+interface Snapshot {
+  tabs: ArchivedTab[];
+  spaces: SpaceEntry[];
+}
+
+const state = {
+  tabs: [] as ArchivedTab[],
+  spaces: [] as SpaceEntry[],
+  query: '',
+  space: '',
+};
+
+function el<K extends keyof HTMLElementTagNameMap>(
+    tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  if (className) {
+    node.className = className;
+  }
+  if (text !== undefined) {
+    node.textContent = text;
+  }
+  return node;
+}
+
+function dayOf(ms: number): string {
+  const when = new Date(ms);
+  const today = new Date();
+  const yesterday = new Date(today.getTime() - 86400000);
+  if (when.toDateString() === today.toDateString()) {
+    return 'Today';
+  }
+  if (when.toDateString() === yesterday.toDateString()) {
+    return 'Yesterday';
+  }
+  return when.toLocaleDateString(undefined, {weekday: 'long', month: 'long', day: 'numeric'});
+}
+
+function reasonOf(tab: ArchivedTab): string {
+  switch (tab.reason) {
+    case 'auto':
+      return 'archived';
+    case 'clear':
+      return 'cleared';
+    default:
+      return 'closed';
+  }
+}
+
+function hostOf(url: string): string {
+  try {
+    return new URL(url).host || url;
+  } catch (e) {
+    return url;
+  }
+}
+
+function matches(tab: ArchivedTab): boolean {
+  if (state.space && tab.spaceName !== state.space) {
+    return false;
+  }
+  const q = state.query.trim().toLowerCase();
+  if (!q) {
+    return true;
+  }
+  return tab.title.toLowerCase().includes(q) || tab.url.toLowerCase().includes(q);
+}
+
+function render() {
+  const app = document.getElementById('app')!;
+  app.replaceChildren();
+
+  const header = el('header');
+  header.append(el('h1', undefined, 'Archived'));
+  const search = el('input');
+  search.type = 'search';
+  search.placeholder = 'Search title or address';
+  search.value = state.query;
+  search.setAttribute('aria-label', 'Search archived tabs');
+  search.addEventListener('input', () => {
+    state.query = search.value;
+    renderList(list);
+  });
+  header.append(search);
+  const names = new Set<string>();
+  for (const space of state.spaces) {
+    names.add(space.name);
+  }
+  for (const tab of state.tabs) {
+    if (tab.spaceName) {
+      names.add(tab.spaceName);
+    }
+  }
+  const select = el('select');
+  select.setAttribute('aria-label', 'Filter by Space');
+  const all = el('option', undefined, 'All Spaces');
+  all.value = '';
+  select.append(all);
+  for (const name of names) {
+    const option = el('option', undefined, name);
+    option.value = name;
+    option.selected = name === state.space;
+    select.append(option);
+  }
+  select.addEventListener('change', () => {
+    state.space = select.value;
+    renderList(list);
+  });
+  header.append(select);
+  const clear = el('button', undefined, 'Clear archive');
+  clear.addEventListener('click', () => chrome.send('clearArchive'));
+  header.append(clear);
+  app.append(header);
+
+  const list = el('div');
+  renderList(list);
+  app.append(list);
+  search.focus();
+}
+
+function renderList(list: HTMLElement) {
+  list.replaceChildren();
+  const shown = state.tabs.filter(matches);
+  if (shown.length === 0) {
+    list.append(el('p', 'empty',
+        state.tabs.length === 0 ? 'Nothing archived yet. Tabs that auto-archive, that Clear closes and that you close land here.' :
+                                  'Nothing matches.'));
+    return;
+  }
+  let day = '';
+  for (const tab of shown) {
+    const label = dayOf(tab.time);
+    if (label !== day) {
+      day = label;
+      list.append(el('div', 'day', day));
+    }
+    const row = el('div', 'row');
+    const text = el('div', 'text');
+    text.append(el('div', 'title', tab.title || tab.url));
+    const when = new Date(tab.time).toLocaleTimeString(undefined, {hour: 'numeric', minute: '2-digit'});
+    const path = tab.folderPath ? ` · ${tab.folderPath}` : '';
+    text.append(el('div', 'meta', `${hostOf(tab.url)} · ${reasonOf(tab)} ${when}${path}`));
+    row.append(text);
+    if (tab.spaceName) {
+      row.append(el('span', 'space', tab.spaceName));
+    }
+    const restore = el('button', undefined, tab.spaceName ? `Restore to ${tab.spaceName}` : 'Restore');
+    restore.addEventListener('click', () => chrome.send('restoreArchivedTab', [tab.id]));
+    row.append(restore);
+    const remove = el('button', undefined, 'Forget');
+    remove.setAttribute('aria-label', 'Forget this tab');
+    remove.addEventListener('click', () => chrome.send('removeArchivedTab', [tab.id]));
+    row.append(remove);
+    list.append(row);
+  }
+}
+
+function apply(snapshot: Snapshot) {
+  state.tabs = snapshot.tabs;
+  state.spaces = snapshot.spaces;
+  render();
+}
+
+addWebUiListener('archive-changed', (snapshot: unknown) => apply(snapshot as Snapshot));
+sendWithPromise('getArchivedTabs').then((snapshot: unknown) => apply(snapshot as Snapshot));
