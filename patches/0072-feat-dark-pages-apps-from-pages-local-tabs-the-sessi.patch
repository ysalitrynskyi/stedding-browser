+
+float LocalTapeDashInterval(float width, float height, float radius) {
+  // Skia shrinks corners that do not fit; so does the perimeter here.
+  const float r = std::clamp(radius, 0.0f, std::min(width, height) / 2);
+  // The four straight runs, and the four quarter circles that join them.
+  const float straight = 2 * (width + height) - 8 * r;
+  const float corners = 2 * std::numbers::pi_v<float> * r;
+  const float perimeter = straight + corners;
+  if (perimeter <= 0) {
+    return kLocalTapeDash;
+  }
+  const int pairs = std::max(
+      1, static_cast<int>(std::lround(perimeter / (2 * kLocalTapeDash))));
+  return perimeter / (2 * pairs);
+}
