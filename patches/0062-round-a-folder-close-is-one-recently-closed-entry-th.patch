+// Stedding: a child destroyed outright, not animated out, while an animation
+// runs, and then more layouts: the manager keeps no pointer to it, so on a
+// build with the dangling-pointer detector nothing is reported. Closing a
+// folder's tabs destroyed rows the lookup maps still named, and the Mac's
+// checked build reported each pointer when the next layout replaced the maps
+// (2026-10-13). On other builds the test only shows that nothing crashes.
+TEST_P(TabCollectionAnimatingLayoutManagerTest,
+       AChildDestroyedOutrightLeavesNoPointerBehind) {
+  widget()->SetBounds(gfx::Rect(0, 0, 100, 100));
+  host_view()->AddChildView(std::make_unique<views::View>());
+  views::View* const doomed =
+      host_view()->AddChildView(std::make_unique<views::View>());
+  widget()->LayoutRootViewIfNecessary();
+  // A third child starts an animation: the manager holds every child.
+  host_view()->AddChildView(std::make_unique<views::View>());
+  widget()->LayoutRootViewIfNecessary();
+  host_view()->RemoveChildViewT(doomed);
+  // More layouts replace what the manager held.
+  host_view()->AddChildView(std::make_unique<views::View>());
+  widget()->LayoutRootViewIfNecessary();
+  task_environment()->FastForwardBy(base::Seconds(1));
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_EQ(3u, host_view()->children().size());
+}
