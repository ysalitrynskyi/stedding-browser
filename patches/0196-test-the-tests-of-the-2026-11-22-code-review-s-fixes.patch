+// P33-1b; toolbar T64, T32: in a right-to-left UI, with "Show the address
+// row only on hover" on and the sidebar closed, the row the keyboard brings
+// in over the page has its page-coloured surface under it where it is
+// drawn. The surface was taken from the row's place in a left-to-right
+// layout and lay mirrored from the row: under the window's buttons or the
+// traffic lights at one end, and missing under the row's other end, which
+// stood on the window's ground.
+IN_PROC_BROWSER_TEST_F(RightToLeftRowW2B25Test,
+                       OverThePageTheRowsBarLiesUnderTheRow) {
+  ASSERT_TRUE(base::i18n::IsRTL());
+#if BUILDFLAG(IS_MAC)
+  // BACKLOG S-558: on the Mac a right-to-left window with the sidebar hidden
+  // and the row hidden keeps a band of the lights' height above the page,
+  // where sidebar Y55 has the page run to the window's top; the row's bar is
+  // checked on Windows until that is fixed.
+  if (base::i18n::IsRTL()) {
+    GTEST_SKIP() << "BACKLOG S-558";
+  }
+#endif
+  prefs()->SetInteger(stedding::prefs::kSidebarClosedForm,
+                      stedding::prefs::kSidebarClosedHidden);
+  prefs()->SetBoolean(stedding::prefs::kToolbarHideInCompact, true);
+  if (!controller()->IsCollapsed()) {
+    controller()->RequestCollapse(true);
+  }
+  ASSERT_NO_FATAL_FAILURE(Settle());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return !browser_view()->IsToolbarVisible();
+  })) << "the row stayed with the sidebar closed";
+  // The page takes the window's top. On Windows the frame gives its caption
+  // buttons up a turn later.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return base::ClampRound(
+               InWindowW2B25(browser_view(),
+                             browser_view()->contents_container())
+                   .y()) ==
+           VerticalTabStripRegionView::SteddingCardGutter(browser_view());
+  })) << "the page does not take the window's top: it starts at "
+      << InWindowW2B25(browser_view(), browser_view()->contents_container())
+             .ToString()
+      << ", the card's gutter is "
+      << VerticalTabStripRegionView::SteddingCardGutter(browser_view())
+      << ", the row shows " << browser_view()->IsToolbarVisible();
+
+  // Move the focus to the toolbar: the row comes in over the page.
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_FOCUS_TOOLBAR));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return browser_view()->IsToolbarVisible() &&
+           browser_view()->SteddingRowOverPage() && reveal()->Shown() == 1;
+  })) << "the keyboard did not bring the row in over the page";
+  ASSERT_TRUE(RowOffTheMiddle())
