new file mode 100644
index 0000000000000..0a70d250b9df8
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_chord.cc
@@ -0,0 +1,378 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_chord.h"
+
+#include <array>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "build/build_config.h"
+#include "ui/base/accelerators/accelerator.h"
+
+namespace stedding::shortcuts {
+
+namespace {
+
+struct ModifierName {
+  int flag;
+  std::string_view name;
+};
+
+// The order a stored chord writes its modifiers in.
+constexpr std::array<ModifierName, 6> kModifierNames = {{
+    {ui::EF_CONTROL_DOWN, "Ctrl"},
+    {ui::EF_ALT_DOWN, "Alt"},
+    {ui::EF_ALTGR_DOWN, "AltGr"},
+    {ui::EF_SHIFT_DOWN, "Shift"},
+    {ui::EF_COMMAND_DOWN, "Cmd"},
+    {ui::EF_FUNCTION_DOWN, "Fn"},
+}};
+
+struct KeyName {
+  ui::KeyboardCode key;
+  std::string_view name;
+};
+
+// Keys with a name of their own. Letters, digits, F-keys and the number pad's
+// digits are spelled out by range below; every other key code is "VK" and
+// two hex digits, so any key a table binds round-trips.
+constexpr KeyName kKeyNames[] = {
+    {ui::VKEY_LEFT, "Left"},
+    {ui::VKEY_RIGHT, "Right"},
+    {ui::VKEY_UP, "Up"},
+    {ui::VKEY_DOWN, "Down"},
+    {ui::VKEY_TAB, "Tab"},
+    {ui::VKEY_ESCAPE, "Escape"},
+    {ui::VKEY_SPACE, "Space"},
+    {ui::VKEY_RETURN, "Enter"},
+    {ui::VKEY_BACK, "Backspace"},
+    {ui::VKEY_DELETE, "Delete"},
+    {ui::VKEY_INSERT, "Insert"},
+    {ui::VKEY_HOME, "Home"},
+    {ui::VKEY_END, "End"},
+    {ui::VKEY_PRIOR, "PageUp"},
+    {ui::VKEY_NEXT, "PageDown"},
+    {ui::VKEY_OEM_COMMA, "Comma"},
+    {ui::VKEY_OEM_PERIOD, "Period"},
+    {ui::VKEY_OEM_MINUS, "Minus"},
+    {ui::VKEY_OEM_PLUS, "Equal"},
+    {ui::VKEY_OEM_1, "Semicolon"},
+    {ui::VKEY_OEM_2, "Slash"},
+    {ui::VKEY_OEM_3, "Backquote"},
+    {ui::VKEY_OEM_4, "BracketLeft"},
+    {ui::VKEY_OEM_5, "Backslash"},
+    {ui::VKEY_OEM_6, "BracketRight"},
+    {ui::VKEY_OEM_7, "Quote"},
+    {ui::VKEY_ADD, "NumpadAdd"},
+    {ui::VKEY_SUBTRACT, "NumpadSubtract"},
+    {ui::VKEY_MULTIPLY, "NumpadMultiply"},
+    {ui::VKEY_DIVIDE, "NumpadDivide"},
+    {ui::VKEY_DECIMAL, "NumpadDecimal"},
+};
+
+bool InRange(int key, int first, int last) {
+  return key >= first && key <= last;
+}
+
+std::string KeyToken(ui::KeyboardCode key) {
+  const int code = static_cast<int>(key);
+  if (InRange(code, ui::VKEY_A, ui::VKEY_Z) ||
+      InRange(code, ui::VKEY_0, ui::VKEY_9)) {
+    return std::string(1, static_cast<char>(code));
+  }
+  if (InRange(code, ui::VKEY_F1, ui::VKEY_F24)) {
+    return "F" + base::NumberToString(code - ui::VKEY_F1 + 1);
+  }
+  if (InRange(code, ui::VKEY_NUMPAD0, ui::VKEY_NUMPAD9)) {
+    return "Numpad" + base::NumberToString(code - ui::VKEY_NUMPAD0);
+  }
+  for (const KeyName& entry : kKeyNames) {
+    if (entry.key == key) {
+      return std::string(entry.name);
+    }
+  }
+  std::string token = "VK";
+  base::AppendHexEncodedByte(static_cast<uint8_t>(code & 0xFF), token);
+  return token;
+}
+
+std::optional<ui::KeyboardCode> KeyFromToken(std::string_view token) {
+  if (token.size() == 1) {
+    const char c = token[0];
+    if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
+      return static_cast<ui::KeyboardCode>(c);
+    }
+    return std::nullopt;
+  }
+  int number = 0;
+  if (token.size() > 1 && token[0] == 'F' &&
+      base::StringToInt(token.substr(1), &number) && number >= 1 &&
+      number <= 24 && token.substr(1) == base::NumberToString(number)) {
+    return static_cast<ui::KeyboardCode>(ui::VKEY_F1 + number - 1);
+  }
+  constexpr std::string_view kNumpad = "Numpad";
+  if (token.size() == kNumpad.size() + 1 && token.starts_with(kNumpad) &&
+      token.back() >= '0' && token.back() <= '9') {
+    return static_cast<ui::KeyboardCode>(ui::VKEY_NUMPAD0 + token.back() -
+                                         '0');
+  }
+  for (const KeyName& entry : kKeyNames) {
+    if (entry.name == token) {
+      return entry.key;
+    }
+  }
+  constexpr std::string_view kVk = "VK";
+  if (token.size() == kVk.size() + 2 && token.starts_with(kVk)) {
+    std::vector<uint8_t> bytes;
+    if (base::HexStringToBytes(token.substr(kVk.size()), &bytes) &&
+        bytes.size() == 1 && bytes[0] != 0) {
+      return static_cast<ui::KeyboardCode>(bytes[0]);
+    }
+  }
+  return std::nullopt;
+}
+
+bool IsModifierOnly(ui::KeyboardCode key) {
+  switch (key) {
+    case ui::VKEY_UNKNOWN:
+    case ui::VKEY_SHIFT:
+    case ui::VKEY_LSHIFT:
+    case ui::VKEY_RSHIFT:
+    case ui::VKEY_CONTROL:
+    case ui::VKEY_LCONTROL:
+    case ui::VKEY_RCONTROL:
+    case ui::VKEY_MENU:
+    case ui::VKEY_LMENU:
+    case ui::VKEY_RMENU:
+    case ui::VKEY_LWIN:
+    case ui::VKEY_RWIN:
+    case ui::VKEY_APPS:
+    case ui::VKEY_CAPITAL:
+    case ui::VKEY_ALTGR:
+    case ui::VKEY_PROCESSKEY:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool IsFunctionKey(ui::KeyboardCode key) {
+  return InRange(key, ui::VKEY_F1, ui::VKEY_F24);
+}
+
+constexpr int kShift = ui::EF_SHIFT_DOWN;
+constexpr int kCtrl = ui::EF_CONTROL_DOWN;
+constexpr int kAlt = ui::EF_ALT_DOWN;
+constexpr int kCmd = ui::EF_COMMAND_DOWN;
+
+// Z14: what macOS keeps for itself (Quit, Hide, Minimize, the app and window
+// switchers, Spotlight and the input sources, the screenshots, Lock Screen,
+// Mission Control's arrows), and the Edit menu's rows that are not Chromium
+// commands (Jump to Selection, the spelling panel and check).
+struct Reserved {
+  ui::KeyboardCode key;
+  int modifiers;
+};
+constexpr Reserved kMacSystem[] = {
+    {ui::VKEY_Q, kCmd},
+    {ui::VKEY_H, kCmd},
+    {ui::VKEY_H, kCmd | kAlt},
+    {ui::VKEY_M, kCmd},
+    {ui::VKEY_TAB, kCmd},
+    {ui::VKEY_TAB, kCmd | kShift},
+    {ui::VKEY_OEM_3, kCmd},
+    {ui::VKEY_OEM_3, kCmd | kShift},
+    {ui::VKEY_SPACE, kCmd},
+    {ui::VKEY_SPACE, kCmd | kAlt},
+    {ui::VKEY_SPACE, kCtrl},
+    {ui::VKEY_SPACE, kCtrl | kAlt},
+    {ui::VKEY_3, kCmd | kShift},
+    {ui::VKEY_4, kCmd | kShift},
+    {ui::VKEY_5, kCmd | kShift},
+    {ui::VKEY_6, kCmd | kShift},
+    {ui::VKEY_Q, kCmd | kCtrl},
+    {ui::VKEY_ESCAPE, kCmd},
+    {ui::VKEY_ESCAPE, kCmd | kAlt},
+    {ui::VKEY_LEFT, kCtrl},
+    {ui::VKEY_RIGHT, kCtrl},
+    {ui::VKEY_UP, kCtrl},
+    {ui::VKEY_DOWN, kCtrl},
+    {ui::VKEY_J, kCmd},
+    {ui::VKEY_OEM_1, kCmd},
+    {ui::VKEY_OEM_1, kCmd | kShift},
+};
+constexpr Reserved kMacTextEditing[] = {
+    {ui::VKEY_C, kCmd},         {ui::VKEY_V, kCmd},
+    {ui::VKEY_X, kCmd},         {ui::VKEY_A, kCmd},
+    {ui::VKEY_Z, kCmd},         {ui::VKEY_Z, kCmd | kShift},
+    {ui::VKEY_V, kCmd | kShift}, {ui::VKEY_V, kCmd | kShift | kAlt},
+};
+// Windows' own: the window's close, the switchers, the window menu, Start,
+// the task manager, the secure attention chord, the context menu key's twin.
+constexpr Reserved kWindowsSystem[] = {
+    {ui::VKEY_F4, kAlt},           {ui::VKEY_TAB, kAlt},
+    {ui::VKEY_TAB, kAlt | kShift}, {ui::VKEY_ESCAPE, kAlt},
+    {ui::VKEY_ESCAPE, kAlt | kShift}, {ui::VKEY_SPACE, kAlt},
+    {ui::VKEY_ESCAPE, kCtrl},      {ui::VKEY_ESCAPE, kCtrl | kShift},
+    {ui::VKEY_DELETE, kCtrl | kAlt}, {ui::VKEY_F10, kShift},
+};
+constexpr Reserved kWindowsTextEditing[] = {
+    {ui::VKEY_C, kCtrl},          {ui::VKEY_V, kCtrl},
+    {ui::VKEY_X, kCtrl},          {ui::VKEY_A, kCtrl},
+    {ui::VKEY_Z, kCtrl},          {ui::VKEY_Y, kCtrl},
+    {ui::VKEY_Z, kCtrl | kShift}, {ui::VKEY_INSERT, kCtrl},
+    {ui::VKEY_INSERT, kShift},    {ui::VKEY_DELETE, kShift},
+};
+
+template <size_t N>
+bool IsIn(const Reserved (&list)[N], const Chord& chord) {
+  for (const Reserved& entry : list) {
+    if (entry.key == chord.key && entry.modifiers == chord.modifiers) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+std::string ChordToString(const Chord& chord) {
+  std::string text;
+  for (const ModifierName& modifier : kModifierNames) {
+    if (chord.modifiers & modifier.flag) {
+      text.append(modifier.name);
+      text.push_back('+');
+    }
+  }
+  text.append(KeyToken(chord.key));
+  return text;
+}
+
+std::optional<Chord> ChordFromString(std::string_view text) {
+  if (text.empty()) {
+    return std::nullopt;
+  }
+  const std::vector<std::string_view> parts = base::SplitStringPiece(
+      text, "+", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.empty()) {
+    return std::nullopt;
+  }
+  int modifiers = 0;
+  size_t next_modifier = 0;
+  for (size_t i = 0; i + 1 < parts.size(); ++i) {
+    bool found = false;
+    for (size_t m = next_modifier; m < kModifierNames.size(); ++m) {
+      if (kModifierNames[m].name == parts[i]) {
+        modifiers |= kModifierNames[m].flag;
+        next_modifier = m + 1;
+        found = true;
+        break;
+      }
+    }
+    if (!found) {
+      return std::nullopt;
+    }
+  }
+  // Alt on its own reads back too: Windows' shipped table binds it (the
+  // menu's focus), and a stored table holds what it was given. No other
+  // modifier is a key; a chord the user records is checked for its shape
+  // (CheckChordShapeFor).
+  const std::optional<ui::KeyboardCode> key = KeyFromToken(parts.back());
+  const bool alt_alone = key && (*key == ui::VKEY_MENU ||
+                                 *key == ui::VKEY_LMENU ||
+                                 *key == ui::VKEY_RMENU);
+  if (!key || (IsModifierOnly(*key) && !alt_alone)) {
+    return std::nullopt;
+  }
+  return Chord(*key, modifiers);
+}
+
+std::u16string ChordText(const Chord& chord) {
+  return ToAccelerator(chord).GetShortcutText();
+}
+
+ui::Accelerator ToAccelerator(const Chord& chord) {
+  return ui::Accelerator(chord.key, chord.modifiers);
+}
+
+Chord FromAccelerator(const ui::Accelerator& accelerator) {
+  return Chord(accelerator.key_code(), accelerator.modifiers());
+}
+
+ChordShape CheckChordShapeFor(const Chord& chord, bool mac) {
+  if (IsModifierOnly(chord.key)) {
+    return ChordShape::kNoKey;
+  }
+  if (chord.key == ui::VKEY_ESCAPE && chord.modifiers == 0) {
+    return ChordShape::kEscape;
+  }
+  if (chord.modifiers & (ui::EF_ALTGR_DOWN | ui::EF_FUNCTION_DOWN)) {
+    return ChordShape::kNeedsModifier;
+  }
+  if (mac) {
+    if (IsIn(kMacSystem, chord)) {
+      return ChordShape::kSystem;
+    }
+    if (IsIn(kMacTextEditing, chord)) {
+      return ChordShape::kTextEditing;
+    }
+    if (!(chord.modifiers & (kCmd | kCtrl)) && !IsFunctionKey(chord.key)) {
+      return ChordShape::kNeedsModifier;
+    }
+    return ChordShape::kOk;
+  }
+  if (chord.modifiers & kCmd) {
+    return ChordShape::kWindowsKey;
+  }
+  if (IsIn(kWindowsSystem, chord)) {
+    return ChordShape::kSystem;
+  }
+  if (IsIn(kWindowsTextEditing, chord)) {
+    return ChordShape::kTextEditing;
+  }
+  if (!(chord.modifiers & (kCtrl | kAlt)) && !IsFunctionKey(chord.key)) {
+    return ChordShape::kNeedsModifier;
+  }
+  return ChordShape::kOk;
+}
+
+ChordShape CheckChordShape(const Chord& chord) {
+  return CheckChordShapeFor(chord, BUILDFLAG(IS_MAC));
+}
+
+std::u16string ChordShapeMessage(ChordShape shape) {
+  switch (shape) {
+    case ChordShape::kOk:
+      return std::u16string();
+    case ChordShape::kNoKey:
+      return u"Press a key with the modifiers, not a modifier alone.";
+    case ChordShape::kNeedsModifier:
+#if BUILDFLAG(IS_MAC)
+      return u"A shortcut needs ⌘ or ⌃, or an F-key.";
+#else
+      return u"A shortcut needs Ctrl or Alt, or an F-key. AltGr types "
+             u"characters: hold the left Alt.";
+#endif
+    case ChordShape::kSystem:
+#if BUILDFLAG(IS_MAC)
+      return u"macOS uses this shortcut.";
+#else
+      return u"Windows uses this shortcut.";
+#endif
+    case ChordShape::kTextEditing:
+      return u"This shortcut edits text, so it stays as it is.";
+    case ChordShape::kEscape:
+      return u"Escape on its own closes and cancels everywhere, so it stays "
+             u"as it is.";
+    case ChordShape::kWindowsKey:
+      return u"Windows keeps the shortcuts with the Windows key.";
+  }
+  return std::u16string();
+}
+
+}  // namespace stedding::shortcuts
