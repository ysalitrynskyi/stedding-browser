#!/usr/bin/env bash
# Copy Stedding's branding assets over the Chromium checkout.
#
# Usage:
#   tooling/apply-branding            # copy branding/ into the checkout
#   tooling/apply-branding --check    # report what would change; touch nothing
#   tooling/apply-branding --revert   # restore Chromium's originals
#
# This is deliberately not a patch. Upstream's branding switch is boolean — chromium/
# or google_chrome/ — and grit includes hardcode `chromium/`, so there is no third
# directory to add and our files overwrite that tree in place. Doing it as a copy
# rather than a patch means it never conflicts on rebase.
#
# It must run BEFORE `gn gen`, because grit resolves these paths at generation time.
#
# The files being overwritten are tracked in the Chromium repository, so this leaves
# the checkout dirty on purpose: `git status` shows exactly what branding changed, and
# --revert is a `git checkout` away.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

# NOTE: the body lives in main() and is called on the last line — see the comment in
# tooling/build-chromium for why editing a running script corrupts it.
main() {
    require_macos_arm64

    MODE=apply
    for arg in "$@"; do
      case "$arg" in
        --check)   MODE=check ;;
        --revert)  MODE=revert ;;
        -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
        *)         die "unknown argument: $arg" ;;
      esac
    done

    BRANDING_DIR="$STEDDING_ROOT/branding"
    THEME_DIR="chrome/app/theme/chromium"

    [ -d "$CHROMIUM_SRC/.git" ] || die "no checkout at $CHROMIUM_SRC — run tooling/sync-chromium"
    [ -d "$BRANDING_DIR" ]      || die "no branding directory at $BRANDING_DIR"

    cd "$CHROMIUM_SRC" || die "cannot enter $CHROMIUM_SRC"

    # Each entry maps a file in branding/ to its destination under the theme directory.
    # Add a row here when a new asset is introduced; nothing else needs to change.
    ASSETS="
BRANDING|$THEME_DIR/BRANDING
mac/app.icns|$THEME_DIR/mac/app.icns
mac/Assets.car|$THEME_DIR/mac/Assets.car
mac/AppIcon.icon|$THEME_DIR/mac/AppIcon.icon
product_logo/product_logo.svg|$THEME_DIR/product_logo.svg
product_logo/product_logo_16.png|$THEME_DIR/product_logo_16.png
product_logo/product_logo_22_mono.png|$THEME_DIR/product_logo_22_mono.png
product_logo/product_logo_24.png|$THEME_DIR/product_logo_24.png
product_logo/product_logo_48.png|$THEME_DIR/product_logo_48.png
product_logo/product_logo_64.png|$THEME_DIR/product_logo_64.png
product_logo/product_logo_128.png|$THEME_DIR/product_logo_128.png
product_logo/product_logo_256.png|$THEME_DIR/product_logo_256.png
"

    if [ "$MODE" = revert ]; then
      log "restoring Chromium's originals under $THEME_DIR"
      # Restore the whole theme directory rather than the listed files: that also
      # catches assets a previous, differently-configured run may have copied.
      git checkout -- "$THEME_DIR" 2>/dev/null \
        || die "git checkout of $THEME_DIR failed; the checkout may be in a bad state"
      git checkout -- chrome/app/chromium_strings.grd \
                      components/components_chromium_strings.grd 2>/dev/null || true
      log "reverted; $THEME_DIR now matches $CHROMIUM_TAG"
      exit 0
    fi

    present=0
    missing=0
    changed=0

    while IFS='|' read -r src dst; do
      [ -z "$src" ] && continue
      from="$BRANDING_DIR/$src"

      # Some assets are directories, not files — AppIcon.icon is a bundle of a
      # JSON manifest plus SVG layers. Copy those wholesale.
      if [ -d "$from" ]; then
        present=$(( present + 1 ))
        if [ ! -d "$dst" ]; then
          printf '  %-28s %s\n' "$src" "NO SUCH DESTINATION: $dst" >&2
          die "the checkout does not have $dst.
     Upstream may have moved it; the asset map in this script needs updating."
        fi
        if diff -rq "$from" "$dst" >/dev/null 2>&1; then
          printf '  %-28s %s\n' "$src" "already applied" >&2
          continue
        fi
        changed=$(( changed + 1 ))
        if [ "$MODE" = check ]; then
          printf '  %-28s %s\n' "$src" "would replace $dst" >&2
        else
          rm -rf "$dst" && cp -R "$from" "$dst" || die "failed to copy $from -> $dst"
          printf '  %-28s %s\n' "$src" "replaced $dst" >&2
        fi
        continue
      fi

      if [ ! -f "$from" ]; then
        # A missing asset is reported, never substituted. A build that keeps Chromium's
        # icon is obviously unbranded; a placeholder might survive to a release.
        printf '  %-28s %s\n' "$src" "absent in branding/ — Chromium's is kept" >&2
        missing=$(( missing + 1 ))
        continue
      fi
      present=$(( present + 1 ))

      # BRANDING is parsed by Chromium's build/util/version.py, which splits EVERY
      # line on "=" with no tolerance for comments or blank lines. A malformed file
      # does not fail here, it fails much later inside `gn gen` with
      # "branding.gni: Script returned non-zero exit code" and a Python traceback.
      # Validate it the same way upstream will, so the error arrives with the cause.
      if [ "$src" = "BRANDING" ]; then
        bad="$(awk 'NF==0 || index($0,"=")==0 { print NR": "$0 }' "$from" | head -3)"
        if [ -n "$bad" ]; then
          printf '%s\n' "$bad" >&2
          die "branding/BRANDING must be strictly KEY=VALUE on every line — no comments,
     no blank lines. Chromium's build/util/version.py splits every line on '=' and
     raises on anything else. Put explanations in branding/README.md instead."
        fi
      fi

      if [ ! -f "$dst" ]; then
        printf '  %-28s %s\n' "$src" "NO SUCH DESTINATION: $dst" >&2
        die "the checkout does not have $dst.
     Upstream may have moved it; the asset map in this script needs updating."
      fi
      if cmp -s "$from" "$dst"; then
        printf '  %-28s %s\n' "$src" "already applied" >&2
        continue
      fi
      changed=$(( changed + 1 ))
      if [ "$MODE" = check ]; then
        printf '  %-28s %s\n' "$src" "would replace $dst" >&2
      else
        cp "$from" "$dst" || die "failed to copy $from -> $dst"
        printf '  %-28s %s\n' "$src" "replaced $dst" >&2
      fi
    done <<EOF
$ASSETS
EOF

    # Product-name strings.
    #
    # These are rewritten from upstream's current file rather than carried as a
    # patch. chrome/app/chromium_strings.grd sees 185 commits a year and holds
    # nearly seven hundred occurrences of the product name; a patch against it
    # would conflict on almost every rebase. Transforming whatever upstream ships
    # is free forever.
    #
    # ChromiumOS and ChromiumUpdater are deliberately untouched — different
    # products, and renaming them would be wrong rather than merely noisy.
    for grd in chrome/app/chromium_strings.grd components/components_chromium_strings.grd; do
      [ -f "$grd" ] || continue
      before="$(grep -c 'Chromium' "$grd" 2>/dev/null || echo 0)"
      if [ "$MODE" = check ]; then
        printf '  %-28s %s\n' "$(basename "$grd")" "would rename $before product-name string(s)" >&2
        continue
      fi
      perl -pi -e 's/Chromium(?!OS|Updater)/Stedding/g' "$grd"
      after="$(grep -c 'Stedding' "$grd" 2>/dev/null || echo 0)"
      printf '  %-28s %s\n' "$(basename "$grd")" "renamed, $after Stedding string(s)" >&2
    done

    log "$present asset(s) available, $missing absent, $changed $([ "$MODE" = check ] && echo "would change" || echo changed)"

    if [ "$MODE" = check ]; then
      [ "$changed" -eq 0 ] || exit 1
      exit 0
    fi

    [ "$missing" -eq 0 ] || warn "branding is incomplete: $missing asset(s) are still Chromium's"
    log "run gn gen after this — grit resolves these paths at generation time"
    log "revert with: tooling/apply-branding --revert"
}

main "$@"
