+void TabView::UpdatePinCloseButton() {
+  tabs::TabInterface* const tab =
+      const_cast<tabs::TabInterface*>(GetTabInterface());
+  BrowserWindowInterface* const window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  close_button_->SetKeepsPin(window && stedding::RowCloseFor(window, tab) ==
+                                           stedding::RowClose::kSleep);
+}
+
+void TabView::AskToRemovePin(tabs::TabInterface* tab) {
+  // One question at a time: a second press brings the open one forward.
+  if (pin_remove_bubble_) {
+    pin_remove_bubble_->Activate();
+    return;
+  }
+  // The tab by its handle: the row may be gone, or the tab closed some other
+  // way, by the time the answer comes.
+  const tabs::TabHandle handle = tab->GetHandle();
+  auto dialog_model =
+      ui::DialogModel::Builder()
+          .SetTitle(u"Remove this pinned tab?")
+          .AddParagraph(ui::DialogModelLabel(
+              u"It is unpinned and closed. Reopen Closed Tab brings it "
+              u"back."))
+          .AddOkButton(
+              base::BindOnce(
+                  [](tabs::TabHandle handle) {
+                    // After the question has closed: closing the tab takes
+                    // its row, which closes a question still open over it,
+                    // and that close reached for the x on a row already out
+                    // of the window -- the browser stopped (the owner,
+                    // 2026-10-28, on 0.3.0 beta 22).
+                    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                        FROM_HERE, base::BindOnce(
+                                       [](tabs::TabHandle handle) {
+                                         // Still a pin, by the same rule: one
+                                         // unpinned or closed meanwhile is
+                                         // left.
+                                         tabs::TabInterface* const pin =
+                                             handle.Get();
+                                         BrowserWindowInterface* const window =
+                                             pin ? pin->GetBrowserWindowInterface()
+                                                 : nullptr;
+                                         if (window &&
+                                             stedding::RowCloseFor(window, pin) !=
+                                                 stedding::RowClose::kClose) {
+                                           stedding::RemovePinnedRow(window, pin);
+                                         }
+                                       },
+                                       handle));
+                  },
+                  handle),
+              ui::DialogModel::Button::Params().SetLabel(u"Remove"))
+          .AddCancelButton(base::DoNothing())
+          // Return alone never removes a pin: the user says so.
+          .OverrideDefaultButton(ui::mojom::DialogButton::kCancel)
+          .Build();
+  auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+      std::move(dialog_model), close_button_, views::BubbleBorder::LEFT_CENTER);
+  // The x is not lit while the question shows: the light is undone as the
+  // question closes, and a question closed with its row did that on a button
+  // no longer in a window.
+  bubble->set_highlight_button_when_shown(false);
+  views::Widget* const widget = views::BubbleDialogDelegate::CreateBubbleDeprecated(
+      std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET);
+  pin_remove_bubble_ = widget->GetWeakPtr();
+  widget->Show();
+}
