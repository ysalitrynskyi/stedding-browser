+// sidebar Y19: a hidden sidebar opens from nothing, and for the first part
+// of its animation the strip is narrower than the traffic lights: the row's
+// contents keep clear of them at every step, as while the sidebar is hidden.
+// They ran under the lights until the strip had grown past them, for seconds
+// on a loaded machine (operator, 2026-10-13, on a test window). Each step of
+// the animation is laid out by hand.
+IN_PROC_BROWSER_TEST_F(WindowButtonsTest,
+                       OpeningAHiddenSidebarKeepsTheRowOffTheLights) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  VerticalTabStripRegionView* const strip =
+      browser_view->vertical_tab_strip_region_view_for_testing();
+  BrowserAnimationController* const animations =
+      BrowserAnimationController::From(browser());
+  tabs::VerticalTabStripStateController* const state =
+      tabs::VerticalTabStripStateController::From(browser());
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarClosedForm,
+      stedding::prefs::kSidebarClosedHidden);
+  state->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    views::test::RunScheduledLayout(browser_view->GetWidget());
+    return !animations->IsAnimating(TabStripAnimations::kVerticalTabStrip) &&
+           strip->IsHiddenCompletely() && strip->width() == 0;
+  }));
+
+  NSWindow* const window =
+      browser_view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  int lights_right = 0;
+  for (NSWindowButton kind :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    NSButton* const button = [window standardWindowButton:kind];
+    ASSERT_TRUE(button);
+    lights_right =
+        std::max(lights_right, ScreenFrame(window, button).right());
+  }
+  const int window_left = browser_view->GetBoundsInScreen().x();
+
+  auto container = base::MakeRefCounted<gfx::AnimationContainer>();
+  animations->SetAnimationContainerForTesting(
+      TabStripAnimations::kVerticalTabStrip, container.get());
+  gfx::AnimationContainerTestApi clock(container.get());
+  state->RequestCollapse(false);
+  int narrow_steps = 0;
+  for (int step = 0;
+       step < 200 &&
+       animations->IsAnimating(TabStripAnimations::kVerticalTabStrip);
+       ++step) {
+    clock.IncrementTime(base::Milliseconds(4));
+    views::test::RunScheduledLayout(browser_view->GetWidget());
+    if (window_left + strip->width() < lights_right) {
+      ++narrow_steps;
+    }
+    EXPECT_LT(lights_right, browser_view->toolbar()->GetBoundsInScreen().x())
+        << "step " << step << ": the strip is " << strip->width()
+        << " wide and the row's contents run under the traffic lights";
+  }
+  EXPECT_FALSE(animations->IsAnimating(TabStripAnimations::kVerticalTabStrip));
+  EXPECT_GT(narrow_steps, 0)
+      << "no step saw the strip narrower than the traffic lights";
+  EXPECT_FALSE(state->IsCollapsed());
+}
