+#else
+  base::ScopedPathOverride home_override(base::DIR_HOME, home.GetPath());
+  const base::FilePath user_data = home.GetPath()
+                                       .AppendASCII("Library")
+                                       .AppendASCII("Application Support")
+                                       .AppendASCII("Dia")
+                                       .AppendASCII("User Data");
+#endif
+  const base::FilePath profile = user_data.AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(profile));
+  WriteBookmarks(profile, kBookmarks);
+  ASSERT_TRUE(base::WriteFile(profile.AppendASCII("History"), ""));
+  WriteLogins(profile.AppendASCII("Login Data"), {"sealed"},
+              /*blocked_rows=*/1);
+  SetChromiumFamilyKeyForTesting(std::optional<std::vector<uint8_t>>());
+
+  ChromiumFamilyInfo info;
+  base::RunLoop loop;
+  LoadChromiumFamilyInfo(kDiaSource,
+                         base::BindOnce(
+                             [](ChromiumFamilyInfo* out, base::OnceClosure quit,
+                                ChromiumFamilyInfo got) {
+                               *out = std::move(got);
+                               std::move(quit).Run();
+                             },
+                             &info, loop.QuitClosure()));
+  loop.Run();
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+  EXPECT_TRUE(info.found);
+  ASSERT_EQ(1u, info.profiles.size());
+  EXPECT_EQ(4u, info.profiles[0].bookmarks);
+  EXPECT_TRUE(info.profiles[0].history);
+  EXPECT_EQ(1u, info.profiles[0].passwords);
+  EXPECT_EQ(u"4 bookmarks, history and 1 saved password",
+            SummariseChromiumProfile(info.profiles[0]));
+#endif
+  EXPECT_EQ(0u, ChromiumFamilyKeyReadsForTesting())
+      << "the summary asked for the key";
+  SetChromiumFamilyKeyForTesting(std::nullopt);
+}
