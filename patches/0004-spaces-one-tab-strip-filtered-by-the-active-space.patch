+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_drag_target.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/dragging/drag_session_data.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+// Stands in for the drag machinery. The only thing SpaceDragTarget asks of it
+// is the tab, which is the part that matters: a drop handler that takes a tab
+// and fails to put it back has lost it.
+class FakeDragController : public TabDragTarget::DragController {
+ public:
+  explicit FakeDragController(TabStripModel* tabs) : tabs_(tabs) {}
+
+  std::unique_ptr<tabs::TabModel> DetachTabAtForInsertion(
+      int drag_idx) override {
+    return tabs_->DetachTabAtForInsertion(drag_idx);
+  }
+  const DragSessionData& GetSessionData() const override { return data_; }
+  const TabDragContext* GetAttachedContext() const override { return nullptr; }
+
+ private:
+  const raw_ptr<TabStripModel> tabs_;
+  DragSessionData data_;
+};
+
+class SpaceDragTargetTest : public BrowserWithTestWindowTest {};
+
+TEST_F(SpaceDragTargetTest, DroppingOnASpaceMovesTheTabAndKeepsIt) {
+  AddTab(browser(), GURL("https://example.com/"));
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  ASSERT_EQ(1, tabs->count());
+
+  SpaceModel model;
+  Space* const other = model.AddSpace("Other", SK_ColorRED);
+
+  // The switcher is only used for hit testing, which SetHoveredSpace bypasses.
+  SpaceDragTarget target(model, *browser(), /*switcher=*/nullptr);
+  target.SetHoveredSpace(other->id());
+
+  FakeDragController controller(tabs);
+  target.HandleTabDrop(controller);
+
+  // The tab is still in the strip -- a Space is not another window.
+  ASSERT_EQ(1, tabs->count()) << "the drop handler lost the tab";
+  EXPECT_EQ(other->id(), model.SpaceForTab(tabs->GetTabAtIndex(0)));
+  EXPECT_EQ(other->id(), model.active_id())
+      << "the target Space should become active so the tab stays visible";
+}
+
+TEST_F(SpaceDragTargetTest, DroppingNowhereLeavesTheTabAlone) {
+  AddTab(browser(), GURL("https://example.com/"));
+  TabStripModel* const tabs = browser()->tab_strip_model();
+
+  SpaceModel model;
+  SpaceDragTarget target(model, *browser(), /*switcher=*/nullptr);
+  target.SetHoveredSpace(std::nullopt);
+
+  FakeDragController controller(tabs);
+  target.HandleTabDrop(controller);
+
+  EXPECT_EQ(1, tabs->count());
+}
+
+}  // namespace
+}  // namespace spaces
