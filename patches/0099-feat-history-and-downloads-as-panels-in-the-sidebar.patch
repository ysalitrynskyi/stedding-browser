+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  padding: 4px 8px 0;
+}
+
+#header {
+  align-items: center;
+  display: flex;
+  gap: 4px;
+  min-height: 32px;
+}
+
+h1 {
+  flex: 1 1 auto;
+  font-size: 15px;
+  font-weight: 600;
+  margin: 0 4px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+button {
+  background: none;
+  border: none;
+  border-radius: 6px;
+  color: inherit;
+  cursor: default;
+  font: inherit;
+}
+
+button:hover {
+  background: var(--hover);
+}
+
+button:active {
