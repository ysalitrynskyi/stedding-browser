+// sessions S35 (BACKLOG S-274): a Space added while "Give every new Space
+// its own session" is on starts with a jar of its own; one added while it is
+// off shares the session, and turning it on changes no Space already there.
+TEST(SpaceRegistryTest, ANewSpaceTakesTheOwnSessionSetting) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterBooleanPref(stedding::prefs::kSpacesOwnSession,
+                                        false);
+  SpaceRegistry registry(&prefs);
+  const SpaceId shared = registry.Add("Work", SK_ColorBLUE);
+  prefs.SetBoolean(stedding::prefs::kSpacesOwnSession, true);
+  const SpaceId own = registry.Add("Mail", SK_ColorGREEN);
+  prefs.SetBoolean(stedding::prefs::kSpacesOwnSession, false);
+  const SpaceId later = registry.Add("Play", SK_ColorRED);
+
+  ASSERT_TRUE(registry.Find(shared) && registry.Find(own) &&
+              registry.Find(later));
+  EXPECT_FALSE(registry.Find(shared)->isolated);
+  EXPECT_TRUE(registry.Find(own)->isolated);
+  EXPECT_FALSE(registry.Find(own)->profile_id.empty());
+  EXPECT_FALSE(registry.Find(later)->isolated);
+  // The jar is kept with the Space, as Independent session turned on keeps
+  // it (sessions S2).
+  SpaceRegistry again(&prefs);
+  ASSERT_TRUE(again.Find(own));
+  EXPECT_TRUE(again.Find(own)->isolated);
+  EXPECT_EQ(registry.Find(own)->profile_id, again.Find(own)->profile_id);
+}
