+DEFINE_USER_DATA(PageSplitDragTarget);
+
+PageSplitDragTarget::PageSplitDragTarget(BrowserView& browser_view,
+                                         SpaceModel& model)
+    : browser_view_(browser_view),
+      model_(model),
+      scoped_user_data_(browser_view.browser()->GetUnownedUserDataHost(),
+                        *this) {}
+
+PageSplitDragTarget::~PageSplitDragTarget() {
+  Light(std::nullopt);
+  will_destroy_callbacks_.Notify();
+}
+
+// static
+PageSplitDragTarget* PageSplitDragTarget::From(
+    BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+// static
+TabDragTarget* PageSplitDragTarget::ForPoint(
+    BrowserView& browser_view,
+    const gfx::Point& point_in_screen) {
+  PageSplitDragTarget* const target = From(browser_view.browser());
+  if (!target || !browser_view.GetProfile()->GetPrefs()->GetBoolean(
+                     prefs::kSplitViewDragAndDropEnabled)) {
+    return nullptr;
+  }
+  // J14: anywhere in the window the strip does not take -- the page, and on
+  // the way to it the toolbar and the gutters -- holds the drag in the
+  // window. Only the page lights a half and takes a drop.
+  return browser_view.GetBoundsInScreen().Contains(point_in_screen) ? target
+                                                                    : nullptr;
+}
+
+void PageSplitDragTarget::OnTabDragEntered() {}
+
+TabDragContext* PageSplitDragTarget::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  TabDragContext* const attached =
+      const_cast<TabDragContext*>(controller.GetAttachedContext());
+  // A drag from another window goes on as Chromium's does: a split moves
+  // nothing between windows (J11).
+  if (!attached || !attached->GetWidget() ||
+      attached->GetWidget()->GetTopLevelWidget() !=
+          browser_view_->GetWidget()->GetTopLevelWidget()) {
+    ShowDraggedTab();
+    Light(std::nullopt);
+    return nullptr;
+  }
+
+  TabStripModel* const strip = browser_view_->browser()->tab_strip_model();
+  const DragSessionData& session = controller.GetSessionData();
+  stedding::SplitDropCandidate candidate;
+  candidate.dragged_group_header = session.group_header_id().has_value();
+  tabs::TabInterface* dragged = nullptr;
+  for (const TabDragData& data : session.tab_drag_data_) {
+    if (data.view_type == TabSlotView::ViewType::kTabGroupHeader) {
+      candidate.dragged_group_header = true;
+      continue;
+    }
+    if (!data.contents) {
+      continue;
+    }
+    ++candidate.dragged_tabs;
+    dragged = tabs::TabInterface::MaybeGetFromContents(data.contents);
+  }
+  if (dragged) {
+    candidate.dragged_essential = dragged->IsPinned();
+    candidate.dragged_space_pin = model_->IsSpacePinned(dragged);
+    candidate.dragged_split = dragged->IsSplit();
+  }
+  tabs::TabInterface* const page = session.tab_active_before_drag.Get();
+  candidate.page_missing =
+      !page || strip->GetIndexOfTab(page) == TabStripModel::kNoTab;
+  if (!candidate.page_missing) {
+    candidate.page_is_dragged = page == dragged;
+    candidate.page_essential = page->IsPinned();
+    candidate.page_space_pin = model_->IsSpacePinned(page);
+    candidate.page_split = page->IsSplit();
+    candidate.page_browser_page =
+        page->GetContents() &&
+        IsBrowserPage(page->GetContents()->GetLastCommittedURL());
+  }
+
+  // J13: a drag the page does not take lights nothing, nor does a point off
+  // the page. J14: the drag stays in the window all the same; a window comes
+  // only once it leaves the window.
+  const gfx::Rect bounds = PageBoundsInScreen();
+  if (!dragged || !stedding::PageTakesSplitDrop(candidate) ||
+      !bounds.Contains(point_in_screen)) {
+    ShowDraggedTab();
+    Light(std::nullopt);
+    dragged_ = tabs::TabHandle();
+    page_ = tabs::TabHandle();
+    return attached;
+  }
+  dragged_ = dragged->GetHandle();
+  page_ = page->GetHandle();
+  ShowPage();
+  Light(stedding::SplitDropSideAt(point_in_screen.x() - bounds.x(),
+                                  bounds.width(), base::i18n::IsRTL()));
+  return attached;
+}
+
+void PageSplitDragTarget::OnTabDragExited(const gfx::Point& point_in_screen) {
+  ShowDraggedTab();
+  Light(std::nullopt);
+  dragged_ = tabs::TabHandle();
+  page_ = tabs::TabHandle();
+}
+
+void PageSplitDragTarget::OnTabDragEnded() {
+  // A drop elsewhere left this first; Escape puts back the selection the
+  // drag began with, the page on screen.
+  Light(std::nullopt);
+  showed_page_ = false;
+  dragged_ = tabs::TabHandle();
+  page_ = tabs::TabHandle();
+}
+
+bool PageSplitDragTarget::CanDropTab() {
+  return lit_side_.has_value() && dragged_.Get() && page_.Get();
+}
+
+void PageSplitDragTarget::HandleTabDrop(DragController& controller) {
+  const std::optional<stedding::SplitDropSide> side = lit_side_;
+  const tabs::TabHandle dragged = dragged_;
+  const tabs::TabHandle page = page_;
+  Light(std::nullopt);
+  showed_page_ = false;
+  dragged_ = tabs::TabHandle();
+  page_ = tabs::TabHandle();
+  if (!side) {
+    return;
+  }
+  // The split is made once the drag is over: the strip's views still hold
+  // the dragged row as dragged until then, and a split made under them
+  // tripped the drag handler's check that a dragged pane's parent is a split.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&PageSplitDragTarget::MakeSplit,
+                     weak_factory_.GetWeakPtr(), dragged, page, *side));
+}
+
+void PageSplitDragTarget::MakeSplit(tabs::TabHandle dragged_handle,
+                                    tabs::TabHandle page_handle,
+                                    stedding::SplitDropSide side) {
+  tabs::TabInterface* const dragged = dragged_handle.Get();
+  tabs::TabInterface* const page = page_handle.Get();
+  TabStripModel* const strip = browser_view_->browser()->tab_strip_model();
+  if (!dragged || !page ||
+      strip->GetIndexOfTab(dragged) == TabStripModel::kNoTab ||
+      strip->GetIndexOfTab(page) == TabStripModel::kNoTab ||
+      dragged->IsSplit() || page->IsSplit()) {
+    return;
+  }
+  // J11: one split of the two, in the page's place (and folder, J8), with
+  // nothing detached. The split pairs the active tab with the one given.
+  if (strip->GetActiveTab() != page) {
+    strip->ActivateTabAt(strip->GetIndexOfTab(page));
+  }
+  const split_tabs::SplitTabId split = strip->AddToNewSplit(
+      {strip->GetIndexOfTab(dragged)},
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kDragAndDropTab);
+  const std::vector<tabs::TabInterface*> panes =
+      strip->GetSplitData(split)->ListTabs();
+  if (!panes.empty() &&
+      (panes.front() == dragged) != (side == stedding::SplitDropSide::kStart)) {
+    strip->ReverseTabsInSplit(split);
+  }
+  // The dropped page is the active pane (the owner, 2026-10-20).
+  strip->ActivateTabAt(strip->GetIndexOfTab(dragged));
+}
+
+bool PageSplitDragTarget::HoldsAttachedTabs() const {
+  return true;
+}
+
+base::CallbackListSubscription PageSplitDragTarget::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return will_destroy_callbacks_.Add(std::move(callback));
+}
+
+gfx::Rect PageSplitDragTarget::GetHighlightBoundsInScreenForTesting() const {
+  const views::View* const view = highlight_.view();
+  return view ? view->GetBoundsInScreen() : gfx::Rect();
+}
+
+gfx::Rect PageSplitDragTarget::PageBoundsInScreen() const {
+  views::View* const page = browser_view_->multi_contents_view();
+  return page && page->IsDrawn() ? page->GetBoundsInScreen() : gfx::Rect();
+}
+
+void PageSplitDragTarget::ShowPage() {
+  TabStripModel* const strip = browser_view_->browser()->tab_strip_model();
+  tabs::TabInterface* const page = page_.Get();
+  const int index = page ? strip->GetIndexOfTab(page) : TabStripModel::kNoTab;
+  if (index != TabStripModel::kNoTab && strip->active_index() != index) {
+    strip->ActivateTabAt(index);
+    showed_page_ = true;
+  }
+}
+
+void PageSplitDragTarget::ShowDraggedTab() {
+  if (!showed_page_) {
+    return;
+  }
+  showed_page_ = false;
+  TabStripModel* const strip = browser_view_->browser()->tab_strip_model();
+  tabs::TabInterface* const dragged = dragged_.Get();
+  const int index =
+      dragged ? strip->GetIndexOfTab(dragged) : TabStripModel::kNoTab;
+  if (index != TabStripModel::kNoTab && strip->active_index() != index) {
+    strip->ActivateTabAt(index);
+  }
+}
+
+void PageSplitDragTarget::Light(std::optional<stedding::SplitDropSide> side) {
+  lit_side_ = side;
+  views::View* view = highlight_.view();
+  if (!side) {
+    if (view) {
+      highlight_.SetView(nullptr);
+      if (views::View* const parent = view->parent()) {
+        parent->RemoveChildViewT(view);
+      }
+    }
+    return;
+  }
+  gfx::Rect half = PageBoundsInScreen();
+  const int middle = half.width() / 2;
+  // The side is the split's order; the half is on screen.
+  if ((*side == stedding::SplitDropSide::kStart) == !base::i18n::IsRTL()) {
+    half.set_width(middle);
+  } else {
+    half.set_x(half.x() + middle);
+    half.set_width(half.width() - middle);
+  }
+  half.Inset(kGutter);
+  gfx::Point origin = half.origin();
+  views::View::ConvertPointFromScreen(&browser_view_.get(), &origin);
+  if (!view) {
+    view = browser_view_->AddChildView(
+        std::make_unique<SplitDropHighlight>(model_->active_space()->color()));
+    highlight_.SetView(view);
+  }
+  view->SetBoundsRect(gfx::Rect(origin, half.size()));
+}
+
+}  // namespace spaces
