+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_COMMON_ESSENTIALS_DRAG_GHOST_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_COMMON_ESSENTIALS_DRAG_GHOST_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/animation/slide_animation.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/animation/animation_delegate_views.h"
+#include "ui/views/view.h"
+
+// Stedding pins H27 (BACKLOG S-289, GitHub issue 16): the floating copy of a
+// tab dragged across the essentials' edge, as Arc draws it. Over the
+// essentials it is a card, over the list a row, and it turns from one into
+// the other as it crosses, under the pointer the whole way. At the release
+// it settles into the place the drop made and fades as the real card or row
+// appears under it. It lies on the strip, over both scroll views, and takes
+// no events; the row or card it stands for is kept at no opacity
+// (kHiddenForEssentialsDrag) while it is shown.
+class EssentialsDragGhost : public views::View,
+                            public views::AnimationDelegateViews {
+  METADATA_HEADER(EssentialsDragGhost, views::View)
+
+ public:
+  // `count` tabs are dragged; the copy is the first's, with their number.
+  EssentialsDragGhost(ui::ImageModel favicon,
+                      std::u16string title,
+                      int count,
+                      bool animate);
+  EssentialsDragGhost(const EssentialsDragGhost&) = delete;
+  EssentialsDragGhost& operator=(const EssentialsDragGhost&) = delete;
+  ~EssentialsDragGhost() override;
+
+  // Follows the pointer. `row` and `card` are its two shapes there, in the
+  // parent's coordinates; it turns into the card while `as_card`, into the
+  // row otherwise.
+  void Follow(const gfx::Rect& row, const gfx::Rect& card, bool as_card);
+
+  // Ends the copy: it moves to `target`, in the parent's coordinates, in the
+  // shape `as_card` says, and fades -- over the end of the move when it
+  // `settles` into the place a drop made, over the whole of it when it
+  // leaves -- then runs `done`, which may delete it.
+  void Finish(const gfx::Rect& target,
+              bool as_card,
+              bool settles,
+              base::OnceClosure done);
+
+  // The shape it is turning into, and whether it is ending.
+  bool as_card() const { return as_card_; }
+  bool finishing() const { return finishing_; }
+  // How far it has turned into a card: 0 a row, 1 a card.
+  double card_amount() const { return shape_.GetCurrentValue(); }
+  // Its shape's bounds, in the parent's coordinates, without the shadow's
+  // room around them.
+  gfx::Rect shape_bounds() const { return shape_bounds_; }
+  bool IsAnimating() const {
+    return shape_.is_animating() || finish_.is_animating();
+  }
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+
+  // views::AnimationDelegateViews:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  void UpdateBounds();
+
+  const ui::ImageModel favicon_;
+  const std::u16string title_;
+  const int count_;
+  const bool animate_;
+
+  // 0 a row, 1 a card.
+  gfx::SlideAnimation shape_{this};
+  // 0 following the pointer, 1 at `finish_to_`.
+  gfx::SlideAnimation finish_{this};
+  bool as_card_ = false;
+  bool finishing_ = false;
+  bool settles_ = false;
+  gfx::Rect row_;
+  gfx::Rect card_;
+  gfx::Rect finish_from_;
+  gfx::Rect finish_to_;
+  gfx::Rect shape_bounds_;
+  base::OnceClosure done_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_ESSENTIALS_DRAG_GHOST_H_
