+
+// pins H16: a middle press and release at the centre of `row`, handed to the
+// row as the window hands it a real one. Straight to the view, so the Mac,
+// whose event generator has no middle button, runs the same steps.
+void MiddleClickRow(TabView* row) {
+  views::View* const view = row;
+  const gfx::Point centre = view->GetLocalBounds().CenterPoint();
+  const ui::MouseEvent press(ui::EventType::kMousePressed, centre, centre,
+                             ui::EventTimeForNow(), ui::EF_MIDDLE_MOUSE_BUTTON,
+                             ui::EF_MIDDLE_MOUSE_BUTTON);
+  const ui::MouseEvent release(ui::EventType::kMouseReleased, centre, centre,
+                               ui::EventTimeForNow(),
+                               ui::EF_MIDDLE_MOUSE_BUTTON,
+                               ui::EF_MIDDLE_MOUSE_BUTTON);
+  view->OnMousePressed(press);
+  // The release may close a plain row: nothing reads `row` after it.
+  view->OnMouseReleased(release);
+}
+
+// The first view of class T at or under `view`.
+template <typename T>
+T* FindView(views::View* view) {
+  if (T* const found = views::AsViewClass<T>(view)) {
+    return found;
+  }
+  for (views::View* const child : view->children()) {
+    if (T* const found = FindView<T>(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
