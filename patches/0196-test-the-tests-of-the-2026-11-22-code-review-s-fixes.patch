+// The window's Zoom In key: Cmd-= on the Mac, Ctrl+= elsewhere.
+input::NativeWebKeyboardEvent ZoomInKeyB27() {
+#if BUILDFLAG(IS_MAC)
+  constexpr int kAccelerator = blink::WebInputEvent::kMetaKey;
+#else
+  constexpr int kAccelerator = blink::WebInputEvent::kControlKey;
+#endif
+  return KeyDownB27(kAccelerator, ui::VKEY_OEM_PLUS,
+                    ui::DomKey::FromCharacter('='), ui::DomCode::EQUAL);
+}
