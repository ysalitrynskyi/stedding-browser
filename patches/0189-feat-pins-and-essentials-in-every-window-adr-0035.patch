+// windows G13: a window told of a change may publish one of its own at once
+// (a reconcile with a publish pending). The store tells every window of it
+// after the round, not inside it, so no window is told twice in a row while
+// another has not heard the first change.
+TEST_F(PinStoreTest, AChangeMadeWhileTellingIsToldAfter) {
+  const SpaceId work = NewSpace();
+  PinStore store(nullptr);
+  Ready(store, {Pin("a", work, "https://a.example/")});
+
+  class Window : public PinStore::Observer {
+   public:
+    Window(PinStore& store, std::string name, std::vector<std::string>& heard,
+           bool publishes)
+        : store_(store),
+          name_(std::move(name)),
+          heard_(heard),
+          publishes_(publishes) {}
+    void OnPinStoreChanged() override {
+      heard_->push_back(name_);
+      if (publishes_) {
+        publishes_ = false;
+        PinRecord b;
+        b.id = "b";
+        b.tier = PinTier::kEssential;
+        b.home = GURL("https://b.example/");
+        store_->Publish({"b"}, {b}, {});
+      }
+    }
+
+   private:
+    const raw_ref<PinStore> store_;
+    const std::string name_;
+    const raw_ref<std::vector<std::string>> heard_;
+    bool publishes_;
+  };
+  std::vector<std::string> heard;
+  Window first(store, "first", heard, /*publishes=*/true);
+  Window second(store, "second", heard, /*publishes=*/false);
+  base::ScopedObservation<PinStore, PinStore::Observer> watch_first(&first);
+  base::ScopedObservation<PinStore, PinStore::Observer> watch_second(&second);
+  watch_first.Observe(&store);
+  watch_second.Observe(&store);
+
+  PublishAll(store, {Pin("a", work, "https://a.example/new")}, {});
+  EXPECT_THAT(heard, ElementsAre("first", "second", "first", "second"));
+  EXPECT_NE(nullptr, store.Find("b"));
+}
