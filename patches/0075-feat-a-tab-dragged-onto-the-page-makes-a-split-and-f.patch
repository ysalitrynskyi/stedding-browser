+  // A row the sidebar shows that stays: the one rule for which rows show
+  // (spaces B33) passes over another Space's tabs, a tab moved to another
+  // Space since it was used, a collapsed folder's rows and a collapsed
+  // pinned run's pins (R35). An essential is in every Space and says nothing
+  // of where the user is (R33).
+  const auto shows = [&](tabs::TabInterface* tab) {
+    const int index = tab_strip_model_->GetIndexOfTab(tab);
+    return index != TabStripModel::kNoTab && !tab->IsPinned() &&
+           !tab_strip_model_->IsTabHidden(index) && !IsLeaving(tab, leaving);
+  };
+  // switcher X1's history: the row a Ctrl-Tab tap shows. A split's entry is
+  // the pane used last, so the split comes back with that pane active.
+  if (const auto it = history_.find(active_id_); it != history_.end()) {
+    for (const tabs::TabHandle& handle : it->second) {
+      if (tabs::TabInterface* const tab = handle.Get(); tab && shows(tab)) {
+        return tab;
+      }
+    }
+  }
+  // R34: no row used since the launch is left (rows opened in the
+  // background, restored or imported count only once selected): the next
+  // row below the one on screen, else the nearest one above.
+  tabs::TabInterface* const active = tab_strip_model_->GetActiveTab();
+  const int from = tab_strip_model_->GetIndexOfTab(
+      active && IsLeaving(active, leaving) ? active : leaving.front());
+  if (from == TabStripModel::kNoTab) {
+    return nullptr;
+  }
+  for (int index = from + 1; index < tab_strip_model_->count(); ++index) {
+    if (tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(index);
+        shows(tab)) {
+      return tab;
+    }
+  }
+  for (int index = from - 1; index >= 0; --index) {
+    if (tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(index);
+        shows(tab)) {
+      return tab;
+    }
+  }
+  return nullptr;
+}
+
+tabs::TabInterface* SpaceModel::TabToShowAsTabsLeave(
+    const std::vector<tabs::TabInterface*>& leaving) const {
+  if (tabs::TabInterface* const row = RowToShowAfter(leaving)) {
+    return row;
+  }
+  // R37: the Space has no row of its own left on screen, so it stays empty
+  // and shows an essential; with none, spaces B4 has added its new tab
+  // before the close, and that is a row of the Space's own.
+  if (!tab_strip_model_ || tab_strip_model_->closing_all()) {
+    return nullptr;
+  }
+  return EssentialToShow(leaving);
+}
+
+tabs::TabInterface* SpaceModel::EssentialToShow(
+    const std::vector<tabs::TabInterface*>& leaving) const {
+  if (!tab_strip_model_) {
+    return nullptr;
+  }
+  const auto shows = [&](tabs::TabInterface* tab) {
+    const int index = tab_strip_model_->GetIndexOfTab(tab);
+    return index != TabStripModel::kNoTab && tab->IsPinned() &&
+           !tab_strip_model_->IsTabHidden(index) && !IsLeaving(tab, leaving);
+  };
+  if (const auto it = history_.find(active_id_); it != history_.end()) {
+    for (const tabs::TabHandle& handle : it->second) {
+      if (tabs::TabInterface* const tab = handle.Get(); tab && shows(tab)) {
+        return tab;
+      }
+    }
+  }
+  for (int index = 0; index < tab_strip_model_->count(); ++index) {
+    if (tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(index);
+        shows(tab)) {
+      return tab;
+    }
+  }
+  return nullptr;
+}
