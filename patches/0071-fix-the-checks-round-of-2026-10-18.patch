+// folders F17 (BACKLOG S-129): the restart cases of a tab's folder path, in
+// the drawn sidebar. A row is dragged onto a folder's header and the header's
+// menu is used the way a person does.
+class RestoreFolderTest : public VerticalTabsBrowserTestMixin<RestoreTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<RestoreTest>::SetUpOnMainThread();
+    stedding::test::KeepAboveOtherWindows(widget());
+  }
+
+  views::Widget* widget() {
+    return BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  }
+
+  gfx::Point RowCentre(const tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    TabView* const row =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+    CHECK(row);
+    return row->GetBoundsInScreen().CenterPoint();
+  }
+
+  gfx::Point HeaderCentre(const tabs::FolderTabCollection* folder) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    FolderView* const view =
+        stedding::test::FindDrawnFolder(widget()->GetRootView(), folder);
+    CHECK(view);
+    return view->GetHeaderBoundsInScreen().CenterPoint();
+  }
+
+  // Presses at `from`, moves to `to` in twelve even steps, releases: a
+  // person's drag, sent to the window's root view (as TabDropTest drags).
+  void Drag(const gfx::Point& from, const gfx::Point& to) {
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed,
+                                  from);
+    for (int step = 1; step <= 12; ++step) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * step / 12,
+                     from.y() + (to.y() - from.y()) * step / 12));
+    }
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, to);
+    base::RunLoop().RunUntilIdle();
+  }
+
+  // Picks `command` from the menu of `folder`'s drawn header.
+  void PickFromTheHeadersMenu(const tabs::FolderTabCollection* folder,
+                              int command) {
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    FolderView* const header =
+        stedding::test::FindDrawnFolder(widget()->GetRootView(), folder);
+    ASSERT_TRUE(header);
+    ASSERT_TRUE(header->IsCommandIdEnabled(command));
+    header->ExecuteCommand(command, /*event_flags=*/0);
+  }
+
+  static SessionID SessionIdOf(tabs::TabInterface* tab) {
+    return sessions::SessionTabHelper::IdForTab(tab->GetContents());
+  }
+};
+
+// F17: the tree changes and no tab changes index -- a tab dropped on the
+// header of the folder just above it, a nested folder's and a top-level
+// folder's tabs moved out with Move Tabs Out of Folder -- and a folder's tab
+// gets new contents, a new session tab, from Sleep Tab and from its Space
+// getting a session of its own. After a restart each tab is in the folder it
+// was in, or out of the one it left.
+IN_PROC_BROWSER_TEST_F(RestoreFolderTest,
+                       PRE_ADropAMoveOutAndNewContentsKeepTheirFolders) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const SpaceId home = m->active_id();
+  // Every tab before any folder: a tab opened from a folder's tab would join
+  // that folder (folders F25).
+  tabs::TabInterface* const f1 = Open("f1.test");
+  tabs::TabInterface* const f2 = Open("f2.test");
+  tabs::TabInterface* const dropped = Open("dropped.test");
+  tabs::TabInterface* const o1 = Open("o1.test");
+  tabs::TabInterface* const m1 = Open("m1.test");
+  tabs::TabInterface* const m2 = Open("m2.test");
+  tabs::TabInterface* const t1 = Open("t1.test");
+  tabs::TabInterface* const t2 = Open("t2.test");
+  tabs::TabInterface* const s1 = Open("s1.test");
+  tabs::TabInterface* const s2 = Open("s2.test");
+
+  {
+    SCOPED_TRACE("a drop on the header");
+    tabs::FolderTabCollection* const reading =
+        tabs()->AddToNewFolder({Index(f1), Index(f2)});
+    ASSERT_TRUE(reading);
+    reading->SetTitle("Reading");
+    const int at = Index(dropped);
+    Drag(RowCentre(dropped), HeaderCentre(reading));
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return FolderOf(dropped) == reading; }))
+        << "the drop on the header did not file the tab";
+    EXPECT_EQ(at, Index(dropped)) << "the drop moved the tab";
+  }
+
+  {
+    SCOPED_TRACE("Move Tabs Out of Folder");
+    tabs::FolderTabCollection* const outer =
+        tabs()->AddToNewFolder({Index(o1), Index(m1), Index(m2)});
+    ASSERT_TRUE(outer);
+    outer->SetTitle("Outer");
+    tabs::FolderTabCollection* const inner =
+        tabs()->AddToNewFolder({Index(m1), Index(m2)}, outer);
+    ASSERT_TRUE(inner);
+    inner->SetTitle("Inner");
+    tabs::FolderTabCollection* const done =
+        tabs()->AddToNewFolder({Index(t1), Index(t2)});
+    ASSERT_TRUE(done);
+    done->SetTitle("Done");
+    const int m1_at = Index(m1);
+    const int t1_at = Index(t1);
+    ASSERT_NO_FATAL_FAILURE(
+        PickFromTheHeadersMenu(inner, FolderView::kMoveTabsOutCommand));
+    ASSERT_EQ(outer, FolderOf(m1)) << "out of Inner, still in Outer";
+    ASSERT_EQ(outer, FolderOf(m2));
+    ASSERT_NO_FATAL_FAILURE(
+        PickFromTheHeadersMenu(done, FolderView::kMoveTabsOutCommand));
+    ASSERT_EQ(nullptr, FolderOf(t1));
+    ASSERT_EQ(nullptr, FolderOf(t2));
+    EXPECT_EQ(m1_at, Index(m1)) << "a tab moved";
+    EXPECT_EQ(t1_at, Index(t1)) << "a tab moved";
+  }
+
+  {
+    SCOPED_TRACE("Sleep Tab");
+    tabs::FolderTabCollection* const later =
+        tabs()->AddToNewFolder({Index(s1), Index(s2)});
+    ASSERT_TRUE(later);
+    later->SetTitle("Later");
+    ASSERT_NE(s1, tabs()->GetActiveTab());
+    const SessionID awake = SessionIdOf(s1);
+    stedding::SleepTabs(browser(), s1, stedding::SleepScope::kThisTab);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return s1->GetContents()->WasDiscarded(); }));
+    EXPECT_NE(awake, SessionIdOf(s1)) << "the sleep kept the contents";
+    EXPECT_EQ(later, FolderOf(s1));
+  }
+
+  {
+    SCOPED_TRACE("a jar rebind");
+    const SpaceId jar = m->AddSpace("Jar", SK_ColorBLUE)->id();
+    ASSERT_TRUE(m->SetActiveSpace(jar));
+    tabs::TabInterface* const j1 = Open("j1.test");
+    tabs::TabInterface* const j2 = Open("j2.test");
+    tabs::FolderTabCollection* const kept =
+        tabs()->AddToNewFolder({Index(j1), Index(j2)});
+    ASSERT_TRUE(kept);
+    kept->SetTitle("Kept");
+    ASSERT_TRUE(m->SetActiveSpace(home));
+    const SessionID shared = SessionIdOf(j1);
+    m->SetSpaceIsolated(jar, true);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return spaces::IsSpaceStoragePartition(
+                 spaces::StoragePartitionConfigForWebContents(
+                     j1->GetContents())) &&
+             spaces::IsSpaceStoragePartition(
+                 spaces::StoragePartitionConfigForWebContents(
+                     j2->GetContents()));
+    })) << "the Space's tabs did not move to its own jar";
+    EXPECT_NE(shared, SessionIdOf(j1)) << "the rebind kept the contents";
+    EXPECT_EQ(kept, FolderOf(j1));
+  }
+}
