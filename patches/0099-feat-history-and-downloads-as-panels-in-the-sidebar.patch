+class SidebarPanelsTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        &content::SlowDownloadHttpResponse::HandleSlowDownloadRequest));
+    embedded_test_server()->ServeFilesFromSourceDirectory("chrome/test/data");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  void TearDownOnMainThread() override {
+    stedding::SetMoveToTrashForTesting(base::NullCallback());
+    // A download still in progress would hold the browser's shutdown.
+    content::DownloadManager::DownloadVector items;
+    manager()->GetAllDownloads(&items);
+    for (download::DownloadItem* const item : items) {
+      if (item->GetState() == download::DownloadItem::IN_PROGRESS) {
+        item->Cancel(/*user_cancel=*/true);
+      }
+    }
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* window() { return browser_view()->GetWidget(); }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  stedding::SidebarPanels* panels() {
+    return stedding::SidebarPanels::From(browser());
+  }
+  stedding::SidebarPanelView* panel_view() {
+    return region()->sidebar_panel_view_for_testing();
+  }
+  content::WebContents* panel_page() {
+    return panel_view() ? panel_view()->web_view()->GetWebContents() : nullptr;
+  }
+  content::DownloadManager* manager() {
+    return browser()->GetProfile()->GetDownloadManager();
+  }
+  TabStripModel* tabs() { return browser()->tab_strip_model(); }
+  void Layout() { views::test::RunScheduledLayout(window()); }
+  bool Animating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+
+  // Waits until `panel` is the one in the sidebar's column -- none for
+  // kNone -- and its page has built itself.
+  [[nodiscard]] bool WaitForPanel(SidebarPanel panel) {
+    if (!base::test::RunUntil([&]() {
+          Layout();
+          stedding::SidebarPanelView* const view = panel_view();
+          return panel == SidebarPanel::kNone
+                     ? view == nullptr
+                     : view != nullptr && view->panel() == panel;
+        })) {
+      return false;
+    }
+    if (panel == SidebarPanel::kNone) {
+      return true;
+    }
+    content::WebContents* const page = panel_page();
+    if (!content::WaitForLoadStop(page)) {
+      return false;
+    }
+    return base::test::RunUntil([&]() {
+      return content::EvalJs(page, "document.body.dataset.panel || ''")
+                 .ExtractString() != "";
+    });
+  }
+
+  int RowCount() {
+    return content::EvalJs(panel_page(),
+                           "document.querySelectorAll('#list .row').length")
+        .ExtractInt();
+  }
+  [[nodiscard]] bool WaitForRows(int count) {
+    return base::test::RunUntil([&]() { return RowCount() == count; });
+  }
+  // Scrolls the panel's list to its end, where the next page loads (Pn6).
+  void ScrollToTheEnd() {
+    ASSERT_TRUE(content::ExecJs(
+        panel_page(),
+        "{ const list = document.getElementById('list');"
+        "  list.scrollTop = list.scrollHeight; }"));
+  }
+  // Scrolls to the list's end until it holds `count` rows, as a person
+  // scrolls on when the next rows have not come yet.
+  [[nodiscard]] bool ScrollUntilRows(int count) {
+    return base::test::RunUntil([&]() {
+      ScrollToTheEnd();
+      return RowCount() == count;
+    });
+  }
+  // Types `text` into the panel's search field, as a person does.
+  void Search(const std::string& text) {
+    ASSERT_TRUE(content::ExecJs(
+        panel_page(),
+        content::JsReplace("{ const field = document.getElementById('search');"
+                           "  field.value = $1;"
+                           "  field.dispatchEvent(new Event('input')); }",
+                           text)));
+  }
+  // Runs the row menu's `action` on the row whose `attribute` is `key`.
+  void RunMenu(const std::string& attribute,
+               const std::string& key,
+               const std::string& action) {
+    ASSERT_TRUE(content::ExecJs(
+        panel_page(), RowFor(attribute, key) +
+                          ".querySelector('.menu-button').click();" +
+                          content::JsReplace(
+                              "document.querySelector("
+                              "    '#menu [data-action=\"' + $1 + '\"]').click();",
+                              action)));
+  }
+
+  history::HistoryService* history() {
+    return HistoryServiceFactory::GetForProfile(
+        browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  }
+  void AddVisit(const GURL& url, const std::u16string& title, base::Time when) {
+    history()->AddPageWithDetails(url, title, /*visit_count=*/1,
+                                  /*typed_count=*/0, when, /*hidden=*/false,
+                                  history::SOURCE_BROWSED);
+  }
+
+  // Starts a download that stays in progress until the test ends it.
+  download::DownloadItem* StartSlowDownload() {
+    content::DownloadTestObserverInProgress in_progress(manager(), 1);
+    ui_test_utils::NavigateToURLWithDisposition(
+        browser(),
+        embedded_test_server()->GetURL(
+            content::SlowDownloadHttpResponse::kKnownSizeUrl),
+        WindowOpenDisposition::CURRENT_TAB,
+        ui_test_utils::BROWSER_TEST_NO_WAIT);
+    in_progress.WaitForFinished();
+    content::DownloadManager::DownloadVector items;
+    manager()->GetAllDownloads(&items);
+    return items.size() == 1 ? items.front().get() : nullptr;
+  }
+  // Downloads a small file to the end.
+  download::DownloadItem* DownloadAFile() {
+    content::DownloadTestObserverTerminal done(
+        manager(), 1,
+        content::DownloadTestObserver::ON_DANGEROUS_DOWNLOAD_FAIL);
+    ui_test_utils::NavigateToURLWithDisposition(
+        browser(),
+        embedded_test_server()->GetURL("/downloads/a_zip_file.zip"),
+        WindowOpenDisposition::CURRENT_TAB,
+        ui_test_utils::BROWSER_TEST_NO_WAIT);
+    done.WaitForFinished();
+    content::DownloadManager::DownloadVector items;
+    manager()->GetAllDownloads(&items);
+    return items.size() == 1 &&
+                   items.front()->GetState() ==
+                       download::DownloadItem::COMPLETE
+               ? items.front().get()
+               : nullptr;
+  }
+
+  std::vector<ui::FileInfo> ClipboardFiles() {
+    base::test::TestFuture<std::vector<ui::FileInfo>> files;
+    ui::Clipboard::GetForCurrentThread()->ReadFilenames(
+        ui::ClipboardBuffer::kCopyPaste, std::nullopt, files.GetCallback());
+    return files.Take();
+  }
+};
