+// The page's radio buttons as a screen reader is told of them: how many
+// there are, and the name of each one reported checked.
+struct ScreenReaderRadiosB05 {
+  size_t count = 0;
+  std::vector<std::string> checked;
+};
+
+ScreenReaderRadiosB05 RadiosForAScreenReaderB05(content::WebContents* page) {
+  ScreenReaderRadiosB05 radios;
+  for (const ui::AXNodeData& node :
+       content::GetAccessibilityTreeSnapshot(page).nodes) {
+    if (node.role != ax::mojom::Role::kRadioButton) {
+      continue;
+    }
+    ++radios.count;
+    if (node.GetCheckedState() == ax::mojom::CheckedState::kTrue) {
+      radios.checked.emplace_back(base::TrimWhitespaceASCII(
+          node.GetStringAttribute(ax::mojom::StringAttribute::kName),
+          base::TRIM_ALL));
+    }
+  }
+  return radios;
+}
+
+// Turns on the page's accessibility tree, as a screen reader does, and
+// answers the radio buttons once every tile of the step is in it. The
+// tree is built after the choice was made, so it holds that choice.
+ScreenReaderRadiosB05 RadiosOnceInTheTreeB05(content::WebContents* page) {
+  const int tiles =
+      content::EvalJs(page, "document.querySelectorAll('main .tile').length")
+          .ExtractInt();
+  content::ScopedAccessibilityModeOverride accessibility(
+      page, ui::kAXModeDefaultForTests);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return RadiosForAScreenReaderB05(page).count ==
+           static_cast<size_t>(tiles);
+  })) << "the step's " << tiles
+      << " tiles never reached the accessibility tree as radio buttons";
+  return RadiosForAScreenReaderB05(page);
+}
