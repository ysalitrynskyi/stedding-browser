+std::optional<SkColor> AppBrowserController::ApplyDarkPagesToThemeColor(
+    std::optional<SkColor> color) const {
+  if (!color) {
+    return color;
+  }
+  // The decision is the page's own (stedding::DarkPagesApplyTo): the switch,
+  // and the lists for the site the app window shows now. Init() asks before
+  // the window has a tab, and the colour it gets then stays until the first
+  // page has loaded (OnTabStripModelChanged waits for DOMContentLoaded), while
+  // the content area is already the darkened canvas (Dk7). So with no page
+  // yet the app's start address decides, and an app opened while dark pages
+  // is on has a dark title bar from the start, not a light one over a dark
+  // canvas for the whole first load (Dk8, web apps Wa9).
+  content::WebContents* const contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  const bool darkened = contents
+                            ? stedding::DarkPagesApplyTo(contents)
+                            : stedding::DarkPagesApplyToUrl(
+                                  browser()->GetProfile(), GetAppStartUrl());
+  return stedding::ThemeColorUnderDarkPages(*color, darkened);
+}
