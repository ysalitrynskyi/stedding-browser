+// the page's middle to the sidebar's downloads button, which rings as it
+// lands. With motion off there is no flight, and the ring alone holds still
+// for a second. A page too short to cross gets the ring alone.
+void ShowSteddingDownloadStarted(Profile* profile,
+                                 content::WebContents* web_contents,
+                                 views::View& button) {
+  const bool animate = stedding::ShouldAnimate(profile->GetPrefs()) &&
+                       gfx::Animation::ShouldRenderRichAnimation();
+  if (!animate) {
+    ShowSteddingDownloadRing(&button, /*still=*/true);
+    return;
+  }
+  const ui::ColorProvider* const colors = button.GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  if (web_contents->GetContainerBounds().height() <
+      2 * stedding::kDownloadChipDip) {
+    ShowSteddingDownloadRing(&button, /*still=*/false);
+    return;
+  }
+  // The flight deletes itself when it is done.
+  new SteddingDownloadFlightViews(
+      web_contents, button.GetBoundsInScreen(),
+      colors->GetColor(ui::kColorButtonBackgroundProminent),
+      colors->GetColor(ui::kColorButtonForegroundProminent));
+  // The ring as the chip lands, round the button if it is still there.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](std::unique_ptr<views::ViewTracker> tracker) {
+            ShowSteddingDownloadRing(tracker->view(), /*still=*/false);
+          },
+          std::make_unique<views::ViewTracker>(&button)),
+      stedding::kDownloadRingDelay);
+}
