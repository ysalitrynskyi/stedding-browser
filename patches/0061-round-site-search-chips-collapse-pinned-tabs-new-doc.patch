+      continue;
+    }
+    SCOPED_TRACE(base::UTF16ToUTF8(site->keyword()));
+    bar = OpenBar();
+    ASSERT_TRUE(bar);
+    Type(bar, site->keyword());
+    for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+      EXPECT_NE(u"Tab", bar->row_detail_for_testing(i))
+          << base::UTF16ToUTF8(bar->row_title_for_testing(i));
+    }
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+  }
+}
+
 }  // namespace
diff --git a/chrome/test/stedding/pinned_run_browsertest.cc b/chrome/test/stedding/pinned_run_browsertest.cc
new file mode 100644
index 0000000000000..550f72e8bf633
--- /dev/null
+++ b/chrome/test/stedding/pinned_run_browsertest.cc
@@ -0,0 +1,222 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Collapse Pinned Tabs (docs/features/pins.md H17, BACKLOG S-114), Arc's way
+// of putting a Space's pinned run out of sight without hiding the sidebar.
+// The Space menu's row collapses the run: its pin rows leave the sidebar,
+// the selected pin keeps its row and nothing else of the run shows, and the
+// Clear line stays between the run and the tabs below it. Expand Pinned Tabs
+// brings the rows back, and the state is the Space's across a restart.
+
+#include <optional>
+#include <string>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/spaces/space_switcher_view.h"
+#include "chrome/browser/ui/views/tabs/common/clear_tabs_separator.h"
+#include "chrome/browser/ui/views/tabs/common/tab_view.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/test/browser_test.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace {
+
+// The first view of class T at or under `view`.
+template <typename T>
+T* FindView(views::View* view) {
+  if (T* const found = views::AsViewClass<T>(view)) {
+    return found;
+  }
+  for (views::View* const child : view->children()) {
+    if (T* const found = FindView<T>(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// The Clear line the sidebar draws, with room to be seen, or null.
+ClearTabsSeparator* FindDrawnClearLine(views::View* view) {
+  if (auto* const line = views::AsViewClass<ClearTabsSeparator>(view);
+      line && line->IsDrawn() && line->shows_clear() && line->height() > 0) {
+    return line;
+  }
+  for (views::View* const child : view->children()) {
+    if (ClearTabsSeparator* const found = FindDrawnClearLine(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+class PinnedRunTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+  spaces::SpaceModel& model() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model) << "a normal window has Spaces";
+    return *model;
+  }
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+
+  tabs::TabInterface* AddBlankTab() {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), GURL(url::kAboutBlankURL),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs().GetActiveTab();
+  }
+
+  // The Space menu for the active Space, as the sidebar's Space title and the
+  // switcher's chips open it.
+  ui::SimpleMenuModel* SpaceMenu() {
+    spaces::SpaceSwitcherView* const switcher =
+        FindView<spaces::SpaceSwitcherView>(widget()->GetRootView());
+    return switcher ? switcher->BuildMenuForTesting(model().active_id())
+                    : nullptr;
+  }
+  // The index of `menu`'s row titled `label`.
+  static std::optional<size_t> RowOf(ui::SimpleMenuModel* menu,
+                                     const std::u16string& label) {
+    for (size_t i = 0; menu && i < menu->GetItemCount(); ++i) {
+      if (menu->GetLabelAt(i) == label) {
+        return i;
+      }
+    }
+    return std::nullopt;
+  }
+
+  // Runs the Space menu's row titled `label`, as a click on it does.
+  void RunSpaceMenuRow(const std::u16string& label) {
+    ui::SimpleMenuModel* const menu = SpaceMenu();
+    ASSERT_TRUE(menu) << "the sidebar has no Space switcher";
+    const std::optional<size_t> row = RowOf(menu, label);
+    ASSERT_TRUE(row.has_value())
+        << "the Space menu has no row " << base::UTF16ToUTF8(label);
+    ASSERT_TRUE(menu->IsEnabledAt(*row)) << base::UTF16ToUTF8(label);
+    menu->ActivatedAt(*row);
+  }
+
+  // Whether the sidebar draws a row for `tab`, after a layout.
+  bool RowShown(const tabs::TabInterface* tab) {
+    views::test::RunScheduledLayout(widget());
+    return stedding::test::FindDrawnRow(widget()->GetRootView(), tab) !=
+           nullptr;
+  }
+
+  bool ClearLineShown() {
+    views::test::RunScheduledLayout(widget());
+    return FindDrawnClearLine(widget()->GetRootView()) != nullptr;
+  }
+};
+
+// pins H17: Collapse Pinned Tabs in the Space menu hides the pin rows and
+// keeps the Clear line; the selected pin keeps its row, and it alone; Expand
+// Pinned Tabs brings every pin row back.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest,
+                       CollapsingHidesThePinRowsButTheSelectedOne) {
+  tabs::TabInterface* const pin_a = tabs().GetActiveTab();
+  ASSERT_TRUE(pin_a);
+  // With no pin in the Space there is nothing to collapse: the row is there,
+  // disabled, and says why.
+  {
+    ui::SimpleMenuModel* const menu = SpaceMenu();
+    ASSERT_TRUE(menu) << "the sidebar has no Space switcher";
+    const std::optional<size_t> row = RowOf(menu, u"Collapse Pinned Tabs");
+    ASSERT_TRUE(row.has_value());
+    EXPECT_FALSE(menu->IsEnabledAt(*row));
+    EXPECT_EQ(u"No pinned tabs", menu->GetMinorTextAt(*row));
+  }
+  model().SetSpacePinned(pin_a, true);
+  tabs::TabInterface* const pin_b = AddBlankTab();
+  model().SetSpacePinned(pin_b, true);
+  tabs::TabInterface* const loose = AddBlankTab();
+  ASSERT_TRUE(model().IsSpacePinned(pin_a));
+  ASSERT_TRUE(model().IsSpacePinned(pin_b));
+  ASSERT_FALSE(model().IsSpacePinned(loose));
+  ASSERT_EQ(loose, tabs().GetActiveTab());
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  ASSERT_TRUE(RowShown(pin_a));
+  ASSERT_TRUE(RowShown(pin_b));
+  ASSERT_TRUE(RowShown(loose));
+  ASSERT_TRUE(ClearLineShown()) << "a pinned run and a tab below it";
+
+  RunSpaceMenuRow(u"Collapse Pinned Tabs");
+  EXPECT_TRUE(model().ArePinsCollapsed(model().active_id()));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !RowShown(pin_a) && !RowShown(pin_b); }))
+      << "the pin rows leave the sidebar";
+  EXPECT_TRUE(RowShown(loose));
+  EXPECT_TRUE(ClearLineShown()) << "the line stays under a collapsed run";
+  EXPECT_EQ(3, tabs().count()) << "collapsing closes nothing";
+  EXPECT_TRUE(model().IsSpacePinned(pin_a)) << "and unpins nothing";
+
+  // The selected pin keeps its row, and only its row.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(pin_a));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return RowShown(pin_a); }))
+      << "the selected pin shows";
+  EXPECT_FALSE(RowShown(pin_b)) << "the rest of the run stays hidden";
+  EXPECT_TRUE(ClearLineShown());
+
+  // Leaving the pin puts its row away again.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(loose));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !RowShown(pin_a); }));
+
+  RunSpaceMenuRow(u"Expand Pinned Tabs");
+  EXPECT_FALSE(model().ArePinsCollapsed(model().active_id()));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return RowShown(pin_a) && RowShown(pin_b); }))
+      << "every pin row comes back";
+  EXPECT_TRUE(RowShown(loose));
+  EXPECT_TRUE(ClearLineShown());
+}
+
+// pins H17: the collapse is the Space's, kept with its name and colour, so
+// it is there after a restart; a Space that was not collapsed is not.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, PRE_TheCollapseSurvivesARestart) {
+  spaces::Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  ASSERT_TRUE(work);
+  model().SetPinsCollapsed(work->id(), true);
+  ASSERT_TRUE(model().ArePinsCollapsed(work->id()));
+}
+
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, TheCollapseSurvivesARestart) {
+  std::optional<spaces::SpaceId> work;
+  std::optional<spaces::SpaceId> other;
+  for (const auto& space : model().spaces()) {
+    if (space->name() == "Work") {
+      work = space->id();
+    } else {
+      other = space->id();
+    }
+  }
+  ASSERT_TRUE(work.has_value()) << "the Space came back";
+  EXPECT_TRUE(model().ArePinsCollapsed(*work));
+  ASSERT_TRUE(other.has_value());
+  EXPECT_FALSE(model().ArePinsCollapsed(*other));
+}
+
+}  // namespace
