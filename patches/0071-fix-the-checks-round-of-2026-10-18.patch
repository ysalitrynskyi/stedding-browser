+    for (size_t i = 1; i < drawn.size(); ++i) {
+      EXPECT_EQ(drawn[0].bounds.x(), drawn[i].bounds.x())
+          << "card " << i << " leaves the column: "
+          << drawn[i].bounds.ToString();
+      EXPECT_GE(drawn[i].bounds.y(), drawn[i - 1].bounds.bottom())
+          << "card " << i << " beside the one above it";
+    }
+    for (const Card& card : drawn) {
+      EXPECT_FALSE(card.titled);
+    }
+  }
