+// The screen as it is, but with the pointer resting at `point` for as long as
+// this lives: a browser test cannot move the real pointer, and a row asks the
+// screen where the pointer is when the row is added to the window. Every other
+// question goes to the real screen, which keeps its displays and observers.
+class PointerRestingAt : public display::Screen {
+ public:
+  explicit PointerRestingAt(const gfx::Point& point)
+      : real_(display::Screen::SetScreenInstance(nullptr)), point_(point) {
+    // A screen is not replaced in place; the real one is set aside above and
+    // put back below.
+    display::Screen::SetScreenInstance(this);
+  }
+  PointerRestingAt(const PointerRestingAt&) = delete;
+  PointerRestingAt& operator=(const PointerRestingAt&) = delete;
+  ~PointerRestingAt() override {
+    display::Screen::SetScreenInstance(nullptr);
+    display::Screen::SetScreenInstance(real_);
+  }
+
+  // display::Screen:
+  gfx::Point GetCursorScreenPoint() override { return point_; }
+  bool IsWindowUnderCursor(gfx::NativeWindow window) override {
+    return real_->IsWindowUnderCursor(window);
+  }
+  gfx::NativeWindow GetWindowAtScreenPoint(const gfx::Point& point) override {
+    return real_->GetWindowAtScreenPoint(point);
+  }
+  gfx::NativeWindow GetLocalProcessWindowAtPoint(
+      const gfx::Point& point,
+      const std::set<gfx::NativeWindow>& ignore) override {
+    return real_->GetLocalProcessWindowAtPoint(point, ignore);
+  }
+  int GetNumDisplays() const override { return real_->GetNumDisplays(); }
+  const std::vector<display::Display>& GetAllDisplays() const override {
+    return real_->GetAllDisplays();
+  }
+  display::Display GetDisplayNearestWindow(
+      gfx::NativeWindow window) const override {
+    return real_->GetDisplayNearestWindow(window);
+  }
+  display::Display GetDisplayNearestView(
+      gfx::NativeView view) const override {
+    return real_->GetDisplayNearestView(view);
+  }
+  display::Display GetDisplayNearestPoint(
+      const gfx::Point& point) const override {
+    return real_->GetDisplayNearestPoint(point);
+  }
+  display::Display GetDisplayMatching(
+      const gfx::Rect& match_rect) const override {
+    return real_->GetDisplayMatching(match_rect);
+  }
+  display::Display GetPrimaryDisplay() const override {
+    return real_->GetPrimaryDisplay();
+  }
+  void AddObserver(display::DisplayObserver* observer) override {
+    real_->AddObserver(observer);
+  }
+  void RemoveObserver(display::DisplayObserver* observer) override {
+    real_->RemoveObserver(observer);
+  }
+  gfx::Rect ScreenToDIPRectInWindow(
+      gfx::NativeWindow window,
+      const gfx::Rect& screen_rect) const override {
+    return real_->ScreenToDIPRectInWindow(window, screen_rect);
+  }
+  gfx::Rect DIPToScreenRectInWindow(gfx::NativeWindow window,
+                                    const gfx::Rect& dip_rect) const override {
+    return real_->DIPToScreenRectInWindow(window, dip_rect);
+  }
+  std::optional<float> GetPreferredScaleFactorForWindow(
+      gfx::NativeWindow window) const override {
+    return real_->GetPreferredScaleFactorForWindow(window);
+  }
+  std::optional<float> GetPreferredScaleFactorForView(
+      gfx::NativeView view) const override {
+    return real_->GetPreferredScaleFactorForView(view);
+  }
+  bool IsHeadless() const override { return real_->IsHeadless(); }
+
+ private:
+  const raw_ptr<display::Screen> real_;
+  const gfx::Point point_;
+};
