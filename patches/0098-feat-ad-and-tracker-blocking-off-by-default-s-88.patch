+++ b/chrome/browser/ui/stedding/blocker/blocker_convert.h
@@ -0,0 +1,79 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_CONVERT_H_
+#define CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_CONVERT_H_
+
+#include <cstddef>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/time/time.h"
+
+namespace stedding {
+
+// docs/features/blocker.md Bk2, Bk3: turning the downloaded filter lists into
+// the unindexed ruleset Chromium's subresource filter indexes. Pure functions
+// over files, run on a background sequence; no network and no profile.
+
+// Bk2: how long a list stays fresh, from its own "! Expires: N days" or
+// "! Expires: N hours" line, clamped to between one and fourteen days; four
+// days when the list has no such line in its header.
+base::TimeDelta ListExpiry(std::string_view text);
+
+// Bk3: whether `text` is a filter list at all: its first line that is not
+// empty starts with "[Adblock". A captive portal's page, an error page or an
+// empty answer is not.
+bool LooksLikeFilterList(std::string_view text);
+
+// One downloaded list, as the converter reads it and the licence file names
+// it.
+struct ListSource {
+  std::string id;
+  std::string name;
+  std::string homepage;
+  std::string licence;
+  base::FilePath path;
+};
+
+struct ConvertResult {
+  ConvertResult();
+  ConvertResult(const ConvertResult&);
+  ConvertResult& operator=(const ConvertResult&);
+  ~ConvertResult();
+
+  // False when a list could not be read, is not a filter list, holds fewer
+  // than the minimum of URL rules, or the ruleset could not be written; the
+  // ruleset published before stays (Bk3).
+  bool ok = false;
+  // The ruleset's content version: hex digits from the SHA-256 of the lists'
+  // contents and `salt`, so a list that changed gives a new version and the
+  // same lists give the same one.
+  std::string content_version;
+  base::FilePath ruleset_path;
+  base::FilePath license_path;
+  // URL rules kept (blocking and allowing).
+  int url_rules = 0;
+  // Element-hiding rules, read and dropped: this slice blocks requests only.
+  int cosmetic_rules = 0;
+  // Lines Chromium's parser could not read (rules with options it does not
+  // know), skipped and counted, never logged.
+  int skipped_lines = 0;
+};
+
+// Bk3: reads every list in `lists`, keeps their URL rules and writes one
+// unindexed ruleset and a LICENSE file naming each list, its homepage and its
+// licence into `out_dir`, both named for the content version. Earlier
+// versions' files in `out_dir` are deleted. `minimum_rules` is the fewest URL
+// rules a list must give to be taken as whole (1000 in the product).
+ConvertResult ConvertLists(const std::vector<ListSource>& lists,
+                           const base::FilePath& out_dir,
+                           std::string_view salt,
+                           size_t minimum_rules);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_CONVERT_H_
diff --git a/chrome/browser/ui/stedding/blocker/blocker_convert_unittest.cc b/chrome/browser/ui/stedding/blocker/blocker_convert_unittest.cc
new file mode 100644
index 0000000000000..f4a9e28f03579
--- /dev/null
+++ b/chrome/browser/ui/stedding/blocker/blocker_convert_unittest.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/blocker/blocker_convert.h"
+
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/strcat.h"
+#include "components/subresource_filter/core/common/unindexed_ruleset.h"
+#include "components/url_pattern_index/proto/rules.pb.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/protobuf/src/google/protobuf/io/zero_copy_stream_impl_lite.h"
+
+namespace stedding {
+
+namespace {
+
+// A small list in EasyList's format, written for these tests: three URL
+// rules (one of them an allow rule), two element-hiding rules, comments.
+constexpr char kSmallList[] =
+    "[Adblock Plus 2.0]\n"
+    "! Title: A test list\n"
+    "! Expires: 2 days (update frequency)\n"
+    "||ads.example^\n"
+    "||track.example^$script,third-party\n"
+    "@@||fine.example^$document\n"
+    "example.com##.advert\n"
+    "##.banner-ad\n"
+    "\n";
+
+class BlockerConvertTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  ListSource WriteList(std::string_view id, std::string_view text) {
+    const base::FilePath path =
+        dir_.GetPath().AppendASCII(base::StrCat({id, ".txt"}));
+    EXPECT_TRUE(base::WriteFile(path, text));
+    return {std::string(id), std::string(id) + " list",
+            "https://lists.test/" + std::string(id),
+            "CC BY-SA 3.0", path};
+  }
+
+  base::FilePath OutDir() const { return dir_.GetPath().AppendASCII("out"); }
+
+  // The URL and style rules the written ruleset holds.
+  static std::pair<int, int> CountRules(const base::FilePath& ruleset) {
+    std::string data;
+    EXPECT_TRUE(base::ReadFileToString(ruleset, &data));
+    google::protobuf::io::ArrayInputStream input(
+        data.data(), static_cast<int>(data.size()));
+    subresource_filter::UnindexedRulesetReader reader(&input);
+    url_pattern_index::proto::FilteringRules chunk;
+    int url_rules = 0;
+    int style_rules = 0;
+    while (reader.ReadNextChunk(&chunk)) {
+      url_rules += chunk.url_rules_size();
+      style_rules += chunk.style_rules_size();
+    }
+    return {url_rules, style_rules};
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+}  // namespace
+
+// Bk2: the list's own Expires line sets when it is fetched next, clamped to
+// one to fourteen days; four days when it has none.
+TEST_F(BlockerConvertTest, TheExpiresLineSetsTheExpiry) {
+  EXPECT_EQ(base::Days(2), ListExpiry(kSmallList));
+  EXPECT_EQ(base::Days(4), ListExpiry("[Adblock Plus 2.0]\n||a.example^\n"));
+  EXPECT_EQ(base::Days(1),
+            ListExpiry("[Adblock Plus 2.0]\n! Expires: 6 hours\n"));
+  EXPECT_EQ(base::Days(14),
+            ListExpiry("[Adblock Plus 2.0]\n! Expires: 30 days\n"));
+  EXPECT_EQ(base::Days(4),
+            ListExpiry("[Adblock Plus 2.0]\n! Expires: soon\n"));
+}
+
+// Bk3: URL rules go into the ruleset; element-hiding rules are read and
+// dropped, so the ruleset holds none.
+TEST_F(BlockerConvertTest, UrlRulesAreKeptAndCosmeticRulesDropped) {
+  const ConvertResult result =
+      ConvertLists({WriteList("small", kSmallList)}, OutDir(), "0",
+                   /*minimum_rules=*/1);
+  ASSERT_TRUE(result.ok);
+  EXPECT_EQ(3, result.url_rules);
+  EXPECT_EQ(2, result.cosmetic_rules);
+  EXPECT_EQ(0, result.skipped_lines);
+  EXPECT_EQ(std::make_pair(3, 0), CountRules(result.ruleset_path));
+  EXPECT_EQ(16u, result.content_version.size());
+
+  // The same lists give the same version; another salt gives another.
+  const ConvertResult again =
+      ConvertLists({WriteList("small", kSmallList)}, OutDir(), "0", 1);
+  ASSERT_TRUE(again.ok);
+  EXPECT_EQ(result.content_version, again.content_version);
+  const ConvertResult salted =
+      ConvertLists({WriteList("small", kSmallList)}, OutDir(), "1", 1);
+  ASSERT_TRUE(salted.ok);
+  EXPECT_NE(result.content_version, salted.content_version);
+  // Only the newest version's files are kept.
+  EXPECT_FALSE(base::PathExists(result.ruleset_path));
+  EXPECT_TRUE(base::PathExists(salted.ruleset_path));
+}
+
+// Bk3: rules with options Chromium's parser does not know are skipped and
+// counted; the others in the same list are kept.
+TEST_F(BlockerConvertTest, UnreadableLinesAreCounted) {
+  const std::string list = base::StrCat(
+      {kSmallList,
+       "||redirected.example^$redirect=noop.js\n"
+       "||params.example^$removeparam=utm_source\n"
+       "||policy.example^$csp=script-src 'none'\n"});
+  const ConvertResult result =
+      ConvertLists({WriteList("odd", list)}, OutDir(), "0", 1);
+  ASSERT_TRUE(result.ok);
+  EXPECT_EQ(3, result.url_rules);
+  EXPECT_EQ(3, result.skipped_lines);
+}
+
+// Bk3: a download that is not a filter list, or one far smaller than the
+// minimum, is refused; nothing is written, so the ruleset made before stays.
+TEST_F(BlockerConvertTest, ABrokenDownloadKeepsThePreviousRuleset) {
+  const ConvertResult good =
+      ConvertLists({WriteList("good", kSmallList)}, OutDir(), "0", 1);
+  ASSERT_TRUE(good.ok);
+
+  EXPECT_FALSE(LooksLikeFilterList("<html><body>Sign in to the Wi-Fi"));
+  EXPECT_TRUE(LooksLikeFilterList("\xEF\xBB\xBF[Adblock Plus 2.0]\n"));
+  const ConvertResult portal = ConvertLists(
+      {WriteList("portal", "<html><body>Sign in to the Wi-Fi</body></html>")},
+      OutDir(), "0", 1);
+  EXPECT_FALSE(portal.ok);
+  const ConvertResult short_list =
+      ConvertLists({WriteList("short", kSmallList)}, OutDir(), "0",
+                   /*minimum_rules=*/1000);
+  EXPECT_FALSE(short_list.ok);
+  EXPECT_TRUE(base::PathExists(good.ruleset_path));
+  EXPECT_TRUE(base::PathExists(good.license_path));
+}
+
+// Bk3: the LICENSE file beside the ruleset names every list, its homepage
+// and its licence.
+TEST_F(BlockerConvertTest, TheLicenceFileNamesEveryList) {
+  const ConvertResult result = ConvertLists(
+      {WriteList("first", kSmallList), WriteList("second", kSmallList)},
+      OutDir(), "0", 1);
+  ASSERT_TRUE(result.ok);
+  EXPECT_EQ(6, result.url_rules);
+  std::string license;
+  ASSERT_TRUE(base::ReadFileToString(result.license_path, &license));
+  for (std::string_view expected :
+       {"first list", "https://lists.test/first", "second list",
+        "https://lists.test/second", "CC BY-SA 3.0"}) {
+    EXPECT_NE(std::string::npos, license.find(expected)) << expected;
+  }
+}
+
+}  // namespace stedding
