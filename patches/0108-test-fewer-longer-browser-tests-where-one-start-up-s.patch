+// Whether `nodes`, or a folder among them, holds a tab of `url`.
+bool NodesHold(const std::vector<spaces::ArcImportPlan::Node>& nodes,
+               const GURL& url) {
+  for (const spaces::ArcImportPlan::Node& node : nodes) {
+    if (node.url == url || NodesHold(node.children, url)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool PlanHolds(const spaces::ArcImportPlan& plan, const GURL& url) {
+  if (NodesHold(plan.essentials, url)) {
+    return true;
+  }
+  for (const spaces::ArcImportPlan::Space& space : plan.spaces) {
+    if (NodesHold(space.pinned, url) || NodesHold(space.unpinned, url) ||
+        NodesHold(space.essentials, url)) {
+      return true;
+    }
+  }
+  return false;
+}
