From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Tue, 24 Nov 2026 17:22:40 -0500
Subject: feat: the New Tab page's tiles take their icons at the screen's scale

Chrome turns NtpMostVisitedHighDpiFavicons on for every Stable user by field
trial, which Stedding never receives (BACKLOG S-550, read again at the point
release of 2026-11-24). The most-visited tiles then ask the local favicon2
source for the screen's scale instead of one; nothing is fetched from a
server. DefaultsTest checks it is on.

Why: a 100% launch that needs no Google service is taken at each pin move
(docs/AGENT-LOOP.md).
Removable when: upstream turns the feature on by default.
---
 chrome/test/stedding/defaults_browsertest.cc | 3 +++
 components/search/ntp_features.cc            | 5 ++++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/chrome/test/stedding/defaults_browsertest.cc b/chrome/test/stedding/defaults_browsertest.cc
index 332e82ef5fa83..d7417cf391397 100644
--- a/chrome/test/stedding/defaults_browsertest.cc
+++ b/chrome/test/stedding/defaults_browsertest.cc
@@ -71,6 +71,7 @@
 #include "components/attribution_reporting/features.h"
 #include "components/autofill/core/common/autofill_features.h"
 #include "components/payments/core/features.h"
+#include "components/search/ntp_features.h"
 #include "components/prefs/pref_service.h"
 #include "components/bookmarks/common/bookmark_pref_names.h"
 #include "components/saved_tab_groups/public/tab_group_sync_service.h"
@@ -267,6 +268,8 @@ IN_PROC_BROWSER_TEST_F(DefaultsTest, AFreshProfileHoldsAndWorksAfterStay) {
              &net::features::kVerifyQWACs,
              &payments::features::kPaymentHandlerCameraAccessUx,
              &payments::features::kSPCLocaleValidation,
+             // BACKLOG S-550, read again on 2026-11-24.
+             &ntp_features::kNtpMostVisitedHighDpiFavicons,
 #if BUILDFLAG(IS_MAC)
              &display::features::kSkipPostTaskForCallbacks,
              &features::kOnlyUseWindowResizeHelperOnResize,
diff --git a/components/search/ntp_features.cc b/components/search/ntp_features.cc
index 18cbb7e915563..5993b676e3a82 100644
--- a/components/search/ntp_features.cc
+++ b/components/search/ntp_features.cc
@@ -214,7 +214,10 @@ BASE_FEATURE(kNtpSharepointModule,
 BASE_FEATURE(kNtpShortcuts, base::FEATURE_ENABLED_BY_DEFAULT);
 
 // If enabled, high-DPI favicons are fetched for Most Visited tiles.
-BASE_FEATURE(kNtpMostVisitedHighDpiFavicons, base::FEATURE_DISABLED_BY_DEFAULT);
+// Stedding (BACKLOG S-550, read again on 2026-11-24): on, as Chrome's field
+// trial has it for every Stable user. The tiles ask the local favicon2 source
+// for the screen's scale; nothing is fetched from a server.
+BASE_FEATURE(kNtpMostVisitedHighDpiFavicons, base::FEATURE_ENABLED_BY_DEFAULT);
 
 // If enabled, the Tab Resumption module will be shown.
 BASE_FEATURE(kNtpMostRelevantTabResumptionModule,
