diff --git a/chrome/browser/ui/stedding/app_updater.cc b/chrome/browser/ui/stedding/app_updater.cc
new file mode 100644
index 0000000000000..159e8210831d8
--- /dev/null
+++ b/chrome/browser/ui/stedding/app_updater.cc
@@ -0,0 +1,106 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/app_updater.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "build/build_config.h"
+
+namespace stedding {
+
+namespace {
+
+AppUpdater* g_updater = nullptr;
+AppUpdater* g_updater_for_testing = nullptr;
+
+}  // namespace
+
+// static
+AppUpdater* AppUpdater::Get() {
+  return g_updater_for_testing ? g_updater_for_testing : g_updater;
+}
+
+// static
+void AppUpdater::SetForTesting(AppUpdater* updater) {
+  g_updater_for_testing = updater;
+}
+
+// static
+void AppUpdater::SetInstance(AppUpdater* updater) {
+  g_updater = updater;
+}
+
+AppUpdater::AppUpdater() = default;
+
+AppUpdater::~AppUpdater() {
+  if (g_updater == this) {
+    g_updater = nullptr;
+  }
+}
+
+void AppUpdater::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void AppUpdater::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void AppUpdater::SetState(State state) {
+  if (state_ == state) {
+    return;
+  }
+  state_ = state;
+  if (state != State::kFailed) {
+    error_.clear();
+  }
+  if (state != State::kDownloading) {
+    progress_ = 0;
+  }
+  NotifyChanged();
+}
+
+void AppUpdater::SetVersion(std::u16string version) {
+  if (version_ == version) {
+    return;
+  }
+  version_ = std::move(version);
+  NotifyChanged();
+}
+
+void AppUpdater::SetProgress(int progress) {
+  progress = std::clamp(progress, 0, 100);
+  if (progress_ == progress) {
+    return;
+  }
+  progress_ = progress;
+  NotifyChanged();
+}
+
+void AppUpdater::SetError(std::u16string error) {
+  error_ = std::move(error);
+  NotifyChanged();
+}
+
+void AppUpdater::NotifyChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnAppUpdaterChanged();
+  }
+}
+
+bool OffersRestart(AppUpdater::State state) {
+  return state == AppUpdater::State::kReady ||
+         state == AppUpdater::State::kAvailable;
+}
+
+#if !BUILDFLAG(IS_MAC)
+// No updater on this platform yet (BACKLOG S-74): releases are installed by
+// hand, and the update's thank-you page still follows (updates Up10).
+void StartAppUpdater(PrefService* local_state,
+                     base::RepeatingClosure prepare_restart) {}
+#endif
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/app_updater.h b/chrome/browser/ui/stedding/app_updater.h
new file mode 100644
index 0000000000000..b052078444575
--- /dev/null
+++ b/chrome/browser/ui/stedding/app_updater.h
@@ -0,0 +1,114 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_APP_UPDATER_H_
+#define CHROME_BROWSER_UI_STEDDING_APP_UPDATER_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+
+class PrefService;
+
+namespace stedding {
+
+// The browser's own updater (docs/features/updates.md): Sparkle on the Mac
+// (ADR 0022), none yet elsewhere. One per process, made at startup; the
+// sidebar's button, the command bar, the About page and the app menu read it
+// and drive it. Everything runs on the UI thread.
+class AppUpdater {
+ public:
+  enum class State {
+    // Nothing found yet, or automatic updates are off and nobody asked.
+    kIdle,
+    // A check the user asked for is under way (About, Check for Updates).
+    kChecking,
+    // That check found nothing later than this version.
+    kUpToDate,
+    // A later version was found and is downloading.
+    kDownloading,
+    // A later version was found and waits for the user's go-ahead to
+    // download it, as Sparkle asks when installing it needs the user's
+    // password (updates Up4).
+    kAvailable,
+    // A later version is downloaded and ready: a restart installs it, and so
+    // does quitting (updates Up3).
+    kReady,
+    // Restarting into it.
+    kInstalling,
+    // The check or the download failed; error() says why.
+    kFailed,
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnAppUpdaterChanged() = 0;
+  };
+
+  // The process's updater, or null: this build has none (Windows, a build
+  // without Sparkle, a test).
+  static AppUpdater* Get();
+  // Tests: `updater` answers Get() until it is reset with null.
+  static void SetForTesting(AppUpdater* updater);
+
+  AppUpdater(const AppUpdater&) = delete;
+  AppUpdater& operator=(const AppUpdater&) = delete;
+  virtual ~AppUpdater();
+
+  State state() const { return state_; }
+  // The later version's name, as its release calls it ("0.2.0-beta.16"),
+  // once one is found.
+  const std::u16string& version() const { return version_; }
+  // 0-100 while downloading.
+  int progress() const { return progress_; }
+  // What went wrong, in a sentence, in kFailed.
+  const std::u16string& error() const { return error_; }
+
+  // Checks now, whatever the automatic setting says: the user asked. A later
+  // version found this way downloads at once (updates Up5).
+  virtual void CheckNow() = 0;
+  // Restarts into the downloaded version (kReady), or, in kAvailable,
+  // downloads it and then restarts (updates Up3, Up4).
+  virtual void InstallNow() = 0;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ protected:
+  AppUpdater();
+
+  // The platform's updater, once made (StartAppUpdater).
+  static void SetInstance(AppUpdater* updater);
+
+  void SetState(State state);
+  void SetVersion(std::u16string version);
+  void SetProgress(int progress);
+  void SetError(std::u16string error);
+  // Tells the observers, once per change.
+  void NotifyChanged();
+
+ private:
+  State state_ = State::kIdle;
+  std::u16string version_;
+  int progress_ = 0;
+  std::u16string error_;
+  base::ObserverList<Observer> observers_;
+};
+
+// updates Up3, Up4: the states in which the sidebar shows its "New Stedding
+// Version Available" button and the command bar its Restart to Update row.
+bool OffersRestart(AppUpdater::State state);
+
+// Makes the process's updater, where the platform has one: the Mac, with
+// Sparkle.framework in the app bundle and a Stedding version in this build,
+// outside tests. `prepare_restart` runs before the updater quits the browser
+// to install, so the next launch restores the session as a restart does.
+void StartAppUpdater(PrefService* local_state,
+                     base::RepeatingClosure prepare_restart);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_APP_UPDATER_H_
diff --git a/chrome/browser/ui/stedding/app_updater_mac.mm b/chrome/browser/ui/stedding/app_updater_mac.mm
new file mode 100644
index 0000000000000..dd4e61722dec5
--- /dev/null
+++ b/chrome/browser/ui/stedding/app_updater_mac.mm
@@ -0,0 +1,744 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/app_updater.h"
+
+#import <Foundation/Foundation.h>
+#include <Security/Security.h>
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/apple/bundle_locations.h"
+#include "base/apple/foundation_util.h"
+#include "base/apple/scoped_cftyperef.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/logging.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/strings/sys_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding/stedding_version.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/common/content_switches.h"
+
+// Sparkle 2.10's interface, as far as Stedding uses it (the framework's
+// Headers/SPUUpdater.h, SPUUserDriver.h, SPUUpdaterDelegate.h,
+// SPUUserUpdateState.h, SUAppcastItem.h). Declared here, not imported:
+// tooling/fetch-sparkle puts the framework into the app bundle and the browser
+// loads it at runtime, so the browser builds without its headers and a bundle
+// without it has no updater rather than failing to start. Sparkle calls the
+// user driver and the delegate by selector and checks neither for a protocol.
+
+// SPUUserUpdateChoice.
+typedef NS_ENUM(NSInteger, SteddingSparkleChoice) {
+  SteddingSparkleChoiceSkip = 0,
+  SteddingSparkleChoiceInstall = 1,
+  SteddingSparkleChoiceDismiss = 2,
+};
+
+// SPUUserUpdateStage.
+typedef NS_ENUM(NSInteger, SteddingSparkleStage) {
+  SteddingSparkleStageNotDownloaded = 0,
+  SteddingSparkleStageDownloaded = 1,
+  SteddingSparkleStageInstalling = 2,
+};
+
+// SPUUpdateCheck: the check a user asked for.
+constexpr NSInteger kSparkleUserCheck = 0;
+// SPUAppcastSigningValidationStatusFailed.
+constexpr NSInteger kSparkleFeedSignatureFailed = 2;
+// SUError: no later version; the user cancelled installing it.
+constexpr NSInteger kSparkleNoUpdateError = 1001;
+constexpr NSInteger kSparkleInstallationCanceledError = 4007;
+
+@protocol SteddingSparkleUpdater <NSObject>
+- (instancetype)initWithHostBundle:(NSBundle*)hostBundle
+                 applicationBundle:(NSBundle*)applicationBundle
+                        userDriver:(id)userDriver
+                          delegate:(id)delegate;
+- (BOOL)startUpdater:(NSError**)error;
+- (void)checkForUpdates;
+@property(nonatomic) BOOL automaticallyChecksForUpdates;
+@property(nonatomic) BOOL automaticallyDownloadsUpdates;
+@property(nonatomic) BOOL sendsSystemProfile;
+@property(nonatomic, readonly) BOOL canCheckForUpdates;
+@end
+
+@protocol SteddingSparkleItem <NSObject>
+@property(nonatomic, copy, readonly) NSString* displayVersionString;
+@property(nonatomic, getter=isInformationOnlyUpdate, readonly)
+    BOOL informationOnlyUpdate;
+@property(nonatomic, readonly) NSInteger signingValidationStatus;
+@end
+
+@protocol SteddingSparkleUserState <NSObject>
+@property(nonatomic, readonly) NSInteger stage;
+@property(nonatomic, readonly) BOOL userInitiated;
+@end
+
+@protocol SteddingSparklePermissionResponse <NSObject>
+- (instancetype)initWithAutomaticUpdateChecks:(BOOL)automaticUpdateChecks
+                            sendSystemProfile:(BOOL)sendSystemProfile;
+@end
+
+typedef void (^SteddingSparkleReply)(NSInteger choice);
+
+namespace stedding {
+namespace {
+
+// How long a restart may take before the button comes back: a page's "Leave
+// site?" or the downloads' warning can stop the quit (updates Up3).
+constexpr base::TimeDelta kQuitGrace = base::Seconds(20);
+// The first scheduled check waits for startup to settle.
+constexpr base::TimeDelta kStartDelay = base::Seconds(10);
+
+class SparkleAppUpdater;
+
+}  // namespace
+}  // namespace stedding
+
+// Sparkle's user driver and updater delegate in one: everything Sparkle would
+// show, it tells SparkleAppUpdater instead, so no Sparkle window ever opens
+// (updates Up2).
+@interface SteddingSparkleBridge : NSObject
+- (instancetype)initWithUpdater:
+    (base::WeakPtr<stedding::SparkleAppUpdater>)updater;
+@end
+
+namespace stedding {
+namespace {
+
+class SparkleAppUpdater : public AppUpdater {
+ public:
+  SparkleAppUpdater(Class updater_class,
+                    PrefService* local_state,
+                    base::RepeatingClosure prepare_restart)
+      : local_state_(local_state),
+        prepare_restart_(std::move(prepare_restart)) {
+    bridge_ =
+        [[SteddingSparkleBridge alloc] initWithUpdater:weak_factory_.GetWeakPtr()];
+    NSBundle* const bundle = base::apple::OuterBundle();
+    updater_ = [(id<SteddingSparkleUpdater>)[updater_class alloc]
+        initWithHostBundle:bundle
+         applicationBundle:bundle
+                userDriver:bridge_
+                  delegate:bridge_];
+    // Nothing about the machine goes with a check (docs/PRIVACY.md).
+    updater_.sendsSystemProfile = NO;
+    ApplyAutomatic();
+    registrar_.Init(local_state_);
+    registrar_.Add(prefs::kUpdatesAutomatic,
+                   base::BindRepeating(&SparkleAppUpdater::OnAutomaticChanged,
+                                       base::Unretained(this)));
+    SetInstance(this);
+    // updates Up6: with automatic updates off Sparkle is not started at all,
+    // so it makes no request until the user asks (Check for Updates).
+    if (Automatic()) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&SparkleAppUpdater::StartOnSchedule,
+                         weak_factory_.GetWeakPtr()),
+          kStartDelay);
+    }
+  }
+
+  ~SparkleAppUpdater() override = default;
+
+  // AppUpdater:
+  void CheckNow() override {
+    switch (state()) {
+      case State::kChecking:
+      case State::kDownloading:
+      case State::kAvailable:
+      case State::kReady:
+      case State::kInstalling:
+        // An answer is in hand or on its way; the observers hear of it.
+        return;
+      case State::kIdle:
+      case State::kUpToDate:
+      case State::kFailed:
+        break;
+    }
+    if (!Start()) {
+      SetError(u"The updater could not start.");
+      SetState(State::kFailed);
+      return;
+    }
+    user_asked_ = true;
+    SetState(State::kChecking);
+    // While Sparkle checks or downloads on its own schedule it takes no
+    // check from the user; that session's answer comes through the delegate
+    // all the same.
+    if (updater_.canCheckForUpdates) {
+      [updater_ checkForUpdates];
+    }
+  }
+
+  void InstallNow() override {
+    if (state() == State::kAvailable) {
+      // Download it, then restart: the user has already said yes.
+      restart_when_ready_ = true;
+      SetState(State::kDownloading);
+      if (SteddingSparkleReply reply = TakeReply()) {
+        reply(SteddingSparkleChoiceInstall);
+      }
+      return;
+    }
+    if (state() != State::kReady) {
+      return;
+    }
+    PrepareRestart();
+    SetState(State::kInstalling);
+    if (retry_quit_) {
+      void (^retry)(void) = retry_quit_;
+      retry_quit_ = nil;
+      retry();
+    } else if (SteddingSparkleReply reply = TakeReply()) {
+      reply(SteddingSparkleChoiceInstall);
+    } else if (install_on_quit_) {
+      // Sparkle 2.3 and later take this more than once, for a quit the
+      // browser cancelled.
+      install_on_quit_();
+    }
+    WatchTheQuit();
+  }
+
+  // Sparkle, through the bridge.
+
+  void OnUserCheckStarted() {
+    user_asked_ = true;
+    SetState(State::kChecking);
+  }
+
+  void OnUpdateFound(id<SteddingSparkleItem> item,
+                     id<SteddingSparkleUserState> found,
+                     SteddingSparkleReply reply) {
+    // Each update Sparkle finds is an attempt of its own. A yes the user gave
+    // an earlier one, whose install was then cancelled at the administrator's
+    // password or failed, does not install this one without asking (BACKLOG
+    // S-343).
+    restart_when_ready_ = false;
+    // updates Up12: an informational entry, or one from a feed whose
+    // signature fails, is never offered: the feed is signed, so either means
+    // the feed is not ours.
+    if (item.informationOnlyUpdate ||
+        item.signingValidationStatus == kSparkleFeedSignatureFailed) {
+      reply(SteddingSparkleChoiceDismiss);
+      FinishUserCheck(State::kUpToDate);
+      return;
+    }
+    SetVersion(base::SysNSStringToUTF16(item.displayVersionString));
+    user_asked_ = false;
+    switch (found.stage) {
+      case SteddingSparkleStageNotDownloaded:
+      case SteddingSparkleStageDownloaded:
+        // A check the user asked for downloads at once (Up5); one Sparkle
+        // made on its schedule and could not finish alone (its install needs
+        // the user's password, Up4) waits for the button.
+        if (found.userInitiated) {
+          SetState(State::kDownloading);
+          reply(SteddingSparkleChoiceInstall);
+        } else {
+          pending_reply_ = reply;
+          SetState(State::kAvailable);
+        }
+        return;
+      case SteddingSparkleStageInstalling:
+        // Downloaded, and installing waits for the quit: the button restarts.
+        pending_reply_ = reply;
+        SetState(State::kReady);
+        return;
+    }
+    reply(SteddingSparkleChoiceDismiss);
+  }
+
+  void OnDownloadStarted() {
+    expected_ = 0;
+    received_ = 0;
+    SetState(State::kDownloading);
+  }
+
+  void OnExpectedLength(uint64_t length) {
+    expected_ = length;
+    received_ = 0;
+  }
+
+  void OnReceived(uint64_t length) {
+    received_ += length;
+    if (expected_ > 0) {
+      SetProgress(static_cast<int>(received_ * 100 / expected_));
+    }
+  }
+
+  void OnReadyToRelaunch(SteddingSparkleReply reply) {
+    if (restart_when_ready_) {
+      PrepareRestart();
+      SetState(State::kInstalling);
+      reply(SteddingSparkleChoiceInstall);
+      WatchTheQuit();
+      return;
+    }
+    pending_reply_ = reply;
+    SetState(State::kReady);
+  }
+
+  void OnInstalling(bool terminated, void (^retry)(void)) {
+    if (!terminated) {
+      retry_quit_ = retry;
+    }
+    SetState(State::kInstalling);
+  }
+
+  void OnNotFound() { FinishUserCheck(State::kUpToDate); }
+
+  void OnError(NSError* error) {
+    // The attempt the user said yes to is over, however it ended, the
+    // administrator's password cancelled included: a later one asks again
+    // (BACKLOG S-343).
+    restart_when_ready_ = false;
+    if (error.code == kSparkleInstallationCanceledError) {
+      FinishUserCheck(State::kIdle);
+      return;
+    }
+    if (error.code == kSparkleNoUpdateError) {
+      FinishUserCheck(State::kUpToDate);
+      return;
+    }
+    user_asked_ = false;
+    SetError(base::SysNSStringToUTF16(error.localizedDescription));
+    SetState(State::kFailed);
+  }
+
+  void OnDismissed() {
+    pending_reply_ = nil;
+    switch (state()) {
+      case State::kChecking:
+      case State::kDownloading:
+      case State::kAvailable:
+        // An attempt that ended with no error, a download cancelled: as in
+        // OnError, the yes was for it alone, and a version Sparkle later
+        // downloads on its schedule waits for the button (BACKLOG S-343).
+        restart_when_ready_ = false;
+        SetState(State::kIdle);
+        return;
+      case State::kReady:
+        // Sparkle still installs a prepared version at the quit; the button
+        // stays while there is a way to restart into it.
+        if (!install_on_quit_ && !retry_quit_) {
+          SetState(State::kIdle);
+        }
+        return;
+      case State::kIdle:
+      case State::kUpToDate:
+      case State::kInstalling:
+      case State::kFailed:
+        return;
+    }
+  }
+
+  void OnValidUpdate(id<SteddingSparkleItem> item) {
+    SetVersion(base::SysNSStringToUTF16(item.displayVersionString));
+    // A scheduled check downloads without telling the user driver.
+    if (state() == State::kIdle || state() == State::kChecking ||
+        state() == State::kUpToDate) {
+      SetState(State::kDownloading);
+    }
+  }
+
+  void OnNoValidUpdate() { FinishUserCheck(State::kUpToDate); }
+
+  void OnWillInstallOnQuit(id<SteddingSparkleItem> item,
+                           void (^install)(void)) {
+    install_on_quit_ = install;
+    SetVersion(base::SysNSStringToUTF16(item.displayVersionString));
+    if (restart_when_ready_) {
+      PrepareRestart();
+      SetState(State::kInstalling);
+      install_on_quit_();
+      WatchTheQuit();
+      return;
+    }
+    SetState(State::kReady);
+  }
+
+  void OnAborted(NSError* error) {
+    // As in OnError: the yes was for the attempt that stopped here.
+    restart_when_ready_ = false;
+    if (state() == State::kChecking || user_asked_) {
+      OnError(error);
+      return;
+    }
+    // A scheduled check that failed says nothing: the next one tries again.
+    VLOG(1) << "Stedding's updater stopped: "
+            << base::SysNSStringToUTF8(error.localizedDescription);
+    if (state() == State::kDownloading) {
+      SetState(State::kIdle);
+    }
+  }
+
+  void OnCycleFinished(NSError* error) {
+    if (state() != State::kChecking) {
+      return;
+    }
+    if (error && error.code != kSparkleNoUpdateError) {
+      OnError(error);
+    } else {
+      FinishUserCheck(State::kUpToDate);
+    }
+  }
+
+  bool MayCheck(NSInteger check) {
+    return check == kSparkleUserCheck || Automatic();
+  }
+
+  void PrepareRestart() {
+    if (!restart_prepared_ && prepare_restart_) {
+      restart_prepared_ = true;
+      prepare_restart_.Run();
+    }
+  }
+
+  bool Automatic() const {
+    return local_state_->GetBoolean(prefs::kUpdatesAutomatic);
+  }
+
+ private:
+  void StartOnSchedule() { Start(); }
+
+  // Starts Sparkle's schedule; false if Sparkle refused its configuration.
+  bool Start() {
+    if (started_) {
+      return true;
+    }
+    NSError* error = nil;
+    if (![updater_ startUpdater:&error]) {
+      LOG(ERROR) << "Stedding's updater did not start: "
+                 << base::SysNSStringToUTF8(error.localizedDescription);
+      return false;
+    }
+    started_ = true;
+    return true;
+  }
+
+  void ApplyAutomatic() {
+    const bool automatic = Automatic();
+    updater_.automaticallyChecksForUpdates = automatic;
+    updater_.automaticallyDownloadsUpdates = automatic;
+  }
+
+  void OnAutomaticChanged() {
+    ApplyAutomatic();
+    if (Automatic()) {
+      Start();
+    }
+  }
+
+  // Ends a check the user asked for with `result`; a scheduled check's
+  // answer changes nothing on screen.
+  void FinishUserCheck(State result) {
+    if (!user_asked_ && state() != State::kChecking) {
+      return;
+    }
+    user_asked_ = false;
+    SetState(result);
+  }
+
+  SteddingSparkleReply TakeReply() {
+    SteddingSparkleReply reply = pending_reply_;
+    pending_reply_ = nil;
+    return reply;
+  }
+
+  // updates Up3: a quit the browser cancelled ("Leave site?", downloads)
+  // brings the button back, and its next press asks Sparkle to try again.
+  void WatchTheQuit() {
+    quit_grace_.Start(FROM_HERE, kQuitGrace,
+                      base::BindOnce(&SparkleAppUpdater::OnQuitTookTooLong,
+                                     base::Unretained(this)));
+  }
+
+  void OnQuitTookTooLong() {
+    if (state() == State::kInstalling) {
+      restart_prepared_ = false;
+      // The quit was refused ("Leave site?"): the button's next press asks
+      // Sparkle again, and nothing restarts without that press.
+      restart_when_ready_ = false;
+      SetState(State::kReady);
+    }
+  }
+
+  const raw_ptr<PrefService> local_state_;
+  const base::RepeatingClosure prepare_restart_;
+  SteddingSparkleBridge* bridge_ = nil;
+  id<SteddingSparkleUpdater> updater_ = nil;
+  PrefChangeRegistrar registrar_;
+  bool started_ = false;
+  bool user_asked_ = false;
+  // The user pressed the button on a version that waited for it (kAvailable):
+  // once downloaded, it restarts into it without a second press. For that
+  // attempt only (OnUpdateFound, OnError, OnAborted, OnDismissed,
+  // OnQuitTookTooLong).
+  bool restart_when_ready_ = false;
+  bool restart_prepared_ = false;
+  uint64_t expected_ = 0;
+  uint64_t received_ = 0;
+  SteddingSparkleReply pending_reply_ = nil;
+  void (^install_on_quit_)(void) = nil;
+  void (^retry_quit_)(void) = nil;
+  base::OneShotTimer quit_grace_;
+  base::WeakPtrFactory<SparkleAppUpdater> weak_factory_{this};
+};
+
+// ADR 0022: whether the running browser is signed by a team -- a release,
+// or a test build signed the same way. A build made here is signed ad hoc,
+// and it must never be replaced by a release at its next quit.
+bool SignedByATeam() {
+  base::apple::ScopedCFTypeRef<SecCodeRef> code;
+  if (SecCodeCopySelf(kSecCSDefaultFlags, code.InitializeInto()) !=
+      errSecSuccess) {
+    return false;
+  }
+  base::apple::ScopedCFTypeRef<SecStaticCodeRef> static_code;
+  if (SecCodeCopyStaticCode(code.get(), kSecCSDefaultFlags,
+                            static_code.InitializeInto()) != errSecSuccess) {
+    return false;
+  }
+  base::apple::ScopedCFTypeRef<CFDictionaryRef> info;
+  if (SecCodeCopySigningInformation(static_code.get(),
+                                    kSecCSSigningInformation,
+                                    info.InitializeInto()) != errSecSuccess) {
+    return false;
+  }
+  CFStringRef const team = base::apple::GetValueFromDictionary<CFStringRef>(
+      info.get(), kSecCodeInfoTeamIdentifier);
+  return team && CFStringGetLength(team) > 0;
+}
+
+}  // namespace
+
+void StartAppUpdater(PrefService* local_state,
+                     base::RepeatingClosure prepare_restart) {
+  // One per process; none in tests, in a build made outside the tooling (no
+  // version to compare), out of an app bundle, or in a build signed ad hoc.
+  if (AppUpdater::Get() || !local_state || SteddingVersion().empty() ||
+      base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kTestType) ||
+      !base::apple::AmIBundled() || !SignedByATeam()) {
+    return;
+  }
+  NSString* const path = [base::apple::OuterBundle().privateFrameworksPath
+      stringByAppendingPathComponent:@"Sparkle.framework"];
+  NSBundle* const sparkle = [NSBundle bundleWithPath:path];
+  if (!sparkle) {
+    // A build without the framework (tooling/fetch-sparkle).
+    return;
+  }
+  NSError* error = nil;
+  if (![sparkle loadAndReturnError:&error]) {
+    LOG(ERROR) << "Sparkle.framework did not load: "
+               << base::SysNSStringToUTF8(error.localizedDescription);
+    return;
+  }
+  Class const updater_class = [sparkle classNamed:@"SPUUpdater"];
+  if (!updater_class) {
+    LOG(ERROR) << "Sparkle.framework has no SPUUpdater";
+    return;
+  }
+  // The process's for as long as it runs.
+  static base::NoDestructor<std::unique_ptr<SparkleAppUpdater>> updater;
+  *updater = std::make_unique<SparkleAppUpdater>(updater_class, local_state,
+                                                 std::move(prepare_restart));
+}
