+SigV4Input S3Example(const char* method, const char* url) {
+  SigV4Input input;
+  input.method = method;
+  input.url = GURL(url);
+  input.payload_hash = kEmptyHash;
+  input.amz_date = kS3Date;
+  input.region = "us-east-1";
+  input.service = "s3";
+  input.access_key = kS3Key;
+  input.secret_key = kS3Secret;
+  input.headers["x-amz-content-sha256"] = input.payload_hash;
+  input.headers["x-amz-date"] = input.amz_date;
+  return input;
+}
+
+// The examples of Amazon's "Authenticating Requests: Using the Authorization
+// Header" pages, and the signature each page gives.
+TEST(SidebarSyncSigV4Test, S3GetObjectExample) {
+  SigV4Input input =
+      S3Example("GET", "https://examplebucket.s3.amazonaws.com/test.txt");
+  input.headers["range"] = "bytes=0-9";
+  EXPECT_EQ(SigV4Authorization(input),
+            "AWS4-HMAC-SHA256 Credential=AKIA" "IOSFODNN7EXAMPLE/20130524/"
+            "us-east-1/s3/aws4_request,SignedHeaders=host;range;"
+            "x-amz-content-sha256;x-amz-date,Signature=f0e8bdb87c964420e857bd"
+            "35b5d6ed310bd44f0170aba48dd91039c6036bdb41");
+}
