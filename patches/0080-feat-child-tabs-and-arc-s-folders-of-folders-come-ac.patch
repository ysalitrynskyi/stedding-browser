+// R56: a page in the background that opens a window is the new tab's
+// parent, not the tab on screen, which Chromium takes as the opener. Seen on
+// a real build, 2026-10-21: the second window a page opened nested under the
+// first.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, ABackgroundPagesWindowIsItsOwnChild) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const first = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(first);
+  tabs()->ActivateTabAt(tabs()->GetIndexOfTab(first));
+  ASSERT_EQ(first, tabs()->GetActiveTab());
+
+  content::TestNavigationObserver opened(nullptr);
+  opened.StartWatchingNewWebContents();
+  ASSERT_TRUE(
+      content::ExecJs(page->GetContents(),
+                      content::JsReplace("window.open($1)", Url("c.test"))));
+  opened.Wait();
+  tabs::TabInterface* popup = nullptr;
+  for (int i = 0; i < tabs()->count(); ++i) {
+    tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+    if (tab != page && tab != first) {
+      popup = tab;
+    }
+  }
+  ASSERT_TRUE(popup);
+  EXPECT_EQ(stedding::TabToken(page->GetContents()),
+            stedding::TabParentToken(popup->GetContents()))
+      << "the page that called window.open, not the tab on screen";
+  EXPECT_EQ(14, Indent(popup));
+}
