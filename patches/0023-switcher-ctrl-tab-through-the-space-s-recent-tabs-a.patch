+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_SWITCHER_RECENT_TABS_SWITCHER_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_SWITCHER_RECENT_TABS_SWITCHER_VIEW_H_
+
+#include <memory>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/view.h"
+
+class Browser;
+
+namespace stedding {
+
+// docs/features/switcher.md X3: the strip of the active Space's most recent
+// tabs that appears over the page while Ctrl stays down after Ctrl-Tab. It
+// is a layered child of the BrowserView, like the command bar. The model
+// (SpaceModel's run) owns the order and the position; the strip shows them
+// and ends the run: releasing Ctrl commits, Escape cancels, and a mouse
+// press or a key without Ctrl commits too, since the run is over either way.
+class RecentTabsSwitcherView : public views::View {
+  METADATA_HEADER(RecentTabsSwitcherView, views::View)
+
+ public:
+  // Shows the strip for `browser`'s window once Ctrl has been held past the
+  // delay, or refreshes it when it is already up. No-op without a BrowserView
+  // or without a run in progress.
+  static void Show(Browser* browser);
+  static RecentTabsSwitcherView* GetOpenForTesting(Browser* browser);
+
+  explicit RecentTabsSwitcherView(Browser* browser);
+  RecentTabsSwitcherView(const RecentTabsSwitcherView&) = delete;
+  RecentTabsSwitcherView& operator=(const RecentTabsSwitcherView&) = delete;
+  ~RecentTabsSwitcherView() override;
+
+  // Rebuilds the cells from the model's run: one per tab, the position
+  // highlighted. Closes when the run is over.
+  void Refresh();
+
+  // The window monitor's events: Ctrl up, Escape, a mouse press, a key
+  // without Ctrl.
+  void OnWatchedEvent(const ui::Event& event);
+
+  // views::View:
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+  // Test seams: the paths the window monitor and the hold timer take.
+  void OnKeyEventForTesting(const ui::KeyEvent& event);
+  void FireHoldTimerForTesting();
+  bool closing_for_testing() const { return closing_; }
+  size_t cell_count_for_testing() const { return cells_.size(); }
+  size_t highlighted_for_testing() const { return highlighted_; }
+
+ private:
+  void Reveal();
+  void Commit();
+  void Cancel();
+  void Close();
+  void UpdateBounds();
+
+  // ui::EventObserver clashes with views::View::OnEvent, so a small object
+  // listens and forwards.
+  class Watcher;
+
+  const raw_ptr<Browser> browser_;
+  std::unique_ptr<Watcher> watcher_;
+  std::unique_ptr<views::EventMonitor> monitor_;
+  base::OneShotTimer hold_timer_;
+  bool closing_ = false;
+  bool revealed_ = false;
+  std::vector<raw_ptr<views::View>> cells_;
+  size_t highlighted_ = 0;
+  base::WeakPtrFactory<RecentTabsSwitcherView> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SWITCHER_RECENT_TABS_SWITCHER_VIEW_H_
