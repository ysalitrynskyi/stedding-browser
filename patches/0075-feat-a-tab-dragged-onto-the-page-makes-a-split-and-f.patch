@@ -0,0 +1,75 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/split_drop_rules.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+// splits J10 (BACKLOG S-113): the half under the pointer is the side the
+// dropped page takes, mirrored in a right-to-left layout; the middle line is
+// the right half's, and a page narrower than a drop target still has two.
+TEST(SplitDropRulesTest, TheHalfUnderThePointerIsTheSide) {
+  struct Case {
+    int x;
+    int width;
+    bool rtl;
+    SplitDropSide side;
+  };
+  const Case cases[] = {
+      {0, 1000, false, SplitDropSide::kStart},
+      {499, 1000, false, SplitDropSide::kStart},
+      {500, 1000, false, SplitDropSide::kEnd},
+      {999, 1000, false, SplitDropSide::kEnd},
+      {0, 1000, true, SplitDropSide::kEnd},
+      {499, 1000, true, SplitDropSide::kEnd},
+      {500, 1000, true, SplitDropSide::kStart},
+      {999, 1000, true, SplitDropSide::kStart},
+      // Narrower than Chromium's smallest drop target (120 DIP).
+      {10, 80, false, SplitDropSide::kStart},
+      {70, 80, false, SplitDropSide::kEnd},
+  };
+  for (const Case& c : cases) {
+    SCOPED_TRACE(testing::Message() << "x " << c.x << " of " << c.width
+                                    << (c.rtl ? ", right to left" : ""));
+    EXPECT_EQ(c.side, SplitDropSideAt(c.x, c.width, c.rtl));
+  }
+}
+
+// splits J13: one plain row, or a folder's row, onto a page that is another
+// plain tab or the New Tab page; nothing else.
+TEST(SplitDropRulesTest, WhichDragsThePageTakes) {
+  const SplitDropCandidate plain{.dragged_tabs = 1};
+  EXPECT_TRUE(PageTakesSplitDrop(plain));
+
+  struct Case {
+    const char* what;
+    SplitDropCandidate candidate;
+  };
+  const Case refused[] = {
+      {"a selection of two", {.dragged_tabs = 2}},
+      {"nothing", {.dragged_tabs = 0}},
+      {"a tab group's header",
+       {.dragged_tabs = 1, .dragged_group_header = true}},
+      {"an essential", {.dragged_tabs = 1, .dragged_essential = true}},
+      {"a Space pin", {.dragged_tabs = 1, .dragged_space_pin = true}},
+      {"a split row", {.dragged_tabs = 1, .dragged_split = true}},
+      {"no page left", {.dragged_tabs = 1, .page_missing = true}},
+      {"the row onto its own page",
+       {.dragged_tabs = 1, .page_is_dragged = true}},
+      {"onto an essential", {.dragged_tabs = 1, .page_essential = true}},
+      {"onto a Space pin", {.dragged_tabs = 1, .page_space_pin = true}},
+      {"onto a split", {.dragged_tabs = 1, .page_split = true}},
+      {"onto a browser page", {.dragged_tabs = 1, .page_browser_page = true}},
+  };
+  for (const Case& c : refused) {
+    SCOPED_TRACE(c.what);
+    EXPECT_FALSE(PageTakesSplitDrop(c.candidate));
+  }
+}
+
+}  // namespace
+}  // namespace stedding
