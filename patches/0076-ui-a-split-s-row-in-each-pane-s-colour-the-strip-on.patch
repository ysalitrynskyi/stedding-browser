+using Scheme = ThemeService::BrowserColorScheme;
+
+// The view under `root` with the element identifier `id`, or null.
+views::View* FindById(views::View* root, ui::ElementIdentifier id) {
+  if (root->GetProperty(views::kElementIdentifierKey) == id) {
+    return root;
+  }
+  for (views::View* const child : root->children()) {
+    if (views::View* const found = FindById(child, id)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// The first view of class T under `root`, or null.
+template <typename T>
+T* FindFirst(views::View* root) {
+  if (T* const found = views::AsViewClass<T>(root)) {
+    return found;
+  }
+  for (views::View* const child : root->children()) {
+    if (T* const found = FindFirst<T>(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+class HorizontalStripTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  TabStrip* strip() { return browser_view()->horizontal_tab_strip_for_testing(); }
+
+  void Open(const std::string& host) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  }
+
+  // Horizontal tabs, the window in `scheme`, laid out.
+  void ShowStrip(Scheme scheme) {
+    ExitVerticalTabsMode();
+    ASSERT_FALSE(
+        vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+    ThemeServiceFactory::GetForProfile(browser()->GetProfile())
+        ->SetBrowserColorScheme(scheme);
+    const auto mode = scheme == Scheme::kDark
+                          ? ui::ColorProviderKey::ColorMode::kDark
+                          : ui::ColorProviderKey::ColorMode::kLight;
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return browser_view()->GetWidget()->GetColorProviderKeyForTesting()
+                 .color_mode == mode;
+    }));
+    views::test::RunScheduledLayout(browser_view());
+    ASSERT_TRUE(strip());
+  }
+
+  // What a tab's style paints, at `offset` on `canvas`.
+  static void PaintInto(gfx::Canvas& canvas,
+                        const Tab* tab,
+                        const gfx::Vector2d& offset) {
+    canvas.Save();
+    canvas.Translate(offset);
+    tab->tab_style_views()->PaintTab(&canvas);
+    canvas.Restore();
+  }
+
+  static const char* Name(Scheme scheme) {
+    return scheme == Scheme::kDark ? "dark window" : "light window";
+  }
+};
+
+// tabs R49: the active tab is a detached pill, the shape a hovered tab has,
+// in the active fill; nothing of it runs down into the gutter above the
+// address row, where Chromium's skirts were.
+IN_PROC_BROWSER_TEST_F(HorizontalStripTest, TheActiveTabIsAPill) {
+  Open("a.test");
+  Open("b.test");
+  for (const Scheme scheme : {Scheme::kLight, Scheme::kDark}) {
+    SCOPED_TRACE(Name(scheme));
+    ShowStrip(scheme);
+    Tab* const active = strip()->tab_at(tab_strip_model()->active_index());
+    ASSERT_TRUE(active && active->IsActive() && active->IsDrawn());
+    const TabStyleViews* const style = active->tab_style_views();
+    const SkPath fill =
+        style->GetPath(TabStyle::PathType::kActiveTab, 1.0f, {});
+    const SkPath hover =
+        style->GetPath(TabStyle::PathType::kHighlight, 1.0f, {});
+    EXPECT_TRUE(fill.isRRect(nullptr))
+        << "the active tab is a rounded rectangle, with no skirts";
+    EXPECT_EQ(hover.getBounds(), fill.getBounds())
+        << "the active tab has the shape a hovered tab has";
+    EXPECT_LT(fill.getBounds().bottom(), active->height() - 1)
+        << "the active tab stops above the strip's foot";
+
+    gfx::Canvas canvas(active->size(), 1.0f, /*is_opaque=*/false);
+    PaintInto(canvas, active, gfx::Vector2d());
+    const SkBitmap& painted = canvas.GetBitmap();
+    const SkColor want = active->GetColorProvider()->GetColor(
+        kColorTabBackgroundActiveFrameActive);
+    const SkRect pill = fill.getBounds();
+    const SkColor middle =
+        painted.getColor(static_cast<int>(pill.centerX()),
+                         static_cast<int>(pill.centerY()));
+    EXPECT_NEAR(SkColorGetA(want), SkColorGetA(middle), 2)
+        << "the pill is the active fill, "
+        << color_utils::SkColorToRgbaString(want) << ", not "
+        << color_utils::SkColorToRgbaString(middle);
+    for (const int x : {1, active->width() - 2}) {
+      EXPECT_EQ(SK_AlphaTRANSPARENT,
+                SkColorGetA(painted.getColor(x, active->height() - 2)))
+          << "a skirt at x " << x;
+    }
+  }
+}
