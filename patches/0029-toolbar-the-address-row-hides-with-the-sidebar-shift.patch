+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_ADDRESS_ROW_RULES_H_
+#define CHROME_BROWSER_UI_STEDDING_ADDRESS_ROW_RULES_H_
+
+#include <optional>
+
+class GURL;
+
+namespace stedding {
+
+// docs/features/toolbar.md T8, T10-T12: whether the window shows its address
+// row, from what the window knows.
+struct AddressRowSignals {
+  // stedding.toolbar.hide_with_sidebar (T12).
+  bool hide_with_sidebar = true;
+  // The sidebar is collapsed to icons (T8).
+  bool sidebar_collapsed = false;
+  // The active page is a localhost page (T11).
+  bool localhost = false;
+  // shift-cmd-D's answer for the window, until the sidebar changes (T10).
+  std::optional<bool> override;
+};
+
+bool ShouldShowAddressRow(const AddressRowSignals& signals);
+
+// T11: http://localhost, 127.0.0.1, [::1] and their ports.
+bool IsLocalhostPage(const GURL& url);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_ADDRESS_ROW_RULES_H_
