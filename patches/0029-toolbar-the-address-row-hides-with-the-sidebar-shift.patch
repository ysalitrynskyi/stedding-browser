@@ -0,0 +1,26 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/address_row_rules.h"
+
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+bool ShouldShowAddressRow(const AddressRowSignals& signals) {
+  if (signals.override.has_value()) {
+    return *signals.override;
+  }
+  if (!signals.hide_with_sidebar || signals.localhost) {
+    return true;
+  }
+  return !signals.sidebar_collapsed;
+}
+
+bool IsLocalhostPage(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && net::IsLocalhost(url);
+}
+
+}  // namespace stedding
