@@ -0,0 +1,89 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_drag_target.h"
+
+#include <memory>
+#include <utility>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/spaces/space_switcher_view.h"
+
+namespace spaces {
+
+SpaceDragTarget::SpaceDragTarget(SpaceModel& model,
+                                 Browser& browser,
+                                 SpaceSwitcherView* switcher)
+    : model_(model), browser_(browser), switcher_(switcher) {}
+
+SpaceDragTarget::~SpaceDragTarget() {
+  will_destroy_callbacks_.Notify();
+}
+
+void SpaceDragTarget::SetHoveredSpace(std::optional<SpaceId> id) {
+  hovered_ = id;
+}
+
+void SpaceDragTarget::OnTabDragEntered() {}
+
+TabDragContext* SpaceDragTarget::OnTabDragUpdated(
+    TabDragTarget::DragController& controller,
+    const gfx::Point& point_in_screen) {
+  SetHoveredSpace(switcher_ ? switcher_->SpaceAtScreenPoint(point_in_screen)
+                            : std::nullopt);
+  // Not a tab strip, so there is no context to attach the drag to.
+  return nullptr;
+}
+
+void SpaceDragTarget::OnTabDragExited(const gfx::Point& point_in_screen) {
+  SetHoveredSpace(std::nullopt);
+}
+
+void SpaceDragTarget::OnTabDragEnded() {
+  SetHoveredSpace(std::nullopt);
+}
+
+bool SpaceDragTarget::CanDropTab() {
+  if (!hovered_ || !model_->GetSpace(*hovered_)) {
+    return false;
+  }
+  // Only a single tab, and never a pinned one: pinned tabs are the essentials
+  // row and are in every Space already.
+  return true;
+}
+
+void SpaceDragTarget::HandleTabDrop(DragController& controller) {
+  if (!hovered_) {
+    return;
+  }
+
+  // Only the first dragged tab. Reading DragSessionData to count them would
+  // make this untestable without a real drag session, and a multi-tab drag onto
+  // a Space is not a gesture the reference has.
+  std::unique_ptr<tabs::TabModel> tab = controller.DetachTabAtForInsertion(0);
+  if (!tab) {
+    return;
+  }
+
+  // Straight back into the same strip. A Space is not another window: the tab
+  // has not gone anywhere, it has only changed which Space shows it.
+  TabStripModel* const tabs = browser_->tab_strip_model();
+  tabs::TabInterface* const inserted = tab.get();
+  tabs->InsertDetachedTabAt(tabs->count(), std::move(tab),
+                            AddTabTypes::ADD_NONE);
+
+  model_->SetSpaceForTab(inserted, *hovered_);
+  model_->SetActiveSpace(*hovered_);
+  hovered_.reset();
+}
+
+base::CallbackListSubscription SpaceDragTarget::RegisterWillDestroyCallback(
+    base::OnceClosure callback) {
+  return will_destroy_callbacks_.Add(std::move(callback));
+}
+
+}  // namespace spaces
