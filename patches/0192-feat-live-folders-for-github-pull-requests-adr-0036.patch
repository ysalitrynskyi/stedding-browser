diff --git a/chrome/browser/ui/live_folders/github_pulls.cc b/chrome/browser/ui/live_folders/github_pulls.cc
new file mode 100644
index 0000000000000..dc063e28e3d5b
--- /dev/null
+++ b/chrome/browser/ui/live_folders/github_pulls.cc
@@ -0,0 +1,238 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/live_folders/github_pulls.h"
+
+#include <algorithm>
+#include <set>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/strings/escape.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_request_headers.h"
+#include "net/http/http_response_headers.h"
+#include "url/origin.h"
+#include "url/url_constants.h"
+
+namespace live_folders {
+
+namespace {
+
+// Lf3: each way a pull request is the person's.
+constexpr const char* kWho[] = {
+    "author:@me",
+    "assignee:@me",
+    "review-requested:@me",
+    "mentions:@me",
+};
+
+// "owner/repo" from https://github.com/<owner>/<repo>/pull/<n>, or empty when
+// the address is not that.
+std::string RepoOf(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIs(url::kHttpsScheme) ||
+      url.host() != "github.com" || url.has_port() || url.has_username() ||
+      url.has_password()) {
+    return std::string();
+  }
+  const std::vector<std::string> parts =
+      base::SplitString(url.path(), "/", base::TRIM_WHITESPACE,
+                        base::SPLIT_WANT_NONEMPTY);
+  unsigned number = 0;
+  if (parts.size() != 4 || parts[2] != "pull" ||
+      !base::StringToUint(parts[3], &number) || number == 0) {
+    return std::string();
+  }
+  return base::StrCat({parts[0], "/", parts[1]});
+}
+
+}  // namespace
+
+std::vector<GURL> SearchUrls() {
+  std::vector<GURL> urls;
+  for (const char* who : kWho) {
+    const std::string query =
+        base::StrCat({"is:pr is:open archived:false ", who});
+    urls.emplace_back(base::StrCat(
+        {kApiOrigin, "/search/issues?q=",
+         base::EscapeQueryParamValue(query, /*use_plus=*/true),
+         "&sort=created&order=desc&per_page=",
+         base::NumberToString(kMaxRows)}));
+  }
+  return urls;
+}
+
+void SetRequestHeaders(const std::string& token,
+                       net::HttpRequestHeaders* headers) {
+  headers->SetHeader(net::HttpRequestHeaders::kAccept,
+                     "application/vnd.github+json");
+  headers->SetHeader("X-GitHub-Api-Version", kApiVersion);
+  headers->SetHeader(net::HttpRequestHeaders::kAuthorization,
+                     base::StrCat({"Bearer ", token}));
+}
+
+bool LooksLikeAToken(std::string_view token) {
+  return !token.empty() && token.size() <= 255 &&
+         std::ranges::all_of(token, [](char c) {
+           return base::IsAsciiAlphaNumeric(c) || c == '_';
+         });
+}
+
+bool IsNodeId(std::string_view node_id) {
+  // GitHub's ids: "PR_kwDO..." now, and base64 for objects made before the
+  // change ("MDExOlB1bGxSZXF1ZXN0MQ=="), which can end in '='.
+  return !node_id.empty() && node_id.size() <= 128 &&
+         std::ranges::all_of(node_id, [](char c) {
+           return base::IsAsciiAlphaNumeric(c) || c == '_' || c == '-' ||
+                  c == '=' || c == '+' || c == '/';
+         });
+}
+
+bool DropsAuthorizationOnRedirectTo(const GURL& to) {
+  return !url::Origin::Create(to).IsSameOriginWith(GURL(kApiOrigin));
+}
+
+std::optional<std::vector<PullRequest>> ParseSearchAnswer(
+    std::string_view json,
+    bool* complete) {
+  if (complete) {
+    *complete = false;
+  }
+  std::optional<base::DictValue> answer =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!answer) {
+    return std::nullopt;
+  }
+  const base::ListValue* const items = answer->FindList("items");
+  if (!items) {
+    return std::nullopt;
+  }
+  // Lf5: the answer holds everything that matched only when GitHub says so
+  // and its count fits in the page.
+  if (complete) {
+    const std::optional<double> total = answer->FindDouble("total_count");
+    *complete = !answer->FindBool("incomplete_results").value_or(true) &&
+                total && *total <= static_cast<double>(items->size());
+  }
+  std::vector<PullRequest> pulls;
+  for (const base::Value& value : *items) {
+    const base::DictValue* const item = value.GetIfDict();
+    if (!item || !item->FindDict("pull_request")) {
+      continue;
+    }
+    const std::string* const node_id = item->FindString("node_id");
+    const std::string* const title = item->FindString("title");
+    const std::string* const html_url = item->FindString("html_url");
+    const std::string* const created_at = item->FindString("created_at");
+    const std::string* const state = item->FindString("state");
+    if (!node_id || node_id->empty() || !title || !html_url ||
+        (state && *state != "open")) {
+      continue;
+    }
+    // A node id becomes part of a tab token: GitHub's alphabet alone.
+    if (!IsNodeId(*node_id)) {
+      continue;
+    }
+    PullRequest pull;
+    pull.url = GURL(*html_url);
+    pull.repo = RepoOf(pull.url);
+    if (pull.repo.empty()) {
+      continue;
+    }
+    pull.node_id = *node_id;
+    pull.title = *title;
+    pull.created_at = created_at ? *created_at : std::string();
+    pulls.push_back(std::move(pull));
+  }
+  return pulls;
+}
+
+std::vector<PullRequest> MergeAnswers(
+    const std::vector<std::vector<PullRequest>>& answers,
+    bool* capped) {
+  std::vector<PullRequest> merged;
+  std::set<std::string> seen;
+  for (const std::vector<PullRequest>& answer : answers) {
+    for (const PullRequest& pull : answer) {
+      if (seen.insert(pull.node_id).second) {
+        merged.push_back(pull);
+      }
+    }
+  }
+  // Newest first; GitHub's ISO 8601 times sort as text. Ties keep the order
+  // of the searches.
+  std::ranges::stable_sort(merged, [](const PullRequest& a,
+                                      const PullRequest& b) {
+    return a.created_at > b.created_at;
+  });
+  if (capped) {
+    *capped = merged.size() > kMaxRows;
+  }
+  if (merged.size() > kMaxRows) {
+    merged.resize(kMaxRows);
+  }
+  return merged;
+}
+
+Failure FailureOf(int net_error,
+                  int status,
+                  const net::HttpResponseHeaders* headers) {
+  if (status == 0) {
+    return net_error == net::OK ? Failure::kServer : Failure::kNetwork;
+  }
+  if (status >= 200 && status < 300) {
+    return Failure::kNone;
+  }
+  if (status == 401) {
+    return Failure::kToken;
+  }
+  if (status == 429) {
+    return Failure::kRateLimit;
+  }
+  if (status == 403) {
+    // GitHub's primary limit says so in its counter; the secondary one asks
+    // to wait.
+    const bool spent =
+        headers &&
+        (headers->GetNormalizedHeader("x-ratelimit-remaining") ==
+             std::optional<std::string>("0") ||
+         headers->HasHeader("retry-after"));
+    return spent ? Failure::kRateLimit : Failure::kToken;
+  }
+  return Failure::kServer;
+}
+
+std::u16string FailureText(Failure failure) {
+  switch (failure) {
+    case Failure::kNone:
+      return std::u16string();
+    case Failure::kToken:
+      return u"GitHub did not accept the token. It may have expired or been "
+             u"revoked. Make a new one and paste it in Settings.";
+    case Failure::kRateLimit:
+      return u"GitHub's rate limit was reached. The folder tries again "
+             u"later.";
+    case Failure::kNetwork:
+      return u"GitHub could not be reached. Check the network; the folder "
+             u"tries again later.";
+    case Failure::kServer:
+      return u"GitHub answered with an error. The folder tries again later.";
+    case Failure::kKeyStore:
+      return u"This computer's key store cannot keep the token, so it was "
+             u"not saved.";
+  }
+  return std::u16string();
+}
+
+std::u16string RowName(const PullRequest& pull) {
+  return base::UTF8ToUTF16(base::StrCat({pull.repo, ": ", pull.title}));
+}
+
+}  // namespace live_folders
diff --git a/chrome/browser/ui/live_folders/github_pulls.h b/chrome/browser/ui/live_folders/github_pulls.h
new file mode 100644
index 0000000000000..4d80f7867fe17
--- /dev/null
+++ b/chrome/browser/ui/live_folders/github_pulls.h
@@ -0,0 +1,119 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_LIVE_FOLDERS_GITHUB_PULLS_H_
+#define CHROME_BROWSER_UI_LIVE_FOLDERS_GITHUB_PULLS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "url/gurl.h"
+
+namespace net {
+class HttpRequestHeaders;
+class HttpResponseHeaders;
+}  // namespace net
+
+// docs/features/live-folders.md Lf3, Lf7 (ADR 0036): GitHub's side of the
+// pull-request folder: the four searches, their headers, reading an answer,
+// and why a request failed. No network here.
+namespace live_folders {
+
+// The only host a live folder sends anything to.
+inline constexpr char kApiOrigin[] = "https://api.github.com";
+// GitHub's page for making a fine-grained token, which Settings links to.
+inline constexpr char kTokenPage[] =
+    "https://github.com/settings/personal-access-tokens/new";
+// Where the folder's one row points when no pull request is open.
+inline constexpr char kPullsPage[] = "https://github.com/pulls";
+// The REST API version the answers are read as.
+inline constexpr char kApiVersion[] = "2022-11-28";
+// Lf3: the most rows the folder holds; each search asks for this many.
+inline constexpr size_t kMaxRows = 50;
+// The largest answer read; GitHub's for 50 items is far below it.
+inline constexpr size_t kMaxAnswerBytes = 2 * 1024 * 1024;
+
+struct PullRequest {
+  // GitHub's node id of the pull request: stable, and the row's identity.
+  std::string node_id;
+  // "owner/repo".
+  std::string repo;
+  std::string title;
+  // https://github.com/<owner>/<repo>/pull/<number>.
+  GURL url;
+  // ISO 8601, as GitHub writes it; orders the rows, newest first.
+  std::string created_at;
+
+  bool operator==(const PullRequest& other) const = default;
+};
+
+// Lf7: why a refresh failed.
+enum class Failure {
+  kNone,
+  // 401: the token expired, was revoked or was mistyped.
+  kToken,
+  // 403 or 429 with GitHub's rate limit spent.
+  kRateLimit,
+  // No answer: the network is down, or GitHub could not be reached.
+  kNetwork,
+  // Any other answer: an error from GitHub, or one that is no list.
+  kServer,
+  // The system's key store cannot keep the token (making the folder only).
+  kKeyStore,
+};
+
+// Lf3: the four searches, one per way a pull request is the person's:
+// opened, assigned, asked to review, mentioned. Each `is:pr is:open
+// archived:false`, newest first, at most kMaxRows.
+std::vector<GURL> SearchUrls();
+
+// Lf3: the headers each search carries. The token goes in Authorization and
+// nowhere else.
+void SetRequestHeaders(const std::string& token,
+                       net::HttpRequestHeaders* headers);
+
+// Lf1: whether a paste can be a token as GitHub makes them: letters, digits
+// and '_', at most 255. Anything else is refused before any request.
+bool LooksLikeAToken(std::string_view token);
+
+// Lf3: whether `node_id` is a GitHub node id: letters, digits and '_', '-',
+// and the base64 of ids made before 2021 ('+', '/', '='), at most 128.
+bool IsNodeId(std::string_view node_id);
+
+// Lf3: whether a request redirected to `to` must lose its Authorization
+// header: anywhere but https://api.github.com.
+bool DropsAuthorizationOnRedirectTo(const GURL& to);
+
+// Lf3: the pull requests of one search answer. An item that is no pull
+// request, or whose address is not https://github.com/<owner>/<repo>/pull/<n>,
+// is left out. Nothing when the answer is not GitHub's search result.
+// `complete`, when given, says whether the answer holds every match: GitHub
+// marked it complete and its count fits in the page (Lf5).
+std::optional<std::vector<PullRequest>> ParseSearchAnswer(
+    std::string_view json,
+    bool* complete = nullptr);
+
+// Lf3: the four answers as one list: each pull request once, newest first, at
+// most kMaxRows. `capped`, when given, says whether rows were cut.
+std::vector<PullRequest> MergeAnswers(
+    const std::vector<std::vector<PullRequest>>& answers,
+    bool* capped = nullptr);
+
+// Lf7: what a finished request means. `net_error` is the loader's,
+// `status` the HTTP status (0 for none).
+Failure FailureOf(int net_error,
+                  int status,
+                  const net::HttpResponseHeaders* headers);
+
+// Lf7: the reason, as the folder's tooltip and Settings say it.
+std::u16string FailureText(Failure failure);
+
+// Lf5: a row's name: "<owner>/<repo>: <title>".
+std::u16string RowName(const PullRequest& pull);
+
+}  // namespace live_folders
+
+#endif  // CHROME_BROWSER_UI_LIVE_FOLDERS_GITHUB_PULLS_H_
diff --git a/chrome/browser/ui/live_folders/live_folder_note.cc b/chrome/browser/ui/live_folders/live_folder_note.cc
new file mode 100644
index 0000000000000..127ce4f300bf9
--- /dev/null
+++ b/chrome/browser/ui/live_folders/live_folder_note.cc
@@ -0,0 +1,118 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/live_folders/live_folder_note.h"
+
+#include <map>
+#include <memory>
+#include <variant>
+#include <utility>
+
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_collection_types.h"
+
+namespace live_folders {
+
+namespace {
+
+struct Entry {
+  std::string folder_id;
+  FolderNote note;
+};
+
+std::map<const Profile*, Entry>& Notes() {
+  static base::NoDestructor<std::map<const Profile*, Entry>> notes;
+  return *notes;
+}
+
+std::map<const Profile*, CommandHandler>& Handlers() {
+  static base::NoDestructor<std::map<const Profile*, CommandHandler>>
+      handlers;
+  return *handlers;
+}
+
+base::RepeatingClosureList& Observers() {
+  static base::NoDestructor<base::RepeatingClosureList> observers;
+  return *observers;
+}
+
+}  // namespace
+
+bool IsLiveRowToken(std::string_view token) {
+  return base::StartsWith(token, kRowTokenPrefix);
+}
+
+void SetNote(Profile* profile,
+             const std::string& folder_id,
+             std::optional<FolderNote> note) {
+  if (note) {
+    Notes()[profile] = Entry{folder_id, std::move(*note)};
+  } else if (!Notes().erase(profile)) {
+    return;
+  }
+  Observers().Notify();
+}
+
+std::optional<FolderNote> NoteFor(Profile* profile,
+                                  const std::string& folder_id) {
+  const auto it = Notes().find(profile);
+  if (it == Notes().end() || it->second.folder_id != folder_id) {
+    return std::nullopt;
+  }
+  return it->second.note;
+}
+
+bool IsLiveFolder(Profile* profile, const std::string& folder_id) {
+  return !folder_id.empty() && NoteFor(profile, folder_id).has_value();
+}
+
+bool HoldsLiveFolder(Profile* profile, const tabs::TabCollection* collection) {
+  if (!collection) {
+    return false;
+  }
+  if (collection->type() == tabs::TabCollection::Type::FOLDER &&
+      IsLiveFolder(profile, static_cast<const tabs::FolderTabCollection*>(
+                                collection)
+                                ->id()
+                                .ToString())) {
+    return true;
+  }
+  for (const tabs::Child& child : collection->GetChildren()) {
+    const auto* const nested =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (nested && HoldsLiveFolder(profile, nested->get())) {
+      return true;
+    }
+  }
+  return false;
+}
+
+base::CallbackListSubscription AddNoteObserver(base::RepeatingClosure changed) {
+  return Observers().Add(std::move(changed));
+}
+
+void SetCommandHandler(Profile* profile, CommandHandler handler) {
+  if (handler) {
+    Handlers()[profile] = std::move(handler);
+  } else {
+    Handlers().erase(profile);
+  }
+}
+
+bool RunCommand(Profile* profile, Command command) {
+  const auto it = Handlers().find(profile);
+  if (it == Handlers().end()) {
+    return false;
+  }
+  // A copy: the handler may reset itself (Delete).
+  CommandHandler handler = it->second;
+  handler.Run(command);
+  return true;
+}
+
+}  // namespace live_folders
diff --git a/chrome/browser/ui/live_folders/live_folder_note.h b/chrome/browser/ui/live_folders/live_folder_note.h
new file mode 100644
index 0000000000000..18df4275ffe48
--- /dev/null
+++ b/chrome/browser/ui/live_folders/live_folder_note.h
@@ -0,0 +1,84 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_LIVE_FOLDERS_LIVE_FOLDER_NOTE_H_
+#define CHROME_BROWSER_UI_LIVE_FOLDERS_LIVE_FOLDER_NOTE_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+
+class Profile;
+
+namespace tabs {
+class TabCollection;
+}  // namespace tabs
+
+// docs/features/live-folders.md Lf-rows (ADR 0036): what the sidebar and sync
+// need to know of a live folder, without depending on the service that fills
+// it. The service sets it; a folder's header and sync's reader ask it.
+namespace live_folders {
+
+// Lf9: every row of a live folder carries a tab token with this prefix, so
+// sync can leave it out by the token alone.
+inline constexpr char kRowTokenPrefix[] = "livegh-";
+
+// Whether `token` (a tab's `stedding.tab_token`) is a live folder's row.
+bool IsLiveRowToken(std::string_view token);
+
+// Lf6: what a live folder's header shows beside its name.
+struct FolderNote {
+  // The last refresh failed: the header wears the mark.
+  bool failed = false;
+  // The header's tooltip: when the list was last refreshed, or why it was
+  // not.
+  std::u16string tooltip;
+};
+
+// Lf6, Lf13: set by the profile's service; `note` empty when `profile` has no
+// live folder. Tells every header.
+void SetNote(Profile* profile,
+             const std::string& folder_id,
+             std::optional<FolderNote> note);
+
+// The note of the folder `folder_id` of `profile`, or none when it is no live
+// folder.
+std::optional<FolderNote> NoteFor(Profile* profile,
+                                  const std::string& folder_id);
+
+// Called when any note changes; a header asks again.
+base::CallbackListSubscription AddNoteObserver(base::RepeatingClosure changed);
+
+// Lf9: whether `folder_id` is the live folder of `profile`: sync leaves it
+// out, with everything in it.
+bool IsLiveFolder(Profile* profile, const std::string& folder_id);
+
+// Lf8: whether `collection` is the live folder of `profile` or holds it,
+// nested at any depth: taking it out of the pinned run takes the live folder.
+bool HoldsLiveFolder(Profile* profile, const tabs::TabCollection* collection);
+
+// Lf13: the header menu's rows for a live folder; Lf8: the header's note that
+// the person is taking the folder itself out of the pinned run.
+enum class Command {
+  kRefresh,
+  kDelete,
+  kFolderGoing,
+};
+
+using CommandHandler = base::RepeatingCallback<void(Command)>;
+
+// Set by the profile's service while it has a live folder; reset with a null
+// callback.
+void SetCommandHandler(Profile* profile, CommandHandler handler);
+
+// Runs `command` on the live folder of `profile`. Returns false when it has
+// none.
+bool RunCommand(Profile* profile, Command command);
+
+}  // namespace live_folders
+
+#endif  // CHROME_BROWSER_UI_LIVE_FOLDERS_LIVE_FOLDER_NOTE_H_
diff --git a/chrome/browser/ui/live_folders/live_folder_scheduler.cc b/chrome/browser/ui/live_folders/live_folder_scheduler.cc
new file mode 100644
index 0000000000000..2fbd0e02e1141
--- /dev/null
+++ b/chrome/browser/ui/live_folders/live_folder_scheduler.cc
@@ -0,0 +1,67 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/live_folders/live_folder_scheduler.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+
+namespace live_folders {
+
+LiveFolderScheduler::LiveFolderScheduler(
+    base::RepeatingClosure refresh,
+    base::RepeatingCallback<bool()> has_window)
+    : refresh_(std::move(refresh)), has_window_(std::move(has_window)) {}
+
+LiveFolderScheduler::~LiveFolderScheduler() = default;
+
+void LiveFolderScheduler::Start(bool ran_now) {
+  running_ = true;
+  if (ran_now) {
+    last_run_ = base::TimeTicks::Now();
+  }
+  beat_.Start(FROM_HERE, kEvery,
+              base::BindRepeating(&LiveFolderScheduler::OnBeat,
+                                  base::Unretained(this)));
+}
+
+void LiveFolderScheduler::Stop() {
+  running_ = false;
+  beat_.Stop();
+  deferred_.Stop();
+}
+
+void LiveFolderScheduler::Ask() {
+  if (!running_ || deferred_.IsRunning()) {
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (last_run_.is_null() || now - last_run_ >= kFloor) {
+    Run();
+    return;
+  }
+  deferred_.Start(FROM_HERE, last_run_ + kFloor - now,
+                  base::BindOnce(&LiveFolderScheduler::Run,
+                                 base::Unretained(this)));
+}
+
+void LiveFolderScheduler::OnBeat() {
+  if (!has_window_.Run()) {
+    return;
+  }
+  Ask();
+}
+
+void LiveFolderScheduler::Run() {
+  if (!running_) {
+    return;
+  }
+  deferred_.Stop();
+  last_run_ = base::TimeTicks::Now();
+  refresh_.Run();
+}
+
+}  // namespace live_folders
