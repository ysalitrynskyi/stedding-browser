+// Tidy names ------------------------------------------------------------------
+
+// A page with no <title>, whose address carries a query, with a link to a
+// download whose name says nothing.
+std::unique_ptr<net::test_server::HttpResponse> ServeW2B01(
+    const net::test_server::HttpRequest& request) {
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  if (request.relative_url == "/untitled?token=abc") {
+    response->set_content_type("text/html");
+    response->set_content("<a href=/download.pdf>Get the file</a>");
+    return response;
+  }
+  if (request.relative_url == "/download.pdf") {
+    response->set_content_type("application/pdf");
+    response->AddCustomHeader("Content-Disposition",
+                              "attachment; filename=\"download.pdf\"");
+    response->set_content("%PDF-1.4\n%%EOF\n");
+    return response;
+  }
+  return nullptr;
+}
+
+class TidyNamesW2B01Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&ServeW2B01));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      ASSERT_TRUE(downloads_.CreateUniqueTempDir());
+    }
+    PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+    prefs->SetBoolean(prefs::kPromptForDownload, false);
+    DownloadPrefs::FromBrowserContext(browser()->GetProfile())
+        ->SetDownloadPath(downloads_.GetPath());
+  }
+
+ private:
+  base::ScopedTempDir downloads_;
+};
+
+// P28-1g, sidebar-panels Pn17: "with no title ... the name stays". A page
+// with no <title> shows its address as its tab's title; the download from
+// it was saved under that address, query and all
+// ("127.0.0.1 <port> untitled token=abc.pdf").
+IN_PROC_BROWSER_TEST_F(TidyNamesW2B01Test,
+                       ADownloadFromAPageWithNoTitleKeepsItsName) {
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      stedding::prefs::kDownloadsTidyNames, true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/untitled?token=abc")));
+  content::WebContents* const page =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  EXPECT_NE(std::u16string::npos, page->GetTitle().find(u"untitled"))
+      << "the premise: the tab shows the page's address as its title";
+
+  content::DownloadManager* const manager =
+      browser()->GetProfile()->GetDownloadManager();
+  content::DownloadTestObserverTerminal done(
+      manager, 1, content::DownloadTestObserver::ON_DANGEROUS_DOWNLOAD_FAIL);
+  ASSERT_TRUE(content::ExecJs(page, "document.querySelector('a').click()"));
+  done.WaitForFinished();
+  content::DownloadManager::DownloadVector items;
+  manager->GetAllDownloads(&items);
+  ASSERT_EQ(1u, items.size());
+  EXPECT_EQ(base::FilePath::FromASCII("download.pdf"),
+            items.front()->GetTargetFilePath().BaseName());
+}
