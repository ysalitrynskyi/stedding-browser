+    // A window with one unnamed Space should look like an ordinary window,
+    // so only tint once the user has more than one Space to tell apart -- or
+    // has chosen a colour for the one they have (the welcome swatches, the
+    // menu; spaces B31: the choice showed nothing on a fresh profile,
+    // 2026-09-05).
+    const bool tint = active && (model_->size() > 1 || active->color_chosen());
