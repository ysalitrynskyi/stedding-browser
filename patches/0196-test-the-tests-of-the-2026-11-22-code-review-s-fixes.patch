+constexpr char kSpaceW2B11[] = "0123456789ABCDEF0123456789ABCDEF";
+constexpr char kOtherSpaceW2B11[] = "1123456789ABCDEF0123456789ABCDEF";
+constexpr char kPinW2B11[] = "tab:11111111-1111-4111-8111-111111111111";
+constexpr char kOtherPinW2B11[] = "tab:22222222-2222-4222-8222-222222222222";
+constexpr char kFolderW2B11[] = "folder:AAAAAAAAAAAAAAAABBBBBBBBBBBBBBBB";
+constexpr char kOtherFolderW2B11[] = "folder:CCCCCCCCCCCCCCCCDDDDDDDDDDDDDDDD";
+constexpr char kWriterW2B11[] = "aaaaaaaaaaaaaaaa";
+
+// A file's sidebar: one Space, a pinned folder in its run, a pin in that
+// folder.
+State SidebarW2B11() {
+  const Stamp stamp{1000, kWriterW2B11};
+  State state;
+  Record space(Kind::kSpace);
+  space.f[kFieldName] = Field{"Work", stamp};
+  space.f[kFieldColor] = Field{"#3366FF", stamp};
+  state.records[kSpaceW2B11] = space;
+  state.lists[kSpacesList].order = {kSpaceW2B11};
+  state.lists[kSpacesList].s = stamp;
+  Record folder(Kind::kFolder);
+  folder.f[kFieldTitle] = Field{"Clients", stamp};
+  folder.f[kFieldParent] = Field{PinsListOf(kSpaceW2B11), stamp};
+  state.records[kFolderW2B11] = folder;
+  state.lists[PinsListOf(kSpaceW2B11)].order = {kFolderW2B11};
+  state.lists[PinsListOf(kSpaceW2B11)].s = stamp;
+  Record pin(Kind::kTab);
+  pin.f[kFieldHome] = Field{"https://example.com/", stamp};
+  pin.f[kFieldName] = Field{"", stamp};
+  pin.f[kFieldParent] = Field{kFolderW2B11, stamp};
+  state.records[kPinW2B11] = pin;
+  state.lists[kFolderW2B11].order = {kPinW2B11};
+  state.lists[kFolderW2B11].s = stamp;
+  return state;
+}
+
+FileMeta MetaW2B11() {
+  FileMeta meta;
+  meta.install = kWriterW2B11;
+  meta.device = "Desk";
+  meta.seq = 1;
+  meta.nonce = "nonce";
+  meta.written_ms = 1000;
+  meta.hlc = 1000;
+  meta.joined_ms = 1;
+  return meta;
+}
+
+// How a reader takes the sidebar's file with one alias, `from` to `to`.
+ParseStatus ReadWithAliasW2B11(const std::string& from, const std::string& to) {
+  State state = SidebarW2B11();
+  state.aliases[from] = to;
+  return ParseSyncFile(SerializeSyncFile(state, MetaW2B11())).status;
+}
+
+// P13-1g (Sf10, Sf33): an alias makes two items of one kind one item, as a
+// join pairs two Spaces, two pins or two folders. A file whose alias joins a
+// folder to a Space, a pin to a folder or a Space to a pin is refused whole.
+// Taken, the alias stayed in the ledger for good: the pins in that folder
+// here took the Space's id as their place, which is no place, and every
+// computer refused this computer's file from then on.
+TEST(SidebarSyncFileW2B11Test, AnAliasBetweenTwoKindsRefusesTheFile) {
+  EXPECT_EQ(ParseStatus::kMalformed,
+            ReadWithAliasW2B11(kFolderW2B11, kSpaceW2B11));
+  EXPECT_EQ(ParseStatus::kMalformed,
+            ReadWithAliasW2B11(kPinW2B11, kFolderW2B11));
+  EXPECT_EQ(ParseStatus::kMalformed,
+            ReadWithAliasW2B11(kOtherSpaceW2B11, kPinW2B11));
+  // The pairs a join makes are read as before.
+  EXPECT_EQ(ParseStatus::kOk,
+            ReadWithAliasW2B11(kOtherSpaceW2B11, kSpaceW2B11));
+  EXPECT_EQ(ParseStatus::kOk, ReadWithAliasW2B11(kOtherPinW2B11, kPinW2B11));
+  EXPECT_EQ(ParseStatus::kOk,
+            ReadWithAliasW2B11(kOtherFolderW2B11, kFolderW2B11));
+}
+
+// P13-1g (Sf33): a file holds at most as many aliases as it holds records,
+// and this computer writes none with more: every reader would refuse it. The
+// number had no cap.
+TEST(SidebarSyncFileW2B11Test, AFileWithMoreAliasesThanItsRecordCapIsRefused) {
+  State state = SidebarW2B11();
+  for (size_t i = 0; i < kMaxRecords; ++i) {
+    state.aliases[base::Token(2, i + 1).ToString()] = kSpaceW2B11;
+  }
+  const std::string within = SerializeSyncFile(state, MetaW2B11());
+  EXPECT_TRUE(FitsInAFile(state, within));
+  EXPECT_EQ(ParseStatus::kOk, ParseSyncFile(within).status);
+
+  state.aliases[base::Token(3, 1).ToString()] = kSpaceW2B11;
+  const std::string past = SerializeSyncFile(state, MetaW2B11());
+  EXPECT_FALSE(FitsInAFile(state, past))
+      << "written for every reader to refuse";
+  EXPECT_EQ(ParseStatus::kMalformed, ParseSyncFile(past).status);
+}
+
+}  // namespace
+}  // namespace spaces::sidebar_sync
