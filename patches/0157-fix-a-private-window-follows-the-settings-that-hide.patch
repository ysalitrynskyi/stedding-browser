+// sidebar Y54 (GitHub issues 118, 119; the owner, 2026-11-16, PLAN.md
+// decision 24): the window's buttons at the corner show only from a thin
+// strip along the window's top edge over the corner -- the card's top
+// gutter, the window's own ground -- never from the page's corner under it,
+// where sites keep their own controls; once shown they stay while the
+// pointer is on them. With the page flush against the window there is no
+// gutter and the strip is the page's top 5 DIP. A maximized window's strip
+// is the screen's top.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, TheCornersButtonsShowFromTheTopEdge) {
+  ASSERT_FALSE(prefs()->GetBoolean(stedding::prefs::kSidebarOnRight));
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Page("a.test", "/title1.html")));
+  views::Widget* const widget = browser_view()->GetWidget();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget);
+    const stedding::WindowCornerButtons* const corner =
+        browser_view()->stedding_corner_buttons_for_testing();
+    return corner && corner->wanted() && !browser_view()->IsToolbarVisible();
+  }));
+  const int gutter =
+      VerticalTabStripRegionView::SteddingCardGutter(browser_view());
+  ASSERT_GE(gutter, 5);
+  {
+    SCOPED_TRACE("the card's gutter");
+    ASSERT_NO_FATAL_FAILURE(CheckTheCornersStrip(gutter));
+  }
+  {
+    SCOPED_TRACE("the page flush against the window");
+    prefs()->SetBoolean(stedding::prefs::kSidebarPageFlush, true);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget);
+      return VerticalTabStripRegionView::SteddingCardGutter(browser_view()) ==
+             0;
+    }));
+    ASSERT_NO_FATAL_FAILURE(CheckTheCornersStrip(5));
+    prefs()->SetBoolean(stedding::prefs::kSidebarPageFlush, false);
+  }
+  {
+    SCOPED_TRACE("maximized");
+    widget->Maximize();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget);
+      const stedding::WindowCornerButtons* const corner =
+          browser_view()->stedding_corner_buttons_for_testing();
+      return widget->IsMaximized() && corner->wanted() &&
+             corner->bounds().right() == browser_view()->width() &&
+             VerticalTabStripRegionView::SteddingCardGutter(browser_view()) ==
+                 gutter;
+    }));
+    ASSERT_NO_FATAL_FAILURE(CheckTheCornersStrip(gutter));
+    widget->Restore();
+  }
+}
