+// A key the peek's page did not take, as the page hands it back to its
+// delegate: a key down with `modifiers`.
+input::NativeWebKeyboardEvent KeyDownB27(int modifiers,
+                                         ui::KeyboardCode key,
+                                         ui::DomKey dom_key,
+                                         ui::DomCode dom_code) {
+  input::NativeWebKeyboardEvent event(blink::WebInputEvent::Type::kRawKeyDown,
+                                      modifiers, base::TimeTicks::Now());
+  event.windows_key_code = key;
+  event.dom_key = dom_key;
+  event.dom_code = static_cast<int>(dom_code);
+  return event;
+}
+
+// The window's Back key: Cmd-[ on the Mac, Alt+Left elsewhere.
+input::NativeWebKeyboardEvent BackKeyB27() {
+#if BUILDFLAG(IS_MAC)
+  return KeyDownB27(blink::WebInputEvent::kMetaKey, ui::VKEY_OEM_4,
+                    ui::DomKey::FromCharacter('['), ui::DomCode::BRACKET_LEFT);
+#else
+  return KeyDownB27(blink::WebInputEvent::kAltKey, ui::VKEY_LEFT,
+                    ui::DomKey::ARROW_LEFT, ui::DomCode::ARROW_LEFT);
+#endif
+}
