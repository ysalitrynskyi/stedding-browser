+// sidebar Y45 (GitHub issue 19): a separator above a row stands it a band
+// lower than the rows' usual gap, and it comes back after a restart. The
+// first row, the window's first tab, has none, so its gap is the usual one.
+namespace {
+int SeparatorGapFor(BrowserWindowInterface* browser,
+                    tabs::TabInterface* above,
+                    tabs::TabInterface* below) {
+  tabs::VerticalTabStripStateController::From(browser)->SetVerticalTabsEnabled(
+      true);
+  views::Widget* const widget =
+      BrowserView::GetBrowserViewForBrowser(browser)->GetWidget();
+  EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+  views::test::RunScheduledLayout(widget);
+  views::View* const top =
+      stedding::test::FindDrawnRow(widget->GetRootView(), above);
+  views::View* const bottom =
+      stedding::test::FindDrawnRow(widget->GetRootView(), below);
+  if (!top || !bottom) {
+    ADD_FAILURE() << "a row is not drawn";
+    return 0;
+  }
+  return bottom->GetBoundsInScreen().y() - top->GetBoundsInScreen().bottom();
+}
+}  // namespace
+
+// sidebar Y45: the line above a row comes back after a restart, and after
+// the next one: the session log is made again at each start, before the
+// restored tabs exist, so a key no one wrote again was gone after the second
+// (as a tab's name was, PLAN.md TST-4).
+namespace {
+void ExpectTheSeparatorBack(BrowserWindowInterface* browser) {
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  tabs::TabInterface* one = nullptr;
+  tabs::TabInterface* two = nullptr;
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    const std::string_view host = tab->GetContents()->GetVisibleURL().host();
+    if (host == "one.test") {
+      one = tab;
+    } else if (host == "two.test") {
+      two = tab;
+    }
+  }
+  ASSERT_TRUE(one && two);
+  EXPECT_FALSE(stedding::HasSeparatorAbove(one->GetContents()));
+  ASSERT_TRUE(stedding::HasSeparatorAbove(two->GetContents()))
+      << "the separator did not come back";
+  tabs::TabInterface* const first = tabs->GetTabAtIndex(0);
+  if (first != one) {
+    EXPECT_EQ(SeparatorGapFor(browser, first, one) + TabView::kSeparatorBand,
+              SeparatorGapFor(browser, one, two));
+  }
+}
+}  // namespace
+
+IN_PROC_BROWSER_TEST_F(RestoreTest, PRE_PRE_ASeparatorComesBack) {
+  tabs::TabInterface* const first = tabs()->GetTabAtIndex(0);
+  tabs::TabInterface* const one = Open("one.test");
+  tabs::TabInterface* const two = Open("two.test");
+  const int usual = SeparatorGapFor(browser(), first, one);
+  EXPECT_EQ(usual, SeparatorGapFor(browser(), one, two));
+  stedding::SetSeparatorAbove(browser(), two, true);
+  EXPECT_EQ(usual + TabView::kSeparatorBand,
+            SeparatorGapFor(browser(), one, two))
+      << "the row did not stand lower for the line";
+}
+
+IN_PROC_BROWSER_TEST_F(RestoreTest, PRE_ASeparatorComesBack) {
+  ExpectTheSeparatorBack(browser());
+}
+
+IN_PROC_BROWSER_TEST_F(RestoreTest, ASeparatorComesBack) {
+  ExpectTheSeparatorBack(browser());
+}
