+std::optional<Stamp> StampOf(const base::ListValue& triple) {
+  if (triple.size() != 3 || !(triple[1].is_double() || triple[1].is_int()) ||
+      !triple[2].is_string()) {
+    return std::nullopt;
+  }
+  const double t = triple[1].GetDouble();
+  if (t < 0 || t > static_cast<double>(kMaxTime) ||
+      t != static_cast<double>(static_cast<int64_t>(t))) {
+    return std::nullopt;
+  }
+  const std::string& w = triple[2].GetString();
+  if (!IsInstallId(w)) {
+    return std::nullopt;
+  }
+  return Stamp{static_cast<int64_t>(t), w};
+}
