+std::unique_ptr<extensions::FetchItemSnippetResponse> StoreAnswer() {
+  auto answer = std::make_unique<extensions::FetchItemSnippetResponse>();
+  answer->set_item_id(kExtensionId);
+  answer->set_title(kExtensionName);
+  answer->set_manifest(kManifest);
+  answer->set_logo_uri("webstore_inline_install/extension/icon.png");
+  answer->set_user_count_string("371,674");
+  answer->set_rating_count_string("788");
+  answer->set_rating_count(788);
+  answer->set_average_rating(4.36);
+  return answer;
+}
+
+// The other computer's sidebar: one Space, no pins.
+sb::State PeerState(const std::string& space, int64_t t) {
+  sb::State state;
+  const sb::Stamp stamp{t, kPeer};
+  sb::Record record(sb::Kind::kSpace);
+  record.f[sb::kFieldName] = sb::Field{"Peer Space", stamp};
+  record.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+  record.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+  state.records[space] = record;
+  state.lists[sb::kSpacesList].order = {space};
+  state.lists[sb::kSpacesList].s = stamp;
+  state.lists[sb::PinsListOf(space)].s = stamp;
+  return state;
+}
+
+std::vector<sb::ExtensionEntry> TheList() {
+  return {sb::ExtensionEntry{kExtensionId, kExtensionName}};
+}
+
+class SidebarSyncExtensionsTest : public WebstoreInstallerTest {
+ public:
+  SidebarSyncExtensionsTest()
+      : WebstoreInstallerTest(kWebstoreDomain,
+                              kTestDataPath,
+                              kCrxFilename,
+                              kAppDomain,
+                              kNonAppDomain) {}
+
+ protected:
+  void SetUpOnMainThread() override {
+    WebstoreInstallerTest::SetUpOnMainThread();
+    store_answer_ = StoreAnswer();
+    extensions::WebstoreDataFetcher::SetMockItemSnippetReponseForTesting(
+        store_answer_.get());
+    space_ = base::Token::CreateRandom().ToString();
+    start_ = NowMs();
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  void TearDownOnMainThread() override {
+    extensions::WebstoreDataFetcher::SetMockItemSnippetReponseForTesting(
+        nullptr);
+    WebstoreInstallerTest::TearDownOnMainThread();
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  extensions::ExtensionRegistry* registry() {
+    return extensions::ExtensionRegistry::Get(browser()->GetProfile());
+  }
+  base::FilePath sync_dir() {
+    return shared_.GetPath().AppendASCII(sb::kSyncFolderName);
+  }
+
+  // The other computer's file, with `list`, or with no list at all (its box
+  // off, or an older Stedding).
+  void WritePeer(int64_t seq,
+                 std::optional<std::vector<sb::ExtensionEntry>> list,
+                 const std::string& install = kPeer,
+                 const std::string& device = kPeerDevice) {
+    base::ScopedAllowBlockingForTesting allow;
+    const sb::State state = PeerState(space_, start_);
+    sb::FileMeta meta;
+    meta.format = sb::kFormat;
+    meta.install = install;
+    meta.device = device;
+    meta.seq = seq;
+    meta.nonce = sb::MakeInstallId();
+    meta.written_ms = NowMs();
+    meta.hlc = state.MaxTime();
+    meta.joined_ms = 1;
+    sb::FileParts parts;
+    parts.extensions = std::move(list);
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(base::WriteFile(sync_dir().AppendASCII(sb::FileNameFor(install)),
+                                sb::SerializeSyncFile(state, meta, parts)));
+  }
+
+  // A new join, each box on as the sheet starts them (Sf58).
+  void Join() {
+    base::test::TestFuture<base::DictValue> preview;
+    service()->PreviewJoin(shared_.GetPath(), preview.GetCallback());
+    ASSERT_FALSE(preview.Take().FindString("refusal"));
+    ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/false, "Test computer", {},
+                                       sb::JoinParts()));
+    ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  // The offer of `id` Settings shows, or nullopt.
+  std::optional<base::DictValue> Offer(const std::string& id) {
+    base::DictValue status = service()->GetStatus();
+    if (base::ListValue* const offers = status.FindList("extensionOffers")) {
+      for (base::Value& offer : *offers) {
+        const std::string* const each = offer.GetDict().FindString("id");
+        if (each && *each == id) {
+          return std::move(offer.GetDict());
+        }
+      }
+    }
+    return std::nullopt;
+  }
+  bool Offered(const std::string& id) { return Offer(id).has_value(); }
+
+  // The ids this computer's own file lists, as written.
+  std::optional<std::vector<std::string>> OwnList() {
+    base::ScopedAllowBlockingForTesting allow;
+    std::string json;
+    const std::string install = browser()->GetProfile()->GetPrefs()->GetString(
+        stedding::prefs::kSidebarSyncInstallId);
+    if (!base::ReadFileToString(
+            sync_dir().AppendASCII(sb::FileNameFor(install)), &json)) {
+      return std::nullopt;
+    }
+    const std::optional<base::DictValue> root =
+        base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+    const base::ListValue* const list =
+        root ? root->FindListByDottedPath("stedding_sync.extensions") : nullptr;
+    if (!list) {
+      return std::nullopt;
+    }
+    std::vector<std::string> ids;
+    for (const base::Value& entry : *list) {
+      // Sf68: as written, each entry is its id and name, nothing else.
+      if (entry.GetDict().size() != 2u || !entry.GetDict().FindString("name")) {
+        ADD_FAILURE() << "an entry holds more than an id and a name: "
+                      << entry.DebugString();
+      }
+      if (const std::string* const id = entry.GetDict().FindString("id")) {
+        ids.push_back(*id);
+      }
+    }
+    return ids;
+  }
+  bool OwnListHas(const std::string& id) {
+    const std::optional<std::vector<std::string>> list = OwnList();
+    return list && std::ranges::find(*list, id) != list->end();
+  }
+
+  bool Installed(const std::string& id) {
+    return registry()->GetInstalledExtension(id) != nullptr;
+  }
+  bool Enabled(const std::string& id) {
+    return registry()->enabled_extensions().GetByID(id) != nullptr;
+  }
+
+  // Settings › Stedding, as the person opens it.
+  content::WebContents* OpenSettings() {
+    if (!ui_test_utils::NavigateToURLWithDisposition(
+            browser(), GURL("chrome://settings/stedding"),
+            WindowOpenDisposition::NEW_FOREGROUND_TAB,
+            ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP)) {
+      return nullptr;
+    }
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  // What the offer's Install button sends.
+  void PressInstall(const std::string& id) {
+    content::WebContents* const settings = OpenSettings();
+    ASSERT_TRUE(settings);
+    ASSERT_TRUE(content::ExecJs(
+        settings,
+        content::JsReplace(
+            "chrome.send('steddingInstallSyncedExtension', [$1]);", id)));
+  }
+
+  // Joins with the other computer's list and installs the extension through
+  // the offer, the confirmation answered yes.
+  void InstallThroughTheOffer() {
+    ASSERT_NO_FATAL_FAILURE(WritePeer(1, TheList()));
+    ASSERT_NO_FATAL_FAILURE(Join());
+    ASSERT_NO_FATAL_FAILURE(Scan());
+    ASSERT_TRUE(base::test::RunUntil([&] { return Offered(kExtensionId); }));
+    AutoAcceptInstall();
+    ASSERT_NO_FATAL_FAILURE(PressInstall(kExtensionId));
+    ASSERT_TRUE(base::test::RunUntil([&] { return Enabled(kExtensionId); }));
+    ASSERT_TRUE(base::test::RunUntil([&] { return !Offered(kExtensionId); }));
+  }
+
+  base::ScopedTempDir shared_;
+  std::string space_;
+  int64_t start_ = 0;
+  std::unique_ptr<extensions::FetchItemSnippetResponse> store_answer_;
+};
