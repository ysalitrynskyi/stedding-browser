+namespace spaces::sidebar_sync {
+
+namespace {
+
+// --- The ledger (Sf34, Sf35). ---
+
+// Ids in the shapes the files carry: a Space's token and a tab's token.
+constexpr char kSpaceW2B12[] = "0123456789ABCDEF0123456789ABCDEF";
+constexpr char kPinW2B12[] = "tab:11111111-1111-4111-8111-111111111111";
+constexpr char kOfficeW2B12[] = "aaaaaaaaaaaaaaaa";
+
+// One Space, Work, with one pin.
+State SidebarW2B12() {
+  LocalView view;
+  LocalItem space;
+  space.kind = Kind::kSpace;
+  space.fields[kFieldName] = "Work";
+  space.fields[kFieldColor] = "#3366FF";
+  space.fields[kFieldIsolated] = "0";
+  view.items[kSpaceW2B12] = space;
+  LocalItem pin;
+  pin.kind = Kind::kTab;
+  pin.fields[kFieldHome] = "https://a.example/";
+  pin.fields[kFieldName] = std::string();
+  pin.fields[kFieldParent] = PinsListOf(kSpaceW2B12);
+  view.items[kPinW2B12] = pin;
+  view.lists[kSpacesList] = {kSpaceW2B12};
+  view.lists[PinsListOf(kSpaceW2B12)] = {kPinW2B12};
+  State state;
+  RecordLocalEdits(state, nullptr, view, {}, Stamp{100, kOfficeW2B12});
+  return state;
+}
+
+FileMeta MetaW2B12() {
+  FileMeta meta;
+  meta.install = kOfficeW2B12;
+  meta.device = "Office PC";
+  meta.seq = 3;
+  meta.nonce = "0011223344556677";
+  meta.written_ms = 1000;
+  meta.hlc = 200;
+  meta.joined_ms = 10;
+  return meta;
+}
+
+// `levels` lists, each the only item of the one around it.
+base::ListValue NestedListsW2B12(size_t levels) {
+  base::ListValue inner;
+  for (size_t i = 1; i < levels; ++i) {
+    base::ListValue outer;
+    outer.Append(std::move(inner));
+    inner = std::move(outer);
+  }
+  return inner;
+}
+
+// P14-1b, Sf34, Sf35: another computer's file gives a record a key this
+// version does not know, nested 194 levels deep: under the reader's limit
+// where the file holds it. The ledger journals that record three levels
+// deeper, past what the writer writes, so every save of the ledger was cut
+// short and the ledger was lost at the next launch. A key as deep as the
+// ledger can hold is still kept, as is an ordinary one.
+TEST(SidebarSyncLedgerW2B12Test, ADeepUnknownKeyNeverBreaksTheLedger) {
+  std::optional<base::DictValue> root = base::JSONReader::ReadDict(
+      SerializeSyncFile(SidebarW2B12(), MetaW2B12()), base::JSON_PARSE_RFC);
+  ASSERT_TRUE(root);
+  base::DictValue* const block = root->FindDict("stedding_sync");
+  ASSERT_TRUE(block);
+  base::DictValue* const records = block->FindDict("records");
+  ASSERT_TRUE(records);
+  base::DictValue* const work = records->FindDict(kSpaceW2B12);
+  ASSERT_TRUE(work);
+  base::ListValue pair;
+  pair.Append(1);
+  pair.Append(2);
+  base::DictValue later;
+  later.Set("a", std::move(pair));
+  work->Set("later", std::move(later));
+  // root, stedding_sync, records, the record, then the key: 192 levels of it
+  // reach level 196 in the file and level 199 in the ledger's journal.
+  work->Set("deepest_kept", NestedListsW2B12(192));
+  work->Set("too_deep", NestedListsW2B12(194));
+  std::string file;
+  ASSERT_TRUE(base::JSONWriter::Write(*root, &file));
+
+  const ParsedFile parsed = ParseSyncFile(file);
+  ASSERT_EQ(ParseStatus::kOk, parsed.status);
+  ASSERT_TRUE(parsed.state.records.contains(kSpaceW2B12));
+  const Record& record = parsed.state.records.at(kSpaceW2B12);
+  EXPECT_TRUE(record.x.contains("later"));
+  EXPECT_TRUE(record.x.contains("deepest_kept"));
+
+  // As MergePeer journals a record a batch changed: as it was before.
+  Ledger ledger;
+  ledger.state = parsed.state;
+  JournalEntry entry;
+  entry.id = "j";
+  entry.device = "Laptop";
+  entry.applied_ms = 1;
+  entry.changed = 1;
+  entry.before.records.emplace(kSpaceW2B12, record);
+  ledger.journal.push_back(std::move(entry));
+  std::string json;
+  EXPECT_TRUE(base::JSONWriter::Write(LedgerToValue(ledger), &json))
+      << "the ledger is written cut short";
+
+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  ASSERT_TRUE(WriteLedgerJson(profile.GetPath(), json));
+  const std::optional<Ledger> read = ReadLedger(profile.GetPath());
+  ASSERT_TRUE(read) << "the ledger is lost at the next launch";
+  EXPECT_EQ(parsed.state, read->state);
+  ASSERT_EQ(1u, read->journal.size());
+  EXPECT_EQ("j", read->journal[0].id);
+  ASSERT_TRUE(read->journal[0].before.records.contains(kSpaceW2B12));
+  EXPECT_TRUE(
+      read->journal[0].before.records.at(kSpaceW2B12).x.contains("later"));
+}
+
+// --- The test of a place (Sf47, Sf49). ---
+
+const char* KindNameW2B12(PlaceKind kind) {
+  return kind == PlaceKind::kS3 ? "S3" : "WebDAV";
+}
+
+// A place in memory behind a fake loader factory, which can answer a 401
+// with a WWW-Authenticate field of its own, or store a write and then lose
+// its answer on the way back.
+class LossyServerW2B12 {
+ public:
+  explicit LossyServerW2B12(PlaceKind place_kind)
+      : place(place_kind),
+        shared(base::MakeRefCounted<
+               network::WeakWrapperSharedURLLoaderFactory>(&factory)) {
+    factory.SetInterceptor(base::BindRepeating(&LossyServerW2B12::Answer,
+                                               base::Unretained(this)));
+  }
+
+  std::unique_ptr<PlaceClient> Client(const std::string& secret) {
+    const PlaceForm form =
+        CheckPlaceForm(place.Form(GURL("https://place.example.net/"), secret));
+    return std::make_unique<PlaceClient>(*form.place, *form.sign_in, shared,
+                                         base::DefaultClock::GetInstance());
+  }
+
+  FakePlace place;
+  network::TestURLLoaderFactory factory;
+  scoped_refptr<network::SharedURLLoaderFactory> shared;
+  // A 401 carries this one field in place of the place's own challenge.
+  std::string challenge;
+  // A write the place stored is answered with this status, or fails with
+  // this network error, as when its answer is lost on the way back.
+  int lost_status = 0;
+  int lost_error = net::OK;
+  // How many stored writes lost their answer.
+  int lost = 0;
+
+ private:
+  void Answer(const network::ResourceRequest& request) {
+    std::map<std::string, std::string> headers;
+    for (const net::HttpRequestHeaders::HeaderKeyValuePair& header :
+         request.headers.GetHeaderVector()) {
+      headers[base::ToLowerASCII(header.key)] = header.value;
+    }
+    std::string body;
+    if (request.request_body && !request.request_body->elements()->empty()) {
+      body = std::string(request.request_body->elements()
+                             ->front()
+                             .As<network::DataElementBytes>()
+                             .AsStringPiece());
+    }
+    FakePlace::Reply reply =
+        place.Handle(request.method, request.url, headers, body);
+    const bool stored =
+        request.method == "PUT" && reply.status >= 200 && reply.status < 300;
+    if (stored && (lost_status || lost_error != net::OK)) {
+      ++lost;
+      if (lost_error != net::OK) {
+        factory.AddResponse(request.url,
+                            network::CreateURLResponseHead(net::HTTP_OK),
+                            std::string(),
+                            network::URLLoaderCompletionStatus(lost_error));
+        return;
+      }
+      reply.status = lost_status;
+      reply.body.clear();
+      reply.headers.clear();
+    }
+    if (!challenge.empty() && reply.status == 401) {
+      std::erase_if(reply.headers,
+                    [](const std::pair<std::string, std::string>& header) {
+                      return base::EqualsCaseInsensitiveASCII(
+                          header.first, "www-authenticate");
+                    });
+      reply.headers.emplace_back("WWW-Authenticate", challenge);
+    }
+    auto head = network::CreateURLResponseHead(
+        static_cast<net::HttpStatusCode>(reply.status));
+    for (const auto& [name, value] : reply.headers) {
+      head->headers->AddHeader(name, value);
+    }
+    factory.AddResponse(request.url, std::move(head), reply.body,
+                        network::URLLoaderCompletionStatus());
+  }
+};
+
+class SidebarSyncPlaceCheckW2B12Test : public testing::Test {
+ protected:
+  PlaceCheck::Result Run(LossyServerW2B12& server,
+                         const std::string& secret = FakePlace::kSecret) {
+    std::unique_ptr<PlaceClient> client = server.Client(secret);
+    base::test::TestFuture<PlaceCheck::Result> done;
+    PlaceCheck check(client.get(), done.GetCallback());
+    check.Start();
+    return done.Get();
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  data_decoder::test::InProcessDataDecoder data_decoder_;
+};
+
+// P15-1c, Sf47: a wrong password is named as one when the server lists Basic
+// after another kind of sign-in in one WWW-Authenticate field, as RFC 9110
+// allows. Only the first was looked at, so the test said the server asks for
+// a kind of sign-in Stedding does not use. Basic named only inside another
+// challenge's parameters is still not offered.
+TEST_F(SidebarSyncPlaceCheckW2B12Test,
+       ABasicListedSecondIsStillAWrongPassword) {
+  struct Case {
+    const char* challenge;
+    PlaceFailure failure;
+  };
+  const Case kCases[] = {
+      {"Digest realm=\"x\", nonce=\"y\", Basic realm=\"x\"",
+       PlaceFailure::kSignIn},
+      {"Negotiate, Basic realm=\"x\"", PlaceFailure::kSignIn},
+      {"Digest realm=\"x\", nonce=\"y\", basic", PlaceFailure::kSignIn},
+      {"Basic realm=\"x\"", PlaceFailure::kSignIn},
+      {"Digest realm=\"x\", nonce=\"y\"", PlaceFailure::kSignInKind},
+      {"Digest realm=\"Basic x\", nonce=\"y\"", PlaceFailure::kSignInKind},
+      {"Digest realm=\"x, Basic y\", nonce=\"z\"", PlaceFailure::kSignInKind},
+      {"Digest realm=\"x\", basic=\"y\"", PlaceFailure::kSignInKind},
+  };
+  for (const Case& each : kCases) {
+    SCOPED_TRACE(each.challenge);
+    LossyServerW2B12 server(PlaceKind::kWebDav);
+    server.challenge = each.challenge;
+    const PlaceCheck::Result result = Run(server, "wrong");
+    EXPECT_EQ(result.failure, each.failure)
+        << PlaceFailureName(result.failure);
+    EXPECT_FALSE(server.place.HasFolder());
+  }
+}
+
+// P15-1b, Sf47, Sf49: a probe the server stored but whose answer was lost (a
+// proxy's 502, no answer in time) is deleted all the same, and the folder the
+// test made goes with it. Both stayed on the server for good, the folder no
+// longer empty for Cancel to remove.
+TEST_F(SidebarSyncPlaceCheckW2B12Test, AProbeStoredButNotAnsweredIsDeleted) {
+  struct Loss {
+    int status;
+    int error;
+    PlaceFailure failure;
+  };
+  const Loss kLosses[] = {
+      {502, net::OK, PlaceFailure::kServerError},
+      {0, net::ERR_TIMED_OUT, PlaceFailure::kTimedOut},
+  };
+  for (const Loss& loss : kLosses) {
+    for (const PlaceKind kind : {PlaceKind::kWebDav, PlaceKind::kS3}) {
+      SCOPED_TRACE(base::StrCat({KindNameW2B12(kind), " losing ",
+                                 base::NumberToString(loss.status), " ",
+                                 net::ErrorToShortString(loss.error)}));
+      LossyServerW2B12 server(kind);
+      server.lost_status = loss.status;
+      server.lost_error = loss.error;
+      const PlaceCheck::Result result = Run(server);
+      EXPECT_EQ(result.failure, loss.failure)
+          << PlaceFailureName(result.failure);
+      EXPECT_EQ(server.lost, 1) << "the probe was never stored";
+      EXPECT_TRUE(server.place.Files().empty()) << "the probe stayed";
+      EXPECT_FALSE(result.made_folder);
+      if (kind == PlaceKind::kWebDav) {
+        EXPECT_FALSE(server.place.HasFolder())
+            << "the folder the test made stayed";
+      }
+    }
+  }
+}
+
+}  // namespace
+
+}  // namespace spaces::sidebar_sync
