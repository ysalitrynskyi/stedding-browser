+void TabView::BeginRename() {
+  if (!rename_field_ || !collection_node_ || IsRenaming()) {
+    return;
+  }
+  const TabUIHelper* const helper = TabUIHelper::From(GetTabInterface());
+  rename_field_->SetText(helper ? helper->GetTitle()
+                                : std::u16string(title_->GetText()));
+  rename_field_->SetVisible(true);
+  rename_field_->SetBoundsRect(title_->GetVisible() ? title_->bounds()
+                                                    : GetContentsBounds());
+  InvalidateLayout();
+  rename_field_->RequestFocus();
+  rename_field_->SelectAll(false);
+}
+
+void TabView::SetNumberBadge(int number) {
+  if (!number_badge_) {
+    return;
+  }
+  if (number <= 0) {
+    number_badge_->SetVisible(false);
+    return;
+  }
+  const bool was_visible = number_badge_->GetVisible();
+  number_badge_->SetText(base::NumberToString16(number));
+  number_badge_->SetEnabledColor(pinned_
+                                     ? kColorTabForegroundActiveFrameActive
+                                     : kColorTabForegroundInactiveFrameActive);
+  number_badge_->SetVisible(true);
+  InvalidateLayout();
+  if (was_visible) {
+    return;
+  }
+  ui::Layer* const layer = number_badge_->layer();
+  if (stedding::ShouldAnimate(nullptr)) {
+    layer->SetOpacity(0.0f);
+    ui::ScopedLayerAnimationSettings settings(layer->GetAnimator());
+    settings.SetTransitionDuration(base::Milliseconds(80));
+    layer->SetOpacity(1.0f);
+  } else {
+    layer->SetOpacity(1.0f);
+  }
+}
+
+bool TabView::IsRenaming() const {
+  return rename_field_ && rename_field_->GetVisible();
+}
+
+void TabView::EndRename(bool commit) {
+  if (!IsRenaming()) {
+    return;
+  }
+  if (commit && collection_node_) {
+    tabs::TabInterface* const tab =
+        const_cast<tabs::TabInterface*>(GetTabInterface());
+    stedding::SetTabName(tab->GetBrowserWindowInterface(), tab,
+                         std::u16string(rename_field_->GetText()));
+    if (TabUIHelper* const helper = TabUIHelper::From(tab)) {
+      helper->TabNameChanged();
+    }
+  }
+  rename_field_->SetVisible(false);
+  RequestFocus();
+}
+
+bool TabView::HandleKeyEvent(views::Textfield* sender,
+                             const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    EndRename(/*commit=*/true);
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    EndRename(/*commit=*/false);
+    return true;
+  }
+  return false;
+}
+
 BEGIN_METADATA(TabView)
 END_METADATA
