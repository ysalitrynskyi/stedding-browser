+namespace stedding {
+namespace {
+
+// toolbar T15, T17: the bar is the page's colour, and every icon on it, the
+// star included, takes the colour with most contrast against that.
+TEST(PageBarColorSupplierTest, IconsContrastWithThePageColour) {
+  ui::ColorProviderKey key;
+  key.color_mode = ui::ColorProviderKey::ColorMode::kDark;
+
+  ui::ColorProvider on_white;
+  PageBarColorSupplier white(SK_ColorWHITE);
+  white.AddColorMixers(&on_white, key);
+  on_white.GenerateColorMapForTesting();
+  EXPECT_EQ(SK_ColorWHITE, on_white.GetColor(kColorToolbarContentAreaSeparator))
+      << "the bar is the page's white, not a blend";
+  EXPECT_TRUE(color_utils::IsDark(on_white.GetColor(kColorToolbarButtonIcon)));
+  EXPECT_EQ(on_white.GetColor(kColorToolbarButtonIcon),
+            on_white.GetColor(kColorOmniboxActionIcon))
+      << "the star follows the toolbar's icons";
+  EXPECT_EQ(on_white.GetColor(kColorToolbarButtonIcon),
+            on_white.GetColor(kColorOmniboxText));
+
+  ui::ColorProvider on_graphite;
+  PageBarColorSupplier graphite(SkColorSetRGB(0x1F, 0x24, 0x30));
+  graphite.AddColorMixers(&on_graphite, key);
+  on_graphite.GenerateColorMapForTesting();
+  EXPECT_FALSE(
+      color_utils::IsDark(on_graphite.GetColor(kColorOmniboxActionIcon)));
+}
+
+}  // namespace
+}  // namespace stedding
