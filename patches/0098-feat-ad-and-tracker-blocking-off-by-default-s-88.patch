+
+#include "base/feature_list.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/blocker/blocker_rules.h"
+#include "components/subresource_filter/content/browser/devtools_interaction_tracker.h"
+#include "components/subresource_filter/content/browser/subresource_filter_observer_manager.h"
+#include "components/subresource_filter/core/common/common_features.h"
+#include "components/subresource_filter/core/mojom/subresource_filter.mojom.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle_registry.h"
+#include "content/public/browser/web_contents.h"
+
+namespace stedding {
+
+// static
+void BlockerActivationThrottle::MaybeAdd(
+    content::NavigationThrottleRegistry& registry) {
+  registry.AddThrottle(std::make_unique<BlockerActivationThrottle>(registry));
+}
+
+BlockerActivationThrottle::BlockerActivationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+BlockerActivationThrottle::~BlockerActivationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+BlockerActivationThrottle::WillProcessResponse() {
+  content::NavigationHandle* const navigation = navigation_handle();
+  content::WebContents* const contents = navigation->GetWebContents();
+  auto* const observers =
+      subresource_filter::SubresourceFilterObserverManager::FromWebContents(
+          contents);
+  if (!observers) {
+    return PROCEED;
+  }
+  auto* const devtools =
+      subresource_filter::DevtoolsInteractionTracker::FromWebContents(
+          contents);
+  const bool blocking =
+      BlockerAppliesTo(
+          Profile::FromBrowserContext(contents->GetBrowserContext()),
+          navigation->GetURL()) ||
+      (devtools && devtools->activated_via_devtools());
+  subresource_filter::mojom::ActivationState state;
+  if (blocking) {
+    state.activation_level =
+        subresource_filter::mojom::ActivationLevel::kEnabled;
+  } else if (base::FeatureList::IsEnabled(subresource_filter::kAdTagging)) {
+    state.activation_level =
+        subresource_filter::mojom::ActivationLevel::kDryRun;
+  } else {
+    state.activation_level =
+        subresource_filter::mojom::ActivationLevel::kDisabled;
+  }
+  observers->NotifyPageActivationComputed(navigation, state);
+  return PROCEED;
+}
+
+const char* BlockerActivationThrottle::GetNameForLogging() {
+  return "SteddingBlockerActivationThrottle";
+}
+
+}  // namespace stedding
