+SteddingBrowserViewLayout::SteddingBrowserViewLayout(
+    std::unique_ptr<BrowserViewLayoutDelegate> delegate,
+    BrowserViewLayoutViews views)
+    : BrowserViewTabbedLayoutImpl(std::move(delegate), std::move(views)) {}
+
+SteddingBrowserViewLayout::~SteddingBrowserViewLayout() = default;
+
+gfx::Rect SteddingBrowserViewLayout::CalculateTopContainerLayout(
+    ProposedLayout& layout,
+    BrowserLayoutParams params,
+    bool needs_exclusion) const {
+  // The top container is sized as max(caption-button height, its own minimum)
+  // whenever the window has a leading exclusion. On macOS that exclusion is the
+  // traffic lights, 38 DIP with padding -- which is also, by coincidence, what
+  // the toolbar preferred anyway, so shrinking the toolbar alone moved nothing
+  // and dropping the exclusion alone moved nothing either.
+  //
+  // With a vertical tab strip the traffic lights sit over the tab strip, which
+  // already leaves room for them; the top container is in a different column
+  // and does not have to clear them.
+  // In macOS immersive fullscreen the top container lives in the reveal
+  // overlay, which spans the window, while the vertical tab strip stays in
+  // the window at full height. Start the toolbar where the strip ends, as it
+  // does outside fullscreen, instead of running it over the strip's top.
+  int strip_inset = 0;
+  if (DrawsVerticalStrip(delegate())) {
+    const ImmersiveModeController* const immersive =
+        delegate().GetImmersiveModeController();
+    if (immersive && immersive->IsEnabled() &&
+        views().vertical_tab_strip_region_view) {
+      strip_inset =
+          views().vertical_tab_strip_region_view->width() > 0
+              ? views().vertical_tab_strip_region_view->width()
+              : views().vertical_tab_strip_region_view->uncollapsed_width();
+      params.visual_client_area.Inset(gfx::Insets::TLBR(0, strip_inset, 0, 0));
+    }
+  }
+  gfx::Rect result = BrowserViewTabbedLayoutImpl::CalculateTopContainerLayout(
+      layout, std::move(params),
+      needs_exclusion && !DrawsVerticalStrip(delegate()));
+  // The children were placed past the strip inside the container; the
+  // container itself still spans the overlay, or the offset would apply
+  // twice.
+  if (strip_inset > 0) {
+    result.set_x(result.x() - strip_inset);
+    result.set_width(result.width() + strip_inset);
+  }
+  return result;
+}
+
+void SteddingBrowserViewLayout::DoPostLayoutVisualAdjustments(
+    const BrowserLayoutParams& params) {
+  BrowserViewTabbedLayoutImpl::DoPostLayoutVisualAdjustments(params);
+
+  // The floating tab-strip corners exist to blend a flush content edge into
+  // the strip. With the content floating on a mat there is no flush edge, and
+  // what remains of them is a tinted notch at the top of the seam.
+  if (views().vertical_tab_strip_top_corner) {
+    views().vertical_tab_strip_top_corner->SetAlpha(0.f);
+  }
+  if (views().vertical_tab_strip_bottom_corner) {
+    views().vertical_tab_strip_bottom_corner->SetAlpha(0.f);
+  }
+
+  MultiContentsView* const contents = views().multi_contents_view;
+  if (!contents) {
+    return;
+  }
+
+  // The content card floats on a mat (see MultiContentsView's layout), so all
+  // four corners are rounded, as the reference does. Upstream sets its own
+  // radii every layout -- in glass mode that is the lower leading corner only,
+  // which is non-empty, so "set ours if upstream set none" never fired and
+  // three corners stayed square. Merge per corner, larger radius wins, so a
+  // radius upstream chose for split view or a side panel is still kept.
+  const float ours = static_cast<float>(stedding::kContentsCornerRadius.Get());
+  const gfx::RoundedCornersF current = contents->GetBackgroundRadii();
+  const gfx::RoundedCornersF merged(
+      std::max(current.upper_left(), ours), std::max(current.upper_right(), ours),
+      std::max(current.lower_right(), ours), std::max(current.lower_left(), ours));
+  if (merged != current) {
+    contents->SetBackgroundRadii(merged);
+  }
+}
