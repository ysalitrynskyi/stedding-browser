+std::string IsolationMarkForSpace(const SpaceRegistry* registry,
+                                  const SpaceId& id) {
+  if (!registry) {
+    return std::string();
+  }
+  const RegistryEntry* const entry = registry->Find(id);
+  if (!entry || entry->profile_id.empty()) {
+    return std::string();
+  }
+  return "Independent session";
+}
+
+bool WipeIsolatedSpacePartition(content::BrowserContext* browser_context,
+                                std::string_view profile_id,
+                                base::OnceClosure done) {
+  auto finish = [&](bool ok) {
+    if (done) {
+      std::move(done).Run();
+    }
+    return ok;
+  };
+  std::optional<content::StoragePartitionConfig> config =
+      StoragePartitionConfigForProfileId(browser_context, profile_id);
+  if (!config) {
+    return finish(false);
+  }
+  content::StoragePartition* const partition =
+      browser_context->GetStoragePartition(*config);
+  if (!partition) {
+    return finish(false);
+  }
+  if (!done) {
+    done = base::DoNothing();
+  }
+  partition->ClearData(
+      content::StoragePartition::REMOVE_DATA_MASK_ALL,
+      /*filter_builder=*/nullptr,
+      content::StoragePartition::StorageKeyPolicyMatcherFunction(),
+      network::mojom::CookieDeletionFilter::New(),
+      /*perform_storage_cleanup=*/false, base::Time(), base::Time::Max(),
+      std::move(done));
+  return true;
+}
+
+bool WipeIsolatedSpacePartition(content::BrowserContext* browser_context,
+                                const SpaceRegistry* registry,
+                                const SpaceId& id,
+                                base::OnceClosure done) {
+  if (!registry) {
+    if (done) {
+      std::move(done).Run();
+    }
+    return false;
+  }
+  const RegistryEntry* const entry = registry->Find(id);
+  if (!entry) {
+    if (done) {
+      std::move(done).Run();
+    }
+    return false;
+  }
+  return WipeIsolatedSpacePartition(browser_context, entry->profile_id,
+                                    std::move(done));
+}
