@@ -0,0 +1,229 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/archive/closed_tabs_undo.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/archive/archive_mark.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/serialized_navigation_entry_test_helper.h"
+#include "components/sessions/core/session_id.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "components/split_tabs/split_tab_id.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// A close the user makes, with every condition for Undo met.
+LeavingTab UserClose() {
+  LeavingTab tab;
+  tab.closed = true;
+  tab.user_gesture = true;
+  tab.recorded = true;
+  tab.undo_toast_on = true;
+  return tab;
+}
+
+std::unique_ptr<sessions::tab_restore::Tab> ClosedTab(int id,
+                                                      const char* url,
+                                                      const char16_t* title,
+                                                      int index) {
+  auto tab = std::make_unique<sessions::tab_restore::Tab>();
+  tab->id = SessionID::FromSerializedValue(id);
+  sessions::SerializedNavigationEntry entry =
+      sessions::SerializedNavigationEntryTestHelper::CreateNavigationForTest();
+  entry.set_virtual_url(GURL(url));
+  entry.set_title(title);
+  tab->navigations.push_back(std::move(entry));
+  tab->current_navigation_index = 0;
+  tab->tabstrip_index = index;
+  return tab;
+}
+
+std::unique_ptr<sessions::tab_restore::Split> ClosedSplit(
+    int id,
+    const split_tabs::SplitTabId& split_id,
+    int index) {
+  auto split = std::make_unique<sessions::tab_restore::Split>();
+  split->id = SessionID::FromSerializedValue(id);
+  split->split_id = split_id;
+  split->tabs.push_back(
+      ClosedTab(id * 100 + 1, "https://left.example/", u"Left", index));
+  split->tabs.push_back(
+      ClosedTab(id * 100 + 2, "https://right.example/", u"Right", index + 1));
+  return split;
+}
+
+SessionID Id(int id) {
+  return SessionID::FromSerializedValue(id);
+}
+
+// tabs R25, R26: a recorded close the user makes offers Undo, Clear's
+// included; the sweep, a page, an extension, a move to another window, a
+// close with no record and a window closing do not.
+TEST(ClosedTabsUndoTest, AUserCloseOffersUndo) {
+  EXPECT_TRUE(OffersUndo(UserClose())) << "⌘W, the close button, the menus";
+
+  LeavingTab clear = UserClose();
+  clear.reason = ArchiveReasonName(ArchiveReason::kClear);
+  EXPECT_TRUE(OffersUndo(clear)) << "Clear is a close the user makes";
+
+  LeavingTab sweep = UserClose();
+  sweep.user_gesture = false;
+  sweep.reason = ArchiveReasonName(ArchiveReason::kAuto);
+  EXPECT_FALSE(OffersUndo(sweep)) << "the archive sweep (archive A1)";
+
+  LeavingTab marked = UserClose();
+  marked.reason = ArchiveReasonName(ArchiveReason::kAuto);
+  EXPECT_FALSE(OffersUndo(marked)) << "a record the sweep marked";
+
+  LeavingTab unrecorded = UserClose();
+  unrecorded.recorded = false;
+  EXPECT_FALSE(OffersUndo(unrecorded))
+      << "no entry: a tab of a closing window, or a close without history";
+
+  LeavingTab page = UserClose();
+  page.user_gesture = false;
+  EXPECT_FALSE(OffersUndo(page)) << "window.close() or chrome.tabs.remove";
+
+  LeavingTab moved = UserClose();
+  moved.closed = false;
+  EXPECT_FALSE(OffersUndo(moved)) << "dragged or moved to another window";
+
+  LeavingTab closing_all = UserClose();
+  closing_all.window_closing = true;
+  EXPECT_FALSE(OffersUndo(closing_all)) << "the window or the app closing";
+}
+
+// tabs R30: stedding.tabs.undo_toast is on by default, and while it is off
+// no close offers Undo, so no toast is shown.
+TEST(ClosedTabsUndoTest, TheSettingTurnsTheToastOff) {
+  sync_preferences::TestingPrefServiceSyncable service;
+  prefs::RegisterProfilePrefs(service.registry());
+  ASSERT_TRUE(service.FindPreference(prefs::kUndoToast));
+  EXPECT_TRUE(UndoToastOn(&service)) << "on by default";
+
+  LeavingTab close = UserClose();
+  close.undo_toast_on = UndoToastOn(&service);
+  EXPECT_TRUE(OffersUndo(close));
+
+  service.SetBoolean(prefs::kUndoToast, false);
+  close.undo_toast_on = UndoToastOn(&service);
+  EXPECT_FALSE(OffersUndo(close)) << "no toast while the setting is off";
+
+  service.SetBoolean(prefs::kUndoToast, true);
+  close.undo_toast_on = UndoToastOn(&service);
+  EXPECT_TRUE(OffersUndo(close)) << "and back on";
+  EXPECT_FALSE(UndoToastOn(nullptr));
+}
+
+// tabs R25, R27: an entry is named by the user's name for the tab, else its
+// page title, else its address; it gives its archive mark and the index it
+// was closed at; a split counts both panes.
+TEST(ClosedTabsUndoTest, DescribeReadsTheNameTitleAndReason) {
+  sessions::TabRestoreService::Entries entries;
+  entries.push_back(ClosedTab(1, "https://mail.example/", u"Inbox (3)", 4));
+  entries.back()->extra_data[kSessionTabNameKey] = "Inbox";
+  entries.back()->extra_data[kArchiveReasonKey] =
+      ArchiveReasonName(ArchiveReason::kClear);
+  entries.push_back(ClosedTab(2, "https://b.example/", u"Page", 2));
+  entries.push_back(ClosedTab(3, "https://c.example/", u"", 0));
+  const split_tabs::SplitTabId split_id = split_tabs::SplitTabId::GenerateNew();
+  entries.push_back(ClosedSplit(4, split_id, 6));
+
+  const std::optional<ClosedEntry> named = DescribeClosedEntry(entries, Id(1));
+  ASSERT_TRUE(named.has_value());
+  EXPECT_EQ(Id(1), named->id);
+  EXPECT_EQ(1u, named->tabs);
+  EXPECT_EQ(u"Inbox", named->title) << "the user's name beats the title";
+  EXPECT_EQ("clear", named->reason);
+  EXPECT_EQ(4, named->index);
+  EXPECT_FALSE(named->split);
+
+  const std::optional<ClosedEntry> titled = DescribeClosedEntry(entries, Id(2));
+  ASSERT_TRUE(titled.has_value());
+  EXPECT_EQ(u"Page", titled->title);
+  EXPECT_TRUE(titled->reason.empty()) << "a plain close has no mark";
+  EXPECT_EQ(2, titled->index);
+
+  const std::optional<ClosedEntry> untitled =
+      DescribeClosedEntry(entries, Id(3));
+  ASSERT_TRUE(untitled.has_value());
+  EXPECT_EQ(u"https://c.example/", untitled->title) << "else the address";
+
+  const std::optional<ClosedEntry> split = DescribeClosedEntry(entries, Id(4));
+  ASSERT_TRUE(split.has_value());
+  EXPECT_TRUE(split->split);
+  EXPECT_EQ(2u, split->tabs) << "a split closed whole counts both panes";
+  EXPECT_EQ(6, split->index);
+  EXPECT_TRUE(split->title.empty());
+
+  EXPECT_FALSE(DescribeClosedEntry(entries, Id(99)).has_value());
+}
+
+// tabs R25: a split closed whole, whose panes carry no entry of their own,
+// is found by its split's id, the newest entry first.
+TEST(ClosedTabsUndoTest, FindsTheSplitsEntry) {
+  const split_tabs::SplitTabId first = split_tabs::SplitTabId::GenerateNew();
+  const split_tabs::SplitTabId second = split_tabs::SplitTabId::GenerateNew();
+  sessions::TabRestoreService::Entries entries;
+  entries.push_back(ClosedTab(1, "https://a.example/", u"A", 0));
+  entries.push_back(ClosedSplit(2, first, 1));
+  entries.push_back(ClosedSplit(3, second, 3));
+
+  EXPECT_EQ(Id(2), FindClosedSplit(entries, first));
+  EXPECT_EQ(Id(3), FindClosedSplit(entries, second));
+  EXPECT_FALSE(
+      FindClosedSplit(entries, split_tabs::SplitTabId::GenerateNew())
+          .has_value())
+      << "another split";
+
+  entries.push_front(ClosedSplit(5, first, 1));
+  EXPECT_EQ(Id(5), FindClosedSplit(entries, first)) << "the newest entry";
+}
+
+// tabs R27: Undo restores the offered entries in the list's order, newest
+// first, which puts each tab back at its recorded index, and skips what
+// ⇧⌘T already brought back.
+TEST(ClosedTabsUndoTest, UndoGoesNewestFirst) {
+  sessions::TabRestoreService::Entries entries;
+  for (const int id : {5, 3, 9, 1}) {
+    entries.push_back(ClosedTab(id, "https://a.example/", u"A", 0));
+  }
+  EXPECT_EQ((std::vector<SessionID>{Id(9), Id(1)}),
+            UndoOrder(entries, {Id(1), Id(9), Id(7)}))
+      << "7 was reopened with ⇧⌘T";
+  EXPECT_TRUE(UndoOrder(entries, {}).empty());
+}
+
+// tabs R25: one tab is named, in quotes, cut to 40 characters; more are
+// counted; a title is printed as written, braces and all.
+TEST(ClosedTabsUndoTest, TheToastNamesOneTabAndCountsMore) {
+  EXPECT_EQ(u"“Inbox” closed", ClosedTabsToastText(1, u"Inbox"));
+
+  const std::u16string long_title(100, u'x');
+  EXPECT_EQ(u"“" + std::u16string(39, u'x') + u"…” closed",
+            ClosedTabsToastText(1, long_title))
+      << "cut to 40 characters with an ellipsis";
+
+  EXPECT_EQ(u"3 tabs closed", ClosedTabsToastText(3, u""));
+  EXPECT_EQ(u"2 tabs closed", ClosedTabsToastText(2, u"Ignored"));
+  EXPECT_EQ(u"1 tab closed", ClosedTabsToastText(1, u""))
+      << "a tab with no title is counted";
+  EXPECT_EQ(u"“{COUNT} and $1” closed",
+            ClosedTabsToastText(1, u"{COUNT} and $1"));
+}
+
+}  // namespace
+}  // namespace stedding
