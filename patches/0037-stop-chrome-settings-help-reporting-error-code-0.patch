From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Tue, 1 Sep 2026 07:47:54 -0400
Subject: stop chrome://settings/help reporting error code 0

The stock macOS updater asks Keystone, which this unsigned build does not ship,
and the help page rendered the failure as "An error occurred while checking for
updates: 0 (error code 0)". The page now uses a Stedding updater that reports a
plain disabled state -- the same shape as upstream's VersionUpdaterBasic, which
cannot be used directly on macOS because PromoteUpdater() is a Mac-only pure
virtual it does not implement.

Updates ship via GitHub Releases until M7 wires an updater; docs/ROADMAP.md.

Why: an error string on the about page reads as a broken product.
Removable when: M7 lands a real updater.
---
 chrome/browser/ui/webui/help/BUILD.gn         | 15 +++----
 .../help/version_updater_stedding_mac.cc      | 45 +++++++++++++++++++
 2 files changed, 50 insertions(+), 10 deletions(-)
 create mode 100644 chrome/browser/ui/webui/help/version_updater_stedding_mac.cc

diff --git a/chrome/browser/ui/webui/help/BUILD.gn b/chrome/browser/ui/webui/help/BUILD.gn
index 17d8d3e2832c4..86f1392671052 100644
--- a/chrome/browser/ui/webui/help/BUILD.gn
+++ b/chrome/browser/ui/webui/help/BUILD.gn
@@ -36,16 +36,11 @@ source_set("help") {
   }
 
   if (is_mac) {
-    sources = [ "version_updater_mac.mm" ]
-    deps += [
-      "//base:i18n",
-      "//chrome/app:branded_strings",
-      "//chrome/app:generated_resources_grit",
-      "//chrome/browser/updater",
-      "//chrome/updater:browser_sources",
-      "//ui/base",
-    ]
-    frameworks = [ "Foundation.framework" ]
+    # Stedding: no Keystone in an unsigned build. The Keystone-backed updater
+    # reports "error code 0" on chrome://settings/help; the basic stub reports
+    # a plain disabled state instead, the same as non-branded Windows. Real
+    # updates ship via GitHub Releases until M7 wires an updater.
+    sources = [ "version_updater_stedding_mac.cc" ]
   }
 
   if (is_win) {
diff --git a/chrome/browser/ui/webui/help/version_updater_stedding_mac.cc b/chrome/browser/ui/webui/help/version_updater_stedding_mac.cc
new file mode 100644
index 0000000000000..d283426af1757
--- /dev/null
+++ b/chrome/browser/ui/webui/help/version_updater_stedding_mac.cc
@@ -0,0 +1,45 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <memory>
+#include <string>
+
+#include "chrome/browser/ui/webui/help/version_updater.h"
+#include "chrome/browser/upgrade_detector/upgrade_detector.h"
+
+namespace {
+
+// The macOS updater for a build with no Keystone. The stock VersionUpdaterMac
+// asks Keystone and, in a build that does not ship it, reports "error code 0"
+// on chrome://settings/help. This one reports a plain disabled state instead.
+// Updates ship via GitHub Releases until an updater lands (docs/ROADMAP.md M7).
+//
+// This mirrors upstream's VersionUpdaterBasic, which cannot be used directly on
+// macOS: PromoteUpdater() is a Mac-only pure virtual it does not implement.
+class VersionUpdaterSteddingMac : public VersionUpdater {
+ public:
+  VersionUpdaterSteddingMac() = default;
+  VersionUpdaterSteddingMac(const VersionUpdaterSteddingMac&) = delete;
+  VersionUpdaterSteddingMac& operator=(const VersionUpdaterSteddingMac&) =
+      delete;
+  ~VersionUpdaterSteddingMac() override = default;
+
+  // VersionUpdater:
+  void CheckForUpdate(StatusCallback callback, PromoteCallback) override {
+    const Status status = UpgradeDetector::GetInstance()->is_upgrade_available()
+                              ? NEARLY_UPDATED
+                              : DISABLED;
+    callback.Run(status, 0, false, false, std::string(), 0, std::u16string());
+  }
+
+  // There is no updater to promote.
+  void PromoteUpdater() override {}
+};
+
+}  // namespace
+
+std::unique_ptr<VersionUpdater> VersionUpdater::Create(
+    content::WebContents* web_contents) {
+  return std::make_unique<VersionUpdaterSteddingMac>();
+}
