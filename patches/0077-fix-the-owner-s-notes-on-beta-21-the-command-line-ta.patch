+// How plainly a highlight of `colour` at `opacity` shows over `ground`: the
+// contrast between the ground and the ground under the highlight.
+double HighlightContrast(SkColor colour, float opacity, SkColor ground) {
+  // Rounded: a layer of alpha 35 hands back an opacity of 35/255, which
+  // times 255 comes to just under 35.
+  const SkColor over = color_utils::AlphaBlend(
+      SkColorSetA(colour, SK_AlphaOPAQUE), ground,
+      static_cast<SkAlpha>(std::lround(opacity * SkColorGetA(colour))));
+  return color_utils::GetContrastRatio(over, ground);
+}
+
+// The hover `button`'s own ink drop draws, against `ground`.
+double HoverContrast(views::View* button, SkColor ground) {
+  std::unique_ptr<views::InkDropHighlight> hover =
+      views::InkDrop::Get(button)->CreateInkDropHighlight();
+  if (!hover) {
+    return 1.0;
+  }
+  hover->FadeIn(base::TimeDelta());
+  // The toolbar's buttons draw a solid layer in the hover colour at its
+  // alpha; a menu row's painted highlight is the ink drop's base colour,
+  // which carries the alpha itself.
+  const ui::LayerSolidColor* const solid = hover->layer()->AsSolidColor();
+  const SkColor colour = solid ? solid->background_color().toSkColor()
+                               : views::InkDrop::Get(button)->GetBaseColor();
+  return HighlightContrast(colour, hover->layer()->GetTargetOpacity(), ground);
+}
