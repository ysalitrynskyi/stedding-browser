+  EXPECT_FALSE(SessionRestore::IsRestoring(profile));
+  ASSERT_EQ(0u, TabsOn("unrestored.test")) << "the session came back";
+  windows = WindowsWith("unrestored.test", profile);
+  ASSERT_EQ(2u, windows.size());
+  EXPECT_EQ("", MarkOf(*windows[0]))
+      << "a launch that restored nothing left the quit's window marked as "
+         "reopened";
+  EXPECT_EQ(stedding::kArchiveReopensYes, MarkOf(*windows[1]))
+      << "a window an earlier launch reopened became a close";
+  EXPECT_EQ(1u, ArchiveRowsFor("unrestored.test"))
+      << "the quit's tab is not in the archive once";
+  EXPECT_EQ(1u, BarArchivedRowsFor(u"unrestored"));
+  const auto most_recent = stedding::MostRecentClose(list->entries());
