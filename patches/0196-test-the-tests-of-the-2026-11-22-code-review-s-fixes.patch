+// found in the LICENSE file.
+
+// docs/features/windows.md G19 (ADR 0035): the first launch of a version with
+// the pin store keeps a backup of every window's sidebar before it merges
+// them, one file for each window.
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
