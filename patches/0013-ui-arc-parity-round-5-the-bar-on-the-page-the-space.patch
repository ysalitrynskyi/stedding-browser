new file mode 100644
index 0000000000000..1dc315295cacb
--- /dev/null
+++ b/chrome/browser/ui/stedding/theme/page_theme_color_controller.cc
@@ -0,0 +1,85 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/theme/page_theme_color_controller.h"
+
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace stedding {
+
+DEFINE_USER_DATA(PageThemeColorController);
+
+// static
+PageThemeColorController* PageThemeColorController::From(
+    BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+PageThemeColorController::PageThemeColorController(
+    BrowserWindowInterface& browser)
+    : browser_(browser),
+      scoped_user_data_(browser.GetUnownedUserDataHost(), *this) {
+  browser_->GetTabStripModel()->AddObserver(this);
+  if (tabs::TabInterface* const active =
+          browser_->GetTabStripModel()->GetActiveTab()) {
+    Observe(active->GetContents());
+  }
+  Refresh();
+}
+
+PageThemeColorController::~PageThemeColorController() {
+  if (TabStripModel* const model = browser_->GetTabStripModel()) {
+    model->RemoveObserver(this);
+  }
+}
+
+base::CallbackListSubscription PageThemeColorController::AddChangedCallback(
+    base::RepeatingClosure callback) {
+  return changed_callbacks_.Add(std::move(callback));
+}
+
+void PageThemeColorController::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    Observe(selection.new_tab ? selection.new_tab->GetContents() : nullptr);
+    Refresh();
+  }
+}
+
+void PageThemeColorController::DidChangeThemeColor() {
+  Refresh();
+}
+
+void PageThemeColorController::PrimaryPageChanged(content::Page& page) {
+  // A new page starts with no colour of its own; DidChangeThemeColor follows
+  // once it has painted and declared one.
+  Refresh();
+}
+
+void PageThemeColorController::WebContentsDestroyed() {
+  Observe(nullptr);
+  Refresh();
+}
+
+void PageThemeColorController::Refresh() {
+  std::optional<SkColor> color;
+  if (content::WebContents* const contents = web_contents()) {
+    if (const std::optional<SkColor> theme = contents->GetThemeColor()) {
+      // The bar is an opaque surface.
+      color = SkColorSetA(*theme, SK_AlphaOPAQUE);
+    }
+  }
+  if (color == color_) {
+    return;
+  }
+  color_ = color;
+  changed_callbacks_.Notify();
+}
+
+}  // namespace stedding
