index 0000000000000..6ca71f5f4bae8
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/vertical/sidebar_address.cc
@@ -0,0 +1,326 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/vertical/sidebar_address.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/escape.h"
+#include "base/strings/string_util.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/strings/grit/components_strings.h"
+#include "components/url_formatter/elide_url.h"
+#include "components/url_formatter/url_formatter.h"
+#include "components/vector_icons/vector_icons.h"
+#include "content/public/common/url_constants.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/ui_base_features.h"
+#include "ui/base/window_open_disposition_utils.h"
+#include "ui/color/color_provider.h"
+#include "ui/events/event.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/fill_layout.h"
+#include "ui/views/widget/widget.h"
+#include "url/url_constants.h"
+
+namespace stedding {
+
+namespace {
+
+// The gap between the three buttons.
+constexpr int kNavButtonGap = 2;
+// The field's text, inside its rounded ground.
+constexpr int kFieldTextInset = 12;
+// The field's ground, a tint of the sidebar's text colour (sidebar Y46), and
+// a little more under the pointer and while pressed.
+constexpr SkAlpha kFieldGroundAlpha = 0x16;
+constexpr SkAlpha kFieldHoveredAlpha = 0x24;
+// The placeholder's share of the text colour, and a button's with nothing to
+// do.
+constexpr SkAlpha kPlaceholderAlpha = 0x99;
+constexpr SkAlpha kDisabledIconAlpha = 0x5C;
+
+const gfx::VectorIcon& BackIcon() {
+  return ::features::IsRoundedIconsEnabled()
+             ? vector_icons::kArrowBackIcon
+             : vector_icons::kBackArrowChromeRefreshOldIcon;
+}
+
+const gfx::VectorIcon& ForwardIcon() {
+  return ::features::IsRoundedIconsEnabled()
+             ? vector_icons::kArrowForwardIcon
+             : vector_icons::kForwardArrowChromeRefreshOldIcon;
+}
+
+const gfx::VectorIcon& ReloadIcon() {
+  return ::features::IsRoundedIconsEnabled()
+             ? vector_icons::kRefreshIcon
+             : vector_icons::kReloadChromeRefreshOldIcon;
+}
+
+const gfx::VectorIcon& StopIcon() {
+  return ::features::IsRoundedIconsEnabled()
+             ? kCloseIcon
+             : kNavigateStopChromeRefreshOldIcon;
+}
+
+// A New Tab page, or a page with nothing on it: the field's placeholder.
+bool IsEmptyPage(const GURL& url) {
+  if (url.is_empty() || url.IsAboutBlank()) {
+    return true;
+  }
+  return url.SchemeIs(content::kChromeUIScheme) &&
+         (url.host() == chrome::kChromeUINewTabHost ||
+          url.host() == chrome::kChromeUINewTabPageHost);
+}
+
+}  // namespace
+
+std::u16string SidebarAddressText(const GURL& url) {
+  if (IsEmptyPage(url)) {
+    return std::u16string();
+  }
+  if (url.SchemeIsHTTPOrHTTPS() && !url.host().empty()) {
+    return url_formatter::FormatUrlForDisplayOmitSchemePathAndTrivialSubdomains(
+        url);
+  }
+  return url_formatter::FormatUrl(
+      url, url_formatter::kFormatUrlOmitDefaults, base::UnescapeRule::SPACES,
+      nullptr, nullptr, nullptr);
+}
+
+SidebarNavButton::SidebarNavButton(BrowserWindowInterface* browser,
+                                   int command)
+    : browser_(browser), command_(command) {
+  SetTriggerableEventFlags(ui::EF_LEFT_MOUSE_BUTTON |
+                           ui::EF_MIDDLE_MOUSE_BUTTON);
+  SetCallback(base::BindRepeating(
+      [](SidebarNavButton* button, const ui::Event& event) {
+        chrome::ExecuteCommandWithDisposition(
+            button->browser_, button->command_,
+            ui::DispositionFromEventFlags(event.flags()));
+      },
+      base::Unretained(this)));
+}
+
+SidebarNavButton::~SidebarNavButton() = default;
+
+void SidebarNavButton::SetCommand(int command,
+                                  const gfx::VectorIcon& icon,
+                                  const std::u16string& tooltip,
+                                  const std::u16string& name) {
+  command_ = command;
+  icon_ = &icon;
+  SetTooltipText(tooltip);
+  GetViewAccessibility().SetName(name);
+  Recolor();
+}
+
+void SidebarNavButton::AddedToWidget() {
+  views::LabelButton::AddedToWidget();
+  paint_as_active_subscription_ =
+      GetWidget()->RegisterPaintAsActiveChangedCallback(base::BindRepeating(
+          &SidebarNavButton::Recolor, base::Unretained(this)));
+  Recolor();
+}
+
+void SidebarNavButton::RemovedFromWidget() {
+  paint_as_active_subscription_ = {};
+  views::LabelButton::RemovedFromWidget();
+}
+
+void SidebarNavButton::OnThemeChanged() {
+  TopContainerButton::OnThemeChanged();
+  Recolor();
+}
+
+void SidebarNavButton::Recolor() {
+  if (!icon_) {
+    return;
+  }
+  // TopContainerButton draws it in the sidebar's text colour for the
+  // window's activation, as it draws the sidebar's toggle, in every state.
+  UpdateIcon(ui::ImageModel::FromVectorIcon(*icon_));
+  // A button with nothing to do -- Back on a tab with no history -- is
+  // faded, as the address row's is.
+  const ui::ColorProvider* const provider = GetColorProvider();
+  if (!provider) {
+    return;
+  }
+  const SkColor text = provider->GetColor(
+      GetWidget() && !GetWidget()->ShouldPaintAsActive()
+          ? kColorTabForegroundInactiveFrameInactive
+          : kColorTabForegroundInactiveFrameActive);
+  SetImageModel(
+      views::Button::STATE_DISABLED,
+      ui::ImageModel::FromVectorIcon(
+          *icon_, SkColorSetA(text, kDisabledIconAlpha),
+          GetLayoutConstant(LayoutConstant::kVerticalTabStripButtonIconSize)));
+}
+
+BEGIN_METADATA(SidebarNavButton)
+END_METADATA
+
+SidebarNavButtons::SidebarNavButtons(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(),
+      kNavButtonGap));
+  back_ = AddChildView(std::make_unique<SidebarNavButton>(browser, IDC_BACK));
+  back_->SetCommand(IDC_BACK, BackIcon(),
+                    l10n_util::GetStringUTF16(IDS_TOOLTIP_BACK),
+                    l10n_util::GetStringUTF16(IDS_ACCNAME_BACK));
+  forward_ =
+      AddChildView(std::make_unique<SidebarNavButton>(browser, IDC_FORWARD));
+  forward_->SetCommand(IDC_FORWARD, ForwardIcon(),
+                       l10n_util::GetStringUTF16(IDS_TOOLTIP_FORWARD),
+                       l10n_util::GetStringUTF16(IDS_ACCNAME_FORWARD));
+  reload_ =
+      AddChildView(std::make_unique<SidebarNavButton>(browser, IDC_RELOAD));
+  UpdateReloadStopState(/*is_loading=*/false);
+  for (const int command : {IDC_BACK, IDC_FORWARD, IDC_RELOAD}) {
+    chrome::AddCommandObserver(browser_, command, this);
+    EnabledStateChangedForCommand(command,
+                                  chrome::IsCommandEnabled(browser_, command));
+  }
+}
+
+SidebarNavButtons::~SidebarNavButtons() {
+  for (const int command : {IDC_BACK, IDC_FORWARD, IDC_RELOAD}) {
+    chrome::RemoveCommandObserver(browser_, command, this);
+  }
+}
+
+void SidebarNavButtons::UpdateReloadStopState(bool is_loading) {
+  if (is_loading) {
+    reload_->SetCommand(IDC_STOP, StopIcon(),
+                        l10n_util::GetStringUTF16(IDS_TOOLTIP_STOP),
+                        l10n_util::GetStringUTF16(IDS_TOOLTIP_STOP));
+    // Stop is there to press whatever Reload's command says.
+    reload_->SetEnabled(true);
+  } else {
+    reload_->SetCommand(IDC_RELOAD, ReloadIcon(),
+                        l10n_util::GetStringUTF16(IDS_TOOLTIP_RELOAD),
+                        l10n_util::GetStringUTF16(IDS_ACCNAME_RELOAD));
+    reload_->SetEnabled(chrome::IsCommandEnabled(browser_, IDC_RELOAD));
+  }
+}
+
+void SidebarNavButtons::EnabledStateChangedForCommand(int id, bool enabled) {
+  if (id == IDC_BACK) {
+    back_->SetEnabled(enabled);
+  } else if (id == IDC_FORWARD) {
+    forward_->SetEnabled(enabled);
+  } else if (id == IDC_RELOAD && reload_->command() == IDC_RELOAD) {
+    reload_->SetEnabled(enabled);
+  }
+}
+
+BEGIN_METADATA(SidebarNavButtons)
+END_METADATA
+
+SidebarAddressField::SidebarAddressField(BrowserWindowInterface* browser)
+    : browser_(browser) {
+  SetCallback(base::BindRepeating(
+      [](BrowserWindowInterface* browser) {
+        // Cmd-L's bar, with the page's address in it to edit (commandbar
+        // K12), as the shortcut opens it.
+        chrome::ExecuteCommand(browser, IDC_FOCUS_LOCATION);
+      },
+      browser));
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, kFieldTextInset)));
+  label_ = AddChildView(std::make_unique<views::Label>());
+  label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label_->SetElideBehavior(gfx::ELIDE_TAIL);
+  label_->SetAutoColorReadabilityEnabled(false);
+  // A press on the words is a press on the field.
+  label_->SetCanProcessEventsWithinSubtree(false);
+  SetPreferredSize(gfx::Size(0, kHeight));
+  SetPage(GURL());
+}
+
+SidebarAddressField::~SidebarAddressField() = default;
+
+void SidebarAddressField::SetPage(const GURL& url) {
+  url_ = url;
+  const std::u16string text = SidebarAddressText(url);
+  // The command bar's own placeholder, which a press opens.
+  const std::u16string placeholder = u"Search or Enter URL\u2026";
+  label_->SetText(text.empty() ? placeholder : text);
+  // The whole address on hover, and to a screen reader the address the
+  // field shows, or what pressing it does on an empty page.
+  SetTooltipText(text.empty() ? std::u16string()
+                              : url_formatter::FormatUrl(url));
+  GetViewAccessibility().SetName(text.empty() ? placeholder : text);
+  UpdateColors();
+}
+
+std::u16string_view SidebarAddressField::text_for_testing() const {
+  return SidebarAddressText(url_).empty() ? std::u16string_view()
+                                          : label_->GetText();
+}
+
+void SidebarAddressField::StateChanged(ButtonState old_state) {
+  views::Button::StateChanged(old_state);
+  UpdateColors();
+}
+
+void SidebarAddressField::OnThemeChanged() {
+  views::Button::OnThemeChanged();
+  UpdateColors();
+}
+
+void SidebarAddressField::AddedToWidget() {
+  views::Button::AddedToWidget();
+  paint_as_active_subscription_ =
+      GetWidget()->RegisterPaintAsActiveChangedCallback(base::BindRepeating(
+          &SidebarAddressField::UpdateColors, base::Unretained(this)));
+  UpdateColors();
+}
+
+void SidebarAddressField::RemovedFromWidget() {
+  paint_as_active_subscription_ = {};
+  views::Button::RemovedFromWidget();
+}
+
+void SidebarAddressField::UpdateColors() {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  if (!provider) {
+    return;
+  }
+  // The sidebar's own text colour, as its rows and toggle take it.
+  const SkColor text = provider->GetColor(
+      GetWidget() && !GetWidget()->ShouldPaintAsActive()
+          ? kColorTabForegroundInactiveFrameInactive
+          : kColorTabForegroundInactiveFrameActive);
+  const bool empty = SidebarAddressText(url_).empty();
+  label_->SetEnabledColor(empty ? SkColorSetA(text, kPlaceholderAlpha) : text);
+  const bool lit =
+      GetState() == STATE_HOVERED || GetState() == STATE_PRESSED;
+  SetBackground(views::CreateRoundedRectBackground(
+      SkColorSetA(text, lit ? kFieldHoveredAlpha : kFieldGroundAlpha),
+      kRadius));
+}
+
+BEGIN_METADATA(SidebarAddressField)
+END_METADATA
+
+}  // namespace stedding
