diff --git a/chrome/browser/ui/tabs/audit_b22_unittest.cc b/chrome/browser/ui/tabs/audit_b22_unittest.cc
new file mode 100644
index 0000000000000..3de037cc70872
--- /dev/null
+++ b/chrome/browser/ui/tabs/audit_b22_unittest.cc
@@ -0,0 +1,156 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A folder made again for a tab brought back stays where its path puts it,
+// and the close-by-command rows leave a Space's pins, against a real Browser
+// and TabStripModel.
+
+#include <algorithm>
+#include <map>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/strings/stringprintf.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/tabs/stedding_folder_session.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "chrome/test/base/testing_profile.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class FolderSessionB22Test : public BrowserWithTestWindowTest {};
+
+class SpacePinCloseB22Test : public BrowserWithTestWindowTest {};
+
+// One folder of a saved path, in the session's encoding.
+std::string SavedFolderB22(const tabs::FolderId& id, std::string_view title) {
+  return base::StringPrintf(R"({"i":"%s","t":"%s","c":false})",
+                            id.ToString().c_str(), std::string(title).c_str());
+}
+
+// Parks `path` on `tab` through the call session restore makes for every tab
+// it brings back.
+void ParkFolderPathB22(tabs::TabInterface* tab, const std::string& path) {
+  const std::map<std::string, std::string> extra_data = {
+      {kSessionTabFolderPathKey, path}};
+  spaces::RestoreSpaceFromExtraData(tab->GetContents(), extra_data);
+}
+
+const tabs::FolderTabCollection* AsFolderB22(const tabs::TabCollection* node) {
+  return node && node->type() == tabs::TabCollection::Type::FOLDER
+             ? static_cast<const tabs::FolderTabCollection*>(node)
+             : nullptr;
+}
+
+// P29-1b; folders F28. A tab brought back whose folder is gone gets that
+// folder made again at the top level, where its path puts it, also when the
+// index it comes back at now falls between the rows of another folder, which
+// a tab inserted there lands in. The folder was made inside that other folder,
+// one the tab was never in.
+TEST_F(FolderSessionB22Test, AFolderMadeAgainAtTheTopStaysOutOfOtherFolders) {
+  for (int i = 0; i < 3; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+  }
+  TabStripModel* const strip = browser()->tab_strip_model();
+  ASSERT_EQ(3, strip->count());
+  // A loose row, then a folder of two rows.
+  tabs::TabInterface* const loose = strip->GetTabAtIndex(0);
+  tabs::TabInterface* const first = strip->GetTabAtIndex(1);
+  tabs::TabInterface* const second = strip->GetTabAtIndex(2);
+  tabs::FolderTabCollection* const other = strip->AddToNewFolder({1, 2});
+  ASSERT_NE(nullptr, other);
+  ASSERT_EQ(other, first->GetParentCollection());
+  ASSERT_EQ(other, second->GetParentCollection());
+  ASSERT_EQ(nullptr, AsFolderB22(loose->GetParentCollection()));
+
+  // The tab comes back at the index its close saved: between the folder's
+  // rows, so inside the folder.
+  strip->InsertWebContentsAt(
+      2,
+      content::WebContents::Create(
+          content::WebContents::CreateParams(profile())),
+      AddTabTypes::ADD_NONE);
+  ASSERT_EQ(4, strip->count());
+  tabs::TabInterface* const back = strip->GetTabAtIndex(2);
+  ASSERT_NE(first, back);
+  ASSERT_NE(second, back);
+  ASSERT_EQ(other, back->GetParentCollection())
+      << "a tab inserted between a folder's rows is no longer in the folder";
+  const tabs::FolderId gone = tabs::FolderId::GenerateNew();
+  ParkFolderPathB22(back, "[" + SavedFolderB22(gone, "Gone") + "]");
+
+  FolderSessionService service(*browser());
+  service.OnSessionRestored(profile(), 1);
+
+  const tabs::FolderTabCollection* const made =
+      AsFolderB22(back->GetParentCollection());
+  ASSERT_NE(nullptr, made) << "the tab's folder was not made again";
+  EXPECT_EQ(gone, made->id());
+  EXPECT_EQ("Gone", made->title());
+  EXPECT_EQ(nullptr, AsFolderB22(made->GetParentCollection()))
+      << "the folder was made inside another folder";
+  EXPECT_EQ(other, first->GetParentCollection());
+  EXPECT_EQ(other, second->GetParentCollection());
+  EXPECT_EQ(2u, other->TabCountRecursive());
+  EXPECT_EQ(nullptr, AsFolderB22(loose->GetParentCollection()));
+  EXPECT_EQ(4, strip->count());
+}
+
+// P30-1a; pins H3, menus M5, spaces B20. Close Other Tabs and Close Tabs
+// Below take the plain tabs and leave the Space's pins, as they leave the
+// essentials and as Clear leaves the pins. Both had taken the pins of the
+// open run.
+TEST_F(SpacePinCloseB22Test, CloseOthersAndCloseBelowLeaveTheSpacesPins) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model) << "a normal window must own a SpaceModel";
+  TabStripModel* const strip = browser()->tab_strip_model();
+  std::vector<tabs::TabInterface*> opened;
+  for (int i = 0; i < 4; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+    opened.push_back(strip->GetActiveTab());
+  }
+  ASSERT_EQ(4, strip->count());
+  tabs::TabInterface* const first_pin = opened[0];
+  tabs::TabInterface* const second_pin = opened[1];
+  tabs::TabInterface* const doomed = opened[2];
+  tabs::TabInterface* const kept = opened[3];
+  model->SetSpacePinned(first_pin, true);
+  model->SetSpacePinned(second_pin, true);
+  ASSERT_TRUE(model->IsSpacePinned(first_pin));
+  ASSERT_TRUE(model->IsSpacePinned(second_pin));
+  model->SetPinsCollapsed(model->active_id(), false);
+  ASSERT_FALSE(strip->IsTabHidden(strip->GetIndexOfTab(first_pin)));
+  ASSERT_FALSE(strip->IsTabHidden(strip->GetIndexOfTab(second_pin)));
+  ASSERT_LT(strip->GetIndexOfTab(first_pin),
+            strip->GetIndexOfTab(second_pin));
+  strip->ActivateTabAt(strip->GetIndexOfTab(kept));
+
+  EXPECT_EQ(std::vector<int>{strip->GetIndexOfTab(doomed)},
+            strip->GetIndicesClosedByCommandForTesting(
+                strip->GetIndexOfTab(kept),
+                TabStripModel::CommandCloseOtherTabs));
+
+  std::vector<int> plain = {strip->GetIndexOfTab(doomed),
+                            strip->GetIndexOfTab(kept)};
+  std::ranges::sort(plain);
+  EXPECT_EQ(plain, strip->GetIndicesClosedByCommandForTesting(
+                       strip->GetIndexOfTab(first_pin),
+                       TabStripModel::CommandCloseTabsToRight));
+}
+
+}  // namespace
+}  // namespace stedding
