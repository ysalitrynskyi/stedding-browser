+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return Kept() == std::vector<std::string>{"shop.example"};
+  }));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return Chips(page) == "shop.example";
+  })) << Chips(page);
+
+  for (const char* typed : {"chrome://settings", "/news", "  "}) {
+    SCOPED_TRACE(typed);
+    Type(page, typed);
+    if (std::string_view(typed).find_first_not_of(' ') ==
+        std::string_view::npos) {
+      continue;  // An empty field is no entry at all, and says nothing.
+    }
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(page, OnThePage(R"(
+        const field = pick('cr-input#cleanLinksAdd');
+        return field.invalid && field.errorMessage.length > 0;)"))
+          .ExtractBool();
+    })) << "the field says the entry is no site";
+    EXPECT_EQ(std::vector<std::string>{"shop.example"}, Kept());
+  }
+
+  EXPECT_EQ("", content::EvalJs(page, OnThePage(R"(
+      pick('#cleanLinksKeptSites cr-icon-button[data-site="shop.example"]')
+          .click();
+      return '';)")));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return Kept().empty(); }));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return Chips(page).empty(); }));
+}
+
+}  // namespace
