+void SpaceModel::CollapseFolderLeavingNothingOut(
+    tabs::FolderTabCollection* folder) {
+  if (!folder || !tab_strip_model_) {
+    return;
+  }
+  const std::vector<tabs::TabInterface*> tabs = folder->GetTabsRecursive();
+  // A folder already collapsed may have left some listed.
+  for (const tabs::TabInterface* const tab : tabs) {
+    left_under_collapsed_folder_.erase(tab->GetHandle());
+  }
+  {
+    const base::AutoReset<bool> nothing_out(&collapse_leaves_nothing_out_,
+                                            true);
+    folder->SetCollapsed(true);
+  }
+  // A row folded away stays out of the selection, or the next Cmd-W takes it.
+  for (const tabs::TabInterface* const tab : tabs) {
+    const int index = tab_strip_model_->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab &&
+        index != tab_strip_model_->active_index() &&
+        tab_strip_model_->IsTabSelected(index)) {
+      tab_strip_model_->DeselectTabAt(index);
+    }
+  }
+}
