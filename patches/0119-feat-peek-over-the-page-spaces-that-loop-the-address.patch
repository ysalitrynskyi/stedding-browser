+// P20 (GitHub issue 62): a peek over the page, as Arc's is -- inside the
+// pinned tab's window, over that tab's page, which waits under it until the
+// peek closes, and going and coming with the tab. The views layer shows it;
+// until it says how, and while "Show a peek" is "In a small window", a peek
+// is a little window (P6).
+class PeekOverPageHost {
+ public:
+  virtual ~PeekOverPageHost() = default;
+  // Shows `page`, a peek's page from `source`, over `source`'s page. False
+  // when it cannot -- the tab has no window, or another dialog is over its
+  // page -- and `page` is then gone.
+  virtual bool Show(tabs::TabInterface* source,
+                    std::unique_ptr<content::WebContents> page) = 0;
+  // The page of the peek over `source`'s page, or null.
+  virtual content::WebContents* PageOver(const tabs::TabInterface* source) = 0;
+  // Closes the peek over `source`'s page. Its page may ask "Leave site?"
+  // first, and stays if the user stays.
+  virtual void Close(tabs::TabInterface* source) = 0;
+  // P7, P9: sends the page of the peek over `source` into a tab, or a split
+  // beside `source`.
+  virtual bool Promote(tabs::TabInterface* source, bool split) = 0;
+};
+void SetPeekOverPageHost(PeekOverPageHost* host);
+
+// P20: whether a peek from `source` shows over its page: a host is set and
+// the profile's "Show a peek" is "Over the page" (the default).
+bool PeeksShowOverThePage(tabs::TabInterface* source);
+
+// P20: the page of the peek over the active tab of `window`, or null.
+content::WebContents* PeekOverPageOfActiveTab(BrowserWindowInterface* window);
+
+// P20: the pinned tab `page` is the page of the peek over; null when `page`
+// is not the page of a peek over the page.
+tabs::TabInterface* PeekOverPageSourceOf(content::WebContents* page);
+
+// P20: the peek over `window`'s active tab takes the command a key or a menu
+// gave the window. True when there was one and it took it.
+enum class PeekCommand { kOpenAsTab, kOpenInSplit, kClose };
+bool RunPeekOverPageCommand(BrowserWindowInterface* window,
+                            PeekCommand command);
+
+// P9, P20: whether a peek's page from `source` can go into a split beside
+// it; an essential cannot take a pair, nor a tab already in one.
+bool PeekSourceCanSplit(const tabs::TabInterface* source);
+
 }  // namespace stedding
 
 #endif  // CHROME_BROWSER_UI_STEDDING_PEEK_H_
