+    tabs::TabInterface* const left = AppendAwakeTab("left.example");
+    tabs::TabInterface* const right = AppendAwakeTab("right.example");
+    tabs::TabInterface* const recent = AppendAwakeTab("recent.example");
+    tabs().SetTabPinned(Index(essential), true);
