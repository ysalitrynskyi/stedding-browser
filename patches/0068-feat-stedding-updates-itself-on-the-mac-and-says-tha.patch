+    return *version;
+  }
   return BUILDFLAG(STEDDING_VERSION);
 }
 
+std::optional<SteddingVersionNumber> ParseSteddingVersion(
+    std::string_view version) {
+  std::string_view core = version;
+  std::optional<int> beta;
+  if (const size_t dash = version.find('-'); dash != std::string_view::npos) {
+    core = version.substr(0, dash);
+    constexpr std::string_view kBeta = "beta.";
+    const std::string_view rest = version.substr(dash + 1);
+    if (!rest.starts_with(kBeta)) {
+      return std::nullopt;
+    }
+    beta = ParsePart(rest.substr(kBeta.size()));
+    if (!beta || *beta == 0) {
+      return std::nullopt;
+    }
+  }
+  const std::vector<std::string_view> parts = base::SplitStringPiece(
+      core, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 3) {
+    return std::nullopt;
+  }
+  SteddingVersionNumber number;
+  const std::optional<int> major = ParsePart(parts[0]);
+  const std::optional<int> minor = ParsePart(parts[1]);
+  const std::optional<int> patch = ParsePart(parts[2]);
+  if (!major || !minor || !patch) {
+    return std::nullopt;
+  }
+  number.major = *major;
+  number.minor = *minor;
+  number.patch = *patch;
+  number.beta = beta.value_or(0);
+  return number;
+}
+
+bool IsLaterSteddingVersion(std::string_view version, std::string_view than) {
+  const std::optional<SteddingVersionNumber> a = ParseSteddingVersion(version);
+  const std::optional<SteddingVersionNumber> b = ParseSteddingVersion(than);
+  return a && b && OrderOf(*a) > OrderOf(*b);
+}
+
+void SetSteddingVersionForTesting(std::optional<std::string> version) {
+  VersionForTesting() = std::move(version);
+}
+
 }  // namespace stedding
diff --git a/chrome/browser/ui/stedding/stedding_version.h b/chrome/browser/ui/stedding/stedding_version.h
