+PinnedTabContainerView::GridMeasures
+PinnedTabContainerView::MeasureVerticalGrid(
+    const views::SizeBounds& size_bounds,
+    int shown) const {
+  GridMeasures measures;
+  int children_on_row = shown;
+
+  // Child width will be uniform and match the largest child's width.
+  bool contains_split = false;
+  if (collection_node_) {
+    for (const auto& i : collection_node_->children()) {
+      if (i->type() == TabCollectionNode::Type::SPLIT) {
+        contains_split = true;
+      }
+    }
+  }
+  int child_width = GetLayoutConstant(LayoutConstant::kVerticalTabMinWidth) *
+                    (contains_split ? 2 : 1);
+
+  // If the width is bounded, calculate how many children can fit on a row.
+  // Since all children are allocated the same width this will be the same for
+  // every row.
+  if (size_bounds.width().is_bounded() && size_bounds.width().value() > 0) {
+    auto collapse_state = GetTabStripCollapseState();
+
+    // Apply horizontal padding immediately at start of collapse animation by
+    // including collapsing state.
+    // Stedding (sidebar Y8): the rail's padding, by the width being laid
+    // out (HANDOFF trap 33). The strip hands this container its width less
+    // the leading padding, so the rail is that plus the padding at most.
+    const bool arc_style =
+        base::FeatureList::IsEnabled(stedding::kArcStyleWindow);
+    const bool rail =
+        arc_style && size_bounds.width().value() + stedding::kRailRowPadding <=
+                         VerticalTabStripRegionView::kCollapsedWidth;
+    int horizontal_padding =
+        GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+    if (rail) {
+      horizontal_padding = stedding::kRailRowPadding;
+    }
+    int available_width = size_bounds.width().value() - horizontal_padding;
+
+    // When we are in collapsed state, only one child should be shown per row.
+    // During collapse animation and other cases, fit as many as possible.
+    // Stedding: one to a row in the rail's width, whatever the state, so the
+    // rail expanded on hover, collapsed by state at the open width, is not a
+    // column of wide cards (PLAN.md TAB-23, TAB-L5).
+    const bool one_per_row =
+        arc_style
+            ? rail
+            : collapse_state == tabs::VerticalTabStripCollapseState::kCollapsed;
+    children_on_row =
+        one_per_row
+            ? 1
+            : std::min(children_on_row,
+                       static_cast<int>(
+                           std::floor((available_width - child_width) /
+                                      (child_width + kTabPadding)) +
+                           1));
+
+    // Stedding: the essentials row is a grid of cards, two to a row wherever
+    // the strip is wider than the rail -- the open sidebar and the rail
+    // expanded on hover alike, keyed on the width as the unpinned container
+    // is -- and fewer while the width has room for fewer (a collapse or an
+    // expand on its way). Fewer cards share the row, so a lone essential
+    // spans it rather than sitting half-width beside nothing. It was keyed
+    // on the expanded state, and the hover-expanded rail drew its essentials
+    // as one wide row each (PLAN.md TAB-23, TAB-L5).
+    //
+    // sidebar Y33 (BACKLOG S-276, GitHub issue 15): as in Arc, more cards
+    // share a row before the grid takes more rows. Up to four sit on one row;
+    // past four the grid takes two rows, the first the fuller, each card the
+    // narrower; and only once a card would be narrower than the rail's square
+    // (sidebar Y8) does the grid take a third row. It was two to a row
+    // whatever their number, so ten essentials were five rows of wide cards.
+    if (arc_style && !rail) {
+      const int min_card = stedding::RailRowSide();
+      const int fit = std::max(
+          1, (available_width + kTabPadding) / (min_card + kTabPadding));
+      const int wanted = shown <= 4 ? shown : (shown + 1) / 2;
+      const int cards_per_row = std::clamp(wanted, 1, fit);
+      child_width =
+          (available_width - kTabPadding * (cards_per_row - 1)) / cards_per_row;
+      children_on_row = cards_per_row;
+    } else if (children_on_row > 0) {
+      // Allocate extra space to the tabs.
+      available_width -= (children_on_row * child_width) +
+                         (kTabPadding * (children_on_row - 1));
+      child_width += std::floor(available_width / children_on_row);
+    }
+  }
+
+  // sidebar Y8, Y12: in the rail a card is as wide as the rows' square,
+  // centred on the column, and the cards' gap follows the density.
+  const bool rail_cards =
+      base::FeatureList::IsEnabled(stedding::kArcStyleWindow) &&
+      size_bounds.width().is_bounded() &&
+      size_bounds.width().value() + stedding::kRailRowPadding <=
+          VerticalTabStripRegionView::kCollapsedWidth;
+  measures.inset = rail_cards ? stedding::RailRowInset() : 0;
+  measures.row_gap = rail_cards ? stedding::RailCardGap() : kTabPadding;
+  if (rail_cards) {
+    child_width = std::max(child_width - 2 * measures.inset, 0);
+  }
+  measures.cards_per_row = std::max(children_on_row, 1);
+  measures.card_width = child_width;
+  return measures;
+}
+
+std::vector<views::View*> PinnedTabContainerView::CardsInPlaces() const {
+  std::vector<views::View*> cards;
+  if (!collection_node_) {
+    return cards;
+  }
+  for (views::View* const child : collection_node_->GetDirectChildren()) {
+    if (!layout_manager_->CanBeVisible(child) ||
+        child->GetProperty(kHiddenForEssentialsDrag)) {
+      continue;
+    }
+    if (const auto drag_data = GetVisualDataForDraggedView(*child);
+        drag_data && drag_data->should_hide) {
+      continue;
+    }
+    cards.push_back(child);
+  }
+  return cards;
+}
+
+gfx::Rect PinnedTabContainerView::VerticalPlaceBounds(int index,
+                                                      int places) const {
+  const GridMeasures measures =
+      MeasureVerticalGrid(views::SizeBounds(width(), {}), places);
+  const int height =
+      GetLayoutConstant(LayoutConstant::kVerticalTabPinnedHeight);
+  const int column = index % measures.cards_per_row;
+  const int row = index / measures.cards_per_row;
+  return gfx::Rect(
+      measures.inset + column * (measures.card_width + kTabPadding),
+      row * (height + measures.row_gap), measures.card_width, height);
+}
+
+void PinnedTabContainerView::SetEssentialsDropRoom(std::optional<int> index,
+                                                   int count) {
+  if (!index) {
+    count = 0;
+  }
+  if (drop_room_index_ == index && drop_room_count_ == count) {
+    return;
+  }
+  drop_room_index_ = index;
+  drop_room_count_ = count;
+  InvalidateLayout();
+}
+
+int PinnedTabContainerView::EssentialsDropIndexAt(
+    const gfx::Point& screen_point,
+    int count) const {
+  const int cards = static_cast<int>(CardsInPlaces().size());
+  const int places = cards + count;
+  gfx::Point point = screen_point;
+  views::View::ConvertPointFromScreen(this, &point);
+  int nearest = 0;
+  int64_t nearest_distance = std::numeric_limits<int64_t>::max();
+  for (int i = 0; i < places; ++i) {
+    const gfx::Point centre = VerticalPlaceBounds(i, places).CenterPoint();
+    const int64_t dx = point.x() - centre.x();
+    const int64_t dy = point.y() - centre.y();
+    if (dx * dx + dy * dy < nearest_distance) {
+      nearest_distance = dx * dx + dy * dy;
+      nearest = i;
+    }
+  }
+  // Over the room already made, the room stays; past it, the places after
+  // it are the cards' that moved on.
+  int index = nearest;
+  if (drop_room_index_ && drop_room_count_ == count) {
+    const int room = *drop_room_index_;
+    if (nearest >= room && nearest < room + count) {
+      index = room;
+    } else if (nearest >= room + count) {
+      index = nearest - count + 1;
+    }
+  }
+  return std::clamp(index, 0, cards);
+}
+
+gfx::Rect PinnedTabContainerView::EssentialsPlaceBoundsInScreen(
+    int index,
+    int count) const {
+  gfx::Rect bounds = VerticalPlaceBounds(
+      index, static_cast<int>(CardsInPlaces().size()) + count);
+  views::View::ConvertRectToScreen(this, &bounds);
+  return bounds;
+}
+
+const tabs::TabInterface* PinnedTabContainerView::ShownEssentialAt(
+    int index) const {
+  const std::vector<views::View*> cards = CardsInPlaces();
+  if (index < 0 || index >= static_cast<int>(cards.size())) {
+    return nullptr;
+  }
+  if (const auto* const tab = views::AsViewClass<TabView>(cards[index])) {
+    return tab->GetTabInterface();
+  }
+  if (const auto* const split = views::AsViewClass<SplitTabView>(cards[index]);
+      split && split->collection_node()) {
+    const tabs::ConstChildPtr data = split->collection_node()->GetNodeData();
+    if (const auto* const collection =
+            std::get_if<tabs::ConstDanglingUntriagedTabCollection>(&data)) {
+      return (*collection)->GetTabAtIndexRecursive(0);
+    }
+  }
+  return nullptr;
+}
