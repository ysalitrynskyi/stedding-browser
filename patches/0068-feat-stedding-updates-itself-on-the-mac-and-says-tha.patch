+def _get_sparkle_parts(paths, config):
+    """Stedding (ADR 0022): Sparkle.framework, when the build bundles it.
+
+    Its helpers come signed ad hoc; each is nested code of the app, signed
+    inside out before the framework, and the framework before the app.
+
+    Returns:
+        A list of |model.CodeSignedProduct|, in signing order; empty when the
+        app has no Sparkle.framework.
+    """
+    framework = '{.app_product}.app/Contents/Frameworks/Sparkle.framework'.format(
+        config)
+    if not os.path.isdir(os.path.join(paths.work, framework)):
+        return []
+    verify_options = VerifyOptions.DEEP | VerifyOptions.STRICT
+    return [
+        CodeSignedProduct(
+            framework + '/Versions/B/Autoupdate',
+            'org.sparkle-project.Sparkle.Autoupdate',
+            options=CodeSignOptions.FULL_HARDENED_RUNTIME_OPTIONS,
+            sign_with_identifier=True,
+            verify_options=verify_options,
+        ),
+        CodeSignedProduct(
+            framework + '/Versions/B/Updater.app',
+            'org.sparkle-project.Sparkle.Updater',
+            options=CodeSignOptions.FULL_HARDENED_RUNTIME_OPTIONS,
+            verify_options=verify_options,
+        ),
+        CodeSignedProduct(
+            framework,
+            'org.sparkle-project.Sparkle',
+            verify_options=verify_options,
+        ),
+    ]
+
