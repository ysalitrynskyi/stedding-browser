+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A fresh profile searches with DuckDuckGo in every region until the user
+// chooses (PLAN.md WEB-4, docs/PRIVACY.md): where the regional list names it
+// (KR), where it does not (CN), and in a country no list knows (ZZ). A query
+// typed in the address bar goes to the default provider.
+
+#include <string>
+
+#include "base/command_line.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/search_test_utils.h"
+#include "components/regional_capabilities/regional_capabilities_switches.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_service.h"
+#include "content/public/test/browser_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace {
+
+class SearchDefaultTest : public InProcessBrowserTest,
+                          public testing::WithParamInterface<std::string> {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(switches::kSearchEngineChoiceCountry,
+                                    GetParam());
+  }
+};
+
+IN_PROC_BROWSER_TEST_P(SearchDefaultTest, AQueryGoesToDuckDuckGo) {
+  TemplateURLService* const service =
+      TemplateURLServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  search_test_utils::WaitForTemplateURLServiceToLoad(service);
+  const TemplateURL* const provider = service->GetDefaultSearchProvider();
+  ASSERT_TRUE(provider);
+  const GURL query = provider->GenerateSearchURL(service->search_terms_data());
+  EXPECT_EQ("duckduckgo.com", query.host()) << query;
+}
+
+INSTANTIATE_TEST_SUITE_P(,
+                         SearchDefaultTest,
+                         testing::Values("KR", "CN", "ZZ"));
+
+}  // namespace
diff --git a/chrome/test/stedding/settings_spaces_browsertest.cc b/chrome/test/stedding/settings_spaces_browsertest.cc
new file mode 100644
index 0000000000000..8ddebbe6ec633
--- /dev/null
+++ b/chrome/test/stedding/settings_spaces_browsertest.cc
@@ -0,0 +1,233 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// chrome://settings/stedding lists the Spaces of the window it is in, and
+// keeps doing so when its tab moves to another window and the first window
+// closes (PLAN.md SPC-1, WEB-2). The handler once observed the first
+// window's model and was left pointing at it.
+
+#include <memory>
+#include <string>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/test_navigation_observer.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+#include "ui/shell_dialogs/select_file_dialog_factory.h"
+#include "ui/shell_dialogs/select_file_policy.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The page's own request for the list, as its Spaces section makes it.
+constexpr char kSpaceNames[] = R"(
+  import('chrome://resources/js/cr.js')
+      .then(cr => cr.sendWithPromise('steddingGetSpaces'))
+      .then(spaces => spaces.map(space => space.name).join(','))
+)";
+
+// Every preference a control on the page shown is bound to, read from the
+// rendered page itself, through every shadow root.
+constexpr char kPrefKeysOnThePage[] = R"(
+  (() => {
+    const keys = new Set();
+    const walk = root => {
+      for (const element of root.querySelectorAll('*')) {
+        const key = element.getAttribute('pref-key');
+        if (key) {
+          keys.add(key);
+        }
+        if (element.shadowRoot) {
+          walk(element.shadowRoot);
+        }
+      }
+    };
+    walk(document);
+    return [...keys].sort().join(',');
+  })()
+)";
+
+// The keys the settings page cannot read, as its own controls ask for them.
+constexpr char kUnknownPrefs[] = R"(
+  Promise.all($1.split(',').map(key =>
+      chrome.settingsPrivate.getPref(key).then(pref => pref ? '' : key,
+                                               () => key)))
+      .then(missing => missing.filter(key => key).join(','))
+)";
+
+class SettingsSpacesTest : public InProcessBrowserTest {};
+
+// A file picker that never shows, and says whether it still has someone to
+// answer, as a real one asks when the person cancels.
+class RecordingDialog : public ui::SelectFileDialog {
+ public:
+  RecordingDialog(Listener* listener,
+                  std::unique_ptr<ui::SelectFilePolicy> policy)
+      : ui::SelectFileDialog(listener, std::move(policy)) {}
+
+  bool has_listener() const { return listener_ != nullptr; }
+  bool opened() const { return opened_; }
+
+  // What the picker does when the person cancels.
+  void Cancel() {
+    if (listener_) {
+      listener_->FileSelectionCanceled();
+    }
+  }
+
+  // ui::SelectFileDialog:
+  bool IsRunning(gfx::NativeWindow owning_window) const override {
+    return opened_;
+  }
+  void ListenerDestroyed() override { listener_ = nullptr; }
+
+ protected:
+  ~RecordingDialog() override = default;
+
+  void SelectFileImpl(Type type,
+                      const std::u16string& title,
+                      const base::FilePath& default_path,
+                      const FileTypeInfo* file_types,
+                      int file_type_index,
+                      const base::FilePath::StringType& default_extension,
+                      gfx::NativeWindow owning_window,
+                      const GURL* caller) override {
+    opened_ = true;
+  }
+  bool HasMultipleFileTypeChoicesImpl() override { return false; }
+
+ private:
+  bool opened_ = false;
+};
+
+class RecordingDialogFactory : public ui::SelectFileDialogFactory {
+ public:
+  ui::SelectFileDialog* Create(
+      ui::SelectFileDialog::Listener* listener,
+      std::unique_ptr<ui::SelectFilePolicy> policy) override {
+    dialog_ =
+        base::MakeRefCounted<RecordingDialog>(listener, std::move(policy));
+    return dialog_.get();
+  }
+  // Kept alive here, as the operating system keeps a real picker open.
+  RecordingDialog* dialog() { return dialog_.get(); }
+
+ private:
+  scoped_refptr<RecordingDialog> dialog_;
+};
+
+// PLAN.md WEB-2: the settings tab closed while its "Import sidebar..." picker
+// is open lets go of the picker, so the picker's cancel, after, has no one to
+// call and nothing crashes.
+IN_PROC_BROWSER_TEST_F(SettingsSpacesTest, ClosingTheTabWithThePickerOpen) {
+  auto owned_factory = std::make_unique<RecordingDialogFactory>();
+  RecordingDialogFactory* const factory = owned_factory.get();
+  ui::SelectFileDialog::SetFactory(std::move(owned_factory));
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  content::WebContents* const page = strip->GetActiveWebContents();
+  // The page's own message, as its "Import sidebar..." row sends it.
+  ASSERT_TRUE(
+      content::ExecJs(page, "chrome.send('steddingImportSidebarFile', []);"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return factory->dialog() && factory->dialog()->opened(); }));
+  const scoped_refptr<RecordingDialog> dialog = factory->dialog();
+  EXPECT_TRUE(dialog->has_listener());
+
+  content::WebContentsDestroyedWatcher gone(page);
+  strip->CloseWebContentsAt(strip->GetIndexOfWebContents(page),
+                            TabCloseTypes::CLOSE_USER_GESTURE);
+  gone.Wait();
+  EXPECT_FALSE(dialog->has_listener())
+      << "the closed page's handler is still the picker's listener";
+  dialog->Cancel();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, strip->count());
+}
+
+// Settings -> Stedding: every control is bound to a preference the settings
+// page knows. One that is not draws a dead switch and throws: Chromium named
+// the sidebar's hover pref vertical_tabs.expand_on_hover in M155, and the
+// page's "Expand the sidebar on hover" switch still asked for
+// vertical_tabs.expand_on_hover_enabled.
+IN_PROC_BROWSER_TEST_F(SettingsSpacesTest, EveryControlHasItsPreference) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://settings/stedding")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  std::string keys;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    keys = content::EvalJs(page, kPrefKeysOnThePage).ExtractString();
+    return keys.find("stedding.") != std::string::npos &&
+           keys.find("vertical_tabs.") != std::string::npos;
+  })) << keys;
+  EXPECT_EQ("", content::EvalJs(page, content::JsReplace(kUnknownPrefs, keys)))
+      << "controls bound to no preference, of " << keys;
+}
+
+IN_PROC_BROWSER_TEST_F(SettingsSpacesTest, TheListFollowsTheTabToAnotherWindow) {
+  BrowserWindowInterface* const first = browser();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(first);
+  ASSERT_TRUE(model);
+  model->AddSpace("Work", SK_ColorBLUE);
+
+  // The first window keeps a tab of its own, so it closes when told to and
+  // not when the settings tab leaves.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      first, GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const settings =
+      first->GetTabStripModel()->GetActiveWebContents();
+  const std::string names =
+      content::EvalJs(settings, kSpaceNames).ExtractString();
+  EXPECT_NE(std::string::npos, names.find("Work")) << names;
+
+  // The settings tab moves to a second window, and the first one closes.
+  BrowserWindowInterface* const second = CreateBrowser(first->GetProfile());
+  std::unique_ptr<tabs::TabModel> tab =
+      first->GetTabStripModel()->DetachTabAtForInsertion(
+          first->GetTabStripModel()->GetIndexOfWebContents(settings));
+  second->GetTabStripModel()->InsertDetachedTabAt(
+      0, std::move(tab), AddTabTypes::ADD_ACTIVE);
+  CloseBrowserSynchronously(first);
+
+  // The page still answers, from the window it is in now: the Spaces are
+  // the profile's, so the second window lists the same ones.
+  EXPECT_EQ(names, content::EvalJs(settings, kSpaceNames).ExtractString());
+  content::TestNavigationObserver reloaded(settings);
+  settings->GetController().Reload(content::ReloadType::NORMAL,
+                                   /*check_for_repost=*/false);
+  reloaded.Wait();
+  EXPECT_EQ(names, content::EvalJs(settings, kSpaceNames).ExtractString());
+
+  // Closing the page after all that is quiet.
+  second->GetTabStripModel()->CloseWebContentsAt(
+      second->GetTabStripModel()->GetIndexOfWebContents(settings),
+      TabCloseTypes::CLOSE_NONE);
+}
