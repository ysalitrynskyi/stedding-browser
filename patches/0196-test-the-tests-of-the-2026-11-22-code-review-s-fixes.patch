+// windows G2, G16 (ADR 0035): the profile's pins and essentials, a tab of
+// each in every window.
+class PinsEveryWindowB06Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  static spaces::SpaceModel& Model(BrowserWindowInterface* window) {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+    CHECK(model);
+    return *model;
+  }
+
+  spaces::PinStore* Store() {
+    return spaces::PinStoreFactory::GetForProfile(browser()->GetProfile());
+  }
+
+  // How many Space pins `window` has.
+  static size_t PinCount(BrowserWindowInterface* window) {
+    size_t pins = 0;
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      pins += Model(window).IsSpacePinned(strip->GetTabAtIndex(i));
+    }
+    return pins;
+  }
+};
+
+// P06-1b; archive A9, windows G16: closing a window while another stays
+// open lists the tabs that were that window's own, and not its tab of each of
+// the profile's pins, which every other window still has. Each pin was a row
+// "in a closed window", once more at each window closed.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowB06Test,
+                       AClosedWindowsTabsOfThePinsAreNotArchived) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("/title1.html"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const pin =
+      browser()->GetTabStripModel()->GetActiveTab();
+  Model(browser()).SetSpacePinned(pin, true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    const spaces::PinStore* const store = Store();
+    return store && store->ready() && store->records().size() == 1u;
+  })) << "the pin is not the profile's";
+
+  ui_test_utils::BrowserCreatedObserver opened;
+  chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+  BrowserWindowInterface* const second = opened.Wait();
+  ASSERT_TRUE(second);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return PinCount(second) == 1u; }))
+      << "the new window has no tab of the pin";
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      second, embedded_test_server()->GetURL("/title2.html"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+
+  chrome::CloseWindow(second);
+  ui_test_utils::WaitForBrowserToClose(second);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(1u, PinCount(browser())) << "the pin left the window still open";
+
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  size_t own_rows = 0;
+  size_t pin_rows = 0;
+  for (const stedding::ArchivedTab& row : stedding::ListArchivedTabs(
+           service->entries(), base::Time::Now(), base::Days(30))) {
+    const std::string path(row.url.path());
+    own_rows += path == "/title2.html";
+    pin_rows += path == "/title1.html";
+  }
+  EXPECT_EQ(1u, own_rows) << "the closed window's own tab is not a row";
+  EXPECT_EQ(0u, pin_rows)
+      << "a pin every window still has is a row of the archive";
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/audit_b07_browsertest.cc b/chrome/test/stedding/audit_b07_browsertest.cc
new file mode 100644
index 0000000000000..6fe7ef32cc663
--- /dev/null
+++ b/chrome/test/stedding/audit_b07_browsertest.cc
@@ -0,0 +1,224 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Two windows that opened without their page. A noopener popup that a page
+// in HTML full screen opens from a Space with a session of its own: the popup
+// is made again in the Space's jar, and content must load the page into it
+// (sessions S11). And, on the Mac, Chromium's import command with no window
+// open: the window made for the welcome flow's import step must have a tab
+// (import I45).
+
+#include <map>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/synchronization/lock.h"
+#include "base/test/run_until.h"
+#include "base/thread_annotations.h"
+#include "build/build_config.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/exclusive_access/exclusive_access_manager.h"
+#include "chrome/browser/ui/exclusive_access/fullscreen_controller.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/fullscreen_types.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/base_window.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/ui/browser_mac.h"
+#endif
+
+namespace {
+
+// A Work Space with a session of its own, and a loaded a.test page on a tab
+// of its own there. b.test has a cookie "jar=shared" in the profile's own jar
+// and "jar=work" in Work's; the server records the Cookie header of the first
+// request for each path (with its query).
+class SpaceJarFullscreenB07Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestMonitor(base::BindRepeating(
+        &SpaceJarFullscreenB07Test::OnRequest, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+
+    model_ = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model_);
+    work_ = model_->AddSpace("Work", SK_ColorBLUE)->id();
+    model_->SetSpaceIsolated(work_, true);
+    ASSERT_TRUE(model_->SpaceIsIsolated(work_));
+
+    // The profile's jar: set from the tab the window opened with, in Home.
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), Url("b.test", "/set-cookie?jar=shared")));
+    // Work's jar: set from a tab made in Work.
+    ASSERT_TRUE(model_->SetActiveSpace(work_));
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("a.test", "/title1.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    work_tab_ = browser()->GetTabStripModel()->GetActiveTab()->GetHandle();
+    ASSERT_EQ(work_, model_->FindSpaceForTab(work_tab_.Get()));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), Url("b.test", "/set-cookie?jar=work")));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                             Url("a.test", "/title1.html")));
+  }
+
+  void TearDownOnMainThread() override {
+    // The model belongs to the browser window, which closes before the
+    // fixture goes.
+    model_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  GURL Url(const std::string& host, const std::string& path) {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  // The server's thread.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    const std::string path = request.GetURL().PathForRequest();
+    const auto cookie = request.headers.find("Cookie");
+    base::AutoLock lock(lock_);
+    if (cookies_.contains(path)) {
+      return;
+    }
+    cookies_[path] = cookie == request.headers.end() ? "" : cookie->second;
+  }
+
+  // The Cookie header of the first request for `path` (with its query), once
+  // it arrived.
+  std::string FirstCookieFor(const std::string& path) {
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      base::AutoLock lock(lock_);
+      return cookies_.contains(path);
+    })) << "no request for " << path;
+    base::AutoLock lock(lock_);
+    return cookies_[path];
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  spaces::SpaceId work_ = spaces::SpaceId::GenerateNew();
+  tabs::TabHandle work_tab_;
+
+ private:
+  base::Lock lock_;
+  std::map<std::string, std::string> cookies_ GUARDED_BY(lock_);
+};
+
+// P08-1e, sessions S11: a page in HTML full screen in a Space with a session
+// of its own opens a popup without an opener. Content makes the popup in the
+// profile's jar; it is made again in the Space's jar, and content loads the
+// page into the new contents. Without them content loaded nothing, and the
+// popup stayed on an empty page.
+IN_PROC_BROWSER_TEST_F(SpaceJarFullscreenB07Test,
+                       APopupFromAFullScreenPageLoadsInItsSpacesJar) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  content::WebContents* const page = work_tab_.Get()->GetContents();
+  ASSERT_EQ(page, browser()->GetTabStripModel()->GetActiveWebContents());
+  ASSERT_TRUE(
+      content::ExecJs(page, "document.documentElement.requestFullscreen()"));
+  ui_test_utils::FullscreenWaiter(browser(), {.tab_fullscreen = true}).Wait();
+  FullscreenController* const fullscreen =
+      ExclusiveAccessManager::From(browser())->fullscreen_controller();
+  ASSERT_TRUE(fullscreen->GetFullscreenState(page).target_mode ==
+              content::FullscreenMode::kContent)
+      << "the page is not in its own full screen";
+
+  const GURL url = Url("b.test", "/title2.html?fs-popup");
+  ASSERT_TRUE(content::ExecJs(
+      page, content::JsReplace(
+                "window.open($1, '_blank', 'noopener,popup,width=300');",
+                url)));
+  BrowserWindowInterface* popup = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    for (BrowserWindowInterface* const window :
+         GetAllBrowserWindowInterfaces()) {
+      if (window != browser()) {
+        popup = window;
+      }
+    }
+    return popup != nullptr;
+  })) << "the popup never opened";
+  content::WebContents* const opened =
+      popup->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(opened);
+  EXPECT_TRUE(spaces::StoragePartitionConfigForWebContents(opened) ==
+              spaces::StoragePartitionConfigForWebContents(page))
+      << "the popup is not in the Space's jar";
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return opened->GetLastCommittedURL() == url; }))
+      << "the popup stayed on " << opened->GetLastCommittedURL();
+  EXPECT_EQ("jar=work", FirstCookieFor("/title2.html?fs-popup"));
+
+  chrome::CloseWindow(popup);
+  ui_test_utils::WaitForBrowserToClose(popup);
+}
+
+#if BUILDFLAG(IS_MAC)
+
+using ImportWindowB07Test = InProcessBrowserTest;
+
+// P08-1a, import I45: on the Mac, Chromium's import command with no window
+// open (the Stedding menu's Import Bookmarks and Settings...) makes a window
+// for the welcome flow's import step. The flow floats over the window and
+// adds no tab, where Chromium's Settings page was the window's tab: the
+// window showed with no tab at all, and stayed empty once the flow closed.
+IN_PROC_BROWSER_TEST_F(ImportWindowB07Test,
+                       AnImportWithNoWindowOpensAWindowWithATab) {
+  chrome::OpenImportSettingsDialogWindow(browser()->GetProfile());
+
+  BrowserWindowInterface* window = nullptr;
+  for (BrowserWindowInterface* const each : GetAllBrowserWindowInterfaces()) {
+    if (each != browser()) {
+      window = each;
+    }
+  }
+  ASSERT_TRUE(window) << "no window opened";
+  EXPECT_EQ(BrowserWindowInterface::TYPE_NORMAL, window->GetType());
+  EXPECT_GE(window->GetTabStripModel()->count(), 1)
+      << "the window opened with no tab";
+  EXPECT_TRUE(window->GetTabStripModel()->GetActiveWebContents())
+      << "the window has no tab in front";
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return window->GetWindow()->IsVisible(); }))
+      << "the window never showed";
+
+  content::WebContents* flow = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    for (content::WebContents* const contents : content::GetAllWebContents()) {
+      if (contents->GetVisibleURL().host() == "stedding-welcome") {
+        flow = contents;
+      }
+    }
+    return flow != nullptr;
+  })) << "no welcome flow";
+  EXPECT_EQ("import", flow->GetVisibleURL().ref());
+}
+
+#endif  // BUILDFLAG(IS_MAC)
+
+}  // namespace
diff --git a/chrome/test/stedding/audit_b08_browsertest.cc b/chrome/test/stedding/audit_b08_browsertest.cc
