+
+  // Shorter: what has passed counts.
+  model.SetActiveSpace(home);
+  env.FastForwardBy(base::Minutes(3));
+  model.SetSleepPolicy(base::Minutes(4), record);
+  env.FastForwardBy(base::Minutes(1) + base::Seconds(1));
+  EXPECT_EQ(2u, slept.size()) << "4 minutes after the leave";
