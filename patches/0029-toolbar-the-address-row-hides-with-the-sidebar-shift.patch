--- /dev/null
+++ b/chrome/browser/ui/stedding/address_row.cc
@@ -0,0 +1,93 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/address_row.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/address_row_rules.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+
+namespace stedding {
+
+DEFINE_USER_DATA(AddressRow);
+
+// static
+AddressRow* AddressRow::From(BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+AddressRow::AddressRow(BrowserWindowInterface& browser) : browser_(browser) {
+  scoped_user_data_.emplace(browser.GetUnownedUserDataHost(), *this);
+  if (TabStripModel* const tabs = browser.GetTabStripModel()) {
+    tabs->AddObserver(this);
+  }
+  pref_registrar_.Init(browser.GetProfile()->GetPrefs());
+  pref_registrar_.Add(
+      prefs::kToolbarHideWithSidebar,
+      base::BindRepeating(&AddressRow::Relayout, base::Unretained(this)));
+}
+
+AddressRow::~AddressRow() {
+  if (TabStripModel* const tabs = browser_->GetTabStripModel()) {
+    tabs->RemoveObserver(this);
+  }
+}
+
+bool AddressRow::SidebarCollapsed() const {
+  const tabs::VerticalTabStripStateController* const controller =
+      tabs::VerticalTabStripStateController::From(&*browser_);
+  return controller && controller->IsCollapsed();
+}
+
+bool AddressRow::IsVisible() {
+  AddressRowSignals signals;
+  signals.hide_with_sidebar = browser_->GetProfile()->GetPrefs()->GetBoolean(
+      prefs::kToolbarHideWithSidebar);
+  signals.sidebar_collapsed = SidebarCollapsed();
+  // The sidebar changed: shift-cmd-D's answer was for the old state (T10).
+  if (last_collapsed_.has_value() &&
+      *last_collapsed_ != signals.sidebar_collapsed) {
+    override_.reset();
+  }
+  last_collapsed_ = signals.sidebar_collapsed;
+  if (TabStripModel* const tabs = browser_->GetTabStripModel()) {
+    if (content::WebContents* const active = tabs->GetActiveWebContents()) {
+      signals.localhost = IsLocalhostPage(active->GetLastCommittedURL());
+    }
+  }
+  signals.override = override_;
+  return ShouldShowAddressRow(signals);
+}
+
+void AddressRow::Toggle() {
+  override_ = !IsVisible();
+  Relayout();
+}
+
+void AddressRow::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (selection.active_tab_changed()) {
+    Relayout();
+  }
+}
+
+void AddressRow::Relayout() {
+  // The toolbar's size is what changed; this re-runs the window's layout,
+  // where IsToolbarVisible is asked again.
+  if (BrowserWindow* const window = BrowserWindow::FromBrowser(&*browser_)) {
+    window->ToolbarSizeChanged(/*is_animating=*/false);
+  }
+}
+
+}  // namespace stedding
