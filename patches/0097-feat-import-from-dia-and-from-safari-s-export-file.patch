+// A test's stand-in for the key, and the count of asks.
+struct KeyForTesting {
+  std::optional<std::optional<std::vector<uint8_t>>> key;
+  std::atomic<size_t> reads{0};
+};
+
+KeyForTesting& TestKey() {
+  static base::NoDestructor<KeyForTesting> key;
+  return *key;
+}
+
+// import I31: the key the browser sealed its passwords with: on the Mac from
+// its keychain item (macOS asks the user), on Windows from its Local State.
+// Blocking.
+std::optional<std::vector<uint8_t>> ReadChromiumFamilyKey(
+    const ChromiumFamilySource& source,
+    const base::FilePath& local_state) {
+  KeyForTesting& test = TestKey();
+  ++test.reads;
+  if (test.key) {
+    return *test.key;
+  }
+#if BUILDFLAG(IS_WIN)
+  return ReadArcWindowsKey(local_state);
+#elif BUILDFLAG(IS_MAC)
+  // By service only: the item's account name is not known.
+  const std::optional<std::string> password =
+      ReadSafeStoragePassword(source.keychain_service, std::nullopt);
+  if (!password) {
+    return std::nullopt;
+  }
+  return DeriveArcKey(*password);
+#else
+  return std::nullopt;
+#endif
+}
