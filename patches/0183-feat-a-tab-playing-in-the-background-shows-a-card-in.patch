+namespace stedding {
+
+// docs/features/player.md Mp3, Mp7-Mp9 (BACKLOG S-95): the card at the
+// sidebar's foot for the tab of the window that plays sound in the
+// background. Two of them stand in each sidebar of Spaces, one per form:
+// `kCard`, the open sidebar's card above the archive line, its body showing
+// the tab, with play or pause and stop; `kRail`, the rail's favicon above
+// History, a click pausing or playing (Mp8). Each shows only in its own form
+// and while the window's AudioStrip has a tab.
+class AudioStripView : public views::View, public AudioStrip::Observer {
+  METADATA_HEADER(AudioStripView, views::View)
+
+ public:
+  enum class Form { kCard, kRail };
+
+  // `side_padding`: the open sidebar's padding from its edges, where the
+  // card's corners stand; `favicon_inset`: the rows' favicon inset in a row,
+  // where the card's favicon stands too.
+  AudioStripView(AudioStrip& strip,
+                 Form form,
+                 int side_padding,
+                 int favicon_inset);
+  AudioStripView(const AudioStripView&) = delete;
+  AudioStripView& operator=(const AudioStripView&) = delete;
+  ~AudioStripView() override;
+
+  // The sidebar is the rail, or open: the view shows only in its own form.
+  void SetRailForm(bool rail);
+
+  views::Button* body_for_testing() const;
+  views::Button* play_pause_for_testing() const;
+  views::Button* stop_for_testing() const;
+  views::Button* rail_button_for_testing() const;
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaint(gfx::Canvas* canvas) override;
+
+ private:
+  class RailButton;
+
+  // AudioStrip::Observer:
+  void OnAudioStripChanged() override;
+
+  void Refresh();
+
+  const raw_ref<AudioStrip> strip_;
+  const Form form_;
+  bool rail_ = false;
+  // kCard.
+  raw_ptr<views::LabelButton> body_ = nullptr;
+  raw_ptr<views::ImageButton> play_pause_ = nullptr;
+  raw_ptr<views::ImageButton> stop_ = nullptr;
+  // kRail.
+  raw_ptr<RailButton> rail_button_ = nullptr;
+  base::ScopedObservation<AudioStrip, AudioStrip::Observer> observation_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_AUDIO_STRIP_VIEW_H_
