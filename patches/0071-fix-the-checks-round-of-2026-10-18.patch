+// The colour a button's icon is drawn in at rest, as its image holds it: a
+// toolbar button bakes the colour in whenever its widget re-themes it.
+std::optional<SkColor> RestingIconColor(views::View* view) {
+  auto* const button = views::AsViewClass<views::LabelButton>(view);
+  if (!button) {
+    return std::nullopt;
+  }
+  const std::optional<ui::ImageModel>& image =
+      button->GetImageModel(views::Button::STATE_NORMAL);
+  if (!image || !image->IsVectorIcon()) {
+    return std::nullopt;
+  }
+  return image->GetVectorIcon().color().ResolveToSkColor(
+      button->GetColorProvider());
+}
