+// A child that runs `on_layout` from its own layout, inside its parent's walk
+// of its children.
+class CallsDuringLayout : public views::View {
+  METADATA_HEADER(CallsDuringLayout, views::View)
+
+ public:
+  void Layout(PassKey) override {
+    LayoutSuperclass<views::View>(this);
+    if (on_layout) {
+      std::move(on_layout).Run();
+    }
+  }
+
+  base::OnceClosure on_layout;
+};
+
+BEGIN_METADATA(CallsDuringLayout)
+END_METADATA
