+std::vector<std::u16string> BrowserTabMenuModelDelegate::GetOtherSpaceNames() {
+  std::vector<std::u16string> names;
+  BrowserWindowInterface* self = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetSessionID() == session_id_) {
+          self = browser;
+          return false;
+        }
+        return true;
+      });
+  spaces::SpaceModel* const model =
+      self ? spaces::SpaceModel::From(self) : nullptr;
+  if (!model) {
+    return names;
+  }
+  for (const std::unique_ptr<spaces::Space>& space : model->spaces()) {
+    if (space->id() != model->active_id()) {
+      names.push_back(model->DisplayName(space->id()));
+    }
+  }
+  return names;
+}
