+void ParseArcRoutes(std::string_view json, ArcImportPlan& plan) {
+  const std::optional<base::Value> parsed = base::JSONReader::Read(
+      json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  const base::DictValue* const root = parsed ? parsed->GetIfDict() : nullptr;
+  const base::ListValue* const rules = root ? root->FindList("rules") : nullptr;
+  if (!rules) {
+    return;
+  }
+  for (const base::Value& entry : *rules) {
+    const base::DictValue* const rule = entry.GetIfDict();
+    // I49: only a rule that names one Space can be a route. Arc's own types
+    // say destination is space or littleArc, each holding mostRecent, profile
+    // or space.
+    const std::string* const space =
+        rule ? rule->FindStringByDottedPath("destination.space._0.space._0")
+             : nullptr;
+    const base::ListValue* const components =
+        rule ? rule->FindList("sourceComponents") : nullptr;
+    if (!components) {
+      ++plan.routes_left_out;
+      continue;
+    }
+    for (const base::Value& each : *components) {
+      const base::DictValue* const component = each.GetIfDict();
+      const std::string* const id =
+          component ? component->FindString("id") : nullptr;
+      const base::DictValue* const url_match =
+          component ? component->FindDictByDottedPath("componentType.urlMatch")
+                    : nullptr;
+      const std::string* const text =
+          url_match ? url_match->FindString("_1") : nullptr;
+      const base::DictValue* const style =
+          url_match ? url_match->FindDict("_0") : nullptr;
+      std::optional<Route> route;
+      if (space && id && text && style) {
+        if (style->contains("contains")) {
+          route = RouteFromTyped(Route::Match::kContains, *text, *space);
+        } else if (style->contains("matches")) {
+          // A bare host is that host; anything else is the whole address.
+          route = RouteFromTyped(Route::Match::kHost, *text, *space);
+          if (!route || text->find(':') != std::string::npos) {
+            route = RouteFromTyped(Route::Match::kEquals, *text, *space);
+          }
+        }
+      }
+      if (!route) {
+        ++plan.routes_left_out;
+        continue;
+      }
+      plan.routes.push_back({.arc_id = *id,
+                             .match = route->match,
+                             .pattern = route->pattern,
+                             .arc_space = *space});
+    }
+  }
+}
