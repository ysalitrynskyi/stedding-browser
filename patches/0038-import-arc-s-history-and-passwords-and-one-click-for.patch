+namespace spaces {
+namespace {
+
+// A value sealed the way Arc (Chromium on macOS) seals it: "v10" and then
+// AES-128-CBC under `key` with an IV of sixteen spaces.
+std::string Seal(std::string_view plain, base::span<const uint8_t> key) {
+  std::array<uint8_t, crypto::aes_cbc::kBlockSize> iv;
+  iv.fill(' ');
+  const std::vector<uint8_t> body =
+      crypto::aes_cbc::Encrypt(key, iv, base::as_byte_span(plain));
+  std::string sealed = "v10";
+  sealed.append(body.begin(), body.end());
+  return sealed;
+}
+
+// import I22: the key derivation is RFC 8018's PBKDF2-HMAC-SHA1 (the RFC 6070
+// vectors), and Arc's key is sixteen bytes of it.
+TEST(ArcDataImporterTest, DerivesTheKeyLikeChromiumDoes) {
+  EXPECT_EQ("EA6C014DC72D6F8CCD1ED92ACE1D41F0D8DE8957",
+            base::HexEncode(Pbkdf2HmacSha1("password", "salt", 2, 20)));
+  EXPECT_EQ("4B007901B765489ABEAD49D926F721D065A429C1",
+            base::HexEncode(Pbkdf2HmacSha1("password", "salt", 4096, 20)));
+  EXPECT_EQ(16u, DeriveArcKey("peanuts").size());
+  EXPECT_NE(DeriveArcKey("peanuts"), DeriveArcKey("walnuts"));
+}
+
+TEST(ArcDataImporterTest, UnsealsAV10Value) {
+  const std::vector<uint8_t> key = DeriveArcKey("peanuts");
+  const std::string sealed = Seal("hunter2", key);
+  EXPECT_EQ(u"hunter2", DecryptArcValue(base::as_byte_span(sealed), key));
+  const std::optional<std::u16string> wrong_key =
+      DecryptArcValue(base::as_byte_span(sealed), DeriveArcKey("walnuts"));
+  EXPECT_TRUE(!wrong_key || *wrong_key != u"hunter2");
+  EXPECT_FALSE(DecryptArcValue(base::span<const uint8_t>(), key).has_value());
+  EXPECT_FALSE(
+      DecryptArcValue(base::as_byte_span(std::string_view("plain")), key)
+          .has_value());
+}
+
+// import I22: the urls table of a History copy, newest first, hidden rows and
+// chrome:// pages left out.
+TEST(ArcDataImporterTest, ReadsHistoryRowsFromACopy) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().AppendASCII("History");
+  {
+    sql::Database db(sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(path));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE urls(id INTEGER PRIMARY KEY, url LONGVARCHAR, "
+        "title LONGVARCHAR, visit_count INTEGER DEFAULT 0 NOT NULL, "
+        "typed_count INTEGER DEFAULT 0 NOT NULL, last_visit_time INTEGER "
+        "NOT NULL, hidden INTEGER DEFAULT 0 NOT NULL)"));
+    ASSERT_TRUE(db.Execute(
+        "INSERT INTO urls VALUES (1, 'https://example.com/', 'Example', 3, 1, "
+        "13300000000000000, 0)"));
+    ASSERT_TRUE(db.Execute(
+        "INSERT INTO urls VALUES (2, 'https://old.example/', 'Old', 1, 0, "
+        "13200000000000000, 0)"));
+    ASSERT_TRUE(db.Execute(
+        "INSERT INTO urls VALUES (3, 'https://hidden.example/', 'Hidden', 1, "
+        "0, 13300000000000001, 1)"));
+    ASSERT_TRUE(db.Execute(
+        "INSERT INTO urls VALUES (4, 'chrome://settings/', 'Settings', 1, 0, "
+        "13300000000000002, 0)"));
+  }
+  const history::URLRows rows = ReadArcHistory(path);
+  ASSERT_EQ(2u, rows.size());
+  EXPECT_EQ(GURL("https://example.com/"), rows[0].url());
+  EXPECT_EQ(u"Example", rows[0].title());
+  EXPECT_EQ(3, rows[0].visit_count());
+  EXPECT_EQ(1, rows[0].typed_count());
+  EXPECT_EQ(base::Time::FromDeltaSinceWindowsEpoch(
+                base::Microseconds(13300000000000000)),
+            rows[0].last_visit());
+  EXPECT_EQ(GURL("https://old.example/"), rows[1].url());
+  EXPECT_EQ(1u, ReadArcHistory(path, /*cap=*/1).size());
+  EXPECT_TRUE(ReadArcHistory(dir.GetPath().AppendASCII("missing")).empty());
+}
+
+// import I23: the logins table of a Login Data copy, passwords unsealed with
+// Arc's key; a blocked site comes across blocked, a value that will not
+// unseal is left out.
+TEST(ArcDataImporterTest, ReadsLoginsAndUnsealsPasswords) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().AppendASCII("Login Data");
+  const std::vector<uint8_t> key = DeriveArcKey("peanuts");
+  {
+    sql::Database db(sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(path));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE logins(origin_url VARCHAR NOT NULL, action_url VARCHAR, "
+        "username_element VARCHAR, username_value VARCHAR, password_element "
+        "VARCHAR, password_value BLOB, signon_realm VARCHAR NOT NULL, "
+        "date_created INTEGER NOT NULL, blacklisted_by_user INTEGER NOT NULL, "
+        "scheme INTEGER NOT NULL, date_last_used INTEGER NOT NULL DEFAULT 0, "
+        "date_password_modified INTEGER NOT NULL DEFAULT 0)"));
+    const auto insert = [&db](const char* origin, const char* user,
+                              std::string sealed, int blocked) {
+      sql::Statement s(db.GetUniqueStatement(
+          "INSERT INTO logins VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"));
+      s.BindString(0, origin);
+      s.BindString(1, origin);
+      s.BindString(2, "user");
+      s.BindString(3, user);
+      s.BindString(4, "pass");
+      s.BindBlob(5, std::move(sealed));
+      s.BindString(6, std::string(origin));
+      s.BindInt64(7, 13300000000000000);
+      s.BindInt(8, blocked);
+      s.BindInt(9, 0);
+      s.BindInt64(10, 13300000000000001);
+      s.BindInt64(11, 13300000000000002);
+      ASSERT_TRUE(s.Run());
+    };
+    insert("https://example.com/", "ann", Seal("hunter2", key), 0);
+    insert("https://blocked.example/", "", std::string(), 1);
+    insert("https://broken.example/", "bob", "v10junk", 0);
+  }
+  const std::vector<password_manager::PasswordForm> forms =
+      ReadArcLogins(path, key);
+  ASSERT_EQ(2u, forms.size());
+  EXPECT_EQ(GURL("https://example.com/"), forms[0].url);
+  EXPECT_EQ(u"ann", forms[0].username_value);
+  EXPECT_EQ(u"hunter2", forms[0].password_value);
+  EXPECT_EQ("https://example.com/", forms[0].signon_realm);
+  EXPECT_EQ(base::Time::FromDeltaSinceWindowsEpoch(
+                base::Microseconds(13300000000000000)),
+            forms[0].date_created);
+  EXPECT_EQ(password_manager::PasswordForm::Store::kProfileStore,
+            forms[0].in_store);
+  EXPECT_FALSE(forms[0].blocked_by_user);
+  EXPECT_TRUE(forms[1].blocked_by_user);
+  EXPECT_EQ(GURL("https://blocked.example/"), forms[1].url);
+}
+
+// import I21: the result line counts what came across, and says when the
+// keychain said no.
+TEST(ArcDataImporterTest, DescribeCountsHistoryAndPasswords) {
+  ArcImportResult result;
+  result.spaces = 2;
+  result.tabs = 5;
+  result.folders = 1;
+  result.history = 1200;
+  result.passwords = 1;
+  EXPECT_EQ(
+      u"Imported 2 Spaces, 5 tabs, 1 folder, 1200 history entries, 1 password",
+      DescribeArcImportResult(result));
+  result.passwords = 0;
+  result.keychain_denied = true;
+  EXPECT_EQ(
+      u"Imported 2 Spaces, 5 tabs, 1 folder, 1200 history entries · "
+      u"passwords skipped: the keychain said no",
+      DescribeArcImportResult(result));
+}
+
+TEST(ArcDataImporterTest, PathsSitUnderTheProfile) {
+  const ArcDataPaths paths =
+      ArcDataPathsFor(base::FilePath(FILE_PATH_LITERAL("/x/User Data")));
+  EXPECT_EQ(FILE_PATH_LITERAL("/x/User Data/Default/History"),
+            paths.history.value());
+  EXPECT_EQ(FILE_PATH_LITERAL("/x/User Data/Default/Login Data"),
+            paths.logins.value());
+  EXPECT_FALSE(ArcDataPresent(paths));
+}
+
