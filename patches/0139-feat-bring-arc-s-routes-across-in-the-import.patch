+// I48: `plan`'s routes, each to the Space its Arc Space became, after the
+// routes already here. A route an earlier import brought stays as it is, or
+// gone, as the person left it (I12). I49: one whose Space did not come across
+// is counted with those no route can say.
+void ApplyArcRoutes(const ArcImportPlan& plan,
+                    bool spaces,
+                    SpaceModel& model,
+                    ImportedIds& ids,
+                    PrefService* prefs,
+                    ArcImportResult& result) {
+  result.routes_left_out = plan.routes_left_out;
+  for (const ArcImportPlan::ArcRoute& arc_route : plan.routes) {
+    const std::string id = "route:" + arc_route.arc_id;
+    if (ids.Contains(id)) {
+      continue;
+    }
+    const std::optional<SpaceId> space =
+        spaces ? ids.SpaceFor(arc_route.arc_space) : std::nullopt;
+    if (!space || !model.GetSpace(*space)) {
+      ++result.routes_left_out;
+      continue;
+    }
+    const std::vector<Route> routes = ReadRoutes(prefs);
+    const bool here = std::ranges::any_of(routes, [&](const Route& route) {
+      return route.match == arc_route.match &&
+             base::ToLowerASCII(route.pattern) ==
+                 base::ToLowerASCII(arc_route.pattern);
+    });
+    if (!here) {
+      Route route;
+      route.match = arc_route.match;
+      route.pattern = arc_route.pattern;
+      route.space = space->ToString();
+      AddRoute(prefs, std::move(route));
+      ++result.routes;
+    }
+    ids.Add(id);
+  }
+}
+
