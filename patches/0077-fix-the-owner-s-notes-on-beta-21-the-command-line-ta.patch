+                    const gfx::Point& to,
+                    bool release = true) {
+    FolderView* const view = HeaderOf(folder);
+    ASSERT_TRUE(view);
+    const gfx::Point from = view->GetHeaderBoundsInScreen().CenterPoint();
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed,
+                                  from);
+    constexpr int kSteps = 12;
+    for (int i = 1; i <= kSteps; ++i) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                     from.y() + (to.y() - from.y()) * i / kSteps));
+    }
+    if (release) {
+      stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased,
+                                    to);
+    }
+  }
+
+  // The drop indicator of a drag of `folder`'s header, in screen
+  // coordinates, while one is shown.
+  std::optional<gfx::Rect> DropIndicator(
+      const tabs::FolderTabCollection* folder) {
+    FolderView* const view = HeaderOf(folder);
+    const UnpinnedTabContainerView* const container =
+        view ? views::AsViewClass<UnpinnedTabContainerView>(view->parent())
+             : nullptr;
+    return container ? container->GetRowDropIndicatorBoundsInScreenForTesting()
+                     : std::nullopt;
+  }
+
+  // Whether every tab of `folder` is still in it and a Space pin, or none is.
+  bool FolderWhole(const tabs::FolderTabCollection* folder,
+                   const std::vector<const tabs::TabInterface*>& tabs,
+                   bool pinned) {
+    for (const tabs::TabInterface* const tab : tabs) {
+      if (tab->GetParentCollection() != folder ||
+          model().IsSpacePinned(tab) != pinned) {
+        return false;
+      }
+    }
+    return true;
+  }
 };
 
