+// toolbar T62 (BACKLOG S-468): a colour under a dark layer, black or tinted,
+// is the colour dimmed; another colour, a lighter one, one darkened unevenly,
+// or a change too small or too dark to tell is not.
+TEST(PageTopColorTest, ADarkLayerDimsTheEdgeEvenly) {
+  constexpr SkColor kWhite = SK_ColorWHITE;
+  constexpr SkColor kBlue = SkColorSetRGB(0x19, 0x76, 0xd2);
+  // Under black at 60%, at 85% and at 30%.
+  EXPECT_TRUE(IsDimmedEdge(kWhite, SkColorSetRGB(102, 102, 102)));
+  EXPECT_TRUE(IsDimmedEdge(kWhite, SkColorSetRGB(38, 38, 38)));
+  EXPECT_TRUE(IsDimmedEdge(kBlue, SkColorSetRGB(18, 83, 147)));
+  // Under a slate layer, rgba(15, 23, 42, 0.5).
+  EXPECT_TRUE(IsDimmedEdge(kWhite, SkColorSetRGB(135, 139, 148)));
+
+  EXPECT_FALSE(IsDimmedEdge(kBlue, SkColorSetRGB(0x38, 0x8e, 0x3c)))
+      << "another colour";
+  EXPECT_FALSE(IsDimmedEdge(SkColorSetRGB(102, 102, 102), kWhite))
+      << "lighter";
+  EXPECT_FALSE(IsDimmedEdge(kBlue, SkColorSetRGB(10, 83, 60)))
+      << "darkened unevenly: green kept far more of its light than blue";
+  EXPECT_FALSE(IsDimmedEdge(kWhite, SkColorSetRGB(250, 250, 250)))
+      << "too small a change to be a layer";
+  EXPECT_FALSE(IsDimmedEdge(kWhite, SkColorSetRGB(6, 6, 6)))
+      << "black, as a page turned dark is";
+  EXPECT_FALSE(IsDimmedEdge(SkColorSetRGB(30, 30, 30),
+                            SkColorSetRGB(15, 15, 15)))
+      << "too dark a colour for a dimming to show";
+}
