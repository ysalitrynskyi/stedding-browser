+  ASSERT_LT(index(page_upper), index(page_lower));
+  ASSERT_LT(index(above_selected), index(selected));
+  ASSERT_LT(index(above_filed), index(filed));
+  ASSERT_LT(index(elsewhere), index(page_upper));
+
+  std::vector<tabs::TabInterface*> doomed = {page_lower, above_selected,
+                                             above_filed, pin_copy};
+  std::ranges::sort(doomed, std::ranges::less(), index);
+  EXPECT_EQ(doomed, model().DuplicateTabsInActiveSpace())
+      << "the loose copies, in sidebar order";
+
+  std::vector<tabs::TabHandle> kept;
+  for (tabs::TabInterface* const tab :
+       {page_upper, query, fragment, port, selected, filed, essential,
+        space_pin, elsewhere}) {
+    kept.push_back(tab->GetHandle());
+  }
+  std::vector<tabs::TabHandle> closed;
+  for (tabs::TabInterface* const tab : doomed) {
+    closed.push_back(tab->GetHandle());
+  }
+
+  model().CloseDuplicateTabs();
+
+  EXPECT_EQ(9, tabs().count());
+  for (const tabs::TabHandle& handle : kept) {
+    EXPECT_NE(nullptr, handle.Get());
+  }
+  for (const tabs::TabHandle& handle : closed) {
+    EXPECT_EQ(nullptr, handle.Get());
+  }
+  EXPECT_EQ(selected, tabs().GetActiveTab()) << "the selection never moves";
+  EXPECT_EQ(other, model().SpaceForTab(elsewhere));
+  EXPECT_TRUE(model().DuplicateTabsInActiveSpace().empty());
+}
