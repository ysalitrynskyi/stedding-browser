+
+// The command bar's rows: the commands chord on the bar the extensions chord
+// opened lists the commands (commandbar K8, toolbar T39), a preference row
+// stays chosen once it has run even when a place of Settings has its name
+// (K17, K39), and a suggested page the profile never opened is not labelled
+// History (K4).
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/run_loop.h"
+#include "base/strings/utf_string_conversions.h"
