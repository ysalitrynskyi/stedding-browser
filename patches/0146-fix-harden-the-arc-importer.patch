+void InsertSpaceRows(ApplyContext& ctx,
+                     const ArcImportPlan::Space& arc_space,
+                     const SpaceId& id,
+                     const ArcImportOptions& options) {
+  if (options.pinned) {
+    // spaces B6: the Space's own essentials, in its jar.
+    InsertEssentials(ctx, arc_space.essentials, id);
+    // The pinned run in its order, one row at a time: a pin joins the
+    // end of the run (pins H14), and so does a folder pinned (folders
+    // F38).
+    for (const Node& node : arc_space.pinned) {
+      for (tabs::TabInterface* const tab :
+           InsertNodes(ctx, {node}, id, nullptr)) {
+        ctx.model->SetSpacePinned(tab, true);
+      }
+      // I3, folders F38 (BACKLOG S-107): a list of Arc's pinned section,
+      // or a folder of the pinned run of a file Stedding wrote (Sf2),
+      // comes in as a folder of the run, its tabs pins. Arc's lists had
+      // come in under the Clear line. A folder that was here already
+      // keeps its place.
+      if (node.kind == Node::Kind::kFolder &&
+          ctx.made_folders.contains(node.arc_id)) {
+        tabs::FolderTabCollection* const folder =
+            KnownFolder(ctx, node.arc_id);
+        if (folder && ctx.model->CanPinFolder(folder) &&
+            !ctx.model->IsFolderSpacePinned(folder)) {
+          ctx.model->SetFolderSpacePinned(folder, true);
+        }
+      }
+    }
+  }
+  if (options.unpinned) {
+    InsertNodes(ctx, arc_space.unpinned, id, nullptr);
+  }
+  MakeSplits(ctx);
+}
