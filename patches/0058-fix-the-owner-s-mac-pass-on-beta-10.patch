+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A tab created unloaded -- as the Arc import makes them (import I3) -- saves
+// a page state that the next start can load (owner, 2026-10-01). The saved
+// state carried the sequence numbers -1 of an entry that never committed; the
+// restored document committed with them, which the browser kills as a bad
+// message (RFH_INVALID_DOCUMENT_SEQUENCE_NUMBER), so every such tab came back
+// from a restart as a crashed page until it was reloaded.
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_entry_restore_context.h"
+#include "content/public/browser/restore_type.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "third_party/blink/public/common/page_state/page_state.h"
+#include "third_party/blink/public/common/page_state/page_state_serialization.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+
+namespace {
+
+class RestoredPageStateTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  // An entry as the Arc import builds one for a tab it does not load.
+  std::unique_ptr<content::NavigationEntry> UnloadedEntry(const GURL& url) {
+    return content::NavigationController::CreateNavigationEntry(
+        url, content::Referrer(), std::nullopt, std::nullopt,
+        ui::PAGE_TRANSITION_TYPED, false, std::string(),
+        browser()->GetProfile(), nullptr);
+  }
+};
+
+// What the session saves for a tab that was never loaded has no -1 in it.
+IN_PROC_BROWSER_TEST_F(RestoredPageStateTest, AnUnloadedTabSavesNoMinusOne) {
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  std::unique_ptr<content::NavigationEntry> entry = UnloadedEntry(url);
+  blink::ExplodedPageState saved;
+  ASSERT_TRUE(
+      blink::DecodePageState(entry->GetPageState().ToEncodedData(), &saved));
+  EXPECT_GE(saved.top.item_sequence_number, 0);
+  EXPECT_GE(saved.top.document_sequence_number, 0);
+}
+
+// A page state saved with -1 by an earlier build loads: the tab's page shows
+// and its renderer is not killed.
+IN_PROC_BROWSER_TEST_F(RestoredPageStateTest, AMinusOneSavedEarlierLoads) {
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  blink::ExplodedPageState saved;
+  saved.top.url_string = base::UTF8ToUTF16(url.spec());
+  saved.top.item_sequence_number = -1;
+  saved.top.document_sequence_number = -1;
+  std::string data;
+  blink::EncodePageState(saved, &data);
+
+  std::unique_ptr<content::NavigationEntry> entry = UnloadedEntry(url);
+  std::unique_ptr<content::NavigationEntryRestoreContext> context =
+      content::NavigationEntryRestoreContext::Create();
+  entry->SetPageState(blink::PageState::CreateFromEncodedData(data),
+                      context.get());
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries;
+  entries.push_back(std::move(entry));
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(
+          content::WebContents::CreateParams(browser()->GetProfile()));
+  contents->GetController().Restore(0, content::RestoreType::kRestored,
+                                    &entries);
+  content::WebContents* const tab = contents.get();
+  browser()->tab_strip_model()->AppendWebContents(std::move(contents),
+                                                  /*foreground=*/true);
+  tab->GetController().LoadIfNecessary();
+  EXPECT_TRUE(content::WaitForLoadStop(tab));
+  EXPECT_FALSE(tab->IsCrashed()) << "the restored page's renderer was killed";
+  EXPECT_EQ(url, tab->GetLastCommittedURL());
+}
+
+}  // namespace
