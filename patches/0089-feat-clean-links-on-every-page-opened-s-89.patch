+  content::URLLoaderInterceptor interceptor(base::BindLambdaForTesting(
+      [&](content::URLLoaderInterceptor::RequestParams* params) {
+        if (params->url_request.url.host() != "www.google.com") {
+          return false;
+        }
+        {
+          base::AutoLock hold(lock);
+          google_requests.push_back(params->url_request.url);
+        }
+        content::URLLoaderInterceptor::WriteResponse(
+            "HTTP/1.1 200 OK\nContent-type: text/html\n\n",
+            "<title>search</title>", params->client.get());
+        return true;
+      }));
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("https://www.google.com/search?q=x&utm_source=y")));
+  EXPECT_EQ(GURL("https://www.google.com/search?q=x&utm_source=y"
+                 "&safe=active&ssui=on"),
+            Active()->GetLastCommittedURL());
+
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Url("a.test", "/title1.html")));
+  ClickLink(GURL(base::StrCat(
+      {"https://www.google.com/url?q=",
+       base::EscapeQueryParamValue("https://www.google.com/search?q=y"
+                                   "&utm_source=z",
+                                   /*use_plus=*/false)})));
+  EXPECT_EQ(GURL("https://www.google.com/search?q=y&safe=active&ssui=on"),
+            Active()->GetLastCommittedURL());
+
+  base::AutoLock hold(lock);
+  for (const GURL& request : google_requests) {
+    SCOPED_TRACE(request.spec());
+    EXPECT_NE("/url", request.path()) << "the redirect page was asked for";
+    EXPECT_EQ(std::string::npos, request.spec().find("utm_source=z"));
+  }
+}
