+// PLAN.md TAB-8: a folder whose only tab closes goes while its header
+// animates out. In that time the page colour changes -- the address row and
+// the rows take the new page's colour -- and a tab is dragged over where the
+// header was; none of it reaches the folder that is gone, and the window
+// keeps working.
+IN_PROC_BROWSER_TEST_F(TabDropTest, AFolderGoingAwayIsLeftAlone) {
+  tabs::TabInterface* const dragged = Open("dragged.test");
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(),
+      GURL("data:text/html,<meta name=theme-color content=%23cc2200>"
+           "<title>Red</title>"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const red = tab_strip_model()->GetActiveTab();
+  tabs::TabInterface* const only = Open("only.test");
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({Index(only)});
+  ASSERT_TRUE(folder);
+  tab_strip_model()->ActivateTabAt(Index(only));
+  const gfx::Point header = HeaderCentre(folder);
+  const gfx::Point from = RowCentre(dragged);
+
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);  // Cmd-W
+  ASSERT_EQ(TabStripModel::kNoTab, Index(only));
+  // At once, while the header animates out.
+  tab_strip_model()->ActivateTabAt(Index(red));
+  Drag(from, header);
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  // The press made the dragged tab the one on screen.
+  EXPECT_EQ(dragged, tab_strip_model()->GetActiveTab());
+  EXPECT_EQ(dragged->GetContents(), browser_view()->GetActiveWebContents());
+  EXPECT_EQ(3, tab_strip_model()->count());
+  EXPECT_EQ(1u, WindowCount());
+  // The window still takes a new tab and a close.
+  Open("after.test");
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+  EXPECT_EQ(3, tab_strip_model()->count());
+}
