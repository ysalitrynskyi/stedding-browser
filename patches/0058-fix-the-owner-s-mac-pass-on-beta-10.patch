new file mode 100644
index 0000000000000..87355a628cb62
--- /dev/null
+++ b/chrome/browser/ui/stedding/theme/page_top_color.cc
@@ -0,0 +1,76 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/theme/page_top_color.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <vector>
+
+#include "third_party/skia/include/core/SkBitmap.h"
+
+namespace stedding {
+namespace {
+
+int ChannelDistance(SkColor a, SkColor b) {
+  return std::max({std::abs(static_cast<int>(SkColorGetR(a)) -
+                            static_cast<int>(SkColorGetR(b))),
+                   std::abs(static_cast<int>(SkColorGetG(a)) -
+                            static_cast<int>(SkColorGetG(b))),
+                   std::abs(static_cast<int>(SkColorGetB(a)) -
+                            static_cast<int>(SkColorGetB(b)))});
+}
+
+U8CPU Median(std::vector<U8CPU> values) {
+  const auto middle = values.begin() + values.size() / 2;
+  std::nth_element(values.begin(), middle, values.end());
+  return *middle;
+}
+
+}  // namespace
+
+std::optional<SkColor> UniformTopEdgeColor(const SkBitmap& strip) {
+  if (strip.drawsNothing() || strip.height() < 1 ||
+      strip.width() < kPageTopMinSamples) {
+    return std::nullopt;
+  }
+  std::vector<SkColor> samples;
+  samples.reserve(static_cast<size_t>(strip.width()));
+  std::vector<U8CPU> reds, greens, blues;
+  for (int x = 0; x < strip.width(); ++x) {
+    const SkColor sample = SkColorSetA(strip.getColor(x, 0), SK_AlphaOPAQUE);
+    samples.push_back(sample);
+    reds.push_back(SkColorGetR(sample));
+    greens.push_back(SkColorGetG(sample));
+    blues.push_back(SkColorGetB(sample));
+  }
+  const SkColor median = SkColorSetRGB(Median(std::move(reds)),
+                                       Median(std::move(greens)),
+                                       Median(std::move(blues)));
+  int near = 0;
+  int red = 0;
+  int green = 0;
+  int blue = 0;
+  for (const SkColor sample : samples) {
+    if (ChannelDistance(sample, median) > kPageTopChannelTolerance) {
+      continue;
+    }
+    ++near;
+    red += SkColorGetR(sample);
+    green += SkColorGetG(sample);
+    blue += SkColorGetB(sample);
+  }
+  if (near * 10 < static_cast<int>(samples.size()) * 9) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB(static_cast<U8CPU>((red + near / 2) / near),
+                       static_cast<U8CPU>((green + near / 2) / near),
+                       static_cast<U8CPU>((blue + near / 2) / near));
+}
+
+bool PageColorsMatch(SkColor a, SkColor b) {
+  return ChannelDistance(a, b) <= 2;
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/theme/page_top_color.h b/chrome/browser/ui/stedding/theme/page_top_color.h
new file mode 100644
index 0000000000000..a1c0c5ea4ec6d
--- /dev/null
+++ b/chrome/browser/ui/stedding/theme/page_top_color.h
@@ -0,0 +1,47 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_THEME_PAGE_TOP_COLOR_H_
+#define CHROME_BROWSER_UI_STEDDING_THEME_PAGE_TOP_COLOR_H_
+
+#include <optional>
+
+#include "third_party/skia/include/core/SkColor.h"
+
+class SkBitmap;
+
+namespace stedding {
+
+// docs/features/toolbar.md T31: the address row takes the colour the page is
+// drawn in along its top edge, the edge the row sits on, the way Safari reads
+// a page's top colour. A page's declared colour -- its theme-color, or its
+// document background -- can be nothing like what it draws there: a site
+// that paints its purple with a full-page layer over a near-black body gave
+// a near-black row over a purple page (owner, 2026-10-01).
+
+// How far, in DIPs, the strip read from the top of the page reaches down, and
+// how much of the page's right edge is left out of it (a scroll bar).
+inline constexpr int kPageTopStripHeight = 2;
+inline constexpr int kPageTopRightMargin = 16;
+// One sample for this many DIPs across the page, and never fewer samples
+// than kPageTopMinSamples.
+inline constexpr int kPageTopSampleSpacing = 4;
+inline constexpr int kPageTopMinSamples = 8;
+// A sample counts as the edge's colour when no channel is further than this
+// from the median, and the edge is one colour when nine samples in ten are.
+inline constexpr int kPageTopChannelTolerance = 10;
+
+// The colour of `strip`'s first row when that row is one colour: the mean of
+// the samples near the per-channel median, if nine in ten are near it, and
+// nothing otherwise (a photograph, a gradient, a header of several colours),
+// or for a strip with fewer than kPageTopMinSamples columns. Opaque.
+std::optional<SkColor> UniformTopEdgeColor(const SkBitmap& strip);
+
+// Whether two row colours are close enough that changing from one to the
+// other is not worth re-theming the window: every channel within two.
+bool PageColorsMatch(SkColor a, SkColor b);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_THEME_PAGE_TOP_COLOR_H_
diff --git a/chrome/browser/ui/stedding/theme/page_top_color_unittest.cc b/chrome/browser/ui/stedding/theme/page_top_color_unittest.cc
new file mode 100644
index 0000000000000..ee96eb3c1db66
--- /dev/null
+++ b/chrome/browser/ui/stedding/theme/page_top_color_unittest.cc
@@ -0,0 +1,88 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/theme/page_top_color.h"
+
+#include <optional>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace stedding {
+namespace {
+
+SkBitmap Strip(int width, SkColor color) {
+  SkBitmap strip;
+  strip.allocN32Pixels(width, 2);
+  strip.eraseColor(color);
+  return strip;
+}
+
+void Paint(SkBitmap& strip, int from, int to, SkColor color) {
+  for (int x = from; x < to; ++x) {
+    for (int y = 0; y < strip.height(); ++y) {
+      *strip.getAddr32(x, y) = SkPreMultiplyColor(color);
+    }
+  }
+}
+
+// toolbar T31: a page drawn in one colour along its top edge gives that
+// colour -- farcaster.xyz's purple layer over its near-black body.
+TEST(PageTopColorTest, AnEdgeOfOneColourIsThatColour) {
+  const SkColor purple = SkColorSetRGB(48, 26, 158);
+  EXPECT_EQ(purple, UniformTopEdgeColor(Strip(300, purple)));
+  EXPECT_EQ(SK_ColorWHITE, UniformTopEdgeColor(Strip(300, SK_ColorWHITE)));
+}
+
+// A logo or a button that reaches the top edge over a few samples does not
+// stop the edge reading as the header's colour, and the noise of a header's
+// texture averages out.
+TEST(PageTopColorTest, ASmallElementOnTheEdgeIsIgnored) {
+  const SkColor header = SkColorSetRGB(1, 4, 9);
+  SkBitmap strip = Strip(200, header);
+  Paint(strip, 10, 25, SK_ColorWHITE);  // 7.5% of the edge
+  EXPECT_EQ(header, UniformTopEdgeColor(strip));
+
+  SkBitmap noisy = Strip(100, SkColorSetRGB(100, 100, 100));
+  Paint(noisy, 0, 50, SkColorSetRGB(104, 104, 104));
+  EXPECT_EQ(SkColorSetRGB(102, 102, 102), UniformTopEdgeColor(noisy));
+}
+
+// A photograph, a gradient or a header split between two colours is not one
+// colour: the row falls back to the page's declared colour.
+TEST(PageTopColorTest, AnEdgeOfSeveralColoursIsNone) {
+  SkBitmap halves = Strip(200, SK_ColorWHITE);
+  Paint(halves, 100, 200, SK_ColorBLACK);
+  EXPECT_EQ(std::nullopt, UniformTopEdgeColor(halves));
+
+  SkBitmap gradient = Strip(256, SK_ColorBLACK);
+  for (int x = 0; x < 256; ++x) {
+    Paint(gradient, x, x + 1, SkColorSetRGB(x, x, x));
+  }
+  EXPECT_EQ(std::nullopt, UniformTopEdgeColor(gradient));
+
+  SkBitmap busy = Strip(200, SK_ColorWHITE);
+  Paint(busy, 0, 30, SK_ColorRED);  // 15%: more than one sample in ten
+  EXPECT_EQ(std::nullopt, UniformTopEdgeColor(busy));
+}
+
+TEST(PageTopColorTest, TooFewSamplesOrNoPixelsIsNone) {
+  EXPECT_EQ(std::nullopt, UniformTopEdgeColor(SkBitmap()));
+  EXPECT_EQ(std::nullopt,
+            UniformTopEdgeColor(Strip(kPageTopMinSamples - 1, SK_ColorWHITE)));
+  EXPECT_EQ(SK_ColorWHITE,
+            UniformTopEdgeColor(Strip(kPageTopMinSamples, SK_ColorWHITE)));
+}
+
+// A sample a step away from the last is not a new colour for the window.
+TEST(PageTopColorTest, ColoursTwoStepsApartMatch) {
+  EXPECT_TRUE(PageColorsMatch(SkColorSetRGB(10, 20, 30),
+                              SkColorSetRGB(12, 18, 30)));
+  EXPECT_FALSE(PageColorsMatch(SkColorSetRGB(10, 20, 30),
+                               SkColorSetRGB(13, 20, 30)));
+}
+
+}  // namespace
+}  // namespace stedding
