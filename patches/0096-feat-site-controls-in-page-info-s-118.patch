@@ -219,4 +219,34 @@ void CopyLink(BrowserWindowInterface* browser,
   }
 }
 
+std::u16string WriteTitleToClipboard(content::WebContents* contents) {
+  if (!contents) {
+    return std::u16string();
+  }
+  const GURL url = contents->GetVisibleURL();
+  if (!url.is_valid()) {
+    return std::u16string();
+  }
+  // The title copy-link's Markdown label uses (L3): never the formatted
+  // address WebContents::GetTitle() falls back to.
+  const std::u16string title = TitleFor(contents, url);
+  ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+  if (AnyOffTheRecord({contents})) {
+    writer.MarkAsOffTheRecord();
+  }
+  writer.WriteText(title);
+  return title;
+}
+
+void CopyTitle(BrowserWindowInterface* browser,
+               content::WebContents* contents) {
+  if (WriteTitleToClipboard(contents).empty()) {
+    return;
+  }
+  if (ToastController* const toasts =
+          browser ? ToastController::From(browser) : nullptr) {
+    toasts->MaybeShowToast(ToastParams(ToastId::kSteddingTitleCopied));
+  }
+}
+
 }  // namespace stedding
