+void SteddingSpacesHandler::HandleSetSpaceSessionAfterAsking(
+    const base::ListValue& args) {
+  if (args.size() != 2U || !args[1].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  const std::optional<spaces::SpaceId> id = ParseId(args[0]);
+  if (!id) {
+    return;
+  }
+  // sessions S39, S40: the question is the browser's, and the list follows
+  // the answer.
+  spaces::SetSpaceSessionAfterAsking(
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents()),
+      *id, args[1].GetString(), std::string());
+}
+
+void SteddingSpacesHandler::HandleNewSessionForSpace(
+    const base::ListValue& args) {
+  if (args.size() != 1U) {
+    return;
+  }
+  AllowJavascript();
+  const std::optional<spaces::SpaceId> id = ParseId(args[0]);
+  if (!id) {
+    return;
+  }
+  spaces::NewSessionInDialog(
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents()),
+      *id);
+}
+
+void SteddingSpacesHandler::HandleDeleteSessionAfterAsking(
+    const base::ListValue& args) {
+  if (args.size() != 1U || !args[0].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  spaces::DeleteUnusedSessionAfterAsking(
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents()),
+      args[0].GetString());
+}
