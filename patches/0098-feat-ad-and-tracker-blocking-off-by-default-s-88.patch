+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_BLOCKER_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_BLOCKER_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/ui/stedding/blocker/blocker_lists.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+#include "components/content_settings/core/browser/content_settings_observer.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+
+class Profile;
+
+// docs/features/blocker.md Bk9: the rows of Settings > Stedding > Privacy >
+// Blocking that no preference binds: each list's name, homepage, licence and
+// last fetch; when the ruleset was last made and from how many rules; "Update
+// lists now"; and the sites where blocking is off, with Remove and Add. The
+// switch, the two lists' toggles and the button's setting are preferences
+// the page binds itself.
+class SteddingBlockerHandler : public settings::SettingsPageUIHandler,
+                               public content_settings::Observer,
+                               public stedding::BlockerLists::Observer {
+ public:
+  explicit SteddingBlockerHandler(Profile* profile);
+  SteddingBlockerHandler(const SteddingBlockerHandler&) = delete;
+  SteddingBlockerHandler& operator=(const SteddingBlockerHandler&) = delete;
+  ~SteddingBlockerHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // content_settings::Observer:
+  void OnContentSettingChanged(
+      const ContentSettingsPattern& primary_pattern,
+      const ContentSettingsPattern& secondary_pattern,
+      ContentSettingsTypeSet content_type_set) override;
+
+  // stedding::BlockerLists::Observer:
+  void OnBlockerListsChanged() override;
+
+  // What the page draws, for tests.
+  base::DictValue StateForTesting() const { return State(); }
+
+ private:
+  base::DictValue State() const;
+
+  void HandleGetBlocker(const base::ListValue& args);
+  void HandleUpdateBlockerLists(const base::ListValue& args);
+  void HandleAddBlockerException(const base::ListValue& args);
+  void HandleRemoveBlockerException(const base::ListValue& args);
+
+  const raw_ptr<Profile> profile_;
+  base::ScopedObservation<HostContentSettingsMap, content_settings::Observer>
+      settings_observation_{this};
+  base::ScopedObservation<stedding::BlockerLists,
+                          stedding::BlockerLists::Observer>
+      lists_observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_BLOCKER_HANDLER_H_
