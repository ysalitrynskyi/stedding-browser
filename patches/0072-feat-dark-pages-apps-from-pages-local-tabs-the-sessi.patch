+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_DARK_PAGES_H_
+#define CHROME_BROWSER_UI_STEDDING_DARK_PAGES_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "build/build_config.h"
+#include "components/content_settings/core/browser/content_settings_observer.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+class Profile;
+
+namespace content {
+class NavigationHandle;
+class WebContents;
+}  // namespace content
+
+namespace stedding {
+
+// Dark pages (docs/features/dark-pages.md): one switch for the profile turns
+// every web page dark with Chromium's own automatic dark mode for web
+// contents, which Blink applies at paint time from a page's first frame. The
+// switch is Chromium's preference prefs::kWebKitForceDarkModeEnabled (Dk1);
+// the exceptions are the content setting AUTO_DARK_WEB_CONTENT, which Stedding
+// registers on desktop (Dk12): its default is the mode, its Block and Allow
+// entries the two lists.
+
+// The colour Blink draws a darkened page's white canvas in, and so the colour
+// of the content area under a darkened page before its first frame (Dk7).
+inline constexpr SkColor kDarkPagesCanvas = SkColorSetRGB(0x12, 0x12, 0x12);
+
+// Dk15: the page menu's row, in the case of the menu around it: title case on
+// the Mac, sentence case elsewhere, as Chromium's own rows there ("View Page
+// Source", "View page source").
+inline constexpr char16_t kDarkenThisSiteLabel[] =
+#if BUILDFLAG(IS_MAC)
+    u"Darken This Site";
+#else
+    u"Darken this site";
+#endif
+
+// Dk12: what the lists mean. kAllExcept darkens every site but the ones on
+// its list (the content setting's default is Allow); kOnlyThese darkens only
+// the ones on its own list (the default is Block).
+enum class DarkPagesMode { kAllExcept, kOnlyThese };
+
+// Dk9: the browser's own pages (chrome://, chrome-untrusted://,
+// chrome-search://), DevTools and extension pages are never darkened,
+// whatever the switch and the lists say.
+bool IsNeverDarkenedUrl(const GURL& url);
+
+// The address dark pages decides by for `contents` (Dk10, Dk11): its
+// top-level page, which every frame follows; the page a view-source tab
+// shows; the page about to commit, from the moment it is ready to (Dk7); or,
+// before the first page of a new tab has committed, the address it is
+// loading, so the page is darkened from its first frame.
+GURL DarkPagesUrlFor(content::WebContents* contents);
+
+// Dk1: whether the switch is on. Read from the original profile, so a private
+// window agrees with the normal ones (Dk21).
+bool DarkPagesOn(Profile* profile);
+
+// Turns dark pages on or off for the profile: always the original profile's
+// preference, never a private window's in-memory copy of it (Dk1, Dk21).
+void SetDarkPagesOn(Profile* profile, bool on);
+
+// Dk1, Dk9, Dk12: whether a page at `url` of `profile` is darkened: the switch
+// is on, the page is not one of the browser's own, and the content setting
+// for it is Allow. `profile`'s own map decides, so a private window's choices
+// count for its pages alone (Dk21).
+bool DarkPagesApplyToUrl(Profile* profile, const GURL& url);
+
+// The same for what `contents` shows now (DarkPagesUrlFor).
+bool DarkPagesApplyTo(content::WebContents* contents);
+
+// Dk12: the mode, the default of the original profile's content setting.
+DarkPagesMode GetDarkPagesMode(Profile* profile);
+void SetDarkPagesMode(Profile* profile, DarkPagesMode mode);
+
+// Dk13: the list entry for a page at `url`: its registrable domain and every
+// subdomain on any scheme and port (`[*.]example.co.uk` for
+// www.news.example.co.uk), the rule Clear Site Cookies uses (commandbar K24);
+// an IP address as it is. Nothing unless `url` is an http or https address.
+std::optional<ContentSettingsPattern> DarkPagesSitePatternFor(const GURL& url);
+
+// Dk13: the entry for what was typed in Settings: a host, a URL (cut to its
+// host), `*.host` or an IP address. Nothing for anything else (an empty or a
+// path-only entry, a browser page).
+std::optional<ContentSettingsPattern> DarkPagesSitePatternFromTyped(
+    std::string_view typed);
+
+// How an entry is named in Settings and the command bar: its host, without
+// the subdomain wildcard ("example.com" for `[*.]example.com`).
+std::string DarkPagesSiteName(const ContentSettingsPattern& pattern);
+
+// Dk15, Dk19: whether the active page's site can be kept light or darkened
+// from the page menu and the bar: dark pages is on and the page is an http or
+// https page.
+bool CanChooseDarkPagesForSite(content::WebContents* contents);
+
+// Dk15, Dk19: whether `contents`'s site is darkened, and the choice made for
+// it from the page menu or the bar. In a private window the choice is written
+// to the private session's own map and nowhere else (Dk21).
+bool IsSiteDarkened(content::WebContents* contents);
+void SetSiteDarkened(content::WebContents* contents, bool darkened);
+
+// Dk12, Dk20: the list Settings shows for `mode`, sorted by name: the original
+// profile's entries that keep a site light (kAllExcept) or darken it
+// (kOnlyThese).
+std::vector<ContentSettingsPattern> GetDarkPagesSites(Profile* profile,
+                                                      DarkPagesMode mode);
+
+// Dk12: puts `pattern` on `mode`'s list, which takes it off the other one.
+void AddDarkPagesSite(Profile* profile,
+                      DarkPagesMode mode,
+                      const ContentSettingsPattern& pattern);
+void RemoveDarkPagesSite(Profile* profile,
+                         const ContentSettingsPattern& pattern);
+
+// Dk8: whether Blink's dark mode inverts a background of `color`: its
+// brightness, (299 R + 587 G + 114 B) / 1000, is above 205, the threshold of
+// Blink's background classifier (kDefaultBackgroundBrightnessThreshold in
+// dark_mode_settings_builder.cc, InvertHighBrightnessColorsClassifier in
+// dark_mode_color_classifier.cc). A mid-tone such as #4285f4 (126) is kept.
+inline constexpr int kBlinkBackgroundBrightnessThreshold = 205;
+bool BlinkDarkensBackground(SkColor color);
+
+// Dk8: `color` with its CIELAB lightness inverted the way Blink's dark mode
+// inverts a page's colours (L' = min(110 - L, 100), hue kept), and Blink's
+// near-black greys pulled to kDarkPagesCanvas, so white gives #121212.
+SkColor DarkenLikeBlink(SkColor color);
+
+// Dk8: the colour the browser's own frame takes from a colour declared for a
+// page, its `theme-color` or an app's manifest colour, which Blink's dark
+// mode leaves as it is. While dark pages darkens the page, one Blink would
+// invert as a background is inverted the way Blink inverts the page, so a
+// light colour never gives a light bar over a dark page; a mid-tone, a dark
+// one, or any over a page that is not darkened, is used as declared. The
+// address row (toolbar T3) and an app window's title bar (web apps Wa9) both
+// take their colour through it.
+SkColor ThemeColorUnderDarkPages(SkColor theme_color, bool page_darkened);
+
+// Runs `on_change` whenever what dark pages does to `profile`'s pages may
+// have changed: the switch, the mode or an entry of a list (Dk6, Dk14). The
+// switch is watched on the original profile; the content setting on
+// `profile`'s own map, which for a private window also reports the normal
+// profile's entries it inherits.
+class DarkPagesWatcher : public content_settings::Observer {
+ public:
+  DarkPagesWatcher(Profile* profile, base::RepeatingClosure on_change);
+  DarkPagesWatcher(const DarkPagesWatcher&) = delete;
+  DarkPagesWatcher& operator=(const DarkPagesWatcher&) = delete;
+  ~DarkPagesWatcher() override;
+
+  // content_settings::Observer:
+  void OnContentSettingChanged(
+      const ContentSettingsPattern& primary_pattern,
+      const ContentSettingsPattern& secondary_pattern,
+      ContentSettingsTypeSet content_type_set) override;
+
+ private:
+  PrefChangeRegistrar registrar_;
+  base::ScopedObservation<HostContentSettingsMap, content_settings::Observer>
+      settings_{this};
+  base::RepeatingClosure on_change_;
+};
+
+// Dk14: keeps an open tab's page in step with the lists. Web preferences are
+// recomputed for a switch change by Chromium's PrefWatcher already; a list
+// entry or a mode change reaches only the tabs whose site it names, and only
+// when the decision for the page changes, with no reload.
+//
+// Dk7: it also decides for a page about to commit. Chromium recomputes a
+// tab's web preferences only once a navigation has finished, so a page that
+// crosses a decision (the new tab page to a website, or a site kept light to
+// one that is darkened) would be created, and paint its first frame, with the
+// page before's. From ReadyToCommitNavigation the page being committed is the
+// one dark pages decides for (DarkPagesUrlFor), and the new decision is sent
+// before the commit, to the coming page's renderer as well.
+class DarkPagesTabHelper
+    : public content::WebContentsUserData<DarkPagesTabHelper>,
+      public content::WebContentsObserver,
+      public content_settings::Observer {
+ public:
+  DarkPagesTabHelper(const DarkPagesTabHelper&) = delete;
+  DarkPagesTabHelper& operator=(const DarkPagesTabHelper&) = delete;
+  ~DarkPagesTabHelper() override;
+
+  // Dk7: the address of the primary page being committed, from
+  // ReadyToCommitNavigation until that navigation finishes; null otherwise.
+  const GURL* committing_url() const {
+    return committing_url_ ? &*committing_url_ : nullptr;
+  }
+
+  // content::WebContentsObserver:
+  void ReadyToCommitNavigation(content::NavigationHandle* navigation) override;
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+
+  // content_settings::Observer:
+  void OnContentSettingChanged(
+      const ContentSettingsPattern& primary_pattern,
+      const ContentSettingsPattern& secondary_pattern,
+      ContentSettingsTypeSet content_type_set) override;
+
+ private:
+  friend class content::WebContentsUserData<DarkPagesTabHelper>;
+  explicit DarkPagesTabHelper(content::WebContents* contents);
+
+  void UpdateWebPreferences();
+
+  base::ScopedObservation<HostContentSettingsMap, content_settings::Observer>
+      settings_{this};
+  bool update_pending_ = false;
+  // Dk7: the navigation committing_url_ belongs to.
+  std::optional<GURL> committing_url_;
+  int64_t committing_navigation_id_ = 0;
+  base::WeakPtrFactory<DarkPagesTabHelper> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_DARK_PAGES_H_
