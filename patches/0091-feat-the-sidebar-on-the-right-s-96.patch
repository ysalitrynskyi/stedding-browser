+// sidebar Y34, commandbar K35: the actions list one row that moves the
+// sidebar to the window's other edge, named by that edge; running it sets the
+// side for the profile, and the row then names the way back. Horizontal tabs
+// have no sidebar and no row.
+TEST_F(CommandBarViewTest, SidebarSideActionsSetThePosition) {
+  // The row runs a browser command, and the browser's command controller
+  // runs none in a window without a tab: the test browser starts with none.
+  chrome::BrowserCommandController* const commands =
+      chrome::BrowserCommandController::From(browser());
+  ASSERT_TRUE(commands);
+  AddTab(browser(), GURL("https://example.com/"));
+  commands->TabStateChanged();
+  PrefService* const pref_service = profile()->GetPrefs();
+  pref_service->SetBoolean(::prefs::kVerticalTabsEnabled, true);
+  const tabs::VerticalTabStripStateController* const strip =
+      tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(strip && strip->ShouldDisplayVerticalTabs());
+  ASSERT_FALSE(pref_service->GetBoolean(stedding::prefs::kSidebarOnRight))
+      << "the left, by default, left to right";
+  // The rows that move the sidebar, by title, in the order listed.
+  const auto side_rows = [&](CommandBarView& bar) {
+    std::vector<std::u16string> titles;
+    for (size_t i = 0; i < bar.row_count_for_testing(); ++i) {
+      if (bar.row_title_for_testing(i).starts_with(u"Move Sidebar")) {
+        titles.push_back(bar.row_title_for_testing(i));
+      }
+    }
+    return titles;
+  };
+  // Runs the row named `title`, which must be listed.
+  const auto run = [&](const std::u16string& title) {
+    auto bar = std::make_unique<CommandBarView>(browser());
+    bar->SetModeForTesting(CommandBarView::Mode::kActions);
+    bar->PrefillForTesting(title);
+    for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+      if (bar->row_title_for_testing(i) == title) {
+        Down(*bar, static_cast<int>(i));
+        EXPECT_TRUE(Enter(*bar));
+        // The bar runs a row's command after it closes, in a posted task.
+        base::RunLoop().RunUntilIdle();
+        return;
+      }
+    }
+    ADD_FAILURE() << "no row " << base::UTF16ToUTF8(title);
+  };
+
+  auto bar = std::make_unique<CommandBarView>(browser());
+  bar->SetModeForTesting(CommandBarView::Mode::kActions);
+  bar->PrefillForTesting(u"Move Sidebar");
+  EXPECT_EQ(std::vector<std::u16string>{u"Move Sidebar to the Right"},
+            side_rows(*bar));
+  run(u"Move Sidebar to the Right");
+  EXPECT_TRUE(pref_service->GetBoolean(stedding::prefs::kSidebarOnRight));
+
+  bar = std::make_unique<CommandBarView>(browser());
+  bar->SetModeForTesting(CommandBarView::Mode::kActions);
+  bar->PrefillForTesting(u"Move Sidebar");
+  EXPECT_EQ(std::vector<std::u16string>{u"Move Sidebar to the Left"},
+            side_rows(*bar));
+  run(u"Move Sidebar to the Left");
+  EXPECT_FALSE(pref_service->GetBoolean(stedding::prefs::kSidebarOnRight));
+
+  pref_service->SetBoolean(::prefs::kVerticalTabsEnabled, false);
+  ASSERT_FALSE(strip->ShouldDisplayVerticalTabs());
+  bar = std::make_unique<CommandBarView>(browser());
+  bar->SetModeForTesting(CommandBarView::Mode::kActions);
+  bar->PrefillForTesting(u"Move Sidebar");
+  EXPECT_TRUE(side_rows(*bar).empty()) << "no sidebar, no row";
+}
