+      << "the keys switched to another Space";
+
+#if BUILDFLAG(IS_MAC)
+  constexpr int kReorder = ui::EF_COMMAND_DOWN;
+#else
+  constexpr int kReorder = ui::EF_CONTROL_DOWN;
+#endif
+  EXPECT_TRUE(tab->OnKeyPressed(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_RIGHT, kReorder)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, tab_strip_model()->GetIndexOfTab(last_of_one))
+      << "the tab moved past tabs it cannot see";
+  EXPECT_EQ(ids_[0], model()->SpaceForTab(last_of_one));
+  EXPECT_EQ(ids_[0], model()->active_id());
+}
