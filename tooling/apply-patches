#!/usr/bin/env bash
# Apply the Stedding patch series onto the pinned Chromium checkout.
#
# Usage:
#   tooling/apply-patches            # reset to the pin, then apply the whole series
#   tooling/apply-patches --check    # verify the series applies; leave the tree as found
#   tooling/apply-patches --force    # rebuild the branch even if it holds unexported work
#
# docs/ARCHITECTURE.md: "Applying patches by hand is a bug in the tooling." This is
# the only supported way to get a patched tree.
#
# The series is applied as real commits on a working branch, so that:
#   * a conflict stops at the offending patch and names it,
#   * tooling/update-patches can regenerate the series from the same branch,
#   * `git log` on the branch is the patch series.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

add_depot_tools_to_path

CHECK_ONLY=0
FORCE=0
for arg in "$@"; do
  case "$arg" in
    --check)   CHECK_ONLY=1 ;;
    --force)   FORCE=1 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *)         die "unknown argument: $arg" ;;
  esac
done

PATCH_DIR="$STEDDING_ROOT/patches"
WORK_BRANCH="stedding-work"

[ -d "$CHROMIUM_SRC/.git" ] || die "no checkout at $CHROMIUM_SRC — run tooling/sync-chromium"

cd "$CHROMIUM_SRC" || die "cannot enter $CHROMIUM_SRC"

git rev-parse -q --verify "refs/tags/$CHROMIUM_TAG" >/dev/null \
  || die "pin $CHROMIUM_TAG is not in the checkout — run tooling/sync-chromium"

# bash 3.2 is what macOS ships, so no mapfile.
PATCHES=()
while IFS= read -r p; do
  PATCHES+=("$p")
done < <(find "$PATCH_DIR" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.patch' 2>/dev/null | sort)

PATCH_COUNT=${#PATCHES[@]}
if [ "$PATCH_COUNT" -eq 0 ]; then
  log "no patches in $PATCH_DIR — a vanilla tree is the whole series"
  # An empty series is a valid series: --check passes, and applying it means putting
  # the tree on the pin and stopping there. Note that bash 3.2 with `set -u` treats
  # "${empty[@]}" as an unbound variable, so no expansion below may be unguarded.
fi

if [ "$CHECK_ONLY" -eq 1 ]; then
  log "checking $PATCH_COUNT patch(es) against $CHROMIUM_TAG"
  [ "$PATCH_COUNT" -eq 0 ] && { log "series applies cleanly"; exit 0; }

  # The series is cumulative: patch 3 may depend on patch 2, and may conflict with it.
  # Checking each one against the bare pin answers the wrong question in both
  # directions. So apply them in order into a temporary index — `git apply --cached`
  # never touches the working tree, so this is safe to run while a build is using the
  # checkout, and costs nothing compared to a second worktree.
  tmp_index="$(mktemp -t stedding-index.XXXXXX)"
  rm -f "$tmp_index"
  # shellcheck disable=SC2064  # expand $tmp_index now, not at trap time
  trap "rm -f '$tmp_index'" EXIT

  GIT_INDEX_FILE="$tmp_index" git read-tree "refs/tags/$CHROMIUM_TAG^{tree}" \
    || die "cannot read the tree for $CHROMIUM_TAG"

  failed=0
  for p in "${PATCHES[@]}"; do
    if GIT_INDEX_FILE="$tmp_index" git apply --cached "$p" 2>/dev/null; then
      printf '  ok   %s\n' "$(basename "$p")"
    else
      printf '  FAIL %s\n' "$(basename "$p")"
      failed=$(( failed + 1 ))
      # Keep going: reporting every broken patch beats reporting the first one.
    fi
  done
  [ "$failed" -eq 0 ] || die "$failed patch(es) do not apply cleanly onto $CHROMIUM_TAG"
  log "series applies cleanly"
  exit 0
fi

if ! git diff-index --quiet HEAD -- 2>/dev/null; then
  die "working tree at $CHROMIUM_SRC has uncommitted changes. Commit them onto
     $WORK_BRANCH and run tooling/update-patches, or discard them, before re-applying."
fi

# Applying the series recreates $WORK_BRANCH from scratch, so anything on that branch
# which is not in patches/ would be destroyed. Comparing commit counts is not enough:
# `git commit --amend` and `git rebase` change the work without changing the count.
#
# Instead, apply-patches and update-patches both stamp refs/stedding/applied with the
# commit the branch was last known to match the exported series at. If the branch has
# moved since, there is work here that patches/ does not contain.
APPLIED_REF="refs/stedding/applied"
if git rev-parse -q --verify "refs/heads/$WORK_BRANCH" >/dev/null && [ "$FORCE" -eq 0 ]; then
  branch_tip="$(git rev-parse "refs/heads/$WORK_BRANCH")"
  stamped="$(git rev-parse -q --verify "$APPLIED_REF" 2>/dev/null || echo none)"
  above="$(git rev-list --count "refs/tags/$CHROMIUM_TAG..refs/heads/$WORK_BRANCH" 2>/dev/null || echo 0)"
  if [ "$above" -gt 0 ] && [ "$branch_tip" != "$stamped" ]; then
    die "$WORK_BRANCH is at $(git rev-parse --short "$branch_tip") with $above commit(s)
     above the pin, which is not where the exported series left it. Something here —
     a new commit, an amend, a rebase — is not in patches/ and would be destroyed.

     Export it first:   tooling/update-patches
     Or discard it:     tooling/apply-patches --force"
  fi
fi

log "resetting to $CHROMIUM_TAG on branch $WORK_BRANCH"
git checkout -q --detach "refs/tags/$CHROMIUM_TAG"
git branch -qD "$WORK_BRANCH" 2>/dev/null || true
git checkout -q -b "$WORK_BRANCH"

# Guarded by count: bash 3.2 under `set -u` errors on "${empty[@]}", and $PATCH_COUNT
# being the string "0" is not empty, so ${var:+...} does not help here.
if [ "$PATCH_COUNT" -gt 0 ]; then
for p in "${PATCHES[@]}"; do
  name="$(basename "$p")"
  log "applying $name"
  if ! git am --3way --keep-non-patch "$p"; then
    git am --abort 2>/dev/null || true
    die "patch $name does not apply to $CHROMIUM_TAG.
     Fix the patch, not the tree: re-apply the series up to the previous patch, make
     the change as a commit, then run tooling/update-patches."
  fi
done
fi

# Record where the exported series leaves the branch, so the next run can tell
# "unchanged since export" from "somebody did work here".
git update-ref "$APPLIED_REF" HEAD

log "applied $PATCH_COUNT patch(es) onto $CHROMIUM_TAG"
log "branch: $WORK_BRANCH at $(git rev-parse --short HEAD)"
