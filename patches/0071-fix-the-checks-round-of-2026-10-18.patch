+      field.value = 'Office';
+      field.dispatchEvent(new Event('change'));
+      return '';)"));
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return model->DisplayName(work) == u"Office"; }));
+  }
+  {
+    SCOPED_TRACE("the switch makes a Space with no pages independent");
+    ASSERT_FALSE(model->SpaceIsIsolated(play));
+    EXPECT_EQ("", on_row(play, R"(
+      pick('cr-toggle.space-isolated[data-id="' + $1 + '"]').click();
+      return '';)"));
+    EXPECT_TRUE(
+        base::test::RunUntil([&]() { return model->SpaceIsIsolated(play); }));
+  }
+  {
+    // Every bin asks first (BACKLOG S-148); the question and its answers are
+    // SettingsSpacesTest.TheBinAsksBeforeDeletingASpace's. Down to the last
+    // Space through the model, for the step below.
+    model->RemoveSpace(home);
+    model->RemoveSpace(play);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return model->size() == 1u; }));
+  }
+  {
+    SCOPED_TRACE("the last Space's bin is disabled");
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(page, OnThePage(R"(
+        const bins = [];
+        const walk = root => {
+          for (const element of root.querySelectorAll('*')) {
+            if (element.matches('cr-icon-button.icon-delete-gray')) {
+              bins.push(element);
+            }
+            if (element.shadowRoot) {
+              walk(element.shadowRoot);
