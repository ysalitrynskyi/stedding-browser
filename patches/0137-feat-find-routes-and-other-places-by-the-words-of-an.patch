new file mode 100644
index 0000000000000..ab3bf540aa8c6
--- /dev/null
+++ b/chrome/browser/ui/stedding/find_words_unittest.cc
@@ -0,0 +1,53 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/find_words.h"
+
+#include <string>
+#include <string_view>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+// The words of the row titled `title`.
+std::u16string_view WordsOf(std::u16string_view title) {
+  for (const FindWords& place : FindWordsTable()) {
+    if (place.title == title) {
+      return place.words;
+    }
+  }
+  return std::u16string_view();
+}
+
+// settings T58, commandbar K39: the words the owner named are in the table,
+// and they stay search terms: no Stedding name takes one.
+TEST(FindWordsTest, TheTableHoldsTheWordsAndNoLabelDoes) {
+  const std::u16string_view routes = WordsOf(u"Sites Routed to Spaces");
+  for (std::u16string_view word : {u"air", u"traffic", u"control", u"routes"}) {
+    EXPECT_NE(std::u16string_view::npos, routes.find(word));
+  }
+  EXPECT_NE(std::u16string_view::npos,
+            WordsOf(u"Independent Sessions").find(u"profile"));
+  EXPECT_NE(std::u16string_view::npos,
+            WordsOf(u"Essentials per Row").find(u"favorites"));
+  EXPECT_EQ(u"little arc", WordsOf(u"Little Windows"));
+  for (const FindWords& place : FindWordsTable()) {
+    const std::u16string title =
+        base::StrCat({u" ", base::ToLowerASCII(place.title), u" "});
+    for (const char16_t* word : {u" arc ", u" traffic ", u" profile "}) {
+      EXPECT_EQ(std::u16string::npos, title.find(word))
+          << base::UTF16ToUTF8(title);
+    }
+    EXPECT_FALSE(place.card.empty());
+    EXPECT_EQ(std::u16string_view::npos, place.words.find(u"boost"));
+  }
+}
+
+}  // namespace
+}  // namespace stedding
