+
+// The command bar in a real window: the focus the window gives back once it
+// is the active window again after the bar closed with it (commandbar K1),
+// and the Space a search typed in the bar goes to (routing D11).
+
+#include <memory>
+#include <string>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/run_until.h"
