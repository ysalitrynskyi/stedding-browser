@@ -580,10 +582,35 @@ bool PeekOverlay::Show() {
     return true;
   }
   view_->UpdateSplit(CanSplit());
+  // O10: the card comes in, unless motion is off (O1).
+  if (ShouldAnimate(
+          Profile::FromBrowserContext(page_->GetBrowserContext())->GetPrefs())) {
+    opacity_ = 0.0f;
+    widget_->SetOpacity(opacity_);
+    appear_ = std::make_unique<gfx::LinearAnimation>(
+        base::Milliseconds(kAppearMs), gfx::LinearAnimation::kDefaultFrameRate,
+        this);
+    appear_->Start();
+  }
   page_->Focus();
   return true;
 }
 
+void PeekOverlay::AnimationProgressed(const gfx::Animation* animation) {
+  opacity_ = static_cast<float>(gfx::Tween::CalculateValue(
+      gfx::Tween::EASE_OUT, animation->GetCurrentValue()));
+  if (widget_) {
+    widget_->SetOpacity(opacity_);
+  }
+}
+
+void PeekOverlay::AnimationEnded(const gfx::Animation* animation) {
+  opacity_ = 1.0f;
+  if (widget_) {
+    widget_->SetOpacity(opacity_);
+  }
+}
