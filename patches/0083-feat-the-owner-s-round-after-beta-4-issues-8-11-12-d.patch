+// A test clipboard that remembers the privacy flags of the last write, which
+// TestClipboard itself drops (as in copy_link_unittest.cc): a private
+// window's copy asks to stay out of the clipboard history and the cloud
+// clipboard (copy-link L3, L7).
+class RecordingClipboard : public ui::TestClipboard {
+ public:
+  void WritePortableAndPlatformRepresentations(
+      ui::ClipboardBuffer buffer,
+      const ObjectMap& objects,
+      const std::vector<RawData>& raw_objects,
+      std::vector<PlatformRepresentation> platform_representations,
+      std::unique_ptr<ui::DataTransferEndpoint> data_src,
+      uint32_t privacy_types) override {
+    last_privacy_types_ = privacy_types;
+    ui::TestClipboard::WritePortableAndPlatformRepresentations(
+        buffer, objects, raw_objects, std::move(platform_representations),
+        std::move(data_src), privacy_types);
+  }
+
+  // What ui::ScopedClipboardWriter::MarkAsOffTheRecord() asks of the last
+  // write.
+  bool last_write_off_the_record() const {
+    constexpr uint32_t kOffTheRecord =
+        ui::Clipboard::PrivacyTypes::kNoLocalClipboardHistory |
+        ui::Clipboard::PrivacyTypes::kNoCloudClipboard;
+    return (last_privacy_types_ & kOffTheRecord) == kOffTheRecord;
+  }
+
+ private:
+  uint32_t last_privacy_types_ = 0;
+};
