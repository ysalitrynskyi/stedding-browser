+class PinsEveryWindowTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpInProcessBrowserTestFixture() override {
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::SetUpInProcessBrowserTestFixture();
+    // windows G19: the step before the first launch is a version without the
+    // store, whose windows each keep their own pins.
+    const std::string name =
+        testing::UnitTest::GetInstance()->current_test_info()->name();
+    spaces::PinMirror::SetDisabledForTesting(
+        base::StartsWith(name, "PRE_TheFirstLaunch"));
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  void TearDownOnMainThread() override {
+    spaces::PinMirror::SetTabDragForTesting(false);
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  static spaces::SpaceModel& Model(BrowserWindowInterface* window) {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+    CHECK(model);
+    return *model;
+  }
+
+  spaces::PinStore& Store() {
+    spaces::PinStore* const store =
+        spaces::PinStoreFactory::GetForProfile(browser()->GetProfile());
+    CHECK(store);
+    return *store;
+  }
+
+  // The window's Space pins, in the strip's order.
+  static std::vector<tabs::TabInterface*> Pins(BrowserWindowInterface* window) {
+    std::vector<tabs::TabInterface*> pins;
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      if (Model(window).IsSpacePinned(strip->GetTabAtIndex(i))) {
+        pins.push_back(strip->GetTabAtIndex(i));
+      }
+    }
+    return pins;
+  }
+
+  static std::vector<tabs::TabInterface*> Essentials(
+      BrowserWindowInterface* window) {
+    std::vector<tabs::TabInterface*> essentials;
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      if (strip->GetTabAtIndex(i)->IsPinned()) {
+        essentials.push_back(strip->GetTabAtIndex(i));
+      }
+    }
+    return essentials;
+  }
+
+  static std::vector<GURL> HomesOf(BrowserWindowInterface* window,
+                                   const std::vector<tabs::TabInterface*>& tabs) {
+    std::vector<GURL> homes;
+    for (tabs::TabInterface* tab : tabs) {
+      homes.push_back(Model(window).HomeUrl(tab).value_or(GURL()));
+    }
+    return homes;
+  }
+
+  static std::string Token(tabs::TabInterface* tab) {
+    return stedding::TabToken(tab->GetContents());
+  }
+
+  // A page opened in `window` and made a Space pin there.
+  tabs::TabInterface* PinPage(BrowserWindowInterface* window, const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        window, url, WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const tab = window->GetTabStripModel()->GetActiveTab();
+    Model(window).SetSpacePinned(tab, true);
+    base::RunLoop().RunUntilIdle();
+    return tab;
+  }
+
+  // A page opened in `window` and made an essential there.
+  tabs::TabInterface* PinEssential(BrowserWindowInterface* window,
+                                   const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        window, url, WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    TabStripModel* const strip = window->GetTabStripModel();
+    tabs::TabInterface* const tab = strip->GetActiveTab();
+    strip->SetTabPinned(strip->GetIndexOfTab(tab), true);
+    base::RunLoop().RunUntilIdle();
+    return tab;
+  }
+
+  BrowserWindowInterface* OpenWindow() {
+    ui_test_utils::BrowserCreatedObserver opened;
+    chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+    BrowserWindowInterface* const window = opened.Wait();
+    EXPECT_TRUE(window);
+    base::RunLoop().RunUntilIdle();
+    return window;
+  }
+
+  static std::vector<BrowserWindowInterface*> Windows(Profile* profile) {
+    std::vector<BrowserWindowInterface*> windows =
+        spaces::sidebar_sync::RegistryWindows(profile);
+    std::ranges::sort(windows, [](BrowserWindowInterface* a,
+                                  BrowserWindowInterface* b) {
+      return a->GetSessionID().id() < b->GetSessionID().id();
+    });
+    return windows;
+  }
+
+  GURL Page(const char* path) { return embedded_test_server()->GetURL(path); }
+
+  // The tab of `window` whose token is `id`, or null.
+  static tabs::TabInterface* TabOf(BrowserWindowInterface* window,
+                                   const std::string& id) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      if (Token(strip->GetTabAtIndex(i)) == id) {
+        return strip->GetTabAtIndex(i);
+      }
+    }
+    return nullptr;
+  }
+
+  // The paths of `window`'s tabs that are neither pins nor essentials.
+  static std::set<std::string> LoosePaths(BrowserWindowInterface* window) {
+    std::set<std::string> paths;
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      if (!tab->IsPinned() && !Model(window).IsSpacePinned(tab)) {
+        paths.insert(std::string(tab->GetContents()->GetVisibleURL().path()));
+      }
+    }
+    return paths;
+  }
+
+  // Runs the tasks of `delay`, as several turns of a drag's move loop do.
+  static void RunFor(base::TimeDelta delay) {
+    base::RunLoop loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, loop.QuitClosure(), delay);
+    loop.Run();
+  }
+
+  // As a tab drag tears a tab off: a window made with no tab, and the tab
+  // moved into it.
+  BrowserWindowInterface* TearOff(tabs::TabInterface* tab) {
+    BrowserWindowInterface* const torn = CreateBrowserWindow(
+        BrowserWindowCreateParams(browser()->GetProfile(),
+                                  /*from_user_gesture=*/true));
+    TabStripModel* const strip = browser()->GetTabStripModel();
+    chrome::MoveTabsToExistingWindow(browser(), torn,
+                                     {strip->GetIndexOfTab(tab)});
+    torn->GetWindow()->Show();
+    return torn;
+  }
+
+  // The folder `tab` is right in, or null.
+  static const tabs::FolderTabCollection* FolderOf(tabs::TabInterface* tab) {
+    const tabs::TabCollection* const parent = tab->GetParentCollection();
+    return parent && parent->type() == tabs::TabCollection::Type::FOLDER
+               ? static_cast<const tabs::FolderTabCollection*>(parent)
+               : nullptr;
+  }
+
+  // The folder a test syncs through. It stays until the test ends: a write
+  // to it may still be under way.
+  base::ScopedTempDir shared_;
+};
+
+// windows G2, G16, G22: a new window has every pin and essential, under the
+// same ids, asleep: no renderer until chosen there.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest,
+                       ANewWindowHasEveryPinAndEssential) {
+  tabs::TabInterface* const pin = PinPage(browser(), Page("/title1.html"));
+  tabs::TabInterface* const essential =
+      PinEssential(browser(), Page("/title2.html"));
+  ASSERT_EQ(2u, Store().records().size());
+
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Pins(second).size() == 1u && Essentials(second).size() == 1u;
+  })) << "the new window lacks the first window's pin or essential";
+  tabs::TabInterface* const pin_there = Pins(second).front();
+  tabs::TabInterface* const essential_there = Essentials(second).front();
+  EXPECT_EQ(Token(pin), Token(pin_there));
+  EXPECT_EQ(Token(essential), Token(essential_there));
+  EXPECT_EQ(Page("/title1.html"),
+            Model(second).HomeUrl(pin_there).value_or(GURL()));
+  EXPECT_EQ(Page("/title2.html"),
+            Model(second).HomeUrl(essential_there).value_or(GURL()));
+  EXPECT_EQ(Model(browser()).FindSpaceForTab(pin),
+            Model(second).FindSpaceForTab(pin_there));
+  // G22: asleep, with no page loaded.
+  EXPECT_TRUE(pin_there->GetContents()->WasDiscarded());
+  EXPECT_TRUE(essential_there->GetContents()->WasDiscarded());
+  // Still one record each.
+  EXPECT_EQ(2u, Store().records().size());
+}
