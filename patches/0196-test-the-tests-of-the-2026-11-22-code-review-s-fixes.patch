+  tabs::TabInterface* const routed = OpenTab(GURL("https://github.com/x"));
+  tabs::TabInterface* const kept = OpenTab(GURL("https://example.com/"));
+  std::vector<int> indices = {IndexOf(routed), IndexOf(kept)};
+  std::ranges::sort(indices);
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(indices);
+  ASSERT_TRUE(folder);
+  tabs().ActivateTabAt(IndexOf(kept));
+  ASSERT_EQ(home, model().SpaceForTab(routed));
+
+  int command = -1;
+  for (size_t i = 0; i < model().spaces().size(); ++i) {
+    if (model().spaces()[i]->id() == work) {
+      command = TabStripModel::CommandSteddingRouteToSpaceFirst +
