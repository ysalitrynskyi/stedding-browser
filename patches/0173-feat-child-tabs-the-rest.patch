+// R60: the fold is in what a restart reads.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, PRE_TheFoldComesBackAfterARestart) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  ASSERT_TRUE(OpenLinkFrom(page, "b.test"));
+  stedding::SetChildrenFolded(page, true);
+  base::RunLoop().RunUntilIdle();
+}
+
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, TheFoldComesBackAfterARestart) {
+  TabStripModel* strip = nullptr;
+  tabs::TabInterface* page = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    for (BrowserWindowInterface* const window :
+         GetAllBrowserWindowInterfaces()) {
+      TabStripModel* const tabs = window->GetTabStripModel();
+      for (int i = 0; i < tabs->count(); ++i) {
+        if (stedding::ChildrenFolded(tabs->GetWebContentsAt(i))) {
+          strip = tabs;
+          page = tabs->GetTabAtIndex(i);
+        }
+      }
+    }
+    return page != nullptr;
+  })) << "the fold did not come back";
+  strip->ActivateTabAt(strip->GetIndexOfTab(page));
+  bool child_hidden = false;
+  for (int i = 0; i < strip->count(); ++i) {
+    child_hidden |=
+        stedding::TabParentToken(strip->GetWebContentsAt(i)) ==
+            stedding::TabToken(page->GetContents()) &&
+        strip->IsTabHidden(i);
+  }
+  EXPECT_TRUE(child_hidden);
+}
