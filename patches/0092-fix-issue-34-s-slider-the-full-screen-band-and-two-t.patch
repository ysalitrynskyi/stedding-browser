+// toolbar T8: a row that hides with the collapsed sidebar stays in full
+// screen. macOS's full-screen title bar takes the top strip's height, and with
+// the row hidden it stayed as tall as the row: an empty grey band over the
+// page (the owner's screenshot, 2026-10-25). Out of full screen it hides again.
+IN_PROC_BROWSER_TEST_F(WindowButtonsTest,
+                       FullScreenKeepsTheRowThatHidesWithTheSidebar) {
+  ui::test::ScopedFakeNSWindowFullscreen fake_fullscreen;
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      stedding::prefs::kToolbarHideWithSidebar, true);
+  tabs::VerticalTabStripStateController* const sidebar =
+      tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(sidebar);
+  sidebar->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&] { return sidebar->IsCollapsed(); }));
+  views::test::RunScheduledLayout(browser_view->GetWidget());
+  ASSERT_FALSE(browser_view->IsToolbarVisible());
+
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    views::test::RunScheduledLayout(browser_view->GetWidget());
+    return browser_view->GetWidget()->IsFullscreen();
+  }));
+  views::test::RunScheduledLayout(browser_view->GetWidget());
+  EXPECT_TRUE(browser_view->IsToolbarVisible())
+      << "the full-screen title bar keeps the row's height: an empty band";
+  EXPECT_FALSE(browser_view->top_container()->bounds().IsEmpty());
+
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    views::test::RunScheduledLayout(browser_view->GetWidget());
+    return !browser_view->GetWidget()->IsFullscreen();
+  }));
+  views::test::RunScheduledLayout(browser_view->GetWidget());
+  EXPECT_FALSE(browser_view->IsToolbarVisible());
+}
