+// site-controls Si1: a tab of a normal window, a private window and a Blank
+// Window get the controls; a popup, an app window and a little window keep
+// Chromium's page info.
+IN_PROC_BROWSER_TEST_F(SiteControlsTest, OnlyTabbedWindowsGetTheControls) {
+  const GURL url = Url("site.test");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), url));
+  EXPECT_EQ(SiteControlsWindow::kTab, stedding::SiteControlsWindowFor(page()));
+
+  const auto window_of = [&](BrowserWindowInterface* window) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(window, url));
+    return stedding::SiteControlsWindowFor(
+        window->GetTabStripModel()->GetActiveWebContents());
+  };
+  EXPECT_EQ(SiteControlsWindow::kPrivateTab,
+            window_of(CreateIncognitoBrowser()));
+  {
+    ui_test_utils::BrowserCreatedObserver opened;
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_NEW_BLANK_WINDOW);
+    BrowserWindowInterface* const blank = opened.Wait();
+    ASSERT_TRUE(blank);
+    EXPECT_EQ(SiteControlsWindow::kTabWithoutSpaces, window_of(blank));
+  }
+  EXPECT_EQ(SiteControlsWindow::kOther,
+            window_of(CreateBrowserForPopup(browser()->GetProfile())));
+  EXPECT_EQ(SiteControlsWindow::kOther,
+            window_of(CreateBrowserForApp("stedding_test_app",
+                                          browser()->GetProfile())));
+  BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+      browser()->GetProfile(), url, browser(), /*untrusted_launch=*/false);
+  ASSERT_TRUE(little);
+  ASSERT_TRUE(stedding::IsLittleWindow(little));
+  content::WebContents* little_page = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    little_page = little->GetTabStripModel()->GetActiveWebContents();
+    return little_page != nullptr;
+  }));
+  ASSERT_TRUE(content::WaitForLoadStop(little_page));
+  EXPECT_EQ(SiteControlsWindow::kOther,
+            stedding::SiteControlsWindowFor(little_page));
+
+  {
+    SCOPED_TRACE("a private window's panel");
+    BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(incognito, url));
+    views::BubbleDialogDelegateView* const panel = OpenFromTheChip(incognito);
+    ASSERT_TRUE(panel);
+    EXPECT_TRUE(Strip(panel));
+    SiteControlsRowsView* const rows = Rows(panel);
+    ASSERT_TRUE(rows);
+    EXPECT_FALSE(rows->session_row()->GetVisible())
+        << "a private window has no session row (sessions S32)";
+    EXPECT_TRUE(rows->clear_data()->GetVisible());
+    ClosePanel();
+  }
+}
