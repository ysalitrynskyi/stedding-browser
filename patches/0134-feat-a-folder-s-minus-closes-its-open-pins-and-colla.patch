+// folders F45, pins H3: a page that can ask "Leave site?" asks first. Stay
+// keeps that pin awake and the folder open, the other pin asleep. A second
+// press asks again, and Leave sleeps it and collapses the folder.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, TheMinusAsksLeaveSiteFirst) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  CloseDownToOne();
+  tabs::TabInterface* const asks = OpenPin("a.test");
+  content::WebContents* const page = asks->GetContents();
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.stay = (e) => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+  content::PrepContentsForBeforeUnloadTest(page);
+  tabs::TabInterface* const quiet = OpenPin("b.test");
+  tabs::FolderTabCollection* const folder = FolderOf({asks, quiet});
+  ASSERT_TRUE(folder);
+  OpenLoaded("c.test");
+  tab_strip_model()->ActivateTabAt(IndexOf(asks));
+
+  ASSERT_TRUE(PressMinus(folder));
+  javascript_dialogs::AppModalDialogController* dialog =
+      ui_test_utils::WaitForAppModalDialog();
+  ASSERT_TRUE(dialog);
+  ASSERT_TRUE(dialog->is_before_unload_dialog());
+  EXPECT_FALSE(folder->collapsed()) << "the folder did not wait for the answer";
+  dialog->view()->CancelAppModalDialog();  // Stay.
+  ASSERT_TRUE(WaitUntilAsleep(quiet));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(page->WasDiscarded()) << "Stay unloaded the pin";
+  EXPECT_EQ(asks, tab_strip_model()->GetActiveTab()) << "Stay left the pin";
+  EXPECT_FALSE(folder->collapsed()) << "Stay folded the page it kept";
+
+  ASSERT_TRUE(PressMinus(folder));
+  dialog = ui_test_utils::WaitForAppModalDialog();
+  ASSERT_TRUE(dialog);
+  dialog->view()->AcceptAppModalDialog();  // Leave.
+  ASSERT_TRUE(WaitUntilAsleep(asks));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return folder->collapsed(); }));
+  EXPECT_FALSE(DrawnRow(asks));
+}
