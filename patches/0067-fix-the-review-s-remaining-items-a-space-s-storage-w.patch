+
+#include "chrome/browser/ui/webui/stedding_archive/stedding_archive_handler.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/values.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/test_web_ui.h"
+#include "content/public/test/web_contents_tester.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+class TestArchiveHandler : public ArchiveHandler {
+ public:
+  using ArchiveHandler::set_web_ui;
+};
+
+class SteddingArchiveHandlerTest : public BrowserWithTestWindowTest {
+ protected:
+  void SetUp() override {
+    BrowserWithTestWindowTest::SetUp();
+    contents_ = content::WebContentsTester::CreateTestWebContents(
+        profile(), /*instance=*/nullptr);
+    web_ui_.set_web_contents(contents_.get());
+    handler_ = std::make_unique<TestArchiveHandler>();
+    handler_->set_web_ui(&web_ui_);
+    handler_->RegisterMessages();
+  }
+
+  void TearDown() override {
+    handler_.reset();
+    contents_.reset();
+    BrowserWithTestWindowTest::TearDown();
+  }
+
+  content::TestWebUI web_ui_;
+  std::unique_ptr<content::WebContents> contents_;
+  std::unique_ptr<TestArchiveHandler> handler_;
+};
+
+// A message of the wrong shape from chrome://stedding-archive is dropped: the
+// page is a renderer, and a CHECK on the count or a GetString() on a number
+// stopped the browser (BACKLOG S-188).
+TEST_F(SteddingArchiveHandlerTest, AMessageOfTheWrongShapeIsDropped) {
+  base::ListValue number;
+  number.Append(1);
+  web_ui_.HandleReceivedMessage("restoreArchivedTab", number);
+  web_ui_.HandleReceivedMessage("getArchivedTabs", number);
+  base::ListValue dict;
+  dict.Append(base::DictValue());
+  web_ui_.HandleReceivedMessage("removeArchivedTab", dict);
+  web_ui_.HandleReceivedMessage("getArchivedTabs", base::ListValue());
+  base::ListValue two;
+  two.Append("1");
+  two.Append("2");
+  web_ui_.HandleReceivedMessage("restoreArchivedTab", two);
+  EXPECT_TRUE(web_ui_.call_data().empty());
+}
