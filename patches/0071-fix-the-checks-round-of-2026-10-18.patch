+void RenameSpaceInDialog(BrowserWindowInterface* window, const SpaceId& id) {
+  SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+  ui::BaseWindow* const base_window = window ? window->GetWindow() : nullptr;
+  const Space* const space = model ? model->GetSpace(id) : nullptr;
+  if (!space || !base_window) {
+    return;
+  }
+  ui::DialogModel::Builder builder;
+  ui::DialogModel* const dialog = builder.model();
+  // The model may go with its window while the dialog is open: the answer
+  // looks the Space up again.
+  base::OnceClosure rename = base::BindOnce(
+      [](base::WeakPtr<SpaceModel> model, SpaceId id,
+         ui::DialogModel* dialog) {
+        const Space* const space = model ? model->GetSpace(id) : nullptr;
+        if (!space) {
+          return;
+        }
+        const std::string name = base::UTF16ToUTF8(
+            dialog->GetTextfieldByUniqueId(kSpaceNameFieldId)->text());
+        // An untouched name changes nothing, so nobody hears of a rename.
+        if (name != space->name()) {
+          model->SetSpaceName(id, name);
+        }
+      },
+      model->GetWeakPtr(), id, base::Unretained(dialog));
+  constrained_window::ShowBrowserModal(
+      builder.SetInternalName("SteddingRenameSpaceDialog")
+          // The Space by the name it goes by: an unnamed one's field is empty.
+          .SetTitle(u"Rename \u201C" + model->DisplayName(id) + u"\u201D")
+          .AddTextfield(kSpaceNameFieldId, std::u16string(),
+                        base::UTF8ToUTF16(space->name()),
+                        ui::DialogModelTextfield::Params().SetAccessibleName(
+                            u"Space name"))
+          .AddOkButton(std::move(rename),
+                       ui::DialogModel::Button::Params().SetLabel(u"Rename"))
+          .AddCancelButton(base::DoNothing())
+          .SetInitiallyFocusedField(kSpaceNameFieldId)
+          .Build(),
+      base_window->GetNativeWindow());
+}
+
+void DeleteSpaceAfterAsking(BrowserWindowInterface* window,
+                            const SpaceId& id) {
+  SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+  // The last Space stays: a window always has one (B5).
+  if (!model || !model->GetSpace(id) || model->size() <= 1) {
+    return;
+  }
+  const std::u16string name = model->DisplayName(id);
+  const bool isolated = model->SpaceIsIsolated(id);
+  const int here = model->CountTabsOf(id, /*every_window=*/false);
+  const int count = model->CountTabsOf(id, /*every_window=*/true);
+  // No tab closes: in this window they join the Space it shows next, and in
+  // another window the Space that one shows.
+  const std::u16string where =
+      count == here
+          ? base::StrCat({u"\u201C",
+                          model->DisplayName(model->SpaceTakingTabsOf(id)),
+                          u"\u201D"})
+          : std::u16string(u"the Space each window shows");
+  std::u16string body;
+  if (isolated) {
+    // PLAN.md SPC-20: an independent session's logins go with the Space.
+    body = u"The cookies, logins and site data this Space kept are erased. ";
+  }
+  if (count == 0) {
+    body += u"It has no open tabs.";
+  } else if (count == 1) {
+    body += base::StrCat({u"Its tab stays open and moves to ", where, u"."});
+  } else {
+    body += base::StrCat({u"Its ", base::NumberToString16(count),
+                          u" tabs stay open and move to ", where, u"."});
+  }
+  // The model may go with its window while the question is open, and the
+  // Space with another window's delete: the answer looks both up again.
+  ConfirmInWindow(
+      window,
+      isolated ? base::StrCat({u"Delete \u201C", name,
+                               u"\u201D and its independent session?"})
+               : base::StrCat({u"Delete \u201C", name, u"\u201D?"}),
+      std::move(body), u"Delete Space",
+      base::BindOnce(
+          [](base::WeakPtr<SpaceModel> model, SpaceId id) {
+            if (model) {
+              model->RemoveSpace(id);
+            }
+          },
+          model->GetWeakPtr(), id));
+}
+
 }  // namespace spaces
