+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_SHORTCUTS_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_SHORTCUTS_HANDLER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+
+namespace stedding {
+
+// One line of the shortcut reference (docs/features/shortcuts.md).
+struct ShortcutRow {
+  // The chord as the menus print it ("⇧⌘K"), read from the accelerator
+  // tables; never typed by hand (Z1).
+  std::u16string chord;
+  // What Stedding does on it.
+  std::u16string what;
+  // For a divergence row (Z2): what Chromium binds the chord to. Empty
+  // otherwise.
+  std::u16string chromium;
+};
+
+struct ShortcutGroup {
+  std::u16string title;
+  std::vector<ShortcutRow> rows;
+};
+
+// The reference: every Stedding chord, every Chromium chord Stedding rebinds,
+// and the Mission Control note (Z3). Chords come from the same tables the
+// menu bar reads, so the block cannot disagree with the keys.
+std::vector<ShortcutGroup> ShortcutReference();
+
+// The reference for the page: [{title, rows: [{chord, what, chromium}]}].
+base::ListValue ShortcutReferenceAsValue(
+    const std::vector<ShortcutGroup>& groups);
+
+}  // namespace stedding
+
+// chrome://settings/stedding's "Shortcuts" block: answers
+// steddingGetShortcuts with the reference.
+class SteddingShortcutsHandler : public settings::SettingsPageUIHandler {
+ public:
+  SteddingShortcutsHandler();
+  SteddingShortcutsHandler(const SteddingShortcutsHandler&) = delete;
+  SteddingShortcutsHandler& operator=(const SteddingShortcutsHandler&) = delete;
+  ~SteddingShortcutsHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override {}
+  void OnJavascriptDisallowed() override {}
+
+ private:
+  void HandleGetShortcuts(const base::ListValue& args);
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_SHORTCUTS_HANDLER_H_
