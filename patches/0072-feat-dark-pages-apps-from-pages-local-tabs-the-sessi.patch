@@ -89,5 +89,86 @@ TEST_F(RecentTabsSwitcherViewTest, ReleaseCommitsEscapeCancels) {
   EXPECT_FALSE(model().in_cycle());
 }
 
+// switcher X3 on Windows (BACKLOG S-228): the shell takes Ctrl+Esc for its
+// Start menu before the window hears it, and the browser sets no keyboard
+// hook to take it back, so a run there is backed out by stepping back to its
+// first tab with Ctrl+Shift+Tab (or on with Tab until it comes round) and
+// letting go of Ctrl. That leaves the recent order as it was before the run,
+// as Escape does: the steps of a run are not recorded as uses. Letting go on
+// the tab reached and tapping Ctrl+Tab also comes back to the first tab, but
+// the tab reached has been used by then and comes next in the order.
+TEST_F(RecentTabsSwitcherViewTest, SteppingBackToTheFirstTabIsLikeEscape) {
+  tabs::TabInterface* const a = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  ASSERT_EQ(c, tabs().GetActiveTab());
+  ASSERT_EQ((std::vector<tabs::TabInterface*>{c, b, a}),
+            model().RecentTabs(model().active_id()));
+
+  // Two steps on, then Shift held and two steps back.
+  ASSERT_TRUE(model().CycleRecent(1));
+  ASSERT_TRUE(model().CycleRecent(1));
+  EXPECT_EQ(a, tabs().GetActiveTab());
+  auto strip = std::make_unique<RecentTabsSwitcherView>(browser());
+  strip->Refresh();
+  EXPECT_EQ(2u, strip->highlighted_for_testing());
+  strip->OnKeyEventForTesting(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_SHIFT,
+                   ui::EF_CONTROL_DOWN | ui::EF_SHIFT_DOWN));
+  EXPECT_FALSE(strip->closing_for_testing())
+      << "Shift, pressed for Ctrl+Shift+Tab, ended the run";
+  ASSERT_TRUE(model().CycleRecent(-1));
+  strip->Refresh();
+  EXPECT_EQ(b, tabs().GetActiveTab());
+  ASSERT_TRUE(model().CycleRecent(-1));
+  strip->Refresh();
+  EXPECT_EQ(0u, strip->highlighted_for_testing());
+  EXPECT_EQ(c, tabs().GetActiveTab());
+  strip->OnKeyEventForTesting(ui::KeyEvent(
+      ui::EventType::kKeyReleased, ui::VKEY_SHIFT, ui::EF_CONTROL_DOWN));
+  EXPECT_FALSE(strip->closing_for_testing()) << "Shift let go ended the run";
+  strip->OnKeyEventForTesting(
+      ui::KeyEvent(ui::EventType::kKeyReleased, ui::VKEY_CONTROL, ui::EF_NONE));
+  EXPECT_TRUE(strip->closing_for_testing());
+  EXPECT_FALSE(model().in_cycle());
+  EXPECT_EQ(c, tabs().GetActiveTab());
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, b, a}),
+            model().RecentTabs(model().active_id()))
+      << "stepping back changed the recent order";
+
+  // Tab on past the last cell comes round to the first tab too. Had the
+  // steps counted as uses, the order would now be c, a, b.
+  ASSERT_TRUE(model().CycleRecent(1));
+  ASSERT_TRUE(model().CycleRecent(1));
+  ASSERT_TRUE(model().CycleRecent(1));
+  auto wrapped = std::make_unique<RecentTabsSwitcherView>(browser());
+  wrapped->Refresh();
+  EXPECT_EQ(0u, wrapped->highlighted_for_testing());
+  wrapped->OnKeyEventForTesting(
+      ui::KeyEvent(ui::EventType::kKeyReleased, ui::VKEY_CONTROL, ui::EF_NONE));
+  EXPECT_EQ(c, tabs().GetActiveTab());
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, b, a}),
+            model().RecentTabs(model().active_id()))
+      << "the run's steps counted as uses";
+
+  // Ctrl let go on the tab reached, then a tap.
+  ASSERT_TRUE(model().CycleRecent(1));
+  ASSERT_TRUE(model().CycleRecent(1));
+  auto second = std::make_unique<RecentTabsSwitcherView>(browser());
+  second->Refresh();
+  second->OnKeyEventForTesting(
+      ui::KeyEvent(ui::EventType::kKeyReleased, ui::VKEY_CONTROL, ui::EF_NONE));
+  EXPECT_EQ(a, tabs().GetActiveTab());
+  ASSERT_TRUE(model().CycleRecent(1));
+  auto tap = std::make_unique<RecentTabsSwitcherView>(browser());
+  tap->Refresh();
+  tap->OnKeyEventForTesting(
+      ui::KeyEvent(ui::EventType::kKeyReleased, ui::VKEY_CONTROL, ui::EF_NONE));
+  EXPECT_FALSE(model().in_cycle());
+  EXPECT_EQ(c, tabs().GetActiveTab()) << "the tap did not go back";
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, a, b}),
+            model().RecentTabs(model().active_id()));
+}
+
 }  // namespace
 }  // namespace stedding
