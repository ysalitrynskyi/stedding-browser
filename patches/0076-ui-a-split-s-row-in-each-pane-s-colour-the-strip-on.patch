+#include "ui/gfx/text_constants.h"
+
+namespace stedding {
+
+namespace {
+
+// Drawn at the Mac's scale, so the ink's centre is known to the half DIP.
+constexpr float kMeasureScale = 2.f;
+// Enough measurements for every glyph, chord and size the sidebar shows.
+constexpr size_t kMaxRemembered = 256;
+
+// The text, the font (its family, size, weight and style) and the box.
+using Key = std::tuple<std::u16string, std::string, int, int, int, int>;
+
+// Draws `text` as a label draws it centred in `box` (Canvas::
+// DrawStringRectWithFlags with TEXT_ALIGN_CENTER, NO_ELLIPSIS and
+// NO_SUBPIXEL_RENDERING), but not clipped to the box: what passes its edges
+// is drawn too.
+void DrawCentredText(gfx::Canvas& canvas,
+                     std::u16string_view text,
+                     const gfx::FontList& font_list,
+                     SkColor color,
+                     const gfx::Rect& box) {
+  std::unique_ptr<gfx::RenderText> render_text =
+      gfx::RenderText::CreateRenderText();
+  render_text->set_clip_to_display_rect(false);
+  render_text->SetFontList(font_list);
+  render_text->SetText(text);
+  render_text->SetCursorEnabled(false);
+  render_text->SetDisplayRect(box);
+  render_text->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  render_text->set_subpixel_rendering_suppressed(true);
+  render_text->SetColor(color);
+  const int style = font_list.GetFontStyle();
+  render_text->SetStyle(gfx::TEXT_STYLE_ITALIC,
+                        (style & gfx::Font::ITALIC) != 0);
+  render_text->SetStyle(gfx::TEXT_STYLE_UNDERLINE,
+                        (style & gfx::Font::UNDERLINE) != 0);
+  render_text->SetStyle(gfx::TEXT_STYLE_STRIKE,
+                        (style & gfx::Font::STRIKE_THROUGH) != 0);
+  render_text->SetWeight(font_list.GetFontWeight());
+  render_text->Draw(&canvas);
+}
+
+std::optional<float> MeasureInkCentre(std::u16string_view text,
+                                      const gfx::FontList& font_list,
+                                      int box_width) {
+  // The box itself, with this much room round it for ink past its edges.
+  // The text is centred in the box, not in a wider one: RenderText rounds
+  // a centring offset toward zero, so a text two DIP or more wider than its
+  // box stood a DIP right of where it stood centred in a box wider by the
+  // same each side.
+  const int margin = font_list.GetHeight();
+  const gfx::Rect box(margin, margin, box_width, font_list.GetHeight());
+  gfx::Canvas canvas(
+      gfx::Size(box_width + 2 * margin, font_list.GetHeight() + 2 * margin),
+      kMeasureScale, /*is_opaque=*/false);
+  DrawCentredText(canvas, text, font_list, SK_ColorBLACK, box);
+  const SkBitmap bitmap = canvas.GetBitmap();
+  // Every pixel the text draws on is ink, its faint antialiased edge too:
+  // the screen shows it. From a quarter opacity on, a column at the edge of
+  // Segoe UI Emoji's house at 17 DIP was left out, and the rail's title row
+  // stood 0.75 DIP right of the column (the owner's bound is half a DIP).
+  int left = bitmap.width();
+  int right = -1;
+  for (int y = 0; y < bitmap.height(); ++y) {
+    for (int x = 0; x < bitmap.width(); ++x) {
+      if (SkColorGetA(bitmap.getColor(x, y)) > 0) {
+        left = std::min(left, x);
+        right = std::max(right, x);
+      }
+    }
+  }
+  if (right < 0) {
+    return std::nullopt;
+  }
+  return (left + right + 1) / 2.f / kMeasureScale - margin;
+}
+
+// Draws `text` across the image, its ink centred.
+class CentredGlyphSource : public gfx::CanvasImageSource {
+ public:
+  CentredGlyphSource(std::u16string text,
+                     gfx::FontList font_list,
+                     SkColor color,
+                     const gfx::Size& size)
+      : gfx::CanvasImageSource(size),
+        text_(std::move(text)),
+        font_list_(std::move(font_list)),
+        color_(color) {}
+  CentredGlyphSource(const CentredGlyphSource&) = delete;
+  CentredGlyphSource& operator=(const CentredGlyphSource&) = delete;
+  ~CentredGlyphSource() override = default;
+
+  // gfx::CanvasImageSource:
+  void Draw(gfx::Canvas* canvas) override {
+    const std::optional<float> ink =
+        GlyphInkCentre(text_, font_list_, size().width());
+    canvas->Save();
+    if (ink) {
+      canvas->sk_canvas()->translate(size().width() / 2.f - *ink, 0);
+    }
+    // Clipped by the image's edges alone: a box clip, moved with the text,
+    // cut a picture wider than the image on one side only.
+    DrawCentredText(*canvas, text_, font_list_, color_, gfx::Rect(size()));
+    canvas->Restore();
+  }
+
+ private:
+  const std::u16string text_;
+  const gfx::FontList font_list_;
+  const SkColor color_;
+};
+
+}  // namespace
+
+std::optional<float> GlyphInkCentre(std::u16string_view text,
+                                    const gfx::FontList& font_list,
+                                    int box_width) {
+  if (text.empty()) {
+    return std::nullopt;
+  }
+  static base::NoDestructor<std::map<Key, std::optional<float>>> remembered;
+  Key key(std::u16string(text), font_list.GetPrimaryFont().GetFontName(),
+          font_list.GetFontSize(), static_cast<int>(font_list.GetFontWeight()),
+          font_list.GetFontStyle(), box_width);
+  if (const auto it = remembered->find(key); it != remembered->end()) {
+    return it->second;
+  }
+  if (remembered->size() >= kMaxRemembered) {
+    remembered->clear();
+  }
+  const std::optional<float> centre =
+      MeasureInkCentre(text, font_list, box_width);
+  remembered->emplace(std::move(key), centre);
+  return centre;
+}
+
+int InkCentringShift(std::u16string_view text,
+                     const gfx::FontList& font_list,
+                     const gfx::Rect& label_bounds,
+                     float centre_x) {
+  const std::optional<float> ink =
+      GlyphInkCentre(text, font_list, label_bounds.width());
+  if (!ink) {
+    return 0;
+  }
+  return static_cast<int>(std::lround(centre_x - (label_bounds.x() + *ink)));
+}
+
+ui::ImageModel CentredGlyphImage(std::u16string_view text,
+                                 const gfx::FontList& font_list,
+                                 ui::ColorVariant color,
+                                 int width) {
+  const gfx::Size size(width, std::max(width, font_list.GetHeight()));
+  return ui::ImageModel::FromImageGenerator(
+      base::BindRepeating(
+          [](const std::u16string& text, const gfx::FontList& font_list,
+             const ui::ColorVariant& color, const gfx::Size& size,
+             const ui::ColorProvider* provider) {
+            return gfx::CanvasImageSource::MakeImageSkia<CentredGlyphSource>(
+                text, font_list, color.ResolveToSkColor(provider), size);
+          },
+          std::u16string(text), font_list, color, size),
+      size);
+}
+
+}  // namespace stedding
