+// folders F43 (the owner, 2026-11-05, from a capture; BACKLOG S-424): a
+// folder's header and the row under it, both selected, met with no gap. The
+// rows of an open folder stand 2 DIP apart, as the list's rows do, down a
+// nested folder and on to the row after the folder; so does the row a
+// collapsed folder keeps out; and the rail keeps its own gap.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, AFoldersRowsStandApartAsTheListsDo) {
+  CloseDownToOne();
+  AppendTab();
+  AppendTab();
+  AppendTab();
+  AppendTab();
+  ASSERT_EQ(5, tab_strip_model()->count());
+  // [0, Outer[1, 2, Nested[3]], 4]
+  tabs::FolderTabCollection* const outer =
+      tab_strip_model()->AddToNewFolder({1, 2, 3});
+  ASSERT_TRUE(outer);
+  tabs::FolderTabCollection* const nested =
+      tab_strip_model()->AddToNewFolder({3});
+  ASSERT_TRUE(nested);
+  ASSERT_EQ(outer, nested->GetParentCollection());
+  tabs::TabInterface* const first = tab_strip_model()->GetTabAtIndex(1);
+  tabs::TabInterface* const second = tab_strip_model()->GetTabAtIndex(2);
+  tabs::TabInterface* const inner = tab_strip_model()->GetTabAtIndex(3);
+  tabs::TabInterface* const after = tab_strip_model()->GetTabAtIndex(4);
+  // Selected, as the owner saw it: the look does not change the room.
+  tab_strip_model()->ActivateTabAt(1);
+  tab_strip_model()->ExtendSelectionTo(2);
+  const auto header = [&](const tabs::FolderTabCollection* folder) {
+    FolderView* const view = DrawnFolder(folder);
+    return view ? view->GetHeaderBoundsInScreen() : gfx::Rect();
+  };
+  const auto row = [&](tabs::TabInterface* tab) {
+    TabView* const view = DrawnRow(tab);
+    return view ? view->GetBoundsInScreen() : gfx::Rect();
+  };
+  const auto expect_gap = [](const gfx::Rect& above, const gfx::Rect& below,
+                             int gap, const char* what) {
+    ASSERT_FALSE(above.IsEmpty()) << what;
+    ASSERT_FALSE(below.IsEmpty()) << what;
+    EXPECT_EQ(gap, below.y() - above.bottom())
+        << what << ": " << above.ToString() << " over " << below.ToString();
+  };
+  {
+    SCOPED_TRACE("an open folder");
+    expect_gap(header(outer), row(first), 2, "the header and its first row");
+    expect_gap(row(first), row(second), 2, "two rows");
+    expect_gap(row(second), header(nested), 2, "a row and a nested header");
+    expect_gap(header(nested), row(inner), 2, "a nested header and its row");
+    expect_gap(row(inner), row(after), 2, "the last row and the row after");
+  }
+  {
+    SCOPED_TRACE("a collapsed folder with a tab kept out");
+    tab_strip_model()->ActivateTabAt(2);
+    outer->SetCollapsed(true);
+    ASSERT_TRUE(DrawnRow(second)) << "the active tab keeps its row";
+    expect_gap(header(outer), row(second), 2, "the header and the row kept");
+    expect_gap(row(second), row(after), 2, "the row kept and the row after");
+    outer->SetCollapsed(false);
+  }
+  {
+    SCOPED_TRACE("the rail");
+    tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(true);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return VerticalTabStripRegionView::IsRailWidth(
+          BrowserView::GetBrowserViewForBrowser(browser())
+              ->vertical_tab_strip_region_view_for_testing()
+              ->width());
+    }));
+    expect_gap(header(outer), row(first), stedding::RailRowGap(),
+               "the header and its first row");
+    expect_gap(row(first), row(second), stedding::RailRowGap(), "two rows");
+  }
+}
