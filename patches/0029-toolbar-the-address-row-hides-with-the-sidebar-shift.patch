+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/address_row_rules.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// T8, T10, T11, T12 in one table.
+TEST(AddressRowRulesTest, HiddenWithTheSidebarUnlessLocalhostOrOverridden) {
+  AddressRowSignals signals;
+  EXPECT_TRUE(ShouldShowAddressRow(signals)) << "expanded: shown";
+  signals.sidebar_collapsed = true;
+  EXPECT_FALSE(ShouldShowAddressRow(signals)) << "T8: collapsed hides it";
+  signals.localhost = true;
+  EXPECT_TRUE(ShouldShowAddressRow(signals)) << "T11: localhost keeps it";
+  signals.localhost = false;
+  signals.hide_with_sidebar = false;
+  EXPECT_TRUE(ShouldShowAddressRow(signals)) << "T12: the setting off";
+  signals.override = false;
+  EXPECT_FALSE(ShouldShowAddressRow(signals)) << "T10: the toggle wins";
+  signals.hide_with_sidebar = true;
+  signals.override = true;
+  EXPECT_TRUE(ShouldShowAddressRow(signals)) << "T10: shown while collapsed";
+
+  EXPECT_TRUE(IsLocalhostPage(GURL("http://localhost:8766/a.html")));
+  EXPECT_TRUE(IsLocalhostPage(GURL("http://127.0.0.1/")));
+  EXPECT_FALSE(IsLocalhostPage(GURL("https://example.com/")));
+  EXPECT_FALSE(IsLocalhostPage(GURL("chrome://settings/")));
+}
+
+}  // namespace
+}  // namespace stedding
