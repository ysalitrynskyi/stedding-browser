# filter_for <table> <feature>: that feature's filter in the table, or nothing.
filter_for() {
  printf '%s\n' "$1" | sed -n "s/^$2://p"
}

# all_filters <table>: every feature's filter in the table, joined.
all_filters() {
  printf '%s\n' "$1" | sed -n 's/^[a-z-]*://p' | paste -sd: -
}

feature_names() {
  printf '%s\n' "$FEATURE_FILTERS" "$COMPONENT_FILTERS" "$CONTENT_FILTERS" | sed -n 's/^\([a-z-]*\):.*/\1/p' | sort -u
}

build_running() {
  # siso/ninja hold a lock file in the output directory while they run.
  pgrep -f "siso ninja -C $CHROMIUM_SRC/out" >/dev/null 2>&1 ||
    pgrep -f "autoninja -C out/" >/dev/null 2>&1
}

# The person's own data folders, which no test may write to (BACKLOG S-220):
# Stedding's, and Chromium's, which builds before patch 0050 used on the Mac.
person_data_dirs() {
  if is_windows; then
    local local_app_data
    [ -n "${LOCALAPPDATA:-}" ] || return 0
    local_app_data="$(cygpath -u "$LOCALAPPDATA")" || return 0
    printf '%s\n' "$local_app_data/Stedding/User Data" "$local_app_data/Chromium/User Data"
  else
    printf '%s\n' "$HOME/Library/Application Support/Stedding" \
      "$HOME/Library/Application Support/Chromium"
  fi
}

# What a test leaves at the top of a data folder: a TestingProfile's folder
# (base's test_scoped_temp_dir*), a ScopedTempDir (scoped_dir*), and the unit
# tests' own user-data folder if it was ever made in the wrong place. Sorted,
# one path per line. Never fails: lib.sh runs with pipefail.
test_leftovers() {
  local dir
  person_data_dirs | while IFS= read -r dir; do
    [ -d "$dir" ] || continue
    find "$dir" -mindepth 1 -maxdepth 1 \( -name 'test_scoped_temp_dir*' \
      -o -name 'scoped_dir*' -o -name 'stedding_unit_tests_user_data*' \) -print 2>/dev/null || true
  done | sort
}

cmd_build() {
  if is_windows; then
    die "build with tooling\\win\\build.ps1 (docs/HANDOFF.md, \"The Windows build\"); tooling/dev test takes --no-build here"
  fi
  if build_running; then
    die "a build is already running; editing or building now would race it (HANDOFF trap 1)"
  fi
  "$STEDDING_ROOT/tooling/build-chromium" "$@"
}

# Lists what one test binary would run for a filter, and fails when a part of
# the filter matches nothing: a renamed, deleted or disabled test must not drop
# out of a sweep that still says SUCCESS (docs/history/plan-2026-09-26.md REPO-2). One listing, every
# part matched against it the way gtest matches (* and ?): the verdict of a
# --gtest_list_tests run per part, in one launch instead of one per part.
# Prints the count, by feature for `all`, and with show=1 the tests themselves.
#   list_leg <binary> <filter> <feature> <table> <show 0|1>
list_leg() {
  local name="$1" filter="$2" feature="$3" table="$4" show="$5"
  local bin="$TEST_OUT_DIR/$name$TEST_EXE_SUFFIX" listing errors status=0
  [ -x "$bin" ] || die "no $name at $bin — tooling/dev build release $name (Windows: tooling\\win\\build.ps1 -Targets $name)"
  listing="$(mktemp "${TMPDIR:-/tmp}/stedding-list.XXXXXX")"
  errors="$(mktemp "${TMPDIR:-/tmp}/stedding-list-err.XXXXXX")"
  if ! "$bin" --gtest_list_tests --gtest_filter="$filter" >"$listing" 2>"$errors"; then
    tail -5 "$errors" >&2
    rm -f "$listing" "$errors"
    die "$name --gtest_list_tests failed"
  fi
  python3 - "$listing" "$filter" "$feature" "$table" "$name" "$show" <<'PY' || status=$?
import re
import sys

listing, flt, feature, table, binary, show = sys.argv[1:7]


def gtest_pattern(part):
    # gtest's wildcards are * (any run) and ? (one character); nothing else.
    return re.compile(re.escape(part).replace(r"\*", ".*").replace(r"\?", "."))


def positive_parts(text):
    # "A:B-C:D" selects A and B, and excludes C and D.
    return [p for p in text.split("-", 1)[0].split(":") if p]


names, suite = [], None
with open(listing, encoding="utf-8", errors="replace") as handle:
    for raw in handle:
        # "Suite.", "Prefix/Suite.  # TypeParam = int", "  Name", "  Name/0  # GetParam() = 3"
        body = raw.rstrip("\n").split("#", 1)[0].rstrip()
        if not body.strip():
            continue
        if not body.startswith(" "):
            suite = body if body.endswith(".") else None
        elif suite:
            names.append(suite + body.strip())
# gtest lists DISABLED_ tests but runs none of them: a part that matches only
# those runs nothing.
names = [n for n in names if not re.search(r"(^|[./])DISABLED_", n)]


def matching(parts):
    patterns = [gtest_pattern(p) for p in parts]
    return [n for n in names if any(p.fullmatch(n) for p in patterns)]


parts = list(dict.fromkeys(positive_parts(flt)))
missing = [p for p in parts if not matching([p])]
owners = {}
for line in table.splitlines():
    key, sep, rest = line.strip().partition(":")
    if sep:
        owners[key] = positive_parts(rest)

selected = matching(parts)
if feature in ("all", "unit") and owners:
    counts = ", ".join("%s %d" % (key, len(matching(ps))) for key, ps in owners.items())
    print("==> %s: %d tests (%s)" % (binary, len(selected), counts), file=sys.stderr)
else:
    print("==> %s: %d tests for %s" % (binary, len(selected), feature), file=sys.stderr)
if show == "1":
    for name in selected:
        print(name)
if missing:
    print("xx %s has no test for %d part(s) of the filter: renamed, deleted, disabled,"
          " or in another binary?" % (binary, len(missing)), file=sys.stderr)
    for part in missing:
        where = [key for key, ps in owners.items() if part in ps]
        print("     %s%s" % (part, "  (%s)" % ", ".join(where) if where else ""), file=sys.stderr)
    sys.exit(1)
PY
  rm -f "$listing" "$errors"
  return "$status"
}

# Runs one test binary on a filter: failures in full, then the launcher's own
# summary. No retries: a test that passes only on its second run is reported
# as the failure it is (docs/history/plan-2026-09-26.md PLT-12).
#   run_leg <binary> <filter> [launcher flags...]
run_leg() {
  local name="$1" filter="$2" out status
  shift 2
  log "$name --gtest_filter=$filter"
  out="$(mktemp "${TMPDIR:-/tmp}/stedding-test.XXXXXX")"
  set +e
  # shellcheck disable=SC2086  # one flag, no spaces: unquoted on purpose, so empty is nothing
  run_test_binary "$TEST_OUT_DIR/$name$TEST_EXE_SUFFIX" --gtest_filter="$filter" --test-launcher-bot-mode \
    --test-launcher-retry-limit=0 $TEST_EXTRA_FLAGS "$@" >"$out" 2>&1
  status=$?
  set -e
  grep -E 'Failure$|^\[  FAILED|error:|\(CRASHED\)|\(TIMED OUT\)' "$out" || true
  # A crash or a timeout is neither a failure line nor a SUCCESS line; the
  # launcher counts them on their own ("1 test crashed:"), and a sweep with one
  # printed nothing here on 2026-09-10 (HANDOFF trap 31).
  grep -E 'tests? (ran|passed|failed|crashed|timed out)|SUCCESS|FAILURE|Tests took' "$out" | tail -6 || true
  # A sanitizer or DCHECK finding is sixty frames per test; say it in a few lines instead.
  if grep -qE 'AddressSanitizer|DanglingPtr\]\(1/3\)|FATAL:' "$out"; then
    "$STEDDING_ROOT/tooling/digest-sanitizer" "$out" || true
  fi
  # Appended, one file per binary: the browser suite runs in two legs. cmd_test empties it.
  if [ -n "${STEDDING_TEST_LOG:-}" ]; then
    { printf '=== %s --gtest_filter=%s\n' "$name" "$filter"; cat "$out"; } >>"$STEDDING_TEST_LOG.$name" || true
  fi
  rm -f "$out"
  return "$status"
}

# A run with --no-build takes whatever binary the output directory holds, and one built
# before the series' newest change runs, and passes, without it: a mac-checks sweep on
# 2026-10-30 listed four tests fewer than the release build and missed a crash in one
# of them (docs/HANDOFF.md, trap 138). Each binary older than a file the series, or the
# tree on top of it, changes is named, with the first of those files.
warn_stale_binaries() {
  local files name bin newer count
  files="$(git -C "$CHROMIUM_SRC" diff --name-only "$CHROMIUM_COMMIT" 2>/dev/null)" || return 0
  [ -n "$files" ] || return 0
  for name in "$@"; do
    bin="$TEST_OUT_DIR/$name$TEST_EXE_SUFFIX"
    [ -e "$bin" ] || continue
    # A browser test's source is in stedding_browser_tests alone.
    newer="$(cd "$CHROMIUM_SRC" && printf '%s\n' "$files" | while IFS= read -r f; do
      if [ "$name" != stedding_browser_tests ] && [ "${f%_browsertest.cc}" != "$f" ]; then
        continue
      fi
      if [ "$f" -nt "$bin" ]; then printf '%s\n' "$f"; fi
    done)"
    [ -n "$newer" ] || continue
    count="$(printf '%s\n' "$newer" | grep -c .)"
    warn "$name is older than $count file(s) the series changes, $(printf '%s\n' "$newer" | head -1) first: it may not hold them. Build it, or run without --no-build"
  done
}

cmd_test() {
  local feature="${1:-all}"
  shift || true
  case "$feature" in
    ''|*[!a-z-]*) die "not a feature name: '$feature' (tooling/dev features lists them)" ;;
  esac
  local build=1 show=0 browser_filter="*"
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-build) build=0 ;;
      --list) show=1; build=0 ;;
      -*) die "unknown option $1 (tooling/dev test <feature|all|browser [filter]> [--no-build|--list])" ;;
      *)
        [ "$feature" = browser ] || die "only 'tooling/dev test browser' takes a filter; got '$1'"
        [ "$browser_filter" = "*" ] || die "one filter only; join its parts with ':' (got '$browser_filter' and '$1')"
        browser_filter="$1" ;;
    esac
    shift
  done

  local unit="" components="" content="" browser=""
  case "$feature" in
    all)
      unit="$(all_filters "$FEATURE_FILTERS")"
      components="$(all_filters "$COMPONENT_FILTERS")"
      content="$(all_filters "$CONTENT_FILTERS")"
      browser="*" ;;
    unit)
      unit="$(all_filters "$FEATURE_FILTERS")" ;;
    browser)
      browser="$browser_filter" ;;
    rebase)
      unit="$REBASE_FILTERS" ;;
    *)
      unit="$(filter_for "$FEATURE_FILTERS" "$feature")"
      components="$(filter_for "$COMPONENT_FILTERS" "$feature")"
      content="$(filter_for "$CONTENT_FILTERS" "$feature")"
      [ -n "$unit$components$content" ] ||
        die "no test filter for '$feature'; known: $(feature_names | paste -sd' ' -) unit browser all" ;;
  esac

  if [ "$build" -eq 1 ]; then
    set -- release
    if [ -n "$unit" ]; then set -- "$@" unit_tests; fi
    if [ -n "$components" ]; then set -- "$@" components_unittests; fi
    if [ -n "$content" ]; then set -- "$@" content_unittests; fi
    if [ -n "$browser" ]; then set -- "$@" stedding_browser_tests; fi
    cmd_build "$@"
  fi
  if [ "$build" -eq 0 ] && [ "$show" -eq 0 ]; then
    set --
    if [ -n "$unit" ]; then set -- "$@" unit_tests; fi
    if [ -n "$components" ]; then set -- "$@" components_unittests; fi
    if [ -n "$content" ]; then set -- "$@" content_unittests; fi
    if [ -n "$browser" ]; then set -- "$@" stedding_browser_tests; fi
    warn_stale_binaries "$@"
  fi

  if [ -n "${STEDDING_TEST_LOG:-}" ] && [ "$show" -eq 0 ]; then
    local log_name
    for log_name in unit_tests components_unittests content_unittests stedding_browser_tests; do
      : >"$STEDDING_TEST_LOG.$log_name" 2>/dev/null || true
    done
  fi

  # Every leg is listed before any runs, so one pass names every part of every
  # filter that matches nothing, and a sweep with such a part runs nothing.
  local listed=0
  if [ -n "$unit" ]; then
    list_leg unit_tests "$unit" "$feature" "$FEATURE_FILTERS" "$show" || listed=1
  fi
  if [ -n "$components" ]; then
    list_leg components_unittests "$components" "$feature" "$COMPONENT_FILTERS" "$show" || listed=1
  fi
  if [ -n "$content" ]; then
    list_leg content_unittests "$content" "$feature" "$CONTENT_FILTERS" "$show" || listed=1
  fi
  if [ -n "$browser" ]; then
    list_leg stedding_browser_tests "$browser" "$feature" "" "$show" || listed=1
    # A filter's exclusions ("A.*-B.*") must name tests as well, or they exclude nothing.
    case "$browser" in
      *-*) list_leg stedding_browser_tests "${browser#*-}" "exclusions" "" 0 || listed=1 ;;
    esac
    # The serial list is checked too, so a renamed fixture cannot slip into the parallel leg.
    list_leg stedding_browser_tests "$SERIAL_BROWSER_TESTS" "serial" "" 0 || listed=1
  fi
  [ "$listed" -eq 0 ] ||
    die "a filter part matches no test (above), so nothing ran: fix its line in tooling/dev, or build the binary again"
  [ "$show" -eq 0 ] || return 0

  # BACKLOG S-220: a test that writes to the person's own data folder fails the
  # run. What an earlier run left is named once, and never deleted here: the
  # folder is the person's (AGENTS.md, Red lines: Deleting).
  local leftovers_before leftovers_after new_leftovers
  leftovers_before="$(test_leftovers)"
  if [ -n "$leftovers_before" ]; then
    warn "a test run before this one left these in the person's data folder (BACKLOG S-220):"
    printf '%s\n' "$leftovers_before" | sed 's/^/     /' >&2
  fi

  local status=0
  if [ -n "$unit" ]; then
    run_leg unit_tests "$unit" || status=$?
  fi
  if [ -n "$components" ]; then
    run_leg components_unittests "$components" || status=$?
  fi
  if [ -n "$content" ]; then
    run_leg content_unittests "$content" || status=$?
  fi
  # Stedding's browser tests: a real BrowserView in a real window, driven
  # through the widget's event path (clicks on rows, the rail, restore). They
  # open windows on screen but post no OS-level input. The whole suite runs in two
  # legs: most of it STEDDING_BROWSER_JOBS at a time, then SERIAL_BROWSER_TESTS one
  # at a time. A filter given on the command line runs one at a time.
  if [ -n "$browser" ]; then
    # A cursor resting where test windows open fails the hover and edge tests
    # (docs/HANDOFF.md, trap 78); the script leaves it alone while it is in use.
    if is_windows; then
      # In a disconnected remote session the drags (TabDropTest, SidebarClickTest's row
      # drag) find no window under the pointer and fail; the rest pass (trap 59).
      if command -v qwinsta >/dev/null 2>&1 && ! qwinsta 2>/dev/null | grep -q '^>.*Active'; then
        warn "this Windows session is not Active (qwinsta): the drag tests will fail (trap 59)"
      fi
      powershell.exe -NoProfile -File "$(cygpath -w "$STEDDING_ROOT/tooling/win/park-cursor.ps1")" || true
    elif [ "$(uname -s)" = Darwin ]; then
      "$STEDDING_ROOT/tooling/park-cursor" || true
    fi
    if [ "$browser" = "*" ]; then
      # Four at a time on the Mac (2026-10-26: the leg took 397 s where it took 815 s
      # one at a time, BACKLOG S-306). Two on Windows: four at a time, every one of seven
      # runs on the PC on 2026-10-31 had a drag, a bubble or a key that failed and passed
      # alone, a different few each time; two at a time, three runs passed, at about 70
      # seconds more a run (BACKLOG S-369, trap 88).
      local jobs=4
      if is_windows; then
        jobs=2
      fi
      run_leg stedding_browser_tests "*-$SERIAL_BROWSER_TESTS" \
        --test-launcher-jobs="${STEDDING_BROWSER_JOBS:-$jobs}" || status=$?
      # Again before the serial leg, which holds the hover and edge tests (trap 78): the
      # operator may have moved the pointer during the parallel leg.
      if is_windows; then
        powershell.exe -NoProfile -File "$(cygpath -w "$STEDDING_ROOT/tooling/win/park-cursor.ps1")" || true
      elif [ "$(uname -s)" = Darwin ]; then
        "$STEDDING_ROOT/tooling/park-cursor" || true
      fi
      run_leg stedding_browser_tests "$SERIAL_BROWSER_TESTS" --test-launcher-jobs=1 || status=$?
    else
      run_leg stedding_browser_tests "$browser" --test-launcher-jobs=1 || status=$?
    fi
  fi

  leftovers_after="$(test_leftovers)"
  new_leftovers="$(comm -13 <(printf '%s\n' "$leftovers_before") <(printf '%s\n' "$leftovers_after") |
    sed '/^$/d')"
  if [ -n "$new_leftovers" ]; then
    printf '\033[1;31mxx\033[0m %s\n' "this run wrote to the person's data folder (BACKLOG S-220); a test that crashed or timed out above made:" >&2
    printf '%s\n' "$new_leftovers" | sed 's/^/     /' >&2
    [ "$status" -ne 0 ] || status=1
  fi
  return "$status"
}

cmd_capture() {
  # tooling/dev capture --assert <probes.json> [capture-ui args...]
  # runs the capture named in the spec (or the given args) and checks it.
  if [ "${1:-}" = "--assert" ]; then
    local spec="$2"; shift 2
    [ -f "$spec" ] || die "no probe spec at $spec"
    local out="${TMPDIR:-/tmp}/stedding-assert-$$.png"
    if [ $# -gt 0 ]; then
      "$STEDDING_ROOT/tooling/capture-ui" --out "$out" "$@"
    else
      # The spec records how it was captured; run exactly that.
      local cmd
      cmd="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('capture',''))" "$spec")"
      [ -n "$cmd" ] || die "spec has no 'capture' line and no capture args were given"
      (cd "$STEDDING_ROOT" && eval "$cmd --out '$out'")
    fi
    "$STEDDING_ROOT/tooling/assert-capture" "$out" "$spec"
    local status=$?
    rm -f "$out"
    return "$status"
  fi
  "$STEDDING_ROOT/tooling/capture-ui" "$@"
}

cmd_patch() {
  if build_running; then
    die "a build is running; wait for it before rewriting the branch"
  fi
  "$STEDDING_ROOT/tooling/update-patches"
  "$STEDDING_ROOT/tooling/check-repo"
}

cmd_check() {
  "$STEDDING_ROOT/tooling/check-repo"
  "$STEDDING_ROOT/tooling/check-shell"
}

cmd_status() {
  "$STEDDING_ROOT/tooling/status" "$@"
}

# The unit_tests table, one name:filter per line (tooling/status reads it);
# `features components` prints the components_unittests one, `features content` the
# content_unittests one.
cmd_features() {
  case "${1:-}" in
    '') printf '%s\n' "$FEATURE_FILTERS" | sed '/^$/d' ;;
    components) printf '%s\n' "$COMPONENT_FILTERS" | sed '/^$/d' ;;
    content) printf '%s\n' "$CONTENT_FILTERS" | sed '/^$/d' ;;
    *) die "tooling/dev features [components|content]" ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    build)    cmd_build "$@" ;;
    test)     cmd_test "$@" ;;
    capture)  cmd_capture "$@" ;;
    patch)    cmd_patch "$@" ;;
    check)    cmd_check "$@" ;;
    status)   cmd_status "$@" ;;
    features) cmd_features "$@" ;;
    -h|--help|"") sed -n '2,34p' "$0"; exit 0 ;;
    *) die "unknown command: $cmd (try tooling/dev --help)" ;;
  esac
}

main "$@"
