+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Sync through a folder, a WebDAV folder or an S3 bucket
+// (docs/features/sidebar-file.md): the tab the user leaves, an edit just
+// before a new window, a rejoin that meets another computer's deletion, a
+// pin with a very long address, a read that fails after a passing test, and
+// the reads while a window is in front.
+
+#include <atomic>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
