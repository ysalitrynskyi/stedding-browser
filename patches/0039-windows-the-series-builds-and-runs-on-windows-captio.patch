+void VerticalTabStripRegionView::ApplyRailForm(bool rail) {
+  const bool arc_style =
+      base::FeatureList::IsEnabled(stedding::kArcStyleWindow);
+  // The button containers sit on the rows' column: the rail's padding
+  // from the strip's edges in the rail, the open sidebar's 12 DIP
+  // otherwise, past the gutter's worth of interior margin the collapsed
+  // strip carries (sidebar Y6, Y8). With the open padding the toggle sat
+  // 3.5 DIP right of the rows' centre in a container narrower than itself.
+  const int padding =
+      arc_style && rail
+          ? stedding::kRailRowPadding
+          : GetLayoutConstant(
+                LayoutConstant::kVerticalTabStripHorizontalPadding);
+  top_button_container_->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(0, padding + rail_left_, 0, padding));
+  bottom_button_container_->SetProperty(
+      views::kMarginsKey,
+      gfx::Insets::TLBR(
+          GetLayoutConstant(
+              LayoutConstant::kVerticalTabStripCollapsedVerticalPadding),
+          padding + rail_left_, 0, padding));
+  if (!arc_style) {
+    return;
+  }
+  // The strip's own "+ New Tab" row takes the same form.
+  if (tab_strip_view()) {
+    tab_strip_view()->SetRailForm(rail);
+  }
+  // The Archived row is its icon alone in the rail, centred like the tab rows'
+  // favicons and a size up like them; the label and its 18 DIP inset are for
+  // the open sidebar.
+  if (archived_row_) {
+    auto* const row = static_cast<SidebarRowButton*>(archived_row_.get());
