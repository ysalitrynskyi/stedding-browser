+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_MENU_RULES_H_
+#define CHROME_BROWSER_UI_STEDDING_MENU_RULES_H_
+
+namespace stedding {
+
+// docs/features/menus.md M2: the page menu's rows that reach Google or its
+// AI -- Lens, the Gemini rows, the QR code, reading mode. Hidden while the
+// short-menus setting is on; the default engine's own search row stays.
+bool IsGooglePageMenuCommand(int command_id);
+
+// menus M3: the app menu's rows (its submenus included) that reach Google,
+// sync or its AI, plus the bookmarks-bar and side-panel rows and the
+// tab-groups and reading-list submenus the sidebar replaces.
+bool IsGoogleAppMenuCommand(int command_id);
+
+// menus M7: the sidebar row kinds that take different menus. Which rows each
+// kind shows; the controller answers the menu's visibility question with it.
+enum class TabRowKind { kPlain, kSpacePinned, kEssential };
+bool IsTabMenuCommandVisible(TabRowKind kind, int command_id);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_MENU_RULES_H_
