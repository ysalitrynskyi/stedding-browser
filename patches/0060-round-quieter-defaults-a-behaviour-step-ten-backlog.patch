+      const tabs::TabHandle moved = order[move->from_index];
+      EXPECT_EQ(move->tab->GetHandle(), moved);
+      order.erase(order.begin() + move->from_index);
+      order.insert(order.begin() + move->to_index, moved);
+      ++moves;
+    }
+
+    std::vector<tabs::TabHandle> order;
+    int moves = 0;
+  };
+  const auto strip_order = [this] {
+    std::vector<tabs::TabHandle> order;
+    for (int i = 0; i < tabstrip()->count(); ++i) {
+      order.push_back(tabstrip()->GetTabAtIndex(i)->GetHandle());
+    }
+    return order;
+  };
+
+  PrepareTabs(tabstrip(), 5);
+  tabs::TabInterface* const a = tabstrip()->GetTabAtIndex(0);
+  tabs::TabInterface* const b = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const c = tabstrip()->GetTabAtIndex(2);
+  tabs::TabInterface* const d = tabstrip()->GetTabAtIndex(3);
+  tabs::TabInterface* const e = tabstrip()->GetTabAtIndex(4);
+  tabstrip()->ActivateTabAt(3);
+  tabstrip()->AddToNewSplit({4}, split_tabs::SplitTabVisualData(),
+                            split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(d->IsSplit());
+  ASSERT_EQ(d->GetSplit(), e->GetSplit());
+  ASSERT_EQ(3, tabstrip()->GetIndexOfTab(d));
+  ASSERT_EQ(4, tabstrip()->GetIndexOfTab(e));
+  // a, F[b, N[c], S[d, e]]
+  tabs::FolderTabCollection* const folder =
+      tabstrip()->AddToNewFolder({1, 2, 3, 4});
+  ASSERT_NE(nullptr, folder);
+  tabs::FolderTabCollection* const nested = tabstrip()->AddToNewFolder({2});
+  ASSERT_NE(nullptr, nested);
+  ASSERT_EQ(folder, nested->GetParentCollection());
+  ASSERT_EQ(3u, folder->ChildCount());
+  ASSERT_EQ(strip_order(), (std::vector<tabs::TabHandle>{
+                               a->GetHandle(), b->GetHandle(), c->GetHandle(),
+                               d->GetHandle(), e->GetHandle()}));
+
+  MoveReplayer replayer(strip_order());
+  tabstrip()->AddObserver(&replayer);
+  tabstrip()->ReorderFolder(folder, {2, 1, 0});
+  tabstrip()->RemoveObserver(&replayer);
+
+  // a, F[S[d, e], N[c], b]
+  ASSERT_EQ(5, tabstrip()->count()) << "no tab was lost";
+  EXPECT_EQ(0, tabstrip()->GetIndexOfTab(a));
+  EXPECT_EQ(1, tabstrip()->GetIndexOfTab(d));
+  EXPECT_EQ(2, tabstrip()->GetIndexOfTab(e));
+  EXPECT_EQ(3, tabstrip()->GetIndexOfTab(c));
+  EXPECT_EQ(4, tabstrip()->GetIndexOfTab(b));
+  EXPECT_EQ(3u, folder->ChildCount());
+  EXPECT_EQ(4u, folder->TabCountRecursive());
+  EXPECT_TRUE(d->IsSplit()) << "the split keeps its panes";
+  EXPECT_EQ(d->GetSplit(), e->GetSplit());
+  ASSERT_TRUE(d->GetParentCollection());
+  EXPECT_EQ(folder, d->GetParentCollection()->GetParentCollection());
+  EXPECT_EQ(nested, c->GetParentCollection()) << "the nested folder keeps it";
+  EXPECT_EQ(folder, nested->GetParentCollection());
+  EXPECT_EQ(folder, b->GetParentCollection());
+  EXPECT_NE(folder, a->GetParentCollection());
+  EXPECT_GT(replayer.moves, 0);
+  EXPECT_EQ(strip_order(), replayer.order)
+      << "the moves observers saw lead to the strip's order";
+  tabstrip()->CloseAllTabs();
+}
