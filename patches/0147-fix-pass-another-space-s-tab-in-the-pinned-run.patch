+// pins H14 (BACKLOG S-314): every Space's tabs share the one strip, so a loose
+// tab of Home can sit between Work's pins: Home's pin put in a split with one
+// of Home's tabs brings that tab up to it, and a split stays where it is. Work
+// shows neither, and the tabs stay there when the split ends. A change in Work
+// goes by Work's own rows: a new pin joins the end of Work's pins, a link from
+// a pin lands under the line, an unpin leaves the pins for the top of Work's
+// tabs, and a pinned folder joins after the pins. Each stopped at the first
+// tab that was no pin, Home's: a new pin landed before Work's last pin, and an
+// unpin or a link stayed above Work's last pin and took it under the line.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, APinChangePassesAnotherSpacesTabInTheRun) {
+  const spaces::SpaceId work = model().active_id();
+  tabs::TabInterface* const first = tabs().GetActiveTab();
+  ASSERT_TRUE(first);
+  model().SetSpacePinned(first, true);
+
+  spaces::Space* const home = model().AddSpace("Home", SK_ColorBLUE);
+  ASSERT_TRUE(home);
+  const spaces::SpaceId home_id = home->id();
+  model().SetActiveSpace(home_id);
+  tabs::TabInterface* const home_pin = AddBlankTab();
+  model().SetSpacePinned(home_pin, true);
+  tabs::TabInterface* const home_tab = AddBlankTab();
+
+  model().SetActiveSpace(work);
+  tabs::TabInterface* const second = AddBlankTab();
+  model().SetSpacePinned(second, true);
+  tabs::TabInterface* const loose = AddBlankTab();
+  tabs::TabInterface* const tail = AddBlankTab();
+  ASSERT_LT(Index(second), Index(home_tab));
+
+  model().SetActiveSpace(home_id);
+  tabs().ActivateTabAt(Index(home_pin));
+  tabs().AddToNewSplit({Index(home_tab)}, split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(home_pin->IsSplit());
+  ASSERT_LT(Index(home_tab), Index(second)) << "the split brings the tab up";
+
+  // Home's tabs leave the split, in place, and Home's pin is unpinned: two
+  // loose tabs of Home between Work's first pin and the rest.
+  tabs().RemoveSplit(*home_pin->GetSplit());
+  tabs().ActivateTabAt(Index(home_pin));
+  spaces::ToggleSpacePinOnActiveTab(browser());
+  ASSERT_FALSE(model().IsSpacePinned(home_pin));
+  ASSERT_LT(Index(first), Index(home_pin));
+  ASSERT_LT(Index(home_tab), Index(second));
+
+  model().SetActiveSpace(work);
+  tabs().ActivateTabAt(Index(tail));
+  ASSERT_TRUE(IsAboveTheLine(first));
+  ASSERT_TRUE(IsAboveTheLine(second));
+  ASSERT_FALSE(IsAboveTheLine(loose));
+
+  {
+    SCOPED_TRACE("a new pin");
+    tabs().ActivateTabAt(Index(loose));
+    spaces::ToggleSpacePinOnActiveTab(browser());
+    ASSERT_TRUE(model().IsSpacePinned(loose));
+    EXPECT_EQ(Index(second) + 1, Index(loose)) << "pins keep the order pinned";
+    EXPECT_TRUE(IsAboveTheLine(second));
+    EXPECT_TRUE(IsAboveTheLine(loose));
+    EXPECT_FALSE(IsAboveTheLine(tail));
+  }
+  {
+    SCOPED_TRACE("a link from a pin");
+    tabs().ActivateTabAt(Index(first));
+    NavigateParams params(browser(), GURL("about:blank#child"),
+                          ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    params.source_contents = first->GetContents();
+    Navigate(&params);
+    tabs::TabInterface* const opened =
+        tabs().GetTabForWebContents(params.navigated_or_inserted_contents);
+    ASSERT_TRUE(opened);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return Index(opened) == std::max(Index(second), Index(loose)) + 1;
+    })) << "the new tab stayed inside the pinned run";
+    EXPECT_TRUE(IsAboveTheLine(second)) << "a pin was drawn under the line";
+    EXPECT_TRUE(IsAboveTheLine(loose)) << "a pin was drawn under the line";
+    EXPECT_FALSE(IsAboveTheLine(opened));
+  }
+  {
+    SCOPED_TRACE("an unpin");
+    tabs().ActivateTabAt(Index(first));
+    spaces::ToggleSpacePinOnActiveTab(browser());
+    ASSERT_FALSE(model().IsSpacePinned(first));
+    EXPECT_EQ(std::max(Index(second), Index(loose)) + 1, Index(first))
+        << "an unpinned tab goes to the top of the tabs under the line";
+    EXPECT_TRUE(IsAboveTheLine(second)) << "a pin was drawn under the line";
+    EXPECT_TRUE(IsAboveTheLine(loose)) << "a pin was drawn under the line";
+    EXPECT_FALSE(IsAboveTheLine(first));
+  }
+  {
+    SCOPED_TRACE("a pinned folder");
+    tabs::TabInterface* const in_folder = AddBlankTab();
+    tabs::FolderTabCollection* const folder =
+        tabs().AddToNewFolder({Index(in_folder)});
+    ASSERT_TRUE(folder);
+    ASSERT_TRUE(model().CanPinFolder(folder));
+    model().SetFolderSpacePinned(folder, true);
+    EXPECT_EQ(std::max(Index(second), Index(loose)) + 1, Index(in_folder))
+        << "a new pin joins the end";
+    EXPECT_LT(Index(in_folder), Index(first));
+  }
+}
