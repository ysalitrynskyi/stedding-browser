+// offer: the normal window's idle tab goes, which shows the time reached
+// them; the popup's and the little window's stay.
+class IdleWindowsTest : public BrowserWithTestWindowTest {
+ public:
+  IdleWindowsTest()
+      : BrowserWithTestWindowTest(
+            base::test::TaskEnvironment::TimeSource::MOCK_TIME) {}
+
+ protected:
+  // A background tab after the window's first, which a popup only gets this
+  // way: the navigator opens a popup's next tab in a normal window.
+  void AppendBackgroundTab(BrowserWindowInterface* window, const GURL& url) {
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+    content::WebContentsTester::For(contents.get())->NavigateAndCommit(url);
+    TabStripModel* const strip = window->GetTabStripModel();
+    strip->AppendTab(
+        std::make_unique<tabs::TabModel>(std::move(contents), strip),
+        /*foreground=*/false);
+  }
+};
+
+TEST_F(IdleWindowsTest, NothingSweepsAPopupOrALittleWindow) {
+  ASSERT_TRUE(std::ranges::contains(prefs::kArchiveIdleHoursChoices, 6));
+  profile()->GetPrefs()->SetInteger(prefs::kArchiveIdleHours, 6);
+  AddTab(browser(), GURL("https://idle.example/"));
+  AddTab(browser(), GURL("https://active.example/"));
+  ASSERT_EQ(2, browser()->tab_strip_model()->count());
+
+  std::unique_ptr<BrowserWindowInterface> popup =
+      CreateBrowser(profile(), Browser::TYPE_POPUP, /*hosted_app=*/false);
+  AddTab(popup.get(), GURL("https://accounts.example/oauth"));
+  AppendBackgroundTab(popup.get(), GURL("https://accounts.example/consent"));
+  std::unique_ptr<BrowserWindowInterface> little =
+      CreateBrowser(profile(), Browser::TYPE_POPUP, /*hosted_app=*/false);
+  MarkLittleWindow(little.get());
+  AddTab(little.get(), GURL("https://example.com/from-mail"));
+  AppendBackgroundTab(little.get(), GURL("https://example.com/next"));
+  ASSERT_EQ(2, popup->GetTabStripModel()->count());
+  ASSERT_EQ(2, little->GetTabStripModel()->count());
+
+  task_environment()->FastForwardBy(base::Hours(6) +
+                                    2 * TabArchiver::kSweepInterval);
+
+  EXPECT_EQ(1, browser()->tab_strip_model()->count())
+      << "the normal window's archiver did not run: the test proves nothing";
+  EXPECT_EQ(2, popup->GetTabStripModel()->count())
+      << "a popup's idle tab was closed";
+  EXPECT_EQ(2, little->GetTabStripModel()->count())
+      << "a little window's idle tab was closed";
+  popup->GetTabStripModel()->CloseAllTabs();
+  little->GetTabStripModel()->CloseAllTabs();
+}
