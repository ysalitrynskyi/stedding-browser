+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// drm-notice Dn2: every row of the table, under the name a user reaches it
+// by.
+TEST(DrmSitesTest, TheListedSitesMatch) {
+  constexpr struct {
+    const char* address;
+    std::string_view site;
+  } kListed[] = {
+      {"https://www.netflix.com/title/1", "netflix.com"},
+      {"https://netflix.com/", "netflix.com"},
+      {"https://help.netflix.com/", "netflix.com"},
+      {"http://www.netflix.com/", "netflix.com"},
+      {"https://WWW.Netflix.COM/", "netflix.com"},
+      {"https://www.netflix.com./", "netflix.com"},
+      {"https://www.netflix.com:8443/", "netflix.com"},
+      {"https://www.disneyplus.com/", "disneyplus.com"},
+      {"https://www.primevideo.com/", "primevideo.com"},
+      {"https://www.hulu.com/", "hulu.com"},
+      {"https://max.com/", "max.com"},
+      {"https://play.max.com/", "max.com"},
+      {"https://www.hbomax.com/", "hbomax.com"},
+      {"https://www.peacocktv.com/", "peacocktv.com"},
+      {"https://www.paramountplus.com/", "paramountplus.com"},
+      {"https://tv.apple.com/us/show/1", "tv.apple.com"},
+      {"https://www.crunchyroll.com/", "crunchyroll.com"},
+      {"https://open.spotify.com/track/1", "open.spotify.com"},
+      {"https://open.spotify.com./", "open.spotify.com"},
+  };
+  for (const auto& listed : kListed) {
+    EXPECT_EQ(listed.site, DrmSiteOf(GURL(listed.address))) << listed.address;
+  }
+}
+
+// drm-notice Dn2: the match is on a dot boundary, from the right.
+TEST(DrmSitesTest, ANameThatOnlyLooksListedDoesNot) {
+  for (const char* address : {
+           "https://notnetflix.com/",
+           "https://netflix.com.example/",
+           "https://netflix.co/",
+           "https://example.com/www.netflix.com",
+           "https://example.com/?site=netflix.com",
+           "https://netflix.com@example.com/",
+           "https://minimax.com/",
+           "https://nothulu.com/",
+       }) {
+    EXPECT_TRUE(DrmSiteOf(GURL(address)).empty()) << address;
+  }
+}
+
+// drm-notice Dn2: a site with one protected corner is listed by that corner,
+// and the rest of it shows no bar.
+TEST(DrmSitesTest, TheBroadSitesAreNotListed) {
+  for (const char* address : {
+           "https://amazon.com/",
+           "https://www.amazon.com/gp/video",
+           "https://spotify.com/",
+           "https://www.spotify.com/",
+           "https://accounts.spotify.com/",
+           "https://deep.open.spotify.com/",
+           "https://youtube.com/",
+           "https://www.youtube.com/watch?v=1",
+           "https://apple.com/",
+           "https://www.apple.com/tv",
+           "https://music.apple.com/",
+       }) {
+    EXPECT_TRUE(DrmSiteOf(GURL(address)).empty()) << address;
+  }
+}
+
+// drm-notice Dn2: only a web page's address.
+TEST(DrmSitesTest, OnlyWebAddressesMatch) {
+  for (const char* address : {
+           "ftp://netflix.com/",
+           "file:///netflix.com",
+           "chrome://netflix.com/",
+           "data:text/html,netflix.com",
+           "about:blank",
+           "",
+       }) {
+    EXPECT_TRUE(DrmSiteOf(GURL(address)).empty()) << address;
+  }
+}
+
+// drm-notice Dn6: the list holds a site once, whatever it is told.
+TEST(DrmDismissedSitesTest, ASiteIsListedOnce) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(prefs::kDrmNoticeDismissedSites);
+
+  EXPECT_FALSE(IsDrmSiteDismissed(prefs, "netflix.com"));
+  DismissDrmSite(prefs, "netflix.com");
+  DismissDrmSite(prefs, "netflix.com");
+  DismissDrmSite(prefs, "hulu.com");
+
+  EXPECT_TRUE(IsDrmSiteDismissed(prefs, "netflix.com"));
+  EXPECT_TRUE(IsDrmSiteDismissed(prefs, "hulu.com"));
+  EXPECT_FALSE(IsDrmSiteDismissed(prefs, "max.com"));
+  EXPECT_EQ(2u, prefs.GetList(prefs::kDrmNoticeDismissedSites).size());
+}
+
+}  // namespace
+}  // namespace stedding
