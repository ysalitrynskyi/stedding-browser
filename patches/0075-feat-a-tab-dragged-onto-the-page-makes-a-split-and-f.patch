diff --git a/chrome/browser/performance_manager/policies/stedding_discard_veto.h b/chrome/browser/performance_manager/policies/stedding_discard_veto.h
new file mode 100644
index 0000000000000..6304336abe123
--- /dev/null
+++ b/chrome/browser/performance_manager/policies/stedding_discard_veto.h
@@ -0,0 +1,33 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_STEDDING_DISCARD_VETO_H_
+#define CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_STEDDING_DISCARD_VETO_H_
+
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace performance_manager::policies {
+
+// Stedding (docs/features/tabs.md R42, BACKLOG S-111): whether Stedding's
+// sleep gate (R6) keeps a page awake. DiscardEligibilityPolicy protects such
+// a page from Chromium's own urgent, proactive and suggested discards, as
+// Stedding's sleeps spare it; a discard the user asks for (EXTERNAL) is not
+// asked. Set once at browser start by Stedding's code, which this target
+// cannot depend on; unset, nothing is vetoed.
+using SteddingDiscardVeto =
+    base::RepeatingCallback<bool(content::WebContents*)>;
+
+inline SteddingDiscardVeto& GetSteddingDiscardVeto() {
+  static base::NoDestructor<SteddingDiscardVeto> veto;
+  return *veto;
+}
+
+}  // namespace performance_manager::policies
+
+#endif  // CHROME_BROWSER_PERFORMANCE_MANAGER_POLICIES_STEDDING_DISCARD_VETO_H_
