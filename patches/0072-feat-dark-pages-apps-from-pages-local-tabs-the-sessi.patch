+// Lt13: "Mark local development tabs" off draws every row plain, in every
+// window at once and without a restart; on again brings the marks back.
+IN_PROC_BROWSER_TEST_F(LocalTabsTest, TheSettingOffDrawsPlainRows) {
+  ASSERT_TRUE(prefs()->GetBoolean(stedding::prefs::kMarkLocalTabs))
+      << "on by default";
+  tabs::TabInterface* const background = Open(Local("/title2.html"));
+  tabs::TabInterface* const front = Open(Local("/title3.html"));
+  BrowserWindowInterface* const other = CreateBrowser(browser()->GetProfile());
+  tabs::VerticalTabStripStateController::From(other)->SetVerticalTabsEnabled(
+      true);
+  tabs::TabInterface* const elsewhere = Open(Local(), other);
+  ASSERT_EQ(1, TapedRows());
+  ASSERT_EQ(1, TapedRows(other));
+
+  prefs()->SetBoolean(stedding::prefs::kMarkLocalTabs, false);
+  EXPECT_EQ(0, TapedRows());
+  EXPECT_EQ(0, TapedRows(other)) << "the other window too";
+  EXPECT_EQ(u"", HostLineOf(background));
+  EXPECT_EQ(u"", HostLineOf(front));
+  EXPECT_EQ(u"", HostLineOf(elsewhere, other));
+  EXPECT_EQ(u"", DescriptionOf(front));
+
+  prefs()->SetBoolean(stedding::prefs::kMarkLocalTabs, true);
+  EXPECT_TRUE(Taped(front));
+  EXPECT_EQ(LocalHost(), HostLineOf(background));
+  EXPECT_TRUE(Taped(elsewhere, other));
+}
+
+// Lt14: the host line draws grayscale text on the sidebar's clear ground
+// (docs/HANDOFF.md trap 92), on a row, a split pane and in a folder.
+IN_PROC_BROWSER_TEST_F(LocalTabsTest, NoLabelDrawsSubpixelTextOnAClearLayer) {
+  tabs::TabInterface* const local = Open(Local("/title2.html"));
+  Open(Site());
+  tab_strip_model()->AddToNewSplit(
+      {IndexOf(local)}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  tabs::TabInterface* const first = Open(Local("/title3.html"));
+  tabs::TabInterface* const second = Open(Local("/title2.html"));
+  ASSERT_TRUE(tab_strip_model()->AddToNewFolder(Sorted({first, second})));
+  ASSERT_FALSE(HostLineOf(second).empty()) << "a host line is on screen";
+  const std::vector<std::string> labels =
+      stedding::test::SubpixelLabelsOnClearLayers(widget()->GetRootView());
+  EXPECT_TRUE(labels.empty()) << base::JoinString(labels, "; ");
+}
+
+// Lt14: only the sidebar marks a tab. With the tabs across the top of the
+// window, drawn by the same row view, no row wears the tape or shows a host
+// line.
+class LocalTabsHorizontalTest : public LocalTabsTest {
+ protected:
+  const std::vector<base::test::FeatureRefAndParams> GetEnabledFeatures()
+      override {
+    auto enabled = LocalTabsTest::GetEnabledFeatures();
+    enabled.push_back({tabs::kTabStripUnification, {}});
+    return enabled;
+  }
+
+  void SetUpOnMainThread() override {
+    LocalTabsTest::SetUpOnMainThread();
+    ExitVerticalTabsMode();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(LocalTabsHorizontalTest, TheHorizontalStripDrawsNoMark) {
+  Open(Local("/title2.html"));
+  Open(Local("/title3.html"));
+  RunScheduledLayouts();
+  std::vector<TabView*> rows;
+  CollectDrawnRows(widget()->GetRootView(), rows);
+  ASSERT_FALSE(rows.empty()) << "the strip draws its tabs with TabView";
+  for (TabView* const row : rows) {
+    EXPECT_FALSE(row->WearsLocalTapeForTesting());
+    EXPECT_FALSE(row->host_line_for_testing());
+  }
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/make_app_browsertest.cc b/chrome/test/stedding/make_app_browsertest.cc
