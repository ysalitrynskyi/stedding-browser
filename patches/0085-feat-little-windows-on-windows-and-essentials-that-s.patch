+#if BUILDFLAG(IS_WIN)
+// little E1, routing D3 (BACKLOG S-56): on Windows a link another app hands
+// over -- the address after --single-argument, as the installer registers
+// Stedding for http and https -- opens in a little window while Stedding
+// runs, and no other window comes up for it; Ctrl+Shift+O there sends the page
+// into a split, as Shift-Cmd-O does on the Mac. With the setting off it opens
+// as a tab of the window already there. Such links opened as tabs.
+IN_PROC_BROWSER_TEST_F(LittleWindowTest, ALinkFromAnotherAppOpensSmall) {
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  const auto handed_over = [&]() {
+    return base::CommandLine::FromString(base::StrCat(
+        {L"stedding.exe --single-argument ", base::UTF8ToWide(url.spec())}));
+  };
+  const auto windows = [&](BrowserWindowInterface::Type type) {
+    int count = 0;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* window) {
+          count += window->GetType() == type;
+          return true;
+        });
+    return count;
+  };
+  const int tabs_before = browser()->GetTabStripModel()->count();
+
+  {
+    SCOPED_TRACE("the setting on: a little window, and nothing else");
+    ui_test_utils::BrowserCreatedObserver opened;
+    const base::CommandLine command_line = handed_over();
+    ASSERT_TRUE(command_line.HasSingleArgumentSwitch());
+    StartupBrowserCreatorImpl(base::FilePath(), command_line,
+                              chrome::startup::IsFirstRun::kNo)
+        .Launch(browser()->GetProfile(), chrome::startup::IsProcessStartup::kNo,
+                /*restore_tabbed_browser=*/true);
+    BrowserWindowInterface* const little = opened.Wait();
+    ASSERT_TRUE(little);
+    EXPECT_TRUE(stedding::IsLittleWindow(little));
+    EXPECT_EQ(BrowserWindowInterface::Type::TYPE_POPUP, little->GetType());
+    EXPECT_EQ(1, windows(BrowserWindowInterface::Type::TYPE_NORMAL))
+        << "a window of its own came up behind it";
+    EXPECT_EQ(tabs_before, browser()->GetTabStripModel()->count());
+    content::WebContents* const page =
+        little->GetTabStripModel()->GetActiveWebContents();
+    ASSERT_TRUE(page);
+    EXPECT_TRUE(content::WaitForLoadStop(page));
+    EXPECT_EQ(url, page->GetLastCommittedURL());
+
+    // Ctrl+Shift+O: the split, through the window's command for the chord.
+    ASSERT_TRUE(chrome::IsCommandEnabled(little, IDC_SHOW_BOOKMARK_MANAGER));
+    chrome::ExecuteCommand(little, IDC_SHOW_BOOKMARK_MANAGER);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return windows(BrowserWindowInterface::Type::TYPE_POPUP) == 0;
+    })) << "the little window stayed";
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return browser()->GetTabStripModel()->GetActiveWebContents() == page;
+    })) << "the page did not reach the main window";
+    EXPECT_TRUE(browser()->GetTabStripModel()->GetActiveTab()->IsSplit())
+        << "Ctrl+Shift+O did not make a split";
+  }
+  {
+    SCOPED_TRACE("the setting off: a tab of the window there");
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kLittleEnabled, false);
+    const int tabs = browser()->GetTabStripModel()->count();
+    StartupBrowserCreatorImpl(base::FilePath(), handed_over(),
+                              chrome::startup::IsFirstRun::kNo)
+        .Launch(browser()->GetProfile(), chrome::startup::IsProcessStartup::kNo,
+                /*restore_tabbed_browser=*/true);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return browser()->GetTabStripModel()->count() == tabs + 1;
+    })) << "no tab for the link";
+    EXPECT_EQ(0, windows(BrowserWindowInterface::Type::TYPE_POPUP));
+    EXPECT_EQ(1, windows(BrowserWindowInterface::Type::TYPE_NORMAL));
+  }
+}
+#endif  // BUILDFLAG(IS_WIN)
