 void FolderSessionService::OnTabStripModelChanged(
     TabStripModel* tab_strip_model,
     const TabStripModelChange& change,
     const TabStripSelectionChange& selection) {
+  // A tab or window brought back from the recently-closed list (⇧⌘T,
+  // History) carries its folders; startup's restore is waited for whole
+  // (OnSessionRestored). The rebuild waits a turn, until every tab of the
+  // restore -- and the splits they form -- are in.
+  if (change.type() == TabStripModelChange::Type::kInserted &&
+      !SessionRestore::IsRestoring(browser_->GetProfile())) {
+    for (const TabStripModelChange::ContentsWithIndex& inserted :
+         change.GetInsert()->contents) {
+      if (inserted.contents &&
+          spaces::FolderRestorePath::FromWebContents(inserted.contents)) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(&FolderSessionService::RebuildFromRestoredTabs,
+                           weak_factory_.GetWeakPtr()));
+        break;
+      }
+    }
+  }
+  // Selection-only changes too: a folder rename or collapse notifies nobody,
+  // so it is written with the next change of any kind.
+  PersistUnlessClosingAll();
+}
