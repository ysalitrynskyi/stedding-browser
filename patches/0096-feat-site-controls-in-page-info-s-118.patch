new file mode 100644
index 0000000000000..2f50537d10f9e
--- /dev/null
+++ b/chrome/browser/ui/stedding/site_controls.h
@@ -0,0 +1,121 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SITE_CONTROLS_H_
+#define CHROME_BROWSER_UI_STEDDING_SITE_CONTROLS_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+// Site controls (docs/features/site-controls.md, BACKLOG S-118): Stedding's
+// controls inside Chromium's page info, the one panel the site chip and the
+// command bar's View Site Information open. These are the panel's rules,
+// with no window and no view behind them, so they can be tested alone; the
+// views are chrome/browser/ui/views/page_info/stedding_site_controls_view.h.
+
+// Si1: where the page the panel describes is shown.
+enum class SiteControlsWindow {
+  // Not a tab of a normal tabbed window: a popup, an app window, a little
+  // window, a peek, the picture-in-picture window, a side panel's page, or
+  // the Stedding window style is off. Chromium's page info as it is.
+  kOther,
+  // A tab of a normal window that follows the profile's Spaces.
+  kTab,
+  // A tab of a private (or Guest) window: no Spaces, so no session row
+  // (sessions S32).
+  kPrivateTab,
+  // A tab of a normal window that does not follow the profile's Spaces, a
+  // Blank Window: no session row either (S32).
+  kTabWithoutSpaces,
+};
+
+// What decides which of the controls the panel holds.
+struct SiteControlsContext {
+  SiteControlsWindow window = SiteControlsWindow::kOther;
+  // The address page info describes (its entry's virtual URL).
+  GURL url;
+  // dark-pages Dk1: the profile's switch.
+  bool dark_pages_on = false;
+};
+
+// Which of the controls the panel holds (Si1-Si9).
+struct SiteControlsRows {
+  // Si2-Si5: copy link, copy title, mute, picture in picture and zoom.
+  bool strip = false;
+  // Si7: the session row.
+  bool session = false;
+  // Si8: Clear site data.
+  bool clear_data = false;
+  // Si9: the Dark pages switch, and Darken <site> while it is on.
+  bool dark_switch = false;
+  bool dark_site = false;
+};
+
+SiteControlsRows RowsFor(const SiteControlsContext& context);
+
+// Si7: one Space as the session row needs it: its name as the sidebar shows
+// it, its storage-partition token and whether its own session is on now.
+struct SpaceJarEntry {
+  std::u16string name;
+  std::string profile_id;
+  bool isolated = false;
+};
+
+// Si7: the session row's words, and whether the cookie mark follows them.
+struct SessionName {
+  std::u16string text;
+  bool marked = false;
+
+  bool operator==(const SessionName&) const = default;
+};
+
+// Si7: the session a page lives in, named by its jar, not by the Space on
+// screen. `space_jar` and `partition_name` are the jar's
+// (spaces::IsSpaceStoragePartition, StoragePartitionConfig::partition_name).
+//  - the profile's own jar: "Shared session", unmarked;
+//  - a Space's jar whose session is on: "<Space> · Independent session",
+//    marked (sessions S32);
+//  - the jar of a Space whose session was turned off, kept by a page that
+//    has not been left yet (S7, S21): "<Space> · Previous independent
+//    session", unmarked, since S32 marks a Space only while its session is
+//    on;
+//  - a jar no Space names any more (a deleted Space whose wipe waits):
+//    "Independent session", unmarked.
+SessionName SessionNameFor(bool space_jar,
+                           std::string_view partition_name,
+                           const std::vector<SpaceJarEntry>& spaces);
+
+// Si8: the question Clear site data asks first.
+struct ClearSiteDataQuestion {
+  std::u16string title;
+  std::u16string body;
+  std::u16string action;
+};
+
+// Si8: names `domain` and the jar its data goes from, the same jar
+// SessionNameFor names: the shared session, a Space's independent session,
+// an independent session no Space names now, or a private window's session.
+ClearSiteDataQuestion ClearSiteDataQuestionFor(
+    std::u16string_view domain,
+    bool off_the_record,
+    bool space_jar,
+    std::string_view partition_name,
+    const std::vector<SpaceJarEntry>& spaces);
+
+// Si6: the permissions the panel lists for a page at `url` even when the
+// site never asked: the camera and the microphone, on a page that may ask
+// for them -- an https page, or http on this machine (localhost), which
+// getUserMedia accepts as secure. Empty elsewhere: a toggle a page can never
+// use would mislead.
+std::vector<ContentSettingsType> AlwaysListedPermissions(const GURL& url);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SITE_CONTROLS_H_
