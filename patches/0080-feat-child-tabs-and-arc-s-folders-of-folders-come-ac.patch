+// settings T26: off, every row sits at the left and a new link is no one's
+// child; on again, the children already made nest again.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, TheSettingTurnsItOff) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  ASSERT_EQ(14, Indent(child));
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(stedding::prefs::kNestChildTabs, false);
+  EXPECT_EQ(0, Indent(child));
