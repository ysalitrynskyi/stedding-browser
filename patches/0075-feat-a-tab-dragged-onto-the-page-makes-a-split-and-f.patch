+// stedding_folder_session.cc writes them.
+bool ComesBackInACollapsedFolder(content::WebContents* contents) {
+  const spaces::FolderRestorePath* const path =
+      spaces::FolderRestorePath::FromWebContents(contents);
+  if (!path) {
+    return false;
+  }
+  const std::optional<base::Value> folders =
+      base::JSONReader::Read(path->path(), base::JSON_PARSE_RFC);
+  if (!folders || !folders->is_list()) {
+    return false;
+  }
+  for (const base::Value& folder : folders->GetList()) {
+    if (folder.is_dict() && folder.GetDict().FindBool("c").value_or(false)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The favicon Chromium's loader fetches for the tabs it defers, from the
+// favicon database: without it a row that has not loaded shows the default
+// globe.
+void FetchFavicon(content::WebContents* contents) {
+  if (favicon::ContentFaviconDriver* const favicons =
+          favicon::ContentFaviconDriver::FromWebContents(contents)) {
+    favicons->FetchFavicon(favicons->GetActiveURL(),
+                           /*is_same_document=*/false);
+  }
+}
+
+// What the restore leaves of a tab it does not load, made a slept tab's: the
+// mark that dims its row and wakes it on its first activation (the
+// navigation controller reloads a restored tab once it is shown), and its
+// favicon.
+void PutToSleep(TabStripModel* strip, content::WebContents* contents) {
+  contents->SetWasDiscarded(true);
+  FetchFavicon(contents);
+  strip->UpdateWebContentsState(contents, TabChangeType::kAll);
+}
+
+// A stopped load leaves its tab a renderer holding an empty page. Once the
+// restore is over -- and the tab's folders are made again from what its
+// contents carry, so they may be replaced -- the lifecycle unit puts the tab
+// to sleep as Sleep Tab does, which frees the renderer. Nothing happens to a
+// tab the user has come to meanwhile.
+void FreeTheRendererOf(base::WeakPtr<tabs::TabInterface> tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents || tab->IsActivated() || !contents->WasDiscarded() ||
+      !contents->GetPrimaryMainFrame()->IsRenderFrameLive()) {
+    return;
+  }
+  if (resource_coordinator::TabLifecycleUnitExternal* const unit =
+          resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+              contents)) {
+    unit->DiscardTab(mojom::LifecycleUnitDiscardReason::EXTERNAL);
+  }
+  // The contents the discard put in place have no favicon yet: the one
+  // fetched for the old contents came back to contents now gone.
+  if (tab && tab->GetContents()) {
+    FetchFavicon(tab->GetContents());
+  }
+}
+
+}  // namespace
+
+StartupLoad StartupLoadFromPref(int value) {
+  switch (value) {
+    case static_cast<int>(StartupLoad::kSelectedTabAndEssentials):
+      return StartupLoad::kSelectedTabAndEssentials;
+    case static_cast<int>(StartupLoad::kActiveSpace):
+      return StartupLoad::kActiveSpace;
+    default:
+      return StartupLoad::kSelectedTab;
+  }
+}
+
+bool LoadsAtStartup(StartupLoad choice, const RestoredTabFacts& facts) {
+  if (facts.on_screen) {
+    return true;
+  }
+  switch (choice) {
+    case StartupLoad::kSelectedTab:
+      return false;
+    case StartupLoad::kSelectedTabAndEssentials:
+      return facts.essential;
+    case StartupLoad::kActiveSpace:
+      return facts.essential || facts.shown_in_active_space;
+  }
+  NOTREACHED();
+}
+
+std::vector<content::WebContents*> TabsToLoadAtStartup(
+    const std::vector<RestoredContents>& restored) {
+  std::vector<content::WebContents*> load;
+  load.reserve(restored.size());
+  std::optional<StartupLoad> choice;
+  for (const RestoredContents& each : restored) {
+    content::WebContents* const contents = each.contents;
+    TabStripModel* const strip = NormalStripOf(contents);
+    const int index = strip ? strip->GetIndexOfWebContents(contents)
+                            : TabStripModel::kNoTab;
+    // A page already there stays: nothing a restore makes has committed one
+    // yet, but a page that has is not taken away from under the user.
+    if (index == TabStripModel::kNoTab ||
+        !contents->GetPrimaryMainFrame()->GetLastCommittedURL().is_empty()) {
+      load.push_back(contents);
+      continue;
+    }
+    if (!choice) {
+      choice = StartupLoadFromPref(
+          Profile::FromBrowserContext(contents->GetBrowserContext())
+              ->GetPrefs()
+              ->GetInteger(prefs::kStartupLoad));
+    }
+    const RestoredTabFacts facts = {
+        .on_screen = each.selected || strip->IsTabInForeground(index),
+        .essential = strip->IsTabPinned(index),
+        .shown_in_active_space = !strip->IsTabHidden(index) &&
+                                 !ComesBackInACollapsedFolder(contents),
+    };
+    if (LoadsAtStartup(*choice, facts)) {
+      load.push_back(contents);
+      continue;
+    }
+    // The first tab a window gets is its active one until the restore
+    // selects another, and on the Mac its page view is shown, before the
+    // window is, which starts its load. A load begun that way is stopped,
+    // the tab is left to load when it is selected, as the others are, and
+    // the renderer the load started goes once the restore is over.
+    if (!contents->GetController().NeedsReload()) {
+      contents->Stop();
+      contents->GetController().SetNeedsReload();
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&FreeTheRendererOf,
+                                    strip->GetTabAtIndex(index)->GetWeakPtr()));
+    }
+    PutToSleep(strip, contents);
+  }
+  return load;
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/startup_load.h b/chrome/browser/ui/stedding/startup_load.h
new file mode 100644
index 0000000000000..a4422969fd0ed
--- /dev/null
+++ b/chrome/browser/ui/stedding/startup_load.h
@@ -0,0 +1,68 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_STARTUP_LOAD_H_
+#define CHROME_BROWSER_UI_STEDDING_STARTUP_LOAD_H_
+
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace stedding {
+
+// "On startup, load" (docs/features/tabs.md R45-R48, BACKLOG S-110): which of
+// the tabs a session restore brings back load at once. Every other restored
+// tab comes back asleep and loads when it is selected. The values are those
+// stedding::prefs::kStartupLoad holds.
+enum class StartupLoad {
+  kSelectedTab = 0,
+  kSelectedTabAndEssentials = 1,
+  kActiveSpace = 2,
+};
+
+// The choice a value of the preference names; a value no build writes reads
+// as the default, the selected tab.
+StartupLoad StartupLoadFromPref(int value);
+
+// What the rule asks of one restored tab, as its window stands once the
+// restore has made every tab.
+struct RestoredTabFacts {
+  // The window's selected tab, or the other pane of its split.
+  bool on_screen = false;
+  // An essential (a Chromium-pinned tab), which is in every Space.
+  bool essential = false;
+  // A row the sidebar shows in the Space on screen: one filed in that Space
+  // that no collapsed folder (and no collapsed pinned run, pins H17) hides.
+  bool shown_in_active_space = false;
+};
+
+// Whether a restored tab with `facts` loads at once under `choice`: the tab on
+// screen always; with kSelectedTabAndEssentials every essential too; with
+// kActiveSpace, also every row the active Space shows.
+bool LoadsAtStartup(StartupLoad choice, const RestoredTabFacts& facts);
+
+// One tab a session restore made, and whether it is its window's selected
+// tab.
+struct RestoredContents {
+  raw_ptr<content::WebContents> contents;
+  bool selected = false;
+};
+
+// The restore's hook (SessionRestoreDelegate::RestoreTabs, tabs R46): of
+// `restored`, in their order, the tabs to hand to Chromium's background
+// loader. Each other one is put to sleep as an imported tab is (import I3):
+// marked discarded, so its row is drawn as a slept row (R4) and loads when it
+// is selected, with its favicon read from the favicon database, which the
+// loader would have done. The choice is read once, here. A tab outside a
+// normal window's strip, and one that has begun to load, is always returned.
+std::vector<content::WebContents*> TabsToLoadAtStartup(
+    const std::vector<RestoredContents>& restored);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_STARTUP_LOAD_H_
