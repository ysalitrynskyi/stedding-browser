+// docs/features/sidebar-file.md Sf7-Sf41 (ADR 0029): the sidebar kept the
+// same on several computers through a folder the user picks, which their
+// own sync tool or shared drive carries. Stedding makes no network request.
+//
+// Off by default: until a folder is chosen the service observes one
+// preference and nothing else, and reads and writes nothing. Once on, it
+// records the user's edits in a ledger in the profile, writes this
+// install's file in the folder two seconds after the last change, reads the
+// other installs' files when the folder changes (and, for folders that send
+// no events, when a window becomes active and every ten seconds while one is
+// in front), merges them field by field, and applies the result to the
+// windows. Removals travel only from the user's own removal in a live
+// window; large batches, Space deletions, session changes and moves that
+// would reload a page wait for the user in Settings.
+class SidebarSyncService : public KeyedService,
+                           public BrowserCollectionObserver,
+                           public SpaceRegistry::Observer {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // The status Settings shows changed.
+    virtual void OnSidebarSyncChanged() = 0;
+  };
+
+  explicit SidebarSyncService(Profile* profile);
+  SidebarSyncService(const SidebarSyncService&) = delete;
+  SidebarSyncService& operator=(const SidebarSyncService&) = delete;
+  ~SidebarSyncService() override;
+
+  // KeyedService:
+  void Shutdown() override;
+
+  // BrowserCollectionObserver:
+  void OnBrowserCreated(BrowserWindowInterface* browser) override;
+  void OnBrowserClosed(BrowserWindowInterface* browser) override;
+  void OnBrowserActivated(BrowserWindowInterface* browser) override;
+  void OnBrowserDeactivated(BrowserWindowInterface* browser) override;
+
+  // SpaceRegistry::Observer:
+  void OnRegistryChanged() override;
+  void OnRegistrySpaceRemoved(const SpaceId& id) override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  bool enabled() const;
+  base::FilePath folder() const;
+
+  // Sf7, Sf31, Sf35: everything the Settings box shows.
+  base::DictValue GetStatus();
+
+  // Sf8, Sf9: checks the folder the user picked and reads what is in it,
+  // writing nothing, and answers with the sheet's content -- or with
+  // {"refusal": "inside" | "missing" | "unwritable" | "denied"}.
+  using PreviewCallback = base::OnceCallback<void(base::DictValue)>;
+  void PreviewJoin(const base::FilePath& picked, PreviewCallback done);
+  // Sf9, Sf10: the answer to the sheet. With `combine`, the pairs at
+  // `accepted` (indices into the preview's) become one; Keep both pairs
+  // nothing. A backup is taken first, and sync starts once it is written;
+  // when it cannot be, sync stays off and Settings says so. False when no
+  // preview waits.
+  bool ConfirmJoin(bool combine,
+                   const std::string& device_name,
+                   const std::vector<size_t>& accepted);
+  // Cancel: sync stays off and nothing was written.
+  void CancelJoin();
+
+  void SetDeviceName(const std::string& name);
+  // Sf13: reads the folder now.
+  void SyncNow();
+  // Sf37: stops; nothing in the sidebar changes and the files stay, this
+  // install's own only when `remove_own_file`.
+  void Stop(bool remove_own_file);
+
+  // Sf22-Sf25, Sf28, Sf20: answers a waiting row. `id` is the row's, as
+  // GetStatus() gives it; `choice` one of the row's buttons. A held batch's
+  // Apply waits for its backup to be written, and stays held when it cannot
+  // be.
+  bool ResolveDecision(const std::string& id, const std::string& choice);
+  // Sf35: restores what a batch from another computer changed, here and on
+  // the other computers.
+  bool UndoBatch(const std::string& id);
+  // Sf35: the backup named `name`, for Import.
+  base::FilePath BackupPath(const std::string& name) const;
+
+  // Test hooks: runs a commit of the user's edits now, and calls `done` once
+  // the folder has been read and merged.
+  void CommitForTesting();
+  void ScanForTesting(base::OnceClosure done);
+  void SetClockForTesting(base::Clock* clock);
+  const sidebar_sync::Ledger* ledger_for_testing() const {
+    return ledger_ ? &*ledger_ : nullptr;
+  }
+  bool observing_for_testing() const { return observing_; }
+
+  // Called by the window watches (sidebar_sync_service.cc).
+  void OnSidebarMaybeChanged();
+  void OnTabRemovedFromStrip(content::WebContents* contents,
+                             TabStripModel* strip);
+  void OnTabLeftItsRole(tabs::TabInterface* tab, TabStripModel* strip);
+  void OnFolderLeftTheRun(const std::string& folder_id, TabStripModel* strip);
+  void OnActiveTabChanged(tabs::TabInterface* tab);
+  void OnWindowWillCloseAllTabs();
+
+ private:
+  struct PendingJoin;
+  struct HeldBatch;
+
+  int64_t NowMs() const;
+  std::map<std::string, std::string> Resolved() const;
+  std::string DeviceName() const;
+
+  void OnFolderPrefChanged();
+  void StartObserving();
+  void StopObserving();
+  void EnsureWatches();
+  void MaybeBecomeReady();
+  void NoteViewBeforeReady();
+  void OnSessionRestored(Profile* profile, int tabs);
+  void OnLedgerLoaded(std::optional<sidebar_sync::Ledger> ledger);
+  void BecomeReady();
+  void StartWatcher();
+  void OnWatchStarted(bool watching);
+  void OnFolderEvent();
+  void OnClosingAllBrowsers(bool closing);
+
+  bool CanRecordIntent(const TabStripModel* strip) const;
+  void NoteIntent(const std::string& id);
+
+  void Commit();
+  void Scan();
+  void OnScanned(base::OnceClosure done, sidebar_sync::ScanResult result);
+  bool MergePeer(const std::string& install,
+                 const sidebar_sync::ParsedFile& parsed,
+                 bool force);
+  void Apply();
+  void WriteOwnFile();
+  void WriteOwnFileOnceNoted(base::FilePath dir,
+                             std::string name,
+                             std::string json);
+  void OnOwnFileWritten(bool ok);
+  // Writes the ledger, then runs `saved` here.
+  void SaveLedger(base::OnceClosure saved = base::OnceClosure());
+  void RefreshBackups();
+  void OnBackupsListed(std::vector<base::FilePath> backups);
+  void TakeNewInstallId();
+  void OnJoinScanned(PreviewCallback done, sidebar_sync::JoinScan scan);
+  void FinishJoin(std::unique_ptr<PendingJoin> join,
+                  bool combine,
+                  std::string device_name,
+                  std::vector<size_t> accepted,
+                  bool backed_up);
+  void ApplyHeldBatch(std::string install,
+                      std::unique_ptr<HeldBatch> held,
+                      bool backed_up);
+  // Sf9, Sf22: writes `state` as a backup, then runs `written` with whether
+  // it was written.
+  void TakeBackup(const sidebar_sync::State& state,
+                  base::OnceCallback<void(bool)> written);
+  void OnBackupWritten(base::OnceCallback<void(bool)> written,
+                       base::FilePath path);
+  void NotifyObservers();
+
+  const raw_ptr<Profile> profile_;
+  raw_ptr<base::Clock> clock_;
+  PrefChangeRegistrar prefs_;
+  scoped_refptr<base::SequencedTaskRunner> io_runner_;
+  scoped_refptr<base::SequencedTaskRunner> write_runner_;
+  scoped_refptr<base::SequencedTaskRunner> ledger_runner_;
+
+  // Sync is on and the windows and the registry are observed.
+  bool observing_ = false;
+  // Sf14, Sf32: a window has been up, session restore is over and the
+  // ledger is loaded; only then is the folder opened.
+  bool seen_window_ = false;
+  bool loading_ledger_ = false;
+  bool ready_ = false;
+  bool applying_ = false;
+  bool closing_all_browsers_ = false;
+
+  std::optional<sidebar_sync::Ledger> ledger_;
+  // Sf12: what this install last saw in its windows, the `before` of the
+  // next commit. Before the ledger is read, what the windows showed then.
+  std::optional<sidebar_sync::LocalView> last_view_;
+  // Sf18: ids the user removed in a live window since the last commit.
+  std::set<std::string> intents_;
+
+  // Waiting for the user (Sf22-Sf25).
+  std::map<std::string, std::unique_ptr<HeldBatch>> held_batches_;
+  std::set<std::string> isolation_questions_;
+  std::set<std::string> held_moves_;
+  std::set<std::string> move_now_;
+  size_t deferred_ = 0;
+
+  // Sf27-Sf31, Sf34: what Settings says is wrong, by install where a peer.
+  bool unreachable_ = false;
+  bool denied_ = false;
+  bool write_failed_ = false;
+  // Sf9, Sf22: the last backup before a join or an Apply could not be
+  // written, so that join or Apply did not happen.
+  bool backup_failed_ = false;
+  bool watch_failed_ = false;
+  bool ledger_lost_ = false;
+  std::map<std::string, std::string> newer_;
+  std::map<std::string, std::string> clock_ahead_;
+  std::map<std::string, std::string> unreadable_;
+  std::set<std::string> waiting_download_;
+  std::vector<std::string> conflict_copies_;
+  std::vector<base::FilePath> backups_;
+
+  bool scan_in_flight_ = false;
+  bool scan_again_ = false;
+  std::vector<base::OnceClosure> scan_done_;
+  bool write_in_flight_ = false;
+  bool write_again_ = false;
+  int write_failures_ = 0;
+  base::TimeTicks last_activation_scan_;
+
+  base::OneShotTimer commit_timer_;
+  base::OneShotTimer scan_timer_;
+  base::OneShotTimer retry_timer_;
+  base::RepeatingTimer poll_timer_;
+
+  base::SequenceBound<sidebar_sync::FolderWatcher> watcher_;
+  std::map<BrowserWindowInterface*,
+           std::unique_ptr<sidebar_sync::WindowWatch>>
+      watches_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browsers_observation_{this};
+  base::ScopedObservation<SpaceRegistry, SpaceRegistry::Observer>
+      registry_observation_{this};
+  base::CallbackListSubscription session_restored_;
+  base::CallbackListSubscription closing_all_;
+
+  std::unique_ptr<PendingJoin> pending_join_;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<SidebarSyncService> weak_factory_{this};
+};
+
