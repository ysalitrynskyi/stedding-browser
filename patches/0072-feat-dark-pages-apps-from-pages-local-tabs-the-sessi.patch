+using Form = stedding::IsolationMarkView::Form;
+
+// The Spaces section's row for the Space whose id is $1, through every
+// shadow root: "<what its mark says>|<switch or no switch>|<its name field's
+// accessible description>", or "unlisted" until the page draws the row. A
+// mark is counted only while it is drawn with a size.
+constexpr char kSettingsRow[] = R"(
+  (() => {
+    const find = (root, selector) => {
+      const hit = root.querySelector(selector);
+      if (hit) {
+        return hit;
+      }
+      for (const element of root.querySelectorAll('*')) {
+        if (element.shadowRoot) {
+          const found = find(element.shadowRoot, selector);
+          if (found) {
+            return found;
+          }
+        }
+      }
+      return null;
+    };
+    const name = find(document, 'cr-input.space-name[data-id="' + $1 + '"]');
+    if (!name) {
+      return 'unlisted';
+    }
+    const mark = find(document, '.isolation-mark[data-id="' + $1 + '"]');
+    const shown = mark && mark.offsetWidth > 0 ? mark.title : '';
+    const toggle =
+        find(document, 'cr-toggle.space-isolated[data-id="' + $1 + '"]');
+    return shown + '|' + (toggle ? 'switch' : 'no switch') + '|' +
+        (name.getAttribute('aria-description') || '');
+  })()
+)";
+
+// The choices of Settings' dropdown of links from other apps, one a line, or
+// "unlisted" until the page draws it.
+constexpr char kSettingsExternalChoices[] = R"(
+  (() => {
+    const find = (root, selector) => {
+      const hit = root.querySelector(selector);
+      if (hit) {
+        return hit;
+      }
+      for (const element of root.querySelectorAll('*')) {
+        if (element.shadowRoot) {
+          const found = find(element.shadowRoot, selector);
+          if (found) {
+            return found;
+          }
+        }
+      }
+      return null;
+    };
+    const menu = find(document, '#externalDefaultSpace');
+    const select = menu && menu.shadowRoot ?
+        menu.shadowRoot.querySelector('select') : null;
+    if (!select || select.options.length === 0) {
+      return 'unlisted';
+    }
+    return [...select.options].map(option => option.textContent.trim())
+        .join('\n');
+  })()
+)";
+
+// The archive page's row titled $1: "<its Space's name>|<what the mark after
+// it says, '' with none>", or "unlisted" until the page draws the row; then,
+// after a line break, its Space filter's choices, one a line.
+constexpr char kArchiveRow[] = R"(
+  (() => {
+    const row = [...document.querySelectorAll('.row')].find(
+        row => row.querySelector('.title').textContent === $1);
+    if (!row) {
+      return 'unlisted';
+    }
+    const space = row.querySelector('.space');
+    const mark = space ? space.querySelector('.isolation-mark') : null;
+    const shown = mark && mark.offsetWidth > 0 ? mark.title : '';
+    const choices = [...document.querySelectorAll('header select option')]
+        .map(option => option.textContent.trim());
+    return [(space ? space.firstChild.textContent : '') + '|' + shown,
+            ...choices].join('\n');
+  })()
+)";
