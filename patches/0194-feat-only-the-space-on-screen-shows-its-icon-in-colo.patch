+// spaces B11 (GitHub issue 122, BACKLOG S-548): only the Space on screen is
+// in colour. Every other chip's glyph is grey, at 50%, in the open row and in
+// the rail; the chip a drag would drop on (B12) is in colour at full strength
+// while the drag is over it; a switch takes the colour along.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, OnlyTheSpaceOnScreenIsInColour) {
+  MakeThreeSpaces();
+  views::Widget* const window = browser_view()->GetWidget();
+  // The glyph a chip draws: its label, in a layer of its own, which the
+  // compositor greys.
+  const auto glyph = [&](const spaces::SpaceId& id) -> views::Label* {
+    views::test::RunScheduledLayout(window);
+    spaces::SpaceSwitcherView* const switcher = Switcher();
+    views::View* const chip = switcher ? switcher->ChipForTesting(id) : nullptr;
+    if (!chip) {
+      return nullptr;
+    }
+    for (views::View* const child : chip->children()) {
+      if (auto* const label = views::AsViewClass<views::Label>(child)) {
+        return label;
+      }
+    }
+    return nullptr;
+  };
+  // In colour at full strength, or grey at 50%.
+  const auto expect_look = [&](const spaces::SpaceId& id, bool in_colour) {
+    SCOPED_TRACE(base::UTF16ToUTF8(model()->DisplayName(id)));
+    views::Label* const label = glyph(id);
+    ASSERT_TRUE(label) << "no glyph on the chip";
+    ASSERT_TRUE(label->layer()) << "the glyph has no layer of its own";
+    EXPECT_FALSE(label->layer()->fills_bounds_opaquely());
+    EXPECT_EQ(in_colour ? 0.0f : 1.0f, label->layer()->layer_grayscale());
+    EXPECT_EQ(in_colour ? 0xFFu : 0x80u, SkColorGetA(label->GetEnabledColor()));
+  };
+  const auto expect_on_screen = [&](const spaces::SpaceId& on_screen) {
+    for (const spaces::SpaceId& id : ids_) {
+      expect_look(id, id == on_screen);
+    }
+  };
+
+  {
+    SCOPED_TRACE("the open sidebar");
+    expect_on_screen(ids_[0]);
+    ASSERT_TRUE(model()->SetActiveSpace(ids_[1]));
+    expect_on_screen(ids_[1]);
+  }
+  {
+    SCOPED_TRACE("a drag over another Space's chip");
+    Switcher()->SetDropTarget(ids_[2]);
+    expect_look(ids_[2], true);
+    expect_look(ids_[0], false);
+    Switcher()->SetDropTarget(std::nullopt);
+    expect_look(ids_[2], false);
+  }
+  {
+    SCOPED_TRACE("the rail");
+    vertical_tab_strip_state_controller()->SetExpandOnHoverEnabled(false);
+    Collapse();
+    expect_on_screen(ids_[1]);
+    ASSERT_TRUE(model()->SetActiveSpace(ids_[2]));
+    expect_on_screen(ids_[2]);
+  }
+}
