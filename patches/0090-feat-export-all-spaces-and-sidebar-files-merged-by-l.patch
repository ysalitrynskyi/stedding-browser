+// The sidebar file (docs/features/sidebar-file.md), as a person uses it.
+//
+// Sf2 (docs/history/plan-2026-09-26.md WEB-19): a file exported before a
+// restart and imported after it adds nothing. Its ids were the tabs' session
+// ids, new at every launch, and the folders' addresses in memory, so every
+// pin, folder and essential came in a second time.
+//
+// Sf6: Settings' "Export all Spaces..." writes one file to Downloads that
+// holds every Space of the window, its pins, its pinned folders and the
+// essentials.
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <algorithm>
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
