+// import I32: everything from Dia: its profile, the three parts, one button
+// and one result line. Nothing is read from Dia's keychain item before the
+// button (I31).
+function diaBlock(dia: DiaImport): HTMLDivElement {
+  const block = el('div', 'arc-import');
+  block.dataset['block'] = 'dia';
+  const head = el('div', 'arc-head');
+  const diaMark = el('span', 'glyph engine-mark', 'D');
+  diaMark.setAttribute('aria-hidden', 'true');
+  const title = el('div');
+  const chosen = dia.profiles[state.diaProfile] ?? dia.profiles[0];
+  title.append(el('div', 'name', 'Everything from Dia'),
+               el('div', 'hint', chosen ? chosen.summary : ''));
+  head.append(diaMark, title);
+  block.append(head);
+  if (dia.profiles.length > 1) {
+    const label = el('label', 'hint', 'Profile ');
+    const select = el('select');
+    select.dataset['focus'] = 'dia-profile';
+    dia.profiles.forEach((profile, index) => {
+      const option = el('option', undefined, profile.name);
+      option.value = String(index);
+      option.selected = index === state.diaProfile;
+      select.append(option);
+    });
+    select.addEventListener('change', () => {
+      state.diaProfile = Number(select.value);
+      state.diaStatus = '';
+      render();
+    });
+    label.append(select);
+    block.append(label);
+  }
+  if (dia.running) {
+    block.append(el('div', 'hint',
+                    'Dia is running: quit it first for a complete copy.'));
+  }
+  block.append(el('div', 'hint', isMac ?
+      'Everything stays on this Mac. For the passwords, macOS asks once ' +
+          'whether Stedding may read Dia\u2019s keychain item.' :
+      'Everything stays on this computer. Dia\u2019s passwords are read ' +
+          'with your Windows account\u2019s own key, so nothing asks.'));
+  const choices = el('div', 'import-row');
+  choices.append(
+      checkbox('Bookmarks', state.diaBookmarks, 'dia-bookmarks',
+               v => state.diaBookmarks = v),
+      checkbox('History', state.diaHistory, 'dia-history',
+               v => state.diaHistory = v),
+      checkbox('Passwords', state.diaPasswords, 'dia-passwords',
+               v => state.diaPasswords = v));
+  const button = el('button', 'primary',
+      state.diaStatus === 'inProgress' ? 'Moving\u2026' :
+      state.diaStatus ? 'Moved' : 'Move everything from Dia');
+  button.dataset['focus'] = 'dia-move';
+  button.disabled = state.diaStatus !== '';
+  button.addEventListener('click', () => {
+    state.diaStatus = 'inProgress';
+    render();
+    sendWithPromise('importFromDia', state.diaProfile, state.diaBookmarks,
+                    state.diaHistory, state.diaPasswords)
+        .then((line: unknown) => {
+          state.diaStatus = String(line);
+          render();
+        });
+  });
+  choices.append(button);
+  block.append(choices);
+  if (state.diaStatus && state.diaStatus !== 'inProgress') {
+    const result = el('div', 'hint', state.diaStatus);
+    result.dataset['result'] = 'dia';
+    result.setAttribute('role', 'status');
+    block.append(result);
+  }
+  return block;
+}
