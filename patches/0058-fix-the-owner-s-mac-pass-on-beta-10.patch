+  ASSERT_TRUE(region);
+  const TabStripView* const strip = FindTabStripView(region);
+  ASSERT_TRUE(strip);
+  views::View* const list = strip->unpinned_tabs_scroll_view();
+  ASSERT_TRUE(list);
+  gfx::Point at = region->GetBoundsInScreen().CenterPoint();
+  views::View::ConvertPointFromScreen(window->GetRootView(), &at);
+  const gfx::PointF point(at);
+  const auto send = [&](float dx, ui::ScrollEventPhase phase) {
+    ui::ScrollEvent scroll(ui::EventType::kScroll, point, point,
+                           ui::EventTimeForNow(), ui::EF_NONE, dx, 0, dx, 0,
+                           /*finger_count=*/2, ui::EventMomentumPhase::NONE,
+                           phase);
+    window->OnScrollEvent(&scroll);
+  };
+  const auto shift = [&]() {
+    return list->layer() ? list->layer()->transform().To2dTranslation().x()
+                         : 0.0f;
+  };
+
+  // 50 DIPs to the left, the fingers still down: the list is 50 DIPs to the
+  // left and fading, and the Space has not changed.
+  send(0, ui::ScrollEventPhase::kBegan);
+  send(-25, ui::ScrollEventPhase::kUpdate);
+  send(-25, ui::ScrollEventPhase::kUpdate);
+  ASSERT_TRUE(list->layer());
+  EXPECT_FLOAT_EQ(-50.0f, shift());
+  EXPECT_LT(list->layer()->opacity(), 1.0f);
+  EXPECT_EQ(ids_[0], model()->active_id());
+
+  // Lifted there: too short to switch; it goes back where it was.
+  send(0, ui::ScrollEventPhase::kEnd);
+  EXPECT_EQ(ids_[0], model()->active_id());
+  EXPECT_TRUE(list->layer()->GetTargetTransform().IsIdentity());
+  EXPECT_FLOAT_EQ(1.0f, list->layer()->GetTargetOpacity());
+
+  // Far enough: the next Space, its list coming in from the right.
+  send(0, ui::ScrollEventPhase::kBegan);
+  for (int i = 0; i < 5; ++i) {
+    send(-20, ui::ScrollEventPhase::kUpdate);
