new file mode 100644
index 0000000000000..06c16e4e68c9b
--- /dev/null
+++ b/chrome/browser/ui/stedding/thanks_pages.cc
@@ -0,0 +1,134 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/thanks_pages.h"
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/strcat.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding/stedding_version.h"
+#include "chrome/common/chrome_switches.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace stedding {
+
+namespace {
+
+bool g_decided_after_update = false;
+bool g_ignore_no_first_run = false;
+
+bool FirstRunSuppressed() {
+  return !g_ignore_no_first_run &&
+         base::CommandLine::ForCurrentProcess()->HasSwitch(
+             switches::kNoFirstRun);
+}
+
+void OpenThanksTab(base::WeakPtr<BrowserWindowInterface> browser, GURL url) {
+  if (!browser) {
+    return;
+  }
+  NavigateParams params(browser.get(), url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+}
+
+// The tab opens on the next turn of the loop, as the welcome flow does: the
+// window is shown before its restored tabs are settled.
+void OpenThanksTabSoon(BrowserWindowInterface& browser, GURL url) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&OpenThanksTab, browser.GetWeakPtr(), std::move(url)));
+}
+
+}  // namespace
+
+GURL ThanksAfterUpdateUrl(std::string_view version) {
+  return GURL(base::StrCat({kThanksAfterUpdateUrl, "#v", version}));
+}
+
+bool ShouldOpenThanksAfterUpdate(PrefService& local_state,
+                                 std::string_view version,
+                                 bool first_run_suppressed,
+                                 bool welcome_pending) {
+  if (version.empty()) {
+    return false;
+  }
+  const std::string last = local_state.GetString(prefs::kLastRunVersion);
+  local_state.SetString(prefs::kLastRunVersion, std::string(version));
+  if (first_run_suppressed || last == version ||
+      !local_state.GetBoolean(prefs::kThanksAfterUpdate)) {
+    return false;
+  }
+  if (last.empty()) {
+    // No version recorded: the install's own first run, whose page comes
+    // with the welcome flow, or a profile from a build before this one
+    // recorded versions, which is an update.
+    return !welcome_pending;
+  }
+  return IsLaterSteddingVersion(version, last);
+}
+
+bool ShouldOpenThanksAfterInstall(PrefService& local_state,
+                                  std::string_view version,
+                                  bool welcome_forced) {
+  if (version.empty() || welcome_forced ||
+      local_state.GetBoolean(prefs::kThanksAfterInstallShown)) {
+    return false;
+  }
+  local_state.SetBoolean(prefs::kThanksAfterInstallShown, true);
+  return true;
+}
+
+void MaybeOpenThanksAfterUpdate(BrowserWindowInterface& browser) {
+  // The first normal window decides, once per run; a popup or a private
+  // window that opens first leaves it to the next one.
+  if (g_decided_after_update ||
+      browser.GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      !browser.GetProfile() || browser.GetProfile()->IsOffTheRecord() ||
+      !g_browser_process || !g_browser_process->local_state()) {
+    return;
+  }
+  g_decided_after_update = true;
+  const bool welcome_pending =
+      !browser.GetProfile()->GetPrefs()->GetBoolean(prefs::kWelcomeShown);
+  if (ShouldOpenThanksAfterUpdate(*g_browser_process->local_state(),
+                                  SteddingVersion(), FirstRunSuppressed(),
+                                  welcome_pending)) {
+    OpenThanksTabSoon(browser, ThanksAfterUpdateUrl(SteddingVersion()));
+  }
+}
+
+void MaybeOpenThanksAfterInstall(BrowserWindowInterface& browser,
+                                 bool welcome_forced) {
+  if (!g_browser_process || !g_browser_process->local_state()) {
+    return;
+  }
+  if (ShouldOpenThanksAfterInstall(*g_browser_process->local_state(),
+                                   SteddingVersion(), welcome_forced)) {
+    OpenThanksTabSoon(browser, GURL(kThanksAfterInstallUrl));
+  }
+}
+
+void ResetThanksAfterUpdateForTesting() {
+  g_decided_after_update = false;
+}
+
+void IgnoreNoFirstRunForTesting(bool ignore) {
+  g_ignore_no_first_run = ignore;
+}
+
+}  // namespace stedding
