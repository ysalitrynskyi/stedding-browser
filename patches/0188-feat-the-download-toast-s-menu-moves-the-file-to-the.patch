+// Stedding, sidebar-panels Pn19 (GitHub discussion 116): the menu of a
+// finished download in the bubble, the toast a new download shows, offers
+// the Downloads panel's Move to Trash (Pn11) and Remove from List (Pn9).
+// The file goes to the Trash, never deleted outright; Remove from List takes
+// the download off the list and is offered only where the profile may
+// delete history; a file already gone cannot be moved.
+TEST_F(DownloadUiContextMenuTest, SteddingAFinishedDownloadsVerbs) {
+  TestingProfile profile;
+  NiceMock<download::MockDownloadItem> item;
+  content::DownloadItemUtils::AttachInfoForTesting(&item, &profile, nullptr);
+  // The download's own file: empty, as the item wrote no bytes, and Move to
+  // Trash moves only the download's own file (Pn19).
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().AppendASCII("a-file.pdf");
+  ASSERT_TRUE(base::WriteFile(path, ""));
+  ON_CALL(item, GetState())
+      .WillByDefault(Return(download::DownloadItem::COMPLETE));
+  ON_CALL(item, GetTargetFilePath()).WillByDefault(ReturnRefOfCopy(path));
+  ON_CALL(item, GetFileExternallyRemoved()).WillByDefault(Return(false));
+  auto download = DownloadItemModel::Wrap(&item);
+  MakeContextMenu(download.get());
+  ui::SimpleMenuModel* const model = menu()->GetMenuModel();
+  ASSERT_TRUE(model);
+
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+  ASSERT_TRUE(
+      model->GetIndexOfCommandId(DownloadUiContextMenu::kSteddingMoveToTrash))
+      << "no Move to Trash";
+  EXPECT_TRUE(
+      menu()->IsCommandIdEnabled(DownloadUiContextMenu::kSteddingMoveToTrash));
+  base::FilePath trashed;
+  stedding::SetMoveToTrashForTesting(
+      base::BindLambdaForTesting([&](const base::FilePath& file) {
+        trashed = file;
+        return true;
+      }));
+  menu()->ExecuteCommand(DownloadUiContextMenu::kSteddingMoveToTrash, 0);
+  RunUntilIdle();
+  stedding::SetMoveToTrashForTesting(
+      base::RepeatingCallback<bool(const base::FilePath&)>());
+  EXPECT_EQ(path, trashed) << "the file did not go to the Trash";
+#endif
+
+  ASSERT_TRUE(model->GetIndexOfCommandId(
+      DownloadUiContextMenu::kSteddingRemoveFromList))
+      << "no Remove from List";
+  EXPECT_TRUE(menu()->IsCommandIdVisible(
+      DownloadUiContextMenu::kSteddingRemoveFromList));
+  EXPECT_CALL(item, Remove()).Times(1);
+  menu()->ExecuteCommand(DownloadUiContextMenu::kSteddingRemoveFromList, 0);
+  testing::Mock::VerifyAndClearExpectations(&item);
+
+  profile.GetPrefs()->SetBoolean(prefs::kAllowDeletingBrowserHistory, false);
+  EXPECT_FALSE(menu()->IsCommandIdVisible(
+      DownloadUiContextMenu::kSteddingRemoveFromList))
+      << "offered where the profile may not delete history";
+  EXPECT_CALL(item, Remove()).Times(0);
+  menu()->ExecuteCommand(DownloadUiContextMenu::kSteddingRemoveFromList, 0);
+
+  ON_CALL(item, GetFileExternallyRemoved()).WillByDefault(Return(true));
+  EXPECT_FALSE(
+      menu()->IsCommandIdEnabled(DownloadUiContextMenu::kSteddingMoveToTrash))
+      << "a file already gone can be moved";
+}
+
+// Stedding, sidebar-panels Pn19: Move to Trash moves the file at the
+// download's path only while it is that download's. With its file deleted
+// by hand, a download of the same name takes the free name, and the first
+// row's Move to Trash took the second download's file. A file of another
+// size, or one of the same size written after the download finished, stays
+// where it is; the download's own goes.
+TEST_F(DownloadUiContextMenuTest, SteddingMovesOnlyTheDownloadsOwnFile) {
+#if !BUILDFLAG(IS_MAC) && !BUILDFLAG(IS_WIN)
+  GTEST_SKIP() << "no Move to Trash on this platform";
+#else
+  TestingProfile profile;
+  NiceMock<download::MockDownloadItem> item;
+  content::DownloadItemUtils::AttachInfoForTesting(&item, &profile, nullptr);
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().AppendASCII("report.pdf");
+  const std::string contents = "the second download's file";
+  ASSERT_TRUE(base::WriteFile(path, contents));
+  const base::Time written = base::Time::Now() - base::Days(1);
+  ASSERT_TRUE(base::TouchFile(path, written, written));
+  ON_CALL(item, GetState())
+      .WillByDefault(Return(download::DownloadItem::COMPLETE));
+  ON_CALL(item, GetTargetFilePath()).WillByDefault(ReturnRefOfCopy(path));
+  ON_CALL(item, GetFileExternallyRemoved()).WillByDefault(Return(false));
+  auto download = DownloadItemModel::Wrap(&item);
+  MakeContextMenu(download.get());
+
+  std::vector<base::FilePath> trashed;
+  stedding::SetMoveToTrashForTesting(
+      base::BindLambdaForTesting([&](const base::FilePath& file) {
+        trashed.push_back(file);
+        return true;
+      }));
+  // The stand-in is taken away before the locals it holds go.
+  base::ScopedClosureRunner restore_trash(base::BindOnce([] {
+    stedding::SetMoveToTrashForTesting(
+        base::RepeatingCallback<bool(const base::FilePath&)>());
+  }));
+  const auto trash = [&]() {
+    trashed.clear();
+    // Through the delegate's public face: a lambda is no friend of the menu.
+    static_cast<ui::SimpleMenuModel::Delegate*>(menu())->ExecuteCommand(
+        DownloadUiContextMenu::kSteddingMoveToTrash, 0);
+    RunUntilIdle();
+    return !trashed.empty();
+  };
+
+  // The first download wrote ten bytes and finished an hour before the file
+  // there was written.
+  ON_CALL(item, GetReceivedBytes()).WillByDefault(Return(10));
+  ON_CALL(item, GetEndTime()).WillByDefault(Return(written - base::Hours(1)));
+  EXPECT_FALSE(trash()) << "a file of another size went to the Trash";
+  ON_CALL(item, GetReceivedBytes())
+      .WillByDefault(Return(static_cast<int64_t>(contents.size())));
+  EXPECT_FALSE(trash())
+      << "a file written after the download finished went to the Trash";
+  EXPECT_TRUE(base::PathExists(path));
+
+  // The download's own: its size, written as it finished.
+  ON_CALL(item, GetEndTime()).WillByDefault(Return(written));
+  EXPECT_TRUE(trash()) << "the download's own file did not go to the Trash";
+  ASSERT_EQ(1u, trashed.size());
+  EXPECT_EQ(path, trashed.front());
+#endif
+}
