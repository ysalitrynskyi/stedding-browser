+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace spaces {
+namespace {
+
+// One Space whose pinned run holds a web page, a bookmarklet and a local
+// file, a bookmarklet among its loose tabs, and one among the essentials.
+constexpr char kSidebarWithOddPages[] = R"json({
+  "sidebar": {"containers": [
+    {"global": {}},
+    {
+      "spaces": [
+        "space-work", {
+          "id": "space-work", "title": "Work",
+          "containerIDs": ["pinned", "cont-pinned", "unpinned", "cont-unpinned"]
+        }
+      ],
+      "items": [
+        "cont-pinned", {"id": "cont-pinned", "parentID": null,
+          "childrenIds": ["tab-web", "tab-js", "tab-file"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-unpinned", {"id": "cont-unpinned", "parentID": null,
+          "childrenIds": ["tab-js2"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-top", {"id": "cont-top", "parentID": null,
+          "childrenIds": ["tab-js3"], "title": "",
+          "data": {"itemContainer": {"containerType": {"topApps": {}}}}},
+        "tab-web", {"id": "tab-web", "parentID": "cont-pinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "https://mail.example/", "savedTitle": "Mail"}}},
+        "tab-js", {"id": "tab-js", "parentID": "cont-pinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "javascript:alert(document.cookie)",
+            "savedTitle": "Bookmarklet"}}},
+        "tab-file", {"id": "tab-file", "parentID": "cont-pinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "file:///tmp/notes.html",
+            "savedTitle": "Notes"}}},
+        "tab-js2", {"id": "tab-js2", "parentID": "cont-unpinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "javascript:void(0)", "savedTitle": "Loose"}}},
+        "tab-js3", {"id": "tab-js3", "parentID": "cont-top",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "javascript:void(1)", "savedTitle": "Top"}}}
+      ],
+      "topAppsContainerIDs": [{"default": "cont-top"}, "cont-top"]
+    }
+  ]}
+})json";
+
+constexpr char kNotes[] = "file:///tmp/notes.html";
+
+// A bookmarklet is no page: it never comes in, pinned, loose or as an
+// essential. A local file is a page, and does.
+TEST(PinHomeImportTest, ABookmarkletNeverComesIn) {
+  const std::optional<ArcImportPlan> plan =
+      ParseArcSidebar(kSidebarWithOddPages);
+  ASSERT_TRUE(plan.has_value());
+  ASSERT_EQ(1u, plan->spaces.size());
+  const ArcImportPlan::Space& work = plan->spaces[0];
+  ASSERT_EQ(2u, work.pinned.size());
+  EXPECT_EQ(GURL("https://mail.example/"), work.pinned[0].url);
+  EXPECT_EQ(GURL(kNotes), work.pinned[1].url);
+  EXPECT_TRUE(work.unpinned.empty());
+  EXPECT_TRUE(plan->essentials.empty());
+}
+
+class PinHomeImportWindowTest : public BrowserWithTestWindowTest {
+ protected:
+  SpaceModel& model() { return *SpaceModel::From(browser()); }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+};
+
+// The Done-when of TAB-17: after an import no pin, of either tier, has a
+// home that is not a web page, nothing runs a javascript: URL, and the local
+// file is still a pin, one without a home.
+TEST_F(PinHomeImportWindowTest, ImportedPinsHaveOnlyWebHomes) {
+  const std::optional<ArcImportPlan> plan =
+      ParseArcSidebar(kSidebarWithOddPages);
+  ASSERT_TRUE(plan.has_value());
+  ApplyArcImport(browser(), *plan, ArcImportOptions());
+
+  bool notes_found = false;
+  for (int i = 0; i < tabs().count(); ++i) {
+    tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+    const GURL page = tab->GetContents()->GetVisibleURL();
+    EXPECT_FALSE(page.SchemeIs(url::kJavaScriptScheme)) << page.spec();
+    if (const std::optional<GURL> home = model().HomeUrl(tab)) {
+      EXPECT_TRUE(stedding::IsAllowedPinHome(*home)) << home->spec();
+    }
+    if (page == GURL(kNotes)) {
+      notes_found = true;
+      EXPECT_TRUE(model().IsSpacePinned(tab));
+      EXPECT_FALSE(model().HomeUrl(tab).has_value());
+    }
+  }
+  EXPECT_TRUE(notes_found);
+}
+
+// A sidebar file never carries a home that is not a web page to the next
+// import: a pin with one is written as the page it shows.
+TEST_F(PinHomeImportWindowTest, SnapshotWritesAPinAsAWebPage) {
+  AddTab(browser(), GURL("https://mail.example/inbox"));
+  tabs::TabInterface* const pin = tabs().GetActiveTab();
+  model().SetSpacePinned(pin, true);
+  // A home from before H13; the model may already refuse it.
+  model().SetHomeUrl(pin, GURL("javascript:alert(1)"));
+
+  const ArcImportPlan plan = SnapshotSpace(browser(), model().active_id());
+  ASSERT_EQ(1u, plan.spaces.size());
+  ASSERT_EQ(1u, plan.spaces[0].pinned.size());
+  EXPECT_EQ(GURL("https://mail.example/inbox"), plan.spaces[0].pinned[0].url);
+}
+
+}  // namespace
+}  // namespace spaces
