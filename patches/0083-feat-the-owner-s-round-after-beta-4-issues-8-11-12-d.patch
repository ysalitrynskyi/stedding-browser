+// pins H14, folders F38 (the owner, 2026-10-28): a tab that joins a pinned
+// folder -- a row dropped on its collapsed header, or New Tab in Folder -- is
+// one of its pins, so the folder stays pinned. It had stayed loose, and the
+// folder read as unpinned and left the pinned run.
+TEST_F(FolderCommandsTest, APinnedFolderKeepsItsPinWhenATabJoins) {
+  tabs::TabInterface* const loose = OpenTab(GURL("https://loose.test/"));
+  OpenTab(GURL("https://q.test/"));
+  OpenTab(GURL("https://p.test/"));
+  // p, q, loose: F[p, q], pinned and collapsed, the active tab outside it.
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder({0, 1});
+  ASSERT_NE(nullptr, folder);
+  ASSERT_TRUE(model().CanPinFolder(folder));
+  model().SetFolderSpacePinned(folder, true);
+  ASSERT_TRUE(model().IsFolderSpacePinned(folder));
+  folder->SetCollapsed(true);
+  Activate(loose);
+
+  // What a drop on the header does: the move, then the folder's pin kept.
+  const bool was_pinned = model().IsFolderSpacePinned(folder);
+  ASSERT_TRUE(tabs().MoveTabsToFolder({tabs().GetIndexOfTab(loose)}, folder));
+  model().KeepFolderPinned(folder, was_pinned);
+  EXPECT_TRUE(model().IsSpacePinned(loose)) << "the row dropped in stayed loose";
+  EXPECT_TRUE(model().IsFolderSpacePinned(folder)) << "the folder lost its pin";
+
+  tabs::TabInterface* const fresh = NewTabInFolder(tabs(), folder);
+  ASSERT_NE(nullptr, fresh);
+  EXPECT_TRUE(model().IsSpacePinned(fresh)) << "New Tab in Folder left it loose";
+  EXPECT_TRUE(model().IsFolderSpacePinned(folder));
+}
