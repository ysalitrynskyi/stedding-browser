+namespace {
+
+// What the browser asked of the stand-in for Sparkle.
+struct FakeSparkle {
+  NSDate* __strong last_check = nil;
+  int starts = 0;
+  int background_checks = 0;
+  int user_checks = 0;
+  // The browser's user driver and updater delegate, one object, as Sparkle
+  // was handed them: a test plays Sparkle's part through it.
+  id __strong driver = nil;
+};
+
+FakeSparkle* g_sparkle = nullptr;
+
+}  // namespace
+
+// The user driver's and the delegate's methods a test calls as Sparkle would
+// (Sparkle's SPUUserDriver, SPUUpdaterDelegate).
+@protocol SteddingFakeSparkleCalls <NSObject>
+- (void)showUpdateFoundWithAppcastItem:(id)appcastItem
+                                 state:(id)state
+                                 reply:(void (^)(NSInteger))reply;
+- (void)showReadyToInstallAndRelaunch:(void (^)(NSInteger))reply;
+- (void)showInstallingUpdateWithApplicationTerminated:(BOOL)applicationTerminated
+                          retryTerminatingApplication:
+                              (void (^)(void))retryTerminatingApplication;
+- (void)showUpdaterError:(NSError*)error
+         acknowledgement:(void (^)(void))acknowledgement;
+- (void)dismissUpdateInstallation;
+- (void)updater:(id)updater didFindValidUpdate:(id)item;
+- (BOOL)updater:(id)updater
+       willInstallUpdateOnQuit:(id)item
+    immediateInstallationBlock:(void (^)(void))immediateInstallHandler;
+@end
+
+// An update in the feed, as Sparkle's SUAppcastItem tells it.
+@interface SteddingFakeSparkleItem : NSObject
+@property(nonatomic, copy) NSString* displayVersionString;
+@property(nonatomic, getter=isInformationOnlyUpdate)
+    BOOL informationOnlyUpdate;
+@property(nonatomic) NSInteger signingValidationStatus;
+@end
+
+@implementation SteddingFakeSparkleItem
+@synthesize displayVersionString = _displayVersionString;
+@synthesize informationOnlyUpdate = _informationOnlyUpdate;
+@synthesize signingValidationStatus = _signingValidationStatus;
+@end
+
+// Where an update stands, as Sparkle's SPUUserUpdateState tells it.
+@interface SteddingFakeSparkleState : NSObject
+@property(nonatomic) NSInteger stage;
+@property(nonatomic) BOOL userInitiated;
+@end
+
+@implementation SteddingFakeSparkleState
+@synthesize stage = _stage;
+@synthesize userInitiated = _userInitiated;
+@end
+
+// A stand-in for Sparkle's SPUUpdater: it answers as Sparkle does and counts
+// what it is asked to do. Sparkle's own schedule is not run.
+@interface SteddingFakeSparkleUpdater : NSObject
+@property(nonatomic) BOOL automaticallyChecksForUpdates;
+@property(nonatomic) BOOL automaticallyDownloadsUpdates;
+@property(nonatomic) BOOL sendsSystemProfile;
+@end
+
+@implementation SteddingFakeSparkleUpdater
+
+@synthesize automaticallyChecksForUpdates = _automaticallyChecksForUpdates;
+@synthesize automaticallyDownloadsUpdates = _automaticallyDownloadsUpdates;
+@synthesize sendsSystemProfile = _sendsSystemProfile;
+
+- (instancetype)initWithHostBundle:(NSBundle*)hostBundle
+                 applicationBundle:(NSBundle*)applicationBundle
+                        userDriver:(id)userDriver
+                          delegate:(id)delegate {
+  g_sparkle->driver = userDriver;
+  return [super init];
+}
+
+- (BOOL)startUpdater:(NSError**)error {
+  ++g_sparkle->starts;
+  return YES;
+}
+
+- (void)checkForUpdates {
+  ++g_sparkle->user_checks;
+}
+
+- (void)checkForUpdatesInBackground {
+  ++g_sparkle->background_checks;
+}
+
+- (BOOL)canCheckForUpdates {
+  return YES;
+}
+
+- (NSDate*)lastUpdateCheckDate {
+  return g_sparkle->last_check;
+}
+
+@end
+
+namespace stedding {
+namespace {
+
+// Sparkle's SPUUserUpdateChoice and SPUUserUpdateStage, and the error a
+// cancelled administrator's password ends an install with (SUError 4007).
+constexpr NSInteger kInstall = 1;
+constexpr NSInteger kNotDownloaded = 0;
+constexpr NSInteger kInstallationCanceled = 4007;
+
+// A later version Sparkle found on its own schedule that it cannot install
+// alone: the app is not the user's to replace, so it needs an
+// administrator's password (updates Up4).
+SteddingFakeSparkleItem* LaterVersion() {
+  SteddingFakeSparkleItem* const item = [[SteddingFakeSparkleItem alloc] init];
+  item.displayVersionString = @"0.4.0-beta.2";
+  return item;
+}
+
+SteddingFakeSparkleState* FoundOnSchedule() {
+  SteddingFakeSparkleState* const state =
+      [[SteddingFakeSparkleState alloc] init];
+  state.stage = kNotDownloaded;
+  state.userInitiated = NO;
+  return state;
+}
+
+class AppUpdaterMacTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    prefs::RegisterLocalStatePrefs(local_state_.registry());
+    g_sparkle = &sparkle_;
+  }
+
+  void TearDown() override {
+    updater_.reset();
+    g_sparkle = nullptr;
+  }
+
+  // A launch, `since_last_check` after Sparkle's last check (none: it never
+  // checked).
+  void Launch(std::optional<base::TimeDelta> since_last_check) {
+    updater_.reset();
+    sparkle_ = FakeSparkle();
+    if (since_last_check) {
+      sparkle_.last_check = (base::Time::Now() - *since_last_check).ToNSDate();
+    }
+    updater_ = CreateSparkleAppUpdater(
+        [SteddingFakeSparkleUpdater class], &local_state_,
+        base::BindRepeating([](int* restarts) { ++*restarts; }, &restarts_));
+  }
+
+  // The browser as Sparkle sees it.
+  id<SteddingFakeSparkleCalls> Driver() { return sparkle_.driver; }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  TestingPrefServiceSimple local_state_;
+  FakeSparkle sparkle_;
+  std::unique_ptr<AppUpdater> updater_;
+  // How often the browser was made ready to quit and install.
+  int restarts_ = 0;
+};
+
+// updates Up1 (the owner's decision of 2026-10-21): ten seconds after a launch
+// more than an hour after the last check, the browser starts Sparkle and asks
+// it for a background check; a launch within the hour of a check only starts
+// Sparkle, whose six-hour schedule makes the next.
+TEST_F(AppUpdaterMacTest, ALaunchChecksWhenTheLastCheckIsOverAnHourOld) {
+  Launch(base::Minutes(30));
+  task_environment_.FastForwardBy(base::Seconds(10));
+  EXPECT_EQ(1, sparkle_.starts) << "Sparkle's schedule runs";
+  EXPECT_EQ(0, sparkle_.background_checks) << "half an hour after a check";
+
+  Launch(base::Hours(2));
+  task_environment_.FastForwardBy(base::Seconds(9));
+  EXPECT_EQ(0, sparkle_.starts) << "nothing before ten seconds";
+  EXPECT_EQ(0, sparkle_.background_checks);
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(1, sparkle_.starts);
+  EXPECT_EQ(1, sparkle_.background_checks) << "two hours after a check";
+  task_environment_.FastForwardBy(base::Days(1));
+  EXPECT_EQ(1, sparkle_.background_checks)
+      << "after the launch's check, Sparkle's schedule makes the next";
+
+  Launch(std::nullopt);
+  task_environment_.FastForwardBy(base::Seconds(10));
+  EXPECT_EQ(1, sparkle_.background_checks) << "a copy that never checked";
+  EXPECT_EQ(0, sparkle_.user_checks);
+}
+
+// updates Up6: with automatic updates off a launch neither starts Sparkle nor
+// checks, and turning them off during the ten seconds is as good.
+TEST_F(AppUpdaterMacTest, WithAutomaticUpdatesOffALaunchMakesNoCheck) {
+  local_state_.SetBoolean(prefs::kUpdatesAutomatic, false);
+  Launch(base::Hours(2));
+  task_environment_.FastForwardBy(base::Days(1));
+  EXPECT_EQ(0, sparkle_.starts);
+  EXPECT_EQ(0, sparkle_.background_checks);
+
+  local_state_.SetBoolean(prefs::kUpdatesAutomatic, true);
+  Launch(base::Hours(2));
+  task_environment_.FastForwardBy(base::Seconds(5));
+  local_state_.SetBoolean(prefs::kUpdatesAutomatic, false);
+  task_environment_.FastForwardBy(base::Days(1));
+  EXPECT_EQ(0, sparkle_.background_checks);
+}
+
+// updates Up7: Check for Updates during the ten seconds is the launch's
+// check; no background check follows it.
+TEST_F(AppUpdaterMacTest, ACheckTheUserAsksForAtLaunchIsTheLaunchsCheck) {
+  Launch(base::Hours(2));
+  updater_->CheckNow();
+  EXPECT_EQ(1, sparkle_.user_checks);
+  EXPECT_EQ(AppUpdater::State::kChecking, updater_->state());
+  task_environment_.FastForwardBy(base::Seconds(10));
+  EXPECT_EQ(1, sparkle_.starts);
+  EXPECT_EQ(0, sparkle_.background_checks);
+}
+
+// updates Up1: Sparkle's schedule, which the app's Info.plist sets, is the
+// browser's six hours.
+TEST_F(AppUpdaterMacTest, SparklesScheduleIsSixHours) {
+  base::FilePath src;
+  ASSERT_TRUE(base::PathService::Get(base::DIR_SRC_TEST_DATA_ROOT, &src));
+  NSDictionary* const plist = [NSDictionary
+      dictionaryWithContentsOfURL:base::apple::FilePathToNSURL(src.AppendASCII(
+                                      "chrome/app/app-Info.plist"))];
+  ASSERT_TRUE(plist);
+  NSNumber* const interval =
+      base::apple::ObjCCast<NSNumber>(plist[@"SUScheduledCheckInterval"]);
+  ASSERT_TRUE(interval);
+  EXPECT_EQ(kUpdateCheckInterval.InSeconds(), interval.longLongValue);
+  EXPECT_EQ(21600, interval.longLongValue);
+  EXPECT_TRUE([base::apple::ObjCCast<NSNumber>(
+      plist[@"SUEnableAutomaticChecks"]) boolValue]);
+}
+
+// updates Up4 (BACKLOG S-343): a press of the button is a yes to that attempt
+// only. The press downloads the waiting version and restarts into it. When
+// the administrator's password is then cancelled, or the quit is refused,
+// the next time Sparkle finds the version in the same run the button waits
+// for another press: nothing is downloaded for it, so nothing installs.
+TEST_F(AppUpdaterMacTest, ACancelledInstallIsNotAYesToTheNextCheck) {
+  Launch(base::Hours(2));
+  task_environment_.FastForwardBy(base::Seconds(10));
+  ASSERT_TRUE(Driver());
+  std::vector<NSInteger> replies;
+  std::vector<NSInteger>* const answered = &replies;
+  void (^const answer)(NSInteger) = ^(NSInteger choice) {
+    answered->push_back(choice);
+  };
+
+  {
+    SCOPED_TRACE("the press downloads, then restarts");
+    [Driver() showUpdateFoundWithAppcastItem:LaterVersion()
+                                       state:FoundOnSchedule()
+                                       reply:answer];
+    ASSERT_EQ(AppUpdater::State::kAvailable, updater_->state());
+    EXPECT_TRUE(replies.empty()) << "it waits for the button";
+    updater_->InstallNow();
+    [Driver() showReadyToInstallAndRelaunch:answer];
+    EXPECT_EQ(std::vector<NSInteger>({kInstall, kInstall}), replies);
+    EXPECT_EQ(1, restarts_);
+    EXPECT_EQ(AppUpdater::State::kInstalling, updater_->state());
+  }
+  {
+    SCOPED_TRACE("the password is cancelled: the next check asks again");
+    NSError* const cancelled =
+        [NSError errorWithDomain:@"SUSparkleErrorDomain"
+                            code:kInstallationCanceled
+                        userInfo:nil];
+    [Driver() showUpdaterError:cancelled
+               acknowledgement:^{
+               }];
+    [Driver() dismissUpdateInstallation];
+    task_environment_.FastForwardBy(base::Hours(6));
+    [Driver() showUpdateFoundWithAppcastItem:LaterVersion()
+                                       state:FoundOnSchedule()
+                                       reply:answer];
+    EXPECT_EQ(AppUpdater::State::kAvailable, updater_->state());
+    EXPECT_EQ(2u, replies.size()) << "it was downloaded without a press";
+    EXPECT_EQ(1, restarts_);
+  }
+  {
+    SCOPED_TRACE("the quit is refused: the next check asks again");
+    updater_->InstallNow();
+    [Driver() showReadyToInstallAndRelaunch:answer];
+    ASSERT_EQ(2, restarts_);
+    // "Leave site?" kept the browser open.
+    [Driver() showInstallingUpdateWithApplicationTerminated:NO
+                                retryTerminatingApplication:^{
+                                }];
+    task_environment_.FastForwardBy(base::Seconds(21));
+    ASSERT_EQ(AppUpdater::State::kReady, updater_->state())
+        << "the button is back";
+    [Driver() dismissUpdateInstallation];
+    const size_t before = replies.size();
+    [Driver() showUpdateFoundWithAppcastItem:LaterVersion()
+                                       state:FoundOnSchedule()
+                                       reply:answer];
+    EXPECT_EQ(AppUpdater::State::kAvailable, updater_->state());
+    EXPECT_EQ(before, replies.size()) << "it was downloaded without a press";
+    EXPECT_EQ(2, restarts_);
+  }
+}
+
+// updates Up4 (BACKLOG S-343): a press whose download Sparkle then dismisses
+// with no error is a yes to that attempt only. The version Sparkle later
+// downloads on its own schedule waits for the button; it restarted the
+// browser into it without asking.
+TEST_F(AppUpdaterMacTest, ADismissedDownloadIsNotAYesToTheNextOne) {
+  Launch(base::Hours(2));
+  task_environment_.FastForwardBy(base::Seconds(10));
+  ASSERT_TRUE(Driver());
+  [Driver() showUpdateFoundWithAppcastItem:LaterVersion()
+                                     state:FoundOnSchedule()
+                                     reply:^(NSInteger choice){
+                                     }];
+  ASSERT_EQ(AppUpdater::State::kAvailable, updater_->state());
+  updater_->InstallNow();
+  ASSERT_EQ(AppUpdater::State::kDownloading, updater_->state());
+  [Driver() dismissUpdateInstallation];
+  ASSERT_EQ(AppUpdater::State::kIdle, updater_->state());
+
+  // Sparkle's schedule finds the version, downloads it and installs it at
+  // the quit, telling only the delegate.
+  task_environment_.FastForwardBy(base::Hours(6));
+  int installs = 0;
+  int* const installed = &installs;
+  [Driver() updater:nil didFindValidUpdate:LaterVersion()];
+  EXPECT_TRUE([Driver() updater:nil
+                willInstallUpdateOnQuit:LaterVersion()
+             immediateInstallationBlock:^{
+               ++*installed;
+             }]);
+  EXPECT_EQ(AppUpdater::State::kReady, updater_->state())
+      << "the button waits for a press";
+  EXPECT_EQ(0, installs);
+  EXPECT_EQ(0, restarts_);
+}
+
+}  // namespace
+}  // namespace stedding
