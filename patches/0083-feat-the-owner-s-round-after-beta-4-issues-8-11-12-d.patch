+++ b/chrome/browser/ui/views/page_action/stedding_copy_link_page_action_controller.cc
@@ -0,0 +1,153 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/page_action/stedding_copy_link_page_action_controller.h"
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/strcat.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/accelerator_table.h"
+#include "chrome/browser/ui/actions/chrome_action_id.h"
+#include "chrome/browser/ui/page_action/page_action_controller.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/ui_base_features.h"
+#include "ui/color/color_id.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+DEFINE_USER_DATA(CopyLinkPageActionController);
+
+CopyLinkPageActionController::CopyLinkPageActionController(
+    tabs::TabInterface& tab,
+    PrefService* pref_service,
+    page_actions::PageActionController& page_action_controller)
+    : ContentsObservingTabFeature(tab),
+      page_action_controller_(page_action_controller),
+      scoped_unowned_user_data_(tab.GetUnownedUserDataHost(), *this) {
+  // The button's own name, and its chord, as the dark pages button names
+  // its own (dark-pages Dk16). Chromium's action reads "Copy link", for the
+  // app menu; the override is this tab's button's alone.
+  page_action_controller_->OverrideTooltip(kActionCopyUrl, Tooltip());
+  page_action_controller_->OverrideAccessibleName(kActionCopyUrl, u"Copy Link");
+  button_enabled_.Init(
+      prefs::kCopyLinkButton, pref_service,
+      base::BindRepeating(&CopyLinkPageActionController::Update,
+                          base::Unretained(this)));
+  Update();
+}
+
+CopyLinkPageActionController::~CopyLinkPageActionController() = default;
+
+// static
+CopyLinkPageActionController* CopyLinkPageActionController::From(
+    tabs::TabInterface* tab) {
+  return tab ? Get(tab->GetUnownedUserDataHost()) : nullptr;
+}
+
+// static
+bool CopyLinkPageActionController::ShowsFor(const GURL& url) {
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+}
+
+// static
+std::u16string CopyLinkPageActionController::Tooltip() {
+  std::u16string text = u"Copy Link";
+  // The chord from the accelerator tables, as the menus print it: the Mac's
+  // in its symbols, Windows' spelled out. The tables need no window, so the
+  // name is whole from the tab's first page, before its window is shown.
+  ui::Accelerator accelerator;
+  if (::GetAcceleratorForCommandId(IDC_COPY_URL, &accelerator)) {
+    base::StrAppend(&text, {u" (", accelerator.GetShortcutText(), u")"});
+  }
+  return text;
+}
+
+// static
+const gfx::VectorIcon& CopyLinkPageActionController::CopiedIcon() {
+  // BrowserActions draws the link from the same two sets.
+  return features::IsRoundedIconsEnabled() ? kCheckIcon : kCheckOldIcon;
+}
+
+void CopyLinkPageActionController::ShowCopied() {
+  // The row's own icon colour, as the link's: the row takes the page's
+  // colour, and the icons the colour that reads on it (toolbar T17).
+  page_action_controller_->OverrideImage(
+      kActionCopyUrl,
+      ui::ImageModel::FromVectorIcon(CopiedIcon(), ui::kColorIcon));
+  copied_timer_.Start(FROM_HERE, kCopiedDuration, this,
+                      &CopyLinkPageActionController::ClearCopied);
+}
+
+void CopyLinkPageActionController::DidStartNavigation(
+    content::NavigationHandle* navigation) {
+  // A page on its way in is the address the field shows and the copy takes.
+  if (navigation->IsInPrimaryMainFrame()) {
+    Update();
+  }
+}
+
+void CopyLinkPageActionController::DidFinishNavigation(
+    content::NavigationHandle* navigation) {
+  // Committed, or given up and the field back on the page that stayed.
+  if (navigation->IsInPrimaryMainFrame()) {
+    Update();
+  }
+}
+
+void CopyLinkPageActionController::PrimaryPageChanged(content::Page& page) {
+  // The check mark was for the page that left.
+  if (copied_timer_.IsRunning()) {
+    copied_timer_.Stop();
+    ClearCopied();
+  }
+  Update();
+}
+
+void CopyLinkPageActionController::OnVisibilityChanged(
+    content::Visibility visibility) {
+  Update();
+}
+
+void CopyLinkPageActionController::OnDiscardContents(
+    tabs::TabInterface* tab,
+    content::WebContents* old_contents,
+    content::WebContents* new_contents) {
+  // A sleep and a Space's jar rebind both replace the tab's contents (PLAN.md
+  // SPC-8, TAB-15); the new ones may not have loaded yet, and their address
+  // is the restored entry's.
+  ContentsObservingTabFeature::OnDiscardContents(tab, old_contents,
+                                                 new_contents);
+  Update();
+}
+
+void CopyLinkPageActionController::Update() {
+  // The address the copy takes (stedding::CopyLink copies the visible URL):
+  // a view-source: page reads as view-source:, not as the page it shows.
+  content::WebContents* const contents = tab().GetContents();
+  if (button_enabled_.GetValue() && contents &&
+      ShowsFor(contents->GetVisibleURL())) {
+    page_action_controller_->Show(kActionCopyUrl);
+    return;
+  }
+  if (copied_timer_.IsRunning()) {
+    copied_timer_.Stop();
+    ClearCopied();
+  }
+  page_action_controller_->Hide(kActionCopyUrl);
+}
+
+void CopyLinkPageActionController::ClearCopied() {
+  page_action_controller_->ClearOverrideImage(kActionCopyUrl);
+}
+
+}  // namespace stedding
