+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A Space with its own session is offered no payment app (docs/features/
+// sessions.md S36, BACKLOG S-296, GitHub issue 25). A payment app's service
+// worker, and the window it opens to pay, live in the profile's jar: Google
+// Pay started in such a Space offered the Google accounts signed in outside
+// it. The shared jar still is offered the app installed there.
+
+#include <string>
+
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/payments/payment_request_platform_browsertest_base.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+class SpacePaymentsTest
+    : public payments::PaymentRequestPlatformBrowserTestBase {
+ protected:
+  bool HasEnrolledInstrument(content::WebContents* page,
+                             const std::string& method) {
+    return content::EvalJs(page, content::JsReplace(
+                                     "hasEnrolledInstrument({}, $1)", method))
+        .ExtractBool();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SpacePaymentsTest, ASpaceWithItsOwnJarIsOfferedNoApp) {
+  std::string method;
+  InstallPaymentApp("nickpay.test", "/nickpay.test/app.js", &method);
+  ASSERT_FALSE(method.empty());
+  NavigateTo("/has_enrolled_instrument.html");
+  {
+    SCOPED_TRACE("the shared jar, where the app was installed");
+    EXPECT_TRUE(HasEnrolledInstrument(GetActiveWebContents(), method));
+  }
+
+  const GURL page_url = GetActiveWebContents()->GetLastCommittedURL();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->SetSpaceIsolated(work, true);
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), page_url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(
+      spaces::StoragePartitionConfigForWebContents(page)));
+  {
+    SCOPED_TRACE("a Space with its own session");
+    EXPECT_FALSE(HasEnrolledInstrument(page, method))
+        << "the Space was offered the shared jar's payment app";
+  }
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/space_worker_browsertest.cc b/chrome/test/stedding/space_worker_browsertest.cc
new file mode 100644
index 0000000000000..82d89c9319f61
--- /dev/null
+++ b/chrome/test/stedding/space_worker_browsertest.cc
@@ -0,0 +1,246 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A Space's service worker acts in its Space's own jar (docs/features/
+// sessions.md S30, BACKLOG S-180). A click on the notification a worker in
+// Work's jar shows reaches that worker, though its origin maps to the
+// profile's jar, and the window the worker opens from the click is made in
+// Work's jar and filed in Work while Home is on screen: its first request
+// carries Work's cookie, and the worker gets it back as its client. The
+// click had been dispatched into the profile's jar, which has no such
+// notification, and the window had opened in the Space on screen.
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/notifications/notification_display_service_tester.h"
+#include "chrome/browser/notifications/notification_handler.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/message_center/public/cpp/notification.h"
+#include "url/gurl.h"
+
+namespace {
+
+using spaces::SpaceId;
+
+class SpaceWorkerTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  // localhost: a secure context, where a page may have a service worker.
+  GURL Url(const std::string& path) {
+    return embedded_test_server()->GetURL("localhost", path);
+  }
+
+  bool PageGot(content::WebContents* page, const std::string& message) {
+    return content::EvalJs(page, "window.messages.includes('" + message + "')")
+        .ExtractBool();
+  }
+
+  // The tab the worker's click opened, on the cookie echo; null until then.
+  tabs::TabInterface* WorkersWindow() {
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      const content::NavigationEntry* const entry =
+          tab->GetContents()->GetController().GetVisibleEntry();
+      if (entry && entry->GetURL().path() == "/echoheader") {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SpaceWorkerTest, AWorkerActsInItsSpacesJar) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const SpaceId home = model->active_id();
+  const SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->SetSpaceIsolated(work, true);
+  NotificationDisplayServiceTester display(browser()->GetProfile());
+  const GURL page_url = Url("/stedding/space_worker.html");
+  HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile())
+      ->SetContentSettingDefaultScope(page_url, page_url,
+                                      ContentSettingsType::NOTIFICATIONS,
+                                      CONTENT_SETTING_ALLOW);
+
+  // Each jar has its own cookie for the site.
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Url("/set-cookie?jar=shared")));
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("/set-cookie?jar=work"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page_url));
+  content::WebContents* const page = tabs()->GetActiveWebContents();
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(
+      spaces::StoragePartitionConfigForWebContents(page)));
+  ASSERT_EQ("registered", content::EvalJs(page, "register()"));
+  ASSERT_EQ("shown", content::EvalJs(page, "show()"));
+  const std::vector<message_center::Notification> shown =
+      display.GetDisplayedNotificationsForType(
+          NotificationHandler::Type::WEB_PERSISTENT);
+  ASSERT_EQ(1u, shown.size());
+
+  // Home on screen: where the worker's window goes is the worker's choice.
+  ASSERT_TRUE(model->SetActiveSpace(home));
+  const int count = tabs()->count();
+  display.SimulateClick(NotificationHandler::Type::WEB_PERSISTENT,
+                        shown[0].id(), /*action_index=*/std::nullopt,
+                        /*reply=*/std::nullopt);
+  {
+    SCOPED_TRACE("the click reaches the worker in Work's jar");
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return PageGot(page, "clicked"); }))
+        << "the click went to the profile's jar, which has no such "
+           "notification";
+  }
+  {
+    SCOPED_TRACE("the worker's window opens in Work and its jar");
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return tabs()->count() == count + 1; }));
+    tabs::TabInterface* opened = nullptr;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      const content::NavigationEntry* const entry =
+          tab->GetContents()->GetController().GetVisibleEntry();
+      if (entry && entry->GetURL().path() == "/echoheader") {
+        opened = tab;
+      }
+    }
+    ASSERT_TRUE(opened);
+    EXPECT_EQ(work, model->FindSpaceForTab(opened));
+    EXPECT_TRUE(spaces::IsSpaceStoragePartition(
+        spaces::StoragePartitionConfigForWebContents(opened->GetContents())));
+    ASSERT_TRUE(content::WaitForLoadStop(opened->GetContents()));
+    EXPECT_EQ("jar=work", content::EvalJs(opened->GetContents(),
+                                          "document.body.innerText"))
+        << "its first request carried Work's cookie";
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return PageGot(page, "opened") ||
+             PageGot(page, "opened but not a client") ||
+             content::EvalJs(page,
+                             "window.messages.some((m) => "
+                             "m.startsWith('open failed'))")
+                 .ExtractBool();
+    }));
+    EXPECT_TRUE(PageGot(page, "opened"))
+        << "the worker got its window back as a client of its own";
+  }
+}
+
+// sessions S7, S30 (BACKLOG S-338): a Space whose session is turned off keeps
+// its jar and the service workers in it. The window such a worker opens from
+// its notification's click is made in that jar and filed in that Space,
+// whichever Space is on screen: its first request carries the cookie of the
+// jar the notification came from, and the worker gets the window back as its
+// client. It was made in the jar of the Space on screen, and the worker never
+// got it.
+IN_PROC_BROWSER_TEST_F(SpaceWorkerTest,
+                       AWorkerOfASpaceWhoseSessionIsOffOpensInItsJar) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const SpaceId home = model->active_id();
+  const SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->SetSpaceIsolated(work, true);
+  NotificationDisplayServiceTester display(browser()->GetProfile());
+  const GURL page_url = Url("/stedding/space_worker.html");
+  HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile())
+      ->SetContentSettingDefaultScope(page_url, page_url,
+                                      ContentSettingsType::NOTIFICATIONS,
+                                      CONTENT_SETTING_ALLOW);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Url("/set-cookie?jar=shared")));
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("/set-cookie?jar=work"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page_url));
+  tabs::TabInterface* const page_tab = tabs()->GetActiveTab();
+  content::WebContents* const page = page_tab->GetContents();
+  const content::StoragePartitionConfig work_jar =
+      spaces::StoragePartitionConfigForWebContents(page);
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(work_jar));
+  ASSERT_EQ("registered", content::EvalJs(page, "register()"));
+  ASSERT_EQ("shown", content::EvalJs(page, "show()"));
+  const std::vector<message_center::Notification> shown =
+      display.GetDisplayedNotificationsForType(
+          NotificationHandler::Type::WEB_PERSISTENT);
+  ASSERT_EQ(1u, shown.size());
+
+  // Work's session turned off. The worker's page holds changes the user has
+  // not saved, so it keeps the jar (sessions S21) and the worker has a page
+  // to tell what happened.
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+  model->SetSpaceIsolated(work, false);
+  ASSERT_TRUE(model->SetActiveSpace(home));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(page, page_tab->GetContents());
+  ASSERT_FALSE(model->SpaceIsIsolated(work));
+
+  const int count = tabs()->count();
+  display.SimulateClick(NotificationHandler::Type::WEB_PERSISTENT,
+                        shown[0].id(), /*action_index=*/std::nullopt,
+                        /*reply=*/std::nullopt);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return PageGot(page, "clicked"); }));
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return tabs()->count() == count + 1; }));
+  tabs::TabInterface* const opened = WorkersWindow();
+  ASSERT_TRUE(opened);
+  ASSERT_TRUE(content::WaitForLoadStop(opened->GetContents()));
+  EXPECT_EQ(work, model->FindSpaceForTab(opened));
+  EXPECT_EQ(work_jar,
+            spaces::StoragePartitionConfigForWebContents(opened->GetContents()))
+      << "the window is not in the worker's jar";
+  EXPECT_EQ("jar=work",
+            content::EvalJs(opened->GetContents(), "document.body.innerText"))
+      << "its first request did not carry the worker's jar";
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return PageGot(page, "opened") ||
+           PageGot(page, "opened but not a client") ||
+           content::EvalJs(page,
+                           "window.messages.some((m) => "
+                           "m.startsWith('open failed'))")
+               .ExtractBool();
+  }));
+  EXPECT_TRUE(PageGot(page, "opened"))
+      << "the worker did not get its window back as a client of its own";
+  ASSERT_TRUE(content::ExecJs(
+      page, "window.removeEventListener('beforeunload', window.stay);"));
+}
+
+}  // namespace
