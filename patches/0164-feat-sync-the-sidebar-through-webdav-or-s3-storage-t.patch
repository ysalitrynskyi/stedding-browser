+  input.payload_hash = Sha256Hex("Welcome to Amazon S3.");
+  EXPECT_EQ(input.payload_hash,
+            "44ce7dd67c959e0d3524ffac1771dfbba87d2b6b4b4e99e42034a8b803f8b072");
+  input.headers["x-amz-content-sha256"] = input.payload_hash;
+  input.headers["date"] = "Fri, 24 May 2013 00:00:00 GMT";
+  input.headers["x-amz-storage-class"] = "REDUCED_REDUNDANCY";
