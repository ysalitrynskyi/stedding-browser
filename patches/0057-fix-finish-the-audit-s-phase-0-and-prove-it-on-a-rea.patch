+class TabMenuVerbsTest : public BrowserWithTestWindowTest {
+ public:
+  TabMenuVerbsTest() = default;
+
+ protected:
+  explicit TabMenuVerbsTest(Browser::Type type)
+      : BrowserWithTestWindowTest(type) {}
+
+  void SetUp() override {
+    BrowserWithTestWindowTest::SetUp();
+    ui::TestClipboard::CreateForCurrentThread();
+  }
+  void TearDown() override {
+    ui::Clipboard::DestroyClipboardForCurrentThread();
+    BrowserWithTestWindowTest::TearDown();
+  }
+
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  spaces::SpaceModel& space_model() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model) << "a normal window must own a SpaceModel";
+    return *model;
+  }
+
+  // A foreground tab showing `url` (the fixture opens it at index 0).
+  tabs::TabInterface* OpenTab(const GURL& url = GURL("https://example.com/")) {
+    AddTab(browser(), url);
+    return tabs().GetActiveTab();
+  }
+  int IndexOf(tabs::TabInterface* tab) { return tabs().GetIndexOfTab(tab); }
+  bool Enabled(tabs::TabInterface* tab, int command_id) {
+    return tabs().IsContextMenuCommandEnabled(IndexOf(tab),
+                                              AsCommand(command_id));
+  }
+  void Execute(tabs::TabInterface* tab, int command_id) {
+    tabs().ExecuteContextMenuCommand(IndexOf(tab), AsCommand(command_id));
+  }
+  // Adds unnamed Spaces after the active one until the window has `count`.
+  void HaveSpaces(size_t count) {
+    while (space_model().size() < count) {
+      space_model().AddSpace(std::string(), kGrey);
+    }
+  }
+
+  std::u16string ClipboardText() {
+    base::test::TestFuture<std::u16string> future;
+    ui::Clipboard::GetForCurrentThread()->ReadText(
+        ui::ClipboardBuffer::kCopyPaste, std::nullopt, future.GetCallback());
+    return future.Get();
+  }
+};
