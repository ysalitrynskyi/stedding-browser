+++ b/chrome/browser/ui/spaces/sidebar_sync_unittest.cc
@@ -0,0 +1,752 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/sidebar-file.md Sf10-Sf41: the folder sync's merge, its
+// files and its ledger, without a browser.
+
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/spaces/arc_sidebar_importer.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_ledger.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_state.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces::sidebar_sync {
+namespace {
+
+// Ids in the shapes the files carry: a Space's token, a tab's token, a
+// folder's id.
+constexpr char kWork[] = "0123456789ABCDEF0123456789ABCDEF";
+constexpr char kHome[] = "FEDCBA9876543210FEDCBA9876543210";
+constexpr char kPinA[] = "tab:11111111-1111-4111-8111-111111111111";
+constexpr char kPinB[] = "tab:22222222-2222-4222-8222-222222222222";
+constexpr char kPinC[] = "tab:33333333-3333-4333-8333-333333333333";
+constexpr char kFolder[] = "folder:AAAAAAAAAAAAAAAABBBBBBBBBBBBBBBB";
+
+constexpr char kOffice[] = "aaaaaaaaaaaaaaaa";
+constexpr char kLaptop[] = "bbbbbbbbbbbbbbbb";
+
+LocalItem SpaceItem(const std::string& name) {
+  LocalItem item;
+  item.kind = Kind::kSpace;
+  item.fields[kFieldName] = name;
+  item.fields[kFieldColor] = "#3366FF";
+  item.fields[kFieldIsolated] = "0";
+  return item;
+}
+
+LocalItem PinItem(const std::string& home,
+                  const std::string& parent,
+                  const std::string& name = std::string()) {
+  LocalItem item;
+  item.kind = Kind::kTab;
+  item.fields[kFieldHome] = home;
+  item.fields[kFieldName] = name;
+  item.fields[kFieldParent] = parent;
+  return item;
+}
+
+// One install's sidebar: Work with two pins.
+LocalView WorkView() {
+  LocalView view;
+  view.items[kWork] = SpaceItem("Work");
+  view.items[kPinA] = PinItem("https://a.example/", PinsListOf(kWork));
+  view.items[kPinB] = PinItem("https://b.example/", PinsListOf(kWork));
+  view.lists[kSpacesList] = {kWork};
+  view.lists[PinsListOf(kWork)] = {kPinA, kPinB};
+  return view;
+}
+
+State StateOf(const LocalView& view, int64_t t, const char* install) {
+  State state;
+  RecordLocalEdits(state, nullptr, view, {}, Stamp{t, install});
+  return state;
+}
+
+// --- The merge (Sf15, Sf16, Sf19, Sf22, Sf26, Sf27, Sf34, Sf41). ---
+
+// Sf15: the later edit of a field wins on every install.
+TEST(SidebarSyncMergeTest, TheNewerEditWins) {
+  State office = StateOf(WorkView(), 100, kOffice);
+  State laptop = office;
+  LocalView renamed = WorkView();
+  renamed.items[kWork].fields[kFieldName] = "Clients";
+  const LocalView before = WorkView();
+  ASSERT_TRUE(RecordLocalEdits(laptop, &before, renamed, {},
+                               Stamp{200, kLaptop}));
+  EXPECT_TRUE(MergeState(office, laptop));
+  EXPECT_EQ("Clients", office.records[kWork].Get(kFieldName));
+  // The older value never comes back.
+  EXPECT_FALSE(MergeState(laptop, StateOf(WorkView(), 100, kOffice)));
+  EXPECT_EQ("Clients", laptop.records[kWork].Get(kFieldName));
+}
+
+// Sf15: a rename on one computer and a recolour on the other both survive.
+TEST(SidebarSyncMergeTest, DifferentFieldsBothSurvive) {
+  const LocalView base = WorkView();
+  State office = StateOf(base, 100, kOffice);
+  State laptop = office;
+  LocalView renamed = base;
+  renamed.items[kWork].fields[kFieldName] = "Clients";
+  RecordLocalEdits(office, &base, renamed, {}, Stamp{200, kOffice});
+  LocalView recoloured = base;
+  recoloured.items[kWork].fields[kFieldColor] = "#FF0000";
+  RecordLocalEdits(laptop, &base, recoloured, {}, Stamp{201, kLaptop});
+  MergeState(office, laptop);
+  MergeState(laptop, office);
+  EXPECT_EQ(office, laptop);
+  EXPECT_EQ("Clients", office.records[kWork].Get(kFieldName));
+  EXPECT_EQ("#FF0000", office.records[kWork].Get(kFieldColor));
+}
+
+// Sf15: a clock behind what was seen still moves forward.
+TEST(SidebarSyncMergeTest, ASlowClockStillMovesForward) {
+  EXPECT_EQ(5001, NextTime(1000, 5000));
+  EXPECT_EQ(9000, NextTime(9000, 5000));
+}
+
+// Sf15: the same time on two installs: the larger install id wins on both.
+TEST(SidebarSyncMergeTest, TiesBreakOnTheInstallId) {
+  const LocalView base = WorkView();
+  State office = StateOf(base, 100, kOffice);
+  State laptop = office;
+  LocalView a = base;
+  a.items[kWork].fields[kFieldName] = "From office";
+  RecordLocalEdits(office, &base, a, {}, Stamp{300, kOffice});
+  LocalView b = base;
+  b.items[kWork].fields[kFieldName] = "From laptop";
+  RecordLocalEdits(laptop, &base, b, {}, Stamp{300, kLaptop});
+  MergeState(office, laptop);
+  MergeState(laptop, office);
+  EXPECT_EQ("From laptop", office.records[kWork].Get(kFieldName));
+  EXPECT_EQ(office, laptop);
+}
+
+// Sf15: three files merged in any order give one result.
+TEST(SidebarSyncMergeTest, MergeIsOrderIndependent) {
+  const LocalView base = WorkView();
+  const State start = StateOf(base, 100, kOffice);
+  State one = start;
+  LocalView renamed = base;
+  renamed.items[kWork].fields[kFieldName] = "One";
+  RecordLocalEdits(one, &base, renamed, {}, Stamp{200, kOffice});
+  State two = start;
+  LocalView rehomed = base;
+  rehomed.items[kPinA].fields[kFieldHome] = "https://a2.example/";
+  RecordLocalEdits(two, &base, rehomed, {}, Stamp{210, kLaptop});
+  State three = start;
+  RecordLocalEdits(three, &base, LocalView(), {kPinB}, Stamp{220, "cccc"});
+
+  State forward = start;
+  MergeState(forward, one);
+  MergeState(forward, two);
+  MergeState(forward, three);
+  State backward = start;
+  MergeState(backward, three);
+  MergeState(backward, two);
+  MergeState(backward, one);
+  EXPECT_EQ(forward.records, backward.records);
+  EXPECT_EQ("One", forward.records[kWork].Get(kFieldName));
+  EXPECT_EQ("https://a2.example/", forward.records[kPinA].Get(kFieldHome));
+  EXPECT_FALSE(forward.records[kPinB].Alive());
+}
+
+// Sf16: the newer list's order wins, and an item only the older list has
+// stays beside the item it followed.
+TEST(SidebarSyncMergeTest, OrderFollowsTheNewerListAndKeepsTheRest) {
+  State office;
+  office.lists["x"] = List();
+  office.lists["x"].order = {"a", "b", "c", "d"};
+  office.lists["x"].s = Stamp{100, kOffice};
+  State laptop;
+  laptop.lists["x"] = List();
+  laptop.lists["x"].order = {"c", "a", "b"};
+  laptop.lists["x"].s = Stamp{200, kLaptop};
+  MergeState(office, laptop);
+  // "d" followed "c" in the older list, and follows it still.
+  EXPECT_EQ((std::vector<std::string>{"c", "d", "a", "b"}),
+            office.lists["x"].order);
+}
+
+// Sf16: a reorder on one computer and an addition on the other.
+TEST(SidebarSyncMergeTest, AReorderAndAnAddBothSurvive) {
+  EXPECT_EQ((std::vector<std::string>{"b", "a", "n", "c"}),
+            MergeOrder({"b", "a", "c"}, {"a", "n", "b", "c"}));
+  EXPECT_EQ((std::vector<std::string>{"b", "a", "n"}),
+            MergeOrder({"b", "a"}, {"n"}));
+}
+
+// Sf10: what existed at a join is older than any edit, and on a tie the
+// computer that joined first -- the folder's content -- wins.
+TEST(SidebarSyncMergeTest, TheFolderWinsATieAtJoin) {
+  LocalView folder_view = WorkView();
+  folder_view.items[kWork].fields[kFieldName] = "Folder's";
+  const State first = StateOf(folder_view, -1000, kOffice);
+  LocalView here = WorkView();
+  here.items[kWork].fields[kFieldName] = "Mine";
+  State joining = StateOf(here, -2000, kLaptop);
+  MergeState(joining, first);
+  EXPECT_EQ("Folder's", joining.records[kWork].Get(kFieldName));
+  // Any real edit is newer than both.
+  EXPECT_LT(joining.records[kWork].Latest(), (Stamp{0, std::string()}));
+}
+
+// Sf19: a peer's file missing, or listing fewer items, deletes nothing.
+TEST(SidebarSyncMergeTest, AMissingFileDeletesNothing) {
+  State office = StateOf(WorkView(), 100, kOffice);
+  const State before = office;
+  EXPECT_FALSE(MergeState(office, State()));
+  EXPECT_EQ(before, office);
+}
+
+TEST(SidebarSyncMergeTest, AShorterFileDeletesNothing) {
+  State office = StateOf(WorkView(), 100, kOffice);
+  LocalView fewer = WorkView();
+  fewer.items.erase(kPinB);
+  fewer.lists[PinsListOf(kWork)] = {kPinA};
+  State laptop = StateOf(fewer, 50, kLaptop);
+  MergeState(office, laptop);
+  ASSERT_TRUE(office.records.contains(kPinB));
+  EXPECT_TRUE(office.records[kPinB].Alive());
+}
+
+// Sf18, Sf19: an item gone from every window with no removal by the user
+// is not removed: absence alone never deletes.
+TEST(SidebarSyncMergeTest, AbsenceWithoutIntentIsNoDelete) {
+  const LocalView base = WorkView();
