+// Z19: while a row records, the window leaves its keys to the page.
+class ShortcutRecordTest : public InProcessBrowserTest {
+ protected:
+  content::WebContents* OpenSettings() {
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), GURL("chrome://settings/stedding")));
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  // Whether the window is recording: its focus manager is suspended, and on
+  // the Mac its dispatcher leaves ⌘N to the page.
+  bool Recording() {
+    views::Widget* const widget = ViewOf(browser())->GetWidget();
+    views::FocusManager* const focus = widget->GetFocusManager();
+    if (!focus || !focus->shortcut_handling_suspended()) {
+      return false;
+    }
+#if BUILDFLAG(IS_MAC)
+    return shortcuts::IsRecordingIn(widget) &&
+           shortcuts::test::DispatcherLeavesChordToThePage(
+               widget->GetNativeWindow(),
+               ui::Accelerator(ui::VKEY_N, ui::EF_COMMAND_DOWN));
+#else
+    return true;
+#endif
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(ShortcutRecordTest, TheBrowsersKeysReachTheRecorder) {
+  content::WebContents* const page = OpenSettings();
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(
+      content::ExecJs(page, "chrome.send('steddingRecordShortcut', [true]);"));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Recording(); }));
+#if !BUILDFLAG(IS_MAC)
+  // Ctrl+N, New Window, is a chord the window takes before any page. While
+  // a chord is recorded the window leaves it to the page: asked before the
+  // page, it does not take it. Asked directly: a key injected into a page
+  // that does not have the window's focus never reached it on Windows.
+  const size_t windows = GetAllBrowserWindowInterfaces().size();
+  input::NativeWebKeyboardEvent ctrl_n(blink::WebInputEvent::Type::kRawKeyDown,
+                                       blink::WebInputEvent::kControlKey,
+                                       base::TimeTicks::Now());
+  ctrl_n.windows_key_code = ui::VKEY_N;
+  ctrl_n.dom_key = ui::DomKey::FromCharacter('n');
+  ctrl_n.dom_code = static_cast<int>(ui::DomCode::US_N);
+  ASSERT_TRUE(page->GetDelegate());
+  EXPECT_EQ(content::KeyboardEventProcessingResult::NOT_HANDLED,
+            page->GetDelegate()->PreHandleKeyboardEvent(page, ctrl_n))
+      << "the window took Ctrl+N before the recording page";
+  EXPECT_EQ(windows, GetAllBrowserWindowInterfaces().size())
+      << "the recorder had the key, not New Window";
+#endif
+  ASSERT_TRUE(content::ExecJs(page,
+                              "chrome.send('steddingRecordShortcut', [false]);"));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !Recording(); }));
+}
+
+IN_PROC_BROWSER_TEST_F(ShortcutRecordTest, RecordingEndsWhenThePageGoes) {
+  content::WebContents* const page = OpenSettings();
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(
+      content::ExecJs(page, "chrome.send('steddingRecordShortcut', [true]);"));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Recording(); }));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !Recording(); }));
+  EXPECT_FALSE(shortcuts::IsRecording());
+}
