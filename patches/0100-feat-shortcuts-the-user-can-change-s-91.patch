+      shortcuts::test::MainMenuShowsNoChord(IDC_STEDDING_TOGGLE_DARK_PAGES));
+  ASSERT_TRUE(shortcuts::ResetShortcut(LocalState(), Row("dark-pages")));
+  ui::Accelerator shipped;
+  ASSERT_TRUE(GetDefaultMacMenuAcceleratorForCommandId(
+      IDC_STEDDING_TOGGLE_DARK_PAGES, &shipped));
+  EXPECT_TRUE(shortcuts::test::MainMenuShowsChord(
