@@ -3594,6 +3607,10 @@ bool RenderViewContextMenu::IsCommandIdEnabled(int id) const {
   // Stedding little E7: as the window's own commands are.
   if (id == IDC_STEDDING_LITTLE_PROMOTE ||
       id == IDC_STEDDING_LITTLE_PROMOTE_SPLIT) {
+    // Peek P20: a peek over the page's page has no window of its own.
+    if (stedding::PeekOverPageSourceOf(source_web_contents_)) {
+      return true;
+    }
     BrowserWindowInterface* const browser = GetBrowser();
     return browser && chrome::IsCommandEnabled(browser, id);
   }
@@ -4348,6 +4365,24 @@ void RenderViewContextMenu::ExecuteCommand(int id, int event_flags) {
     // window's command, so the row, the chord and the button are one path.
     case IDC_STEDDING_LITTLE_PROMOTE:
     case IDC_STEDDING_LITTLE_PROMOTE_SPLIT:
+      // Peek P20: the peek over the pinned tab's page keeps it, once the
+      // menu is gone.
+      if (tabs::TabInterface* const pin =
+              stedding::PeekOverPageSourceOf(source_web_contents_)) {
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](base::WeakPtr<tabs::TabInterface> pin, bool split) {
+                  if (pin) {
+                    stedding::RunPeekOverPageCommand(
+                        pin->GetBrowserWindowInterface(),
+                        split ? stedding::PeekCommand::kOpenInSplit
+                              : stedding::PeekCommand::kOpenAsTab);
+                  }
+                },
+                pin->GetWeakPtr(), id == IDC_STEDDING_LITTLE_PROMOTE_SPLIT));
+        break;
+      }
       if (BrowserWindowInterface* const browser = GetBrowser()) {
         chrome::ExecuteCommand(browser, id);
       }
