 }
 
+// Spaces B39: the wheel's rules, one window's stream of events at a time.
+class SpaceWheelTest : public testing::Test {
+ protected:
+  using Answer = SpaceWheel::Answer;
+
+  // An event `ms` milliseconds into the test.
+  static SpaceWheel::Event At(int ms,
+                              float right,
+                              float down,
+                              bool notch,
+                              bool shift = false,
+                              bool control = false) {
+    SpaceWheel::Event event;
+    event.time = base::TimeTicks() + base::Seconds(10) + base::Milliseconds(ms);
+    event.right = right;
+    event.down = down;
+    event.notch = notch;
+    event.shift = shift;
+    event.control = control;
+    return event;
+  }
+
+  SpaceWheel wheel_{120.0f};
+};
+
+// A sideways notch steps, to the right the next Space and to the left the
+// one before; a vertical notch is the list's. Right to left, the sides swap.
+TEST_F(SpaceWheelTest, ASidewaysNotchStepsAndAVerticalOneScrolls) {
+  EXPECT_EQ(Answer::kNext, wheel_.OnWheel(At(0, 120, 0, true), false));
+  EXPECT_EQ(Answer::kPrevious, wheel_.OnWheel(At(500, -120, 0, true), false));
+  EXPECT_EQ(Answer::kLeave, wheel_.OnWheel(At(1000, 0, 120, true), false));
+  EXPECT_EQ(Answer::kLeave, wheel_.OnWheel(At(1500, 0, -120, true), false));
+  EXPECT_EQ(Answer::kPrevious, wheel_.OnWheel(At(2000, 120, 0, true), true));
+  EXPECT_EQ(Answer::kNext, wheel_.OnWheel(At(2500, -120, 0, true), true));
+}
+
+// Shift turns the vertical wheel sideways, down as to the right.
+TEST_F(SpaceWheelTest, ShiftTurnsTheWheelSideways) {
+  EXPECT_EQ(Answer::kNext,
+            wheel_.OnWheel(At(0, 0, 120, true, /*shift=*/true), false));
+  EXPECT_EQ(Answer::kPrevious,
+            wheel_.OnWheel(At(500, 0, -120, true, /*shift=*/true), false));
+}
+
+// Ctrl steps with the vertical wheel too, down as to the next Space.
+TEST_F(SpaceWheelTest, CtrlStepsWithEitherWheel) {
+  EXPECT_EQ(Answer::kNext, wheel_.OnWheel(At(0, 0, 120, true, false, true),
+                                          false));
+  EXPECT_EQ(Answer::kPrevious,
+            wheel_.OnWheel(At(500, 0, -120, true, false, true), false));
+  EXPECT_EQ(Answer::kNext, wheel_.OnWheel(At(1000, 120, 0, true, false, true),
+                                          false));
+}
+
+// One Space a notch, and none within the cooldown: notches 50 ms apart take
+// one step until 200 ms have passed since it.
+TEST_F(SpaceWheelTest, AFastWheelStepsOnceACooldown) {
+  EXPECT_EQ(Answer::kNext, wheel_.OnWheel(At(0, 120, 0, true), false));
+  EXPECT_EQ(Answer::kTake, wheel_.OnWheel(At(50, 120, 0, true), false));
+  EXPECT_EQ(Answer::kTake, wheel_.OnWheel(At(100, 120, 0, true), false));
+  EXPECT_EQ(Answer::kTake, wheel_.OnWheel(At(150, 120, 0, true), false));
+  EXPECT_EQ(Answer::kNext, wheel_.OnWheel(At(200, 120, 0, true), false));
+  EXPECT_EQ(Answer::kTake, wheel_.OnWheel(At(250, 240, 0, true), false))
+      << "two notches at once are one step";
+}
+
+// A continuous stream steps once it has gone a notch's way, and only once:
+// the rest of the swipe and its coasting take nothing more, until a pause
+// ends the stream.
+TEST_F(SpaceWheelTest, AContinuousStreamStepsOnce) {
+  int ms = 0;
+  for (int i = 0; i < 5; ++i, ms += 10) {
+    EXPECT_EQ(Answer::kTake, wheel_.OnWheel(At(ms, 20, 1, false), false))
+        << "event " << i;
+  }
+  EXPECT_EQ(Answer::kNext, wheel_.OnWheel(At(ms, 20, 1, false), false));
+  for (int i = 0; i < 60; ++i) {
+    ms += 10;
+    EXPECT_EQ(Answer::kTake, wheel_.OnWheel(At(ms, 20, 0, false), false))
+        << "the stream stepped already, event " << i;
+  }
+  ms += 400;
+  EXPECT_EQ(Answer::kTake, wheel_.OnWheel(At(ms, -60, 0, false), false));
+  EXPECT_EQ(Answer::kPrevious,
+            wheel_.OnWheel(At(ms + 10, -60, 0, false), false));
+}
+
+// A vertical stream that drifts sideways is the list's to its end.
+TEST_F(SpaceWheelTest, AVerticalStreamNeverSteps) {
+  EXPECT_EQ(Answer::kLeave, wheel_.OnWheel(At(0, 2, 20, false), false));
+  for (int i = 1; i < 30; ++i) {
+    EXPECT_EQ(Answer::kLeave, wheel_.OnWheel(At(i * 10, 40, 10, false), false))
+        << "event " << i;
+  }
+}
+
 }  // namespace stedding
