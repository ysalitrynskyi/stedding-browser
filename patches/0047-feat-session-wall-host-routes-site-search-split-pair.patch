+bool TabStripModel::MoveTabsToFolderAt(const std::vector<int> indices,
+                                       tabs::FolderTabCollection* folder,
+                                       size_t child_index) {
+  CHECK(folder);
+  if (indices.empty()) {
+    return false;
+  }
+  for (const int index : indices) {
+    CHECK(ContainsIndex(index));
+    if (IsTabPinned(index)) {
+      return false;
+    }
+  }
+  const size_t folder_tabs = folder->TabCountRecursive();
+  if (folder_tabs == 0 ||
+      !contents_data_->CanMoveTabsIntoFolder(indices, folder)) {
+    return false;
+  }
+  if (child_index >= folder->ChildCount()) {
+    return MoveTabsToFolder(indices, folder);
+  }
+  const size_t recursive =
+      std::min(child_index, folder_tabs - 1);
+  const int destination =
+      GetIndexOfTab(folder->GetTabAtIndexRecursive(recursive));
+  int num_tabs_to_left = 0;
+  for (const int index : indices) {
+    if (index < destination) {
+      ++num_tabs_to_left;
+    }
+  }
+  bool moved = false;
+  MoveTabsWithNotifications(
+      indices, destination - num_tabs_to_left,
+      base::BindOnce(
+          [](tabs::TabStripCollection* contents,
+             const std::vector<int>& indices, tabs::FolderTabCollection* folder,
+             size_t child_index, bool* out) {
+            *out = contents->MoveTabsIntoFolderAt(indices, folder, child_index);
+          },
+          contents_data_.get(), indices, folder, child_index, &moved));
+  return moved;
+}
