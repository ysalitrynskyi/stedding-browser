+bool BrowserView::ShowSteddingSitePanel(views::View* anchor) {
+  content::WebContents* const contents = GetActiveWebContents();
+  if (!contents || !anchor || !anchor->GetWidget() || !GetWidget()) {
+    return false;
+  }
+  content::NavigationEntry* const entry =
+      contents->GetController().GetVisibleEntry();
+  if (!entry || entry->IsInitialEntry()) {
+    return false;
+  }
