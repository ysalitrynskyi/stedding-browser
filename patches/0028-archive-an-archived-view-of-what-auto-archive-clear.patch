+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/sessions/core/serialized_navigation_entry_test_helper.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "components/tabs/public/tab_interface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+std::unique_ptr<sessions::tab_restore::Tab> ClosedTab(int id,
+                                                      const char* url,
+                                                      const char16_t* title,
+                                                      base::Time when,
+                                                      const char* reason) {
+  auto tab = std::make_unique<sessions::tab_restore::Tab>();
+  tab->id = SessionID::FromSerializedValue(id);
+  tab->timestamp = when;
+  sessions::SerializedNavigationEntry entry =
+      sessions::SerializedNavigationEntryTestHelper::CreateNavigationForTest();
+  entry.set_virtual_url(GURL(url));
+  entry.set_title(title);
+  tab->navigations.push_back(std::move(entry));
+  tab->current_navigation_index = 0;
+  tab->extra_data[kArchiveSpaceNameKey] = "Work";
+  tab->extra_data[spaces::kSessionTabSpaceKey] = "deadbeef";
+  if (reason) {
+    tab->extra_data[kArchiveReasonKey] = reason;
+  }
+  return tab;
+}
+
+// A11: what is older than the retention is not shown; the rest carries its
+// Space, reason and address.
+TEST(ArchivePageTest, RetentionFiltersOldEntries) {
+  const base::Time now = base::Time::Now();
+  sessions::TabRestoreService::Entries entries;
+  entries.push_back(
+      ClosedTab(1, "https://a.example/", u"A", now - base::Days(1), "auto"));
+  entries.push_back(
+      ClosedTab(2, "https://b.example/", u"B", now - base::Days(40), "clear"));
+  entries.push_back(
+      ClosedTab(3, "https://c.example/", u"C", now - base::Hours(2), nullptr));
+  const std::vector<ArchivedTab> shown =
+      ListArchivedTabs(entries, now, base::Days(30));
+  ASSERT_EQ(2u, shown.size());
+  EXPECT_EQ(u"A", shown[0].title);
+  EXPECT_EQ("auto", shown[0].reason);
+  EXPECT_EQ("Work", shown[0].space_name);
+  EXPECT_EQ(GURL("https://a.example/"), shown[0].url);
+  EXPECT_EQ(u"C", shown[1].title);
+  EXPECT_TRUE(shown[1].reason.empty()) << "a plain close has no reason";
+  EXPECT_EQ(3u, ListArchivedTabs(entries, now, base::Days(90)).size());
+  const base::DictValue value = ArchivedTabToValue(shown[0]);
+  EXPECT_EQ("1", *value.FindString("id"));
+  EXPECT_EQ("Work", *value.FindString("spaceName"));
+}
+
+class ArchivePageWindowTest : public BrowserWithTestWindowTest {
+ protected:
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+};
+
+// A9: a restore names a Space that is gone; it comes back by name, once.
+TEST_F(ArchivePageWindowTest, RestoreRecreatesAMissingSpace) {
+  const spaces::SpaceId home = model().active_id();
+  ASSERT_EQ(1u, model().size());
+  const spaces::SpaceId made = SpaceForRestore(&model(), "gone", "Work");
+  EXPECT_NE(home, made);
+  ASSERT_EQ(2u, model().size());
+  EXPECT_EQ("Work", model().GetSpace(made)->name());
+  EXPECT_EQ(made, SpaceForRestore(&model(), "gone", "Work"))
+      << "the second restore finds it by name";
+  EXPECT_EQ(made, SpaceForRestore(&model(), made.ToString(), "Renamed"))
+      << "an id that still exists wins over the name";
+  EXPECT_EQ(home, SpaceForRestore(&model(), "", ""))
+      << "nothing known: the active Space";
+  EXPECT_EQ(2u, model().size());
+}
+
+// A8: the mark and the Space name reach the closed tab's data.
+TEST_F(ArchivePageWindowTest, MarkThenPopulate) {
+  AddTab(browser(), GURL("https://a.example/"));
+  tabs::TabInterface* const tab = browser()->tab_strip_model()->GetActiveTab();
+  std::map<std::string, std::string> extra_data;
+  PopulateArchiveExtraData(tab, &extra_data);
+  EXPECT_FALSE(extra_data.contains(kArchiveReasonKey));
+  EXPECT_EQ("Space 1", extra_data[kArchiveSpaceNameKey]);
+  MarkForArchive(tab->GetContents(), ArchiveReason::kClear);
+  extra_data.clear();
+  PopulateArchiveExtraData(tab, &extra_data);
+  EXPECT_EQ("clear", extra_data[kArchiveReasonKey]);
+  EXPECT_EQ(ArchiveReason::kClear, *ArchiveMarkOf(tab->GetContents()));
+}
+
+}  // namespace
+}  // namespace stedding
