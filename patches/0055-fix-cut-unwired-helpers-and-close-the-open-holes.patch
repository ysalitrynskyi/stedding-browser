+std::vector<ChromiumBrowserLocation> ChromiumFamilyLocations() {
+  std::vector<ChromiumBrowserLocation> out;
+  base::FilePath support;
+#if BUILDFLAG(IS_MAC)
+  support = base::apple::GetUserLibraryPath().AppendASCII("Application Support");
+  const struct {
+    const char* dir;
+    const char* name;
+    const char* service;
+    const char* account;
+  } kBrowsers[] = {
+      {"Google/Chrome", "Google Chrome", "Chrome Safe Storage", "Chrome"},
+      {"BraveSoftware/Brave-Browser", "Brave", "Brave Safe Storage", "Brave"},
+      {"Microsoft Edge", "Microsoft Edge", "Microsoft Edge Safe Storage",
+       "Microsoft Edge"},
+      {"Vivaldi", "Vivaldi", "Vivaldi Safe Storage", "Vivaldi"},
+      {"Chromium", "Chromium", "Chromium Safe Storage", "Chromium"},
+  };
+#elif BUILDFLAG(IS_WIN)
+  base::PathService::Get(base::DIR_LOCAL_APP_DATA, &support);
+  const struct {
+    const char* dir;
+    const char* name;
+    const char* service;
+    const char* account;
+  } kBrowsers[] = {
+      {"Google/Chrome/User Data", "Google Chrome", "Chrome Safe Storage",
+       "Chrome"},
+      {"BraveSoftware/Brave-Browser/User Data", "Brave", "Brave Safe Storage",
+       "Brave"},
+      {"Microsoft/Edge/User Data", "Microsoft Edge",
+       "Microsoft Edge Safe Storage", "Microsoft Edge"},
+      {"Vivaldi/User Data", "Vivaldi", "Vivaldi Safe Storage", "Vivaldi"},
+      {"Chromium/User Data", "Chromium", "Chromium Safe Storage", "Chromium"},
+  };
+#else
+  base::PathService::Get(base::DIR_HOME, &support);
+  support = support.AppendASCII(".config");
+  const struct {
+    const char* dir;
+    const char* name;
+    const char* service;
+    const char* account;
+  } kBrowsers[] = {
+      {"google-chrome", "Google Chrome", "Chrome Safe Storage", "Chrome"},
+      {"BraveSoftware/Brave-Browser", "Brave", "Brave Safe Storage", "Brave"},
+      {"microsoft-edge", "Microsoft Edge", "Microsoft Edge Safe Storage",
+       "Microsoft Edge"},
+      {"vivaldi", "Vivaldi", "Vivaldi Safe Storage", "Vivaldi"},
+      {"chromium", "Chromium", "Chromium Safe Storage", "Chromium"},
+  };
+#endif
+  for (const auto& browser : kBrowsers) {
+    ChromiumBrowserLocation location;
+    location.user_data_dir = support.AppendASCII(browser.dir);
+    location.display_name = browser.name;
+    location.keychain_service = browser.service;
+    location.keychain_account = browser.account;
+    out.push_back(std::move(location));
+  }
+  return out;
+}
+
+ChromiumProfileContents ReadChromiumProfile(
+    const base::FilePath& profile_dir,
+    std::string_view safe_storage_password) {
+  ChromiumProfileContents contents;
+  contents.bookmarks = ReadBookmarks(profile_dir.AppendASCII("Bookmarks"));
+  contents.history = spaces::ReadArcHistory(profile_dir.AppendASCII("History"));
+  contents.logins =
+      ReadLogins(profile_dir.AppendASCII("Login Data"), safe_storage_password);
+  return contents;
+}
+
+void ImportChromiumProfile(Profile* profile,
+                           const user_data_importer::SourceProfile& source,
+                           uint16_t items,
+                           base::OnceCallback<void(bool)> done) {
+  if (!profile) {
+    std::move(done).Run(false);
+    return;
+  }
+  const std::string& locale = source.locale;
+  const size_t split = locale.find('\n');
+  const std::string service =
+      split == std::string::npos ? std::string() : locale.substr(0, split);
+  const std::string account = split == std::string::npos
+                                  ? std::string()
+                                  : locale.substr(split + 1);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](base::FilePath dir, std::string service, std::string account) {
+            std::string password;
+            if (const std::optional<std::string> found =
+                    spaces::ReadKeychainGenericPassword(service, account)) {
+              password = *found;
+            }
+            return ReadChromiumProfile(dir, password);
+          },
+          source.source_path, service, account),
+      base::BindOnce(&WriteOnUi, profile->GetWeakPtr(), items, std::move(done)));
+}
+
