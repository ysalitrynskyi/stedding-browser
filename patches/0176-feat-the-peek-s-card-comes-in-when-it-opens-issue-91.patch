+// P26 (GitHub issue 102): while a peek over the page shows, its page is the
+// window's active tab to extensions, as a peek in a window of its own is. A
+// password manager that knows the tabs from the tabs API's events, and finds
+// the tab to fill by asking for the active tab, fills the peek's page, and
+// after Open as Tab the same page with no reload. This extension does what
+// Bitwarden does: each frame's script asks at document_start for the fill
+// script, which the extension injects by the sender's tab id after tabs.get,
+// into a tab it has been told of; its key fills the window's active tab.
+// The key filled the pinned page under the peek, and after Open as Tab
+// nothing, until a reload.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, APasswordManagerFillsThePeeksPage) {
+  extensions::TestExtensionDir dir;
+  dir.WriteManifest(R"({
+      "name": "Fills the active tab",
+      "version": "1",
+      "manifest_version": 3,
+      "background": {"service_worker": "background.js"},
+      "permissions": ["scripting", "tabs"],
+      "host_permissions": ["<all_urls>"],
+      "content_scripts": [{"matches": ["<all_urls>"], "js": ["trigger.js"],
+                           "run_at": "document_start", "all_frames": true}]
+  })");
+  dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+      const live = new Set();
+      const heard = [];
+      const ready = chrome.tabs.query({}).then(
+          tabs => tabs.forEach(tab => live.add(tab.id)));
+      chrome.tabs.onCreated.addListener(tab => {
+        live.add(tab.id);
+        heard.push('created');
+      });
+      chrome.tabs.onRemoved.addListener(id => {
+        live.delete(id);
+        heard.push('removed');
+      });
+      chrome.tabs.onAttached.addListener(() => heard.push('attached'));
+      const complete = new Set();
+      chrome.tabs.onUpdated.addListener((id, change) => {
+        if (change.status === 'complete') {
+          complete.add(id);
+        }
+      });
+      chrome.runtime.onMessage.addListener((message, sender) => {
+        if (message !== 'trigger' || !sender.tab) {
+          return;
+        }
+        (async () => {
+          await ready;
+          if (!live.has(sender.tab.id)) {
+            return;
+          }
+          const tab = await chrome.tabs.get(sender.tab.id);
+          const target = {tabId: tab.id, frameIds: [sender.frameId]};
+          await chrome.scripting.executeScript(
+              {target, files: ['fill.js'], injectImmediately: true});
+          await chrome.tabs.sendMessage(tab.id, 'start',
+                                        {frameId: sender.frameId});
+        })().catch(error => console.log('no fill script: ' + error.message));
+      });
+      self.fillActive = async () => {
+        await ready;
+        const [tab] = await chrome.tabs.query(
+            {active: true, windowId: chrome.windows.WINDOW_ID_CURRENT});
+        if (!tab || !live.has(tab.id)) {
+          return 'no tab it was told of';
+        }
+        try {
+          return (await chrome.tabs.sendMessage(tab.id, 'fill')) ||
+                 'no answer';
+        } catch (error) {
+          return 'no fill script';
+        }
+      };
+      self.told = () => heard.join(' ');
+      self.loaded = id => String(complete.has(id));
+  )");
+  dir.WriteFile(FILE_PATH_LITERAL("trigger.js"),
+                "chrome.runtime.sendMessage('trigger');");
+  dir.WriteFile(FILE_PATH_LITERAL("fill.js"), R"(
+      if (self.started === undefined) {
+        self.started = false;
+        chrome.runtime.onMessage.addListener((message, sender, reply) => {
+          if (message === 'start') {
+            self.started = true;
+          }
+          if (message === 'fill' && self.started) {
+            reply('filled ' + location.hostname);
+          }
+        });
+      }
+  )");
+  extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+  scoped_refptr<const extensions::Extension> extension =
+      loader.LoadExtension(dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+
+  const auto run = [&](const std::string& script) {
+    base::Value said = extensions::BackgroundScriptExecutor::ExecuteScript(
+        browser()->GetProfile(), extension->id(),
+        script + ".then(said => chrome.test.sendScriptResult(said));",
+        extensions::BackgroundScriptExecutor::ResultCapture::kSendScriptResult);
+    return said.is_string() ? said.GetString() : std::string("not a string");
+  };
+  // The extension's key, pressed until it says `expected`, for up to ten
+  // seconds: what it said last.
+  const auto press_fill = [&](const std::string& expected) {
+    std::string said;
+    for (int i = 0; i < 100; ++i) {
+      said = run("fillActive()");
+      if (said == expected) {
+        break;
+      }
+      base::RunLoop wait;
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE, wait.QuitClosure(), base::Milliseconds(100));
+      wait.Run();
+    }
+    return said;
+  };
+
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title2.html")));
+  tabs::TabInterface* const pin = tab();
+  ASSERT_EQ("filled a.test", press_fill("filled a.test"))
+      << "the extension does not fill a tab";
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  ASSERT_TRUE(content::ExecJs(page, "window.kept = 1;"));
+  EXPECT_EQ("filled b.test", press_fill("filled b.test"))
+      << "the key did not fill the peek's page";
+  EXPECT_EQ("true",
+            run(base::StringPrintf(
+                "Promise.resolve(loaded(%d))",
+                sessions::SessionTabHelper::IdForTab(page).id())))
+      << "no tabs.onUpdated said the peek's page had loaded";
+
+  Press(peek->view()->open_as_tab_button());
+  ASSERT_TRUE(WaitForNoPeek(pin));
+  ASSERT_EQ(page, contents());
+  EXPECT_EQ("filled b.test", press_fill("filled b.test"))
+      << "after Open as Tab the page did not fill";
+  EXPECT_EQ(1, content::EvalJs(page, "window.kept")) << "it loaded again";
+
+  // A peek closed is a tab removed.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+  ClickLink();
+  stedding::PeekOverlay* const second = WaitForPeek(pin);
+  ASSERT_TRUE(second);
+  Press(second->view()->close_button());
+  ASSERT_TRUE(WaitForNoPeek(pin));
+  EXPECT_EQ("filled a.test", press_fill("filled a.test"))
+      << "with the peek closed the key did not fill the pinned page";
+  EXPECT_EQ("created created attached created removed",
+            run("Promise.resolve(told())"))
+      << "the tabs API told the extension otherwise";
+}
