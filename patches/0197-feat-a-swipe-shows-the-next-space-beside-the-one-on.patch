+#if BUILDFLAG(IS_MAC)
+// spaces B35: the Space a swipe would bring in, as it is drawn beside `view`
+// while the fingers move: an unowned layer at the view's place, as wide. It
+// hangs above the strip, which clips to the Space on screen, so it is looked
+// for among the children of each layer above the view's own.
+ui::Layer* SwipePreviewBeside(const views::View* view) {
+  const ui::Layer* const own = view->layer();
+  if (!own) {
+    return nullptr;
+  }
+  gfx::Point origin = own->bounds().origin();
+  for (const ui::Layer* parent = own->parent(); parent;
+       parent = parent->parent()) {
+    for (const auto& layer : parent->children()) {
+      if (!layer->owner() && layer->name() == "SpaceSwipePreview" &&
+          layer->bounds().origin() == origin &&
+          layer->bounds().width() == own->bounds().width()) {
+        return layer.get();
+      }
+    }
+    origin += parent->bounds().OffsetFromOrigin();
+  }
+  return nullptr;
+}
