+// sessions S49: the jar several Spaces name goes to the Space on screen when
+// it uses the jar, else the first that uses it, else the first that names it.
+TEST_F(SharedSessionWindowTest, AJarBelongsToTheSpaceOnScreenThatUsesIt) {
+  const SpaceId home = model().active_id();
+  const SpaceId off = model().AddSpace("Off", kBlue)->id();
+  const SpaceId mail = model().AddSpace("Mail", kBlue)->id();
+  const SpaceId docs = model().AddSpace("Docs", kBlue)->id();
+  const std::string jar = ShareSession(mail, docs);
+  model().SetSpaceSession(off, jar);
+  model().SetSpaceIsolated(off, false);
+  const content::StoragePartitionConfig config = ConfigFor(jar);
+
+  EXPECT_EQ(mail, model().SpaceNamingJar(config));
+  EXPECT_EQ(mail, model().SpaceKeepingJar(config));
+  model().SetActiveSpace(docs);
+  EXPECT_EQ(docs, model().SpaceNamingJar(config));
+  EXPECT_EQ(docs, model().SpaceKeepingJar(config));
+  model().SetActiveSpace(home);
+  model().SetSpaceIsolated(mail, false);
+  model().SetSpaceIsolated(docs, false);
+  EXPECT_EQ(off, model().SpaceNamingJar(config));
+  EXPECT_FALSE(model().SpaceKeepingJar(config));
+}
