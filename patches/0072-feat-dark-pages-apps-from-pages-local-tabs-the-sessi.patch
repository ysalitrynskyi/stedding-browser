+  // profile itself, not left out of session restore.
+  const BrowserWindowInterface::Type type = opened->GetType();
+  if (type != BrowserWindowInterface::Type::TYPE_NORMAL &&
+      type != BrowserWindowInterface::Type::TYPE_POPUP) {
+    return;
+  }
+  Profile* const profile = opened->GetProfile();
+  if (!profile || profile->IsOffTheRecord() ||
+      BrowserInitState::From(opened)->omit_from_session_restore()) {
+    return;
