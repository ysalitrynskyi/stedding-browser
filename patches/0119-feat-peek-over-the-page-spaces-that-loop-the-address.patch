+
+content::KeyboardEventProcessingResult PeekOverlay::PreHandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  return content::KeyboardEventProcessingResult::NOT_HANDLED;
+}
+
+bool PeekOverlay::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  // The page did not take it. The peek's own keys first, whether or not the
+  // peek's widget is the active window; any other is the window's, whose
+  // shortcuts work from the peek as from its page.
+  if (event.GetType() == blink::WebInputEvent::Type::kRawKeyDown) {
+    if (const std::optional<PeekCommand> command =
+            CommandFor(ui::GetAcceleratorFromNativeWebKeyboardEvent(event))) {
+      RunSoon(GetWeakPtr(), *command);
+      return true;
+    }
+  }
+  if (widget_ && unhandled_keyboard_event_handler_.HandleKeyboardEvent(
+                     event, widget_->GetFocusManager())) {
+    return true;
+  }
+  BrowserWindowInterface* const window =
+      source_ ? source_->GetBrowserWindowInterface() : nullptr;
+  BrowserView* const browser_view =
+      window ? BrowserView::GetBrowserViewForBrowser(window) : nullptr;
+  return browser_view && browser_view->HandleKeyboardEvent(event);
+}
