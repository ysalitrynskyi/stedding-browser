@@ -0,0 +1,175 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/toolbar/stedding_dark_pages_button.h"
+
+#include <iterator>
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/dark_pages.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/vector_icon_types.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view_class_properties.h"
+
+namespace stedding {
+
+namespace {
+
+// Dk16: the moon, a crescent cut from a circle. Off, its outline; on, filled.
+// Drawn for the toolbar's 20 DIP canvas; the touch form is the same icon.
+// clang-format off
+constexpr gfx::PathElement kDarkPagesOffPath[] = {
+    gfx::CANVAS_DIMENSIONS, 20,
+    gfx::STROKE, 1.5f,
+    gfx::MOVE_TO, 8.98f, 3.83f,
+    gfx::ARC_TO, 6.25f, 6.25f, 0, 1, 0, 16.17f, 11.02f,
+    gfx::ARC_TO, 5.25f, 5.25f, 0, 0, 1, 8.98f, 3.83f,
+    gfx::CLOSE};
+// clang-format on
+constexpr gfx::VectorIconRep kDarkPagesOffReps[] = {{kDarkPagesOffPath}};
+constexpr gfx::VectorIcon kDarkPagesOffIcon = {
+    kDarkPagesOffReps, std::size(kDarkPagesOffReps), "stedding_dark_pages_off"};
+
+// clang-format off
+constexpr gfx::PathElement kDarkPagesOnPath[] = {
+    gfx::CANVAS_DIMENSIONS, 20,
+    gfx::MOVE_TO, 8.74f, 3.11f,
+    gfx::ARC_TO, 7, 7, 0, 1, 0, 16.89f, 11.26f,
+    gfx::ARC_TO, 6, 6, 0, 0, 1, 8.74f, 3.11f,
+    gfx::CLOSE};
+// clang-format on
+constexpr gfx::VectorIconRep kDarkPagesOnReps[] = {{kDarkPagesOnPath}};
+constexpr gfx::VectorIcon kDarkPagesOnIcon = {
+    kDarkPagesOnReps, std::size(kDarkPagesOnReps), "stedding_dark_pages_on"};
+
+}  // namespace
+
+DEFINE_CLASS_ELEMENT_IDENTIFIER_VALUE(DarkPagesButton, kElementId);
+
+DarkPagesButton::DarkPagesButton(BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(&DarkPagesButton::OnPressed,
+                                        base::Unretained(this))),
+      browser_(browser) {
+  SetProperty(views::kElementIdentifierKey, kElementId);
+  // Dk16: a switch, named for what it switches; its state is the checked
+  // state, not a second name.
+  GetViewAccessibility().SetRole(ax::mojom::Role::kToggleButton);
+  GetViewAccessibility().SetName(u"Dark pages");
+  Profile* const profile = browser_->GetProfile();
+  watcher_ = std::make_unique<DarkPagesWatcher>(
+      profile,
+      base::BindRepeating(&DarkPagesButton::Update, base::Unretained(this)));
+  // Dk17: the setting is the profile's; a private window's preferences pass
+  // its changes on.
+  registrar_.Init(profile->GetPrefs());
+  registrar_.Add(
+      prefs::kDarkPagesButton,
+      base::BindRepeating(&DarkPagesButton::Update, base::Unretained(this)));
+  Update();
+}
+
+DarkPagesButton::~DarkPagesButton() = default;
+
+std::u16string DarkPagesButton::GetRenderedTooltipText(
+    const gfx::Point& p) const {
+  content::WebContents* const contents =
+      browser_->GetTabStripModel()
+          ? browser_->GetTabStripModel()->GetActiveWebContents()
+          : nullptr;
+  if (on_ && contents && !IsNeverDarkenedUrl(DarkPagesUrlFor(contents)) &&
+      !DarkPagesApplyTo(contents)) {
+    // The tab's page is light although the switch is on: its site is on a
+    // list, or not on "only these sites"' one.
+    if (const std::optional<ContentSettingsPattern> site =
+            DarkPagesSitePatternFor(DarkPagesUrlFor(contents))) {
+      return base::StrCat({u"Dark pages are on; ",
+                           base::UTF8ToUTF16(DarkPagesSiteName(*site)),
+                           u" is kept light. ", ActionText()});
+    }
+  }
+  return ActionText();
+}
+
+void DarkPagesButton::OnPressed() {
+  // The window's command, so the button, the chord and the bar are one path
+  // (Dk16, Dk18, Dk19).
+  chrome::ExecuteCommand(browser_, IDC_STEDDING_TOGGLE_DARK_PAGES);
+}
+
+void DarkPagesButton::Update() {
+  Profile* const profile = browser_->GetProfile();
+  on_ = DarkPagesOn(profile);
+  SetVisible(profile->GetPrefs()->GetBoolean(prefs::kDarkPagesButton));
+  SetVectorIcons(on_ ? kDarkPagesOnIcon : kDarkPagesOffIcon,
+                 on_ ? kDarkPagesOnIcon : kDarkPagesOffIcon);
+  UpdateHighlight();
+  SetTooltipText(ActionText());
+  GetViewAccessibility().SetCheckedState(on_ ? ax::mojom::CheckedState::kTrue
+                                             : ax::mojom::CheckedState::kFalse);
+}
+
+void DarkPagesButton::AddedToWidget() {
+  ToolbarButton::AddedToWidget();
+  UpdateHighlight();
+  // The chord in the tooltip is the window's (ActionText), and the button is
+  // made and added while the window is still being built, before the
+  // browser knows its window: the stored tooltip, and the accessible
+  // description taken from it, lacked the chord until the first change of
+  // state. Once the window is built it is there.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<DarkPagesButton> button) {
+                       if (button) {
+                         button->SetTooltipText(button->ActionText());
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void DarkPagesButton::UpdateHighlight() {
+  // Chromium's active look for a toolbar button, as a pinned action's while
+  // its panel is open.
+  if (!on_) {
+    highlight_.reset();
+  } else if (!highlight_ && GetWidget()) {
+    highlight_.emplace(AddAnchorHighlight());
+  }
+}
+
+std::u16string DarkPagesButton::ActionText() const {
+  std::u16string text = on_ ? u"Turn dark pages off" : u"Turn dark pages on";
+  // The chord the window binds, as the menus print it; nothing when the
+  // window has none.
+  ui::Accelerator accelerator;
+  if (BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser_);
+      view && view->GetAcceleratorForCommandId(IDC_STEDDING_TOGGLE_DARK_PAGES,
+                                               &accelerator)) {
+    base::StrAppend(&text, {u" (", accelerator.GetShortcutText(), u")"});
+  }
+  return text;
+}
+
+BEGIN_METADATA(DarkPagesButton)
+END_METADATA
+
+}  // namespace stedding
