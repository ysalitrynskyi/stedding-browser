+namespace {
+
+// Every marked hit on the settings page, through every shadow root, one a
+// line: the ids of what holds it, out through its shadow hosts, then its text.
+constexpr char kHits[] = R"(
+  (() => {
+    const hits = [];
+    const walk = root => {
+      for (const element of root.querySelectorAll('*')) {
+        if (element.classList.contains('search-highlight-hit')) {
+          const ids = [];
+          for (let at = element; at;
+               at = at.parentElement || at.getRootNode().host) {
+            if (at.id) {
+              ids.push(at.id);
+            }
+          }
+          hits.push(ids.join(',') + ':' + element.textContent.trim());
+        }
+        if (element.shadowRoot) {
+          walk(element.shadowRoot);
+        }
+      }
+    };
+    walk(document);
+    return hits.join('\n');
+  })()
+)";
+
+constexpr char kSteddingPageHidden[] = R"(
+  (() => {
+    const find = (root, selector) => {
+      const hit = root.querySelector(selector);
+      if (hit) {
+        return hit;
+      }
+      for (const element of root.querySelectorAll('*')) {
+        if (element.shadowRoot) {
+          const found = find(element.shadowRoot, selector);
+          if (found) {
+            return found;
+          }
+        }
+      }
+      return null;
+    };
+    const page = find(document, 'settings-stedding-page');
+    return !page || page.hasAttribute('hidden-by-search');
+  })()
+)";
+
+void PressKey(stedding::CommandBarView& bar, ui::KeyboardCode key) {
+  bar.HandleKeyEvent(bar.field_for_testing(),
+                     ui::KeyEvent(ui::EventType::kKeyPressed, key, ui::EF_NONE));
+}
+
+class FindWordsTest : public InProcessBrowserTest {
+ protected:
+  content::WebContents* Search(std::string_view words) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(
+        browser(),
+        GURL(base::StrCat({"chrome://settings/?search=",
+                           base::EscapeQueryParamValue(words,
+                                                       /*use_plus=*/false)}))));
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  // Waits until a hit marks the row `row` with the row's own text, not
+  // the word searched for, which is nowhere on the page.
+  bool MarksRow(content::WebContents* page, std::string_view row) {
+    return base::test::RunUntil([&]() {
+      const std::string hits = content::EvalJs(page, kHits).ExtractString();
+      return hits.find(row) != std::string::npos;
+    });
+  }
+};
+
+// settings T58: each word marks its row, and no label holds the word. Each
+// search loads Settings, about 8 seconds a time on Windows with DCHECKs, so
+// the words are split between tests to stay within the launcher's 45.
+IN_PROC_BROWSER_TEST_F(FindWordsTest, ArcsWordsFindTheRoutes) {
+  for (const char* words : {"air traffic", "traffic", "routing"}) {
+    SCOPED_TRACE(words);
+    EXPECT_TRUE(MarksRow(Search(words), "routesIntro"));
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(FindWordsTest, ArcsWordsFindTheRoutesWithTheWholeName) {
+  for (const char* words : {"air traffic control", "routes"}) {
+    SCOPED_TRACE(words);
+    EXPECT_TRUE(MarksRow(Search(words), "routesIntro"));
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(FindWordsTest, ArcsWordsFindASpacesSession) {
+  for (const char* words : {"profile", "profiles"}) {
+    SCOPED_TRACE(words);
+    EXPECT_TRUE(MarksRow(Search(words), "spacesOwnSession"));
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(FindWordsTest, ArcsWordsFindEssentialsAndLittleWindows) {
+  EXPECT_TRUE(MarksRow(Search("favorites"), "essentialsPerRowLabel"));
+  EXPECT_TRUE(MarksRow(Search("little arc"), "littleWindow"));
+}
+
+IN_PROC_BROWSER_TEST_F(FindWordsTest, ArcsWordsFindTheArchiveAndTheAddress) {
+  EXPECT_TRUE(MarksRow(Search("auto-archive"), "archiveLabel"));
+  EXPECT_TRUE(MarksRow(Search("url bar"), "addressInSidebar"));
+}
+
+// settings T58: the word is nowhere on the page and the page is long, so the
+// first mark comes into view. On the real build the page stayed at its top.
+IN_PROC_BROWSER_TEST_F(FindWordsTest, TheFirstMarkComesIntoView) {
+  content::WebContents* const page = Search("air traffic");
+  ASSERT_TRUE(MarksRow(page, "routesIntro"));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, R"(
+        (() => {
+          const find = root => {
+            for (const element of root.querySelectorAll('*')) {
+              if (element.classList.contains('search-highlight-hit')) {
+                return element;
+              }
+              const inside = element.shadowRoot && find(element.shadowRoot);
+              if (inside) {
+                return inside;
+              }
+            }
+            return null;
+          };
+          const box = find(document).getBoundingClientRect();
+          return box.top >= 0 && box.bottom <= window.innerHeight;
+        })())")
+        .ExtractBool();
+  })) << "the mark is off screen";
+}
+
+// settings T58: a word the table does not hold finds nothing: Stedding has no
+// Boosts, and its page stays out of the results.
+IN_PROC_BROWSER_TEST_F(FindWordsTest, ABoostFindsNothingInSettings) {
+  content::WebContents* const page = Search("boost");
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return content::EvalJs(page, kSteddingPageHidden).ExtractBool(); }))
+      << content::EvalJs(page, kHits).ExtractString();
+}
