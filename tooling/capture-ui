#!/usr/bin/env bash
# Screenshot the built browser's window, and nothing else.
#
# Usage:
#   tooling/capture-ui [--out FILE] [--size WxH] [--url URL]
#                      [--features LIST] [--disable-features LIST] [--build DIR]
#
# Why not `screencapture` on its own: it photographs the whole screen, which on a
# machine somebody is using means photographing whatever they have open. This
# asks the window server for the browser's own window id and captures that
# rectangle. It also means the browser does not have to be frontmost, or even on
# the current Space, so the capture never steals focus or interrupts anyone.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

main() {
  OUT="$STEDDING_ROOT/ui-capture.png"
  SIZE="1400,880"
  URL="https://example.com/"
  FEATURES=""
  DISABLE_FEATURES=""
  BUILD="release"

  while [ $# -gt 0 ]; do
    # Accept --opt=value as well as --opt value: every flag here is passed
    # through to Chromium, which spells them with an equals sign, so that is the
    # form that gets typed.
    case "$1" in
      --*=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;;
    esac
    case "$1" in
      --out)      OUT="$2"; shift 2 ;;
      --size)     SIZE="$(printf '%s' "$2" | tr 'x' ',')"; shift 2 ;;
      --url)      URL="$2"; shift 2 ;;
      --features) FEATURES="$2"; shift 2 ;;
      --disable-features) DISABLE_FEATURES="$2"; shift 2 ;;
      --build)    BUILD="$2"; shift 2 ;;
      -h|--help)  sed -n '2,12p' "$0"; exit 0 ;;
      *)          die "unknown argument: $1" ;;
    esac
  done

  ABS_OUT="$CHROMIUM_SRC/out/$BUILD"
  APP="$(find_app_bundle "$ABS_OUT" || true)"
  if [ -z "$APP" ] || [ ! -d "$APP" ]; then
    die "no app bundle in $ABS_OUT — run tooling/build-chromium $BUILD"
  fi

  BIN="$APP/Contents/MacOS/$(basename "$APP" .app)"
  [ -x "$BIN" ] || die "no executable at $BIN"

  PROFILE="$(mktemp -d "${TMPDIR:-/tmp}/stedding-capture.XXXXXX")"
  # A throwaway profile keeps the capture reproducible and keeps the operator's
  # real profile, and their Keychain, out of it entirely.
  trap 'rm -rf "$PROFILE"' EXIT

  set -- --user-data-dir="$PROFILE" --no-first-run --no-default-browser-check \
         --window-size="$SIZE"
  [ -n "$FEATURES" ] && set -- "$@" --enable-features="$FEATURES"
  [ -n "$DISABLE_FEATURES" ] && set -- "$@" --disable-features="$DISABLE_FEATURES"

  log "launching $(basename "$APP") at $SIZE"
  "$BIN" "$@" "$URL" >/dev/null 2>&1 &
  BROWSER_PID=$!
  trap 'kill -9 $BROWSER_PID 2>/dev/null; rm -rf "$PROFILE"' EXIT

  # First paint plus a moment for the page to settle. There is no signal to wait
  # on from outside the process, so this is a plain wait.
  sleep 20

  python3 "$STEDDING_ROOT/tooling/capture-window.py" "$(basename "$APP" .app)" "$OUT" \
    || die "capture failed"

  log "wrote $OUT"
}

main "$@"
