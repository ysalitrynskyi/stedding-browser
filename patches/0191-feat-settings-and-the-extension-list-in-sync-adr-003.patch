+                    const std::string& install) {
+  Settings settings;
+  settings[path] = SettingField{SettingJson(value), Stamp{t, install}};
+  return settings;
+}
+
+base::DictValue Route(const std::string& pattern, const std::string& space) {
+  base::DictValue route;
+  route.Set("match", "site");
+  route.Set("pattern", pattern);
+  route.Set("space", space);
+  return route;
+}
+
+// A small file of one computer, with or without the parts.
+std::string FileOf(const FileParts& parts) {
+  State state;
+  Record space(Kind::kSpace);
+  space.f[kFieldName] = Field{"Work", Stamp{10, kOffice}};
+  state.records["0123456789ABCDEF0123456789ABCDEF"] = space;
+  state.lists[kSpacesList].order = {"0123456789ABCDEF0123456789ABCDEF"};
+  state.lists[kSpacesList].s = Stamp{10, kOffice};
+  FileMeta meta;
+  meta.install = kOffice;
+  meta.device = "Office";
+  meta.seq = 3;
+  meta.nonce = "nonce";
+  meta.written_ms = 20;
+  meta.hlc = 20;
+  meta.joined_ms = 1;
+  return SerializeSyncFile(state, meta, parts);
+}
