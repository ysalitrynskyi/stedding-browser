+// Ctrl+Shift+M stays the profile menu. The picture-in-picture key is the
+// actions bar's chord with Option (Alt) added. Both are in the list.
+TEST(ShortcutReferenceTest, TheMuteKeyIsNotMinimize) {
+  const auto listed = [](const std::u16string& chord,
+                         const std::u16string& what) {
+    for (const ShortcutGroup& group : ShortcutReference()) {
+      for (const ShortcutRow& row : group.rows) {
+        if (row.chord == chord && row.what.starts_with(what)) {
+          return true;
+        }
+      }
+    }
+    return false;
+  };
+  const std::u16string mute = ChordText(IDC_STEDDING_TOGGLE_TAB_MUTED);
+  ASSERT_FALSE(mute.empty());
+  EXPECT_EQ(ChordText(ui::VKEY_M, ui::EF_CONTROL_DOWN), mute);
+  EXPECT_NE(ChordText(IDC_SHOW_AVATAR_MENU), mute);
+#if BUILDFLAG(IS_MAC)
+  EXPECT_NE(ChordText(ui::VKEY_M, ui::EF_COMMAND_DOWN), mute);
+  EXPECT_NE(ChordText(IDC_MINIMIZE_WINDOW), mute);
+#endif
+  EXPECT_TRUE(listed(mute, u"Mute the tab or unmute it"));
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+  const std::u16string picture =
+      ChordText(IDC_STEDDING_TOGGLE_PICTURE_IN_PICTURE);
+  EXPECT_EQ(ChordText(ui::VKEY_P, ui::EF_PLATFORM_ACCELERATOR |
+                                      ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN),
+            picture);
+  EXPECT_TRUE(listed(picture, u"Play the page’s video in picture in picture"));
+#endif
+}
+
+// tabs R28: ⇧⌘T / Ctrl+Shift+T, Chromium's Reopen Closed Tab, is in the
+// list with the chord the platform's table binds.
+TEST(ShortcutReferenceTest, ReopenClosedTabIsListed) {
+  const std::u16string chord = ChordText(IDC_RESTORE_TAB);
+  ASSERT_FALSE(chord.empty());
+  bool found = false;
+  for (const ShortcutGroup& group : ShortcutReference()) {
+    for (const ShortcutRow& row : group.rows) {
+      found |= row.chord == chord &&
+               row.what.find(u"Reopen closed tabs") != std::u16string::npos;
+    }
+  }
+  EXPECT_TRUE(found);
+}
