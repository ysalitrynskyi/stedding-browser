+++ b/chrome/test/stedding/audit_w2_b10_browsertest.cc
@@ -0,0 +1,236 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/windows.md G16, G19 (ADR 0035): the backups the first launch
+// with the pin store takes, and a crash restore into a window that already
+// made its tabs of the pins.
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/run_loop.h"
+#include "base/strings/string_util.h"
+#include "base/test/run_until.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/exit_type_service.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/pin_mirror.h"
+#include "chrome/browser/ui/spaces/pin_store.h"
+#include "chrome/browser/ui/spaces/pin_store_factory.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_ledger.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_tracker.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/tab_parents.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/test_utils.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "url/gurl.h"
+
+namespace {
+
+// How many windows the first launch with the store backs up: one more than
+// the backups a sync join keeps.
+constexpr size_t kWindowsW2B10 = 6;
+
+// The tabs of `window` whose token is `id`.
+std::vector<tabs::TabInterface*> TabsOfRecordW2B10(
+    BrowserWindowInterface* window,
+    const std::string& id) {
+  std::vector<tabs::TabInterface*> found;
+  TabStripModel* const strip = window->GetTabStripModel();
+  for (int i = 0; i < strip->count(); ++i) {
+    tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+    if (stedding::TabToken(tab->GetContents()) == id) {
+      found.push_back(tab);
+    }
+  }
+  return found;
+}
+
+// Whether `window` has a tab on a page whose path is `path`, loaded or not.
+bool HasPageW2B10(BrowserWindowInterface* window, const std::string& path) {
+  TabStripModel* const strip = window->GetTabStripModel();
+  for (int i = 0; i < strip->count(); ++i) {
+    if (strip->GetWebContentsAt(i)->GetVisibleURL().path() == path) {
+      return true;
+    }
+  }
+  return false;
+}
+
+class PinsEveryWindowW2B10Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpInProcessBrowserTestFixture() override {
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::SetUpInProcessBrowserTestFixture();
+    // windows G19: the step before the first launch is a version without the
+    // store, whose windows each keep their own pins.
+    const std::string name =
+        testing::UnitTest::GetInstance()->current_test_info()->name();
+    spaces::PinMirror::SetDisabledForTesting(
+        base::StartsWith(name, "PRE_TheFirstLaunch"));
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  spaces::PinStore& Store() {
+    spaces::PinStore* const store =
+        spaces::PinStoreFactory::GetForProfile(browser()->GetProfile());
+    CHECK(store);
+    return *store;
+  }
+
+  GURL Page(const char* path) { return embedded_test_server()->GetURL(path); }
+
+  // A page opened in `window` and made a Space pin there.
+  tabs::TabInterface* PinPage(BrowserWindowInterface* window, const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        window, url, WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const tab = window->GetTabStripModel()->GetActiveTab();
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+    CHECK(model);
+    model->SetSpacePinned(tab, true);
+    base::RunLoop().RunUntilIdle();
+    return tab;
+  }
+
+  BrowserWindowInterface* OpenWindow() {
+    ui_test_utils::BrowserCreatedObserver opened;
+    chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+    BrowserWindowInterface* const window = opened.Wait();
+    EXPECT_TRUE(window);
+    base::RunLoop().RunUntilIdle();
+    return window;
+  }
+};
+
+// P12-1c, windows G19: the first launch with the store backs up every
+// window's sidebar before the windows' pins are merged. The backups were
+// written side by side, so two in one second could take one name and the
+// second replace the first, and the rotation's five dropped the rest.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowW2B10Test,
+                       PRE_TheFirstLaunchBacksUpEveryWindow) {
+  SessionStartupPref::SetStartupPref(
+      browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  PinPage(browser(), Page("/title1.html"));
+  for (size_t i = 1; i < kWindowsW2B10; ++i) {
+    BrowserWindowInterface* const window = OpenWindow();
+    ASSERT_TRUE(window);
+    PinPage(window, Page(i % 2 ? "/title2.html" : "/title3.html"));
+  }
+  ASSERT_EQ(kWindowsW2B10,
+            spaces::sidebar_sync::RegistryWindows(browser()->GetProfile())
+                .size());
+  EXPECT_FALSE(Store().ready());
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  EXPECT_TRUE(
+      spaces::sidebar_sync::ListBackups(browser()->GetProfile()->GetPath())
+          .empty());
+}
+
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowW2B10Test,
+                       TheFirstLaunchBacksUpEveryWindow) {
+  ASSERT_TRUE(base::test::RunUntil([&] { return Store().ready(); }))
+      << "the store was never filled";
+  ASSERT_EQ(kWindowsW2B10,
+            spaces::sidebar_sync::RegistryWindows(browser()->GetProfile())
+                .size());
+  // The backups are written on the thread pool.
+  content::RunAllTasksUntilIdle();
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  EXPECT_EQ(kWindowsW2B10, spaces::sidebar_sync::ListBackups(
+                               browser()->GetProfile()->GetPath())
+                               .size())
+      << "a window's sidebar from before the merge has no backup";
+}
+
+// P12-1d, windows G10, G16: after a crash the launch restores nothing, and
+// its window makes an asleep tab of each pin. The crash bubble's Restore then
+// brings the session's tabs into that window, asleep too: the restored tab
+// of a pin, with the page it was on and its history, stays the pin's, and
+// the tab made a moment before goes. The made one was kept and the restored
+// one closed without a trace.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowW2B10Test,
+                       PRE_ACrashRestoreKeepsTheRestoredPinsPages) {
+  tabs::TabInterface* const pin = PinPage(browser(), Page("/title1.html"));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Store().ready() && Store().records().size() == 1u;
+  }));
+  // The pin moves on to another page: two pages in its history.
+  ASSERT_TRUE(content::NavigateToURL(pin->GetContents(), Page("/title2.html")));
+  ASSERT_EQ(2, pin->GetContents()->GetController().GetEntryCount());
+  // A loose tab is the one on screen.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Page("/title3.html"), WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_NE(pin, browser()->GetTabStripModel()->GetActiveTab());
+  base::RunLoop().RunUntilIdle();
+  SessionStartupPref::SetStartupPref(
+      browser()->GetProfile(), SessionStartupPref(SessionStartupPref::DEFAULT));
+  // The run ends as a crash does, for the launch after it.
+  ExitTypeService::GetInstanceForProfile(browser()->GetProfile())
+      ->SetWaitingForUserToAckCrashForTest(true);
+}
+
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowW2B10Test,
+                       ACrashRestoreKeepsTheRestoredPinsPages) {
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_EQ(ExitType::kCrashed, ExitTypeService::GetLastSessionExitType(profile));
+  ASSERT_TRUE(Store().ready());
+  ASSERT_EQ(1u, Store().records().size());
+  const std::string id = Store().records().front().id;
+  ASSERT_FALSE(HasPageW2B10(browser(), "/title3.html"))
+      << "a launch after a crash restored";
+
+  // The window's own asleep tab of the pin, at its home.
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return TabsOfRecordW2B10(browser(), id).size() == 1u; }))
+      << "the window made no tab of the pin";
+  content::WebContents* const made =
+      TabsOfRecordW2B10(browser(), id).front()->GetContents();
+  ASSERT_TRUE(made->WasDiscarded());
+  ASSERT_EQ(1, made->GetController().GetEntryCount());
+
+  SessionRestore::RestoreSessionAfterCrash(browser());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return !SessionRestore::IsRestoring(profile) &&
+           HasPageW2B10(browser(), "/title3.html") &&
+           TabsOfRecordW2B10(browser(), id).size() == 1u;
+  })) << "the session did not come back, or the pin has two tabs";
+
+  const std::vector<tabs::TabInterface*> left =
+      TabsOfRecordW2B10(browser(), id);
+  ASSERT_EQ(1u, left.size());
+  content::NavigationController& controller =
+      left.front()->GetContents()->GetController();
+  EXPECT_EQ(2, controller.GetEntryCount())
+      << "the restored tab was closed and the one made at home kept";
+  content::NavigationEntry* const last =
+      controller.GetEntryAtIndex(controller.GetEntryCount() - 1);
+  ASSERT_TRUE(last);
+  EXPECT_EQ("/title2.html", last->GetURL().path());
+  EXPECT_EQ(1u, Store().records().size());
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/audit_w2_b11_browsertest.cc b/chrome/test/stedding/audit_w2_b11_browsertest.cc
