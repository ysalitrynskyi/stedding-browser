+// page or a file by its address; nothing for a New Tab page or a blank one,
+// which show the field's placeholder.
+std::u16string SidebarAddressText(const GURL& url);
+
+// sidebar Y46: one of Back, Forward and Reload on the sidebar's top row,
+// drawn as the sidebar's own toggle is: the sidebar's text colour, its ink
+// drop and size. A middle click, or a click with the platform's modifier,
+// opens in a new tab, as the address row's buttons do.
+class SidebarNavButton : public TopContainerButton {
+  METADATA_HEADER(SidebarNavButton, TopContainerButton)
+
+ public:
+  SidebarNavButton(BrowserWindowInterface* browser, int command);
+  ~SidebarNavButton() override;
+
+  int command() const { return command_; }
+  // Shows `icon` and runs `command` on a press: Reload and Stop share one.
+  void SetCommand(int command,
+                  const gfx::VectorIcon& icon,
+                  const std::u16string& tooltip,
+                  const std::u16string& name);
+
+ private:
+  // views::View:
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+  void OnThemeChanged() override;
+
+  // Draws the icon again in the colour for the window's activation.
+  void Recolor();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  int command_;
+  raw_ptr<const gfx::VectorIcon> icon_ = nullptr;
+  base::CallbackListSubscription paint_as_active_subscription_;
+};
+
+// sidebar Y46: Back, Forward and Reload, side by side, each enabled while
+// its command is, and Reload turning to Stop while the page loads.
+class SidebarNavButtons : public views::View, public CommandObserver {
+  METADATA_HEADER(SidebarNavButtons, views::View)
+
+ public:
+  explicit SidebarNavButtons(BrowserWindowInterface* browser);
+  ~SidebarNavButtons() override;
+
+  // As the address row's Reload button follows the page.
+  void UpdateReloadStopState(bool is_loading);
+
+  SidebarNavButton* back() { return back_; }
+  SidebarNavButton* forward() { return forward_; }
+  SidebarNavButton* reload() { return reload_; }
+
+  // CommandObserver:
+  void EnabledStateChangedForCommand(int id, bool enabled) override;
+
+ private:
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<SidebarNavButton> back_ = nullptr;
+  raw_ptr<SidebarNavButton> forward_ = nullptr;
+  raw_ptr<SidebarNavButton> reload_ = nullptr;
+};
+
+// sidebar Y46: the page's address under the sidebar's top row. A press opens
+// Cmd-L's bar (commandbar K12), where the address is edited.
+class SidebarAddressField : public views::Button {
+  METADATA_HEADER(SidebarAddressField, views::Button)
+
+ public:
+  static constexpr int kHeight = 34;
+  static constexpr int kRadius = 10;
+
+  explicit SidebarAddressField(BrowserWindowInterface* browser);
+  ~SidebarAddressField() override;
+
+  // Shows the address of `url` (SidebarAddressText), or the placeholder.
+  void SetPage(const GURL& url);
+  std::u16string_view text_for_testing() const;
+
+  // views::Button:
+  void StateChanged(ButtonState old_state) override;
+  void OnThemeChanged() override;
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+
+ private:
+  void UpdateColors();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<views::Label> label_ = nullptr;
+  GURL url_;
+  base::CallbackListSubscription paint_as_active_subscription_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_VERTICAL_SIDEBAR_ADDRESS_H_
