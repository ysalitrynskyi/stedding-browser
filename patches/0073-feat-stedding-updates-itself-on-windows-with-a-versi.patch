@@ -0,0 +1,94 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// updates Up22 (BACKLOG S-72): on Windows chrome/VERSION carries Stedding's
+// own version (156.2.0.19), which the installer, the version folder and the
+// profile compare; what pages and Google's services see keeps Chromium's.
+// On the PC the test binary is built the same way, so the two numbers differ
+// here and each check below tells them apart; where they are the same (the
+// Mac) the checks hold trivially.
+
+#include <string>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/version.h"
+#include "base/version_info/version_info.h"
+#include "chrome/browser/search_engines/ui_thread_search_terms_data.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_version.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/update_client/update_query_params.h"
+#include "components/version_info/version_info_with_user_agent.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "extensions/browser/extensions_browser_client.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+
+namespace {
+
+using ChromiumVersionTest = InProcessBrowserTest;
+
+IN_PROC_BROWSER_TEST_F(ChromiumVersionTest,
+                       PagesAndServicesSeeChromiumsVersion) {
+  const std::string chromium(version_info::GetChromiumVersionNumber());
+  const base::Version chromium_version(chromium);
+  ASSERT_TRUE(chromium_version.IsValid());
+  ASSERT_EQ(4u, chromium_version.components().size());
+  SCOPED_TRACE(base::StrCat({"Chromium ", chromium, ", product ",
+                             version_info::GetVersionNumber()}));
+  // The milestone is the same in both: the reduced user agent and every
+  // milestone check agree whatever the product's numbers.
+  EXPECT_EQ(chromium_version.components()[0],
+            version_info::GetVersion().components()[0]);
+
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  // The full version a page can ask for, and the one in the brand list.
+  EXPECT_EQ(chromium, content::EvalJs(page, R"(
+      navigator.userAgentData.getHighEntropyValues(['uaFullVersion'])
+          .then(values => values.uaFullVersion))"));
+  EXPECT_EQ(chromium, content::EvalJs(page, R"(
+      navigator.userAgentData.getHighEntropyValues(['fullVersionList'])
+          .then(values => values.fullVersionList
+              .find(entry => entry.brand === 'Chromium').version))"));
+  EXPECT_EQ(base::StrCat({"Chrome/", chromium}),
+            version_info::GetProductNameAndVersionForUserAgent())
+      << "the full user agent, when its reduction is off";
+
+  // The Web Store and the extension updater.
+  EXPECT_EQ(chromium, update_client::UpdateQueryParams::GetProdVersion());
+  // What a Google image search is sent.
+  EXPECT_NE(std::string::npos,
+            UIThreadSearchTermsData().GoogleImageSearchSource().find(
+                base::StrCat({" ", chromium, " "})))
+      << UIThreadSearchTermsData().GoogleImageSearchSource();
+  // An extension that asks for the next Chromium build is refused, whatever
+  // the product's numbers say.
+  const std::string next = base::StrCat(
+      {base::NumberToString(chromium_version.components()[0]), ".",
+       base::NumberToString(chromium_version.components()[1]), ".",
+       base::NumberToString(chromium_version.components()[2]), ".",
+       base::NumberToString(chromium_version.components()[3] + 1)});
+  EXPECT_FALSE(extensions::ExtensionsBrowserClient::Get()
+                   ->IsMinBrowserVersionSupported(next))
+      << next;
+  EXPECT_TRUE(extensions::ExtensionsBrowserClient::Get()
+                  ->IsMinBrowserVersionSupported(chromium));
+
+  // About names Chromium's own number.
+  EXPECT_NE(std::u16string::npos,
+            stedding::AboutVersionString(u"")
+                .find(base::StrCat({u"Chromium ", base::UTF8ToUTF16(chromium)})))
+      << stedding::AboutVersionString(u"");
+}
+
+}  // namespace
