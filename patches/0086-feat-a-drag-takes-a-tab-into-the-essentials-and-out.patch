+    })) << "it did not become a pin of the Space";
+    EXPECT_EQ(Index(essential) + 1, Index(pin)) << "not before the pin";
+    EXPECT_TRUE(IsAboveTheLine(essential));
+    EXPECT_TRUE(IsAboveTheLine(pin));
