+++ b/chrome/browser/ui/stedding/drm_notice.h
@@ -0,0 +1,106 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_DRM_NOTICE_H_
+#define CHROME_BROWSER_UI_STEDDING_DRM_NOTICE_H_
+
+#include <string_view>
+
+#include "base/containers/flat_set.h"
+#include "base/functional/callback.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+class GURL;
+class PrefService;
+
+namespace content {
+class NavigationHandle;
+class WebContents;
+}  // namespace content
+
+namespace stedding {
+
+// docs/features/drm-notice.md: nothing protected by Widevine plays yet
+// (BACKLOG S-270), so a tab that opens a site known to need it shows a bar
+// that says so and offers the page in another browser. The page is not
+// blocked.
+
+// drm-notice Dn2: the listed site `url` is on, as the table writes it
+// ("netflix.com" for https://www.netflix.com/title/1), or empty. The view is
+// of the table, which lives as long as the process.
+std::string_view DrmSiteOf(const GURL& url);
+
+// drm-notice Dn6: whether `site`, as DrmSiteOf gives it, is on the list "Don't
+// show again" writes.
+bool IsDrmSiteDismissed(const PrefService& prefs, std::string_view site);
+
+// drm-notice Dn6: adds `site` unless it is listed.
+void DismissDrmSite(PrefService& prefs, std::string_view site);
+
+// drm-notice Dn1, Dn7: a tab's bar. It watches what the tab commits, shows the
+// bar once per listed site, and takes the bar down when the tab leaves that
+// site.
+class DrmNoticeTabHelper
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<DrmNoticeTabHelper> {
+ public:
+  DrmNoticeTabHelper(const DrmNoticeTabHelper&) = delete;
+  DrmNoticeTabHelper& operator=(const DrmNoticeTabHelper&) = delete;
+  ~DrmNoticeTabHelper() override;
+
+  // A tab put to sleep gets a new `to`, and it stays the same tab: `to`'s
+  // helper keeps what `from`'s has shown (Dn7).
+  static void CreateForReplacement(content::WebContents* from,
+                                   content::WebContents* to);
+
+  // Dn6: the bar's link. Its press closes this tab's bar.
+  void OnDontShowAgain();
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+
+ private:
+  friend class content::WebContentsUserData<DrmNoticeTabHelper>;
+
+  explicit DrmNoticeTabHelper(content::WebContents* page);
+
+  // The tab now shows `url`. `can_show` is false for an error page (Dn1).
+  void OnPageChanged(const GURL& url, bool can_show);
+  // Dn6: another tab's "Don't show again" takes this tab's bar down too.
+  void OnDismissedSitesChanged();
+  void RemoveBar();
+  bool IsDismissed(std::string_view site) const;
+
+  // The profile's: a private window's is its own (Dn10).
+  PrefService& prefs() const;
+
+  // The sites this tab has shown its bar for. Views of the table.
+  base::flat_set<std::string_view> shown_;
+  // The site of the bar this tab may be showing, or empty.
+  std::string_view bar_site_;
+  PrefChangeRegistrar registrar_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+// What the button hands an address to.
+using DrmNoticeOpener = base::RepeatingCallback<void(const GURL&)>;
+
+// Tests: stands in for the other browser while it lives. A null `opener`
+// says the browser cannot be found (Dn4).
+class ScopedDrmNoticeOpenerForTesting {
+ public:
+  explicit ScopedDrmNoticeOpenerForTesting(DrmNoticeOpener opener);
+  ScopedDrmNoticeOpenerForTesting(const ScopedDrmNoticeOpenerForTesting&) =
+      delete;
+  ScopedDrmNoticeOpenerForTesting& operator=(
+      const ScopedDrmNoticeOpenerForTesting&) = delete;
+  ~ScopedDrmNoticeOpenerForTesting();
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_DRM_NOTICE_H_
