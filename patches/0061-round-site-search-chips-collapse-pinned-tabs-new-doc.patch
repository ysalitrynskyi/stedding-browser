+// pins H17: Collapse Pinned Tabs is per Space. A change tells the observers
+// once, the state the Space has already is no change, and the state comes
+// back from the session with the Space. A session written before the state
+// existed reads as expanded.
+TEST(SpaceModelTest, ACollapsedPinnedRunIsPerSpaceAndSurvivesARestart) {
+  class PinsObserver : public SpaceModel::Observer {
+   public:
+    void OnSpacePinsCollapsedChanged(const SpaceId& id) override {
+      changed.push_back(id);
+    }
+    void OnSpaceModelDestroying() override {}
+    std::vector<SpaceId> changed;
+  };
+
+  SpaceModel written;
+  const SpaceId home = written.active_id();
+  const SpaceId work = written.AddSpace("Work", kBlue)->id();
+  EXPECT_FALSE(written.ArePinsCollapsed(work));
+  PinsObserver observer;
+  written.AddObserver(&observer);
+  written.SetPinsCollapsed(work, true);
+  written.SetPinsCollapsed(work, true);
+  written.RemoveObserver(&observer);
+  EXPECT_TRUE(written.ArePinsCollapsed(work));
+  EXPECT_FALSE(written.ArePinsCollapsed(home)) << "one Space, not all";
+  ASSERT_EQ(1u, observer.changed.size()) << "the same state again changes "
+                                            "nothing";
+  EXPECT_EQ(work, observer.changed[0]);
+  EXPECT_FALSE(written.ArePinsCollapsed(SpaceId::GenerateNew()));
+
+  SpaceModel read;
+  read.RestoreFrom(written.Serialize());
+  ASSERT_EQ(2u, read.size());
+  EXPECT_TRUE(read.ArePinsCollapsed(work));
+  EXPECT_FALSE(read.ArePinsCollapsed(home));
+
+  const std::string old_id = SpaceId::GenerateNew().ToString();
+  SpaceModel old;
+  old.RestoreFrom(R"({"spaces":[{"id":")" + old_id +
+                  R"(","name":"Work","icon":"","color":0}]})");
+  ASSERT_EQ(1u, old.size());
+  EXPECT_FALSE(old.ArePinsCollapsed(old.active_id()));
+}
+
+// pins H17, spaces B33: a collapsed run hides the pins of its own Space and
+// nothing else -- not a loose tab, not an essential -- and another Space's
+// collapse leaves this Space's pins alone. A model with no window has no tab
+// on screen, so no pin is kept for being selected (the window test covers
+// that).
+TEST(SpaceModelTest, ACollapsedPinnedRunHidesOnlyThatSpacesPins) {
+  SpaceModel model;
+  const SpaceId home = model.active_id();
+  tabs::MockTabInterface pin;
+  tabs::MockTabInterface loose;
+  tabs::MockTabInterface essential;
+  ON_CALL(essential, IsPinned()).WillByDefault(testing::Return(true));
+  ASSERT_EQ(home, model.SpaceForTab(&pin));
+  ASSERT_EQ(home, model.SpaceForTab(&loose));
+  model.SetSpacePinned(&pin, true);
+  ASSERT_TRUE(model.IsSpacePinned(&pin));
+  const SpaceId work = model.AddSpace("Work", kBlue)->id();
+  EXPECT_TRUE(model.HasSpacePins(home));
+  EXPECT_FALSE(model.HasSpacePins(work));
+
+  EXPECT_FALSE(model.HidesTab(&pin)) << "expanded, the pin shows";
+  model.SetPinsCollapsed(home, true);
+  EXPECT_TRUE(model.HidesTab(&pin));
+  EXPECT_TRUE(model.IsTabInActiveSpace(&pin)) << "it stays in its Space";
+  EXPECT_FALSE(model.HidesTab(&loose));
+  EXPECT_FALSE(model.HidesTab(&essential));
+
+  model.SetPinsCollapsed(home, false);
+  EXPECT_FALSE(model.HidesTab(&pin)) << "expanded again, it shows";
+  model.SetPinsCollapsed(work, true);
+  EXPECT_FALSE(model.HidesTab(&pin)) << "Work's collapse is Work's";
+  model.SetActiveSpace(work);
+  EXPECT_TRUE(model.HidesTab(&pin)) << "another Space's tab, as before";
+  EXPECT_FALSE(model.HidesTab(&essential));
+}
+
