+    return *model;
+  }
+};
+
+// B18, B23: Space N is enabled only while the window has N Spaces, and the
+// state follows additions and removals.
+TEST_F(SpaceCommandTest, SpaceNIsDisabledPastTheCount) {
+  std::map<int, bool> enabled;
+  SpaceCommandState state(
+      browser(), base::BindRepeating(
+                     [](std::map<int, bool>* enabled, int id, bool on) {
+                       (*enabled)[id] = on;
+                     },
+                     &enabled));
+  EXPECT_TRUE(enabled[IDC_STEDDING_SPACE_1]);
+  EXPECT_FALSE(enabled[IDC_STEDDING_SPACE_2]);
+  EXPECT_FALSE(enabled[IDC_STEDDING_SPACE_9]);
+  EXPECT_TRUE(enabled[IDC_STEDDING_SPACE_NEXT]);
+  EXPECT_TRUE(enabled[IDC_STEDDING_CLEAR_SPACE]);
+
+  model().AddSpace("Two", SK_ColorBLUE);
+  const SpaceId third = model().AddSpace("Three", SK_ColorRED)->id();
+  EXPECT_TRUE(enabled[IDC_STEDDING_SPACE_3]);
+  EXPECT_FALSE(enabled[IDC_STEDDING_SPACE_4]);
+  EXPECT_FALSE(enabled[IDC_STEDDING_SPACE_9]);
+
+  model().RemoveSpace(third);
+  EXPECT_FALSE(enabled[IDC_STEDDING_SPACE_3]);
+
+  // The command controller wires the same state to the real command ids.
+  const CommandUpdater* const updater =
+      chrome::BrowserCommandController::From(browser());
+  EXPECT_TRUE(updater->IsCommandEnabled(IDC_STEDDING_SPACE_2));
+  EXPECT_FALSE(updater->IsCommandEnabled(IDC_STEDDING_SPACE_9));
+  EXPECT_TRUE(updater->IsCommandEnabled(IDC_STEDDING_SPACE_NEXT));
+}
+
+// B29: no Space commands in a popup (no Spaces there, B14) or in a private
+// window.
+TEST_F(SpaceCommandTest, SpaceCommandsAreDisabledInPopupAndPrivateWindows) {
+  EXPECT_TRUE(SupportsSpaceCommands(browser()));
+
+  BrowserWindowCreateParams popup_params(Browser::TYPE_POPUP, profile(), true);
+  std::unique_ptr<Browser> popup =
+      CreateBrowserWithTestWindowForParams(std::move(popup_params));
+  EXPECT_FALSE(SupportsSpaceCommands(popup.get()));
+  EXPECT_FALSE(chrome::BrowserCommandController::From(popup.get())
+                   ->IsCommandEnabled(IDC_STEDDING_SPACE_1));
+  EXPECT_FALSE(chrome::BrowserCommandController::From(popup.get())
+                   ->IsCommandEnabled(IDC_STEDDING_CLEAR_SPACE));
+
+  BrowserWindowCreateParams private_params(
+      profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true), true);
+  std::unique_ptr<Browser> private_window =
+      CreateBrowserWithTestWindowForParams(std::move(private_params));
+  EXPECT_FALSE(SupportsSpaceCommands(private_window.get()));
+  EXPECT_FALSE(chrome::BrowserCommandController::From(private_window.get())
+                   ->IsCommandEnabled(IDC_STEDDING_SPACE_1));
+  // The commands are no-ops there, not crashes.
+  ActivateSpaceAt(private_window.get(), 0);
+  SwitchSpace(popup.get(), true);
+  ClearActiveSpace(popup.get());
+  ToggleSpacePinOnActiveTab(private_window.get());
+}
