+// web apps Wa13: turning a Space's own session off says which apps will use
+// the shared session while it is off, in one sentence, and asks even when no
+// page of the Space is open; turning it on again gives them the jar back.
+IN_PROC_BROWSER_TEST_F(AppJarTest, TurningTheSessionOffNamesTheApps) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId first = MakeAppIn(work_);
+  const webapps::AppId second = MakeAppAt(
+      work_, embedded_https_test_server().GetURL("b.test", "/title1.html"));
+  ASSERT_FALSE(first.empty());
+  ASSERT_FALSE(second.empty());
+  const std::string work_jar = WorkJar();
+  std::vector<std::u16string> names;
+  for (const std::string& app_id :
+       stedding::AppsRecordingJar(*profile()->GetPrefs(), work_jar)) {
+    names.push_back(base::UTF8ToUTF16(
+        provider().registrar_unsafe().GetAppShortName(app_id)));
+  }
+  ASSERT_EQ(2u, names.size());
+
+  // Work's pages close, so only its apps hold its session.
+  for (int i = tabs()->count() - 1; i >= 0; --i) {
+    if (model_->FindSpaceForTab(tabs()->GetTabAtIndex(i)) == work_) {
+      tabs()->CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+    }
+  }
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return model_->CountPagesAJarChangeReloads(work_) == 0; }));
+
+  const std::u16string text = QuestionDuring(
+      base::BindLambdaForTesting([&]() {
+        spaces::SetSpaceIsolatedAfterAsking(browser(), work_, false);
+      }),
+      /*accept=*/true);
+  EXPECT_NE(std::u16string::npos,
+            text.find(names[0] + u" and " + names[1] +
+                      u" will use the shared session while it is off."))
+      << text;
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return !model_->SpaceIsIsolated(work_); }));
+  EXPECT_EQ("", stedding::AppJarInUse(*profile()->GetPrefs(), first));
+  EXPECT_EQ("", stedding::AppJarInUse(*profile()->GetPrefs(), second));
+
+  model_->SetSpaceIsolated(work_, true);
+  EXPECT_EQ(work_jar, stedding::AppJarInUse(*profile()->GetPrefs(), first));
+}
+
+// web apps Wa14: "Open in Stedding" puts the app's page in a tab of the Space
+// that keeps its jar, as it is, and shows that Space; a page in the shared
+// jar goes to the first Space that shares it when the one on screen does
+// not.
+IN_PROC_BROWSER_TEST_F(AppJarTest, OpenInSteddingLandsInTheSpaceOfTheJar) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId work_app = MakeAppIn(work_);
+  ASSERT_FALSE(work_app.empty());
+  content::WebContents* const page = Launch(work_app, "/title2.html");
+  ASSERT_TRUE(page);
+  const int entry_id =
+      page->GetController().GetLastCommittedEntry()->GetUniqueID();
+  ASSERT_TRUE(app_window_);
+  ASSERT_EQ(home_, model_->active_id());
+
+  EXPECT_EQ(browser(), chrome::OpenInChrome(app_window_));
+  app_window_ = nullptr;
+  tabs::TabInterface* const tab = tabs::TabInterface::GetFromContents(page);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return model_->active_id() == work_;
+  })) << "Work comes on screen";
+  EXPECT_EQ(work_, model_->FindSpaceForTab(tab));
+  EXPECT_EQ(WorkJar(), JarOf(page)) << "still signed in as in Work";
+  EXPECT_EQ(entry_id,
+            page->GetController().GetLastCommittedEntry()->GetUniqueID())
+      << "not loaded again";
+
+  // An app on the shared jar, opened in Stedding while Work, which has a
+  // session of its own, is on screen: Home takes the page.
+  const GURL shared_url =
+      embedded_https_test_server().GetURL("b.test", "/title1.html");
+  OpenIn(home_, shared_url);
+  const webapps::AppId shared_app =
+      web_app::InstallWebAppFromPage(browser(), shared_url);
+  ASSERT_FALSE(shared_app.empty());
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  BrowserWindowInterface* const shared_window =
+      web_app::LaunchWebAppToURL(profile(), shared_app, shared_url);
+  ASSERT_TRUE(shared_window);
+  content::WebContents* const shared_app_page =
+      shared_window->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(shared_app_page));
+  EXPECT_EQ(browser(), chrome::OpenInChrome(shared_window));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return model_->active_id() == home_;
+  })) << "Home, the first Space on the profile's jar, comes on screen";
+  EXPECT_EQ(home_, model_->FindSpaceForTab(
+                       tabs::TabInterface::GetFromContents(shared_app_page)));
+  EXPECT_EQ("", JarOf(shared_app_page));
+}
+
+// web apps Wa14: "Open in Stedding" never files a page of a Space's jar in
+// a Blank Window, whose Spaces keep no session of their own: with only a
+// Blank Window open, the page goes to a new window that follows the
+// profile's Space list, into the Space that keeps its jar, as it is.
+IN_PROC_BROWSER_TEST_F(AppJarTest, OpenInSteddingPassesABlankWindow) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  const std::string work_jar = WorkJar();
+  content::WebContents* const page = Launch(app_id, "/title2.html");
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(app_window_);
+  const int entry_id =
+      page->GetController().GetLastCommittedEntry()->GetUniqueID();
+
+  ui_test_utils::BrowserCreatedObserver blank_created;
+  spaces::OpenBlankWindow(profile());
+  BrowserWindowInterface* const blank = blank_created.Wait();
+  ASSERT_TRUE(blank);
+  ASSERT_FALSE(spaces::SpaceModel::From(blank)->follows_registry());
+  // The window that follows the Space list goes, so a Blank Window is the
+  // one tabbed window left.
+  model_ = nullptr;
+  CloseBrowserSynchronously(browser());
+
+  BrowserWindowInterface* const target = chrome::OpenInChrome(app_window_);
+  app_window_ = nullptr;
+  ASSERT_TRUE(target);
+  EXPECT_NE(blank, target);
+  const spaces::SpaceModel* const target_model =
+      spaces::SpaceModel::From(target);
+  ASSERT_TRUE(target_model);
+  EXPECT_TRUE(target_model->follows_registry());
+  tabs::TabInterface* const tab = tabs::TabInterface::GetFromContents(page);
+  ASSERT_EQ(target, tab->GetBrowserWindowInterface());
+  EXPECT_EQ(work_, target_model->FindSpaceForTab(tab));
+  EXPECT_EQ(work_jar, JarOf(page)) << "still signed in as in Work";
+  EXPECT_EQ(entry_id,
+            page->GetController().GetLastCommittedEntry()->GetUniqueID())
+      << "not loaded again";
+}
+
+// web apps Wa6, Wa14: the address row's "Open in <App>" chip (the intent
+// picker's launch, WebAppsIntentPickerDelegate::LaunchApp) moves no tab
+// that stays out of the app: a tab of another jar than the app's, and an
+// essential. The app opens the address in a window of its own, in its own
+// session.
+IN_PROC_BROWSER_TEST_F(AppJarTest, TheIntentPickerLeavesTabsThatStayOut) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId work_app = MakeAppIn(work_);
+  const GURL shared_app_url =
+      embedded_https_test_server().GetURL("b.test", "/title1.html");
+  const webapps::AppId shared_app = MakeAppAt(home_, shared_app_url);
+  ASSERT_FALSE(work_app.empty());
+  ASSERT_FALSE(shared_app.empty());
+  // The delegate the address row's chip runs, with the icon sizes its tab
+  // helper gives it (IntentPickerTabHelper).
+  apps::WebAppsIntentPickerDelegate picker(
+      profile(),
+      /*icon_sizes_in_dep=*/{
+          GetLayoutConstant(LayoutConstant::kLocationBarIconSize),
+          IntentPickerTabHelper::GetIntentPickerBubbleIconSize()});
+
+  // The chip's launch on `page` for `app_id`: the page stays in the window,
+  // and the app's own window shows its address.
+  const auto stays = [&](content::WebContents* page,
+                         const webapps::AppId& app_id) {
+    const int before = tabs()->count();
+    const GURL url = page->GetLastCommittedURL();
+    ui_test_utils::BrowserCreatedObserver created;
+    picker.LaunchApp(page, url, app_id, apps::PickerEntryType::kWeb,
+                     base::DoNothing());
+    BrowserWindowInterface* const app = created.Wait();
+    EXPECT_TRUE(web_app::AppBrowserController::IsForWebApp(app, app_id));
+    EXPECT_EQ(before, tabs()->count());
+    EXPECT_NE(TabStripModel::kNoTab, tabs()->GetIndexOfWebContents(page));
+    content::WebContents* const app_page =
+        app->GetTabStripModel()->GetActiveWebContents();
+    EXPECT_TRUE(app_page && app_page != page);
+    if (app_page) {
+      EXPECT_TRUE(content::WaitForLoadStop(app_page));
+      EXPECT_EQ(url, app_page->GetLastCommittedURL());
+    }
+    return app_page;
+  };
+
+  // A tab of Home, on the shared jar, for the app made in Work.
+  content::WebContents* const home_page = OpenIn(home_, Url("/title2.html"));
+  content::WebContents* const work_app_page = stays(home_page, work_app);
+  ASSERT_TRUE(work_app_page);
+  EXPECT_EQ(WorkJar(), JarOf(work_app_page));
+  EXPECT_EQ("", JarOf(home_page));
+
+  // An essential, on the shared jar as the app made in Home is.
+  content::WebContents* const essential = OpenIn(
+      home_, embedded_https_test_server().GetURL("b.test", "/title2.html"));
+  tabs()->SetTabPinned(tabs()->GetIndexOfWebContents(essential), true);
+  ASSERT_TRUE(stays(essential, shared_app));
+  EXPECT_TRUE(tabs::TabInterface::GetFromContents(essential)->IsPinned());
+}
+
+// web apps Wa14: a link leaving the app's scope opens in a tab of the Space
+// whose jar the app's page lives in.
+IN_PROC_BROWSER_TEST_F(AppJarTest, ALinkLeavingTheAppOpensInItsSpace) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  content::WebContents* const page = Launch(app_id, "/title2.html");
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(app_window_);
+
+  NavigateParams params(
+      app_window_.get(),
+      embedded_https_test_server().GetURL("b.test", "/title3.html"),
+      ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  params.source_contents = page;
+  Navigate(&params);
+  content::WebContents* const opened = params.navigated_or_inserted_contents;
+  ASSERT_TRUE(opened);
+  ASSERT_TRUE(content::WaitForLoadStop(opened));
+  tabs::TabInterface* const tab = tabs::TabInterface::GetFromContents(opened);
+  ASSERT_EQ(browser(), tab->GetBrowserWindowInterface());
+  EXPECT_EQ(work_, model_->FindSpaceForTab(tab));
+  EXPECT_EQ(WorkJar(), JarOf(opened));
+}
+
+// web apps Wa14: "Open in <App>" on a tab whose jar is not the app's leaves
+// the tab where it is; the app opens the address in its own window and
+// session.
+IN_PROC_BROWSER_TEST_F(AppJarTest,
+                       OpenInAppFromAnotherJarOpensInsteadOfMoving) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  content::WebContents* const home_page = OpenIn(home_, Url("/title2.html"));
+  const int before = tabs()->count();
+  ASSERT_TRUE(chrome::IsCommandEnabled(browser(), IDC_OPEN_IN_PWA_WINDOW));
+
+  ui_test_utils::BrowserCreatedObserver created;
+  chrome::ExecuteCommand(browser(), IDC_OPEN_IN_PWA_WINDOW);
+  BrowserWindowInterface* const app_window = created.Wait();
+  ASSERT_TRUE(web_app::AppBrowserController::IsForWebApp(app_window, app_id));
+  EXPECT_EQ(before, tabs()->count());
+  EXPECT_NE(TabStripModel::kNoTab, tabs()->GetIndexOfWebContents(home_page));
+  content::WebContents* const app_page =
+      app_window->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(app_page);
+  ASSERT_TRUE(content::WaitForLoadStop(app_page));
+  EXPECT_NE(home_page, app_page);
+  EXPECT_EQ(Url("/title2.html"), app_page->GetLastCommittedURL());
+  EXPECT_EQ(WorkJar(), JarOf(app_page));
+  EXPECT_EQ("", JarOf(home_page)) << "the tab keeps its own session";
+}
+
+// web apps Wa15: an app takes no links until the user lets it, and then only
+// links from pages in its own jar.
+IN_PROC_BROWSER_TEST_F(AppJarTest,
+                       CapturingIsOffByDefaultAndOnlyTakesSameJarLinks) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  EXPECT_FALSE(provider().registrar_unsafe().CapturesLinksInScope(app_id));
+
+  // A link into the app's scope, from a page of `space`, opening a new tab:
+  // whether it opened in the app's window.
+  int link = 0;
+  const auto captured_from = [&](const spaces::SpaceId& space) {
+    content::WebContents* const source = OpenIn(space, Url("/title3.html"));
+    NavigateParams params(
+        browser(), Url("/title1.html?link" + base::NumberToString(++link)),
+        ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    params.source_contents = source;
+    Navigate(&params);
+    content::WebContents* const opened = params.navigated_or_inserted_contents;
+    EXPECT_TRUE(opened);
+    if (!opened) {
+      return false;
+    }
+    EXPECT_TRUE(content::WaitForLoadStop(opened));
+    tabs::TabInterface* const tab =
+        tabs::TabInterface::MaybeGetFromContents(opened);
+    return tab && web_app::AppBrowserController::IsForWebApp(
+                      tab->GetBrowserWindowInterface(), app_id);
+  };
+  EXPECT_FALSE(captured_from(work_)) << "off by default";
+
+  base::test::TestFuture<void> set;
+  provider().scheduler().SetAppCapturesSupportedLinksDisableOverlapping(
+      app_id, /*set_to_preferred=*/true, set.GetCallback());
+  ASSERT_TRUE(set.Wait());
+  ASSERT_TRUE(provider().registrar_unsafe().CapturesLinksInScope(app_id));
+  EXPECT_TRUE(captured_from(work_)) << "a link from the app's own jar";
+  EXPECT_FALSE(captured_from(home_)) << "a link from another jar";
+}
+
+// web apps Wa18: removing an app made in a Space with its own session, with
+// "Also clear data", clears the site from that Space's jar -- the dialog says
+// the Space's tabs are signed out too -- and leaves the shared jar's alone.
+IN_PROC_BROWSER_TEST_F(AppJarTest, UninstallClearsTheSiteInTheAppsJar) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  const content::StoragePartitionConfig work_jar =
+      *spaces::StoragePartitionConfigForProfileId(profile(), WorkJar());
+  const content::StoragePartitionConfig shared_jar =
+      content::StoragePartitionConfig::CreateDefault(profile());
+  ASSERT_EQ(std::vector<std::string>{"jar=work"}, CookiesIn(work_jar));
+  ASSERT_EQ(std::vector<std::string>{"jar=shared"}, CookiesIn(shared_jar));
+  EXPECT_EQ(u"This also signs the tabs of “Work” out of the site.",
+            spaces::AppClearDataSpaceNote(profile(), app_id));
+  // As the dialog's checkbox reads it: two sentences (the PC's live check of
+  // 2026-10-20 read "...from Stedding This also signs...").
+  EXPECT_EQ(
+      u"Remove this app's data from Stedding. This also signs the tabs of "
+      u"“Work” out of the site.",
+      spaces::WithClearDataSpaceNote(
+          l10n_util::GetStringUTF16(IDS_APP_ALSO_DELETE_APPS_DATA),
+          spaces::AppClearDataSpaceNote(profile(), app_id)));
+
+  extensions::ScopedTestDialogAutoConfirm accept_and_clear(
+      extensions::ScopedTestDialogAutoConfirm::ACCEPT_AND_OPTION);
+  base::test::TestFuture<webapps::UninstallResultCode> removed;
+  provider().ui_manager().PresentUserUninstallDialog(
+      app_id, webapps::WebappUninstallSource::kAppMenu,
+      browser()->GetWindow()->GetNativeWindow(), removed.GetCallback());
+  ASSERT_TRUE(webapps::UninstallSucceeded(removed.Get()));
+
+  EXPECT_TRUE(CookiesIn(work_jar).empty()) << "the app's site, from Work";
+  EXPECT_EQ(std::vector<std::string>{"jar=shared"}, CookiesIn(shared_jar));
+  EXPECT_EQ("", stedding::RecordedAppJar(*profile()->GetPrefs(), app_id))
+      << "the record goes with the app";
+}
+
+}  // namespace
