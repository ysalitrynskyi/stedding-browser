+
+std::optional<SpaceId> SpaceModel::RouteTargetFor(const GURL& url,
+                                                  bool external) {
+  if (!tab_strip_model_ || !url.is_valid()) {
+    return std::nullopt;
+  }
+  const PrefService* const prefs = pref_registrar_.prefs();
+  if (!prefs) {
+    return std::nullopt;
+  }
+  const auto known = [&](const std::string& token) -> std::optional<SpaceId> {
+    const std::optional<SpaceId> id =
+        SpaceId::FromOptionalToken(base::Token::FromString(token));
+    return id && GetSpace(*id) ? id : std::nullopt;
+  };
+  if (const std::optional<std::string> routed =
+          RouteFor(ReadRoutes(prefs), url)) {
+    if (const std::optional<SpaceId> id = known(*routed)) {
+      return id;
+    }
+  }
+  if (external) {
+    return known(prefs->GetString(stedding::prefs::kExternalDefaultSpace));
+  }
+  return std::nullopt;
+}
+
+std::optional<SpaceId> SpaceModel::RouteTab(tabs::TabInterface* tab,
+                                            const GURL& url,
+                                            bool foreground,
+                                            bool external) {
+  if (!tab || routing_paused_ || tab->IsPinned()) {
+    return std::nullopt;
+  }
+  const std::optional<SpaceId> target = RouteTargetFor(url, external);
+  if (!target) {
+    return std::nullopt;
+  }
+  const SpaceId from = SpaceForTab(tab);
+  if (from == *target) {
+    return std::nullopt;
+  }
+  SetSpaceForTab(tab, *target);
+  last_route_.emplace(tab->GetHandle(), from, *target);
+  // The switch and the toast wait a turn: this may run inside a strip
+  // notification, which must not re-enter the strip (B4).
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&SpaceModel::FinishRoute, weak_factory_.GetWeakPtr(),
+                     tab->GetHandle(), from, *target, foreground));
+  return target;
+}
+
+void SpaceModel::FinishRoute(tabs::TabHandle handle,
+                             SpaceId from,
+                             SpaceId to,
+                             bool foreground) {
+  tabs::TabInterface* const tab = handle.Get();
+  if (!tab || !GetSpace(to)) {
+    return;
+  }
+  if (foreground) {
+    SetActiveSpace(to);
+  }
+  observers_.Notify(&Observer::OnTabRouted, tab, from, to);
+}
+
+void SpaceModel::MaybeRouteInsertedTab(
+    tabs::TabInterface* tab,
+    const TabStripSelectionChange& selection) {
+  content::WebContents* const contents = tab->GetContents();
+  // A tab rebuilt from a session keeps the Space it was in (B2).
+  if (!contents || TabSpaceRestoreData::FromWebContents(contents)) {
+    return;
+  }
+  const GURL url = contents->GetVisibleURL();
+  if (!url.is_valid() || url.is_empty()) {
+    return;
+  }
+  const bool external = TakeExternalOpen(url);
+  const bool foreground =
+      selection.active_tab_changed() && selection.new_contents == contents;
+  RouteTab(tab, url, foreground, external);
+}
+
+void SpaceModel::RouteFreshTab(tabs::TabInterface* tab, const GURL& url) {
+  RouteTab(tab, url, /*foreground=*/true, TakeExternalOpen(url));
+}
+
+bool SpaceModel::UndoLastRoute() {
+  if (!last_route_) {
+    return false;
+  }
+  const LastRoute route = *last_route_;
+  last_route_.reset();
+  tabs::TabInterface* const tab = route.tab.Get();
+  if (!tab || !GetSpace(route.from) || SpaceForTab(tab) != route.to) {
+    return false;
+  }
+  SetSpaceForTab(tab, route.from);
+  SetActiveSpace(route.from);
+  if (tab_strip_model_) {
+    const int index = tab_strip_model_->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      tab_strip_model_->ActivateTabAt(index);
+    }
+  }
+  return true;
+}
