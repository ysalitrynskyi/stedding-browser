+// tabs R65 (BACKLOG S-398): a pinned tab's row tidies its title, and a pin or
+// an unpin in the Space changes no tab data the row watches: the row is told
+// here, once the model has the pin.
+class VerticalTabStripRegionView::TidyTitlePins
+    : public spaces::SpaceModel::Observer {
+ public:
+  TidyTitlePins(spaces::SpaceModel& model, VerticalTabStripRegionView& region)
+      : region_(region) {
+    observation_.Observe(&model);
+  }
+  TidyTitlePins(const TidyTitlePins&) = delete;
+  TidyTitlePins& operator=(const TidyTitlePins&) = delete;
+  ~TidyTitlePins() override = default;
+
+  // spaces::SpaceModel::Observer:
+  void OnTabSpacePinChanged(tabs::TabInterface* tab, bool pinned) override {
+    std::vector<TabCollectionNode*> pending;
+    if (region_->root_node()) {
+      pending.push_back(region_->root_node());
+    }
+    while (!pending.empty()) {
+      TabCollectionNode* const node = pending.back();
+      pending.pop_back();
+      if (auto* const row = views::AsViewClass<TabView>(node->view());
+          row && row->GetTabInterface() == tab) {
+        row->UpdateTidyTitle();
+      }
+      for (const auto& child : node->children()) {
+        pending.push_back(child.get());
+      }
+    }
+  }
+  void OnSpaceModelDestroying() override { observation_.Reset(); }
+
+ private:
+  const raw_ref<VerticalTabStripRegionView> region_;
+  base::ScopedObservation<spaces::SpaceModel, spaces::SpaceModel::Observer>
+      observation_{this};
+};
