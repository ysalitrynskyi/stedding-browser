+// The view at or under `root` that carries `id`, or null.
+views::View* FindByElementId(views::View* root, ui::ElementIdentifier id) {
+  if (root->GetProperty(views::kElementIdentifierKey) == id) {
+    return root;
+  }
+  for (views::View* const child : root->children()) {
+    if (views::View* const found = FindByElementId(child, id)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
