+bool SpaceModel::IsInAnotherSpacesFolder(tabs::TabInterface* tab) const {
+  if (!tab || tab->IsPinned()) {
+    return false;
+  }
+  const std::optional<SpaceId> space = FindSpaceForTab(tab);
+  const tabs::TabCollection* outermost = nullptr;
+  for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+       each = each->GetParentCollection()) {
+    if (each->type() == tabs::TabCollection::Type::FOLDER) {
+      outermost = each;
+    }
+  }
+  if (!space || !outermost) {
+    return false;
+  }
+  const std::vector<tabs::TabInterface*> own = SplitPeers(tab);
+  for (const tabs::TabInterface* const other : outermost->GetTabsRecursive()) {
+    if (std::ranges::contains(own, other)) {
+      continue;
+    }
+    if (const std::optional<SpaceId> theirs = FindSpaceForTab(other);
+        theirs && *theirs != *space) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SpaceModel::LeaveAnotherSpacesFolder(tabs::TabHandle handle) {
+  tabs::TabInterface* const tab = handle.Get();
+  if (!tab || !tab_strip_model_ || !IsInAnotherSpacesFolder(tab)) {
+    return;
+  }
+  const int index = tab_strip_model_->GetIndexOfTab(tab);
+  if (index != TabStripModel::kNoTab) {
+    tab_strip_model_->MoveTabOutOfFolders(index);
+  }
+}
+
+void SpaceModel::MoveTabsToSpace(const std::vector<tabs::TabInterface*>& tabs,
+                                 const SpaceId& id) {
+  if (!GetSpace(id)) {
+    return;
+  }
+  std::vector<tabs::TabInterface*> moving;
+  for (tabs::TabInterface* const tab : tabs) {
+    if (tab && !tab->IsPinned() && SpaceForTab(tab) != id) {
+      moving.push_back(tab);
+    }
+  }
+  if (tab_strip_model_) {
+    // Each lands just after its outermost folder, so the last goes first and
+    // the ones before it land ahead of it: the moved rows keep their order.
+    std::ranges::sort(moving, [&](tabs::TabInterface* a, tabs::TabInterface* b) {
+      return tab_strip_model_->GetIndexOfTab(a) >
+             tab_strip_model_->GetIndexOfTab(b);
+    });
+    for (tabs::TabInterface* const tab : moving) {
+      const int index = tab_strip_model_->GetIndexOfTab(tab);
+      if (index != TabStripModel::kNoTab) {
+        tab_strip_model_->MoveTabOutOfFolders(index);
+      }
+    }
+  }
+  for (tabs::TabInterface* const tab : moving) {
+    SetSpaceForTab(tab, id);
+  }
+}
