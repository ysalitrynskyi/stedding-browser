+    SCOPED_TRACE("out of the split, a page with no colour has no supplier");
+    browser()->tab_strip_model()->RemoveSplit(
+        *browser()->tab_strip_model()->GetActiveTab()->GetSplit());
+    controller->SetColorForTesting(std::nullopt);
+    controller->SetPartnerColorForTesting(std::nullopt);
+    EXPECT_FALSE(controller->bar_supplier());
