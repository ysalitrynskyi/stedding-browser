+void FolderView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  menu_model_->AddItem(kFolderRename, u"Rename Folder\u2026");
+  menu_model_->AddItem(kFolderToggle, folder()->collapsed()
+                                          ? u"Expand Folder"
+                                          : u"Collapse Folder");
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItem(kFolderMoveOut, u"Move Tabs Out of Folder");
+  menu_model_->AddItem(kFolderCloseTabs, u"Close Folder\u2019s Tabs");
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void FolderView::ExecuteCommand(int command_id, int event_flags) {
+  TabStripCollectionController* const controller =
+      collection_node_->GetController();
+  switch (command_id) {
+    case kFolderRename:
+      BeginRename();
+      break;
+    case kFolderToggle:
+      ToggleCollapsed();
+      break;
+    case kFolderMoveOut:
+      if (controller) {
+        controller->MoveTabsOutOfFolder(folder());
+      }
+      break;
+    case kFolderCloseTabs:
+      if (controller) {
+        controller->CloseFolderTabs(folder());
+      }
+      break;
+    default:
+      break;
+  }
+}
