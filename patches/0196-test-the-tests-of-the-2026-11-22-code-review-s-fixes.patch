+// found in the LICENSE file.
+
+// The sidebar's tab menu, run as a click on its row runs it, after the tab
+// it was opened on has moved to another window while the menu was open.
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_menu_model.h"
+#include "chrome/browser/ui/tabs/tab_menu_model_delegate.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/tabs/tab/tab_context_menu_controller.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/test/browser_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+class TabMenuMovedTabW2B22Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {};
+
+// P30-1e; tabs R21, pins H3. The menu's Close on a tab that left the window
+// while the menu was open -- an extension moved it to another window -- does
+// nothing: the tab stays open in the window it went to, and this window keeps
+// its other tab. The sidebar asked the strip for the tabs of a tab it no
+// longer holds, and the browser stopped.
+IN_PROC_BROWSER_TEST_F(TabMenuMovedTabW2B22Test,
+                       CloseOnATabMovedAwayWhileTheMenuWasOpenDoesNothing) {
+  TabStripModel* const strip = tab_strip_model();
+  tabs::TabInterface* const moved = strip->GetActiveTab();
+  AppendTab();
+  tabs::TabInterface* const stays = strip->GetActiveTab();
+  ASSERT_EQ(2, strip->count());
+  ASSERT_NE(moved, stays);
+  ASSERT_TRUE(vertical_tab_strip_controller());
+
+  BrowserWindowInterface* const other = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(other);
+  TabStripModel* const other_strip = other->GetTabStripModel();
+  const int other_count = other_strip->count();
+
+  // The menu a right click on the moved tab's row opens.
+  TabContextMenuController controller(moved->GetHandle(),
+                                      vertical_tab_strip_controller());
+  TabMenuModel menu(&controller, TabMenuModelDelegate::From(browser()), strip,
+                    strip->GetIndexOfTab(moved));
+  const std::optional<size_t> close =
+      menu.GetIndexOfCommandId(TabStripModel::CommandCloseTab);
+  ASSERT_TRUE(close.has_value()) << "the menu has no Close";
+
+  // While it is open the tab goes to the other window, the way an extension
+  // moves a tab there.
+  std::unique_ptr<tabs::TabModel> detached =
+      strip->DetachTabAtForInsertion(strip->GetIndexOfTab(moved));
+  ASSERT_TRUE(detached);
+  other_strip->InsertDetachedTabAt(0, std::move(detached),
+                                   AddTabTypes::ADD_ACTIVE);
+  ASSERT_EQ(TabStripModel::kNoTab, strip->GetIndexOfTab(moved));
+  ASSERT_NE(TabStripModel::kNoTab, other_strip->GetIndexOfTab(moved));
+
+  menu.ActivatedAt(*close);
+
+  EXPECT_EQ(1, strip->count());
+  EXPECT_EQ(stays, strip->GetActiveTab());
+  EXPECT_EQ(other_count + 1, other_strip->count());
+  EXPECT_NE(TabStripModel::kNoTab, other_strip->GetIndexOfTab(moved))
+      << "the menu closed the tab in the other window";
+}
+
+}  // namespace
