+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/privacy_defaults.h"
+
+#include <vector>
+
+#include "base/base_switches.h"
+#include "base/command_line.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_service.h"
+
+namespace stedding {
+
+std::string EnableFeaturesWithGlobalPrivacyControl(std::string_view existing,
+                                                   bool on) {
+  std::vector<std::string> features = base::SplitString(
+      existing, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  std::erase_if(features, [](const std::string& feature) {
+    return feature == kGlobalPrivacyControlFeature ||
+           base::StartsWith(feature,
+                            std::string(kGlobalPrivacyControlFeature) + ":");
+  });
+  if (on) {
+    features.push_back(kGlobalPrivacyControlFeature);
+  }
+  return base::JoinString(features, ",");
+}
+
+void ApplyGlobalPrivacyControl(const PrefService* local_state,
+                               base::CommandLine* command_line) {
+  if (!local_state || !command_line) {
+    return;
+  }
+  const bool on = local_state->GetBoolean(prefs::kGlobalPrivacyControl);
+  const std::string merged = EnableFeaturesWithGlobalPrivacyControl(
+      command_line->GetSwitchValueASCII(switches::kEnableFeatures), on);
+  command_line->RemoveSwitch(switches::kEnableFeatures);
+  if (!merged.empty()) {
+    command_line->AppendSwitchASCII(switches::kEnableFeatures, merged);
+  }
+}
+
+}  // namespace stedding
