+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Which cookie jar a page's first request carries (PLAN.md SPC-12, CMD-8,
+// SPC-9). A Space with an independent session keeps its own jar; a tab is
+// made in its Space's jar before it exists, so the first request of a routed
+// open, a link and a popup from such a Space, and an address typed into a
+// fresh tab already carries the right cookies. A page holding changes the
+// user has not saved keeps its jar until it is left.
+//
+// Each host has a cookie "jar=shared" in the profile's own jar and
+// "jar=work" in the Work Space's; the server records the Cookie header of
+// each request.
+
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/run_loop.h"
+#include "base/synchronization/lock.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "base/thread_annotations.h"
+#include "chrome/browser/extensions/chrome_test_extension_loader.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_router.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/stedding/sleep_tabs.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/browsing_data_remover.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/page_type.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/browsing_data_remover_test_util.h"
+#include "content/public/test/test_navigation_observer.h"
+#include "extensions/common/extension.h"
+#include "extensions/test/test_extension_dir.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+class SpaceJarTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestMonitor(base::BindRepeating(
+        &SpaceJarTest::OnRequest, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+
+    model_ = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model_);
+    home_ = model_->active_id();
+    work_ = model_->AddSpace("Work", SK_ColorBLUE)->id();
+    model_->SetSpaceIsolated(work_, true);
+    ASSERT_TRUE(model_->SpaceIsIsolated(work_));
+
+    // The profile's jar: set from a tab in Home.
+    for (const char* host : {"routed.test", "b.test"}) {
+      ASSERT_TRUE(ui_test_utils::NavigateToURL(
+          browser(), Url(host, "/set-cookie?jar=shared")));
+    }
+    // Work's jar: set from a tab made in Work.
+    ASSERT_TRUE(model_->SetActiveSpace(work_));
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("a.test", "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    work_tab_ = tabs()->GetActiveTab()->GetHandle();
+    ASSERT_EQ(work_, model_->FindSpaceForTab(work_tab_.Get()));
+    for (const char* host : {"routed.test", "b.test"}) {
+      ASSERT_TRUE(ui_test_utils::NavigateToURL(
+          browser(), Url(host, "/set-cookie?jar=work")));
+    }
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                             Url("a.test", "/title1.html")));
+    ASSERT_TRUE(model_->SetActiveSpace(home_));
+    home_tab_ = tabs()->GetActiveTab()->GetHandle();
+    ASSERT_EQ(home_, model_->FindSpaceForTab(home_tab_.Get()));
+  }
+
+  GURL Url(const std::string& host, const std::string& path) {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  void RouteToWork(const std::string& host) {
+    spaces::Route route;
+    route.match = spaces::Route::Match::kHost;
+    route.pattern = host;
+    route.space = work_.ToString();
+    spaces::AddRoute(browser()->GetProfile()->GetPrefs(), route);
+  }
+
+  // The server's thread.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    const std::string path = request.GetURL().PathForRequest();
+    base::AutoLock lock(lock_);
+    if (cookies_.contains(path)) {
+      return;
+    }
+    const auto cookie = request.headers.find("Cookie");
+    cookies_[path] = cookie == request.headers.end() ? "" : cookie->second;
+  }
+
+  // The Cookie header of the first request for `path` (with its query), once
+  // it arrived.
+  std::string FirstCookieFor(const std::string& path) {
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      base::AutoLock lock(lock_);
+      return cookies_.contains(path);
+    })) << path;
+    base::AutoLock lock(lock_);
+    return cookies_[path];
+  }
+
+  content::StoragePartitionConfig JarOf(tabs::TabInterface* tab) {
+    return spaces::StoragePartitionConfigForWebContents(tab->GetContents());
+  }
+
+  // A new tab in Work, loaded, on screen.
+  content::WebContents* OpenNewTabInWork() {
+    EXPECT_TRUE(model_->SetActiveSpace(work_));
+    ui_test_utils::TabAddedWaiter added(browser());
+    chrome::NewTab(browser(), NewTabTypes::kNewTabCommand);
+    added.Wait();
+    content::WebContents* const page = tabs()->GetActiveWebContents();
+    EXPECT_TRUE(content::WaitForLoadStop(page));
+    EXPECT_EQ(work_, model_->FindSpaceForTab(tabs()->GetActiveTab()));
+    return page;
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  // Set up in SetUpOnMainThread.
+  spaces::SpaceId home_ = spaces::SpaceId::GenerateNew();
+  spaces::SpaceId work_ = spaces::SpaceId::GenerateNew();
+  tabs::TabHandle home_tab_;
+  tabs::TabHandle work_tab_;
+
+ private:
+  base::Lock lock_;
+  std::map<std::string, std::string> cookies_ GUARDED_BY(lock_);
+};
+
+// A routed Cmd-click from a shared Space: the new tab is made in the jar of
+// the Space the route names.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ARoutedLinkCarriesItsSpacesCookies) {
+  RouteToWork("routed.test");
+  NavigateParams params(browser(), Url("routed.test", "/cmd-click"),
+                        ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  params.source_contents = home_tab_.Get()->GetContents();
+  Navigate(&params);
+  EXPECT_EQ("jar=work", FirstCookieFor("/cmd-click"));
+  tabs::TabInterface* const opened =
+      tabs::TabInterface::GetFromContents(params.navigated_or_inserted_contents);
+  EXPECT_EQ(work_, model_->FindSpaceForTab(opened));
+}
+
+// A target=_blank link in an independent Space opens in that Space's jar.
+// Content makes such a page, which has no opener, in the profile's jar.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ABlankTargetLinkKeepsItsSpacesJar) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  content::WebContents* const page = work_tab_.Get()->GetContents();
+  ASSERT_EQ(work_tab_.Get(), tabs()->GetActiveTab())
+      << "Work comes back to its tab (spaces B2)";
+  ASSERT_TRUE(content::ExecJs(
+      page, content::JsReplace("const a = document.createElement('a');"
+                               "a.href = $1; a.target = '_blank';"
+                               "document.body.appendChild(a); a.click();",
+                               Url("b.test", "/blank"))));
+  EXPECT_EQ("jar=work", FirstCookieFor("/blank"));
+}
+
+// A popup opened without an opener from an independent Space likewise.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ANoopenerPopupKeepsItsSpacesJar) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  content::WebContents* const page = work_tab_.Get()->GetContents();
+  ASSERT_TRUE(content::ExecJs(
+      page, content::JsReplace(
+                "window.open($1, '_blank', 'noopener,popup,width=300');",
+                Url("b.test", "/popup"))));
+  EXPECT_EQ("jar=work", FirstCookieFor("/popup"));
+}
+
+// A routed address typed into a fresh tab: the tab gets new contents in the
+// named Space's jar before the address loads, and the page loads there.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ATypedRoutedAddressLoadsInItsSpacesJar) {
+  RouteToWork("routed.test");
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://newtab"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const fresh = tabs()->GetActiveTab();
+  NavigateParams params(browser(), Url("routed.test", "/echo?typed"),
+                        ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::CURRENT_TAB;
+  params.source_contents = fresh->GetContents();
+  Navigate(&params);
+  EXPECT_EQ("jar=work", FirstCookieFor("/echo?typed"));
+  EXPECT_EQ(work_, model_->FindSpaceForTab(fresh));
+  EXPECT_TRUE(content::WaitForLoadStop(fresh->GetContents()));
+  EXPECT_EQ(Url("routed.test", "/echo?typed"),
+            fresh->GetContents()->GetLastCommittedURL());
+}
+
+// An address typed on a settings page is no fresh tab: the page stays in
+// its Space and the address loads in its jar.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, TypingOnSettingsDoesNotMoveTheTab) {
+  RouteToWork("routed.test");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://settings")));
+  tabs::TabInterface* const settings = tabs()->GetActiveTab();
+  NavigateParams params(browser(), Url("routed.test", "/from-settings"),
+                        ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::CURRENT_TAB;
+  params.source_contents = settings->GetContents();
+  Navigate(&params);
+  FirstCookieFor("/from-settings");
+  EXPECT_EQ(home_, model_->FindSpaceForTab(settings));
+}
+
+// A Shift-click in an independent Space opens a window showing that Space,
+// and the page carries its cookies.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ANewWindowFromASpaceShowsThatSpace) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  NavigateParams params(browser(), Url("b.test", "/window"),
+                        ui::PAGE_TRANSITION_LINK);
+  params.disposition = WindowOpenDisposition::NEW_WINDOW;
+  params.source_contents = work_tab_.Get()->GetContents();
+  Navigate(&params);
+  EXPECT_EQ("jar=work", FirstCookieFor("/window"));
+  ASSERT_NE(browser(), params.browser);
+  spaces::SpaceModel* const other = spaces::SpaceModel::From(params.browser);
+  ASSERT_TRUE(other);
+  EXPECT_TRUE(
+      base::test::RunUntil([&]() { return other->active_id() == work_; }));
+}
+
+// A routed tab dragged to another window lands in that window's Space and is
+// not routed again: no toast, nothing to undo.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ADraggedRoutedTabIsNotRoutedAgain) {
+  RouteToWork("routed.test");
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("routed.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  const int index = tabs()->active_index();
+
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  spaces::SpaceModel* const other = spaces::SpaceModel::From(second);
+  ASSERT_TRUE(other);
+  ASSERT_TRUE(other->SetActiveSpace(home_));
+  std::unique_ptr<tabs::TabModel> moved =
+      tabs()->DetachTabAtForInsertion(index);
+  tabs::TabInterface* const tab = moved.get();
+  second->GetTabStripModel()->InsertDetachedTabAt(0, std::move(moved),
+                                                  AddTabTypes::ADD_ACTIVE);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(home_, other->FindSpaceForTab(tab));
+  EXPECT_FALSE(other->UndoLastRoute()) << "a drag is not a route";
+}
+
+// PLAN.md SPC-9: a page that could ask "Leave site?" keeps its jar when it
+// moves to an independent Space. Leaving it runs the next page in the new
+// jar.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, APageWithChangesKeepsItsJarUntilLeft) {
+  tabs::TabInterface* const tab = home_tab_.Get();
+  content::WebContents* const page = tab->GetContents();
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+  const content::StoragePartitionConfig shared = JarOf(tab);
+
+  model_->SetSpaceForTab(tab, work_);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(page, tab->GetContents()) << "the page must not be replaced";
+  EXPECT_EQ(shared, JarOf(tab));
+
+  // The user leaves the page (the handler goes first, so no dialog waits).
+  content::ExecuteScriptAsync(
+      page, content::JsReplace(
+                "window.removeEventListener('beforeunload', window.stay);"
+                "location.href = $1;",
+                Url("b.test", "/left")));
+  EXPECT_EQ("jar=work", FirstCookieFor("/left"));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return tab->GetContents() != page &&
+           spaces::IsSpaceStoragePartition(JarOf(tab));
+  }));
+}
+
+// PLAN.md SPC-9: pinning such a page as an essential, which lives on the
+// profile's jar, keeps the page too, until it is left.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, AnEssentialWithChangesKeepsItsJarUntilLeft) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  tabs::TabInterface* const tab = work_tab_.Get();
+  content::WebContents* const page = tab->GetContents();
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+  const content::StoragePartitionConfig work_jar = JarOf(tab);
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(work_jar));
+
+  tabs()->SetTabPinned(tabs()->GetIndexOfTab(tab), true);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(page, tab->GetContents()) << "the page must not be replaced";
+  EXPECT_EQ(work_jar, JarOf(tab));
+
+  content::ExecuteScriptAsync(
+      page, content::JsReplace(
+                "window.removeEventListener('beforeunload', window.stay);"
+                "location.href = $1;",
+                Url("b.test", "/echo?left-as-essential")));
+  EXPECT_EQ("jar=shared", FirstCookieFor("/echo?left-as-essential"));
+}
+
+// PLAN.md SPC-9: turning the independent session off keeps such a page in
+// the jar it had until it is left; the Space's other pages move at once.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, TurningIsolationOffKeepsAPageWithChanges) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  tabs::TabInterface* const tab = work_tab_.Get();
+  content::WebContents* const page = tab->GetContents();
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+  const content::StoragePartitionConfig work_jar = JarOf(tab);
+
+  model_->SetSpaceIsolated(work_, false);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(page, tab->GetContents()) << "the page must not be replaced";
+  EXPECT_EQ(work_jar, JarOf(tab));
+
+  content::ExecuteScriptAsync(
+      page, content::JsReplace(
+                "window.removeEventListener('beforeunload', window.stay);"
+                "location.href = $1;",
+                Url("b.test", "/echo?left-after-isolation")));
+  EXPECT_EQ("jar=shared", FirstCookieFor("/echo?left-after-isolation"));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return !spaces::IsSpaceStoragePartition(JarOf(tab)); }));
+}
+
+// PLAN.md SPC-9: the form such a page sends goes in the session it was
+// filled in -- made again in the other jar it could arrive signed out -- and
+// the tab moves at the navigation after it.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, AFormFromAPageWithChangesUsesItsSession) {
+  tabs::TabInterface* const tab = home_tab_.Get();
+  content::WebContents* const page = tab->GetContents();
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+  model_->SetSpaceForTab(tab, work_);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(page, tab->GetContents());
+
+  content::TestNavigationObserver posted(page);
+  ASSERT_TRUE(content::ExecJs(
+      page, content::JsReplace(
+                "window.removeEventListener('beforeunload', window.stay);"
+                "document.body.innerHTML = '<form method=post action=' + $1 +"
+                "    '><input name=note value=typed></form>';"
+                "document.forms[0].submit();",
+                Url("b.test", "/echo?posted"))));
+  posted.Wait();
+  EXPECT_EQ("jar=shared", FirstCookieFor("/echo?posted"))
+      << "the form goes with the page's own session";
+  EXPECT_EQ(page, tab->GetContents());
+
+  content::ExecuteScriptAsync(
+      page, content::JsReplace("location.href = $1;",
+                               Url("b.test", "/echo?after-the-form")));
+  EXPECT_EQ("jar=work", FirstCookieFor("/echo?after-the-form"));
+}
+
+// A page with nothing unsaved moves at once, reloaded in the new jar.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, APageWithoutChangesMovesAtOnce) {
+  tabs::TabInterface* const tab = home_tab_.Get();
+  content::WebContents* const page = tab->GetContents();
+  model_->SetSpaceForTab(tab, work_);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return tab->GetContents() != page &&
+           spaces::IsSpaceStoragePartition(JarOf(tab));
+  }));
+}
+
+// sessions S20: a new tab in a Space with its own session is made in the
+// profile's jar, like the browser's other pages: the new tab page is a page
+// of the browser's own.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ANewTabInAnIsolatedSpaceShowsTheNewTabPage) {
+  content::WebContents* const page = OpenNewTabInWork();
+  EXPECT_FALSE(spaces::IsSpaceStoragePartition(
+      spaces::StoragePartitionConfigForWebContents(page)));
+  const content::NavigationEntry* const entry =
+      page->GetController().GetLastCommittedEntry();
+  ASSERT_TRUE(entry);
+  EXPECT_NE(content::PAGE_TYPE_ERROR, entry->GetPageType())
+      << page->GetLastCommittedURL();
+}
+
+// ... and the first page the tab leaves it for is made in the Space's jar,
+// whether an address is typed in it or the page itself goes somewhere.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, AnAddressTypedInTheNewTabPageUsesTheJar) {
+  content::WebContents* const page = OpenNewTabInWork();
+  tabs::TabInterface* const tab = tabs::TabInterface::GetFromContents(page);
+  NavigateParams params(browser(), Url("b.test", "/echo?typed-in-work"),
+                        ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::CURRENT_TAB;
+  params.source_contents = page;
+  Navigate(&params);
+  EXPECT_EQ("jar=work", FirstCookieFor("/echo?typed-in-work"));
+  EXPECT_EQ(work_, model_->FindSpaceForTab(tab));
+  EXPECT_TRUE(spaces::IsSpaceStoragePartition(JarOf(tab)));
+}
+
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ALinkFromTheNewTabPageUsesTheJar) {
+  content::WebContents* const page = OpenNewTabInWork();
+  tabs::TabInterface* const tab = tabs::TabInterface::GetFromContents(page);
+  content::ExecuteScriptAsync(
+      page, content::JsReplace("location.href = $1;",
+                               Url("b.test", "/echo?from-new-tab-page")));
+  EXPECT_EQ("jar=work", FirstCookieFor("/echo?from-new-tab-page"));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return spaces::IsSpaceStoragePartition(JarOf(tab)); }));
+  EXPECT_EQ(work_, model_->FindSpaceForTab(tab));
+}
+
+// A settings page in a Space with its own session lives in the profile's
+// jar; a site opened from it is made in the Space's.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, TheWebFromSettingsInASpaceUsesItsJar) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const settings = tabs()->GetActiveTab();
+  ASSERT_FALSE(spaces::IsSpaceStoragePartition(JarOf(settings)));
+  NavigateParams params(browser(), Url("b.test", "/echo?from-settings"),
+                        ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::CURRENT_TAB;
+  params.source_contents = settings->GetContents();
+  Navigate(&params);
+  EXPECT_EQ("jar=work", FirstCookieFor("/echo?from-settings"));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return spaces::IsSpaceStoragePartition(JarOf(settings)); }));
+  EXPECT_EQ(work_, model_->FindSpaceForTab(settings));
+}
+
+// PLAN.md SPC-11: Delete browsing data, which names no jar, empties every
+// Space's jar too. Work's tab, signed in, is signed out on reload.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, DeletingBrowsingDataReachesSpaceJars) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  content::WebContents* const page = work_tab_.Get()->GetContents();
+  ASSERT_TRUE(
+      content::NavigateToURL(page, Url("b.test", "/echoheader?Cookie")));
+  ASSERT_EQ("jar=work", content::EvalJs(page, "document.body.innerText"));
+
+  // What Settings > Delete browsing data asks for with "All time": no jar
+  // named. Cookies alone: the cache's part clears the network history too,
+  // which under a loaded disk takes longer than a test may wait.
+  content::BrowsingDataRemover* const remover =
+      browser()->GetProfile()->GetBrowsingDataRemover();
+  content::BrowsingDataRemoverCompletionObserver done(remover);
+  remover->RemoveAndReply(
+      base::Time(), base::Time::Max(),
+      content::BrowsingDataRemover::DATA_TYPE_COOKIES,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB, &done);
+  done.BlockUntilCompletion();
+  // The jars' removals queue behind that one, as the isolated web apps' do;
+  // a removal queued now finishes after them.
+  content::BrowsingDataRemoverCompletionObserver after(remover);
+  remover->RemoveAndReply(
+      base::Time(), base::Time::Max(),
+      content::BrowsingDataRemover::DATA_TYPE_COOKIES,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB, &after);
+  after.BlockUntilCompletion();
+
+  content::TestNavigationObserver reloaded(page);
+  page->GetController().Reload(content::ReloadType::NORMAL,
+                               /*check_for_repost=*/false);
+  reloaded.Wait();
+  EXPECT_EQ("None", content::EvalJs(page, "document.body.innerText"))
+      << "Work's cookie went with the rest";
+}
+
+// PLAN.md SPC-11, the person's check: Settings > Delete browsing data with
+// "All time" and "Cookies and other site data" -- the message the dialog's
+// button sends -- signs Work's tab out: it reloads with no cookie.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, SettingsDeleteBrowsingDataSignsWorkOut) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  content::WebContents* const page = work_tab_.Get()->GetContents();
+  ASSERT_TRUE(
+      content::NavigateToURL(page, Url("b.test", "/echoheader?Cookie")));
+  ASSERT_EQ("jar=work", content::EvalJs(page, "document.body.innerText"));
+
+  // Plain chrome://settings: the dialog's own route would open the dialog,
+  // whose start-up drops any reply still pending.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  EXPECT_TRUE(content::ExecJs(
+      tabs()->GetActiveWebContents(),
+      "(async () => {"
+      "  const {sendWithPromise} ="
+      "      await import('chrome://resources/js/cr.js');"
+      "  await sendWithPromise('initializeClearBrowsingData');"
+      "  await sendWithPromise("
+      "      'clearBrowsingData', ['browser.clear_data.cookies'], 4);"
+      "})()"));
+  // The jars' removals queue behind the dialog's; one queued now finishes
+  // after them.
+  content::BrowsingDataRemover* const remover =
+      browser()->GetProfile()->GetBrowsingDataRemover();
+  content::BrowsingDataRemoverCompletionObserver after(remover);
+  remover->RemoveAndReply(
+      base::Time(), base::Time::Max(),
+      content::BrowsingDataRemover::DATA_TYPE_COOKIES,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB, &after);
+  after.BlockUntilCompletion();
+
+  tabs()->ActivateTabAt(tabs()->GetIndexOfTab(work_tab_.Get()));
+  content::TestNavigationObserver reloaded(page);
+  page->GetController().Reload(content::ReloadType::NORMAL,
+                               /*check_for_repost=*/false);
+  reloaded.Wait();
+  EXPECT_EQ("None", content::EvalJs(page, "document.body.innerText"))
+      << "Work's tab is signed out";
+}
+
+// PLAN.md SPC-13: with Work open in two windows, turning its independent
+// session off moves Work's tabs in both windows to the shared jar, and on
+// again moves them back.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, IsolationChangesReachEveryWindow) {
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  spaces::SpaceModel* const other = spaces::SpaceModel::From(second);
+  ASSERT_TRUE(other);
+  ASSERT_TRUE(other->SetActiveSpace(work_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      second, Url("b.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const there = second->GetTabStripModel()->GetActiveTab();
+  ASSERT_EQ(work_, other->FindSpaceForTab(there));
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(JarOf(there)));
+  tabs::TabInterface* const here = work_tab_.Get();
+
+  model_->SetSpaceIsolated(work_, false);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !spaces::IsSpaceStoragePartition(JarOf(here)) &&
+           !spaces::IsSpaceStoragePartition(JarOf(there));
+  }));
+  model_->SetSpaceIsolated(work_, true);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return spaces::IsSpaceStoragePartition(JarOf(here)) &&
+           spaces::IsSpaceStoragePartition(JarOf(there));
+  }));
+}
+
+// PLAN.md SPC-13: Clear Independent Session, run from one window, signs
+// Work's tabs out in every window: they reload with an empty jar.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ClearingTheSessionReloadsEveryWindow) {
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  spaces::SpaceModel* const other = spaces::SpaceModel::From(second);
+  ASSERT_TRUE(other);
+  ASSERT_TRUE(other->SetActiveSpace(work_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      second, Url("b.test", "/echoheader?Cookie"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const there =
+      second->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_EQ("jar=work", content::EvalJs(there, "document.body.innerText"));
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  content::WebContents* const here = work_tab_.Get()->GetContents();
+  ASSERT_TRUE(
+      content::NavigateToURL(here, Url("b.test", "/echoheader?Cookie")));
+  ASSERT_EQ("jar=work", content::EvalJs(here, "document.body.innerText"));
+
+  content::TestNavigationObserver here_reloaded(here);
+  content::TestNavigationObserver there_reloaded(there);
+  base::test::TestFuture<void> wiped;
+  ASSERT_TRUE(model_->WipeIsolatedSession(work_, wiped.GetCallback()));
+  ASSERT_TRUE(wiped.Wait());
+  here_reloaded.Wait();
+  there_reloaded.Wait();
+  EXPECT_EQ("None", content::EvalJs(here, "document.body.innerText"));
+  EXPECT_EQ("None", content::EvalJs(there, "document.body.innerText"))
+      << "the other window's tab of Work is signed out too";
+}
+
+// PLAN.md TAB-15: a signed-in tab of Work put to sleep sleeps in Work's jar
+// and wakes there, still signed in.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ASleptTabWakesInItsJarSignedIn) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  ASSERT_TRUE(content::NavigateToURL(work_tab_.Get()->GetContents(),
+                                     Url("b.test", "/echoheader?Cookie")));
+  ASSERT_EQ("jar=work", content::EvalJs(work_tab_.Get()->GetContents(),
+                                        "document.body.innerText"));
+  // Another tab of Work on screen, so this one can sleep.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("a.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  stedding::SleepTabList({work_tab_.Get()});
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return work_tab_.Get()->GetContents()->WasDiscarded(); }));
+  EXPECT_TRUE(spaces::IsSpaceStoragePartition(JarOf(work_tab_.Get())))
+      << "asleep in Work's jar";
+
+  tabs()->ActivateTabAt(tabs()->GetIndexOfTab(work_tab_.Get()));
+  // Woken: loaded again, which may begin a turn after the activation.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    content::WebContents* const contents = work_tab_.Get()->GetContents();
+    return !contents->WasDiscarded() && !contents->IsLoading();
+  }));
+  content::WebContents* const woken = work_tab_.Get()->GetContents();
+  EXPECT_TRUE(spaces::IsSpaceStoragePartition(JarOf(work_tab_.Get())));
+  EXPECT_EQ("jar=work", content::EvalJs(woken, "document.body.innerText"))
+      << "awake and still signed in";
+}
+
+// The question before an isolation change counts the open pages that would
+// reload: web pages of that Space, awake, not essentials.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, TheIsolationQuestionCountsOpenPages) {
+  EXPECT_EQ(1, model_->CountPagesAJarChangeReloads(work_));
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("b.test", "/title2.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  EXPECT_EQ(2, model_->CountPagesAJarChangeReloads(work_))
+      << "the settings page keeps the profile's jar";
+}
+
+// SPC-9: turning a Space's session on from chrome://settings/stedding
+// rebinds that Space's web pages and leaves the settings page alone: it lives
+// in the profile's jar, and it is not reloaded under the person using it.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest,
+                       IsolationFromSettingsKeepsTheSettingsPage) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const settings_tab = tabs()->GetActiveTab();
+  ASSERT_EQ(home_, model_->FindSpaceForTab(settings_tab));
+  content::WebContents* const settings = settings_tab->GetContents();
+  ASSERT_TRUE(content::ExecJs(settings, "window.marker = 'still here';"));
+
+  // The page's own message, as its switch sends it.
+  ASSERT_TRUE(content::ExecJs(
+      settings,
+      content::JsReplace("chrome.send('steddingSetSpaceIsolated', [$1, true]);",
+                         home_.ToString())));
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return model_->SpaceIsIsolated(home_); }));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return spaces::IsSpaceStoragePartition(JarOf(home_tab_.Get()));
+  })) << "Home's web page moves to Home's own jar";
+
+  EXPECT_EQ(settings, settings_tab->GetContents())
+      << "the settings page was replaced";
+  EXPECT_EQ("still here", content::EvalJs(settings, "window.marker"))
+      << "the settings page was reloaded";
+  EXPECT_FALSE(spaces::IsSpaceStoragePartition(JarOf(settings_tab)));
+}
+
+// SPC-9: an extension's own pages live in the profile's jar in every Space,
+// so what one of them keeps in localStorage is there in a Space with a
+// session of its own, and a move between Spaces does not reload it.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest,
+                       AnExtensionPageKeepsItsStorageInEverySpace) {
+  extensions::TestExtensionDir dir;
+  dir.WriteManifest(
+      R"({"name": "Storage", "version": "1", "manifest_version": 3})");
+  dir.WriteFile(FILE_PATH_LITERAL("page.html"),
+                "<!doctype html><title>Storage</title>");
+  extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+  const scoped_refptr<const extensions::Extension> extension =
+      loader.LoadExtension(dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  const GURL page = extension->ResolveExtensionURL("page.html");
+
+  // Home shares the profile's jar: the page stores a value there.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), page, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_TRUE(content::ExecJs(tabs()->GetActiveWebContents(),
+                              "localStorage.setItem('k', 'stored in Home')"));
+
+  // Work has a session of its own; the extension's page is still the
+  // profile's, and reads the value.
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), page, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const in_work = tabs()->GetActiveTab();
+  ASSERT_EQ(work_, model_->FindSpaceForTab(in_work));
+  EXPECT_FALSE(spaces::IsSpaceStoragePartition(JarOf(in_work)));
+  EXPECT_EQ("stored in Home", content::EvalJs(in_work->GetContents(),
+                                              "localStorage.getItem('k')"));
+
+  // Moved to Home, the page stays as it is.
+  content::WebContents* const contents = in_work->GetContents();
+  ASSERT_TRUE(content::ExecJs(contents, "window.marker = 'still here';"));
+  model_->SetSpaceForTab(in_work, home_);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(contents, in_work->GetContents());
+  EXPECT_EQ("still here", content::EvalJs(contents, "window.marker"));
+  EXPECT_EQ("stored in Home",
+            content::EvalJs(contents, "localStorage.getItem('k')"));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/space_jar_restart_browsertest.cc b/chrome/test/stedding/space_jar_restart_browsertest.cc
new file mode 100644
index 0000000000000..50d181c2c223d
--- /dev/null
+++ b/chrome/test/stedding/space_jar_restart_browsertest.cc
@@ -0,0 +1,131 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A Space's own cookie jar across a restart that collects storage
+// partitions (PLAN.md SPC-10, docs/features/sessions.md S25). An extension or
+// app uninstall sets a pref, and the next start deletes every partition that
+// no allowlist names. A Space with no tab open has no loaded partition; its
+// jar must still be there after that start, cookie and all.
+
+#include <optional>
+#include <string>
+
+#include "base/files/file_util.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/web_applications/web_app_command_manager.h"
+#include "chrome/browser/web_applications/web_app_provider.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/common/stedding/space_partitions.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+class SpaceJarRestartTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  GURL Url(const std::string& path) {
+    return embedded_test_server()->GetURL("jar.test", path);
+  }
+
+  std::optional<spaces::SpaceId> SpaceNamed(const std::string& name) {
+    for (const auto& space : model()->spaces()) {
+      if (space->name() == name) {
+        return space->id();
+      }
+    }
+    return std::nullopt;
+  }
+
+  // A tab of the active Space showing what the server saw of its cookies.
+  std::string CookieSeenInANewTab() {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("/echoheader?Cookie"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return content::EvalJs(tabs()->GetActiveWebContents(),
+                           "document.body.innerText")
+        .ExtractString();
+  }
+};
+
+// Work keeps a jar of its own with a cookie in it, and has no tab open when
+// the window closes; an uninstall has asked for the next start to collect.
+IN_PROC_BROWSER_TEST_F(SpaceJarRestartTest,
+                       PRE_ASpacesJarOutlivesTheCollection) {
+  ASSERT_TRUE(model());
+  const spaces::SpaceId home = model()->active_id();
+  const spaces::SpaceId work = model()->AddSpace("Work", SK_ColorBLUE)->id();
+  model()->SetSpaceIsolated(work, true);
+  ASSERT_TRUE(model()->SetActiveSpace(work));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("/set-cookie?jar=work;max-age=86400"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(
+      spaces::StoragePartitionConfigForWebContents(
+          tabs()->GetActiveWebContents())));
+  ASSERT_EQ("jar=work", CookieSeenInANewTab());
+
+  // Home on screen, and no tab of Work left open.
+  ASSERT_TRUE(model()->SetActiveSpace(home));
+  for (int i = tabs()->count() - 1; i >= 0; --i) {
+    if (model()->SpaceForTab(tabs()->GetTabAtIndex(i)) == work) {
+      tabs()->CloseWebContentsAt(i, TabCloseTypes::CLOSE_NONE);
+    }
+  }
+  ASSERT_GT(tabs()->count(), 0);
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      prefs::kShouldGarbageCollectStoragePartitions, true);
+}
+
+// The start collected, and Work's jar and its cookie are still there.
+IN_PROC_BROWSER_TEST_F(SpaceJarRestartTest, ASpacesJarOutlivesTheCollection) {
+  web_app::WebAppProvider* const provider =
+      web_app::WebAppProvider::GetForTest(browser()->GetProfile());
+  ASSERT_TRUE(provider);
+  provider->command_manager().AwaitAllCommandsCompleteForTesting();
+  ASSERT_FALSE(browser()->GetProfile()->GetPrefs()->GetBoolean(
+      prefs::kShouldGarbageCollectStoragePartitions))
+      << "the collection ran";
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    EXPECT_TRUE(base::DirectoryExists(stedding::SpacePartitionsDirectory(
+        browser()->GetProfile()->GetPath())));
+  }
+
+  const std::optional<spaces::SpaceId> work = SpaceNamed("Work");
+  ASSERT_TRUE(work.has_value());
+  ASSERT_TRUE(model()->SpaceIsIsolated(*work));
+  ASSERT_TRUE(model()->SetActiveSpace(*work));
+  EXPECT_EQ("jar=work", CookieSeenInANewTab()) << "the cookie survived";
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/space_keys_browsertest.mm b/chrome/test/stedding/space_keys_browsertest.mm
new file mode 100644
index 0000000000000..9817d98b776b8
--- /dev/null
+++ b/chrome/test/stedding/space_keys_browsertest.mm
@@ -0,0 +1,59 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Arc's keys for Spaces reach their commands the way a key press does on the
+// Mac: through CommandForKeyEvent, which looks first at the main menu's key
+// equivalents -- the Spaces menu carries them -- and then at the chords coded
+// by key (PLAN.md TST-3, spaces B18-B23). SpaceSwitchTest runs each command
+// in a real window and checks what it shows.
+
+#import <Carbon/Carbon.h>
+#import <Cocoa/Cocoa.h>
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/test/browser_test.h"
+#include "ui/events/test/cocoa_test_event_utils.h"
+
+namespace {
+
+struct Chord {
+  unsigned short key_code;
+  unichar character;
+  NSUInteger modifiers;
+  int command;
+};
+
+using SpaceKeysTest = InProcessBrowserTest;
+
+IN_PROC_BROWSER_TEST_F(SpaceKeysTest, EachChordRunsItsSpaceCommand) {
+  constexpr NSUInteger kArrow =
+      NSEventModifierFlagFunction | NSEventModifierFlagNumericPad;
+  const Chord chords[] = {
+      {kVK_ANSI_1, '1', NSEventModifierFlagControl, IDC_STEDDING_SPACE_1},
+      {kVK_ANSI_2, '2', NSEventModifierFlagControl, IDC_STEDDING_SPACE_2},
+      {kVK_ANSI_3, '3', NSEventModifierFlagControl, IDC_STEDDING_SPACE_3},
+      {kVK_ANSI_4, '4', NSEventModifierFlagControl, IDC_STEDDING_SPACE_4},
+      {kVK_ANSI_5, '5', NSEventModifierFlagControl, IDC_STEDDING_SPACE_5},
+      {kVK_ANSI_6, '6', NSEventModifierFlagControl, IDC_STEDDING_SPACE_6},
+      {kVK_ANSI_7, '7', NSEventModifierFlagControl, IDC_STEDDING_SPACE_7},
+      {kVK_ANSI_8, '8', NSEventModifierFlagControl, IDC_STEDDING_SPACE_8},
+      {kVK_ANSI_9, '9', NSEventModifierFlagControl, IDC_STEDDING_SPACE_9},
+      {kVK_RightArrow, NSRightArrowFunctionKey,
+       NSEventModifierFlagCommand | NSEventModifierFlagOption | kArrow,
+       IDC_STEDDING_SPACE_NEXT},
+      {kVK_LeftArrow, NSLeftArrowFunctionKey,
+       NSEventModifierFlagCommand | NSEventModifierFlagOption | kArrow,
+       IDC_STEDDING_SPACE_PREVIOUS},
+  };
+  for (const Chord& chord : chords) {
+    SCOPED_TRACE(testing::Message() << "command " << chord.command);
+    NSEvent* const event = cocoa_test_event_utils::KeyEventWithKeyCode(
+        chord.key_code, chord.character, NSEventTypeKeyDown, chord.modifiers);
+    EXPECT_EQ(chord.command, CommandForKeyEvent(event).chrome_command);
+  }
+}
