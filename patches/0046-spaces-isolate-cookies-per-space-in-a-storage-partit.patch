diff --git a/chrome/browser/ui/spaces/space_storage_partition.cc b/chrome/browser/ui/spaces/space_storage_partition.cc
new file mode 100644
index 0000000000000..f45318df41cf5
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_storage_partition.cc
@@ -0,0 +1,167 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+
+#include "base/token.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/tab_contents/tab_util.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/security_principal.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/referrer.h"
+#include "ui/base/page_transition_types.h"
+
+namespace spaces {
+namespace {
+
+bool SameJar(const content::StoragePartitionConfig& a,
+             const std::optional<content::StoragePartitionConfig>& b) {
+  const bool a_space = IsSpaceStoragePartition(a);
+  if (!b) {
+    return !a_space;
+  }
+  return a_space && a.partition_name() == b->partition_name();
+}
+
+std::optional<SpaceId> SpaceIdFromExtraData(
+    const std::map<std::string, std::string>& extra_data) {
+  const auto it = extra_data.find(kSessionTabSpaceKey);
+  if (it == extra_data.end()) {
+    return std::nullopt;
+  }
+  const std::optional<base::Token> token = base::Token::FromString(it->second);
+  if (!token) {
+    return std::nullopt;
+  }
+  return SpaceId::FromRawToken(*token);
+}
+
+}  // namespace
+
+std::optional<content::StoragePartitionConfig>
+StoragePartitionConfigForProfileId(content::BrowserContext* browser_context,
+                                   std::string_view profile_id) {
+  if (!browser_context || profile_id.empty()) {
+    return std::nullopt;
+  }
+  return content::StoragePartitionConfig::Create(
+      browser_context, kSpacePartitionDomain, profile_id,
+      /*in_memory=*/false);
+}
+
+std::optional<content::StoragePartitionConfig> StoragePartitionConfigForSpace(
+    content::BrowserContext* browser_context,
+    const SpaceRegistry* registry,
+    const SpaceId& id) {
+  if (!registry) {
+    return std::nullopt;
+  }
+  const RegistryEntry* const entry = registry->Find(id);
+  if (!entry) {
+    return std::nullopt;
+  }
+  return StoragePartitionConfigForProfileId(browser_context, entry->profile_id);
+}
+
+bool IsSpaceStoragePartition(const content::StoragePartitionConfig& config) {
+  return config.partition_domain() == kSpacePartitionDomain &&
+         !config.partition_name().empty();
+}
+
+content::StoragePartitionConfig StoragePartitionConfigForWebContents(
+    content::WebContents* web_contents) {
+  if (!web_contents || !web_contents->GetSiteInstance()) {
+    return content::StoragePartitionConfig();
+  }
+  return web_contents->GetSiteInstance()
+      ->GetSecurityPrincipal()
+      .GetStoragePartitionConfig();
+}
+
+scoped_refptr<content::SiteInstance> SiteInstanceForSpaceTab(
+    content::BrowserContext* browser_context,
+    const GURL& url,
+    const SpaceRegistry* registry,
+    const SpaceId& id,
+    bool essential) {
+  if (!browser_context) {
+    return nullptr;
+  }
+  if (!essential) {
+    if (std::optional<content::StoragePartitionConfig> config =
+            StoragePartitionConfigForSpace(browser_context, registry, id)) {
+      return content::SiteInstance::CreateForFixedStoragePartition(
+          browser_context, url, *config);
+    }
+  }
+  Profile* const profile = Profile::FromBrowserContext(browser_context);
+  return tab_util::GetSiteInstanceForNewTab(profile, url);
+}
+
+scoped_refptr<content::SiteInstance> SiteInstanceForRestoredTab(
+    content::BrowserContext* browser_context,
+    const GURL& url,
+    const SpaceRegistry* registry,
+    const std::map<std::string, std::string>& extra_data,
+    bool essential) {
+  // Upstream defers a restored tab's SiteInstance to its first load (M155,
+  // the WebUI toolbar occlusion fix), so a tab on the shared jar gets none
+  // here. Only a tab restored into an isolated Space needs one now: its
+  // storage partition is fixed when its contents are created.
+  const std::optional<SpaceId> id = SpaceIdFromExtraData(extra_data);
+  if (!id || essential || !browser_context) {
+    return nullptr;
+  }
+  if (std::optional<content::StoragePartitionConfig> config =
+          StoragePartitionConfigForSpace(browser_context, registry, *id)) {
+    return content::SiteInstance::CreateForFixedStoragePartition(
+        browser_context, url, *config);
+  }
+  return nullptr;
+}
+
+void RebindTabToSpaceJar(TabStripModel* tabs,
+                         tabs::TabInterface* tab,
+                         const SpaceRegistry* registry,
+                         const SpaceId& id) {
+  if (!tabs || !tab) {
+    return;
+  }
+  content::WebContents* const old_contents = tab->GetContents();
+  if (!old_contents) {
+    return;
+  }
+  content::BrowserContext* const context = old_contents->GetBrowserContext();
+  const bool essential = tab->IsPinned();
+  const std::optional<content::StoragePartitionConfig> target =
+      essential ? std::nullopt
+                : StoragePartitionConfigForSpace(context, registry, id);
+  if (SameJar(StoragePartitionConfigForWebContents(old_contents), target)) {
+    return;
+  }
+  GURL url = old_contents->GetLastCommittedURL();
+  if (url.is_empty()) {
+    url = old_contents->GetVisibleURL();
+  }
+  scoped_refptr<content::SiteInstance> site_instance = SiteInstanceForSpaceTab(
+      context, url.is_empty() ? GURL("about:blank") : url, registry, id,
+      essential);
+  content::WebContents::CreateParams params(context, site_instance);
+  std::unique_ptr<content::WebContents> fresh =
+      content::WebContents::Create(params);
+  if (!url.is_empty() && !url.IsAboutBlank()) {
+    fresh->GetController().LoadURL(url, content::Referrer(),
+                                   ui::PAGE_TRANSITION_RELOAD, std::string());
+  }
+  tabs->DiscardWebContents(old_contents, std::move(fresh));
+}
+
+}  // namespace spaces
