+// windows G13, folders F38: a pinned folder renamed in the same turn as one
+// of its rows stops being a pin, that row still in the folder when the
+// window publishes: the rename goes out once the folder is all pins again,
+// and is not reset from the store.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest,
+                       AFolderRenamedAsARowLeavesItKeepsItsName) {
+  tabs::TabInterface* const a = PinPage(browser(), Page("/title1.html"));
+  tabs::TabInterface* const b = PinPage(browser(), Page("/title2.html"));
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  tabs::FolderTabCollection* const folder =
+      strip->AddToNewFolder({strip->GetIndexOfTab(a), strip->GetIndexOfTab(b)});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Work");
+  ASSERT_TRUE(Model(browser()).IsFolderSpacePinned(folder));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(2u, Store().records().size());
+  const std::string a_id = Token(a);
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const std::vector<tabs::TabInterface*> there = Pins(second);
+    return there.size() == 2u && FolderOf(there[0]) &&
+           FolderOf(there[0])->title() == "Work";
+  }));
+
+  // One turn: the folder renamed, and `b` no pin, left where it is.
+  folder->SetTitle("Desk");
+  Model(browser()).SetSpacePinnedInPlace(b, false);
+  base::RunLoop().RunUntilIdle();
+  // Then `b` leaves the folder, which is all pins again.
+  if (FolderOf(b)) {
+    strip->MoveTabOutOfFolders(strip->GetIndexOfTab(b));
+  }
+  base::RunLoop().RunUntilIdle();
+
+  ASSERT_EQ(folder, FolderOf(a));
+  EXPECT_EQ("Desk", folder->title()) << "the rename was reset from the store";
+  ASSERT_EQ(1u, Store().records().size());
+  EXPECT_EQ(a_id, Store().records().front().id);
+  EXPECT_NE(std::string::npos,
+            Store().records().front().folder_path.find("Desk"))
+      << "the rename never reached the store";
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const std::vector<tabs::TabInterface*> there = Pins(second);
+    return there.size() == 1u && FolderOf(there[0]) &&
+           FolderOf(there[0])->title() == "Desk";
+  })) << "the rename did not reach the other window";
+}
