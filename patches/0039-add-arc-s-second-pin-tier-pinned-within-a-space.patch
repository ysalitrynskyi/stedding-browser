@@ -515,6 +517,17 @@ bool TabStripCollectionController::IsContextMenuCommandChecked(
 bool TabStripCollectionController::IsContextMenuCommandEnabled(
     tabs::TabInterface* tab,
     TabStripModel::ContextMenuCommand command_id) {
+  // Stedding's per-Space pin pair: exactly one enabled, from the SpaceModel.
+  if (command_id == TabStripModel::CommandSpacePin ||
+      command_id == TabStripModel::CommandSpaceUnpin) {
+    spaces::SpaceModel* const space_model =
+        spaces::SpaceModel::From(browser_view_->browser());
+    if (!space_model || !tab || tab->IsPinned()) {
+      return false;
+    }
+    const bool pinned = space_model->IsSpacePinned(tab);
+    return command_id == TabStripModel::CommandSpacePin ? !pinned : pinned;
+  }
   return model_->IsContextMenuCommandEnabled(model_->GetIndexOfTab(tab),
                                              command_id);
 }
@@ -528,6 +541,26 @@ void TabStripCollectionController::ExecuteContextMenuCommand(
     tabs::TabInterface* tab,
     TabStripModel::ContextMenuCommand command_id,
     int event_flags) {
+  if (command_id == TabStripModel::CommandSpacePin ||
+      command_id == TabStripModel::CommandSpaceUnpin) {
+    spaces::SpaceModel* const space_model =
+        spaces::SpaceModel::From(browser_view_->browser());
+    if (!space_model || !tab) {
+      return;
+    }
+    const bool pin = command_id == TabStripModel::CommandSpacePin;
+    space_model->SetSpacePinned(tab, pin);
+    // A Space-pinned tab lives at the top of the unpinned block, directly
+    // under the Clear line, so pinning moves it there.
+    if (pin) {
+      const int index = model_->GetIndexOfTab(tab);
+      const int first_unpinned = model_->IndexOfFirstNonPinnedTab();
+      if (index != TabStripModel::kNoTab && index != first_unpinned) {
+        model_->MoveWebContentsAt(index, first_unpinned, false);
+      }
+    }
+    return;
+  }
   model_->ExecuteContextMenuCommand(model_->GetIndexOfTab(tab), command_id);
 }
 
