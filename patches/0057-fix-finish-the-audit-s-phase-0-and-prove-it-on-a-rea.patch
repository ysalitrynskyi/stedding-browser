@@ -0,0 +1,170 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A Space left while its tabs are in use (PLAN.md TAB-14, tabs R5-R6). The
+// Space's timer puts its idle tabs to sleep through the real tab lifecycle
+// unit and leaves alone a tab playing sound, one in a call, one showing
+// picture-in-picture and one with a form someone typed into. Sleep Other
+// Tabs with a split on screen keeps both of its panes.
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/test/run_until.h"
+#include "base/time/time.h"
+#include "chrome/browser/media/webrtc/media_capture_devices_dispatcher.h"
+#include "chrome/browser/media/webrtc/media_stream_capture_indicator.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/sleep_tabs.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/media_stream_request.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/blink/public/common/mediastream/media_stream_request.h"
+#include "third_party/blink/public/mojom/mediastream/media_stream.mojom.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+#include "ui/events/keycodes/dom/dom_key.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace {
+
+class SleepInUseTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+
+  // A new tab on screen showing `path` from the test server, loaded.
+  tabs::TabInterface* Open(const std::string& path) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(path),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  static bool Asleep(tabs::TabInterface* tab) {
+    return tab->GetContents()->WasDiscarded();
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SleepInUseTest, ALeftSpaceKeepsItsTabsInUseAwake) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId away = model->AddSpace("Away", SK_ColorBLUE)->id();
+
+  // Nobody uses this one: the timer must sleep it, which shows it ran.
+  tabs::TabInterface* const idle = Open("/title1.html");
+
+  tabs::TabInterface* const sound = Open("/title2.html");
+  ASSERT_TRUE(
+      content::ExecJs(sound->GetContents(),
+                      "window.context = new AudioContext();"
+                      "const tone = window.context.createOscillator();"
+                      "tone.connect(window.context.destination); tone.start();"
+                      "window.context.resume();"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return sound->GetContents()->IsCurrentlyAudible(); }));
+
+  // In a call: the capture indicator holds a microphone stream for the tab,
+  // as it does for a page whose getUserMedia was granted, and the sleep gate
+  // reads the indicator.
+  tabs::TabInterface* const call = Open("/title3.html");
+  blink::mojom::StreamDevices devices;
+  devices.audio_device = blink::MediaStreamDevice(
+      blink::mojom::MediaStreamType::DEVICE_AUDIO_CAPTURE, "microphone",
+      "Microphone");
+  std::unique_ptr<content::MediaStreamUI> call_stream =
+      MediaCaptureDevicesDispatcher::GetInstance()
+          ->GetMediaStreamCaptureIndicator()
+          ->RegisterMediaStream(call->GetContents(), devices);
+  call_stream->OnStarted(base::RepeatingClosure(),
+                         content::MediaStreamUI::SourceCallback(),
+                         /*label=*/std::string(), /*screen_capture_ids=*/{},
+                         content::MediaStreamUI::StateChangeCallback());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return stedding::TabIsInUse(call);
+  })) << "the call is seen";
+
+  tabs::TabInterface* const pip =
+      Open("/media/picture-in-picture/window-size.html");
+  ASSERT_EQ(true,
+            content::EvalJs(pip->GetContents(), "enterPictureInPicture()"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return pip->GetContents()->HasPictureInPictureVideo(); }));
+
+  tabs::TabInterface* const form = Open("/title1.html");
+  ASSERT_TRUE(content::ExecJs(form->GetContents(),
+                              "document.body.innerHTML = '<input id=field>';"
+                              "document.getElementById('field').focus();"));
+  for (int i = 0; i < 3; ++i) {
+    content::SimulateKeyPress(form->GetContents(),
+                              ui::DomKey::FromCharacter('a'), ui::DomCode::US_A,
+                              ui::VKEY_A, /*control=*/false, /*shift=*/false,
+                              /*alt=*/false, /*command=*/false);
+  }
+  ASSERT_EQ("aaa", content::EvalJs(form->GetContents(),
+                                   "document.getElementById('field').value"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return stedding::TabIsInUse(form);
+  })) << "the typing is seen";
+  ASSERT_FALSE(stedding::TabIsInUse(idle));
+
+  // The product's own timer and sleep, on a delay a test can wait for.
+  model->SetSleepPolicy(
+      base::Milliseconds(200),
+      base::BindRepeating([](const spaces::SpaceId&,
+                             const std::vector<tabs::TabInterface*>& tabs) {
+        stedding::SleepTabList(tabs);
+      }));
+  ASSERT_TRUE(model->SetActiveSpace(away));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Asleep(idle); }))
+      << "the timer ran and put the idle tab to sleep";
+  EXPECT_FALSE(Asleep(sound)) << "playing sound";
+  EXPECT_FALSE(Asleep(call)) << "in a call";
+  EXPECT_FALSE(Asleep(pip)) << "showing picture-in-picture";
+  EXPECT_FALSE(Asleep(form)) << "holding typed input";
+
+  // Nothing to answer when the window closes.
+  EXPECT_TRUE(content::ExecJs(pip->GetContents(), "exitPictureInPicture()"));
+  call_stream.reset();
+  EXPECT_TRUE(content::ExecJs(sound->GetContents(), "window.context.close()"));
+}
+
+IN_PROC_BROWSER_TEST_F(SleepInUseTest, SleepOthersKeepsBothPanesOnScreen) {
+  tabs::TabInterface* const other = Open("/title1.html");
+  tabs::TabInterface* const left = Open("/title2.html");
+  tabs::TabInterface* const right = Open("/title3.html");
+  tabs()->ActivateTabAt(Index(left));
+  tabs()->AddToNewSplit({Index(right)}, split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_EQ(left->GetSplit(), right->GetSplit());
+
+  stedding::SleepTabs(browser(), left, stedding::SleepScope::kOthersInSpace);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Asleep(other); }));
+  EXPECT_FALSE(Asleep(left));
+  EXPECT_FALSE(Asleep(right)) << "the other pane of the split on screen";
+}
+
