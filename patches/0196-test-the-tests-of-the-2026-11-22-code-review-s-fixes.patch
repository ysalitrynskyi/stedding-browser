+// sidebar-file Sf10, Sf35 (P10-1d): a backup or another computer's file
+// names a pinned folder a sidebar sync join paired by the id the join
+// shares, while the folder is here under its own. A pin of it closed since
+// comes back into that folder, and no second folder is made. The folder was
+// found to be here but not as a folder, and all it holds was skipped, while
+// a loose pin closed the same way came back.
+TEST_F(ArcImportWindowW2B09Test, APairedFolderTakesBackAPinClosedSince) {
+  Open("https://anchor.example/");
+  tabs::TabInterface* const first = Open("https://first.example/");
+  tabs::TabInterface* const second = Open("https://second.example/");
+  std::vector<int> both = {tabs().GetIndexOfTab(first),
+                           tabs().GetIndexOfTab(second)};
+  std::ranges::sort(both);
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(both);
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Reading");
+  model().SetFolderSpacePinned(folder, true);
+  ASSERT_TRUE(model().IsFolderSpacePinned(folder));
+  const std::string here_id = FolderSyncId(folder->id());
+
+  // The file, under the id the join shares: the other computer's.
+  ArcImportPlan plan = SnapshotSpace(browser(), model().active_id());
+  ASSERT_TRUE(plan.written_by_stedding);
+  ASSERT_EQ(1u, plan.spaces.size());
+  const std::string shared_id = FolderSyncId(
+      tabs::FolderId::FromRawToken(base::Token::CreateRandom()));
+  bool named = false;
+  for (std::vector<NodeW2B09>* const run :
+       {&plan.spaces[0].pinned, &plan.spaces[0].unpinned}) {
+    for (NodeW2B09& node : *run) {
+      if (node.kind == NodeW2B09::Kind::kFolder && node.arc_id == here_id) {
+        ASSERT_EQ(2u, node.children.size());
+        node.arc_id = shared_id;
+        named = true;
+      }
+    }
+  }
+  ASSERT_TRUE(named) << "the file has no such folder";
+  std::map<std::string, std::string> aliases;
+  aliases[here_id] = shared_id;
+  SetSyncAliasesForImport(profile(), std::move(aliases));
+
+  tabs().CloseWebContentsAt(tabs().GetIndexOfTab(second),
+                            TabCloseTypes::CLOSE_NONE);
+  ASSERT_FALSE(TabShowing(tabs(), "https://second.example/"));
+
+  const ArcImportResult result =
+      ApplyArcImport(browser(), plan, ArcImportOptions());
+  EXPECT_EQ(0u, result.folders) << "a second folder was made";
+  EXPECT_EQ(1u, result.tabs);
+  tabs::TabInterface* const back = TabShowing(tabs(), "https://second.example/");
+  ASSERT_TRUE(back) << "the pin closed since did not come back";
+  EXPECT_EQ(static_cast<const tabs::TabCollection*>(folder),
+            back->GetParentCollection())
+      << "it came back outside its folder";
+  EXPECT_TRUE(model().IsSpacePinned(back));
+}
