--- /dev/null
+++ b/chrome/browser/ui/views/peek/peek_press.h
@@ -0,0 +1,74 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_PRESS_H_
+#define CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_PRESS_H_
+
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "content/public/browser/render_widget_host.h"
+#include "content/public/browser/render_widget_host_observer.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class RenderFrameHost;
+}
+
+namespace stedding {
+
+// docs/features/peek.md P18: how long the user held the mouse button down on
+// a page for the click it navigates with. Settings › Stedding's "Open a peek
+// with" can ask for a held press; a plain click then follows the link in the
+// pinned tab as before. Kept from the input the page's main frame receives:
+// the left button's down and its up.
+class PeekPress : public content::WebContentsObserver,
+                  public content::WebContentsUserData<PeekPress>,
+                  public content::RenderWidgetHost::InputEventObserver,
+                  public content::RenderWidgetHostObserver {
+ public:
+  PeekPress(const PeekPress&) = delete;
+  PeekPress& operator=(const PeekPress&) = delete;
+  ~PeekPress() override;
+
+  // The press the last click was made with: from the button's down to its
+  // up, when the up came at most a second before `now`. Empty when there was
+  // none: a key's Enter, a script, a press long past, a button still down.
+  std::optional<base::TimeDelta> LastPressBefore(base::TimeTicks now) const;
+
+  // content::RenderWidgetHost::InputEventObserver:
+  void OnInputEvent(const content::RenderWidgetHost& widget,
+                    const blink::WebInputEvent& event,
+                    input::InputEventSource source) override;
+
+  // content::RenderWidgetHostObserver:
+  void RenderWidgetHostDestroyed(content::RenderWidgetHost* widget) override;
+
+  // content::WebContentsObserver:
+  void RenderFrameHostChanged(content::RenderFrameHost* old_host,
+                              content::RenderFrameHost* new_host) override;
+  void WebContentsDestroyed() override;
+
+ private:
+  friend class content::WebContentsUserData<PeekPress>;
+
+  explicit PeekPress(content::WebContents* contents);
+
+  // The main frame's widget is the one watched; a new document may bring a
+  // new one, and the old one may go before the page does.
+  void Watch(content::RenderFrameHost* host);
+  void Unwatch();
+
+  raw_ptr<content::RenderWidgetHost> watched_ = nullptr;
+  base::TimeTicks down_;
+  base::TimeTicks up_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_PRESS_H_
