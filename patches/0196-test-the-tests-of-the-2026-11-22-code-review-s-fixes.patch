+  EXPECT_EQ("kept", content::EvalJs(page, R"(
+      (() => {
+        // The step taller than its room, as the import step is under a long
+        // Arc block. The rule is in the page's head, which a redraw keeps.
+        const style = document.createElement('style');
+        style.textContent = 'main { max-height: 120px; }';
+        document.head.append(style);
+        const main = document.querySelector('main');
+        main.scrollTop = main.scrollHeight;
+        const before = main.scrollTop;
+        if (before <= 0) {
+          return 'the step does not scroll';
+        }
+        // Outside the step, as the import step hands the focus to the
+        // footer while its import runs.
+        document.querySelector('footer [data-focus="next"]').focus();
+        steddingWelcomeTest.applyBehaviour({});
+        const after = document.querySelector('main').scrollTop;
+        return Math.abs(after - before) < 1
+            ? 'kept'
+            : `scrolled from ${before} to ${after}`;
+      })())"));
