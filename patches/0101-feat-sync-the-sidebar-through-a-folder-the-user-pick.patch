+State& State::operator=(State&& other) = default;
+State::~State() = default;
+
+const Record* State::FindAlive(const std::string& id) const {
+  const auto it = records.find(id);
+  return it != records.end() && it->second.Alive() ? &it->second : nullptr;
+}
+
+int64_t State::MaxTime() const {
+  int64_t max = std::numeric_limits<int64_t>::min();
+  for (const auto& [id, record] : records) {
+    for (const auto& [name, field] : record.f) {
+      max = std::max(max, field.s.t);
+    }
+    if (record.del) {
+      max = std::max(max, record.del->t);
+    }
+  }
+  for (const auto& [id, list] : lists) {
+    max = std::max(max, list.s.t);
+  }
+  return max;
+}
+
+std::vector<std::string> State::ChildrenOf(const std::string& container) const {
+  std::set<std::string> members;
+  for (const auto& [id, record] : records) {
+    if (record.Alive() && record.Get(kFieldParent) == container) {
+      members.insert(id);
+    }
+  }
+  std::vector<std::string> out;
+  if (const auto it = lists.find(container); it != lists.end()) {
+    for (const std::string& id : it->second.order) {
+      if (members.erase(id)) {
+        out.push_back(id);
+      }
+    }
+  }
+  out.insert(out.end(), members.begin(), members.end());
+  return out;
+}
+
+size_t State::AliveTabCount() const {
+  return static_cast<size_t>(
+      std::ranges::count_if(records, [](const auto& entry) {
+        return entry.second.kind == Kind::kTab && entry.second.Alive();
+      }));
+}
