+  // A window's session brings back a Space that names the jar (S2), and then
+  // the popup's page goes.
+  RegistryEntry back(SpaceId::GenerateNew(), "Back", kBlueB16);
+  back.profile_id = jar;
+  back.isolated = true;
+  registry().AddExisting(back);
+  popup->GetTabStripModel()->CloseAllTabs();
+
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return prefs->GetList(stedding::prefs::kPendingJarWipes).empty();
+  })) << "the wipe never ended";
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(WasWiped(ConfigFor(jar), url))
+      << "the Blank Window wiped a jar a Space names";
+  blank->GetTabStripModel()->CloseAllTabs();
+}
