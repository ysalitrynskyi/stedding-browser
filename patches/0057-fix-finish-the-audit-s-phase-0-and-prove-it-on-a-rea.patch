+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/screenshot/screenshot_file.h"
+
+#include <string>
+
+#include "base/files/file.h"
+#include "base/files/file_util.h"
+#include "base/i18n/file_util_icu.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/stringprintf.h"
+#include "base/time/time.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+base::FilePath ScreenshotFileName(const GURL& url, const base::Time& when) {
+  std::string host(url.host());
+  if (host.empty()) {
+    host = "page";
+  }
+  // The host is the one part of the name a page chooses. An IPv6 literal
+  // ("[::1]") has colons, which Windows refuses in a file name and macOS
+  // shows as slashes.
+  base::FilePath::StringType safe_host =
+      base::FilePath::FromUTF8Unsafe(host).value();
+  base::i18n::ReplaceIllegalCharactersInPath(&safe_host, '_');
+  // Local time, spelled out: upstream removed the pattern formatter (M155).
+  base::Time::Exploded local;
+  when.LocalExplode(&local);
+  const std::string stamp = base::StringPrintf(
+      "%04d-%02d-%02d %02d.%02d.%02d", local.year, local.month,
+      local.day_of_month, local.hour, local.minute, local.second);
+  return base::FilePath(
+      base::FilePath::FromUTF8Unsafe("Stedding ").value() + safe_host +
+      base::FilePath::FromUTF8Unsafe(" " + stamp + ".png").value());
+}
+
+base::FilePath WriteNewScreenshotFile(const base::FilePath& directory,
+                                      const base::FilePath& name,
+                                      base::span<const uint8_t> png) {
+  if (!base::CreateDirectory(directory)) {
+    return base::FilePath();
+  }
+  for (int attempt = 1; attempt <= kScreenshotNameAttempts; ++attempt) {
+    const base::FilePath path = directory.Append(
+        attempt == 1 ? name
+                     : name.InsertBeforeExtensionASCII(
+                           " " + base::NumberToString(attempt)));
+    // FLAG_CREATE fails when the file exists, so taking a name and writing
+    // to it are one step: no other capture, in this process or another, can
+    // take the name between a check and the write.
+    base::File file(path, base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+    if (!file.IsValid()) {
+      if (file.error_details() == base::File::FILE_ERROR_EXISTS) {
+        continue;
+      }
+      return base::FilePath();
+    }
+    if (!file.WriteAtCurrentPosAndCheck(png)) {
+      // A half-written picture is worse than none.
+      file.Close();
+      base::DeleteFile(path);
+      return base::FilePath();
+    }
+    return path;
+  }
+  // Every name is taken. Fail rather than replace someone's file, as the
+  // 100th capture in one second used to.
+  return base::FilePath();
+}
+
+}  // namespace stedding
