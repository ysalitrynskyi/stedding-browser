+void UnpinnedTabContainerView::PaintSeparators(const views::PaintInfo& info) {
+  std::vector<gfx::Rect> lines;
+  for (views::View* const child : children()) {
+    const auto* const row = views::AsViewClass<TabView>(child);
+    // A dragged row's line waits for the drop: drawn above the row at the
+    // pointer, it would cross the row there.
+    if (!row || !row->GetVisible() || !row->separator_above() ||
+        row->height() == 0 || GetVisualDataForDraggedView(*child)) {
+      continue;
+    }
+    // On the rows' favicon column at either end, half the band up, as thin
+    // and faint as the Clear line (sidebar Y27).
+    constexpr int kInset = 8;
+    lines.emplace_back(row->x() + kInset,
+                       row->y() - (TabView::kSeparatorBand + 1) / 2,
+                       std::max(0, row->width() - 2 * kInset), 1);
+  }
+  if (lines.empty()) {
+    return;
+  }
+  ui::PaintRecorder recorder(info.context(), size());
+  const ui::ColorProvider* const provider = GetColorProvider();
+  const SkColor text =
+      provider ? provider->GetColor(kColorTabForegroundInactiveFrameActive)
+               : SK_ColorWHITE;
+  cc::PaintFlags flags;
+  flags.setColor(SkColorSetA(text, stedding::kSidebarQuietLineAlpha));
+  for (const gfx::Rect& line : lines) {
+    recorder.canvas()->DrawRect(line, flags);
+  }
+}
+
 void UnpinnedTabContainerView::PaintChildren(const views::PaintInfo& info) {
   TabCollectionZOrderManager::PaintChildren(info);
+  PaintSeparators(info);
   if (!row_drop_indicator_y_) {
     return;
   }
