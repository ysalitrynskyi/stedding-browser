+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space.h"
+
+#include <utility>
+
+namespace spaces {
+
+Space::Space(SpaceId id, std::string name, SkColor color)
+    : id_(id), name_(std::move(name)), color_(color) {}
+
+Space::~Space() = default;
+
+void Space::SetName(std::string name) {
+  name_ = std::move(name);
+}
+
+void Space::SetColor(SkColor color) {
+  color_ = color;
+}
+
+void Space::SetParkedTabs(std::unique_ptr<tabs::TabStripCollection> parked) {
+  CHECK(parked);
+  CHECK(!parked_tabs_) << "Space " << name_ << " already holds a parked tree";
+  parked_tabs_ = std::move(parked);
+}
+
+std::unique_ptr<tabs::TabStripCollection> Space::TakeParkedTabs() {
+  CHECK(parked_tabs_) << "Space " << name_ << " is already active";
+  return std::move(parked_tabs_);
+}
+
+}  // namespace spaces
diff --git a/chrome/browser/ui/spaces/space.h b/chrome/browser/ui/spaces/space.h
new file mode 100644
index 0000000000000..818181de57bf0
--- /dev/null
+++ b/chrome/browser/ui/spaces/space.h
@@ -0,0 +1,71 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_H_
+
+#include <memory>
+#include <string>
+
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "components/tabs/public/tab_strip_collection.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace spaces {
+
+// One Space: a named set of tabs the user switches between, with its own pinned
+// tabs, groups, folders and splits.
+//
+// A Space is in exactly one of two states.
+//
+//   Active   — its tabs live in the window's own TabStripModel, and
+//              parked_tabs() is null. Exactly one Space per window is active.
+//   Inactive — it owns a parked TabStripCollection holding its whole tab tree.
+//              The tabs and their WebContents stay alive; they are simply not
+//              in the window's tab strip.
+//
+// Switching moves the tree between those two homes with the existing
+// detach-and-insert APIs, so pinned state, groups, folders and splits survive
+// intact rather than being flattened and rebuilt.
+class Space {
+ public:
+  Space(SpaceId id, std::string name, SkColor color);
+  ~Space();
+  Space(const Space&) = delete;
+  Space& operator=(const Space&) = delete;
+
+  const SpaceId& id() const { return id_; }
+
+  const std::string& name() const { return name_; }
+  void SetName(std::string name);
+
+  SkColor color() const { return color_; }
+  void SetColor(SkColor color);
+
+  // Null while this Space is the active one. See the class comment.
+  tabs::TabStripCollection* parked_tabs() { return parked_tabs_.get(); }
+  const tabs::TabStripCollection* parked_tabs() const {
+    return parked_tabs_.get();
+  }
+
+  bool is_active() const { return parked_tabs_ == nullptr; }
+
+  // Takes ownership of this Space's tab tree while it is not the active Space.
+  void SetParkedTabs(std::unique_ptr<tabs::TabStripCollection> parked);
+
+  // Relinquishes the parked tree, leaving this Space active.
+  std::unique_ptr<tabs::TabStripCollection> TakeParkedTabs();
+
+ private:
+  const SpaceId id_;
+  std::string name_;
+  SkColor color_;
+
+  // Held only while inactive.
+  std::unique_ptr<tabs::TabStripCollection> parked_tabs_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_H_
