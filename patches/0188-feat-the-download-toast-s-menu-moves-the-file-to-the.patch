+bool IsStillTheDownloadsFile(const DownloadedFile& file) {
+  base::File::Info info;
+  if (file.path.empty() || !base::GetFileInfo(file.path, &info) ||
+      info.is_directory) {
+    return false;
+  }
+  if (file.size >= 0 && info.size != file.size) {
+    return false;
+  }
+  return file.finished.is_null() ||
+         info.last_modified <= file.finished + kModifiedSlack;
+}
