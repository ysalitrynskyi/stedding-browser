+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_EXTENSION_KEYWORD_H_
+#define CHROME_BROWSER_UI_STEDDING_EXTENSION_KEYWORD_H_
+
+#include <string>
+
+enum class WindowOpenDisposition;
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+
+namespace stedding {
+
+// docs/features/commandbar.md K18 (BACKLOG S-352): "keyword query" typed in
+// the command bar for an extension's omnibox keyword goes to that extension,
+// as it does from the address field. The extensions' omnibox API sets the
+// handler when it starts; the bar cannot depend on the extensions' code,
+// which depends on the bar. A target of its own, with no dependencies, so
+// both can.
+struct ExtensionKeywordHandler {
+  // Whether the extension may hear a query typed in `context`: an enabled
+  // extension, and in a private window one allowed there.
+  bool (*can_hand_over)(content::BrowserContext* context,
+                        const std::string& extension_id) = nullptr;
+  // chrome.omnibox.onInputEntered, with the page the bar was opened over.
+  void (*hand_over)(content::WebContents* web_contents,
+                    const std::string& extension_id,
+                    const std::string& input,
+                    WindowOpenDisposition disposition) = nullptr;
+};
+
+void SetExtensionKeywordHandler(const ExtensionKeywordHandler& handler);
+
+// Null until the omnibox API has set a whole handler.
+const ExtensionKeywordHandler* GetExtensionKeywordHandler();
