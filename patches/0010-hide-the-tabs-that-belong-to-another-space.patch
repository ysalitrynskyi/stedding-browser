+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_TAB_VISIBILITY_CONTROLLER_H_
+#define CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_TAB_VISIBILITY_CONTROLLER_H_
+
+#include "base/memory/raw_ref.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+
+class TabStripModel;
+
+namespace views {
+class View;
+}  // namespace views
+
+namespace spaces {
+
+// Hides the tab views that belong to a Space other than the active one.
+//
+// This is the view half of ADR 0015. Every tab stays in the tab strip model;
+// only its view is hidden, exactly as a collapsed tab group hides its tabs with
+// SetVisible(). Layout follows automatically, because every tab container
+// already skips children that `views::LayoutManagerBase::CanBeVisible()` says
+// no to, and that in turn reflects SetVisible() calls from outside layout.
+class SpaceTabVisibilityController : public SpaceModel::Observer {
+ public:
+  // `tab_strip_root` is the view whose descendants are the tab views. All three
+  // outlive this object, which is owned by the tab strip region view.
+  SpaceTabVisibilityController(SpaceModel& model,
+                               TabStripModel& tab_strip_model,
+                               views::View& tab_strip_root);
+  SpaceTabVisibilityController(const SpaceTabVisibilityController&) = delete;
+  SpaceTabVisibilityController& operator=(const SpaceTabVisibilityController&) =
+      delete;
+  ~SpaceTabVisibilityController() override;
+
+  // Applies the active Space to every tab view. Safe to call at any time; call
+  // it after tabs are added or moved.
+  void UpdateTabVisibility();
+
+  // SpaceModel::Observer:
+  void OnActiveSpaceChanged(const SpaceId& from, const SpaceId& to) override;
+  void OnSpaceRemoved(const SpaceId& id) override;
+
+ private:
+  void UpdateSubtree(views::View& parent);
+
+  const raw_ref<SpaceModel> model_;
+  const raw_ref<TabStripModel> tab_strip_model_;
+  const raw_ref<views::View> tab_strip_root_;
+  base::ScopedObservation<SpaceModel, SpaceModel::Observer> observation_{this};
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_TAB_VISIBILITY_CONTROLLER_H_
