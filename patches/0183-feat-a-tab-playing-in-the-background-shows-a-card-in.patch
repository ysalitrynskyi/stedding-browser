+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/audio_strip.h"
+
+#include <optional>
+#include <vector>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+// A tab in the background that plays, took play and pause, and started
+// `started`-th.
+AudioStripTab Playing(int id, uint64_t started) {
+  AudioStripTab tab;
+  tab.id = id;
+  tab.controllable = true;
+  tab.playing = true;
+  tab.started = started;
+  return tab;
+}
+
+std::optional<int> Choose(const std::vector<AudioStripTab>& tabs,
+                          std::optional<int> shown) {
+  return ChooseAudioStripTab(tabs, shown);
+}
+
+// docs/features/player.md Mp3: no tab plays, no card; one does, its card.
+TEST(AudioStripRulesTest, APlayingTabInTheBackgroundHasTheCard) {
+  EXPECT_EQ(std::nullopt, Choose({}, std::nullopt));
+  AudioStripTab quiet = Playing(1, 0);
+  quiet.playing = false;
+  EXPECT_EQ(std::nullopt, Choose({quiet}, std::nullopt));
+  EXPECT_EQ(2, Choose({quiet, Playing(2, 1)}, std::nullopt));
+}
+
+// Mp3: a tab on screen, muted, popped out, stopped, or out of reach of play
+// and pause has no card.
+TEST(AudioStripRulesTest, NoCardForATabOnScreenMutedOrOutOfReach) {
+  AudioStripTab tab = Playing(1, 1);
+  tab.on_screen = true;
+  EXPECT_EQ(std::nullopt, Choose({tab}, std::nullopt)) << "on screen";
+  tab = Playing(1, 1);
+  tab.muted = true;
+  EXPECT_EQ(std::nullopt, Choose({tab}, std::nullopt)) << "muted";
+  tab = Playing(1, 1);
+  tab.popped_out = true;
+  EXPECT_EQ(std::nullopt, Choose({tab}, std::nullopt)) << "popped out";
+  tab = Playing(1, 1);
+  tab.stopped = true;
+  EXPECT_EQ(std::nullopt, Choose({tab}, std::nullopt)) << "stopped";
+  tab = Playing(1, 1);
+  tab.controllable = false;
+  EXPECT_EQ(std::nullopt, Choose({tab}, std::nullopt)) << "no play and pause";
+}
+
+// Mp7: the newest player takes the card.
+TEST(AudioStripRulesTest, TheNewestPlayerTakesTheCard) {
+  EXPECT_EQ(
+      3, Choose({Playing(1, 4), Playing(3, 9), Playing(2, 6)}, std::nullopt));
+  EXPECT_EQ(3, Choose({Playing(1, 4), Playing(3, 9)}, 1))
+      << "a card that plays does not keep the card from a newer player";
+}
+
+// Mp7: a paused tab keeps the card it has, and no other paused tab gets one.
+TEST(AudioStripRulesTest, APausedCardStaysUntilShownOrStopped) {
+  AudioStripTab paused = Playing(1, 5);
+  paused.playing = false;
+  EXPECT_EQ(1, Choose({paused}, 1));
+  EXPECT_EQ(std::nullopt, Choose({paused}, std::nullopt))
+      << "a tab left paused gets no card";
+  EXPECT_EQ(1, Choose({paused, Playing(2, 3)}, 1))
+      << "an older player does not take a paused card";
+  EXPECT_EQ(2, Choose({paused, Playing(2, 7)}, 1)) << "a newer player does";
+  paused.on_screen = true;
+  EXPECT_EQ(std::nullopt, Choose({paused}, 1)) << "shown, the card goes";
+  paused.on_screen = false;
+  paused.stopped = true;
+  EXPECT_EQ(std::nullopt, Choose({paused}, 1)) << "stopped, the card goes";
+}
+
+// Mp3: hundreds of tabs, one card, the newest player's.
+TEST(AudioStripRulesTest, HundredsOfTabsShowOneCard) {
+  std::vector<AudioStripTab> tabs;
+  for (int i = 1; i <= 400; ++i) {
+    AudioStripTab tab = Playing(i, static_cast<uint64_t>(i));
+    tab.playing = i % 3 == 0;
+    tabs.push_back(tab);
+  }
+  EXPECT_EQ(399, Choose(tabs, std::nullopt));
+}
+
+}  // namespace
+}  // namespace stedding
