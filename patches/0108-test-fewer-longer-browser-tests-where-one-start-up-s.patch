+IN_PROC_BROWSER_TEST_F(RestoreTest,
+                       APopupSavedFirstLeavesTheBrowserWindowToJoin) {
+  ASSERT_EQ(1u, GetAllBrowserWindowInterfaces().size());
+  BrowserWindowInterface* const open = browser();
+  const auto holds = [](BrowserWindowInterface* window,
+                        const std::string& host) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      content::WebContents* const contents = strip->GetWebContentsAt(i);
+      const content::NavigationEntry* const entry =
+          contents->GetController().GetLastCommittedEntry();
+      if ((entry ? entry->GetURL() : contents->GetVisibleURL()).host() ==
+          host) {
+        return true;
+      }
+    }
+    return false;
+  };
+  TabStripModel* const open_tabs = open->GetTabStripModel();
+  while (open_tabs->count() > 1) {
+    open_tabs->CloseWebContentsAt(open_tabs->count() - 1,
+                                  TabCloseTypes::CLOSE_NONE);
+  }
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(open, GURL(chrome::kChromeUINewTabURL)));
+  SessionRestore::RestoreSessionAfterCrash(open);
