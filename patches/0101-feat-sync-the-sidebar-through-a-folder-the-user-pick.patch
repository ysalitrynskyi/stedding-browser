+namespace spaces::sidebar_sync {
+
+struct ApplyOutcome {
+  ApplyOutcome();
+  ApplyOutcome(const ApplyOutcome& other);
+  ApplyOutcome& operator=(const ApplyOutcome& other);
+  ~ApplyOutcome();
+
+  size_t applied = 0;
+  // Sf21, Sf25: changes to the tab the user is on, which wait until they
+  // leave it.
+  size_t deferred = 0;
+  // Sf25: pins whose move would reload a loaded page into another session.
+  std::vector<std::string> held_moves;
+  // Sf24: Spaces whose own session changed on another computer.
+  std::vector<std::string> isolation_questions;
+  // Sf14: no window takes part; everything waits in the ledger.
+  bool no_window = false;
+};
+
+// docs/features/sidebar-file.md Sf14, Sf17, Sf21, Sf23-Sf25: brings the
+// windows of `profile` in line with the ledger, in one pass, with routing
+// paused: Spaces added, renamed, recoloured, reordered, or deleted once the
+// user said so; pins, folders and essentials another computer added
+// inserted unloaded, in the window that holds their Space, never activated;
+// homes, names and places changed; and what another computer removed taken
+// out -- into Recently Closed when sync put it here and it was never
+// opened, else left open as an ordinary tab. Nothing changes the tab a
+// window shows. `move_now` are pins whose held move the user allowed.
+ApplyOutcome ApplyToWindows(Profile* profile,
+                            Ledger& ledger,
+                            const std::map<std::string, std::string>& resolved,
+                            const std::set<std::string>& move_now);
+
+// Sf20: inserts the synced pins and essentials that are in no window here
+// into `profile`'s last-active registry window. The number inserted.
+size_t BringSyncedItemsHere(Profile* profile,
+                            Ledger& ledger,
+                            const std::map<std::string, std::string>& resolved);
+
+// Sf20: how many alive synced pins and essentials are in no window here.
+size_t CountSyncedItemsNotHere(
+    Profile* profile,
+    const Ledger& ledger,
+    const std::map<std::string, std::string>& resolved);
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_APPLY_H_
