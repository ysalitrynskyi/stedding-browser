+
+constexpr char16_t kRouteHere[] = u"Route sites here…";
+constexpr char16_t kSortNow[] = u"Sort open tabs by these rules now";
+
+// `body`, run on the settings page with `pick(selector)`, through every shadow
+// root.
+std::string OnThePage(std::string_view body) {
+  return base::StrCat({R"(
+    (() => {
+      const find = (root, selector) => {
+        const hit = root.querySelector(selector);
+        if (hit) {
+          return hit;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot, selector);
+            if (found) {
+              return found;
+            }
+          }
+        }
+        return null;
+      };
+      const pick = selector => find(document, selector);
+  )",
+                       body, "\n    })()"});
+}
+
+class RoutesMenuTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    model_ = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model_);
+    work_ = model_->AddSpace("Work", SK_ColorBLUE)->id();
+  }
+
+  void TearDownOnMainThread() override {
+    model_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+
+  ui::SimpleMenuModel* MenuFor(BrowserWindowInterface* window,
+                               const spaces::SpaceId& id) {
+    views::Widget* const widget =
+        BrowserView::GetBrowserViewForBrowser(window)->GetWidget();
+    spaces::SpaceSwitcherView* const switcher =
+        stedding::test::FindView<spaces::SpaceSwitcherView>(
+            widget->GetRootView());
+    return switcher ? switcher->BuildMenuForTesting(id) : nullptr;
+  }
+
+  static std::optional<size_t> RowOf(ui::SimpleMenuModel* menu,
+                                     const std::u16string& label) {
+    for (size_t i = 0; menu && i < menu->GetItemCount(); ++i) {
+      if (menu->GetLabelAt(i) == label) {
+        return i;
+      }
+    }
+    return std::nullopt;
+  }
+
+  tabs::TabInterface* OpenSite(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs().GetActiveTab();
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  std::optional<spaces::SpaceId> work_;
+};
+
+// routing D15: "Route sites here…" opens the list on that Space: the card in
+// view, the Space chosen in the add row, the field focused.
+IN_PROC_BROWSER_TEST_F(RoutesMenuTest, RouteSitesHereOpensTheListOnThatSpace) {
+  ui::SimpleMenuModel* const menu = MenuFor(browser(), *work_);
+  ASSERT_TRUE(menu) << "the sidebar has no Space switcher";
+  const std::optional<size_t> row = RowOf(menu, kRouteHere);
+  ASSERT_TRUE(row) << "the Space menu has no row for it";
+  ASSERT_TRUE(menu->IsEnabledAt(*row));
+  menu->ActivatedAt(*row);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return tabs().GetActiveWebContents()->GetVisibleURL().host() == "settings";
+  }));
+  content::WebContents* const page = tabs().GetActiveWebContents();
+  EXPECT_EQ("/stedding", page->GetVisibleURL().path());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnThePage(content::JsReplace(R"(
+        const card = pick('settings-stedding-routes-card');
+        if (!card) {
+          return false;
+        }
+        const space = card.shadowRoot.querySelector('#addSpace');
+        const field = card.shadowRoot.querySelector('#addText');
+        const box = card.getBoundingClientRect();
+        return !!space && space.value === $1 &&
+            card.shadowRoot.activeElement === field &&
+            box.top < window.innerHeight && box.bottom > 0;)",
+                                                              work_->ToString())))
+        .ExtractBool();
+  })) << "the card is not on that Space with its field focused";
+}
+
+// settings T57: a card named in the address is the one shown, which the
+// command bar and the page after an import go by.
+IN_PROC_BROWSER_TEST_F(RoutesMenuTest, ACardNamedInTheAddressIsShown) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://settings/stedding?card=sync")));
+  content::WebContents* const page = tabs().GetActiveWebContents();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnThePage(R"(
+        const card = pick('#syncSection');
+        if (!card) {
+          return false;
+        }
+        const box = card.getBoundingClientRect();
+        return box.top < window.innerHeight && box.bottom > 0;)"))
+        .ExtractBool();
+  })) << "the card named was not scrolled to";
+}
+
+// routing D16: the row moves what the rules name and is enabled only with
+// something to move.
+IN_PROC_BROWSER_TEST_F(RoutesMenuTest, TheSortRowMovesTheOpenTabs) {
+  const spaces::SpaceId home = model_->active_id();
+  tabs::TabInterface* const routed = OpenSite("a.test");
+  tabs::TabInterface* const other = OpenSite("b.test");
+  {
+    ui::SimpleMenuModel* const menu = MenuFor(browser(), home);
+    const std::optional<size_t> row = RowOf(menu, kSortNow);
+    ASSERT_TRUE(row) << "the Space menu has no row for it";
+    EXPECT_FALSE(menu->IsEnabledAt(*row)) << "no rule, nothing to move";
+    EXPECT_EQ(u"Nothing to move", menu->GetMinorTextAt(*row));
+  }
+  spaces::AddRoute(
+      browser()->GetProfile()->GetPrefs(),
+      spaces::SiteRouteFor(GURL("https://a.test/"), work_->ToString()));
+  EXPECT_EQ(home, model_->SpaceForTab(routed)) << "a rule moves nothing alone";
+  ui::SimpleMenuModel* const menu = MenuFor(browser(), home);
+  const std::optional<size_t> row = RowOf(menu, kSortNow);
+  ASSERT_TRUE(row);
+  ASSERT_TRUE(menu->IsEnabledAt(*row));
+  menu->ActivatedAt(*row);
+  EXPECT_EQ(*work_, model_->SpaceForTab(routed));
+  EXPECT_EQ(home, model_->SpaceForTab(other));
+  EXPECT_EQ(home, model_->active_id()) << "the window stays where it is";
+}
+
+// routing D15, D16: no route moves a tab into a Blank Window, so its menu
+// offers neither row.
+IN_PROC_BROWSER_TEST_F(RoutesMenuTest, ABlankWindowsMenuHasNeitherRow) {
+  ASSERT_TRUE(MenuFor(browser(), *work_));
+  EXPECT_TRUE(RowOf(MenuFor(browser(), *work_), kRouteHere));
+  ui_test_utils::BrowserCreatedObserver created;
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_NEW_BLANK_WINDOW);
+  BrowserWindowInterface* const blank = created.Wait();
+  ASSERT_TRUE(blank);
+  spaces::SpaceModel* const blank_model = spaces::SpaceModel::From(blank);
+  ASSERT_TRUE(blank_model);
+  ui::SimpleMenuModel* const menu = MenuFor(blank, blank_model->active_id());
+  ASSERT_TRUE(menu);
+  EXPECT_FALSE(RowOf(menu, kRouteHere));
+  EXPECT_FALSE(RowOf(menu, kSortNow));
+}
