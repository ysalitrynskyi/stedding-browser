+void WalkBookmarks(const base::DictValue& node,
+                   const std::vector<std::u16string>& path,
+                   bool in_toolbar,
+                   bool is_root,
+                   std::vector<user_data_importer::ImportedBookmarkEntry>* out) {
+  const std::string* const type = node.FindString("type");
+  if (!type) {
+    return;
+  }
+  const std::string* const name = node.FindString("name");
+  const std::u16string title =
+      name ? base::UTF8ToUTF16(*name) : std::u16string();
+  if (*type == "url") {
+    const std::string* const url_text = node.FindString("url");
+    const GURL url(url_text ? *url_text : std::string());
+    if (!url.is_valid()) {
+      return;
+    }
+    user_data_importer::ImportedBookmarkEntry entry;
+    entry.in_toolbar = in_toolbar;
+    entry.is_folder = false;
+    entry.url = url;
+    entry.title = title;
+    entry.path = path;
+    out->push_back(std::move(entry));
+    return;
+  }
+  if (*type != "folder") {
+    return;
+  }
+  const base::ListValue* const children = node.FindList("children");
+  if (!children) {
+    return;
+  }
+  std::vector<std::u16string> child_path = path;
+  if (!is_root && !title.empty()) {
+    child_path.push_back(title);
+  }
+  for (const base::Value& child : *children) {
+    if (const base::DictValue* const dict = child.GetIfDict()) {
+      WalkBookmarks(*dict, child_path, in_toolbar, /*is_root=*/false, out);
+    }
+  }
+}
+
+std::vector<user_data_importer::ImportedBookmarkEntry> ReadBookmarks(
+    const base::FilePath& path) {
+  std::vector<user_data_importer::ImportedBookmarkEntry> out;
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return out;
+  }
+  const std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return out;
+  }
+  const base::DictValue* const roots = parsed->GetDict().FindDict("roots");
+  if (!roots) {
+    return out;
+  }
+  if (const base::DictValue* const bar = roots->FindDict("bookmark_bar")) {
+    WalkBookmarks(*bar, {}, /*in_toolbar=*/true, /*is_root=*/true, &out);
+  }
+  if (const base::DictValue* const other = roots->FindDict("other")) {
+    WalkBookmarks(*other, {}, /*in_toolbar=*/false, /*is_root=*/true, &out);
+  }
+  if (const base::DictValue* const synced = roots->FindDict("synced")) {
+    WalkBookmarks(*synced, {}, /*in_toolbar=*/false, /*is_root=*/true, &out);
+  }
+  return out;
+}
+
+std::vector<password_manager::PasswordForm> ReadLogins(
+    const base::FilePath& path,
+    std::string_view safe_storage_password) {
+  std::vector<password_manager::PasswordForm> forms;
+  if (safe_storage_password.empty() || !base::PathExists(path)) {
+    return forms;
+  }
+  const std::vector<uint8_t> key =
+      spaces::DeriveArcKey(safe_storage_password);
+  sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                   sql::Database::Tag("Passwords"));
+  if (!db.Open(path)) {
+    return forms;
+  }
+  sql::Statement statement(db.GetUniqueStatement(
+      "SELECT origin_url, username_value, password_value, signon_realm, "
+      "blacklisted_by_user FROM logins"));
+  while (statement.Step()) {
+    if (statement.ColumnInt(4) != 0) {
+      continue;
+    }
+    password_manager::PasswordForm form;
+    form.url = GURL(statement.ColumnString(0));
+    if (!form.url.is_valid()) {
+      continue;
+    }
+    form.username_value = statement.ColumnString16(1);
+    form.signon_realm = statement.ColumnString(3);
+    if (form.signon_realm.empty()) {
+      form.signon_realm = form.url.DeprecatedGetOriginAsURL().spec();
+    }
+    const std::optional<std::u16string> password =
+        spaces::DecryptArcValue(statement.ColumnBlob(2), key);
+    if (!password || password->empty()) {
+      continue;
+    }
+    form.password_value =
+        password_manager::PasswordString(std::u16string(*password));
+    form.in_store = password_manager::PasswordForm::Store::kProfileStore;
+    forms.push_back(std::move(form));
+  }
+  return forms;
+}
+
+bool ProfileDirHasData(const base::FilePath& dir) {
+  return base::PathExists(dir.AppendASCII("Bookmarks")) ||
+         base::PathExists(dir.AppendASCII("History")) ||
+         base::PathExists(dir.AppendASCII("Login Data"));
+}
+
+std::string ProfileDisplayName(const base::FilePath& user_data,
+                               const std::string& dir_name) {
+  std::string json;
+  if (!base::ReadFileToString(user_data.AppendASCII("Local State"), &json)) {
+    return dir_name;
+  }
+  const std::optional<base::Value> parsed =
+      base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return dir_name;
+  }
+  const base::DictValue* const profile = parsed->GetDict().FindDict("profile");
+  const base::DictValue* const cache =
+      profile ? profile->FindDict("info_cache") : nullptr;
+  const base::DictValue* const info = cache ? cache->FindDict(dir_name) : nullptr;
+  if (const std::string* const name = info ? info->FindString("name") : nullptr;
+      name && !name->empty()) {
+    return *name;
+  }
+  return dir_name;
+}
+
+void WriteOnUi(base::WeakPtr<Profile> profile,
+               uint16_t items,
+               base::OnceCallback<void(bool)> done,
+               ChromiumProfileContents contents) {
+  if (!profile) {
+    std::move(done).Run(false);
+    return;
+  }
+  bool wrote = false;
+  if ((items & user_data_importer::FAVORITES) && !contents.bookmarks.empty()) {
+    bookmarks::BookmarkModel* const model =
+        BookmarkModelFactory::GetForBrowserContext(profile.get());
+    if (model && model->loaded()) {
+      scoped_refptr<ProfileWriter> writer =
+          base::MakeRefCounted<ProfileWriter>(profile.get());
+      writer->AddBookmarks(contents.bookmarks, u"Imported");
+      wrote = true;
+    }
+  }
+  if ((items & user_data_importer::HISTORY) && !contents.history.empty()) {
+    if (history::HistoryService* const service =
+            HistoryServiceFactory::GetForProfile(
+                profile.get(), ServiceAccessType::EXPLICIT_ACCESS)) {
+      service->AddPagesWithDetails(contents.history, history::SOURCE_BROWSED);
+      wrote = true;
+    }
+  }
+  if ((items & user_data_importer::PASSWORDS) && !contents.logins.empty()) {
+    if (password_manager::PasswordStoreInterface* const store =
+            ProfilePasswordStoreFactory::GetForProfile(
+                profile.get(), ServiceAccessType::EXPLICIT_ACCESS)
+                .get()) {
+      for (password_manager::PasswordForm& form : contents.logins) {
+        store->AddLogin(password_manager::FromPasswordForm(form));
+      }
+      wrote = true;
+    }
+  }
+  const bool nothing_to_write = contents.bookmarks.empty() &&
+                                contents.history.empty() &&
+                                contents.logins.empty();
+  std::move(done).Run(wrote || nothing_to_write);
+}
