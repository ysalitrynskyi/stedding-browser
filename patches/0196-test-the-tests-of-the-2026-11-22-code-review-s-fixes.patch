+// P28-1d; tabs R59 (BACKLOG S-348): a parent moved alone to a new window and
+// closed there frees the child it left behind, which takes the parent's own
+// parent and nests under it at once. The close emptied that window's strip,
+// and the window was looked for through a tab left in it, so the child kept
+// the token of a tab that is gone.
+IN_PROC_BROWSER_TEST_F(ChildTabsW2B28Test,
+                       AParentAloneInItsWindowFreesItsChildAsItCloses) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  tabs::TabInterface* const grandchild = OpenLinkFrom(child, "c.test");
+  ASSERT_TRUE(grandchild);
+  ASSERT_EQ(28, Indent(grandchild));
+
+  chrome::MoveTabsToNewWindow(browser(), {tabs()->GetIndexOfTab(child)});
+  BrowserWindowInterface* const other = child->GetBrowserWindowInterface();
+  ASSERT_TRUE(other);
+  ASSERT_NE(static_cast<BrowserWindowInterface*>(browser()), other);
+  TabStripModel* const other_tabs = other->GetTabStripModel();
+  ASSERT_EQ(1, other_tabs->count()) << "the parent is not alone there";
+  ASSERT_EQ(stedding::TabToken(child->GetContents()),
+            stedding::TabParentToken(grandchild->GetContents()))
+      << "the move took the child's place from it (R57)";
+
+  // Its window's last tab: the window closes with it.
+  other_tabs->CloseWebContentsAt(0, TabCloseTypes::CLOSE_USER_GESTURE);
+  EXPECT_EQ(stedding::TabToken(page->GetContents()),
+            stedding::TabParentToken(grandchild->GetContents()))
+      << "the child kept the token of a tab that is gone";
+  EXPECT_EQ(14, Indent(grandchild)) << "it is not under its new parent";
+  EXPECT_TRUE(base::test::RunUntil(
+      []() { return GetAllBrowserWindowInterfaces().size() == 1u; }))
+      << "the emptied window stayed";
+}
