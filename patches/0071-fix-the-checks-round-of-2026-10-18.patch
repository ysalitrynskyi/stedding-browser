+  views::Widget* const widget = view()->GetWidget();
+  // The row takes its colour from what the page paints, and a window covered
+  // by another application's paints nothing.
+  stedding::test::KeepAboveOtherWindows(widget);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page));
+  const auto shows_the_page = [&]() {
+    return row->color() && stedding::PageColorsMatch(*row->color(), kPage);
+  };
