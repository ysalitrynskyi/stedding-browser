+// T31: what the page's top edge read as, kept on the page itself, so it goes
+// with the page: a new page in the tab starts with none, and a tab switched
+// back to has its own at once.
+class PageTopSample : public content::PageUserData<PageTopSample> {
+ public:
+  ~PageTopSample() override = default;
+
+  // The edge's colour, or nothing when the edge is not one colour.
+  std::optional<SkColor> color;
+
+ private:
+  explicit PageTopSample(content::Page& page) : PageUserData(page) {}
+
+  friend PageUserData;
+  PAGE_USER_DATA_KEY_DECL();
+};
+
+PAGE_USER_DATA_KEY_IMPL(PageTopSample);
+
+// When to read the page's top edge again: soon after a page shows, after it
+// finishes loading (and once more for pages that draw their header late),
+// and through a scroll and its momentum (a header that scrolls away leaves
+// the page's body at the top).
+constexpr base::TimeDelta kSampleAfterShown = base::Milliseconds(60);
+constexpr base::TimeDelta kSampleAfterPaint = base::Milliseconds(150);
