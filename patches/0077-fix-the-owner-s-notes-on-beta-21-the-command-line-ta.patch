+  }
+  bool StripAnimating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+
+  // `count` tabs whose titles are long enough to be cut short in the
+  // sidebar, so a row's layout does the work a person's rows ask of it.
+  void OpenTitledTabs(int count) {
+    for (int i = 0; i < count; ++i) {
+      ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+          browser(),
+          GURL(base::StrCat({"data:text/html,<title>A page with a long title "
+                             "that the sidebar cuts short, number ",
+                             base::NumberToString(i), "</title>"})),
+          WindowOpenDisposition::NEW_FOREGROUND_TAB,
+          ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    }
+  }
+
+  // A second, empty Space, so the sidebar draws its Space title row and the
+  // switcher's chips, as a window with Spaces does.
+  void AddASecondSpace() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model);
+    model->AddSpace("Two", SK_ColorBLUE);
+  }
+
+  // motion O5: of the hidden text fields a width animation could lay out --
+  // every row's rename field, the Space title row's, the switcher's -- only
+  // the switcher's is, at most once a frame: its fill layout sizes the field
+  // with the row of chips it swaps for.
+  void ExpectNoHiddenFieldLaidOut(const FrameMeter& meter) {
+    EXPECT_LE(meter.LaidOut("Textfield"), meter.commits())
+        << "hidden rename fields were laid out at every frame";
+  }
+
+  // Runs until `done` holds, and then three more of the compositor's frames,
+  // so the frame that draws the end is measured too (never by the clock).
+  [[nodiscard]] bool RunUntilSettled(FrameMeter& meter,
+                                     base::RepeatingCallback<bool()> done) {
+    int done_at = -1;
+    return base::test::RunUntil([&]() {
+      if (!done.Run()) {
+        done_at = -1;
+        return false;
+      }
+      if (done_at < 0) {
+        done_at = meter.steps();
+      }
+      return meter.steps() >= done_at + 3;
+    });
+  }
+
+  // Runs `count` of the compositor's frames.
+  [[nodiscard]] bool RunFrames(FrameMeter& meter, int count) {
+    const int until = meter.steps() + count;
+    return base::test::RunUntil([&]() { return meter.steps() >= until; });
+  }
+
+  ui::MouseEvent MouseEvent(ui::EventType type, views::View* view) {
+    const gfx::Point centre = view->GetLocalBounds().CenterPoint();
+    return ui::MouseEvent(type, centre, centre, base::TimeTicks::Now(),
+                          ui::EF_NONE, ui::EF_NONE);
+  }
+
+  void Log(const FrameMeter& meter, std::string_view name) {
+    LOG(INFO) << meter.Summary(name);
+  }
+
+  LocationBarView* location_bar() {
+    return browser_view()->GetLocationBarView();
+  }
+
+  // The omnibox's popup windows (its results dropdown and the AI mode one),
+  // which the window keeps, hidden, between their shows; or the one showing.
+  // They are the window's owned widgets: on Windows a popup's aura window is
+  // a child of the root window and only owned by the browser's (a transient
+  // child), so the browser window's child widgets never include it.
+  std::vector<views::Widget*> OmniboxPopups(bool showing) {
+    std::vector<views::Widget*> popups;
+    for (views::Widget* const child :
+         views::Widget::GetAllOwnedWidgets(widget()->GetNativeView())) {
+      if (child != widget() && child->IsVisible() == showing &&
+          child->GetNativeWindowProperty(views::kWidgetIdentifierKey) ==
+              omnibox::kOmniboxWebUIPopupWidgetId) {
+        popups.push_back(child);
+      }
+    }
+    return popups;
+  }
+  views::Widget* Dropdown() {
+    const std::vector<views::Widget*> showing = OmniboxPopups(true);
+    return showing.empty() ? nullptr : showing.front();
+  }
+
+  // The bounds a popup's window takes for the location bar as it is now
+  // (OmniboxPopupPresenterBase::SynchronizePopupBounds): the field's span
+  // across and its top, with the frame's alignment and shadow insets around
+  // them. The height follows the popup's content.
+  gfx::Rect FieldSpan() {
+    gfx::Rect span = location_bar()->GetBoundsInScreen();
+    span.Inset(-RoundedOmniboxResultsFrame::GetLocationBarAlignmentInsets());
+    span.Inset(-RoundedOmniboxResultsFrame::GetShadowInsets());
+    return span;
+  }
+  bool AlignedToTheField(views::Widget* popup) {
+    const gfx::Rect bounds = popup->GetWindowBoundsInScreen();
+    const gfx::Rect span = FieldSpan();
+    return bounds.x() == span.x() && bounds.y() == span.y() &&
+           bounds.width() == span.width();
+  }
+  std::string Describe(views::Widget* popup) {
+    return base::StrCat({"the popup at ",
+                         popup->GetWindowBoundsInScreen().ToString(),
+                         ", the field's span at ", FieldSpan().ToString()});
+  }
+
+  // The width the open dropdown's page lays itself out at, once it is the
+  // field's (the popup's content width), or after ten frames.
+  int DropdownPageWidth(int field_width) {
+    views::WebView* const page =
+        stedding::test::FindView<views::WebView>(Dropdown()->GetRootView());
+    if (!page || !page->GetWebContents()) {
+      return -1;
+    }
+    return content::EvalJs(
+               page->GetWebContents(),
+               base::StringPrintf(
+                   "new Promise(done => {"
+                   "  let frames = 0;"
+                   "  const check = () => {"
+                   "    if (window.innerWidth === %d || ++frames > 10) {"
+                   "      done(window.innerWidth);"
+                   "    } else {"
+                   "      requestAnimationFrame(check);"
+                   "    }"
+                   "  };"
+                   "  check();"
+                   "})",
+                   field_width))
+        .ExtractInt();
+  }
+
+  // Types into the omnibox and waits for its results dropdown.
+  [[nodiscard]] testing::AssertionResult OpenTheDropdown() {
+    chrome::FocusLocationBar(browser());
+    if (!base::test::RunUntil(
+            [&]() { return location_bar()->omnibox_view()->HasFocus(); })) {
+      return testing::AssertionFailure()
+             << "the field never took the focus (the window is "
+             << (widget()->IsActive() ? "active" : "not active") << ")";
+    }
+    location_bar()->omnibox_view()->SetUserText(u"a.test",
+                                                /*update_popup=*/true);
+    if (!base::test::RunUntil([&]() {
+          return location_bar()->GetOmniboxController()->IsPopupOpen() &&
+                 Dropdown();
+        })) {
+      return testing::AssertionFailure()
+             << "the dropdown never showed (the popup is "
+             << (location_bar()->GetOmniboxController()->IsPopupOpen()
+                     ? "open"
+                     : "closed")
+             << ", " << OmniboxPopups(false).size()
+             << " popup windows hidden)";
+    }
+    return testing::AssertionSuccess();
+  }
+  [[nodiscard]] bool CloseTheDropdown() {
+    location_bar()->omnibox_view()->RevertAll();
+    return base::test::RunUntil([&]() {
+      return !location_bar()->GetOmniboxController()->IsPopupOpen() &&
+             !Dropdown();
+    });
+  }
+};
