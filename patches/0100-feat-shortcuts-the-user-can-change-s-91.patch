+// Stedding (shortcuts Z10): a user chord as the table coded by key holds it.
+// The key code is the US layout's key for the chord's key code, as
+// MacKeyCodeForWindowsKeyCode gives it; the menu items built from the table
+// match a key press through its key equivalent, which follows the layout,
+// as every other row of the table does. Nothing for a chord with Fn or AltGr,
+// which the table cannot hold (the checks refuse both).
+std::optional<KeyboardShortcutData> ShortcutFromChord(
+    int command,
+    const stedding::shortcuts::Chord& chord) {
+  if (chord.modifiers & (ui::EF_FUNCTION_DOWN | ui::EF_ALTGR_DOWN)) {
+    return std::nullopt;
+  }
+  unichar shifted_character = 0;
+  unichar character = 0;
+  const int mac_key_code = ui::MacKeyCodeForWindowsKeyCode(
+      chord.key, /*flags=*/0, &shifted_character, &character);
+  if (mac_key_code < 0) {
+    return std::nullopt;
+  }
+  return KeyboardShortcutData{
+      (chord.modifiers & ui::EF_COMMAND_DOWN) != 0,
+      (chord.modifiers & ui::EF_SHIFT_DOWN) != 0,
+      (chord.modifiers & ui::EF_CONTROL_DOWN) != 0,
+      (chord.modifiers & ui::EF_ALT_DOWN) != 0,
+      mac_key_code,
+      command};
+}
+
+// The table coded by key with the user's chords applied (shortcuts Z10, Z20):
+// a shipped row stays unless its command was changed or turned off or a user
+// chord took its chord; then every user chord. A command with a menu row has
+// its first chord on that row as well (shortcut_menu_mac.mm); the menu is
+// searched first, so the two never disagree.
+std::vector<KeyboardShortcutData> EffectiveShortcutsNotPresentInMainMenu() {
+  const stedding::shortcuts::UserShortcuts& user =
+      stedding::shortcuts::Current();
+  const std::vector<KeyboardShortcutData>& defaults =
+      GetDefaultShortcutsNotPresentInMainMenu();
+  if (user.empty()) {
+    return defaults;
+  }
+  std::vector<KeyboardShortcutData> keys;
+  for (const KeyboardShortcutData& shortcut : defaults) {
+    const ui::Accelerator accelerator = AcceleratorFromShortcut(shortcut);
+    if (user.KeepsDefault(shortcut.chrome_command,
+                          stedding::shortcuts::Chord(
+                              accelerator.key_code(), accelerator.modifiers()))) {
+      keys.push_back(shortcut);
+    }
+  }
+  for (const auto& [command, chords] : user.chords) {
+    if (user.IsOff(command)) {
+      continue;
+    }
+    for (const stedding::shortcuts::Chord& chord : chords) {
+      if (std::optional<KeyboardShortcutData> shortcut =
+              ShortcutFromChord(command, chord)) {
+        keys.push_back(*shortcut);
+      }
+    }
+  }
+  return keys;
+}
+
 }  // namespace
 
+const std::vector<KeyboardShortcutData>& GetShortcutsNotPresentInMainMenu() {
+  // Rebuilt when the user's chords change (shortcuts Z11); the lookups that
+  // read it run on the UI thread, as the change does.
+  static base::NoDestructor<std::vector<KeyboardShortcutData>> keys;
+  static int generation = -1;
+  if (generation != stedding::shortcuts::Generation()) {
+    generation = stedding::shortcuts::Generation();
+    *keys = EffectiveShortcutsNotPresentInMainMenu();
+  }
+  return *keys;
+}
