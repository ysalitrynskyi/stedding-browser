+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return name_of(home) == "Notes"; }))
+        << "the rail's rename dropped the name";
+    ASSERT_NO_FATAL_FAILURE(ExpandSidebar());
+  }
