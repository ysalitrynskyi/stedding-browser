+++ b/chrome/browser/ui/views/stedding/altgr_chords.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/altgr_chords.h"
+
+#include <utility>
+
+#include "build/build_config.h"
+#include "ui/base/accelerators/accelerator.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/widget/widget.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "ui/events/win/system_event_state_lookup.h"
+#endif
+
+namespace stedding {
+
+AltGrChords::AltGrChords(views::Widget* widget, LeftAltHeld left_alt_held)
+    : widget_(widget ? widget->GetWeakPtr() : nullptr),
+      left_alt_held_(std::move(left_alt_held)) {
+  window_ = widget ? widget->GetNativeWindow() : nullptr;
+  if (window_) {
+    window_->AddPreTargetHandler(this);
+    observation_.Observe(window_.get());
+  }
+}
+
+AltGrChords::~AltGrChords() {
+  if (window_) {
+    window_->RemovePreTargetHandler(this);
+  }
+}
+
+// static
+void AltGrChords::AttachTo(views::Widget* widget) {
+  if (!widget || !widget->GetNativeWindow()) {
+    return;
+  }
+  // Owned by the window: OnWindowDestroying deletes it.
+  auto* const chords = new AltGrChords(
+      widget, base::BindRepeating(&AltGrChords::LeftAltHeldNow));
+  chords->owned_by_window_ = true;
+}
+
+// static
+bool AltGrChords::LeftAltHeldNow() {
+#if BUILDFLAG(IS_WIN)
+  return ui::win::IsCtrlPressed() && ui::win::IsAltPressed() &&
+         !ui::win::IsAltRightPressed();
+#else
+  return false;
+#endif
+}
+
+void AltGrChords::OnKeyEvent(ui::KeyEvent* event) {
+  // The key's own event, not the character after it: with the command run,
+  // the input method drops that character.
+  if (!widget_ || event->type() != ui::EventType::kKeyPressed ||
+      event->is_char() || !(event->flags() & ui::EF_ALTGR_DOWN) ||
+      !left_alt_held_.Run()) {
+    return;
+  }
+  views::FocusManager* const focus_manager = widget_->GetFocusManager();
+  if (!focus_manager || focus_manager->shortcut_handling_suspended()) {
+    return;
+  }
+  // The chord as it was pressed: the layout put AltGr where Ctrl and Alt were.
+  const ui::Accelerator chord(
+      event->key_code(),
+      (event->flags() & (ui::EF_SHIFT_DOWN | ui::EF_COMMAND_DOWN)) |
+          ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN);
+  if (!focus_manager->IsAcceleratorRegistered(chord)) {
+    return;
+  }
+  if (focus_manager->ProcessAccelerator(chord)) {
+    event->StopPropagation();
+  }
+}
+
+void AltGrChords::OnWindowDestroying(aura::Window* window) {
+  window_->RemovePreTargetHandler(this);
+  observation_.Reset();
+  window_ = nullptr;
+  widget_.reset();
+  if (owned_by_window_) {
+    delete this;
+  }
+}
+
+}  // namespace stedding
