+// The Rust reader hands history over in batches of this many.
+constexpr size_t kHistoryBatch = 1000;
+// A JSON file's metadata, which names what it holds, comes first: at most
+// this much is read to find it, this much at a time.
+constexpr size_t kJsonHeadBytes = 4096;
+constexpr size_t kJsonChunkBytes = 32;
+
+std::string_view RustView(const rust::String& text) {
+  return std::string_view(text.data(), text.length());
+}
+
+bool IsWebScheme(const GURL& url) {
+  return url.SchemeIs(url::kHttpScheme) || url.SchemeIs(url::kHttpsScheme);
+}
+
+// Whether going from `from` to `to` was a redirect: another scheme, host or
+// path, or a query added where there was none. Another fragment, or a
+// changed query, is the same page.
+bool IsRedirect(const GURL& from, const GURL& to) {
+  if (from == to || !from.is_valid() || !to.is_valid()) {
+    return false;
+  }
+  if (from.GetScheme() != to.GetScheme() || from.GetHost() != to.GetHost() ||
+      from.GetPath() != to.GetPath()) {
+    return true;
+  }
+  return !from.has_query() && to.has_query();
+}
+
+// The first bytes of a JSON file, read as JSON as far as they go: enough to
+// follow the metadata object Safari writes first.
+class JsonHead {
+ public:
+  explicit JsonHead(std::string_view text) : text_(text) {}
+
+  // Whether the text ended before what was asked of it.
+  bool ran_out() const { return ran_out_; }
+
+  // Takes `c`, the next character after any whitespace.
+  bool Take(char c) {
+    if (!Space() || text_[at_] != c) {
+      return false;
+    }
+    ++at_;
+    return true;
+  }
+
+  // The next value as a string: its text, escapes as written.
+  std::optional<std::string_view> String() {
+    if (!Take('"')) {
+      return std::nullopt;
+    }
+    const size_t start = at_;
+    while (at_ < text_.size()) {
+      const char c = text_[at_++];
+      if (c == '\\') {
+        ++at_;
+      } else if (c == '"') {
+        return text_.substr(start, at_ - 1 - start);
+      }
+    }
+    ran_out_ = true;
+    return std::nullopt;
+  }
+
+  // Skips the next value, whatever it is, with what is nested in it.
+  bool SkipValue() {
+    if (!Space()) {
+      return false;
+    }
+    if (text_[at_] == '"') {
+      return String().has_value();
+    }
+    size_t depth = 0;
+    while (at_ < text_.size()) {
+      const char c = text_[at_];
+      if (c == '"') {
+        if (!String()) {
+          return false;
+        }
+        continue;
+      }
+      if (depth == 0 && (c == ',' || c == '}' || c == ']')) {
+        // The end of a number, true, false or null.
+        return true;
+      }
+      ++at_;
+      if (c == '{' || c == '[') {
+        ++depth;
+      } else if ((c == '}' || c == ']') && --depth == 0) {
+        return true;
+      }
+    }
+    ran_out_ = true;
+    return false;
+  }
+
+ private:
+  // Skips whitespace; false at the end of the text.
+  bool Space() {
+    while (at_ < text_.size() && base::IsAsciiWhitespace(text_[at_])) {
+      ++at_;
+    }
+    if (at_ < text_.size()) {
+      return true;
+    }
+    ran_out_ = true;
+    return false;
+  }
+
+  const std::string_view text_;
+  size_t at_ = 0;
+  bool ran_out_ = false;
+};
+
+// import I34 (BACKLOG S-346): the type a Safari JSON file's metadata names,
+// read from its first bytes as JSON. Safari writes the metadata first:
+// {"metadata": {..., "data_type": "...", ...}, ...}. Nullopt while `head`
+// ends before the answer; empty for a file not shaped that way, which is
+// read no further. Only the metadata's own "data_type" counts: found by a
+// plain search for the first "data_type" anywhere, a payment cards file with
+// another one ahead of its metadata had been read whole as history.
+std::optional<std::string> JsonDataType(std::string_view head) {
+  JsonHead json(head);
+  const auto answer =
+      [&json](std::string_view type) -> std::optional<std::string> {
+    if (json.ran_out()) {
+      return std::nullopt;
+    }
+    return std::string(type);
+  };
+  if (!json.Take('{')) {
+    return answer("");
+  }
+  const std::optional<std::string_view> first = json.String();
+  if (!first || *first != "metadata" || !json.Take(':') || !json.Take('{')) {
+    return answer("");
+  }
+  while (true) {
+    const std::optional<std::string_view> key = json.String();
+    if (!key || !json.Take(':')) {
+      return answer("");
+    }
+    if (*key == "data_type") {
+      const std::optional<std::string_view> type = json.String();
+      return answer(type.value_or(""));
+    }
+    if (!json.SkipValue() || !json.Take(',')) {
+      return answer("");
+    }
+  }
+}
+
+// import I34, I35 (BACKLOG S-346): the files of an unzipped export, sorted:
+// the folder's own plain files only. A link, a pipe or a device is none of
+// Safari's files: read, a link took in whatever it pointed to, and a pipe or
+// /dev/zero was read without end.
+std::vector<base::FilePath> ExportFilesIn(const base::FilePath& dir) {
+  std::vector<base::FilePath> files;
+#if BUILDFLAG(IS_POSIX) || BUILDFLAG(IS_FUCHSIA)
+  base::FileEnumerator list(
+      dir, /*recursive=*/false,
+      base::FileEnumerator::FILES | base::FileEnumerator::SHOW_SYM_LINKS);
+#else
+  base::FileEnumerator list(dir, /*recursive=*/false,
+                            base::FileEnumerator::FILES);
+#endif
+  for (base::FilePath file = list.Next(); !file.empty(); file = list.Next()) {
+#if BUILDFLAG(IS_POSIX) || BUILDFLAG(IS_FUCHSIA)
+    if (!S_ISREG(list.GetInfo().stat().st_mode)) {
+      continue;
+    }
+#elif BUILDFLAG(IS_WIN)
+    if (list.GetInfo().find_data().dwFileAttributes &
+        FILE_ATTRIBUTE_REPARSE_POINT) {
+      continue;
+    }
+#endif
+    files.push_back(file);
+  }
+  std::ranges::sort(files);
+  return files;
+}
+
+// A history row kept from `visit`, onto `rows`; past twice the cap, the
+// oldest are dropped, so a long export holds no more than that in memory.
+void Collect(const SafariVisit& visit,
+             base::Time now,
+             size_t cap,
+             history::URLRows& rows,
+             bool& capped) {
+  std::optional<history::URLRow> row = SafariHistoryRow(visit, now);
+  if (!row) {
+    return;
+  }
+  rows.push_back(std::move(*row));
+  if (rows.size() >= 2 * cap) {
+    KeepNewestRows(rows, cap);
+    capped = true;
+  }
+}
+
+// The archive's Rust reader calls this, on the worker's sequence, while it
+// reads the history files.
+class CollectSafariVisits final
+    : public user_data_importer::HistoryCallbackFromRust<
+          user_data_importer::SafariHistoryEntry> {
+ public:
+  CollectSafariVisits(base::Time now,
+                      size_t cap,
+                      history::URLRows& rows,
+                      bool& capped)
+      : now_(now), cap_(cap), rows_(rows), capped_(capped) {}
+  ~CollectSafariVisits() override = default;
+
+  void ImportHistoryEntries(
+      std::unique_ptr<std::vector<user_data_importer::SafariHistoryEntry>>
+          entries,
+      bool completed) override {
+    if (!entries) {
+      return;
+    }
+    for (const user_data_importer::SafariHistoryEntry& entry : *entries) {
+      SafariVisit visit;
+      visit.url = std::string(RustView(entry.url));
+      visit.title = std::string(RustView(entry.title));
+      visit.source_url = std::string(RustView(entry.source_url));
+      visit.destination_url = std::string(RustView(entry.destination_url));
+      visit.time_usec = entry.time_usec;
+      visit.visit_count = entry.visit_count;
+      Collect(visit, now_, cap_, *rows_, *capped_);
+    }
+  }
+
+  // A read that fails partway keeps the visits read before it.
+  void Fail() override {}
+
+ private:
+  const base::Time now_;
+  const size_t cap_;
+  const raw_ref<history::URLRows> rows_;
+  const raw_ref<bool> capped_;
+};
+
+std::optional<uint64_t> ToUint64(const base::Value* value) {
+  if (!value) {
+    return std::nullopt;
+  }
+  if (value->is_int()) {
+    return value->GetInt() < 0 ? std::nullopt
+                               : std::optional<uint64_t>(value->GetInt());
+  }
+  if (value->is_double()) {
+    const double number = value->GetDouble();
+    if (number < 0 ||
+        number >= static_cast<double>(std::numeric_limits<int64_t>::max())) {
+      return std::nullopt;
+    }
+    return static_cast<uint64_t>(number);
+  }
+  return std::nullopt;
+}
+
+std::string StringOr(const base::DictValue& dict, std::string_view key) {
+  const std::string* const value = dict.FindString(key);
+  return value ? *value : std::string();
+}
+
+// Web pages among `entries`, the bookmarks a summary counts.
+size_t CountPages(const std::vector<ImportedBookmarkEntry>& entries) {
+  return static_cast<size_t>(
+      std::ranges::count_if(entries, [](const ImportedBookmarkEntry& entry) {
+        return !entry.is_folder && entry.url.is_valid() &&
+               IsWebScheme(entry.url);
+      }));
+}
