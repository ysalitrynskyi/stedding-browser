+  content::WebContents* const page = WaitForThePage();
+  ASSERT_TRUE(content::ExecJs(page, "window.fromTheFirstImport = true;"));
+  tabs().ActivateTabAt(0);
+  ASSERT_TRUE(Import());
+  EXPECT_EQ(1, PagesOpen());
+  EXPECT_EQ(page, tabs().GetActiveWebContents()) << "not brought forward";
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, "!window.fromTheFirstImport").ExtractBool();
+  })) << "the page was not read again";
+}
