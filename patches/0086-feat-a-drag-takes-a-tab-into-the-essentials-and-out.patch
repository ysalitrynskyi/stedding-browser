+
+std::optional<UnpinnedTabContainerView::RowDropPlace>
+UnpinnedTabContainerView::RowDropPlaceAt(const gfx::Point& screen_point) const {
+  if (!collection_node_ || !IsDrawn()) {
+    return std::nullopt;
+  }
+  gfx::Point point = screen_point;
+  views::View::ConvertPointFromScreen(this, &point);
+  if (point.x() < 0 || point.x() >= width() || point.y() < 0) {
+    return std::nullopt;
+  }
+  // Where `view` will stand once the rows have moved, less the room: the
+  // target layout, so a row still moving is read where it is going.
+  const views::ProposedLayout& target = layout_manager_->target_layout();
+  const auto bounds_without_room =
+      [&](const views::View* view) -> std::optional<gfx::Rect> {
+    const views::ChildLayout* const layout = target.GetLayoutFor(view);
+    if (!layout || !layout->visible || layout->bounds.IsEmpty()) {
+      return std::nullopt;
+    }
+    gfx::Rect bounds = layout->bounds;
+    if (row_room_bounds_ && bounds.y() >= row_room_bounds_->y()) {
+      bounds.Offset(0, -row_room_height_);
+    }
+    return bounds;
+  };
+  RowDropPlace place;
+  for (views::View* const child : collection_node_->GetDirectChildren()) {
+    // Another Space's rows are not on screen, and take no drop.
+    if (!child->GetVisible() || child->GetProperty(kHiddenForEssentialsDrag)) {
+      continue;
+    }
+    const std::optional<gfx::Rect> bounds = bounds_without_room(child);
+    if (!bounds) {
+      continue;
+    }
+    if (point.y() < bounds->CenterPoint().y()) {
+      place.before_row = child;
+      place.before = FirstTabOfRow(*child);
+      break;
+    }
+  }
+  if (boundary_clear_line_ && boundary_clear_line_->GetVisible()) {
+    if (const std::optional<gfx::Rect> line =
+            bounds_without_room(boundary_clear_line_)) {
+      place.over_line = point.y() < line->CenterPoint().y();
+    }
+  }
+  return place;
+}
+
+void UnpinnedTabContainerView::SetEssentialsRowRoom(
+    std::optional<RowDropPlace> place,
+    int count) {
+  if (!place) {
+    count = 0;
+  }
+  const bool same = row_room_.has_value() == place.has_value() &&
+                    row_room_count_ == count &&
+                    (!place || (row_room_->before_row == place->before_row &&
+                                row_room_->over_line == place->over_line));
+  if (same) {
+    return;
+  }
+  row_room_ = place;
+  row_room_count_ = count;
+  InvalidateLayout();
+}
+
+std::optional<gfx::Rect>
+UnpinnedTabContainerView::GetEssentialsRowRoomBoundsInScreen() const {
+  if (!row_room_ || !row_room_bounds_) {
+    return std::nullopt;
+  }
+  gfx::Rect bounds = *row_room_bounds_;
+  views::View::ConvertRectToScreen(this, &bounds);
+  return bounds;
+}
+
+gfx::Rect UnpinnedTabContainerView::RowBoundsInScreenAt(int screen_y) const {
+  // As the vertical layout insets a row (sidebar Y8).
+  const bool rail = base::FeatureList::IsEnabled(stedding::kArcStyleWindow) &&
+                    width() <= VerticalTabStripRegionView::kCollapsedWidth;
+  const int inset =
+      rail ? stedding::kRailRowPadding + stedding::RailRowInset()
+           : GetLayoutConstant(
+                 LayoutConstant::kVerticalTabStripHorizontalPadding);
+  const int height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+  gfx::Rect bounds(inset, 0, std::max(width() - 2 * inset, 0), height);
+  views::View::ConvertRectToScreen(this, &bounds);
+  bounds.set_y(screen_y - height / 2);
+  return bounds;
+}
