+constexpr char kSpacePrefix[] = "space:";
+constexpr char kPinsSuffix[] = "/pins";
+constexpr char kOwnEssentialsSuffix[] = "/essentials";
+
+// Sf27, Sf26.
+constexpr int64_t kSkewLimitMs = base::Hours(24).InMilliseconds();
+constexpr int64_t kTombstoneKeepMs = base::Days(180).InMilliseconds();
+
+// Sf22.
+constexpr size_t kHoldRemovals = 5;
+constexpr size_t kHoldAdditions = 50;
