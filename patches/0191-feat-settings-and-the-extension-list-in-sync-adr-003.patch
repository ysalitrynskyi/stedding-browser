+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+// Sf66: an uninstall the person made: in the extensions page, the toolbar
+// menu or the Web Store's page, or one an extension asked for and the person
+// confirmed. Not an update, a reinstall, a repair or a component going.
+bool UninstalledByThePerson(extensions::UninstallReason reason) {
+  switch (reason) {
+    case extensions::UNINSTALL_REASON_USER_INITIATED:
+    case extensions::UNINSTALL_REASON_MANAGEMENT_API:
+    case extensions::UNINSTALL_REASON_CHROME_WEBSTORE:
+      return true;
+    default:
+      return false;
+  }
+}
+
+}  // namespace
+
+bool IsWebStoreExtension(const extensions::Extension& extension) {
+  return extension.from_webstore() &&
+         extension.location() ==
+             extensions::mojom::ManifestLocation::kInternal &&
+         extension.is_extension();
+}
+
+std::vector<ExtensionEntry> WebStoreExtensions(
+    content::BrowserContext* context) {
+  std::vector<ExtensionEntry> list;
+  extensions::ExtensionRegistry* const registry =
+      context ? extensions::ExtensionRegistry::Get(context) : nullptr;
+  if (!registry) {
+    return list;
+  }
+  const extensions::ExtensionSet installed =
+      registry->GenerateInstalledExtensionsSet(
+          extensions::ExtensionRegistry::ENABLED |
+          extensions::ExtensionRegistry::DISABLED |
+          extensions::ExtensionRegistry::TERMINATED);
+  for (const auto& extension : installed) {
+    if (!IsWebStoreExtension(*extension)) {
+      continue;
+    }
+    list.push_back(ExtensionEntry{
+        extension->id(),
+        std::string(
+            base::TruncateUTF8ToByteSize(extension->name(), kMaxTextLength))});
+  }
+  std::sort(list.begin(), list.end(),
+            [](const ExtensionEntry& a, const ExtensionEntry& b) {
+              return a.id < b.id;
+            });
+  return list;
+}
+
+ExtensionListWatch::ExtensionListWatch(
+    content::BrowserContext* context,
+    base::RepeatingClosure list_changed,
+    base::RepeatingCallback<void(const std::string& id)> uninstalled_here)
+    : list_changed_(std::move(list_changed)),
+      uninstalled_here_(std::move(uninstalled_here)) {
+  if (extensions::ExtensionRegistry* const registry =
+          context ? extensions::ExtensionRegistry::Get(context) : nullptr) {
+    observation_.Observe(registry);
+  }
+}
+
+ExtensionListWatch::~ExtensionListWatch() = default;
+
+void ExtensionListWatch::OnExtensionInstalled(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    bool is_update) {
+  // An update may rename it, so it is heard too.
+  if (extension && IsWebStoreExtension(*extension) && list_changed_) {
+    list_changed_.Run();
+  }
+}
+
+void ExtensionListWatch::OnExtensionUninstalled(
+    content::BrowserContext* browser_context,
+    const extensions::Extension* extension,
+    extensions::UninstallReason reason) {
+  if (!extension || !IsWebStoreExtension(*extension)) {
+    return;
+  }
+  if (UninstalledByThePerson(reason) && uninstalled_here_) {
+    uninstalled_here_.Run(extension->id());
+  }
+  if (list_changed_) {
+    list_changed_.Run();
+  }
+}
+
+void ExtensionListWatch::OnShutdown(extensions::ExtensionRegistry* registry) {
+  observation_.Reset();
+}
+
+}  // namespace spaces::sidebar_sync
