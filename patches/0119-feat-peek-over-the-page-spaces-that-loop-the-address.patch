+      command(overlay, PeekCommand::kOpenInSplit), kSplitSceneIcon,
+      kBarIconSize));
+  split_->SetTooltipText(
+      WithKey(IDS_STEDDING_PEEK_OPEN_IN_SPLIT_TOOLTIP, OpenInSplitKey()));
+  split_->GetViewAccessibility().SetName(PeekOpenInSplitLabel());
+  open_as_tab_ =
+      bar_->AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+          command(overlay, PeekCommand::kOpenAsTab), kOpenInBrowserIcon,
+          kBarIconSize));
+  open_as_tab_->SetTooltipText(
+      WithKey(IDS_STEDDING_PEEK_OPEN_AS_TAB_TOOLTIP, OpenAsTabKey()));
+  open_as_tab_->GetViewAccessibility().SetName(PeekOpenAsTabLabel());
+  close_ = bar_->AddChildView(views::CreateVectorImageButtonWithNativeTheme(
+      command(overlay, PeekCommand::kClose), vector_icons::kCloseIcon,
+      kBarIconSize));
+  close_->SetTooltipText(base::StrCat(
+      {l10n_util::GetStringUTF16(IDS_APP_CLOSE), u" (",
+       ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE).GetShortcutText(),
+       u")"}));
+  close_->GetViewAccessibility().SetName(
+      l10n_util::GetStringUTF16(IDS_APP_CLOSE));
+
+  web_view_ = card_->AddChildView(
+      std::make_unique<views::WebView>(page->GetBrowserContext()));
+  web_view_->SetWebContents(page);
+  // The page's own surface does not clip to the card's layer: its bottom
+  // corners are rounded where it draws.
+  web_view_->holder()->SetNativeViewCornerRadii(
+      gfx::RoundedCornersF(0, 0, kCardRadius, kCardRadius));
+
+  for (const ui::Accelerator& key :
+       {ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE), CloseKey(),
+        OpenAsTabKey(), OpenInSplitKey()}) {
+    AddAccelerator(key);
+  }
+  UpdateSite();
+}
+
+PeekOverlayView::~PeekOverlayView() = default;
+
+// static
+gfx::Rect PeekOverlayView::CardBoundsIn(const gfx::Rect& bounds) {
+  // P12: the margin grows with the page, up to the small window's 72 DIP at
+  // the sides and 48 above and below.
+  const int sides = std::clamp(bounds.width() / 16, 16, 72);
+  const int ends = std::clamp(bounds.height() / 20, 12, 48);
+  gfx::Rect card = bounds;
+  card.Inset(gfx::Insets::VH(ends, sides));
+  return card;
+}
+
+void PeekOverlayView::UpdateSite() {
+  const GURL url = page_->GetLastCommittedURL().is_empty()
+                       ? page_->GetVisibleURL()
+                       : page_->GetLastCommittedURL();
+  std::u16string site = base::UTF8ToUTF16(url.host());
+  if (base::StartsWith(site, u"www.")) {
+    site = site.substr(4);
+  }
+  site_->SetText(site.empty() ? base::UTF8ToUTF16(url.spec()) : site);
+  site_->SetTooltipText(page_->GetTitle());
+}
+
+void PeekOverlayView::UpdateSplit(bool can_split) {
+  split_->SetVisible(can_split);
+}
+
+void PeekOverlayView::Layout(PassKey) {
+  card_->SetBoundsRect(CardBoundsIn(GetLocalBounds()));
+  bar_->SetBounds(0, 0, card_->width(), kBarHeight);
+  web_view_->SetBounds(0, kBarHeight, card_->width(),
+                       std::max(0, card_->height() - kBarHeight));
+}
+
+void PeekOverlayView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  // A clear ground would let a click beside the card through on the Mac,
+  // where a window's clear pixels are not its own; this one takes it and
+  // shows nothing over the window's scrim.
+  canvas->DrawColor(SkColorSetA(SK_ColorBLACK, 0x01));
+  // The card stands over the page on its shadow.
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(GetColorProvider()->GetColor(ui::kColorDialogBackground));
+  flags.setLooper(gfx::CreateShadowDrawLooper(
+      gfx::ShadowValue::MakeMdShadowValues(/*elevation=*/16)));
+  canvas->DrawRoundRect(card_->bounds(), kCardRadius, flags);
+}
+
+bool PeekOverlayView::OnMousePressed(const ui::MouseEvent& event) {
+  // P20: a click on the page beside the card closes the peek, as a click on
+  // the window does with the small one (P14).
+  if (card_->bounds().Contains(event.location())) {
+    return false;
+  }
+  RunSoon(overlay_->GetWeakPtr(), PeekCommand::kClose);
+  return true;
+}
+
+bool PeekOverlayView::AcceleratorPressed(const ui::Accelerator& accelerator) {
+  // The keys reach here while the bar has the focus; from the page they come
+  // through PeekOverlay::HandleKeyboardEvent.
+  const std::optional<PeekCommand> command = CommandFor(accelerator);
+  if (!command) {
+    return false;
+  }
+  RunSoon(overlay_->GetWeakPtr(), *command);
+  return true;
+}
