+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Restart and restore (PLAN.md TST-4, TAB-12): with "Continue where you
+// left off", the whole sidebar comes back after a restart, three times over
+// -- Spaces, the independent session's jar, essentials, Space pins and their
+// homes, a nested folder tree with its names, collapse and ids, a second
+// top-level folder, a split and a pair that is no longer one, and tab names,
+// asleep or not. Changes made to restored tabs hold across the next restart.
+// A tab reopened with ⌘⇧T and a window reopened from History bring their
+// folders back too.
+//
+// Each PRE_ step is a browser run; the profile carries over to the next.
+// Tabs are found by host: every run has its own test server port, and the
+// saved pages keep the port of the run that saved them.
+
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/memory/raw_ptr.h"
+#include "base/run_loop.h"
+#include "base/strings/string_util.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/resource_coordinator/lifecycle_unit_state.mojom.h"
+#include "chrome/browser/resource_coordinator/tab_lifecycle_unit_external.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/sessions/session_service_test_helper.h"
+#include "chrome/browser/sessions/tab_restore_service_factory.h"
+#include "chrome/browser/ui/archive/archived_tabs.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_live_tab_context.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/stedding/sleep_tabs.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/views/commandbar/command_bar_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/tabs/common/folder_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "components/sessions/core/command_storage_manager.h"
+#include "components/sessions/core/session_command.h"
+#include "components/sessions/core/session_id.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/sessions/core/session_types.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+
+namespace {
+
+using spaces::SpaceId;
+
+class RestoreTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    SessionStartupPref::SetStartupPref(
+        browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+
+  GURL Url(const std::string& host) {
+    return embedded_test_server()->GetURL(host, "/title1.html");
+  }
+
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+
+  // A new foreground tab on `host`, loaded.
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url(host), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // The tab showing `host`, loaded or restored and not yet loaded.
+  tabs::TabInterface* Find(const std::string& host) {
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      const content::NavigationEntry* const entry =
+          tab->GetContents()->GetController().GetLastCommittedEntry();
+      const GURL url =
+          entry ? entry->GetURL() : tab->GetContents()->GetVisibleURL();
+      if (url.host() == host) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  const tabs::FolderTabCollection* FolderOf(tabs::TabInterface* tab) {
+    const tabs::TabCollection* const parent = tab->GetParentCollection();
+    return parent && parent->type() == tabs::TabCollection::Type::FOLDER
+               ? static_cast<const tabs::FolderTabCollection*>(parent)
+               : nullptr;
+  }
+
+  // The folder ids of the first run, kept in the profile's folder for the
+  // runs after it: ids must survive every restart.
+  base::FilePath IdsFile() {
+    return browser()->GetProfile()->GetPath().AppendASCII(
+        "stedding_folder_ids.txt");
+  }
+
+  std::string FolderIds() {
+    const tabs::FolderTabCollection* const outer = FolderOf(Find("a.test"));
+    const tabs::FolderTabCollection* const inner = FolderOf(Find("b.test"));
+    const tabs::FolderTabCollection* const second = FolderOf(Find("d.test"));
+    const tabs::FolderTabCollection* const top = FolderOf(Find("e.test"));
+    if (!outer || !inner || !second || !top) {
+      return std::string();
+    }
+    return base::JoinString(
+        {outer->id().ToString(), inner->id().ToString(),
+         second->id().ToString(), top->id().ToString()},
+        ",");
+  }
+
+  void SaveFolderIds() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::WriteFile(IdsFile(), FolderIds()));
+  }
+
+  void ExpectTheSameFolderIds() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    std::string saved;
+    ASSERT_TRUE(base::ReadFileToString(IdsFile(), &saved));
+    EXPECT_FALSE(saved.empty());
+    EXPECT_EQ(saved, FolderIds()) << "a folder's id survives a restart";
+  }
+
+  std::optional<SpaceId> SpaceNamed(const std::string& name) {
+    for (const auto& space : model()->spaces()) {
+      if (space->name() == name) {
+        return space->id();
+      }
+    }
+    return std::nullopt;
+  }
+
+  // What every restore must bring back; `pins_changed` is the second restart,
+  // after one pin was unpinned and the other given a new home.
+  void ExpectTheSidebar(bool pins_changed) {
+    spaces::SpaceModel* const m = model();
+    ASSERT_TRUE(m);
+    ASSERT_EQ(3u, m->size());
+    EXPECT_EQ("Home", m->spaces()[0]->name());
+    EXPECT_EQ("Work", m->spaces()[1]->name());
+    EXPECT_EQ("Play", m->spaces()[2]->name());
+    const SpaceId home = m->spaces()[0]->id();
+    const SpaceId work = m->spaces()[1]->id();
+    const SpaceId play = m->spaces()[2]->id();
+    EXPECT_TRUE(m->SpaceIsIsolated(work));
+    EXPECT_FALSE(m->SpaceIsIsolated(home));
+    EXPECT_EQ(home, m->active_id());
+
+    // The essential: first, pinned, in every Space.
+    tabs::TabInterface* const essential = Find("essential.test");
+    ASSERT_TRUE(essential);
+    EXPECT_TRUE(essential->IsPinned());
+    EXPECT_EQ(0, Index(essential));
+
+    // Home's tree: Outer holds a, Inner (collapsed) with b, Second with d,
+    // then c; Top, a second top-level folder, holds e.
+    tabs::TabInterface* const a = Find("a.test");
+    tabs::TabInterface* const b = Find("b.test");
+    tabs::TabInterface* const d = Find("d.test");
+    tabs::TabInterface* const c = Find("c.test");
+    tabs::TabInterface* const e = Find("e.test");
+    ASSERT_TRUE(a && b && c && d && e);
+    EXPECT_LT(Index(a), Index(b));
+    EXPECT_LT(Index(b), Index(d));
+    EXPECT_LT(Index(d), Index(c));
+    EXPECT_LT(Index(c), Index(e));
+    const tabs::FolderTabCollection* const outer = FolderOf(a);
+    const tabs::FolderTabCollection* const inner = FolderOf(b);
+    const tabs::FolderTabCollection* const second = FolderOf(d);
+    ASSERT_TRUE(outer);
+    ASSERT_TRUE(inner);
+    ASSERT_TRUE(second);
+    EXPECT_EQ("Outer", outer->title());
+    EXPECT_FALSE(outer->collapsed());
+    EXPECT_EQ("Inner", inner->title());
+    EXPECT_TRUE(inner->collapsed());
+    EXPECT_EQ("Second", second->title());
+    EXPECT_FALSE(second->collapsed());
+    EXPECT_EQ(static_cast<const tabs::TabCollection*>(outer),
+              inner->GetParentCollection())
+        << "the nested folder stays nested";
+    EXPECT_EQ(static_cast<const tabs::TabCollection*>(outer),
+              second->GetParentCollection());
+    EXPECT_NE(inner, second);
+    EXPECT_EQ(outer, FolderOf(c)) << "a sibling after the nested folders";
+    const tabs::FolderTabCollection* const top = FolderOf(e);
+    ASSERT_TRUE(top);
+    EXPECT_EQ("Top", top->title());
+    EXPECT_NE(top, outer);
+    EXPECT_EQ(outer->GetParentCollection(), top->GetParentCollection())
+        << "both folders at the top of the list";
+    for (tabs::TabInterface* const tab : {a, b, c, d, e}) {
+      EXPECT_EQ(home, m->SpaceForTab(tab));
+    }
+
+    // Names, awake and asleep.
+    tabs::TabInterface* const named = Find("named.test");
+    tabs::TabInterface* const sleepy = Find("sleepy.test");
+    ASSERT_TRUE(named);
+    ASSERT_TRUE(sleepy);
+    EXPECT_EQ(u"Mail", stedding::TabName(named->GetContents()));
+    EXPECT_EQ(u"Later", stedding::TabName(sleepy->GetContents()));
+
+    // Work: two Space pins with their homes, in the independent jar.
+    tabs::TabInterface* const pin = Find("pin.test");
+    tabs::TabInterface* const other_pin = Find("pin2.test");
+    ASSERT_TRUE(pin);
+    ASSERT_TRUE(other_pin);
+    EXPECT_EQ(work, m->SpaceForTab(pin));
+    EXPECT_EQ(work, m->SpaceForTab(other_pin));
+    EXPECT_TRUE(spaces::IsSpaceStoragePartition(
+        spaces::StoragePartitionConfigForWebContents(pin->GetContents())));
+    if (pins_changed) {
+      EXPECT_FALSE(m->IsSpacePinned(pin)) << "an unpin holds";
+      EXPECT_TRUE(m->IsSpacePinned(other_pin));
+      EXPECT_EQ("newhome.test", m->HomeUrl(other_pin).value_or(GURL()).host())
+          << "a new home holds";
+    } else {
+      EXPECT_TRUE(m->IsSpacePinned(pin));
+      EXPECT_TRUE(m->IsSpacePinned(other_pin));
+      EXPECT_EQ("pin.test", m->HomeUrl(pin).value_or(GURL()).host());
+      EXPECT_EQ("pin2.test", m->HomeUrl(other_pin).value_or(GURL()).host());
+    }
+
+    // The pin put to sleep with ⌘W: still a pin in Work, with its name.
+    tabs::TabInterface* const napping = Find("napping.test");
+    ASSERT_TRUE(napping);
+    EXPECT_EQ(work, m->SpaceForTab(napping));
+    EXPECT_TRUE(m->IsSpacePinned(napping));
+    EXPECT_EQ(u"Nap", stedding::TabName(napping->GetContents()));
+
+    // Play: the split is one again; the pair that was unsplit is not.
+    tabs::TabInterface* const left = Find("left.test");
+    tabs::TabInterface* const right = Find("right.test");
+    tabs::TabInterface* const x = Find("x.test");
+    tabs::TabInterface* const y = Find("y.test");
+    ASSERT_TRUE(left && right && x && y);
+    EXPECT_TRUE(left->IsSplit());
+    EXPECT_EQ(left->GetSplit(), right->GetSplit());
+    EXPECT_FALSE(x->IsSplit());
+    EXPECT_FALSE(y->IsSplit());
+    for (tabs::TabInterface* const tab : {left, right, x, y}) {
+      EXPECT_EQ(play, m->SpaceForTab(tab));
+    }
+  }
+};
