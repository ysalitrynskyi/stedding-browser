+class SpaceSwitchTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  // Three Spaces of two tabs each, the first one active.
+  void MakeThreeSpaces() {
+    AppendTab();
+    ids_.push_back(model()->active_id());
+    ids_.push_back(model()->AddSpace("Two", SK_ColorBLUE)->id());
+    ids_.push_back(model()->AddSpace("Three", SK_ColorGREEN)->id());
+    for (size_t i = 1; i < ids_.size(); ++i) {
+      model()->SetActiveSpace(ids_[i]);
+      while (TabsIn(ids_[i]) < 2) {
+        AppendTab();
+      }
+    }
+    model()->SetActiveSpace(ids_[0]);
+    ASSERT_EQ(6, tab_strip_model()->count());
+    for (const spaces::SpaceId& id : ids_) {
+      ASSERT_EQ(2, TabsIn(id));
+    }
+  }
+
+  int TabsIn(const spaces::SpaceId& id) {
+    int count = 0;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      if (model()->SpaceForTab(tab_strip_model()->GetTabAtIndex(i)) == id) {
+        ++count;
+      }
+    }
+    return count;
+  }
+
+  // What every switch must leave: `id` active, the active tab one of its
+  // own, its page on screen and, in the sidebar, its row drawn.
+  void ExpectShowing(const spaces::SpaceId& id) {
+    EXPECT_EQ(id, model()->active_id());
+    tabs::TabInterface* const active = tab_strip_model()->GetActiveTab();
+    ASSERT_TRUE(active);
+    EXPECT_TRUE(model()->IsTabInActiveSpace(active))
+        << "the active tab is hidden in another Space";
+    EXPECT_EQ(active->GetContents(), browser_view()->GetActiveWebContents());
+    if (vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs()) {
+      views::test::RunScheduledLayout(browser_view()->GetWidget());
+      EXPECT_TRUE(
+          HasDrawnRow(browser_view()->GetWidget()->GetRootView(), active))
+          << "the active tab has no row on screen";
+    }
+  }
+
+  void ExpectHorizontalStripShowsOnlyTheSpace() {
+    TabStrip* const strip = browser_view()->horizontal_tab_strip_for_testing();
+    ASSERT_TRUE(strip);
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      SCOPED_TRACE(testing::Message() << "tab " << i);
+      Tab* const tab = strip->tab_at(i);
+      ASSERT_TRUE(tab);
+      EXPECT_EQ(!tab_strip_model()->IsTabHidden(i), tab->GetVisible());
+    }
+  }
+
+  void Run(int command_id) {
+    SCOPED_TRACE(testing::Message() << "command " << command_id);
+    chrome::ExecuteCommand(browser(), command_id);
+  }
+
+  // The drawn chips in their order, by the Space under each one's centre;
+  // the "+" is not a chip.
+  std::vector<std::pair<gfx::Point, spaces::SpaceId>> Chips() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    std::vector<std::pair<gfx::Point, spaces::SpaceId>> chips;
+    spaces::SpaceSwitcherView* const switcher =
+        FindDrawnSwitcher(browser_view()->GetWidget()->GetRootView());
+    if (!switcher) {
+      return chips;
+    }
+    for (views::View* child : switcher->icon_row_for_testing()->children()) {
+      if (!child->IsDrawn()) {
+        continue;
+      }
+      const gfx::Point centre = child->GetBoundsInScreen().CenterPoint();
+      if (std::optional<spaces::SpaceId> id =
+              switcher->SpaceAtScreenPoint(centre)) {
+        chips.emplace_back(centre, *id);
+      }
+    }
+    return chips;
+  }
+
+  std::vector<spaces::SpaceId> Order() {
+    std::vector<spaces::SpaceId> order;
+    for (const auto& space : model()->spaces()) {
+      order.push_back(space->id());
+    }
+    return order;
+  }
+
+  void SendMouse(ui::EventType type, const gfx::Point& screen_point) {
+    stedding::test::SendLeftMouse(browser_view()->GetWidget(), type,
+                                  screen_point);
+  }
+
+  // Presses on `from`, moves to `to` in eight even steps, releases: a
+  // person's drag. The steps go to the views directly: the Mac event
+  // generator's MoveMouseTo(point, count) re-bases every step on the one it
+  // just sent and runs far past `to` before the release.
+  void Drag(const gfx::Point& from, const gfx::Point& to) {
+    SendMouse(ui::EventType::kMousePressed, from);
+    for (int step = 1; step <= 8; ++step) {
+      SendMouse(ui::EventType::kMouseDragged,
+                gfx::Point(from.x() + (to.x() - from.x()) * step / 8,
+                           from.y() + (to.y() - from.y()) * step / 8));
+    }
+    SendMouse(ui::EventType::kMouseReleased, to);
+  }
+
+  void Collapse() {
+    vertical_tab_strip_state_controller()->RequestCollapse(true);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+    ASSERT_TRUE(vertical_tab_strip_state_controller()->IsCollapsed());
+  }
+
+  // spaces B27 (PLAN.md SPC-6): the third chip dragged between the first
+  // two lands second, in this window, in a window already open and in one
+  // opened after.
+  void DragTheThirdChipSecond(bool along_y) {
+    BrowserWindowInterface* const open = CreateBrowser(browser()->GetProfile());
+    ASSERT_TRUE(spaces::SpaceModel::From(open));
+    browser_view()->GetWidget()->Activate();
+    const auto chips = Chips();
+    ASSERT_EQ(3u, chips.size());
+    const gfx::Point first = chips[0].first;
+    const gfx::Point second = chips[1].first;
+    // Between the two, nearer the second: a chip takes the slot of the chip
+    // it is dropped nearest to.
+    const gfx::Point between(first.x() + (second.x() - first.x()) * 3 / 4,
+                             first.y() + (second.y() - first.y()) * 3 / 4);
+    ASSERT_NE(along_y ? first.y() : first.x(),
+              along_y ? second.y() : second.x())
+        << "the chips run along the other axis";
+    Drag(chips[2].first, between);
+    const std::vector<spaces::SpaceId> expected = {ids_[0], ids_[2], ids_[1]};
+    ASSERT_TRUE(base::test::RunUntil([&]() { return Order() == expected; }));
+    EXPECT_EQ(expected, OrderIn(open)) << "a window already open follows";
+    EXPECT_EQ(expected, OrderIn(CreateBrowser(browser()->GetProfile())))
+        << "the order is the profile's";
+  }
+
+  static std::vector<spaces::SpaceId> OrderIn(BrowserWindowInterface* window) {
+    std::vector<spaces::SpaceId> order;
+    if (spaces::SpaceModel* const model = spaces::SpaceModel::From(window)) {
+      for (const auto& space : model->spaces()) {
+        order.push_back(space->id());
+      }
+    }
+    return order;
+  }
+
+  spaces::SpaceSwitcherView* Switcher() {
+    return FindDrawnSwitcher(browser_view()->GetWidget()->GetRootView());
+  }
+
+  // Builds the tab menu for the tab at `index` the way a right click on the
+  // horizontal strip does, through BrowserTabStripController, and runs row
+  // `row` of the submenu `submenu`. Only the native menu is not shown.
+  void RunHorizontalTabMenuRow(int index,
+                               TabStripModel::ContextMenuCommand submenu,
+                               size_t row) {
+    TabStrip* const strip = browser_view()->horizontal_tab_strip_for_testing();
+    ASSERT_TRUE(strip);
+    auto* const strip_controller =
+        static_cast<BrowserTabStripController*>(strip->controller());
+    TabContextMenuController controller(
+        tab_strip_model()->GetTabAtIndex(index)->GetHandle(), strip_controller);
+    auto menu = std::make_unique<TabMenuModel>(
+        &controller, TabMenuModelDelegate::From(browser()), tab_strip_model(),
+        index);
+    TabMenuModel* const built = menu.get();
+    controller.LoadModel(std::move(menu), built);
+    const std::optional<size_t> at = built->GetIndexOfCommandId(submenu);
+    ASSERT_TRUE(at.has_value()) << "the menu has no such submenu";
+    ui::MenuModel* const rows = built->GetSubmenuModelAt(*at);
+    ASSERT_TRUE(rows);
+    ASSERT_GT(rows->GetItemCount(), row);
+    ASSERT_TRUE(rows->IsEnabledAt(row));
+    rows->ActivatedAt(row);
+  }
+
+  std::vector<spaces::SpaceId> ids_;
+};
+
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, TheSpaceCommandsShowThatSpace) {
+  MakeThreeSpaces();
+  Run(IDC_STEDDING_SPACE_2);
+  ExpectShowing(ids_[1]);
+  Run(IDC_STEDDING_SPACE_3);
+  ExpectShowing(ids_[2]);
+  Run(IDC_STEDDING_SPACE_1);
+  ExpectShowing(ids_[0]);
+  // B18: a number past the last Space does nothing.
+  Run(IDC_STEDDING_SPACE_9);
+  ExpectShowing(ids_[0]);
+}
+
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, NextAndPreviousStopAtTheEnds) {
+  MakeThreeSpaces();
+  Run(IDC_STEDDING_SPACE_PREVIOUS);
+  ExpectShowing(ids_[0]);
+  Run(IDC_STEDDING_SPACE_NEXT);
+  ExpectShowing(ids_[1]);
+  Run(IDC_STEDDING_SPACE_NEXT);
+  ExpectShowing(ids_[2]);
+  Run(IDC_STEDDING_SPACE_NEXT);
+  ExpectShowing(ids_[2]);
+  Run(IDC_STEDDING_SPACE_PREVIOUS);
+  ExpectShowing(ids_[1]);
+}
+
+// B3: the tab that was last active in a Space is the one it comes back to.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, ASpaceComesBackToItsLastTab) {
+  MakeThreeSpaces();
+  Run(IDC_STEDDING_SPACE_2);
+  tabs::TabInterface* last = nullptr;
+  for (int i = 0; i < tab_strip_model()->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(i);
+    if (model()->SpaceForTab(tab) == ids_[1] &&
+        tab != tab_strip_model()->GetActiveTab()) {
+      last = tab;
+    }
