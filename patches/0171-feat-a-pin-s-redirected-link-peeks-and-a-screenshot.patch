+// P23 (BACKLOG S-93, PLAN.md WIN-18): the screenshot keys take the peek on
+// top, not the pin under it.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, AScreenshotTakesThePeekNotThePin) {
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::ScopedTempDir downloads;
+  ASSERT_TRUE(downloads.CreateUniqueTempDir());
+  browser()->GetProfile()->GetPrefs()->SetFilePath(
+      prefs::kDownloadDefaultDirectory, downloads.GetPath());
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  ASSERT_TRUE(WaitForPeek(pin));
+  content::WebContents* const page =
+      stedding::PeekOverPageOfActiveTab(browser());
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kVisible);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !PngsIn(downloads.GetPath()).empty(); }))
+      << "no capture was written";
+  const std::string name =
+      PngsIn(downloads.GetPath()).front().BaseName().AsUTF8Unsafe();
+  EXPECT_NE(std::string::npos, name.find("b.test")) << name;
+}
