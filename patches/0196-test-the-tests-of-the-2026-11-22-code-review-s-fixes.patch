+// P13-1a, sidebar-file Sf23, Sf37: a Space another computer deleted while
+// sync was off here is asked about when sync is set up again, as at any read
+// of that computer's file. The join took the deletion with no question: the
+// Space went at once, its pins to a neighbour and its own session's jar with
+// it.
+IN_PROC_BROWSER_TEST_F(SidebarSyncB11Test,
+                       ASpaceDeletedElsewhereWaitsForTheUserAtARejoin) {
+  ASSERT_NO_FATAL_FAILURE(Join());
+  spaces::Space* const made = model().AddSpace("Kept here", SK_ColorBLUE);
+  ASSERT_TRUE(made);
+  const spaces::SpaceId id = made->id();
+  const std::string space = id.ToString();
+  service()->CommitForTesting();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const sb::ParsedFile own = ReadOwnFile();
+    return own.status == sb::ParseStatus::kOk &&
+           own.state.records.contains(space);
+  }));
+  // Every write the join started is done.
+  content::RunAllTasksUntilIdle();
+  const sb::ParsedFile own = ReadOwnFile();
+  ASSERT_EQ(sb::ParseStatus::kOk, own.status);
+  ASSERT_TRUE(own.state.records.contains(space));
+  service()->Stop(/*remove_own_file=*/false);
+  ASSERT_FALSE(service()->enabled());
+
+  // The other computer read this one's file, then deleted the Space while
+  // sync was off here.
+  sb::State office = own.state;
+  office.records[space].del = sb::Stamp{NowMsB11() + 60'000, kOfficeB11};
+  ASSERT_NO_FATAL_FAILURE(WriteOffice(office, 1));
+  ASSERT_NO_FATAL_FAILURE(Join());
+  EXPECT_TRUE(registry().Find(id))
+      << "the join deleted the Space with no question";
+
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  EXPECT_TRUE(registry().Find(id)) << "deleted at the first read";
+  EXPECT_TRUE(Decision(std::string("batch:") + kOfficeB11))
+      << "no Delete here / Keep row for the deletion";
+}
+
+// P13-1d, sidebar-file Sf15, folders F47: a pinned folder another computer
+// moved to another Space moves here too, whole, with its pins. Its place was
+// never read, so it stayed in the first Space for good.
+IN_PROC_BROWSER_TEST_F(SidebarSyncB11Test,
+                       AFolderMovedToAnotherSpaceElsewhereMovesHere) {
+  ASSERT_NO_FATAL_FAILURE(Join());
+  const spaces::SpaceId first = model().active_id();
+  spaces::Space* const made = model().AddSpace("Second", SK_ColorBLUE);
+  ASSERT_TRUE(made);
+  const spaces::SpaceId second = made->id();
+  tabs::TabInterface* const pin = OpenPin();
+  ASSERT_TRUE(pin);
+  tabs::FolderTabCollection* const folder = MakePinnedFolder({pin});
+  ASSERT_TRUE(folder);
+  ASSERT_TRUE(model().IsFolderSpacePinned(folder));
+  // Another tab in front: a change to the tab the user is on waits until they
+  // leave it (Sf21).
+  ASSERT_TRUE(OpenTabInFront());
+  ASSERT_NE(pin, tabs().GetActiveTab());
+  ASSERT_EQ(first, model().FindSpaceForTab(pin));
+  service()->CommitForTesting();
+  const std::string folder_id = spaces::FolderSyncId(folder->id());
+  ASSERT_TRUE(LedgerRecord(folder_id));
+  ASSERT_EQ(sb::PinsListOf(first.ToString()),
+            LedgerRecord(folder_id)->Get(sb::kFieldParent));
+  ASSERT_TRUE(LedgerRecord(IdOf(pin)));
+
+  // The other computer moves the folder to the second Space.
+  sb::State office = service()->ledger_for_testing()->state;
+  const sb::Stamp later{NowMsB11() + 60'000, kOfficeB11};
+  office.records[folder_id].f[sb::kFieldParent] =
+      sb::Field{sb::PinsListOf(second.ToString()), later};
+  std::erase(office.lists[sb::PinsListOf(first.ToString())].order, folder_id);
+  office.lists[sb::PinsListOf(first.ToString())].s = later;
+  office.lists[sb::PinsListOf(second.ToString())].order = {folder_id};
+  office.lists[sb::PinsListOf(second.ToString())].s = later;
+  ASSERT_NO_FATAL_FAILURE(WriteOffice(office, 1));
+  ASSERT_NO_FATAL_FAILURE(Scan());
+
+  EXPECT_EQ(second, model().FindSpaceForTab(pin)) << "the folder stayed";
+  EXPECT_EQ(folder, pin->GetParentCollection()) << "the pin left its folder";
+  ASSERT_TRUE(folder->GetParentCollection());
+  EXPECT_EQ(tabs::TabCollection::Type::UNPINNED,
+            folder->GetParentCollection()->type());
+  EXPECT_TRUE(model().IsSpacePinned(pin));
+  EXPECT_TRUE(model().IsFolderSpacePinned(folder))
+      << "the folder left the pinned run";
+  const sb::LocalView view = sb::BuildLocalView(browser()->GetProfile(), {});
+  ASSERT_TRUE(view.items.contains(folder_id));
+  EXPECT_EQ(sb::PinsListOf(second.ToString()),
+            view.items.at(folder_id).fields.at(sb::kFieldParent));
+}
