+spaces::SpaceSwitcherView* FindDrawnSwitcher(views::View* view) {
+  if (auto* const switcher =
+          views::AsViewClass<spaces::SpaceSwitcherView>(view);
+      switcher && switcher->IsDrawn()) {
+    return switcher;
+  }
+  for (views::View* const child : view->children()) {
+    if (spaces::SpaceSwitcherView* const found = FindDrawnSwitcher(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+TabGroupHeaderView* FindDrawnGroupHeader(views::View* view) {
+  if (auto* const header = views::AsViewClass<TabGroupHeaderView>(view);
+      header && header->IsDrawn()) {
+    return header;
+  }
+  for (views::View* const child : view->children()) {
+    if (TabGroupHeaderView* const found = FindDrawnGroupHeader(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// Whether `tab` sits in `folder`, directly or in a folder inside it.
+bool IsIn(const tabs::TabInterface* tab,
+          const tabs::FolderTabCollection* folder) {
+  for (const tabs::TabCollection* parent = tab->GetParentCollection(); parent;
+       parent = parent->GetParentCollection()) {
+    if (parent == folder) {
+      return true;
+    }
+  }
+  return false;
+}
