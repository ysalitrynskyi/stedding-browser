+  const gfx::Rect page = Page();
+
+  // The row brings them, at its end, and they go with it.
+  ASSERT_NO_FATAL_FAILURE(RevealFromTheTop(generator));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return corner->GetVisible(); }))
