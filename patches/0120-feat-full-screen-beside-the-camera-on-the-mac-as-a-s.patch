diff --git a/chrome/test/stedding/camera_row_browsertest.mm b/chrome/test/stedding/camera_row_browsertest.mm
new file mode 100644
index 0000000000000..80a67335c4739
--- /dev/null
+++ b/chrome/test/stedding/camera_row_browsertest.mm
@@ -0,0 +1,367 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/toolbar.md T55-T59 (BACKLOG S-392): on a Mac whose screen has
+// a camera housing, with "Use the row beside the camera in full screen" on,
+// full screen the person starts is Stedding's own: the window covers the
+// screen, borderless, the address row in the row beside the camera and
+// nothing of it under the housing. A test stands in a housing for the screen
+// the window is on, whatever the machine's own.
+
+#import <Cocoa/Cocoa.h>
+
+#include <algorithm>
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/address_row.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding/theme/page_theme_color_controller.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/multi_contents_view.h"
+#import "chrome/browser/ui/views/frame/stedding_camera_row_mac.h"
+#include "chrome/browser/ui/views/frame/toolbar_button_provider.h"
+#include "chrome/browser/ui/views/frame/top_container_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/browser/ui/views/toolbar/reload_button.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "chrome/common/chrome_switches.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/browser_test.h"
+#include "ui/base/mojom/window_show_state.mojom.h"
+#include "ui/base/test/scoped_fake_nswindow_fullscreen.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/native_widget_private.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+using Housing = stedding::CameraRowFullscreenMac::Housing;
+
+class CameraRowTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    // A 14-inch screen's housing, 185 points across the middle of whichever
+    // screen the window is on.
+    const NSRect screen = window().screen.frame;
+    const int middle = static_cast<int>(NSWidth(screen) / 2);
+    housing_ = Housing{.height = 32, .left = middle - 92, .right = middle + 93};
+    stedding::CameraRowFullscreenMac::SetHousingForTesting(housing_);
+  }
+
+  void TearDownOnMainThread() override {
+    stedding::CameraRowFullscreenMac::SetHousingForTesting(std::nullopt);
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  NSWindow* window() {
+    return browser_view()->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  }
+  const std::optional<stedding::AddressRow::CameraRow>& camera_row() {
+    return stedding::AddressRow::From(browser())->camera_row();
+  }
+  void SetSwitch(bool on) {
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kCameraRowFullscreen, on);
+  }
+  void Layout() { views::test::RunScheduledLayout(browser_view()->GetWidget()); }
+  // `view`'s bounds in the window's own coordinates.
+  gfx::Rect InWindow(views::View* view) {
+    return view->ConvertRectToWidget(view->GetLocalBounds());
+  }
+
+  Housing housing_;
+};
+
+// T55, T59: the green button enters it and the chord leaves it. The window
+// covers its screen, borderless, and comes back to the frame it had; the
+// session meanwhile keeps that frame, not the whole screen.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, FullScreenTakesTheWholeScreenAndComesBack) {
+  SetSwitch(true);
+  NSWindow* const ns_window = window();
+  const NSRect before = ns_window.frame;
+  const NSUInteger style = ns_window.styleMask;
+  ASSERT_NE(NSWidth(before), NSWidth(ns_window.screen.frame))
+      << "the test window already covers its screen";
+
+  // The green button sends AppKit's toggle with itself as the sender.
+  [ns_window toggleFullScreen:[ns_window standardWindowButton:NSWindowZoomButton]];
+  Layout();
+  ASSERT_TRUE(camera_row()) << "the green button did not enter it";
+  EXPECT_EQ(32, camera_row()->height);
+  EXPECT_TRUE(NSEqualRects(ns_window.frame, ns_window.screen.frame));
+  EXPECT_EQ(0u, ns_window.styleMask & NSWindowStyleMaskTitled);
+  EXPECT_FALSE(ns_window.movable);
+  EXPECT_FALSE(browser_view()->GetWidget()->IsFullscreen())
+      << "it is not macOS's full screen";
+  gfx::Rect saved;
+  ui::mojom::WindowShowState state;
+  browser_view()->GetWidget()->native_widget_private()->GetWindowPlacement(
+      &saved, &state);
+  EXPECT_EQ(gfx::ScreenRectFromNSRect(before), saved);
+
+  chrome::ToggleFullscreenMode(browser());
+  Layout();
+  EXPECT_FALSE(camera_row());
+  EXPECT_TRUE(NSEqualRects(ns_window.frame, before));
+  EXPECT_EQ(style, ns_window.styleMask);
+  EXPECT_TRUE(ns_window.movable);
+}
+
+// T55: with the switch off, or on a screen without a housing, full screen is
+// macOS's own.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, WithTheSwitchOffFullScreenIsMacOSs) {
+  ui::test::ScopedFakeNSWindowFullscreen fake_fullscreen;
+  for (const bool switch_on : {false, true}) {
+    SCOPED_TRACE(switch_on ? "no housing" : "the switch off");
+    SetSwitch(switch_on);
+    if (switch_on) {
+      stedding::CameraRowFullscreenMac::SetHousingForTesting(Housing());
+    }
+    chrome::ToggleFullscreenMode(browser());
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return browser_view()->GetWidget()->IsFullscreen(); }));
+    EXPECT_FALSE(camera_row());
+    chrome::ToggleFullscreenMode(browser());
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return !browser_view()->GetWidget()->IsFullscreen(); }));
+  }
+}
+
+// T56: the row is the row beside the camera: the safe area's height at the
+// window's top, Back, Forward and Reload left of the housing, the field from
+// just past it, nothing of the row under it, on the window's colour, and the
+// card a gutter under the row.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, TheRowSitsBesideTheCamera) {
+  SetSwitch(true);
+  chrome::ToggleFullscreenMode(browser());
+  Layout();
+  ASSERT_TRUE(camera_row());
+  ASSERT_TRUE(browser_view()->IsToolbarVisible());
+  ToolbarView* const toolbar = browser_view()->toolbar();
+  const gfx::Rect row = InWindow(toolbar);
+  EXPECT_EQ(0, row.y());
+  EXPECT_EQ(32, row.height());
+  for (views::View* const button :
+       {static_cast<views::View*>(
+            browser_view()->toolbar_button_provider()->GetBackButton()),
+        static_cast<views::View*>(toolbar->forward_button()),
+        static_cast<views::View*>(toolbar->reload_button())}) {
+    if (button && button->GetVisible()) {
+      EXPECT_LE(InWindow(button).right(), housing_.left)
+          << button->GetClassName() << " at " << InWindow(button).ToString();
+    }
+  }
+  const gfx::Rect field = InWindow(toolbar->location_bar_view());
+  EXPECT_GE(field.x(), housing_.right) << field.ToString();
+  EXPECT_LE(field.x(), housing_.right + 16) << field.ToString();
+  EXPECT_LE(field.bottom(), 32);
+  // Nothing drawn under the housing: the row's own spacers, empty views
+  // that only take its width, are all that may span it.
+  for (views::View* const child : toolbar->children()) {
+    if (!child->GetVisible() || child->bounds().IsEmpty() ||
+        std::string(child->GetClassName()) == "View" ||
+        std::string(child->GetClassName()) == "SteddingRowSpacer") {
+      continue;
+    }
+    const gfx::Rect bounds = InWindow(child);
+    EXPECT_TRUE(bounds.right() <= housing_.left ||
+                bounds.x() >= housing_.right)
+        << child->GetClassName() << " at " << bounds.ToString()
+        << " is under the housing";
+  }
+  const gfx::Rect card = InWindow(browser_view()->multi_contents_view());
+  EXPECT_GE(card.y(), 32) << card.ToString();
+  EXPECT_LE(card.y(), 32 + 12) << card.ToString();
+  const stedding::PageThemeColorController* const colours =
+      stedding::PageThemeColorController::From(browser());
+  ASSERT_TRUE(colours);
+  EXPECT_TRUE(colours->bar_suppressed());
+  EXPECT_FALSE(colours->color());
+
+  chrome::ToggleFullscreenMode(browser());
+  Layout();
+  EXPECT_FALSE(colours->bar_suppressed());
+}
+
+// T57: beside the camera the row always shows; the address in the sidebar
+// comes to it, with the row's buttons, and goes back after.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, TheAddressLeavesTheSidebarForTheRow) {
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      stedding::prefs::kSidebarAddressInSidebar, true);
+  // The buttons move after the layout that asks for it.
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    Layout();
+    return !browser_view()->IsToolbarVisible() &&
+           browser_view()->toolbar()->stedding_buttons_host() != nullptr;
+  })) << "the address and its buttons did not go to the sidebar";
+
+  SetSwitch(true);
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    Layout();
+    return browser_view()->toolbar()->stedding_buttons_host() == nullptr;
+  })) << "the row's buttons stayed in the sidebar";
+  EXPECT_TRUE(browser_view()->IsToolbarVisible());
+
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    Layout();
+    return browser_view()->toolbar()->stedding_buttons_host() != nullptr;
+  })) << "the row's buttons did not go back to the sidebar";
+  EXPECT_FALSE(browser_view()->IsToolbarVisible());
+}
+
+// T58: a page's own full screen from it is macOS's: the window turns ordinary
+// for it and comes back to the row beside the camera after.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, AVideosFullScreenIsMacOSsAndComesBack) {
+  ui::test::ScopedFakeNSWindowFullscreen fake_fullscreen;
+  SetSwitch(true);
+  NSWindow* const ns_window = window();
+  const NSRect before = ns_window.frame;
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(camera_row());
+
+  // What a page's request comes to (BrowserView::ProcessFullscreen).
+  browser_view()->GetWidget()->SetFullscreen(true);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return browser_view()->GetWidget()->IsFullscreen(); }));
+  EXPECT_FALSE(camera_row());
+  EXPECT_NE(0u, ns_window.styleMask & NSWindowStyleMaskTitled);
+
+  browser_view()->GetWidget()->SetFullscreen(false);
+  ASSERT_TRUE(base::test::RunUntil([&] { return camera_row().has_value(); }))
+      << "the row beside the camera did not come back";
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    return NSEqualRects(ns_window.frame, ns_window.screen.frame);
+  })) << "back beside the camera, the window does not cover its screen: "
+      << NSStringFromRect(ns_window.frame).UTF8String << " on "
+      << NSStringFromRect(ns_window.screen.frame).UTF8String;
+
+  chrome::ToggleFullscreenMode(browser());
+  EXPECT_FALSE(camera_row());
+  EXPECT_TRUE(NSEqualRects(ns_window.frame, before));
+}
+
+// T59: the switch turned off in it leaves it.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, TurningTheSwitchOffLeaves) {
+  SetSwitch(true);
+  NSWindow* const ns_window = window();
+  const NSRect before = ns_window.frame;
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(camera_row());
+  SetSwitch(false);
+  EXPECT_FALSE(camera_row());
+  EXPECT_TRUE(NSEqualRects(ns_window.frame, before));
+  EXPECT_NE(0u, ns_window.styleMask & NSWindowStyleMaskTitled);
+}
+
+// T59: File > Close Window (performClose:, ⇧⌘W) closes the window in it: the
+// borderless window keeps the closable style, with no button drawn for it.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, ItClosesFromTheFileMenu) {
+  SetSwitch(true);
+  NSWindow* const ns_window = window();
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(camera_row());
+  EXPECT_NE(0u, ns_window.styleMask & NSWindowStyleMaskClosable);
+  EXPECT_EQ(0u, ns_window.styleMask & NSWindowStyleMaskTitled)
+      << "the window has a title bar, and with it a close button";
+  [ns_window performClose:nil];
+  ui_test_utils::WaitForBrowserToClose(browser());
+}
+
+// T59: while it is on, the window's restored bounds are the frame from
+// before: what the session keeps and what a tab torn out of the window starts
+// from, not the whole screen. Afterwards they are the window's own again.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, TheRestoredBoundsAreTheFrameFromBefore) {
+  SetSwitch(true);
+  NSWindow* const ns_window = window();
+  const NSRect before = ns_window.frame;
+  views::Widget* const widget = browser_view()->GetWidget();
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(camera_row());
+  EXPECT_EQ(gfx::ScreenRectFromNSRect(before), widget->GetRestoredBounds());
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_FALSE(camera_row());
+  EXPECT_EQ(gfx::ScreenRectFromNSRect(ns_window.frame),
+            widget->GetRestoredBounds());
+}
+
+// T59: dragging the window's only tab moves nothing while it is on: the move
+// loop a drag of every tab runs is refused, and the window stays over its
+// screen.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, DraggingTheOnlyTabLeavesTheWindowStill) {
+  SetSwitch(true);
+  NSWindow* const ns_window = window();
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(camera_row());
+  const NSRect frame = ns_window.frame;
+  EXPECT_EQ(views::Widget::MoveLoopResult::kCanceled,
+            browser_view()->GetWidget()->RunMoveLoop(
+                gfx::Vector2d(40, 40), views::Widget::MoveLoopSource::kMouse,
+                views::Widget::MoveLoopEscapeBehavior::kDontHide));
+  EXPECT_TRUE(NSEqualRects(frame, ns_window.frame));
+  chrome::ToggleFullscreenMode(browser());
+  EXPECT_FALSE(camera_row());
+}
+
+// T59: leaving puts the window back on a screen. A frame from before that no
+// longer fits one -- a lid closed or a display unplugged meanwhile -- is
+// moved into the visible area of the screen that holds most of it.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, LeavingPutsTheWindowOnAScreen) {
+  SetSwitch(true);
+  NSWindow* const ns_window = window();
+  const NSRect area = ns_window.screen.visibleFrame;
+  // Half the window past the screen's right edge.
+  NSRect hanging = ns_window.frame;
+  hanging.size.width = std::min(NSWidth(hanging), NSWidth(area) - 40);
+  hanging.origin.x = NSMaxX(area) - NSWidth(hanging) / 2;
+  [ns_window setFrame:hanging display:YES animate:NO];
+  ASSERT_GT(NSMaxX(ns_window.frame), NSMaxX(area));
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(camera_row());
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_FALSE(camera_row());
+  EXPECT_TRUE(NSContainsRect(area, ns_window.frame))
+      << "the window came back off the screen";
+  EXPECT_EQ(NSWidth(hanging), NSWidth(ns_window.frame));
+}
+
+// T55: a kiosk launch keeps macOS's full screen, whose presentation options
+// (the Dock and the menu bar hidden for good) this mode's would clash with.
+IN_PROC_BROWSER_TEST_F(CameraRowTest, AKioskLaunchDoesNotUseIt) {
+  ui::test::ScopedFakeNSWindowFullscreen fake_fullscreen;
+  SetSwitch(true);
+  base::CommandLine::ForCurrentProcess()->AppendSwitch(switches::kKioskMode);
+  chrome::ToggleFullscreenMode(browser());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return browser_view()->GetWidget()->IsFullscreen(); }));
+  EXPECT_FALSE(camera_row());
+  // Out of macOS's full screen the way a kiosk never is, before the switch
+  // goes: a toggle without it would be this mode's to answer.
+  browser_view()->GetWidget()->SetFullscreen(false);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !browser_view()->GetWidget()->IsFullscreen(); }));
+  base::CommandLine::ForCurrentProcess()->RemoveSwitch(switches::kKioskMode);
+}
+
+}  // namespace
