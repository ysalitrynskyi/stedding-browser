+// motion O9 (GitHub issue 45): the sidebar's speed. Normal runs the collapse
+// and the expand over their times, Fast over half of them, and Instant ends
+// each at once with the strip at its end width. The motions' own times, which
+// place their keyframes, are the same at every speed.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest, TheSidebarsSpeedSetsItsMotions) {
+  if (!Animates()) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
+  const BrowserAnimationController* const controller =
+      BrowserAnimationController::From(browser());
+  const auto time_of = [&](BrowserAnimationMotion motion) {
+    return controller
+        ->GetMotionSpecificationForTesting(
+            TabStripAnimations::kVerticalTabStrip, motion)
+        ->GetDuration();
+  };
+  const base::TimeDelta collapse = time_of(TabStripAnimations::kCollapse);
+  const base::TimeDelta expand = time_of(TabStripAnimations::kExpand);
+  ASSERT_TRUE(collapse.is_positive());
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  const struct {
+    int speed;
+    double scale;
+    const char* trace;
+  } kSpeeds[] = {
+      {stedding::prefs::kSidebarAnimationNormal, 1.0, "Normal"},
+      {stedding::prefs::kSidebarAnimationFast, 0.5, "Fast"},
+      {stedding::prefs::kSidebarAnimationInstant, 0.0, "Instant"},
+  };
+  for (const auto& each : kSpeeds) {
+    SCOPED_TRACE(each.trace);
+    prefs->SetInteger(stedding::prefs::kSidebarAnimationSpeed, each.speed);
+    for (const bool to_rail : {true, false}) {
+      SCOPED_TRACE(to_rail ? "collapse" : "expand");
+      vertical_tab_strip_state_controller()->RequestCollapse(to_rail);
+      EXPECT_EQ((to_rail ? collapse : expand) * each.scale,
+                controller->GetLastRunDurationForTesting(
+                    TabStripAnimations::kVerticalTabStrip));
+      if (each.scale == 0.0) {
+        EXPECT_FALSE(StripAnimating()) << "Instant still moved";
+      }
+      ASSERT_TRUE(base::test::RunUntil([&]() { return !StripAnimating(); }));
+      EXPECT_EQ(to_rail, vertical_tab_strip_state_controller()->IsCollapsed());
+      views::test::RunScheduledLayout(widget());
+      if (to_rail) {
+        EXPECT_LT(region()->width(), 100) << "not the rail";
+      } else {
+        EXPECT_GT(region()->width(), 150) << "not open";
+      }
+      EXPECT_EQ((to_rail ? collapse : expand),
+                time_of(to_rail ? TabStripAnimations::kCollapse
+                                : TabStripAnimations::kExpand))
+          << "the motion's own time changed";
+    }
+  }
+}
