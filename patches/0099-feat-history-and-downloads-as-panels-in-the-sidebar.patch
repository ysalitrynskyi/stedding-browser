+// Pn7: the panel never leaves chrome://stedding-library: a script's
+// navigation is refused and a new window is not made.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsTest, APanelNeverNavigatesItself) {
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kHistory));
+  content::WebContents* const page = panel_page();
+  const GURL away = embedded_test_server()->GetURL("a.test", "/title1.html");
+  // The navigation is refused as it begins: no request is made for it.
+  ASSERT_TRUE(content::ExecJs(page, content::JsReplace("location.href = $1",
+                                                       away)));
+  // A round trip to the page after the script, so its request has come.
+  ASSERT_TRUE(content::ExecJs(page, "true"));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !page->IsLoading() &&
+           page->GetLastCommittedURL() == GURL(stedding::kLibraryHistoryURL);
+  })) << page->GetLastCommittedURL();
+  EXPECT_EQ(panel_page(), page);
+
+  const int tab_count = tabs()->count();
+  ASSERT_TRUE(content::ExecJs(
+      page, content::JsReplace("window.open($1)", away)));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(tab_count, tabs()->count());
+  EXPECT_EQ(GURL(stedding::kLibraryHistoryURL), page->GetLastCommittedURL());
+}
