+#!/usr/bin/env python3
+# Copyright 2026 The Stedding Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""The Mac's CFBundleVersion for each Stedding version (updates Up11).
+
+Sparkle and LaunchServices compare CFBundleVersion number by number, so every
+release's must sort above the one before it, including the numbers already
+shipped. Releases go on past 0.7.9 to 0.7.10 (PLAN.md decision 28).
+
+Run: python3 build/apple/audit_b01_unittest.py
+"""
+
+import os
+import sys
+import unittest
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import tweak_info_plist
+
+# The highest CFBundleVersion a release carried before patch numbers past 9
+# were possible: 0.7.0 (updates/appcast.xml).
+SHIPPED_0_7_0 = '10070.999'
+
+
+def _Key(bundle_version):
+    """The numbers Sparkle and LaunchServices compare, in order."""
+    return tuple(int(part) for part in bundle_version.split('.'))
+
+
+class SteddingBundleVersionB01Test(unittest.TestCase):
+
+    def _Version(self, version):
+        bundle_version = tweak_info_plist._SteddingBundleVersion(version)
+        self.assertIsNotNone(bundle_version,
+                             '%s has no CFBundleVersion' % version)
+        parts = bundle_version.split('.')
+        # Two numbers, as LaunchServices wants.
+        self.assertEqual(2, len(parts), bundle_version)
+        for part in parts:
+            self.assertTrue(part.isdigit(), bundle_version)
+        return bundle_version
+
+    # P01-1b, updates Up11, PLAN.md decision 28.
+    def test_aTwoDigitPatchHasABundleVersion(self):
+        for version in ('0.7.10', '0.7.10-beta.1', '0.7.99', '0.99.99'):
+            self._Version(version)
+
+    # P01-1b, updates Up11: every version sorts after the one before it, and
+    # the first after the shipped 0.7.0 sorts above it.
+    def test_versionsSortInReleaseOrderAfterWhatShipped(self):
+        in_order = [
+            '0.7.1-beta.1',
+            '0.7.1',
+            '0.7.2',
+            '0.7.9',
+            '0.7.10-beta.1',
+            '0.7.10-beta.998',
+            '0.7.10',
+            '0.7.11',
+            '0.7.99',
+            '0.8.0-beta.1',
+            '0.8.0',
+            '0.10.0',
+            '0.99.99',
+            '1.0.0-beta.1',
+            '1.0.0',
+            '1.0.1',
+            '1.1.0',
+            '2.0.0',
+        ]
+        keys = [_Key(SHIPPED_0_7_0)]
+        keys += [_Key(self._Version(version)) for version in in_order]
+        for earlier, later, name in zip(keys, keys[1:], in_order):
+            self.assertLess(earlier, later, '%s does not sort after the '
+                            'version before it' % name)
+
+    # P01-1b, updates Up11: no number the earlier scheme could give a 0.x
+    # release (at most 10999.999) sorts above a new one, so an installed
+    # build always sees the next release as newer.
+    def test_everyNewNumberIsAboveTheEarlierScheme(self):
+        earlier_highest = _Key('%d.999' % (10000 + 10 * 99 + 9))
+        for version in ('0.0.1-beta.1', '0.7.1', '0.7.10'):
+            self.assertLess(earlier_highest, _Key(self._Version(version)),
+                            version)
+
+    # updates Up11: anything without room stays refused, so the build stops.
+    def test_versionsWithoutRoomAreRefused(self):
+        for version in ('0.7.100', '0.100.0', '0.7.10-beta.0',
+                        '0.7.10-beta.999', 'v0.7.10', '0.7', '0.7.10-rc.1'):
+            self.assertIsNone(
+                tweak_info_plist._SteddingBundleVersion(version), version)
+
+
+if __name__ == '__main__':
+    unittest.main()
