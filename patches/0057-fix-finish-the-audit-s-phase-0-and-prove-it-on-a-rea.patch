+  EXPECT_EQ(std::string::npos, name.find('/')) << name;
+  EXPECT_EQ(0u, name.find("Stedding ")) << name;
+  EXPECT_NE(std::string::npos, name.find(" 2026-09-28 12.34.56.png")) << name;
+}
+
+// screenshot C4, PLAN.md WIN-2: two captures in the same second leave two
+// files, the second named " 2", and the first is not written over.
+TEST(ScreenshotFileTest, TwoCapturesInOneSecondLeaveTwoFiles) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath name =
+      base::FilePath::FromUTF8Unsafe("Stedding a.test 2026-09-28 12.34.56.png");
+  const std::vector<uint8_t> first = {1, 2, 3};
+  const std::vector<uint8_t> second = {4, 5};
+
+  const base::FilePath a = WriteNewScreenshotFile(dir.GetPath(), name, first);
+  const base::FilePath b = WriteNewScreenshotFile(dir.GetPath(), name, second);
+  EXPECT_EQ(dir.GetPath().Append(name), a);
+  EXPECT_EQ(dir.GetPath().Append(base::FilePath::FromUTF8Unsafe(
+                "Stedding a.test 2026-09-28 12.34.56 2.png")),
+            b);
+  EXPECT_EQ(first, base::ReadFileToBytes(a));
+  EXPECT_EQ(second, base::ReadFileToBytes(b));
+}
+
+// The Downloads folder may not exist yet on a fresh account.
+TEST(ScreenshotFileTest, MakesTheFolder) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath downloads = dir.GetPath().AppendASCII("Downloads");
+  const base::FilePath written = WriteNewScreenshotFile(
+      downloads, base::FilePath::FromUTF8Unsafe("Stedding a.test.png"),
+      std::vector<uint8_t>{7});
+  EXPECT_EQ(downloads.AppendASCII("Stedding a.test.png"), written);
+  EXPECT_TRUE(base::PathExists(written));
+}
+
+// PLAN.md WIN-2: with every name taken the write fails; it used to replace
+// the last file.
+TEST(ScreenshotFileTest, NeverReplacesAFile) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath name = base::FilePath::FromUTF8Unsafe("Stedding a.png");
+  std::vector<base::FilePath> taken = {dir.GetPath().Append(name)};
+  for (int i = 2; i <= kScreenshotNameAttempts; ++i) {
+    taken.push_back(dir.GetPath().Append(
+        name.InsertBeforeExtensionASCII(" " + base::NumberToString(i))));
+  }
+  for (const base::FilePath& path : taken) {
+    ASSERT_TRUE(base::WriteFile(path, "old"));
+  }
+
+  EXPECT_TRUE(
+      WriteNewScreenshotFile(dir.GetPath(), name, std::vector<uint8_t>{9})
+          .empty());
+  for (const base::FilePath& path : taken) {
+    std::string contents;
+    ASSERT_TRUE(base::ReadFileToString(path, &contents));
+    EXPECT_EQ("old", contents) << path;
+  }
+}
+
+}  // namespace
+}  // namespace stedding
