+  resource_sampler_ = std::make_unique<stedding::TabResourceSampler>(
+      contents, kResourceLineInterval,
+      base::BindRepeating(&TabHoverCardController::OnResourceFigures,
+                          weak_ptr_factory_.GetWeakPtr()));
+}
+
+void TabHoverCardController::OnResourceFigures(
