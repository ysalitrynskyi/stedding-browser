+namespace {
+
+// Stedding (folders F39): how many folders hold `collection`, itself
+// included when it is one. The unpinned collection is at depth 0.
+size_t FolderDepth(const TabCollection* collection) {
+  size_t depth = 0;
+  for (const TabCollection* each = collection; each;
+       each = each->GetParentCollection()) {
+    if (each->type() == TabCollection::Type::FOLDER) {
+      ++depth;
+    }
+  }
+  return depth;
+}
+
+// How many levels of folders `collection` spans, itself included when it is
+// one: 1 for a folder with no folder inside it.
+size_t FolderHeight(const TabCollection* collection) {
+  size_t below = 0;
+  for (const Child& child : collection->GetChildren()) {
+    if (const auto* holder =
+            std::get_if<std::unique_ptr<TabCollection>>(&child)) {
+      below = std::max(below, FolderHeight(holder->get()));
+    }
+  }
+  return below + (collection->type() == TabCollection::Type::FOLDER ? 1 : 0);
+}
+
+// The root of the tree `collection` is in.
+const TabCollection* RootOf(const TabCollection* collection) {
+  while (collection->GetParentCollection()) {
+    collection = collection->GetParentCollection();
+  }
+  return collection;
+}
+
+}  // namespace
+
+bool TabStripCollection::CanMoveFolderInto(const FolderTabCollection* folder,
+                                           const TabCollection* container,
+                                           size_t max_depth) const {
+  if (!folder || !container || !folder->GetParentCollection()) {
+    return false;
+  }
+  // A folder sits among the unpinned rows or in a folder: never among the
+  // essentials, in a group or in a split (ADR 0013).
+  if (container->type() != TabCollection::Type::FOLDER &&
+      container != unpinned_collection_.get()) {
+    return false;
+  }
+  if (RootOf(folder) != this || RootOf(container) != this) {
+    return false;
+  }
+  // Not into itself or one of its own descendants: that would detach a
+  // subtree from the tree it is being put into.
+  for (const TabCollection* each = container; each;
+       each = each->GetParentCollection()) {
+    if (each == folder) {
+      return false;
+    }
+  }
+  return FolderDepth(container) + FolderHeight(folder) <= max_depth;
+}
+
+bool TabStripCollection::MoveFolderInto(FolderTabCollection* folder,
+                                        TabCollection* container,
+                                        size_t child_index,
+                                        size_t max_depth) {
+  if (!CanMoveFolderInto(folder, container, max_depth)) {
+    return false;
+  }
+  TabCollection* const old_parent = folder->GetParentCollection();
+  child_index = std::min(child_index, container->ChildCount());
+  if (old_parent == container) {
+    const std::optional<size_t> from = container->GetIndexOfCollection(folder);
+    CHECK(from.has_value());
+    if (child_index == *from || child_index == *from + 1) {
+      return true;
+    }
+  }
+  // MoveCollectionImpl takes one off the index when the folder leaves a slot
+  // before it in the same container, so the index stays the one the
+  // container reads now.
+  TabCollection::Position position{container->GetHandle(), child_index};
+  MoveCollectionImpl(folder, position);
+  // As MoveNodesIntoFolder peels: Outer[Inner[Moved]] leaves no empty Inner,
+  // and no empty Outer, behind (an empty folder has no first tab, which the
+  // drag code reads).
+  for (TabCollection* emptied = old_parent;
+       emptied && emptied->type() == TabCollection::Type::FOLDER &&
+       emptied->TabCountRecursive() == 0;) {
+    TabCollection* const above = emptied->GetParentCollection();
+    RemoveTabCollectionImpl(emptied);
+    emptied = above;
+  }
+  return true;
+}
