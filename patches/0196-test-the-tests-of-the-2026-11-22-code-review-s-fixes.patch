+class SyncPlaceFormW2B02Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    // Long enough for the second page to ask while the first test runs, a
+    // background page under a loaded machine included (three seconds were
+    // too few on the Mac with four tests at a time), and well inside the
+    // wait for the first page's answer.
+    sb::PlaceClient::SetTimeoutForTesting(base::Seconds(8));
+    server_.RegisterRequestHandler(
+        base::BindRepeating(&HangW2B02, base::Unretained(&asked_)));
+    ASSERT_TRUE(server_.Start());
+  }
+
+  void TearDownOnMainThread() override {
+    sb::PlaceClient::SetTimeoutForTesting(sb::kPlaceRequestTimeout);
+    ASSERT_TRUE(server_.ShutdownAndWaitUntilComplete());
+    InProcessBrowserTest::TearDownOnMainThread();
