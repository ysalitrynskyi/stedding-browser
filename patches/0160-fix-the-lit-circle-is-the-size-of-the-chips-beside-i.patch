 #include "chrome/browser/ui/stedding/theme/page_top_color.h"
 
 #include <algorithm>
+#include <array>
+#include <cmath>
 #include <cstdlib>
 #include <vector>
 
@@ -102,4 +104,32 @@ bool PageColorsMatch(SkColor a, SkColor b) {
   return ChannelDistance(a, b) <= 2;
 }
 
+bool IsDimmedEdge(SkColor before, SkColor after) {
+  const std::array<int, 3> was = {static_cast<int>(SkColorGetR(before)),
+                                  static_cast<int>(SkColorGetG(before)),
+                                  static_cast<int>(SkColorGetB(before))};
+  const std::array<int, 3> now = {static_cast<int>(SkColorGetR(after)),
+                                  static_cast<int>(SkColorGetG(after)),
+                                  static_cast<int>(SkColorGetB(after))};
+  // The share of light the layer lets through, from the brightest channel,
+  // where it is measured best.
+  const size_t brightest =
+      static_cast<size_t>(std::ranges::max_element(was) - was.begin());
+  if (was[brightest] < kPageDimMinBrightness) {
+    return false;
+  }
+  const double kept = static_cast<double>(now[brightest]) / was[brightest];
+  if (kept < kPageDimLeastKept || kept > kPageDimMostKept) {
+    return false;
+  }
+  const double slack = kPageDimSlack + kPageDimTintSlack * (1.0 - kept);
+  for (size_t channel = 0; channel < was.size(); ++channel) {
+    if (now[channel] > was[channel] ||
+        std::abs(now[channel] - was[channel] * kept) > slack) {
+      return false;
+    }
+  }
+  return true;
+}
