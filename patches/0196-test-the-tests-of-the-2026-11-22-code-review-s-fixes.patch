+// P39-1d; import I45, welcome W1: the flow asked for while it is open --
+// Chromium's import command again, the command bar's row, Settings'
+// Import… -- comes forward, and no second dialog opens over the first. Two
+// stacked at one place, both could run an import, and Finish closed only
+// one. Once closed, the command opens it again.
+IN_PROC_BROWSER_TEST_F(WelcomeDialogW2B28Test,
+                       TheImportCommandWhileTheFlowIsOpenOpensNoSecond) {
+  std::vector<views::Widget*> shown;
+  views::AnyWidgetObserver dialogs(views::test::AnyWidgetTestPasskey{});
+  dialogs.set_shown_callback(
+      base::BindLambdaForTesting([&](views::Widget* widget) {
+        if (widget->widget_delegate() &&
+            widget->widget_delegate()->AsDialogDelegate() &&
+            !std::ranges::contains(shown, widget)) {
+          shown.push_back(widget);
+        }
+      }));
+  dialogs.set_closing_callback(base::BindLambdaForTesting(
+      [&](views::Widget* widget) { std::erase(shown, widget); }));
+
+  chrome::ShowImportDialog(browser());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return WelcomePagesW2B28() == 1; }))
+      << "no welcome flow";
+  chrome::ShowImportDialog(browser());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, WelcomePagesW2B28()) << "a second flow opened over the first";
+  ASSERT_EQ(1u, shown.size()) << "dialogs shown: " << shown.size();
+
+  shown.front()->Close();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return WelcomePagesW2B28() == 0; }))
+      << "a flow stayed open after the one shown closed";
+  chrome::ShowImportDialog(browser());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return WelcomePagesW2B28() == 1; }))
+      << "the flow did not open again once closed";
+}
