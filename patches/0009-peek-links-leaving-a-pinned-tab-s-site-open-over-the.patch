+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "components/tabs/public/tab_interface.h"
+#include "components/url_formatter/elide_url.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/window_features/window_features.mojom.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/ui_base_types.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_provider.h"
+#include "ui/compositor/layer.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rounded_corners_f.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/button/md_text_button.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/flex_layout.h"
+#include "ui/views/layout/flex_layout_types.h"
+#include "ui/views/view_class_properties.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr int kCardRadius = 12;
+constexpr int kHeaderHeight = 44;
+constexpr gfx::Insets kCardInsets = gfx::Insets::VH(28, 56);
+constexpr SkColor kScrim = SkColorSetA(SK_ColorBLACK, 0x73);
+
+}  // namespace
+
+// static
+void PeekView::Show(tabs::TabInterface* source, const GURL& url) {
+  BrowserWindowInterface* const browser = source->GetBrowserWindowInterface();
+  if (!browser) {
+    return;
+  }
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser->GetBrowserForMigrationOnly());
+  if (!browser_view) {
+    return;
+  }
+  if (PeekView* const open = GetOpen(browser_view)) {
+    open->Load(url);
+    return;
+  }
+  // Last child of the browser view: above the web contents once it paints to
+  // its own layer, the same arrangement as the command bar.
+  PeekView* const peek =
+      browser_view->AddChildView(std::make_unique<PeekView>(browser));
+  peek->SetPaintToLayer();
+  peek->layer()->SetFillsBoundsOpaquely(false);
+  peek->layer()->SetName("SteddingPeek");
+  peek->parent_observation_.Observe(browser_view);
+  peek->UpdateBounds();
+  peek->Load(url);
+  peek->web_view_->RequestFocus();
+}
+
+// static
+PeekView* PeekView::GetOpen(BrowserView* browser_view) {
+  for (views::View* child : browser_view->children()) {
+    if (PeekView* const peek = views::AsViewClass<PeekView>(child)) {
+      if (!peek->closing_) {
+        return peek;
+      }
+    }
+  }
+  return nullptr;
+}
+
+PeekView::PeekView(BrowserWindowInterface* browser) : browser_(browser) {
+  contents_ = content::WebContents::Create(
+      content::WebContents::CreateParams(browser_->GetProfile()));
+  contents_->SetDelegate(this);
+  Observe(contents_.get());
+  BuildContents();
+  AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+  AddAccelerator(ui::Accelerator(ui::VKEY_O, ui::EF_PLATFORM_ACCELERATOR));
+}
+
+PeekView::~PeekView() {
+  if (web_view_) {
+    web_view_->SetWebContents(nullptr);
+  }
+  Observe(nullptr);
+  if (contents_) {
+    contents_->SetDelegate(nullptr);
+  }
+}
+
+void PeekView::BuildContents() {
+  SetBackground(views::CreateSolidBackground(kScrim));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, kCardInsets));
+
+  card_ = AddChildView(std::make_unique<views::View>());
+  card_->SetPaintToLayer();
+  card_->layer()->SetRoundedCornerRadius(gfx::RoundedCornersF(kCardRadius));
+  card_->layer()->SetIsFastRoundedCorner(true);
+  card_->layer()->SetMasksToBounds(true);
+  card_->SetBackground(views::CreateSolidBackground(ui::kColorDialogBackground));
+  auto* const card_layout =
+      card_->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kVertical));
+
+  views::View* const header = card_->AddChildView(std::make_unique<views::View>());
+  header->SetPreferredSize(gfx::Size(0, kHeaderHeight));
+  auto* const header_layout =
+      header->SetLayoutManager(std::make_unique<views::BoxLayout>(
+          views::BoxLayout::Orientation::kHorizontal,
+          gfx::Insets::VH(0, 16), 12));
+  header_layout->set_cross_axis_alignment(
+      views::BoxLayout::CrossAxisAlignment::kCenter);
+  title_ = header->AddChildView(std::make_unique<views::Label>(
+      std::u16string(), views::style::CONTEXT_LABEL,
+      views::style::STYLE_PRIMARY));
+  title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  title_->SetElideBehavior(gfx::ELIDE_TAIL);
+  header_layout->SetFlexForView(title_, 1);
+  header->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&PeekView::PromoteToTab, base::Unretained(this)),
+      u"Open in Tab  ⌘O"));
+  header->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&PeekView::Close, base::Unretained(this)),
+      u"Close  esc"));
+
+  web_view_ = card_->AddChildView(
+      std::make_unique<views::WebView>(browser_->GetProfile()));
+  web_view_->SetWebContents(contents_.get());
+  card_layout->SetFlexForView(web_view_, 1);
+}
+
+void PeekView::Load(const GURL& url) {
+  content::NavigationController::LoadURLParams params(url);
+  params.transition_type = ui::PAGE_TRANSITION_LINK;
+  contents_->GetController().LoadURLWithParams(params);
+  UpdateTitle();
+}
+
+void PeekView::PromoteToTab() {
+  if (closing_ || !contents_) {
+    return;
+  }
+  web_view_->SetWebContents(nullptr);
+  Observe(nullptr);
+  contents_->SetDelegate(nullptr);
+  const GURL url = contents_->GetLastCommittedURL().is_empty()
+                       ? contents_->GetVisibleURL()
+                       : contents_->GetLastCommittedURL();
+  chrome::AddWebContents(browser_, nullptr, std::move(contents_), url,
+                         WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                         blink::mojom::WindowFeatures());
+  Close();
+}
+
+void PeekView::Close() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  parent_observation_.Reset();
+  SetVisible(false);
+  if (!parent()) {
+    return;
+  }
+  // Deleting a view from inside its own event handling is not safe; a turn
+  // later it is.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<PeekView> peek) {
+                       if (peek && peek->parent()) {
+                         peek->parent()->RemoveChildViewT(peek.get());
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+bool PeekView::AcceleratorPressed(const ui::Accelerator& accelerator) {
+  if (accelerator.key_code() == ui::VKEY_ESCAPE) {
+    Close();
+    return true;
+  }
+  if (accelerator.key_code() == ui::VKEY_O) {
+    PromoteToTab();
+    return true;
+  }
+  return views::View::AcceleratorPressed(accelerator);
+}
+
+bool PeekView::OnMousePressed(const ui::MouseEvent& event) {
+  // Only the scrim reaches here: the card swallows its own presses and the
+  // web view handles its own.
+  Close();
+  return true;
+}
+
+void PeekView::AddedToWidget() {
+  views::View::AddedToWidget();
+  UpdateBounds();
+}
+
+content::WebContents* PeekView::OpenURLFromTab(
+    content::WebContents* source,
+    const content::OpenURLParams& params,
+    base::OnceCallback<void(content::NavigationHandle&)>
+        navigation_handle_callback) {
+  if (params.disposition == WindowOpenDisposition::CURRENT_TAB && contents_) {
+    content::NavigationController::LoadURLParams load(params);
+    base::WeakPtr<content::NavigationHandle> handle =
+        contents_->GetController().LoadURLWithParams(load);
+    if (navigation_handle_callback && handle) {
+      std::move(navigation_handle_callback).Run(*handle);
+    }
+    return contents_.get();
+  }
+  // Anything that wants its own tab or window goes to the browser as usual.
+  return browser_->GetBrowserForMigrationOnly()->OpenURL(
+      params, std::move(navigation_handle_callback));
+}
+
+content::WebContents* PeekView::AddNewContents(
+    content::WebContents* source,
+    std::unique_ptr<content::WebContents> new_contents,
+    const GURL& target_url,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& window_features,
+    bool user_gesture,
+    bool* was_blocked) {
+  // A popup from a peeked page becomes a real tab; the peek is transient.
+  return chrome::AddWebContents(
+      browser_, nullptr, std::move(new_contents), target_url,
+      WindowOpenDisposition::NEW_FOREGROUND_TAB, window_features,
+      NavigateParams::WindowAction::kShowWindow, user_gesture);
+}
+
+void PeekView::CloseContents(content::WebContents* source) {
+  Close();
+}
+
+bool PeekView::HandleKeyboardEvent(
+    content::WebContents* source,
+    const input::NativeWebKeyboardEvent& event) {
+  // Keys the page did not take (Escape, ⌘O) reach the accelerators above.
+  return unhandled_keyboard_event_handler_.HandleKeyboardEvent(
+      event, GetFocusManager());
+}
+
+void PeekView::TitleWasSet(content::NavigationEntry* entry) {
+  UpdateTitle();
+}
+
+void PeekView::DidFinishNavigation(
+    content::NavigationHandle* navigation_handle) {
+  UpdateTitle();
+}
+
+void PeekView::OnViewBoundsChanged(views::View* observed_view) {
+  UpdateBounds();
+}
+
+void PeekView::UpdateBounds() {
+  views::View* const window = parent();
+  if (!window) {
+    return;
+  }
+  BrowserView* const browser_view = BrowserView::GetBrowserViewForBrowser(
+      browser_->GetBrowserForMigrationOnly());
+  if (!browser_view) {
+    return;
+  }
+  gfx::RectF contents_f(browser_view->contents_container()->GetLocalBounds());
+  views::View::ConvertRectToTarget(browser_view->contents_container(), window,
+                                   &contents_f);
+  SetBoundsRect(gfx::ToEnclosingRect(contents_f));
+}
+
+void PeekView::UpdateTitle() {
+  if (!title_ || !contents_) {
+    return;
+  }
+  const std::u16string title = contents_->GetTitle();
+  const GURL& url = contents_->GetVisibleURL();
+  const std::u16string host =
+      url_formatter::FormatUrlForSecurityDisplay(url);
+  title_->SetText(title.empty() || title == host ? host
+                                                 : title + u"  ·  " + host);
+}
+
+BEGIN_METADATA(PeekView)
+END_METADATA
+
+}  // namespace stedding
