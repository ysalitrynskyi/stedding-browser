+void SteddingSpacesHandler::HandleConfirmSyncJoin(
+    const base::ListValue& args) {
+  AllowJavascript();
+  spaces::SidebarSyncService* const sync = SyncService();
+  if (sync && args.size() == 3U && args[0].is_string() &&
+      args[1].is_string() && args[2].is_list()) {
+    std::vector<size_t> accepted;
+    for (const base::Value& index : args[2].GetList()) {
+      if (index.is_int() && index.GetInt() >= 0) {
+        accepted.push_back(static_cast<size_t>(index.GetInt()));
+      }
+    }
+    sync->ConfirmJoin(args[0].GetString() == "combine", args[1].GetString(),
+                      accepted);
+  }
+  PushSyncStatus();
+}
