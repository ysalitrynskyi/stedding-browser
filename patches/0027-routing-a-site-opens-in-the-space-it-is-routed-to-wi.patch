new file mode 100644
index 0000000000000..91505fc8aa99f
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_router_unittest.cc
@@ -0,0 +1,107 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_router.h"
+
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+Route Make(Route::Match match, const char* pattern, const char* space) {
+  Route route;
+  route.match = match;
+  route.pattern = pattern;
+  route.space = space;
+  return route;
+}
+
+// D1: the three kinds, first match wins, no match is nothing.
+TEST(SpaceRouterTest, MatchTable) {
+  const std::vector<Route> routes = {
+      Make(Route::Match::kSite, "github.com", "work"),
+      Make(Route::Match::kContains, "/docs/", "study"),
+      Make(Route::Match::kEquals, "https://example.com/exact", "home"),
+      Make(Route::Match::kSite, "github.com", "later"),
+  };
+  EXPECT_EQ("work", RouteFor(routes, GURL("https://gist.github.com/a/b")));
+  EXPECT_EQ("work", RouteFor(routes, GURL("https://GitHub.com/")));
+  EXPECT_EQ("study", RouteFor(routes, GURL("https://site.test/docs/x")));
+  EXPECT_EQ("home", RouteFor(routes, GURL("https://example.com/exact")));
+  EXPECT_FALSE(RouteFor(routes, GURL("https://example.com/other")).has_value());
+  EXPECT_FALSE(RouteFor(routes, GURL("https://github.com/"), /*peeking=*/true)
+                   .has_value())
+      << "D6";
+  EXPECT_EQ("localhost", SiteOf(GURL("http://localhost:8080/x")));
+  EXPECT_EQ("example.co.uk", SiteOf(GURL("https://www.example.co.uk/")));
+  EXPECT_EQ("", SiteOf(GURL("about:blank")));
+}
+
+// D5: the rule the tab menu writes is the address's site, nothing more.
+TEST(SpaceRouterTest, RuleFromTabIsSiteScoped) {
+  const Route route =
+      SiteRouteFor(GURL("https://gist.github.com/x/y?z=1#f"), "work");
+  EXPECT_EQ(Route::Match::kSite, route.match);
+  EXPECT_EQ("github.com", route.pattern);
+  EXPECT_EQ("work", route.space);
+  EXPECT_TRUE(RouteMatches(route, GURL("https://github.com/other")));
+  EXPECT_FALSE(RouteMatches(route, GURL("https://github.io/")));
+}
+
+// D1: the pref holds what was written; a rule is replaced, not doubled.
+TEST(SpaceRouterTest, PrefsRoundTrip) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRoutes);
+  EXPECT_TRUE(ReadRoutes(&prefs).empty());
+  AddRoute(&prefs, Make(Route::Match::kSite, "github.com", "work"));
+  AddRoute(&prefs, Make(Route::Match::kContains, "/docs/", "study"));
+  AddRoute(&prefs, Make(Route::Match::kSite, "GitHub.com", "play"));
+  std::vector<Route> routes = ReadRoutes(&prefs);
+  ASSERT_EQ(2u, routes.size());
+  EXPECT_EQ("/docs/", routes[0].pattern);
+  EXPECT_EQ("play", routes[1].space) << "the later rule replaced the first";
+  RemoveRoute(&prefs, 0);
+  routes = ReadRoutes(&prefs);
+  ASSERT_EQ(1u, routes.size());
+  EXPECT_EQ("GitHub.com", routes[0].pattern);
+  RemoveRoute(&prefs, 5);
+  EXPECT_EQ(1u, ReadRoutes(&prefs).size());
+  // A malformed entry is skipped.
+  base::ListValue raw = RoutesToValue(routes);
+  base::DictValue bad;
+  bad.Set("match", "regex");
+  bad.Set("pattern", "x");
+  bad.Set("space", "y");
+  raw.Append(std::move(bad));
+  EXPECT_EQ(1u, RoutesFromValue(raw).size());
+}
+
+// D3: an external open is taken once.
+TEST(SpaceRouterTest, ExternalOpenIsTakenOnce) {
+  const GURL url("https://example.com/from-mail");
+  EXPECT_FALSE(TakeExternalOpen(url));
+  MarkExternalOpen(url);
+  EXPECT_FALSE(TakeExternalOpen(GURL("https://example.com/other")));
+  EXPECT_TRUE(TakeExternalOpen(url));
+  EXPECT_FALSE(TakeExternalOpen(url));
+}
+
+// D6: a link that peeks is not routed, whatever the rules say.
+TEST(SpaceRouterTest, PeekPrecedesRoutes) {
+  const std::vector<Route> routes = {
+      Make(Route::Match::kSite, "example.com", "work")};
+  EXPECT_TRUE(RouteFor(routes, GURL("https://example.com/")).has_value());
+  EXPECT_FALSE(RouteFor(routes, GURL("https://example.com/"), /*peeking=*/true)
+                   .has_value());
+}
+
+}  // namespace
+}  // namespace spaces
