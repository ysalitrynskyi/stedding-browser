+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_STEDDING_GLYPH_INK_H_
+#define CHROME_BROWSER_UI_VIEWS_STEDDING_GLYPH_INK_H_
+
+#include <optional>
+#include <string_view>
+
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_variant.h"
+
+namespace gfx {
+class FontList;
+class Rect;
+}  // namespace gfx
+
+namespace stedding {
+
+// A Space's glyph is text, an emoji as a rule, and text is placed by its
+// advance, which is not where its picture is: on the Mac an emoji's picture
+// is one em wide at the start of an advance a quarter of an em wider, so an
+// emoji centred by its advance stands an eighth of an em left of the centre,
+// 2 DIP at the chips' 16 (the owner, 2026-10-20; sidebar Y8, Y13; spaces
+// B11, B16). These centre the ink itself, found by drawing the text.
+
+// The horizontal centre of the ink `text` draws in `font_list` when a label
+// centres it in a box `box_width` DIP wide starting at 0, every pixel it
+// draws on counted; nothing when it draws no ink. Drawn once for each text,
+// font and width, then remembered.
+std::optional<float> GlyphInkCentre(std::u16string_view text,
+                                    const gfx::FontList& font_list,
+                                    int box_width);
+
+// How many whole DIP to move a label that centres `text` in `label_bounds`
+// so that its ink, not its advance, is centred on `centre_x`, in the same
+// coordinates; 0 when it draws no ink.
+int InkCentringShift(std::u16string_view text,
+                     const gfx::FontList& font_list,
+                     const gfx::Rect& label_bounds,
+                     float centre_x);
+
+// `text` in `font_list` and `color` as an image `width` DIP wide, its ink
+// centred across it, and as tall as `width` or the text's line, whichever is
+// taller: a glyph that stands on an icon column as the icons' images do.
+ui::ImageModel CentredGlyphImage(std::u16string_view text,
+                                 const gfx::FontList& font_list,
+                                 ui::ColorVariant color,
+                                 int width);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STEDDING_GLYPH_INK_H_
diff --git a/chrome/browser/ui/views/stedding/glyph_ink_unittest.cc b/chrome/browser/ui/views/stedding/glyph_ink_unittest.cc
new file mode 100644
index 0000000000000..01ad397d23e4f
