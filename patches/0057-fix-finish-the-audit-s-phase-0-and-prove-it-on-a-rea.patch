+++ b/chrome/test/stedding/clear_space_browsertest.cc
@@ -0,0 +1,252 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Clear (⇧⌘K and the Clear line; PLAN.md CMD-3, SPC-7). It closes the
+// Space's unpinned tabs outside folders and keeps the window: with nothing
+// left it shows one New Tab, in a private window too; folders and their tabs,
+// collapsed ones included, stay, and so does an Arc import's tree. The Clear
+// line, which shows between a Space's pinned run and its other tabs (spaces
+// B17), is pressed with the mouse, the way a person does.
+
+#include <optional>
+#include <string>
+
+#include "base/test/run_until.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/arc_sidebar_importer.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/tabs/common/clear_tabs_separator.h"
+#include "chrome/browser/ui/views/test/vertical_tabs_browser_test_mixin.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace {
+
+// One Space in Arc's file shape: a pinned run of a tab and a folder with a
+// folder inside it, and below it a loose tab and a folder of today's tabs.
+constexpr char kArcSidebar[] = R"json({
+  "version": 1,
+  "sidebar": {"containers": [
+    {"global": {}},
+    {
+      "spaces": [
+        "space-work", {
+          "id": "space-work", "title": "Work",
+          "profile": {"default": {}},
+          "containerIDs": ["unpinned", "cont-unpinned", "pinned", "cont-pinned"],
+          "customInfo": {"iconType": {"emoji_v2": "💼"}}
+        }
+      ],
+      "items": [
+        "cont-pinned", {"id": "cont-pinned", "parentID": null,
+          "childrenIds": ["tab-a", "list-docs"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-unpinned", {"id": "cont-unpinned", "parentID": null,
+          "childrenIds": ["tab-d", "list-today"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-top", {"id": "cont-top", "parentID": null,
+          "childrenIds": [], "title": "",
+          "data": {"itemContainer": {"containerType": {"topApps": {}}}}},
+        "tab-a", {"id": "tab-a", "parentID": "cont-pinned", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://a.example/", "savedTitle": "A"}}},
+        "list-docs", {"id": "list-docs", "parentID": "cont-pinned",
+          "childrenIds": ["tab-b", "list-deep"], "title": "Docs", "data": {"list": {}}},
+        "tab-b", {"id": "tab-b", "parentID": "list-docs", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://b.example/", "savedTitle": "B"}}},
+        "list-deep", {"id": "list-deep", "parentID": "list-docs",
+          "childrenIds": ["tab-c"], "title": "Deep", "data": {"list": {}}},
+        "tab-c", {"id": "tab-c", "parentID": "list-deep", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://c.example/", "savedTitle": "C"}}},
+        "tab-d", {"id": "tab-d", "parentID": "cont-unpinned", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://d.example/", "savedTitle": "D"}}},
+        "list-today", {"id": "list-today", "parentID": "cont-unpinned",
+          "childrenIds": ["tab-e"], "title": "Today", "data": {"list": {}}},
+        "tab-e", {"id": "tab-e", "parentID": "list-today", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://e.example/", "savedTitle": "E"}}}
+      ],
+      "topAppsContainerIDs": [{"default": "cont-top"}, "cont-top"]
+    }
+  ]}
+})json";
+
+ClearTabsSeparator* FindDrawnClearLine(views::View* view) {
+  if (auto* const line = views::AsViewClass<ClearTabsSeparator>(view);
+      line && line->IsDrawn() && line->shows_clear()) {
+    return line;
+  }
+  for (views::View* child : view->children()) {
+    if (ClearTabsSeparator* const found = FindDrawnClearLine(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+class ClearSpaceTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void AddBlankTab(BrowserWindowInterface* window) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        window, GURL(url::kAboutBlankURL),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  }
+
+  // Presses the Clear line in `window`'s sidebar with the mouse.
+  void PressTheClearLine(BrowserWindowInterface* window) {
+    BrowserView* const view = BrowserView::GetBrowserViewForBrowser(window);
+    views::Widget* const widget = view->GetWidget();
+    // Where a person would click: once the rows have moved into place.
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+    views::test::RunScheduledLayout(widget);
+    ClearTabsSeparator* const line = FindDrawnClearLine(widget->GetRootView());
+    ASSERT_TRUE(line) << "the sidebar shows no Clear line";
+    ASSERT_FALSE(line->GetClearRect().IsEmpty());
+    gfx::Point point = line->GetClearRect().CenterPoint();
+    views::View::ConvertPointToScreen(line, &point);
+    stedding::test::ClickLeftMouse(widget, point);
+  }
+
+  tabs::TabInterface* TabTitled(const std::u16string& title) {
+    TabStripModel* const tabs = browser()->GetTabStripModel();
+    for (int i = 0; i < tabs->count(); ++i) {
+      if (tabs->GetWebContentsAt(i)->GetTitle() == title) {
+        return tabs->GetTabAtIndex(i);
+      }
+    }
+    return nullptr;
+  }
+
+  // The window is open with exactly one tab, a New Tab.
+  void ExpectOneNewTab(BrowserWindowInterface* window) {
+    TabStripModel* const tabs = window->GetTabStripModel();
+    ASSERT_TRUE(base::test::RunUntil([&]() { return tabs->count() == 1; }));
+    content::WebContents* const contents = tabs->GetWebContentsAt(0);
+    const GURL shown = contents->GetVisibleURL();
+    EXPECT_TRUE(shown == GURL(chrome::kChromeUINewTabURL) ||
+                shown.host() == chrome::kChromeUINewTabHost ||
+                shown.host() == chrome::kChromeUINewTabPageThirdPartyHost)
+        << shown;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(ClearSpaceTest, ClearingEveryTabKeepsTheWindow) {
+  AddBlankTab(browser());
+  ASSERT_EQ(2, browser()->GetTabStripModel()->count());
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_CLEAR_SPACE);
+  ExpectOneNewTab(browser());
+}
+
+IN_PROC_BROWSER_TEST_F(ClearSpaceTest, ClearingAPrivateWindowKeepsIt) {
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+  AddBlankTab(incognito);
+  ASSERT_EQ(2, incognito->GetTabStripModel()->count());
+  chrome::ExecuteCommand(incognito, IDC_STEDDING_CLEAR_SPACE);
+  ExpectOneNewTab(incognito);
+  EXPECT_TRUE(incognito->GetProfile()->IsOffTheRecord());
+}
+
+IN_PROC_BROWSER_TEST_F(ClearSpaceTest, TheClearLineClosesTheLooseTabs) {
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  tabs::TabInterface* const kept = tabs->GetActiveTab();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_SPACE_PIN);  // ⌘D
+  ASSERT_TRUE(model->IsSpacePinned(kept));
+  AddBlankTab(browser());
+  AddBlankTab(browser());
+  ASSERT_EQ(3, tabs->count());
+  PressTheClearLine(browser());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return tabs->count() == 1; }));
+  EXPECT_EQ(kept, tabs->GetTabAtIndex(0)) << "the pinned run stays";
+}
+
+IN_PROC_BROWSER_TEST_F(ClearSpaceTest,
+                       ClearingAfterAnArcImportKeepsItsFolders) {
+  const std::optional<spaces::ArcImportPlan> plan =
+      spaces::ParseArcSidebar(kArcSidebar);
+  ASSERT_TRUE(plan.has_value());
+  spaces::ArcImportOptions options;
+  options.history = false;
+  options.passwords = false;
+  const spaces::ArcImportResult result =
+      spaces::ApplyArcImport(browser(), *plan, options);
+  ASSERT_EQ(5u, result.tabs);
+  ASSERT_EQ(3u, result.folders);
+  for (const char16_t* title : {u"A", u"B", u"C", u"D", u"E"}) {
+    ASSERT_TRUE(TabTitled(title)) << title;
+  }
+  // Every folder collapsed, the nested one too.
+  for (const char16_t* title : {u"B", u"C", u"E"}) {
+    const tabs::TabCollection* const parent =
+        TabTitled(title)->GetParentCollection();
+    ASSERT_EQ(tabs::TabCollection::Type::FOLDER, parent->type());
+    // As the folder's header does (FolderView::folder()).
+    const_cast<tabs::FolderTabCollection*>(
+        static_cast<const tabs::FolderTabCollection*>(parent))
+        ->SetCollapsed(true);
+  }
+  const tabs::TabCollection* const docs =
+      TabTitled(u"B")->GetParentCollection();
+  const tabs::TabCollection* const deep =
+      TabTitled(u"C")->GetParentCollection();
+  const tabs::TabCollection* const today =
+      TabTitled(u"E")->GetParentCollection();
+
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_CLEAR_SPACE);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !TabTitled(u"D"); }))
+      << "the loose tab goes";
+  EXPECT_TRUE(TabTitled(u"A")) << "the pinned run stays";
+  ASSERT_TRUE(TabTitled(u"B"));
+  ASSERT_TRUE(TabTitled(u"C"));
+  ASSERT_TRUE(TabTitled(u"E"));
+  EXPECT_EQ(docs, TabTitled(u"B")->GetParentCollection());
+  EXPECT_EQ(deep, TabTitled(u"C")->GetParentCollection());
+  EXPECT_EQ(today, TabTitled(u"E")->GetParentCollection())
+      << "a folder among the loose tabs stays, with its tab";
+}
+
+IN_PROC_BROWSER_TEST_F(ClearSpaceTest, ClearingKeepsFoldersAndTheirTabs) {
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  for (int i = 0; i < 4; ++i) {
+    AddBlankTab(browser());
+  }
+  ASSERT_EQ(5, tabs->count());
+  tabs::FolderTabCollection* const open = tabs->AddToNewFolder({1, 2});
+  ASSERT_TRUE(open);
+  tabs::FolderTabCollection* const shut = tabs->AddToNewFolder({3});
+  ASSERT_TRUE(shut);
+  shut->SetCollapsed(true);
+  tabs::TabInterface* const in_open = tabs->GetTabAtIndex(1);
+  tabs::TabInterface* const in_shut = tabs->GetTabAtIndex(3);
+
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_CLEAR_SPACE);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return tabs->count() == 3; }));
+  EXPECT_NE(TabStripModel::kNoTab, tabs->GetIndexOfTab(in_open));
+  EXPECT_NE(TabStripModel::kNoTab, tabs->GetIndexOfTab(in_shut));
+  EXPECT_EQ(open, in_open->GetParentCollection());
+  EXPECT_EQ(shut, in_shut->GetParentCollection());
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/command_bar_browsertest.cc b/chrome/test/stedding/command_bar_browsertest.cc
