+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_REGISTRY_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_REGISTRY_H_
+
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/values.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+class PrefService;
+
+namespace spaces {
+
+// One Space as the profile knows it (ADR 0016). `profile_id` is empty in
+// round 6; the field exists so per-Space profiles need no second migration
+// (docs/features/windows.md G5).
+struct RegistryEntry {
+  RegistryEntry(SpaceId id, std::string name, SkColor color);
+  RegistryEntry(const RegistryEntry& other);
+  RegistryEntry& operator=(const RegistryEntry& other);
+  ~RegistryEntry();
+
+  SpaceId id;
+  std::string name;
+  std::string icon;
+  SkColor color;
+  bool color_chosen = false;
+  std::string profile_id;
+};
+
+// The profile's Space list -- order, names, icons, colours -- which every
+// window's SpaceModel mirrors (docs/features/windows.md G1, G3). Kept in
+// the preference stedding.spaces.registry, written on every change.
+class SpaceRegistry : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // The list changed in some way; a mirror re-reads it whole.
+    virtual void OnRegistryChanged() {}
+  };
+
+  explicit SpaceRegistry(PrefService* prefs);
+  SpaceRegistry(const SpaceRegistry&) = delete;
+  SpaceRegistry& operator=(const SpaceRegistry&) = delete;
+  ~SpaceRegistry() override;
+
+  const std::vector<RegistryEntry>& entries() const { return entries_; }
+  bool empty() const { return entries_.empty(); }
+  const RegistryEntry* Find(const SpaceId& id) const;
+
+  SpaceId Add(std::string name, SkColor color);
+  // A Space a window brought from its session: kept with its id, at the end,
+  // unless the registry has it already.
+  void AddExisting(const RegistryEntry& entry);
+  // Never the last one.
+  bool Remove(const SpaceId& id);
+  bool Move(const SpaceId& id, int delta);
+  void SetName(const SpaceId& id, std::string name);
+  void SetIcon(const SpaceId& id, std::string icon);
+  void SetColor(const SpaceId& id, SkColor color, bool chosen);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  static base::ListValue ToValue(const std::vector<RegistryEntry>& entries);
+  static std::vector<RegistryEntry> FromValue(const base::ListValue& value);
+
+ private:
+  RegistryEntry* FindMutable(const SpaceId& id);
+  void Changed();
+
+  const raw_ptr<PrefService> prefs_;
+  std::vector<RegistryEntry> entries_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_REGISTRY_H_
