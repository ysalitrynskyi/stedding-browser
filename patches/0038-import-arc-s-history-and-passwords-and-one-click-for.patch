+constexpr std::string_view kArcSalt = "saltysalt";
+constexpr int kArcRounds = 1003;
+constexpr size_t kArcKeyBytes = 16;
+constexpr std::string_view kSealedPrefix = "v10";
+
+base::Time FromChromiumMicroseconds(int64_t value) {
+  return base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(value));
+}
+
+base::FilePath JournalOf(const base::FilePath& database) {
+  return base::FilePath(database.value() + FILE_PATH_LITERAL("-journal"));
+}
+
+// Copies `source` (and a hot journal beside it, which rolls back on open)
+// into `into`; an empty path when there is nothing to copy.
+base::FilePath CopyForReading(const base::FilePath& source,
+                              const base::FilePath& into) {
+  if (source.empty() || !base::PathExists(source)) {
+    return base::FilePath();
+  }
+  const base::FilePath copy = into.Append(source.BaseName());
+  if (!base::CopyFile(source, copy)) {
+    return base::FilePath();
+  }
+  const base::FilePath journal = JournalOf(source);
+  if (base::PathExists(journal)) {
+    base::CopyFile(journal, JournalOf(copy));
+  }
+  return copy;
+}
+
+struct ReadOutcome {
+  ReadOutcome();
+  ReadOutcome(ReadOutcome&&);
+  ~ReadOutcome();
+  history::URLRows history;
+  std::vector<password_manager::PasswordForm> logins;
+  bool keychain_denied = false;
+};
+
+ReadOutcome::ReadOutcome() = default;
+ReadOutcome::ReadOutcome(ReadOutcome&&) = default;
+ReadOutcome::~ReadOutcome() = default;
+
+ReadOutcome ReadOnPool(ArcDataPaths paths, bool history, bool passwords) {
+  ReadOutcome out;
+  base::ScopedTempDir temp;
+  if (!temp.CreateUniqueTempDir()) {
+    return out;
+  }
+  if (history) {
+    out.history = ReadArcHistory(CopyForReading(paths.history, temp.GetPath()));
+  }
+  if (passwords) {
+    const base::FilePath logins = CopyForReading(paths.logins, temp.GetPath());
+    if (!logins.empty()) {
+      const std::optional<std::string> password = ReadArcKeychainPassword();
+      if (!password) {
+        out.keychain_denied = true;
+      } else {
+        out.logins = ReadArcLogins(logins, DeriveArcKey(*password));
+      }
+    }
+  }
+  return out;
+}
+
+void WriteOnUi(base::WeakPtr<Profile> profile,
+               ArcDataDoneCallback done,
+               ReadOutcome read) {
+  ArcDataResult result;
+  result.keychain_denied = read.keychain_denied;
+  if (!profile) {
+    std::move(done).Run(result);
+    return;
+  }
+  if (!read.history.empty()) {
+    if (history::HistoryService* const service =
+            HistoryServiceFactory::GetForProfile(
+                profile.get(), ServiceAccessType::EXPLICIT_ACCESS)) {
+      service->AddPagesWithDetails(read.history, history::SOURCE_BROWSED);
+      result.history = read.history.size();
+    }
+  }
+  if (!read.logins.empty()) {
+    if (scoped_refptr<password_manager::PasswordStoreInterface> store =
+            ProfilePasswordStoreFactory::GetForProfile(
+                profile.get(), ServiceAccessType::EXPLICIT_ACCESS)) {
+      for (password_manager::PasswordForm& form : read.logins) {
+        store->AddLogin(password_manager::FromPasswordForm(std::move(form)));
+      }
+      result.passwords = read.logins.size();
+    }
+  }
+  std::move(done).Run(result);
+}
+
+}  // namespace
+
+ArcDataPaths ArcDataPathsFor(const base::FilePath& user_data_dir) {
+  ArcDataPaths paths;
+  if (user_data_dir.empty()) {
+    return paths;
+  }
+  const base::FilePath profile = user_data_dir.Append("Default");
+  paths.history = profile.Append("History");
+  paths.logins = profile.Append("Login Data");
+  return paths;
+}
+
+ArcDataPaths DefaultArcDataPaths() {
+  base::FilePath home;
+  if (!base::PathService::Get(base::DIR_HOME, &home)) {
+    return ArcDataPaths();
+  }
+  return ArcDataPathsFor(home.Append("Library")
+                             .Append("Application Support")
+                             .Append("Arc")
+                             .Append("User Data"));
+}
+
+bool ArcDataPresent(const ArcDataPaths& paths) {
+  return (!paths.history.empty() && base::PathExists(paths.history)) ||
+         (!paths.logins.empty() && base::PathExists(paths.logins));
+}
+
+std::vector<uint8_t> Pbkdf2HmacSha1(std::string_view password,
+                                    std::string_view salt,
+                                    int rounds,
+                                    size_t length) {
+  // RFC 8018 section 5.2: T_i = U_1 xor ... xor U_c, U_1 = PRF(P, S || i),
+  // U_j = PRF(P, U_{j-1}); the key is T_1 || T_2 || ... cut to length.
+  const base::span<const uint8_t> key = base::as_byte_span(password);
+  std::vector<uint8_t> out;
+  for (uint32_t block = 1; out.size() < length; ++block) {
+    std::vector<uint8_t> seed(salt.begin(), salt.end());
+    seed.push_back(static_cast<uint8_t>(block >> 24));
+    seed.push_back(static_cast<uint8_t>(block >> 16));
+    seed.push_back(static_cast<uint8_t>(block >> 8));
+    seed.push_back(static_cast<uint8_t>(block));
+    std::array<uint8_t, crypto::hash::kSha1Size> u =
+        crypto::hmac::SignSha1(key, seed);
+    std::array<uint8_t, crypto::hash::kSha1Size> t = u;
+    for (int round = 1; round < rounds; ++round) {
+      u = crypto::hmac::SignSha1(key, u);
+      for (size_t i = 0; i < t.size(); ++i) {
+        t[i] ^= u[i];
+      }
+    }
+    out.insert(out.end(), t.begin(), t.end());
+  }
+  out.resize(length);
+  return out;
+}
+
+std::vector<uint8_t> DeriveArcKey(std::string_view keychain_password) {
+  return Pbkdf2HmacSha1(keychain_password, kArcSalt, kArcRounds, kArcKeyBytes);
+}
+
+std::optional<std::u16string> DecryptArcValue(base::span<const uint8_t> sealed,
+                                              base::span<const uint8_t> key) {
+  if (sealed.size() <= kSealedPrefix.size() || key.size() != kArcKeyBytes) {
+    return std::nullopt;
+  }
+  if (base::as_string_view(sealed.first(kSealedPrefix.size())) !=
+      kSealedPrefix) {
+    return std::nullopt;
+  }
+  std::array<uint8_t, crypto::aes_cbc::kBlockSize> iv;
+  iv.fill(' ');
+  const std::optional<std::vector<uint8_t>> plain =
+      crypto::aes_cbc::Decrypt(key, iv, sealed.subspan(kSealedPrefix.size()));
+  if (!plain) {
+    return std::nullopt;
+  }
+  return base::UTF8ToUTF16(base::as_string_view(*plain));
+}
+
+std::optional<std::string> ReadArcKeychainPassword() {
+#if BUILDFLAG(IS_MAC)
+  base::apple::ScopedCFTypeRef<CFStringRef> service(
+      base::SysUTF8ToCFStringRef("Arc Safe Storage"));
+  base::apple::ScopedCFTypeRef<CFStringRef> account(
+      base::SysUTF8ToCFStringRef("Arc"));
+  const void* keys[] = {kSecClass, kSecAttrService, kSecAttrAccount,
+                        kSecReturnData, kSecMatchLimit};
+  const void* values[] = {kSecClassGenericPassword, service.get(),
+                          account.get(), kCFBooleanTrue, kSecMatchLimitOne};
+  base::apple::ScopedCFTypeRef<CFDictionaryRef> query(CFDictionaryCreate(
+      kCFAllocatorDefault, keys, values, std::size(keys),
+      &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks));
+  base::apple::ScopedCFTypeRef<CFTypeRef> result;
+  if (SecItemCopyMatching(query.get(), result.InitializeInto()) !=
+      errSecSuccess) {
+    return std::nullopt;
+  }
+  CFDataRef data = base::apple::CFCast<CFDataRef>(result.get());
+  if (!data) {
+    return std::nullopt;
+  }
+  return std::string(base::as_string_view(base::apple::CFDataToSpan(data)));
+#else
+  return std::nullopt;
+#endif
+}
+
+history::URLRows ReadArcHistory(const base::FilePath& history_copy,
+                                size_t cap) {
+  history::URLRows rows;
+  if (history_copy.empty() || !base::PathExists(history_copy)) {
+    return rows;
+  }
+  sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                   sql::Database::Tag("History"));
+  if (!db.Open(history_copy)) {
+    return rows;
+  }
+  sql::Statement statement(db.GetUniqueStatement(
+      "SELECT url, title, visit_count, typed_count, last_visit_time FROM urls "
+      "WHERE hidden = 0 ORDER BY last_visit_time DESC"));
+  while (rows.size() < cap && statement.Step()) {
+    const GURL url(statement.ColumnString(0));
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    history::URLRow row(url);
+    row.set_title(statement.ColumnString16(1));
+    row.set_visit_count(std::max(1, statement.ColumnInt(2)));
+    row.set_typed_count(std::max(0, statement.ColumnInt(3)));
+    row.set_last_visit(FromChromiumMicroseconds(statement.ColumnInt64(4)));
+    rows.push_back(std::move(row));
+  }
+  return rows;
+}
+
+std::vector<password_manager::PasswordForm> ReadArcLogins(
+    const base::FilePath& logins_copy,
+    base::span<const uint8_t> key) {
+  std::vector<password_manager::PasswordForm> forms;
+  if (logins_copy.empty() || !base::PathExists(logins_copy)) {
+    return forms;
+  }
+  sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                   sql::Database::Tag("Passwords"));
+  if (!db.Open(logins_copy)) {
+    return forms;
+  }
+  sql::Statement statement(db.GetUniqueStatement(
+      "SELECT origin_url, action_url, username_element, username_value, "
+      "password_element, password_value, signon_realm, date_created, "
+      "blacklisted_by_user, scheme, date_last_used, date_password_modified "
+      "FROM logins"));
+  while (statement.Step()) {
+    password_manager::PasswordForm form;
+    form.url = GURL(statement.ColumnString(0));
+    if (!form.url.is_valid()) {
+      continue;
+    }
+    form.action = GURL(statement.ColumnString(1));
+    form.username_element = statement.ColumnString16(2);
+    form.username_value = statement.ColumnString16(3);
+    form.password_element = statement.ColumnString16(4);
+    form.signon_realm = statement.ColumnString(6);
+    if (form.signon_realm.empty()) {
+      form.signon_realm = form.url.DeprecatedGetOriginAsURL().spec();
+    }
+    form.date_created = FromChromiumMicroseconds(statement.ColumnInt64(7));
+    form.blocked_by_user = statement.ColumnInt(8) != 0;
+    form.scheme = static_cast<password_manager::PasswordForm::Scheme>(
+        std::clamp(statement.ColumnInt(9), 0, 3));
+    form.date_last_used = FromChromiumMicroseconds(statement.ColumnInt64(10));
+    form.date_password_modified =
+        FromChromiumMicroseconds(statement.ColumnInt64(11));
+    form.in_store = password_manager::PasswordForm::Store::kProfileStore;
+    if (!form.blocked_by_user) {
+      const std::optional<std::u16string> password =
+          DecryptArcValue(statement.ColumnBlob(5), key);
+      if (!password || password->empty()) {
+        continue;
+      }
+      form.password_value = *password;
+    }
+    forms.push_back(std::move(form));
+  }
+  return forms;
+}
+
+void ImportArcDataAsync(Profile* profile,
+                        bool history,
+                        bool passwords,
+                        ArcDataDoneCallback done,
+                        std::optional<ArcDataPaths> paths) {
+  if (!profile || (!history && !passwords)) {
+    std::move(done).Run(ArcDataResult());
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadOnPool, paths ? *paths : DefaultArcDataPaths(),
+                     history, passwords),
+      base::BindOnce(&WriteOnUi, profile->GetWeakPtr(), std::move(done)));
+}
+
+}  // namespace spaces
