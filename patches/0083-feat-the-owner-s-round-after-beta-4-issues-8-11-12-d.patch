+// tabs, the owner's beta 4 round (2026-10-22): a card still waiting to show
+// when the tab list scrolls does not show. The pointer reaches a row and the
+// wheel turns at once; the card came up after the scroll for the row the
+// list had carried away from the pointer, pinned to the list's top edge.
+// The scroll took down only a card already showing.
+IN_PROC_BROWSER_TEST_F(HoverCardPictureTest, AScrollDropsACardWaitingToShow) {
+  TabStripView* const strip = stedding::test::FindView<TabStripView>(
+      browser_view()->vertical_tab_strip_region_view_for_testing());
+  ASSERT_TRUE(strip);
+  views::ScrollView* const list = strip->unpinned_tabs_scroll_view();
+  ASSERT_TRUE(list);
+  for (int i = 0; i < 30; ++i) {
+    OpenInBackground(Page(base::StrCat({"row", base::NumberToString(i),
+                                        ".test"}),
+                          "ffffff"));
+  }
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  ASSERT_GT(list->contents()->height(), list->height()) << "no list to scroll";
+  tabs::TabInterface* const first = tabs().GetTabAtIndex(0);
+  TabView* const row = RowOf(first);
+  ASSERT_TRUE(row);
+  // The card's own wait, as a pointer meets it.
+  TabHoverCardController::set_disable_animations_for_testing(false);
+  {
+    SCOPED_TRACE("with no scroll, the card shows after its wait");
+    cards()->PreventImmediateReshow();
+    cards()->UpdateHoverCard(row, HoverCardUpdateType::kHover);
+    ASSERT_FALSE(card()) << "the card showed at once; nothing waited";
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !!card(); }))
+        << "the card never showed";
+    cards()->UpdateHoverCard(nullptr, HoverCardUpdateType::kHover);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !card(); }));
+  }
+  {
+    SCOPED_TRACE("a scroll during the wait");
+    cards()->PreventImmediateReshow();
+    cards()->UpdateHoverCard(row, HoverCardUpdateType::kHover);
+    ASSERT_FALSE(card()) << "the card showed at once; nothing waited";
+    list->ScrollToOffset(gfx::PointF(0, list->contents()->height()));
+    // Longer than any wait the card has before it shows.
+    base::RunLoop wait;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, wait.QuitClosure(), base::Seconds(2));
+    wait.Run();
+    EXPECT_FALSE(card()) << "the card showed after the scroll";
+    EXPECT_FALSE(cards()->target_tab()) << "a card still waits for the row";
+  }
+  TabHoverCardController::set_disable_animations_for_testing(true);
+}
