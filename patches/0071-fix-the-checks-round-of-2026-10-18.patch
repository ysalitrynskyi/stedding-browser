+  tabs::TabInterface* const g1 = tab_strip_model()->GetTabAtIndex(1);
+  tabs::TabInterface* const g2 = tab_strip_model()->GetTabAtIndex(2);
+  const spaces::SpaceId one = model()->active_id();
+  const spaces::SpaceId work = model()->AddSpace("Work", SK_ColorBLUE)->id();
+  const tab_groups::TabGroupId group = tab_strip_model()->AddToNewGroup({1, 2});
+  tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(a0));
+  model()->MoveTabsToSpace({g2}, work);
+  ASSERT_EQ(group, g2->GetGroup()) << "the move took the tab out of its group";
+
+  views::Widget* const window = browser_view()->GetWidget();
+  views::View* const root = window->GetRootView();
+  const auto drawn = [&](const tabs::TabInterface* tab) {
+    views::test::RunScheduledLayout(window);
+    return stedding::test::FindDrawnRow(root, tab) != nullptr;
+  };
+  // Each step starts in One with the group's rows as a switch leaves them, so
+  // a step that fails does not decide the next one.
+  const auto start = [&]() {
+    Run(IDC_STEDDING_SPACE_2);
+    Run(IDC_STEDDING_SPACE_1);
+    ASSERT_NO_FATAL_FAILURE(ExpectShowing(one));
+    ASSERT_EQ(a0, tab_strip_model()->GetActiveTab());
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(window));
+    ASSERT_TRUE(stedding::test::FindDrawnGroup(root, group));
