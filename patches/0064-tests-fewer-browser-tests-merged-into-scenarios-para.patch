+    spaces::SpaceModel* const m = model();
+    ASSERT_TRUE(m);
+    const spaces::SpaceId home = m->active_id();
+    const spaces::SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+
+    tabs::TabInterface* const f1 = Open("f1.test");
+    tabs::TabInterface* const f2 = Open("f2.test");
+    tabs::FolderTabCollection* const folder =
+        tab_strip_model()->AddToNewFolder({Index(f1), Index(f2)});
+    ASSERT_TRUE(folder);
+    tabs::TabInterface* const pin = Open("pin.test");
+    m->SetSpacePinned(pin, true);
+    ASSERT_EQ(Url("pin.test"), m->HomeUrl(pin).value_or(GURL()));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("away.test")));
+    ASSERT_TRUE(stedding::HasDriftedFromHome(
+        Url("pin.test"), pin->GetContents()->GetLastCommittedURL()));
+    // A tab whose site is routed to Work, opened here before the route.
+    tabs::TabInterface* const routed = Open("routed.test");
+    spaces::Route route;
+    route.match = spaces::Route::Match::kHost;
+    route.pattern = "routed.test";
+    route.space = work.ToString();
+    spaces::AddRoute(browser()->GetProfile()->GetPrefs(), route);
+    tabs::TabInterface* const a = Open("a.test");
+    tabs::TabInterface* const b = Open("b.test");
+    tabs::TabInterface* const c = Open("c.test");
+    const std::vector<tabs::TabInterface*> recent = m->RecentTabs(home, 20);
+
+    {
+      SCOPED_TRACE("pin joins and keeps home");
+      const Kept pin_kept = KeptOf(pin);
+      Drag(RowCentre(pin), HeaderCentre(folder));
+      ASSERT_TRUE(base::test::RunUntil([&]() { return IsIn(pin, folder); }))
+          << "the pin did not join the folder";
+      ExpectKept(pin, pin_kept);
+      EXPECT_TRUE(m->IsSpacePinned(pin));
+      EXPECT_EQ(Url("pin.test"), m->HomeUrl(pin).value_or(GURL()));
+      EXPECT_EQ(home, m->SpaceForTab(pin));
+      // The press made the pin the tab on screen; the rest keep their order.
+      std::vector<tabs::TabInterface*> expected_recent = recent;
+      std::erase(expected_recent, pin);
+      expected_recent.insert(expected_recent.begin(), pin);
+      EXPECT_EQ(expected_recent, m->RecentTabs(home, 20))
+          << "Ctrl-Tab's order";
+    }
+
+    {
+      SCOPED_TRACE("routed tab stays in Home");
+      const Kept routed_kept = KeptOf(routed);
+      Drag(RowCentre(routed), HeaderCentre(folder));
