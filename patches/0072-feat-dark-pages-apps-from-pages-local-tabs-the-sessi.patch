@@ -0,0 +1,50 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/local_pages.h"
+
+#include "base/strings/escape.h"
+#include "components/url_formatter/url_formatter.h"
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+bool IsLocalPage(const GURL& url) {
+  // The scheme first: view-source:, blob:, file: and chrome: pages are not a
+  // server's, whatever host they name.
+  return url.is_valid() && url.SchemeIsHTTPOrHTTPS() && net::IsLocalhost(url);
+}
+
+std::u16string LocalHostLine(const GURL& url) {
+  if (!IsLocalPage(url)) {
+    return std::u16string();
+  }
+  // The hover card's flags (hover_card_anchor_target.cc), so the row and its
+  // card agree.
+  return url_formatter::FormatUrl(
+      url,
+      url_formatter::kFormatUrlOmitDefaults |
+          url_formatter::kFormatUrlOmitHTTPS |
+          url_formatter::kFormatUrlOmitTrivialSubdomains |
+          url_formatter::kFormatUrlTrimAfterHost,
+      base::UnescapeRule::NORMAL, nullptr, nullptr, nullptr);
+}
+
+std::u16string UntitledLocalTitle(const GURL& url) {
+  if (!IsLocalPage(url)) {
+    return std::u16string();
+  }
+  // NavigationEntryImpl::GetTitleForDisplay's flags and unescaping, exactly:
+  // the row compares the two texts, and a title that only starts with the
+  // host ("localhost:3000 - Admin") is a title of the page's own.
+  return url_formatter::FormatUrl(
+      url,
+      url_formatter::kFormatUrlOmitDefaults |
+          url_formatter::kFormatUrlOmitTrivialSubdomains |
+          url_formatter::kFormatUrlOmitHTTPS,
+      base::UnescapeRule::SPACES, nullptr, nullptr, nullptr);
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/local_pages.h b/chrome/browser/ui/stedding/local_pages.h
new file mode 100644
index 0000000000000..fffe606424389
--- /dev/null
+++ b/chrome/browser/ui/stedding/local_pages.h
@@ -0,0 +1,37 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_LOCAL_PAGES_H_
+#define CHROME_BROWSER_UI_STEDDING_LOCAL_PAGES_H_
+
+#include <string>
+
+class GURL;
+
+namespace stedding {
+
+// docs/features/local-tabs.md Lt1, toolbar T11: a page this machine's own web
+// server serves, as Arc's Developer Mode reads it: http or https on
+// localhost, a name under .localhost, 127.0.0.0/8 or [::1], on any port. The
+// sidebar marks such a tab and the address row stays for it; one rule, so
+// the two never disagree. 0.0.0.0, LAN addresses, .test and .local are not
+// local: nothing tells a developer's server there from a printer or a NAS.
+bool IsLocalPage(const GURL& url);
+
+// Lt5: the host and port a local row shows under its title, as the hover
+// card's domain line prints them ("127.0.0.1:3080", "app.localhost:8443",
+// "[::1]:8080"): no scheme, user name, path, query or default port. Empty for
+// a page that is not local.
+std::u16string LocalHostLine(const GURL& url);
+
+// Lt5: the title a local page that names no title of its own shows: its
+// address as NavigationEntryImpl::GetTitleForDisplay formats it
+// ("localhost:3000/admin", "localhost:3000" for the root). A row whose title
+// is this text shows no host line, which would say the same again. Empty for
+// a page that is not local.
+std::u16string UntitledLocalTitle(const GURL& url);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_LOCAL_PAGES_H_
diff --git a/chrome/browser/ui/stedding/local_pages_unittest.cc b/chrome/browser/ui/stedding/local_pages_unittest.cc
new file mode 100644
index 0000000000000..0b5b15c296648
--- /dev/null
+++ b/chrome/browser/ui/stedding/local_pages_unittest.cc
@@ -0,0 +1,134 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/local_pages.h"
+
+#include <memory>
+#include <string>
+
+#include "content/public/browser/navigation_entry.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// local tabs Lt1, toolbar T11: http and https on the loopback hosts, with
+// and without a port, are local; the hosts a developer's server could also
+// answer on but that name other machines too, and every page that is not a
+// server's, are not.
+TEST(LocalPagesTest, LocalIsTheLoopbackHostsOverHttp) {
+  for (const char* const spec : {
+           "http://localhost/",
+           "http://localhost:8766/a.html",
+           "https://localhost:8443/",
+           "http://localhost./",
+           "http://LOCALHOST:3000/",
+           "http://app.localhost:5173/",
+           "https://a.b.localhost/x?y#z",
+           "http://127.0.0.1/",
+           "http://127.0.0.1:3080/x",
+           "http://127.1.2.3:8000/",
+           "http://[::1]:8080/",
+           "https://[::1]/",
+       }) {
+    EXPECT_TRUE(IsLocalPage(GURL(spec))) << spec;
+  }
+  for (const char* const spec : {
+           "http://0.0.0.0:8000/",
+           "http://192.168.1.10:3000/",
+           "http://10.0.0.2/",
+           "http://172.16.0.5:8080/",
+           "http://[fe80::1]/",
+           "http://a.test/",
+           "http://dev.local:3000/",
+           "http://localhost.example.com/",
+           "https://example.com/",
+           "ws://localhost:3000/",
+           "file:///tmp/index.html",
+           "chrome://settings/",
+           "view-source:http://localhost:3000/",
+           "blob:http://localhost:3000/0b6e7c2a-6f7e-4d4a-9b1f-3c2a1d0e9f8b",
+           "about:blank",
+           "",
+       }) {
+    EXPECT_FALSE(IsLocalPage(GURL(spec))) << spec;
+  }
+}
+
+// Lt5: the host line is the host and port, as the hover card's domain line
+// prints them: the scheme, the user name, the path, the query, the fragment
+// and a default port dropped, the port kept, IPv6 in brackets. A page that
+// is not local has none.
+TEST(LocalPagesTest, TheHostLineIsTheHoverCardsDomain) {
+  struct Case {
+    const char* url;
+    const char16_t* line;
+  };
+  const Case cases[] = {
+      {"http://127.0.0.1:3080/x", u"127.0.0.1:3080"},
+      {"http://localhost/", u"localhost"},
+      {"http://localhost:80/", u"localhost"},
+      {"https://localhost:443/", u"localhost"},
+      {"https://app.localhost:8443/a/b?c=d#e", u"app.localhost:8443"},
+      // No registrable domain, so nothing is trivial: the name stays whole.
+      {"http://www.localhost:3000/", u"www.localhost:3000"},
+      {"http://[::1]:8080/", u"[::1]:8080"},
+      {"http://user:secret@localhost:3000/admin", u"localhost:3000"},
+      {"https://example.com/", u""},
+      {"view-source:http://localhost:3000/", u""},
+  };
+  for (const Case& each : cases) {
+    SCOPED_TRACE(each.url);
+    EXPECT_EQ(std::u16string(each.line), LocalHostLine(GURL(each.url)));
+  }
+}
+
+// Lt5: a local page with no title of its own is titled with its address,
+// and the row knows that text exactly: it is what the navigation entry
+// itself shows as the tab's title, path and all, so a title that merely
+// starts with the host is never taken for it. A page that is not local has
+// none.
+TEST(LocalPagesTest, AnUntitledPageIsTitledWithItsAddress) {
+  struct Case {
+    const char* url;
+    const char16_t* title;
+  };
+  const Case cases[] = {
+      {"http://localhost:3000/admin", u"localhost:3000/admin"},
+      {"http://localhost:3000/", u"localhost:3000"},
+      {"https://localhost:8443/a?b=c", u"localhost:8443/a?b=c"},
+      {"http://127.0.0.1:3080/x", u"127.0.0.1:3080/x"},
+      {"http://[::1]:8080/", u"[::1]:8080"},
+      {"http://user:secret@localhost:3000/", u"localhost:3000"},
+      {"https://example.com/", u""},
+  };
+  for (const Case& each : cases) {
+    SCOPED_TRACE(each.url);
+    EXPECT_EQ(std::u16string(each.title), UntitledLocalTitle(GURL(each.url)));
+  }
+
+  for (const char* const spec : {
+           "http://localhost:3000/admin",
+           "http://localhost:3000/",
+           "https://localhost:8443/a?b=c#d",
+           "http://app.localhost:5173/a%20b",
+           "http://www.localhost:3000/",
+           "http://127.0.0.1:3080/x",
+           "http://[::1]:8080/y",
+           "http://user:secret@localhost:3000/",
+       }) {
+    SCOPED_TRACE(spec);
+    const GURL url(spec);
+    std::unique_ptr<content::NavigationEntry> entry =
+        content::NavigationEntry::Create();
+    entry->SetURL(url);
+    ASSERT_TRUE(entry->GetTitle().empty());
+    EXPECT_EQ(entry->GetTitleForDisplay(), UntitledLocalTitle(url))
+        << "the title the tab shows";
+  }
+}
+
+}  // namespace
+}  // namespace stedding
