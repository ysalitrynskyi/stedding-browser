+// Pn15, Pn14: the History button sits beside the downloads button, named
+// "History", and opens its panel; in the rail it stands under the downloads
+// button on the column's centre line. The Archived row wears the archive
+// box. With the setting off the button is not drawn.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsTest, TheHistoryButtonSitsBesideDownloads) {
+  Layout();
+  views::View* const history_button = region()->history_button();
+  views::View* const downloads = region()->downloads_button();
+  ASSERT_TRUE(history_button);
+  ASSERT_TRUE(downloads);
+  ASSERT_TRUE(history_button->IsDrawn());
+  auto* const button = views::AsViewClass<views::LabelButton>(history_button);
+  ASSERT_TRUE(button);
+  EXPECT_EQ(u"History", button->GetTooltipText());
+  EXPECT_EQ(u"History", button->GetViewAccessibility().GetCachedName());
+  EXPECT_GE(history_button->GetBoundsInScreen().x(),
+            downloads->GetBoundsInScreen().right())
+      << "not after the downloads button";
+
+  auto* const archived = views::AsViewClass<views::LabelButton>(
+      FindButtonWithTooltip(region(), u"Archived tabs"));
+  ASSERT_TRUE(archived);
+  const std::optional<ui::ImageModel>& glyph =
+      archived->GetImageModel(views::Button::STATE_NORMAL);
+  ASSERT_TRUE(glyph.has_value());
+  ASSERT_TRUE(glyph->IsVectorIcon());
+  EXPECT_EQ(&kSteddingArchiveBoxIcon, glyph->GetVectorIcon().vector_icon());
+
+  stedding::test::ClickLeftMouse(
+      window(), history_button->GetBoundsInScreen().CenterPoint());
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kHistory));
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kNone));
+
+  region()->SetHoveredForTesting(false);
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS_COLLAPSE));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+  Layout();
+  ASSERT_TRUE(history_button->IsDrawn());
+  EXPECT_NEAR(downloads->GetBoundsInScreen().CenterPoint().x(),
+              history_button->GetBoundsInScreen().CenterPoint().x(), 1)
+      << "off the rail's centre line";
+  EXPECT_GE(history_button->GetBoundsInScreen().y(),
+            downloads->GetBoundsInScreen().bottom())
+      << "not under the downloads button";
+  region()->SetHoveredForTesting(std::nullopt);
+
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      stedding::prefs::kSidebarLibraryPanels, false);
+  Layout();
+  EXPECT_FALSE(history_button->IsDrawn());
+}
