+  std::vector<SwitcherSpan> chips;
+  for (int i = 0; i < 7; ++i) {
+    chips.push_back({18 + 36 * i, 24});
+  }
+  const std::vector<std::string> sessions = {"",  "work", "personal", "work",
+                                             "",  "work", "personal"};
