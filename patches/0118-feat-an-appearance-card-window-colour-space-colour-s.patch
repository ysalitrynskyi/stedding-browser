+// settings T41 (GitHub issue 45): the Appearance card. Window colour shows
+// its two colour wells at Custom alone; a colour picked in a well is written
+// to its preference; and an open window takes each new ground at once,
+// Neutral grey's with no hue, a custom one as picked.
+IN_PROC_BROWSER_TEST_F(SettingsSpacesTest, TheAppearanceCardRethemesTheWindow) {
+  PrefService* const local = g_browser_process->local_state();
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser());
+  const auto ground = [&]() {
+    return view->GetColorProvider()->GetColor(ui::kColorFrameActive);
+  };
+  const SkColor before = ground();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://settings/stedding")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  // How many colour wells the Appearance card shows; -1 before it is drawn.
+  const auto wells = [&]() {
+    return content::EvalJs(page, OnThePage(R"(
+      const card = pick('#appearanceSection');
+      if (!card || !pick('#windowColour')) {
+        return -1;
+      }
+      const page = pick('settings-stedding-page');
+      return page.shadowRoot.querySelectorAll(
+          '#appearanceSection input[type=color]').length;
+    )")).ExtractInt();
+  };
+  ASSERT_TRUE(base::test::RunUntil([&]() { return wells() >= 0; }));
+  EXPECT_EQ(0, wells()) << "wells before Custom";
+
+  local->SetInteger(stedding::prefs::kWindowColour, 1);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return ground() != before; }))
+      << "the window kept its ground";
+  EXPECT_EQ(SkColorGetR(ground()), SkColorGetG(ground()));
+  EXPECT_EQ(SkColorGetG(ground()), SkColorGetB(ground())) << "a hue in grey";
+
+  local->SetInteger(stedding::prefs::kWindowColour, 2);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return wells() == 2; }))
+      << "no wells at Custom";
+  // A pick in each well, as the colour panel's choice lands: the input takes
+  // the value and tells its listeners.
+  EXPECT_EQ(true, content::EvalJs(page, OnThePage(R"(
+    const page = pick('settings-stedding-page');
+    const set = (id, value) => {
+      const well = page.shadowRoot.querySelector(id);
+      well.value = value;
+      well.dispatchEvent(new Event('change'));
+    };
+    set('#customLight', '#e8f0e0');
+    set('#customDark', '#203020');
+    return true;
+  )")));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return local->GetInteger(stedding::prefs::kWindowColourLight) ==
+               0xE8F0E0 &&
+           local->GetInteger(stedding::prefs::kWindowColourDark) == 0x203020;
+  })) << "the picks were not written";
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return ground() == SkColorSetRGB(0xE8, 0xF0, 0xE0) ||
+           ground() == SkColorSetRGB(0x20, 0x30, 0x20);
+  })) << "the window did not take the custom colour";
+
+  local->ClearPref(stedding::prefs::kWindowColour);
+  local->ClearPref(stedding::prefs::kWindowColourLight);
+  local->ClearPref(stedding::prefs::kWindowColourDark);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return ground() == before; }));
+}
