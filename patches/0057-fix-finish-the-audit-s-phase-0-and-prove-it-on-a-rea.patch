+// PLAN.md SPC-4, spaces B12: a plain tab, a Space pin and a two-tab
+// selection dropped on a Space's chip move to that Space where the drag left
+// them, keep their page, pin and home, and the window follows them there;
+// the window keeps every tab. An essential and a tab group's header are
+// refused.
+IN_PROC_BROWSER_TEST_F(TabDropTest, TabsDroppedOnAChipMoveToThatSpace) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const spaces::SpaceId home = m->active_id();
+  const spaces::SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+
+  tabs::TabInterface* const essential = Open("essential.test");
+  tab_strip_model()->SetTabPinned(Index(essential), true);
+  tabs::TabInterface* const plain = Open("plain.test");
+  tabs::TabInterface* const pin = Open("pin.test");
+  m->SetSpacePinned(pin, true);
+  tabs::TabInterface* const b = Open("b.test");
+  tabs::TabInterface* const c = Open("c.test");
+  tabs::TabInterface* const grouped = Open("grouped.test");
+  tab_strip_model()->AddToNewGroup({Index(grouped)});
+  Open("stay.test");
+  ASSERT_TRUE(ChipCentre(work));
+
+  // A plain tab.
+  const Kept plain_kept = KeptOf(plain);
+  Drag(RowCentre(plain), *ChipCentre(work));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return m->SpaceForTab(plain) == work;
+  })) << "the tab did not move to Work";
+  ExpectKept(plain, plain_kept);
+  EXPECT_EQ(1u, WindowCount()) << "a window tore off";
+  EXPECT_EQ(work, m->active_id()) << "the window follows the tab";
+  ASSERT_TRUE(m->SetActiveSpace(home));
+
+  // A Space pin keeps its pin and its home.
+  const Kept pin_kept = KeptOf(pin);
+  Drag(RowCentre(pin), *ChipCentre(work));
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return m->SpaceForTab(pin) == work; }));
+  ExpectKept(pin, pin_kept);
+  EXPECT_TRUE(m->IsSpacePinned(pin));
+  EXPECT_EQ(Url("pin.test"), m->HomeUrl(pin).value_or(GURL()));
+  ASSERT_TRUE(m->SetActiveSpace(home));
+
+  // Two selected tabs go together.
+  tab_strip_model()->ActivateTabAt(Index(b));
+  tab_strip_model()->SelectTabAt(Index(c));
+  ASSERT_EQ(2u, tab_strip_model()->selection_model().size());
+  Drag(RowCentre(b), *ChipCentre(work));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return m->SpaceForTab(b) == work && m->SpaceForTab(c) == work;
+  })) << "not all of the selection moved";
+  EXPECT_EQ(1u, WindowCount());
+  ASSERT_TRUE(m->SetActiveSpace(home));
+
+  // An essential belongs to every Space: refused.
+  tab_strip_model()->ActivateTabAt(Index(essential));
+  Drag(RowCentre(essential), *ChipCentre(work));
+  EXPECT_TRUE(essential->IsPinned()) << "the essential was unpinned";
+  EXPECT_EQ(1u, WindowCount());
+
+  // A tab group's header: refused, its tab stays in Home.
+  views::test::RunScheduledLayout(widget());
+  if (TabGroupHeaderView* const header = FindDrawnGroupHeader(root())) {
+    Drag(header->GetBoundsInScreen().CenterPoint(), *ChipCentre(work));
+    EXPECT_EQ(home, m->SpaceForTab(grouped)) << "a group header was taken";
+    EXPECT_EQ(1u, WindowCount());
+  } else {
+    ADD_FAILURE() << "no drawn header for the tab group";
+  }
+}
