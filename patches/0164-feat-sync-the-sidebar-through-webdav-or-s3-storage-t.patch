+TEST_F(SidebarSyncBridgeTest, AListPastItsEntriesStops) {
+  std::string xml = "<multistatus xmlns=\"DAV:\">";
+  for (size_t i = 0; i <= kMaxListEntries + 5; ++i) {
+    xml += "<response><href>/a</href></response>";
+  }
+  xml += "</multistatus>";
+  base::test::TestFuture<data_decoder::DataDecoder::ValueOrError> parsed;
+  data_decoder::DataDecoder::ParseXmlIsolated(
+      xml, data_decoder::mojom::XmlParser::WhitespaceBehavior::kIgnore,
+      parsed.GetCallback());
+  data_decoder::DataDecoder::ValueOrError value = parsed.Take();
+  ASSERT_TRUE(value.has_value());
+  const std::optional<PlaceList> list =
+      ParseWebDavList(*value, GURL("https://place.example.net/dav/"));
+  ASSERT_TRUE(list);
+  EXPECT_EQ(list->entries.size(), kMaxListEntries);
+  EXPECT_TRUE(list->cut_short);
+}
