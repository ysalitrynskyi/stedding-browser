+
+  EXPECT_TRUE(tabstrip()->MoveTabsToFolder({3}, folder));
+  EXPECT_EQ(4, tabstrip()->count()) << "moving into a folder loses nothing";
+  EXPECT_EQ(3u, folder->TabCountRecursive());
+  EXPECT_EQ(folder, joiner->GetParentCollection());
+  EXPECT_EQ(3, tabstrip()->GetIndexOfTab(joiner)) << "appended at the end";
+
+  // A tab already at the front of the strip joins too, and lands last.
+  tabs::TabInterface* const front = tabstrip()->GetTabAtIndex(0);
