+namespace stedding {
+namespace {
+
+using bookmarks::BookmarkNode;
+using password_manager::CredentialUIEntry;
+using password_manager::CSVPassword;
+using password_manager::PasswordForm;
+using user_data_importer::ImportedBookmarkEntry;
+
+ImportedBookmarkEntry Page(std::string url,
+                           std::u16string title,
+                           std::vector<std::u16string> path = {},
+                           bool toolbar = false) {
+  ImportedBookmarkEntry entry;
+  entry.url = GURL(url);
+  entry.title = std::move(title);
+  entry.path = std::move(path);
+  entry.in_toolbar = toolbar;
+  return entry;
+}
+
+const BookmarkNode* ChildNamed(const BookmarkNode* parent,
+                               std::u16string_view title) {
+  for (const auto& child : parent->children()) {
+    if (child->GetTitle() == title) {
+      return child.get();
+    }
+  }
+  return nullptr;
+}
+
+class ImportedBookmarksTest : public testing::Test {
+ protected:
+  ImportedBookmarksTest()
+      : model_(bookmarks::TestBookmarkClient::CreateModel()) {
+    prefs_.registry()->RegisterDictionaryPref(prefs::kImportedBookmarkFolders);
+  }
+
+  // The folders a merge put under Other bookmarks.
+  size_t FoldersUnderOther() const {
+    return model_->other_node()->children().size();
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  TestingPrefServiceSimple prefs_;
+  std::unique_ptr<bookmarks::BookmarkModel> model_;
+};
+
+// import I29, I37, I40: a merge goes into the source's own folder under Other
+// bookmarks, keeping its folders, the toolbar's under their own; only web
+// pages come in; a second merge adds nothing and makes no second folder.
+TEST_F(ImportedBookmarksTest, MergesIntoTheSourcesFolder) {
+  const std::vector<ImportedBookmarkEntry> entries = {
+      Page("https://a.example/", u"A"),
+      Page("https://b.example/", u"B", {u"Work"}),
+      Page("https://c.example/", u"C", {}, /*toolbar=*/true),
+      Page("javascript:void(0)", u"Script"),
+      Page("file:///tmp/notes.html", u"Notes"),
+  };
+  const BookmarkMergeResult first = MergeImportedBookmarks(
+      *model_, prefs_, "dia:Default", u"Imported from Dia", u"Bookmarks bar",
+      entries);
+  EXPECT_EQ(3u, first.added);
+  EXPECT_EQ(0u, first.already_there);
+  ASSERT_EQ(1u, FoldersUnderOther());
+  const BookmarkNode* const folder = model_->other_node()->children()[0].get();
+  EXPECT_EQ(u"Imported from Dia", folder->GetTitle());
+  ASSERT_EQ(3u, folder->children().size());
+  EXPECT_EQ(GURL("https://a.example/"), folder->children()[0]->url());
+  const BookmarkNode* const work = ChildNamed(folder, u"Work");
+  ASSERT_TRUE(work);
+  ASSERT_EQ(1u, work->children().size());
+  EXPECT_EQ(GURL("https://b.example/"), work->children()[0]->url());
+  const BookmarkNode* const bar = ChildNamed(folder, u"Bookmarks bar");
+  ASSERT_TRUE(bar);
+  ASSERT_EQ(1u, bar->children().size());
+  EXPECT_EQ(u"C", bar->children()[0]->GetTitle());
+  EXPECT_FALSE(model_->IsBookmarked(GURL("javascript:void(0)")));
+  EXPECT_TRUE(model_->bookmark_bar_node()->children().empty())
+      << "nothing goes onto the bookmark bar itself";
+
+  const BookmarkMergeResult second = MergeImportedBookmarks(
+      *model_, prefs_, "dia:Default", u"Imported from Dia", u"Bookmarks bar",
+      entries);
+  EXPECT_EQ(0u, second.added);
+  EXPECT_EQ(3u, second.already_there);
+  EXPECT_EQ(1u, FoldersUnderOther());
+  EXPECT_EQ(3u, folder->children().size());
+
+  // Another source has a folder of its own.
+  MergeImportedBookmarks(*model_, prefs_, "safari", u"Imported from Safari",
+                         u"Favorites", {Page("https://a.example/", u"A")});
+  EXPECT_EQ(2u, FoldersUnderOther());
+}
+
+// import I40: the source's folder is found by its UUID wherever the user
+// moved it, and one the user deleted is made again, since the import was
+// asked for.
+TEST_F(ImportedBookmarksTest, ADeletedFolderIsMadeAgain) {
+  const std::vector<ImportedBookmarkEntry> entries = {
+      Page("https://a.example/", u"A")};
+  MergeImportedBookmarks(*model_, prefs_, "safari", u"Imported from Safari",
+                         u"Favorites", entries);
+  ASSERT_EQ(1u, FoldersUnderOther());
+  const BookmarkNode* const folder = model_->other_node()->children()[0].get();
+  model_->Move(folder, model_->bookmark_bar_node(), 0);
+  EXPECT_EQ(0u, MergeImportedBookmarks(*model_, prefs_, "safari",
+                                       u"Imported from Safari", u"Favorites",
+                                       entries)
+                    .added)
+      << "the moved folder was not found";
+  EXPECT_EQ(0u, FoldersUnderOther());
+
+  model_->Remove(folder, bookmarks::metrics::BookmarkEditSource::kUser,
+                 FROM_HERE);
+  const BookmarkMergeResult again = MergeImportedBookmarks(
+      *model_, prefs_, "safari", u"Imported from Safari", u"Favorites",
+      entries);
+  EXPECT_EQ(1u, again.added);
+  ASSERT_EQ(1u, FoldersUnderOther());
+  EXPECT_EQ(u"Imported from Safari",
+            model_->other_node()->children()[0]->GetTitle());
+}
+
+// import I37: an empty folder comes across as a folder, and a Reading List
+// a parser gives apart is a folder of bookmarks like any other.
+TEST_F(ImportedBookmarksTest, ReadingListBecomesAFolder) {
+  ImportedBookmarkEntry empty;
+  empty.is_folder = true;
+  empty.title = u"Empty";
+  const std::vector<ImportedBookmarkEntry> entries = {
+      empty, Page("https://read.example/", u"Later", {u"Reading List"})};
+  EXPECT_EQ(1u, MergeImportedBookmarks(*model_, prefs_, "safari",
+                                       u"Imported from Safari", u"Favorites",
+                                       entries)
+                    .added);
+  const BookmarkNode* const folder = model_->other_node()->children()[0].get();
+  const BookmarkNode* const reading = ChildNamed(folder, u"Reading List");
+  ASSERT_TRUE(reading);
+  ASSERT_EQ(1u, reading->children().size());
+  EXPECT_EQ(GURL("https://read.example/"), reading->children()[0]->url());
+  const BookmarkNode* const kept = ChildNamed(folder, u"Empty");
+  ASSERT_TRUE(kept);
+  EXPECT_TRUE(kept->is_folder());
+}
+
+// import I37: Safari's Favorites come in as a "Favorites" folder in the
+// import's folder, not onto the bookmark bar, which a conversion hides (I14).
+TEST_F(ImportedBookmarksTest, FavoritesKeepTheirFolder) {
+  const std::vector<ImportedBookmarkEntry> entries = {
+      Page("https://fav.example/", u"Fav", {u"Favorites"}),
+      Page("https://bar.example/", u"Bar", {}, /*toolbar=*/true)};
+  EXPECT_EQ(2u, MergeImportedBookmarks(*model_, prefs_, "safari",
+                                       u"Imported from Safari", u"Favorites",
+                                       entries)
+                    .added);
+  const BookmarkNode* const folder = model_->other_node()->children()[0].get();
+  const BookmarkNode* const favorites = ChildNamed(folder, u"Favorites");
+  ASSERT_TRUE(favorites);
+  EXPECT_EQ(2u, favorites->children().size())
+      << "the toolbar's and Favorites' pages share the one folder";
+  EXPECT_TRUE(model_->bookmark_bar_node()->children().empty());
+}
+
+// import I40: a part is off only when a policy turns it off, the way
+// Chromium's own importers read the policies.
+TEST(ImportedBookmarksPolicyTest, PoliciesTurnPartsOff) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterBooleanPref(::prefs::kImportBookmarks, true);
+  prefs.registry()->RegisterBooleanPref(::prefs::kImportHistory, true);
+  prefs.registry()->RegisterBooleanPref(::prefs::kImportSavedPasswords, true);
+  prefs.registry()->RegisterBooleanPref(
+      bookmarks::prefs::kEditBookmarksEnabled, true);
+  prefs.registry()->RegisterBooleanPref(::prefs::kSavingBrowserHistoryDisabled,
+                                        false);
+  prefs.registry()->RegisterBooleanPref(
+      password_manager::prefs::kCredentialsEnableService, true);
+  ImportsAllowed allowed = AllowedImports(prefs);
+  EXPECT_TRUE(allowed.bookmarks);
+  EXPECT_TRUE(allowed.history);
+  EXPECT_TRUE(allowed.passwords);
+
+  // A person's own setting is not a policy.
+  prefs.SetUserPref(::prefs::kImportBookmarks, base::Value(false));
+  EXPECT_TRUE(AllowedImports(prefs).bookmarks);
+
+  prefs.SetManagedPref(::prefs::kImportHistory, base::Value(false));
+  prefs.SetManagedPref(password_manager::prefs::kCredentialsEnableService,
+                       base::Value(false));
+  prefs.SetManagedPref(bookmarks::prefs::kEditBookmarksEnabled,
+                       base::Value(false));
+  allowed = AllowedImports(prefs);
+  EXPECT_FALSE(allowed.bookmarks);
+  EXPECT_FALSE(allowed.history);
+  EXPECT_FALSE(allowed.passwords);
+
+  prefs.RemoveManagedPref(::prefs::kImportHistory);
+  EXPECT_TRUE(AllowedImports(prefs).history);
+  prefs.SetManagedPref(::prefs::kSavingBrowserHistoryDisabled,
+                       base::Value(true));
+  EXPECT_FALSE(AllowedImports(prefs).history);
+}
+
+CSVPassword Login(std::string url,
+                  std::string username,
+                  std::string password) {
+  return CSVPassword(GURL(url), std::move(username), std::move(password),
+                     std::string(), CSVPassword::Status::kOK);
+}
+
+// import I39: an incoming login is new, already saved, or kept out because
+// the profile saves another password for that site and username. Only the
+// profile's own store counts; a row with no password is refused.
+TEST(ImportedPasswordsTest, ClassifiesAgainstTheSavedLogins) {
+  const std::vector<CredentialUIEntry> saved = {
+      CredentialUIEntry(Login("https://a.example/", "ann", "one"),
+                        PasswordForm::Store::kProfileStore),
+      CredentialUIEntry(Login("https://b.example/", "bob", "two"),
+                        PasswordForm::Store::kProfileStore),
+      CredentialUIEntry(Login("https://c.example/", "cat", "three"),
+                        PasswordForm::Store::kAccountStore),
+  };
+  const std::vector<CSVPassword> incoming = {
+      Login("https://a.example/", "ann", "one"),
+      Login("https://b.example/", "bob", "other"),
+      Login("https://c.example/", "cat", "changed"),
+      Login("https://d.example/", "dan", "four"),
+      Login("https://e.example/", "eve", ""),
+  };
+  const PasswordWriteResult result = ClassifyIncomingPasswords(saved, incoming);
+  EXPECT_EQ(1u, result.already_saved);
+  EXPECT_EQ(1u, result.kept);
+  EXPECT_EQ(2u, result.added);
+  EXPECT_EQ(1u, result.refused);
+}
