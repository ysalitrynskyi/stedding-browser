+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_LIVE_FOLDERS_LIVE_FOLDER_SCHEDULER_H_
+#define CHROME_BROWSER_UI_LIVE_FOLDERS_LIVE_FOLDER_SCHEDULER_H_
+
+#include "base/functional/callback.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+
+namespace live_folders {
+
+// docs/features/live-folders.md Lf4, Lf5: when a live folder asks GitHub for
+// its list. Every 10 minutes while a window of the profile is open; on a
+// window coming to the front; on the person's Refresh. Never more than once a
+// minute: an ask within a minute of the last refresh waits until the minute is
+// up, and any number of asks in that wait make one refresh.
+class LiveFolderScheduler {
+ public:
+  static constexpr base::TimeDelta kEvery = base::Minutes(10);
+  static constexpr base::TimeDelta kFloor = base::Minutes(1);
+
+  // `refresh` runs each time a refresh is due. `has_window` says whether a
+  // window of the profile is open; the 10-minute beat skips while none is.
+  LiveFolderScheduler(base::RepeatingClosure refresh,
+                      base::RepeatingCallback<bool()> has_window);
+  LiveFolderScheduler(const LiveFolderScheduler&) = delete;
+  LiveFolderScheduler& operator=(const LiveFolderScheduler&) = delete;
+  ~LiveFolderScheduler();
+
+  // Starts the 10-minute beat. `ran_now` notes a refresh that just ran outside
+  // the scheduler (the one that made the folder).
+  void Start(bool ran_now);
+  // Stops everything: no refresh runs until Start.
+  void Stop();
+  bool running() const { return running_; }
+
+  // A refresh asked for now: runs at once when a minute has passed since the
+  // last, else once when it has.
+  void Ask();
+
+  // Whether an ask is waiting for the minute to pass.
+  bool waiting() const { return deferred_.IsRunning(); }
+  base::TimeTicks last_run() const { return last_run_; }
+
+ private:
+  void Run();
+  void OnBeat();
+
+  const base::RepeatingClosure refresh_;
+  const base::RepeatingCallback<bool()> has_window_;
+  bool running_ = false;
+  base::TimeTicks last_run_;
+  base::RepeatingTimer beat_;
+  base::OneShotTimer deferred_;
+};
+
+}  // namespace live_folders
+
+#endif  // CHROME_BROWSER_UI_LIVE_FOLDERS_LIVE_FOLDER_SCHEDULER_H_
