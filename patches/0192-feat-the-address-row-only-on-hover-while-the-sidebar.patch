+#include "ui/views/focus/focus_manager.h"
+
+class BrowserView;
+
+namespace gfx {
+class PointF;
+}  // namespace gfx
+
+namespace views {
+class EventMonitor;
+}  // namespace views
+
+namespace stedding {
+
+class AddressRow;
+
+// docs/features/toolbar.md T64 (GitHub issue 120; the owner, 2026-11-16,
+// PLAN.md decision 24): with "Show the address row only on hover" on and the
+// sidebar closed, the window's address row hides (AddressRow::
+// HidesInCompact) and comes back over the page while the pointer rests at
+// the window's top edge, as a hidden sidebar comes in from the window's side
+// (sidebar Y19): the page does not move, and the row slides in over it. It
+// stays while the pointer is on it or the keyboard focus is in it, and slides
+// away when the pointer leaves.
+//
+// The edge and the rest are the ones a hidden sidebar has at the window's
+// right edge (sidebar Y39), from the same two settings: a sixth of "Edge that
+// shows a hidden sidebar", 2 DIP at the least, and "Show a hidden sidebar"'s
+// rest and 200 ms more. The page's own controls along its top share that
+// edge, as its scroll bar shares the right one.
+//
+// One per normal window with a sidebar, made by BrowserView once it is in
+// its widget. The window's layout asks OverPage() and Shown() and lays the
+// row over the page while it is there (SteddingBrowserViewLayout).
+class TopRowReveal : public views::FocusChangeListener,
+                     public gfx::AnimationDelegate {
+ public:
+  explicit TopRowReveal(BrowserView* browser_view);
+  TopRowReveal(const TopRowReveal&) = delete;
+  TopRowReveal& operator=(const TopRowReveal&) = delete;
+  ~TopRowReveal() override;
+
+  // Whether the row is over the page now: brought in, sliding in or away.
+  bool OverPage() const;
+
+  // How far down the row is while it is over the page: 0 above the window's
+  // top, 1 all the way in.
+  double Shown() const;
+
+  // Whether the top container is drawn over the page, on a layer of its
+  // own (BrowserView::GetChildrenInZOrder).
+  bool layered() const { return layered_; }
+
+  // After each layout of the window: a reveal the window no longer has --
+  // the sidebar opened, the setting off, full screen -- goes at once, and
+  // the top container is drawn over the page only while the row is there.
+  void OnWindowLaidOut();
+
+  // The pointer, or a touch, at `location` as the window's event monitor
+  // reports it: in the screen's coordinates, the window's on the Mac.
+  void OnPointerAt(const gfx::PointF& location, bool pressed);
+  // The pointer left the window.
+  void OnPointerLeft();
+
+  // Brings the row in at once, with no slide: the keyboard asked for it
+  // (BrowserView::FocusToolbar). Does nothing unless the row hides.
+  void RevealNow();
+
+  // The edge along the window's top that brings the row in, in DIP, and the
+  // rest it takes.
+  int Edge() const;
+  base::TimeDelta Rest() const;
+
+  bool rest_running_for_testing() const { return rest_.IsRunning(); }
+  // Tests drive the pointer into windows that need not be active.
+  void set_ignore_activation_for_testing(bool ignore) {
+    ignore_activation_for_testing_ = ignore;
+  }
+  // Holds the slide at `shown`, 0 above the window's top to 1 all the way
+  // in, as one of its frames: the window lays the row out there next time.
+  void SetShownForTesting(double shown) {
+    slide_.Reset(shown);
+    Relayout();
+  }
+
+  // views::FocusChangeListener:
+  void OnWillChangeFocus(views::View* focused_before,
+                         views::View* focused_now) override {}
+  void OnDidChangeFocus(views::View* focused_before,
+                        views::View* focused_now) override;
+
+  // gfx::AnimationDelegate:
+  void AnimationProgressed(const gfx::Animation* animation) override;
+  void AnimationEnded(const gfx::Animation* animation) override;
+
+ private:
+  class Watcher;
+
+  AddressRow* Row() const;
+  // The row hides now, and could come in.
+  bool Hides() const;
+  bool WindowActive() const;
