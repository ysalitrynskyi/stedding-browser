+  ToastController* const toasts = ToastController::From(browser());
+  ASSERT_TRUE(toasts);
+  const auto toast_up = [&]() {
+    return toasts->IsShowingToast() && toasts->GetToastWidgetForTesting() &&
+           toasts->GetToastWidgetForTesting()->IsVisible();
+  };
+  // The toast's visible top: the widget's top plus the shadow its border
+  // draws, as TheBandTheFieldAndAToastLeaveTheAddressReadable reads it.
+  const auto toast_top = [&]() {
+    views::test::RunScheduledLayout(view());
+    auto* const toast = toasts->GetToastViewForTesting();
+    return toasts->GetToastWidgetForTesting()->GetWindowBoundsInScreen().y() +
+           toast->GetBubbleFrameView()->bubble_border()->GetInsets().top();
+  };
+  const auto row_bottom = [&]() {
+    return view()->toolbar()->GetBoundsInScreen().bottom();
+  };
+  // On or under the bars' bottom edge, where the page starts. A screen at
+  // 150% puts the toast's top a DIP over that edge by rounding (94 against
+  // 95 on the PC, 2026-10-19): the edge, not the bar's text.
+  const auto under_the_bars = [&]() {
+    return toast_top() >= bars->GetBoundsInScreen().bottom() - 1;
+  };
+
+  {
