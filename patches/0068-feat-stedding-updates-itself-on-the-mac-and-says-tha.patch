diff --git a/build/apple/tweak_info_plist.py b/build/apple/tweak_info_plist.py
index d91204a320f42..e6d607914d787 100755
--- a/build/apple/tweak_info_plist.py
+++ b/build/apple/tweak_info_plist.py
@@ -108,6 +108,28 @@ def _GetVersion(version_format, values, overrides=None):
     return result
 
 
+def _SteddingBundleVersion(version):
+    """CFBundleVersion for a Stedding version (docs/features/updates.md Up11).
+
+    <major>.<minor>.<patch>[-beta.<n>] becomes
+    "<10000 + 1000 * major + 10 * minor + patch>.<n>", with n the beta's
+    number and 999 for the release: two numbers, as LaunchServices wants,
+    ordered as the versions are (Sparkle compares this key), and above the
+    Chromium build numbers (8059.12) the versions before the updater carried.
+    Returns None for a version outside that shape or past its room (minor up
+    to 99, patch up to 9, beta up to 998).
+    """
+    match = re.fullmatch(r'(\d+)\.(\d+)\.(\d+)(?:-beta\.(\d+))?', version)
+    if not match:
+        return None
+    major, minor, patch = (int(match.group(i)) for i in (1, 2, 3))
+    beta = int(match.group(4)) if match.group(4) else 999
+    if minor > 99 or patch > 9 or not 1 <= beta <= 999 or (
+            match.group(4) and beta == 999):
+        return None
+    return '%d.%d' % (10000 + 1000 * major + 10 * minor + patch, beta)
+
+
 def _AddVersionKeys(
     plist, version_format_for_key, version=None, overrides=None
 ):
