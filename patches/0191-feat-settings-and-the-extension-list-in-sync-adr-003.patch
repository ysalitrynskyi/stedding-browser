+// Sf61 (review finding: a route stamped before a join's pair): a Space id a
+// setting carries from before the pair is read, and written again, as the id
+// the pair gave that Space; each setting keeps its stamp.
+TEST(SidebarSyncSettingsTest, ARouteStampedBeforeAPairFindsItsSpace) {
+  const SettingRule* const routes =
+      FindSettingRule(stedding::prefs::kSpaceRoutes);
+  const SettingRule* const external =
+      FindSettingRule(stedding::prefs::kExternalDefaultSpace);
+  ASSERT_TRUE(routes);
+  ASSERT_TRUE(external);
+  // This computer's Work was "S_WORK"; a join paired it with another
+  // computer's "B_WORK", the smaller, so the shared id is "B_WORK".
+  SpaceMap here;
+  here.resolved = {{"S_WORK", "B_WORK"}};
+  here.to_shared = {{"S_WORK", "B_WORK"}};
+  here.to_local = {{"B_WORK", "S_WORK"}};
+  base::ListValue stamped;
+  stamped.Append(Route("github.com", "S_WORK"));
+  const std::optional<base::Value> applied = SettingFromWire(
+      *routes, base::Value(stamped.Clone()), base::Value(stamped.Clone()),
+      here);
+  ASSERT_TRUE(applied);
+  ASSERT_EQ(1u, applied->GetList().size());
+  EXPECT_EQ("S_WORK", *applied->GetList()[0].GetDict().FindString("space"));
+  EXPECT_EQ(base::Value("S_WORK"),
+            *SettingFromWire(*external, base::Value("S_WORK"), base::Value(""),
+                             here));
+
+  // The ledger's values are written again under the shared id, with their
+  // stamps; a plain setting is left as it is.
+  Settings settings;
+  settings[stedding::prefs::kSpaceRoutes] = SettingField{
+      SettingJson(base::Value(stamped.Clone())), Stamp{40, kOffice}};
+  settings[stedding::prefs::kExternalDefaultSpace] =
+      SettingField{SettingJson(base::Value("S_WORK")), Stamp{41, kOffice}};
+  settings[stedding::prefs::kPeekEnabled] =
+      SettingField{"true", Stamp{42, kOffice}};
+  ASSERT_TRUE(CanonicalizeSettings(settings, here.resolved));
+  EXPECT_NE(std::string::npos,
+            settings[stedding::prefs::kSpaceRoutes].json.find("B_WORK"));
+  EXPECT_EQ(std::string::npos,
+            settings[stedding::prefs::kSpaceRoutes].json.find("S_WORK"));
+  EXPECT_EQ((Stamp{40, kOffice}), settings[stedding::prefs::kSpaceRoutes].s);
+  EXPECT_EQ("\"B_WORK\"",
+            settings[stedding::prefs::kExternalDefaultSpace].json);
+  EXPECT_EQ("true", settings[stedding::prefs::kPeekEnabled].json);
+  EXPECT_FALSE(CanonicalizeSettings(settings, here.resolved));
+}
