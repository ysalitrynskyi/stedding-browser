--- a/chrome/browser/ui/spaces/space_registry.cc
+++ b/chrome/browser/ui/spaces/space_registry.cc
@@ -105,6 +105,26 @@ void SpaceRegistry::SetColor(const SpaceId& id, SkColor color, bool chosen) {
   }
 }
 
+void SpaceRegistry::SetProfileId(const SpaceId& id, std::string profile_id) {
+  if (RegistryEntry* const entry = FindMutable(id)) {
+    if (entry->profile_id == profile_id) {
+      return;
+    }
+    entry->profile_id = std::move(profile_id);
+    Changed();
+  }
+}
+
+void SpaceRegistry::EnsureIsolated(const SpaceId& id) {
+  if (RegistryEntry* const entry = FindMutable(id)) {
+    if (!entry->profile_id.empty()) {
+      return;
+    }
+    entry->profile_id = base::Token::CreateRandom().ToString();
+    Changed();
+  }
+}
+
 void SpaceRegistry::AddObserver(Observer* observer) {
   observers_.AddObserver(observer);
 }
