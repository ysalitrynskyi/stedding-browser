+  TabStripModel* const strip = browser()->GetTabStripModel();
+  tabs::TabInterface* const essential = strip->GetActiveTab();
+  model.SetSpaceForTab(essential, one_id);
+  strip->SetTabPinned(strip->GetIndexOfTab(essential), true);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(model.IsOwnEssential(essential));
+  ASSERT_EQ(1u, Store().records().size());
+  ASSERT_TRUE(Store().records().front().has_space);
+  ASSERT_EQ(one_id, Store().records().front().space);
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Essentials(second).size() == 1u; }));
+  tabs::TabInterface* const there = Essentials(second).front();
+  ASSERT_TRUE(Model(second).IsOwnEssential(there));
+  ASSERT_EQ(one_id, Model(second).FindSpaceForTab(there));
+
+  model.SetSpaceForTab(essential, two_id);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Store().records().size() == 1u &&
+           Store().records().front().space == two_id;
+  })) << "the move did not reach the store";
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Essentials(second).size() == 1u &&
+           Model(second).FindSpaceForTab(Essentials(second).front()) == two_id;
+  })) << "the second window's own essential stayed in its old Space";
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(Model(second).IsOwnEssential(Essentials(second).front()));
+  EXPECT_EQ(two_id, model.FindSpaceForTab(essential));
+  EXPECT_TRUE(model.IsOwnEssential(essential));
+  ASSERT_EQ(1u, Store().records().size());
+  EXPECT_EQ(two_id, Store().records().front().space);
+  EXPECT_EQ(spaces::PinTier::kEssential, Store().records().front().tier);
+}
