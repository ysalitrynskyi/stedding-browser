 }
 
+// PLAN.md SPC-4, spaces B12: while a dragged row is over a chip that would
+// take it, that chip is lit; it goes dark when the pointer leaves it and once
+// the row is dropped, and an essential, which no chip takes, lights none.
+IN_PROC_BROWSER_TEST_F(TabDropTest, TheChipUnderADraggedRowIsLit) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const spaces::SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+  tabs::TabInterface* const essential = Open("essential.test");
+  tab_strip_model()->SetTabPinned(Index(essential), true);
+  tabs::TabInterface* const plain = Open("plain.test");
+  Open("stay.test");
+  ASSERT_TRUE(ChipCentre(work));
+  spaces::SpaceSwitcherView* const switcher = FindDrawnSwitcher(root());
+  ASSERT_TRUE(switcher);
+
+  // Pressed on the row, moved over the chip in steps, not released.
+  const gfx::Point row = RowCentre(plain);
+  const gfx::Point chip = *ChipCentre(work);
+  const auto move = [&](const gfx::Point& from, const gfx::Point& to) {
+    for (int step = 1; step <= 12; ++step) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * step / 12,
+                     from.y() + (to.y() - from.y()) * step / 12));
+    }
+    base::RunLoop().RunUntilIdle();
+  };
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, row);
+  move(row, chip);
+  EXPECT_EQ(work, switcher->drop_target_for_testing())
+      << "the chip under the dragged row is not lit";
+  views::View* const lit = switcher->ChipForTesting(work);
+  ASSERT_TRUE(lit);
+  EXPECT_TRUE(lit->GetBackground()) << "the lit chip draws nothing behind it";
+
+  // Away from the chips, back over the list: dark again.
+  move(chip, row);
+  EXPECT_EQ(std::nullopt, switcher->drop_target_for_testing())
+      << "the chip stayed lit with the pointer off it";
+
+  // Back over the chip and dropped: the row moves, and the chip goes dark.
+  move(row, chip);
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, chip);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return m->SpaceForTab(plain) == work;
+  })) << "the row did not move to Work";
+  EXPECT_EQ(std::nullopt, switcher->drop_target_for_testing())
+      << "the chip stayed lit after the drop";
+
+  // An essential belongs to every Space: no chip lights for it.
+  ASSERT_TRUE(m->SetActiveSpace(m->spaces().front()->id()));
+  tab_strip_model()->ActivateTabAt(Index(essential));
+  const gfx::Point pinned = RowCentre(essential);
+  const gfx::Point chip_again = *ChipCentre(work);
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, pinned);
+  move(pinned, chip_again);
+  EXPECT_EQ(std::nullopt, switcher->drop_target_for_testing())
+      << "a chip lit for an essential it will not take";
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased,
+                                chip_again);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(essential->IsPinned());
+}
