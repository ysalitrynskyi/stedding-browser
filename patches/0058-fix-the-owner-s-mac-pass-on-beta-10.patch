+  ASSERT_TRUE(list);
+  const auto settled = [&] {
+    views::test::RunScheduledLayout(window);
+    return !list->IsAnimatingForTesting();
+  };
+  ASSERT_TRUE(base::test::RunUntil(settled));
+
+  model()->SetActiveSpace(ids_[1]);
+  views::test::RunScheduledLayout(window);
+  const std::map<const tabs::TabInterface*, gfx::Rect> at_once =
+      RowBounds(*list);
+  ASSERT_EQ(6u, at_once.size());
+  ASSERT_TRUE(base::test::RunUntil(settled));
+  EXPECT_EQ(at_once, RowBounds(*list))
+      << "the rows went on moving after the switch";
+}
