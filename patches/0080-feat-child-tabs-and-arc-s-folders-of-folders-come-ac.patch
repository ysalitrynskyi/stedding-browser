+// Inserts the tabs directly in Arc's list `node` into `space`, unloaded,
+// skipping what an earlier import brought and what cannot be opened.
+std::vector<tabs::TabInterface*> InsertDirectTabs(ApplyContext& ctx,
+                                                  const Node& node,
+                                                  const SpaceId& space) {
+  std::vector<tabs::TabInterface*> inserted;
+  for (const Node& child : node.children) {
+    if (child.kind == Node::Kind::kFolder) {
+      continue;
+    }
+    if (ctx.ids->Contains(child.arc_id) ||
+        ctx.open_tabs.contains(child.arc_id)) {
+      ++ctx.result->skipped;
+      continue;
+    }
+    if (!IsImportablePage(child.url)) {
+      continue;
+    }
+    tabs::TabInterface* const tab =
+        InsertUnloaded(ctx.tabs, ctx.profile, child);
+    if (!tab) {
+      continue;
+    }
+    ctx.model->SetSpaceForTab(tab, space);
+    ctx.ids->Add(child.arc_id);
+    ++ctx.result->tabs;
+    inserted.push_back(tab);
+  }
+  return inserted;
+}
+
+// Makes Arc's list `node` a folder around `tabs`, inside `parent` (or at the
+// top), named and remembered as Arc's (I12). Null when there is no tab to
+// make it around.
+tabs::FolderTabCollection* MakeFolder(
+    ApplyContext& ctx,
+    const std::vector<tabs::TabInterface*>& tabs,
+    tabs::FolderTabCollection* parent,
+    const Node& node) {
+  std::vector<int> indices;
+  for (tabs::TabInterface* const tab : tabs) {
+    const int index = ctx.tabs->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab) {
+      indices.push_back(index);
+    }
+  }
+  if (indices.empty()) {
+    return nullptr;
+  }
+  std::ranges::sort(indices);
+  tabs::FolderTabCollection* const folder =
+      ctx.tabs->AddToNewFolder(indices, parent);
+  if (folder) {
+    folder->SetTitle(base::UTF16ToUTF8(node.title));
+    ctx.ids->Add(node.arc_id);
+    ctx.ids->RememberFolder(node.arc_id, folder->id());
+    ++ctx.result->folders;
+  }
+  return folder;
+}
