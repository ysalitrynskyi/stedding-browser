+  })) << "not all of the selection joined the folder";
+  EXPECT_LT(Index(first), Index(f1)) << "the row above the folder moved";
+  EXPECT_FALSE(IsIn(after, folder));
+  EXPECT_EQ(1u, WindowCount()) << "a window tore off";
+}
+
+// BACKLOG S-232 (folders F7): a row from the middle of a folder, dragged the
+// pointer's way out of it -- up onto the row above the folder, or down onto
+// the row below -- is drawn under the pointer on the way and lands where it
