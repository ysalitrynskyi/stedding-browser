+// spaces B11, B38 (BACKLOG S-548): on a chip not on screen the glyph is grey
+// and the badge keeps its session's colour, over the glyph and faded less
+// (kInactiveMarkAlpha). The badge draws in a layer of its own above the
+// glyph's, which alone the compositor greys; a badge without a layer would
+// be drawn under the glyph's.
+IN_PROC_BROWSER_TEST_F(IsolationMarkTest, TheBadgeKeepsItsColourOnAGreyChip) {
+  model()->SetSpaceIsolated(work_, true);
+  tabs::VerticalTabStripStateController* const controller =
+      tabs::VerticalTabStripStateController::From(browser());
+  controller->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+  ASSERT_TRUE(controller->IsCollapsed());
+  for (const bool on_screen : {false, true}) {
+    SCOPED_TRACE(on_screen ? "Work on screen" : "Work not on screen");
+    ASSERT_TRUE(model()->SetActiveSpace(on_screen ? work_ : home_));
+    views::View* const chip = Chip(work_);
+    ASSERT_TRUE(chip);
+    stedding::IsolationMarkView* const badge =
+        stedding::FindShownIsolationMark(chip);
+    ASSERT_TRUE(badge) << "no badge on the rail's chip";
+    views::Label* glyph = nullptr;
+    for (views::View* const child : chip->children()) {
+      if (auto* const label = views::AsViewClass<views::Label>(child)) {
+        glyph = label;
+      }
+    }
+    ASSERT_TRUE(glyph);
+    ASSERT_TRUE(glyph->layer());
+    ASSERT_TRUE(badge->layer()) << "the badge would be drawn under the glyph";
+    EXPECT_EQ(on_screen ? 0.0f : 1.0f, glyph->layer()->layer_grayscale());
+    for (const ui::Layer* layer = badge->layer(); layer;
+         layer = layer->parent()) {
+      EXPECT_EQ(0.0f, layer->layer_grayscale())
+          << "the badge is greyed by " << layer->name();
+    }
+    EXPECT_EQ(on_screen ? SK_AlphaOPAQUE : 0xB3, badge->alpha());
+    EXPECT_EQ(SessionSlotOf(work_), badge->session_slot());
+    // Above the glyph: later among their parent layer's children.
+    ui::Layer* const parent = glyph->layer()->parent();
+    ASSERT_TRUE(parent);
+    ASSERT_EQ(parent, badge->layer()->parent());
+    const auto& stack = parent->children();
+    const auto glyph_at = std::ranges::find(stack, glyph->layer());
+    const auto badge_at = std::ranges::find(stack, badge->layer());
+    ASSERT_NE(stack.end(), glyph_at);
+    ASSERT_NE(stack.end(), badge_at);
+    EXPECT_LT(glyph_at, badge_at) << "the badge is under the glyph";
+  }
+}
