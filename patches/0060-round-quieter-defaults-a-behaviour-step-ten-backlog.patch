+// completes what is typed to it, the rest selected. Backspace through the
+// field's own key path removes the completion, and nothing completes again
+// for that text; typing on completes it again, and Enter goes to the site.
+IN_PROC_BROWSER_TEST_F(CommandBarKeysTest, ASiteFromHistoryCompletesTheField) {
+  history::HistoryService* const history =
+      HistoryServiceFactory::GetForProfile(browser()->GetProfile(),
+                                           ServiceAccessType::EXPLICIT_ACCESS);
