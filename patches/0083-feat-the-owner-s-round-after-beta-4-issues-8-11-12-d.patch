+  ToastController* const toasts = ToastController::From(little);
+  ASSERT_TRUE(toasts) << "a little window shows no toasts";
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return toasts->IsShowingToast() &&
+           toasts->GetCurrentToastId() == ToastId::kSteddingLinkCopiedClean;
+  })) << "no \"Link copied, tracking removed\" toast";
+  Click(button, ui::EF_ALT_DOWN);
+  EXPECT_EQ(u"[shop.test](" + clean + u")", ClipboardText());
+
+  BrowserWindowInterface* const popup =
+      CreateBrowserForPopup(browser()->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      popup, embedded_test_server()->GetURL("a.test", "/title1.html")));
+  page_actions::PageActionView* const popup_button = ButtonOf(popup);
+  EXPECT_FALSE(popup_button && popup_button->GetVisible());
+}
