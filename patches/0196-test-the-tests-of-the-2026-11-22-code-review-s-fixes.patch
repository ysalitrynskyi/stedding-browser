+// The command bar's suggestions and typed text: no starter-pack or model
+// scope is offered as a suggestion (commandbar K4, K27), a typed "keyword
+// query" opens only an engine the omnibox's keyword mode would use (K18),
+// and what the bar opens is sent as a search or as a typed address, as the
+// address bar sends it (routing D11).
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/search_engines/template_url_service_factory.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/views/commandbar/command_bar_view.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/omnibox/browser/autocomplete_match.h"
+#include "components/omnibox/browser/autocomplete_match_type.h"
+#include "components/omnibox/browser/autocomplete_result.h"
+#include "components/search_engines/template_url.h"
+#include "components/search_engines/template_url_data.h"
+#include "components/search_engines/template_url_service.h"
+#include "components/search_engines/template_url_starter_pack_data.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+ui::KeyEvent PressB23(ui::KeyboardCode code) {
+  return ui::KeyEvent(ui::EventType::kKeyPressed, code, ui::EF_NONE);
+}
+
+// Enter on the chosen row, through the bar's own key handling.
+bool EnterB23(CommandBarView& bar) {
+  return bar.HandleKeyEvent(bar.field_for_testing(), PressB23(ui::VKEY_RETURN));
+}
+
+void DownB23(CommandBarView& bar) {
+  bar.HandleKeyEvent(bar.field_for_testing(), PressB23(ui::VKEY_DOWN));
+}
+
+// An edit as the field reports one, with the caret at the end of the text.
+void TypeIntoB23(CommandBarView& bar, const std::u16string& text) {
+  views::Textfield* const field = bar.field_for_testing();
+  bar.OnBeforeUserAction(field);
+  field->SetText(text);
+  bar.ContentsChanged(field, text);
+}
+
+AutocompleteResult ResultOfB23(const ACMatches& matches) {
+  AutocompleteResult result;
+  result.AppendMatches(matches);
+  return result;
+}
+
+// One of the omnibox's answers.
+AutocompleteMatch MatchB23(omnibox::AutocompleteMatchType type,
+                           const GURL& url,
+                           const std::u16string& contents,
+                           const std::u16string& description) {
+  AutocompleteMatch match(/*provider=*/nullptr, /*relevance=*/1000,
+                          /*deletable=*/false, type);
+  match.destination_url = url;
+  match.contents = contents;
+  match.description = description;
+  match.fill_into_edit = contents;
+  return match;
+}
+
+// The rows the omnibox's answers made, by their titles: every row after the
+// typed one that says what kind of suggestion it is (K4).
+std::vector<std::u16string> SuggestionTitlesB23(CommandBarView& bar) {
+  std::vector<std::u16string> titles;
+  for (size_t i = 1; i < bar.row_count_for_testing(); ++i) {
+    const std::u16string detail = bar.row_detail_for_testing(i);
+    if (detail == u"Search" || detail == u"History" ||
+        detail == u"Bookmark" || detail == u"Open") {
+      titles.push_back(bar.row_title_for_testing(i));
+    }
+  }
+  return titles;
+}
+
+bool AnyTitleHasB23(const std::vector<std::u16string>& titles,
+                    std::u16string_view part) {
+  for (const std::u16string& title : titles) {
+    if (base::ToLowerASCII(title).find(part) != std::u16string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// The titles, one per line, for a failure's message.
+std::string JoinedB23(const std::vector<std::u16string>& titles) {
+  std::string joined;
+  for (const std::u16string& title : titles) {
+    joined += "\n  " + base::UTF16ToUTF8(title);
+  }
+  return joined;
+}
+
+// The first row after the typed one whose detail is `detail`; the row count
+// when there is none.
+size_t RowWithDetailB23(CommandBarView& bar, std::u16string_view detail) {
+  for (size_t i = 1; i < bar.row_count_for_testing(); ++i) {
+    if (bar.row_detail_for_testing(i) == detail) {
+      return i;
+    }
+  }
+  return bar.row_count_for_testing();
+}
+
+class CommandBarB23Test : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& TabsB23() { return *browser()->GetTabStripModel(); }
+
+  // The profile's search engines, which a unit test's profile does not have
+  // until it asks.
+  TemplateURLService& UseSearchEnginesB23() {
+    TemplateURLServiceFactory::GetInstance()->SetTestingFactoryAndUse(
+        profile(),
+        base::BindRepeating(&TemplateURLServiceFactory::BuildInstanceFor));
+    return *TemplateURLServiceFactory::GetForProfile(profile());
+  }
+
+  static void AddEngineB23(
+      TemplateURLService& engines,
+      const std::u16string& name,
+      const std::u16string& keyword,
+      const std::string& url,
+      TemplateURLData::ActiveStatus active,
+      template_url_starter_pack_data::StarterPackId pack =
+          template_url_starter_pack_data::StarterPackId::kNone) {
+    TemplateURLData data;
+    data.SetShortName(name);
+    data.SetKeyword(keyword);
+    data.SetURL(url);
+    data.is_active = active;
+    data.starter_pack_id = static_cast<int>(pack);
+    ASSERT_TRUE(engines.Add(std::make_unique<TemplateURL>(data)));
+  }
+
+  // How the active tab's page is being loaded: as a search, or as an
+  // address typed.
+  ui::PageTransition ActiveTransitionB23() {
+    content::NavigationEntry* const entry =
+        TabsB23().GetActiveWebContents()->GetController().GetPendingEntry();
+    EXPECT_TRUE(entry) << "the active tab loads nothing";
+    return entry ? entry->GetTransitionType() : ui::PAGE_TRANSITION_LINK;
+  }
+};
+
+// P31-1b; commandbar K4, K27, ADR 0020. Chromium's own answer to text that
+// starts with "@" -- K19's Space filter here -- is its starter pack, and an
+// enterprise's featured searches. The bar listed them as History rows:
+// "@gemini - Ask Gemini" opened Gemini, and "@tabs - Search tabs" a help
+// page over http. None is a suggestion; a scope is offered only as K27's
+// site search. Nor is a search on a model's scope, for text that names it.
+// A page from history is still listed.
+TEST_F(CommandBarB23Test, StarterPackAndModelScopesAreNeverSuggested) {
+  using template_url_starter_pack_data::StarterPackId;
+  TemplateURLService& engines = UseSearchEnginesB23();
+  AddEngineB23(engines, u"Gemini", u"@askgemini",
+               "https://gemini.google.com/app?q={searchTerms}",
+               TemplateURLData::ActiveStatus::kTrue, StarterPackId::kGemini);
+  ASSERT_FALSE(HasFatalFailure());
+  AddTab(browser(), GURL("https://example.com/"));
+  auto bar = std::make_unique<CommandBarView>(browser());
+
+  TypeIntoB23(*bar, u"@");
+  AutocompleteMatch gemini =
+      MatchB23(omnibox::AutocompleteMatchType::kStarterPack,
+               GURL("https://gemini.google.com"), u"", u"@gemini - Ask Gemini");
+  gemini.keyword = u"@gemini";
+  AutocompleteMatch open_tabs = MatchB23(
+      omnibox::AutocompleteMatchType::kStarterPack,
+      GURL("http://support.google.com/chrome/?p=tab_search"), u"",
+      u"@tabs - Search tabs");
+  open_tabs.keyword = u"@tabs";
+  AutocompleteMatch marks =
+      MatchB23(omnibox::AutocompleteMatchType::kStarterPack,
+               GURL("chrome://bookmarks"), u"", u"@bookmarks - Search bookmarks");
+  marks.keyword = u"@bookmarks";
+  AutocompleteMatch featured =
+      MatchB23(omnibox::AutocompleteMatchType::kFeaturedEnterpriseSearch,
+               GURL("https://intranet.example/"), u"",
+               u"@intranet - Search Intranet");
+  featured.keyword = u"@intranet";
+  const AutocompleteMatch visited =
+      MatchB23(omnibox::AutocompleteMatchType::kHistoryUrl,
+               GURL("https://visited.example/"), u"visited.example",
+               u"Visited page");
+  bar->SetAutocompleteResultForTesting(
+      ResultOfB23({gemini, open_tabs, marks, featured, visited}));
+  {
+    const std::vector<std::u16string> titles = SuggestionTitlesB23(*bar);
+    SCOPED_TRACE("the suggestions:" + JoinedB23(titles));
+    EXPECT_FALSE(AnyTitleHasB23(titles, u"gemini")) << "Gemini is suggested";
+    EXPECT_FALSE(AnyTitleHasB23(titles, u"search tabs"))
+        << "the tabs scope is suggested";
+    EXPECT_FALSE(AnyTitleHasB23(titles, u"@bookmarks"))
+        << "a scope is suggested outside K27's row";
+    EXPECT_FALSE(AnyTitleHasB23(titles, u"intranet"))
+        << "a featured search is suggested";
+    EXPECT_TRUE(AnyTitleHasB23(titles, u"visited.example"))
+        << "the page from history is not listed";
+  }
+
+  // A search on the Gemini scope, as the omnibox answers its keyword with a
+  // query, next to one on the default engine.
+  TypeIntoB23(*bar, u"@askgemini hello");
+  AutocompleteMatch asked =
+      MatchB23(omnibox::AutocompleteMatchType::kSearchOtherEngine,
+               GURL("https://gemini.google.com/app?q=hello"), u"hello", u"");
+  asked.keyword = u"@askgemini";
+  const TemplateURL* const default_engine = engines.GetDefaultSearchProvider();
+  ASSERT_TRUE(default_engine);
+  AutocompleteMatch searched =
+      MatchB23(omnibox::AutocompleteMatchType::kSearchSuggest,
+               GURL("https://search.example/?q=hello+world"), u"hello world",
+               u"");
+  searched.keyword = default_engine->keyword();
+  bar->SetAutocompleteResultForTesting(ResultOfB23({asked, searched}));
+  {
+    const std::vector<std::u16string> titles = SuggestionTitlesB23(*bar);
+    SCOPED_TRACE("the suggestions:" + JoinedB23(titles));
+    EXPECT_FALSE(std::ranges::contains(titles, std::u16string(u"hello")))
+        << "a search on Gemini is suggested";
+    EXPECT_TRUE(std::ranges::contains(titles, std::u16string(u"hello world")))
+        << "the default engine's suggestion is not listed";
+  }
+}
+
+// P31-1c; commandbar K18. Chromium makes an inactive search engine, keyed by
+// the site's host, for a site the user searched on with its own search box
+// or that names an OpenSearch file; and an engine turned off in Settings
+// stays in the list. The omnibox's keyword mode uses neither. Typed whole,
+// "github.com actions pricing" opened that site's own search for "actions
+// pricing". Text that starts with such a keyword is a search for the whole
+// text with the default engine; an active engine's keyword still opens it.
+TEST_F(CommandBarB23Test, AKeywordQueryOpensNoInactiveEngine) {
+  TemplateURLService& engines = UseSearchEnginesB23();
+  AddEngineB23(engines, u"zettel.example", u"zettel.example",
+               "https://zettel.example/find?q={searchTerms}",
+               TemplateURLData::ActiveStatus::kUnspecified);
+  AddEngineB23(engines, u"Turned off", u"off.example",
+               "https://off.example/find?q={searchTerms}",
+               TemplateURLData::ActiveStatus::kFalse);
+  AddEngineB23(engines, u"Turned on", u"on.example",
+               "https://on.example/find?q={searchTerms}",
+               TemplateURLData::ActiveStatus::kTrue);
+  ASSERT_FALSE(HasFatalFailure());
+  ASSERT_TRUE(engines.GetDefaultSearchProvider());
+  AddTab(browser(), GURL("https://example.com/"));
+  auto bar = std::make_unique<CommandBarView>(browser());
+
+  for (const std::string_view host : {"zettel.example", "off.example"}) {
+    SCOPED_TRACE(host);
+    const CommandBarView::Classification result =
+        bar->ClassifyForTesting(base::UTF8ToUTF16(host) + u" rust");
+    EXPECT_TRUE(result.is_search);
+    EXPECT_NE(host, result.destination.host())
+        << "an engine the omnibox would not use opened";
+    EXPECT_NE(std::string::npos, result.destination.spec().find(host))
+        << "the whole text is not what is searched: "
+        << result.destination.spec();
+  }
+  EXPECT_EQ("on.example",
+            bar->ClassifyForTesting(u"on.example rust").destination.host());
+
+  // Enter on the typed row searches the whole text.
+  TypeIntoB23(*bar, u"zettel.example rust");
+  ASSERT_GT(bar->row_count_for_testing(), 0u);
+  EXPECT_EQ(u"Search", bar->row_detail_for_testing(0));
+  EXPECT_TRUE(EnterB23(*bar));
+  EXPECT_NE("zettel.example",
+            TabsB23().GetActiveWebContents()->GetVisibleURL().host());
+}
+
+// P09-1a; routing D11. The navigator tells a search from a typed address by
+// how it is sent: a search as a generated address, which follows no
+// "contains" rule. The bar sent everything as typed, so its searches were
+// routed by the words searched for. A typed search, a chosen search
+// suggestion and a site search's chip go as searches; a typed address, a
+// page from history and the typed text completed to a site (K23) go as
+// typed addresses.
+TEST_F(CommandBarB23Test, TheBarSendsASearchAsASearch) {
+  TemplateURLService& engines = UseSearchEnginesB23();
+  AddEngineB23(engines, u"Zettel", u"zt",
+               "https://zettel.example/find?q={searchTerms}",
+               TemplateURLData::ActiveStatus::kTrue);
+  ASSERT_FALSE(HasFatalFailure());
+  ASSERT_TRUE(engines.GetDefaultSearchProvider());
+  AddTab(browser(), GURL("https://example.com/"));
+
+  {
+    SCOPED_TRACE("typed text that is a search");
+    auto bar = std::make_unique<CommandBarView>(browser());
+    TypeIntoB23(*bar, u"jira alternatives");
+    ASSERT_GT(bar->row_count_for_testing(), 0u);
+    ASSERT_EQ(u"Search", bar->row_detail_for_testing(0));
+    const int count = TabsB23().count();
+    ASSERT_TRUE(EnterB23(*bar));
+    ASSERT_EQ(count + 1, TabsB23().count());
+    EXPECT_TRUE(ui::PageTransitionCoreTypeIs(ActiveTransitionB23(),
+                                             ui::PAGE_TRANSITION_GENERATED));
+  }
+
+  {
+    SCOPED_TRACE("a site search's chip");
+    auto bar = std::make_unique<CommandBarView>(browser());
+    TypeIntoB23(*bar, u"zt");
+    ASSERT_TRUE(bar->HandleKeyEvent(bar->field_for_testing(),
+                                    PressB23(ui::VKEY_TAB)));
+    ASSERT_EQ(u"Zettel", bar->site_chip_for_testing());
+    TypeIntoB23(*bar, u"jira");
+    ASSERT_GT(bar->row_count_for_testing(), 0u);
+    const int count = TabsB23().count();
+    ASSERT_TRUE(EnterB23(*bar));
+    ASSERT_EQ(count + 1, TabsB23().count());
+    EXPECT_EQ("zettel.example",
+              TabsB23().GetActiveWebContents()->GetVisibleURL().host());
+    EXPECT_TRUE(ui::PageTransitionCoreTypeIs(ActiveTransitionB23(),
+                                             ui::PAGE_TRANSITION_GENERATED));
+  }
+
+  // Each step types a word no tab open by then has in its title, so its
+  // suggestion is the only row under the typed one.
+  {
+    SCOPED_TRACE("a search suggestion");
+    auto bar = std::make_unique<CommandBarView>(browser());
+    TypeIntoB23(*bar, u"kanban");
+    const GURL suggested("https://search.example/?q=kanban+pricing");
+    bar->SetAutocompleteResultForTesting(ResultOfB23(
+        {MatchB23(omnibox::AutocompleteMatchType::kSearchSuggest, suggested,
+                  u"kanban pricing", u"")}));
+    const size_t row = RowWithDetailB23(*bar, u"Search");
+    ASSERT_LT(row, bar->row_count_for_testing()) << "the suggestion is gone";
+    for (size_t i = 0; i < row; ++i) {
+      DownB23(*bar);
+    }
+    ASSERT_EQ(row, bar->selected_row_for_testing());
+    const int count = TabsB23().count();
+    ASSERT_TRUE(EnterB23(*bar));
+    ASSERT_EQ(count + 1, TabsB23().count());
+    EXPECT_EQ(suggested, TabsB23().GetActiveWebContents()->GetVisibleURL());
+    EXPECT_TRUE(ui::PageTransitionCoreTypeIs(ActiveTransitionB23(),
+                                             ui::PAGE_TRANSITION_GENERATED));
+  }
+
+  {
+    SCOPED_TRACE("a page from history");
+    auto bar = std::make_unique<CommandBarView>(browser());
+    TypeIntoB23(*bar, u"ledger");
+    const GURL visited("https://ledger.example/board");
+    bar->SetAutocompleteResultForTesting(ResultOfB23(
+        {MatchB23(omnibox::AutocompleteMatchType::kHistoryUrl, visited,
+                  u"ledger.example/board", u"Board")}));
+    const size_t row = RowWithDetailB23(*bar, u"History");
+    ASSERT_LT(row, bar->row_count_for_testing()) << "the page is gone";
+    for (size_t i = 0; i < row; ++i) {
+      DownB23(*bar);
+    }
+    ASSERT_EQ(row, bar->selected_row_for_testing());
+    const int count = TabsB23().count();
+    ASSERT_TRUE(EnterB23(*bar));
+    ASSERT_EQ(count + 1, TabsB23().count());
+    EXPECT_EQ(visited, TabsB23().GetActiveWebContents()->GetVisibleURL());
+    EXPECT_TRUE(ui::PageTransitionCoreTypeIs(ActiveTransitionB23(),
+                                             ui::PAGE_TRANSITION_TYPED));
+  }
+
+  {
+    SCOPED_TRACE("the typed text completed to a site");
+    auto bar = std::make_unique<CommandBarView>(browser());
+    TypeIntoB23(*bar, u"mos");
+    ASSERT_GT(bar->row_count_for_testing(), 0u);
+    ASSERT_EQ(u"Search", bar->row_detail_for_testing(0));
+    AutocompleteMatch site =
+        MatchB23(omnibox::AutocompleteMatchType::kHistoryUrl,
+                 GURL("https://mosaic.example/"), u"mosaic.example", u"");
+    site.relevance = 1400;
+    site.inline_autocompletion = u"aic.example";
+    site.allowed_to_be_default_match = true;
+    bar->SetAutocompleteResultForTesting(ResultOfB23({site}));
+    ASSERT_EQ(u"mosaic.example", bar->field_for_testing()->GetText())
+        << "the premise: the text completes to the site";
+    ASSERT_EQ(u"Open", bar->row_detail_for_testing(0));
+    ASSERT_EQ(0u, bar->selected_row_for_testing());
+    const int count = TabsB23().count();
+    ASSERT_TRUE(EnterB23(*bar));
+    ASSERT_EQ(count + 1, TabsB23().count());
+    EXPECT_EQ("mosaic.example",
+              TabsB23().GetActiveWebContents()->GetVisibleURL().host());
+    EXPECT_TRUE(ui::PageTransitionCoreTypeIs(ActiveTransitionB23(),
+                                             ui::PAGE_TRANSITION_TYPED));
+  }
+}
+
