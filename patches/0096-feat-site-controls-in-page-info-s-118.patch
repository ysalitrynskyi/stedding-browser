+  ASSERT_TRUE(content::NavigateToURL(page, Url("b.test", "/title1.html")));
+  ASSERT_TRUE(content::ExecJs(page, "localStorage.setItem('jar', 'work')"));
+  HostContentSettingsMap* const settings =
+      HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile());
+  const GURL site = Url("b.test", "/");
+  settings->SetContentSettingDefaultScope(
+      site, site, ContentSettingsType::PERSISTENT_STORAGE,
