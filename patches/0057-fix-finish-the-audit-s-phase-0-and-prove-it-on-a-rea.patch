--- /dev/null
+++ b/chrome/common/stedding/space_partitions.cc
@@ -0,0 +1,41 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/common/stedding/space_partitions.h"
+
+#include <algorithm>
+
+#include "components/prefs/pref_service.h"
+
+namespace stedding {
+
+base::FilePath SpacePartitionsDirectory(const base::FilePath& profile_path) {
+  // kStoragePartitionDirname and kExtensionsDirname in
+  // content/browser/storage_partition_impl_map.cc, then the domain.
+  return profile_path.Append(FILE_PATH_LITERAL("Storage"))
+      .Append(FILE_PATH_LITERAL("ext"))
+      .AppendASCII(kSpacePartitionDomain);
+}
+
+std::vector<std::string> SpacePartitionNames(const base::ListValue& registry) {
+  std::vector<std::string> names;
+  for (const base::Value& item : registry) {
+    const base::DictValue* const space = item.GetIfDict();
+    const std::string* const name =
+        space ? space->FindString("profile") : nullptr;
+    if (name && !name->empty() && !std::ranges::contains(names, *name)) {
+      names.push_back(*name);
+    }
+  }
+  return names;
+}
+
+std::vector<std::string> SpacePartitionNames(const PrefService& prefs) {
+  if (!prefs.FindPreference(kSpaceRegistryPref)) {
+    return {};
+  }
+  return SpacePartitionNames(prefs.GetList(kSpaceRegistryPref));
+}
+
+}  // namespace stedding
diff --git a/chrome/common/stedding/space_partitions.h b/chrome/common/stedding/space_partitions.h
new file mode 100644
index 0000000000000..cff9a66c6241b
--- /dev/null
+++ b/chrome/common/stedding/space_partitions.h
@@ -0,0 +1,49 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_COMMON_STEDDING_SPACE_PARTITIONS_H_
+#define CHROME_COMMON_STEDDING_SPACE_PARTITIONS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/values.h"
+
+class PrefService;
+
+namespace stedding {
+
+// The storage-partition domain of the Spaces' own cookie jars (ADR 0019,
+// docs/features/sessions.md S4). A Space's jar is the partition with this
+// domain and its registry `profile_id` as the name, on disk at
+// <profile>/Storage/ext/spaces/<hash of the name>. Must be [a-z]*.
+// spaces::kSpacePartitionDomain in chrome/browser/ui/spaces is the same word;
+// code below the UI layer reads it from here.
+inline constexpr char kSpacePartitionDomain[] = "spaces";
+
+// The profile preference that holds the Space registry, the same name as
+// stedding::prefs::kSpaceRegistry: a list with one dict per Space, whose
+// "profile" string is the Space's jar name, empty until isolation was first
+// turned on for it.
+inline constexpr char kSpaceRegistryPref[] = "stedding.spaces.registry";
+
+// <profile_path>/Storage/ext/spaces, the one directory under which every
+// Space's jar lives. Chromium's storage-partition garbage collection keeps an
+// entry of Storage/ext only when a loaded partition or an allowlisted path is
+// inside it (content/browser/storage_partition_impl_map.cc), so this one path
+// keeps every jar: loaded or not, isolated now or switched off.
+base::FilePath SpacePartitionsDirectory(const base::FilePath& profile_path);
+
+// The jar names of the Spaces in `registry` that have one, whether their
+// isolation is on now or not, in registry order and without repeats.
+std::vector<std::string> SpacePartitionNames(const base::ListValue& registry);
+
+// The same, read from the profile's `prefs`. Empty when the preference is not
+// registered there, as in a profile type that has no Spaces.
+std::vector<std::string> SpacePartitionNames(const PrefService& prefs);
+
+}  // namespace stedding
+
+#endif  // CHROME_COMMON_STEDDING_SPACE_PARTITIONS_H_
