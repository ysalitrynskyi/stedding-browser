+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+
+namespace stedding {
+namespace {
+
+using State = AppUpdater::State;
+
+constexpr char kFeedUrl[] = "https://updates.test/appcast-windows.xml";
+constexpr char kInstallerUrl[] = "https://updates.test/Stedding-0.2.0-beta.19-win-x64.exe";
+
+struct Key {
+  Key() { ED25519_keypair(public_key, private_key); }
+  std::string Public() const {
+    return base::Base64Encode(base::span(public_key));
+  }
+  std::string Sign(std::string_view data) const {
+    uint8_t signature[ED25519_SIGNATURE_LEN];
+    ED25519_sign(signature, reinterpret_cast<const uint8_t*>(data.data()),
+                 data.size(), private_key);
+    return base::Base64Encode(base::span(signature));
+  }
+  uint8_t public_key[ED25519_PUBLIC_KEY_LEN];
+  uint8_t private_key[ED25519_PRIVATE_KEY_LEN];
+};
+
+// A feed as tooling/appcast.py writes and signs it, offering one installer.
+std::string SignedFeed(const Key& key,
+                       std::string_view file_version,
+                       std::string_view installer_signature,
+                       size_t installer_length) {
+  const std::string body = base::StrCat(
+      {"<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<rss version=\"2.0\" "
+       "xmlns:sparkle=\"http://www.andymatuschak.org/xml-namespaces/"
+       "sparkle\">\n<channel><title>Stedding</title><item>"
+       "<title>Stedding 0.2.0 beta 19</title><sparkle:version>",
+       file_version,
+       "</sparkle:version><sparkle:shortVersionString>0.2.0-beta.19"
+       "</sparkle:shortVersionString><enclosure url=\"",
+       kInstallerUrl, "\" length=\"", base::NumberToString(installer_length),
+       "\" type=\"application/octet-stream\" sparkle:os=\"windows-x64\" "
+       "sparkle:edSignature=\"",
+       installer_signature, "\"/></item></channel></rss>\n"});
+  return base::StrCat({body, "<!-- sparkle-signatures:\nedSignature: ",
+                       key.Sign(body), "\nlength: ",
+                       base::NumberToString(body.size()), "\n-->\n"});
+}
+
+class WinAppUpdaterTest : public testing::Test, public AppUpdater::Observer {
+ protected:
+  void SetUp() override {
+    prefs::RegisterLocalStatePrefs(local_state_.registry());
+    ASSERT_TRUE(exe_dir_.CreateUniqueTempDir());
+  }
+
+  void TearDown() override {
+    if (updater_) {
+      updater_->RemoveObserver(this);
+    }
+    updater_.reset();
+  }
+
+  void Start(const std::string& running = "156.2.0.18") {
+    WinUpdaterEnvironment environment;
+    environment.public_key = key_.Public();
+    environment.feed_url = GURL(kFeedUrl);
+    environment.running = base::Version(running);
+    environment.exe_dir = exe_dir_.GetPath();
+    environment.installed_version = base::BindRepeating(
+        [](base::Version version) { return version; },
+        base::Version("156.2.0.19"));
+    environment.run_installer =
+        base::BindRepeating(&WinAppUpdaterTest::RunInstaller,
+                            base::Unretained(this));
+    updater_ = CreateWinAppUpdater(
+        &local_state_,
+        base::BindLambdaForTesting([&]() { ++restarts_; }),
+        base::MakeRefCounted<network::WeakWrapperSharedURLLoaderFactory>(
+            &loader_factory_),
+        std::move(environment));
+    updater_->AddObserver(this);
+  }
+
+  // Off the UI thread, as the real installer runs.
+  int RunInstaller(const base::FilePath& path) {
+    base::AutoLock hold(lock_);
+    ++installer_runs_;
+    installer_bytes_ = base::ReadFileToBytes(path).value_or(
+        std::vector<uint8_t>());
+    // As the real installer's --log-file.
+    base::WriteFile(path.ReplaceExtension(FILE_PATH_LITERAL(".log")),
+                    "the installer's log");
+    // While it runs, nothing else may change the file it was checked as.
+    installer_could_be_changed_ = base::WriteFile(path, "MZ swapped");
+    return installer_exit_code_;
+  }
+
+  void Serve(const std::string& feed, const std::string& installer) {
+    loader_factory_.AddResponse(kFeedUrl, feed);
+    loader_factory_.AddResponse(kInstallerUrl, installer);
+  }
+
+  // AppUpdater::Observer:
+  void OnAppUpdaterChanged() override { states_.push_back(updater_->state()); }
+
+  int installer_runs() {
+    base::AutoLock hold(lock_);
+    return installer_runs_;
+  }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  data_decoder::test::InProcessDataDecoder data_decoder_;
+  network::TestURLLoaderFactory loader_factory_;
+  TestingPrefServiceSimple local_state_;
+  base::ScopedTempDir exe_dir_;
+  const Key key_;
+  std::unique_ptr<AppUpdater> updater_;
+  std::vector<State> states_;
+  int restarts_ = 0;
+  base::Lock lock_;
+  int installer_runs_ = 0;
+  int installer_exit_code_ = 0;
+  bool installer_could_be_changed_ = false;
+  std::vector<uint8_t> installer_bytes_;
+};
+
+// updates Up14, Up16, Up17: ten seconds after launch the updater reads the
+// signed feed, downloads the later installer, checks it, runs it, and offers
+// the restart; the restart is Chromium's.
+TEST_F(WinAppUpdaterTest, ALaterReleaseIsDownloadedCheckedInstalledAndOffered) {
+  const std::string installer = "MZ the beta 19 installer";
+  Serve(SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()),
+        installer);
+  Start();
+  EXPECT_EQ(State::kIdle, updater_->state());
+  EXPECT_EQ(0, loader_factory_.NumPending()) << "nothing before ten seconds";
+  task_environment_.FastForwardBy(base::Seconds(10));
+  task_environment_.RunUntilIdle();
+
+  EXPECT_EQ(State::kReady, updater_->state());
+  EXPECT_EQ(u"0.2.0-beta.19", updater_->version());
+  EXPECT_EQ(1, installer_runs());
+  EXPECT_EQ(std::vector<uint8_t>(installer.begin(), installer.end()),
+            installer_bytes_)
+      << "the installer run is the one downloaded";
+  EXPECT_TRUE(std::ranges::find(states_, State::kDownloading) != states_.end());
+  EXPECT_FALSE(local_state_.GetTime(prefs::kUpdatesLastCheck).is_null());
+
+  updater_->InstallNow();
+  EXPECT_EQ(State::kInstalling, updater_->state());
+  EXPECT_EQ(1, restarts_);
+  // A quit the browser cancelled brings the offer back.
+  task_environment_.FastForwardBy(base::Seconds(21));
+  EXPECT_EQ(State::kReady, updater_->state());
+}
+
+// updates Up15: a feed signed with another key is never read: no download,
+// no installer, and the user who asked hears why.
+TEST_F(WinAppUpdaterTest, AFeedSignedWithAnotherKeyIsNeverRead) {
+  const Key other;
+  const std::string installer = "MZ an installer";
+  Serve(SignedFeed(other, "156.2.0.19", other.Sign(installer),
+                   installer.size()),
+        installer);
+  Start();
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kFailed, updater_->state());
+  EXPECT_NE(std::u16string::npos, updater_->error().find(u"not signed"));
+  EXPECT_EQ(0, installer_runs());
+  EXPECT_EQ(1u, loader_factory_.total_requests()) << "the feed alone";
+}
+
+// updates Up16: an installer whose bytes are not the ones signed never runs.
+TEST_F(WinAppUpdaterTest, AnInstallerThatDoesNotVerifyNeverRuns) {
+  const std::string installer = "MZ the beta 19 installer";
+  const std::string tampered = "MZ the beta 19 installeR";
+  Serve(SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()),
+        tampered);
+  Start();
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kFailed, updater_->state());
+  EXPECT_EQ(0, installer_runs());
+}
+
+// updates Up14: nothing later than the version running: up to date, and an
+// installer that failed says so with its code.
+TEST_F(WinAppUpdaterTest, NothingLaterIsUpToDateAndAFailedInstallSaysSo) {
+  const std::string installer = "MZ the beta 19 installer";
+  Serve(SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()),
+        installer);
+  Start(/*running=*/"156.2.0.19");
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kUpToDate, updater_->state());
+  EXPECT_EQ(0, installer_runs());
+
+  updater_.reset();
+  installer_exit_code_ = 31;
+  Start();
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kFailed, updater_->state());
+  EXPECT_NE(std::u16string::npos, updater_->error().find(u"(31)"));
+}
+
+// updates Up20: with automatic updates off no request is made until the
+// user asks; a check a day ago means the next one is a day after it.
+TEST_F(WinAppUpdaterTest, AutomaticOffAsksNothingUntilTheUserDoes) {
+  const std::string installer = "MZ the beta 19 installer";
+  Serve(SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()),
+        installer);
+  local_state_.SetBoolean(prefs::kUpdatesAutomatic, false);
+  Start();
+  task_environment_.FastForwardBy(base::Days(3));
+  EXPECT_EQ(0u, loader_factory_.total_requests());
+  EXPECT_EQ(State::kIdle, updater_->state());
+
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kReady, updater_->state());
+
+  updater_.reset();
+  local_state_.SetBoolean(prefs::kUpdatesAutomatic, true);
+  local_state_.SetTime(prefs::kUpdatesLastCheck,
+                       base::Time::Now() - base::Hours(6));
+  const size_t before = loader_factory_.total_requests();
+  Start();
+  task_environment_.FastForwardBy(base::Hours(17));
+  EXPECT_EQ(before, loader_factory_.total_requests())
+      << "a check six hours ago: the next is due in eighteen";
+  task_environment_.FastForwardBy(base::Hours(2));
+  EXPECT_LT(before, loader_factory_.total_requests());
+}
+
+// updates Up17: an update installed and not yet restarted into offers the
+// restart at launch, named for the installed version, and asks nothing.
+// updates Up16 (BACKLOG S-249): the installer runs from the handle it was
+// checked on, which no one may write to while it runs.
+TEST_F(WinAppUpdaterTest, TheCheckedInstallerCannotBeChangedBeforeItRuns) {
+  const std::string installer = "MZ the beta 19 installer";
+  Serve(SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()),
+        installer);
+  Start();
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kReady, updater_->state());
+  EXPECT_EQ(1, installer_runs());
+  base::AutoLock hold(lock_);
+  EXPECT_FALSE(installer_could_be_changed_);
+}
+
+// updates Up15 (BACKLOG S-249): a signed feed older than one already read is
+// an old feed served again; it offers nothing and says so.
+TEST_F(WinAppUpdaterTest, AFeedOlderThanOneAlreadyReadIsRefused) {
+  const std::string installer = "MZ the beta 19 installer";
+  Serve(SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()),
+        installer);
+  local_state_.SetString(prefs::kUpdatesNewestListed, "156.2.0.20");
+  Start();
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kFailed, updater_->state());
+  EXPECT_NE(std::u16string::npos, updater_->error().find(u"older"));
+  EXPECT_EQ(0, installer_runs());
+  EXPECT_EQ("156.2.0.20", local_state_.GetString(prefs::kUpdatesNewestListed));
+
+  updater_.reset();
+  local_state_.SetString(prefs::kUpdatesNewestListed, "156.2.0.18");
+  Start();
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kReady, updater_->state());
+  EXPECT_EQ("156.2.0.19", local_state_.GetString(prefs::kUpdatesNewestListed))
+      << "a newer feed moves the mark on";
+}
+
+// updates Up14 (BACKLOG S-249): a check that cannot reach the feed is not the
+// day's check: the next one comes within the hour.
+TEST_F(WinAppUpdaterTest, AnOfflineCheckTriesAgainWithinTheHour) {
+  loader_factory_.AddResponse(
+      GURL(kFeedUrl), network::mojom::URLResponseHead::New(), std::string(),
+      network::URLLoaderCompletionStatus(net::ERR_INTERNET_DISCONNECTED));
+  Start();
+  task_environment_.FastForwardBy(base::Seconds(11));
+  EXPECT_EQ(1u, loader_factory_.total_requests());
+  EXPECT_TRUE(local_state_.GetTime(prefs::kUpdatesLastCheck).is_null());
+  task_environment_.FastForwardBy(base::Hours(1));
+  EXPECT_EQ(2u, loader_factory_.total_requests());
+}
+
+// updates Up20 (BACKLOG S-249): automatic updates turned off while a check
+// the user did not ask for downloads: the download is not installed.
+TEST_F(WinAppUpdaterTest, TurningAutomaticOffDuringADownloadInstallsNothing) {
+  const std::string installer = "MZ the beta 19 installer";
+  loader_factory_.AddResponse(
+      kFeedUrl,
+      SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()));
+  Start();
+  task_environment_.FastForwardBy(base::Seconds(11));
+  EXPECT_EQ(State::kDownloading, updater_->state());
+  local_state_.SetBoolean(prefs::kUpdatesAutomatic, false);
+  loader_factory_.AddResponse(kInstallerUrl, installer);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(0, installer_runs());
+  EXPECT_NE(State::kReady, updater_->state());
+}
+
+// updates Up17 (BACKLOG S-249): a failed install's log is kept in the
+// temporary folder for a report, where the download's folder goes.
+TEST_F(WinAppUpdaterTest, AFailedInstallKeepsItsLog) {
+  base::FilePath temp;
+  ASSERT_TRUE(base::GetTempDir(&temp));
+  const base::FilePath kept =
+      temp.Append(FILE_PATH_LITERAL("stedding_update_failed_install.log"));
+  base::DeleteFile(kept);
+  const std::string installer = "MZ the beta 19 installer";
+  Serve(SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()),
+        installer);
+  installer_exit_code_ = 31;
+  Start();
+  updater_->CheckNow();
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(State::kFailed, updater_->state());
+  std::string log;
+  EXPECT_TRUE(base::ReadFileToString(kept, &log));
+  EXPECT_EQ("the installer's log", log);
+  base::DeleteFile(kept);
+}
+
+TEST_F(WinAppUpdaterTest, AWaitingUpdateIsOfferedAtLaunch) {
+  ASSERT_TRUE(base::WriteFile(exe_dir_.GetPath().Append(L"new_chrome.exe"),
+                              "MZ"));
+  Start();
+  EXPECT_EQ(State::kReady, updater_->state());
+  EXPECT_EQ(u"0.2.0-beta.19", updater_->version());
+  task_environment_.FastForwardBy(base::Days(2));
+  EXPECT_EQ(0u, loader_factory_.total_requests());
+}
+
+// A stand-in update installer for RunUpdateInstaller: it runs for a while,
+// then exits with a code of its own.
+MULTIPROCESS_TEST_MAIN(SteddingSlowInstaller) {
+  base::PlatformThread::Sleep(base::Seconds(3));
+  return 7;
+}
+
+// updates Up17 (BACKLOG S-343): the installer is waited for until it has
+// exited, and its own exit code is the result; -1 only when it never started.
+// The wait used to give up after ten minutes while setup went on, and the
+// updater then called the install failed and deleted its folder under it.
+// Ten minutes are too long for a test: this one pins that the wait ends when
+// the installer does, and with its code.
+TEST(WinUpdateInstallerTest, TheInstallerIsWaitedForUntilItExits) {
+  base::CommandLine installer = base::GetMultiProcessTestChildBaseCommandLine();
+  installer.AppendSwitchASCII(switches::kTestChildProcess,
+                              "SteddingSlowInstaller");
+  const base::ElapsedTimer timer;
+  EXPECT_EQ(7, RunUpdateInstaller(installer));
+  EXPECT_GE(timer.Elapsed(), base::Seconds(3)) << "it did not wait";
+
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  EXPECT_EQ(-1, RunUpdateInstaller(base::CommandLine(
+                    dir.GetPath().Append(FILE_PATH_LITERAL("missing.exe")))))
+      << "an installer that does not start";
+}
+
+}  // namespace
+}  // namespace stedding
