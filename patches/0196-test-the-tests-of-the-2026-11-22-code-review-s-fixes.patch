+// A Space with a session of its own, Work, on screen, with a loaded page of
+// its own: a page it opens without an opener is made again in Work's jar
+// (spaces::PlaceOpenedContents).
+class SandboxedPopupJarB10Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model);
+    work_ = model->AddSpace("Work", SK_ColorBLUE)->id();
+    model->SetSpaceIsolated(work_, true);
+    ASSERT_TRUE(model->SpaceIsIsolated(work_));
+    ASSERT_TRUE(model->SetActiveSpace(work_));
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("a.test", "/title1.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    work_tab_ = browser()->GetTabStripModel()->GetActiveTab()->GetHandle();
+    ASSERT_EQ(work_, model->FindSpaceForTab(work_tab_.Get()));
+    ASSERT_TRUE(spaces::IsSpaceStoragePartition(
+        JarOf(work_tab_.Get()->GetContents())));
+  }
+
+  GURL Url(const std::string& host, const std::string& path) {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  static content::StoragePartitionConfig JarOf(content::WebContents* page) {
+    return spaces::StoragePartitionConfigForWebContents(page);
+  }
+
+  // A target=_blank link to `to` clicked in `frame`: the tab it opens, which
+  // has no opener.
+  tabs::TabInterface* ClickBlankLink(content::RenderFrameHost* frame,
+                                     const GURL& to) {
+    ui_test_utils::TabAddedWaiter added(browser());
+    EXPECT_TRUE(content::ExecJs(
+        frame, content::JsReplace("{ const a = document.createElement('a');"
+                                  "  a.href = $1; a.target = '_blank';"
+                                  "  document.body.appendChild(a); a.click(); }",
+                                  to)));
+    content::WebContents* const opened = added.Wait();
+    return opened ? tabs::TabInterface::GetFromContents(opened) : nullptr;
+  }
+
+  spaces::SpaceId work_ = spaces::SpaceId::GenerateNew();
+  tabs::TabHandle work_tab_;
+};
+
+// P11-1a, sessions S11: a link in a sandboxed frame of a Space with its own
+// session opens a tab in that Space's jar that is still sandboxed as the
+// frame is: its page has no origin of its own. Made again for the jar, the
+// tab had dropped the frame's sandbox, and its page ran with b.test's origin.
+IN_PROC_BROWSER_TEST_F(SandboxedPopupJarB10Test,
+                       ALinkInASandboxedFrameOpensASandboxedTab) {
+  content::WebContents* const page = work_tab_.Get()->GetContents();
+  ASSERT_TRUE(content::ExecJs(
+      page, content::JsReplace(R"(
+          new Promise(resolve => {
+            const frame = document.createElement('iframe');
+            frame.setAttribute('sandbox', 'allow-scripts allow-popups');
+            frame.onload = () => resolve(true);
+            frame.src = $1;
+            document.body.appendChild(frame);
+          }))",
+                               Url("a.test", "/title2.html"))));
+  content::RenderFrameHost* const frame = content::ChildFrameAt(page, 0);
+  ASSERT_TRUE(frame);
+  ASSERT_EQ("null", content::EvalJs(frame, "self.origin"))
+      << "the frame is not sandboxed";
+
+  tabs::TabInterface* const opened =
+      ClickBlankLink(frame, Url("b.test", "/title1.html"));
+  ASSERT_TRUE(opened);
+  content::WebContents* const contents = opened->GetContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_EQ(Url("b.test", "/title1.html"), contents->GetLastCommittedURL());
+  // Made again in Work's jar, as a link from Work's own page is.
+  EXPECT_EQ(JarOf(page), JarOf(contents));
+  EXPECT_EQ("null", content::EvalJs(contents, "self.origin"))
+      << "the tab escaped the sandbox of the frame that opened it";
+}
+
+// P11-1a: a page a link opened without an opener, made again in its Space's
+// jar, is still one another window opened: once it has gone on to another
+// page, it may close itself, as it may in a Space that shares the profile's
+// session. Made again, it was taken for a tab the person opened, and its
+// window.close() did nothing.
+IN_PROC_BROWSER_TEST_F(SandboxedPopupJarB10Test,
+                       APageALinkOpenedMayCloseItselfAfterGoingOn) {
+  content::WebContents* const page = work_tab_.Get()->GetContents();
+  tabs::TabInterface* const opened =
+      ClickBlankLink(page->GetPrimaryMainFrame(), Url("b.test", "/title1.html"));
+  ASSERT_TRUE(opened);
+  content::WebContents* const contents = opened->GetContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  ASSERT_EQ(JarOf(page), JarOf(contents))
+      << "the page was not made again in Work's jar";
+  ASSERT_TRUE(content::NavigateToURLFromRenderer(
+      contents, Url("b.test", "/title2.html")));
+  ASSERT_EQ(2, contents->GetController().GetEntryCount());
+
+  const tabs::TabHandle handle = opened->GetHandle();
+  content::ExecuteScriptAsync(contents, "window.close();");
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !handle.Get(); }))
+      << "the page could not close the tab a link had opened for it";
+}
+
+class PinsEveryWindowB10Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpInProcessBrowserTestFixture() override {
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::SetUpInProcessBrowserTestFixture();
+    // windows G19: the step before a launch with the store is a version
+    // without it, whose windows each keep their own pins.
+    const std::string name =
+        testing::UnitTest::GetInstance()->current_test_info()->name();
+    spaces::PinMirror::SetDisabledForTesting(base::StartsWith(name, "PRE_"));
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  static spaces::SpaceModel& Model(BrowserWindowInterface* window) {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+    CHECK(model);
+    return *model;
+  }
+
+  spaces::PinStore& Store() {
+    spaces::PinStore* const store =
+        spaces::PinStoreFactory::GetForProfile(browser()->GetProfile());
+    CHECK(store);
+    return *store;
+  }
+
+  // The window's Space pins, in the strip's order.
+  static std::vector<tabs::TabInterface*> Pins(BrowserWindowInterface* window) {
+    std::vector<tabs::TabInterface*> pins;
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      if (Model(window).IsSpacePinned(strip->GetTabAtIndex(i))) {
+        pins.push_back(strip->GetTabAtIndex(i));
+      }
+    }
+    return pins;
+  }
+
+  static std::string Token(tabs::TabInterface* tab) {
+    return stedding::TabToken(tab->GetContents());
+  }
+
+  // A page opened in `window` and made a Space pin there.
+  tabs::TabInterface* PinPage(BrowserWindowInterface* window, const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        window, url, WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const tab = window->GetTabStripModel()->GetActiveTab();
+    Model(window).SetSpacePinned(tab, true);
+    base::RunLoop().RunUntilIdle();
+    return tab;
+  }
+
+  BrowserWindowInterface* OpenWindow() {
+    ui_test_utils::BrowserCreatedObserver opened;
+    chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+    BrowserWindowInterface* const window = opened.Wait();
+    EXPECT_TRUE(window);
+    base::RunLoop().RunUntilIdle();
+    return window;
+  }
+
+  static std::vector<BrowserWindowInterface*> Windows(Profile* profile) {
+    std::vector<BrowserWindowInterface*> windows =
+        spaces::sidebar_sync::RegistryWindows(profile);
+    std::ranges::sort(windows, [](BrowserWindowInterface* a,
+                                  BrowserWindowInterface* b) {
+      return a->GetSessionID().id() < b->GetSessionID().id();
+    });
+    return windows;
+  }
+
+  // The paths of `window`'s tabs that are neither pins nor essentials.
+  static std::set<std::string> LoosePaths(BrowserWindowInterface* window) {
+    std::set<std::string> paths;
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      if (!tab->IsPinned() && !Model(window).IsSpacePinned(tab)) {
+        paths.insert(std::string(tab->GetContents()->GetVisibleURL().path()));
+      }
+    }
+    return paths;
+  }
+
+  GURL Page(const char* path) { return embedded_test_server()->GetURL(path); }
+};
+
+// P12-1b, pins H3, windows G15: a pin's page that closes itself
+// (window.close(), which a page with one history entry may call) puts the
+// pin to sleep at its home, as Cmd-W does; the record stays, and so does
+// the other window's tab of it. The tab was closed, taken for the person
+// removing the pin, and every other window's copy closed without a trace.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowB10Test,
+                       APageClosingItselfLeavesItsPinInEveryWindow) {
+  tabs::TabInterface* const pin = PinPage(browser(), Page("/title1.html"));
+  const std::string id = Token(pin);
+  ASSERT_FALSE(id.empty());
+  ASSERT_TRUE(Store().Find(id));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return Pins(second).size() == 1u; }))
+      << "the second window lacks the pin";
+  ASSERT_EQ(id, Token(Pins(second).front()));
+
+  content::WebContents* const page = pin->GetContents();
+  ASSERT_EQ(pin, browser()->GetTabStripModel()->GetActiveTab());
+  ASSERT_EQ(1, page->GetController().GetEntryCount());
+  const tabs::TabHandle handle = pin->GetHandle();
+  content::ExecuteScriptAsync(page, "window.close();");
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    tabs::TabInterface* const tab = handle.Get();
+    return !tab || tab->GetContents()->WasDiscarded() ||
+           tab->GetContents()->GetController().NeedsReload();
+  }));
+  tabs::TabInterface* const still = handle.Get();
+  ASSERT_TRUE(still) << "the page closed its pin";
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(Model(browser()).IsSpacePinned(still));
+  EXPECT_EQ(id, Token(still));
+  EXPECT_TRUE(Store().Find(id)) << "the page's close removed the record";
+  ASSERT_EQ(1u, Pins(second).size())
+      << "the other window's tab of the pin closed";
+  EXPECT_EQ(id, Token(Pins(second).front()));
+}
+
+// pins H3, H9, windows G15: Stay on a pin's "Leave site?" ends the close the
+// tab strip began (Cmd-W with "Cmd-W on a pinned tab puts it to sleep" off)
+// whole. With the setting on again, the pin's page closing itself later puts
+// the pin to sleep at its home, as Cmd-W does now. The close types that
+// close left stayed on the page, its own close was taken for that close
+// going on, and the pin was closed.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowB10Test,
+                       StayOnAPinsLeaveSiteEndsTheCloseTheStripBegan) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(stedding::prefs::kPinsCloseSleeps, false);
+  tabs::TabInterface* const pin = PinPage(browser(), Page("/title1.html"));
+  const std::string id = Token(pin);
+  ASSERT_FALSE(id.empty());
+  ASSERT_TRUE(Store().Find(id));
+  const tabs::TabHandle handle = pin->GetHandle();
+  content::WebContents* const page = pin->GetContents();
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.stay = (e) => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+  // The user activation "Leave site?" needs, and no hang timer.
+  content::PrepContentsForBeforeUnloadTest(page);
+  ASSERT_EQ(pin, browser()->GetTabStripModel()->GetActiveTab());
+
+  // Cmd-W closes the pin with the setting off. The page asks; Stay.
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+  javascript_dialogs::AppModalDialogController* const dialog =
+      ui_test_utils::WaitForAppModalDialog();
+  ASSERT_TRUE(dialog);
+  ASSERT_TRUE(dialog->is_before_unload_dialog());
+  ASSERT_TRUE(page->GetClosedByUserGesture());
+  dialog->view()->CancelAppModalDialog();  // Stay.
+  // The answer is back once the stopped close is no longer the user's.
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return !page->GetClosedByUserGesture(); }));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(pin, handle.Get()) << "Stay closed the pin";
+  ASSERT_EQ(page, pin->GetContents());
+  ASSERT_TRUE(Model(browser()).IsSpacePinned(pin));
+
+  // The setting on again, the page drops its question and closes itself.
+  prefs->SetBoolean(stedding::prefs::kPinsCloseSleeps, true);
+  ASSERT_TRUE(content::ExecJs(
+      page, "window.removeEventListener('beforeunload', window.stay);"));
+  ASSERT_EQ(1, page->GetController().GetEntryCount());
+  content::ExecuteScriptAsync(page, "window.close();");
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    tabs::TabInterface* const tab = handle.Get();
+    return !tab || tab->GetContents()->WasDiscarded() ||
+           tab->GetContents()->GetController().NeedsReload();
+  }));
+  tabs::TabInterface* const still = handle.Get();
+  ASSERT_TRUE(still) << "the page's own close closed the pin, as the close "
+                        "Stay had ended would have";
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(Model(browser()).IsSpacePinned(still));
+  EXPECT_EQ(id, Token(still));
+  EXPECT_TRUE(Store().Find(id)) << "the page's close removed the record";
+}
+
+// P12-1a, windows G18, G19: as a version without the store left them, two
+// windows with pins of their own, each pin with a token. The next launch
+// starts with a new tab, as the launch after a crash does.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowB10Test,
+                       PRE_ARestoredWindowsPinsStayPinsOnceTheStoreIsFilled) {
+  SessionStartupPref::SetStartupPref(
+      browser()->GetProfile(), SessionStartupPref(SessionStartupPref::DEFAULT));
+  tabs::TabInterface* const a = PinPage(browser(), Page("/title1.html"));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(Pins(second).empty());
+  tabs::TabInterface* const b = PinPage(second, Page("/title2.html"));
+  tabs::TabInterface* const c = PinPage(second, Page("/title3.html"));
+  for (tabs::TabInterface* const tab : {a, b, c}) {
+    EXPECT_FALSE(stedding::EnsureTabToken(tab).empty());
+  }
+  // The tokens reach the session a turn later.
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(Store().ready());
+  // The run ends as a crash does: the launch after it restores nothing, the
+  // sidebar's pins included, until the crash bubble's Restore. Ended plainly,
+  // the next launch brought this window's pins back on its own (the sidebar
+  // comes back whatever On startup says), and the store filled with them.
+  ExitTypeService::GetInstanceForProfile(browser()->GetProfile())
+      ->SetWaitingForUserToAckCrashForTest(true);
+}
+
+// P12-1a, windows G19: the store is filled from the one window this launch
+// opened, which has no pin. The crash bubble's Restore then brings the saved
+// windows back: one into this window, the other as a window of its own,
+// after the fill. Neither's pins are records the store lost (G18): they join
+// it, every window shows all three, and none comes back as a loose tab. The
+// later window's pins that had a token were unpinned and taken out of their
+// folders, as if removed while that window was closed.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowB10Test,
+                       ARestoredWindowsPinsStayPinsOnceTheStoreIsFilled) {
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Store().ready(); }))
+      << "the store was never filled";
+  ASSERT_TRUE(Store().records().empty());
+
+  // The window a launch after a crash opens: one new tab page, which the
+  // restore replaces.
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  while (strip->count() > 1) {
+    strip->CloseWebContentsAt(strip->count() - 1, TabCloseTypes::CLOSE_NONE);
+  }
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL(chrome::kChromeUINewTabURL)));
+  SessionRestore::RestoreSessionAfterCrash(browser());
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return Windows(profile).size() == 2u; }))
+      << "the session did not come back";
+
+  // The test server's port is new after a restart: the path is the page.
+  const std::set<std::string> want = {"/title1.html", "/title2.html",
+                                      "/title3.html"};
+  for (BrowserWindowInterface* const window : Windows(profile)) {
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return Pins(window).size() == 3u; }))
+        << "a restored window's pins became loose tabs, or a window lacks "
+           "one";
+    for (tabs::TabInterface* const tab : Pins(window)) {
+      EXPECT_TRUE(Store().Find(Token(tab))) << "a pin with no record";
+    }
+    for (const std::string& path : LoosePaths(window)) {
+      EXPECT_FALSE(want.contains(path)) << path << " came back as a loose tab";
+    }
+  }
+  EXPECT_EQ(3u, Store().records().size());
+}
+
+}  // namespace
