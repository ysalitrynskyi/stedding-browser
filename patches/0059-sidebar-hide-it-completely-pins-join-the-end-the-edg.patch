+// pins H14: a new pin joins the END of the pinned run, as in Arc, and an
+// unpinned tab leaves the run for the top of the tabs under the Clear line,
+// so the pins after it stay above the line. Until 2026-10-10 every pin went
+// to the top of the run, and an unpin from its middle split it: the sidebar
+// showed the pins below as unpinned rows (operator).
+TEST_F(SpaceWindowTest, PinsJoinTheEndOfTheRunAndUnpinsLeaveIt) {
+  tabs::TabInterface* const d = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const a = OpenTab();
+  // OpenTab inserts at the front: a, b, c, d.
+  const auto order = [this] {
+    std::vector<tabs::TabInterface*> out;
+    for (int i = 0; i < tabs().count(); ++i) {
+      out.push_back(tabs().GetTabAtIndex(i));
+    }
+    return out;
+  };
+  ASSERT_EQ((std::vector<tabs::TabInterface*>{a, b, c, d}), order());
+
+  model().SetSpacePinned(c, true);
+  model().SetSpacePinned(a, true);
+  model().SetSpacePinned(d, true);
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, a, d, b}), order())
+      << "each pin joins the end of the run, in the order it was pinned";
+
+  model().SetSpacePinned(a, false);
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, d, a, b}), order())
+      << "an unpinned tab leaves the run for the top of the tabs under it";
+  EXPECT_TRUE(model().IsSpacePinned(c));
+  EXPECT_TRUE(model().IsSpacePinned(d));
+
+  // Cmd-D on a selection of two pins unpins both, and they keep their order
+  // under the line.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(c));
+  tabs().ExtendSelectionTo(tabs().GetIndexOfTab(d));
+  spaces::ToggleSpacePinOnActiveTab(browser());
+  EXPECT_FALSE(model().IsSpacePinned(c));
+  EXPECT_FALSE(model().IsSpacePinned(d));
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, d, a, b}), order());
+
+  // A selection takes the active tab's direction (tabs R22), so the model is
+  // asked to unpin tabs that are not pinned and to pin pins; such a tab stays
+  // where it is. The unpinned last row went to the top of the unpinned tabs,
+  // and a pin pinned again to the end of the run.
+  model().SetSpacePinned(b, false);
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, d, a, b}), order())
+      << "an unpinned tab asked to unpin stays put";
+  model().SetSpacePinned(c, true);
+  model().SetSpacePinned(d, true);
+  ASSERT_EQ((std::vector<tabs::TabInterface*>{c, d, a, b}), order());
+  model().SetSpacePinned(c, true);
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{c, d, a, b}), order())
+      << "a pin asked to pin keeps its place in the run";
+}
