+  void OnSpaceAdded(const spaces::SpaceId& id) override { Apply(); }
+  void OnSpaceRemoved(const spaces::SpaceId& id) override { Apply(); }
+  void OnActiveSpaceChanged(const spaces::SpaceId& from,
+                            const spaces::SpaceId& to) override {
+    Apply();
+  }
+  void OnSpaceMetadataChanged(const spaces::SpaceId& id) override { Apply(); }
+  void OnSpaceModelDestroying() override { observation_.Reset(); }
+
+ private:
+  const raw_ref<spaces::SpaceModel> model_;
+  const raw_ref<views::View> host_;
+  base::ScopedObservation<spaces::SpaceModel, spaces::SpaceModel::Observer>
+      observation_{this};
+};
