+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SIDEBAR_BACKUP_H_
+#define CHROME_BROWSER_UI_SPACES_SIDEBAR_BACKUP_H_
+
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ref.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/spaces/arc_sidebar_importer.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+
+class BrowserWindowInterface;
+
+namespace spaces {
+
+// docs/features/import.md I17: the window's sidebar as a plan -- Spaces
+// with name, icon, colour and order; the essentials; per Space the pinned
+// run with its homes and the folders with their nesting; the loose tabs.
+// Ids: a Space's own id, "tab:<session id>" for a tab.
+ArcImportPlan SnapshotSidebar(BrowserWindowInterface* browser);
+
+// I20: one Space of it.
+ArcImportPlan SnapshotSpace(BrowserWindowInterface* browser, const SpaceId& id);
+
+// I18: the plan in Arc's file shape, which ParseArcSidebar reads back.
+std::string PlanToJson(const ArcImportPlan& plan);
+
+// The profile's backup folder and its files (I17, I19).
+base::FilePath BackupDirectory(const base::FilePath& profile_path);
+base::FilePath BackupFileName(base::Time when);
+std::optional<base::Time> TimeFromBackupFileName(const base::FilePath& path);
+
+struct BackupFile {
+  base::FilePath path;
+  base::Time time;
+};
+// Blocking. Newest first.
+std::vector<BackupFile> ListBackups(const base::FilePath& directory);
+
+// PRODUCT §1: 10 for today, one a day for 10 days, one a week for a month,
+// one a month for a year. `times` newest first; true keeps.
+std::vector<bool> KeepUnderSchedule(const std::vector<base::Time>& times,
+                                    base::Time now);
+
+// Blocking: writes `json` as a new snapshot and prunes the rest.
+void WriteBackup(const base::FilePath& directory,
+                 const std::string& json,
+                 base::Time now);
+
+// I17: one per window; a snapshot a minute after the window opens and every
+// hour after, on the thread pool.
+class SidebarBackupScheduler {
+ public:
+  static constexpr base::TimeDelta kFirstDelay = base::Minutes(1);
+  static constexpr base::TimeDelta kInterval = base::Hours(1);
+
+  explicit SidebarBackupScheduler(BrowserWindowInterface& browser);
+  SidebarBackupScheduler(const SidebarBackupScheduler&) = delete;
+  SidebarBackupScheduler& operator=(const SidebarBackupScheduler&) = delete;
+  ~SidebarBackupScheduler();
+
+  void WriteNow();
+
+ private:
+  const raw_ref<BrowserWindowInterface> browser_;
+  base::OneShotTimer first_;
+  base::RepeatingTimer timer_;
+};
+
+using RestoreDoneCallback =
+    base::OnceCallback<void(std::optional<ArcImportResult>)>;
+
+// I19: reads a snapshot on the thread pool and applies it to the window
+// through the importer: a merge, which never closes an open tab.
+void RestoreBackupAsync(BrowserWindowInterface* browser,
+                        const base::FilePath& path,
+                        RestoreDoneCallback done);
+
+// I20: writes `plan` to `directory` as "<stem> <time>.json" on the thread
+// pool and answers with the path.
+void ExportPlanAsync(const ArcImportPlan& plan,
+                     const base::FilePath& directory,
+                     const std::string& stem,
+                     base::OnceCallback<void(base::FilePath)> done);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_BACKUP_H_
