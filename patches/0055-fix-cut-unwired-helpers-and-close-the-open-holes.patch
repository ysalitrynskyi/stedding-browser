+// A little window and a popup are not closed for being idle.
+TEST_F(TabArchiverTest, LittleWindowAndPopupAreNotArchived) {
+  std::unique_ptr<BrowserWindowInterface> little =
+      CreateBrowser(profile(), Browser::TYPE_POPUP, /*hosted_app=*/false);
+  MarkLittleWindow(little.get());
+  AddTab(little.get(), GURL("https://little.example/"));
+  prefs()->SetInteger(prefs::kLittleIdleHours, 1);
+  TabArchiver little_archiver(*little, *prefs());
+  little_archiver.set_tick_clock_for_testing(clock());
+  Idle(base::Hours(48));
+  little_archiver.Sweep();
+  EXPECT_EQ(1, little->GetTabStripModel()->count());
+
+  std::unique_ptr<BrowserWindowInterface> popup =
+      CreateBrowser(profile(), Browser::TYPE_POPUP, /*hosted_app=*/false);
+  AddTab(popup.get(), GURL("https://popup.example/"));
+  AddTab(popup.get(), GURL("https://popup.example/b"));
+  TabArchiver popup_archiver(*popup, *prefs());
+  popup_archiver.set_tick_clock_for_testing(clock());
+  popup_archiver.Sweep();
+  EXPECT_EQ(2, popup->GetTabStripModel()->count());
+  little->GetTabStripModel()->CloseAllTabs();
+  popup->GetTabStripModel()->CloseAllTabs();
+}
