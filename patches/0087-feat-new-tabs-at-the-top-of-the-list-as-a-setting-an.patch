+END_METADATA
+
+EditSpaceView* ShowEditSpaceDialog(BrowserWindowInterface* window,
+                                   const SpaceId& id) {
+  SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+  ui::BaseWindow* const base_window = window ? window->GetWindow() : nullptr;
+  if (!model || !model->GetSpace(id) || !base_window) {
+    return nullptr;
+  }
+  auto view = std::make_unique<EditSpaceView>(*model, id);
+  EditSpaceView* const raw = view.get();
+  ui::DialogModel::Builder builder;
+  builder.SetInternalName("SteddingEditSpaceDialog")
+      .SetTitle(u"Edit \u201C" + model->DisplayName(id) + u"\u201D")
+      .AddCustomField(std::make_unique<views::BubbleDialogModelHost::CustomView>(
+          std::move(view), views::BubbleDialogModelHost::FieldType::kControl,
+          raw->name_field()))
+      // The view lives as long as the dialog, which runs Done before it goes.
+      .AddOkButton(base::BindOnce(&EditSpaceView::Apply, base::Unretained(raw)),
+                   ui::DialogModel::Button::Params().SetLabel(u"Done"))
+      .AddCancelButton(base::DoNothing());
+  constrained_window::ShowBrowserModal(builder.Build(),
+                                       base_window->GetNativeWindow());
+  return raw;
+}
