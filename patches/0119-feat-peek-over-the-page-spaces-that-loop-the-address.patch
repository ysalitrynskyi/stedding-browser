+#if BUILDFLAG(IS_WIN)
+// sidebar Y48 (the same comment): on Windows, with the address in the open
+// sidebar, the caption buttons -- minimize, maximize, close -- are the
+// sidebar's, on its top row at the trailing end, and show while the pointer
+// is over the top of the sidebar; the frame shows none of its own then.
+// Back, Forward and Reload follow the toggle.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, TheWindowsButtonsMoveToTheSidebar) {
+  stedding::SidebarWindowButtons* const buttons =
+      top()->sidebar_window_buttons_for_testing();
+  ASSERT_TRUE(buttons);
+  const auto frame_buttons_shown = [&]() {
+    const auto* const frame = static_cast<const BrowserFrameViewWin*>(
+        browser_view()->browser_widget()->GetFrameView());
+    return frame->caption_button_container_for_testing()->GetVisible();
+  };
+  EXPECT_FALSE(top()->ShowsWindowButtons()) << "off by default";
+  EXPECT_TRUE(frame_buttons_shown());
+
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return top()->ShowsWindowButtons() && !frame_buttons_shown() &&
+           !browser_view()->IsToolbarVisible();
+  }));
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  ASSERT_TRUE(buttons->IsDrawn());
+  // Laid out on the toggle's line, at the trailing end; Back, Forward and
+  // Reload after the toggle, short of them.
+  views::View* const toggle = top()->GetCollapseButton();
+  EXPECT_EQ(top()->width(), buttons->bounds().right());
+  EXPECT_NEAR(toggle->bounds().CenterPoint().y(),
+              buttons->bounds().CenterPoint().y(), 1);
+  EXPECT_GE(nav()->x(), toggle->bounds().right());
+  EXPECT_LE(nav()->bounds().right(), buttons->x());
+
+  // Hidden until the pointer is over the top of the sidebar, their place the
+  // window's to drag by.
+  EXPECT_FALSE(buttons->revealed());
+  EXPECT_FALSE(buttons->close()->GetVisible());
+  const gfx::Point on_buttons = buttons->bounds().CenterPoint();
+  EXPECT_TRUE(top()->IsPositionInWindowCaption(on_buttons));
+  top()->OnMouseEntered(ui::MouseEvent(
+      ui::EventType::kMouseEntered, on_buttons, on_buttons,
+      base::TimeTicks::Now(), ui::EF_NONE, ui::EF_NONE));
+  EXPECT_TRUE(buttons->revealed());
+  EXPECT_TRUE(buttons->close()->GetVisible());
+  EXPECT_FALSE(top()->IsPositionInWindowCaption(on_buttons));
+  EXPECT_EQ(browser_view()->GetWidget()->IsMaximized() ? IDC_RESTORE_WINDOW
+                                                       : IDC_MAXIMIZE_WINDOW,
+            buttons->maximize()->command());
+  EXPECT_EQ(IDC_MINIMIZE_WINDOW, buttons->minimize()->command());
+  EXPECT_EQ(IDC_CLOSE_WINDOW, buttons->close()->command());
+  top()->OnMouseExited(ui::MouseEvent(
+      ui::EventType::kMouseExited, on_buttons, on_buttons,
+      base::TimeTicks::Now(), ui::EF_NONE, ui::EF_NONE));
+  EXPECT_FALSE(buttons->revealed());
+
+  // Closed to the rail, the frame's own are back with the row.
+  controller()->RequestCollapse(true);
+  Settle();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return frame_buttons_shown() && browser_view()->IsToolbarVisible();
+  }));
+  EXPECT_FALSE(buttons->IsDrawn());
+}
+#endif  // BUILDFLAG(IS_WIN)
