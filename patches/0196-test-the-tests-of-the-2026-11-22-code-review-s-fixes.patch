+class SidebarSyncB11Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+  spaces::SpaceRegistry& registry() {
+    return *spaces::SpaceRegistryFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  base::FilePath sync_dir() {
+    return shared_.GetPath().AppendASCII(sb::kSyncFolderName);
+  }
+
+  // The other computer's file, written now.
+  void WriteOffice(const sb::State& state, int64_t seq) {
+    base::ScopedAllowBlockingForTesting allow;
+    sb::FileMeta meta;
+    meta.install = kOfficeB11;
+    meta.device = "Office PC";
+    meta.seq = seq;
+    meta.nonce = sb::MakeInstallId();
+    meta.written_ms = NowMsB11();
+    meta.hlc = state.MaxTime();
+    meta.joined_ms = 1;
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(
+        base::WriteFile(sync_dir().AppendASCII(sb::FileNameFor(kOfficeB11)),
+                        sb::SerializeSyncFile(state, meta)));
+  }
+
+  // The join is made once its backup is written (Sf9).
+  void Join() {
+    base::test::TestFuture<base::DictValue> preview;
+    service()->PreviewJoin(shared_.GetPath(), preview.GetCallback());
+    const base::DictValue sheet = preview.Take();
+    ASSERT_FALSE(sheet.FindString("refusal"));
+    ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/false, "Test computer", {}));
+    ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  base::FilePath OwnFile() {
+    return sync_dir().AppendASCII(sb::FileNameFor(
+        browser()->GetProfile()->GetPrefs()->GetString(
+            stedding::prefs::kSidebarSyncInstallId)));
+  }
+
+  // This install's file in the folder, as it is written; empty when there is
+  // none.
+  std::string ReadOwnJson() {
+    base::ScopedAllowBlockingForTesting allow;
+    std::string json;
+    if (!base::ReadFileToString(OwnFile(), &json)) {
+      return std::string();
+    }
+    return json;
+  }
+
+  sb::ParsedFile ReadOwnFile() {
+    const std::string json = ReadOwnJson();
+    return json.empty() ? sb::ParsedFile() : sb::ParseSyncFile(json);
+  }
+
+  const sb::Record* LedgerRecord(const std::string& id) {
+    const sb::Ledger* const ledger = service()->ledger_for_testing();
+    if (!ledger) {
+      return nullptr;
+    }
+    const auto it = ledger->state.records.find(id);
+    return it == ledger->state.records.end() ? nullptr : &it->second;
+  }
+
+  // The waiting row `id` of Settings, or nullopt.
+  std::optional<base::DictValue> Decision(const std::string& id) {
+    base::DictValue status = service()->GetStatus();
+    if (base::ListValue* const decisions = status.FindList("decisions")) {
+      for (base::Value& row : *decisions) {
+        const std::string* const each = row.GetDict().FindString("id");
+        if (each && *each == id) {
+          return std::move(row.GetDict());
+        }
+      }
+    }
+    return std::nullopt;
+  }
+
+  tabs::TabInterface* TabWithToken(const std::string& id) {
+    for (int i = 0; i < tabs().count(); ++i) {
+      tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+      if (spaces::TabSyncId(stedding::TabToken(tab->GetContents())) == id) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  std::string IdOf(const tabs::TabInterface* tab) {
+    return spaces::TabSyncId(stedding::TabToken(tab->GetContents()));
+  }
+
+  // A page in a new tab, in front.
+  bool OpenTabInFront() {
+    return static_cast<bool>(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL("/title2.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  }
+
+  // A pin of the Space on screen, loaded.
+  tabs::TabInterface* OpenPin() {
+    if (!ui_test_utils::NavigateToURLWithDisposition(
+            browser(), embedded_test_server()->GetURL("/title1.html"),
+            WindowOpenDisposition::kNewForegroundTab,
+            ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP)) {
+      return nullptr;
+    }
+    tabs::TabInterface* const tab = tabs().GetActiveTab();
+    model().SetSpacePinned(tab, true);
+    return tab;
+  }
+
+  // A pinned folder of the Space on screen holding `pins`.
+  tabs::FolderTabCollection* MakePinnedFolder(
+      const std::vector<tabs::TabInterface*>& pins) {
+    std::vector<int> indices;
+    for (const tabs::TabInterface* const pin : pins) {
+      indices.push_back(tabs().GetIndexOfTab(pin));
+    }
+    std::ranges::sort(indices);
+    tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(indices);
+    if (folder) {
+      model().SetFolderSpacePinned(folder, true);
+    }
+    return folder;
+  }
+
+  base::ScopedTempDir shared_;
+};
