+  dir.WriteFile(FILE_PATH_LITERAL("panel.html"), "<!doctype html><p>Panel");
+  Profile* const profile = browser()->GetProfile();
+  const scoped_refptr<const extensions::Extension> extension =
+      extensions::ChromeTestExtensionLoader(profile).LoadExtension(
+          dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  const extensions::ExtensionId id = extension->id();
+  extensions::ExtensionRegistry* const registry =
+      extensions::ExtensionRegistry::Get(profile);
+
+  stedding::CommandBarView* const bar = Palette(browser());
+  ASSERT_TRUE(bar);
+  const auto lists_no_extension = [&]() {
+    for (const char16_t* query : {u"Steady", u"Panel", u"Side", u""}) {
+      Type(bar, query);
+      for (const std::u16string& title : Titles(bar)) {
