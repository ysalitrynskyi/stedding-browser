@@ -0,0 +1,62 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_MEDIA_KEYS_H_
+#define CHROME_BROWSER_UI_STEDDING_MEDIA_KEYS_H_
+
+#include <vector>
+
+class BrowserWindowInterface;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace stedding {
+
+// The tab's sound by key (docs/features/tabs.md R29, BACKLOG S-122):
+// Control-M on the Mac, where Cmd-M stays Minimize, and Ctrl+M elsewhere.
+
+// The tabs the mute key takes: the active row, which is both panes of a split
+// whichever pane has focus, and every other selected row the sidebar shows
+// (tabs R21, R22). A selected tab another Space or a collapsed folder hides
+// is left alone (PLAN.md TAB-10). Empty when the window has no active tab.
+std::vector<tabs::TabInterface*> TabsToMute(BrowserWindowInterface* browser);
+
+// Whether the mute key would mute: true unless every tab it takes is muted
+// already, in which case it unmutes them all.
+bool MuteKeyWouldMute(BrowserWindowInterface* browser);
+
+// Mutes TabsToMute(), or unmutes them all when every one is muted, the way a
+// click on a tab's speaker does, so the tab's badge follows (tabs R18). The
+// tab's own mute, not Mute Site.
+void ToggleMuteOnSelectedTabs(BrowserWindowInterface* browser);
+
+// The page's video by key (docs/features/player.md Mp5): Option-Shift-Cmd-P
+// on the Mac, Ctrl+Alt+Shift+P on Windows. What the key would do now.
+enum class PictureInPictureKey {
+  // Nothing in this window to put in picture in picture or to close.
+  kNothing,
+  // A page of the active row has a video its media session can put in
+  // picture in picture: one video with sound that has played, or a page
+  // that answers the request itself.
+  kEnter,
+  // A page of the active row shows picture in picture, or, failing that,
+  // another tab of this window does.
+  kExit,
+};
+
+// The active row's pages are asked first, the focused pane before the other
+// pane of its split: one that shows picture in picture closes it, else one
+// that can enter it does; else a tab of this window that shows it closes it.
+PictureInPictureKey PictureInPictureKeyFor(BrowserWindowInterface* browser);
+
+// Does what PictureInPictureKeyFor() says, through the page's media session,
+// as Chromium's media controls do. Closing it leaves the video playing in the
+// page.
+void TogglePictureInPicture(BrowserWindowInterface* browser);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_MEDIA_KEYS_H_
diff --git a/chrome/browser/ui/stedding/media_keys_unittest.cc b/chrome/browser/ui/stedding/media_keys_unittest.cc
new file mode 100644
index 0000000000000..bed971fb96635
--- /dev/null
+++ b/chrome/browser/ui/stedding/media_keys_unittest.cc
@@ -0,0 +1,205 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/tabs.md R29, player.md Mp5 (BACKLOG S-122). Each test enters
+// where the product does, through the window's command, which the key and
+// the command bar both run, and asserts on the pages' own state.
+
+#include "chrome/browser/ui/stedding/media_keys.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_muted_utils.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/web_contents_tester.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class MediaKeysTest : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+
+  // A foreground tab at the end of the strip, showing a test page.
+  tabs::TabInterface* OpenTab() {
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContentsTester::CreateTestWebContents(profile(), nullptr);
+    content::WebContentsTester::For(contents.get())
+        ->NavigateAndCommit(GURL("https://example.com/"));
+    tabs().AppendTab(
+        std::make_unique<tabs::TabModel>(std::move(contents), &tabs()),
+        /*foreground=*/true);
+    return tabs().GetActiveTab();
+  }
+
+  void Activate(tabs::TabInterface* tab) {
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(tab));
+  }
+
+  // `shown` and `other` become one split, `shown` active.
+  void Split(tabs::TabInterface* shown, tabs::TabInterface* other) {
+    Activate(shown);
+    tabs().AddToNewSplit({tabs().GetIndexOfTab(other)},
+                         split_tabs::SplitTabVisualData(),
+                         split_tabs::SplitTabCreatedSource::kToolbarButton);
+  }
+
+  // The mute key, as the window runs it.
+  bool PressMuteKey() {
+    return chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_TAB_MUTED);
+  }
+
+  static bool Muted(tabs::TabInterface* tab) {
+    return tab->GetContents()->IsAudioMuted();
+  }
+
+  static void Mute(tabs::TabInterface* tab) {
+    SetTabAudioMuted(tab->GetContents(), true, TabMutedReason::kAudioIndicator,
+                     std::string());
+  }
+};
+
+// tabs R29: the key on a split takes both panes, whichever pane has focus,
+// and mutes them the way a click on the speaker does; a second press unmutes
+// both. A split with one pane muted mutes the other rather than swapping
+// them. The tab outside the split is never touched.
+TEST_F(MediaKeysTest, TheMuteKeyTakesBothPanesOfTheSplitOnScreen) {
+  tabs::TabInterface* const plain = OpenTab();
+  tabs::TabInterface* const left = OpenTab();
+  tabs::TabInterface* const right = OpenTab();
+  Split(right, left);
+  ASSERT_TRUE(left->IsSplit());
+  ASSERT_EQ(left->GetSplit(), right->GetSplit());
+  ASSERT_EQ(right, tabs().GetActiveTab());
+
+  EXPECT_TRUE(PressMuteKey());
+  EXPECT_TRUE(Muted(left));
+  EXPECT_TRUE(Muted(right));
+  EXPECT_FALSE(Muted(plain));
+  EXPECT_EQ(TabMutedReason::kAudioIndicator,
+            GetTabAudioMutedReason(left->GetContents()));
+  EXPECT_EQ(TabMutedReason::kAudioIndicator,
+            GetTabAudioMutedReason(right->GetContents()));
+
+  EXPECT_TRUE(PressMuteKey());
+  EXPECT_FALSE(Muted(left));
+  EXPECT_FALSE(Muted(right));
+  EXPECT_FALSE(Muted(plain));
+
+  // The other pane has focus now, and only it was muted: the key mutes the
+  // pane that was not.
+  Activate(left);
+  ASSERT_EQ(left, tabs().GetActiveTab());
+  Mute(left);
+  EXPECT_TRUE(MuteKeyWouldMute(browser()));
+  EXPECT_TRUE(PressMuteKey());
+  EXPECT_TRUE(Muted(left));
+  EXPECT_TRUE(Muted(right));
+  EXPECT_FALSE(Muted(plain));
+}
+
+// tabs R29 with R21, R22: the key takes every selected row, and goes one way
+// for all of them. With one of them muted already it mutes the rest; once
+// every one is muted it unmutes them all. A row outside the selection is
+// never touched.
+TEST_F(MediaKeysTest, TheMuteKeyTakesTheSelectionOneWay) {
+  tabs::TabInterface* const a = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  ASSERT_EQ(c, tabs().GetActiveTab());
+  Mute(b);
+  tabs().ExtendSelectionTo(tabs().GetIndexOfTab(b));
+  ASSERT_TRUE(tabs().IsTabSelected(tabs().GetIndexOfTab(b)));
+  ASSERT_TRUE(tabs().IsTabSelected(tabs().GetIndexOfTab(c)));
+  ASSERT_FALSE(tabs().IsTabSelected(tabs().GetIndexOfTab(a)));
+  EXPECT_EQ(2u, TabsToMute(browser()).size());
+
+  EXPECT_TRUE(MuteKeyWouldMute(browser()));
+  EXPECT_TRUE(PressMuteKey());
+  EXPECT_TRUE(Muted(b)) << "a muted row stays muted";
+  EXPECT_TRUE(Muted(c));
+  EXPECT_FALSE(Muted(a));
+
+  EXPECT_FALSE(MuteKeyWouldMute(browser()));
+  EXPECT_TRUE(PressMuteKey());
+  EXPECT_FALSE(Muted(b));
+  EXPECT_FALSE(Muted(c));
+  EXPECT_FALSE(Muted(a));
+}
+
+// player Mp5: pages with no media session have nothing for the key. It is a
+// command of the window all the same, and pressing it changes nothing: no
+// picture in picture, the same tabs, the same one on screen.
+TEST_F(MediaKeysTest, APageWithoutAVideoOffersNoPictureInPicture) {
+  tabs::TabInterface* const left = OpenTab();
+  tabs::TabInterface* const right = OpenTab();
+  Split(right, left);
+  EXPECT_EQ(PictureInPictureKey::kNothing, PictureInPictureKeyFor(browser()));
+
+  EXPECT_TRUE(chrome::ExecuteCommand(browser(),
+                                     IDC_STEDDING_TOGGLE_PICTURE_IN_PICTURE));
+  EXPECT_EQ(2, tabs().count());
+  EXPECT_EQ(right, tabs().GetActiveTab());
