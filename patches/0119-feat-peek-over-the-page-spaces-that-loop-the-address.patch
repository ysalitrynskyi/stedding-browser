+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !browser_view()->IsToolbarVisible() && menu->parent() &&
+           menu->parent()->parent() == top();
+  }));
+  Settle();
+  ASSERT_TRUE(Shows(nav())) << "the wide line lost Back, Forward and Reload";
+  ASSERT_TRUE(Shows(menu));
+
+  // Narrower, step by step, to the first line with no room for the four:
+  // the menu is there, after the toggle. On Windows the window's own
+  // buttons come first, so the step is wider there than on the Mac.
+  bool stepped_out = false;
+  for (int width = 400; width >= 160 && !stepped_out; width -= 10) {
+    controller()->SetUncollapsedWidth(width);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(browser_view()->GetWidget());
+      return region()->width() <= width + 24;
+    })) << "the sidebar did not narrow to " << width;
+    if (!Shows(nav())) {
+      stepped_out = true;
+      EXPECT_TRUE(Shows(menu))
+          << "at " << width << " DIP the menu is reachable nowhere else";
+      EXPECT_GE(menu->GetBoundsInScreen().x(),
+                top()->GetCollapseButton()->GetBoundsInScreen().right())
+          << "the menu over the toggle";
+    }
+  }
+  EXPECT_TRUE(stepped_out) << "Back, Forward and Reload never stepped out";
+
+  // At every width, at either edge -- on Windows the window's own buttons
+  // share the line at the trailing one (Y48) -- the menu is on the line or,
+  // with no room there, at the field's end, never nowhere (BACKLOG S-399,
+  // the fifth item).
+  for (const bool on_right : {false, true}) {
+    prefs()->SetBoolean(stedding::prefs::kSidebarOnRight, on_right);
+    for (const int width : {300, 200, 160, 126}) {
+      SCOPED_TRACE(base::StringPrintf("%d DIP, on the %s", width,
+                                      on_right ? "right" : "left"));
+      controller()->SetUncollapsedWidth(width);
+      EXPECT_TRUE(base::test::RunUntil([&]() {
+        views::test::RunScheduledLayout(browser_view()->GetWidget());
+        return region()->width() <= width + 24 && Shows(menu) &&
+               (menu->parent() == top()->GetSteddingMenuHost() ||
+                field()->Contains(menu));
+      })) << "the menu is reachable nowhere: in "
+          << (menu->parent() ? menu->parent()->GetClassName() : "nothing")
+          << " in " << (menu->parent() && menu->parent()->parent()
+                             ? menu->parent()->parent()->GetClassName()
+                             : "nothing")
+          << ", the field holds that " << field()->Contains(menu->parent())
+          << ", visible " << menu->GetVisible() << "/"
+          << (menu->parent() && menu->parent()->GetVisible()) << " at "
+          << (menu->parent() ? menu->parent()->bounds().ToString() : "")
+          << ", hidden up the tree at " << [&]() {
+               std::string chain;
+               for (views::View* v = menu; v; v = v->parent()) {
+                 if (!v->GetVisible()) {
+                   chain += std::string(v->GetClassName()) + " ";
+                 }
+               }
+               return chain.empty() ? std::string("none") : chain;
+             }()
+          << ", the top " << top()->width() << " wide with " << [&]() {
+               std::string shown;
+               for (views::View* v : top()->children()) {
+                 shown += std::string(v->GetClassName()) +
+                          (v->GetVisible() ? "+" : "-") +
+                          base::NumberToString(v->width()) + " ";
+               }
+               return shown;
+             }()
+          << ", drawn " << menu->IsDrawn() << ", at "
+          << menu->GetBoundsInScreen().ToString() << "; the field at "
+          << field()->GetBoundsInScreen().ToString() << ", the sidebar "
+          << region()->width() << " DIP, menu on the line "
+          << (top()->GetSteddingMenuHost() != nullptr);
+      if (field()->Contains(menu)) {
+        EXPECT_TRUE(field()->GetBoundsInScreen().Contains(
+            menu->GetBoundsInScreen()))
+            << "the menu runs past the field";
+      }
+    }
+  }
+}
