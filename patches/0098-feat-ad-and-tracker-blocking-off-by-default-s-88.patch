new file mode 100644
index 0000000000000..5e04265509066
--- /dev/null
+++ b/chrome/browser/ui/stedding/blocker/blocker_rules.cc
@@ -0,0 +1,276 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/blocker/blocker_rules.h"
+
+#include <algorithm>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/dark_pages.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/reload_type.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "net/base/url_util.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr ContentSettingsType kType = ContentSettingsType::ADS;
+
+HostContentSettingsMap* MapFor(Profile* profile) {
+  return profile ? HostContentSettingsMapFactory::GetForProfile(profile)
+                 : nullptr;
+}
+
+Profile* ProfileOf(content::WebContents* contents) {
+  return contents ? Profile::FromBrowserContext(contents->GetBrowserContext())
+                  : nullptr;
+}
+
+// Bk5: a choice made on a page a form loaded. Its reload asks first whether
+// to send the form again, and the choice is written only once that reload
+// starts: cancelled, the page keeps the blocking it loaded with and the
+// shield still says so. Written first, the shield showed the new choice
+// over a page filtered by the old one. Any other navigation drops it.
+class BlockerChoiceOnReload
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<BlockerChoiceOnReload> {
+ public:
+  BlockerChoiceOnReload(const BlockerChoiceOnReload&) = delete;
+  BlockerChoiceOnReload& operator=(const BlockerChoiceOnReload&) = delete;
+  ~BlockerChoiceOnReload() override = default;
+
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* navigation) override {
+    if (!navigation->IsInPrimaryMainFrame()) {
+      return;
+    }
+    if (navigation->GetReloadType() != content::ReloadType::NONE) {
+      // Before the reload's request: the filter reads the choice made.
+      if (Profile* const profile = ProfileOf(web_contents())) {
+        SetBlockingOnSiteInMap(MapFor(profile), profile->IsOffTheRecord(),
+                               url_, on_);
+      }
+    }
+    // Deletes this.
+    web_contents()->RemoveUserData(UserDataKey());
+  }
+
+ private:
+  friend class content::WebContentsUserData<BlockerChoiceOnReload>;
+
+  BlockerChoiceOnReload(content::WebContents* contents, GURL url, bool on)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<BlockerChoiceOnReload>(*contents),
+        url_(std::move(url)),
+        on_(on) {}
+
+  const GURL url_;
+  const bool on_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(BlockerChoiceOnReload);
+
+}  // namespace
+
+bool BlockerOn(const PrefService* local_state) {
+  if (!local_state || !local_state->GetBoolean(prefs::kBlockerEnabled)) {
+    return false;
+  }
+  return local_state->GetBoolean(prefs::kBlockerEasyList) ||
+         local_state->GetBoolean(prefs::kBlockerEasyPrivacy);
+}
+
+bool IsSignInFlow(const GURL& url) {
+  if (!url.is_valid()) {
+    return false;
+  }
+  for (std::string_view segment :
+       base::SplitStringPiece(url.path(), "/", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    const std::string lower = base::ToLowerASCII(segment);
+    if (lower == "oauth" || lower == "oauth2" || lower == "authorize" ||
+        lower == "openid-connect") {
+      return true;
+    }
+  }
+  return net::GetValueForKeyInQuery(url, "client_id", nullptr) &&
+         net::GetValueForKeyInQuery(url, "redirect_uri", nullptr);
+}
+
+bool SiteHasBlockingOff(const HostContentSettingsMap* map, const GURL& url) {
+  if (!map || !url.is_valid()) {
+    return false;
+  }
+  content_settings::SettingInfo info;
+  const ContentSetting setting =
+      map->GetContentSetting(url, GURL(), kType, &info);
+  // The default, wherever it came from, is not an exception for a site.
+  if (info.primary_pattern == ContentSettingsPattern::Wildcard()) {
+    return false;
+  }
+  return setting == CONTENT_SETTING_ALLOW;
+}
+
+bool BlockerAppliesTo(const PrefService* local_state,
+                      const HostContentSettingsMap* map,
+                      const GURL& url) {
+  return BlockerOn(local_state) && url.is_valid() &&
+         url.SchemeIsHTTPOrHTTPS() && !IsSignInFlow(url) &&
+         !SiteHasBlockingOff(map, url);
+}
+
+bool BlockerAppliesTo(Profile* profile, const GURL& url) {
+  return BlockerAppliesTo(g_browser_process->local_state(), MapFor(profile),
+                          url);
+}
+
+void SetBlockingOnSiteInMap(HostContentSettingsMap* map,
+                            bool off_the_record,
+                            const GURL& url,
+                            bool on) {
+  if (!map) {
+    return;
+  }
+  const std::optional<ContentSettingsPattern> site =
+      DarkPagesSitePatternFor(url);
+  if (!site) {
+    return;
+  }
+  // The map's own entries that name this page go first; a private map's own
+  // entries are the incognito ones, the normal profile's are not touched from
+  // there.
+  for (const ContentSettingPatternSource& entry :
+       map->GetSettingsForOneType(kType)) {
+    if (entry.source == content_settings::mojom::ProviderType::kPrefProvider &&
+        entry.incognito == off_the_record &&
+        entry.primary_pattern != ContentSettingsPattern::Wildcard() &&
+        entry.primary_pattern.Matches(url)) {
+      map->SetContentSettingCustomScope(entry.primary_pattern,
+                                        entry.secondary_pattern, kType,
+                                        CONTENT_SETTING_DEFAULT);
+    }
+  }
+  if (SiteHasBlockingOff(map, url) == !on) {
+    return;
+  }
+  map->SetContentSettingCustomScope(
+      *site, ContentSettingsPattern::Wildcard(), kType,
+      on ? CONTENT_SETTING_BLOCK : CONTENT_SETTING_ALLOW);
+}
+
+bool CanChooseBlockingForSite(content::WebContents* contents) {
+  if (!contents || !BlockerOn(g_browser_process->local_state())) {
+    return false;
+  }
+  return DarkPagesSitePatternFor(contents->GetLastCommittedURL()).has_value();
+}
+
+bool IsBlockingOnForSite(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  return BlockerAppliesTo(ProfileOf(contents), contents->GetLastCommittedURL());
+}
+
+void ToggleBlockingOnSite(content::WebContents* contents) {
+  if (!CanChooseBlockingForSite(contents)) {
+    return;
+  }
+  Profile* const profile = ProfileOf(contents);
+  const GURL url = contents->GetLastCommittedURL();
+  const bool on = !SiteHasBlockingOff(MapFor(profile), url);
+  // A choice already waiting on a resubmission question is replaced.
+  contents->RemoveUserData(BlockerChoiceOnReload::UserDataKey());
+  const content::NavigationEntry* const entry =
+      contents->GetController().GetLastCommittedEntry();
+  if (entry && entry->GetHasPostData()) {
+    BlockerChoiceOnReload::CreateForWebContents(contents, url, !on);
+  } else {
+    SetBlockingOnSiteInMap(MapFor(profile), profile->IsOffTheRecord(), url,
+                           !on);
+  }
+  // A new decision reaches the page only with its next load.
+  contents->GetController().Reload(content::ReloadType::NORMAL,
+                                   /*check_for_repost=*/true);
+}
+
+std::u16string BlockerSiteName(content::WebContents* contents) {
+  if (!contents) {
+    return std::u16string();
+  }
+  const std::optional<ContentSettingsPattern> site =
+      DarkPagesSitePatternFor(contents->GetLastCommittedURL());
+  return site ? base::UTF8ToUTF16(DarkPagesSiteName(*site))
+              : std::u16string();
+}
+
+std::vector<ContentSettingsPattern> GetBlockerExceptions(Profile* profile) {
+  std::vector<ContentSettingsPattern> sites;
+  HostContentSettingsMap* const map =
+      MapFor(profile ? profile->GetOriginalProfile() : nullptr);
+  if (!map) {
+    return sites;
+  }
+  for (const ContentSettingPatternSource& entry :
+       map->GetSettingsForOneType(kType)) {
+    if (entry.source == content_settings::mojom::ProviderType::kPrefProvider &&
+        !entry.incognito &&
+        entry.primary_pattern != ContentSettingsPattern::Wildcard() &&
+        entry.GetContentSetting() == CONTENT_SETTING_ALLOW) {
+      sites.push_back(entry.primary_pattern);
+    }
+  }
+  std::ranges::sort(sites, [](const ContentSettingsPattern& a,
+                              const ContentSettingsPattern& b) {
+    return DarkPagesSiteName(a) < DarkPagesSiteName(b);
+  });
+  return sites;
+}
+
+bool AddBlockerException(Profile* profile, std::string_view typed) {
+  HostContentSettingsMap* const map =
+      MapFor(profile ? profile->GetOriginalProfile() : nullptr);
+  const std::optional<ContentSettingsPattern> site =
+      DarkPagesSitePatternFromTyped(typed);
+  if (!map || !site) {
+    return false;
+  }
+  map->SetContentSettingCustomScope(*site, ContentSettingsPattern::Wildcard(),
+                                    kType, CONTENT_SETTING_ALLOW);
+  return true;
+}
+
+void RemoveBlockerException(Profile* profile,
+                            const ContentSettingsPattern& pattern) {
+  HostContentSettingsMap* const map =
+      MapFor(profile ? profile->GetOriginalProfile() : nullptr);
+  if (!map || !pattern.IsValid()) {
+    return;
+  }
+  map->SetContentSettingCustomScope(pattern, ContentSettingsPattern::Wildcard(),
+                                    kType, CONTENT_SETTING_DEFAULT);
+}
+
+}  // namespace stedding
