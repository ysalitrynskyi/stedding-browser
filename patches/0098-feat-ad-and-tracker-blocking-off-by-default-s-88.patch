+
+#include "base/memory/scoped_refptr.h"
+
+class PrefService;
+
+namespace network {
+class SharedURLLoaderFactory;
+}  // namespace network
+
+namespace stedding {
+
+// Tests serve their own lists: the folder the lists are fetched from instead
+// of https://easylist.to/easylist/ (docs/features/blocker.md Bk12). With it,
+// a list of any size is taken and a due fetch does not wait after launch.
+inline constexpr char kBlockerListBaseSwitch[] = "stedding-blocker-list-base";
+
+// Ad and tracker blocking (docs/features/blocker.md), started once per
+// process after the browser has started: the lists' schedule, which fetches
+// nothing while blocking is off, and the page activation that the
+// subresource filter takes from Stedding while it is on. Owned by the
