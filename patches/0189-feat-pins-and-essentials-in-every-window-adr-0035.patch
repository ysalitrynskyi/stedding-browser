+// windows G13, G15: a window with a change of its own waiting to go out
+// sends that change alone. A pin removed and a pin renamed in another window
+// just before stay removed and renamed in the store and in every window.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest,
+                       APendingPublishWritesNothingBackOverAnotherWindow) {
+  tabs::TabInterface* const x = PinPage(browser(), Page("/title1.html"));
+  tabs::TabInterface* const y = PinPage(browser(), Page("/title2.html"));
