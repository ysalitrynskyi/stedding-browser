new file mode 100644
index 0000000000000..70ce603235dee
--- /dev/null
+++ b/chrome/browser/ui/stedding/theme/page_top_color.cc
@@ -0,0 +1,93 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/theme/page_top_color.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <vector>
+
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+#include "third_party/skia/include/core/SkImageInfo.h"
+
+namespace stedding {
+namespace {
+
+int ChannelDistance(SkColor a, SkColor b) {
+  return std::max({std::abs(static_cast<int>(SkColorGetR(a)) -
+                            static_cast<int>(SkColorGetR(b))),
+                   std::abs(static_cast<int>(SkColorGetG(a)) -
+                            static_cast<int>(SkColorGetG(b))),
+                   std::abs(static_cast<int>(SkColorGetB(a)) -
+                            static_cast<int>(SkColorGetB(b)))});
+}
+
+U8CPU Median(std::vector<U8CPU> values) {
+  const auto middle = values.begin() + values.size() / 2;
+  std::nth_element(values.begin(), middle, values.end());
+  return *middle;
+}
+
+}  // namespace
+
+std::optional<SkColor> UniformTopEdgeColor(const SkBitmap& strip) {
+  if (strip.drawsNothing() || strip.height() < 1 ||
+      strip.width() < kPageTopMinSamples) {
+    return std::nullopt;
+  }
+  // The readback is in the colour space of the surface it was copied from,
+  // on a Mac the display's (Display P3 on its own screen), while the row is
+  // painted from an sRGB colour: the strip is read as sRGB, or the row is the
+  // page's colour taken to the display's space twice, a step less saturated
+  // than the page (the owner's copy, 2026-10-02).
+  SkBitmap srgb;
+  const SkBitmap* edge = &strip;
+  if (strip.colorSpace() && !strip.colorSpace()->isSRGB()) {
+    if (!srgb.tryAllocPixels(
+            strip.info().makeColorSpace(SkColorSpace::MakeSRGB())) ||
+        !strip.readPixels(srgb.pixmap())) {
+      return std::nullopt;
+    }
+    edge = &srgb;
+  }
+  std::vector<SkColor> samples;
+  samples.reserve(static_cast<size_t>(edge->width()));
+  std::vector<U8CPU> reds, greens, blues;
+  for (int x = 0; x < edge->width(); ++x) {
+    const SkColor sample = SkColorSetA(edge->getColor(x, 0), SK_AlphaOPAQUE);
+    samples.push_back(sample);
+    reds.push_back(SkColorGetR(sample));
+    greens.push_back(SkColorGetG(sample));
+    blues.push_back(SkColorGetB(sample));
+  }
+  const SkColor median = SkColorSetRGB(Median(std::move(reds)),
+                                       Median(std::move(greens)),
+                                       Median(std::move(blues)));
+  int near = 0;
+  int red = 0;
+  int green = 0;
+  int blue = 0;
+  for (const SkColor sample : samples) {
+    if (ChannelDistance(sample, median) > kPageTopChannelTolerance) {
+      continue;
+    }
+    ++near;
+    red += SkColorGetR(sample);
+    green += SkColorGetG(sample);
+    blue += SkColorGetB(sample);
+  }
+  if (near * 10 < static_cast<int>(samples.size()) * 9) {
+    return std::nullopt;
+  }
+  return SkColorSetRGB(static_cast<U8CPU>((red + near / 2) / near),
+                       static_cast<U8CPU>((green + near / 2) / near),
+                       static_cast<U8CPU>((blue + near / 2) / near));
+}
+
+bool PageColorsMatch(SkColor a, SkColor b) {
+  return ChannelDistance(a, b) <= 2;
+}
+
+}  // namespace stedding
