+// R58: the tree is in what a restart reads: the session's pending commands
+// written, the file moved aside as the last session and read back as session
+// restore reads it, each tab's extra data naming its token and its parent's.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, TheTreeIsInWhatARestartReads) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  tabs::TabInterface* const grandchild = OpenLinkFrom(child, "c.test");
+  ASSERT_TRUE(grandchild);
+  base::RunLoop().RunUntilIdle();
+
+  SessionService* const service =
+      SessionServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  SessionServiceTestHelper helper(service);
+  sessions::CommandStorageManager* const storage =
+      helper.command_storage_manager();
+  service->MoveCurrentSessionToLastSession();
+  base::test::TestFuture<std::vector<std::unique_ptr<sessions::SessionCommand>>,
+                         sessions::CommandStorageReadStatus>
+      read;
+  storage->GetLastSessionCommands(read.GetCallback());
+  auto [commands, read_status] = read.Take();
+  ASSERT_EQ(read_status, sessions::CommandStorageReadStatus::kSuccess);
+  std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+  SessionID active = SessionID::InvalidValue();
+  std::string platform;
+  std::set<SessionID> discarded;
+  sessions::RestoreSessionFromCommands(commands, &windows, &active, &platform,
+                                       &discarded);
+
+  const auto saved = [&](tabs::TabInterface* tab) {
+    const SessionID id =
+        sessions::SessionTabHelper::IdForTab(tab->GetContents());
+    for (const auto& window : windows) {
+      for (const auto& each : window->tabs) {
+        if (each->tab_id == id) {
+          return each->extra_data;
+        }
+      }
+    }
+    return std::map<std::string, std::string>();
+  };
+  const auto value = [](const std::map<std::string, std::string>& data,
+                        const char* key) {
+    const auto it = data.find(key);
+    return it == data.end() ? std::string() : it->second;
+  };
+  EXPECT_EQ(stedding::TabToken(page->GetContents()),
+            value(saved(page), stedding::kSessionTabTokenKey));
+  EXPECT_EQ(stedding::TabToken(page->GetContents()),
+            value(saved(child), stedding::kSessionTabParentKey));
+  EXPECT_EQ(stedding::TabToken(child->GetContents()),
+            value(saved(child), stedding::kSessionTabTokenKey));
+  EXPECT_EQ(stedding::TabToken(child->GetContents()),
+            value(saved(grandchild), stedding::kSessionTabParentKey))
+      << saved(grandchild).size() << " keys saved for the grandchild";
+  EXPECT_FALSE(stedding::TabToken(child->GetContents()).empty());
+}
