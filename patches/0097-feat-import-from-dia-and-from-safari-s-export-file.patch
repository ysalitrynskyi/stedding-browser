+// import I39 (BACKLOG S-346): a login saved already, with the same password,
+// keeps its note. Chromium's importer had added the file's note to it -- the
+// saved note, a new line, the file's -- while the result line counted the
+// login as saved already.
+IN_PROC_BROWSER_TEST_F(SafariExportImportTest, ASavedLoginKeepsItsNote) {
+  Profile* const profile = browser()->GetProfile();
+  scoped_refptr<password_manager::PasswordStoreInterface> store =
+      ProfilePasswordStoreFactory::GetForProfile(
+          profile, ServiceAccessType::EXPLICIT_ACCESS);
+  ASSERT_TRUE(store);
+  password_manager::PasswordForm saved;
+  saved.url = GURL("https://safari-login.example/");
+  saved.signon_realm = "https://safari-login.example/";
+  saved.username_value = u"ann";
+  saved.password_value =
+      password_manager::PasswordString(std::u16string(u"fromsafari"));
+  saved.SetNoteWithEmptyUniqueDisplayName(u"mine");
+  saved.in_store = password_manager::PasswordForm::Store::kProfileStore;
+  base::RunLoop added;
+  store->AddLogin(password_manager::FromPasswordForm(std::move(saved)),
+                  added.QuitClosure());
+  added.Run();
+
+  // An export folder whose row for that login, same password, has a note.
+  base::FilePath folder;
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    folder = dir_.GetPath().AppendASCII("Noted Export");
+    ASSERT_TRUE(base::CreateDirectory(folder));
+    ASSERT_TRUE(base::WriteFile(
+        folder.AppendASCII("Passwords.csv"),
+        "Title,URL,Username,Password,Notes,OTPAuth\n"
+        "a,https://safari-login.example/,ann,fromsafari,from the file,\n"));
+  }
+  auto importer = std::make_unique<stedding::SafariExportImporter>();
+  base::test::TestFuture<stedding::SafariExportSummary> prepared;
+  importer->Prepare(
+      folder, prepared.GetCallback<const stedding::SafariExportSummary&>());
+  ASSERT_TRUE(prepared.Wait());
+  stedding::SafariExportParts parts;
+  parts.passwords = true;
+  base::test::TestFuture<stedding::SafariExportResult> done;
+  stedding::SafariExportImporter::Commit(
+      std::move(importer), *profile, parts,
+      done.GetCallback<const stedding::SafariExportResult&>());
+  const stedding::SafariExportResult result = done.Get();
+  EXPECT_EQ(1u, result.passwords.already_saved);
+  EXPECT_EQ(0u, result.passwords.added);
+
+  bool found = false;
+  for (const password_manager::StoredCredential& login : Logins(profile)) {
+    if (login.signon_realm == "https://safari-login.example/" &&
+        login.username_value == u"ann") {
+      found = true;
+      EXPECT_EQ(u"mine", login.GetPasswordNote())
+          << "the file's note was added to the saved login's";
+    }
+  }
+  EXPECT_TRUE(found) << "the saved login is gone";
+}
+
+// import I40: the same export imported again adds no bookmark, no visit and
+// no login, and makes no second folder.
+IN_PROC_BROWSER_TEST_F(SafariExportImportTest, ImportingAgainAddsNothing) {
+  stedding::SafariExportParts parts;
+  parts.passwords = true;
+  const stedding::SafariExportResult first = ImportDirectly(parts);
+  EXPECT_EQ(2u, first.bookmarks);
+  EXPECT_EQ(1u, first.history);
+  EXPECT_EQ(2u, first.passwords.added);
+  const stedding::SafariExportResult second = ImportDirectly(parts);
+  EXPECT_EQ(0u, second.bookmarks);
+  EXPECT_EQ(2u, second.bookmarks_already);
+  EXPECT_EQ(0u, second.history);
+  EXPECT_EQ(0u, second.passwords.added);
+  EXPECT_EQ(2u, second.passwords.already_saved);
+  EXPECT_EQ(1u, FoldersNamed(u"Imported from Safari"));
+  EXPECT_EQ(1u, VisitsTo(GURL(kSeen)));
+  EXPECT_EQ(2u, Logins(browser()->GetProfile()).size());
+}
