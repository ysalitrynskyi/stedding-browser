+IN_PROC_BROWSER_TEST_F(ShortcutRebindTest, TheChordSurvivesARestart) {
+  EXPECT_TRUE(shortcuts::Current().IsChanged(IDC_STEDDING_CLEAR_SPACE));
+  EXPECT_EQ(IDC_STEDDING_CLEAR_SPACE, CommandOn(browser(), kFreeChord));
+}
+
+// Z17: the row numbers' switch takes all nine chords, keypad included.
+IN_PROC_BROWSER_TEST_F(ShortcutRebindTest, RowNumbersOffTakeTheirChords) {
+  const std::vector<shortcuts::Chord> first =
+      shortcuts::DefaultChordsFor(IDC_SELECT_TAB_0);
+  const std::vector<shortcuts::Chord> last =
+      shortcuts::DefaultChordsFor(IDC_SELECT_LAST_TAB);
+  ASSERT_FALSE(first.empty());
+  ASSERT_FALSE(last.empty());
+  EXPECT_EQ(IDC_SELECT_TAB_0, CommandOn(browser(), first.front()));
+  ASSERT_TRUE(
+      shortcuts::SetShortcutOff(LocalState(), Row("tab-by-number"), true));
+  EXPECT_TRUE(shortcuts::IsOff(IDC_SELECT_TAB_0))
+      << "holding the key shows no numbers";
+  for (const std::vector<shortcuts::Chord>* chords : {&first, &last}) {
+    for (const shortcuts::Chord& chord : *chords) {
+      EXPECT_EQ(0, CommandOn(browser(), chord))
+          << shortcuts::ChordToString(chord);
+    }
+  }
+}
+
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+// Z23 (GitHub issue 13): each layout of the number keys moves both sets of
+// nine at once, digits and number pad, in the window's own lookup and in
+// the chords its menus name; holding the platform's key numbers the rows
+// only while they keep it; Reset all puts the shipped layout back.
+IN_PROC_BROWSER_TEST_F(ShortcutRebindTest, TheNumberKeysMoveBothSets) {
+  const shortcuts::Entry& rows = Row("tab-by-number");
+  const shortcuts::Entry& spaces = Row("space-by-number");
+  const shortcuts::Chord shipped_row = shortcuts::DefaultChordsFor(
+      IDC_SELECT_TAB_0).front();
+  for (shortcuts::NumberKeys layout :
+       {shortcuts::NumberKeys::kSpacesFirst,
+        shortcuts::NumberKeys::kRowsFirstSpacesThird,
+        shortcuts::NumberKeys::kSpacesFirstRowsThird}) {
+    SCOPED_TRACE(shortcuts::NumberKeysName(layout));
+    ASSERT_TRUE(shortcuts::SetNumberKeys(LocalState(), layout));
+    const int row_keys = shortcuts::NumberKeysModifiers(rows, layout);
+    const int space_keys = shortcuts::NumberKeysModifiers(spaces, layout);
+    ASSERT_NE(row_keys, space_keys);
+    EXPECT_EQ(IDC_SELECT_TAB_0,
+              CommandOn(browser(), shortcuts::Chord(ui::VKEY_1, row_keys)));
+    EXPECT_EQ(IDC_SELECT_LAST_TAB,
+              CommandOn(browser(),
+                        shortcuts::Chord(ui::VKEY_NUMPAD9, row_keys)));
+    EXPECT_EQ(IDC_STEDDING_SPACE_1,
+              CommandOn(browser(), shortcuts::Chord(ui::VKEY_1, space_keys)));
+    EXPECT_EQ(IDC_STEDDING_SPACE_9,
+              CommandOn(browser(),
+                        shortcuts::Chord(ui::VKEY_NUMPAD9, space_keys)));
+    EXPECT_EQ(Accel(shortcuts::Chord(ui::VKEY_1, space_keys)).GetShortcutText(),
+              NamedChord(browser(), IDC_STEDDING_SPACE_1));
+#if BUILDFLAG(IS_MAC)
+    // tabs R11: while ⌘ is held, a Space chip names the Spaces' own keys.
+    EXPECT_EQ(Accel(shortcuts::Chord(ui::VKEY_1, space_keys)).GetShortcutText(),
+              spaces::SpaceSwitcherView::ChordForSpace(0));
+#endif
+    const bool rows_keep_the_key =
+        layout == shortcuts::NumberKeys::kRowsFirstSpacesThird;
+    EXPECT_EQ(rows_keep_the_key,
+              shortcuts::IsOnPlatformKey(IDC_SELECT_TAB_0,
+                                         /*ships_on_it=*/true));
+    EXPECT_EQ(!rows_keep_the_key,
+              shortcuts::IsOnPlatformKey(IDC_STEDDING_SPACE_1,
+                                         /*ships_on_it=*/false));
+    if (!rows_keep_the_key) {
+      EXPECT_EQ(IDC_STEDDING_SPACE_1, CommandOn(browser(), shipped_row))
+          << "the rows' shipped key goes to the Spaces";
+    }
+  }
+
+  shortcuts::ResetAllShortcuts(LocalState());
+  EXPECT_EQ(IDC_SELECT_TAB_0, CommandOn(browser(), shipped_row));
+#if BUILDFLAG(IS_MAC)
+  EXPECT_EQ(u"⌃1", spaces::SpaceSwitcherView::ChordForSpace(0));
+#endif
+  EXPECT_TRUE(
+      shortcuts::IsOnPlatformKey(IDC_SELECT_TAB_0, /*ships_on_it=*/true));
+  EXPECT_FALSE(shortcuts::IsOnPlatformKey(IDC_STEDDING_SPACE_1,
+                                          /*ships_on_it=*/false));
+}
+#endif  // BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
