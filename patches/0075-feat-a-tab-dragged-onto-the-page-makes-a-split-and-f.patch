+  ASSERT_EQ(at_home, tabs().GetActiveTab());
+  ASSERT_TRUE(model().SetActiveSpace(work));
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(second, tabs().GetActiveTab()) << "not the first essential";
+  EXPECT_EQ(count - 1, tabs().count()) << "coming back opened a tab";
+}
+
+// tabs R38: a window without Spaces -- a private one -- keeps Chromium's
+// rule, which shows the tab that opened the closing one; a window with
+// Spaces shows the row used before.
+TEST_F(SpaceWindowTest, AWindowWithoutSpacesKeepsChromiumsRule) {
+  // Rows: used, closing, beside, opener; closing on screen, used before it.
+  // Returns the opener and the row used before.
+  const auto close_an_opened_tab = [](TabStripModel& strip,
+                                      content::BrowserContext* context) {
+    tabs::TabInterface* const used = AppendRow(strip, context, true);
+    tabs::TabInterface* const closing = AppendRow(strip, context);
+    AppendRow(strip, context);
+    tabs::TabInterface* const opener = AppendRow(strip, context);
+    Use(strip, closing);
+    // Set after the selection: a selection elsewhere forgets openers.
+    strip.SetOpenerOfTabAt(strip.GetIndexOfTab(closing), opener);
+    strip.CloseWebContentsAt(strip.GetIndexOfTab(closing),
+                             TabCloseTypes::CLOSE_USER_GESTURE);
+    return std::make_pair(opener, used);
+  };
+
+  const auto [opener, used] = close_an_opened_tab(tabs(), profile());
+  EXPECT_EQ(used, tabs().GetActiveTab());
+  EXPECT_NE(opener, tabs().GetActiveTab());
+
+  std::unique_ptr<BrowserWindowInterface> private_window =
+      CreateBrowser(profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true),
+                    Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  ASSERT_FALSE(SpaceModel::From(private_window.get()));
+  TabStripModel& private_tabs = *private_window->GetTabStripModel();
+  const auto [private_opener, private_used] = close_an_opened_tab(
+      private_tabs, private_window->GetProfile());
+  EXPECT_EQ(private_opener, private_tabs.GetActiveTab());
+  EXPECT_NE(private_used, private_tabs.GetActiveTab());
+  private_tabs.CloseAllTabs();
+}
+
+// tabs R5, pins H3 (BACKLOG S-112): the row on screen going to sleep -- Sleep
+// Tab, Cmd-W on a pin -- shows the row a close would: the Space's row used
+// last, not the row beside it.
+TEST_F(SpaceWindowTest, ASleepOnScreenShowsTheRowUsedBefore) {
+  tabs::TabInterface* const pin = AppendRow(tabs(), profile(), true);
+  model().SetSpacePinned(pin, true);
+  tabs::TabInterface* const a = AppendRow(tabs(), profile());
+  tabs::TabInterface* const b = AppendRow(tabs(), profile());
+  tabs::TabInterface* const c = AppendRow(tabs(), profile());
+  ASSERT_EQ(pin, tabs().GetTabAtIndex(0));
+
+  {
+    SCOPED_TRACE("Sleep Tab");
+    for (tabs::TabInterface* const tab : {c, a, b}) {
+      Use(tabs(), tab);
+    }
+    stedding::SleepTabs(browser(), b, stedding::SleepScope::kThisTab);
+    EXPECT_EQ(a, tabs().GetActiveTab()) << "not c, the row below";
+    EXPECT_TRUE(b->GetContents()->WasDiscarded());
+  }
+  {
+    SCOPED_TRACE("Cmd-W on a pin");
+    Use(tabs(), c);
+    Use(tabs(), pin);
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+    EXPECT_EQ(4, tabs().count()) << "the pin stays";
+    EXPECT_EQ(c, tabs().GetActiveTab()) << "not a, the row below";
+    EXPECT_TRUE(pin->GetContents()->WasDiscarded());
+  }
+}
