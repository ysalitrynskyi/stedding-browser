+
+// Stedding, docs/features/sessions.md S24 (PLAN.md SPC-11): a Space with an
+// independent session keeps its cookies in a storage partition of its own,
+// named in the Space registry. A removal that names no partition reaches each
+// of those jars, isolated now or not, with the same time range, the part of
+// the mask that lives on a partition and the caller's origin filter.
+class SpaceJarChromeBrowsingDataRemoverDelegateTest
+    : public ChromeBrowsingDataRemoverDelegateTest {
+ public:
+  struct Removal {
+    uint64_t remove_mask;
+    std::optional<content::StoragePartitionConfig> storage_partition_config;
+    base::Time delete_begin;
+    bool operator==(const Removal& other) const = default;
+  };
+
+ protected:
+  static constexpr char kWorkJar[] = "4B1D0C0FFEE5EED5A11CE5B0B0CAFE01";
+  static constexpr char kOldJar[] = "0DDBA11C0DEC0DE5CAFEF00DBADC0FFE";
+
+  // The registry as SpaceRegistry writes it: Work is isolated, Old had its
+  // isolation turned off (the jar stays for next time), Plain never had one.
+  void WriteSpaceRegistry() {
+    base::ListValue registry;
+    registry.Append(SpaceEntry("5A5A5A5A5A5A5A5A5A5A5A5A5A5A5A5A", "Work",
+                               kWorkJar, /*isolated=*/true));
+    registry.Append(SpaceEntry("6B6B6B6B6B6B6B6B6B6B6B6B6B6B6B6B", "Old",
+                               kOldJar, /*isolated=*/false));
+    registry.Append(SpaceEntry("7C7C7C7C7C7C7C7C7C7C7C7C7C7C7C7C", "Plain",
+                               std::string(), /*isolated=*/false));
+    GetProfile()->GetPrefs()->SetList(stedding::kSpaceRegistryPref,
+                                      std::move(registry));
+  }
+
+  content::StoragePartitionConfig Jar(const std::string& name) {
+    return content::StoragePartitionConfig::Create(
+        GetProfile(), stedding::kSpacePartitionDomain, name,
+        /*in_memory=*/false);
+  }
+
+  // Every removal task the call leads to, in the order they finished.
+  std::vector<Removal> RemoveAndRecord(
+      base::Time delete_begin,
+      uint64_t remove_mask,
+      std::unique_ptr<BrowsingDataFilterBuilder> filter_builder) {
+    std::vector<Removal> removals;
+    base::RunLoop all_done;
+    content::BrowsingDataRemover* const remover =
+        GetProfile()->GetBrowsingDataRemover();
+    remover->SetWouldCompleteCallbackForTesting(
+        base::BindLambdaForTesting([&](base::OnceClosure continue_to_done) {
+          removals.push_back(
+              {remover->GetLastUsedRemovalMaskForTesting(),
+               remover->GetLastUsedStoragePartitionConfigForTesting(),
+               remover->GetLastUsedBeginTimeForTesting()});
+          if (remover->GetPendingTaskCountForTesting() == 1) {
+            all_done.Quit();
+          }
+          std::move(continue_to_done).Run();
+        }));
+    BlockUntilOriginDataRemoved(delete_begin, base::Time::Max(), remove_mask,
+                                std::move(filter_builder));
+    all_done.Run();
+    remover->SetWouldCompleteCallbackForTesting(
+        base::RepeatingCallback<void(base::OnceClosure)>());
+    return removals;
+  }
+
+  void AddCookie(content::StoragePartition* partition, const GURL& url) {
+    TestFuture<net::CookieAccessResult> set;
+    partition->GetCookieManagerForBrowserProcess()->SetCanonicalCookie(
+        *net::CanonicalCookie::CreateForTesting(url, "session=1",
+                                                base::Time::Now(),
+                                                net::CookieSourceType::kOther),
+        url, net::CookieOptions::MakeAllInclusive(), set.GetCallback());
+    ASSERT_TRUE(set.Get().status.IsInclude());
+  }
+
+  std::vector<std::string> CookieDomains(content::StoragePartition* partition) {
+    TestFuture<std::vector<net::CanonicalCookie>> cookies;
+    partition->GetCookieManagerForBrowserProcess()->GetAllCookies(
+        cookies.GetCallback<const std::vector<net::CanonicalCookie>&>());
+    std::vector<std::string> domains;
+    for (const net::CanonicalCookie& cookie : cookies.Get()) {
+      domains.push_back(cookie.Domain());
+    }
+    return domains;
+  }
+
+ private:
+  static base::DictValue SpaceEntry(const std::string& id,
+                                    const std::string& name,
+                                    const std::string& jar,
+                                    bool isolated) {
+    base::DictValue entry;
+    entry.Set("id", id);
+    entry.Set("name", name);
+    entry.Set("profile", jar);
+    entry.Set("isolated", isolated);
+    return entry;
+  }
+};
+
+TEST_F(SpaceJarChromeBrowsingDataRemoverDelegateTest,
+       RemovalReachesEverySpaceJar) {
+  WriteSpaceRegistry();
+  const uint64_t site_data = constants::DATA_TYPE_SITE_DATA;
+  const uint64_t on_a_jar =
+      content::BrowsingDataRemover::DATA_TYPE_ON_STORAGE_PARTITION & site_data;
+  const base::Time an_hour_ago = AnHourAgo();
+
+  const std::vector<Removal> removals = RemoveAndRecord(
+      an_hour_ago, site_data,
+      BrowsingDataFilterBuilder::Create(
+          BrowsingDataFilterBuilder::Mode::kPreserve));
+
+  EXPECT_THAT(removals,
+              UnorderedElementsAre(
+                  Removal{site_data, std::nullopt, an_hour_ago},
+                  Removal{on_a_jar, Jar(kWorkJar), an_hour_ago},
+                  Removal{on_a_jar, Jar(kOldJar), an_hour_ago}));
+}
+
+TEST_F(SpaceJarChromeBrowsingDataRemoverDelegateTest,
+       RemovalThatNamesAPartitionOrNothingOnOneStaysPut) {
+  WriteSpaceRegistry();
+  std::unique_ptr<BrowsingDataFilterBuilder> one_jar =
+      BrowsingDataFilterBuilder::Create(
+          BrowsingDataFilterBuilder::Mode::kPreserve);
+  one_jar->SetStoragePartitionConfig(Jar(kWorkJar));
+  EXPECT_THAT(RemoveAndRecord(base::Time(),
+                              content::BrowsingDataRemover::DATA_TYPE_COOKIES,
+                              std::move(one_jar)),
+              testing::ElementsAre(Removal{
+                  content::BrowsingDataRemover::DATA_TYPE_COOKIES,
+                  Jar(kWorkJar), base::Time()}));
+
+  EXPECT_THAT(RemoveAndRecord(base::Time(),
+                              constants::DATA_TYPE_CONTENT_SETTINGS,
+                              BrowsingDataFilterBuilder::Create(
+                                  BrowsingDataFilterBuilder::Mode::kPreserve)),
+              testing::ElementsAre(Removal{
+                  constants::DATA_TYPE_CONTENT_SETTINGS, std::nullopt,
+                  base::Time()}));
+}
+
+// The Done-when of SPC-11 at unit level: signed in to a site in a Space, the
+// user deletes cookies for all time, and the Space's jar is empty.
+TEST_F(SpaceJarChromeBrowsingDataRemoverDelegateTest,
+       UnfilteredRemovalEmptiesTheSpaceJar) {
+  WriteSpaceRegistry();
+  content::StoragePartition* const work =
+      GetProfile()->GetStoragePartition(Jar(kWorkJar));
+  ASSERT_TRUE(work);
+  AddCookie(work, GURL("https://example.com/"));
+  ASSERT_THAT(CookieDomains(work), testing::ElementsAre("example.com"));
+
+  RemoveAndRecord(base::Time(), content::BrowsingDataRemover::DATA_TYPE_COOKIES,
+                  BrowsingDataFilterBuilder::Create(
+                      BrowsingDataFilterBuilder::Mode::kPreserve));
+
+  EXPECT_THAT(CookieDomains(work), IsEmpty());
+}
+
+// A site's deletion ("Delete data for this site") takes that site from every
+// Space's jar and leaves the rest.
+TEST_F(SpaceJarChromeBrowsingDataRemoverDelegateTest,
+       FilteredRemovalKeepsWhatTheFilterSpares) {
+  WriteSpaceRegistry();
+  content::StoragePartition* const work =
+      GetProfile()->GetStoragePartition(Jar(kWorkJar));
+  ASSERT_TRUE(work);
+  AddCookie(work, GURL("https://example.com/"));
+  AddCookie(work, GURL("https://example.org/"));
+
+  std::unique_ptr<BrowsingDataFilterBuilder> one_site =
+      BrowsingDataFilterBuilder::Create(
+          BrowsingDataFilterBuilder::Mode::kDelete);
