+// spaces B47 (GitHub issue 73): a page in a Space with an independent session
+// may open the device and file pickers, as it may in the profile's own jar.
+// Chromium refuses them in any partition but the default one; a Space's jar is
+// the profile's own.
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, ASpacesJarMayOpenTheDevicePickers) {
+  tabs::TabInterface* home_page = nullptr;
+  ASSERT_NO_FATAL_FAILURE(OpenWebPage(home_, &home_page));
+  tabs::TabInterface* work_page = nullptr;
+  ASSERT_NO_FATAL_FAILURE(OpenWebPage(work_, &work_page));
+  content::StoragePartition* const profile_jar =
+      browser()->GetProfile()->GetDefaultStoragePartition();
+  content::RenderFrameHost* const in_work =
+      work_page->GetContents()->GetPrimaryMainFrame();
+  ASSERT_NE(profile_jar, in_work->GetStoragePartition());
+  ASSERT_TRUE(spaces::IsSpacePartition(in_work->GetStoragePartition()));
+  content::RenderFrameHost* const in_home =
+      home_page->GetContents()->GetPrimaryMainFrame();
+  ASSERT_EQ(profile_jar, in_home->GetStoragePartition());
+
+  content::ContentBrowserClient* const client =
+      content::GetContentClientForTesting()->browser();
+  ChromeFileSystemAccessPermissionContext* const files =
+      FileSystemAccessPermissionContextFactory::GetForProfile(
+          browser()->GetProfile());
+  for (content::RenderFrameHost* frame : {in_home, in_work}) {
+    SCOPED_TRACE(frame == in_work ? "Work's jar" : "the profile's jar");
+    EXPECT_TRUE(client->GetSerialDelegate()->CanRequestPortPermission(frame));
+    EXPECT_TRUE(client->GetHidDelegate()->IsHidAllowedForFrame(frame));
+    EXPECT_TRUE(client->GetUsbDelegate()->PageMayUseUsb(frame->GetPage()));
+    EXPECT_TRUE(client->GetBluetoothDelegate()->MayUseBluetooth(frame));
+    EXPECT_TRUE(files->CanShowFilePicker(frame).has_value());
+  }
+}
