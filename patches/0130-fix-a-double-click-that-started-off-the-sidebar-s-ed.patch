From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Thu, 5 Nov 2026 09:31:42 -0500
Subject: fix: a double click that started off the sidebar's edge resets
 nothing

The system counts two quick presses a few points apart as a double click, so
a press on the row beside the edge and one on the edge reached the handle as
the second of two, and the width went back to 352 DIP (sidebar Y22; BACKLOG
S-336). Rows and folders already ask that both presses landed on them.

Why: found in a read of a closed pull request and seen red in a test.

Removable when: never as behaviour.
---
 .../views/stedding/sidebar_resize_handle.cc   |  8 ++++++-
 .../ui/views/stedding/sidebar_resize_handle.h |  4 ++++
 .../sidebar_resize_handle_unittest.cc         | 21 +++++++++++++++++++
 3 files changed, 32 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/ui/views/stedding/sidebar_resize_handle.cc b/chrome/browser/ui/views/stedding/sidebar_resize_handle.cc
index fcbeb6514f768..cec09039aa994 100644
--- a/chrome/browser/ui/views/stedding/sidebar_resize_handle.cc
+++ b/chrome/browser/ui/views/stedding/sidebar_resize_handle.cc
@@ -66,6 +66,11 @@ bool SidebarResizeHandle::IsBarShowing() const {
 bool SidebarResizeHandle::OnMousePressed(const ui::MouseEvent& event) {
   const bool handled = views::ResizeArea::OnMousePressed(event);
   if (handled) {
+    // sidebar Y22 (BACKLOG S-336): the second press of a double click resets
+    // the width only if the first landed here too. The system counts two
+    // quick presses a few points apart as a double click.
+    reset_on_release_ = event.GetClickCount() == 2 && first_press_here_;
+    first_press_here_ = event.GetClickCount() == 1;
     // sidebar Y22: a press shows the bar with no wait, for the whole drag.
     hovered_ = true;
     rested_ = true;
@@ -85,7 +90,7 @@ void SidebarResizeHandle::OnMouseReleased(const ui::MouseEvent& event) {
   // sidebar Y22: a left double click whose second press did not drag resets
   // the width. Read before the base class ends the resize.
   const bool reset = !is_resizing() && event.IsOnlyLeftMouseButton() &&
-                     event.GetClickCount() == 2;
+                     event.GetClickCount() == 2 && reset_on_release_;
   views::ResizeArea::OnMouseReleased(event);
   if (reset) {
     // The edge moves out from under the pointer: the bar waits for the
@@ -138,6 +143,7 @@ void SidebarResizeHandle::OnMouseMoved(const ui::MouseEvent& event) {
 }
 
 void SidebarResizeHandle::OnMouseExited(const ui::MouseEvent& event) {
+  first_press_here_ = false;
   views::ResizeArea::OnMouseExited(event);
   // sidebar Y22: leaving the edge hides the bar at once, and a pointer that
   // only crossed it never showed one.
diff --git a/chrome/browser/ui/views/stedding/sidebar_resize_handle.h b/chrome/browser/ui/views/stedding/sidebar_resize_handle.h
index 5ccf1c4e1f2e1..acc9c63a9a66d 100644
--- a/chrome/browser/ui/views/stedding/sidebar_resize_handle.h
+++ b/chrome/browser/ui/views/stedding/sidebar_resize_handle.h
@@ -120,6 +120,10 @@ class SidebarResizeHandle : public views::ResizeArea {
   // there for kRestDelay or pressed.
   bool hovered_ = false;
   bool rested_ = false;
+  // The last left press landed here, and the pointer has not left since. The
+  // one after it may be a double click's second (sidebar Y22).
+  bool first_press_here_ = false;
+  bool reset_on_release_ = false;
   base::OneShotTimer rest_timer_;
 };
 
diff --git a/chrome/browser/ui/views/stedding/sidebar_resize_handle_unittest.cc b/chrome/browser/ui/views/stedding/sidebar_resize_handle_unittest.cc
index 487184858a78b..46bf3d15bb52b 100644
--- a/chrome/browser/ui/views/stedding/sidebar_resize_handle_unittest.cc
+++ b/chrome/browser/ui/views/stedding/sidebar_resize_handle_unittest.cc
@@ -213,6 +213,27 @@ TEST_F(SidebarResizeHandleTest, ADoubleClickResetsTheWidth) {
   EXPECT_EQ(1, resets_) << "a triple click";
 }
 
+// sidebar Y22 (BACKLOG S-336): a double click resets the width only when both
+// presses landed on the edge, as a row's rename asks (tabs R14). The system
+// counts two quick presses a few points apart as a double click, so a press on
+// the row beside the edge and one on the edge reached the handle as the
+// second of two.
+TEST_F(SidebarResizeHandleTest, ADoubleClickThatStartedOffTheEdgeIsNoReset) {
+  Click(ui::EF_IS_DOUBLE_CLICK);
+  EXPECT_EQ(0, resets_) << "the handle never saw the first press";
+
+  // A press on the edge long ago does not count: the pointer left since.
+  Click(ui::EF_NONE);
+  Exit();
+  Enter();
+  Click(ui::EF_IS_DOUBLE_CLICK);
+  EXPECT_EQ(0, resets_) << "the first press was elsewhere";
+
+  Click(ui::EF_NONE);
+  Click(ui::EF_IS_DOUBLE_CLICK);
+  EXPECT_EQ(1, resets_) << "both on the edge";
+}
+
 // A double click whose second press drags stays a resize, as with Chromium's
 // split-view handle.
 TEST_F(SidebarResizeHandleTest, ADoubleClickThatDragsIsAResize) {
