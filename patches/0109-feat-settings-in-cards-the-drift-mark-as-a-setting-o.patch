+// settings T11, sidebar Y11 (BACKLOG S-349): "After 0.35 seconds (Chromium's
+// timing)", stored as 0, is a pause like the others. A pointer resting on the
+// rail opens it once the pause is over and not before, and the wait has its
+// click handler, as the 1, 2 and 5 second pauses do. Read as no pause, it ran
+// Chromium's pointer-speed reading, which opened the rail 50 ms after the
+// pointer came to rest, never under a moving one, and installed no handler.
+IN_PROC_BROWSER_TEST_F(SidebarRailTest, ChromiumsTimingIsAPauseToo) {
+  AppendTab();
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarHoverDelayMs, 0);
+  controller()->SetExpandOnHoverEnabled(true);
+  stedding::test::PointerStandIn pointer(region());
+  controller()->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+  ASSERT_TRUE(controller()->IsCollapsed());
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  ui::EventTargetTestApi handlers(region());
+  const size_t at_rest = handlers.GetPreTargetHandlers().size();
+
+  const base::TimeTicks rested = base::TimeTicks::Now();
+  pointer.On();
+  region()->OnMouseEntered(MouseEvent(ui::EventType::kMouseEntered));
+  region()->OnMouseMoved(MouseEvent(ui::EventType::kMouseMoved));
+  EXPECT_EQ(at_rest + 1, handlers.GetPreTargetHandlers().size())
+      << "the wait has no click handler";
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return region()->is_expanded_on_hover(); }))
+      << "the rail never opened";
+  EXPECT_GE(base::TimeTicks::Now() - rested, base::Milliseconds(350))
+      << "the rail opened before the pause was over";
+
+  pointer.Off();
+  region()->OnMouseExited(MouseEvent(ui::EventType::kMouseExited));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !region()->is_expanded_on_hover() && !Animating(); }));
+}
