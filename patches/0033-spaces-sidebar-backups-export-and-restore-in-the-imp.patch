+namespace spaces {
+
+namespace {
+
+using Node = ArcImportPlan::Node;
+
+std::string TabId(content::WebContents* contents) {
+  return "tab:" + base::NumberToString(
+                      sessions::SessionTabHelper::IdForTab(contents).id());
+}
+
+std::string ContainerId(const tabs::TabCollection* collection) {
+  return base::StringPrintf("folder:%p", static_cast<const void*>(collection));
+}
+
+Node TabNode(SpaceModel* model, tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab->GetContents();
+  Node node;
+  node.kind = Node::Kind::kTab;
+  node.arc_id = TabId(contents);
+  // The user's name for the tab first (tabs R15), then the page title.
+  node.title = stedding::TabName(contents);
+  if (node.title.empty()) {
+    node.title = tab->GetTitle();
+  }
+  // A pin's home is what it comes back as (pins H1).
+  node.url = model->HomeUrl(tab).value_or(contents->GetLastCommittedURL());
+  if (!node.url.is_valid()) {
+    node.url = contents->GetVisibleURL();
+  }
+  return node;
+}
+
+// The folders a tab sits in, outermost first.
+std::vector<const tabs::TabCollection*> FolderChain(tabs::TabInterface* tab) {
+  std::vector<const tabs::TabCollection*> chain;
+  for (const tabs::TabCollection* collection = tab->GetParentCollection();
+       collection; collection = collection->GetParentCollection()) {
+    if (collection->type() == tabs::TabCollection::Type::FOLDER) {
+      chain.insert(chain.begin(), collection);
+    }
+  }
+  return chain;
+}
+
+// Builds one Space's pinned and unpinned nodes: folders nest under the
+// pinned run (the importer keeps them there), loose Space-pinned tabs join
+// it, loose plain tabs are the unpinned run.
+void FillSpace(SpaceModel* model,
+               TabStripModel* tabs,
+               ArcImportPlan::Space* space,
+               const SpaceId& id) {
+  std::map<const tabs::TabCollection*, size_t> folder_index;
+  std::vector<Node> folders;
+  const auto folder_for =
+      [&](const std::vector<const tabs::TabCollection*>& chain) -> Node* {
+    Node* parent = nullptr;
+    std::vector<Node>* siblings = &folders;
+    for (const tabs::TabCollection* collection : chain) {
+      Node* found = nullptr;
+      for (Node& candidate : *siblings) {
+        if (candidate.kind == Node::Kind::kFolder &&
+            candidate.arc_id == ContainerId(collection)) {
+          found = &candidate;
+          break;
+        }
+      }
+      if (!found) {
+        Node folder;
+        folder.kind = Node::Kind::kFolder;
+        folder.arc_id = ContainerId(collection);
+        folder.title = base::UTF8ToUTF16(
+            static_cast<const tabs::FolderTabCollection*>(collection)->title());
+        siblings->push_back(std::move(folder));
+        found = &siblings->back();
+      }
+      parent = found;
+      siblings = &found->children;
+    }
+    return parent;
+  };
+  std::vector<Node> loose_pinned;
+  std::vector<Node> loose_plain;
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    if (tab->IsPinned() || model->SpaceForTab(tab) != id) {
+      continue;
+    }
+    const std::vector<const tabs::TabCollection*> chain = FolderChain(tab);
+    if (!chain.empty()) {
+      folder_for(chain)->children.push_back(TabNode(model, tab));
+    } else if (model->IsSpacePinned(tab)) {
+      loose_pinned.push_back(TabNode(model, tab));
+    } else {
+      loose_plain.push_back(TabNode(model, tab));
+    }
+  }
+  space->pinned = std::move(loose_pinned);
+  for (Node& folder : folders) {
+    space->pinned.push_back(std::move(folder));
+  }
+  space->unpinned = std::move(loose_plain);
+}
+
+ArcImportPlan::Space SpaceEntry(SpaceModel* model, const Space& space) {
+  ArcImportPlan::Space entry;
+  entry.arc_id = space.id().ToString();
+  entry.title = base::UTF16ToUTF8(model->DisplayName(space.id()));
+  entry.emoji = space.icon();
+  entry.color = space.color();
+  return entry;
+}
+
+base::DictValue ItemContainer(const std::string& id,
+                              const std::vector<std::string>& children,
+                              const char* type) {
+  base::DictValue item;
+  item.Set("id", id);
+  item.Set("parentID", base::Value());
+  base::ListValue child_ids;
+  for (const std::string& child : children) {
+    child_ids.Append(child);
+  }
+  item.Set("childrenIds", std::move(child_ids));
+  item.Set("title", "");
+  base::DictValue container_type;
+  container_type.Set(type, base::DictValue());
+  base::DictValue container;
+  container.Set("containerType", std::move(container_type));
+  base::DictValue data;
+  data.Set("itemContainer", std::move(container));
+  item.Set("data", std::move(data));
+  return item;
+}
+
+// Appends `node` and its children to `items` (Arc's flat, id-then-dict
+// list) and returns its id.
+std::string AppendItem(const Node& node,
+                       const std::string& parent,
+                       base::ListValue* items) {
+  base::DictValue item;
+  item.Set("id", node.arc_id);
+  item.Set("parentID", parent);
+  base::ListValue child_ids;
+  base::DictValue data;
+  if (node.kind == Node::Kind::kTab) {
+    item.Set("title", "");
+    base::DictValue tab;
+    tab.Set("savedURL", node.url.spec());
+    tab.Set("savedTitle", node.title);
+    data.Set("tab", std::move(tab));
+  } else {
+    item.Set("title", node.title);
+    data.Set("list", base::DictValue());
+  }
+  for (const Node& child : node.children) {
+    child_ids.Append(child.arc_id);
+  }
+  item.Set("childrenIds", std::move(child_ids));
+  item.Set("data", std::move(data));
+  items->Append(node.arc_id);
+  items->Append(std::move(item));
+  for (const Node& child : node.children) {
+    AppendItem(child, node.arc_id, items);
+  }
+  return node.arc_id;
+}
+
+std::vector<std::string> ChildIds(const std::vector<Node>& nodes) {
+  std::vector<std::string> ids;
+  for (const Node& node : nodes) {
+    ids.push_back(node.arc_id);
+  }
+  return ids;
+}
+
+double Channel(unsigned channel) {
+  return channel / 255.0;
+}
+
+}  // namespace
+
+ArcImportPlan SnapshotSidebar(BrowserWindowInterface* browser) {
+  ArcImportPlan plan;
+  SpaceModel* const model = browser ? SpaceModel::From(browser) : nullptr;
+  TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
+  if (!model || !tabs) {
+    return plan;
+  }
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    if (tab->IsPinned()) {
+      plan.essentials.push_back(TabNode(model, tab));
+    }
+  }
+  for (const std::unique_ptr<Space>& space : model->spaces()) {
+    ArcImportPlan::Space entry = SpaceEntry(model, *space);
+    FillSpace(model, tabs, &entry, space->id());
+    plan.spaces.push_back(std::move(entry));
+  }
+  return plan;
+}
+
+ArcImportPlan SnapshotSpace(BrowserWindowInterface* browser,
+                            const SpaceId& id) {
+  ArcImportPlan plan;
+  SpaceModel* const model = browser ? SpaceModel::From(browser) : nullptr;
+  TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
+  Space* const space = model ? model->GetSpace(id) : nullptr;
+  if (!space || !tabs) {
+    return plan;
+  }
+  ArcImportPlan::Space entry = SpaceEntry(model, *space);
+  FillSpace(model, tabs, &entry, id);
+  plan.spaces.push_back(std::move(entry));
+  return plan;
+}
+
+std::string PlanToJson(const ArcImportPlan& plan) {
+  base::ListValue spaces;
+  base::ListValue items;
+  for (const ArcImportPlan::Space& space : plan.spaces) {
+    const std::string pinned_id = space.arc_id + ":pinned";
+    const std::string unpinned_id = space.arc_id + ":unpinned";
+    base::DictValue entry;
+    entry.Set("id", space.arc_id);
+    entry.Set("title", space.title);
+    base::DictValue profile;
+    profile.Set("default", base::DictValue());
+    entry.Set("profile", std::move(profile));
+    base::ListValue container_ids;
+    container_ids.Append("pinned");
+    container_ids.Append(pinned_id);
+    container_ids.Append("unpinned");
+    container_ids.Append(unpinned_id);
+    entry.Set("containerIDs", std::move(container_ids));
+    base::DictValue custom;
+    base::DictValue icon;
+    icon.Set("emoji_v2", space.emoji);
+    custom.Set("iconType", std::move(icon));
+    if (space.color) {
+      base::DictValue tone;
+      tone.Set("red", Channel(SkColorGetR(*space.color)));
+      tone.Set("green", Channel(SkColorGetG(*space.color)));
+      tone.Set("blue", Channel(SkColorGetB(*space.color)));
+      tone.Set("alpha", 1.0);
+      base::DictValue palette;
+      palette.Set("midTone", std::move(tone));
+      base::DictValue theme;
+      theme.Set("primaryColorPalette", std::move(palette));
+      custom.Set("windowTheme", std::move(theme));
+    }
+    entry.Set("customInfo", std::move(custom));
+    spaces.Append(space.arc_id);
+    spaces.Append(std::move(entry));
+
+    items.Append(pinned_id);
+    items.Append(
+        ItemContainer(pinned_id, ChildIds(space.pinned), "spaceItems"));
+    items.Append(unpinned_id);
+    items.Append(
+        ItemContainer(unpinned_id, ChildIds(space.unpinned), "spaceItems"));
+    for (const Node& node : space.pinned) {
+      AppendItem(node, pinned_id, &items);
+    }
+    for (const Node& node : space.unpinned) {
+      AppendItem(node, unpinned_id, &items);
+    }
+  }
+  const std::string top_id = "essentials";
+  items.Append(top_id);
+  items.Append(ItemContainer(top_id, ChildIds(plan.essentials), "topApps"));
+  for (const Node& node : plan.essentials) {
+    AppendItem(node, top_id, &items);
+  }
+  base::ListValue top_ids;
+  base::DictValue default_top;
+  default_top.Set("default", top_id);
+  top_ids.Append(std::move(default_top));
+  top_ids.Append(top_id);
+
+  base::DictValue sidebar_container;
+  sidebar_container.Set("spaces", std::move(spaces));
+  sidebar_container.Set("items", std::move(items));
+  sidebar_container.Set("topAppsContainerIDs", std::move(top_ids));
+  base::DictValue global;
+  global.Set("global", base::DictValue());
+  base::ListValue containers;
+  containers.Append(std::move(global));
+  containers.Append(std::move(sidebar_container));
+  base::DictValue sidebar;
+  sidebar.Set("containers", std::move(containers));
+  base::DictValue root;
+  root.Set("version", 1);
+  root.Set("sidebar", std::move(sidebar));
+  root.Set("writer", "Stedding");
+  std::string json;
+  base::JSONWriter::WriteWithOptions(
+      root, base::JSONWriter::OPTIONS_PRETTY_PRINT, &json);
+  return json;
+}
+
+base::FilePath BackupDirectory(const base::FilePath& profile_path) {
+  return profile_path.Append("Sidebar Backups");
+}
+
+base::FilePath BackupFileName(base::Time when) {
+  base::Time::Exploded exploded;
+  when.LocalExplode(&exploded);
+  return base::FilePath(base::StringPrintf(
+      "sidebar-%04d%02d%02d-%02d%02d%02d.json", exploded.year, exploded.month,
+      exploded.day_of_month, exploded.hour, exploded.minute, exploded.second));
+}
+
+std::optional<base::Time> TimeFromBackupFileName(const base::FilePath& path) {
+  // sidebar-YYYYMMDD-HHMMSS
+  const std::string name = path.BaseName().RemoveExtension().value();
+  constexpr std::string_view kPrefix = "sidebar-";
+  constexpr size_t kDigits = 15;
+  if (name.size() != kPrefix.size() + kDigits || !name.starts_with(kPrefix) ||
+      name[kPrefix.size() + 8] != '-') {
+    return std::nullopt;
+  }
+  const std::string_view text(name);
+  const size_t at = kPrefix.size();
+  const auto field = [&](size_t offset, size_t length, int* out) {
+    return base::StringToInt(text.substr(at + offset, length), out);
+  };
+  base::Time::Exploded exploded = {};
+  if (!field(0, 4, &exploded.year) || !field(4, 2, &exploded.month) ||
+      !field(6, 2, &exploded.day_of_month) || !field(9, 2, &exploded.hour) ||
+      !field(11, 2, &exploded.minute) || !field(13, 2, &exploded.second)) {
+    return std::nullopt;
+  }
+  base::Time time;
+  if (!base::Time::FromLocalExploded(exploded, &time)) {
+    return std::nullopt;
+  }
+  return time;
+}
+
+std::vector<BackupFile> ListBackups(const base::FilePath& directory) {
+  std::vector<BackupFile> files;
+  base::FileEnumerator it(directory, false, base::FileEnumerator::FILES,
+                          FILE_PATH_LITERAL("sidebar-*.json"));
+  for (base::FilePath path = it.Next(); !path.empty(); path = it.Next()) {
+    if (const std::optional<base::Time> time = TimeFromBackupFileName(path)) {
+      files.push_back({path, *time});
+    }
+  }
+  std::sort(
+      files.begin(), files.end(),
+      [](const BackupFile& a, const BackupFile& b) { return a.time > b.time; });
+  return files;
+}
+
+std::vector<bool> KeepUnderSchedule(const std::vector<base::Time>& times,
+                                    base::Time now) {
+  std::vector<bool> keep(times.size(), false);
+  size_t today = 0;
+  std::set<int> days;
+  std::set<int> weeks;
+  std::set<int> months;
+  for (size_t i = 0; i < times.size(); ++i) {
+    const base::TimeDelta age = now - times[i];
+    if (age < base::Days(1)) {
+      keep[i] = today++ < 10;
+    } else if (age < base::Days(11)) {
+      keep[i] = days.size() < 10 && days.insert(age.InDays()).second;
+    } else if (age < base::Days(11 + 4 * 7)) {
+      keep[i] = weeks.size() < 4 && weeks.insert(age.InDays() / 7).second;
+    } else if (age < base::Days(11 + 4 * 7 + 12 * 30)) {
+      keep[i] = months.size() < 12 && months.insert(age.InDays() / 30).second;
+    }
+  }
+  return keep;
+}
+
+void WriteBackup(const base::FilePath& directory,
+                 const std::string& json,
+                 base::Time now) {
+  if (!base::CreateDirectory(directory)) {
+    return;
+  }
+  base::WriteFile(directory.Append(BackupFileName(now)), json);
+  const std::vector<BackupFile> files = ListBackups(directory);
+  std::vector<base::Time> times;
+  for (const BackupFile& file : files) {
+    times.push_back(file.time);
+  }
+  const std::vector<bool> keep = KeepUnderSchedule(times, now);
+  for (size_t i = 0; i < files.size(); ++i) {
+    if (!keep[i]) {
+      base::DeleteFile(files[i].path);
+    }
+  }
+}
+
+SidebarBackupScheduler::SidebarBackupScheduler(BrowserWindowInterface& browser)
+    : browser_(browser) {
+  first_.Start(FROM_HERE, kFirstDelay,
+               base::BindOnce(&SidebarBackupScheduler::WriteNow,
+                              base::Unretained(this)));
+  timer_.Start(FROM_HERE, kInterval,
+               base::BindRepeating(&SidebarBackupScheduler::WriteNow,
+                                   base::Unretained(this)));
+}
+
+SidebarBackupScheduler::~SidebarBackupScheduler() = default;
+
+void SidebarBackupScheduler::WriteNow() {
+  Profile* const profile = browser_->GetProfile();
+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  const std::string json = PlanToJson(SnapshotSidebar(&*browser_));
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&WriteBackup, BackupDirectory(profile->GetPath()), json,
+                     base::Time::Now()));
+}
+
+namespace {
+
+std::optional<std::string> ReadFileOnPool(const base::FilePath& path) {
+  std::string json;
+  if (!base::ReadFileToString(path, &json)) {
+    return std::nullopt;
+  }
+  return json;
+}
+
+void ApplyRestore(base::WeakPtr<BrowserWindowInterface> browser,
+                  RestoreDoneCallback done,
+                  std::optional<std::string> json) {
+  if (!browser || !json) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(*json);
+  if (!plan) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  std::move(done).Run(ApplyArcImport(browser.get(), *plan, ArcImportOptions()));
+}
+
+base::FilePath WriteExportOnPool(const base::FilePath& directory,
+                                 const std::string& stem,
+                                 const std::string& json) {
+  base::Time::Exploded exploded;
+  base::Time::Now().LocalExplode(&exploded);
+  const base::FilePath path = directory.Append(base::StringPrintf(
+      "%s %04d-%02d-%02d %02d.%02d.json", stem.c_str(), exploded.year,
+      exploded.month, exploded.day_of_month, exploded.hour, exploded.minute));
+  return base::CreateDirectory(directory) && base::WriteFile(path, json)
+             ? path
+             : base::FilePath();
+}
+
+}  // namespace
+
+void RestoreBackupAsync(BrowserWindowInterface* browser,
+                        const base::FilePath& path,
+                        RestoreDoneCallback done) {
+  if (!browser) {
+    std::move(done).Run(std::nullopt);
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&ReadFileOnPool, path),
+      base::BindOnce(&ApplyRestore, browser->GetWeakPtr(), std::move(done)));
+}
+
+void ExportPlanAsync(const ArcImportPlan& plan,
+                     const base::FilePath& directory,
+                     const std::string& stem,
+                     base::OnceCallback<void(base::FilePath)> done) {
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&WriteExportOnPool, directory, stem, PlanToJson(plan)),
+      std::move(done));
+}
+
+}  // namespace spaces
