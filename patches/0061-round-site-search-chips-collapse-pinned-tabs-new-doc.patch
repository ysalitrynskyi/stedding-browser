+  const StarterPackId pack = site.starter_pack_id();
+  // ADR 0020, no bundled model: Gemini, AI Mode and an enterprise search
+  // aggregator's agent, the entries Chromium calls "ask" entries, are never
+  // offered.
+  if (site.is_ask_type() || pack == StarterPackId::kGemini ||
+      pack == StarterPackId::kAiMode) {
