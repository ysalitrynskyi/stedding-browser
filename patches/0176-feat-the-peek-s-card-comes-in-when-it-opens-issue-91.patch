+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_EXTENSION_VISIBLE_PAGE_H_
+#define CHROME_BROWSER_UI_STEDDING_EXTENSION_VISIBLE_PAGE_H_
+
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list_types.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace stedding {
+
+// docs/features/peek.md P24 (BACKLOG S-469, GitHub issue 102): a page that is
+// a tab's page to its user -- its passwords, its permissions, its extensions'
+// content scripts -- though no tab strip holds it: the page of a peek over a
+// pinned tab's page. An extension that met the page, as the sender of a
+// content script's message, reaches it again by that tab id
+// (ExtensionTabUtil::GetTabById), the way Chromium lets it reach a
+// prerendered page: the page alone, in no window and at no index. The mark
+// carries nothing; it is the page's leave to be found.
+//
+// P26 (GitHub issue 102): while it shows over the pinned tab's page, the page
+// is that window's active tab to extensions, as a peek in a window of its own
+// is: `tabs.query` for the active tab finds it in the pinned tab's place, and
+// the tabs API's events announce it (TabsEventRouter, an Observer here).
+class ExtensionVisiblePage
+    : public content::WebContentsUserData<ExtensionVisiblePage> {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // `page` shows over `tab_page` now.
+    virtual void OnPageShownOver(content::WebContents& page,
+                                 content::WebContents& tab_page) = 0;
+    // `page` closed without becoming a tab; `tab_page`, if still there, is
+    // the window's active tab again.
+    virtual void OnPageClosedOver(content::WebContents& page,
+                                  content::WebContents* tab_page) = 0;
+  };
+
+  ExtensionVisiblePage(const ExtensionVisiblePage&) = delete;
+  ExtensionVisiblePage& operator=(const ExtensionVisiblePage&) = delete;
+  ~ExtensionVisiblePage() override;
+
+  static void AddObserver(Observer* observer);
+  static void RemoveObserver(Observer* observer);
+
+  // P26: `page` shows over `tab_page`, a pinned tab's page. Marks `page`
+  // as found by its tab id too.
+  static void ShowOver(content::WebContents& page,
+                       content::WebContents& tab_page);
+  // P26: `page` shows over no page any more: it closed, or it was `kept` as
+  // a tab of the window, which the tab strip announces itself.
+  static void StopShowingOver(content::WebContents& page, bool kept);
+  // P26: the page shown over `tab_page`, or null.
+  static content::WebContents* PageShownOver(content::WebContents* tab_page);
+
+ private:
+  explicit ExtensionVisiblePage(content::WebContents* contents);
+
+  // The page this one shows over, while it does.
+  base::WeakPtr<content::WebContents> over_;
+
+  friend WebContentsUserData;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_EXTENSION_VISIBLE_PAGE_H_
