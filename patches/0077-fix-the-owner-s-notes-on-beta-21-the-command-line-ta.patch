+  // A little window as a link from another app opens one, its page loaded.
+  BrowserWindowInterface* OpenLittle() {
+    BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+        browser()->GetProfile(), embedded_test_server()->GetURL("/title1.html"),
+        /*anchor=*/nullptr, /*untrusted_launch=*/false);
