diff --git a/chrome/browser/ui/stedding/motion_unittest.cc b/chrome/browser/ui/stedding/motion_unittest.cc
index 15021ae9f968c..7460e432745ae 100644
--- a/chrome/browser/ui/stedding/motion_unittest.cc
+++ b/chrome/browser/ui/stedding/motion_unittest.cc
@@ -50,6 +50,31 @@ TEST_F(MotionTest, CaptureParameterStillsIt) {
   EXPECT_FALSE(ShouldAnimate(&prefs_));
 }
 
+// motion O9 (GitHub issue 45): Normal keeps the sidebar's times, Fast halves
+// them, Instant stills the sidebar alone, and "Animate the sidebar and
+// overlays" off stills it whatever the speed.
+TEST_F(MotionTest, TheSidebarsSpeedScalesItsMotions) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  EXPECT_EQ(1.0, SidebarMotionScale(&prefs_));
+  EXPECT_EQ(1.0, SidebarMotionScale(nullptr));
+  EXPECT_TRUE(ShouldAnimateSidebar(&prefs_));
+  prefs_.SetInteger(prefs::kSidebarAnimationSpeed,
+                    prefs::kSidebarAnimationFast);
+  EXPECT_EQ(0.5, SidebarMotionScale(&prefs_));
+  EXPECT_TRUE(ShouldAnimateSidebar(&prefs_));
+  prefs_.SetInteger(prefs::kSidebarAnimationSpeed,
+                    prefs::kSidebarAnimationInstant);
+  EXPECT_EQ(0.0, SidebarMotionScale(&prefs_));
+  EXPECT_FALSE(ShouldAnimateSidebar(&prefs_));
+  EXPECT_TRUE(ShouldAnimate(&prefs_)) << "the overlays still move";
+  prefs_.SetInteger(prefs::kSidebarAnimationSpeed, 7);
+  EXPECT_EQ(1.0, SidebarMotionScale(&prefs_)) << "an unknown value is Normal";
+  prefs_.SetInteger(prefs::kSidebarAnimationSpeed,
+                    prefs::kSidebarAnimationFast);
+  prefs_.SetBoolean(prefs::kUiAnimate, false);
+  EXPECT_FALSE(ShouldAnimateSidebar(&prefs_));
+}
+
 }  // namespace
