+// Lf7: a token GitHub no longer takes keeps the last list, marks the folder
+// and says why; a bad token at making makes nothing.
+IN_PROC_BROWSER_TEST_F(LiveFoldersTest, ABadTokenKeepsTheLastListAndSaysWhy) {
+  for (const char* who : {"author:@me", "assignee:@me",
+                          "review-requested:@me", "mentions:@me"}) {
+    answers_[who] = {net::HTTP_UNAUTHORIZED,
+                     live_folders::recorded::kBadCredentials};
+  }
+  EXPECT_EQ(Failure::kToken, Make());
+  EXPECT_FALSE(Service().on());
+  EXPECT_TRUE(LiveRows(browser()).empty());
+  EXPECT_TRUE(
+      profile()->GetPrefs()->GetString(live_folders::kGitHubTokenPref).empty());
+
+  answers_.clear();
+  AnswerTheFirstList();
+  ASSERT_EQ(Failure::kNone, Make());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return LiveRows(browser()).size() == FirstList().size(); }));
+  std::optional<live_folders::FolderNote> note =
+      live_folders::NoteFor(profile(), Service().folder_id());
+  ASSERT_TRUE(note);
+  EXPECT_FALSE(note->failed);
+
+  for (const char* who : {"author:@me", "assignee:@me",
+                          "review-requested:@me", "mentions:@me"}) {
+    answers_[who] = {net::HTTP_UNAUTHORIZED,
+                     live_folders::recorded::kBadCredentials};
+  }
+  RefreshAndWait();
+  EXPECT_EQ(Failure::kToken, Service().failure());
+  EXPECT_EQ(FirstList(), Names(LiveRows(browser())))
+      << "a failed refresh changed the list";
+  note = live_folders::NoteFor(profile(), Service().folder_id());
+  ASSERT_TRUE(note);
+  EXPECT_TRUE(note->failed);
+  EXPECT_NE(std::u16string::npos, note->tooltip.find(u"expired"))
+      << note->tooltip;
+
+  // GitHub's rate limit says so too.
+  for (const char* who : {"author:@me", "assignee:@me",
+                          "review-requested:@me", "mentions:@me"}) {
+    answers_[who] = {net::HTTP_TOO_MANY_REQUESTS, "{}"};
+  }
+  RefreshAndWait();
+  EXPECT_EQ(Failure::kRateLimit, Service().failure());
+  EXPECT_EQ(FirstList(), Names(LiveRows(browser())));
+
+  // And the next good answer clears the mark.
+  answers_.clear();
+  AnswerTheFirstList();
+  RefreshAndWait();
+  EXPECT_EQ(Failure::kNone, Service().failure());
+  EXPECT_FALSE(live_folders::NoteFor(profile(), Service().folder_id())
+                   .value_or(live_folders::FolderNote{true, u""})
+                   .failed);
+}
