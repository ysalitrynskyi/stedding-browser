+    EXPECT_TRUE(tabstrip()->IsContextMenuCommandEnabled(
+        0, TabStripModel::CommandMoveTabToNewFolder));
+    tabs::FolderTabCollection* const made = tabstrip()->AddToNewFolder({0});
+    ASSERT_TRUE(made);
