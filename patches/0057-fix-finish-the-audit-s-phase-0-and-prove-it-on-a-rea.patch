+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_dialogs.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/strcat.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "components/constrained_window/constrained_window_views.h"
+#include "ui/base/base_window.h"
+#include "ui/base/models/dialog_model.h"
+
+namespace spaces {
+
+void ConfirmInWindow(BrowserWindowInterface* window,
+                     std::u16string title,
+                     std::u16string body,
+                     std::u16string action,
+                     base::OnceClosure on_confirmed) {
+  ui::BaseWindow* const base_window = window ? window->GetWindow() : nullptr;
+  if (!base_window) {
+    return;
+  }
+  constrained_window::ShowBrowserModal(
+      ui::DialogModel::Builder()
+          .SetTitle(std::move(title))
+          .AddParagraph(ui::DialogModelLabel(std::move(body)))
+          .AddOkButton(std::move(on_confirmed),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           std::move(action)))
+          .AddCancelButton(base::DoNothing())
+          .Build(),
+      base_window->GetNativeWindow());
+}
+
+void SetSpaceIsolatedAfterAsking(BrowserWindowInterface* window,
+                                 const SpaceId& id,
+                                 bool isolated) {
+  SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+  if (!model || !model->GetSpace(id)) {
+    return;
+  }
+  const int pages = model->CountPagesAJarChangeReloads(id);
+  if (pages == 0) {
+    model->SetSpaceIsolated(id, isolated);
+    return;
+  }
+  const std::u16string name = model->DisplayName(id);
+  const std::u16string count =
+      pages == 1 ? u"Its open page reloads"
+                 : base::StrCat({u"Its ", base::NumberToString16(pages),
+                                 u" open pages reload"});
+  std::u16string body =
+      isolated ? base::StrCat({count,
+                               u" with cookies of its own, signed out of the "
+                               u"sites it had open."})
+               : base::StrCat({count,
+                               u" with the cookies the other Spaces share. "
+                               u"Its own session is kept for when you turn it "
+                               u"on again."});
+  body += u" A page holding changes you have not saved keeps them until you "
+          u"leave it.";
+  // The model may go with its window while the question is open: the answer
+  // looks the window's model up again.
+  ConfirmInWindow(
+      window,
+      isolated ? base::StrCat({u"Turn on an independent session for “",
+                               name, u"”?"})
+               : base::StrCat({u"Turn off the independent session of “",
+                               name, u"”?"}),
+      std::move(body), isolated ? u"Turn On" : u"Turn Off",
+      base::BindOnce(
+          [](base::WeakPtr<SpaceModel> model, SpaceId id, bool isolated) {
+            if (model && model->GetSpace(id)) {
+              model->SetSpaceIsolated(id, isolated);
+            }
+          },
+          model->GetWeakPtr(), id, isolated));
+}
+
+}  // namespace spaces
