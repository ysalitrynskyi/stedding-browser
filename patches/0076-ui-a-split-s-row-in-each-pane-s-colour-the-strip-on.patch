+      const gfx::Rect right_pane = bounds_of(1);
+      gfx::RectF toolbar(view()->toolbar()->GetLocalBounds());
+      views::View::ConvertRectToTarget(view()->toolbar(), view(), &toolbar);
+      const int y = static_cast<int>(toolbar.CenterPoint().y());
+      gfx::Canvas canvas(view()->size(), 1.0f, /*is_opaque=*/true);
+      view()->background()->Paint(&canvas, view());
+      const SkBitmap& painted = canvas.GetBitmap();
+      // The ground, where no row is: the window's top gutter at that x.
+      const auto ground = [&](int x) { return painted.getColor(x, 2); };
+      const int left_x = left_pane.CenterPoint().x();
+      const int right_x = right_pane.CenterPoint().x();
+      if (left_known) {
+        EXPECT_EQ(light_colour, painted.getColor(left_x, y));
