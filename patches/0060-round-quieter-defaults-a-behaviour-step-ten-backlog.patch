+void TabStripCollection::MoveFolderChild(FolderTabCollection* folder,
+                                         size_t from,
+                                         size_t to) {
+  CHECK(folder);
+  CHECK(from < folder->ChildCount());
+  CHECK(to < folder->ChildCount());
+  if (from == to) {
+    return;
+  }
+  // The Impl functions take one off the index when the node leaves a slot
+  // before its destination, so "at `to`" after a move down is to + 1.
+  TabCollection::Position position{folder->GetHandle(),
+                                   from < to ? to + 1 : to};
+  const Child& child = folder->GetChildren()[from];
+  if (const auto* tab = std::get_if<ScopedTab>(&child)) {
+    MoveTabImpl(tab->get(), position);
+  } else {
+    MoveCollectionImpl(std::get<std::unique_ptr<TabCollection>>(child).get(),
+                       position);
+  }
+}
