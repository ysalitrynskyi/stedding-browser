@@ -0,0 +1,522 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-stedding-shortcuts-editor' is the editable Shortcuts block of
+ * chrome://settings/stedding (docs/features/shortcuts.md Z5, Z10-Z23): every
+ * command a chord reaches, grouped, with its chords, a recorder, a switch and
+ * Reset; a search field and a group filter; Reset all; and below them the
+ * shipped divergences and notes. The chords are the machine's, kept in Local
+ * State by SteddingShortcutsHandler. None of its controls is bound to a
+ * profile preference.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_toggle/cr_toggle.js';
+
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import type {CSSResultGroup} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+import {css, CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getHtml} from './stedding_shortcuts_editor.html.js';
+
+/** One chord of a row: the stored text and the text the menus print. */
+export interface SteddingShortcutChord {
+  value: string;
+  text: string;
+}
+
+/** One row of the block, as SteddingShortcutsHandler sends it. */
+export interface SteddingShortcutEditRow {
+  name: string;
+  label: string;
+  chords: SteddingShortcutChord[];
+  defaults: string[];
+  lost: string[];
+  off: boolean;
+  changed: boolean;
+  rebind: boolean;
+  toggle: boolean;
+  held: boolean;
+  family: boolean;
+  macos: boolean;
+  // Z23: on the Space row, where the layout can change.
+  layouts?: SteddingNumberKeysLayout[];
+  layoutNote?: string;
+}
+
+/** One layout of the number keys (Z23), as the menu lists it. */
+export interface SteddingNumberKeysLayout {
+  value: string;
+  text: string;
+  selected: boolean;
+}
+
+export interface SteddingShortcutEditGroup {
+  title: string;
+  rows: SteddingShortcutEditRow[];
+}
+
+/** One line of the shipped reference: a divergence (Z2) or a note (Z3). */
+export interface SteddingShortcutReferenceRow {
+  chord: string;
+  what: string;
+  chromium: string;
+}
+
+export interface SteddingShortcutReferenceGroup {
+  title: string;
+  kind: string;
+  rows: SteddingShortcutReferenceRow[];
+}
+
+/** What the browser answers on a chord (Z12, Z14, Z15, Z18). */
+export interface SteddingShortcutCheck {
+  kind: 'ok'|'same'|'conflict'|'refused';
+  message: string;
+  value: string;
+  text: string;
+  other: string;
+}
+
+/** A chord that waits on the person: a conflict, or a refusal to read. */
+export interface PendingChord extends SteddingShortcutCheck {
+  name: string;
+}
+
+// The keys that are only modifiers: the recorder waits for the key itself.
+const MODIFIER_KEYS = new Set([
+  'Control',
+  'Alt',
+  'AltGraph',
+  'Shift',
+  'Meta',
+  'OS',
+  'CapsLock',
+  'Fn',
+]);
+
+const SettingsSteddingShortcutsEditorElementBase =
+    WebUiListenerMixinLit(CrLitElement);
+
+export class SettingsSteddingShortcutsEditorElement extends
+    SettingsSteddingShortcutsEditorElementBase {
+  static get is() {
+    return 'settings-stedding-shortcuts-editor';
+  }
+
+  static override get styles(): CSSResultGroup {
+    return css`
+      :host {
+        display: block;
+      }
+      .box {
+        border-top: var(--cr-separator-line);
+        padding: 0 var(--cr-section-padding, 20px);
+      }
+      .tools {
+        align-items: center;
+        display: flex;
+        gap: 12px;
+        padding-bottom: 8px;
+        padding-top: 8px;
+      }
+      #shortcutSearch {
+        flex: 1;
+      }
+      #shortcutGroup,
+      .number-keys select {
+        background: transparent;
+        border: 1px solid var(--cr-separator-color);
+        border-radius: 6px;
+        color: var(--cr-primary-text-color);
+        font: inherit;
+        padding: 4px 8px;
+      }
+      #shortcutPrompt {
+        color: var(--cr-secondary-text-color);
+        min-height: 1.5em;
+        padding: 0 var(--cr-section-padding, 20px);
+      }
+      .shortcut-group {
+        padding-bottom: 8px;
+      }
+      .shortcut-group-title {
+        font-weight: 500;
+        padding: 10px 0 4px;
+      }
+      .shortcut-row,
+      .number-keys,
+      .shortcut-reference-row {
+        align-items: center;
+        display: flex;
+        flex-wrap: wrap;
+        gap: 8px 12px;
+        min-height: 32px;
+        padding: 2px 0;
+      }
+      .shortcut-row.off .what,
+      .shortcut-row.off .chord {
+        color: var(--cr-secondary-text-color);
+      }
+      .what {
+        flex: 1;
+        min-width: 200px;
+      }
+      .chords {
+        align-items: center;
+        display: flex;
+        flex-wrap: wrap;
+        gap: 4px;
+      }
+      .chip {
+        align-items: center;
+        display: inline-flex;
+      }
+      .chord {
+        border: 1px solid var(--cr-separator-color);
+        border-radius: 6px;
+        font-family: inherit;
+        min-width: 56px;
+        padding: 1px 8px;
+        text-align: center;
+        white-space: nowrap;
+      }
+      .note,
+      .chromium {
+        color: var(--cr-secondary-text-color);
+        font-size: 12px;
+      }
+      .shortcut-conflict {
+        align-items: center;
+        background: var(--cr-hover-background-color);
+        border-radius: 6px;
+        display: flex;
+        flex-wrap: wrap;
+        gap: 8px;
+        margin: 4px 0 8px;
+        padding: 8px 12px;
+      }
+      .shortcut-conflict .message {
+        flex: 1;
+      }
+      .number-keys {
+        padding-inline-start: 16px;
+      }
+      .add-button.recording {
+        outline: 2px solid var(--cr-focus-outline-color);
+      }
+    `;
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      groups_: {type: Array},
+      reference_: {type: Array},
+      search_: {type: String},
+      groupFilter_: {type: String},
+      recordingName_: {type: String},
+      pending_: {type: Object},
+      prompt_: {type: String},
+    };
+  }
+
+  protected accessor groups_: SteddingShortcutEditGroup[] = [];
+  protected accessor reference_: SteddingShortcutReferenceGroup[] = [];
+  protected accessor search_: string = '';
+  protected accessor groupFilter_: string = '';
+  // Z19: the row whose recorder listens, '' when none does.
+  protected accessor recordingName_: string = '';
+  protected accessor pending_: PendingChord|null = null;
+  // Z19: what a screen reader hears, and the line under the tools.
+  protected accessor prompt_: string = '';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'stedding-shortcuts-changed', () => this.refresh_());
+    this.refresh_();
+    sendWithPromise('steddingGetShortcuts').then((groups: unknown) => {
+      // Z2, Z3: the shipped divergences and notes; the editable rows list
+      // every command themselves.
+      this.reference_ = (groups as SteddingShortcutReferenceGroup[])
+                            .filter(group => group.kind !== 'reference');
+    });
+  }
+
+  override disconnectedCallback() {
+    this.stopRecording_();
+    super.disconnectedCallback();
+  }
+
+  protected refresh_(): Promise<void> {
+    return sendWithPromise('steddingGetShortcutRows')
+        .then((groups: unknown) => {
+          this.groups_ = groups as SteddingShortcutEditGroup[];
+        });
+  }
+
+  // Z22: the rows the search and the group filter leave.
+  protected visibleGroups_(): SteddingShortcutEditGroup[] {
+    const query = this.search_.trim().toLowerCase();
+    return this.groups_
+        .filter(group => !this.groupFilter_ || group.title === this.groupFilter_)
+        .map(group => ({
+               title: group.title,
+               rows: group.rows.filter(
+                   row => !query || row.label.toLowerCase().includes(query) ||
+                       row.chords.some(
+                           chord => chord.text.toLowerCase().includes(query))),
+             }))
+        .filter(group => group.rows.length > 0);
+  }
+
+  protected noMatch_(): boolean {
+    return this.groups_.length > 0 && this.visibleGroups_().length === 0;
+  }
+
+  protected onSearchInput_(e: Event) {
+    this.search_ = (e.target as CrInputElement).value;
+  }
+
+  protected onGroupChange_(e: Event) {
+    this.groupFilter_ = (e.target as HTMLSelectElement).value;
+  }
+
+  private rowNamed_(name: string): SteddingShortcutEditRow|undefined {
+    for (const group of this.groups_) {
+      const row = group.rows.find(candidate => candidate.name === name);
+      if (row) {
+        return row;
+      }
+    }
+    return undefined;
+  }
+
+  protected isRecording_(row: SteddingShortcutEditRow): boolean {
+    return this.recordingName_ === row.name;
+  }
+
+  protected addLabel_(row: SteddingShortcutEditRow): string {
+    return this.isRecording_(row) ?
+        loadTimeData.getString('steddingShortcutsRecording') :
+        loadTimeData.getString('steddingShortcutsAdd');
+  }
+
+  protected removeLabel_(chord: SteddingShortcutChord): string {
+    return loadTimeData.getStringF('steddingShortcutsRemove', chord.text);
+  }
+
+  protected defaultsLine_(row: SteddingShortcutEditRow): string {
+    return loadTimeData.getStringF(
+        'steddingShortcutsDefault',
+        row.defaults.length ? row.defaults.join(', ') :
+                              loadTimeData.getString('steddingShortcutsNone'));
+  }
+
+  protected lostLine_(row: SteddingShortcutEditRow): string {
+    return loadTimeData.getStringF(
+        'steddingShortcutsLost', row.lost.join(', '));
+  }
+
+  protected pendingFor_(row: SteddingShortcutEditRow): PendingChord|null {
+    return this.pending_ && this.pending_.name === row.name ? this.pending_ :
+                                                              null;
+  }
+
+  // Z19: the recorder. Every key goes to the page while it listens -- the
+  // browser's own chords included, since the window stops handling them --
+  // and does nothing else. Escape cancels; Tab or Shift+Tab alone leaves it;
+  // the window losing focus or the page going ends it.
+  protected onAddClick_(e: Event) {
+    const name = (e.currentTarget as HTMLElement).dataset['name'] || '';
+    if (this.recordingName_ === name) {
+      this.stopRecording_();
+      this.prompt_ = '';
+      return;
+    }
+    this.startRecording_(name);
+  }
+
+  private startRecording_(name: string) {
+    const row = this.rowNamed_(name);
+    if (!row) {
+      return;
+    }
+    this.stopRecording_();
+    this.pending_ = null;
+    this.recordingName_ = name;
+    this.prompt_ =
+        loadTimeData.getStringF('steddingShortcutsRecordPrompt', row.label);
+    chrome.send('steddingRecordShortcut', [true]);
+    window.addEventListener('keydown', this.onRecordKeydown_, true);
+    window.addEventListener('blur', this.onRecordEnd_);
+    document.addEventListener('visibilitychange', this.onRecordEnd_);
+  }
+
+  private stopRecording_() {
+    if (!this.recordingName_) {
+      return;
+    }
+    this.recordingName_ = '';
+    chrome.send('steddingRecordShortcut', [false]);
+    window.removeEventListener('keydown', this.onRecordKeydown_, true);
+    window.removeEventListener('blur', this.onRecordEnd_);
+    document.removeEventListener('visibilitychange', this.onRecordEnd_);
+  }
+
+  private onRecordEnd_ = () => {
+    this.stopRecording_();
+    this.prompt_ = '';
+  };
+
+  private onRecordKeydown_ = (e: KeyboardEvent) => {
+    const name = this.recordingName_;
+    if (!name) {
+      return;
+    }
+    const plain = !e.ctrlKey && !e.altKey && !e.metaKey;
+    if (e.key === 'Tab' && plain) {
+      // No keyboard trap: Tab moves on, and the recorder lets go.
+      this.stopRecording_();
+      this.prompt_ = '';
+      return;
+    }
+    e.preventDefault();
+    e.stopPropagation();
+    if (e.key === 'Escape' && plain && !e.shiftKey) {
+      this.stopRecording_();
+      this.prompt_ = '';
+      return;
+    }
+    if (MODIFIER_KEYS.has(e.key)) {
+      return;
+    }
+    if (e.getModifierState('AltGraph')) {
+      // Windows: AltGr is Ctrl and Alt to the page and types characters.
+      this.prompt_ = loadTimeData.getString('steddingShortcutsAltGr');
+      return;
+    }
+    this.stopRecording_();
+    sendWithPromise(
+        'steddingCheckShortcut', name, e.keyCode, e.ctrlKey, e.altKey,
+        e.shiftKey, e.metaKey)
+        .then((result: unknown) => {
+          this.onChecked_(name, result as SteddingShortcutCheck);
+        });
+  };
+
+  private onChecked_(name: string, result: SteddingShortcutCheck) {
+    if (result.kind === 'ok') {
+      this.add_(name, result.value, /*replace=*/ false);
+      return;
+    }
+    if (result.kind === 'same') {
+      this.prompt_ = '';
+      return;
+    }
+    // Z12: a conflict waits on Replace or Cancel; a refusal says why.
+    this.pending_ = {...result, name};
+    this.prompt_ = result.message;
+  }
+
+  private add_(name: string, value: string, replace: boolean) {
+    sendWithPromise('steddingAddShortcut', name, value, replace)
+        .then((answer: unknown) => {
+          const result = answer as SteddingShortcutCheck;
+          const row = this.rowNamed_(name);
+          if (result.kind === 'ok' ||
+              (result.kind === 'conflict' && replace)) {
+            this.pending_ = null;
+            this.prompt_ = loadTimeData.getStringF(
+                'steddingShortcutsSaved', result.text, row ? row.label : '');
+          } else if (result.kind !== 'same') {
+            this.pending_ = {...result, name};
+            this.prompt_ = result.message;
+          }
+          return this.refresh_();
+        });
+  }
+
+  protected onReplaceClick_() {
+    if (this.pending_) {
+      this.add_(this.pending_.name, this.pending_.value, /*replace=*/ true);
+    }
+  }
+
+  protected onPendingDismissClick_() {
+    this.pending_ = null;
+    this.prompt_ = '';
+  }
+
+  protected onRemoveClick_(e: Event) {
+    const target = e.currentTarget as HTMLElement;
+    sendWithPromise(
+        'steddingRemoveShortcut', target.dataset['name'],
+        target.dataset['value'])
+        .then(() => this.refresh_());
+  }
+
+  protected onSwitchChange_(e: Event) {
+    const toggle = e.currentTarget as HTMLElement & {checked: boolean};
+    sendWithPromise(
+        'steddingSetShortcutOff', toggle.dataset['name'], !toggle.checked)
+        .then(() => this.refresh_());
+  }
+
+  protected onResetClick_(e: Event) {
+    sendWithPromise(
+        'steddingResetShortcut', (e.currentTarget as HTMLElement).dataset['name'])
+        .then(() => this.refresh_());
+  }
+
+  // Z23: the two sets of numbered keys trade places, or one moves away.
+  protected onNumberKeysChange_(e: Event) {
+    sendWithPromise(
+        'steddingSetNumberKeys', (e.target as HTMLSelectElement).value)
+        .then(() => this.refresh_());
+  }
+
+  private resetAllDialog_(): CrDialogElement {
+    return this.shadowRoot.querySelector<CrDialogElement>('#resetAllDialog')!;
+  }
+
+  protected onResetAllClick_() {
+    this.stopRecording_();
+    this.resetAllDialog_().showModal();
+  }
+
+  protected onResetAllCancelClick_() {
+    this.resetAllDialog_().close();
+  }
+
+  protected onResetAllConfirmClick_() {
+    this.resetAllDialog_().close();
+    this.pending_ = null;
+    this.prompt_ = '';
+    sendWithPromise('steddingResetAllShortcuts').then(() => this.refresh_());
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-stedding-shortcuts-editor':
+        SettingsSteddingShortcutsEditorElement;
+  }
+}
+
+customElements.define(
+    SettingsSteddingShortcutsEditorElement.is,
+    SettingsSteddingShortcutsEditorElement);
