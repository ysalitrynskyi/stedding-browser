+
+// The Spaces in a window's session data (`list`, as Serialize() wrote it), in
+// their order; an entry that cannot be read is left out.
+std::vector<std::unique_ptr<Space>> SpacesFromSessionList(
+    const base::ListValue& list) {
+  std::vector<std::unique_ptr<Space>> spaces;
+  for (const base::Value& item : list) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::DictValue& entry = item.GetDict();
+    const std::string* const id_text = entry.FindString("id");
+    if (!id_text) {
+      continue;
+    }
+    const std::optional<base::Token> token = base::Token::FromString(*id_text);
+    if (!token) {
+      continue;
+    }
+    const SpaceId id = SpaceId::FromRawToken(*token);
+    const std::string* const name = entry.FindString("name");
+    const std::string* const icon = entry.FindString("icon");
+    auto space = std::make_unique<Space>(
+        id, name ? *name : std::string(),
+        static_cast<SkColor>(entry.FindInt("color").value_or(
+            static_cast<int>(kDefaultSpaceColor))));
+    if (icon) {
+      space->SetIcon(*icon);
+    }
+    space->set_color_chosen(entry.FindBool("color_chosen").value_or(false));
+    // pins H17: a session from before the state existed is expanded.
+    space->set_pins_collapsed(
+        entry.FindBool("pins_collapsed").value_or(false));
+    spaces.push_back(std::move(space));
+  }
+  return spaces;
+}
