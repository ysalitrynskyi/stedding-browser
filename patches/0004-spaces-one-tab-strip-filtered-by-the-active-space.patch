diff --git a/chrome/browser/sessions/stedding_session_rebuild.cc b/chrome/browser/sessions/stedding_session_rebuild.cc
new file mode 100644
index 0000000000000..555d11b920a4c
--- /dev/null
+++ b/chrome/browser/sessions/stedding_session_rebuild.cc
@@ -0,0 +1,48 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/sessions/stedding_session_rebuild.h"
+
+#include <string>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "components/sessions/core/session_command.h"
+
+namespace stedding {
+
+namespace {
+
+struct Provider {
+  std::string name;
+  SessionRebuildProvider callback;
+};
+
+std::vector<Provider>& Providers() {
+  static base::NoDestructor<std::vector<Provider>> providers;
+  return *providers;
+}
+
+}  // namespace
+
+void AddSessionRebuildProvider(std::string_view name,
+                               SessionRebuildProvider provider) {
+  for (Provider& existing : Providers()) {
+    if (existing.name == name) {
+      existing.callback = std::move(provider);
+      return;
+    }
+  }
+  Providers().push_back({std::string(name), std::move(provider)});
+}
+
+SessionRebuildCommands CollectSessionRebuildCommands(BrowserWindowInterface* browser) {
+  SessionRebuildCommands commands;
+  for (const Provider& provider : Providers()) {
+    provider.callback.Run(browser, &commands);
+  }
+  return commands;
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/sessions/stedding_session_rebuild.h b/chrome/browser/sessions/stedding_session_rebuild.h
new file mode 100644
index 0000000000000..4d9fd3779d251
--- /dev/null
+++ b/chrome/browser/sessions/stedding_session_rebuild.h
@@ -0,0 +1,49 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SESSIONS_STEDDING_SESSION_REBUILD_H_
+#define CHROME_BROWSER_SESSIONS_STEDDING_SESSION_REBUILD_H_
+
+#include <memory>
+#include <string_view>
+#include <vector>
+
+#include "base/functional/callback.h"
+
+class BrowserWindowInterface;
+
+namespace sessions {
+class SessionCommand;
+}  // namespace sessions
+
+namespace stedding {
+
+using SessionRebuildCommands =
+    std::vector<std::unique_ptr<sessions::SessionCommand>>;
+
+// Adds commands that re-emit a feature's per-window and per-tab session extra
+// data for `browser`.
+using SessionRebuildProvider =
+    base::RepeatingCallback<void(BrowserWindowInterface* browser,
+                                 SessionRebuildCommands* commands)>;
+
+// The session service does not only append commands. Every kWritesPerReset
+// writes, and at every startup, it rebuilds the log from the live browser --
+// and it knows nothing about the extra data features wrote into the old log.
+// Anything not re-emitted here survives exactly one restart and then vanishes
+// with no error, which is how a window with three Spaces came back with one.
+//
+// A feature that writes extra data registers a provider under a stable name
+// (registering the same name again replaces the earlier provider), and the
+// rebuild asks every provider for its commands after Chromium's own.
+void AddSessionRebuildProvider(std::string_view name,
+                               SessionRebuildProvider provider);
+
+// The commands every registered provider adds for `browser`, in registration
+// order.
+SessionRebuildCommands CollectSessionRebuildCommands(BrowserWindowInterface* browser);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_SESSIONS_STEDDING_SESSION_REBUILD_H_
