@@ -0,0 +1,73 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_ARCHIVE_CLOSED_FOLDER_H_
+#define CHROME_BROWSER_UI_ARCHIVE_CLOSED_FOLDER_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace sessions {
+class LiveTab;
+class LiveTabContext;
+}  // namespace sessions
+
+namespace stedding {
+
+// PLAN.md TAB-13, docs/features/folders.md F19: a folder's tabs closed
+// together come back together. Close Folder's Tabs marks each tab it closes
+// with the close's batch (archive_mark.h). The recently-closed list keeps an
+// entry per tab, as for any close, so Undo, the Archived view and the saved
+// list read them as before; the menus that list recently closed tabs and ⇧⌘T
+// show a batch as one folder and bring it back whole.
+
+// The batch of the Close Folder's Tabs that recorded `entry`, or "" for an
+// entry any other close made.
+std::string ClosedFolderBatchOf(const sessions::tab_restore::Entry& entry);
+
+// One folder close as the recently-closed list holds it.
+struct ClosedFolder {
+  ClosedFolder();
+  ClosedFolder(const ClosedFolder&);
+  ClosedFolder& operator=(const ClosedFolder&);
+  ~ClosedFolder();
+
+  std::string batch;
+  // The folder's name when it was closed.
+  std::u16string name;
+  // Its tabs' entries, in the folder's order: the oldest entry first.
+  std::vector<raw_ptr<const sessions::tab_restore::Tab, VectorExperimental>>
+      tabs;
+};
+
+// The folder close that recorded the entry at `it`: every tab entry of that
+// close, wherever it is in `entries`. nullopt for an entry no folder close
+// made.
+std::optional<ClosedFolder> ClosedFolderAt(
+    const sessions::TabRestoreService::Entries& entries,
+    sessions::TabRestoreService::Entries::const_iterator it);
+
+// Restores every tab of the folder close `batch` and returns them, the folder
+// together and in its order. For UNKNOWN, as ⇧⌘T restores, each tab goes back
+// to its place, the folder's first tab shown; otherwise the first comes back
+// with `disposition` and the rest after it, in the background. With no
+// `context` the tabs go back to their window, which the first restore opens.
+// The tabs' folder path puts them back in their folder
+// (FolderSessionService).
+std::vector<sessions::LiveTab*> RestoreClosedFolder(
+    sessions::TabRestoreService& service,
+    sessions::LiveTabContext* context,
+    std::string_view batch,
+    WindowOpenDisposition disposition);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_ARCHIVE_CLOSED_FOLDER_H_
