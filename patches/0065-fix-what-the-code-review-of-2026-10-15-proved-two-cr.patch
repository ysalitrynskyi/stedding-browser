+    TabCollection* outermost_folder = nullptr;
+    for (TabCollection* each = holder; each;
+         each = each->GetParentCollection()) {
+      if (each->type() == TabCollection::Type::FOLDER) {
+        outermost_folder = each;
+      }
+    }
+    if (outermost_folder) {
+      TabCollection* const above = outermost_folder->GetParentCollection();
+      const std::optional<size_t> at =
+          above ? above->GetIndexOfCollection(outermost_folder) : std::nullopt;
+      CHECK(at.has_value());
+      group_insertion_details = {above->GetHandle(), *at + 1};
+    }
 
     AddTabCollectionImpl(PopDetachedGroupCollection(new_group_id.value()),
                          group_insertion_details);
