+  }
   if (!download_commands_) {
     return false;
   }
@@ -109,6 +158,12 @@ bool DownloadUiContextMenu::IsCommandIdChecked(int command_id) const {
 }
 
 bool DownloadUiContextMenu::IsCommandIdVisible(int command_id) const {
+  if (command_id == kSteddingRemoveFromList) {
+    return SteddingMayRemove(download_.get());
+  }
+  if (command_id == kSteddingMoveToTrash) {
+    return true;
+  }
   if (!download_commands_) {
     return false;
   }
@@ -118,6 +173,42 @@ bool DownloadUiContextMenu::IsCommandIdVisible(int command_id) const {
 }
 
 void DownloadUiContextMenu::ExecuteCommand(int command_id, int event_flags) {
+  if (command_id == kSteddingMoveToTrash) {
+    download::DownloadItem* const item = SteddingFinishedFile(download_.get());
+    if (!item) {
+      return;
+    }
+    // Pn11: off the UI thread, to the Trash or the Recycle Bin, never
+    // deleted outright. The download then finds its file gone and reads as
+    // removed, as one deleted by hand does.
+    void* const profile = Profile::FromBrowserContext(
+        content::DownloadItemUtils::GetBrowserContext(item));
+    stedding::MoveToTrashThen(
+        item->GetTargetFilePath(),
+        base::BindOnce(
+            [](void* profile, bool moved) {
+              ProfileManager* const profiles =
+                  g_browser_process->profile_manager();
+              if (!moved || !profiles || !profiles->IsValidProfile(profile)) {
+                return;
+              }
+              static_cast<Profile*>(profile)
+                  ->GetDownloadManager()
+                  ->CheckForHistoryFilesRemoval();
+            },
+            profile));
+    return;
+  }
+  if (command_id == kSteddingRemoveFromList) {
+    // Pn9: off the list and out of the history, as the Downloads page's
+    // Remove from List does; the file stays.
+    if (download::DownloadItem* const item =
+            download_ ? download_->GetDownloadItem() : nullptr;
+        item && SteddingMayRemove(download_.get())) {
+      item->Remove();
+    }
+    return;
+  }
   if (!download_commands_) {
     return;
   }
@@ -314,6 +405,17 @@ ui::SimpleMenuModel* DownloadUiContextMenu::GetFinishedMenuModel(
     finished_download_menu_model_->AddItem(
         DownloadCommands::SHOW_IN_FOLDER,
         GetLabelForCommandId(DownloadCommands::SHOW_IN_FOLDER));
+    // Stedding, Pn19: the Downloads panel's verbs. Linux, which is not
+    // shipped, has no Trash of Stedding's (file_trash_other.cc).
+#if BUILDFLAG(IS_MAC)
+    finished_download_menu_model_->AddItem(kSteddingMoveToTrash,
+                                           u"Move to Trash");
+#elif BUILDFLAG(IS_WIN)
+    finished_download_menu_model_->AddItem(kSteddingMoveToTrash,
+                                           u"Move to Recycle Bin");
+#endif
+    finished_download_menu_model_->AddItem(kSteddingRemoveFromList,
+                                           u"Remove from List");
     finished_download_menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
   }
 
