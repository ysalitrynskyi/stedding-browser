+// A Space, Work, with a session of its own, and it is the active Space. The
+// server records the Authorization header of every request.
+class SpaceJarB17Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestMonitor(base::BindRepeating(
+        &SpaceJarB17Test::OnRequest, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+
+    model_ = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model_);
+    work_ = model_->AddSpace("Work", SK_ColorBLUE)->id();
+    model_->SetSpaceIsolated(work_, true);
+    ASSERT_TRUE(model_->SpaceIsIsolated(work_));
+    ASSERT_TRUE(model_->SetActiveSpace(work_));
+  }
+
+  void TearDownOnMainThread() override {
+    // The model belongs to the window, which closes after this.
+    model_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  GURL Url(const std::string& host, const std::string& path) {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  static bool InWorksJar(tabs::TabInterface* tab) {
+    return spaces::IsSpaceStoragePartition(
+        spaces::StoragePartitionConfigForWebContents(tab->GetContents()));
+  }
+
+  // How many requests for `path` (with its query) the server has had.
+  size_t RequestsFor(const std::string& path) {
+    base::AutoLock lock(lock_);
+    const auto it = authorizations_.find(path);
+    return it == authorizations_.end() ? 0u : it->second.size();
+  }
+
+  // The Authorization header of the last request for `path` (with its
+  // query), empty when it had none.
+  std::string LastAuthorizationFor(const std::string& path) {
+    base::AutoLock lock(lock_);
+    const auto it = authorizations_.find(path);
+    return it == authorizations_.end() || it->second.empty()
+               ? std::string()
+               : it->second.back();
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  spaces::SpaceId work_ = spaces::SpaceId::GenerateNew();
+
+ private:
+  // The server's thread.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    const std::string path = request.GetURL().PathForRequest();
+    const auto authorization = request.headers.find("Authorization");
+    base::AutoLock lock(lock_);
+    authorizations_[path].push_back(authorization == request.headers.end()
+                                        ? std::string()
+                                        : authorization->second);
+  }
+
+  base::Lock lock_;
+  std::map<std::string, std::vector<std::string>> authorizations_
+      GUARDED_BY(lock_);
+};
