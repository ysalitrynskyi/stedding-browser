+// Lf1, Lf3, Lf5, Lf10: made, the folder lists what GitHub's answer holds:
+// each pull request once, newest first, asleep, named for its repository and
+// title, at its address, in one pinned folder of the Space it was made in;
+// and a second window shows the same folder.
+IN_PROC_BROWSER_TEST_F(LiveFoldersTest, TheFolderListsWhatTheAnswerHolds) {
+  AnswerTheFirstList();
+  ASSERT_EQ(Failure::kNone, Make());
+  ASSERT_TRUE(Service().on());
+  EXPECT_EQ(4u, seen_.size()) << "the four searches, once each";
+
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return LiveRows(browser()).size() == FirstList().size();
+  }));
+  const std::vector<tabs::TabInterface*> rows = LiveRows(browser());
+  EXPECT_EQ(FirstList(), Names(rows));
+  const tabs::FolderTabCollection* const folder = FolderOf(rows.front());
+  ASSERT_TRUE(folder);
+  EXPECT_EQ("Pull Requests", folder->title());
+  EXPECT_EQ(Service().folder_id(), folder->id().ToString());
+  EXPECT_TRUE(Model(browser()).IsFolderSpacePinned(folder));
+  for (tabs::TabInterface* tab : rows) {
+    EXPECT_EQ(folder, FolderOf(tab));
+    EXPECT_TRUE(Model(browser()).IsSpacePinned(tab));
+    EXPECT_EQ(Model(browser()).active_id(),
+              Model(browser()).FindSpaceForTab(tab));
+    EXPECT_TRUE(Asleep(tab)) << "a row loads only when chosen";
+  }
+  EXPECT_EQ(GURL("https://github.com/acme/rocket/pull/45"),
+            Model(browser()).HomeUrl(rows[0]).value_or(GURL()));
+  EXPECT_EQ(3u, Service().rows());
+
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return LiveRows(second).size() == FirstList().size();
+  })) << "the second window lacks the live folder";
+  EXPECT_EQ(FirstList(), Names(LiveRows(second)));
+  EXPECT_EQ(Service().folder_id(),
+            FolderOf(LiveRows(second).front())->id().ToString());
+  EXPECT_EQ(4u, seen_.size()) << "a new window asks GitHub nothing more";
+}
