index 0000000000000..6136519753950
--- /dev/null
+++ b/chrome/browser/resources/stedding_library/app.ts
@@ -0,0 +1,71 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// chrome://stedding-library: the sidebar's History and Downloads panels
+// (docs/features/sidebar-panels.md). The path names the panel. Each has a
+// header with its name, Open as Page and a close button, and a search field
+// that has the focus when the panel opens (Pn5).
+
+import '/strings.m.js';
+
+import {closeMenu, closePanel, isMenuOpen, openAsPage, str} from './common.js';
+import {DownloadsPanel} from './downloads_panel.js';
+import {HistoryPanel} from './history_panel.js';
+
+function start() {
+  const kind =
+      location.pathname.replace(/^\/+|\/+$/g, '') === 'downloads' ?
+      'downloads' :
+      'history';
+  document.body.dataset['panel'] = kind;
+
+  const title = document.getElementById('title')!;
+  const search = document.getElementById('search') as HTMLInputElement;
+  const ranges = document.getElementById('ranges')!;
+  const list = document.getElementById('list')!;
+  const empty = document.getElementById('empty')!;
+  const sentinel = document.getElementById('sentinel')!;
+  const openPage = document.getElementById('open-as-page')!;
+  const close = document.getElementById('close')!;
+
+  const name = str(kind === 'history' ? 'historyTitle' : 'downloadsTitle');
+  title.textContent = name;
+  document.title = name;
+  list.setAttribute('aria-label', name);
+  const placeholder =
+      str(kind === 'history' ? 'searchHistory' : 'searchDownloads');
+  search.placeholder = placeholder;
+  search.setAttribute('aria-label', placeholder);
+  openPage.textContent = str('openAsPage');
+  close.setAttribute('aria-label', str('closePanel'));
+  close.title = str('closePanel');
+
+  openPage.addEventListener(
+      'click', () => openAsPage(kind, search.value.trim()));
+  close.addEventListener('click', () => closePanel());
+
+  // Pn5: Escape closes an open row menu first, then the panel; the focus
+  // goes back to the page.
+  document.addEventListener('keydown', e => {
+    if (e.key !== 'Escape') {
+      return;
+    }
+    e.preventDefault();
+    if (isMenuOpen()) {
+      closeMenu();
+      return;
+    }
+    closePanel();
+  });
+
+  if (kind === 'history') {
+    new HistoryPanel(search, ranges, list, empty, sentinel);
+  } else {
+    sentinel.remove();
+    new DownloadsPanel(search, list, empty);
+  }
+  search.focus();
+}
+
+start();
diff --git a/chrome/browser/resources/stedding_library/common.ts b/chrome/browser/resources/stedding_library/common.ts
new file mode 100644
index 0000000000000..d57d5f57d4985
--- /dev/null
+++ b/chrome/browser/resources/stedding_library/common.ts
@@ -0,0 +1,173 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// chrome.send rather than Mojo for the panel's few one-way messages, as the
+// welcome page does: the handler is a WebUIMessageHandler beside the
+// Downloads page's Mojo interface, which the panel uses for its list.
+/* eslint-disable no-restricted-properties */
+
+// What both of the sidebar's panels share (docs/features/sidebar-panels.md):
+// the elements, the day headings, the search's pause, the row menu and the
+// panel's handler. Plain DOM, as the archived view is: buttons and fields,
+// so the keyboard and screen readers come from the DOM.
+
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+
+export function el<K extends keyof HTMLElementTagNameMap>(
+    tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  if (className) {
+    node.className = className;
+  }
+  if (text !== undefined) {
+    node.textContent = text;
+  }
+  return node;
+}
+
+export function str(id: string): string {
+  return loadTimeData.getString(id);
+}
+
+export function flag(id: string): boolean {
+  return loadTimeData.getBoolean(id);
+}
+
+// Pn6, Pn9: the search runs this long after the last key.
+export const SEARCH_PAUSE_MS = 250;
+
+// Runs `fn` once `ms` after the last call.
+export function debounce(fn: () => void, ms: number): () => void {
+  let timer = 0;
+  return () => {
+    clearTimeout(timer);
+    timer = setTimeout(fn, ms);
+  };
+}
+
+// The heading of the day `when` falls on: Today, Yesterday, or the date.
+export function dayLabel(when: Date): string {
+  const today = new Date();
+  const yesterday = new Date(today);
+  yesterday.setDate(today.getDate() - 1);
+  if (when.toDateString() === today.toDateString()) {
+    return str('today');
+  }
+  if (when.toDateString() === yesterday.toDateString()) {
+    return str('yesterday');
+  }
+  return when.toLocaleDateString(
+      undefined, {weekday: 'long', month: 'long', day: 'numeric'});
+}
+
+// How a click on a row asks to open its page (Pn7): ⌘- or Ctrl-click and a
+// middle click in a background tab, ⇧-click in a new window, otherwise in
+// the active tab.
+export function openingFor(e: MouseEvent): string {
+  if (e.button === 1 || e.metaKey || e.ctrlKey) {
+    return 'background';
+  }
+  if (e.shiftKey) {
+    return 'window';
+  }
+  return 'current';
+}
+
+export interface MenuItem {
+  action: string;
+  label: string;
+  run: () => void;
+}
+
+// The one row menu, shown under its button or at the pointer.
+let openMenuCleanup: (() => void)|null = null;
+
+export function isMenuOpen(): boolean {
+  return openMenuCleanup !== null;
+}
+
+export function closeMenu() {
+  if (openMenuCleanup) {
+    const cleanup = openMenuCleanup;
+    openMenuCleanup = null;
+    cleanup();
+  }
+}
+
+export function showMenu(
+    items: MenuItem[], x: number, y: number, returnFocus: HTMLElement) {
+  closeMenu();
+  const menu = document.getElementById('menu')!;
+  menu.replaceChildren();
+  for (const item of items) {
+    const button = el('button', 'menu-item', item.label);
+    button.setAttribute('role', 'menuitem');
+    button.dataset['action'] = item.action;
+    button.addEventListener('click', () => {
+      closeMenu();
+      item.run();
+    });
+    menu.append(button);
+  }
+  menu.hidden = false;
+  // Inside the panel, whatever its width.
+  const width = menu.offsetWidth;
+  const height = menu.offsetHeight;
+  const left = Math.max(4, Math.min(x, window.innerWidth - width - 4));
+  const top = y + height + 4 > window.innerHeight ? Math.max(4, y - height) : y;
+  menu.style.left = `${left}px`;
+  menu.style.top = `${top}px`;
+  (menu.firstElementChild as HTMLElement | null)?.focus();
+
+  const onPointer = (e: Event) => {
+    if (!menu.contains(e.target as Node)) {
+      closeMenu();
+    }
+  };
+  const onKey = (e: KeyboardEvent) => {
+    const buttons = Array.from(menu.querySelectorAll<HTMLElement>('button'));
+    const index = buttons.indexOf(document.activeElement as HTMLElement);
+    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+      e.preventDefault();
+      const step = e.key === 'ArrowDown' ? 1 : -1;
+      buttons[(index + step + buttons.length) % buttons.length]?.focus();
+    }
+  };
+  document.addEventListener('pointerdown', onPointer, true);
+  menu.addEventListener('keydown', onKey);
+  openMenuCleanup = () => {
+    document.removeEventListener('pointerdown', onPointer, true);
+    menu.removeEventListener('keydown', onKey);
+    menu.hidden = true;
+    menu.replaceChildren();
+    returnFocus.focus();
+  };
+}
+
+// The "⋯" button that opens a row's menu.
+export function menuButton(items: () => MenuItem[]): HTMLButtonElement {
+  const button = el('button', 'menu-button', '⋯');
+  button.setAttribute('aria-label', str('rowMenu'));
+  button.setAttribute('aria-haspopup', 'menu');
+  button.addEventListener('click', e => {
+    e.stopPropagation();
+    const rect = button.getBoundingClientRect();
+    showMenu(items(), rect.left, rect.bottom, button);
+  });
+  return button;
+}
+
+// Pn7: rows open pages through the panel's handler; the panel itself never
+// navigates.
+export function openUrl(url: string, how: string) {
+  chrome.send('openUrl', [url, how]);
+}
+
+export function closePanel() {
+  chrome.send('closePanel');
+}
+
+export function openAsPage(kind: string, query: string) {
+  chrome.send('openAsPage', [kind, query]);
+}
diff --git a/chrome/browser/resources/stedding_library/downloads_panel.ts b/chrome/browser/resources/stedding_library/downloads_panel.ts
new file mode 100644
index 0000000000000..87f7cca72fb0d
--- /dev/null
+++ b/chrome/browser/resources/stedding_library/downloads_panel.ts
@@ -0,0 +1,334 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The Downloads panel (docs/features/sidebar-panels.md Pn9-Pn12): the
+// Downloads page's own handler and its live list, grouped by day, searched,
+// with the page's verbs and the panel's own (Copy File, Move to Trash). A
+// dangerous download sends the user to the Downloads page, where Chromium's
+// warnings are; the panel bypasses none.
+/* eslint-disable no-restricted-properties */
+
+// eslint-disable-next-line no-restricted-imports
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {getFileIconUrl} from 'chrome://resources/js/icon.js';
+
+import type {MenuItem} from './common.js';
+import {dayLabel, debounce, el, flag, menuButton, openAsPage, SEARCH_PAUSE_MS, showMenu, str} from './common.js';
+import type {BrowserProxy, Data} from './downloads.mojom-webui.js';
+import {browserProxyFactory, DangerType, State} from './downloads.mojom-webui.js';
+
+// Whether `data` waits on the user's decision about its danger: the panel
+// offers nothing but the way to the Downloads page then (Pn12). A file whose
+// deep scan failed is not dangerous to Chromium, but the Downloads page and
+// the bubble open it only from their own warning; the panel had opened it.
+function isDangerous(data: Data): boolean {
+  return data.isDangerous || data.isInsecure ||
+      data.dangerType === DangerType.kDeepScannedFailed ||
+      data.state === State.kDangerous || data.state === State.kInsecure ||
+      data.state === State.kPromptForScanning ||
+      data.state === State.kPromptForLocalPasswordScanning;
+}
+
+function isActive(data: Data): boolean {
+  return data.state === State.kInProgress || data.state === State.kPaused ||
+      data.state === State.kAsyncScanning;
+}
+
+export class DownloadsPanel {
+  private proxy_: BrowserProxy;
+  private items_: Data[] = [];
+  private search_: HTMLInputElement;
+  private list_: HTMLElement;
+  private empty_: HTMLElement;
+  // Ids whose Move to Trash failed: the row says so (Pn11).
+  private trashFailed_ = new Set<string>();
+  private renderPending_ = false;
+  // Pn9: the list comes twenty rows at a time, the next twenty when asked
+  // again with the same terms, as the Downloads page asks while it scrolls.
+  private terms_: string[] = [];
+  private asking_ = false;
+  private mayHaveMore_ = false;
+
+  constructor(search: HTMLInputElement, list: HTMLElement, empty: HTMLElement) {
+    this.search_ = search;
+    this.list_ = list;
+    this.empty_ = empty;
+    this.proxy_ = browserProxyFactory.getInstance();
+    // Pn9: the list follows the downloads as they change.
+    const router = this.proxy_.callbackRouter;
+    router.insertItems.addListener((index: number, items: Data[]) => {
+      // Every request is answered by one insert, empty past the end.
+      if (this.asking_) {
+        this.asking_ = false;
+        this.mayHaveMore_ = items.length > 0;
+      }
+      this.items_.splice(index, 0, ...items);
+      this.scheduleRender_();
+    });
+    router.updateItem.addListener((index: number, data: Data) => {
+      this.items_[index] = data;
+      this.scheduleRender_();
+    });
+    router.removeItem.addListener((index: number) => {
+      this.items_.splice(index, 1);
+      this.scheduleRender_();
+    });
+    router.clearAll.addListener(() => {
+      this.items_ = [];
+      this.scheduleRender_();
+    });
+
+    this.search_.addEventListener(
+        'input', debounce(() => this.query_(), SEARCH_PAUSE_MS));
+    this.list_.addEventListener('scroll', () => this.askForMoreNearEnd_());
+    // The first twenty, for what the field holds now.
+    this.terms_ = this.typedTerms_();
+    this.ask_();
+  }
+
+  private typedTerms_(): string[] {
+    return this.search_.value.trim().split(/\s+/).filter(t => !!t);
+  }
+
+  // Pn9: over the file's name and its address, as the Downloads page
+  // searches. The same terms again ask for the next twenty, so an edit that
+  // leaves them as they were (a space typed after a word) asks nothing: it
+  // added rows under a field that read the same. New terms start the list at
+  // its top, not at the old list's place.
+  private query_() {
+    const terms = this.typedTerms_();
+    if (terms.length === this.terms_.length &&
+        terms.every((term, i) => term === this.terms_[i])) {
+      return;
+    }
+    this.terms_ = terms;
+    this.list_.scrollTop = 0;
+    this.ask_();
+  }
+
+  private ask_() {
+    this.asking_ = true;
+    this.proxy_.handler.getDownloads(this.terms_);
+  }
+
+  // The next rows, while the list is within 200 px of its end: after a
+  // scroll, and after a redraw, as a first chunk that fits the list leaves
+  // nothing to scroll.
+  private askForMoreNearEnd_() {
+    const list = this.list_;
+    if (!this.asking_ && this.mayHaveMore_ &&
+        list.scrollTop + list.clientHeight >= list.scrollHeight - 200) {
+      this.ask_();
+    }
+  }
+
+  private scheduleRender_() {
+    if (this.renderPending_) {
+      return;
+    }
+    this.renderPending_ = true;
+    requestAnimationFrame(() => {
+      this.renderPending_ = false;
+      this.render_();
+      this.askForMoreNearEnd_();
+    });
+  }
+
+  private render_() {
+    // Keep the focus on the row it was on, across the redraw.
+    const focusedId =
+        (document.activeElement?.closest('.row') as HTMLElement | null)
+            ?.dataset['id'];
+    const focusedClass = document.activeElement?.className || '';
+
+    const nodes: HTMLElement[] = [];
+    let day = '';
+    // Newest first, as the list comes.
+    for (const data of this.items_) {
+      const label = dayLabel(new Date(data.started * 1000));
+      if (label !== day) {
+        day = label;
+        nodes.push(el('h2', 'day', day));
+      }
+      nodes.push(this.row_(data));
+    }
+    this.list_.replaceChildren(...nodes);
+    this.empty_.hidden = this.items_.length > 0;
+    this.empty_.textContent =
+        str(this.search_.value.trim() ? 'noDownloadsFound' : 'noDownloads');
+
+    if (focusedId) {
+      const row = this.list_.querySelector<HTMLElement>(
+          `.row[data-id="${CSS.escape(focusedId)}"]`);
+      const target = focusedClass ?
+          row?.querySelector<HTMLElement>(
+              `.${CSS.escape(focusedClass.split(' ')[0] || '')}`) :
+          null;
+      (target || row?.querySelector<HTMLElement>('.row-main'))?.focus();
+    }
+  }
+
+  private row_(data: Data): HTMLElement {
+    const row = el('div', 'row download');
+    row.setAttribute('role', 'listitem');
+    row.dataset['id'] = data.id;
+    row.dataset['state'] = State[data.state] || '';
+    const dangerous = isDangerous(data);
+    const active = isActive(data);
+    const finished = data.state === State.kComplete;
+    const removed = data.fileExternallyRemoved;
+    row.classList.toggle('dangerous', dangerous);
+    row.classList.toggle('removed', finished && removed);
+
+    const main = el('button', 'row-main');
+    main.title = data.filePath || data.fileName;
+    const icon = el('img', 'file-icon');
+    icon.alt = '';
+    if (data.filePath) {
+      icon.src = getFileIconUrl(data.filePath);
+    }
+    const text = el('span', 'text');
+    const title = el('span', 'title', data.fileName);
+    text.append(title);
+    if (dangerous) {
+      text.append(el('span', 'subtitle warning', str('dangerous')));
+    } else if (active) {
+      text.append(el('span', 'subtitle', data.progressStatusText));
+      const progress = el('progress', 'progress');
+      progress.max = 100;
+      if (data.percent >= 0) {
+        progress.value = data.percent;
+      }
+      text.append(progress);
+    } else if (finished && removed) {
+      text.append(el('span', 'subtitle', str('fileRemoved')));
+    } else if (finished && this.trashFailed_.has(data.id)) {
+      text.append(el('span', 'subtitle warning', str('trashFailed')));
+    } else if (finished) {
+      text.append(el('span', 'subtitle', data.sinceString || data.dateString));
+    } else {
+      // Cancelled or interrupted: the reason, as the Downloads page says it.
+      text.append(el('span', 'subtitle', data.lastReasonText));
+    }
+    main.append(icon, text);
+    row.append(main);
+
+    if (dangerous) {
+      // Pn12: one action, the page where the warning's choices are.
+      const review =
+          el('button', 'text-button review', str('reviewInDownloads'));
+      review.dataset['action'] = 'review';
+      review.addEventListener('click', () => openAsPage('downloads', ''));
+      row.append(review);
+      return row;
+    }
+
+    const handler = this.proxy_.handler;
+    if (finished && !removed) {
+      // Pn9: a click opens the file; Pn12: the row drags out as the file.
+      main.addEventListener('click', () => {
+        handler.openFileRequiringGesture(data.id);
+      });
+      row.draggable = true;
+      row.addEventListener('dragstart', e => {
+        e.preventDefault();
+        handler.drag(data.id);
+      });
+    }
+    if (active) {
+      const paused = data.state === State.kPaused;
+      if (paused ? data.resume : data.state === State.kInProgress) {
+        const toggle =
+            el('button', 'icon-button pause', paused ? '▶' : '⏸');
+        toggle.dataset['action'] = paused ? 'resume' : 'pause';
+        toggle.setAttribute('aria-label', str(paused ? 'resume' : 'pause'));
+        toggle.title = str(paused ? 'resume' : 'pause');
+        toggle.addEventListener('click', () => {
+          if (paused) {
+            handler.resume(data.id);
+          } else {
+            handler.pause(data.id);
+          }
+        });
+        row.append(toggle);
+      }
+      const cancel = el('button', 'icon-button cancel', '✕');
+      cancel.dataset['action'] = 'cancel';
+      cancel.setAttribute('aria-label', str('cancel'));
+      cancel.title = str('cancel');
+      cancel.addEventListener('click', () => handler.cancel(data.id));
+      row.append(cancel);
+      return row;
+    }
+
+    const items = () => this.menuItems_(data);
+    row.addEventListener('contextmenu', e => {
+      e.preventDefault();
+      showMenu(items(), e.clientX, e.clientY, main);
+    });
+    row.append(menuButton(items));
+    return row;
+  }
+
+  private menuItems_(data: Data): MenuItem[] {
+    const handler = this.proxy_.handler;
+    const items: MenuItem[] = [];
+    const finished = data.state === State.kComplete;
+    const present = finished && !data.fileExternallyRemoved;
+    if (present) {
+      items.push(
+          {
+            action: 'open',
+            label: str('open'),
+            run: () => handler.openFileRequiringGesture(data.id),
+          },
+          {
+            action: 'copy-file',
+            label: str('copyFile'),
+            run: () => sendWithPromise<boolean>('copyFile', data.id),
+          },
+          {
+            action: 'show',
+            label: str('showInFolder'),
+            run: () => handler.show(data.id),
+          });
+      if (flag('canTrash')) {
+        items.push({
+          action: 'trash',
+          label: str('moveToTrash'),
+          run: () => this.trash_(data.id),
+        });
+      }
+    }
+    if (data.retry) {
+      items.push({
+        action: 'retry',
+        label: str('retry'),
+        run: () => handler.retryDownload(data.id),
+      });
+    }
+    // As the Downloads page: only where the profile may delete history.
+    // Chromium forgets the row for good when the panel closes.
+    if (flag('allowDeletingHistory')) {
+      items.push({
+        action: 'remove',
+        label: str('removeFromList'),
+        run: () => handler.remove(data.id),
+      });
+    }
+    return items;
+  }
+
+  // Pn11: the file to the Trash; the row stays and reads as deleted once
+  // the downloads have looked for it again, or says the move failed.
+  private async trash_(id: string) {
+    const moved = await sendWithPromise<boolean>('moveToTrash', id);
+    if (moved) {
+      this.trashFailed_.delete(id);
+    } else {
+      this.trashFailed_.add(id);
+      this.scheduleRender_();
+    }
+  }
+}
diff --git a/chrome/browser/resources/stedding_library/history_panel.ts b/chrome/browser/resources/stedding_library/history_panel.ts
new file mode 100644
index 0000000000000..83176334b57bb
--- /dev/null
+++ b/chrome/browser/resources/stedding_library/history_panel.ts
@@ -0,0 +1,240 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The History panel (docs/features/sidebar-panels.md Pn6, Pn7): the History
+// page's own handler queried fifty rows at a time, grouped by day, searched
+// and narrowed to a range. Icons come from the local favicon cache alone
+// (Pn8).
+/* eslint-disable no-restricted-properties */
+
+import type {HistoryEntry, PageHandlerRemote} from 'chrome://resources/cr_components/history/history.mojom-webui.js';
+import {PageCallbackRouter, PageHandler} from 'chrome://resources/cr_components/history/history.mojom-webui.js';
+// eslint-disable-next-line no-restricted-imports
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {getFaviconForPageURL} from 'chrome://resources/js/icon.js';
+
+import type {MenuItem} from './common.js';
+import {debounce, el, flag, menuButton, openingFor, openUrl, SEARCH_PAUSE_MS, showMenu, str} from './common.js';
+
+// Pn6: rows per page of the query.
+const PAGE_SIZE = 50;
+const RANGES = ['all', 'today', 'week', 'month'];
+const RANGE_LABELS: {[range: string]: string} = {
+  all: 'rangeAll',
+  today: 'rangeToday',
+  week: 'rangeWeek',
+  month: 'rangeMonth',
+};
+
+export class HistoryPanel {
+  private handler_: PageHandlerRemote;
+  private router_ = new PageCallbackRouter();
+  private entries_: HistoryEntry[] = [];
+  private finished_ = false;
+  private loading_ = false;
+  // Counts the queries, so the answer to an older one is dropped.
+  private generation_ = 0;
+  private range_ = 'all';
+  private search_: HTMLInputElement;
+  private list_: HTMLElement;
+  private empty_: HTMLElement;
+  private sentinel_: HTMLElement;
+
+  constructor(
+      search: HTMLInputElement, ranges: HTMLElement, list: HTMLElement,
+      empty: HTMLElement, sentinel: HTMLElement) {
+    this.search_ = search;
+    this.list_ = list;
+    this.empty_ = empty;
+    this.sentinel_ = sentinel;
+    this.handler_ = PageHandler.getRemote();
+    this.handler_.setPage(this.router_.$.bindNewPipeAndPassRemote());
+    this.router_.onHistoryDeleted.addListener(
+        () => this.query_(/*keepPlace=*/ true));
+
+    this.search_.addEventListener(
+        'input', debounce(() => this.query_(), SEARCH_PAUSE_MS));
+
+    for (const range of RANGES) {
+      const chip = el('button', 'chip', str(RANGE_LABELS[range]!));
+      chip.dataset['range'] = range;
+      chip.setAttribute('aria-pressed', String(range === this.range_));
+      chip.addEventListener('click', () => {
+        this.range_ = range;
+        for (const other of ranges.querySelectorAll<HTMLElement>('.chip')) {
+          other.setAttribute(
+              'aria-pressed', String(other.dataset['range'] === range));
+        }
+        this.query_();
+      });
+      ranges.append(chip);
+    }
+    ranges.hidden = false;
+
+    // Pn6: the next fifty load as the list nears its end.
+    const observer = new IntersectionObserver(entries => {
+      if (entries.some(entry => entry.isIntersecting)) {
+        this.more_();
+      }
+    }, {root: this.list_, rootMargin: '0px 0px 200px 0px'});
+    observer.observe(this.sentinel_);
+    // The list's own scroll asks too: the observer waits for a frame, and a
+    // scroll to the end in a busy moment went unanswered.
+    this.list_.addEventListener('scroll', () => {
+      if (this.nearEnd_()) {
+        this.more_();
+      }
+    });
+
+    this.query_();
+  }
+
+  // A new search or range starts at the top of its list; history deleted
+  // elsewhere, which asks again for the same list, keeps the reader's place.
+  private async query_(keepPlace = false) {
+    const generation = ++this.generation_;
+    this.loading_ = true;
+    const beginTime =
+        await sendWithPromise<number|null>('rangeStart', this.range_);
+    if (generation !== this.generation_) {
+      return;
+    }
+    const {results} = await this.handler_.queryHistory(
+        this.search_.value.trim(), PAGE_SIZE, beginTime,
+        /*includeUserVisits=*/ true, /*includeActorVisits=*/ false);
+    if (generation !== this.generation_) {
+      return;
+    }
+    this.entries_ = results.value;
+    this.finished_ = !results.info || results.info.finished;
+    this.loading_ = false;
+    this.render_();
+    if (!keepPlace) {
+      this.list_.scrollTop = 0;
+    }
+    // A first page that fits the list leaves no scroll, and the observer
+    // had its look while this page loaded: the next one comes now.
+    if (this.nearEnd_()) {
+      this.more_();
+    }
+  }
+
+  private async more_() {
+    if (this.loading_ || this.finished_ || this.entries_.length === 0) {
+      return;
+    }
+    const generation = this.generation_;
+    this.loading_ = true;
+    const {results} = await this.handler_.queryHistoryContinuation();
+    if (generation !== this.generation_) {
+      return;
+    }
+    this.entries_ = this.entries_.concat(results.value);
+    this.finished_ = !results.info || results.info.finished;
+    this.loading_ = false;
+    this.render_();
+    // Still at the end, as after a scroll made while this page loaded: the
+    // next one comes too.
+    if (this.nearEnd_()) {
+      this.more_();
+    }
+  }
+
+  // Pn6: whether the list is within 200 px of its end.
+  private nearEnd_(): boolean {
+    const list = this.list_;
+    return list.scrollTop + list.clientHeight >= list.scrollHeight - 200;
+  }
+
+  private render_() {
+    const groups: HTMLElement[] = [];
+    let day = '';
+    for (const entry of this.entries_) {
+      if (entry.dateRelativeDay !== day) {
+        day = entry.dateRelativeDay;
+        const heading = el('h2', 'day', day);
+        groups.push(heading);
+      }
+      groups.push(this.row_(entry));
+    }
+    this.list_.replaceChildren(...groups, this.sentinel_);
+    this.empty_.hidden = this.entries_.length > 0;
+    this.empty_.textContent =
+        str(this.search_.value.trim() ? 'noHistoryFound' : 'noHistory');
+  }
+
+  private row_(entry: HistoryEntry): HTMLElement {
+    const row = el('div', 'row');
+    row.setAttribute('role', 'listitem');
+    row.dataset['url'] = entry.url;
+
+    const main = el('button', 'row-main');
+    main.title = entry.url;
+    const icon = el('span', 'favicon');
+    icon.style.backgroundImage =
+        getFaviconForPageURL(entry.url, /*isSyncedUrlForHistoryUi=*/ false);
+    const text = el('span', 'text');
+    text.append(
+        el('span', 'title', entry.title || entry.url),
+        el('span', 'subtitle', entry.domain));
+    main.append(icon, text, el('span', 'time', entry.dateTimeOfDay));
+    main.addEventListener('click', e => {
+      openUrl(entry.url, openingFor(e));
+    });
+    // A middle click.
+    main.addEventListener('auxclick', e => {
+      if (e.button === 1) {
+        e.preventDefault();
+        openUrl(entry.url, 'background');
+      }
+    });
+    main.addEventListener('mousedown', e => {
+      // No scrolling by the wheel's button.
+      if (e.button === 1) {
+        e.preventDefault();
+      }
+    });
+
+    const items = () => this.menuItems_(entry);
+    row.addEventListener('contextmenu', e => {
+      e.preventDefault();
+      showMenu(items(), e.clientX, e.clientY, main);
+    });
+    row.append(main, menuButton(items));
+    return row;
+  }
+
+  private menuItems_(entry: HistoryEntry): MenuItem[] {
+    const items: MenuItem[] = [
+      {
+        action: 'open',
+        label: str('open'),
+        run: () => openUrl(entry.url, 'current'),
+      },
+      {
+        action: 'open-in-new-tab',
+        label: str('openInNewTab'),
+        run: () => openUrl(entry.url, 'background'),
+      },
+    ];
+    // Pn7: as the History page, only where the profile may delete history.
+    if (flag('allowDeletingHistory')) {
+      items.push({
+        action: 'remove',
+        label: str('remove'),
+        run: () => this.remove_(entry),
+      });
+    }
+    return items;
+  }
+
+  // Pn7: the row's visits of that day go, and the row with them.
+  private async remove_(entry: HistoryEntry) {
+    const removals = Object.entries(entry.allTimestamps)
+                         .map(([url, timestamps]) => ({url, timestamps}));
+    await this.handler_.removeVisits(removals);
+    this.entries_ = this.entries_.filter(other => other !== entry);
+    this.render_();
+  }
+}
