+std::unique_ptr<net::test_server::HttpResponse> AnswerWith(
+    FakePlace* place,
+    const bool* hang,
+    const net::test_server::HttpRequest& request) {
+  if (*hang) {
+    return std::make_unique<net::test_server::HungResponse>();
+  }
+  std::map<std::string, std::string> headers;
+  for (const auto& [name, value] : request.headers) {
+    headers[base::ToLowerASCII(name)] = value;
+  }
+  // The address the request was sent to, as a signature covers it.
+  const GURL url(base::StrCat({"http://", headers["host"],
+                               request.relative_url}));
+  const FakePlace::Reply reply =
+      place->Handle(request.method_string, url, headers, request.content);
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_code(static_cast<net::HttpStatusCode>(reply.status));
+  response->set_content(reply.body);
+  for (const auto& [name, value] : reply.headers) {
+    response->AddCustomHeader(name, value);
+  }
+  return response;
+}
