+  EXPECT_NE(ChordText(IDC_FOCUS_SEARCH), chord);
+  bool listed = false;
+  bool diverges = false;
+  for (const ShortcutGroup& group : ShortcutReference()) {
+    for (const ShortcutRow& row : group.rows) {
+      if (row.chord != chord) {
+        continue;
+      }
+      if (row.chromium.empty()) {
+        listed |= row.what.starts_with(u"Run an extension");
+      } else {
+        diverges |= row.chromium.find(u"Use Selection for Find") !=
+                    std::u16string::npos;
