+TEST_F(TabStripModelTest, MoveFolderIntoRefusesItsOwnTreeAndPastTheDepthCap) {
+  PrepareTabs(tabstrip(), 3);
+  tabs::TabInterface* const x = tabstrip()->GetTabAtIndex(0);
+  tabs::TabInterface* const y = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const z = tabstrip()->GetTabAtIndex(2);
+  // D1[D2[D3[D4[x]]]], P1[P2[y]], S[z]: the command on a tab already in a
+  // folder nests a new one around it.
+  tabs::FolderTabCollection* const d1 = tabstrip()->AddToNewFolder({0});
+  tabs::FolderTabCollection* const d2 = tabstrip()->AddToNewFolder({0});
+  tabs::FolderTabCollection* const d3 = tabstrip()->AddToNewFolder({0});
+  tabs::FolderTabCollection* const d4 = tabstrip()->AddToNewFolder({0});
+  tabs::FolderTabCollection* const p1 = tabstrip()->AddToNewFolder({1});
+  tabs::FolderTabCollection* const p2 = tabstrip()->AddToNewFolder({1});
+  tabs::FolderTabCollection* const single = tabstrip()->AddToNewFolder({2});
+  ASSERT_TRUE(d1 && d2 && d3 && d4 && p1 && p2 && single);
+  ASSERT_EQ(d3, d4->GetParentCollection());
+  ASSERT_EQ(d4, x->GetParentCollection());
+  ASSERT_EQ(p1, p2->GetParentCollection());
+  tabs::TabCollection* const top = d1->GetParentCollection();
+  ASSERT_EQ(top, p1->GetParentCollection());
+  ASSERT_EQ(top, single->GetParentCollection());
