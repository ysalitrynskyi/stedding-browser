+// commandbar K18 (BACKLOG S-352): the extension whose omnibox keyword starts
+// `text`, when it may hear it in `profile`, and the query after the keyword,
+// read as the address field reads "keyword query".
+const TemplateURL* ExtensionKeywordFor(TemplateURLService* service,
+                                       Profile* profile,
+                                       std::u16string_view text,
+                                       std::u16string* query) {
+  const stedding::ExtensionKeywordHandler* const handler =
+      stedding::GetExtensionKeywordHandler();
+  const size_t space = text.find(u' ');
+  if (!service || !handler || space == std::u16string_view::npos ||
+      space == 0 || space + 1 == text.size()) {
+    return nullptr;
+  }
+  const TemplateURL* const keyword =
+      service->GetTemplateURLForKeyword(std::u16string(text.substr(0, space)));
+  if (!keyword || keyword->type() != TemplateURL::OMNIBOX_API_EXTENSION ||
+      !handler->can_hand_over(profile, keyword->GetExtensionId())) {
+    return nullptr;
+  }
+  *query = std::u16string(text.substr(space + 1));
+  return keyword;
+}
