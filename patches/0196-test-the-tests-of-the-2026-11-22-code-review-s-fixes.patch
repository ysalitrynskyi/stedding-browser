+// P26-1e (sidebar Y1, Y2; settings T41-T43): a process whose only window is
+// private has no Space model, and still reads the sidebar's density and text
+// size and the window's look from local state, and follows a change to them.
+// They stayed at their static defaults: the plain label font, not 14, and
+// whatever density and window colour Settings named.
+IN_PROC_BROWSER_TEST_F(SidebarMetricsPrivateW2B20Test,
+                       APrivateOnlyProcessReadsAndFollowsTheSidebarSettings) {
+  ASSERT_TRUE(browser()->GetProfile()->IsOffTheRecord());
+  ASSERT_FALSE(spaces::SpaceModel::From(browser()))
+      << "a private window has no Space model";
+  PrefService* const local_state = g_browser_process->local_state();
+  ASSERT_TRUE(local_state);
+
+  // Y2: unset, the sidebar's text is 14.
+  EXPECT_EQ(stedding::prefs::kSidebarTextSizeDefault,
+            stedding::GetSidebarTextSize())
+      << "the text size was never read";
+
+  local_state->SetInteger(stedding::prefs::kSidebarTextSize, 12);
+  EXPECT_EQ(12, stedding::GetSidebarTextSize())
+      << "a change of the text size was not followed";
+
+  local_state->SetInteger(
+      stedding::prefs::kSidebarDensity,
+      static_cast<int>(stedding::SidebarDensity::kCompact));
+  EXPECT_EQ(stedding::SidebarDensity::kCompact, stedding::GetSidebarDensity())
+      << "a change of the density was not followed";
+
+  local_state->SetInteger(
+      stedding::prefs::kWindowColour,
+      static_cast<int>(stedding::WindowColour::kNeutral));
+  EXPECT_EQ(stedding::WindowColour::kNeutral,
+            stedding::GetWindowLook().colour)
+      << "a change of the window colour was not followed";
+}
+
+// ---------------------------------------------------------------------------
+// Escape with a modifier in a sidebar panel.
+
+class PanelEscapeW2B20Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void TearDownOnMainThread() override {
+    // Shift+Esc opens the task manager on Windows; it is not left open.
+    chrome::HideTaskManager();
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* window() { return browser_view()->GetWidget(); }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  stedding::SidebarPanelView* panel_view() {
+    return region()->sidebar_panel_view_for_testing();
+  }
+  content::WebContents* panel_page() {
+    return panel_view() ? panel_view()->web_view()->GetWebContents() : nullptr;
+  }
+  void Layout() { views::test::RunScheduledLayout(window()); }
+
+  // Waits until `panel` is the one in the sidebar's column -- none for
+  // kNone -- and its page has built itself.
+  [[nodiscard]] bool WaitForPanel(stedding::SidebarPanel panel) {
+    if (!base::test::RunUntil([&]() {
+          Layout();
+          stedding::SidebarPanelView* const view = panel_view();
+          return panel == stedding::SidebarPanel::kNone
+                     ? view == nullptr
+                     : view != nullptr && view->panel() == panel;
+        })) {
+      return false;
+    }
+    if (panel == stedding::SidebarPanel::kNone) {
+      return true;
+    }
+    content::WebContents* const page = panel_page();
+    if (!content::WaitForLoadStop(page)) {
+      return false;
+    }
+    return base::test::RunUntil([&]() {
+      return content::EvalJs(page, "document.body.dataset.panel || ''")
+                 .ExtractString() != "";
+    });
+  }
+
+  // Whether the History panel is still the one in the column.
+  bool HistoryStillOpen() {
+    Layout();
+    return panel_view() &&
+           panel_view()->panel() == stedding::SidebarPanel::kHistory;
+  }
+
+  // Lets `delay` pass, for a change that should not come.
+  static void Pause(base::TimeDelta delay) {
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, run_loop.QuitClosure(), delay);
+    run_loop.Run();
+  }
+
+#if BUILDFLAG(IS_WIN)
+  // Whether Chromium's task manager is open and measuring.
+  static bool TaskManagerRuns() {
+    return task_manager::TaskManagerImpl::IsCreated() &&
+           task_manager::TaskManagerImpl::GetInstance()->is_running();
+  }
+#endif
+};
+
+// P26-1f (sidebar-panels Pn1, Pn5): with the focus in the History panel's
+// search field, Shift+Esc is no Escape for the panel: the page leaves it
+// untaken, the panel stays open, and the chord reaches the window, which on
+// Windows opens the task manager as it does from a tab. A plain Escape still
+// closes the panel. Every Escape closed it, whatever the modifiers.
+IN_PROC_BROWSER_TEST_F(PanelEscapeW2B20Test,
+                       ShiftEscapeInAPanelIsTheWindowsNotThePanels) {
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(stedding::SidebarPanel::kHistory));
+  content::WebContents* page = panel_page();
+  ASSERT_TRUE(page);
+  // The panel's page goes when an Escape closes the panel.
+  base::WeakPtr<content::WebContents> alive = page->GetWeakPtr();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, "document.activeElement?.id || ''")
+               .ExtractString() == "search";
+  })) << "the search field does not have the focus";
+
+  // Each Escape the page sees, and whether a handler before this one took it.
+  ASSERT_TRUE(content::ExecJs(page, R"(
+      window.escapesSeenW2B20 = [];
+      document.addEventListener('keydown', e => {
+        if (e.key === 'Escape') {
+          window.escapesSeenW2B20.push(e.defaultPrevented);
+        }
+      });)"));
+  const auto escapes_seen = [&]() {
+    return content::EvalJs(page, "window.escapesSeenW2B20.length")
+        .ExtractInt();
+  };
+  const auto escape_taken = [&](int i) {
+    return content::EvalJs(page, content::JsReplace(
+                                     "window.escapesSeenW2B20[$1]", i))
+        .ExtractBool();
+  };
+
+  // Shift+Esc as the page gets it.
+  [&] {
+    SCOPED_TRACE("Shift+Esc in the page");
+    content::SimulateEndOfPaintHoldingOnPrimaryMainFrame(page);
+    content::SimulateKeyPress(page, ui::DomKey::ESCAPE, ui::DomCode::ESCAPE,
+                              ui::VKEY_ESCAPE, /*control=*/false,
+                              /*shift=*/true, /*alt=*/false,
+                              /*command=*/false);
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return !alive || escapes_seen() == 1; }));
+    ASSERT_TRUE(alive) << "Shift+Esc closed the panel";
+    EXPECT_FALSE(escape_taken(0)) << "the page took Shift+Esc as an Escape";
+    Pause(base::Milliseconds(500));
+    EXPECT_TRUE(HistoryStillOpen()) << "Shift+Esc closed the panel";
+  }();
+  ASSERT_TRUE(alive) << "Shift+Esc closed the panel and its page";
+
+  // A plain Escape is still the panel's (Pn5).
+  [&] {
+    SCOPED_TRACE("a plain Escape in the page");
+    ASSERT_TRUE(HistoryStillOpen());
+    content::SimulateKeyPress(page, ui::DomKey::ESCAPE, ui::DomCode::ESCAPE,
+                              ui::VKEY_ESCAPE, /*control=*/false,
+                              /*shift=*/false, /*alt=*/false,
+                              /*command=*/false);
+    EXPECT_TRUE(WaitForPanel(stedding::SidebarPanel::kNone))
+        << "a plain Escape left the panel open";
+  }();
+
+#if !BUILDFLAG(IS_MAC)
+  // Shift+Esc as the page leaves it, the way it comes back from the page to
+  // the panel's delegate. content's SimulateKeyPress marks its keys to be
+  // dropped when the page does not take them, so they never come back. The
+  // Mac's chords come through the menu bar, not this path.
+  [&] {
+    SCOPED_TRACE("Shift+Esc the page did not take");
+    ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+    ASSERT_TRUE(WaitForPanel(stedding::SidebarPanel::kHistory));
+    page = panel_page();
+    ASSERT_TRUE(page);
+    ASSERT_TRUE(page->GetDelegate());
+    input::NativeWebKeyboardEvent shift_escape(
+        blink::WebInputEvent::Type::kRawKeyDown,
+        blink::WebInputEvent::kShiftKey, base::TimeTicks::Now());
+    shift_escape.windows_key_code = ui::VKEY_ESCAPE;
+    shift_escape.dom_key = ui::DomKey::ESCAPE;
+    shift_escape.dom_code = static_cast<int>(ui::DomCode::ESCAPE);
+    page->GetDelegate()->HandleKeyboardEvent(page, shift_escape);
+#if BUILDFLAG(IS_WIN)
+    // Windows' Shift+Esc is the task manager's (accelerator_table.cc).
+    EXPECT_TRUE(base::test::RunUntil([&]() { return TaskManagerRuns(); }))
+        << "Shift+Esc in the panel did not reach the window";
+#endif
+    Pause(base::Milliseconds(500));
+    EXPECT_TRUE(HistoryStillOpen())
+        << "Shift+Esc the page did not take closed the panel";
+  }();
+#endif  // !BUILDFLAG(IS_MAC)
+}
