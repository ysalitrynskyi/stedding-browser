+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace stedding::shortcuts {
+namespace {
+
+Chord CtrlAltB20(ui::KeyboardCode key) {
+  return Chord(key, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN);
+}
+
+Chord CtrlAltShiftB20(ui::KeyboardCode key) {
+  return Chord(key, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN);
+}
+
+// A shipped table of the test's own, the same on every platform.
+std::vector<Binding> TableB20() {
+  return {
+      {IDC_NEW_TAB, CtrlAltB20(ui::VKEY_T)},
+      {IDC_STEDDING_CLEAR_SPACE, CtrlAltB20(ui::VKEY_K)},
+      {IDC_SELECT_TAB_0, CtrlAltB20(ui::VKEY_1)},
+      {IDC_SELECT_TAB_1, CtrlAltB20(ui::VKEY_2)},
+      {IDC_SELECT_LAST_TAB, CtrlAltB20(ui::VKEY_9)},
+      {IDC_CYCLE_TO_NEXT_TAB, Chord(ui::VKEY_TAB, ui::EF_CONTROL_DOWN)},
+      {IDC_CYCLE_TO_PREV_TAB,
+       Chord(ui::VKEY_TAB, ui::EF_CONTROL_DOWN | ui::EF_SHIFT_DOWN)},
+      {IDC_CLOSE_WINDOW, CtrlAltB20(ui::VKEY_W)},
+  };
+}
+
+const Entry& RowB20(const char* name) {
+  const Entry* const entry = EntryForName(name);
+  CHECK(entry) << name;
+  return *entry;
+}
+
+bool HasB20(const std::vector<Chord>& chords, const Chord& chord) {
+  return std::ranges::find(chords, chord) != chords.end();
+}
+
+// The commands that have `chord` in `table`, each once.
+std::vector<int> HoldersOfB20(const std::vector<Binding>& table,
+                              const Chord& chord) {
+  std::vector<int> commands;
+  for (const Binding& binding : table) {
+    if (binding.chord == chord &&
+        std::ranges::find(commands, binding.command) == commands.end()) {
+      commands.push_back(binding.command);
+    }
+  }
+  return commands;
+}
+
+class ShortcutEditorB20Test : public testing::Test {
+ protected:
+  base::DictValue stored_;
+  ShortcutEditor editor_{stored_, TableB20()};
+};
+
+// P26-1c, Z17, Z23: while the row numbers are on, no other row may hold
+// their keys. A chord given to a row while they were off goes back to them
+// when they are turned on, and comes back to the row when they are off
+// again. In the shipped layout the row kept it, and the row numbers' range
+// named a key that went elsewhere.
+TEST_F(ShortcutEditorB20Test, RowNumbersTurnedOnTakeBackAChordGivenWhileOff) {
+  ASSERT_TRUE(editor_.SetOff(RowB20("tab-by-number"), true));
+  ASSERT_EQ(CheckKind::kOk,
+            editor_
+                .Add(RowB20("new-tab"), CtrlAltB20(ui::VKEY_1),
+                     /*replace=*/false)
+                .kind)
+      << "free while the row numbers are off";
+  const std::vector<Chord> both = {CtrlAltB20(ui::VKEY_T),
+                                   CtrlAltB20(ui::VKEY_1)};
+  ASSERT_EQ(both, editor_.StateOf(RowB20("new-tab")).chords);
+
+  ASSERT_TRUE(editor_.SetOff(RowB20("tab-by-number"), false));
+  EXPECT_EQ(std::vector<Chord>{CtrlAltB20(ui::VKEY_T)},
+            editor_.StateOf(RowB20("new-tab")).chords)
+      << "the row numbers have it again";
+  const CheckResult check =
+      editor_.Check(RowB20("clear-space"), CtrlAltB20(ui::VKEY_1));
+  EXPECT_EQ(CheckKind::kRefused, check.kind)
+      << base::UTF16ToUTF8(check.message);
+  EXPECT_EQ(&RowB20("tab-by-number"), check.other.get());
+
+  ASSERT_TRUE(editor_.SetOff(RowB20("tab-by-number"), true));
+  EXPECT_EQ(both, editor_.StateOf(RowB20("new-tab")).chords)
+      << "the row kept it for when the row numbers are off";
+}
+
+// P26-1b, Z12, Z18: Most Recent Tab's chord with Shift is the way back, and
+// must be free too. A chord another row has, whose Shift twin a third row
+// has, is refused before Replace is offered: Replace took the Shift twin
+// from that third row without naming it.
+TEST_F(ShortcutEditorB20Test, RecentTabRefusesAChordWhoseShiftTwinIsTaken) {
+  std::vector<Binding> defaults = TableB20();
+  defaults.push_back({IDC_RESTORE_TAB, CtrlAltShiftB20(ui::VKEY_K)});
+  base::DictValue stored;
+  ShortcutEditor editor(stored, defaults);
+
+  const CheckResult check =
+      editor.Check(RowB20("recent-tab"), CtrlAltB20(ui::VKEY_K));
+  EXPECT_EQ(CheckKind::kRefused, check.kind)
+      << base::UTF16ToUTF8(check.message);
+  EXPECT_EQ(&RowB20("reopen-closed-tab"), check.other.get());
+  EXPECT_NE(std::u16string::npos,
+            check.message.find(RowB20("reopen-closed-tab").label))
+      << base::UTF16ToUTF8(check.message);
+
+  EXPECT_EQ(CheckKind::kRefused,
+            editor
+                .Add(RowB20("recent-tab"), CtrlAltB20(ui::VKEY_K),
+                     /*replace=*/true)
+                .kind);
+  EXPECT_TRUE(stored.empty()) << "nothing written";
+  EXPECT_EQ(std::vector<Chord>{CtrlAltShiftB20(ui::VKEY_K)},
+            editor.StateOf(RowB20("reopen-closed-tab")).chords);
+  EXPECT_EQ(std::vector<Chord>{CtrlAltB20(ui::VKEY_K)},
+            editor.StateOf(RowB20("clear-space")).chords);
+}
+
+// P26-1b, Z16, Z18: the same when the Shift twin is a fixed row's: Replace
+// on Most Recent Tab took a chord of "Close the window", which keeps its
+// keys.
+TEST_F(ShortcutEditorB20Test, RecentTabCannotTakeAFixedRowsShiftChord) {
+  std::vector<Binding> defaults = TableB20();
+  defaults.push_back({IDC_CLOSE_WINDOW, CtrlAltShiftB20(ui::VKEY_T)});
+  base::DictValue stored;
+  ShortcutEditor editor(stored, defaults);
+
+  const CheckResult check =
+      editor.Check(RowB20("recent-tab"), CtrlAltB20(ui::VKEY_T));
+  EXPECT_EQ(CheckKind::kRefused, check.kind)
+      << base::UTF16ToUTF8(check.message);
+  EXPECT_EQ(&RowB20("close-window"), check.other.get());
+
+  EXPECT_EQ(CheckKind::kRefused,
+            editor
+                .Add(RowB20("recent-tab"), CtrlAltB20(ui::VKEY_T),
+                     /*replace=*/true)
+                .kind);
+  EXPECT_EQ((std::vector<Chord>{CtrlAltB20(ui::VKEY_W),
+                                CtrlAltShiftB20(ui::VKEY_T)}),
+            editor.StateOf(RowB20("close-window")).chords);
+  EXPECT_EQ(std::vector<Chord>{CtrlAltB20(ui::VKEY_T)},
+            editor.StateOf(RowB20("new-tab")).chords);
+}
+
+class ShortcutServiceB20Test : public testing::Test {
+ protected:
+  void SetUp() override {
+    prefs::RegisterLocalStatePrefs(local_state_.registry());
+    EnsureShortcutsInstalled(&local_state_);
+  }
+  void TearDown() override {
+    StopWatchingShortcuts();
+    SetCurrent(UserShortcuts());
+  }
+
+  TestingPrefServiceSimple local_state_;
+};
+
+// P26-1c, Z11, Z17: the same through the service and this platform's
+// shipped tables: once the row numbers are on again, the table in force
+// gives their first chord to them alone, and the row that was given it shows
+// it no more.
+TEST_F(ShortcutServiceB20Test, TheTableInForceGivesTheRowNumbersTheirChord) {
+  const Entry& numbers = RowB20("tab-by-number");
+  const Entry& next = RowB20("next-tab");
+  const std::vector<Chord> row_one = DefaultChordsFor(IDC_SELECT_TAB_0);
+  ASSERT_FALSE(row_one.empty());
+  const Chord chord = row_one.front();
+
+  ASSERT_TRUE(SetShortcutOff(&local_state_, numbers, true));
+  ASSERT_EQ(CheckKind::kOk, AddShortcut(&local_state_, next, chord,
+                                        /*replace=*/false, OutsideHolders())
+                                .kind);
+  ASSERT_EQ(IDC_SELECT_NEXT_TAB, Current().CommandFor(chord));
+
+  ASSERT_TRUE(SetShortcutOff(&local_state_, numbers, false));
+  const std::vector<Binding> table = Apply(DefaultBindings(), Current());
+  EXPECT_EQ(std::vector<int>{IDC_SELECT_TAB_0}, HoldersOfB20(table, chord))
+      << ChordToString(chord);
+  EXPECT_FALSE(HasB20(RowStateOf(&local_state_, next).chords, chord));
+
+  ASSERT_TRUE(SetShortcutOff(&local_state_, numbers, true));
+  EXPECT_EQ(IDC_SELECT_NEXT_TAB, Current().CommandFor(chord))
+      << "kept for when the row numbers are off";
+}
+
+}  // namespace
+}  // namespace stedding::shortcuts
