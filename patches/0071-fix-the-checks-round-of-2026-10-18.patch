@@ -0,0 +1,102 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The product's name reaches every language the browser ships (docs/features/
+// windows.md N4): tooling/brand/product_name.py rewrites "Chromium" in the
+// branded string tables, and in every locale's translations of them, before
+// the build. A Windows shortcut and a German dialog said "Chromium" while it
+// rewrote the English tables alone (until 2026-09-09); and since grit finds a
+// translation by a fingerprint of the English text, a rewritten English
+// message lost its translations, and every language read it in English:
+// "About Stedding" in a German menu (until 2026-10-18).
+
+#include <array>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/strings/string_util.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/grit/branded_strings.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/strings/grit/components_branded_strings.h"
+#include "content/public/test/browser_test.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/resource/resource_bundle.h"
+
+namespace {
+
+using ProductNameTest = InProcessBrowserTest;
+
+// Strings a person meets that name the product, from the browser's branded
+// table and the components' one, and whether every language translates them:
+// the copyright line may stay as it is.
+struct NamingString {
+  int id;
+  bool translated;
+};
+constexpr auto kNamingStrings = std::to_array<NamingString>({
+    {IDS_DEFAULT_BROWSER_INFOBAR_TEXT, true},
+    {IDS_ERRORPAGES_SUMMARY_BLOCKED_BY_CLIENT, true},
+    {IDS_ABOUT_VERSION_COPYRIGHT, false},
+});
+
+// windows N4: in every language the build has a pack for, the strings that
+// name the product are in that language and name Stedding, never Chromium.
+IN_PROC_BROWSER_TEST_F(ProductNameTest, EveryLanguageNamesStedding) {
+  base::ScopedAllowBlockingForTesting reads_the_language_packs;
+  ui::ResourceBundle& bundle = ui::ResourceBundle::GetSharedInstance();
+  const std::string own = g_browser_process->GetApplicationLocale();
+  // Each pack by its path: on the Mac a reload by name loads the language the
+  // system is set to, whatever it is asked for.
+  const auto load = [&bundle](const std::string& locale) {
+    const base::FilePath pack = ui::ResourceBundle::GetLocaleFilePath(locale);
+    if (pack.empty() || !base::PathExists(pack)) {
+      return base::FilePath();
+    }
+    bundle.OverrideLocalePakForTest(pack);
+    return bundle.ReloadLocaleResources(locale).empty() ? base::FilePath()
+                                                        : pack;
+  };
+  ASSERT_FALSE(load("en-US").empty());
+  std::vector<std::u16string> english;
+  for (const NamingString& naming : kNamingStrings) {
+    english.push_back(l10n_util::GetStringUTF16(naming.id));
+  }
+  std::set<base::FilePath> read;
+  for (const std::string& locale : l10n_util::GetUserFacingUILocaleList()) {
+    // The pseudo-locales rewrite every letter of the English on purpose.
+    if (locale == "en-XA" || locale == "ar-XB") {
+      continue;
+    }
+    const base::FilePath pack = load(locale);
+    // A language with no pack of its own falls back to one already read.
+    if (pack.empty() || !read.insert(pack).second) {
+      continue;
+    }
+    for (size_t i = 0; i < kNamingStrings.size(); ++i) {
+      const NamingString& naming = kNamingStrings.at(i);
+      const std::u16string text = l10n_util::GetStringUTF16(naming.id);
+      EXPECT_EQ(std::u16string::npos, text.find(u"Chromium"))
+          << locale << ": " << text;
+      if (naming.translated && !base::StartsWith(locale, "en")) {
+        EXPECT_NE(english.at(i), text)
+            << locale << " reads the English: the translation was lost";
+      }
+    }
+    EXPECT_NE(std::u16string::npos,
+              l10n_util::GetStringUTF16(IDS_DEFAULT_BROWSER_INFOBAR_TEXT)
+                  .find(u"Stedding"))
+        << locale;
+  }
+  bundle.OverrideLocalePakForTest(base::FilePath());
+  bundle.ReloadLocaleResources(own);
+  EXPECT_GT(read.size(), 40u) << "the build has fewer languages than it ships";
+}
+
+}  // namespace
