+namespace {
+
+// Cl5: a page that needs its parameter sends the browser back for it.
+constexpr char kPutItBack[] = "/put-it-back";
+
+std::unique_ptr<net::test_server::HttpResponse> PutItBack(
+    const net::test_server::HttpRequest& request) {
+  const GURL url = request.GetURL();
+  if (url.path() != kPutItBack) {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  if (url.query().find("utm_source=") == std::string_view::npos) {
+    response->set_code(net::HTTP_FOUND);
+    response->AddCustomHeader("Location",
+                              base::StrCat({kPutItBack, "?utm_source=back"}));
+    return response;
+  }
+  response->set_code(net::HTTP_OK);
+  response->set_content_type("text/html");
+  response->set_content("<title>kept</title>");
+  return response;
+}
+
+// Cl12: a page that needs a client hint it was not sent asks for it with
+// Critical-CH, and the browser asks for the page again with the hint.
+constexpr char kCriticalHint[] = "/critical-ch";
+constexpr char kHint[] = "Sec-CH-UA-Platform-Version";
+
+std::unique_ptr<net::test_server::HttpResponse> AsksForAHint(
+    const net::test_server::HttpRequest& request) {
+  if (request.GetURL().path() != kCriticalHint) {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_code(net::HTTP_OK);
+  response->set_content_type("text/html");
+  response->AddCustomHeader("Accept-CH", kHint);
+  response->AddCustomHeader("Critical-CH", kHint);
+  response->set_content("<title>hinted</title>");
+  return response;
+}
+
+// Cl13: a page whose script, with no click behind it, sends the browser to
+// its own address with a tracking parameter until it has one.
+constexpr char kSelfTracking[] = "/self-tracking";
+
+std::unique_ptr<net::test_server::HttpResponse> PutsItsOwnParameterOn(
+    const net::test_server::HttpRequest& request) {
+  if (request.GetURL().path() != kSelfTracking) {
+    return nullptr;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_code(net::HTTP_OK);
+  response->set_content_type("text/html");
+  response->set_content(
+      "<title>self</title><script>"
+      "if (!location.search.includes('utm_source=')) {"
+      "  location.replace('/self-tracking?utm_source=self&n=13');"
+      "}</script>");
+  return response;
+}
+
+class CleanLinksTest : public InProcessBrowserTest {
+ protected:
+  // The test host resolver takes rules only until the network process is set
+  // up, and the server's monitor must be in place before it starts.
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestMonitor(base::BindRepeating(
+        &CleanLinksTest::OnRequest, base::Unretained(this)));
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&PutItBack));
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&AsksForAHint));
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&PutsItsOwnParameterOn));
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  // On the server's own thread: every address it was asked for, with its
+  // host, and " [hint]" after it when the request carried kHint.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    std::string host;
+    if (const auto it = request.headers.find("Host");
+        it != request.headers.end()) {
+      host = it->second;
+    }
+    const bool hinted = request.headers.contains(kHint);
+    base::AutoLock lock(lock_);
+    requests_.push_back(
+        base::StrCat({host, request.relative_url, hinted ? " [hint]" : ""}));
+  }
+
+  std::vector<std::string> Requests() {
+    base::AutoLock lock(lock_);
+    return requests_;
+  }
+
+  // Whether the server was ever asked for an address containing `text`.
+  bool Asked(std::string_view text) {
+    const std::vector<std::string> requests = Requests();
+    return std::ranges::any_of(requests, [&](const std::string& request) {
+      return request.find(text) != std::string::npos;
+    });
+  }
+
+  GURL Url(std::string_view host, std::string_view path) {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  content::WebContents* Active() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  // What the address field shows for the active tab.
+  std::u16string AddressField() {
+    return BrowserView::GetBrowserViewForBrowser(browser())
+        ->GetLocationBarView()
+        ->omnibox_view()
+        ->GetText();
+  }
+
+  // A link to `href` clicked in the active page, as a person clicks it.
+  void ClickLink(const GURL& href) {
+    content::TestNavigationObserver navigated(Active(), 1);
+    ASSERT_TRUE(content::ExecJs(
+        Active(), content::JsReplace("const a = document.createElement('a');"
+                                     "a.href = $1; a.textContent = 'go';"
+                                     "document.body.appendChild(a);"
+                                     "a.click();",
+                                     href)));
+    navigated.Wait();
+  }
+
+  bool InHistory(Profile* profile, const GURL& url) {
+    history::HistoryService* const history =
+        HistoryServiceFactory::GetForProfile(
+            profile, ServiceAccessType::EXPLICIT_ACCESS);
+    history::BlockUntilHistoryProcessesPendingRequests(history);
+    ui_test_utils::HistoryEnumerator enumerator(profile);
+    return std::ranges::contains(enumerator.urls(), url);
+  }
+
+ private:
+  base::Lock lock_;
+  std::vector<std::string> requests_ GUARDED_BY(lock_);
+};
