+void VerticalTabStripRegionView::DropOutgoingSpace() {
+  // Moved out first, so nothing that runs while the layers go finds them.
+  std::vector<std::unique_ptr<SpaceSlideSnapshot>> dropped;
+  dropped.swap(outgoing_space_);
+  ++outgoing_space_generation_;
+}
