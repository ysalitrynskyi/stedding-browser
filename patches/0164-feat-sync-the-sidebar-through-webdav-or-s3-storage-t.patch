+  secure.RegisterRequestHandler(base::BindLambdaForTesting(
+      [&asked](const net::test_server::HttpRequest& request)
+          -> std::unique_ptr<net::test_server::HttpResponse> {
+        asked = true;
+        return std::make_unique<net::test_server::BasicHttpResponse>();
