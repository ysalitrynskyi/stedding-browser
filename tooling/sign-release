#!/usr/bin/env bash
# Sign and notarise a built Stedding.app with Chromium's own signing pipeline
# (chrome/installer/mac/signing: every helper gets its entitlements, the app
# gets the hardened runtime, notarytool submits, the ticket is stapled).
#
# Usage:
#   tooling/sign-release [official|release] [--check]
#
# Needs, from the operator's environment (never from this repo):
#   STEDDING_SIGN_IDENTITY   "Developer ID Application: Name (TEAMID)"
#   STEDDING_NOTARY_ARGS     arguments for `xcrun notarytool`, usually
#                            "--keychain-profile=stedding-notary" after a one-time
#                            `xcrun notarytool store-credentials stedding-notary`
#
# --development signs with an "Apple Development" identity from the keychain
# instead (no notarisation): the app runs on this machine without the
# first-launch Keychain hang (docs/ARCHITECTURE.md), but Gatekeeper still
# stops it elsewhere. Releases need the Developer ID path above.
# --check reports what is present and what is missing and changes nothing.
# Output: dist/signed/stable/<Product>.app, ready for tooling/package-dmg --app.
# A --development build is for this machine only: its signature names the
# developer's own Apple ID, so never publish it.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

main() {
    require_macos_arm64

    CONFIG=official
    CHECK=0
    DEVELOPMENT=0
    while [ $# -gt 0 ]; do
      case "$1" in
        --check)   CHECK=1; shift ;;
        --development) DEVELOPMENT=1; shift ;;
        -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
        -*)        die "unknown argument: $1" ;;
        *)         CONFIG="$1"; shift ;;
      esac
    done

    OUT="$CHROMIUM_SRC/out/$CONFIG"
    packaging="$(find "$OUT" -maxdepth 1 -type d -name '* Packaging' 2>/dev/null | head -1 || true)"
    identity="${STEDDING_SIGN_IDENTITY:-}"
    notary_args="${STEDDING_NOTARY_ARGS:-}"
    missing=0
    if [ "$DEVELOPMENT" -eq 1 ]; then
      # Any Apple Development identity will do for a local build; notarisation
      # does not apply to one, so the notary arguments are not required.
      [ -n "$identity" ] || identity="$(security find-identity -v -p codesigning 2>/dev/null \
        | sed -n 's/.*"\(Apple Development: [^"]*\)".*/\1/p' | head -1)"
      notary_args="${notary_args:-(not needed for --development)}"
    fi

    report() { printf '  %-28s %s\n' "$1" "$2" >&2; }

    if [ -n "$packaging" ] && [ -f "$packaging/sign_chrome.py" ]; then
      report "packaging dir" "$packaging"
    else
      report "packaging dir" "MISSING: build it with tooling/dev build $CONFIG chrome/installer/mac:mac"
      missing=1
    fi
    app="$(find_app_bundle "$OUT" 2>/dev/null || true)"
    if [ -n "$app" ]; then
      report "app" "$app"
    else
      report "app" "MISSING: tooling/dev build $CONFIG chrome"
      missing=1
    fi
    if [ -n "$identity" ]; then
      if security find-identity -v -p codesigning 2>/dev/null | grep -Fq "$identity"; then
        report "signing identity" "present in the keychain"
      else
        report "signing identity" "SET BUT NOT IN THE KEYCHAIN: $identity"
        missing=1
      fi
    else
      report "signing identity" "MISSING: export STEDDING_SIGN_IDENTITY"
      missing=1
    fi
    if [ -n "$notary_args" ]; then
      report "notary args" "$notary_args"
    else
      report "notary args" "MISSING: export STEDDING_NOTARY_ARGS (e.g. --keychain-profile=stedding-notary)"
      missing=1
    fi
    if xcrun --find notarytool >/dev/null 2>&1; then
      report "notarytool" "$(xcrun --find notarytool)"
    else
      report "notarytool" "MISSING: install Xcode command line tools"
      missing=1
    fi

    if [ "$CHECK" -eq 1 ]; then
      if [ "$missing" -eq 0 ]; then
        log "ready to sign"
      else
        warn "not ready; see above"
      fi
      exit "$missing"
    fi
    [ "$missing" -eq 0 ] || die "not ready to sign; run with --check for the list"

    signed="$STEDDING_ROOT/dist/signed"
    rm -rf "$signed"
    mkdir -p "$signed"
    log "signing and notarising from $OUT (this waits on Apple's notary service)"
    # --disable-packaging: tooling/package-dmg makes the image, so the layout
    # and the release notes stay in one place.
    sign_args=(--input "$OUT" --output "$signed" --identity "$identity" --disable-packaging)
    if [ "$DEVELOPMENT" -eq 1 ]; then
      sign_args+=(--development --notarize none)
    else
      # shellcheck disable=SC2206  # notary args are a list by design
      sign_args+=(--notarize staple --notary-arg $notary_args)
    fi
    python3 "$packaging/sign_chrome.py" "${sign_args[@]}" || die "signing failed"

    # The signer files the app under its channel ("stable/").
    out_app="$(find "$signed" -maxdepth 2 -type d -name '*.app' | head -1 || true)"
    [ -n "$out_app" ] || die "signing produced no app bundle under $signed"
    codesign --verify --deep --strict --verbose=2 "$out_app" 2>&1 | tail -2 >&2
    if [ "$DEVELOPMENT" -eq 0 ]; then
      spctl --assess --type execute --verbose=2 "$out_app" 2>&1 | tail -1 >&2
    fi
    log "signed app: $out_app"
    log "next: tooling/package-dmg $CONFIG --app '$out_app'"
}

main "$@"
