@@ -147,6 +147,14 @@ class SESSIONS_EXPORT TabRestoreService : public KeyedService {
       LiveTab* live_tab,
       const std::optional<tab_groups::TabGroupId>& group) {}
 
+  // Stedding (docs/features/import.md I7): adds `tabs`, tabs closed elsewhere,
+  // in their order behind what the list holds, as far as it has room, and writes
+  // the list out again. A close of the person's own is never pushed out by one.
+  // `added` receives the ids of those it took. The list must have loaded.
+  virtual void AddClosedTabs(
+      std::vector<std::unique_ptr<tab_restore::Tab>> tabs,
+      std::vector<SessionID>* added) {}
+
   // Returns the entries, ordered with most recently closed entries at the
   // front.
   virtual const Entries& entries() const = 0;
diff --git a/components/sessions/core/tab_restore_service_impl.cc b/components/sessions/core/tab_restore_service_impl.cc
index 7924eda89c4ca..1c4c4e11a5d95 100644
--- a/components/sessions/core/tab_restore_service_impl.cc
+++ b/components/sessions/core/tab_restore_service_impl.cc
@@ -1939,6 +1939,28 @@ void TabRestoreServiceImpl::SetWindowTabsExtraData(
   helper_.NotifyEntriesChanged();
 }
 
+void TabRestoreServiceImpl::AddClosedTabs(
+    std::vector<std::unique_ptr<tab_restore::Tab>> tabs,
+    std::vector<SessionID>* added) {
+  bool changed = false;
+  for (std::unique_ptr<tab_restore::Tab>& tab : tabs) {
+    const SessionID id = tab->id;
+    if (helper_.AddEntry(std::move(tab), /*notify=*/false,
+                         /*to_front=*/false)) {
+      added->push_back(id);
+      changed = true;
+    }
+  }
+  if (!changed) {
+    return;
+  }
+  // The file is written from the list's front, and these went to its back.
+  if (persistence_delegate_) {
+    persistence_delegate_->RewriteAllEntries();
+  }
+  helper_.NotifyEntriesChanged();
+}
