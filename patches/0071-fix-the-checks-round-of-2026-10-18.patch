+    SCOPED_TRACE("a deleted Space stays deleted");
+    spaces::Space* const play = SpaceNamed("Play");
+    ASSERT_TRUE(play);
+    ASSERT_TRUE(model->RemoveSpace(play->id()));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return model->size() == 1u; }));
+    const int tabs_before = strip->count();
+    const std::string line = ImportFromSettings(page);
+    EXPECT_TRUE(line.starts_with("Imported 0 Spaces, 0 tabs")) << line;
+    EXPECT_EQ(1u, model->size());
+    EXPECT_FALSE(SpaceNamed("Play")) << "the deleted Space came back";
+    EXPECT_EQ(tabs_before, strip->count());
