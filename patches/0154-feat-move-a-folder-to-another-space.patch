+std::optional<spaces::SpaceId> FolderView::OtherSpaceAt(
+    const gfx::Point& screen_point) {
+  const auto* const region = NearestOfClass<VerticalTabStripRegionView>(this);
+  BrowserWindowInterface* const window = GetBrowserWindow();
+  const spaces::SpaceModel* const space_model =
+      window ? spaces::SpaceModel::From(window) : nullptr;
+  const tabs::FolderTabCollection* const f = folder();
+  if (!region || !space_model || !f || f->TabCountRecursive() == 0) {
+    return std::nullopt;
+  }
+  const std::optional<spaces::SpaceId> space = region->SpaceChipAt(screen_point);
+  return space != space_model->FindSpaceForTab(f->GetTabsRecursive().front())
+             ? space
+             : std::nullopt;
+}
+
+bool FolderView::IsOnSpaceChips(const gfx::Point& screen_point) {
+  const auto* const region = NearestOfClass<VerticalTabStripRegionView>(this);
+  return region && region->IsOnSpaceChips(screen_point);
+}
