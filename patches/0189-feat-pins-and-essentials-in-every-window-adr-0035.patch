+// windows G21: a deleted Space's pins move once, to the Space that takes its
+// tabs in the window that deletes it, and every window follows, a window that
+// shows another Space too.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest,
+                       ADeletedSpacesPinsMoveOnceInEveryWindow) {
+  spaces::SpaceModel& model = Model(browser());
+  const spaces::SpaceId first = model.active_id();
+  spaces::Space* const doomed = model.AddSpace("Doomed", SK_ColorBLUE);
+  ASSERT_TRUE(doomed);
+  const spaces::SpaceId doomed_id = doomed->id();
+  spaces::Space* const third = model.AddSpace("Third", SK_ColorGREEN);
+  ASSERT_TRUE(third);
+  const spaces::SpaceId third_id = third->id();
+  tabs::TabInterface* const pin = PinPage(browser(), Page("/title1.html"));
+  model.SetSpaceForTab(pin, doomed_id);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(doomed_id, Store().records().front().space);
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(second).size() == 1u; }));
+  // Each window would refile the deleted Space's tabs to the Space it shows:
+  // the second window shows Third.
+  ASSERT_TRUE(Model(second).SetActiveSpace(third_id));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(first, model.SpaceTakingTabsOf(doomed_id));
+
+  ASSERT_TRUE(model.RemoveSpace(doomed_id));
+  // Once, for the profile, as the Space goes.
+  ASSERT_EQ(1u, Store().records().size());
+  EXPECT_EQ(first, Store().records().front().space)
+      << "the record did not move with the deletion";
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Pins(second).size() == 1u &&
+           Model(second).FindSpaceForTab(Pins(second).front()) == first;
+  })) << "the second window's pin did not follow to the Space that took it";
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(1u, Store().records().size());
+  EXPECT_EQ(first, Store().records().front().space)
+      << "a window's own refile moved the record again";
+  ASSERT_EQ(1u, Pins(browser()).size());
+  EXPECT_EQ(first, model.FindSpaceForTab(Pins(browser()).front()));
+  EXPECT_EQ(first, Model(second).FindSpaceForTab(Pins(second).front()));
+}
