+    ui_test_utils::BrowserCreatedObserver created;
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_NEW_BLANK_WINDOW);
+    BrowserWindowInterface* const blank = created.Wait();
+    ASSERT_TRUE(blank);
+    ASSERT_NO_FATAL_FAILURE(check(blank));
+  }
