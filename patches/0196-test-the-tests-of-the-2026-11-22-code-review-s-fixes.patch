+
+// docs/features/shortcuts.md Z12, Z17, Z18, Z23: the row numbers take back a
+// chord given to another row while they were off, and Most Recent Tab's
+// chord needs a free Shift twin even when another row has the chord itself.
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include "base/check.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/app/chrome_command_ids.h"
