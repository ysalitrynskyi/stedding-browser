+namespace spaces {
+
+// Phase two of the Arc import (docs/features/import.md I6, I21-I23): Arc's
+// history and saved passwords. Arc is a Chromium, so its History and Login
+// Data are Chromium's own SQLite files, and its passwords are sealed the way
+// Chromium seals them on macOS: AES-128-CBC under a key derived from a
+// password kept in the keychain as "Arc Safe Storage". Both files are read
+// from copies (Arc holds the originals under an exclusive lock while it
+// runs), off the UI thread, and written into the profile through the same
+// services Chromium's own importers write to. Nothing leaves the machine.
+
+struct ArcDataPaths {
+  base::FilePath history;
+  base::FilePath logins;
+};
+
+// <user data dir>/Default/History and Login Data.
+ArcDataPaths ArcDataPathsFor(const base::FilePath& user_data_dir);
+// ~/Library/Application Support/Arc/User Data.
+ArcDataPaths DefaultArcDataPaths();
+// Whether either file exists (blocking).
+bool ArcDataPresent(const ArcDataPaths& paths);
+
+// PBKDF2 with HMAC-SHA1 (RFC 8018 section 5.2), `length` bytes: the recipe
+// Chromium's own macOS key derivation follows.
+std::vector<uint8_t> Pbkdf2HmacSha1(std::string_view password,
+                                    std::string_view salt,
+                                    int rounds,
+                                    size_t length);
+// Arc's key: PBKDF2-HMAC-SHA1 over the keychain password, salt "saltysalt",
+// 1003 rounds, 16 bytes.
+std::vector<uint8_t> DeriveArcKey(std::string_view keychain_password);
+// A "v10"-prefixed AES-128-CBC value (an IV of sixteen spaces) as text;
+// nothing for an empty or unsealed blob, or a key that does not fit.
+std::optional<std::u16string> DecryptArcValue(base::span<const uint8_t> sealed,
+                                              base::span<const uint8_t> key);
+
+// The password Arc keeps in the keychain as "Arc Safe Storage". macOS asks
+// the user before handing it over; nothing when they refuse or there is no
+// such item.
+std::optional<std::string> ReadArcKeychainPassword();
+
+// The urls table of a History copy: http(s) rows that are not hidden, most
+// recent first, at most `cap`.
+history::URLRows ReadArcHistory(const base::FilePath& history_copy,
+                                size_t cap = 100000);
+// The logins table of a Login Data copy, passwords unsealed with `key`. A
+// row whose value will not unseal is left out; a blocked site comes across
+// as blocked.
+std::vector<password_manager::PasswordForm> ReadArcLogins(
+    const base::FilePath& logins_copy,
+    base::span<const uint8_t> key);
+
+struct ArcDataResult {
+  size_t history = 0;
+  size_t passwords = 0;
+  // The keychain item could not be read: refused, or no item.
+  bool keychain_denied = false;
+};
+using ArcDataDoneCallback = base::OnceCallback<void(ArcDataResult)>;
+
+// Copies the files to a temporary directory on the thread pool, reads them
+// there, asks the keychain for Arc's password when `passwords` is set, and
+// writes into `profile` back on the caller's sequence. `paths` defaults to
+// Arc's own.
+void ImportArcDataAsync(Profile* profile,
+                        bool history,
+                        bool passwords,
+                        ArcDataDoneCallback done,
+                        std::optional<ArcDataPaths> paths = std::nullopt);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_ARC_DATA_IMPORTER_H_
