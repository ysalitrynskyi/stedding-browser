+// BACKLOG S-232 (folders F7): rows dragged the pointer's way from above a
+// folder that holds a folder join the nested one at its header, the nested
+// header lit under them and not the outer one, and join the outer folder at
+// the outer header. Once the pointer was past the outer folder's own header,
+// the reorder took the row past the whole outer folder, which slid up and
+// took the nested header with it: the drop landed on the nested folder's
+// row, beside the folders.
+IN_PROC_BROWSER_TEST_F(TabDropTest, RowsFromAboveJoinANestedFolderAtItsHeader) {
+  tabs::TabInterface* const first = tab_strip_model()->GetActiveTab();
+  ASSERT_TRUE(first);
+  tabs::TabInterface* const dragged = Open("dragged-nested.test");
