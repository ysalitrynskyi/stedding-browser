+// Sf69: an older Stedding reads the block's own fields, `records`, `lists`
+// and `aliases`, and nothing else; the parts are other keys. Its rules, which
+// ParseSyncFile keeps, read a file with the parts as the same sidebar as the
+// file without them; a part that is not well formed refuses nothing.
+TEST(SidebarSyncFileTest, AnOlderVersionIgnoresTheNewParts) {
+  const std::string plain = FileOf(FileParts());
+  FileParts parts;
+  parts.settings = OneSetting(stedding::prefs::kPeekEnabled,
+                              base::Value(false), 15, kOffice);
+  parts.extensions = std::vector<ExtensionEntry>{
+      {"abcdefghijklmnopabcdefghijklmnop", "An extension"}};
+  const std::string with_parts = FileOf(parts);
+  ASSERT_NE(plain, with_parts);
+
+  const ParsedFile old_reading = ParseSyncFile(plain);
+  const ParsedFile new_reading = ParseSyncFile(with_parts);
+  ASSERT_EQ(ParseStatus::kOk, old_reading.status);
+  ASSERT_EQ(ParseStatus::kOk, new_reading.status);
+  EXPECT_EQ(old_reading.state, new_reading.state);
+  EXPECT_EQ(old_reading.meta.install, new_reading.meta.install);
+  EXPECT_EQ(parts, new_reading.parts);
+  EXPECT_EQ(FileParts(), old_reading.parts);
+
+  // The parts are keys of the block that no older rule names.
+  const std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(with_parts, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(root);
+  const base::DictValue* const block = root->FindDict("stedding_sync");
+  ASSERT_TRUE(block);
+  const std::set<std::string> older_keys = {
+      "format", "install", "device",  "nonce",   "seq",    "written_ms",
+      "hlc",    "joined_ms", "records", "lists", "aliases"};
+  std::set<std::string> new_keys;
+  for (const auto [key, value] : *block) {
+    if (!older_keys.contains(key)) {
+      new_keys.insert(key);
+    }
+  }
+  EXPECT_EQ((std::set<std::string>{kSettingsPartKey, kExtensionsPartKey}),
+            new_keys);
+
+  // Parts that are not well formed: the sidebar still applies.
+  base::DictValue broken = root->Clone();
+  broken.FindDict("stedding_sync")->Set(kSettingsPartKey, "nonsense");
+  broken.FindDict("stedding_sync")->Set(kExtensionsPartKey, 7);
+  std::string broken_json;
+  ASSERT_TRUE(base::JSONWriter::Write(broken, &broken_json));
+  const ParsedFile broken_reading = ParseSyncFile(broken_json);
+  ASSERT_EQ(ParseStatus::kOk, broken_reading.status);
+  EXPECT_EQ(old_reading.state, broken_reading.state);
+  EXPECT_FALSE(broken_reading.parts.settings);
+  EXPECT_FALSE(broken_reading.parts.extensions);
+}
