+        mode == ui::ColorProviderKey::ColorMode::kDark ? "dark" : "light";
+    ui::ColorProviderKey plain;
+    plain.color_mode = mode;
+    keys.push_back({scheme, plain});
+    for (const spaces::SpaceColorChoice& colour : spaces::kSpaceColors) {
+      // As the window keys a Space's tint (BrowserWidget).
+      ui::ColorProviderKey tinted = plain;
+      tinted.user_color = colour.color;
