+  {
+    SCOPED_TRACE("a swap takes the colours with the pages");
+    tabs->ReverseTabsInSplit(split);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return SplitRowReads(view(), colour_of(dark), colour_of(light));
+    })) << SplitRowReads(view(), colour_of(dark), colour_of(light)).message();
+  }
+  {
