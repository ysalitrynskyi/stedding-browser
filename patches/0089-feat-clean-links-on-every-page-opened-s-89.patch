+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_CLEAN_LINKS_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_CLEAN_LINKS_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class Profile;
+
+// Clean links' kept sites in chrome://settings/stedding
+// (docs/features/clean-links.md Cl9): the list, and adding and removing a
+// site. What was typed is cut to its host here, by the one rule
+// (stedding::KeptSiteFromTyped), so Settings stores what the throttle
+// matches; the page pushes nothing it made itself.
+//
+// Messages:
+//   steddingGetCleanLinksKeptSites(callback) -> [site, ...]
+//   steddingAddCleanLinksKeptSite(callback, typed) -> whether it was a site
+//   steddingRemoveCleanLinksKeptSite(site)
+// Event: "stedding-clean-links-kept-sites-changed" with the list, whenever
+// the preference changes.
+class SteddingCleanLinksHandler : public settings::SettingsPageUIHandler {
+ public:
+  explicit SteddingCleanLinksHandler(Profile* profile);
+  SteddingCleanLinksHandler(const SteddingCleanLinksHandler&) = delete;
+  SteddingCleanLinksHandler& operator=(const SteddingCleanLinksHandler&) =
+      delete;
+  ~SteddingCleanLinksHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // What the page draws, for tests.
+  base::ListValue SitesForTesting() const { return Sites(); }
+
+ private:
+  base::ListValue Sites() const;
+  void OnKeptSitesChanged();
+
+  void HandleGetKeptSites(const base::ListValue& args);
+  void HandleAddKeptSite(const base::ListValue& args);
+  void HandleRemoveKeptSite(const base::ListValue& args);
+
+  const raw_ptr<Profile> profile_;
+  PrefChangeRegistrar registrar_;
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_CLEAN_LINKS_HANDLER_H_
