+BASE_DECLARE_FEATURE_PARAM(int, kPinTabsForTesting);
+
+// Extra Spaces to create in each new window, on top of the one every window
+// starts with. Zero in normal use. This exists so multi-Space states can be
+// screenshotted and tested without a UI gesture, the same reason the metrics
+// above are parameters.
