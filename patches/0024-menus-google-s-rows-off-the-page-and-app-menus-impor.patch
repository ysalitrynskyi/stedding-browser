+
+// Stedding pins H8: a pin's card carries "Pinned in <Space> · home <host>"
+// under the domain, eliding at the tail; a plain tab's card is unchanged.
+namespace {
+// The anchor target's abstract half, for a data-only test.
+class PlainAnchorTarget : public HoverCardAnchorTarget {
+ public:
+  explicit PlainAnchorTarget(views::View* view) : HoverCardAnchorTarget(view) {}
+  using HoverCardAnchorTarget::SetHoverCardDataFrom;
+  bool NeedsToShowThumbnail() const override { return false; }
+  bool IsValidHoverCardTarget() const override { return true; }
+  views::BubbleAnchor GetAnchor() override { return views::BubbleAnchor(); }
+  views::BubbleBorder::Arrow GetAnchorPosition() const override {
+    return views::BubbleBorder::TOP_LEFT;
+  }
+};
+}  // namespace
+
+TEST_F(TabHoverCardBubbleViewTest, SteddingPinLineJoinsTheDomain) {
+  views::View anchor;
+  PlainAnchorTarget target(&anchor);
+  tabs::TabData data;
+  data.title = u"Docs";
+  data.last_committed_url = GURL("https://example.com/path");
+  data.visible_url = data.last_committed_url;
+  target.SetHoverCardDataFrom(data);
+  const TabCardData& plain = std::get<TabCardData>(target.data());
+  EXPECT_EQ(u"example.com", plain.domain_data.text);
+  EXPECT_EQ(gfx::ELIDE_HEAD, plain.domain_data.elide);
+
+  data.stedding_pin_line = u"Pinned in Work \u00B7 home example.com";
+  target.SetHoverCardDataFrom(data);
+  const TabCardData& pinned = std::get<TabCardData>(target.data());
+  EXPECT_EQ(u"example.com \u00B7 Pinned in Work \u00B7 home example.com",
+            pinned.domain_data.text);
+  EXPECT_EQ(gfx::ELIDE_TAIL, pinned.domain_data.elide);
+}
