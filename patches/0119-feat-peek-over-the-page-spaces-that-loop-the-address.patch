+
+bool BrowserView::SteddingWindowButtonsInSidebar() const {
+  return vertical_tab_strip_region_view_ &&
+         (vertical_tab_strip_region_view_->ShowsWindowButtons() ||
+          vertical_tab_strip_region_view_->WantsCornerWindowButtons());
+}
+
+bool BrowserView::SteddingSidebarChromeNeedsUpdate() {
+  if (toolbar_ &&
+      (toolbar_->stedding_buttons_host() != SteddingButtonsHostWanted() ||
+       toolbar_->stedding_menu_host() != SteddingMenuHostWanted())) {
+    return true;
+  }
+#if BUILDFLAG(IS_WIN)
+  // sidebar Y54: the window's buttons at its corner, the first time.
+  if (!stedding_corner_buttons_ && vertical_tab_strip_region_view_ &&
+      vertical_tab_strip_region_view_->WantsCornerWindowButtons()) {
+    return true;
+  }
+  // The frame's caption buttons show where the sidebar's do not.
+  if (const BrowserFrameView* const frame = GetFrameView()) {
+    if (frame->SteddingCaptionButtonsInSidebar() !=
+        SteddingWindowButtonsInSidebar()) {
+      return true;
+    }
+  }
+#endif
+  return false;
+}
+
+void BrowserView::UpdateSteddingSidebarChrome() {
+  if (!toolbar_ || !GetWidget() || GetWidget()->IsClosed()) {
+    return;
+  }
+  toolbar_->SetSteddingButtonsHost(SteddingButtonsHostWanted(),
+                                   SteddingMenuHostWanted());
+#if BUILDFLAG(IS_WIN)
+  if (!stedding_corner_buttons_ && vertical_tab_strip_region_view_ &&
+      vertical_tab_strip_region_view_->WantsCornerWindowButtons()) {
+    // Last, over the page and everything else in the window.
+    stedding_corner_buttons_ = AddChildView(
+        std::make_unique<stedding::WindowCornerButtons>(browser()));
+  }
+  if (BrowserFrameView* const frame = GetFrameView()) {
+    frame->InvalidateLayout();
+    frame->SchedulePaint();
+  }
+#endif
+  InvalidateLayout();
+}
