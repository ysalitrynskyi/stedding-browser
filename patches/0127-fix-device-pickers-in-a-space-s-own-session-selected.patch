diff --git a/chrome/browser/ui/spaces/space_model.cc b/chrome/browser/ui/spaces/space_model.cc
index 1a9e0ab029867..208620d22b6d3 100644
--- a/chrome/browser/ui/spaces/space_model.cc
+++ b/chrome/browser/ui/spaces/space_model.cc
@@ -1625,8 +1625,26 @@ void SpaceModel::OnCollectionDataChanged(
   const auto* const folder =
       static_cast<const tabs::FolderTabCollection*>(collection);
   if (folder->collapsed()) {
+    if (!collapsed_folders_.insert(changed).second || !tab_strip_model_) {
+      return;
+    }
+    // folders F3 (GitHub issue 78): the collapse keeps listed the pins the
+    // user selected in the folder, to put the rest away and keep working in
+    // those; and, with "Keep open tabs out of a collapsed folder" on, every
+    // pin that is awake. Each stays as a pin left under the folder does:
+    // while awake, until the folder opens.
+    const bool keep_open =
+        profile_->GetPrefs()->GetBoolean(stedding::prefs::kCollapseKeepsOpenPins);
+    for (tabs::TabInterface* const tab : folder->GetTabsRecursive()) {
+      const int index = tab_strip_model_->GetIndexOfTab(tab);
+      if (index != TabStripModel::kNoTab &&
+          (keep_open || tab_strip_model_->IsTabSelected(index))) {
+        left_under_collapsed_folder_.insert(tab->GetHandle());
+      }
+    }
     return;
   }
+  collapsed_folders_.erase(changed);
   for (const tabs::TabInterface* const tab : folder->GetTabsRecursive()) {
     left_under_collapsed_folder_.erase(tab->GetHandle());
   }
