+// little E1 (the owner, 2026-11-03): a little window floats over the main
+// window, centred on it as it was at 1000 x 700, now four fifths of it each
+// way, where the window sizer would have set its bounds aside. One the user
+// resizes hands its size to the next; a window it did not open that way -- a
+// peek, a normal window -- never does.
+IN_PROC_BROWSER_TEST_F(LittleWindowTest,
+                       ItOpensBigOverTheWindowAndKeepsYourSize) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  const gfx::Rect over = browser()->GetWindow()->GetBounds();
+  ASSERT_FALSE(over.IsEmpty());
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayMatching(over).work_area();
+  // Within 2 DIP: a fractional scale factor rounds a window's size.
+  const auto within2 = [](int a, int b) { return std::abs(a - b) <= 2; };
+  const auto same_size = [&](const gfx::Size& a, const gfx::Size& b) {
+    return within2(a.width(), b.width()) && within2(a.height(), b.height());
+  };
+  const auto close_window = [&](BrowserWindowInterface* window) {
+    const SessionID id = window->GetSessionID();
+    window->GetWindow()->Close();
+    return base::test::RunUntil([&]() {
+      bool still_open = false;
+      ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+          [&](BrowserWindowInterface* other) {
+            still_open = still_open || other->GetSessionID() == id;
+            return !still_open;
+          });
+      return !still_open;
+    });
+  };
+
+  {
+    SCOPED_TRACE("four fifths of the window, centred over it");
+    BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+        browser()->GetProfile(), url, browser(), /*untrusted_launch=*/false);
+    ASSERT_TRUE(little);
+    const gfx::Rect expected =
+        stedding::LittleWindowBounds(over, gfx::Size(), work_area);
+    const gfx::Rect bounds = little->GetWindow()->GetBounds();
+    EXPECT_TRUE(same_size(expected.size(), bounds.size()))
+        << bounds.ToString() << " for the window at " << over.ToString();
+    const gfx::Point centre = bounds.CenterPoint();
+    EXPECT_TRUE(within2(expected.CenterPoint().x(), centre.x()) &&
+                within2(expected.CenterPoint().y(), centre.y()))
+        << bounds.ToString() << " for the window at " << over.ToString();
+    // Smaller than the window, so the browser shows round it.
+    EXPECT_LT(bounds.width(), over.width()) << bounds.ToString();
+    EXPECT_LT(bounds.height(), over.height()) << bounds.ToString();
+    EXPECT_EQ(0, prefs->GetInteger(stedding::prefs::kLittleWidth))
+        << "the size it opened at was kept as the user's";
+
+    little->GetWindow()->SetBounds(
+        gfx::Rect(work_area.x() + 40, work_area.y() + 40, 640, 480));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return within2(640, prefs->GetInteger(stedding::prefs::kLittleWidth)) &&
+             within2(480, prefs->GetInteger(stedding::prefs::kLittleHeight));
+    })) << prefs->GetInteger(stedding::prefs::kLittleWidth) << " x "
+        << prefs->GetInteger(stedding::prefs::kLittleHeight);
+    ASSERT_TRUE(close_window(little));
+  }
+  const gfx::Size kept(prefs->GetInteger(stedding::prefs::kLittleWidth),
+                       prefs->GetInteger(stedding::prefs::kLittleHeight));
+  {
+    SCOPED_TRACE("the next one opens at the user's size");
+    BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+        browser()->GetProfile(), url, browser(), /*untrusted_launch=*/false);
+    ASSERT_TRUE(little);
+    EXPECT_TRUE(same_size(kept, little->GetWindow()->GetBounds().size()))
+        << little->GetWindow()->GetBounds().ToString();
+    ASSERT_TRUE(close_window(little));
+  }
+  {
+    SCOPED_TRACE("a window it did not open that way keeps nothing");
+    stedding::LittleWindowPlaced(browser(), gfx::Size(900, 600),
+                                 /*closing=*/false);
+    EXPECT_EQ(kept.width(), prefs->GetInteger(stedding::prefs::kLittleWidth));
+    EXPECT_EQ(kept.height(),
+              prefs->GetInteger(stedding::prefs::kLittleHeight));
+  }
+}
