+class BrowserWindowInterface;
+
+namespace stedding {
+
+// docs/features/blocker.md Bk6: the shield at the address row's right end,
+// beside the dark pages moon, in every normal and private window. It shows
+// whether ads and trackers are blocked on the active tab's site: a filled
+// shield with the toolbar's active highlight while they are, an outline
+// while blocking is off there. A click turns blocking off or on for that
+// site (Bk5) and reloads the tab. To assistive technology it is a toggle
+// button named for the site, checked while blocking applies. It is hidden
+// while the switch is off, on a page that is not a web page, and when "Show
+// the blocker button" in Settings is off. Kept out of page info on purpose:
+// the site's switch lives here, in the command bar and in Settings.
+class BlockerButton : public ToolbarButton,
+                      public content::WebContentsObserver,
+                      public content_settings::Observer,
+                      public BlockerLists::Observer {
+  METADATA_HEADER(BlockerButton, ToolbarButton)
+
+ public:
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kElementId);
+
+  explicit BlockerButton(BrowserWindowInterface* browser);
+  BlockerButton(const BlockerButton&) = delete;
+  BlockerButton& operator=(const BlockerButton&) = delete;
+  ~BlockerButton() override;
+
+  // Whether the button shows blocking as on for the active tab's site.
+  bool is_on() const { return on_; }
+
+  // views::View:
+  void AddedToWidget() override;
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+
+  // content_settings::Observer:
+  void OnContentSettingChanged(
+      const ContentSettingsPattern& primary_pattern,
+      const ContentSettingsPattern& secondary_pattern,
+      ContentSettingsTypeSet content_type_set) override;
+
+  // BlockerLists::Observer:
+  void OnBlockerListsChanged() override;
+
+ private:
+  void OnPressed();
+  void OnActiveTabChanged(BrowserWindowInterface* browser);
+  // The switch, the lists, the site's exception, the tab or its page
+  // changed; or the button's own setting.
+  void Update();
+  // The highlight is an ink drop state, which needs the widget.
+  void UpdateHighlight();
+  content::WebContents* ActiveContents() const;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  PrefChangeRegistrar profile_registrar_;
+  PrefChangeRegistrar local_state_registrar_;
+  base::CallbackListSubscription active_tab_subscription_;
+  base::ScopedObservation<HostContentSettingsMap, content_settings::Observer>
+      settings_observation_{this};
+  base::ScopedObservation<BlockerLists, BlockerLists::Observer>
+      lists_observation_{this};
+  std::optional<views::Button::ScopedAnchorHighlight> highlight_;
+  bool on_ = false;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_BLOCKER_BUTTON_H_
