+
+class Profile;
+
+namespace tabs {
+class TabCollection;
+class TabInterface;
+}  // namespace tabs
+
+namespace spaces {
+
+// docs/features/sidebar-file.md Sf2: the ids that survive a restart, which
+// the importer and the folder sync (Sf7-Sf41) share. A Space is its
+// registry token, a pin or an essential "tab:<tab token>", a folder
+// "folder:<FolderId>".
+
+// The token of a tab id a file Stedding wrote, "tab:<tab token>"; empty for
+// any other id: one another program wrote, or one from before tokens
+// ("tab:<session id>").
+std::string TokenOf(const std::string& id);
+
+// The folder a file Stedding wrote names, "folder:<FolderId>"; none for any
+// other id: a list another program wrote, or a folder from before the ids
+// (an address).
+std::optional<tabs::FolderId> FolderIdOf(const std::string& id);
+
+// "tab:<token>" and "folder:<FolderId>".
+std::string TabSyncId(const std::string& token);
+std::string FolderSyncId(const tabs::FolderId& id);
+
+// The folder with id `id` anywhere under `collection`, empty ones included.
+tabs::FolderTabCollection* FindFolderById(const tabs::TabCollection& collection,
+                                          const tabs::FolderId& id);
+
+// Every folder's id under `collection`, as a file Stedding writes it.
+void AddFolderIds(const tabs::TabCollection& collection,
+                  std::set<std::string>* ids);
+
+// Sf2, Sf18: the durable ids open now in every window of `profile` -- each
+// tab's token and each folder's id -- in a window of any kind, a little
+// window and a peek included, whatever role the tab has there.
+std::set<std::string> CollectPresentIds(Profile* profile);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_IDS_H_
