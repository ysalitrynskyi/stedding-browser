+void SpaceModel::KeepEssentialsInTheirSessions(
+    const std::map<SpaceId, std::string>& jars_before) {
+  if (!tab_strip_model_) {
+    return;
+  }
+  for (const tabs::TabHandle& handle : own_essentials_) {
+    tabs::TabInterface* const tab = handle.Get();
+    const auto filed = tab ? tab_spaces_.find(handle) : tab_spaces_.end();
+    if (filed == tab_spaces_.end()) {
+      continue;
+    }
+    const auto before = jars_before.find(filed->second);
+    const auto now = effective_jars_.find(filed->second);
+    const std::string jar =
+        before == jars_before.end() ? std::string() : before->second;
+    if (jar.empty() ||
+        (now != effective_jars_.end() && now->second == jar)) {
+      continue;
+    }
+    for (const std::unique_ptr<Space>& space : spaces_) {
+      const auto there = effective_jars_.find(space->id());
+      if (there != effective_jars_.end() && there->second == jar) {
+        filed->second = space->id();
+        SaveTabToSession(tab, filed->second);
+        observers_.Notify(&Observer::OnTabSpaceChanged, tab);
+        break;
+      }
+    }
+  }
+}
