@@ -0,0 +1,26 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_PRIVATE_WINDOW_H_
+#define CHROME_BROWSER_UI_STEDDING_PRIVATE_WINDOW_H_
+
+#include "chrome/browser/profiles/profile.h"
+
+namespace stedding {
+
+// docs/features/private.md V1, V2, V7: the one answer to "is this a private
+// window", for everything that dresses one -- the graphite coat on the
+// window's colour key, the ground behind the chrome, the "Private" title row
+// and the window title. A window of an incognito profile is private. A Guest
+// window is not, although its profile is off the record too: it has no
+// Spaces, but it keeps the ordinary coat and no "Private" label. It used to
+// be decided three ways, and a normal dark window with Chrome's Grey colour
+// was painted graphite (PLAN.md WIN-4).
+inline bool IsPrivateWindow(const Profile* profile) {
+  return profile && profile->IsIncognitoProfile();
+}
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_PRIVATE_WINDOW_H_
