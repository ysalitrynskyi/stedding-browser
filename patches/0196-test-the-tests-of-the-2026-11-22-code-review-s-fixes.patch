+
+namespace stedding {
+namespace {
+
+history::URLRows RecentRowsW2B10() {
+  history::URLRows rows;
+  history::URLRow recent(GURL("https://recent.example/"));
+  recent.set_title(u"Recent");
+  recent.set_visit_count(1);
+  recent.set_last_visit(base::Time::Now() - base::Days(1));
+  rows.push_back(recent);
+  return rows;
+}
+
+// P11-1d, import I30, I42: a history whose database did not open this run (a
+// file from a newer version, one that cannot be repaired) drops the task
+// that adds an import's visits without running it. The import still hears,
+// with nothing added: it waited for ever, and every later try was "running
+// already" until the browser restarted.
+TEST(ImportedHistoryW2B10Test, AHistoryThatDidNotOpenStillAnswers) {
+  base::ScopedTempDir dir;
+  base::test::TaskEnvironment task_environment;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  std::unique_ptr<history::HistoryService> history =
+      history::CreateHistoryService(dir.GetPath(), /*create_db=*/false);
+  ASSERT_TRUE(history);
+
+  base::CancelableTaskTracker tracker;
+  base::test::TestFuture<size_t> added;
+  AddNewVisits(*history, RecentRowsW2B10(), history::SOURCE_SAFARI_IMPORTED,
+               tracker, added.GetCallback());
+  history::BlockUntilHistoryProcessesPendingRequests(history.get());
+  task_environment.RunUntilIdle();
+  ASSERT_TRUE(added.IsReady()) << "the import never heard back";
+  EXPECT_EQ(0u, added.Get());
+}
+
+// The same, with the caller gone first: its tracker cancels the answer.
+TEST(ImportedHistoryW2B10Test, AGoneCallerHearsNothing) {
+  base::ScopedTempDir dir;
+  base::test::TaskEnvironment task_environment;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  std::unique_ptr<history::HistoryService> history =
+      history::CreateHistoryService(dir.GetPath(), /*create_db=*/false);
+  ASSERT_TRUE(history);
+
+  bool answered = false;
+  {
+    base::CancelableTaskTracker tracker;
+    AddNewVisits(*history, RecentRowsW2B10(), history::SOURCE_SAFARI_IMPORTED,
+                 tracker,
+                 base::BindOnce([](bool* answered,
+                                   size_t) { *answered = true; },
+                                &answered));
+  }
+  history::BlockUntilHistoryProcessesPendingRequests(history.get());
+  task_environment.RunUntilIdle();
+  EXPECT_FALSE(answered);
+}
+
+}  // namespace
+}  // namespace stedding
