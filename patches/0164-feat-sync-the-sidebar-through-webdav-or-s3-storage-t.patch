new file mode 100644
index 0000000000000..a8b5e1c977deb
--- /dev/null
+++ b/chrome/browser/ui/spaces/sidebar_sync_bridge.cc
@@ -0,0 +1,437 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_sync_bridge.h"
+
+#include <set>
+#include <tuple>
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_place_client.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+constexpr char kRootFolder[] = "Stedding Sidebar Place";
+constexpr char kVersionsFile[] = "versions.json";
+// Sf28: conflict copies name a Settings row each, and this is plenty of rows.
+constexpr size_t kMaxCopies = 32;
+
+// What one Pull does to the mirror.
+struct MirrorChanges {
+  MirrorChanges() = default;
+  MirrorChanges(MirrorChanges&&) = default;
+  MirrorChanges& operator=(MirrorChanges&&) = default;
+  ~MirrorChanges() = default;
+
+  std::vector<std::pair<std::string, std::string>> files;
+  std::vector<std::string> removals;
+  std::set<std::string> copies;
+  std::string own_install;
+};
+
+base::FilePath InMirror(const base::FilePath& mirror, const std::string& name) {
+  return mirror.Append(base::FilePath::FromUTF8Unsafe(name));
+}
+
+bool ApplyToMirror(const base::FilePath& mirror, MirrorChanges changes) {
+  if (!base::CreateDirectory(mirror)) {
+    return false;
+  }
+  bool ok = true;
+  for (const auto& [name, body] : changes.files) {
+    ok &= base::ImportantFileWriter::WriteFileAtomically(InMirror(mirror, name),
+                                                         body);
+  }
+  for (const std::string& name : changes.removals) {
+    ok &= base::DeleteFile(InMirror(mirror, name));
+  }
+  // Sf28: a conflict copy is only ever a name: an empty file under it says
+  // so to the service, and is gone when the place's is.
+  base::FileEnumerator files(mirror, /*recursive=*/false,
+                             base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty();
+       path = files.Next()) {
+    const std::string name = path.BaseName().AsUTF8Unsafe();
+    if (ClassifyFolderEntry(name, changes.own_install) ==
+            EntryKind::kConflictCopy &&
+        !changes.copies.contains(name)) {
+      base::DeleteFile(path);
+    }
+  }
+  for (const std::string& name : changes.copies) {
+    const base::FilePath path = InMirror(mirror, name);
+    // Only a mark: without it the copy goes unnamed, and everything else holds.
+    if (!base::PathExists(path)) {
+      std::ignore = base::WriteFile(path, "");
+    }
+  }
+  return ok;
+}
+
+std::map<std::string, std::string> ReadVersions(const base::FilePath& root) {
+  std::map<std::string, std::string> versions;
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(root.AppendASCII(kVersionsFile), &json,
+                                         kMaxListBytes)) {
+    return versions;
+  }
+  std::optional<base::Value> value = base::JSONReader::Read(
+      json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (value && value->is_dict()) {
+    for (const auto [name, version] : value->GetDict()) {
+      if (version.is_string()) {
+        versions[name] = version.GetString();
+      }
+    }
+  }
+  return versions;
+}
+
+void WriteVersions(const base::FilePath& root, const std::string& json) {
+  if (base::CreateDirectory(root)) {
+    base::ImportantFileWriter::WriteFileAtomically(
+        root.AppendASCII(kVersionsFile), json);
+  }
+}
+
+}  // namespace
+
+// Sf54: what one Pull holds in memory before it writes to the mirror. A list
+// can name 5,000 files of 4 MiB; what is past this waits for the next list,
+// and honest places are far under it.
+constexpr size_t kMaxPullBytes = 64 * 1024 * 1024;
+
+struct PlaceBridge::PullRun {
+  std::string own_install;
+  Done done;
+  PlaceFailure failure = PlaceFailure::kNone;
+  // Name and version, still to fetch.
+  std::vector<std::pair<std::string, std::string>> wanted;
+  MirrorChanges changes;
+  std::map<std::string, std::string> fetched;
+  size_t held_bytes = 0;
+};
+
+PlaceBridge::PlaceBridge(
+    Place place,
+    scoped_refptr<network::SharedURLLoaderFactory> factory,
+    base::Clock* clock,
+    const base::FilePath& profile_path,
+    scoped_refptr<base::SequencedTaskRunner> file_runner)
+    : place_(std::move(place)),
+      factory_(std::move(factory)),
+      clock_(clock),
+      profile_path_(profile_path),
+      file_runner_(std::move(file_runner)) {}
+
+PlaceBridge::~PlaceBridge() = default;
+
+// static
+base::FilePath PlaceBridge::RootFor(const base::FilePath& profile_path) {
+  return profile_path.AppendASCII(kRootFolder);
+}
+
+// static
+base::FilePath PlaceBridge::MirrorFor(const base::FilePath& profile_path) {
+  return RootFor(profile_path).AppendASCII(kSyncFolderName);
+}
+
+// static
+bool PlaceBridge::ResetMirror(const base::FilePath& profile_path, bool make) {
+  const bool gone = base::DeletePathRecursively(RootFor(profile_path));
+  return make ? gone && base::CreateDirectory(MirrorFor(profile_path)) : gone;
+}
+
+void PlaceBridge::SetSignIn(std::optional<PlaceSignIn> sign_in) {
+  if (!sign_in_set_) {
+    ApplySignIn(std::move(sign_in));
+    sign_in_set_ = true;
+    RunNext();
+    return;
+  }
+  Enqueue(base::BindOnce(
+      [](base::WeakPtr<PlaceBridge> bridge,
+         std::optional<PlaceSignIn> sign_in) {
+        if (bridge) {
+          bridge->ApplySignIn(std::move(sign_in));
+          bridge->OpFinished();
+        }
+      },
+      weak_factory_.GetWeakPtr(), std::move(sign_in)));
+}
+
+void PlaceBridge::ApplySignIn(std::optional<PlaceSignIn> sign_in) {
+  client_.reset();
+  if (sign_in) {
+    client_ = std::make_unique<PlaceClient>(place_, std::move(*sign_in),
+                                            factory_, clock_);
+  }
+}
+
+void PlaceBridge::Enqueue(base::OnceClosure step) {
+  queue_.push_back(std::move(step));
+  RunNext();
+}
+
+void PlaceBridge::RunNext() {
+  if (busy_ || !sign_in_set_ || queue_.empty()) {
+    return;
+  }
+  busy_ = true;
+  base::OnceClosure step = std::move(queue_.front());
+  queue_.pop_front();
+  std::move(step).Run();
+}
+
+void PlaceBridge::OpFinished() {
+  busy_ = false;
+  RunNext();
+}
+
+void PlaceBridge::Pull(const std::string& own_install, Done done) {
+  Enqueue(base::BindOnce(&PlaceBridge::StartPull, weak_factory_.GetWeakPtr(),
+                         own_install, std::move(done)));
+}
+
+void PlaceBridge::StartPull(std::string own_install, Done done) {
+  if (!client_) {
+    std::move(done).Run(PlaceFailure::kSignIn);
+    OpFinished();
+    return;
+  }
+  pull_ = std::make_unique<PullRun>();
+  pull_->own_install = std::move(own_install);
+  pull_->done = std::move(done);
+  if (versions_read_) {
+    ListForPull();
+    return;
+  }
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&ReadVersions, RootFor(profile_path_)),
+      base::BindOnce(&PlaceBridge::OnVersionsRead,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void PlaceBridge::OnVersionsRead(std::map<std::string, std::string> versions) {
+  // What a push learned before this read is newer than the file.
+  versions_.merge(versions);
+  versions_read_ = true;
+  ListForPull();
+}
+
+void PlaceBridge::ListForPull() {
+  client_->List(PlaceClient::Sign::kYes,
+                base::BindOnce(&PlaceBridge::OnListed,
+                               weak_factory_.GetWeakPtr()));
+}
+
+void PlaceBridge::OnListed(PlaceFailure failure, PlaceList list) {
+  if (failure != PlaceFailure::kNone) {
+    pull_->failure = failure;
+    std::unique_ptr<PullRun> run = std::move(pull_);
+    std::move(run->done).Run(failure);
+    OpFinished();
+    return;
+  }
+  pull_->changes.own_install = pull_->own_install;
+  bool own_seen = false;
+  for (const PlaceEntry& entry : list.entries) {
+    if (entry.folder) {
+      continue;
+    }
+    switch (ClassifyFolderEntry(entry.name, pull_->own_install)) {
+      case EntryKind::kIgnore:
+        continue;
+      case EntryKind::kConflictCopy:
+        if (pull_->changes.copies.size() < kMaxCopies) {
+          pull_->changes.copies.insert(entry.name);
+        }
+        continue;
+      case EntryKind::kOwn:
+        own_seen = true;
+        [[fallthrough]];
+      case EntryKind::kPeer:
+        break;
+    }
+    // Sf51: unchanged is not downloaded. Sf54: too large is never read: an
+    // empty file under the name shows it unreadable, and deletes nothing.
+    const auto known = versions_.find(entry.name);
+    if (!entry.version.empty() && known != versions_.end() &&
+        known->second == entry.version) {
+      continue;
+    }
+    if (entry.size > static_cast<int64_t>(kMaxFileBytes)) {
+      pull_->changes.files.emplace_back(entry.name, std::string());
+      pull_->fetched[entry.name] = entry.version;
+      continue;
+    }
+    pull_->wanted.emplace_back(entry.name, entry.version);
+  }
+  // Sf31: this install's own file, gone from the place, is written again:
+  // the service sees it gone. A short list says nothing about it, and a write
+  // waiting behind this list is about to put it there.
+  const std::string own_name = FileNameFor(pull_->own_install);
+  if (!own_seen && !list.cut_short && pushes_waiting_ == 0 &&
+      !pull_->own_install.empty()) {
+    pull_->changes.removals.push_back(own_name);
+    versions_.erase(own_name);
+  }
+  FetchNext();
+}
+
+void PlaceBridge::FetchNext() {
+  if (pull_->wanted.empty()) {
+    ApplyPull();
+    return;
+  }
+  auto [name, version] = std::move(pull_->wanted.back());
+  pull_->wanted.pop_back();
+  const std::string asked = name;
+  client_->Read(PlaceClient::Sign::kYes, asked,
+                base::BindOnce(&PlaceBridge::OnFetched,
+                               weak_factory_.GetWeakPtr(), std::move(name),
+                               std::move(version)));
+}
+
+void PlaceBridge::OnFetched(std::string name,
+                            std::string version,
+                            PlaceFailure failure,
+                            std::string body) {
+  switch (failure) {
+    case PlaceFailure::kNone:
+      pull_->held_bytes += body.size();
+      pull_->changes.files.emplace_back(name, std::move(body));
+      pull_->fetched[name] = std::move(version);
+      if (pull_->held_bytes >= kMaxPullBytes) {
+        pull_->wanted.clear();
+      }
+      break;
+    case PlaceFailure::kTooLarge:
+      // Sf54: the size the list gave was wrong, or was not given.
+      pull_->changes.files.emplace_back(name, std::string());
+      pull_->fetched[name] = std::move(version);
+      break;
+    case PlaceFailure::kNoSuchPlace:
+      // Gone since the list: the next list says so.
+      break;
+    case PlaceFailure::kNoRead:
+    case PlaceFailure::kWebPage:
+    case PlaceFailure::kMismatch:
+    case PlaceFailure::kServerError:
+      // One computer's file that will not come holds the others back from
+      // nothing. The mirror keeps what it had, and the next list asks again.
+      break;
+    default:
+      pull_->failure = failure;
+      pull_->wanted.clear();
+      break;
+  }
+  FetchNext();
+}
+
+void PlaceBridge::ApplyPull() {
+  file_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&ApplyToMirror, MirrorFor(profile_path_),
+                     std::move(pull_->changes)),
+      base::BindOnce(&PlaceBridge::OnPullApplied,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void PlaceBridge::OnPullApplied(bool ok) {
+  std::unique_ptr<PullRun> run = std::move(pull_);
+  if (ok) {
+    for (auto& [name, version] : run->fetched) {
+      versions_[name] = std::move(version);
+    }
+    SaveVersions();
+  } else if (run->failure == PlaceFailure::kNone) {
+    run->failure = PlaceFailure::kServerError;
+  }
+  std::move(run->done).Run(run->failure);
+  OpFinished();
+}
+
+void PlaceBridge::Push(const std::string& name, std::string json, Done done) {
+  ++pushes_waiting_;
+  Enqueue(base::BindOnce(&PlaceBridge::StartPush, weak_factory_.GetWeakPtr(),
+                         name, std::move(json), std::move(done)));
+}
+
+void PlaceBridge::StartPush(std::string name, std::string json, Done done) {
+  --pushes_waiting_;
+  if (!client_) {
+    std::move(done).Run(PlaceFailure::kSignIn);
+    OpFinished();
+    return;
+  }
+  const std::string asked = name;
+  client_->Write(asked, std::move(json),
+                 base::BindOnce(&PlaceBridge::OnPushed,
+                                weak_factory_.GetWeakPtr(), std::move(name),
+                                std::move(done)));
+}
+
+void PlaceBridge::OnPushed(std::string name,
+                           Done done,
+                           PlaceFailure failure,
+                           std::string version) {
+  if (failure == PlaceFailure::kNone) {
+    // No ETag came back: the next list's version is read once.
+    if (version.empty()) {
+      versions_.erase(name);
+    } else {
+      versions_[name] = std::move(version);
+    }
+    SaveVersions();
+  }
+  std::move(done).Run(failure);
+  OpFinished();
+}
+
+void PlaceBridge::RemoveOwn(const std::string& name, Done done) {
+  Enqueue(base::BindOnce(&PlaceBridge::StartRemove,
+                         weak_factory_.GetWeakPtr(), name, std::move(done)));
+}
+
+void PlaceBridge::StartRemove(std::string name, Done done) {
+  if (!client_) {
+    std::move(done).Run(PlaceFailure::kSignIn);
+    OpFinished();
+    return;
+  }
+  client_->Remove(name, base::BindOnce(&PlaceBridge::OnRemoved,
+                                       weak_factory_.GetWeakPtr(),
+                                       std::move(done)));
+}
+
+void PlaceBridge::OnRemoved(Done done, PlaceFailure failure) {
+  std::move(done).Run(failure);
+  OpFinished();
+}
+
+void PlaceBridge::SaveVersions() {
+  base::DictValue value;
+  for (const auto& [name, version] : versions_) {
+    value.Set(name, version);
+  }
+  std::string json;
+  base::JSONWriter::Write(value, &json);
+  file_runner_->PostTask(FROM_HERE,
+                         base::BindOnce(&WriteVersions, RootFor(profile_path_),
+                                        std::move(json)));
+}
+
+}  // namespace spaces::sidebar_sync
