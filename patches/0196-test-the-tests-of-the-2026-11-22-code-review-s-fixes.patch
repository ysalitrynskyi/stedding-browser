+// toolbar T32, T61, T64: the row's page-coloured surface that the top
+// container paints with the row over the page (OverlayPageBarBounds) lies
+// under the rows over the card -- the address row, and the bookmarks bar
+// while it shows -- where they are drawn: it ends where they end, and starts
+// where they start or further out, at the card's edge (BACKLOG S-454). Both
+// are compared on screen.
+testing::AssertionResult BarUnderTheRowsW2B25(BrowserView* browser_view) {
+  views::View* const top = browser_view->top_container();
+  gfx::Rect rows;
+  for (views::View* const row :
+       {static_cast<views::View*>(browser_view->toolbar()),
+        static_cast<views::View*>(browser_view->bookmark_bar())}) {
+    if (row && row->parent() == top && row->GetVisible() &&
+        !row->bounds().IsEmpty()) {
+      rows.Union(row->GetBoundsInScreen());
+    }
+  }
+  gfx::Rect bar = stedding::OverlayPageBarBounds(top, browser_view);
+  if (rows.IsEmpty() || bar.IsEmpty()) {
+    return testing::AssertionFailure()
+           << "no row (" << rows.ToString() << ") or no bar ("
+           << bar.ToString() << ")";
+  }
+  views::View::ConvertRectToScreen(top, &bar);
+  if (std::abs(bar.right() - rows.right()) > 1 || bar.x() > rows.x() + 1 ||
+      bar.y() != rows.y() || bar.bottom() != rows.bottom()) {
+    return testing::AssertionFailure()
+           << "the row's bar is at " << bar.ToString()
+           << " on screen, the row it should lie under at "
+           << rows.ToString();
+  }
+  return testing::AssertionSuccess();
+}
