+// P18-1d, sessions S13: Clear Session Data reloads the Space's pages that
+// are awake in the jar it cleared. An essential pinned in the Space before
+// the Space had its own session is still a shared one, in the profile's jar,
+// and a tab that has not loaded since it came back loads in the cleared jar
+// when it is next shown: neither loads now. Both did, in every window.
+TEST_F(SessionWipeB16Test, ClearSessionDataReloadsOnlyAwakePagesOfTheJar) {
+  const SpaceId work = model().AddSpace("Work", kBlueB16)->id();
+  ASSERT_TRUE(model().SetActiveSpace(work));
+  tabs::TabInterface* const essential = OpenTab(GURL("https://example.com/"));
+  tabs().SetTabPinned(IndexOf(essential), true);
+  task_environment()->RunUntilIdle();
+  model().SetSpaceIsolated(work, true);
+  task_environment()->RunUntilIdle();
+  ASSERT_TRUE(model().IsSharedEssential(essential));
+  ASSERT_EQ(work, model().SpaceForTab(essential));
+  ASSERT_FALSE(IsSpaceStoragePartition(
+      StoragePartitionConfigForWebContents(essential->GetContents())));
+
+  const std::string jar = model().registry()->Find(work)->profile_id;
+  ASSERT_FALSE(jar.empty());
+  tabs::TabInterface* const awake =
+      OpenInJar(jar, GURL("https://example.com/awake"));
+  tabs::TabInterface* const unloaded = InsertUnloadedTab(
+      &tabs(), profile(), GURL("https://example.com/later"), u"Later");
+  ASSERT_TRUE(unloaded);
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(work, model().SpaceForTab(awake));
+  ASSERT_EQ(work, model().SpaceForTab(unloaded));
+  ASSERT_EQ(ConfigFor(jar),
+            StoragePartitionConfigForWebContents(awake->GetContents()));
+  ASSERT_TRUE(unloaded->GetContents()->GetController().NeedsReload());
+
+  NavigationStartsB16 essential_loads(essential->GetContents());
+  NavigationStartsB16 awake_loads(awake->GetContents());
+  NavigationStartsB16 unloaded_loads(unloaded->GetContents());
+  base::RunLoop loop;
+  ASSERT_TRUE(model().WipeIsolatedSession(work, loop.QuitClosure()));
+  loop.Run();
+
+  EXPECT_EQ(1, awake_loads.count()) << "the page in the cleared jar";
+  EXPECT_EQ(0, essential_loads.count())
+      << "the shared essential reloaded, though its jar was not cleared";
+  EXPECT_EQ(0, unloaded_loads.count()) << "a tab that had not loaded loaded";
+  EXPECT_TRUE(unloaded->GetContents()->GetController().NeedsReload());
+}
