@@ -0,0 +1,60 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_THANKS_PAGES_H_
+#define CHROME_BROWSER_UI_STEDDING_THANKS_PAGES_H_
+
+#include <string_view>
+
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class PrefService;
+
+namespace stedding {
+
+// updates Up9, Up10 (docs/features/updates.md): stedding.dev's thank-you
+// pages, each opened once in one tab: after the install, when the welcome
+// flow is finished or skipped, and after each update, on the first launch of
+// the later version.
+inline constexpr char kThanksAfterInstallUrl[] = "https://stedding.dev/thanks/";
+inline constexpr char kThanksAfterUpdateUrl[] =
+    "https://stedding.dev/thanks/updated/";
+
+// The update's page, its fragment naming the version that started: the page
+// links that version's notes, and a fragment never leaves the browser.
+GURL ThanksAfterUpdateUrl(std::string_view version);
+
+// Whether the first window of this run opens the update's page. Records
+// `version` as the one that last ran whatever the answer. Never on a build
+// with no version, under --no-first-run (`first_run_suppressed`), on the run
+// that installed the browser (no version recorded and the welcome flow still
+// to come), for a version that is not later than the last one, or with the
+// setting off.
+bool ShouldOpenThanksAfterUpdate(PrefService& local_state,
+                                 std::string_view version,
+                                 bool first_run_suppressed,
+                                 bool welcome_pending);
+
+// Whether the welcome flow's end opens the install's page, recording that it
+// did: once per installation, never on a build with no version and never for
+// a welcome forced from the command line (the captures' --stedding-welcome).
+bool ShouldOpenThanksAfterInstall(PrefService& local_state,
+                                  std::string_view version,
+                                  bool welcome_forced);
+
+// The browser's calls: the first normal window of each run (BrowserView::Show
+// beside the welcome flow), and the welcome flow when it closes finished or
+// skipped. Each opens its page in a new foreground tab of `browser`.
+void MaybeOpenThanksAfterUpdate(BrowserWindowInterface& browser);
+void MaybeOpenThanksAfterInstall(BrowserWindowInterface& browser,
+                                 bool welcome_forced);
+
+// Tests: decide again on the next window, and read --no-first-run as absent.
+void ResetThanksAfterUpdateForTesting();
+void IgnoreNoFirstRunForTesting(bool ignore);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_THANKS_PAGES_H_
