// The Stedding mark: an arch sheltering a point of light. Replaces Chromium's
// product glyph wherever omnibox::kChromeProductIcon is drawn (the chrome://
// page chip, the app menu). Installed by tooling/apply-branding, not a patch.

CANVAS_DIMENSIONS, 24,
FILL_RULE_NONZERO,
MOVE_TO, 4.1f, 18.1f,
LINE_TO, 4.1f, 10.1f,
ARC_TO, 7.9f, 7.9f, 0, 0, 1, 19.9f, 10.1f,
LINE_TO, 19.9f, 18.1f,
ARC_TO, 1.1f, 1.1f, 0, 0, 1, 17.7f, 18.1f,
LINE_TO, 17.7f, 10.1f,
ARC_TO, 5.7f, 5.7f, 0, 0, 0, 6.3f, 10.1f,
LINE_TO, 6.3f, 18.1f,
ARC_TO, 1.1f, 1.1f, 0, 0, 1, 4.1f, 18.1f,
CLOSE,
MOVE_TO, 14.2f, 14.3f,
ARC_TO, 2.2f, 2.2f, 0, 0, 1, 9.8f, 14.3f,
ARC_TO, 2.2f, 2.2f, 0, 0, 1, 14.2f, 14.3f,
CLOSE,
