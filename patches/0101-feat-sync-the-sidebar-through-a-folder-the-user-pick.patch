+
+namespace {
+
+namespace sb = spaces::sidebar_sync;
+
+constexpr char kPeer[] = "0123456789abcdef";
+
+int64_t NowMs() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+// Another computer's sidebar: one Space with `pins` pins, stamped `t`.
+sb::State PeerState(const std::string& space,
+                      const std::vector<std::string>& pins,
+                      int64_t t,
+                      const std::string& name = "Peer Space") {
+  sb::State state;
+  const sb::Stamp stamp{t, kPeer};
+  sb::Record record(sb::Kind::kSpace);
+  record.f[sb::kFieldName] = sb::Field{name, stamp};
+  record.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+  record.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+  state.records[space] = record;
+  state.lists[sb::kSpacesList].order = {space};
+  state.lists[sb::kSpacesList].s = stamp;
+  sb::List& run = state.lists[sb::PinsListOf(space)];
+  run.s = stamp;
+  for (size_t i = 0; i < pins.size(); ++i) {
+    sb::Record pin(sb::Kind::kTab);
+    pin.f[sb::kFieldHome] = sb::Field{
+        "https://peer.example/" + base::NumberToString(i), stamp};
+    pin.f[sb::kFieldName] = sb::Field{"", stamp};
+    pin.f[sb::kFieldParent] = sb::Field{sb::PinsListOf(space), stamp};
+    state.records[pins[i]] = pin;
+    run.order.push_back(pins[i]);
+  }
+  return state;
+}
+
+std::string NewTabId() {
+  return spaces::TabSyncId(base::Uuid::GenerateRandomV4().AsLowercaseString());
+}
+
+class SidebarSyncTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  spaces::SpaceModel& model() {
+    return *spaces::SpaceModel::From(browser());
+  }
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+  base::FilePath sync_dir() {
+    return shared_.GetPath().AppendASCII(sb::kSyncFolderName);
+  }
+
+  void WritePeer(const sb::State& state, int64_t seq) {
+    base::ScopedAllowBlockingForTesting allow;
+    sb::FileMeta meta;
+    meta.install = kPeer;
+    meta.device = "Office PC";
+    meta.seq = seq;
+    meta.nonce = sb::MakeInstallId();
+    meta.written_ms = NowMs();
+    meta.hlc = state.MaxTime();
+    meta.joined_ms = 1;
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(base::WriteFile(sync_dir().AppendASCII(sb::FileNameFor(kPeer)),
+                                sb::SerializeSyncFile(state, meta)));
+  }
+
+  base::DictValue Preview(const base::FilePath& picked) {
+    base::test::TestFuture<base::DictValue> preview;
+    service()->PreviewJoin(picked, preview.GetCallback());
+    return preview.Take();
+  }
+
+  void Join(bool combine) {
+    base::DictValue preview = Preview(shared_.GetPath());
+    ASSERT_FALSE(preview.FindString("refusal"));
+    ASSERT_TRUE(service()->ConfirmJoin(combine, "Test computer", {}));
+    ASSERT_TRUE(service()->enabled());
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  base::FilePath OwnFile() {
+    return sync_dir().AppendASCII(sb::FileNameFor(
+        browser()->GetProfile()->GetPrefs()->GetString(
+            stedding::prefs::kSidebarSyncInstallId)));
+  }
+
+  tabs::TabInterface* TabWithToken(const std::string& id) {
+    for (int i = 0; i < tabs().count(); ++i) {
+      tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+      if (spaces::TabSyncId(stedding::TabToken(tab->GetContents())) == id) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  tabs::TabInterface* OpenPin() {
+    if (!ui_test_utils::NavigateToURLWithDisposition(
+            browser(), embedded_test_server()->GetURL("/title1.html"),
+            WindowOpenDisposition::NEW_FOREGROUND_TAB,
+            ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP)) {
+      return nullptr;
+    }
+    tabs::TabInterface* const tab = tabs().GetActiveTab();
+    model().SetSpacePinned(tab, true);
+    return tab;
+  }
+
+  const sb::Record* LedgerRecord(const std::string& id) {
+    const sb::Ledger* const ledger = service()->ledger_for_testing();
+    if (!ledger) {
+      return nullptr;
+    }
+    const auto it = ledger->state.records.find(id);
+    return it == ledger->state.records.end() ? nullptr : &it->second;
+  }
+
+  base::ScopedTempDir shared_;
+};
+
+// Sf7, Sf39: off by default; with sync off the service observes nothing.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, TheServiceIsOffByDefault) {
+  ASSERT_TRUE(service());
+  EXPECT_FALSE(service()->enabled());
+  EXPECT_FALSE(service()->observing_for_testing());
+  EXPECT_FALSE(service()->GetStatus().FindBool("enabled").value_or(true));
+}
+
+// Sf39: a private profile takes no part.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, APrivateProfileHasNoService) {
+  EXPECT_FALSE(spaces::SidebarSyncServiceFactory::GetForProfile(
+      browser()->GetProfile()->GetPrimaryOTRProfile(/*create_if_needed=*/true)));
+}
+
+// Sf8: a folder in Stedding's own data is refused.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, AFolderInsideTheUserDataIsRefused) {
+  base::FilePath user_data;
+  ASSERT_TRUE(base::PathService::Get(chrome::DIR_USER_DATA, &user_data));
+  const base::DictValue preview = Preview(user_data.AppendASCII("Shared"));
+  ASSERT_TRUE(preview.FindString("refusal"));
+  EXPECT_EQ("inside", *preview.FindString("refusal"));
+  EXPECT_FALSE(service()->enabled());
+}
+
+// Sf9: the sheet comes before anything is written; Cancel leaves sync off
+// and the folder as it was.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, FirstJoinWritesNothingBeforeAnswer) {
+  const base::DictValue preview = Preview(shared_.GetPath());
+  EXPECT_FALSE(preview.FindString("refusal"));
+  ASSERT_TRUE(preview.FindString("deviceName"));
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    EXPECT_FALSE(base::PathExists(sync_dir()));
+  }
+  service()->CancelJoin();
+  EXPECT_FALSE(service()->ConfirmJoin(true, "x", {}));
+  EXPECT_FALSE(service()->enabled());
+  base::ScopedAllowBlockingForTesting allow;
+  EXPECT_FALSE(base::PathExists(sync_dir()));
+}
+
+// Sf9, Sf12, Sf17: joining a folder with another computer's sidebar brings
+// its Space and pins here, unloaded, and writes this computer's own file.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, AnotherInstallsPinArrivesUnloaded) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  const std::string pin = NewTabId();
+  WritePeer(PeerState(space, {pin}, NowMs()), 1);
+  Join(/*combine=*/false);
+
+  const spaces::SpaceRegistry* const registry =
+      spaces::SpaceRegistryFactory::GetForProfile(browser()->GetProfile());
+  const std::optional<spaces::SpaceId> id =
+      spaces::SpaceId::FromOptionalToken(base::Token::FromString(space));
+  ASSERT_TRUE(id);
+  ASSERT_TRUE(registry->Find(*id));
+  EXPECT_EQ("Peer Space", registry->Find(*id)->name);
+
+  tabs::TabInterface* const tab = TabWithToken(pin);
+  ASSERT_TRUE(tab) << "the pin was not inserted";
+  EXPECT_TRUE(tab->GetContents()->WasDiscarded());
+  EXPECT_TRUE(model().IsSpacePinned(tab));
+  EXPECT_EQ(*id, model().FindSpaceForTab(tab));
+  EXPECT_NE(tab, tabs().GetActiveTab());
+
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    base::ScopedAllowBlockingForTesting allow;
+    return base::PathExists(OwnFile());
+  }));
+}
+
+// Sf15: a rename another computer makes later applies here.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, ARemoteRenameApplies) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  const int64_t start = NowMs();
+  WritePeer(PeerState(space, {NewTabId()}, start), 1);
+  Join(/*combine=*/false);
+  WritePeer(PeerState(space, {}, start + 60'000, "Renamed by the office"), 2);
+  Scan();
+  const spaces::RegistryEntry* const entry =
+      spaces::SpaceRegistryFactory::GetForProfile(browser()->GetProfile())
+          ->Find(*spaces::SpaceId::FromOptionalToken(
+              base::Token::FromString(space)));
+  ASSERT_TRUE(entry);
+  EXPECT_EQ("Renamed by the office", entry->name);
+}
+
+// Sf18: unpinning a pin here travels as a removal.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, UnpinTravelsAsADeletion) {
+  Join(/*combine=*/false);
+  tabs::TabInterface* const tab = OpenPin();
+  ASSERT_TRUE(tab);
+  service()->CommitForTesting();
+  const std::string id = spaces::TabSyncId(stedding::TabToken(tab->GetContents()));
+  ASSERT_TRUE(LedgerRecord(id));
+  EXPECT_TRUE(LedgerRecord(id)->Alive());
+
+  model().SetSpacePinned(tab, false);
+  service()->CommitForTesting();
+  ASSERT_TRUE(LedgerRecord(id));
+  EXPECT_FALSE(LedgerRecord(id)->Alive());
+}
+
+// Sf19: closing a window that holds pins removes nothing.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, ClosingAWindowWithPinsWritesNoTombstone) {
+  Join(/*combine=*/false);
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  tabs::TabInterface* const tab = second->GetTabStripModel()->GetActiveTab();
+  spaces::SpaceModel::From(second)->SetSpacePinned(tab, true);
+  service()->CommitForTesting();
+  const std::string id =
+      spaces::TabSyncId(stedding::TabToken(tab->GetContents()));
+  ASSERT_TRUE(LedgerRecord(id));
+
+  CloseBrowserSynchronously(second);
+  service()->CommitForTesting();
+  ASSERT_TRUE(LedgerRecord(id));
+  EXPECT_TRUE(LedgerRecord(id)->Alive());
+}
+
+// Sf22: another computer removing five pins at once waits for the user.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, ABulkRemovalWaits) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  std::vector<std::string> pins;
+  for (int i = 0; i < 5; ++i) {
+    pins.push_back(NewTabId());
+  }
+  const int64_t start = NowMs();
+  WritePeer(PeerState(space, pins, start), 1);
+  Join(/*combine=*/false);
+  for (const std::string& pin : pins) {
+    ASSERT_TRUE(TabWithToken(pin));
+  }
+  sb::State removed = PeerState(space, pins, start);
+  for (const std::string& pin : pins) {
+    removed.records[pin].del = sb::Stamp{start + 60'000, kPeer};
+  }
+  WritePeer(removed, 2);
+  Scan();
+  // Nothing was removed, and the batch is a row of its own.
+  for (const std::string& pin : pins) {
+    EXPECT_TRUE(TabWithToken(pin));
+  }
+  const base::DictValue status = service()->GetStatus();
+  const base::ListValue* const decisions = status.FindList("decisions");
+  ASSERT_TRUE(decisions);
+  bool held = false;
+  for (const base::Value& row : *decisions) {
+    const std::string* const id = row.GetDict().FindString("id");
+    held |= id && *id == std::string("batch:") + kPeer;
+  }
+  EXPECT_TRUE(held);
+}
+
+// Sf37: Stop syncing changes nothing in the sidebar and leaves the file.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest,
+                       TurningSyncOffStopsWritingAndKeepsEverything) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  const std::string pin = NewTabId();
+  WritePeer(PeerState(space, {pin}, NowMs()), 1);
+  Join(/*combine=*/false);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    base::ScopedAllowBlockingForTesting allow;
+    return base::PathExists(OwnFile());
+  }));
+  const base::FilePath own = OwnFile();
+  service()->Stop(/*remove_own_file=*/false);
+  EXPECT_FALSE(service()->enabled());
+  EXPECT_TRUE(TabWithToken(pin));
+  base::ScopedAllowBlockingForTesting allow;
+  EXPECT_TRUE(base::PathExists(own));
+}
+
+// Sf40: every message the box sends has a handler that answers; a message
+// with no handler would end the page's process.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, EverySyncMessageAnswers) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page = tabs().GetActiveWebContents();
+  constexpr char kSendAll[] = R"(
+    (async () => {
+      const cr = await import('chrome://resources/js/cr.js');
+      chrome.send('steddingSyncNow');
+      chrome.send('steddingSetSyncDevice', ['Desk']);
+      chrome.send('steddingCancelSyncJoin');
+      chrome.send('steddingConfirmSyncJoin', ['combine', '', []]);
+      chrome.send('steddingResolveSyncDecision', ['none', 'apply']);
+      chrome.send('steddingUndoSyncBatch', ['none']);
+      chrome.send('steddingImportSyncBackup', ['none']);
+      chrome.send('steddingShowSyncFolder');
+      chrome.send('steddingShowSyncConflict', ['../x']);
+      chrome.send('steddingStopSync', [false]);
+      const status = await cr.sendWithPromise('steddingSidebarSyncStatus');
+      return status.available === true && status.enabled === false;
+    })()
+  )";
+  EXPECT_EQ(true, content::EvalJs(page, kSendAll));
+}
+
+}  // namespace
