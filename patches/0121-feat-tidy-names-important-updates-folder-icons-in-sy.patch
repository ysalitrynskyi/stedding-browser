+
+bool TabView::TidyTitleWanted() const {
+  tabs::TabInterface* const tab =
+      const_cast<tabs::TabInterface*>(GetTabInterface());
+  BrowserWindowInterface* const window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  Profile* const profile = window ? window->GetProfile() : nullptr;
+  if (!profile ||
+      !profile->GetPrefs()->GetBoolean(stedding::prefs::kTabsTidyTitles)) {
+    return false;
+  }
+  const spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+  return model && model->IsSpacePinned(tab) &&
+         stedding::TabName(tab->GetContents()).empty();
+}
