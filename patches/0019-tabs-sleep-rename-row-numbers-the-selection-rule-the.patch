+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/tab_numbers.h"
+
+#include <algorithm>
+#include <vector>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class TabNumbersTest : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+};
+
+// tabs R10, R11: the numbers follow what the user can see -- another Space's
+// tabs are skipped -- and stop at nine.
+TEST_F(TabNumbersTest, NumbersFollowTheVisibleRowsAndStopAtNine) {
+  const spaces::SpaceId home = model().active_id();
+  std::vector<tabs::TabInterface*> at_home;
+  for (int i = 0; i < 3; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+    at_home.push_back(tabs().GetActiveTab());
+  }
+  const spaces::SpaceId work = model().AddSpace("Work", SK_ColorBLUE)->id();
+  // Entering an empty Space opens its new-tab row (spaces B3), so Work
+  // holds that tab and the one added here.
+  model().SetActiveSpace(work);
+  AddTab(browser(), GURL("https://example.org/"));
+  tabs::TabInterface* const in_work = tabs().GetActiveTab();
+
+  std::vector<tabs::TabInterface*> numbered = NumberedTabs(&tabs());
+  ASSERT_EQ(2u, numbered.size());
+  EXPECT_NE(numbered.end(), std::ranges::find(numbered, in_work));
+  for (tabs::TabInterface* tab : at_home) {
+    EXPECT_EQ(numbered.end(), std::ranges::find(numbered, tab));
+  }
+
+  model().SetActiveSpace(home);
+  EXPECT_EQ(3u, NumberedTabs(&tabs()).size());
+  for (int i = 0; i < 10; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+  }
+  EXPECT_EQ(9u, NumberedTabs(&tabs()).size());
+  EXPECT_TRUE(NumberedTabs(nullptr).empty());
+}
+
+}  // namespace
+}  // namespace stedding
