+  views::View* const list = strip->unpinned_tabs_scroll_view();
+  ASSERT_TRUE(list);
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  const float offset = static_cast<float>(stedding::kSpaceSlideOffsetDip);
+
+  // +1: the Space entered is later in the switcher, so the new list comes in
+  // from the right and the old one goes out to the left; -1 the other way.
+  const auto expect_both_slide = [&](float side) {
+    ui::Layer* const out = OutgoingLayerOver(list);
+    ASSERT_TRUE(out) << "the Space left vanished at the switch";
+    EXPECT_TRUE(out->GetAnimator()->is_animating());
+    EXPECT_FLOAT_EQ(-side * offset,
+                    out->GetTargetTransform().To2dTranslation().x())
+        << "the Space left goes out the other way";
+    EXPECT_FLOAT_EQ(0.0f, out->GetTargetOpacity());
+    ASSERT_TRUE(list->layer());
+    EXPECT_TRUE(list->layer()->GetAnimator()->is_animating())
+        << "the new list does not move with it";
+    EXPECT_FLOAT_EQ(side * offset,
+                    list->layer()->transform().To2dTranslation().x())
+        << "the new list comes in from the side of the Space entered";
+    EXPECT_TRUE(list->layer()->GetTargetTransform().IsIdentity());
+    EXPECT_FLOAT_EQ(1.0f, list->layer()->GetTargetOpacity());
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return !OutgoingLayerOver(list); }))
+        << "the outgoing layer stayed once its slide ended";
+  };
+
+  {
+    SCOPED_TRACE("to the next Space");
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return !OutgoingLayerOver(list); }));
+    Run(IDC_STEDDING_SPACE_2);
+    ExpectShowing(ids_[1]);
+    ASSERT_NO_FATAL_FAILURE(expect_both_slide(+1.0f));
+  }
