+// windows G16 (BACKLOG S-546): a new window of a profile with as many pins as
+// the owner's, 443 in nine Spaces with most in folders, has every one of
+// them soon after it opens. It took a minute and more there.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest, ANewWindowWithManyPinsOpensSoon) {
+#if DCHECK_IS_ON() || defined(ADDRESS_SANITIZER)
+  // A DCHECK or ASan build runs many times slower, and ran the owner's 443
+  // out of the test's time on the PC: two Spaces, still more records than a
+  // window makes at once, and no clock.
+  constexpr int kSpaces = 2;
+  constexpr bool kTimed = false;
+#else
+  constexpr int kSpaces = 9;
+  constexpr bool kTimed = true;
+#endif
+  spaces::SpaceModel& model = Model(browser());
+  std::vector<spaces::SpaceId> ids = {model.active_id()};
+  for (int i = 1; i < kSpaces; ++i) {
+    ids.push_back(
+        model.AddSpace(base::StringPrintf("Space %d", i), SK_ColorBLUE)->id());
+  }
+  std::vector<spaces::PinRecord> records;
+  const auto add = [&](const spaces::SpaceId* space, const std::string& host,
+                       const std::string& path) {
+    spaces::PinRecord record;
+    record.id = stedding::NewTabToken();
+    record.tier =
+        space ? spaces::PinTier::kSpacePin : spaces::PinTier::kEssential;
+    if (space) {
+      record.space = *space;
+      record.has_space = true;
+    }
+    record.home = GURL("https://" + host + ".test/");
+    record.title = base::UTF8ToUTF16(host);
+    record.folder_path = path;
+    records.push_back(std::move(record));
+  };
+  for (int e = 0; e < 4; ++e) {
+    add(nullptr, base::StringPrintf("essential%d", e), std::string());
+  }
+  for (size_t s = 0; s < ids.size(); ++s) {
+    for (int f = 0; f < 5; ++f) {
+      const std::string path = base::StringPrintf(
+          R"([{"i":"%s","t":"Folder %d","c":true}])",
+          base::Token::CreateRandom().ToString().c_str(), f);
+      for (int p = 0; p < 8; ++p) {
+        add(&ids[s], base::StringPrintf("pin%zu-%d-%d", s, f, p), path);
+      }
+    }
+    // 439 Space pins in all, as the owner has.
+    for (int p = 0; p < (s < 2 ? 8 : 9); ++p) {
+      add(&ids[s], base::StringPrintf("pin%zu-%d", s, p), std::string());
+    }
+  }
+  if constexpr (kTimed) {
+    ASSERT_EQ(443u, records.size());
+  }
+  const size_t space_pins = records.size() - 4u;
+  base::ElapsedTimer first;
+  Store().Publish({}, records, {});
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Pins(browser()).size() == space_pins &&
+           Essentials(browser()).size() == 4u;
+  })) << "the first window did not take every record";
+  LOG(ERROR) << "S-546 first window: " << first.Elapsed();
+
+  // The browser keeps answering while the pins come in: the longest wait
+  // between turns of a 10 ms timer is the longest task. The same timer sees
+  // when the window's own Space is in: RunUntil looks only once nothing is
+  // waiting to run, and each Space's pins are a task posted by the last.
+  base::TimeTicks last_tick = base::TimeTicks::Now();
+  base::TimeDelta longest_task;
+  base::ElapsedTimer timer;
+  BrowserWindowInterface* second = nullptr;
+  spaces::SpaceId on_screen = spaces::SpaceId::CreateEmpty();
+  size_t on_screen_pins = 0;
+  std::optional<base::TimeDelta> own_space;
+  const auto own_space_is_in = [&] {
+    size_t here = 0;
+    for (tabs::TabInterface* const pin : Pins(second)) {
+      here += Model(second).FindSpaceForTab(pin) == on_screen ? 1 : 0;
+    }
+    return here == on_screen_pins && Essentials(second).size() == 4u;
+  };
+  base::RepeatingTimer ticks;
+  ticks.Start(FROM_HERE, base::Milliseconds(10), base::BindLambdaForTesting([&] {
+                const base::TimeTicks now = base::TimeTicks::Now();
+                longest_task = std::max(longest_task, now - last_tick);
+                last_tick = now;
+                if (second && !own_space && own_space_is_in()) {
+                  own_space = timer.Elapsed();
+                }
+              }));
+  // Not OpenWindow(), which runs every task there is, the later Spaces' too.
+  ui_test_utils::BrowserCreatedObserver opened;
+  chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+  second = opened.Wait();
+  ASSERT_TRUE(second);
+  // The window's own Space first, with the essentials.
+  on_screen = Model(second).active_id();
+  on_screen_pins = static_cast<size_t>(std::ranges::count_if(
+      records, [&](const spaces::PinRecord& record) {
+        return record.has_space && record.space == on_screen;
+      }));
+  ASSERT_GT(on_screen_pins, 0u);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Pins(second).size() == space_pins &&
+           Essentials(second).size() == 4u;
+  })) << "the new window lacks pins";
+  const base::TimeDelta took = timer.Elapsed();
+  ticks.Stop();
+  ASSERT_TRUE(own_space) << "the window's own Space never came in";
+  LOG(ERROR) << "S-546 new window: its Space in " << *own_space
+             << ", all in " << took << ", longest task " << longest_task;
+  if constexpr (kTimed) {
+    EXPECT_LT(*own_space, base::Seconds(2));
+    EXPECT_LT(longest_task, base::Seconds(2));
+    EXPECT_LT(took, base::Seconds(20));
+  }
+  // Every pin in its Space, and in its folder.
+  for (tabs::TabInterface* const pin : Pins(second)) {
+    const spaces::PinRecord* const record = Store().Find(Token(pin));
+    ASSERT_TRUE(record);
+    EXPECT_EQ(record->space, Model(second).FindSpaceForTab(pin));
+    EXPECT_EQ(record->folder_path.empty(), !FolderOf(pin));
+  }
+}
