+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/file_trash.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/task/task_runner.h"
+
+namespace stedding {
+
+namespace {
+
+using MoveFunction = base::RepeatingCallback<bool(const base::FilePath&)>;
+
+MoveFunction& MoveForTesting() {
+  static base::NoDestructor<MoveFunction> move;
+  return *move;
+}
+
+bool MoveWithTheRealTrash(const base::FilePath& path) {
+  return MoveToTrash(path, /*trashed_path=*/nullptr);
+}
+
+}  // namespace
+
+void MoveToTrashThen(const base::FilePath& path,
+                     base::OnceCallback<void(bool)> done) {
+  // Read here, on the caller's sequence, and carried to the runner: the
+  // stand-in is never read on another thread.
+  MoveFunction move = MoveForTesting()
+                          ? MoveForTesting()
+                          : base::BindRepeating(&MoveWithTheRealTrash);
+  CreateFileTrashTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(std::move(move), path), std::move(done));
+}
+
+void SetMoveToTrashForTesting(MoveFunction move) {
+  MoveForTesting() = std::move(move);
+}
+
+}  // namespace stedding
