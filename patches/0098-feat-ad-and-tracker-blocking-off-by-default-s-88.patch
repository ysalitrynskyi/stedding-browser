new file mode 100644
index 0000000000000..22be461025e94
--- /dev/null
+++ b/chrome/browser/ui/stedding/blocker/blocker.cc
@@ -0,0 +1,117 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/blocker/blocker.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/ui/stedding/blocker/blocker_activation_throttle.h"
+#include "chrome/browser/ui/stedding/blocker/blocker_lists.h"
+#include "chrome/browser/ui/stedding/blocker/blocker_rules.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/common/chrome_paths.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "components/subresource_filter/content/browser/content_subresource_filter_throttle_manager.h"
+#include "components/subresource_filter/content/browser/ruleset_service.h"
+#include "components/subresource_filter/core/browser/ruleset_version.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr char kListBase[] = "https://easylist.to/easylist/";
+constexpr base::FilePath::CharType kBlockerDirName[] =
+    FILE_PATH_LITERAL("Stedding Blocker");
+
+// Bk1: while blocking is on, Stedding's throttle decides each page's
+// activation; while it is off, Chromium's own path is left as it is.
+void UpdatePageActivation(PrefService* local_state) {
+  using Manager = subresource_filter::ContentSubresourceFilterThrottleManager;
+  Manager::SetPageActivationThrottleFactory(
+      BlockerOn(local_state)
+          ? base::BindRepeating(&BlockerActivationThrottle::MaybeAdd)
+          : Manager::PageActivationThrottleFactory());
+}
+
+void Publish(const subresource_filter::UnindexedRulesetInfo& info) {
+  if (subresource_filter::RulesetService* const service =
+          g_browser_process->subresource_filter_ruleset_service()) {
+    service->IndexAndStoreAndPublishRulesetIfNeeded(info);
+  }
+}
+
+std::string IndexedVersion() {
+  subresource_filter::RulesetService* const service =
+      g_browser_process->subresource_filter_ruleset_service();
+  return service ? service->GetMostRecentlyIndexedVersion().content_version
+                 : std::string();
+}
+
+// The watch on the blocker's switches in Local State.
+PrefChangeRegistrar& Registrar() {
+  static base::NoDestructor<PrefChangeRegistrar> registrar;
+  return *registrar;
+}
+
+}  // namespace
+
+void StartBlocker(PrefService* local_state,
+                  scoped_refptr<network::SharedURLLoaderFactory> factory) {
+  if (BlockerLists::Get() || !local_state || !factory) {
+    return;
+  }
+  base::FilePath user_data;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+    return;
+  }
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+
+  BlockerLists::Environment environment;
+  environment.local_state = local_state;
+  environment.dir = user_data.Append(kBlockerDirName);
+  environment.url_loader_factory = std::move(factory);
+  environment.list_base = GURL(kListBase);
+  if (command_line.HasSwitch(kBlockerListBaseSwitch)) {
+    environment.list_base =
+        GURL(command_line.GetSwitchValueASCII(kBlockerListBaseSwitch));
+    environment.minimum_rules = 1;
+    environment.launch_delay = base::TimeDelta();
+  }
+  environment.publish = base::BindRepeating(&Publish);
+  environment.indexed_version = base::BindRepeating(&IndexedVersion);
+
+  // Owned by the process, as the updater is: it lives until the browser
+  // quits.
+  BlockerLists* const lists =
+      std::make_unique<BlockerLists>(std::move(environment)).release();
+  BlockerLists::SetInstance(lists);
+  lists->Start();
+
+  UpdatePageActivation(local_state);
+  PrefChangeRegistrar* const registrar = &Registrar();
+  registrar->Init(local_state);
+  const base::RepeatingClosure update = base::BindRepeating(
+      &UpdatePageActivation, base::Unretained(local_state));
+  registrar->Add(prefs::kBlockerEnabled, update);
+  registrar->Add(prefs::kBlockerEasyList, update);
+  registrar->Add(prefs::kBlockerEasyPrivacy, update);
+}
+
+void StopBlocker() {
+  Registrar().Reset();
+  delete BlockerLists::Get();
+}
+
+}  // namespace stedding
