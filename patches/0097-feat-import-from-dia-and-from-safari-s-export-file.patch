+// import I39 (BACKLOG S-346): a row saved already with the same password
+// loses its note before Chromium's importer sees it, which added the file's
+// note to the saved login's. Any other row keeps its note.
+TEST(ImportedPasswordsTest, ASavedLoginsRowLosesItsNote) {
+  const std::vector<CredentialUIEntry> saved = {
+      CredentialUIEntry(Login("https://a.example/", "ann", "one"),
+                        PasswordForm::Store::kProfileStore),
+      CredentialUIEntry(Login("https://b.example/", "bob", "two"),
+                        PasswordForm::Store::kProfileStore),
+  };
+  const auto with_note = [](std::string url, std::string username,
+                            std::string password) {
+    return CSVPassword(GURL(url), std::move(username), std::move(password),
+                       "from the file", CSVPassword::Status::kOK);
+  };
+  std::vector<CSVPassword> incoming = {
+      with_note("https://a.example/", "ann", "one"),
+      with_note("https://b.example/", "bob", "other"),
+      with_note("https://d.example/", "dan", "four"),
+  };
+  DropNotesOfSavedLogins(saved, incoming);
+  ASSERT_EQ(3u, incoming.size());
+  EXPECT_TRUE(incoming[0].GetNote().empty()) << "the saved login's row";
+  EXPECT_EQ(GURL("https://a.example/"), incoming[0].GetURL().value());
+  EXPECT_EQ("ann", incoming[0].GetUsername());
+  EXPECT_EQ("one", incoming[0].GetPassword());
+  EXPECT_EQ("from the file", incoming[1].GetNote()) << "another password";
+  EXPECT_EQ("from the file", incoming[2].GetNote()) << "a new login";
+  // The rows count as they did.
+  const PasswordWriteResult result = ClassifyIncomingPasswords(saved, incoming);
+  EXPECT_EQ(1u, result.already_saved);
+  EXPECT_EQ(1u, result.kept);
+  EXPECT_EQ(1u, result.added);
+}
