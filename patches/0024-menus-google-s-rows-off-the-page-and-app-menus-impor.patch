+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/menu_rules.h"
+
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+
+namespace stedding {
+
+bool IsGooglePageMenuCommand(int command_id) {
+  switch (command_id) {
+    case IDC_CONTENT_CONTEXT_LENS_REGION_SEARCH:
+    case IDC_CONTENT_CONTEXT_LENS_OVERLAY:
+    case IDC_CONTENT_CONTEXT_SEARCHLENSFORIMAGE:
+    case IDC_CONTENT_CONTEXT_SEARCHLENSFORVIDEOFRAME:
+    case IDC_CONTENT_CONTEXT_GENERATE_QR_CODE:
+    case IDC_CONTENT_CONTEXT_OPEN_IN_READING_MODE:
+    case IDC_CONTENT_CONTEXT_GLIC:
+    case IDC_CONTENT_CONTEXT_GLICSHAREIMAGE:
+    case IDC_CONTENT_CONTEXT_RELOAD_GLIC:
+    case IDC_CONTENT_CONTEXT_ARCHIVE_GLIC:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool IsGoogleAppMenuCommand(int command_id) {
+  switch (command_id) {
+    case IDC_MANAGE_GOOGLE_ACCOUNT:
+    case IDC_SHOW_SIGNIN_WHEN_PAUSED:
+    case IDC_OPEN_GLIC:
+    case IDC_SEND_TAB_TO_SELF:
+    case IDC_SHOW_CUSTOMIZE_CHROME_SIDE_PANEL:
+    case IDC_SHOW_PAYMENT_METHODS:
+    case IDC_CONTENT_CONTEXT_LENS_OVERLAY:
+    case IDC_BOOKMARK_BAR_SUBMENU:
+    case IDC_SHOW_BOOKMARK_BAR:
+    case IDC_SHOW_BOOKMARK_SIDE_PANEL:
+    case kSavedTabGroupsMenuId:
+    case kReadingListMenuId:
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool IsTabMenuCommandVisible(TabRowKind kind, int command_id) {
+  if (command_id >= TabStripModel::CommandSteddingMoveToSpaceFirst &&
+      command_id <= TabStripModel::CommandSteddingMoveToSpaceLast) {
+    // An essentials tab is in every Space.
+    return kind != TabRowKind::kEssential;
+  }
+  switch (command_id) {
+    case TabStripModel::CommandSpacePin:
+      return kind == TabRowKind::kPlain;
+    case TabStripModel::CommandSpaceUnpin:
+      return kind == TabRowKind::kSpacePinned;
+    case TabStripModel::CommandSteddingResetToHome:
+    case TabStripModel::CommandSteddingSetHome:
+      // Only a pin of either tier has a home (pins H1).
+      return kind != TabRowKind::kPlain;
+    case TabStripModel::CommandMoveTabToNewFolder:
+    case TabStripModel::CommandSteddingMoveToSpaceMenu:
+      // The essentials row is above every Space and never in a folder.
+      return kind != TabRowKind::kEssential;
+    default:
+      return true;
+  }
+}
+
+}  // namespace stedding
