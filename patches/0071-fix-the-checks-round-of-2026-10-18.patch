+      [&](BrowserWindowInterface* window) {
+        const SpaceModel* const other = SpaceModel::From(window);
+        if (other && other != this && other->registry_ == registry_) {
+          count_in(*other);
+        }
+        return true;
+      });
+  return count;
+}
