+    if (little) {
+      EXPECT_TRUE(content::WaitForLoadStop(
+          little->GetTabStripModel()->GetActiveWebContents()));
+    }
+    return little;
+  }
+};
+
+// E7: the File menu's rows in a little window and in a normal one, the
+// chords beside them, and the Window menu's Show as Tab.
+IN_PROC_BROWSER_TEST_F(LittleWindowMenuMacTest, TheMenusNameTheMove) {
+  NSMenuItem* const open = RowIn(IDC_FILE_MENU, IDC_OPEN_FILE);
+  NSMenuItem* const split =
+      RowIn(IDC_FILE_MENU, IDC_STEDDING_LITTLE_PROMOTE_SPLIT);
+  NSMenuItem* const show_as_tab = RowIn(IDC_WINDOW_MENU, IDC_SHOW_AS_TAB);
+  ASSERT_TRUE(open);
+  ASSERT_TRUE(split) << "no split row in the File menu";
+  ASSERT_TRUE(show_as_tab);
+  EXPECT_EQ([open.menu indexOfItem:open] + 1, [split.menu indexOfItem:split])
+      << "the split row follows Open File's";
+  // AppKit names a shifted letter by its capital, without the Shift flag.
+  EXPECT_NSEQ(@"o", open.keyEquivalent);
+  EXPECT_EQ(NSEventModifierFlagCommand, open.keyEquivalentModifierMask);
+  EXPECT_NSEQ(@"O", split.keyEquivalent);
+  EXPECT_EQ(NSEventModifierFlagCommand, split.keyEquivalentModifierMask);
+
+  BrowserWindowInterface* const little = OpenLittle();
+  ASSERT_TRUE(little);
+  NSWindow* const little_window = NSWindowOf(little);
+  EXPECT_TRUE([little_window validateUserInterfaceItem:open]);
+  EXPECT_NSEQ(base::SysUTF16ToNSString(stedding::OpenInMainWindowLabel()),
+              open.title);
+  EXPECT_TRUE([open.title hasPrefix:@"Open in "]) << open.title;
+  EXPECT_TRUE([little_window validateUserInterfaceItem:split]);
+  EXPECT_FALSE(split.hidden);
+  EXPECT_NSEQ(l10n_util::GetNSString(IDS_STEDDING_LITTLE_OPEN_IN_SPLIT),
+              split.title);
+  EXPECT_TRUE([little_window validateUserInterfaceItem:show_as_tab]);
+  EXPECT_FALSE(show_as_tab.hidden);
+
+  NSWindow* const normal = NSWindowOf(browser());
+  EXPECT_TRUE([normal validateUserInterfaceItem:open]);
+  EXPECT_NSEQ(l10n_util::GetNSStringWithFixup(IDS_OPEN_FILE_MAC), open.title)
+      << "Open File again in a normal window";
+  EXPECT_FALSE([normal validateUserInterfaceItem:split]);
+  EXPECT_TRUE(split.hidden);
+  EXPECT_FALSE([normal validateUserInterfaceItem:show_as_tab]);
+  EXPECT_TRUE(show_as_tab.hidden);
+
+  // The chords: Cmd-O is the File menu row's, so the menu runs it;
+  // Shift-Cmd-O reaches the split command, by the menu's row in a little
+  // window or by the table of keys outside the menu.
+  CommandForKeyEventResult command =
+      CommandForKeyEvent(cocoa_test_event_utils::KeyEventWithKeyCode(
+          kVK_ANSI_O, 'o', NSEventTypeKeyDown, NSEventModifierFlagCommand));
+  EXPECT_EQ(IDC_OPEN_FILE, command.chrome_command);
+  command = CommandForKeyEvent(cocoa_test_event_utils::KeyEventWithKeyCode(
+      kVK_ANSI_O, 'O', NSEventTypeKeyDown,
+      NSEventModifierFlagCommand | NSEventModifierFlagShift));
+  EXPECT_EQ(IDC_STEDDING_LITTLE_PROMOTE_SPLIT, command.chrome_command);
+}
+
+// E7: choosing "Open in Stedding", then "Show as Tab", in a little window
+// moves its page into the normal window and closes the little window.
+IN_PROC_BROWSER_TEST_F(LittleWindowMenuMacTest, TheRowsMoveThePage) {
+  for (const auto& row : {RowIn(IDC_FILE_MENU, IDC_OPEN_FILE),
+                          RowIn(IDC_WINDOW_MENU, IDC_SHOW_AS_TAB)}) {
+    ASSERT_TRUE(row);
+    SCOPED_TRACE(base::SysNSStringToUTF8(row.title));
+    BrowserWindowInterface* const little = OpenLittle();
+    ASSERT_TRUE(little);
+    content::WebContents* const page =
+        little->GetTabStripModel()->GetActiveWebContents();
+    NSWindow* const window = NSWindowOf(little);
+    ASSERT_TRUE([window validateUserInterfaceItem:row]);
+    ASSERT_TRUE([NSApp sendAction:row.action to:window from:row]);
+    EXPECT_TRUE(base::test::RunUntil([]() { return !LittleWindowOpen(); }));
+    EXPECT_EQ(page, browser()->GetTabStripModel()->GetActiveWebContents());
+  }
+}
+
+}  // namespace
