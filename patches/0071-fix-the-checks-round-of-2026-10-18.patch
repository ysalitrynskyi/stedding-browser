+  content::WebContents* const page = tabs()->GetActiveWebContents();
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(
+      spaces::StoragePartitionConfigForWebContents(page)));
+  ASSERT_TRUE(content::ExecJs(page, "document.cookie = 'signed=work'"));
+  ASSERT_EQ("signed=work", CookieSeenInANewTab());
+  ASSERT_TRUE(model()->SetActiveSpace(home));
+  // What the cookie stores write at their next commit, written now: their
+  // own commits are on a timer.
+  content::EnsureCookiesFlushed(browser()->GetProfile());
+}
+
+IN_PROC_BROWSER_TEST_F(SpaceJarRestartTest,
+                       ASessionCookieInASpacesJarOutlivesARestart) {
+  ASSERT_TRUE(model());
+  const std::optional<spaces::SpaceId> home = SpaceNamed("Home");
+  const std::optional<spaces::SpaceId> work = SpaceNamed("Work");
+  ASSERT_TRUE(home.has_value());
+  ASSERT_TRUE(work.has_value());
+  ASSERT_TRUE(model()->SpaceIsIsolated(*work));
+
+  ASSERT_TRUE(model()->SetActiveSpace(*home));
+  EXPECT_EQ("signed=home", CookieSeenInANewTab())
+      << "the profile's jar lost its session cookie";
+  ASSERT_TRUE(model()->SetActiveSpace(*work));
