index 0000000000000..5122e5546c485
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/stedding_dark_pages_handler.cc
@@ -0,0 +1,149 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/stedding_dark_pages_handler.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/dark_pages.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "content/public/browser/web_ui.h"
+
+namespace {
+
+constexpr char kModeAll[] = "all";
+constexpr char kModeOnly[] = "only";
+
+base::ListValue SitesAsValue(Profile* profile, stedding::DarkPagesMode mode) {
+  base::ListValue list;
+  for (const ContentSettingsPattern& pattern :
+       stedding::GetDarkPagesSites(profile, mode)) {
+    base::DictValue entry;
+    entry.Set("name", stedding::DarkPagesSiteName(pattern));
+    entry.Set("pattern", pattern.ToString());
+    list.Append(std::move(entry));
+  }
+  return list;
+}
+
+}  // namespace
+
+SteddingDarkPagesHandler::SteddingDarkPagesHandler(Profile* profile)
+    : profile_(profile->GetOriginalProfile()) {}
+
+SteddingDarkPagesHandler::~SteddingDarkPagesHandler() = default;
+
+void SteddingDarkPagesHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "steddingGetDarkPages",
+      base::BindRepeating(&SteddingDarkPagesHandler::HandleGetDarkPages,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingSetDarkPagesMode",
+      base::BindRepeating(&SteddingDarkPagesHandler::HandleSetDarkPagesMode,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingAddDarkPagesSite",
+      base::BindRepeating(&SteddingDarkPagesHandler::HandleAddDarkPagesSite,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingRemoveDarkPagesSite",
+      base::BindRepeating(&SteddingDarkPagesHandler::HandleRemoveDarkPagesSite,
+                          base::Unretained(this)));
+}
+
+void SteddingDarkPagesHandler::OnJavascriptAllowed() {
+  if (HostContentSettingsMap* const map =
+          HostContentSettingsMapFactory::GetForProfile(profile_);
+      map && !observation_.IsObserving()) {
+    observation_.Observe(map);
+  }
+}
+
+void SteddingDarkPagesHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+}
+
+void SteddingDarkPagesHandler::OnContentSettingChanged(
+    const ContentSettingsPattern& primary_pattern,
+    const ContentSettingsPattern& secondary_pattern,
+    ContentSettingsTypeSet content_type_set) {
+  // Dk20: the page menu and the command bar write the same content setting;
+  // the page shows their change at once.
+  if (content_type_set.Contains(ContentSettingsType::AUTO_DARK_WEB_CONTENT) &&
+      IsJavascriptAllowed()) {
+    FireWebUIListener("stedding-dark-pages-changed", State());
+  }
+}
+
+base::DictValue SteddingDarkPagesHandler::State() const {
+  base::DictValue state;
+  state.Set("mode", stedding::GetDarkPagesMode(profile_) ==
+                            stedding::DarkPagesMode::kOnlyThese
+                        ? kModeOnly
+                        : kModeAll);
+  state.Set("except",
+            SitesAsValue(profile_, stedding::DarkPagesMode::kAllExcept));
+  state.Set("only",
+            SitesAsValue(profile_, stedding::DarkPagesMode::kOnlyThese));
+  return state;
+}
+
+void SteddingDarkPagesHandler::HandleGetDarkPages(const base::ListValue& args) {
+  if (args.size() != 1U) {
+    return;
+  }
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], State());
+}
+
+void SteddingDarkPagesHandler::HandleSetDarkPagesMode(
+    const base::ListValue& args) {
+  if (args.size() != 1U || !args[0].is_string()) {
+    return;
+  }
+  const std::string& mode = args[0].GetString();
+  if (mode != kModeAll && mode != kModeOnly) {
+    return;
+  }
+  // Dk12: the lists stay as they are; the page shows the new mode's.
+  stedding::SetDarkPagesMode(
+      profile_, mode == kModeOnly ? stedding::DarkPagesMode::kOnlyThese
+                                  : stedding::DarkPagesMode::kAllExcept);
+}
+
+void SteddingDarkPagesHandler::HandleAddDarkPagesSite(
+    const base::ListValue& args) {
+  if (args.size() != 2U || !args[1].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  // Dk13: what is no site is refused, and nothing is written; the page says
+  // so under the field.
+  const std::optional<ContentSettingsPattern> site =
+      stedding::DarkPagesSitePatternFromTyped(args[1].GetString());
+  if (site) {
+    stedding::AddDarkPagesSite(profile_, stedding::GetDarkPagesMode(profile_),
+                               *site);
+  }
+  ResolveJavascriptCallback(args[0], base::Value(site.has_value()));
+}
+
+void SteddingDarkPagesHandler::HandleRemoveDarkPagesSite(
+    const base::ListValue& args) {
+  if (args.size() != 1U || !args[0].is_string()) {
+    return;
+  }
+  const ContentSettingsPattern pattern =
