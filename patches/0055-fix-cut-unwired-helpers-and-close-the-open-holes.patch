new file mode 100644
index 0000000000000..3a4068b45844b
--- /dev/null
+++ b/chrome/browser/ui/spaces/chromium_profile_import_unittest.cc
@@ -0,0 +1,137 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/chromium_profile_import.h"
+
+#include <array>
+
+#include "base/containers/span.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/string_view_util.h"
+#include "chrome/browser/ui/spaces/arc_data_importer.h"
+#include "components/password_manager/core/browser/password_form.h"
+#include "crypto/aes_cbc.h"
+#include "sql/database.h"
+#include "sql/statement.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+std::vector<uint8_t> Seal(std::string_view password, std::string_view text) {
+  const std::vector<uint8_t> key = spaces::DeriveArcKey(password);
+  std::array<uint8_t, crypto::aes_cbc::kBlockSize> iv;
+  iv.fill(' ');
+  std::vector<uint8_t> sealed = {'v', '1', '0'};
+  const std::vector<uint8_t> body =
+      crypto::aes_cbc::Encrypt(key, iv, base::as_byte_span(text));
+  sealed.insert(sealed.end(), body.begin(), body.end());
+  return sealed;
+}
+
+TEST(ChromiumProfileImportTest, BookmarksHistoryAndPasswordsMatchTheSource) {
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const base::FilePath profile = root.GetPath().AppendASCII("Default");
+  ASSERT_TRUE(base::CreateDirectory(profile));
+  const std::string bookmarks = R"({
+    "roots": {
+      "bookmark_bar": {
+        "type": "folder",
+        "name": "Bookmarks bar",
+        "children": [
+          {"type": "url", "name": "Example", "url": "https://example.com/"},
+          {"type": "folder", "name": "Work", "children": [
+            {"type": "url", "name": "Work", "url": "https://work.example/"}
+          ]}
+        ]
+      },
+      "other": {"type": "folder", "name": "Other", "children": []}
+    }
+  })";
+  ASSERT_TRUE(base::WriteFile(profile.AppendASCII("Bookmarks"), bookmarks));
+
+  {
+    sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                     sql::Database::Tag("History"));
+    ASSERT_TRUE(db.Open(profile.AppendASCII("History")));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE urls (id INTEGER PRIMARY KEY, url LONGVARCHAR, "
+        "title LONGVARCHAR, visit_count INTEGER NOT NULL DEFAULT 0, "
+        "typed_count INTEGER NOT NULL DEFAULT 0, last_visit_time INTEGER "
+        "NOT NULL, hidden INTEGER DEFAULT 0 NOT NULL)"));
+    sql::Statement insert(db.GetUniqueStatement(
+        "INSERT INTO urls (url, title, visit_count, typed_count, "
+        "last_visit_time, hidden) VALUES (?, ?, ?, ?, ?, 0)"));
+    insert.BindString(0, "https://history.example/");
+    insert.BindString(1, "History");
+    insert.BindInt(2, 3);
+    insert.BindInt(3, 1);
+    insert.BindInt64(4, 1);
+    ASSERT_TRUE(insert.Run());
+  }
+  {
+    sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                     sql::Database::Tag("Passwords"));
+    ASSERT_TRUE(db.Open(profile.AppendASCII("Login Data")));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE logins (origin_url VARCHAR NOT NULL, "
+        "username_value VARCHAR, password_value BLOB, signon_realm VARCHAR "
+        "NOT NULL, blacklisted_by_user INTEGER NOT NULL)"));
+    const std::vector<uint8_t> sealed = Seal("mock_password", "secret");
+    sql::Statement insert(db.GetUniqueStatement(
+        "INSERT INTO logins (origin_url, username_value, password_value, "
+        "signon_realm, blacklisted_by_user) VALUES (?, ?, ?, ?, 0)"));
+    insert.BindString(0, "https://login.example/");
+    insert.BindString(1, "user");
+    insert.BindBlob(2, sealed);
+    insert.BindString(3, "https://login.example/");
+    ASSERT_TRUE(insert.Run());
+  }
+
+  const ChromiumProfileContents contents =
+      ReadChromiumProfile(profile, "mock_password");
+  ASSERT_EQ(2u, contents.bookmarks.size());
+  EXPECT_EQ(u"Example", contents.bookmarks[0].title);
+  EXPECT_EQ(GURL("https://example.com/"), contents.bookmarks[0].url);
+  EXPECT_TRUE(contents.bookmarks[0].in_toolbar);
+  EXPECT_TRUE(contents.bookmarks[0].path.empty());
+  EXPECT_EQ(u"Work", contents.bookmarks[1].title);
+  EXPECT_EQ(GURL("https://work.example/"), contents.bookmarks[1].url);
+  ASSERT_EQ(1u, contents.bookmarks[1].path.size());
+  EXPECT_EQ(u"Work", contents.bookmarks[1].path[0]);
+
+  ASSERT_EQ(1u, contents.history.size());
+  EXPECT_EQ(GURL("https://history.example/"), contents.history[0].url());
+  EXPECT_EQ(u"History", contents.history[0].title());
+  EXPECT_EQ(3, contents.history[0].visit_count());
+
+  ASSERT_EQ(1u, contents.logins.size());
+  EXPECT_EQ(GURL("https://login.example/"), contents.logins[0].url);
+  EXPECT_EQ(u"user", contents.logins[0].username_value);
+  EXPECT_EQ(contents.logins[0].password_value, u"secret");
+
+  ChromiumBrowserLocation browser;
+  browser.user_data_dir = root.GetPath();
+  browser.display_name = "Google Chrome";
+  browser.keychain_service = "Chrome Safe Storage";
+  browser.keychain_account = "Chrome";
+  const std::vector<user_data_importer::SourceProfile> offered =
+      DetectChromiumProfiles(browser);
+  ASSERT_EQ(1u, offered.size());
+  EXPECT_EQ(u"Google Chrome", offered[0].importer_name);
+  EXPECT_EQ(user_data_importer::TYPE_CHROMIUM, offered[0].importer_type);
+  EXPECT_EQ(profile, offered[0].source_path);
+  EXPECT_EQ("Chrome Safe Storage\nChrome", offered[0].locale);
+
+  base::ScopedTempDir empty;
+  ASSERT_TRUE(empty.CreateUniqueTempDir());
+  ChromiumBrowserLocation nowhere = browser;
+  nowhere.user_data_dir = empty.GetPath();
+  EXPECT_TRUE(DetectChromiumProfiles(nowhere).empty());
+}
+
+}  // namespace
+}  // namespace stedding
