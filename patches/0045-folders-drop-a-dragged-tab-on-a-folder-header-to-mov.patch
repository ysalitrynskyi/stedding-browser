+// Accepts a tab dragged onto a folder's header row, and moves it into that
+// folder (docs/features/folders.md, F7).
+//
+// Same shape as SpaceDragTarget, and the same dangerous part: HandleTabDrop
+// takes ownership of the tab it is handed and must put it back. Unlike the
+// Space target this lives inside the tab strip, so the drag controller asks
+// for it before it asks the strip itself; while a header is hovered the tab
+// stays attached to the strip rather than popping out into a window.
+class FolderDragTarget : public TabDragTarget {
+ public:
+  // `tab_strip_root` is the view whose descendants include the FolderViews;
+  // null means hit-testing is the caller's job (tests use SetHoveredFolder).
+  FolderDragTarget(TabStripModel& tabs, views::View* tab_strip_root);
+  FolderDragTarget(const FolderDragTarget&) = delete;
+  FolderDragTarget& operator=(const FolderDragTarget&) = delete;
+  ~FolderDragTarget() override;
+
+  // The FolderView whose header contains `point_in_screen`, or null.
+  FolderView* FolderViewAtScreenPoint(const gfx::Point& point_in_screen) const;
+
+  // Remembers which folder the pointer is over. `view` may be null; it is
+  // only used for the drop highlight.
+  void SetHoveredFolder(const tabs::TabCollection* folder, FolderView* view);
+  void ClearHoveredFolder();
+
+  // The drag session says whether the dragged tab is pinned; a test has no
+  // session, so it says so here.
+  void SetDraggedTabPinnedForTesting(bool pinned) { dragged_pinned_ = pinned; }
+
+  // TabDragTarget:
+  void OnTabDragEntered() override;
+  TabDragContext* OnTabDragUpdated(TabDragTarget::DragController& controller,
+                                   const gfx::Point& point_in_screen) override;
+  void OnTabDragExited(const gfx::Point& point_in_screen) override;
+  void OnTabDragEnded() override;
+  bool CanDropTab() override;
+  void HandleTabDrop(DragController& controller) override;
+  base::CallbackListSubscription RegisterWillDestroyCallback(
+      base::OnceClosure callback) override;
+
+ private:
+  static FolderView* FindFolderView(views::View& parent,
+                                    const gfx::Point& point_in_screen);
+
+  const raw_ref<TabStripModel> tabs_;
+  const raw_ptr<views::View> tab_strip_root_;
+  // A handle, not a pointer: the folder can be peeled out of the tree while
+  // the drag is in flight (its last tab is the one being dragged).
+  std::optional<tabs::TabCollectionHandle> hovered_;
+  raw_ptr<FolderView> hovered_view_ = nullptr;
+  // Whether the tab in flight is an essentials (pinned) tab. Read from the
+  // drag session on each update, because detaching clears the tab's own flag.
+  bool dragged_pinned_ = false;
+  base::OnceClosureList will_destroy_callbacks_;
