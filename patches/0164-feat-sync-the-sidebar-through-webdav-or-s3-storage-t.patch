+int64_t NowMs() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+// Another computer's sidebar: one Space with one pin.
+std::string PeerFile(int64_t seq,
+                     const std::string& space_name = "Peer Space") {
+  const std::string space = "0123456789ABCDEF0123456789ABCDEF";
+  const int64_t t = NowMs();
+  sb::State state;
+  const sb::Stamp stamp{t, kPeer};
+  sb::Record record(sb::Kind::kSpace);
+  record.f[sb::kFieldName] = sb::Field{space_name, stamp};
+  record.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+  record.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+  state.records[space] = record;
+  state.lists[sb::kSpacesList].order = {space};
+  state.lists[sb::kSpacesList].s = stamp;
+  sb::List& run = state.lists[sb::PinsListOf(space)];
+  run.s = stamp;
+  const std::string pin =
+      spaces::TabSyncId(base::Uuid::GenerateRandomV4().AsLowercaseString());
+  sb::Record tab(sb::Kind::kTab);
+  tab.f[sb::kFieldHome] = sb::Field{"https://peer.example/", stamp};
+  tab.f[sb::kFieldName] = sb::Field{"", stamp};
+  tab.f[sb::kFieldParent] = sb::Field{sb::PinsListOf(space), stamp};
+  state.records[pin] = tab;
+  run.order.push_back(pin);
+  sb::FileMeta meta;
+  meta.install = kPeer;
+  meta.device = "Office PC";
+  meta.seq = seq;
+  meta.nonce = sb::MakeInstallId();
+  meta.written_ms = t;
+  meta.hlc = state.MaxTime();
+  meta.joined_ms = 1;
+  return sb::SerializeSyncFile(state, meta);
+}
