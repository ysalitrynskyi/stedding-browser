+// pins H12: a drifted row shows the slash, a drifted card or rail row the
+// dot; nothing without drift.
+TEST(TabRowRulesTest, DriftShowsASlashOnRowsAndADotOnCards) {
+  TabRowState row;
+  EXPECT_TRUE(ShowsDriftSlash(row, true));
+  EXPECT_FALSE(ShowsDriftDot(row, true));
+  EXPECT_FALSE(ShowsDriftSlash(row, false));
+  EXPECT_FALSE(ShowsDriftDot(row, false));
+  TabRowState card;
