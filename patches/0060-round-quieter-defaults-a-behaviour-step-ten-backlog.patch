diff --git a/chrome/browser/ui/views/stedding/sidebar_resize_handle.cc b/chrome/browser/ui/views/stedding/sidebar_resize_handle.cc
new file mode 100644
index 0000000000000..8b12a9ec6d186
--- /dev/null
+++ b/chrome/browser/ui/views/stedding/sidebar_resize_handle.cc
@@ -0,0 +1,194 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/sidebar_resize_handle.h"
+
+#include <algorithm>
+#include <memory>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/compositor/layer.h"
+#include "ui/events/event.h"
+#include "ui/events/types/event_type.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/background.h"
+#include "ui/views/view.h"
+
+namespace stedding {
+
+SidebarResizeHandle::SidebarResizeHandle(views::ResizeAreaDelegate* delegate,
+                                         ui::ColorId bar_color,
+                                         base::RepeatingClosure reset)
+    : views::ResizeArea(delegate), reset_(std::move(reset)) {
+  auto bar = std::make_unique<views::View>();
+  // sidebar Y22: the bar is drawn past this view's bounds, over the card's
+  // gutter, so it paints to a layer of its own; the strip's layer clips only
+  // while the sidebar is hidden, which has no handle.
+  bar->SetPaintToLayer();
+  bar->layer()->SetFillsBoundsOpaquely(false);
+  bar->SetBackground(
+      views::CreateRoundedRectBackground(bar_color, kBarThickness / 2.0f));
+  // A picture only: presses go to the handle under it (or to nothing past
+  // the handle's reach), and the handle alone is in the accessibility tree.
+  bar->SetCanProcessEventsWithinSubtree(false);
+  bar->GetViewAccessibility().SetIsIgnored(true);
+  // The view's visibility rather than its layer's, so the handle reappearing
+  // (View::SetVisible updates its children's layers) cannot bring a stale bar
+  // back with it.
+  bar->SetVisible(false);
+  bar_ = AddChildView(std::move(bar));
+}
+
+SidebarResizeHandle::~SidebarResizeHandle() = default;
+
+void SidebarResizeHandle::SetReach(int reach) {
+  reach_ = reach;
+  LayoutBar();
+}
+
+bool SidebarResizeHandle::IsBarShowing() const {
+  return bar_->GetVisible();
+}
+
+bool SidebarResizeHandle::OnMousePressed(const ui::MouseEvent& event) {
+  const bool handled = views::ResizeArea::OnMousePressed(event);
+  if (handled) {
+    // sidebar Y22: a press shows the bar with no wait, for the whole drag.
+    hovered_ = true;
+    rested_ = true;
+    rest_timer_.Stop();
+    UpdateBar();
+  }
+  return handled;
+}
+
+bool SidebarResizeHandle::OnMouseDragged(const ui::MouseEvent& event) {
+  const bool handled = views::ResizeArea::OnMouseDragged(event);
+  UpdateBar();
+  return handled;
+}
+
+void SidebarResizeHandle::OnMouseReleased(const ui::MouseEvent& event) {
+  // sidebar Y22: a left double click whose second press did not drag resets
+  // the width. Read before the base class ends the resize.
+  const bool reset = !is_resizing() && event.IsOnlyLeftMouseButton() &&
+                     event.GetClickCount() == 2;
+  views::ResizeArea::OnMouseReleased(event);
+  if (reset) {
+    // The edge moves out from under the pointer: the bar waits for the
+    // pointer to be on the edge again.
+    ForgetPointer();
+    if (reset_) {
+      reset_.Run();
+    }
+  }
+  UpdateBar();
+}
+
+void SidebarResizeHandle::OnMouseCaptureLost() {
+  views::ResizeArea::OnMouseCaptureLost();
+  ForgetPointer();
+  UpdateBar();
+}
+
+void SidebarResizeHandle::OnGestureEvent(ui::GestureEvent* event) {
+  // sidebar Y22: on a touch screen a double tap does what a double click
+  // does. tap_count() is only defined for taps, hence the type check first.
+  const bool reset = !is_resizing() &&
+                     event->type() == ui::EventType::kGestureTap &&
+                     event->details().tap_count() == 2;
+  views::ResizeArea::OnGestureEvent(event);
+  if (reset) {
+    ForgetPointer();
+    if (reset_) {
+      reset_.Run();
+    }
+    event->SetHandled();
+  }
+  UpdateBar();
+}
+
+void SidebarResizeHandle::OnMouseEntered(const ui::MouseEvent& event) {
+  views::ResizeArea::OnMouseEntered(event);
+  hovered_ = true;
+  StartRest();
+}
+
+void SidebarResizeHandle::OnMouseMoved(const ui::MouseEvent& event) {
+  views::ResizeArea::OnMouseMoved(event);
+  // After a reset the pointer may still be on the edge with no new enter:
+  // its next move starts the rest again.
+  if (!hovered_) {
+    hovered_ = true;
+    StartRest();
+  }
+}
+
+void SidebarResizeHandle::OnMouseExited(const ui::MouseEvent& event) {
+  views::ResizeArea::OnMouseExited(event);
+  // sidebar Y22: leaving the edge hides the bar at once, and a pointer that
+  // only crossed it never showed one.
+  ForgetPointer();
+  UpdateBar();
+}
+
+void SidebarResizeHandle::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  views::ResizeArea::OnBoundsChanged(previous_bounds);
+  LayoutBar();
+}
+
+void SidebarResizeHandle::VisibilityChanged(views::View* starting_from,
+                                            bool is_visible) {
+  views::ResizeArea::VisibilityChanged(starting_from, is_visible);
+  // sidebar Y22: a handle that goes away (the sidebar hidden, a rail that
+  // expands on hover, full screen) comes back with no bar and no rest under
+  // way.
+  if (!is_visible) {
+    ForgetPointer();
+    bar_->SetVisible(false);
+  }
+}
+
+void SidebarResizeHandle::LayoutBar() {
+  // In the middle of the reach when the bar fits there, else along the
+  // inside of the trailing edge.
+  const int x = reach_ >= kBarThickness
+                    ? width() + (reach_ - kBarThickness) / 2
+                    : width() - kBarThickness;
+  bar_->SetBounds(x, kBarEndInset, kBarThickness,
+                  std::max(0, height() - 2 * kBarEndInset));
+}
+
+void SidebarResizeHandle::UpdateBar() {
+  bar_->SetVisible(GetVisible() && (is_resizing() || (hovered_ && rested_)));
+}
+
+void SidebarResizeHandle::StartRest() {
+  if (rested_ || rest_timer_.IsRunning()) {
+    return;
+  }
+  rest_timer_.Start(FROM_HERE, kRestDelay,
+                    base::BindOnce(&SidebarResizeHandle::OnRested,
+                                   base::Unretained(this)));
+}
+
+void SidebarResizeHandle::OnRested() {
+  rested_ = true;
+  UpdateBar();
+}
+
+void SidebarResizeHandle::ForgetPointer() {
+  hovered_ = false;
+  rested_ = false;
+  rest_timer_.Stop();
+}
+
+BEGIN_METADATA(SidebarResizeHandle)
+END_METADATA
+
+}  // namespace stedding
