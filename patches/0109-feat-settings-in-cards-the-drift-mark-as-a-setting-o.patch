+// Stedding commandbar K18 (BACKLOG S-352): whether the command bar may hand
+// a query typed in `context` to the extension: an enabled one, and in a
+// private window one allowed there, as the address field asks.
+bool SteddingMayHandOverKeyword(content::BrowserContext* context,
+                                const std::string& extension_id) {
+  if (!ExtensionRegistry::Get(context)->enabled_extensions().GetByID(
+          extension_id)) {
+    return false;
+  }
+  return !context->IsOffTheRecord() ||
+         util::IsIncognitoEnabled(extension_id, context);
+}
+
+}  // namespace
