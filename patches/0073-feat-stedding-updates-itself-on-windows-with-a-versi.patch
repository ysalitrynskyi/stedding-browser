@@ -0,0 +1,224 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/update_feed.h"
+
+#include <optional>
+#include <string>
+
+#include "base/base64.h"
+#include "base/containers/span.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "base/values.h"
+#include "services/data_decoder/public/cpp/data_decoder.h"
+#include "services/data_decoder/public/cpp/test_support/in_process_data_decoder.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/boringssl/src/include/openssl/curve25519.h"
+
+namespace stedding {
+namespace {
+
+// A key of the test's own: the release key's private half is never here.
+struct Key {
+  Key() { ED25519_keypair(public_key, private_key); }
+  std::string Public() const {
+    return base::Base64Encode(base::span(public_key));
+  }
+  std::string Sign(std::string_view data) const {
+    uint8_t signature[ED25519_SIGNATURE_LEN];
+    ED25519_sign(signature, reinterpret_cast<const uint8_t*>(data.data()),
+                 data.size(), private_key);
+    return base::Base64Encode(base::span(signature));
+  }
+  uint8_t public_key[ED25519_PUBLIC_KEY_LEN];
+  uint8_t private_key[ED25519_PRIVATE_KEY_LEN];
+};
+
+// The signed form tooling/appcast.py attach-signature writes, Sparkle's own.
+std::string Signed(std::string_view body, std::string_view signature) {
+  return base::StrCat({body, "<!-- sparkle-signatures:\nedSignature: ",
+                       signature, "\nlength: ",
+                       base::NumberToString(body.size()), "\n-->\n"});
+}
+
+constexpr char kBody[] =
+    "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<rss version=\"2.0\"/>\n";
+
+// updates Up15: the feed is read only when its signature, over every byte
+// before it, verifies against the key the build carries.
+TEST(UpdateFeedTest, OnlyAFeedSignedWithTheKeyIsRead) {
+  const Key key;
+  const std::string feed = Signed(kBody, key.Sign(kBody));
+  const std::optional<std::string_view> body =
+      SignedFeedBody(feed, key.Public());
+  ASSERT_TRUE(body);
+  EXPECT_EQ(kBody, *body);
+
+  EXPECT_FALSE(SignedFeedBody(kBody, key.Public())) << "unsigned";
+  EXPECT_FALSE(SignedFeedBody(feed, Key().Public())) << "another key";
+  std::string tampered = feed;
+  tampered[5] = 'X';
+  EXPECT_FALSE(SignedFeedBody(tampered, key.Public())) << "a changed byte";
+  // Text slipped in between the signed part and the signature.
+  const std::string shifted =
+      base::StrCat({kBody, " ", feed.substr(std::string(kBody).size())});
+  EXPECT_FALSE(SignedFeedBody(shifted, key.Public())) << "a moved comment";
+  EXPECT_FALSE(SignedFeedBody(Signed(kBody, "bm90IGEgc2lnbmF0dXJl"),
+                              key.Public()))
+      << "a malformed signature";
+  EXPECT_FALSE(SignedFeedBody(feed, "c2hvcnQ=")) << "a malformed key";
+}
+
+// updates Up16: an installer is run only when its bytes carry the key's
+// signature.
+TEST(UpdateFeedTest, AnInstallerVerifiesOnlyWithItsOwnSignature) {
+  const Key key;
+  const std::string installer = "MZ an installer's bytes";
+  const std::string signature = key.Sign(installer);
+  EXPECT_TRUE(SignatureVerifies(base::as_byte_span(installer), signature,
+                                key.Public()));
+  EXPECT_FALSE(SignatureVerifies(base::as_byte_span(std::string("MZ other")),
+                                 signature, key.Public()));
+  EXPECT_FALSE(SignatureVerifies(base::as_byte_span(installer), signature,
+                                 Key().Public()));
+  EXPECT_FALSE(SignatureVerifies(base::as_byte_span(installer), "", key.Public()));
+}
+
+// The release key is a key: 32 bytes once decoded.
+TEST(UpdateFeedTest, TheReleaseKeyIsAnEd25519PublicKey) {
+  const std::optional<std::vector<uint8_t>> key =
+      base::Base64Decode(kWindowsUpdatePublicKey);
+  ASSERT_TRUE(key);
+  EXPECT_EQ(static_cast<size_t>(ED25519_PUBLIC_KEY_LEN), key->size());
+  EXPECT_TRUE(GURL(kWindowsUpdateFeedUrl).SchemeIs("https"));
+}
+
+std::string Item(std::string_view version,
+                 std::string_view file_version,
+                 std::string_view url,
+                 std::string_view os = "windows-x64",
+                 std::string_view length = "176000000") {
+  return base::StrCat(
+      {"<item><title>Stedding</title>"
+       "<sparkle:version>",
+       file_version,
+       "</sparkle:version><sparkle:shortVersionString>", version,
+       "</sparkle:shortVersionString><enclosure url=\"", url, "\" length=\"",
+       length, "\" type=\"application/octet-stream\" sparkle:os=\"", os,
+       "\" sparkle:edSignature=\"c2ln\"/></item>"});
+}
+
+// updates Up14 (BACKLOG S-72): a Windows file version names its release, and
+// Chromium's own numbers name none.
+TEST(UpdateFeedTest, AWindowsVersionNamesItsRelease) {
+  EXPECT_EQ("0.2.0-beta.19",
+            SteddingVersionOfWindowsVersion(base::Version("156.2.0.19")));
+  EXPECT_EQ("0.2.0", SteddingVersionOfWindowsVersion(base::Version("156.2.0.999")));
+  EXPECT_EQ("1.12.3-beta.4",
+            SteddingVersionOfWindowsVersion(base::Version("157.112.3.4")));
+  EXPECT_EQ("", SteddingVersionOfWindowsVersion(base::Version("156.0.8000.10")));
+  EXPECT_EQ("", SteddingVersionOfWindowsVersion(base::Version("10020.17")));
+  EXPECT_EQ("", SteddingVersionOfWindowsVersion(base::Version()));
+}
+
+class UpdateFeedItemsTest : public testing::Test {
+ protected:
+  base::Value Parse(std::string_view items) {
+    const std::string xml = base::StrCat(
+        {"<?xml version=\"1.0\" encoding=\"utf-8\"?><rss version=\"2.0\" "
+         "xmlns:sparkle=\"http://www.andymatuschak.org/xml-namespaces/"
+         "sparkle\"><channel><title>Stedding</title>",
+         items, "</channel></rss>"});
+    base::test::TestFuture<data_decoder::DataDecoder::ValueOrError> parsed;
+    data_decoder::DataDecoder::ParseXmlIsolated(
+        xml, data_decoder::mojom::XmlParser::WhitespaceBehavior::kIgnore,
+        parsed.GetCallback());
+    EXPECT_TRUE(parsed.Get().has_value()) << parsed.Get().error();
+    return parsed.Get().has_value() ? parsed.Get()->Clone() : base::Value();
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  data_decoder::test::InProcessDataDecoder data_decoder_;
+};
+
+// updates Up14: the newest Windows x64 release later than the installed
+// version, and none when the installed one is the newest.
+TEST_F(UpdateFeedItemsTest, TheNewestLaterWindowsReleaseIsChosen) {
+  const std::string kRelease =
+      "https://github.com/o/r/releases/download/v0.2.0-beta.19/"
+      "Stedding-0.2.0-beta.19-win-x64.exe";
+  const base::Value feed = Parse(base::StrCat(
+      {Item("0.2.0-beta.17", "156.0.8000.10", kRelease),
+       Item("0.2.0-beta.19", "156.2.0.19", kRelease),
+       Item("0.2.0-beta.18", "156.2.0.18", kRelease),
+       // The Mac's item, in a feed that got one by mistake.
+       Item("0.2.0-beta.20", "10020.20", kRelease, "macos")}));
+
+  std::optional<UpdateItem> later =
+      LaterWindowsItem(feed, base::Version("156.2.0.18"),
+                       /*allow_local_http=*/false);
+  ASSERT_TRUE(later);
+  EXPECT_EQ("0.2.0-beta.19", later->version);
+  EXPECT_EQ(base::Version("156.2.0.19"), later->file_version);
+  EXPECT_EQ(GURL(kRelease), later->url);
+  EXPECT_EQ(176000000, later->length);
+  EXPECT_EQ("c2ln", later->signature);
+
+  later = LaterWindowsItem(feed, base::Version("156.0.8000.10"),
+                           /*allow_local_http=*/false);
+  ASSERT_TRUE(later) << "beta 18 and earlier carried Chromium's number";
+  EXPECT_EQ("0.2.0-beta.19", later->version);
+
+  EXPECT_FALSE(LaterWindowsItem(feed, base::Version("156.2.0.19"),
+                               /*allow_local_http=*/false))
+      << "the installed version is the newest";
+  EXPECT_FALSE(LaterWindowsItem(feed, base::Version("157.2.0.1"),
+                               /*allow_local_http=*/false))
+      << "a later milestone is never downgraded";
+}
+
+// An item missing a part, or one an address could not safely fetch, is
+// passed over: the next one is used.
+TEST_F(UpdateFeedItemsTest, AnIncompleteItemIsPassedOver) {
+  const base::Value feed = Parse(base::StrCat(
+      {Item("0.2.0-beta.21", "156.2.0.21", "http://example.com/i.exe"),
+       Item("0.2.0-beta.20", "156.2.0.20", "https://example.com/i.exe",
+            "windows-x64", "-1"),
+       Item("", "156.2.0.22", "https://example.com/i.exe"),
+       // The name becomes the download's file name.
+       Item("..\\..\\x", "156.2.0.23", "https://example.com/i.exe"),
+       Item("0.2.0-beta.19", "156.2", "https://example.com/i.exe"),
+       Item("0.2.0-beta.18", "156.2.0.18", "http://127.0.0.1:8765/i.exe")}));
+  EXPECT_FALSE(LaterWindowsItem(feed, base::Version("156.2.0.17"),
+                                /*allow_local_http=*/false))
+      << "plain http, even to this computer, from the real feed";
+  const std::optional<UpdateItem> later = LaterWindowsItem(
+      feed, base::Version("156.2.0.17"), /*allow_local_http=*/true);
+  ASSERT_TRUE(later);
+  EXPECT_EQ("0.2.0-beta.18", later->version)
+      << "http to this computer is the update test's server";
+}
+
+// updates Up15 (BACKLOG S-249): the newest Windows version a feed lists,
+// whatever is installed, to tell a feed served again later from a new one;
+// the Mac's item and a malformed version do not count.
+TEST_F(UpdateFeedItemsTest, TheNewestListedWindowsVersionIsRead) {
+  const std::string kRelease = "https://example.com/i.exe";
+  EXPECT_EQ(base::Version("156.2.0.20"),
+            NewestWindowsVersion(Parse(base::StrCat(
+                {Item("0.2.0-beta.19", "156.2.0.19", kRelease),
+                 Item("0.2.0-beta.20", "156.2.0.20", kRelease),
+                 Item("0.2.0-beta.21", "10020.21", kRelease, "macos"),
+                 Item("0.2.0-beta.22", "156.2", kRelease)}))));
+  EXPECT_FALSE(
+      NewestWindowsVersion(Parse(Item("0.2.0-beta.21", "10020.21", kRelease,
+                                      "macos")))
+          .IsValid());
+}
+
+}  // namespace
