+void LocationBarView::CentreSteddingCluster() {
+  // toolbar T18: the chip, the address and the page actions read as one
+  // cluster on the field's centre, as Safari's compact bar draws them,
+  // instead of the address hugging the field's left edge and the actions its
+  // right. Chromium's own layout stands while the address is being edited
+  // or the popup is open, and whenever the address fills the field. Works
+  // from the laid-out bounds: a field sized to a predicted content width
+  // elided "github.com" to "githu..." (2026-09-05).
+  if (!base::FeatureList::IsEnabled(stedding::kArcStyleWindow) ||
+      !IsInitialized() || omnibox_view_->HasFocus() ||
+      omnibox_controller_->IsPopupOpen() || ShouldShowKeywordBubble() ||
+      ime_inline_autocomplete_view_->GetVisible() ||
+      omnibox_additional_text_view_->GetVisible()) {
+    return;
+  }
+  const gfx::Rect box = omnibox_view_->bounds();
+  if (box.IsEmpty()) {
+    return;
+  }
+  constexpr int kSlack = 4;
+  const int text_width =
+      std::min(box.width(), omnibox_view_->GetUnelidedTextWidth() + kSlack);
+  if (text_width >= box.width()) {
+    return;
+  }
+  std::vector<views::View*> leading;
+  std::vector<views::View*> trailing;
+  for (views::View* child : children()) {
+    if (child == omnibox_view_ || !child->GetVisible() ||
+        child->bounds().IsEmpty()) {
+      continue;
+    }
+    if (child->bounds().right() <= box.x()) {
+      leading.push_back(child);
+    } else if (child->x() >= box.right()) {
+      trailing.push_back(child);
+    }
+  }
+  int lead_x = box.x();
+  for (const views::View* view : leading) {
+    lead_x = std::min(lead_x, view->x());
+  }
+  int trail_x = box.right();
+  int trail_right = box.right();
+  for (const views::View* view : trailing) {
+    trail_x = std::min(trail_x, view->x());
+    trail_right = std::max(trail_right, view->bounds().right());
+  }
+  const int padding =
+      GetLayoutConstant(LayoutConstant::kLocationBarElementPadding);
+  // The page actions keep the field's right edge, as Safari's do; the chip
+  // and the address centre in what is left of the field.
+  const int span_right = trailing.empty() ? trail_right : trail_x - padding;
+  const int group = (box.x() - lead_x) + text_width;
+  const int shift = std::max(0, (span_right - lead_x - group) / 2);
+  for (views::View* view : leading) {
+    view->SetX(view->x() + shift);
+  }
+  omnibox_view_->SetBounds(box.x() + shift, box.y(), text_width, box.height());
+}
