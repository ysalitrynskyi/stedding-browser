+using EditSpaceTest = InProcessBrowserTest;
+
+constexpr size_t kPaletteRow = 12;  // a row of the palette: the twelve hues
+
+spaces::SpaceModel& Model(BrowserWindowInterface* browser) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  CHECK(model);
+  return *model;
+}
+
+// Done or Cancel, as the dialog's own buttons do, and the window gone. The
+// widget is not read after the button: on Windows it is freed as it closes.
+void Close(spaces::EditSpaceView* view, bool done) {
+  views::Widget* const widget = view->GetWidget();
+  ASSERT_TRUE(widget);
+  views::DialogDelegate* const dialog =
+      widget->widget_delegate()->AsDialogDelegate();
+  ASSERT_TRUE(dialog);
+  views::test::WidgetDestroyedWaiter destroyed(widget);
+  if (done) {
+    dialog->AcceptDialog();
+  } else {
+    dialog->CancelDialog();
+  }
+  destroyed.Wait();
+}
+
+// spaces B41: the window holds the name, the icon and the colour; Done
+// applies them, Cancel leaves the Space as it was.
+IN_PROC_BROWSER_TEST_F(EditSpaceTest, TheWindowEditsTheSpaceAndCancelLeavesIt) {
+  spaces::SpaceModel& model = Model(browser());
+  const spaces::SpaceId id = model.active_id();
+  {
+    SCOPED_TRACE("Done applies the name, the icon and the colour");
+    spaces::EditSpaceView* const view =
+        spaces::ShowEditSpaceDialog(browser(), id);
+    ASSERT_TRUE(view);
+    view->name_field()->SetText(u"Work");
+    view->PressEmojiForTesting(1);
+    view->PressPaletteForTesting(kPaletteRow + 5);
+    ASSERT_NO_FATAL_FAILURE(Close(view, /*done=*/true));
+    const spaces::Space* const space = model.GetSpace(id);
+    ASSERT_TRUE(space);
+    EXPECT_EQ("Work", space->name());
+    EXPECT_EQ("\U0001F4BC", space->icon());
+    EXPECT_EQ(spaces::kSpaceColors.at(5).color, space->color());
+    EXPECT_FALSE(space->dark_color());
+    EXPECT_TRUE(space->color_chosen());
+  }
+  {
+    SCOPED_TRACE("Cancel leaves it");
+    spaces::EditSpaceView* const view =
+        spaces::ShowEditSpaceDialog(browser(), id);
+    ASSERT_TRUE(view);
+    view->name_field()->SetText(u"Elsewhere");
+    view->PressEmojiForTesting(2);
+    view->PressPaletteForTesting(kPaletteRow + 8);
+    ASSERT_NO_FATAL_FAILURE(Close(view, /*done=*/false));
+    const spaces::Space* const space = model.GetSpace(id);
+    ASSERT_TRUE(space);
+    EXPECT_EQ("Work", space->name());
+    EXPECT_EQ("\U0001F4BC", space->icon());
+    EXPECT_EQ(spaces::kSpaceColors.at(5).color, space->color());
+  }
+  {
+    SCOPED_TRACE("Done with nothing touched leaves the colour unchosen");
+    const spaces::SpaceId other = model.AddSpace("Other", SK_ColorGRAY)->id();
+    spaces::EditSpaceView* const view =
+        spaces::ShowEditSpaceDialog(browser(), other);
+    ASSERT_TRUE(view);
+    ASSERT_NO_FATAL_FAILURE(Close(view, /*done=*/true));
+    EXPECT_FALSE(model.GetSpace(other)->color_chosen());
+  }
+}
+
+// spaces B42: any emoji, the first character typed or pasted, kept whole;
+// No Icon gives the Space its dot again.
+IN_PROC_BROWSER_TEST_F(EditSpaceTest, AnyEmojiBecomesTheIcon) {
+  spaces::SpaceModel& model = Model(browser());
+  const spaces::SpaceId id = model.active_id();
+  spaces::EditSpaceView* view = spaces::ShowEditSpaceDialog(browser(), id);
+  ASSERT_TRUE(view);
+  view->TypeIconForTesting(u"\U0001F98A fox");
+  EXPECT_EQ("\U0001F98A", view->icon());
+  ASSERT_NO_FATAL_FAILURE(Close(view, /*done=*/true));
+  EXPECT_EQ("\U0001F98A", model.GetSpace(id)->icon());
+
+  view = spaces::ShowEditSpaceDialog(browser(), id);
+  ASSERT_TRUE(view);
+  view->TypeIconForTesting(u"\U0001F468‍\U0001F469‍\U0001F467");
+  EXPECT_EQ("\U0001F468‍\U0001F469‍\U0001F467", view->icon())
+      << "a family joined with zero-width joiners is one icon";
+  view->PressNoIconForTesting();
+  ASSERT_NO_FATAL_FAILURE(Close(view, /*done=*/true));
+  EXPECT_EQ("", model.GetSpace(id)->icon());
+}
+
+// spaces B43: a colour for each look. The window takes the light look's in
+// the light look and the dark look's in the dark one, at once when the look
+// changes; one colour again clears the pair.
+IN_PROC_BROWSER_TEST_F(EditSpaceTest, ALightAndDarkPairTintsEachLook) {
+  spaces::SpaceModel& model = Model(browser());
+  const spaces::SpaceId id = model.active_id();
+  ThemeService* const theme =
+      ThemeServiceFactory::GetForProfile(browser()->GetProfile());
+  theme->SetBrowserColorScheme(ThemeService::BrowserColorScheme::kLight);
+  const SkColor light = spaces::kSpaceColors.at(5).color;
+  constexpr SkColor kDark = SkColorSetRGB(0xDD, 0x44, 0x25);
+
+  spaces::EditSpaceView* view = spaces::ShowEditSpaceDialog(browser(), id);
+  ASSERT_TRUE(view);
+  view->ChoosePairForTesting(true);
+  view->EditDarkForTesting(false);
+  view->PressPaletteForTesting(kPaletteRow + 5);
+  view->EditDarkForTesting(true);
+  view->TypeHexForTesting(u"#dd4425");
+  EXPECT_EQ(light, view->light_color());
+  EXPECT_EQ(kDark, view->dark_color());
+  ASSERT_NO_FATAL_FAILURE(Close(view, /*done=*/true));
+  const spaces::Space* const space = model.GetSpace(id);
+  ASSERT_TRUE(space);
+  EXPECT_EQ(light, space->color());
+  EXPECT_EQ(std::optional<SkColor>(kDark), space->dark_color());
+
+  views::Widget* const window =
+      BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  {
+    SCOPED_TRACE("the light look");
