+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace stedding {
+
+namespace {
+
+// The lists are a few megabytes; anything far larger is not one.
+constexpr int64_t kMaxListBytes = 16 * 1024 * 1024;
+
+constexpr base::TimeDelta kFirstRetry = base::Hours(1);
+constexpr base::TimeDelta kExpiryWhenUnknown = base::Days(4);
+constexpr base::TimeDelta kFetchTimeout = base::Minutes(2);
+
+// Keys of the state in prefs::kBlockerLists.
+constexpr char kEtagKey[] = "etag";
+constexpr char kLastModifiedKey[] = "last_modified";
+constexpr char kFetchedKey[] = "fetched";
+constexpr char kNextKey[] = "next";
+constexpr char kExpiryHoursKey[] = "expiry_hours";
+constexpr char kFailuresKey[] = "failures";
+constexpr char kStoredKey[] = "stored";
+constexpr char kRulesetKey[] = "ruleset";
+constexpr char kVersionKey[] = "version";
+constexpr char kTimeKey[] = "time";
+constexpr char kUrlRulesKey[] = "url_rules";
+constexpr char kSkippedKey[] = "skipped";
+constexpr char kSaltKey[] = "salt";
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("stedding_blocker_lists", R"(
+        semantics {
+          sender: "Stedding ad and tracker blocking"
+          description:
+            "While the user has turned on Block ads and trackers, Stedding "
+            "downloads the filter lists that are on (EasyList, EasyPrivacy) "
+            "from their own homepage, each when the list's own expiry says, "
+            "and converts them on this computer into the rules the browser "
+            "blocks requests by."
+          trigger:
+            "Turning blocking on, a list's expiry (between one and fourteen "
+            "days), and the user's Update lists now."
+          data:
+            "None: a plain conditional GET with no cookies, no cache and no "
+            "query string."
+          destination: OTHER
+          destination_other: "easylist.to"
+          # Contact: the repository's Security tab (SECURITY.md).
+          user_data { type: NONE }
+          last_reviewed: "2026-10-25"
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Settings > Stedding > Privacy > Block ads and trackers, off by "
+            "default."
+          policy_exception_justification:
+            "Not implemented: the setting is off by default and turns it off."
+        })");
+
+base::TimeDelta ExpiryFrom(const base::DictValue* state) {
+  if (!state) {
+    return kExpiryWhenUnknown;
+  }
+  const std::optional<int> hours = state->FindInt(kExpiryHoursKey);
+  return hours && *hours > 0 ? base::Hours(*hours) : kExpiryWhenUnknown;
+}
+
+// Off the UI thread: the download checked and put in its place. Nothing,
+// and the stored list kept, when it is not a filter list (Bk3).
+std::optional<base::TimeDelta> StoreList(const base::FilePath& download,
+                                         const base::FilePath& path) {
+  std::string text;
+  const bool read =
+      base::ReadFileToStringWithMaxSize(download, &text, kMaxListBytes);
+  base::DeleteFile(download);
+  if (!read || !LooksLikeFilterList(text) ||
+      !base::CreateDirectory(path.DirName()) ||
+      !base::ImportantFileWriter::WriteFileAtomically(path, text)) {
+    return std::nullopt;
+  }
+  return ListExpiry(text);
+}
+
+BlockerLists* g_lists = nullptr;
+
+}  // namespace
+
+BlockerLists::Environment::Environment() = default;
+BlockerLists::Environment::Environment(Environment&&) = default;
+BlockerLists::Environment& BlockerLists::Environment::operator=(
+    Environment&&) = default;
+BlockerLists::Environment::~Environment() = default;
+
+BlockerLists::Status::Status() = default;
+BlockerLists::Status::Status(const Status&) = default;
+BlockerLists::Status& BlockerLists::Status::operator=(const Status&) = default;
+BlockerLists::Status::~Status() = default;
+
+// static
+const std::vector<BlockerLists::ListSpec>& BlockerLists::Specs() {
+  static const base::NoDestructor<std::vector<ListSpec>> specs(
+      std::vector<ListSpec>{
+          {"easylist", "EasyList", "easylist.txt", "https://easylist.to/",
+           "GPL-3.0-or-later or CC BY-SA 3.0", prefs::kBlockerEasyList},
+          {"easyprivacy", "EasyPrivacy", "easyprivacy.txt",
+           "https://easylist.to/", "GPL-3.0-or-later or CC BY-SA 3.0",
+           prefs::kBlockerEasyPrivacy},
+      });
+  return *specs;
+}
+
+BlockerLists::BlockerLists(Environment environment)
+    : env_(std::move(environment)),
+      // The priority goes up while the user waits for a list (Bk11); a
+      // runner raised from BEST_EFFORT names its thread policy (ThreadPool
+      // DCHECKs on one that does not).
+      file_task_runner_(base::ThreadPool::CreateUpdateableSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+           base::ThreadPolicy::MUST_USE_FOREGROUND,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN})) {}
+
+BlockerLists::~BlockerLists() {
+  if (g_lists == this) {
+    g_lists = nullptr;
+  }
+}
+
+// static
+BlockerLists* BlockerLists::Get() {
+  return g_lists;
+}
+
+// static
+void BlockerLists::SetInstance(BlockerLists* lists) {
+  g_lists = lists;
+}
+
+void BlockerLists::Start() {
+  if (!env_.local_state) {
+    return;
+  }
+  registrar_.Init(env_.local_state);
+  const base::RepeatingClosure changed = base::BindRepeating(
+      &BlockerLists::OnPrefsChanged, base::Unretained(this));
+  registrar_.Add(prefs::kBlockerEnabled, changed);
+  for (const ListSpec& spec : Specs()) {
+    registrar_.Add(spec.pref, changed);
+  }
+  start_time_ = base::Time::Now();
+  was_on_ = BlockerOn(env_.local_state);
+  if (!was_on_) {
+    return;
+  }
+  // A ruleset recorded here that the service never indexed (a quit during
+  // indexing, or a crash in it, which leaves that version barred) is made
+  // again under a new salt.
+  if (RulesetMissing()) {
+    BumpSaltIfRecorded();
+    Convert();
+  }
+  Schedule();
+}
+
+void BlockerLists::UpdateNow() {
+  if (!BlockerOn(env_.local_state)) {
+    return;
+  }
+  at_launch_ = false;
+  file_task_runner_->UpdatePriority(base::TaskPriority::USER_VISIBLE);
+  if (RulesetMissing()) {
+    BumpSaltIfRecorded();
+  }
+  for (const ListSpec& spec : Specs()) {
+    if (ListOn(spec)) {
+      Fetch(spec, /*user_visible=*/true);
+    }
+  }
+  NotifyChanged();
+}
+
+BlockerLists::Status BlockerLists::GetStatus() const {
+  Status status;
+  status.on = BlockerOn(env_.local_state);
+  status.busy = !loaders_.empty() || converting_;
+  if (const base::DictValue* ruleset = State().FindDict(kRulesetKey)) {
+    const std::string* version = ruleset->FindString(kVersionKey);
+    status.has_ruleset = version && !version->empty();
+    status.content_version = version ? *version : std::string();
+    status.updated =
+        base::ValueToTime(ruleset->Find(kTimeKey)).value_or(base::Time());
+    status.url_rules = ruleset->FindInt(kUrlRulesKey).value_or(0);
+    status.skipped_lines = ruleset->FindInt(kSkippedKey).value_or(0);
+  }
+  for (const ListSpec& spec : Specs()) {
+    ListStatus list;
+    list.id = std::string(spec.id);
+    list.name = std::string(spec.name);
+    list.homepage = std::string(spec.homepage);
+    list.licence = std::string(spec.licence);
+    list.enabled = env_.local_state &&
+                   env_.local_state->GetBoolean(spec.pref);
+    if (const base::DictValue* state = ListState(spec)) {
+      list.fetched =
+          base::ValueToTime(state->Find(kFetchedKey)).value_or(base::Time());
+      list.failing = state->FindInt(kFailuresKey).value_or(0) > 0;
+    }
+    status.lists.push_back(std::move(list));
+  }
+  return status;
+}
+
+void BlockerLists::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void BlockerLists::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+base::Time BlockerLists::NextFetchForTesting(std::string_view id) const {
+  const ListSpec* const spec = SpecFor(id);
+  if (!spec) {
+    return base::Time();
+  }
+  const base::DictValue* const state = ListState(*spec);
+  return state ? base::ValueToTime(state->Find(kNextKey)).value_or(base::Time())
+               : base::Time();
+}
+
+const base::DictValue& BlockerLists::State() const {
+  static const base::NoDestructor<base::DictValue> empty;
+  return env_.local_state ? env_.local_state->GetDict(prefs::kBlockerLists)
+                          : *empty;
+}
+
+const base::DictValue* BlockerLists::ListState(const ListSpec& spec) const {
+  return State().FindDict(spec.id);
+}
+
+const BlockerLists::ListSpec* BlockerLists::SpecFor(std::string_view id) const {
+  for (const ListSpec& spec : Specs()) {
+    if (spec.id == id) {
+      return &spec;
+    }
+  }
+  return nullptr;
+}
+
+bool BlockerLists::ListOn(const ListSpec& spec) const {
+  return BlockerOn(env_.local_state) && env_.local_state->GetBoolean(spec.pref);
+}
+
+bool BlockerLists::HasStoredList(const ListSpec& spec) const {
+  const base::DictValue* const state = ListState(spec);
+  return state && state->FindBool(kStoredKey).value_or(false);
+}
+
+base::FilePath BlockerLists::ListPath(const ListSpec& spec) const {
+  return env_.dir.AppendASCII(spec.file);
+}
+
+std::string BlockerLists::RecordedVersion() const {
+  if (const base::DictValue* ruleset = State().FindDict(kRulesetKey)) {
+    if (const std::string* version = ruleset->FindString(kVersionKey)) {
+      return *version;
+    }
+  }
+  return std::string();
+}
+
+bool BlockerLists::RulesetMissing() const {
+  const std::string recorded = RecordedVersion();
+  if (recorded.empty()) {
+    // None made yet: one is due as soon as a list is stored.
+    return std::ranges::any_of(Specs(), [this](const ListSpec& spec) {
+      return ListOn(spec) && HasStoredList(spec);
+    });
+  }
+  return env_.indexed_version.is_null() ||
+         env_.indexed_version.Run() != recorded;
+}
+
+void BlockerLists::BumpSaltIfRecorded() {
+  if (RecordedVersion().empty()) {
+    return;
+  }
+  ScopedDictPrefUpdate update(env_.local_state, prefs::kBlockerLists);
+  update->Set(kSaltKey, update->FindInt(kSaltKey).value_or(0) + 1);
+}
+
+void BlockerLists::OnPrefsChanged() {
+  const bool on = BlockerOn(env_.local_state);
+  if (!on) {
+    // Bk2: nothing is fetched while the switch is off; a fetch under way is
+    // cancelled.
+    timer_.Stop();
+    loaders_.clear();
+    was_on_ = false;
+    NotifyChanged();
+    return;
+  }
+  if (!was_on_) {
+    // Turned on here: the first lists come now, not after the launch delay.
+    at_launch_ = false;
+  }
+  was_on_ = true;
+  // A list turned on or off changes the ruleset; the same lists give the
+  // same version, which the ruleset service skips.
+  Convert();
+  Schedule();
+  NotifyChanged();
+}
+
+base::Time BlockerLists::NextFetch(const ListSpec& spec) const {
+  // Never fetched: due now. Otherwise when the list's expiry, or a retry
+  // after a failure, says.
+  const base::DictValue* const state = ListState(spec);
+  return state ? base::ValueToTime(state->Find(kNextKey)).value_or(base::Time())
+               : base::Time();
+}
+
+void BlockerLists::Schedule() {
+  timer_.Stop();
+  if (!BlockerOn(env_.local_state)) {
+    return;
+  }
+  base::Time earliest = base::Time::Max();
+  for (const ListSpec& spec : Specs()) {
+    if (!ListOn(spec) || loaders_.contains(spec.id)) {
+      continue;
+    }
+    earliest = std::min(earliest, NextFetch(spec));
+  }
+  if (earliest.is_max()) {
+    return;
+  }
+  if (at_launch_) {
+    earliest = std::max(earliest, start_time_ + env_.launch_delay);
+  }
+  timer_.Start(FROM_HERE, std::max(earliest, base::Time::Now()),
+               base::BindOnce(&BlockerLists::FetchDue, base::Unretained(this)));
+}
+
+void BlockerLists::FetchDue() {
+  at_launch_ = false;
+  const base::Time now = base::Time::Now();
+  for (const ListSpec& spec : Specs()) {
+    if (ListOn(spec) && !loaders_.contains(spec.id) && NextFetch(spec) <= now) {
+      Fetch(spec, /*user_visible=*/false);
+    }
+  }
+  Schedule();
+}
+
+void BlockerLists::Fetch(const ListSpec& spec, bool user_visible) {
+  if (loaders_.contains(spec.id) || !env_.url_loader_factory ||
+      !env_.list_base.is_valid()) {
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  // Bk12: the list's own address, with no query string.
+  request->url = env_.list_base.Resolve(spec.file);
+  request->method = "GET";
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE;
+  request->priority = user_visible ? net::MEDIUM : net::IDLE;
+  if (const base::DictValue* state = ListState(spec);
+      state && HasStoredList(spec)) {
+    // Bk2: a conditional request; the list answers 304 when unchanged.
+    if (const std::string* etag = state->FindString(kEtagKey);
+        etag && !etag->empty()) {
+      request->headers.SetHeader(net::HttpRequestHeaders::kIfNoneMatch, *etag);
+    }
+    if (const std::string* modified = state->FindString(kLastModifiedKey);
+        modified && !modified->empty()) {
+      request->headers.SetHeader(net::HttpRequestHeaders::kIfModifiedSince,
+                                 *modified);
+    }
+  }
+  std::unique_ptr<network::SimpleURLLoader> loader =
+      network::SimpleURLLoader::Create(std::move(request), kTrafficAnnotation);
+  // A 304 is an answer, not a failure.
+  loader->SetAllowHttpErrorResults(true);
+  loader->SetTimeoutDuration(kFetchTimeout);
+  network::SimpleURLLoader* const raw = loader.get();
+  loaders_.emplace(std::string(spec.id), std::move(loader));
+  ++fetches_started_;
+  raw->DownloadToTempFile(
+      env_.url_loader_factory.get(),
+      base::BindOnce(&BlockerLists::OnFetched, weak_factory_.GetWeakPtr(),
+                     std::string(spec.id)),
+      kMaxListBytes);
+  NotifyChanged();
+}
+
+void BlockerLists::OnFetched(std::string id, base::FilePath download) {
+  const auto it = loaders_.find(id);
+  if (it == loaders_.end()) {
+    return;
+  }
+  // The list stays in flight, its entry empty, until it is stored or found
+  // wanting: another list's turn in between found it due and fetched it
+  // again.
+  const std::unique_ptr<network::SimpleURLLoader> loader =
+      std::move(it->second);
+  const ListSpec* const spec = SpecFor(id);
+  const network::mojom::URLResponseHead* const head = loader->ResponseInfo();
+  const int code =
+      head && head->headers ? head->headers->response_code() : 0;
+  const bool answered = spec && loader->NetError() == net::OK;
+  if (!answered || code != 200 || download.empty()) {
+    // A 304 has no body to keep, whether or not an empty file came with it.
+    if (!download.empty()) {
+      file_task_runner_->PostTask(FROM_HERE,
+                                  base::GetDeleteFileCallback(download));
+    }
+    loaders_.erase(id);
+    if (answered && code == 304) {
+      OnNotModified(id);
+    } else {
+      FetchFailed(id);
+    }
+    return;
+  }
+  std::string etag =
+      head->headers->GetNormalizedHeader("ETag").value_or(std::string());
+  // Last-Modified is a header that is never joined with commas: its first
+  // value, read as such (GetNormalizedHeader DCHECKs on it).
+  size_t iter = 0;
+  std::string last_modified(
+      head->headers
+          ->EnumerateHeader(&iter, net::HttpResponseHeaders::kLastModified)
+          .value_or(std::string_view()));
+  file_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE, base::BindOnce(&StoreList, download, ListPath(*spec)),
+      base::BindOnce(&BlockerLists::OnStored, weak_factory_.GetWeakPtr(), id,
+                     std::move(etag), std::move(last_modified)));
+}
+
+void BlockerLists::OnNotModified(const std::string& id) {
+  {
+    ScopedDictPrefUpdate update(env_.local_state, prefs::kBlockerLists);
+    base::DictValue* const state = update->EnsureDict(id);
+    const base::Time now = base::Time::Now();
+    state->Set(kFetchedKey, base::TimeToValue(now));
+    state->Set(kNextKey, base::TimeToValue(now + ExpiryFrom(state)));
+    state->Set(kFailuresKey, 0);
+  }
+  if (RulesetMissing()) {
+    Convert();
+  }
+  Schedule();
+  NotifyChanged();
+}
+
+void BlockerLists::OnStored(std::string id,
+                            std::string etag,
+                            std::string last_modified,
+                            std::optional<base::TimeDelta> expiry) {
+  loaders_.erase(id);
+  if (!expiry) {
+    // Bk3: not a filter list; the stored one stays.
+    FetchFailed(id);
+    return;
+  }
+  {
+    ScopedDictPrefUpdate update(env_.local_state, prefs::kBlockerLists);
+    base::DictValue* const state = update->EnsureDict(id);
+    const base::Time now = base::Time::Now();
+    state->Set(kEtagKey, std::move(etag));
+    state->Set(kLastModifiedKey, std::move(last_modified));
+    state->Set(kFetchedKey, base::TimeToValue(now));
+    state->Set(kNextKey, base::TimeToValue(now + *expiry));
+    state->Set(kExpiryHoursKey, static_cast<int>(expiry->InHours()));
+    state->Set(kFailuresKey, 0);
+    state->Set(kStoredKey, true);
+  }
+  Convert();
+  Schedule();
+  NotifyChanged();
+}
+
+void BlockerLists::FetchFailed(const std::string& id) {
+  {
+    ScopedDictPrefUpdate update(env_.local_state, prefs::kBlockerLists);
+    base::DictValue* const state = update->EnsureDict(id);
+    const int failures = state->FindInt(kFailuresKey).value_or(0) + 1;
+    state->Set(kFailuresKey, failures);
+    // Bk2: an hour, then twice as long each time, up to the list's expiry.
+    const base::TimeDelta wait =
+        std::min(kFirstRetry * (1 << std::min(failures - 1, 10)),
+                 ExpiryFrom(state));
+    state->Set(kNextKey, base::TimeToValue(base::Time::Now() + wait));
+  }
+  Schedule();
+  NotifyChanged();
+}
+
+void BlockerLists::Convert() {
+  if (!BlockerOn(env_.local_state)) {
+    return;
+  }
+  if (converting_) {
+    convert_again_ = true;
+    return;
+  }
+  std::vector<ListSource> sources;
+  for (const ListSpec& spec : Specs()) {
+    if (ListOn(spec) && HasStoredList(spec)) {
+      sources.push_back({std::string(spec.id), std::string(spec.name),
+                         std::string(spec.homepage), std::string(spec.licence),
+                         ListPath(spec)});
+    }
+  }
+  if (sources.empty()) {
+    return;
+  }
+  converting_ = true;
+  const std::string salt =
+      base::NumberToString(State().FindInt(kSaltKey).value_or(0));
+  file_task_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](const std::vector<ListSource>& lists, const base::FilePath& dir,
+             const std::string& salt, size_t minimum_rules) {
+            return ConvertLists(lists, dir, salt, minimum_rules);
+          },
+          std::move(sources), env_.dir.AppendASCII("ruleset"), salt,
+          env_.minimum_rules),
+      base::BindOnce(&BlockerLists::OnConverted, weak_factory_.GetWeakPtr()));
+  NotifyChanged();
+}
+
+void BlockerLists::OnConverted(const ConvertResult& result) {
+  converting_ = false;
+  file_task_runner_->UpdatePriority(base::TaskPriority::BEST_EFFORT);
+  if (result.ok && BlockerOn(env_.local_state)) {
+    {
+      ScopedDictPrefUpdate update(env_.local_state, prefs::kBlockerLists);
+      base::DictValue ruleset;
+      ruleset.Set(kVersionKey, result.content_version);
+      ruleset.Set(kTimeKey, base::TimeToValue(base::Time::Now()));
+      ruleset.Set(kUrlRulesKey, result.url_rules);
+      ruleset.Set(kSkippedKey, result.skipped_lines);
+      update->Set(kRulesetKey, std::move(ruleset));
+    }
+    if (!env_.publish.is_null() &&
+        (env_.indexed_version.is_null() ||
+         env_.indexed_version.Run() != result.content_version)) {
+      subresource_filter::UnindexedRulesetInfo info;
+      info.content_version = result.content_version;
+      info.ruleset_path = result.ruleset_path;
+      info.license_path = result.license_path;
+      env_.publish.Run(info);
+    }
+  }
+  if (convert_again_) {
+    convert_again_ = false;
+    Convert();
+  }
+  NotifyChanged();
+}
+
+void BlockerLists::NotifyChanged() {
+  for (Observer& observer : observers_) {
+    observer.OnBlockerListsChanged();
+  }
+}
+
+}  // namespace stedding
