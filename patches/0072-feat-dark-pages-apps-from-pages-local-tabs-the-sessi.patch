+// The canvas probe: what a page's `canvas` colour is for an element that
+// asks for light. Blink paints that element's background in the darkened
+// canvas colour while dark pages applies to the page, and white otherwise
+// (Chrome's blog "Auto Dark Theme" documents the trick).
+constexpr char kCanvasProbe[] = R"(
+  (() => {
+    const probe = document.createElement('div');
+    probe.style.cssText = 'background-color: canvas; color-scheme: light;';
+    document.documentElement.appendChild(probe);
+    const colour = getComputedStyle(probe).backgroundColor;
+    probe.remove();
+    return colour;
+  })())";
+constexpr char kDark[] = "rgb(18, 18, 18)";
+constexpr char kLight[] = "rgb(255, 255, 255)";
+
+// The pages the tests load, by path; "/dark/framed" embeds b.test's white
+// page in a cross-site frame.
+constexpr char kWhitePage[] = R"(<!doctype html>
+<meta charset="utf-8"><title>white</title>
+<body style="margin:0; background:#ffffff; color:#000000; height:3000px">
+<div id="badge" style="position:fixed; top:10px; left:10px; width:40px;
+    height:20px; background:#ffffff"></div>
+<input id="field">
+<p>Some text on a white page.</p>
+</body>)";
+
+constexpr char kOwnThemePage[] = R"(<!doctype html>
+<meta charset="utf-8"><meta name="color-scheme" content="light dark">
+<title>own theme</title>
+<style>
+  body { margin: 0; height: 2000px; background: #ffffff; }
+  @media (prefers-color-scheme: dark) {
+    body { background: rgb(30, 41, 59); }
+  }
+</style>
+<body><p>A page with a dark theme of its own.</p></body>)";
+
+constexpr char kOnlyLightPage[] = R"(<!doctype html>
+<meta charset="utf-8"><meta name="color-scheme" content="only light">
+<title>only light</title>
+<body style="margin:0; background:#ffffff; height:2000px">
+<p>A page that asks to stay light.</p></body>)";
+
+constexpr char kMediaPage[] = R"(<!doctype html>
+<meta charset="utf-8"><title>media</title>
+<body style="margin:0; background:#ffffff">
+<canvas id="canvas" width="200" height="200"
+    style="position:absolute; left:0; top:0"></canvas>
+<img id="photo" width="200" height="200"
+    style="position:absolute; left:220px; top:0">
+<script>
+  const canvas = document.getElementById('canvas').getContext('2d');
+  canvas.fillStyle = '#ffffff';
+  canvas.fillRect(0, 0, 200, 200);
+  // A photo: many colours, larger than an icon, with a white patch at its
+  // middle that an inversion would turn dark.
+  const source = document.createElement('canvas');
+  source.width = 200;
+  source.height = 200;
+  const draw = source.getContext('2d');
+  for (let y = 0; y < 200; y += 10) {
+    for (let x = 0; x < 200; x += 10) {
+      const [r, g, b] = [(x * 7) % 256, (y * 5) % 256, (x + y) % 256];
+      draw.fillStyle = `rgb(${r}, ${g}, ${b})`;
+      draw.fillRect(x, y, 10, 10);
+    }
+  }
+  draw.fillStyle = '#ffffff';
+  draw.fillRect(80, 80, 40, 40);
+  window.photoReady = new Promise(resolve => {
+    const photo = document.getElementById('photo');
+    photo.onload = () => photo.decode().then(resolve);
+    photo.src = source.toDataURL('image/png');
+  });
+</script>
+</body>)";
+
+std::unique_ptr<net::test_server::HttpResponse> Html(std::string body) {
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_code(net::HTTP_OK);
+  response->set_content_type("text/html");
+  response->set_content(std::move(body));
+  return response;
+}
+
+bool Near(SkColor a, SkColor b, int tolerance = 3) {
+  // Not "near": windows.h defines near and far as macros.
+  const auto within = [&](U8CPU x, U8CPU y) {
+    return std::abs(static_cast<int>(x) - static_cast<int>(y)) <= tolerance;
+  };
+  return within(SkColorGetR(a), SkColorGetR(b)) &&
+         within(SkColorGetG(a), SkColorGetG(b)) &&
+         within(SkColorGetB(a), SkColorGetB(b));
+}
+
+class DarkPagesTest : public InProcessBrowserTest {
+ protected:
+  // The tests read the page's pixels. Off the Mac, a browser test draws
+  // nothing unless it asks: every pixel read back transparent there
+  // (trap 113). The Mac draws anyway, at the screen's own scale, which the
+  // call would force to 1.
+  DarkPagesTest() {
+#if defined(USE_AURA)
+    EnablePixelOutput();
+#endif
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    embedded_test_server()->RegisterRequestHandler(
+        base::BindRepeating(&DarkPagesTest::Serve, base::Unretained(this)));
+    ASSERT_TRUE(embedded_test_server()->Start());
+    UseWindowScheme(ThemeService::BrowserColorScheme::kLight);
+    // Room for the pixels the tests read, in the screen's work area.
+    BrowserView::GetBrowserViewForBrowser(browser())->GetWidget()->SetBounds(
+        gfx::Rect(
+            display::Screen::Get()->GetPrimaryDisplay().work_area().origin(),
+            gfx::Size(1400, 900)));
+  }
+
+  std::unique_ptr<net::test_server::HttpResponse> Serve(
+      const net::test_server::HttpRequest& request) {
+    const std::string path(request.GetURL().path());
+    if (path == "/dark/white") {
+      return Html(kWhitePage);
+    }
+    if (path == "/dark/own_theme") {
+      return Html(kOwnThemePage);
+    }
+    if (path == "/dark/only_light") {
+      return Html(kOnlyLightPage);
+    }
+    if (path == "/dark/media") {
+      return Html(kMediaPage);
+    }
+    if (path == "/dark/redirect") {
+      // To the address in the query, as a link shortener sends a click on.
+      auto redirect = std::make_unique<net::test_server::BasicHttpResponse>();
+      redirect->set_code(net::HTTP_FOUND);
+      redirect->AddCustomHeader("Location",
+                                std::string(request.GetURL().query()));
+      return redirect;
+    }
+    if (path == "/dark/framed") {
+      return Html(base::StrCat(
+          {R"(<!doctype html><title>framed</title>
+<body style="margin:0; background:#ffffff">
+<iframe id="frame" style="width:400px; height:300px; border:0" src=")",
+           embedded_test_server()->GetURL("b.test", "/dark/white").spec(),
+           R"("></iframe></body>)"}));
+    }
+    if (path == "/dark/only_light_frame") {
+      return Html(base::StrCat(
+          {R"(<!doctype html><title>only light frame</title>
+<body style="margin:0; background:#ffffff">
+<iframe id="frame" style="position:absolute; left:0; top:0; width:400px;
+    height:300px; border:0" src=")",
+           embedded_test_server()->GetURL("b.test", "/dark/only_light").spec(),
+           R"("></iframe></body>)"}));
+    }
+    return nullptr;
+  }
+
+  Profile* profile() { return browser()->GetProfile(); }
+
+  content::WebContents* page(BrowserWindowInterface* window = nullptr) {
+    return (window ? window : browser())
+        ->GetTabStripModel()
+        ->GetActiveWebContents();
+  }
+
+  GURL Url(std::string_view host, std::string_view path = "/dark/white") {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  void UseWindowScheme(ThemeService::BrowserColorScheme scheme) {
+    ThemeServiceFactory::GetForProfile(profile())->SetBrowserColorScheme(
+        scheme);
+  }
+
+  static std::string Probe(const content::ToRenderFrameHost& target) {
+    return content::EvalJs(target, kCanvasProbe).ExtractString();
+  }
+
+  // Until the probe reads `expected`: a change of the switch or a list
+  // reaches the renderer as new web preferences, a moment later.
+  [[nodiscard]] static bool WaitForProbe(
+      const content::ToRenderFrameHost& target,
+      std::string_view expected) {
+    return base::test::RunUntil([&]() { return Probe(target) == expected; });
+  }
+
+  // The colour `contents` paints at `point` (DIP, in its viewport), from a
+  // copy of its surface; nothing before it has a frame to copy.
+  static std::optional<SkColor> PixelAt(content::WebContents* contents,
+                                        const gfx::Point& point) {
+    content::RenderWidgetHostView* const view =
+        contents->GetRenderWidgetHostView();
+    if (!view || !view->IsSurfaceAvailableForCopy()) {
+      return std::nullopt;
+    }
+    std::optional<SkColor> colour;
+    base::RunLoop copied;
+    // The copy may answer on another sequence, as the row's sampler knows.
+    view->CopyFromSurface(
+        gfx::Rect(point, gfx::Size(1, 1)), gfx::Size(1, 1), base::Seconds(5),
+        base::BindPostTaskToCurrentDefault(base::BindLambdaForTesting(
+            [&](const content::CopyFromSurfaceResult& result) {
+              if (result.has_value() && !result->bitmap.drawsNothing()) {
+                colour = result->bitmap.getColor(0, 0);
+              }
+              copied.Quit();
+            })));
+    copied.Run();
+    return colour;
+  }
+
+  // Until `contents` paints a colour near `expected` at `point`. A wait that
+  // ends without it says what was read last, and the size of the view read.
+  [[nodiscard]] static testing::AssertionResult WaitForPixel(
+      content::WebContents* contents,
+      const gfx::Point& point,
+      SkColor expected) {
+    std::optional<SkColor> last;
+    if (base::test::RunUntil([&]() {
+          last = PixelAt(contents, point);
+          return last && Near(*last, expected);
+        })) {
+      return testing::AssertionSuccess();
+    }
+    content::RenderWidgetHostView* const view =
+        contents->GetRenderWidgetHostView();
+    return testing::AssertionFailure()
+           << "at " << point.ToString() << " the last read was "
+           << (last ? color_utils::SkColorToRgbaString(*last)
+                    : std::string("nothing"))
+           << ", not " << color_utils::SkColorToRgbaString(expected)
+           << ", in a view of "
+           << (view ? view->GetViewBounds().size().ToString()
+                    : std::string("none"));
+  }
+
+  static bool ForcedDark(content::WebContents* contents) {
+    return contents->GetOrCreateWebPreferences().force_dark_mode_enabled;
+  }
+
+  void Keep(
+      std::string_view host,
+      stedding::DarkPagesMode mode = stedding::DarkPagesMode::kAllExcept) {
+    stedding::AddDarkPagesSite(profile(), mode,
+                               *stedding::DarkPagesSitePatternFor(Url(host)));
+  }
+};
+
+// Dk1: a fresh profile has dark pages off; a page looks as its author made
+// it, and the engine is not asked to darken it.
+IN_PROC_BROWSER_TEST_F(DarkPagesTest, AFreshProfileHasDarkPagesOff) {
+  EXPECT_FALSE(stedding::DarkPagesOn(profile()));
