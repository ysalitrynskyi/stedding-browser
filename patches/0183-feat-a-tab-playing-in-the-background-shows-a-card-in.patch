+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/gfx/image/image_skia_operations.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/animation/ink_drop.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/button/image_button.h"
+#include "ui/views/controls/button/image_button_factory.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/widget/widget.h"
+
+namespace stedding {
+
+namespace {
+
+// Mp3: a 44 DIP row, the card 38 DIP tall within it (the rendered option
+// the owner chose, 2026-11-13).
+constexpr int kCardRowHeight = 44;
+constexpr int kCardInset = 3;
+// The card's buttons: a 16 DIP glyph in a 24 DIP target, the stop's cross a
+// size down, as the rendered card drew them.
+constexpr int kButtonTarget = 24;
+constexpr int kPlayPauseGlyph = 16;
+constexpr int kStopGlyph = 14;
+constexpr int kButtonGap = 4;
+constexpr int kCardTrailingInset = 6;
+// Mp8: the rail's card, under the rail's other icons' rhythm.
+constexpr int kRailHeight = 36;
+
+constexpr ui::ColorId kCardFill = kColorTabBackgroundActiveFrameActive;
+constexpr ui::ColorId kCardFillInactive =
+    kColorTabBackgroundActiveFrameInactive;
+constexpr ui::ColorId kCardText = kColorTabForegroundActiveFrameActive;
+
+// The row's favicon at `size`, or a speaker where the page has none.
+ui::ImageModel CardFavicon(const ui::ImageModel& favicon, int size) {
+  if (favicon.IsEmpty()) {
+    return ui::ImageModel::FromVectorIcon(vector_icons::kVolumeUpIcon,
+                                          kCardText, size);
+  }
+  if (favicon.IsImage()) {
+    gfx::ImageSkia image = favicon.GetImage().AsImageSkia();
+    if (!image.isNull() && image.size() != gfx::Size(size, size)) {
+      image = gfx::ImageSkiaOperations::CreateResizedImage(
+          image, skia::ImageOperations::RESIZE_BEST, gfx::Size(size, size));
+    }
+    return ui::ImageModel::FromImageSkia(image);
+  }
+  return favicon;
+}
+
+// Mp7: the card's body, its favicon and title, a button that shows the tab.
+// Its title is drawn on the card's fill, so with no subpixel text, as the
+// sidebar's rows draw theirs.
+class CardBody : public views::LabelButton {
+  METADATA_HEADER(CardBody, views::LabelButton)
+
+ public:
+  explicit CardBody(PressedCallback callback)
+      : views::LabelButton(std::move(callback), std::u16string()) {
+    label()->SetSkipSubpixelRenderingOpacityCheck(true);
+    label()->SetSubpixelRenderingEnabled(false);
+  }
+
+  void SetFont(const gfx::FontList& font) { label()->SetFontList(font); }
+};
+
+BEGIN_METADATA(CardBody)
+END_METADATA
+
+std::u16string PlayOrPauseName(bool playing) {
+  return playing ? u"Pause" : u"Play";
+}
+
+}  // namespace
+
+// Mp8: the rail's card: the favicon, and at its corner a badge with what a
+// click does, pause or play.
+class AudioStripView::RailButton : public views::Button {
+  METADATA_HEADER(RailButton, views::Button)
+
+ public:
+  explicit RailButton(PressedCallback callback)
+      : views::Button(std::move(callback)) {
+    views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+  }
+
+  void Set(ui::ImageModel favicon, bool playing) {
+    favicon_ = std::move(favicon);
+    playing_ = playing;
+    SchedulePaint();
+  }
+
+  // views::Button:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kRailHeight, kRailHeight);
+  }
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const ui::ColorProvider* const colors = GetColorProvider();
+    if (!colors) {
+      return;
+    }
+    const int size = SidebarFaviconSize();
+    const gfx::Rect icon(width() / 2 - size / 2, height() / 2 - size / 2, size,
+                         size);
+    const gfx::ImageSkia image = CardFavicon(favicon_, size).Rasterize(colors);
+    if (!image.isNull()) {
+      canvas->DrawImageInt(image, 0, 0, image.width(), image.height(), icon.x(),
+                           icon.y(), size, size, /*filter=*/true);
+    }
+    // The badge: a disc in the text's colour, rimmed with the sidebar's
+    // ground so it stands off the favicon, the glyph cut in the ground.
+    const SkColor ground = colors->GetColor(ui::kColorFrameActive);
+    const SkColor ink = colors->GetColor(kCardText);
+    const gfx::PointF centre(icon.right(), icon.bottom());
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(ground);
+    canvas->DrawCircle(centre, 6.5f, flags);
+    flags.setColor(ink);
+    canvas->DrawCircle(centre, 5.0f, flags);
+    canvas->Save();
+    canvas->Translate(gfx::Vector2d(static_cast<int>(centre.x()) - 4,
+                                    static_cast<int>(centre.y()) - 4));
+    gfx::PaintVectorIcon(canvas,
+                         playing_ ? vector_icons::kPauseFilledIcon
+                                  : vector_icons::kPlayArrowFilledFlippableIcon,
+                         8, ground);
+    canvas->Restore();
+  }
+
+ private:
+  ui::ImageModel favicon_;
+  bool playing_ = false;
+};
+
+BEGIN_METADATA(AudioStripView, RailButton)
+END_METADATA
+
+AudioStripView::AudioStripView(AudioStrip& strip,
+                               Form form,
+                               int side_padding,
+                               int favicon_inset)
+    : strip_(strip), form_(form) {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal));
+  if (form_ == Form::kRail) {
+    auto* const layout = static_cast<views::BoxLayout*>(GetLayoutManager());
+    layout->set_main_axis_alignment(
+        views::BoxLayout::MainAxisAlignment::kCenter);
+    rail_button_ =
+        AddChildView(std::make_unique<RailButton>(base::BindRepeating(
+            &AudioStrip::PlayOrPause, base::Unretained(&strip))));
+  } else {
+    auto* const layout = static_cast<views::BoxLayout*>(GetLayoutManager());
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    SetBorder(
+        views::CreateEmptyBorder(gfx::Insets::VH(kCardInset, side_padding)));
+    // Mp7, Mp9: the body shows the tab, in its Space.
+    body_ = AddChildView(std::make_unique<CardBody>(base::BindRepeating(
+        base::IgnoreResult(&AudioStrip::ShowTab), base::Unretained(&strip))));
+    body_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    body_->SetBorder(views::CreateEmptyBorder(
+        gfx::Insets::TLBR(0, favicon_inset, 0, kButtonGap)));
+    body_->SetImageLabelSpacing(8);
+    body_->SetEnabledTextColors(kCardText);
+    body_->SetTextColor(views::Button::STATE_HOVERED, kCardText);
+    body_->SetTextColor(views::Button::STATE_PRESSED, kCardText);
+    body_->SetElideBehavior(gfx::ELIDE_TAIL);
+    body_->SetMinSize(gfx::Size(0, kCardRowHeight - 2 * kCardInset));
+    layout->SetFlexForView(body_, 1);
+    const auto make_button = [&](base::RepeatingClosure pressed) {
+      auto button = views::CreateVectorImageButton(
+          base::BindRepeating(std::move(pressed)));
+      button->SetPreferredSize(gfx::Size(kButtonTarget, kButtonTarget));
+      views::InkDrop::Get(button.get())->SetBaseColor(kCardText);
+      return AddChildView(std::move(button));
+    };
+    play_pause_ = make_button(base::BindRepeating(&AudioStrip::PlayOrPause,
+                                                  base::Unretained(&strip)));
+    play_pause_->SetProperty(views::kMarginsKey,
+                             gfx::Insets::TLBR(0, 0, 0, kButtonGap));
+    stop_ = make_button(
+        base::BindRepeating(&AudioStrip::Stop, base::Unretained(&strip)));
+    stop_->SetProperty(views::kMarginsKey,
+                       gfx::Insets::TLBR(0, 0, 0, kCardTrailingInset));
+    stop_->SetImageModel(views::Button::STATE_NORMAL,
+                         ui::ImageModel::FromVectorIcon(
+                             vector_icons::kCloseIcon, kCardText, kStopGlyph));
+    stop_->SetTooltipText(u"Stop");
+    stop_->GetViewAccessibility().SetName(u"Stop");
+  }
+  observation_.Observe(&strip);
+  Refresh();
+}
+
+AudioStripView::~AudioStripView() = default;
+
+void AudioStripView::SetRailForm(bool rail) {
+  rail_ = rail;
+  Refresh();
+}
+
+views::Button* AudioStripView::body_for_testing() const {
+  return body_;
+}
+
+views::Button* AudioStripView::play_pause_for_testing() const {
+  return play_pause_;
+}
+
+views::Button* AudioStripView::stop_for_testing() const {
+  return stop_;
+}
+
+views::Button* AudioStripView::rail_button_for_testing() const {
+  return rail_button_;
+}
+
+gfx::Size AudioStripView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // The sidebar gives the row its width.
+  return gfx::Size(0, form_ == Form::kRail ? kRailHeight : kCardRowHeight);
+}
+
+void AudioStripView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  if (form_ != Form::kCard) {
+    return;
+  }
+  const ui::ColorProvider* const colors = GetColorProvider();
+  if (!colors) {
+    return;
+  }
+  // Mp3: the selected row's fill and corners.
+  const bool active = !GetWidget() || GetWidget()->ShouldPaintAsActive();
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  flags.setColor(colors->GetColor(active ? kCardFill : kCardFillInactive));
+  canvas->DrawRoundRect(gfx::RectF(GetContentsBounds()), SidebarCornerRadius(),
+                        flags);
+}
+
+void AudioStripView::OnAudioStripChanged() {
+  Refresh();
+}
+
+void AudioStripView::Refresh() {
+  const bool own_form = (form_ == Form::kRail) == rail_;
+  const bool has_tab = strip_->tab() != nullptr;
+  SetVisible(own_form && has_tab);
+  if (!has_tab) {
+    return;
+  }
+  const bool playing = strip_->playing();
+  const std::u16string title = strip_->title();
+  const std::u16string state = playing ? u"playing" : u"paused";
+  if (form_ == Form::kRail) {
+    rail_button_->Set(strip_->favicon(), playing);
+    rail_button_->SetTooltipText(
+        base::StrCat({title, u": ", PlayOrPauseName(playing)}));
+    rail_button_->GetViewAccessibility().SetName(
+        base::StrCat({PlayOrPauseName(playing), u" ", title}));
+    return;
+  }
+  body_->SetText(title);
+  body_->SetImageModel(views::Button::STATE_NORMAL,
+                       CardFavicon(strip_->favicon(), SidebarFaviconSize()));
+  static_cast<CardBody*>(body_.get())->SetFont(SidebarFont());
+  body_->SetTooltipText(title);
+  body_->GetViewAccessibility().SetName(base::StrCat({title, u", ", state}));
+  play_pause_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(
+          playing ? vector_icons::kPauseFilledIcon
+                  : vector_icons::kPlayArrowFilledFlippableIcon,
+          kCardText, kPlayPauseGlyph));
+  play_pause_->SetTooltipText(PlayOrPauseName(playing));
+  play_pause_->GetViewAccessibility().SetName(PlayOrPauseName(playing));
+  SchedulePaint();
+}
+
+BEGIN_METADATA(AudioStripView)
+END_METADATA
+
+}  // namespace stedding
