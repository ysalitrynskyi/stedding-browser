+    const gfx::Point to = HeaderCentre(inner);
+    PointerPressAndMove(RowCentre(dragged), to);
+    EXPECT_TRUE(HeaderLit(inner))
+        << "the nested header is not lit under the row: the drag moved the "
+           "folders away from the pointer";
+    EXPECT_FALSE(HeaderLit(outer)) << "the outer header is lit too";
+    Release(to);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return dragged->GetParentCollection() == inner; }))
+        << "the row from above did not join the nested folder";
+    ExpectKept(dragged, kept);
+    EXPECT_FALSE(HeaderLit(inner)) << "the nested header stays lit";
+    EXPECT_EQ(1u, WindowCount()) << "a window tore off";
+  }
+
+  {
+    SCOPED_TRACE("a row from above joins the outer folder at its header");
+    PointerDrag(RowCentre(first), HeaderCentre(outer));
+    ASSERT_TRUE(base::test::RunUntil(
