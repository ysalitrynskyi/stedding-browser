+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_TABS_STEDDING_FOLDER_SESSION_H_
+#define CHROME_BROWSER_UI_TABS_STEDDING_FOLDER_SESSION_H_
+
+#include <map>
+#include <string>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/raw_ref.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/sessions/core/session_id.h"
+#include "components/tabs/public/tab_interface.h"
+
+class Browser;
+class SessionService;
+class TabStripModel;
+
+namespace stedding {
+
+// The key a tab's folder path is written under in per-tab session extra data:
+// a JSON array of ancestors, outermost first, each {"i": id, "t": title,
+// "c": collapsed}.
+inline constexpr char kSessionTabFolderPathKey[] = "stedding.folderpath";
+
+// Keeps folders alive across restarts.
+//
+// Folders live in the tab collection tree, which the session service knows
+// nothing about. Every tab therefore carries its folder ancestry in per-tab
+// extra data, rewritten whenever the model changes; after session restore the
+// paths are read back and the tree is rebuilt through the same
+// TabStripModel::AddToNewFolder the context menu uses, so restore exercises no
+// special machinery.
+class FolderSessionService : public TabStripModelObserver {
+ public:
+  explicit FolderSessionService(Browser& browser);
+  FolderSessionService(const FolderSessionService&) = delete;
+  FolderSessionService& operator=(const FolderSessionService&) = delete;
+  ~FolderSessionService() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  // Recomputes and persists every tab's folder path. Called on model changes;
+  // public so the folder header can call it after a rename or collapse, which
+  // the model does not observe.
+  void PersistAllPaths();
+
+  // Rebuilds folders from parked per-tab paths. Runs once after session
+  // restore; public so a test can drive it with hand-parked paths.
+  void RebuildFromRestoredTabs();
+
+ private:
+  std::string PathForTab(const tabs::TabInterface* tab) const;
+
+  const raw_ref<Browser> browser_;
+  raw_ptr<SessionService> session_service_ = nullptr;
+  SessionID session_id_ = SessionID::InvalidValue();
+  // Last written path per tab, so unchanged tabs are not rewritten on every
+  // model notification.
+  std::map<tabs::TabHandle, std::string> written_;
+  base::CallbackListSubscription session_restored_subscription_;
+  bool rebuilt_ = false;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_TABS_STEDDING_FOLDER_SESSION_H_
