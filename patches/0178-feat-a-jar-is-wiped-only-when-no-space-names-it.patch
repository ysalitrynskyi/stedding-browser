+  SpaceModel* const other = SpaceModel::From(second.get());
+  ASSERT_TRUE(other);
+  ASSERT_TRUE(other->SetActiveSpace(work));
+  AddTab(second.get(), GURL("https://example.com/"));
+  tabs::TabInterface* const there = second->GetTabStripModel()->GetActiveTab();
+  ASSERT_FALSE(IsSpaceStoragePartition(PartitionOf(there)));
