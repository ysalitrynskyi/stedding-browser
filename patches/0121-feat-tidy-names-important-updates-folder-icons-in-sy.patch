+// folders F42 (BACKLOG S-393): a folder's icon is a field of its record, and
+// the file Import sidebar… reads carries it.
+TEST(SidebarSyncFileTest, AFoldersIconTravels) {
+  LocalView view = WorkView();
+  LocalItem folder;
+  folder.kind = Kind::kFolder;
+  folder.fields[kFieldTitle] = "Reading";
+  folder.fields[kFieldIcon] = "📚";
+  folder.fields[kFieldParent] = PinsListOf(kWork);
+  view.items[kFolder] = folder;
+  view.items[kPinB].fields[kFieldParent] = kFolder;
+  view.lists[PinsListOf(kWork)] = {kPinA, kFolder};
+  view.lists[kFolder] = {kPinB};
+  const State state = StateOf(view, 100, kOffice);
+  EXPECT_EQ("📚", state.records.at(kFolder).Get(kFieldIcon));
+  const std::optional<ArcImportPlan> plan =
+      ParseArcSidebar(SerializeSyncFile(state, Meta(kOffice)));
+  ASSERT_TRUE(plan);
+  ASSERT_EQ(1u, plan->spaces.size());
+  ASSERT_EQ(2u, plan->spaces[0].pinned.size());
+  EXPECT_EQ(ArcImportPlan::Node::Kind::kFolder,
+            plan->spaces[0].pinned[1].kind);
+  EXPECT_EQ("📚", plan->spaces[0].pinned[1].icon);
+}
+
+// folders F42: a folder recorded before icons synced has no icon field. The
+// first look after the update, with no icon here, stamps nothing, so an icon
+// another computer set still wins; an icon given here is an edit.
+TEST(SidebarSyncFileTest, AnEmptyIconFromBeforeIsNoEdit) {
+  LocalView before = WorkView();
