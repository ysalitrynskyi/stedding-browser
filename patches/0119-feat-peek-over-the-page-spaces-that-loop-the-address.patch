+// Clicks the footer's Next until the Import step is shown, and answers ""
+// once it is. Its sources come after it shows (import I46), so GoTo, which
+// looks for something in a step, would pass it by.
+std::string ToTheImportStep(content::WebContents* page) {
+  return content::EvalJs(page, R"(
+      (() => {
+        for (let i = 0; i < 10; ++i) {
+          const h1 = document.querySelector('main h1');
+          if (h1 && h1.textContent === 'Bring your bookmarks and history') {
+            return '';
+          }
+          const next = document.querySelector('footer button.primary');
+          if (!next || next.textContent === 'Finish') {
+            break;
+          }
+          next.click();
+        }
+        return 'no Import step';
+      })())")
+      .ExtractString();
+}
