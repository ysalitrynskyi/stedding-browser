+}
+
+button:focus-visible,
+input:focus-visible {
+  outline: 2px solid var(--focus);
+  outline-offset: -2px;
+}
+
+.text-button {
+  color: var(--muted);
+  padding: 4px 8px;
+  white-space: nowrap;
+}
+
+.text-button:hover {
