+// R56: a link that opens its own tab, target=_blank, is its page's child, the
+// commonest new tab there is. It comes to the front, where Chromium gives it
+// no opener, so it stayed at the left and Back left it open.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, ALinkThatOpensItsOwnTabIsAChild) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  const int count = tabs()->count();
+  ASSERT_TRUE(content::ExecJs(
+      page->GetContents(),
+      content::JsReplace("const a = document.createElement('a');"
+                         "a.href = $1; a.target = '_blank';"
+                         "document.body.append(a); a.click();",
+                         Url("b.test"))));
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return tabs()->count() == count + 1; }));
+  tabs::TabInterface* const child = tabs()->GetActiveTab();
+  ASSERT_NE(page, child);
+  ASSERT_TRUE(content::WaitForLoadStop(child->GetContents()));
+  EXPECT_FALSE(stedding::TabParentToken(child->GetContents()).empty())
+      << "no one's child";
+  EXPECT_GT(Indent(child), Indent(page));
+  EXPECT_EQ(page, stedding::ParentBackReturnsTo(child->GetContents()));
+}
+
+// R56, R60: a pin is no one's child, whatever it was before it was pinned.
+// Back on it stays, as Cmd-W does not close it either (pins H3), a fold leaves
+// its row, and a parent pinned after its fold offers no way back, so its
+// children come out.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, APinIsNoOnesChildForBackOrAFold) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const auto shown = [](const tabs::TabInterface*) { return true; };
+
+  stedding::SetChildrenFolded(page, true);
+  ASSERT_TRUE(stedding::FoldedAway(*tabs(), child, shown));
+  ASSERT_EQ(1, stedding::FoldedChildCount(*tabs(), page));
+  EXPECT_EQ(page, stedding::ParentBackReturnsTo(child->GetContents()));
+
+  model->SetSpacePinned(child, true);
+  EXPECT_FALSE(stedding::FoldedAway(*tabs(), child, shown))
+      << "a fold took a pin's row";
+  EXPECT_EQ(nullptr, stedding::ParentBackReturnsTo(child->GetContents()))
+      << "Back closes a pin";
+  model->SetSpacePinned(child, false);
+  ASSERT_TRUE(stedding::FoldedAway(*tabs(), child, shown));
+
+  // The parent becomes an essential: no count, no menu row, so no fold.
+  tabs()->SetTabPinned(tabs()->GetIndexOfTab(page), true);
+  EXPECT_FALSE(stedding::FoldedAway(*tabs(), child, shown))
+      << "a parent with no way to unfold kept its children folded";
+  EXPECT_EQ(0, stedding::FoldedChildCount(*tabs(), page));
+  EXPECT_FALSE(stedding::HasChildTabs(*tabs(), page));
+}
