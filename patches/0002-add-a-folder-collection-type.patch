+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/tabs/public/folder_tab_collection.h"
+
+#include <string>
+#include <utility>
+
+namespace tabs {
+
+FolderTabCollection::FolderTabCollection(FolderId id,
+                                         std::string title,
+                                         bool collapsed)
+    : TabCollection(TabCollection::Type::FOLDER,
+                    // Folders hold tabs, splits, and other folders. They do not
+                    // hold GROUP: Chrome's tab groups remain a sibling concept
+                    // under UNPINNED rather than something nested inside our
+                    // containers.
+                    {TabCollection::Type::FOLDER, TabCollection::Type::SPLIT},
+                    /*supports_tabs=*/true),
+      id_(id),
+      title_(std::move(title)),
+      collapsed_(collapsed) {}
+
+FolderTabCollection::~FolderTabCollection() = default;
+
+void FolderTabCollection::SetTitle(std::string title) {
+  title_ = std::move(title);
+}
+
+void FolderTabCollection::SetCollapsed(bool collapsed) {
+  collapsed_ = collapsed;
+}
+
+}  // namespace tabs
