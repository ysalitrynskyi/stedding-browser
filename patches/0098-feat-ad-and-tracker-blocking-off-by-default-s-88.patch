+namespace stedding {
+
+namespace {
+
+// Bk6: a shield. Blocking off on the site, its outline; on, filled. Drawn
+// for the toolbar's 20 DIP canvas; the touch form is the same icon.
+// clang-format off
+constexpr gfx::PathElement kBlockerOffPath[] = {
+    gfx::CANVAS_DIMENSIONS, 20,
+    gfx::STROKE, 1.5f,
+    gfx::MOVE_TO, 10, 2.75f,
+    gfx::LINE_TO, 16, 5,
+    gfx::V_LINE_TO, 9.5f,
+    gfx::CUBIC_TO, 16, 13.4f, 13.4f, 16.2f, 10, 17.25f,
+    gfx::CUBIC_TO, 6.6f, 16.2f, 4, 13.4f, 4, 9.5f,
+    gfx::V_LINE_TO, 5,
+    gfx::CLOSE};
+// clang-format on
+constexpr gfx::VectorIconRep kBlockerOffReps[] = {{kBlockerOffPath}};
+constexpr gfx::VectorIcon kBlockerOffIcon = {
+    kBlockerOffReps, std::size(kBlockerOffReps), "stedding_blocker_off"};
+
+// clang-format off
+constexpr gfx::PathElement kBlockerOnPath[] = {
+    gfx::CANVAS_DIMENSIONS, 20,
+    gfx::MOVE_TO, 10, 2,
+    gfx::LINE_TO, 16.75f, 4.5f,
+    gfx::V_LINE_TO, 9.5f,
+    gfx::CUBIC_TO, 16.75f, 13.9f, 13.8f, 17, 10, 18,
+    gfx::CUBIC_TO, 6.2f, 17, 3.25f, 13.9f, 3.25f, 9.5f,
+    gfx::V_LINE_TO, 4.5f,
+    gfx::CLOSE};
+// clang-format on
+constexpr gfx::VectorIconRep kBlockerOnReps[] = {{kBlockerOnPath}};
+constexpr gfx::VectorIcon kBlockerOnIcon = {
+    kBlockerOnReps, std::size(kBlockerOnReps), "stedding_blocker_on"};
+
+}  // namespace
+
+DEFINE_CLASS_ELEMENT_IDENTIFIER_VALUE(BlockerButton, kElementId);
+
+BlockerButton::BlockerButton(BrowserWindowInterface* browser)
+    : ToolbarButton(base::BindRepeating(&BlockerButton::OnPressed,
+                                        base::Unretained(this))),
+      browser_(browser) {
+  SetProperty(views::kElementIdentifierKey, kElementId);
+  GetViewAccessibility().SetRole(ax::mojom::Role::kToggleButton);
+  Profile* const profile = browser_->GetProfile();
+  const base::RepeatingClosure update =
+      base::BindRepeating(&BlockerButton::Update, base::Unretained(this));
+  // Bk6: the button's setting is the profile's; a private window's
+  // preferences pass its changes on.
+  profile_registrar_.Init(profile->GetPrefs());
+  profile_registrar_.Add(prefs::kBlockerButton, update);
+  // Bk1, Bk2: the switch and the lists are the browser's.
+  if (PrefService* const local_state = g_browser_process->local_state()) {
+    local_state_registrar_.Init(local_state);
+    local_state_registrar_.Add(prefs::kBlockerEnabled, update);
+    local_state_registrar_.Add(prefs::kBlockerEasyList, update);
+    local_state_registrar_.Add(prefs::kBlockerEasyPrivacy, update);
+  }
+  // Bk5: a site's exception, made here, in another window, in the command
+  // bar or in Settings. A private window's map also reports the entries it
+  // inherits.
+  if (HostContentSettingsMap* const map =
+          HostContentSettingsMapFactory::GetForProfile(profile)) {
+    settings_observation_.Observe(map);
+  }
+  active_tab_subscription_ =
+      browser_->RegisterActiveTabDidChange(base::BindRepeating(
+          &BlockerButton::OnActiveTabChanged, base::Unretained(this)));
+  Observe(ActiveContents());
+  Update();
+}
+
+BlockerButton::~BlockerButton() = default;
+
+void BlockerButton::AddedToWidget() {
+  ToolbarButton::AddedToWidget();
+  UpdateHighlight();
+}
+
+void BlockerButton::DidFinishNavigation(
+    content::NavigationHandle* navigation) {
+  if (navigation->IsInPrimaryMainFrame() && navigation->HasCommitted()) {
+    Update();
+  }
+}
+
+void BlockerButton::OnContentSettingChanged(
+    const ContentSettingsPattern& primary_pattern,
+    const ContentSettingsPattern& secondary_pattern,
+    ContentSettingsTypeSet content_type_set) {
+  if (content_type_set.Contains(ContentSettingsType::ADS)) {
+    Update();
+  }
+}
+
+void BlockerButton::OnBlockerListsChanged() {
+  Update();
+}
+
+void BlockerButton::OnPressed() {
+  // Bk5: the same path as the command bar's row.
+  ToggleBlockingOnSite(ActiveContents());
+}
+
+void BlockerButton::OnActiveTabChanged(BrowserWindowInterface* browser) {
+  Observe(ActiveContents());
+  Update();
+}
+
+content::WebContents* BlockerButton::ActiveContents() const {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  return model ? model->GetActiveWebContents() : nullptr;
+}
+
+void BlockerButton::Update() {
+  // The lists start with the browser, after the first window may have been
+  // made (StartBlocker); their status reaches the tooltip from then on.
+  if (BlockerLists* const lists = BlockerLists::Get();
+      lists && !lists_observation_.IsObserving()) {
+    lists_observation_.Observe(lists);
+  }
+  content::WebContents* const contents = ActiveContents();
+  const bool shown =
+      browser_->GetProfile()->GetPrefs()->GetBoolean(prefs::kBlockerButton) &&
+      CanChooseBlockingForSite(contents);
+  on_ = shown && IsBlockingOnForSite(contents);
+  SetVisible(shown);
+  SetVectorIcons(on_ ? kBlockerOnIcon : kBlockerOffIcon,
+                 on_ ? kBlockerOnIcon : kBlockerOffIcon);
+  UpdateHighlight();
+
+  std::u16string text;
+  if (shown) {
+    const std::u16string site = BlockerSiteName(contents);
+    const BlockerLists* const lists = BlockerLists::Get();
+    if (lists && !lists->GetStatus().has_ruleset) {
+      // Bk11: on a fresh install pages load unfiltered until the first
+      // lists have arrived.
+      text = u"Blocking starts once the lists have downloaded";
+    } else if (on_) {
+      text = base::StrCat({u"Blocking ads and trackers on ", site});
+    } else {
+      text = base::StrCat({u"Blocking is off on ", site});
+    }
+  }
+  SetTooltipText(text);
+  GetViewAccessibility().SetName(text.empty() ? u"Ad and tracker blocking"
+                                              : text);
+  GetViewAccessibility().SetCheckedState(on_ ? ax::mojom::CheckedState::kTrue
+                                             : ax::mojom::CheckedState::kFalse);
+}
+
+void BlockerButton::UpdateHighlight() {
+  // Chromium's active look for a toolbar button, as the dark pages moon's.
+  if (!on_) {
+    highlight_.reset();
+  } else if (!highlight_ && GetWidget()) {
+    highlight_.emplace(AddAnchorHighlight());
+  }
+}
+
+BEGIN_METADATA(BlockerButton)
+END_METADATA
+
+}  // namespace stedding
