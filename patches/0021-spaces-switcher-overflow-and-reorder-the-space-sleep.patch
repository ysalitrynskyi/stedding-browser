+++ b/chrome/browser/ui/views/spaces/space_switcher_rules.cc
@@ -0,0 +1,21 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_switcher_rules.h"
+
+namespace spaces {
+
+bool SwitcherOverflows(int row_width, size_t chip_count) {
+  // Every chip carries half the gap on each side; the "+" is one more chip.
+  const int need =
+      static_cast<int>(chip_count) * (kSwitcherChip + kSwitcherChipGap) +
+      kSwitcherChip;
+  return need > row_width - 2 * kSwitcherRowInset;
+}
+
+int SwitcherChipWidth(bool overflow, bool active, bool row_hovered) {
+  return overflow && !active && !row_hovered ? kSwitcherDot : kSwitcherChip;
+}
+
+}  // namespace spaces
