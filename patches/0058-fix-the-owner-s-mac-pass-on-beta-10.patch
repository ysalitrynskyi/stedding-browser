+    return;
+  }
+  const PageThemeColorController* const controller =
+      PageThemeColorController::From(browser_view->browser());
+  if (!controller || !controller->color()) {
+    return;
+  }
+  const gfx::Rect toolbar = browser_view->toolbar()->bounds();
+  if (toolbar.IsEmpty()) {
+    return;
