+// windows G14: each window's tab of a pin is a page of its own.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest, EachWindowsTabIsAPageOfItsOwn) {
+  tabs::TabInterface* const pin = PinPage(browser(), Page("/title1.html"));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(second).size() == 1u; }));
+  tabs::TabInterface* const there = Pins(second).front();
+  TabStripModel* const strip = second->GetTabStripModel();
+  strip->ActivateTabAt(strip->GetIndexOfTab(there));
+  ASSERT_TRUE(content::WaitForLoadStop(there->GetContents()));
+  EXPECT_EQ(Page("/title1.html"),
+            there->GetContents()->GetLastCommittedURL());
+  ASSERT_TRUE(content::NavigateToURL(there->GetContents(),
+                                     Page("/title2.html")));
+  // The first window's tab stays where it was.
+  EXPECT_EQ(Page("/title1.html"), pin->GetContents()->GetLastCommittedURL());
+  EXPECT_NE(pin->GetContents(), there->GetContents());
+  // Drifting is not a change of home.
+  EXPECT_EQ(Page("/title1.html"),
+            Model(browser()).HomeUrl(pin).value_or(GURL()));
+}
