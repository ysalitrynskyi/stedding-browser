@@ -0,0 +1,98 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/stedding_clean_links_handler.h"
+
+#include <optional>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/stedding/clean_link.h"
+#include "chrome/browser/ui/stedding/clean_links.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_ui.h"
+
+SteddingCleanLinksHandler::SteddingCleanLinksHandler(Profile* profile)
+    : profile_(profile->GetOriginalProfile()) {}
+
+SteddingCleanLinksHandler::~SteddingCleanLinksHandler() = default;
+
+void SteddingCleanLinksHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "steddingGetCleanLinksKeptSites",
+      base::BindRepeating(&SteddingCleanLinksHandler::HandleGetKeptSites,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingAddCleanLinksKeptSite",
+      base::BindRepeating(&SteddingCleanLinksHandler::HandleAddKeptSite,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingRemoveCleanLinksKeptSite",
+      base::BindRepeating(&SteddingCleanLinksHandler::HandleRemoveKeptSite,
+                          base::Unretained(this)));
+}
+
+void SteddingCleanLinksHandler::OnJavascriptAllowed() {
+  if (registrar_.IsEmpty()) {
+    registrar_.Init(profile_->GetPrefs());
+    registrar_.Add(
+        stedding::prefs::kCleanLinksKeptSites,
+        base::BindRepeating(&SteddingCleanLinksHandler::OnKeptSitesChanged,
+                            base::Unretained(this)));
+  }
+}
+
+void SteddingCleanLinksHandler::OnJavascriptDisallowed() {
+  registrar_.RemoveAll();
+}
+
+void SteddingCleanLinksHandler::OnKeptSitesChanged() {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("stedding-clean-links-kept-sites-changed", Sites());
+  }
+}
+
+base::ListValue SteddingCleanLinksHandler::Sites() const {
+  base::ListValue sites;
+  for (const std::string& site :
+       stedding::CleanLinksKeptSites(*profile_->GetPrefs())) {
+    sites.Append(site);
+  }
+  return sites;
+}
+
+void SteddingCleanLinksHandler::HandleGetKeptSites(
+    const base::ListValue& args) {
+  if (args.size() != 1U) {
+    return;
+  }
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], Sites());
+}
+
+void SteddingCleanLinksHandler::HandleAddKeptSite(const base::ListValue& args) {
+  if (args.size() != 2U || !args[1].is_string()) {
+    return;
+  }
+  AllowJavascript();
+  // Cl9: what is no site is refused, and nothing is written; the page says
+  // so under the field.
+  const std::optional<std::string> site =
+      stedding::KeptSiteFromTyped(args[1].GetString());
+  if (site) {
+    stedding::AddCleanLinksKeptSite(*profile_->GetPrefs(), *site);
+  }
+  ResolveJavascriptCallback(args[0], base::Value(site.has_value()));
+}
+
+void SteddingCleanLinksHandler::HandleRemoveKeptSite(
+    const base::ListValue& args) {
+  if (args.size() != 1U || !args[0].is_string()) {
+    return;
+  }
+  stedding::RemoveCleanLinksKeptSite(*profile_->GetPrefs(),
+                                     args[0].GetString());
+}
