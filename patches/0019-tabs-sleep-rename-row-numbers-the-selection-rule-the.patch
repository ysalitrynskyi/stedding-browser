diff --git a/chrome/browser/ui/stedding/sleep_tabs.cc b/chrome/browser/ui/stedding/sleep_tabs.cc
new file mode 100644
index 0000000000000..e5ce5fbb59cd5
--- /dev/null
+++ b/chrome/browser/ui/stedding/sleep_tabs.cc
@@ -0,0 +1,119 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/sleep_tabs.h"
+
+#include <algorithm>
+
+#include "chrome/browser/resource_coordinator/lifecycle_unit_state.mojom.h"
+#include "chrome/browser/resource_coordinator/tab_lifecycle_unit_external.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace stedding {
+
+namespace {
+
+// `allow_active`: Sleep Tab on the row the menu was opened on -- a
+// right-click activates the row first, so the verb would otherwise never
+// apply to it; SleepTabs activates a neighbour before the discard.
+bool CanSleep(TabStripModel* tabs, tabs::TabInterface* tab, bool allow_active) {
+  if (!tab || (tab->IsActivated() && !allow_active) || tab->IsPinned()) {
+    return false;
+  }
+  content::WebContents* const contents = tab->GetContents();
+  if (!contents || contents->WasDiscarded()) {
+    return false;
+  }
+  const int index = tabs->GetIndexOfTab(tab);
+  return index != TabStripModel::kNoTab && !tabs->IsTabHidden(index);
+}
+
+}  // namespace
+
+std::vector<tabs::TabInterface*> TabsToSleep(BrowserWindowInterface* browser,
+                                             tabs::TabInterface* tab,
+                                             SleepScope scope) {
+  std::vector<tabs::TabInterface*> out;
+  TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
+  if (!tabs || !tab) {
+    return out;
+  }
+  if (scope == SleepScope::kThisTab) {
+    // A selected row means the whole selection (tabs R21).
+    const int index = tabs->GetIndexOfTab(tab);
+    if (index != TabStripModel::kNoTab && tabs->IsTabSelected(index)) {
+      for (int i = 0; i < tabs->count(); ++i) {
+        tabs::TabInterface* const each = tabs->GetTabAtIndex(i);
+        if (tabs->IsTabSelected(i) && CanSleep(tabs, each, true)) {
+          out.push_back(each);
+        }
+      }
+    } else if (CanSleep(tabs, tab, true)) {
+      out.push_back(tab);
+    }
+    return out;
+  }
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const other = tabs->GetTabAtIndex(i);
+    if (other != tab && CanSleep(tabs, other, false)) {
+      out.push_back(other);
+    }
+  }
+  return out;
+}
+
+void ActivateANeighbour(TabStripModel* tabs,
+                        const std::vector<tabs::TabInterface*>& doomed) {
+  tabs::TabInterface* const active = tabs->GetActiveTab();
+  if (!active || std::ranges::find(doomed, active) == doomed.end()) {
+    return;
+  }
+  // The nearest visible row that is not going to sleep, after first.
+  const int from = tabs->GetIndexOfTab(active);
+  for (int step = 1; step < tabs->count(); ++step) {
+    for (const int index : {from + step, from - step}) {
+      if (index < 0 || index >= tabs->count() || tabs->IsTabHidden(index)) {
+        continue;
+      }
+      tabs::TabInterface* const candidate = tabs->GetTabAtIndex(index);
+      if (std::ranges::find(doomed, candidate) == doomed.end()) {
+        tabs->ActivateTabAt(index);
+        return;
+      }
+    }
+  }
+}
+
+void SleepTabs(BrowserWindowInterface* browser,
+               tabs::TabInterface* tab,
+               SleepScope scope) {
+  const std::vector<tabs::TabInterface*> doomed =
+      TabsToSleep(browser, tab, scope);
+  if (TabStripModel* const tabs =
+          browser ? browser->GetTabStripModel() : nullptr) {
+    ActivateANeighbour(tabs, doomed);
+  }
+  SleepTabList(doomed);
+}
+
+void SleepTabList(const std::vector<tabs::TabInterface*>& tabs) {
+  for (tabs::TabInterface* doomed : tabs) {
+    content::WebContents* const contents =
+        doomed ? doomed->GetContents() : nullptr;
+    if (!contents || doomed->IsActivated() || contents->WasDiscarded()) {
+      continue;
+    }
+    resource_coordinator::TabLifecycleUnitExternal* const unit =
+        resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+            contents);
+    if (unit) {
+      unit->DiscardTab(mojom::LifecycleUnitDiscardReason::EXTERNAL);
+    }
+  }
+}
+
+}  // namespace stedding
