@@ -0,0 +1,60 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding_ui_metrics.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+class SidebarDensityTest : public testing::Test {
+ protected:
+  ~SidebarDensityTest() override {
+    SetSidebarDensity(SidebarDensity::kComfortable);
+    SetSidebarTextSize(0);
+  }
+};
+
+// Y1: the three presets, Comfortable being the measured feature params.
+TEST_F(SidebarDensityTest, PresetsGiveTheMeasuredMetrics) {
+  const SidebarMetrics comfortable =
+      MetricsForDensity(SidebarDensity::kComfortable);
+  EXPECT_EQ(kVerticalTabHeight.Get(), comfortable.row_height);
+  EXPECT_EQ(kTabFaviconSize.Get(), comfortable.favicon_size);
+  EXPECT_EQ(44, comfortable.row_height);
+  EXPECT_EQ(18, comfortable.favicon_size);
+  const SidebarMetrics compact = MetricsForDensity(SidebarDensity::kCompact);
+  EXPECT_EQ(36, compact.row_height);
+  EXPECT_EQ(40, compact.pinned_height);
+  EXPECT_EQ(16, compact.favicon_size);
+  const SidebarMetrics dense = MetricsForDensity(SidebarDensity::kDense);
+  EXPECT_EQ(30, dense.row_height);
+  EXPECT_EQ(34, dense.pinned_height);
+  EXPECT_EQ(6, dense.corner_radius);
+
+  EXPECT_EQ(44, SidebarRowHeight());
+  SetSidebarDensity(SidebarDensity::kDense);
+  EXPECT_EQ(SidebarDensity::kDense, GetSidebarDensity());
+  EXPECT_EQ(30, SidebarRowHeight());
+  EXPECT_EQ(34, SidebarPinnedHeight());
+  EXPECT_EQ(16, SidebarFaviconSize());
+  EXPECT_EQ(6, SidebarCornerRadius());
+}
+
+// Y2: a row is never shorter than its text and insets.
+TEST_F(SidebarDensityTest, RowsNeverClipTheText) {
+  SetSidebarDensity(SidebarDensity::kDense);
+  EXPECT_EQ(30, SidebarRowHeight());
+  SetSidebarTextSize(15);
+  EXPECT_EQ(15, GetSidebarTextSize());
+  EXPECT_EQ(37, SidebarRowHeight()) << "15 + 22 > 30";
+  SetSidebarDensity(SidebarDensity::kComfortable);
+  EXPECT_EQ(44, SidebarRowHeight()) << "44 > 37: the preset holds";
+  SetSidebarTextSize(0);
+  EXPECT_EQ(44, SidebarRowHeight());
+}
+
+}  // namespace
+}  // namespace stedding
