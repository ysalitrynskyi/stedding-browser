+        kind: 's3', accessKey: 'a', secretKey: 'b'});
+      const bare = await cr.sendWithPromise('steddingTestSyncPlace', {});
+      const none = await cr.sendWithPromise('steddingChangeSyncSignIn', {});
+      return [empty.complete, open.problem, good.complete, good.unencrypted,
+              signIn.complete, bare.failure, none.failure].join(' ');
+    })()
+  )";
+  EXPECT_EQ("false notHttps true true true form form",
+            content::EvalJs(page, kAsk));
