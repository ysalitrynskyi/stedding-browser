+}  // namespace
+
+std::string PinsListOf(std::string_view space_id) {
+  return std::string(kSpacePrefix) + std::string(space_id) + kPinsSuffix;
+}
+
+std::string OwnEssentialsListOf(std::string_view space_id) {
+  return std::string(kSpacePrefix) + std::string(space_id) +
+         kOwnEssentialsSuffix;
+}
+
+std::string SpaceOfList(std::string_view container) {
+  if (!base::StartsWith(container, kSpacePrefix)) {
+    return std::string();
+  }
+  container.remove_prefix(std::string_view(kSpacePrefix).size());
+  const size_t slash = container.find('/');
+  return slash == std::string_view::npos
+             ? std::string()
+             : std::string(container.substr(0, slash));
+}
+
+int64_t NextTime(int64_t now_ms, int64_t max_seen) {
+  return std::min(std::max(now_ms, max_seen + 1), kMaxTime);
+}
+
+std::string_view KindName(Kind kind) {
+  switch (kind) {
+    case Kind::kSpace:
+      return "space";
+    case Kind::kFolder:
+      return "folder";
+    case Kind::kTab:
+      return "tab";
+  }
+  return "tab";
+}
+
+std::optional<Kind> KindFromName(std::string_view name) {
+  if (name == "space") {
+    return Kind::kSpace;
+  }
+  if (name == "folder") {
+    return Kind::kFolder;
+  }
+  if (name == "tab") {
+    return Kind::kTab;
+  }
+  return std::nullopt;
+}
