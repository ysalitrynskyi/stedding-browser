+bool AddressRow::HideInCompactWanted() const {
+  if (!browser_->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kToolbarHideInCompact)) {
+    return false;
+  }
+  // T64: the window's full screen keeps its own rules (T8, T33).
+  const BrowserWindow* const window = BrowserWindow::FromBrowser(&*browser_);
+  return !window || !window->IsFullscreen();
+}
+
+bool AddressRow::ShowsLocalPage() const {
+  TabStripModel* const tabs = browser_->GetTabStripModel();
+  if (!tabs) {
+    return false;
+  }
+  // The page on screen: the one a drag holds there, while it is still in
+  // this window, else the active tab's (BACKLOG S-350).
+  content::WebContents* page = held_contents_.get();
+  if (!page || tabs->GetIndexOfWebContents(page) == TabStripModel::kNoTab) {
+    page = tabs->GetActiveWebContents();
+  }
+  return page && IsLocalPage(page->GetLastCommittedURL());
+}
+
+bool AddressRow::HidesInCompact() {
+  // IsVisible notices a sidebar change and drops shift-cmd-D's answer
+  // first, so the answer here is the rule's own.
+  IsVisible();
+  return HideInCompactWanted() && CurrentSidebar() == Sidebar::kCollapsed &&
+         !override_.has_value() && !camera_row_.has_value() &&
+         !ShowsLocalPage();
+}
+
+void AddressRow::SetRevealed(bool revealed) {
+  if (revealed_ == revealed) {
+    return;
+  }
+  revealed_ = revealed;
+  Relayout();
+}
+
+AddressRow::ScopedLaidOutHidden::ScopedLaidOutHidden(AddressRow& row)
+    : row_(row) {
+  ++row_->laid_out_hidden_;
+}
+
+AddressRow::ScopedLaidOutHidden::~ScopedLaidOutHidden() {
+  --row_->laid_out_hidden_;
+}
