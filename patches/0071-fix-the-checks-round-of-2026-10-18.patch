+IN_PROC_BROWSER_TEST_F(AddressBandTest, TheRowTakesThePageAndLeavesWithIt) {
+  // A colour the supplier keeps as it is (each channel one of 0x00, 0x11 ...
+  // 0xFF), so the row can be checked against it exactly.
+  constexpr SkColor kPage = SkColorSetRGB(0xEE, 0x88, 0x00);
+  const GURL page("data:text/html,<style>html{background:%23ee8800}</style>");
+  const stedding::PageThemeColorController* const row =
