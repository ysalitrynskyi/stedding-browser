+// across a list `width` wide: with the fingers while there is a Space that
+// way, never further than the list's width; at the end of the switcher they
+// give a little, up to kSpaceSwipeEndGive, and no more.
+float SpaceSwipeShift(float offset, float width, bool has_neighbour);
+// Their opacity there: they fade as they leave, to 0.4 at half the list's
+// width; at the end of the switcher they do not fade.
+float SpaceSwipeOpacity(float offset, float width, bool has_neighbour);
+// Whether a swipe the fingers lift from `offset` DIPs across switches Space:
+// past kSpaceSwipeCommitDip or three tenths of the list, whichever is less,
+// or a flick (VerticalTabStripFocusSwipeController::kFlickSpeed) past
+// kSpaceSwipeFlickDip. Otherwise the list springs back.
+bool SpaceSwipeCommits(float offset, float width, bool flick);
+inline constexpr float kSpaceSwipeCommitDip = 75.0f;
+inline constexpr float kSpaceSwipeFlickDip = 16.0f;
+inline constexpr float kSpaceSwipeEndGive = 40.0f;
+// After a swipe switches, the next Space's title and list come in from that
+// side, this share of the list's width out and faded to
+// kSpaceSwipeEntryOpacity, and settle in kSpaceSwipeEntryMs; a swipe that
+// does not switch springs back in kSpaceSwipeSettleMs.
+inline constexpr float kSpaceSwipeEntryShare = 0.4f;
+inline constexpr float kSpaceSwipeEntryOpacity = 0.4f;
+inline constexpr int kSpaceSwipeEntryMs = 240;
+inline constexpr int kSpaceSwipeSettleMs = 180;
