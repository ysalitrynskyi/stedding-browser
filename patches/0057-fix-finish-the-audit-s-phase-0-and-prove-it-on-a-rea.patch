+// copy-link L4, menus M8: outside a web app's window Copy Link is Stedding's
+// clean copy on the horizontal strip too. The model's own Copy URL is a web
+// app's: it hit a DCHECK in a normal window and copied the tracking
+// parameters.
+TEST_F(TabMenuVerbsTest, CopyLinkIsTheCleanCopy) {
+  tabs::TabInterface* const tab =
+      OpenTab(GURL("https://a.test/page?q=1&utm_source=mail"));
+  // The page's title arrives on its navigation entry, where the copy reads it.
+  content::WebContents* const contents = tab->GetContents();
+  contents->UpdateTitleForEntry(
+      contents->GetController().GetLastCommittedEntry(), u"A");
+
+  ASSERT_TRUE(Enabled(tab, TabStripModel::CommandCopyURL));
+  Execute(tab, TabStripModel::CommandCopyURL);
+  EXPECT_EQ(u"https://a.test/page?q=1", ClipboardText());
+
+  ASSERT_TRUE(Enabled(tab, TabStripModel::CommandSteddingCopyMarkdownLink));
+  Execute(tab, TabStripModel::CommandSteddingCopyMarkdownLink);
+  EXPECT_EQ(u"[A](https://a.test/page?q=1)", ClipboardText());
+}
+
+// spaces B10, pins H1, H6, H13: the per-Space pin pair has exactly one row
+// enabled, and the pinned-page rows come with the pin; only a web page can be
+// made the pinned page.
+TEST_F(TabMenuVerbsTest, SpacePinAndThePinnedPage) {
+  tabs::TabInterface* const tab = OpenTab();
+  EXPECT_TRUE(Enabled(tab, TabStripModel::CommandSpacePin));
+  EXPECT_FALSE(Enabled(tab, TabStripModel::CommandSpaceUnpin));
+  EXPECT_FALSE(Enabled(tab, TabStripModel::CommandSteddingSetHome));
+  EXPECT_FALSE(Enabled(tab, TabStripModel::CommandSteddingResetToHome));
+
+  Execute(tab, TabStripModel::CommandSpacePin);
+  EXPECT_TRUE(space_model().IsSpacePinned(tab));
+  EXPECT_FALSE(Enabled(tab, TabStripModel::CommandSpacePin));
+  EXPECT_TRUE(Enabled(tab, TabStripModel::CommandSpaceUnpin));
+  EXPECT_TRUE(Enabled(tab, TabStripModel::CommandSteddingSetHome));
+  EXPECT_TRUE(Enabled(tab, TabStripModel::CommandSteddingResetToHome));
+
+  // A page that is not a web page cannot be the pinned page (pins H13).
+  NavigateAndCommit(tab->GetContents(), GURL("about:blank"));
+  EXPECT_FALSE(Enabled(tab, TabStripModel::CommandSteddingSetHome));
+
+  // Make This the Pinned Page takes the page the tab shows now.
+  const GURL away("https://example.com/away");
+  NavigateAndCommit(tab->GetContents(), away);
+  EXPECT_TRUE(Enabled(tab, TabStripModel::CommandSteddingSetHome));
+  Execute(tab, TabStripModel::CommandSteddingSetHome);
+  EXPECT_EQ(std::optional<GURL>(away), space_model().HomeUrl(tab));
+
+  Execute(tab, TabStripModel::CommandSpaceUnpin);
+  EXPECT_FALSE(space_model().IsSpacePinned(tab));
+}
