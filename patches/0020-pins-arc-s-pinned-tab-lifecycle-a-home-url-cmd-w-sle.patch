diff --git a/chrome/browser/ui/stedding/pin_lifecycle.cc b/chrome/browser/ui/stedding/pin_lifecycle.cc
new file mode 100644
index 0000000000000..6d7f5a5d9eccd
--- /dev/null
+++ b/chrome/browser/ui/stedding/pin_lifecycle.cc
@@ -0,0 +1,155 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/pin_lifecycle.h"
+
+#include <vector>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/resource_coordinator/lifecycle_unit_state.mojom.h"
+#include "chrome/browser/resource_coordinator/tab_lifecycle_unit_external.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "url/origin.h"
+
+namespace stedding {
+
+namespace {
+
+bool IsPinnedAnywhere(BrowserWindowInterface* browser,
+                      const tabs::TabInterface* tab) {
+  if (!tab) {
+    return false;
+  }
+  if (tab->IsPinned()) {
+    return true;
+  }
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  return model && model->IsSpacePinned(tab);
+}
+
+std::vector<tabs::TabInterface*> Selection(TabStripModel* tabs) {
+  std::vector<tabs::TabInterface*> out;
+  for (int i = 0; i < tabs->count(); ++i) {
+    if (tabs->IsTabSelected(i)) {
+      out.push_back(tabs->GetTabAtIndex(i));
+    }
+  }
+  if (out.empty() && tabs->GetActiveTab()) {
+    out.push_back(tabs->GetActiveTab());
+  }
+  return out;
+}
+
+bool IsAsleep(const tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab->GetContents();
+  return contents && contents->WasDiscarded();
+}
+
+}  // namespace
+
+bool HasDriftedFromHome(const GURL& home, const GURL& current) {
+  if (!home.is_valid() || !current.is_valid()) {
+    return false;
+  }
+  return !url::Origin::Create(home).IsSameOriginWith(current) ||
+         home.path() != current.path();
+}
+
+CloseAction CloseActionFor(BrowserWindowInterface* browser,
+                           const PrefService* prefs) {
+  if (!browser || (prefs && !prefs->GetBoolean(prefs::kPinsCloseSleeps))) {
+    return CloseAction::kClose;
+  }
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  if (!tabs) {
+    return CloseAction::kClose;
+  }
+  bool all_asleep = true;
+  for (tabs::TabInterface* tab : Selection(tabs)) {
+    if (!IsPinnedAnywhere(browser, tab)) {
+      return CloseAction::kClose;
+    }
+    all_asleep &= IsAsleep(tab);
+  }
+  return all_asleep ? CloseAction::kNoOp : CloseAction::kSleep;
+}
+
+bool SleepInsteadOfClose(BrowserWindowInterface* browser) {
+  Profile* const profile = browser ? browser->GetProfile() : nullptr;
+  const CloseAction action =
+      CloseActionFor(browser, profile ? profile->GetPrefs() : nullptr);
+  if (action == CloseAction::kClose) {
+    return false;
+  }
+  if (action == CloseAction::kNoOp) {
+    return true;
+  }
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  const std::vector<tabs::TabInterface*> doomed = Selection(tabs);
+  // The active pin cannot sleep while it is on screen: move to the next
+  // visible row of the Space first, or open a new tab there (H11).
+  tabs::TabInterface* const active = tabs->GetActiveTab();
+  bool active_doomed = false;
+  for (tabs::TabInterface* tab : doomed) {
+    active_doomed |= tab == active;
+  }
+  if (active_doomed) {
+    tabs->SelectNextTab(TabStripUserGestureDetails(
+        TabStripUserGestureDetails::GestureType::kOther));
+    tabs::TabInterface* const now = tabs->GetActiveTab();
+    bool landed_on_doomed = now == active;
+    for (tabs::TabInterface* tab : doomed) {
+      landed_on_doomed |= tab == now;
+    }
+    if (landed_on_doomed) {
+      tabs->delegate()->AddTabAt(GURL(chrome::kChromeUINewTabURL), -1, true);
+    }
+  }
+  for (tabs::TabInterface* tab : doomed) {
+    if (IsAsleep(tab)) {
+      continue;
+    }
+    resource_coordinator::TabLifecycleUnitExternal* const unit =
+        resource_coordinator::TabLifecycleUnitExternal::FromWebContents(
+            tab->GetContents());
+    if (unit) {
+      unit->DiscardTab(mojom::LifecycleUnitDiscardReason::EXTERNAL);
+    }
+  }
+  return true;
+}
+
+void ResetToHome(BrowserWindowInterface* browser, tabs::TabInterface* tab) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  const std::optional<GURL> home = model ? model->HomeUrl(tab) : std::nullopt;
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!home || !contents) {
+    return;
+  }
+  contents->GetController().LoadURL(*home, content::Referrer(),
+                                    ui::PAGE_TRANSITION_AUTO_BOOKMARK,
+                                    std::string());
+}
+
+GURL PinnedSiteFor(BrowserWindowInterface* browser, tabs::TabInterface* tab) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  if (const std::optional<GURL> home =
+          model ? model->HomeUrl(tab) : std::nullopt) {
+    return *home;
+  }
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  return contents ? contents->GetLastCommittedURL() : GURL();
+}
+
+}  // namespace stedding
