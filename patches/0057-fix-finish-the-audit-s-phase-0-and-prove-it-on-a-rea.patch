+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_JAR_NAVIGATION_THROTTLE_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_JAR_NAVIGATION_THROTTLE_H_
+
+#include "content/public/browser/navigation_throttle.h"
+
+namespace content {
+class NavigationThrottleRegistry;
+}  // namespace content
+
+namespace spaces {
+
+// PLAN.md SPC-9, SPC-12: a tab's next page is made in the jar its Space
+// needs for that page. Two kinds of tab arrive at a page in another jar than
+// their Space's: one that kept its jar because it held changes the user had
+// not saved when its Space's jar changed, and one showing a page of the
+// browser's own -- the new tab page, settings -- which lives in the
+// profile's jar. Such a tab's next navigation -- a link, a reload, a typed
+// address, a step back -- is stopped before its request and made again in
+// the right jar, with the tab's history. The page's own "Leave site?" has
+// already run, as it does for any navigation. A form a web page sends is the
+// exception: it goes in the session the page was filled in, and the tab
+// moves at the navigation after it.
+class SpaceJarNavigationThrottle : public content::NavigationThrottle {
+ public:
+  static void MaybeCreateAndAdd(content::NavigationThrottleRegistry& registry);
+
+  explicit SpaceJarNavigationThrottle(
+      content::NavigationThrottleRegistry& registry);
+  SpaceJarNavigationThrottle(const SpaceJarNavigationThrottle&) = delete;
+  SpaceJarNavigationThrottle& operator=(const SpaceJarNavigationThrottle&) =
+      delete;
+  ~SpaceJarNavigationThrottle() override;
+
+  // content::NavigationThrottle:
+  ThrottleCheckResult WillStartRequest() override;
+  const char* GetNameForLogging() override;
+};
+
+}  // namespace spaces
