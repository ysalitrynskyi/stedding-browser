+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_STEDDING_ISOLATION_MARK_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_STEDDING_ISOLATION_MARK_VIEW_H_
+
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/view.h"
+
+namespace gfx {
+class Canvas;
+}  // namespace gfx
+
+namespace stedding {
+
+// sessions S32 (ADR 0019): the mark of a Space with an Independent session,
+// cookies, cache and site storage of its own, in the glyph
+// spaces::IsolationMarkIcon() gives, drawn in one of two forms. It is drawn
+// and never named: the chip or the row it sits on carries the description
+// and the tooltip, so a screen reader hears it once, after the Space's name,
+// and a pointer resting on the mark gets its host's tooltip and its host's
+// click.
+class IsolationMarkView : public views::View {
+  METADATA_HEADER(IsolationMarkView, views::View)
+
+ public:
+  enum class Form {
+    // The glyph alone, after a Space's name and in the colour of the text it
+    // follows: the Space title row in the open sidebar, the command bar's
+    // rows.
+    kGlyph,
+    // The glyph cut out of a small disc at the corner of a Space's own glyph,
+    // the disc ringed in the colour of the ground so it stands apart from the
+    // emoji under it: the switcher's chips, and the title row in the rail,
+    // where the row is the Space's glyph alone.
+    kBadge,
+  };
+
+  // The glyph form: a little smaller than the sidebar's text.
+  static constexpr int kGlyphSize = 14;
+  // The badge, its ring included: half of a 24 DIP chip. On the chip's 16 DIP
+  // glyph it covers the bottom trailing quarter (PlaceBadge), so the emoji
+  // stays the chip's face.
+  static constexpr int kBadgeSize = 12;
+  // Between a Space's name and the glyph after it.
+  static constexpr int kGapAfterText = 6;
+
+  // `ink` is the glyph's colour in the glyph form and the disc's in the
+  // badge; `ground`, the colour of what the host sits on, is the badge's ring
+  // and the glyph cut out of its disc. The glyph form does not use it.
+  IsolationMarkView(Form form, ui::ColorId ink, ui::ColorId ground);
+  IsolationMarkView(const IsolationMarkView&) = delete;
+  IsolationMarkView& operator=(const IsolationMarkView&) = delete;
+  ~IsolationMarkView() override;
+
+  void SetForm(Form form);
+  Form form() const { return form_; }
+  ui::ColorId ink() const { return ink_; }
+  ui::ColorId ground() const { return ground_; }
+
+  // A chip of a Space that is not on screen is faded, and its badge with it,
+  // less, so the mark still reads (spaces B38).
+  void SetAlpha(SkAlpha alpha);
+  SkAlpha alpha() const { return alpha_; }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override;
+  void OnPaint(gfx::Canvas* canvas) override;
+
+ private:
+  void PaintBadge(gfx::Canvas* canvas, SkColor ink, SkColor ground) const;
+
+  Form form_;
+  const ui::ColorId ink_;
+  const ui::ColorId ground_;
+  SkAlpha alpha_ = SK_AlphaOPAQUE;
+};
+
+// Where the glyph form goes after a label's text, and what is left of the
+// label for its text. `label` is the label's bounds as its button laid it
+// out, which hug the text while it fits; `trailing_edge` is where the mark
+// has to end, the button's content edge. A text too long for both gives up
+// its end to the mark, so the mark is never pushed out of the row, and never
+// drawn over the text.
+struct MarkAfterText {
+  gfx::Rect label;
+  gfx::Rect mark;
+};
+MarkAfterText PlaceMarkAfterText(const gfx::Rect& label, int trailing_edge);
+
+// Where the badge goes on a glyph drawn in `glyph`: over its bottom trailing
+// corner, a third of the badge standing out of the glyph so less of the glyph
+// is hidden, and always inside `host`.
+gfx::Rect PlaceBadge(const gfx::Rect& glyph, const gfx::Rect& host);
+
+// The mark `host` shows: a child of it that is visible, or null. The chips
+// and rows that carry a mark have it as their own child.
+IsolationMarkView* FindShownIsolationMark(views::View* host);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STEDDING_ISOLATION_MARK_VIEW_H_
