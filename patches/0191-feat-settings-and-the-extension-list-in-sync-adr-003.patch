+// Sf59: every Stedding preference is in the synced list or the staying
+// list, each staying one with its reason; and the table names no preference
+// that is not registered.
+TEST(SidebarSyncSettingsTest, EverySettingIsInOneList) {
+  auto profile = base::MakeRefCounted<user_prefs::PrefRegistrySyncable>();
+  stedding::prefs::RegisterProfilePrefs(profile.get());
+  auto browser = base::MakeRefCounted<PrefRegistrySimple>();
+  stedding::prefs::RegisterLocalStatePrefs(browser.get());
+
+  const std::set<std::string> profile_names = SteddingNames(*profile);
+  const std::set<std::string> browser_names = SteddingNames(*browser);
+  ASSERT_FALSE(profile_names.empty());
+  ASSERT_FALSE(browser_names.empty());
+  for (const std::string& name : profile_names) {
+    const SettingRule* const rule = FindSettingRule(name);
+    ASSERT_TRUE(rule) << name << " is in neither list";
+    EXPECT_EQ(SettingScope::kProfile, rule->scope) << name;
+  }
+  for (const std::string& name : browser_names) {
+    const SettingRule* const rule = FindSettingRule(name);
+    ASSERT_TRUE(rule) << name << " is in neither list";
+    EXPECT_EQ(SettingScope::kBrowser, rule->scope) << name;
+  }
+  std::set<std::string> listed;
+  for (const SettingRule& rule : SettingRules()) {
+    EXPECT_TRUE(listed.insert(rule.path).second) << rule.path << " twice";
+    EXPECT_TRUE(profile_names.contains(rule.path) ||
+                browser_names.contains(rule.path))
+        << rule.path << " is not registered";
+  }
+
+  // What the ADR names: Mac-only and Windows-only settings, sync's own,
+  // sizes measured against the screen and shortcuts stay; the person's
+  // choices and the routes travel.
+  for (const char* stays :
+       {stedding::prefs::kCameraRowFullscreen,
+        stedding::prefs::kUpdatesAutomatic, stedding::prefs::kShortcutsUser,
+        stedding::prefs::kSidebarSyncFolder,
+        stedding::prefs::kSidebarSyncDeviceName,
+        stedding::prefs::kSidebarSyncPlace,
+        stedding::prefs::kSidebarSyncPlaceSignIn,
+        stedding::prefs::kSidebarSyncInstallId,
+        stedding::prefs::kLittleWidth, stedding::prefs::kLittleHeight,
+        stedding::prefs::kToolbarFieldWidth, stedding::prefs::kSpaceRegistry,
+        stedding::prefs::kPinStore}) {
+    EXPECT_FALSE(IsSyncedSetting(stays)) << stays;
+  }
+  for (const char* travels :
+       {stedding::prefs::kPeekEnabled, stedding::prefs::kSidebarOnRight,
+        stedding::prefs::kSpaceRoutes, stedding::prefs::kWindowColour,
+        stedding::prefs::kBlockerEnabled, stedding::prefs::kCleanLinks}) {
+    EXPECT_TRUE(IsSyncedSetting(travels)) << travels;
+  }
+}
