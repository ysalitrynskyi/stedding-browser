+
+#ifndef CHROME_BROWSER_UI_STEDDING_AUDIO_STRIP_H_
+#define CHROME_BROWSER_UI_STEDDING_AUDIO_STRIP_H_
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/memory/raw_ref.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/base/models/image_model.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace stedding {
+
+// docs/features/player.md Mp3, Mp7 (BACKLOG S-95): what the rules need to
+// know of one tab of the window.
+struct AudioStripTab {
+  // Unique among the window's tabs while it lives.
+  int id = 0;
+  // The active tab, or the other pane of its split.
+  bool on_screen = false;
+  // The tab's sound is off, or every player of its page is muted.
+  bool muted = false;
+  // Its page has a media session that takes play and pause from outside.
+  bool controllable = false;
+  // Its media session plays something with sound.
+  bool playing = false;
+  // Its video is in picture in picture (Mp2).
+  bool popped_out = false;
+  // Stopped from the card, and has not played since.
+  bool stopped = false;
+  // When it last started to play, in the window's order; 0 for never.
+  uint64_t started = 0;
+};
+
+// Mp3, Mp7: the id of the tab the card shows, or nullopt for no card. A tab
+// that is not on screen, not muted, takes play and pause, is not popped out
+// and was not stopped has a card while it plays; `shown`, the tab whose card
+// shows now, keeps it while paused. Of those, the newest to start wins.
+std::optional<int> ChooseAudioStripTab(base::span<const AudioStripTab> tabs,
+                                       std::optional<int> shown);
+
+// docs/features/player.md Mp3, Mp7-Mp9 (BACKLOG S-95): the tab of a window
+// that plays sound in the background, for the card at its sidebar's foot,
+// the command bar's rows and ⌥⇧⌘M. One per tabbed window, found through the
+// window's user data. It watches each tab's media session.
+class AudioStrip : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(AudioStrip);
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // The card's tab changed, or its title, favicon or playing state did.
+    virtual void OnAudioStripChanged() = 0;
+  };
+
+  // The strip of `browser`, or null for a window that has none.
+  static AudioStrip* From(BrowserWindowInterface* browser);
+
+  explicit AudioStrip(BrowserWindowInterface& browser);
+  AudioStrip(const AudioStrip&) = delete;
+  AudioStrip& operator=(const AudioStrip&) = delete;
+  ~AudioStrip() override;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // The tab the card shows, or null for no card. Null while the setting is
+  // off (`stedding.player.audio_strip`).
+  tabs::TabInterface* tab() const;
+  // Whether the card's page plays; false for a paused one.
+  bool playing() const;
+  // The card's title and favicon: its tab's row's.
+  std::u16string title() const;
+  ui::ImageModel favicon() const;
+
+  // Mp7, Mp9: shows the card's tab, in its Space. False with no card.
+  bool ShowTab();
+  // Mp7, Mp8: pauses the card's page, or plays it if paused.
+  void PlayOrPause();
+  // Mp7: stops the card's page; the card goes until the tab plays again.
+  void Stop();
+
+ private:
+  class TabWatch;
+  friend class TabWatch;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  void WatchAllTabs();
+  void Watch(tabs::TabInterface* tab);
+  void Unwatch(tabs::TabInterface* tab);
+  TabWatch* WatchOf(tabs::TabInterface* tab) const;
+  TabWatch* CardWatch() const;
+  // The row of the tab `id` changed its title or favicon.
+  void OnTabUIChanged(int id);
+
+  // Chooses the card's tab again and tells the observers when anything they
+  // show changed. `changed`: what they show changed in any case.
+  void Update(bool changed = false);
+  // A tab started to play: it is the newest.
+  uint64_t NextStart() { return ++starts_; }
+
+  const raw_ref<BrowserWindowInterface> browser_;
+  PrefChangeRegistrar registrar_;
+  std::map<tabs::TabInterface*, std::unique_ptr<TabWatch>> watches_;
+  int next_id_ = 0;
+  uint64_t starts_ = 0;
+  std::optional<int> card_;
+  bool card_playing_ = false;
+  base::ObserverList<Observer> observers_;
+  ui::ScopedUnownedUserData<AudioStrip> scoped_user_data_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_AUDIO_STRIP_H_
