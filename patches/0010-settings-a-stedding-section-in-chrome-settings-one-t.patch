+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-stedding-page' is the section for Stedding's own settings: the
+ * behaviours this browser adds on top of Chromium, each backed by one
+ * profile preference (chrome/browser/ui/stedding/stedding_prefs.h).
+ */
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_section.js';
+
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getCss} from './stedding_page.css.js';
+import {getHtml} from './stedding_page.html.js';
+
+export class SettingsSteddingPageElement extends CrLitElement implements
+    SettingsPlugin {
+  static get is() {
+    return 'settings-stedding-page';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  // SettingsPlugin implementation
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-stedding-page': SettingsSteddingPageElement;
+  }
+}
+
+customElements.define(
+    SettingsSteddingPageElement.is, SettingsSteddingPageElement);
