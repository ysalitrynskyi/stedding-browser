+  EXPECT_EQ(jar.partition_name(),
+            PartitionOf(tabs().GetActiveTab()).partition_name());
+}
+
+// sessions S12
+TEST_F(SpaceWindowTest, RestoredTabInIsolatedSpaceUsesItsPartition) {
+  Space* const work = model().AddSpace("Work", kBlue);
