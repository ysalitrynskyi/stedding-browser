+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return button->GetTooltipText().find(text) != std::u16string::npos;
+  })) << button->GetTooltipText();
+#if BUILDFLAG(IS_MAC)
+  EXPECT_TRUE(shortcuts::test::MainMenuShowsChord(
+      IDC_STEDDING_TOGGLE_DARK_PAGES, Accel(kFreeChord)));
