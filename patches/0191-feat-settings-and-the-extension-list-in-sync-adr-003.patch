+// Sf59, Sf33: another computer's part is not trusted. A setting that stays,
+// one this version does not know, a bad stamp or a value too long is dropped
+// alone; a part too large is not read.
+TEST(SidebarSyncSettingsTest, OnlySyncedSettingsAreRead) {
+  const auto triple = [](base::Value value, double t, const std::string& w) {
+    base::ListValue list;
+    list.Append(std::move(value));
+    list.Append(t);
+    list.Append(w);
+    return list;
+  };
+  base::DictValue part;
+  part.Set(stedding::prefs::kPeekEnabled, triple(base::Value(false), 5, kOffice));
+  part.Set(stedding::prefs::kCameraRowFullscreen,
+           triple(base::Value(true), 5, kOffice));
+  part.Set("stedding.not_a_setting_yet", triple(base::Value(1), 5, kOffice));
+  part.Set(stedding::prefs::kUiAnimate, triple(base::Value(false), -1, kOffice));
+  part.Set(stedding::prefs::kMenusShort,
+           triple(base::Value(false), 5, "not an install"));
+  part.Set(stedding::prefs::kSpacesLoop, base::Value("not a triple"));
+  part.Set(stedding::prefs::kCleanLinksKeptSites,
+           triple(base::Value(std::string(kMaxSettingBytes, 'x')), 5, kOffice));
+  const std::optional<Settings> read =
+      SettingsFromValue(base::Value(std::move(part)));
+  ASSERT_TRUE(read);
+  ASSERT_EQ(1u, read->size());
+  EXPECT_EQ("false", read->at(stedding::prefs::kPeekEnabled).json);
+
+  base::DictValue too_many;
+  for (size_t i = 0; i <= kMaxPartEntries; ++i) {
+    too_many.Set("stedding.x" + base::NumberToString(i),
+                 triple(base::Value(true), 5, kOffice));
+  }
+  EXPECT_FALSE(SettingsFromValue(base::Value(std::move(too_many))));
+  EXPECT_FALSE(SettingsFromValue(base::Value("not a part")));
+}
