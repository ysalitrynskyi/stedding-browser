+++ b/chrome/browser/ui/stedding/sidebar_panels.cc
@@ -0,0 +1,151 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/sidebar_panels.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_service.h"
+
+namespace stedding {
+
+DEFINE_USER_DATA(SidebarPanels);
+
+int SidebarOpenWidth(int user_width, bool panel_open) {
+  return panel_open ? std::max(user_width, kSidebarPanelMinWidth)
+                    : user_width;
+}
+
+std::optional<HistoryRange> HistoryRangeFromName(std::string_view name) {
+  if (name == "all") {
+    return HistoryRange::kAll;
+  }
+  if (name == "today") {
+    return HistoryRange::kToday;
+  }
+  if (name == "week") {
+    return HistoryRange::kWeek;
+  }
+  if (name == "month") {
+    return HistoryRange::kMonth;
+  }
+  return std::nullopt;
+}
+
+std::optional<base::Time> HistoryRangeStart(HistoryRange range,
+                                            base::Time now) {
+  int days_back = 0;
+  switch (range) {
+    case HistoryRange::kAll:
+      return std::nullopt;
+    case HistoryRange::kToday:
+      days_back = 0;
+      break;
+    case HistoryRange::kWeek:
+      days_back = 6;
+      break;
+    case HistoryRange::kMonth:
+      days_back = 29;
+      break;
+  }
+  // Midnight `days_back` calendar days ago. Each step back lands at noon
+  // before it asks for that day's midnight, so a day of 23 or 25 hours, at a
+  // change to or from summer time, moves it neither a day too far nor too
+  // short.
+  base::Time day = now.LocalMidnight();
+  for (int i = 0; i < days_back; ++i) {
+    day = (day - base::Hours(12)).LocalMidnight();
+  }
+  return day;
+}
+
+// static
+SidebarPanels* SidebarPanels::From(BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+SidebarPanels::SidebarPanels(ui::UnownedUserDataHost& host,
+                             PrefService& prefs,
+                             CanShowCallback can_show)
+    : prefs_(prefs),
+      can_show_(std::move(can_show)),
+      scoped_user_data_(host, *this) {
+  registrar_.Init(&prefs);
+  registrar_.Add(prefs::kSidebarLibraryPanels,
+                 base::BindRepeating(&SidebarPanels::OnEnabledChanged,
+                                     base::Unretained(this)));
+}
+
+SidebarPanels::~SidebarPanels() = default;
+
+bool SidebarPanels::Toggle(SidebarPanel panel) {
+  if (panel == SidebarPanel::kNone) {
+    Close();
+    return true;
+  }
+  if (open_ == panel) {
+    Close();
+    return true;
+  }
+  return Open(panel);
+}
+
+bool SidebarPanels::Open(SidebarPanel panel) {
+  if (panel == SidebarPanel::kNone) {
+    Close();
+    return true;
+  }
+  if (!CanShow()) {
+    return false;
+  }
+  Set(panel);
+  return true;
+}
+
+void SidebarPanels::Close() {
+  Set(SidebarPanel::kNone);
+}
+
+bool SidebarPanels::IsEnabled() const {
+  return prefs_->GetBoolean(prefs::kSidebarLibraryPanels);
+}
+
+bool SidebarPanels::CanShow() const {
+  return IsEnabled() && (!can_show_ || can_show_.Run());
+}
+
+void SidebarPanels::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SidebarPanels::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SidebarPanels::Set(SidebarPanel panel) {
+  if (open_ == panel) {
+    return;
+  }
+  const SidebarPanel previous = std::exchange(open_, panel);
+  for (Observer& observer : observers_) {
+    observer.OnSidebarPanelChanged(previous, panel);
+  }
+}
+
+void SidebarPanels::OnEnabledChanged() {
+  const bool enabled = IsEnabled();
+  // Pn14: turned off, an open panel closes; the keys open the pages again.
+  if (!enabled) {
+    Close();
+  }
+  for (Observer& observer : observers_) {
+    observer.OnSidebarPanelsEnabledChanged(enabled);
+  }
+}
+
+}  // namespace stedding
