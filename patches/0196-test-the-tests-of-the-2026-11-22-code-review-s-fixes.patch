--- /dev/null
+++ b/chrome/browser/ui/spaces/audit_b12_unittest.cc
@@ -0,0 +1,287 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/sidebar-file.md Sf47, Sf48, Sf52: a server that answers a
+// request with no sign-in with a 4xx status Stedding has no sentence of its
+// own for (some S3 services answer 400) has refused it, so a place that
+// refuses anyone that way passes the test. A place that gives anyone no
+// answer still does not, and a refusal keeps the sentence it had.
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "base/time/default_clock.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_bridge.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_fake_place.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_place.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_place_client.h"
+#include "net/http/http_request_headers.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_status_code.h"
+#include "services/data_decoder/public/cpp/test_support/in_process_data_decoder.h"
+#include "services/network/public/cpp/data_element.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/resource_request_body.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "services/network/test/test_url_loader_factory.h"
+#include "services/network/test/test_utils.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+// The error an S3 endpoint that takes only signed requests gives one with no
+// sign-in, in the words such a service may use.
+constexpr char kAnyoneRefusedB12[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Error><Code>InvalidArgument"
+    "</Code><Message>Authorization</Message></Error>";
+
+constexpr char kOwnB12[] = "aaaaaaaaaaaaaaaa";
+constexpr char kPeerNameB12[] = "stedding-sidebar-0123456789abcdef.json";
+constexpr char kOtherNameB12[] = "stedding-sidebar-fedcba9876543210.json";
+
+const char* KindNameB12(PlaceKind kind) {
+  return kind == PlaceKind::kS3 ? "S3" : "WebDAV";
+}
+
+// A place in memory behind a fake loader factory, which can answer every
+// request with no sign-in, or a signed read of one file, with a status of
+// its own.
+class RefusingServerB12 {
+ public:
+  explicit RefusingServerB12(PlaceKind place_kind)
+      : kind(place_kind),
+        place(place_kind),
+        shared(base::MakeRefCounted<
+               network::WeakWrapperSharedURLLoaderFactory>(&factory)) {
+    factory.SetInterceptor(base::BindRepeating(&RefusingServerB12::Answer,
+                                               base::Unretained(this)));
+  }
+
+  std::unique_ptr<PlaceClient> Client() {
+    const PlaceForm form = CheckPlaceForm(
+        place.Form(GURL("https://place.example.net/"), FakePlace::kSecret));
+    return std::make_unique<PlaceClient>(*form.place, *form.sign_in, shared,
+                                         base::DefaultClock::GetInstance());
+  }
+
+  const PlaceKind kind;
+  FakePlace place;
+  network::TestURLLoaderFactory factory;
+  scoped_refptr<network::SharedURLLoaderFactory> shared;
+  // A request with no sign-in is answered with this status, and on S3 with
+  // the error above.
+  int anyone_status = 0;
+  // How many requests with no sign-in were answered so.
+  int anyone_asked = 0;
+  // A signed read of the file of this name is answered with `file_status`.
+  std::string refused_file;
+  int file_status = 0;
+
+ private:
+  FakePlace::Reply Respond(const network::ResourceRequest& request) {
+    std::map<std::string, std::string> headers;
+    for (const net::HttpRequestHeaders::HeaderKeyValuePair& header :
+         request.headers.GetHeaderVector()) {
+      headers[base::ToLowerASCII(header.key)] = header.value;
+    }
+    const bool signed_in = headers.contains("authorization");
+    if (!signed_in && anyone_status) {
+      ++anyone_asked;
+      FakePlace::Reply refused;
+      refused.status = anyone_status;
+      if (kind == PlaceKind::kS3) {
+        refused.body = kAnyoneRefusedB12;
+        refused.headers.emplace_back("Content-Type", "application/xml");
+      }
+      return refused;
+    }
+    if (signed_in && file_status && !refused_file.empty() &&
+        request.method == "GET" &&
+        request.url.path().ends_with(refused_file)) {
+      FakePlace::Reply refused;
+      refused.status = file_status;
+      return refused;
+    }
+    std::string body;
+    if (request.request_body && !request.request_body->elements()->empty()) {
+      body = std::string(request.request_body->elements()
+                             ->front()
+                             .As<network::DataElementBytes>()
+                             .AsStringPiece());
+    }
+    return place.Handle(request.method, request.url, headers, body);
+  }
+
+  void Answer(const network::ResourceRequest& request) {
+    const FakePlace::Reply reply = Respond(request);
+    auto head = network::CreateURLResponseHead(
+        static_cast<net::HttpStatusCode>(reply.status));
+    for (const auto& [name, value] : reply.headers) {
+      head->headers->AddHeader(name, value);
+    }
+    factory.AddResponse(request.url, std::move(head), reply.body,
+                        network::URLLoaderCompletionStatus());
+  }
+};
+
+class SidebarSyncPlaceRefusalB12Test : public testing::Test {
+ protected:
+  PlaceCheck::Result Run(RefusingServerB12& server) {
+    std::unique_ptr<PlaceClient> client = server.Client();
+    base::test::TestFuture<PlaceCheck::Result> done;
+    PlaceCheck check(client.get(), done.GetCallback());
+    check.Start();
+    return done.Get();
+  }
+
+  std::unique_ptr<PlaceBridge> Bridge(RefusingServerB12& server,
+                                      const base::FilePath& profile_path) {
+    const PlaceForm form = CheckPlaceForm(server.place.Form(
+        GURL("https://place.example.net/"), FakePlace::kSecret));
+    auto bridge = std::make_unique<PlaceBridge>(
+        *form.place, server.shared, base::DefaultClock::GetInstance(),
+        profile_path,
+        base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()}));
+    bridge->SetSignIn(*form.sign_in);
+    return bridge;
+  }
+
+  PlaceFailure Pull(PlaceBridge& bridge) {
+    base::test::TestFuture<PlaceFailure> done;
+    bridge.Pull(kOwnB12, done.GetCallback());
+    return done.Get();
+  }
+
+  std::optional<std::string> Mirrored(const base::FilePath& profile_path,
+                                      const std::string& name) {
+    std::string body;
+    if (!base::ReadFileToString(
+            PlaceBridge::MirrorFor(profile_path)
+                .Append(base::FilePath::FromUTF8Unsafe(name)),
+            &body)) {
+      return std::nullopt;
+    }
+    return body;
+  }
+
+  base::test::TaskEnvironment task_environment_;
+  data_decoder::test::InProcessDataDecoder data_decoder_;
+};
+
+// P15-1a, Sf48: a server that refuses every request with no sign-in with a
+// 400, as some S3 services do, lists nothing and serves nothing to anyone, so
+// the place passes, and the probe goes. It failed with "serverError", as if
+// the server had given no answer.
+TEST_F(SidebarSyncPlaceRefusalB12Test, ARefusalWithA400ToAnyonePasses) {
+  for (const int status : {400, 409}) {
+    for (const PlaceKind kind : {PlaceKind::kWebDav, PlaceKind::kS3}) {
+      SCOPED_TRACE(base::StrCat(
+          {KindNameB12(kind), " refusing anyone with ",
+           base::NumberToString(status)}));
+      RefusingServerB12 server(kind);
+      server.anyone_status = status;
+      const PlaceCheck::Result result = Run(server);
+      EXPECT_EQ(result.failure, PlaceFailure::kNone)
+          << PlaceFailureName(result.failure);
+      // Both of Sf48's questions were asked: the list and the read.
+      EXPECT_EQ(server.anyone_asked, 2);
+      EXPECT_TRUE(server.place.Files().empty()) << "the probe stayed";
+    }
+  }
+}
+
+// P15-1a, Sf48: no answer to anyone, or "try later", is still no refusal, and
+// such a place does not pass.
+TEST_F(SidebarSyncPlaceRefusalB12Test, NoAnswerToAnyoneStillDoesNotPass) {
+  for (const int status : {408, 429, 500, 503}) {
+    for (const PlaceKind kind : {PlaceKind::kWebDav, PlaceKind::kS3}) {
+      SCOPED_TRACE(base::StrCat(
+          {KindNameB12(kind), " answering anyone with ",
+           base::NumberToString(status)}));
+      RefusingServerB12 server(kind);
+      server.anyone_status = status;
+      const PlaceCheck::Result result = Run(server);
+      EXPECT_EQ(result.failure, PlaceFailure::kServerError)
+          << PlaceFailureName(result.failure);
+      EXPECT_TRUE(server.place.Files().empty()) << "the probe stayed";
+      EXPECT_FALSE(result.made_folder);
+      EXPECT_FALSE(server.place.HasFolder());
+    }
+  }
+}
+
+// P15-1a, Sf47, Sf52: a refusal Stedding has no sentence of its own for is
+// told apart from no answer, and Settings says it as it did.
+TEST(SidebarSyncPlaceFailureB12Test, AnUnnamedRefusalIsNotNoAnswer) {
+  for (const PlaceOp op : {PlaceOp::kRoot, PlaceOp::kList, PlaceOp::kRead,
+                           PlaceOp::kWrite, PlaceOp::kDelete}) {
+    for (const int status : {400, 409, 412, 422}) {
+      SCOPED_TRACE(base::NumberToString(status));
+      EXPECT_EQ(PlaceFailureName(FailureOfStatus(op, status, true)),
+                "serverError");
+      EXPECT_EQ(PlaceFailureName(FailureOfS3Error(op, status, "")),
+                "serverError");
+      EXPECT_NE(FailureOfStatus(op, status, true),
+                FailureOfStatus(op, 503, true));
+    }
+    EXPECT_NE(FailureOfS3Error(op, 400, "InvalidArgument"),
+              FailureOfS3Error(op, 503, "ServiceUnavailable"));
+    // A request timed out, or too many: try later, which is no answer yet.
+    for (const int status : {408, 429, 500, 502, 503}) {
+      SCOPED_TRACE(base::NumberToString(status));
+      EXPECT_EQ(FailureOfStatus(op, status, true), PlaceFailure::kServerError);
+    }
+  }
+}
+
+// P15-1a, Sf52: one computer's file whose read the server refuses with a 4xx
+// it has no sentence for holds the others back from nothing, as one that
+// answers 500 does, and is asked for again.
+TEST_F(SidebarSyncPlaceRefusalB12Test, AFileRefusedWithA400HoldsNoOtherBack) {
+  for (const PlaceKind kind : {PlaceKind::kWebDav, PlaceKind::kS3}) {
+    SCOPED_TRACE(KindNameB12(kind));
+    base::ScopedTempDir temp;
+    ASSERT_TRUE(temp.CreateUniqueTempDir());
+    RefusingServerB12 server(kind);
+    server.place.PutFile(kPeerNameB12, "{\"a\":1}");
+    server.place.PutFile(kOtherNameB12, "{\"b\":2}");
+    server.refused_file = kPeerNameB12;
+    server.file_status = 400;
+    {
+      std::unique_ptr<PlaceBridge> bridge = Bridge(server, temp.GetPath());
+      EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+      EXPECT_EQ(Mirrored(temp.GetPath(), kOtherNameB12), "{\"b\":2}");
+      EXPECT_EQ(Mirrored(temp.GetPath(), kPeerNameB12), std::nullopt);
+
+      server.file_status = 0;
+      EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+      EXPECT_EQ(Mirrored(temp.GetPath(), kPeerNameB12), "{\"a\":1}");
+    }
+    // The bridge's file work ends before its folder goes.
+    task_environment_.RunUntilIdle();
+  }
+}
+
+}  // namespace
+
