+bool VerticalTabStripRegionView::IsGroundAt(const gfx::Point& point) {
+  // Inside the strip itself: the resize handle reaches past its edge over
+  // the card's gutter (sidebar Y18), and that reach is the handle's.
+  if (!base::FeatureList::IsEnabled(stedding::kArcStyleWindow) ||
+      !GetLocalBounds().Contains(point)) {
+    return false;
+  }
+  // A row, a button or another control under the pointer keeps the click.
+  // Most take every press, so it never gets here; those that let a middle
+  // press through (the Clear line outside its label, the resize handle) are
+  // refused here with the rest.
+  for (views::View* view = GetEventHandlerForPoint(point); view && view != this;
+       view = view->parent()) {
+    if (views::IsViewClass<views::Button>(view) ||
+        views::IsViewClass<TabView>(view) ||
+        views::IsViewClass<FolderView>(view) ||
+        views::IsViewClass<SplitTabView>(view) ||
+        views::IsViewClass<TabGroupView>(view) ||
+        views::IsViewClass<ClearTabsSeparator>(view) ||
+        views::IsViewClass<views::Textfield>(view) ||
+        views::IsViewClass<views::ResizeArea>(view) ||
+        views::IsViewClass<views::ScrollBar>(view) ||
+        views::IsViewClass<spaces::SpaceSwitcherView>(view)) {
+      return false;
+    }
+  }
+  return true;
+}
