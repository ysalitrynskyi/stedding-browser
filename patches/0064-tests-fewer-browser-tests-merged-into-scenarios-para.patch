+  // "Close all windows", then Stay, then the bookkeeping the owner did next.
+  // The page that asks goes last, on screen and without its question.
+  void StayThenTheBookkeepingWorks() {
+    SCOPED_TRACE("Stay then tab, folder, Space, pin, move");
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(),
+        embedded_test_server()->GetURL("asks.test", "/title1.html")));
+    content::WebContents* const asking = tabs()->GetActiveWebContents();
+    tabs::TabInterface* const asking_tab = tabs()->GetActiveTab();
+    ASSERT_TRUE(content::ExecJs(
+        asking,
+        "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+        "window.addEventListener('beforeunload', window.stay);"));
+
+    content::PrepContentsForBeforeUnloadTest(asking);
+    profiles::CloseProfileWindows(browser()->GetProfile());
+    javascript_dialogs::AppModalDialogController* const dialog =
+        ui_test_utils::WaitForAppModalDialog();
+    ASSERT_TRUE(dialog);
+    dialog->view()->CancelAppModalDialog();  // Stay.
+    base::RunLoop().RunUntilIdle();
+    ASSERT_EQ(1, tabs()->count()) << "the window stayed";
+
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL("next.test", "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::FolderTabCollection* const folder = tabs()->AddToNewFolder({1});
+    ASSERT_TRUE(folder);
+    folder->SetTitle("After Stay");
+    folder->SetCollapsed(true);
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model);
+    const spaces::SpaceId home = model->active_id();
+    const spaces::SpaceId other = model->AddSpace("Other", SK_ColorBLUE)->id();
+    ASSERT_TRUE(model->SetActiveSpace(other));
+    base::RunLoop().RunUntilIdle();
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(),
+        embedded_test_server()->GetURL("other.test", "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const tab = tabs()->GetActiveTab();
+    ASSERT_EQ(other, model->SpaceForTab(tab));
+
+    ASSERT_TRUE(
+        chrome::IsCommandEnabled(browser(), IDC_STEDDING_TOGGLE_SPACE_PIN));
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_SPACE_PIN);  // ⌘D
+    EXPECT_TRUE(model->IsSpacePinned(tab));
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_SPACE_PIN);
+    EXPECT_FALSE(model->IsSpacePinned(tab));
+
+    ASSERT_TRUE(chrome::IsCommandEnabled(
+        browser(), IDC_STEDDING_MOVE_TAB_TO_PREVIOUS_SPACE));
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_MOVE_TAB_TO_PREVIOUS_SPACE);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return model->SpaceForTab(tab) == home; }));
+    base::RunLoop().RunUntilIdle();
+
+    ASSERT_TRUE(model->SetActiveSpace(home));
+    tabs()->ActivateTabAt(tabs()->GetIndexOfTab(asking_tab));
+    ASSERT_TRUE(content::ExecJs(
+        asking, "window.removeEventListener('beforeunload', window.stay);"));
+  }
+};
 
