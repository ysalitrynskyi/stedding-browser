+
+// docs/features/routing.md D12-D14: Settings' one list of routes, driven
+// through the page: every rule, its fields and the add row.
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/strings/strcat.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/run_until.h"
+#include "base/token.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_router.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+namespace {
+
+// `body`, run on the settings page with `card`, the card's own shadow root,
+// once it is drawn; null while it is not.
+std::string OnTheCard(std::string_view body) {
+  return base::StrCat({R"(
+    (() => {
+      const find = (root, selector) => {
+        const hit = root.querySelector(selector);
+        if (hit) {
+          return hit;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot, selector);
+            if (found) {
+              return found;
+            }
+          }
+        }
+        return null;
+      };
+      const host = find(document, 'settings-stedding-routes-card');
+      const card = host ? host.shadowRoot : null;
+  )",
+                       body, "\n    })()"});
+}
+
+// The rules as the card draws them, one line each: kind, text, Space.
+constexpr char kRows[] = R"(
+  if (!card) {
+    return 'no card';
+  }
+  return [...card.querySelectorAll('.route-rule')].map(row => [
+    row.querySelector('select.route-kind').value,
+    row.querySelector('cr-input.route-text').value,
+    row.querySelector('select.route-space').selectedOptions[0].textContent
+        .trim(),
+  ].join(' ')).join('\n');
+)";
+
+// Sets field `selector` of the row with text $1 to $2, as a person leaves a
+// field they typed in.
+constexpr char kEditText[] = R"(
+  const row = [...card.querySelectorAll('.route-rule')].find(
+      each => each.querySelector('cr-input.route-text').value === $1);
+  const field = row.querySelector('cr-input.route-text');
+  field.value = $2;
+  field.dispatchEvent(new Event('change'));
+  return '';
+)";
+
+// Picks option $2 of select.$3 of the row with text $1.
+constexpr char kPick[] = R"(
+  const row = [...card.querySelectorAll('.route-rule')].find(
+      each => each.querySelector('cr-input.route-text').value === $1);
+  const select = row.querySelector('select.' + $3);
+  select.value = $2;
+  select.dispatchEvent(new Event('change'));
+  return '';
+)";
+
+// The add row: kind $1, text $2, Space $3.
+constexpr char kAdd[] = R"(
+  const kind = card.querySelector('#addKind');
+  kind.value = $1;
+  kind.dispatchEvent(new Event('change'));
+  const space = card.querySelector('#addSpace');
+  space.value = $3;
+  space.dispatchEvent(new Event('change'));
+  card.querySelector('#addText').value = $2;
+  card.querySelector('#addRoute').click();
+  return '';
+)";
+
+class RoutesCardTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    model_ = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model_);
+    home_ = model_->active_id().ToString();
+    work_ = model_->AddSpace("Work", SK_ColorBLUE)->id().ToString();
+    prefs_ = browser()->GetProfile()->GetPrefs();
+  }
+
+  void TearDownOnMainThread() override {
+    model_ = nullptr;
+    prefs_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  void AddRule(spaces::Route::Match match,
+               const std::string& pattern,
+               const std::string& space) {
+    spaces::Route rule;
+    rule.match = match;
+    rule.pattern = pattern;
+    rule.space = space;
+    spaces::AddRoute(prefs_, rule);
+  }
+
+  content::WebContents* OpenPage() {
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), GURL("chrome://settings/stedding")));
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  std::string Rows(content::WebContents* page) {
+    return content::EvalJs(page, OnTheCard(kRows)).ExtractString();
+  }
+
+  // Waits until the card draws `expected`.
+  bool Draws(content::WebContents* page, const std::string& expected) {
+    return base::test::RunUntil([&]() { return Rows(page) == expected; });
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  raw_ptr<PrefService> prefs_ = nullptr;
+  std::string home_;
+  std::string work_;
+};
+
+// routing D12: the card lists every rule, each kind, in the order that
+// decides, with each one's Space: rules had shown only under their Space, and
+// only by their text.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, EveryRuleIsListedInTheOrderThatDecides) {
+  AddRule(spaces::Route::Match::kSite, "github.com", work_);
+  AddRule(spaces::Route::Match::kContains, "/docs/", home_);
+  AddRule(spaces::Route::Match::kHost, "dev.example.com", work_);
+  content::WebContents* const page = OpenPage();
+  const std::string home_name = base::UTF16ToUTF8(
+      model_->DisplayName(*spaces::SpaceId::FromOptionalToken(
+          base::Token::FromString(home_))));
+  EXPECT_TRUE(Draws(page, "site github.com Work\ncontains /docs/ " + home_name +
+                              "\nhost dev.example.com Work"))
+      << Rows(page);
+}
+
+// routing D12: the add row takes the kind, the text and the Space. A site
+// typed as an address becomes the site; a contains rule keeps its text. A
+// rule added empties the field.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, TheAddRowWritesASiteOrAContainsRule) {
+  content::WebContents* const page = OpenPage();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnTheCard("return !!card && !!card."
+                                           "querySelector('#addText');"))
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(content::ExecJs(
+      page, OnTheCard(content::JsReplace(kAdd, "site",
+                                         "https://gist.github.com/x", work_))));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return spaces::ReadRoutes(prefs_).size() == 1u; }));
+  ASSERT_TRUE(content::ExecJs(
+      page, OnTheCard(content::JsReplace(kAdd, "contains", "/Issues/", work_))));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return spaces::ReadRoutes(prefs_).size() == 2u; }));
+  const std::vector<spaces::Route> rules = spaces::ReadRoutes(prefs_);
+  EXPECT_EQ(spaces::Route::Match::kSite, rules[0].match);
+  EXPECT_EQ("github.com", rules[0].pattern);
+  EXPECT_EQ(work_, rules[0].space);
+  EXPECT_EQ(spaces::Route::Match::kContains, rules[1].match);
+  EXPECT_EQ("/Issues/", rules[1].pattern);
+  EXPECT_TRUE(Draws(page, "site github.com Work\ncontains /Issues/ Work"))
+      << Rows(page);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnTheCard("return card.querySelector("
+                                           "'#addText').value;"))
+               .ExtractString()
+               .empty();
+  })) << "the field keeps what was added";
+}
+
+// routing D12 (BACKLOG S-349): what is no site stays in the field, which says
+// why, and nothing is written.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, TextThatIsNoSiteStaysInTheField) {
+  content::WebContents* const page = OpenPage();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnTheCard("return !!card && !!card."
+                                           "querySelector('#addText');"))
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(content::ExecJs(
+      page, OnTheCard(content::JsReplace(kAdd, "site", "https://", home_))));
+  const auto field_reads = [&]() {
+    return content::EvalJs(page,
+                           OnTheCard("const field = card.querySelector("
+                                     "'#addText'); return field.value + '|' +"
+                                     " String(field.invalid);"))
+        .ExtractString();
+  };
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return field_reads() == "https://|true"; }))
+      << field_reads();
+  EXPECT_TRUE(spaces::ReadRoutes(prefs_).empty());
+}
+
+// routing D12: a rule the tab menu writes shows at once: the list follows the
+// preference, not the page's own writes.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, ARuleMadeElsewhereShowsAtOnce) {
+  content::WebContents* const page = OpenPage();
+  ASSERT_TRUE(Draws(page, ""));
+  AddRule(spaces::Route::Match::kSite, "example.com", work_);
+  EXPECT_TRUE(Draws(page, "site example.com Work")) << Rows(page);
+}
+
+// routing D12, D3: the Space for links from other apps moved into the card,
+// and still writes its preference.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, TheDefaultForLinksIsInTheCard) {
+  content::WebContents* const page = OpenPage();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page,
+                           OnTheCard("return !!card && !!card.querySelector("
+                                     "'#externalDefaultSpace');"))
+        .ExtractBool();
+  })) << "the default is not in the card";
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(
+               page,
+               OnTheCard(content::JsReplace(
+                   "const menu = card.querySelector("
+                   "'#externalDefaultSpace').shadowRoot.querySelector("
+                   "'select'); return [...menu.options].some(option =>"
+                   " option.value === $1);",
+                   work_)))
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(content::ExecJs(
+      page, OnTheCard(content::JsReplace(
+                "const menu = card.querySelector('#externalDefaultSpace')"
+                ".shadowRoot.querySelector('select'); menu.value = $1;"
+                " menu.dispatchEvent(new Event('change'));",
+                work_))));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return prefs_->GetString(stedding::prefs::kExternalDefaultSpace) == work_;
+  }));
+}
+
+// routing D5 (BACKLOG S-349): a remove names its rule by what it is. Its place
+// in the preference moves as soon as another rule goes, and a second click
+// before the list was drawn again removed another site's rule.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, TwoQuickRemovesTakeTheirOwnRules) {
+  for (const char* site : {"a.test", "b.test", "c.test"}) {
+    AddRule(spaces::Route::Match::kSite, site, home_);
+  }
+  content::WebContents* const page = OpenPage();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page,
+                           OnTheCard("return !!card && card.querySelectorAll("
+                                     "'.route-rule').length === 3;"))
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(content::ExecJs(page, OnTheCard(R"(
+      const remove = text =>
+          [...card.querySelectorAll('.route-rule')].find(row =>
+              row.querySelector('cr-input.route-text').value === text)
+              .querySelector('.route-remove');
+      const [first, second] = [remove('a.test'), remove('b.test')];
+      first.click();
+      second.click();
+      return '';)")));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return spaces::ReadRoutes(prefs_).size() == 1u; }));
+  EXPECT_EQ("c.test", spaces::ReadRoutes(prefs_).front().pattern)
+      << "another site's rule went";
+}
+
+// routing D13: kind, text and Space change where the rule is listed, and the
+// rule keeps its place, which decides.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, ARuleIsEditedWhereItIsListed) {
+  AddRule(spaces::Route::Match::kSite, "a.test", home_);
+  AddRule(spaces::Route::Match::kSite, "b.test", home_);
+  content::WebContents* const page = OpenPage();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page,
+                           OnTheCard("return !!card && card.querySelectorAll("
+                                     "'.route-rule').length === 2;"))
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(content::ExecJs(
+      page, OnTheCard(content::JsReplace(kEditText, "a.test", "first.test"))));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return spaces::ReadRoutes(prefs_).front().pattern == "first.test";
+  }));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return Rows(page).starts_with("site first.test");
+  }));
+  ASSERT_TRUE(content::ExecJs(page, OnTheCard(content::JsReplace(
+                                        kPick, "first.test", work_,
+                                        "route-space"))));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return spaces::ReadRoutes(prefs_).front().space == work_;
+  }));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return Rows(page).starts_with("site first.test Work");
+  }));
+  ASSERT_TRUE(content::ExecJs(page, OnTheCard(content::JsReplace(
+                                        kPick, "first.test", "contains",
+                                        "route-kind"))));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return spaces::ReadRoutes(prefs_).front().match ==
+           spaces::Route::Match::kContains;
+  }));
+  const std::vector<spaces::Route> rules = spaces::ReadRoutes(prefs_);
+  ASSERT_EQ(2u, rules.size());
+  EXPECT_EQ("first.test", rules[0].pattern);
+  EXPECT_EQ(work_, rules[0].space);
+  EXPECT_EQ("b.test", rules[1].pattern);
+}
+
+// routing D13: an edit that is refused writes nothing; the field shows the
+// rule again and says why. A rule of a kind the add row does not offer shows
+// its own kind.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, ARefusedEditPutsTheFieldBack) {
+  AddRule(spaces::Route::Match::kSite, "a.test", home_);
+  AddRule(spaces::Route::Match::kHostSuffix, "dev.example.com", home_);
+  content::WebContents* const page = OpenPage();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page,
+                           OnTheCard("return !!card && card.querySelectorAll("
+                                     "'.route-rule').length === 2;"))
+        .ExtractBool();
+  }));
+  EXPECT_TRUE(Rows(page).find("host-suffix dev.example.com") !=
+              std::string::npos)
+      << Rows(page);
+  ASSERT_TRUE(content::ExecJs(
+      page, OnTheCard(content::JsReplace(kEditText, "a.test", "https://"))));
+  const auto first_reads = [&]() {
+    return content::EvalJs(page, OnTheCard(R"(
+        const field = card.querySelector('.route-rule cr-input.route-text');
+        return field.value + '|' + String(field.invalid);)"))
+        .ExtractString();
+  };
+  EXPECT_TRUE(
+      base::test::RunUntil([&]() { return first_reads() == "a.test|true"; }))
+      << first_reads();
+  EXPECT_EQ("a.test", spaces::ReadRoutes(prefs_).front().pattern);
+}
+
+// routing D14: a rule whose Space is gone, or which names none, is listed as
+// such and goes when asked. It was hidden from every list.
+IN_PROC_BROWSER_TEST_F(RoutesCardTest, ARuleNamingNoSpaceIsListedAndRemovable) {
+  AddRule(spaces::Route::Match::kSite, "gone.test", "no-such-space");
+  base::ListValue raw = prefs_->GetList(stedding::prefs::kSpaceRoutes).Clone();
+  base::DictValue none;
+  none.Set("match", "contains");
+  none.Set("pattern", "/left/");
+  none.Set("space", "");
+  raw.Append(std::move(none));
+  prefs_->SetList(stedding::prefs::kSpaceRoutes, std::move(raw));
+  content::WebContents* const page = OpenPage();
+  EXPECT_TRUE(Draws(page,
+                    "site gone.test No Space\ncontains /left/ No Space"))
+      << Rows(page);
+  ASSERT_TRUE(content::ExecJs(page, OnTheCard(R"(
+      card.querySelectorAll('.route-rule .route-remove')[1].click();
+      return '';)")));
+  EXPECT_TRUE(Draws(page, "site gone.test No Space")) << Rows(page);
+  ASSERT_TRUE(content::ExecJs(page, OnTheCard(content::JsReplace(
+                                        kPick, "gone.test", work_,
+                                        "route-space"))));
+  EXPECT_TRUE(Draws(page, "site gone.test Work")) << Rows(page);
+  EXPECT_EQ(work_, spaces::ReadRoutes(prefs_).front().space);
+}
+
+}  // namespace
