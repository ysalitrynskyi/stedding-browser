+// P36-1d, peek P20: a page in a peek over the page that asks for full screen
+// (a video's full-screen button) is told no, and goes on in the card. The
+// peek's page is in no tab and nothing can show it full screen there: the
+// request was granted and then nothing happened, and the page waited for a
+// full screen that never came.
+IN_PROC_BROWSER_TEST_F(PeekOverPageB27Test, AFullScreenRequestInAPeekIsRefused) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  EXPECT_FALSE(page->GetDelegate()->CanEnterFullscreenModeForTab(
+      page->GetPrimaryMainFrame()))
+      << "the peek lets its page ask for a full screen it cannot show";
+  EXPECT_EQ("refused",
+            content::EvalJs(
+                page,
+                "Promise.race(["
+                "  document.documentElement.requestFullscreen().then("
+                "      () => 'in', () => 'refused'),"
+                "  new Promise(done => setTimeout(() => done('pending'), "
+                "                                 2000))])"))
+      << "the page's request for full screen had no answer";
+  EXPECT_FALSE(page->IsFullscreen());
+  EXPECT_EQ(peek, stedding::PeekOverlay::ForSource(pin))
+      << "the request closed the peek";
+}
