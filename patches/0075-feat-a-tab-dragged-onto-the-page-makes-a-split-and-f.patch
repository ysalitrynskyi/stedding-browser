+// toolbar T39 (BACKLOG S-104): the extensions chord's modifier, Cmd on the
+// Mac and Ctrl+Alt elsewhere, and a key of it let go.
+#if BUILDFLAG(IS_MAC)
+constexpr int kChordModifiers = ui::EF_COMMAND_DOWN;
+constexpr ui::KeyboardCode kChordKey = ui::VKEY_COMMAND;
+#else
+constexpr int kChordModifiers = ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN;
+constexpr ui::KeyboardCode kChordKey = ui::VKEY_CONTROL;
+#endif
+
+ui::KeyEvent ChordKeyReleased() {
+  return ui::KeyEvent(ui::EventType::kKeyReleased, kChordKey, ui::EF_NONE);
+}
