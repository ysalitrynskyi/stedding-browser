+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_ADDRESS_ROW_H_
+#define CHROME_BROWSER_UI_STEDDING_ADDRESS_ROW_H_
+
+#include <optional>
+
+#include "base/memory/raw_ref.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+
+namespace stedding {
+
+// docs/features/toolbar.md T8, T10-T12: the window's answer to "is the
+// address row shown", asked by BrowserView::IsToolbarVisible at every
+// layout. Owned by the window's SpaceModel, like the page colour, so
+// BrowserView's header stays untouched.
+class AddressRow : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(AddressRow);
+
+  static AddressRow* From(BrowserWindowInterface* browser);
+
+  explicit AddressRow(BrowserWindowInterface& browser);
+  AddressRow(const AddressRow&) = delete;
+  AddressRow& operator=(const AddressRow&) = delete;
+  ~AddressRow() override;
+
+  // The rule over the window's state now. Notices a sidebar change and drops
+  // the override then (T10).
+  bool IsVisible();
+
+  // shift-cmd-D (T10): the opposite of what shows now, until the sidebar's
+  // state changes.
+  void Toggle();
+
+  std::optional<bool> override_for_testing() const { return override_; }
+
+  // TabStripModelObserver: the localhost exception follows the active tab.
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  bool SidebarCollapsed() const;
+  void Relayout();
+
+  const raw_ref<BrowserWindowInterface> browser_;
+  std::optional<bool> override_;
+  std::optional<bool> last_collapsed_;
+  PrefChangeRegistrar pref_registrar_;
+  std::optional<ui::ScopedUnownedUserData<AddressRow>> scoped_user_data_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_ADDRESS_ROW_H_
