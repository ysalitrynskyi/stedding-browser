+
+// updates Up25: bytes that keep arriving are not a stall, however slowly, and
+// however long the whole takes.
+TEST_F(WinAppUpdaterTest, ASlowDownloadIsNotAStall) {
+  const std::string installer = "MZ the beta 19 installer";
+  loader_factory_.AddResponse(
+      kFeedUrl,
+      SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()));
+  Start();
+  task_environment_.FastForwardBy(base::Seconds(11));
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(1, loader_factory_.NumPending());
+
+  mojo::ScopedDataPipeProducerHandle producer;
+  mojo::ScopedDataPipeConsumerHandle consumer;
+  ASSERT_EQ(MOJO_RESULT_OK, mojo::CreateDataPipe(1024, producer, consumer));
+  network::TestURLLoaderFactory::PendingRequest* const request =
+      loader_factory_.GetPendingRequest(0);
+  request->client->OnReceiveResponse(
+      network::CreateURLResponseHead(net::HTTP_OK), std::move(consumer),
+      std::nullopt);
+  // Each byte fifty seconds after the last: minutes in all, never a minute
+  // without one.
+  for (const char byte : installer) {
+    ASSERT_EQ(MOJO_RESULT_OK,
+              producer->WriteAllData(base::as_bytes(base::span_from_ref(byte))));
+    task_environment_.RunUntilIdle();
+    task_environment_.FastForwardBy(base::Seconds(50));
+    ASSERT_EQ(2u, loader_factory_.total_requests());
+    ASSERT_EQ(State::kDownloading, updater_->state());
+  }
+  producer.reset();
+  network::URLLoaderCompletionStatus status(net::OK);
+  status.decoded_body_length = base::ByteSize(installer.size());
+  request->client->OnComplete(status);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(1, installer_runs());
+  EXPECT_EQ(State::kReady, updater_->state());
+}
