+// sidebar Y41 (BACKLOG S-96): with the sidebar on the window's right the
+// traffic lights stay at the window's top left, over the address row: each
+// sits on the row's page-coloured bar, left of the row's first button, as
+// while the sidebar is hidden (Y19). The strip's top row keeps no box for
+// them: open, its toggle stands at the row's left padding on the row's own
+// line; in the rail it stays on that line too, rather than under a box. In
+// full screen with the row sliding in, the row keeps the lights' box at its
+// left. The View menu's row names the side the sidebar goes to (Y34).
+IN_PROC_BROWSER_TEST_F(WindowButtonsTest, OnTheRightTheLightsSitOnTheRow) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  VerticalTabStripRegionView* const strip =
+      browser_view->vertical_tab_strip_region_view_for_testing();
+  PrefService* const pref_service = browser()->GetProfile()->GetPrefs();
+  views::Widget* const widget = browser_view->GetWidget();
+  NSWindow* const window = widget->GetNativeWindow().GetNativeNSWindow();
+  views::test::RunScheduledLayout(widget);
+  const gfx::Rect lights = LightsFromWindowTopLeft(
+      window, browser_view->GetBoundsInScreen().origin());
+  ASSERT_FALSE(lights.IsEmpty());
+
+  // The View menu's row, as the menu bar asks the window before it opens.
+  const auto menu_row_title = [&]() {
+    remote_cocoa::mojom::ValidateUserInterfaceItemResult result;
+    static_cast<views::NativeWidgetMac*>(widget->native_widget())
+        ->ValidateUserInterfaceItem(IDC_STEDDING_SIDEBAR_SIDE, &result);
+    EXPECT_TRUE(result.enable);
+    EXPECT_TRUE(result.set_hidden_state);
+    EXPECT_FALSE(result.new_hidden_state) << "the sidebar shows";
+    return result.new_title.value_or(std::u16string());
+  };
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STEDDING_MOVE_SIDEBAR_RIGHT),
+            menu_row_title());
+
+  pref_service->SetBoolean(stedding::prefs::kSidebarOnRight, true);
+  views::test::RunScheduledLayout(widget);
+  ASSERT_EQ(browser_view->width(), strip->bounds().right())
+      << "the sidebar on the right";
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_STEDDING_MOVE_SIDEBAR_LEFT),
+            menu_row_title());
+
+  views::View* const toggle = strip->GetTopContainer()->GetCollapseButton();
+  ASSERT_TRUE(toggle);
+  const auto expect_lights_on_the_row = [&]() {
+    gfx::Rect bar =
+        gfx::ToEnclosingRect(stedding::PageBarSurface(browser_view));
+    ASSERT_FALSE(bar.IsEmpty());
+    views::View::ConvertRectToScreen(browser_view, &bar);
+    const int contents_left = browser_view->toolbar()->GetBoundsInScreen().x();
+    for (NSWindowButton kind :
+         {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+      NSButton* const button = [window standardWindowButton:kind];
+      ASSERT_TRUE(button);
+      const gfx::Rect frame = ScreenFrame(window, button);
+      EXPECT_TRUE(bar.Contains(frame.CenterPoint()))
+          << "window button " << kind << " at " << frame.ToString()
+          << " is off the row's bar " << bar.ToString();
+      EXPECT_LT(frame.right(), contents_left)
+          << "the row's contents run under window button " << kind;
+    }
+    // The toggle on the row's own line, not dropped under a box.
+    const gfx::Rect row = browser_view->toolbar()->GetBoundsInScreen();
+    EXPECT_NEAR(row.CenterPoint().y(),
+                toggle->GetBoundsInScreen().CenterPoint().y(), 2);
+  };
+  {
+    SCOPED_TRACE("open");
+    ASSERT_FALSE(
+        tabs::VerticalTabStripStateController::From(browser())->IsCollapsed());
+    expect_lights_on_the_row();
+    EXPECT_EQ(GetLayoutConstant(
+                  LayoutConstant::kVerticalTabStripHorizontalPadding),
+              views::View::ConvertRectToTarget(toggle, strip,
+                                               toggle->GetLocalBounds())
+                  .x())
+        << "the toggle at the row's left padding, with no box before it";
+  }
+  {
+    SCOPED_TRACE("the rail");
+    tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+        true);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(widget);
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+                 TabStripAnimations::kVerticalTabStrip) &&
+             strip->width() == VerticalTabStripRegionView::kCollapsedWidth;
+    }));
+    EXPECT_EQ(browser_view->width(), strip->bounds().right());
+    expect_lights_on_the_row();
+    tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+        false);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(widget);
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+  }
+  {
+    SCOPED_TRACE("full screen, the row sliding in");
+    ui::test::ScopedFakeNSWindowFullscreen fake_fullscreen;
+    pref_service->SetBoolean(prefs::kShowFullscreenToolbar, false);
+    chrome::ToggleFullscreenMode(browser());
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(widget);
+      return widget->IsFullscreen();
+    }));
+    views::test::RunScheduledLayout(widget);
+    EXPECT_GE(browser_view->toolbar()->bounds().x(), lights.right())
+        << "the row's contents start past where the lights come in";
+    chrome::ToggleFullscreenMode(browser());
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(widget);
+      return !widget->IsFullscreen();
+    }));
+  }
+}
