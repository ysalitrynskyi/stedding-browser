#!/usr/bin/env bash
# Move a checkout that holds an older series onto the series in patches/, rewriting only
# the files whose content differs (docs/HANDOFF.md, trap 89).
#
# Usage:
#   tooling/move-series            # replay patches/ on the pin and move the branch there
#   tooling/move-series --check    # replay and list the files that would change; move nothing
#   tooling/move-series --force    # move even when the branch is not where the last
#                                  # apply or move left it (refs/stedding/applied)
#
# tooling/apply-patches checks out the pin and `git am`s every patch, which writes every
# file the series touches, so the next build recompiles for hours, and it refuses the
# tree the branding leaves modified on purpose. This replays the series as commits in a
# temporary index on the pin (`git mailinfo -b`, as `git am --keep-non-patch` reads a
# patch; `git apply --cached`, three-way when a plain apply fails; `git commit-tree`
# with the patch's author and date), then runs `git read-tree -m -u <old tip> <new tip>`:
# the index and the working tree change only where the two trees differ, and the
# branding's modified files are left as they are. `stedding-work` and
# refs/stedding/applied then point at the new tip. The commits differ from another
# machine's in their committer only; `tooling/update-patches` writes the same patches.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

CHECK_ONLY=0
FORCE=0
for arg in "$@"; do
  case "$arg" in
    --check)   CHECK_ONLY=1 ;;
    --force)   FORCE=1 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *)         die "unknown argument: $arg" ;;
  esac
done

PATCH_DIR="$STEDDING_ROOT/patches"
WORK_BRANCH="stedding-work"
APPLIED_REF="refs/stedding/applied"

[ -d "$CHROMIUM_SRC/.git" ] || die "no checkout at $CHROMIUM_SRC — run tooling/sync-chromium"
cd "$CHROMIUM_SRC" || die "cannot enter $CHROMIUM_SRC"
git rev-parse -q --verify "refs/tags/$CHROMIUM_TAG" >/dev/null \
  || die "pin $CHROMIUM_TAG is not in the checkout — run tooling/sync-chromium"
[ "$(git rev-parse --abbrev-ref HEAD)" = "$WORK_BRANCH" ] \
  || die "the checkout is not on $WORK_BRANCH; tooling/apply-patches makes it"
old="$(git rev-parse HEAD)"
stamped="$(git rev-parse -q --verify "$APPLIED_REF" 2>/dev/null || echo none)"
if [ "$old" != "$stamped" ] && [ "$FORCE" -eq 0 ] && [ "$CHECK_ONLY" -eq 0 ]; then
  die "$WORK_BRANCH is at $(git rev-parse --short "$old"), not where the last apply or move
     left it. Work committed there and not exported would be left behind.
     Export it first:   tooling/update-patches
     Or move anyway:    tooling/move-series --force"
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/stedding-move.XXXXXX")"
trap 'rm -rf "$work"' EXIT
export GIT_INDEX_FILE="$work/index"
git read-tree "refs/tags/$CHROMIUM_TAG^{tree}"
parent="$(git rev-parse "refs/tags/$CHROMIUM_TAG^{commit}")"
count=0
merged=0
while IFS= read -r p; do
  git mailinfo -b "$work/msg" "$work/patch" <"$p" >"$work/info"
  if ! git apply --cached "$work/patch" 2>/dev/null; then
    git apply --cached --3way "$work/patch" \
      || die "$(basename "$p") does not apply onto the patches before it; nothing moved"
    merged=$((merged + 1))
  fi
  tree="$(git write-tree)"
  { printf '%s\n\n' "$(sed -n 's/^Subject: //p' "$work/info")"; cat "$work/msg"; } \
    | git stripspace >"$work/message"
  parent="$(GIT_AUTHOR_NAME="$(sed -n 's/^Author: //p' "$work/info")" \
            GIT_AUTHOR_EMAIL="$(sed -n 's/^Email: //p' "$work/info")" \
            GIT_AUTHOR_DATE="$(sed -n 's/^Date: //p' "$work/info")" \
            git commit-tree "$tree" -p "$parent" -F "$work/message")"
  count=$((count + 1))
done < <(find "$PATCH_DIR" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.patch' | sort)
unset GIT_INDEX_FILE
new="$parent"

log "replayed $count patch(es) onto $CHROMIUM_TAG ($merged by a three-way merge)"
changed="$(git diff --name-only "$old" "$new")"
if [ -z "$changed" ]; then
  log "the checkout already holds this series: no file differs"
else
  log "files that differ from $WORK_BRANCH at $(git rev-parse --short "$old"):"
  printf '%s\n' "$changed" | sed 's/^/     /' >&2
fi
[ "$CHECK_ONLY" -eq 0 ] || exit 0

git read-tree -m -u "$old" "$new" \
  || die "the move would overwrite a modified file the series changes; nothing moved"
git update-ref "refs/heads/$WORK_BRANCH" "$new" "$old"
git update-ref "$APPLIED_REF" "$new"
log "$WORK_BRANCH at $(git rev-parse --short "$new"); only the files listed were written"
