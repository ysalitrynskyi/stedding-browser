-SpaceQuery ParseSpaceQuery(std::u16string_view query) {
+namespace {
+
+bool SameFolded(std::u16string_view a, std::u16string_view b) {
+  return base::i18n::FoldCase(a) == base::i18n::FoldCase(b);
+}
+
+}  // namespace
+
+SpaceQuery ParseSpaceQuery(std::u16string_view query,
+                           base::span<const std::u16string> names) {
   SpaceQuery parsed;
   if (query.empty() || query[0] != u'@') {
     parsed.rest = std::u16string(query);
     return parsed;
   }
-  const size_t space = query.find(u' ');
+  const std::u16string_view after = query.substr(1);
+  // K19 (BACKLOG S-164): the longest whole name first, so "@Work Stuff rust"
+  // is the Space "Work Stuff" with the text "rust", not "Work" with
+  // "Stuff rust".
+  const std::u16string* best = nullptr;
+  for (const std::u16string& name : names) {
+    if (name.empty() || name.size() > after.size() ||
+        (best && name.size() <= best->size())) {
+      continue;
+    }
+    if (after.size() > name.size() && after[name.size()] != u' ') {
+      continue;
+    }
+    if (SameFolded(after.substr(0, name.size()), name)) {
+      best = &name;
+    }
+  }
+  if (best) {
+    parsed.space_prefix = *best;
+    parsed.whole_name = true;
+    if (after.size() > best->size()) {
+      parsed.rest = std::u16string(after.substr(best->size() + 1));
+    }
+    return parsed;
+  }
+  const size_t space = after.find(u' ');
   if (space == std::u16string_view::npos) {
-    parsed.space_prefix = std::u16string(query.substr(1));
+    parsed.space_prefix = std::u16string(after);
     return parsed;
   }
-  parsed.space_prefix = std::u16string(query.substr(1, space - 1));
-  parsed.rest = std::u16string(query.substr(space + 1));
+  parsed.space_prefix = std::u16string(after.substr(0, space));
+  parsed.rest = std::u16string(after.substr(space + 1));
   return parsed;
 }
 
+bool SpaceNameMatches(const SpaceQuery& query, std::u16string_view name) {
+  if (!query.space_prefix) {
+    return true;
+  }
+  return query.whole_name ? SameFolded(name, *query.space_prefix)
+                          : SpaceNameMatchesPrefix(name, *query.space_prefix);
+}
+
 bool SpaceNameMatchesPrefix(std::u16string_view name,
                             std::u16string_view prefix) {
   if (prefix.empty()) {
     return true;
   }
-  return base::StartsWith(name, prefix, base::CompareCase::INSENSITIVE_ASCII);
+  // K19 (BACKLOG S-164): folded in any script, so a lowercase u with an
+  // umlaut finds a Space whose name starts with the capital one.
+  const std::u16string folded_name = base::i18n::FoldCase(name);
+  return std::u16string_view(folded_name)
+      .starts_with(base::i18n::FoldCase(prefix));
 }
 
 }  // namespace spaces
