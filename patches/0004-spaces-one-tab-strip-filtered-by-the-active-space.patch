+void VerticalTabStripRegionView::OnSpaceChipHovered(
+    const std::u16string& name,
+    const gfx::Rect& chip_bounds) {
+  if (!space_hover_pill_) {
+    return;
+  }
+  if (name.empty()) {
+    space_hover_pill_->SetVisible(false);
+    return;
+  }
+  space_hover_pill_->SetText(name);
+  const gfx::Size text = space_hover_pill_->GetPreferredSize();
+  const int width = text.width() + 16;
+  const int height = text.height() + 6;
+  // Centred over the chip, floating just above the row, clamped to the
+  // sidebar.
+  int x = chip_bounds.CenterPoint().x() - width / 2;
+  x = std::clamp(x, 4, std::max(4, this->width() - width - 4));
+  const int y = chip_bounds.y() - height - 4;
+  space_hover_pill_->SetBoundsRect(gfx::Rect(x, y, width, height));
+  space_hover_pill_->SetVisible(true);
+  // Above the chips in paint order.
+  ReorderChildView(space_hover_pill_, children().size() - 1);
+}
+
+void VerticalTabStripRegionView::ClearCurrentSpaceTabs() {
+  Browser* const browser = browser_view()->browser();
+  TabStripModel* const tabs = browser->tab_strip_model();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+
+  // Collect first, close after: closing shifts every index behind it.
+  std::vector<content::WebContents*> doomed;
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    if (tab->IsPinned()) {
+      continue;
+    }
+    if (model && !model->IsTabInActiveSpace(tab)) {
+      continue;
+    }
+    // Space-pinned tabs sit above the Clear line and survive it; that is what
+    // the second pin tier is for.
+    if (model && model->IsSpacePinned(tab)) {
+      continue;
+    }
+    doomed.push_back(tab->GetContents());
+  }
+  for (content::WebContents* contents : doomed) {
+    const int index = tabs->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      tabs->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  }
+}
