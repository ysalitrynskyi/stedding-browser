+// import I39: what an incoming row is, against the profile's saved logins.
+enum class IncomingLogin { kRefused, kAdded, kAlreadySaved, kKept };
+
+// The saved logins of the profile's own store, by username.
+using SavedByUsername =
+    std::multimap<std::u16string,
+                  const password_manager::CredentialUIEntry*>;
+
+SavedByUsername SavedLoginsByUsername(
+    const std::vector<password_manager::CredentialUIEntry>& saved) {
+  SavedByUsername by_username;
+  for (const password_manager::CredentialUIEntry& entry : saved) {
+    if (entry.stored_in.contains(
+            password_manager::PasswordForm::Store::kProfileStore)) {
+      by_username.emplace(entry.username, &entry);
+    }
+  }
+  return by_username;
+}
+
+IncomingLogin SortIncomingLogin(const SavedByUsername& by_username,
+                                const password_manager::CSVPassword& row) {
+  using password_manager::CredentialUIEntry;
+  using password_manager::CSVPassword;
+  using password_manager::PasswordForm;
+  if (row.GetParseStatus() != CSVPassword::Status::kOK ||
+      !row.GetURL().has_value() || !row.GetURL().value().is_valid() ||
+      row.GetPassword().empty()) {
+    return IncomingLogin::kRefused;
+  }
+  const CredentialUIEntry in(row, PasswordForm::Store::kProfileStore);
+  const std::string realm = in.GetFirstSignonRealm();
+  bool same = false;
+  bool other = false;
+  const auto [first, last] = by_username.equal_range(in.username);
+  for (auto it = first; it != last; ++it) {
+    const CredentialUIEntry& entry = *it->second;
+    const bool same_site = std::ranges::any_of(
+        entry.facets, [&realm](const password_manager::CredentialFacet& f) {
+          return f.signon_realm == realm;
+        });
+    if (!same_site) {
+      continue;
+    }
+    if (entry.password == in.password) {
+      same = true;
+    } else {
+      other = true;
+    }
+  }
+  if (same) {
+    return IncomingLogin::kAlreadySaved;
+  }
+  return other ? IncomingLogin::kKept : IncomingLogin::kAdded;
+}
+
+}  // namespace
+
+PasswordWriteResult ClassifyIncomingPasswords(
+    const std::vector<password_manager::CredentialUIEntry>& saved,
+    const std::vector<password_manager::CSVPassword>& incoming) {
+  const SavedByUsername by_username = SavedLoginsByUsername(saved);
+  PasswordWriteResult result;
+  for (const password_manager::CSVPassword& row : incoming) {
+    switch (SortIncomingLogin(by_username, row)) {
+      case IncomingLogin::kRefused:
+        ++result.refused;
+        break;
+      case IncomingLogin::kAdded:
+        ++result.added;
+        break;
+      case IncomingLogin::kAlreadySaved:
+        ++result.already_saved;
+        break;
+      case IncomingLogin::kKept:
+        ++result.kept;
+        break;
+    }
+  }
+  return result;
+}
+
+void DropNotesOfSavedLogins(
+    const std::vector<password_manager::CredentialUIEntry>& saved,
+    std::vector<password_manager::CSVPassword>& incoming) {
+  const SavedByUsername by_username = SavedLoginsByUsername(saved);
+  for (password_manager::CSVPassword& row : incoming) {
+    if (row.GetNote().empty() ||
+        SortIncomingLogin(by_username, row) != IncomingLogin::kAlreadySaved) {
+      continue;
+    }
+    row = password_manager::CSVPassword(
+        row.GetURL().value(), row.GetUsername(), row.GetPassword(),
+        /*note=*/std::string(), row.GetParseStatus());
+  }
+}
+
+ImportedPasswordsWriter::ImportedPasswordsWriter(Profile& profile) {
+  scoped_refptr<password_manager::PasswordStoreInterface> profile_store =
+      ProfilePasswordStoreFactory::GetForProfile(
+          &profile, ServiceAccessType::EXPLICIT_ACCESS);
+  affiliations::AffiliationService* const affiliations =
+      AffiliationServiceFactory::GetForProfile(&profile);
+  if (!profile_store || !affiliations) {
+    return;
+  }
+  // The presenter Chromium's own password page and importer use: it reads
+  // the logins the profile has already, for the importer to check against.
+  presenter_ = std::make_unique<password_manager::SavedPasswordsPresenter>(
+      affiliations, std::move(profile_store),
+      AccountPasswordStoreFactory::GetForProfile(
+          &profile, ServiceAccessType::EXPLICIT_ACCESS));
+}
+
+ImportedPasswordsWriter::~ImportedPasswordsWriter() = default;
+
+void ImportedPasswordsWriter::Write(
+    std::vector<password_manager::CSVPassword> passwords,
+    DoneCallback done) {
+  done_ = std::move(done);
+  passwords_ = std::move(passwords);
+  if (!presenter_) {
+    result_.unavailable = true;
+    Finish();
+    return;
+  }
+  if (passwords_.empty()) {
+    Finish();
+    return;
+  }
+  // The importer checks each row against what the presenter has read, so
+  // the saved logins are read in full before it sees a row: before that,
+  // every row would look new.
+  presenter_->Init(base::BindOnce(&ImportedPasswordsWriter::OnSavedPasswordsRead,
+                                  weak_factory_.GetWeakPtr()));
+}
+
+void ImportedPasswordsWriter::OnSavedPasswordsRead() {
+  const std::vector<password_manager::CredentialUIEntry> saved =
+      presenter_->GetSavedPasswords();
+  result_ = ClassifyIncomingPasswords(saved, passwords_);
+  DropNotesOfSavedLogins(saved, passwords_);
+  importer_ = std::make_unique<password_manager::PasswordImporter>(
+      *presenter_, /*user_confirmation_required=*/true);
+  importer_->Import(passwords_, password_manager::PasswordForm::Store::kProfileStore,
+                    base::BindOnce(&ImportedPasswordsWriter::OnChecked,
+                                   weak_factory_.GetWeakPtr()));
+}
+
+void ImportedPasswordsWriter::OnChecked(
+    const password_manager::ImportResults& results) {
+  if (results.status != password_manager::ImportResults::CONFLICTS) {
+    // The importer stopped before writing anything.
+    result_.refused += result_.added;
+    result_.added = 0;
+    Finish();
+    return;
+  }
+  // Out of the importer's own call: it is still finishing the first pass.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<ImportedPasswordsWriter> self) {
+            if (!self) {
+              return;
+            }
+            // No conflict is chosen: every saved login stays as it is.
+            self->importer_->ContinueImport(
+                {}, base::BindOnce(&ImportedPasswordsWriter::OnWritten,
+                                   self->weak_factory_.GetWeakPtr()));
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void ImportedPasswordsWriter::OnWritten(
+    const password_manager::ImportResults& results) {
+  // The importer counts a login it found already saved as imported; those
+  // are counted apart.
+  result_.added = results.number_imported > result_.already_saved
+                      ? results.number_imported - result_.already_saved
+                      : 0;
+  result_.refused = results.displayed_entries.size();
+  Finish();
+}
+
+void ImportedPasswordsWriter::Finish() {
+  if (done_) {
+    std::move(done_).Run(result_);
+  }
+}
