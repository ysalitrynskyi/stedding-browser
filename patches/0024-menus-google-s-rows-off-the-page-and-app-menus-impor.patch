+  const bool all_asleep =
+      !tabs.empty() &&
+      std::ranges::all_of(tabs, [](const tabs::TabInterface* tab) {
+        return tab->GetContents() && tab->GetContents()->WasDiscarded();
+      });
+  chevron_->SetEnabledColor(all_asleep ? stedding::SleptTitleColor(kChevronText)
+                                       : kChevronText);
+  name_->SetEnabledColor(all_asleep ? stedding::SleptTitleColor(kHeaderText)
+                                    : kHeaderText);
