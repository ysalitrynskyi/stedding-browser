index 0000000000000..cab4fe96d6888
--- /dev/null
+++ b/chrome/browser/ui/stedding/file_trash_mac.mm
@@ -0,0 +1,44 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/file_trash.h"
+
+#import <Foundation/Foundation.h>
+
+#include "base/apple/foundation_util.h"
+#include "base/task/thread_pool.h"
+#include "base/threading/scoped_blocking_call.h"
+
+namespace stedding {
+
+bool MoveToTrash(const base::FilePath& path, base::FilePath* trashed_path) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+  NSURL* const url = base::apple::FilePathToNSURL(path);
+  if (!url) {
+    return false;
+  }
+  // The Finder's own move: the file keeps its name and can be put back. On
+  // a volume with no Trash the call fails and leaves the file where it is;
+  // it never deletes in place of moving.
+  NSURL* resulting_url = nil;
+  NSError* error = nil;
+  if (![NSFileManager.defaultManager trashItemAtURL:url
+                                   resultingItemURL:&resulting_url
+                                              error:&error]) {
+    return false;
+  }
+  if (trashed_path && resulting_url) {
+    *trashed_path = base::apple::NSURLToFilePath(resulting_url);
+  }
+  return true;
+}
+
+scoped_refptr<base::SequencedTaskRunner> CreateFileTrashTaskRunner() {
+  return base::ThreadPool::CreateSequencedTaskRunner(
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+}
+
+}  // namespace stedding
