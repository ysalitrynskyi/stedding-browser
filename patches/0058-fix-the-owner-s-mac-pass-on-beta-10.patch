+float SpaceSwipeShift(float offset, float width, bool has_neighbour) {
+  if (has_neighbour) {
+    return std::clamp(offset, -std::max(width, 0.0f), std::max(width, 0.0f));
+  }
+  const float give = kSpaceSwipeEndGive *
+                     (1.0f - std::exp(-std::abs(offset) / kSpaceSwipeEndGive));
+  return std::copysign(give, offset);
+}
+
+float SpaceSwipeOpacity(float offset, float width, bool has_neighbour) {
+  if (!has_neighbour || width <= 0.0f) {
+    return 1.0f;
+  }
+  return 1.0f - 0.6f * std::min(1.0f, std::abs(offset) / (width * 0.5f));
+}
+
+bool SpaceSwipeCommits(float offset, float width, bool flick) {
+  const float distance = std::abs(offset);
+  const float needed = width > 0.0f
+                           ? std::min(kSpaceSwipeCommitDip, width * 0.3f)
+                           : kSpaceSwipeCommitDip;
+  return distance >= needed || (flick && distance >= kSpaceSwipeFlickDip);
+}
