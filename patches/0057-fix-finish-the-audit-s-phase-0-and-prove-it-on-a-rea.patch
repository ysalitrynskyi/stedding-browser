-#else
-  base::PathService::Get(base::DIR_HOME, &support);
-  support = support.AppendASCII(".config");
-  const struct {
-    const char* dir;
-    const char* name;
-    const char* service;
-    const char* account;
-  } kBrowsers[] = {
