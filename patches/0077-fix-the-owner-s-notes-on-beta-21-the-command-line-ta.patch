+// found in the LICENSE file.
+
+// spaces B39 (the owner, 2026-10-21, Arc's way; GitHub issue 10): over the
+// sidebar or the rail, scrolling sideways steps to the next Space or the one
+// before, with the slide the keys take. On the Mac a mouse's tilt wheel and
+// Shift with the wheel do it, the trackpad keeping its own swipe (B35); on
+// Windows a precision touchpad's two-finger scroll, a tilt wheel, Shift with
+// the wheel and Ctrl with the wheel. A vertical scroll still scrolls the
+// list, and nothing steps over the page.
+//
+// The events are the platform's own: on the Mac the ui::ScrollEvent the
+// window makes from an NSEvent the system could have sent, on Windows the
+// ui::MouseWheelEvent made from a WM_MOUSEWHEEL or WM_MOUSEHWHEEL message,
+// handed to the window's event sink as its message handler does.
+
+#include <memory>
+#include <tuple>
+#include <vector>
+
+#include "base/test/run_until.h"
+#include "base/time/time.h"
+#include "build/build_config.h"
