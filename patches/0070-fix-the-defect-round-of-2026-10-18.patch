+// spaces B32: the layer the Space being left slides out in, over `view` (the
+// list, or the title row after a swipe): one no view owns, the size of
+// `view`'s own and stacked above it in the same parent. Null while no Space
+// is sliding out.
+ui::Layer* OutgoingLayerOver(const views::View* view) {
+  const ui::Layer* const own = view->layer();
+  if (!own || !own->parent()) {
+    return nullptr;
+  }
+  bool above = false;
+  for (const auto& layer : own->parent()->children()) {
+    if (layer.get() == own) {
+      above = true;
+    } else if (above && !layer->owner() && layer->bounds() == own->bounds()) {
+      return layer.get();
+    }
+  }
+  return nullptr;
+}
