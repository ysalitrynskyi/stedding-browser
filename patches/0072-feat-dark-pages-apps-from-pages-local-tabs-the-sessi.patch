+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_DARK_PAGES_BUTTON_H_
+#define CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_DARK_PAGES_BUTTON_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_button.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "ui/base/interaction/element_identifier.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/button/button.h"
+
+class BrowserWindowInterface;
+
+namespace stedding {
+
+class DarkPagesWatcher;
+
+// docs/features/dark-pages.md Dk16, Dk17: the moon at the address row's right
+// end, before the app menu, in every normal and private window. A click
+// turns dark pages on or off for the profile, as Option-Shift-Cmd-D does
+// (Dk18). Off, an outline moon; on, a filled moon with the toolbar's active
+// highlight. Its icon takes the row's contrast colour like every toolbar
+// button (toolbar T17). To assistive technology it is a toggle button named
+// "Dark pages", checked while on. "Show the dark pages button" in Settings
+// hides it in every window at once.
+class DarkPagesButton : public ToolbarButton {
+  METADATA_HEADER(DarkPagesButton, ToolbarButton)
+
+ public:
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kElementId);
+
+  explicit DarkPagesButton(BrowserWindowInterface* browser);
+  DarkPagesButton(const DarkPagesButton&) = delete;
+  DarkPagesButton& operator=(const DarkPagesButton&) = delete;
+  ~DarkPagesButton() override;
+
+  // Whether the button shows dark pages as on.
+  bool is_on() const { return on_; }
+
+  // views::View:
+  // Dk16: the action and its chord, and, while dark pages is on and the
+  // active tab's site is kept light, that site. Read at hover, so it names
+  // the tab shown then.
+  std::u16string GetRenderedTooltipText(const gfx::Point& p) const override;
+  void AddedToWidget() override;
+
+ private:
+  void OnPressed();
+  // The highlight is an ink drop state, which needs the widget.
+  void UpdateHighlight();
+  // The switch, the mode or a list changed (Dk16: every window's button
+  // follows a change made anywhere), or the button's own setting (Dk17).
+  void Update();
+  // "Turn dark pages on (⌥⇧⌘D)" and the like: the action a click takes.
+  std::u16string ActionText() const;
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<DarkPagesWatcher> watcher_;
+  PrefChangeRegistrar registrar_;
+  std::optional<views::Button::ScopedAnchorHighlight> highlight_;
+  bool on_ = false;
+  base::WeakPtrFactory<DarkPagesButton> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TOOLBAR_STEDDING_DARK_PAGES_BUTTON_H_
