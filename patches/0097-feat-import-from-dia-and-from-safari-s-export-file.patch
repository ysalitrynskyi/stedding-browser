+ArcSeal SealOfThisPlatform() {
+#if BUILDFLAG(IS_WIN)
+  return ArcSeal::kWindowsLocalState;
+#else
+  return ArcSeal::kMacKeychain;
+#endif
+}
+
+base::Time FromChromiumMicroseconds(std::string_view text) {
+  int64_t value = 0;
+  if (!base::StringToInt64(text, &value) || value <= 0) {
+    return base::Time();
+  }
+  return base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(value));
+}
+
+// Walks one level of a Bookmarks file's tree.
+void WalkBookmarks(const base::ListValue& children,
+                   std::vector<std::u16string>& path,
+                   bool toolbar,
+                   size_t depth,
+                   size_t cap,
+                   size_t max_depth,
+                   size_t& nodes,
+                   ChromiumBookmarks& out) {
+  for (const base::Value& child : children) {
+    const base::DictValue* const node = child.GetIfDict();
+    if (!node) {
+      continue;
+    }
+    if (nodes >= cap) {
+      ++out.left_out;
+      continue;
+    }
+    ++nodes;
+    const std::string* const type = node->FindString("type");
+    const std::string* const name = node->FindString("name");
+    const std::u16string title =
+        name ? base::UTF8ToUTF16(*name) : std::u16string();
+    const std::string* const added = node->FindString("date_added");
+    const base::Time created =
+        added ? FromChromiumMicroseconds(*added) : base::Time();
+    if (type && *type == "folder") {
+      if (depth + 1 > max_depth) {
+        ++out.left_out;
+        continue;
+      }
+      const base::ListValue* const kids = node->FindList("children");
+      if (!kids || kids->empty()) {
+        ImportedBookmarkEntry entry;
+        entry.is_folder = true;
+        entry.in_toolbar = toolbar;
+        entry.path = path;
+        entry.title = title;
+        entry.creation_time = created;
+        out.entries.push_back(std::move(entry));
+        continue;
+      }
+      path.push_back(title);
+      WalkBookmarks(*kids, path, toolbar, depth + 1, cap, max_depth, nodes,
+                    out);
+      path.pop_back();
+      continue;
+    }
+    const std::string* const spec = node->FindString("url");
+    const GURL url(spec ? *spec : std::string());
+    if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+      ++out.left_out;
+      continue;
+    }
+    ImportedBookmarkEntry entry;
+    entry.in_toolbar = toolbar;
+    entry.path = path;
+    entry.url = url;
+    entry.title = title;
+    entry.creation_time = created;
+    out.entries.push_back(std::move(entry));
+  }
+}
+
+// Logins that are not blocked sites, in copies of the logins files. Each
+// copy goes into a folder of its own, so no journal or log of another file
+// lies beside it.
+size_t CountLogins(const base::FilePath& profile_dir) {
+  size_t count = 0;
+  for (const base::FilePath::CharType* const name : kLoginFiles) {
+    base::ScopedTempDir temp;
+    if (!temp.CreateUniqueTempDir()) {
+      continue;
+    }
+    const base::FilePath copy =
+        CopyChromiumFileForReading(profile_dir.Append(name), temp.GetPath());
+    if (copy.empty()) {
+      continue;
+    }
+    sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                     sql::Database::Tag("Passwords"));
+    if (!db.Open(copy)) {
+      continue;
+    }
+    sql::Statement statement(db.GetUniqueStatement(
+        "SELECT COUNT(*) FROM logins WHERE blacklisted_by_user = 0"));
+    if (statement.Step()) {
+      count += static_cast<size_t>(
+          std::max<int64_t>(0, statement.ColumnInt64(0)));
+    }
+  }
+  return count;
+}
+
+bool IsRunning(const ChromiumFamilySource& source) {
+  if (source.process_name.empty()) {
+    return false;
+  }
+  base::FilePath process = base::FilePath::FromASCII(source.process_name);
+#if BUILDFLAG(IS_WIN)
+  process = process.AddExtensionASCII("exe");
+#endif
+  return base::GetProcessCount(process.value(), nullptr) > 0;
+}
+
+ChromiumFamilyInfo LoadInfoOnPool(const ChromiumFamilySource& source) {
+  ChromiumFamilyInfo info;
+  const base::FilePath user_data = FindUserDataDir(source);
+  if (user_data.empty()) {
+    return info;
+  }
+  info.found = true;
+  info.running = IsRunning(source);
+  for (ChromiumProfile& profile : ListChromiumProfiles(user_data)) {
+    ChromiumProfileSummary summary;
+    const base::FilePath dir = user_data.Append(profile.dir);
+    const ChromiumBookmarks bookmarks =
+        ReadChromiumBookmarks(dir.Append(FILE_PATH_LITERAL("Bookmarks")));
+    summary.bookmarks = static_cast<size_t>(std::ranges::count_if(
+        bookmarks.entries,
+        [](const ImportedBookmarkEntry& entry) { return !entry.is_folder; }));
+    summary.history =
+        base::PathExists(dir.Append(FILE_PATH_LITERAL("History")));
+    summary.passwords = CountLogins(dir);
+    summary.profile = std::move(profile);
+    info.profiles.push_back(std::move(summary));
+  }
+  return info;
+}
+
+// What the pool read for an import.
+struct FamilyRead {
+  FamilyRead() = default;
+  FamilyRead(FamilyRead&&) = default;
+  FamilyRead& operator=(FamilyRead&&) = default;
+  ~FamilyRead() = default;
+
+  bool not_found = false;
+  ChromiumBookmarks bookmarks;
+  history::URLRows history;
+  std::vector<password_manager::CSVPassword> passwords;
+  bool key_denied = false;
+  LoginsLeftOut left_out;
+};
+
+FamilyRead ReadOnPool(const ChromiumFamilySource& source,
+                      base::FilePath profile_dir,
+                      ChromiumFamilyParts parts,
+                      base::Time now) {
+  FamilyRead read;
+  // Found here, on the pool: on Windows that lists the Store's packages.
+  const base::FilePath user_data = FindUserDataDir(source);
+  const base::FilePath dir = user_data.Append(profile_dir);
+  if (user_data.empty() || !base::DirectoryExists(dir)) {
+    read.not_found = true;
+    return read;
+  }
+  base::ScopedTempDir temp;
+  if (!temp.CreateUniqueTempDir()) {
+    read.not_found = true;
+    return read;
+  }
+  if (parts.bookmarks) {
+    read.bookmarks =
+        ReadChromiumBookmarks(dir.Append(FILE_PATH_LITERAL("Bookmarks")));
+  }
+  if (parts.history) {
+    // I30: as I22 reads Arc's, from a copy; older visits than the history
+    // keeps are not read at all.
+    read.history = ReadArcHistory(
+        CopyChromiumFileForReading(dir.Append(FILE_PATH_LITERAL("History")),
+                                   temp.GetPath()),
+        kMaxArcHistoryRows, stedding::OldestKeptVisit(now));
+  }
+  if (parts.passwords) {
+    std::vector<base::FilePath> copies;
+    int folder = 0;
+    for (const base::FilePath::CharType* const name : kLoginFiles) {
+      // Each into a folder of its own, away from the History copy and its
+      // journal or log.
+      const base::FilePath into =
+          temp.GetPath().AppendASCII(base::NumberToString(++folder));
+      if (!base::CreateDirectory(into)) {
+        continue;
+      }
+      const base::FilePath copy =
+          CopyChromiumFileForReading(dir.Append(name), into);
+      if (!copy.empty()) {
+        copies.push_back(copy);
+      }
+    }
+    if (!copies.empty()) {
+      // I31: the key is asked for here, on the pool, and only now: macOS's
+      // prompt comes after the button, never before.
+      const std::optional<std::vector<uint8_t>> key = ReadChromiumFamilyKey(
+          source, user_data.Append(FILE_PATH_LITERAL("Local State")));
+      if (!key) {
+        read.key_denied = true;
+      } else {
+        std::set<std::tuple<std::string, std::string, std::string>> seen;
+        for (const base::FilePath& copy : copies) {
+          for (password_manager::PasswordForm& form :
+               ReadArcLogins(copy, *key, kMaxChromiumLogins,
+                             SealOfThisPlatform(), &read.left_out)) {
+            // A site the user told the browser never to save for holds no
+            // login to bring over.
+            if (form.blocked_by_user || !form.url.is_valid()) {
+              continue;
+            }
+            std::string username = base::UTF16ToUTF8(form.username_value);
+            std::string password =
+                base::UTF16ToUTF8(form.password_value.value());
+            if (!seen.emplace(form.url.spec(), username, password).second) {
+              continue;
+            }
+            read.passwords.emplace_back(
+                form.url, std::move(username), std::move(password),
+                std::string(), password_manager::CSVPassword::Status::kOK);
+          }
+        }
+      }
+    }
+  }
+  return read;
+}
+
+// The folder name a profile's bookmarks go into.
+std::u16string FolderTitle(const ChromiumFamilySource& source,
+                           const ChromiumProfile& profile) {
+  std::u16string title = u"Imported from ";
+  title.append(source.name);
+  if (profile.dir.BaseName().value() != FILE_PATH_LITERAL("Default") &&
+      !profile.name.empty()) {
+    title.append(u" (");
+    title.append(profile.name);
+    title.append(u")");
+  }
+  return title;
+}
