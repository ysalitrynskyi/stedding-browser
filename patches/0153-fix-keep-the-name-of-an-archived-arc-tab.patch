From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Thu, 5 Nov 2026 20:49:05 -0500
Subject: fix: keep the name of an archived Arc tab

An archived item holds a copy of its sidebar item, so a name the person gave the
tab is in its title, as it is in the sidebar. The archive took savedTitle alone, so
a renamed tab came back under its page's title. An archived row now shows the name,
and the page's title when there is none.

Why: import I7 (BACKLOG S-431). Public readers of real files agree that title is
the rename and savedTitle the page's, so no name is kept only in savedTitle.
Removable when: the Arc importer leaves the series.
---
 .../browser/ui/spaces/arc_sidebar_importer.cc |  8 ++++++-
 .../spaces/arc_sidebar_importer_unittest.cc   | 21 +++++++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/ui/spaces/arc_sidebar_importer.cc b/chrome/browser/ui/spaces/arc_sidebar_importer.cc
index 46bbf0a0bc8c8..222995edf69f1 100644
--- a/chrome/browser/ui/spaces/arc_sidebar_importer.cc
+++ b/chrome/browser/ui/spaces/arc_sidebar_importer.cc
@@ -1451,7 +1451,13 @@ void ParseArcArchive(std::string_view json, ArcImportPlan& plan) {
     ArcImportPlan::ArchivedItem archived;
     archived.arc_id = id;
     archived.url = url;
-    archived.title = base::UTF8ToUTF16(StringAt(*tab, "savedTitle"));
+    // S-431: as in the sidebar, `title` is the name the person gave the tab,
+    // and `savedTitle` the page's.
+    archived.title = base::UTF8ToUTF16(StringAt(
+        *item->FindDict("sidebarItem"), "title"));
+    if (archived.title.empty()) {
+      archived.title = base::UTF8ToUTF16(StringAt(*tab, "savedTitle"));
+    }
     if (const std::string* const space =
             item->FindStringByDottedPath("source.space._0")) {
       archived.arc_space = *space;
diff --git a/chrome/browser/ui/spaces/arc_sidebar_importer_unittest.cc b/chrome/browser/ui/spaces/arc_sidebar_importer_unittest.cc
index 92dd7928c9d32..cdf4592fe0c9c 100644
--- a/chrome/browser/ui/spaces/arc_sidebar_importer_unittest.cc
+++ b/chrome/browser/ui/spaces/arc_sidebar_importer_unittest.cc
@@ -652,6 +652,27 @@ TEST(ArcSidebarImporterTest, ReadsArcsSplits) {
   EXPECT_NE(std::u16string::npos, SummariseArcImport(*plan).find(u"4 splits"));
 }
 
+// import I7 (BACKLOG S-431): an archived row shows the name the person gave
+// the tab, which an archived item keeps as a sidebar item does, in `title`,
+// and the page's title when there is none. Every reason Arc gives comes in.
+TEST(ArcSidebarImporterTest, AnArchivedTabKeepsItsName) {
+  ArcImportPlan plan;
+  ParseArcArchive(R"json({"version": 1, "items": [
+    "named", {"reason": "clearTabGroup", "archivedAt": 800000000,
+      "sidebarItem": {"title": "My name",
+        "data": {"tab": {"savedURL": "https://named.example/",
+                         "savedTitle": "The page"}}}},
+    "plain", {"reason": "manual", "archivedAt": 700000000,
+      "sidebarItem": {"title": null,
+        "data": {"tab": {"savedURL": "https://plain.example/",
+                         "savedTitle": "A page"}}}}
+  ]})json",
+                  plan);
+  ASSERT_EQ(2u, plan.archived.size());
+  EXPECT_EQ(u"My name", plan.archived[0].title);
+  EXPECT_EQ(u"A page", plan.archived[1].title);
+}
+
 // import I7: Arc's archive, the newest first. A page Arc archived again and
 // again comes once a Space, as its newest. What no row can hold is counted.
 TEST(ArcSidebarImporterTest, ReadsArcsArchive) {
