+#include "ui/events/test/cocoa_test_event_utils.h"
+
+namespace stedding::shortcuts::test {
+
+namespace {
+
+NSUInteger ModifierFlags(const ui::Accelerator& chord) {
+  NSUInteger flags = 0;
+  if (chord.modifiers() & ui::EF_COMMAND_DOWN) {
+    flags |= NSEventModifierFlagCommand;
+  }
+  if (chord.modifiers() & ui::EF_CONTROL_DOWN) {
+    flags |= NSEventModifierFlagControl;
+  }
+  if (chord.modifiers() & ui::EF_ALT_DOWN) {
+    flags |= NSEventModifierFlagOption;
+  }
+  if (chord.modifiers() & ui::EF_SHIFT_DOWN) {
+    flags |= NSEventModifierFlagShift;
+  }
+  return flags;
+}
+
+NSEvent* KeyDown(NSWindow* window, const ui::Accelerator& chord) {
+  return cocoa_test_event_utils::SynthesizeKeyEvent(
+      window, /*keyDown=*/true, chord.key_code(), ModifierFlags(chord));
+}
+
+NSMenuItem* RowInMenu(NSMenu* menu, int command) {
+  for (NSMenuItem* item in menu.itemArray) {
+    if (item.hasSubmenu) {
+      if (NSMenuItem* const found = RowInMenu(item.submenu, command)) {
+        return found;
+      }
+      continue;
+    }
+    if (item.tag == command) {
+      return item;
+    }
+  }
+  return nil;
+}
+
+}  // namespace
+
+int CommandForChord(const ui::Accelerator& chord) {
+  const CommandForKeyEventResult result =
+      CommandForKeyEvent(KeyDown(nil, chord));
+  return result.chrome_command == NO_COMMAND ? 0 : result.chrome_command;
+}
+
+bool MainMenuShowsChord(int command, const ui::Accelerator& chord) {
+  NSMenuItem* const row = RowInMenu(NSApp.mainMenu, command);
+  if (!row) {
+    return false;
+  }
+  KeyEquivalentAndModifierMask* const expected =
+      ui::GetKeyEquivalentAndModifierMaskFromAccelerator(chord);
+  return [row.keyEquivalent isEqualToString:expected.keyEquivalent] &&
+         row.keyEquivalentModifierMask == expected.modifierMask;
+}
+
+bool MainMenuShowsNoChord(int command) {
+  NSMenuItem* const row = RowInMenu(NSApp.mainMenu, command);
+  return row && row.keyEquivalent.length == 0;
+}
+
+bool DispatcherLeavesChordToThePage(gfx::NativeWindow window,
+                                    const ui::Accelerator& chord) {
+  NSWindow* const ns_window = window.GetNativeNSWindow();
+  ChromeCommandDispatcherDelegate* const delegate =
+      [[ChromeCommandDispatcherDelegate alloc] init];
+  NSEvent* const event = KeyDown(ns_window, chord);
+  const ui::PerformKeyEquivalentResult before =
+      [delegate prePerformKeyEquivalent:event window:ns_window];
+  const ui::PerformKeyEquivalentResult after =
+      [delegate postPerformKeyEquivalent:event
+                                  window:ns_window
+                            isRedispatch:YES];
+  return before == ui::PerformKeyEquivalentResult::kUnhandled &&
+         after == ui::PerformKeyEquivalentResult::kHandled;
+}
+
+}  // namespace stedding::shortcuts::test
