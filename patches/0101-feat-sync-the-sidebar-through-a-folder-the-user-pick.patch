+LocalItem::LocalItem() = default;
+LocalItem::LocalItem(const LocalItem& other) = default;
+LocalItem& LocalItem::operator=(const LocalItem& other) = default;
+LocalItem::~LocalItem() = default;
+
+LocalView::LocalView() = default;
+LocalView::LocalView(const LocalView& other) = default;
+LocalView::LocalView(LocalView&& other) = default;
+LocalView& LocalView::operator=(const LocalView& other) = default;
+LocalView& LocalView::operator=(LocalView&& other) = default;
+LocalView::~LocalView() = default;
