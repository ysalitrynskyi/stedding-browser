+// The rows' delegate for a page in a tab.
+class PageRowsDelegate : public SiteControlsRowsView::Delegate,
+                         public content::WebContentsObserver,
+                         public spaces::SpaceRegistry::Observer {
+ public:
+  PageRowsDelegate(content::WebContents* contents,
+                   PageInfoNavigationHandler* navigation_handler)
+      : content::WebContentsObserver(contents),
+        navigation_handler_(navigation_handler),
+        // Si9: the switch and the site's choice, changed elsewhere -- the
+        // moon, the chord, Settings -- while the panel is open.
+        dark_pages_watcher_(ProfileFor(contents),
+                            base::BindRepeating(&PageRowsDelegate::Refresh,
+                                                base::Unretained(this))) {
+    Profile* const profile = ProfileFor(contents);
+    if (spaces::SpaceRegistry* const registry =
+            profile && !profile->IsOffTheRecord()
+                ? spaces::SpaceRegistryFactory::GetForProfile(profile)
+                : nullptr) {
+      // Si7: a Space renamed, or its session turned off, while it is open.
+      registry_observation_.Observe(registry);
+    }
+  }
+  PageRowsDelegate(const PageRowsDelegate&) = delete;
+  PageRowsDelegate& operator=(const PageRowsDelegate&) = delete;
+  ~PageRowsDelegate() override = default;
+
+  // SiteControlsRowsView::Delegate:
+  void SetRows(SiteControlsRowsView* rows) override { rows_ = rows; }
+
+  SiteControlsRowsView::State GetState() override {
+    SiteControlsRowsView::State state;
+    content::WebContents* const contents = web_contents();
+    if (!contents) {
+      return state;
+    }
+    const SiteControlsRows rows = RowsFor(ContextFor(contents));
+    if (rows.session) {
+      const content::StoragePartitionConfig jar =
+          spaces::StoragePartitionConfigForWebContents(contents);
+      state.session = SessionNameFor(spaces::IsSpaceStoragePartition(jar),
+                                     jar.partition_name(),
+                                     SpaceJarEntriesFor(ProfileFor(contents)));
+    }
+    state.clear_data = rows.clear_data && CanClearSiteCookies(contents);
+    state.dark_switch = rows.dark_switch;
+    state.dark_pages_on = DarkPagesOn(ProfileFor(contents));
+    if (rows.dark_site && CanChooseDarkPagesForSite(contents)) {
+      if (const std::optional<ContentSettingsPattern> pattern =
+              DarkPagesSitePatternFor(DarkPagesUrlFor(contents))) {
+        state.dark_site =
+            url_formatter::IDNToUnicode(DarkPagesSiteName(*pattern));
+        state.site_darkened = IsSiteDarkened(contents);
+      }
+    }
+    return state;
+  }
+
+  void ClearSiteData() override {
+    content::WebContents* const contents = web_contents();
+    BrowserWindowInterface* const browser = BrowserFor(contents);
+    if (!browser) {
+      return;
+    }
+    const std::string domain =
+        SiteCookieDomain(contents->GetLastCommittedURL());
+    if (domain.empty()) {
+      return;
+    }
+    // The site and the jar are taken now, as the question names them; the
+    // removal checks they are still the page's when the user says yes.
+    content::StoragePartitionConfig config =
+        spaces::StoragePartitionConfigForWebContents(contents);
+    ClearSiteDataQuestion question = ClearSiteDataQuestionFor(
+        url_formatter::IDNToUnicode(domain),
+        contents->GetBrowserContext()->IsOffTheRecord(),
+        spaces::IsSpaceStoragePartition(config), config.partition_name(),
+        SpaceJarEntriesFor(ProfileFor(contents)));
+    // Page info closes before the window-modal question opens over the
+    // window; a turn later, so this view is not under the question.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&AskToClearSiteData, browser->GetWeakPtr(),
+                                  contents->GetWeakPtr(), domain,
+                                  std::move(config), std::move(question)));
+    if (navigation_handler_) {
+      navigation_handler_->CloseBubble();
+    }
+  }
+
+  void SetDarkPagesOn(bool on) override {
+    stedding::SetDarkPagesOn(ProfileFor(web_contents()), on);
+    Refresh();
+  }
+
+  void SetSiteDarkened(bool darkened) override {
+    if (web_contents()) {
+      stedding::SetSiteDarkened(web_contents(), darkened);
+    }
+    Refresh();
+  }
+
+  // spaces::SpaceRegistry::Observer:
+  void OnRegistryChanged() override { Refresh(); }
+
+ private:
+  void Refresh() {
+    if (rows_) {
+      rows_->Update();
+    }
+  }
+
+  raw_ptr<SiteControlsRowsView> rows_ = nullptr;
+  const raw_ptr<PageInfoNavigationHandler> navigation_handler_;
+  DarkPagesWatcher dark_pages_watcher_;
+  base::ScopedObservation<spaces::SpaceRegistry,
+                          spaces::SpaceRegistry::Observer>
+      registry_observation_{this};
+};
