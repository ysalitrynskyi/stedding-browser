+// little E1, E6: a link another app hands over opens in a little window of
+// the profile its tab would have used. That holds when a private window was
+// the last in front (its links open in the original profile) and when no
+// profile is loaded because every window was closed while the browser ran on,
+// as the Mac's does (the profile then loads first).
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_MAC)
+
+#import <Cocoa/Cocoa.h>
+
+#include <tuple>
+
+#include "base/files/file_path.h"
+#include "base/test/run_until.h"
+#import "chrome/browser/app_controller_mac.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/stedding/little_window.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/profile_destruction_waiter.h"
+#include "components/keep_alive_registry/keep_alive_types.h"
+#include "components/keep_alive_registry/scoped_keep_alive.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "net/base/apple/url_conversions.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/base_window.h"
+#include "ui/gfx/native_ui_types.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The window with a tab showing `url`: a little window when `little`, any
+// other window otherwise. Null when there is none.
+BrowserWindowInterface* WindowShowingB01(const GURL& url, bool little) {
+  BrowserWindowInterface* found = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        TabStripModel* const tabs = window->GetTabStripModel();
+        if (!tabs || stedding::IsLittleWindow(window) != little) {
+          return true;
+        }
+        for (int i = 0; i < tabs->count(); ++i) {
+          content::WebContents* const contents = tabs->GetWebContentsAt(i);
+          if (contents && contents->GetVisibleURL() == url) {
+            found = window;
+            return false;
+          }
+        }
+        return true;
+      });
+  return found;
+}
+
+class LittleWindowProfileB01Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // The AppController is the application's delegate.
+    std::ignore = AppController.sharedController;
+  }
+
+  // `window` becomes the main window, as a click on it makes it.
+  static void MakeMain(BrowserWindowInterface* window) {
+    [NSNotificationCenter.defaultCenter
+        postNotificationName:NSWindowDidBecomeMainNotification
+                      object:window->GetWindow()
+                                 ->GetNativeWindow()
+                                 .GetNativeNSWindow()];
+  }
+
+  // Hands `url` over the way another app does, and returns once a window
+  // shows it, little or not.
+  static void HandOver(const GURL& url) {
+    [NSApp.delegate application:NSApp
+                       openURLs:@[ net::NSURLWithGURL(url) ]];
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return WindowShowingB01(url, /*little=*/true) != nullptr ||
+             WindowShowingB01(url, /*little=*/false) != nullptr;
+    })) << "the address never opened";
+  }
+};
+
+// P01-1a, little E1, E6: with a private window the last in front, a link
+// from another app opens in a little window of the original profile, the
+// profile its tab would have opened in. No window gains a tab.
+IN_PROC_BROWSER_TEST_F(LittleWindowProfileB01Test,
+                       ALinkWithAPrivateWindowInFrontOpensLittleInItsProfile) {
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_TRUE(profile->GetPrefs()->GetBoolean(stedding::prefs::kLittleEnabled))
+      << "little windows are on by default";
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser(profile);
+  ASSERT_TRUE(incognito);
+  ASSERT_TRUE(incognito->GetProfile()->IsIncognitoProfile());
+  MakeMain(incognito);
+  ASSERT_EQ(incognito->GetProfile(),
+            [AppController.sharedController lastProfileIfLoaded])
+      << "the private window is not the last in front";
+  const int normal_tabs = browser()->GetTabStripModel()->count();
+  const int private_tabs = incognito->GetTabStripModel()->count();
+
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_NO_FATAL_FAILURE(HandOver(url));
+  BrowserWindowInterface* const little = WindowShowingB01(url, true);
+  ASSERT_TRUE(little) << "the link became a tab, not a little window";
+  EXPECT_EQ(BrowserWindowInterface::Type::TYPE_POPUP, little->GetType());
+  EXPECT_EQ(profile, little->GetProfile())
+      << "the little window is not in the original profile";
+  EXPECT_EQ(normal_tabs, browser()->GetTabStripModel()->count());
+  EXPECT_EQ(private_tabs, incognito->GetTabStripModel()->count());
+}
+
+// P01-1a, little E1, E6: with every window closed while the browser runs on,
+// the profile unloads. A link from another app loads it again and opens in a
+// little window of it, not as a tab in a new ordinary window.
+IN_PROC_BROWSER_TEST_F(LittleWindowProfileB01Test,
+                       ALinkWithNoWindowOpenOpensLittleOnceItsProfileLoads) {
+  const base::FilePath path = browser()->GetProfile()->GetPath();
+  ASSERT_TRUE(browser()->GetProfile()->GetPrefs()->GetBoolean(
+      stedding::prefs::kLittleEnabled))
+      << "little windows are on by default";
+  // The browser runs on with no window, as the Mac's does. Nothing keeps the
+  // profile loaded, so it unloads when its last window closes.
+  const ScopedKeepAlive keep_alive(KeepAliveOrigin::SESSION_RESTORE,
+                                   KeepAliveRestartOption::DISABLED);
+  {
+    ProfileDestructionWaiter gone(browser()->GetProfile());
+    CloseBrowserSynchronously(browser());
+    SetBrowser(nullptr);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return gone.destroyed(); }))
+        << "the profile stayed loaded with no window open";
+  }
+  ASSERT_FALSE([AppController.sharedController lastProfileIfLoaded]);
+
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  ASSERT_NO_FATAL_FAILURE(HandOver(url));
+  BrowserWindowInterface* const little = WindowShowingB01(url, true);
+  BrowserWindowInterface* const ordinary = WindowShowingB01(url, false);
+  // The harness closes what opened.
+  SetBrowser(little ? little : ordinary);
+  ASSERT_TRUE(little)
+      << "the link opened as a tab in an ordinary window, not a little one";
+  EXPECT_FALSE(ordinary);
+  EXPECT_EQ(BrowserWindowInterface::Type::TYPE_POPUP, little->GetType());
+  EXPECT_EQ(path, little->GetProfile()->GetPath());
+  EXPECT_FALSE(little->GetProfile()->IsOffTheRecord());
+}
+
+}  // namespace
+
+#endif  // BUILDFLAG(IS_MAC)
diff --git a/chrome/test/stedding/audit_b02_browsertest.cc b/chrome/test/stedding/audit_b02_browsertest.cc
