#!/usr/bin/env bash
# Drive the built browser with synthetic input and capture the window after
# steps. The harness behind every live check in docs/features/*.md.
#
# Usage:
#   tooling/drive <profile-dir> <steps-file> [chromium args and URLs...]
#
# Checks every step first (tooling/drive-window.py --check): an unknown op or a
# bad argument stops the run before anything launches. Refuses to start while
# any other process with the app's bundle id runs -- your own Stedding, or one a
# crashed run left. Then launches Stedding.app with the profile (kept between
# runs, so restart checks work) in the background through LaunchServices, waits
# for first paint, runs the steps against that pid, and asks that pid to quit
# (Apple Event; docs/HANDOFF.md, trap 4). An exit, Ctrl-C or kill at any point
# quits that pid the same way, and kills it if it does not go.
#
# Steps, one per line, coordinates in window points (origin top-left of the
# window owned by the launched pid, so never raise it by hand):
#   activate                      make that pid frontmost; it starts in the background,
#                                 and clicks and keys go nowhere until this step
#   click X Y [cmd|shift|alt] | rclick X Y | dblclick X Y | hover X Y | drag X1 Y1 X2 Y2
#                                 modifiers join with +, e.g. click 40 60 cmd+shift
#   dragstart X Y | dragmove X Y | dragend      the same drag in steps; "shot" between them
#                                              captures the mid-drag state (drop highlights)
#   key <name>[+cmd][+shift][+ctrl][+alt]    e.g. key t+cmd, key enter, key esc
#   keydown cmd|shift|alt|ctrl | keyup ...   hold a modifier on its own (row numbers)
#   type <text>                   real key codes, modifiers explicitly cleared
#   wait <seconds> | shot <file.png>
#   # a comment, and blank lines, are skipped
#
# A drag must end (dragend) and a keydown must be released (keyup) in the same
# file. A mouse button or a modifier the run pressed is released on any exit.
#
# Traps this harness already paid for: a created key event inherits the last
# chord's modifiers, so "type" after "key t+cmd" used to send Cmd+e Cmd+x ...
# (Cmd+o opened a file dialog); a Cmd+Q keystroke does not quit (warn-before-quit
# wants it held), the AppleEvent does; the process must be frontmost for clicks.
# Never run this while someone is using the machine: it moves the pointer.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

drive_cleanup() {
  stop_launched_app 20
}

main() {
  [ $# -ge 2 ] || { sed -n '2,39p' "$0"; exit 2; }
  local profile="$1" steps="$2"
  shift 2
  [ -f "$steps" ] || die "no steps file at $steps"
  # Every step is read and checked before the browser starts, so a typo such as
  # `clik 40 60` ends the run here, not halfway through with a button held.
  python3 "$STEDDING_ROOT/tooling/drive-window.py" --check "$steps" ||
    die "$steps has errors (above); nothing was launched"
  require_pyobjc

  local app
  app="$(find_app_bundle "$CHROMIUM_SRC/out/release" || true)"
  [ -n "$app" ] && [ -d "$app" ] || die "no app bundle in out/release — tooling/dev build"
  require_no_other_instance "$app"

  mkdir -p "$profile"
  # LaunchServices starts the app in /, so its paths must be absolute.
  profile="$(cd "$profile" && pwd -P)"
  local log
  log="$(absolute_path "${DRIVE_LOG:-$profile/drive.log}")"

  # From here on, any exit quits the launched pid, then kills it.
  trap drive_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  launch_in_background "$app" "$log" \
    --user-data-dir="$profile" --use-mock-keychain --no-first-run --no-default-browser-check \
    --window-position=0,0 --window-size="${DRIVE_SIZE:-1400,880}" \
    --enable-logging=stderr "$@"
  local pid="$LAUNCHED_PID"
  log "browser pid $pid, started in the background"
  # The whole settle time, whatever happens to the focus meanwhile.
  if ! wait_unfocused "$pid" "${DRIVE_SETTLE:-12}"; then
    # Harmless here -- a drive activates the browser anyway and needs an empty
    # chair -- but it is the focus theft capture-state refuses (PLAN.md PLT-T21).
    warn "the browser made itself the frontmost app while it started"
  fi

  local drive_status=0
  python3 "$STEDDING_ROOT/tooling/drive-window.py" "$pid" "$steps" || drive_status=$?

  # Quit this pid, not every app whose name contains Stedding.
  stop_launched_app 20
  grep -i "fatal\|check failed" "$log" | head -5 || true
  log "log: $log"
  [ "$drive_status" -eq 0 ] || exit "$drive_status"
}

main "$@"
