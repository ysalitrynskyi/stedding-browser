+// folders F3, spaces B34 (BACKLOG S-350): with horizontal tabs, a folder
+// collapsed over the tab on screen keeps that tab until another tab is
+// active; then the folder takes it back: it is not drawn and takes no click.
+// The strip kept it drawn, and clickable, until something else laid the
+// strip out.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest,
+                       HorizontalTabsGiveACollapsedFolderItsTabBack) {
+  AppendTab();
+  AppendTab();
+  ExitVerticalTabsMode();
+  ASSERT_FALSE(
+      vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+  TabStripModel* const strip = tab_strip_model();
+  ASSERT_EQ(3, strip->count());
+  tabs::TabInterface* const folded = strip->GetTabAtIndex(1);
+  tabs::FolderTabCollection* const folder = strip->AddToNewFolder({1});
+  ASSERT_TRUE(folder);
+  strip->ActivateTabAt(strip->GetIndexOfTab(folded));
+  base::RunLoop().RunUntilIdle();
+  folder->SetCollapsed(true);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_FALSE(strip->IsTabHidden(strip->GetIndexOfTab(folded)))
+      << "the tab on screen stays while it is active";
+  ASSERT_NO_FATAL_FAILURE(ExpectHorizontalStripShowsOnlyTheSpace());
+
+  strip->ActivateTabAt(0);
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(strip->IsTabHidden(strip->GetIndexOfTab(folded)));
+  ASSERT_NO_FATAL_FAILURE(ExpectHorizontalStripShowsOnlyTheSpace());
+}
