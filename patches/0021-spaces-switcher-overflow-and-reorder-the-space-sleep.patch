+
+void SpaceSwitcherView::ApplyOverflow() {
+  if (!icon_row_) {
+    return;
+  }
+  const bool overflow = SwitcherOverflows(width(), chips_.size());
+  const auto& spaces = model_->spaces();
+  for (size_t i = 0; i < chips_.size() && i < spaces.size(); ++i) {
+    auto* const chip = views::AsViewClass<views::LabelButton>(chips_[i].first);
+    if (!chip) {
+      continue;
+    }
+    const bool active = chips_[i].second == model_->active_id();
+    const bool dot =
+        SwitcherChipWidth(overflow, active, row_hovered_) == kSwitcherDot;
+    chip->SetPreferredSize(dot ? gfx::Size(kSwitcherDot, kSwitcherDot)
+                               : gfx::Size(kIconSize, kIconSize));
+    chip->SetText(dot ? std::u16string() : GlyphFor(*spaces[i], i));
+    chip->SetBackground(dot ? views::CreateRoundedRectBackground(
+                                  spaces[i]->color(), kSwitcherDot / 2)
+                            : nullptr);
+  }
+  icon_row_->InvalidateLayout();
+}
+
+void SpaceSwitcherView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  if (previous_bounds.width() != width()) {
+    ApplyOverflow();
+  }
+}
+
+void SpaceSwitcherView::OnMouseEntered(const ui::MouseEvent& event) {
+  if (!row_hovered_) {
+    row_hovered_ = true;
+    ApplyOverflow();
+  }
+}
+
+void SpaceSwitcherView::OnMouseExited(const ui::MouseEvent& event) {
+  if (row_hovered_ && !IsMouseHovered()) {
+    row_hovered_ = false;
+    ApplyOverflow();
+  }
 }
 
