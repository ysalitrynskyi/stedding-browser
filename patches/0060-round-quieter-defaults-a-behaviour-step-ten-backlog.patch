+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/window_open_disposition.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/display/display.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/bubble/bubble_border.h"
+#include "ui/views/bubble/bubble_frame_view.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "url/gurl.h"
+
+namespace {
+
+class AddressBandTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // In the screen's work area, not at (0, 0): on the Mac that is under the
+    // menu bar, where the toast's place and the row's read 33 DIP apart
+    // (2026-10-12).
+    view()->GetWidget()->SetBounds(gfx::Rect(
+        display::Screen::Get()->GetPrimaryDisplay().work_area().origin(),
+        gfx::Size(1600, 900)));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+    views::test::RunScheduledLayout(view());
+  }
+
+  // Looked up each time: a pointer kept in the fixture outlives the window,
+  // which goes before the fixture does.
+  BrowserView* view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  LocationBarView* bar() { return view()->GetLocationBarView(); }
+
+  // The leftmost visible view before the address: the chip.
+  int LeadingEdge() {
+    const int text_x = bar()->omnibox_view()->x();
+    int edge = text_x;
+    for (const views::View* child : bar()->children()) {
+      if (child != bar()->omnibox_view() && child->GetVisible() &&
+          !child->bounds().IsEmpty() && child->bounds().right() <= text_x) {
+        edge = std::min(edge, child->x());
+      }
+    }
+    return edge;
+  }
+
+};
+
+IN_PROC_BROWSER_TEST_F(AddressBandTest, TheBandStartsAtTheChip) {
+  const std::optional<gfx::Rect>& band = bar()->stedding_band_for_testing();
+  ASSERT_TRUE(band.has_value()) << "a short address is gathered on the middle";
+  EXPECT_GT(band->x(), 0) << "the band no longer starts at the field's edge";
+  const int edge = LeadingEdge();
+  EXPECT_LE(band->x(), edge) << "the chip sits inside the band";
+  EXPECT_LE(edge - band->x(), 8) << "and the band starts just before it";
+  EXPECT_EQ(bar()->width(), band->right())
+      << "the band still ends with the page actions";
+}
+
+IN_PROC_BROWSER_TEST_F(AddressBandTest, TheAddressPaintsNoPillOfItsOwn) {
+  // Hovered, the field's colour is translucent in the Stedding window; the
+  // address under it must not add a second coat. It paints either nothing
+  // or the same opaque colour as the field, never a translucent one.
+  bar()->OnOmniboxHovered(true);
+  base::RunLoop wait;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, wait.QuitClosure(), base::Milliseconds(500));
+  wait.Run();  // The hover fades in over 200 ms.
+  const SkAlpha alpha =
+      SkColorGetA(bar()->omnibox_view()->GetBackgroundColor());
+  EXPECT_TRUE(alpha == SK_AlphaTRANSPARENT || alpha == SK_AlphaOPAQUE)
+      << "the address's own background has alpha " << int{alpha};
+  bar()->OnOmniboxHovered(false);
+}
+
+IN_PROC_BROWSER_TEST_F(AddressBandTest, WhileEditingTheFieldPaintsWhole) {
+  bar()->omnibox_view()->RequestFocus();
+  views::test::RunScheduledLayout(view());
+  EXPECT_FALSE(bar()->stedding_band_for_testing().has_value())
+      << "editing keeps Chromium's whole field";
+  view()->GetFocusManager()->ClearFocus();
+  views::test::RunScheduledLayout(view());
+  EXPECT_TRUE(bar()->stedding_band_for_testing().has_value());
+}
+
+// toolbar T35: a toast sits in the page, under the address row, not half
+// over it: the undo toast after every close hid the whole address
+// (2026-10-11).
+IN_PROC_BROWSER_TEST_F(AddressBandTest, AToastLeavesTheAddressReadable) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("b.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_EQ(2, browser()->GetTabStripModel()->count());
+  chrome::CloseTab(browser());
+  ToastController* const toasts = ToastController::From(browser());
+  ASSERT_TRUE(toasts);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return toasts->IsShowingToast() && toasts->GetToastWidgetForTesting() &&
+           toasts->GetToastWidgetForTesting()->IsVisible();
+  })) << "closing a tab shows the undo toast";
+  views::test::RunScheduledLayout(view());
+  // The toast took its place as it showed. On the Mac the window was still
+  // reaching the place SetUpOnMainThread gave it, and a toast placed then sat
+  // that move off, up to 40 DIP high (2026-10-12); place it again on the
+  // settled window, as a bubble is when its window moves.
+  toasts->GetToastViewForTesting()->SizeToContents();
+  const gfx::Rect toast =
+      toasts->GetToastWidgetForTesting()->GetWindowBoundsInScreen();
+  const gfx::Rect address = bar()->GetBoundsInScreen();
+  // The widget's bounds carry the bubble's shadow, so read its middle: half
+  // over the line, it sat on the row's bottom edge.
+  EXPECT_GT(toast.CenterPoint().y(), address.bottom() + 8)
+      << "the toast's middle is at " << toast.CenterPoint().y()
+      << ", the address row ends at " << address.bottom();
+  // Its visible edge, the widget's top plus the shadow its border draws, is on
+  // or under the row's bottom. The Mac's border draws none, and a toast placed
+  // with Chromium's allowance for one crossed the line under the address row
+  // by 6 DIP: its top at 65 against the row's 71 (2026-10-12).
+  const int toast_top = toast.y() + toasts->GetToastViewForTesting()
+                                        ->GetBubbleFrameView()
+                                        ->bubble_border()
+                                        ->GetInsets()
+                                        .top();
+  EXPECT_GE(toast_top, view()->toolbar()->GetBoundsInScreen().bottom())
+      << "the toast's visible top is at " << toast_top;
+}
+
+}  // namespace
