+EditSpaceView::EditSpaceView(SpaceModel& model, SpaceId id)
+    : model_(model.GetWeakPtr()), id_(id) {
+  const Space* const space = model.GetSpace(id);
+  CHECK(space);
+  icon_ = space->icon();
+  light_ = space->color();
+  pair_ = space->dark_color().has_value();
+  dark_ = space->dark_color().value_or(space->color());
+  SkScalar hsv[3];
+  SkColorToHSV(light_, hsv);
+  hue_ = hsv[0];
+
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), kSectionGap));
+
+  // The Space as the sidebar heads it: its icon, then its name.
+  views::View* const head = AddChildView(Row(12));
+  icon_preview_ = head->AddChildView(std::make_unique<views::Label>());
+  icon_preview_->SetFontList(gfx::FontList().DeriveWithSizeDelta(16));
+  icon_preview_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  icon_preview_->SetPreferredSize(gfx::Size(48, 48));
+  icon_preview_->GetViewAccessibility().SetName(u"The Space's icon");
+  name_field_ = head->AddChildView(std::make_unique<views::Textfield>());
+  name_field_->SetText(base::UTF8ToUTF16(space->name()));
+  name_field_->SetPlaceholderText(u"Space name");
+  name_field_->GetViewAccessibility().SetName(u"Space name");
+  name_field_->set_controller(this);
+  static_cast<views::BoxLayout*>(head->GetLayoutManager())
+      ->SetFlexForView(name_field_, 1);
+
+  // The icon and the colour, a page each, so the window fits a small screen.
+  auto* const tabs = AddChildView(std::make_unique<views::TabbedPane>());
+  BuildIconSection(tabs->AddTab(u"Icon", Column(kRowGap)));
+  BuildColourSection(tabs->AddTab(u"Colour", Column(kRowGap)));
+  Refresh();
+}
+
+EditSpaceView::~EditSpaceView() = default;
+
+void EditSpaceView::BuildIconSection(views::View* section) {
+  section->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(12, 0, 4, 0)));
+  views::View* const side = section->AddChildView(Column(6));
+  icon_field_ = side->AddChildView(std::make_unique<views::Textfield>());
+  icon_field_->SetPlaceholderText(u"Type or paste any emoji");
+  icon_field_->GetViewAccessibility().SetName(u"Icon");
+  icon_field_->set_controller(this);
+  views::View* const buttons = side->AddChildView(Row(8));
+  // spaces B42: the system's own picker, into the field.
+  if (ui::IsEmojiPanelSupported()) {
+    buttons->AddChildView(std::make_unique<views::MdTextButton>(
+        base::BindRepeating(
+            [](EditSpaceView* view) {
+              view->icon_field_->RequestFocus();
+              ui::ShowEmojiPanel();
+            },
+            base::Unretained(this)),
+        u"More Emoji\u2026"));
+  }
+  buttons->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&EditSpaceView::PressNoIconForTesting,
+                          base::Unretained(this)),
+      u"No Icon"));
+
+  views::View* const grid = section->AddChildView(Column(2));
+  views::View* row = nullptr;
+  const std::vector<std::u16string>& choices = EmojiChoices();
+  for (size_t i = 0; i < choices.size(); ++i) {
+    if (i % kEmojisPerRow == 0) {
+      row = grid->AddChildView(Row(2));
+    }
+    emoji_buttons_.push_back(row->AddChildView(std::make_unique<EmojiButton>(
+        base::BindRepeating(&EditSpaceView::PressEmojiForTesting,
+                            base::Unretained(this), i),
+        choices[i])));
+  }
+}
+
+void EditSpaceView::BuildColourSection(views::View* section) {
+  section->SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(12, 0, 4, 0)));
+  // spaces B43: one colour, which both looks take, or one for each.
+  views::View* const mode = section->AddChildView(Row(16));
+  one_colour_ = mode->AddChildView(std::make_unique<views::RadioButton>(
+      u"One colour", kColourModeGroup));
+  one_colour_->SetCallback(base::BindRepeating(
+      &EditSpaceView::ChoosePairForTesting, base::Unretained(this), false));
+  two_colours_ = mode->AddChildView(std::make_unique<views::RadioButton>(
+      u"Light and dark", kColourModeGroup));
+  two_colours_->SetCallback(base::BindRepeating(
+      &EditSpaceView::ChoosePairForTesting, base::Unretained(this), true));
+
+
+  views::View* const palette = section->AddChildView(Column(kSwatchGap));
+  const std::vector<SkColor> colors = PaletteColors();
+  views::View* row = nullptr;
+  for (size_t i = 0; i < colors.size(); ++i) {
+    if (i % kSpaceColors.size() == 0) {
+      row = palette->AddChildView(Row(kSwatchGap));
+    }
+    const size_t base = i % kSpaceColors.size();
+    const size_t step = i / kSpaceColors.size();
+    std::u16string name = kSpaceColors.at(base).name;
+    if (step == 0) {
+      name += u", deeper";
+    } else if (step == 2) {
+      name += u", softer";
+    }
+    swatches_.push_back(row->AddChildView(std::make_unique<Swatch>(
+        base::BindRepeating(&EditSpaceView::PressPaletteForTesting,
+                            base::Unretained(this), i),
+        colors[i], std::move(name))));
+  }
+
+  views::View* const custom = section->AddChildView(Row(12));
+  static_cast<views::BoxLayout*>(custom->GetLayoutManager())
+      ->set_cross_axis_alignment(views::BoxLayout::CrossAxisAlignment::kStart);
+  views::View* const picker = custom->AddChildView(Column(8));
+  pad_ = picker->AddChildView(std::make_unique<SaturationValuePad>(
+      base::BindRepeating(
+          [](EditSpaceView* view, float saturation, float value) {
+            SkScalar hsv[3] = {view->hue_, saturation, value};
+            view->SetEditedColor(SkHSVToColor(hsv), /*from_picker=*/true);
+          },
+          base::Unretained(this))));
+  hue_bar_ = picker->AddChildView(std::make_unique<HueBar>(base::BindRepeating(
+      [](EditSpaceView* view, float hue) {
+        SkScalar hsv[3];
+        SkColorToHSV(view->EditedColor(), hsv);
+        view->hue_ = hue;
+        // A grey has no hue to turn: the bar gives it some colour.
+        hsv[0] = hue;
+        if (hsv[1] < 0.05f) {
+          hsv[1] = 0.6f;
+          hsv[2] = std::max(hsv[2], 0.6f);
+        }
+        view->SetEditedColor(SkHSVToColor(hsv), /*from_picker=*/true);
+      },
+      base::Unretained(this))));
+  hex_field_ = custom->AddChildView(std::make_unique<views::Textfield>());
+  hex_field_->SetPlaceholderText(u"#RRGGBB");
+  hex_field_->GetViewAccessibility().SetName(u"Colour as a hex code");
+  hex_field_->SetDefaultWidthInChars(10);
+  hex_field_->set_controller(this);
+  BuildPreview(section);
+}
+
+void EditSpaceView::BuildPreview(views::View* page) {
+  // spaces B43: the sidebar in each look; with a pair, a press on one
+  // chooses the look the palette colours.
+  views::View* const row = page->AddChildView(Row(12));
+  for (const bool dark : {false, true}) {
+    views::View* const column = row->AddChildView(Column(4));
+    column->AddChildView(std::make_unique<views::Label>(
+                             dark ? u"Dark look" : u"Light look",
+                             views::style::CONTEXT_LABEL,
+                             views::style::STYLE_SECONDARY))
+        ->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    LookPreview* const preview =
+        column->AddChildView(std::make_unique<LookPreview>(
+            dark, base::BindRepeating(&EditSpaceView::EditDarkForTesting,
+                                      base::Unretained(this), dark)));
+    (dark ? dark_preview_ : light_preview_) = preview;
+  }
+}
+
+void EditSpaceView::PressEmojiForTesting(size_t index) {
+  if (index < EmojiChoices().size()) {
+    SetIcon(base::UTF16ToUTF8(EmojiChoices()[index]));
+  }
+}
+
+void EditSpaceView::TypeIconForTesting(const std::u16string& text) {
+  icon_field_->SetText(text);
+  ContentsChanged(icon_field_, text);
+}
+
+void EditSpaceView::PressNoIconForTesting() {
+  icon_field_->SetText(std::u16string());
+  SetIcon(std::string());
+}
+
+void EditSpaceView::ChoosePairForTesting(bool pair) {
+  SetPair(pair);
+}
+
+void EditSpaceView::EditDarkForTesting(bool dark) {
+  SetEditingDark(dark);
+}
+
+void EditSpaceView::PressPaletteForTesting(size_t index) {
+  if (index < swatches_.size()) {
+    SetEditedColor(static_cast<Swatch*>(swatches_[index].get())->color(),
+                   /*from_picker=*/false);
+  }
+}
+
+void EditSpaceView::TypeHexForTesting(const std::u16string& hex) {
+  hex_field_->SetText(hex);
+  ContentsChanged(hex_field_, hex);
+}
+
+void EditSpaceView::ContentsChanged(views::Textfield* sender,
+                                    const std::u16string& new_contents) {
+  if (sender == icon_field_) {
+    // spaces B42: the first character, kept whole; an emptied field keeps
+    // the icon (No Icon clears it).
+    std::string icon = SpaceIconFromText(new_contents);
+    if (!icon.empty()) {
+      SetIcon(std::move(icon));
+    }
+    return;
+  }
+  if (sender == hex_field_) {
+    if (const std::optional<SkColor> color = ColorFromHex(new_contents)) {
+      SetEditedColor(*color, /*from_picker=*/false);
+    }
+    return;
+  }
+  // The name, in the preview.
+  Refresh();
+}
+
+void EditSpaceView::SetIcon(std::string icon) {
+  icon_ = std::move(icon);
+  Refresh();
+}
+
+SkColor EditSpaceView::EditedColor() const {
+  return pair_ && editing_dark_ ? dark_ : light_;
+}
+
+void EditSpaceView::SetEditedColor(SkColor color, bool from_picker) {
+  (pair_ && editing_dark_ ? dark_ : light_) = color;
+  colour_touched_ = true;
+  if (!from_picker) {
+    SkScalar hsv[3];
+    SkColorToHSV(color, hsv);
+    // A grey says nothing of hue; the picker keeps the one it had.
+    if (hsv[1] > 0.01f) {
+      hue_ = hsv[0];
+    }
+  }
+  Refresh();
+}
+
+void EditSpaceView::SetPair(bool pair) {
+  if (pair == pair_) {
+    return;
+  }
+  // A pair starts with the dark look in the one colour there was; the dark
+  // look is the one to choose next.
+  if (pair) {
+    dark_ = light_;
+  }
+  pair_ = pair;
+  editing_dark_ = pair;
+  colour_touched_ = true;
+  Refresh();
+}
+
+void EditSpaceView::SetEditingDark(bool dark) {
+  editing_dark_ = pair_ && dark;
+  SkScalar hsv[3];
+  SkColorToHSV(EditedColor(), hsv);
+  if (hsv[1] > 0.01f) {
+    hue_ = hsv[0];
+  }
+  Refresh();
+}
+
+void EditSpaceView::Refresh() {
+  const ui::ColorProvider* const provider = GetColorProvider();
+  const SkColor ink =
+      provider ? provider->GetColor(ui::kColorLabelForeground) : SK_ColorBLACK;
+  // The icon, or the dot a Space without one shows (spaces B11).
+  icon_preview_->SetText(icon_.empty() ? u"\u25CF" : base::UTF8ToUTF16(icon_));
+  icon_preview_->SetEnabledColor(icon_.empty() ? light_ : ink);
+  icon_preview_->SetBackground(views::CreateRoundedRectBackground(
+      SkColorSetA(ink, 0x14), 12));
+  const std::vector<std::u16string>& choices = EmojiChoices();
+  for (size_t i = 0; i < emoji_buttons_.size(); ++i) {
+    const bool chosen = base::UTF16ToUTF8(choices[i]) == icon_;
+    static_cast<EmojiButton*>(emoji_buttons_[i].get())->SetChosen(chosen);
+  }
+
+  one_colour_->SetChecked(!pair_);
+  two_colours_->SetChecked(pair_);
+  const SkColor edited = EditedColor();
+  for (const raw_ptr<views::Button>& swatch : swatches_) {
+    auto* const disc = static_cast<Swatch*>(swatch.get());
+    disc->SetChosen(disc->color() == edited);
+  }
+  SkScalar hsv[3];
+  SkColorToHSV(edited, hsv);
+  pad_->Set(hue_, hsv[1], hsv[2]);
+  hue_bar_->Set(hue_);
+  // A hex being typed is left as it is.
+  if (!hex_field_->HasFocus() ||
+      ColorFromHex(hex_field_->GetText()) != std::optional<SkColor>(edited)) {
+    if (!hex_field_->HasFocus()) {
+      hex_field_->SetText(HexOf(edited));
+    }
+  }
+
+  const std::u16string glyph =
+      icon_.empty() ? std::u16string() : base::UTF8ToUTF16(icon_);
+  std::u16string name(name_field_->GetText());
+  if (name.empty()) {
+    name = u"Space";
+  }
+  light_preview_->Set(light_, glyph, name);
+  dark_preview_->Set(pair_ ? dark_ : light_, glyph, name);
+  light_preview_->SetChosen(pair_ && !editing_dark_);
+  dark_preview_->SetChosen(pair_ && editing_dark_);
+  InvalidateLayout();
+}
+
+void EditSpaceView::Apply() {
+  SpaceModel* const model = model_.get();
+  if (!model || !model->GetSpace(id_)) {
+    return;
+  }
+  const std::string name = base::UTF16ToUTF8(
+      base::TrimWhitespace(name_field_->GetText(), base::TRIM_ALL));
+  if (name != model->GetSpace(id_)->name()) {
+    model->SetSpaceName(id_, name);
+  }
+  if (const Space* const space = model->GetSpace(id_);
+      space && icon_ != space->icon()) {
+    model->SetSpaceIcon(id_, icon_);
+  }
+  const std::optional<SkColor> dark =
+      pair_ ? std::optional<SkColor>(dark_) : std::nullopt;
+  if (const Space* const space = model->GetSpace(id_);
+      space && colour_touched_ &&
+      (light_ != space->color() || dark != space->dark_color() ||
+       !space->color_chosen())) {
+    model->SetSpaceColors(id_, light_, dark);
+  }
+}
