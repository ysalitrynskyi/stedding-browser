@@ -0,0 +1,720 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Clean links in a real window (docs/features/clean-links.md): what the
+// test server is asked for when a page is opened from a link, a new tab, the
+// address field, a redirect page or a private window; what it is still asked
+// for by the page's own requests, forms and redirects; what a restart for
+// client hints asks for; what history keeps; the SafeSearch policy; the
+// setting, its command-bar row and the kept sites in Settings.
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <string_view>
