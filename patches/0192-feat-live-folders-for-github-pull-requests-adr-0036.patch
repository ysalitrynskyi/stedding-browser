+// Lf5: at the next refresh a merged pull request's row goes; one the person
+// opened stays, a normal tab of the Space, out of the folder.
+IN_PROC_BROWSER_TEST_F(LiveFoldersTest, AMergedPullRequestLeavesAtTheNextRefresh) {
+  AnswerTheFirstList();
+  ASSERT_EQ(Failure::kNone, Make());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return LiveRows(browser()).size() == FirstList().size(); }));
+  // The person opens #45 (asked to review).
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  tabs::TabInterface* const opened = LiveRows(browser())[0];
+  strip->ActivateTabAt(strip->GetIndexOfTab(opened));
+  ASSERT_TRUE(base::test::RunUntil([&] { return !Asleep(opened); }));
+
+  // #7 is merged, and the review of #45 is done.
+  answers_["author:@me"] = {net::HTTP_OK,
+                            live_folders::recorded::kAuthoredAfterMerge};
+  answers_["review-requested:@me"] = {net::HTTP_OK,
+                                      live_folders::recorded::kNothing};
+  RefreshAndWait();
+
+  EXPECT_EQ(std::vector<std::u16string>{
+                u"acme/rocket: Make the launch window configurable"},
+            Names(LiveRows(browser())));
+  EXPECT_EQ(1u, Service().rows());
+  // #7 was asleep: its tab is gone, under any token.
+  EXPECT_EQ(0u, TabsAt(browser(), Fuel7Url()));
+  EXPECT_EQ(1u, TabsAt(browser(), Rocket45Url()));
+  // #45 was open: it stays, loose, with a token of its own.
+  ASSERT_NE(TabStripModel::kNoTab, strip->GetIndexOfTab(opened));
+  EXPECT_FALSE(Model(browser()).IsSpacePinned(opened));
+  EXPECT_FALSE(FolderOf(opened));
+  EXPECT_FALSE(live_folders::IsLiveRowToken(
+      stedding::TabToken(opened->GetContents())));
+  EXPECT_EQ(Failure::kNone, Service().failure());
+}
