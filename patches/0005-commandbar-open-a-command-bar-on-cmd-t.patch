+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_COMMANDBAR_COMMAND_BAR_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_COMMANDBAR_COMMAND_BAR_VIEW_H_
+
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+
+class Browser;
+class BrowserView;
+
+namespace views {
+class ScrollView;
+class Textfield;
+}  // namespace views
+
+namespace stedding {
+
+// The overlay that ⌘T opens: a search field over a list of things to go to.
+//
+// It searches every Space, not only the active one, and says which Space a
+// result is in when that is not the one you are looking at. That is the payoff
+// of ADR 0015 keeping all Spaces' tabs in one TabStripModel: finding a tab in
+// another Space costs nothing.
+//
+// It is a layered child of the browser window, not a popup window of its own.
+// A popup on macOS is shown without becoming the key window, so keystrokes go
+// to the browser window behind it, and the first one closed the bar. Inside
+// the window the field takes focus through the window's own focus manager,
+// Escape is an accelerator on that manager, and focus leaving the bar (a
+// click elsewhere, a navigation) is what dismisses it.
+class CommandBarView : public views::View,
+                       public views::TextfieldController,
+                       public views::FocusChangeListener,
+                       public views::ViewObserver {
+  METADATA_HEADER(CommandBarView, views::View)
+
+ public:
+  // Opens the command bar for `browser`, or focuses the one already open.
+  static void Show(Browser* browser);
+
+  // The open bar in `browser_view`, or null.
+  static CommandBarView* GetOpenBar(BrowserView* browser_view);
+
+  explicit CommandBarView(Browser* browser);
+  CommandBarView(const CommandBarView&) = delete;
+  CommandBarView& operator=(const CommandBarView&) = delete;
+  ~CommandBarView() override;
+
+  // Removes the bar from the window. Safe to call from within an event the
+  // bar is handling: the view is deleted one turn later.
+  void Close();
+
+  views::Textfield* field_for_testing() { return field_; }
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override;
+
+  // views::View:
+  void AddedToWidget() override;
+  void RemovedFromWidget() override;
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+
+  // views::FocusChangeListener:
+  void OnDidChangeFocus(views::View* focused_before,
+                        views::View* focused_now) override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+
+ private:
+  // One thing the user can go to.
+  struct Result {
+    // Index in the tab strip, or -1 when this is "open what you typed".
+    int tab_index;
+    std::u16string title;
+    // The Space this tab is in, shown only when it is not the active one.
+    std::u16string space;
+  };
+
+  // Builds the field and the list.
+  void BuildContents();
+
+  // Centres the bar over the window's contents.
+  void UpdateBounds();
+
+  // Rebuilds the result list for `query`.
+  void UpdateResults(const std::u16string& query);
+
+  // Goes to `result` and closes. Not named Accept: DialogDelegate already has
+  // a virtual of that name and this would hide it.
+  void GoTo(const Result& result);
+
+  // Opens whatever is in the field: a URL if it looks like one, a search
+  // otherwise.
+  void OpenTypedText();
+
+  const raw_ptr<Browser> browser_;
+  raw_ptr<views::Textfield> field_ = nullptr;
+  raw_ptr<views::ScrollView> list_ = nullptr;
+  std::vector<Result> results_;
+  bool closing_ = false;
+  // Set once the field has focus; focus changes before that are the bar's own.
+  bool watching_focus_ = false;
+  base::ScopedObservation<views::View, views::ViewObserver> parent_observation_{
+      this};
+  base::WeakPtrFactory<CommandBarView> weak_factory_{this};
+};
