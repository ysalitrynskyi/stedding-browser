+int SpaceModel::EndOfSpacePinRun(const tabs::TabInterface* tab) const {
+  // The end of the run of Space-pinned tabs at the top of the unpinned block,
+  // `tab` aside wherever it is, so an unpin from the middle of the run lands
+  // past the pins that stay. The run ends at the first loose tab of `tab`'s
+  // Space. Another Space's loose tab is no row here, and the pins may go on
+  // after it (pins H14, BACKLOG S-314): a split brings one up among them.
+  const std::optional<SpaceId> space = FindSpaceForTab(tab);
+  const int first = tab_strip_model_->IndexOfFirstNonPinnedTab();
+  int end = first;
+  for (int i = first; i < tab_strip_model_->count(); ++i) {
+    const tabs::TabInterface* const each = tab_strip_model_->GetTabAtIndex(i);
+    if (each == tab) {
+      continue;
+    }
+    if (IsSpacePinned(each)) {
+      end = i + 1;
+    } else if (FindSpaceForTab(each) == space) {
+      break;
+    }
+  }
+  if (end == first || end >= tab_strip_model_->count()) {
+    return end;
+  }
+  // A split or a folder is one row, which has a loose tab if it goes on past
+  // the last pin: the run ended before it. `tab`'s own folder is its place to
+  // leave, not a row to stay out of.
+  const tabs::TabInterface* const last = tab_strip_model_->GetTabAtIndex(end - 1);
+  const tabs::TabInterface* const next = tab_strip_model_->GetTabAtIndex(end);
+  if (const tabs::TabCollection* const folder = OutermostFolderOf(last);
+      folder && folder == OutermostFolderOf(next) &&
+      folder != OutermostFolderOf(tab)) {
+    return tab_strip_model_->GetIndexOfTab(folder->GetTabsRecursive().front());
+  }
+  if (last->IsSplit() && last->GetSplit() == next->GetSplit()) {
+    return tab_strip_model_->GetIndexOfTab(
+        tab_strip_model_->GetSplitData(*last->GetSplit())->ListTabs().front());
+  }
+  return end;
+}
