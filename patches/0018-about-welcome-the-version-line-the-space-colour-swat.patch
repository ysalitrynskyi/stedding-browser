@@ -0,0 +1,88 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/stedding_welcome/stedding_welcome_handler.h"
+
+#include <memory>
+
+#include "base/values.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_colors.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/webui/stedding_welcome/welcome_host.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/test_web_ui.h"
+#include "content/public/test/web_contents_tester.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+// set_web_ui is protected on the base; the test needs it.
+class TestWelcomeHandler : public WelcomeHandler {
+ public:
+  using WelcomeHandler::set_web_ui;
+};
+
+class SteddingWelcomeHandlerTest : public BrowserWithTestWindowTest {
+ protected:
+  void SetUp() override {
+    BrowserWithTestWindowTest::SetUp();
+    contents_ = content::WebContentsTester::CreateTestWebContents(
+        profile(), /*instance=*/nullptr);
+    // The dialog attaches the window this way before the page can send.
+    WelcomeHost::CreateForWebContents(contents_.get(), browser());
+    web_ui_.set_web_contents(contents_.get());
+    handler_ = std::make_unique<TestWelcomeHandler>();
+    handler_->set_web_ui(&web_ui_);
+    handler_->RegisterMessages();
+  }
+
+  void TearDown() override {
+    handler_.reset();
+    contents_.reset();
+    BrowserWithTestWindowTest::TearDown();
+  }
+
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+
+  content::TestWebUI web_ui_;
+  std::unique_ptr<content::WebContents> contents_;
+  std::unique_ptr<TestWelcomeHandler> handler_;
+};
+
+// welcome W7: choosing a swatch tints the window's first Space at once; an
+// index off the table changes nothing.
+TEST_F(SteddingWelcomeHandlerTest, SetSpaceColorTintsTheFirstSpace) {
+  const SkColor before = model().active_space()->color();
+  ASSERT_EQ(spaces::kSpaceColors[0].color, before);
+
+  base::ListValue args;
+  args.Append(2);
+  web_ui_.HandleReceivedMessage("setSpaceColor", args);
+  EXPECT_EQ(spaces::kSpaceColors[2].color, model().active_space()->color());
+
+  base::ListValue bad;
+  bad.Append(42);
+  web_ui_.HandleReceivedMessage("setSpaceColor", bad);
+  EXPECT_EQ(spaces::kSpaceColors[2].color, model().active_space()->color());
+}
+
+// welcome W7: the page is offered exactly the switcher's five colours.
+TEST_F(SteddingWelcomeHandlerTest, GetSpaceColorsListsTheTable) {
+  base::ListValue args;
+  args.Append("callback-id");
+  web_ui_.HandleReceivedMessage("getSpaceColors", args);
+  ASSERT_EQ(1U, web_ui_.call_data().size());
+  const content::TestWebUI::CallData& call = *web_ui_.call_data().back();
+  EXPECT_EQ("cr.webUIResponse", call.function_name());
+  ASSERT_TRUE(call.arg3()->is_list());
+  EXPECT_EQ(spaces::kSpaceColors.size(), call.arg3()->GetList().size());
+  EXPECT_EQ("#7A5B8C", *call.arg3()->GetList()[1].GetDict().FindString("color"));
+}
+
+}  // namespace
+}  // namespace stedding
