+std::optional<BrowserRootView::DropIndex>
+TabLinkDropHandler::GetDropIndexForFolder(
+    const TabCollectionNode& node,
+    std::optional<DragPositionHint> position_hint) const {
+  const auto* collection = static_cast<const tabs::FolderTabCollection*>(
+      std::get<tabs::ConstDanglingUntriagedTabCollection>(node.GetNodeData()));
+  if (!collection) {
+    return std::nullopt;
+  }
+  const std::vector<tabs::TabInterface*> tabs = collection->GetTabsRecursive();
+  if (tabs.empty()) {
+    // An empty folder has no tab index. Refuse rather than guess.
+    return std::nullopt;
+  }
+  const bool after = position_hint == DragPositionHint::kAfter;
+  tabs::TabInterface* const edge = after ? tabs.back() : tabs.front();
+  int index = tab_strip_model_->GetIndexOfTab(edge);
+  if (index == TabStripModel::kNoTab) {
+    return std::nullopt;
+  }
+  if (after) {
+    ++index;
+  }
+  return BrowserRootView::DropIndex{
+      .index = index,
+      .relative_to_index =
+          BrowserRootView::DropIndex::RelativeToIndex::kInsertBeforeIndex,
+      .group_inclusion =
+          BrowserRootView::DropIndex::GroupInclusion::kDontIncludeInGroup};
+}
