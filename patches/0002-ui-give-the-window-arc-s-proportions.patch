+      // prefers the whole toolbar, so there is no leftover for the spacers to
+      // take and nothing to centre it in. SetPreferredSize() does not do this:
+      // FlexLayout asks for the preferred size that fits given bounds, which
+      // goes to LocationBarView's own calculation and ignores a stored value.
+      // Below the cap the rule defers to what the bar asks for, so a narrow
+      // window still shrinks it.
+      location_bar_view_->SetProperty(
+          views::kFlexBehaviorKey,
+          views::FlexSpecification(
+              base::BindRepeating(
+                  [](const views::View* view, const views::SizeBounds& bounds) {
+                    gfx::Size size = view->GetPreferredSize(bounds);
+                    size.set_width(std::min(
+                        size.width(), stedding::kLocationBarWidth.Get()));
+                    return size;
+                  }))
+              .WithOrder(location_bar_flex_order));
+
+      const views::FlexSpecification spacer_rule =
+          views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                                   views::MaximumFlexSizeRule::kUnbounded)
+              .WithOrder(location_bar_flex_order);
+      const size_t location_bar_index =
+          GetIndexOf(location_bar_view_.get()).value();
+      AddChildViewAt(std::make_unique<views::View>(), location_bar_index)
+          ->SetProperty(views::kFlexBehaviorKey, spacer_rule);
+      // The location bar has shifted along by one.
+      AddChildViewAt(std::make_unique<views::View>(), location_bar_index + 2)
+          ->SetProperty(views::kFlexBehaviorKey, spacer_rule);
+    }
