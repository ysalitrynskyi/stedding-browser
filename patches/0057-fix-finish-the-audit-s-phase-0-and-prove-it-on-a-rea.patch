+namespace {
+
+// The first view of class T at or under `view`.
+template <typename T>
+T* FindView(views::View* view) {
+  if (T* const found = views::AsViewClass<T>(view)) {
+    return found;
+  }
+  for (views::View* const child : view->children()) {
+    if (T* const found = FindView<T>(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// The button at or under `view` whose tooltip is `tooltip`.
+views::Button* FindButtonWithTooltip(views::View* view,
+                                     const std::u16string& tooltip) {
+  if (auto* const button = views::AsViewClass<views::Button>(view);
+      button && button->GetTooltipText() == tooltip) {
+    return button;
+  }
+  for (views::View* const child : view->children()) {
+    if (views::Button* const found = FindButtonWithTooltip(child, tooltip)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+class SidebarRailTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+
+  tabs::VerticalTabStripStateController* controller() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+
+  bool Animating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+
+  // No drawn row shows a label in the rail, and every one keeps its label
+  // outside it: a label then shows as soon as the row has room for it (in the
+  // middle of an animation a row can be too narrow for any).
+  void ExpectTheFormOfTheWidth() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    const int width = region()->width();
+    const bool rail = VerticalTabStripRegionView::IsRailWidth(width);
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      TabView* const row = stedding::test::FindDrawnRow(
+          browser_view()->GetWidget()->GetRootView(),
+          tab_strip_model()->GetTabAtIndex(i));
+      if (!row) {
+        continue;
+      }
+      // A rail row keeps its title view and lays it out with no room.
+      const views::View* const title = row->title_for_testing();
+      const bool shows_label = title->GetVisible() && title->width() > 0;
+      if (rail) {
+        EXPECT_FALSE(shows_label)
+            << "row " << i << " in a rail " << width << " DIP wide, title "
+            << title->bounds().ToString();
+      } else {
+        EXPECT_TRUE(title->GetVisible())
+            << "row " << i << " in a strip " << width << " DIP wide";
+      }
+    }
+  }
+
+  // Runs the strip's animation to its end, checking the form at every turn
+  // of the loop the animation steps in.
+  void CheckEveryStep() {
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      ExpectTheFormOfTheWidth();
+      return !Animating();
+    }));
+    ExpectTheFormOfTheWidth();
+  }
+
+  // What a drifted pin's row wears: the dot on its favicon (pins H4), Arc's
+  // slash before its title (H12).
+  struct DriftMarks {
+    bool dot = false;
+    bool slash = false;
+  };
+  DriftMarks MarksOf(tabs::TabInterface* tab) {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    TabView* const row = stedding::test::FindDrawnRow(
+        browser_view()->GetWidget()->GetRootView(), tab);
+    DriftMarks marks;
+    if (!row) {
+      return marks;
+    }
+    marks.dot = row->GetTabIconForTesting()->GetShowingAttentionIndicator();
+    for (const views::View* const child : row->children()) {
+      if (const auto* const label =
+              views::AsViewClass<views::Label>(const_cast<views::View*>(child));
+          label && label->GetText() == u"/") {
+        marks.slash = label->GetVisible() && label->width() > 0;
+      }
+    }
+    return marks;
+  }
+
+  ui::MouseEvent MouseEvent(ui::EventType type) {
+    const gfx::Point centre = region()->GetLocalBounds().CenterPoint();
+    return ui::MouseEvent(type, centre, centre, base::TimeTicks::Now(),
+                          ui::EF_NONE, ui::EF_NONE);
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SidebarRailTest, TheFormFollowsTheDrawnWidth) {
+  AppendTab();
+  AppendTab();
+  ExpectTheFormOfTheWidth();
+  controller()->RequestCollapse(true);
+  CheckEveryStep();
+  ASSERT_TRUE(controller()->IsCollapsed());
+  controller()->RequestCollapse(false);
+  CheckEveryStep();
+  ASSERT_FALSE(controller()->IsCollapsed());
+}
+
+IN_PROC_BROWSER_TEST_F(SidebarRailTest, HoveringTheRailLeavesOneClickHandler) {
+  AppendTab();
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarHoverDelayMs, 50);
+  controller()->SetExpandOnHoverEnabled(true);
+  controller()->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+  ASSERT_TRUE(controller()->IsCollapsed());
+
+  ui::EventTargetTestApi handlers(region());
+  const size_t at_rest = handlers.GetPreTargetHandlers().size();
+  for (int hover = 0; hover < 10; ++hover) {
+    SCOPED_TRACE(testing::Message() << "hover " << hover);
+    region()->OnMouseEntered(MouseEvent(ui::EventType::kMouseEntered));
+    region()->OnMouseMoved(MouseEvent(ui::EventType::kMouseMoved));
+    EXPECT_LE(handlers.GetPreTargetHandlers().size(), at_rest + 1)
+        << "one click handler while the rail waits to open";
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return region()->is_expanded_on_hover() && !Animating();
+    }));
+    ExpectTheFormOfTheWidth();
+    region()->OnMouseExited(MouseEvent(ui::EventType::kMouseExited));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !region()->is_expanded_on_hover() && !Animating();
+    }));
+    ExpectTheFormOfTheWidth();
+  }
+  EXPECT_EQ(at_rest, handlers.GetPreTargetHandlers().size())
+      << "no handler left behind";
+}
+
+// PLAN.md TAB-2 (pins H4, H12): a drifted Space pin wears the dot in the
+// rail and Arc's slash in a row with a title -- the hover-expanded rail's
+// rows have one -- and never both, at any step of a collapse or an expand.
+// A drifted essential is a card, with the dot in every form.
+IN_PROC_BROWSER_TEST_F(SidebarRailTest, ADriftedPinShowsTheDotOrTheSlash) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL home = embedded_test_server()->GetURL("/title1.html");
+  const GURL away = embedded_test_server()->GetURL("/title2.html");
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  TabStripModel* const strip = tab_strip_model();
+  // A Space pin and an essential, each pinned at home and then taken away.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  tabs::TabInterface* const space_pin = strip->GetActiveTab();
+  model->SetSpacePinned(space_pin, true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), home, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const essential = strip->GetActiveTab();
+  strip->SetTabPinned(strip->GetIndexOfTab(essential), true);
+  for (tabs::TabInterface* const tab : {space_pin, essential}) {
+    strip->ActivateTabAt(strip->GetIndexOfTab(tab));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), away));
+  }
+  AppendTab();
+
+  const auto never_both = [&]() {
+    for (tabs::TabInterface* const tab : {space_pin, essential}) {
+      const DriftMarks marks = MarksOf(tab);
+      EXPECT_FALSE(marks.dot && marks.slash)
+          << (tab == space_pin ? "the Space pin" : "the essential") << " at "
+          << region()->width() << " DIP";
+    }
+  };
+
+  // The open sidebar: the slash on the row, the dot on the card.
+  EXPECT_TRUE(MarksOf(space_pin).slash);
+  EXPECT_FALSE(MarksOf(space_pin).dot);
+  EXPECT_TRUE(MarksOf(essential).dot);
+  EXPECT_FALSE(MarksOf(essential).slash);
+
+  // The rail: the dot on both.
+  controller()->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    never_both();
+    return !Animating();
+  }));
+  ASSERT_TRUE(controller()->IsCollapsed());
+  EXPECT_TRUE(MarksOf(space_pin).dot);
+  EXPECT_FALSE(MarksOf(space_pin).slash);
+  EXPECT_TRUE(MarksOf(essential).dot);
+
+  // The rail expanded by hover has rows with titles again: the slash.
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarHoverDelayMs, 50);
+  controller()->SetExpandOnHoverEnabled(true);
+  region()->OnMouseEntered(MouseEvent(ui::EventType::kMouseEntered));
+  region()->OnMouseMoved(MouseEvent(ui::EventType::kMouseMoved));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    never_both();
+    return region()->is_expanded_on_hover() && !Animating();
+  }));
+  EXPECT_TRUE(MarksOf(space_pin).slash);
+  EXPECT_FALSE(MarksOf(space_pin).dot);
+  EXPECT_TRUE(MarksOf(essential).dot);
+  EXPECT_FALSE(MarksOf(essential).slash);
+  region()->OnMouseExited(MouseEvent(ui::EventType::kMouseExited));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    never_both();
+    return !region()->is_expanded_on_hover() && !Animating();
+  }));
+}
+
+// PLAN.md WIN-3: the rail's New Tab and Archived rows are glyphs alone, and
+// VoiceOver still reads them by name: they were unlabelled buttons.
+IN_PROC_BROWSER_TEST_F(SidebarRailTest, TheRailsRowsKeepTheirNames) {
+  controller()->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+  ASSERT_TRUE(controller()->IsCollapsed());
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+
+  TabStripView* const strip = FindView<TabStripView>(region());
+  ASSERT_TRUE(strip);
+  views::LabelButton* const new_tab = strip->GetNewTabRow();
+  ASSERT_TRUE(new_tab);
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_ACCNAME_NEWTAB),
+            new_tab->GetViewAccessibility().GetCachedName());
+
+  views::Button* const archived =
+      FindButtonWithTooltip(region(), u"Archived tabs");
+  ASSERT_TRUE(archived);
+  EXPECT_EQ(u"Archived tabs", archived->GetViewAccessibility().GetCachedName());
+}
+
+}  // namespace
