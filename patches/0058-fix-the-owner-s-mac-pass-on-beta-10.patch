+    // The swipe's momentum is the swipe's: it neither scrolls the list nor
+    // starts another swipe. Fingers down again begin a new gesture.
+    if (fingers_down) {
+      ResetGesture();
+    } else {
+      event->SetHandled();
+      event->StopPropagation();
+      if (event->momentum_phase() == ui::EventMomentumPhase::END) {
