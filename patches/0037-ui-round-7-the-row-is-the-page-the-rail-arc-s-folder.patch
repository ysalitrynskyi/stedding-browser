new file mode 100644
index 0000000000000..a4c3bfdf04fad
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/common/sidebar_symbols_mac.mm
@@ -0,0 +1,37 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/sidebar_symbols.h"
+
+#import <AppKit/AppKit.h>
+
+#include "base/strings/sys_string_conversions.h"
+#include "ui/gfx/image/image_skia_operations.h"
+#include "ui/gfx/image/image_skia_util_mac.h"
+
+namespace stedding {
+
+gfx::ImageSkia SystemSymbolImage(const char* name, int size, SkColor color) {
+  NSImage* symbol =
+      [NSImage imageWithSystemSymbolName:base::SysUTF8ToNSString(name)
+                accessibilityDescription:nil];
+  if (!symbol) {
+    return gfx::ImageSkia();
+  }
+  NSImageSymbolConfiguration* configuration = [NSImageSymbolConfiguration
+      configurationWithPointSize:size
+                          weight:NSFontWeightRegular];
+  NSImage* sized = [symbol imageWithSymbolConfiguration:configuration];
+  if (!sized) {
+    return gfx::ImageSkia();
+  }
+  // A symbol is a template, black on clear: keep its shape, take the colour.
+  const gfx::ImageSkia mask = gfx::ImageSkiaFromNSImage(sized);
+  if (mask.isNull()) {
+    return gfx::ImageSkia();
+  }
+  return gfx::ImageSkiaOperations::CreateColorMask(mask, color);
+}
+
+}  // namespace stedding
