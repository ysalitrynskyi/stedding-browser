+
+import {html} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import type {SettingsSteddingRoutesCardElement} from './stedding_routes_card.js';
+
+export function getHtml(this: SettingsSteddingRoutesCardElement) {
+  return html`<!--_html_template_start_-->
+<div class="settings-box" id="routesIntro">
+  <div class="flex secondary">$i18n{steddingRoutesIntro}</div>
+</div>
+<div class="hr settings-box" id="externalDefault">
+  <div class="flex">
+    <div class="label">$i18n{steddingExternalDefaultLabel}</div>
+    <div class="secondary">$i18n{steddingExternalDefaultSubLabel}</div>
+  </div>
+  <settings-dropdown-menu id="externalDefaultSpace"
+      pref-key="stedding.spaces.external_default"
+      label="$i18n{steddingExternalDefaultLabel}"
+      .menuOptions="${this.externalOptions_()}">
+  </settings-dropdown-menu>
+</div>
+<div class="hr settings-box stacked" id="routeList">
+  ${this.routes_.rules.length === 0 ? html`
+    <div class="secondary" id="routesEmpty">$i18n{steddingRoutesEmpty}</div>` :
+      ''}
+  ${this.routes_.rules.map((rule, index) => html`
+    <div class="route-rule">
+      <select class="route-kind md-select" data-index="${index}"
+          aria-label="$i18n{steddingRouteKindLabel}"
+          @change="${this.onKindChange_}">
+        ${this.kindsFor_(rule).map(kind => html`
+          <option value="${kind}" .selected="${kind === rule.match}">
+            ${this.kindName_(kind)}
+          </option>`)}
+      </select>
+      <cr-input class="route-text" data-index="${index}" spellcheck="false"
+          aria-label="$i18n{steddingRouteTextLabel}"
+          .value="${rule.pattern}"
+          .invalid="${index === this.ruleErrorIndex_}"
+          .errorMessage="${index === this.ruleErrorIndex_ ? this.ruleError_ :
+                                                            ''}"
+          @change="${this.onTextChange_}">
+      </cr-input>
+      <select class="route-space md-select" data-index="${index}"
+          aria-label="$i18n{steddingRouteSpaceLabel}"
+          @change="${this.onSpaceChange_}">
+        ${!rule.spaceName ? html`
+          <option value="${rule.space}" .selected="${true}">
+            $i18n{steddingRouteNoSpace}
+          </option>` : ''}
+        ${this.routes_.spaces.map(space => html`
+          <option value="${space.id}" .selected="${space.id === rule.space}">
+            ${space.name}
+          </option>`)}
+      </select>
+      <cr-icon-button class="icon-clear route-remove" data-index="${index}"
+          title="${this.removeLabel_(rule)}"
+          aria-label="${this.removeLabel_(rule)}"
+          @click="${this.onRemoveClick_}">
+      </cr-icon-button>
+    </div>`)}
+</div>
+<div class="hr settings-box" id="routeAdd">
+  <select id="addKind" class="md-select"
+      aria-label="$i18n{steddingRouteKindLabel}"
+      @change="${this.onAddKindChange_}">
+    <option value="site" .selected="${this.addKind_ === 'site'}">
+      $i18n{steddingRouteKindSite}
+    </option>
+    <option value="contains" .selected="${this.addKind_ === 'contains'}">
+      $i18n{steddingRouteKindContains}
+    </option>
+  </select>
+  <cr-input id="addText" spellcheck="false"
+      placeholder="${this.addPlaceholder_()}"
+      aria-label="${this.addPlaceholder_()}"
+      .invalid="${!!this.addError_}"
+      .errorMessage="${this.addError_}"
+      @keydown="${this.onAddKeydown_}">
+  </cr-input>
+  <select id="addSpace" class="md-select"
+      aria-label="$i18n{steddingRouteSpaceLabel}"
+      @change="${this.onAddSpaceChange_}">
+    ${this.routes_.spaces.map(space => html`
+      <option value="${space.id}"
+          .selected="${space.id === this.chosenSpace_()}">
+        ${space.name}
+      </option>`)}
+  </select>
+  <cr-button id="addRoute" @click="${this.onAddClick_}">
+    $i18n{steddingRouteAdd}
+  </cr-button>
+</div>
+<!--_html_template_end_-->`;
+}
