 using InsecureDownloadStatus = download::DownloadItem::InsecureDownloadStatus;
 
+namespace {
+
+// Stedding, Pn19: a finished download whose file is still where it was put,
+// the one Move to Trash may take.
+download::DownloadItem* SteddingFinishedFile(DownloadUIModel* download) {
+  download::DownloadItem* const item =
+      download ? download->GetDownloadItem() : nullptr;
+  if (!item || item->GetState() != download::DownloadItem::COMPLETE ||
+      item->GetFileExternallyRemoved() || item->GetTargetFilePath().empty()) {
+    return nullptr;
+  }
+  return item;
+}
+
+// Pn9: Remove from List where the profile may delete history.
+bool SteddingMayRemove(DownloadUIModel* download) {
+  download::DownloadItem* const item =
+      download ? download->GetDownloadItem() : nullptr;
+  content::BrowserContext* const context =
+      item ? content::DownloadItemUtils::GetBrowserContext(item) : nullptr;
+  return context &&
+         Profile::FromBrowserContext(context)->GetPrefs()->GetBoolean(
+             prefs::kAllowDeletingBrowserHistory);
+}
+
+bool IsSteddingCommand(int command_id) {
+  return command_id == DownloadUiContextMenu::kSteddingMoveToTrash ||
+         command_id == DownloadUiContextMenu::kSteddingRemoveFromList;
+}
+
+}  // namespace
+
 DownloadUiContextMenu::~DownloadUiContextMenu() {
   DetachFromDownloadItem();
 }
@@ -91,6 +131,12 @@ ui::SimpleMenuModel* DownloadUiContextMenu::GetMenuModel() {
 }
 
 bool DownloadUiContextMenu::IsCommandIdEnabled(int command_id) const {
+  if (command_id == kSteddingMoveToTrash) {
+    return SteddingFinishedFile(download_.get()) != nullptr;
+  }
+  if (command_id == kSteddingRemoveFromList) {
+    return download_ && download_->GetDownloadItem();
+  }
   if (!download_commands_) {
