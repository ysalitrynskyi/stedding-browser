+
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_DARK_PAGES));
+  EXPECT_FALSE(stedding::DarkPagesOn(profile));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !rows->dark_pages()->GetIsOn() &&
+           !rows->dark_site_row()->GetVisible();
+  })) << "the chord pressed with the panel open, the rows did not follow";
+  ClosePanel();
+}
