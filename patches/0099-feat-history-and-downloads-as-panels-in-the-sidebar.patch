+void VerticalTabStripRegionView::VisibilityChanged(views::View* starting_from,
+                                                   bool is_visible) {
+  BaseTabStripRegionView::VisibilityChanged(starting_from, is_visible);
+  if (!is_visible && sidebar_panels_) {
+    sidebar_panels_->Close();
+  }
+}
+
+// static
+int VerticalTabStripRegionView::OpenWidthOf(const BrowserView* browser_view,
+                                            int user_width) {
+  const VerticalTabStripRegionView* const strip = StripOf(browser_view);
+  return stedding::SidebarOpenWidth(
+      user_width, strip && strip->sidebar_panel_view_ != nullptr);
+}
+
+bool VerticalTabStripRegionView::CanKeepSidebarPanel() const {
+  return browser_view() && browser_view()->ShouldDrawVerticalTabStrip() &&
+         GetVisible() && tab_strip_view();
+}
+
+bool VerticalTabStripRegionView::CanOpenSidebarPanel() const {
+  // sidebar panels Pn4: not in the middle of a drag of the sidebar's edge,
+  // whose end saves the width the strip is drawn at.
+  return CanKeepSidebarPanel() && !resize_area_->is_resizing();
+}
+
+void VerticalTabStripRegionView::OnSidebarPanelChanged(
+    stedding::SidebarPanel previous,
+    stedding::SidebarPanel now) {
+  // The close can come from the panel's own page -- its close button,
+  // Escape, Open as Page -- whose message handler is still running; the
+  // view it would drop owns that handler.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&VerticalTabStripRegionView::ApplySidebarPanel,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void VerticalTabStripRegionView::OnSidebarPanelsEnabledChanged(bool enabled) {
+  // sidebar panels Pn14: off, the History button is not drawn.
+  if (history_button_) {
+    history_button_->SetVisible(enabled);
+  }
+  if (bottom_row_) {
+    bottom_row_->InvalidateLayout();
+  }
+}
+
+void VerticalTabStripRegionView::ApplySidebarPanel() {
+  const stedding::SidebarPanel want = sidebar_panels_
+                                          ? sidebar_panels_->open()
+                                          : stedding::SidebarPanel::kNone;
+  const stedding::SidebarPanel have = sidebar_panel_view_
+                                          ? sidebar_panel_view_->panel()
+                                          : stedding::SidebarPanel::kNone;
+  if (want == have) {
+    return;
+  }
+  views::FocusManager* const focus_manager = GetFocusManager();
+  const bool panel_had_focus =
+      sidebar_panel_view_ && focus_manager &&
+      sidebar_panel_view_->Contains(focus_manager->GetFocusedView());
+  if (sidebar_panel_view_) {
+    content_area_view_->RemoveChildViewT(
+        std::exchange(sidebar_panel_view_, nullptr));
+  }
+
+  if (want != stedding::SidebarPanel::kNone) {
+    // Pn1: in the tab list's place, between the top row and the foot; the
+    // Archived row, the update pill and the bottom row stay.
+    auto view = std::make_unique<stedding::SidebarPanelView>(
+        *browser_view()->browser(), want,
+        base::BindRepeating(
+            [](base::WeakPtr<VerticalTabStripRegionView> self) {
+              if (self && self->sidebar_panels_) {
+                self->sidebar_panels_->Close();
+              }
+            },
+            weak_factory_.GetWeakPtr()));
+    view->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    const std::optional<size_t> spacer =
+        content_area_view_->GetIndexOf(bottom_button_container_);
+    sidebar_panel_view_ = content_area_view_->AddChildViewAt(
+        std::move(view),
+        spacer.value_or(content_area_view_->children().size()));
+    if (want == stedding::SidebarPanel::kDownloads) {
+      // Pn2: the panel shows the downloads, as the bubble would: the
+      // button's finished state and the bubble that opened by itself go,
+      // as a press for the bubble takes them (toolbar T27).
+      if (auto* const download_ui =
+              DownloadToolbarUIController::From(browser_view()->browser())) {
+        download_ui->HideDetails();
+        if (DownloadDisplayController* const display =
+                download_ui->display_controller()) {
+          display->OnButtonPressed();
+        }
+      }
+    }
+  }
+
+  const bool open = sidebar_panel_view_ != nullptr;
+  if (tab_strip_view()) {
+    tab_strip_view()->SetVisible(!open);
+  }
+  // The spacer that keeps the foot at the bottom; the panel fills it now.
+  bottom_button_container_->SetVisible(!open);
+  // Pn4: a rail or a hidden sidebar slides out over the page and stays out
+  // while a panel is open.
+  if (open && !sidebar_panel_lock_) {
+    sidebar_panel_lock_ =
+        GetExpandOnHoverLock(ExpandOnHoverLockType::kKeepExpanded);
+  } else if (!open) {
+    sidebar_panel_lock_.reset();
+  }
+  // Pn4: the width the open sidebar is drawn at (CalculatePreferredSize).
+  PreferredSizeChanged();
+  InvalidateLayout();
+  if (browser_view()) {
+    browser_view()->InvalidateLayout();
+  }
+#if BUILDFLAG(IS_MAC)
+  // The Mac's glass behind the strip asks its width again (OpenWidthOf)
+  // when the strip's resizing changes; nothing else tells it of a width the
+  // user did not set.
+  if (!state_controller_->IsResizing()) {
+    state_controller_->SetIsResizing(true);
+    state_controller_->SetIsResizing(false);
+  }
+#endif
+
+  // Pn5: the new panel's search field takes the focus; a closed panel gives
+  // it back to the page, from wherever in the sidebar it went as the panel
+  // left. Kept in the sidebar, it held a rail the panel had slid out open
+  // (Pn4): the strip stays out while it has the focus.
+  if (open) {
+    sidebar_panel_view_->web_view()->RequestFocus();
+  } else if ((panel_had_focus ||
+              (focus_manager && Contains(focus_manager->GetFocusedView()))) &&
+             browser_view()->multi_contents_view()) {
+    if (ContentsWebView* const page =
+            browser_view()->multi_contents_view()->GetActiveContentsView()) {
+      page->RequestFocus();
+      UpdateExpandOnHoverState();
+    }
+  }
+}
+
+void VerticalTabStripRegionView::NudgeDownloadsButton() {
+  // Pn13: up 4 DIP and back, twice, in 320 ms. The button paints to a layer
+  // of its own (TopContainerButton); stedding::DownloadsNudge has asked
+  // motion O1 already.
+  if (!downloads_button_ || !downloads_button_->IsDrawn() ||
+      !downloads_button_->layer()) {
+    return;
+  }
+  ui::Layer* const layer = downloads_button_->layer();
+  gfx::Transform up;
+  up.Translate(0, -kNudgeRise);
+  views::AnimationBuilder()
+      .SetPreemptionStrategy(
+          ui::LayerAnimator::PreemptionStrategy::IMMEDIATELY_SET_NEW_TARGET)
+      .Once()
+      .SetDuration(kNudgeStep)
+      .SetTransform(layer, up, gfx::Tween::EASE_OUT)
+      .Then()
+      .SetDuration(kNudgeStep)
+      .SetTransform(layer, gfx::Transform(), gfx::Tween::EASE_IN)
+      .Then()
+      .SetDuration(kNudgeStep)
+      .SetTransform(layer, up, gfx::Tween::EASE_OUT)
+      .Then()
+      .SetDuration(kNudgeStep)
+      .SetTransform(layer, gfx::Transform(), gfx::Tween::EASE_IN);
+}
