+// import I34, I36, I41: the archive chosen with Choose File... on the welcome
+// flow is summed up before anything comes in: what it holds, that cards do
+// not come in, and Passwords unticked.
+IN_PROC_BROWSER_TEST_F(SafariExportImportTest, AChosenArchiveIsSummarised) {
+  content::WebContents* const page = OpenWelcomeImportStep(*browser());
+  ASSERT_TRUE(page);
+  ChooseExport(page);
+  EXPECT_EQ(
+      "In the file: 2 bookmarks, history and 2 passwords. Payment cards in the "
+      "file are not imported.",
+      State(page, "safari.summary"));
+  EXPECT_EQ("true", State(page, "safari.ready"));
+  EXPECT_FALSE(
+      content::EvalJs(
+          page,
+          "document.querySelector('[data-focus=\"safari-passwords\"]').checked")
+          .ExtractBool())
+      << "Passwords started ticked";
+  EXPECT_TRUE(content::EvalJs(page,
+                              "document.querySelector('[data-focus="
+                              "\"safari-bookmarks\"]').checked")
+                  .ExtractBool());
+  EXPECT_FALSE(Bookmarks()->IsBookmarked(GURL(kFavorite)))
+      << "the summary brought something in";
+}
+
+// import I36, I37, I38, I39, I41: Import with Passwords unticked brings the
+// bookmarks into "Imported from Safari" (Favorites a folder in it) and the
+// visit, but not the redirect hop and no login; the line says why.
+IN_PROC_BROWSER_TEST_F(SafariExportImportTest, PasswordsStayOutUntilTicked) {
+  content::WebContents* const page = OpenWelcomeImportStep(*browser());
+  ASSERT_TRUE(page);
+  ChooseExport(page);
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "document.querySelector('[data-focus=\"safari-import\"]').click()"));
+  std::string line;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    line = State(page, "safariStatus");
+    return !line.empty() && line != "inProgress";
+  })) << "the import never ended";
+  EXPECT_EQ(
+      "Brought in from Safari: 2 bookmarks and 1 history entry. Passwords "
+      "were left out: tick Passwords to bring them in. Payment cards are not "
+      "imported.",
+      line);
+  EXPECT_EQ(1u, FoldersNamed(u"Imported from Safari"));
+  EXPECT_TRUE(Bookmarks()->IsBookmarked(GURL(kFavorite)));
+  EXPECT_TRUE(Bookmarks()->IsBookmarked(GURL(kLoose)));
+  const bookmarks::BookmarkNode* const favorite =
+      Bookmarks()->GetMostRecentlyAddedUserNodeForURL(GURL(kFavorite));
+  ASSERT_TRUE(favorite);
+  EXPECT_EQ(u"Favorites", favorite->parent()->GetTitle());
+  EXPECT_EQ(1u, VisitsTo(GURL(kSeen)));
+  EXPECT_EQ(0u, VisitsTo(GURL(kHop))) << "a redirect hop came in as a visit";
+  EXPECT_FALSE(PasswordFor(browser()->GetProfile(),
+                           "https://safari-login.example/", u"ann"));
+}
