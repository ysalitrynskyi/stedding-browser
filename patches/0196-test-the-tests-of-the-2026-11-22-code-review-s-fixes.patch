+// P31-1f; commandbar K4. The browser's own pages and the search engine's
+// suggested sites are navigation suggestions, not pages from history:
+// "chrome://fl" listed chrome://flags, and "faceb" a site the profile never
+// opened, labelled History. They read Open; a page from history still reads
+// History.
+TEST_F(CommandBarW2B23Test, ASuggestedPageIsNotLabelledHistory) {
+  AddTab(browser(), GURL("https://example.com/"));
+  auto bar = std::make_unique<CommandBarView>(browser());
+
+  TypeIntoW2B23(*bar, u"chrome://fl");
+  bar->SetAutocompleteResultForTesting(ResultOfW2B23(
+      {MatchW2B23(omnibox::AutocompleteMatchType::kNavsuggest,
+                  GURL("chrome://flags/"), u"chrome://flags", u"")}));
+  {
+    SCOPED_TRACE("the rows:" + JoinedW2B23(TitlesW2B23(*bar)));
+    const size_t row = RowIndexW2B23(*bar, u"chrome://flags");
+    ASSERT_LT(row, bar->row_count_for_testing())
+        << "the browser's page is not listed";
+    EXPECT_EQ(u"Open", bar->row_detail_for_testing(row));
+  }
+
+  TypeIntoW2B23(*bar, u"faceb");
+  bar->SetAutocompleteResultForTesting(ResultOfW2B23(
+      {MatchW2B23(omnibox::AutocompleteMatchType::kNavsuggest,
+                  GURL("https://www.facebook.com/"), u"facebook.com",
+                  u"Facebook"),
+       MatchW2B23(omnibox::AutocompleteMatchType::kHistoryUrl,
+                  GURL("https://facebook-visited.example/"),
+                  u"facebook-visited.example", u"")}));
+  {
+    SCOPED_TRACE("the rows:" + JoinedW2B23(TitlesW2B23(*bar)));
+    const size_t suggested =
+        RowEndingWithW2B23(*bar, u"  \u00B7  facebook.com");
+    ASSERT_LT(suggested, bar->row_count_for_testing())
+        << "the engine's suggested site is not listed";
+    EXPECT_EQ(u"Open", bar->row_detail_for_testing(suggested));
+    const size_t visited = RowIndexW2B23(*bar, u"facebook-visited.example");
+    ASSERT_LT(visited, bar->row_count_for_testing())
+        << "the page from history is not listed";
+    EXPECT_EQ(u"History", bar->row_detail_for_testing(visited));
+  }
+}
