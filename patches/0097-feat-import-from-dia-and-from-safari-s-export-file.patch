+// import I30, I38 (BACKLOG S-346): a visit dated ahead of now is not added,
+// whatever imports it: the history lists it as the newest page and its
+// expiry, which looks only for visits too old, never drops it.
+TEST(ImportedHistoryTest, AVisitDatedAheadIsNotAdded) {
+  content::BrowserTaskEnvironment task_environment;
+  TestingProfile::Builder builder;
+  builder.AddTestingFactory(HistoryServiceFactory::GetInstance(),
+                            HistoryServiceFactory::GetDefaultFactory());
+  std::unique_ptr<TestingProfile> profile = builder.Build();
+  history::HistoryService* const history =
+      HistoryServiceFactory::GetForProfile(profile.get(),
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  ASSERT_TRUE(history);
+  const base::Time now = base::Time::Now();
+  history::URLRows rows;
+  history::URLRow ahead(GURL("https://ahead.example/"));
+  ahead.set_title(u"Ahead");
+  ahead.set_visit_count(1);
+  ahead.set_last_visit(now + base::Days(3 * 365));
