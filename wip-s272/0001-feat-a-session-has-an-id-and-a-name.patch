 #include "chrome/browser/ui/stedding/stedding_prefs.h"
 #include "components/prefs/pref_service.h"
 
 namespace spaces {
 
+namespace {
+
+// sessions S37: the longest name the sessions list keeps, in UTF-16 units.
+constexpr size_t kMaxSessionName = 64;
+
+}  // namespace
+
 RegistryEntry::RegistryEntry(SpaceId id, std::string name, SkColor color)
     : id(id), name(std::move(name)), color(color) {}
 RegistryEntry::RegistryEntry(const RegistryEntry& other) = default;
 RegistryEntry& RegistryEntry::operator=(const RegistryEntry& other) = default;
 RegistryEntry::~RegistryEntry() = default;
 
+SessionEntry::SessionEntry() = default;
+SessionEntry::SessionEntry(const SessionEntry& other) = default;
+SessionEntry& SessionEntry::operator=(const SessionEntry& other) = default;
+SessionEntry::~SessionEntry() = default;
+
 SpaceRegistry::SpaceRegistry(PrefService* prefs) : prefs_(prefs) {
   if (prefs_) {
     entries_ = FromValue(prefs_->GetList(stedding::prefs::kSpaceRegistry));
   }
+  // sessions S37: a test's PrefService may have only the Space list.
+  if (prefs_ && prefs_->FindPreference(stedding::prefs::kSpaceSessions)) {
+    for (const base::Value& item :
+         prefs_->GetList(stedding::prefs::kSpaceSessions)) {
+      const base::DictValue* const dict = item.GetIfDict();
+      const std::string* const id = dict ? dict->FindString("id") : nullptr;
+      const std::string* const name = dict ? dict->FindString("name") : nullptr;
+      if (id && name && base::Token::FromString(*id) && !HasSessionRow(*id)) {
+        session_rows_.push_back({*id, *name});
+      }
+    }
+  }
 }
 
 SpaceRegistry::~SpaceRegistry() = default;
@@ -170,6 +200,191 @@ void SpaceRegistry::SetIsolated(const SpaceId& id, bool isolated) {
   }
 }
 
+std::vector<SessionEntry> SpaceRegistry::Sessions() const {
+  std::vector<SessionEntry> sessions;
+  for (const RegistryEntry& entry : entries_) {
+    if (entry.profile_id.empty()) {
+      continue;
+    }
+    auto it = std::ranges::find_if(sessions, [&](const SessionEntry& session) {
+      return session.id == entry.profile_id;
+    });
+    if (it == sessions.end()) {
+      SessionEntry& session = sessions.emplace_back();
+      session.id = entry.profile_id;
+      session.name = SessionNameOf(entry.profile_id);
+      session.has_row = HasSessionRow(entry.profile_id);
+      it = sessions.end() - 1;
+    }
+    it->spaces.push_back(entry.id);
+  }
+  // sessions S43: a session no Space uses is a row alone.
+  for (const SessionRow& row : session_rows_) {
+    if (std::ranges::none_of(sessions, [&](const SessionEntry& session) {
+          return session.id == row.id;
+        })) {
+      SessionEntry& session = sessions.emplace_back();
+      session.id = row.id;
+      session.name = row.name;
+      session.has_row = true;
+    }
+  }
+  return sessions;
+}
+
+std::optional<SessionEntry> SpaceRegistry::FindSession(
+    std::string_view id) const {
+  for (SessionEntry& session : Sessions()) {
+    if (session.id == id) {
+      return std::move(session);
+    }
+  }
+  return std::nullopt;
+}
+
+bool SpaceRegistry::NamesJar(std::string_view jar) const {
+  return !jar.empty() &&
+         std::ranges::any_of(entries_, [&](const RegistryEntry& entry) {
+           return entry.profile_id == jar;
+         });
+}
+
+bool SpaceRegistry::ANameOtherThan(const SpaceId& except,
+                                   std::string_view jar) const {
+  return !jar.empty() &&
+         std::ranges::any_of(entries_, [&](const RegistryEntry& entry) {
+           return entry.id != except && entry.profile_id == jar;
+         });
+}
+
+bool SpaceRegistry::HasSessionRow(std::string_view id) const {
+  return std::ranges::any_of(
+      session_rows_, [&](const SessionRow& row) { return row.id == id; });
+}
+
+std::string SpaceRegistry::AddSession(std::string_view name) {
+  std::string id = base::Token::CreateRandom().ToString();
+  AddSessionRow(id, std::string(name));
+  WriteSessions();
+  observers_.Notify(&Observer::OnRegistryChanged);
+  return id;
+}
+
+void SpaceRegistry::EnsureSessionRow(const std::string& id,
+                                     std::string_view name) {
+  // S50, S51: an id from a file is taken only if it is a token, as a window's
+  // session is (S2).
+  if (!base::Token::FromString(id) || HasSessionRow(id)) {
+    return;
+  }
+  AddSessionRow(id, std::string(name));
+  WriteSessions();
+  observers_.Notify(&Observer::OnRegistryChanged);
+}
+
+void SpaceRegistry::ForgetSession(std::string_view id) {
+  if (std::erase_if(session_rows_, [&](const SessionRow& row) {
+        return row.id == id;
+      }) > 0) {
+    WriteSessions();
+    observers_.Notify(&Observer::OnRegistryChanged);
+  }
+}
+
+void SpaceRegistry::SetSession(const SpaceId& id, const std::string& session) {
+  RegistryEntry* const entry = FindMutable(id);
+  if (!entry) {
+    return;
+  }
+  // S7: Shared keeps the token, and the Space still names the jar.
+  if (session.empty()) {
+    SetIsolated(id, false);
+    return;
+  }
+  if (entry->profile_id == session) {
+    EnsureIsolated(id);
+    return;
+  }
+  // S43: the last Space to leave leaves the session its name, which until now
+  // it may have had from this Space.
+  const std::string left = entry->profile_id;
+  if (!left.empty() && !ANameOtherThan(id, left) && !HasSessionRow(left)) {
+    AddSessionRow(left, SessionNameOf(left));
+  }
+  // S37: a second Space joining writes down the name the session has.
+  if (!HasSessionRow(session)) {
+    if (const std::string name = SessionNameOf(session); !name.empty()) {
+      AddSessionRow(session, name);
+    }
+  }
+  entry->profile_id = session;
+  entry->isolated = true;
+  WriteSessions();
+  Changed();
+}
+
+std::string SpaceRegistry::SessionNameOf(std::string_view id) const {
+  const auto row = std::ranges::find_if(
+      session_rows_, [&](const SessionRow& each) { return each.id == id; });
+  if (row != session_rows_.end()) {
+    return row->name;
+  }
+  for (size_t i = 0; i < entries_.size(); ++i) {
+    if (entries_[i].profile_id == id) {
+      // As SpaceModel::DisplayName names a Space never named.
+      return entries_[i].name.empty()
+                 ? "Space " + base::NumberToString(i + 1)
+                 : entries_[i].name;
+    }
+  }
+  return std::string();
+}
+
+std::string SpaceRegistry::FitSessionName(std::string_view id,
+                                          std::string_view name) const {
+  std::u16string text = NameInSentence(base::UTF8ToUTF16(name));
+  if (text.empty()) {
+    text = u"Session";
+  }
+  if (text.size() > kMaxSessionName) {
+    // Not in the middle of a character outside the basic plane.
+    const bool split = CBU16_IS_LEAD(text[kMaxSessionName - 1]);
+    text.resize(split ? kMaxSessionName - 1 : kMaxSessionName);
+  }
+  const std::vector<SessionEntry> sessions = Sessions();
+  const auto taken = [&](const std::u16string& candidate) {
+    const std::u16string folded = base::i18n::FoldCase(candidate);
+    return std::ranges::any_of(sessions, [&](const SessionEntry& session) {
+      return session.id != id &&
+             base::i18n::FoldCase(base::UTF8ToUTF16(session.name)) == folded;
+    });
+  };
+  std::u16string fitted = text;
+  for (int number = 2; taken(fitted); ++number) {
+    fitted = base::StrCat({text, u" ", base::NumberToString16(number)});
+  }
+  return base::UTF16ToUTF8(fitted);
+}
+
+void SpaceRegistry::AddSessionRow(std::string id, std::string name) {
+  std::string fitted = FitSessionName(id, name);
+  session_rows_.push_back({std::move(id), std::move(fitted)});
+}
+
+void SpaceRegistry::WriteSessions() {
+  if (!prefs_ || !prefs_->FindPreference(stedding::prefs::kSpaceSessions)) {
+    return;
+  }
+  base::ListValue list;
+  for (const SessionRow& row : session_rows_) {
+    base::DictValue dict;
+    dict.Set("id", row.id);
+    dict.Set("name", row.name);
+    list.Append(std::move(dict));
+  }
+  prefs_->SetList(stedding::prefs::kSpaceSessions, std::move(list));
+}
+
 void SpaceRegistry::AddObserver(Observer* observer) {
   observers_.AddObserver(observer);
 }
