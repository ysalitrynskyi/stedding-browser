+
+namespace {
+
+class CommandBarB23Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  BrowserView* WindowViewB23() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  // The window's open bar, looked up again each time: the bar closes when
+  // the window loses the focus, and a pointer kept across a wait would
+  // dangle.
+  stedding::CommandBarView* OpenBarNowB23() {
+    return stedding::CommandBarView::GetOpenBar(WindowViewB23());
+  }
+
+  // Cmd-T, through the window's command.
+  stedding::CommandBarView* OpenBarB23() {
+    chrome::ExecuteCommand(browser(), IDC_NEW_TAB);
+    return OpenBarNowB23();
+  }
+
+  static void TypeB23(stedding::CommandBarView* bar,
+                      const std::u16string& text) {
+    bar->field_for_testing()->SetText(text);
+    bar->ContentsChanged(bar->field_for_testing(), text);
+  }
+
+  // Return as the bar's field receives it. Through views::View, where the
+  // handler is public.
+  static void PressReturnB23(stedding::CommandBarView* bar) {
+    views::View* const field = bar->field_for_testing();
+    field->OnKeyPressed(ui::KeyEvent(ui::EventType::kKeyPressed,
+                                     ui::VKEY_RETURN, ui::EF_NONE));
+  }
+
+  // A search engine on the test server, made the default, so a search typed
+  // in the bar loads a page of the test server.
+  void UseTestServerSearchEngineB23() {
+    TemplateURLService* const engines =
+        TemplateURLServiceFactory::GetForProfile(browser()->GetProfile());
+    ASSERT_TRUE(engines);
+    search_test_utils::WaitForTemplateURLServiceToLoad(engines);
+    TemplateURLData data;
+    data.SetShortName(u"Finder");
+    data.SetKeyword(u"finder.test");
+    // Built as text: a GURL would escape the braces of {searchTerms}.
+    data.SetURL("http://search.test:" +
+                base::NumberToString(embedded_test_server()->port()) +
+                "/search?q={searchTerms}");
+    TemplateURL* const engine =
+        engines->Add(std::make_unique<TemplateURL>(data));
+    ASSERT_TRUE(engine);
+    engines->SetUserSelectedDefaultSearchProvider(engine);
+    ASSERT_EQ(engine, engines->GetDefaultSearchProvider());
+  }
+
+  // The tab whose address holds `part`, or null.
+  tabs::TabInterface* TabShowingB23(const std::string& part) {
+    TabStripModel* const tabs = browser()->GetTabStripModel();
+    for (int i = 0; i < tabs->count(); ++i) {
+      tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+      if (tab->GetContents()->GetVisibleURL().spec().find(part) !=
+          std::string::npos) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+};
+
+// P31-1a; commandbar K1. The bar is open, its field focused, and the window
+// stops being the active one (another app, another window). The focus
+// manager clears the focus before it tells the bar, so the bar closed
+// without handing the focus back to the page, and the view the window keeps
+// to focus again was the bar's own field, gone a turn later. Back in the
+// window, no view had the focus: typing, Space and the arrows reached no
+// page until a click. The page has the focus again.
+IN_PROC_BROWSER_TEST_F(CommandBarB23Test,
+                       ThePageHasTheFocusWhenTheWindowIsActiveAgain) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+  BrowserView* const view = WindowViewB23();
+  views::WebView* const contents = view->GetActiveContentsWebView();
+  ASSERT_TRUE(contents);
+  contents->RequestFocus();
+  ASSERT_TRUE(contents->HasFocus()) << "the page takes no focus here";
+
+  stedding::CommandBarView* const bar = OpenBarB23();
+  ASSERT_TRUE(bar) << "Cmd-T opened no bar";
+  ASSERT_TRUE(bar->field_for_testing()->HasFocus())
+      << "the bar's field has no focus";
+
+  views::FocusManager* const focus = view->GetWidget()->GetFocusManager();
+  ASSERT_TRUE(focus);
+  // What the window does when it stops being the active window: it keeps
+  // the focused view to focus again later, and clears the focus.
+  focus->StoreFocusedView(/*clear_native_focus=*/false);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !OpenBarNowB23(); }))
+      << "the bar stayed open after the window lost the focus";
+  EXPECT_EQ(contents, focus->GetStoredFocusView())
+      << "the window keeps no view to focus when it is active again";
+
+  // What the window does when it is the active window again.
+  focus->RestoreFocusedView();
+  EXPECT_TRUE(contents->HasFocus())
+      << "no view has the focus: keys reach no page until a click";
+}
+
+// P09-1a; routing D11. A rule "Address contains: jira" sends Work's pages
+// there. A search typed in Cmd-T's bar holds the words searched for in its
+// address, and was sent as a typed address: "jira alternatives" was filed
+// in Work and made in Work's jar, where the same search from the address
+// row stays in Home. A search follows no "contains" rule; a typed address
+// with the word in it still does.
+IN_PROC_BROWSER_TEST_F(CommandBarB23Test, ASearchInTheBarFollowsNoContainsRule) {
+  ASSERT_NO_FATAL_FAILURE(UseTestServerSearchEngineB23());
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  spaces::Route contains;
+  contains.match = spaces::Route::Match::kContains;
+  contains.pattern = "jira";
+  contains.space = work.ToString();
+  spaces::AddRoute(browser()->GetProfile()->GetPrefs(), contains);
+  // A page, so Cmd-T's bar opens what it runs in a new tab (K21).
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+
+  {
+    SCOPED_TRACE("a search");
+    stedding::CommandBarView* const bar = OpenBarB23();
+    ASSERT_TRUE(bar) << "Cmd-T opened no bar";
+    TypeB23(bar, u"jira alternatives");
+    ASSERT_GT(bar->row_count_for_testing(), 0u);
+    ASSERT_EQ(u"Search", bar->row_detail_for_testing(0));
+    const int count = tabs->count();
+    PressReturnB23(bar);
+    ASSERT_EQ(count + 1, tabs->count()) << "the search opened no tab";
+    tabs::TabInterface* const searched = TabShowingB23("q=jira");
+    ASSERT_TRUE(searched) << "no tab holds the search";
+    EXPECT_EQ(home, model->FindSpaceForTab(searched))
+        << "the search was filed in the Space a contains rule names";
+    EXPECT_EQ(home, model->active_id()) << "the window switched Spaces";
+  }
+
+  {
+    SCOPED_TRACE("a typed address");
+    if (stedding::CommandBarView* const open = OpenBarNowB23()) {
+      open->Close();
+    }
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !OpenBarNowB23(); }));
+    stedding::CommandBarView* const bar = OpenBarB23();
+    ASSERT_TRUE(bar) << "Cmd-T opened no bar";
+    const GURL address =
+        embedded_test_server()->GetURL("jira.test", "/title2.html");
+    TypeB23(bar, base::UTF8ToUTF16(address.spec()));
+    ASSERT_GT(bar->row_count_for_testing(), 0u);
+    ASSERT_EQ(u"Open", bar->row_detail_for_testing(0));
+    const int count = tabs->count();
+    PressReturnB23(bar);
+    ASSERT_EQ(count + 1, tabs->count()) << "the address opened no tab";
+    tabs::TabInterface* const typed = TabShowingB23("jira.test");
+    ASSERT_TRUE(typed) << "no tab holds the address";
+    EXPECT_EQ(work, model->FindSpaceForTab(typed))
+        << "a typed address no longer follows the rule";
+  }
+}
