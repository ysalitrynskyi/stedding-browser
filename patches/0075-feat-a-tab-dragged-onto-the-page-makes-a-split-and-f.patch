+// splits J10-J15 (BACKLOG S-113, GitHub issue 7): a tab dragged onto the
+// page makes a split. The page's halves, on screen, and the points at their
+// middles.
+struct PageHalves {
+  gfx::Rect page;
+  gfx::Point left;
+  gfx::Point right;
+};
+
+PageHalves HalvesOf(BrowserView* browser_view) {
+  const gfx::Rect page =
+      browser_view->multi_contents_view()->GetBoundsInScreen();
+  return {page, gfx::Point(page.x() + page.width() / 4, page.CenterPoint().y()),
+          gfx::Point(page.x() + 3 * page.width() / 4, page.CenterPoint().y())};
+}
+
+// The pointer, its button down, moves from `from` to `to` in twelve steps.
+void MoveWithTheButtonDown(views::Widget* widget,
+                           const gfx::Point& from,
+                           const gfx::Point& to) {
+  for (int step = 1; step <= 12; ++step) {
+    stedding::test::SendLeftMouse(
+        widget, ui::EventType::kMouseDragged,
+        gfx::Point(from.x() + (to.x() - from.x()) * step / 12,
+                   from.y() + (to.y() - from.y()) * step / 12));
+  }
+  base::RunLoop().RunUntilIdle();
+}
+
+// splits J10, J13, J15: a row dragged over the page lights the half under
+// the pointer, left or right, in the Space's colour, and the page that was on
+// screen when the drag began is on screen again. The light follows the
+// pointer from half to half and goes once the pointer is back in the
+// sidebar, where the dragged row is on screen again. The row on screen
+// dragged onto its own page, an essential and a selection of two light
+// nothing and open no window. Chrome's "split view drag and drop" switch
+// turns the page's target off.
+IN_PROC_BROWSER_TEST_F(TabDropTest, ARowOverThePageLightsTheHalfUnderIt) {
+  tabs::TabInterface* const dragged = Open("dragged.test");
+  tabs::TabInterface* const other = Open("other.test");
+  tabs::TabInterface* const shown = Open("shown.test");
+  ASSERT_TRUE(ShownWhole({dragged, other, shown}))
+      << "the window is too short for the test's rows";
+  spaces::PageSplitDragTarget* const target =
+      spaces::PageSplitDragTarget::From(browser());
+  ASSERT_TRUE(target);
+  const PageHalves halves = HalvesOf(browser_view());
+  const gfx::Point from = RowCentre(dragged);
+
+  PressAndMove(from, halves.left);
+  {
+    SCOPED_TRACE("the left half");
+    EXPECT_EQ(stedding::SplitDropSide::kStart, target->lit_side());
+    const gfx::Rect lit = target->GetHighlightBoundsInScreenForTesting();
+    EXPECT_FALSE(lit.IsEmpty()) << "nothing is lit";
+    EXPECT_GE(lit.x(), halves.page.x());
+    EXPECT_LE(lit.right(), halves.page.CenterPoint().x());
+    EXPECT_EQ(shown, tab_strip_model()->GetActiveTab())
+        << "the page the row would join is not on screen";
+    EXPECT_EQ(shown->GetContents(), browser_view()->GetActiveWebContents());
+    EXPECT_EQ(1u, WindowCount()) << "a window tore off over the page";
+  }
+  MoveWithTheButtonDown(widget(), halves.left, halves.right);
+  {
+    SCOPED_TRACE("the right half");
+    EXPECT_EQ(stedding::SplitDropSide::kEnd, target->lit_side());
+    const gfx::Rect lit = target->GetHighlightBoundsInScreenForTesting();
+    EXPECT_FALSE(lit.IsEmpty()) << "nothing is lit";
+    EXPECT_GE(lit.x(), halves.page.CenterPoint().x());
+    EXPECT_LE(lit.right(), halves.page.right());
+  }
+  MoveWithTheButtonDown(widget(), halves.right, from);
+  {
+    SCOPED_TRACE("back in the sidebar");
+    EXPECT_EQ(std::nullopt, target->lit_side());
+    EXPECT_TRUE(target->GetHighlightBoundsInScreenForTesting().IsEmpty());
+    EXPECT_EQ(dragged, tab_strip_model()->GetActiveTab())
+        << "the dragged row is not on screen again";
+  }
+  Release(from);
+  EXPECT_FALSE(dragged->IsSplit());
+  EXPECT_FALSE(shown->IsSplit());
+
+  // Drags the row of `tab` over the page and drops it there.
+  const auto lights_nothing = [&](tabs::TabInterface* tab, const char* what) {
+    SCOPED_TRACE(what);
+    PressAndMove(RowCentre(tab), halves.left);
+    EXPECT_EQ(std::nullopt, target->lit_side());
+    EXPECT_TRUE(target->GetHighlightBoundsInScreenForTesting().IsEmpty());
+    EXPECT_EQ(1u, WindowCount()) << "a window tore off over the page";
+    Release(halves.left);
+    EXPECT_FALSE(tab->IsSplit()) << "the drop made a split";
+    EXPECT_EQ(1u, WindowCount());
+  };
+  tab_strip_model()->ActivateTabAt(Index(shown));
+  lights_nothing(shown, "the row on screen, onto its own page");
+  tab_strip_model()->SetTabPinned(Index(other), true);
+  tab_strip_model()->ActivateTabAt(Index(shown));
+  lights_nothing(other, "an essential");
+  tab_strip_model()->SetTabPinned(Index(other), false);
+  {
+    ui::ListSelectionModel selection;
+    selection.AddIndexToSelection(Index(dragged));
+    selection.AddIndexToSelection(Index(other));
+    selection.set_active(Index(other));
+    selection.set_anchor(Index(other));
+    tab_strip_model()->SetSelectionFromModel(selection);
+  }
+  lights_nothing(dragged, "a selection of two");
+
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(prefs::kSplitViewDragAndDropEnabled, false);
+  EXPECT_FALSE(
+      spaces::PageSplitDragTarget::ForPoint(*browser_view(), halves.left))
+      << "the switch is off";
+  prefs->SetBoolean(prefs::kSplitViewDragAndDropEnabled, true);
+  EXPECT_EQ(target, spaces::PageSplitDragTarget::ForPoint(*browser_view(),
+                                                          halves.left));
+}
+
+// splits J11: a row dropped on a half makes one split of it and the page
+// that was on screen, the dropped page on that side and active, in the
+// page's place, with nothing detached: the same tab and page, in its Space,
+// in one window. A row taken from a folder leaves it, and the folder keeps
+// its other row; a row dragged from the rail makes a split too.
+IN_PROC_BROWSER_TEST_F(TabDropTest, ARowDroppedOnThePageMakesASplitInItsPlace) {
+  tabs::TabInterface* const dragged = Open("dropped.test");
+  tabs::TabInterface* const above = Open("above.test");
+  tabs::TabInterface* const shown = Open("shown-split.test");
+  tabs::TabInterface* const below = Open("below.test");
+  tabs::TabInterface* const stays = Open("stays-in-folder.test");
+  ASSERT_TRUE(ShownWhole({dragged, above, shown, below, stays}))
+      << "the window is too short for the test's rows";
+  const Kept kept = KeptOf(dragged);
+  const spaces::SpaceId space = model()->SpaceForTab(dragged);
+  const PageHalves halves = HalvesOf(browser_view());
+  const auto panes = [&](tabs::TabInterface* tab) {
+    return tab->IsSplit()
+               ? tab_strip_model()->GetSplitData(*tab->GetSplit())->ListTabs()
+               : std::vector<tabs::TabInterface*>{tab};
+  };
+
+  {
+    SCOPED_TRACE("the left half");
+    tab_strip_model()->ActivateTabAt(Index(shown));
+    Drag(RowCentre(dragged), halves.left);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return dragged->IsSplit(); }))
+        << "the drop made no split";
+    EXPECT_EQ((std::vector<tabs::TabInterface*>{dragged, shown}),
+              panes(shown));
+    EXPECT_EQ(dragged, tab_strip_model()->GetActiveTab());
+    EXPECT_LT(Index(above), Index(dragged)) << "not in the page's place";
+    EXPECT_LT(Index(shown), Index(below));
+    ExpectKept(dragged, kept);
+    EXPECT_EQ(space, model()->SpaceForTab(dragged));
+    EXPECT_EQ(1u, WindowCount()) << "a window tore off";
+  }
+  tab_strip_model()->RemoveSplit(*shown->GetSplit());
+  {
+    SCOPED_TRACE("the right half");
+    tab_strip_model()->ActivateTabAt(Index(shown));
+    Drag(RowCentre(dragged), halves.right);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return dragged->IsSplit(); }))
+        << "the drop made no split";
+    EXPECT_EQ((std::vector<tabs::TabInterface*>{shown, dragged}),
+              panes(shown));
+    EXPECT_EQ(dragged, tab_strip_model()->GetActiveTab());
+    ExpectKept(dragged, kept);
+    EXPECT_EQ(1u, WindowCount());
+  }
+  tab_strip_model()->RemoveSplit(*shown->GetSplit());
+  {
+    SCOPED_TRACE("a folder's row onto a page outside it");
+    tabs::FolderTabCollection* const folder =
+        tab_strip_model()->AddToNewFolder({Index(below), Index(stays)});
+    ASSERT_TRUE(folder);
+    tab_strip_model()->ActivateTabAt(Index(shown));
+    ASSERT_TRUE(ShownWhole({below, shown}));
+    Drag(RowCentre(below), halves.left);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return below->IsSplit(); }))
+        << "the drop made no split";
+    EXPECT_EQ((std::vector<tabs::TabInterface*>{below, shown}), panes(shown));
+    EXPECT_FALSE(IsIn(below, folder)) << "the row stayed in its folder";
+    EXPECT_TRUE(IsIn(stays, folder));
+    EXPECT_EQ(1u, folder->TabCountRecursive());
+  }
+  tab_strip_model()->RemoveSplit(*shown->GetSplit());
+  {
+    SCOPED_TRACE("from the rail");
+    ASSERT_NO_FATAL_FAILURE(CollapseToTheRail());
+    tab_strip_model()->ActivateTabAt(Index(shown));
+    Drag(RowCentre(above), HalvesOf(browser_view()).right);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return above->IsSplit(); }))
+        << "the drop from the rail made no split";
+    EXPECT_EQ((std::vector<tabs::TabInterface*>{shown, above}), panes(shown));
+    EXPECT_EQ(1u, WindowCount());
+  }
+}
+
+// splits J12, J14: while the pointer is over the page the rows hold still,
+// whatever height it is at, and no window opens; a release where the page
+// takes no drop leaves no split and every row where it was.
+IN_PROC_BROWSER_TEST_F(TabDropTest, OverThePageTheRowsHoldStill) {
+  tabs::TabInterface* const first = Open("first.test");
+  Open("second.test");
+  tabs::TabInterface* const shown = Open("third.test");
+  Open("fourth.test");
+  tabs::TabInterface* const last = Open("fifth.test");
+  ASSERT_TRUE(ShownWhole({first, shown, last}))
+      << "the window is too short for the test's rows";
+  std::vector<tabs::TabInterface*> order;
+  for (int i = 0; i < tab_strip_model()->count(); ++i) {
+    order.push_back(tab_strip_model()->GetTabAtIndex(i));
+  }
+  const auto rows_held = [&]() {
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      if (tab_strip_model()->GetTabAtIndex(i) != order[i]) {
+        return false;
+      }
+    }
+    return true;
+  };
+  const PageHalves halves = HalvesOf(browser_view());
+  // Over the page at the height of a row.
+  const auto beside = [&](tabs::TabInterface* row) {
+    return gfx::Point(halves.left.x(),
+                      std::clamp(RowCentre(row).y(), halves.page.y() + 1,
+                                 halves.page.bottom() - 1));
+  };
+  const gfx::Point at_last = beside(last);
+  const gfx::Point at_first = beside(first);
+
+  for (tabs::TabInterface* const tab : {first, shown}) {
+    SCOPED_TRACE(tab == first ? "a row the page takes"
+                              : "the row on screen, which it does not");
+    tab_strip_model()->ActivateTabAt(Index(shown));
+    const gfx::Point from = RowCentre(tab);
+    // Straight out of the sidebar at the row's own height, where the row
+    // keeps its place, then up and down over the page.
+    const gfx::Point out = beside(tab);
+    PressAndMove(from, out);
+    EXPECT_TRUE(rows_held()) << "the row moved on its way out";
+    MoveWithTheButtonDown(widget(), out, at_last);
+    EXPECT_TRUE(rows_held()) << "the rows moved with the pointer";
+    MoveWithTheButtonDown(widget(), at_last, at_first);
+    EXPECT_TRUE(rows_held()) << "the rows moved with the pointer";
+    EXPECT_EQ(1u, WindowCount()) << "a window tore off over the page";
+    if (tab == first) {
+      // Back to its place in the sidebar for the release.
+      MoveWithTheButtonDown(widget(), at_first, from);
+      Release(from);
+    } else {
+      Release(at_first);
+    }
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_TRUE(rows_held()) << "the rows moved";
+    EXPECT_FALSE(tab->IsSplit()) << "a split was made";
+    EXPECT_EQ(1u, WindowCount());
+  }
+}
