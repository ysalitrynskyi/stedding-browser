+  // The rail itself from here on, not the sidebar it opens over the page on
+  // a hover: the Mac asks the real pointer, wherever it is.
+  tabs::VerticalTabStripStateController::From(browser())
+      ->SetExpandOnHoverEnabled(false);
+
+  {
+    SCOPED_TRACE("a collapse in the middle of a rename");
+    ASSERT_NO_FATAL_FAILURE(rename_from(home, spaces::SpaceMenuOrigin::kChip));
+    views::test::RunScheduledLayout(widget);
+    views::Textfield* const field = typing_into();
+    ASSERT_TRUE(field && field->IsDrawn()) << "no rename began";
+    field->SetText(u"Desk");
+    ASSERT_NO_FATAL_FAILURE(CollapseSidebar());
+    views::test::RunScheduledLayout(widget);
+    EXPECT_FALSE(field->IsDrawn())
+        << "the rename stayed open in the rail, " << field->width()
+        << " DIP wide";
