+SkBitmap Strip(int width, SkColor color) {
+  SkBitmap strip;
+  strip.allocN32Pixels(width, 2);
+  strip.eraseColor(color);
+  return strip;
+}
+
+void Paint(SkBitmap& strip, int from, int to, SkColor color) {
+  for (int x = from; x < to; ++x) {
+    for (int y = 0; y < strip.height(); ++y) {
+      *strip.getAddr32(x, y) = SkPreMultiplyColor(color);
+    }
+  }
+}
+
+// toolbar T31: a page drawn in one colour along its top edge gives that
+// colour -- farcaster.xyz's purple layer over its near-black body.
+TEST(PageTopColorTest, AnEdgeOfOneColourIsThatColour) {
+  const SkColor purple = SkColorSetRGB(48, 26, 158);
+  EXPECT_EQ(purple, UniformTopEdgeColor(Strip(300, purple)));
+  EXPECT_EQ(SK_ColorWHITE, UniformTopEdgeColor(Strip(300, SK_ColorWHITE)));
+}
+
+// A logo or a button that reaches the top edge over a few samples does not
+// stop the edge reading as the header's colour, and the noise of a header's
+// texture averages out.
+TEST(PageTopColorTest, ASmallElementOnTheEdgeIsIgnored) {
+  const SkColor header = SkColorSetRGB(1, 4, 9);
+  SkBitmap strip = Strip(200, header);
+  Paint(strip, 10, 25, SK_ColorWHITE);  // 7.5% of the edge
+  EXPECT_EQ(header, UniformTopEdgeColor(strip));
+
+  SkBitmap noisy = Strip(100, SkColorSetRGB(100, 100, 100));
+  Paint(noisy, 0, 50, SkColorSetRGB(104, 104, 104));
+  EXPECT_EQ(SkColorSetRGB(102, 102, 102), UniformTopEdgeColor(noisy));
+}
+
+// A photograph, a gradient or a header split between two colours is not one
+// colour: the row falls back to the page's declared colour.
+TEST(PageTopColorTest, AnEdgeOfSeveralColoursIsNone) {
+  SkBitmap halves = Strip(200, SK_ColorWHITE);
+  Paint(halves, 100, 200, SK_ColorBLACK);
+  EXPECT_EQ(std::nullopt, UniformTopEdgeColor(halves));
+
+  SkBitmap gradient = Strip(256, SK_ColorBLACK);
+  for (int x = 0; x < 256; ++x) {
+    Paint(gradient, x, x + 1, SkColorSetRGB(x, x, x));
+  }
+  EXPECT_EQ(std::nullopt, UniformTopEdgeColor(gradient));
+
+  SkBitmap busy = Strip(200, SK_ColorWHITE);
+  Paint(busy, 0, 30, SK_ColorRED);  // 15%: more than one sample in ten
+  EXPECT_EQ(std::nullopt, UniformTopEdgeColor(busy));
+}
+
+// The readback comes in the colour space of the surface it was copied from,
+// on a Mac the display's: Display P3 on its own screen. The row is painted
+// from an sRGB colour, so the strip is read as sRGB first; read as it came,
+// the row was the page's colour taken to P3 twice, a step less saturated
+// than the page under it (the owner's copy, 2026-10-02: farcaster.xyz's
+// purple, (47, 28, 158) over (50, 27, 165)).
+TEST(PageTopColorTest, ADisplayP3StripIsReadAsSRGB) {
+  const SkColor purple = SkColorSetRGB(48, 26, 158);
+  SkBitmap srgb;
+  srgb.allocPixels(
+      SkImageInfo::MakeN32Premul(100, 2, SkColorSpace::MakeSRGB()));
+  srgb.eraseColor(purple);
+  SkBitmap p3;
+  p3.allocPixels(SkImageInfo::MakeN32Premul(
+      100, 2,
+      SkColorSpace::MakeRGB(SkNamedTransferFn::kSRGB,
+                            SkNamedGamut::kDisplayP3)));
+  ASSERT_TRUE(srgb.readPixels(p3.pixmap()));
+  ASSERT_FALSE(PageColorsMatch(purple, p3.getColor(0, 0)))
+      << "the strip holds the display's values, not sRGB's";
+  const std::optional<SkColor> edge = UniformTopEdgeColor(p3);
+  ASSERT_TRUE(edge);
+  EXPECT_TRUE(PageColorsMatch(purple, *edge))
+      << "read " << SkColorGetR(*edge) << "," << SkColorGetG(*edge) << ","
+      << SkColorGetB(*edge);
+}
+
+TEST(PageTopColorTest, TooFewSamplesOrNoPixelsIsNone) {
+  EXPECT_EQ(std::nullopt, UniformTopEdgeColor(SkBitmap()));
+  EXPECT_EQ(std::nullopt,
+            UniformTopEdgeColor(Strip(kPageTopMinSamples - 1, SK_ColorWHITE)));
+  EXPECT_EQ(SK_ColorWHITE,
+            UniformTopEdgeColor(Strip(kPageTopMinSamples, SK_ColorWHITE)));
+}
+
+// A sample a step away from the last is not a new colour for the window.
+TEST(PageTopColorTest, ColoursTwoStepsApartMatch) {
+  EXPECT_TRUE(PageColorsMatch(SkColorSetRGB(10, 20, 30),
+                              SkColorSetRGB(12, 18, 30)));
+  EXPECT_FALSE(PageColorsMatch(SkColorSetRGB(10, 20, 30),
+                               SkColorSetRGB(13, 20, 30)));
+}
