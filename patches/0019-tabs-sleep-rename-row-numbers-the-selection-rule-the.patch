+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/tab_numbers.h"
+
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+
+namespace stedding {
+
+std::vector<tabs::TabInterface*> NumberedTabs(TabStripModel* tabs) {
+  std::vector<tabs::TabInterface*> out;
+  if (!tabs) {
+    return out;
+  }
+  for (int i = 0; i < tabs->count() && out.size() < 9u; ++i) {
+    if (!tabs->IsTabHidden(i)) {
+      out.push_back(tabs->GetTabAtIndex(i));
+    }
+  }
+  return out;
+}
+
+}  // namespace stedding
