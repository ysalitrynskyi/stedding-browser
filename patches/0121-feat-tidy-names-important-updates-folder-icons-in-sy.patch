+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/important_update_bar.h"
+
+#include <memory>
+#include <string>
+
+#include "base/memory/raw_ref.h"
+#include "base/strings/strcat.h"
+#include "chrome/browser/infobars/confirm_infobar_creator.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/stedding/app_updater.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/infobars/content/content_infobar_manager.h"
+#include "components/infobars/core/confirm_infobar_delegate.h"
+#include "components/infobars/core/infobar.h"
+#include "content/public/browser/web_contents.h"
+
+namespace stedding {
+namespace {
+
+// Shown once per launch, whichever window shows it.
+bool g_shown_this_launch = false;
+
+bool Offers(const AppUpdater& updater) {
+  return !updater.important_reason().empty() &&
+         (updater.state() == AppUpdater::State::kReady ||
+          updater.state() == AppUpdater::State::kAvailable);
+}
+
+class ImportantUpdateDelegate : public ConfirmInfoBarDelegate {
+ public:
+  explicit ImportantUpdateDelegate(AppUpdater& updater) : updater_(updater) {}
+  ImportantUpdateDelegate(const ImportantUpdateDelegate&) = delete;
+  ImportantUpdateDelegate& operator=(const ImportantUpdateDelegate&) = delete;
+  ~ImportantUpdateDelegate() override = default;
+
+  // ConfirmInfoBarDelegate:
+  InfoBarIdentifier GetIdentifier() const override {
+    return STEDDING_IMPORTANT_UPDATE_INFOBAR_DELEGATE;
+  }
+  std::u16string GetMessageText() const override {
+    return base::StrCat({u"An important update to Stedding is ready: ",
+                         updater_->important_reason()});
+  }
+  int GetButtons() const override { return BUTTON_OK; }
+  std::u16string GetButtonLabel(InfoBarButton button) const override {
+    return updater_->state() == AppUpdater::State::kAvailable
+               ? u"Update Now"
+               : u"Restart Now";
+  }
+  bool Accept() override {
+    updater_->InstallNow();
+    return true;
+  }
+  // It is about the browser, not the page: it stays while the tab moves on.
+  bool ShouldExpire(const NavigationDetails& details) const override {
+    return false;
+  }
+
+ private:
+  // The process's updater, which outlives every window.
+  const raw_ref<AppUpdater> updater_;
+};
+
+}  // namespace
+
+void MaybeShowImportantUpdateBar(BrowserWindowInterface* browser,
+                                 AppUpdater& updater) {
+  if (g_shown_this_launch || !browser || !Offers(updater) ||
+      browser->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      browser->GetProfile()->IsOffTheRecord()) {
+    return;
+  }
+  // The window in front, not the oldest: another normal window used more
+  // recently gets the bar when its own pill asks.
+  BrowserWindowInterface* front = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&front](BrowserWindowInterface* window) {
+        if (window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+            !window->GetProfile()->IsOffTheRecord()) {
+          front = window;
+          return false;
+        }
+        return true;
+      });
+  if (front && front != browser) {
+    return;
+  }
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  content::WebContents* const page =
+      tabs ? tabs->GetActiveWebContents() : nullptr;
+  infobars::ContentInfoBarManager* const manager =
+      page ? infobars::ContentInfoBarManager::FromWebContents(page) : nullptr;
+  if (!manager) {
+    return;
+  }
+  g_shown_this_launch = true;
+  manager->AddInfoBar(
+      CreateConfirmInfoBar(std::make_unique<ImportantUpdateDelegate>(updater)));
+}
+
+void ResetImportantUpdateBarForTesting() {
+  g_shown_this_launch = false;
+}
+
+}  // namespace stedding
