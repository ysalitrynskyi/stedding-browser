+class RecentTabsSwitcherView::Watcher : public ui::EventObserver {
+ public:
+  explicit Watcher(RecentTabsSwitcherView* strip) : strip_(strip) {}
+  ~Watcher() override = default;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override {
+    strip_->OnWatchedEvent(event);
+  }
+
+ private:
+  const raw_ptr<RecentTabsSwitcherView> strip_;
+};
+
+// static
+void RecentTabsSwitcherView::Show(Browser* browser) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser);
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  if (!browser_view || !model || !model->in_cycle()) {
+    return;
+  }
+  if (RecentTabsSwitcherView* const open = GetOpen(browser_view)) {
+    open->Refresh();
+    return;
+  }
+  // Last child of the browser view: over the page, on its own layer.
+  RecentTabsSwitcherView* const strip = browser_view->AddChildView(
+      std::make_unique<RecentTabsSwitcherView>(browser));
+  strip->SetPaintToLayer();
+  strip->layer()->SetFillsBoundsOpaquely(false);
+  strip->layer()->SetName("SteddingRecentTabs");
+  strip->SetVisible(false);
+  strip->Refresh();
+  strip->hold_timer_.Start(
+      FROM_HERE, kHoldDelay,
+      base::BindOnce(&RecentTabsSwitcherView::Reveal, base::Unretained(strip)));
+}
+
+// static
+RecentTabsSwitcherView* RecentTabsSwitcherView::GetOpenForTesting(
+    Browser* browser) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser);
+  return browser_view ? GetOpen(browser_view) : nullptr;
+}
+
+RecentTabsSwitcherView::RecentTabsSwitcherView(Browser* browser)
+    : browser_(browser) {
+  SetBackground(views::CreateRoundedRectBackground(ui::kColorDialogBackground,
+                                                   kPanelRadius));
+  SetBorder(views::CreateEmptyBorder(gfx::Insets(kPanelInset)));
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kHorizontal, gfx::Insets(), kCellSpacing));
+}
