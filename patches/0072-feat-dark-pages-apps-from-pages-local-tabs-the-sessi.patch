+void TabRestoreServiceImpl::SetWindowTabsExtraData(
+    SessionID id,
+    const std::string& key,
+    const std::optional<std::string>& value) {
+  bool changed = false;
+  for (const std::unique_ptr<tab_restore::Entry>& entry : helper_.entries_) {
+    if (entry->id != id || entry->type != tab_restore::Type::WINDOW) {
+      continue;
+    }
+    for (const std::unique_ptr<tab_restore::Tab>& tab :
+         static_cast<tab_restore::Window&>(*entry).tabs) {
+      if (!value) {
+        changed |= tab->extra_data.erase(key) > 0;
+        continue;
+      }
+      const auto it = tab->extra_data.find(key);
+      if (it != tab->extra_data.end() && it->second == *value) {
+        continue;
+      }
+      tab->extra_data[key] = *value;
+      changed = true;
+    }
+    break;
+  }
+  if (!changed) {
+    return;
+  }
+  // The entry may have been written already; the file must hold it as it is
+  // now.
+  if (persistence_delegate_) {
+    persistence_delegate_->RewriteAllEntries();
+  }
+  helper_.NotifyEntriesChanged();
+}
+
+void TabRestoreServiceImpl::TabCloseStopped(
+    LiveTab* live_tab,
+    const std::optional<tab_groups::TabGroupId>& group) {
+  if (!live_tab) {
+    return;
+  }
+  // A split's close keeps the tab closes of its panes out of the list
+  // (CreateHistoricalTab); this pane is open, so it is no longer one of
+  // them. The other pane, closed or still asking, is still covered.
+  const SessionID tab_id = live_tab->GetSessionID();
+  std::optional<split_tabs::SplitTabId> split;
+  for (auto it = helper_.closing_split_tabs_.begin();
+       it != helper_.closing_split_tabs_.end(); ++it) {
+    if (it->second.erase(tab_id) > 0) {
+      split = it->first;
+      if (it->second.empty()) {
+        helper_.closing_split_tabs_.erase(it);
+      }
+      break;
+    }
+  }
+  const bool group_closing =
+      group.has_value() && helper_.closing_groups_.contains(*group);
+  // The tab's record in that close was made from the entry its page shows,
+  // which it still shows: a page asking "Leave site?" has not navigated.
+  const int current = live_tab->GetCurrentEntryIndex();
+  if ((!split && !group_closing) || current < 0) {
+    return;
+  }
+  const int unique_id = live_tab->GetEntryAtIndex(current).unique_id();
+  const auto is_this_tab = [unique_id](const tab_restore::Tab& tab) {
+    return !tab.navigations.empty() &&
+           tab.navigations[tab.normalized_navigation_index()].unique_id() ==
+               unique_id;
+  };
+  bool changed = false;
+  // The newest record of that close is the first one in the list.
+  for (auto it = helper_.entries_.begin(); it != helper_.entries_.end();
+       ++it) {
+    tab_restore::Entry& entry = **it;
+    std::vector<std::unique_ptr<tab_restore::Tab>>* tabs = nullptr;
+    if (split && entry.type == tab_restore::SPLIT &&
+        static_cast<tab_restore::Split&>(entry).split_id == split) {
+      tabs = &static_cast<tab_restore::Split&>(entry).tabs;
+    } else if (group_closing && entry.type == tab_restore::GROUP &&
+               static_cast<tab_restore::Group&>(entry).group_id == *group) {
+      tabs = &static_cast<tab_restore::Group&>(entry).tabs;
+    } else if (split && entry.type == tab_restore::TAB &&
+               static_cast<tab_restore::Tab&>(entry).split_id == split) {
+      // A split whose other pane had no page was recorded as this pane alone.
+      if (is_this_tab(static_cast<tab_restore::Tab&>(entry))) {
+        helper_.entries_.erase(it);
+        changed = true;
+      }
+      break;
+    } else {
+      continue;
+    }
+    const bool split_entry = entry.type == tab_restore::SPLIT;
+    changed = std::erase_if(*tabs,
+                            [&](const std::unique_ptr<tab_restore::Tab>& tab) {
+                              return is_this_tab(*tab);
+                            }) > 0;
+    if (changed && tabs->empty()) {
+      helper_.entries_.erase(it);
+    } else if (changed && split_entry && tabs->size() == 1) {
+      // A split left with one pane is that pane's close. It keeps the
+      // close's id, which an Undo offered for the close already holds.
+      std::unique_ptr<tab_restore::Tab> pane = std::move(tabs->front());
+      pane->id = entry.id;
+      *it = std::move(pane);
+    }
+    break;
+  }
+  if (!changed) {
+    return;
+  }
+  // The record may have been written already; the file must hold it as it
+  // is now.
+  if (persistence_delegate_) {
+    persistence_delegate_->RewriteAllEntries();
+  }
+  helper_.NotifyEntriesChanged();
+}
+
 const TabRestoreService::Entries& TabRestoreServiceImpl::entries() const {
   return helper_.entries();
 }
