+// Arc's item ids already brought over (I12).
+class ImportedIds {
+ public:
+  explicit ImportedIds(PrefService* prefs) : prefs_(prefs) {
+    if (!prefs_) {
+      return;
+    }
+    for (const base::Value& id :
+         prefs_->GetList(stedding::prefs::kArcImportedIds)) {
+      if (id.is_string()) {
+        ids_.insert(id.GetString());
+      }
+    }
+  }
+  bool Contains(const std::string& id) const { return ids_.contains(id); }
+  void Add(const std::string& id) {
+    if (!id.empty() && ids_.insert(id).second) {
+      added_.push_back(id);
+    }
+  }
+  std::optional<SpaceId> SpaceFor(const std::string& arc_id) const {
+    if (!prefs_) {
+      return std::nullopt;
+    }
+    const std::string* stored =
+        prefs_->GetDict(stedding::prefs::kArcImportedSpaces).FindString(arc_id);
+    if (!stored) {
+      return std::nullopt;
+    }
+    return SpaceId::FromOptionalToken(base::Token::FromString(*stored));
+  }
+  void RememberSpace(const std::string& arc_id, const SpaceId& id) {
+    spaces_[arc_id] = id.ToString();
+  }
+  void Save() {
+    if (!prefs_) {
+      return;
+    }
+    {
+      ScopedListPrefUpdate update(prefs_, stedding::prefs::kArcImportedIds);
+      for (const std::string& id : added_) {
+        update->Append(id);
+      }
+    }
+    ScopedDictPrefUpdate update(prefs_, stedding::prefs::kArcImportedSpaces);
+    for (const auto& [arc_id, id] : spaces_) {
+      update->Set(arc_id, id);
+    }
+  }
+
+ private:
+  const raw_ptr<PrefService> prefs_;
+  std::set<std::string> ids_;
+  std::vector<std::string> added_;
+  std::map<std::string, std::string> spaces_;
+};
+
+// I3: a tab that shows its title and loads on its first activation, the way
+// session restore creates the tabs it does not load.
+tabs::TabInterface* InsertUnloaded(TabStripModel* tabs,
+                                   Profile* profile,
+                                   const Node& node) {
+  content::WebContents::CreateParams params(profile);
+  params.initially_hidden = true;
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContents::Create(params);
+  std::vector<std::unique_ptr<content::NavigationEntry>> entries;
+  std::unique_ptr<content::NavigationEntry> entry =
+      content::NavigationController::CreateNavigationEntry(
+          node.url, content::Referrer(), std::nullopt, std::nullopt,
+          ui::PAGE_TRANSITION_TYPED, false, std::string(), profile, nullptr);
+  entry->SetTitle(node.title);
+  entries.push_back(std::move(entry));
+  contents->GetController().Restore(0, content::RestoreType::kRestored,
+                                    &entries);
+  contents->SetWasDiscarded(true);
+  content::WebContents* const raw = contents.get();
+  tabs->AppendTab(std::make_unique<tabs::TabModel>(std::move(contents), tabs),
+                  /*foreground=*/false);
+  return tabs->GetTabForWebContents(raw);
+}
