+
+base::RepeatingClosure& CodecObserver() {
+  static base::NoDestructor<base::RepeatingClosure> observer;
+  return *observer;
+}
+
+// The start of every step: it must not be on the UI thread, and a test may be
+// counting where the steps run.
+void BeginStep() {
+  base::AssertLongCPUWorkAllowed();
+  if (!CodecObserver().is_null()) {
+    CodecObserver().Run();
+  }
+}
+
+CaptureReply ReadReply(std::string_view message, int request_id) {
+  CaptureReply reply;
+  const std::optional<base::DictValue> parsed =
+      base::JSONReader::ReadDict(message, base::JSON_PARSE_RFC);
+  if (!parsed || parsed->FindInt("id") != request_id) {
+    return reply;  // an event, not our reply
+  }
+  reply.kind = ReplyKind::kNoPicture;
+  const base::DictValue* const result = parsed->FindDict("result");
+  const std::string* const data = result ? result->FindString("data") : nullptr;
+  if (!data) {
+    return reply;
+  }
+  std::optional<std::vector<uint8_t>> bytes = base::Base64Decode(*data);
+  if (bytes && !bytes->empty()) {
+    reply.kind = ReplyKind::kPicture;
+    reply.png = std::move(*bytes);
+  }
+  return reply;
+}
+
+// A PNG's width and height from its header (the signature, then the IHDR
+// chunk), without decoding it; nothing when `png` does not start as a PNG.
+std::optional<gfx::Size> PngSize(base::span<const uint8_t> png) {
+  static constexpr uint8_t kStart[] = {0x89, 'P',  'N', 'G', '\r', '\n',
+                                       0x1a, '\n', 0,   0,   0,    13,
+                                       'I',  'H',  'D', 'R'};
+  if (png.size() < 24u || !std::ranges::equal(png.first<16u>(), kStart)) {
+    return std::nullopt;
+  }
+  const uint32_t width = base::U32FromBigEndian(png.subspan<16u, 4u>());
+  const uint32_t height = base::U32FromBigEndian(png.subspan<20u, 4u>());
+  if (!base::IsValueInRangeForNumericType<int>(width) ||
+      !base::IsValueInRangeForNumericType<int>(height)) {
+    return std::nullopt;
+  }
+  return gfx::Size(static_cast<int>(width), static_cast<int>(height));
+}
+
+CaptureOutcome WriteThenDecode(std::vector<uint8_t> png,
+                               const base::FilePath& directory,
+                               const base::FilePath& name) {
+  CaptureOutcome outcome;
+  if (png.empty()) {
+    return outcome;
+  }
+  // The file first: it is the page's own PNG, good even when this decoder
+  // cannot read it.
+  outcome.path = WriteNewScreenshotFile(directory, name, png);
+  // No second bitmap past the budget (BACKLOG S-344): the capture asks for no
+  // more than it, but a page can grow between its size and its picture.
+  const std::optional<gfx::Size> size = PngSize(png);
+  if (size && FitsCaptureBudget(size->width(), size->height())) {
+    outcome.bitmap = gfx::PNGCodec::Decode(png);
+  }
+  return outcome;
+}
+
+}  // namespace
+
+bool FitsCaptureBudget(int64_t width, int64_t height) {
+  return width > 0 && height > 0 && width <= kMaxCaptureSide &&
+         height <= kMaxCaptureSide && width * height <= kMaxCaptureArea;
+}
+
+std::optional<gfx::Size> FullPageClip(const gfx::Size& css_size,
+                                      float device_scale_factor) {
+  if (css_size.IsEmpty()) {
+    return std::nullopt;  // nothing to cut; the capture says what it can
+  }
+  const double scale = device_scale_factor > 0 ? device_scale_factor : 1.0;
+  // Device pixels as Chromium sizes the picture: CSS pixels times the scale,
+  // rounded.
+  const auto device = [scale](int css) {
+    return static_cast<int64_t>(std::llround(css * scale));
+  };
+  if (FitsCaptureBudget(device(css_size.width()),
+                        device(css_size.height()))) {
+    return std::nullopt;
+  }
+  // Rounded down to whole CSS pixels, whose rounded device size then stays
+  // within the limit.
+  const auto css = [scale](int64_t device_pixels) {
+    return std::max(1, base::ClampFloor(device_pixels / scale));
+  };
+  const int width = std::min(css_size.width(), css(kMaxCaptureSide));
+  const int64_t height_left = std::min<int64_t>(
+      kMaxCaptureSide, kMaxCaptureArea / std::max<int64_t>(1, device(width)));
+  const int height = std::min(css_size.height(), css(height_left));
+  return gfx::Size(width, height);
+}
+
+CaptureReply::CaptureReply() = default;
+CaptureReply::CaptureReply(CaptureReply&&) = default;
+CaptureReply& CaptureReply::operator=(CaptureReply&&) = default;
+CaptureReply::~CaptureReply() = default;
+
+CaptureOutcome::CaptureOutcome() = default;
+CaptureOutcome::CaptureOutcome(CaptureOutcome&&) = default;
+CaptureOutcome& CaptureOutcome::operator=(CaptureOutcome&&) = default;
+CaptureOutcome::~CaptureOutcome() = default;
+
+CaptureReply ReadCaptureReply(std::string_view message, int request_id) {
+  BeginStep();
+  return ReadReply(message, request_id);
+}
+
+CaptureOutcome EncodeAndWrite(SkBitmap bitmap,
