+// The nearest view of class T at or above `view`, or null.
+template <typename T>
+T* NearestOfClass(views::View* view) {
+  for (; view; view = view->parent()) {
+    if (auto* const found = views::AsViewClass<T>(view)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+template <typename T>
+const T* NearestOfClass(const views::View* view) {
+  for (; view; view = view->parent()) {
+    if (const auto* const found = views::AsViewClass<T>(view)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// folders F38, F39: the rows under `parent` by the tabs they draw, each the
+// direct child of `parent` that draws it: a row is a tab, a split, a group
+// or a folder, and the first tab of each of a collection's own rows names
+// it.
+std::map<const tabs::TabInterface*, const views::View*> RowsByTab(
+    const views::View& parent) {
+  std::map<const tabs::TabInterface*, const views::View*> row_of_tab;
+  for (const views::View* const row : parent.children()) {
+    std::vector<const views::View*> pending = {row};
+    while (!pending.empty()) {
+      const views::View* const view = pending.back();
+      pending.pop_back();
+      if (const auto* const tab_view = views::AsViewClass<TabView>(view)) {
+        row_of_tab.emplace(tab_view->GetTabInterface(), row);
+        continue;
+      }
+      for (const views::View* const child : view->children()) {
+        pending.push_back(child);
+      }
+    }
+  }
+  return row_of_tab;
+}
