 class DownloadUiContextMenuTest : public testing::Test {
  public:
@@ -81,3 +91,64 @@ TEST_F(DownloadUiContextMenuTest, RecordCommandsEnabled) {
       DownloadUiContextMenuAction::kLearnMoreInsecureDownloadEnabled, 1);
   histogram_tester.ExpectTotalCount("Download.ContextMenuAction", 2);
 }
+
+// Stedding, sidebar-panels Pn19 (GitHub discussion 116): the menu of a
+// finished download in the bubble, the toast a new download shows, offers
+// the Downloads panel's Move to Trash (Pn11) and Remove from List (Pn9).
+// The file goes to the Trash, never deleted outright; Remove from List takes
+// the download off the list and is offered only where the profile may
+// delete history; a file already gone cannot be moved.
+TEST_F(DownloadUiContextMenuTest, SteddingAFinishedDownloadsVerbs) {
+  TestingProfile profile;
+  NiceMock<download::MockDownloadItem> item;
+  content::DownloadItemUtils::AttachInfoForTesting(&item, &profile, nullptr);
+  const base::FilePath path(FILE_PATH_LITERAL("a-file.pdf"));
+  ON_CALL(item, GetState())
+      .WillByDefault(Return(download::DownloadItem::COMPLETE));
+  ON_CALL(item, GetTargetFilePath()).WillByDefault(ReturnRefOfCopy(path));
+  ON_CALL(item, GetFileExternallyRemoved()).WillByDefault(Return(false));
+  auto download = DownloadItemModel::Wrap(&item);
+  MakeContextMenu(download.get());
+  ui::SimpleMenuModel* const model = menu()->GetMenuModel();
+  ASSERT_TRUE(model);
+
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+  ASSERT_TRUE(
+      model->GetIndexOfCommandId(DownloadUiContextMenu::kSteddingMoveToTrash))
+      << "no Move to Trash";
+  EXPECT_TRUE(
+      menu()->IsCommandIdEnabled(DownloadUiContextMenu::kSteddingMoveToTrash));
+  base::FilePath trashed;
+  stedding::SetMoveToTrashForTesting(
+      base::BindLambdaForTesting([&](const base::FilePath& file) {
+        trashed = file;
+        return true;
+      }));
+  menu()->ExecuteCommand(DownloadUiContextMenu::kSteddingMoveToTrash, 0);
+  RunUntilIdle();
+  stedding::SetMoveToTrashForTesting(
+      base::RepeatingCallback<bool(const base::FilePath&)>());
+  EXPECT_EQ(path, trashed) << "the file did not go to the Trash";
+#endif
+
+  ASSERT_TRUE(model->GetIndexOfCommandId(
+      DownloadUiContextMenu::kSteddingRemoveFromList))
+      << "no Remove from List";
+  EXPECT_TRUE(menu()->IsCommandIdVisible(
+      DownloadUiContextMenu::kSteddingRemoveFromList));
+  EXPECT_CALL(item, Remove()).Times(1);
+  menu()->ExecuteCommand(DownloadUiContextMenu::kSteddingRemoveFromList, 0);
+  testing::Mock::VerifyAndClearExpectations(&item);
+
+  profile.GetPrefs()->SetBoolean(prefs::kAllowDeletingBrowserHistory, false);
+  EXPECT_FALSE(menu()->IsCommandIdVisible(
+      DownloadUiContextMenu::kSteddingRemoveFromList))
+      << "offered where the profile may not delete history";
+  EXPECT_CALL(item, Remove()).Times(0);
+  menu()->ExecuteCommand(DownloadUiContextMenu::kSteddingRemoveFromList, 0);
+
+  ON_CALL(item, GetFileExternallyRemoved()).WillByDefault(Return(true));
+  EXPECT_FALSE(
+      menu()->IsCommandIdEnabled(DownloadUiContextMenu::kSteddingMoveToTrash))
+      << "a file already gone can be moved";
+}
