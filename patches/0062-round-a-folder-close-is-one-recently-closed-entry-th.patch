+// PLAN.md SPC-4, spaces B12: the chip that would take the drop is lit while
+// it would, and only then: not for an essential, not once the pointer is off
+// the chips, not after the drop.
+TEST_F(SpaceDragTargetTest, TheChipThatWouldTakeTheDropIsLit) {
+  AddTab(browser(), GURL("https://example.com/"));
+  TabStripModel* const tabs = browser()->tab_strip_model();
+
+  SpaceModel model;
+  Space* const other = model.AddSpace("Other", SK_ColorRED);
+  SpaceSwitcherView switcher(model, *browser());
+  // Wide enough that no chip is a dot.
+  switcher.SetBoundsRect(gfx::Rect(0, 0, 400, 40));
+  SpaceDragTarget target(model, *browser(), &switcher);
+  views::View* const chip = switcher.ChipForTesting(other->id());
+  ASSERT_TRUE(chip);
+  EXPECT_FALSE(chip->GetBackground());
+
+  target.SetHoveredSpace(other->id());
+  EXPECT_EQ(other->id(), switcher.drop_target_for_testing());
+  EXPECT_TRUE(chip->GetBackground()) << "the chip that would take it is dark";
+
+  target.SetHoveredSpace(std::nullopt);
+  EXPECT_EQ(std::nullopt, switcher.drop_target_for_testing());
+  EXPECT_FALSE(chip->GetBackground()) << "lit with the pointer off it";
+
+  target.SetDraggedTabPinnedForTesting(true);
+  target.SetHoveredSpace(other->id());
+  EXPECT_EQ(std::nullopt, switcher.drop_target_for_testing())
+      << "lit for an essential it will not take";
+  target.SetDraggedTabPinnedForTesting(false);
+
+  target.SetHoveredSpace(other->id());
+  target.DropContents({tabs->GetWebContentsAt(0)});
+  EXPECT_EQ(std::nullopt, switcher.drop_target_for_testing())
+      << "still lit after the drop";
+}
+
+// BACKLOG S-338: a tab of another window, dragged over this window's chips,
+// is that window's. The chip is not lit, the drop is not taken, and nothing
+// files the tab here. Taken, the drop filed it in this window's Space -- in
+// the session too, so a later drag of it into this window showed it in that
+// Space, in its old jar -- switched this window there, and left the tab in
+// its own window.
+TEST_F(SpaceDragTargetTest, AnotherWindowsTabIsRefused) {
+  AddTab(browser(), GURL("https://example.org/"));
+  std::unique_ptr<BrowserWindowInterface> other =
+      CreateBrowser(profile(), BrowserWindowInterface::TYPE_NORMAL,
+                    /*hosted_app=*/false);
+  AddTab(other.get(), GURL("https://example.com/"));
+  content::WebContents* const theirs =
+      other->GetTabStripModel()->GetWebContentsAt(0);
+  tabs::TabInterface* const tab = tabs::TabInterface::GetFromContents(theirs);
+
+  SpaceModel model;
+  const SpaceId home = model.active_id();
+  Space* const work = model.AddSpace("Work", SK_ColorRED);
+  SpaceSwitcherView switcher(model, *browser());
+  switcher.SetBoundsRect(gfx::Rect(0, 0, 400, 40));
+  SpaceDragTarget target(model, *browser(), &switcher);
+  target.SetDraggedTabsForTesting({theirs});
+  target.SetHoveredSpace(work->id());
+  EXPECT_FALSE(target.CanDropTab()) << "the drop of another window's tab";
+  EXPECT_EQ(std::nullopt, switcher.drop_target_for_testing())
+      << "lit for a tab it will not take";
+
+  target.DropContents({theirs});
+  EXPECT_FALSE(model.FindSpaceForTab(tab).has_value())
+      << "another window's tab was filed in this window's Space";
+  EXPECT_EQ(home, model.active_id()) << "this window went to the chip's Space";
+  other->GetTabStripModel()->CloseAllTabs();
+}
