+  // A row gone from a run, moved to another window, is no change of order.
+  const PinChanges gone =
+      store.ChangesSince(held, {Essential("e", "https://e.example/"),
+                                Pin("a", work, "https://a.example/"),
+                                Pin("c", work, "https://c.example/"),
+                                Pin("p", play, "https://p.example/"),
+                                Pin("q", play, "https://q.example/")});
+  EXPECT_TRUE(gone.changed.empty());
+  EXPECT_TRUE(gone.order.empty());
+}
