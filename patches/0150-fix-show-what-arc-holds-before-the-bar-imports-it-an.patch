+bool RunCommandBarRow(BrowserWindowInterface* window,
+                      const std::u16string& title) {
+  chrome::ExecuteCommand(window, IDC_STEDDING_COMMAND_PALETTE);
+  stedding::CommandBarView* const bar = stedding::CommandBarView::GetOpenBar(
+      BrowserView::GetBrowserViewForBrowser(window));
+  if (!bar) {
+    return false;
+  }
+  bar->field_for_testing()->SetText(title);
+  bar->ContentsChanged(bar->field_for_testing(), title);
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    if (bar->row_title_for_testing(i) != title) {
+      continue;
+    }
+    views::View* const field = bar->field_for_testing();
+    while (bar->selected_row_for_testing() < i) {
+      field->OnKeyPressed(ui::KeyEvent(ui::EventType::kKeyPressed,
+                                       ui::VKEY_DOWN, ui::EF_NONE));
+    }
+    field->OnKeyPressed(ui::KeyEvent(ui::EventType::kKeyPressed,
+                                     ui::VKEY_RETURN, ui::EF_NONE));
+    base::RunLoop().RunUntilIdle();
+    return true;
+  }
+  bar->Close();
+  return false;
+}
