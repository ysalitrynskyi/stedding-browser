+// import I31: logins sealed under the key come back; one sealed "v20", bound
+// to the browser that sealed it, and one that will not unseal are left out
+// and counted apart, for the result line to name.
+TEST(ChromiumFamilyImporterTest, AV20ValueIsLeftOutAndCounted) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const std::vector<uint8_t> key(
+      crypto::aead::KeySizeFor(crypto::aead::AES_256_GCM), 5);
+  const std::vector<uint8_t> other(key.size(), 6);
+  const base::FilePath logins = dir.GetPath().AppendASCII("Login Data");
+  WriteLogins(logins, {SealOnWindows("hunter2", key, "v10"),
+                       SealOnWindows("bound", key, "v20"),
+                       SealOnWindows("other", other, "v10")});
+  LoginsLeftOut left_out;
+  const std::vector<password_manager::PasswordForm> forms =
+      ReadArcLogins(logins, key, /*cap=*/10, ArcSeal::kWindowsLocalState,
+                    &left_out);
+  ASSERT_EQ(1u, forms.size());
+  EXPECT_EQ(u"hunter2", forms[0].password_value.value());
+  EXPECT_EQ(1u, left_out.bound_to_its_browser);
+  EXPECT_EQ(1u, left_out.unreadable);
+}
