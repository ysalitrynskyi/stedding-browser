+// Stedding (PLAN.md TAB-34, TAB-F39; BACKLOG S-141): a short strip keeps both
+// containers inside it. The numbers are a full essentials grid over a short
+// tab list in the open sidebar: twelve essentials in six rows of 50 DIP, 4
+// apart; two tabs under the Clear line and the New Tab row (22, then 44 and
+// two rows of 44, 2 apart); the minimums the containers ask for, a row of 44
+// and 4 for the essentials and a row and a half of 44 and 2 for the tabs;
+// the 8 DIP between the containers and the 30 DIP Space title row. Sized
+// before the title row was counted, a strip of 180 DIP gave the essentials
+// 86 and the tabs their minimum of 68, which ended 12 DIP past its bottom.
+TEST(TabStripViewLayoutTest, AShortStripKeepsBothContainersInside) {
+  constexpr int kPinned = 6 * 50 + 5 * 4;
+  constexpr int kPinnedMinimum = 44 + 4;
+  constexpr int kUnpinned = 22 + 44 + 2 + 44 + 2 + 44;
+  constexpr int kUnpinnedMinimum = 66 + 2;
+  constexpr int kAround = 8 + 30;
+  ASSERT_EQ(320, kPinned);
+  ASSERT_EQ(158, kUnpinned);
+
+  const auto split = [&](int strip) {
+    return TabStripViewLayout::SplitVerticalHeight(
+        strip - kAround, kPinned, kPinnedMinimum, kUnpinned,
+        kUnpinnedMinimum);
+  };
+  {
+    SCOPED_TRACE("a tall strip gives both their preferred heights");
+    const TabStripViewLayout::VerticalHeights heights = split(600);
+    EXPECT_EQ(kPinned, heights.pinned);
+    EXPECT_EQ(kUnpinned, heights.unpinned);
+  }
+  {
+    SCOPED_TRACE("a strip of 180: half each, the title row counted first");
+    const TabStripViewLayout::VerticalHeights heights = split(180);
+    EXPECT_EQ(71, heights.pinned);
+    EXPECT_EQ(71, heights.unpinned);
+  }
+  {
+    SCOPED_TRACE("the shortest strip: each its minimum");
+    const TabStripViewLayout::VerticalHeights heights =
+        split(kPinnedMinimum + kUnpinnedMinimum + kAround);
+    EXPECT_EQ(kPinnedMinimum, heights.pinned);
+    EXPECT_EQ(kUnpinnedMinimum, heights.unpinned);
+  }
+  // At every height from the shortest up, nothing past the bottom edge.
+  for (int strip = kPinnedMinimum + kUnpinnedMinimum + kAround; strip <= 600;
+       ++strip) {
+    const TabStripViewLayout::VerticalHeights heights = split(strip);
+    EXPECT_LE(heights.pinned + heights.unpinned + kAround, strip)
+        << "a strip of " << strip << ": essentials " << heights.pinned
+        << ", tabs " << heights.unpinned;
+    EXPECT_GE(heights.pinned, kPinnedMinimum) << "a strip of " << strip;
+    EXPECT_GE(heights.unpinned, kUnpinnedMinimum) << "a strip of " << strip;
+  }
+}
