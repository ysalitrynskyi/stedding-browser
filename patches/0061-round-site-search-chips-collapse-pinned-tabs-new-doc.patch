+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/new_documents.h"
+
+#include <array>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/containers/span.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace stedding {
+namespace {
+
+// commandbar K28: every row opens a service's bare new-document address over
+// https -- a ".new" name, no path, query, fragment, port or user -- so a row
+// can only ever ask the service for a blank document.
+TEST(NewDocumentsTest, EveryAddressIsAnHttpsNewDocumentAddress) {
+  ASSERT_FALSE(NewDocuments().empty());
+  for (const NewDocument& document : NewDocuments()) {
+    SCOPED_TRACE(document.url);
+    const GURL url(document.url);
+    ASSERT_TRUE(url.is_valid());
+    EXPECT_TRUE(url.SchemeIs(url::kHttpsScheme));
+    EXPECT_TRUE(url.host().ends_with(".new"));
+    EXPECT_EQ("/", url.path());
+    EXPECT_FALSE(url.has_query());
+    EXPECT_FALSE(url.has_ref());
+    EXPECT_FALSE(url.has_port());
+    EXPECT_FALSE(url.has_username());
+  }
+}
+
+// commandbar K28: no two rows share a title, so typing a title finds one row,
+// and no two open the same address.
+TEST(NewDocumentsTest, TitlesAndAddressesAreUnique) {
+  std::set<std::u16string_view> titles;
+  std::set<std::string_view> urls;
+  for (const NewDocument& document : NewDocuments()) {
+    EXPECT_FALSE(document.title.empty()) << document.url;
+    EXPECT_TRUE(titles.insert(document.title).second) << document.url;
+    EXPECT_TRUE(urls.insert(document.url).second) << document.url;
+  }
+}
+
+// commandbar K28 (BACKLOG S-116): the services, their titles and their order,
+// as the spec names them.
+TEST(NewDocumentsTest, TheListIsTheSpecs) {
+  static constexpr auto kExpected =
+      std::to_array<std::pair<std::u16string_view, std::string_view>>({
+          {u"New Google Doc", "https://docs.new/"},
+          {u"New Google Sheet", "https://sheets.new/"},
+          {u"New Google Slides", "https://slides.new/"},
+          {u"New Google Form", "https://forms.new/"},
+          {u"New Notion Page", "https://notion.new/"},
+          {u"New Figma Design File", "https://figma.new/"},
+          {u"New GitHub Repository", "https://repo.new/"},
+          {u"New GitHub Gist", "https://gist.new/"},
+          {u"New Word Document", "https://word.new/"},
+          {u"New Excel Workbook", "https://excel.new/"},
+          {u"New PowerPoint", "https://powerpoint.new/"},
+      });
+  const base::span<const NewDocument> documents = NewDocuments();
+  ASSERT_EQ(kExpected.size(), documents.size());
+  for (size_t i = 0; i < kExpected.size(); ++i) {
+    EXPECT_EQ(std::u16string(kExpected[i].first),
+              std::u16string(documents[i].title));
+    EXPECT_EQ(GURL(kExpected[i].second), GURL(documents[i].url));
+  }
+}
+
+}  // namespace
+}  // namespace stedding
