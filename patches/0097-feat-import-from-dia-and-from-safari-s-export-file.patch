+class BookmarksLoadedWaiter::Observer
+    : public bookmarks::BaseBookmarkModelObserver {
+ public:
+  Observer(bookmarks::BookmarkModel* model, base::OnceClosure loaded)
+      : loaded_(std::move(loaded)) {
+    observation_.Observe(model);
+  }
+  ~Observer() override = default;
+
+  // bookmarks::BaseBookmarkModelObserver:
+  void BookmarkModelChanged() override {}
+  void BookmarkModelLoaded(bool ids_reassigned) override {
+    observation_.Reset();
+    if (loaded_) {
+      std::move(loaded_).Run();
+    }
+  }
+  void BookmarkModelBeingDeleted() override {
+    observation_.Reset();
+    loaded_.Reset();
+  }
+
+ private:
+  base::OnceClosure loaded_;
+  base::ScopedObservation<bookmarks::BookmarkModel,
+                          bookmarks::BookmarkModelObserver>
+      observation_{this};
+};
+
+BookmarksLoadedWaiter::BookmarksLoadedWaiter(bookmarks::BookmarkModel* model,
+                                             base::OnceClosure loaded) {
+  if (!model) {
+    return;
+  }
+  if (model->loaded()) {
+    std::move(loaded).Run();
+    return;
+  }
+  observer_ = std::make_unique<Observer>(model, std::move(loaded));
+}
+
+BookmarksLoadedWaiter::~BookmarksLoadedWaiter() = default;
+
+base::Time OldestKeptVisit(base::Time now) {
+  return now - base::Days(history::HistoryBackend::kExpireDaysThreshold);
+}
+
+base::Time LatestKeptVisit(base::Time now) {
+  return now + base::Minutes(10);
+}
+
+void AddNewVisits(history::HistoryService& history,
+                  history::URLRows rows,
+                  history::VisitSource source,
+                  base::CancelableTaskTracker& tracker,
+                  base::OnceCallback<void(size_t)> done) {
+  if (rows.empty()) {
+    std::move(done).Run(0);
+    return;
+  }
+  history.ScheduleDBTask(
+      FROM_HERE,
+      std::make_unique<AddNewVisitsTask>(std::move(rows), source,
+                                         std::move(done)),
+      &tracker);
+}
