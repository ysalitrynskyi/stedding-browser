+// A History file at `path` in Arc's (Chromium's) shape, one row per page,
+// each last visited at its time.
+void WriteHistoryW2B09(
+    const base::FilePath& path,
+    const std::vector<std::pair<std::string, base::Time>>& pages) {
+  sql::Database db(sql::Database::Tag("Test"));
+  ASSERT_TRUE(db.Open(path));
+  ASSERT_TRUE(db.Execute(
+      "CREATE TABLE urls(id INTEGER PRIMARY KEY, url LONGVARCHAR, "
+      "title LONGVARCHAR, visit_count INTEGER DEFAULT 0 NOT NULL, "
+      "typed_count INTEGER DEFAULT 0 NOT NULL, last_visit_time INTEGER "
+      "NOT NULL, hidden INTEGER DEFAULT 0 NOT NULL)"));
+  for (const auto& [url, when] : pages) {
+    sql::Statement insert(db.GetUniqueStatement(
+        "INSERT INTO urls (url, title, visit_count, typed_count, "
+        "last_visit_time, hidden) VALUES (?, 'Page', 1, 0, ?, 0)"));
+    insert.BindString(0, url);
+    insert.BindInt64(1, when.ToDeltaSinceWindowsEpoch().InMicroseconds());
+    ASSERT_TRUE(insert.Run());
+  }
+}
