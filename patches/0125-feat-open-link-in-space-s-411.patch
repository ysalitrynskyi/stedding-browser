+// Stedding menus M14 (GitHub issue 75): the Spaces "Open Link in Space"
+// names for `window`, every Space but the one on screen, in switcher order;
+// none in a window without Spaces (a popup, an app, a private window).
+std::vector<spaces::SpaceId> SpacesToOpenLinkIn(
+    BrowserWindowInterface* window) {
+  std::vector<spaces::SpaceId> others;
+  const spaces::SpaceModel* const model =
+      window ? spaces::SpaceModel::From(window) : nullptr;
+  if (!model) {
+    return others;
+  }
+  for (const std::unique_ptr<spaces::Space>& space : model->spaces()) {
+    if (space->id() != model->active_id()) {
+      others.push_back(space->id());
+    }
+  }
+  return others;
+}
