+
+namespace {
+
+class TabMenuLabelW2B22Test : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  tabs::TabInterface* OpenTabW2B22() {
+    AddTab(browser(), GURL("https://example.com/"));
+    return tabs().GetActiveTab();
+  }
+};
+
+class FolderCloseW2B22Test : public TabMenuLabelW2B22Test {};
+
+class TabMenuTabsW2B22Test : public TabMenuLabelW2B22Test {};
+
+// Every row enabled; running one does nothing. The labels are what is read.
+class MenuRowsW2B22 : public ui::SimpleMenuModel::Delegate {
+ public:
+  bool IsCommandIdEnabled(int command_id) const override { return true; }
+  void ExecuteCommand(int command_id, int event_flags) override {}
+};
+
+// A window with no other windows to offer and no Spaces to name.
+class NoOtherWindowsW2B22 : public TabMenuModelDelegate {
+ public:
+  explicit NoOtherWindowsW2B22(ui::UnownedUserDataHost& host)
+      : TabMenuModelDelegate(host) {}
+
+  std::vector<BrowserWindowInterface*> GetOtherBrowserWindows(
+      bool is_app) override {
+    return {};
+  }
+  tab_groups::TabGroupSyncService* GetTabGroupSyncService() override {
+    return nullptr;
+  }
+};
+
+// The label of the short tab menu's Close Tabs Below / to the Right row, as
+// the menu opened on `tab` has it.
+std::u16string CloseTabsAfterLabelW2B22(TabStripModel& strip,
+                                        tabs::TabInterface* tab) {
+  MenuRowsW2B22 rows;
+  ui::UnownedUserDataHost host;
+  NoOtherWindowsW2B22 windows(host);
+  TabMenuModel menu(&rows, &windows, &strip, strip.GetIndexOfTab(tab));
+  const std::optional<size_t> at =
+      menu.GetIndexOfCommandId(TabStripModel::CommandCloseTabsToRight);
+  return at.has_value() ? menu.GetLabelAt(*at) : u"(no such row)";
+}
+
+// P29-1c; menus M1, M8. The short menu's last row says "Close Tabs Below" in
+// the sidebar, and names the side the tabs it closes are on in the
+// horizontal strip: to the right, to the left right to left, as Chromium's
+// menu does. It said "Close Tabs Below" on both strips.
+TEST_F(TabMenuLabelW2B22Test, TheCloseTabsRowNamesTheSideOfTheStripShowing) {
+  profile()->GetPrefs()->SetBoolean(stedding::prefs::kMenusShort, true);
+  OpenTabW2B22();
+  tabs::TabInterface* const tab = OpenTabW2B22();
+  tabs::VerticalTabStripStateController* const state =
+      tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(state) << "a normal window has the sidebar's state controller";
+  ASSERT_TRUE(state->ShouldDisplayVerticalTabs())
+      << "the sidebar is the default";
+
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_TAB_CXMENU_CLOSETABSBELOW),
+            CloseTabsAfterLabelW2B22(tabs(), tab))
+      << "in the sidebar";
+
+  state->SetVerticalTabsEnabled(false);
+  ASSERT_FALSE(state->ShouldDisplayVerticalTabs());
+  EXPECT_EQ(l10n_util::GetStringUTF16(base::i18n::IsRTL()
+                                          ? IDS_TAB_CXMENU_CLOSETABSTOLEFT
+                                          : IDS_TAB_CXMENU_CLOSETABSTORIGHT),
+            CloseTabsAfterLabelW2B22(tabs(), tab))
+      << "in the horizontal strip";
+}
+
+// P30-1b; folders F19, tabs R60. With "Show tabs under the tab that opened
+// them" on, Close Folder's Tabs closes a child folded away under its parent
+// in the folder too, with the parent and the other rows: every tab of the
+// folder in the active Space goes. The fold hides the child's row, and the
+// close had left every tab it hides open, so the child stayed, shown again
+// once its parent was gone, and the folder with it.
+TEST_F(FolderCloseW2B22Test, ClosingAFolderTakesTheChildFoldedInIt) {
+  profile()->GetPrefs()->SetBoolean(stedding::prefs::kNestChildTabs, true);
+  tabs::TabInterface* const outside = OpenTabW2B22();
+  tabs::TabInterface* const child = OpenTabW2B22();
+  tabs::TabInterface* const parent = OpenTabW2B22();
+  stedding::SetTabParent(browser(), child, parent);
+  std::vector<int> rows = {tabs().GetIndexOfTab(parent),
+                           tabs().GetIndexOfTab(child)};
+  std::ranges::sort(rows);
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(rows);
+  ASSERT_NE(nullptr, folder);
+  ASSERT_EQ(folder, parent->GetParentCollection());
+  ASSERT_EQ(folder, child->GetParentCollection());
+  ASSERT_NE(folder, outside->GetParentCollection());
+  stedding::SetChildrenFolded(parent, true);
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(outside));
+  ASSERT_EQ(outside, tabs().GetActiveTab());
+  ASSERT_TRUE(tabs().IsTabHidden(tabs().GetIndexOfTab(child)))
+      << "the child is folded away under its parent";
+  ASSERT_FALSE(tabs().IsTabHidden(tabs().GetIndexOfTab(parent)));
+  const tabs::TabHandle parent_handle = parent->GetHandle();
+  const tabs::TabHandle child_handle = child->GetHandle();
+
+  tabs().CloseFolderTabs(folder);
+
+  EXPECT_EQ(nullptr, parent_handle.Get()) << "the parent is still open";
+  EXPECT_EQ(nullptr, child_handle.Get())
+      << "the child folded under its parent is still open";
+  ASSERT_EQ(1, tabs().count());
+  EXPECT_EQ(outside, tabs().GetActiveTab());
+  EXPECT_NE(tabs::TabCollection::Type::FOLDER,
+            outside->GetParentCollection()->type());
+}
+
+// P30-1e; tabs R21, pins H3. A verb of a menu opened on a tab that has since
+// left this strip -- an extension moved it to another window -- takes no
+// tab, so the menu's Close does nothing here. The strip was asked for the
+// tab at no index and stopped the browser.
+TEST_F(TabMenuTabsW2B22Test, AVerbTakesNoTabForATabThatLeftTheStrip) {
+  OpenTabW2B22();
+  ASSERT_EQ(1, tabs().count());
+
+  EXPECT_TRUE(
+      tabs().GetTabsForContextMenuCommand(TabStripModel::kNoTab).empty())
+      << "a tab that is not in this strip";
+  EXPECT_TRUE(tabs().GetTabsForContextMenuCommand(tabs().count()).empty())
+      << "an index past the strip's end";
+  EXPECT_EQ(1u, tabs().GetTabsForContextMenuCommand(0).size())
+      << "a tab of the strip is still taken";
+}
+
+// One window of a profile as its sidebar state controller sees it: the
+// window, its user data and features, and a collapse that lands at once.
+struct SidebarWindowW2B22 {
+  testing::NiceMock<MockBrowserWindowInterface> window;
+  ui::UnownedUserDataHost host;
+  BrowserWindowFeatures features;
+  tabs::TestVerticalTabStripStateControllerDelegate delegate;
+  std::unique_ptr<tabs::VerticalTabStripStateControllerImpl> controller;
+};
+
+// Opens a window on `pref_service`, the profile's preferences, as the browser
+// does: `restored_width` is the width a window reopened from the session
+// carries.
+std::unique_ptr<SidebarWindowW2B22> OpenSidebarWindowW2B22(
+    PrefService* pref_service,
+    int session,
+    std::optional<int> restored_width = std::nullopt) {
+  auto window = std::make_unique<SidebarWindowW2B22>();
+  ON_CALL(window->window, GetUnownedUserDataHost())
+      .WillByDefault(testing::ReturnRef(window->host));
+  ON_CALL(window->window, GetFeatures())
+      .WillByDefault(testing::ReturnRef(window->features));
+  window->controller =
+      std::make_unique<tabs::VerticalTabStripStateControllerImpl>(
+          window->window, pref_service,
+          /*root_action_item=*/nullptr,
+          /*session_service=*/nullptr, SessionID::FromSerializedValue(session),
+          /*restored_state_collapsed=*/std::nullopt, restored_width);
+  window->controller->SetDelegate(&window->delegate);
+  return window;
+}
+
+class SidebarWidthW2B22Test : public testing::Test {
+ protected:
+  void SetUp() override { tabs::RegisterProfilePrefs(prefs_.registry()); }
+
+  bool SharedCollapsed() {
+    return prefs_.GetBoolean(prefs::kVerticalTabsCollapsedState);
+  }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+};
+
+constexpr int kDraggedWidthW2B22 = 400;
+constexpr int kSettingsWidthW2B22 = 300;
+constexpr int kOldWidthW2B22 = 200;
+
+// P30-1c; BACKLOG S-152. Dragging one window's sidebar edge leaves the other
+// windows' widths, and the state a new window starts from is the dragged
+// window's, open. Every other window took the width, and a collapsed one
+// behind it wrote "collapsed" over that state, so the next new window opened
+// with its sidebar collapsed.
+TEST_F(SidebarWidthW2B22Test, ADragLeavesTheOtherWindowsAndTheSharedState) {
+  std::unique_ptr<SidebarWindowW2B22> open = OpenSidebarWindowW2B22(&prefs_, 1);
+  std::unique_ptr<SidebarWindowW2B22> collapsed =
+      OpenSidebarWindowW2B22(&prefs_, 2);
+  collapsed->controller->RequestCollapse(true);
+  ASSERT_TRUE(collapsed->controller->IsCollapsed());
+  ASSERT_FALSE(open->controller->IsCollapsed());
+  const int collapsed_width = collapsed->controller->GetUncollapsedWidth();
+  ASSERT_NE(kDraggedWidthW2B22, collapsed_width);
+
+  open->controller->SetUncollapsedWidth(kDraggedWidthW2B22);
+
+  EXPECT_EQ(kDraggedWidthW2B22,
+            prefs_.GetInteger(prefs::kVerticalTabsUncollapsedWidth));
+  EXPECT_FALSE(SharedCollapsed())
+      << "the collapsed window behind wrote its state over the dragged one's";
+  EXPECT_EQ(collapsed_width, collapsed->controller->GetUncollapsedWidth())
+      << "the other window took the dragged width";
+  EXPECT_TRUE(collapsed->controller->IsCollapsed());
+}
+
+// P30-1c; settings T7. The settings row's width reaches every window at
+// once, and leaves the collapsed state a new window starts from as the last
+// window to be used left it. Each window that took the width wrote its own
+// collapsed state there, the last one's winning.
+TEST_F(SidebarWidthW2B22Test, TheSettingsWidthReachesEveryWindowAndNoMore) {
+  std::unique_ptr<SidebarWindowW2B22> open = OpenSidebarWindowW2B22(&prefs_, 1);
+  std::unique_ptr<SidebarWindowW2B22> collapsed =
+      OpenSidebarWindowW2B22(&prefs_, 2);
+  collapsed->controller->RequestCollapse(true);
+  ASSERT_TRUE(collapsed->controller->IsCollapsed());
+  // The open window was used last: a new window starts open.
+  prefs_.SetBoolean(prefs::kVerticalTabsCollapsedState, false);
+
+  // The settings row writes the preference.
+  prefs_.SetInteger(prefs::kVerticalTabsUncollapsedWidth, kSettingsWidthW2B22);
+
+  EXPECT_EQ(kSettingsWidthW2B22, open->controller->GetUncollapsedWidth());
+  EXPECT_EQ(kSettingsWidthW2B22, collapsed->controller->GetUncollapsedWidth());
+  EXPECT_EQ(kSettingsWidthW2B22,
+            prefs_.GetInteger(prefs::kVerticalTabsUncollapsedWidth));
+  EXPECT_FALSE(SharedCollapsed())
+      << "a window taking the width wrote its own collapsed state";
+  EXPECT_TRUE(collapsed->controller->IsCollapsed());
+  EXPECT_FALSE(open->controller->IsCollapsed());
+}
+
+// P30-1c; sidebar Y47. A window reopened with the width it was closed at
+// keeps that width, and the windows already open keep theirs. Every open
+// window jumped to the reopened window's old width.
+TEST_F(SidebarWidthW2B22Test, AReopenedWindowKeepsItsWidthToItself) {
+  std::unique_ptr<SidebarWindowW2B22> first =
+      OpenSidebarWindowW2B22(&prefs_, 1);
+  std::unique_ptr<SidebarWindowW2B22> second =
+      OpenSidebarWindowW2B22(&prefs_, 2);
+  const int open_width = first->controller->GetUncollapsedWidth();
+  ASSERT_EQ(open_width, second->controller->GetUncollapsedWidth());
+  ASSERT_NE(kOldWidthW2B22, open_width);
+
+  std::unique_ptr<SidebarWindowW2B22> reopened =
+      OpenSidebarWindowW2B22(&prefs_, 3, kOldWidthW2B22);
+
+  EXPECT_EQ(kOldWidthW2B22, reopened->controller->GetUncollapsedWidth());
+  EXPECT_EQ(open_width, first->controller->GetUncollapsedWidth())
+      << "an open window took the reopened window's old width";
+  EXPECT_EQ(open_width, second->controller->GetUncollapsedWidth())
+      << "an open window took the reopened window's old width";
+}
