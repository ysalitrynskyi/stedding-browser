+  ItemKeychain keychain;
+  keychain.SetItem(kChromium, noErr, "chromium-key");
+
+  EXPECT_EQ("chromium-key", KeychainPassword(keychain).GetPassword());
+  ASSERT_TRUE(keychain.HasItem(kStedding));
+  EXPECT_EQ("chromium-key", keychain.Password(kStedding));
+  // The next launch finds its own item.
+  EXPECT_EQ("chromium-key", KeychainPassword(keychain).GetPassword());
