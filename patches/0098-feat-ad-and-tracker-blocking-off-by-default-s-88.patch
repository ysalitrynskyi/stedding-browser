@@ -0,0 +1,48 @@
+<!doctype html>
+<!-- Stedding's blocker tests (docs/features/blocker.md Bk1): one listed and
+     one unlisted script, image, frame and fetch, and a listed tracker. -->
+<title>Blocker test page</title>
+<script src="blocker-ad-script.js"></script>
+<script src="blocker-ok-script.js"></script>
+<script src="blocker-tracker.js"></script>
+<img id="adImage" src="blocker-ad-image.svg">
+<img id="okImage" src="blocker-ok-image.svg">
+<iframe id="adFrame" src="blocker-ad-frame.html"></iframe>
+<iframe id="okFrame" src="blocker-ok-frame.html"></iframe>
+<script>
+  // What loaded, as "ad script,ok script,tracker,ad image,ok image,ad frame,
+  // ok frame,ad fetch,ok fetch", each "1" or "0", once the page has loaded.
+  window.blockerResults = async () => {
+    if (document.readyState !== 'complete') {
+      await new Promise(resolve => addEventListener('load', resolve));
+    }
+    // An image the filter blocked still fires its load event in this
+    // Chromium; it has no size, as nothing came.
+    const drawn = id => {
+      const image = document.getElementById(id);
+      return image.complete && image.naturalWidth > 0;
+    };
+    const framed = id => {
+      try {
+        const body = document.getElementById(id).contentDocument.body;
+        return !!body && body.textContent.trim() === 'frame';
+      } catch (e) {
+        return false;
+      }
+    };
+    const fetched = async url => {
+      try {
+        return (await fetch(url, {cache: 'no-store'})).ok;
+      } catch (e) {
+        return false;
+      }
+    };
+    return [
+      !!window.adScript, !!window.okScript, !!window.tracker,
+      drawn('adImage'), drawn('okImage'),
+      framed('adFrame'), framed('okFrame'),
+      await fetched('blocker-ad-fetch.json'),
+      await fetched('blocker-ok-fetch.json'),
+    ].map(loaded => loaded ? '1' : '0').join(',');
+  };
+</script>
