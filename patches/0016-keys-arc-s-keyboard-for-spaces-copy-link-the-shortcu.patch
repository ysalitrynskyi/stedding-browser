+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace stedding {
+
+// The peek's own keys (docs/features/peek.md): view accelerators, not
+// commands, so the shortcut reference reads them from here rather than from
+// the command tables (shortcuts Z1).
+
+// Cmd-O: the peeked page becomes a tab.
+inline ui::Accelerator PeekPromoteAccelerator() {
+  return ui::Accelerator(ui::VKEY_O, ui::EF_PLATFORM_ACCELERATOR);
+}
+
+// Shift-Cmd-O: the peeked page becomes a split with the current tab.
+inline ui::Accelerator PeekSplitAccelerator() {
+  return ui::Accelerator(ui::VKEY_O,
+                         ui::EF_PLATFORM_ACCELERATOR | ui::EF_SHIFT_DOWN);
+}
+
+}  // namespace stedding
