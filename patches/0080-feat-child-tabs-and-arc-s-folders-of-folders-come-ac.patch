+// R59: a closed parent's children move up a level in its place; R57: a row
+// moved away from its parent goes back to the left.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, AClosedParentsChildrenMoveUp) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  tabs::TabInterface* const grandchild = OpenLinkFrom(child, "c.test");
+  ASSERT_TRUE(grandchild);
+  ASSERT_EQ(28, Indent(grandchild));
+
+  tabs()->CloseWebContentsAt(tabs()->GetIndexOfTab(child),
+                             TabCloseTypes::CLOSE_USER_GESTURE);
+  EXPECT_EQ(stedding::TabToken(page->GetContents()),
+            stedding::TabParentToken(grandchild->GetContents()));
+  EXPECT_EQ(14, Indent(grandchild));
+
+  tabs::TabInterface* const other = OpenLinkFrom(page, "d.test");
+  ASSERT_TRUE(other);
+  // The grandchild, now the page's child, goes to the strip's end, past a
+  // row of its own: it is no longer beside its parent.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("e.test"), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs()->MoveWebContentsAt(tabs()->GetIndexOfTab(grandchild),
+                            tabs()->count() - 1, /*select_after_move=*/false);
+  EXPECT_EQ(0, Indent(grandchild));
+  EXPECT_EQ(14, Indent(other));
+}
