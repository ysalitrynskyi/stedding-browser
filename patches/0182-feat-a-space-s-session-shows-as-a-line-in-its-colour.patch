+            SwitcherSessionLines(chips, {"", "work", "work", ""}));
+  EXPECT_TRUE(SwitcherSessionLines(chips, {"", "", "", ""}).empty());
+  // A dot's segment keeps inside it: a quarter of 6 DIP at each end.
+  EXPECT_EQ((std::vector<SwitcherSpan>{{1, 4}}),
+            SwitcherSessionLines({{0, 6}}, {"work"})[0].segments);
+}
+
+// Two lanes fit under the row: a third session that crosses both earlier
+// ones takes the second lane again, and one that crosses none stays on the
