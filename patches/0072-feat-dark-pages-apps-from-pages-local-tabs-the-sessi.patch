+// web apps Wa12: an app window that comes back after a relaunch -- an
+// update, chrome://restart -- comes back in the app's jar, as a launch
+// does. The desktop restores app windows at start only then, or after a
+// crash (StartupBrowserCreatorImpl, ShouldRestoreApps); a plain start with
+// "continue where you left off" brings back the browser's windows alone.
+IN_PROC_BROWSER_TEST_F(AppJarTest, PRE_ARestoredAppWindowKeepsTheJar) {
+  SessionStartupPref::SetStartupPref(
+      profile(), SessionStartupPref(SessionStartupPref::LAST));
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  content::WebContents* const page = Launch(app_id, "/title2.html");
+  ASSERT_TRUE(page);
+  ASSERT_EQ(WorkJar(), JarOf(page));
+
+  relaunch_.emplace(
+      base::BindRepeating([](const base::CommandLine&) { return true; }));
+  chrome::AttemptRestart();
+  EXPECT_TRUE(
+      g_browser_process->local_state()->GetBoolean(prefs::kWasRestarted));
+}
+
+IN_PROC_BROWSER_TEST_F(AppJarTest, ARestoredAppWindowKeepsTheJar) {
+  // Both windows come back, and the fixture's browser() is the one last
+  // active, which may be the app's: the Spaces are the tabbed window's.
+  spaces::SpaceModel* model = nullptr;
+  for (BrowserWindowInterface* const window :
+       GetAllBrowserWindowInterfaces()) {
+    if (window->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+        spaces::SpaceModel::From(window)) {
+      model = spaces::SpaceModel::From(window);
+    }
+  }
+  ASSERT_TRUE(model) << "the tabbed window came back";
+  std::string work_jar;
+  for (const spaces::RegistryEntry& entry : model->registry()->entries()) {
+    if (entry.name == "Work" && entry.isolated) {
+      work_jar = entry.profile_id;
+    }
+  }
+  ASSERT_FALSE(work_jar.empty()) << "Work came back with its session";
+
+  BrowserWindowInterface* app_window = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    for (BrowserWindowInterface* const window :
+         GetAllBrowserWindowInterfaces()) {
+      if (web_app::AppBrowserController::IsWebApp(window) &&
+          window->GetTabStripModel()->GetActiveWebContents()) {
+        app_window = window;
+      }
+    }
+    return app_window != nullptr;
+  })) << "the app window was restored";
+  content::WebContents* const page =
+      app_window->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  EXPECT_EQ(work_jar, JarOf(page));
+  EXPECT_EQ("jar=work", CookieOf(page));
+}
