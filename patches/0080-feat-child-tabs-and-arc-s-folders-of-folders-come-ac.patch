+// I3: an Arc list that holds only lists becomes a folder of folders. A folder
+// is made around tabs, and one with no tab of its own was not made: its
+// folders came out a level up (the owner's import, 2026-10-21).
+TEST_F(ArcSidebarImportWindowTest, AFolderOfFoldersKeepsItsShape) {
+  constexpr char kNested[] = R"json({
+  "version": 1,
+  "sidebar": {"containers": [
+    {"global": {}},
+    {
+      "spaces": ["space-work", {"id": "space-work", "title": "Work",
+        "containerIDs": ["unpinned", "cont-unpinned", "pinned", "cont-pinned"]}],
+      "items": [
+        "cont-pinned", {"id": "cont-pinned", "parentID": null,
+          "childrenIds": [], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-unpinned", {"id": "cont-unpinned", "parentID": null,
+          "childrenIds": ["list-outer", "tab-z"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "list-outer", {"id": "list-outer", "parentID": "cont-unpinned",
+          "childrenIds": ["list-x", "list-y"], "title": "Outer",
+          "data": {"list": {}}},
+        "list-x", {"id": "list-x", "parentID": "list-outer",
+          "childrenIds": ["tab-x1", "tab-x2"], "title": "X", "data": {"list": {}}},
+        "list-y", {"id": "list-y", "parentID": "list-outer",
+          "childrenIds": ["tab-y1"], "title": "Y", "data": {"list": {}}},
+        "tab-x1", {"id": "tab-x1", "parentID": "list-x", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://x1.example/", "savedTitle": "X1"}}},
+        "tab-x2", {"id": "tab-x2", "parentID": "list-x", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://x2.example/", "savedTitle": "X2"}}},
+        "tab-y1", {"id": "tab-y1", "parentID": "list-y", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://y1.example/", "savedTitle": "Y1"}}},
+        "tab-z", {"id": "tab-z", "parentID": "cont-unpinned", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://z.example/", "savedTitle": "Z"}}}
+      ],
+      "topAppsContainerIDs": []
+    }
+  ]}
+})json";
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(kNested);
+  ASSERT_TRUE(plan.has_value());
+  const ArcImportResult result =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(4u, result.tabs);
+  EXPECT_EQ(3u, result.folders);
+  const Space* const work = SpaceNamed("Work");
+  ASSERT_TRUE(work);
+  const std::vector<tabs::TabInterface*> in_work = TabsIn(work->id());
+  ASSERT_EQ(4u, in_work.size());
+  const auto folder_of = [](const tabs::TabCollection* collection) {
+    return collection && collection->type() == tabs::TabCollection::Type::FOLDER
+               ? static_cast<const tabs::FolderTabCollection*>(collection)
+               : nullptr;
+  };
+  // X1 and X2 in X, Y1 in Y, both inside Outer, in Arc's order; Z loose.
+  const tabs::FolderTabCollection* const x =
+      folder_of(in_work[0]->GetParentCollection());
+  ASSERT_TRUE(x);
+  EXPECT_EQ("X", x->title());
+  EXPECT_EQ(x, in_work[1]->GetParentCollection());
+  const tabs::FolderTabCollection* const y =
+      folder_of(in_work[2]->GetParentCollection());
+  ASSERT_TRUE(y);
+  EXPECT_EQ("Y", y->title());
+  const tabs::FolderTabCollection* const outer =
+      folder_of(x->GetParentCollection());
+  ASSERT_TRUE(outer);
+  EXPECT_EQ("Outer", outer->title());
+  EXPECT_EQ(outer, y->GetParentCollection());
+  EXPECT_EQ(u"Z", in_work[3]->GetContents()->GetTitle());
+  EXPECT_FALSE(folder_of(in_work[3]->GetParentCollection()));
+
+  // A second import adds nothing and finds the folders it made (I12).
+  const ArcImportResult again =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(0u, again.tabs);
+  EXPECT_EQ(0u, again.folders);
+}
