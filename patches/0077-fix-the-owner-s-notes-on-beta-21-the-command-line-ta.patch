@@ -0,0 +1,126 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// windows G9 (GitHub issue 43): with "Continue where you left off", the
+// default, the Dock's icon clicked when no window of the profile is open --
+// its last window closed with the close button while the browser ran on, as
+// the Mac's browser does -- brings that window back, its tabs and folders
+// with it. The Dock opened a new tab page, and the window was only in
+// Recently Closed. With the New Tab page at startup it still opens one.
+
+#import <Cocoa/Cocoa.h>
+
+#include <string>
+
+#include "base/test/run_until.h"
+#import "chrome/browser/app_controller_mac.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/keep_alive/profile_keep_alive_types.h"
+#include "chrome/browser/profiles/keep_alive/scoped_profile_keep_alive.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/keep_alive_registry/keep_alive_types.h"
+#include "components/keep_alive_registry/scoped_keep_alive.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/window_open_disposition.h"
+
+namespace {
+
+class DockReopenTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  // Clicks the Dock's icon with no window showing, and returns the window
+  // that gives once any restore is over.
+  BrowserWindowInterface* ReopenFromTheDock(Profile* profile) {
+    ui_test_utils::BrowserCreatedObserver opened;
+    [AppController.sharedController applicationShouldHandleReopen:NSApp
+                                                hasVisibleWindows:NO];
+    BrowserWindowInterface* const window = opened.Wait();
+    if (!window) {
+      return nullptr;
+    }
+    EXPECT_TRUE(base::test::RunUntil(
+        [&] { return !SessionRestore::IsRestoring(profile); }));
+    return window;
+  }
+
+  // The tab of `window` on `host`, or null.
+  static tabs::TabInterface* Find(BrowserWindowInterface* window,
+                                  const std::string& host) {
+    TabStripModel* const tabs = window->GetTabStripModel();
+    for (int i = 0; i < tabs->count(); ++i) {
+      tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+      if (tab->GetContents()->GetVisibleURL().host() == host) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(DockReopenTest, TheDockBringsTheLastWindowBack) {
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_TRUE(SessionStartupPref::GetStartupPref(profile->GetPrefs())
+                  .ShouldRestoreLastSession())
+      << "continuing where it left off is the default";
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(),
+      embedded_test_server()->GetURL("kept-a.test", "/title1.html")));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("kept-b.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_EQ(2, browser()->tab_strip_model()->count());
+  tabs::FolderTabCollection* const folder =
+      browser()->tab_strip_model()->AddToNewFolder({0, 1});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Kept");
+
+  // The browser runs on with no window, as the Mac's does.
+  const ScopedKeepAlive keep_alive(KeepAliveOrigin::SESSION_RESTORE,
+                                   KeepAliveRestartOption::DISABLED);
+  const ScopedProfileKeepAlive profile_keep_alive(
+      profile, ProfileKeepAliveOrigin::kBrowserWindow);
+  CloseBrowserSynchronously(browser());
+
+  BrowserWindowInterface* const back = ReopenFromTheDock(profile);
+  ASSERT_TRUE(back);
+  SetBrowser(back);
+  tabs::TabInterface* const a = Find(back, "kept-a.test");
+  tabs::TabInterface* const b = Find(back, "kept-b.test");
+  ASSERT_TRUE(a) << "the Dock opened a new window, not the last one";
+  ASSERT_TRUE(b);
+  const tabs::TabCollection* const parent = a->GetParentCollection();
+  ASSERT_TRUE(parent);
+  EXPECT_EQ(tabs::TabCollection::Type::FOLDER, parent->type())
+      << "the folder did not come back";
+  EXPECT_EQ(parent, b->GetParentCollection());
+
+  // With the New Tab page at startup, the Dock opens a new window.
+  SessionStartupPref::SetStartupPref(
+      profile->GetPrefs(), SessionStartupPref(SessionStartupPref::DEFAULT));
+  CloseBrowserSynchronously(back);
+  BrowserWindowInterface* const fresh = ReopenFromTheDock(profile);
+  ASSERT_TRUE(fresh);
+  SetBrowser(fresh);
+  EXPECT_FALSE(Find(fresh, "kept-a.test"))
+      << "the Dock restored though the profile starts on the New Tab page";
+}
+
+}  // namespace
