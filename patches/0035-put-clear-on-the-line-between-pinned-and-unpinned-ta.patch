+++ b/chrome/browser/ui/views/tabs/common/clear_tabs_separator.cc
@@ -0,0 +1,100 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/clear_tabs_separator.h"
+
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "cc/paint/paint_flags.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/font_list.h"
+#include "ui/views/controls/separator.h"
+
+namespace {
+
+constexpr int kRowHeight = 22;
+constexpr int kSideInset = 12;
+constexpr int kLabelGap = 8;
+constexpr SkColor kHairline = SkColorSetA(SK_ColorWHITE, 0x2B);
+constexpr SkColor kLabel = SkColorSetA(SK_ColorWHITE, 0x8C);
+
+const gfx::FontList& LabelFont() {
+  static const base::NoDestructor<gfx::FontList> font(
+      gfx::FontList({"system-ui"}, gfx::Font::NORMAL, 11,
+                    gfx::Font::Weight::MEDIUM));
+  return *font;
+}
+
+}  // namespace
+
+ClearTabsSeparator::ClearTabsSeparator() = default;
+ClearTabsSeparator::~ClearTabsSeparator() = default;
+
+void ClearTabsSeparator::SetClearCallback(base::RepeatingClosure callback) {
+  clear_callback_ = std::move(callback);
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+gfx::Size ClearTabsSeparator::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  if (!clear_callback_) {
+    return views::Separator::CalculatePreferredSize(available_size);
+  }
+  return gfx::Size(0, kRowHeight);
+}
+
+void ClearTabsSeparator::OnPaint(gfx::Canvas* canvas) {
+  if (!clear_callback_) {
+    views::Separator::OnPaint(canvas);
+    return;
+  }
+
+  const std::u16string label = u"Clear";
+  const int label_width =
+      gfx::Canvas::GetStringWidth(label, LabelFont()) + 2 * kLabelGap;
+  const gfx::Rect bounds = GetContentsBounds();
+  const int line_y = bounds.CenterPoint().y();
+
+  cc::PaintFlags flags;
+  flags.setColor(kHairline);
+  flags.setStrokeWidth(1);
+  canvas->DrawLine(gfx::PointF(bounds.x() + kSideInset, line_y),
+                   gfx::PointF(bounds.right() - kSideInset - label_width,
+                               line_y),
+                   flags);
+
+  clear_rect_ =
+      gfx::Rect(bounds.right() - kSideInset - label_width, bounds.y(),
+                label_width, bounds.height());
+  canvas->DrawStringRectWithFlags(label, LabelFont(), kLabel, clear_rect_,
+                                  gfx::Canvas::TEXT_ALIGN_CENTER);
+}
+
+bool ClearTabsSeparator::OnMousePressed(const ui::MouseEvent& event) {
+  pressed_in_clear_ =
+      clear_callback_ && clear_rect_.Contains(event.location());
+  return pressed_in_clear_;
+}
+
+void ClearTabsSeparator::OnMouseReleased(const ui::MouseEvent& event) {
+  if (pressed_in_clear_ && clear_rect_.Contains(event.location()) &&
+      clear_callback_) {
+    clear_callback_.Run();
+  }
+  pressed_in_clear_ = false;
+}
+
+std::u16string ClearTabsSeparator::GetRenderedTooltipText(
+    const gfx::Point& p) const {
+  if (clear_callback_ && clear_rect_.Contains(p)) {
+    return u"Close this Space's tabs";
+  }
+  return std::u16string();
+}
+
+BEGIN_METADATA(ClearTabsSeparator)
+END_METADATA
