+void SteddingSpacesHandler::HandleListBackups(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          &spaces::ListBackups,
+          spaces::BackupDirectory(Profile::FromWebUI(web_ui())->GetPath())),
+      base::BindOnce(&SteddingSpacesHandler::OnBackupsListed,
+                     weak_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void SteddingSpacesHandler::OnBackupsListed(
+    const std::string& callback_id,
+    std::vector<spaces::BackupFile> files) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  base::ListValue list;
+  for (const spaces::BackupFile& file : files) {
+    base::DictValue entry;
+    entry.Set("path", file.path.AsUTF8Unsafe());
+    entry.Set("label", base::TimeFormatShortDateAndTime(file.time));
+    list.Append(std::move(entry));
+  }
+  ResolveJavascriptCallback(base::Value(callback_id), list);
+}
+
+void SteddingSpacesHandler::HandleBackUpNow(const base::ListValue& args) {
+  AllowJavascript();
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  Profile* const profile = Profile::FromWebUI(web_ui());
+  if (!browser || !profile) {
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(&spaces::WriteBackup,
+                     spaces::BackupDirectory(profile->GetPath()),
+                     spaces::PlanToJson(spaces::SnapshotSidebar(browser)),
+                     base::Time::Now()));
+}
+
+void SteddingSpacesHandler::HandleRestoreBackup(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  spaces::RestoreBackupAsync(
+      browser, base::FilePath::FromUTF8Unsafe(args[1].GetString()),
+      base::BindOnce(&SteddingSpacesHandler::OnRestoreDone,
+                     weak_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void SteddingSpacesHandler::OnRestoreDone(
+    const std::string& callback_id,
+    std::optional<spaces::ArcImportResult> result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  PushSpaces();
+  ResolveJavascriptCallback(
+      base::Value(callback_id),
+      base::Value(result ? spaces::DescribeArcImportResult(*result)
+                         : u"Nothing was restored."));
+}
+
+void SteddingSpacesHandler::HandleExportSpace(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  const std::optional<spaces::SpaceId> id = spaces::SpaceId::FromOptionalToken(
+      base::Token::FromString(args[1].GetString()));
+  spaces::SpaceModel* const model =
+      browser ? spaces::SpaceModel::From(browser) : nullptr;
+  if (!model || !id || !model->GetSpace(*id)) {
+    ResolveJavascriptCallback(base::Value(args[0].GetString()),
+                              base::Value(std::string()));
+    return;
+  }
+  base::FilePath downloads;
+  base::PathService::Get(chrome::DIR_DEFAULT_DOWNLOADS, &downloads);
+  spaces::ExportPlanAsync(
+      spaces::SnapshotSpace(browser, *id), downloads,
+      "Stedding Space " + base::UTF16ToUTF8(model->DisplayName(*id)),
+      base::BindOnce(&SteddingSpacesHandler::OnExportDone,
+                     weak_factory_.GetWeakPtr(), args[0].GetString()));
+}
+
+void SteddingSpacesHandler::OnExportDone(const std::string& callback_id,
+                                         base::FilePath path) {
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(base::Value(callback_id),
+                              base::Value(path.AsUTF8Unsafe()));
+  }
+}
+
+void SteddingSpacesHandler::HandleImportSidebarFile(
+    const base::ListValue& args) {
+  AllowJavascript();
+  if (select_file_dialog_) {
+    return;
+  }
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this,
+      std::make_unique<ChromeSelectFilePolicy>(web_ui()->GetWebContents()));
+  ui::SelectFileDialog::FileTypeInfo file_type_info;
+  file_type_info.extensions.resize(1);
+  file_type_info.extensions[0].push_back(FILE_PATH_LITERAL("json"));
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_OPEN_FILE, std::u16string(),
+      base::FilePath(), &file_type_info, 0, base::FilePath::StringType(),
+      browser ? browser->GetWindow()->GetNativeWindow() : gfx::NativeWindow(),
+      nullptr);
+}
+
+void SteddingSpacesHandler::FileSelected(const ui::SelectedFileInfo& file,
+                                         int index) {
+  select_file_dialog_ = nullptr;
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  spaces::RestoreBackupAsync(
+      browser, file.path(),
+      base::BindOnce(&SteddingSpacesHandler::OnSidebarFileImported,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SteddingSpacesHandler::FileSelectionCanceled() {
+  select_file_dialog_ = nullptr;
+}
+
+void SteddingSpacesHandler::OnSidebarFileImported(
+    std::optional<spaces::ArcImportResult> result) {
+  if (!IsJavascriptAllowed()) {
+    return;
+  }
+  PushSpaces();
+  FireWebUIListener(
+      "stedding-sidebar-imported",
+      base::Value(result ? spaces::DescribeArcImportResult(*result)
+                         : u"That file is not a sidebar."));
+}
