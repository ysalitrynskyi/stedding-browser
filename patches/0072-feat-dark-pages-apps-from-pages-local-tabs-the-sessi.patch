@@ -0,0 +1,71 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_COMMON_STEDDING_WEB_APPS_H_
+#define CHROME_COMMON_STEDDING_WEB_APPS_H_
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/values.h"
+
+class PrefService;
+
+namespace stedding {
+
+// What Stedding keeps about the apps made from pages (docs/features/web-apps.md),
+// for code below the UI layer: the install command records an app's jar
+// here, and the UI reads it back.
+
+// web apps Wa11: the profile preference that maps an app's id to the cookie
+// jar of the Space it was made in: a Space's partition name (ADR 0019). An
+// app made in a Space that shares the profile's jar has no entry. Data, not
+// a setting: no settings row writes it.
+inline constexpr char kAppJarsPref[] = "stedding.apps.jars";
+
+// web apps Wa7, Wa18: the profile preference that maps an app's id to the
+// path of its launcher as it was when Stedding put a tile for it in the
+// Dock, so removing the app takes away that tile and no other. Mac only in
+// use; registered everywhere.
+inline constexpr char kAppDockTilesPref[] = "stedding.apps.dock_tiles";
+
+// web apps Wa11: what the install command records for `app_id`, made from a
+// page in the partition `partition_domain`/`partition_name`: the name of a
+// Space's own jar (domain stedding::kSpacePartitionDomain, a name), or no
+// entry for the shared jar or any other partition, which also forgets what
+// an earlier install of the same app recorded. Does nothing when the
+// preference is not registered.
+void RecordAppJarForPartition(PrefService& prefs,
+                              std::string_view app_id,
+                              std::string_view partition_domain,
+                              std::string_view partition_name);
+
+// web apps Wa18: the record goes with the app.
+void ForgetAppJar(PrefService& prefs, std::string_view app_id);
+
+// The jar name recorded for `app_id`; empty when it has none.
+std::string RecordedAppJar(const PrefService& prefs, std::string_view app_id);
+
+// web apps Wa11, Wa13: the jar the pages `app_id` opens are made in now: the
+// recorded jar while a Space of `registry` (the Space list, as
+// stedding.spaces.registry holds it) keeps it -- that jar its name and its
+// own session on -- and empty, the shared jar, otherwise: no record, the
+// Space deleted, or its own session turned off.
+std::string AppJarInUse(const base::DictValue& jars,
+                        const base::ListValue& registry,
+                        std::string_view app_id);
+
+// The same, read from the profile's `prefs`. Empty when either preference
+// is not registered there.
+std::string AppJarInUse(const PrefService& prefs, std::string_view app_id);
+
+// web apps Wa13: the ids of the apps that recorded `jar`, in id order. Empty
+// for an empty `jar`.
+std::vector<std::string> AppsRecordingJar(const PrefService& prefs,
+                                          std::string_view jar);
+
+}  // namespace stedding
+
+#endif  // CHROME_COMMON_STEDDING_WEB_APPS_H_
