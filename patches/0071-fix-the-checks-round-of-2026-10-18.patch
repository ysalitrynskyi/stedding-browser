+    EXPECT_EQ(kept, FolderOf(j2));
+    for (tabs::TabInterface* const tab : {j1, j2}) {
+      EXPECT_EQ(*jar, m->SpaceForTab(tab));
+      EXPECT_TRUE(spaces::IsSpaceStoragePartition(
+          spaces::StoragePartitionConfigForWebContents(tab->GetContents())))
+          << "back in the Space's own jar";
+    }
+  }
+}
