+// web apps Wa5, Wa18, sessions S48 (P09-1g): Mail and Docs share the session
+// "Clients". An app made from a page in Docs opens with that session, and the
+// install dialog and the uninstall box say so by the session's name; neither
+// names Mail, the first of its Spaces, which they named, and only it, though
+// Docs' tabs are in the same jar. A Space alone on its session is still
+// named for itself.
+IN_PROC_BROWSER_TEST_F(AppSessionNotesW2B09Test,
+                       TheAppsNotesNameASessionSeveralSpacesShare) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId mail = model->AddSpace("Mail", SK_ColorBLUE)->id();
+  const spaces::SpaceId docs = model->AddSpace("Docs", SK_ColorGREEN)->id();
+  const std::string clients = model->MakeSession("Clients");
+  ASSERT_FALSE(clients.empty());
+  model->SetSpaceSession(mail, clients);
+  model->SetSpaceSession(docs, clients);
+  ASSERT_EQ(clients, model->SessionOf(mail));
+  ASSERT_EQ(clients, model->SessionOf(docs));
+
+  ASSERT_TRUE(model->SetActiveSpace(docs));
+  content::WebContents* const page = OpenPage(PageUrl());
+  ASSERT_TRUE(page);
+  ASSERT_EQ(docs, model->FindSpaceForTab(tabs()->GetActiveTab()));
+  EXPECT_EQ(u"Opens with the session “Clients”.",
+            spaces::AppSessionLine(page));
+  const std::u16string text = InstallDialogText();
+  EXPECT_NE(std::u16string::npos,
+            text.find(u"Opens with the session “Clients”."))
+      << text;
+  EXPECT_EQ(std::u16string::npos, text.find(u"“Mail”"))
+      << "the dialog names the session's first Space: " << text;
+
+  const webapps::AppId app_id =
+      web_app::InstallWebAppFromPage(browser(), PageUrl());
+  ASSERT_FALSE(app_id.empty());
+  ASSERT_EQ(clients, stedding::RecordedAppJar(*profile()->GetPrefs(), app_id));
+  EXPECT_EQ(
+      u"This also signs the tabs of the session “Clients” out of "
+      u"the site.",
+      spaces::AppClearDataSpaceNote(profile(), app_id));
+
+  // Mail goes back to the shared session: Docs is alone on Clients, and the
+  // note names it, as for any Space with a session of its own.
+  model->SetSpaceSession(mail, std::string());
+  ASSERT_FALSE(model->SpaceIsIsolated(mail));
+  ASSERT_EQ(clients, model->SessionOf(docs));
+  EXPECT_EQ(u"This also signs the tabs of “Docs” out of the site.",
+            spaces::AppClearDataSpaceNote(profile(), app_id));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/audit_w2_b10_browsertest.cc b/chrome/test/stedding/audit_w2_b10_browsertest.cc
