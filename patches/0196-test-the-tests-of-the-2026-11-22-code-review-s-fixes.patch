+// P28-1e, tabs R60: the count beside a folded parent is of the rows the fold
+// takes off the list. A pin keeps its row (R56), and a tab in another Space is
+// not on this list, so neither is counted. With one of each beside a plain
+// child, the row said +3 over the one row that went.
+IN_PROC_BROWSER_TEST_F(ChildTabsW2B21Test, AFoldCountsOnlyTheRowsItTakes) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  tabs::TabInterface* const pinned = OpenLinkFrom(page, "c.test");
+  ASSERT_TRUE(pinned);
+  tabs::TabInterface* const elsewhere = OpenLinkFrom(page, "d.test");
+  ASSERT_TRUE(elsewhere);
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  model->SetSpacePinned(pinned, true);
+  const spaces::SpaceId other = model->AddSpace("Other", SK_ColorBLUE)->id();
+  model->SetSpaceForTab(elsewhere, other);
+  ASSERT_EQ(other, model->SpaceForTab(elsewhere));
+  tabs()->ActivateTabAt(index(page));
+  ASSERT_EQ(page, tabs()->GetActiveTab());
+
+  stedding::ExecuteTabMenuVerb(*tabs(), index(page),
+                               TabStripModel::CommandSteddingFoldChildTabs);
+  ASSERT_TRUE(stedding::ChildrenFolded(page->GetContents()));
+  EXPECT_TRUE(hidden(child));
+  EXPECT_FALSE(hidden(pinned)) << "a fold took a pin's row";
+  EXPECT_EQ(1, stedding::FoldedChildCount(*tabs(), page));
+  TabView* const row = DrawnRow(page);
+  ASSERT_TRUE(row);
+  EXPECT_TRUE(row->fold_badge_for_testing()->GetVisible());
+  EXPECT_EQ(u"+1", row->fold_badge_for_testing()->GetText())
+      << "the count took in a pin and a tab of another Space";
+}
