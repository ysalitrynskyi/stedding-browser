diff --git a/chrome/browser/ui/archive/tab_archiver.cc b/chrome/browser/ui/archive/tab_archiver.cc
new file mode 100644
index 0000000000000..f70263c5fe574
--- /dev/null
+++ b/chrome/browser/ui/archive/tab_archiver.cc
@@ -0,0 +1,146 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/archive/tab_archiver.h"
+
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_collection.h"
+
+namespace stedding {
+
+TabArchiver::TabArchiver(BrowserWindowInterface& browser, PrefService& prefs)
+    : browser_(browser), prefs_(prefs) {
+  TabStripModel* const model = browser_->GetTabStripModel();
+  model->AddObserver(this);
+  for (int i = 0; i < model->count(); ++i) {
+    Touch(model->GetTabAtIndex(i));
+  }
+  pref_registrar_.Init(&*prefs_);
+  pref_registrar_.Add(prefs::kArchiveIdleHours,
+                      base::BindRepeating(&TabArchiver::UpdateTimer,
+                                          base::Unretained(this)));
+  UpdateTimer();
+}
+
+TabArchiver::~TabArchiver() {
+  if (TabStripModel* const model = browser_->GetTabStripModel()) {
+    model->RemoveObserver(this);
+  }
+}
+
+void TabArchiver::Sweep() {
+  const base::TimeDelta threshold = IdleThreshold();
+  if (threshold.is_zero()) {
+    return;
+  }
+  TabStripModel* const model = browser_->GetTabStripModel();
+  const base::TimeTicks now = Now();
+
+  // Collect first, close after: closing shifts indices.
+  std::vector<tabs::TabHandle> idle;
+  for (int i = 0; i < model->count(); ++i) {
+    tabs::TabInterface* const tab = model->GetTabAtIndex(i);
+    if (IsProtected(tab)) {
+      continue;
+    }
+    const auto it = last_active_.find(tab->GetHandle());
+    const base::TimeTicks since = it == last_active_.end() ? now : it->second;
+    if (now - since >= threshold) {
+      idle.push_back(tab->GetHandle());
+    }
+  }
+  for (const tabs::TabHandle handle : idle) {
+    tabs::TabInterface* const tab = handle.Get();
+    // Never close the window's last tab: that closes the window.
+    if (!tab || model->count() <= 1) {
+      break;
+    }
+    const int index = model->GetIndexOfTab(tab);
+    if (index == TabStripModel::kNoTab) {
+      continue;
+    }
+    // Into the recently-closed list, so ⇧⌘T brings it back.
+    model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+}
+
+base::TimeTicks TabArchiver::last_active_for_testing(
+    const tabs::TabInterface* tab) const {
+  const auto it = last_active_.find(tab->GetHandle());
+  return it == last_active_.end() ? base::TimeTicks() : it->second;
+}
+
+void TabArchiver::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // GetInsert()/GetRemove() CHECK the change type, so ask first.
+  if (change.type() == TabStripModelChange::kInserted) {
+    for (const auto& contents : change.GetInsert()->contents) {
+      Touch(contents.tab);
+    }
+  } else if (change.type() == TabStripModelChange::kRemoved) {
+    for (const auto& removed : change.GetRemove()->contents) {
+      last_active_.erase(removed.tab->GetHandle());
+    }
+  }
+  if (selection.active_tab_changed() && selection.new_tab) {
+    Touch(selection.new_tab);
+  }
+}
+
+base::TimeDelta TabArchiver::IdleThreshold() const {
+  const int hours = prefs_->GetInteger(prefs::kArchiveIdleHours);
+  return hours > 0 ? base::Hours(hours) : base::TimeDelta();
+}
+
+bool TabArchiver::IsProtected(const tabs::TabInterface* tab) const {
+  if (tab->IsActivated() || tab->IsPinned()) {
+    return true;
+  }
+  if (const spaces::SpaceModel* const spaces =
+          spaces::SpaceModel::From(&*browser_);
+      spaces && spaces->IsSpacePinned(tab)) {
+    return true;
+  }
+  for (const tabs::TabCollection* collection = tab->GetParentCollection();
+       collection; collection = collection->GetParentCollection()) {
+    if (collection->type() == tabs::TabCollection::Type::FOLDER) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void TabArchiver::Touch(tabs::TabInterface* tab) {
+  if (tab) {
+    last_active_[tab->GetHandle()] = Now();
+  }
+}
+
+base::TimeTicks TabArchiver::Now() const {
+  return clock_ ? clock_->NowTicks() : base::TimeTicks::Now();
+}
+
+void TabArchiver::UpdateTimer() {
+  if (IdleThreshold().is_zero()) {
+    timer_.Stop();
+    return;
+  }
+  if (!timer_.IsRunning()) {
+    timer_.Start(FROM_HERE, kSweepInterval,
+                 base::BindRepeating(&TabArchiver::Sweep,
+                                     base::Unretained(this)));
+  }
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/archive/tab_archiver.h b/chrome/browser/ui/archive/tab_archiver.h
new file mode 100644
index 0000000000000..fbaff6acaaf51
--- /dev/null
+++ b/chrome/browser/ui/archive/tab_archiver.h
@@ -0,0 +1,84 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_ARCHIVE_TAB_ARCHIVER_H_
+#define CHROME_BROWSER_UI_ARCHIVE_TAB_ARCHIVER_H_
+
+#include <map>
+
+#include "base/memory/raw_ptr.h"
+#include "base/time/tick_clock.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/tabs/public/tab_interface.h"
+
+class BrowserWindowInterface;
+class PrefService;
+class TabStripModel;
+
+namespace stedding {
+
+// Auto-archive (docs/features/archive.md): closes unpinned tabs nobody has
+// looked at for longer than the profile's idle threshold, into the
+// recently-closed list so they can come back. One per normal window, owned by
+// BrowserWindowFeatures next to the SpaceModel.
+//
+// Idle time is tracked here rather than read from WebContents, so a tab opened
+// in the background counts from when it was opened and a test window (whose
+// contents are never shown) behaves like a real one.
+class TabArchiver : public TabStripModelObserver {
+ public:
+  // How often the sweep runs. The threshold is hours, so this is generous.
+  static constexpr base::TimeDelta kSweepInterval = base::Minutes(5);
+
+  TabArchiver(BrowserWindowInterface& browser, PrefService& prefs);
+  TabArchiver(const TabArchiver&) = delete;
+  TabArchiver& operator=(const TabArchiver&) = delete;
+  ~TabArchiver() override;
+
+  // Closes every tab that qualifies right now. Public so tests and a future
+  // "archive now" command can call it; the timer calls it too.
+  void Sweep();
+
+  // The moment `tab` was last opened or activated, as this archiver saw it.
+  base::TimeTicks last_active_for_testing(const tabs::TabInterface* tab) const;
+
+  // Tests hand in a clock they can advance by hours without driving every
+  // timer in the process through a mock task environment.
+  void set_tick_clock_for_testing(const base::TickClock* clock) {
+    clock_ = clock;
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+ private:
+  // Threshold from the preference; zero means the feature is off.
+  base::TimeDelta IdleThreshold() const;
+
+  // True when `tab` must never be archived: pinned in either tier, in a
+  // folder, or the tab the user is looking at.
+  bool IsProtected(const tabs::TabInterface* tab) const;
+
+  void Touch(tabs::TabInterface* tab);
+  void UpdateTimer();
+
+  base::TimeTicks Now() const;
+
+  const raw_ref<BrowserWindowInterface> browser_;
+  const raw_ref<PrefService> prefs_;
+  raw_ptr<const base::TickClock> clock_ = nullptr;
+  std::map<tabs::TabHandle, base::TimeTicks> last_active_;
+  PrefChangeRegistrar pref_registrar_;
+  base::RepeatingTimer timer_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_ARCHIVE_TAB_ARCHIVER_H_
diff --git a/chrome/browser/ui/archive/tab_archiver_unittest.cc b/chrome/browser/ui/archive/tab_archiver_unittest.cc
new file mode 100644
index 0000000000000..02c3e2239a447
--- /dev/null
+++ b/chrome/browser/ui/archive/tab_archiver_unittest.cc
@@ -0,0 +1,134 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/archive.md, behaviours A1–A5.
+
+#include "chrome/browser/ui/archive/tab_archiver.h"
+
+#include "base/test/simple_test_tick_clock.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/prefs/pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class TabArchiverTest : public BrowserWithTestWindowTest {
+ public:
+  TabArchiverTest()
+      : BrowserWithTestWindowTest(
+            base::test::TaskEnvironment::TimeSource::MOCK_TIME) {}
+
+ protected:
+  void SetUp() override {
+    BrowserWithTestWindowTest::SetUp();
+    prefs()->SetInteger(prefs::kArchiveIdleHours, 12);
+    clock_.SetNowTicks(base::TimeTicks::Now());
+    archiver_ = std::make_unique<TabArchiver>(*browser(), *prefs());
+    archiver_->set_tick_clock_for_testing(&clock_);
+  }
+  void TearDown() override {
+    archiver_.reset();
+    BrowserWithTestWindowTest::TearDown();
+  }
+
+  PrefService* prefs() { return profile()->GetPrefs(); }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  TabArchiver& archiver() { return *archiver_; }
+
+  // Three tabs; the first one added ends up last and active after AddTab's
+  // insert-at-front, so activate index 0 explicitly to keep things readable.
+  void AddThreeTabs() {
+    AddTab(browser(), GURL("https://a.example/"));
+    AddTab(browser(), GURL("https://b.example/"));
+    AddTab(browser(), GURL("https://c.example/"));
+    tabs().ActivateTabAt(0);
+  }
+
+  // Hours pass on the archiver's clock only; the task environment stays put
+  // so Chromium's own periodic timers do not have to run through a day.
+  void Idle(base::TimeDelta delta) { clock_.Advance(delta); }
+
+ private:
+  base::SimpleTestTickClock clock_;
+  std::unique_ptr<TabArchiver> archiver_;
+};
+
+// A1: idle unpinned tabs go; the active tab stays.
+TEST_F(TabArchiverTest, ArchivesIdleUnpinnedTabs) {
+  AddThreeTabs();
+  ASSERT_EQ(3, tabs().count());
+  Idle(base::Hours(13));
+  archiver().Sweep();
+  EXPECT_EQ(1, tabs().count());
+  EXPECT_EQ(0, tabs().active_index());
+}
+
+// A1 (negative): nothing goes before the threshold.
+TEST_F(TabArchiverTest, KeepsTabsUnderTheThreshold) {
+  AddThreeTabs();
+  Idle(base::Hours(11));
+  archiver().Sweep();
+  EXPECT_EQ(3, tabs().count());
+}
+
+// A2: the active tab is never archived, and activating a tab resets its clock.
+TEST_F(TabArchiverTest, NeverArchivesTheActiveTab) {
+  AddThreeTabs();
+  Idle(base::Hours(13));
+  tabs().ActivateTabAt(2);  // looked at just now
+  archiver().Sweep();
+  // The old active tab (0) was touched when it became active at t=0 and is
+  // now idle; tab 2 is active; tab 1 is idle.
+  EXPECT_EQ(1, tabs().count());
+  EXPECT_TRUE(tabs().GetActiveTab()->IsActivated());
+}
+
+// A3: pinned in either tier survives.
+TEST_F(TabArchiverTest, KeepsPinnedTabs) {
+  AddThreeTabs();
+  tabs().SetTabPinned(1, true);  // essentials
+  spaces::SpaceModel::From(browser())->SetSpacePinned(tabs().GetTabAtIndex(2),
+                                                     true);
+  Idle(base::Hours(13));
+  archiver().Sweep();
+  EXPECT_EQ(3, tabs().count());
+}
+
+// A4: tabs in a folder survive.
+TEST_F(TabArchiverTest, KeepsFolderTabs) {
+  AddThreeTabs();
+  tabs().AddToNewFolder({2});
+  Idle(base::Hours(13));
+  archiver().Sweep();
+  EXPECT_EQ(2, tabs().count());  // tab 1 archived, tab 2 kept in its folder
+}
+
+// A5: zero hours turns the sweep off.
+TEST_F(TabArchiverTest, ZeroHoursDisables) {
+  AddThreeTabs();
+  prefs()->SetInteger(prefs::kArchiveIdleHours, 0);
+  Idle(base::Hours(48));
+  archiver().Sweep();
+  EXPECT_EQ(3, tabs().count());
+}
+
+// A1 by the timer rather than an explicit sweep: the idle hours pass on the
+// archiver's clock, then one sweep interval passes for real.
+TEST_F(TabArchiverTest, TimerSweeps) {
+  AddThreeTabs();
+  Idle(base::Hours(13));
+  task_environment()->FastForwardBy(TabArchiver::kSweepInterval);
+  EXPECT_EQ(1, tabs().count());
+}
+
+}  // namespace
+}  // namespace stedding
