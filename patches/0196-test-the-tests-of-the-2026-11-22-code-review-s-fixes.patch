@@ -0,0 +1,151 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/sidebar-file.md Sf10, Sf33: pairs two computers make at once,
+// and fields past a reader's caps, without a browser.
+
+#include <map>
+#include <string>
+
+#include "base/strings/string_util.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_state.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces::sidebar_sync {
+namespace {
+
+// Ids that sort a < b < c < x, in the shape of a Space's token.
+constexpr char kIdA[] = "11111111111111111111111111111111";
+constexpr char kIdB[] = "22222222222222222222222222222222";
+constexpr char kIdC[] = "33333333333333333333333333333333";
+constexpr char kIdX[] = "44444444444444444444444444444444";
+
+constexpr char kSpaceB13[] = "0123456789ABCDEF0123456789ABCDEF";
+constexpr char kPinB13[] = "tab:11111111-1111-4111-8111-111111111111";
+constexpr char kFolderB13[] = "folder:AAAAAAAAAAAAAAAABBBBBBBBBBBBBBBB";
+constexpr char kWriterB13[] = "aaaaaaaaaaaaaaaa";
+
+// P17-1b (Sf10): two computers that join at once and pair their own item
+// with a third computer's, whose id is the largest, settle on one id: the
+// smallest of the three, in either order of merging. Only one of the two
+// pairs was kept, and the two items stayed two on every computer.
+TEST(SidebarSyncAliasB13Test, TwoJoinsThatPairOneIdTwiceSettleOnOneId) {
+  State q;
+  q.aliases[kIdX] = kIdB;
+  State r;
+  r.aliases[kIdX] = kIdA;
+
+  State one = q;
+  MergeState(one, r);
+  const std::map<std::string, std::string> resolved =
+      ResolveAliases(one.aliases);
+  EXPECT_EQ(kIdA, Canonical(resolved, kIdB));
+  EXPECT_EQ(kIdA, Canonical(resolved, kIdX));
+  EXPECT_EQ(kIdA, Canonical(resolved, kIdA));
+
+  State other = r;
+  MergeState(other, q);
+  EXPECT_EQ(resolved, ResolveAliases(other.aliases));
+}
+
+// P17-1b (Sf10): a pair dropped from an id whose larger target already
+// names another keeps every link down the chain.
+TEST(SidebarSyncAliasB13Test, AChainOfPairsKeepsEveryLink) {
+  State into;
+  into.aliases[kIdX] = kIdC;
+  into.aliases[kIdC] = kIdB;
+  State peer;
+  peer.aliases[kIdX] = kIdA;
+
+  State merged = into;
+  EXPECT_TRUE(MergeState(merged, peer));
+  const std::map<std::string, std::string> resolved =
+      ResolveAliases(merged.aliases);
+  for (const char* id : {kIdB, kIdC, kIdX}) {
+    SCOPED_TRACE(id);
+    EXPECT_EQ(kIdA, Canonical(resolved, id));
+  }
+
+  State reverse = peer;
+  MergeState(reverse, into);
+  EXPECT_EQ(resolved, ResolveAliases(reverse.aliases));
+
+  // Merged again, nothing changes.
+  State again = merged;
+  EXPECT_FALSE(MergeState(again, peer));
+  EXPECT_FALSE(MergeState(again, into));
+}
+
+// P17-1a (Sf33): a file this computer writes is one every reader takes,
+// whatever its ledger holds. A name, title or icon past kMaxTextLength is cut
+// between two characters, and a home past kMaxUrlLength is left out. The
+// file went out whole, and every other computer refused it.
+TEST(SidebarSyncFileB13Test, AFieldPastItsCapIsCutNotWrittenWhole) {
+  // Two bytes a character, so a cut at an odd byte would split one.
+  std::string long_name;
+  for (int i = 0; i < 200; ++i) {
+    long_name += "\xD0\xB6";
+  }
+  const std::string long_home =
+      "https://example.com/#" + std::string(kMaxUrlLength, 'a');
+  const std::string fine_home = "https://example.com/kept";
+  const Stamp stamp{1000, kWriterB13};
+
+  State state;
+  Record space(Kind::kSpace);
+  space.f[kFieldName] = Field{long_name, stamp};
+  space.f[kFieldIcon] = Field{long_name, stamp};
+  space.f[kFieldColor] = Field{"#3366FF", stamp};
+  state.records[kSpaceB13] = space;
+  state.lists[kSpacesList].order = {kSpaceB13};
+  state.lists[kSpacesList].s = stamp;
+  Record folder(Kind::kFolder);
+  folder.f[kFieldTitle] = Field{long_name, stamp};
+  folder.f[kFieldParent] = Field{PinsListOf(kSpaceB13), stamp};
+  state.records[kFolderB13] = folder;
+  Record pin(Kind::kTab);
+  pin.f[kFieldHome] = Field{long_home, stamp};
+  pin.f[kFieldName] = Field{long_name, stamp};
+  pin.f[kFieldParent] = Field{PinsListOf(kSpaceB13), stamp};
+  state.records[kPinB13] = pin;
+  state.lists[PinsListOf(kSpaceB13)].order = {kFolderB13, kPinB13};
+  state.lists[PinsListOf(kSpaceB13)].s = stamp;
+  const State before = state;
+
+  FileMeta meta;
+  meta.install = kWriterB13;
+  meta.device = "Desk";
+  meta.seq = 1;
+  meta.nonce = "nonce";
+  meta.written_ms = 1000;
+  meta.hlc = 1000;
+  meta.joined_ms = 1;
+  const ParsedFile parsed = ParseSyncFile(SerializeSyncFile(state, meta));
+  ASSERT_EQ(ParseStatus::kOk, parsed.status);
+  EXPECT_EQ(before, state) << "the ledger itself was changed";
+
+  const std::string cut = long_name.substr(0, kMaxTextLength);
+  ASSERT_TRUE(base::IsStringUTF8(cut));
+  ASSERT_TRUE(parsed.state.records.contains(kSpaceB13));
+  ASSERT_TRUE(parsed.state.records.contains(kFolderB13));
+  ASSERT_TRUE(parsed.state.records.contains(kPinB13));
+  EXPECT_EQ(cut, parsed.state.records.at(kSpaceB13).Get(kFieldName));
+  EXPECT_EQ(cut, parsed.state.records.at(kSpaceB13).Get(kFieldIcon));
+  EXPECT_EQ("#3366FF", parsed.state.records.at(kSpaceB13).Get(kFieldColor));
+  EXPECT_EQ(cut, parsed.state.records.at(kFolderB13).Get(kFieldTitle));
+  EXPECT_EQ(cut, parsed.state.records.at(kPinB13).Get(kFieldName));
+  EXPECT_FALSE(parsed.state.records.at(kPinB13).f.contains(kFieldHome));
+  EXPECT_EQ(PinsListOf(kSpaceB13),
+            parsed.state.records.at(kPinB13).Get(kFieldParent));
+
+  // A home within the cap is written as it is.
+  state.records[kPinB13].f[kFieldHome] = Field{fine_home, stamp};
+  const ParsedFile fine = ParseSyncFile(SerializeSyncFile(state, meta));
+  ASSERT_EQ(ParseStatus::kOk, fine.status);
+  EXPECT_EQ(fine_home, fine.state.records.at(kPinB13).Get(kFieldHome));
+}
+
+}  // namespace
+}  // namespace spaces::sidebar_sync
