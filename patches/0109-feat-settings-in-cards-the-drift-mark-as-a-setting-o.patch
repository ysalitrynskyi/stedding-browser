+  const auto got = [&]() -> std::string {
+    for (int i = 0; i < tabs->count(); ++i) {
+      const GURL url = tabs->GetWebContentsAt(i)->GetVisibleURL();
+      if (url.GetWithEmptyPath() == extension->url() &&
+          url.path() == "/got.html") {
+        return std::string(url.ref());
+      }
+    }
+    return std::string();
+  };
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !got().empty(); }))
+      << "the extension never heard of the query";
+  EXPECT_EQ("hello%20world%7CnewForegroundTab", got());
+}
