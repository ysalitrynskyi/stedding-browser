+// A fixed day: what a conversion keeps is relative to it.
+base::Time FixedNow() {
+  return base::Time::UnixEpoch() + base::Days(20000);
+}
+
+uint64_t UsecBefore(base::Time now, base::TimeDelta ago) {
+  return static_cast<uint64_t>(
+      ((now - ago) - base::Time::UnixEpoch()).InMicroseconds());
+}
+
+SafariVisit Visit(std::string url, uint64_t time_usec) {
+  SafariVisit visit;
+  visit.url = std::move(url);
+  visit.title = "Title";
+  visit.time_usec = time_usec;
+  visit.visit_count = 3;
+  return visit;
+}
+
+// import I38: a web page's visit keeps its title, count and time, with no
+// typed count; a page of another scheme, a redirect hop, a visit older than
+// the history keeps, and one with no time do not come in.
+TEST(SafariExportImporterTest, ConvertsHistoryEntries) {
+  const base::Time now = FixedNow();
+  const uint64_t yesterday = UsecBefore(now, base::Days(1));
+  const std::optional<history::URLRow> kept =
+      SafariHistoryRow(Visit("https://kept.example/page", yesterday), now);
+  ASSERT_TRUE(kept);
+  EXPECT_EQ(GURL("https://kept.example/page"), kept->url());
+  EXPECT_EQ(u"Title", kept->title());
+  EXPECT_EQ(3, kept->visit_count());
+  EXPECT_EQ(0, kept->typed_count());
+  EXPECT_EQ(now - base::Days(1), kept->last_visit());
+
+  EXPECT_FALSE(SafariHistoryRow(Visit("ftp://files.example/", yesterday), now));
+  EXPECT_FALSE(SafariHistoryRow(Visit("not a url", yesterday), now));
+  EXPECT_FALSE(SafariHistoryRow(
+      Visit("https://old.example/", UsecBefore(now, base::Days(91))), now));
+  EXPECT_FALSE(SafariHistoryRow(Visit("https://never.example/", 0), now));
+
+  // A hop that went on to the https page is not a page that was seen; the
+  // page it went to is.
+  SafariVisit hop = Visit("http://hop.example/", yesterday);
+  hop.destination_url = "https://hop.example/";
+  EXPECT_FALSE(SafariHistoryRow(hop, now));
+  SafariVisit landed = Visit("https://hop.example/", yesterday);
+  landed.source_url = "http://hop.example/";
+  EXPECT_TRUE(SafariHistoryRow(landed, now));
+  // Only the fragment changed: the same page.
+  SafariVisit fragment = Visit("https://same.example/a", yesterday);
+  fragment.destination_url = "https://same.example/a#part";
+  EXPECT_TRUE(SafariHistoryRow(fragment, now));
+
+  // A visit dated ahead of now is no visit yet (BACKLOG S-346); a few
+  // minutes ahead is another machine's clock.
+  EXPECT_FALSE(SafariHistoryRow(
+      Visit("https://ahead.example/", UsecBefore(now, -base::Days(3 * 365))),
+      now));
+  EXPECT_TRUE(SafariHistoryRow(
+      Visit("https://skew.example/", UsecBefore(now, -base::Minutes(2))),
+      now));
+}
+
+std::string HistoryJson(const std::vector<std::pair<std::string, uint64_t>>&
+                            visits) {
+  std::string json =
+      R"({"metadata": {"browser_name": "Safari", "data_type": "history",
+          "schema_version": 1}, "history": [)";
+  for (size_t i = 0; i < visits.size(); ++i) {
+    if (i > 0) {
+      json += ",";
+    }
+    base::StrAppend(&json, {R"({"url": ")", visits[i].first,
+                            R"(", "title": "T", "visit_count": 1, )",
+                            R"("time_usec": )",
+                            base::NumberToString(visits[i].second), "}"});
+  }
+  json += "]}";
+  return json;
+}
+
+// import I38: at most the cap, and the newest of them; the read says it cut.
+TEST(SafariExportImporterTest, HistoryStopsAtTheCap) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::Time now = base::Time::Now();
+  ASSERT_TRUE(base::WriteFile(
+      dir.GetPath().AppendASCII("History.json"),
+      HistoryJson({{"https://one.example/", UsecBefore(now, base::Days(3))},
+                   {"https://two.example/", UsecBefore(now, base::Days(1))},
+                   {"https://three.example/", UsecBefore(now, base::Days(2))}})));
+  const SafariHistoryRead read =
+      ReadSafariHistoryFolder(dir.GetPath(), now, /*cap=*/2);
+  EXPECT_TRUE(read.capped);
+  ASSERT_EQ(2u, read.rows.size());
+  EXPECT_EQ(GURL("https://two.example/"), read.rows[0].url());
+  EXPECT_EQ(GURL("https://three.example/"), read.rows[1].url());
+
+  const SafariHistoryRead all = ReadSafariHistoryFolder(dir.GetPath(), now);
+  EXPECT_FALSE(all.capped);
+  EXPECT_EQ(3u, all.rows.size());
+}
+
+// import I38 (BACKLOG S-346): visits dated ahead of now do not fill the cap
+// ahead of the real ones. Sorted as the newest, they had been the rows kept,
+// and the export's recent visits were dropped.
+TEST(SafariExportImporterTest, AVisitDatedAheadTakesNoPlace) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::Time now = base::Time::Now();
+  ASSERT_TRUE(base::WriteFile(
+      dir.GetPath().AppendASCII("History.json"),
+      HistoryJson(
+          {{"https://ahead.example/", UsecBefore(now, -base::Days(3 * 365))},
+           {"https://seen.example/", UsecBefore(now, base::Days(1))}})));
+  const SafariHistoryRead read =
+      ReadSafariHistoryFolder(dir.GetPath(), now, /*cap=*/1);
+  ASSERT_EQ(1u, read.rows.size());
+  EXPECT_EQ(GURL("https://seen.example/"), read.rows[0].url());
+}
+
+// import I34 (BACKLOG S-346): a JSON file is told by its metadata's own
+// "data_type", read as JSON. A "data_type" anywhere ahead of the metadata
+// names nothing: found by a plain search, it had a payment cards file read
+// whole, cards and all, as history.
+TEST(SafariExportImporterTest, AJsonFileIsToldByItsMetadataAlone) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath disguised = dir.GetPath().AppendASCII("Cards.json");
+  ASSERT_TRUE(base::WriteFile(
+      disguised,
+      R"({"data_type": "history", "metadata": {"data_type": "payment_cards"},)"
+      R"( "payment_cards": [{"card_number": "4111111111111111"}]})"));
+  EXPECT_EQ(SafariExportFile::kOther, KindOfSafariExportFile(disguised));
+
+  const base::FilePath quoted = dir.GetPath().AppendASCII("Quoted.json");
+  ASSERT_TRUE(base::WriteFile(
+      quoted,
+      R"({"metadata": {"browser_name": "\"data_type\": \"history\"",)"
+      R"( "schema_version": 1, "nested": {"data_type": "history"},)"
+      R"( "data_type": "payment_cards"}, "payment_cards": []})"));
+  EXPECT_EQ(SafariExportFile::kPaymentCards, KindOfSafariExportFile(quoted));
+
+  const base::Time now = base::Time::Now();
+  EXPECT_TRUE(ReadSafariHistoryFolder(dir.GetPath(), now).rows.empty());
+}
