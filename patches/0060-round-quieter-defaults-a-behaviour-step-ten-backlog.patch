+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_ARCHIVE_CLOSED_TABS_UNDO_H_
+#define CHROME_BROWSER_UI_ARCHIVE_CLOSED_TABS_UNDO_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ref.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/sessions/core/session_id.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/split_tabs/split_tab_id.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class BrowserWindowInterface;
+class PrefService;
+class TabStripModel;
+
+namespace stedding {
+
+// docs/features/tabs.md R25-R27, R30 (BACKLOG S-97): Undo after closing tabs.
+// A close the user makes shows a toast; its Undo reopens exactly what that
+// close put in Chromium's recently-closed list, in place, in its Space and
+// its folder.
+
+// What a tab leaving the strip tells about how it left.
+struct LeavingTab {
+  // The tab is being deleted, not moved to another window.
+  bool closed = false;
+  // The window is closing, or the strip is closing all its tabs: Chromium
+  // records a window, not tabs (R26).
+  bool window_closing = false;
+  // The close came from the user: CLOSE_USER_GESTURE, or a split pane's own
+  // close (WebContents::GetClosedByUserGesture).
+  bool user_gesture = false;
+  // The close made an entry in the recently-closed list.
+  bool recorded = false;
+  // stedding.tabs.undo_toast (R30): the user has not turned the toast off.
+  bool undo_toast_on = false;
+  // The archive's mark on the entry (archive A8): "auto" for the sweep,
+  // "clear" for Clear, empty for a plain close.
+  std::string reason;
+};
+
+// R25, R26, R30: whether the tab's close offers Undo. A recorded close, by
+// the user, in a window that is not closing, that the archive sweep did not
+// make, while the setting is on. Clear counts.
+bool OffersUndo(const LeavingTab& tab);
+
+// R30: the profile's stedding.tabs.undo_toast; false without prefs.
+bool UndoToastOn(const PrefService* prefs);
+
+// One entry of the recently-closed list as the toast and Undo see it.
+struct ClosedEntry {
+  ClosedEntry();
+  ClosedEntry(const ClosedEntry& other);
+  ClosedEntry& operator=(const ClosedEntry& other);
+  ~ClosedEntry();
+
+  SessionID id = SessionID::InvalidValue();
+  // How many tabs the entry brings back: 1 for a tab, 2 for a split.
+  size_t tabs = 0;
+  // For a tab: the user's name for it, else the page title, else the
+  // address. Empty for a split.
+  std::u16string title;
+  std::string reason;
+  bool split = false;
+  // The index in the strip the tab (or the split's first tab) was closed
+  // at; -1 when unknown.
+  int index = -1;
+};
+
+// The TAB or SPLIT entry `id` of `entries`; nothing for another kind of
+// entry or an id that is not there.
+std::optional<ClosedEntry> DescribeClosedEntry(
+    const sessions::TabRestoreService::Entries& entries,
+    SessionID id);
+
+// The front-most SPLIT entry made for `split`. A split closed whole makes
+// one SPLIT entry before its panes go, and the panes then carry no entry of
+// their own.
+std::optional<SessionID> FindClosedSplit(
+    const sessions::TabRestoreService::Entries& entries,
+    const split_tabs::SplitTabId& split);
+
+// The ids of `offered` still in `entries`, in the list's order, newest
+// first: restored in that order, each tab goes back to the index it was
+// recorded at. An entry ⇧⌘T took meanwhile is left out.
+std::vector<SessionID> UndoOrder(
+    const sessions::TabRestoreService::Entries& entries,
+    const std::vector<SessionID>& offered);
+
+// The toast's text: "“Inbox” closed" for one tab with a title, cut to 40
+// characters; else "3 tabs closed". The title is never parsed as a message
+// pattern, so braces in it are printed as written.
+std::u16string ClosedTabsToastText(size_t tabs, const std::u16string& title);
+
+// One per normal window, owned by BrowserWindowFeatures after the archiver.
+// Gathers the closes the user makes in one turn into one close, shows the
+// toast for it, and undoes it when the toast's button asks.
+class ClosedTabsUndo : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(ClosedTabsUndo);
+
+  // The window's undo, or null in a window that has none (a popup, an app
+  // window, a private window).
+  static ClosedTabsUndo* From(BrowserWindowInterface* browser);
+
+  explicit ClosedTabsUndo(BrowserWindowInterface& browser);
+  ClosedTabsUndo(const ClosedTabsUndo&) = delete;
+  ClosedTabsUndo& operator=(const ClosedTabsUndo&) = delete;
+  ~ClosedTabsUndo() override;
+
+  // R27: reopens the close the toast offered, newest entry first, each tab
+  // at its index, in its Space and folder, then shows the tab that was on
+  // screen, or the Space the close was made in. Returns how many tabs came
+  // back; a second call returns 0.
+  size_t Undo();
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabWillBeRemoved(tabs::TabInterface* tab, int index) override;
+
+ private:
+  struct Closed {
+    SessionID id = SessionID::InvalidValue();
+    size_t tabs = 0;
+    std::u16string title;
+    // The tab on screen when the close began was in this entry.
+    bool on_screen = false;
+  };
+
+  // True while the window is closing all its tabs.
+  bool WindowClosing() const;
+
+  // Shows the toast for what this turn's closes gathered.
+  void Flush();
+
+  const raw_ref<BrowserWindowInterface> browser_;
+
+  // This turn's closes, and the Space on screen when the first was made.
+  std::vector<Closed> gathering_;
+  std::optional<spaces::SpaceId> gathering_space_;
+  bool flush_posted_ = false;
+
+  // The close the toast on screen offers to undo.
+  std::vector<Closed> offered_;
+  std::optional<spaces::SpaceId> offered_space_;
+
+  // The split each leaving tab was in, read before it leaves: a removed tab
+  // no longer knows its split.
+  std::map<tabs::TabHandle, split_tabs::SplitTabId> leaving_splits_;
+
+  std::optional<ui::ScopedUnownedUserData<ClosedTabsUndo>> scoped_user_data_;
+  base::WeakPtrFactory<ClosedTabsUndo> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_ARCHIVE_CLOSED_TABS_UNDO_H_
