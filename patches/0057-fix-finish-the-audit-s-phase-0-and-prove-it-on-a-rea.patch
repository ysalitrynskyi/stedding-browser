+class TabDropTest : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+  views::View* root() { return widget()->GetRootView(); }
+  int Index(tabs::TabInterface* tab) {
+    return tab_strip_model()->GetIndexOfTab(tab);
+  }
+
+  GURL Url(const std::string& host) {
+    return embedded_test_server()->GetURL(host, "/title1.html");
+  }
+
+  // A new foreground tab showing `host`, loaded.
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url(host), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tab_strip_model()->GetActiveTab();
+  }
+
+  gfx::Point RowCentre(const tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    TabView* const row = stedding::test::FindDrawnRow(root(), tab);
+    CHECK(row);
+    return row->GetBoundsInScreen().CenterPoint();
+  }
+
+  gfx::Point HeaderCentre(const tabs::FolderTabCollection* folder) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    FolderView* const view = stedding::test::FindDrawnFolder(root(), folder);
+    CHECK(view);
+    return view->GetHeaderBoundsInScreen().CenterPoint();
+  }
+
+  std::optional<gfx::Point> ChipCentre(const spaces::SpaceId& id) {
+    views::test::RunScheduledLayout(widget());
+    spaces::SpaceSwitcherView* const switcher = FindDrawnSwitcher(root());
+    if (!switcher) {
+      return std::nullopt;
+    }
+    for (views::View* const chip :
+         switcher->icon_row_for_testing()->children()) {
+      if (!chip->IsDrawn()) {
+        continue;
+      }
+      const gfx::Point centre = chip->GetBoundsInScreen().CenterPoint();
+      if (switcher->SpaceAtScreenPoint(centre) == id) {
+        return centre;
+      }
+    }
+    return std::nullopt;
+  }
+
+  // Presses at `from`, moves to `to` in twelve even steps, releases: a
+  // person's drag, sent to the window's root view.
+  void Drag(const gfx::Point& from, const gfx::Point& to) {
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, from);
+    for (int step = 1; step <= 12; ++step) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * step / 12,
+                     from.y() + (to.y() - from.y()) * step / 12));
+    }
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, to);
+    base::RunLoop().RunUntilIdle();
+  }
+
+  static size_t WindowCount() { return GetAllBrowserWindowInterfaces().size(); }
+
+  // What a move must keep of a tab.
+  struct Kept {
+    raw_ptr<content::WebContents> contents = nullptr;
+    int entries = 0;
+    GURL page;
+  };
+  static Kept KeptOf(tabs::TabInterface* tab) {
+    return {tab->GetContents(),
+            tab->GetContents()->GetController().GetEntryCount(),
+            tab->GetContents()->GetLastCommittedURL()};
+  }
+  static void ExpectKept(tabs::TabInterface* tab, const Kept& kept) {
+    EXPECT_EQ(kept.contents, tab->GetContents()) << "the tab was remade";
+    EXPECT_EQ(kept.entries,
+              tab->GetContents()->GetController().GetEntryCount());
+    EXPECT_EQ(kept.page, tab->GetContents()->GetLastCommittedURL());
+  }
+};
