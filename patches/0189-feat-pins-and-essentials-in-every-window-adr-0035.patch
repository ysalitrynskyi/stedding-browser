+// windows G13, folders F38: a pinned folder is the same in every window: its
+// pins in their order, its name, its icon, open or closed. A pin taken out of
+// it in one window leaves it in the other, and the folder unpinned in one
+// window leaves the other's asleep copy closed.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest,
+                       APinnedFolderIsTheSameInEveryWindow) {
+  tabs::TabInterface* const a = PinPage(browser(), Page("/title1.html"));
+  tabs::TabInterface* const b = PinPage(browser(), Page("/title2.html"));
+  tabs::TabInterface* const c = PinPage(browser(), Page("/title3.html"));
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  tabs::FolderTabCollection* const folder = strip->AddToNewFolder(
+      {strip->GetIndexOfTab(a), strip->GetIndexOfTab(b)});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Work");
+  folder->SetIcon("W");
+  ASSERT_TRUE(Model(browser()).IsFolderSpacePinned(folder));
+  base::RunLoop().RunUntilIdle();
+  ASSERT_EQ(3u, Store().records().size());
+
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const std::vector<tabs::TabInterface*> there = Pins(second);
+    return there.size() == 3u && FolderOf(there[0]) &&
+           FolderOf(there[0]) == FolderOf(there[1]) && !FolderOf(there[2]);
+  })) << "the second window lacks the folder or its pins";
+  const std::vector<tabs::TabInterface*> there = Pins(second);
+  EXPECT_EQ(Token(a), Token(there[0]));
+  EXPECT_EQ(Token(b), Token(there[1]));
+  EXPECT_EQ(Token(c), Token(there[2]));
+  const tabs::FolderTabCollection* const folder_there = FolderOf(there[0]);
+  EXPECT_EQ(folder->id(), folder_there->id());
+  EXPECT_EQ("Work", folder_there->title());
+  EXPECT_EQ("W", folder_there->icon());
+  EXPECT_TRUE(Model(second).IsFolderSpacePinned(folder_there));
+  EXPECT_EQ(3u, Store().records().size());
+
+  // A new name and a closed folder reach the other window.
+  folder->SetTitle("Desk");
+  folder->SetCollapsed(true);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const tabs::FolderTabCollection* const now = FolderOf(Pins(second)[0]);
+    return now && now->title() == "Desk" && now->collapsed();
+  })) << "the folder's name or its closed state stayed in the first window";
+
+  // A pin taken out of the folder in the second window leaves it in the
+  // first.
+  TabStripModel* const there_strip = second->GetTabStripModel();
+  there_strip->MoveTabOutOfFolders(there_strip->GetIndexOfTab(there[1]));
+  ASSERT_TRUE(base::test::RunUntil([&] { return !FolderOf(b); }))
+      << "the pin stayed in the first window's folder";
+  EXPECT_EQ(folder, FolderOf(a));
+  EXPECT_EQ(3u, Pins(browser()).size());
+
+  // Unpinned in the first window, the folder leaves the second: its asleep
+  // copy of the folder's pin closes, and the folder with it.
+  const int tabs_before = there_strip->count();
+  Model(browser()).SetFolderSpacePinned(folder, false);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Pins(second).size() == 2u && there_strip->count() == tabs_before - 1;
+  })) << "the second window kept the folder's pin";
+  for (tabs::TabInterface* const pin : Pins(second)) {
+    EXPECT_FALSE(FolderOf(pin)) << "a folder was left in the second window";
+  }
+  EXPECT_EQ(2u, Store().records().size());
+}
