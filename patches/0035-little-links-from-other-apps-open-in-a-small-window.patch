@@ -0,0 +1,99 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/little_window.h"
+
+#include <memory>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_router.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class LittleWindowTest : public BrowserWithTestWindowTest {
+ protected:
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+
+  // A popup marked little, with `url` in it, the way OpenLittleWindow leaves
+  // one (the window itself is a test window here).
+  std::unique_ptr<Browser> MakeLittle(const char* url) {
+    std::unique_ptr<Browser> little =
+        CreateBrowser(profile(), Browser::TYPE_POPUP, /*hosted_app=*/false);
+    MarkLittleWindow(little.get());
+    AddTab(little.get(), GURL(url));
+    return little;
+  }
+};
+
+// E1, E4: the setting on and no route -> little; a route wins; off -> a tab.
+TEST_F(LittleWindowTest, ExternalUrlOpensLittleWindow) {
+  PrefService* const prefs = profile()->GetPrefs();
+  const GURL url("https://example.com/from-mail");
+  EXPECT_TRUE(ShouldOpenLittle(prefs, url));
+  EXPECT_FALSE(ShouldOpenLittle(prefs, GURL("file:///tmp/x.txt")));
+  std::unique_ptr<Browser> little = MakeLittle("https://example.com/");
+  EXPECT_TRUE(IsLittleWindow(little.get()));
+  EXPECT_FALSE(IsLittleWindow(browser()));
+  little->tab_strip_model()->CloseAllTabs();
+}
+
+TEST_F(LittleWindowTest, MatchingRouteSkipsIt) {
+  PrefService* const prefs = profile()->GetPrefs();
+  spaces::AddRoute(prefs, spaces::SiteRouteFor(GURL("https://example.com/"),
+                                               model().active_id().ToString()));
+  EXPECT_FALSE(ShouldOpenLittle(prefs, GURL("https://example.com/x")))
+      << "routing D3: the route wins";
+  EXPECT_TRUE(ShouldOpenLittle(prefs, GURL("https://other.example/")));
+}
+
+TEST_F(LittleWindowTest, SettingOffOpensATab) {
+  PrefService* const prefs = profile()->GetPrefs();
+  prefs->SetBoolean(prefs::kLittleEnabled, false);
+  EXPECT_FALSE(ShouldOpenLittle(prefs, GURL("https://example.com/")));
+}
+
+// E2: cmd-O moves the page, no reload, into the active Space; the little
+// window is left empty (closed for real outside a test window).
+TEST_F(LittleWindowTest, PromoteMovesContentsIntoSpace) {
+  std::unique_ptr<Browser> little = MakeLittle("https://little.example/");
+  content::WebContents* const page =
+      little->tab_strip_model()->GetActiveWebContents();
+  const int before = browser()->tab_strip_model()->count();
+  EXPECT_TRUE(PromoteLittleWindow(little.get(), browser(), std::nullopt,
+                                  /*split=*/false));
+  EXPECT_EQ(before + 1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(page, browser()->tab_strip_model()->GetActiveWebContents())
+      << "the same WebContents, not a reload";
+  EXPECT_EQ(model().active_id(),
+            model().SpaceForTab(browser()->tab_strip_model()->GetActiveTab()));
+  EXPECT_EQ(0, little->tab_strip_model()->count());
+  EXPECT_FALSE(PromoteLittleWindow(browser(), browser(), std::nullopt, false))
+      << "only a little window promotes";
+}
+
+// E2: ctrl-N sends the page to Space N.
+TEST_F(LittleWindowTest, CtrlDigitSendsToSpaceN) {
+  spaces::Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  std::unique_ptr<Browser> little = MakeLittle("https://little.example/");
+  EXPECT_TRUE(PromoteLittleWindow(little.get(), browser(), work->id(),
+                                  /*split=*/false));
+  tabs::TabInterface* const moved =
+      browser()->tab_strip_model()->GetActiveTab();
+  EXPECT_EQ(work->id(), model().SpaceForTab(moved));
+  EXPECT_EQ(work->id(), model().active_id());
+}
+
+}  // namespace
+}  // namespace stedding
