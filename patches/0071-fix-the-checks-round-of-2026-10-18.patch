+// The directories in `directory`, where the Spaces' jars are.
+std::vector<base::FilePath> ListSpaceJarsOnDisk(
+    const base::FilePath& directory) {
+  std::vector<base::FilePath> jars;
+  base::FileEnumerator entries(directory, /*recursive=*/false,
+                               base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath jar = entries.Next(); !jar.empty();
+       jar = entries.Next()) {
+    jars.push_back(std::move(jar));
+  }
+  return jars;
+}
+
+void DeleteSpaceJars(const std::vector<base::FilePath>& jars) {
+  for (const base::FilePath& jar : jars) {
+    base::DeletePathRecursively(jar);
+  }
