+  RemoveAndRecord(base::Time(), content::BrowsingDataRemover::DATA_TYPE_COOKIES,
+                  std::move(one_site));
+
+  EXPECT_THAT(CookieDomains(work), testing::ElementsAre("example.org"));
+}
+
+// PLAN.md SPC-10 names one directory for every jar; this is where Chromium
+// really puts a Space's partition.
+TEST_F(SpaceJarChromeBrowsingDataRemoverDelegateTest,
+       EverySpaceJarIsInsideOneDirectory) {
+  content::StoragePartition* const work =
