+#ifndef CHROME_BROWSER_UI_STEDDING_SIDEBAR_DENSITY_H_
+#define CHROME_BROWSER_UI_STEDDING_SIDEBAR_DENSITY_H_
+
+class PrefService;
+
+namespace stedding {
+
+// docs/features/sidebar.md Y1, Y2: fills the process-wide sidebar metrics
+// from local state, once, and keeps them filled: every change re-lays out
+// every window. Safe to call from every window's construction.
+void EnsureSidebarDensityInstalled(PrefService* local_state);
+
+// The same, for a change made now (the bar's actions, Y4).
+void SetSidebarDensityPref(PrefService* local_state, int density);
+
+}  // namespace stedding
