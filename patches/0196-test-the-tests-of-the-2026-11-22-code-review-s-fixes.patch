+class ChildTabsW2B28Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // The nesting is off by default (settings T26).
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kNestChildTabs, true);
+  }
+
+  TabStripModel* tabs() { return browser()->tab_strip_model(); }
+  views::Widget* widget() {
+    return BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  }
+
+  GURL Url(const std::string& host) {
+    return embedded_test_server()->GetURL(host, "/title1.html");
+  }
+
+  // The indent `tab`'s row is drawn at in the first window once the rows are
+  // in place, or -1 when it has no row.
+  int Indent(tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    TabView* const row =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+    return row ? row->SteddingNestIndent() : -1;
+  }
+
+  // A link opened from `from` in a background tab, as a middle click opens
+  // one.
+  tabs::TabInterface* OpenLinkFrom(tabs::TabInterface* from,
+                                   const std::string& host) {
+    tabs()->ActivateTabAt(tabs()->GetIndexOfTab(from));
+    NavigateParams params(browser(), Url(host), ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::kNewBackgroundTab;
+    params.source_contents = from->GetContents();
+    Navigate(&params);
+    content::WebContents* const opened = params.navigated_or_inserted_contents;
+    EXPECT_TRUE(opened && content::WaitForLoadStop(opened));
+    const int index = tabs()->GetIndexOfWebContents(opened);
+    return index == TabStripModel::kNoTab ? nullptr
+                                          : tabs()->GetTabAtIndex(index);
+  }
+};
