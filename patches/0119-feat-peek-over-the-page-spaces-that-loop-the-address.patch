+void ToolbarView::SetSteddingButtonsHost(views::View* host,
+                                         views::View* menu_host) {
+  if (!host) {
+    menu_host = nullptr;
+  }
+  if (host == stedding_buttons_host_ && menu_host == stedding_menu_host_) {
+    return;
+  }
+  // Home first: each to the place it had, in the row's order, so the
+  // places count from a row that is whole again.
+  if (stedding_buttons_host_) {
+    for (SteddingLentButton& lent : stedding_lent_buttons_) {
+      views::View* const lent_to = lent.button->parent();
+      if (!lent_to || (lent_to != stedding_buttons_host_ &&
+                       lent_to != stedding_menu_host_)) {
+        continue;
+      }
+      std::unique_ptr<views::View> owned =
+          lent_to->RemoveChildViewT(lent.button.get());
+      size_t at = std::min(lent.index, children().size());
+      if (views::View* const before = lent.before->view();
+          before && before->parent() == this) {
+        at = GetIndexOf(before).value() + 1;
+      }
+      AddChildViewAt(std::move(owned), at);
+    }
+    // Home in the row's colours again (sidebar Y51).
+    RefreshSteddingLentIcons();
+    stedding_lent_buttons_.clear();
+    stedding_host_watch_.reset();
+    stedding_menu_host_watch_.reset();
+    stedding_buttons_host_->InvalidateLayout();
+    if (stedding_menu_host_) {
+      stedding_menu_host_->InvalidateLayout();
+    }
+  }
+  stedding_buttons_host_ = host;
+  stedding_menu_host_ = menu_host;
+  if (host) {
+    for (views::View* const button :
+         {static_cast<views::View*>(extensions_container_.get()),
+          static_cast<views::View*>(pinned_toolbar_actions_container_.get()),
+          static_cast<views::View*>(app_menu_button_.get())}) {
+      if (button && button->parent() == this) {
+        const size_t index = GetIndexOf(button).value();
+        stedding_lent_buttons_.emplace_back(
+            button, index, index > 0 ? children()[index - 1].get() : nullptr);
+      }
+    }
+    // In the row's order: they go to the sidebar in it, and come home in
+    // it, each place counted with the ones before it already back.
+    std::ranges::sort(stedding_lent_buttons_, {},
+                      [](const SteddingLentButton& lent) { return lent.index; });
+    for (SteddingLentButton& lent : stedding_lent_buttons_) {
+      views::View* const to =
+          menu_host && lent.button == app_menu_button_.get() ? menu_host : host;
+      to->AddChildView(RemoveChildViewT(lent.button.get()));
+    }
+    stedding_host_watch_ = std::make_unique<SteddingHostWatch>(this, host);
+    RefreshSteddingLentIcons();
+    if (menu_host) {
+      stedding_menu_host_watch_ =
+          std::make_unique<SteddingHostWatch>(this, menu_host);
+      menu_host->InvalidateLayout();
+    }
+    host->InvalidateLayout();
+  }
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
+
+void ToolbarView::RefreshSteddingLentIcons() {
+  // A button that moved keeps the icon drawn where it was; each takes the
+  // colours of where it is now (kSteddingSidebarIconsKey). Not while the
+  // window goes: the buttons come home to be destroyed, with no colours to
+  // take.
+  if (!GetWidget()) {
+    return;
+  }
+  for (SteddingLentButton& lent : stedding_lent_buttons_) {
+    std::vector<views::View*> pending = {lent.button.get()};
+    while (!pending.empty()) {
+      views::View* const view = pending.back();
+      pending.pop_back();
+      if (auto* const button = views::AsViewClass<ToolbarButton>(view);
+          button && button->GetColorProvider()) {
+        button->UpdateIcon();
+      }
+      for (views::View* const child : view->children()) {
+        pending.push_back(child);
+      }
+    }
+  }
+}
