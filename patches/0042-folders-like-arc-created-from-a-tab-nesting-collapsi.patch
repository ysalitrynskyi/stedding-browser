+tabs::FolderTabCollection* TabStripModel::AddToNewFolder(
+    const std::vector<int> indices,
+    tabs::FolderTabCollection* parent_folder) {
+  CHECK(!indices.empty());
+  for (const int index : indices) {
+    CHECK(ContainsIndex(index));
+  }
+
+  // Same destination rule as grouping: the first spot at or after the first
+  // tab that is not pinned and not inside someone else's group.
+  int destination_index = -1;
+  for (int i = indices[0]; i <= count(); i++) {
+    if (!ContainsIndex(i)) {
+      destination_index = i;
+      break;
+    }
+    if (IsTabPinned(i)) {
+      continue;
+    }
+    std::optional<tab_groups::TabGroupId> destination_group =
+        GetTabGroupForTab(i);
+    if (!destination_group.has_value() ||
+        destination_group != GetTabGroupForTab(indices[0])) {
+      destination_index = i;
+      break;
+    }
+  }
+
+  // MoveTabsRecursive-family moves land after the moved tabs are removed, so
+  // pull the destination left by the tabs that sit before it.
+  size_t num_tabs_to_left = 0;
+  for (const int i : indices) {
+    if (i >= destination_index) {
+      break;
+    }
+    ++num_tabs_to_left;
+  }
+  const size_t adjusted_destination = destination_index - num_tabs_to_left;
+
+  // A folder made from a tab that already lives in a folder nests inside it,
+  // which is how nesting happens without a drag: use the command again inside.
+  if (!parent_folder) {
+    const tabs::TabCollection* const current_parent =
+        GetTabAtIndex(indices[0])->GetParentCollection();
+    if (current_parent &&
+        current_parent->type() == tabs::TabCollection::Type::FOLDER) {
+      parent_folder = const_cast<tabs::FolderTabCollection*>(
+          static_cast<const tabs::FolderTabCollection*>(current_parent));
+    }
+  }
+
+  auto folder = std::make_unique<tabs::FolderTabCollection>(
+      tabs::FolderId::GenerateNew(), std::string(), /*collapsed=*/false);
+  tabs::FolderTabCollection* folder_ptr = nullptr;
+
+  MoveTabsWithNotifications(
+      indices, static_cast<int>(adjusted_destination),
+      base::BindOnce(
+          [](tabs::TabStripCollection* contents,
+             const std::vector<int>& indices, size_t destination,
+             std::unique_ptr<tabs::FolderTabCollection> folder,
+             tabs::FolderTabCollection* parent,
+             tabs::FolderTabCollection** out) {
+            *out = contents->MoveTabsToNewFolderRecursive(
+                indices, destination, std::move(folder), parent);
+          },
+          contents_data_.get(), indices, adjusted_destination,
+          std::move(folder), parent_folder, &folder_ptr));
+  return folder_ptr;
+}
