+void SidebarAddressField::Layout(PassKey) {
+  // Y51, Y49 (BACKLOG S-399, the fourth item; S-403, GitHub issue 45): the
+  // site button, the words, Copy Link, then the lent buttons at the end.
+  // Short of room the words keep kFieldTextMinimum and the extensions' icons
+  // give way to their menu; with less still, the words give way down to
+  // nothing before the menu does. The words used to give way first, all the
+  // way, and the icons then ran past the field's end.
+  const gfx::Rect area = GetContentsBounds();
+  int x = area.x() + kFieldButtonInset;
+  const int end = area.right() - kFieldButtonInset;
+  const auto shown = [](const views::View* view) {
+    return view->GetVisible();
+  };
+  const auto place = [&](views::View* view, int width) {
+    const int height =
+        std::min(area.height(), view->GetPreferredSize().height());
+    view->SetBounds(x, area.y() + (area.height() - height) / 2, width,
+                    height);
+    x += width;
+  };
+  const gfx::Insets* const label_margins =
+      label_->GetProperty(views::kMarginsKey);
+  const int label_lead = label_margins ? label_margins->left() : 0;
+  int fixed = label_lead;
+  for (const views::View* view : {static_cast<const views::View*>(site_button_),
+                                  static_cast<const views::View*>(copy_link_)}) {
+    if (shown(view)) {
+      fixed += view->GetPreferredSize().width();
+    }
+  }
+  int room = std::max(0, end - x - fixed);
+  const int host_preferred =
+      shown(buttons_host_) ? buttons_host_->GetPreferredSize().width() : 0;
+  const int host_minimum =
+      std::min(host_preferred, shown(buttons_host_)
+                                   ? buttons_host_->GetMinimumSize().width()
+                                   : 0);
+  // On the narrowest sidebars the lent buttons -- the extensions' menu and,
+  // with no room for it on the top line, the window's menu, which is then
+  // nowhere else -- need more than is left: Copy Link steps aside first
+  // (the Mac's traffic lights, always shown, sent the menu here at 126 DIP,
+  // and it was squeezed to nothing).
+  const bool copy_fits =
+      !shown(copy_link_) || room >= host_minimum;
+  if (!copy_fits) {
+    room += copy_link_->GetPreferredSize().width();
+  }
+  const int label_floor =
+      std::min({kFieldTextMinimum, label_->GetPreferredSize().width(),
+                std::max(0, room - host_minimum)});
+  const int host_width = std::clamp(room - label_floor,
+                                    std::min(host_minimum, room),
+                                    host_preferred);
+  if (shown(site_button_)) {
+    place(site_button_, site_button_->GetPreferredSize().width());
+  }
+  x += label_lead;
+  place(label_, std::max(0, room - host_width));
+  if (shown(copy_link_)) {
+    if (copy_fits) {
+      place(copy_link_, copy_link_->GetPreferredSize().width());
+    } else {
+      copy_link_->SetBounds(x, area.y(), 0, 0);
+    }
+  }
+  if (shown(buttons_host_)) {
+    place(buttons_host_, host_width);
+  }
+}
