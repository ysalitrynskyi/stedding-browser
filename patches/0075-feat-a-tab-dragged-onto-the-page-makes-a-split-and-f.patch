+
+namespace {
+
+using spaces::SpaceId;
+using stedding::StartupLoad;
+
+// The window's pages: the essential, the selected tab and the other pane of
+// its split, a plain row of Home, a row in a collapsed folder of Home, a row
+// of Work and one of Play.
+constexpr std::string_view kPages = "estpfwq";
+
+std::string FileName(char page) {
+  return std::string(1, page) + ".html";
+}
+
+std::u16string Title(char page) {
+  return u"Page " +
+         base::ASCIIToUTF16(std::string(1, base::ToUpperASCII(page)));
+}
+
+// The pages each choice loads at launch (R46).
+std::string_view LoadedBy(StartupLoad choice) {
+  switch (choice) {
+    case StartupLoad::kSelectedTab:
+      return "st";
+    case StartupLoad::kSelectedTabAndEssentials:
+      return "ste";
+    case StartupLoad::kActiveSpace:
+      return "step";
+  }
+  NOTREACHED();
+}
+
+class StartupLoadTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ public:
+  // The launch opens the session alone: a page from the command line would
+  // be opened over the selected tab and become the one on screen.
+  StartupLoadTest() { set_open_about_blank_on_browser_launch(false); }
+
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin::SetUpOnMainThread();
+    SessionStartupPref::SetStartupPref(
+        browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+
+  base::FilePath PagesDir() {
+    return browser()->GetProfile()->GetPath().AppendASCII(
+        "stedding_startup_pages");
+  }
+
+  GURL PageUrl(const std::string& file) {
+    return net::FilePathToFileURL(PagesDir().AppendASCII(file));
+  }
+  GURL PageUrl(char page) { return PageUrl(FileName(page)); }
+
+  // Each page has a title, a line of text and the folder's favicon; the
+  // plain row's page has an older page behind it in its history.
+  void WritePages() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::CreateDirectory(PagesDir()));
+    SkBitmap icon;
+    icon.allocN32Pixels(16, 16);
+    icon.eraseColor(SK_ColorRED);
+    const std::optional<std::vector<uint8_t>> png =
+        gfx::PNGCodec::EncodeBGRASkBitmap(icon, /*discard_transparency=*/false);
+    ASSERT_TRUE(png);
+    ASSERT_TRUE(base::WriteFile(PagesDir().AppendASCII("icon.png"), *png));
+    const auto write = [&](const std::string& file, const std::string& title) {
+      ASSERT_TRUE(base::WriteFile(
+          PagesDir().AppendASCII(file),
+          "<!doctype html><meta charset=\"utf-8\"><title>" + title +
+              "</title><link rel=\"icon\" href=\"icon.png\"><body>" + title +
+              "</body>"));
+    };
+    for (const char page : kPages) {
+      write(FileName(page), base::UTF16ToUTF8(Title(page)));
+    }
+    write("older.html", "Older page");
+  }
+
+  // The tab showing `page`, loaded or not, whatever Space it is in.
+  tabs::TabInterface* Find(char page) {
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      if (tab->GetContents()->GetVisibleURL().ExtractFileName() ==
+          FileName(page)) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  // A new foreground tab on `page`, loaded.
+  tabs::TabInterface* Open(const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // Whether the favicon database holds a favicon for `url`'s page. It waits
+  // in a run loop of its own: never call it from a RunUntil.
+  bool FaviconStored(const GURL& url) {
+    favicon::FaviconService* const service =
+        FaviconServiceFactory::GetForProfile(
+            browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+    base::CancelableTaskTracker tracker;
+    base::test::TestFuture<const favicon_base::FaviconImageResult&> image;
+    service->GetFaviconImageForPageURL(url, image.GetCallback(), &tracker);
+    return !image.Get().image.IsEmpty();
+  }
+
+  // A tab asleep: marked discarded, no page in a renderer and nothing
+  // committed in its frame. (The contents' own last committed address is the
+  // restored entry's, loaded or not.)
+  static bool Asleep(tabs::TabInterface* tab) {
+    content::WebContents* const contents = tab->GetContents();
+    content::RenderFrameHost* const frame = contents->GetPrimaryMainFrame();
+    return contents->WasDiscarded() && !frame->IsRenderFrameLive() &&
+           frame->GetLastCommittedURL().is_empty();
+  }
+
+  // Each tab of the window, for a failure's message: its page, whether it is
+  // the active one, asleep, with a live frame, and what it committed.
+  std::string Describe() {
+    std::string out;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      content::WebContents* const contents = tab->GetContents();
+      out += "\n  " + contents->GetVisibleURL().ExtractFileName() +
+             (tab == tabs()->GetActiveTab() ? " active" : "") +
+             (contents->WasDiscarded() ? " discarded" : "") +
+             (contents->GetPrimaryMainFrame()->IsRenderFrameLive() ? " live"
+                                                                   : "") +
+             (contents->GetController().NeedsReload() ? " needs-reload" : "") +
+             " committed=" +
+             contents->GetPrimaryMainFrame()->GetLastCommittedURL()
+                 .ExtractFileName();
+    }
+    return out;
+  }
+
+  bool Loaded(tabs::TabInterface* tab, char page) {
+    content::WebContents* const contents = tab->GetContents();
+    return !contents->WasDiscarded() &&
+           contents->GetPrimaryMainFrame()->GetLastCommittedURL() ==
+               PageUrl(page) &&
+           !contents->IsLoading();
+  }
+
+  views::Widget* widget() {
+    return BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+  }
+
+  // The drawn row of `tab`, or null when the sidebar shows none for it
+  // (another Space, a collapsed folder). It waits in no run loop of its own,
+  // so a RunUntil may ask it: nested in RunUntil's, such a wait never
+  // returned on the Mac (folder_tabs_browsertest.cc).
+  TabView* Row(tabs::TabInterface* tab) {
+    views::test::RunScheduledLayout(widget());
+    return stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+  }
+
+  // R46: what the launch with `choice` left. The tabs the choice names load;
+  // each other one is asleep with its title from the session and its favicon
+  // from the database, and its row, where the sidebar draws one, is drawn as
+  // a slept row.
+  void ExpectTheLaunch(StartupLoad choice) {
+    ASSERT_EQ(static_cast<int>(choice),
+              prefs()->GetInteger(stedding::prefs::kStartupLoad));
+    spaces::SpaceModel* const m = model();
+    ASSERT_TRUE(m);
+    ASSERT_EQ(3u, m->size());
+    ASSERT_EQ("Home", m->GetSpace(m->active_id())->name());
+    ASSERT_EQ(Find('s'), tabs()->GetActiveTab())
+        << "the selected tab, of" << Describe();
+    const std::string_view loaded = LoadedBy(choice);
+    for (const char page : kPages) {
+      SCOPED_TRACE(FileName(page));
+      tabs::TabInterface* const tab = Find(page);
+      ASSERT_TRUE(tab) << "not restored";
+      if (loaded.find(page) != std::string_view::npos) {
+        EXPECT_TRUE(base::test::RunUntil([&]() { return Loaded(tab, page); }))
+            << "the choice loads it, of" << Describe();
+      }
+    }
+    // Every tab the choice loads has loaded: nothing else is on its way.
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    for (const char page : kPages) {
+      SCOPED_TRACE(FileName(page));
+      tabs::TabInterface* const tab = Find(page);
+      if (loaded.find(page) != std::string_view::npos) {
+        continue;
+      }
+      // On the Mac the window's first tab began to load as the restore
+      // filled the window; its renderer goes a moment after the restore.
+      EXPECT_TRUE(base::test::RunUntil([&]() { return Asleep(tab); }))
+          << "it comes back asleep, of" << Describe();
+      EXPECT_EQ(Title(page), TabUIHelper::From(tab)->GetTitle());
+      favicon::ContentFaviconDriver* const favicons =
+          favicon::ContentFaviconDriver::FromWebContents(tab->GetContents());
+      ASSERT_TRUE(favicons);
+      EXPECT_TRUE(
+          base::test::RunUntil([&]() { return favicons->FaviconIsValid(); }))
+          << "its favicon, not the default one";
+      if (TabView* const row = Row(tab)) {
+        EXPECT_TRUE(row->data().is_tab_discarded) << "drawn as a slept row";
+      }
+    }
+  }
+
+  void ChooseForTheNextLaunch(StartupLoad choice) {
+    prefs()->SetInteger(stedding::prefs::kStartupLoad,
+                        static_cast<int>(choice));
+  }
+};
+
+// The first run builds the window and leaves the default choice, the
+// selected tab only.
+IN_PROC_BROWSER_TEST_F(StartupLoadTest,
+                       PRE_PRE_PRE_OnlyWhatTheChoiceNamesLoadsAtLaunch) {
+  EXPECT_EQ(0, prefs()->GetInteger(stedding::prefs::kStartupLoad))
+      << "the default is the selected tab only";
+  WritePages();
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const SpaceId home = m->active_id();
+  m->SetSpaceName(home, "Home");
+  const SpaceId work = m->AddSpace("Work", SK_ColorGREEN)->id();
+  const SpaceId play = m->AddSpace("Play", SK_ColorBLUE)->id();
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), PageUrl('e')));
+  tabs()->SetTabPinned(0, true);
+  tabs::TabInterface* const s = Open(PageUrl('s'));
+  tabs::TabInterface* const t = Open(PageUrl('t'));
+  tabs::TabInterface* const p = Open(PageUrl("older.html"));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), PageUrl('p')));
+  tabs::TabInterface* const f = Open(PageUrl('f'));
+  tabs::TabInterface* const w = Open(PageUrl('w'));
+  tabs::TabInterface* const q = Open(PageUrl('q'));
+  // The rows that leave Home are in the background when they go.
+  tabs()->ActivateTabAt(Index(s));
+  m->MoveTabsToSpace({w}, work);
+  m->MoveTabsToSpace({q}, play);
+  ASSERT_EQ(home, m->active_id());
+  ASSERT_EQ(work, m->SpaceForTab(w));
+  ASSERT_EQ(play, m->SpaceForTab(q));
+  tabs::FolderTabCollection* const folder = tabs()->AddToNewFolder({Index(f)});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Later");
+  tabs()->ActivateTabAt(Index(s));
+  tabs()->AddToNewSplit({Index(t)}, split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(s->IsSplit());
+  ASSERT_EQ(s->GetSplit(), t->GetSplit());
+  folder->SetCollapsed(true);
+  ASSERT_TRUE(tabs()->IsTabHidden(Index(f)));
+  ASSERT_EQ(s, tabs()->GetActiveTab());
+  ASSERT_EQ(2, p->GetContents()->GetController().GetEntryCount());
+
+  // Every page with its title and its favicon in the database, which the
+  // next launch reads for the rows it does not load.
+  for (const char page : kPages) {
+    SCOPED_TRACE(FileName(page));
+    tabs::TabInterface* const tab = Find(page);
+    ASSERT_TRUE(tab);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return tab->GetContents()->GetTitle() == Title(page); }));
+    favicon::ContentFaviconDriver* const favicons =
+        favicon::ContentFaviconDriver::FromWebContents(tab->GetContents());
+    ASSERT_TRUE(favicons);
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return favicons->FaviconIsValid(); }));
+    // The page's favicon goes to the database before the tab hears of it,
+    // so this read, queued after that write, finds it.
+    ASSERT_TRUE(FaviconStored(PageUrl(page)));
+  }
+  ChooseForTheNextLaunch(StartupLoad::kSelectedTab);
+}
+
+// The selected tab only (R46); then R47: an asleep row loads when it is
+// selected, with its history, and nothing else wakes with it.
+IN_PROC_BROWSER_TEST_F(StartupLoadTest,
+                       PRE_PRE_OnlyWhatTheChoiceNamesLoadsAtLaunch) {
+  ExpectTheLaunch(StartupLoad::kSelectedTab);
+
+  tabs::TabInterface* const p = Find('p');
+  ASSERT_TRUE(p);
+  tabs()->ActivateTabAt(Index(p));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Loaded(p, 'p'); }))
+      << "a click on the row loads it";
+  EXPECT_TRUE(p->GetContents()->GetController().CanGoBack())
+      << "with its back list";
+  EXPECT_EQ(PageUrl("older.html"),
+            p->GetContents()->GetController().GetEntryAtIndex(0)->GetURL());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    TabView* const row = Row(p);
+    return row && !row->data().is_tab_discarded;
+  })) << "its row is drawn awake";
+  for (const char page : std::string_view("efwq")) {
+    SCOPED_TRACE(FileName(page));
+    EXPECT_TRUE(Asleep(Find(page)))
+        << "nothing else wakes with it, of" << Describe();
+  }
+
+  tabs()->ActivateTabAt(Index(Find('s')));
+  ChooseForTheNextLaunch(StartupLoad::kSelectedTabAndEssentials);
+}
+
+// The selected tab and the essentials (R46); then a Space switch that lands
+// on an asleep row loads that row alone.
+IN_PROC_BROWSER_TEST_F(StartupLoadTest,
+                       PRE_OnlyWhatTheChoiceNamesLoadsAtLaunch) {
+  ExpectTheLaunch(StartupLoad::kSelectedTabAndEssentials);
+
+  spaces::SpaceModel* const m = model();
+  const SpaceId home = m->active_id();
+  tabs::TabInterface* const w = Find('w');
+  ASSERT_TRUE(w);
+  ASSERT_TRUE(m->SetActiveSpace(m->SpaceForTab(w)));
+  ASSERT_EQ(w, tabs()->GetActiveTab());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Loaded(w, 'w'); }))
+      << "the Space switch's row loads";
+  for (const char page : std::string_view("pfq")) {
+    SCOPED_TRACE(FileName(page));
+    EXPECT_TRUE(Asleep(Find(page))) << "nothing else wakes with it";
+  }
+
+  ASSERT_TRUE(m->SetActiveSpace(home));
+  tabs()->ActivateTabAt(Index(Find('s')));
+  ChooseForTheNextLaunch(StartupLoad::kActiveSpace);
+}
+
+// The whole active Space (R46): every row Home shows, but not the row its
+// collapsed folder hides, nor the other Spaces' rows.
+IN_PROC_BROWSER_TEST_F(StartupLoadTest, OnlyWhatTheChoiceNamesLoadsAtLaunch) {
+  ExpectTheLaunch(StartupLoad::kActiveSpace);
+  const tabs::TabCollection* const folder = Find('f')->GetParentCollection();
+  ASSERT_TRUE(folder);
+  ASSERT_EQ(tabs::TabCollection::Type::FOLDER, folder->type());
+  EXPECT_TRUE(static_cast<const tabs::FolderTabCollection*>(folder)
+                  ->collapsed());
+}
+
+// tabs R34 after a relaunch (BACKLOG S-112, 2026-10-20): one Space of four
+// rows, all of them back from the session, the last one selected. As the
+// restore fills the window, the window's first row is its active tab until
+// the saved selection is made (on the Mac its page even begins to load, R46's
+// seam); that counted as a use of the first row, so the first Cmd-W after a
+// launch showed it instead of the row above the closed one. A restored row
+// counts once the user selects it.
+class RestoredCloseTest : public StartupLoadTest {};
+
+IN_PROC_BROWSER_TEST_F(RestoredCloseTest,
+                       PRE_TheFirstCloseAfterALaunchShowsTheRowAbove) {
+  WritePages();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), PageUrl('p')));
+  Open(PageUrl('s'));
+  Open(PageUrl('t'));
+  tabs::TabInterface* const f = Open(PageUrl('f'));
+  ASSERT_EQ(4, tabs()->count()) << Describe();
+  ASSERT_EQ(f, tabs()->GetActiveTab());
+}
+
+IN_PROC_BROWSER_TEST_F(RestoredCloseTest,
+                       TheFirstCloseAfterALaunchShowsTheRowAbove) {
+  ASSERT_EQ(4, tabs()->count()) << Describe();
+  tabs::TabInterface* const p = Find('p');
+  tabs::TabInterface* const s = Find('s');
+  tabs::TabInterface* const t = Find('t');
+  tabs::TabInterface* const f = Find('f');
+  ASSERT_TRUE(p && s && t && f) << Describe();
+  ASSERT_EQ(0, Index(p)) << Describe();
+  ASSERT_EQ(f, tabs()->GetActiveTab()) << "the saved selection, of"
+                                       << Describe();
+
+  // Cmd-W on the last row: no row has been used since the launch, so the
+  // row above it shows, not the window's first row.
+  chrome::CloseTab(browser());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return tabs()->count() == 3; }));
+  EXPECT_EQ(t, tabs()->GetActiveTab())
+      << "the row above the closed one, of" << Describe();
+
+  // A restored row counts once the user selects it: the first row, then the
+  // second; closing the second shows the first.
+  tabs()->ActivateTabAt(
+      Index(p), TabStripUserGestureDetails(
+                    TabStripUserGestureDetails::GestureType::kMouse));
+  tabs()->ActivateTabAt(
+      Index(s), TabStripUserGestureDetails(
+                    TabStripUserGestureDetails::GestureType::kMouse));
+  chrome::CloseTab(browser());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return tabs()->count() == 2; }));
+  EXPECT_EQ(p, tabs()->GetActiveTab())
+      << "the row used before the closed one, of" << Describe();
+}
+
+// tabs R46 (2026-10-20): addresses given on the command line are not a
+// restore. In a fresh profile each of them loads at launch, as Chromium loads
+// them, whatever "On startup, load" says. (The Mac app's own launches that
+// lost some of these requests that day are not reproduced here.)
+class CommandLineTabsTest : public InProcessBrowserTest {
+ public:
+  CommandLineTabsTest() { set_open_about_blank_on_browser_launch(false); }
+
+ protected:
+  static constexpr std::string_view kHosts = "abcde";
+
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    ASSERT_TRUE(embedded_test_server()->InitializeAndListen());
+    for (const char host : kHosts) {
+      command_line->AppendArg(Url(host).spec());
+    }
+  }
+
+  void SetUpInProcessBrowserTestFixture() override {
+    InProcessBrowserTest::SetUpInProcessBrowserTestFixture();
+    // Before the launch opens the addresses.
+    host_resolver()->AddRule("*.test", "127.0.0.1");
+    embedded_test_server()->StartAcceptingConnections();
+  }
+
+  GURL Url(char host) {
+    return embedded_test_server()->GetURL(std::string(1, host) + ".test",
+                                          "/title2.html");
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  std::string Describe() {
+    std::string out;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      content::WebContents* const contents = tabs()->GetWebContentsAt(i);
+      out += "\n  " + std::string(contents->GetVisibleURL().host()) +
+             (i == tabs()->active_index() ? " active" : "") +
+             (tabs()->IsTabHidden(i) ? " hidden" : "") +
+             (contents->WasDiscarded() ? " discarded" : "") +
+             (contents->IsLoading() ? " loading" : "") +
+             (contents->GetController().NeedsReload() ? " needs-reload" : "") +
+             (contents->GetController().GetPendingEntry() ? " pending" : "") +
+             (contents->GetPrimaryMainFrame()->IsRenderFrameLive() ? " live"
+                                                                   : "") +
+             " committed=" +
+             contents->GetPrimaryMainFrame()->GetLastCommittedURL().spec();
+    }
+    return out;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(CommandLineTabsTest, EveryAddressLoadsAtLaunch) {
+  ASSERT_EQ(static_cast<int>(kHosts.size()), tabs()->count()) << Describe();
+  for (int i = 0; i < tabs()->count(); ++i) {
+    const GURL url = Url(kHosts[i]);
+    SCOPED_TRACE(url.host());
+    content::WebContents* const contents = tabs()->GetWebContentsAt(i);
+    ASSERT_EQ(url, contents->GetVisibleURL()) << Describe();
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return contents->GetPrimaryMainFrame()->GetLastCommittedURL() == url &&
+             !contents->IsLoading();
+    })) << "it never loaded, of" << Describe();
+    EXPECT_FALSE(contents->WasDiscarded()) << Describe();
+  }
+}
+
+}  // namespace
