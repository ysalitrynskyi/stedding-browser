+// The hue, along the spectrum (spaces B43, Custom).
+class EditSpaceView::HueBar : public views::View {
+  METADATA_HEADER(HueBar, views::View)
+
+ public:
+  using Changed = base::RepeatingCallback<void(float hue)>;
+
+  explicit HueBar(Changed changed) : changed_(std::move(changed)) {
+    GetViewAccessibility().SetRole(ax::mojom::Role::kImage);
+    GetViewAccessibility().SetName(u"Hue");
+  }
+
+  void Set(float hue) {
+    hue_ = hue;
+    SchedulePaint();
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(kPadWidth, kHueHeight);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const gfx::RectF bounds(GetLocalBounds());
+    const SkPoint ends[2] = {{bounds.x(), bounds.y()},
+                             {bounds.right(), bounds.y()}};
+    std::array<SkColor4f, 7> stops;
+    for (size_t i = 0; i < stops.size(); ++i) {
+      SkScalar hsv[3] = {i * 60.f, 1, 1};
+      stops[i] = SkColor4f::FromColor(SkHSVToColor(hsv));
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setShader(cc::PaintShader::MakeLinearGradient(
+        ends, stops.data(), nullptr, stops.size(), SkTileMode::kClamp));
+    canvas->DrawRoundRect(bounds, bounds.height() / 2, flags);
+    cc::PaintFlags ring;
+    ring.setAntiAlias(true);
+    ring.setStyle(cc::PaintFlags::kStroke_Style);
+    ring.setStrokeWidth(2);
+    ring.setColor(SK_ColorWHITE);
+    canvas->DrawCircle(gfx::PointF(bounds.x() + hue_ / 360.f * bounds.width(),
+                                   bounds.CenterPoint().y()),
+                       bounds.height() / 2 + 1, ring);
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    Pick(event.location());
+    return true;
+  }
+
+  bool OnMouseDragged(const ui::MouseEvent& event) override {
+    Pick(event.location());
+    return true;
+  }
+
+ private:
+  void Pick(const gfx::Point& point) {
+    if (width() <= 0) {
+      return;
+    }
+    changed_.Run(std::clamp(static_cast<float>(point.x()) / width(), 0.f,
+                            0.999f) *
+                 360.f);
+  }
+
+  const Changed changed_;
+  float hue_ = 0;
+};
