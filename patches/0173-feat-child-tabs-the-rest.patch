+  content::WebContents* const contents = child->GetContents();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("b.test", "/title2.html")));
+  const int count = tabs()->count();
+  {
+    content::TestNavigationObserver back(contents);
+    ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_BACK));
+    back.Wait();
+  }
+  EXPECT_EQ(count, tabs()->count());
+  EXPECT_EQ(Url("b.test"), contents->GetLastCommittedURL());
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_BACK));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return tabs()->count() == count - 1; }))
+      << "the child stayed";
+  EXPECT_EQ(page, tabs()->GetActiveTab());
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_RESTORE_TAB));
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return tabs()->count() == count; }))
+      << "Shift-Cmd-T did not bring it back";
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      stedding::prefs::kNestChildTabs, false);
+  EXPECT_FALSE(chrome::CanGoBack(browser()->tab_strip_model()
+                                     ->GetActiveTab()
+                                     ->GetContents()))
+      << "with the setting off Back still closed a tab";
