+// A Dia of the test's own, where Dia keeps its data (import I28), under a
+// home the test owns, its passwords sealed under a key the test gives the
+// importer in place of the keychain's or Local State's.
+class DiaImportTest : public ImportTestBase {
+ protected:
+  void SetUpOnMainThread() override {
+    ImportTestBase::SetUpOnMainThread();
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(home_.CreateUniqueTempDir());
+#if BUILDFLAG(IS_WIN)
+    home_override_.emplace(base::DIR_LOCAL_APP_DATA, home_.GetPath());
+    user_data_ = home_.GetPath().AppendASCII("Dia").AppendASCII("User Data");
+#else
+    home_override_.emplace(base::DIR_HOME, home_.GetPath());
+    user_data_ = home_.GetPath()
+                     .AppendASCII("Library")
+                     .AppendASCII("Application Support")
+                     .AppendASCII("Dia")
+                     .AppendASCII("User Data");
+#endif
+    const base::FilePath profile = user_data_.AppendASCII("Default");
+    ASSERT_TRUE(base::CreateDirectory(profile));
+    ASSERT_TRUE(base::WriteFile(profile.AppendASCII("Bookmarks"), R"json({
+      "roots": {"other": {"type": "folder", "children": [
+        {"type": "url", "name": "Page", "url": "https://dia-page.example/"}
+      ]}}, "version": 1})json"));
+    WriteHistory(profile.AppendASCII("History"));
+    WriteLogins(profile.AppendASCII("Login Data"));
+    spaces::SetChromiumFamilyKeyForTesting(Key());
+  }
+
+  void TearDownOnMainThread() override {
+    spaces::SetChromiumFamilyKeyForTesting(std::nullopt);
+    home_override_.reset();
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      EXPECT_TRUE(home_.Delete());
+    }
+    ImportTestBase::TearDownOnMainThread();
+  }
+
+  static std::vector<uint8_t> Key() {
+#if BUILDFLAG(IS_WIN)
+    return std::vector<uint8_t>(
+        crypto::aead::KeySizeFor(crypto::aead::AES_256_GCM), 4);
+#else
+    return std::vector<uint8_t>(16, 4);
+#endif
+  }
+
+  // A value sealed as this platform's Dia seals it under Key().
+  static std::string Seal(std::string_view plain) {
+    const std::vector<uint8_t> key = Key();
+#if BUILDFLAG(IS_WIN)
+    std::vector<uint8_t> nonce(
+        crypto::aead::NonceSizeFor(crypto::aead::AES_256_GCM), 2);
+    const std::vector<uint8_t> body =
+        crypto::aead::Seal(crypto::aead::AES_256_GCM, key,
+                           base::as_byte_span(plain), nonce,
+                           base::span<const uint8_t>());
+    std::string sealed = "v10";
+    sealed.append(nonce.begin(), nonce.end());
+#else
+    std::array<uint8_t, crypto::aes_cbc::kBlockSize> iv;
+    iv.fill(' ');
+    const std::vector<uint8_t> body =
+        crypto::aes_cbc::Encrypt(key, iv, base::as_byte_span(plain));
+    std::string sealed = "v10";
+#endif
+    sealed.append(body.begin(), body.end());
+    return sealed;
+  }
+
+  static void WriteHistory(const base::FilePath& file) {
+    sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                     sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(file));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE urls(id INTEGER PRIMARY KEY, url LONGVARCHAR, "
+        "title LONGVARCHAR, visit_count INTEGER DEFAULT 0 NOT NULL, "
+        "typed_count INTEGER DEFAULT 0 NOT NULL, last_visit_time INTEGER "
+        "NOT NULL, hidden INTEGER DEFAULT 0 NOT NULL)"));
+    sql::Statement s(db.GetUniqueStatement(
+        "INSERT INTO urls VALUES (1, 'https://dia-visit.example/', 'Visit', "
+        "1, 0, ?, 0)"));
+    s.BindInt64(0, (base::Time::Now() - base::Days(1))
+                       .ToDeltaSinceWindowsEpoch()
+                       .InMicroseconds());
+    ASSERT_TRUE(s.Run());
+  }
+
+  static void WriteLogins(const base::FilePath& file) {
+    sql::Database db(sql::DatabaseOptions().set_exclusive_locking(false),
+                     sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(file));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE logins(origin_url VARCHAR NOT NULL, action_url VARCHAR, "
+        "username_element VARCHAR, username_value VARCHAR, password_element "
+        "VARCHAR, password_value BLOB, signon_realm VARCHAR NOT NULL, "
+        "date_created INTEGER NOT NULL, blacklisted_by_user INTEGER NOT NULL, "
+        "scheme INTEGER NOT NULL, date_last_used INTEGER NOT NULL DEFAULT 0, "
+        "date_password_modified INTEGER NOT NULL DEFAULT 0)"));
+    sql::Statement s(db.GetUniqueStatement(
+        "INSERT INTO logins VALUES ('https://dia-login.example/', "
+        "'https://dia-login.example/', 'user', 'ann', 'pass', ?, "
+        "'https://dia-login.example/', 0, 0, 0, 0, 0)"));
+    const std::string sealed = Seal("fromdia");
+    s.BindBlob(0, base::as_byte_span(sealed));
+    ASSERT_TRUE(s.Run());
+  }
+
+  spaces::ChromiumProfile DefaultProfile() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    const std::vector<spaces::ChromiumProfile> profiles =
+        spaces::ListChromiumProfiles(user_data_);
+    EXPECT_EQ(1u, profiles.size());
+    return profiles.empty() ? spaces::ChromiumProfile() : profiles[0];
+  }
+
+  base::ScopedTempDir home_;
+  std::optional<base::ScopedPathOverride> home_override_;
+  base::FilePath user_data_;
+};
+
+// import I31, I32: the welcome flow's Dia block sums the profile up without
+// asking for the key; "Move everything from Dia" then brings the bookmark
+// into "Imported from Dia", the visit and the login, asking once.
+IN_PROC_BROWSER_TEST_F(DiaImportTest, TheWelcomeBlockSummarisesThenImports) {
+  content::WebContents* const page = OpenWelcomeImportStep(*browser());
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page,
+                           "!!(steddingWelcomeTest.state.dia && "
+                           "steddingWelcomeTest.state.dia.found)")
+        .ExtractBool();
+  })) << "the welcome flow did not find Dia";
+  EXPECT_EQ("1 bookmark, history and 1 saved password",
+            State(page, "dia.profiles[0].summary"));
+  EXPECT_EQ(0u, spaces::ChromiumFamilyKeyReadsForTesting())
+      << "the summary asked for Dia's key";
+  ASSERT_TRUE(content::ExecJs(page, R"(
+      for (let i = 0;
+           i < 3 && !document.querySelector('[data-focus="dia-move"]'); ++i) {
+        document.querySelector('footer button.primary').click();
+      }
+      document.querySelector('[data-focus="dia-move"]').click();)"));
+  std::string line;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    line = State(page, "diaStatus");
+    return !line.empty() && line != "inProgress";
+  })) << "the import never ended";
+  EXPECT_EQ(
+      "Brought in from Dia: 1 bookmark, 1 history entry and 1 password.",
+      line);
+  EXPECT_EQ(1u, spaces::ChromiumFamilyKeyReadsForTesting());
+  EXPECT_EQ(1u, FoldersNamed(u"Imported from Dia"));
+  EXPECT_TRUE(Bookmarks()->IsBookmarked(GURL(kDiaPage)));
+  EXPECT_EQ(1u, VisitsTo(GURL(kDiaVisit)));
+  EXPECT_EQ(u"fromdia", PasswordFor(browser()->GetProfile(),
+                                    "https://dia-login.example/", u"ann"));
+}
+
+// import I40: a second import of the same profile adds no bookmark, no visit
+// and no login; two at once run as one, the second told so.
+IN_PROC_BROWSER_TEST_F(DiaImportTest, ImportingAgainAddsNothing) {
+  Profile* const profile = browser()->GetProfile();
+  const spaces::ChromiumProfile dia = DefaultProfile();
+  base::test::TestFuture<spaces::ChromiumFamilyResult> first;
+  base::test::TestFuture<spaces::ChromiumFamilyResult> overlapping;
+  spaces::ImportChromiumFamilyAsync(*profile, spaces::kDiaSource, dia,
+                                    spaces::ChromiumFamilyParts(),
+                                    first.GetCallback());
+  spaces::ImportChromiumFamilyAsync(*profile, spaces::kDiaSource, dia,
+                                    spaces::ChromiumFamilyParts(),
+                                    overlapping.GetCallback());
+  EXPECT_TRUE(overlapping.Get().already_running);
+  EXPECT_EQ(1u, first.Get().bookmarks);
+  EXPECT_EQ(1u, first.Get().history);
+  EXPECT_EQ(1u, first.Get().passwords.added);
+
+  base::test::TestFuture<spaces::ChromiumFamilyResult> second;
+  spaces::ImportChromiumFamilyAsync(*profile, spaces::kDiaSource, dia,
+                                    spaces::ChromiumFamilyParts(),
+                                    second.GetCallback());
+  EXPECT_EQ(0u, second.Get().bookmarks);
+  EXPECT_EQ(1u, second.Get().bookmarks_already);
+  EXPECT_EQ(0u, second.Get().history);
+  EXPECT_EQ(0u, second.Get().passwords.added);
+  EXPECT_EQ(1u, second.Get().passwords.already_saved);
+  EXPECT_EQ(1u, FoldersNamed(u"Imported from Dia"));
+  EXPECT_EQ(1u, VisitsTo(GURL(kDiaVisit)));
+}
