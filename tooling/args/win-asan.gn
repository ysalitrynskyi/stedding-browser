# Stedding — Windows AddressSanitizer build (x64).
#
# What this is for: the lifetime tests of PLAN.md Phase 0 (TAB-7, TAB-8, SPC-1, SPC-2,
# SPC-3, WIN-1, WIN-2, WEB-2) run under ASan, which reports a use-after-free where the
# freed memory is read instead of where something crashes later. Build only the two test
# targets with it (`tooling\win\build.ps1 -Config win-asan -Targets unit_tests,
# stedding_browser_tests`): the in-process browser tests do not need the browser itself.
#
# What it is NOT: a shipping configuration, or one to measure with. ASan slows
# everything down and changes the layout of memory. Release optimisation, as
# docs/asan.md asks, so the timing the tests see is not a debug build's.
#
# ASan and BackupRefPtr are exclusive: ASan turns PartitionAlloc-Everywhere off. The
# dangling-pointer detector has its own configuration, win-checks.gn.

target_os  = "win"
target_cpu = "x64"

is_debug           = false
is_component_build = false
is_asan            = true

# Line tables, not full symbols: on Windows an ASan report without them names no
# function at all, and full symbols would double the disk this build needs.
symbol_level       = 1
blink_symbol_level = 0
v8_symbol_level    = 0

# Google's remote execution backends are not available to us (see docs/ARCHITECTURE.md,
# "Build system"). Everything is built locally.
use_remoteexec = false

# No field-trial testing config (docs/features/privacy.md Q10). Chromium activates
# testing/variations/fieldtrial_testing_config.json in every build that does not
# set this, official builds included: Google's experiment set, switched on by a
# file in the tree rather than by anyone's decision here. Off in every Stedding
# configuration; the browser's behaviour is what the series and the defaults say.
disable_fieldtrial_testing_config = true

dcheck_always_on = false

# Proprietary codecs: H.264, AAC, MP3, and the MP4 container.
#
# Upstream defaults these off, which is why a vanilla Chromium cannot play a
# large share of the web's video. A browser people are asked to use every day
# has to play what the web actually serves, so they are on.
#
# This is a licensing position, not a build flag. Distributing binaries that
# decode AVC/H.264 and AAC carries patent obligations, administered by Via LA.
# The decision, and who owns it, is recorded in
# docs/decisions/0008-proprietary-codecs.md.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
