+#include "url/gurl.h"
+
+namespace {
+
+using stedding::SidebarPanel;
+
+// The History panel's row for the page `url`, as a script expression.
+std::string RowForW2B04(const std::string& url) {
+  return content::JsReplace(
+      "[...document.querySelectorAll('#list .row')].find("
+      "    row => row.dataset.url === $1)",
+      url);
+}
+
+// The page of the History row whose main button has the focus, or "" when
+// the focus is on nothing of the kind.
+constexpr char kFocusedRowW2B04[] = R"(
+    (() => {
+      const focused = document.activeElement;
+      const row = focused && focused.closest('#list .row');
+      return row && focused.classList.contains('row-main') ?
+          row.dataset.url : '';
+    })())";
+
+// Lets `delay` pass, for a change that should not come.
+void PauseW2B04(base::TimeDelta delay) {
+  base::RunLoop run_loop;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, run_loop.QuitClosure(), delay);
+  run_loop.Run();
+}
+
+class SidebarPanelsW2B04Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* window() { return browser_view()->GetWidget(); }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  stedding::SidebarPanelView* panel_view() {
+    return region()->sidebar_panel_view_for_testing();
+  }
+  content::WebContents* panel_page() {
+    return panel_view() ? panel_view()->web_view()->GetWebContents() : nullptr;
+  }
+  void Layout() { views::test::RunScheduledLayout(window()); }
+  history::HistoryService* history() {
+    return HistoryServiceFactory::GetForProfile(
+        browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+  }
+
+  // Waits until `panel` is the one in the sidebar's column -- none for
+  // kNone -- and its page has built itself.
+  [[nodiscard]] bool WaitForPanel(SidebarPanel panel) {
+    if (!base::test::RunUntil([&]() {
+          Layout();
+          stedding::SidebarPanelView* const view = panel_view();
+          return panel == SidebarPanel::kNone
+                     ? view == nullptr
+                     : view != nullptr && view->panel() == panel;
+        })) {
+      return false;
+    }
+    if (panel == SidebarPanel::kNone) {
+      return true;
+    }
+    content::WebContents* const page = panel_page();
+    if (!content::WaitForLoadStop(page)) {
+      return false;
+    }
+    return base::test::RunUntil([&]() {
+      return content::EvalJs(page, "document.body.dataset.panel || ''")
+                 .ExtractString() != "";
+    });
+  }
+  // Whether the History panel is still the one in the sidebar's column.
+  bool HistoryStillOpen() {
+    Layout();
+    return panel_view() && panel_view()->panel() == SidebarPanel::kHistory;
+  }
+
+  void AddVisit(const GURL& url, const std::u16string& title, base::Time when) {
+    history()->AddPageWithDetails(url, title, /*visit_count=*/1,
+                                  /*typed_count=*/0, when, /*hidden=*/false,
+                                  history::SOURCE_BROWSED);
+  }
+  // Removes every visit, so the list holds only the rows the test adds.
+  [[nodiscard]] bool ClearHistory() {
+    base::test::TestFuture<void> done;
+    base::CancelableTaskTracker tracker;
+    history()->ExpireHistoryBetween(
+        /*restrict_urls=*/{}, /*restrict_app_id=*/std::nullopt, base::Time(),
+        base::Time(), /*user_initiated=*/true, done.GetCallback(), &tracker);
+    return done.Wait();
+  }
+  // `count` visits of today, a second apart, the newest first.
+  [[nodiscard]] bool AddVisitsOfToday(int count) {
+    ui_test_utils::WaitForHistoryToLoad(history());
+    if (!ClearHistory()) {
+      return false;
+    }
+    const base::Time now = base::Time::Now();
+    for (int i = 0; i < count; ++i) {
+      AddVisit(GURL("https://recent-" + base::NumberToString(i) + ".test/"),
+               u"Recent page", now - base::Seconds(i + 1));
+    }
+    history::BlockUntilHistoryProcessesPendingRequests(history());
+    return true;
+  }
+  // Opens the History panel and waits for its first fifty rows.
+  [[nodiscard]] bool OpenHistory() {
+    return chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY) &&
+           WaitForPanel(SidebarPanel::kHistory) && WaitForRows(50);
+  }
+
+  int RowCount() {
+    return content::EvalJs(panel_page(),
+                           "document.querySelectorAll('#list .row').length")
+        .ExtractInt();
+  }
+  [[nodiscard]] bool WaitForRows(int count) {
+    return base::test::RunUntil([&]() { return RowCount() == count; });
+  }
+  // Scrolls the panel's list to its end, where the next page loads (Pn6).
+  void ScrollToTheEnd() {
+    ASSERT_TRUE(content::ExecJs(
+        panel_page(),
+        "{ const list = document.getElementById('list');"
+        "  list.scrollTop = list.scrollHeight; }"));
+  }
+  // Scrolls to the list's end until it holds at least `count` rows, as a
+  // person scrolls on when the next rows have not come yet.
+  [[nodiscard]] bool ScrollUntilRows(int count) {
+    return base::test::RunUntil([&]() {
+      ScrollToTheEnd();
+      return RowCount() >= count;
+    });
+  }
+  // Whether the list is within 200 px of its end, where it asks for more.
+  bool NearTheEnd() {
+    return content::EvalJs(panel_page(), R"(
+        (() => {
+          const list = document.getElementById('list');
+          return list.scrollTop + list.clientHeight >=
+              list.scrollHeight - 200;
+        })())")
+        .ExtractBool();
+  }
+  // Lets the panel's page draw two frames: a redraw it has asked for has run.
+  [[nodiscard]] bool WaitForTwoFrames() {
+    return content::ExecJs(panel_page(),
+                           "new Promise(r => requestAnimationFrame(() => "
+                           "requestAnimationFrame(r)))");
+  }
+  // The page of the History row at `index`, newest first.
+  std::string UrlOfRow(int index) {
+    return content::EvalJs(
+               panel_page(),
+               content::JsReplace(
+                   "document.querySelectorAll('#list .row')[$1].dataset.url",
+                   index))
+        .ExtractString();
+  }
+  bool HasRow(const std::string& url) {
+    return content::EvalJs(panel_page(), "!!" + RowForW2B04(url))
+        .ExtractBool();
+  }
+  // How far the top of `url`'s row is below the top of the list's view, in
+  // pixels.
+  int RowOffsetInView(const std::string& url) {
+    return content::EvalJs(
+               panel_page(),
+               // `| 0`: a row a fraction above the list's top rounds to -0,
+               // which comes back as a double.
+               "(Math.round(" + RowForW2B04(url) +
+                   ".getBoundingClientRect().top - "
+                   "document.getElementById('list')"
+                   ".getBoundingClientRect().top) | 0)")
+        .ExtractInt();
+  }
+};
+
+// P04-1i, Pn5: an Escape that ends an input method's composition in the
+// search field is the input method's, and the panel stays open. The Mac's
+// view hands the page that key as one the input method took (key code 229),
+// its key still "Escape", while the composition is on: the page closed the
+// panel on it, and the half-typed search went with it. The next Escape, with
+// no composition, closes the panel.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsW2B04Test,
+                       AnEscapeThatEndsACompositionLeavesThePanelOpen) {
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kHistory));
+  content::SimulateEndOfPaintHoldingOnPrimaryMainFrame(panel_page());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(), "document.activeElement?.id || ''")
+               .ExtractString() == "search";
+  })) << "the search field does not have the focus";
+  // The panel's page has the keyboard, as it has when it opens.
+  panel_page()->Focus();
+
+  ASSERT_TRUE(content::ExecJs(panel_page(), R"(
+      {
+        window.seenW2B04 = {compositions: 0, ended: 0, escapes: 0};
+        const field = document.getElementById('search');
+        field.addEventListener(
+            'compositionstart', () => ++window.seenW2B04.compositions);
+        field.addEventListener(
+            'compositionend', () => ++window.seenW2B04.ended);
+        window.addEventListener('keydown', e => {
+          if (e.key === 'Escape') {
+            ++window.seenW2B04.escapes;
+          }
+        }, true);
+      })"));
+  content::SendImeSetCompositionTextToWidget(
+      panel_page()->GetPrimaryMainFrame()->GetRenderWidgetHost(), u"nihon",
+      std::vector<ui::ImeTextSpan>(), gfx::Range::InvalidRange(),
+      /*selection_start=*/5, /*selection_end=*/5);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(), "window.seenW2B04.compositions")
+               .ExtractInt() == 1;
+  })) << "the search field took no composition";
+
+  // The key the input method took, as the Mac's view sends it on.
+  content::SimulateKeyPressWithoutChar(
+      panel_page(), ui::DomKey::ESCAPE, ui::DomCode::ESCAPE,
+      ui::VKEY_PROCESSKEY, /*control=*/false, /*shift=*/false, /*alt=*/false,
+      /*command=*/false);
+  // Time for the key to reach the page and for a close it asked for.
+  PauseW2B04(base::Seconds(1));
+  ASSERT_TRUE(HistoryStillOpen())
+      << "an Escape the input method took closed the panel";
+  EXPECT_EQ(1, content::EvalJs(panel_page(), "window.seenW2B04.escapes"))
+      << "the key did not reach the page";
+
+  // The composition ends, and the next Escape is the panel's. The input
+  // method commits it; the Escape it took may have ended it already (on
+  // Windows the field hears no compositionend), so this does not wait for one.
+  content::SendImeCommitTextToWidget(
+      panel_page()->GetPrimaryMainFrame()->GetRenderWidgetHost(), u"nihon",
+      std::vector<ui::ImeTextSpan>(), gfx::Range::InvalidRange(),
+      /*relative_cursor_pos=*/0);
+  PauseW2B04(base::Milliseconds(500));
+  content::SimulateKeyPress(panel_page(), ui::DomKey::ESCAPE,
+                            ui::DomCode::ESCAPE, ui::VKEY_ESCAPE,
+                            /*control=*/false, /*shift=*/false, /*alt=*/false,
+                            /*command=*/false);
+  EXPECT_TRUE(WaitForPanel(SidebarPanel::kNone))
+      << "Escape with no composition left the panel open";
+}
+
+// P04-1i, Pn5: the same, told by the key event alone: an Escape keydown that
+// says a composition is on, or that carries the key code of a key an input
+// method took, leaves the panel open; a plain one closes it.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsW2B04Test,
+                       AComposingEscapeKeydownLeavesThePanelOpen) {
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kHistory));
+  for (const char* const init :
+       {"{key: 'Escape', isComposing: true, bubbles: true}",
+        "{key: 'Escape', keyCode: 229, bubbles: true}"}) {
+    SCOPED_TRACE(init);
+    ASSERT_TRUE(content::ExecJs(
+        panel_page(),
+        std::string("document.getElementById('search').dispatchEvent("
+                    "new KeyboardEvent('keydown', ") +
+            init + "))"));
+    PauseW2B04(base::Milliseconds(500));
+    ASSERT_TRUE(HistoryStillOpen()) << "the panel closed under a composition";
+  }
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(),
+      "document.getElementById('search').dispatchEvent("
+      "new KeyboardEvent('keydown', {key: 'Escape', bubbles: true}))"));
+  EXPECT_TRUE(WaitForPanel(SidebarPanel::kNone))
+      << "a plain Escape left the panel open";
+}
+
+// P04-1k, Pn6: history deleted elsewhere -- in chrome://history, another
+// window's panel -- refreshes the list as long as it was, so the reader past
+// the first fifty rows stays on the rows they were reading. The refresh asked
+// for the first fifty alone: the list shrank under the reader, its scroll
+// was cut to the end of those fifty, and the next ones loaded from there.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsW2B04Test,
+                       AHistoryDeletionElsewhereKeepsTheReadersPlace) {
+  ASSERT_TRUE(AddVisitsOfToday(150));
+  ASSERT_TRUE(OpenHistory()) << RowCount();
+  ASSERT_TRUE(ScrollUntilRows(150)) << RowCount();
+  // The answer to the last ask for more has come.
+  PauseW2B04(base::Milliseconds(500));
+  ASSERT_TRUE(WaitForTwoFrames());
+  ASSERT_EQ(150, RowCount());
+
+  // The reader is at row 100.
+  const std::string reading = UrlOfRow(100);
+  ASSERT_TRUE(content::ExecJs(panel_page(), R"(
+      {
+        const list = document.getElementById('list');
+        const row = document.querySelectorAll('#list .row')[100];
+        list.scrollTop += row.getBoundingClientRect().top -
+            list.getBoundingClientRect().top;
+      })"));
+  ASSERT_TRUE(WaitForTwoFrames());
+  ASSERT_FALSE(NearTheEnd()) << "the window is too tall for this test";
+  const int offset = RowOffsetInView(reading);
+
+  // The oldest visit goes, elsewhere: nothing above the reader moves.
+  const std::string deleted = UrlOfRow(149);
+  history()->DeleteURLs({GURL(deleted)});
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !HasRow(deleted); }))
+      << "the list did not refresh";
+  ASSERT_TRUE(WaitForTwoFrames());
+  PauseW2B04(base::Milliseconds(500));
+
+  EXPECT_EQ(149, RowCount()) << "the refreshed list is not as long as before";
+  ASSERT_TRUE(HasRow(reading)) << "the row being read is not in the list";
+  EXPECT_NEAR(offset, RowOffsetInView(reading), 2)
+      << "the row being read moved in the view";
+}
+
+// P04-1k, Pn6: after that refresh the next page is fifty rows again. The
+// history service keeps a query's count for every page after it, so a
+// refresh that asked once for as many rows as the list held made each later
+// page that long.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsW2B04Test,
+                       AfterARefreshThePagesStayFiftyRows) {
+  ASSERT_TRUE(AddVisitsOfToday(300));
+  ASSERT_TRUE(OpenHistory()) << RowCount();
+  // At least three pages; a scroll to the end made as the third came asks
+  // for a fourth, so the list may hold four.
+  ASSERT_TRUE(ScrollUntilRows(150)) << RowCount();
+  PauseW2B04(base::Milliseconds(500));
+  ASSERT_TRUE(WaitForTwoFrames());
+  const int before = RowCount();
+  ASSERT_GE(before, 150);
+  ASSERT_LE(before, 249) << "no full page is left to load";
+  // Back at the top, so the refresh loads nothing more by itself.
+  ASSERT_TRUE(content::ExecJs(panel_page(),
+                              "document.getElementById('list').scrollTop = 0;"));
+  ASSERT_TRUE(WaitForTwoFrames());
+
+  const std::string deleted = UrlOfRow(10);
+  history()->DeleteURLs({GURL(deleted)});
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !HasRow(deleted); }))
+      << "the list did not refresh";
+  ASSERT_TRUE(WaitForTwoFrames());
+  PauseW2B04(base::Milliseconds(500));
+  const int refreshed = RowCount();
+  ASSERT_EQ(before, refreshed) << "the refreshed list is not as long as before";
+
+  // One more page: fifty rows, whatever the list held.
+  ScrollToTheEnd();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return RowCount() > refreshed; }))
+      << RowCount();
+  PauseW2B04(base::Milliseconds(500));
+  ASSERT_TRUE(WaitForTwoFrames());
+  EXPECT_EQ(refreshed + 50, RowCount())
+      << "the page after the refresh was not fifty rows (the refreshed list "
+         "held "
+      << refreshed << ")";
+}
+
+// P04-1f, Pn6: the keyboard's focus on a History row stays on that row when
+// the next fifty rows load and when history deleted elsewhere redraws the
+// list. Every load drew every row anew and put the focus back nowhere, so it
+// fell to the page and the next Tab started at the top of the list.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsW2B04Test,
+                       TheFocusOnAHistoryRowStaysAsRowsLoadAndRedraw) {
+  ASSERT_TRUE(AddVisitsOfToday(150));
+  ASSERT_TRUE(OpenHistory()) << RowCount();
+
+  const std::string focused = UrlOfRow(45);
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(), RowForW2B04(focused) +
+                        ".querySelector('.row-main')"
+                        ".focus({preventScroll: true});"));
+  ASSERT_EQ(focused, content::EvalJs(panel_page(), kFocusedRowW2B04));
+
+  {
+    SCOPED_TRACE("the next fifty rows load");
+    ASSERT_TRUE(ScrollUntilRows(100)) << RowCount();
+    ASSERT_TRUE(WaitForTwoFrames());
+    EXPECT_EQ(focused, content::EvalJs(panel_page(), kFocusedRowW2B04))
+        << "the focus left its row as the rows loaded";
+  }
+  {
+    SCOPED_TRACE("history deleted elsewhere");
+    ASSERT_TRUE(content::ExecJs(
+        panel_page(), RowForW2B04(focused) +
+                          ".querySelector('.row-main')"
+                          ".focus({preventScroll: true});"));
+    const std::string deleted = UrlOfRow(60);
+    history()->DeleteURLs({GURL(deleted)});
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !HasRow(deleted); }))
+        << "the list did not refresh";
+    ASSERT_TRUE(WaitForTwoFrames());
+    EXPECT_EQ(focused, content::EvalJs(panel_page(), kFocusedRowW2B04))
+        << "the focus left its row as the list was drawn again";
+  }
+}
