+// The sidebar's settings with only private windows.
+
+class SidebarMetricsPrivateW2B20Test : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
