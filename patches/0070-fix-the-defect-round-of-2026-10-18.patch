+    return enabled;
+  }
+
+  void SetUpOnMainThread() override {
+    SpaceSwitchTest::SetUpOnMainThread();
+    // The window paints as active for as long as a step wants it to,
+    // whatever other windows on the machine do meanwhile.
+    active_ = widget()->LockPaintAsActive();
+  }
+
+  void TearDownOnMainThread() override {
+    active_.reset();
+    SpaceSwitchTest::TearDownOnMainThread();
+  }
+
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+
+  // Presses or releases the numbers' key where the sidebar's monitor on the
+  // window hears it, as a key press reaches it; no operating-system input is
+  // sent. On the Mac through -[NSApp sendEvent:], where an application's
+  // local event monitors run; elsewhere dispatched to the browser window, as
+  // the window's own key events are while it has the focus.
+  void NumbersKey(bool down) {
+#if BUILDFLAG(IS_MAC)
+    ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                       widget()->GetNativeWindow());
+    generator.set_target(ui::test::EventGenerator::Target::APPLICATION);
+    if (down) {
+      generator.PressKey(ui::VKEY_COMMAND, ui::EF_COMMAND_DOWN);
+    } else {
+      generator.ReleaseKey(ui::VKEY_COMMAND, ui::EF_NONE);
+    }
+#else
+    aura::Window* const window = widget()->GetNativeWindow();
+    ui::KeyEvent event(
+        down ? ui::EventType::kKeyPressed : ui::EventType::kKeyReleased,
+        ui::VKEY_CONTROL, down ? ui::EF_CONTROL_DOWN : ui::EF_NONE);
+    const ui::EventDispatchDetails details =
+        window->GetHost()->dispatcher()->DispatchEvent(window, &event);
+    ASSERT_FALSE(details.dispatcher_destroyed);
+#endif
+  }
+
+  // The tab each drawn row's number badge names, by the number it shows.
+  std::map<int, tabs::TabInterface*> RowNumbers() {
+    views::test::RunScheduledLayout(widget());
+    std::map<int, tabs::TabInterface*> numbers;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(i);
+      TabView* const row =
+          stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+      views::Label* const badge =
+          row ? row->number_badge_for_testing() : nullptr;
+      int number = 0;
+      if (badge && badge->GetVisible() &&
+          base::StringToInt(badge->GetText(), &number)) {
+        numbers[number] = tab;
+      }
+    }
+    return numbers;
+  }
+
+  // Holds the key until the rows show their numbers (after 250 ms).
+  void HoldUntilTheNumbersShow() {
+    ASSERT_NO_FATAL_FAILURE(NumbersKey(/*down=*/true));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !RowNumbers().empty(); }))
+        << "holding the key showed no numbers";
+  }
+
+  // Lets `delay` pass with the loop running.
+  static void Wait(base::TimeDelta delay) {
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, run_loop.QuitClosure(), delay);
+    run_loop.Run();
+  }
+
+  // The window stops painting as active, as when another app takes the
+  // keyboard (Cmd-Tab on the Mac) or another window is clicked: the native
+  // window reports it to the widget through this call.
+  void Deactivate() {
+    active_.reset();
+    widget()->OnNativeWidgetActivationChanged(false);
+    ASSERT_FALSE(widget()->ShouldPaintAsActive());
+  }
+
+  void Activate() {
+    widget()->OnNativeWidgetActivationChanged(true);
+    active_ = widget()->LockPaintAsActive();
+    ASSERT_TRUE(widget()->ShouldPaintAsActive());
+  }
+
+#if BUILDFLAG(IS_MAC)
