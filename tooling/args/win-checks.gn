# Stedding — Windows build with the dangling-pointer detector and DCHECKs on (x64).
#
# What this is for: PLAN.md TAB-7, TAB-8 and TAB-9 ask for the lifetime tests to run under
# dangling-pointer detection, which crashes the moment a raw_ptr is still pointing at
# memory that has been freed, whether or not anything reads it afterwards, and WIN-2 asks
# for the full-page screenshot to run with no DCHECK failing. Build only the two test
# targets with it (`tooling\win\build.ps1 -Config win-checks -Targets unit_tests,
# stedding_browser_tests`) and run them with
#
#   --enable-features=PartitionAllocBackupRefPtr,PartitionAllocDanglingPtr
#
# (docs/dangling_ptr.md in the checkout). Without that runtime flag the detector is
# compiled in and does nothing.
#
# What it is NOT: a shipping configuration, or one to measure with.
#
# The two lines the Chromium docs mark important are kept exactly: is_debug = false and
# is_component_build = false. A debug or component build turns PartitionAlloc-Everywhere
# off, BackupRefPtr cannot work without it, and it is switched off silently -- the build
# would look right and detect nothing. DCHECKs are on through dcheck_always_on instead of
# is_debug, so the code is the optimised one the tests otherwise see.

target_os  = "win"
target_cpu = "x64"

is_debug           = false
is_component_build = false

dcheck_always_on               = true
enable_backup_ref_ptr_support  = true
enable_dangling_raw_ptr_checks = true

# Line tables so a report's stacks name functions; full symbols would double the disk.
symbol_level       = 1
blink_symbol_level = 0
v8_symbol_level    = 0

# Google's remote execution backends are not available to us (see docs/ARCHITECTURE.md,
# "Build system"). Everything is built locally.
use_remoteexec = false

# No field-trial testing config (docs/features/privacy.md Q10). Chromium activates
# testing/variations/fieldtrial_testing_config.json in every build that does not
# set this, official builds included: Google's experiment set, switched on by a
# file in the tree rather than by anyone's decision here. Off in every Stedding
# configuration; the browser's behaviour is what the series and the defaults say.
disable_fieldtrial_testing_config = true

# Proprietary codecs: H.264, AAC, MP3, and the MP4 container.
#
# Upstream defaults these off, which is why a vanilla Chromium cannot play a
# large share of the web's video. A browser people are asked to use every day
# has to play what the web actually serves, so they are on.
#
# This is a licensing position, not a build flag. Distributing binaries that
# decode AVC/H.264 and AAC carries patent obligations, administered by Via LA.
# The decision, and who owns it, is recorded in
# docs/decisions/0008-proprietary-codecs.md.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
