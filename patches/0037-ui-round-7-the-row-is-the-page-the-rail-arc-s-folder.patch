diff --git a/chrome/browser/ui/views/tabs/common/folder_view_unittest.cc b/chrome/browser/ui/views/tabs/common/folder_view_unittest.cc
new file mode 100644
index 0000000000000..e2e0afdff23b2
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/common/folder_view_unittest.cc
@@ -0,0 +1,59 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/folder_view.h"
+
+#include "chrome/browser/ui/views/tabs/common/tab_collection_node.h"
+#include "chrome/browser/ui/views/tabs/shared/tab_strip_types.h"
+#include "chrome/test/views/chrome_views_test_base.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/mock_tab_interface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/font.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/controls/image_view.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+using FolderViewTest = ChromeViewsTestBase;
+
+// folders F12: Arc's folder row -- a folder glyph (macOS's own symbol) in
+// the favicon column, a semibold title, no chevron, and the header on the
+// tab rows' column rather than indented like the folder's children.
+TEST_F(FolderViewTest, HeaderShowsAFolderGlyphAndASemiboldTitle) {
+  tabs::FolderTabCollection folder(tabs::FolderId::GenerateNew(), "Work",
+                                   /*collapsed=*/true);
+  TabCollectionNode node(&folder, TabStripOrientation::kVertical);
+  FolderView view(&node);
+  EXPECT_EQ(&folder, view.folder());
+  EXPECT_FALSE(view.glyph_for_testing()->GetImageModel().IsEmpty());
+  EXPECT_EQ(gfx::Size(18, 18), view.glyph_for_testing()->GetPreferredSize());
+  EXPECT_EQ(u"Work", view.name_for_testing()->GetText());
+  EXPECT_EQ(gfx::Font::Weight::SEMIBOLD,
+            view.name_for_testing()->font_list().GetFontWeight());
+  const gfx::Insets* const margins =
+      view.header_for_testing()->GetProperty(views::kMarginsKey);
+  EXPECT_TRUE(!margins || margins->left() == 0)
+      << "the header is not indented like the folder's children";
+}
+
+// folders F12 (the crash at quit): a header whose node no longer names a
+// folder answers a theme change by doing nothing, instead of reading a
+// folder that is not there.
+TEST_F(FolderViewTest, HeaderSurvivesANodeThatIsNotAFolder) {
+  tabs::MockTabInterface tab;
+  TabCollectionNode node(&tab, TabStripOrientation::kVertical);
+  FolderView view(&node);
+  EXPECT_EQ(nullptr, view.folder());
+  view.OnThemeChanged();
+  view.UpdateHeaderForTesting();
+  EXPECT_EQ(u"", view.name_for_testing()->GetText());
+}
+
+}  // namespace
