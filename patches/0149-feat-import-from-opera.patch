+// False, and nothing charged, when the copy would go past it.
+bool ChargePathCopy(const std::vector<std::u16string>& path,
+                    size_t& path_chars) {
+  size_t cost = 0;
+  for (const std::u16string& name : path) {
+    cost += name.size() + 1;
+  }
+  if (cost > kMaxChromiumBookmarkPathChars - path_chars) {
+    return false;
+  }
+  path_chars += cost;
+  return true;
