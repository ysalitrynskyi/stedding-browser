@@ -0,0 +1,196 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/import.md I47: after an Arc import, where each thing from Arc
+// is in Stedding, in Stedding's words, with a button to the place where there
+// is one, and what did not come across. Plain DOM, as the setup flow is; the
+// map is the one on the site's page for people leaving Arc.
+/* eslint-disable no-restricted-imports, no-restricted-properties */
+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+// What the last import did with Arc's routes.
+interface FromArc {
+  routes: number;
+  routesLeftOut: number;
+}
+
+interface Place {
+  // Arc's word for it.
+  was: string;
+  // Stedding's, and how it works here.
+  now: string;
+  text: string;
+  // The card of Settings the button opens, when there is one.
+  card?: string;
+}
+
+const isMac = /Mac/.test(navigator.userAgent);
+const key = (mac: string, other: string) => isMac ? mac : other;
+
+function places(): Place[] {
+  return [
+    {
+      was: 'URL bar',
+      now: 'The address',
+      text: 'Across the top as Stedding starts, or at the top of the sidebar.',
+      card: 'sidebar',
+    },
+    {
+      was: 'Spaces',
+      now: 'Spaces',
+      text: `A colour and an icon each. ${key('⌃1–⌃9', 'Alt+1–9')} ` +
+          'moves between them.',
+      card: 'spaces',
+    },
+    {
+      was: 'Favorites',
+      now: 'Essentials',
+      text: 'Cards at the top of the sidebar.',
+    },
+    {
+      was: 'Pinned tabs and folders',
+      now: 'Pinned tabs and folders',
+      text: `A pinned tab remembers its page; ${key('⌘W', 'Ctrl+W')} ` +
+          'sends it home.',
+    },
+    {
+      was: 'Command bar',
+      now: 'Command bar',
+      text: `${key('⌘T', 'Ctrl+T')} for an address, a search or any tab ` +
+          'in any Space.',
+    },
+    {
+      was: 'Split view',
+      now: 'Split view',
+      text: 'Drag a tab onto the page.',
+    },
+    {
+      was: 'Peek',
+      now: 'Peek',
+      text: 'A pinned tab’s link to another site opens on a card over the ' +
+          'page.',
+      card: 'peek',
+    },
+    {
+      was: 'Little Arc',
+      now: 'Little windows',
+      text: `Links from other apps open small; ${key('⌘O', 'Ctrl+O')} ` +
+          'keeps one as a tab.',
+      card: 'peek',
+    },
+    {
+      was: 'Air Traffic Control',
+      now: 'Sites routed to Spaces',
+      text: 'A site always opens in the Space you choose.',
+      card: 'routes',
+    },
+    {
+      was: 'Auto-archive',
+      now: 'The archive',
+      text: 'Idle tabs go to the archive, once you turn it on.',
+      card: 'tabs',
+    },
+    {
+      was: 'Hidden sidebar',
+      now: 'Folding sidebar',
+      text: `${key('⌘S', 'Ctrl+S')} folds it to icons, or hides it.`,
+      card: 'sidebar',
+    },
+    {
+      was: 'Sync',
+      now: 'Sidebar sync',
+      text: 'Through a folder you already sync. No account.',
+      card: 'sync',
+    },
+  ];
+}
+
+// What did not come across, each with where to go instead.
+function leftOut(): Array<{text: string, card?: string, name?: string}> {
+  return [
+    {
+      text: 'Routes. Arc’s rules for which site opens where stayed in Arc. ' +
+          'Make them again in Sites routed to Spaces.',
+      card: 'routes',
+      name: 'Sites routed to Spaces',
+    },
+    {
+      text: 'Per-Space profiles. Every Space shares one profile here, and ' +
+          'what you were signed in to stays in Arc. Turn on Independent ' +
+          'session to give a Space its own sign-ins.',
+      card: 'spaces',
+      name: 'Independent session',
+    },
+    {
+      text: 'Split views and archived tabs. A split’s tabs come in as tabs.',
+    },
+    {
+      text: 'Boosts, Easels, the Library and Live Folders. Stedding has ' +
+          'nothing like them.',
+    },
+  ];
+}
+
+function el<K extends keyof HTMLElementTagNameMap>(
+    tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
+  const element = document.createElement(tag);
+  if (className) {
+    element.className = className;
+  }
+  if (text !== undefined) {
+    element.textContent = text;
+  }
+  return element;
+}
+
+function openButton(card: string, label: string): HTMLButtonElement {
+  const button = el('button', 'secondary', 'Show');
+  button.setAttribute('aria-label', `Show ${label} in Settings`);
+  button.dataset['card'] = card;
+  button.addEventListener(
+      'click', () => chrome.send('openFromArcPlace', [card]));
+  return button;
+}
+
+function render(_answer: FromArc) {
+  const page = el('div', 'from-arc');
+  page.append(
+      el('h1', '', 'Where everything from Arc went'),
+      el('p', 'lead',
+         'This is where each thing from Arc is in Stedding, and what did ' +
+             'not come across. Settings › Stedding › Sync and import has ' +
+             'this page again.'));
+
+  const list = el('ul', 'places');
+  list.setAttribute('aria-label', 'From Arc to Stedding');
+  for (const place of places()) {
+    const row = el('li', 'place');
+    const now = el('div', 'now');
+    now.append(el('span', 'name', place.now), el('span', 'hint', place.text));
+    row.append(el('span', 'was', place.was), now);
+    if (place.card) {
+      row.append(openButton(place.card, place.now));
+    }
+    list.append(row);
+  }
+  page.append(list);
+
+  page.append(el('h2', '', 'What did not come across'));
+  const missing = el('ul', 'places');
+  missing.setAttribute('aria-label', 'What did not come across');
+  for (const item of leftOut()) {
+    const row = el('li', 'place left-out');
+    row.append(el('span', '', item.text));
+    if (item.card) {
+      row.append(openButton(item.card, item.name!));
+    }
+    missing.append(row);
+  }
+  page.append(missing);
+  document.getElementById('app')!.replaceChildren(page);
+}
+
+sendWithPromise('getFromArc').then(
+    (answer: unknown) => render(answer as FromArc));
