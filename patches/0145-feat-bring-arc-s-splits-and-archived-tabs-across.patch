+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(4u, result.splits);
+  EXPECT_EQ(13u, result.tabs);
+  const auto tab_titled = [&](std::u16string_view title) -> tabs::TabInterface* {
+    for (int i = 0; i < tabs().count(); ++i) {
+      if (tabs().GetTabAtIndex(i)->GetContents()->GetTitle() == title) {
+        return tabs().GetTabAtIndex(i);
+      }
+    }
+    ADD_FAILURE() << title;
+    return nullptr;
+  };
+  const auto expect_split = [&](std::u16string_view left,
+                                std::u16string_view right) {
+    SCOPED_TRACE(left);
+    tabs::TabInterface* const a = tab_titled(left);
+    tabs::TabInterface* const b = tab_titled(right);
+    ASSERT_TRUE(a);
+    ASSERT_TRUE(b);
+    ASSERT_TRUE(a->IsSplit());
+    ASSERT_TRUE(b->IsSplit());
+    EXPECT_EQ(a->GetSplit(), b->GetSplit());
+    EXPECT_TRUE(a->GetContents()->WasDiscarded());
+    EXPECT_TRUE(b->GetContents()->WasDiscarded());
+    EXPECT_EQ(tabs().GetIndexOfTab(a) + 1, tabs().GetIndexOfTab(b))
+        << "left, then right";
+  };
+  expect_split(u"PL", u"PR");
+  expect_split(u"L", u"R");
+  expect_split(u"FL", u"FR");
+  expect_split(u"P1", u"P2");
+
+  // Pinned together, after the pin before them (J4).
+  tabs::TabInterface* const pane = tab_titled(u"PL");
+  ASSERT_TRUE(pane);
