+// The fixture for the rows of ADR 0032, on SpaceWindowTest's helpers.
+class SharedSessionWindowTest : public SpaceWindowTest {
+ protected:
+  SpaceRegistry& registry() {
+    return *SpaceRegistryFactory::GetForProfile(profile());
+  }
+
+  // A session with `first` and `second` in it, `first` having made it.
+  std::string ShareSession(const SpaceId& first, const SpaceId& second) {
+    model().SetSpaceIsolated(first, true);
+    const std::string jar = model().registry()->Find(first)->profile_id;
+    model().SetSpaceSession(second, jar);
+    return jar;
+  }
+
+  content::StoragePartitionConfig ConfigFor(const std::string& jar) {
+    return *StoragePartitionConfigForProfileId(profile(), jar);
+  }
+
+  // The Space's tab, put in `jar` by opening it there.
+  tabs::TabInterface* OpenTabIn(const SpaceId& space) {
+    model().SetActiveSpace(space);
+    return OpenTab();
+  }
+
+  bool WasWiped(const content::StoragePartitionConfig& config,
+                const GURL& url) {
