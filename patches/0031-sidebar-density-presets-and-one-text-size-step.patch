+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/sidebar_density.h"
+
+#include <algorithm>
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/browser_window_theme_observer.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/stedding_ui_metrics.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace stedding {
+
+namespace {
+
+void ApplyFromLocalState(PrefService* local_state) {
+  const int density =
+      std::clamp(local_state->GetInteger(prefs::kSidebarDensity), 0, 2);
+  SetSidebarDensity(static_cast<SidebarDensity>(density));
+  const int text = local_state->GetInteger(prefs::kSidebarTextSize);
+  SetSidebarTextSize(text >= 12 && text <= 15 ? text : 0);
+}
+
+// Every layout in the tree recomputed: the row layouts read the metrics
+// each pass, but keep their last result until told otherwise.
+void InvalidateEveryLayout(views::View* view) {
+  view->InvalidateLayout();
+  for (views::View* child : view->children()) {
+    InvalidateEveryLayout(child);
+  }
+}
+
+// A theme change re-runs every row's OnThemeChanged (the fonts, the rows
+// with a fixed height), then every layout is recomputed (the heights).
+void RelayoutEveryWindow() {
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [](BrowserWindowInterface* window) {
+        if (BrowserWindowThemeObserver* const observer =
+                BrowserWindowThemeObserver::From(window)) {
+          observer->NotifyThemeChanged(BrowserThemeChangeType::kWebAppTheme);
+        }
+        BrowserWindow* const browser_window =
+            BrowserWindow::FromBrowser(window);
+        if (!browser_window) {
+          return true;
+        }
+        if (views::Widget* const widget =
+                views::Widget::GetWidgetForNativeWindow(
+                    browser_window->GetNativeWindow())) {
+          InvalidateEveryLayout(widget->GetRootView());
+        }
+        browser_window->ToolbarSizeChanged(/*is_animating=*/false);
+        return true;
+      });
+}
+
+void OnPrefChanged(PrefService* local_state) {
+  ApplyFromLocalState(local_state);
+  RelayoutEveryWindow();
+}
+
+}  // namespace
+
+void EnsureSidebarDensityInstalled(PrefService* local_state) {
+  static base::NoDestructor<std::unique_ptr<PrefChangeRegistrar>> registrar;
+  if (!local_state || *registrar) {
+    return;
+  }
+  *registrar = std::make_unique<PrefChangeRegistrar>();
+  (*registrar)->Init(local_state);
+  (*registrar)
+      ->Add(prefs::kSidebarDensity,
+            base::BindRepeating(&OnPrefChanged, local_state));
+  (*registrar)
+      ->Add(prefs::kSidebarTextSize,
+            base::BindRepeating(&OnPrefChanged, local_state));
+  ApplyFromLocalState(local_state);
+}
+
+void SetSidebarDensityPref(PrefService* local_state, int density) {
+  if (local_state) {
+    local_state->SetInteger(prefs::kSidebarDensity, std::clamp(density, 0, 2));
+  }
+}
+
+}  // namespace stedding
