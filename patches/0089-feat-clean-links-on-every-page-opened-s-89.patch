 GURL CleanLink(const GURL& url) {
@@ -77,4 +154,86 @@ bool HasTrackingParameters(const GURL& url) {
   return CleanLink(url) != url;
 }
 
+std::optional<GURL> UnwrapRedirectHop(const GURL& url) {
+  std::optional<GURL> target;
+  GURL current = url;
+  for (int depth = 0; depth < kMaxUnwrapDepth; ++depth) {
+    std::optional<GURL> next = UnwrapOnce(current);
+    if (!next) {
+      break;
+    }
+    current = std::move(*next);
+    target = current;
+  }
+  return target;
+}
+
+bool IsKeptSite(const GURL& url, const std::vector<std::string>& kept_sites) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  for (const std::string& site : kept_sites) {
+    if (!site.empty() && url.DomainIs(site)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+GURL CleanLinkForNavigation(const GURL& url,
+                            const std::vector<std::string>& kept_sites) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() ||
+      IsKeptSite(url, kept_sites)) {
+    return url;
+  }
+  // Cl3, Cl8: the redirect page is skipped even when its target's site is
+  // kept; the target then keeps what it was given.
+  const GURL target = UnwrapRedirectHop(url).value_or(url);
+  if (IsKeptSite(target, kept_sites)) {
+    return target;
+  }
+  return CleanLink(target);
+}
+
+GURL WithGoogleSafeSearch(const GURL& url) {
+  GURL safe;
+  safe_search_api::ForceGoogleSafeSearch(url, &safe);
+  return safe.is_empty() ? url : safe;
+}
+
+bool IsCleanLinkHop(const GURL& from, const GURL& to) {
+  if (!from.is_valid() || !to.is_valid() || from == to) {
+    return false;
+  }
+  if (to == CleanLink(from)) {
+    return true;
+  }
+  const std::optional<GURL> target = UnwrapRedirectHop(from);
+  if (!target) {
+    return false;
+  }
+  // Cl14: with the ForceGoogleSafeSearch policy on, a redirect page into a
+  // Google search opens the cleaned target with SafeSearch's parameters.
+  const GURL clean_target = CleanLink(*target);
+  return to == *target || to == clean_target ||
+         to == WithGoogleSafeSearch(clean_target);
+}
+
+std::optional<std::string> KeptSiteFromTyped(std::string_view typed) {
+  const std::string_view trimmed =
+      base::TrimWhitespaceASCII(typed, base::TRIM_ALL);
+  if (trimmed.empty() || trimmed.front() == '/') {
+    return std::nullopt;
+  }
+  const GURL url(trimmed.find("://") == std::string_view::npos
+                     ? base::StrCat({"https://", trimmed})
+                     : std::string(trimmed));
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || !url.has_host() ||
+      url.host().empty()) {
+    return std::nullopt;
+  }
+  // The canonical host is already lower-cased.
+  return std::string(url.host());
+}
+
 }  // namespace stedding
