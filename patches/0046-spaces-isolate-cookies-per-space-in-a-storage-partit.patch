+  EXPECT_FALSE(IsSpaceStoragePartition(PartitionOf(tab))) << PartitionOf(tab);
+}
+
+// sessions S9
+TEST_F(SpaceWindowTest, MovingATabIntoAnIsolatedSpaceRebindsIt) {
+  const SpaceId home = model().active_id();
