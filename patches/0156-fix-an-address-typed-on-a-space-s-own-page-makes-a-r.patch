From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Fri, 6 Nov 2026 04:17:59 -0500
Subject: fix: an address typed on a Space's own page makes a row

The stand-in of a Space with no page becomes an ordinary tab once it leaves its page,
and says so with a tab change, which nothing listened to for the visibility of its
row. The page loaded with no row until the Space was left and shown again.

Why: tabs R66, found on a real build (BACKLOG S-434).
Removable when: the sidebar's Spaces leave the series.
---
 chrome/browser/ui/views/spaces/BUILD.gn       |  1 +
 .../spaces/space_tab_visibility_controller.cc | 11 ++++++++++
 .../spaces/space_tab_visibility_controller.h  |  2 ++
 .../test/stedding/pinned_run_browsertest.cc   | 20 +++++++++++++++++++
 4 files changed, 34 insertions(+)

diff --git a/chrome/browser/ui/views/spaces/BUILD.gn b/chrome/browser/ui/views/spaces/BUILD.gn
index a53b1c87e104b..148275311a33d 100644
--- a/chrome/browser/ui/views/spaces/BUILD.gn
+++ b/chrome/browser/ui/views/spaces/BUILD.gn
@@ -39,6 +39,7 @@ source_set("spaces") {
     "//chrome/browser/ui/toasts",
     "//chrome/browser/ui/toasts/api:toasts",
     # routing D4, sessions S33: the switches for their notices.
+    "//chrome/browser/ui/stedding:empty_space",
     "//chrome/browser/ui/stedding:prefs",
     "//chrome/browser/ui/stedding:tab_parents",
     "//chrome/browser/tab_list",
diff --git a/chrome/browser/ui/views/spaces/space_tab_visibility_controller.cc b/chrome/browser/ui/views/spaces/space_tab_visibility_controller.cc
index 64877a6ee79bc..3557dd4628e30 100644
--- a/chrome/browser/ui/views/spaces/space_tab_visibility_controller.cc
+++ b/chrome/browser/ui/views/spaces/space_tab_visibility_controller.cc
@@ -17,6 +17,7 @@
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/tab_list/tab_removed_reason.h"
 #include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/stedding/empty_space.h"
 #include "chrome/browser/ui/stedding/stedding_prefs.h"
 #include "chrome/browser/ui/stedding/tab_parents.h"
 #include "chrome/browser/ui/stedding_ui_metrics.h"
@@ -214,6 +215,8 @@ void SpaceTabVisibilityController::PinTabsForTesting() {
 }
 
 void SpaceTabVisibilityController::UpdateTabVisibility() {
+  active_is_empty_space_ =
+      stedding::IsEmptySpaceStandIn(tab_strip_model_->GetActiveTab());
   UpdateNestIndents();
   UpdateSubtree(*tab_strip_root_);
   PostDropHiddenRowsFromSelection();
@@ -602,6 +605,14 @@ void SpaceTabVisibilityController::OnTabChangedAt(tabs::TabInterface* tab,
   if (change_type != TabChangeType::kAll) {
     return;
   }
+  // tabs R66: the Space's own page, gone to an address typed on it, is an
+  // ordinary row now, and only this says so: it stayed hidden until the Space
+  // was left and shown again.
+  if (active_is_empty_space_ && tab && tab->IsActivated() &&
+      !stedding::IsEmptySpaceStandIn(tab)) {
+    PostUpdateTabVisibility();
+    return;
+  }
   // folders F44: a pin that went to sleep may leave its folder's - with nothing
   // to do, open or collapsed, under a pointer that has not moved.
   content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
diff --git a/chrome/browser/ui/views/spaces/space_tab_visibility_controller.h b/chrome/browser/ui/views/spaces/space_tab_visibility_controller.h
index d58c6ffc44e21..1e7b2a63f843d 100644
--- a/chrome/browser/ui/views/spaces/space_tab_visibility_controller.h
+++ b/chrome/browser/ui/views/spaces/space_tab_visibility_controller.h
@@ -174,6 +174,8 @@ class SpaceTabVisibilityController : public SpaceModel::Observer,
   const raw_ref<TabStripModel> tab_strip_model_;
   // A pass is posted and has not run yet.
   bool update_posted_ = false;
+  // tabs R66: the tab on screen at the last pass was the Space's own page.
+  bool active_is_empty_space_ = false;
   // A deselecting pass is posted and has not run yet.
   bool drop_posted_ = false;
   const raw_ref<views::View> tab_strip_root_;
diff --git a/chrome/test/stedding/pinned_run_browsertest.cc b/chrome/test/stedding/pinned_run_browsertest.cc
index 12706795a8788..db226dbe6566d 100644
--- a/chrome/test/stedding/pinned_run_browsertest.cc
+++ b/chrome/test/stedding/pinned_run_browsertest.cc
@@ -358,6 +358,26 @@ IN_PROC_BROWSER_TEST_F(PinnedRunTest, AnEmptySpacesPageSaysNothingIsAsleep) {
   EXPECT_EQ(std::string::npos, sub.find("asleep")) << sub;
 }
 
+// tabs R66: an address typed on a Space's own page makes the tab an ordinary
+// row. It stayed unlisted until the Space was left and shown again.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, AnAddressTypedOnTheSpacesPageMakesARow) {
+  const spaces::SpaceId empty = model().AddSpace("Empty", SK_ColorGREEN)->id();
+  ASSERT_TRUE(model().SetActiveSpace(empty));
+  tabs::TabInterface* const page = tabs().GetActiveTab();
+  ASSERT_TRUE(stedding::IsEmptySpaceStandIn(page)) << "a New Tab opened";
+  ASSERT_TRUE(content::WaitForLoadStop(page->GetContents()));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !RowShown(page); }))
+      << "the Space's page has a row";
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Typed</title>")));
+
+  EXPECT_FALSE(stedding::IsEmptySpaceStandIn(page));
+  EXPECT_EQ(page, tabs().GetActiveTab());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return RowShown(page); }))
+      << "the page has no row until the Space is left";
+}
+
