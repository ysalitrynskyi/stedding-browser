+#if BUILDFLAG(IS_MAC)
+// tabs R20 (the owner, 2026-11-09: a Shift-click seemed to select nothing in
+// macOS full screen): the window in macOS's real full screen takes the same
+// range, and a Cmd-click adds to it. The clicks are the event generator's,
+// not a person's (BACKLOG S-455).
+IN_PROC_BROWSER_TEST_F(SidebarSelectionTest,
+                       AShiftClickTakesTheRowsBetweenInFullScreen) {
+  tabs::TabInterface* const a = Open("a.test");
+  tabs::TabInterface* const b = Open("b.test");
+  tabs::TabInterface* const c = Open("c.test");
+  tabs::TabInterface* const d = Open("d.test");
+  ui_test_utils::ToggleFullscreenModeAndWait(browser());
+  ASSERT_TRUE(browser_view()->GetWidget()->IsFullscreen());
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  WaitForRowsToSettle();
+  const auto centre = [&](tabs::TabInterface* tab) {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    TabView* const row = RowFor(Index(tab));
+    CHECK(row);
+    return row->GetBoundsInScreen().CenterPoint();
+  };
+  const auto selected = [&]() {
+    std::string out;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      if (tab_strip_model()->IsTabSelected(i)) {
+        out += base::NumberToString(i) + " ";
+      }
+    }
+    return out + "(active " +
+           base::NumberToString(tab_strip_model()->active_index()) + ")";
+  };
+  ClickAt(centre(a));
+  ClickAt(centre(c), ui::EF_SHIFT_DOWN);
+  EXPECT_TRUE(tab_strip_model()->IsTabSelected(Index(a))) << selected();
+  EXPECT_TRUE(tab_strip_model()->IsTabSelected(Index(b))) << selected();
+  EXPECT_TRUE(tab_strip_model()->IsTabSelected(Index(c))) << selected();
+  EXPECT_FALSE(tab_strip_model()->IsTabSelected(Index(d))) << selected();
+  ClickAt(centre(d), kAddToSelection);
+  EXPECT_TRUE(tab_strip_model()->IsTabSelected(Index(d))) << selected();
+  EXPECT_TRUE(tab_strip_model()->IsTabSelected(Index(a))) << selected();
+  ui_test_utils::ToggleFullscreenModeAndWait(browser());
+}
+#endif
