+// How many tabs `child`, one of a collection's children, holds.
+size_t TabCountOfChild(const Child& child) {
+  if (std::holds_alternative<ScopedTab>(child)) {
+    return 1;
+  }
+  return std::get<std::unique_ptr<TabCollection>>(child)->TabCountRecursive();
+}
+
+// Whether the user sees nothing of `child`: a tab, or a split, folder or
+// group, every tab of which `hidden` hides.
+bool ChildIsHidden(const Child& child,
+                   base::FunctionRef<bool(const TabInterface*)> hidden) {
+  if (const auto* const tab = std::get_if<ScopedTab>(&child)) {
+    return hidden(tab->get());
+  }
+  const std::vector<TabInterface*> tabs =
+      std::get<std::unique_ptr<TabCollection>>(child)->GetTabsRecursive();
+  return !tabs.empty() &&
+         std::ranges::all_of(tabs, [&hidden](const TabInterface* tab) {
+           return hidden(tab);
+         });
+}
