+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_APP_DOCK_MAC_H_
+#define CHROME_BROWSER_UI_STEDDING_APP_DOCK_MAC_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback_forward.h"
+
+class Profile;
+
+namespace stedding {
+
+// On the Mac "Add to Dock…" means it (docs/features/web-apps.md Wa7, Wa18):
+// an app the user makes gets a tile in the Dock, after the last browser,
+// once, and loses it when the app is removed. Chromium's dock::AddIcon
+// writes the Dock's preferences and restarts the Dock once, which shows as a
+// blink. Both run on the web apps' shortcut sequence, which may block: the
+// Dock's preferences are read and written there, and every tile's bundle is
+// opened to tell a browser from another app.
+
+// Stands for the Dock in a test. A browser test never touches the real one:
+// with --test-type and no stand-in installed, nothing below does anything.
+// Its methods run on the shortcut sequence, as the real Dock's calls do.
+class AppDockForTesting {
+ public:
+  virtual ~AppDockForTesting() = default;
+  // Whether the Dock has a tile for `launcher` once the call is done
+  // (dock::AddIcon's kSuccess or kAlreadyPresent).
+  virtual bool AddTile(const base::FilePath& launcher) = 0;
+  virtual void RemoveTile(const base::FilePath& launcher) = 0;
+};
+
+// Installs `dock` for the process; null takes it away. `dock` must outlive
+// the calls it was installed for.
+void SetAppDockForTesting(AppDockForTesting* dock);
+
+// web apps Wa7: once `app_id`'s launcher exists, finds it, adds its tile and
+// records the launcher's path with the app (stedding::kAppDockTilesPref), so
+// removing the app takes that tile alone. An app gets its tile once: an app
+// with a record, or with an add still under way, is left alone, so the
+// manifest updates Chromium finishes the same way as an install put no tile
+// back that the user took out of the Dock. A tile the Dock refused is not
+// recorded and is asked for again at the next update. `done` runs when that
+// is over, tile or not.
+void AddAppToDock(Profile* profile,
+                  const std::string& app_id,
+                  base::OnceClosure done);
+
+// Whether Stedding has added a tile for `app_id` and not taken it away. The
+// user may have taken the tile out of the Dock since: Stedding does not
+// look, and does not add it again.
+bool IsAppInDock(const Profile* profile, const std::string& app_id);
+
+// web apps Wa18: takes away the tile Stedding added for `app_id`, if any, and
+// forgets it. A tile the user added to the Dock by hand is not Stedding's to
+// take, unless it points at the same launcher.
+void RemoveAppFromDock(Profile* profile, const std::string& app_id);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_APP_DOCK_MAC_H_
diff --git a/chrome/browser/ui/stedding/app_dock_mac.mm b/chrome/browser/ui/stedding/app_dock_mac.mm
new file mode 100644
index 0000000000000..85ed6fddce9c9
--- /dev/null
+++ b/chrome/browser/ui/stedding/app_dock_mac.mm
@@ -0,0 +1,159 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/app_dock_mac.h"
+
+#import <Foundation/Foundation.h>
+
+#include <set>
+#include <utility>
+
+#include "base/apple/foundation_util.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/task/sequenced_task_runner.h"
+#import "chrome/browser/mac/dock.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/web_applications/os_integration/mac/web_app_shortcut_mac.h"
+#include "chrome/browser/web_applications/os_integration/web_app_shortcut.h"
+#include "chrome/common/stedding/web_apps.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/common/content_switches.h"
+
+namespace stedding {
+
+namespace {
+
+AppDockForTesting* g_dock_for_testing = nullptr;
+
+// The apps whose tile is being added now, by profile and app, on the UI
+// thread: an update finishing while the install's add is still under way
+// asks for no second tile.
+using PendingAdd = std::pair<base::FilePath, std::string>;
+std::set<PendingAdd>& PendingAdds() {
+  static base::NoDestructor<std::set<PendingAdd>> pending;
+  return *pending;
+}
+
+// No test reaches the developer's own Dock: browser tests run with
+// --test-type, and there only a stand-in answers. Chromium's tests that
+// install apps take this path too, now that a Mac install asks for a tile.
+bool DockReachable() {
+  return g_dock_for_testing ||
+         !base::CommandLine::ForCurrentProcess()->HasSwitch(
+             switches::kTestType);
+}
+
+// On the shortcut sequence: the launcher of `app_id` when the Dock has a
+// tile for it now, else empty. Finding the launcher asks LaunchServices and
+// reads ~/Applications; the add reads every tile's bundle and rewrites the
+// Dock's preferences.
+base::FilePath AddTileOnShortcutSequence(AppDockForTesting* dock,
+                                         const std::string& app_id) {
+  const base::FilePath launcher = web_app::FindAppShimPath(app_id);
+  if (launcher.empty()) {
+    return base::FilePath();
+  }
+  bool in_dock = false;
+  if (dock) {
+    in_dock = dock->AddTile(launcher);
+  } else {
+    const dock::AddIconStatus status =
+        dock::AddIcon(base::apple::FilePathToNSString(launcher),
+                      /*dmg_app_path=*/nil);
+    in_dock = status == dock::AddIconStatus::kSuccess ||
+              status == dock::AddIconStatus::kAlreadyPresent;
+  }
+  return in_dock ? launcher : base::FilePath();
+}
+
+void RemoveTileOnShortcutSequence(AppDockForTesting* dock,
+                                  const base::FilePath& launcher) {
+  if (dock) {
+    dock->RemoveTile(launcher);
+    return;
+  }
+  dock::RemoveIcon(base::apple::FilePathToNSString(launcher));
+}
+
+// Back on the UI thread.
+void RecordTile(base::WeakPtr<Profile> profile,
+                const PendingAdd& pending,
+                base::OnceClosure done,
+                const base::FilePath& launcher) {
+  PendingAdds().erase(pending);
+  // Recorded whether the tile was new or the user had kept one there: the
+  // launcher is the app's, and it goes with the app (Wa18).
+  if (profile && !launcher.empty()) {
+    PrefService* const prefs = profile->GetPrefs();
+    if (prefs && prefs->FindPreference(kAppDockTilesPref)) {
+      ScopedDictPrefUpdate update(*prefs, kAppDockTilesPref);
+      update->Set(pending.second, launcher.value());
+    }
+  }
+  std::move(done).Run();
+}
+
+}  // namespace
+
+void SetAppDockForTesting(AppDockForTesting* dock) {
+  g_dock_for_testing = dock;
+}
+
+void AddAppToDock(Profile* profile,
+                  const std::string& app_id,
+                  base::OnceClosure done) {
+  if (!profile || app_id.empty() || !DockReachable() ||
+      IsAppInDock(profile, app_id)) {
+    std::move(done).Run();
+    return;
+  }
+  PendingAdd pending(profile->GetPath(), app_id);
+  if (!PendingAdds().insert(pending).second) {
+    std::move(done).Run();
+    return;
+  }
+  web_app::internals::GetShortcutIOTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&AddTileOnShortcutSequence,
+                     base::Unretained(g_dock_for_testing), app_id),
+      base::BindOnce(&RecordTile, profile->GetWeakPtr(), std::move(pending),
+                     std::move(done)));
+}
+
+bool IsAppInDock(const Profile* profile, const std::string& app_id) {
+  const PrefService* const prefs = profile ? profile->GetPrefs() : nullptr;
+  return prefs && prefs->FindPreference(kAppDockTilesPref) &&
+         prefs->GetDict(kAppDockTilesPref).FindString(app_id);
+}
+
+void RemoveAppFromDock(Profile* profile, const std::string& app_id) {
+  PrefService* const prefs = profile ? profile->GetPrefs() : nullptr;
+  if (!prefs || !prefs->FindPreference(kAppDockTilesPref)) {
+    return;
+  }
+  const std::string* const recorded =
+      prefs->GetDict(kAppDockTilesPref).FindString(app_id);
+  if (!recorded) {
+    return;
+  }
+  const base::FilePath launcher(*recorded);
+  {
+    ScopedDictPrefUpdate update(*prefs, kAppDockTilesPref);
+    update->Remove(app_id);
+  }
+  if (!DockReachable()) {
+    return;
+  }
+  web_app::internals::GetShortcutIOTaskRunner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&RemoveTileOnShortcutSequence,
+                     base::Unretained(g_dock_for_testing), launcher));
+}
+
+}  // namespace stedding
