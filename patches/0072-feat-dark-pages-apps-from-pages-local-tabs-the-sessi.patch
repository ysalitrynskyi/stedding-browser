+    ASSERT_TRUE(badge) << "no badge on the chip";
+    EXPECT_EQ(Form::kBadge, badge->form());
+    EXPECT_TRUE(badge->IsDrawn());
+    EXPECT_FALSE(badge->bounds().IsEmpty());
+    EXPECT_TRUE(chip->GetLocalBounds().Contains(badge->bounds()))
+        << badge->bounds().ToString() << " in " << chip->size().ToString();
+    EXPECT_EQ(Says(), described);
