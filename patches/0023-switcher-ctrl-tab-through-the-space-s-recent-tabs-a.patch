+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/events/event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class RecentTabsSwitcherViewTest : public BrowserWithTestWindowTest {
+ protected:
+  spaces::SpaceModel& model() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model);
+    return *model;
+  }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  tabs::TabInterface* OpenTab() {
+    AddTab(browser(), GURL("https://example.com/"));
+    return tabs().GetActiveTab();
+  }
+};
+
+// switcher X3: the strip shows the run's tabs with the position highlighted;
+// releasing Ctrl commits the run and Escape cancels it.
+TEST_F(RecentTabsSwitcherViewTest, ReleaseCommitsEscapeCancels) {
+  tabs::TabInterface* const a = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  ASSERT_EQ(c, tabs().GetActiveTab());
+
+  ASSERT_TRUE(model().CycleRecent(1));
+  auto strip = std::make_unique<RecentTabsSwitcherView>(browser());
+  strip->Refresh();
+  EXPECT_EQ(3u, strip->cell_count_for_testing());
+  EXPECT_EQ(1u, strip->highlighted_for_testing());
+  EXPECT_EQ(b, tabs().GetActiveTab());
+  strip->FireHoldTimerForTesting();
+  EXPECT_TRUE(strip->GetVisible());
+
+  // A step while the strip is up moves the highlight.
+  ASSERT_TRUE(model().CycleRecent(1));
+  strip->Refresh();
+  EXPECT_EQ(2u, strip->highlighted_for_testing());
+  EXPECT_EQ(a, tabs().GetActiveTab());
+
+  strip->OnKeyEventForTesting(
+      ui::KeyEvent(ui::EventType::kKeyReleased, ui::VKEY_CONTROL, ui::EF_NONE));
+  EXPECT_TRUE(strip->closing_for_testing());
+  EXPECT_FALSE(model().in_cycle());
+  EXPECT_EQ(a, tabs().GetActiveTab());
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{a, c, b}),
+            model().RecentTabs(model().active_id()));
+
+  // Escape: back to the tab the run started on.
+  ASSERT_TRUE(model().CycleRecent(1));
+  EXPECT_EQ(c, tabs().GetActiveTab());
+  auto second = std::make_unique<RecentTabsSwitcherView>(browser());
+  second->Refresh();
+  second->OnKeyEventForTesting(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_ESCAPE, ui::EF_NONE));
+  EXPECT_TRUE(second->closing_for_testing());
+  EXPECT_FALSE(model().in_cycle());
+  EXPECT_EQ(a, tabs().GetActiveTab());
+
+  // A key without Ctrl means the release was missed: the run commits.
+  ASSERT_TRUE(model().CycleRecent(1));
+  auto third = std::make_unique<RecentTabsSwitcherView>(browser());
+  third->Refresh();
+  third->OnKeyEventForTesting(ui::KeyEvent(ui::EventType::kKeyPressed,
+                                           ui::VKEY_TAB, ui::EF_CONTROL_DOWN));
+  EXPECT_FALSE(third->closing_for_testing()) << "Ctrl-Tab steps, never ends";
+  third->OnKeyEventForTesting(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_A, ui::EF_NONE));
+  EXPECT_TRUE(third->closing_for_testing());
+  EXPECT_FALSE(model().in_cycle());
+}
+
+}  // namespace
+}  // namespace stedding
