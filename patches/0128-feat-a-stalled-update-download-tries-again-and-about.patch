+// updates Up25: a minute without a byte is a stall, however long the request
+// could still run. The stalled try ends and the next one installs.
+TEST_F(WinAppUpdaterTest, ADownloadThatStallsStartsOverAfterAMinute) {
+  const std::string installer = "MZ the beta 19 installer";
+  loader_factory_.AddResponse(
+      kFeedUrl,
+      SignedFeed(key_, "156.2.0.19", key_.Sign(installer), installer.size()));
+  Start();
+  task_environment_.FastForwardBy(base::Seconds(11));
+  task_environment_.RunUntilIdle();
+  ASSERT_EQ(State::kDownloading, updater_->state());
+  ASSERT_EQ(1, loader_factory_.NumPending()) << "the server never answers";
+  ASSERT_EQ(2u, loader_factory_.total_requests());
+
+  // The download began ten seconds after the launch, a second ago.
+  task_environment_.FastForwardBy(base::Seconds(58));
+  EXPECT_EQ(2u, loader_factory_.total_requests());
+  EXPECT_EQ(1, loader_factory_.NumPending()) << "not stalled yet";
+  task_environment_.FastForwardBy(base::Seconds(1) + kUpdateDownloadRetryDelay);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(3u, loader_factory_.total_requests());
+  EXPECT_EQ(State::kDownloading, updater_->state());
+
+  loader_factory_.AddResponse(kInstallerUrl, installer);
+  task_environment_.RunUntilIdle();
