+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_FILE_H_
+#define CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_FILE_H_
+
+#include <cstdint>
+
+#include "base/containers/span.h"
+#include "base/files/file_path.h"
+
+class GURL;
+
+namespace base {
+class Time;
+}  // namespace base
+
+namespace stedding {
+
+// docs/features/screenshot.md C1: "Stedding <host> <YYYY-MM-DD HH.MM.SS>.png"
+// for a capture of `url` taken at `when`, local time. The host is made safe
+// for a file name (an IPv6 literal's colons are not legal on Windows), and a
+// page with no host is "page".
+base::FilePath ScreenshotFileName(const GURL& url, const base::Time& when);
+
+// How many names WriteNewScreenshotFile tries: `name`, then "name 2.png" up
+// to "name 99.png".
+inline constexpr int kScreenshotNameAttempts = 99;
+
+// screenshot C4: writes `png` into `directory`, creating the directory if
+// need be, under `name` or, when a file of that name exists, under the first
+// free "name N.png". A file is only ever created, never replaced, so two
+// captures in the same second cannot write over each other (PLAN.md WIN-2).
+// Returns the path written, or an empty path when nothing was written.
+// Blocking: runs on the screenshot writer's sequence.
+base::FilePath WriteNewScreenshotFile(const base::FilePath& directory,
+                                      const base::FilePath& name,
+                                      base::span<const uint8_t> png);
+
+}  // namespace stedding
