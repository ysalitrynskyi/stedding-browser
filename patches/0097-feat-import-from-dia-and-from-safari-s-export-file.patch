+const ImportedBookmarkEntry* FindPage(
+    const std::vector<ImportedBookmarkEntry>& entries,
+    std::string_view url) {
+  for (const ImportedBookmarkEntry& entry : entries) {
+    if (!entry.is_folder && entry.url == GURL(url)) {
+      return &entry;
+    }
+  }
+  return nullptr;
