+// tabs R6: leaving a Space arms its sleep; coming back cancels it; a
+// removed Space never fires; zero disables.
+TEST(SpaceModelTest, SleepTimerFiresForTheSpaceTheUserLeft) {
+  base::test::TaskEnvironment env(
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME);
+  SpaceModel model;
+  std::vector<SpaceId> slept;
+  model.SetSleepPolicy(
+      base::Minutes(15),
+      base::BindRepeating(
+          [](std::vector<SpaceId>* slept, const SpaceId& id,
+             const std::vector<tabs::TabInterface*>&) { slept->push_back(id); },
+          &slept));
+  const SpaceId home = model.active_id();
+  const SpaceId work = model.AddSpace("Work", kBlue)->id();
+
+  model.SetActiveSpace(work);
+  EXPECT_TRUE(model.HasPendingSleepForTesting(home));
+  env.FastForwardBy(base::Minutes(14));
+  EXPECT_TRUE(slept.empty());
+  env.FastForwardBy(base::Minutes(2));
+  ASSERT_EQ(1u, slept.size());
+  EXPECT_EQ(home, slept[0]);
+  EXPECT_FALSE(model.HasPendingSleepForTesting(home));
+
+  // Coming back in time cancels the Space's own timer; leaving the other
+  // one arms that one instead.
+  model.SetActiveSpace(home);
+  EXPECT_TRUE(model.HasPendingSleepForTesting(work));
+  model.SetActiveSpace(work);
+  EXPECT_FALSE(model.HasPendingSleepForTesting(work));
+  EXPECT_TRUE(model.HasPendingSleepForTesting(home));
+  env.FastForwardBy(base::Minutes(30));
+  ASSERT_EQ(2u, slept.size());
+  EXPECT_EQ(home, slept[1]);
+
+  // Zero disables and drops what was pending.
+  model.SetActiveSpace(home);
+  EXPECT_TRUE(model.HasPendingSleepForTesting(work));
+  model.SetSleepPolicy(base::TimeDelta(), base::DoNothing());
+  EXPECT_FALSE(model.HasPendingSleepForTesting(work));
+  env.FastForwardBy(base::Minutes(30));
+  EXPECT_EQ(2u, slept.size());
+}
+
+// spaces B27: Move Left / Move Right reorder the switcher, the ends clamp,
+// the order survives a session round trip, and Ctrl-N follows it.
+TEST(SpaceModelTest, MoveSpaceReordersAndPersists) {
+  SpaceModel written;
+  const SpaceId first = written.active_id();
+  const SpaceId second = written.AddSpace("Second", kBlue)->id();
+  const SpaceId third = written.AddSpace("Third", kRed)->id();
+
+  EXPECT_TRUE(written.MoveSpace(third, -2));
+  EXPECT_EQ(third, written.spaces()[0]->id());
+  EXPECT_EQ(first, written.spaces()[1]->id());
+  EXPECT_EQ(second, written.spaces()[2]->id());
+  // The ends clamp: already first, already last, no step.
+  EXPECT_FALSE(written.MoveSpace(third, -1));
+  EXPECT_FALSE(written.MoveSpace(second, 5));
+  EXPECT_FALSE(written.MoveSpace(first, 0));
+  // A long step lands on the end.
+  EXPECT_TRUE(written.MoveSpace(first, 5));
+  EXPECT_EQ(first, written.spaces()[2]->id());
+  EXPECT_EQ(second, written.spaces()[1]->id());
+
+  SpaceModel read;
+  read.RestoreFrom(written.Serialize());
+  ASSERT_EQ(3u, read.size());
+  EXPECT_EQ(third, read.spaces()[0]->id());
+  EXPECT_EQ(second, read.spaces()[1]->id());
+  EXPECT_EQ(first, read.spaces()[2]->id());
+  read.SetActiveSpaceByIndex(0);
+  EXPECT_EQ(third, read.active_id());
+}
