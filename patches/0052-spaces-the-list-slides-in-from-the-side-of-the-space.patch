+void VerticalTabStripRegionView::SlideInSpaceList(const spaces::SpaceId& from,
+                                                  const spaces::SpaceId& to) {
+  // The Space's own rows -- its pins, tabs and folders -- live in the unpinned
+  // list; the essentials above them are in every Space and stay still.
+  views::ScrollView* const list =
+      tab_strip_view() ? tab_strip_view()->unpinned_tabs_scroll_view() : nullptr;
+  spaces::SpaceModel* const model =
+      spaces::SpaceModel::From(browser_view()->browser());
+  if (!list || !model ||
+      !stedding::ShouldAnimate(browser_view()->GetProfile()->GetPrefs())) {
+    return;
+  }
+  int from_index = -1;
+  int to_index = -1;
+  const auto& all = model->spaces();
+  for (size_t i = 0; i < all.size(); ++i) {
+    if (all[i]->id() == from) {
+      from_index = static_cast<int>(i);
+    }
+    if (all[i]->id() == to) {
+      to_index = static_cast<int>(i);
+    }
+  }
+  const int direction =
+      stedding::SpaceSlideDirection(from_index, to_index, base::i18n::IsRTL());
+  if (direction == 0) {
+    return;
+  }
+  if (!list->layer()) {
+    list->SetPaintToLayer();
+    list->layer()->SetFillsBoundsOpaquely(false);
+  }
+  ui::Layer* const layer = list->layer();
+  layer->GetAnimator()->StopAnimating();
+  gfx::Transform start;
+  start.Translate(direction * stedding::kSpaceSlideOffsetDip, 0);
+  layer->SetTransform(start);
+  layer->SetOpacity(0.0f);
+  ui::ScopedLayerAnimationSettings settings(layer->GetAnimator());
+  settings.SetTransitionDuration(
+      base::Milliseconds(stedding::kSpaceSlideDurationMs));
+  settings.SetTweenType(gfx::Tween::EASE_OUT);
+  layer->SetTransform(gfx::Transform());
+  layer->SetOpacity(1.0f);
+}
+
 TabDragTarget* VerticalTabStripRegionView::GetTabDragTargetInsideTabStrip(
     const gfx::Point& point_in_screen) {
