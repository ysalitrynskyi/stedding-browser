+        InRoot(multi->contents_container_views()[1]->contents_view());
+    EXPECT_EQ(page.y(), start.y()) << "a band between the row and the page";
+    EXPECT_EQ(page.y(), end.y()) << "a band between the row and the page";
+    EXPECT_EQ(page.x(), start.x());
