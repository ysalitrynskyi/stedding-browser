+// sidebar Y11 (BACKLOG S-219): a click on the open sidebar's toggle, the
+// pointer left on it, leaves the rail closed once the pause is over. The
+// strip narrows under the still pointer and the toggle moves away from under
+// it before the strip's edge passes it; the collapse ended, and read the
+// hover, before the layout that gave the strip the rail's width, so the
+// pointer, past the rail by then, read as on the strip. It did not move, no
+// exit came, and when the pause ran out the sidebar slid out over the page
+// (Mac, driven runs of 2026-10-16). Here the collapse steps by the test's
+// clock, laid out after each step as a frame is, and ends between two
+// frames. The Mac's alone: there the toggle sits right of the traffic
+// lights, past the rail's edge; elsewhere it sits inside the rail.
+IN_PROC_BROWSER_TEST_F(SidebarRailPointerTest,
+                       AClickOnTheToggleLeavesTheRailClosed) {
+  AppendTab();
+  constexpr int kPauseMs = 100;
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarHoverDelayMs, kPauseMs);
+  controller()->SetExpandOnHoverEnabled(true);
+  views::Widget* const window = browser_view()->GetWidget();
+  views::test::RunScheduledLayout(window);
+  ASSERT_FALSE(controller()->IsCollapsed());
+  views::View* const toggle =
+      region()->top_button_container_for_testing()->GetCollapseButton();
+  ASSERT_TRUE(toggle);
+  ASSERT_TRUE(toggle->IsDrawn());
+  const gfx::Point on_toggle = toggle->GetBoundsInScreen().CenterPoint();
+
+  auto container = base::MakeRefCounted<gfx::AnimationContainer>();
+  BrowserAnimationController::From(browser())->SetAnimationContainerForTesting(
+      TabStripAnimations::kVerticalTabStrip, container.get());
+  gfx::AnimationContainerTestApi clock(container.get());
+
+  {
+    SCOPED_TRACE("the toggle, clicked");
+    ui::test::EventGenerator pointer(views::GetRootWindow(window),
+                                     window->GetNativeWindow());
+    pointer.MoveMouseTo(on_toggle);
+    pointer.ClickLeftButton();
+    ASSERT_TRUE(Animating()) << "the toggle started no collapse";
+
+    // Frames, until the toggle has left the pointer and the strip has not.
+    bool toggle_gone = false;
+    for (int frame = 0; frame < 200 && Animating() && !toggle_gone; ++frame) {
+      clock.IncrementTime(base::Milliseconds(4));
+      views::test::RunScheduledLayout(window);
+      toggle_gone = !toggle->GetBoundsInScreen().Contains(on_toggle) &&
+                    region()->GetBoundsInScreen().Contains(on_toggle);
+    }
+    ASSERT_TRUE(toggle_gone)
+        << "the toggle stayed under the pointer until the strip passed it";
+
+    // The collapse ends before the next frame's layout.
+    clock.IncrementTime(base::Seconds(1));
+    ASSERT_FALSE(Animating());
+    ASSERT_TRUE(controller()->IsCollapsed());
+    views::test::RunScheduledLayout(window);
+    ASSERT_FALSE(region()->GetBoundsInScreen().Contains(on_toggle))
+        << "the rail reaches the pointer; resting there it should open";
+
+    // Four times the pause, the pointer still where it was.
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, run_loop.QuitClosure(), base::Milliseconds(kPauseMs * 4));
+    run_loop.Run();
+    EXPECT_FALSE(region()->is_expanded_on_hover())
+        << "the sidebar slid out over the page, the pointer off the rail";
+  }
+  // A hover that comes onto the rail later still opens it: the forms tests
+  // cover that (SidebarFormsTest); a pointer moved here in one jump reads as
+  // passing through (upstream's velocity heuristic) and opens nothing.
+}
+#endif  // BUILDFLAG(IS_MAC)
