+  content::CrashTab(page);
+  ASSERT_FALSE(page->GetRenderWidgetHostView())
+      << "the crashed tab kept its page view";
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kRegion);
+  ASSERT_NO_FATAL_FAILURE(WaitForToast(
+      browser(), ToastId::kSteddingCaptureFailed,
+      l10n_util::GetStringUTF16(IDS_STEDDING_CAPTURE_FAILED_TOAST_BODY)));
+  FlushCaptures();
+}
