+bool MigrateLegacyUserDataDirectory(const base::FilePath& legacy,
+                                    const base::FilePath& target) {
+  if (base::PathExists(target) || !base::DirectoryExists(legacy)) {
+    return false;
+  }
+  // Only a folder Stedding has run in. Every profile names the product that
+  // created it in its GCM category ("com.stedding.macosx"; a Chromium writes
+  // "org.chromium.macosx" and the value is never rewritten), and a profile
+  // whose user changed a Stedding setting also has a "stedding" dictionary.
+  // The dictionary alone missed a real profile from an early beta, which had
+  // no Stedding setting changed.
+  std::string prefs;
+  if (!base::ReadFileToStringWithMaxSize(
+          legacy.Append("Default").Append("Preferences"), &prefs,
+          64 * 1024 * 1024)) {
+    return false;
+  }
+  const std::optional<base::DictValue> dict =
+      base::JSONReader::ReadDict(prefs, base::JSON_PARSE_RFC);
+  if (!dict) {
+    return false;
+  }
+  const std::string* const category =
+      dict->FindStringByDottedPath("gcm.product_category_for_subtypes");
+  const bool created_by_stedding =
+      category && category->starts_with("com.stedding.");
+  if (!created_by_stedding && !dict->FindDict("stedding")) {
+    return false;
+  }
+  // A clone on APFS costs no space and leaves Chromium's folder as it was, so
+  // a Chromium that shared it keeps working. Elsewhere a copy, made beside the
+  // target and moved in whole, so a failure leaves no half profile behind.
+  if (clonefile(legacy.value().c_str(), target.value().c_str(), 0) != 0) {
+    const base::FilePath staging = target.AddExtension("migrating");
+    base::DeletePathRecursively(staging);
+    if (!base::CopyDirectory(legacy, staging, /*recursive=*/true) ||
+        !base::Move(staging, target)) {
+      base::DeletePathRecursively(staging);
+      return false;
+    }
+  }
+  // The copied process-singleton links name the old folder's last process.
+  for (const char* name : {"SingletonLock", "SingletonSocket",
+                           "SingletonCookie"}) {
+    base::DeleteFile(target.Append(name));
+  }
+  return true;
+}
+
+void MigrateDefaultUserDataDirectoryIfNeeded() {
+  base::FilePath target;
+  base::FilePath legacy;
+  if (!GetDefaultUserDataDirectory(&target) ||
+      !GetDefaultUserDataDirectoryForProduct("Chromium", &legacy) ||
+      legacy == target) {
+    return;
+  }
+  MigrateLegacyUserDataDirectory(legacy, target);
+}
+
 bool GetUserDocumentsDirectory(base::FilePath* result) {
   return base::apple::GetUserDirectory(NSDocumentDirectory, result);
 }
