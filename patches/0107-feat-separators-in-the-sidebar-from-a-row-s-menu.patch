+// tabs R61 (BACKLOG S-350): while a drag holds the page on screen, the
+// drag's selection of the row it carries does not take that page out of its
+// own full screen, and a drop that leaves the page on screen leaves it full
+// screen. The selection ended the page's full screen (and a pointer or
+// keyboard lock with it) under a page that never left the screen.
+IN_PROC_BROWSER_TEST_F(TabDropTest, AHoldKeepsThePagesFullScreen) {
+  tabs::TabInterface* const dragged = Open("dragged-full.test");
+  tabs::TabInterface* const shown = Open("shown-full.test");
+  ASSERT_EQ(shown, tab_strip_model()->GetActiveTab());
+  FullscreenController* const fullscreen =
+      ExclusiveAccessManager::From(browser())->fullscreen_controller();
+  ASSERT_TRUE(content::ExecJs(shown->GetContents(),
+                              "document.documentElement.requestFullscreen()"));
+  ui_test_utils::FullscreenWaiter(browser(), {.tab_fullscreen = true}).Wait();
+  ASSERT_TRUE(fullscreen->IsTabFullscreen());
+
+  // What a drag from the other row does (TabView, BACKLOG S-285): the hold,
+  // then the drag's selection of the row, then the drop.
+  browser_view()->HoldPageForSteddingDrag();
+  tab_strip_model()->ActivateTabAt(Index(dragged));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(fullscreen->IsTabFullscreen())
+      << "the drag's selection ended the full screen of the page on screen";
+  browser_view()->ReleaseSteddingPageHold();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(shown, tab_strip_model()->GetActiveTab());
+  EXPECT_TRUE(fullscreen->IsTabFullscreen())
+      << "a drop that left the page on screen ended its full screen";
+  EXPECT_EQ(shown->GetContents(), fullscreen->exclusive_access_tab());
+
+  ASSERT_TRUE(
+      content::ExecJs(shown->GetContents(), "document.exitFullscreen()"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !fullscreen->IsTabFullscreen(); }));
+}
+
+// sidebar Y45: a row with a separator above it keeps the band while it is
+// dragged, so the rows after it hold their places, and its line is not drawn
+// over the row the dragged one passes; the drop leaves the line on the row.
+IN_PROC_BROWSER_TEST_F(TabDropTest, ARowsSeparatorStaysPutWhileItIsDragged) {
+  Open("two.test");
+  tabs::TabInterface* const three = Open("three.test");
+  tabs::TabInterface* const four = Open("four.test");
+  stedding::SetSeparatorAbove(browser(), three, true);
+  const gfx::Point four_before = RowCentre(four);
+  const gfx::Point from = RowCentre(three);
+  // Sideways along the row: the drag starts and the order stays.
+  const gfx::Point to(from.x() + 40, from.y());
+  PointerPressAndMove(from, to);
+  EXPECT_EQ(four_before.y(), RowCentre(four).y())
+      << "the row after the dragged one moved up into its band";
+  Release(to);
+  EXPECT_TRUE(stedding::HasSeparatorAbove(three->GetContents()));
+  EXPECT_EQ(four_before.y(), RowCentre(four).y());
+}
