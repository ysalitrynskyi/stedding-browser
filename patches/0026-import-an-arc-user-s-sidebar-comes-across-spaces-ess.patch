+// A synthetic sidebar in Arc's shape (docs/features/import.md, Notes): two
+// Spaces, a pinned run with a folder, an unpinned tab, one essential, and a
+// per-Space profile binding on the second Space.
+constexpr char kSidebar[] = R"json({
+  "version": 1,
+  "sidebar": {"containers": [
+    {"global": {}},
+    {
+      "spaces": [
+        "space-work", {
+          "id": "space-work", "title": "Work",
+          "profile": {"default": {}},
+          "containerIDs": ["unpinned", "cont-work-unpinned", "pinned", "cont-work-pinned"],
+          "customInfo": {
+            "iconType": {"emoji_v2": "💼"},
+            "windowTheme": {"primaryColorPalette": {"midTone": {
+              "red": 0.47, "green": 0.36, "blue": 0.55, "alpha": 1}}}
+          }
+        },
+        "space-play", {
+          "id": "space-play", "title": "Play",
+          "profile": {"custom": {"_0": {"name": "Personal"}}},
+          "containerIDs": ["pinned", "cont-play-pinned", "unpinned", "cont-play-unpinned"],
+          "customInfo": {"iconType": {"emoji_v2": "🎮"}}
+        }
+      ],
+      "items": [
+        "cont-work-pinned", {"id": "cont-work-pinned", "parentID": null,
+          "childrenIds": ["tab-a", "list-docs"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-work-unpinned", {"id": "cont-work-unpinned", "parentID": null,
+          "childrenIds": ["tab-d"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-play-pinned", {"id": "cont-play-pinned", "parentID": null,
+          "childrenIds": [], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-play-unpinned", {"id": "cont-play-unpinned", "parentID": null,
+          "childrenIds": ["tab-f"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "cont-top", {"id": "cont-top", "parentID": null,
+          "childrenIds": ["tab-e"], "title": "",
+          "data": {"itemContainer": {"containerType": {"topApps": {}}}}},
+        "tab-a", {"id": "tab-a", "parentID": "cont-work-pinned", "childrenIds": [],
+          "title": "", "data": {"tab": {"savedURL": "https://a.example/", "savedTitle": "A"}}},
