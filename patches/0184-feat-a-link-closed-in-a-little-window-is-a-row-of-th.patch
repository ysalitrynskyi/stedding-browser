+// archive A17 (BACKLOG S-159): the link a little window closed by hand held
+// is a row of the archive that says where it came from, as Arc keeps Little
+// Arc's links in its archive.
+IN_PROC_BROWSER_TEST_F(LittleWindowRestoreTest,
+                       AClosedLittleWindowsLinkIsInTheArchive) {
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+  BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+      browser()->GetProfile(), url, browser(), /*untrusted_launch=*/false);
+  ASSERT_TRUE(little);
+  ASSERT_TRUE(content::WaitForLoadStop(
+      little->GetTabStripModel()->GetActiveWebContents()));
+  ASSERT_TRUE(chrome::ExecuteCommand(little, IDC_STEDDING_LITTLE_CLOSE));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return GetAllBrowserWindowInterfaces().size() == 1u; }));
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  const std::vector<stedding::ArchivedTab> rows = stedding::ListArchivedTabs(
+      service->entries(), base::Time::Now(), base::Days(30));
+  const auto row = std::ranges::find_if(
+      rows, [&](const stedding::ArchivedTab& tab) { return tab.url == url; });
+  ASSERT_NE(rows.end(), row) << "the little window's link is not archived";
+  EXPECT_EQ("little", row->closed_with);
+
+  // The page says where the row came from, and its filter finds it.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://stedding-archive"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  const std::string meta =
+      "[...document.querySelectorAll('.row .meta')].map(m => m.textContent)"
+      ".join('|')";
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, meta)
+               .ExtractString()
+               .find("from a little window") != std::string::npos;
+  })) << content::EvalJs(page, meta).ExtractString();
+  EXPECT_EQ(std::string::npos,
+            content::EvalJs(page, meta).ExtractString().find("of 1 tabs"));
+  ASSERT_TRUE(
+      content::ExecJs(page,
+                      "const menu = document.querySelector('select');"
+                      "const little = [...menu.options].find("
+                      "    option => option.textContent === 'Little windows');"
+                      "menu.value = little.value;"
+                      "menu.dispatchEvent(new Event('change'));"));
+  EXPECT_EQ(1,
+            content::EvalJs(page, "document.querySelectorAll('.row').length"))
+      << "the filter shows the little window's row alone";
+}
+
 // little E13: Cmd-W is the way most people close one. The strip was empty by
 // the time the window closed, so nothing recorded it, and Shift-Cmd-T brought
 // back whatever closed before.
