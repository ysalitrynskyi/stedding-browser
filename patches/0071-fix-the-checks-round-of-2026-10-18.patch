+// import I13 (BACKLOG S-129): a bookmarks file chosen on the import step
+// comes in as bookmarks, its folder a bookmark folder, and the window behind
+// the flow gains nothing: no tab, no pin, no folder, and the bookmark bar and
+// the star stay (import I14). The import once made pins and folders of what
+// it brought; that is now the command bar's Turn Bookmarks into Pinned Tabs
+// alone (PLAN.md decision 4).
+IN_PROC_BROWSER_TEST_F(WelcomeFlowTest, ABookmarksFileComesInAsBookmarks) {
+  // Declared before `dir`, so it is alive when `dir` deletes its folder as
+  // the test ends: that blocks, and DCHECKs where blocking is not allowed.
+  std::optional<base::ScopedAllowBlockingForTesting> allow_blocking;
+  base::ScopedTempDir dir;
+  allow_blocking.emplace();
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath file = dir.GetPath().AppendASCII("bookmarks.html");
+  ASSERT_TRUE(base::WriteFile(file, kBookmarksFile));
+  allow_blocking.reset();
+
+  Profile* const profile = browser()->GetProfile();
+  bookmarks::BookmarkModel* const bookmarks =
+      BookmarkModelFactory::GetForBrowserContext(profile);
+  ASSERT_TRUE(bookmarks);
+  bookmarks::test::WaitForBookmarkModelToLoad(bookmarks);
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  spaces::SpaceModel* const spaces = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(spaces);
+  const int tabs_before = strip->count();
+
+  ui::FakeSelectFileDialog::Factory* const dialogs =
+      ui::FakeSelectFileDialog::RegisterFactory();
+  dialogs->SetOpenCallback(base::DoNothing());
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, "steddingWelcomeTest.state.sources.length")
+               .ExtractInt() > 0;
+  })) << "the importer's list never came";
+  ASSERT_EQ("", GoTo(page, "[data-focus^='source-']"));
+  ASSERT_TRUE(content::ExecJs(page, R"(
+      const tiles = document.querySelectorAll('main [data-focus^="source-"]');
+      tiles[tiles.length - 1].click();
+      document.querySelector('[data-focus="import"]').click();)"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return dialogs->GetLastDialog() != nullptr; }))
+      << "no file dialog opened";
+  ASSERT_TRUE(dialogs->GetLastDialog()->CallFileSelected(file, "html"));
+
+  std::string status;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    status = content::EvalJs(page, "steddingWelcomeTest.state.importStatus")
+                 .ExtractString();
+    return status == "succeeded" || status == "failed";
+  })) << "the import never ended";
+  ASSERT_EQ("succeeded", status);
+
+  {
+    SCOPED_TRACE("the bookmarks are bookmarks");
+    EXPECT_TRUE(bookmarks->IsBookmarked(GURL("https://example.com/")));
+    const bookmarks::BookmarkNode* const article =
+        bookmarks->GetMostRecentlyAddedUserNodeForURL(
+            GURL("https://example.org/article"));
+    ASSERT_TRUE(article);
+    EXPECT_EQ(u"Reading", article->parent()->GetTitle())
+        << "the file's folder is a bookmark folder";
+  }
+  {
+    SCOPED_TRACE("the sidebar gains nothing");
+    EXPECT_EQ(tabs_before, strip->count()) << "no tab came in";
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      EXPECT_FALSE(tab->IsPinned()) << "no essential";
+      EXPECT_FALSE(spaces->IsSpacePinned(tab)) << "no pin";
+      const tabs::TabCollection* const parent = tab->GetParentCollection();
+      EXPECT_FALSE(parent &&
+                   parent->type() == tabs::TabCollection::Type::FOLDER)
+          << "no folder";
+    }
+    EXPECT_FALSE(profile->GetPrefs()->GetBoolean(
+        stedding::prefs::kBookmarksConverted))
+        << "the bookmark bar and the star stay";
