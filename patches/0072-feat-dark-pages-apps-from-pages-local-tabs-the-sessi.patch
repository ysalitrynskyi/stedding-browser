+// static
+SkColor PageThemeColorController::RowColorForThemeColor(SkColor theme_color,
+                                                        bool page_darkened) {
+  // Dk8, toolbar T3: the rule an app window's title bar follows too (web
+  // apps Wa9), kept in one place so the two cannot drift apart.
+  return ThemeColorUnderDarkPages(theme_color, page_darkened);
