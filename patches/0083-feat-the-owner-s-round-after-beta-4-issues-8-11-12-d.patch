+// out under the Clear line, the folder leaves the run, its tabs unpinned,
+// and the folder it left stays in the run.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, AFolderTakesThePinOfTheFolderItGoesInto) {
+  CloseDownToOne();
+  stedding::test::KeepAboveOtherWindows(widget());
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  AppendTab();
+  AppendTab();
+  AppendTab();
+  AppendTab();
+  tabs::TabInterface* const a = tab_strip_model()->GetTabAtIndex(1);
+  tabs::TabInterface* const b = tab_strip_model()->GetTabAtIndex(2);
+  tabs::TabInterface* const c = tab_strip_model()->GetTabAtIndex(3);
+  tabs::TabInterface* const d = tab_strip_model()->GetTabAtIndex(4);
+  // [Pinned[a]] over the line, then [start, Moving[b, c], d] under it.
+  tabs::FolderTabCollection* const pinned =
+      tab_strip_model()->AddToNewFolder({1});
+  ASSERT_TRUE(pinned);
+  tabs::FolderTabCollection* const moving =
+      tab_strip_model()->AddToNewFolder({2, 3});
+  ASSERT_TRUE(moving);
+  model->SetFolderSpacePinned(pinned, true);
+  ASSERT_TRUE(model->IsFolderSpacePinned(pinned));
+  ASSERT_FALSE(model->IsSpacePinned(b));
+  tab_strip_model()->ActivateTabAt(IndexOf(d));
+
+  {
+    SCOPED_TRACE("into the pinned folder");
+    const gfx::Point onto = HeaderCentre(pinned);
+    PressAndDragHeader(moving, onto);
+    EXPECT_TRUE(IsLit(pinned));
+    ReleaseAt(onto);
+    EXPECT_EQ(pinned, moving->GetParentCollection());
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return model->IsSpacePinned(b) && model->IsSpacePinned(c);
+    })) << "the folder's tabs did not become pins";
+    EXPECT_TRUE(model->IsSpacePinned(a));
+    EXPECT_TRUE(model->IsFolderSpacePinned(pinned))
+        << "the folder left the run";
+    EXPECT_FALSE(model->IsSpacePinned(d));
+    EXPECT_EQ(moving, b->GetParentCollection()) << "the folder lost a tab";
+  }
+
+  {
+    SCOPED_TRACE("out under the line");
+    const gfx::Point to = JustInsideTheTopOf(d);
+    PressAndDragHeader(moving, to);
+    ReleaseAt(to);
+    EXPECT_EQ(pinned->GetParentCollection(), moving->GetParentCollection())
+        << "it stayed in the pinned folder";
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !model->IsSpacePinned(b) && !model->IsSpacePinned(c);
+    })) << "the folder's tabs stayed pins";
+    EXPECT_TRUE(model->IsFolderSpacePinned(pinned))
+        << "the folder it left left the run";
+    EXPECT_EQ(moving, b->GetParentCollection());
+    EXPECT_EQ(moving, c->GetParentCollection());
+    EXPECT_LT(IndexOf(c), IndexOf(d)) << "not before d";
+  }
+}
+
+
+// tabs, the owner's beta 4 round (2026-10-22): a scroll of the tab list
+// moves the hover to the row it brings under the resting pointer. The window
+// hears of the pointer only when it moves, so the row the wheel carried away
+// kept its fill and its close button, and the row under the pointer had
+// none.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, AScrollMovesTheHoverToTheRowUnderIt) {
+  CloseDownToOne();
+  for (int i = 0; i < 30; ++i) {
+    chrome::AddTabAt(browser(), GURL("about:blank"), -1, false);
+  }
+  TabStripView* const strip = stedding::test::FindView<TabStripView>(
+      BrowserView::GetBrowserViewForBrowser(browser())
+          ->vertical_tab_strip_region_view_for_testing());
+  ASSERT_TRUE(strip);
+  views::ScrollView* const list = strip->unpinned_tabs_scroll_view();
+  ASSERT_TRUE(list);
+  tabs::TabInterface* const resting_on = tab_strip_model()->GetTabAtIndex(5);
+  TabView* const row = DrawnRow(resting_on);
+  ASSERT_TRUE(row);
+  ASSERT_GT(list->contents()->height(), list->height()) << "no list to scroll";
+  const gfx::Point at = row->GetBoundsInScreen().CenterPoint();
+  PointerRestingAt pointer(at);
+  {
+    views::View* const root = widget()->GetRootView();
+    gfx::Point in_root = at;
+    views::View::ConvertPointFromScreen(root, &in_root);
+    root->OnMouseMoved(ui::MouseEvent(ui::EventType::kMouseMoved, in_root,
+                                      in_root, base::TimeTicks::Now(),
+                                      ui::EF_NONE, ui::EF_NONE));
+  }
+  ASSERT_TRUE(row->IsHoverAnimationActive()) << "the row never saw the pointer";
+
+  // Three rows' worth, as a turn of the wheel scrolls.
+  list->ScrollToOffset(gfx::PointF(0, 3 * row->height()));
+  views::test::RunScheduledLayout(widget());
+  EXPECT_TRUE(
+      base::test::RunUntil([&]() { return !row->IsHoverAnimationActive(); }))
+      << "the row the scroll carried away kept its hover";
+  views::test::RunScheduledLayout(widget());
+  EXPECT_FALSE(row->close_button_for_testing()->GetVisible())
+      << "the row carried away shows its close button";
+  TabView* under = nullptr;
+  for (int i = 0; i < tab_strip_model()->count() && !under; ++i) {
+    TabView* const each = stedding::test::FindDrawnRow(
+        widget()->GetRootView(), tab_strip_model()->GetTabAtIndex(i));
+    if (each && each->GetBoundsInScreen().Contains(at)) {
+      under = each;
+    }
+  }
+  ASSERT_TRUE(under) << "no row under the pointer after the scroll";
+  ASSERT_NE(row, under);
+  EXPECT_TRUE(
+      base::test::RunUntil([&]() { return under->IsHoverAnimationActive(); }))
+      << "the row the scroll brought under the pointer has no hover";
+}
+
+// spaces B33 (2026-10-22): a tab group made while animations are off -- a
+// remote desktop session, reduced motion -- comes up with its header and its
+// rows. With no time to run, the group's first animation ends while its view
+// installs its layout manager, and that end ran the group's row-visibility
+// callback before the callback was constructed: a group header dragged out
+// of the window and back crashed the checks build on Windows.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       AGroupMadeWithAnimationsOffShowsItsRows) {
+  gfx::ScopedAnimationDurationScaleMode no_time(
+      gfx::ScopedAnimationDurationScaleMode::ZERO_DURATION);
+  CloseDownToOne();
+  for (int i = 0; i < 3; ++i) {
+    chrome::AddTabAt(browser(), GURL("about:blank"), -1, false);
+  }
+  for (int round = 0; round < 3; ++round) {
+    SCOPED_TRACE(base::StrCat({"round ", base::NumberToString(round)}));
+    const tab_groups::TabGroupId group =
+        tab_strip_model()->AddToNewGroup({1, 2});
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_TRUE(FindDrawnGroupHeader(widget()->GetRootView()))
+        << "no header for the group";
+    EXPECT_TRUE(DrawnRow(tab_strip_model()->GetTabAtIndex(1)));
+    EXPECT_TRUE(DrawnRow(tab_strip_model()->GetTabAtIndex(2)));
+    tab_strip_model()->RemoveFromGroup({1, 2});
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_FALSE(tab_strip_model()->group_model()->ContainsTabGroup(group));
+  }
+}
