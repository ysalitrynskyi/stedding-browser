+  const bool dark = key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  // A private window is graphite, flat, with no Space tint (private V1).
+  const bool is_private = IsPrivateColorKey(key);
+  SkColor window = is_private ? kSteddingPrivateWindow
+                   : dark     ? kSteddingDarkWindow
+                              : kSteddingLightWindow;
   // The active Space's colour (the widget's user colour override, set by
   // SpaceTabVisibilityController) tints the ground the sidebar sits on, as
   // Arc does, not the pages.
