+// P05-1a, import I32: while "Move everything from Dia" runs for the profile
+// chosen, Dia's profile menu cannot be changed, so the button keeps saying
+// "Moving…" and the result shown is that profile's. A change of the menu had
+// armed the button again mid-import, and the import's result was then shown
+// under the other profile, which had not been moved. Once the import ends
+// the menu works again, and the other profile can be moved in its turn.
+IN_PROC_BROWSER_TEST_F(DiaProfilesB05Test,
+                       TheProfileMenuWaitsWhileItsImportRuns) {
+  content::WebContents* const page = OpenWelcomeB05(*browser(), "import");
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(
+               page, "!!document.querySelector('[data-focus=\"dia-profile\"]')")
+        .ExtractBool();
+  })) << "Dia's block has no profile menu";
+  ASSERT_EQ("Work,Home", content::EvalJs(page, R"(
+      steddingWelcomeTest.state.chromium.find(b => b.key === 'dia')
+          .profiles.map(p => p.name).join(','))"));
+  // The click and the change of the menu run in one task, so the import
+  // cannot end between them.
+  EXPECT_EQ("menu disabled, shows 0, button disabled, moving, profile 0",
+            content::EvalJs(page, R"(
+      (() => {
+        document.querySelector('[data-focus="dia-move"]').click();
+        const menu = document.querySelector('[data-focus="dia-profile"]');
+        const locked = menu.disabled;
+        menu.value = '1';
+        menu.dispatchEvent(new Event('change'));
+        const shown = document.querySelector('[data-focus="dia-profile"]');
+        const move = document.querySelector('[data-focus="dia-move"]');
+        const choice = steddingWelcomeTest.state.chromiumChoices.dia;
+        return [
+          'menu ' + (locked ? 'disabled' : 'enabled'),
+          'shows ' + shown.value,
+          'button ' + (move.disabled ? 'disabled' : 'enabled'),
+          move.textContent.startsWith('Moving') ? 'moving' : move.textContent,
+          'profile ' + choice.profile,
+        ].join(', ');
+      })())"));
+  std::string status;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    status = content::EvalJs(
+                 page, "steddingWelcomeTest.state.chromiumChoices.dia.status")
+                 .ExtractString();
+    return !status.empty() && status != "inProgress";
+  })) << "the import never ended";
+  EXPECT_EQ("menu enabled, shows 0, Work's summary, Moved, a result line",
+            content::EvalJs(page, R"(
+      (() => {
+        const block = document.querySelector('[data-block="dia"]');
+        const menu = block.querySelector('[data-focus="dia-profile"]');
+        const move = block.querySelector('[data-focus="dia-move"]');
+        const work = steddingWelcomeTest.state.chromium
+                         .find(b => b.key === 'dia').profiles[0];
+        const summary = block.querySelector('.arc-head .hint').textContent;
+        return [
+          'menu ' + (menu.disabled ? 'disabled' : 'enabled'),
+          'shows ' + menu.value,
+          summary === work.summary ? 'Work\'s summary' : summary,
+          move.textContent,
+          block.querySelector('[data-result="dia"]') ? 'a result line'
+                                                     : 'no result line',
+        ].join(', ');
+      })())"))
+      << status;
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(browser()->GetProfile());
+  bookmarks::test::WaitForBookmarkModelToLoad(model);
+  EXPECT_TRUE(model->IsBookmarked(GURL(kWorkPageB05)))
+      << "Work's bookmark did not come in";
+  EXPECT_FALSE(model->IsBookmarked(GURL(kHomePageB05)))
+      << "Home's bookmark came in, though Work was the profile moved";
+  // After the import, Home can be chosen and moved.
+  EXPECT_EQ("Move everything from Dia, enabled", content::EvalJs(page, R"(
+      (() => {
+        const menu = document.querySelector('[data-focus="dia-profile"]');
+        menu.value = '1';
+        menu.dispatchEvent(new Event('change'));
+        const move = document.querySelector('[data-focus="dia-move"]');
+        return move.textContent + ', ' +
+            (move.disabled ? 'disabled' : 'enabled');
+      })())"));
+}
