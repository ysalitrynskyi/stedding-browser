+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  const base::Time when = base::Time::UnixEpoch() + base::Days(20000);
+  const base::FilePath older = WriteBackup(profile.GetPath(), "{}", when);
+  const base::FilePath newer = WriteBackup(profile.GetPath(), "{}", when);
+  ASSERT_FALSE(older.empty());
+  ASSERT_FALSE(newer.empty());
+  ASSERT_NE(older, newer);
+  for (int i = 1; i < static_cast<int>(kBackupsKept); ++i) {
+    ASSERT_FALSE(
+        WriteBackup(profile.GetPath(), "{}", when + base::Minutes(i)).empty());
+  }
+  const std::vector<base::FilePath> backups = ListBackups(profile.GetPath());
+  ASSERT_EQ(kBackupsKept, backups.size());
+  EXPECT_EQ(newer, backups.back()) << "the newer of the two is the oldest kept";
+  EXPECT_TRUE(base::PathExists(newer));
+  EXPECT_FALSE(base::PathExists(older));
+}
+
+TEST(SidebarSyncLedgerTest, BackupNamesMatchNoSidebarPattern) {
+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  const base::FilePath path =
+      WriteBackup(profile.GetPath(), "{}", base::Time::Now());
+  ASSERT_FALSE(path.empty());
+  const std::string name = path.BaseName().AsUTF8Unsafe();
+  EXPECT_FALSE(base::StartsWith(name, "sidebar-"));
+  EXPECT_EQ(EntryKind::kIgnore, ClassifyFolderEntry(name, kOffice));
+  EXPECT_FALSE(base::StartsWith(
+      LedgerPath(profile.GetPath()).BaseName().AsUTF8Unsafe(), "sidebar-"));
+}
+
+}  // namespace
