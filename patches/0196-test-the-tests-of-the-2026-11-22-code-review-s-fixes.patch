+
+namespace {
+
+// The little windows open now, peeks in a small window left out.
+int LittleWindowCountB19() {
+  int count = 0;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        count += stedding::IsLittleWindow(window) &&
+                 !stedding::IsPeekWindow(window);
+        return true;
+      });
+  return count;
+}
+
+// little E2, E7 with an installed app that takes the links in its scope.
+class PromoteIntoTheWindowB19Test : public stedding::WebAppBrowserTest {
+ protected:
+  GURL Url(const std::string& path) {
+    return embedded_https_test_server().GetURL("a.test", path);
+  }
+
+  // An app over all of a.test, its start page /title1.html, that opens its
+  // links the way `client_mode` says, with "Open supported links" on (web
+  // apps Wa15).
+  webapps::AppId InstallCapturingApp(
+      blink::mojom::ManifestLaunchHandler_ClientMode client_mode) {
+    const webapps::AppId app_id =
+        InstallWebApp(web_app::WebAppInstallInfo::CreateForTesting(
+            Url("/title1.html"), blink::mojom::DisplayMode::kStandalone,
+            web_app::mojom::UserDisplayMode::kStandalone, client_mode));
+    EXPECT_FALSE(app_id.empty());
+    base::test::TestFuture<void> set;
+    provider().scheduler().SetAppCapturesSupportedLinksDisableOverlapping(
+        app_id, /*set_to_preferred=*/true, set.GetCallback());
+    EXPECT_TRUE(set.Wait());
+    EXPECT_TRUE(provider().registrar_unsafe().CapturesLinksInScope(app_id));
+    return app_id;
+  }
+
+  // A little window showing `url`, loaded.
+  BrowserWindowInterface* OpenLittle(const GURL& url) {
+    BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+        profile(), url, browser(), /*untrusted_launch=*/false);
+    EXPECT_TRUE(little);
+    if (!little) {
+      return nullptr;
+    }
+    EXPECT_TRUE(stedding::IsLittleWindow(little));
+    content::WebContents* const page =
+        little->GetTabStripModel()->GetActiveWebContents();
+    EXPECT_TRUE(page);
+    EXPECT_TRUE(page && content::WaitForLoadStop(page));
+    return little;
+  }
+
+  // The app windows open now.
+  int AppWindowCount() {
+    int count = 0;
+    for (BrowserWindowInterface* const window :
+         GetAllBrowserWindowInterfaces()) {
+      if (web_app::AppBrowserController::IsWebApp(window)) {
+        ++count;
+      }
+    }
+    return count;
+  }
+};
+
+// P23-1a; little E2, E7 with web apps Wa15: Open in Stedding puts the page in
+// a tab of the window it was sent to, even when an app that opens each link
+// in a new window of its own has the page's address in its scope. The page
+// had gone into a new app window instead.
+IN_PROC_BROWSER_TEST_F(PromoteIntoTheWindowB19Test,
+                       OpenInSteddingKeepsThePageFromAnAppThatOpensNewWindows) {
+  ASSERT_FALSE(
+      InstallCapturingApp(
+          blink::mojom::ManifestLaunchHandler_ClientMode::kNavigateNew)
+          .empty());
+  BrowserWindowInterface* const little = OpenLittle(Url("/title2.html"));
+  ASSERT_TRUE(little);
+  content::WebContents* const page =
+      little->GetTabStripModel()->GetActiveWebContents();
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  const int tabs_before = tabs->count();
+  const int app_windows = AppWindowCount();
+
+  ASSERT_TRUE(
+      stedding::PromoteLittleWindow(little, browser(), /*split=*/false));
+  EXPECT_EQ(app_windows, AppWindowCount()) << "the page went to the app";
+  EXPECT_EQ(tabs_before + 1, tabs->count());
+  EXPECT_NE(TabStripModel::kNoTab, tabs->GetIndexOfWebContents(page))
+      << "the page is not a tab of the window it was sent to";
+  EXPECT_EQ(page, tabs->GetActiveWebContents());
+}
+
+// P23-1a; little E2, E7 with web apps Wa15: the same with an app that opens
+// its links in the window it already has. The page was thrown away, the
+// app's own tab went to the address instead, and the window was left
+// reading a page that was gone.
+IN_PROC_BROWSER_TEST_F(PromoteIntoTheWindowB19Test,
+                       OpenInSteddingKeepsThePageFromAnAppThatReusesItsWindow) {
+  const webapps::AppId app_id = InstallCapturingApp(
+      blink::mojom::ManifestLaunchHandler_ClientMode::kNavigateExisting);
+  ASSERT_FALSE(app_id.empty());
+  BrowserWindowInterface* const app_window =
+      LaunchWebAppBrowserAndWait(app_id);
+  ASSERT_TRUE(app_window);
+  ASSERT_TRUE(web_app::AppBrowserController::IsForWebApp(app_window, app_id));
+  TabStripModel* const app_tabs = app_window->GetTabStripModel();
+  const int app_tabs_before = app_tabs->count();
+  ASSERT_EQ(Url("/title1.html"),
+            app_tabs->GetActiveWebContents()->GetVisibleURL());
+
+  BrowserWindowInterface* const little = OpenLittle(Url("/title2.html"));
+  ASSERT_TRUE(little);
+  content::WebContents* const page =
+      little->GetTabStripModel()->GetActiveWebContents();
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  const int tabs_before = tabs->count();
+
+  ASSERT_TRUE(
+      stedding::PromoteLittleWindow(little, browser(), /*split=*/false));
+  EXPECT_EQ(tabs_before + 1, tabs->count()) << "the page was thrown away";
+  EXPECT_NE(TabStripModel::kNoTab, tabs->GetIndexOfWebContents(page));
+  EXPECT_EQ(page, tabs->GetActiveWebContents());
+  EXPECT_EQ(app_tabs_before, app_tabs->count());
