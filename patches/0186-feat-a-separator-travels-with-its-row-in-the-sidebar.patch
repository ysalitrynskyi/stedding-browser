+// sidebar Y45 (BACKLOG S-286): a separator above a row goes into the file
+// and comes back with the row; a row without one comes back without.
+TEST_F(SidebarBackupTest, ASeparatorTravelsThroughTheFile) {
+  Open("https://kept.example/");
+  tabs::TabInterface* const plain = Open("https://plain.example/");
+  tabs::TabInterface* const pin = Open("https://pin.example/");
+  model().SetSpacePinned(pin, true);
+  stedding::SetSeparatorAbove(browser(), pin, true);
+  ASSERT_TRUE(stedding::HasSeparatorAbove(pin->GetContents()));
+  const std::string json =
+      PlanToJson(SnapshotSpace(browser(), model().active_id()));
+  EXPECT_NE(std::string::npos, json.find("separatorAbove"));
+  tabs().CloseWebContentsAt(tabs().GetIndexOfTab(pin),
+                            TabCloseTypes::CLOSE_NONE);
+  tabs().CloseWebContentsAt(tabs().GetIndexOfTab(plain),
+                            TabCloseTypes::CLOSE_NONE);
+
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(json);
+  ASSERT_TRUE(plan.has_value());
+  ApplyArcImport(browser(), *plan, ArcImportOptions());
+  tabs::TabInterface* const back = TabShowing(tabs(), "https://pin.example/");
+  ASSERT_TRUE(back);
+  EXPECT_TRUE(stedding::HasSeparatorAbove(back->GetContents()));
+  tabs::TabInterface* const plain_back =
+      TabShowing(tabs(), "https://plain.example/");
+  ASSERT_TRUE(plain_back);
+  EXPECT_FALSE(stedding::HasSeparatorAbove(plain_back->GetContents()));
+}
