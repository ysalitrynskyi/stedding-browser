+// Z11: a chord set now runs its command at once, with no restart.
+IN_PROC_BROWSER_TEST_F(ShortcutRebindTest, ANewChordWorksWithoutARestart) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("about:blank"), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs()->ActivateTabAt(0);
+  ASSERT_EQ(0, tabs()->active_index());
+  EXPECT_FALSE(Press(browser(), kFreeChord)) << "free before";
+
+  ASSERT_EQ(shortcuts::CheckKind::kOk,
+            shortcuts::AddShortcut(LocalState(), Row("next-tab"), kFreeChord,
+                                   /*replace=*/false,
+                                   shortcuts::OutsideHolders())
+                .kind);
+  EXPECT_TRUE(shortcuts::Current().IsChanged(IDC_SELECT_NEXT_TAB))
+      << "the preference's change applied before the write returned";
+  EXPECT_TRUE(Press(browser(), kFreeChord));
+  EXPECT_EQ(1, tabs()->active_index());
+}
