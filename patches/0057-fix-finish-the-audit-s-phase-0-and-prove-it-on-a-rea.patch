+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/pins.md H13 (PLAN.md TAB-17): what the Arc importer, a
+// sidebar file and a snapshot do with pages that are not web pages.
+
+#include <optional>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/arc_sidebar_importer.h"
+#include "chrome/browser/ui/spaces/sidebar_backup.h"
+#include "chrome/browser/ui/spaces/space_model.h"
