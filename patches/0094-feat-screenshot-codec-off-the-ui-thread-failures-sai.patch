+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CODEC_H_
+#define CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CODEC_H_
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback_forward.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace stedding {
+
+// The largest picture a full-page capture takes, in device pixels (BACKLOG
+// S-344). 16,384 a side is the largest texture many GPUs draw, and the
+// compositor clamps a render pass to the largest texture, so rows of a taller
+// page came out wrong past it anyway. 64 megapixels is 256 MB as a bitmap,
+// which a capture holds more than once: the browser's own picture, the copy
+// decoded for the clipboard, the clipboard's. Chromium itself refuses only a
+// side of 131,072 or more, about a gigabyte a bitmap. Plain arithmetic, for
+// any thread.
+inline constexpr int kMaxCaptureSide = 16384;
+inline constexpr int64_t kMaxCaptureArea = int64_t{16384} * 4096;
+
+// Whether a picture `width` by `height` device pixels is within the budget.
+bool FitsCaptureBudget(int64_t width, int64_t height);
+
+// What a full-page capture of a document `css_size` CSS pixels large takes,
+// drawn at `device_scale_factor` device pixels to the CSS pixel: nothing when
+// the whole document fits the budget, else the largest part of it from the
+// top left that does, in CSS pixels. The width is kept up to the side limit,
+// and the height is cut to what is left.
+std::optional<gfx::Size> FullPageClip(const gfx::Size& css_size,
+                                      float device_scale_factor);
+
+// The CPU-heavy and blocking steps of a capture (docs/features/screenshot.md
+// C9). Each runs as one task on the screenshot writer's sequence, never on the
+// UI thread: each starts with base::AssertLongCPUWorkAllowed(), which the
+// browser's UI thread forbids, so a DCHECK build flags a call made there.
+
+// What a DevTools message on the full-page capture's session turned out to be.
+enum class ReplyKind {
+  // An event, or a reply to another request: the capture keeps waiting.
+  kNotTheReply,
+  // The reply, with no picture in it: an error, no data, or data that is not
+  // base64.
+  kNoPicture,
+  // The reply, with the PNG's bytes.
+  kPicture,
+};
+
+struct CaptureReply {
+  CaptureReply();
+  CaptureReply(CaptureReply&&);
+  CaptureReply& operator=(CaptureReply&&);
+  ~CaptureReply();
+
+  ReplyKind kind = ReplyKind::kNotTheReply;
+  // Set only for kPicture.
+  std::vector<uint8_t> png;
+};
+
+// Reads `message`, a DevTools protocol message, as the reply to the
+// Page.captureScreenshot request numbered `request_id`: the JSON parse, the
+// id check and the base64 decode.
+CaptureReply ReadCaptureReply(std::string_view message, int request_id);
+
+// How a capture ended on the writer's sequence.
+struct CaptureOutcome {
+  CaptureOutcome();
+  CaptureOutcome(CaptureOutcome&&);
+  CaptureOutcome& operator=(CaptureOutcome&&);
+  ~CaptureOutcome();
+
+  // The picture, for the clipboard; draws nothing when there is none.
+  SkBitmap bitmap;
+  // The file written; empty when nothing was saved.
+  base::FilePath path;
+};
+
+// The visible and region captures: encodes `bitmap` as a PNG and writes it
+// into `directory` under `name` (WriteNewScreenshotFile, screenshot C4). The
+// bitmap comes back to be copied even when the encode or the write failed;
+// the path is set only when the file was saved. An empty bitmap gives an
+// empty outcome.
+CaptureOutcome EncodeAndWrite(SkBitmap bitmap,
+                              const base::FilePath& directory,
+                              const base::FilePath& name);
+
+// The full page: writes `png` as the page sent it, then decodes it for the
+// clipboard. A picture that does not decode, or whose header gives it more
+// pixels than the budget, is still saved and comes back with nothing to copy;
+// one that cannot be saved still comes back to be copied.
+CaptureOutcome WriteAndDecode(std::vector<uint8_t> png,
+                              const base::FilePath& directory,
+                              const base::FilePath& name);
+
+// The full page's whole step, one task: ReadCaptureReply, then, when the
+// message is the reply and holds a picture, WriteAndDecode.
+struct FullPageResult {
+  ReplyKind kind = ReplyKind::kNotTheReply;
+  // Empty unless `kind` is kPicture.
+  CaptureOutcome outcome;
+};
+FullPageResult ReadWriteAndDecode(std::string message,
+                                  int request_id,
+                                  const base::FilePath& directory,
+                                  const base::FilePath& name);
+
+// Runs `observer` at the start of each step above, on the thread the step
+// runs on (screenshot C9). Tests only; a null callback clears it. Set it
+// before the capture starts and clear it only once the writer has drained.
+void SetCaptureCodecObserverForTesting(base::RepeatingClosure observer);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SCREENSHOT_SCREENSHOT_CODEC_H_
