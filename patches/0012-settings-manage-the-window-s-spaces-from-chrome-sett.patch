diff --git a/chrome/browser/ui/webui/settings/stedding_spaces_handler.cc b/chrome/browser/ui/webui/settings/stedding_spaces_handler.cc
new file mode 100644
index 0000000000000..dc599a3e52f0f
--- /dev/null
+++ b/chrome/browser/ui/webui/settings/stedding_spaces_handler.cc
@@ -0,0 +1,142 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/stedding_spaces_handler.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/stringprintf.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/token.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "content/public/browser/web_ui.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace {
+
+std::optional<spaces::SpaceId> ParseId(const base::Value& value) {
+  if (!value.is_string()) {
+    return std::nullopt;
+  }
+  const std::optional<base::Token> token =
+      base::Token::FromString(value.GetString());
+  if (!token) {
+    return std::nullopt;
+  }
+  return spaces::SpaceId::FromRawToken(*token);
+}
+
+}  // namespace
+
+SteddingSpacesHandler::SteddingSpacesHandler() = default;
+SteddingSpacesHandler::~SteddingSpacesHandler() = default;
+
+void SteddingSpacesHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "steddingGetSpaces",
+      base::BindRepeating(&SteddingSpacesHandler::HandleGetSpaces,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingRenameSpace",
+      base::BindRepeating(&SteddingSpacesHandler::HandleRenameSpace,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "steddingDeleteSpace",
+      base::BindRepeating(&SteddingSpacesHandler::HandleDeleteSpace,
+                          base::Unretained(this)));
+}
+
+void SteddingSpacesHandler::OnJavascriptAllowed() {
+  if (spaces::SpaceModel* const model = GetModel()) {
+    observation_.Observe(model);
+  }
+}
+
+void SteddingSpacesHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+}
+
+void SteddingSpacesHandler::OnSpaceAdded(const spaces::SpaceId& id) {
+  PushSpaces();
+}
+void SteddingSpacesHandler::OnSpaceRemoved(const spaces::SpaceId& id) {
+  PushSpaces();
+}
+void SteddingSpacesHandler::OnActiveSpaceChanged(const spaces::SpaceId& from,
+                                                 const spaces::SpaceId& to) {
+  PushSpaces();
+}
+void SteddingSpacesHandler::OnSpaceMetadataChanged(const spaces::SpaceId& id) {
+  PushSpaces();
+}
+
+spaces::SpaceModel* SteddingSpacesHandler::GetModel() {
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  return spaces::SpaceModel::From(browser);
+}
+
+base::ListValue SteddingSpacesHandler::ListSpaces() {
+  base::ListValue list;
+  spaces::SpaceModel* const model = GetModel();
+  if (!model) {
+    return list;
+  }
+  for (const auto& space : model->spaces()) {
+    base::DictValue entry;
+    entry.Set("id", space->id().ToString());
+    entry.Set("name", space->name());
+    entry.Set("displayName", model->DisplayName(space->id()));
+    entry.Set("icon", space->icon());
+    entry.Set("color", base::StringPrintf("#%02X%02X%02X",
+                                          SkColorGetR(space->color()),
+                                          SkColorGetG(space->color()),
+                                          SkColorGetB(space->color())));
+    entry.Set("active", space->id() == model->active_id());
+    list.Append(std::move(entry));
+  }
+  return list;
+}
+
+void SteddingSpacesHandler::PushSpaces() {
+  if (IsJavascriptAllowed()) {
+    FireWebUIListener("stedding-spaces-changed", ListSpaces());
+  }
+}
+
+void SteddingSpacesHandler::HandleGetSpaces(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0], ListSpaces());
+}
+
+void SteddingSpacesHandler::HandleRenameSpace(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  const std::optional<spaces::SpaceId> id = ParseId(args[0]);
+  spaces::SpaceModel* const model = GetModel();
+  if (!id || !model || !args[1].is_string() || !model->GetSpace(*id)) {
+    return;
+  }
+  model->SetSpaceName(*id, args[1].GetString());
+}
+
+void SteddingSpacesHandler::HandleDeleteSpace(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  const std::optional<spaces::SpaceId> id = ParseId(args[0]);
+  spaces::SpaceModel* const model = GetModel();
+  // The last Space stays: a window always has one (SpaceModel's invariant).
+  if (!id || !model || model->size() <= 1) {
+    return;
+  }
+  model->RemoveSpace(*id);
+}
