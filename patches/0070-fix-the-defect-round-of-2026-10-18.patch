+void VerticalTabStripRegionView::SnapshotOutgoingSpace(
+    const spaces::SpaceId& from,
+    const spaces::SpaceId& to) {
+  // A slide still running ends here, as the incoming list's does in
+  // SlideInSpaceList.
+  DropOutgoingSpace();
+  views::ScrollView* const list =
+      tab_strip_view() ? tab_strip_view()->unpinned_tabs_scroll_view()
+                       : nullptr;
+  if (!list || !list->IsDrawn() || list->bounds().IsEmpty() ||
+      !stedding::ShouldAnimate(browser_view()->GetProfile()->GetPrefs())) {
+    return;
+  }
+  // A swipe takes the Space's title out with its list (B35); every other
+  // switch leaves the title row where it is (B32).
+  const std::vector<views::View*> leaving =
+      space_swipe_switching_ ? SpaceSwipeViews()
+                             : std::vector<views::View*>{list};
+  for (views::View* const view : leaving) {
+    if (!view->layer()) {
+      view->SetPaintToLayer();
+      view->layer()->SetFillsBoundsOpaquely(false);
+    }
+    if (view->layer()->parent() && !view->bounds().IsEmpty()) {
+      outgoing_space_.push_back(std::make_unique<SpaceSlideSnapshot>(*view));
+    }
+  }
+}
