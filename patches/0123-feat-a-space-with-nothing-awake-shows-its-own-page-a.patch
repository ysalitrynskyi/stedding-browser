@@ -0,0 +1,68 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_DOWNLOAD_FLIGHT_H_
+#define CHROME_BROWSER_UI_STEDDING_DOWNLOAD_FLIGHT_H_
+
+#include "base/time/time.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace stedding {
+
+// docs/features/sidebar-panels.md Pn18 (BACKLOG S-400; the owner, 2026-11-02:
+// the download's start was too small to notice). When a download starts in a
+// window whose sidebar shows its downloads button, a round chip with a
+// download arrow flies from the middle of the page to that button, shrinking
+// to the button's size and fading as it lands; the button then rings once.
+// These are the motion's numbers and its frames, free of views, so they are
+// tested on their own (DownloadFlightTest).
+
+// The chip's diameter as it leaves the page.
+inline constexpr int kDownloadChipDip = 48;
+// The diameter it lands at when the button is smaller still, or has no size.
+inline constexpr int kDownloadChipSmallestDip = 16;
+// The flight, and when the ring starts: as the chip lands, before it is gone.
+inline constexpr base::TimeDelta kDownloadFlightDuration =
+    base::Milliseconds(800);
+inline constexpr base::TimeDelta kDownloadRingDelay = base::Milliseconds(680);
+// The ring that grows and fades; with motion off (motion O1), the ring that
+// holds still in place of the whole motion.
+inline constexpr base::TimeDelta kDownloadRingDuration =
+    base::Milliseconds(400);
+inline constexpr base::TimeDelta kDownloadStillRingDuration = base::Seconds(1);
+// The ring's largest size, as a multiple of the button's; and its size while
+// it holds still.
+inline constexpr float kDownloadRingLargest = 1.8f;
+inline constexpr float kDownloadRingStill = 1.3f;
+// The ring's opacity at its start, and while it holds still.
+inline constexpr float kDownloadRingOpacity = 0.9f;
+
+// The ease both motions use: slow at the start and at the end, from 0 to 1.
+double DownloadEaseInOut(double t);
+
+// One frame of the flight at `t`, from 0 (it leaves) to 1 (it has landed).
+// `page` and `button` are in the same coordinates, the screen's.
+struct DownloadFlightFrame {
+  // The chip's circle: centred on the page's middle at 0 and on the button's
+  // at 1, on a straight line with DownloadEaseInOut; kDownloadChipDip across
+  // until halfway, then shrinking to the button's smaller side.
+  gfx::Rect chip;
+  // In over the first eighth, whole, then out over the last quarter.
+  float opacity = 0.0f;
+};
+DownloadFlightFrame DownloadFlightAt(double t,
+                                     const gfx::Rect& page,
+                                     const gfx::Rect& button);
+
+// One frame of the ring at `t`, from 0 to 1. `scale` is the ring's diameter
+// as a multiple of the button's larger side.
+struct DownloadRingFrame {
+  float scale = 1.0f;
+  float opacity = 0.0f;
+};
+DownloadRingFrame DownloadRingAt(double t, bool still);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_DOWNLOAD_FLIGHT_H_
diff --git a/chrome/browser/ui/stedding/download_flight_unittest.cc b/chrome/browser/ui/stedding/download_flight_unittest.cc
new file mode 100644
index 0000000000000..e2840677813bd
--- /dev/null
+++ b/chrome/browser/ui/stedding/download_flight_unittest.cc
@@ -0,0 +1,92 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/download_flight.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace stedding {
+namespace {
+
+// A page right of a sidebar, and the sidebar's downloads button at its foot.
+constexpr gfx::Rect kPage(300, 50, 1200, 800);
+constexpr gfx::Rect kButton(20, 840, 28, 28);
+
+// sidebar-panels Pn18: the chip leaves from the page's middle at its full
+// size, and lands on the button at the button's size, wherever the sidebar is.
+TEST(DownloadFlightTest, ItStartsAtThePagesMiddleAndLandsOnTheButton) {
+  const DownloadFlightFrame start = DownloadFlightAt(0.0, kPage, kButton);
+  EXPECT_EQ(kPage.CenterPoint(), start.chip.CenterPoint());
+  EXPECT_EQ(kDownloadChipDip, start.chip.width());
+  EXPECT_EQ(kDownloadChipDip, start.chip.height());
+
+  const DownloadFlightFrame end = DownloadFlightAt(1.0, kPage, kButton);
+  EXPECT_EQ(kButton.CenterPoint(), end.chip.CenterPoint());
+  EXPECT_EQ(kButton.width(), end.chip.width());
+
+  // Halfway in time is halfway along, at the full size still.
+  const DownloadFlightFrame half = DownloadFlightAt(0.5, kPage, kButton);
+  EXPECT_EQ(gfx::Point(467, 652), half.chip.CenterPoint());
+  EXPECT_EQ(kDownloadChipDip, half.chip.width());
+
+  // Eased: a quarter of the time is well short of a quarter of the way.
+  const DownloadFlightFrame quarter = DownloadFlightAt(0.25, kPage, kButton);
+  EXPECT_GT(quarter.chip.CenterPoint().x(), 900 - (900 - 34) / 4);
+
+  // A sidebar on the right: it flies right.
+  const gfx::Rect right_button(1700, 840, 28, 28);
+  EXPECT_EQ(right_button.CenterPoint(),
+            DownloadFlightAt(1.0, kPage, right_button).chip.CenterPoint());
+
+  // A button with no size, or a tiny one, still gets a chip that can be seen.
+  EXPECT_EQ(kDownloadChipSmallestDip,
+            DownloadFlightAt(1.0, kPage, gfx::Rect(20, 840, 0, 0))
+                .chip.width());
+}
+
+// Pn18: it comes in fast, is whole across the page, and fades as it lands.
+TEST(DownloadFlightTest, ItFadesInAndOutAsItLands) {
+  EXPECT_FLOAT_EQ(0.0f, DownloadFlightAt(0.0, kPage, kButton).opacity);
+  EXPECT_FLOAT_EQ(1.0f, DownloadFlightAt(0.125, kPage, kButton).opacity);
+  EXPECT_FLOAT_EQ(1.0f, DownloadFlightAt(0.5, kPage, kButton).opacity);
+  const float landing = DownloadFlightAt(0.9, kPage, kButton).opacity;
+  EXPECT_GT(landing, 0.0f);
+  EXPECT_LT(landing, 1.0f);
+  EXPECT_FLOAT_EQ(0.0f, DownloadFlightAt(1.0, kPage, kButton).opacity);
+  // Out of range is the nearest end.
+  EXPECT_EQ(DownloadFlightAt(1.0, kPage, kButton).chip,
+            DownloadFlightAt(3.0, kPage, kButton).chip);
+}
+
+// Pn18: the ring grows to 1.8 times the button and fades; with motion off it
+// holds still at one size.
+TEST(DownloadFlightTest, TheRingGrowsAndFadesOrHoldsStill) {
+  const DownloadRingFrame start = DownloadRingAt(0.0, /*still=*/false);
+  EXPECT_FLOAT_EQ(1.0f, start.scale);
+  EXPECT_FLOAT_EQ(kDownloadRingOpacity, start.opacity);
+  const DownloadRingFrame end = DownloadRingAt(1.0, /*still=*/false);
+  EXPECT_FLOAT_EQ(kDownloadRingLargest, end.scale);
+  EXPECT_FLOAT_EQ(0.0f, end.opacity);
+  EXPECT_GT(DownloadRingAt(0.5, false).scale, 1.0f);
+  EXPECT_LT(DownloadRingAt(0.5, false).scale, kDownloadRingLargest);
+
+  for (const double t : {0.0, 0.5, 0.99}) {
+    const DownloadRingFrame still = DownloadRingAt(t, /*still=*/true);
+    EXPECT_FLOAT_EQ(kDownloadRingStill, still.scale);
+    EXPECT_FLOAT_EQ(kDownloadRingOpacity, still.opacity);
+  }
+}
+
+TEST(DownloadFlightTest, TheEaseRunsFromZeroToOne) {
+  EXPECT_DOUBLE_EQ(0.0, DownloadEaseInOut(0.0));
+  EXPECT_DOUBLE_EQ(0.5, DownloadEaseInOut(0.5));
+  EXPECT_DOUBLE_EQ(1.0, DownloadEaseInOut(1.0));
+  EXPECT_LT(DownloadEaseInOut(0.1), 0.1);
+  EXPECT_GT(DownloadEaseInOut(0.9), 0.9);
+}
+
+}  // namespace
+}  // namespace stedding
