+namespace {
+
+class SidebarAddressTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  VerticalTabStripTopContainer* top() {
+    return region()->top_button_container_for_testing();
+  }
+  stedding::SidebarNavButtons* nav() {
+    return top()->sidebar_nav_buttons_for_testing();
+  }
+  stedding::SidebarAddressField* field() {
+    return top()->sidebar_address_field_for_testing();
+  }
+  tabs::VerticalTabStripStateController* controller() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+
+  void Settle() {
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+  }
+
+  GURL Page(const std::string& host, const std::string& path) {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  // A press of `button`, as the pointer's left button gives it.
+  static void Press(views::Button* button) {
+    const gfx::Point centre = button->GetLocalBounds().CenterPoint();
+    views::test::ButtonTestApi(button).NotifyClick(ui::MouseEvent(
+        ui::EventType::kMousePressed, centre, centre, base::TimeTicks::Now(),
+        ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON));
+  }
+
+  // Whether `view` shows: laid out visible, with room, in the drawn tree.
+  static bool Shows(views::View* view) {
+    return view && view->IsDrawn() && !view->bounds().IsEmpty();
+  }
+};
+
+// sidebar Y46, toolbar T50 (GitHub issue 45): off by default. On, the open
+// sidebar's top row has Back, Forward and Reload on the toggle's line and the
+// page's site under it; the address row hides while the sidebar is open,
+// except where the window's own buttons keep it (toolbar T22, Windows), and
+// comes back when the sidebar closes, whose rail shows neither.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, TheAddressMovesToTheSidebar) {
+  const GURL page = Page("a.test", "/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page));
+  ASSERT_TRUE(nav());
+  ASSERT_TRUE(field());
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  EXPECT_FALSE(prefs()->GetBoolean(stedding::prefs::kSidebarAddressInSidebar));
+  EXPECT_FALSE(Shows(nav())) << "off by default";
+  EXPECT_FALSE(Shows(field())) << "off by default";
+  EXPECT_TRUE(browser_view()->IsToolbarVisible());
+  const int top_height = top()->height();
+
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  ASSERT_TRUE(Shows(nav())) << "no buttons on the top row";
+  ASSERT_TRUE(Shows(field())) << "no address under the row";
+  // Forward has nothing to do on a page with no history ahead: drawn faded.
+  EXPECT_FALSE(nav()->forward()->GetEnabled());
+  ASSERT_TRUE(nav()->forward()->GetImageModel(views::Button::STATE_DISABLED));
+  EXPECT_NE(*nav()->forward()->GetImageModel(views::Button::STATE_NORMAL),
+            *nav()->forward()->GetImageModel(views::Button::STATE_DISABLED))
+      << "a button with nothing to do is drawn as one that has";
+  EXPECT_EQ(stedding::SidebarAddressText(page), field()->text_for_testing());
+  EXPECT_EQ(std::u16string::npos, field()->text_for_testing().find(u"http"))
+      << "the site, not the whole address";
+  EXPECT_NE(std::u16string::npos, field()->text_for_testing().find(u"a.test"));
+  // Laid out: the buttons on the toggle's line, after it; the field under the
+  // row and across it; the top row the taller by the field.
+  views::View* const toggle = top()->GetCollapseButton();
+  EXPECT_GE(nav()->x(), toggle->bounds().right());
+  EXPECT_NEAR(toggle->bounds().CenterPoint().y(),
+              nav()->bounds().CenterPoint().y(), 1);
+  EXPECT_GE(field()->y(), toggle->bounds().bottom());
+  EXPECT_EQ(top()->width(), field()->width());
+  EXPECT_GE(top()->height(),
+            top_height + stedding::SidebarAddressField::kHeight);
+  {
+    // The address and its buttons are pressed, not dragged by.
+    const gfx::Point on_field = field()->bounds().CenterPoint();
+    EXPECT_FALSE(top()->IsPositionInWindowCaption(on_field));
+    const gfx::Point on_nav = nav()->bounds().CenterPoint();
+    EXPECT_FALSE(top()->IsPositionInWindowCaption(on_nav));
+  }
+#if BUILDFLAG(IS_WIN)
+  EXPECT_TRUE(browser_view()->IsToolbarVisible())
+      << "toolbar T22: the caption buttons keep the row";
+#else
+  EXPECT_FALSE(browser_view()->IsToolbarVisible())
+      << "the open sidebar shows the address";
+#endif
+
+  // Closed to the rail: the row is back, and the rail has neither.
+  controller()->RequestCollapse(true);
+  Settle();
+  EXPECT_TRUE(browser_view()->IsToolbarVisible()) << "the row came back";
+  EXPECT_FALSE(Shows(nav())) << "the rail has no room for them";
+  EXPECT_FALSE(Shows(field()));
+  controller()->RequestCollapse(false);
+  Settle();
+  EXPECT_TRUE(Shows(nav()));
+  EXPECT_TRUE(Shows(field()));
+
+  // Back and Forward follow the page's history, and Back runs it.
+  const GURL next = Page("b.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), next));
+  EXPECT_EQ(stedding::SidebarAddressText(next), field()->text_for_testing());
+  EXPECT_TRUE(nav()->back()->GetEnabled());
+  EXPECT_FALSE(nav()->forward()->GetEnabled());
+  EXPECT_EQ(IDC_RELOAD, nav()->reload()->command()) << "loaded: Reload";
+  {
+    content::WebContents* const contents =
+        browser()->tab_strip_model()->GetActiveWebContents();
+    content::TestNavigationObserver back(contents);
+    Press(nav()->back());
+    back.Wait();
+    EXPECT_EQ(page, contents->GetLastCommittedURL());
+  }
+  EXPECT_EQ(stedding::SidebarAddressText(page), field()->text_for_testing());
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return nav()->forward()->GetEnabled(); }))
+      << "Forward after Back";
+
+  // A press on the field opens Cmd-L's bar, the page's address in it.
+  Press(field());
+  stedding::CommandBarView* const bar =
+      stedding::CommandBarView::GetOpenBar(browser_view());
+  ASSERT_TRUE(bar) << "the field opened no bar";
+  EXPECT_NE(std::u16string::npos,
+            std::u16string(bar->field_for_testing()->GetText()).find(u"a.test"));
+  bar->Close();
+  base::RunLoop().RunUntilIdle();
+
+  // Another tab's page is the field's while that tab is on screen; a New Tab
+  // page shows the placeholder.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL(chrome::kChromeUINewTabURL),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  EXPECT_TRUE(field()->text_for_testing().empty()) << "the placeholder";
+  browser()->tab_strip_model()->ActivateTabAt(0);
+  EXPECT_EQ(stedding::SidebarAddressText(page), field()->text_for_testing());
+
+  // Off again: the row stays whatever the sidebar does, and the top row is as
+  // it was.
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, false);
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  EXPECT_TRUE(browser_view()->IsToolbarVisible());
+  EXPECT_FALSE(Shows(nav()));
+  EXPECT_FALSE(Shows(field()));
+  EXPECT_EQ(top_height, top()->height());
+}
+
+// sidebar Y46: the site, as the field shows it, for each kind of page.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, TheFieldShowsTheSite) {
+  EXPECT_EQ(u"example.com",
+            stedding::SidebarAddressText(GURL("https://www.example.com/a?b")));
+  EXPECT_EQ(u"docs.example.com",
+            stedding::SidebarAddressText(GURL("https://docs.example.com/x")));
+  EXPECT_EQ(u"", stedding::SidebarAddressText(GURL()));
+  EXPECT_EQ(u"", stedding::SidebarAddressText(GURL("about:blank")));
+  EXPECT_EQ(u"",
+            stedding::SidebarAddressText(GURL(chrome::kChromeUINewTabURL)));
+  EXPECT_EQ(u"chrome://settings",
+            stedding::SidebarAddressText(GURL("chrome://settings/")));
+}
+
+}  // namespace
