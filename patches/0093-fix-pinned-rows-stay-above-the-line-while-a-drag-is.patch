+// pins H14, H27 (GitHub issue 41): in a Space with no pin and no essential
+// yet, a tab dragged up over the Clear line becomes the run's first pin, and
+// one dragged above the list the first essential. A loose row joined only a
+// run that was there, a rule meant for a private window, which has none, and
+// so a new Space's first pin could not be made by a drag.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest,
+                       ANewSpacesFirstPinAndEssentialAreDraggedIn) {
+  spaces::Space* const second = model().AddSpace("Second", SK_ColorBLUE);
+  ASSERT_TRUE(model().SetActiveSpace(second->id()));
+  tabs::TabInterface* const x = AddBlankTab();
+  tabs::TabInterface* const y = AddBlankTab();
+  ASSERT_FALSE(model().IsSpacePinned(x));
+  ASSERT_FALSE(model().IsSpacePinned(y));
+  stedding::test::KeepAboveOtherWindows(widget());
+
+  // `tab`'s row, once the rows have settled.
+  const auto settled_row = [&](const tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    return stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+  };
+  // A press on `row` and a drag in steps to `to`, the window laying out
+  // between two, then the release there.
+  const auto drag_to = [&](const TabView* row, const gfx::Point& to) {
+    const gfx::Point from = row->GetBoundsInScreen().CenterPoint();
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, from);
+    constexpr int kSteps = 20;
+    for (int i = 1; i <= kSteps; ++i) {
+      stedding::test::SendLeftMouse(
+          widget(), ui::EventType::kMouseDragged,
+          gfx::Point(from.x() + (to.x() - from.x()) * i / kSteps,
+                     from.y() + (to.y() - from.y()) * i / kSteps));
+      EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    }
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, to);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  };
+
+  {
+    SCOPED_TRACE("a tab dragged over the line, with no pin there yet");
+    const TabView* const row = settled_row(y);
+    ASSERT_TRUE(row);
+    const views::View* const list = row->parent();
+    ASSERT_TRUE(views::IsViewClass<UnpinnedTabContainerView>(list));
+    // At the top of the list, where the run's first pin goes.
+    drag_to(row, gfx::Point(row->GetBoundsInScreen().CenterPoint().x(),
+                            list->GetBoundsInScreen().y() + 2));
+    EXPECT_TRUE(model().IsSpacePinned(y)) << "the tab stayed loose";
+    EXPECT_TRUE(IsAboveTheLine(y));
+    EXPECT_FALSE(model().IsSpacePinned(x));
+  }
+  {
+    SCOPED_TRACE("a tab dragged above the list, with no essential yet");
+    const TabView* const row = settled_row(x);
+    ASSERT_TRUE(row);
+    const views::View* view = row;
+    while (view && !views::IsViewClass<TabStripView>(view)) {
+      view = view->parent();
+    }
+    const TabStripView* const strip = views::AsViewClass<TabStripView>(view);
+    ASSERT_TRUE(strip && strip->unpinned_tabs_scroll_view());
+    // Over the empty essentials: above the Space's title, or the list when
+    // no title is drawn.
+    int top = strip->unpinned_tabs_scroll_view()->GetBoundsInScreen().y();
+    if (const views::View* const title = strip->GetSpaceTitleRow();
+        title && title->IsDrawn()) {
+      top = std::min(top, title->GetBoundsInScreen().y());
+    }
+    drag_to(row,
+            gfx::Point(row->GetBoundsInScreen().CenterPoint().x(), top - 4));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return x->IsPinned(); }))
+        << "the tab did not become an essential";
+    EXPECT_FALSE(model().IsSpacePinned(x));
+    EXPECT_TRUE(model().IsSpacePinned(y)) << "the pin left the run";
+  }
+}
