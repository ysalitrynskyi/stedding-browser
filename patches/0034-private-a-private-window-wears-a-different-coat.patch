 void ClearActiveSpace(BrowserWindowInterface* browser) {
   if (SpaceModel* const model = ModelForCommands(browser)) {
     model->ClearUnpinnedTabs();
+    return;
+  }
+  // private V2: a private window has no Spaces, so Clear closes every tab
+  // that is not an essential; a fresh tab keeps the window when that would
+  // be all of them.
+  TabStripModel* const tabs = browser ? browser->GetTabStripModel() : nullptr;
+  if (!tabs) {
+    return;
+  }
+  std::vector<content::WebContents*> doomed;
+  for (int i = 0; i < tabs->count(); ++i) {
+    if (!tabs->IsTabPinned(i)) {
+      doomed.push_back(tabs->GetWebContentsAt(i));
+    }
+  }
+  if (doomed.empty()) {
+    return;
+  }
+  if (static_cast<int>(doomed.size()) == tabs->count()) {
+    chrome::ExecuteCommand(browser, IDC_NEW_TAB);
+  }
+  for (content::WebContents* contents : doomed) {
+    const int index = tabs->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      tabs->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
   }
 }
 
