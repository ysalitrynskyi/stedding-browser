+// Patch 0050: Stedding's profile is not in Chromium's folder.
+TEST(ChromePaths, DefaultUserDataDirIsSteddingsOwn) {
+  base::FilePath user_data_dir;
+  ASSERT_TRUE(GetDefaultUserDataDirectory(&user_data_dir));
+  EXPECT_EQ("Stedding", user_data_dir.BaseName().value());
