+#if BUILDFLAG(IS_WIN)
+  // sidebar Y54 (GitHub issues 118, 119): the window's buttons at the corner
+  // show from the strip `strip` DIP tall along the window's top edge over the
+  // corner, never from the page under it, stay while the pointer is on them
