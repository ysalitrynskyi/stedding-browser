+// spaces B5, settings T9 (BACKLOG S-148; the owner's decision of 2026-10-18;
+// docs/history/plan-2026-09-26.md WEB-20): Settings' bin, clicked on the
+// rendered page, asks the question every deletion of a Space asks, over the
+// window: the Space's name and its tabs. Escape keeps the Space and its row;
+// Enter deletes it, and the last Space's bin is then disabled. Each bin is
+// named for its Space, on hover and to a screen reader. The bin deleted a
+// Space without its own session at once, and every bin was "Delete Space".
+IN_PROC_BROWSER_TEST_F(SettingsSpacesTest, TheBinAsksBeforeDeletingASpace) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  model->SetSpaceName(home, "Home");
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://settings/stedding")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  const auto bin = [&](const spaces::SpaceId& id, const std::string& what) {
+    return content::EvalJs(page,
+                           content::JsReplace(kDeleteBin, id.ToString(), what));
+  };
+  // A real click at the middle of `id`'s bin.
+  const auto click_bin = [&](const spaces::SpaceId& id) {
+    const content::EvalJsResult centre = bin(id, "centre");
+    ASSERT_TRUE(centre.is_list()) << centre;
+    const base::ListValue& point = centre.ExtractList();
+    ASSERT_EQ(2u, point.size());
+    content::SimulateMouseClickAt(
+        page, 0, blink::WebMouseEvent::Button::kLeft,
+        gfx::Point(static_cast<int>(point[0].GetDouble()),
+                   static_cast<int>(point[1].GetDouble())));
+  };
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return bin(home, "exists") == true && bin(work, "exists") == true;
+  })) << "the page lists no bins";
+
+  views::Widget* question = nullptr;
+  views::AnyWidgetObserver questions(views::test::AnyWidgetTestPasskey{});
+  questions.set_shown_callback(
+      base::BindLambdaForTesting([&](views::Widget* widget) {
+        if (widget->widget_delegate() &&
+            widget->widget_delegate()->AsDialogDelegate()) {
+          question = widget;
+        }
+      }));
+  questions.set_closing_callback(
+      base::BindLambdaForTesting([&](views::Widget* widget) {
+        if (widget == question) {
+          question = nullptr;
+        }
+      }));
+  // As in SidebarClickTest.DeletingASpaceAlwaysAsksFirst: a key as the
+  // keyboard reaches the question.
+  const auto press = [&](ui::KeyboardCode key) {
+    ASSERT_TRUE(question);
+#if !BUILDFLAG(IS_MAC)
+    question->Activate();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return !question || question->IsActive(); }))
+        << "the question is not the active window";
+    ASSERT_TRUE(question);
+#endif
+    EXPECT_TRUE(question->GetFocusManager()->ProcessAccelerator(
+        ui::Accelerator(key, ui::EF_NONE)))
+        << "the question takes no key " << key;
+  };
+
+  {
+    SCOPED_TRACE("each bin names its Space");
+    EXPECT_EQ("Delete Home", bin(home, "label"));
+    EXPECT_EQ("Delete Work", bin(work, "label"));
+  }
+
+  {
+    SCOPED_TRACE("the bin asks first: Escape keeps the Space");
+    ASSERT_NO_FATAL_FAILURE(click_bin(work));
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return question != nullptr || !model->GetSpace(work); }));
+    ASSERT_TRUE(model->GetSpace(work)) << "the bin deleted Work without asking";
+    ASSERT_TRUE(question);
+    EXPECT_EQ(u"Delete \u201CWork\u201D?",
+              question->widget_delegate()->GetWindowTitle());
+    const std::u16string text = TextUnder(question->GetRootView());
+    EXPECT_NE(std::u16string::npos, text.find(u"It has no open tabs."))
+        << base::UTF16ToUTF8(text);
+    ASSERT_NO_FATAL_FAILURE(press(ui::VKEY_ESCAPE));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return question == nullptr; }))
+        << "Escape left the question open";
+    EXPECT_TRUE(model->GetSpace(work)) << "Escape deleted the Space";
+    EXPECT_EQ(true, bin(work, "exists")) << "the list dropped its row";
+  }
+
+  {
+    SCOPED_TRACE("Enter deletes it");
+    ASSERT_NO_FATAL_FAILURE(click_bin(work));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return question != nullptr; }))
+        << "the bin asked nothing";
+    ASSERT_NO_FATAL_FAILURE(press(ui::VKEY_RETURN));
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !model->GetSpace(work); }))
+        << "Enter kept the Space";
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return bin(work, "exists") == false; }))
+        << "the list kept its row";
+    EXPECT_EQ(true, bin(home, "disabled")) << "the last Space's bin works";
+    ASSERT_TRUE(base::test::RunUntil([&]() { return question == nullptr; }));
+  }
 }
 
