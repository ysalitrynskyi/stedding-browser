@@ -0,0 +1,83 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/privacy_defaults.h"
+
+#include "base/base_switches.h"
+#include "base/command_line.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/content_settings/core/browser/cookie_settings.h"
+#include "components/content_settings/core/common/pref_names.h"
+#include "components/embedder_support/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/testing_pref_service.h"
+#include "components/privacy_sandbox/privacy_sandbox_prefs.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+using PrivacyDefaultsWindowTest = BrowserWithTestWindowTest;
+
+// Q1, Q2, Q3, Q5, Q6, Q7: a fresh profile has the protective defaults.
+TEST_F(PrivacyDefaultsWindowTest, EveryDefaultIsTheProtectiveOne) {
+  const PrefService* const prefs = profile()->GetPrefs();
+  EXPECT_EQ(
+      static_cast<int>(content_settings::CookieControlsMode::kBlockThirdParty),
+      prefs->GetInteger(::prefs::kCookieControlsMode))
+      << "Q1";
+  EXPECT_TRUE(prefs->GetBoolean(::prefs::kHttpsFirstBalancedMode)) << "Q2";
+  EXPECT_FALSE(prefs->GetBoolean(embedder_support::kAlternateErrorPagesEnabled))
+      << "Q3";
+  EXPECT_TRUE(prefs->GetBoolean(::prefs::kEnableQuietNotificationPermissionUi))
+      << "Q5";
+  EXPECT_TRUE(prefs->GetBoolean(::prefs::kEnableQuietGeolocationPermissionUi))
+      << "Q5";
+  // Quiet and adaptive (CPSS) prompts are one setting's two choices, never
+  // both on: Chromium's settings page DCHECKs it.
+  EXPECT_FALSE(prefs->GetBoolean(::prefs::kEnableNotificationCPSS))
+      << "Q5, exclusive with quiet";
+  EXPECT_FALSE(prefs->GetBoolean(::prefs::kEnableGeolocationCPSS))
+      << "Q5, exclusive with quiet";
+  EXPECT_FALSE(prefs->GetBoolean(::prefs::kPrivacySandboxM1TopicsEnabled))
+      << "Q6";
+  EXPECT_FALSE(prefs->GetBoolean(::prefs::kPrivacySandboxM1FledgeEnabled))
+      << "Q6";
+  EXPECT_FALSE(
+      prefs->GetBoolean(::prefs::kPrivacySandboxM1AdMeasurementEnabled))
+      << "Q6";
+  EXPECT_FALSE(prefs->GetBoolean(::prefs::kSearchSuggestEnabled)) << "Q7";
+}
+
+// Q4: the local-state preference becomes the feature, beside whatever
+// --enable-features already holds.
+TEST(PrivacyDefaultsTest, GpcSwitchFollowsTheLocalState) {
+  EXPECT_EQ("GlobalPrivacyControlForce",
+            EnableFeaturesWithGlobalPrivacyControl("", true));
+  EXPECT_EQ("A,B,GlobalPrivacyControlForce",
+            EnableFeaturesWithGlobalPrivacyControl("A,B", true));
+  EXPECT_EQ("A,B", EnableFeaturesWithGlobalPrivacyControl(
+                       "A,GlobalPrivacyControlForce,B", false));
+  EXPECT_EQ("", EnableFeaturesWithGlobalPrivacyControl("", false));
+
+  TestingPrefServiceSimple local_state;
+  prefs::RegisterLocalStatePrefs(local_state.registry());
+  EXPECT_TRUE(local_state.GetBoolean(prefs::kGlobalPrivacyControl))
+      << "on by default (PRIVACY.md)";
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  command_line.AppendSwitchASCII(switches::kEnableFeatures, "Other");
+  ApplyGlobalPrivacyControl(&local_state, &command_line);
+  EXPECT_EQ("Other,GlobalPrivacyControlForce",
+            command_line.GetSwitchValueASCII(switches::kEnableFeatures));
+  local_state.SetBoolean(prefs::kGlobalPrivacyControl, false);
+  ApplyGlobalPrivacyControl(&local_state, &command_line);
+  EXPECT_EQ("Other",
+            command_line.GetSwitchValueASCII(switches::kEnableFeatures));
+}
+
+}  // namespace
+}  // namespace stedding
