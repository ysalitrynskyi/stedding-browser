+// Pn12: a dangerous download shows a warning and one action, which opens
+// the Downloads page; the download stays as it was.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsTest, ADangerousRowSendsToThePage) {
+  browser()->GetProfile()->GetPrefs()->SetBoolean(prefs::kSafeBrowsingEnabled,
+                                                  false);
