+// routing D5 (BACKLOG S-162): a deleted Space's rules and its place as the
+// Space for links from other apps go with it. Left behind, the first rule that
+// matches decides, so a rule naming no Space hid a later one naming a live
+// Space, and the link opened where the user was.
+TEST_F(SpaceWindowTest, ADeletedSpacesRulesGoWithIt) {
+  const SpaceId home = model().active_id();
+  Space* const mail = model().AddSpace("Mail", SK_ColorGREEN);
+  Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  const SpaceId mail_id = mail->id();
+  const SpaceId work_id = work->id();
+  PrefService* const prefs = profile()->GetPrefs();
+  AddRoute(prefs, {Route::Match::kContains, "example", mail_id.ToString()});
+  AddRoute(prefs, {Route::Match::kSite, "example.com", work_id.ToString()});
+  prefs->SetString(stedding::prefs::kExternalDefaultSpace, mail_id.ToString());
+
+  ASSERT_TRUE(model().RemoveSpace(mail_id));
+
+  const std::vector<Route> routes = ReadRoutes(prefs);
+  ASSERT_EQ(1u, routes.size());
+  EXPECT_EQ(work_id.ToString(), routes[0].space);
+  EXPECT_TRUE(prefs->GetString(stedding::prefs::kExternalDefaultSpace).empty());
+  AddTab(browser(), GURL("https://example.com/a"));
+  EXPECT_EQ(work_id, model().SpaceForTab(tabs().GetActiveTab()))
+      << "the live Space's rule, which the deleted one's used to hide";
+  model().SetActiveSpace(home);
+}
+
+// routing D5 (BACKLOG S-162): a rule an earlier build left behind, naming a
+// Space that is gone, does not hide the rule after it.
+TEST_F(SpaceWindowTest, ARuleNamingNoSpaceHidesNoOther) {
+  Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  const SpaceId gone = SpaceId::GenerateNew();
+  PrefService* const prefs = profile()->GetPrefs();
+  AddRoute(prefs, {Route::Match::kContains, "example", gone.ToString()});
+  AddRoute(prefs, {Route::Match::kSite, "example.com", work->id().ToString()});
+  AddTab(browser(), GURL("https://example.com/a"));
+  EXPECT_EQ(work->id(), model().SpaceForTab(tabs().GetActiveTab()));
+}
+
 // routing D3: an address typed into a fresh tab does not spend another app's
 // mark on the same address, so the app's tab, inserted later (its profile
 // still loading), still lands in the external default (BACKLOG S-201).
diff --git a/chrome/browser/ui/spaces/space_router.cc b/chrome/browser/ui/spaces/space_router.cc
index 082dfd044a072..5ec4e4251e888 100644
--- a/chrome/browser/ui/spaces/space_router.cc
+++ b/chrome/browser/ui/spaces/space_router.cc
@@ -262,6 +262,21 @@ void RemoveRoute(PrefService* prefs, size_t index) {
   WriteRoutes(prefs, routes);
 }
 
+void RemoveRoutesToSpace(PrefService* prefs, const std::string& space) {
+  if (!prefs || space.empty()) {
+    return;
+  }
+  std::vector<Route> routes = ReadRoutes(prefs);
+  if (std::erase_if(routes, [&](const Route& route) {
+        return route.space == space;
+      }) > 0) {
+    WriteRoutes(prefs, routes);
+  }
+  if (prefs->GetString(stedding::prefs::kExternalDefaultSpace) == space) {
+    prefs->ClearPref(stedding::prefs::kExternalDefaultSpace);
+  }
+}
