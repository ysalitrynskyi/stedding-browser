+// private V10, toolbar T8, T10, T50, T51 (GitHub issue 83, BACKLOG S-439): a
+// private or Guest window has no Space model, which makes a normal window's
+// address row, so the window makes its own. The settings are the normal
+// profile's; these windows only read them.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest,
+                       AnOffTheRecordWindowFollowsTheRowsSettings) {
+  for (BrowserWindowInterface* const window :
+       {CreateIncognitoBrowser(), CreateGuestBrowser()}) {
+    SCOPED_TRACE(window->GetProfile()->IsGuestSession() ? "Guest" : "private");
+    ASSERT_FALSE(spaces::SpaceModel::From(window));
+    BrowserView* const view = BrowserView::GetBrowserViewForBrowser(window);
+    tabs::VerticalTabStripStateController* const sidebar =
+        tabs::VerticalTabStripStateController::From(window);
+    ASSERT_TRUE(sidebar);
+    PrefService* const settings =
+        window->GetProfile()->GetOriginalProfile()->GetPrefs();
+    const auto row_is = [&](bool shown) {
+      return base::test::RunUntil(
+          [&]() { return view->IsToolbarVisible() == shown; });
+    };
+    const auto close_sidebar = [&](bool closed) {
+      sidebar->RequestCollapse(closed);
+      ASSERT_TRUE(base::test::RunUntil([&]() {
+        return !BrowserAnimationController::From(window)->IsAnimating(
+            TabStripAnimations::kVerticalTabStrip);
+      }));
+      views::test::RunScheduledLayout(view->GetWidget());
+    };
+    views::test::RunScheduledLayout(view->GetWidget());
+    EXPECT_TRUE(view->IsToolbarVisible());
+
+    // The report: the address in the sidebar, and the row beside it too.
+    settings->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+    EXPECT_TRUE(row_is(false))
+        << "the open sidebar shows the address; the row stayed";
+    // T51: what the row held goes with it.
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return view->toolbar()->stedding_buttons_host() != nullptr; }))
+        << "the row's buttons stayed on a row that is gone";
+    close_sidebar(true);
+    EXPECT_TRUE(row_is(true)) << "the rail has no address";
+    close_sidebar(false);
+    EXPECT_TRUE(row_is(false));
+
+    // T10: the key shows it and hides it.
+    chrome::ExecuteCommand(window, IDC_STEDDING_TOGGLE_ADDRESS_ROW);
+    EXPECT_TRUE(row_is(true)) << "the key did nothing";
+    chrome::ExecuteCommand(window, IDC_STEDDING_TOGGLE_ADDRESS_ROW);
+    EXPECT_TRUE(row_is(false));
+    // The key's answer lasts until the sidebar changes.
+    close_sidebar(true);
+    close_sidebar(false);
+    settings->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, false);
+    EXPECT_TRUE(row_is(true));
+
+    // T8: hidden with the sidebar. Windows' caption buttons keep it (T22).
+    settings->SetBoolean(stedding::prefs::kToolbarHideWithSidebar, true);
+    close_sidebar(true);
+#if BUILDFLAG(IS_WIN)
+    EXPECT_TRUE(view->IsToolbarVisible());
+#else
+    EXPECT_TRUE(row_is(false)) << "the row stayed with the sidebar closed";
+#endif
+    close_sidebar(false);
+    settings->SetBoolean(stedding::prefs::kToolbarHideWithSidebar, false);
+    EXPECT_TRUE(row_is(true));
+  }
+}
