+  }
+
+  // The row of `tab` as drawn once the rows are in place, or null.
+  TabView* DrawnRow(tabs::TabInterface* tab) {
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    views::test::RunScheduledLayout(widget());
+    return stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+  }
+
+  // The indent `tab`'s row is drawn at, or -1 when it has no row.
+  int Indent(tabs::TabInterface* tab) {
+    TabView* const row = DrawnRow(tab);
+    return row ? row->SteddingNestIndent() : -1;
+  }
+
+  // A link opened from `from` in a background tab, as a middle click or
+  // Cmd-click opens one (Chromium's OpenURLFromTab).
+  tabs::TabInterface* OpenLinkFrom(tabs::TabInterface* from,
+                                   const std::string& host) {
+    tabs()->ActivateTabAt(tabs()->GetIndexOfTab(from));
+    NavigateParams params(browser(), Url(host), ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    params.source_contents = from->GetContents();
+    Navigate(&params);
+    content::WebContents* const opened = params.navigated_or_inserted_contents;
+    // Loaded, so the session has its page: a tab with none is left out of
+    // what a restart reads.
+    EXPECT_TRUE(opened && content::WaitForLoadStop(opened));
+    const int index = tabs()->GetIndexOfWebContents(opened);
+    return index == TabStripModel::kNoTab ? nullptr
+                                          : tabs()->GetTabAtIndex(index);
+  }
+};
