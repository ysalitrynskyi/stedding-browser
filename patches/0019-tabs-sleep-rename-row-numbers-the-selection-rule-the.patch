+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SLEEP_TABS_H_
+#define CHROME_BROWSER_UI_STEDDING_SLEEP_TABS_H_
+
+#include <vector>
+
+class BrowserWindowInterface;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace stedding {
+
+// Sleeping tabs (docs/features/tabs.md R5): a slept tab is discarded the way
+// Chromium's memory saver discards one, but at the user's request and with
+// its row kept in the sidebar.
+enum class SleepScope {
+  // The tab itself.
+  kThisTab,
+  // Every other tab of the tab's Space.
+  kOthersInSpace,
+};
+
+// The tabs `scope` would put to sleep for `tab`: never the active tab, never
+// an essential (Chromium-pinned) tab, never a tab the user cannot see (another
+// Space, a collapsed folder), never one already asleep. Pure, for tests.
+std::vector<tabs::TabInterface*> TabsToSleep(BrowserWindowInterface* browser,
+                                             tabs::TabInterface* tab,
+                                             SleepScope scope);
+
+// Puts TabsToSleep() to sleep through the tab lifecycle unit, with the
+// external (user-requested) reason.
+// Sleep Tab on the active row activates the nearest visible row that stays
+// awake first (tabs R5); Sleep Others never takes the active row.
+void SleepTabs(BrowserWindowInterface* browser,
+               tabs::TabInterface* tab,
+               SleepScope scope);
+
+// Puts every listed tab to sleep that is not active or already asleep
+// (tabs R6: a Space the user left).
+void SleepTabList(const std::vector<tabs::TabInterface*>& tabs);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SLEEP_TABS_H_
