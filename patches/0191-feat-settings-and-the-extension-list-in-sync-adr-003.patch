+bool BreakFolderCycles(State& state, const Stamp& stamp) {
+  bool changed = false;
+  for (const auto& [id, record] : state.records) {
+    if (record.kind != Kind::kFolder) {
+      continue;
+    }
+    // Up from `id`, folder by folder; a folder met again closes a cycle.
+    // Cut, the walk starts again, for a folder may lead into another one.
+    for (;;) {
+      std::vector<std::string> path;
+      std::optional<size_t> cycle;
+      std::string at = id;
+      for (;;) {
+        const auto it = state.records.find(at);
+        if (it == state.records.end() || it->second.kind != Kind::kFolder) {
+          break;
+        }
+        if (const auto seen = std::ranges::find(path, at);
+            seen != path.end()) {
+          cycle = static_cast<size_t>(seen - path.begin());
+          break;
+        }
+        path.push_back(at);
+        at = it->second.Get(kFieldParent);
+      }
+      if (!cycle) {
+        break;
+      }
+      // The folder whose place was written first; on the same stamp, the
+      // larger id, so every computer picks the same one.
+      std::string first;
+      Stamp first_stamp;
+      for (size_t i = *cycle; i < path.size(); ++i) {
+        const Record& folder = state.records.at(path[i]);
+        const auto parent = folder.f.find(kFieldParent);
+        const Stamp placed =
+            parent == folder.f.end() ? Stamp() : parent->second.s;
+        if (first.empty() || placed < first_stamp ||
+            (placed == first_stamp && first < path[i])) {
+          first = path[i];
+          first_stamp = placed;
+        }
+      }
+      std::string space;
+      if (const auto it = state.lists.find(kSpacesList);
+          it != state.lists.end()) {
+        for (const std::string& each : it->second.order) {
+          const Record* const record_of = state.FindAlive(each);
+          if (record_of && record_of->kind == Kind::kSpace) {
+            space = each;
+            break;
+          }
+        }
+      }
+      if (space.empty()) {
+        for (const auto& [each, record_of] : state.records) {
+          if (record_of.kind == Kind::kSpace && record_of.Alive()) {
+            space = each;
+            break;
+          }
+        }
+      }
+      Record& moved = state.records.at(first);
+      if (space.empty()) {
+        // No Space to go to: in no container, as nothing in a cycle was.
+        moved.f[kFieldParent] = Field{std::string(), stamp};
+      } else {
+        const std::string pins = PinsListOf(space);
+        moved.f[kFieldParent] = Field{pins, stamp};
+        List& run = state.lists[pins];
+        if (std::ranges::find(run.order, first) == run.order.end()) {
+          run.order.push_back(first);
+        }
+        run.s = std::max(run.s, stamp);
+      }
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+bool LiftFoldersNestedTooDeep(State& state, const Stamp& stamp) {
+  const auto is_live_space = [&state](const std::string& id) {
+    const Record* const record = state.FindAlive(id);
+    return record && record->kind == Kind::kSpace;
+  };
+  bool changed = false;
+  for (const auto& [id, record] : state.records) {
+    if (record.kind != Kind::kFolder) {
+      continue;
+    }
+    // Up from `id`, folder by folder, as a reader counts (Sf33): a folder
+    // the state lacks is a level too. Lifted, the walk starts again, for the
+    // folder may still be too deep.
+    for (;;) {
+      std::vector<std::string> chain{id};
+      std::string up = record.Get(kFieldParent);
+      while (FolderIdOf(up) && std::ranges::find(chain, up) == chain.end()) {
+        chain.push_back(up);
+        const auto it = state.records.find(up);
+        if (it == state.records.end()) {
+          break;
+        }
+        up = it->second.Get(kFieldParent);
+      }
+      constexpr size_t kDeepest =
+          static_cast<size_t>(stedding::kMaxNestDepth);
+      if (chain.size() <= kDeepest) {
+        break;
+      }
+      // The folder at the sixth level; only the top of a chain can be one
+      // the state lacks.
+      const std::string lifted_id = chain[chain.size() - kDeepest - 1];
+      Record& lifted = state.records.at(lifted_id);
+      if (!lifted.Alive()) {
+        // Stamped as its removal is, so the move does not bring it back.
+        lifted.f[kFieldParent] = Field{std::string(), *lifted.del};
+        changed = true;
+        continue;
+      }
+      // The Space the outermost folder is in, else the first live one.
+      std::string space;
+      if (!FolderIdOf(up)) {
+        space = SpaceOfList(up);
+        if (space.empty() || up != PinsListOf(space) ||
+            !is_live_space(space)) {
+          space.clear();
+        }
+      }
+      if (space.empty()) {
+        if (const auto it = state.lists.find(kSpacesList);
+            it != state.lists.end()) {
+          for (const std::string& each : it->second.order) {
+            if (is_live_space(each)) {
+              space = each;
+              break;
+            }
+          }
+        }
+      }
+      if (space.empty()) {
+        for (const auto& [each, record_of] : state.records) {
+          if (record_of.kind == Kind::kSpace && record_of.Alive()) {
+            space = each;
+            break;
+          }
+        }
+      }
+      if (space.empty()) {
+        lifted.f[kFieldParent] = Field{std::string(), stamp};
+      } else {
+        const std::string pins = PinsListOf(space);
+        lifted.f[kFieldParent] = Field{pins, stamp};
+        List& run = state.lists[pins];
+        if (std::ranges::find(run.order, lifted_id) == run.order.end()) {
+          run.order.push_back(lifted_id);
+        }
+        run.s = std::max(run.s, stamp);
+      }
+      changed = true;
+    }
+  }
+  return changed;
+}
