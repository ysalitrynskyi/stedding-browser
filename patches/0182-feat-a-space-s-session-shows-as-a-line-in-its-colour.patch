+std::vector<SwitcherSessionLine> SwitcherSessionLines(
+    const std::vector<SwitcherSpan>& chips,
+    const std::vector<std::string>& sessions) {
+  std::vector<SwitcherSessionLine> lines;
+  const size_t count = std::min(chips.size(), sessions.size());
+  for (size_t i = 0; i < count;) {
+    // The run of neighbouring chips of one session that starts at `i`.
+    size_t end = i + 1;
+    while (end < count && sessions[end] == sessions[i]) {
+      ++end;
+    }
+    if (!sessions[i].empty()) {
+      const SwitcherSpan& first = chips[i];
+      const SwitcherSpan& last = chips[end - 1];
+      const int inset = std::min(kSwitcherSessionInset,
+                                 std::min(first.extent, last.extent) / 4);
+      const int start = first.start + inset;
+      const SwitcherSpan segment{start,
+                                 last.start + last.extent - inset - start};
+      auto line =
+          std::ranges::find(lines, sessions[i], &SwitcherSessionLine::session);
+      if (line == lines.end()) {
+        lines.push_back({.session = sessions[i]});
+        line = lines.end() - 1;
+      } else {
+        const SwitcherSpan& previous = line->segments.back();
+        const int from = previous.start + previous.extent;
+        line->connectors.push_back({from, segment.start - from});
+      }
+      line->segments.push_back(segment);
+    }
+    i = end;
+  }
+  const auto crosses = [](const SwitcherSessionLine& a,
+                          const SwitcherSessionLine& b) {
+    const int a_end = a.segments.back().start + a.segments.back().extent;
+    const int b_end = b.segments.back().start + b.segments.back().extent;
+    return a.segments.front().start < b_end && b.segments.front().start < a_end;
+  };
+  for (size_t i = 0; i < lines.size(); ++i) {
+    for (size_t earlier = 0; earlier < i; ++earlier) {
+      if (lines[earlier].lane == 0 && crosses(lines[earlier], lines[i])) {
+        lines[i].lane = 1;
+        break;
+      }
+    }
+  }
+  return lines;
+}
+
 }  // namespace spaces
