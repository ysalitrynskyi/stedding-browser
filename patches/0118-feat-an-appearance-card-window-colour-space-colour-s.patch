+namespace {
+
+LookStrength StrengthFrom(int value, LookStrength fallback) {
+  return value >= 0 && value <= 3 ? static_cast<LookStrength>(value)
+                                  : fallback;
+}
+
+void ApplyWindowLook(PrefService* local_state) {
+  WindowLook look;
+  const int colour = local_state->GetInteger(prefs::kWindowColour);
+  look.colour = colour >= 0 && colour <= 2 ? static_cast<WindowColour>(colour)
+                                           : WindowColour::kStedding;
+  look.custom_light = static_cast<uint32_t>(
+      local_state->GetInteger(prefs::kWindowColourLight) & 0xFFFFFF);
+  look.custom_dark = static_cast<uint32_t>(
+      local_state->GetInteger(prefs::kWindowColourDark) & 0xFFFFFF);
+  look.space_tint =
+      StrengthFrom(local_state->GetInteger(prefs::kSpaceTintStrength),
+                   LookStrength::kNormal);
+  look.tab_highlight =
+      StrengthFrom(local_state->GetInteger(prefs::kTabHighlight),
+                   LookStrength::kNormal);
+  // The highlight has no None: an active row that looks like the others.
+  if (look.tab_highlight == LookStrength::kNone) {
+    look.tab_highlight = LookStrength::kSubtle;
+  }
+  SetWindowLook(look);
+}
+
+void OnWindowLookChanged(PrefService* local_state) {
+  ApplyWindowLook(local_state);
+  // Colour providers are cached by their key, which a look does not change:
+  // drop them, and every widget builds its colours again through the mixers.
+  ui::ColorProviderManager::Get().ResetColorProviderCache();
+  ui::NativeTheme::GetInstanceForNativeUi()->NotifyOnNativeThemeUpdated();
+  RelayoutEveryWindow();
+}
+
+}  // namespace
+
+void EnsureWindowLookInstalled(PrefService* local_state) {
+  static base::NoDestructor<std::unique_ptr<PrefChangeRegistrar>> registrar;
+  if (!local_state || *registrar) {
+    return;
+  }
+  *registrar = std::make_unique<PrefChangeRegistrar>();
+  (*registrar)->Init(local_state);
+  for (const char* key :
+       {prefs::kWindowColour, prefs::kWindowColourLight,
+        prefs::kWindowColourDark, prefs::kSpaceTintStrength,
+        prefs::kTabHighlight}) {
+    (*registrar)->Add(key,
+                      base::BindRepeating(&OnWindowLookChanged, local_state));
+  }
+  ApplyWindowLook(local_state);
+}
+
