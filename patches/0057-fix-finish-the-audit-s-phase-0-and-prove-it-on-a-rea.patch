+// found in the LICENSE file.
+
+// A click on a sidebar row selects its tab (PLAN.md TAB-1, TST-1, TST-2).
+//
+// These tests drive the real BrowserView through the widget's event path.
+// On macOS a point the window classifies as caption (HTCAPTION) never reaches
+// views: AppKit turns the press into a window drag, while mouse moves still
+// arrive, so hover works and the click does nothing. Each click here first
+// asserts the window's hit test at the row, then clicks and checks both the
+// model and the page on screen.
+//
+// The other way a row stopped taking clicks was a rename left open: a
+// double-click on a title swaps it for a text field, and until 2026-09-28
+// only Enter or Escape put the title back. The field covered the title, so
+// every later click there went to the field and the tab stayed unselected.
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/notreached.h"
+#include "base/strings/string_number_conversions.h"
