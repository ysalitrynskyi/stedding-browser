+
+bool MoveFreshTabToSpaceJar(TabStripModel* tabs,
+                            tabs::TabInterface* tab,
+                            const SpaceRegistry* registry,
+                            const SpaceId& id,
+                            const GURL& url) {
+  content::WebContents* const old_contents = tab ? tab->GetContents() : nullptr;
+  if (!tabs || !old_contents ||
+      !NeedsOtherJar(old_contents, url, registry, id, tab->IsPinned())) {
+    return false;
+  }
+  content::BrowserContext* const context = old_contents->GetBrowserContext();
+  content::WebContents::CreateParams params(
+      context,
+      SiteInstanceForSpaceTab(context, url, registry, id, tab->IsPinned()));
+  params.initially_hidden =
+      old_contents->GetVisibility() == content::Visibility::HIDDEN;
+  std::unique_ptr<content::WebContents> fresh =
+      content::WebContents::Create(params);
+  stedding::CarryTabName(old_contents, fresh.get());
+  // The old contents showed a new-tab page at most; they go now, before the
+  // address loads in their place.
+  tabs->DiscardWebContents(old_contents, std::move(fresh)).reset();
+  return true;
+}
