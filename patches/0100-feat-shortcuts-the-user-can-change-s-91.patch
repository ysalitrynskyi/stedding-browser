+std::vector<AcceleratorMapping> GetAcceleratorList() {
+  // Stedding (docs/features/shortcuts.md Z10, Z11): the user's chords over
+  // the shipped list. Every consumer -- the windows' tables, the menus, the
+  // command bar, IsChromeAccelerator -- reads this one.
+  if (stedding::shortcuts::Current().empty()) {
+    return GetDefaultAcceleratorList();
+  }
+  std::vector<stedding::shortcuts::Binding> defaults;
+  for (const AcceleratorMapping& mapping : GetDefaultAcceleratorList()) {
+    defaults.push_back(
+        {mapping.command_id,
+         stedding::shortcuts::Chord(mapping.keycode, mapping.modifiers)});
+  }
+  std::vector<AcceleratorMapping> accelerators;
+  for (const stedding::shortcuts::Binding& binding :
+       stedding::shortcuts::ApplyForViewsTable(defaults)) {
+    accelerators.push_back(
+        {binding.chord.key, binding.chord.modifiers, binding.command,
+         chrome::GetActionIdForCommandId(binding.command)});
+  }
+  return accelerators;
+}
