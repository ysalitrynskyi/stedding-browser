+// The address `contents` shows: loaded, or restored and not yet loaded.
+GURL ShownUrl(content::WebContents* contents) {
+  const content::NavigationEntry* const entry =
+      contents->GetController().GetLastCommittedEntry();
+  return entry ? entry->GetURL() : contents->GetVisibleURL();
+}
+
+// The address a closed tab's record shows.
+GURL RecordedUrl(const sessions::tab_restore::Tab& tab) {
+  return tab.navigations.empty()
+             ? GURL()
+             : tab.navigations[tab.normalized_navigation_index()]
+                   .virtual_url();
+}
