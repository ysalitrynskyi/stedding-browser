+// windows G13: a window behind another window's change sends only the fields
+// it changed itself. A pin's new title there does not carry back the folder,
+// name or Space it had before the other window's change, and a rename there
+// keeps the other window's folder.
+TEST_F(PinStoreTest, AWindowBehindSendsOnlyTheFieldsItChanged) {
+  const SpaceId work = NewSpace();
+  const SpaceId play = NewSpace();
+  PinStore store(&prefs_);
+  const std::vector<PinRecord> held = {Pin("x", work, "https://x.example/"),
+                                       Pin("y", work, "https://y.example/")};
+  Ready(store, held);
+  // Another window moves x into a folder and to another Space, and renames y.
+  PinRecord moved = Pin("x", play, "https://x.example/");
+  moved.folder_path = R"([{"id":"f","title":"Mail"}])";
+  PinRecord named = Pin("y", work, "https://y.example/");
+  named.name = u"Why";
+  PublishAll(store, {moved, named}, {});
+  Counter counter;
+  base::ScopedObservation<PinStore, PinStore::Observer> watch(&counter);
+  watch.Observe(&store);
+
+  // This window still has both as they were; x retitled, y got a new home.
+  PinRecord titled = Pin("x", work, "https://x.example/");
+  titled.title = u"Inbox (2)";
+  PinRecord homed = Pin("y", work, "https://y2.example/");
+  const PinChanges changes = store.ChangesSince(held, {titled, homed});
+  store.Publish(changes.order, changes.changed, {});
+
+  const PinRecord* const x = store.Find("x");
+  ASSERT_TRUE(x);
+  EXPECT_EQ(play, x->space) << "the old Space was written back";
+  EXPECT_EQ(R"([{"id":"f","title":"Mail"}])", x->folder_path)
+      << "the old folder was written back";
+  EXPECT_EQ(u"Inbox (2)", x->title);
+  const PinRecord* const y = store.Find("y");
+  ASSERT_TRUE(y);
+  EXPECT_EQ(u"Why", y->name) << "the other window's rename was undone";
+  EXPECT_EQ(GURL("https://y2.example/"), y->home);
+  // The home is a real change; the title alone would have told no one.
+  EXPECT_EQ(1, counter.changes);
+}
