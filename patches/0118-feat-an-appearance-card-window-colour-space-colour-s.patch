+      {u"tab highlight", stedding::prefs::kTabHighlight, {2, 3, 1},
+       {u"Tab highlight: Normal \u25B8", u"Tab highlight: Strong \u25B8",
+        u"Tab highlight: Subtle \u25B8"}},
+  };
+  for (const auto& row : kRows) {
