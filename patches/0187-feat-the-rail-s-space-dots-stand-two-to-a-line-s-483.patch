+std::vector<gfx::Rect> SwitcherStackPlaces(
+    const std::vector<SwitcherStackItem>& items,
+    int column_width) {
+  std::vector<gfx::Rect> places;
+  places.reserve(items.size());
+  int y = 0;
+  size_t i = 0;
+  while (i < items.size()) {
+    const SwitcherStackItem& item = items[i];
+    if (item.size.width() > kSwitcherGridCell) {
+      y += item.margin_above;
+      places.emplace_back((column_width - item.size.width()) / 2, y,
+                          item.size.width(), item.size.height());
+      y += item.size.height() + item.margin_below;
+      ++i;
+      continue;
+    }
+    size_t end = i;
+    while (end < items.size() && items[end].size.width() <= kSwitcherGridCell) {
+      ++end;
+    }
+    const size_t count = end - i;
+    y += item.margin_above;
+    for (size_t k = 0; k < count; ++k) {
+      const gfx::Size& size = items[i + k].size;
+      const int cell_x = count == 1
+                             ? (column_width - kSwitcherGridCell) / 2
+                             : column_width / 2 - kSwitcherGridCell +
+                                   static_cast<int>(k % 2) * kSwitcherGridCell;
+      const int cell_y = y + static_cast<int>(k / 2) * kSwitcherGridCell;
+      places.emplace_back(cell_x + (kSwitcherGridCell - size.width()) / 2,
+                          cell_y + (kSwitcherGridCell - size.height()) / 2,
+                          size.width(), size.height());
+    }
+    y += static_cast<int>((count + 1) / 2) * kSwitcherGridCell +
+         items[end - 1].margin_below;
+    i = end;
+  }
+  return places;
+}
