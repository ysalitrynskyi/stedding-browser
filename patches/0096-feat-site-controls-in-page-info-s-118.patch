+// site-controls Si6: on a page that may ask for them -- http on this
+// machine here -- camera and microphone are listed though the site never
+// asked, and a choice there is written to the site's settings; on an http
+// page elsewhere they are not.
+IN_PROC_BROWSER_TEST_F(SiteControlsTest, CameraAndMicrophoneAreAlwaysListed) {
+  const GURL local = Url("localhost");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), local));
+  {
+    views::BubbleDialogDelegateView* const panel = OpenFromTheChip();
+    PermissionToggleRowView* const camera =
+        PermissionRow(panel, ContentSettingsType::MEDIASTREAM_CAMERA);
+    ASSERT_TRUE(camera) << "no camera row";
+    EXPECT_TRUE(PermissionRow(panel, ContentSettingsType::MEDIASTREAM_MIC))
+        << "no microphone row";
