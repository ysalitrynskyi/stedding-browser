+std::string SamePageKey(const GURL& url) {
+  if (!url.is_valid()) {
+    return std::string();
+  }
+  // GURL has already lowercased the scheme and the host and dropped a
+  // scheme's default port, so http://example.com:80/ reads as
+  // https://example.com/ does once the schemes are folded.
+  constexpr std::string_view kWww = "www.";
+  std::string_view host = url.host();
+  if (host.starts_with(kWww)) {
+    host.remove_prefix(kWww.size());
+  }
+  std::string_view path = url.path();
+  if (path.ends_with('/')) {
+    path.remove_suffix(1);
+  }
+  const std::string_view scheme =
+      url.SchemeIsHTTPOrHTTPS() ? std::string_view("http") : url.scheme();
+  return base::StrCat({scheme, "://", host, ":", url.port(), path, "?",
+                       url.query(), "#", url.ref()});
+}
+
+std::vector<tabs::TabInterface*> SpaceModel::DuplicateTabsInActiveSpace()
+    const {
+  std::vector<tabs::TabInterface*> out;
+  if (!tab_strip_model_) {
+    return out;
+  }
+  const tabs::TabInterface* const selected = tab_strip_model_->GetActiveTab();
+  // Per page, whether one of its tabs stays for its own sake (commandbar
+  // K26). The loose tabs are gathered in strip order, which is sidebar order.
+  std::map<std::string, bool> kept;
+  std::vector<std::pair<tabs::TabInterface*, std::string>> loose;
+  for (int i = 0; i < tab_strip_model_->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(i);
+    // Essentials are in every Space; other Spaces' tabs are never compared.
+    if (!IsTabInActiveSpace(tab)) {
+      continue;
+    }
+    content::WebContents* const contents = tab->GetContents();
+    if (!contents) {
+      continue;
+    }
+    const GURL& committed = contents->GetLastCommittedURL();
+    std::string key = SamePageKey(committed.is_empty()
+                                      ? contents->GetVisibleURL()
+                                      : committed);
+    if (key.empty()) {
+      continue;
+    }
+    // The selected tab, the pins of both tiers, a folder's or a split's tab
+    // (a folder never empties, a split never comes apart) and a tab the strip
+    // will not close are never closed here; each counts as its page's copy
+    // that stays.
+    const bool keeper = tab == selected || tab->IsPinned() ||
+                        IsSpacePinned(tab) || tab->IsSplit() ||
+                        !stedding::FolderPathForTab(tab).empty() ||
+                        !tab_strip_model_->IsTabClosable(tab);
+    if (keeper) {
+      kept[key] = true;
+      continue;
+    }
+    kept.try_emplace(key, false);
+    loose.emplace_back(tab, std::move(key));
+  }
+  for (const auto& [tab, key] : loose) {
+    bool& stays = kept[key];
+    if (!stays) {
+      // Nothing keeps this page: its first loose tab in the sidebar stays.
+      stays = true;
+      continue;
+    }
+    out.push_back(tab);
+  }
+  return out;
+}
+
+void SpaceModel::CloseDuplicateTabs() {
+  if (!tab_strip_model_) {
+    return;
+  }
+  // Collect first, close after: closing shifts every index behind it. Handles,
+  // not pointers: a close can take other tabs with it. Every page keeps a tab,
+  // so unlike Clear this never needs a New Tab to keep the window open.
+  std::vector<tabs::TabHandle> doomed;
+  for (tabs::TabInterface* const tab : DuplicateTabsInActiveSpace()) {
+    doomed.push_back(tab->GetHandle());
+  }
+  for (const tabs::TabHandle& handle : doomed) {
+    tabs::TabInterface* const tab = handle.Get();
+    const int index =
+        tab ? tab_strip_model_->GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    if (index != TabStripModel::kNoTab) {
+      // The user's own close, into the recently-closed list (commandbar K26).
+      tab_strip_model_->CloseWebContentsAt(
+          index, TabCloseTypes::CLOSE_USER_GESTURE |
+                     TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    }
+  }
+}
