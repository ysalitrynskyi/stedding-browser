+// P35-1a, peek P20: a link that leaves the pinned site and turns out to be a
+// file -- here a link on the pinned site the server sends on to a file on
+// another, as a release's download link is -- peeks, and the peek closes once
+// the download is under way: the file is saved, and the pinned tab is on
+// screen and takes input again. The peek's page had shown nothing, as a
+// download's never does, and the empty card stayed over the pin, which took
+// no input until the user closed it.
+IN_PROC_BROWSER_TEST_F(PeekOverPageB27Test,
+                       ALinkThatBecomesADownloadClosesItsPeek) {
+  // Outlives the folder, which goes when the test ends.
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  base::ScopedTempDir downloads;
+  ASSERT_TRUE(downloads.CreateUniqueTempDir());
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetFilePath(prefs::kDownloadDefaultDirectory, downloads.GetPath());
+  prefs->SetBoolean(prefs::kPromptForDownload, false);
+  // A text file, which an http site may hand out without a warning.
+  const GURL file = Url("b.test", "/download-autoopen.txt");
+  ASSERT_NO_FATAL_FAILURE(
+      OpenPin(Url("a.test", "/server-redirect?" + file.spec())));
+  tabs::TabInterface* const pin = tab();
+  const GURL pinned_url = pin->GetContents()->GetLastCommittedURL();
+
+  bool peeked = false;
+  views::AnyWidgetObserver widgets(views::test::AnyWidgetTestPasskey{});
+  widgets.set_initialized_callback(
+      base::BindLambdaForTesting([&](views::Widget* widget) {
+        if (widget->GetName() == "SteddingPeek") {
+          peeked = true;
+        }
+      }));
+  content::DownloadManager* const manager =
+      browser()->GetProfile()->GetDownloadManager();
+  content::DownloadTestObserverTerminal done(
+      manager, 1, content::DownloadTestObserver::ON_DANGEROUS_DOWNLOAD_FAIL);
+  ClickLink();
+  done.WaitForFinished();
+
+  EXPECT_TRUE(peeked) << "the link did not peek";
+  EXPECT_TRUE(WaitForNoPeek(pin))
+      << "the peek whose page became a download stayed over the pin";
+  EXPECT_EQ(pin, tab());
+  EXPECT_EQ(pinned_url, pin->GetContents()->GetLastCommittedURL())
+      << "the pin followed the link";
+  content::DownloadManager::DownloadVector items;
+  manager->GetAllDownloads(&items);
+  ASSERT_EQ(1u, items.size());
+  EXPECT_EQ(download::DownloadItem::COMPLETE, items.front()->GetState());
+  const base::FilePath saved = items.front()->GetTargetFilePath();
+  EXPECT_EQ(base::MakeAbsoluteFilePath(downloads.GetPath()),
+            base::MakeAbsoluteFilePath(saved.DirName()))
+      << saved;
+  EXPECT_TRUE(base::PathExists(saved)) << saved;
+}
