+// TAB-3: an Option-click that takes a pin home ends the press as a click,
+// so at once -- no other row clicked first -- a Cmd-click adds a row to the
+// selection and the window's close button closes the window. The reset used
+// to return before the drag ended, and the window refused to close.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, AfterAPinGoesHomeTheWindowCloses) {
+  const GURL home = embedded_test_server()->GetURL("home.test", "/title1.html");
+  const GURL away = embedded_test_server()->GetURL("away.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  tabs::TabInterface* const pin = tab_strip_model()->GetActiveTab();
+  model->SetSpacePinned(pin, true);
