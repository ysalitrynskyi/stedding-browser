+// tabs R14, import I3 (BACKLOG S-431, GitHub issue 80): `title` is the name the
+// person gave a tab in Arc, as a rename here gives one, whichever part of the
+// sidebar holds it. It came in as the title of a page not yet loaded, so the
+// page's own replaced it at the first load. A tab they did not rename has no
+// name, and follows its page.
+TEST_F(ArcSidebarImportWindowTest, ANameGivenInArcIsAName) {
+  constexpr char kNamed[] = R"json({
+  "version": 1,
+  "sidebar": {"containers": [
+    {"global": {}},
+    {
+      "spaces": ["space-work", {"id": "space-work", "title": "Work",
+        "containerIDs": ["pinned", "work-pinned", "unpinned", "work-unpinned"]}],
+      "items": [
+        "work-pinned", {"id": "work-pinned", "parentID": null,
+          "childrenIds": ["tab-pin", "list-docs"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "work-unpinned", {"id": "work-unpinned", "parentID": null,
+          "childrenIds": ["tab-loose", "tab-plain"], "title": "",
+          "data": {"itemContainer": {"containerType": {"spaceItems": {}}}}},
+        "top", {"id": "top", "parentID": null,
+          "childrenIds": ["tab-top"], "title": "",
+          "data": {"itemContainer": {"containerType": {"topApps": {}}}}},
+        "tab-pin", {"id": "tab-pin", "parentID": "work-pinned",
+          "childrenIds": [], "title": "My mail",
+          "data": {"tab": {"savedURL": "https://mail.example/",
+                           "savedTitle": "Inbox (3)"}}},
+        "list-docs", {"id": "list-docs", "parentID": "work-pinned",
+          "childrenIds": ["tab-doc"], "title": "Docs", "data": {"list": {}}},
+        "tab-doc", {"id": "tab-doc", "parentID": "list-docs",
+          "childrenIds": [], "title": "The plan",
+          "data": {"tab": {"savedURL": "https://docs.example/",
+                           "savedTitle": "Untitled document"}}},
+        "tab-loose", {"id": "tab-loose", "parentID": "work-unpinned",
+          "childrenIds": [], "title": "Reading",
+          "data": {"tab": {"savedURL": "https://read.example/",
+                           "savedTitle": null}}},
+        "tab-plain", {"id": "tab-plain", "parentID": "work-unpinned",
+          "childrenIds": [], "title": null,
+          "data": {"tab": {"savedURL": "https://plain.example/",
+                           "savedTitle": "A page"}}},
+        "tab-top", {"id": "tab-top", "parentID": "top",
+          "childrenIds": [], "title": "Calendar",
+          "data": {"tab": {"savedURL": "https://top.example/",
+                           "savedTitle": "Monday"}}}
+      ],
+      "topAppsContainerIDs": [{"default": true}, "top"]
+    }
+  ]}
+})json";
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(kNamed);
+  ASSERT_TRUE(plan.has_value());
+  ApplyArcImport(browser(), *plan, ArcImportOptions());
+  const auto name_of = [&](std::string_view url) {
+    for (int i = 0; i < tabs().count(); ++i) {
+      content::WebContents* const contents = tabs().GetWebContentsAt(i);
+      if (contents->GetVisibleURL() == GURL(url)) {
+        return stedding::TabName(contents);
+      }
+    }
+    ADD_FAILURE() << url;
+    return std::u16string();
+  };
+  EXPECT_EQ(u"My mail", name_of("https://mail.example/")) << "a pin";
+  EXPECT_EQ(u"The plan", name_of("https://docs.example/"))
+      << "a pin in a pinned folder";
+  EXPECT_EQ(u"Reading", name_of("https://read.example/")) << "a loose tab";
+  EXPECT_EQ(u"Calendar", name_of("https://top.example/")) << "an essential";
+  EXPECT_EQ(u"", name_of("https://plain.example/")) << "no name in Arc";
+}
