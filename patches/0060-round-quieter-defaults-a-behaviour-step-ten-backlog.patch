+
+void FolderView::SyncRowOrder() {
+  // folders F31: the node keeps its children in the folder's order and moves
+  // them there (Alphabetize, the one-step moves), but adds each new row's
+  // view at the end, and the box layout draws views in view order: a sorted
+  // folder kept drawing its old order (2026-10-11). The node's order wins.
+  if (!collection_node_ || !header_) {
+    return;
+  }
+  size_t index = 1;  // The header stays the first child.
+  for (views::View* const row : collection_node_->GetDirectChildren()) {
+    if (!row || row->parent() != this) {
+      continue;
+    }
+    if (GetIndexOf(row) != index) {
+      ReorderChildView(row, index);
+    }
+    ++index;
+  }
+}
