--- a/chrome/browser/resources/settings/page_visibility.ts
+++ b/chrome/browser/resources/settings/page_visibility.ts
@@ -44,6 +44,31 @@ export interface PrivacyPageVisibility {
 
 function createPageVisibility(): PageVisibility|undefined {
   if (!loadTimeData.getBoolean('isGuest')) {
+    // Stedding: the "You and Google" page (sign-in, sync, Google services)
+    // and the AI page are not offered; everything else is visible as usual.
+    if (loadTimeData.valueExists('steddingHidesGoogleSections') &&
+        loadTimeData.getBoolean('steddingHidesGoogleSections')) {
+      // A page missing from this object counts as hidden, so every other
+      // page is listed as visible explicitly.
+      return {
+        a11y: true,
+        ai: false,
+        appearance: true,
+        autofill: true,
+        defaultBrowser: true,
+        downloads: true,
+        extensions: true,
+        languages: true,
+        onStartup: true,
+        people: false,
+        performance: true,
+        privacy: true,
+        reset: true,
+        safetyHub: true,
+        system: true,
+        yourSavedInfo: true,
+      };
+    }
     return undefined;
   }
 
