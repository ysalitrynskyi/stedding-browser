+#ifndef CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_VIEW_H_
+
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_delegate.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/webview/unhandled_keyboard_event_handler.h"
+#include "ui/views/view.h"
+#include "ui/views/view_observer.h"
+
+class BrowserView;
+class BrowserWindowInterface;
+class GURL;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace views {
+class Label;
+class WebView;
+}  // namespace views
+
+namespace stedding {
+
+// A page shown over the window instead of in a tab: what a link from a pinned
+// tab opens when it would leave the pinned site (docs/PRODUCT.md, "Peek").
+// The peek owns its WebContents. Escape or a click on the scrim dismisses it
+// and the page is gone; ⌘O (or the button) promotes it to a real tab, moving
+// the very same WebContents into the strip so nothing reloads.
+//
+// Like the command bar it is a layered child of the browser view, not a
+// widget of its own, so keys reach it through the window's focus manager.
+class PeekView : public views::View,
+                 public content::WebContentsDelegate,
+                 public content::WebContentsObserver,
+                 public views::ViewObserver {
+  METADATA_HEADER(PeekView, views::View)
+
+ public:
+  // Opens `url` in a peek over the window `source` is in, replacing any peek
+  // already open there.
+  static void Show(tabs::TabInterface* source, const GURL& url);
+
+  // The open peek in `browser_view`, or null.
+  static PeekView* GetOpen(BrowserView* browser_view);
+
+  explicit PeekView(BrowserWindowInterface* browser);
+  PeekView(const PeekView&) = delete;
+  PeekView& operator=(const PeekView&) = delete;
+  ~PeekView() override;
+
+  // Navigates the peek's own page.
+  void Load(const GURL& url);
+
+  // Moves the page into a new foreground tab of the browser and closes.
+  void PromoteToTab();
+
+  // Removes the peek from the window and destroys its page. Safe to call from
+  // inside an event the peek is handling.
+  void Close();
+
+  content::WebContents* web_contents() { return contents_.get(); }
+
+  // views::View:
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  void AddedToWidget() override;
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override;
+  void CloseContents(content::WebContents* source) override;
+  bool HandleKeyboardEvent(content::WebContents* source,
+                           const input::NativeWebKeyboardEvent& event) override;
+
+  // content::WebContentsObserver:
+  void TitleWasSet(content::NavigationEntry* entry) override;
+  void DidFinishNavigation(
+      content::NavigationHandle* navigation_handle) override;
+
+  // views::ViewObserver:
+  void OnViewBoundsChanged(views::View* observed_view) override;
+
+ private:
+  void BuildContents();
+  // Covers the window's content area; the card is laid out inside.
+  void UpdateBounds();
+  void UpdateTitle();
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  std::unique_ptr<content::WebContents> contents_;
+  raw_ptr<views::View> card_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  bool closing_ = false;
+  views::UnhandledKeyboardEventHandler unhandled_keyboard_event_handler_;
+  base::ScopedObservation<views::View, views::ViewObserver> parent_observation_{
+      this};
+  base::WeakPtrFactory<PeekView> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PEEK_PEEK_VIEW_H_
