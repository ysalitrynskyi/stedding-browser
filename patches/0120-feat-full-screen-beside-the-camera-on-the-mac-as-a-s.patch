+  sidebar->SetExpandOnHoverEnabled(false);
+  ASSERT_FALSE(sidebar->IsCollapsed());
+  ASSERT_TRUE(EnterFullScreen(browser(), browser_view));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }));
+  views::test::RunScheduledLayout(widget);
+  ASSERT_NE(browser_view->top_container()->GetWidget(), widget)
+      << "the row is not in the overlay";
+
+  // Where the page's card starts, past the gutter the row keeps too.
+  const auto card_x = [&] {
+    return browser_view->multi_contents_view()->GetBoundsInScreen().x() +
+           VerticalTabStripRegionView::SteddingCardGutter(browser_view);
+  };
+  const auto row_x = [&] {
+    return browser_view->toolbar()->GetBoundsInScreen().x();
+  };
+  EXPECT_NEAR(card_x(), row_x(), 1) << "the row and the card start apart";
+
+  const int start = sidebar->GetUncollapsedWidth();
+  for (const int width : {start + 40, start + 48, start}) {
+    SCOPED_TRACE(testing::Message() << "the sidebar at " << width << " DIP");
+    const int card_before = card_x();
+    sidebar->SetUncollapsedWidth(width);
