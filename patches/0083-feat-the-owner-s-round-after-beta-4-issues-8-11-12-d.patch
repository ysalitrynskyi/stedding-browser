+bool TabStripModel::CanMoveFolderInto(
+    const tabs::FolderTabCollection* folder,
+    const tabs::TabCollection* container) const {
+  // A folder with no tab has no block of tabs to move; the tree peels one
+  // anyway (F26). The depth is the one child tabs nest to (tabs R57).
+  return folder && folder->TabCountRecursive() > 0 &&
+         contents_data_->CanMoveFolderInto(
+             folder, container, static_cast<size_t>(stedding::kMaxNestDepth));
+}
+
+bool TabStripModel::MoveFolderInto(tabs::FolderTabCollection* folder,
+                                   tabs::TabCollection* container,
+                                   size_t child_index) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  if (!CanMoveFolderInto(folder, container)) {
+    return false;
+  }
+  const tabs::ChildrenVector& children = container->GetChildren();
+  child_index = std::min(child_index, children.size());
+  if (folder->GetParentCollection() == container) {
+    const std::optional<size_t> from = container->GetIndexOfCollection(folder);
+    CHECK(from.has_value());
+    if (child_index == *from || child_index == *from + 1) {
+      return true;
+    }
+  }
+  const int tab_count = static_cast<int>(folder->TabCountRecursive());
+  const int first = GetIndexOfTab(folder->GetTabAtIndexRecursive(0));
+  std::vector<int> block;
+  block.reserve(static_cast<size_t>(tab_count));
+  for (int k = 0; k < tab_count; ++k) {
+    block.push_back(first + k);
+  }
+  const auto in_folder = [folder](const tabs::TabInterface* tab) {
+    for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+         each = each->GetParentCollection()) {
+      if (each == folder) {
+        return true;
+      }
+    }
+    return false;
+  };
+  // Where the folder's first tab goes, as the strip reads now: at the first
+  // tab of the row it goes before, or just past the last tab `container`
+  // holds, the folder's own aside.
+  std::optional<int> before;
+  for (size_t i = child_index; i < children.size() && !before; ++i) {
+    if (RowIdentity(children[i]) != folder && TabCountOfRow(children[i]) > 0) {
+      before = GetIndexOfTab(FirstTabOfRow(children[i]));
+    }
+  }
+  if (!before) {
+    int past = -1;
+    for (const tabs::TabInterface* const tab : container->GetTabsRecursive()) {
+      if (!in_folder(tab)) {
+        past = std::max(past, GetIndexOfTab(tab) + 1);
+      }
+    }
+    before = past < 0 ? first : past;
+  }
+  // The block is one run, so it sits wholly before that place or wholly
+  // after it; a move lands where the strip reads once the block has left.
+  const int destination = first < *before ? *before - tab_count : *before;
+  bool moved = false;
+  MoveTabsWithNotifications(
+      std::move(block), destination,
+      base::BindOnce(
+          [](tabs::TabStripCollection* contents,
+             tabs::FolderTabCollection* folder, tabs::TabCollection* container,
+             size_t child_index, bool* out) {
+            *out = contents->MoveFolderInto(
+                folder, container, child_index,
+                static_cast<size_t>(stedding::kMaxNestDepth));
+          },
+          contents_data_.get(), folder, container, child_index, &moved));
+  return moved;
+}
