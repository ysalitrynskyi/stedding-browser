+// commandbar K39: "air traffic" in ⌘T's bar, not its actions, lists the
+// routes card, and choosing the row opens Settings on it.
+IN_PROC_BROWSER_TEST_F(FindWordsTest, TheBarFindsTheRoutesCard) {
+  chrome::ExecuteCommand(browser(), IDC_NEW_TAB);  // ⌘T
+  stedding::CommandBarView* const bar = stedding::CommandBarView::GetOpenBar(
+      BrowserView::GetBrowserViewForBrowser(browser()));
+  ASSERT_TRUE(bar);
+  bar->ContentsChanged(bar->field_for_testing(), u"air traffic");
+  size_t place = bar->row_count_for_testing();
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    if (bar->row_title_for_testing(i) == u"Sites Routed to Spaces") {
+      place = i;
+    }
+  }
+  ASSERT_LT(place, bar->row_count_for_testing()) << "no row for the card";
+  // ↓ to the row, then Enter, as a person chooses it (K5).
+  for (size_t i = bar->selected_row_for_testing(); i < place; ++i) {
+    PressKey(*bar, ui::VKEY_DOWN);
+  }
+  ASSERT_EQ(place, bar->selected_row_for_testing());
+  PressKey(*bar, ui::VKEY_RETURN);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return browser()->GetTabStripModel()->GetActiveWebContents()->GetVisibleURL()
+               == GURL("chrome://settings/stedding?card=routes");
+  })) << browser()->GetTabStripModel()->GetActiveWebContents()->GetVisibleURL();
+}
