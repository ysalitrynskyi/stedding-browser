+        << "side by side: " << drawn[0].bounds.ToString() << " and "
+        << drawn[1].bounds.ToString();
+    EXPECT_EQ(drawn[0].bounds.width(), drawn[1].bounds.width());
+    EXPECT_GE(drawn[2].bounds.y(), drawn[0].bounds.bottom())
+        << "the third card on the next row: " << drawn[2].bounds.ToString();
+    for (const Card& card : drawn) {
+      EXPECT_FALSE(card.titled)
+          << "a card shows a title: " << card.bounds.ToString();
+    }
+  };
