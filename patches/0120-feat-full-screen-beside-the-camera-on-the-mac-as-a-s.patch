+++ b/chrome/browser/ui/views/frame/stedding_camera_row_mac.mm
@@ -0,0 +1,405 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "chrome/browser/ui/views/frame/stedding_camera_row_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include <algorithm>
+#include <cmath>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/address_row.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/common/chrome_switches.h"
+#import "components/remote_cocoa/app_shim/native_widget_mac_nswindow.h"
+#include "components/prefs/pref_service.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+
+namespace stedding {
+
+namespace {
+
+std::optional<CameraRowFullscreenMac::Housing>& HousingForTesting() {
+  static std::optional<CameraRowFullscreenMac::Housing> housing;
+  return housing;
+}
+
+AddressRow* RowOf(BrowserView* browser_view) {
+  return browser_view && browser_view->browser()
+             ? AddressRow::From(browser_view->browser())
+             : nullptr;
+}
+
+}  // namespace
+
+// static
+void CameraRowFullscreenMac::SetHousingForTesting(
+    std::optional<Housing> housing) {
+  HousingForTesting() = housing;
+}
+
+// static
+std::optional<CameraRowFullscreenMac::Housing> CameraRowFullscreenMac::HousingOn(
+    NSScreen* screen) {
+  if (!screen) {
+    return std::nullopt;
+  }
+  // A test's housing; one with no height stands for a screen without one.
+  if (HousingForTesting()) {
+    return HousingForTesting()->height > 0 ? HousingForTesting()
+                                           : std::nullopt;
+  }
+  // The two halves of the row beside the camera, the housing between them
+  // (macOS 12 and later; on a screen without a housing both are empty).
+  const NSRect left = screen.auxiliaryTopLeftArea;
+  const NSRect right = screen.auxiliaryTopRightArea;
+  const CGFloat height = screen.safeAreaInsets.top;
+  if (NSIsEmptyRect(left) || NSIsEmptyRect(right) || height <= 0) {
+    return std::nullopt;
+  }
+  const CGFloat origin = NSMinX(screen.frame);
+  return Housing{
+      .height = static_cast<int>(std::lround(height)),
+      .left = static_cast<int>(std::floor(NSMaxX(left) - origin)),
+      .right = static_cast<int>(std::ceil(NSMinX(right) - origin)),
+  };
+}
+
+CameraRowFullscreenMac::CameraRowFullscreenMac(BrowserView* browser_view,
+                                               NativeWidgetMacNSWindow* window)
+    : browser_view_(browser_view), window_(window) {
+  if (AddressRow* const row = RowOf(browser_view_)) {
+    row->SetCameraRowToggle(base::BindRepeating(
+        [](base::WeakPtr<CameraRowFullscreenMac> self) {
+          return self && self->Toggle();
+        },
+        weak_factory_.GetWeakPtr()));
+  }
+  // The green button and its menu (T55): the same as the chord.
+  base::WeakPtr<CameraRowFullscreenMac> weak = weak_factory_.GetWeakPtr();
+  [window setSteddingFullScreenOverride:^BOOL {
+    return weak && weak->Toggle();
+  }];
+  switch_registrar_.Init(browser_view_->GetProfile()->GetPrefs());
+  switch_registrar_.Add(
+      prefs::kCameraRowFullscreen,
+      base::BindRepeating(&CameraRowFullscreenMac::OnSwitchChanged,
+                          base::Unretained(this)));
+  NSNotificationCenter* const center = NSNotificationCenter.defaultCenter;
+  main_observer_ = [center
+      addObserverForName:NSWindowDidBecomeMainNotification
+                  object:window
+                   queue:nil
+              usingBlock:^(NSNotification*) {
+                if (weak) {
+                  weak->OnMainChanged(true);
+                }
+              }];
+  resign_main_observer_ = [center
+      addObserverForName:NSWindowDidResignMainNotification
+                  object:window
+                   queue:nil
+              usingBlock:^(NSNotification*) {
+                if (weak) {
+                  weak->OnMainChanged(false);
+                }
+              }];
+  screen_observer_ = [center
+      addObserverForName:NSWindowDidChangeScreenNotification
+                  object:window
+                   queue:nil
+              usingBlock:^(NSNotification*) {
+                if (weak) {
+                  weak->OnScreenChanged();
+                }
+              }];
+  screens_observer_ = [center
+      addObserverForName:NSApplicationDidChangeScreenParametersNotification
+                  object:nil
+                   queue:nil
+              usingBlock:^(NSNotification*) {
+                if (weak) {
+                  weak->OnScreenChanged();
+                }
+              }];
+}
+
+CameraRowFullscreenMac::~CameraRowFullscreenMac() {
+  NSNotificationCenter* const center = NSNotificationCenter.defaultCenter;
+  for (id observer : {main_observer_, resign_main_observer_, screen_observer_,
+                      screens_observer_}) {
+    if (observer) {
+      [center removeObserver:observer];
+    }
+  }
+  SetHidesMenuBar(false);
+  [window_ setSteddingFullScreenOverride:nil];
+  // The address row is not asked to forget the toggle: it holds a weak
+  // pointer, and at a quit the browser, and the row with it, can be gone
+  // before the window closes (a quit from full screen read freed memory
+  // here).
+}
+
+bool CameraRowFullscreenMac::Toggle() {
+  if (active_) {
+    Leave(/*restore_frame=*/true);
+    return true;
+  }
+  if (!CanEnter()) {
+    return false;
+  }
+  Enter();
+  return true;
+}
+
+bool CameraRowFullscreenMac::CanEnter() const {
+  NativeWidgetMacNSWindow* const window = window_;
+  if (!window || suspended_ || !browser_view_ || !browser_view_->browser() ||
+      browser_view_->browser()->GetType() !=
+          BrowserWindowInterface::TYPE_NORMAL ||
+      !browser_view_->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kCameraRowFullscreen)) {
+    return false;
+  }
+  if (window.styleMask & NSWindowStyleMaskFullScreen) {
+    return false;
+  }
+  // A kiosk launch has its own full screen and its own presentation options
+  // (the Dock and the menu bar hidden for good), which this mode's would
+  // clash with.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kKioskMode)) {
+    return false;
+  }
+  return HousingOn(window.screen).has_value();
+}
+
+void CameraRowFullscreenMac::Enter() {
+  NativeWidgetMacNSWindow* const window = window_;
+  saved_frame_ = window.frame;
+  saved_style_ = window.styleMask;
+  saved_movable_ = window.movable;
+  saved_shadow_ = window.hasShadow;
+  active_ = true;
+  FitScreen();
+}
+
+void CameraRowFullscreenMac::FitScreen() {
+  NativeWidgetMacNSWindow* const window = window_;
+  if (!window || !active_) {
+    return;
+  }
+  NSScreen* const screen = window.screen;
+  const std::optional<Housing> housing = HousingOn(screen);
+  if (!housing) {
+    Leave(/*restore_frame=*/true);
+    return;
+  }
+  // Borderless, so AppKit neither keeps the frame below the menu bar nor
+  // rounds its corners, and there are no traffic lights; still a window
+  // that can be minimised, and closed from the File menu (Close Window,
+  // whose performClose: needs the closable style; a borderless window draws
+  // no button for it). Not moved or resized by a drag (T59).
+  constexpr NSUInteger kStyle = NSWindowStyleMaskBorderless |
+                                NSWindowStyleMaskMiniaturizable |
+                                NSWindowStyleMaskClosable;
+  if (window.styleMask != kStyle) {
+    window.styleMask = kStyle;
+  }
+  window.movable = NO;
+  window.hasShadow = NO;
+  // The menu bar hidden first: while it shows, AppKit keeps even this
+  // window's top under it. Back from a page's full screen the window is not
+  // main yet, and the row came back 50 points down (T58); becoming main
+  // fits it again (OnMainChanged).
+  if (window.isMainWindow) {
+    SetHidesMenuBar(true);
+  }
+  [window setFrame:screen.frame display:YES animate:NO];
+  if (AddressRow* const row = RowOf(browser_view_)) {
+    row->SetCameraRow(AddressRow::CameraRow{.height = housing->height,
+                                            .housing_left = housing->left,
+                                            .housing_right = housing->right});
+  }
+}
+
+void CameraRowFullscreenMac::Leave(bool restore_frame) {
+  NativeWidgetMacNSWindow* const window = window_;
+  if (!active_) {
+    return;
+  }
+  active_ = false;
+  SetHidesMenuBar(false);
+  if (window) {
+    window.styleMask = saved_style_;
+    window.movable = saved_movable_;
+    window.hasShadow = saved_shadow_;
+    if (restore_frame) {
+      [window setFrame:FrameToRestore() display:YES animate:NO];
+    }
+  }
+  if (AddressRow* const row = RowOf(browser_view_)) {
+    row->SetCameraRow(std::nullopt);
+  }
+}
+
+void CameraRowFullscreenMac::WillEnterNativeFullscreen() {
+  if (!active_) {
+    return;
+  }
+  Leave(/*restore_frame=*/false);
+  suspended_ = true;
+}
+
+void CameraRowFullscreenMac::NativeFullscreenEnded() {
+  if (!suspended_) {
+    return;
+  }
+  suspended_ = false;
+  NativeWidgetMacNSWindow* const window = window_;
+  if (!window) {
+    return;
+  }
+  // The switch turned off meanwhile, or the window is now on a screen with
+  // no housing: back to the frame from before, as leaving does.
+  if (!CanEnter()) {
+    [window setFrame:FrameToRestore() display:YES animate:NO];
+    return;
+  }
+  // AppKit has put back the window it started from: the saved one is still
+  // the frame from before the row beside the camera.
+  active_ = true;
+  FitScreen();
+  // AppKit may set the frame it restores after this, a titled window's,
+  // kept below the menu bar: the row then sat 50 points too low (T58). Fit
+  // again once it is done.
+  for (const base::TimeDelta delay :
+       {base::TimeDelta(), base::Milliseconds(600)}) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<CameraRowFullscreenMac> self) {
+              if (self) {
+                self->FitScreen();
+              }
+            },
+            weak_factory_.GetWeakPtr()),
+        delay);
+  }
+}
+
+std::optional<gfx::Rect> CameraRowFullscreenMac::RestoredBounds() const {
+  if (!active_ && !suspended_) {
+    return std::nullopt;
+  }
+  return gfx::ScreenRectFromNSRect(saved_frame_);
+}
+
+NSRect CameraRowFullscreenMac::FrameToRestore() const {
+  NSRect frame = saved_frame_;
+  // The screen that holds most of the frame from before; none when no
+  // screen holds any of it any more.
+  NSScreen* best = nil;
+  CGFloat best_area = 0;
+  for (NSScreen* const screen in NSScreen.screens) {
+    const NSRect overlap = NSIntersectionRect(frame, screen.visibleFrame);
+    const CGFloat area = NSWidth(overlap) * NSHeight(overlap);
+    if (area > best_area) {
+      best = screen;
+      best_area = area;
+    }
+  }
+  NSWindow* const window = window_;
+  NSScreen* const screen =
+      best ? best : (window.screen ? window.screen : NSScreen.mainScreen);
+  if (!screen) {
+    return frame;
+  }
+  // Inside that screen's visible area, as Chromium's own full screen puts a
+  // window back (BrowserView::SetBoundsConstrained): no larger than it, and
+  // moved in where it crosses an edge.
+  const NSRect area = screen.visibleFrame;
+  frame.size.width = std::min(NSWidth(frame), NSWidth(area));
+  frame.size.height = std::min(NSHeight(frame), NSHeight(area));
+  frame.origin.x = std::clamp(NSMinX(frame), NSMinX(area),
+                              NSMaxX(area) - NSWidth(frame));
+  frame.origin.y = std::clamp(NSMinY(frame), NSMinY(area),
+                              NSMaxY(area) - NSHeight(frame));
+  return frame;
+}
+
+void CameraRowFullscreenMac::OnMainChanged(bool main) {
+  if (!active_) {
+    return;
+  }
+  SetHidesMenuBar(main);
+  NativeWidgetMacNSWindow* const window = window_;
+  if (main && window && window.screen &&
+      !NSEqualRects(window.frame, window.screen.frame)) {
+    FitScreen();
+  }
+}
+
+void CameraRowFullscreenMac::SetHidesMenuBar(bool hides) {
+  if (hides_menu_bar_ == hides) {
+    return;
+  }
+  hides_menu_bar_ = hides;
+  // The menu bar and the Dock come in when the pointer reaches the screen's
+  // top or bottom edge, as in macOS's full screen. Only while this window is
+  // the main one, and only this app's: another app in front has its own.
+  // AppKit raises when an auto-hide option meets the matching hide option,
+  // so a bit already covered is left alone, and leaving takes off only the
+  // bits added here.
+  const NSApplicationPresentationOptions current = NSApp.presentationOptions;
+  if (hides) {
+    NSApplicationPresentationOptions add = 0;
+    if (!(current & (NSApplicationPresentationHideDock |
+                     NSApplicationPresentationAutoHideDock))) {
+      add |= NSApplicationPresentationAutoHideDock;
+    }
+    if (!(current & (NSApplicationPresentationHideMenuBar |
+                     NSApplicationPresentationAutoHideMenuBar))) {
+      add |= NSApplicationPresentationAutoHideMenuBar;
+    }
+    added_presentation_ = add;
+    if (add) {
+      NSApp.presentationOptions = current | add;
+    }
+  } else {
+    NSApplicationPresentationOptions left = current & ~added_presentation_;
+    // An auto-hidden menu bar needs the Dock hidden or auto-hidden: one that
+    // another part of the app set keeps the Dock's option.
+    if ((left & NSApplicationPresentationAutoHideMenuBar) &&
+        !(left & (NSApplicationPresentationHideDock |
+                  NSApplicationPresentationAutoHideDock))) {
+      left |= NSApplicationPresentationAutoHideDock;
+    }
+    added_presentation_ = 0;
+    if (left != current) {
+      NSApp.presentationOptions = left;
+    }
+  }
+}
+
+void CameraRowFullscreenMac::OnSwitchChanged() {
+  if (!browser_view_->GetProfile()->GetPrefs()->GetBoolean(
+          prefs::kCameraRowFullscreen)) {
+    Leave(/*restore_frame=*/true);
+  }
+}
+
+void CameraRowFullscreenMac::OnScreenChanged() {
+  if (active_) {
+    FitScreen();
+  }
+}
