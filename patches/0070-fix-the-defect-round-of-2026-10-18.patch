+        "tab-other", {"id": "tab-other", "parentID": "cont-pinned",
+          "childrenIds": [], "title": "", "data": {"tab": {
+            "savedURL": "$2", "savedTitle": "Other host"}}}
+      ]
+    }
+  ]}
+})json";
+
+// "/" sends the visit on, as many a site's front page does: on 127.0.0.1 to
+// its own /title1.html, on localhost to 127.0.0.1's /title2.html, another
+// host, as a sign-in page does.
+std::unique_ptr<net::test_server::HttpResponse> SendTheFrontPageOn(
+    const net::test_server::HttpRequest& request) {
+  if (request.relative_url != "/") {
+    return nullptr;
+  }
+  const auto host = request.headers.find("Host");
+  const bool on_localhost = host != request.headers.end() &&
+                            base::StartsWith(host->second, "localhost");
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  response->set_code(net::HTTP_MOVED_PERMANENTLY);
+  response->AddCustomHeader(
+      "Location", on_localhost
+                      ? request.base_url.Resolve("/title2.html").spec()
+                      : std::string("/title1.html"));
+  return response;
+}
