+// sidebar Y54 (GitHub issue 45, a comment on 0.4.0 beta 8): every window has
+// the corner's buttons, a second one too -- New Window, Move Tab to New
+// Window -- and shows them while the pointer is in its corner. A window whose
+// frame hid its own buttons without the corner's could only be closed by
+// dragging its tab back to the first.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, ASecondWindowHasTheCornersButtons) {
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Page("a.test", "/title1.html")));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Page("b.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+
+  const auto check = [&](BrowserWindowInterface* window) {
+    BrowserView* const view = BrowserView::GetBrowserViewForBrowser(window);
+    ASSERT_TRUE(view);
+    views::Widget* const widget = view->GetWidget();
+    const auto* const frame = static_cast<const BrowserFrameViewWin*>(
+        view->browser_widget()->GetFrameView());
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget);
+      const stedding::WindowCornerButtons* const corner =
+          view->stedding_corner_buttons_for_testing();
+      return !frame->caption_button_container_for_testing()->GetVisible() &&
+             corner && corner->wanted();
+    })) << "the frame's buttons are hidden and the corner has none";
+    stedding::WindowCornerButtons* const corner =
+        view->stedding_corner_buttons_for_testing();
+    EXPECT_EQ(view->width(), corner->bounds().right());
+    ui::test::EventGenerator generator(views::GetRootWindow(widget),
+                                       widget->GetNativeWindow());
+    gfx::Point in_corner = corner->bounds().CenterPoint();
+    views::View::ConvertPointToScreen(view, &in_corner);
+    generator.MoveMouseTo(in_corner);
+    EXPECT_TRUE(base::test::RunUntil([&]() { return corner->GetVisible(); }))
+        << "the pointer in the corner did not show the buttons";
+  };
+  {
+    SCOPED_TRACE("the first window");
+    ASSERT_NO_FATAL_FAILURE(check(browser()));
+  }
+  {
+    SCOPED_TRACE("New Window");
+    ui_test_utils::BrowserCreatedObserver created;
+    chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+    BrowserWindowInterface* const second = created.Wait();
+    ASSERT_TRUE(second);
+    ASSERT_NO_FATAL_FAILURE(check(second));
+  }
+  {
+    SCOPED_TRACE("Move Tab to New Window");
+    ui_test_utils::BrowserCreatedObserver created;
+    chrome::ExecuteCommand(browser(), IDC_MOVE_TAB_TO_NEW_WINDOW);
+    BrowserWindowInterface* const moved = created.Wait();
+    ASSERT_TRUE(moved);
+    ASSERT_NO_FATAL_FAILURE(check(moved));
+  }
+  {
