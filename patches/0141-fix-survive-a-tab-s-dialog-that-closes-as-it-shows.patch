diff --git a/chrome/browser/ui/views/peek/peek_overlay.cc b/chrome/browser/ui/views/peek/peek_overlay.cc
index 35af59ce585a1..37fc90a8c8955 100644
--- a/chrome/browser/ui/views/peek/peek_overlay.cc
+++ b/chrome/browser/ui/views/peek/peek_overlay.cc
@@ -536,7 +536,13 @@ bool PeekOverlay::Show() {
   dialog->close_on_navigate = true;
   dialog->get_dialog_bounds = base::BindRepeating(
       &PeekOverlay::PageBoundsInScreen, base::Unretained(this));
+  // tabs R67 (GitHub issue 82): a close while the widget shows is synchronous,
+  // and takes this with it (OnWidgetClosed). Such a peek did open.
+  const base::WeakPtr<PeekOverlay> alive = weak_factory_.GetWeakPtr();
   manager->ShowDialog(widget_.get(), std::move(dialog));
+  if (!alive) {
+    return true;
+  }
   view_->UpdateSplit(CanSplit());
   page_->Focus();
   return true;
