+// pins H14 (BACKLOG S-271, the owner on 0.3.0 beta 4 and beta 5): a loose
+// tab's row dragged up over the Clear line joins the Space's pinned run as a
+// pin, at the place it was dropped, and every pin stays a pin above the line;
+// a pin's row dragged under the line leaves the run, unpinned, at the place
+// it was dropped, and the pins after it stay pins. Nothing decided the pin at
+// the drop: the dragged tab stayed loose among the pins, and the sidebar drew
+// the line above the first loose row, so the run's last pin showed under it.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest,
+                       ARowDraggedAcrossTheLineTakesThePinThere) {
+  tabs::TabInterface* const a = tabs().GetActiveTab();
+  model().SetSpacePinned(a, true);
+  tabs::TabInterface* const b = AddBlankTab();
+  model().SetSpacePinned(b, true);
+  tabs::TabInterface* const c = AddBlankTab();
+  model().SetSpacePinned(c, true);
+  tabs::TabInterface* const loose = AddBlankTab();
+  // A row that stays under the line throughout, so the line is drawn.
+  tabs::TabInterface* const tail = AddBlankTab();
+  tabs::TabInterface* const last = AddBlankTab();
+  ASSERT_TRUE(IsAboveTheLine(c));
+  ASSERT_FALSE(IsAboveTheLine(loose));
+  stedding::test::KeepAboveOtherWindows(widget());
+
+  // Every row of `pins` a pin above the line, and every row of `rows` loose
+  // under it; the strip's order is the order of `order`.
+  const auto expect = [&](const std::vector<const tabs::TabInterface*>& pins,
+                          const std::vector<const tabs::TabInterface*>& rows,
+                          const std::vector<const tabs::TabInterface*>& order) {
+    for (const tabs::TabInterface* const tab : pins) {
+      EXPECT_TRUE(model().IsSpacePinned(tab)) << "row " << Index(tab);
+      EXPECT_TRUE(IsAboveTheLine(tab)) << "row " << Index(tab);
+    }
+    for (const tabs::TabInterface* const tab : rows) {
+      EXPECT_FALSE(model().IsSpacePinned(tab)) << "row " << Index(tab);
+      EXPECT_FALSE(IsAboveTheLine(tab)) << "row " << Index(tab);
+    }
+    for (size_t i = 1; i < order.size(); ++i) {
+      EXPECT_EQ(Index(order[i - 1]) + 1, Index(order[i])) << "place " << i;
+    }
+  };
+  // A press on `tab`'s row and a drag in steps to `to`, the window laying
+  // out between two, then the release there, as a person's drag goes. With
+  // `then`, the drag goes on to where it says once the rows have made room
+  // for the dragged one, and the release is there: a person aims at the
+  // rows as they are drawn by then.
+  const auto drag_row_to =
+      [&](const tabs::TabInterface* tab, const gfx::Point& to,
+          const base::RepeatingCallback<gfx::Point()>& then) {
+        ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+        views::test::RunScheduledLayout(widget());
+        const TabView* const row =
+            stedding::test::FindDrawnRow(widget()->GetRootView(), tab);
+        ASSERT_TRUE(row) << "the sidebar shows no row for the tab";
+        gfx::Point from = row->GetBoundsInScreen().CenterPoint();
+        stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed,
+                                      from);
+        gfx::Point target = to;
+        for (int pass = 0; pass < (then ? 2 : 1); ++pass) {
+          constexpr int kSteps = 20;
+          for (int i = 1; i <= kSteps; ++i) {
+            stedding::test::SendLeftMouse(
+                widget(), ui::EventType::kMouseDragged,
+                gfx::Point(from.x() + (target.x() - from.x()) * i / kSteps,
+                           from.y() + (target.y() - from.y()) * i / kSteps));
+            EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+          }
+          from = target;
+          if (then) {
+            target = then.Run();
+          }
+        }
+        stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased,
+                                      from);
+        base::RunLoop().RunUntilIdle();
+        EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+      };
+  // The middle of the room between `upper`'s row and `lower`'s, as drawn
+  // when asked: during a drag, the dragged row's place.
+  const auto between = [&](const tabs::TabInterface* upper,
+                           const tabs::TabInterface* lower) {
+    return base::BindLambdaForTesting([this, upper, lower]() {
+      EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+      views::test::RunScheduledLayout(widget());
+      const TabView* const top =
+          stedding::test::FindDrawnRow(widget()->GetRootView(), upper);
+      const TabView* const bottom =
+          stedding::test::FindDrawnRow(widget()->GetRootView(), lower);
+      EXPECT_TRUE(top && bottom) << "the sidebar shows no row for a tab";
+      return top && bottom
+                 ? gfx::Point(top->GetBoundsInScreen().CenterPoint().x(),
+                              (top->GetBoundsInScreen().bottom() +
+                               bottom->GetBoundsInScreen().y()) /
+                                  2)
+                 : gfx::Point();
+    });
+  };
+
+  {
+    SCOPED_TRACE("a loose row dropped between the second and third pins");
+    ASSERT_NO_FATAL_FAILURE(
+        drag_row_to(loose, JustInsideTheTopOf(c), between(b, c)));
+    expect({a, b, loose, c}, {tail, last}, {a, b, loose, c, tail, last});
+  }
+  {
+    SCOPED_TRACE("a pin dropped between two rows under the line");
+    ASSERT_NO_FATAL_FAILURE(
+        drag_row_to(b, JustInsideTheTopOf(last), between(tail, last)));
+    expect({a, loose, c}, {tail, b, last}, {a, loose, c, tail, b, last});
+  }
+  {
+    // Between the run's last pin and the first row under the line, the
+    // row's middle over the line's: just under the last pin's row.
+    SCOPED_TRACE("a loose row dropped on the line joins the run's end");
+    views::test::RunScheduledLayout(widget());
+    const TabView* const row_c =
+        stedding::test::FindDrawnRow(widget()->GetRootView(), c);
+    ASSERT_TRUE(row_c);
+    const gfx::Rect bounds = row_c->GetBoundsInScreen();
+    ASSERT_NO_FATAL_FAILURE(drag_row_to(
+        tail, gfx::Point(bounds.CenterPoint().x(), bounds.bottom() + 3),
+        base::NullCallback()));
+    expect({a, loose, c, tail}, {b, last}, {a, loose, c, tail, b, last});
+  }
+}
