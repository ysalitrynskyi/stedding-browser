+    EXPECT_FALSE(tabstrip()->MoveFolderInto(p1, p2, 0));
+    // D4 is four deep, and P1 spans two levels: P2 would be six down.
+    EXPECT_FALSE(tabstrip()->CanMoveFolderInto(p1, d4));
+    EXPECT_FALSE(tabstrip()->MoveFolderInto(p1, d4, 0)) << "past the cap";
+    EXPECT_EQ(top, d1->GetParentCollection());
+    EXPECT_EQ(d3, d4->GetParentCollection());
+    EXPECT_EQ(top, p1->GetParentCollection());
+    EXPECT_EQ(p1, p2->GetParentCollection());
+    EXPECT_EQ(0, tabstrip()->GetIndexOfTab(x));
+    EXPECT_EQ(1, tabstrip()->GetIndexOfTab(y));
+    EXPECT_EQ(2, tabstrip()->GetIndexOfTab(z));
+  }
