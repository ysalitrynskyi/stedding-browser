+  }
+
+ protected:
+  void SetUpOnMainThread() override {
+    host_resolver()->AddRule("*", "127.0.0.1");
+    report_server_.RegisterRequestHandler(base::BindRepeating(
+        &CertificateReportsTest::OnReport, base::Unretained(this)));
+    report_server_.StartAcceptingConnections();
+    https_.RegisterRequestMonitor(base::BindRepeating(
+        &CertificateReportsTest::OnRequest, base::Unretained(this)));
+    https_.AddDefaultHandlers(GetChromeTestDataDir());
+    ASSERT_TRUE(https_.Start());
+
+    scoped_refptr<net::X509Certificate> certificate =
+        net::CreateCertificateChainFromFile(net::GetTestCertsDirectory(),
+                                            "ct-test-embedded-cert.pem",
+                                            net::X509Certificate::FORMAT_AUTO);
+    ASSERT_TRUE(certificate);
+    net::CertVerifyResult verified;
+    verified.verified_cert = certificate;
+    verified.is_issued_by_known_root = true;
+    AddScts(&verified.scts);
+    mock_cert_verifier()->set_default_result(net::OK);
+    for (const char* host : {"a.test", "b.test"}) {
+      mock_cert_verifier()->AddResultForCertAndHost(
+          https_.GetCertificate().get(), host, verified, net::OK);
+    }
+    CertVerifierBrowserTest::SetUpOnMainThread();
+
+    // A report goes out at once instead of after Chromium's first delay of
+    // 30 seconds, so the visit below would be seen at once too.
+    content::GetNetworkService()->BindTestInterfaceForTesting(
+        network_service_test_.BindNewPipeAndPassReceiver());
+    base::test::TestFuture<void> set;
+    network_service_test_->SetSCTAuditingRetryDelay(base::TimeDelta(),
+                                                    set.GetCallback());
+    ASSERT_TRUE(set.Wait());
+  }
+
+  network::mojom::SCTAuditingMode Mode() {
+    SCTReportingService* const service =
+        SCTReportingServiceFactory::GetForBrowserContext(GetProfile());
+    EXPECT_TRUE(service);
+    return service ? service->GetReportingMode()
+                   : network::mojom::SCTAuditingMode::kDisabled;
+  }
+
+  // The report server answers on its own thread, which wakes this one.
+  void WaitForReports(size_t count) {
+    while (true) {
+      base::RunLoop run_loop;
+      {
+        base::AutoLock lock(lock_);
+        if (reports_.size() >= count) {
+          return;
+        }
+        report_arrived_ = run_loop.QuitClosure();
+      }
+      run_loop.Run();
+    }
+  }
+
+  // A page's favicon is fetched once the page has loaded, over a connection
+  // of its own, so reporting switched on before that request would see its
+  // connection, and the cache, which keys a report on its SCTs alone, would
+  // drop the next site's (S-365). The test server sees each request on its
+  // own thread, which wakes this one.
+  void WaitForRequest(const std::string& host, const std::string& path) {
+    const std::string wanted = host + path;
+    while (true) {
+      base::RunLoop run_loop;
+      {
+        base::AutoLock lock(lock_);
+        if (std::ranges::contains(requests_, wanted)) {
+          return;
+        }
+        request_arrived_ = run_loop.QuitClosure();
+      }
+      run_loop.Run();
+    }
+  }
+
+  std::vector<std::string> ReportedHosts() {
+    base::AutoLock lock(lock_);
+    std::vector<std::string> hosts;
+    for (const std::string& report : reports_) {
+      sct_auditing::SCTClientReport parsed;
+      if (!parsed.ParseFromString(report) ||
+          parsed.certificate_report_size() == 0) {
+        hosts.push_back("(a request that is not a report)");
+        continue;
+      }
+      hosts.push_back(
+          parsed.certificate_report(0).context().origin().hostname());
+    }
+    return hosts;
+  }
+
+  net::EmbeddedTestServer https_{net::EmbeddedTestServer::TYPE_HTTPS};
+
+ private:
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    const auto host = request.headers.find("Host");
+    if (host == request.headers.end()) {
+      return;
+    }
+    base::AutoLock lock(lock_);
+    requests_.push_back(net::HostPortPair::FromString(host->second).host() +
+                        request.relative_url);
+    if (request_arrived_) {
+      std::move(request_arrived_).Run();
+    }
+  }
+
+  std::unique_ptr<net::test_server::HttpResponse> OnReport(
+      const net::test_server::HttpRequest& request) {
+    {
+      base::AutoLock lock(lock_);
+      reports_.push_back(request.has_content ? request.content
+                                             : request.relative_url);
+      if (report_arrived_) {
+        std::move(report_arrived_).Run();
+      }
+    }
+    auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+    response->set_code(net::HTTP_OK);
+    return response;
+  }
+
+  net::EmbeddedTestServer report_server_{net::EmbeddedTestServer::TYPE_HTTPS};
+  mojo::Remote<network::mojom::NetworkServiceTest> network_service_test_;
+  base::Lock lock_;
+  std::vector<std::string> reports_;
+  base::OnceClosure report_arrived_;
+  std::vector<std::string> requests_;
+  base::OnceClosure request_arrived_;
+};
+
+IN_PROC_BROWSER_TEST_F(CertificateReportsTest, NoCertificateIsReported) {
+  ASSERT_TRUE(SystemNetworkContextManager::IsCertificateTransparencyEnabled());
+  PrefService* const prefs = GetProfile()->GetPrefs();
+  {
+    // With Safe Browsing on, Chromium would look each sampled certificate up
+    // at Google, then report it.
+    SCOPED_TRACE("Safe Browsing on");
+    prefs->SetBoolean(prefs::kSafeBrowsingEnabled, true);
+    EXPECT_EQ(network::mojom::SCTAuditingMode::kDisabled, Mode());
+  }
+  {
+    // With the user's extra reporting on, it would report straight away.
+    SCOPED_TRACE("Safe Browsing's extra reporting on");
+    if (base::FeatureList::IsEnabled(
+            safe_browsing::kExtendedReportingRemovePrefDependency)) {
+      prefs->SetBoolean(prefs::kSafeBrowsingEnhanced, true);
+    } else {
+      prefs->SetBoolean(prefs::kSafeBrowsingScoutReportingEnabled, true);
+    }
+    EXPECT_EQ(network::mojom::SCTAuditingMode::kDisabled, Mode());
+  }
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), https_.GetURL("a.test", "/title1.html")));
+  WaitForRequest("a.test", "/favicon.ico");
+  {
+    // The proof that nothing went: switched on below Stedding's settings,
+    // in the network service itself, the reports arrive at this test's
+    // server, and the first one is the next site's.
+    SCOPED_TRACE("the visit before was never reported");
+    GetProfile()->GetDefaultStoragePartition()->GetNetworkContext()
+        ->SetSCTAuditingMode(
+            network::mojom::SCTAuditingMode::kEnhancedSafeBrowsingReporting);
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), https_.GetURL("b.test", "/title1.html")));
+    WaitForReports(1);
+    EXPECT_EQ(std::vector<std::string>{"b.test"}, ReportedHosts());
+  }
+}
+
+}  // namespace
