+    return browser_view()->stedding_top_row_reveal();
+  }
+  tabs::VerticalTabStripStateController* controller() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  bool RowShows() { return browser_view()->IsToolbarVisible(); }
+
+  void Settle() {
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+    views::test::RunScheduledLayout(widget());
+  }
+
+  // Closes the sidebar to `form` (the rail or nothing), the setting on.
+  void CloseTo(int form) {
+    prefs()->SetInteger(stedding::prefs::kSidebarClosedForm, form);
+    prefs()->SetBoolean(stedding::prefs::kToolbarHideInCompact, true);
+    if (!controller()->IsCollapsed()) {
+      controller()->RequestCollapse(true);
+    }
+    Settle();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return !RowShows();
+    })) << "the row stayed with the sidebar closed";
+    // The page takes the window's top, past the card's gutter beside the
+    // rail. On Windows the frame gives its caption buttons up a turn later.
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return Page().y() ==
+             VerticalTabStripRegionView::SteddingCardGutter(browser_view());
+    })) << "the page does not take the window's top: it starts at "
+        << Page().y();
+  }
+
+  // `view`'s bounds in the browser view.
+  gfx::Rect InWindow(views::View* view) {
+    gfx::Point origin;
+    views::View::ConvertPointToTarget(view, browser_view(), &origin);
+    return gfx::Rect(origin, view->size());
+  }
+  gfx::Rect Page() { return InWindow(browser_view()->contents_container()); }
+
+  // The pointer at `point`, in the browser view, as the window hears it.
+  void MoveTo(ui::test::EventGenerator& generator, gfx::Point point) {
+#if BUILDFLAG(IS_MAC)
+    // The reveal hears the window's pointer through the application's event
+    // monitor, which sees only what NSApp sends on, as a real pointer goes.
+    generator.set_target(ui::test::EventGenerator::Target::APPLICATION);
+#endif
+    views::View::ConvertPointToScreen(browser_view(), &point);
+    generator.MoveMouseTo(point);
+    base::RunLoop().RunUntilIdle();
+  }
+
+  // Waits a little longer than the rest at the edge takes.
+  void PastTheRest() {
+    base::RunLoop loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, loop.QuitClosure(),
+        reveal()->Rest() + base::Milliseconds(200));
+    loop.Run();
+    views::test::RunScheduledLayout(widget());
+  }
+
+  // Brings the row in from the window's top, over the page's middle.
+  void RevealFromTheTop(ui::test::EventGenerator& generator) {
+    MoveTo(generator, gfx::Point(Page().CenterPoint().x(), 0));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return RowShows() && reveal()->OverPage() && reveal()->Shown() == 1;
+    })) << "the rest at the window's top did not bring the row in";
+  }
+};
+
+// toolbar T64, T8, T10, T11: with the setting on, closing the sidebar hides
+// the row, to the rail or to nothing, and the page takes the window's top;
+// opening it brings the row back. Shift-Cmd-D and a localhost page keep the
+// row, as they keep it from "Hide the address row with the sidebar". Off,
+// the row stays as before.
+IN_PROC_BROWSER_TEST_F(CompactRowTest, TheRowHidesWithTheClosedSidebar) {
+  ASSERT_FALSE(prefs()->GetBoolean(stedding::prefs::kToolbarHideInCompact))
+      << "on by default";
+  prefs()->SetInteger(stedding::prefs::kSidebarClosedForm,
+                      stedding::prefs::kSidebarClosedHidden);
+  controller()->RequestCollapse(true);
+  Settle();
+  EXPECT_TRUE(RowShows()) << "the setting off hid the row";
+  controller()->RequestCollapse(false);
+  Settle();
+
+  for (const int form : {stedding::prefs::kSidebarClosedToIcons,
+                         stedding::prefs::kSidebarClosedHidden}) {
+    SCOPED_TRACE(form == stedding::prefs::kSidebarClosedHidden ? "hidden"
+                                                               : "the rail");
+    ASSERT_NO_FATAL_FAILURE(CloseTo(form));
+    EXPECT_FALSE(browser_view()->toolbar()->IsDrawn());
+#if BUILDFLAG(IS_WIN)
+    // The caption buttons go to the window's corner over the page.
+    const auto* const frame = static_cast<const BrowserFrameViewWin*>(
+        browser_view()->browser_widget()->GetFrameView());
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      const stedding::WindowCornerButtons* const corner =
+          browser_view()->stedding_corner_buttons_for_testing();
+      return !frame->caption_button_container_for_testing()->GetVisible() &&
+             corner && corner->wanted();
+    })) << "the window's buttons did not go to the corner";
+#endif
+    controller()->RequestCollapse(false);
+    Settle();
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return RowShows();
+    })) << "the open sidebar did not bring the row back";
+#if BUILDFLAG(IS_WIN)
+    EXPECT_TRUE(frame->caption_button_container_for_testing()->GetVisible());
+#endif
+  }
+
+  // Shift-Cmd-D shows it for the window while the sidebar is closed (T10).
+  ASSERT_NO_FATAL_FAILURE(CloseTo(stedding::prefs::kSidebarClosedHidden));
+  ASSERT_TRUE(
+      chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return RowShows();
+  })) << "Shift-Cmd-D did not show the row";
+  EXPECT_FALSE(reveal()->OverPage()) << "shown by hand, it is in its place";
+  controller()->RequestCollapse(false);
+  Settle();
+
+  // A localhost page keeps it (T11).
+  ASSERT_NO_FATAL_FAILURE(CloseTo(stedding::prefs::kSidebarClosedHidden));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("localhost", "/title1.html")));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return RowShows();
+  })) << "the localhost page lost its row";
+
+  // The setting off brings it back at once.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return !RowShows();
+  }));
+  prefs()->SetBoolean(stedding::prefs::kToolbarHideInCompact, false);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return RowShows();
+  })) << "the setting off left the row hidden";
+}
+
+// toolbar T64: a rest at the window's top edge brings the row in over the
+// page, which does not move; it is drawn over the page, stays while the
+// pointer is on it, and goes when the pointer leaves for the page. The edge
+// is a sixth of "Edge that shows a hidden sidebar", 2 DIP at the least, and
+// the rest that setting's and 200 ms more (sidebar Y39). Crossing the edge
+// without the rest, a press during it, the row under it and the rail's
+// column bring nothing.
+IN_PROC_BROWSER_TEST_F(CompactRowTest, TheTopEdgeBringsTheRowOverThePage) {
+  EXPECT_EQ(2, reveal()->Edge());
+  EXPECT_EQ(base::Milliseconds(300), reveal()->Rest());
+  prefs()->SetInteger(stedding::prefs::kSidebarRevealEdgeWidth, 24);
+  EXPECT_EQ(4, reveal()->Edge());
+  prefs()->SetInteger(stedding::prefs::kSidebarRevealEdgeWidth, 12);
+  prefs()->SetInteger(stedding::prefs::kSidebarRevealDelayMs, 0);
+  EXPECT_EQ(base::Milliseconds(200), reveal()->Rest());
+
+  ASSERT_NO_FATAL_FAILURE(CloseTo(stedding::prefs::kSidebarClosedHidden));
+  ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                     widget()->GetNativeWindow());
+  const gfx::Rect page = Page();
+  ASSERT_EQ(0, page.y());
+  const int x = page.CenterPoint().x();
+
+  // Under the edge: the page's own top.
+  MoveTo(generator, gfx::Point(x, reveal()->Edge() + 1));
+  PastTheRest();
+  EXPECT_FALSE(RowShows()) << "the page's top brought the row in";
+  // Crossing the edge without resting.
+  MoveTo(generator, gfx::Point(x, 0));
+  MoveTo(generator, page.CenterPoint());
+  PastTheRest();
+  EXPECT_FALSE(RowShows()) << "a pointer crossing the edge brought it in";
+  // A press during the rest drops it.
+  MoveTo(generator, gfx::Point(x, 0));
+  generator.PressLeftButton();
+  generator.ReleaseLeftButton();
+  PastTheRest();
+  EXPECT_FALSE(RowShows()) << "a press during the rest did not drop it";
+  MoveTo(generator, page.CenterPoint());
+
+  // The rest brings it in, over the page, which stays where it was.
+  ASSERT_NO_FATAL_FAILURE(RevealFromTheTop(generator));
+  views::View* const top = browser_view()->top_container();
+  EXPECT_EQ(page, Page()) << "the page moved under the row";
+  // BACKLOG S-543: the row's buttons end inside it. Laid out as for a row
+  // the field's margins wider, the menu ended past it, under the window's
+  // buttons at the corner on Windows.
+  views::View* const menu =
+      browser_view()->toolbar()->app_menu_button_for_testing();
+  ASSERT_TRUE(menu && menu->IsDrawn());
+  EXPECT_LE(InWindow(menu).right(), InWindow(browser_view()->toolbar()).right())
+      << "the row's menu runs past the row";
+  EXPECT_EQ(0, InWindow(top).y());
+  EXPECT_TRUE(browser_view()->toolbar()->IsDrawn());
+  EXPECT_GT(InWindow(browser_view()->toolbar()).bottom(), page.y())
+      << "the row is not over the page";
+  EXPECT_TRUE(top->layer()) << "the row is not on a layer over the page";
+  {
+    const views::View::Views order = browser_view()->GetChildrenInZOrder();
+    const auto at = [&](views::View* view) {
+      return std::find(order.begin(), order.end(), view) - order.begin();
+    };
+    EXPECT_GT(at(top), at(browser_view()->multi_contents_view()))
+        << "the page is drawn over the row";
+  }
+  // On it, it stays; on the page, it goes.
+  MoveTo(generator, InWindow(browser_view()->toolbar()).CenterPoint());
+  PastTheRest();
+  EXPECT_TRUE(RowShows()) << "the row went with the pointer on it";
+  MoveTo(generator, page.CenterPoint());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return !RowShows() && !reveal()->OverPage();
+  })) << "the row stayed with the pointer on the page";
+  EXPECT_FALSE(top->layer());
+  EXPECT_EQ(page, Page());
+
+  // The rail's column has its own top; the page's column has the edge.
+  ASSERT_NO_FATAL_FAILURE(CloseTo(stedding::prefs::kSidebarClosedToIcons));
+  VerticalTabStripRegionView* const strip =
+      browser_view()->vertical_tab_strip_region_view_for_testing();
+  MoveTo(generator, gfx::Point(InWindow(strip).CenterPoint().x(), 0));
+  PastTheRest();
+  EXPECT_FALSE(RowShows()) << "the rail's top brought the row in";
+  ASSERT_NO_FATAL_FAILURE(RevealFromTheTop(generator));
+  EXPECT_EQ(VerticalTabStripRegionView::SteddingCardGutter(browser_view()),
+            Page().y())
+      << "beside the rail the page moved under the row";
+  MoveTo(generator, Page().CenterPoint());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return !RowShows();
+  }));
+}
+
+// toolbar T64, T61: the bookmarks bar is part of the address row's surface.
+// With the setting on it hides with the row while the sidebar is closed, the
+// page taking the window's top; it comes in over the page with the row, and
+// it is back in its place once the sidebar opens.
+IN_PROC_BROWSER_TEST_F(CompactRowTest, TheBookmarksBarGoesWithTheRow) {
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(browser()->GetProfile());
+  bookmarks::test::WaitForBookmarkModelToLoad(model);
+  model->AddURL(model->bookmark_bar_node(), 0, u"Example",
+                GURL("https://example.com/"));
+  BookmarkBarController* const bar = BookmarkBarController::From(browser());
+  ASSERT_TRUE(bar);
+  if (bar->bookmark_bar_state() != BookmarkBar::SHOW) {
+    chrome::ExecuteCommand(browser(), IDC_SHOW_BOOKMARK_BAR);
+  }
+  const auto bar_shows = [&]() {
+    views::test::RunScheduledLayout(widget());
+    return !browser_view()->IsBookmarkBarAnimating() &&
+           bar->bookmark_bar_state() == BookmarkBar::SHOW &&
+           browser_view()->IsBookmarkBarVisible() &&
+           browser_view()->bookmark_bar()->IsDrawn() &&
+           !browser_view()->bookmark_bar()->bounds().IsEmpty();
+  };
+  ASSERT_TRUE(base::test::RunUntil(bar_shows))
+      << "the premise: the bookmarks bar shows";
+
+  ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                     widget()->GetNativeWindow());
+  for (const int form : {stedding::prefs::kSidebarClosedToIcons,
+                         stedding::prefs::kSidebarClosedHidden}) {
+    SCOPED_TRACE(form == stedding::prefs::kSidebarClosedHidden ? "hidden"
+                                                               : "the rail");
+    // CloseTo also checks that the page takes the window's top.
+    ASSERT_NO_FATAL_FAILURE(CloseTo(form));
+    EXPECT_FALSE(browser_view()->IsBookmarkBarVisible())
+        << "the bar stayed with the row hidden";
+    EXPECT_FALSE(browser_view()->bookmark_bar()->IsDrawn());
+
+    // It comes in with the row, over the page, which does not move.
+    const gfx::Rect page = Page();
+    MoveTo(generator, page.CenterPoint());
+    ASSERT_NO_FATAL_FAILURE(RevealFromTheTop(generator));
+    EXPECT_TRUE(base::test::RunUntil(bar_shows))
+        << "the bar did not come in with the row";
+    EXPECT_EQ(page, Page()) << "the page moved under the row and the bar";
+    EXPECT_GT(InWindow(browser_view()->bookmark_bar()).bottom(), page.y())
+        << "the bar is not over the page";
+    MoveTo(generator, page.CenterPoint());
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return !RowShows() && !browser_view()->IsBookmarkBarVisible();
+    })) << "the bar stayed with the pointer on the page";
+
+    controller()->RequestCollapse(false);
+    Settle();
+    EXPECT_TRUE(base::test::RunUntil(bar_shows))
+        << "the open sidebar did not bring the bar back";
+  }
+}
+
+#if BUILDFLAG(IS_MAC)
+// toolbar T64, sidebar Y55: with the sidebar hidden the traffic lights hide
+// over the page with the row. The row brought in over the page has them on it
