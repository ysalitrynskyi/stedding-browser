+
+// The outermost folder `tab` is in, or null for a tab in no folder.
+const tabs::FolderTabCollection* OutermostFolder(
+    const tabs::TabInterface* tab) {
+  const tabs::FolderTabCollection* top = nullptr;
+  for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+       each = each->GetParentCollection()) {
+    if (each->type() == tabs::TabCollection::Type::FOLDER) {
+      top = static_cast<const tabs::FolderTabCollection*>(each);
+    }
+  }
+  return top;
+}
+
+// The ids of the folders `tab` is in, outermost first.
+std::vector<std::string> FolderIdsOf(const tabs::TabInterface* tab) {
+  std::vector<std::string> ids;
+  for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+       each = each->GetParentCollection()) {
+    if (each->type() == tabs::TabCollection::Type::FOLDER) {
+      ids.insert(ids.begin(),
+                 static_cast<const tabs::FolderTabCollection*>(each)
+                     ->id()
+                     .ToString());
+    }
+  }
+  return ids;
+}
+
+// Every folder under `collection`, at any depth, by id. The strip hands out
+// its tree read-only; the folders go back to the strip's own folder calls.
+void CollectFolders(const tabs::TabCollection* collection,
+                    std::map<std::string, tabs::FolderTabCollection*>* out) {
+  for (const tabs::Child& child : collection->GetChildren()) {
+    const auto* const holder =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (!holder) {
+      continue;
+    }
+    tabs::TabCollection* const nested = holder->get();
+    if (nested->type() == tabs::TabCollection::Type::FOLDER) {
+      out->emplace(static_cast<tabs::FolderTabCollection*>(nested)
+                       ->id()
+                       .ToString(),
+                   static_cast<tabs::FolderTabCollection*>(nested));
+    }
+    CollectFolders(nested, out);
+  }
+}
+
+std::map<std::string, tabs::FolderTabCollection*> FoldersById(
+    const TabStripModel& strip) {
+  std::map<std::string, tabs::FolderTabCollection*> folders;
+  CollectFolders(strip.Root(), &folders);
+  return folders;
+}
+
+// The unpinned block, where top-level folders live.
+tabs::TabCollection* UnpinnedBlock(const TabStripModel& strip) {
+  for (const tabs::Child& child : strip.Root()->GetChildren()) {
+    const auto* const holder =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (holder &&
+        holder->get()->type() == tabs::TabCollection::Type::UNPINNED) {
+      return holder->get();
+    }
+  }
+  return nullptr;
+}
+
+// The indices of `tab` and of a split's other pane: a split moves whole.
+std::vector<int> IndicesMovingWith(const TabStripModel& strip,
+                                   const tabs::TabInterface& tab) {
+  std::vector<int> indices;
+  if (const std::optional<split_tabs::SplitTabId> split = tab.GetSplit()) {
+    for (const tabs::TabInterface* const pane :
+         strip.GetSplitData(*split)->ListTabs()) {
+      indices.push_back(strip.GetIndexOfTab(pane));
+    }
+    std::ranges::sort(indices);
+  } else {
+    indices.push_back(strip.GetIndexOfTab(&tab));
+  }
+  return indices;
+}
+
+// A row of a folder or of the run: a tab, or a collection (a split, a folder).
+using Node = std::variant<tabs::TabInterface*, const tabs::TabCollection*>;
+
+Node NodeOf(const tabs::Child& child) {
+  if (const auto* const tab = std::get_if<tabs::ScopedTab>(&child)) {
+    return tab->get();
+  }
+  return static_cast<const tabs::TabCollection*>(
+      std::get<std::unique_ptr<tabs::TabCollection>>(child).get());
+}
+
+const tabs::TabInterface* FirstTabOf(const Node& node) {
+  if (const auto* const tab = std::get_if<tabs::TabInterface*>(&node)) {
+    return *tab;
+  }
+  const std::vector<tabs::TabInterface*> tabs =
+      std::get<const tabs::TabCollection*>(node)->GetTabsRecursive();
+  return tabs.empty() ? nullptr : tabs.front();
+}
+
+void AppendOnce(std::vector<Node>& nodes, const Node& node) {
+  if (std::ranges::find(nodes, node) == nodes.end()) {
+    nodes.push_back(node);
+  }
+}
+
+bool InFolder(const tabs::TabInterface* tab) {
+  return OutermostFolder(tab) != nullptr;
+}
+
+// windows G15: a tab that has no page loaded: discarded, or brought back by a
+// restore and never shown.
+bool Asleep(tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab->GetContents();
+  return contents &&
+         (contents->WasDiscarded() || contents->GetController().NeedsReload());
+}
+
+// Whether every turn of a fill is suspended: the tokens are given out first,
+// then every window settles.
+bool g_filling = false;
+
+bool g_disabled_for_testing = false;
