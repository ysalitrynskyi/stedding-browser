+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-stedding-routes-card' is the one list of routes
+ * (docs/features/routing.md D12-D14): the Space for links from other apps,
+ * then every rule of stedding.spaces.routes in the order that decides, each
+ * edited where it is listed, and a row that adds one.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import '../controls/settings_dropdown_menu.js';
+
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './stedding_routes_card.css.js';
+import {getHtml} from './stedding_routes_card.html.js';
+
+/** One rule of the preference. `spaceName` is '' when it names no Space. */
+export interface SteddingRouteRule {
+  match: string;
+  pattern: string;
+  space: string;
+  spaceName: string;
+}
+
+/** One Space of the profile, as the card names it. */
+export interface SteddingRouteSpace {
+  id: string;
+  name: string;
+}
+
+export interface SteddingRoutes {
+  rules: SteddingRouteRule[];
+  spaces: SteddingRouteSpace[];
+  // The Space on screen, first in the add row (routing D12).
+  active: string;
+}
+
+// routing D12: the two kinds a person makes. The others are read, and kept,
+// when a rule has one (D13).
+const ADDED_KINDS = ['site', 'contains'];
+
+const KIND_NAMES: {[match: string]: string} = {
+  'site': 'steddingRouteKindSite',
+  'contains': 'steddingRouteKindContains',
+  'equals': 'steddingRouteKindEquals',
+  'host': 'steddingRouteKindHost',
+  'host-suffix': 'steddingRouteKindHostSuffix',
+};
+
+const SettingsSteddingRoutesCardElementBase =
+    WebUiListenerMixinLit(CrLitElement);
+
+export class SettingsSteddingRoutesCardElement extends
+    SettingsSteddingRoutesCardElementBase {
+  static get is() {
+    return 'settings-stedding-routes-card';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      routes_: {type: Object},
+      addKind_: {type: String},
+      addSpace_: {type: String},
+      addError_: {type: String},
+      ruleErrorIndex_: {type: Number},
+      ruleError_: {type: String},
+    };
+  }
+
+  protected accessor routes_: SteddingRoutes =
+      {rules: [], spaces: [], active: ''};
+  protected accessor addKind_: string = 'site';
+  // The Space chosen in the add row, '' until one is chosen.
+  protected accessor addSpace_: string = '';
+  protected accessor addError_: string = '';
+  // The row whose field says why it was refused, and what it says.
+  protected accessor ruleErrorIndex_: number = -1;
+  protected accessor ruleError_: string = '';
+
+  override connectedCallback() {
+    super.connectedCallback();
+    // routing D12: a rule made anywhere shows at once.
+    this.addWebUiListener(
+        'stedding-routes-changed',
+        (routes: SteddingRoutes) => this.routes_ = routes);
+    sendWithPromise('steddingGetRoutes').then((routes: unknown) => {
+      this.routes_ = routes as SteddingRoutes;
+    });
+  }
+
+  // The Space the add row names: the one chosen while it is still there, else
+  // the Space on screen, else the first.
+  protected chosenSpace_(): string {
+    const spaces = this.routes_.spaces;
+    if (spaces.some(space => space.id === this.addSpace_)) {
+      return this.addSpace_;
+    }
+    return spaces.some(space => space.id === this.routes_.active) ?
+        this.routes_.active :
+        spaces[0]?.id ?? '';
+  }
+
+  protected externalOptions_(): Array<{value: string, name: string}> {
+    return [
+      {
+        value: '',
+        name: loadTimeData.getString('steddingExternalActiveSpace'),
+      },
+      ...this.routes_.spaces.map(
+          space => ({value: space.id, name: space.name})),
+    ];
+  }
+
+  protected kindsFor_(rule: SteddingRouteRule): string[] {
+    return ADDED_KINDS.includes(rule.match) ? ADDED_KINDS :
+                                              [...ADDED_KINDS, rule.match];
+  }
+
+  protected kindName_(match: string): string {
+    return loadTimeData.getString(KIND_NAMES[match] ?? 'steddingRouteKindSite');
+  }
+
+  protected removeLabel_(rule: SteddingRouteRule): string {
+    return loadTimeData.getStringF('steddingRouteRemove', rule.pattern);
+  }
+
+  protected addPlaceholder_(): string {
+    return loadTimeData.getString(
+        this.addKind_ === 'contains' ? 'steddingRouteAddContainsPlaceholder' :
+                                       'steddingRouteAddPlaceholder');
+  }
+
+  // Why the text of a rule of kind `match` was refused.
+  private refusal_(match: string): string {
+    if (match === 'contains') {
+      return loadTimeData.getString('steddingRouteNeedsText');
+    }
+    return loadTimeData.getString(
+        match === 'equals' ? 'steddingRouteNotAnAddress' :
+                             'steddingCleanLinksAddInvalid');
+  }
+
+  protected onAddKindChange_(e: Event) {
+    this.addKind_ = (e.target as HTMLSelectElement).value;
+    this.addError_ = '';
+  }
+
+  protected onAddSpaceChange_(e: Event) {
+    this.addSpace_ = (e.target as HTMLSelectElement).value;
+  }
+
+  protected onAddKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter') {
+      this.onAddClick_();
+    }
+  }
+
+  // routing D12: what is refused stays in the field, which says why, and
+  // nothing is written; what is added empties it. The list follows the
+  // preference.
+  protected async onAddClick_() {
+    const input = this.shadowRoot.querySelector<CrInputElement>('#addText')!;
+    const typed = input.value.trim();
+    if (!typed) {
+      this.addError_ = '';
+      input.focus();
+      return;
+    }
+    const added = await sendWithPromise(
+        'steddingAddRouteRule', this.addKind_, typed, this.chosenSpace_());
+    if (added) {
+      input.value = '';
+      this.addError_ = '';
+    } else {
+      this.addError_ = this.refusal_(this.addKind_);
+    }
+  }
+
+  private indexOf_(e: Event): number {
+    return Number((e.currentTarget as HTMLElement).dataset['index']);
+  }
+
+  // routing D13: the whole rule goes to the browser with what it was, which
+  // names it wherever the list has moved since. A refused edit puts the field
+  // back and says why.
+  private async edit_(
+      index: number, match: string, typed: string, space: string,
+      putBack: () => void) {
+    const rule = this.routes_.rules[index];
+    const edited = await sendWithPromise(
+        'steddingUpdateRouteRule', rule.match, rule.pattern, rule.space, match,
+        typed, space);
+    if (edited) {
+      this.ruleErrorIndex_ = -1;
+      this.ruleError_ = '';
+      return;
+    }
+    putBack();
+    this.ruleErrorIndex_ = index;
+    this.ruleError_ = this.refusal_(match);
+  }
+
+  protected onKindChange_(e: Event) {
+    const index = this.indexOf_(e);
+    const rule = this.routes_.rules[index];
+    const select = e.target as HTMLSelectElement;
+    this.edit_(
+        index, select.value, rule.pattern, rule.space,
+        () => select.value = rule.match);
+  }
+
+  protected onTextChange_(e: Event) {
+    const index = this.indexOf_(e);
+    const rule = this.routes_.rules[index];
+    const input = e.target as CrInputElement;
+    if (input.value.trim() === rule.pattern) {
+      return;
+    }
+    this.edit_(
+        index, rule.match, input.value, rule.space,
+        () => input.value = rule.pattern);
+  }
+
+  protected onSpaceChange_(e: Event) {
+    const index = this.indexOf_(e);
+    const rule = this.routes_.rules[index];
+    const select = e.target as HTMLSelectElement;
+    this.edit_(
+        index, rule.match, rule.pattern, select.value,
+        () => select.value = rule.space);
+  }
+
+  protected onRemoveClick_(e: Event) {
+    const rule = this.routes_.rules[this.indexOf_(e)];
+    this.ruleErrorIndex_ = -1;
+    chrome.send(
+        'steddingRemoveRouteRule', [rule.match, rule.pattern, rule.space]);
+  }
+}
