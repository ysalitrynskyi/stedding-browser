+++ b/chrome/browser/ui/views/stedding/update_pill.h
@@ -0,0 +1,62 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_STEDDING_UPDATE_PILL_H_
+#define CHROME_BROWSER_UI_VIEWS_STEDDING_UPDATE_PILL_H_
+
+#include "base/memory/raw_ref.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/stedding/app_updater.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/controls/button/label_button.h"
+
+namespace views {
+class View;
+}
+
+namespace stedding {
+
+// updates Up3, Up4 (docs/features/updates.md): Arc's "New Arc Version
+// Available". At the sidebar's foot, above the Space row, a pill in the
+// selected tab's colours shows "New Stedding Version Available" while a later
+// version is downloaded or waits for the go-ahead, and a click restarts into
+// it. The rail shows its icon alone, with the name as its tooltip. Hidden in
+// every other state, so the sidebar's layout gives it no room.
+class UpdatePill : public views::LabelButton, public AppUpdater::Observer {
+  METADATA_HEADER(UpdatePill, views::LabelButton)
+
+ public:
+  explicit UpdatePill(AppUpdater& updater);
+  UpdatePill(const UpdatePill&) = delete;
+  UpdatePill& operator=(const UpdatePill&) = delete;
+  ~UpdatePill() override;
+
+  // The rail's form: the icon alone, centred.
+  void SetRailForm(bool rail);
+
+  // views::View:
+  void OnThemeChanged() override;
+
+  // AppUpdater::Observer:
+  void OnAppUpdaterChanged() override;
+
+ private:
+  void Refresh();
+  void OnPressed();
+
+  const raw_ref<AppUpdater> updater_;
+  bool rail_ = false;
+  base::ScopedObservation<AppUpdater, AppUpdater::Observer> observation_{this};
+};
+
+// Adds the pill to the end of `parent`'s children when the process has an
+// updater (AppUpdater::Get()); the sidebar's region calls it just before its
+// Space row. Null when there is no updater.
+UpdatePill* AddUpdatePill(views::View& parent);
+// The pill AddUpdatePill put into `parent`, or null.
+UpdatePill* FindUpdatePill(views::View& parent);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_STEDDING_UPDATE_PILL_H_
