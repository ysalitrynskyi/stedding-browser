+void SidebarSyncService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SidebarSyncService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void SidebarSyncService::NotifyObservers() {
+  observers_.Notify(&Observer::OnSidebarSyncChanged);
+}
+
+void SidebarSyncService::OnFolderPrefChanged() {
+  if (enabled()) {
+    StartObserving();
+  } else {
+    StopObserving();
+  }
+  NotifyObservers();
+}
+
+void SidebarSyncService::StartObserving() {
+  if (observing_) {
+    return;
+  }
+  observing_ = true;
+  // Every window; each callback looks at this profile's alone.
+  browsers_observation_.Observe(GlobalBrowserCollection::GetInstance());
+  if (SpaceRegistry* const registry =
+          SpaceRegistryFactory::GetForProfile(profile_)) {
+    registry_observation_.Observe(registry);
+  }
+  closing_all_ = chrome::AddClosingAllBrowsersCallback(
+      base::BindRepeating(&SidebarSyncService::OnClosingAllBrowsers,
+                          base::Unretained(this)));
+  EnsureWatches();
+  seen_window_ = !watches_.empty();
+  MaybeBecomeReady();
+}
+
+void SidebarSyncService::StopObserving() {
+  observing_ = false;
+  seen_window_ = false;
+  loading_ledger_ = false;
+  ready_ = false;
+  commit_timer_.Stop();
+  scan_timer_.Stop();
+  retry_timer_.Stop();
+  poll_timer_.Stop();
+  watcher_.Reset();
+  watches_.clear();
+  browsers_observation_.Reset();
+  registry_observation_.Reset();
+  session_restored_ = {};
+  closing_all_ = {};
+  ledger_.reset();
+  last_view_.reset();
+  intents_.clear();
+  held_batches_.clear();
+  isolation_questions_.clear();
+  held_moves_.clear();
+  move_now_.clear();
+  newer_.clear();
+  clock_ahead_.clear();
+  unreadable_.clear();
+  waiting_download_.clear();
+  conflict_copies_.clear();
+  unreachable_ = denied_ = write_failed_ = watch_failed_ = false;
+  // Replies to reads and writes of the folder just left are dropped.
+  weak_factory_.InvalidateWeakPtrs();
+  scan_in_flight_ = write_in_flight_ = false;
+  for (base::OnceClosure& done : scan_done_) {
+    std::move(done).Run();
+  }
+  scan_done_.clear();
+}
+
+void SidebarSyncService::EnsureWatches() {
+  for (BrowserWindowInterface* const window :
+       sidebar_sync::RegistryWindows(profile_)) {
+    if (!watches_.contains(window)) {
+      watches_[window] =
+          std::make_unique<sidebar_sync::WindowWatch>(this, window);
+    }
+  }
+}
+
+void SidebarSyncService::OnBrowserCreated(BrowserWindowInterface* browser) {
+  if (!sidebar_sync::IsRegistryWindow(browser, profile_)) {
+    return;
+  }
+  EnsureWatches();
+  seen_window_ = true;
+  MaybeBecomeReady();
+  // Sf14: what arrived with no window open applies now.
+  if (ready_) {
+    Apply();
+  }
+}
+
+void SidebarSyncService::OnBrowserClosed(BrowserWindowInterface* browser) {
+  // Sf19: a window closing is never a removal; its edits are recorded first.
+  if (watches_.contains(browser)) {
+    if (ready_ && !closing_all_browsers_) {
+      Commit();
+    }
+    watches_.erase(browser);
+  }
+}
+
+void SidebarSyncService::OnBrowserActivated(BrowserWindowInterface* browser) {
+  if (!sidebar_sync::IsRegistryWindow(browser, profile_)) {
+    return;
+  }
+  EnsureWatches();
+  seen_window_ = true;
+  MaybeBecomeReady();
+  if (!ready_) {
+    return;
+  }
+  // Sf13: a folder that sends no events is read when Stedding comes to the
+  // front, at most every five seconds, and every ten seconds while it stays.
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (last_activation_scan_.is_null() ||
+      now - last_activation_scan_ >= sidebar_sync::kActivationScanFloor) {
+    last_activation_scan_ = now;
+    Scan();
+  }
+  if (!poll_timer_.IsRunning()) {
+    poll_timer_.Start(FROM_HERE, sidebar_sync::kPollInterval,
+                      base::BindRepeating(&SidebarSyncService::Scan,
+                                          base::Unretained(this)));
+  }
+}
+
+void SidebarSyncService::OnBrowserDeactivated(
+    BrowserWindowInterface* browser) {
+  if (!sidebar_sync::IsRegistryWindow(browser, profile_)) {
+    return;
+  }
+  // Never in the background: a share is not kept awake overnight.
+  poll_timer_.Stop();
+  if (ready_) {
+    Commit();
+  }
+}
+
+void SidebarSyncService::OnRegistryChanged() {
+  OnSidebarMaybeChanged();
+}
+
+void SidebarSyncService::OnRegistrySpaceRemoved(const SpaceId& id) {
+  // Sf18: deleting a Space is a removal; the registry is the profile's, so
+  // a window closing never comes here.
+  if (CanRecordIntent(nullptr)) {
+    NoteIntent(sidebar_sync::Canonical(Resolved(), id.ToString()));
+  }
+  OnSidebarMaybeChanged();
+}
+
+void SidebarSyncService::MaybeBecomeReady() {
+  if (!observing_ || ready_ || loading_ledger_ || !seen_window_) {
+    return;
+  }
+  // Sf14, Sf32: the folder is first opened once a window is up and session
+  // restore is over, so a system prompt shows while the user looks on.
+  if (SessionRestore::IsRestoring(profile_)) {
+    if (!session_restored_) {
+      session_restored_ = SessionRestore::RegisterOnSessionRestoredCallback(
+          base::BindRepeating(&SidebarSyncService::OnSessionRestored,
+                              base::Unretained(this)));
+    }
+    return;
+  }
+  if (ledger_) {
+    BecomeReady();
+    return;
+  }
+  loading_ledger_ = true;
+  ledger_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&sidebar_sync::ReadLedger, profile_->GetPath()),
+      base::BindOnce(&SidebarSyncService::OnLedgerLoaded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SidebarSyncService::OnSessionRestored(Profile* profile, int tabs) {
+  if (profile != profile_) {
+    return;
+  }
+  session_restored_ = {};
+  MaybeBecomeReady();
+}
+
+void SidebarSyncService::OnLedgerLoaded(std::optional<Ledger> ledger) {
+  loading_ledger_ = false;
+  if (!observing_) {
+    return;
+  }
+  if (!ledger) {
+    // The folder is set but the ledger is gone: nothing is merged without
+    // the sheet; Settings asks to choose the folder again.
+    ledger_lost_ = true;
+    NotifyObservers();
+    return;
+  }
+  ledger_ = std::move(*ledger);
+  BecomeReady();
+}
+
+void SidebarSyncService::BecomeReady() {
+  ready_ = true;
+  ledger_lost_ = false;
+  EnsureWatches();
+  last_view_.reset();
+  // Sf14: what the user changed since the ledger was last written, then the
+  // folder; a write that quitting cut short is made now.
+  Commit();
+  // Sf26: tombstones received more than 180 days ago go, once a launch;
+  // nothing waits on a decision yet.
+  if (sidebar_sync::PruneTombstones(ledger_->state,
+                                    ledger_->tombstone_received, NowMs(),
+                                    {})) {
+    ledger_->NoteTombstones(NowMs());
+    ledger_->folder_behind = true;
+  }
+  StartWatcher();
+  Scan();
+  if (ledger_->folder_behind) {
+    WriteOwnFile();
+  }
+  RefreshBackups();
+  NotifyObservers();
+}
+
+void SidebarSyncService::StartWatcher() {
+  watcher_.Reset();
+  watcher_ = base::SequenceBound<sidebar_sync::FolderWatcher>(
+      io_runner_, folder(),
+      base::BindPostTaskToCurrentDefault(
+          base::BindRepeating(&SidebarSyncService::OnFolderEvent,
+                              weak_factory_.GetWeakPtr())));
+  watcher_.AsyncCall(&sidebar_sync::FolderWatcher::watching)
+      .Then(base::BindOnce(&SidebarSyncService::OnWatchStarted,
+                           weak_factory_.GetWeakPtr()));
+}
+
+void SidebarSyncService::OnWatchStarted(bool watching) {
+  watch_failed_ = !watching;
+  NotifyObservers();
+}
+
+void SidebarSyncService::OnFolderEvent() {
+  if (!ready_) {
+    return;
+  }
+  // Sf13: about two seconds after the file changes.
+  scan_timer_.Start(FROM_HERE, sidebar_sync::kScanDelay,
+                    base::BindOnce(&SidebarSyncService::Scan,
+                                   base::Unretained(this)));
+}
+
+void SidebarSyncService::OnClosingAllBrowsers(bool closing) {
+  closing_all_browsers_ = closing;
+  if (!closing || !ready_ || !ledger_) {
+    return;
+  }
+  // Sf12, Sf19: the state as quitting starts, before the windows close one
+  // by one, which removes nothing.
+  Commit();
+  if (ledger_->folder_behind) {
+    WriteOwnFile();
+  }
+  SaveLedger();
+}
+
+void SidebarSyncService::OnWindowWillCloseAllTabs() {
+  if (ready_ && !closing_all_browsers_) {
+    Commit();
+  }
+}
+
+bool SidebarSyncService::CanRecordIntent(const TabStripModel* strip) const {
+  return ready_ && !applying_ && !closing_all_browsers_ &&
+         !(strip && strip->closing_all()) &&
+         !browser_shutdown::HasShutdownStarted() &&
+         !SessionRestore::IsRestoring(profile_);
+}
+
+void SidebarSyncService::NoteIntent(const std::string& id) {
+  if (!id.empty()) {
+    intents_.insert(id);
+  }
+}
+
+void SidebarSyncService::OnTabRemovedFromStrip(content::WebContents* contents,
+                                               TabStripModel* strip) {
+  if (!CanRecordIntent(strip) || !last_view_) {
+    return;
+  }
+  const std::string token = stedding::TabToken(contents);
+  if (token.empty()) {
+    return;
+  }
+  const std::string id =
+      sidebar_sync::Canonical(Resolved(), TabSyncId(token));
+  // A pin or an essential really closed, and every folder it was in.
+  if (last_view_->items.contains(id)) {
+    for (const std::string& each :
+         sidebar_sync::WithEnclosingFolders(*last_view_, id)) {
+      NoteIntent(each);
+    }
+  }
+}
+
+void SidebarSyncService::OnTabLeftItsRole(tabs::TabInterface* tab,
+                                          TabStripModel* strip) {
+  if (!CanRecordIntent(strip) || !last_view_) {
+    return;
+  }
+  const std::string id = sidebar_sync::SyncIdOfTab(tab, Resolved());
+  if (!id.empty() && last_view_->items.contains(id)) {
+    NoteIntent(id);
+  }
+}
+
+void SidebarSyncService::OnFolderLeftTheRun(const std::string& folder_id,
+                                            TabStripModel* strip) {
+  if (CanRecordIntent(strip)) {
+    NoteIntent(sidebar_sync::Canonical(Resolved(), folder_id));
+  }
+}
+
+void SidebarSyncService::OnActiveTabChanged(tabs::TabInterface* tab) {
+  if (!ready_ || !ledger_) {
+    return;
+  }
+  // Sf21: a pin sync put here and the user opened is theirs now.
+  const std::string id = sidebar_sync::SyncIdOfTab(tab, Resolved());
+  if (!id.empty()) {
+    ledger_->inserted_unopened.erase(id);
+  }
+  // Sf21, Sf25: what waited for the user to leave a tab applies now.
+  if (deferred_ > 0 && !applying_) {
+    Apply();
+  }
+}
+
+void SidebarSyncService::OnSidebarMaybeChanged() {
+  if (!ready_ || applying_) {
+    return;
+  }
+  // Sf12: two seconds after the last change.
+  commit_timer_.Start(FROM_HERE, sidebar_sync::kCommitDelay,
+                      base::BindOnce(&SidebarSyncService::Commit,
+                                     base::Unretained(this)));
+}
+
+void SidebarSyncService::Commit() {
+  commit_timer_.Stop();
+  if (!ready_ || !ledger_ || applying_) {
+    return;
+  }
+  const std::map<std::string, std::string> resolved = Resolved();
+  LocalView now = sidebar_sync::BuildLocalView(profile_, resolved);
+  std::set<std::string> tombstones;
+  // Sf18: a removal travels only when the user made it and the item is then
+  // in no window: a pin moved to another window, the little window or a
+  // peek, or made an essential, is a move.
+  if (!intents_.empty()) {
+    const std::set<std::string> elsewhere =
+        sidebar_sync::IdsOutsideRegistryWindows(profile_, resolved);
+    for (const std::string& id : intents_) {
+      if (!now.items.contains(id) && !elsewhere.contains(id)) {
+        tombstones.insert(id);
+      }
+    }
+    intents_.clear();
+  }
+  // Sf18: a pinned folder let go of while its tabs stay in a window here
+  // (ungrouped) is removed; one that left with its tabs is not.
+  if (last_view_ && !closing_all_browsers_) {
+    for (const auto& [id, item] : last_view_->items) {
+      if (item.kind != Kind::kFolder || now.items.contains(id)) {
+        continue;
+      }
+      for (const auto& [child, child_item] : last_view_->items) {
+        const auto parent = child_item.fields.find(sidebar_sync::kFieldParent);
+        if (child_item.kind == Kind::kTab &&
+            parent != child_item.fields.end() && parent->second == id &&
+            now.items.contains(child)) {
+          tombstones.insert(id);
+          break;
+        }
+      }
+    }
+  }
+  const std::string install =
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId);
+  const Stamp stamp{
+      sidebar_sync::NextTime(NowMs(), std::max(ledger_->hlc,
+                                               ledger_->state.MaxTime())),
+      install};
+  bool changed = sidebar_sync::RecordLocalEdits(
+      ledger_->state, last_view_ ? &*last_view_ : nullptr, now, tombstones,
+      stamp);
+  // Sf41: the same overflow rule on every computer.
+  const bool overflow =
+      sidebar_sync::MoveEssentialsPastTheCap(ledger_->state, stamp);
+  changed |= overflow;
+  last_view_ = std::move(now);
+  if (!changed) {
+    return;
+  }
+  ledger_->hlc = stamp.t;
+  ledger_->NoteTombstones(NowMs());
+  ledger_->folder_behind = true;
+  SaveLedger();
+  WriteOwnFile();
+  if (overflow) {
+    Apply();
+  }
+  NotifyObservers();
+}
+
+void SidebarSyncService::Scan() {
+  if (!ready_ || !ledger_) {
+    return;
+  }
+  // Sf13: a read still running is never queued behind; one more follows it.
+  if (scan_in_flight_) {
+    scan_again_ = true;
+    return;
+  }
+  scan_in_flight_ = true;
+  sidebar_sync::StatCache cache;
+  for (const auto& [install, stat] : ledger_->peers) {
+    cache[install] = {stat.mtime_ms, stat.size};
+  }
+  io_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&sidebar_sync::ScanOnSequence, folder(),
+                     profile_->GetPrefs()->GetString(
+                         stedding::prefs::kSidebarSyncInstallId),
+                     std::move(cache)),
+      base::BindOnce(&SidebarSyncService::OnScanned,
+                     weak_factory_.GetWeakPtr(), base::OnceClosure()));
+}
+
+void SidebarSyncService::OnScanned(base::OnceClosure done, ScanResult result) {
+  scan_in_flight_ = false;
+  if (!ready_ || !ledger_) {
+    return;
+  }
+  unreachable_ = !result.reachable;
+  denied_ = result.denied;
+  conflict_copies_.clear();
+  for (const std::string& name : result.conflict_copies) {
+    if (!ledger_->dismissed_files.contains(name)) {
+      conflict_copies_.push_back(name);
+    }
+  }
+  // Sf29: this install's own file, as the folder has it.
+  if (result.own) {
+    switch (sidebar_sync::ClassifyOwnFile(*result.own, ledger_->recent,
+                                          ledger_->seq)) {
+      case sidebar_sync::OwnFileKind::kOurs:
+        break;
+      case sidebar_sync::OwnFileKind::kEcho:
+        ledger_->folder_behind = true;
+        break;
+      case sidebar_sync::OwnFileKind::kCopy:
+        TakeNewInstallId();
+        break;
+    }
+  }
+  // The user's own edits are stamped before anything is merged.
+  Commit();
+  bool merged = false;
+  const int64_t now = NowMs();
+  for (sidebar_sync::PeerRead& peer : result.peers) {
+    sidebar_sync::PeerStat& stat = ledger_->peers[peer.install];
+    stat.mtime_ms = peer.mtime_ms;
+    stat.size = peer.size;
+    stat.read_ms = now;
+    if (!peer.parsed.meta.device.empty()) {
+      stat.device = peer.parsed.meta.device;
+    }
+    const std::string device =
+        stat.device.empty() ? peer.install : stat.device;
+    waiting_download_.erase(peer.install);
+    switch (peer.parsed.status) {
+      case ParseStatus::kOk:
+        break;
+      case ParseStatus::kNewerFormat:
+        // Sf34.
+        newer_[peer.install] = device;
+        continue;
+      case ParseStatus::kNotOurs:
+        continue;
+      case ParseStatus::kTooLarge:
+      case ParseStatus::kMalformed:
+        // Sf30: a file not downloaded yet is waiting, not broken. Either
+        // way it is read again when it changes, and deletes nothing.
+        if (peer.placeholder) {
+          waiting_download_.insert(peer.install);
+        } else {
+          unreadable_[peer.install] = device;
+        }
+        stat.mtime_ms = 0;
+        continue;
+    }
+    newer_.erase(peer.install);
+    unreadable_.erase(peer.install);
+    stat.seq = peer.parsed.meta.seq;
+    stat.written_ms = peer.parsed.meta.written_ms;
+    // Sf27: a clock far ahead is held whole and never moves this clock.
+    if (sidebar_sync::ClockFarAhead(peer.parsed.meta.written_ms, now)) {
+      clock_ahead_[peer.install] = device;
+      stat.mtime_ms = 0;
+      continue;
+    }
+    clock_ahead_.erase(peer.install);
+    merged |= MergePeer(peer.install, peer.parsed, /*force=*/false);
+  }
+  if (merged) {
+    ledger_->folder_behind = true;
+  }
+  Apply();
+  if (ledger_->folder_behind) {
+    WriteOwnFile();
+  }
+  SaveLedger();
+  NotifyObservers();
+  if (done) {
+    std::move(done).Run();
+  }
+  if (scan_again_) {
+    scan_again_ = false;
+    Scan();
+    return;
+  }
+  for (base::OnceClosure& waiting : scan_done_) {
+    std::move(waiting).Run();
+  }
+  scan_done_.clear();
+}
+
+bool SidebarSyncService::MergePeer(const std::string& install,
+                                   const ParsedFile& parsed,
+                                   bool force) {
+  State merged = ledger_->state;
+  sidebar_sync::MergeState(merged, parsed.state);
+  merged = sidebar_sync::Canonicalize(
+      merged, sidebar_sync::ResolveAliases(merged.aliases));
+  const Batch batch = sidebar_sync::Diff(ledger_->state, merged);
+  if (merged == ledger_->state) {
+    held_batches_.erase(install);
+    return false;
+  }
+  const std::string device =
+      parsed.meta.device.empty() ? install : parsed.meta.device;
+  // Sf22, Sf23: a large batch or a Space deletion waits, whole.
+  if (!force && sidebar_sync::ShouldHold(batch, ledger_->state)) {
+    auto held = std::make_unique<HeldBatch>();
+    held->device = device;
+    held->parsed = parsed;
+    held->batch = batch;
+    held_batches_[install] = std::move(held);
+    return false;
+  }
+  held_batches_.erase(install);
+  // Sf35: the journal keeps what the batch replaced.
+  const std::string self =
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId);
+  if (!batch.empty()) {
+    sidebar_sync::JournalEntry entry;
+    entry.id = sidebar_sync::MakeInstallId();
+    entry.applied_ms = NowMs();
+    entry.device = device;
+    entry.added = batch.added.size();
+    entry.removed = batch.removed.size();
+    entry.changed = batch.changed.size();
+    const auto keep = [&](const std::string& id) {
+      const auto it = ledger_->state.records.find(id);
+      if (it == ledger_->state.records.end()) {
+        entry.absent.push_back(id);
+      } else {
+        entry.before.records[id] = it->second;
+      }
+    };
+    for (const std::string& id : batch.added) {
+      keep(id);
+    }
+    for (const std::string& id : batch.removed) {
+      keep(id);
+    }
+    for (const auto& [id, fields] : batch.changed) {
+      keep(id);
+      const Record& was = ledger_->state.records.at(id);
+      for (const std::string& name : fields) {
+        const auto field = was.f.find(name);
+        if (field != was.f.end() && field->second.s.w == self) {
+          entry.replaced_local_edit = true;
+        }
+      }
+    }
+    for (const std::string& container : batch.reordered) {
+      if (const auto it = ledger_->state.lists.find(container);
+          it != ledger_->state.lists.end()) {
+        entry.before.lists[container] = it->second;
+      }
+    }
+    ledger_->journal.push_back(std::move(entry));
+    ledger_->TrimJournal(NowMs());
+  }
+  for (const std::string& id : batch.added) {
+    ledger_->pending_adds.insert(id);
+  }
+  ledger_->state = std::move(merged);
+  ledger_->hlc = std::max(ledger_->hlc, parsed.state.MaxTime());
+  ledger_->NoteTombstones(NowMs());
+  return true;
+}
+
+void SidebarSyncService::Apply() {
+  if (!ready_ || !ledger_ || applying_) {
+    return;
+  }
+  sidebar_sync::ApplyOutcome outcome;
+  {
+    base::AutoReset<bool> applying(&applying_, true);
+    const std::map<std::string, std::string> resolved = Resolved();
+    outcome = sidebar_sync::ApplyToWindows(profile_, *ledger_, resolved,
+                                           move_now_);
+    // What sync placed is no edit of the user's (Sf12).
+    if (!outcome.no_window) {
+      last_view_ = sidebar_sync::BuildLocalView(profile_, resolved);
+    }
+  }
+  held_moves_ = std::set<std::string>(outcome.held_moves.begin(),
+                                      outcome.held_moves.end());
+  std::erase_if(move_now_, [this](const std::string& id) {
+    return !held_moves_.contains(id);
+  });
+  isolation_questions_ = std::set<std::string>(
+      outcome.isolation_questions.begin(), outcome.isolation_questions.end());
+  deferred_ = outcome.deferred;
+  if (outcome.applied > 0) {
+    SaveLedger();
+    NotifyObservers();
+  }
+}
+
+void SidebarSyncService::WriteOwnFile() {
+  if (!ready_ || !ledger_) {
+    return;
+  }
+  if (write_in_flight_) {
+    write_again_ = true;
+    return;
+  }
+  sidebar_sync::FileMeta meta;
+  meta.install =
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId);
+  meta.device = DeviceName();
+  meta.seq = ++ledger_->seq;
+  meta.nonce = sidebar_sync::MakeInstallId();
+  meta.written_ms = NowMs();
+  meta.hlc = std::max(ledger_->hlc, ledger_->state.MaxTime());
+  meta.joined_ms = ledger_->joined_ms;
+  write_in_flight_ = true;
+  // Sf31: a write never holds up quitting; one quitting beat is made at the
+  // next launch (folder_behind).
+  write_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&sidebar_sync::WriteOwnFileOnSequence, folder(),
+                     sidebar_sync::FileNameFor(meta.install),
+                     sidebar_sync::SerializeSyncFile(ledger_->state, meta)),
+      base::BindOnce(&SidebarSyncService::OnOwnFileWritten,
+                     weak_factory_.GetWeakPtr(),
+                     sidebar_sync::WriteRecord{meta.nonce, meta.seq,
+                                               meta.written_ms}));
+}
+
+void SidebarSyncService::OnOwnFileWritten(sidebar_sync::WriteRecord write,
+                                          bool ok) {
+  write_in_flight_ = false;
+  if (!ledger_) {
+    return;
+  }
+  if (ok) {
+    ledger_->NoteWrite(write);
+    write_failures_ = 0;
+    write_failed_ = false;
+    if (!write_again_) {
+      ledger_->folder_behind = false;
+    }
+    SaveLedger();
+  } else {
+    // Sf31: twice more, after 10 s and 60 s, then at the next change.
+    ++write_failures_;
+    if (write_failures_ <= 2) {
+      retry_timer_.Start(FROM_HERE,
+                         write_failures_ == 1 ? sidebar_sync::kFirstRetry
+                                              : sidebar_sync::kSecondRetry,
+                         base::BindOnce(&SidebarSyncService::WriteOwnFile,
+                                        base::Unretained(this)));
+    } else {
+      write_failed_ = true;
+      write_failures_ = 0;
+    }
+    NotifyObservers();
+  }
+  if (write_again_) {
+    write_again_ = false;
+    WriteOwnFile();
+  }
+}
+
+void SidebarSyncService::SaveLedger() {
+  if (!ledger_) {
+    return;
+  }
+  std::string json;
+  base::JSONWriter::Write(sidebar_sync::LedgerToValue(*ledger_), &json);
+  ledger_runner_->PostTask(
+      FROM_HERE, base::BindOnce(base::IgnoreResult(
+                                    &sidebar_sync::WriteLedgerJson),
+                                profile_->GetPath(), std::move(json)));
+}
+
+void SidebarSyncService::RefreshBackups() {
+  ledger_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&sidebar_sync::ListBackups, profile_->GetPath()),
+      base::BindOnce(&SidebarSyncService::OnBackupsListed,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SidebarSyncService::OnBackupsListed(
+    std::vector<base::FilePath> backups) {
+  backups_ = std::move(backups);
+  NotifyObservers();
+}
+
+base::FilePath SidebarSyncService::BackupPath(const std::string& name) const {
+  for (const base::FilePath& path : backups_) {
+    if (path.BaseName().AsUTF8Unsafe() == name) {
+      return path;
+    }
+  }
+  return base::FilePath();
+}
+
+void SidebarSyncService::TakeBackup() {
+  // Sf9, Sf22: the whole sidebar as an Export all Spaces file, before a
+  // join and before a held batch is applied.
+  const std::vector<BrowserWindowInterface*> windows =
+      sidebar_sync::RegistryWindows(profile_);
+  ArcImportPlan plan = windows.empty() ? sidebar_sync::LedgerToPlan(
+                                             ledger_ ? ledger_->state : State())
+                                       : SnapshotWindow(windows.front());
+  ledger_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&sidebar_sync::WriteBackup, profile_->GetPath(),
+                     PlanToJson(plan), clock_->Now()),
+      base::BindOnce([](base::WeakPtr<SidebarSyncService> service,
+                        base::FilePath) {
+        if (service) {
+          service->RefreshBackups();
+        }
+      },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SidebarSyncService::TakeNewInstallId() {
+  // Sf29: a copy of this profile writes under the old id; this one takes a
+  // new id and leaves that file to it.
+  PrefService* const prefs = profile_->GetPrefs();
+  prefs->SetString(stedding::prefs::kSidebarSyncInstallId,
+                   sidebar_sync::MakeInstallId());
+  if (ledger_) {
+    ledger_->seq = 0;
+    ledger_->recent.clear();
+    ledger_->joined_ms = NowMs();
+    ledger_->folder_behind = true;
+  }
+}
+
+void SidebarSyncService::PreviewJoin(const base::FilePath& picked,
+                                     PreviewCallback done) {
+  pending_join_.reset();
+  // Sf8: never a folder in Stedding's own data.
+  base::FilePath user_data;
+  base::PathService::Get(chrome::DIR_USER_DATA, &user_data);
+  if (picked.empty() || user_data == picked || user_data.IsParent(picked)) {
+    base::DictValue refusal;
+    refusal.Set("refusal", "inside");
+    std::move(done).Run(std::move(refusal));
+    return;
+  }
+  PrefService* const prefs = profile_->GetPrefs();
+  if (!sidebar_sync::IsInstallId(
+          prefs->GetString(stedding::prefs::kSidebarSyncInstallId))) {
+    prefs->SetString(stedding::prefs::kSidebarSyncInstallId,
+                     sidebar_sync::MakeInstallId());
+  }
+  io_runner_->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&sidebar_sync::ScanForJoin, picked,
+                     prefs->GetString(stedding::prefs::kSidebarSyncInstallId)),
+      base::BindOnce(&SidebarSyncService::OnJoinScanned,
+                     weak_factory_.GetWeakPtr(), std::move(done)));
+}
+
+void SidebarSyncService::OnJoinScanned(PreviewCallback done, JoinScan scan) {
+  base::DictValue preview;
+  switch (scan.refusal) {
+    case JoinScan::Refusal::kNone:
+      break;
+    case JoinScan::Refusal::kMissing:
+      preview.Set("refusal", "missing");
+      break;
+    case JoinScan::Refusal::kUnwritable:
+      preview.Set("refusal", "unwritable");
+      break;
+    case JoinScan::Refusal::kDenied:
+      preview.Set("refusal", "denied");
+      break;
+  }
+  if (scan.refusal != JoinScan::Refusal::kNone) {
+    std::move(done).Run(std::move(preview));
+    return;
+  }
+  auto join = std::make_unique<PendingJoin>();
+  join->dir = scan.dir;
+  join->joined_ms = NowMs();
+  join->own = scan.own;
+  const std::string install =
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId);
+  // Sf10: everything already here is older than any edit, so on a tie the
+  // folder's content wins.
+  sidebar_sync::RecordLocalEdits(
+      join->local, nullptr,
+      sidebar_sync::BuildLocalView(profile_, {}), {},
+      Stamp{-join->joined_ms, install});
+  State peers;
+  base::ListValue computers;
+  base::ListValue newer;
+  for (sidebar_sync::PeerRead& peer : scan.peers) {
+    if (peer.parsed.status == ParseStatus::kNewerFormat) {
+      newer.Append(peer.parsed.meta.device);
+      continue;
+    }
+    if (peer.parsed.status != ParseStatus::kOk) {
+      continue;
+    }
+    base::DictValue computer = sidebar_sync::Counts(peer.parsed.state);
+    computer.Set("device", peer.parsed.meta.device);
+    computer.Set("updatedMs", static_cast<double>(peer.parsed.meta.written_ms));
+    computers.Append(std::move(computer));
+    sidebar_sync::MergeState(peers, peer.parsed.state);
+    join->peers.push_back(std::move(peer.parsed));
+  }
+  peers = sidebar_sync::Canonicalize(
+      peers, sidebar_sync::ResolveAliases(peers.aliases));
+  join->pairs = sidebar_sync::ProposePairs(join->local, peers);
+  base::ListValue pairs;
+  for (const sidebar_sync::Pair& pair : join->pairs) {
+    base::DictValue entry;
+    entry.Set("label", pair.label);
+    entry.Set("kind", sidebar_sync::KindName(pair.kind));
+    pairs.Append(std::move(entry));
+  }
+  preview.Set("dir", scan.dir.AsUTF8Unsafe());
+  preview.Set("computers", std::move(computers));
+  preview.Set("newer", std::move(newer));
+  preview.Set("here", sidebar_sync::Counts(join->local));
+  preview.Set("pairs", std::move(pairs));
+  preview.Set("deviceName", DeviceName());
+  pending_join_ = std::move(join);
+  std::move(done).Run(std::move(preview));
+}
+
+bool SidebarSyncService::ConfirmJoin(bool combine,
+                                     const std::string& device_name,
+                                     const std::vector<size_t>& accepted) {
+  if (!pending_join_) {
+    return false;
+  }
+  std::unique_ptr<PendingJoin> join = std::move(pending_join_);
+  PrefService* const prefs = profile_->GetPrefs();
+  TakeBackup();
+  Ledger ledger;
+  ledger.joined_ms = join->joined_ms;
+  ledger.state = join->local;
+  // Sf10: the pairs the user kept ticked become one, under the smaller id.
+  if (combine) {
+    std::vector<sidebar_sync::Pair> chosen;
+    for (size_t index : accepted) {
+      if (index < join->pairs.size()) {
+        chosen.push_back(join->pairs[index]);
+      }
+    }
+    ledger.state.aliases = sidebar_sync::AliasesFor(chosen);
+  }
+  for (const ParsedFile& peer : join->peers) {
+    sidebar_sync::MergeState(ledger.state, peer.state);
+    sidebar_sync::PeerStat stat;
+    stat.device = peer.meta.device;
+    stat.seq = peer.meta.seq;
+    stat.written_ms = peer.meta.written_ms;
+    ledger.peers[peer.meta.install] = std::move(stat);
+  }
+  ledger.state = sidebar_sync::Canonicalize(
+      ledger.state, sidebar_sync::ResolveAliases(ledger.state.aliases));
+  // A file this install wrote before (sync turned off and on again) is its
+  // own, not a copy's (Sf29, Sf37).
+  if (join->own) {
+    ledger.seq = join->own->seq;
+    ledger.NoteWrite(sidebar_sync::WriteRecord{
+        join->own->nonce, join->own->seq, join->own->written_ms});
+  }
+  ledger.hlc = std::max<int64_t>(0, ledger.state.MaxTime());
+  const std::map<std::string, std::string> resolved =
+      sidebar_sync::ResolveAliases(ledger.state.aliases);
+  std::set<std::string> present;
+  for (const std::string& id : CollectPresentIds(profile_)) {
+    present.insert(sidebar_sync::Canonical(resolved, id));
+  }
+  for (const auto& [id, record] : ledger.state.records) {
+    if (record.Alive() && record.kind != Kind::kSpace &&
+        !present.contains(id)) {
+      ledger.pending_adds.insert(id);
+    }
+  }
+  ledger.NoteTombstones(NowMs());
+  ledger.folder_behind = true;
+  ledger_ = std::move(ledger);
+  if (!device_name.empty()) {
+    prefs->SetString(stedding::prefs::kSidebarSyncDeviceName,
+                     device_name.substr(0, sidebar_sync::kMaxTextLength));
+  }
+  // Setting the folder starts the observers; the ledger is in memory, so
+  // nothing is read from disk in its place.
+  seen_window_ = true;
+  prefs->SetFilePath(stedding::prefs::kSidebarSyncFolder, join->dir);
+  if (!ready_) {
+    ready_ = true;
+    EnsureWatches();
+    StartWatcher();
+  }
+  Apply();
+  WriteOwnFile();
+  SaveLedger();
+  RefreshBackups();
+  NotifyObservers();
+  return true;
+}
+
+void SidebarSyncService::CancelJoin() {
+  pending_join_.reset();
+}
+
+void SidebarSyncService::SetDeviceName(const std::string& name) {
+  profile_->GetPrefs()->SetString(
+      stedding::prefs::kSidebarSyncDeviceName,
+      name.substr(0, sidebar_sync::kMaxTextLength));
+  if (ledger_) {
+    ledger_->folder_behind = true;
+    WriteOwnFile();
+  }
+  NotifyObservers();
+}
+
+void SidebarSyncService::SyncNow() {
+  write_failed_ = false;
+  if (ledger_ && ledger_->folder_behind) {
+    WriteOwnFile();
+  }
+  Scan();
+}
+
+void SidebarSyncService::Stop(bool remove_own_file) {
+  const base::FilePath dir = folder();
+  const std::string install =
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId);
+  if (ready_) {
+    Commit();
+  }
+  // Sf37: nothing in the sidebar changes; the ledger, journal and backups
+  // are forgotten and the install id kept, so a later join merges by the
+  // same ids.
+  profile_->GetPrefs()->ClearPref(stedding::prefs::kSidebarSyncFolder);
+  StopObserving();
+  ledger_runner_->PostTask(FROM_HERE, base::BindOnce(&sidebar_sync::DeleteLedger,
+                                                     profile_->GetPath()));
+  if (remove_own_file && !dir.empty() && sidebar_sync::IsInstallId(install)) {
+    write_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(base::IgnoreResult(&base::DeleteFile),
+                       dir.AppendASCII(sidebar_sync::FileNameFor(install))));
+  }
+  backups_.clear();
+  NotifyObservers();
+}
+
+bool SidebarSyncService::ResolveDecision(const std::string& id,
+                                         const std::string& choice) {
+  if (!ready_ || !ledger_) {
+    return false;
+  }
+  const std::string install =
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId);
+  constexpr std::string_view kBatch = "batch:";
+  constexpr std::string_view kIsolation = "isolation:";
+  constexpr std::string_view kMove = "move:";
+  constexpr std::string_view kCopy = "copy:";
+  if (id.starts_with(kBatch)) {
+    const std::string peer = id.substr(kBatch.size());
+    const auto it = held_batches_.find(peer);
+    if (it == held_batches_.end()) {
+      return false;
+    }
+    std::unique_ptr<HeldBatch> held = std::move(it->second);
+    held_batches_.erase(it);
+    if (choice == "apply") {
+      TakeBackup();
+    } else if (choice == "keep") {
+      // Sf22, Sf23: what the batch removed is stamped alive again, so it
+      // comes back on every computer; what it added stays out of the
+      // windows here (Bring them here can still fetch it).
+      const Stamp stamp{
+          sidebar_sync::NextTime(NowMs(), std::max(ledger_->hlc,
+                                                   held->parsed.state.MaxTime())),
+          install};
+      for (const std::string& removed : held->batch.removed) {
+        auto record = ledger_->state.records.find(removed);
+        if (record == ledger_->state.records.end()) {
+          continue;
+        }
+        for (auto& [name, field] : record->second.f) {
+          field.s = stamp;
+        }
+      }
+      ledger_->hlc = stamp.t;
+    } else {
+      return false;
+    }
+    const std::vector<std::string> added = held->batch.added;
+    MergePeer(peer, held->parsed, /*force=*/true);
+    if (choice == "keep") {
+      for (const std::string& each : added) {
+        ledger_->pending_adds.erase(each);
+      }
+    }
+    ledger_->folder_behind = true;
+  } else if (id.starts_with(kIsolation)) {
+    const std::string space_id = id.substr(kIsolation.size());
+    const Record* const record = ledger_->state.FindAlive(space_id);
+    const std::optional<SpaceId> space =
+        SpaceId::FromOptionalToken(base::Token::FromString(space_id));
+    if (!record || !space) {
+      return false;
+    }
+    const std::string& wanted = record->Get(sidebar_sync::kFieldIsolated);
+    if (choice == "turn") {
+      // Sf24: through the model, which keeps the jar to wipe and the
+      // essentials that are the Space's own right.
+      const std::vector<BrowserWindowInterface*> windows =
+          sidebar_sync::RegistryWindows(profile_);
+      if (windows.empty()) {
+        return false;
+      }
+      base::AutoReset<bool> applying(&applying_, true);
+      SpaceModel::From(windows.front())->SetSpaceIsolated(*space,
+                                                          wanted == "1");
+      ledger_->isolation_kept.erase(space_id);
+    } else if (choice == "keep") {
+      ledger_->isolation_kept[space_id] = wanted;
+    } else {
+      return false;
+    }
+    isolation_questions_.erase(space_id);
+  } else if (id.starts_with(kMove)) {
+    if (choice != "move") {
+      return false;
+    }
+    move_now_.insert(id.substr(kMove.size()));
+  } else if (id.starts_with(kCopy)) {
+    const std::string name = id.substr(kCopy.size());
+    if (choice == "dismiss") {
+      ledger_->dismissed_files.insert(name);
+      std::erase(conflict_copies_, name);
+    } else {
+      return false;
+    }
+  } else if (id == "notHere") {
+    if (choice != "bring") {
+      return false;
+    }
+    base::AutoReset<bool> applying(&applying_, true);
+    sidebar_sync::BringSyncedItemsHere(profile_, *ledger_, Resolved());
+    last_view_ = sidebar_sync::BuildLocalView(profile_, Resolved());
+  } else {
+    return false;
+  }
+  Apply();
+  if (ledger_->folder_behind) {
+    WriteOwnFile();
+  }
+  SaveLedger();
+  NotifyObservers();
+  return true;
+}
+
+bool SidebarSyncService::UndoBatch(const std::string& id) {
+  if (!ready_ || !ledger_) {
+    return false;
+  }
+  const auto entry = std::ranges::find_if(
+      ledger_->journal,
+      [&](const sidebar_sync::JournalEntry& each) { return each.id == id; });
+  if (entry == ledger_->journal.end()) {
+    return false;
+  }
+  // Sf35: the values from before the batch, stamped now, so the other
+  // computers follow; a removed pin comes back unloaded.
+  const Stamp stamp{
+      sidebar_sync::NextTime(NowMs(), std::max(ledger_->hlc,
+                                               ledger_->state.MaxTime())),
+      profile_->GetPrefs()->GetString(stedding::prefs::kSidebarSyncInstallId)};
+  for (const auto& [record_id, before] : entry->before.records) {
+    // A record pruned since comes back with the kind it had (a Space stays
+    // a Space) and, like a removed one, is put back in a window.
+    const auto [it, made] =
+        ledger_->state.records.try_emplace(record_id, before.kind);
+    Record& now = it->second;
+    const bool was_dead = made || !now.Alive();
+    for (const auto& [name, field] : before.f) {
+      if (was_dead || now.Get(name) != field.v) {
+        now.f[name] = sidebar_sync::Field{field.v, stamp};
+      }
+    }
+    if (was_dead && before.Alive()) {
+      ledger_->pending_adds.insert(record_id);
+    }
+  }
+  for (const std::string& added : entry->absent) {
+    const auto it = ledger_->state.records.find(added);
+    if (it != ledger_->state.records.end() && it->second.Alive()) {
+      it->second.del = stamp;
+    }
+  }
+  for (const auto& [container, list] : entry->before.lists) {
+    sidebar_sync::List& now = ledger_->state.lists[container];
+    now.order = sidebar_sync::MergeOrder(list.order, now.order);
+    now.s = stamp;
+  }
+  ledger_->journal.erase(entry);
+  ledger_->hlc = stamp.t;
+  ledger_->NoteTombstones(NowMs());
+  ledger_->folder_behind = true;
+  Apply();
+  WriteOwnFile();
+  SaveLedger();
+  NotifyObservers();
+  return true;
+}
+
+base::DictValue SidebarSyncService::GetStatus() {
+  base::DictValue status;
+  status.Set("enabled", enabled());
+  status.Set("folder", folder().AsUTF8Unsafe());
+  status.Set("device", DeviceName());
+  status.Set("ready", ready_);
+  if (!enabled()) {
+    return status;
+  }
+  // Sf31: at most one problem, the most important first.
+  std::string problem;
+  std::string problem_device;
+  if (ledger_lost_) {
+    problem = "ledgerLost";
+  } else if (unreachable_) {
+    problem = "unreachable";
+  } else if (denied_) {
+    problem = "denied";
+  } else if (write_failed_) {
+    problem = "writeFailed";
+  } else if (!waiting_download_.empty()) {
+    problem = "waiting";
+    if (ledger_) {
+      const auto stat = ledger_->peers.find(*waiting_download_.begin());
+      if (stat != ledger_->peers.end()) {
+        problem_device = stat->second.device;
+      }
+    }
+  } else if (!newer_.empty()) {
+    problem = "newer";
+    problem_device = newer_.begin()->second;
+  } else if (!clock_ahead_.empty()) {
+    problem = "clockAhead";
+    problem_device = clock_ahead_.begin()->second;
+  } else if (!unreadable_.empty()) {
+    problem = "unreadable";
+    problem_device = unreadable_.begin()->second;
+  } else if (watch_failed_) {
+    problem = "noWatch";
+  }
+  status.Set("problem", problem);
+  status.Set("problemDevice", problem_device);
+  if (!ledger_) {
+    return status;
+  }
+  const int64_t now = NowMs();
+  base::ListValue peers;
+  for (const auto& [install, stat] : ledger_->peers) {
+    base::DictValue peer;
+    peer.Set("device", stat.device.empty() ? install : stat.device);
+    peer.Set("agoMs", static_cast<double>(now - stat.written_ms));
+    peers.Append(std::move(peer));
+  }
+  status.Set("peers", std::move(peers));
+  base::ListValue journal;
+  for (auto it = ledger_->journal.rbegin(); it != ledger_->journal.rend();
+       ++it) {
+    base::DictValue entry;
+    entry.Set("id", it->id);
+    entry.Set("device", it->device);
+    entry.Set("added", static_cast<int>(it->added));
+    entry.Set("removed", static_cast<int>(it->removed));
+    entry.Set("changed", static_cast<int>(it->changed));
+    entry.Set("replacedLocal", it->replaced_local_edit);
+    entry.Set("agoMs", static_cast<double>(now - it->applied_ms));
+    journal.Append(std::move(entry));
+  }
+  status.Set("journal", std::move(journal));
+  // Sf20-Sf25, Sf28: the rows waiting for the user.
+  base::ListValue decisions;
+  for (const auto& [install, held] : held_batches_) {
+    base::DictValue row;
+    row.Set("id", "batch:" + install);
+    row.Set("kind", held->batch.removed_spaces > 0 ? "spaceDeleted" : "batch");
+    row.Set("device", held->device);
+    row.Set("added", static_cast<int>(held->batch.added.size()));
+    row.Set("removed", static_cast<int>(held->batch.removed.size()));
+    std::string space_name;
+    for (const std::string& removed : held->batch.removed) {
+      const auto record = ledger_->state.records.find(removed);
+      if (record != ledger_->state.records.end() &&
+          record->second.kind == Kind::kSpace) {
+        space_name = record->second.Get(sidebar_sync::kFieldName);
+        break;
+      }
+    }
+    row.Set("spaceName", space_name);
+    decisions.Append(std::move(row));
+  }
+  const std::vector<BrowserWindowInterface*> windows =
+      sidebar_sync::RegistryWindows(profile_);
+  for (const std::string& space_id : isolation_questions_) {
+    const Record* const record = ledger_->state.FindAlive(space_id);
+    const std::optional<SpaceId> space =
+        SpaceId::FromOptionalToken(base::Token::FromString(space_id));
+    if (!record || !space) {
+      continue;
+    }
+    base::DictValue row;
+    row.Set("id", "isolation:" + space_id);
+    row.Set("kind", "isolation");
+    row.Set("spaceName", record->Get(sidebar_sync::kFieldName));
+    row.Set("turnOn", record->Get(sidebar_sync::kFieldIsolated) == "1");
+    row.Set("pages",
+            windows.empty() ? 0
+                            : SpaceModel::From(windows.front())
+                                  ->CountPagesAJarChangeReloads(*space));
+    decisions.Append(std::move(row));
+  }
+  for (const std::string& tab_id : held_moves_) {
+    const Record* const record = ledger_->state.FindAlive(tab_id);
+    base::DictValue row;
+    row.Set("id", "move:" + tab_id);
+    row.Set("kind", "move");
+    row.Set("name", record ? (record->Get(sidebar_sync::kFieldName).empty()
+                                  ? record->Get(sidebar_sync::kFieldHome)
+                                  : record->Get(sidebar_sync::kFieldName))
+                           : std::string());
+    decisions.Append(std::move(row));
+  }
+  if (ready_ && !windows.empty()) {
+    const size_t not_here = sidebar_sync::CountSyncedItemsNotHere(
+        profile_, *ledger_, Resolved());
+    if (not_here > 0) {
+      base::DictValue row;
+      row.Set("id", "notHere");
+      row.Set("kind", "notHere");
+      row.Set("count", static_cast<int>(not_here));
+      decisions.Append(std::move(row));
+    }
+  }
+  for (const std::string& name : conflict_copies_) {
+    base::DictValue row;
+    row.Set("id", "copy:" + name);
+    row.Set("kind", "conflictCopy");
+    row.Set("name", name);
+    decisions.Append(std::move(row));
+  }
+  status.Set("decisions", std::move(decisions));
+  base::ListValue backups;
+  for (const base::FilePath& path : backups_) {
+    backups.Append(path.BaseName().AsUTF8Unsafe());
+  }
+  status.Set("backups", std::move(backups));
+  status.Set("deferred", static_cast<int>(deferred_));
+  return status;
+}
+
+void SidebarSyncService::CommitForTesting() {
+  Commit();
+}
+
+void SidebarSyncService::ScanForTesting(base::OnceClosure done) {
+  if (!ready_ || !ledger_) {
+    std::move(done).Run();
+    return;
+  }
+  scan_done_.push_back(std::move(done));
+  Scan();
+}
+
+void SidebarSyncService::SetClockForTesting(base::Clock* clock) {
+  clock_ = clock;
+}
+
+}  // namespace spaces
