+namespace {
+
+spaces::SpaceSwitcherView* FindDrawnSwitcher(views::View* view) {
+  if (auto* const switcher = views::AsViewClass<spaces::SpaceSwitcherView>(view);
+      switcher && switcher->IsDrawn()) {
+    return switcher;
+  }
+  for (views::View* child : view->children()) {
+    if (spaces::SpaceSwitcherView* const found = FindDrawnSwitcher(child)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+class SidebarClickTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+
+  // The drawn row for the tab at `index`. The search walks the whole window
+  // so the test does not depend on which container a row lives in.
+  TabView* RowFor(int index) {
+    return stedding::test::FindDrawnRow(
+        browser_view()->GetWidget()->GetRootView(),
+        tab_strip_model()->GetTabAtIndex(index));
+  }
+
+  // What a click at `screen_point` lands on: a row's model index, or the
+  // class of the view that takes it. For failure messages.
+  std::string DescribeTargetAt(gfx::Point screen_point) {
+    views::View* const root = browser_view()->GetWidget()->GetRootView();
+    views::View::ConvertPointFromScreen(root, &screen_point);
+    for (views::View* view = root->GetEventHandlerForPoint(screen_point); view;
+         view = view->parent()) {
+      if (TabView* const row = views::AsViewClass<TabView>(view)) {
+        return "the row of tab " +
+               base::NumberToString(tab_strip_model()->GetIndexOfTab(
+                   row->GetTabInterface()));
+      }
+    }
+    views::View* const target = root->GetEventHandlerForPoint(screen_point);
+    return target ? std::string(target->GetClassName()) : "nothing";
+  }
+
+  // A row's place, and every view above it, for failure messages.
+  std::string DescribeChain(views::View* view) {
+    std::string out;
+    for (; view; view = view->parent()) {
+      out += std::string(view->GetClassName()) + " " +
+             view->bounds().ToString() + (view->GetVisible() ? "" : " hidden") +
+             " screen " + view->GetBoundsInScreen().ToString() + "\n";
+    }
+    return out;
+  }
+
+  int NonClientComponentAt(gfx::Point screen_point) {
+    views::Widget* const widget = browser_view()->GetWidget();
+    views::View::ConvertPointFromScreen(widget->GetRootView(), &screen_point);
+    return widget->GetNonClientComponent(screen_point);
+  }
+
+  void ClickAt(const gfx::Point& screen_point, int flags = ui::EF_NONE) {
+    ui::test::EventGenerator generator(
+        views::GetRootWindow(browser_view()->GetWidget()),
+        browser_view()->GetNativeWindow());
+    generator.set_flags(flags);
+    generator.MoveMouseTo(screen_point);
+    generator.ClickLeftButton();
+  }
+
+  // The middle of the page on screen.
+  gfx::Point PageCentre() {
+    return browser_view()
+        ->contents_web_view()
+        ->GetBoundsInScreen()
+        .CenterPoint();
+  }
+
+  gfx::Point TitleCentre(int index) {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    TabView* const row = RowFor(index);
+    CHECK(row);
+    return row->title_for_testing()->GetBoundsInScreen().CenterPoint();
+  }
+
+  void ExpectActive(int index) {
+    EXPECT_EQ(index, tab_strip_model()->active_index());
+    EXPECT_EQ(tab_strip_model()->GetWebContentsAt(index),
+              browser_view()->GetActiveWebContents());
+  }
+
+  // Waits until no row in the window is still moving into place.
+  void WaitForRowsToSettle() {
+    ASSERT_TRUE(
+        stedding::test::WaitForRowsToSettle(browser_view()->GetWidget()));
+  }
+
+  // Clicks the centre of each row in `order`. Every click must land on client
+  // area, select that row's tab and put its page on screen.
+  void ClickEachRow(const std::vector<int>& order) {
+    for (const int index : order) {
+      SCOPED_TRACE(testing::Message() << "row " << index);
+      WaitForRowsToSettle();
+      TabView* const row = RowFor(index);
+      ASSERT_TRUE(row) << "no drawn row";
+      const gfx::Point centre = row->GetBoundsInScreen().CenterPoint();
+      EXPECT_EQ(HTCLIENT, NonClientComponentAt(centre))
+          << "the window treats the row as caption: a click there drags the "
+             "window instead of selecting the tab";
+      const std::string target = DescribeTargetAt(centre);
+      const std::string chain = DescribeChain(row);
+      ClickAt(centre);
+      // A split is one row: a click on either pane shows the split with the
+      // pane last used there (upstream's rule, and Arc's).
+      tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(index);
+      tabs::TabInterface* const active = tab_strip_model()->GetActiveTab();
+      if (tab->IsSplit()) {
+        EXPECT_EQ(tab->GetSplit(), active->GetSplit())
+            << "the click landed on " << target << "\n" << chain;
+      } else {
+        EXPECT_EQ(index, tab_strip_model()->active_index())
+            << "the click landed on " << target << "\n" << chain;
+      }
+      EXPECT_EQ(active->GetContents(), browser_view()->GetActiveWebContents());
+    }
+  }
+
+  // Every row, last to first and back again.
+  void ClickEveryRow() {
+    const int count = tab_strip_model()->count();
+    std::vector<int> order;
+    for (int index = count - 1; index >= 0; --index) {
+      order.push_back(index);
+    }
+    for (int index = 0; index < count; ++index) {
+      order.push_back(index);
+    }
+    ClickEachRow(order);
+  }
+
+  // A part of a row a person clicks.
+  enum class Part { kFavicon, kTitle, kEmptyEnd };
+
+  // Where `part` of `row` is on screen, if the row shows it: the favicon,
+  // the start of the title, and the empty end of the title's line.
+  std::optional<gfx::Point> PointOf(TabView* row, Part part) {
+    const views::View* const icon = row->GetTabIconForTesting();
+    const views::View* const title = row->title_for_testing();
+    switch (part) {
+      case Part::kFavicon:
+        if (!icon->GetVisible() || icon->bounds().IsEmpty()) {
+          return std::nullopt;
+        }
+        return icon->GetBoundsInScreen().CenterPoint();
+      case Part::kTitle:
+      case Part::kEmptyEnd: {
+        if (!title->GetVisible() || title->width() < 60) {
+          return std::nullopt;
+        }
+        const gfx::Rect bounds = title->GetBoundsInScreen();
+        return gfx::Point(
+            part == Part::kTitle ? bounds.x() + 6 : bounds.right() - 4,
+            bounds.CenterPoint().y());
+      }
+    }
+  }
+
+  // A tab to start from before a click on `index`'s row: not that tab, and
+  // not the other pane of its split, so the click is a switch.
+  int OtherThan(int index) {
+    const tabs::TabInterface* const tab =
+        tab_strip_model()->GetTabAtIndex(index);
+    for (int other = 0; other < tab_strip_model()->count(); ++other) {
+      const tabs::TabInterface* const candidate =
+          tab_strip_model()->GetTabAtIndex(other);
+      if (other != index &&
+          !(tab->IsSplit() && candidate->GetSplit() == tab->GetSplit())) {
+        return other;
+      }
+    }
+    NOTREACHED();
+  }
+
+  // The tab at `index` is the one on screen: its split, for a split row.
+  void ExpectShown(int index) {
+    tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(index);
+    tabs::TabInterface* const active = tab_strip_model()->GetActiveTab();
+    if (tab->IsSplit()) {
+      EXPECT_EQ(tab->GetSplit(), active->GetSplit());
+    } else {
+      EXPECT_EQ(index, tab_strip_model()->active_index());
+    }
+    EXPECT_EQ(active->GetContents(), browser_view()->GetActiveWebContents());
+  }
+
+  // One row of each kind the sidebar draws: an essential (Chromium's pin),
+  // a Space pin, plain rows, a folder's rows, a nested folder's row and both
+  // panes of a split.
+  void BuildEveryKindOfRow() {
+    for (int i = 0; i < 7; ++i) {
+      AppendTab();
+    }
+    ASSERT_EQ(8, tab_strip_model()->count());
+
+    tab_strip_model()->SetTabPinned(7, true);
+    ASSERT_TRUE(tab_strip_model()->IsTabPinned(0));
+
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model);
+    tabs::TabInterface* const space_pin = tab_strip_model()->GetTabAtIndex(7);
+    model->SetSpacePinned(space_pin, true);
+    ASSERT_TRUE(model->IsSpacePinned(space_pin));
+    ASSERT_EQ(1, tab_strip_model()->GetIndexOfTab(space_pin));
+
+    tabs::FolderTabCollection* const folder =
+        tab_strip_model()->AddToNewFolder({3, 4, 5});
+    ASSERT_TRUE(folder);
+    ASSERT_TRUE(tab_strip_model()->AddToNewFolder({5}, folder));
+
+    tab_strip_model()->ActivateTabAt(6);
+    tab_strip_model()->AddToNewSplit(
+        {7}, split_tabs::SplitTabVisualData(),
+        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+    ASSERT_TRUE(tab_strip_model()->GetTabAtIndex(6)->IsSplit());
+    ASSERT_TRUE(tab_strip_model()->GetTabAtIndex(7)->IsSplit());
+    ASSERT_EQ(8, tab_strip_model()->count());
+  }
+
+  void CollapseSidebar() {
+    tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+        true);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+    ASSERT_TRUE(
+        tabs::VerticalTabStripStateController::From(browser())->IsCollapsed());
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, AClickOnARowSelectsItsTab) {
+  AppendTab();
+  AppendTab();
+  ASSERT_EQ(3, tab_strip_model()->count());
+  ClickEachRow({0, 2, 1, 0});
+}
+
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, AClickOnARailRowSelectsItsTab) {
+  AppendTab();
+  AppendTab();
+  CollapseSidebar();
+  ClickEachRow({0, 2, 1, 0});
+}
+
+// TAB-2: a hovered rail row keeps its favicon where it was and shows no close
+// button, whatever kind of row it is, so a click in the middle of it selects
+// the tab rather than closing it.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, AHoveredRailRowShowsNoCloseButton) {
+  BuildEveryKindOfRow();
+  CollapseSidebar();
+  WaitForRowsToSettle();
+  const int count = tab_strip_model()->count();
+  int hovered = 0;
+  for (int index = 0; index < count; ++index) {
+    SCOPED_TRACE(testing::Message() << "row " << index);
+    // An essential is a card, with no close button in any form.
+    if (tab_strip_model()->IsTabPinned(index)) {
+      continue;
+    }
+    TabView* const row = RowFor(index);
+    ASSERT_TRUE(row);
+    const gfx::Rect favicon = row->GetTabIconForTesting()->bounds();
+    row->UpdateHovered(true);
+    views::test::RunScheduledLayout(row);
+    EXPECT_FALSE(row->close_button_for_testing()->GetVisible());
+    EXPECT_TRUE(row->GetTabIconForTesting()->GetVisible());
+    EXPECT_EQ(favicon, row->GetTabIconForTesting()->bounds())
+        << "the hover moved the favicon";
+    row->UpdateHovered(false);
+    ++hovered;
+  }
+  EXPECT_EQ(count - 1, hovered) << "every row but the essential";
+  ClickEveryRow();
+  EXPECT_EQ(count, tab_strip_model()->count()) << "a rail click closed a tab";
+}
+
+// TST-1: every kind of row selects its tab on a click, in the sidebar and
+// in the rail.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, AClickOnEveryKindOfRowSelectsItsTab) {
+  BuildEveryKindOfRow();
+  ClickEveryRow();
+  CollapseSidebar();
+  ClickEveryRow();
+}
+
+// TST-1: a click on the favicon, on the title or on the empty end of the
+// title's line selects the row's tab, for every kind of row, in the open
+// sidebar and in the rail. After all of them a dragged row still moves, and
+// the window still closes.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, EveryPartOfEveryRowSelects) {
+  BuildEveryKindOfRow();
+  AppendTab();
+  AppendTab();
+  const int count = tab_strip_model()->count();
+  for (const bool rail : {false, true}) {
+    SCOPED_TRACE(rail ? "in the rail" : "in the open sidebar");
+    if (rail) {
+      CollapseSidebar();
+    }
+    int clicks = 0;
+    for (int index = 0; index < count; ++index) {
+      for (const Part part : {Part::kFavicon, Part::kTitle, Part::kEmptyEnd}) {
+        SCOPED_TRACE(testing::Message()
+                     << "row " << index << ", part " << static_cast<int>(part));
+        tab_strip_model()->ActivateTabAt(OtherThan(index));
+        WaitForRowsToSettle();
+        TabView* const row = RowFor(index);
+        ASSERT_TRUE(row);
+        const std::optional<gfx::Point> point = PointOf(row, part);
+        if (!point) {
+          continue;
+        }
+        EXPECT_EQ(HTCLIENT, NonClientComponentAt(*point));
+        const std::string target = DescribeTargetAt(*point);
+        ClickAt(*point);
+        ExpectShown(index);
+        EXPECT_EQ(count, tab_strip_model()->count())
+            << "the click landed on " << target << " and closed a tab";
+        ++clicks;
+      }
+    }
+    // Every row's favicon; the titles and their ends in the open sidebar,
+    // where every row but the essential has a title.
+    EXPECT_GE(clicks, rail ? count : count + 2 * (count - 1));
+  }
+
+  // The strip still takes a drag: the last row, dragged over the one above
+  // it, lands above it.
+  tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+      false);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }));
+  WaitForRowsToSettle();
+  tabs::TabInterface* const dragged =
+      tab_strip_model()->GetTabAtIndex(count - 1);
+  const gfx::Rect from = RowFor(count - 1)->GetBoundsInScreen();
+  const gfx::Rect over = RowFor(count - 2)->GetBoundsInScreen();
+  views::Widget* const widget = browser_view()->GetWidget();
+  const gfx::Point start = from.CenterPoint();
+  const gfx::Point end(over.CenterPoint().x(), over.y() + over.height() / 4);
+  stedding::test::SendLeftMouse(widget, ui::EventType::kMousePressed, start);
+  for (int step = 1; step <= 8; ++step) {
+    stedding::test::SendLeftMouse(
+        widget, ui::EventType::kMouseDragged,
+        gfx::Point(start.x() + (end.x() - start.x()) * step / 8,
+                   start.y() + (end.y() - start.y()) * step / 8));
+  }
+  stedding::test::SendLeftMouse(widget, ui::EventType::kMouseReleased, end);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return tab_strip_model()->GetIndexOfTab(dragged) == count - 2;
+  })) << "the dragged row did not move";
+
+  BrowserWindowInterface* const window = browser();
+  widget->Close();
+  ui_test_utils::WaitForBrowserToClose(window);
+}
+
+// TST-1: an Option-click on a drifted pin's favicon takes it home (pins H5);
+// every row still selects afterwards.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, RowsSelectAfterAPinGoesHome) {
+  const GURL home = embedded_test_server()->GetURL("home.test", "/title1.html");
+  const GURL away = embedded_test_server()->GetURL("away.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  AppendTab();
+  AppendTab();
+
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  tabs::TabInterface* const pin = tab_strip_model()->GetTabAtIndex(0);
+  model->SetSpacePinned(pin, true);
+  ASSERT_EQ(home, model->HomeUrl(pin).value_or(GURL()));
+  const int pin_index = tab_strip_model()->GetIndexOfTab(pin);
+  tab_strip_model()->ActivateTabAt(pin_index);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), away));
+
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  TabView* const row = RowFor(pin_index);
+  ASSERT_TRUE(row);
+  ASSERT_TRUE(stedding::HasDriftedFromHome(
+      home, pin->GetContents()->GetLastCommittedURL()));
+  content::TestNavigationObserver back_home(pin->GetContents());
+  ClickAt(row->GetTabIconForTesting()->GetBoundsInScreen().CenterPoint(),
+          ui::EF_ALT_DOWN);
+  back_home.Wait();
+  EXPECT_EQ(home, pin->GetContents()->GetLastCommittedURL());
+
+  ClickEveryRow();
+}
+
+// TAB-3 (pins H5): in the rail a plain click on a drifted Space pin or a
+// drifted essential selects it and keeps the page it drifted to; nothing
+// sends it home.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, ARailClickKeepsADriftedPinsPage) {
+  const GURL home = embedded_test_server()->GetURL("home.test", "/title1.html");
+  const GURL away = embedded_test_server()->GetURL("away.test", "/title2.html");
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  tabs::TabInterface* const space_pin = tab_strip_model()->GetActiveTab();
+  model->SetSpacePinned(space_pin, true);
+  AppendTab();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  tabs::TabInterface* const essential = tab_strip_model()->GetActiveTab();
+  tab_strip_model()->SetTabPinned(tab_strip_model()->GetIndexOfTab(essential),
+                                  true);
+  for (tabs::TabInterface* const tab : {space_pin, essential}) {
+    tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(tab));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), away));
+    ASSERT_TRUE(stedding::HasDriftedFromHome(
+        model->HomeUrl(tab).value_or(GURL()),
+        tab->GetContents()->GetLastCommittedURL()));
+  }
+  AppendTab();
+  CollapseSidebar();
+
+  for (tabs::TabInterface* const tab : {space_pin, essential, space_pin}) {
+    SCOPED_TRACE(tab == space_pin ? "the Space pin" : "the essential");
+    const int index = tab_strip_model()->GetIndexOfTab(tab);
+    ClickEachRow({index});
+    content::WebContents* const contents = tab->GetContents();
+    EXPECT_EQ(away, contents->GetLastCommittedURL());
+    EXPECT_FALSE(contents->GetController().GetPendingEntry())
+        << "the click started a load of the pin's home";
+    // Back to a plain row, so the next click is a switch again.
+    ClickEachRow({tab_strip_model()->count() - 1});
+  }
+}
