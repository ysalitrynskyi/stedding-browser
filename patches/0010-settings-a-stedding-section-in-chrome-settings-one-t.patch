+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_STEDDING_PREFS_H_
+#define CHROME_BROWSER_UI_STEDDING_STEDDING_PREFS_H_
+
+namespace user_prefs {
+class PrefRegistrySyncable;
+}
+
+namespace stedding::prefs {
+
+// Every Stedding preference has a row in the chrome://settings "Stedding"
+// section (docs/features/settings.md) and exactly one reader. All default to
+// on: the settings exist to turn a behaviour off, not to enable it.
+
+// The new tab page shows the "Press ⌘T…" line (new-tab N3).
+inline constexpr char kNewTabShowHint[] = "stedding.new_tab.show_hint";
+// The new tab page shows the row of most-visited shortcuts (new-tab N5).
+inline constexpr char kNewTabShowShortcuts[] =
+    "stedding.new_tab.show_shortcuts";
+// Links that leave a pinned tab's site open in a peek (peek P1, P10).
+inline constexpr char kPeekEnabled[] = "stedding.peek.enabled";
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+}  // namespace stedding::prefs
+
+#endif  // CHROME_BROWSER_UI_STEDDING_STEDDING_PREFS_H_
