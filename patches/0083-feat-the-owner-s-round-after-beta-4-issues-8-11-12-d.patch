+
+void TabHoverCardController::StopResourceLine() {
+  resource_line_timer_.Stop();
+  resource_sampler_.reset();
+  resource_line_phase_ = ResourceLinePhase::kIdle;
+}
+
+void TabHoverCardController::OnResourceLineTimer() {
+  if (!hover_card_ || !TargetTabIsValid()) {
+    StopResourceLine();
+    return;
+  }
+  switch (resource_line_phase_) {
+    case ResourceLinePhase::kWaiting:
+      resource_line_phase_ = ResourceLinePhase::kSampling;
+      // A tab asleep runs nothing to measure, and is not woken to be.
+      if (!resource_line_asleep_) {
+        StartResourceSampler();
+      }
+      resource_line_timer_.Start(
+          FROM_HERE, GetResourceLineLead(),
+          base::BindOnce(&TabHoverCardController::OnResourceLineTimer,
+                         base::Unretained(this)));
+      return;
+    case ResourceLinePhase::kSampling:
+      resource_line_phase_ = ResourceLinePhase::kShown;
+      if (resource_line_asleep_) {
+        ShowResourceLine(stedding::TabResourceLineAsleep());
+      } else if (resource_sampler_) {
+        // Empty until the tab's memory is known; the line then shows with
+        // the first figures.
+        ShowResourceLine(
+            stedding::FormatTabResourceLine(resource_sampler_->figures()));
+      }
+      return;
+    case ResourceLinePhase::kIdle:
+    case ResourceLinePhase::kShown:
+      return;
+  }
+}
+
+void TabHoverCardController::StartResourceSampler() {
+  content::WebContents* const contents = GetContentsOf(target_tab_);
+  if (!contents) {
+    return;
