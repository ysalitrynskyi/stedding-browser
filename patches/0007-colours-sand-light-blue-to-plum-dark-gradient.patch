diff --git a/chrome/browser/ui/color/stedding_color_mixer.cc b/chrome/browser/ui/color/stedding_color_mixer.cc
new file mode 100644
index 0000000000000..e749ec04a5145
--- /dev/null
+++ b/chrome/browser/ui/color/stedding_color_mixer.cc
@@ -0,0 +1,83 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/color/stedding_color_mixer.h"
+
+#include "base/feature_list.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/stedding_ui_metrics.h"
+#include "ui/color/color_id.h"
+#include "ui/color/color_mixer.h"
+#include "ui/color/color_provider.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/color/color_recipe.h"
+#include "ui/color/color_transform.h"
+#include "ui/gfx/color_utils.h"
+
+namespace {
+
+// The window colours, from the operator: sand for light, deep blue for dark.
+// The dark gradient's second stop lives in SteddingWindowBackground; these are
+// the flat colours everything else derives from.
+constexpr SkColor kSteddingLightWindow = SkColorSetRGB(0xC8, 0xB3, 0x77);
+constexpr SkColor kSteddingDarkWindow = SkColorSetRGB(0x21, 0x26, 0x3A);
+
+// How much of the active Space's colour the window ground takes.
+constexpr float kSpaceTintDark = 0.30f;
+constexpr float kSpaceTintLight = 0.22f;
+
+// The new tab page keeps a neutral ground whatever the Space: the tint is
+// the sidebar's, and a plum page under a plum sidebar read as one big stain.
+constexpr SkColor kNewTabDark = SkColorSetRGB(0x36, 0x38, 0x3F);
+constexpr SkColor kNewTabLight = SkColorSetRGB(0xFF, 0xFF, 0xFF);
+
+}  // namespace
+
+void AddSteddingColorMixer(ui::ColorProvider* provider,
+                           const ui::ColorProviderKey& key) {
+  if (!base::FeatureList::IsEnabled(stedding::kArcStyleWindow)) {
+    return;
+  }
+  // A user-installed theme still wins: it is added after this mixer.
+  const bool dark =
+      key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  SkColor window = dark ? kSteddingDarkWindow : kSteddingLightWindow;
+  // The active Space's colour (the widget's user colour override, set by
+  // SpaceTabVisibilityController) tints the ground the sidebar sits on, as
+  // Arc does, not the pages.
+  if (key.user_color) {
+    window = color_utils::AlphaBlend(*key.user_color, window,
+                                     dark ? kSpaceTintDark : kSpaceTintLight);
+  }
+
+  ui::ColorMixer& mixer = provider->AddMixer();
+  // The chrome around the page is one colour, as the reference has it: frame,
+  // toolbar strip, tab strip and the mat under the content card.
+  mixer[ui::kColorFrameActive] = {window};
+  mixer[ui::kColorFrameInactive] = {window};
+  mixer[kColorToolbar] = {window};
+  mixer[kColorNewTabPageBackground] = {dark ? kNewTabDark : kNewTabLight};
+  // No hairline between toolbar and content: the card floats on the ground
+  // and a line across its top edge read as a seam in light mode.
+  mixer[kColorToolbarContentAreaSeparator] = {kColorToolbar};
+  mixer[kColorNewTabButtonBackgroundFrameActive] = {kColorToolbar};
+  mixer[kColorNewTabButtonBackgroundFrameInactive] = {kColorToolbar};
+  // Hovered and selected-but-inactive tab rows take a quiet tint of their own
+  // text colour rather than Material's blue header hover and select, which
+  // shouted next to the neutral active row.
+  mixer[kColorTabBackgroundInactiveHoverFrameActive] =
+      ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x14);
+  mixer[kColorTabBackgroundInactiveHoverFrameInactive] =
+      ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x14);
+  mixer[kColorTabBackgroundSelectedFrameActive] =
+      ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x1F);
+  mixer[kColorTabBackgroundSelectedFrameInactive] =
+      ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x1F);
+  // The pointer is still on the row after the right-click that selected it,
+  // so the hovered variants are what actually shows.
+  mixer[kColorTabBackgroundSelectedHoverFrameActive] =
+      ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x2E);
+  mixer[kColorTabBackgroundSelectedHoverFrameInactive] =
+      ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x2E);
+}
