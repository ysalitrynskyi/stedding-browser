@@ -784,6 +776,15 @@ void VerticalTabStripRegionView::OnTabStripViewSet() {
   CHECK(separator_index.has_value());
   ReorderChildView(tab_strip_view(), separator_index.value() + 1);
 
+  // Arc's Clear lives on the line between pinned and unpinned tabs. It closes
+  // the unpinned tabs of the Space being looked at and leaves pinned ones.
+  if (spaces::SpaceModel::From(browser_view()->browser())) {
+    static_cast<TabStripView*>(tab_strip_view())
+        ->SetSeparatorClearCallback(base::BindRepeating(
+            &VerticalTabStripRegionView::ClearCurrentSpaceTabs,
+            base::Unretained(this)));
+  }
+
   // Tabs outside the active Space are hidden the way a collapsed group hides
   // its tabs. Only normal windows have a SpaceModel; elsewhere this stays null
   // and every tab shows, as before.
@@ -1192,5 +1193,30 @@ void VerticalTabStripRegionView::OnActiveTabChanged(
   }
 }
 
+void VerticalTabStripRegionView::ClearCurrentSpaceTabs() {
+  Browser* const browser = browser_view()->browser();
+  TabStripModel* const tabs = browser->tab_strip_model();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+
+  // Collect first, close after: closing shifts every index behind it.
+  std::vector<content::WebContents*> doomed;
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    if (tab->IsPinned()) {
+      continue;
+    }
+    if (model && !model->IsTabInActiveSpace(tab)) {
+      continue;
+    }
+    doomed.push_back(tab->GetContents());
+  }
+  for (content::WebContents* contents : doomed) {
+    const int index = tabs->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      tabs->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  }
+}
+
