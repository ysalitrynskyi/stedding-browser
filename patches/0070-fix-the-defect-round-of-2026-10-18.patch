+    ASSERT_EQ(2, app_tabs->count());
+    ASSERT_TRUE(chrome::IsCommandEnabled(app, IDC_CLOSE_TAB));
+    chrome::ExecuteCommand(app, IDC_CLOSE_TAB);
+    // Chromium asks first on a pinned tab: the first Cmd-W shows a toast
