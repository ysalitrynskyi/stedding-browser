+base::FilePath FindUserDataDir(const ChromiumFamilySource& source) {
+#if BUILDFLAG(IS_MAC)
+  base::FilePath home;
+  if (source.mac_folder.empty() ||
+      !base::PathService::Get(base::DIR_HOME, &home)) {
+    return base::FilePath();
+  }
+  const base::FilePath dir = home.Append(FILE_PATH_LITERAL("Library"))
+                                 .Append(FILE_PATH_LITERAL("Application Support"))
+                                 .AppendASCII(source.mac_folder)
+                                 .Append(FILE_PATH_LITERAL("User Data"));
+  return base::DirectoryExists(dir) ? dir : base::FilePath();
+#elif BUILDFLAG(IS_WIN)
+  base::FilePath local;
+  if (source.windows_folder.empty() ||
+      !base::PathService::Get(base::DIR_LOCAL_APP_DATA, &local)) {
+    return base::FilePath();
+  }
+  const base::FilePath plain = local.AppendASCII(source.windows_folder)
+                                   .Append(FILE_PATH_LITERAL("User Data"));
+  if (base::DirectoryExists(plain)) {
+    return plain;
+  }
+  if (source.store_package.empty()) {
+    return base::FilePath();
+  }
+  // As Arc's (I27): a Store package, its files in its LocalCache, under a
+  // publisher id after the package's name.
+  const base::FilePath::StringType pattern =
+      base::FilePath::FromASCII(source.store_package).value() +
+      FILE_PATH_LITERAL("_*");
+  base::FileEnumerator packages(local.Append(FILE_PATH_LITERAL("Packages")),
+                                /*recursive=*/false,
+                                base::FileEnumerator::DIRECTORIES, pattern);
+  for (base::FilePath package = packages.Next(); !package.empty();
+       package = packages.Next()) {
+    const base::FilePath dir = package.Append(FILE_PATH_LITERAL("LocalCache"))
+                                   .Append(FILE_PATH_LITERAL("Local"))
+                                   .AppendASCII(source.windows_folder)
+                                   .Append(FILE_PATH_LITERAL("User Data"));
+    if (base::DirectoryExists(dir)) {
+      return dir;
+    }
+  }
+  return base::FilePath();
+#else
+  return base::FilePath();
+#endif
+}
