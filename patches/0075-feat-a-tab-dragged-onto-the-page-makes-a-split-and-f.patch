+// commandbar K31: actions mode lists the toolbar's extension actions, in the
+// toolbar's order, titled with the extension's name and drawn with its own
+// shortcut; Enter runs the action once and the bar closes.
+TEST_F(ExtensionRowsTest, ExtensionRowsAreTheToolbarsActions) {
+  AddTab(browser(), GURL("https://example.com/"));
+  const auto scoped_rows = SetExtensionActionRowsForTesting(&rows_);
+  auto bar = std::make_unique<CommandBarView>(browser());
+  bar->SetModeForTesting(CommandBarView::Mode::kActions);
+  const size_t alpha = RowIndex(*bar, u"Alpha");
+  const size_t beta = RowIndex(*bar, u"Beta");
+  const size_t gamma = RowIndex(*bar, u"Gamma");
+  ASSERT_LT(gamma, bar->row_count_for_testing());
+  EXPECT_LT(alpha, beta);
+  EXPECT_LT(beta, gamma);
+  EXPECT_TRUE(bar->row_detail_for_testing(alpha).empty());
+  EXPECT_EQ(u"⌥⇧B", bar->row_detail_for_testing(beta));
+
+  bar->ContentsChanged(bar->field_for_testing(), u"beta");
+  ASSERT_EQ(1u, bar->row_count_for_testing());
+  EXPECT_TRUE(Enter(*bar));
+  EXPECT_EQ(std::vector<std::u16string>{u"Beta"}, runs_);
+  EXPECT_TRUE(bar->closing_for_testing());
+
+  // Without a tab there is no page to run an action on (K16).
+  tabs().CloseAllTabs();
+  auto empty = std::make_unique<CommandBarView>(browser());
+  empty->SetModeForTesting(CommandBarView::Mode::kActions);
+  EXPECT_FALSE(HasTitle(*empty, u"Alpha"));
+}
