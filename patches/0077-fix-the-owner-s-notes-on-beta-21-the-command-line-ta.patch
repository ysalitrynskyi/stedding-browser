+// sidebar Y29 on Windows: the address row's empty parts -- the gaps between
+// its buttons, the field's empty start and the stretch between the app menu
+// and the caption buttons -- are the window's caption, so a drag moves the
+// window and a double click maximizes it, as Windows does for a caption. The
+// stretch before the caption buttons lay outside the top container and read
+// as the page's: it did nothing (the coordinator, 2026-10-20, beta 21).
+IN_PROC_BROWSER_TEST_F(AddressBandTest, TheRowsEmptyPartsAreTheCaption) {
+  auto* const frame = views::AsViewClass<BrowserFrameViewWin>(
+      view()->GetWidget()->non_client_view()->frame_view());
+  ASSERT_TRUE(frame);
+  const views::View* const captions =
+      frame->caption_button_container_for_testing();
+  ASSERT_TRUE(captions && captions->GetVisible());
+  views::test::RunScheduledLayout(view());
+  views::Widget* const widget = view()->GetWidget();
+  const auto in_widget = [](const views::View* v) {
+    return v->ConvertRectToWidget(v->GetLocalBounds());
+  };
+  // Every drawn button of the row, a DIP wider all round.
+  std::vector<gfx::Rect> taken;
+  std::vector<const views::View*> pending = {view()->toolbar()};
+  while (!pending.empty()) {
+    const views::View* const parent = pending.back();
+    pending.pop_back();
+    for (const views::View* const child : parent->children()) {
+      if (!child->GetVisible() || child->bounds().IsEmpty()) {
+        continue;
+      }
+      if (views::IsViewClass<views::Button>(child)) {
+        gfx::Rect rect = in_widget(child);
+        rect.Outset(1);
+        taken.push_back(rect);
+      } else {
+        pending.push_back(child);
+      }
+    }
+  }
+  const gfx::Rect row = in_widget(view()->toolbar());
