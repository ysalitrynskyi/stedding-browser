+// Counts the bounds each window it watches takes: a move and a resize made
+// together, which the window reports twice, count once.
+class BoundsChangeCounter : public views::WidgetObserver {
+ public:
+  explicit BoundsChangeCounter(const std::vector<views::Widget*>& widgets) {
+    for (views::Widget* const widget : widgets) {
+      observations_.AddObservation(widget);
+      seen_[widget] = {0, widget->GetWindowBoundsInScreen()};
+    }
+  }
+  BoundsChangeCounter(const BoundsChangeCounter&) = delete;
+  BoundsChangeCounter& operator=(const BoundsChangeCounter&) = delete;
+  ~BoundsChangeCounter() override = default;
+
+  int count(views::Widget* widget) const {
+    const auto it = seen_.find(widget);
+    return it == seen_.end() ? 0 : it->second.count;
+  }
+  void Reset() {
+    for (auto& [widget, seen] : seen_) {
+      seen = {0, widget->GetWindowBoundsInScreen()};
+    }
+  }
+
+ private:
+  struct Seen {
+    int count = 0;
+    gfx::Rect bounds;
+  };
+
+  // views::WidgetObserver:
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override {
+    Seen& seen = seen_[widget];
+    if (new_bounds != seen.bounds) {
+      ++seen.count;
+      seen.bounds = new_bounds;
+    }
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    observations_.RemoveObservation(widget);
+    seen_.erase(widget);
+  }
+
+  base::ScopedMultiSourceObservation<views::Widget, views::WidgetObserver>
+      observations_{this};
+  std::map<views::Widget*, Seen> seen_;
+};
