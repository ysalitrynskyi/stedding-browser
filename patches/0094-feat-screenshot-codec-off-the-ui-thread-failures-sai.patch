+                              const base::FilePath& name) {
+  BeginStep();
+  CaptureOutcome outcome;
+  if (bitmap.drawsNothing()) {
+    return outcome;
+  }
+  const std::optional<std::vector<uint8_t>> png =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap,
+                                        /*discard_transparency=*/false);
+  if (png && !png->empty()) {
+    outcome.path = WriteNewScreenshotFile(directory, name, *png);
+  }
+  // Copied whether or not it was saved (screenshot C10).
+  outcome.bitmap = std::move(bitmap);
+  return outcome;
+}
+
+CaptureOutcome WriteAndDecode(std::vector<uint8_t> png,
+                              const base::FilePath& directory,
+                              const base::FilePath& name) {
+  BeginStep();
+  return WriteThenDecode(std::move(png), directory, name);
+}
+
+FullPageResult ReadWriteAndDecode(std::string message,
+                                  int request_id,
+                                  const base::FilePath& directory,
+                                  const base::FilePath& name) {
+  BeginStep();
+  FullPageResult result;
+  CaptureReply reply = ReadReply(message, request_id);
+  // The reply's text can be hundreds of megabytes; let it go before the
+  // decode makes the bitmap.
+  std::string().swap(message);
+  result.kind = reply.kind;
+  if (reply.kind == ReplyKind::kPicture) {
+    result.outcome = WriteThenDecode(std::move(reply.png), directory, name);
+  }
+  return result;
+}
+
+void SetCaptureCodecObserverForTesting(base::RepeatingClosure observer) {
+  CodecObserver() = std::move(observer);
+}
+
+}  // namespace stedding
