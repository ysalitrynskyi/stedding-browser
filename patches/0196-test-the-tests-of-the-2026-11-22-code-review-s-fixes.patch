+
+// P28-1f, tabs R65: a part goes as the site's own name only when its letters
+// and digits are that name. Letters of every script count: a part of
+// Cyrillic words beside the site's Latin name is the page's own and stays,
+// where only its Latin letters were weighed and it went as the site's name.
+TEST(TidyNamesW2B21Test, APartWithOtherLettersIsNotTheSitesName) {
+  EXPECT_EQ(u"Новини GitHub",
+            TidyTitle(u"Новини GitHub · Блог", GURL("https://github.com/")));
+  EXPECT_EQ(
+      base::FilePath::FromUTF16Unsafe(u"Виписка Privat24.pdf"),
+      TidyDownloadName(base::FilePath::FromASCII("download.pdf"),
+                       u"Виписка Privat24 — Приват24",
+                       GURL("https://privat24.ua/")));
+  // A part that is the site's name alone still goes, whatever its case.
+  EXPECT_EQ(u"Новини",
+            TidyTitle(u"Новини · GITHUB", GURL("https://github.com/")));
+  EXPECT_EQ(u"Pull requests",
+            TidyTitle(u"Pull requests · GitHub", GURL("https://github.com/")));
+}
