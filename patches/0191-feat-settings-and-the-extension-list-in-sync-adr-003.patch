+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_EXTENSIONS_H_
+#define CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_EXTENSIONS_H_
+
+#include <string>
+#include <vector>
+
+#include "base/functional/callback.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_parts.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+
+namespace content {
+class BrowserContext;
+}  // namespace content
+
+namespace extensions {
+class Extension;
+}  // namespace extensions
+
+// docs/features/sidebar-file.md Sf63-Sf68 (ADR 0037): this computer's side
+// of the extension list sync carries. Only extensions the person installed
+// from the Chrome Web Store travel, each by its id and name; nothing about
+// an extension's data, settings or state does.
+namespace spaces::sidebar_sync {
+
+// Sf63: an extension, not an app or a theme, installed from the Chrome Web
+// Store. Unpacked extensions, ones a policy or another program installed,
+// Chromium's own components and extensions from other stores stay here.
+bool IsWebStoreExtension(const extensions::Extension& extension);
+
+// Sf63: every Web Store extension installed here, enabled or not (a
+// blocklisted or blocked one is left out), by id, each name cut to
+// kMaxTextLength bytes.
+std::vector<ExtensionEntry> WebStoreExtensions(
+    content::BrowserContext* context);
+
+// Sf63, Sf66: hears the profile's extensions. `list_changed` runs when a Web
+// Store extension is installed, updated or uninstalled; `uninstalled_here`
+// when the person uninstalls one here, so it is not offered again on this
+// computer. An uninstall for an update, a reinstall or a component's removal
+// is not the person's.
+class ExtensionListWatch : public extensions::ExtensionRegistryObserver {
+ public:
+  ExtensionListWatch(
+      content::BrowserContext* context,
+      base::RepeatingClosure list_changed,
+      base::RepeatingCallback<void(const std::string& id)> uninstalled_here);
+  ExtensionListWatch(const ExtensionListWatch&) = delete;
+  ExtensionListWatch& operator=(const ExtensionListWatch&) = delete;
+  ~ExtensionListWatch() override;
+
+  // extensions::ExtensionRegistryObserver:
+  void OnExtensionInstalled(content::BrowserContext* browser_context,
+                            const extensions::Extension* extension,
+                            bool is_update) override;
+  void OnExtensionUninstalled(content::BrowserContext* browser_context,
+                              const extensions::Extension* extension,
+                              extensions::UninstallReason reason) override;
+  void OnShutdown(extensions::ExtensionRegistry* registry) override;
+
+ private:
+  base::RepeatingClosure list_changed_;
+  base::RepeatingCallback<void(const std::string& id)> uninstalled_here_;
+  base::ScopedObservation<extensions::ExtensionRegistry,
+                          extensions::ExtensionRegistryObserver>
+      observation_{this};
+};
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_EXTENSIONS_H_
