+// an app's own menu bar has none.
+TEST(MainMenuBuilderTest, TheFileMenuHasAddToDockExceptInAnApp) {
+  NSMenu* const file_menu =
+      chrome::BuildFileMenuForTesting(/*is_pwa=*/false).submenu;
+  NSMenuItem* const add_to_dock = [file_menu itemWithTag:IDC_STEDDING_MAKE_APP];
+  ASSERT_TRUE(add_to_dock);
+  EXPECT_NSEQ(l10n_util::GetNSStringWithFixup(IDS_STEDDING_ADD_TO_DOCK),
+              add_to_dock.title);
+  EXPECT_NSEQ(@"Add to Dock…", add_to_dock.title);
+  EXPECT_EQ(@selector(commandDispatch:), add_to_dock.action);
+  EXPECT_EQ(0u, add_to_dock.keyEquivalent.length)
+      << "Safari has no chord for it";
+  const NSInteger share = [file_menu
+      indexOfItemWithTitle:l10n_util::GetNSStringWithFixup(IDS_SHARE_MAC)];
+  ASSERT_NE(-1, share);
+  EXPECT_EQ(share + 1, [file_menu indexOfItem:add_to_dock]);
+
+  NSMenu* const app_file_menu =
+      chrome::BuildFileMenuForTesting(/*is_pwa=*/true).submenu;
+  EXPECT_FALSE([app_file_menu itemWithTag:IDC_STEDDING_MAKE_APP]);
+}
