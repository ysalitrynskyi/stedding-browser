#!/usr/bin/env python3
"""Capture every on-screen window a pid owns, each by window id.

    tooling/capture-windows PID PREFIX

Writes PREFIX.png for the largest window and PREFIX-2.png, PREFIX-3.png ...
for the rest, largest first. A dialog that is its own window (the welcome
flow, a bubble that became a window) is a second file; tooling/capture-window.py
would miss it. Like that script it captures by window id, never the screen, so
the browser need not be frontmost and nothing else on the display is
photographed. PID is the launched browser, or any process it started.
"""

import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from window_by_pid import parse_pid, windows_for_pid

# Below this a "window" is a shadow, a tooltip, or a short helper. 1x1 and
# menu-bar-height windows are already dropped by window_by_pid.py.
MIN_WIDTH = 200
MIN_HEIGHT = 100


def windows_for(pid: int) -> list[tuple[int, int, dict]]:
    """(area, window id, bounds) for every real on-screen window, largest first."""
    found = []
    for window in windows_for_pid(pid):
        if not window.get("kCGWindowIsOnscreen", 0):
            continue
        if window.get("kCGWindowLayer", 0) != 0:
            continue
        bounds = window.get("kCGWindowBounds", {})
        width, height = bounds.get("Width", 0), bounds.get("Height", 0)
        if width < MIN_WIDTH or height < MIN_HEIGHT:
            continue
        found.append((int(width * height), int(window["kCGWindowNumber"]), bounds))
    found.sort(reverse=True)
    return found


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print(f"usage: {argv[0]} PID PREFIX", file=sys.stderr)
        return 2
    try:
        pid = parse_pid(argv[1])
    except ValueError as exc:
        print(exc, file=sys.stderr)
        return 2
    prefix = argv[2]
    windows = windows_for(pid)
    if not windows:
        print(f"no window owned by pid {pid}", file=sys.stderr)
        return 1
    for index, (_, window_id, bounds) in enumerate(windows):
        out = f"{prefix}.png" if index == 0 else f"{prefix}-{index + 1}.png"
        # -x: no capture sound. -o: no window shadow, so the image is the window.
        subprocess.run(["screencapture", "-x", "-o", "-l", str(window_id), out],
                       check=True)
        print(f"{out}: window {window_id} at {int(bounds['X'])},{int(bounds['Y'])} "
              f"{int(bounds['Width'])}x{int(bounds['Height'])}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
