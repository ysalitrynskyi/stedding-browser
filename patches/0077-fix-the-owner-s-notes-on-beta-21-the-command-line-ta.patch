+void VerticalTabStripFocusSwipeController::OnSpaceWheel(ui::Event* event,
+                                                        float right,
+                                                        float down,
+                                                        bool notch,
+                                                        bool control) {
+  if (!region_view_ || region_view_->IsDragging()) {
+    return;
+  }
+  // Off the Mac, views::RootView hands a wheel event to the view under the
+  // pointer and then to each view above it until one takes it, and each of
+  // those dispatches runs this handler, the region's pre-target handler,
+  // again. The wheel reads an event once. Read again, a touchpad's first
+  // message counted once for every view between the row and the list, and a
+  // vertical two-finger scroll that began with a little sideways was locked
+  // as a sideways one: the wheel took every message after it, and the list
+  // did not scroll.
+  const uintptr_t event_address = reinterpret_cast<uintptr_t>(event);
+  if (event_address == last_wheel_event_ &&
+      event->time_stamp() == last_wheel_event_time_) {
+    return;
+  }
+  last_wheel_event_ = event_address;
+  last_wheel_event_time_ = event->time_stamp();
+  stedding::SpaceWheel::Event wheel;
+  wheel.time = event->time_stamp();
+  wheel.right = right;
+  wheel.down = down;
+  wheel.shift = event->IsShiftDown();
+  wheel.control = control;
+  wheel.notch = notch;
+  const stedding::SpaceWheel::Answer answer =
+      space_wheel_.OnWheel(wheel, base::i18n::IsRTL());
+  if (answer == stedding::SpaceWheel::Answer::kLeave) {
+    return;
+  }
+  event->SetHandled();
+  event->StopPropagation();
+  if (answer != stedding::SpaceWheel::Answer::kTake) {
+    space_swipe_.on_step.Run(answer == stedding::SpaceWheel::Answer::kNext);
+  }
+}
