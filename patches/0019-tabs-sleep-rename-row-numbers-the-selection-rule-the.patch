+void VerticalTabStripRegionView::OnCmdKeyEvent(const ui::KeyEvent& event) {
+  const bool is_cmd =
+      event.key_code() == ui::VKEY_LWIN || event.key_code() == ui::VKEY_RWIN;
+  if (event.type() == ui::EventType::kKeyPressed) {
+    if (is_cmd) {
+      if (!number_badges_showing_ && !cmd_hold_timer_.IsRunning()) {
+        cmd_hold_timer_.Start(
+            FROM_HERE, base::Milliseconds(250),
+            base::BindOnce(&VerticalTabStripRegionView::ShowNumberBadges,
+                           base::Unretained(this)));
+      }
+    } else {
+      // A chord: the user wanted the command, not the numbers.
+      cmd_hold_timer_.Stop();
+      HideNumberBadges();
+    }
+  } else if (event.type() == ui::EventType::kKeyReleased && is_cmd) {
+    cmd_hold_timer_.Stop();
+    HideNumberBadges();
+  }
+}
+
+void VerticalTabStripRegionView::ShowNumberBadges() {
+  if (!base::FeatureList::IsEnabled(stedding::kArcStyleWindow) ||
+      !browser_view() || !browser_view()->browser()) {
+    return;
+  }
+  const PrefService* const prefs =
+      browser_view()->browser()->GetProfile()->GetPrefs();
+  if (prefs && !prefs->GetBoolean(stedding::prefs::kHoldCmdNumbers)) {
+    return;
+  }
+  int number = 1;
+  for (tabs::TabInterface* tab :
+       stedding::NumberedTabs(browser_view()->browser()->tab_strip_model())) {
+    TabCollectionNode* const node =
+        root_node() ? root_node()->GetNodeForHandle(tab->GetHandle()) : nullptr;
+    if (auto* const view =
+            node ? views::AsViewClass<TabView>(node->view()) : nullptr) {
+      view->SetNumberBadge(number);
+    }
+    ++number;
+  }
+  if (space_switcher_) {
+    space_switcher_->SetNumberBadges(true);
+  }
+  number_badges_showing_ = true;
+}
+
+void VerticalTabStripRegionView::HideNumberBadges() {
