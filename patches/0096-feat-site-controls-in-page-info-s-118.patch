+  {
+    SCOPED_TRACE("Copy link with Option (Alt)");
+    SiteControlsStripView* const strip = Strip(OpenFromTheChip());
+    ASSERT_TRUE(strip);
+    Click(strip->copy_link(), ui::EF_ALT_DOWN);
+    EXPECT_EQ(u"[" + title + u"](" + base::UTF8ToUTF16(clean) + u")",
+              ClipboardText());
+    EXPECT_TRUE(PanelGoes());
+  }
+  {
+    SCOPED_TRACE("Copy title");
+    SiteControlsStripView* const strip = Strip(OpenFromTheChip());
