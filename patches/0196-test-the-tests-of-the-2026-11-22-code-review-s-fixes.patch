+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Two of the window's controls, as a user meets them: the Clear line's word
+// runs on a left click alone (spaces B17, sidebar Y24), and in a right-to-left
+// window a side-by-side split's address field sits over the active pane
+// (toolbar T49).
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/i18n/base_i18n_switches.h"
+#include "base/i18n/rtl.h"
+#include "base/run_loop.h"
