+// docs/features/sidebar-file.md Sf10-Sf27, Sf34, Sf41 (ADR 0029): the merge
+// of the sidebar that installs share through a folder. Pure: no browser
+// object, no file, no clock of its own. Every install computes the same
+// result from the same files, in any order.
+namespace spaces::sidebar_sync {
+
+// The format a file of this version writes. A file with a larger number is
+// read for its name only and never applied (Sf34).
+inline constexpr int kFormat = 1;
+
+// The synced fields. Every value is text; a flag is "1" or "0".
+inline constexpr char kFieldName[] = "name";
+inline constexpr char kFieldIcon[] = "icon";
+inline constexpr char kFieldColor[] = "color";
+inline constexpr char kFieldDarkColor[] = "dark_color";
+inline constexpr char kFieldColorChosen[] = "color_chosen";
+inline constexpr char kFieldIsolated[] = "isolated";
+inline constexpr char kFieldHome[] = "home";
+inline constexpr char kFieldTitle[] = "title";
+inline constexpr char kFieldParent[] = "parent";
+
+// The containers: the Space list, the shared essentials row, each Space's
+// pinned run and own essentials, and each folder (named by its own id).
+inline constexpr char kSpacesList[] = "spaces";
+inline constexpr char kEssentialsList[] = "essentials";
+std::string PinsListOf(std::string_view space_id);
+std::string OwnEssentialsListOf(std::string_view space_id);
+// The Space a "space:<id>/..." container belongs to; empty for any other.
+std::string SpaceOfList(std::string_view container);
+
+// The essentials row holds this many; the rest become pins (Sf41).
+inline constexpr size_t kEssentialsCap = 12;
+
+// The largest time a file or the ledger holds: the largest whole number a
+// JSON number keeps exactly, 2^53 - 1 (Sf33).
+inline constexpr int64_t kMaxTime = 9007199254740991;
+
+// A hybrid logical time: milliseconds, then the install id of the writer,
+// which breaks a tie the same way on every install (Sf15).
+struct Stamp {
+  int64_t t = 0;
+  std::string w;
+
+  friend bool operator==(const Stamp&, const Stamp&) = default;
+  friend std::strong_ordering operator<=>(const Stamp& a, const Stamp& b) {
+    if (const auto by_time = a.t <=> b.t; by_time != 0) {
+      return by_time;
+    }
+    const int by_writer = a.w.compare(b.w);
+    return by_writer < 0   ? std::strong_ordering::less
+           : by_writer > 0 ? std::strong_ordering::greater
+                           : std::strong_ordering::equal;
+  }
+};
+
+// The next local time: never behind the wall clock, never behind anything
+// seen (Sf15), and never past kMaxTime, so what it stamps can still be
+// written and read back (Sf27).
+int64_t NextTime(int64_t now_ms, int64_t max_seen);
+
+struct Field {
+  std::string v;
+  Stamp s;
+
+  friend bool operator==(const Field&, const Field&) = default;
+};
+
+enum class Kind { kSpace, kFolder, kTab };
+std::string_view KindName(Kind kind);
+std::optional<Kind> KindFromName(std::string_view name);
+
+struct Record {
+  Record();
+  explicit Record(Kind kind);
+  Record(const Record& other);
+  Record(Record&& other);
+  Record& operator=(const Record& other);
+  Record& operator=(Record&& other);
+  ~Record();
+
+  Kind kind = Kind::kTab;
+  std::map<std::string, Field> f;
+  // A tombstone: the item was removed at this time (Sf18).
+  std::optional<Stamp> del;
+  // Keys of the record this version does not know, as JSON text, written
+  // back unchanged (Sf34).
+  std::map<std::string, std::string> x;
+
+  // The latest time any field was written.
+  Stamp Latest() const;
+  // Not removed, or edited after it was removed (Sf26).
+  bool Alive() const;
+  // The field's value, empty when there is none.
+  const std::string& Get(std::string_view field) const;
+
+  friend bool operator==(const Record&, const Record&) = default;
+};
+
+struct List {
+  List();
+  List(const List& other);
+  List(List&& other);
+  List& operator=(const List& other);
+  List& operator=(List&& other);
+  ~List();
+
+  std::vector<std::string> order;
+  Stamp s;
+
+  friend bool operator==(const List&, const List&) = default;
+};
+
+// The synced sidebar: what each install keeps in its ledger and writes to
+// its file.
+struct State {
+  State();
+  State(const State& other);
+  State(State&& other);
+  State& operator=(const State& other);
+  State& operator=(State&& other);
+  ~State();
+
+  std::map<std::string, Record> records;
+  std::map<std::string, List> lists;
+  // Pairing (Sf10): an id to the id it is one item with.
+  std::map<std::string, std::string> aliases;
+
+  // The record `id`, alive, or null.
+  const Record* FindAlive(const std::string& id) const;
+  // The latest time anything carries.
+  int64_t MaxTime() const;
+  // The alive records whose parent is `container`, in the container's order
+  // with any the list lacks at its end.
+  std::vector<std::string> ChildrenOf(const std::string& container) const;
+  size_t AliveTabCount() const;
+
+  friend bool operator==(const State&, const State&) = default;
+};
+
+// What this install shows now, read from its windows: each synced item with
+// its fields, and each container's order.
+struct LocalItem {
+  LocalItem();
+  LocalItem(const LocalItem& other);
+  LocalItem& operator=(const LocalItem& other);
+  ~LocalItem();
+
+  Kind kind = Kind::kTab;
+  std::map<std::string, std::string> fields;
+};
+
+struct LocalView {
+  LocalView();
+  LocalView(const LocalView& other);
+  LocalView(LocalView&& other);
+  LocalView& operator=(const LocalView& other);
+  LocalView& operator=(LocalView&& other);
+  ~LocalView();
+
+  std::map<std::string, LocalItem> items;
+  std::map<std::string, std::vector<std::string>> lists;
+};
+
+// Sf12, Sf15, Sf18: records what the user changed here. A field is stamped
+// only when it differs from `before` (the last view this install saw) --
+// never because the ledger holds a newer value not yet shown, which would
+// undo another computer's change. An item new to the ledger is stamped
+// whole. An item removed by this install and back again (reopened) is
+// revived. Only `tombstones` are removed: absence never is (Sf19). A list is
+// stamped when its order changed here, keeping the slots of items that are
+// not here. True when the ledger changed.
+bool RecordLocalEdits(State& ledger,
+                      const LocalView* before,
+                      const LocalView& now,
+                      const std::set<std::string>& tombstones,
+                      const Stamp& stamp);
+
+// `winner`, then each id of `other` it lacks right after the id it followed
+// in `other`, else at the end (Sf16).
+std::vector<std::string> MergeOrder(const std::vector<std::string>& winner,
+                                    const std::vector<std::string>& other);
+
+// Sf15, Sf16, Sf26: `peer` merged into `into`, each field, list and
+// tombstone keeping its later stamp. True when `into` changed.
+bool MergeState(State& into, const State& peer);
+
+// What a merge changed, as the user is told it and the guard weighs it.
+struct Batch {
+  Batch();
+  Batch(const Batch& other);
+  Batch& operator=(const Batch& other);
+  ~Batch();
+
+  std::vector<std::string> added;
+  std::vector<std::string> removed;
+  std::map<std::string, std::set<std::string>> changed;
+  std::vector<std::string> reordered;
+
+  bool empty() const;
+  size_t removed_spaces = 0;
+  size_t removed_tabs = 0;
+};
+Batch Diff(const State& before, const State& after);
+
+// Sf22, Sf23: whether one computer's batch waits for the user, whole: five
+// or more removals, a third or more of the synced pins, more than fifty
+// additions, or any Space deleted.
+bool ShouldHold(const Batch& batch, const State& before);
+
+// Sf27: a time more than 24 hours past `now_ms`, which only a computer whose
+// clock runs that far ahead writes.
+bool ClockFarAhead(int64_t written_ms, int64_t now_ms);
+
+// Sf10: every alias resolved to the smallest id it reaches, so two computers
+// joining at once and a third settle on one id.
+std::map<std::string, std::string> ResolveAliases(
+    const std::map<std::string, std::string>& aliases);
+// `id` under `resolved`; a container "space:<id>/..." by its Space.
+std::string Canonical(const std::map<std::string, std::string>& resolved,
+                      const std::string& id);
+// `state` with every id, parent and list under its resolved alias; two
+// records that become one are merged field by field.
+State Canonicalize(const State& state,
+                   const std::map<std::string, std::string>& resolved);
+// Sf12: `view` with every id, parent and list under its resolved alias: a
+// view read before the ledger's aliases were known, as one read after.
+LocalView CanonicalView(const LocalView& view,
+                        const std::map<std::string, std::string>& resolved);
+
+// Sf10: a pair offered at the first join.
+struct Pair {
+  Pair();
+  Pair(const Pair& other);
+  Pair& operator=(const Pair& other);
+  ~Pair();
+
+  std::string local_id;
+  std::string peer_id;
+  Kind kind = Kind::kSpace;
+  // What the sheet shows: the Space's name, the pin's name or home.
+  std::string label;
+};
+// Spaces pair by trimmed, case-folded name with exactly one each side; pins
+// inside a paired Space or folder by home and name, folders by title,
+// essentials by home, always one candidate each side.
+std::vector<Pair> ProposePairs(const State& local, const State& peers);
+// The aliases `accepted` makes: the larger id to the smaller.
+std::map<std::string, std::string> AliasesFor(const std::vector<Pair>& accepted);
+
+// Sf26: drops the tombstones received more than 180 days before `now_ms`,
+// never one in `held`. `received` maps an id to when its tombstone arrived
+// here. True when something was dropped.
+bool PruneTombstones(State& state,
+                     const std::map<std::string, int64_t>& received,
+                     int64_t now_ms,
+                     const std::set<std::string>& held);
+
+// Sf41: the shared essentials past the twelfth move to the end of the first
+// Space's pinned run, stamped `stamp`. True when something moved.
+bool MoveEssentialsPastTheCap(State& state, const Stamp& stamp);
+
+// The block written into the file and the ledger: records, lists, aliases.
+base::DictValue StateToValue(const State& state);
+// Nullopt for a block that is not well formed (Sf33).
+std::optional<State> StateFromValue(const base::DictValue& value);
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_STATE_H_
