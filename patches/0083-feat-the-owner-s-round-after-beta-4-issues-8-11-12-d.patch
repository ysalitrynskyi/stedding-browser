@@ -0,0 +1,115 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PAGE_ACTION_STEDDING_COPY_LINK_PAGE_ACTION_CONTROLLER_H_
+#define CHROME_BROWSER_UI_VIEWS_PAGE_ACTION_STEDDING_COPY_LINK_PAGE_ACTION_CONTROLLER_H_
+
+#include <string>
+
+#include "base/memory/raw_ref.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/tabs/contents_observing_tab_feature.h"
+#include "components/prefs/pref_member.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class GURL;
+class PrefService;
+
+namespace content {
+class NavigationHandle;
+class Page;
+class WebContents;
+enum class Visibility;
+}  // namespace content
+
+namespace gfx {
+struct VectorIcon;
+}  // namespace gfx
+
+namespace page_actions {
+class PageActionController;
+}  // namespace page_actions
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace stedding {
+
+// copy-link L7 (GitHub issue 11; the owner, 2026-10-22): the Copy Link button
+// at the address field's trailing end, just before the star. It is
+// Chromium's own Copy Link action (kActionCopyUrl) shown as a page action:
+// a click runs what Shift-Cmd-C runs, an Option-click (Alt-click) what
+// Option-Shift-Cmd-C runs (BrowserActions handles both). This controller,
+// one per tab of a normal or private window, says when the button shows --
+// the setting on and the tab's address a web one -- gives it its name and
+// its chord, and turns its icon into a check mark for a moment after a
+// click.
+class CopyLinkPageActionController : public tabs::ContentsObservingTabFeature {
+ public:
+  DECLARE_USER_DATA(CopyLinkPageActionController);
+
+  // How long the check mark stays after a click.
+  static constexpr base::TimeDelta kCopiedDuration = base::Milliseconds(1500);
+
+  CopyLinkPageActionController(
+      tabs::TabInterface& tab,
+      PrefService* pref_service,
+      page_actions::PageActionController& page_action_controller);
+  ~CopyLinkPageActionController() override;
+
+  CopyLinkPageActionController(const CopyLinkPageActionController&) = delete;
+  CopyLinkPageActionController& operator=(const CopyLinkPageActionController&) =
+      delete;
+
+  static CopyLinkPageActionController* From(tabs::TabInterface* tab);
+
+  // Whether the button belongs on a page at `url`, the address the copy
+  // takes: http and https only. The new tab page, a browser page (chrome:),
+  // a file, a view-source: page, about:blank and data: have none.
+  static bool ShowsFor(const GURL& url);
+
+  // "Copy Link", and the chord for it as the menus print it: Shift-Cmd-C in
+  // the Mac's symbols, "Copy Link (Ctrl+Shift+C)" elsewhere.
+  static std::u16string Tooltip();
+
+  // The check mark the icon turns into after a click, in the icon set the
+  // link's own icon comes from.
+  static const gfx::VectorIcon& CopiedIcon();
+
+  // After a click: the check mark for kCopiedDuration, then the link again.
+  // A second click restarts the wait; leaving the page, or the button
+  // hiding, ends it at once.
+  void ShowCopied();
+
+ private:
+  // content::WebContentsObserver:
+  void DidStartNavigation(content::NavigationHandle* navigation) override;
+  void DidFinishNavigation(content::NavigationHandle* navigation) override;
+  void PrimaryPageChanged(content::Page& page) override;
+  void OnVisibilityChanged(content::Visibility visibility) override;
+
+  // tabs::ContentsObservingTabFeature:
+  void OnDiscardContents(tabs::TabInterface* tab,
+                         content::WebContents* old_contents,
+                         content::WebContents* new_contents) override;
+
+  // Shows or hides the button for the tab's page and the setting.
+  void Update();
+  // The link's icon again, after the check mark.
+  void ClearCopied();
+
+  const raw_ref<page_actions::PageActionController> page_action_controller_;
+  // stedding.toolbar.copy_link_button (settings T28).
+  BooleanPrefMember button_enabled_;
+  base::OneShotTimer copied_timer_;
+
+  ui::ScopedUnownedUserData<CopyLinkPageActionController>
+      scoped_unowned_user_data_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PAGE_ACTION_STEDDING_COPY_LINK_PAGE_ACTION_CONTROLLER_H_
