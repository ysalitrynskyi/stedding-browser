+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_CLEAN_LINKS_THROTTLE_H_
+#define CHROME_BROWSER_UI_STEDDING_CLEAN_LINKS_THROTTLE_H_
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+#include "url/gurl.h"
+
+class PrefService;
+
+namespace network {
+struct ResourceRequest;
+}  // namespace network
+
+namespace stedding {
+
+// Clean links (docs/features/clean-links.md Cl1, Cl3): a page the user opens
+// loads without its tracking parameters, and a known redirect page is
+// skipped to the address it carries. The throttle rewrites the request's URL
+// in WillStartRequest, before anything is sent; the loader turns that into
+// an internal 307, so the address field, the page's own location and history
+// see the clean address, and the site's server never sees the other one.
+// When the loader later restarts at the address the request was made for (a
+// site that asks for client hints with Critical-CH, a language restart), the
+// throttle turns that restart to the clean address too (Cl12).
+//
+// Made on the UI thread for each navigation's loader, it decides there,
+// from the request and the profile's preferences, and holds the address it
+// will open; it reads nothing later, so it may move to another sequence.
+class CleanLinksThrottle : public blink::URLLoaderThrottle {
+ public:
+  // A throttle for `request` when it is a navigation the user's link,
+  // typed address, bookmark or other app opens and cleaning changes its
+  // address; null otherwise. Never for (Cl4) a subresource, a worker, a
+  // frame inside a page, a POST, a form, a reload or a restored page, back
+  // or forward, anything not http or https; nor (Cl5) a redirect's leg,
+  // which a server chose: only the first address of a navigation is
+  // cleaned; nor (Cl13) a navigation the page at `page_url` started with no
+  // click behind it to its own address, which the page chose. Null too
+  // while the setting is off (Cl7), for a kept site (Cl8), and (Cl14) for a
+  // Google search page when `force_google_safe_search` is on, since Google's
+  // own throttle changes that address and a loader takes one change only.
+  //
+  // `page_url` is the address the tab shows as the navigation starts (empty
+  // for a new tab); `force_google_safe_search` is the profile's
+  // ForceGoogleSafeSearch policy.
+  static std::unique_ptr<blink::URLLoaderThrottle> MaybeCreate(
+      const network::ResourceRequest& request,
+      std::optional<int64_t> navigation_id,
+      const PrefService& prefs,
+      const GURL& page_url,
+      bool force_google_safe_search);
+
+  CleanLinksThrottle(const CleanLinksThrottle&) = delete;
+  CleanLinksThrottle& operator=(const CleanLinksThrottle&) = delete;
+  ~CleanLinksThrottle() override;
+
+  // blink::URLLoaderThrottle:
+  void DetachFromCurrentSequence() override;
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override;
+  void WillRestartWithURLReset(GURL* url) override;
+
+ private:
+  CleanLinksThrottle(GURL from, GURL to);
+
+  // The address the request was made for, and the one it opens instead.
+  const GURL from_;
+  const GURL to_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_CLEAN_LINKS_THROTTLE_H_
diff --git a/chrome/browser/ui/stedding/clean_links_throttle_unittest.cc b/chrome/browser/ui/stedding/clean_links_throttle_unittest.cc
new file mode 100644
index 0000000000000..d6fbfecdfec98
--- /dev/null
+++ b/chrome/browser/ui/stedding/clean_links_throttle_unittest.cc
@@ -0,0 +1,330 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/clean_links_throttle.h"
+
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/stedding/clean_links.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "net/http/http_request_headers.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/loader/url_loader_throttle.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace stedding {
+namespace {
+
+constexpr std::optional<int64_t> kNavigation = 7;
+
+class CleanLinksThrottleTest : public testing::Test {
+ protected:
+  CleanLinksThrottleTest() {
+    prefs::RegisterProfilePrefs(prefs_.registry());
+  }
+
+  // A link clicked in the page: the first leg of a top-level GET.
+  static network::ResourceRequest LinkTo(const std::string& url) {
+    network::ResourceRequest request;
+    request.url = GURL(url);
+    request.method = net::HttpRequestHeaders::kGetMethod;
+    request.destination = network::mojom::RequestDestination::kDocument;
+    request.is_outermost_main_frame = true;
+    request.transition_type = ui::PAGE_TRANSITION_LINK;
+    request.navigation_redirect_chain.push_back(request.url);
+    return request;
+  }
+
+  // A navigation the page at `page` started by script, with no click
+  // behind it: a meta refresh or a script redirect.
+  static network::ResourceRequest StartedByThePage(const std::string& url,
+                                                   const GURL& page) {
+    network::ResourceRequest request = LinkTo(url);
+    request.request_initiator = url::Origin::Create(page);
+    request.has_user_gesture = false;
+    request.transition_type =
+        ui::PAGE_TRANSITION_LINK | ui::PAGE_TRANSITION_CLIENT_REDIRECT;
+    return request;
+  }
+
+  // The throttle for `request`, made as the browser makes it, with the tab
+  // showing `page_url_` and the SafeSearch policy at `force_safe_search_`.
+  std::unique_ptr<blink::URLLoaderThrottle> Make(
+      const network::ResourceRequest& request,
+      std::optional<int64_t> navigation_id = kNavigation) {
+    return CleanLinksThrottle::MaybeCreate(request, navigation_id, prefs_,
+                                           page_url_, force_safe_search_);
+  }
+
+  // What the request asks for once the throttle has run, or its own address
+  // when no throttle is made.
+  GURL Opened(network::ResourceRequest request,
+              std::optional<int64_t> navigation_id = kNavigation) {
+    std::unique_ptr<blink::URLLoaderThrottle> throttle =
+        Make(request, navigation_id);
+    if (!throttle) {
+      return request.url;
+    }
+    bool defer = false;
+    throttle->WillStartRequest(&request, &defer);
+    EXPECT_FALSE(defer) << "clean links never waits";
+    return request.url;
+  }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+  // The address the tab shows as the navigation starts; empty for a new tab.
+  GURL page_url_;
+  bool force_safe_search_ = false;
+};
+
+// Cl1, Cl7: on by default, a link opens without its tracking parameters;
+// the rest of the address keeps its order, encoding and fragment.
+TEST_F(CleanLinksThrottleTest, StripsATopLevelGet) {
+  ASSERT_TRUE(CleanLinksOn(prefs_));
+  EXPECT_EQ(GURL("https://a.test/p?q=a%20b&page=2#top"),
+            Opened(LinkTo("https://a.test/p?utm_source=x&q=a%20b&fbclid=y"
+                          "&page=2#top")));
+  // A typed address and a bookmark go the same way.
+  network::ResourceRequest typed = LinkTo("http://a.test/?gclid=1");
+  typed.transition_type =
+      ui::PAGE_TRANSITION_TYPED | ui::PAGE_TRANSITION_FROM_ADDRESS_BAR;
+  EXPECT_EQ(GURL("http://a.test/"), Opened(typed));
+  network::ResourceRequest bookmark = LinkTo("https://a.test/?utm_medium=b");
+  bookmark.transition_type = ui::PAGE_TRANSITION_AUTO_BOOKMARK;
+  EXPECT_EQ(GURL("https://a.test/"), Opened(bookmark));
+  // A clean address needs no throttle at all.
+  EXPECT_FALSE(Make(LinkTo("https://a.test/?q=1")));
+}
+
+// Cl3: a known redirect page is skipped to its target, cleaned in the same
+// step; the wrapper's address is never requested.
+TEST_F(CleanLinksThrottleTest, SkipsARedirectPage) {
+  EXPECT_EQ(GURL("https://b.test/article"),
+            Opened(LinkTo("https://www.google.com/url?sa=t&q=https%3A%2F%2F"
+                          "b.test%2Farticle%3Futm_source%3Dgoogle")));
+  // A shortener is asked, as the user asked it.
+  EXPECT_EQ(GURL("https://t.co/abc"), Opened(LinkTo("https://t.co/abc")));
+}
+
+// Cl4: only the outermost page of a navigation is touched.
+TEST_F(CleanLinksThrottleTest, OnlyTopLevelDocumentsAreCleaned) {
+  const std::string tracked = "https://a.test/p?utm_source=x";
+  EXPECT_FALSE(Make(LinkTo(tracked), std::nullopt))
+      << "no navigation: a preload or a fetch of the browser's own";
+
+  network::ResourceRequest image = LinkTo(tracked);
+  image.destination = network::mojom::RequestDestination::kImage;
+  EXPECT_FALSE(Make(image));
+
+  network::ResourceRequest worker = LinkTo(tracked);
+  worker.destination = network::mojom::RequestDestination::kServiceWorker;
+  EXPECT_FALSE(Make(worker));
+
+  network::ResourceRequest frame = LinkTo(tracked);
+  frame.destination = network::mojom::RequestDestination::kIframe;
+  frame.is_outermost_main_frame = false;
+  EXPECT_FALSE(Make(frame));
+
+  network::ResourceRequest fenced = LinkTo(tracked);
+  fenced.destination = network::mojom::RequestDestination::kFencedframe;
+  fenced.is_outermost_main_frame = false;
+  EXPECT_FALSE(Make(fenced));
+}
+
+// Cl4: a POST, a form (GET forms too), a reload, a restored page, back and
+// forward, and anything not http or https keep their address.
+TEST_F(CleanLinksThrottleTest, LeavesPostsFormsReloadsAndHistoryAlone) {
+  const std::string tracked = "https://a.test/p?utm_source=x";
+
+  network::ResourceRequest post = LinkTo(tracked);
+  post.method = net::HttpRequestHeaders::kPostMethod;
+  EXPECT_EQ(GURL(tracked), Opened(post));
+
+  network::ResourceRequest form = LinkTo(tracked);
+  form.transition_type = ui::PAGE_TRANSITION_FORM_SUBMIT;
+  EXPECT_EQ(GURL(tracked), Opened(form));
+
+  network::ResourceRequest reload = LinkTo(tracked);
+  reload.transition_type = ui::PAGE_TRANSITION_RELOAD;
+  EXPECT_EQ(GURL(tracked), Opened(reload));
+
+  network::ResourceRequest reloaded_link = LinkTo(tracked);
+  reloaded_link.is_reload_navigation = true;
+  EXPECT_EQ(GURL(tracked), Opened(reloaded_link));
+
+  network::ResourceRequest back = LinkTo(tracked);
+  back.transition_type =
+      ui::PAGE_TRANSITION_LINK | ui::PAGE_TRANSITION_FORWARD_BACK;
+  EXPECT_EQ(GURL(tracked), Opened(back));
+
+  network::ResourceRequest file = LinkTo("file:///tmp/a.html?utm_source=x");
+  EXPECT_EQ(GURL("file:///tmp/a.html?utm_source=x"), Opened(file));
+}
+
+// Cl5: a loader made again for a redirect's leg leaves the server's address
+// as it is, so a server that puts a parameter back gets it, and a redirect
+// that adds one is followed as given.
+TEST_F(CleanLinksThrottleTest, AServerThatAsksForTheParameterBackGetsIt) {
+  network::ResourceRequest leg = LinkTo("https://a.test/p?utm_source=x");
+  leg.navigation_redirect_chain = {GURL("https://a.test/p?utm_source=x"),
+                                   GURL("https://a.test/p"),
+                                   GURL("https://a.test/p?utm_source=x")};
+  EXPECT_EQ(GURL("https://a.test/p?utm_source=x"), Opened(leg));
+}
+
+// Cl7: off, every page opens as it was written, redirect pages included; the
+// next navigation reads the change.
+TEST_F(CleanLinksThrottleTest, TheSettingOffLeavesEveryLinkAlone) {
+  prefs_.SetBoolean(prefs::kCleanLinks, false);
+  EXPECT_EQ(GURL("https://a.test/?utm_source=x"),
+            Opened(LinkTo("https://a.test/?utm_source=x")));
+  EXPECT_EQ(GURL("https://www.google.com/url?q=https://b.test/"),
+            Opened(LinkTo("https://www.google.com/url?q=https://b.test/")));
+  prefs_.SetBoolean(prefs::kCleanLinks, true);
+  EXPECT_EQ(GURL("https://a.test/"),
+            Opened(LinkTo("https://a.test/?utm_source=x")));
+}
+
+// Cl8: a kept site and its subdomains open with their parameters; another
+// site is still cleaned.
+TEST_F(CleanLinksThrottleTest, AKeptSiteIsLeftAlone) {
+  AddCleanLinksKeptSite(prefs_, "shop.test");
+  EXPECT_EQ(GURL("https://shop.test/?gclid=1"),
+            Opened(LinkTo("https://shop.test/?gclid=1")));
+  EXPECT_EQ(GURL("https://www.shop.test/?gclid=1"),
+            Opened(LinkTo("https://www.shop.test/?gclid=1")));
+  EXPECT_EQ(GURL("https://other.test/"),
+            Opened(LinkTo("https://other.test/?gclid=1")));
+  RemoveCleanLinksKeptSite(prefs_, "shop.test");
+  EXPECT_EQ(GURL("https://shop.test/"),
+            Opened(LinkTo("https://shop.test/?gclid=1")));
+}
+
+// Cl8: a redirect page into a kept site is skipped, and the target keeps its
+// parameters.
+TEST_F(CleanLinksThrottleTest, AKeptTargetIsUnwrappedButNotCleaned) {
+  AddCleanLinksKeptSite(prefs_, "shop.test");
+  EXPECT_EQ(GURL("https://shop.test/?gclid=1"),
+            Opened(LinkTo("https://www.google.com/url?q=https%3A%2F%2F"
+                          "shop.test%2F%3Fgclid%3D1")));
+}
+
+// Cl8: a kept redirect page is opened, as written.
+TEST_F(CleanLinksThrottleTest, AKeptWrapperIsNotUnwrapped) {
+  AddCleanLinksKeptSite(prefs_, "google.com");
+  const std::string wrapper =
+      "https://www.google.com/url?q=https%3A%2F%2Fb.test%2F%3Fgclid%3D1";
+  EXPECT_EQ(GURL(wrapper), Opened(LinkTo(wrapper)));
+}
+
+// Cl9: the list holds each site once, and removing takes it out.
+TEST_F(CleanLinksThrottleTest, TheKeptListHoldsEachSiteOnce) {
+  EXPECT_TRUE(CleanLinksKeptSites(prefs_).empty());
+  AddCleanLinksKeptSite(prefs_, "shop.test");
+  AddCleanLinksKeptSite(prefs_, "shop.test");
+  AddCleanLinksKeptSite(prefs_, "");
+  EXPECT_EQ(std::vector<std::string>({"shop.test"}),
+            CleanLinksKeptSites(prefs_));
+  RemoveCleanLinksKeptSite(prefs_, "shop.test");
+  EXPECT_TRUE(CleanLinksKeptSites(prefs_).empty());
+}
+
+// Cl12: a restart at the address the request was made for (Critical-CH, a
+// language restart) asks for the clean address again; any other address the
+// loader restarts at is left as it is.
+TEST_F(CleanLinksThrottleTest, ARestartAsksForTheCleanAddressAgain) {
+  const GURL tracked("https://a.test/p?utm_source=x&q=1");
+  std::unique_ptr<blink::URLLoaderThrottle> throttle =
+      Make(LinkTo(tracked.spec()));
+  ASSERT_TRUE(throttle);
+  GURL restart = tracked;
+  throttle->WillRestartWithURLReset(&restart);
+  EXPECT_EQ(GURL("https://a.test/p?q=1"), restart);
+
+  GURL other("https://b.test/?utm_source=y");
+  throttle->WillRestartWithURLReset(&other);
+  EXPECT_EQ(GURL("https://b.test/?utm_source=y"), other);
+
+  // A skipped redirect page restarts at its target, never at itself.
+  std::unique_ptr<blink::URLLoaderThrottle> unwrap = Make(
+      LinkTo("https://www.google.com/url?q=https%3A%2F%2Fb.test%2Fr%3F"
+             "gclid%3D1"));
+  ASSERT_TRUE(unwrap);
+  GURL wrapper(
+      "https://www.google.com/url?q=https%3A%2F%2Fb.test%2Fr%3Fgclid%3D1");
+  unwrap->WillRestartWithURLReset(&wrapper);
+  EXPECT_EQ(GURL("https://b.test/r"), wrapper);
+}
+
+// Cl13: a page that sends itself, with no click behind it, to its own
+// address with a tracking parameter gets it, so it does not load forever.
+// A click, another page, another path or a navigation the browser started
+// is still cleaned.
+TEST_F(CleanLinksThrottleTest, APageThatAsksForItsOwnParameterGetsIt) {
+  page_url_ = GURL("https://a.test/p?n=1");
+  const std::string own = "https://a.test/p?utm_source=x&n=1";
+  EXPECT_EQ(GURL(own), Opened(StartedByThePage(own, page_url_)));
+
+  // A script that runs after the page has loaded makes no client redirect;
+  // the same.
+  network::ResourceRequest later = StartedByThePage(own, page_url_);
+  later.transition_type = ui::PAGE_TRANSITION_LINK;
+  EXPECT_EQ(GURL(own), Opened(later));
+
+  network::ResourceRequest clicked = StartedByThePage(own, page_url_);
+  clicked.has_user_gesture = true;
+  EXPECT_EQ(GURL("https://a.test/p?n=1"), Opened(clicked));
+
+  EXPECT_EQ(GURL("https://a.test/q?n=1"),
+            Opened(StartedByThePage("https://a.test/q?utm_source=x&n=1",
+                                    page_url_)));
+  EXPECT_EQ(GURL("https://b.test/p"),
+            Opened(StartedByThePage("https://b.test/p?utm_source=x",
+                                    page_url_)));
+
+  // Typed again in the address field: the browser started it.
+  EXPECT_EQ(GURL("https://a.test/p?n=1"), Opened(LinkTo(own)));
+
+  // A new tab shows nothing yet.
+  page_url_ = GURL();
+  EXPECT_EQ(GURL("https://a.test/p?n=1"),
+            Opened(StartedByThePage(own, GURL("https://a.test/p"))));
+}
+
+// Cl14: with the ForceGoogleSafeSearch policy on, a Google search page is
+// left to Google's throttle, the only one that then changes its address at
+// the start; a redirect page skipped into a Google search opens it cleaned
+// and with SafeSearch's parameters; other pages are cleaned as ever.
+TEST_F(CleanLinksThrottleTest, TheSafeSearchPolicyKeepsOneChangeOfAddress) {
+  const std::string search = "https://www.google.com/search?q=x&utm_source=y";
+  EXPECT_EQ(GURL("https://www.google.com/search?q=x"),
+            Opened(LinkTo(search)))
+      << "without the policy, a search page is cleaned";
+
+  force_safe_search_ = true;
+  EXPECT_FALSE(Make(LinkTo(search)));
+  EXPECT_FALSE(Make(LinkTo("https://www.google.com/?utm_source=y")));
+  EXPECT_EQ(GURL("https://www.google.com/search?q=y&safe=active&ssui=on"),
+            Opened(LinkTo("https://www.google.com/url?q=https%3A%2F%2F"
+                          "www.google.com%2Fsearch%3Fq%3Dy%26utm_source%3Dz")));
+  EXPECT_EQ(GURL("https://a.test/p"),
+            Opened(LinkTo("https://a.test/p?utm_source=x")));
+  // A search page that already has the policy's parameters is not changed
+  // by Google's throttle, so it is cleaned.
+  EXPECT_EQ(GURL("https://www.google.com/search?q=x&safe=active&ssui=on"),
+            Opened(LinkTo("https://www.google.com/search?q=x&utm_source=y"
+                          "&safe=active&ssui=on")));
+}
+
+}  // namespace
+}  // namespace stedding
