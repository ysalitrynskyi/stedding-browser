+// Sf35: a backup goes through Import sidebar…'s own merge by id.
+void SteddingSpacesHandler::HandleImportSyncBackup(
+    const base::ListValue& args) {
+  AllowJavascript();
+  spaces::SidebarSyncService* const sync = SyncService();
+  BrowserWindowInterface* const browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  const base::FilePath path =
+      sync && args.size() == 1U && args[0].is_string()
+          ? sync->BackupPath(args[0].GetString())
+          : base::FilePath();
+  if (!browser || path.empty()) {
+    PushSyncStatus();
+    return;
+  }
+  spaces::ImportSidebarFileAsync(
+      browser, path,
+      base::BindOnce(&SteddingSpacesHandler::OnSidebarFileImported,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SteddingSpacesHandler::HandleShowSyncFolder(const base::ListValue& args) {
+  AllowJavascript();
+  spaces::SidebarSyncService* const sync = SyncService();
+  if (sync && sync->enabled()) {
+    platform_util::ShowItemInFolder(Profile::FromWebUI(web_ui()),
+                                    sync->folder());
+  }
+  PushSyncStatus();
+}
+
+// Sf28: shows a sync tool's copy in its folder. Only a name the folder's
+// listing gave, never a path.
+void SteddingSpacesHandler::HandleShowSyncConflict(
+    const base::ListValue& args) {
+  AllowJavascript();
+  spaces::SidebarSyncService* const sync = SyncService();
+  if (!sync || !sync->enabled() || args.size() != 1U || !args[0].is_string()) {
+    PushSyncStatus();
+    return;
+  }
+  const std::string& name = args[0].GetString();
+  const base::FilePath file = base::FilePath::FromUTF8Unsafe(name);
+  if (name.empty() || file.BaseName() != file ||
+      spaces::sidebar_sync::ClassifyFolderEntry(name, std::string()) !=
+          spaces::sidebar_sync::EntryKind::kConflictCopy) {
+    PushSyncStatus();
+    return;
+  }
+  platform_util::ShowItemInFolder(Profile::FromWebUI(web_ui()),
+                                  sync->folder().Append(file));
+  PushSyncStatus();
 }
 
