+void SpaceModel::MoveToSpacePinBoundary(tabs::TabInterface* tab) {
+  const int index = tab_strip_model_->GetIndexOfTab(tab);
+  if (index == TabStripModel::kNoTab || tab->IsPinned()) {
+    return;
+  }
+  // The end of the run of Space-pinned tabs at the top of the unpinned block,
+  // `tab` counted in it wherever it is, so an unpin from the middle of the
+  // run lands past the pins that stay.
+  int end = tab_strip_model_->IndexOfFirstNonPinnedTab();
+  while (end < tab_strip_model_->count()) {
+    const tabs::TabInterface* const each = tab_strip_model_->GetTabAtIndex(end);
+    if (each != tab && !IsSpacePinned(each)) {
+      break;
+    }
+    ++end;
+  }
+  // The index the tab ends up at once it has left its own place.
+  const int to = index < end ? end - 1 : end;
+  if (to != index) {
+    tab_strip_model_->MoveWebContentsAt(index, to, false);
+  }
+}
