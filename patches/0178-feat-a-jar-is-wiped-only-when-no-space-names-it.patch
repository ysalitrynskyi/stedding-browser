+// sessions S46: Clear empties one jar, and every Space with that session on
+// hears of it, so every window reloads their tabs. A Space that keeps the jar
+// with its session off has no tab in it.
+TEST_F(SharedSessionWindowTest, ClearingASessionReloadsEverySpaceInIt) {
+  class Heard : public SpaceRegistry::Observer {
+   public:
+    void OnSpaceJarWiped(const SpaceId& id) override { ids.push_back(id); }
+    std::vector<SpaceId> ids;
+  };
+  const SpaceId mail = model().AddSpace("Mail", kBlue)->id();
+  const SpaceId docs = model().AddSpace("Docs", kBlue)->id();
+  const SpaceId off = model().AddSpace("Off", kBlue)->id();
+  const std::string jar = ShareSession(mail, docs);
+  model().SetSpaceSession(off, jar);
+  model().SetSpaceIsolated(off, false);
+  OpenTabIn(mail);
+  const GURL url("https://example.com/");
+  PutCookie(profile(), ConfigFor(jar), url);
+
+  Heard heard;
+  registry().AddObserver(&heard);
+  base::RunLoop loop;
+  EXPECT_TRUE(model().WipeIsolatedSession(docs, loop.QuitClosure()));
+  loop.Run();
+  registry().RemoveObserver(&heard);
+
+  EXPECT_TRUE(WasWiped(ConfigFor(jar), url));
+  EXPECT_THAT(heard.ids, testing::UnorderedElementsAre(mail, docs));
+  EXPECT_EQ(jar, registry().Find(off)->profile_id);
+}
