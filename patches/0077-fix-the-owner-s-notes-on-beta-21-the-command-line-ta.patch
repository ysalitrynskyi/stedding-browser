@@ -0,0 +1,63 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_PIN_UNLOAD_REQUEST_H_
+#define CHROME_BROWSER_UI_STEDDING_PIN_UNLOAD_REQUEST_H_
+
+#include "base/functional/callback.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace stedding {
+
+// pins H3 (the owner, 2026-10-20): a pin that is closed is unloaded, not
+// closed, and a page that could ask "Leave site?" is asked first. The page's
+// beforeunload handlers run as for a tab's close, so it shows Chromium's own
+// prompt; the answer comes back to the pin's close rule instead of closing
+// the tab. Chromium's own path would close it: when the page lets go, the
+// window's unload controller runs the page's unload handlers and closes the
+// tab, so it hands the answer here first (TakeAnswer).
+class PinUnloadRequest
+    : public content::WebContentsUserData<PinUnloadRequest> {
+ public:
+  // True: the person chose Leave, or the page asked nothing.
+  using Answered = base::OnceCallback<void(bool leave)>;
+
+  PinUnloadRequest(const PinUnloadRequest&) = delete;
+  PinUnloadRequest& operator=(const PinUnloadRequest&) = delete;
+  ~PinUnloadRequest() override;
+
+  // Runs `contents`' beforeunload handlers. `answered` runs once with the
+  // answer, from a posted task; never if the contents go first. While a
+  // question is open, another one for the same page is dropped.
+  static void Ask(content::WebContents* contents, Answered answered);
+
+  // Whether a question is open for `contents`.
+  static bool IsAsking(content::WebContents* contents);
+
+  // The unload controller's hook: true when `proceed` answers a question
+  // asked here. The caller then neither unloads nor closes the page.
+  static bool TakeAnswer(content::WebContents* contents, bool proceed);
+
+  // The unload controller's hook when a window close or a quit that started
+  // while the question showed waits for the same page: the page answers only
+  // once, and that answer is the close's. Forgets the question asked for
+  // `contents`; its `answered` never runs, so the pin is kept as it is.
+  static void Drop(content::WebContents* contents);
+
+ private:
+  friend class content::WebContentsUserData<PinUnloadRequest>;
+  PinUnloadRequest(content::WebContents* contents, Answered answered);
+
+  Answered answered_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_PIN_UNLOAD_REQUEST_H_
