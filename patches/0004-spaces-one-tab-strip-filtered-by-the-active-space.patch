@@ -0,0 +1,199 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_MODEL_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_MODEL_H_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "chrome/browser/sessions/stedding_session_rebuild.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+#include "components/sessions/core/session_id.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+class Browser;
+class BrowserWindowInterface;
+class SessionService;
+class TabStripModel;
+
+namespace spaces {
+
+// The key Spaces are written under in the session's per-window extra data.
+inline constexpr char kSessionSpacesKey[] = "stedding.spaces";
+
+// The key a tab's per-Space pin is written under in per-tab extra data.
+inline constexpr char kSessionTabSpacePinKey[] = "stedding.spacepin";
+
+// The Spaces belonging to one browser window, and which of them is active.
+//
+// One window has exactly one SpaceModel and always at least one Space, so
+// "no Space" is not a state any caller has to handle.
+//
+// Deliberately not a window and not a tab group. A Space is a set of tabs the
+// user switches between inside one window; every tab stays in that window's one
+// TabStripModel, and switching changes only which of them are shown. See
+// ADR 0015 for why filtering beats parking, and docs/features/spaces.md for
+// the behaviours this object is responsible for (B1-B8).
+//
+// The model observes the tab strip so that membership is decided when a tab
+// arrives, not when something happens to ask: a tab opened in a Space belongs
+// to that Space from its first frame (B1), and a tab that leaves is forgotten.
+class SpaceModel : public TabStripModelObserver {
+ public:
+  DECLARE_USER_DATA(SpaceModel);
+
+  // The SpaceModel for `browser`, or null in a window that has none (popups,
+  // app windows). Spaces belong to a window: the same tab strip is filtered by
+  // whichever Space is active, per ADR 0015.
+  static SpaceModel* From(BrowserWindowInterface* browser);
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnSpaceAdded(const SpaceId& id) {}
+    virtual void OnSpaceRemoved(const SpaceId& id) {}
+    virtual void OnActiveSpaceChanged(const SpaceId& from, const SpaceId& to) {}
+    virtual void OnSpaceMetadataChanged(const SpaceId& id) {}
+    // `tab` now belongs to a different Space than it did. Views that filter by
+    // Space refresh on this so a move shows without a switch (B8).
+    virtual void OnTabSpaceChanged(tabs::TabInterface* tab) {}
+  };
+
+  // A model with no window: nothing is observed and no tab is ever activated.
+  // For tests and for windows that have Spaces in name only.
+  SpaceModel();
+  explicit SpaceModel(BrowserWindowInterface& browser);
+  ~SpaceModel() override;
+  SpaceModel(const SpaceModel&) = delete;
+  SpaceModel& operator=(const SpaceModel&) = delete;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // Never empty: a default Space is created on construction.
+  const std::vector<std::unique_ptr<Space>>& spaces() const { return spaces_; }
+  size_t size() const { return spaces_.size(); }
+
+  const SpaceId& active_id() const { return active_id_; }
+  Space* active_space();
+
+  // Null if no Space carries this id.
+  Space* GetSpace(const SpaceId& id);
+
+  // The name to show for `id`: the Space's own name, or "Space N" (1-based
+  // position) for a Space the user has not named. Every surface that names a
+  // Space uses this, so the hover pill and the command bar agree.
+  std::u16string DisplayName(const SpaceId& id) const;
+
+  // Session rebuild provider (stedding_session_rebuild.h): the window's Space
+  // list and every tab's membership and per-Space pin.
+  static void AppendRebuildCommands(BrowserWindowInterface* browser,
+                                    stedding::SessionRebuildCommands* commands);
+
+  Space* AddSpace(std::string name, SkColor color);
+
+  // Removing the active Space, or the last one, is refused: a window must
+  // always have somewhere for its tabs to be. Returns false without changing
+  // anything. Otherwise the Space's tabs move to the active Space (B5).
+  bool RemoveSpace(const SpaceId& id);
+
+  // Makes `id` the active Space, and makes sure the active tab is one the
+  // user can now see: the tab that was last active in `id`, else the first tab
+  // in `id`, else an essentials tab, else a new tab opened in `id` (B3).
+  // Observers hear about the switch after the active tab has been settled, so
+  // nothing paints a hidden tab as active.
+  void SetActiveSpace(const SpaceId& id);
+
+  void SetSpaceName(const SpaceId& id, std::string name);
+  void SetSpaceColor(const SpaceId& id, SkColor color);
+  void SetSpaceIcon(const SpaceId& id, std::string icon);
+
+  // The Spaces and which is active, as JSON, for the session to keep.
+  std::string Serialize() const;
+
+  // Replaces the Spaces with those in `data`, which must have come from
+  // Serialize(). Does nothing if it cannot be read, so a session written by a
+  // different version leaves the window with its default Space rather than
+  // none.
+  void RestoreFrom(const std::string& data);
+
+  // Which Space `tab` belongs to.
+  //
+  // Membership is normally decided when the tab is inserted into the strip.
+  // A tab this model has somehow not seen joins the Space it was restored
+  // from if that Space exists, and otherwise the active Space (B2). Tabs are
+  // keyed by handle rather than pointer so a closed tab cannot be confused with
+  // a later one at the same address.
+  const SpaceId& SpaceForTab(tabs::TabInterface* tab);
+
+  // Moves `tab` to `id`. Does nothing if `id` is not a Space in this model.
+  void SetSpaceForTab(tabs::TabInterface* tab, const SpaceId& id);
+
+  // Arc's second pin tier: pinned within its Space, shown above the Clear
+  // line there, and skipped by Clear -- unlike Chromium-pinned tabs, which are
+  // the essentials row and sit above every Space.
+  bool IsSpacePinned(const tabs::TabInterface* tab) const;
+  void SetSpacePinned(tabs::TabInterface* tab, bool pinned);
+
+  // True if `tab` is in the active Space, and so should be visible. Essentials
+  // (Chromium-pinned) tabs are in every Space (B6). Tabs this model has never
+  // seen count as visible: a window whose tabs predate Spaces must not blink
+  // out of existence.
+  bool IsTabInActiveSpace(const tabs::TabInterface* tab) const;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override;
+
+ private:
+  // Writes the Spaces into the session, so they come back after a restart.
+  void SaveToSession();
+
+  // Which Space a tab that this model has not seen should join: the one it was
+  // in when the session was written, if that Space came back, and otherwise
+  // whichever is active.
+  SpaceId SpaceIdForNewTab(tabs::TabInterface* tab);
+
+  // Writes `id` as `tab`'s Space in the session.
+  void SaveTabToSession(tabs::TabInterface* tab, const SpaceId& id);
+
+  // If the active tab is not visible in the active Space, activates one that
+  // is, opening a new tab when the Space has none (B3, B4). No-op without a
+  // tab strip, while the window is closing, or when the strip is empty.
+  void EnsureActiveSpaceHasAVisibleTab();
+
+  std::vector<std::unique_ptr<Space>> spaces_;
+  SpaceId active_id_;
+  base::ObserverList<Observer> observers_;
+
+  std::map<tabs::TabHandle, SpaceId> tab_spaces_;
+  std::set<tabs::TabHandle> space_pinned_;
+  // The tab the user last had active in each Space, so coming back to a Space
+  // lands where they left it rather than on whichever tab sorts first.
+  std::map<SpaceId, tabs::TabHandle> last_active_;
+  raw_ptr<TabStripModel> tab_strip_model_ = nullptr;
+  bool wrote_window_state_ = false;
+  raw_ptr<SessionService> session_service_ = nullptr;
+  SessionID session_id_ = SessionID::InvalidValue();
+  std::optional<ui::ScopedUnownedUserData<SpaceModel>> scoped_user_data_;
+  base::WeakPtrFactory<SpaceModel> weak_factory_{this};
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_MODEL_H_
