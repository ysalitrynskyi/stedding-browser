+  const auto row = container_layout.children.find(toolbar);
+  if (row == container_layout.children.end() ||
+      !row->second.visibility.value_or(toolbar->GetVisible())) {
+    return;
+  }
+  const int old_bottom = row->second.bounds.bottom();
+  const int rise = old_bottom - height;
+  row->second.bounds.set_y(0);
+  row->second.bounds.set_height(height);
+  int bottom = height;
+  for (auto& [child, child_layout] : container_layout.children) {
+    if (child == toolbar) {
+      continue;
+    }
+    if (child_layout.bounds.y() >= old_bottom) {
+      child_layout.bounds.Offset(0, -rise);
+    }
+    if (child_layout.visibility.value_or(child->GetVisible()) &&
+        !child_layout.bounds.IsEmpty()) {
+      bottom = std::max(bottom, child_layout.bounds.bottom());
+    }
+  }
+  container.set_y(0);
+  container.set_height(bottom + gutter);
+}
