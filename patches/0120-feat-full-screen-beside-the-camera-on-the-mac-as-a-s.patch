+void AddressRow::SetCameraRow(std::optional<CameraRow> row) {
+  if (camera_row_ == row) {
+    return;
+  }
+  camera_row_ = row;
+  // T56: the row beside the camera is on the window's colour.
+  if (PageThemeColorController* const colours =
+          PageThemeColorController::From(&*browser_)) {
+    colours->SetBarSuppressed(camera_row_.has_value());
+  }
+  // The sidebar gives the address back first (T57), so the one layout that
+  // follows has the row whole.
+  camera_row_changed_.Notify();
+  Relayout();
+}
