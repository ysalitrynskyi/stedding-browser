+// pins H3, H16, tabs R6, R33 (the owner, 2026-10-20: Arc's way). Closing a
+// pin of either tier -- Cmd-W, the row's close button, a middle click or the
+// tab menu's Close -- unloads it and sends it back to its home, so it loads
+// home when it is next selected; it stays a pin in its place, and the row
+// used before it is shown at once. A pin in use (here, shared) is unloaded
+// too, and a pin that drifted comes back home. A page that asks "Leave
+// site?" is asked first: Stay keeps it as it was, on screen; Leave unloads
+// it. The close button on a pin already asleep at home leaves it there. A
+// pin in use had stayed loaded, a drifted one had kept its page, the close
+// button had closed a sleeping pin, a middle click had loaded home without
+// unloading, and the menu's Close had closed the pin for good.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, ClosingAPinUnloadsItAtItsHome) {
+  const GURL home = embedded_test_server()->GetURL("home.test", "/title1.html");
+  const GURL away = embedded_test_server()->GetURL("away.test", "/title2.html");
+  const GURL asks =
+      embedded_test_server()->GetURL("away.test", "/beforeunload.html");
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  TabStripModel* const tabs = tab_strip_model();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), away));
+  tabs::TabInterface* const before = tabs->GetActiveTab();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), home, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const pin = tabs->GetActiveTab();
+  model->SetSpacePinned(pin, true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), home, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const essential = tabs->GetActiveTab();
+  tabs->SetTabPinned(tabs->GetIndexOfTab(essential), true);
+  ASSERT_EQ(home, model->HomeUrl(pin).value_or(GURL()));
+  ASSERT_EQ(home, model->HomeUrl(essential).value_or(GURL()));
+  AppendTab();
+  const int count = tabs->count();
+
+  // `tab` on screen at `url`, `before` the row used just before it.
+  const auto show_at = [&](tabs::TabInterface* tab, const GURL& url) {
+    tabs->ActivateTabAt(tabs->GetIndexOfTab(before));
+    tabs->ActivateTabAt(tabs->GetIndexOfTab(tab));
+    ASSERT_TRUE(content::WaitForLoadStop(tab->GetContents()));
+    ASSERT_TRUE(content::NavigateToURL(tab->GetContents(), url));
+    ASSERT_FALSE(tab->GetContents()->WasDiscarded());
+    ASSERT_NO_FATAL_FAILURE(WaitForRowsToSettle());
+  };
+  // `tab` was unloaded at its home, kept as a pin in the window, and the
+  // row used before it is the one shown.
+  const auto expect_closed_by_the_rule = [&](tabs::TabInterface* tab) {
+    // By its handle: a close that really closes the tab frees it.
+    const tabs::TabHandle handle = tab->GetHandle();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !handle.Get() || (handle.Get()->GetContents() &&
+                               handle.Get()->GetContents()->WasDiscarded());
+    })) << "the pin was not unloaded";
+    ASSERT_TRUE(handle.Get()) << "the close closed the pin";
+    EXPECT_FALSE(tab->GetContents()->GetPrimaryMainFrame()->IsRenderFrameLive())
+        << "the page still runs";
+    EXPECT_EQ(home, tab->GetContents()->GetLastCommittedURL())
+        << "the pin did not go back home";
+    EXPECT_EQ(count, tabs->count()) << "the close closed a tab";
+    EXPECT_TRUE(tab->IsPinned() || model->IsSpacePinned(tab));
+    EXPECT_EQ(before, tabs->GetActiveTab()) << "not the row used before it";
+    EXPECT_EQ(before->GetContents(), browser_view()->GetActiveWebContents());
+  };
+  // Rests the pointer on `tab`'s row and clicks the close button it shows.
+  const auto press_close_button = [&](tabs::TabInterface* tab) {
+    ASSERT_NO_FATAL_FAILURE(WaitForRowsToSettle());
+    TabView* const row = RowFor(tabs->GetIndexOfTab(tab));
+    ASSERT_TRUE(row);
+    row->UpdateHovered(true);
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    views::View* const button = row->close_button_for_testing();
+    ASSERT_TRUE(button->GetVisible()) << "the hovered row has no close button";
+    ClickAt(button->GetBoundsInScreen().CenterPoint());
+  };
+
+  {
+    SCOPED_TRACE("Cmd-W on a drifted Space pin in use");
+    ASSERT_NO_FATAL_FAILURE(show_at(pin, away));
+    base::ScopedClosureRunner share = pin->GetContents()->IncrementCapturerCount(
+        gfx::Size(), /*stay_hidden=*/false, /*stay_awake=*/true,
+        /*is_activity=*/true);
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+    ASSERT_NO_FATAL_FAILURE(expect_closed_by_the_rule(pin));
+  }
+
+  {
+    SCOPED_TRACE("selected again, it loads its home");
+    tabs->ActivateTabAt(tabs->GetIndexOfTab(pin));
+    ASSERT_TRUE(content::WaitForLoadStop(pin->GetContents()));
+    EXPECT_EQ(home, pin->GetContents()->GetLastCommittedURL());
+    EXPECT_FALSE(pin->GetContents()->WasDiscarded());
+  }
+
+  {
+    SCOPED_TRACE("the close button on a drifted Space pin");
+    ASSERT_NO_FATAL_FAILURE(show_at(pin, away));
+    ASSERT_NO_FATAL_FAILURE(press_close_button(pin));
+    ASSERT_NO_FATAL_FAILURE(expect_closed_by_the_rule(pin));
+  }
+
+  {
+    SCOPED_TRACE("the close button on a pin asleep at home");
+    ASSERT_NO_FATAL_FAILURE(press_close_button(pin));
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(count, tabs->count()) << "the close button closed the pin";
+    EXPECT_TRUE(model->IsSpacePinned(pin));
+    EXPECT_TRUE(pin->GetContents()->WasDiscarded());
+    EXPECT_EQ(home, pin->GetContents()->GetLastCommittedURL());
+  }
+
+  {
+    SCOPED_TRACE("a middle click on a drifted Space pin");
+    ASSERT_NO_FATAL_FAILURE(show_at(pin, away));
+    TabView* const row = RowFor(tabs->GetIndexOfTab(pin));
+    ASSERT_TRUE(row);
+    MiddleClickRow(row);
+    ASSERT_NO_FATAL_FAILURE(expect_closed_by_the_rule(pin));
+  }
+
+  {
+    SCOPED_TRACE("Cmd-W on a drifted essential");
+    ASSERT_NO_FATAL_FAILURE(show_at(essential, away));
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+    ASSERT_NO_FATAL_FAILURE(expect_closed_by_the_rule(essential));
+  }
+
+  {
+    SCOPED_TRACE("a middle click on a drifted essential");
+    ASSERT_NO_FATAL_FAILURE(show_at(essential, away));
+    TabView* const row = RowFor(tabs->GetIndexOfTab(essential));
+    ASSERT_TRUE(row);
+    MiddleClickRow(row);
+    ASSERT_NO_FATAL_FAILURE(expect_closed_by_the_rule(essential));
+  }
+
+  // The tab menu's Close, which shows Cmd-W's shortcut, run as a click on it
+  // runs it.
+  const auto close_from_the_menu = [&](tabs::TabInterface* tab) {
+    TabContextMenuController controller(tab->GetHandle(),
+                                        vertical_tab_strip_controller());
+    TabMenuModel menu(&controller, TabMenuModelDelegate::From(browser()),
+                      tabs, tabs->GetIndexOfTab(tab));
+    const std::optional<size_t> close =
+        menu.GetIndexOfCommandId(TabStripModel::CommandCloseTab);
+    ASSERT_TRUE(close.has_value()) << "the menu has no Close";
+    menu.ActivatedAt(*close);
+  };
+
+  {
+    SCOPED_TRACE("the tab menu's Close on a drifted Space pin");
+    ASSERT_NO_FATAL_FAILURE(show_at(pin, away));
+    ASSERT_NO_FATAL_FAILURE(close_from_the_menu(pin));
+    ASSERT_NO_FATAL_FAILURE(expect_closed_by_the_rule(pin));
+  }
+
+  {
+    SCOPED_TRACE("the tab menu's Close on a drifted essential");
+    ASSERT_NO_FATAL_FAILURE(show_at(essential, away));
+    ASSERT_NO_FATAL_FAILURE(close_from_the_menu(essential));
+    ASSERT_NO_FATAL_FAILURE(expect_closed_by_the_rule(essential));
+  }
+
+  {
+    SCOPED_TRACE("Leave site? on a pin: Stay, then Leave");
+    ASSERT_NO_FATAL_FAILURE(show_at(pin, asks));
+    content::WebContents* const page = pin->GetContents();
+    // The user activation "Leave site?" needs, and no hang timer.
+    content::PrepContentsForBeforeUnloadTest(page);
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+    javascript_dialogs::AppModalDialogController* dialog =
+        ui_test_utils::WaitForAppModalDialog();
+    ASSERT_TRUE(dialog);
+    ASSERT_TRUE(dialog->is_before_unload_dialog());
+    dialog->view()->CancelAppModalDialog();  // Stay.
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(pin, tabs->GetActiveTab()) << "Stay left the pin";
+    EXPECT_EQ(page, pin->GetContents()) << "Stay unloaded the pin";
+    EXPECT_FALSE(page->WasDiscarded());
+    EXPECT_EQ(asks, page->GetLastCommittedURL());
+    EXPECT_EQ(count, tabs->count());
+
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+    dialog = ui_test_utils::WaitForAppModalDialog();
+    ASSERT_TRUE(dialog);
+    dialog->view()->AcceptAppModalDialog();  // Leave.
+    ASSERT_NO_FATAL_FAILURE(expect_closed_by_the_rule(pin));
+  }
+}
