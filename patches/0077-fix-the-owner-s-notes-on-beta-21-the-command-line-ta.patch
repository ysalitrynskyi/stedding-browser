+SpaceWheel::SpaceWheel(float notch_size) : notch_size_(notch_size) {}
+
+SpaceWheel::~SpaceWheel() = default;
+
+SpaceWheel::Answer SpaceWheel::OnWheel(const Event& event, bool rtl) {
+  if (last_event_.is_null() || event.time - last_event_ > kStreamGap) {
+    axis_ = Axis::kNone;
+    sideways_ = 0.0f;
+    vertical_ = 0.0f;
+    toward_next_ = 0.0f;
+    stepped_ = false;
+  }
+  last_event_ = event.time;
+
+  float right = event.right;
+  float down = event.down;
+  if (event.shift && right == 0.0f) {
+    right = down;
+    down = 0.0f;
+  }
+  const bool mostly_sideways = std::abs(right) > std::abs(down);
+  const float sideways_to_next = rtl ? -right : right;
+  float to_next = 0.0f;
+  if (event.control) {
+    to_next = mostly_sideways ? sideways_to_next : down;
+  } else if (event.notch) {
+    if (!mostly_sideways) {
+      return Answer::kLeave;
+    }
+    to_next = sideways_to_next;
+  } else {
+    if (axis_ == Axis::kNone) {
+      sideways_ += std::abs(right);
+      vertical_ += std::abs(down);
+      if (std::max(sideways_, vertical_) >= kAxisLock) {
+        axis_ = sideways_ > vertical_ ? Axis::kSideways : Axis::kVertical;
+      }
+    }
+    if (axis_ != Axis::kSideways) {
+      return Answer::kLeave;
+    }
+    to_next = sideways_to_next;
+  }
+
+  if (!last_step_.is_null() && event.time - last_step_ < kCooldown) {
+    toward_next_ = 0.0f;
+    return Answer::kTake;
+  }
+  if (event.notch) {
+    return to_next == 0.0f ? Answer::kTake : Step(event.time, to_next > 0.0f);
+  }
+  if (stepped_) {
+    return Answer::kTake;
+  }
+  toward_next_ += to_next;
+  if (std::abs(toward_next_) < notch_size_) {
+    return Answer::kTake;
+  }
+  return Step(event.time, toward_next_ > 0.0f);
+}
+
+SpaceWheel::Answer SpaceWheel::Step(base::TimeTicks time, bool next) {
+  last_step_ = time;
+  stepped_ = true;
+  toward_next_ = 0.0f;
+  return next ? Answer::kNext : Answer::kPrevious;
+}
