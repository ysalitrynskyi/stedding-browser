+void ContentsWebView::DidStartNavigation(
+    content::NavigationHandle* navigation) {
+  if (!dark_pages_watcher_ || !navigation->IsInPrimaryMainFrame() ||
+      navigation->IsSameDocument()) {
+    return;
+  }
+  // Dk7: a page from another process paints its first frame over this
+  // colour; it is the coming page's from the start.
+  dark_pages_navigation_ = stedding::DarkPagesApplyToUrl(
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext()),
+      navigation->GetURL());
+  if (GetWidget()) {
+    UpdateBackgroundColor();
+  }
+}
+
+void ContentsWebView::DidRedirectNavigation(
+    content::NavigationHandle* navigation) {
+  if (!dark_pages_watcher_ || !dark_pages_navigation_ ||
+      !navigation->IsInPrimaryMainFrame()) {
+    return;
+  }
+  // Dk7: a redirect may cross an exception (a darkened link shortener to a
+  // site kept light, or the reverse); the page that comes is the one at the
+  // end of it.
+  const bool darkened = stedding::DarkPagesApplyToUrl(
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext()),
+      navigation->GetURL());
+  if (darkened == *dark_pages_navigation_) {
+    return;
+  }
+  dark_pages_navigation_ = darkened;
+  if (GetWidget()) {
+    UpdateBackgroundColor();
+  }
+}
+
+void ContentsWebView::DidFinishNavigation(
+    content::NavigationHandle* navigation) {
+  if (!dark_pages_navigation_ || !navigation->IsInPrimaryMainFrame() ||
+      navigation->IsSameDocument()) {
+    return;
+  }
+  dark_pages_navigation_.reset();
+  if (GetWidget()) {
+    UpdateBackgroundColor();
+  }
+}
+
+bool ContentsWebView::ShowsDarkPagesCanvas() {
+  if (!dark_pages_watcher_ || !web_contents()) {
+    return false;
+  }
+  return dark_pages_navigation_.value_or(
+      stedding::DarkPagesApplyTo(web_contents()));
+}
