+// Lf2, Lf11: the token is kept sealed, is no preference Settings' page can
+// read, is in nothing Settings is sent, and goes to api.github.com alone,
+// with no cookie.
+IN_PROC_BROWSER_TEST_F(LiveFoldersTest, TheTokenReachesNoPageNorSettings) {
+  AnswerTheFirstList();
+  ASSERT_EQ(Failure::kNone, Make());
+  const std::string stored =
+      profile()->GetPrefs()->GetString(live_folders::kGitHubTokenPref);
+  ASSERT_FALSE(stored.empty());
+  // The preference is base64 of what the key store sealed: the token is in
+  // neither, and only the key store gives it back.
+  std::string sealed;
+  ASSERT_TRUE(base::Base64Decode(stored, &sealed));
+  EXPECT_EQ(std::string::npos, sealed.find(kToken));
+  EXPECT_EQ(std::string::npos, sealed.find("TESTONLY"));
+  EXPECT_EQ(std::string::npos, sealed.find("github_pat"));
+  EXPECT_NE(std::string(kToken), sealed);
+  base::test::TestFuture<scoped_refptr<os_crypt_async::Encryptor>> encryptor;
+  g_browser_process->os_crypt_async()->GetInstance(encryptor.GetCallback());
+  std::string opened;
+  ASSERT_TRUE(encryptor.Get()->DecryptString(sealed, &opened));
+  EXPECT_EQ(kToken, opened);
+
+  extensions::PrefsUtil prefs_util(profile());
+  for (const char* name :
+       {live_folders::kGitHubTokenPref, live_folders::kGitHubFolderPref}) {
+    EXPECT_EQ(extensions::api::settings_private::PrefType::kNone,
+              prefs_util.GetAllowlistedPrefType(name))
+        << name;
+    EXPECT_FALSE(prefs_util.GetPref(name)) << name;
+  }
+  std::string state;
+  ASSERT_TRUE(
+      base::JSONWriter::Write(Service().StateForSettings(), &state));
+  EXPECT_EQ(std::string::npos, state.find("TESTONLY")) << state;
+  EXPECT_NE(std::string::npos, state.find("personal-access-tokens")) << state;
+
+  ASSERT_EQ(4u, seen_.size());
+  for (const Seen& seen : seen_) {
+    EXPECT_EQ("api.github.com", seen.url.host()) << seen.url;
+    EXPECT_EQ("https", seen.url.scheme());
+    EXPECT_EQ(std::string("Bearer ") + kToken, seen.authorization);
+    EXPECT_TRUE(seen.cookie.empty());
+    EXPECT_TRUE(seen.credentials_omitted);
+  }
+}
