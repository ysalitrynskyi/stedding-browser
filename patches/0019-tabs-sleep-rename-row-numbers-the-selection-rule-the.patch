+
+// tabs R14, R15: a name wins over the page title; an empty name gives the
+// page title back.
+TEST_F(TabNamesTest, NameIsPreferredAndEmptyRestores) {
+  AddTab(browser(), GURL("https://example.com/"));
+  tabs::TabInterface* const tab = tabs().GetActiveTab();
+  const std::u16string page_title = Title(tab);
+  EXPECT_TRUE(TabName(tab->GetContents()).empty());
+
+  SetTabName(browser(), tab, u"Budget");
+  EXPECT_EQ(u"Budget", TabName(tab->GetContents()));
+  EXPECT_EQ(u"Budget", Title(tab));
+
+  SetTabName(browser(), tab, std::u16string());
+  EXPECT_TRUE(TabName(tab->GetContents()).empty());
+  EXPECT_EQ(page_title, Title(tab));
+}
+
+// tabs R17: the name follows the tab through pin and unpin.
