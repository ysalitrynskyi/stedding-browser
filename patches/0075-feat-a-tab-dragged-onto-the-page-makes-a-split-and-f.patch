@@ -188,4 +188,37 @@ TEST(MainMenuBuilderTest, TheViewMenuHasDarkPagesWithItsChord) {
   }
 }
 
+// Stedding (BACKLOG S-104, shortcuts Z9): Cmd-E runs an extension, as in
+// Arc, so Edit > Find > Use Selection for Find keeps its row and its action
+// without the key, and no row of the menu bar holds Cmd-E: a menu's key
+// equivalent is matched before the window's own keys.
+bool HoldsCmdE(NSMenu* menu) {
+  for (NSMenuItem* item in menu.itemArray) {
+    if ([item.keyEquivalent isEqualToString:@"e"] &&
+        item.keyEquivalentModifierMask == NSEventModifierFlagCommand) {
+      return true;
+    }
+    if (item.submenu && HoldsCmdE(item.submenu)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+TEST(MainMenuBuilderTest, UseSelectionForFindKeepsItsRowWithoutCmdE) {
+  NSMenu* const main_menu =
+      chrome::BuildMainMenu(nil, nil, u"", /*is_pwa=*/false, /*is_rtl=*/false);
+  NSMenu* const edit_menu = [main_menu itemWithTag:IDC_EDIT_MENU].submenu;
+  ASSERT_TRUE(edit_menu);
+  NSMenu* const find_menu = [edit_menu itemWithTag:IDC_FIND_MENU].submenu;
+  ASSERT_TRUE(find_menu);
+  NSString* const title =
+      l10n_util::GetNSStringWithFixup(IDS_EDIT_USE_SELECTION_MAC);
+  NSMenuItem* const use_selection = [find_menu itemWithTitle:title];
+  ASSERT_TRUE(use_selection);
+  EXPECT_EQ(@selector(copyToFindPboard:), use_selection.action);
+  EXPECT_EQ(0u, use_selection.keyEquivalent.length);
+  EXPECT_FALSE(HoldsCmdE(main_menu));
+}
+
 }  // namespace
