+using live_folders::Failure;
+using live_folders::LiveFolderService;
+
+constexpr char kTokenW2B08[] =
+    "github_pat_11TESTONLY0000000000_abcdefghijklmnop";
+
+// Lf3: a pull request's body is up to 65,536 characters, and each search
+// item carries it whole. 50 bodies this long make an answer of about 3 MB.
+constexpr size_t kLongBodyW2B08 = 60000;
+
+// One search answer with 50 open pull requests, each with a long body, as a
+// dependency bot's are: past 2 MiB in all, under 5 MiB.
+std::string LongBodiesAnswerW2B08() {
+  base::ListValue items;
+  for (size_t i = 0; i < live_folders::kMaxRows; ++i) {
+    const std::string number = base::NumberToString(i + 1);
+    const std::string url =
+        base::StrCat({"https://github.com/acme/deps/pull/", number});
+    items.Append(
+        base::DictValue()
+            .Set("html_url", url)
+            .Set("node_id", base::StrCat({"PR_kwDOW2B08big", number}))
+            .Set("number", static_cast<int>(i + 1))
+            .Set("title", base::StrCat({"Bump the dependencies ", number}))
+            .Set("state", "open")
+            .Set("body", std::string(kLongBodyW2B08, 'x'))
+            .Set("created_at",
+                 base::StringPrintf("2026-11-01T10:%02d:00Z",
+                                    static_cast<int>(i)))
+            .Set("pull_request", base::DictValue().Set("html_url", url)));
+  }
+  base::DictValue answer;
+  answer.Set("total_count", static_cast<int>(live_folders::kMaxRows));
+  answer.Set("incomplete_results", false);
+  answer.Set("items", std::move(items));
+  const std::optional<std::string> json = base::WriteJson(answer);
+  CHECK(json);
+  return *json;
+}
+
+// The setup of LiveFoldersTest (live_folders_browsertest.cc): a test loader
+// factory answers every search from `answers_`, by the search's last word.
+class LiveFoldersW2B08Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  struct Answer {
+    int status = net::HTTP_OK;
+    std::string body = live_folders::recorded::kNothing;
+  };
+
+  void SetUpInProcessBrowserTestFixture() override {
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::SetUpInProcessBrowserTestFixture();
+    factory_.SetInterceptor(
+        base::BindLambdaForTesting([this](const network::ResourceRequest& r) {
+          seen_.push_back(r.url);
+          std::string q;
+          net::GetValueForKeyInQuery(r.url, "q", &q);
+          const std::string who = q.substr(q.rfind(' ') + 1);
+          const Answer answer =
+              answers_.contains(who) ? answers_[who] : Answer();
+          factory_.AddResponse(r.url.spec(), answer.body,
+                               static_cast<net::HttpStatusCode>(answer.status));
+        }));
+    LiveFolderService::SetURLLoaderFactoryForTesting(
+        factory_.GetSafeWeakWrapper());
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    // windows G19: a folder is made only into a filled store.
+    ASSERT_TRUE(base::test::RunUntil([&] { return Store().ready(); }));
+  }
+
+  void TearDownOnMainThread() override {
+    LiveFolderService::SetURLLoaderFactoryForTesting(nullptr);
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  Profile* profile() { return browser()->GetProfile(); }
+
+  LiveFolderService& Service() {
+    LiveFolderService* const service =
+        live_folders::LiveFolderServiceFactory::GetForProfile(profile());
+    CHECK(service);
+    return *service;
+  }
+
+  spaces::PinStore& Store() {
+    spaces::PinStore* const store =
+        spaces::PinStoreFactory::GetForProfile(profile());
+    CHECK(store);
+    return *store;
+  }
+
+  spaces::SpaceModel& Model() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model);
+    return *model;
+  }
+
+  // The first list: #45, #42 and #7.
+  void AnswerTheFirstList() {
+    answers_["author:@me"] = {net::HTTP_OK, live_folders::recorded::kAuthored};
+    answers_["review-requested:@me"] = {
+        net::HTTP_OK, live_folders::recorded::kReviewRequested};
+    answers_["mentions:@me"] = {net::HTTP_OK,
+                                live_folders::recorded::kMentioned};
+  }
+
+  // Lf1: Settings' Make Live Folder, in the Space on screen.
+  Failure Make() {
+    base::test::TestFuture<Failure> made;
+    Service().Make(kTokenW2B08, Model().active_id(), made.GetCallback());
+    return made.Get();
+  }
+
+  // Lf4's refresh without the minute's wait; waits for its answer.
+  void RefreshAndWait() {
+    const size_t before = seen_.size();
+    Service().RefreshNowForTesting();
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return seen_.size() >= before + 4 && !Service().refreshing_for_testing();
+    }));
+    base::RunLoop().RunUntilIdle();
+  }
+
+  // The window's rows of the live folder, in the strip's order.
+  std::vector<tabs::TabInterface*> LiveRows() {
+    std::vector<tabs::TabInterface*> rows;
+    TabStripModel* const strip = browser()->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      if (live_folders::IsLiveRowToken(
+              stedding::TabToken(tab->GetContents()))) {
+        rows.push_back(tab);
+      }
+    }
+    return rows;
+  }
+
+  static const tabs::FolderTabCollection* FolderOf(tabs::TabInterface* tab) {
+    const tabs::TabCollection* const parent = tab->GetParentCollection();
+    return parent && parent->type() == tabs::TabCollection::Type::FOLDER
+               ? static_cast<const tabs::FolderTabCollection*>(parent)
+               : nullptr;
+  }
+
+  // A new foreground tab at `path` of the test server, pinned in the Space
+  // on screen; its token once the store has it.
+  std::string PinNewTab(const std::string& path,
+                        tabs::TabInterface** tab_out) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(path),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const tab =
+        browser()->GetTabStripModel()->GetActiveTab();
+    Model().SetSpacePinned(tab, true);
+    std::string token;
+    EXPECT_TRUE(base::test::RunUntil([&] {
+      token = stedding::TabToken(tab->GetContents());
+      return !token.empty() && Store().Find(token) != nullptr;
+    })) << "the pin did not reach the store";
+    *tab_out = tab;
+    return token;
+  }
+
+  network::TestURLLoaderFactory factory_;
+  std::map<std::string, Answer> answers_;
+  std::vector<GURL> seen_;
+};
+
+// P08-1d, Lf3, Lf7: an answer of 50 pull requests with long bodies, past
+// 2 MiB, is read like any other: the folder is made with its 50 rows, and no
+// failure is reported.
+IN_PROC_BROWSER_TEST_F(LiveFoldersW2B08Test,
+                       AnAnswerOfFiftyLongPullRequestsIsRead) {
+  const std::string answer = LongBodiesAnswerW2B08();
+  ASSERT_GT(answer.size(), 2u * 1024 * 1024);
+  ASSERT_LT(answer.size(), 5u * 1024 * 1024);
+  answers_["review-requested:@me"] = {net::HTTP_OK, answer};
+
+  ASSERT_EQ(Failure::kNone, Make())
+      << "a long answer was taken for an error from GitHub";
+  ASSERT_TRUE(Service().on());
+  EXPECT_EQ(Failure::kNone, Service().failure());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return LiveRows().size() == live_folders::kMaxRows;
+  })) << "the folder lacks rows of the long answer";
+  EXPECT_EQ(live_folders::kMaxRows, Service().rows());
+
+  // And a refresh with the same answer is no failure either.
+  RefreshAndWait();
+  EXPECT_EQ(Failure::kNone, Service().failure());
+  EXPECT_EQ(live_folders::kMaxRows, LiveRows().size());
+}
+
+// P08-1c, Lf5: one row sent to a Space whose pins come earlier in the store
+// goes back into the folder at the next refresh, and the folder stays where
+// it was among its own Space's pins, after the pin above it.
+IN_PROC_BROWSER_TEST_F(LiveFoldersW2B08Test,
+                       ARowSentToAnEarlierSpaceDoesNotMoveTheFolderUp) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const spaces::SpaceId first = Model().active_id();
+  tabs::TabInterface* first_pin = nullptr;
+  const std::string first_token = PinNewTab("/title1.html", &first_pin);
+  ASSERT_TRUE(first_pin);
+
+  spaces::Space* const work = Model().AddSpace("Work", SK_ColorBLUE);
+  ASSERT_TRUE(work);
+  const spaces::SpaceId work_id = work->id();
+  ASSERT_NE(first, work_id);
+  ASSERT_TRUE(Model().SetActiveSpace(work_id));
+  base::RunLoop().RunUntilIdle();
+  tabs::TabInterface* own = nullptr;
+  const std::string own_token = PinNewTab("/title2.html", &own);
+  ASSERT_TRUE(own);
+  ASSERT_EQ(work_id, Model().FindSpaceForTab(own));
+
+  AnswerTheFirstList();
+  ASSERT_EQ(Failure::kNone, Make());
+  ASSERT_EQ(work_id, Service().space());
+  ASSERT_TRUE(base::test::RunUntil([&] { return LiveRows().size() == 3u; }));
+
+  // The index of `id` in the store's order.
+  const auto at = [&](const std::string& id) {
+    const std::vector<spaces::PinRecord>& records = Store().records();
+    return static_cast<size_t>(
+        std::ranges::find_if(records,
+                             [&](const spaces::PinRecord& record) {
+                               return record.id == id;
+                             }) -
+        records.begin());
+  };
+  // The first Space's pins come earlier in the store than Work's; made, the
+  // folder is at the end of Work's pins, after Work's own pin.
+  ASSERT_LT(at(first_token), at(own_token));
+  for (tabs::TabInterface* row : LiveRows()) {
+    ASSERT_LT(at(own_token), at(stedding::TabToken(row->GetContents())));
+  }
+
+  // One row is sent alone to the first Space.
+  tabs::TabInterface* const sent = LiveRows()[1];
+  const std::string sent_token = stedding::TabToken(sent->GetContents());
+  Model().MoveTabsToSpace({sent}, first);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const spaces::PinRecord* const record = Store().Find(sent_token);
+    return record && record->has_space && record->space == first;
+  })) << "the row sent away is not in the first Space";
+  // It is now the store's first live row, in the first Space's pins.
+  std::string first_live;
+  for (const spaces::PinRecord& record : Store().records()) {
+    if (live_folders::IsLiveRowToken(record.id)) {
+      first_live = record.id;
+      break;
+    }
+  }
+  ASSERT_EQ(sent_token, first_live);
+
+  RefreshAndWait();
+
+  // Every row is back in Work, and Work's own pin still comes first.
+  size_t rows = 0;
+  for (const spaces::PinRecord& record : Store().records()) {
+    if (!live_folders::IsLiveRowToken(record.id)) {
+      continue;
+    }
+    ++rows;
+    EXPECT_TRUE(record.has_space);
+    EXPECT_EQ(work_id, record.space) << "a row did not come back to Work";
+    EXPECT_LT(at(own_token), at(record.id))
+        << "the refresh moved the folder above Work's own pin";
+  }
+  EXPECT_EQ(3u, rows);
+
+  // The window follows the store: the folder is below Work's own pin there.
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    const std::vector<tabs::TabInterface*> live = LiveRows();
+    return live.size() == 3u &&
+           std::ranges::all_of(live, [&](tabs::TabInterface* row) {
+             return FolderOf(row) &&
+                    Model().FindSpaceForTab(row) == work_id &&
+                    strip->GetIndexOfTab(row) > strip->GetIndexOfTab(own);
+           });
+  })) << "the window shows the folder above Work's own pin";
+}
+
+// P08-1b, Lf5, Lf8: with one row dragged out of the folder, still pinned,
+// removing the rows left in the folder never removes the folder: it is there
+// at once, before any refresh, with the row that was outside in it.
+IN_PROC_BROWSER_TEST_F(LiveFoldersW2B08Test,
+                       TheLastRowLeavingKeepsTheFolderWhileARowIsOutside) {
+  AnswerTheFirstList();
+  ASSERT_EQ(Failure::kNone, Make());
+  ASSERT_TRUE(base::test::RunUntil([&] { return LiveRows().size() == 3u; }));
+  const std::string folder_id = Service().folder_id();
+  TabStripModel* const strip = browser()->GetTabStripModel();
+
+  // The first row is dragged out of the folder into the pinned run.
+  tabs::TabInterface* const outside = LiveRows()[0];
+  const std::string outside_token = stedding::TabToken(outside->GetContents());
+  strip->MoveTabOutOfFolders(strip->GetIndexOfTab(outside));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const spaces::PinRecord* const record = Store().Find(outside_token);
+    return record && record->folder_path.empty() && !FolderOf(outside);
+  })) << "the row did not leave the folder";
+  ASSERT_TRUE(Model().IsSpacePinned(outside));
+
+  std::vector<tabs::TabInterface*> inside;
+  for (tabs::TabInterface* row : LiveRows()) {
+    if (row != outside) {
+      ASSERT_TRUE(FolderOf(row));
+      inside.push_back(row);
+    }
+  }
+  ASSERT_EQ(2u, inside.size());
+  const size_t requests = seen_.size();
+
+  // The rows left in the folder are removed, the last first (pins H14).
+  for (auto it = inside.rbegin(); it != inside.rend(); ++it) {
+    Model().SetSpacePinned(*it, false);
+  }
+  // They are the person's tabs now, out of the folder.
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return std::ranges::none_of(inside, [&](tabs::TabInterface* tab) {
+      return live_folders::IsLiveRowToken(
+                 stedding::TabToken(tab->GetContents())) ||
+             FolderOf(tab);
+    });
+  })) << "a row taken out is still a row";
+
+  // The folder is there, with the row that was outside it, at once.
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const tabs::FolderTabCollection* const folder = FolderOf(outside);
+    return folder && folder->id().ToString() == folder_id &&
+           Model().IsSpacePinned(outside);
+  })) << "the folder went with its last row while a row was outside it";
+  EXPECT_EQ(requests, seen_.size())
+      << "the folder came back only with a refresh";
+  EXPECT_TRUE(Service().on());
+  EXPECT_EQ(folder_id, Service().folder_id());
+  EXPECT_TRUE(Model().IsFolderSpacePinned(FolderOf(outside)));
+  EXPECT_EQ(1u, Service().rows());
+  EXPECT_EQ(outside_token, stedding::TabToken(outside->GetContents()));
+}
+
+}  // namespace
