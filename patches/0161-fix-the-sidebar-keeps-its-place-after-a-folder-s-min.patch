diff --git a/chrome/test/stedding/sidebar_click_browsertest.cc b/chrome/test/stedding/sidebar_click_browsertest.cc
index 1e013f5106657..40cdb6c993b6c 100644
--- a/chrome/test/stedding/sidebar_click_browsertest.cc
+++ b/chrome/test/stedding/sidebar_click_browsertest.cc
@@ -1707,6 +1707,34 @@ IN_PROC_BROWSER_TEST_F(SidebarClickTest,
 
 // A long list scrolls past its last row; a close shows the right row next and
 // leaves the list where it was, and a split's other pane stays.
+// tabs R14 (BACKLOG S-438): Enter and Escape give the keys back to the page.
+// Hiding the field handed them to the address field, its address selected, so
+// the next key typed replaced it.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest, ARenameEndedByAKeyLeavesThePageFocused) {
+  views::View* const page = browser_view()->GetActiveContentsWebView();
+  ASSERT_TRUE(page);
+  // With no full keyboard access, the Mac's default, a row takes no focus. With
+  // it the keys stay on the row, for the arrows.
+  browser_view()->GetWidget()->GetFocusManager()->SetKeyboardAccessible(false);
+  for (const ui::KeyboardCode key : {ui::VKEY_RETURN, ui::VKEY_ESCAPE}) {
+    SCOPED_TRACE(key == ui::VKEY_RETURN ? "Enter" : "Escape");
+    TabView* const row = RowFor(0);
+    ASSERT_TRUE(row);
+    row->BeginRename();
+    ASSERT_TRUE(row->IsRenaming());
+    views::Textfield* const field = row->rename_field_for_testing();
+    ASSERT_TRUE(field->HasFocus());
+    const ui::KeyEvent press(ui::EventType::kKeyPressed, key, ui::EF_NONE);
+    row->HandleKeyEvent(field, press);
+    ASSERT_FALSE(row->IsRenaming());
+    const views::View* const focused =
+        browser_view()->GetWidget()->GetFocusManager()->GetFocusedView();
+    EXPECT_EQ(page, focused)
+        << "the keys went to "
+        << (focused ? focused->GetClassName() : "nothing");
+  }
+}
