+// R56, R57: links opened from a page nest under it, a link from a child one
+// level further, and a page's own window.open too; a new tab and a duplicate
+// are no one's child. The child's title is drawn right of its parent's.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, ALinkOpensUnderItsPage) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const first = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(first);
+  tabs::TabInterface* const second = OpenLinkFrom(page, "c.test");
+  ASSERT_TRUE(second);
+  tabs::TabInterface* const grandchild = OpenLinkFrom(first, "d.test");
+  ASSERT_TRUE(grandchild);
+
+  const std::string token = stedding::TabToken(page->GetContents());
+  ASSERT_FALSE(token.empty());
+  EXPECT_EQ(token, stedding::TabParentToken(first->GetContents()));
+  EXPECT_EQ(token, stedding::TabParentToken(second->GetContents()));
+  EXPECT_EQ(stedding::TabToken(first->GetContents()),
+            stedding::TabParentToken(grandchild->GetContents()));
+
+  EXPECT_EQ(0, Indent(page));
+  EXPECT_EQ(14, Indent(first));
+  EXPECT_EQ(28, Indent(grandchild));
+  EXPECT_EQ(14, Indent(second));
+  TabView* const page_row = DrawnRow(page);
+  TabView* const first_row = DrawnRow(first);
+  ASSERT_TRUE(page_row && first_row);
+  EXPECT_EQ(page_row->title_for_testing()->GetBoundsInScreen().x() + 14,
+            first_row->title_for_testing()->GetBoundsInScreen().x())
+      << "the child's title starts a level right of its parent's";
+
+  {
+    SCOPED_TRACE("a page's own window.open nests too");
+    tabs()->ActivateTabAt(tabs()->GetIndexOfTab(page));
+    content::TestNavigationObserver opened(nullptr);
+    opened.StartWatchingNewWebContents();
+    ASSERT_TRUE(content::ExecJs(
+        page->GetContents(),
+        content::JsReplace("window.open($1)", Url("e.test"))));
+    opened.Wait();
+    tabs::TabInterface* const popup = tabs()->GetActiveTab();
+    ASSERT_NE(popup, page);
+    EXPECT_EQ(token, stedding::TabParentToken(popup->GetContents()));
+    EXPECT_EQ(14, Indent(popup));
+  }
+  {
+    SCOPED_TRACE("a new tab is no one's child");
+    tabs()->ActivateTabAt(tabs()->GetIndexOfTab(page));
+    chrome::NewTab(browser(), NewTabTypes::kNewTabCommand);
+    tabs::TabInterface* const blank = tabs()->GetActiveTab();
+    EXPECT_EQ("", stedding::TabParentToken(blank->GetContents()));
+    EXPECT_EQ(0, Indent(blank));
+  }
+  {
+    SCOPED_TRACE("a duplicate is no one's child");
+    tabs()->ActivateTabAt(tabs()->GetIndexOfTab(second));
+    content::WebContents* const copy =
+        chrome::DuplicateTabAt(browser(), tabs()->GetIndexOfTab(second));
+    ASSERT_TRUE(copy);
+    EXPECT_EQ("", stedding::TabParentToken(copy));
+  }
+}
