+// sessions S45: a session no Space uses ends when the user says so, once, and
+// a session a Space names is not offered that way.
+TEST_F(SharedSessionWindowTest, DeletingAnUnusedSessionWipesItOnce) {
+  const SpaceId work = model().AddSpace("Work", kBlue)->id();
+  model().SetSpaceIsolated(work, true);
+  const std::string jar = model().registry()->Find(work)->profile_id;
+  const std::string other = registry().AddSession("Other");
+  OpenTabIn(work);
+  const GURL url("https://example.com/");
+  PutCookie(profile(), ConfigFor(jar), url);
+  EXPECT_FALSE(model().DeleteUnusedSession(jar, base::DoNothing()))
+      << "Work uses it";
+  EXPECT_FALSE(WasWiped(ConfigFor(jar), url));
+
+  model().SetSpaceSession(work, other);
+  task_environment()->RunUntilIdle();
+  ASSERT_TRUE(model().registry()->FindSession(jar));
+  const int wipes = SpacePartitionWipesBegunForTesting();
+  base::RunLoop loop;
+  EXPECT_TRUE(model().DeleteUnusedSession(jar, loop.QuitClosure()));
+  loop.Run();
+  EXPECT_EQ(wipes + 1, SpacePartitionWipesBegunForTesting());
+  EXPECT_TRUE(WasWiped(ConfigFor(jar), url));
+  EXPECT_FALSE(model().registry()->FindSession(jar));
+  EXPECT_TRUE(profile()
+                  ->GetPrefs()
+                  ->GetList(stedding::prefs::kPendingJarWipes)
+                  .empty());
+}
