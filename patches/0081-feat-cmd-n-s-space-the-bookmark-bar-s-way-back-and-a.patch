+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/models/dialog_model.h"
+#include "ui/base/models/dialog_model_field.h"
+
+namespace stedding {
+
+namespace {
+
+// The bookmarks a conversion would make into tabs: those no earlier run
+// made a tab of (I13: a second run adds nothing).
+size_t CountNewTabs(const std::vector<spaces::ArcImportPlan::Node>& nodes,
+                    const base::flat_set<std::string>& done) {
+  size_t tabs = 0;
+  for (const spaces::ArcImportPlan::Node& node : nodes) {
+    if (node.kind == spaces::ArcImportPlan::Node::Kind::kFolder) {
+      tabs += CountNewTabs(node.children, done);
+    } else if (!done.contains(node.arc_id)) {
+      ++tabs;
+    }
+  }
+  return tabs;
+}
+
+void Convert(base::WeakPtr<BrowserWindowInterface> browser) {
+  if (browser) {
+    ConvertBookmarksToPins(browser.get());
+  }
+}
+
+}  // namespace
+
+void ConvertBookmarksToPinsAsking(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return;
+  }
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContextIfExists(
+          browser->GetProfile());
+  if (!model || !model->loaded()) {
+    return;
+  }
+  std::vector<std::string> done;
+  for (const base::Value& id :
+       browser->GetProfile()->GetPrefs()->GetList(prefs::kArcImportedIds)) {
+    if (id.is_string()) {
+      done.push_back(id.GetString());
+    }
+  }
+  const size_t count = CountNewTabs(
+      NodesFromBookmarks(*model), base::flat_set<std::string>(std::move(done)));
+  if (count <= kBookmarksToPinsWithoutAsking) {
+    ConvertBookmarksToPins(browser);
+    return;
+  }
+  // Each becomes a tab, asleep until it is shown; hundreds of them are a
+  // sidebar of hundreds of rows, so the count is said before.
+  const std::u16string number = base::NumberToString16(count);
+  chrome::ShowBrowserModal(
+      browser,
+      ui::DialogModel::Builder()
+          .SetInternalName("SteddingBookmarksToPinsDialog")
+          .SetTitle(base::StrCat(
+              {u"Turn ", number, u" bookmarks into pinned tabs?"}))
+          .AddParagraph(ui::DialogModelLabel(base::StrCat(
+              {u"Each of your ", number,
+               u" bookmarks becomes a pinned tab in the sidebar, in its "
+               u"folder, asleep until you open it. The bookmark bar and the "
+               u"star are hidden; Settings → Stedding → Tabs "
+               u"brings them back."})))
+          .AddOkButton(base::BindOnce(&Convert, browser->GetWeakPtr()),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           u"Turn into Pinned Tabs"))
+          .AddCancelButton(base::DoNothing())
+          .Build());
+}
+
+}  // namespace stedding
