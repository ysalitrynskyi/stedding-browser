+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/stedding_shortcuts_handler.h"
+
+#include <string>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/accelerators/accelerator.h"
+
+namespace stedding {
+namespace {
+
+bool AnyRow(const std::vector<ShortcutGroup>& groups,
+            const std::u16string& chord) {
+  for (const ShortcutGroup& group : groups) {
+    for (const ShortcutRow& row : group.rows) {
+      if (row.chord == chord ||
+          (row.chord.find(u" – ") != std::u16string::npos &&
+           (row.chord.starts_with(chord) || row.chord.ends_with(chord)))) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+// shortcuts Z1: every IDC_STEDDING_* command that has an accelerator is in
+// the reference, with the chord the tables give it; Space 2 to 8 are covered
+// by the range row.
+TEST(ShortcutReferenceTest, EverySteddingCommandWithAnAcceleratorIsListed) {
+  const std::vector<ShortcutGroup> groups = ShortcutReference();
+  const int commands[] = {
+      IDC_STEDDING_CAPTURE_VISIBLE,
+      IDC_STEDDING_CAPTURE_REGION,
+      IDC_STEDDING_CAPTURE_FULL_PAGE,
+      IDC_STEDDING_SPACE_1,
+      IDC_STEDDING_SPACE_9,
+      IDC_STEDDING_SPACE_NEXT,
+      IDC_STEDDING_SPACE_PREVIOUS,
+      IDC_STEDDING_CLEAR_SPACE,
+      IDC_STEDDING_TOGGLE_SPACE_PIN,
+      IDC_STEDDING_MOVE_TAB_TO_NEXT_SPACE,
+      IDC_STEDDING_MOVE_TAB_TO_PREVIOUS_SPACE,
+      IDC_STEDDING_COPY_MARKDOWN_LINK,
+      IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+      IDC_COPY_URL,
+  };
+  for (int command : commands) {
+    ui::Accelerator accelerator;
+    ASSERT_TRUE(GetDefaultMacAcceleratorForCommandId(command, &accelerator))
+        << command;
+    EXPECT_TRUE(AnyRow(groups, accelerator.GetShortcutText()))
+        << command << " " << base::UTF16ToUTF8(accelerator.GetShortcutText());
+  }
+  for (int n = 2; n <= 8; ++n) {
+    ui::Accelerator accelerator;
+    ASSERT_TRUE(GetDefaultMacAcceleratorForCommandId(
+        IDC_STEDDING_SPACE_1 + n - 1, &accelerator));
+  }
+  EXPECT_TRUE(AnyRow(groups,
+                     u"⌃"
+                     u"1"));
+  EXPECT_TRUE(AnyRow(groups,
+                     u"⌃"
+                     u"9"));
+}
+
+// shortcuts Z2: each divergence names the chord, Stedding's binding and
+// Chromium's.
+TEST(ShortcutReferenceTest, DivergenceRowsNameBothBindings) {
+  const std::vector<ShortcutGroup> groups = ShortcutReference();
+  const ShortcutGroup* diverges = nullptr;
+  for (const ShortcutGroup& group : groups) {
+    if (group.title.find(u"differs") != std::u16string::npos) {
+      diverges = &group;
+    }
+  }
+  ASSERT_TRUE(diverges);
+  EXPECT_GE(diverges->rows.size(), 9u);
+  for (const ShortcutRow& row : diverges->rows) {
+    EXPECT_FALSE(row.chord.empty());
+    EXPECT_FALSE(row.what.empty()) << base::UTF16ToUTF8(row.chord);
+    EXPECT_FALSE(row.chromium.empty()) << base::UTF16ToUTF8(row.chord);
+  }
+  EXPECT_TRUE(AnyRow(groups, u"⌘S"));
+  EXPECT_TRUE(AnyRow(groups, u"⌘D"));
+  EXPECT_TRUE(AnyRow(groups, u"⇧⌘C"));
+  // The tab-traversal divergence is about the table's arrow chords, not the
+  // menu's ⇧⌘] (the row showed ⇧⌘] against "Focus the next pane" on the
+  // 2026-09-05 capture).
+  bool arrows = false;
+  for (const ShortcutRow& row : diverges->rows) {
+    arrows |= row.what == u"Next tab" &&
+              row.chord.find(u"↓") != std::u16string::npos &&
+              row.chord.find(u"⌥") != std::u16string::npos;
+  }
+  EXPECT_TRUE(arrows);
+}
+
+// shortcuts Z3: the Mission Control note is there.
+TEST(ShortcutReferenceTest, MissionControlNoteIsPresent) {
+  bool found = false;
+  for (const ShortcutGroup& group : ShortcutReference()) {
+    for (const ShortcutRow& row : group.rows) {
+      found |= row.what.find(u"Mission Control") != std::u16string::npos;
+    }
+  }
+  EXPECT_TRUE(found);
+  const base::ListValue value = ShortcutReferenceAsValue(ShortcutReference());
+  EXPECT_GE(value.size(), 5u);
+}
+
+}  // namespace
+}  // namespace stedding
