+// site-controls Si2, Si3: Copy link copies the clean link, an Option-click
+// (Alt-click) the Markdown link, Copy title the page's title with its toast;
+// each closes the panel.
+IN_PROC_BROWSER_TEST_F(SiteControlsTest, TheStripRunsTheWindowsCommands) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), Url("site.test", "/title2.html?utm_source=mail")));
+  const std::string clean = Url("site.test", "/title2.html").spec();
+  const std::u16string title = page()->GetTitle();
+  ASSERT_FALSE(title.empty());
+  {
+    SCOPED_TRACE("Copy link");
+    SiteControlsStripView* const strip = Strip(OpenFromTheChip());
+    ASSERT_TRUE(strip);
+    Click(strip->copy_link());
+    EXPECT_EQ(base::UTF8ToUTF16(clean), ClipboardText());
+    EXPECT_TRUE(PanelGoes());
