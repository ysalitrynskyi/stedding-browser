+    EXPECT_FALSE(model().IsSpacePinned(loose));
+    EXPECT_EQ(Index(loose) + 1, Index(last)) << "not where it was dropped";
+    EXPECT_FALSE(IsAboveTheLine(loose));
+    EXPECT_TRUE(IsAboveTheLine(pin));
+  }
+  {
+    SCOPED_TRACE("an essential dropped over the line, in the pinned run");
+    ASSERT_NO_FATAL_FAILURE(drag_to(essential, JustInsideTheTopOf(pin)));
