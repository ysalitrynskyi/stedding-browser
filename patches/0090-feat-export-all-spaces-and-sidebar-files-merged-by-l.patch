+using Node = ArcImportPlan::Node;
+
+// The node of `kind` whose url (a tab) or title (a folder) is `key` among
+// `nodes`, or null.
+const Node* FindNode(const std::vector<Node>& nodes,
+                     Node::Kind kind,
+                     const std::string& key) {
+  for (const Node& node : nodes) {
+    if (node.kind != kind) {
+      continue;
+    }
+    if (kind == Node::Kind::kTab ? node.url == GURL(key)
+                                 : node.title == base::UTF8ToUTF16(key)) {
+      return &node;
+    }
+  }
+  return nullptr;
+}
+
+// The titles of the folders `tab` sits in, outermost first, "/" between.
+std::string FolderPath(const tabs::TabInterface* tab) {
+  std::string path;
+  for (const tabs::TabCollection* collection = tab->GetParentCollection();
+       collection; collection = collection->GetParentCollection()) {
+    if (collection->type() == tabs::TabCollection::Type::FOLDER) {
+      const std::string& title =
+          static_cast<const tabs::FolderTabCollection*>(collection)->title();
+      path = path.empty() ? title : title + "/" + path;
+    }
+  }
+  return path;
+}
+
+// Every tab of `strip` by the page it shows, with its token.
+std::map<GURL, std::string> TokensByPage(TabStripModel& strip) {
+  std::map<GURL, std::string> tokens;
+  for (int i = 0; i < strip.count(); ++i) {
+    content::WebContents* const contents = strip.GetWebContentsAt(i);
+    tokens[contents->GetVisibleURL()] = stedding::TabToken(contents);
+  }
+  return tokens;
+}
