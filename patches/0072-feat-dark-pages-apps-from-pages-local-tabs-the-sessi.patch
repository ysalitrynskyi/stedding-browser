+  const auto drawn = [&]() {
+    return separator->GetVisible() && !separator->bounds().IsEmpty();
+  };
+
+  // "Continue where you left off", the bar the Windows run had up.
+  content::WebContents* const contents =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(session_restore_infobar::SessionRestoreInfoBarDelegate::Show(
+      infobars::ContentInfoBarManager::FromWebContents(contents),
+      *browser()->GetProfile(), base::DoNothing(),
+      session_restore_infobar::InfobarMessageType::kTurnOffFromRestart));
+  views::View* const bar = view()->infobar_container();
+  ASSERT_TRUE(bar);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(view());
+    return bar->GetVisible() && bar->height() > 0;
+  })) << "the restore bar did not show";
+
+  // With the row the separator is under it, as Chromium draws it: this is
+  // what the bar brings, so the steps below are not passed by a window that
