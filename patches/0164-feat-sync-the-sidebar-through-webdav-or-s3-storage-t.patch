+  AllowJavascript();
+  CHECK_EQ(args.size(), 2U);
+  const spaces::sidebar_sync::PlaceForm form =
+      spaces::sidebar_sync::CheckPlaceForm(args[1].GetDict());
+  ResolveJavascriptCallback(args[0],
+                            FormAnswer(form, form.place.has_value()));
