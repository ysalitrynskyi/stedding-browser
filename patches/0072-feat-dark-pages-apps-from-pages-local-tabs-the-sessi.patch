+
+void PageThemeColorController::OnDarkPagesChanged() {
+  // A page whose edge was never read holds no sample, and DeleteForPage
+  // asks for one (a DCHECK on the checks build, 2026-10-19).
+  const auto forget_sample = [](content::Page& page) {
+    if (PageTopSample::GetForPage(page)) {
+      PageTopSample::DeleteForPage(page);
+    }
+  };
+  // A page's web preferences still hold the decision it is drawn with: they
+  // are recomputed in a task posted after this change. A change that leaves
+  // a page's decision as it was (another site's entry, a mode that does not
+  // reach it) leaves its edge read alone.
+  const auto decision_changes = [](content::WebContents* contents) {
+    return contents &&
+           contents->GetOrCreateWebPreferences().force_dark_mode_enabled !=
+               DarkPagesApplyTo(contents);
+  };
+  // The edge read before the change is the page as it was: the row would
+  // keep its old colour until the next read, and for a tab in the background
+  // until a moment after it is shown again. Without it the row follows the
+  // theme colour and the background Blink reports once the page has
+  // repainted.
+  TabStripModel* const model = browser_->GetTabStripModel();
+  for (int i = 0; model && i < model->count(); ++i) {
+    content::WebContents* const tab = model->GetWebContentsAt(i);
+    if (tab != web_contents() && decision_changes(tab)) {
+      forget_sample(tab->GetPrimaryPage());
+    }
+  }
+  content::WebContents* const contents = web_contents();
+  if (!decision_changes(contents)) {
+    return;
+  }
+  // The active page's edge is read again after its restyle.
+  forget_sample(contents->GetPrimaryPage());
+  Refresh();
+  ScheduleTopSamples({kSampleAfterStyle, kSampleAfterLoad});
+}
