+bool SpaceTabVisibilityController::RowInView(
+    const tabs::TabInterface* tab) const {
+  if (!tab_strip_root_->IsDrawn()) {
+    return true;
+  }
+  const TabView* const row = DrawnRowOf(*tab_strip_root_, tab);
+  if (!row || !row->IsDrawn() || row->height() <= 0) {
+    return false;
+  }
+  // GetVisibleBounds() is the part of the row its ancestors do not clip:
+  // the list's scroll view clips the rows scrolled out of it.
+  return row->GetVisibleBounds().height() * 2 >= row->height();
+}
