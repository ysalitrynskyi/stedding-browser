+// FolderViews for real folders in a window with Spaces, in a widget, under
+// the sidebar's SpaceTabVisibilityController, which owns which rows show.
+// Tab rows need a browser view, so these tests read the rows' state from
+// TabStripModel::IsTabHidden(), the rule the controller applies to them.
+class FolderRowsTest : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  spaces::SpaceModel& space_model() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model) << "a normal window must own a SpaceModel";
+    return *model;
+  }
+
+  // Opens a tab the way the fixture does (foreground, index 0).
+  tabs::TabInterface* OpenTab() {
+    AddTab(browser(), GURL("https://example.com/"));
+    return tabs().GetActiveTab();
+  }
+
+  void Activate(tabs::TabInterface* tab) {
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(tab));
+  }
+
+  bool IsHidden(tabs::TabInterface* tab) {
+    return tabs().IsTabHidden(tabs().GetIndexOfTab(tab));
+  }
+
+  std::unique_ptr<views::Widget> MakeWidget() {
+    auto widget = std::make_unique<views::Widget>();
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.context = GetContext();
+    widget->Init(std::move(params));
+    return widget;
+  }
+
+  // The strip's view of `folder`, made from a node of its own as the strip
+  // makes one, under `parent`.
+  FolderView* AddFolderView(views::View& parent,
+                            tabs::FolderTabCollection* folder) {
+    nodes_.push_back(std::make_unique<TabCollectionNode>(
+        folder, TabStripOrientation::kVertical));
+    return parent.AddChildView(
+        std::make_unique<FolderView>(nodes_.back().get()));
+  }
+
+ private:
+  // Outlive the widgets, and so the views, of every test.
+  std::vector<std::unique_ptr<TabCollectionNode>> nodes_;
+};
