+constexpr char kPeerW2B13[] = "0123456789abcdef";
+// A second computer, on a later Stedding (Sf34).
+constexpr char kNewerPeerW2B13[] = "fedcba9876543210";
+
+int64_t NowMsW2B13() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+std::string NewTabIdW2B13() {
+  return spaces::TabSyncId(base::Uuid::GenerateRandomV4().AsLowercaseString());
+}
+
+// Another computer's sidebar: one Space with `pins` pins, stamped `t`.
+sb::State PeerStateW2B13(const std::string& space,
+                         const std::vector<std::string>& pins,
+                         int64_t t) {
+  sb::State state;
+  const sb::Stamp stamp{t, kPeerW2B13};
+  sb::Record record(sb::Kind::kSpace);
+  record.f[sb::kFieldName] = sb::Field{"Peer Space", stamp};
+  record.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+  record.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+  state.records[space] = record;
+  state.lists[sb::kSpacesList].order = {space};
+  state.lists[sb::kSpacesList].s = stamp;
+  sb::List& run = state.lists[sb::PinsListOf(space)];
+  run.s = stamp;
+  for (size_t i = 0; i < pins.size(); ++i) {
+    sb::Record pin(sb::Kind::kTab);
+    pin.f[sb::kFieldHome] = sb::Field{
+        "https://peer.example/" + base::NumberToString(i), stamp};
+    pin.f[sb::kFieldName] = sb::Field{"", stamp};
+    pin.f[sb::kFieldParent] = sb::Field{sb::PinsListOf(space), stamp};
+    state.records[pins[i]] = pin;
+    run.order.push_back(pins[i]);
+  }
+  return state;
+}
+
+// A Settings page's listener for the sheet's content, then its Set up...
+// button's message, as the page sends it.
+constexpr char kChooseFolderW2B13[] = R"(
+  (async () => {
+    const cr = await import('chrome://resources/js/cr.js');
+    window.previewW2B13 = new Promise(resolve => {
+      cr.addWebUiListener('stedding-sidebar-sync-preview', resolve);
+    });
+    chrome.send('steddingChooseSyncFolder');
+    return true;
+  })()
+)";
+
+// What the sheet the page was sent shows: the folder, or the refusal.
+constexpr char kSheetW2B13[] = R"(
+  window.previewW2B13.then(
+      preview => preview.refusal ? 'refused ' + preview.refusal : preview.dir)
+)";
+
+// The sheet's Combine, with the name typed in it, answered after the
+// join's own message.
+constexpr char kCombineW2B13[] = R"(
+  (async () => {
+    const cr = await import('chrome://resources/js/cr.js');
+    chrome.send('steddingConfirmSyncJoin', ['combine', $1, []]);
+    await cr.sendWithPromise('steddingSidebarSyncStatus');
+    return true;
