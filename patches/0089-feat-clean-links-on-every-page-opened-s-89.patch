+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/clean_links_throttle.h"
+
+#include <memory>
+#include <optional>
+#include <utility>
+
+#include "base/memory/ptr_util.h"
+#include "chrome/browser/ui/stedding/clean_link.h"
+#include "chrome/browser/ui/stedding/clean_links.h"
+#include "components/prefs/pref_service.h"
+#include "net/http/http_request_headers.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/fetch_api.mojom-shared.h"
+#include "ui/base/page_transition_types.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace stedding {
+
+namespace {
+
+// Cl4, Cl5: whether `request` is the first address of a top-level GET the
+// user opened, the only request this feature touches.
+bool IsAnOpenedPage(const network::ResourceRequest& request,
+                    std::optional<int64_t> navigation_id) {
+  // A navigation's own loader, of the outermost page: never a subresource,
+  // a worker, a frame inside a page, a fenced frame, or a preload made
+  // without a navigation.
+  if (!navigation_id ||
+      request.destination != network::mojom::RequestDestination::kDocument ||
+      !request.is_outermost_main_frame) {
+    return false;
+  }
+  if (request.method != net::HttpRequestHeaders::kGetMethod ||
+      !request.url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  // Cl5: a loader made again after a redirect carries the chain so far; a
+  // later leg is the server's address, followed as given, so a server that
+  // puts a parameter back gets it and nothing loops.
+  if (request.navigation_redirect_chain.size() > 1) {
+    return false;
+  }
+  // Cl4: a reload, a restored page (which loads as a reload), back and
+  // forward show the page as it was; a form, GET forms too, sends what the
+  // page asked for.
+  const ui::PageTransition transition =
+      ui::PageTransitionFromInt(request.transition_type);
+  if (request.is_reload_navigation ||
+      ui::PageTransitionCoreTypeIs(transition, ui::PAGE_TRANSITION_RELOAD) ||
+      ui::PageTransitionCoreTypeIs(transition,
+                                   ui::PAGE_TRANSITION_FORM_SUBMIT) ||
+      (transition & ui::PAGE_TRANSITION_FORWARD_BACK)) {
+    return false;
+  }
+  return true;
+}
+
+// Cl13: whether the page the tab shows, at `page_url`, sent itself to its own
+// address (the same origin and path) with no click behind it: a meta
+// refresh, a script redirect or a later script that puts a tracking
+// parameter on its own address. That is the page's own choice, like a
+// server's redirect (Cl5); cleaning it would load the page again, which
+// asks again, with no end.
+bool IsAPageAskingForItsOwnParameter(const network::ResourceRequest& request,
+                                     const GURL& page_url) {
+  // A navigation the browser started (a typed address, a bookmark, another
+  // app) has no initiator; a click gives the request a user gesture.
+  if (!request.request_initiator || request.has_user_gesture ||
+      !page_url.is_valid()) {
+    return false;
+  }
+  return url::IsSameOriginWith(request.url, page_url) &&
+         request.url.path() == page_url.path();
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<blink::URLLoaderThrottle> CleanLinksThrottle::MaybeCreate(
+    const network::ResourceRequest& request,
+    std::optional<int64_t> navigation_id,
+    const PrefService& prefs,
+    const GURL& page_url,
+    bool force_google_safe_search) {
+  if (!IsAnOpenedPage(request, navigation_id) || !CleanLinksOn(prefs) ||
+      IsAPageAskingForItsOwnParameter(request, page_url)) {
+    return nullptr;
+  }
+  // Cl14: Google's throttle adds SafeSearch's parameters to this address at
+  // the start; a loader takes one change of address there, so this one
+  // stands aside.
+  if (force_google_safe_search &&
+      WithGoogleSafeSearch(request.url) != request.url) {
+    return nullptr;
+  }
+  GURL clean = CleanLinkForNavigation(request.url, CleanLinksKeptSites(prefs));
+  // Cl14: a redirect page skipped into a Google search would never pass
+  // Google's throttle, so the policy's parameters are added here.
+  if (force_google_safe_search) {
+    clean = WithGoogleSafeSearch(clean);
+  }
+  if (clean == request.url || !clean.SchemeIsHTTPOrHTTPS()) {
+    return nullptr;
+  }
+  return base::WrapUnique(
+      new CleanLinksThrottle(request.url, std::move(clean)));
+}
+
+CleanLinksThrottle::CleanLinksThrottle(GURL from, GURL to)
+    : from_(std::move(from)), to_(std::move(to)) {}
+
+CleanLinksThrottle::~CleanLinksThrottle() = default;
+
+void CleanLinksThrottle::DetachFromCurrentSequence() {
+  // The throttle holds only two addresses decided on the UI thread.
+}
+
+void CleanLinksThrottle::WillStartRequest(network::ResourceRequest* request,
+                                          bool* defer) {
+  // Cl1: the loader sees the new address and makes the internal redirect;
+  // nothing has gone to the network yet. The loader hands every throttle the
+  // address the request was made for, so this matches unless the loader was
+  // made for another request.
+  if (request->url == from_) {
+    request->url = to_;
+  }
+}
+
+void CleanLinksThrottle::WillRestartWithURLReset(GURL* url) {
+  // Cl12: a restart goes back to the address the request was made for, which
+  // is the tracked one; it asks for the clean one again instead, so the
+  // server never receives the other and the page commits clean.
+  if (*url == from_) {
+    *url = to_;
+  }
+}
+
+}  // namespace stedding
