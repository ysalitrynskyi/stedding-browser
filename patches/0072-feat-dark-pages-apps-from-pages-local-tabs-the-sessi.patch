+  ui_test_utils::BrowserCreatedObserver opened;
+  chrome::NewEmptyWindow(profile, /*should_trigger_session_restore=*/false);
+  BrowserWindowInterface* const next = opened.Wait();
+  ASSERT_TRUE(next);
+  SetBrowser(next);
