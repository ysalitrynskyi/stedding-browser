+// GitHub issue 90 (sidebar-panels Pn9): a finished download stays in the
+// list after a restart, one from a Space with its own session (sessions S1,
+// its own storage partition) as well as one from a shared Space.
+constexpr char kSharedDownload[] = "/downloads/a_zip_file.zip";
+constexpr char kOwnSessionDownload[] = "/downloads/Picture_1.doc";
+
+// The downloads the history database holds, by their address.
+std::vector<GURL> HistoryDownloads(Profile* profile) {
+  base::test::TestFuture<std::vector<history::DownloadRow>> rows;
+  HistoryServiceFactory::GetForProfile(profile,
+                                       ServiceAccessType::EXPLICIT_ACCESS)
+      ->QueryDownloads(rows.GetCallback());
+  std::vector<GURL> urls;
+  for (const history::DownloadRow& row : rows.Get()) {
+    urls.push_back(row.url_chain.empty() ? GURL() : GURL(row.url_chain.back()));
+  }
+  return urls;
+}
+
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
+                       PRE_ADownloadFromASpaceWithItsOwnSessionStaysListed) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const auto download = [&](const char* path) {
+    content::DownloadTestObserverTerminal done(
+        manager(), 1,
+        content::DownloadTestObserver::ON_DANGEROUS_DOWNLOAD_ACCEPT);
+    ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(path),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_NO_WAIT);
+    done.WaitForFinished();
+    EXPECT_EQ(1u, done.NumDownloadsSeenInState(
+                      download::DownloadItem::COMPLETE));
+  };
+  download(kSharedDownload);
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->SetSpaceIsolated(work, true);
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  download(kOwnSessionDownload);
+  content::DownloadManager::DownloadVector items;
+  manager()->GetAllDownloads(&items);
+  ASSERT_EQ(2u, items.size());
+  // Both are in the history database before the browser quits.
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return HistoryDownloads(browser()->GetProfile()).size() == 2u; }))
+      << HistoryDownloads(browser()->GetProfile()).size()
+      << " download(s) written to history";
+}
+
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
+                       ADownloadFromASpaceWithItsOwnSessionStaysListed) {
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return manager()->IsManagerInitialized();
+  }));
+  content::DownloadManager::DownloadVector items;
+  manager()->GetAllDownloads(&items);
+  std::vector<std::string> paths;
+  for (download::DownloadItem* const item : items) {
+    paths.emplace_back(item->GetURL().path());
+  }
+  EXPECT_TRUE(std::ranges::contains(paths, kSharedDownload));
+  EXPECT_TRUE(std::ranges::contains(paths, kOwnSessionDownload))
+      << "the download from Work's own session is gone after the restart; "
+      << HistoryDownloads(browser()->GetProfile()).size()
+      << " in the history database";
+}
+
 // toolbar T27: with horizontal tabs, Chromium's own toolbar button shows
 // during a download, carries its ring, and the bubble opens from it.
 IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
@@ -391,4 +473,100 @@ IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest,
   })) << "the sidebar is open again and the toolbar kept the download";
 }
 
+// sidebar-panels Pn18 (BACKLOG S-400): a download that starts in a window
+// with the sidebar sends a chip from the page's middle to the sidebar's
+// downloads button -- not to the toolbar's, which the sidebar keeps hidden --
+// and the button then rings once, growing and fading.
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest, ItFliesToTheSidebarsButton) {
+  // A remote desktop session, as the PC's runs are, turns rich animations
+  // off; the flight is what this looks at.
+  const auto rich_animations =
+      gfx::AnimationTestApi::SetRichAnimationRenderMode(
+          gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  const auto full_motion =
+      gfx::AnimationTestApi::SetPrefersReducedMotionForTesting(false);
+  browser()->GetProfile()->GetPrefs()->SetBoolean(stedding::prefs::kUiAnimate,
+                                                  true);
+  views::LabelButton* const button = sidebar_button();
+  ASSERT_TRUE(button);
+  ASSERT_TRUE(button->IsDrawn());
+  views::test::RunScheduledLayout(window());
+  const gfx::Rect button_bounds = button->GetBoundsInScreen();
+  const gfx::Rect page = browser()
+                             ->GetTabStripModel()
+                             ->GetActiveWebContents()
+                             ->GetContainerBounds();
+
+  std::optional<gfx::Rect> flew_from;
+  std::optional<gfx::Rect> flew_to;
+  std::vector<bool> rings;
+  SteddingDownloadFlightViews::SetStartedCallbackForTesting(
+      base::BindLambdaForTesting(
+          [&](const gfx::Rect& from, const gfx::Rect& to) {
+            flew_from = from;
+            flew_to = to;
+          }));
+  SteddingDownloadRingViews::SetStartedCallbackForTesting(
+      base::BindLambdaForTesting(
+          [&](const gfx::Rect& around, bool still) {
+            EXPECT_EQ(button_bounds, around);
+            rings.push_back(still);
+          }));
+
+  ASSERT_TRUE(StartSlowDownload());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return flew_to.has_value(); }))
+      << "no chip flew when the download started";
+  if (flew_to) {
+    EXPECT_EQ(button_bounds, *flew_to);
+    EXPECT_EQ(page, *flew_from);
+  }
+  EXPECT_FALSE(ToolbarButtonShows());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !rings.empty(); }))
+      << "the button did not ring as the chip landed";
+  if (!rings.empty()) {
+    EXPECT_FALSE(rings.front()) << "the ring held still with motion on";
+  }
+
+  SteddingDownloadFlightViews::SetStartedCallbackForTesting({});
+  SteddingDownloadRingViews::SetStartedCallbackForTesting({});
+}
+
+// Pn18, motion O1: with "Animate the sidebar and overlays" off nothing flies;
+// the button's ring alone shows, held still.
+IN_PROC_BROWSER_TEST_F(SteddingDownloadsTest, WithMotionOffOnlyTheButtonRings) {
+  const auto rich_animations =
+      gfx::AnimationTestApi::SetRichAnimationRenderMode(
+          gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  browser()->GetProfile()->GetPrefs()->SetBoolean(stedding::prefs::kUiAnimate,
+                                                  false);
+  views::LabelButton* const button = sidebar_button();
+  ASSERT_TRUE(button);
+  ASSERT_TRUE(button->IsDrawn());
+  views::test::RunScheduledLayout(window());
+  const gfx::Rect button_bounds = button->GetBoundsInScreen();
+
+  bool flew = false;
+  std::vector<bool> rings;
+  SteddingDownloadFlightViews::SetStartedCallbackForTesting(
+      base::BindLambdaForTesting(
+          [&](const gfx::Rect&, const gfx::Rect&) { flew = true; }));
+  SteddingDownloadRingViews::SetStartedCallbackForTesting(
+      base::BindLambdaForTesting(
+          [&](const gfx::Rect& around, bool still) {
+            EXPECT_EQ(button_bounds, around);
+            rings.push_back(still);
+          }));
+
+  ASSERT_TRUE(StartSlowDownload());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !rings.empty(); }))
+      << "the button did not ring with motion off";
+  EXPECT_FALSE(flew) << "a chip flew with motion off";
+  if (!rings.empty()) {
+    EXPECT_TRUE(rings.front()) << "the ring moved with motion off";
+  }
+
+  SteddingDownloadFlightViews::SetStartedCallbackForTesting({});
+  SteddingDownloadRingViews::SetStartedCallbackForTesting({});
+}
+
