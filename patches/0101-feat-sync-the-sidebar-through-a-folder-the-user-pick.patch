@@ -0,0 +1,743 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_sync_apply.h"
+
+#include <algorithm>
+#include <memory>
+#include <optional>
+#include <utility>
+#include <variant>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/raw_ref.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/token.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/sidebar_ids.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_tracker.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+#include "chrome/browser/ui/spaces/unloaded_tab.h"
+#include "chrome/browser/ui/stedding/little_window.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "chrome/browser/ui/stedding/tab_parents.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+using Resolved = std::map<std::string, std::string>;
+
+struct Located {
+  raw_ptr<BrowserWindowInterface> window = nullptr;
+  raw_ptr<tabs::TabInterface> tab = nullptr;
+};
+
+std::optional<SpaceId> ParseSpace(const std::string& id) {
+  return SpaceId::FromOptionalToken(base::Token::FromString(id));
+}
+
+bool IsFolder(const std::string& id) {
+  return FolderIdOf(id).has_value();
+}
+
+// The jar a Space's tabs use: its own while it has one, else the profile's.
+std::string JarOf(const SpaceRegistry& registry, const SpaceId& id) {
+  const RegistryEntry* const entry = registry.Find(id);
+  return entry && entry->isolated ? entry->profile_id : std::string();
+}
+
+// A child whose folder was removed goes to that folder's own place, and so
+// on up (Sf21). Empty while a folder it names has not arrived: it waits.
+std::string EffectiveParent(const State& desired, std::string parent) {
+  for (int depth = 0; IsFolder(parent) && depth <= stedding::kMaxNestDepth;
+       ++depth) {
+    const auto it = desired.records.find(parent);
+    if (it == desired.records.end()) {
+      return std::string();
+    }
+    if (it->second.Alive()) {
+      return parent;
+    }
+    parent = it->second.Get(kFieldParent);
+  }
+  return IsFolder(parent) ? std::string() : parent;
+}
+
+// The Space a container is in: its own for a pinned run or own essentials,
+// its outermost folder's for a folder; empty for the shared row.
+std::string SpaceOfContainer(const State& desired, std::string container) {
+  for (int depth = 0; IsFolder(container) && depth <= stedding::kMaxNestDepth;
+       ++depth) {
+    const auto it = desired.records.find(container);
+    if (it == desired.records.end()) {
+      return std::string();
+    }
+    container = it->second.Get(kFieldParent);
+  }
+  return SpaceOfList(container);
+}
+
+bool IsEssentialsContainer(const std::string& container) {
+  return container == kEssentialsList ||
+         (!SpaceOfList(container).empty() &&
+          container == OwnEssentialsListOf(SpaceOfList(container)));
+}
+
+// Every tab of the registry windows that has a token, by canonical id.
+std::map<std::string, Located> IndexTabs(
+    const std::vector<BrowserWindowInterface*>& windows,
+    const Resolved& resolved) {
+  std::map<std::string, Located> index;
+  for (BrowserWindowInterface* const window : windows) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      const std::string id = SyncIdOfTab(tab, resolved);
+      if (!id.empty()) {
+        index.emplace(id, Located{window, tab});
+      }
+    }
+  }
+  return index;
+}
+
+tabs::FolderTabCollection* FindLocalFolderUnder(
+    const tabs::TabCollection& collection,
+    const std::string& id,
+    const Resolved& resolved) {
+  for (const tabs::Child& child : collection.GetChildren()) {
+    const std::unique_ptr<tabs::TabCollection>* const sub =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (!sub || !*sub) {
+      continue;
+    }
+    tabs::TabCollection* const node = sub->get();
+    if (node->type() == tabs::TabCollection::Type::FOLDER) {
+      auto* const folder = static_cast<tabs::FolderTabCollection*>(node);
+      if (Canonical(resolved, FolderSyncId(folder->id())) == id) {
+        return folder;
+      }
+    }
+    if (tabs::FolderTabCollection* const found =
+            FindLocalFolderUnder(*node, id, resolved)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+tabs::FolderTabCollection* FindLocalFolder(TabStripModel* strip,
+                                           const std::string& id,
+                                           const Resolved& resolved) {
+  const tabs::TabCollection* const root = strip->Root();
+  return root ? FindLocalFolderUnder(*root, id, resolved) : nullptr;
+}
+
+tabs::FolderTabCollection* TopFolderOf(tabs::FolderTabCollection* folder) {
+  for (tabs::TabCollection* up = folder->GetParentCollection();
+       up && up->type() == tabs::TabCollection::Type::FOLDER;
+       up = up->GetParentCollection()) {
+    folder = static_cast<tabs::FolderTabCollection*>(up);
+  }
+  return folder;
+}
+
+class Applier {
+ public:
+  Applier(Profile* profile,
+          Ledger& ledger,
+          const Resolved& resolved,
+          const std::set<std::string>& move_now,
+          ApplyOutcome& out)
+      : profile_(profile),
+        ledger_(ledger),
+        desired_(ledger.state),
+        resolved_(resolved),
+        move_now_(move_now),
+        out_(out) {}
+
+  void Run() {
+    windows_ = RegistryWindows(profile_);
+    registry_ = SpaceRegistryFactory::GetForProfile(profile_);
+    if (windows_.empty() || !registry_) {
+      out_->no_window = true;
+      return;
+    }
+    // Every tab here knows its Space; no route moves what sync places
+    // (Sf17).
+    std::vector<std::unique_ptr<SpaceModel::ScopedRoutingPause>> pauses;
+    for (BrowserWindowInterface* const window : windows_) {
+      pauses.push_back(std::make_unique<SpaceModel::ScopedRoutingPause>(
+          SpaceModel::From(window)));
+    }
+    ApplySpaces();
+    ApplyPresentItems();
+    InsertPending();
+  }
+
+ private:
+  SpaceModel* FirstModel() { return SpaceModel::From(windows_.front()); }
+
+  void ApplySpaces() {
+    for (const auto& [id, record] : desired_->records) {
+      if (record.kind != Kind::kSpace) {
+        continue;
+      }
+      const std::optional<SpaceId> space = ParseSpace(id);
+      if (!space) {
+        continue;
+      }
+      const RegistryEntry* const found = registry_->Find(*space);
+      if (!record.Alive()) {
+        // Sf23: only after the user chose Delete here; a deletion from
+        // another computer is always held until then.
+        if (found && FirstModel()->RemoveSpace(*space)) {
+          ++out_->applied;
+        }
+        continue;
+      }
+      const std::string& name = record.Get(kFieldName);
+      const std::string& icon = record.Get(kFieldIcon);
+      const std::optional<SkColor> dark =
+          ColorFromHex(record.Get(kFieldDarkColor));
+      const bool chosen = record.Get(kFieldColorChosen) == "1";
+      const bool isolated = record.Get(kFieldIsolated) == "1";
+      if (!found) {
+        RegistryEntry made(
+            *space, name,
+            ColorFromHex(record.Get(kFieldColor)).value_or(SK_ColorGRAY));
+        made.icon = icon;
+        made.color_chosen = chosen;
+        made.dark_color = dark;
+        registry_->AddExisting(made);
+        // Sf24: a Space made here with its own session takes a jar of its
+        // own, new and empty, before any tab is in it.
+        if (isolated) {
+          FirstModel()->SetSpaceIsolated(*space, true);
+        }
+        ledger_->pending_adds.erase(id);
+        ++out_->applied;
+        continue;
+      }
+      // Copies: a setter tells the windows, which may read the registry.
+      const RegistryEntry entry = *found;
+      const SkColor color =
+          ColorFromHex(record.Get(kFieldColor)).value_or(entry.color);
+      bool changed = false;
+      if (entry.name != name) {
+        registry_->SetName(*space, name);
+        changed = true;
+      }
+      if (entry.icon != icon) {
+        registry_->SetIcon(*space, icon);
+        changed = true;
+      }
+      if (entry.color != color || entry.dark_color != dark ||
+          entry.color_chosen != chosen) {
+        registry_->SetColor(*space, color, chosen, dark);
+        changed = true;
+      }
+      if (changed) {
+        ++out_->applied;
+      }
+      // Sf24: never applied here without a yes.
+      if (entry.isolated != isolated) {
+        const auto kept = ledger_->isolation_kept.find(id);
+        if (kept == ledger_->isolation_kept.end() ||
+            kept->second != record.Get(kFieldIsolated)) {
+          out_->isolation_questions.push_back(id);
+        }
+      }
+    }
+    ApplySpaceOrder();
+  }
+
+  void ApplySpaceOrder() {
+    const auto list = desired_->lists.find(kSpacesList);
+    if (list == desired_->lists.end()) {
+      return;
+    }
+    std::vector<SpaceId> wanted;
+    for (const std::string& id : list->second.order) {
+      const std::optional<SpaceId> space = ParseSpace(id);
+      if (space && desired_->FindAlive(id) && registry_->Find(*space)) {
+        wanted.push_back(*space);
+      }
+    }
+    const auto index_of = [this](const SpaceId& id) {
+      const std::vector<RegistryEntry>& entries = registry_->entries();
+      for (size_t i = 0; i < entries.size(); ++i) {
+        if (entries[i].id == id) {
+          return static_cast<int>(i);
+        }
+      }
+      return -1;
+    };
+    for (size_t i = 1; i < wanted.size(); ++i) {
+      const int before = index_of(wanted[i - 1]);
+      const int here = index_of(wanted[i]);
+      if (before >= 0 && here >= 0 && here < before) {
+        if (registry_->Move(wanted[i], before - here)) {
+          ++out_->applied;
+        }
+      }
+    }
+  }
+
+  void ApplyPresentItems() {
+    const LocalView view = BuildLocalView(profile_, *resolved_);
+    std::map<std::string, Located> located = IndexTabs(windows_, *resolved_);
+    for (const auto& [id, item] : view.items) {
+      const auto record = desired_->records.find(id);
+      if (record == desired_->records.end()) {
+        continue;
+      }
+      if (item.kind == Kind::kFolder) {
+        ApplyFolder(id, record->second);
+        continue;
+      }
+      if (item.kind != Kind::kTab) {
+        continue;
+      }
+      const auto here = located.find(id);
+      if (here == located.end()) {
+        continue;
+      }
+      // The tab may be closed below, and no raw_ptr may still point at it
+      // when it goes: the index lets go of it first.
+      BrowserWindowInterface* const window = here->second.window;
+      tabs::TabInterface* const tab = here->second.tab;
+      located.erase(here);
+      ApplyTab(id, item, record->second, window, tab);
+    }
+  }
+
+  void ApplyFolder(const std::string& id, const Record& record) {
+    for (BrowserWindowInterface* const window : windows_) {
+      TabStripModel* const strip = window->GetTabStripModel();
+      tabs::FolderTabCollection* const folder =
+          FindLocalFolder(strip, id, *resolved_);
+      if (!folder) {
+        continue;
+      }
+      if (!record.Alive()) {
+        // Sf21: a folder removed elsewhere lets its tabs go, in its place.
+        strip->MoveTabsOutOfFolder(folder);
+        ++out_->applied;
+        return;
+      }
+      const std::string& title = record.Get(kFieldTitle);
+      if (folder->title() != title) {
+        folder->SetTitle(title);
+        ++out_->applied;
+      }
+      return;
+    }
+  }
+
+  void ApplyTab(const std::string& id,
+                const LocalItem& item,
+                const Record& record,
+                BrowserWindowInterface* window,
+                tabs::TabInterface* tab) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    SpaceModel* const model = SpaceModel::From(window);
+    const auto field = [&item](const char* name) -> std::string {
+      const auto it = item.fields.find(name);
+      return it == item.fields.end() ? std::string() : it->second;
+    };
+    const std::string parent =
+        EffectiveParent(*desired_, record.Get(kFieldParent));
+    const std::string& home = record.Get(kFieldHome);
+    const std::string& name = record.Get(kFieldName);
+    const bool remove = !record.Alive();
+    const bool move = !remove && !parent.empty() && parent != field(kFieldParent);
+    const bool rehome = !remove && !home.empty() &&
+                        item.fields.contains(kFieldHome) &&
+                        field(kFieldHome) != home;
+    const bool rename = !remove && field(kFieldName) != name;
+    if (!remove && !move && !rehome && !rename) {
+      return;
+    }
+    // Sf21, Sf25: the tab the user is on is left alone until they leave it.
+    if (strip->GetActiveTab() == tab) {
+      ++out_->deferred;
+      return;
+    }
+    if (remove) {
+      RemoveHere(id, window, tab);
+      return;
+    }
+    if (move && !MoveHere(id, window, tab, parent)) {
+      return;
+    }
+    if (rehome || move) {
+      if (!home.empty()) {
+        model->SetHomeUrl(tab, GURL(home));
+      }
+    }
+    if (rename) {
+      stedding::SetTabName(window, tab, base::UTF8ToUTF16(name));
+    }
+    ++out_->applied;
+  }
+
+  // Sf21: what another computer removed.
+  void RemoveHere(const std::string& id,
+                  BrowserWindowInterface* window,
+                  tabs::TabInterface* tab) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    SpaceModel* const model = SpaceModel::From(window);
+    const int index = strip->GetIndexOfTab(tab);
+    if (index == TabStripModel::kNoTab) {
+      return;
+    }
+    // Sync put it here and it was never opened: Recently Closed, so
+    // Shift-Cmd-T brings it back.
+    if (ledger_->inserted_unopened.erase(id) &&
+        tab->GetContents()->WasDiscarded()) {
+      strip->CloseWebContentsAt(index,
+                                TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+      ++out_->applied;
+      return;
+    }
+    // Otherwise it stays open, an ordinary tab of its Space.
+    if (tab->IsPinned()) {
+      strip->SetTabPinned(index, false);
+    } else {
+      strip->MoveTabOutOfFolders(index);
+      model->SetSpacePinned(tab, false);
+    }
+    ++out_->applied;
+  }
+
+  // Sf17, Sf25: moves a present pin or essential to `parent`. False when it
+  // waits: its Space is not here yet, or the move would reload a loaded
+  // page into another session (held until it sleeps, or Move now).
+  bool MoveHere(const std::string& id,
+                BrowserWindowInterface* window,
+                tabs::TabInterface* tab,
+                const std::string& parent) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    SpaceModel* const model = SpaceModel::From(window);
+    const std::string space_text = SpaceOfContainer(*desired_, parent);
+    std::optional<SpaceId> space;
+    if (!space_text.empty()) {
+      space = ParseSpace(space_text);
+      if (!space || !model->GetSpace(*space)) {
+        return false;
+      }
+    }
+    const std::optional<SpaceId> current = model->FindSpaceForTab(tab);
+    // The Space the tab is filed in once moved. The shared row is no Space's:
+    // a tab joining it from a Space with a session of its own is filed in the
+    // Space that shows the shared row (spaces B6), else it stays where it is.
+    std::optional<SpaceId> filed = space;
+    if (!filed && parent == kEssentialsList) {
+      if (const std::optional<SpaceId> shared =
+              model->SpaceForSharedEssentials();
+          shared && current && model->SpaceIsIsolated(*current)) {
+        filed = shared;
+      }
+    }
+    if (!filed) {
+      filed = current;
+    }
+    // Sf25: the session the page is in now against the one it is in once
+    // moved. A shared essential is in the profile's, whatever Space it is
+    // filed in; a pin, or a Space's own essential, is in its Space's -- and
+    // the Space that shows the shared row has none of its own, so the shared
+    // row is the profile's session too.
+    if (current && filed &&
+        (model->IsSharedEssential(tab) ? std::string()
+                                       : JarOf(*registry_, *current)) !=
+            JarOf(*registry_, *filed) &&
+        !tab->GetContents()->WasDiscarded() && !move_now_->contains(id)) {
+      out_->held_moves.push_back(id);
+      return false;
+    }
+    if (IsEssentialsContainer(parent)) {
+      // spaces B6: whether a pinned tab is its Space's own essential or a
+      // shared one is settled when it is pinned, by the Space it is filed in
+      // then. A pinned tab whose part changes is let go first and pinned
+      // again in its new Space; refiling it while pinned kept the old part.
+      const bool own = filed && model->SpaceIsIsolated(*filed);
+      if (tab->IsPinned() && model->IsOwnEssential(tab) != own) {
+        strip->SetTabPinned(strip->GetIndexOfTab(tab), false);
+      }
+      if (!tab->IsPinned()) {
+        strip->MoveTabOutOfFolders(strip->GetIndexOfTab(tab));
+      }
+      if (filed) {
+        model->SetSpaceForTab(tab, *filed);
+      }
+      if (!tab->IsPinned()) {
+        strip->SetTabPinned(strip->GetIndexOfTab(tab), true);
+      }
+      return true;
+    }
+    if (tab->IsPinned()) {
+      strip->SetTabPinned(strip->GetIndexOfTab(tab), false);
+    }
+    if (space && (!current || *space != *current)) {
+      model->SetSpaceForTab(tab, *space);
+    }
+    if (IsFolder(parent)) {
+      return PutInFolder(window, tab, parent);
+    }
+    strip->MoveTabOutOfFolders(strip->GetIndexOfTab(tab));
+    if (!model->IsSpacePinned(tab)) {
+      model->SetSpacePinned(tab, true);
+    }
+    return true;
+  }
+
+  // Sf17: puts `tab` into the folder `folder_id`, making the folders the
+  // ledger has and this window lacks around it. A folder new to the run
+  // joins its end; a tab joining a pinned folder is pinned in place.
+  bool PutInFolder(BrowserWindowInterface* window,
+                   tabs::TabInterface* tab,
+                   const std::string& folder_id) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    SpaceModel* const model = SpaceModel::From(window);
+    std::vector<std::string> chain;
+    std::string up = folder_id;
+    for (int depth = 0; IsFolder(up) && depth <= stedding::kMaxNestDepth;
+         ++depth) {
+      const auto it = desired_->records.find(up);
+      if (it == desired_->records.end()) {
+        return false;
+      }
+      // Sf21: a folder removed elsewhere is not made again around a live
+      // one; what was in it sits in its place, as EffectiveParent puts a
+      // tab.
+      if (it->second.Alive()) {
+        chain.insert(chain.begin(), up);
+      }
+      up = it->second.Get(kFieldParent);
+    }
+    tabs::FolderTabCollection* deepest = nullptr;
+    size_t made_from = 0;
+    for (size_t i = 0; i < chain.size(); ++i) {
+      tabs::FolderTabCollection* const found =
+          FindLocalFolder(strip, chain[i], *resolved_);
+      if (!found) {
+        break;
+      }
+      deepest = found;
+      made_from = i + 1;
+    }
+    const bool top_was_pinned =
+        deepest && model->IsFolderSpacePinned(TopFolderOf(deepest));
+    if (deepest && tab->GetParentCollection() != deepest) {
+      strip->MoveTabsToFolder({strip->GetIndexOfTab(tab)}, deepest);
+    }
+    for (size_t i = made_from; i < chain.size(); ++i) {
+      tabs::FolderTabCollection* const made = strip->AddToNewFolder(
+          {strip->GetIndexOfTab(tab)}, deepest, FolderIdOf(chain[i]));
+      if (!made) {
+        return false;
+      }
+      made->SetTitle(desired_->records.at(chain[i]).Get(kFieldTitle));
+      deepest = made;
+    }
+    if (!deepest) {
+      return false;
+    }
+    tabs::FolderTabCollection* const top = TopFolderOf(deepest);
+    if (top_was_pinned) {
+      model->SetSpacePinnedInPlace(tab, true);
+    } else if (model->CanPinFolder(top) && !model->IsFolderSpacePinned(top)) {
+      model->SetFolderSpacePinned(top, true);
+    }
+    return true;
+  }
+
+  // Sf17: the registry window that holds the most pins of `space`, else the
+  // last-active one.
+  BrowserWindowInterface* TargetWindow(const std::optional<SpaceId>& space) {
+    BrowserWindowInterface* best = nullptr;
+    size_t best_count = 0;
+    if (space) {
+      for (BrowserWindowInterface* const window : windows_) {
+        SpaceModel* const model = SpaceModel::From(window);
+        TabStripModel* const strip = window->GetTabStripModel();
+        size_t count = 0;
+        for (int i = 0; i < strip->count(); ++i) {
+          const tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+          if (model->IsSpacePinned(tab) &&
+              model->FindSpaceForTab(tab) == *space) {
+            ++count;
+          }
+        }
+        if (count > best_count) {
+          best = window;
+          best_count = count;
+        }
+      }
+    }
+    if (best) {
+      return best;
+    }
+    BrowserWindowInterface* const last =
+        stedding::LastActiveNormalWindow(profile_);
+    return IsRegistryWindow(last, profile_) ? last : windows_.front();
+  }
+
+  void InsertPending() {
+    std::set<std::string> present;
+    for (const std::string& id : CollectPresentIds(profile_)) {
+      present.insert(Canonical(*resolved_, id));
+    }
+    const std::set<std::string> pending = ledger_->pending_adds;
+    for (const std::string& id : pending) {
+      const Record* const record = desired_->FindAlive(id);
+      if (!record || present.contains(id) || record->kind == Kind::kSpace) {
+        ledger_->pending_adds.erase(id);
+        continue;
+      }
+      // A folder is made around its first tab (Sf17): an empty one waits.
+      if (record->kind != Kind::kTab) {
+        continue;
+      }
+      const std::string& home = record->Get(kFieldHome);
+      if (home.empty()) {
+        ledger_->pending_adds.erase(id);
+        continue;
+      }
+      const std::string parent =
+          EffectiveParent(*desired_, record->Get(kFieldParent));
+      if (parent.empty()) {
+        continue;
+      }
+      const std::string space_text = SpaceOfContainer(*desired_, parent);
+      std::optional<SpaceId> space;
+      if (!space_text.empty()) {
+        space = ParseSpace(space_text);
+        if (!space || !registry_->Find(*space)) {
+          continue;
+        }
+      }
+      BrowserWindowInterface* const window = TargetWindow(space);
+      TabStripModel* const strip = window->GetTabStripModel();
+      SpaceModel* const model = SpaceModel::From(window);
+      const std::string& name = record->Get(kFieldName);
+      tabs::TabInterface* const tab = InsertUnloadedTab(
+          strip, profile_, GURL(home),
+          base::UTF8ToUTF16(name.empty() ? home : name));
+      if (!tab) {
+        continue;
+      }
+      if (space) {
+        model->SetSpaceForTab(tab, *space);
+      } else if (const std::optional<SpaceId> shared =
+                     model->SpaceForSharedEssentials();
+                 shared && model->SpaceIsIsolated(model->SpaceForTab(tab))) {
+        model->SetSpaceForTab(tab, *shared);
+      }
+      // Sf2: the tab keeps the id the other computers know it by. Set after
+      // the Space, whose jar may have replaced the contents.
+      stedding::SetTabToken(tab, TokenOf(id));
+      if (IsEssentialsContainer(parent)) {
+        strip->SetTabPinned(strip->GetIndexOfTab(tab), true);
+      } else if (IsFolder(parent)) {
+        PutInFolder(window, tab, parent);
+      } else {
+        model->SetSpacePinned(tab, true);
+      }
+      model->SetHomeUrl(tab, GURL(home));
+      if (!name.empty()) {
+        stedding::SetTabName(window, tab, base::UTF8ToUTF16(name));
+      }
+      ledger_->inserted_unopened.insert(id);
+      ledger_->pending_adds.erase(id);
+      present.insert(id);
+      ++out_->applied;
+    }
+    // Folders made around their tabs are here now.
+    std::set<std::string> now_present;
+    for (const std::string& id : CollectPresentIds(profile_)) {
+      now_present.insert(Canonical(*resolved_, id));
+    }
+    std::erase_if(ledger_->pending_adds, [&](const std::string& id) {
+      return now_present.contains(id);
+    });
+  }
+
+  const raw_ptr<Profile> profile_;
+  const raw_ref<Ledger> ledger_;
+  const raw_ref<const State> desired_;
+  const raw_ref<const Resolved> resolved_;
+  const raw_ref<const std::set<std::string>> move_now_;
+  const raw_ref<ApplyOutcome> out_;
+  std::vector<BrowserWindowInterface*> windows_;
+  raw_ptr<SpaceRegistry> registry_ = nullptr;
+};
+
+}  // namespace
+
+ApplyOutcome::ApplyOutcome() = default;
+ApplyOutcome::ApplyOutcome(const ApplyOutcome& other) = default;
+ApplyOutcome& ApplyOutcome::operator=(const ApplyOutcome& other) = default;
+ApplyOutcome::~ApplyOutcome() = default;
+
+ApplyOutcome ApplyToWindows(Profile* profile,
+                            Ledger& ledger,
+                            const Resolved& resolved,
+                            const std::set<std::string>& move_now) {
+  ApplyOutcome out;
+  Applier(profile, ledger, resolved, move_now, out).Run();
+  return out;
+}
+
+size_t CountSyncedItemsNotHere(Profile* profile,
+                               const Ledger& ledger,
+                               const Resolved& resolved) {
+  std::set<std::string> present;
+  for (const std::string& id : CollectPresentIds(profile)) {
+    present.insert(Canonical(resolved, id));
+  }
+  size_t count = 0;
+  for (const auto& [id, record] : ledger.state.records) {
+    if (record.kind == Kind::kTab && record.Alive() &&
+        !record.Get(kFieldHome).empty() && !present.contains(id)) {
+      ++count;
+    }
+  }
+  return count;
+}
+
+size_t BringSyncedItemsHere(Profile* profile,
+                            Ledger& ledger,
+                            const Resolved& resolved) {
+  std::set<std::string> present;
+  for (const std::string& id : CollectPresentIds(profile)) {
+    present.insert(Canonical(resolved, id));
+  }
+  for (const auto& [id, record] : ledger.state.records) {
+    if (record.kind == Kind::kTab && record.Alive() &&
+        !record.Get(kFieldHome).empty() && !present.contains(id)) {
+      ledger.pending_adds.insert(id);
+    }
+  }
+  const size_t waiting = CountSyncedItemsNotHere(profile, ledger, resolved);
+  ApplyToWindows(profile, ledger, resolved, {});
+  const size_t left = CountSyncedItemsNotHere(profile, ledger, resolved);
+  return waiting - std::min(waiting, left);
+}
+
+}  // namespace spaces::sidebar_sync
