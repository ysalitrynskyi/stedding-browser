@@ -0,0 +1,137 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/glyph_ink.h"
+
+#include <algorithm>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/models/image_model.h"
+#include "ui/color/color_variant.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/font_list.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/image/image_skia.h"
+#include "ui/gfx/image/image_skia_rep.h"
+#include "ui/gfx/text_utils.h"
+
+namespace stedding {
+namespace {
+
+// Measured as the sidebar's tests read the screen: at the Mac's scale.
+constexpr float kScale = 2.f;
+
+// The glyphs a Space without an icon takes by its place, and an icon picked.
+constexpr const char* kGlyphs[] = {
+    "\xF0\x9F\x8F\xA0",  // house
+    "\xF0\x9F\x92\xBC",  // briefcase
+    "\xF0\x9F\x93\x9A",  // books
+    "\xF0\x9F\x8E\xA8",  // palette
+    "\xF0\x9F\x94\xAC",  // microscope
+    "\xF0\x9F\x8E\xB5",  // note
+    "\xF0\x9F\x9A\x80",  // rocket
+};
+
+// The centre across `bitmap`, in DIP, of every pixel column anything is
+// drawn in, the faintest edge too; nothing when nothing is drawn.
+std::optional<double> DrawnCentre(const SkBitmap& bitmap) {
+  int left = bitmap.width();
+  int right = -1;
+  for (int y = 0; y < bitmap.height(); ++y) {
+    for (int x = 0; x < bitmap.width(); ++x) {
+      if (SkColorGetA(bitmap.getColor(x, y)) > 0) {
+        left = std::min(left, x);
+        right = std::max(right, x);
+      }
+    }
+  }
+  if (right < 0) {
+    return std::nullopt;
+  }
+  return (left + right + 1) / 2.0 / kScale;
+}
+
+// sidebar Y8, Y28 (the owner, 2026-10-20): a glyph a label centres in its
+// bounds, moved by InkCentringShift, stands within half a DIP of the centre
+// asked for, counting every pixel it draws, at each text size the sidebar
+// can draw a Space's glyph at, in a label of either parity and about a
+// centre on a whole DIP or between two. Left out of the ink, the faint
+// column at an emoji's edge put the rail's title row 0.75 DIP right of the
+// rail's column on Windows (Segoe UI Emoji at 17 DIP).
+TEST(GlyphInkTest, AGlyphMovedByItsShiftStandsOnTheCentre) {
+  const gfx::FontList base;
+  constexpr int kRowWidth = 64;
+  for (int size = 10; size <= 26; ++size) {
+    const gfx::FontList font =
+        base.DeriveWithSizeDelta(size - base.GetFontSize());
+    for (const char* const utf8 : kGlyphs) {
+      const std::u16string glyph = base::UTF8ToUTF16(utf8);
+      const int advance = gfx::GetStringWidth(glyph, font);
+      for (int width : {advance, advance + 1}) {
+        for (float centre : {32.f, 32.5f}) {
+          SCOPED_TRACE(testing::Message()
+                       << "size " << size << ", glyph " << utf8 << ", label "
+                       << width << " DIP wide, centre " << centre);
+          gfx::Rect label((kRowWidth - width) / 2, 0, width, font.GetHeight());
+          label.Offset(InkCentringShift(glyph, font, label, centre), 0);
+          gfx::Canvas canvas(gfx::Size(kRowWidth, font.GetHeight()), kScale,
+                             /*is_opaque=*/false);
+          canvas.DrawStringRectWithFlags(
+              glyph, font, SK_ColorBLACK, label,
+              gfx::Canvas::TEXT_ALIGN_CENTER | gfx::Canvas::NO_ELLIPSIS |
+                  gfx::Canvas::NO_SUBPIXEL_RENDERING);
+          const std::optional<double> drawn = DrawnCentre(canvas.GetBitmap());
+          if (!drawn) {
+            // A font with no picture for it draws nothing to centre.
+            continue;
+          }
+          EXPECT_NEAR(centre, *drawn, 0.5)
+              << "the glyph stands " << *drawn - centre << " DIP off";
+        }
+      }
+    }
+  }
+}
+
+// sidebar Y8: the open sidebar's title row draws the Space's glyph as an
+// image the favicons' size; every pixel of its picture is centred across
+// the image within the half DIP the column allows (the owner, 2026-10-20).
+// On Windows the picture stood up to 1.25 DIP off: a text two DIP or more
+// wider than the image was centred as if it fitted, and its clip moved with
+// it. On the Mac the microscope at 18 to 23 DIP stands exactly half a DIP
+// left in images narrower than it, which is within the bound.
+TEST(GlyphInkTest, TheGlyphImageCentresItsPicture) {
+  const gfx::FontList base;
+  for (int size = 10; size <= 26; ++size) {
+    const gfx::FontList font =
+        base.DeriveWithSizeDelta(size - base.GetFontSize());
+    for (const char* const utf8 : kGlyphs) {
+      for (int width : {14, 16, 18, 22}) {
+        SCOPED_TRACE(testing::Message() << "size " << size << ", glyph " << utf8
+                                        << ", image " << width);
+        const gfx::ImageSkia image =
+            CentredGlyphImage(base::UTF8ToUTF16(utf8), font,
+                              ui::ColorVariant(SK_ColorBLACK), width)
+                .Rasterize(nullptr);
+        const std::optional<double> drawn =
+            DrawnCentre(image.GetRepresentation(kScale).GetBitmap());
+        if (!drawn) {
+          continue;
+        }
+        EXPECT_NEAR(width / 2.0, *drawn, 0.5)
+            << "the picture stands " << *drawn - width / 2.0 << " DIP off";
+      }
+    }
+  }
+}
+
+}  // namespace
+}  // namespace stedding
