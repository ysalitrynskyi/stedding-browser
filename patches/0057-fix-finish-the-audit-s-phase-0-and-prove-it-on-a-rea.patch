+// The collapsed rail (PLAN.md WIN-3; sidebar Y8, Y11). The rows' form --
+// labels, or glyphs alone -- follows the width being drawn at every step of
+// a collapse and an expand, so no frame shows the wrong one; and hovering
+// the rail again and again leaves one click handler, not one per hover. In
+// the rail the New Tab and Archived rows are glyphs, and still have names.
+// A drifted pin wears the dot or the slash, never both (PLAN.md TAB-2).
+
+#include <cstddef>
+
+#include "base/test/run_until.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/animation/browser_animation_controller.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
