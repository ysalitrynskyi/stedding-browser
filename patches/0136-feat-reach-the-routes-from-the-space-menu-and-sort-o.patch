+// routing D16: a sort moves the loose tabs a rule names, from every Space, and
+// leaves what was put somewhere: an essential, a Space pin, a tab in a folder
+// or a split. A rule naming no Space moves nothing.
+TEST_F(SpaceWindowTest, SortMovesOnlyLooseTabsARuleNames) {
+  PrefService* const prefs = profile()->GetPrefs();
+  const SpaceId home = model().active_id();
+  Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  Space* const play = model().AddSpace("Play", SK_ColorGREEN);
+  // Made before the rules, or each would be routed as it opens.
+  AddTab(browser(), GURL("https://a.test/loose"));
+  tabs::TabInterface* const loose = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://a.test/essential"));
+  tabs::TabInterface* const essential = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://a.test/folder"));
+  tabs::TabInterface* const in_folder = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://a.test/split"));
+  tabs::TabInterface* const in_split = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://a.test/split2"));
+  tabs::TabInterface* const in_split_too = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://b.test/contains"));
+  tabs::TabInterface* const by_text = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://c.test/"));
+  tabs::TabInterface* const unruled = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://d.test/"));
+  tabs::TabInterface* const no_space = tabs().GetActiveTab();
+  model().SetSpaceForTab(by_text, work->id());
+  tabs().SetTabPinned(tabs().GetIndexOfTab(essential), true);
+  tabs().AddToNewFolder({tabs().GetIndexOfTab(in_folder)});
+  Use(tabs(), in_split_too);
+  tabs().AddToNewSplit({tabs().GetIndexOfTab(in_split)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(in_split->IsSplit() && in_split_too->IsSplit());
+
+  AddRoute(prefs, SiteRouteFor(GURL("https://a.test/"), work->id().ToString()));
+  Route by_contains;
+  by_contains.match = Route::Match::kContains;
+  by_contains.pattern = "/contains";
+  by_contains.space = play->id().ToString();
+  AddRoute(prefs, by_contains);
+  base::ListValue raw = prefs->GetList(stedding::prefs::kSpaceRoutes).Clone();
+  base::DictValue none;
+  none.Set("match", "site");
+  none.Set("pattern", "d.test");
+  none.Set("space", "");
+  raw.Append(std::move(none));
+  prefs->SetList(stedding::prefs::kSpaceRoutes, std::move(raw));
+
+  EXPECT_EQ(2u, model().CountTabsRoutesWouldMove());
+  EXPECT_EQ(2u, model().SortOpenTabsByRoutes());
+  EXPECT_EQ(work->id(), model().SpaceForTab(loose));
+  EXPECT_EQ(play->id(), model().SpaceForTab(by_text)) << "any kind, any Space";
+  EXPECT_EQ(home, model().SpaceForTab(in_folder));
+  EXPECT_EQ(home, model().SpaceForTab(in_split));
+  EXPECT_EQ(home, model().SpaceForTab(unruled));
+  EXPECT_EQ(home, model().SpaceForTab(no_space));
+  EXPECT_TRUE(essential->IsPinned());
+  EXPECT_EQ(0u, model().CountTabsRoutesWouldMove()) << "a second sort is quiet";
+  EXPECT_EQ(0u, model().SortOpenTabsByRoutes());
+}
+
+// routing D16: a Space pin stays, and the window stays on the Space it shows
+// when the active tab is the one that goes.
+TEST_F(SpaceWindowTest, SortStaysOnTheSpaceOnScreen) {
+  const SpaceId home = model().active_id();
+  Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  AddTab(browser(), GURL("https://b.test/"));
+  tabs::TabInterface* const stays = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://a.test/pin"));
+  tabs::TabInterface* const pin = tabs().GetActiveTab();
+  model().SetSpacePinned(pin, true);
+  AddTab(browser(), GURL("https://a.test/"));
+  tabs::TabInterface* const active = tabs().GetActiveTab();
+  AddRoute(profile()->GetPrefs(),
+           SiteRouteFor(GURL("https://a.test/"), work->id().ToString()));
+  EXPECT_EQ(1u, model().SortOpenTabsByRoutes());
+  task_environment()->RunUntilIdle();
+  EXPECT_EQ(work->id(), model().SpaceForTab(active));
+  EXPECT_EQ(home, model().SpaceForTab(pin));
+  EXPECT_EQ(home, model().active_id());
+  EXPECT_EQ(home, model().SpaceForTab(tabs().GetActiveTab()));
+  EXPECT_EQ(home, model().SpaceForTab(stays));
+}
