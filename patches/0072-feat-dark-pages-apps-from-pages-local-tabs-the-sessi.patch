+  chrome::ExecuteCommand(browser(), IDC_RESTORE_TAB);  // ⇧⌘T
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return TabsOn("lone-closed.test") == 1u;
+  })) << "⇧⌘T did not reopen the tab closed last";
+  EXPECT_EQ(1u, TabsOn("lone-a.test")) << "⇧⌘T reopened the window again";
+  EXPECT_EQ(1u, GetAllBrowserWindowInterfaces().size());
+}
