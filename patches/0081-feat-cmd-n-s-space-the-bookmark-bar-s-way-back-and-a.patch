+// import I16 (PLAN.md WEB-11; decided 2026-10-22): up to
+// kBookmarksToPinsWithoutAsking bookmarks turn into pinned tabs at once (the
+// test above); above that the command asks first, with the count of the ones
+// it would add. Cancel changes nothing; Turn into Pinned Tabs converts.
+IN_PROC_BROWSER_TEST_F(CommandBarActionsTest,
+                       ManyBookmarksAskBeforeTurningIntoPins) {
+  Profile* const profile = browser()->GetProfile();
+  bookmarks::BookmarkModel* const bookmarks =
+      BookmarkModelFactory::GetForBrowserContext(profile);
+  ASSERT_TRUE(bookmarks);
+  bookmarks::test::WaitForBookmarkModelToLoad(bookmarks);
+  constexpr size_t kMany = stedding::kBookmarksToPinsWithoutAsking + 1;
+  // In a folder of the bar, so that the count is of tabs, not of folders.
+  const bookmarks::BookmarkNode* const folder = bookmarks->AddFolder(
+      bookmarks->bookmark_bar_node(), 0, u"Reading");
+  for (size_t i = 0; i < kMany; ++i) {
+    bookmarks->AddURL(folder, i, base::NumberToString16(i),
+                      GURL(base::StrCat({"https://example.com/",
+                                         base::NumberToString(i)})));
+  }
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  const int tabs_before = strip->count();
+
+  const auto ask = [&]() -> views::Widget* {
+    views::NamedWidgetShownWaiter shown(views::test::AnyWidgetTestPasskey{},
+                                        "SteddingBookmarksToPinsDialog");
+    Run(browser(), u"Turn Bookmarks into Pinned Tabs");
+    return shown.WaitIfNeededAndGet();
+  };
+  views::Widget* dialog = ask();
+  ASSERT_TRUE(dialog);
+  EXPECT_EQ(ui::mojom::ModalType::kWindow,
+            dialog->widget_delegate()->GetModalType());
+  EXPECT_EQ(base::StrCat({u"Turn ", base::NumberToString16(kMany),
+                          u" bookmarks into pinned tabs?"}),
+            dialog->widget_delegate()->GetWindowTitle());
+  EXPECT_EQ(tabs_before, strip->count()) << "converted before the answer";
+  {
+    views::test::WidgetDestroyedWaiter closed(dialog);
+    dialog->widget_delegate()->AsDialogDelegate()->CancelDialog();
+    closed.Wait();
+  }
+  EXPECT_EQ(tabs_before, strip->count()) << "Cancel converted";
+  EXPECT_FALSE(
+      profile->GetPrefs()->GetBoolean(stedding::prefs::kBookmarksConverted));
+
+  dialog = ask();
+  ASSERT_TRUE(dialog);
+  {
+    views::test::WidgetDestroyedWaiter closed(dialog);
+    dialog->widget_delegate()->AsDialogDelegate()->AcceptDialog();
+    closed.Wait();
+  }
+  EXPECT_EQ(tabs_before + static_cast<int>(kMany), strip->count());
+  EXPECT_TRUE(
+      profile->GetPrefs()->GetBoolean(stedding::prefs::kBookmarksConverted));
+
+  // A second run adds nothing, so it does not ask.
+  Run(browser(), u"Turn Bookmarks into Pinned Tabs");
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(tabs_before + static_cast<int>(kMany), strip->count());
+  for (views::Widget* const widget : views::test::WidgetTest::GetAllWidgets()) {
+    EXPECT_NE("SteddingBookmarksToPinsDialog", widget->GetName())
+        << "asked about bookmarks already pins";
+  }
+}
