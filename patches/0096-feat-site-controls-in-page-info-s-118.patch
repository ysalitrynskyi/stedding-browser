+
+// The view under `root` that carries `id`, or null.
+views::View* FindView(views::View* root, ui::ElementIdentifier id) {
+  if (!root) {
+    return nullptr;
+  }
+  if (root->GetProperty(views::kElementIdentifierKey) == id) {
+    return root;
+  }
+  for (views::View* child : root->children()) {
+    if (views::View* const found = FindView(child, id)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// Every text a label under `root` shows, run together.
+std::u16string TextUnder(views::View* root) {
+  std::u16string text;
+  if (auto* const label = views::AsViewClass<views::Label>(root)) {
+    text += std::u16string(label->GetText()) + u"\n";
+  }
+  if (auto* const styled = views::AsViewClass<views::StyledLabel>(root)) {
+    text += std::u16string(styled->GetText()) + u"\n";
+  }
+  for (views::View* child : root->children()) {
+    text += TextUnder(child);
+  }
+  return text;
+}
+
+// The permission row under `root` titled for `type`, or null.
+PermissionToggleRowView* PermissionRow(views::View* root,
+                                       ContentSettingsType type) {
+  if (!root) {
+    return nullptr;
+  }
+  if (auto* const row = views::AsViewClass<PermissionToggleRowView>(root)) {
+    if (row->GetRowTitleForTesting() ==
+        PageInfoUI::PermissionTypeToUIString(type)) {
+      return row;
+    }
+  }
+  for (views::View* child : root->children()) {
+    if (PermissionToggleRowView* const found = PermissionRow(child, type)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+class SiteControlsTest : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    // Picture in picture follows a video that plays without a gesture.
+    command_line->AppendSwitchASCII(
+        switches::kAutoplayPolicy,
+        switches::autoplay::kNoUserGestureRequiredPolicy);
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ui::TestClipboard::CreateForCurrentThread();
+  }
+
+  void TearDownOnMainThread() override {
+    ui::Clipboard::DestroyClipboardForCurrentThread();
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  BrowserView* browser_view(BrowserWindowInterface* window = nullptr) {
+    return BrowserView::GetBrowserViewForBrowser(window ? window : browser());
+  }
+  content::WebContents* page() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+  GURL Url(const std::string& host, const std::string& path = "/title2.html") {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  // The panel, once shown.
+  static views::BubbleDialogDelegateView* WaitForPanel() {
+    views::BubbleDialogDelegateView* panel = nullptr;
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      panel = PageInfoBubbleViewBase::GetPageInfoBubbleForTesting();
+      return panel && panel->GetWidget() && panel->GetWidget()->IsVisible();
+    })) << "no page info";
+    return panel;
+  }
+
+  // The site chip's click (toolbar T5).
+  views::BubbleDialogDelegateView* OpenFromTheChip(
+      BrowserWindowInterface* window = nullptr) {
+    EXPECT_TRUE(
+        browser_view(window)->GetLocationBarView()->ShowPageInfoDialog());
+    return WaitForPanel();
+  }
+
+  static bool PanelGoes() {
+    return base::test::RunUntil([]() {
+      return !PageInfoBubbleViewBase::GetPageInfoBubbleForTesting();
+    });
+  }
+
+  static void ClosePanel() {
+    if (views::BubbleDialogDelegateView* const panel =
+            PageInfoBubbleViewBase::GetPageInfoBubbleForTesting()) {
+      panel->GetWidget()->CloseNow();
+    }
+    ASSERT_TRUE(PanelGoes());
+  }
+
+  static SiteControlsStripView* Strip(views::View* panel) {
+    return views::AsViewClass<SiteControlsStripView>(
+        FindView(panel, SiteControlsStripView::kElementId));
+  }
+  static SiteControlsRowsView* Rows(views::View* panel) {
+    return views::AsViewClass<SiteControlsRowsView>(
+        FindView(panel, SiteControlsRowsView::kElementId));
+  }
+
+  static void Click(views::Button* button, int flags = ui::EF_NONE) {
+    ASSERT_TRUE(button);
+    views::test::ButtonTestApi(button).NotifyClick(
+        ui::MouseEvent(ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+                       base::TimeTicks(), ui::EF_LEFT_MOUSE_BUTTON | flags,
+                       ui::EF_LEFT_MOUSE_BUTTON));
+  }
+
+  static std::u16string ClipboardText() {
+    base::test::TestFuture<std::u16string> text;
+    ui::Clipboard::GetForCurrentThread()->ReadText(
+        ui::ClipboardBuffer::kCopyPaste, std::nullopt, text.GetCallback());
+    return text.Get();
+  }
+
+  // The window-modal question the next step asks, and the step.
+  static views::Widget* QuestionAfter(base::OnceClosure step) {
+    views::Widget* question = nullptr;
+    views::AnyWidgetObserver shown(views::test::AnyWidgetTestPasskey{});
+    shown.set_shown_callback(
+        base::BindLambdaForTesting([&question](views::Widget* widget) {
+          views::WidgetDelegate* const delegate = widget->widget_delegate();
+          if (delegate && delegate->AsDialogDelegate() &&
+              delegate->GetModalType() == ui::mojom::ModalType::kWindow) {
+            question = widget;
+          }
+        }));
+    std::move(step).Run();
+    EXPECT_TRUE(base::test::RunUntil([&]() { return question != nullptr; }))
+        << "nothing was asked";
+    return question;
+  }
+
+  std::string CookieHeader(content::WebContents* contents,
+                           const std::string& host) {
+    EXPECT_TRUE(
+        content::NavigateToURL(contents, Url(host, "/echoheader?Cookie")));
+    return content::EvalJs(contents, "document.body.innerText").ExtractString();
+  }
+
+  // An extension with a popup action, loaded.
+  scoped_refptr<const extensions::Extension> LoadAction(
+      const std::string& name) {
+    extensions::TestExtensionDir& dir = dirs_.emplace_back();
+    dir.WriteManifest(R"({"manifest_version": 3, "name": ")" + name +
+                      R"(", "version": "1", "action": {"default_title": ")" +
+                      name + R"(", "default_popup": "popup.html"}})");
+    dir.WriteFile(FILE_PATH_LITERAL("popup.html"), "<!doctype html>Popup");
+    extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+    return loader.LoadExtension(dir.UnpackedPath());
+  }
+
+  std::vector<extensions::TestExtensionDir> dirs_;
+};
