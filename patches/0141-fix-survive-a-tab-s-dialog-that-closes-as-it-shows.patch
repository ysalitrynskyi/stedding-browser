 // P20, P11, P12, P17: the link opens over the pinned tab's page, inside its
 // window -- no window of its own -- loaded as the page's link. The pinned
 // page stays where it was, dimmed by the window's scrim, and takes no
diff --git a/ui/views/widget/native_widget_mac.mm b/ui/views/widget/native_widget_mac.mm
index 02db68344e6dc..00cf666237ea6 100644
--- a/ui/views/widget/native_widget_mac.mm
+++ b/ui/views/widget/native_widget_mac.mm
@@ -797,7 +797,14 @@ void NativeWidgetMac::Show(ui::mojom::WindowShowState show_state,
                        ? window_state
                        : WindowVisibilityState::kShowInactive;
   }
+  // Stedding (docs/features/tabs.md R67, GitHub issue 82): AppKit runs observers
+  // as the window comes forward, and they may destroy the widget and this with
+  // it, as NativeWidgetAura::Show allows for.
+  const base::WeakPtr<internal::NativeWidgetPrivate> weak_this = GetWeakPtr();
   GetNSWindowHost()->SetVisibilityState(window_state);
+  if (!weak_this || !delegate_) {
+    return;
+  }
 
   // Ignore the SetInitialFocus() result. BridgedContentView should get
   // firstResponder status regardless.
diff --git a/ui/views/widget/native_widget_mac_unittest.mm b/ui/views/widget/native_widget_mac_unittest.mm
index a7cf16e54b9d1..2157be8eab2de 100644
--- a/ui/views/widget/native_widget_mac_unittest.mm
+++ b/ui/views/widget/native_widget_mac_unittest.mm
@@ -1181,6 +1181,32 @@ TEST_F(NativeWidgetMacTest, CloseWhileMinimized) {
   widget->CloseNow();
 }
 
+// Stedding (docs/features/tabs.md R67, GitHub issue 82): what AppKit runs as the
+// window comes forward may destroy the widget. Show() then ends there: it went
+// on to the widget's initial focus, through a WeakPtr that had gone, and a tab's
+// dialog killed the browser as its tab came back.
+TEST_F(NativeWidgetMacTest, ShowOutlivesTheWidget) {
+  auto widget = std::make_unique<Widget>();
+  Widget::InitParams params = CreateParams(
+      Widget::InitParams::CLIENT_OWNS_WIDGET, Widget::InitParams::TYPE_WINDOW);
+  params.bounds = gfx::Rect(100, 100, 300, 200);
+  widget->Init(std::move(params));
+  Widget* const shown = widget.get();
+  NSWindow* const window = shown->GetNativeWindow().GetNativeNSWindow();
+
+  std::unique_ptr<Widget>* const owner = &widget;
+  id observer = [NSNotificationCenter.defaultCenter
+      addObserverForName:NSWindowDidBecomeKeyNotification
+                  object:window
+                   queue:nil
+              usingBlock:^(NSNotification*) {
+                owner->reset();
+              }];
+  shown->Show();
+  [NSNotificationCenter.defaultCenter removeObserver:observer];
+  EXPECT_FALSE(widget) << "the window never became key";
+}
