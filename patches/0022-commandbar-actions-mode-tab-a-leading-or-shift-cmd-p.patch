+void CommandBarView::SetMode(Mode mode) {
+  if (mode == mode_ && (mode == Mode::kTabs || !actions_.empty())) {
+    return;
+  }
+  mode_ = mode;
+  selected_ = 0;
+  if (mode_ == Mode::kActions) {
+    BuildActions();
+  }
+  if (field_) {
+    field_->SetPlaceholderText(mode_ == Mode::kActions
+                                   ? u"Type a command\u2026"
+                                   : u"Search or Enter URL\u2026");
+  }
+  RebuildRows();
+}
+
+void CommandBarView::Prefill(std::u16string text) {
+  if (!field_) {
+    return;
+  }
+  field_->SetText(text);
+  field_->SelectAll(false);
+  UpdateResults(text);
+}
+
+std::u16string CommandBarView::ChordFor(int command_id) const {
+  ui::AcceleratorProvider* provider = accelerator_provider_for_testing_;
+  if (!provider) {
+    provider = BrowserView::GetBrowserViewForBrowser(browser_);
+  }
+  ui::Accelerator accelerator;
+  return provider &&
+                 provider->GetAcceleratorForCommandId(command_id, &accelerator)
+             ? accelerator.GetShortcutText()
+             : std::u16string();
+}
