+using State = stedding::AppUpdater::State;
+
+class UpdatesTest : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  // Before the first window, so its sidebar has the pill.
+  void SetUpInProcessBrowserTestFixture() override {
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::SetUpInProcessBrowserTestFixture();
+    updater_ = std::make_unique<stedding::FakeAppUpdater>();
+  }
+
+  // After the windows, which watch it.
+  void TearDownInProcessBrowserTestFixture() override {
+    updater_.reset();
+    stedding::SetSteddingVersionForTesting(std::nullopt);
+    stedding::IgnoreNoFirstRunForTesting(false);
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::TearDownInProcessBrowserTestFixture();
+  }
+
+  BrowserView* browser_view(BrowserWindowInterface* window = nullptr) {
+    return BrowserView::GetBrowserViewForBrowser(window ? window : browser());
+  }
+
+  stedding::UpdatePill* Pill() {
+    return stedding::test::FindView<stedding::UpdatePill>(
+        browser_view()->vertical_tab_strip_region_view_for_testing());
+  }
+
+  stedding::CommandBarView* Palette() {
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_COMMAND_PALETTE);
+    return stedding::CommandBarView::GetOpenBar(browser_view());
+  }
+
+  std::vector<std::u16string> Titles(stedding::CommandBarView* bar,
+                                     const std::u16string& text) {
+    bar->field_for_testing()->SetText(text);
+    bar->ContentsChanged(bar->field_for_testing(), text);
+    std::vector<std::u16string> titles;
+    for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+      titles.push_back(bar->row_title_for_testing(i));
+    }
+    return titles;
+  }
+
+  // Lists the rows `text` finds, then runs the one titled `title`.
+  void Run(const std::u16string& text, const std::u16string& title) {
+    stedding::CommandBarView* const bar = Palette();
+    ASSERT_TRUE(bar);
+    const std::vector<std::u16string> titles = Titles(bar, text);
+    const auto it = std::ranges::find(titles, title);
+    ASSERT_NE(titles.end(), it) << "no row " << title;
+    // A key as the bar's field receives it.
+    views::View* const field = bar->field_for_testing();
+    for (auto row = titles.begin(); row != it; ++row) {
+      field->OnKeyPressed(ui::KeyEvent(ui::EventType::kKeyPressed,
+                                       ui::VKEY_DOWN, ui::EF_NONE));
+    }
+    field->OnKeyPressed(ui::KeyEvent(ui::EventType::kKeyPressed,
+                                     ui::VKEY_RETURN, ui::EF_NONE));
+    base::RunLoop().RunUntilIdle();
+    if (stedding::CommandBarView* const open =
+            stedding::CommandBarView::GetOpenBar(browser_view())) {
+      open->Close();
+      base::RunLoop().RunUntilIdle();
+    }
+  }
+
+  // The visible URL of the window's active tab.
+  GURL ActiveUrl(BrowserWindowInterface* window) {
+    return window->GetTabStripModel()->GetActiveWebContents()->GetVisibleURL();
+  }
+
+  PrefService* local_state() { return g_browser_process->local_state(); }
+
+  std::unique_ptr<stedding::FakeAppUpdater> updater_;
+};
+
+// updates Up3: the pill sits at the sidebar's foot above the Space row, shows
+// only while a version waits, restarts on a click, and keeps to the rail.
+IN_PROC_BROWSER_TEST_F(UpdatesTest, ThePillShowsAboveTheSpacesAndRestarts) {
+  stedding::UpdatePill* const pill = Pill();
+  ASSERT_TRUE(pill) << "the sidebar has no pill";
+  views::Widget* const widget = browser_view()->GetWidget();
+  views::test::RunScheduledLayout(widget);
+  EXPECT_FALSE(pill->GetVisible()) << "nothing waits yet";
+
+  updater_->Set(State::kReady, u"0.2.0-beta.99");
+  views::test::RunScheduledLayout(widget);
+  ASSERT_TRUE(pill->GetVisible());
+  EXPECT_EQ(u"New Stedding Version Available", pill->GetText());
+  const gfx::Rect pill_bounds = pill->GetBoundsInScreen();
+  EXPECT_GT(pill_bounds.width(), 100) << pill_bounds.ToString();
+  EXPECT_GT(pill_bounds.height(), 20) << pill_bounds.ToString();
+  if (spaces::SpaceSwitcherView* const switcher =
+          stedding::test::FindDrawnSwitcher(widget->GetRootView())) {
+    EXPECT_LE(pill_bounds.bottom(), switcher->GetBoundsInScreen().y())
+        << "above the Space row";
+  }
+  // On the rows' column: the first live check drew it from edge to edge of
+  // the sidebar.
+  if (TabView* const row = stedding::test::FindDrawnRow(
+          widget->GetRootView(),
+          browser()->GetTabStripModel()->GetActiveTab())) {
+    const gfx::Rect row_bounds = row->GetBoundsInScreen();
+    EXPECT_NEAR(row_bounds.x(), pill_bounds.x(), 2)
+        << row_bounds.ToString() << " " << pill_bounds.ToString();
+    EXPECT_NEAR(row_bounds.right(), pill_bounds.right(), 2)
+        << row_bounds.ToString() << " " << pill_bounds.ToString();
+  }
+  stedding::test::ClickLeftMouse(widget, pill_bounds.CenterPoint());
+  EXPECT_EQ(1, updater_->installs);
+
+  // The rail: the icon alone, inside the rail's width.
+  tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+      true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }));
+  views::test::RunScheduledLayout(widget);
+  EXPECT_TRUE(pill->GetVisible());
+  EXPECT_TRUE(pill->GetText().empty());
+  EXPECT_LE(pill->width(),
+            browser_view()->vertical_tab_strip_region_view_for_testing()
+                ->width());
+  tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+      false);
+
+  updater_->Set(State::kUpToDate);
+  EXPECT_FALSE(pill->GetVisible());
+}
+
+// updates Up7: the command bar offers the restart while a version waits, and
+// Check for Updates always, which asks and opens the About page.
+IN_PROC_BROWSER_TEST_F(UpdatesTest, TheCommandBarRestartsAndChecks) {
+  {
+    stedding::CommandBarView* const bar = Palette();
+    ASSERT_TRUE(bar);
+    const std::vector<std::u16string> titles = Titles(bar, u"Update");
+    EXPECT_FALSE(std::ranges::contains(
+        titles, std::u16string(u"Restart to Update Stedding")))
+        << "nothing waits";
+    EXPECT_TRUE(
+        std::ranges::contains(titles, std::u16string(u"Check for Updates")));
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+  }
+  updater_->Set(State::kReady, u"0.2.0-beta.99");
+  ASSERT_NO_FATAL_FAILURE(Run(u"Update", u"Restart to Update Stedding"));
+  EXPECT_EQ(1, updater_->installs);
+
+  updater_->Set(State::kIdle);
+  const int checks = updater_->checks;
+  ASSERT_NO_FATAL_FAILURE(Run(u"Update", u"Check for Updates"));
+  EXPECT_EQ(checks + 1, updater_->checks);
+  EXPECT_EQ(GURL("chrome://settings/help"), ActiveUrl(browser()));
+}
+
+// updates Up5: the About page's Relaunch restarts through the updater while a
+// version waits. Chromium's own relaunch would end this test.
+IN_PROC_BROWSER_TEST_F(UpdatesTest, AboutsRelaunchRestartsThroughTheUpdater) {
+  updater_->Set(State::kReady, u"0.2.0-beta.99");
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://settings/help")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(content::ExecJs(page, "chrome.send('relaunch', [])"));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return updater_->installs == 1; }));
+}
+
+#if BUILDFLAG(IS_MAC)
+// The About page's update line, found through the settings page's shadow
+// roots: its text while shown, or "(hidden)".
+constexpr char kAboutUpdateLine[] = R"(
+    (() => {
+      const find = (root) => {
+        const hit = root.querySelector('#updateStatusMessage');
+        if (hit) return hit;
+        for (const el of root.querySelectorAll('*')) {
+          if (el.shadowRoot) {
+            const deep = find(el.shadowRoot);
+            if (deep) return deep;
+          }
+        }
+        return null;
+      };
+      const line = find(document);
+      if (!line) return '(none)';
+      return line.hidden ? '(hidden)' : line.innerText.trim();
+    })())";
+
+// updates Up5, Up6: opening the About page checks while automatic updates
+// are on; off, it does not, and says how to check.
+IN_PROC_BROWSER_TEST_F(UpdatesTest, AboutChecksOnlyWithAutomaticUpdatesOn) {
+  local_state()->SetBoolean(stedding::prefs::kUpdatesAutomatic, true);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://settings/help")));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return updater_->checks == 1; }));
+
+  local_state()->SetBoolean(stedding::prefs::kUpdatesAutomatic, false);
+  updater_->Set(State::kIdle);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), GURL("chrome://settings/help")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, kAboutUpdateLine).ExtractString() !=
+           "(none)";
+  }));
+  EXPECT_EQ(1, updater_->checks) << "no check with automatic updates off";
+  EXPECT_EQ(
+      "Automatic updates are off. To look for a new version now, choose "
+      "Stedding › Check for Updates…",
+      content::EvalJs(page, kAboutUpdateLine).ExtractString());
+
+  updater_->Set(State::kUpToDate);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, kAboutUpdateLine).ExtractString() ==
+           "Stedding is up to date";
+  }));
+}
+#endif  // BUILDFLAG(IS_MAC)
+
+// updates Up10: the first window of a later version opens the update's
+// thank-you page, naming the version in its fragment, once per run.
+IN_PROC_BROWSER_TEST_F(UpdatesTest, ALaterVersionOpensTheThanksPageOnce) {
+  stedding::SetSteddingVersionForTesting("0.2.0-beta.99");
+  stedding::IgnoreNoFirstRunForTesting(true);
+  stedding::ResetThanksAfterUpdateForTesting();
+  local_state()->SetString(stedding::prefs::kLastRunVersion, "0.2.0-beta.98");
+
+  BrowserWindowInterface* const window = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return ActiveUrl(window) ==
+           GURL("https://stedding.dev/thanks/updated/#v0.2.0-beta.99");
+  }));
+  EXPECT_EQ("0.2.0-beta.99",
+            local_state()->GetString(stedding::prefs::kLastRunVersion));
+
+  // Once per run: the next window opens without it.
+  BrowserWindowInterface* const next = CreateBrowser(browser()->GetProfile());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, next->GetTabStripModel()->count());
+  EXPECT_NE(GURL("https://stedding.dev/thanks/updated/#v0.2.0-beta.99"),
+            ActiveUrl(next));
+}
+
+// updates Up10: with the setting off, a later version opens nothing.
+IN_PROC_BROWSER_TEST_F(UpdatesTest, TheSettingKeepsTheThanksPageClosed) {
+  stedding::SetSteddingVersionForTesting("0.2.0-beta.99");
+  stedding::IgnoreNoFirstRunForTesting(true);
+  stedding::ResetThanksAfterUpdateForTesting();
+  local_state()->SetString(stedding::prefs::kLastRunVersion, "0.2.0-beta.98");
+  local_state()->SetBoolean(stedding::prefs::kThanksAfterUpdate, false);
+
+  BrowserWindowInterface* const window = CreateBrowser(browser()->GetProfile());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, window->GetTabStripModel()->count());
+  EXPECT_EQ("0.2.0-beta.99",
+            local_state()->GetString(stedding::prefs::kLastRunVersion));
+}
+
+// updates Up9: the welcome flow's end, finished or skipped, opens the
+// install's thank-you page once.
+IN_PROC_BROWSER_TEST_F(UpdatesTest, TheWelcomeFlowsEndOpensTheInstallsPage) {
+  stedding::SetSteddingVersionForTesting("0.2.0-beta.99");
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(stedding::prefs::kWelcomeShown, false);
+  stedding::ShowWelcomeDialog(*browser());
+  base::RunLoop().RunUntilIdle();
+  const int tabs = browser()->GetTabStripModel()->count();
+  // What the flow's Finish and Skip do (stedding_welcome_handler.cc).
+  prefs->SetBoolean(stedding::prefs::kWelcomeShown, true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return ActiveUrl(browser()) == GURL("https://stedding.dev/thanks/");
+  }));
+  EXPECT_EQ(tabs + 1, browser()->GetTabStripModel()->count());
+  EXPECT_TRUE(
+      local_state()->GetBoolean(stedding::prefs::kThanksAfterInstallShown));
+
+  // A second profile's flow, or the same one again, opens no second page.
+  prefs->SetBoolean(stedding::prefs::kWelcomeShown, false);
+  stedding::ShowWelcomeDialog(*browser());
+  base::RunLoop().RunUntilIdle();
+  prefs->SetBoolean(stedding::prefs::kWelcomeShown, true);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(tabs + 1, browser()->GetTabStripModel()->count());
+}
