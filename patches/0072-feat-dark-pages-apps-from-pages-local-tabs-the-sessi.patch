+// a browser page, has no such row.
+TEST_F(RenderViewContextMenuPrefsTest, SteddingShortMenusKeepDarkenThisSite) {
+  ASSERT_TRUE(profile()->GetPrefs()->GetBoolean(stedding::prefs::kMenusShort));
+  NavigateAndCommit(GURL("https://www.example.com/a"));
