+// Lf1: the sidebar's own menu has New Live Folder > GitHub Pull Requests…,
+// which opens Settings on the live folder's block, off, asking for the token.
+IN_PROC_BROWSER_TEST_F(LiveFoldersTest, TheSidebarsMenuOpensTheBlock) {
+  ui::MenuModel* const menu = BrowserView::GetBrowserViewForBrowser(browser())
+                                  ->browser_widget()
+                                  ->GetSystemMenuModel();
+  std::optional<size_t> row;
+  for (size_t i = 0; i < menu->GetItemCount(); ++i) {
+    if (menu->GetCommandIdAt(i) == IDC_STEDDING_NEW_LIVE_FOLDER) {
+      row = i;
+    }
+  }
+  ASSERT_TRUE(row) << "the sidebar's menu has no New Live Folder";
+  EXPECT_EQ(u"New Live Folder", menu->GetLabelAt(*row));
+  EXPECT_TRUE(menu->IsEnabledAt(*row));
+  ui::MenuModel* const sub = menu->GetSubmenuModelAt(*row);
+  ASSERT_TRUE(sub);
+  ASSERT_EQ(1u, sub->GetItemCount());
+  EXPECT_EQ(IDC_STEDDING_NEW_LIVE_FOLDER_GITHUB, sub->GetCommandIdAt(0));
+  EXPECT_EQ(u"GitHub Pull Requests…", sub->GetLabelAt(0));
+  ASSERT_TRUE(sub->IsEnabledAt(0));
+  sub->ActivatedAt(0);
+
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    content::WebContents* const page =
+        browser()->GetTabStripModel()->GetActiveWebContents();
+    return page && page->GetLastCommittedURL().host() == "settings" &&
+           page->GetLastCommittedURL().path() == "/stedding";
+  }));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  // The block, found through every shadow root, offers the token's field.
+  constexpr char kFind[] = R"(
+    (() => {
+      const find = root => {
+        const hit = root.querySelector('#liveFolderMake');
+        if (hit) {
+          return hit;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot);
+            if (found) {
+              return found;
+            }
+          }
+        }
+        return null;
+      };
+      const make = find(document);
+      return make ? make.textContent.trim() : '';
+    })()
+  )";
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return content::EvalJs(page, kFind).ExtractString() == "Make Live Folder";
+  })) << "the live folder's block is not on the page";
+  EXPECT_TRUE(seen_.empty()) << "opening the block asked GitHub";
+}
