+RecentTabsSwitcherView* GetOpen(BrowserView* browser_view) {
+  for (views::View* child : browser_view->children()) {
+    if (auto* const strip = views::AsViewClass<RecentTabsSwitcherView>(child)) {
+      return strip;
+    }
+  }
+  return nullptr;
+}
+
+bool IsControl(const ui::KeyEvent& event) {
+  return event.key_code() == ui::VKEY_CONTROL ||
+         event.key_code() == ui::VKEY_LCONTROL ||
+         event.key_code() == ui::VKEY_RCONTROL;
+}
