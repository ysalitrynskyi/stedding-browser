+namespace stedding {
+namespace {
+
+constexpr int kBarWidth = 720;
+constexpr int kListHeight = 320;
+constexpr int kRowHeight = 44;
+constexpr int kFieldHeight = 52;
+constexpr int kPanelRadius = 16;
+constexpr int kRowRadius = 10;
+constexpr int kPanelInset = 12;
+constexpr int kFontSizeDelta = 3;
+constexpr size_t kMaxResults = 8;
+
+// The overlay is its own surface floating over the page, so it takes the
+// dialog colours of the current theme (light panel in light mode, dark in
+// dark), never the toolbar's. The chosen row is a quiet tint of the text
+// colour, the way a menu highlights, rather than a block of accent colour.
+constexpr SkAlpha kSelectedRowAlpha = 0x1F;
+
+bool Matches(const std::u16string& haystack, const std::u16string& needle) {
+  if (needle.empty()) {
+    return true;
+  }
+  return base::ToLowerASCII(haystack).find(base::ToLowerASCII(needle)) !=
+         std::u16string::npos;
+}
+
+}  // namespace
+
+// A result row: a LabelButton whose label is reachable, so the bar can set
+// its type. LabelButton keeps label() protected.
+class CommandBarView::ResultRow : public views::LabelButton {
+  METADATA_HEADER(ResultRow, views::LabelButton)
+
+ public:
+  using views::LabelButton::LabelButton;
+  views::Label* row_label() { return label(); }
+};
+
+BEGIN_METADATA(CommandBarView, ResultRow)
+END_METADATA
+
+// static
+void CommandBarView::Show(Browser* browser) {
+  BrowserView* const browser_view = BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view) {
+    return;
+  }
+  if (CommandBarView* const open = GetOpenBar(browser_view)) {
+    open->field_->RequestFocus();
+    return;
+  }
+  // Last child of the browser view: on top of everything, including the web
+  // contents, once it paints to its own layer.
+  CommandBarView* const bar =
+      browser_view->AddChildView(std::make_unique<CommandBarView>(browser));
+  bar->SetPaintToLayer();
+  bar->layer()->SetFillsBoundsOpaquely(false);
+  bar->layer()->SetName("SteddingCommandBar");
+  bar->parent_observation_.Observe(browser_view);
+  bar->UpdateBounds();
+  bar->field_->RequestFocus();
+  bar->watching_focus_ = true;
+}
+
+// static
+CommandBarView* CommandBarView::GetOpenBar(BrowserView* browser_view) {
+  for (views::View* child : browser_view->children()) {
+    if (auto* const bar = views::AsViewClass<CommandBarView>(child)) {
+      return bar;
+    }
+  }
+  return nullptr;
+}
+
+CommandBarView::CommandBarView(Browser* browser) : browser_(browser) {
+  SetBackground(views::CreateRoundedRectBackground(ui::kColorDialogBackground,
+                                                   kPanelRadius));
+  SetBorder(views::CreateEmptyBorder(gfx::Insets(kPanelInset)));
+  AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
+  BuildContents();
+}
+
+CommandBarView::~CommandBarView() = default;
+
+void CommandBarView::BuildContents() {
+  SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+
+  auto field = std::make_unique<views::Textfield>();
+  field->set_controller(this);
+  field->SetPlaceholderText(u"Search or Enter URL...");
+  field->SetPreferredSize(gfx::Size(kBarWidth, kFieldHeight));
+  field->SetBackgroundColor(ui::kColorTextfieldBackground);
+  field->SetFontList(field->GetFontList().DeriveWithSizeDelta(kFontSizeDelta));
+  field->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 12)));
+  field_ = AddChildView(std::move(field));
+
+  auto list = std::make_unique<views::ScrollView>();
+  list->SetContents(std::make_unique<views::View>());
+  list->ClipHeightTo(0, kListHeight);
+  list_ = AddChildView(std::move(list));
+
+  UpdateResults(std::u16string());
+}
+
+void CommandBarView::UpdateBounds() {
+  views::View* const window = parent();
+  if (!window) {
+    return;
+  }
+  BrowserView* const browser_view = BrowserView::GetBrowserViewForBrowser(browser_);
+  gfx::RectF contents_f(browser_view->contents_container()->GetLocalBounds());
+  views::View::ConvertRectToTarget(browser_view->contents_container(), window,
+                                   &contents_f);
+  const gfx::Rect contents = gfx::ToEnclosingRect(contents_f);
+  const gfx::Size size = GetPreferredSize();
+  SetBoundsRect(gfx::Rect(contents.x() + (contents.width() - size.width()) / 2,
+                          contents.y() + contents.height() / 4, size.width(),
+                          size.height()));
+}
+
+void CommandBarView::Close() {
+  if (closing_) {
+    return;
+  }
+  closing_ = true;
+  if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    focus_manager->RemoveFocusChangeListener(this);
+  }
+  watching_focus_ = false;
+  parent_observation_.Reset();
+  SetVisible(false);
+  // Deleting a view from inside its own event handling is not safe; a turn
+  // later it is.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<CommandBarView> bar) {
+                       if (bar && bar->parent()) {
+                         std::unique_ptr<views::View> owned =
+                             bar->parent()->RemoveChildViewT(bar.get());
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void CommandBarView::AddedToWidget() {
+  views::View::AddedToWidget();
+  if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    focus_manager->AddFocusChangeListener(this);
+  }
+}
+
+void CommandBarView::RemovedFromWidget() {
+  if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    focus_manager->RemoveFocusChangeListener(this);
+  }
+  views::View::RemovedFromWidget();
+}
+
+bool CommandBarView::AcceleratorPressed(const ui::Accelerator& accelerator) {
+  if (accelerator.key_code() == ui::VKEY_ESCAPE) {
+    Close();
+    return true;
+  }
+  return false;
+}
+
+void CommandBarView::OnDidChangeFocus(views::View* focused_before,
+                                      views::View* focused_now) {
+  // Focus moving anywhere outside the bar -- a click on the page, a tab
+  // activation, another control -- dismisses it, the way a menu dismisses.
+  if (watching_focus_ && !closing_ && (!focused_now || !Contains(focused_now))) {
+    Close();
+  }
+}
+
+void CommandBarView::OnViewBoundsChanged(views::View* observed_view) {
+  UpdateBounds();
+}
+
+void CommandBarView::UpdateResults(const std::u16string& query) {
+  results_.clear();
+
+  TabStripModel* const tabs = browser_->tab_strip_model();
+  spaces::SpaceModel* const spaces = spaces::SpaceModel::From(browser_);
+
+  for (int i = 0; i < tabs->count() && results_.size() < kMaxResults; ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    const std::u16string title(tab->GetTitle());
+    if (!Matches(title, query)) {
+      continue;
+    }
+    // Name the Space only when it is not the one the user is looking at, so
+    // the common case stays uncluttered.
+    std::u16string space_name;
+    if (spaces && !spaces->IsTabInActiveSpace(tab)) {
+      space_name = spaces->DisplayName(spaces->SpaceForTab(tab));
+    }
+    results_.push_back({i, title, space_name});
+  }
+
+  views::View* const contents = list_->contents();
+  contents->RemoveAllChildViews();
+  contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+
+  // What Enter does with the typed text is always shown as a row, so the bar
+  // never looks empty while the user types a URL or a search.
+  if (!query.empty()) {
+    const GURL url =
+        url_formatter::FixupURL(base::UTF16ToUTF8(query), std::string());
+    const bool is_url = url.is_valid() && url.has_host() &&
+                        query.find(u' ') == std::u16string::npos;
+    auto open_row = std::make_unique<ResultRow>(
+        base::BindRepeating(&CommandBarView::OpenTypedText,
+                            base::Unretained(this)),
+        query + (is_url ? u"   —   Open" : u"   —   Search"));
+    StyleRow(open_row.get(), results_.empty());
+    contents->AddChildView(std::move(open_row));
+  }
+
+  for (const Result& result : results_) {
+    const std::u16string trailing =
+        result.space.empty() ? u"Switch to Tab" : result.space;
+    auto row = std::make_unique<ResultRow>(
+        base::BindRepeating(&CommandBarView::GoTo, base::Unretained(this),
+                            result),
+        result.title + u"   —   " + trailing);
+    // The first tab result is what Enter takes, so it is the one shown as
+    // chosen; the open row above it is what Enter takes only when no tab
+    // matches.
+    StyleRow(row.get(), &result == &results_.front());
+    contents->AddChildView(std::move(row));
+  }
+  contents->InvalidateLayout();
+}
+
+void CommandBarView::StyleRow(ResultRow* row, bool chosen) {
+  row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  row->SetPreferredSize(gfx::Size(kBarWidth, kRowHeight));
+  row->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 14)));
+  row->row_label()->SetFontList(
+      row->row_label()->font_list().DeriveWithSizeDelta(kFontSizeDelta));
+  row->SetEnabledTextColors(ui::kColorLabelForeground);
+  if (chosen) {
+    // Resolved here rather than by id: the tint is the text colour at a low
+    // alpha, and a colour id cannot carry an alpha. Before the bar is in a
+    // widget there is no provider; white is the dark-mode answer and the
+    // rows are rebuilt on the first theme pass anyway.
+    const ui::ColorProvider* const provider = GetColorProvider();
+    const SkColor text = provider
+                             ? provider->GetColor(ui::kColorLabelForeground)
+                             : SK_ColorWHITE;
+    row->SetBackground(views::CreateRoundedRectBackground(
+        SkColorSetA(text, kSelectedRowAlpha), kRowRadius));
+  }
+}
+
+void CommandBarView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  if (field_) {
+    UpdateResults(std::u16string(field_->GetText()));
+  }
+}
+
+void CommandBarView::GoTo(const Result& result) {
+  if (result.tab_index >= 0) {
+    // Switching to a tab in another Space has to make that Space active first,
+    // or the tab would be activated while still hidden.
+    if (spaces::SpaceModel* const spaces =
+            spaces::SpaceModel::From(browser_)) {
+      tabs::TabInterface* const tab =
+          browser_->tab_strip_model()->GetTabAtIndex(result.tab_index);
+      spaces->SetActiveSpace(spaces->SpaceForTab(tab));
+    }
+    browser_->tab_strip_model()->ActivateTabAt(result.tab_index);
+  }
+  Close();
+}
+
+void CommandBarView::OpenTypedText() {
+  const std::u16string text(field_->GetText());
+  if (text.empty()) {
+    return;
+  }
+
+  GURL url = url_formatter::FixupURL(base::UTF16ToUTF8(text), std::string());
+  if (!url.is_valid() || !url.has_host()) {
+    // Not a URL, so search for it with whatever the profile's search engine is.
+    TemplateURLService* const service =
+        TemplateURLServiceFactory::GetForProfile(browser_->GetProfile());
+    const TemplateURL* const provider =
+        service ? service->GetDefaultSearchProvider() : nullptr;
+    if (!provider) {
+      return;
+    }
+    url = GURL(provider->url_ref().ReplaceSearchTerms(
+        TemplateURLRef::SearchTermsArgs(text), service->search_terms_data()));
+  }
+  if (!url.is_valid()) {
+    return;
+  }
+
+  NavigateParams params(browser_, url, ui::PAGE_TRANSITION_TYPED);
+  params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&params);
+  Close();
+}
+
+void CommandBarView::ContentsChanged(views::Textfield* sender,
+                                     const std::u16string& new_contents) {
+  UpdateResults(new_contents);
+}
+
+bool CommandBarView::HandleKeyEvent(views::Textfield* sender,
+                                    const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    // Enter takes the first result if there is one, and otherwise opens what
+    // was typed -- which is what makes an empty query still useful.
+    if (!results_.empty() && !field_->GetText().empty()) {
+      GoTo(results_.front());
+    } else {
+      OpenTypedText();
+    }
+    return true;
+  }
+  return false;
+}
+
+BEGIN_METADATA(CommandBarView)
+END_METADATA
+
+}  // namespace stedding
