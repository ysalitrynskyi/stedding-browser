@@ -1223,6 +1247,42 @@ void SpaceModel::OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) {
     essential_homes_.erase(tab->GetHandle());
   }
   SaveTabToSession(tab, SpaceForTab(tab));
+  MaybeRebindTabJar(tab);
+}
+
+void SpaceModel::MaybeRebindTabJar(tabs::TabInterface* tab) {
+  if (!tab || !tab_strip_model_) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<SpaceModel> model,
+                        tabs::TabHandle handle) {
+                       if (!model || !model->tab_strip_model_) {
+                         return;
+                       }
+                       tabs::TabInterface* const tab = handle.Get();
+                       if (!tab) {
+                         return;
+                       }
+                       RebindTabToSpaceJar(model->tab_strip_model_, tab,
+                                           model->registry_,
+                                           model->SpaceForTab(tab));
+                     },
+                     weak_factory_.GetWeakPtr(), handle));
+}
+
+void SpaceModel::RebindTabsInSpace(const SpaceId& id) {
+  if (!tab_strip_model_) {
+    return;
+  }
+  for (int i = 0; i < tab_strip_model_->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(i);
+    if (SpaceForTab(tab) == id) {
+      MaybeRebindTabJar(tab);
+    }
+  }
 }
 
