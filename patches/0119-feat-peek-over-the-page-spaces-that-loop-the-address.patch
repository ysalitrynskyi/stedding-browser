+class PeekOverlay;
+
+// P20: what a peek over the page draws, across its tab's page: the card,
+// with its bar and the page under it, and around it the pinned page, dimmed
+// by the window's own scrim, where a click closes the peek.
+class PeekOverlayView : public views::View {
+  METADATA_HEADER(PeekOverlayView, views::View)
+
+ public:
+  // The card's bar and its rounded corners, in DIP.
+  static constexpr int kBarHeight = 36;
+  static constexpr int kCardRadius = 12;
+
+  PeekOverlayView(PeekOverlay* overlay, content::WebContents* page);
+  PeekOverlayView(const PeekOverlayView&) = delete;
+  PeekOverlayView& operator=(const PeekOverlayView&) = delete;
+  ~PeekOverlayView() override;
+
+  // P12: the card inside `bounds`, the tab's page: most of it, with a
+  // margin of the page around it for the click that closes the peek.
+  static gfx::Rect CardBoundsIn(const gfx::Rect& bounds);
+
+  views::View* card() { return card_; }
+  views::WebView* web_view() { return web_view_; }
+  views::Label* site() { return site_; }
+  views::ImageButton* split_button() { return split_; }
+  views::ImageButton* open_as_tab_button() { return open_as_tab_; }
+  views::ImageButton* close_button() { return close_; }
+
+  // Shows the page's site on the bar, its title in the tooltip.
+  void UpdateSite();
+  // Shows Open in Split View when the pinned tab can take a split.
+  void UpdateSplit(bool can_split);
+
+  // views::View:
+  void Layout(PassKey) override;
+  void OnPaint(gfx::Canvas* canvas) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+
+ private:
+  const raw_ptr<PeekOverlay> overlay_;
+  const raw_ptr<content::WebContents> page_;
+  raw_ptr<views::View> card_ = nullptr;
+  raw_ptr<views::View> bar_ = nullptr;
+  raw_ptr<views::Label> site_ = nullptr;
+  raw_ptr<views::ImageButton> split_ = nullptr;
+  raw_ptr<views::ImageButton> open_as_tab_ = nullptr;
+  raw_ptr<views::ImageButton> close_ = nullptr;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  PrefChangeRegistrar edge_pref_;
+};
+
+// docs/features/peek.md P20 (GitHub issue 62): makes the peek over the page
+// the one stedding::OpenPeek shows while "Show a peek" is "Over the page".
+// Safe to call more than once.
+void RegisterPeekOverPage();
+
+// P20: a peek over the page, as Arc's is. The page a link from a pinned tab
+// opened shows on a card over that tab's page, inside its window: the pinned
+// page, dimmed, takes no input until the peek closes, and the peek goes and
+// comes back with its tab (a tab-scoped dialog, tabs::TabDialogManager). The
+// card's bar has Open in Split View, Open as Tab and Close; Escape, Cmd-W and
+// a click beside the card close it, Cmd-O and Shift-Cmd-O keep the page.
+// Closing runs the page's "Leave site?". Kept, the page moves into the window
+// as it is (PromotePeekPage).
+class PeekOverlay : public content::WebContentsDelegate,
+                    public content::WebContentsObserver,
+                    public web_modal::WebContentsModalDialogManagerDelegate,
+                    public web_modal::WebContentsModalDialogHost {
+ public:
+  // The peek over `source`'s page, or null.
+  static PeekOverlay* ForSource(const tabs::TabInterface* source);
+  // The peek `page` is the page of, or null.
+  static PeekOverlay* ForPage(const content::WebContents* page);
+
+  PeekOverlay(const PeekOverlay&) = delete;
+  PeekOverlay& operator=(const PeekOverlay&) = delete;
+  ~PeekOverlay() override;
+
+  tabs::TabInterface* source() const { return source_.get(); }
+  content::WebContents* page() const { return page_.get(); }
+  views::Widget* widget() const { return widget_.get(); }
+  PeekOverlayView* view() const { return view_; }
+
+  // Closes the peek. A page that asks "Leave site?" closes once the user
+  // leaves, and stays if they stay.
+  void Close();
+  // P7, P9: the page into a tab of the window, or a split beside the pinned
+  // tab when it can take one. False when nothing moved.
+  bool Promote(bool split);
+
+  // Whether the pinned tab can take a split beside the page (P9).
+  bool CanSplit() const;
+
+  base::WeakPtr<PeekOverlay> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  // Both bases have a BeforeUnloadFired; the observer's is not used.
+  using content::WebContentsObserver::BeforeUnloadFired;
+
+  // content::WebContentsDelegate:
+  content::WebContents* OpenURLFromTab(
+      content::WebContents* source,
+      const content::OpenURLParams& params,
+      base::OnceCallback<void(content::NavigationHandle&)>
+          navigation_handle_callback) override;
+  content::WebContents* AddNewContents(
+      content::WebContents* source,
+      std::unique_ptr<content::WebContents> new_contents,
+      const GURL& target_url,
+      WindowOpenDisposition disposition,
+      const blink::mojom::WindowFeatures& window_features,
+      bool user_gesture,
+      bool* was_blocked) override;
+  void CloseContents(content::WebContents* source) override;
+  void BeforeUnloadFired(content::WebContents* source,
+                         bool proceed,
+                         bool* proceed_to_fire_unload) override;
+  void ActivateContents(content::WebContents* contents) override;
+  bool IsContentsActive(content::WebContents* contents) override;
+  void NavigationStateChanged(content::WebContents* source,
+                              content::InvalidateTypes changed_flags) override;
+  content::KeyboardEventProcessingResult PreHandleKeyboardEvent(
+      content::WebContents* source,
+      const input::NativeWebKeyboardEvent& event) override;
+  bool HandleKeyboardEvent(content::WebContents* source,
+                           const input::NativeWebKeyboardEvent& event) override;
+  content::JavaScriptDialogManager* GetJavaScriptDialogManager(
+      content::WebContents* source) override;
+  void RunFileChooser(content::RenderFrameHost* render_frame_host,
+                      scoped_refptr<content::FileSelectListener> listener,
+                      const blink::mojom::FileChooserParams& params) override;
+  void RequestMediaAccessPermission(
+      content::WebContents* web_contents,
+      const content::MediaStreamRequest& request,
+      content::MediaResponseCallback callback) override;
+  bool CheckMediaAccessPermission(content::RenderFrameHost* render_frame_host,
+                                  const url::Origin& security_origin,
+                                  blink::mojom::MediaStreamType type) override;
+  bool ShouldFocusLocationBarByDefault(content::WebContents* source) override;
+
+  // content::WebContentsObserver:
+  void TitleWasSet(content::NavigationEntry* entry) override;
+  void PrimaryPageChanged(content::Page& page) override;
+
+  // web_modal::WebContentsModalDialogManagerDelegate:
+  web_modal::WebContentsModalDialogHost* GetWebContentsModalDialogHost(
+      content::WebContents* web_contents) override;
+  bool IsWebContentsVisible(content::WebContents* web_contents) override;
+
+  // web_modal::WebContentsModalDialogHost:
+  gfx::NativeView GetHostView() const override;
+  gfx::Point GetDialogPosition(const gfx::Size& size) override;
+  gfx::Size GetMaximumDialogSize() override;
+  void AddObserver(web_modal::ModalDialogHostObserver* observer) override;
+  void RemoveObserver(web_modal::ModalDialogHostObserver* observer) override;
+
+ private:
+  friend class PeekOverPage;
+
+  PeekOverlay(tabs::TabInterface* source,
+              std::unique_ptr<content::WebContents> page);
+
+  // Shows the peek over its tab's page; false when it cannot (no window,
+  // or another dialog over the page).
+  bool Show();
+
+  // The bounds TabDialogManager gives the peek's widget: its tab's page, in
+  // screen coordinates.
+  gfx::Rect PageBoundsInScreen() const;
+
+  // The widget's synchronous close: the widget goes, then the peek.
+  void OnWidgetClosed(views::Widget::ClosedReason reason);
+
+  // Takes the widget down and lets the peek go; the page goes with it unless
+  // it was taken first.
+  void Destroy();
+
+  base::WeakPtr<tabs::TabInterface> source_;
+  std::unique_ptr<content::WebContents> page_;
+  std::unique_ptr<views::WidgetDelegate> widget_delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<PeekOverlayView> view_ = nullptr;
+  views::UnhandledKeyboardEventHandler unhandled_keyboard_event_handler_;
+  base::ObserverList<web_modal::ModalDialogHostObserver> modal_observers_;
+  bool destroying_ = false;
+  // Close asked the page "Leave site?" and waits for its answer.
+  bool closing_ = false;
+  base::WeakPtrFactory<PeekOverlay> weak_factory_{this};
+};
