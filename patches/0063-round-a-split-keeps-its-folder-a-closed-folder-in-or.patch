+// spaces B12: a row dropped on a chip that was rebuilt during the drag moves
+// to that chip's Space. A theme change rebuilds the chips, and a new chip had
+// no bounds until the next paint: the move after the rebuild found no chip
+// under the pointer, and the release dropped nothing (the drag test above
+// lost its drop one run in three that way, 2026-10-14).
+IN_PROC_BROWSER_TEST_F(TabDropTest, AChipRebuiltMidDragStillTakesTheDrop) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const spaces::SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+  tabs::TabInterface* const plain = Open("plain.test");
+  Open("stay.test");
+  const gfx::Point row = RowCentre(plain);
+  const gfx::Point chip = *ChipCentre(work);
+  spaces::SpaceSwitcherView* const switcher = FindDrawnSwitcher(root());
+  ASSERT_TRUE(switcher);
+
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed, row);
+  for (int step = 1; step <= 12; ++step) {
+    stedding::test::SendLeftMouse(
+        widget(), ui::EventType::kMouseDragged,
+        gfx::Point(row.x() + (chip.x() - row.x()) * step / 12,
+                   row.y() + (chip.y() - row.y()) * step / 12));
+  }
+  ASSERT_EQ(work, switcher->drop_target_for_testing());
+
+  // The row rebuilds under the pointer, as a theme change rebuilds it, and
+  // the next move comes before any paint lays it out.
+  m->SetSpaceName(work, "Work, renamed");
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseDragged, chip);
+  EXPECT_EQ(work, switcher->drop_target_for_testing())
+      << "the rebuilt chip went dark under the pointer";
+  stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased, chip);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return m->SpaceForTab(plain) == work;
+  })) << "the drop on the rebuilt chip was lost";
+}
