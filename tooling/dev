#!/usr/bin/env bash
# The one entry point for day-to-day work. docs/AGENT-LOOP.md is the procedure;
# this is the procedure as a command, so nobody retypes it.
#
# Usage:
#   tooling/dev build [config] [target ...]   build (refuses while another build runs)
#   tooling/dev test <feature|all> [--no-build|--list]
#                                             build the test binaries, run the feature's tests
#   tooling/dev test unit [--no-build|--list] every feature's unit_tests filter, and nothing
#                                             else: no components_unittests, no browser
#                                             tests (what `all` runs, less those two)
#   tooling/dev test browser [filter] [--no-build|--list]
#                                             build and run stedding_browser_tests
#                                             (real windows; `all` runs them too)
#   tooling/dev capture [capture-ui args...]  screenshot the built window
#   tooling/dev capture --assert <probes.json> capture as the spec says, check its probes
#   tooling/dev patch                         commits on stedding-work -> patches/, then check-repo
#   tooling/dev check                         check-repo + check-shell
#   tooling/dev status                        what the repo really contains (for docs)
#   tooling/dev features [components]         list the feature test filters
#
# Feature filters map a name in docs/features/ to a gtest filter. Add a line to
# FEATURE_FILTERS when a feature gains tests; tooling/status counts from the same
# table, so the docs and the test run cannot disagree about what "spaces" means.
# A test that lives under components/ compiles into components_unittests, not
# unit_tests: its line goes in COMPONENT_FILTERS. Stedding's browser tests
# (chrome/test/stedding) are all run, filter "*".
#
# Every run first lists what each part of its filter matches, and stops before
# running anything when a part matches no test: a renamed, deleted or disabled
# test cannot drop out of a sweep that still says SUCCESS. --list does only that
# and prints the tests; it builds nothing. tooling/check-repo fails a spec or
# BACKLOG row that cites a test no filter here runs (PLAN.md REPO-2).
#
# "upstream" is not a feature: it is Chromium's own suites around what the series
# touches (docs/HANDOFF.md, trap 31), so `tooling/dev test all` is the release sweep
# and `tooling/dev test upstream` the half of it nobody used to run.
#
# Under Git for Windows the same command runs the same filters against
# out/win-release/<binary>.exe. The build itself is `tooling\win\build.ps1`
# (`-Targets unit_tests,stedding_browser_tests`), so pass --no-build there.

# shellcheck source-path=SCRIPTDIR
# shellcheck source=./lib.sh
. "$(cd "$(dirname "$0")" && pwd)/lib.sh"

# Where the test binaries live: out/release on the Mac, out/win-release on Windows,
# where they end in .exe.
if is_windows; then
  TEST_OUT_DIR="$CHROMIUM_SRC/out/win-release"
  TEST_EXE_SUFFIX=".exe"
else
  TEST_OUT_DIR="$CHROMIUM_SRC/out/release"
  TEST_EXE_SUFFIX=""
fi
# The same sweeps against another output directory under out/ (a sanitizer build:
# STEDDING_TEST_OUT=win-asan tooling/dev test unit --no-build).
if [ -n "${STEDDING_TEST_OUT:-}" ]; then
  TEST_OUT_DIR="$CHROMIUM_SRC/out/$STEDDING_TEST_OUT"
fi
# A sanitizer output directory brings its own run-time setup, so the command stays the same one.
# win-checks: the dangling-pointer detector is compiled in and does nothing without the flag.
# win-asan: symbolised reports; ASan splits its option string at ':' as well as at a space, so
# the symbolizer's drive-letter path needs its quotes (docs/HANDOFF.md, trap 57).
TEST_EXTRA_FLAGS=""
case "${STEDDING_TEST_OUT:-}" in
  *checks*)
    TEST_EXTRA_FLAGS="--enable-features=PartitionAllocBackupRefPtr,PartitionAllocDanglingPtr" ;;
  *asan*)
    if [ -z "${ASAN_OPTIONS:-}" ]; then
      ASAN_SRC="$CHROMIUM_SRC"
      command -v cygpath >/dev/null 2>&1 && ASAN_SRC="$(cygpath -m "$CHROMIUM_SRC")"
      export ASAN_OPTIONS="handle_abort=1:detect_odr_violation=0:symbolize=1:external_symbolizer_path='$ASAN_SRC/third_party/llvm-build/Release+Asserts/bin/llvm-symbolizer$TEST_EXE_SUFFIX'"
    fi ;;
esac

# Runs a test binary. On Windows it goes through `timeout`, for two reasons. It is the
# 15-minute cap of docs/AGENT-LOOP.md (STEDDING_TEST_BUDGET_S, in seconds; exit 124 when
# it fires). And a binary started straight from this script, under the shell of an agent's
# tool, failed four tests that need a window that is really active -- a row dragged onto a
# folder, a key typed into a page -- on every run, while the same binary under `timeout`
# passed them on every run (docs/HANDOFF.md, trap 56; trap 67 has the likely reason).
run_test_binary() {
  if is_windows; then
    timeout --foreground "${STEDDING_TEST_BUDGET_S:-900}" "$@"
  else
    "$@"
  fi
}

