+// An Arc-style folder in the sidebar: a header row with a chevron and a name,
+// its tabs (and nested folders) indented beneath it. Clicking the header
+// collapses it; double-clicking renames it in place.
+class FolderView : public views::View, public views::TextfieldController {
+  METADATA_HEADER(FolderView, views::View)
+
+ public:
+  explicit FolderView(TabCollectionNode* collection_node);
+  FolderView(const FolderView&) = delete;
+  FolderView& operator=(const FolderView&) = delete;
+  ~FolderView() override;
+
+  tabs::FolderTabCollection* folder() const;
+
+  // The header row, in screen coordinates: the part a dragged tab is dropped
+  // on to join the folder.
+  gfx::Rect GetHeaderBoundsInScreen() const;
+
+  // Paints the header as a drop target while a tab is dragged over it.
+  void SetDropHighlight(bool highlighted);
+
+  // views::View:
+  void ViewHierarchyChanged(
+      const views::ViewHierarchyChangedDetails& details) override;
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override;
+
+ private:
+  class HeaderView;
+
+  void ToggleCollapsed();
+  void ApplyCollapsed();
+  void BeginRename();
+  void EndRename(bool commit);
+  void UpdateHeader();
+
+  const raw_ptr<TabCollectionNode> collection_node_;
+  raw_ptr<HeaderView> header_ = nullptr;
+  raw_ptr<views::Label> chevron_ = nullptr;
+  raw_ptr<views::Label> name_ = nullptr;
+  raw_ptr<views::Textfield> rename_field_ = nullptr;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_FOLDER_VIEW_H_
