+
+// Every request is left unanswered, so a test of the place runs until the
+// requests time out; `asked` counts the requests that came.
+std::unique_ptr<net::test_server::HttpResponse> HangW2B02(
+    std::atomic<int>* asked,
+    const net::test_server::HttpRequest& request) {
+  asked->fetch_add(1);
+  return std::make_unique<net::test_server::HungResponse>();
+}
