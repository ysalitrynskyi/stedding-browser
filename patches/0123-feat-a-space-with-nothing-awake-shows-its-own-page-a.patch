@@ -0,0 +1,151 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/empty_space.h"
+
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_change_type.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "content/public/common/url_constants.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+bool IsEmptySpaceURL(const GURL& url) {
+  return url.SchemeIs(content::kChromeUIScheme) &&
+         url.host() == kEmptySpaceHost;
+}
+
+// The mark on the stand-in's page. It lives as long as the page is the
+// stand-in: closing the tab ends it, and so does the page leaving
+// chrome://stedding-space, which makes the tab an ordinary row.
+class EmptySpaceStandIn
+    : public content::WebContentsUserData<EmptySpaceStandIn>,
+      public content::WebContentsObserver {
+ public:
+  EmptySpaceStandIn(const EmptySpaceStandIn&) = delete;
+  EmptySpaceStandIn& operator=(const EmptySpaceStandIn&) = delete;
+  ~EmptySpaceStandIn() override = default;
+
+  // Called once the tab is in its strip.
+  void Watch(tabs::TabInterface* tab) {
+    will_deactivate_ = tab->RegisterWillDeactivate(base::BindRepeating(
+        &EmptySpaceStandIn::OnWillDeactivate, weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  friend class content::WebContentsUserData<EmptySpaceStandIn>;
+
+  explicit EmptySpaceStandIn(content::WebContents* contents)
+      : content::WebContentsUserData<EmptySpaceStandIn>(*contents),
+        content::WebContentsObserver(contents) {}
+
+  // Another row is about to be shown: the stand-in goes once that is done,
+  // so the strip never has to pick a row in its place.
+  void OnWillDeactivate(tabs::TabInterface* tab) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&EmptySpaceStandIn::CloseIfAway,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void CloseIfAway() {
+    tabs::TabInterface* const tab =
+        tabs::TabInterface::MaybeGetFromContents(web_contents());
+    if (!tab || tab->IsActivated()) {
+      return;
+    }
+    BrowserWindowInterface* const window = tab->GetBrowserWindowInterface();
+    TabStripModel* const tabs = window ? window->GetTabStripModel() : nullptr;
+    if (!tabs) {
+      return;
+    }
+    const int index = tabs->GetIndexOfTab(tab);
+    if (index == TabStripModel::kNoTab) {
+      return;
+    }
+    // Deletes this.
+    tabs->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+  }
+
+  // content::WebContentsObserver:
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (!navigation->IsInPrimaryMainFrame() || !navigation->HasCommitted() ||
+        navigation->IsSameDocument() || IsEmptySpaceURL(navigation->GetURL())) {
+      return;
+    }
+    // The page went somewhere: the tab is the user's now, an ordinary row.
+    content::WebContents* const contents = web_contents();
+    tabs::TabInterface* const tab =
+        tabs::TabInterface::MaybeGetFromContents(contents);
+    will_deactivate_ = {};
+    contents->RemoveUserData(UserDataKey());  // Deletes this.
+    if (!tab) {
+      return;
+    }
+    if (BrowserWindowInterface* const window =
+            tab->GetBrowserWindowInterface()) {
+      if (TabStripModel* const tabs = window->GetTabStripModel();
+          tabs && tabs->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+        tabs->NotifyTabChanged(tab, TabChangeType::kAll);
+      }
+    }
+  }
+
+  base::CallbackListSubscription will_deactivate_;
+  base::WeakPtrFactory<EmptySpaceStandIn> weak_factory_{this};
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(EmptySpaceStandIn);
+
+}  // namespace
+
+void ShowEmptySpace(BrowserWindowInterface* browser) {
+  if (!browser) {
+    return;
+  }
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  if (!tabs) {
+    return;
+  }
+  if (IsEmptySpaceStandIn(tabs->GetActiveTab())) {
+    return;
+  }
+  // Through the strip's delegate, as the New Tab it replaces was opened:
+  // filed under the active Space on insertion (spaces B1) and shown.
+  tabs->delegate()->AddTabAt(GURL(kEmptySpaceURL), -1, /*foreground=*/true);
+  tabs::TabInterface* const tab = tabs->GetActiveTab();
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents || contents->GetVisibleURL() != GURL(kEmptySpaceURL)) {
+    return;
+  }
+  EmptySpaceStandIn::CreateForWebContents(contents);
+  EmptySpaceStandIn::FromWebContents(contents)->Watch(tab);
+  // The sidebar lists the tab until it hears it changed; it reads the mark
+  // then (SpaceModel::HidesTab).
+  tabs->NotifyTabChanged(tab, TabChangeType::kAll);
+}
+
+bool IsEmptySpaceStandIn(const content::WebContents* contents) {
+  return contents && EmptySpaceStandIn::FromWebContents(contents);
+}
+
+bool IsEmptySpaceStandIn(const tabs::TabInterface* tab) {
+  return tab && IsEmptySpaceStandIn(tab->GetContents());
+}
+
+}  // namespace stedding
