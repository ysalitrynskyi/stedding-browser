+// sessions S32, spaces B38 (GitHub issue 99, BACKLOG S-477): seven full
+// chips, 12 apart, of Home, Work*, Personal+, Clients*, Play, Docs* and
+// Family+ (* the session Work, + the session Personal). Work's line is on the
+// first lane, a segment under Work, Clients and Docs each and a connector
+// between each two; Personal's crosses it, so it is a lane lower; Home and
+// Play, on the Shared session, have no segment.
+TEST(SwitcherRulesTest, ASessionsLineJoinsItsChipsAcrossOthers) {
+  std::vector<SwitcherSpan> chips;
+  for (int i = 0; i < 7; ++i) {
+    chips.push_back({18 + 36 * i, 24});
+  }
+  const std::vector<std::string> sessions = {"",  "work", "personal", "work",
+                                             "",  "work", "personal"};
+  const std::vector<SwitcherSessionLine> lines =
+      SwitcherSessionLines(chips, sessions);
+  ASSERT_EQ(2u, lines.size());
+  EXPECT_EQ((SwitcherSessionLine{
+                .session = "work",
+                .lane = 0,
+                .segments = {{57, 18}, {129, 18}, {201, 18}},
+                .connectors = {{75, 54}, {147, 54}}}),
+            lines[0]);
+  EXPECT_EQ((SwitcherSessionLine{.session = "personal",
+                                 .lane = 1,
+                                 .segments = {{93, 18}, {237, 18}},
+                                 .connectors = {{111, 126}}}),
+            lines[1]);
+  for (const size_t shared : {0u, 4u}) {
+    const SwitcherSpan& chip = chips[shared];
+    for (const SwitcherSessionLine& line : lines) {
+      for (const SwitcherSpan& segment : line.segments) {
+        EXPECT_FALSE(segment.start < chip.start + chip.extent &&
+                     chip.start < segment.start + segment.extent)
+            << "a segment under the Shared chip " << shared;
+      }
+    }
+  }
+}
+
+// Two neighbouring chips of one session have one segment under both, from
+// inside the first to inside the second, and no connector; a Shared row has
+// no line at all.
+TEST(SwitcherRulesTest, NeighbouringChipsOfASessionShareOneSegment) {
+  const std::vector<SwitcherSpan> chips = {
+      {0, 24}, {36, 24}, {72, 24}, {108, 24}};
+  EXPECT_EQ((std::vector<SwitcherSessionLine>{
+                {.session = "work", .lane = 0, .segments = {{39, 54}}}}),
+            SwitcherSessionLines(chips, {"", "work", "work", ""}));
+  EXPECT_TRUE(SwitcherSessionLines(chips, {"", "", "", ""}).empty());
+  // A dot's segment keeps inside it: a quarter of 6 DIP at each end.
+  EXPECT_EQ((std::vector<SwitcherSpan>{{1, 4}}),
+            SwitcherSessionLines({{0, 6}}, {"work"})[0].segments);
+}
+
+// Two lanes fit under the row: a third session that crosses both earlier
+// ones takes the second lane again, and one that crosses none stays on the
+// first.
+TEST(SwitcherRulesTest, AThirdCrossingSessionTakesTheSecondLaneAgain) {
+  std::vector<SwitcherSpan> chips;
+  for (int i = 0; i < 8; ++i) {
+    chips.push_back({36 * i, 24});
+  }
+  const std::vector<SwitcherSessionLine> lines = SwitcherSessionLines(
+      chips, {"a", "b", "c", "a", "b", "c", "", "d"});
+  ASSERT_EQ(4u, lines.size());
+  EXPECT_EQ(0, lines[0].lane);
+  EXPECT_EQ(1, lines[1].lane) << "b crosses a";
+  EXPECT_EQ(1, lines[2].lane) << "c crosses a and b";
+  EXPECT_EQ(0, lines[3].lane) << "d crosses nothing";
+}
