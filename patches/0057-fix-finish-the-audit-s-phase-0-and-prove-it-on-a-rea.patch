+  tab_strip_model()->ActivateTabAt(tab_strip_model()->GetIndexOfTab(last));
+  Run(IDC_STEDDING_SPACE_1);
+  ExpectShowing(ids_[0]);
+  Run(IDC_STEDDING_SPACE_2);
+  ExpectShowing(ids_[1]);
+  EXPECT_EQ(last, tab_strip_model()->GetActiveTab());
+}
+
+// B2: a tab opened in the foreground -- the way ⌘T and a link opened in a
+// new tab arrive -- is the one its Space comes back to, and it is on screen.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, ASpaceComesBackToATabOpenedInIt) {
+  MakeThreeSpaces();
+  Run(IDC_STEDDING_SPACE_2);
