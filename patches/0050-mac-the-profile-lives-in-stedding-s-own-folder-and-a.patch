+
+// Patch 0050: a profile an earlier Stedding left in Chromium's folder comes
+// across once, and Chromium's folder stays as it was.
+TEST(ChromePaths, MovesASteddingProfileOutOfChromiumsFolder) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath legacy = temp.GetPath().Append("Chromium");
+  const base::FilePath target = temp.GetPath().Append("Stedding");
+  const base::FilePath prefs = base::FilePath("Default").Append("Preferences");
+  ASSERT_TRUE(base::CreateDirectory(legacy.Append("Default")));
+  ASSERT_TRUE(base::WriteFile(legacy.Append(prefs),
+                              R"({"browser":{},"stedding":{}})"));
+  ASSERT_TRUE(base::CreateSymbolicLink(base::FilePath("host-1"),
+                                       legacy.Append("SingletonLock")));
+
+  EXPECT_TRUE(MigrateLegacyUserDataDirectory(legacy, target));
+  EXPECT_TRUE(base::PathExists(target.Append(prefs)));
+  EXPECT_FALSE(base::IsLink(target.Append("SingletonLock")));
+  EXPECT_TRUE(base::PathExists(legacy.Append(prefs)));
+  EXPECT_TRUE(base::IsLink(legacy.Append("SingletonLock")));
+
+  // Once: the next launch finds its folder and leaves it be.
+  ASSERT_TRUE(base::WriteFile(target.Append("marker"), "kept"));
+  EXPECT_FALSE(MigrateLegacyUserDataDirectory(legacy, target));
+  EXPECT_TRUE(base::PathExists(target.Append("marker")));
+}
+
+// Patch 0050: an early beta's profile names Stedding only in its GCM
+// category -- no Stedding setting was ever changed in it -- and still comes
+// across (the operator's own, 2026-09-23).
+TEST(ChromePaths, MovesAProfileSteddingCreatedWithNoSteddingSettings) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath legacy = temp.GetPath().Append("Chromium");
+  const base::FilePath target = temp.GetPath().Append("Stedding");
+  ASSERT_TRUE(base::CreateDirectory(legacy.Append("Default")));
+  ASSERT_TRUE(base::WriteFile(
+      legacy.Append("Default").Append("Preferences"),
+      R"({"gcm":{"product_category_for_subtypes":"com.stedding.macosx"}})"));
+
+  EXPECT_TRUE(MigrateLegacyUserDataDirectory(legacy, target));
+  EXPECT_TRUE(
+      base::PathExists(target.Append("Default").Append("Preferences")));
+}
+
+// Patch 0050: Chromium's own profile, with no Stedding preferences, stays
+// where it is and Stedding starts a fresh one.
+TEST(ChromePaths, LeavesChromiumsOwnProfileAlone) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const base::FilePath legacy = temp.GetPath().Append("Chromium");
+  const base::FilePath target = temp.GetPath().Append("Stedding");
+  ASSERT_TRUE(base::CreateDirectory(legacy.Append("Default")));
+  ASSERT_TRUE(base::WriteFile(
+      legacy.Append("Default").Append("Preferences"),
+      R"({"browser":{},"gcm":{"product_category_for_subtypes":)"
+      R"("org.chromium.macosx"}})"));
+
+  EXPECT_FALSE(MigrateLegacyUserDataDirectory(legacy, target));
+  EXPECT_FALSE(base::PathExists(target));
+}
