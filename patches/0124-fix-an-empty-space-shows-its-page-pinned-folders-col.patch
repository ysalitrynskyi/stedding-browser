+// sidebar Y51 (GitHub issue 45, a comment on 0.4.0 beta 8): with room in the
+// field, the pinned extensions' icons show, extensions pinned after the
+// address moved to the sidebar too, and they come back when the sidebar is
+// widened again. The field offered the extensions' row only the width it
+// had, so icons once folded into the menu never came back, with animations
+// on.
+IN_PROC_BROWSER_TEST_F(SidebarAddressTest, PinnedIconsShowWithRoom) {
+  const auto animations = gfx::AnimationTestApi::SetRichAnimationRenderMode(
+      gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !browser_view()->IsToolbarVisible(); }));
+  const auto set_width = [&](int width) {
+    controller()->SetUncollapsedWidth(width);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(browser_view()->GetWidget());
+      return region()->width() <= width + 24 && region()->width() >= width - 24;
+    })) << "the sidebar did not take " << width;
+  };
+  ASSERT_NO_FATAL_FAILURE(set_width(340));
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), Page("a.test", "/title1.html")));
+
+  ToolbarActionsModel* const actions =
+      ToolbarActionsModel::Get(browser()->GetProfile());
+  std::vector<std::unique_ptr<extensions::TestExtensionDir>> dirs;
+  std::vector<std::string> ids;
+  for (int i = 0; i < 2; ++i) {
+    auto dir = std::make_unique<extensions::TestExtensionDir>();
+    dir->WriteManifest(base::StringPrintf(
+        R"({"manifest_version": 3, "name": "Pinned %d", "version": "1",)"
+        R"( "action": {}})",
+        i));
+    const scoped_refptr<const extensions::Extension> extension =
+        extensions::ChromeTestExtensionLoader(browser()->GetProfile())
+            .LoadExtension(dir->UnpackedPath());
+    ASSERT_TRUE(extension);
+    if (!actions->IsActionPinned(extension->id())) {
+      actions->SetActionVisibility(extension->id(), true);
+    }
+    ids.push_back(extension->id());
+    dirs.push_back(std::move(dir));
+  }
+  ExtensionsToolbarDesktop* const extensions =
+      browser_view()->toolbar()->extensions_container_for_testing();
+  ASSERT_TRUE(extensions);
+
+  const auto icons_shown = [&]() {
+    size_t shown = 0;
+    for (const std::string& id : ids) {
+      views::View* const icon = extensions->GetViewForId(id);
+      if (icon && icon->IsDrawn() && !icon->size().IsEmpty()) {
+        ++shown;
+      }
+    }
+    return shown;
+  };
+  const auto settle = [&]() {
+    return base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(browser_view()->GetWidget());
+      return !extensions->GetAnimatingLayoutManager()->is_animating() &&
+             icons_shown() == ids.size();
+    });
+  };
+  EXPECT_TRUE(settle()) << icons_shown() << " of " << ids.size()
+                        << " pinned icons shown at 340 DIP on a.test";
+
+  ASSERT_NO_FATAL_FAILURE(set_width(126));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    return !extensions->GetAnimatingLayoutManager()->is_animating();
+  }));
+  ASSERT_NO_FATAL_FAILURE(set_width(340));
+  EXPECT_TRUE(settle()) << icons_shown() << " of " << ids.size()
+                        << " pinned icons back after the sidebar widened";
+}
