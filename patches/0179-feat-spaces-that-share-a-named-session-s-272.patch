+namespace {
+
+// Every label's text under `view`, one per line.
+std::u16string TextUnder(views::View* view) {
+  std::u16string text;
+  if (const views::Label* const label =
+          views::AsViewClass<views::Label>(view)) {
+    text += label->GetText();
+    text += u"\n";
+  }
+  for (views::View* const child : view->children()) {
+    text += TextUnder(child);
+  }
+  return text;
+}
+
+class SharedSessionTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  Profile* profile() { return browser()->GetProfile(); }
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  spaces::SpaceRegistry& registry() {
+    return *spaces::SpaceRegistryFactory::GetForProfile(profile());
+  }
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  GURL Url(const std::string& path) {
+    return embedded_test_server()->GetURL("jar.test", path);
+  }
+
+  std::optional<spaces::SpaceId> SpaceNamed(const std::string& name) {
+    for (const auto& space : model()->spaces()) {
+      if (space->name() == name) {
+        return space->id();
+      }
+    }
+    return std::nullopt;
+  }
+
+  spaces::SpaceId Add(const std::string& name) {
+    return model()->AddSpace(name, SK_ColorBLUE)->id();
+  }
+
+  // Mail and Docs in a session called Work, as "New session…" makes one.
+  std::string MakeWorkSession() {
+    mail_ = Add("Mail");
+    docs_ = Add("Docs");
+    const std::string work = registry().AddSession("Work");
+    model()->SetSpaceSession(*mail_, work);
+    model()->SetSpaceSession(*docs_, work);
+    return work;
+  }
+
+  // A foreground tab of Space `id` at `path`, on screen.
+  tabs::TabInterface* OpenIn(const spaces::SpaceId& id,
+                             const std::string& path) {
+    EXPECT_TRUE(model()->SetActiveSpace(id));
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url(path), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // The cookie is set by a page, and the tab then leaves that page: a Space
+  // that changes session takes its tabs, reloading each where it was, and a
+  // tab still on the setting page set the cookie again in the jar it moved
+  // to, the shared one.
+  void SetCookieIn(const spaces::SpaceId& id, const std::string& value) {
+    OpenIn(id, "/set-cookie?who=" + value + ";max-age=86400");
+    EXPECT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("/title1.html")));
+  }
+
+  // What the server saw of the cookies of a page of Space `id`.
+  std::string CookieSeenIn(const spaces::SpaceId& id) {
+    OpenIn(id, "/echoheader?Cookie");
+    return content::EvalJs(tabs()->GetActiveWebContents(),
+                           "document.body.innerText")
+        .ExtractString();
+  }
+
+  base::FilePath JarPath(const std::string& jar) {
+    return profile()
+        ->GetStoragePartition(content::StoragePartitionConfig::Create(
+            profile(), spaces::kSpacePartitionDomain, jar,
+            /*in_memory=*/false))
+        ->GetPath();
+  }
+
+  // The jar's cookie store is on disk, not empty.
+  // Windows keeps the cookie store in the jar's Network folder, the Mac at
+  // the jar's top.
+  bool JarFilesStay(const base::FilePath& path) {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    for (const base::FilePath& file :
+         {path.AppendASCII("Cookies"),
+          path.AppendASCII("Network").AppendASCII("Cookies")}) {
+      const std::optional<int64_t> size = base::GetFileSize(file);
+      if (size.has_value() && *size > 0) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Lets the wipes the model has posted run, or show that none does.
+  void SettleWipes() {
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(profile()
+                    ->GetPrefs()
+                    ->GetList(stedding::prefs::kPendingJarWipes)
+                    .empty())
+        << "a jar is waiting to be wiped";
+  }
+
+  // The question the window shows while `ask` runs, by its text; empty when
+  // none was shown. `accept` answers it.
+  std::u16string QuestionDuring(base::OnceClosure ask, bool accept) {
+    views::Widget* question = nullptr;
+    views::AnyWidgetObserver questions(views::test::AnyWidgetTestPasskey{});
+    questions.set_shown_callback(
+        base::BindLambdaForTesting([&](views::Widget* widget) {
+          if (widget->widget_delegate() &&
+              widget->widget_delegate()->AsDialogDelegate()) {
+            question = widget;
+          }
+        }));
+    std::move(ask).Run();
+    if (!base::test::RunUntil([&]() { return question != nullptr; })) {
+      return std::u16string();
+    }
+    const std::u16string text = TextUnder(question->GetRootView());
+    views::DialogDelegate* const delegate =
+        question->widget_delegate()->AsDialogDelegate();
+    if (accept) {
+      delegate->AcceptDialog();
+    } else {
+      delegate->CancelDialog();
+    }
+    return text;
+  }
+
+  static bool Has(const std::u16string& text, const std::u16string& part) {
+    return text.find(part) != std::u16string::npos;
+  }
+
+  std::optional<spaces::SpaceId> mail_;
+  std::optional<spaces::SpaceId> docs_;
+};
