+std::unique_ptr<views::View> MaybeCreateSiteControlsStrip(
+    content::WebContents* contents,
+    PageInfoNavigationHandler* navigation_handler) {
+  if (!RowsFor(ContextFor(contents)).strip) {
+    return nullptr;
+  }
+  return std::make_unique<SiteControlsStripView>(
+      std::make_unique<PageStripDelegate>(contents, navigation_handler));
+}
+
+std::unique_ptr<views::View> MaybeCreateSiteControlsRows(
+    content::WebContents* contents,
+    PageInfoNavigationHandler* navigation_handler) {
+  const SiteControlsRows rows = RowsFor(ContextFor(contents));
+  if (!rows.session && !rows.clear_data && !rows.dark_switch) {
+    return nullptr;
+  }
+  return std::make_unique<SiteControlsRowsView>(
+      std::make_unique<PageRowsDelegate>(contents, navigation_handler));
+}
