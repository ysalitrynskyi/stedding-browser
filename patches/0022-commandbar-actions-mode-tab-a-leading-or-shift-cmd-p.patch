+// Chromium's registry, depth first: every visible, enabled item with a label
+// (commandbar K9).
+void CollectActionItems(actions::ActionItem* item,
+                        std::vector<actions::ActionItem*>* out) {
+  if (!item) {
+    return;
+  }
+  if (!item->GetText().empty() && item->GetVisible() && item->GetEnabled()) {
+    out->push_back(item);
+  }
+  for (const auto& child : item->GetChildren().children()) {
+    CollectActionItems(child->GetActionItem(), out);
+  }
+}
