+
+namespace {
+
+namespace sb = spaces::sidebar_sync;
+using sb::FakePlace;
+using sb::PlaceKind;
+
+constexpr char kPeerB13[] = "0123456789abcdef";
+
+int64_t NowMsB13() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+spaces::SpaceId SpaceOfB13(const std::string& id) {
+  return *spaces::SpaceId::FromOptionalToken(base::Token::FromString(id));
+}
+
+std::string NewTabIdB13() {
+  return spaces::TabSyncId(base::Uuid::GenerateRandomV4().AsLowercaseString());
+}
+
+// Another computer's sidebar: one Space with `pins` pins, stamped `t`.
+sb::State PeerStateB13(const std::string& space,
+                       const std::vector<std::string>& pins,
+                       int64_t t,
+                       const std::string& name = "Peer Space") {
+  sb::State state;
+  const sb::Stamp stamp{t, kPeerB13};
+  sb::Record record(sb::Kind::kSpace);
+  record.f[sb::kFieldName] = sb::Field{name, stamp};
+  record.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+  record.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+  state.records[space] = record;
+  state.lists[sb::kSpacesList].order = {space};
+  state.lists[sb::kSpacesList].s = stamp;
+  sb::List& run = state.lists[sb::PinsListOf(space)];
+  run.s = stamp;
+  for (size_t i = 0; i < pins.size(); ++i) {
+    sb::Record pin(sb::Kind::kTab);
+    pin.f[sb::kFieldHome] = sb::Field{
+        "https://peer.example/" + base::NumberToString(i), stamp};
+    pin.f[sb::kFieldName] = sb::Field{"", stamp};
+    pin.f[sb::kFieldParent] = sb::Field{sb::PinsListOf(space), stamp};
+    state.records[pins[i]] = pin;
+    run.order.push_back(pins[i]);
+  }
+  return state;
+}
+
+class SidebarSyncB13Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+  spaces::SpaceRegistry& registry() {
+    return *spaces::SpaceRegistryFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+  base::FilePath sync_dir() {
+    return shared_.GetPath().AppendASCII(sb::kSyncFolderName);
+  }
+
+  // Another computer's file, written now.
+  void WritePeer(const sb::State& state, int64_t seq) {
+    base::ScopedAllowBlockingForTesting allow;
+    sb::FileMeta meta;
+    meta.install = kPeerB13;
+    meta.device = "Office PC";
+    meta.seq = seq;
+    meta.nonce = sb::MakeInstallId();
+    meta.written_ms = NowMsB13();
+    meta.hlc = state.MaxTime();
+    meta.joined_ms = 1;
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(
+        base::WriteFile(sync_dir().AppendASCII(sb::FileNameFor(kPeerB13)),
+                        sb::SerializeSyncFile(state, meta)));
+  }
+
+  // The join is made once its backup is written (Sf9).
+  void Join(bool combine) {
+    base::test::TestFuture<base::DictValue> preview;
+    service()->PreviewJoin(shared_.GetPath(), preview.GetCallback());
+    ASSERT_FALSE(preview.Get().FindString("refusal"));
+    ASSERT_TRUE(service()->ConfirmJoin(combine, "Test computer", {}));
+    ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  base::FilePath OwnFile() {
+    return sync_dir().AppendASCII(sb::FileNameFor(
+        browser()->GetProfile()->GetPrefs()->GetString(
+            stedding::prefs::kSidebarSyncInstallId)));
+  }
+
+  // This install's file in the folder, as it is written.
+  std::string OwnFileText() {
+    base::ScopedAllowBlockingForTesting allow;
+    std::string json;
+    return base::ReadFileToString(OwnFile(), &json) ? json : std::string();
+  }
+
+  tabs::TabInterface* TabWithToken(const std::string& id) {
+    for (int i = 0; i < tabs().count(); ++i) {
+      tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+      if (spaces::TabSyncId(stedding::TabToken(tab->GetContents())) == id) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  const sb::Record* LedgerRecord(const std::string& id) {
+    const sb::Ledger* const ledger = service()->ledger_for_testing();
+    if (!ledger) {
+      return nullptr;
+    }
+    const auto it = ledger->state.records.find(id);
+    return it == ledger->state.records.end() ? nullptr : &it->second;
+  }
+
+  // The waiting row `id` of Settings, or nullopt.
+  std::optional<base::DictValue> Decision(const std::string& id) {
+    base::DictValue status = service()->GetStatus();
+    if (base::ListValue* const decisions = status.FindList("decisions")) {
+      for (base::Value& row : *decisions) {
+        const std::string* const each = row.GetDict().FindString("id");
+        if (each && *each == id) {
+          return std::move(row.GetDict());
+        }
+      }
+    }
+    return std::nullopt;
+  }
+
+  base::ScopedTempDir shared_;
+};
+
+// P16-1a (Sf21): another computer's removal of the pin the user is on waits
+// until they leave it, and is applied then. It was applied from inside the
+// tab strip's own notice of the tab change, and the strip refused the call
+// it made: the browser stopped, and again after every restart.
+IN_PROC_BROWSER_TEST_F(SidebarSyncB13Test,
+                       ARemovalOfThePinOnScreenAppliesWhenTheUserLeavesIt) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  // Four pins, so one removal is under a third of them and is not held
+  // (Sf22).
+  const std::vector<std::string> pins = {NewTabIdB13(), NewTabIdB13(),
+                                         NewTabIdB13(), NewTabIdB13()};
+  const int64_t start = NowMsB13();
+  sb::State peer = PeerStateB13(space, pins, start);
+  WritePeer(peer, 1);
+  Join(/*combine=*/false);
+  ASSERT_TRUE(TabWithToken(pins[0])) << "the pin did not arrive";
+  ASSERT_TRUE(model().SetActiveSpace(SpaceOfB13(space)));
+
+  // A tab of that Space to leave the pin for, then the user opens the pin.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), embedded_test_server()->GetURL("/title1.html"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const other = tabs().GetActiveTab();
+  ASSERT_TRUE(other);
+  tabs::TabInterface* const opened = TabWithToken(pins[0]);
+  ASSERT_NE(other, opened);
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(opened));
+  ASSERT_EQ(opened, tabs().GetActiveTab());
+  Scan();
+
+  // The other computer removes it: it stays while the user is on it.
+  peer.records[pins[0]].del = sb::Stamp{start + 60'000, kPeerB13};
+  WritePeer(peer, 2);
+  Scan();
+  ASSERT_EQ(opened, TabWithToken(pins[0]));
+  ASSERT_TRUE(model().IsSpacePinned(opened))
+      << "the tab the user is on changed under them";
+  ASSERT_TRUE(LedgerRecord(pins[0]));
+  ASSERT_FALSE(LedgerRecord(pins[0])->Alive());
+
+  // The user leaves it: the removal applies. Opened here, it stays open as
+  // an ordinary tab of its Space.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(other));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    tabs::TabInterface* const tab = TabWithToken(pins[0]);
+    return !tab || !model().IsSpacePinned(tab);
+  })) << "the removal never applied";
+  tabs::TabInterface* const kept = TabWithToken(pins[0]);
+  ASSERT_TRUE(kept) << "a pin the user opened was closed";
+  EXPECT_FALSE(model().IsSpacePinned(kept));
+  EXPECT_EQ(other, tabs().GetActiveTab());
+}
