+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The archive sweep (PLAN.md WEB-6, docs/features/archive.md). With the idle
+// time passed, it closes the tabs nobody has looked at and leaves every tab
+// in use alone: a page that could ask "Leave site?" in another Space, the
+// other pane of the split on screen, a tab playing sound. It asks nothing,
+// switches nothing, and a tab it skipped is closed later as a plain close.
+
+#include <map>
+#include <string>
+
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
+#include "base/test/simple_test_tick_clock.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/tab_restore_service_factory.h"
+#include "chrome/browser/ui/archive/archive_mark.h"
+#include "chrome/browser/ui/archive/tab_archiver.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+class ArchiveSweepTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    browser()->GetProfile()->GetPrefs()->SetInteger(
+        stedding::prefs::kArchiveIdleHours, 6);
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  bool IsOpen(tabs::TabInterface* tab) {
+    return tabs()->GetIndexOfTab(tab) != TabStripModel::kNoTab;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(ArchiveSweepTest, TheSweepLeavesEveryTabInUseAlone) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+
+  // A second archiver of the window's strip, on a clock the test moves.
+  base::SimpleTestTickClock clock;
+  clock.SetNowTicks(base::TimeTicks::Now());
+  stedding::TabArchiver archiver(*browser(), *browser()->GetProfile()->GetPrefs());
+  archiver.set_tick_clock_for_testing(&clock);
+
+  // (a) In Work: a half-typed form behind a "Leave site?".
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  tabs::TabInterface* const form = Open("form.test");
+  ASSERT_TRUE(content::ExecJs(
+      form->GetContents(),
+      "document.body.innerHTML = '<input id=i>';"
+      "document.getElementById('i').value = 'half a sentence';"
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+  ASSERT_TRUE(model->SetActiveSpace(home));
+
+  // (b) In Home: a split, its left pane active.
+  tabs::TabInterface* const left = Open("left.test");
+  tabs::TabInterface* const right = Open("right.test");
+  tabs()->ActivateTabAt(tabs()->GetIndexOfTab(left));
+  tabs()->AddToNewSplit({tabs()->GetIndexOfTab(right)},
+                        split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(right->IsSplit());
+
+  // (c) A tab playing sound, in the background.
+  tabs::TabInterface* const sound = Open("sound.test");
+  ASSERT_TRUE(content::ExecJs(
+      sound->GetContents(),
+      "window.context = new AudioContext();"
+      "const tone = window.context.createOscillator();"
+      "tone.connect(window.context.destination); tone.start();"
+      "window.context.resume();"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return sound->GetContents()->IsCurrentlyAudible(); }));
+
+  // And one nobody uses.
+  tabs::TabInterface* const idle = Open("idle.test");
+  tabs()->ActivateTabAt(tabs()->GetIndexOfTab(left));
+  const int active = tabs()->active_index();
+
+  clock.Advance(base::Hours(7));
+  archiver.Sweep();
+  base::RunLoop().RunUntilIdle();
+
+  EXPECT_FALSE(IsOpen(idle)) << "the sweep does close what nobody uses";
+  EXPECT_TRUE(IsOpen(form)) << "a page that could ask stays";
+  EXPECT_TRUE(IsOpen(right)) << "the other pane of the split on screen stays";
+  EXPECT_TRUE(IsOpen(sound)) << "a tab playing sound stays";
+  EXPECT_EQ(home, model->active_id()) << "no Space switch";
+  EXPECT_EQ(left, tabs()->GetActiveTab()) << "nothing activated";
+  EXPECT_LE(tabs()->active_index(), active);
+
+  // A tab the sweep skipped, closed later by the user, is a plain close: the
+  // recently-closed entry carries no archive mark.
+  ASSERT_TRUE(content::ExecJs(
+      sound->GetContents(), "window.context.close();"));
+  tabs()->CloseWebContentsAt(tabs()->GetIndexOfTab(sound),
+                             TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  ASSERT_FALSE(service->entries().empty());
+  const auto& latest = service->entries().front();
+  ASSERT_EQ(sessions::tab_restore::TAB, latest->type);
+  const auto* const closed =
+      static_cast<const sessions::tab_restore::Tab*>(latest.get());
+  EXPECT_FALSE(closed->extra_data.contains(stedding::kArchiveReasonKey))
+      << "a plain close";
+
+  // Work comes back to the page that asks (spaces B2); it goes last, without
+  // its question.
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  EXPECT_EQ(form, tabs()->GetActiveTab());
+  ASSERT_TRUE(content::ExecJs(
+      form->GetContents(),
+      "window.removeEventListener('beforeunload', window.stay);"));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/clear_space_browsertest.cc b/chrome/test/stedding/clear_space_browsertest.cc
