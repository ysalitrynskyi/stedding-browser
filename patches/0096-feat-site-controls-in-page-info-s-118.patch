+    ASSERT_TRUE(content::ExecJs(
+        page, content::JsReplace("const a = document.createElement('a');"
+                                 "a.href = $1; a.target = '_blank';"
+                                 "document.body.appendChild(a); a.click();",
+                                 Url("b.test", "/echo?from-essential"))));
+    const tabs::TabHandle opened =
+        tabs::TabInterface::GetFromContents(added.Wait())->GetHandle();
+    EXPECT_EQ("jar=shared", FirstCookieFor("/echo?from-essential"))
+        << "the page took Work's cookies";
