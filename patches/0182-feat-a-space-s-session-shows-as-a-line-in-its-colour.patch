+// sessions S32 (GitHub issue 99, BACKLOG S-477): up to six sessions each have
+// a colour slot of their own, the same on every call, and a session made
+// later changes no earlier session's slot. The seventh takes a slot again.
+TEST(SpaceStoragePartitionTest, EachSessionKeepsAColourOfItsOwn) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceSessions);
+  SpaceRegistry registry(&prefs);
+  std::vector<std::string> sessions;
+  std::vector<int> slots;
+  for (int i = 0; i < 6; ++i) {
+    sessions.push_back(registry.AddSession("Session"));
+    const int slot = SessionSlot(registry, sessions.back());
+    EXPECT_GE(slot, 0);
+    EXPECT_LT(slot, static_cast<int>(kSessionSlots));
+    slots.push_back(slot);
+    for (size_t earlier = 0; earlier < sessions.size(); ++earlier) {
+      EXPECT_EQ(slots[earlier], SessionSlot(registry, sessions[earlier]))
+          << "session " << earlier << " changed colour when session " << i
+          << " was made";
+    }
+  }
+  EXPECT_EQ(6u, std::set<int>(slots.begin(), slots.end()).size())
+      << "two of six sessions share a colour";
+  const std::string seventh = registry.AddSession("Session");
+  EXPECT_LT(SessionSlot(registry, seventh), static_cast<int>(kSessionSlots));
+  for (size_t i = 0; i < sessions.size(); ++i) {
+    EXPECT_EQ(slots[i], SessionSlot(registry, sessions[i]));
+  }
