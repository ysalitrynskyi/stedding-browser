+SidebarSyncService::SidebarSyncService(Profile* profile)
+    : profile_(profile),
+      clock_(base::DefaultClock::GetInstance()),
+      io_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN})),
+      write_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN})),
+      ledger_runner_(base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+           base::TaskShutdownBehavior::BLOCK_SHUTDOWN})) {
+  // Sf39: with sync off, this preference is all the service watches.
+  prefs_.Init(profile_->GetPrefs());
+  prefs_.Add(stedding::prefs::kSidebarSyncFolder,
+             base::BindRepeating(&SidebarSyncService::OnFolderPrefChanged,
+                                 base::Unretained(this)));
+  if (enabled()) {
+    StartObserving();
+  }
+}
