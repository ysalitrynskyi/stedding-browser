+// P19-1b; sessions S20, PLAN.md SPC-9: a bookmark opened on a settings page
+// in a Space with a session of its own loads in new contents in the Space's
+// jar, and extensions know that navigation as the tab's from its start: an
+// onBeforeNavigate for the tab, and its request with the tab's id. The new
+// contents were no tab yet when the navigation started: it had no
+// onBeforeNavigate, and its request reached webRequest with tab id -1, so a
+// listener or rule for the tab missed the page.
+IN_PROC_BROWSER_TEST_F(SpaceJarB17Test,
+                       APageMovedToTheSpacesJarIsTheTabsFromItsStart) {
+  extensions::TestExtensionDir dir;
+  dir.WriteManifest(R"({
+      "name": "Hears the tab's navigations",
+      "version": "1",
+      "manifest_version": 3,
+      "background": {"service_worker": "background.js"},
+      "permissions": ["webNavigation", "webRequest"],
+      "host_permissions": ["<all_urls>"]
+  })");
+  dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+      const started = [];
+      const committed = [];
+      const requested = [];
+      const watched = url => url.includes('b17-landing');
+      chrome.webNavigation.onBeforeNavigate.addListener(details => {
+        if (details.frameId === 0 && watched(details.url)) {
+          started.push(details.tabId);
+        }
+      });
+      chrome.webNavigation.onCommitted.addListener(details => {
+        if (details.frameId === 0 && watched(details.url)) {
+          committed.push(details.tabId);
+        }
+      });
+      chrome.webRequest.onBeforeRequest.addListener(details => {
+        if (watched(details.url)) {
+          requested.push(details.tabId);
+        }
+      }, {urls: ['<all_urls>'], types: ['main_frame']});
+      self.heard = () => [started.join(' '), committed.join(' '),
+                          requested.join(' ')].join('|');
+  )");
+  extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+  const scoped_refptr<const extensions::Extension> extension =
+      loader.LoadExtension(dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+  // What the extension heard: the tab ids of onBeforeNavigate, onCommitted
+  // and the page's request, each list separated by "|".
+  const auto heard = [&]() {
+    const base::Value said = extensions::BackgroundScriptExecutor::ExecuteScript(
+        browser()->GetProfile(), extension->id(),
+        "chrome.test.sendScriptResult(heard());",
+        extensions::BackgroundScriptExecutor::ResultCapture::kSendScriptResult);
+    return said.is_string() ? said.GetString() : std::string("not a string");
+  };
+  ASSERT_EQ("||", heard()) << "the extension's worker is not listening";
+
+  // A settings page in Work keeps the profile's jar (SPC-9).
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const tab = tabs()->GetActiveTab();
+  ASSERT_EQ(work_, model_->FindSpaceForTab(tab));
+  ASSERT_FALSE(InWorksJar(tab));
+
+  // A bookmark opened there, in the same tab: the page goes to Work's jar.
+  const GURL landing = Url("b.test", "/title1.html?b17-landing");
+  NavigateParams params(browser(), landing, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::kCurrentTab;
+  params.source_contents = tab->GetContents();
+  Navigate(&params);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    content::WebContents* const contents = tab->GetContents();
+    return InWorksJar(tab) && contents->GetLastCommittedURL() == landing &&
+           !contents->IsLoading();
+  })) << "the page did not load in Work's jar";
+  const std::string tab_id = base::NumberToString(
+      sessions::SessionTabHelper::IdForTab(tab->GetContents()).id());
+
+  // Once the page's commit and its request have reached the extension.
+  std::string said;
+  std::vector<std::string> lists;
+  for (int i = 0; i < 100; ++i) {
+    said = heard();
+    lists = base::SplitString(said, "|", base::KEEP_WHITESPACE,
+                              base::SPLIT_WANT_ALL);
+    if (lists.size() == 3u && ListNamesB17(lists[1], tab_id) &&
+        !lists[2].empty()) {
+      break;
+    }
+    WaitAMomentB17();
+  }
+  ASSERT_EQ(3u, lists.size()) << said;
+  ASSERT_TRUE(ListNamesB17(lists[1], tab_id))
+      << "no onCommitted for the tab " << tab_id << ": " << said;
+  EXPECT_TRUE(ListNamesB17(lists[0], tab_id))
+      << "no onBeforeNavigate for the tab " << tab_id << ": " << said;
+  EXPECT_TRUE(ListNamesB17(lists[2], tab_id))
+      << "the page's request is not the tab " << tab_id << "'s: " << said;
+  EXPECT_FALSE(ListNamesB17(lists[2], "-1"))
+      << "the page's request had no tab: " << said;
+}
+
+// P19-1a; sessions S13: Clear Session Data signs a Space with a session of
+// its own out of a site it signed in to with HTTP authentication. The jar's
+// network stack kept the name and password for the site, and the page that
+// reloads after the clear was sent with them, still signed in, until the
+// browser quit.
+IN_PROC_BROWSER_TEST_F(SpaceJarB17Test,
+                       ClearSessionDataSignsOutOfHttpAuthentication) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("a.test", "/title1.html"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const tab = tabs()->GetActiveTab();
+  ASSERT_EQ(work_, model_->FindSpaceForTab(tab));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return InWorksJar(tab) && !tab->GetContents()->IsLoading();
+  }));
+
+  // Signed in: the name and password in the address answer the site's
+  // challenge, and the jar keeps them for the site.
+  GURL::Replacements with_password;
+  with_password.SetUsernameStr("user");
+  with_password.SetPasswordStr("secret");
+  content::NavigateToURLBlockUntilNavigationsComplete(
+      tab->GetContents(),
+      Url("a.test", "/auth-basic?b17-sign-in").ReplaceComponents(with_password),
+      1);
+  ASSERT_EQ(u"user/secret", tab->GetContents()->GetTitle());
+
+  // The site's next page is sent signed in, with no name in its address.
+  const std::string kept = "/auth-basic?b17-kept";
+  ASSERT_TRUE(content::NavigateToURL(tab->GetContents(), Url("a.test", kept)));
+  ASSERT_EQ(u"user/secret", tab->GetContents()->GetTitle());
+  ASSERT_FALSE(LastAuthorizationFor(kept).empty());
+
+  // Clear Session Data: the page reloads, signed out.
+  const size_t before = RequestsFor(kept);
+  base::test::TestFuture<void> wiped;
+  ASSERT_TRUE(model_->WipeIsolatedSession(work_, wiped.GetCallback()));
+  ASSERT_TRUE(wiped.Wait());
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return RequestsFor(kept) > before; }))
+      << "the page did not reload";
+  EXPECT_EQ("", LastAuthorizationFor(kept))
+      << "the page reloaded after the clear was sent signed in";
+}
+
+#if BUILDFLAG(IS_WIN)
+class LittleWindowB17Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+};
+
+// P20-1a; little E10, E1: on Windows a link another app hands over while
+// Stedding runs with no window open -- an app in the background keeps it
+// going -- opens in a little window once the launch has brought the session
+// back, over the window it brought back. The link opened nowhere: the
+// launch's restore had not made its window yet, and the little window waited
+// for one that never came.
+IN_PROC_BROWSER_TEST_F(LittleWindowB17Test,
+                       ALinkWhileNoWindowIsOpenStillOpensSmall) {
+  Profile* const profile = browser()->GetProfile();
+  const GURL url = embedded_test_server()->GetURL("/title1.html");
+
+  // The browser runs on with no window, as with an app in the background.
+  const ScopedKeepAlive keep_alive(KeepAliveOrigin::SESSION_RESTORE,
+                                   KeepAliveRestartOption::DISABLED);
+  const ScopedProfileKeepAlive profile_keep_alive(
+      profile, ProfileKeepAliveOrigin::kBrowserWindow);
+  CloseBrowserSynchronously(browser());
+  ASSERT_FALSE(GetLastActiveBrowserWindowInterfaceWithAnyProfile());
+
+  const base::CommandLine handed_over = base::CommandLine::FromString(
+      base::StrCat({L"stedding.exe --single-argument ",
+                    base::UTF8ToWide(url.spec())}));
+  ASSERT_TRUE(handed_over.HasSingleArgumentSwitch());
+  StartupBrowserCreatorImpl(base::FilePath(), handed_over,
+                            chrome::startup::IsFirstRun::kNo)
+      .Launch(profile, chrome::startup::IsProcessStartup::kNo,
+              /*restore_tabbed_browser=*/true);
+
+  // The little window showing the link, once there is one.
+  const auto little_with_link = [&]() {
+    BrowserWindowInterface* found = nullptr;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* window) {
+          content::WebContents* const page =
+              stedding::IsLittleWindow(window)
+                  ? window->GetTabStripModel()->GetActiveWebContents()
+                  : nullptr;
+          if (page && page->GetLastCommittedURL() == url) {
+            found = window;
+            return false;
+          }
+          return true;
+        });
+    return found;
+  };
+  const bool opened =
+      base::test::RunUntil([&]() { return little_with_link() != nullptr; });
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return !SessionRestore::IsRestoring(profile); }));
+  // The window the launch brought back stands in for the one closed.
+  BrowserWindowInterface* const back = stedding::LastActiveNormalWindow(profile);
+  if (back) {
+    SetBrowser(back);
+  }
+  EXPECT_TRUE(opened) << "the link opened nowhere";
+  EXPECT_TRUE(back) << "the session did not come back";
+}
+#endif  // BUILDFLAG(IS_WIN)
+
+}  // namespace
diff --git a/chrome/test/stedding/audit_b18_browsertest.cc b/chrome/test/stedding/audit_b18_browsertest.cc
new file mode 100644
index 0000000000000..b04f04cd63859
--- /dev/null
+++ b/chrome/test/stedding/audit_b18_browsertest.cc
@@ -0,0 +1,215 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Ad and tracker blocking (docs/features/blocker.md Bk7) after "Block ads and
+// trackers" is turned off: a page Stedding filtered while it was on still
+// shows no "ads blocked" notice and writes no ADS_DATA metadata for its site,
+// whether it comes back from the back-forward cache or blocks its first
+// request only after the switch-off. The lists come from a server of the
+// test's own, as in blocker_browsertest.cc; nothing is fetched from
+// easylist.to.
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/run_loop.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/blocker/blocker.h"
+#include "chrome/browser/ui/stedding/blocker/blocker_lists.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/content_settings/browser/page_specific_content_settings.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/prefs/pref_service.h"
+#include "components/subresource_filter/content/browser/content_subresource_filter_throttle_manager.h"
+#include "components/subresource_filter/content/browser/ruleset_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/test_navigation_observer.h"
+#include "content/public/test/test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "url/gurl.h"
+
+namespace {
+
+constexpr char kB18Page[] = "/stedding/blocker/page.html";
+
+// A page with nothing listed on it: it blocks nothing as it loads.
+constexpr char kB18PlainPage[] = "/stedding/blocker/blocker-ok-frame.html";
+
+// page.html's results with the lists on: the ad script, the tracker, the ad
+// image, the ad frame and the ad fetch blocked.
+constexpr char kB18ListedBlocked[] = "0,1,0,0,1,0,1,0,1";
+
+using B18Manager = subresource_filter::ContentSubresourceFilterThrottleManager;
+
+class BlockerSwitchOffB18Test : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    ASSERT_TRUE(list_server_.InitializeAndListen());
+    command_line->AppendSwitchASCII(
+        stedding::kBlockerListBaseSwitch,
+        list_server_.GetURL("/stedding/blocker/").spec());
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    list_server_.AddDefaultHandlers(GetChromeTestDataDir());
+    list_server_.StartAcceptingConnections();
+    if (embedded_test_server()->Started()) {
+      embedded_test_server()->StartAcceptingConnections();
+    } else {
+      ASSERT_TRUE(embedded_test_server()->Start());
+    }
+  }
+
+  PrefService* local_state() { return g_browser_process->local_state(); }
+
+  content::WebContents* Active() {
+    BrowserWindowInterface* const window = browser();
+    return window->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  GURL PageOn(const std::string& host) {
+    return embedded_test_server()->GetURL(host, kB18Page);
+  }
+
+  void Open(const std::string& host) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), PageOn(host)));
+  }
+
+  static std::string Results(content::WebContents* contents) {
+    return content::EvalJs(contents, "window.blockerResults()")
+        .ExtractString();
+  }
+
+  // Turns blocking on and waits until both lists have arrived and the
+  // ruleset made from them is the one the ruleset service has indexed and
+  // published, as BlockerTest does.
+  void TurnOnAndWait() {
+    local_state()->SetBoolean(stedding::prefs::kBlockerEnabled, true);
+    stedding::BlockerLists* const lists = stedding::BlockerLists::Get();
+    ASSERT_TRUE(lists);
+    subresource_filter::RulesetService* const service =
+        g_browser_process->subresource_filter_ruleset_service();
+    ASSERT_TRUE(service);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      const stedding::BlockerLists::Status status = lists->GetStatus();
+      return !status.busy && status.has_ruleset &&
+             std::ranges::all_of(
+                 status.lists,
+                 [](const stedding::BlockerLists::ListStatus& list) {
+                   return !list.fetched.is_null();
+                 }) &&
+             service->GetMostRecentlyIndexedVersion().content_version ==
+                 status.content_version;
+    }));
+    base::RunLoop published;
+    service->GetRulesetDealer()->GetDealerAsync(base::BindOnce(
+        [](scoped_refptr<base::SequencedTaskRunner> ui,
+           base::OnceClosure quit,
+           subresource_filter::VerifiedRulesetDealer*) {
+          ui->PostTask(FROM_HERE, std::move(quit));
+        },
+        base::SequencedTaskRunner::GetCurrentDefault(),
+        published.QuitClosure()));
+    published.Run();
+  }
+
+  // Turns "Block ads and trackers" off, as its Settings switch does.
+  void TurnOff() {
+    local_state()->SetBoolean(stedding::prefs::kBlockerEnabled, false);
+    ASSERT_FALSE(B18Manager::HasPageActivationThrottleFactory());
+  }
+
+  // Bk7: no ADS_DATA metadata for the site of `page`, and no "ads blocked"
+  // state on the tab's page.
+  void ExpectNothingRecorded(const GURL& page) {
+    SCOPED_TRACE(page.spec());
+    HostContentSettingsMap* const map =
+        HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile());
+    EXPECT_TRUE(
+        map->GetWebsiteSetting(page, GURL(), ContentSettingsType::ADS_DATA)
+            .is_none())
+        << "ADS_DATA metadata was written for the site";
+    content_settings::PageSpecificContentSettings* const settings =
+        content_settings::PageSpecificContentSettings::GetForFrame(
+            Active()->GetPrimaryMainFrame());
+    ASSERT_TRUE(settings);
+    EXPECT_FALSE(settings->IsContentBlocked(ContentSettingsType::ADS))
+        << "the tab shows Chromium's \"ads blocked\" notice";
+  }
+
+  net::EmbeddedTestServer list_server_;
+};
+
+}  // namespace
+
+// P21-1a, blocker Bk7 (a page restored from the back-forward cache): a page
+// filtered while blocking was on, left, and restored after the switch is
+// turned off, keeps Chromium's notice and its per-site record away. Its
+// requests blocked while blocking was on had made Chromium show its notice
+// on the restore, as only the global switch said Stedding decided.
+IN_PROC_BROWSER_TEST_F(BlockerSwitchOffB18Test,
+                       APageFilteredBeforeTheSwitchOffRecordsNothingOnBack) {
+  TurnOnAndWait();
+  Open("a.test");
+  ASSERT_EQ(kB18ListedBlocked, Results(Active()));
+  content::RenderFrameHostWrapper filtered(Active()->GetPrimaryMainFrame());
+  Open("b.test");
+  ASSERT_FALSE(filtered.IsDestroyed());
+  ASSERT_TRUE(filtered->IsInLifecycleState(
+      content::RenderFrameHost::LifecycleState::kInBackForwardCache))
+      << "the filtered page did not enter the back-forward cache";
+
+  TurnOff();
+  content::TestNavigationObserver back(Active());
+  Active()->GetController().GoBack();
+  back.Wait();
+  ASSERT_TRUE(back.last_navigation_succeeded());
+  ASSERT_EQ(filtered.get(), Active()->GetPrimaryMainFrame())
+      << "the page was not restored from the back-forward cache";
+  ExpectNothingRecorded(PageOn("a.test"));
+}
+
+// P21-1a, blocker Bk7 (an open page): a page filtered while blocking was on
+// keeps the filter it loaded with after the switch is turned off; its first
+// blocked request, made after the switch-off, shows no notice and writes no
+// ADS_DATA metadata for its site.
+IN_PROC_BROWSER_TEST_F(BlockerSwitchOffB18Test,
+                       AFirstBlockedRequestAfterTheSwitchOffRecordsNothing) {
+  TurnOnAndWait();
+  const GURL page = embedded_test_server()->GetURL("a.test", kB18PlainPage);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), page));
+
+  TurnOff();
+  ASSERT_EQ(false, content::EvalJs(Active(), R"(
+      fetch('blocker-ad-fetch.json', {cache: 'no-store'})
+          .then(response => response.ok, () => false))"))
+      << "the open page lost the filter it loaded with";
+  // The page reports its first blocked request to the browser before the
+  // fetch above fails; one more turn of the page and of this thread makes
+  // sure that report has been handled.
+  ASSERT_TRUE(content::ExecJs(Active(), "true"));
+  base::RunLoop().RunUntilIdle();
+  ExpectNothingRecorded(page);
+}
