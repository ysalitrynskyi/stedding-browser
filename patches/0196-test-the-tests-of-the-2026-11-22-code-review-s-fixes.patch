+class SidebarPanelsB26Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* window() { return browser_view()->GetWidget(); }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  stedding::SidebarPanels* panels() {
+    return stedding::SidebarPanels::From(browser());
+  }
+  stedding::SidebarPanelView* panel_view() {
+    return region()->sidebar_panel_view_for_testing();
+  }
+  content::WebContents* panel_page() {
+    return panel_view() ? panel_view()->web_view()->GetWebContents() : nullptr;
+  }
+
+  // Waits until `panel` is the one in the sidebar's column -- none for
+  // kNone -- and its page has built itself.
+  [[nodiscard]] bool WaitForPanelB26(SidebarPanel panel) {
+    if (!base::test::RunUntil([&]() {
+          views::test::RunScheduledLayout(window());
+          stedding::SidebarPanelView* const view = panel_view();
+          return panel == SidebarPanel::kNone
+                     ? view == nullptr
+                     : view != nullptr && view->panel() == panel;
+        })) {
+      return false;
+    }
+    if (panel == SidebarPanel::kNone) {
+      return true;
+    }
+    content::WebContents* const page = panel_page();
+    if (!content::WaitForLoadStop(page)) {
+      return false;
+    }
+    return base::test::RunUntil([&]() {
+      return content::EvalJs(page, "document.body.dataset.panel || ''")
+                 .ExtractString() != "";
+    });
+  }
+
+  // Types `text` into the panel's search field, as a person does, and reads
+  // the field back.
+  void SearchB26(const std::string& text) {
+    ASSERT_TRUE(content::ExecJs(
+        panel_page(),
+        content::JsReplace("{ const field = document.getElementById('search');"
+                           "  field.value = $1;"
+                           "  field.dispatchEvent(new Event('input')); }",
+                           text)));
+  }
+  std::string SearchTextB26() {
+    return content::EvalJs(panel_page(),
+                           "document.getElementById('search').value")
+        .ExtractString();
+  }
+
+  // ⌘Y (Ctrl+H): History in the sidebar's column, with a search typed in.
+  void OpenHistoryWithASearchB26() {
+    ASSERT_TRUE(panels());
+    ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+    ASSERT_TRUE(WaitForPanelB26(SidebarPanel::kHistory));
+    ASSERT_NO_FATAL_FAILURE(SearchB26("needle"));
+    ASSERT_EQ("needle", SearchTextB26());
+  }
+};
+
+// P34-1d; sidebar panels Pn3. The window's own word that it was hidden as a
+// whole -- on the Mac a minimise (⌘M) or hiding the app (⌘H) sends it --
+// leaves an open panel and its search as they were, for when the window
+// comes back. The panel closes only when the sidebar itself stops being
+// shown. Every minimise on the Mac closed it, the tab list was back and the
+// search was gone; the same steps on Windows kept it.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsB26Test,
+                       APanelOutlastsTheWindowBeingHiddenWhole) {
+  ASSERT_NO_FATAL_FAILURE(OpenHistoryWithASearchB26());
+
+  // What the window's native widget tells the widget as the window goes
+  // and as it comes back.
+  window()->OnNativeWidgetVisibilityChanged(false);
+  window()->OnNativeWidgetVisibilityChanged(true);
+  views::test::RunScheduledLayout(window());
+
+  EXPECT_EQ(SidebarPanel::kHistory, panels()->open())
+      << "the window going closed the panel";
+  ASSERT_TRUE(panel_view()) << "the tab list is back in the panel's place";
+  EXPECT_EQ("needle", SearchTextB26()) << "the search is gone";
+
+  // The sidebar itself no longer shown still closes it.
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS));
+  ASSERT_FALSE(
+      vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+  EXPECT_TRUE(WaitForPanelB26(SidebarPanel::kNone))
+      << "the panel stayed open with horizontal tabs";
+  EXPECT_EQ(SidebarPanel::kNone, panels()->open());
+}
+
+#if BUILDFLAG(IS_MAC)
+// P34-1d; sidebar panels Pn3. ⌘M and back: the History panel is still open
+// in the sidebar's column, with the search typed in it.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsB26Test, APanelOutlastsAMinimise) {
+  ASSERT_NO_FATAL_FAILURE(OpenHistoryWithASearchB26());
+
+  window()->Minimize();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return window()->IsMinimized() && !window()->IsVisible(); }))
+      << "the window did not minimise";
+  window()->Restore();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !window()->IsMinimized() && window()->IsVisible(); }))
+      << "the window did not come back";
+  views::test::RunScheduledLayout(window());
+
+  EXPECT_EQ(SidebarPanel::kHistory, panels()->open())
+      << "minimising closed the panel";
+  ASSERT_TRUE(panel_view()) << "the tab list is back in the panel's place";
+  EXPECT_EQ("needle", SearchTextB26()) << "the search is gone";
+}
+#endif  // BUILDFLAG(IS_MAC)
