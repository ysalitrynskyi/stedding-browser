+  // pins H25: a page of one colour on a host of its own, so that each tab
+  // has a renderer of its own and its CPU is its own.
+  GURL Page(const std::string& host, const std::string& rrggbb) {
+    return embedded_test_server()->GetURL(host, "/colour?" + rrggbb);
+  }
+
+  // Hovers `row` with `controller` and returns whether the card shows on it
+  // in the same task, as it does with the card's animations off: the card
+  // as it first shows, before any timer has run.
+  [[nodiscard]] bool ShowCardNow(TabHoverCardController* controller,
+                                 TabView* row) {
+    if (!row) {
+      return false;
+    }
+    views::test::RunScheduledLayout(row->GetWidget());
+    controller->UpdateHoverCard(row, HoverCardUpdateType::kHover);
+    return controller->IsHoverCardShowingForTab(row) &&
+           controller->hover_card_for_testing();
+  }
+
+  // The resource line on `controller`'s card, empty while it shows none.
+  static std::u16string LineOf(TabHoverCardController* controller) {
+    TabHoverCardBubbleView* const bubble = controller->hover_card_for_testing();
+    views::Label* const line =
+        bubble ? bubble->GetResourceLineForTesting() : nullptr;
+    return line && line->IsDrawn() ? std::u16string(line->GetText())
+                                   : std::u16string();
+  }
+  std::u16string ResourceLine() { return LineOf(cards()); }
+
+  // The card's accessible description.
+  std::u16string CardDescription() {
+    return card() ? card()->GetViewAccessibility().GetCachedDescription()
+                  : std::u16string();
+  }
+
+  // The line's parts: memory, "CPU n%", the network rate.
+  static std::vector<std::u16string> PartsOf(const std::u16string& line) {
+    return base::SplitStringUsingSubstr(
+        line, u" \u00B7 ", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  }
+  // "312 MB", "64.0 MB", "1.5 GB": a number and Chromium's byte unit.
+  static bool IsAMemoryFigure(const std::u16string& part) {
+    return !part.empty() && base::IsAsciiDigit(part[0]) &&
+           base::EndsWith(part, u"B") && !base::EndsWith(part, u"/s");
+  }
+  // The CPU percent the line reads, or -1.
+  static int CpuOf(const std::u16string& line) {
+    for (const std::u16string& part : PartsOf(line)) {
+      int percent = 0;
+      if (base::StartsWith(part, u"CPU ") && base::EndsWith(part, u"%") &&
+          base::StringToInt(part.substr(4, part.size() - 5), &percent)) {
+        return percent;
+      }
+    }
+    return -1;
+  }
+  // Whether Chromium's task manager is measuring: for the line, only while a
+  // tab is being read for it.
+  static bool TaskManagerRuns() {
+    return task_manager::TaskManagerImpl::IsCreated() &&
+           task_manager::TaskManagerImpl::GetInstance()->is_running();
+  }
+  // Memory, CPU and network, in that order.
+  static bool HasEveryFigure(const std::u16string& line) {
+    const std::vector<std::u16string> parts = PartsOf(line);
+    return parts.size() == 3 && IsAMemoryFigure(parts[0]) && CpuOf(line) >= 0 &&
+           base::EndsWith(parts[2], u"B/s");
+  }
