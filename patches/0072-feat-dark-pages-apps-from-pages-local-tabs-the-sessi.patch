+  EXPECT_EQ(quiet, line->GetLabelColorForTesting()) << "Clear is not quiet";
+
+  const gfx::PointF over(line->GetClearRect().CenterPoint());
+  line->OnMouseMoved(ui::MouseEvent(ui::EventType::kMouseMoved, over, over,
+                                    base::TimeTicks::Now(), 0, 0));
