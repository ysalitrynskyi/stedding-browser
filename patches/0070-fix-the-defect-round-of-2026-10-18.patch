+class NumberBadgeTest : public SpaceSwitchTest {
+ protected:
+  const std::vector<base::test::FeatureRefAndParams> GetEnabledFeatures()
+      override {
+    std::vector<base::test::FeatureRefAndParams> enabled =
+        SpaceSwitchTest::GetEnabledFeatures();
