+// folders F30, commandbar K9: actions mode lists "Collapse All Folders"
+// while a folder of the Space is open on screen and "Expand All Folders"
+// while one is collapsed, the chord drawn on the row the chord would run.
+// Each reaches the active Space's folders alone; another Space's folder
+// keeps its state. With no folder neither row is listed.
+TEST_F(CommandBarViewTest, FolderRowsCollapseAndExpandTheSpacesFolders) {
+  // The folders chord, for a test window that has no BrowserView.
+  class FolderChord : public ui::AcceleratorProvider {
+   public:
+    bool GetAcceleratorForCommandId(
+        int command_id,
+        ui::Accelerator* accelerator) const override {
+      if (command_id != IDC_STEDDING_TOGGLE_ALL_FOLDERS) {
+        return false;
+      }
+      *accelerator = ui::Accelerator(
+          ui::VKEY_E, ui::EF_PLATFORM_ACCELERATOR | ui::EF_SHIFT_DOWN);
+      return true;
+    }
+  };
+  FolderChord chord;
+  const auto open_actions = [&]() {
+    auto bar = std::make_unique<CommandBarView>(browser());
+    bar->SetAcceleratorProviderForTesting(&chord);
+    bar->SetModeForTesting(CommandBarView::Mode::kActions);
+    return bar;
+  };
+  // The chord drawn on the row titled `title`, or empty.
+  const auto chord_on = [](CommandBarView& bar, const std::u16string& title) {
+    for (size_t i = 0; i < bar.row_count_for_testing(); ++i) {
+      if (bar.row_title_for_testing(i) == title) {
+        return bar.row_detail_for_testing(i);
+      }
+    }
+    return std::u16string();
+  };
+  const std::u16string collapse = u"Collapse All Folders";
+  const std::u16string expand = u"Expand All Folders";
+
+  AddTab(browser(), GURL("https://example.com/"));
+  {
+    std::unique_ptr<CommandBarView> bar = open_actions();
+    EXPECT_FALSE(HasTitle(*bar, collapse)) << "no folder, no row";
+    EXPECT_FALSE(HasTitle(*bar, expand));
+  }
+
+  AddTab(browser(), GURL("https://example.org/"));
+  AddTab(browser(), GURL("https://example.net/"));
+  AddTab(browser(), GURL("https://example.edu/"));
+  // edu, net, org, com: A[edu], B[net], W[org], com; W's tab goes to Work.
+  tabs::FolderTabCollection* const a = tabs().AddToNewFolder({0});
+  ASSERT_TRUE(a);
+  tabs::FolderTabCollection* const b = tabs().AddToNewFolder({1});
+  ASSERT_TRUE(b);
+  tabs::FolderTabCollection* const w = tabs().AddToNewFolder({2});
+  ASSERT_TRUE(w);
+  spaces::Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  model().SetSpaceForTab(tabs().GetTabAtIndex(2), work->id());
+
+  {
+    std::unique_ptr<CommandBarView> bar = open_actions();
+    EXPECT_TRUE(HasTitle(*bar, collapse));
+    EXPECT_FALSE(HasTitle(*bar, expand)) << "no folder is collapsed";
+    EXPECT_FALSE(chord_on(*bar, collapse).empty()) << "the chord collapses";
+    bar->ContentsChanged(bar->field_for_testing(), u"collapse all folders");
+    ASSERT_EQ(1u, bar->row_count_for_testing());
+    EXPECT_TRUE(Enter(*bar));
+  }
+  EXPECT_TRUE(a->collapsed());
+  EXPECT_TRUE(b->collapsed());
+  EXPECT_FALSE(w->collapsed()) << "another Space's folder keeps its state";
+
+  {
+    std::unique_ptr<CommandBarView> bar = open_actions();
+    EXPECT_FALSE(HasTitle(*bar, collapse)) << "nothing is open on screen";
+    EXPECT_TRUE(HasTitle(*bar, expand));
+    EXPECT_FALSE(chord_on(*bar, expand).empty()) << "now the chord expands";
+  }
+
+  // One folder open and one collapsed: both rows, the chord on Collapse.
+  b->SetCollapsed(false);
