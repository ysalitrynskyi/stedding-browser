+// toolbar T30: at rest the host is in the row's text colour and the rest of
+// the address -- the scheme, the port and the path here -- a step dimmer, 70%
+// of it, as Chromium draws a full address; the dimming follows the page's
+// colour with the other text (T7). toolbar T21: the row keeps its colour
+// across a reload. A white page reloading to white is never announced (the
+// WebContents announces a background only when it differs from the last one
+// it sent), and the row dropped to the window's ground and stayed there
+// (2026-09-08).
+IN_PROC_BROWSER_TEST_F(PageColourRowTest, TheAddressAndTheRowFollowThePage) {
+  ASSERT_TRUE(WaitForTheRow(SK_ColorWHITE)) << "the white page never coloured "
+                                               "the row";
+  OmniboxViewViews* const omnibox = bar()->omnibox_view();
+  const std::u16string address = omnibox->GetText();
+  ASSERT_EQ(0u, address.find(u"http://a.test:"))
+      << "T28: the whole address at rest, scheme and port included: "
+      << address;
+  // The colour each character of the address is drawn in: "H" the row's text
+  // colour, "d" its dimmed one, "?" any other.
+  const auto drawn = [&]() {
+    views::test::RunScheduledLayout(view());
+    views::TextfieldTestApi field(omnibox);
+    gfx::test::RenderTextTestApi text(field.GetRenderText());
+    const ui::ColorProvider* const colours = omnibox->GetColorProvider();
+    const SkColor host = colours->GetColor(kColorOmniboxText);
+    const SkColor dimmed = colours->GetColor(kColorOmniboxTextDimmed);
+    std::string out;
+    for (size_t i = 0; i < address.size(); ++i) {
+      const SkColor colour = text.colors().GetBreak(i)->second;
+      out += colour == host ? 'H' : colour == dimmed ? 'd' : '?';
+    }
+    return out;
+  };
+  // T30's address: the host "H", the rest "d".
+  std::string expected(address.size(), 'd');
+  expected.replace(address.find(u"a.test"), 6, "HHHHHH");
+  {
+    SCOPED_TRACE("on a white page");
+    EXPECT_EQ(expected, drawn()) << address;
+    const ui::ColorProvider* const colours = omnibox->GetColorProvider();
+    EXPECT_EQ(SkColorSetA(colours->GetColor(kColorOmniboxText), 0xB3),
+              colours->GetColor(kColorOmniboxTextDimmed))
+        << "the rest of the address is 70% of the host's colour";
+  }
+  {
+    SCOPED_TRACE("a reload keeps the row's colour");
+    std::vector<std::optional<SkColor>> seen;
+    const base::CallbackListSubscription watch =
+        row()->AddChangedCallback(base::BindLambdaForTesting(
+            [&]() { seen.push_back(row()->color()); }));
+    content::TestNavigationObserver reloaded(page());
+    chrome::Reload(browser(), WindowOpenDisposition::CURRENT_TAB);
+    reloaded.Wait();
+    // The reads at the first paint and at the end of loading, and the late
+    // one (kSampleLate, 1.5 s).
+    base::RunLoop late;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, late.QuitClosure(), base::Seconds(2));
+    late.Run();
+    for (const std::optional<SkColor>& colour : seen) {
+      EXPECT_TRUE(colour && stedding::PageColorsMatch(*colour, SK_ColorWHITE))
+          << "the row went to "
+          << (colour ? std::to_string(*colour) : "the window's ground");
+    }
+    ASSERT_TRUE(row()->color()) << "the row is on the window's ground";
+    EXPECT_TRUE(stedding::PageColorsMatch(*row()->color(), SK_ColorWHITE));
+  }
+  {
+    SCOPED_TRACE("on a dark page");
+    constexpr SkColor kDark = SkColorSetRGB(0x10, 0x20, 0x30);
+    ASSERT_TRUE(content::ExecJs(
+        page(), "document.documentElement.style.background = '#102030';"));
+    ASSERT_TRUE(WaitForTheRow(kDark)) << "the dark page never coloured the row";
+    EXPECT_EQ(expected, drawn()) << address;
+    EXPECT_FALSE(color_utils::IsDark(
+        omnibox->GetColorProvider()->GetColor(kColorOmniboxText)))
+        << "the host reads light on the dark row";
+  }
+}
