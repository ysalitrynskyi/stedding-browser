+constexpr char kSettingsUrl[] = "chrome://settings/stedding";
+
+// `body`, run on the settings page with `pick(selector)`: the first element
+// that matches anywhere on the page, through every shadow root, or null.
+std::string OnThePageW2B02(std::string_view body) {
+  return base::StrCat({R"(
+    (() => {
+      const find = (root, selector) => {
+        const hit = root.querySelector(selector);
+        if (hit) {
+          return hit;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot, selector);
+            if (found) {
+              return found;
+            }
+          }
+        }
+        return null;
+      };
+      const pick = selector => find(document, selector);
+  )",
+                       body, "\n    })()"});
+}
+
+// The Settings page in the tab on screen, once `selector` is drawn on it.
+content::WebContents* OpenSettingsW2B02(BrowserWindowInterface* browser,
+                                        std::string_view selector) {
+  EXPECT_TRUE(ui_test_utils::NavigateToURL(browser, GURL(kSettingsUrl)));
+  content::WebContents* const page =
+      browser->GetTabStripModel()->GetActiveWebContents();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(
+               page, OnThePageW2B02(content::JsReplace(
+                         "return !!pick($1);", std::string(selector))))
+        .ExtractBool();
+  })) << "the page never drew " << selector;
+  return page;
+}
