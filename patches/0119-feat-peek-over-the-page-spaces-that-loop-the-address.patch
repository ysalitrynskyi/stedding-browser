+void SidebarToolbarButtons::Recolor() {
+  std::vector<views::View*> pending(children().begin(), children().end());
+  while (!pending.empty()) {
+    views::View* const view = pending.back();
+    pending.pop_back();
+    if (ToolbarButton* const button = views::AsViewClass<ToolbarButton>(view)) {
+      button->UpdateIcon();
+    }
+    pending.insert(pending.end(), view->children().begin(),
+                   view->children().end());
+  }
+}
