+  ASSERT_TRUE(later);
+  EXPECT_EQ("", stedding::TabParentToken(later->GetContents()));
+  prefs->SetBoolean(stedding::prefs::kNestChildTabs, true);
+  EXPECT_EQ(14, Indent(child));
