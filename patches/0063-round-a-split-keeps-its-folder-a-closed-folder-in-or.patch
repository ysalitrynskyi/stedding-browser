+// An entry's place in its folder close: its first tab's, as the close marked
+// it. A close recorded before the places were (patch 0063) has none, and
+// keeps the list's order.
+int PlaceOf(const sessions::tab_restore::Entry& entry) {
+  int place = std::numeric_limits<int>::max();
+  for (const sessions::tab_restore::Tab* const tab : TabsOf(entry)) {
+    const auto it = tab->extra_data.find(kClosedFolderOrderKey);
+    int value = 0;
+    if (it != tab->extra_data.end() && base::StringToInt(it->second, &value)) {
+      place = std::min(place, value);
+    }
+  }
+  return place;
+}
+
+// The entries of the folder close `batch`, in the folder's order. The list is
+// newest first and records the tabs of a close in the order they close, so
+// it reads backwards; but a split that closes is recorded before any tab of
+// the close (TabStripModel::CreateHistoricalSplitIfClosing), so the places
+// the close marked decide (BACKLOG S-135).
+std::vector<const sessions::tab_restore::Entry*> FolderEntries(
+    const sessions::TabRestoreService::Entries& entries,
+    std::string_view batch) {
+  std::vector<const sessions::tab_restore::Entry*> folder;
+  if (batch.empty()) {
+    return folder;
+  }
+  for (auto entry = entries.rbegin(); entry != entries.rend(); ++entry) {
+    if (ClosedFolderBatchOf(**entry) == batch) {
+      folder.push_back(entry->get());
+    }
+  }
+  std::ranges::stable_sort(folder, std::less<>(),
+                           [](const sessions::tab_restore::Entry* entry) {
+                             return PlaceOf(*entry);
+                           });
+  return folder;
+}
+
+// folders F19: the window UNKNOWN sends a tab back to: the one it was closed
+// in while that window is open, else a new one (null here), or `context` for
+// a tab with no window of its own (RestoreTab). The order is judged by that
+// window: judged by the window the command came from, a folder whose own
+// window now held fewer tabs than its old place came back reversed (BACKLOG
+// S-135).
+sessions::LiveTabContext* WindowTheRestoreLandsIn(
+    sessions::LiveTabContext* context,
+    SessionID::id_type browser_id) {
+  return browser_id ? BrowserLiveTabContext::FindContextWithID(
+                          SessionID::FromSerializedValue(browser_id))
+                    : context;
+}
+
+// The window a restored tab is in.
+sessions::LiveTabContext* WindowOf(sessions::LiveTab* tab) {
+  return tab ? BrowserLiveTabContext::FindContextForWebContents(
+                   &static_cast<sessions::ContentLiveTab*>(tab)->GetWebContents())
+             : nullptr;
+}
+
+// Shows a restored tab in its window.
+void Show(sessions::LiveTab* tab) {
+  tabs::TabInterface* const shown =
+      tab ? tabs::TabInterface::MaybeGetFromContents(
+                &static_cast<sessions::ContentLiveTab*>(tab)->GetWebContents())
+          : nullptr;
+  BrowserWindowInterface* const window =
+      shown ? shown->GetBrowserWindowInterface() : nullptr;
+  if (!window) {
+    return;
+  }
+  TabStripModel* const strip = window->GetTabStripModel();
+  const int index = strip->GetIndexOfTab(shown);
+  if (index != TabStripModel::kNoTab && index != strip->active_index()) {
+    strip->ActivateTabAt(index);
+  }
+}
