+// [callback, name, keyCode, ctrl, alt, shift, meta]: the keys the page
+// recorded, as keydown's keyCode, which is the key code the accelerators
+// use.
+void SteddingShortcutsHandler::HandleCheckShortcut(
+    const base::ListValue& args) {
+  if (args.size() != 7U) {
+    return;
+  }
+  AllowJavascript();
+  const stedding::shortcuts::Entry* const entry = EntryArg(args, 1);
+  const std::optional<double> key_code = args[2].GetIfDouble();
+  if (!entry || !key_code || *key_code < 1 || *key_code > 0xFF ||
+      !local_state()) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  int modifiers = 0;
+  if (args[3].GetIfBool().value_or(false)) {
+    modifiers |= ui::EF_CONTROL_DOWN;
+  }
+  if (args[4].GetIfBool().value_or(false)) {
+    modifiers |= ui::EF_ALT_DOWN;
+  }
+  if (args[5].GetIfBool().value_or(false)) {
+    modifiers |= ui::EF_SHIFT_DOWN;
+  }
+  if (args[6].GetIfBool().value_or(false)) {
+    modifiers |= ui::EF_COMMAND_DOWN;
+  }
+  const stedding::shortcuts::Chord chord(
+      static_cast<ui::KeyboardCode>(static_cast<int>(*key_code)), modifiers);
+  ResolveJavascriptCallback(
+      args[0], stedding::CheckAsValue(
+                   stedding::shortcuts::CheckShortcut(
+                       local_state(), *entry, chord,
+                       stedding::OutsideHoldersOf(chord)),
+                   chord));
+}
+
+// [callback, name, chord value, replace].
+void SteddingShortcutsHandler::HandleAddShortcut(const base::ListValue& args) {
+  if (args.size() != 4U) {
+    return;
+  }
+  AllowJavascript();
+  const stedding::shortcuts::Entry* const entry = EntryArg(args, 1);
+  const std::optional<stedding::shortcuts::Chord> chord = ChordArg(args, 2);
+  if (!entry || !chord || !local_state()) {
+    RejectJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  const bool replace = args[3].GetIfBool().value_or(false);
+  ResolveJavascriptCallback(
+      args[0], stedding::CheckAsValue(
+                   stedding::shortcuts::AddShortcut(
+                       local_state(), *entry, *chord, replace,
+                       stedding::OutsideHoldersOf(*chord)),
+                   *chord));
+}
+
+// [callback, name, chord value].
+void SteddingShortcutsHandler::HandleRemoveShortcut(
+    const base::ListValue& args) {
+  if (args.size() != 3U) {
+    return;
+  }
+  AllowJavascript();
+  const stedding::shortcuts::Entry* const entry = EntryArg(args, 1);
+  const std::optional<stedding::shortcuts::Chord> chord = ChordArg(args, 2);
+  ResolveJavascriptCallback(
+      args[0], entry && chord && local_state() &&
+                   stedding::shortcuts::RemoveShortcut(local_state(), *entry,
+                                                       *chord));
+}
+
+// [callback, name, off].
+void SteddingShortcutsHandler::HandleSetShortcutOff(
+    const base::ListValue& args) {
+  if (args.size() != 3U) {
+    return;
+  }
+  AllowJavascript();
+  const stedding::shortcuts::Entry* const entry = EntryArg(args, 1);
+  const bool off = args[2].GetIfBool().value_or(false);
+  ResolveJavascriptCallback(
+      args[0], entry && local_state() &&
+                   stedding::shortcuts::SetShortcutOff(local_state(), *entry,
+                                                       off));
+}
+
+// [callback, name].
+void SteddingShortcutsHandler::HandleResetShortcut(
+    const base::ListValue& args) {
+  if (args.size() != 2U) {
+    return;
+  }
+  AllowJavascript();
+  const stedding::shortcuts::Entry* const entry = EntryArg(args, 1);
+  ResolveJavascriptCallback(
+      args[0],
+      entry && local_state() &&
+          stedding::shortcuts::ResetShortcut(local_state(), *entry));
+}
+
+// [callback].
+void SteddingShortcutsHandler::HandleResetAllShortcuts(
+    const base::ListValue& args) {
+  if (args.size() != 1U) {
+    return;
+  }
+  AllowJavascript();
+  if (local_state()) {
+    stedding::shortcuts::ResetAllShortcuts(local_state());
+  }
+  ResolveJavascriptCallback(args[0], true);
+}
+
+// [recording]: Z19, a row starts or ends recording.
+void SteddingShortcutsHandler::HandleRecordShortcut(
+    const base::ListValue& args) {
+  if (args.size() != 1U) {
+    return;
+  }
+  if (!args[0].GetIfBool().value_or(false)) {
+    EndRecording();
+    return;
+  }
+  if (!recording_) {
+    recording_ = std::make_unique<stedding::shortcuts::ScopedShortcutRecording>(
+        web_ui()->GetWebContents());
+  }
 }
 
