+// Lf2: the live folder's setup, none of it secret: whether it is on, its
+// Space, its folder's id, the rows the person removed, and the last refresh.
+inline constexpr const char* kGitHubFolderPref =
+    stedding::prefs::kLiveFolderGitHub;
+// Lf2: the token, sealed by the system's key store (os_crypt) and base64.
+// No list of Settings' preferences names it, so no page can read it.
+inline constexpr const char* kGitHubTokenPref =
+    stedding::prefs::kLiveFolderGitHubToken;
+
+// docs/features/live-folders.md (ADR 0036, option B): a profile's live folder
+// of GitHub pull requests. Off until the person makes it with a token; then a
+// pinned folder in one Space, kept in the profile's pin store (ADR 0035) so
+// every window shows it, refreshed from api.github.com on a timer.
+class LiveFolderService : public KeyedService,
+                          public BrowserCollectionObserver,
+                          public spaces::PinStore::Observer {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // On, off, a refresh, or a failure: Settings draws again.
+    virtual void OnLiveFolderChanged() {}
+  };
+
+  // The answer to Make and ReplaceToken: kNone when it was done.
+  using MadeCallback = base::OnceCallback<void(Failure)>;
+
+  LiveFolderService(Profile* profile, spaces::PinStore* store);
+  LiveFolderService(const LiveFolderService&) = delete;
+  LiveFolderService& operator=(const LiveFolderService&) = delete;
+  ~LiveFolderService() override;
+
+  // Lf10: tests answer every request from here instead of the network.
+  static void SetURLLoaderFactoryForTesting(
+      scoped_refptr<network::SharedURLLoaderFactory> factory);
+
+  // Lf1, Lf2: makes the folder in `space` with `token`. The first list is
+  // asked for at once; the folder appears, and the token is kept, only when
+  // GitHub answers it. With the folder on, it is ReplaceToken.
+  void Make(const std::string& token,
+            const spaces::SpaceId& space,
+            MadeCallback done);
+  // Lf1: Make in the active Space of the window last in front.
+  void MakeInActiveSpace(const std::string& token, MadeCallback done);
+  // Lf2: a new token for the folder that is on, kept only when GitHub answers
+  // it. The folder, its name, icon, open or closed state and the rows the
+  // person removed stay as they are.
+  void ReplaceToken(const std::string& token, MadeCallback done);
+  // Lf4: the person's Refresh, from the folder's menu or Settings.
+  void RefreshNow();
+  // Lf8: the folder goes, the timer stops and the token is forgotten.
+  void Delete();
+  // Lf8: the person is about to take the folder itself out of the pinned run
+  // (Unpin Folder, a drop below the Clear line, Close Folder's Tabs). When its
+  // rows leave the store soon after, the folder is deleted; otherwise rows
+  // leaving only hide those pull requests.
+  void NoteFolderGoing();
+
+  bool on() const { return on_; }
+  bool making() const { return making_; }
+  const std::string& folder_id() const { return folder_id_; }
+  const spaces::SpaceId& space() const { return space_; }
+  Failure failure() const { return failure_; }
+  base::Time refreshed() const { return refreshed_; }
+  std::set<std::string> dismissed() const {
+    return std::set<std::string>(dismissed_.begin(), dismissed_.end());
+  }
+  // Lf5: `id` removed by the person, as the person's removal of its row does.
+  void DismissForTesting(const std::string& id) { Dismiss(id); }
+  // The pull requests in the folder now; the one row of an empty list is
+  // none.
+  size_t rows() const;
+  // Lf11: what Settings shows: no token, ever.
+  base::DictValue StateForSettings() const;
+  // Lf6: the folder header's tooltip.
+  std::u16string Tooltip() const;
+  const LiveFolderScheduler& scheduler_for_testing() const {
+    return scheduler_;
+  }
+  // Lf4's refresh at once, past the minute's floor, which the scheduler's own
+  // tests cover.
+  void RefreshNowForTesting() { Refresh(); }
+  bool refreshing_for_testing() const { return fetch_ != nullptr; }
+  bool has_token_for_testing() const { return !token_.empty(); }
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  struct Fetch;
+  // The merged list, and whether every search answered in full (Lf5).
+  using FetchDone = base::OnceCallback<
+      void(Failure, std::vector<PullRequest>, bool complete)>;
+
+  // BrowserCollectionObserver:
+  void OnBrowserActivated(BrowserWindowInterface* browser) override;
+
+  // spaces::PinStore::Observer:
+  void OnPinStoreChanged() override;
+
+  void Load();
+  void Save();
+  void OnEncryptorToRead(int generation,
+                         scoped_refptr<os_crypt_async::Encryptor> encryptor);
+  void OnMadeFetch(int generation,
+                   std::string token,
+                   std::optional<spaces::SpaceId> space,
+                   MadeCallback done,
+                   Failure failure,
+                   std::vector<PullRequest> pulls,
+                   bool complete);
+  void OnEncryptorToMake(int generation,
+                         std::string token,
+                         std::optional<spaces::SpaceId> space,
+                         std::vector<PullRequest> pulls,
+                         bool complete,
+                         MadeCallback done,
+                         scoped_refptr<os_crypt_async::Encryptor> encryptor);
+
+  // Lf3: the four searches with `token`; `done` gets the merged list or why
+  // there is none. A fetch already running is dropped first.
+  void StartFetch(const std::string& token, FetchDone done);
+  void OnAnswer(size_t index, std::optional<std::string> body);
+  scoped_refptr<network::SharedURLLoaderFactory> Factory();
+
+  // Lf4's beat.
+  void Refresh();
+  void OnRefreshed(int generation,
+                   Failure failure,
+                   std::vector<PullRequest> pulls,
+                   bool complete);
+
+  // Lf5: the list into the pin store, where every window takes it from.
+  void Apply(const std::vector<PullRequest>& pulls, bool complete);
+  // Lf5: the last list again, after rows were removed: an empty folder shows
+  // its one row.
+  void ApplyLast();
+  std::string FolderPath() const;
+  std::vector<std::string> LiveIdsInStore() const;
+  void RemoveRows();
+  // Lf5, Lf8: a tab that carries a live row's token and is no row any more
+  // takes a token of its own, so it is the person's from then on; asleep, with
+  // `close_asleep`, it closes instead.
+  void ReleaseLooseRows(bool close_asleep);
+  bool FolderGoing() const;
+  // Lf5: `id` into the removed rows, newest last; false when it was there.
+  bool Dismiss(const std::string& id);
+  bool IsDismissed(const std::string& id) const;
+  // Lf1: the active Space of the window last in front, or the first Space.
+  std::optional<spaces::SpaceId> ActiveSpace() const;
+  bool SpaceExists(const spaces::SpaceId& space) const;
+
+  void InstallCommandHandler();
+  void TurnOff(bool remove_rows);
+  void UpdateNote();
+  void Changed();
+  bool HasWindow() const;
+
+  const raw_ptr<Profile> profile_;
+  const raw_ptr<spaces::PinStore> store_;
+
+  bool on_ = false;
+  bool making_ = false;
+  // Bumped by Delete and Shutdown: an answer for an older one is dropped.
+  int generation_ = 0;
+  std::string folder_id_;
+  spaces::SpaceId space_ = spaces::SpaceId::CreateEmpty();
+  // In memory only, once opened; never written as it is.
+  std::string token_;
+  bool token_lost_ = false;
+  Failure failure_ = Failure::kNone;
+  base::Time refreshed_;
+  // Lf5: pull requests whose row the person removed, oldest first; not shown
+  // again while they are open. Past kMaxDismissed the oldest is forgotten.
+  std::vector<std::string> dismissed_;
+  // The live rows the store had at the last look.
+  std::set<std::string> live_ids_;
+  // The last list GitHub gave, in memory.
+  std::vector<PullRequest> last_pulls_;
+  // The folder's path as its rows last had it.
+  std::string last_folder_path_;
+  // A list waiting for the store to be filled, and whether it was complete.
+  std::optional<std::vector<PullRequest>> waiting_list_;
+  bool waiting_complete_ = false;
+  bool publishing_ = false;
+  // Lf8: until when rows leaving the store are the folder going.
+  base::TimeTicks folder_going_until_;
+
+  std::unique_ptr<Fetch> fetch_;
+  LiveFolderScheduler scheduler_;
+  base::ObserverList<Observer> observers_;
+  base::ScopedObservation<GlobalBrowserCollection, BrowserCollectionObserver>
+      browsers_observation_{this};
+  base::ScopedObservation<spaces::PinStore, spaces::PinStore::Observer>
+      store_observation_{this};
+  base::WeakPtrFactory<LiveFolderService> weak_factory_{this};
+};
+
+}  // namespace live_folders
+
+#endif  // CHROME_BROWSER_UI_LIVE_FOLDERS_LIVE_FOLDER_SERVICE_H_
