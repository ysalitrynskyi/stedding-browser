+// folders F47: a pinned folder lands at the end of that Space's pinned run and
+// stays pinned, and a plain one at the top of the rows under the line.
+TEST_F(FolderCommandsTest, MoveFolderToSpaceTakesItsPlaceThere) {
+  // The strip reads a, b, x, pin, rest.
+  tabs::TabInterface* const rest = OpenTab(GURL("https://rest.test/"));
+  tabs::TabInterface* const pin = OpenTab(GURL("https://pin.test/"));
+  tabs::TabInterface* const x = OpenTab(GURL("https://x.test/"));
+  tabs::TabInterface* const b = OpenTab(GURL("https://b.test/"));
+  tabs::TabInterface* const a = OpenTab(GURL("https://a.test/"));
+  const SpaceId work = model().AddSpace("Work", kBlue)->id();
+  model().SetSpaceForTab(pin, work);
+  model().SetSpaceForTab(rest, work);
+  model().SetSpacePinnedInPlace(pin, true);
+  tabs::FolderTabCollection* const pinned = tabs().AddToNewFolder({0, 1});
+  ASSERT_TRUE(pinned);
+  tabs::FolderTabCollection* const plain =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(x)});
+  ASSERT_TRUE(plain);
+  model().SetFolderSpacePinned(pinned, true);
+  ASSERT_TRUE(model().IsFolderSpacePinned(pinned));
+
+  model().MoveFolderToSpace(pinned, work);
+
+  EXPECT_TRUE(model().IsFolderSpacePinned(pinned)) << "the folder lost a pin";
+  EXPECT_LT(tabs().GetIndexOfTab(pin), tabs().GetIndexOfTab(a))
+      << "not at the end of the run";
+  EXPECT_LT(tabs().GetIndexOfTab(b), tabs().GetIndexOfTab(rest))
+      << "under the line";
+
+  model().MoveFolderToSpace(plain, work);
+
+  EXPECT_FALSE(model().IsSpacePinned(x));
+  EXPECT_LT(tabs().GetIndexOfTab(b), tabs().GetIndexOfTab(x)) << "in the run";
+  EXPECT_LT(tabs().GetIndexOfTab(x), tabs().GetIndexOfTab(rest))
+      << "not at the top of the rows under the line";
+}
