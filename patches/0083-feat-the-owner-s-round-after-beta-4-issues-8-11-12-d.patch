+  EXPECT_TRUE(ShowsTheCheckMark(button));
+  const std::u16string clean = base::UTF8ToUTF16(
+      embedded_test_server()->GetURL("shop.test", "/empty.html?item=7").spec());
+  EXPECT_EQ(u"[shop.test](" + clean + u")", ClipboardText());
+}
+
+// copy-link L7: only a page with a web address has the button. The new tab
+// page, a browser page, a page's source and about:blank have none, and the
+// button comes back with the next web page.
+IN_PROC_BROWSER_TEST_F(CopyLinkTest, TheButtonIsOnlyOnWebPages) {
+  const GURL page = embedded_test_server()->GetURL("a.test", "/title1.html");
+  for (const GURL& elsewhere :
