+        HostContentSettingsMapFactory::GetForProfile(browser()->GetProfile());
+    ASSERT_EQ(CONTENT_SETTING_ASK,
+              settings->GetContentSetting(
+                  local, local, ContentSettingsType::MEDIASTREAM_CAMERA));
