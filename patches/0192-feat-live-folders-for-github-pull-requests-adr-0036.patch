+
+namespace live_folders {
+
+namespace {
+
+scoped_refptr<net::HttpResponseHeaders> Headers(const std::string& raw) {
+  return base::MakeRefCounted<net::HttpResponseHeaders>(
+      net::HttpUtil::AssembleRawHeaders(raw));
+}
+
+}  // namespace
+
+// Lf3: four searches, each to api.github.com, each open pull requests of
+// unarchived repositories, one per way a pull request is the person's.
+TEST(LiveFolderAnswerTest, TheFourSearchesAskGitHubAlone) {
+  const std::vector<GURL> urls = SearchUrls();
+  ASSERT_EQ(4u, urls.size());
+  std::vector<std::string> who;
+  for (const GURL& url : urls) {
+    EXPECT_EQ("https", url.scheme());
+    EXPECT_EQ("api.github.com", url.host());
+    EXPECT_EQ("/search/issues", url.path());
+    std::string q;
+    ASSERT_TRUE(net::GetValueForKeyInQuery(url, "q", &q));
+    EXPECT_TRUE(q.starts_with("is:pr is:open archived:false ")) << q;
+    who.push_back(q.substr(q.rfind(' ') + 1));
+    std::string per_page;
+    ASSERT_TRUE(net::GetValueForKeyInQuery(url, "per_page", &per_page));
+    EXPECT_EQ("50", per_page);
+  }
+  EXPECT_EQ((std::vector<std::string>{"author:@me", "assignee:@me",
+                                      "review-requested:@me", "mentions:@me"}),
+            who);
+}
+
+// Lf3: the token goes in Authorization, as a bearer token, with GitHub's
+// media type and API version.
+TEST(LiveFolderAnswerTest, EachSearchCarriesTheTokenAndTheVersion) {
+  net::HttpRequestHeaders headers;
+  SetRequestHeaders("github_pat_abc123", &headers);
+  EXPECT_EQ("Bearer github_pat_abc123",
+            headers.GetHeader("Authorization").value_or(""));
+  EXPECT_EQ("application/vnd.github+json",
+            headers.GetHeader("Accept").value_or(""));
+  EXPECT_EQ("2022-11-28",
+            headers.GetHeader("X-GitHub-Api-Version").value_or(""));
+  EXPECT_FALSE(headers.HasHeader("Cookie"));
+}
+
+// Lf3, Lf10: what a recorded answer holds is what is read.
+TEST(LiveFolderAnswerTest, TheRecordedAnswerIsReadAsItIs) {
+  const std::optional<std::vector<PullRequest>> pulls =
+      ParseSearchAnswer(recorded::kAuthored);
+  ASSERT_TRUE(pulls);
+  ASSERT_EQ(2u, pulls->size());
+  EXPECT_EQ(recorded::kRocket42, (*pulls)[0].node_id);
+  EXPECT_EQ("acme/rocket", (*pulls)[0].repo);
+  EXPECT_EQ("Make the launch window configurable", (*pulls)[0].title);
+  EXPECT_EQ(GURL("https://github.com/acme/rocket/pull/42"), (*pulls)[0].url);
+  EXPECT_EQ(u"acme/rocket: Make the launch window configurable",
+            RowName((*pulls)[0]));
+  EXPECT_EQ(recorded::kFuel7, (*pulls)[1].node_id);
+  EXPECT_EQ("acme/fuel", (*pulls)[1].repo);
+}
+
+// Lf3: an issue, an address that is not a pull request on github.com, and a
+// closed one are left out; what is no search answer is none.
+TEST(LiveFolderAnswerTest, WhatIsNoOpenPullRequestIsLeftOut) {
+  const std::optional<std::vector<PullRequest>> pulls =
+      ParseSearchAnswer(recorded::kReviewRequested);
+  ASSERT_TRUE(pulls);
+  ASSERT_EQ(1u, pulls->size());
+  EXPECT_EQ(recorded::kRocket45, (*pulls)[0].node_id);
+
+  const std::optional<std::vector<PullRequest>> odd = ParseSearchAnswer(R"({
+    "items": [
+      {"node_id": "PR_a", "title": "elsewhere", "state": "open",
+       "html_url": "https://evil.example/acme/rocket/pull/1",
+       "pull_request": {}},
+      {"node_id": "PR_b", "title": "plain http", "state": "open",
+       "html_url": "http://github.com/acme/rocket/pull/2",
+       "pull_request": {}},
+      {"node_id": "PR_c", "title": "closed", "state": "closed",
+       "html_url": "https://github.com/acme/rocket/pull/3",
+       "pull_request": {}},
+      {"node_id": "PR d", "title": "odd id", "state": "open",
+       "html_url": "https://github.com/acme/rocket/pull/4",
+       "pull_request": {}},
+      {"node_id": "PR_e", "title": "a commit page", "state": "open",
+       "html_url": "https://github.com/acme/rocket/commit/5",
+       "pull_request": {}}
+    ]})");
+  ASSERT_TRUE(odd);
+  EXPECT_TRUE(odd->empty());
+
+  EXPECT_FALSE(ParseSearchAnswer(recorded::kBadCredentials));
+  EXPECT_FALSE(ParseSearchAnswer("not json"));
+  EXPECT_TRUE(ParseSearchAnswer(recorded::kNothing).value().empty());
+}
+
+// Lf3: the four answers make one list, each pull request once, newest first.
+TEST(LiveFolderAnswerTest, TheFourAnswersMakeOneListNewestFirst) {
+  const std::vector<PullRequest> merged = MergeAnswers({
+      ParseSearchAnswer(recorded::kAuthored).value(),
+      ParseSearchAnswer(recorded::kNothing).value(),
+      ParseSearchAnswer(recorded::kReviewRequested).value(),
+      ParseSearchAnswer(recorded::kMentioned).value(),
+  });
+  ASSERT_EQ(3u, merged.size());
+  EXPECT_EQ(recorded::kRocket45, merged[0].node_id);
+  EXPECT_EQ(recorded::kRocket42, merged[1].node_id);
+  EXPECT_EQ(recorded::kFuel7, merged[2].node_id);
+}
+
+// Lf3: never more than kMaxRows rows.
+TEST(LiveFolderAnswerTest, TheListStopsAtFiftyRows) {
+  std::vector<PullRequest> many;
+  for (int i = 0; i < 80; ++i) {
+    PullRequest pull;
+    pull.node_id = "PR_" + std::to_string(i);
+    pull.created_at = "2026-11-" + std::to_string(10 + i % 10);
+    many.push_back(pull);
+  }
+  EXPECT_EQ(kMaxRows, MergeAnswers({many}).size());
+}
+
+// Lf7: each reason the tooltip gives.
+TEST(LiveFolderAnswerTest, AFailedRequestSaysWhy) {
+  EXPECT_EQ(Failure::kNone, FailureOf(net::OK, 200, nullptr));
+  EXPECT_EQ(Failure::kToken, FailureOf(net::OK, 401, nullptr));
+  EXPECT_EQ(Failure::kRateLimit,
+            FailureOf(net::OK, 403,
+                      Headers("HTTP/1.1 403 Forbidden\n"
+                              "x-ratelimit-remaining: 0\n\n")
+                          .get()));
+  EXPECT_EQ(Failure::kRateLimit,
+            FailureOf(net::OK, 403,
+                      Headers("HTTP/1.1 403 Forbidden\nretry-after: 60\n\n")
+                          .get()));
+  EXPECT_EQ(Failure::kRateLimit, FailureOf(net::OK, 429, nullptr));
+  EXPECT_EQ(Failure::kToken,
+            FailureOf(net::OK, 403,
+                      Headers("HTTP/1.1 403 Forbidden\n"
+                              "x-ratelimit-remaining: 12\n\n")
+                          .get()));
+  EXPECT_EQ(Failure::kNetwork,
+            FailureOf(net::ERR_INTERNET_DISCONNECTED, 0, nullptr));
+  EXPECT_EQ(Failure::kNetwork, FailureOf(net::ERR_NAME_NOT_RESOLVED, 0, nullptr));
+  EXPECT_EQ(Failure::kServer, FailureOf(net::OK, 502, nullptr));
+  for (Failure failure : {Failure::kToken, Failure::kRateLimit,
+                          Failure::kNetwork, Failure::kServer,
+                          Failure::kKeyStore}) {
+    EXPECT_FALSE(FailureText(failure).empty());
+  }
+  EXPECT_NE(std::u16string::npos,
+            FailureText(Failure::kToken).find(u"expired"));
+  EXPECT_NE(std::u16string::npos,
+            FailureText(Failure::kRateLimit).find(u"rate limit"));
+  EXPECT_NE(std::u16string::npos,
+            FailureText(Failure::kNetwork).find(u"network"));
+}
+
+// Lf9: sync knows a live row by its token alone.
+TEST(LiveFolderAnswerTest, ALiveRowIsKnownByItsToken) {
+  EXPECT_TRUE(IsLiveRowToken("livegh-PR_kwDOAAAAAA42"));
+  EXPECT_FALSE(IsLiveRowToken("3f2c0c1e-0000-4000-8000-000000000000"));
+  EXPECT_FALSE(IsLiveRowToken(""));
+}
+
+// Lf1: a paste that cannot be a token is refused before any request.
+TEST(LiveFolderAnswerTest, APasteThatIsNoTokenIsRefused) {
+  EXPECT_TRUE(LooksLikeAToken("github_pat_11ABC_def123"));
+  EXPECT_TRUE(LooksLikeAToken("ghp_0123456789abc"));
+  EXPECT_FALSE(LooksLikeAToken(""));
+  EXPECT_FALSE(LooksLikeAToken("ghp_abc def"));
+  EXPECT_FALSE(LooksLikeAToken("Bearer ghp_abc"));
+  EXPECT_FALSE(LooksLikeAToken("ghp_abc\n"));
+  EXPECT_FALSE(LooksLikeAToken("ghp-abc"));
+  EXPECT_FALSE(LooksLikeAToken("https://github.com/settings/tokens"));
+  EXPECT_FALSE(LooksLikeAToken(std::string(256, 'a')));
+  EXPECT_TRUE(LooksLikeAToken(std::string(255, 'a')));
+}
+
+// Lf3: an old pull request's node id, base64 with '=' at its end, is kept.
+TEST(LiveFolderAnswerTest, AnOldNodeIdIsKept) {
+  EXPECT_TRUE(IsNodeId(recorded::kLegacy1));
+  EXPECT_TRUE(IsNodeId("MDEwOlJlcG9zaXRvcnkxMjk2MjY5"));
+  EXPECT_TRUE(IsNodeId("a+b/c=="));
+  EXPECT_FALSE(IsNodeId("PR d"));
+  EXPECT_FALSE(IsNodeId("PR_\"x"));
+  EXPECT_FALSE(IsNodeId(""));
+  const std::optional<std::vector<PullRequest>> pulls =
+      ParseSearchAnswer(recorded::kAssignedLegacy);
+  ASSERT_TRUE(pulls);
+  ASSERT_EQ(1u, pulls->size());
+  EXPECT_EQ(recorded::kLegacy1, (*pulls)[0].node_id);
+  EXPECT_EQ("acme/legacy", (*pulls)[0].repo);
+}
+
+// Lf3: a redirect anywhere but api.github.com loses the Authorization header.
+TEST(LiveFolderAnswerTest, ARedirectOffGitHubDropsTheToken) {
+  EXPECT_FALSE(DropsAuthorizationOnRedirectTo(
+      GURL("https://api.github.com/search/issues?q=x")));
+  EXPECT_TRUE(DropsAuthorizationOnRedirectTo(
+      GURL("https://github.com/search/issues")));
+  EXPECT_TRUE(DropsAuthorizationOnRedirectTo(
+      GURL("http://api.github.com/search/issues")));
+  EXPECT_TRUE(DropsAuthorizationOnRedirectTo(
+      GURL("https://api.github.com.evil.example/")));
+  EXPECT_TRUE(DropsAuthorizationOnRedirectTo(
+      GURL("https://api.github.com:8443/")));
+  EXPECT_TRUE(DropsAuthorizationOnRedirectTo(
+      GURL("https://objects.githubusercontent.com/x")));
+}
+
+// Lf5: an answer says whether it holds every match, and the merged list
+// whether rows were cut: only then is a removed row forgotten.
+TEST(LiveFolderAnswerTest, AnAnswerSaysWhetherItHoldsEveryMatch) {
+  bool complete = false;
+  ASSERT_TRUE(ParseSearchAnswer(recorded::kAuthored, &complete));
+  EXPECT_TRUE(complete);
+  ASSERT_TRUE(ParseSearchAnswer(recorded::kMentionedPastThePage, &complete));
+  EXPECT_FALSE(complete) << "75 matches, one on the page";
+  ASSERT_TRUE(ParseSearchAnswer(
+      R"({"total_count": 1, "incomplete_results": true, "items": [{}]})",
+      &complete));
+  EXPECT_FALSE(complete) << "GitHub said it was cut short";
+  ASSERT_TRUE(ParseSearchAnswer(R"({"items": []})", &complete));
+  EXPECT_FALSE(complete) << "no count, no claim to be whole";
+
+  std::vector<PullRequest> many;
+  for (int i = 0; i < 51; ++i) {
+    PullRequest pull;
+    pull.node_id = "PR_" + std::to_string(i);
+    many.push_back(pull);
+  }
+  bool capped = false;
+  MergeAnswers({many}, &capped);
+  EXPECT_TRUE(capped);
+  many.pop_back();
+  MergeAnswers({many}, &capped);
+  EXPECT_FALSE(capped);
+}
+
+class LiveFolderSchedulerTest : public testing::Test {
+ protected:
+  LiveFolderSchedulerTest()
+      : scheduler_(base::BindRepeating(&LiveFolderSchedulerTest::OnRefresh,
+                                       base::Unretained(this)),
+                   base::BindRepeating(
+                       [](const bool* window) { return *window; },
+                       base::Unretained(&window_))) {}
+
+  void OnRefresh() { ++refreshes_; }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  bool window_ = true;
+  int refreshes_ = 0;
+  LiveFolderScheduler scheduler_;
+};
+
+// Lf4: never more than once a minute. An ask within the minute waits for
+// it, and many asks in the wait make one refresh.
+TEST_F(LiveFolderSchedulerTest, NeverMoreThanOnceAMinute) {
+  scheduler_.Start(/*ran_now=*/true);
+  EXPECT_EQ(0, refreshes_);
+  task_environment_.FastForwardBy(base::Seconds(10));
+  scheduler_.Ask();
+  scheduler_.Ask();
+  EXPECT_EQ(0, refreshes_);
+  EXPECT_TRUE(scheduler_.waiting());
+  task_environment_.FastForwardBy(base::Seconds(49));
+  EXPECT_EQ(0, refreshes_);
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(1, refreshes_);
+  // A minute after that one, an ask runs at once.
+  task_environment_.FastForwardBy(base::Minutes(1));
+  scheduler_.Ask();
+  EXPECT_EQ(2, refreshes_);
+  // Asks every few seconds for five minutes: at most one a minute.
+  for (int i = 0; i < 100; ++i) {
+    scheduler_.Ask();
+    task_environment_.FastForwardBy(base::Seconds(3));
+  }
+  EXPECT_LE(refreshes_, 2 + 5);
+  EXPECT_GE(refreshes_, 2 + 4);
+}
+
+// Lf4: every 10 minutes while a window is open, and not while none is.
+TEST_F(LiveFolderSchedulerTest, TheBeatIsTenMinutesWhileAWindowIsOpen) {
+  scheduler_.Start(/*ran_now=*/true);
+  task_environment_.FastForwardBy(base::Minutes(10) - base::Seconds(1));
+  EXPECT_EQ(0, refreshes_);
+  task_environment_.FastForwardBy(base::Seconds(1));
+  EXPECT_EQ(1, refreshes_);
+  task_environment_.FastForwardBy(base::Minutes(30));
+  EXPECT_EQ(4, refreshes_);
+  window_ = false;
+  task_environment_.FastForwardBy(base::Minutes(60));
+  EXPECT_EQ(4, refreshes_);
+  window_ = true;
+  task_environment_.FastForwardBy(base::Minutes(10));
+  EXPECT_EQ(5, refreshes_);
+}
+
+// Lf8: stopped, nothing runs: not the beat, not an ask, not one that waited.
+TEST_F(LiveFolderSchedulerTest, StoppedItRunsNothing) {
+  scheduler_.Ask();
+  EXPECT_EQ(0, refreshes_) << "an ask before Start ran";
+  scheduler_.Start(/*ran_now=*/true);
+  scheduler_.Ask();
+  EXPECT_TRUE(scheduler_.waiting());
+  scheduler_.Stop();
+  task_environment_.FastForwardBy(base::Hours(2));
+  scheduler_.Ask();
+  EXPECT_EQ(0, refreshes_);
+}
+
+}  // namespace live_folders
