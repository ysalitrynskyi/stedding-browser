+// P18-1f, pins H1: the same pin moved to another window while its first load
+// runs -- committed on the page the site sent it to, not finished -- keeps
+// the mark that this load is still to settle its home, and settles there
+// when the load ends. The mark was dropped once anything had committed, so
+// the redirect that load followed read as drift.
+TEST_F(PinHomeB16Test, APinMovedToAnotherWindowMidLoadSettlesThere) {
+  const GURL front("https://example.com/");
+  const GURL deeper("https://example.com/deeper");
+  tabs::TabInterface* const imported = ImportPin(front);
+  ASSERT_TRUE(imported);
+  ASSERT_EQ(std::optional<GURL>(front), model().HomeUrl(imported));
+  OpenTab(GURL("https://example.org/"));
+
+  // Its first load is sent on to the deeper page, commits there, and is
+  // still loading.
+  std::unique_ptr<content::NavigationSimulator> load =
+      content::NavigationSimulator::CreateBrowserInitiated(
+          front, imported->GetContents());
+  load->SetKeepLoading(true);
+  load->Start();
+  load->Redirect(deeper);
+  load->Commit();
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(deeper, imported->GetContents()->GetLastCommittedURL());
+  ASSERT_TRUE(imported->GetContents()->IsLoading());
+  ASSERT_EQ(std::optional<GURL>(front), model().HomeUrl(imported))
+      << "the home settled before its first load ended";
+
+  std::unique_ptr<BrowserWindowInterface> second =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  SpaceModel* const other = SpaceModel::From(second.get());
+  ASSERT_TRUE(other);
+  std::unique_ptr<tabs::TabModel> moving =
+      tabs().DetachTabAtForInsertion(IndexOf(imported));
+  ASSERT_TRUE(moving);
+  second->GetTabStripModel()->InsertDetachedTabAt(0, std::move(moving),
+                                                  AddTabTypes::ADD_ACTIVE);
+  tabs::TabInterface* const moved =
+      second->GetTabStripModel()->GetTabAtIndex(0);
+  ASSERT_TRUE(moved);
+  ASSERT_TRUE(other->IsSpacePinned(moved));
+  ASSERT_EQ(std::optional<GURL>(front), other->HomeUrl(moved));
+  ASSERT_TRUE(moved->GetContents()->IsLoading());
+
+  // The load ends in the window the pin went to.
+  load->StopLoading();
+  task_environment()->RunUntilIdle();
+  load.reset();
+  ASSERT_FALSE(moved->GetContents()->IsLoading());
+  ASSERT_EQ(deeper, moved->GetContents()->GetLastCommittedURL());
+  EXPECT_EQ(std::optional<GURL>(deeper), other->HomeUrl(moved))
+      << "the pin moved mid-load kept the address from before the redirect";
+  EXPECT_FALSE(stedding::HasDriftedFromHome(
+      other->HomeUrl(moved).value_or(front),
+      moved->GetContents()->GetLastCommittedURL()));
+  second->GetTabStripModel()->CloseAllTabs();
+}
