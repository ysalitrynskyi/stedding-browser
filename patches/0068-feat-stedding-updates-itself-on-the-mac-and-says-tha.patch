+std::optional<std::string>& VersionForTesting() {
+  static base::NoDestructor<std::optional<std::string>> version;
+  return *version;
+}
+
+// A number of the version: digits only, no sign, no space.
+std::optional<int> ParsePart(std::string_view part) {
+  if (part.empty() || part.size() > 6 ||
+      part.find_first_not_of("0123456789") != std::string_view::npos) {
+    return std::nullopt;
+  }
+  int value = 0;
+  if (!base::StringToInt(part, &value)) {
+    return std::nullopt;
+  }
+  return value;
+}
+
+// The order of two versions: the release after every beta of it.
+auto OrderOf(const SteddingVersionNumber& version) {
+  return std::make_tuple(
+      version.major, version.minor, version.patch,
+      version.beta == 0 ? std::numeric_limits<int>::max() : version.beta);
+}
