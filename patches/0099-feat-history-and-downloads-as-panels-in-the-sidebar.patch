+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_STEDDING_LIBRARY_STEDDING_LIBRARY_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_STEDDING_LIBRARY_STEDDING_LIBRARY_HANDLER_H_
+
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+class BrowserWindowInterface;
+
+namespace download {
+class DownloadItem;
+}  // namespace download
+
+namespace stedding {
+
+// The verbs of the sidebar's panels that Chromium's History and Downloads
+// handlers lack (docs/features/sidebar-panels.md):
+//   openUrl(url, how)                 Pn7: how is "current", "background"
+//                                     or "window"
+//   copyFile(callback, id) -> bool    Pn10
+//   moveToTrash(callback, id) -> bool Pn11
+//   closePanel()                      Pn5
+//   openAsPage(kind, query)           Pn5, Pn12: kind is "history" or
+//                                     "downloads"
+//   rangeStart(callback, name)        Pn6 -> milliseconds since the epoch,
+//                                     or null for All
+// A message of the wrong shape is dropped: the page is a renderer.
+class LibraryHandler : public content::WebUIMessageHandler {
+ public:
+  LibraryHandler();
+  LibraryHandler(const LibraryHandler&) = delete;
+  LibraryHandler& operator=(const LibraryHandler&) = delete;
+  ~LibraryHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  // The window the panel is in, or null.
+  BrowserWindowInterface* GetBrowser();
+  // A finished download whose file the page may act on, or null.
+  download::DownloadItem* FinishedDownload(const base::Value& id);
+
+  void HandleOpenUrl(const base::ListValue& args);
+  void HandleCopyFile(const base::ListValue& args);
+  void HandleMoveToTrash(const base::ListValue& args);
+  void HandleClosePanel(const base::ListValue& args);
+  void HandleOpenAsPage(const base::ListValue& args);
+  void HandleRangeStart(const base::ListValue& args);
+
+  void OnMovedToTrash(std::string callback_id, bool moved);
+
+  base::WeakPtrFactory<LibraryHandler> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_WEBUI_STEDDING_LIBRARY_STEDDING_LIBRARY_HANDLER_H_
