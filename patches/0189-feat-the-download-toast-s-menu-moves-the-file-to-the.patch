@@ -33,6 +33,20 @@ class DownloadUiContextMenu : public ui::SimpleMenuModel::Delegate {
   // Called when download is destroyed.
   void OnDownloadDestroyed();
 
+  // Stedding (sidebar-panels Pn19; GitHub discussion 116): the Downloads
+  // panel's verbs on a finished download (Pn9, Pn11) in the downloads
+  // bubble's menu too, so the toast a new download shows can put the file in
+  // the Trash or take it off the list, as Arc's did. Ids outside
+  // DownloadCommands, which the bubble's metrics count.
+  static constexpr int kSteddingMoveToTrash = 0x5354;
+  static constexpr int kSteddingRemoveFromList = 0x5355;
+  // Whether `command_id` is one of these: not a DownloadCommands value, so
+  // nothing that counts or indexes those may take it.
+  static bool IsSteddingCommand(int command_id) {
+    return command_id == kSteddingMoveToTrash ||
+           command_id == kSteddingRemoveFromList;
+  }
+
  protected:
   explicit DownloadUiContextMenu(base::WeakPtr<DownloadUIModel> download);
 
