+
+namespace {
+
+// The page each window of the step before pins, in the windows' order.
+constexpr const char* kPagesW2B12[] = {"/title1.html", "/title2.html",
+                                       "/title3.html"};
+
+class PinsBackupW2B12Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpInProcessBrowserTestFixture() override {
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::SetUpInProcessBrowserTestFixture();
+    // windows G19: the step before the first launch is a version without the
+    // store, whose windows each keep their own pins.
+    const std::string name =
+        testing::UnitTest::GetInstance()->current_test_info()->name();
+    spaces::PinMirror::SetDisabledForTesting(base::StartsWith(name, "PRE_"));
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  spaces::PinStore& Store() {
+    spaces::PinStore* const store =
+        spaces::PinStoreFactory::GetForProfile(browser()->GetProfile());
+    CHECK(store);
+    return *store;
+  }
+
+  // A page opened in `window` and made a Space pin there.
+  void PinPage(BrowserWindowInterface* window, const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        window, url, WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const tab = window->GetTabStripModel()->GetActiveTab();
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+    ASSERT_TRUE(model);
+    model->SetSpacePinned(tab, true);
+    base::RunLoop().RunUntilIdle();
+  }
+
+  BrowserWindowInterface* OpenWindow() {
+    ui_test_utils::BrowserCreatedObserver opened;
+    chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+    BrowserWindowInterface* const window = opened.Wait();
+    EXPECT_TRUE(window);
+    base::RunLoop().RunUntilIdle();
+    return window;
+  }
+
+  std::vector<base::FilePath> Backups() {
+    base::ScopedAllowBlockingForTesting allow;
+    return spaces::sidebar_sync::ListBackups(
+        browser()->GetProfile()->GetPath());
+  }
+};
+
+// P14-1a, windows G19: three windows, each with a pin of its own, before the
+// store.
+IN_PROC_BROWSER_TEST_F(PinsBackupW2B12Test,
+                       PRE_EveryWindowsSidebarHasABackupOfItsOwn) {
+  SessionStartupPref::SetStartupPref(
+      browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  PinPage(browser(), embedded_test_server()->GetURL(kPagesW2B12[0]));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(second);
+  PinPage(second, embedded_test_server()->GetURL(kPagesW2B12[1]));
+  BrowserWindowInterface* const third = OpenWindow();
+  ASSERT_TRUE(third);
+  PinPage(third, embedded_test_server()->GetURL(kPagesW2B12[2]));
+  EXPECT_FALSE(Store().ready());
+  EXPECT_TRUE(Backups().empty());
+}
+
+// P14-1a, windows G19: the first launch with the store backs up each of the
+// three windows before the merge. The backups were written at once, in the
+// same second: two found the same name free, and the later replaced the
+// earlier, so a window's sidebar had no backup.
+IN_PROC_BROWSER_TEST_F(PinsBackupW2B12Test,
+                       EveryWindowsSidebarHasABackupOfItsOwn) {
+  ASSERT_TRUE(base::test::RunUntil([&] { return Store().ready(); }))
+      << "the store was never filled";
+  ASSERT_EQ(3u,
+            spaces::sidebar_sync::RegistryWindows(browser()->GetProfile())
+                .size());
+  // The backups are written on the thread pool.
+  base::ThreadPoolInstance::Get()->FlushForTesting();
+  const std::vector<base::FilePath> backups = Backups();
+  EXPECT_EQ(3u, backups.size()) << "a window's backup replaced another's";
+  // Each window's own pin is in a backup. The test server's port is new
+  // after a restart: the path is the page.
+  base::ScopedAllowBlockingForTesting allow;
+  for (const char* page : kPagesW2B12) {
+    const auto holds_page = [page](const base::FilePath& path) {
+      std::string json;
+      return base::ReadFileToString(path, &json) &&
+             json.find(page) != std::string::npos;
+    };
+    EXPECT_TRUE(std::ranges::any_of(backups, holds_page))
+        << page << " is in no backup";
+  }
+}
+
+}  // namespace
