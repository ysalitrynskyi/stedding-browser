+// import I35, I36: the archive Safari writes, read by the Rust reader: its
+// bookmarks (Favorites in their folder), history, passwords and the fact of
+// payment cards, which are never read.
+TEST_F(SafariExportImporterPrepareTest, ReadsTheExportArchive) {
+  std::unique_ptr<SafariExportImporter> importer = MakeImporter();
+  const SafariExportSummary summary =
+      Prepare(*importer, Archive("valid_test_archive.zip"));
+  EXPECT_TRUE(summary.opened);
+  EXPECT_EQ(5u, summary.bookmarks);
+  EXPECT_TRUE(summary.history);
+  EXPECT_EQ(4u, summary.passwords);
+  EXPECT_TRUE(summary.cards);
+  EXPECT_TRUE(importer->prepared());
+  size_t in_favorites = 0;
+  for (const user_data_importer::ImportedBookmarkEntry& entry :
+       importer->bookmarks()) {
+    if (!entry.is_folder && entry.path == std::vector<std::u16string>{
+                                              u"Favorites"}) {
+      ++in_favorites;
+    }
+  }
+  EXPECT_EQ(4u, in_favorites);
+}
