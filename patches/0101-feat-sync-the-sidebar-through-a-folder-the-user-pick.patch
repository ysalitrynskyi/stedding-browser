+#include <windows.h>
+#elif BUILDFLAG(IS_POSIX)
+#include <sys/stat.h>
+#endif
+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+constexpr size_t kInstallIdLength = 16;
+constexpr char kBlockKey[] = "stedding_sync";
+constexpr std::string_view kJsonSuffix = ".json";
+
+std::optional<int64_t> WholeNumber(const base::DictValue& dict,
+                                   std::string_view key) {
+  const std::optional<double> number = dict.FindDouble(key);
+  if (!number || !std::isfinite(*number) || std::trunc(*number) != *number ||
+      std::fabs(*number) > 9007199254740991.0) {
+    return std::nullopt;
+  }
+  return static_cast<int64_t>(*number);
+}
+
+bool IsSpaceId(const std::string& id) {
+  return base::Token::FromString(id).has_value();
+}
+
+bool IsTabId(const std::string& id) {
+  return !TokenOf(id).empty();
+}
+
+bool IsFolderId(const std::string& id) {
+  return FolderIdOf(id).has_value();
+}
+
+// A container a record may sit in (sidebar_sync_state.h).
+bool IsContainer(const std::string& container, bool folder_child) {
+  if (IsFolderId(container)) {
+    return true;
+  }
+  const std::string space = SpaceOfList(container);
+  if (!space.empty() && IsSpaceId(space)) {
+    if (container == PinsListOf(space)) {
+      return true;
+    }
+    return !folder_child && container == OwnEssentialsListOf(space);
+  }
+  return !folder_child && container == kEssentialsList;
+}
+
+bool IsAnyId(const std::string& id) {
+  return IsSpaceId(id) || IsTabId(id) || IsFolderId(id);
+}
+
+// Sf33: every record, list and alias checked; a home that is no web page
+// dropped. False refuses the whole file.
+bool Validate(State& state) {
+  if (state.records.size() > kMaxRecords) {
+    return false;
+  }
+  for (auto& [id, record] : state.records) {
+    if (id.size() > kMaxTextLength) {
+      return false;
+    }
+    switch (record.kind) {
+      case Kind::kSpace:
+        if (!IsSpaceId(id)) {
+          return false;
+        }
+        break;
+      case Kind::kTab:
+        if (!IsTabId(id)) {
+          return false;
+        }
+        break;
+      case Kind::kFolder:
+        if (!IsFolderId(id)) {
+          return false;
+        }
+        break;
+    }
+    for (auto& [name, field] : record.f) {
+      const size_t limit =
+          name == kFieldHome ? kMaxUrlLength : kMaxTextLength;
+      if (name.size() > kMaxTextLength || field.v.size() > limit ||
+          field.s.w.size() > kMaxTextLength) {
+        return false;
+      }
+    }
+    if (record.kind == Kind::kTab) {
+      if (auto home = record.f.find(kFieldHome); home != record.f.end()) {
+        if (!stedding::IsAllowedPinHome(GURL(home->second.v))) {
+          record.f.erase(home);
+        }
+      }
+    }
+    if (record.kind != Kind::kSpace) {
+      const std::string& parent = record.Get(kFieldParent);
+      if (!parent.empty() &&
+          !IsContainer(parent, record.kind == Kind::kFolder)) {
+        return false;
+      }
+    }
+  }
+  // No folder is its own ancestor, and none nests past the sidebar's depth.
+  for (const auto& [id, record] : state.records) {
+    if (record.kind != Kind::kFolder) {
+      continue;
+    }
+    std::set<std::string> seen{id};
+    std::string up = record.Get(kFieldParent);
+    int depth = 1;
+    while (IsFolderId(up)) {
+      if (!seen.insert(up).second || ++depth > stedding::kMaxNestDepth) {
+        return false;
+      }
+      const auto parent = state.records.find(up);
+      if (parent == state.records.end()) {
+        break;
+      }
+      up = parent->second.Get(kFieldParent);
+    }
+  }
+  for (const auto& [container, list] : state.lists) {
+    if (container != kSpacesList && !IsContainer(container, false)) {
+      return false;
+    }
+    if (list.order.size() > kMaxRecords) {
+      return false;
+    }
+    std::set<std::string> ids;
+    for (const std::string& id : list.order) {
+      if (!ids.insert(id).second || !IsAnyId(id)) {
+        return false;
+      }
+    }
+  }
+  for (const auto& [from, to] : state.aliases) {
+    if (!IsAnyId(from) || !IsAnyId(to)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+ArcImportPlan::Node NodeFor(const State& state, const std::string& id) {
+  const Record& record = state.records.at(id);
+  ArcImportPlan::Node node;
+  node.arc_id = id;
+  if (record.kind == Kind::kFolder) {
+    node.kind = ArcImportPlan::Node::Kind::kFolder;
+    node.title = base::UTF8ToUTF16(record.Get(kFieldTitle));
+    for (const std::string& child : state.ChildrenOf(id)) {
+      const Record& child_record = state.records.at(child);
+      if (child_record.kind == Kind::kTab &&
+          child_record.Get(kFieldHome).empty()) {
+        continue;
+      }
+      node.children.push_back(NodeFor(state, child));
+    }
+    return node;
+  }
+  node.kind = ArcImportPlan::Node::Kind::kTab;
+  node.url = GURL(record.Get(kFieldHome));
+  // The user's name for the pin, else its address until the page loads.
+  node.title = base::UTF8ToUTF16(record.Get(kFieldName).empty()
+                                     ? record.Get(kFieldHome)
+                                     : record.Get(kFieldName));
+  return node;
+}
+
+std::vector<ArcImportPlan::Node> NodesOf(const State& state,
+                                         const std::string& container) {
+  std::vector<ArcImportPlan::Node> nodes;
+  for (const std::string& id : state.ChildrenOf(container)) {
+    const Record& record = state.records.at(id);
+    if (record.kind == Kind::kSpace ||
+        (record.kind == Kind::kTab && record.Get(kFieldHome).empty())) {
+      continue;
+    }
+    nodes.push_back(NodeFor(state, id));
+  }
+  return nodes;
+}
+
+}  // namespace
+
+bool IsInstallId(std::string_view id) {
+  return id.size() == kInstallIdLength &&
+         std::ranges::all_of(id, [](char c) {
+           return base::IsAsciiDigit(c) || (c >= 'a' && c <= 'f');
+         });
+}
+
+std::string MakeInstallId() {
+  return base::HexEncodeLower(base::RandBytesAsString(kInstallIdLength / 2));
+}
+
+std::string FileNameFor(std::string_view install) {
+  return std::string(kFilePrefix) + std::string(install) +
+         std::string(kJsonSuffix);
+}
+
+std::string DefaultDeviceName(std::string_view install) {
+#if BUILDFLAG(IS_MAC)
+  constexpr char kKind[] = "Mac";
+#elif BUILDFLAG(IS_WIN)
+  constexpr char kKind[] = "Windows PC";
+#else
+  constexpr char kKind[] = "Computer";
+#endif
+  return base::StringPrintf(
+      "%s %s", kKind,
+      base::ToUpperASCII(install.substr(0, std::min<size_t>(4, install.size())))
+          .c_str());
+}
+
+base::FilePath SyncDirFor(const base::FilePath& picked,
+                          bool picked_holds_sidebar_files) {
+  if (picked_holds_sidebar_files ||
+      picked.BaseName().AsUTF8Unsafe() == kSyncFolderName) {
+    return picked;
+  }
+  return picked.AppendASCII(kSyncFolderName);
+}
+
+EntryKind ClassifyFolderEntry(std::string_view name,
+                              std::string_view own_install) {
+  // Temporary files of an atomic write, and iCloud's ".name.icloud" stubs.
+  if (name.empty() || name.front() == '.' ||
+      base::EndsWith(name, ".tmp", base::CompareCase::INSENSITIVE_ASCII) ||
+      base::EndsWith(name, ".icloud", base::CompareCase::INSENSITIVE_ASCII)) {
+    return EntryKind::kIgnore;
+  }
+  if (!base::StartsWith(name, kFilePrefix)) {
+    return EntryKind::kIgnore;
+  }
+  const std::string install = InstallOfName(name);
+  if (install.empty()) {
+    return EntryKind::kConflictCopy;
+  }
+  return install == own_install ? EntryKind::kOwn : EntryKind::kPeer;
+}
+
+std::string InstallOfName(std::string_view name) {
+  const std::string_view prefix = kFilePrefix;
+  if (name.size() != prefix.size() + kInstallIdLength + kJsonSuffix.size() ||
+      !base::StartsWith(name, prefix) || !base::EndsWith(name, kJsonSuffix)) {
+    return std::string();
+  }
+  const std::string_view install =
+      name.substr(prefix.size(), kInstallIdLength);
+  return IsInstallId(install) ? std::string(install) : std::string();
+}
+
+std::string ColorToText(SkColor color) {
+  return base::StringPrintf("#%02X%02X%02X", SkColorGetR(color),
+                            SkColorGetG(color), SkColorGetB(color));
+}
+
+std::optional<SkColor> ColorFromHex(std::string_view text) {
+  uint32_t rgb = 0;
+  if (text.size() != 7 || text[0] != '#' || !base::IsHexDigit(text[1]) ||
+      !base::HexStringToUInt(text.substr(1), &rgb) || rgb > 0xFFFFFF) {
+    return std::nullopt;
+  }
+  return SkColorSetA(rgb, SK_AlphaOPAQUE);
+}
+
+FileMeta::FileMeta() = default;
+FileMeta::FileMeta(const FileMeta& other) = default;
+FileMeta& FileMeta::operator=(const FileMeta& other) = default;
+FileMeta::~FileMeta() = default;
+
+ParsedFile::ParsedFile() = default;
+ParsedFile::ParsedFile(const ParsedFile& other) = default;
+ParsedFile::ParsedFile(ParsedFile&& other) = default;
+ParsedFile& ParsedFile::operator=(const ParsedFile& other) = default;
+ParsedFile& ParsedFile::operator=(ParsedFile&& other) = default;
+ParsedFile::~ParsedFile() = default;
+
+ParsedFile ParseSyncFile(std::string_view json) {
+  ParsedFile parsed;
+  if (json.size() > kMaxFileBytes) {
+    parsed.status = ParseStatus::kTooLarge;
+    return parsed;
+  }
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!root) {
+    return parsed;
+  }
+  const base::DictValue* const block = root->FindDict(kBlockKey);
+  if (!block) {
+    parsed.status = ParseStatus::kNotOurs;
+    return parsed;
+  }
+  const std::optional<int> format = block->FindInt("format");
+  const std::string* const install = block->FindString("install");
+  const std::string* const device = block->FindString("device");
+  if (!format || *format < 1 || !install || !IsInstallId(*install)) {
+    return parsed;
+  }
+  parsed.meta.format = *format;
+  parsed.meta.install = *install;
+  if (device && device->size() <= kMaxTextLength) {
+    parsed.meta.device = *device;
+  }
+  if (*format > kFormat) {
+    parsed.status = ParseStatus::kNewerFormat;
+    return parsed;
+  }
+  const std::string* const nonce = block->FindString("nonce");
+  const std::optional<int64_t> seq = WholeNumber(*block, "seq");
+  const std::optional<int64_t> written = WholeNumber(*block, "written_ms");
+  const std::optional<int64_t> hlc = WholeNumber(*block, "hlc");
+  const std::optional<int64_t> joined = WholeNumber(*block, "joined_ms");
+  if (!device || device->size() > kMaxTextLength || !nonce ||
+      nonce->size() > kMaxTextLength || !seq || !written || !hlc || !joined) {
+    return parsed;
+  }
+  parsed.meta.nonce = *nonce;
+  parsed.meta.seq = *seq;
+  parsed.meta.written_ms = *written;
+  parsed.meta.hlc = *hlc;
+  parsed.meta.joined_ms = *joined;
+  if (const base::DictValue* const records = block->FindDict("records");
+      records && records->size() > kMaxRecords) {
+    parsed.status = ParseStatus::kTooLarge;
+    return parsed;
+  }
+  std::optional<State> state = StateFromValue(*block);
+  if (!state || !Validate(*state)) {
+    return parsed;
+  }
+  parsed.state = std::move(*state);
+  parsed.status = ParseStatus::kOk;
+  return parsed;
+}
+
+ArcImportPlan LedgerToPlan(const State& state) {
+  ArcImportPlan plan;
+  plan.written_by_stedding = true;
+  std::vector<std::string> spaces;
+  std::set<std::string> listed;
+  if (const auto it = state.lists.find(kSpacesList); it != state.lists.end()) {
+    for (const std::string& id : it->second.order) {
+      const Record* const record = state.FindAlive(id);
+      if (record && record->kind == Kind::kSpace && listed.insert(id).second) {
+        spaces.push_back(id);
+      }
+    }
+  }
+  for (const auto& [id, record] : state.records) {
+    if (record.kind == Kind::kSpace && record.Alive() &&
+        listed.insert(id).second) {
+      spaces.push_back(id);
+    }
+  }
+  for (const std::string& id : spaces) {
+    const Record& record = state.records.at(id);
+    ArcImportPlan::Space space;
+    space.arc_id = id;
+    space.title = record.Get(kFieldName);
+    space.emoji = record.Get(kFieldIcon);
+    space.color = ColorFromHex(record.Get(kFieldColor));
+    space.dark_color = ColorFromHex(record.Get(kFieldDarkColor));
+    space.isolated = record.Get(kFieldIsolated) == "1";
+    space.pinned = NodesOf(state, PinsListOf(id));
+    for (ArcImportPlan::Node& node : NodesOf(state, OwnEssentialsListOf(id))) {
+      if (node.kind == ArcImportPlan::Node::Kind::kTab) {
+        space.essentials.push_back(std::move(node));
+      }
+    }
+    plan.spaces.push_back(std::move(space));
+  }
+  for (ArcImportPlan::Node& node : NodesOf(state, kEssentialsList)) {
+    if (node.kind == ArcImportPlan::Node::Kind::kTab) {
+      plan.essentials.push_back(std::move(node));
+    }
+  }
+  return plan;
+}
+
+std::string SerializeSyncFile(const State& state, const FileMeta& meta) {
+  base::DictValue block = StateToValue(state);
+  block.Set("format", meta.format);
+  block.Set("install", meta.install);
+  block.Set("device", meta.device);
+  block.Set("seq", static_cast<double>(meta.seq));
+  block.Set("nonce", meta.nonce);
+  block.Set("written_ms", static_cast<double>(meta.written_ms));
+  block.Set("hlc", static_cast<double>(meta.hlc));
+  block.Set("joined_ms", static_cast<double>(meta.joined_ms));
+  base::DictValue extra;
+  extra.Set(kBlockKey, std::move(block));
+  return PlanToJson(LedgerToPlan(state), std::move(extra));
+}
+
+bool IsPlaceholderFile(const base::FilePath& path) {
+#if BUILDFLAG(IS_WIN)
+  constexpr DWORD kRecallOnDataAccess = 0x00400000;
+  constexpr DWORD kRecallOnOpen = 0x00040000;
+  const DWORD attributes = ::GetFileAttributesW(path.value().c_str());
+  return attributes != INVALID_FILE_ATTRIBUTES &&
+         (attributes & (kRecallOnDataAccess | kRecallOnOpen |
+                        FILE_ATTRIBUTE_OFFLINE)) != 0;
+#elif BUILDFLAG(IS_MAC)
+  // SF_DATALESS: a File Provider file (iCloud Drive) whose content is not on
+  // this Mac; it keeps its real name.
+  constexpr uint32_t kDataless = 0x40000000;
+  struct stat info;
+  return lstat(path.value().c_str(), &info) == 0 &&
+         (info.st_flags & kDataless) != 0;
+#else
+  return false;
+#endif
+}
+
+}  // namespace spaces::sidebar_sync
