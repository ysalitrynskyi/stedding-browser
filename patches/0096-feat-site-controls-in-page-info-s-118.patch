 namespace stedding {
 namespace {
@@ -124,5 +128,66 @@ TEST_F(SiteCookiesTest, TheFilterNamesItsJarAndNothingElse) {
       << "the cache stays";
 }
 
+// site-controls Si8: Clear site data takes the site's cookies, device-bound
+// sessions, DOM storage and HTTP cache, all of which live on a partition, so
+// the removal can name the page's jar. It leaves the embedder's storage bit,
+// which Chromium's browsing-data delegate reads as the site's
+// persistent-storage permission in the profile's content settings, shared by
+// every Space ("permissions stay").
+TEST_F(SiteCookiesTest, TheSiteDataMaskStaysOnAPartition) {
+  using Remover = content::BrowsingDataRemover;
+  EXPECT_EQ(0u, kSiteDataRemoveMask & ~Remover::DATA_TYPE_ON_STORAGE_PARTITION)
+      << "a removal that names a jar takes only what lives in one";
+  EXPECT_TRUE(kSiteDataRemoveMask & Remover::DATA_TYPE_COOKIES);
+  EXPECT_TRUE(kSiteDataRemoveMask & Remover::DATA_TYPE_DEVICE_BOUND_SESSIONS);
+  EXPECT_TRUE(kSiteDataRemoveMask & Remover::DATA_TYPE_CACHE);
+  for (const uint64_t storage :
+       {Remover::DATA_TYPE_LOCAL_STORAGE, Remover::DATA_TYPE_INDEXED_DB,
+        Remover::DATA_TYPE_FILE_SYSTEMS, Remover::DATA_TYPE_SERVICE_WORKERS,
+        Remover::DATA_TYPE_CACHE_STORAGE,
+        Remover::DATA_TYPE_BACKGROUND_FETCH}) {
+    EXPECT_TRUE(kSiteDataRemoveMask & storage) << storage;
+  }
+  EXPECT_FALSE(kSiteDataRemoveMask & Remover::DATA_TYPE_EMBEDDER_DOM_STORAGE)
+      << "the persistent-storage permission is the profile's, every Space's";
+  EXPECT_FALSE(kSiteDataRemoveMask & Remover::DATA_TYPE_DOWNLOADS);
+  EXPECT_FALSE(kSiteDataRemoveMask & Remover::DATA_TYPE_MEDIA_LICENSES);
+  EXPECT_FALSE(kSiteDataRemoveMask & Remover::DATA_TYPE_PRIVACY_SANDBOX);
+  EXPECT_EQ(kSiteCookieRemoveMask, kSiteDataRemoveMask & kSiteCookieRemoveMask)
+      << "Clear site data takes what Clear Site Cookies takes, and more";
+}
+
+// site-controls Si8, sessions S27: Clear site data's removal names the page's
+// jar, the profile's or a Space's, so the S24 copy into every Space's jar does
+// not run, and its storage filter takes the site's storage keys, its
+// subdomains' included, and no other site's.
+TEST_F(SiteCookiesTest, TheSiteDataFilterNamesItsJar) {
+  const std::optional<content::StoragePartitionConfig> space_jar =
+      spaces::StoragePartitionConfigForProfileId(&profile_, "5f0c2d1e9a7b4c3d");
+  ASSERT_TRUE(space_jar.has_value());
+  const content::StoragePartitionConfig jars[] = {
+      content::StoragePartitionConfig::CreateDefault(&profile_), *space_jar};
+  for (const content::StoragePartitionConfig& jar : jars) {
+    SCOPED_TRACE(jar.partition_name());
+    std::unique_ptr<content::BrowsingDataFilterBuilder> filter =
+        SiteCookieFilter("example.com", jar);
+    ASSERT_TRUE(filter);
+    ASSERT_TRUE(filter->GetStoragePartitionConfig().has_value());
+    EXPECT_EQ(jar, *filter->GetStoragePartitionConfig());
+
+    const content::StoragePartition::StorageKeyMatcherFunction keys =
+        filter->BuildStorageKeyFilter();
+    const auto key = [](const char* spec) {
+      return blink::StorageKey::CreateFirstParty(
+          url::Origin::Create(GURL(spec)));
+    };
+    EXPECT_TRUE(keys.Run(key("https://example.com")));
+    EXPECT_TRUE(keys.Run(key("https://accounts.example.com")));
+    EXPECT_TRUE(keys.Run(key("http://example.com:8080")));
+    EXPECT_FALSE(keys.Run(key("https://example.org")));
+    EXPECT_FALSE(keys.Run(key("https://notexample.com")));
+  }
+}
+
 }  // namespace
 }  // namespace stedding
