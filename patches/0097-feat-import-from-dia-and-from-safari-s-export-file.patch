+// The bookmarks page and the passwords file, parsed in this process by the
+// parsers' own code, as the utility process would.
+class SafariExportImporterPrepareTest : public testing::Test {
+ protected:
+  std::unique_ptr<SafariExportImporter> MakeImporter() {
+    auto bookmark_parser =
+        std::make_unique<user_data_importer::ContentBookmarkParser>();
+    mojo::PendingRemote<user_data_importer::mojom::BookmarkHtmlParser>
+        bookmarks_remote;
+    bookmark_receivers_.push_back(
+        std::make_unique<
+            mojo::Receiver<user_data_importer::mojom::BookmarkHtmlParser>>(
+            &bookmark_html_parser_,
+            bookmarks_remote.InitWithNewPipeAndPassReceiver()));
+    bookmark_parser->SetServiceForTesting(std::move(bookmarks_remote));
+    mojo::PendingRemote<password_manager::mojom::CSVPasswordParser>
+        csv_remote;
+    csv_receivers_.push_back(
+        std::make_unique<
+            mojo::Receiver<password_manager::mojom::CSVPasswordParser>>(
+            &csv_parser_, csv_remote.InitWithNewPipeAndPassReceiver()));
+    return std::make_unique<SafariExportImporter>(std::move(bookmark_parser),
+                                                  std::move(csv_remote));
+  }
+
+  SafariExportSummary Prepare(SafariExportImporter& importer,
+                              const base::FilePath& path) {
+    SafariExportSummary summary;
