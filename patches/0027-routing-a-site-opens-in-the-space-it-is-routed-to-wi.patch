diff --git a/chrome/browser/ui/spaces/space_router.cc b/chrome/browser/ui/spaces/space_router.cc
new file mode 100644
index 0000000000000..5b4dacb4bab9a
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_router.cc
@@ -0,0 +1,201 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_router.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+
+namespace spaces {
+
+namespace {
+
+constexpr base::TimeDelta kExternalOpenWindow = base::Seconds(10);
+
+std::vector<std::pair<GURL, base::TimeTicks>>& ExternalOpens() {
+  static base::NoDestructor<std::vector<std::pair<GURL, base::TimeTicks>>>
+      opens;
+  return *opens;
+}
+
+}  // namespace
+
+std::string SiteOf(const GURL& url) {
+  if (!url.is_valid() || !url.has_host()) {
+    return std::string();
+  }
+  const std::string domain =
+      net::registry_controlled_domains::GetDomainAndRegistry(
+          url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  return base::ToLowerASCII(domain.empty() ? url.host() : domain);
+}
+
+bool RouteMatches(const Route& route, const GURL& url) {
+  if (route.pattern.empty() || !url.is_valid()) {
+    return false;
+  }
+  switch (route.match) {
+    case Route::Match::kSite:
+      return SiteOf(url) == base::ToLowerASCII(route.pattern);
+    case Route::Match::kContains:
+      return base::ToLowerASCII(url.spec())
+                 .find(base::ToLowerASCII(route.pattern)) != std::string::npos;
+    case Route::Match::kEquals: {
+      const GURL wanted(route.pattern);
+      return wanted.is_valid() ? wanted == url : url.spec() == route.pattern;
+    }
+  }
+  return false;
+}
+
+std::optional<std::string> RouteFor(const std::vector<Route>& routes,
+                                    const GURL& url,
+                                    bool peeking) {
+  if (peeking) {
+    return std::nullopt;
+  }
+  for (const Route& route : routes) {
+    if (RouteMatches(route, url)) {
+      return route.space;
+    }
+  }
+  return std::nullopt;
+}
+
+Route SiteRouteFor(const GURL& url, const std::string& space) {
+  Route route;
+  route.match = Route::Match::kSite;
+  route.pattern = SiteOf(url);
+  route.space = space;
+  return route;
+}
+
+const char* MatchName(Route::Match match) {
+  switch (match) {
+    case Route::Match::kSite:
+      return "site";
+    case Route::Match::kContains:
+      return "contains";
+    case Route::Match::kEquals:
+      return "equals";
+  }
+  return "site";
+}
+
+std::optional<Route::Match> MatchFromName(std::string_view name) {
+  if (name == "site") {
+    return Route::Match::kSite;
+  }
+  if (name == "contains") {
+    return Route::Match::kContains;
+  }
+  if (name == "equals") {
+    return Route::Match::kEquals;
+  }
+  return std::nullopt;
+}
+
+std::vector<Route> RoutesFromValue(const base::ListValue& value) {
+  std::vector<Route> routes;
+  for (const base::Value& entry : value) {
+    const base::DictValue* const dict = entry.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    const std::string* const match = dict->FindString("match");
+    const std::string* const pattern = dict->FindString("pattern");
+    const std::string* const space = dict->FindString("space");
+    if (!match || !pattern || !space || pattern->empty() || space->empty()) {
+      continue;
+    }
+    const std::optional<Route::Match> kind = MatchFromName(*match);
+    if (!kind) {
+      continue;
+    }
+    Route route;
+    route.match = *kind;
+    route.pattern = *pattern;
+    route.space = *space;
+    routes.push_back(std::move(route));
+  }
+  return routes;
+}
+
+base::ListValue RoutesToValue(const std::vector<Route>& routes) {
+  base::ListValue list;
+  for (const Route& route : routes) {
+    base::DictValue dict;
+    dict.Set("match", MatchName(route.match));
+    dict.Set("pattern", route.pattern);
+    dict.Set("space", route.space);
+    list.Append(std::move(dict));
+  }
+  return list;
+}
+
+std::vector<Route> ReadRoutes(const PrefService* prefs) {
+  if (!prefs) {
+    return {};
+  }
+  return RoutesFromValue(prefs->GetList(stedding::prefs::kSpaceRoutes));
+}
+
+void WriteRoutes(PrefService* prefs, const std::vector<Route>& routes) {
+  if (prefs) {
+    prefs->SetList(stedding::prefs::kSpaceRoutes, RoutesToValue(routes));
+  }
+}
+
+void AddRoute(PrefService* prefs, Route route) {
+  if (!prefs || route.pattern.empty() || route.space.empty()) {
+    return;
+  }
+  std::vector<Route> routes = ReadRoutes(prefs);
+  std::erase_if(routes, [&](const Route& existing) {
+    return existing.match == route.match &&
+           base::ToLowerASCII(existing.pattern) ==
+               base::ToLowerASCII(route.pattern);
+  });
+  routes.push_back(std::move(route));
+  WriteRoutes(prefs, routes);
+}
+
+void RemoveRoute(PrefService* prefs, size_t index) {
+  std::vector<Route> routes = ReadRoutes(prefs);
+  if (index >= routes.size()) {
+    return;
+  }
+  routes.erase(routes.begin() + static_cast<std::ptrdiff_t>(index));
+  WriteRoutes(prefs, routes);
+}
+
+void MarkExternalOpen(const GURL& url) {
+  if (url.is_valid()) {
+    ExternalOpens().emplace_back(url, base::TimeTicks::Now());
+  }
+}
+
+bool TakeExternalOpen(const GURL& url) {
+  auto& opens = ExternalOpens();
+  const base::TimeTicks now = base::TimeTicks::Now();
+  std::erase_if(opens, [&](const auto& entry) {
+    return now - entry.second > kExternalOpenWindow;
+  });
+  const auto it = std::ranges::find_if(
+      opens, [&](const auto& entry) { return entry.first == url; });
+  if (it == opens.end()) {
+    return false;
+  }
+  opens.erase(it);
+  return true;
+}
+
+}  // namespace spaces
