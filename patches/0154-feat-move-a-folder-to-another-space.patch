+// folders F47 (the owner, 2026-11-05): a folder goes to another Space whole,
+// its nested folders with it, and its tabs keep their order. In that Space
+// already, nothing moves.
+TEST_F(FolderCommandsTest, MoveFolderToSpaceTakesItWhole) {
+  // The strip reads a, b, c, loose.
+  tabs::TabInterface* const loose = OpenTab(GURL("https://loose.test/"));
+  tabs::TabInterface* const c = OpenTab(GURL("https://c.test/"));
+  tabs::TabInterface* const b = OpenTab(GURL("https://b.test/"));
+  tabs::TabInterface* const a = OpenTab(GURL("https://a.test/"));
+  tabs::FolderTabCollection* const outer = tabs().AddToNewFolder({0, 1, 2});
+  ASSERT_TRUE(outer);
+  tabs::FolderTabCollection* const inner =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(c)}, outer);
+  ASSERT_TRUE(inner);
+  const SpaceId home = model().active_id();
+  const SpaceId work = model().AddSpace("Work", kBlue)->id();
+
+  model().MoveFolderToSpace(outer, work);
+
+  for (tabs::TabInterface* const tab : {a, b, c}) {
+    EXPECT_EQ(work, model().SpaceForTab(tab));
+  }
+  EXPECT_EQ(home, model().SpaceForTab(loose));
+  EXPECT_EQ(3u, outer->TabCountRecursive()) << "the folder lost a tab";
+  EXPECT_EQ(outer, inner->GetParentCollection());
+  EXPECT_EQ(inner, c->GetParentCollection());
+  EXPECT_LT(tabs().GetIndexOfTab(a), tabs().GetIndexOfTab(b));
+  EXPECT_LT(tabs().GetIndexOfTab(b), tabs().GetIndexOfTab(c));
+
+  const int at = tabs().GetIndexOfTab(a);
+  model().MoveFolderToSpace(outer, work);
+  EXPECT_EQ(at, tabs().GetIndexOfTab(a)) << "already there, and it moved";
+  EXPECT_EQ(work, model().SpaceForTab(a));
+}
+
+// folders F47, F37: a nested folder moved alone comes out of the folder around
+// it, which stays in its Space with its other tabs: no folder spans two Spaces.
+TEST_F(FolderCommandsTest, MoveFolderToSpaceBringsANestedFolderOut) {
+  // The strip reads a, b, c, loose.
+  OpenTab(GURL("https://loose.test/"));
+  tabs::TabInterface* const c = OpenTab(GURL("https://c.test/"));
+  tabs::TabInterface* const b = OpenTab(GURL("https://b.test/"));
+  tabs::TabInterface* const a = OpenTab(GURL("https://a.test/"));
+  tabs::FolderTabCollection* const outer = tabs().AddToNewFolder({0, 1, 2});
+  ASSERT_TRUE(outer);
+  tabs::FolderTabCollection* const inner =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(c)}, outer);
+  ASSERT_TRUE(inner);
+  const SpaceId home = model().active_id();
+  const SpaceId work = model().AddSpace("Work", kBlue)->id();
+
+  model().MoveFolderToSpace(inner, work);
+
+  EXPECT_EQ(work, model().SpaceForTab(c));
+  EXPECT_EQ(home, model().SpaceForTab(a));
+  EXPECT_EQ(home, model().SpaceForTab(b));
+  EXPECT_EQ(tabs::TabCollection::Type::UNPINNED,
+            inner->GetParentCollection()->type())
+      << "the folder is still in the other Space's folder";
+  EXPECT_EQ(inner, c->GetParentCollection());
+  EXPECT_EQ(2u, outer->TabCountRecursive());
+}
