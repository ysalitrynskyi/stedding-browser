 class PeekOverPageTest : public InProcessBrowserTest {
  protected:
   void SetUpOnMainThread() override {
@@ -155,6 +195,56 @@ class PeekOverPageTest : public InProcessBrowserTest {
   }
 };
 
+#if defined(USE_AURA)
+// tabs R67 (BACKLOG S-429, GitHub issue 82): a peek goes with its widget at
+// once. One closed as its tab comes back, so as its window shows, leaves the
+// pinned tab on screen and taking input. On the Mac the browser died at the
+// same step: TabDidEnterForeground, Widget::Show, the widget gone by the end
+// of the native show. The Mac's own step is
+// NativeWidgetMacTest.ShowOutlivesTheWidget.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest,
+                       APeekClosedAsItComesBackLeavesThePinAlone) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  views::Widget* const widget = peek->widget();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("c.test", "/title1.html"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_FALSE(widget->IsVisible()) << "it goes with its tab (P20)";
+
+  CloseAsItShows closer(widget);
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+  EXPECT_TRUE(closer.closed());
+  EXPECT_TRUE(WaitForNoPeek(pin));
+  EXPECT_EQ(pin, tab());
+}
+
+// tabs R67: the same on the peek's first show: it ended on a widget that had
+// gone, and a peek that had.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest,
+                       APeekClosedAsItFirstShowsLeavesThePinAlone) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  std::unique_ptr<CloseAsItShows> closer;
+  views::AnyWidgetObserver widgets(views::test::AnyWidgetTestPasskey{});
+  widgets.set_initialized_callback(
+      base::BindLambdaForTesting([&](views::Widget* widget) {
+        if (widget->GetName() == "SteddingPeek") {
+          closer = std::make_unique<CloseAsItShows>(widget);
+        }
+      }));
+  ClickLink();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return closer && closer->closed(); }));
+  EXPECT_TRUE(WaitForNoPeek(pin));
+  EXPECT_EQ(pin, tab());
+}
+#endif  // defined(USE_AURA)
