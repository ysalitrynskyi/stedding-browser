@@ -6628,16 +6628,21 @@ TEST_F(TabStripModelTest, DiscontinuousNewTabIndexTooLow) {
 }
 
 TEST_F(TabStripModelTest, CreateGroupSetsVisualData) {
-  tab_groups::ColorLabelMap all_colors = tab_groups::GetTabGroupColorLabelMap();
+  // Stedding (privacy Q10, patch 0042): TabGroupColorRefresh is on by default
+  // here, and new groups take colours in TabGroupModel::GetColorOrdering()'s
+  // order, not the label map's. The ordering is the source of truth for both
+  // defaults.
+  const std::vector<tab_groups::TabGroupColorId> all_colors =
+      TabGroupModel::GetColorOrdering();
   PrepareTabs(tabstrip(), all_colors.size() + 1);
 
   // Expect groups to cycle through the available color set.
   int index = 0;
-  for (const auto& color_pair : all_colors) {
+  for (const auto color : all_colors) {
     const tab_groups::TabGroupId group = tabstrip()->AddToNewGroup({index});
     EXPECT_EQ(
         tabstrip()->group_model()->GetTabGroup(group)->visual_data()->color(),
-        color_pair.first);
+        color);
     ++index;
   }
 
@@ -6645,7 +6650,7 @@ TEST_F(TabStripModelTest, CreateGroupSetsVisualData) {
   const tab_groups::TabGroupId group = tabstrip()->AddToNewGroup({index});
   EXPECT_EQ(
       tabstrip()->group_model()->GetTabGroup(group)->visual_data()->color(),
-      all_colors.begin()->first);
+      all_colors.front());
 
   tabstrip()->CloseAllTabs();
 }
