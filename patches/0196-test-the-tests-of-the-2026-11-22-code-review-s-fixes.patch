+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import <Foundation/Foundation.h>
+
+#include <memory>
+
+#include "base/functional/callback_helpers.h"
+#include "base/test/task_environment.h"
+#include "chrome/browser/ui/stedding/app_updater.h"
+#include "chrome/browser/ui/stedding/app_updater_mac.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+// What the stand-in for Sparkle was handed: the browser's user driver and
+// updater delegate, one object.
+struct FakeSparkleW2B18 {
+  id __strong delegate = nil;
+};
+
+FakeSparkleW2B18* g_sparkle_w2b18 = nullptr;
+
+}  // namespace
+
+// The delegate's method a test calls as Sparkle would (Sparkle's
+// SPUUpdaterDelegate).
+@protocol SteddingSparkleDelegateW2B18 <NSObject>
+- (BOOL)updater:(id)updater
+    shouldProceedWithUpdate:(id)updateItem
+                updateCheck:(NSInteger)updateCheck
+                      error:(NSError**)error;
+@end
+
+// An update in the feed, as Sparkle's SUAppcastItem tells it.
+@interface SteddingSparkleItemW2B18 : NSObject
+@property(nonatomic, copy) NSString* displayVersionString;
+@property(nonatomic, getter=isInformationOnlyUpdate)
+    BOOL informationOnlyUpdate;
+@property(nonatomic) NSInteger signingValidationStatus;
+@end
+
+@implementation SteddingSparkleItemW2B18
+@synthesize displayVersionString = _displayVersionString;
+@synthesize informationOnlyUpdate = _informationOnlyUpdate;
+@synthesize signingValidationStatus = _signingValidationStatus;
+@end
+
+// A stand-in for Sparkle's SPUUpdater that keeps the delegate it is given.
+// Sparkle's own schedule is not run.
+@interface SteddingSparkleUpdaterW2B18 : NSObject
+@property(nonatomic) BOOL automaticallyChecksForUpdates;
+@property(nonatomic) BOOL automaticallyDownloadsUpdates;
+@property(nonatomic) BOOL sendsSystemProfile;
+@end
+
+@implementation SteddingSparkleUpdaterW2B18
+
+@synthesize automaticallyChecksForUpdates = _automaticallyChecksForUpdates;
+@synthesize automaticallyDownloadsUpdates = _automaticallyDownloadsUpdates;
+@synthesize sendsSystemProfile = _sendsSystemProfile;
+
+- (instancetype)initWithHostBundle:(NSBundle*)hostBundle
+                 applicationBundle:(NSBundle*)applicationBundle
+                        userDriver:(id)userDriver
+                          delegate:(id)delegate {
+  g_sparkle_w2b18->delegate = delegate;
+  return [super init];
+}
+
+- (BOOL)startUpdater:(NSError**)error {
+  return YES;
+}
+
+- (void)checkForUpdates {
+}
+
+- (void)checkForUpdatesInBackground {
+}
+
+- (BOOL)canCheckForUpdates {
+  return YES;
+}
+
+- (NSDate*)lastUpdateCheckDate {
+  return nil;
+}
+
+@end
+
+namespace stedding {
+namespace {
+
+// SPUAppcastSigningValidationStatus: the feed's signature checked and good,
+// or checked and failed.
+constexpr NSInteger kFeedSignatureGoodW2B18 = 1;
+constexpr NSInteger kFeedSignatureFailedW2B18 = 2;
+// SPUUpdateCheck: a check on Sparkle's schedule, one the user asked for.
+constexpr NSInteger kScheduledCheckW2B18 = 1;
+constexpr NSInteger kUserCheckW2B18 = 0;
+// SUError: no update found.
+constexpr NSInteger kNoUpdateErrorW2B18 = 1001;
+
+SteddingSparkleItemW2B18* ItemW2B18(NSInteger signing, BOOL information_only) {
+  SteddingSparkleItemW2B18* const item =
+      [[SteddingSparkleItemW2B18 alloc] init];
+  item.displayVersionString = @"0.9.0";
+  item.signingValidationStatus = signing;
+  item.informationOnlyUpdate = information_only;
+  return item;
+}
+
+class AppUpdaterMacW2B18Test : public testing::Test {
+ protected:
+  void SetUp() override {
+    prefs::RegisterLocalStatePrefs(local_state_.registry());
+    g_sparkle_w2b18 = &sparkle_;
+    updater_ = CreateSparkleAppUpdater([SteddingSparkleUpdaterW2B18 class],
+                                       &local_state_, base::DoNothing());
+  }
+
+  void TearDown() override {
+    updater_.reset();
+    g_sparkle_w2b18 = nullptr;
+  }
+
+  id<SteddingSparkleDelegateW2B18> Delegate() { return sparkle_.delegate; }
+
+  base::test::TaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  TestingPrefServiceSimple local_state_;
+  FakeSparkleW2B18 sparkle_;
+  std::unique_ptr<AppUpdater> updater_;
+};
+
+// P20-1b, updates Up12: an entry Sparkle marks as from a feed whose
+// signature failed, or an informational entry, is never offered, on
+// Sparkle's schedule too. Only a check the user asked for refused it; a
+// scheduled check with automatic downloads told only the delegate, which
+// showed the update and let Sparkle install it at the quit.
+TEST_F(AppUpdaterMacW2B18Test, AnUpdateFromAFeedWhoseSignatureFailedIsRefused) {
+  id<SteddingSparkleDelegateW2B18> const delegate = Delegate();
+  ASSERT_TRUE(delegate != nil);
+  ASSERT_TRUE([delegate respondsToSelector:@selector
+                        (updater:shouldProceedWithUpdate:updateCheck:error:)])
+      << "Sparkle goes ahead with every update it finds";
+
+  for (const NSInteger check : {kScheduledCheckW2B18, kUserCheckW2B18}) {
+    SCOPED_TRACE(check == kScheduledCheckW2B18 ? "scheduled" : "the user's");
+    {
+      SCOPED_TRACE("the feed's signature failed");
+      NSError* error = nil;
+      EXPECT_FALSE([delegate updater:nil
+             shouldProceedWithUpdate:ItemW2B18(kFeedSignatureFailedW2B18, NO)
+                         updateCheck:check
+                               error:&error]);
+      ASSERT_TRUE(error != nil) << "Sparkle needs a reason";
+      EXPECT_EQ(kNoUpdateErrorW2B18, error.code);
+      EXPECT_GT(error.localizedDescription.length, 0u);
+    }
+    {
+      SCOPED_TRACE("an informational entry");
+      NSError* error = nil;
+      EXPECT_FALSE([delegate updater:nil
+             shouldProceedWithUpdate:ItemW2B18(kFeedSignatureGoodW2B18, YES)
+                         updateCheck:check
+                               error:&error]);
+      EXPECT_TRUE(error != nil);
+    }
+    {
+      SCOPED_TRACE("a signed feed's update");
+      NSError* error = nil;
+      EXPECT_TRUE([delegate updater:nil
+            shouldProceedWithUpdate:ItemW2B18(kFeedSignatureGoodW2B18, NO)
+                        updateCheck:check
+                              error:&error]);
+      EXPECT_TRUE(error == nil);
+    }
+  }
+  EXPECT_EQ(AppUpdater::State::kIdle, updater_->state())
+      << "a refused update changed what the About page says";
+  EXPECT_TRUE(updater_->version().empty());
+}
+
+}  // namespace
+}  // namespace stedding
