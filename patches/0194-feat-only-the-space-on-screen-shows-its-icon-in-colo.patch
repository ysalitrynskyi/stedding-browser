+// The switch still slid the new list in from a whole width out and clipped
+// the region for it, and with no slide out to end, nothing undid the clip:
+// the open sidebar stayed clipped, its edge's shadow cut, until the next
+// switch. The new Space shows at once instead.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, ASwitchUnderAPanelShowsTheSpaceAtOnce) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  if (!stedding::ShouldAnimate(browser()->GetProfile()->GetPrefs())) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
+  ASSERT_NO_FATAL_FAILURE(MakeThreeSpaces());
+  const TabStripView* const strip = FindTabStripView(
+      browser_view()->vertical_tab_strip_region_view_for_testing());
+  ASSERT_TRUE(strip);
+  views::View* const list = strip->unpinned_tabs_scroll_view();
+  ASSERT_TRUE(list);
+  ui::Layer* const region =
+      browser_view()->vertical_tab_strip_region_view_for_testing()->layer();
+  ASSERT_TRUE(region);
+
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      stedding::prefs::kSidebarLibraryPanels, true);
+  stedding::SidebarPanels* const panels =
+      stedding::SidebarPanels::From(browser());
+  ASSERT_TRUE(panels);
+  ASSERT_TRUE(panels->Open(stedding::SidebarPanel::kHistory));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    return !list->IsDrawn();
+  })) << "the panel did not take the list's place";
+
+  ASSERT_TRUE(model()->SetActiveSpace(ids_[1]));
+  // The panel covers the list, so no row is drawn yet (ExpectShowing waits
+  // for the panel to close).
+  EXPECT_EQ(ids_[1], model()->active_id());
+  EXPECT_FALSE(OutgoingLayerOver(list))
+      << "a Space left that was not drawn has nothing to push out";
+  if (views::View* const title = strip->GetSpaceTitleRow()) {
+    EXPECT_FALSE(OutgoingLayerOver(title));
+    EXPECT_TRUE(!title->layer() || title->layer()->transform().IsIdentity())
+        << "the title row slid in with nothing to join";
+  }
+  ASSERT_TRUE(list->layer());
+  EXPECT_FALSE(list->layer()->GetAnimator()->is_animating())
+      << "the new list slid in with nothing to join";
+  EXPECT_TRUE(list->layer()->transform().IsIdentity());
+  EXPECT_FALSE(region->GetMasksToBounds())
+      << "the open sidebar is clipped, its edge's shadow cut";
+
+  panels->Close();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    return list->IsDrawn();
+  }));
+  ExpectShowing(ids_[1]);
+  EXPECT_FALSE(region->GetMasksToBounds())
+      << "the panel closed, the sidebar is still clipped";
+}
