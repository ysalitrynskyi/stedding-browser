+  SpaceId work = SpaceId::GenerateNew();
+  {
+    SpaceRegistry registry(&prefs);
+    work = registry.Add("Work", SK_ColorBLUE);
+    registry.SetColor(work, SK_ColorBLUE, /*chosen=*/true, SK_ColorRED);
+  }
+  {
+    SpaceRegistry again(&prefs);
+    ASSERT_EQ(1u, again.entries().size());
+    EXPECT_EQ(SK_ColorBLUE, again.entries()[0].color);
+    EXPECT_EQ(std::optional<SkColor>(SK_ColorRED),
+              again.entries()[0].dark_color);
+    again.SetColor(work, SK_ColorGREEN, /*chosen=*/true);
+    EXPECT_FALSE(again.entries()[0].dark_color) << "one colour clears it";
+  }
+  base::ListValue old_list;
+  base::DictValue old_entry;
+  old_entry.Set("id", work.ToString());
+  old_entry.Set("name", "Work");
+  old_entry.Set("color", static_cast<int>(SK_ColorBLUE));
+  old_list.Append(std::move(old_entry));
+  const std::vector<RegistryEntry> read = SpaceRegistry::FromValue(old_list);
+  ASSERT_EQ(1u, read.size());
+  EXPECT_FALSE(read[0].dark_color);
+}
