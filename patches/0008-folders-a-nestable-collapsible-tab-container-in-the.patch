+// found in the LICENSE file.
+
+#ifndef COMPONENTS_TABS_PUBLIC_FOLDER_TAB_COLLECTION_H_
+#define COMPONENTS_TABS_PUBLIC_FOLDER_TAB_COLLECTION_H_
+
+#include <string>
+
+#include "components/tab_groups/token_id.h"
+#include "components/tabs/public/tab_collection.h"
+
+namespace tabs {
+
+// Identifies a folder. Distinct from TabGroupId so the two cannot be confused
+// at a call site: a folder is not a group and must not be routed through group
+// APIs. See FolderTabCollection below for why.
+class FolderId : public tab_groups::TokenId<FolderId> {};
+
+// A named, collapsible container of tabs that the user creates in the sidebar.
+//
+// Deliberately NOT a nested tab group. Allowing GROUP inside GROUP compiles
+// after a one-line allow-list change and then lies: TabModel::UpdateProperties
+// walks a tab's ancestors and each GROUP overwrites the tab's group id, so the
+// OUTERMOST group wins and inner membership silently disappears from
+// GetGroup(), from session restore, from saved tab groups, and from every
+// consumer that asks a tab which group it is in. A separate collection type
+// keeps Chrome's tab groups working as they do today.
+//
+// Folders differ from groups in what they promise the user:
+//   * they nest, so a folder may contain folders
+//   * they are never auto-archived, and an empty folder stays in the tree
+//   * their identity is a FolderId carried in session extra_data, not a
+//     TabGroupId, so they are not synced as saved tab groups
+class FolderTabCollection : public TabCollection {
+ public:
+  FolderTabCollection(FolderId id, std::string title, bool collapsed);
+  ~FolderTabCollection() override;
+  FolderTabCollection(const FolderTabCollection&) = delete;
+  FolderTabCollection& operator=(const FolderTabCollection&) = delete;
+
+  const FolderId& id() const { return id_; }
+
+  const std::string& title() const { return title_; }
+  void SetTitle(std::string title);
+
+  // Whether the folder is drawn collapsed in the sidebar. Collapsing hides the
+  // folder's children from view; it does not detach or close them, and the
+  // tabs inside continue to run.
+  bool collapsed() const { return collapsed_; }
+  void SetCollapsed(bool collapsed);
+
+ private:
+  const FolderId id_;
+  std::string title_;
+  bool collapsed_;
+};
+
+}  // namespace tabs
+
+#endif  // COMPONENTS_TABS_PUBLIC_FOLDER_TAB_COLLECTION_H_
