+// sessions S7
+TEST_F(SpaceWindowTest, TurningIsolationOffKeepsTheJarForNextTime) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceIsolated(work->id(), true);
+  model().SetActiveSpace(work->id());
+  const std::string jar = PartitionOf(OpenTab()).partition_name();
+  ASSERT_FALSE(jar.empty());
+  model().SetSpaceIsolated(work->id(), false);
+  EXPECT_FALSE(model().SpaceIsIsolated(work->id()));
+  EXPECT_FALSE(IsSpaceStoragePartition(PartitionOf(OpenTab())));
+  EXPECT_EQ(jar, model().registry()->Find(work->id())->profile_id)
+      << "the token stays";
+  model().SetSpaceIsolated(work->id(), true);
+  EXPECT_EQ(jar, PartitionOf(OpenTab()).partition_name())
+      << "the same jar, with its logins";
+}
+
+// sessions S9
+TEST_F(SpaceWindowTest, RebindKeepsASleepingTabAsleepWithItsHistory) {
+  tabs::TabInterface* const tab = OpenTab();
+  NavigateAndCommit(tab->GetContents(), GURL("https://example.com/second"));
+  ASSERT_EQ(2, tab->GetContents()->GetController().GetEntryCount());
+  OpenTab();  // Another tab is active, so `tab` can sleep.
+  // Asleep the way the lifecycle unit does it (sleep_tabs.cc), without the
+  // unit: a null contents that carries the entries and WasDiscarded.
+  content::WebContents* const old_contents = tab->GetContents();
+  content::WebContents::CreateParams null_params(profile());
+  null_params.desired_renderer_state =
+      content::WebContents::CreateParams::kNoRendererProcess;
+  std::unique_ptr<content::WebContents> null_contents =
+      content::WebContents::Create(null_params);
+  null_contents->GetController().CopyStateFrom(&old_contents->GetController(),
+                                               /*needs_reload=*/false);
+  null_contents->SetWasDiscarded(true);
+  tabs().DiscardWebContents(old_contents, std::move(null_contents));
+  ASSERT_TRUE(tab->GetContents()->WasDiscarded());
+  stedding::SetTabName(browser(), tab, u"Named");
+
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceIsolated(work->id(), true);
+  model().SetSpaceForTab(tab, work->id());
+  task_environment()->RunUntilIdle();
+  content::WebContents* const rebound = tab->GetContents();
+  EXPECT_TRUE(IsSpaceStoragePartition(PartitionOf(tab))) << PartitionOf(tab);
+  EXPECT_TRUE(rebound->WasDiscarded()) << "still asleep";
+  EXPECT_EQ(2, rebound->GetController().GetEntryCount()) << "history kept";
+  EXPECT_EQ(GURL("https://example.com/second"), rebound->GetLastCommittedURL());
+  EXPECT_EQ(u"Named", stedding::TabName(rebound)) << "the name came along";
+}
+
+// sessions S18
+TEST_F(SpaceWindowTest, UnpersistedRegistryIsolatesInMemory) {
+  SpaceRegistry unpersisted(nullptr);
+  const SpaceId blank = unpersisted.Add("Blank", kBlue);
+  unpersisted.EnsureIsolated(blank);
+  const std::optional<content::StoragePartitionConfig> in_memory =
+      StoragePartitionConfigForSpace(profile(), &unpersisted, blank);
+  ASSERT_TRUE(in_memory);
+  EXPECT_TRUE(in_memory->in_memory()) << "a Blank Window's jar never lands";
+
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceIsolated(work->id(), true);
+  const std::optional<content::StoragePartitionConfig> on_disk =
+      StoragePartitionConfigForSpace(profile(), model().registry(), work->id());
+  ASSERT_TRUE(on_disk);
+  EXPECT_FALSE(on_disk->in_memory());
+}
