new file mode 100644
index 0000000000000..e39a66e37bf10
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/hovercard/tab_resource_line.h
@@ -0,0 +1,112 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_TABS_HOVERCARD_TAB_RESOURCE_LINE_H_
+#define CHROME_BROWSER_UI_VIEWS_TABS_HOVERCARD_TAB_RESOURCE_LINE_H_
+
+#include <optional>
+#include <string>
+
+#include "base/byte_size.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "chrome/browser/task_manager/task_manager_observer.h"
+#include "components/performance_manager/public/resource_attribution/page_context.h"
+#include "components/performance_manager/public/resource_attribution/queries.h"
+
+namespace content {
+class WebContents;
+}
+
+// Stedding (docs/features/pins.md H25, the owner, 2026-10-22): the line at
+// the foot of a tab's hover card that shows what the tab uses, "312 MB · CPU
+// 4% · 3.2 MB/s", once the card has stayed on the tab for two seconds, and
+// while it stays. GPU is not shown: one process draws for every tab, and
+// nothing divides its work between them.
+namespace stedding {
+
+// What one tab uses. A figure not measured yet is empty.
+struct TabResourceFigures {
+  // The tab's private memory footprint: its share of each process its frames
+  // and workers run in, as Chromium's own hover card memory row counts it
+  // (resource attribution's page summary).
+  std::optional<base::ByteSize> memory;
+  // CPU over the last interval, in percent of one core, as Chromium's task
+  // manager shows it: a tab busy on two cores reads 200.
+  std::optional<double> cpu_percent;
+  // Bytes received and sent per second over the last interval, by the tab's
+  // frames in every process.
+  std::optional<base::ByteSize> network_per_second;
+};
+
+// "312 MB · CPU 4% · 3.2 MB/s", in Chromium's byte and speed formats. A figure
+// not measured yet is left out; with no memory figure the line is empty, and
+// the card shows no line until there is one.
+std::u16string FormatTabResourceLine(const TabResourceFigures& figures);
+
+// The line of a tab asleep (discarded): it has no page running, so there is
+// nothing to measure.
+std::u16string TabResourceLineAsleep();
+
+// CPU used between two readings of a cumulative CPU time, in percent of one
+// core; nullopt when no time passed between them. A reading lower than the
+// one before counts as no use.
+std::optional<double> CpuPercentBetween(base::TimeDelta cpu_before,
+                                        base::TimeTicks read_before,
+                                        base::TimeDelta cpu_after,
+                                        base::TimeTicks read_after);
+
+// Measures one tab while its card's line is due or shown, and nothing once
+// destroyed. Memory and CPU come from Chromium's resource attribution, a
+// query for the tab's page alone, repeated every `interval`. The network
+// rate comes from Chromium's task manager, the one place the browser counts
+// a frame's bytes: the network service reports them only while the task
+// manager runs, which this keeps it doing, refreshing the network figures
+// alone, until it is destroyed.
+class TabResourceSampler : public resource_attribution::QueryResultObserver,
+                           public task_manager::TaskManagerObserver {
+ public:
+  using FiguresCallback =
+      base::RepeatingCallback<void(const TabResourceFigures&)>;
+
+  // `on_update` runs whenever a figure changes, never from the constructor.
+  TabResourceSampler(content::WebContents* contents,
+                     base::TimeDelta interval,
+                     FiguresCallback on_update);
+  TabResourceSampler(const TabResourceSampler&) = delete;
+  TabResourceSampler& operator=(const TabResourceSampler&) = delete;
+  ~TabResourceSampler() override;
+
+  const TabResourceFigures& figures() const { return figures_; }
+
+ private:
+  // resource_attribution::QueryResultObserver:
+  void OnResourceUsageUpdated(
+      const resource_attribution::QueryResultMap& results) override;
+
+  // task_manager::TaskManagerObserver:
+  void OnTasksRefreshed(const task_manager::TaskIdList& task_ids) override;
+
+  base::WeakPtr<content::WebContents> contents_;
+  std::optional<resource_attribution::PageContext> page_;
+  // Declared before its observation, which must go first.
+  std::optional<resource_attribution::ScopedResourceUsageQuery> query_;
+  resource_attribution::ScopedQueryObservation query_observation_{this};
+
+  // The last CPU reading, to take the next one from.
+  std::optional<base::TimeDelta> last_cpu_;
+  base::TimeTicks last_cpu_read_;
+
+  // The task manager's refresh as it starts measures no interval: its rates
+  // read zero. Network figures count from the refresh after it.
+  bool network_interval_started_ = false;
+
+  TabResourceFigures figures_;
+  FiguresCallback on_update_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_HOVERCARD_TAB_RESOURCE_LINE_H_
diff --git a/chrome/browser/ui/views/tabs/hovercard/tab_resource_line_unittest.cc b/chrome/browser/ui/views/tabs/hovercard/tab_resource_line_unittest.cc
new file mode 100644
index 0000000000000..bb2cd03fbb8aa
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/hovercard/tab_resource_line_unittest.cc
@@ -0,0 +1,139 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The hover card's resource line (docs/features/pins.md H25): its text, in
+// Chromium's byte and speed formats, and its place as the card footer's last
+// row. The browser test HoverCardPictureTest.ACardShowsItsTabsUseAfterAPause
+// covers the wait, the measuring and the card.
+
+#include "chrome/browser/ui/views/tabs/hovercard/tab_resource_line.h"
+
+#include <optional>
+#include <string>
+
+#include "base/byte_size.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/views/tabs/hovercard/fade_footer_view.h"
+#include "chrome/test/views/chrome_views_test_base.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/view.h"
+
+namespace stedding {
+namespace {
+
+using TabResourceLineTest = ChromeViewsTestBase;
+
+TabResourceFigures Figures(std::optional<base::ByteSize> memory,
+                           std::optional<double> cpu_percent,
+                           std::optional<base::ByteSize> network) {
+  TabResourceFigures figures;
+  figures.memory = memory;
+  figures.cpu_percent = cpu_percent;
+  figures.network_per_second = network;
+  return figures;
+}
+
+// pins H25: memory, CPU as a whole percent of one core, and the network
+// rate, joined as the card's pin line joins its parts (H8).
+TEST_F(TabResourceLineTest, TheLineReadsMemoryCpuAndNetwork) {
+  EXPECT_EQ(u"312 MB \u00B7 CPU 4% \u00B7 3.2 MB/s",
+            FormatTabResourceLine(
+                Figures(base::MiB(312), 4.4, base::MiB(3) + base::KiB(205))));
+  // An idle tab: under half a percent reads 0, and no traffic 0 B/s.
+  EXPECT_EQ(u"1.5 GB \u00B7 CPU 0% \u00B7 0 B/s",
+            FormatTabResourceLine(Figures(base::GiB(1) + base::MiB(512), 0.2,
+                                          base::ByteSize(0))));
+  // A tab busy on two cores reads over 100, as Chromium's task manager does.
+  EXPECT_EQ(
+      u"64.0 MB \u00B7 CPU 188% \u00B7 12.0 KB/s",
+      FormatTabResourceLine(Figures(base::MiB(64), 187.6, base::KiB(12))));
+  // Never below 0.
+  EXPECT_EQ(u"312 MB \u00B7 CPU 0%",
+            FormatTabResourceLine(Figures(base::MiB(312), -3.0, std::nullopt)));
+}
+
+// A figure not measured yet is left out; with no memory there is no line.
+TEST_F(TabResourceLineTest, AFigureNotYetMeasuredIsLeftOut) {
+  EXPECT_EQ(u"312 MB", FormatTabResourceLine(Figures(
+                           base::MiB(312), std::nullopt, std::nullopt)));
+  EXPECT_EQ(u"312 MB \u00B7 3.2 MB/s",
+            FormatTabResourceLine(Figures(base::MiB(312), std::nullopt,
+                                          base::MiB(3) + base::KiB(205))));
+  EXPECT_EQ(u"", FormatTabResourceLine(
+                     Figures(std::nullopt, 4.0, base::ByteSize(0))));
+  EXPECT_EQ(u"", FormatTabResourceLine(
+                     Figures(base::ByteSize(0), 4.0, base::ByteSize(0))));
+  EXPECT_EQ(u"Asleep", TabResourceLineAsleep());
+}
+
+// CPU use between two readings of a cumulative CPU time, in percent of one
+// core.
+TEST_F(TabResourceLineTest, CpuIsTheShareOfTheTimeBetweenTwoReadings) {
+  const base::TimeTicks start = base::TimeTicks() + base::Seconds(100);
+  const base::TimeTicks second_on = start + base::Seconds(1);
+  EXPECT_DOUBLE_EQ(5.0, *CpuPercentBetween(base::Milliseconds(100), start,
+                                           base::Milliseconds(150), second_on));
+  EXPECT_DOUBLE_EQ(200.0, *CpuPercentBetween(base::Seconds(1), start,
+                                             base::Seconds(3), second_on));
+  EXPECT_DOUBLE_EQ(0.0, *CpuPercentBetween(base::Seconds(2), start,
+                                           base::Seconds(1), second_on));
+  EXPECT_FALSE(
+      CpuPercentBetween(base::Seconds(1), start, base::Seconds(2), start)
+          .has_value());
+  EXPECT_FALSE(
+      CpuPercentBetween(base::Seconds(1), second_on, base::Seconds(2), start)
+          .has_value());
+}
+
+std::u16string MemoryRowText(FooterView& footer) {
+  return std::u16string(footer.GetPerformanceRowForTesting()
+                            ->GetPrimaryViewForTesting()
+                            ->footer_label()
+                            ->GetText());
+}
+
+// The line is the footer's last row, and keeps the footer by itself. While
+// it shows, Chromium's plain memory row, an older reading of the same
+// figure, is left out; the high-memory alert stays.
+TEST_F(TabResourceLineTest, TheLineIsTheFootersLastRow) {
+  FooterView footer;
+  footer.SetPerformanceData({/*show_memory_usage=*/true,
+                             /*is_high_memory_usage=*/false, base::MiB(300)});
+  ASSERT_FALSE(MemoryRowText(footer).empty());
+  EXPECT_FALSE(footer.HasResourceLine());
+
+  footer.SetResourceLine(u"312 MB \u00B7 CPU 4% \u00B7 0 B/s");
+  EXPECT_TRUE(footer.HasResourceLine());
+  EXPECT_TRUE(footer.GetVisible());
+  EXPECT_EQ(static_cast<views::View*>(footer.GetResourceLineForTesting()),
+            footer.children().back().get());
+  EXPECT_EQ(u"312 MB \u00B7 CPU 4% \u00B7 0 B/s",
+            std::u16string(footer.GetResourceLineForTesting()->GetText()));
+  EXPECT_TRUE(MemoryRowText(footer).empty())
+      << "Chromium's memory row repeats the line's figure";
+
+  footer.SetPerformanceData({true, false, base::MiB(310)});
+  EXPECT_TRUE(MemoryRowText(footer).empty())
+      << "a new reading brought Chromium's memory row back under the line";
+
+  footer.SetPerformanceData({true, true, base::MiB(900)});
+  EXPECT_FALSE(MemoryRowText(footer).empty())
+      << "the high-memory alert left with the line";
+
+  footer.SetPerformanceData({true, false, base::MiB(300)});
+  footer.SetResourceLine(std::u16string());
+  EXPECT_FALSE(footer.HasResourceLine());
+  EXPECT_FALSE(footer.GetResourceLineForTesting()->GetVisible());
+  EXPECT_FALSE(MemoryRowText(footer).empty())
+      << "Chromium's memory row did not come back with the line gone";
+
+  footer.SetPerformanceData(PerformanceRowData());
+  EXPECT_FALSE(footer.GetVisible()) << "an empty footer stays";
+  footer.SetResourceLine(TabResourceLineAsleep());
+  EXPECT_TRUE(footer.GetVisible()) << "the line alone has no footer";
+}
+
+}  // namespace
+}  // namespace stedding
