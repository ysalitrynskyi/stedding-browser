@@ -0,0 +1,190 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The note on how to leave full screen (docs/features/toolbar.md T45,
+// settings T24). Full screen the person starts -- the menu, the green button,
+// the chord, F11, the command bar -- shows Chromium's note ("Press and hold
+// Esc to exit full screen") only while "Show how to leave full screen" is on,
+// which it is not by default (the owner, 2026-10-21). A page's own full
+// screen always shows its note, which names the site: it is what tells a
+// person that a page filling the screen is not the browser.
+
+#include "base/memory/scoped_refptr.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/test/run_until.h"
+#include "base/test/test_mock_time_task_runner.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/exclusive_access/exclusive_access_bubble_type.h"
+#include "chrome/browser/ui/exclusive_access/exclusive_access_context.h"
+#include "chrome/browser/ui/exclusive_access/exclusive_access_manager.h"
+#include "chrome/browser/ui/exclusive_access/fullscreen_controller.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/input/native_web_keyboard_event.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/blink/public/common/input/web_input_event.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace {
+
+class FullscreenHintTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  ExclusiveAccessManager* manager() {
+    return ExclusiveAccessManager::From(browser());
+  }
+  FullscreenController* fullscreen() {
+    return manager()->fullscreen_controller();
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  content::WebContents* contents() {
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  // The note is on screen, or on its way: Chromium's own tests ask the same.
+  bool NoteShown() {
+    return manager()->context()->IsExclusiveAccessBubbleDisplayed();
+  }
+
+  // Runs what is already posted: the window's change of state updates the
+  // note in its turn, so after this it shows or it never will.
+  static void RunPostedTasks() {
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, run_loop.QuitClosure());
+    run_loop.Run();
+  }
+
+  // Esc down or up, as the window hands a key to the full-screen manager.
+  void SendEsc(bool down) {
+    input::NativeWebKeyboardEvent event(
+        down ? blink::WebInputEvent::Type::kRawKeyDown
+             : blink::WebInputEvent::Type::kKeyUp,
+        blink::WebInputEvent::kNoModifiers,
+        blink::WebInputEvent::GetStaticTimeStampForTests());
+    event.windows_key_code = ui::VKEY_ESCAPE;
+    manager()->HandleUserKeyEvent(event);
+  }
+
+  // The page asks for full screen, as a video's button does, and gets it.
+  void PageEntersFullScreen() {
+    ASSERT_TRUE(content::ExecJs(contents(),
+                                "document.documentElement.requestFullscreen()"));
+    ui_test_utils::FullscreenWaiter(browser(), {.tab_fullscreen = true}).Wait();
+    ASSERT_TRUE(fullscreen()->IsTabFullscreen());
+  }
+
+  void PageLeavesFullScreen() {
+    ASSERT_TRUE(content::ExecJs(contents(), "document.exitFullscreen()"));
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return !fullscreen()->IsTabFullscreen(); }));
+  }
+};
+
+// toolbar T45: by default full screen the person starts shows no note, and
+// nor does Esc pressed in it, which Chromium answers with the note after half
+// a second. With "Show how to leave full screen" on, the next full screen
+// shows Chromium's note.
+IN_PROC_BROWSER_TEST_F(FullscreenHintTest,
+                       YourOwnFullScreenShowsNoNoteUntilTheSwitchIsOn) {
+  EXPECT_FALSE(prefs()->GetBoolean(stedding::prefs::kFullscreenHint))
+      << "on by default";
+
+  {
+    SCOPED_TRACE("the switch off");
+    ui_test_utils::ToggleFullscreenModeAndWait(browser());
+    ASSERT_TRUE(fullscreen()->IsFullscreenForBrowser());
+    RunPostedTasks();
+    EXPECT_EQ(EXCLUSIVE_ACCESS_BUBBLE_TYPE_NONE,
+              manager()->GetExclusiveAccessExitBubbleType());
+    EXPECT_FALSE(NoteShown()) << "full screen showed how to leave it";
+
+    {
+      auto task_runner = base::MakeRefCounted<base::TestMockTimeTaskRunner>();
+      base::TestMockTimeTaskRunner::ScopedContext scoped_context(
+          task_runner.get());
+      SendEsc(/*down=*/true);
+      task_runner->FastForwardBy(base::Milliseconds(600));
+      EXPECT_FALSE(NoteShown()) << "Esc held in it showed the note";
+      SendEsc(/*down=*/false);
+    }
+    EXPECT_TRUE(fullscreen()->IsFullscreenForBrowser())
+        << "a short press of Esc left full screen";
+
+    ui_test_utils::ToggleFullscreenModeAndWait(browser());
+    ASSERT_FALSE(fullscreen()->IsFullscreenForBrowser());
+  }
+
+  {
+    SCOPED_TRACE("the switch on");
+    prefs()->SetBoolean(stedding::prefs::kFullscreenHint, true);
+    ui_test_utils::ToggleFullscreenModeAndWait(browser());
+    ASSERT_TRUE(fullscreen()->IsFullscreenForBrowser());
+    EXPECT_EQ(EXCLUSIVE_ACCESS_BUBBLE_TYPE_BROWSER_FULLSCREEN_EXIT_INSTRUCTION,
+              manager()->GetExclusiveAccessExitBubbleType());
+    EXPECT_TRUE(base::test::RunUntil([&]() { return NoteShown(); }))
+        << "with the switch on, full screen did not say how to leave it";
+    ui_test_utils::ToggleFullscreenModeAndWait(browser());
+  }
+}
+
+// toolbar T45: with the switch off, a page's own full screen shows Chromium's
+// note, on its own and over a full screen the person started; when the page
+// leaves, the person's full screen goes back to showing nothing.
+IN_PROC_BROWSER_TEST_F(FullscreenHintTest, APagesFullScreenAlwaysShowsItsNote) {
+  ASSERT_FALSE(prefs()->GetBoolean(stedding::prefs::kFullscreenHint));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("video.test", "/title1.html")));
+
+  {
+    SCOPED_TRACE("a page's full screen");
+    ASSERT_NO_FATAL_FAILURE(PageEntersFullScreen());
+    EXPECT_EQ(EXCLUSIVE_ACCESS_BUBBLE_TYPE_FULLSCREEN_EXIT_INSTRUCTION,
+              manager()->GetExclusiveAccessExitBubbleType());
+    EXPECT_TRUE(base::test::RunUntil([&]() { return NoteShown(); }))
+        << "a page took the screen without a note";
+    ASSERT_NO_FATAL_FAILURE(PageLeavesFullScreen());
+    ui_test_utils::FullscreenWaiter(
+        browser(), ui_test_utils::FullscreenWaiter::kNoFullscreen)
+        .Wait();
+  }
+
+  {
+    SCOPED_TRACE("a page's full screen over the person's");
+    ui_test_utils::ToggleFullscreenModeAndWait(browser());
+    ASSERT_TRUE(fullscreen()->IsFullscreenForBrowser());
+    RunPostedTasks();
+    ASSERT_FALSE(NoteShown());
+    ASSERT_NO_FATAL_FAILURE(PageEntersFullScreen());
+    EXPECT_EQ(EXCLUSIVE_ACCESS_BUBBLE_TYPE_FULLSCREEN_EXIT_INSTRUCTION,
+              manager()->GetExclusiveAccessExitBubbleType());
+    EXPECT_TRUE(base::test::RunUntil([&]() { return NoteShown(); }))
+        << "a page took the screen without a note";
+    ASSERT_NO_FATAL_FAILURE(PageLeavesFullScreen());
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return fullscreen()->IsFullscreenForBrowser(); }));
+    EXPECT_EQ(EXCLUSIVE_ACCESS_BUBBLE_TYPE_NONE,
+              manager()->GetExclusiveAccessExitBubbleType());
+    EXPECT_TRUE(base::test::RunUntil([&]() { return !NoteShown(); }))
+        << "the page's note stayed over the person's own full screen";
+    ui_test_utils::ToggleFullscreenModeAndWait(browser());
+  }
+}
+
+}  // namespace
