diff --git a/chrome/browser/ui/views/tabs/vertical/sidebar_address.cc b/chrome/browser/ui/views/tabs/vertical/sidebar_address.cc
index e9b95c9612022..120ec0d63aaa0 100644
--- a/chrome/browser/ui/views/tabs/vertical/sidebar_address.cc
+++ b/chrome/browser/ui/views/tabs/vertical/sidebar_address.cc
@@ -647,6 +647,39 @@ void SidebarAddressField::Layout(PassKey) {
   if (shown(buttons_host_)) {
     place(buttons_host_, host_width);
   }
+  // A wider field, or a shorter name, is more room: the extensions' row
+  // asks again what it may take (GetAvailableSize).
+  if (const int room_now = RoomForButtons(); room_now != room_for_buttons_) {
+    room_for_buttons_ = room_now;
+    for (views::View* const child : buttons_host_->children()) {
+      child->InvalidateLayout();
+    }
+  }
+}
+
+int SidebarAddressField::RoomForButtons() const {
+  // As Layout reckons it: the field less its insets, the site button, Copy
+  // Link and the words' margin, and the words' minimum.
+  const gfx::Insets* const label_margins =
+      label_->GetProperty(views::kMarginsKey);
+  int fixed = label_margins ? label_margins->left() : 0;
+  for (const views::View* view : {static_cast<const views::View*>(site_button_),
+                                  static_cast<const views::View*>(copy_link_)}) {
+    if (view->GetVisible()) {
+      fixed += view->GetPreferredSize().width();
+    }
+  }
+  const int room = GetContentsBounds().width() - 2 * kFieldButtonInset - fixed;
+  return std::max(
+      0, room - std::min(kFieldTextMinimum, label_->GetPreferredSize().width()));
+}
+
+views::SizeBounds SidebarAddressField::GetAvailableSize(
+    const views::View* child) const {
+  if (child == buttons_host_) {
+    return views::SizeBounds(RoomForButtons(), views::SizeBound());
+  }
+  return views::Button::GetAvailableSize(child);
 }
 
