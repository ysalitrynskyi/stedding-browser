+// sidebar Y17, toolbar T32 (BACKLOG S-454; the owner, 2026-11-09): in macOS's
+// real full screen with the row always shown, the traffic lights share the
+// address row's line, at its left: AppKit brought them in on a strip of their
+// own above the row, which dropped under it when the pointer reached the
+// screen's top. The sidebar's toggle sits after them on their centre where
+// the strip's column has room, as in a window (sidebar Y7); the rail keeps it
+// as its own first row; beside a hidden sidebar the row starts past them. With
+// the row hidden they keep the title bar's own strip, and leaving full screen
+// leaves the window as it was.
+IN_PROC_BROWSER_TEST_F(WindowButtonsTest, InFullScreenTheLightsShareTheRow) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  views::Widget* const widget = browser_view->GetWidget();
+  NSWindow* const window = widget->GetNativeWindow().GetNativeNSWindow();
+  ASSERT_TRUE(window);
+  stedding::test::KeepAboveOtherWindows(widget);
+  tabs::VerticalTabStripStateController* const sidebar =
+      tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(sidebar);
+  sidebar->SetExpandOnHoverEnabled(false);
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  const auto settle = [&] {
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+    views::test::RunScheduledLayout(widget);
+  };
+  const auto light = [&](NSWindowButton type) {
+    NSButton* const button = [window standardWindowButton:type];
+    return button && button.window ? ScreenFrame(button.window, button)
+                                   : gfx::Rect();
+  };
+  const auto toggle = [&]() -> views::View* {
+    for (views::View* const child :
+         browser_view->top_container()->children()) {
+      if (views::IsViewClass<SteddingFullscreenSidebarToggle>(child)) {
+        return child->GetVisible() ? child : nullptr;
+      }
+    }
+    return nullptr;
+  };
+  // The lights' centre lies on the row's line: within the top container,
+  // which holds the row in full screen.
+  const auto on_the_row = [&] {
+    views::test::RunScheduledLayout(widget);
+    const gfx::Rect row = browser_view->top_container()->GetBoundsInScreen();
+    const int centre = light(NSWindowCloseButton).CenterPoint().y();
+    return row.height() > 20 && centre > row.y() && centre < row.bottom();
+  };
+
+  ui_test_utils::ToggleFullscreenModeAndWait(browser());
+  ASSERT_TRUE(widget->IsFullscreen());
+  EXPECT_TRUE(base::test::RunUntil(on_the_row))
+      << "the lights at " << light(NSWindowCloseButton).ToString()
+      << ", the row at "
+      << browser_view->top_container()->GetBoundsInScreen().ToString();
+  const gfx::Rect zoom = light(NSWindowZoomButton);
+
+  {
+    SCOPED_TRACE("the open sidebar: the toggle after the lights, on their line");
+    views::View* const copy = toggle();
+    ASSERT_TRUE(copy);
+    const gfx::Rect at = copy->GetBoundsInScreen();
+    EXPECT_GE(at.x(), zoom.right()) << "the toggle under the lights";
+    EXPECT_NEAR(at.CenterPoint().y(), zoom.CenterPoint().y(), 2);
+  }
+  {
+    SCOPED_TRACE("the rail: its own toggle, the row where the card is");
+    prefs->SetInteger(stedding::prefs::kSidebarClosedForm,
+                      stedding::prefs::kSidebarClosedToIcons);
+    sidebar->RequestCollapse(true);
+    settle();
+    EXPECT_TRUE(on_the_row());
+    EXPECT_FALSE(toggle()) << "a toggle on the row past the rail's column";
+    const gfx::Rect card =
+        browser_view->multi_contents_view()->GetBoundsInScreen();
+    // The card is the contents view less its gutter.
+    EXPECT_NEAR(browser_view->toolbar()->GetBoundsInScreen().x(),
+                card.x() +
+                    VerticalTabStripRegionView::SteddingCardGutter(browser_view),
+                1)
+        << "the row and the card below it start apart";
+    EXPECT_LE(zoom.right(), card.x());
+  }
+  {
+    SCOPED_TRACE("a hidden sidebar: the row starts past the lights");
+    prefs->SetInteger(stedding::prefs::kSidebarClosedForm,
+                      stedding::prefs::kSidebarClosedHidden);
+    settle();
+    EXPECT_TRUE(on_the_row());
+    EXPECT_GE(browser_view->toolbar()->GetBoundsInScreen().x(), zoom.right())
+        << "the row's contents under the lights";
+  }
+  {
+    SCOPED_TRACE("the row hidden: the title bar's own strip");
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(widget);
+      return !browser_view->IsToolbarVisible();
+    }));
+    EXPECT_TRUE(base::test::RunUntil([&] { return !on_the_row(); }));
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW);
+    EXPECT_TRUE(base::test::RunUntil(on_the_row)) << "the row came back";
+  }
+
+  sidebar->RequestCollapse(false);
+  settle();
+  ui_test_utils::ToggleFullscreenModeAndWait(browser());
+  ASSERT_FALSE(widget->IsFullscreen());
+  EXPECT_FALSE(window.toolbar) << "full screen left its toolbar behind";
+  for (const NSWindowButton type :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    EXPECT_FALSE([[window standardWindowButton:type] isHidden]);
+  }
+}
