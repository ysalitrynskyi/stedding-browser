+// import I40 (P09-1e): Arc's history and passwords obey the policies the
+// imports from Dia and Safari obey. A part a policy turns off is not read and
+// nothing of it is written, the history's mark stays where it was, and the
+// result says which part was turned off. The Arc import asked no policy.
+TEST(ArcImportPolicyW2B09Test, APartAPolicyTurnsOffIsNotRead) {
+  content::BrowserTaskEnvironment task_environment;
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const GURL page("https://recent.example/");
+  ArcDataPaths paths;
+  paths.history = dir.GetPath().AppendASCII("History");
+  ASSERT_NO_FATAL_FAILURE(WriteHistoryW2B09(
+      paths.history, {{page.spec(), base::Time::Now() - base::Days(1)}}));
+  std::unique_ptr<TestingProfile> profile = ProfileWithHistoryW2B09();
+  profile->GetTestingPrefService()->SetManagedPref(::prefs::kImportHistory,
+                                                   base::Value(false));
+  profile->GetTestingPrefService()->SetManagedPref(
+      ::prefs::kImportSavedPasswords, base::Value(false));
+
+  base::test::TestFuture<ArcDataResult> done;
+  ImportArcDataAsync(profile.get(), /*history=*/true, /*passwords=*/true,
+                     done.GetCallback(), paths);
+  EXPECT_EQ(0u, done.Get().history) << "history a policy turns off came in";
+  EXPECT_TRUE(done.Get().history_blocked);
+  EXPECT_EQ(0u, done.Get().passwords);
+  EXPECT_TRUE(done.Get().passwords_blocked);
+  EXPECT_FALSE(done.Get().keychain_denied);
+  EXPECT_FALSE(HistoryHoldsW2B09(profile.get(), page));
+  EXPECT_TRUE(profile->GetPrefs()
+                  ->GetTime(stedding::prefs::kArcImportedHistoryThrough)
+                  .is_null())
+      << "the mark moved past history that never came";
+
+  // The result line names each part a policy turned off.
+  ArcImportResult result;
+  result.history_blocked = true;
+  result.passwords_blocked = true;
+  const std::u16string line = DescribeArcImportResult(result);
+  EXPECT_NE(std::u16string::npos,
+            line.find(u"history skipped: your administrator has turned it off"))
+      << line;
+  EXPECT_NE(
+      std::u16string::npos,
+      line.find(u"passwords skipped: your administrator has turned it off"))
+      << line;
+}
