diff --git a/chrome/browser/ui/spaces/space_model.cc b/chrome/browser/ui/spaces/space_model.cc
new file mode 100644
index 0000000000000..649769b3e69da
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_model.cc
@@ -0,0 +1,592 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_model.h"
+
+#include <algorithm>
+#include <tuple>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/token.h"
+#include "base/values.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_init_state.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/stedding_ui_metrics.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/browser/ui/tabs/tab_strip_user_gesture_details.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace spaces {
+
+DEFINE_USER_DATA(SpaceModel);
+
+// static
+SpaceModel* SpaceModel::From(BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+namespace {
+// Every window starts with one Space so that "no Space" is never a state a
+// caller has to handle. It is deliberately unnamed: a single unnamed Space is
+// indistinguishable from an ordinary window, which is what a user who has never
+// heard of Spaces should see.
+constexpr SkColor kDefaultSpaceColor = SkColorSetRGB(0x5B, 0x6B, 0x8C);
+}  // namespace
+
+// SpaceId has no default constructor by design — an id that names nothing is not
+// a state worth representing — so the default Space's id is generated first and
+// used for both the Space and the active pointer. No observer can exist yet, so
+// this deliberately does not notify.
+SpaceModel::SpaceModel() : active_id_(SpaceId::GenerateNew()) {
+  spaces_.push_back(std::make_unique<Space>(active_id_, std::string(),
+                                            kDefaultSpaceColor));
+}
+
+SpaceModel::SpaceModel(BrowserWindowInterface& browser) : SpaceModel() {
+  scoped_user_data_.emplace(browser.GetUnownedUserDataHost(), *this);
+
+  // Once per process: the session log is rebuilt from the live browser at
+  // startup and periodically, and Spaces must be re-emitted into it or they
+  // survive exactly one restart (stedding_session_rebuild.h).
+  static const bool registered = [] {
+    stedding::AddSessionRebuildProvider(
+        "spaces", base::BindRepeating(&SpaceModel::AppendRebuildCommands));
+    return true;
+  }();
+  std::ignore = registered;
+
+  // Spaces written into the session on a previous run come back here, before
+  // anything can ask which Space a tab is in.
+  if (Browser* const browser_impl = browser.GetBrowserForMigrationOnly()) {
+    session_service_ =
+        SessionServiceFactory::GetForProfile(browser_impl->GetProfile());
+    session_id_ = browser_impl->GetSessionID();
+    if (const BrowserInitState* const init =
+            BrowserInitState::From(browser_impl)) {
+      RestoreFrom(init->initial_spaces());
+    }
+  }
+
+  // A window can be asked to start with more than one Space so that multi-Space
+  // states can be screenshotted and tested. Zero in normal use.
+  for (int i = 0; i < stedding::kExtraSpacesForTesting.Get(); ++i) {
+    AddSpace(std::string(), kDefaultSpaceColor);
+  }
+
+  tab_strip_model_ = browser.GetTabStripModel();
+  CHECK(tab_strip_model_);
+
+  // Teach this window's tab strip that a tab outside the active Space is a tab
+  // the user cannot see. Tab traversal and the choice of which tab to activate
+  // next both consult this, so no keystroke lands on a tab from another Space
+  // (B7). Unretained is safe: the predicate is cleared when the strip goes
+  // away (OnTabStripModelDestroyed) and the model outlives the strip's use of
+  // it otherwise.
+  tab_strip_model_->SetHiddenTabPredicate(base::BindRepeating(
+      [](SpaceModel* model, const tabs::TabInterface* tab) {
+        return !model->IsTabInActiveSpace(tab);
+      },
+      base::Unretained(this)));
+
+  // Membership is decided on insertion (B1). The window's features are built
+  // before its first tab, so this normally observes an empty strip; any tab
+  // already there joins now so the two paths cannot disagree.
+  tab_strip_model_->AddObserver(this);
+  for (int i = 0; i < tab_strip_model_->count(); ++i) {
+    SpaceForTab(tab_strip_model_->GetTabAtIndex(i));
+  }
+}
+
+SpaceModel::~SpaceModel() {
+  if (tab_strip_model_) {
+    tab_strip_model_->SetHiddenTabPredicate(TabStripModel::HiddenTabPredicate());
+    tab_strip_model_->RemoveObserver(this);
+    tab_strip_model_ = nullptr;
+  }
+}
+
+void SpaceModel::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void SpaceModel::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+Space* SpaceModel::active_space() {
+  Space* space = GetSpace(active_id_);
+  CHECK(space) << "active_id_ must always name a live Space";
+  return space;
+}
+
+Space* SpaceModel::GetSpace(const SpaceId& id) {
+  auto it = std::ranges::find_if(
+      spaces_, [&id](const std::unique_ptr<Space>& s) { return s->id() == id; });
+  return it == spaces_.end() ? nullptr : it->get();
+}
+
+std::u16string SpaceModel::DisplayName(const SpaceId& id) const {
+  for (size_t i = 0; i < spaces_.size(); ++i) {
+    if (spaces_[i]->id() != id) {
+      continue;
+    }
+    if (!spaces_[i]->name().empty()) {
+      return base::UTF8ToUTF16(spaces_[i]->name());
+    }
+    return u"Space " + base::NumberToString16(i + 1);
+  }
+  return std::u16string();
+}
+
+// static
+void SpaceModel::AppendRebuildCommands(
+    BrowserWindowInterface* browser,
+    stedding::SessionRebuildCommands* commands) {
+  SpaceModel* const model = From(browser);
+  if (!model) {
+    return;
+  }
+  commands->push_back(sessions::CreateAddWindowExtraDataCommand(
+      browser->GetSessionID(), kSessionSpacesKey, model->Serialize()));
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    const SessionID tab_id =
+        sessions::SessionTabHelper::IdForTab(tab->GetContents());
+    if (!tab_id.is_valid()) {
+      continue;
+    }
+    commands->push_back(sessions::CreateAddTabExtraDataCommand(
+        tab_id, kSessionTabSpaceKey, model->SpaceForTab(tab).ToString()));
+    if (model->IsSpacePinned(tab)) {
+      commands->push_back(sessions::CreateAddTabExtraDataCommand(
+          tab_id, kSessionTabSpacePinKey, "1"));
+    }
+  }
+}
+
+Space* SpaceModel::AddSpace(std::string name, SkColor color) {
+  spaces_.push_back(
+      std::make_unique<Space>(SpaceId::GenerateNew(), std::move(name), color));
+  Space* added = spaces_.back().get();
+  observers_.Notify(&Observer::OnSpaceAdded, added->id());
+  SaveToSession();
+  return added;
+}
+
+bool SpaceModel::RemoveSpace(const SpaceId& id) {
+  // A window must always have somewhere for its tabs to live, and removing the
+  // active Space would orphan the tabs currently in the tab strip. Both are
+  // refused rather than half-handled.
+  if (spaces_.size() <= 1u || id == active_id_) {
+    return false;
+  }
+  auto it = std::ranges::find_if(
+      spaces_, [&id](const std::unique_ptr<Space>& s) { return s->id() == id; });
+  if (it == spaces_.end()) {
+    return false;
+  }
+  spaces_.erase(it);
+  last_active_.erase(id);
+
+  // The Space's tabs are not closed: deleting a container must not delete its
+  // contents (B5). They join the active Space, where the user is looking, so
+  // nothing disappears without a trace.
+  std::vector<tabs::TabInterface*> moved;
+  for (auto& [handle, space_id] : tab_spaces_) {
+    if (space_id == id) {
+      space_id = active_id_;
+      if (tabs::TabInterface* const tab = handle.Get()) {
+        SaveTabToSession(tab, active_id_);
+        moved.push_back(tab);
+      }
+    }
+  }
+  for (tabs::TabInterface* const tab : moved) {
+    observers_.Notify(&Observer::OnTabSpaceChanged, tab);
+  }
+
+  observers_.Notify(&Observer::OnSpaceRemoved, id);
+  SaveToSession();
+  return true;
+}
+
+void SpaceModel::SetActiveSpace(const SpaceId& id) {
+  CHECK(GetSpace(id)) << "cannot activate a Space this window does not have";
+  if (id == active_id_) {
+    return;
+  }
+  const SpaceId previous = active_id_;
+  active_id_ = id;
+  // The content pane must follow the sidebar: settle the active tab before any
+  // observer hides the old one, so there is never a frame where the active tab
+  // is one the user cannot see (B3).
+  EnsureActiveSpaceHasAVisibleTab();
+  observers_.Notify(&Observer::OnActiveSpaceChanged, previous, active_id_);
+  SaveToSession();
+}
+
+void SpaceModel::EnsureActiveSpaceHasAVisibleTab() {
+  if (!tab_strip_model_ || tab_strip_model_->closing_all() ||
+      tab_strip_model_->empty()) {
+    return;
+  }
+  if (const tabs::TabInterface* const active = tab_strip_model_->GetActiveTab();
+      active && IsTabInActiveSpace(active)) {
+    return;
+  }
+
+  // Where the user left this Space, if that tab is still here and still in it.
+  if (const auto it = last_active_.find(active_id_); it != last_active_.end()) {
+    if (tabs::TabInterface* const remembered = it->second.Get()) {
+      const int index = tab_strip_model_->GetIndexOfTab(remembered);
+      if (index != TabStripModel::kNoTab && IsTabInActiveSpace(remembered) &&
+          !tab_strip_model_->IsTabHidden(index)) {
+        tab_strip_model_->ActivateTabAt(
+            index, TabStripUserGestureDetails(
+                       TabStripUserGestureDetails::GestureType::kOther));
+        return;
+      }
+    }
+  }
+
+  // A tab that belongs to the Space beats an essentials tab, which is visible
+  // everywhere and so tells the user nothing about where they are.
+  int essentials = TabStripModel::kNoTab;
+  for (int i = 0; i < tab_strip_model_->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(i);
+    if (!IsTabInActiveSpace(tab) || tab_strip_model_->IsTabHidden(i)) {
+      continue;
+    }
+    if (tab->IsPinned()) {
+      if (essentials == TabStripModel::kNoTab) {
+        essentials = i;
+      }
+      continue;
+    }
+    tab_strip_model_->ActivateTabAt(
+        i, TabStripUserGestureDetails(
+               TabStripUserGestureDetails::GestureType::kOther));
+    return;
+  }
+  if (essentials != TabStripModel::kNoTab) {
+    tab_strip_model_->ActivateTabAt(
+        essentials, TabStripUserGestureDetails(
+                        TabStripUserGestureDetails::GestureType::kOther));
+    return;
+  }
+
+  // Nothing to show: the Space is empty. A window cannot have no active tab,
+  // and Arc's answer is the same -- an empty Space opens on a new tab. The
+  // insertion observer files it under the active Space.
+  if (TabStripModelDelegate* const delegate = tab_strip_model_->delegate()) {
+    delegate->AddTabAt(GURL(chrome::kChromeUINewTabURL), /*index=*/-1,
+                       /*foreground=*/true);
+  }
+}
+
+void SpaceModel::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  // Remember where the user is in the active Space, but only a tab that is
+  // really in it: an essentials tab is in every Space and remembering it would
+  // make every Space reopen on the same tab.
+  if (selection.active_tab_changed()) {
+    if (tabs::TabInterface* const active = tab_strip_model->GetActiveTab();
+        active && !active->IsPinned()) {
+      if (const auto it = tab_spaces_.find(active->GetHandle());
+          it != tab_spaces_.end() && it->second == active_id_) {
+        last_active_.insert_or_assign(active_id_, active->GetHandle());
+      }
+    }
+  }
+
+  if (change.type() == TabStripModelChange::Type::kInserted) {
+    // The session service only writes the Space list when something changes
+    // it, and it drops the previous run's log at startup. A run in which the
+    // user never touched Spaces would therefore leave a log with no Spaces in
+    // it. The window is tracked by the time its first tab arrives, so this is
+    // the earliest moment the list can be written for the new log.
+    if (!wrote_window_state_) {
+      wrote_window_state_ = true;
+      SaveToSession();
+    }
+    for (const TabStripModelChange::ContentsWithIndex& inserted :
+         change.GetInsert()->contents) {
+      // First ask decides membership: restored Space if any, else active.
+      SpaceForTab(inserted.tab);
+    }
+    return;
+  }
+
+  if (change.type() == TabStripModelChange::Type::kRemoved) {
+    for (const TabStripModelChange::RemovedTab& removed :
+         change.GetRemove()->contents) {
+      tab_spaces_.erase(removed.tab->GetHandle());
+      space_pinned_.erase(removed.tab->GetHandle());
+    }
+    // The strip has already chosen a replacement active tab, and with every
+    // tab of this Space gone that choice is a hidden one. Fixing it here
+    // would re-enter the strip mid-notification, so it waits a turn (B4).
+    if (!tab_strip_model->closing_all() && !tab_strip_model->empty()) {
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE,
+          base::BindOnce(&SpaceModel::EnsureActiveSpaceHasAVisibleTab,
+                         weak_factory_.GetWeakPtr()));
+    }
+  }
+}
+
+void SpaceModel::OnTabStripModelDestroyed(TabStripModel* tab_strip_model) {
+  if (tab_strip_model == tab_strip_model_) {
+    tab_strip_model_ = nullptr;
+  }
+}
+
+void SpaceModel::SetSpaceName(const SpaceId& id, std::string name) {
+  Space* space = GetSpace(id);
+  if (!space) {
+    return;
+  }
+  space->SetName(std::move(name));
+  observers_.Notify(&Observer::OnSpaceMetadataChanged, id);
+  SaveToSession();
+}
+
+void SpaceModel::SetSpaceColor(const SpaceId& id, SkColor color) {
+  Space* space = GetSpace(id);
+  if (!space) {
+    return;
+  }
+  space->SetColor(color);
+  observers_.Notify(&Observer::OnSpaceMetadataChanged, id);
+  SaveToSession();
+}
+
+void SpaceModel::SetSpaceIcon(const SpaceId& id, std::string icon) {
+  Space* const space = GetSpace(id);
+  if (!space) {
+    return;
+  }
+  space->SetIcon(std::move(icon));
+  observers_.Notify(&Observer::OnSpaceMetadataChanged, id);
+  SaveToSession();
+}
+
+const SpaceId& SpaceModel::SpaceForTab(tabs::TabInterface* tab) {
+  CHECK(tab);
+  const auto [it, inserted] = tab_spaces_.try_emplace(tab->GetHandle(),
+                                                      SpaceIdForNewTab(tab));
+  if (inserted) {
+    SaveTabToSession(tab, it->second);
+  }
+  return it->second;
+}
+
+SpaceId SpaceModel::SpaceIdForNewTab(tabs::TabInterface* tab) {
+  // A tab rebuilt from a session carries the Space it was in. Collect it here,
+  // the first time anything asks, because at the point the tab was rebuilt
+  // there was no window yet and so no model to tell.
+  if (content::WebContents* const contents = tab->GetContents()) {
+    if (const TabSpaceRestoreData* const restored =
+            TabSpaceRestoreData::FromWebContents(contents)) {
+      if (restored->space_pinned()) {
+        space_pinned_.insert(tab->GetHandle());
+      }
+      if (const std::optional<base::Token> token =
+              base::Token::FromString(restored->space_id());
+          token) {
+        const SpaceId id = SpaceId::FromRawToken(*token);
+        // Only if that Space came back too; otherwise the tab would belong to
+        // nothing and never be visible again (B2).
+        if (GetSpace(id)) {
+          return id;
+        }
+      }
+    }
+  }
+  return active_id_;
+}
+
+void SpaceModel::SaveTabToSession(tabs::TabInterface* tab, const SpaceId& id) {
+  if (!session_service_ || !session_id_.is_valid()) {
+    return;
+  }
+  content::WebContents* const contents = tab->GetContents();
+  if (!contents) {
+    return;
+  }
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!tab_id.is_valid()) {
+    return;
+  }
+  session_service_->AddTabExtraData(session_id_, tab_id, kSessionTabSpaceKey,
+                                    id.ToString());
+}
+
+void SpaceModel::SetSpaceForTab(tabs::TabInterface* tab, const SpaceId& id) {
+  CHECK(tab);
+  if (!GetSpace(id)) {
+    return;
+  }
+  // Not operator[]: SpaceId has no default constructor, by design.
+  const auto it = tab_spaces_.find(tab->GetHandle());
+  if (it != tab_spaces_.end() && it->second == id) {
+    return;
+  }
+  tab_spaces_.insert_or_assign(tab->GetHandle(), id);
+  SaveTabToSession(tab, id);
+  observers_.Notify(&Observer::OnTabSpaceChanged, tab);
+}
+
+bool SpaceModel::IsTabInActiveSpace(const tabs::TabInterface* tab) const {
+  if (!tab) {
+    return true;
+  }
+  // Pinned tabs sit above all Spaces -- the "essentials" row at the top of the
+  // sidebar, which stays put whichever Space is active. Chromium's pin state is
+  // per-window, which is exactly the scope that needs, so pinning a tab is what
+  // promotes it out of its Space (B6).
+  if (tab->IsPinned()) {
+    return true;
+  }
+  const auto it = tab_spaces_.find(tab->GetHandle());
+  // A tab this model has never seen is shown. Assigning it here would mean
+  // mutating from a predicate that traversal calls; insertion is where a tab
+  // is filed, and this is only the safety net.
+  return it == tab_spaces_.end() || it->second == active_id_;
+}
+
+bool SpaceModel::IsSpacePinned(const tabs::TabInterface* tab) const {
+  return tab && space_pinned_.contains(tab->GetHandle());
+}
+
+void SpaceModel::SetSpacePinned(tabs::TabInterface* tab, bool pinned) {
+  if (!tab) {
+    return;
+  }
+  if (pinned) {
+    space_pinned_.insert(tab->GetHandle());
+  } else {
+    space_pinned_.erase(tab->GetHandle());
+  }
+  if (session_service_ && session_id_.is_valid()) {
+    if (content::WebContents* const contents = tab->GetContents()) {
+      const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+      if (tab_id.is_valid()) {
+        session_service_->AddTabExtraData(session_id_, tab_id,
+                                          kSessionTabSpacePinKey,
+                                          pinned ? "1" : "0");
+      }
+    }
+  }
+}
+
+std::string SpaceModel::Serialize() const {
+  base::ListValue list;
+  for (const auto& space : spaces_) {
+    base::DictValue entry;
+    entry.Set("id", space->id().ToString());
+    entry.Set("name", space->name());
+    entry.Set("icon", space->icon());
+    entry.Set("color", static_cast<int>(space->color()));
+    list.Append(std::move(entry));
+  }
+  base::DictValue root;
+  root.Set("spaces", std::move(list));
+  root.Set("active", active_id_.ToString());
+
+  std::string out;
+  return base::JSONWriter::Write(root, &out) ? out : std::string();
+}
+
+void SpaceModel::RestoreFrom(const std::string& data) {
+  if (data.empty()) {
+    return;
+  }
+  const std::optional<base::Value> parsed =
+      base::JSONReader::Read(data, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+  const base::ListValue* const list = parsed->GetDict().FindList("spaces");
+  if (!list || list->empty()) {
+    return;
+  }
+
+  std::vector<std::unique_ptr<Space>> restored;
+  for (const base::Value& item : *list) {
+    if (!item.is_dict()) {
+      continue;
+    }
+    const base::DictValue& entry = item.GetDict();
+    const std::string* const id_text = entry.FindString("id");
+    if (!id_text) {
+      continue;
+    }
+    const std::optional<base::Token> token = base::Token::FromString(*id_text);
+    if (!token) {
+      continue;
+    }
+    const SpaceId id = SpaceId::FromRawToken(*token);
+    const std::string* const name = entry.FindString("name");
+    const std::string* const icon = entry.FindString("icon");
+    auto space = std::make_unique<Space>(
+        id, name ? *name : std::string(),
+        static_cast<SkColor>(entry.FindInt("color").value_or(
+            static_cast<int>(kDefaultSpaceColor))));
+    if (icon) {
+      space->SetIcon(*icon);
+    }
+    restored.push_back(std::move(space));
+  }
+  if (restored.empty()) {
+    return;
+  }
+
+  spaces_ = std::move(restored);
+
+  // The active Space must be one that came back; a session naming a Space that
+  // failed to parse would otherwise leave the window pointing at nothing.
+  active_id_ = spaces_.front()->id();
+  if (const std::string* const active = parsed->GetDict().FindString("active");
+      active) {
+    if (const std::optional<base::Token> token =
+            base::Token::FromString(*active);
+        token) {
+      const SpaceId id = SpaceId::FromRawToken(*token);
+      if (GetSpace(id)) {
+        active_id_ = id;
+      }
+    }
+  }
+}
+
+void SpaceModel::SaveToSession() {
+  if (session_service_ && session_id_.is_valid()) {
+    session_service_->AddWindowExtraData(session_id_, kSessionSpacesKey,
+                                         Serialize());
+  }
+}
+
+}  // namespace spaces
