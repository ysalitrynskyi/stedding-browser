+// K19 (BACKLOG S-164): a Space's name of several words is one filter, the
+// longest whole name wins and matches alone, and case folds in any script.
+TEST(SpaceQueryTest, AWholeNameOfSeveralWordsIsOneFilter) {
+  const std::vector<std::u16string> names = {
+      u"Work", u"Work Stuff", u"Work Stuff Archive", u"\u00dcber"};
+  const SpaceQuery stuff = ParseSpaceQuery(u"@work stuff rust", names);
+  ASSERT_TRUE(stuff.space_prefix);
+  EXPECT_EQ(u"Work Stuff", *stuff.space_prefix);
+  EXPECT_TRUE(stuff.whole_name);
+  EXPECT_EQ(u"rust", stuff.rest);
+  EXPECT_TRUE(SpaceNameMatches(stuff, u"Work Stuff"));
+  EXPECT_FALSE(SpaceNameMatches(stuff, u"Work Stuff Archive"))
+      << "a whole name matches that Space alone";
+  EXPECT_FALSE(SpaceNameMatches(stuff, u"Work"));
+
+  const SpaceQuery all = ParseSpaceQuery(u"@Work Stuff Archive", names);
+  ASSERT_TRUE(all.space_prefix);
+  EXPECT_EQ(u"Work Stuff Archive", *all.space_prefix);
+  EXPECT_TRUE(all.rest.empty());
+
+  const SpaceQuery partial = ParseSpaceQuery(u"@Wor rust", names);
+  ASSERT_TRUE(partial.space_prefix);
+  EXPECT_FALSE(partial.whole_name) << "no whole name: the first word";
+  EXPECT_EQ(u"Wor", *partial.space_prefix);
+  EXPECT_TRUE(SpaceNameMatches(partial, u"Work Stuff Archive"));
+
+  const SpaceQuery umlaut = ParseSpaceQuery(u"@\u00fc docs", names);
+  EXPECT_TRUE(SpaceNameMatches(umlaut, u"\u00dcber"))
+      << "a prefix folds case beyond ASCII";
+  EXPECT_TRUE(SpaceNameMatchesPrefix(u"\u00dcber", u"\u00fcb"));
+  const SpaceQuery whole = ParseSpaceQuery(u"@\u00fcber docs", names);
+  EXPECT_TRUE(whole.whole_name);
+  EXPECT_EQ(u"docs", whole.rest);
+}
+
 }  // namespace
 }  // namespace spaces
