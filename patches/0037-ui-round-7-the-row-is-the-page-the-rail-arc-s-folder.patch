+++ b/chrome/browser/ui/stedding/theme/page_theme_color_controller.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/stedding/theme/page_theme_color_controller.h"
 
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/tabs/tab_strip_model.h"
 #include "components/tabs/public/tab_interface.h"
@@ -101,11 +103,41 @@ void PageThemeColorController::Refresh() {
       color = SkColorSetA(*page, SK_AlphaOPAQUE);
     }
   }
+  SetColor(color);
+}
+
+void PageThemeColorController::SetColor(std::optional<SkColor> color) {
   if (color == color_) {
     return;
   }
   color_ = color;
+  // Not from inside the change. The active tab changes in the middle of the
+  // tab strip's own notification, before its views have caught up, and a
+  // window re-themed from there reached a folder header whose folder had
+  // already left the tree (closing every tab at quit, 2026-09-05, folders
+  // F12). One turn later the strip is consistent, and several changes in one
+  // turn re-theme once.
+  if (notify_pending_) {
+    return;
+  }
+  notify_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&PageThemeColorController::NotifyChanged,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void PageThemeColorController::NotifyChanged() {
+  notify_pending_ = false;
+  // Nothing to re-theme while the window empties itself.
+  if (browser_->GetTabStripModel()->closing_all()) {
+    return;
+  }
   changed_callbacks_.Notify();
 }
 
+void PageThemeColorController::SetColorForTesting(
+    std::optional<SkColor> color) {
+  SetColor(color);
+}
+
 }  // namespace stedding
