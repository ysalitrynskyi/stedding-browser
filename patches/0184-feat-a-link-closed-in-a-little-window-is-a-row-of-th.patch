+// A17 (BACKLOG S-159): a link closed in a little window is a row that says
+// so, as Arc keeps Little Arc's links in its archive; a plain popup's close
+// stays a closed window's.
+TEST(ArchivePageTest, ALittleWindowsLinkIsARowOfItsOwn) {
+  const base::Time now = base::Time::Now();
+  sessions::TabRestoreService::Entries entries;
+  auto little = std::make_unique<sessions::tab_restore::Window>();
+  little->id = SessionID::FromSerializedValue(30);
+  little->timestamp = now - base::Minutes(5);
+  little->window_type = sessions::SessionWindow::TYPE_POPUP;
+  little->extra_data[kSessionLittleWindowKey] = "1";
+  little->tabs.push_back(
+      ClosedTab(31, "https://link.example/", u"Link", base::Time(), nullptr));
+  entries.push_back(std::move(little));
+  auto popup = std::make_unique<sessions::tab_restore::Window>();
+  popup->id = SessionID::FromSerializedValue(40);
+  popup->timestamp = now - base::Minutes(10);
+  popup->window_type = sessions::SessionWindow::TYPE_POPUP;
+  popup->tabs.push_back(
+      ClosedTab(41, "https://popup.example/", u"Popup", base::Time(), nullptr));
+  entries.push_back(std::move(popup));
+
+  const std::vector<ArchivedTab> shown =
+      ListArchivedTabs(entries, now, base::Days(30));
+  ASSERT_EQ(2u, shown.size());
+  EXPECT_EQ(u"Link", shown[0].title);
+  EXPECT_EQ("little", shown[0].closed_with);
+  EXPECT_EQ(1, shown[0].closed_count);
+  const base::DictValue value = ArchivedTabToValue(shown[0]);
+  const std::string* const closed_with = value.FindString("closedWith");
+  ASSERT_TRUE(closed_with);
+  EXPECT_EQ("little", *closed_with);
+  EXPECT_EQ(u"Popup", shown[1].title);
+  EXPECT_EQ("window", shown[1].closed_with) << "a popup is not little";
+}
+
