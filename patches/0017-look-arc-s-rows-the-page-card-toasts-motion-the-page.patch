@@ -37,6 +37,21 @@ PageThemeColorController::~PageThemeColorController() {
   }
 }
 
+ui::ColorProviderKey::InitializerSupplier*
+PageThemeColorController::bar_supplier() const {
+  if (!color_) {
+    return nullptr;
+  }
+  // Quantised to 16 levels per channel: the eye does not see the difference
+  // on the icons, and it bounds how many providers one window can create.
+  const SkColor key = *color_ & 0xFFF0F0F0;
+  auto& supplier = const_cast<PageThemeColorController*>(this)->suppliers_[key];
+  if (!supplier) {
+    supplier = std::make_unique<PageBarColorSupplier>(key);
+  }
+  return supplier.get();
+}
