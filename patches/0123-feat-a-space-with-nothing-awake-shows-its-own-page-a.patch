+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// docs/features/tabs.md R66 (BACKLOG S-396): what a Space shows when it has
+// no row awake. The Space's name, the command bar's key, a tip at a time with
+// a drawing, and one quiet line to support the project. Nothing is fetched:
+// the drawings are made here, and the support link opens only on a click.
+// Plain DOM, as the welcome flow is; no innerHTML (Trusted Types).
+/* eslint-disable no-restricted-imports, no-restricted-properties */
+
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+
+interface SpaceInfo {
+  name: string;
+  color: string;
+  mac: boolean;
+}
+
+// A tip's words, with keys between braces: {Cmd+T} on the Mac's list and the
+// other on Windows's.
+interface Tip {
+  title: string;
+  mac: string;
+  other: string;
+  sketch: (svg: SVGSVGElement) => void;
+}
+
+const SVG_NS = 'http://www.w3.org/2000/svg';
+
+function svgEl(
+    parent: Element, tag: string, attributes: Record<string, string|number>):
+    SVGElement {
+  const node = document.createElementNS(SVG_NS, tag);
+  for (const [name, value] of Object.entries(attributes)) {
+    node.setAttribute(name, String(value));
+  }
+  parent.appendChild(node);
+  return node;
+}
+
+// A window seen from afar: its frame, the sidebar at its left with a few
+// rows, and the page. `rows` rows; `faded` greys the row at that index.
+function windowSketch(svg: SVGSVGElement, rows = 5, faded = -1) {
+  svgEl(svg, 'rect', {
+    x: 1, y: 1, width: 438, height: 218, rx: 12,
+    fill: 'none', stroke: 'var(--sketch-strong)', 'stroke-width': 1.5,
+  });
+  svgEl(svg, 'rect', {
+    x: 1, y: 1, width: 110, height: 218, rx: 12,
+    fill: 'var(--sketch)', stroke: 'none',
+  });
+  for (let i = 0; i < rows; i++) {
+    svgEl(svg, 'rect', {
+      x: 14, y: 34 + i * 22, width: i === faded ? 60 : 82, height: 10, rx: 5,
+      fill: i === faded ? 'var(--sketch)' : 'var(--sketch-strong)',
+      opacity: i === faded ? 1 : .7,
+    });
+  }
+}
+
+const TIPS: Tip[] = [
+  {
+    title: 'Peek at a link',
+    mac: 'A link to another site from a pinned tab opens over the page. ' +
+        'Esc closes it; {⌘O} keeps it as a tab.',
+    other: 'A link to another site from a pinned tab opens over the page. ' +
+        'Esc closes it; {Ctrl+O} keeps it as a tab.',
+    sketch: svg => {
+      windowSketch(svg);
+      svgEl(svg, 'rect', {
+        x: 150, y: 30, width: 250, height: 165, rx: 10,
+        fill: 'var(--ground)', stroke: 'var(--sketch-strong)',
+        'stroke-width': 1.5,
+      });
+      for (let i = 0; i < 4; i++) {
+        svgEl(svg, 'rect', {
+          x: 170, y: 58 + i * 22, width: i === 0 ? 120 : 200 - i * 20,
+          height: 8, rx: 4, fill: 'var(--sketch-strong)', opacity: .6,
+        });
+      }
+    },
+  },
+  {
+    title: 'Two pages side by side',
+    mac: '{⌃⌘N} splits the tab with a new one. Or drag a tab onto one half ' +
+        'of the page.',
+    other: '{Alt+Shift+N} splits the tab with a new one. Or drag a tab onto ' +
+        'one half of the page.',
+    sketch: svg => {
+      windowSketch(svg);
+      for (const x of [122, 282]) {
+        svgEl(svg, 'rect', {
+          x, y: 14, width: 148, height: 192, rx: 8,
+          fill: 'none', stroke: 'var(--sketch-strong)', 'stroke-width': 1.5,
+        });
+      }
+    },
+  },
+  {
+    title: 'Move between Spaces',
+    mac: '{⌥⌘→} and {⌥⌘←} go to the next Space and back. Over the sidebar, ' +
+        'a sideways scroll does too.',
+    other: '{Ctrl+Alt+→} and {Ctrl+Alt+←} go to the next Space and back. ' +
+        'Over the sidebar, a sideways scroll does too.',
+    sketch: svg => {
+      windowSketch(svg, 4);
+      for (let i = 0; i < 3; i++) {
+        svgEl(svg, 'circle', {
+          cx: 38 + i * 18, cy: 200, r: 5,
+          fill: i === 1 ? 'var(--sketch-strong)' : 'var(--sketch)',
+        });
+      }
+      svgEl(svg, 'path', {
+        d: 'M 230 110 h 110 m -14 -12 l 14 12 l -14 12',
+        fill: 'none', stroke: 'var(--sketch-strong)', 'stroke-width': 2,
+        'stroke-linecap': 'round', 'stroke-linejoin': 'round',
+      });
+    },
+  },
+  {
+    title: 'Let a pinned tab sleep',
+    mac: '{⌘W} on a pinned tab puts it to sleep. Its row stays where it is, ' +
+        'and a click wakes it.',
+    other: '{Ctrl+W} on a pinned tab puts it to sleep. Its row stays where ' +
+        'it is, and a click wakes it.',
+    sketch: svg => {
+      windowSketch(svg, 5, 2);
+      svgEl(svg, 'text', {
+        x: 82, y: 82, 'font-size': 13, fill: 'var(--sketch-strong)',
+        'font-family': 'system-ui, sans-serif',
+      }).textContent = 'z';
+    },
+  },
+  {
+    title: 'Links from other apps',
+    mac: 'With Stedding as your default browser, a link from another app ' +
+        'opens in a little window. {⌘O} keeps it as a tab.',
+    other: 'With Stedding as your default browser, a link from another app ' +
+        'opens in a little window. {Ctrl+O} keeps it as a tab.',
+    sketch: svg => {
+      svgEl(svg, 'rect', {
+        x: 60, y: 30, width: 320, height: 165, rx: 10,
+        fill: 'none', stroke: 'var(--sketch-strong)', 'stroke-width': 1.5,
+      });
+      svgEl(svg, 'line', {
+        x1: 60, y1: 56, x2: 380, y2: 56,
+        stroke: 'var(--sketch)', 'stroke-width': 1.5,
+      });
+      for (let i = 0; i < 4; i++) {
+        svgEl(svg, 'rect', {
+          x: 84, y: 76 + i * 22, width: 250 - i * 30, height: 8, rx: 4,
+          fill: 'var(--sketch-strong)', opacity: .6,
+        });
+      }
+    },
+  },
+  {
+    title: 'Find anything',
+    mac: '{⌘T} opens the command bar: search, open an address, or find a ' +
+        'tab in any Space.',
+    other: '{Ctrl+T} opens the command bar: search, open an address, or find ' +
+        'a tab in any Space.',
+    sketch: svg => {
+      windowSketch(svg);
+      svgEl(svg, 'rect', {
+        x: 140, y: 40, width: 270, height: 34, rx: 8,
+        fill: 'var(--ground)', stroke: 'var(--sketch-strong)',
+        'stroke-width': 1.5,
+      });
+      for (let i = 0; i < 3; i++) {
+        svgEl(svg, 'rect', {
+          x: 152, y: 88 + i * 20, width: 200 - i * 30, height: 8, rx: 4,
+          fill: 'var(--sketch-strong)', opacity: .5,
+        });
+      }
+    },
+  },
+];
+
+let mac = navigator.platform.startsWith('Mac');
+let current = 0;
+
+function $(id: string): HTMLElement {
+  return document.getElementById(id)!;
+}
+
+// Writes `text` into `node`, each {key} as a <kbd>.
+function writeWithKeys(node: HTMLElement, text: string) {
+  node.replaceChildren();
+  for (const part of text.split(/(\{[^}]+\})/)) {
+    if (part.startsWith('{') && part.endsWith('}')) {
+      const key = document.createElement('kbd');
+      key.textContent = part.slice(1, -1);
+      node.appendChild(key);
+    } else if (part) {
+      node.appendChild(document.createTextNode(part));
+    }
+  }
+}
+
+function showTip(index: number) {
+  current = (index + TIPS.length) % TIPS.length;
+  const tip = TIPS[current]!;
+  const picture = $('picture');
+  picture.replaceChildren();
+  const svg = document.createElementNS(SVG_NS, 'svg');
+  svg.setAttribute('viewBox', '0 0 440 220');
+  tip.sketch(svg);
+  picture.appendChild(svg);
+  $('tip-title').textContent = tip.title;
+  writeWithKeys($('tip-text'), mac ? tip.mac : tip.other);
+  const dots = $('dots');
+  dots.replaceChildren();
+  TIPS.forEach((_, i) => {
+    const dot = document.createElement('i');
+    if (i === current) {
+      dot.className = 'on';
+    }
+    dots.appendChild(dot);
+  });
+}
+
+function showSpace(space: SpaceInfo) {
+  mac = space.mac;
+  document.documentElement.style.setProperty('--space', space.color);
+  document.title = space.name;
+  $('title').textContent = `Nothing open in ${space.name}`;
+  writeWithKeys(
+      $('sub'),
+      `${mac ? '{⌘T}' : '{Ctrl+T}'} opens the command bar. Your tabs are ` +
+          'asleep in the sidebar; a click wakes one.');
+  showTip(current);
+}
+
+function main() {
+  $('previous').addEventListener('click', () => showTip(current - 1));
+  $('next').addEventListener('click', () => showTip(current + 1));
+  document.addEventListener('keydown', event => {
+    if (event.target instanceof HTMLButtonElement) {
+      return;
+    }
+    if (event.key === 'ArrowLeft') {
+      showTip(current - 1);
+    } else if (event.key === 'ArrowRight') {
+      showTip(current + 1);
+    }
+  });
+  $('support').addEventListener('click', event => {
+    event.preventDefault();
+    chrome.send('openSupport');
+  });
+  // A different tip each time the page shows, from the same list.
+  current = Math.floor(Math.random() * TIPS.length);
+  showTip(current);
+  addWebUiListener('space-changed', showSpace);
