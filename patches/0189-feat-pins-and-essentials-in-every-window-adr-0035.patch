+// docs/features/windows.md G2, G13-G22 (ADR 0035): one window's side of the
+// profile's pin store. It publishes what changed in this window's pins and
+// essentials, and brings this window's tabs in line with what changed in the
+// store: a tab of each record, asleep until chosen here, in the folders the
+// record names (folders F38). A window feature,
+// made after the window's SpaceModel; it does nothing in a window that does not
+// follow the registry (a Blank Window, a little window, a peek's).
+class PinMirror : public PinStore::Observer,
+                  public SpaceModel::Observer,
+                  public TabStripModelObserver,
+                  public tabs::TabCollectionObserver {
+ public:
+  DECLARE_USER_DATA(PinMirror);
+
+  PinMirror(BrowserWindowInterface& window, SpaceModel& model);
+  PinMirror(const PinMirror&) = delete;
+  PinMirror& operator=(const PinMirror&) = delete;
+  ~PinMirror() override;
+
+  // The mirror of `window`, or null for a window with none.
+  static PinMirror* From(BrowserWindowInterface* window);
+
+  // windows G2: this window's Space pins and essentials as records, in the
+  // strip's order, a pin in a pinned folder with the folder's path. Each tab
+  // gets the token it is known by if it had none.
+  std::vector<PinRecord> BuildRecords() const;
+
+  // windows G13, G15, G16, G18: this window's tabs brought in line with the
+  // store. Publishes nothing.
+  void Reconcile();
+
+  // windows G19: fills the store, once, from every window of `profile` that
+  // follows the registry, in session order, then brings every window in line.
+  // Does nothing once the store is ready.
+  static void FillStoreFromWindows(Profile* profile);
+
+  bool waiting_for_restore_for_testing() const { return waiting_for_restore_; }
+  // windows G19's test: windows made while this is on keep their own pins, as
+  // they did before ADR 0035, and the store stays unfilled.
+  static void SetDisabledForTesting(bool disabled);
+  // windows G16's test: a tab drag runs in some window while this is on, as
+  // while a window's tab strip is not editable.
+  static void SetTabDragForTesting(bool under_way);
+
+ private:
+  // PinStore::Observer:
+  void OnPinStoreChanged() override;
+
+  // SpaceModel::Observer:
+  void OnSpaceAdded(const SpaceId& id) override;
+  void OnTabSpaceChanged(tabs::TabInterface* tab) override;
+  void OnTabSpacePinChanged(tabs::TabInterface* tab, bool pinned) override;
+  void OnSpaceModelDestroying() override;
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel* strip,
+                              const TabStripModelChange& change,
+                              const TabStripSelectionChange& selection) override;
+  void OnTabPinnedStateChanged(tabs::TabInterface* tab, int index) override;
+  void OnTabChangedAt(tabs::TabInterface* tab,
+                      TabChangeType change_type) override;
+
+  // tabs::TabCollectionObserver: a tab into or out of a folder, a folder
+  // moved, renamed, given an icon, opened or closed (windows G13).
+  void OnChildrenAdded(const tabs::TabCollection::Position& position,
+                       const tabs::TabCollectionNodes& handles,
+                       bool insert_from_detached) override;
+  void OnChildrenRemoved(const tabs::TabCollection::Position& position,
+                         const tabs::TabCollectionNodes& handles) override;
+  void OnChildMoved(const tabs::TabCollection::Position& to_position,
+                    const NodeData& node_data) override;
+  void OnCollectionDataChanged(
+      const tabs::TabCollection::Handle& changed) override;
+  void OnTreeChanged();
+
+  // Whether `tab` is a record's tab here: an essential, or a Space pin in no
+  // folder or in a pinned folder (folders F38). A pin in a folder under the
+  // Clear line is no row of the run and stays this window's own.
+  bool IsMirrored(const tabs::TabInterface* tab) const;
+  PinRecord RecordOf(tabs::TabInterface* tab) const;
+
+  // A change made here: one publish a turn later, so a run of changes (a
+  // folder pinned, a drag across the Clear line) is published once.
+  void SchedulePublish();
+  void Publish();
+  // `id` stopped being a pin or an essential here, by the person's hand.
+  void NoteRemoved(const std::string& id);
+
+  void OnSessionRestored(Profile* profile, int tab_count);
+  // The first turn after this window's restore: the store filled if it is
+  // not yet, then this window in line.
+  void Settle();
+
+  // Reconcile, once nothing holds it back. Returns whether a tab was given
+  // an id the store does not know, to be published.
+  bool ReconcileNow();
+  // Reconcile's parts.
+  void LetGo(tabs::TabInterface* tab, bool removed_here);
+  // A Space pin comes in at `space_pin_index` of the strip, filed as it
+  // arrives (windows G16, BACKLOG S-546); an essential at the strip's end.
+  tabs::TabInterface* Make(const PinRecord& record, int space_pin_index);
+  void Align(tabs::TabInterface* tab, const PinRecord& record);
+  // folders F38, windows G13: each pin in the folders its record names, made
+  // here with the record's ids when this window lacks them, with their title,
+  // icon and open or closed state.
+  void Fold(const std::vector<const PinRecord*>& records);
+  void Order(const std::vector<const PinRecord*>& records);
+
+  // Whether this window takes part: settled a turn after it is made, once
+  // the window says whether it is a little window or a peek's.
+  bool Active() const;
+
+  // windows G16: whether a tab drag runs in any window of the profile. The
+  // window a drag tears off is not yet one that stays, and a tab dragged out
+  // of a window may come back to it: nothing settles, publishes or is
+  // brought in line until the drag ends.
+  bool DragUnderWay() const;
+  // What waited for the drag is done a little after it ends.
+  void WaitForTheDrag();
+  void AfterTheDrag();
+
+  // What this window holds, as its last reconcile left it or its last
+  // publish sent it: a publish sends only what changed since (windows G13).
+  // `removed` are the records this window is removing.
+  void Hold(std::vector<PinRecord> records,
+            const std::set<std::string>& removed);
+
+  // splits J4: SpaceModel's verbs take both panes of a split. A record's
+  // change is one pane's, so a pane whose change its split's other pane's
+  // record does not share leaves the split first.
+  void LeaveSplitUnlessPeersFollow(tabs::TabInterface* tab,
+                                   const PinRecord& record);
+
+  const raw_ref<BrowserWindowInterface> window_;
+  // Null once the model is going away.
+  raw_ptr<SpaceModel> model_;
+  const raw_ptr<PinStore> store_;
+  // The strip's tree, observed while this window takes part.
+  raw_ptr<const tabs::TabCollection> root_ = nullptr;
+  bool settled_ = false;
+  bool takes_part_ = false;
+  bool reconciling_ = false;
+  bool publish_scheduled_ = false;
+  bool waiting_for_restore_ = false;
+  bool reconcile_after_drag_ = false;
+  bool drag_retry_posted_ = false;
+  std::set<std::string> removed_;
+  // Hold's records, in the strip's order, one per id.
+  std::vector<PinRecord> held_;
+  // The records this window had at its last reconcile.
+  std::set<std::string> seen_;
+  base::CallbackListSubscription restored_subscription_;
+  base::ScopedObservation<PinStore, PinStore::Observer> store_observation_{
+      this};
+  ui::ScopedUnownedUserData<PinMirror> scoped_user_data_;
+  base::WeakPtrFactory<PinMirror> weak_factory_{this};
+};
