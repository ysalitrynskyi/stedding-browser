+++ b/chrome/test/stedding/sidebar_test_util.cc
@@ -0,0 +1,117 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/test/stedding/sidebar_test_util.h"
+
+#include "base/notreached.h"
+#include "base/test/run_until.h"
+#include "chrome/browser/ui/views/tabs/common/folder_view.h"
+#include "chrome/browser/ui/views/tabs/common/pinned_tab_container_view.h"
+#include "chrome/browser/ui/views/tabs/common/tab_collection_animating_layout_manager.h"
+#include "chrome/browser/ui/views/tabs/common/tab_group_view.h"
+#include "chrome/browser/ui/views/tabs/common/tab_view.h"
+#include "chrome/browser/ui/views/tabs/common/unpinned_tab_container_view.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/event_utils.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace stedding::test {
+
+namespace {
+
+bool AnyRowMoves(views::View* view) {
+  if (views::IsViewClass<UnpinnedTabContainerView>(view) ||
+      views::IsViewClass<PinnedTabContainerView>(view) ||
+      views::IsViewClass<TabGroupView>(view)) {
+    // These three always lay out through the animating manager.
+    if (static_cast<TabCollectionAnimatingLayoutManager*>(
+            view->GetLayoutManager())
+            ->is_animating()) {
+      return true;
+    }
+  }
+  for (views::View* child : view->children()) {
+    if (AnyRowMoves(child)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+TabView* FindDrawnRow(views::View* root, const tabs::TabInterface* tab) {
+  if (TabView* const row = views::AsViewClass<TabView>(root);
+      row && row->GetTabInterface() == tab && row->IsDrawn()) {
+    return row;
+  }
+  for (views::View* child : root->children()) {
+    if (TabView* const found = FindDrawnRow(child, tab)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+FolderView* FindDrawnFolder(views::View* root,
+                            const tabs::FolderTabCollection* folder) {
+  if (FolderView* const view = views::AsViewClass<FolderView>(root);
+      view && view->folder() == folder && view->IsDrawn()) {
+    return view;
+  }
+  for (views::View* child : root->children()) {
+    if (FolderView* const found = FindDrawnFolder(child, folder)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+bool WaitForRowsToSettle(views::Widget* widget) {
+  const bool settled = base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget);
+    return !AnyRowMoves(widget->GetRootView());
+  });
+  views::test::RunScheduledLayout(widget);
+  return settled;
+}
+
+void SendLeftMouse(views::Widget* widget,
+                   ui::EventType type,
+                   const gfx::Point& screen_point) {
+  views::View* const root = widget->GetRootView();
+  gfx::Point in_root = screen_point;
+  views::View::ConvertPointFromScreen(root, &in_root);
+  const int changed =
+      type == ui::EventType::kMouseDragged ? 0 : ui::EF_LEFT_MOUSE_BUTTON;
+  const ui::MouseEvent event(type, in_root, in_root, ui::EventTimeForNow(),
+                             ui::EF_LEFT_MOUSE_BUTTON, changed);
+  switch (type) {
+    case ui::EventType::kMousePressed:
+      root->OnMousePressed(event);
+      break;
+    case ui::EventType::kMouseDragged:
+      root->OnMouseDragged(event);
+      break;
+    case ui::EventType::kMouseReleased:
+      root->OnMouseReleased(event);
+      break;
+    default:
+      NOTREACHED();
+  }
+}
+
+void ClickLeftMouse(views::Widget* widget, const gfx::Point& screen_point) {
+  SendLeftMouse(widget, ui::EventType::kMousePressed, screen_point);
+  SendLeftMouse(widget, ui::EventType::kMouseReleased, screen_point);
+}
+
+}  // namespace stedding::test
