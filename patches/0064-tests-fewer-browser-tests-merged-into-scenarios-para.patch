+    // The jars' removals queue behind that one, as the isolated web apps' do;
+    // a removal queued now finishes after them.
+    content::BrowsingDataRemoverCompletionObserver after(remover);
+    remover->RemoveAndReply(
+        base::Time(), base::Time::Max(),
