+    views::test::RunScheduledLayout(widget);
+    views::Textfield* const field = typing_into();
+    ASSERT_TRUE(field && field->IsDrawn()) << "no rename began";
+    EXPECT_EQ(model->DisplayName(home), field->GetPlaceholderText());
+    spaces::SpaceSwitcherView* const switcher =
