+void SteddingSpacesHandler::HandleAddRoute(const base::ListValue& args) {
+  CHECK_EQ(2U, args.size());
+  AllowJavascript();
+  const std::string& space = args[0].GetString();
+  std::string site = base::ToLowerASCII(args[1].GetString());
+  base::TrimWhitespaceASCII(site, base::TRIM_ALL, &site);
+  // Whatever was typed, the rule is a site: "https://gist.github.com/x"
+  // and "github.com" both become github.com.
+  const GURL as_url(site.find("://") == std::string::npos ? "https://" + site
+                                                          : site);
+  const std::string pattern = spaces::SiteOf(as_url);
+  if (pattern.empty() || space.empty()) {
+    return;
+  }
+  spaces::AddRoute(Profile::FromWebUI(web_ui())->GetPrefs(),
+                   spaces::SiteRouteFor(as_url, space));
+  PushSpaces();
+}
+
+void SteddingSpacesHandler::HandleRemoveRoute(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  const std::optional<int> index = args[0].GetIfInt();
+  if (!index || *index < 0) {
+    return;
+  }
+  spaces::RemoveRoute(Profile::FromWebUI(web_ui())->GetPrefs(),
+                      static_cast<size_t>(*index));
+  PushSpaces();
+}
