From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Tue, 1 Sep 2026 19:13:58 -0400
Subject: tabs: vertical tabs on by default

The sidebar is the product, so the vertical tab strip is on for every profile
instead of behind upstream's flag.

The tab context menu no longer offers "Show Tabs Horizontally": the sidebar
is the product, and that item is an offer to turn the product off.

Why: the sidebar is the product; upstream defaults it off.
Removable when: upstream defaults kVerticalTabsEnabled to true, or exposes the
default as a gn arg or a policy we can set without patching.
---
 chrome/browser/ui/tabs/tab_menu_model.cc  | 7 ++++++-
 chrome/browser/ui/tabs/tab_strip_prefs.cc | 5 ++++-
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/ui/tabs/tab_menu_model.cc b/chrome/browser/ui/tabs/tab_menu_model.cc
index 85b8f3eb6302b..6957a78aa5b40 100644
--- a/chrome/browser/ui/tabs/tab_menu_model.cc
+++ b/chrome/browser/ui/tabs/tab_menu_model.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/tabs/tab_menu_model.h"
 
+#include "chrome/browser/ui/stedding_ui_metrics.h"
+
 #include <memory>
 #include <optional>
 
@@ -501,7 +503,10 @@ void TabMenuModel::Build(int index) {
     }
   }
 
-  if (tabs::kVerticalTabsToggleInTabContextMenu.Get() && controller) {
+  // Stedding: the sidebar is the product; offering "Show Tabs Horizontally"
+  // in every tab's menu is offering to turn the product off.
+  if (tabs::kVerticalTabsToggleInTabContextMenu.Get() && controller &&
+      !base::FeatureList::IsEnabled(stedding::kArcStyleWindow)) {
     AddSeparator(ui::NORMAL_SEPARATOR);
     if (controller->ShouldDisplayVerticalTabs()) {
       AddItemWithStringId(TabStripModel::CommandToggleVertical,
diff --git a/chrome/browser/ui/tabs/tab_strip_prefs.cc b/chrome/browser/ui/tabs/tab_strip_prefs.cc
index 24873dd76bd28..b7c798f9829de 100644
--- a/chrome/browser/ui/tabs/tab_strip_prefs.cc
+++ b/chrome/browser/ui/tabs/tab_strip_prefs.cc
@@ -29,7 +29,10 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
           tabs::kMigrateEverythingMenuPinnedToTabstrip));
   registry->RegisterBooleanPref(
       prefs::kEverythingMenuPinnedToTabstripMigrationComplete, false);
-  registry->RegisterBooleanPref(prefs::kVerticalTabsEnabled, false);
+  // Stedding: vertical tabs are the primary tab surface, not an opt-in.
+  // Upstream ships the feature enabled but the pref off, so a stock build hides
+  // it behind Settings. See docs/decisions/0010-ride-upstream-vertical-tabs.md.
+  registry->RegisterBooleanPref(prefs::kVerticalTabsEnabled, true);
   registry->RegisterBooleanPref(
       prefs::kVerticalTabsExpandOnHoverEnabled,
       tabs::kVerticalTabsExpandOnHoverDefaultEnabled.Get());
