+// found in the LICENSE file.
+
+// The WebDAV and S3 place forms of Settings > Stedding > Sync through a
+// folder (docs/features/sidebar-file.md Sf45-Sf47, ADR 0032), as the page's
+// renderer reaches them: a message of the wrong shape is dropped, and the
+// browser goes on answering.
+
+#include <string>
+
+#include "base/strings/strcat.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+// The messages the place forms send (Sf45, Sf47, Sf53).
+constexpr const char* kPlaceMessagesW2B30[] = {
+    "steddingCheckSyncPlace",
+    "steddingCheckSyncSignIn",
+    "steddingTestSyncPlace",
+    "steddingChangeSyncSignIn",
+};
+
+// Argument lists the shipped page never sends: none at all, too few or too
+// many, a form that is not an object, and a callback id that is not a
+// string.
+constexpr const char* kWrongShapesW2B30[] = {
+    "",
+    ", []",
+    ", ['id']",
+    ", ['id', 'text']",
+    ", ['id', 7]",
+    ", [1, {}]",
+    ", [{}, {}]",
+    ", ['id', {}, 3]",
+};
+
+// Sync's status, through the page's own message: it answers only while the
+// browser is up, and only after the messages the page sent before it.
+constexpr char kSyncStatusW2B30[] = R"(
+  (async () => {
+    const cr = await import('chrome://resources/js/cr.js');
+    return (await cr.sendWithPromise('steddingSidebarSyncStatus')).enabled;
+  })()
+)";
+
+using SyncPlaceMessagesW2B30Test = InProcessBrowserTest;
+
+// P45-1d; Sf45, Sf47: the four place-form messages, each sent with arguments
+// of the wrong shape, are dropped. Each of their handlers checked the count
+// and read a string and an object without testing the types, so the first
+// such message stopped the browser, every window with it.
+IN_PROC_BROWSER_TEST_F(SyncPlaceMessagesW2B30Test,
+                       APlaceMessageOfTheWrongShapeIsDropped) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://settings/stedding"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_EQ(false, content::EvalJs(page, kSyncStatusW2B30));
+
+  for (const char* message : kPlaceMessagesW2B30) {
+    for (const char* shape : kWrongShapesW2B30) {
+      const std::string send =
+          base::StrCat({"chrome.send('", message, "'", shape, ");"});
+      SCOPED_TRACE(send);
+      ASSERT_TRUE(content::ExecJs(page, send));
+      ASSERT_EQ(false, content::EvalJs(page, kSyncStatusW2B30));
+    }
+  }
+
+  // The page goes on, and the forms' messages of the right shape still
+  // answer.
+  EXPECT_EQ(2, content::EvalJs(page, "1 + 1"));
+  EXPECT_EQ("false true", content::EvalJs(page, R"(
+    (async () => {
+      const cr = await import('chrome://resources/js/cr.js');
+      const place = await cr.sendWithPromise('steddingCheckSyncPlace',
+                                             {kind: 'webdav'});
+      const signIn = await cr.sendWithPromise('steddingCheckSyncSignIn', {
+        kind: 's3', accessKey: 'a', secretKey: 'b'});
+      return [place.complete, signIn.complete].join(' ');
+    })()
+  )"));
+}
+
+}  // namespace
