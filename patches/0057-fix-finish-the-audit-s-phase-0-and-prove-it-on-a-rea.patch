+  tabs::TabInterface* const after = tabstrip()->GetTabAtIndex(4);
+  tabs::FolderTabCollection* const folder =
+      tabstrip()->AddToNewFolder({1, 2, 3});
+  ASSERT_NE(nullptr, folder);
+  tabstrip()->ActivateTabAt(1);
+  folder->SetCollapsed(true);
+
+  Recorder recorder;
+  tabstrip()->AddObserver(&recorder);
+  tabstrip()->CloseFolderTabs(folder);
+  tabstrip()->RemoveObserver(&recorder);
+
+  ASSERT_EQ(2, tabstrip()->count());
+  EXPECT_EQ(before, tabstrip()->GetTabAtIndex(0));
+  EXPECT_EQ(after, tabstrip()->GetTabAtIndex(1));
+  EXPECT_EQ(after, tabstrip()->GetActiveTab());
+  EXPECT_EQ(1, recorder.removals) << "one batch";
+  EXPECT_EQ(std::vector<tabs::TabHandle>{after->GetHandle()},
+            recorder.activated)
+      << "no other tab of the folder was shown on the way out";
+  tabstrip()->CloseAllTabs();
+}
