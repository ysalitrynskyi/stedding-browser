+tabs::FolderTabCollection* FolderView::folder() const {
+  return FolderFromNode(collection_node_);
+}
+
+void FolderView::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails& details) {
+  views::View::ViewHierarchyChanged(details);
+  if (!details.is_add || details.parent != this ||
+      details.child == header_) {
+    return;
+  }
+  // Tabs and nested folders sit indented under the header, as the reference
+  // draws them.
+  details.child->SetProperty(views::kMarginsKey,
+                             gfx::Insets::TLBR(0, kIndent, 0, 0));
+  details.child->SetVisible(!folder()->collapsed());
+}
+
+void FolderView::ToggleCollapsed() {
+  folder()->SetCollapsed(!folder()->collapsed());
+  ApplyCollapsed();
+}
+
+void FolderView::ApplyCollapsed() {
+  const bool collapsed = folder()->collapsed();
+  for (views::View* child : children()) {
+    if (child != header_) {
+      child->SetVisible(!collapsed);
+    }
+  }
+  UpdateHeader();
+  PreferredSizeChanged();
+}
+
+void FolderView::UpdateHeader() {
+  chevron_->SetText(folder()->collapsed() ? u"▸" : u"▾");
+  const std::string& title = folder()->title();
+  name_->SetText(title.empty() ? u"New Folder" : base::UTF8ToUTF16(title));
+}
+
+void FolderView::BeginRename() {
+  rename_field_->SetText(base::UTF8ToUTF16(folder()->title()));
+  chevron_->SetVisible(false);
+  name_->SetVisible(false);
+  rename_field_->SetVisible(true);
+  rename_field_->RequestFocus();
+  rename_field_->SelectAll(false);
+}
+
+void FolderView::EndRename(bool commit) {
+  if (commit) {
+    folder()->SetTitle(base::UTF16ToUTF8(rename_field_->GetText()));
+  }
+  rename_field_->SetVisible(false);
+  chevron_->SetVisible(true);
+  name_->SetVisible(true);
+  UpdateHeader();
+}
+
+bool FolderView::HandleKeyEvent(views::Textfield* sender,
+                                const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    EndRename(/*commit=*/true);
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    EndRename(/*commit=*/false);
+    return true;
+  }
+  return false;
+}
