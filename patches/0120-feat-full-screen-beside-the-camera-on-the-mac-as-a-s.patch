+// toolbar T56 (BACKLOG S-392): the row beside the camera, while the window
+// is in Stedding's full screen on a screen with a camera housing.
+std::optional<stedding::AddressRow::CameraRow> CameraRowOf(
+    const BrowserViewLayoutViews& views) {
+  BrowserView* const browser_view =
+      views::AsViewClass<BrowserView>(views.browser_view.get());
+  const stedding::AddressRow* const row =
+      browser_view && browser_view->browser()
+          ? stedding::AddressRow::From(browser_view->browser())
+          : nullptr;
+  return row ? row->camera_row() : std::nullopt;
+}
+
+// toolbar T56: the address row as the row beside the camera, at the top
+// container's top, the safe area's height, and what the container holds
+// under it moved up with it. The card starts a gutter under all of it,
+// rounded at the top as with the row hidden (T8): the row is no longer the
+// card's top.
+// A template only because the layout type is the layout class's own.
+template <typename ProposedLayout>
+void PlaceRowBesideCamera(ProposedLayout& container_layout,
+                          gfx::Rect& container,
+                          views::View* toolbar,
+                          int height,
+                          int gutter) {
+  const auto row = container_layout.children.find(toolbar);
+  if (row == container_layout.children.end() ||
+      !row->second.visibility.value_or(toolbar->GetVisible())) {
+    return;
+  }
+  const int old_bottom = row->second.bounds.bottom();
+  const int rise = old_bottom - height;
+  row->second.bounds.set_y(0);
+  row->second.bounds.set_height(height);
+  int bottom = height;
+  for (auto& [child, child_layout] : container_layout.children) {
+    if (child == toolbar) {
+      continue;
+    }
+    if (child_layout.bounds.y() >= old_bottom) {
+      child_layout.bounds.Offset(0, -rise);
+    }
+    if (child_layout.visibility.value_or(child->GetVisible()) &&
+        !child_layout.bounds.IsEmpty()) {
+      bottom = std::max(bottom, child_layout.bounds.bottom());
+    }
+  }
+  container.set_y(0);
+  container.set_height(bottom + gutter);
+}
+
 }  // namespace
 
