+// tabs.query and a peek over the page -----------------------------------------
+
+constexpr char kHeldPathW2B01[] = "/held-w2b01";
+
+class PeekQueryW2B01Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    // The server starts in the test, once its held response is set up.
+    PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+    prefs->SetBoolean(stedding::prefs::kPeekEnabled, true);
+    prefs->SetInteger(stedding::prefs::kPeekStyle,
+                      stedding::prefs::kPeekStyleOverPage);
+  }
+
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  content::WebContents* contents() { return tabs().GetActiveWebContents(); }
+
+  // A pinned tab at a.test with one link, to `to`, on screen.
+  void OpenPinW2B01(const GURL& to) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL("a.test", "/title1.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    ASSERT_TRUE(content::ExecJs(
+        contents(),
+        base::StringPrintf("const a = document.createElement('a');"
+                           "a.id = 'link'; a.href = '%s';"
+                           "a.textContent = 'the link';"
+                           "document.body.prepend(a);",
+                           to.spec().c_str()),
+        content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    tabs().SetTabPinned(tabs().active_index(), true);
+  }
+
+  // What `script`, a promise in the extension's background, resolves to.
+  std::string RunW2B01(const extensions::Extension& extension,
+                       const std::string& script) {
+    base::Value said = extensions::BackgroundScriptExecutor::ExecuteScript(
+        browser()->GetProfile(), extension.id(),
+        script + ".then(said => chrome.test.sendScriptResult(said));",
+        extensions::BackgroundScriptExecutor::ResultCapture::kSendScriptResult);
+    return said.is_string() ? said.GetString() : std::string("not a string");
+  }
+};
+
+// P01-1c, peek P26: while a peek over the page shows, tabs.query tests its
+// page as it tests a tab's. A query for the active tab with an address
+// pattern found nothing while the peek's first page was still on its way:
+// the pinned tab gave way to the peek, whose address was matched only once
+// committed, where a tab's on-its-way address also matches. And a query for
+// tabs that may not be discarded listed the peek's page, whose tab object
+// says it may.
+IN_PROC_BROWSER_TEST_F(PeekQueryW2B01Test,
+                       TheQueryTestsThePeeksPageAsItTestsATab) {
+  net::test_server::ControllableHttpResponse held(embedded_test_server(),
+                                                  kHeldPathW2B01);
+  ASSERT_TRUE(embedded_test_server()->Start());
+
+  extensions::TestExtensionDir dir;
+  dir.WriteManifest(R"({
+      "name": "Asks for tabs",
+      "version": "1",
+      "manifest_version": 3,
+      "background": {"service_worker": "background.js"},
+      "permissions": ["tabs"]
+  })");
+  dir.WriteFile(FILE_PATH_LITERAL("background.js"), "// Asked from the test.");
+  extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+  scoped_refptr<const extensions::Extension> extension =
+      loader.LoadExtension(dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+
+  ASSERT_NO_FATAL_FAILURE(
+      OpenPinW2B01(embedded_test_server()->GetURL("b.test", kHeldPathW2B01)));
+  tabs::TabInterface* const pin = tabs().GetActiveTab();
+  ASSERT_TRUE(content::ExecJs(contents(),
+                              "document.getElementById('link').click();"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return stedding::PeekOverlay::ForSource(pin) != nullptr; }))
+      << "no peek over the page";
+  held.WaitForRequest();
+  content::WebContents* const page =
+      stedding::PeekOverlay::ForSource(pin)->page();
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(page->GetController().GetPendingEntry())
+      << "the premise: the peek's page is still on its way";
+  const int page_id = sessions::SessionTabHelper::IdForTab(page).id();
+
+  EXPECT_EQ(base::NumberToString(page_id),
+            RunW2B01(*extension,
+                     "chrome.tabs.query({active: true,"
+                     " windowId: chrome.windows.WINDOW_ID_CURRENT,"
+                     " url: '*://b.test/*'})"
+                     ".then(tabs => tabs.map(tab => tab.id).join(' '))"))
+      << "the active tab of the window was not found by its address";
+
+  held.Send(net::HTTP_OK, "text/html", "<title>Held</title>");
+  held.Done();
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+
+  EXPECT_EQ("true",
+            RunW2B01(*extension,
+                     base::StringPrintf(
+                         "chrome.tabs.query({}).then(tabs => String(tabs"
+                         ".filter(tab => tab.id === %d)"
+                         ".map(tab => tab.autoDiscardable)))",
+                         page_id)))
+      << "the premise: the peek's page says it may be discarded";
+  EXPECT_EQ("false",
+            RunW2B01(*extension,
+                     base::StringPrintf(
+                         "chrome.tabs.query({autoDiscardable: false})"
+                         ".then(tabs => String(tabs.some("
+                         "tab => tab.id === %d)))",
+                         page_id)))
+      << "a query for tabs that may not be discarded listed the peek's page";
+  EXPECT_EQ("true",
+            RunW2B01(*extension,
+                     base::StringPrintf(
+                         "chrome.tabs.query({autoDiscardable: true})"
+                         ".then(tabs => String(tabs.some("
+                         "tab => tab.id === %d)))",
+                         page_id)))
+      << "a query for tabs that may be discarded left the peek's page out";
+}
+
+// Open Link in Space ----------------------------------------------------------
+
+class OpenLinkInSpaceW2B01Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    model_ = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model_);
+    home_ = model_->active_id();
+    b_ = model_->AddSpace("B", SK_ColorBLUE)->id();
+    c_ = model_->AddSpace("C", SK_ColorGREEN)->id();
+    ASSERT_EQ(home_, model_->active_id());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+    home_page_ = browser()->tab_strip_model()->GetActiveWebContents();
+  }
+
+  void TearDownOnMainThread() override {
+    // The model and the page belong to the window, which closes before the
+    // fixture goes.
+    model_ = nullptr;
+    home_page_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  GURL Link() {
+    return embedded_test_server()->GetURL("b.test", "/title2.html");
+  }
+
+  // The page menu of a link on Home's page, as a right-click builds it.
+  std::unique_ptr<TestRenderViewContextMenu> LinkMenuW2B01() {
+    content::ContextMenuParams params;
+    params.page_url = home_page_->GetLastCommittedURL();
+    params.frame_url = params.page_url;
+    params.link_url = Link();
+    params.unfiltered_link_url = Link();
+    auto menu = std::make_unique<TestRenderViewContextMenu>(
+        *home_page_->GetPrimaryMainFrame(), params);
+    menu->Init();
+    return menu;
+  }
+
+  // The window's tabs now.
+  std::set<tabs::TabInterface*> TabsW2B01() {
+    std::set<tabs::TabInterface*> all;
+    TabStripModel* const strip = browser()->tab_strip_model();
+    for (int i = 0; i < strip->count(); ++i) {
+      all.insert(strip->GetTabAtIndex(i));
+    }
+    return all;
+  }
+
+  // The one tab the window has now that it did not have in `before`, or
+  // null when there is not exactly one.
+  tabs::TabInterface* NewTabW2B01(const std::set<tabs::TabInterface*>& before) {
+    tabs::TabInterface* added = nullptr;
+    for (tabs::TabInterface* const tab : TabsW2B01()) {
+      if (before.contains(tab)) {
+        continue;
+      }
+      if (added) {
+        return nullptr;
+      }
+      added = tab;
+    }
+    return added;
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  raw_ptr<content::WebContents> home_page_ = nullptr;
+  spaces::SpaceId home_ = spaces::SpaceId::GenerateNew();
+  spaces::SpaceId b_ = spaces::SpaceId::GenerateNew();
+  spaces::SpaceId c_ = spaces::SpaceId::GenerateNew();
+};
+
+// P02-1a, menus M14: the row names B. Sync's order moved C ahead of B while
+// the menu was open, and the row's place in the list then named C: the link
+// opened in C, in C's session.
+IN_PROC_BROWSER_TEST_F(OpenLinkInSpaceW2B01Test,
+                       ARowOpensInItsSpaceAfterTheSpacesWereReordered) {
+  std::unique_ptr<TestRenderViewContextMenu> menu = LinkMenuW2B01();
+  const std::optional<std::pair<ui::MenuModel*, size_t>> row =
+      menu->GetMenuModelAndItemIndex(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST);
+  ASSERT_TRUE(row) << "no Open Link in Space row";
+  ASSERT_EQ(u"B", row->first->GetLabelAt(row->second));
+
+  ASSERT_TRUE(model_->MoveSpace(c_, -1));
+  ASSERT_EQ(c_, model_->spaces()[1]->id()) << "the premise: C is ahead of B";
+
+  const std::set<tabs::TabInterface*> before = TabsW2B01();
+  menu->ExecuteCommand(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST, 0);
+  tabs::TabInterface* const opened = NewTabW2B01(before);
+  ASSERT_TRUE(opened) << "the link did not open in one new tab";
+  EXPECT_EQ(b_, model_->FindSpaceForTab(opened))
+      << "the link opened in another Space than its row named";
+  EXPECT_TRUE(base::test::RunUntil([&] { return model_->active_id() == b_; }))
+      << "the window does not show B";
+}
+
+// P02-1a, menus M14: the row names B, and the window went to B while the
+// menu was open. The list of other Spaces then began with Home, and the
+// link opened there.
+IN_PROC_BROWSER_TEST_F(OpenLinkInSpaceW2B01Test,
+                       ARowOpensInItsSpaceAfterTheWindowWentThere) {
+  std::unique_ptr<TestRenderViewContextMenu> menu = LinkMenuW2B01();
+  const std::optional<std::pair<ui::MenuModel*, size_t>> row =
+      menu->GetMenuModelAndItemIndex(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST);
+  ASSERT_TRUE(row) << "no Open Link in Space row";
+  ASSERT_EQ(u"B", row->first->GetLabelAt(row->second));
+
+  ASSERT_TRUE(model_->SetActiveSpace(b_));
+  ASSERT_EQ(b_, model_->active_id());
+
+  const std::set<tabs::TabInterface*> before = TabsW2B01();
+  menu->ExecuteCommand(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST, 0);
+  tabs::TabInterface* const opened = NewTabW2B01(before);
+  ASSERT_TRUE(opened) << "the link did not open in one new tab";
+  EXPECT_EQ(b_, model_->FindSpaceForTab(opened))
+      << "the link opened in another Space than its row named";
+  EXPECT_TRUE(base::test::RunUntil([&] { return model_->active_id() == b_; }))
+      << "the window does not show B";
+}
+
+// P02-1a, menus M14: a Space deleted while the menu was open is not one to
+// open in, and its row names no other. The row for B, deleted, opened the
+// link in C, which took its place in the list.
+IN_PROC_BROWSER_TEST_F(OpenLinkInSpaceW2B01Test,
+                       ARowWhoseSpaceWasDeletedOpensNothing) {
+  std::unique_ptr<TestRenderViewContextMenu> menu = LinkMenuW2B01();
+  const std::optional<std::pair<ui::MenuModel*, size_t>> row =
+      menu->GetMenuModelAndItemIndex(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST);
+  ASSERT_TRUE(row) << "no Open Link in Space row";
+  ASSERT_EQ(u"B", row->first->GetLabelAt(row->second));
+
+  ASSERT_TRUE(model_->RemoveSpace(b_));
+  ASSERT_FALSE(model_->GetSpace(b_));
+
+  const std::set<tabs::TabInterface*> before = TabsW2B01();
+  menu->ExecuteCommand(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST, 0);
+  EXPECT_EQ(before, TabsW2B01()) << "the link opened in another Space";
+  EXPECT_EQ(home_, model_->active_id());
+}
+
+// P02-1b, menus M14: a row shows its Space's name as the user wrote it. The
+// menus took "&" for a mnemonic marker: "R&D" read "RD", and on Windows "D"
+// became the row's key. Work & Home has a session of its own, whose row on
+// the Mac carries the session's mark in its label.
+IN_PROC_BROWSER_TEST_F(OpenLinkInSpaceW2B01Test,
+                       ARowShowsAnAmpersandInItsSpacesName) {
+  model_->SetSpaceName(b_, "R&D");
+  model_->SetSpaceName(c_, "Work & Home");
+  model_->SetSpaceIsolated(c_, true);
+  ASSERT_TRUE(model_->SpaceIsIsolated(c_));
+
+  std::unique_ptr<TestRenderViewContextMenu> menu = LinkMenuW2B01();
+  const std::optional<std::pair<ui::MenuModel*, size_t>> first =
+      menu->GetMenuModelAndItemIndex(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST);
+  ASSERT_TRUE(first) << "no Open Link in Space row";
+  EXPECT_EQ(u"R&D", first->first->GetLabelAt(first->second));
+  EXPECT_FALSE(first->first->MayHaveMnemonicsAt(first->second))
+      << "the menu takes the '&' in R&D for a mnemonic marker";
+
+  const std::optional<std::pair<ui::MenuModel*, size_t>> second =
+      menu->GetMenuModelAndItemIndex(IDC_STEDDING_OPEN_LINK_IN_SPACE_FIRST +
+                                     1);
+  ASSERT_TRUE(second) << "no row for Work & Home";
+  EXPECT_NE(std::u16string::npos,
+            second->first->GetLabelAt(second->second).find(u"Work & Home"));
+  EXPECT_FALSE(second->first->MayHaveMnemonicsAt(second->second))
+      << "the menu takes the '&' in Work & Home for a mnemonic marker";
+}
+
+}  // namespace
