+// Every folder's id under `collection`, as a file Stedding writes it.
+void AddFolderIds(const tabs::TabCollection& collection,
+                  std::set<std::string>* ids) {
+  for (const tabs::Child& child : collection.GetChildren()) {
+    const std::unique_ptr<tabs::TabCollection>* const sub =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (!sub || !*sub) {
+      continue;
+    }
+    const tabs::TabCollection* const node = sub->get();
+    if (node->type() == tabs::TabCollection::Type::FOLDER) {
+      ids->insert(
+          "folder:" +
+          static_cast<const tabs::FolderTabCollection*>(node)->id().ToString());
+    }
+    AddFolderIds(*node, ids);
+  }
+}
+
+// The outermost folder `folder` sits in, or itself.
+tabs::FolderTabCollection* TopFolder(tabs::FolderTabCollection* folder) {
+  for (tabs::TabCollection* up = folder->GetParentCollection();
+       up && up->type() == tabs::TabCollection::Type::FOLDER;
+       up = up->GetParentCollection()) {
+    folder = static_cast<tabs::FolderTabCollection*>(up);
+  }
+  return folder;
+}
