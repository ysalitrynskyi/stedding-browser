+// The first list's rows, newest first.
+std::vector<std::u16string> FirstList() {
+  return {
+      u"acme/rocket: Count down in seconds",
+      u"acme/rocket: Make the launch window configurable",
+      u"acme/fuel: Fix the gauge rounding",
+  };
+}
