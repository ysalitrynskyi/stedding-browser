+// motion O8: the omnibox's hidden popup windows follow the location bar once a
+// collapse or an expand of the sidebar has moved it, not at every frame. Each
+// was moved and resized, its hidden page laid out again, at every frame: 32
+// bounds changes each in a collapse and 38 in an expand at 120 Hz on the Mac
+// (2026-10-21). The page's answer to the update after one motion, arriving in
+// the next, is held for that one's update too.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest,
+                       HiddenOmniboxPopupsFollowTheSidebarOnceAMotion) {
+  if (!Animates()) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(4));
+  // M157 makes the popup's window at its first show and keeps it, hidden,
+  // after; one show and hide gives the window the hidden popup a motion moves.
+  if (OmniboxPopups(false).empty()) {
+    ASSERT_TRUE(OpenTheDropdown()) << "no dropdown";
+    ASSERT_TRUE(CloseTheDropdown());
+  }
+  const std::vector<views::Widget*> popups = OmniboxPopups(false);
+  ASSERT_FALSE(popups.empty()) << "the window keeps no hidden omnibox popup";
+  const auto all_aligned = [&]() {
+    return std::ranges::all_of(
+        popups, [&](views::Widget* popup) { return AlignedToTheField(popup); });
+  };
+  ASSERT_TRUE(base::test::RunUntil(all_aligned))
+      << "the hidden popups never followed the window's first layout: "
+      << Describe(popups.front());
+  BoundsChangeCounter counter(popups);
+  for (const bool collapse : {true, false}) {
+    SCOPED_TRACE(collapse ? "collapse" : "expand");
+    counter.Reset();
+    const gfx::Rect field = location_bar()->GetBoundsInScreen();
+    vertical_tab_strip_state_controller()->RequestCollapse(collapse);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !StripAnimating(); }));
+    ASSERT_NE(field, location_bar()->GetBoundsInScreen())
+        << "the motion did not move the location bar";
+    // Once the motion has ended, each follows it.
+    ASSERT_TRUE(base::test::RunUntil(all_aligned))
+        << "a hidden popup was left where the location bar was: "
+        << Describe(popups.front());
+    for (views::Widget* const popup : popups) {
+      EXPECT_FALSE(popup->IsVisible());
+      EXPECT_LE(counter.count(popup), 1)
+          << "a hidden popup window moved at every frame of the motion";
+    }
+  }
+}
