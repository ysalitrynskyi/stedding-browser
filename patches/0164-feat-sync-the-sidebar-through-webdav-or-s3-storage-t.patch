+class SidebarSyncBridgeTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(temp_.CreateUniqueTempDir()); }
+
+  std::unique_ptr<PlaceBridge> Bridge(FakeServer& server) {
+    const PlaceForm form = CheckPlaceForm(server.place.Form(
+        GURL("https://place.example.net/"), FakePlace::kSecret));
+    auto bridge = std::make_unique<PlaceBridge>(
+        *form.place, server.shared, base::DefaultClock::GetInstance(),
+        temp_.GetPath(),
+        base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock()}));
+    bridge->SetSignIn(*form.sign_in);
+    return bridge;
+  }
+
+  PlaceFailure Pull(PlaceBridge& bridge) {
+    base::test::TestFuture<PlaceFailure> done;
+    bridge.Pull(kOwn, done.GetCallback());
+    return done.Get();
+  }
+
+  std::optional<std::string> Mirrored(const std::string& name) {
+    std::string body;
+    if (!base::ReadFileToString(PlaceBridge::MirrorFor(temp_.GetPath())
+                                    .Append(base::FilePath::FromUTF8Unsafe(
+                                        name)),
+                                &body)) {
+      return std::nullopt;
+    }
+    return body;
+  }
+
+  static constexpr char kOwn[] = "aaaaaaaaaaaaaaaa";
+  const std::string kPeerName = "stedding-sidebar-0123456789abcdef.json";
+  const std::string kOwnName = "stedding-sidebar-aaaaaaaaaaaaaaaa.json";
+
+  base::test::TaskEnvironment task_environment_;
+  data_decoder::test::InProcessDataDecoder data_decoder_;
+  base::ScopedTempDir temp_;
+};
+
+// Sf51.
+TEST_F(SidebarSyncBridgeTest, AFileTheListShowsUnchangedIsNotDownloaded) {
+  for (const PlaceKind kind : {PlaceKind::kWebDav, PlaceKind::kS3}) {
+    FakeServer server(kind);
+    server.place.PutFile(kPeerName, "{\"a\":1}");
+    std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+    EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+    EXPECT_EQ(Mirrored(kPeerName), "{\"a\":1}");
+    EXPECT_EQ(server.place.Count("GET"), 1);
+    EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+    EXPECT_EQ(server.place.Count("GET"), 1);
+    // A new bridge, as after a restart, remembers too.
+    task_environment_.RunUntilIdle();
+    bridge = Bridge(server);
+    EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+    EXPECT_EQ(server.place.Count("GET"), 1);
+    server.place.PutFile(kPeerName, "{\"a\":2}");
+    EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+    EXPECT_EQ(server.place.Count("GET"), 2);
+    EXPECT_EQ(Mirrored(kPeerName), "{\"a\":2}");
+    PlaceBridge::ResetMirror(temp_.GetPath(), /*make=*/false);
+  }
+}
+
+// Sf19, Sf52.
+TEST_F(SidebarSyncBridgeTest, AFailureOrAShortListRemovesNothing) {
+  FakeServer server(PlaceKind::kWebDav);
+  server.place.PutFile(kPeerName, "{\"a\":1}");
+  std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+
+  FakePlace::Knobs knobs;
+  knobs.fail_status = 503;
+  server.place.SetKnobs(knobs);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kServerError);
+  EXPECT_EQ(Mirrored(kPeerName), "{\"a\":1}");
+
+  knobs = FakePlace::Knobs();
+  knobs.hide_files = true;
+  server.place.SetKnobs(knobs);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(Mirrored(kPeerName), "{\"a\":1}");
+}
+
+// Sf52: one computer's file that will not come holds the others back from
+// nothing, and is asked for again.
+TEST_F(SidebarSyncBridgeTest, AFileThatWillNotComeHoldsNoOtherBack) {
+  FakeServer server(PlaceKind::kWebDav);
+  const std::string other = "stedding-sidebar-fedcba9876543210.json";
+  server.place.PutFile(kPeerName, "{\"a\":1}");
+  server.place.PutFile(other, "{\"b\":2}");
+  FakePlace::Knobs knobs;
+  knobs.fail_file = kPeerName;
+  server.place.SetKnobs(knobs);
+  std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(Mirrored(other), "{\"b\":2}");
+  EXPECT_EQ(Mirrored(kPeerName), std::nullopt);
+
+  server.place.SetKnobs(FakePlace::Knobs());
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(Mirrored(kPeerName), "{\"a\":1}");
+}
+
+// Sf54: a list of many files at their cap is not all held in memory at once.
+// What one Pull leaves, the next takes.
+TEST_F(SidebarSyncBridgeTest, OnePullHoldsABoundedAmount) {
+  FakeServer server(PlaceKind::kWebDav);
+  constexpr int kFiles = 24;
+  const std::string body(3 * 1024 * 1024, 'x');
+  for (int file = 1; file <= kFiles; ++file) {
+    server.place.PutFile(
+        base::StringPrintf("stedding-sidebar-%016x.json", file), body);
+  }
+  std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_LT(server.place.Count("GET"), kFiles);
+  EXPECT_GT(server.place.Count("GET"), 0);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(server.place.Count("GET"), kFiles);
+}
+
+// Sf31: this computer's own file, gone from the place, is seen to be gone.
+TEST_F(SidebarSyncBridgeTest, AnOwnFileGoneFromThePlaceGoesFromTheMirror) {
+  FakeServer server(PlaceKind::kWebDav);
+  server.place.PutFile(kOwnName, "{\"own\":1}");
+  std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(Mirrored(kOwnName), "{\"own\":1}");
+  server.place.RemoveFile(kOwnName);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(Mirrored(kOwnName), std::nullopt);
+}
+
+// Sf51: one write at a time, through the mirror's order, and a write's own
+// version is not downloaded again.
+TEST_F(SidebarSyncBridgeTest, APushIsNotDownloadedBack) {
+  FakeServer server(PlaceKind::kS3);
+  std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+  base::test::TestFuture<PlaceFailure> pushed;
+  bridge->Push(kOwnName, "{\"own\":1}", pushed.GetCallback());
+  EXPECT_EQ(pushed.Get(), PlaceFailure::kNone);
+  EXPECT_EQ(server.place.Files()[kOwnName], "{\"own\":1}");
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(server.place.Count("GET"), 0);
+}
+
+TEST_F(SidebarSyncBridgeTest, AWriteWithNoETagIsReadBackOnce) {
+  FakeServer server(PlaceKind::kWebDav);
+  server.place.PutFile("x.txt", "ignored");
+  FakePlace::Knobs knobs;
+  knobs.no_etag = true;
+  server.place.SetKnobs(knobs);
+  std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+  base::test::TestFuture<PlaceFailure> pushed;
+  bridge->Push(kOwnName, "{\"own\":1}", pushed.GetCallback());
+  EXPECT_EQ(pushed.Get(), PlaceFailure::kNone);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(server.place.Count("GET"), 1);
+}
+
+// Sf28, Sf50: a conflict copy is a name, never read.
+TEST_F(SidebarSyncBridgeTest, AConflictCopyIsANameOnly) {
+  FakeServer server(PlaceKind::kWebDav);
+  const std::string copy = "stedding-sidebar-0123456789abcdef (1).json";
+  server.place.PutFile(copy, "{\"never\":1}");
+  std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(Mirrored(copy), "");
+  EXPECT_EQ(server.place.Count("GET"), 0);
+  server.place.RemoveFile(copy);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
+  EXPECT_EQ(Mirrored(copy), std::nullopt);
+}
+
+// Sf54.
+TEST_F(SidebarSyncBridgeTest, AFilePastItsCapIsCutOffAndAppliesNothing) {
+  FakeServer server(PlaceKind::kWebDav);
+  server.place.PutFile(kPeerName, std::string(kMaxFileBytes + 1, 'x'));
+  std::unique_ptr<PlaceBridge> bridge = Bridge(server);
+  EXPECT_EQ(Pull(*bridge), PlaceFailure::kNone);
