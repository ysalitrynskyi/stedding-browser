+namespace {
+
+// Every label's text under `view`, one per line.
+std::u16string TextUnder(views::View* view) {
+  std::u16string text;
+  if (const views::Label* const label =
+          views::AsViewClass<views::Label>(view)) {
+    text += label->GetText();
+    text += u"\n";
+  }
+  for (views::View* const child : view->children()) {
+    text += TextUnder(child);
+  }
+  return text;
+}
+
+// What the Dock was asked to do. Asked on the web apps' shortcut sequence
+// and read on the UI thread, so under a lock.
+class FakeDock : public stedding::AppDockForTesting {
+ public:
+  bool AddTile(const base::FilePath& launcher) override {
+    base::AutoLock hold(lock_);
+    asked_.push_back(launcher);
+    return !refuse_;
+  }
+  void RemoveTile(const base::FilePath& launcher) override {
+    base::AutoLock hold(lock_);
+    removed_.push_back(launcher);
+  }
+
+  // Every launcher a tile was asked for, refused ones included.
+  std::vector<base::FilePath> asked() {
+    base::AutoLock hold(lock_);
+    return asked_;
+  }
+  std::vector<base::FilePath> removed() {
+    base::AutoLock hold(lock_);
+    return removed_;
+  }
+  // The Dock answers kFailure while this is on.
+  void set_refuse(bool refuse) {
+    base::AutoLock hold(lock_);
+    refuse_ = refuse;
+  }
+
+ private:
+  base::Lock lock_;
+  std::vector<base::FilePath> asked_ GUARDED_BY(lock_);
+  std::vector<base::FilePath> removed_ GUARDED_BY(lock_);
+  bool refuse_ GUARDED_BY(lock_) = false;
+};
+
+class MakeAppMacTest : public stedding::WebAppBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    stedding::WebAppBrowserTest::SetUpOnMainThread();
+    stedding::SetAppDockForTesting(&dock_);
+  }
+
+  void TearDownOnMainThread() override {
+    stedding::SetAppDockForTesting(nullptr);
+    stedding::WebAppBrowserTest::TearDownOnMainThread();
+  }
+
+  GURL PageUrl(const std::string& host,
+               const std::string& path = "/title1.html") {
+    return embedded_https_test_server().GetURL(host, path);
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  content::WebContents* OpenPage(const GURL& url) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), url, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    content::WebContents* const contents = tabs()->GetActiveWebContents();
+    EXPECT_TRUE(web_app::test::WebAppPageWaiter(contents)
+                    .ExpectUrl(url)
+                    .ManifestOrLoadedNoManifest()
+                    .WaitAndFlushCommands());
+    return contents;
+  }
+
+  // The File menu's row, as the window validates it before the menu opens:
+  // whether it is enabled, and its title.
+  bool ValidateFileMenuRow(NSString** title) {
+    NSMenuItem* const row = [[[NSApp.mainMenu itemWithTag:IDC_FILE_MENU]
+        submenu] itemWithTag:IDC_STEDDING_MAKE_APP];
+    EXPECT_TRUE(row) << "no Add to Dock row in the File menu";
+    if (!row) {
+      return false;
+    }
+    NativeWidgetMacNSWindow* const window =
+        base::apple::ObjCCastStrict<NativeWidgetMacNSWindow>(
+            browser()->GetWindow()->GetNativeWindow().GetNativeNSWindow());
+    chrome::BrowserCommandController::From(browser())->TabStateChanged();
+    const bool enabled = [window validateUserInterfaceItem:row];
+    *title = row.title;
+    return enabled;
+  }
+
+  // Makes an app of a.test's page through the command, as the File menu
+  // does, and gives its id once its window is open.
+  webapps::AppId MakeApp() {
+    OpenPage(PageUrl("a.test"));
+    auto accept = web_app::SetPwaInstallationAutoRespondForTesting(
+        web_app::InstallDialogTestResponse::kAcceptAndLaunch);
+    ui_test_utils::BrowserCreatedObserver created;
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_MAKE_APP);
+    BrowserWindowInterface* const app = created.Wait();
+    EXPECT_TRUE(web_app::AppBrowserController::IsWebApp(app));
+    return web_app::AppBrowserController::IsWebApp(app)
+               ? web_app::AppBrowserController::From(app)->app_id()
+               : webapps::AppId();
+  }
+
+  // Waits until every task posted to the shortcut sequence so far has run,
+  // and the replies they posted to this thread with them.
+  static void FlushShortcutSequence() {
+    base::RunLoop loop;
+    web_app::internals::GetShortcutIOTaskRunner()->PostTaskAndReply(
+        FROM_HERE, base::DoNothing(), loop.QuitClosure());
+    loop.Run();
+  }
+
+  FakeDock dock_;
+};
+
+// web apps Wa1, Wa3, Wa4: the File menu's "Add to Dock…" is enabled on a web
+// page, disabled on a browser page, and reads "Open in <App>" on a page that
+// is an app's already.
+IN_PROC_BROWSER_TEST_F(MakeAppMacTest, TheFileMenuRowFollowsThePage) {
+  NSString* title = nil;
+  OpenPage(PageUrl("a.test"));
+  EXPECT_TRUE(ValidateFileMenuRow(&title));
+  EXPECT_NSEQ(@"Add to Dock…", title);
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL(chrome::kChromeUISettingsURL)));
+  EXPECT_FALSE(ValidateFileMenuRow(&title));
+  EXPECT_NSEQ(@"Add to Dock…", title);
+
+  const webapps::AppId app_id =
+      web_app::InstallWebAppFromPage(browser(), PageUrl("b.test"));
+  ASSERT_FALSE(app_id.empty());
+  OpenPage(PageUrl("b.test"));
+  EXPECT_TRUE(ValidateFileMenuRow(&title));
+  EXPECT_NSEQ(
+      base::SysUTF8ToNSString(
+          "Open in " + provider().registrar_unsafe().GetAppShortName(app_id)),
+      title);
+}
+
+// web apps Wa5: the dialog says Safari's "Add to Dock" and "Add", and from a
+// Space with an Independent session names the session the app opens in.
+IN_PROC_BROWSER_TEST_F(MakeAppMacTest, TheDialogSaysAddToDock) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->SetSpaceIsolated(work, true);
+  ASSERT_TRUE(model->SetActiveSpace(work));
+  OpenPage(PageUrl("a.test"));
+
+  views::NamedWidgetShownWaiter shown(views::test::AnyWidgetTestPasskey{},
+                                      "WebAppDiyInstallDialog");
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_MAKE_APP);
+  views::Widget* const dialog = shown.WaitIfNeededAndGet();
+  ASSERT_TRUE(dialog);
+  EXPECT_EQ(u"Add to Dock", dialog->widget_delegate()->GetWindowTitle());
+  views::DialogDelegate* const delegate =
+      dialog->widget_delegate()->AsDialogDelegate();
+  ASSERT_TRUE(delegate);
+  ASSERT_TRUE(delegate->GetOkButton());
+  EXPECT_EQ(u"Add", delegate->GetOkButton()->GetText());
+  const std::u16string text = TextUnder(dialog->GetRootView());
+  EXPECT_NE(std::u16string::npos,
+            text.find(u"Opens with the session of “Work”."))
+      << text;
+  delegate->CancelDialog();
+}
+
+// web apps Wa7: making an app adds one Dock tile, for its launcher in the
+// apps folder, and records it with the app. That no Finder window opens is
+// WebAppShortcutCreatorTest.AnAppTheUserMakesOpensNoFinderWindow's: under
+// --test-type Chromium never reveals a launcher.
+IN_PROC_BROWSER_TEST_F(MakeAppMacTest, InstallAddsOneDockTile) {
+  const webapps::AppId app_id = MakeApp();
+  ASSERT_FALSE(app_id.empty());
+
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !dock_.asked().empty(); }))
+      << "no tile was added";
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return stedding::IsAppInDock(browser()->GetProfile(), app_id);
+  })) << "the tile was not recorded";
+  ASSERT_EQ(1u, dock_.asked().size());
+  const base::FilePath launcher = dock_.asked().front();
+  EXPECT_EQ(".app", launcher.Extension());
+  EXPECT_TRUE(os_integration_override().chrome_apps_folder().IsParent(launcher))
+      << launcher;
+  EXPECT_TRUE(dock_.removed().empty());
+}
+
+// web apps Wa7: an app gets its tile once. Chromium asks for it again at the
+// end of every silent manifest update (FinalizeInstallOrUpdateJob calls
+// AddAppToQuickLaunchBar); those asks add no second tile, so a tile the user
+// took out of the Dock stays out and the Dock does not restart.
+IN_PROC_BROWSER_TEST_F(MakeAppMacTest, AnUpdateAddsNoSecondTile) {
+  const webapps::AppId app_id = MakeApp();
+  ASSERT_FALSE(app_id.empty());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return stedding::IsAppInDock(browser()->GetProfile(), app_id);
+  }));
+  ASSERT_EQ(1u, dock_.asked().size());
+
+  ASSERT_TRUE(provider().ui_manager().CanAddAppToQuickLaunchBar());
+  provider().ui_manager().AddAppToQuickLaunchBar(app_id);
+  provider().ui_manager().AddAppToQuickLaunchBar(app_id);
+  FlushShortcutSequence();
+  EXPECT_EQ(1u, dock_.asked().size()) << "the Dock was asked again";
+  EXPECT_TRUE(stedding::IsAppInDock(browser()->GetProfile(), app_id));
+}
+
+// web apps Wa7: a tile the Dock refused is not recorded, and the next ask,
+// an update's, tries again; once the Dock has it, no further ask reaches the
+// Dock.
+IN_PROC_BROWSER_TEST_F(MakeAppMacTest, ATileTheDockRefusedIsAskedForAgain) {
+  dock_.set_refuse(true);
+  const webapps::AppId app_id = MakeApp();
+  ASSERT_FALSE(app_id.empty());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !dock_.asked().empty(); }));
+  FlushShortcutSequence();
+  EXPECT_FALSE(stedding::IsAppInDock(browser()->GetProfile(), app_id))
+      << "a refused tile was recorded";
+
+  dock_.set_refuse(false);
+  provider().ui_manager().AddAppToQuickLaunchBar(app_id);
+  FlushShortcutSequence();
+  EXPECT_EQ(2u, dock_.asked().size());
+  EXPECT_TRUE(stedding::IsAppInDock(browser()->GetProfile(), app_id));
+
+  provider().ui_manager().AddAppToQuickLaunchBar(app_id);
+  FlushShortcutSequence();
+  EXPECT_EQ(2u, dock_.asked().size());
+}
+
+// web apps Wa18: removing the app takes away the tile Stedding added for it,
+// and that one alone.
+IN_PROC_BROWSER_TEST_F(MakeAppMacTest, UninstallRemovesTheTileItAdded) {
+  const webapps::AppId app_id = MakeApp();
+  ASSERT_FALSE(app_id.empty());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return stedding::IsAppInDock(browser()->GetProfile(), app_id);
+  }));
+  const base::FilePath launcher = dock_.asked().front();
+
+  UninstallWebApp(app_id);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !dock_.removed().empty(); }))
+      << "the tile stayed";
+  EXPECT_EQ(std::vector<base::FilePath>{launcher}, dock_.removed());
+  EXPECT_FALSE(stedding::IsAppInDock(browser()->GetProfile(), app_id));
+}
+
+}  // namespace
