+#ifndef CHROME_BROWSER_UI_WEBUI_STEDDING_SPACE_STEDDING_SPACE_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_STEDDING_SPACE_STEDDING_SPACE_HANDLER_H_
+
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+namespace stedding {
+
+// docs/features/tabs.md R66: tells chrome://stedding-space the name and
+// colour of the Space it shows, again when either changes, and opens the
+// support link in a tab when it is clicked.
+class SpacePageHandler : public content::WebUIMessageHandler,
+                         public spaces::SpaceModel::Observer {
+ public:
+  SpacePageHandler();
+  SpacePageHandler(const SpacePageHandler&) = delete;
+  SpacePageHandler& operator=(const SpacePageHandler&) = delete;
+  ~SpacePageHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // spaces::SpaceModel::Observer:
+  void OnActiveSpaceChanged(const spaces::SpaceId& from,
+                            const spaces::SpaceId& to) override;
+  void OnSpaceMetadataChanged(const spaces::SpaceId& id) override;
+  void OnSpaceModelDestroying() override;
+
+ private:
+  spaces::SpaceModel* Model();
+  base::DictValue Describe();
+  void HandleGetSpace(const base::ListValue& args);
+  void HandleOpenSupport(const base::ListValue& args);
+
+  base::ScopedObservation<spaces::SpaceModel, spaces::SpaceModel::Observer>
+      observation_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_WEBUI_STEDDING_SPACE_STEDDING_SPACE_HANDLER_H_
