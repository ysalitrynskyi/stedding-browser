+// Whether the item `id` is here already: open now, or, for Arc's ids,
+// brought over by an earlier import (I12). A file Stedding wrote is merged
+// against what is open alone, so a tab closed since comes back (Sf2,
+// docs/history/plan-2026-09-26.md WEB-19).
+bool Present(const ApplyContext& ctx, const std::string& id) {
+  return ctx.open.contains(id) || (!ctx.durable && ctx.ids->Contains(id));
+}
+
+// Records that the item `id` is here now: for Arc's ids in the profile too.
+void Remember(ApplyContext& ctx, const std::string& id) {
+  ctx.open.insert(id);
+  if (!ctx.durable) {
+    ctx.ids->Add(id);
+  }
+}
+
+// Sf2: a tab made from a file Stedding wrote keeps the file's id, so the
+// next import of that file, here or after a restart, finds it.
+void AdoptToken(const ApplyContext& ctx,
+                tabs::TabInterface* tab,
+                const std::string& id) {
+  if (!ctx.durable) {
+    return;
+  }
+  if (const std::string token = TokenOf(id); !token.empty()) {
+    stedding::SetTabToken(tab, token);
+  }
