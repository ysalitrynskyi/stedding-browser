diff --git a/chrome/browser/ui/spaces/app_jar.cc b/chrome/browser/ui/spaces/app_jar.cc
new file mode 100644
index 0000000000000..71738fa404851
--- /dev/null
+++ b/chrome/browser/ui/spaces/app_jar.cc
@@ -0,0 +1,236 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/app_jar.h"
+
+#include <algorithm>
+#include <memory>
+#include <vector>
+
+#include "base/strings/strcat.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/isolation_mark.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/common/stedding/web_apps.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/site_instance.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace spaces {
+
+namespace {
+
+// The shared jar is the profile's default partition, and a Space's jar is
+// known by its name alone: two configs name the same jar when both are the
+// shared one or both name the same Space jar.
+bool SameJar(const content::StoragePartitionConfig& a,
+             const std::optional<content::StoragePartitionConfig>& b) {
+  const bool a_space = IsSpaceStoragePartition(a);
+  if (!b) {
+    return !a_space;
+  }
+  return a_space && a.partition_name() == b->partition_name();
+}
+
+// web apps Wa5, Wa18: the name of the Space that keeps the jar `jar_name`
+// with its own session on, as SpaceModel::DisplayName gives it ("Space 2"
+// for one never named; every window's Spaces follow the registry's order);
+// empty when no Space keeps it. The name goes inside a sentence of a
+// warning, as NameInSentence gives it: a direction override in a synced
+// name reordered the uninstall and install warnings.
+std::u16string NameOfSpaceKeeping(content::BrowserContext* browser_context,
+                                  const std::string& jar_name) {
+  const SpaceRegistry* const registry =
+      browser_context ? SpaceRegistryFactory::GetForProfile(
+                            Profile::FromBrowserContext(browser_context))
+                      : nullptr;
+  if (!registry || jar_name.empty()) {
+    return std::u16string();
+  }
+  const std::vector<RegistryEntry>& entries = registry->entries();
+  for (size_t i = 0; i < entries.size(); ++i) {
+    if (!entries[i].isolated || entries[i].profile_id != jar_name) {
+      continue;
+    }
+    if (std::u16string name =
+            NameInSentence(base::UTF8ToUTF16(entries[i].name));
+        !name.empty()) {
+      return name;
+    }
+    return u"Space " + base::NumberToString16(i + 1);
+  }
+  return std::u16string();
+}
+
+}  // namespace
+
+std::optional<content::StoragePartitionConfig> StoragePartitionConfigForApp(
+    content::BrowserContext* browser_context,
+    std::string_view app_id) {
+  if (!browser_context || app_id.empty() || browser_context->IsOffTheRecord()) {
+    return std::nullopt;
+  }
+  const Profile* const profile = Profile::FromBrowserContext(browser_context);
+  const PrefService* const prefs = profile ? profile->GetPrefs() : nullptr;
+  if (!prefs) {
+    return std::nullopt;
+  }
+  // Wa13: the jar the app recorded, while a Space still keeps it; once the
+  // Space is deleted or its own session is off, the shared one.
+  return StoragePartitionConfigForProfileId(
+      browser_context, stedding::AppJarInUse(*prefs, app_id),
+      /*in_memory=*/false);
+}
+
+scoped_refptr<content::SiteInstance> SiteInstanceForAppPage(
+    content::BrowserContext* browser_context,
+    std::string_view app_id,
+    const GURL& url) {
+  if (!PageBelongsInSpaceJar(url)) {
+    return nullptr;
+  }
+  const std::optional<content::StoragePartitionConfig> jar =
+      StoragePartitionConfigForApp(browser_context, app_id);
+  if (!jar) {
+    return nullptr;
+  }
+  return content::SiteInstance::CreateForFixedStoragePartition(browser_context,
+                                                               url, *jar);
+}
+
+bool ContentsAreInAppJar(content::WebContents* contents,
+                         std::string_view app_id) {
+  if (!contents) {
+    return false;
+  }
+  return SameJar(
+      StoragePartitionConfigForWebContents(contents),
+      StoragePartitionConfigForApp(contents->GetBrowserContext(), app_id));
+}
+
+bool TabStaysOutOfApp(content::WebContents* contents, std::string_view app_id) {
+  if (!contents) {
+    return true;
+  }
+  if (tabs::TabInterface* const tab =
+          tabs::TabInterface::MaybeGetFromContents(contents)) {
+    // An essential is Chromium's pinned tab (sessions S8). A split's pane
+    // stays too: moving one pane out would end the split the user made.
+    if (tab->IsPinned() || tab->IsSplit()) {
+      return true;
+    }
+    BrowserWindowInterface* const window = tab->GetBrowserWindowInterface();
+    const SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+    if (model && model->IsSpacePinned(tab)) {
+      return true;
+    }
+  }
+  return !ContentsAreInAppJar(contents, app_id);
+}
+
+std::optional<SpaceId> SpaceForAppPage(
+    const SpaceModel& model,
+    const content::StoragePartitionConfig& partition) {
+  if (IsSpaceStoragePartition(partition)) {
+    return model.SpaceKeepingJar(partition);
+  }
+  if (!model.SpaceIsIsolated(model.active_id())) {
+    return model.active_id();
+  }
+  for (const std::unique_ptr<Space>& space : model.spaces()) {
+    if (!model.SpaceIsIsolated(space->id())) {
+      return space->id();
+    }
+  }
+  return std::nullopt;
+}
+
+bool SpaceListHasSpaceForJar(content::BrowserContext* browser_context,
+                             const content::StoragePartitionConfig& partition) {
+  const SpaceRegistry* const registry =
+      browser_context ? SpaceRegistryFactory::GetForProfile(
+                            Profile::FromBrowserContext(browser_context))
+                      : nullptr;
+  if (!registry) {
+    return false;
+  }
+  const bool space_jar = IsSpaceStoragePartition(partition);
+  return std::ranges::any_of(
+      registry->entries(), [&](const RegistryEntry& entry) {
+        return space_jar ? entry.isolated &&
+                               entry.profile_id == partition.partition_name()
+                         : !entry.isolated;
+      });
+}
+
+std::u16string AppSessionLine(content::WebContents* contents) {
+  if (!contents) {
+    return std::u16string();
+  }
+  const content::StoragePartitionConfig partition =
+      StoragePartitionConfigForWebContents(contents);
+  if (!IsSpaceStoragePartition(partition)) {
+    return std::u16string();
+  }
+  // The record counts only while a Space keeps the jar (Wa13): a page left
+  // in a jar no Space keeps any more -- one that held unsaved changes across
+  // a deletion or an isolation change (spaces SPC-9) -- makes an app on the
+  // shared session, of which the dialog says nothing.
+  const std::u16string name = NameOfSpaceKeeping(contents->GetBrowserContext(),
+                                                 partition.partition_name());
+  if (name.empty()) {
+    return std::u16string();
+  }
+  return base::StrCat({u"Opens with the session of “", name, u"”."});
+}
+
+std::u16string AppClearDataSpaceNote(content::BrowserContext* browser_context,
+                                     std::string_view app_id) {
+  const std::optional<content::StoragePartitionConfig> jar =
+      StoragePartitionConfigForApp(browser_context, app_id);
+  if (!jar) {
+    return std::u16string();
+  }
+  const std::u16string name =
+      NameOfSpaceKeeping(browser_context, jar->partition_name());
+  if (name.empty()) {
+    return std::u16string();
+  }
+  return base::StrCat(
+      {u"This also signs the tabs of “", name, u"” out of the site."});
+}
+
+std::u16string WithClearDataSpaceNote(std::u16string_view label,
+                                      std::u16string_view note) {
+  if (note.empty()) {
+    return std::u16string(label);
+  }
+  return base::StrCat({label, u". ", note});
+}
+
+std::u16string AppsKeepingSessionLine(const std::vector<std::u16string>& names,
+                                      std::u16string_view when) {
+  if (names.empty()) {
+    return std::u16string();
+  }
+  std::u16string joined;
+  for (size_t i = 0; i < names.size(); ++i) {
+    if (i > 0) {
+      joined += i + 1 == names.size() ? u" and " : u", ";
+    }
+    joined += base::StrCat({u"\u201C", NameInSentence(names[i]), u"\u201D"});
+  }
+  return base::StrCat({joined, u" will ", when});
+}
+
+}  // namespace spaces
