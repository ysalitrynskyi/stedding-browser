+// The panel's row for `key` (a page's address or a download's id), as a
+// script expression.
+std::string RowFor(const std::string& attribute, const std::string& key) {
+  return content::JsReplace(
+      "[...document.querySelectorAll('#list .row')].find("
+      "    row => row.dataset[$1] === $2)",
+      attribute, key);
+}
