diff --git a/chrome/browser/ui/views/stedding/update_pill.cc b/chrome/browser/ui/views/stedding/update_pill.cc
new file mode 100644
index 0000000000000..53d19d35f10f2
--- /dev/null
+++ b/chrome/browser/ui/views/stedding/update_pill.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/update_pill.h"
+
+#include <memory>
+#include <string>
+
+#include "base/functional/bind.h"
+#include "base/strings/strcat.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/views/tabs/common/sidebar_font.h"
+#include "ui/accessibility/ax_enums.mojom.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/font.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/text_constants.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/animation/ink_drop.h"
+#include "ui/views/animation/ink_drop_host.h"
+#include "ui/views/background.h"
+#include "ui/views/border.h"
+#include "ui/views/controls/highlight_path_generator.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/layout/flex_layout_types.h"
+#include "ui/views/view_class_properties.h"
+#include "ui/views/view_utils.h"
+
+namespace stedding {
+
+namespace {
+
+// Arc's words, with Stedding's name (the owner, 2026-10-16).
+constexpr char16_t kPillText[] = u"New Stedding Version Available";
+constexpr int kIconSize = 16;
+// The pill sits a little apart from the Archived row above it and the Space
+// row below.
+constexpr int kVerticalMargin = 6;
+
+}  // namespace
+
+UpdatePill::UpdatePill(AppUpdater& updater)
+    : views::LabelButton(
+          base::BindRepeating(&UpdatePill::OnPressed, base::Unretained(this)),
+          kPillText),
+      updater_(updater) {
+  SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  SetEnabledTextColors(kColorTabForegroundActiveFrameActive);
+  SetTextColor(views::Button::STATE_DISABLED,
+               kColorTabForegroundInactiveFrameActive);
+  label()->SetElideBehavior(gfx::ELIDE_TAIL);
+  // A row of the sidebar's content area, a layer that is not opaque: no
+  // subpixel text, which Label DCHECKs must be painted onto an opaque region.
+  label()->SetSkipSubpixelRenderingOpacityCheck(true);
+  label()->SetSubpixelRenderingEnabled(false);
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 10)));
+  SetProperty(views::kMarginsKey, gfx::Insets::VH(kVerticalMargin, 0));
+  SetProperty(views::kFlexBehaviorKey,
+              views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                                       views::MaximumFlexSizeRule::kPreferred));
+  // A hover and a press show on the pill as on a tab row.
+  views::InkDrop::Get(this)->SetMode(views::InkDropHost::InkDropMode::ON);
+  views::InkDrop::Get(this)->SetBaseColor(kColorTabForegroundActiveFrameActive);
+  SetHasInkDropActionOnClick(true);
+  views::InstallRoundRectHighlightPathGenerator(
+      this, gfx::Insets(),
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius));
+  observation_.Observe(&updater);
+  Refresh();
+}
+
+UpdatePill::~UpdatePill() = default;
+
+void UpdatePill::SetRailForm(bool rail) {
+  if (rail_ == rail) {
+    return;
+  }
+  rail_ = rail;
+  Refresh();
+}
+
+void UpdatePill::OnThemeChanged() {
+  views::LabelButton::OnThemeChanged();
+  // sidebar Y2, Y3: the rows' height and text size (a density change
+  // arrives as a theme change).
+  Refresh();
+}
+
+void UpdatePill::OnAppUpdaterChanged() {
+  Refresh();
+}
+
+void UpdatePill::Refresh() {
+  const AppUpdater::State state = updater_->state();
+  const bool installing = state == AppUpdater::State::kInstalling;
+  SetVisible(OffersRestart(state) || installing);
+  SetEnabled(!installing);
+
+  // The tooltip and the rail's name say what a click does; the version, when
+  // the release names one.
+  std::u16string tooltip = installing ? u"Restarting into the new version"
+                                      : u"Restart to update Stedding";
+  if (!updater_->version().empty() && !installing) {
+    tooltip = base::StrCat(
+        {u"Restart to update Stedding to ", updater_->version()});
+  }
+  SetTooltipText(tooltip);
+
+  SetText(rail_ ? std::u16string()
+                : std::u16string(installing ? u"Restarting…" : kPillText));
+  GetViewAccessibility().SetName(
+      rail_ ? tooltip
+            : std::u16string(installing ? u"Restarting…" : kPillText));
+  SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  SetImageModel(views::Button::STATE_NORMAL,
+                rail_ ? ui::ImageModel::FromVectorIcon(
+                            kBrowserToolsUpdateChromeRefreshOldIcon,
+                            kColorTabForegroundActiveFrameActive, kIconSize)
+                      : ui::ImageModel());
+  SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, rail_ ? 0 : 10)));
+
+  const gfx::FontList font = SidebarFont().DeriveWithWeight(
+      gfx::Font::Weight::MEDIUM);
+  if (!SameFont(label()->font_list(), font)) {
+    label()->SetFontList(font);
+  }
+  const int height = GetLayoutConstant(LayoutConstant::kVerticalTabHeight);
+  SetPreferredSize(gfx::Size(0, height));
+  SetBackground(views::CreateRoundedRectBackground(
+      kColorTabBackgroundActiveFrameActive,
+      GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius)));
+  InvalidateLayout();
+}
+
+void UpdatePill::OnPressed() {
+  updater_->InstallNow();
+}
+
+BEGIN_METADATA(UpdatePill)
+END_METADATA
+
+UpdatePill* AddUpdatePill(views::View& parent) {
+  AppUpdater* const updater = AppUpdater::Get();
+  if (!updater) {
+    return nullptr;
+  }
+  return parent.AddChildView(std::make_unique<UpdatePill>(*updater));
+}
+
+UpdatePill* FindUpdatePill(views::View& parent) {
+  for (views::View* const child : parent.children()) {
+    if (UpdatePill* const pill = views::AsViewClass<UpdatePill>(child)) {
+      return pill;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace stedding
