+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_DARK_PAGES_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_DARK_PAGES_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+#include "components/content_settings/core/browser/content_settings_observer.h"
+#include "components/content_settings/core/browser/host_content_settings_map.h"
+
+class Profile;
+
+// Dark pages' exceptions in chrome://settings/stedding
+// (docs/features/dark-pages.md Dk12, Dk13, Dk20): the mode and the list the
+// mode shows. They are a content setting, which the page's preference
+// bindings cannot reach, so this handler reads and writes them, and pushes a
+// fresh state whenever they change, from here or from the page menu and the
+// command bar (Dk20: a change made elsewhere shows at once).
+//
+// Messages:
+//   steddingGetDarkPages(callback) -> {mode: 'all'|'only',
+//       except: [{name, pattern}], only: [{name, pattern}]}
+//   steddingSetDarkPagesMode('all'|'only')
+//   steddingAddDarkPagesSite(callback, typed) -> whether it was a site (Dk13)
+//   steddingRemoveDarkPagesSite(pattern)
+// Event: "stedding-dark-pages-changed" with the state.
+class SteddingDarkPagesHandler : public settings::SettingsPageUIHandler,
+                                 public content_settings::Observer {
+ public:
+  explicit SteddingDarkPagesHandler(Profile* profile);
+  SteddingDarkPagesHandler(const SteddingDarkPagesHandler&) = delete;
+  SteddingDarkPagesHandler& operator=(const SteddingDarkPagesHandler&) = delete;
+  ~SteddingDarkPagesHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // content_settings::Observer:
+  void OnContentSettingChanged(
+      const ContentSettingsPattern& primary_pattern,
+      const ContentSettingsPattern& secondary_pattern,
+      ContentSettingsTypeSet content_type_set) override;
+
+  // What the page draws, for tests.
+  base::DictValue StateForTesting() const { return State(); }
+
+ private:
+  base::DictValue State() const;
+
+  void HandleGetDarkPages(const base::ListValue& args);
+  void HandleSetDarkPagesMode(const base::ListValue& args);
+  void HandleAddDarkPagesSite(const base::ListValue& args);
+  void HandleRemoveDarkPagesSite(const base::ListValue& args);
+
+  const raw_ptr<Profile> profile_;
+  base::ScopedObservation<HostContentSettingsMap, content_settings::Observer>
+      observation_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_STEDDING_DARK_PAGES_HANDLER_H_
