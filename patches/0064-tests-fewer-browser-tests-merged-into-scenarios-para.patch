+  const int split_right = tabstrip()->GetIndexOfTab(k3);
+  ASSERT_LT(split_left, split_right);
+  EXPECT_TRUE(tabstrip()->MoveTabsToFolderAt({split_left, split_right}, folder,
+                                             0));
+  EXPECT_LT(tabstrip()->GetIndexOfTab(k2), tabstrip()->GetIndexOfTab(k1));
+  EXPECT_LT(tabstrip()->GetIndexOfTab(k3), tabstrip()->GetIndexOfTab(k1));
+  EXPECT_LT(tabstrip()->GetIndexOfTab(k1), tabstrip()->GetIndexOfTab(b));
+  EXPECT_EQ(k2->GetSplit(), k3->GetSplit());
+  EXPECT_EQ(folder, k2->GetParentCollection()->GetParentCollection());
+
+  const int again_left = tabstrip()->GetIndexOfTab(k2);
+  const int again_right = tabstrip()->GetIndexOfTab(k3);
+  ASSERT_LT(again_left, again_right);
