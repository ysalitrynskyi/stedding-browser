+      << static_cast<int>(ink()->GetTargetInkDropState()) << ", button state "
+      << static_cast<int>(button->GetState()) << ", hovered "
+      << button->IsMouseHovered();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !ShowsTheCheckMark(button);
+  })) << "the check mark stayed";
