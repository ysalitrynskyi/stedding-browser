+// static
+int TabCollectionAnimatingLayoutManager::defer_targets_ = 0;
+
+// static
+std::set<TabCollectionAnimatingLayoutManager*>&
+TabCollectionAnimatingLayoutManager::DeferredManagers() {
+  static base::NoDestructor<std::set<TabCollectionAnimatingLayoutManager*>>
+      managers;
+  return *managers;
+}
+
+TabCollectionAnimatingLayoutManager::ScopedDeferTargets::ScopedDeferTargets() {
+  ++defer_targets_;
+}
+
+TabCollectionAnimatingLayoutManager::ScopedDeferTargets::
+    ~ScopedDeferTargets() {
+  if (--defer_targets_ > 0) {
+    return;
+  }
+  // Each manager recalculates once and puts its rows on the new target: a
+  // row that came in has no place to animate from.
+  std::set<TabCollectionAnimatingLayoutManager*> managers;
+  managers.swap(DeferredManagers());
+  for (TabCollectionAnimatingLayoutManager* const manager : managers) {
+    manager->SnapToTarget();
+  }
+}
+
+void TabCollectionAnimatingLayoutManager::SnapToTarget() {
+  if (!host_view()) {
+    return;
+  }
+  // As a change across the axis does (RecalculateTarget): the layout is the
+  // target, from and to, and nothing animates. ResetViewsToTargetLayout puts
+  // only rows laid out before on it; a row added since grew in from nothing.
+  RecalculateTarget();
+  current_layout_ = target_layout_;
+  SetStartingLayout(target_layout_);
+  animation_coordinator_->StopAnimation(this);
+  InvalidateHost(/*mark_layouts_changed=*/true);
+}
