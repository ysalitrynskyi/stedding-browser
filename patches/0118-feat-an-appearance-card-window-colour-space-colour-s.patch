+constexpr SkAlpha kSubtleLightCardAlpha = 0xA6;
+
+SkAlpha Scaled(int alpha, float scale) {
+  return static_cast<SkAlpha>(std::clamp(
+      static_cast<int>(std::lround(alpha * scale)), 0, int{SK_AlphaOPAQUE}));
+}
+
+// settings T41: the ground the user chose, for the look.
+SkColor ChosenWindow(const stedding::WindowLook& look, bool dark) {
+  switch (look.colour) {
+    case stedding::WindowColour::kNeutral:
+      return dark ? kNeutralDarkWindow : kNeutralLightWindow;
+    case stedding::WindowColour::kCustom: {
+      const uint32_t rgb = dark ? look.custom_dark : look.custom_light;
+      const SkColor picked =
+          SkColorSetRGB((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF);
+      color_utils::HSL hsl;
+      color_utils::SkColorToHSL(picked, &hsl);
+      if (dark ? hsl.l <= kCustomDarkMaxLightness
+               : hsl.l >= kCustomLightMinLightness) {
+        return picked;
+      }
+      hsl.l = dark ? kCustomDarkMaxLightness : kCustomLightMinLightness;
+      return color_utils::HSLToSkColor(hsl, SK_AlphaOPAQUE);
+    }
+    case stedding::WindowColour::kStedding:
+      break;
+  }
+  return dark ? kSteddingDarkWindow : kSteddingLightWindow;
+}
 
