+// windows G22: a new window's tabs of the pins and essentials are asleep with
+// no renderer: no page runs until one is chosen there.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest, ANewWindowsPinsHaveNoRenderer) {
+  PinPage(browser(), Page("/title1.html"));
+  PinEssential(browser(), Page("/title2.html"));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return Pins(second).size() == 1u && Essentials(second).size() == 1u;
+  }));
+  for (tabs::TabInterface* const tab :
+       {Pins(second).front(), Essentials(second).front()}) {
+    content::WebContents* const contents = tab->GetContents();
+    EXPECT_FALSE(contents->GetPrimaryMainFrame()->IsRenderFrameLive())
+        << contents->GetVisibleURL().spec();
+    EXPECT_TRUE(contents->WasDiscarded() ||
+                contents->GetController().NeedsReload())
+        << "a page loaded in the new window";
+  }
+}
