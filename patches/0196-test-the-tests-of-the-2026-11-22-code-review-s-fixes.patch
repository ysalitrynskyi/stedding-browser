+// import I22 (P09-1d): a first import reads Arc's history from its start, and
+// the history service drops every visit older than the 90 days it keeps.
+// Such a row is neither read nor counted: the result line counted it as
+// brought over, and the history held none of it.
+TEST(ArcHistoryExpiryW2B09Test, HistoryTheProfileWouldDropIsNotCounted) {
+  content::BrowserTaskEnvironment task_environment;
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::Time now = base::Time::Now();
+  const GURL old_page("https://old.example/");
+  const GURL recent_page("https://recent.example/");
+  ArcDataPaths paths;
+  paths.history = dir.GetPath().AppendASCII("History");
+  ASSERT_NO_FATAL_FAILURE(WriteHistoryW2B09(
+      paths.history, {{old_page.spec(), now - base::Days(100)},
+                      {recent_page.spec(), now - base::Days(1)}}));
+  std::unique_ptr<TestingProfile> profile = ProfileWithHistoryW2B09();
+
+  base::test::TestFuture<ArcDataResult> done;
+  ImportArcDataAsync(profile.get(), /*history=*/true, /*passwords=*/false,
+                     done.GetCallback(), paths);
+  EXPECT_EQ(1u, done.Get().history)
+      << "a visit the history drops as expired was counted";
+  EXPECT_TRUE(HistoryHoldsW2B09(profile.get(), recent_page));
+  EXPECT_FALSE(HistoryHoldsW2B09(profile.get(), old_page));
+}
