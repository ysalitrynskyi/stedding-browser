+// The three traffic lights' box, from `window`'s top-left corner.
+gfx::Rect LightsFromWindowTopLeft(NSWindow* window, const gfx::Point& origin) {
+  gfx::Rect lights;
+  for (NSWindowButton kind :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    if (NSButton* const button = [window standardWindowButton:kind]) {
+      lights.Union(ScreenFrame(window, button) - origin.OffsetFromOrigin());
+    }
+  }
+  return lights;
+}
