+std::optional<FolderView::DropPlace> FolderView::PlaceAmongRowsOf(
+    FolderView& holder,
+    const gfx::Point& screen_point) {
+  tabs::FolderTabCollection* const into = holder.folder();
+  tabs::FolderTabCollection* const folder = this->folder();
+  BrowserWindowInterface* const window = GetBrowserWindow();
+  TabStripModel* const model = window ? window->GetTabStripModel() : nullptr;
+  UnpinnedTabContainerView* const container =
+      NearestOfClass<UnpinnedTabContainerView>(this);
+  if (!into || !folder || !model || !container ||
+      !model->CanMoveFolderInto(folder, into)) {
+    return std::nullopt;
+  }
+  // As among the block's own rows (F38): before the first of the folder's
+  // rows on screen whose middle is below the pointer, or after the last one.
+  // Here the place is counted as the folder reads now, the dragged folder
+  // included when it is one of its rows.
+  const std::map<const tabs::TabInterface*, const views::View*> row_of_tab =
+      RowsByTab(holder);
+  DropPlace place;
+  place.into = into->GetHandle();
+  const views::View* previous = nullptr;
+  const views::View* next = nullptr;
+  std::optional<size_t> from;
+  size_t index = 0;
+  for (const tabs::Child& child : into->GetChildren()) {
+    if (IsChild(child, folder)) {
+      from = index;
+    } else if (const views::View* const row = DrawnRowOf(row_of_tab, child);
+               row && !next) {
+      if (screen_point.y() < row->GetBoundsInScreen().CenterPoint().y()) {
+        place.child_index = index;
+        next = row;
+      } else {
+        previous = row;
+        place.child_index = index + 1;
+      }
+    }
+    ++index;
+  }
+  // The bar: over the row after the place, else under the row before it,
+  // else under the header. The block's container draws it, in its own
+  // coordinates.
+  constexpr int kHalfGap = 1;
+  gfx::Point bar(0, next       ? next->bounds().y() - kHalfGap
+                    : previous ? previous->bounds().bottom() + kHalfGap
+                               : holder.header_->bounds().bottom() + kHalfGap);
+  views::View::ConvertPointToTarget(&holder, container, &bar);
+  place.indicator_y = bar.y();
+  place.moves = !from || (place.child_index != *from &&
+                          place.child_index != *from + 1);
+  return place;
+}
