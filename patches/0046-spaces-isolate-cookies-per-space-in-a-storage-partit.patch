+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_STORAGE_PARTITION_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_STORAGE_PARTITION_H_
+
+#include <optional>
+#include <string_view>
+
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "content/public/browser/storage_partition_config.h"
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+
+namespace spaces {
+
+class SpaceRegistry;
+
+// Partition domain for isolated Spaces (ADR 0019). Must be [a-z]*.
+inline constexpr char kSpacePartitionDomain[] = "spaces";
+
+// The on-disk partition for `profile_id`, or nullopt when `profile_id` is
+// empty (the Space shares the profile's default jar).
+std::optional<content::StoragePartitionConfig> StoragePartitionConfigForProfileId(
+    content::BrowserContext* browser_context,
+    std::string_view profile_id);
+
+// The partition the tabs of `id` should be created in, or nullopt when that
+// Space is not isolated (empty `profile_id`, no registry, or unknown id).
+std::optional<content::StoragePartitionConfig> StoragePartitionConfigForSpace(
+    content::BrowserContext* browser_context,
+    const SpaceRegistry* registry,
+    const SpaceId& id);
+
+// True when `config` is one of ours: domain `spaces` and a non-empty name.
+bool IsSpaceStoragePartition(const content::StoragePartitionConfig& config);
+
+// The partition `web_contents` was created in. Default when `web_contents` is
+// null.
+content::StoragePartitionConfig StoragePartitionConfigForWebContents(
+    content::WebContents* web_contents);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_STORAGE_PARTITION_H_
