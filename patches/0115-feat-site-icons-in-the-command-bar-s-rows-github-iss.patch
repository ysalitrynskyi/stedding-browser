+// The search engine's suggestions, served by the test server, and every
+// request for them it has had.
+class CommandBarSuggestTest : public CommandBarTest {
+ protected:
+  void SetUpOnMainThread() override {
+    embedded_test_server()->RegisterRequestMonitor(base::BindRepeating(
+        &CommandBarSuggestTest::OnRequest, base::Unretained(this)));
+    embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+        [](const net::test_server::HttpRequest& request)
+            -> std::unique_ptr<net::test_server::HttpResponse> {
+          if (!base::StartsWith(request.relative_url, "/suggest")) {
+            return nullptr;
+          }
+          auto answer = std::make_unique<net::test_server::BasicHttpResponse>();
+          answer->set_content_type("application/json");
+          answer->set_content("[\"\",[]]");
+          return answer;
+        }));
+    CommandBarTest::SetUpOnMainThread();
+  }
+
+  // With suggestions on, as Settings' "Send what you type" turns them on.
+  void UseASuggestingEngine() {
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        ::prefs::kSearchSuggestEnabled, true);
+    TemplateURLService* const engines =
+        TemplateURLServiceFactory::GetForProfile(browser()->GetProfile());
+    ASSERT_TRUE(engines);
+    search_test_utils::WaitForTemplateURLServiceToLoad(engines);
+    const std::string origin =
+        "http://search.test:" +
+        base::NumberToString(embedded_test_server()->port());
+    TemplateURLData data;
+    data.SetShortName(u"Suggesting");
+    data.SetKeyword(u"suggesting");
+    // Built as text: a GURL would escape the braces of {searchTerms}.
+    data.SetURL(origin + "/search?q={searchTerms}");
+    data.suggestions_url = origin + "/suggest?q={searchTerms}";
+    TemplateURL* const engine = engines->Add(std::make_unique<TemplateURL>(data));
+    ASSERT_TRUE(engine);
+    engines->SetUserSelectedDefaultSearchProvider(engine);
+    ASSERT_EQ(engine, engines->GetDefaultSearchProvider());
+  }
+
+  std::vector<std::string> Suggests() {
+    base::AutoLock hold(lock_);
+    return suggests_;
+  }
+
+ private:
+  // On the test server's thread.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    if (!base::StartsWith(request.relative_url, "/suggest")) {
+      return;
+    }
+    base::AutoLock hold(lock_);
+    suggests_.push_back(request.relative_url);
+  }
+
+  base::Lock lock_;
+  std::vector<std::string> suggests_;
+};
+
+// commandbar K12 (bug hunt 2026-11-16): Cmd-L's bar holds the page's address,
+// which the providers took as typed: with suggestions on, every Cmd-L sent it
+// to the search engine before a key was pressed. Nothing goes until the text
+// is edited; the first edit asks as typing does. The bar needs the window's
+// focus for the whole test, so it runs on the serial leg (tooling/dev).
+IN_PROC_BROWSER_TEST_F(CommandBarSuggestTest,
+                       TheAddressChordSendsTheSearchEngineNothing) {
+  ASSERT_NO_FATAL_FAILURE(UseASuggestingEngine());
+  chrome::ExecuteCommand(browser(), IDC_FOCUS_LOCATION);  // Cmd-L
+  stedding::CommandBarView* const bar = stedding::CommandBarView::GetOpenBar(
+      BrowserView::GetBrowserViewForBrowser(browser()));
+  ASSERT_TRUE(bar) << "the address chord opened no bar";
+  // An http address with a path and no port or query, which the search
+  // engine is otherwise sent: the test server's own have a port.
+  const std::u16string address = u"intranet.test/hr/case-1234";
+  bar->PrefillForTesting(address);
+  ASSERT_EQ(address, bar->field_for_testing()->GetText());
+  {
+    base::RunLoop wait;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, wait.QuitClosure(), base::Milliseconds(1500));
+    wait.Run();
+  }
+  EXPECT_TRUE(Suggests().empty())
+      << "the page's address went to the search engine: " << Suggests()[0];
+
+  // The bar closes when its window loses the focus, so it is looked up again
+  // after the wait (BACKLOG S-492).
+  stedding::CommandBarView* const still = stedding::CommandBarView::GetOpenBar(
+      BrowserView::GetBrowserViewForBrowser(browser()));
+  ASSERT_TRUE(still) << "the bar closed: the window lost the focus";
+  const std::u16string edited = address + u"5";
+  still->field_for_testing()->SetText(edited);
+  still->ContentsChanged(still->field_for_testing(), edited);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return std::ranges::any_of(Suggests(), [](const std::string& url) {
+      return url.find("case-12345") != std::string::npos;
+    });
+  })) << "the edited text was not sent either: is the engine asked at all?";
+  for (const std::string& url : Suggests()) {
+    EXPECT_NE(std::string::npos, url.find("case-12345")) << url;
+  }
+  if (stedding::CommandBarView* const open =
+          stedding::CommandBarView::GetOpenBar(
+              BrowserView::GetBrowserViewForBrowser(browser()))) {
+    open->Close();
+  }
+}
