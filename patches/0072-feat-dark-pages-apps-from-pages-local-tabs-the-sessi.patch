+// web apps Wa13: an app window still open when its Space is deleted keeps
+// the page it shows, signed in as it was, and the Space's jar is wiped once
+// that window has closed (sessions S17 waits for every window's pages).
+IN_PROC_BROWSER_TEST_F(AppJarTest, DeletingTheSpaceWaitsForTheAppsOpenWindow) {
+  ASSERT_NO_FATAL_FAILURE(SetUpSpaces());
+  const webapps::AppId app_id = MakeAppIn(work_);
+  ASSERT_FALSE(app_id.empty());
+  content::WebContents* const page = Launch(app_id, "/title2.html");
+  ASSERT_TRUE(page);
+  ASSERT_EQ(WorkJar(), JarOf(page));
+
+  bool wiped = false;
+  ASSERT_TRUE(model_->RemoveSpace(
+      work_, base::BindLambdaForTesting([&wiped] { wiped = true; })));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(wiped) << "the jar was wiped under the app's page";
+  EXPECT_EQ("jar=work", CookieOf(page));
+
+  CloseBrowserSynchronously(app_window_);
+  app_window_ = nullptr;
+  EXPECT_TRUE(base::test::RunUntil([&]() { return wiped; }))
+      << "the jar was never wiped";
+}
