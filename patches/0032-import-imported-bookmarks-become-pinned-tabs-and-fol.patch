@@ -0,0 +1,87 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/bookmarks_to_pins.h"
+
+#include <string>
+
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/bookmarks/bookmark_model_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/bookmarks/browser/bookmark_model.h"
+#include "components/bookmarks/browser/bookmark_node.h"
+#include "components/prefs/pref_service.h"
+
+namespace stedding {
+
+namespace {
+
+using Node = spaces::ArcImportPlan::Node;
+
+std::string IdOf(const bookmarks::BookmarkNode& node) {
+  return "bookmark:" + base::NumberToString(node.id());
+}
+
+void AppendChildren(const bookmarks::BookmarkNode& parent,
+                    std::vector<Node>* out) {
+  for (const auto& child : parent.children()) {
+    Node node;
+    node.arc_id = IdOf(*child);
+    node.title = child->GetTitle();
+    if (child->is_url()) {
+      if (!child->url().is_valid()) {
+        continue;
+      }
+      node.kind = Node::Kind::kTab;
+      node.url = child->url();
+    } else {
+      node.kind = Node::Kind::kFolder;
+      AppendChildren(*child, &node.children);
+      if (node.children.empty()) {
+        continue;
+      }
+    }
+    out->push_back(std::move(node));
+  }
+}
+
+}  // namespace
+
+std::vector<Node> NodesFromBookmarks(const bookmarks::BookmarkModel& model) {
+  std::vector<Node> nodes;
+  if (!model.loaded()) {
+    return nodes;
+  }
+  for (const bookmarks::BookmarkNode* root :
+       {static_cast<const bookmarks::BookmarkNode*>(model.bookmark_bar_node()),
+        static_cast<const bookmarks::BookmarkNode*>(model.other_node())}) {
+    if (root) {
+      AppendChildren(*root, &nodes);
+    }
+  }
+  return nodes;
+}
+
+spaces::ArcImportResult ConvertBookmarksToPins(
+    BrowserWindowInterface* browser) {
+  spaces::ArcImportResult result;
+  if (!browser || !spaces::SpaceModel::From(browser)) {
+    return result;
+  }
+  Profile* const profile = browser->GetProfile();
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContextIfExists(profile);
+  if (!model || !model->loaded()) {
+    return result;
+  }
+  result = spaces::ImportNodesAsPins(browser, NodesFromBookmarks(*model));
+  // I14: from now on the sidebar is the bookmarks.
+  profile->GetPrefs()->SetBoolean(prefs::kBookmarksConverted, true);
+  return result;
+}
+
+}  // namespace stedding
