+      {"no write", &FakePlace::Knobs::deny_write, PlaceFailure::kNoWrite,
+       PlaceFailure::kNoWrite},
+      {"changed bytes", &FakePlace::Knobs::corrupt_read,
+       PlaceFailure::kMismatch, PlaceFailure::kMismatch},
+      {"a list leaves it out", &FakePlace::Knobs::hide_files,
+       PlaceFailure::kNoList, PlaceFailure::kNoList},
+      {"anyone lists", &FakePlace::Knobs::public_list, PlaceFailure::kPublic,
+       PlaceFailure::kPublic},
+      {"anyone reads", &FakePlace::Knobs::public_read, PlaceFailure::kPublic,
+       PlaceFailure::kPublic},
+  };
+  for (const StepCase& step : kCases) {
+    for (const PlaceKind kind : {PlaceKind::kWebDav, PlaceKind::kS3}) {
+      SCOPED_TRACE(base::StrCat(
+          {step.name, kind == PlaceKind::kS3 ? " on S3" : " on WebDAV"}));
+      FakeServer server(kind);
+      FakePlace::Knobs knobs;
+      knobs.*step.knob = true;
+      server.place.SetKnobs(knobs);
+      const PlaceCheck::Result result = Run(server);
+      EXPECT_EQ(result.failure,
+                kind == PlaceKind::kS3 ? step.s3 : step.webdav);
+      EXPECT_TRUE(server.place.Files().empty());
+      // Sf47: and a folder it made goes with it.
+      EXPECT_FALSE(result.made_folder);
+      EXPECT_FALSE(server.place.HasFolder());
+    }
+  }
+}
