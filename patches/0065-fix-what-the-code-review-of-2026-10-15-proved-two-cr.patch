+// sessions S17, S21: deleting an independent Space waits to wipe its jar
+// while a page holding unsaved changes still shows in it. The page keeps its
+// session -- the form it sends carries the jar's cookie -- and once the user
+// leaves it, the tab moves to its new jar and the wipe follows. The wipe ran
+// right behind the tabs' rebinds and cleared the jar under the page, whose
+// form then went out signed out (2026-10-15).
+IN_PROC_BROWSER_TEST_F(SpaceJarTest, DeletingASpaceWaitsForAPageWithChanges) {
+  tabs::TabInterface* tab = nullptr;
+  ASSERT_NO_FATAL_FAILURE(OpenWebPage(work_, &tab));
+  content::WebContents* const page = tab->GetContents();
+  const content::StoragePartitionConfig work_jar = JarOf(tab);
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(work_jar));
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.stay = e => { e.preventDefault(); e.returnValue = ''; };"
+      "window.addEventListener('beforeunload', window.stay);"));
+
+  bool wiped = false;
+  ASSERT_TRUE(model_->RemoveSpace(
+      work_, base::BindLambdaForTesting([&wiped] { wiped = true; })));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(page, tab->GetContents()) << "the page must not be replaced";
+  EXPECT_EQ(work_jar, JarOf(tab));
+  EXPECT_FALSE(wiped) << "the jar was wiped under a page that is in it";
+
+  // The form the page sends goes in its own session, which is still there.
+  content::TestNavigationObserver posted(page);
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      content::JsReplace(
+          "window.removeEventListener('beforeunload', window.stay);"
+          "document.body.innerHTML = '<form method=post action=' + $1 +"
+          "    '><input name=note value=typed></form>';"
+          "document.forms[0].submit();",
+          Url("b.test", "/echo?after-the-delete"))));
+  posted.Wait();
+  EXPECT_EQ("jar=work", FirstCookieFor("/echo?after-the-delete"))
+      << "the form went out without its session";
+
+  // Leaving the page moves it to its new jar, and the wipe follows.
+  content::ExecuteScriptAsync(
+      tab->GetContents(),
+      content::JsReplace("location.href = $1;", Url("b.test", "/left")));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return tab->GetContents() != page && JarOf(tab) != work_jar;
+  }));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return wiped; }))
+      << "the jar was never wiped";
+}
