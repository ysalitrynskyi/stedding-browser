index 0000000000000..68d69bd3d0871
--- /dev/null
+++ b/chrome/browser/ui/spaces/sidebar_sync_tracker.cc
@@ -0,0 +1,238 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_sync_tracker.h"
+
+#include <algorithm>
+#include <optional>
+
+#include "base/strings/utf_string_conversions.h"
+#include "base/uuid.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/spaces/sidebar_ids.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+#include "chrome/browser/ui/stedding/little_window.h"
+#include "chrome/browser/ui/stedding/peek.h"
+#include "chrome/browser/ui/stedding/pin_home.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "chrome/browser/ui/stedding/tab_parents.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+// The folders `tab` sits in, outermost first.
+std::vector<const tabs::FolderTabCollection*> FolderChain(
+    const tabs::TabInterface* tab) {
+  std::vector<const tabs::FolderTabCollection*> chain;
+  for (const tabs::TabCollection* collection = tab->GetParentCollection();
+       collection; collection = collection->GetParentCollection()) {
+    if (collection->type() == tabs::TabCollection::Type::FOLDER) {
+      chain.insert(chain.begin(),
+                   static_cast<const tabs::FolderTabCollection*>(collection));
+    }
+  }
+  return chain;
+}
+
+void AppendOnce(std::vector<std::string>& list, const std::string& id) {
+  if (std::ranges::find(list, id) == list.end()) {
+    list.push_back(id);
+  }
+}
+
+std::string BoolText(bool value) {
+  return value ? "1" : "0";
+}
+
+}  // namespace
+
+bool IsRegistryWindow(BrowserWindowInterface* window, Profile* profile) {
+  if (!window || window->GetProfile() != profile ||
+      window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      window->IsDeleteScheduled() || stedding::IsLittleWindow(window) ||
+      stedding::IsPeekWindow(window) || !window->GetTabStripModel()) {
+    return false;
+  }
+  const SpaceModel* const model = SpaceModel::From(window);
+  return model && model->follows_registry();
+}
+
+std::vector<BrowserWindowInterface*> RegistryWindows(Profile* profile) {
+  std::vector<BrowserWindowInterface*> windows;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        if (IsRegistryWindow(window, profile)) {
+          windows.push_back(window);
+        }
+        return true;
+      });
+  return windows;
+}
+
+std::string SyncIdOfTab(const tabs::TabInterface* tab,
+                        const std::map<std::string, std::string>& resolved) {
+  const std::string token =
+      tab ? stedding::TabToken(tab->GetContents()) : std::string();
+  return token.empty() ? std::string()
+                       : Canonical(resolved, TabSyncId(token));
+}
+
+LocalView BuildLocalView(Profile* profile,
+                         const std::map<std::string, std::string>& resolved) {
+  LocalView view;
+  if (const SpaceRegistry* const registry =
+          SpaceRegistryFactory::GetForProfile(profile)) {
+    std::vector<std::string>& order = view.lists[kSpacesList];
+    for (const RegistryEntry& entry : registry->entries()) {
+      const std::string id = Canonical(resolved, entry.id.ToString());
+      LocalItem item;
+      item.kind = Kind::kSpace;
+      item.fields[kFieldName] = entry.name;
+      item.fields[kFieldIcon] = entry.icon;
+      item.fields[kFieldColor] = ColorToText(entry.color);
+      item.fields[kFieldDarkColor] =
+          entry.dark_color ? ColorToText(*entry.dark_color) : std::string();
+      item.fields[kFieldColorChosen] = BoolText(entry.color_chosen);
+      item.fields[kFieldIsolated] = BoolText(entry.isolated);
+      view.items[id] = std::move(item);
+      AppendOnce(order, id);
+    }
+  }
+  // The windows in a fixed order, so a run split over two windows reads the
+  // same at every look.
+  std::vector<BrowserWindowInterface*> windows = RegistryWindows(profile);
+  std::ranges::sort(windows, [](BrowserWindowInterface* a,
+                                BrowserWindowInterface* b) {
+    return a->GetSessionID().id() < b->GetSessionID().id();
+  });
+  std::set<std::string> tokens;
+  for (BrowserWindowInterface* const window : windows) {
+    SpaceModel* const model = SpaceModel::From(window);
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      std::string container;
+      if (tab->IsPinned()) {
+        const std::optional<SpaceId> owner = model->FindSpaceForTab(tab);
+        container = model->IsOwnEssential(tab) && owner
+                        ? OwnEssentialsListOf(
+                              Canonical(resolved, owner->ToString()))
+                        : std::string(kEssentialsList);
+      } else if (model->IsSpacePinned(tab)) {
+        const std::optional<SpaceId> space = model->FindSpaceForTab(tab);
+        if (!space) {
+          continue;
+        }
+        const std::vector<const tabs::FolderTabCollection*> chain =
+            FolderChain(tab);
+        // A pin in a folder under the Clear line is not in the run.
+        if (!chain.empty() && !model->IsFolderSpacePinned(chain.front())) {
+          continue;
+        }
+        container = PinsListOf(Canonical(resolved, space->ToString()));
+        for (const tabs::FolderTabCollection* const folder : chain) {
+          const std::string folder_id =
+              Canonical(resolved, FolderSyncId(folder->id()));
+          if (!view.items.contains(folder_id)) {
+            LocalItem item;
+            item.kind = Kind::kFolder;
+            item.fields[kFieldTitle] = folder->title();
+            item.fields[kFieldParent] = container;
+            view.items[folder_id] = std::move(item);
+          }
+          AppendOnce(view.lists[container], folder_id);
+          container = folder_id;
+        }
+      } else {
+        continue;
+      }
+      // Sf2: a second tab holding a token already read takes a new one, so
+      // no two items share an id.
+      std::string token = stedding::EnsureTabToken(tab);
+      if (!tokens.insert(token).second) {
+        token = base::Uuid::GenerateRandomV4().AsLowercaseString();
+        stedding::SetTabToken(tab, token);
+        tokens.insert(token);
+      }
+      const std::string id = Canonical(resolved, TabSyncId(token));
+      if (view.items.contains(id)) {
+        continue;
+      }
+      LocalItem item;
+      item.kind = Kind::kTab;
+      if (const std::optional<GURL> home = model->HomeUrl(tab);
+          home && stedding::IsAllowedPinHome(*home)) {
+        item.fields[kFieldHome] = home->spec();
+      }
+      item.fields[kFieldName] =
+          base::UTF16ToUTF8(stedding::TabName(tab->GetContents()));
+      item.fields[kFieldParent] = container;
+      view.items[id] = std::move(item);
+      AppendOnce(view.lists[container], id);
+    }
+  }
+  return view;
+}
+
+std::set<std::string> IdsOutsideRegistryWindows(
+    Profile* profile,
+    const std::map<std::string, std::string>& resolved) {
+  std::set<std::string> ids;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        if (window->GetProfile() != profile ||
+            !(stedding::IsLittleWindow(window) ||
+              stedding::IsPeekWindow(window)) ||
+            !window->GetTabStripModel()) {
+          return true;
+        }
+        const TabStripModel* const strip = window->GetTabStripModel();
+        for (int i = 0; i < strip->count(); ++i) {
+          if (std::string id = SyncIdOfTab(strip->GetTabAtIndex(i), resolved);
+              !id.empty()) {
+            ids.insert(std::move(id));
+          }
+        }
+        return true;
+      });
+  return ids;
+}
+
+std::vector<std::string> WithEnclosingFolders(const LocalView& view,
+                                              const std::string& id) {
+  std::vector<std::string> ids{id};
+  const auto item = view.items.find(id);
+  if (item == view.items.end()) {
+    return ids;
+  }
+  const auto parent_of = [&view](const std::string& of) -> std::string {
+    const auto it = view.items.find(of);
+    if (it == view.items.end()) {
+      return std::string();
+    }
+    const auto parent = it->second.fields.find(kFieldParent);
+    return parent == it->second.fields.end() ? std::string() : parent->second;
+  };
+  for (std::string up = parent_of(id);
+       !up.empty() && view.items.contains(up) &&
+       view.items.at(up).kind == Kind::kFolder &&
+       std::ranges::find(ids, up) == ids.end();
+       up = parent_of(up)) {
+    ids.push_back(up);
+  }
+  return ids;
+}
+
+}  // namespace spaces::sidebar_sync
