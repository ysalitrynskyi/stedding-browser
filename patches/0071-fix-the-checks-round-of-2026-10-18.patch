--- /dev/null
+++ b/chrome/test/stedding/privacy_defaults_browsertest.cc
@@ -0,0 +1,199 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Privacy defaults a fresh profile has, seen where a site sees them
+// (docs/features/privacy.md, docs/PRIVACY.md; PLAN.md TST-21). Global Privacy
+// Control reaches the test server and the page, follows its Settings row
+// across a restart (the row says a change takes effect after one), and a site
+// framed by another sets no cookie. The rows cited reads of the preferences'
+// defaults and of the switch the preference becomes.
+
+#include <string>
+
+#include "base/test/run_until.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/content_settings/core/browser/cookie_settings.h"
+#include "components/content_settings/core/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace {
+
+// Settings -> Stedding's "Send Global Privacy Control" row, drawn with its
+// preference, through every shadow root: $1 is "state" for whether it is
+// drawn and on ("on", "off", or "" before it is drawn), "click" to click it.
+constexpr char kGpcRow[] = R"(
+  (() => {
+    const find = root => {
+      const hit = root.querySelector(
+          'settings-toggle-button#globalPrivacyControl');
+      if (hit) {
+        return hit;
+      }
+      for (const element of root.querySelectorAll('*')) {
+        if (element.shadowRoot) {
+          const found = find(element.shadowRoot);
+          if (found) {
+            return found;
+          }
+        }
+      }
+      return null;
+    };
+    const row = find(document);
+    if (!row || !row.pref) {
+      return '';
+    }
+    if ($1 === 'click') {
+      row.click();
+    }
+    return row.checked ? 'on' : 'off';
+  })()
+)";
+
+class GlobalPrivacyControlTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  // What a site sees: the Sec-GPC header of the navigation to its page and
+  // of a fetch from that page, as the test server echoes them ("None" when
+  // there is none), and navigator.globalPrivacyControl.
+  void ExpectTheSignal(bool on) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(),
+        embedded_test_server()->GetURL("site.test", "/echoheader?Sec-GPC")));
+    content::WebContents* const page =
+        browser()->GetTabStripModel()->GetActiveWebContents();
+    const std::string header = on ? "1" : "None";
+    EXPECT_EQ(header,
+              content::EvalJs(page, "document.body.innerText").ExtractString())
+        << "the navigation's header";
+    EXPECT_EQ(header, content::EvalJs(page, R"(
+                  fetch('/echoheader?Sec-GPC')
+                      .then(response => response.text()))")
+                          .ExtractString())
+        << "a fetch's header";
+    EXPECT_EQ(on,
+              content::EvalJs(page, "navigator.globalPrivacyControl === true")
+                  .ExtractBool())
+        << "navigator.globalPrivacyControl";
+  }
+
+  // Turns the row to `on` on the settings page, as a person does.
+  void TurnTheRowTo(bool on) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), GURL("chrome://settings/stedding")));
+    content::WebContents* const page =
+        browser()->GetTabStripModel()->GetActiveWebContents();
+    std::string state;
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      state = content::EvalJs(page, content::JsReplace(kGpcRow, "state"))
+                  .ExtractString();
+      return !state.empty();
+    })) << "the row was never drawn";
+    ASSERT_EQ(on ? "off" : "on", state);
+    EXPECT_EQ(on ? "on" : "off",
+              content::EvalJs(page, content::JsReplace(kGpcRow, "click"))
+                  .ExtractString());
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return g_browser_process->local_state()->GetBoolean(
+                 stedding::prefs::kGlobalPrivacyControl) == on;
+    })) << "the row did not reach the preference";
+  }
+};
+
+// privacy Q4: a fresh profile sends the signal, and the row turns it off.
+IN_PROC_BROWSER_TEST_F(GlobalPrivacyControlTest,
+                       PRE_PRE_TheSignalFollowsTheRowAcrossARestart) {
+  ASSERT_TRUE(g_browser_process->local_state()->GetBoolean(
+      stedding::prefs::kGlobalPrivacyControl))
+      << "on by default";
+  ASSERT_NO_FATAL_FAILURE(ExpectTheSignal(true));
+  ASSERT_NO_FATAL_FAILURE(TurnTheRowTo(false));
+}
+
+// Off after the restart, and the row turns it on again.
+IN_PROC_BROWSER_TEST_F(GlobalPrivacyControlTest,
+                       PRE_TheSignalFollowsTheRowAcrossARestart) {
+  ASSERT_NO_FATAL_FAILURE(ExpectTheSignal(false));
+  ASSERT_NO_FATAL_FAILURE(TurnTheRowTo(true));
+}
+
+// On after the next restart.
+IN_PROC_BROWSER_TEST_F(GlobalPrivacyControlTest,
+                       TheSignalFollowsTheRowAcrossARestart) {
+  ASSERT_NO_FATAL_FAILURE(ExpectTheSignal(true));
+}
+
+// Every host resolves to the test server; rules are set before the browser
+// starts its work, as the resolver allows no change after that.
+class ThirdPartyCookiesTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+  }
+};
+
+// privacy Q1: in a normal window a site framed by another sets no cookie;
+// its own page does, and so does the same frame once third-party cookies
+// are allowed (the control). The row cited the preference's default only.
+IN_PROC_BROWSER_TEST_F(ThirdPartyCookiesTest, AFramedSiteSetsNoCookie) {
+  ASSERT_TRUE(embedded_https_test_server().Start());
+  Profile* const profile = browser()->GetProfile();
+  const GURL framed_site = embedded_https_test_server().GetURL("b.com", "/");
+  // a.com's page with b.com in its frame, which sets the cookie `name`.
+  const auto set_in_a_frame = [&](const std::string& name) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(),
+        embedded_https_test_server().GetURL("a.com", "/iframe.html")));
+    ASSERT_TRUE(content::NavigateIframeToURL(
+        browser()->GetTabStripModel()->GetActiveWebContents(), "test",
+        embedded_https_test_server().GetURL(
+            "b.com", "/set-cookie?" + name + "=1;SameSite=None;Secure")));
+  };
+  {
+    SCOPED_TRACE("blocked in a fresh profile");
+    ASSERT_EQ(static_cast<int>(
+                  content_settings::CookieControlsMode::kBlockThirdParty),
+              profile->GetPrefs()->GetInteger(prefs::kCookieControlsMode));
+    ASSERT_NO_FATAL_FAILURE(set_in_a_frame("framed"));
+    EXPECT_EQ("", content::GetCookies(profile, framed_site));
+  }
+  {
+    SCOPED_TRACE("the site's own page sets one");
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_https_test_server().GetURL(
+                       "b.com", "/set-cookie?own=1;SameSite=None;Secure")));
+    EXPECT_EQ("own=1", content::GetCookies(profile, framed_site));
+  }
+  {
+    SCOPED_TRACE("allowed, the frame sets one");
+    profile->GetPrefs()->SetInteger(
+        prefs::kCookieControlsMode,
+        static_cast<int>(content_settings::CookieControlsMode::kOff));
+    ASSERT_NO_FATAL_FAILURE(set_in_a_frame("allowed"));
+    const std::string cookies = content::GetCookies(profile, framed_site);
+    EXPECT_NE(std::string::npos, cookies.find("allowed=1")) << cookies;
+    EXPECT_EQ(std::string::npos, cookies.find("framed=1")) << cookies;
+  }
+}
+
+}  // namespace
