+// folders F43 (the owner, 2026-11-05; BACKLOG S-424): at the open width a
+// folder's rows stand as far apart as the list's, the header and the first
+// row under it included; selected, their backgrounds met with no gap.
+TEST_F(FolderViewTest, RowsStandApartAsTheListsDo) {
+  tabs::FolderTabCollection folder(tabs::FolderId::GenerateNew(), "Work",
+                                   /*collapsed=*/false);
+  TabCollectionNode node(&folder, TabStripOrientation::kVertical);
+  FolderView view(&node);
+  const auto add_row = [&view] {
+    views::View* const row = view.AddChildView(std::make_unique<views::View>());
+    row->SetPreferredSize(gfx::Size(200, 36));
+    return row;
+  };
+  views::View* const first = add_row();
+  views::View* const second = add_row();
+  view.SetBounds(0, 0, 240, 400);
+  views::test::RunScheduledLayout(&view);
+  EXPECT_EQ(2, first->y() - view.header_for_testing()->bounds().bottom())
+      << "the header and the row under it";
+  EXPECT_EQ(2, second->y() - first->bounds().bottom()) << "two rows";
+
+  // A row hidden takes no gap: a collapsed folder's rows go with theirs.
+  first->SetVisible(false);
+  views::test::RunScheduledLayout(&view);
+  EXPECT_EQ(2, second->y() - view.header_for_testing()->bounds().bottom());
+}
