+      panel_page(),
+      "document.querySelector('.chip[data-range=week]').click()"));
+  ASSERT_TRUE(WaitForRows(50)) << RowCount();
+  EXPECT_TRUE(ScrollUntilRows(60)) << RowCount();
+
+  Search("needle");
+  EXPECT_TRUE(WaitForRows(2)) << RowCount();
+}
