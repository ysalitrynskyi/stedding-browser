From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Wed, 9 Sep 2026 12:30:00 -0400
Subject: windows: the install mode is Stedding's own

Windows knew the round-8 build as Chromium in every way it keys on: the
install and profile directory %LOCALAPPDATA%\Chromium, the app name and app
id, the ProgIDs, the Active Setup GUID, the COM classes of the toast
activator, the elevator and the tracing service, and the app container SID
prefix the sandbox derives its profiles from. An installer made from it would
have installed on top of a Chromium install (docs/decisions/0018).

chrome/install_static/chromium_install_modes.h: the product path is
"Stedding", the app name, app id and ProgIDs are Stedding's, the direct
launch scheme is stedding:, and every GUID and the SID prefix are fresh, so
a Stedding install and a Chromium install on one machine share no registry
key, COM class or app container. The strings a user reads come from the
branding rewrite (tooling/apply-branding), not from here.

And chrome://settings/stedding opens on Windows (windows N5): the shortcut
reference on that page is the Mac's keyboard map and its handler is
Mac-only, but the page asked for it on every platform, and a WebUI message
nobody handles is a NOTREACHED in the browser process -- opening the
Stedding settings killed the Windows browser. The page asks only where the
reference exists (a loadTimeData boolean), and the Shortcuts block is absent
elsewhere until the Windows map lands.

Why: docs/features/windows.md N3, N5.
Removable when: upstream grows a third branding, or the install mode table
moves behind the BRANDING file; and when the shortcut reference has a
Windows map.
---
diff --git a/chrome/browser/resources/settings/stedding_page/stedding_page.html.ts b/chrome/browser/resources/settings/stedding_page/stedding_page.html.ts
index 578c41fddb..33ae1aa846 100644
--- a/chrome/browser/resources/settings/stedding_page/stedding_page.html.ts
+++ b/chrome/browser/resources/settings/stedding_page/stedding_page.html.ts
@@ -361,12 +361,13 @@ export function getHtml(this: SettingsSteddingPageElement) {
       label="$i18n{steddingNewTabShortcutsLabel}"
       sub-label="$i18n{steddingNewTabShortcutsSubLabel}">
   </settings-toggle-button>
+  ${this.hasShortcutReference_ ? html`
   <div class="hr cr-row" id="shortcutsHeader">
     <div class="flex">
       <div class="label">$i18n{steddingShortcutsTitle}</div>
       <div class="secondary">$i18n{steddingShortcutsIntro}</div>
     </div>
-  </div>
+  </div>` : ''}
   ${this.shortcuts_.map(group => html`
     <div class="settings-box continuation shortcut-group">
       <div class="shortcut-group-title">${group.title}</div>
diff --git a/chrome/browser/resources/settings/stedding_page/stedding_page.ts b/chrome/browser/resources/settings/stedding_page/stedding_page.ts
index b3f4e639fd..b88b702edd 100644
--- a/chrome/browser/resources/settings/stedding_page/stedding_page.ts
+++ b/chrome/browser/resources/settings/stedding_page/stedding_page.ts
@@ -84,6 +84,7 @@ export class SettingsSteddingPageElement extends
       backupStatus_: {type: String},
       exportStatus_: {type: String},
       arcImporting_: {type: Boolean},
+      hasShortcutReference_: {type: Boolean},
     };
   }
 
@@ -93,6 +94,8 @@ export class SettingsSteddingPageElement extends
   protected accessor arcSummary_: string = '';
   // import I19, I20.
   protected accessor backups_: Array<{path: string, label: string}> = [];
+  protected accessor hasShortcutReference_: boolean =
+      loadTimeData.getBoolean('steddingHasShortcutReference');
   protected accessor backupPath_: string = '';
   protected accessor backupStatus_: string = '';
   protected accessor exportStatus_: string = '';
@@ -106,9 +109,13 @@ export class SettingsSteddingPageElement extends
     sendWithPromise('steddingGetSpaces').then((spaces: unknown) => {
       this.spaces_ = spaces as SteddingSpace[];
     });
-    sendWithPromise('steddingGetShortcuts').then((groups: unknown) => {
-      this.shortcuts_ = groups as SteddingShortcutGroup[];
-    });
+    // windows N5: only where the browser answers (the reference is the
+    // Mac's); a message with no handler kills the browser.
+    if (this.hasShortcutReference_) {
+      sendWithPromise('steddingGetShortcuts').then((groups: unknown) => {
+        this.shortcuts_ = groups as SteddingShortcutGroup[];
+      });
+    }
     sendWithPromise('steddingGetArcImport').then((summary: unknown) => {
       this.arcSummary_ = String(summary || '');
     });
diff --git a/chrome/browser/ui/webui/settings/settings_ui.cc b/chrome/browser/ui/webui/settings/settings_ui.cc
index e35c3664c0..b1fd3ec437 100644
--- a/chrome/browser/ui/webui/settings/settings_ui.cc
+++ b/chrome/browser/ui/webui/settings/settings_ui.cc
@@ -890,6 +890,11 @@ SettingsUI::SettingsUI(content::WebUI* web_ui)
       "steddingShortcutsIntro",
       "Read from the same tables the menus use, so this list cannot drift "
       "from the keys. Remapping comes later.");
+  // windows N5: the reference is the Mac's keyboard map and its handler is
+  // Mac-only (above); the page asks for it only where it exists. A WebUI
+  // message nobody handles is a NOTREACHED in the browser process, and the
+  // page killed the Windows browser on open until 2026-09-09.
+  html_source->AddBoolean("steddingHasShortcutReference", BUILDFLAG(IS_MAC));
   html_source->AddBoolean("showAiPageAiFeatureSection",
                           show_ai_features_section);
 
