+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_PLACE_H_
+#define CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_PLACE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/time/time.h"
+#include "base/values.h"
+#include "url/gurl.h"
+
+// docs/features/sidebar-file.md Sf43-Sf57 (ADR 0032): what a WebDAV folder or
+// an S3 bucket the user set up is, and everything about one that needs no
+// network: the form's rules, the address rules, S3's signature, what a list
+// from a server says, and which sentence a failure gets. Nothing here reads a
+// profile or sends a request; the user's values are the only values.
+namespace spaces::sidebar_sync {
+
+enum class PlaceKind { kWebDav, kS3 };
+// "webdav" or "s3", as Settings and the profile say it.
+std::string_view PlaceKindName(PlaceKind kind);
+
+// Sf54: a response is cut off at its cap before it is read. A file's cap is
+// kMaxFileBytes.
+inline constexpr size_t kMaxListBytes = 1024 * 1024;
+inline constexpr size_t kMaxListEntries = 5000;
+
+// Sf51: the floors of a place, which has no watch and may charge per request.
+inline constexpr base::TimeDelta kPlaceActivationFloor = base::Seconds(30);
+inline constexpr base::TimeDelta kPlacePollInterval = base::Seconds(60);
+// Sf47, Sf52: no answer in this long is said as such.
+inline constexpr base::TimeDelta kPlaceRequestTimeout = base::Seconds(30);
+
+// The place the files are, with nothing secret in it. This is what the
+// profile keeps in the clear.
+struct Place {
+  Place();
+  Place(const Place& other);
+  Place& operator=(const Place& other);
+  ~Place();
+
+  bool operator==(const Place& other) const;
+
+  PlaceKind kind = PlaceKind::kWebDav;
+  // WebDAV: the folder the user typed, ending in "/". S3: the endpoint's
+  // scheme, host and port.
+  GURL address;
+  // S3 only. `path` has no slash at either end, and may be empty.
+  std::string region;
+  std::string bucket;
+  std::string path;
+
+  base::DictValue ToValue() const;
+  static std::optional<Place> FromValue(const base::DictValue& value);
+  // Sf49: the host and path, as the sheet and Settings name the place.
+  std::string Label() const;
+};
+
+// Sf55: a user name and password, or an access key ID and secret key. Only
+// ever in memory, or sealed by the system's key store.
+struct PlaceSignIn {
+  std::string name;
+  std::string secret;
+};
+
+// Sf55: the sign-in as the bytes that are sealed, and back.
+std::string SignInToText(const PlaceSignIn& sign_in);
+std::optional<PlaceSignIn> SignInFromText(std::string_view text);
+
+// Sf46: what a typed address is.
+enum class AddressCheck {
+  kEncrypted,
+  // `http`, to a loopback or private-network address.
+  kUnencrypted,
+  kMalformed,
+  // `http` to any other address.
+  kNotHttps,
+  // A name or a password inside the address.
+  kNameInside,
+};
+AddressCheck CheckAddress(std::string_view typed, GURL* address);
+// Whether a request to `url` stays on this computer or its network. A name
+// is judged by its form, as nothing is resolved: localhost and its
+// subdomains, a name with no dot, `.local`, `.lan`, `.internal`, `.home.arpa`.
+bool IsPrivateNetworkHost(const GURL& url);
+
+// Sf45, Sf46: the form as typed.
+struct PlaceForm {
+  PlaceForm();
+  PlaceForm(const PlaceForm& other);
+  PlaceForm& operator=(const PlaceForm& other);
+  ~PlaceForm();
+
+  // Both set only when every field is filled and well formed: **Test and
+  // continue** turns on.
+  std::optional<Place> place;
+  std::optional<PlaceSignIn> sign_in;
+  // Sf46: the password and the sidebar would travel unencrypted.
+  bool unencrypted = false;
+  // The first field that is filled and wrong: "address", "notHttps",
+  // "nameInside", "region", "bucket", "path", "name" or "secret"; empty when
+  // none is. An empty field is not wrong yet.
+  std::string problem;
+};
+PlaceForm CheckPlaceForm(const base::DictValue& form);
+// Sf53: the sign-in fields alone, for **Change sign-in**.
+PlaceForm CheckSignInForm(PlaceKind kind, const base::DictValue& form);
+
+// The folder the files are in, on a WebDAV server: `Stedding Sidebar` under
+// the address, or the address itself when that already is one (Sf8).
+GURL WebDavFolderUrl(const Place& place);
+// On S3: "<path>/Stedding Sidebar/", with no leading slash, and the URLs of
+// that prefix's list and of an object, path-style (Sf47).
+std::string S3KeyPrefix(const Place& place);
+GURL S3ListUrl(const Place& place, int max_keys);
+GURL S3ObjectUrl(const Place& place, std::string_view name);
+
+// S3's percent-encoding: everything but A-Za-z0-9-._~, and `/` when kept.
+std::string UriEncode(std::string_view text, bool keep_slash);
+
+// AWS Signature Version 4, from Chromium's own hash and HMAC. `headers` are
+// the signed headers other than `host`, which comes from `url`; their names
+// are in lower case.
+struct SigV4Input {
+  SigV4Input();
+  SigV4Input(const SigV4Input& other);
+  SigV4Input& operator=(const SigV4Input& other);
+  ~SigV4Input();
+
+  std::string method;
+  GURL url;
+  std::map<std::string, std::string> headers;
+  // The payload's SHA-256 in hexadecimal.
+  std::string payload_hash;
+  // "YYYYMMDDTHHMMSSZ".
+  std::string amz_date;
+  std::string region;
+  std::string service;
+  std::string access_key;
+  std::string secret_key;
+};
+std::string SigV4Authorization(const SigV4Input& input);
+std::string AmzDate(base::Time time);
+std::string Sha256Hex(std::string_view data);
+
+// One name in a list. `version` changes when the file does (Sf51): its ETag,
+// else its time and size; empty when the server gives neither.
+struct PlaceEntry {
+  std::string name;
+  std::string version;
+  int64_t size = -1;
+  bool folder = false;
+};
+
+struct PlaceList {
+  PlaceList();
+  PlaceList(PlaceList&& other);
+  PlaceList& operator=(PlaceList&& other);
+  ~PlaceList();
+
+  std::vector<PlaceEntry> entries;
+  // Sf52: the list stopped at a cap, so a name missing from it says nothing.
+  bool cut_short = false;
+};
+
+// An ETag as a version: the same whichever way a server quotes it.
+std::string VersionOfETag(std::string etag);
+
+// Sf54: a name a server sends is only ever a file name in one folder.
+bool IsSafeEntryName(std::string_view name);
+
+// Sf54: what the sandboxed decoder made of a server's XML. Nullopt when `root`
+// is not such a list.
+std::optional<PlaceList> ParseWebDavList(const base::Value& root,
+                                         const GURL& folder);
+std::optional<PlaceList> ParseS3List(const base::Value& root,
+                                     std::string_view prefix);
+struct S3Error {
+  std::string code;
+  std::string region;
+};
+S3Error ParseS3Error(const base::Value& root);
+
+// Sf47, Sf48, Sf52, Sf54: what went wrong, each a sentence in Settings.
+enum class PlaceFailure {
+  kNone,
+  // A wrong password or key.
+  kSignIn,
+  // The server asks for a kind of sign-in Stedding does not speak.
+  kSignInKind,
+  // A web page, not a WebDAV folder or an S3 bucket.
+  kWebPage,
+  kNoSuchPlace,
+  kNoWrite,
+  kNoRead,
+  kNoList,
+  kNoDelete,
+  kWrongRegion,
+  kClock,
+  kTimedOut,
+  kUnreachable,
+  kCertificate,
+  // A redirect to another host, or from https to http.
+  kRedirect,
+  // Anyone can read the place (Sf48).
+  kPublic,
+  // The probe came back different.
+  kMismatch,
+  kServerError,
+  kTooLarge,
+};
+
+// What a request was doing, which says what a 403 means.
+enum class PlaceOp { kRoot, kList, kRead, kWrite, kDelete };
+
+PlaceFailure FailureOfStatus(PlaceOp op, int http_status, bool basic_offered);
+PlaceFailure FailureOfS3Error(PlaceOp op,
+                              int http_status,
+                              std::string_view code);
+PlaceFailure FailureOfNetError(int net_error);
+// The name Settings' sentences go by.
+std::string_view PlaceFailureName(PlaceFailure failure);
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_PLACE_H_
