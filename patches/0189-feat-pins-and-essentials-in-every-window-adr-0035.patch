+// windows G13: two windows that each changed a row's place never make a row
+// neither had. An essential takes no folder, and an own essential made shared
+// in one window and a Space pin in another is a Space pin of its Space.
+TEST_F(PinStoreTest, TwoWindowsPlacesMakeNoRowNeitherHad) {
+  const SpaceId work = NewSpace();
+  PinStore store(&prefs_);
+  PinRecord own = Essential("o", "https://o.example/");
+  own.space = work;
+  own.has_space = true;
+  const std::vector<PinRecord> held = {Pin("x", work, "https://x.example/"),
+                                       own};
+  Ready(store, held);
+  // Another window makes x an essential, and o a shared essential.
+  PublishAll(store,
+             {Essential("x", "https://x.example/"),
+              Essential("o", "https://o.example/")},
+             {});
+
+  // This window, behind, put x in a folder and made o a pin of Work.
+  PinRecord filed = Pin("x", work, "https://x.example/");
+  filed.folder_path = R"([{"id":"f","title":"Mail"}])";
+  const PinChanges changes =
+      store.ChangesSince(held, {filed, Pin("o", work, "https://o.example/")});
+  store.Publish(changes.order, changes.changed, {});
+
+  const PinRecord* const x = store.Find("x");
+  ASSERT_TRUE(x);
+  EXPECT_FALSE(x->tier == PinTier::kEssential && !x->folder_path.empty())
+      << "an essential in a folder";
+  const PinRecord* const o = store.Find("o");
+  ASSERT_TRUE(o);
+  EXPECT_EQ(PinTier::kSpacePin, o->tier);
+  EXPECT_TRUE(o->has_space) << "a Space pin of no Space";
+  EXPECT_EQ(work, o->space);
+}
