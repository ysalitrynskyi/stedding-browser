index 0000000000000..6725732ea88ae
--- /dev/null
+++ b/chrome/test/stedding/audit_b12_browsertest.cc
@@ -0,0 +1,168 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Test and continue for a WebDAV folder or an S3 bucket
+// (docs/features/sidebar-file.md Sf47, Sf48), from the Settings page, through
+// the real network stack, on a server that refuses every request with no
+// sign-in with a status Stedding has no sentence of its own for.
+
+#include <atomic>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/json/json_writer.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/test/run_until.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_fake_place.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_place.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_service.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_service_factory.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/http/http_status_code.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "net/test/embedded_test_server/http_request.h"
+#include "net/test/embedded_test_server/http_response.h"
+#include "url/gurl.h"
+
+namespace {
+
+namespace sb = spaces::sidebar_sync;
+using sb::FakePlace;
+using sb::PlaceKind;
+
+// The error an S3 endpoint that takes only signed requests gives one with no
+// sign-in, in the words such a service may use.
+constexpr char kAnyoneRefusedB12[] =
+    "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Error><Code>InvalidArgument"
+    "</Code><Message>Authorization</Message></Error>";
+
+// The place in memory, except that a request with no sign-in is answered
+// with `anyone_status` when it is set, and on S3 with the error above.
+std::unique_ptr<net::test_server::HttpResponse> AnswerRefusingAnyoneB12(
+    FakePlace* place,
+    PlaceKind kind,
+    const std::atomic<int>* anyone_status,
+    const net::test_server::HttpRequest& request) {
+  std::map<std::string, std::string> headers;
+  for (const auto& [name, value] : request.headers) {
+    headers[base::ToLowerASCII(name)] = value;
+  }
+  auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+  const int status = anyone_status->load();
+  if (status && !headers.contains("authorization")) {
+    response->set_code(static_cast<net::HttpStatusCode>(status));
+    if (kind == PlaceKind::kS3) {
+      response->set_content_type("application/xml");
+      response->set_content(kAnyoneRefusedB12);
+    }
+    return response;
+  }
+  // The address the request was sent to, as a signature covers it.
+  const GURL url(
+      base::StrCat({"http://", headers["host"], request.relative_url}));
+  const FakePlace::Reply reply =
+      place->Handle(request.method_string, url, headers, request.content);
+  response->set_code(static_cast<net::HttpStatusCode>(reply.status));
+  response->set_content(reply.body);
+  for (const auto& [name, value] : reply.headers) {
+    response->AddCustomHeader(name, value);
+  }
+  return response;
+}
+
+class SidebarSyncPlaceRefusalB12Test
+    : public InProcessBrowserTest,
+      public testing::WithParamInterface<PlaceKind> {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    place_ = std::make_unique<FakePlace>(GetParam());
+    server_.RegisterRequestHandler(base::BindRepeating(
+        &AnswerRefusingAnyoneB12, base::Unretained(place_.get()), GetParam(),
+        base::Unretained(&anyone_status_)));
+    ASSERT_TRUE(server_.Start());
+  }
+
+  void TearDownOnMainThread() override {
+    service()->CancelJoin();
+    if (service()->enabled()) {
+      service()->Stop(/*remove_own_file=*/false);
+    }
+    ASSERT_TRUE(server_.ShutdownAndWaitUntilComplete());
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+
+  net::EmbeddedTestServer server_;
+  std::unique_ptr<FakePlace> place_;
+  std::atomic<int> anyone_status_{0};
+};
+
+INSTANTIATE_TEST_SUITE_P(,
+                         SidebarSyncPlaceRefusalB12Test,
+                         testing::Values(PlaceKind::kWebDav, PlaceKind::kS3),
+                         [](const testing::TestParamInfo<PlaceKind>& info) {
+                           return info.param == PlaceKind::kS3 ? "S3"
+                                                               : "WebDav";
+                         });
+
+// P15-1a, Sf48: a server that refuses every request with no sign-in with a
+// 400, as some S3 services do, lists nothing and serves nothing to anyone.
+// Test and continue passes and leads to the sheet, with no probe left; it
+// said "The server answered with an error." A server that gives anyone no
+// answer still does not pass.
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceRefusalB12Test,
+                       ARefusalWithA400ToAnyonePassesTheTest) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("chrome://settings/stedding")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  const std::optional<std::string> form =
+      base::WriteJson(place_->Form(server_.base_url(), FakePlace::kSecret));
+  ASSERT_TRUE(form);
+  // The page tests the place through its own message, as Test and continue
+  // does, and answers with the failure or the kind of place its sheet names.
+  const std::string test = base::StrCat({R"(
+    (async () => {
+      const cr = await import('chrome://resources/js/cr.js');
+      const answer = await cr.sendWithPromise('steddingTestSyncPlace', )",
+                                         *form, R"();
+      return answer.failure || answer.place;
+    })()
+  )"});
+
+  anyone_status_ = 503;
+  EXPECT_EQ("serverError", content::EvalJs(page, test));
+  EXPECT_TRUE(place_->Files().empty()) << "the probe stayed";
+  EXPECT_FALSE(service()->enabled());
+
+  anyone_status_ = 400;
+  const std::string sheet = GetParam() == PlaceKind::kS3 ? "s3" : "webdav";
+  EXPECT_EQ(sheet, content::EvalJs(page, test));
+  EXPECT_TRUE(place_->Files().empty()) << "the probe stayed";
+  EXPECT_FALSE(service()->enabled());
+
+  // Cancel leaves the place as it was found.
+  service()->CancelJoin();
+  EXPECT_TRUE(base::test::RunUntil([&] { return !place_->HasFolder(); }));
+}
+
+}  // namespace
