+namespace spaces {
+
+// Import from a browser built on Chromium that keeps Chromium's own files
+// (docs/features/import.md I28-I33, I40, I42): its bookmarks, history and
+// saved passwords, read from copies off the UI thread, as Arc's are (I22,
+// I23, I27). Dia is the one such browser so far; another is one more entry
+// in a table of these.
+struct ChromiumFamilySource {
+  // The key of its bookmark folder, its imports and its watermarks.
+  std::string_view key;
+  // Its name, as the import's lines say it.
+  std::u16string_view name;
+  // On the Mac: the folder under ~/Library/Application Support.
+  std::string_view mac_folder;
+  // On the Mac: the keychain item its password key is under.
+  std::string_view keychain_service;
+  // On Windows: the folder under %LOCALAPPDATA%, plain or inside a Store
+  // package whose name starts with `store_package` and an underscore.
+  std::string_view windows_folder;
+  std::string_view store_package;
+  // Its process, without ".exe".
+  std::string_view process_name;
+};
+
+// import I28: Dia. Its places are as reported for its Mac release; the
+// Windows ones are not yet seen on a real install.
+inline constexpr ChromiumFamilySource kDiaSource = {
+    .key = "dia",
+    .name = u"Dia",
+    .mac_folder = "Dia",
+    .keychain_service = "Dia Safe Storage",
+    .windows_folder = "Dia",
+    .store_package = "TheBrowserCompany.Dia",
+    .process_name = "Dia",
+};
+
+// import I28: its "User Data" folder, or an empty path. On the Mac,
+// ~/Library/Application Support/<mac_folder>/User Data; on Windows, the
+// first that exists of %LOCALAPPDATA%\<windows_folder>\User Data and
+// %LOCALAPPDATA%\Packages\<store_package>_*\LocalCache\Local\<windows_folder>\
+// User Data. Blocking.
+base::FilePath FindUserDataDir(const ChromiumFamilySource& source);
+
+// One of its profiles.
+struct ChromiumProfile {
+  // Its folder inside User Data ("Default", "Profile 1").
+  base::FilePath dir;
+  // The name its owner gave it.
+  std::u16string name;
+  // The one used last, which the import offers first.
+  bool last_used = false;
+};
+
+// import I28: the profiles Local State's profile.info_cache names whose
+// folder exists, the one used last (profile.last_used) first; "Default" alone
+// when Local State names none. A name that is not one folder inside
+// `user_data_dir` is skipped. Blocking.
+std::vector<ChromiumProfile> ListChromiumProfiles(
+    const base::FilePath& user_data_dir);
+
+// import I29: at most this many bookmarks and folders are read, at most this
+// many folders deep, from a file of at most this size.
+inline constexpr size_t kMaxChromiumBookmarks = 100000;
+inline constexpr size_t kMaxChromiumBookmarkDepth = 64;
+inline constexpr int64_t kMaxChromiumBookmarksBytes = 32 * 1024 * 1024;
+
+struct ChromiumBookmarks {
+  ChromiumBookmarks();
+  ChromiumBookmarks(ChromiumBookmarks&&);
+  ChromiumBookmarks& operator=(ChromiumBookmarks&&);
+  ~ChromiumBookmarks();
+
+  // The bookmark bar's are marked as on the toolbar; the mobile ones are in
+  // "Mobile bookmarks".
+  std::vector<user_data_importer::ImportedBookmarkEntry> entries;
+  // Pages that are not web pages, and what lies past the caps.
+  size_t left_out = 0;
+  // The file is there but could not be read: too big, or not JSON.
+  bool unreadable = false;
+};
+
+// import I29: a Chromium "Bookmarks" file (roots bookmark_bar, other and
+// synced), only http and https pages, date_added as the creation time.
+// Blocking.
+ChromiumBookmarks ReadChromiumBookmarks(
+    const base::FilePath& bookmarks_file,
+    size_t cap = kMaxChromiumBookmarks,
+    size_t max_depth = kMaxChromiumBookmarkDepth);
+
+// import I32: what a profile holds, counted without unsealing anything, so
+// no keychain prompt comes before the button. History is not counted: a
+// History file can be hundreds of megabytes, copied on every count.
+struct ChromiumProfileSummary {
+  ChromiumProfile profile;
+  size_t bookmarks = 0;
+  bool history = false;
+  size_t passwords = 0;
+};
+
+// "812 bookmarks, history and 96 saved passwords", or "Nothing to bring
+// over".
+std::u16string SummariseChromiumProfile(const ChromiumProfileSummary& summary);
+
+struct ChromiumFamilyInfo {
+  ChromiumFamilyInfo();
+  ChromiumFamilyInfo(ChromiumFamilyInfo&&);
+  ChromiumFamilyInfo& operator=(ChromiumFamilyInfo&&);
+  ~ChromiumFamilyInfo();
+
+  bool found = false;
+  // Its process is running: the copies may miss what it has not written.
+  bool running = false;
+  std::vector<ChromiumProfileSummary> profiles;
+};
+
+// import I28, I32: finds the browser and sums up each profile on the thread
+// pool, then runs `done` on the caller's sequence.
+void LoadChromiumFamilyInfo(const ChromiumFamilySource& source,
+                            base::OnceCallback<void(ChromiumFamilyInfo)> done);
+
+// Which parts to bring over: all three start ticked (I32).
+struct ChromiumFamilyParts {
+  bool bookmarks = true;
+  bool history = true;
+  bool passwords = true;
+};
+
+// import I42: what an import did.
+struct ChromiumFamilyResult {
+  std::u16string_view name;
+  bool already_running = false;
+  bool not_found = false;
+  size_t bookmarks = 0;
+  size_t bookmarks_already = 0;
+  size_t bookmarks_left_out = 0;
+  bool bookmarks_unreadable = false;
+  size_t history = 0;
+  bool passwords_asked = false;
+  // The key was refused or could not be read: no password came over.
+  bool key_denied = false;
+  // Values sealed to the browser itself ("v20") and other unreadable values.
+  size_t passwords_bound = 0;
+  size_t passwords_unreadable = 0;
+  // Logins past the 10,000 read (BACKLOG S-346).
+  size_t passwords_past_the_cap = 0;
+  stedding::PasswordWriteResult passwords;
+  bool bookmarks_blocked = false;
+  bool history_blocked = false;
+  bool passwords_blocked = false;
+};
+
+// import I42: the one result line.
+std::u16string DescribeChromiumFamilyResult(const ChromiumFamilyResult& result);
+
+// import I29-I31, I40: brings the ticked `parts` of `profile_dir` into
+// `profile`: the bookmarks into the source's folder under Other bookmarks,
+// visits the profile does not have yet, and the saved logins through
+// Chromium's importer, which replaces none. The key is read, and macOS may
+// ask, only when passwords are ticked. The profile's ImportJobs holds the
+// import until `done` has run; a second while one runs does nothing.
+void ImportChromiumFamilyAsync(
+    Profile& profile,
+    const ChromiumFamilySource& source,
+    const ChromiumProfile& source_profile,
+    ChromiumFamilyParts parts,
+    base::OnceCallback<void(ChromiumFamilyResult)> done);
+
+// For tests: the key ReadChromiumFamilyKey returns instead of asking the
+// keychain or reading Local State (nullopt: a key that was refused), until
+// the override is cleared; and how many times a key was asked for. Set on
+// the UI thread before an import starts.
+void SetChromiumFamilyKeyForTesting(
+    std::optional<std::optional<std::vector<uint8_t>>> key);
+size_t ChromiumFamilyKeyReadsForTesting();
+
+}  // namespace spaces
