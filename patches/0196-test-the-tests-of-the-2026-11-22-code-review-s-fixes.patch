+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <optional>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/stedding/address_row.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/test_vertical_tab_strip_state_controller_delegate.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/prefs/pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+// The window's sidebar through its real state controller, collapsed and
+// expanded at once by the test delegate, as AddressRowTest has it.
+class AddressRowW2B18Test : public BrowserWithTestWindowTest {
+ protected:
+  void SetUp() override {
+    BrowserWithTestWindowTest::SetUp();
+    if (tabs::VerticalTabStripStateController* const state = controller()) {
+      state->SetDelegate(&delegate_);
+    }
+  }
+
+  void TearDown() override {
+    if (tabs::VerticalTabStripStateController* const state = controller()) {
+      state->SetDelegate(nullptr);
+    }
+    BrowserWithTestWindowTest::TearDown();
+  }
+
+  tabs::VerticalTabStripStateController* controller() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+
+ private:
+  tabs::TestVerticalTabStripStateControllerDelegate delegate_;
+};
+
+// P20-1c, toolbar T57, T10: beside the camera the row always shows, so
+// Shift-Cmd-D there has nothing to override. Each press stored "hidden"
+// with nothing changing on screen, and leaving that full screen hid the row
+// in the ordinary window, its sidebar open, with no address field left.
+TEST_F(AddressRowW2B18Test, ShiftCmdDBesideTheCameraLeavesNothingBehind) {
+  tabs::VerticalTabStripStateController* const state = controller();
+  ASSERT_TRUE(state);
+  AddressRow* const row = AddressRow::From(browser());
+  ASSERT_TRUE(row);
+  ASSERT_FALSE(state->IsCollapsed());
+  ASSERT_FALSE(
+      profile()->GetPrefs()->GetBoolean(prefs::kSidebarAddressInSidebar));
+  ASSERT_TRUE(row->IsVisible()) << "the open sidebar's window has the row";
+
+  row->SetCameraRow(AddressRow::CameraRow{
+      .height = 32, .housing_left = 600, .housing_right = 800});
+  ASSERT_TRUE(row->camera_row().has_value());
+  row->Toggle();
+  EXPECT_TRUE(row->IsVisible()) << "T57: beside the camera the row shows";
+  EXPECT_FALSE(row->override_for_testing().has_value())
+      << "a press beside the camera stored an answer";
+
+  row->SetCameraRow(std::nullopt);
+  EXPECT_TRUE(row->IsVisible())
+      << "leaving the row beside the camera hid the window's row";
+  EXPECT_FALSE(row->override_for_testing().has_value());
+
+  // Shift-Cmd-D in the window works as before (T10).
+  row->Toggle();
+  EXPECT_FALSE(row->IsVisible());
+}
+
+}  // namespace
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/audit_w2_b20_unittest.cc b/chrome/browser/ui/stedding/audit_w2_b20_unittest.cc
