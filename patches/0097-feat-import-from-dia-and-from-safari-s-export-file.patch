+std::vector<ChromiumProfile> ListChromiumProfiles(
+    const base::FilePath& user_data_dir) {
+  std::vector<ChromiumProfile> profiles;
+  std::string json;
+  const base::FilePath local_state =
+      user_data_dir.Append(FILE_PATH_LITERAL("Local State"));
+  const std::optional<int64_t> size = base::GetFileSize(local_state);
+  std::optional<base::DictValue> state;
+  if (size && *size <= kMaxLocalStateBytes &&
+      base::ReadFileToString(local_state, &json)) {
+    state = base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  }
+  const std::string* const last_used =
+      state ? state->FindStringByDottedPath("profile.last_used") : nullptr;
+  const base::DictValue* const cache =
+      state ? state->FindDictByDottedPath("profile.info_cache") : nullptr;
+  if (cache) {
+    for (const auto [key, value] : *cache) {
+      const base::FilePath dir = base::FilePath::FromUTF8Unsafe(key);
+      // Only a folder inside User Data: Local State is another program's
+      // file.
+      if (dir.empty() || dir.ReferencesParent() || dir.BaseName() != dir ||
+          key == "." ||
+          !base::DirectoryExists(user_data_dir.Append(dir))) {
+        continue;
+      }
+      ChromiumProfile profile;
+      profile.dir = dir;
+      const base::DictValue* const entry = value.GetIfDict();
+      const std::string* const name =
+          entry ? entry->FindString("name") : nullptr;
+      profile.name = base::UTF8ToUTF16(name ? *name : key);
+      profile.last_used = last_used && *last_used == key;
+      profiles.push_back(std::move(profile));
+    }
+  }
+  if (profiles.empty() && base::DirectoryExists(user_data_dir.Append(
+                              FILE_PATH_LITERAL("Default")))) {
+    ChromiumProfile profile;
+    profile.dir = base::FilePath(FILE_PATH_LITERAL("Default"));
+    profile.name = u"Default";
+    profile.last_used = true;
+    profiles.push_back(std::move(profile));
+  }
+  std::ranges::stable_sort(profiles, [](const ChromiumProfile& a,
+                                        const ChromiumProfile& b) {
+    return a.last_used && !b.last_used;
+  });
+  return profiles;
+}
