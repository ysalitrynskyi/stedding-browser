+// Z5, Z16: the block has a row for every command a shipped table binds,
+// grouped, each named as the catalog names it; the switch turns a row off and
+// Reset puts it back.
+IN_PROC_BROWSER_TEST_F(ShortcutSettingsTest, TheBlockEditsEveryRow) {
+  content::WebContents* const page = OpenSettings();
+  const std::string names = Eval(page, R"(
+    return [...editor.shadowRoot.querySelectorAll('.shortcut-row')]
+        .map(row => row.dataset.name).join(',');)");
+  size_t shown = 0;
+  for (const shortcuts::Entry& entry : shortcuts::Catalog()) {
+    if ((entry.flags & shortcuts::kHidden) ||
+        shortcuts::DefaultChordsFor(entry.command).empty()) {
+      continue;
+    }
+    ++shown;
+    EXPECT_NE(std::string::npos, (',' + names + ',').find(
+                                     std::string(",") + entry.name + ","))
+        << entry.name << " has no row";
+  }
+  EXPECT_GT(shown, 50u);
+
+  ASSERT_EQ("clicked", Eval(page, R"(
+    rows('clear-space').querySelector('cr-toggle.row-switch').click();
+    return 'clicked';)"));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return Eval(page, "return String(rows('clear-space').classList.contains("
+                      "'off'));") == "true";
+  }));
+  EXPECT_TRUE(shortcuts::IsOff(IDC_STEDDING_CLEAR_SPACE));
+  ASSERT_EQ("clicked", Eval(page, R"(
+    rows('clear-space').querySelector('cr-button.reset-button').click();
+    return 'clicked';)"));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return Eval(page, "return String(rows('clear-space').classList.contains("
+                      "'off'));") == "false";
+  }));
+  EXPECT_FALSE(shortcuts::IsOff(IDC_STEDDING_CLEAR_SPACE));
+  // A fixed row has no recorder and no switch.
+  EXPECT_EQ("0", Eval(page, R"(
+    return String(rows('close-window').querySelectorAll(
+        'cr-button.add-button, cr-toggle').length);)"));
+}
