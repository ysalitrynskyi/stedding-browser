+void TabStripModel::MoveTabsOutOfFolder(tabs::FolderTabCollection* folder) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  if (!folder || folder->TabCountRecursive() == 0) {
+    return;
+  }
+  std::vector<int> indices;
+  for (tabs::TabInterface* const tab : folder->GetTabsRecursive()) {
+    const int index = GetIndexOfTab(tab);
+    if (index != kNoTab) {
+      indices.push_back(index);
+    }
+  }
+  std::ranges::sort(indices);
+  // A plain move lands the tabs in the unpinned area at the folder's place;
+  // the folder, emptied, is peeled out of the tree.
+  MoveTabsToIndexImpl(indices, indices.front(), std::nullopt);
+}
