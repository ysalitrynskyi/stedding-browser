+
+void SidebarWindowButtons::SetRevealed(bool revealed) {
+  revealed_ = revealed;
+  // The place stays the same size either way (CalculatePreferredSize), so
+  // nothing on the row moves when they show.
+  for (views::View* const button : children()) {
+    button->SetVisible(revealed);
+  }
+}
+
+gfx::Size SidebarWindowButtons::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  // As wide as the three buttons whether or not they show.
+  int width = 0;
+  int height = 0;
+  for (const views::View* const button : children()) {
+    const gfx::Size size = button->GetPreferredSize();
+    width += size.width();
+    height = std::max(height, size.height());
+  }
+  const int gaps = std::max(0, static_cast<int>(children().size()) - 1);
+  return gfx::Size(width + kNavButtonGap * gaps, height);
+}
+
+void SidebarWindowButtons::AddedToWidget() {
+  views::View::AddedToWidget();
+  observed_widget_ = GetWidget();
+  observed_widget_->AddObserver(this);
+  UpdateMaximize();
+}
+
+void SidebarWindowButtons::RemovedFromWidget() {
+  if (observed_widget_) {
+    observed_widget_->RemoveObserver(this);
+    observed_widget_ = nullptr;
+  }
+  views::View::RemovedFromWidget();
+}
+
+void SidebarWindowButtons::OnWidgetBoundsChanged(views::Widget* widget,
+                                                 const gfx::Rect& new_bounds) {
+  UpdateMaximize();
+}
+
+void SidebarWindowButtons::OnWidgetDestroying(views::Widget* widget) {
+  widget->RemoveObserver(this);
+  observed_widget_ = nullptr;
+}
+
+void SidebarWindowButtons::UpdateMaximize() {
+  // The window's buttons are on the sidebar only on Windows (Y48), where
+  // Restore is a command of its own.
+#if BUILDFLAG(IS_WIN)
+  const bool maximized = GetWidget() && GetWidget()->IsMaximized();
+  constexpr int kRestore = IDC_RESTORE_WINDOW;
+#else
+  const bool maximized = false;
+  constexpr int kRestore = IDC_MAXIMIZE_WINDOW;
+#endif
+  maximize_->SetCommand(
+      maximized ? kRestore : IDC_MAXIMIZE_WINDOW,
+      maximized ? views::kChromeRestoreIcon : views::kChromeMaximizeIcon,
+      l10n_util::GetStringUTF16(maximized ? IDS_APP_ACCNAME_RESTORE
+                                          : IDS_APP_ACCNAME_MAXIMIZE),
+      l10n_util::GetStringUTF16(maximized ? IDS_APP_ACCNAME_RESTORE
+                                          : IDS_APP_ACCNAME_MAXIMIZE));
+}
