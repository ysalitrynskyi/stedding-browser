+  web_ui()->RegisterMessageCallback(
+      "openShortcuts", base::BindRepeating(&WelcomeHandler::HandleOpenShortcuts,
+                                           base::Unretained(this)));
+}
+
+void WelcomeHandler::HandleGetSpaceColors(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  base::ListValue list;
+  for (const spaces::SpaceColorChoice& choice : spaces::kSpaceColors) {
+    base::DictValue entry;
+    entry.Set("name", std::u16string(choice.name));
+    entry.Set("color", base::StringPrintf("#%02X%02X%02X",
+                                          SkColorGetR(choice.color),
+                                          SkColorGetG(choice.color),
+                                          SkColorGetB(choice.color)));
+    list.Append(std::move(entry));
+  }
+  ResolveJavascriptCallback(args[0], list);
+}
+
+void WelcomeHandler::HandleSetSpaceColor(const base::ListValue& args) {
+  CHECK_EQ(1U, args.size());
+  AllowJavascript();
+  const std::optional<int> index = args[0].GetIfInt();
+  if (!index || *index < 0 ||
+      static_cast<size_t>(*index) >= spaces::kSpaceColors.size()) {
+    return;
+  }
+  const WelcomeHost* const host =
+      WelcomeHost::FromWebContents(web_ui()->GetWebContents());
+  spaces::SpaceModel* const model =
+      host ? spaces::SpaceModel::From(host->browser()) : nullptr;
+  if (!model) {
+    return;
+  }
+  model->SetSpaceColor(model->active_id(),
+                       spaces::kSpaceColors.at(*index).color);
+}
+
+void WelcomeHandler::HandleOpenShortcuts(const base::ListValue& args) {
+  AllowJavascript();
+  const WelcomeHost* const host =
+      WelcomeHost::FromWebContents(web_ui()->GetWebContents());
+  BrowserWindowInterface* const browser = host ? host->browser() : nullptr;
+  if (!browser) {
+    return;
+  }
+  browser->OpenGURL(GURL("chrome://settings/stedding"),
+                    WindowOpenDisposition::NEW_FOREGROUND_TAB);
 }
 
