 // otherwise.
 int SwitcherChipWidth(bool overflow, bool active, bool row_hovered);
 
+// sidebar Y13: stacked in the rail, one chip wide, the rule is the count,
+// not a width -- full chips while the stack is short, dots past
+// kSwitcherStackFullChips Spaces, the "+" always full -- and the stack is
+// as tall as what it holds, dots and all, so the "+" never lands past the
+// window's bottom (operator, 2026-09-09).
+inline constexpr size_t kSwitcherStackFullChips = 4;
+inline constexpr int kSwitcherStackPad = 8;
+bool SwitcherStackOverflows(size_t chip_count);
+// The stack's height for chips of `chip_widths` (kSwitcherChip or
+// kSwitcherDot each) and the "+", every one with the gap around it.
+int SwitcherStackHeight(const std::vector<int>& chip_widths);
+
