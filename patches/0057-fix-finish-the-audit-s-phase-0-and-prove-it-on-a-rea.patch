+// A folder path in the session's encoding (FolderPathForTab), outermost
+// first.
+std::vector<FolderStep> ParseFolderPath(const std::string& path) {
+  std::vector<FolderStep> steps;
+  if (path.empty()) {
+    return steps;
+  }
+  const std::optional<base::Value> parsed =
+      base::JSONReader::Read(path, base::JSON_PARSE_RFC);
+  if (!parsed || !parsed->is_list()) {
+    return steps;
+  }
+  for (const base::Value& item : parsed->GetList()) {
+    const base::DictValue* const folder = item.GetIfDict();
+    const std::string* const id = folder ? folder->FindString("i") : nullptr;
+    if (!id) {
+      continue;
+    }
+    const std::string* const title = folder->FindString("t");
+    steps.push_back({*id, title ? *title : std::string()});
+  }
+  return steps;
+}
