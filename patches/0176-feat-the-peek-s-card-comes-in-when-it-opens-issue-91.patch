+void PeekOverlay::AnimationProgressed(const gfx::Animation* animation) {
+  opacity_ = static_cast<float>(gfx::Tween::CalculateValue(
+      gfx::Tween::EASE_OUT, animation->GetCurrentValue()));
+  if (widget_) {
+    widget_->SetOpacity(opacity_);
+  }
+}
+
+void PeekOverlay::AnimationEnded(const gfx::Animation* animation) {
+  opacity_ = 1.0f;
+  if (widget_) {
+    widget_->SetOpacity(opacity_);
+  }
+}
