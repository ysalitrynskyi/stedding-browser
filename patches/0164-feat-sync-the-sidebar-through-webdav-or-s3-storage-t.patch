+// folder, so the merge, the file code and the ledger are the folder's.
+//
+// Pull() lists the place and downloads the files whose version changed; a
+// file the list shows unchanged is not downloaded (Sf51). Push() writes this
+// install's file. One request sequence at a time, in order, so a list never
+// overtakes the write before it. The mirror changes only by whole files:
+// a failed read leaves the file before it, and a list, short or failed,
+// removes no other computer's file (Sf19, Sf52).
+class PlaceBridge {
+ public:
+  using Done = base::OnceCallback<void(PlaceFailure)>;
+
+  PlaceBridge(Place place,
+              scoped_refptr<network::SharedURLLoaderFactory> factory,
+              base::Clock* clock,
+              const base::FilePath& profile_path,
+              scoped_refptr<base::SequencedTaskRunner> file_runner);
+  PlaceBridge(const PlaceBridge&) = delete;
+  PlaceBridge& operator=(const PlaceBridge&) = delete;
+  ~PlaceBridge();
+
+  // Where a profile keeps its mirror's folder, and the folder itself, which is
+  // named as the service expects (Sf8).
+  static base::FilePath RootFor(const base::FilePath& profile_path);
+  static base::FilePath MirrorFor(const base::FilePath& profile_path);
+  // Blocking: empties the mirror; with `make`, leaves an empty one.
+  static bool ResetMirror(const base::FilePath& profile_path, bool make);
+
+  const Place& place() const { return place_; }
+  bool sign_in_set() const { return sign_in_set_; }
+
+  // Requests wait for the first call. Nullopt: the sign-in could not be read
+  // on this computer (Sf55), so every request answers kSignIn. A later call
+  // takes effect after what is already asked of the place.
+  void SetSignIn(std::optional<PlaceSignIn> sign_in);
+
+  void Pull(const std::string& own_install, Done done);
+  void Push(const std::string& name, std::string json, Done done);
+  void RemoveOwn(const std::string& name, Done done);
+
+ private:
+  struct PullRun;
+
+  void Enqueue(base::OnceClosure step);
+  void RunNext();
+  void OpFinished();
+
+  void ApplySignIn(std::optional<PlaceSignIn> sign_in);
+  void StartPull(std::string own_install, Done done);
+  void OnVersionsRead(std::map<std::string, std::string> versions);
+  void ListForPull();
+  void OnListed(PlaceFailure failure, PlaceList list);
+  void FetchNext();
+  void OnFetched(std::string name,
+                 std::string version,
+                 PlaceFailure failure,
+                 std::string body);
+  void ApplyPull();
+  void OnPullApplied(bool ok);
+  void StartPush(std::string name, std::string json, Done done);
+  void OnPushed(std::string name,
+                Done done,
+                PlaceFailure failure,
+                std::string version);
+  void StartRemove(std::string name, Done done);
+  void OnRemoved(Done done, PlaceFailure failure);
+  void SaveVersions();
+
+  const Place place_;
+  const scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  const raw_ptr<base::Clock> clock_;
+  const base::FilePath profile_path_;
+  const scoped_refptr<base::SequencedTaskRunner> file_runner_;
+
+  // Sf51: the version each name in the mirror came from.
+  std::map<std::string, std::string> versions_;
+  bool versions_read_ = false;
+
+  std::unique_ptr<PlaceClient> client_;
+  bool sign_in_set_ = false;
+  bool busy_ = false;
+  int pushes_waiting_ = 0;
+  std::deque<base::OnceClosure> queue_;
+  std::unique_ptr<PullRun> pull_;
+  base::WeakPtrFactory<PlaceBridge> weak_factory_{this};
+};
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_BRIDGE_H_
