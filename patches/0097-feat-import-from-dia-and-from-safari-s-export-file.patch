+// One import of a profile, held by the profile's ImportJobs.
+class ChromiumFamilyImport : public stedding::ImportJob {
+ public:
+  ChromiumFamilyImport(Profile& profile,
+                       const ChromiumFamilySource& source,
+                       ChromiumProfile source_profile,
+                       ChromiumFamilyParts parts,
+                       base::OnceCallback<void(ChromiumFamilyResult)> done)
+      : profile_(profile.GetWeakPtr()),
+        source_(source),
+        source_profile_(std::move(source_profile)),
+        parts_(parts),
+        done_(std::move(done)) {
+    result_.name = source_.name;
+  }
+  ChromiumFamilyImport(const ChromiumFamilyImport&) = delete;
+  ChromiumFamilyImport& operator=(const ChromiumFamilyImport&) = delete;
+  ~ChromiumFamilyImport() override = default;
+
+  void Start(Profile& profile) {
+    // I40: a part a policy turns off is not read at all.
+    const stedding::ImportsAllowed allowed =
+        stedding::AllowedImports(*profile.GetPrefs());
+    result_.bookmarks_blocked = parts_.bookmarks && !allowed.bookmarks;
+    result_.history_blocked = parts_.history && !allowed.history;
+    result_.passwords_blocked = parts_.passwords && !allowed.passwords;
+    parts_.bookmarks = parts_.bookmarks && allowed.bookmarks;
+    parts_.history = parts_.history && allowed.history;
+    parts_.passwords = parts_.passwords && allowed.passwords;
+    result_.passwords_asked = parts_.passwords;
+    base::ThreadPool::PostTaskAndReplyWithResult(
+        FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+        base::BindOnce(&ReadOnPool, source_, source_profile_.dir, parts_,
+                       base::Time::Now()),
+        base::BindOnce(&ChromiumFamilyImport::OnRead,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void OnRead(FamilyRead read) {
+    read_ = std::move(read);
+    if (read_.not_found) {
+      result_.not_found = true;
+      pending_ = 1;
+      PartDone();
+      return;
+    }
+    result_.bookmarks_left_out = read_.bookmarks.left_out;
+    result_.bookmarks_unreadable = read_.bookmarks.unreadable;
+    result_.key_denied = read_.key_denied;
+    result_.passwords_bound = read_.left_out.bound_to_its_browser;
+    result_.passwords_unreadable = read_.left_out.unreadable;
+    result_.passwords_past_the_cap = read_.left_out.past_the_cap;
+    const bool bookmarks = !read_.bookmarks.entries.empty();
+    const bool history = !read_.history.empty();
+    const bool passwords = !read_.passwords.empty();
+    pending_ = 1 + bookmarks + history + passwords;
+    bookmarks::BookmarkModel* const model =
+        bookmarks && profile_
+            ? BookmarkModelFactory::GetForBrowserContext(profile_.get())
+            : nullptr;
+    if (model) {
+      bookmarks_waiter_ = std::make_unique<stedding::BookmarksLoadedWaiter>(
+          model, base::BindOnce(&ChromiumFamilyImport::WriteBookmarks,
+                                weak_factory_.GetWeakPtr()));
+    } else if (bookmarks) {
+      PartDone();
+    }
+    if (history) {
+      history::HistoryService* const service =
+          profile_ ? HistoryServiceFactory::GetForProfile(
+                         profile_.get(), ServiceAccessType::EXPLICIT_ACCESS)
+                   : nullptr;
+      if (service) {
+        // I30, I40: the visits the profile does not have yet, as browsed
+        // history, as Arc's (I22).
+        stedding::AddNewVisits(
+            *service, std::move(read_.history), history::SOURCE_BROWSED,
+            history_tracker_,
+            base::BindOnce(&ChromiumFamilyImport::OnHistoryAdded,
+                           weak_factory_.GetWeakPtr()));
+      } else {
+        PartDone();
+      }
+    }
+    if (passwords && profile_) {
+      passwords_writer_ =
+          std::make_unique<stedding::ImportedPasswordsWriter>(*profile_);
+      passwords_writer_->Write(
+          std::move(read_.passwords),
+          base::BindOnce(&ChromiumFamilyImport::OnPasswordsWritten,
+                         weak_factory_.GetWeakPtr()));
+    } else if (passwords) {
+      PartDone();
+    }
+    PartDone();
+  }
+
+  void WriteBookmarks() {
+    bookmarks::BookmarkModel* const model =
+        profile_ ? BookmarkModelFactory::GetForBrowserContext(profile_.get())
+                 : nullptr;
+    if (model) {
+      const std::string key =
+          std::string(source_.key) + ":" +
+          source_profile_.dir.BaseName().AsUTF8Unsafe();
+      const stedding::BookmarkMergeResult merged =
+          stedding::MergeImportedBookmarks(
+              *model, *profile_->GetPrefs(), key,
+              FolderTitle(source_, source_profile_), u"Bookmarks bar",
+              read_.bookmarks.entries);
+      result_.bookmarks = merged.added;
+      result_.bookmarks_already = merged.already_there;
+    }
+    PartDone();
+  }
+
+  void OnHistoryAdded(size_t added) {
+    result_.history = added;
+    PartDone();
+  }
+
+  void OnPasswordsWritten(stedding::PasswordWriteResult written) {
+    result_.passwords = written;
+    PartDone();
+  }
+
+  void PartDone() {
+    if (--pending_ > 0) {
+      return;
+    }
+    auto done = std::move(done_);
+    const ChromiumFamilyResult result = result_;
+    if (profile_) {
+      stedding::ImportJobs::For(*profile_).Finish(source_.key);
+    }
+    if (done) {
+      std::move(done).Run(result);
+    }
+  }
+
+  base::WeakPtr<Profile> profile_;
+  const ChromiumFamilySource source_;
+  const ChromiumProfile source_profile_;
+  ChromiumFamilyParts parts_;
+  base::OnceCallback<void(ChromiumFamilyResult)> done_;
+  ChromiumFamilyResult result_;
+  FamilyRead read_;
+  int pending_ = 0;
+  std::unique_ptr<stedding::BookmarksLoadedWaiter> bookmarks_waiter_;
+  std::unique_ptr<stedding::ImportedPasswordsWriter> passwords_writer_;
+  base::CancelableTaskTracker history_tracker_;
+  base::WeakPtrFactory<ChromiumFamilyImport> weak_factory_{this};
+};
