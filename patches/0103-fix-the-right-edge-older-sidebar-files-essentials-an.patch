+// Sf2: a file Stedding wrote before its tabs kept a token names each tab by
+// the session's number, new at every launch. Imported twice, it adds its tabs
+// once: the second import finds them remembered, as an Arc file's are.
+TEST_F(SidebarBackupTest, AnOlderFileAddsItsTabsOnce) {
+  Open("https://older-a.example/");
+  Open("https://older-b.example/");
+  ArcImportPlan plan = SnapshotSpace(browser(), model().active_id());
+  ASSERT_EQ(1u, plan.spaces.size());
+  int number = 40;
+  for (Node& node : plan.spaces[0].unpinned) {
+    if (node.kind == Node::Kind::kTab) {
+      node.arc_id = "tab:" + base::NumberToString(++number);
+    }
+  }
+  const std::optional<ArcImportPlan> older = ParseArcSidebar(PlanToJson(plan));
+  ASSERT_TRUE(older.has_value());
+  ASSERT_TRUE(older->written_by_stedding);
+  const ArcImportResult first =
+      ApplyArcImport(browser(), *older, ArcImportOptions());
+  EXPECT_EQ(2u, first.tabs) << "no open tab has a launch's number";
+  EXPECT_EQ(0u, first.spaces) << "the Space is its own, by id";
+  const int after_first = tabs().count();
+  const ArcImportResult second =
+      ApplyArcImport(browser(), *older, ArcImportOptions());
+  EXPECT_EQ(0u, second.tabs) << "the same older file added its tabs again";
+  EXPECT_EQ(after_first, tabs().count());
+}
