+namespace {
+
+// The host, a leading "www." aside while it is a label of the site's own.
+// What follows "www." in www.com or www.github.io is a registry itself (com,
+// and github.io, under which each name is a site of its own): there it is
+// part of the site, and a redirect from www.com to com went to another site
+// and was taken as the home (H1).
+std::string_view HostWithoutWww(const GURL& url) {
+  std::string_view host = url.host();
+  if (base::StartsWith(host, "www.") &&
+      !net::registry_controlled_domains::HostIsRegistryIdentifier(
+          host.substr(4),
+          net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES)) {
+    host.remove_prefix(4);
+  }
+  return host;
+}
+
+// "/inbox/" and "/inbox" are one page, as the drift mark reads them (H4).
+std::string_view PathWithoutTrailingSlash(const GURL& url) {
+  std::string_view path = url.path();
+  if (path.size() > 1 && path.back() == '/') {
+    path.remove_suffix(1);
+  }
+  return path;
+}
+
+}  // namespace
+
+std::optional<GURL> HomeAfterFirstCommit(
+    const GURL& home,
+    const std::vector<GURL>& redirect_chain,
+    const GURL& committed) {
+  // Only a web page is a home (H13), and only a page the home itself was
+  // sent on to: a first commit the person navigated to before it arrived is
+  // not a redirect.
+  if (!IsAllowedPinHome(home) || !IsAllowedPinHome(committed) ||
+      committed == home || redirect_chain.empty() ||
+      redirect_chain.front() != home) {
+    return std::nullopt;
+  }
+  if (HostWithoutWww(home) != HostWithoutWww(committed)) {
+    return std::nullopt;
+  }
+  const std::string_view from = PathWithoutTrailingSlash(home);
+  if (from != "/" && from != PathWithoutTrailingSlash(committed)) {
+    return std::nullopt;
+  }
+  return committed;
+}
+
 }  // namespace stedding
