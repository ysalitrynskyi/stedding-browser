+// folders F47: a folder of a pin and a loose tab is no pinned folder, and each
+// keeps what it is. Pinning the folder's way would have unpinned the pin.
+TEST_F(FolderCommandsTest, MoveFolderToSpaceKeepsAPinAmongLooseTabs) {
+  tabs::TabInterface* const b = OpenTab(GURL("https://b.test/"));
+  tabs::TabInterface* const a = OpenTab(GURL("https://a.test/"));
+  OpenTab(GURL("https://other.test/"));
+  const SpaceId work = model().AddSpace("Work", kBlue)->id();
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(
+      {tabs().GetIndexOfTab(a), tabs().GetIndexOfTab(b)});
+  ASSERT_TRUE(folder);
+  model().SetSpacePinnedInPlace(a, true);
+  ASSERT_FALSE(model().IsFolderSpacePinned(folder));
+
+  model().MoveFolderToSpace(folder, work);
+
+  EXPECT_TRUE(model().IsSpacePinned(a)) << "the pin was unpinned";
+  EXPECT_FALSE(model().IsSpacePinned(b));
+  EXPECT_EQ(work, model().SpaceForTab(a));
+  EXPECT_EQ(work, model().SpaceForTab(b));
+}
