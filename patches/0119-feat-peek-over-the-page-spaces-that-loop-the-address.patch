+namespace {
+
+// How many browser windows are open: a peek over the page makes none.
+int WindowCount() {
+  int windows = 0;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface*) {
+        ++windows;
+        return true;
+      });
+  return windows;
+}
+
+class PeekOverPageTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+    prefs->SetBoolean(stedding::prefs::kPeekEnabled, true);
+    EXPECT_EQ(stedding::prefs::kPeekStyleOverPage,
+              prefs->GetInteger(stedding::prefs::kPeekStyle))
+        << "a peek shows over the page in a fresh profile";
+  }
+
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  content::WebContents* contents() { return tabs().GetActiveWebContents(); }
+  tabs::TabInterface* tab() { return tabs().GetActiveTab(); }
+  GURL Url(const std::string& host, const std::string& path) {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  // The pinned page at a.test, in a tab of its own, with one link, to `to`;
+  // an essential, or with `in_space` pinned in its Space.
+  void OpenPin(const GURL& to, bool in_space = false) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url("a.test", "/title1.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    ASSERT_TRUE(content::ExecJs(
+        contents(),
+        base::StringPrintf(
+            "const a = document.createElement('a');"
+            "a.id = 'link'; a.href = '%s';"
+            "a.textContent = 'the link';"
+            "a.style = 'display:block;font-size:40px;padding:20px';"
+            "document.body.prepend(a);",
+            to.spec().c_str()),
+        content::EXECUTE_SCRIPT_NO_USER_GESTURE));
+    if (in_space) {
+      spaces::SpaceModel::From(browser())->SetSpacePinned(tab(), true);
+    } else {
+      tabs().SetTabPinned(tabs().active_index(), true);
+    }
+  }
+
+  // The user's click on the pinned page's link, with the user's activation.
+  void ClickLink() {
+    EXPECT_TRUE(content::ExecJs(contents(),
+                                "document.getElementById('link').click();"));
+  }
+
+  // The peek over `pin`'s page, once its page has loaded.
+  stedding::PeekOverlay* WaitForPeek(tabs::TabInterface* pin) {
+    if (!base::test::RunUntil(
+            [&]() { return stedding::PeekOverlay::ForSource(pin); })) {
+      ADD_FAILURE() << "no peek over the page; " << WindowCount()
+                    << " windows, the pin at "
+                    << pin->GetContents()->GetLastCommittedURL();
+      return nullptr;
+    }
+    stedding::PeekOverlay* const peek = stedding::PeekOverlay::ForSource(pin);
+    return content::WaitForLoadStop(peek->page()) ? peek : nullptr;
+  }
+
+  // Whether the peek over `pin` has gone, and the pin takes input again.
+  bool WaitForNoPeek(tabs::TabInterface* pin) {
+    return base::test::RunUntil([&]() {
+      return !stedding::PeekOverlay::ForSource(pin) && !pin->IsBlocked();
+    });
+  }
+
+  static void Press(views::Button* button) {
+    const gfx::Point centre = button->GetLocalBounds().CenterPoint();
+    views::test::ButtonTestApi(button).NotifyClick(ui::MouseEvent(
+        ui::EventType::kMousePressed, centre, centre, base::TimeTicks::Now(),
+        ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON));
+  }
+};
+
+// P20, P11, P12, P17: the link opens over the pinned tab's page, inside its
+// window -- no window of its own -- loaded as the page's link. The pinned
+// page stays where it was, dimmed by the window's scrim, and takes no
+// input; the peek's card sits inside the page with a margin all round, its
+// bar holding Open as Tab and Close (an essential takes no split).
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, ALinkPeeksOverThePageInsideTheWindow) {
+  const GURL to = Url("b.test", "/title3.html");
+  ASSERT_NO_FATAL_FAILURE(OpenPin(to));
+  tabs::TabInterface* const pin = tab();
+  const int count = tabs().count();
+  const int windows = WindowCount();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+
+  EXPECT_EQ(windows, WindowCount()) << "the peek opened a window";
+  EXPECT_FALSE(stedding::PeekOver(browser())) << "a small window";
+  EXPECT_EQ(count, tabs().count());
+  EXPECT_EQ(pin, tab());
+  EXPECT_EQ(Url("a.test", "/title1.html"), contents()->GetLastCommittedURL());
+  EXPECT_EQ(to, peek->page()->GetLastCommittedURL());
+  EXPECT_FALSE(tabs::TabInterface::MaybeGetFromContents(peek->page()))
+      << "the page is no tab while it peeks";
+  EXPECT_EQ(pin, stedding::PeekOverPageSourceOf(peek->page()));
+  EXPECT_EQ(peek->page(), stedding::PeekOverPageOfActiveTab(browser()));
+  EXPECT_TRUE(pin->IsBlocked()) << "the pinned page takes input under it";
+
+  views::Widget* const widget = peek->widget();
+  ASSERT_TRUE(widget);
+  EXPECT_TRUE(widget->IsVisible());
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  const gfx::Rect page_area =
+      browser_view->GetContentsContainerViewFor(pin->GetContents())
+          ->GetBoundsInScreen();
+  EXPECT_EQ(page_area, widget->GetWindowBoundsInScreen())
+      << "the peek is not over its tab's page";
+  stedding::PeekOverlayView* const view = peek->view();
+  ASSERT_TRUE(view);
+  const gfx::Rect card = view->card()->GetBoundsInScreen();
+  EXPECT_TRUE(page_area.Contains(card));
+  EXPECT_GT(card.x(), page_area.x()) << "no margin beside the card";
+  EXPECT_GT(card.y(), page_area.y()) << "no margin above the card";
+  EXPECT_GT(page_area.bottom(), card.bottom());
+  EXPECT_GT(view->web_view()->height(), 0);
+  EXPECT_TRUE(view->open_as_tab_button()->GetVisible());
+  EXPECT_TRUE(view->close_button()->GetVisible());
+  EXPECT_FALSE(view->split_button()->GetVisible())
+      << "an essential takes no split";
+  EXPECT_EQ(u"b.test", view->site()->GetText());
+  ASSERT_TRUE(peek->page()->GetRenderWidgetHostView());
+  EXPECT_GT(
+      peek->page()->GetRenderWidgetHostView()->GetViewBounds().height(), 0)
+      << "the page is laid out 0 px tall";
+
+  // P20: its page menu starts with Open as Tab, and no split for an
+  // essential.
+  {
+    content::ContextMenuParams params;
+    params.page_url = to;
+    params.frame_url = to;
+    auto menu = std::make_unique<TestRenderViewContextMenu>(
+        *peek->page()->GetPrimaryMainFrame(), params);
+    menu->Init();
+    EXPECT_TRUE(menu->IsItemPresent(IDC_STEDDING_LITTLE_PROMOTE));
+    EXPECT_TRUE(menu->IsCommandIdEnabled(IDC_STEDDING_LITTLE_PROMOTE));
+    EXPECT_FALSE(menu->IsItemPresent(IDC_STEDDING_LITTLE_PROMOTE_SPLIT));
+  }
+}
+
+// P20: the close button, Escape, Cmd-W on the window, and a click on the page
+// beside the card each close the peek; the pinned tab stays, awake, and
+// takes input again.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, EachCloseLeavesThePinAsItWas) {
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  const int count = tabs().count();
+
+  {
+    SCOPED_TRACE("the close button");
+    ClickLink();
+    stedding::PeekOverlay* const peek = WaitForPeek(pin);
+    ASSERT_TRUE(peek);
+    Press(peek->view()->close_button());
+    EXPECT_TRUE(WaitForNoPeek(pin));
+  }
+  {
+    SCOPED_TRACE("Escape, which the page does not take");
+    ClickLink();
+    stedding::PeekOverlay* const peek = WaitForPeek(pin);
+    ASSERT_TRUE(peek);
+    // As the page hands back a key it did not take: a synthetic key sent to
+    // a page in a widget that is not the active window, beside other
+    // tests' windows, never reached it.
+    input::NativeWebKeyboardEvent escape(
+        blink::WebInputEvent::Type::kRawKeyDown,
+        blink::WebInputEvent::kNoModifiers, base::TimeTicks::Now());
+    escape.windows_key_code = ui::VKEY_ESCAPE;
+    escape.dom_key = ui::DomKey::ESCAPE;
+    escape.dom_code = static_cast<int>(ui::DomCode::ESCAPE);
+    EXPECT_TRUE(peek->page()->GetDelegate()->HandleKeyboardEvent(peek->page(),
+                                                                escape));
+    EXPECT_TRUE(WaitForNoPeek(pin));
+  }
+  {
+    SCOPED_TRACE("Cmd-W on the window closes the peek, not the pin");
+    ClickLink();
+    ASSERT_TRUE(WaitForPeek(pin));
