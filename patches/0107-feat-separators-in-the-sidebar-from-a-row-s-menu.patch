+// sessions S13: clears the HTTP cache of the partition `config` names. `done`
+// runs once the clear has finished, with true, and also when the network
+// service's pipe drops first -- the service restarting -- which never runs
+// the clear's callback: Clear Independent Session waited for it and never
+// finished (BACKLOG S-345). A clear the drop cut short is asked once more, a
+// turn later, of the network context the partition makes in the lost one's
+// place; `done` has false when that one is dropped too, or there is no
+// network context to ask.
+void ClearHttpCacheOf(base::WeakPtr<Profile> profile,
+                      const content::StoragePartitionConfig& config,
+                      bool retry_if_dropped,
+                      base::OnceCallback<void(bool)> done) {
+  content::StoragePartition* const partition =
+      profile ? profile->GetStoragePartition(config) : nullptr;
+  network::mojom::NetworkContext* const network =
+      partition ? partition->GetNetworkContext() : nullptr;
+  if (!network) {
+    std::move(done).Run(false);
+    return;
+  }
+  base::OnceCallback<void(bool)> finished = base::BindOnce(
+      [](base::WeakPtr<Profile> profile,
+         const content::StoragePartitionConfig& config, bool retry_if_dropped,
+         base::OnceCallback<void(bool)> done, bool cleared) {
+        if (cleared || !retry_if_dropped) {
+          std::move(done).Run(cleared);
+          return;
+        }
+        base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE,
+            base::BindOnce(&ClearHttpCacheOf, std::move(profile), config,
+                           /*retry_if_dropped=*/false, std::move(done)));
+      },
+      profile, config, retry_if_dropped, std::move(done));
+  network->ClearHttpCache(
+      base::Time(), base::Time::Max(), /*filter=*/nullptr,
+      base::BindOnce(mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+                         std::move(finished), /*cleared=*/false),
+                     /*cleared=*/true));
+}
