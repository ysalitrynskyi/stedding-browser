index 0000000000000..ff9bf6b18b294
--- /dev/null
+++ b/chrome/browser/ui/stedding/pin_lifecycle.h
@@ -0,0 +1,54 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_PIN_LIFECYCLE_H_
+#define CHROME_BROWSER_UI_STEDDING_PIN_LIFECYCLE_H_
+
+#include <optional>
+
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class PrefService;
+
+namespace tabs {
+class TabInterface;
+}
+
+namespace stedding {
+
+// Arc's pinned-tab lifecycle (docs/features/pins.md).
+
+// H4: a pin has drifted when its origin or path differs from home; the query
+// and the fragment are the page's own business.
+bool HasDriftedFromHome(const GURL& home, const GURL& current);
+
+// What Cmd-W does with the selection (H3, H9, H11).
+enum class CloseAction {
+  // Close, as Chromium would: something selected is not pinned, or the
+  // setting is off.
+  kClose,
+  // Every selected tab is pinned (either tier) and awake: sleep them.
+  kSleep,
+  // Every selected tab is pinned and already asleep: nothing.
+  kNoOp,
+};
+CloseAction CloseActionFor(BrowserWindowInterface* browser,
+                           const PrefService* prefs);
+
+// Runs CloseActionFor: returns true when Cmd-W was taken care of here (a
+// sleep or a no-op), false when Chromium should close as usual. Sleeping the
+// active pin first activates the next visible row of its Space, or opens a
+// new tab there when the Space holds nothing else (H11).
+bool SleepInsteadOfClose(BrowserWindowInterface* browser);
+
+// H5, H6: the pin loads its home page again.
+void ResetToHome(BrowserWindowInterface* browser, tabs::TabInterface* tab);
+
+// H7: the site the peek compares against: the pin's home, else the page.
+GURL PinnedSiteFor(BrowserWindowInterface* browser, tabs::TabInterface* tab);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_PIN_LIFECYCLE_H_
