+#include "base/values.h"
+#include "chrome/browser/shell_integration.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+namespace stedding {
+
+// The welcome flow's browser-side half: search engines, appearance, default
+// browser, and the finish that records the flow as seen. Import goes through
+// Chromium's own ImportDataHandler, registered alongside.
+class WelcomeHandler : public content::WebUIMessageHandler {
+ public:
+  WelcomeHandler();
+  WelcomeHandler(const WelcomeHandler&) = delete;
+  WelcomeHandler& operator=(const WelcomeHandler&) = delete;
+  ~WelcomeHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+
+ private:
+  // getSearchEngines(callback) -> [{prepopulateId, name, iconPath, url}]
+  void HandleGetSearchEngines(const base::ListValue& args);
+  // setSearchEngine(prepopulateId)
+  void HandleSetSearchEngine(const base::ListValue& args);
+  // setAppearance(scheme: "system"|"light"|"dark")
+  void HandleSetAppearance(const base::ListValue& args);
+  // getDefaultBrowserState(callback) -> "default"|"not-default"|"unknown"
+  void HandleGetDefaultBrowserState(const base::ListValue& args);
+  // setDefaultBrowser()
+  void HandleSetDefaultBrowser(const base::ListValue& args);
+  // finish(): records the flow as seen and closes the dialog.
+  void HandleFinish(const base::ListValue& args);
+
+  void OnDefaultBrowserState(const std::string& callback_id,
+                             shell_integration::DefaultWebClientState state);
+
+  scoped_refptr<shell_integration::DefaultBrowserWorker> default_browser_worker_;
+  base::WeakPtrFactory<WelcomeHandler> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_WEBUI_STEDDING_WELCOME_STEDDING_WELCOME_HANDLER_H_
