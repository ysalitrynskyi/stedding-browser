+// Three extension actions, each counting its runs, for a test window, which
+// has no toolbar.
+class ExtensionRowsTest : public CommandBarViewTest {
+ protected:
+  void SetUp() override {
+    CommandBarViewTest::SetUp();
+    for (const char16_t* name : {u"Alpha", u"Beta", u"Gamma"}) {
+      ExtensionActionRow row;
+      row.id = base::UTF16ToUTF8(name);
+      row.name = name;
+      row.run = base::BindLambdaForTesting(
+          [this, name]() { runs_.push_back(std::u16string(name)); });
+      rows_.push_back(std::move(row));
+    }
+    rows_[1].chord = u"⌥⇧B";
+  }
+
+  // The bar the window's chord opens in `host`, or null.
+  CommandBarView* PressTheChord(views::View& host) {
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_RUN_EXTENSION);
+    return CommandBarView::GetOpenBar(&host);
+  }
+
+  std::vector<ExtensionActionRow> rows_;
+  std::vector<std::u16string> runs_;
+};
