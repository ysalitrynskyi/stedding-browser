@@ -0,0 +1,185 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/stedding_library/stedding_library_handler.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/test_web_ui.h"
+#include "content/public/test/web_contents_tester.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+class TestLibraryHandler : public LibraryHandler {
+ public:
+  using LibraryHandler::set_web_ui;
+};
+
+class SteddingLibraryHandlerTest : public BrowserWithTestWindowTest {
+ protected:
+  void SetUp() override {
+    BrowserWithTestWindowTest::SetUp();
+    contents_ = content::WebContentsTester::CreateTestWebContents(
+        profile(), /*instance=*/nullptr);
+    web_ui_.set_web_contents(contents_.get());
+    handler_ = std::make_unique<TestLibraryHandler>();
+    handler_->set_web_ui(&web_ui_);
+    handler_->RegisterMessages();
+  }
+
+  void TearDown() override {
+    handler_.reset();
+    contents_.reset();
+    BrowserWithTestWindowTest::TearDown();
+  }
+
+  content::TestWebUI web_ui_;
+  std::unique_ptr<content::WebContents> contents_;
+  std::unique_ptr<TestLibraryHandler> handler_;
+};
+
+// A message of the wrong shape from chrome://stedding-library is dropped,
+// and a verb on a download that is not there answers false: the page is a
+// renderer, and a CHECK on its arguments let a compromised one stop the
+// browser (BACKLOG S-188's rule, here from the start).
+TEST_F(SteddingLibraryHandlerTest, AMessageOfTheWrongShapeIsDropped) {
+  base::ListValue number;
+  number.Append(1);
+  web_ui_.HandleReceivedMessage("openUrl", number);
+  web_ui_.HandleReceivedMessage("copyFile", number);
+  web_ui_.HandleReceivedMessage("moveToTrash", number);
+  web_ui_.HandleReceivedMessage("rangeStart", number);
+  web_ui_.HandleReceivedMessage("openAsPage", number);
+  web_ui_.HandleReceivedMessage("closePanel", number);
+  base::ListValue unknown_range;
+  unknown_range.Append("cb");
+  unknown_range.Append("year");
+  web_ui_.HandleReceivedMessage("rangeStart", unknown_range);
+  // No window holds this page: nothing opens.
+  base::ListValue open;
+  open.Append("https://example.test/");
+  open.Append("current");
+  web_ui_.HandleReceivedMessage("openUrl", open);
+  EXPECT_TRUE(web_ui_.call_data().empty());
+
+  // Pn10, Pn11: no such download, so nothing is copied or moved.
+  for (const char* verb : {"copyFile", "moveToTrash"}) {
+    base::ListValue args;
+    args.Append("cb");
+    args.Append("424242");
+    web_ui_.HandleReceivedMessage(verb, args);
+    ASSERT_FALSE(web_ui_.call_data().empty()) << verb;
+    const content::TestWebUI::CallData& call = *web_ui_.call_data().back();
+    EXPECT_EQ("cr.webUIResponse", call.function_name()) << verb;
+    ASSERT_TRUE(call.arg3());
+    EXPECT_EQ(base::Value(false), *call.arg3()) << verb;
+  }
+}
+
+// Pn7 (BACKLOG S-347): the page may open only an address a history row can
+// hold. Any other is dropped, whatever the page sends: Navigate quits or
+// restarts the browser for chrome://quit and chrome://restart, and hands
+// chrome://crash and chrome://kill to the tab's renderer. A web page opens.
+TEST_F(SteddingLibraryHandlerTest, OnlyAnAddressHistoryHoldsOpens) {
+  webui::SetBrowserWindowInterface(contents_.get(), browser());
+  AddTab(browser(), GURL("https://example.test/"));
+  TabStripModel* const strip = browser()->tab_strip_model();
+  ASSERT_EQ(1, strip->count());
+  for (const char* refused :
+       {"chrome://version/", "chrome://stedding-library/",
+        "view-source:https://example.test/", "about:blank",
+        "javascript:alert(1)"}) {
+    SCOPED_TRACE(refused);
+    base::ListValue open;
+    open.Append(refused);
+    open.Append("background");
+    web_ui_.HandleReceivedMessage("openUrl", open);
+    EXPECT_EQ(1, strip->count()) << "opened an address history never holds";
+  }
+  base::ListValue row;
+  row.Append("https://row.test/");
+  row.Append("background");
+  web_ui_.HandleReceivedMessage("openUrl", row);
+  EXPECT_EQ(2, strip->count()) << "a history row did not open";
+}
+
+// Pn7 (BACKLOG S-347): a row clicked while the active tab is a pin opens in a
+// new tab beside the pin, where a link from the pin opens, and the pin keeps
+// its page. It had opened at the end of the strip, past the other pin and
+// the tab after them.
+TEST_F(SteddingLibraryHandlerTest, ARowOpensBesideTheActivePin) {
+  webui::SetBrowserWindowInterface(contents_.get(), browser());
+  // AddTab puts each tab first: the strip is a, b, c.
+  AddTab(browser(), GURL("https://c.test/"));
+  AddTab(browser(), GURL("https://b.test/"));
+  AddTab(browser(), GURL("https://a.test/"));
+  TabStripModel* const strip = browser()->tab_strip_model();
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  tabs::TabInterface* const a = strip->GetTabAtIndex(0);
+  tabs::TabInterface* const b = strip->GetTabAtIndex(1);
+  tabs::TabInterface* const c = strip->GetTabAtIndex(2);
+  model->SetSpacePinned(a, true);
+  model->SetSpacePinned(b, true);
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(0, strip->GetIndexOfTab(a));
+  ASSERT_EQ(1, strip->GetIndexOfTab(b));
+  ASSERT_EQ(2, strip->GetIndexOfTab(c));
+  strip->ActivateTabAt(0);
+
+  base::ListValue open;
+  open.Append("https://row.test/");
+  open.Append("current");
+  web_ui_.HandleReceivedMessage("openUrl", open);
+  // A tab that lands inside the run of pins moves to just after it, a turn
+  // later (pins H14).
+  task_environment()->RunUntilIdle();
+  ASSERT_EQ(4, strip->count());
+  EXPECT_EQ(GURL("https://a.test/"), a->GetContents()->GetVisibleURL())
+      << "the pin lost its page";
+  const int opened = strip->active_index();
+  EXPECT_EQ(GURL("https://row.test/"),
+            strip->GetWebContentsAt(opened)->GetVisibleURL());
+  EXPECT_LT(opened, strip->GetIndexOfTab(c))
+      << "the row opened past the tab after the pins";
+}
+
+// Pn6: the page asks where a range starts; All has no start, Today a time
+// before now.
+TEST_F(SteddingLibraryHandlerTest, RangesAnswerWithTheirStart) {
+  base::ListValue today;
+  today.Append("cb-today");
+  today.Append("today");
+  web_ui_.HandleReceivedMessage("rangeStart", today);
+  base::ListValue all;
+  all.Append("cb-all");
+  all.Append("all");
+  web_ui_.HandleReceivedMessage("rangeStart", all);
+
+  ASSERT_EQ(2u, web_ui_.call_data().size());
+  const content::TestWebUI::CallData& today_call = *web_ui_.call_data()[0];
+  ASSERT_TRUE(today_call.arg3());
+  ASSERT_TRUE(today_call.arg3()->is_double());
+  EXPECT_LE(today_call.arg3()->GetDouble(),
+            base::Time::Now().InMillisecondsFSinceUnixEpoch());
+  const content::TestWebUI::CallData& all_call = *web_ui_.call_data()[1];
+  ASSERT_TRUE(all_call.arg3());
+  EXPECT_TRUE(all_call.arg3()->is_none());
+}
+
+}  // namespace
+}  // namespace stedding
