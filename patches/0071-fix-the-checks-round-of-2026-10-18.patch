+IN_PROC_BROWSER_TEST_F(RestoreFolderTest,
+                       ADropAMoveOutAndNewContentsKeepTheirFolders) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  tabs::TabInterface* const f1 = Find("f1.test");
