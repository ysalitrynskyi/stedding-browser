 #include "chrome/browser/ui/views/tabs/common/clear_tabs_separator.h"
@@ -951,4 +952,90 @@ IN_PROC_BROWSER_TEST_F(WindowButtonsTest, OnTheRightTheLightsSitOnTheRow) {
