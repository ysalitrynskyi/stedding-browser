+// P21-1b, blocker Bk5: Cancel on the question the shield's reload asks
+// chooses nothing, for good. The choice stayed waiting on the tab, and the
+// next reload of any kind -- Cmd-R with the form sent again -- wrote it: the
+// site lost its blocking though the user had cancelled.
+IN_PROC_BROWSER_TEST_F(BlockerW2B18Test,
+                       ACancelledChoiceIsNotWrittenByALaterReload) {
+  TurnOnAndWait();
+  ASSERT_NO_FATAL_FAILURE(OpenPostedPage());
+  QuestionsW2B18 questions;
+
+  stedding::ToggleBlockingOnSite(Active());
+  views::DialogDelegate* const cancelled = questions.WaitForQuestion();
+  ASSERT_TRUE(cancelled) << "no question about sending the form again";
+  cancelled->CancelDialog();
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(stedding::IsBlockingOnForSite(Active()));
+
+  // Later, Cmd-R, and the form sent again.
+  questions.Forget();
+  content::TestNavigationObserver reload(Active());
+  chrome::ExecuteCommand(browser(), IDC_RELOAD);
+  views::DialogDelegate* const sent = questions.WaitForQuestion();
+  ASSERT_TRUE(sent) << "Cmd-R asked nothing";
+  sent->AcceptDialog();
+  reload.Wait();
+  EXPECT_TRUE(stedding::IsBlockingOnForSite(Active()))
+      << "the reload wrote the choice the user cancelled";
+  EXPECT_TRUE(stedding::GetBlockerExceptions(profile()).empty());
+}
+
+// Bk5: a second press of the shield while its question is still up asks
+// again, and sending the form then makes the choice: the question that the
+// second one replaced does not take the second choice away with it.
+IN_PROC_BROWSER_TEST_F(BlockerW2B18Test, ASecondPressWhileAskedStillChooses) {
+  TurnOnAndWait();
+  ASSERT_NO_FATAL_FAILURE(OpenPostedPage());
+  QuestionsW2B18 questions;
+
+  stedding::ToggleBlockingOnSite(Active());
+  ASSERT_TRUE(questions.WaitForQuestion());
+  questions.Forget();
+  content::TestNavigationObserver reload(Active());
+  stedding::ToggleBlockingOnSite(Active());
+  views::DialogDelegate* const second = questions.WaitForQuestion();
+  ASSERT_TRUE(second) << "the second press asked nothing";
+  second->AcceptDialog();
+  reload.Wait();
+  EXPECT_FALSE(stedding::IsBlockingOnForSite(Active()))
+      << "sending the form again made no choice";
+  EXPECT_EQ(1u, stedding::GetBlockerExceptions(profile()).size());
+}
