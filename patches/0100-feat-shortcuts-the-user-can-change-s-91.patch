+// shortcuts Z21: the divergence rows and the notes are about the shipped
+// binary: a chord the user moved leaves them as they were, while the lookup
+// the menus use names the user's.
+TEST(ShortcutReferenceTest, DivergenceRowsShowTheDefaults) {
+  const std::u16string shipped = ChordText(IDC_STEDDING_CLEAR_SPACE);
+  ASSERT_FALSE(shipped.empty());
+  shortcuts::UserShortcuts user;
+  const shortcuts::Chord moved(
+      ui::VKEY_J, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN);
+  user.chords[IDC_STEDDING_CLEAR_SPACE] = {moved};
+  shortcuts::SetCurrent(user);
+  EXPECT_EQ(shortcuts::ChordText(moved), ChordText(IDC_STEDDING_CLEAR_SPACE))
+      << "the menus name the user's chord";
+  bool found = false;
+  for (const ShortcutGroup& group : ShortcutReference()) {
+    for (const ShortcutRow& row : group.rows) {
+      if (group.kind == "divergence" && row.what == u"Clear the Space") {
+        found = true;
+        EXPECT_EQ(shipped, row.chord);
+      }
+      EXPECT_NE(shortcuts::ChordText(moved), row.chord);
+    }
+  }
