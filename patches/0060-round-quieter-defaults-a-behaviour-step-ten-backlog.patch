@@ -0,0 +1,303 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/folder_commands.h"
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <variant>
+#include <vector>
+
+#include "base/check.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "chrome/browser/ui/tabs/split_tab_metrics.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "chrome/test/base/testing_profile.h"
+#include "components/split_tabs/split_tab_visual_data.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_collection_types.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+constexpr SkColor kBlue = SkColorSetRGB(0x00, 0x00, 0xFF);
+
+class FolderCommandsTest : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  SpaceModel& model() {
+    SpaceModel* const model = SpaceModel::From(browser());
+    CHECK(model) << "a normal window must own a SpaceModel";
+    return *model;
+  }
+
+  // Opens a tab the way the fixture does, in the foreground at the front of
+  // the strip: the strip reads tabs in the reverse of the order they opened.
+  tabs::TabInterface* OpenTab(const GURL& url) {
+    AddTab(browser(), url);
+    return tabs().GetActiveTab();
+  }
+
+  // The same, with `title` as the page's title.
+  tabs::TabInterface* OpenTitled(const GURL& url, const std::u16string& title) {
+    AddTab(browser(), url);
+    content::WebContents* const contents = tabs().GetActiveWebContents();
+    contents->UpdateTitleForEntry(
+        contents->GetController().GetLastCommittedEntry(), title);
+    return tabs().GetActiveTab();
+  }
+
+  void Activate(tabs::TabInterface* tab) {
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(tab));
+  }
+};
+
+// folders F31: nested folders first, by the name their header shows -- an
+// unnamed one reads "New Folder" -- then tabs and splits by name, case
+// ignored and equal names in their order, a split by its first pane.
+TEST_F(FolderCommandsTest, AlphabeticalOrderPutsFoldersFirstThenTabs) {
+  // Opened last first, so the strip reads banana, in_zeta, lower_apple,
+  // cherry, aardvark, in_unnamed, upper_apple.
+  tabs::TabInterface* const upper_apple = OpenTab(GURL("https://a7.test/"));
+  tabs::TabInterface* const in_unnamed = OpenTab(GURL("https://a6.test/"));
+  tabs::TabInterface* const aardvark = OpenTab(GURL("https://a5.test/"));
+  tabs::TabInterface* const cherry = OpenTab(GURL("https://a4.test/"));
+  tabs::TabInterface* const lower_apple = OpenTab(GURL("https://a3.test/"));
+  tabs::TabInterface* const in_zeta = OpenTab(GURL("https://a2.test/"));
+  tabs::TabInterface* const banana = OpenTab(GURL("https://a1.test/"));
+  ASSERT_EQ(7, tabs().count());
+  // cherry is active; the split takes cherry, then aardvark.
+  Activate(cherry);
+  tabs().AddToNewSplit({tabs().GetIndexOfTab(aardvark)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(cherry->IsSplit());
+  ASSERT_EQ(cherry->GetSplit(), aardvark->GetSplit());
+  ASSERT_LT(tabs().GetIndexOfTab(cherry), tabs().GetIndexOfTab(aardvark));
+
+  tabs::FolderTabCollection* const folder =
+      tabs().AddToNewFolder({0, 1, 2, 3, 4, 5, 6});
+  ASSERT_NE(nullptr, folder);
+  tabs::FolderTabCollection* const zeta =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(in_zeta)});
+  ASSERT_NE(nullptr, zeta);
+  zeta->SetTitle("Zeta");
+  tabs::FolderTabCollection* const unnamed =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(in_unnamed)});
+  ASSERT_NE(nullptr, unnamed);
+  ASSERT_EQ(folder, zeta->GetParentCollection());
+  ASSERT_EQ(folder, unnamed->GetParentCollection());
+  // F[banana, Zeta[..], apple, S[cherry, aardvark], [..], Apple]
+  ASSERT_EQ(6u, folder->ChildCount());
+
+  const std::map<const tabs::TabInterface*, std::u16string> names = {
+      {banana, u"banana"},     {in_zeta, u"zebra"},
+      {lower_apple, u"apple"}, {cherry, u"cherry"},
+      {aardvark, u"aardvark"}, {in_unnamed, u"unnamed"},
+      {upper_apple, u"Apple"},
+  };
+  const std::vector<size_t> order = AlphabeticalOrder(
+      *folder,
+      [&names](const tabs::TabInterface& tab) { return names.at(&tab); });
+  // "New Folder", "Zeta"; then apple and Apple in their order, banana, and
+  // the split as cherry (by its second pane, aardvark, it would lead).
+  EXPECT_EQ((std::vector<size_t>{4, 1, 2, 5, 0, 3}), order);
+}
+
+// folders F31 with the names the rows show: a name the user gave a tab
+// (tabs R15) wins over its page title, and an unnamed tab sorts by title.
+TEST_F(FolderCommandsTest, AlphabetizeReadsTheNameTheUserGave) {
+  // The strip reads first, middle, last, and so do their page titles: a sort
+  // by title alone would move nothing.
+  tabs::TabInterface* const last = OpenTitled(GURL("https://c.test/"), u"Zulu");
+  tabs::TabInterface* const middle =
+      OpenTitled(GURL("https://b.test/"), u"Middle");
+  tabs::TabInterface* const first =
+      OpenTitled(GURL("https://a.test/"), u"Alpha");
+  stedding::SetTabName(browser(), first, u"zzz");
+  stedding::SetTabName(browser(), last, u"Aardvark");
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder({0, 1, 2});
+  ASSERT_NE(nullptr, folder);
+  ASSERT_EQ(0, tabs().GetIndexOfTab(first));
+  ASSERT_EQ(2, tabs().GetIndexOfTab(last));
+
+  AlphabetizeFolder(tabs(), folder);
+
+  EXPECT_EQ(0, tabs().GetIndexOfTab(last)) << "Aardvark, its name";
+  EXPECT_EQ(1, tabs().GetIndexOfTab(middle)) << "Middle, its title";
+  EXPECT_EQ(2, tabs().GetIndexOfTab(first)) << "zzz, its name";
+  for (tabs::TabInterface* const tab : {first, middle, last}) {
+    EXPECT_EQ(folder, tab->GetParentCollection()) << "it stays in the folder";
+  }
+}
+
+// folders F32: New Tab in Folder opens the New Tab page as the folder's last
+// row -- after a nested folder, not inside it -- in the active Space, makes
+// it the active tab and expands the folder. A folder that is not there takes
+// nothing.
+TEST_F(FolderCommandsTest, NewTabInFolderIsItsLastRow) {
+  tabs::TabInterface* const loose = OpenTab(GURL("https://loose.test/"));
+  tabs::TabInterface* const q = OpenTab(GURL("https://q.test/"));
+  tabs::TabInterface* const p = OpenTab(GURL("https://p.test/"));
+  // p, q, loose: F[p, N[q]], collapsed, with the active tab outside it.
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder({0, 1});
+  ASSERT_NE(nullptr, folder);
+  tabs::FolderTabCollection* const nested =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(q)});
+  ASSERT_NE(nullptr, nested);
+  ASSERT_EQ(folder, nested->GetParentCollection());
+  Activate(loose);
+  folder->SetCollapsed(true);
+
+  tabs::TabInterface* const tab = NewTabInFolder(tabs(), folder);
+  ASSERT_NE(nullptr, tab);
+  EXPECT_EQ(4, tabs().count());
+  EXPECT_EQ(tab, tabs().GetActiveTab());
+  EXPECT_EQ(folder, tab->GetParentCollection())
+      << "in the folder itself, not in its nested folder";
+  EXPECT_EQ(tabs().GetIndexOfTab(q) + 1, tabs().GetIndexOfTab(tab));
+  const auto* const last =
+      std::get_if<tabs::ScopedTab>(&folder->GetChildren().back());
+  ASSERT_TRUE(last);
+  EXPECT_EQ(tab, last->get()) << "the folder's last row";
+  EXPECT_EQ(0, tabs().GetIndexOfTab(p));
+  EXPECT_EQ(GURL(chrome::kChromeUINewTabURL),
+            tab->GetContents()->GetVisibleURL());
+  EXPECT_TRUE(model().IsTabInActiveSpace(tab));
+  EXPECT_FALSE(folder->collapsed());
+
+  EXPECT_EQ(nullptr, NewTabInFolder(tabs(), nullptr));
+  // A folder with no tab is one that has left the tree (F26).
+  tabs::FolderTabCollection gone(tabs::FolderId::GenerateNew(), std::string(),
+                                 /*collapsed=*/false);
+  EXPECT_EQ(nullptr, NewTabInFolder(tabs(), &gone));
+  EXPECT_EQ(4, tabs().count()) << "nothing was opened for either";
+}
+
+// folders F30: Collapse All and Expand All reach the active Space's folders,
+// nested ones included, and leave another Space's folders as they are.
+TEST_F(FolderCommandsTest, CollapseAndExpandAllKeepToTheActiveSpace) {
+  tabs::TabInterface* const in_b = OpenTab(GURL("https://b.test/"));
+  tabs::TabInterface* const in_a1 = OpenTab(GURL("https://a1.test/"));
+  tabs::TabInterface* const in_a = OpenTab(GURL("https://a.test/"));
+  // in_a, in_a1, in_b: A[in_a, A1[in_a1]] and B[in_b].
+  tabs::FolderTabCollection* const a = tabs().AddToNewFolder({0, 1});
+  ASSERT_NE(nullptr, a);
+  tabs::FolderTabCollection* const a1 =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(in_a1)});
+  ASSERT_NE(nullptr, a1);
+  ASSERT_EQ(a, a1->GetParentCollection());
+  tabs::FolderTabCollection* const b =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(in_b)});
+  ASSERT_NE(nullptr, b);
+  ASSERT_NE(a, b->GetParentCollection());
+  Space* const work = model().AddSpace("Work", kBlue);
+  Activate(in_a);
+  model().SetSpaceForTab(in_b, work->id());
+  ASSERT_FALSE(model().IsTabInActiveSpace(in_b));
+
+  EXPECT_TRUE(CanCollapseAllFolders(browser()));
+  EXPECT_FALSE(CanExpandAllFolders(browser()));
+  CollapseAllFolders(browser());
+  EXPECT_TRUE(a->collapsed());
+  EXPECT_TRUE(a1->collapsed()) << "nested folders too";
+  EXPECT_FALSE(b->collapsed()) << "another Space's folder keeps its state";
+  EXPECT_EQ(in_a, tabs().GetActiveTab()) << "collapsing switches no tab";
+  EXPECT_FALSE(CanCollapseAllFolders(browser()));
+  EXPECT_TRUE(CanExpandAllFolders(browser()));
+
+  b->SetCollapsed(true);
+  ExpandAllFolders(browser());
+  EXPECT_FALSE(a->collapsed());
+  EXPECT_FALSE(a1->collapsed());
+  EXPECT_TRUE(b->collapsed()) << "another Space's folder keeps its state";
+  EXPECT_TRUE(CanCollapseAllFolders(browser()));
+  EXPECT_FALSE(CanExpandAllFolders(browser()))
