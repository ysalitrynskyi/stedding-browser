+  // row's clip (OnBoundsChanged) keeps the whole width of it, at the row's
+  // own corner radius: the density's, a split pane's or the rail square's.
+  constexpr float kHalf = stedding::kLocalTapeStroke / 2;
+  gfx::RectF bounds(GetLocalBounds());
+  float radius = GetCornerRadius();
+  if (pinned_ && split_) {
+    // Lt9: an essentials split's pane lies inside the merged card's insets,
+    // the width of the edge the card no longer draws (tabs R32). Its tape
+    // goes inside them, round the pane's own shape drawn that much smaller.
+    const gfx::Insets insets = GetInsets();
+    bounds.Inset(gfx::InsetsF(insets));
+    radius -= insets.top();
+  }
+  bounds.Inset(kHalf);
+  radius = std::max(0.0f, radius - kHalf);
+  cc::PaintFlags flags;
