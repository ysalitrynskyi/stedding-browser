+// site-controls Si10: Chromium's Extensions row is in the panel; it closes
+// the panel and opens the extensions menu; pinned, the extension's button
+// shows in the row within 2 s (toolbar T43).
+IN_PROC_BROWSER_TEST_F(SiteControlsTest,
+                       TheExtensionsRowOpensTheMenuAndAPinShows) {
+  const scoped_refptr<const extensions::Extension> extension =
+      LoadAction("Stedding Site Controls Probe");
+  ASSERT_TRUE(extension);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("site.test")));
+  ExtensionsToolbarDesktop* const container =
+      browser_view()->toolbar()->extensions_container();
+  ASSERT_TRUE(container);
+  views::BubbleDialogDelegateView* const panel = OpenFromTheChip();
+  views::View* const row =
+      FindView(panel, PageInfoMainView::kSeeExtensionsButtonElementId);
+  ASSERT_TRUE(row) << "no Extensions row";
+  Click(views::AsViewClass<views::Button>(row));
+  EXPECT_TRUE(PanelGoes());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return container->IsExtensionsMenuShowing();
+  })) << "no extensions menu";
+  container->CloseExtensionsMenuIfOpen();
+  const base::TimeTicks pinned = base::TimeTicks::Now();
+  ToolbarActionsModel::Get(browser()->GetProfile())
+      ->SetActionVisibility(extension->id(), true);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    ToolbarActionView* const button = container->GetViewForId(extension->id());
+    return button && button->IsDrawn() && !button->size().IsEmpty();
+  })) << "the pinned extension's button never showed";
+  EXPECT_LT(base::TimeTicks::Now() - pinned, base::Seconds(2));
+}
