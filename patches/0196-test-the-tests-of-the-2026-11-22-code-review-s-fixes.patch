+                       ACopyThatKeepsFailingIsTriedTwentyTimes) {
+  constexpr SkColor kHeader = SkColorSetRGB(0x33, 0x33, 0x33);
+  // The read a restyle asks for and its 20 tries again.
+  constexpr int kCopies = 1 + 20;
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), PageWithHeaderW2B21("333333")));
+  ASSERT_TRUE(WaitForTheRow(kHeader)) << "the header was read";
+  // Past the late read the load asked for, 1.5 s after it ended.
+  PauseW2B21(base::Milliseconds(1600));
+
+  row()->FailCopiesForTesting(1000);
+  const int before = row()->top_copies_for_testing();
+  ASSERT_TRUE(content::ExecJs(
+      page(), "document.body.style.backgroundColor = 'rgb(250, 250, 250)'"));
+  // Until no copy has gone out for two seconds, or the copies are past any
+  // number the tries allow, or 20 seconds have gone.
+  int copies = 0;
+  bool stopped = false;
+  const base::TimeTicks start = base::TimeTicks::Now();
+  base::TimeTicks last_copy = start;
+  {
+    base::RunLoop run_loop;
+    base::RepeatingTimer poll;
+    poll.Start(FROM_HERE, base::Milliseconds(50),
+               base::BindLambdaForTesting([&]() {
+                 const base::TimeTicks now = base::TimeTicks::Now();
+                 const int made = row()->top_copies_for_testing() - before;
+                 if (made != copies) {
+                   copies = made;
+                   last_copy = now;
+                 }
+                 if (copies > 0 && now - last_copy > base::Seconds(2)) {
+                   stopped = true;
+                   run_loop.Quit();
+                 } else if (copies > 2 * kCopies ||
+                            now - start > base::Seconds(20)) {
+                   run_loop.Quit();
+                 }
+               }));
+    run_loop.Run();
+  }
+  row()->FailCopiesForTesting(0);
+  EXPECT_GT(copies, 1) << "the failed copy was not tried again";
+  EXPECT_TRUE(stopped) << copies << " copies, and they had not stopped";
+  // A second request for a read in that time, which a restyle can make,
+  // would bring its own tries.
+  EXPECT_LE(copies, 2 * kCopies);
+}
+
+// P28-1b, toolbar T31: a page that comes back on screen has its top edge read
+// again. Every read that fell due while its window was minimised, hidden or
+// covered was dropped, and nothing read it once it was back, so a header the
+// page drew meanwhile, as one drawn late after the load, never reached the row
+// until a click or a key in the page.
+IN_PROC_BROWSER_TEST_F(PageColourRowW2B21Test,
+                       APageBackOnScreenHasItsEdgeReadAgain) {
+  constexpr SkColor kHeader = SkColorSetRGB(0xff, 0xf3, 0xe0);
+  constexpr SkColor kLaterHeader = SkColorSetRGB(0xe0, 0xf3, 0xff);
+  ASSERT_TRUE(
+      ui_test_utils::NavigateToURL(browser(), PageWithHeaderW2B21("fff3e0")));
+  ASSERT_TRUE(WaitForTheRow(kHeader)) << "the header was read";
+  content::WebContents* const contents = page();
+
+  // Off the screen, the page draws its header in another colour, and the
+  // reads due after its load (the late one 1.5 s after it) fall due.
+  contents->WasHidden();
+  ASSERT_EQ(content::Visibility::HIDDEN, contents->GetVisibility());
+  ASSERT_TRUE(content::ExecJs(
+      contents,
+      "document.getElementById('header').style.background = '#e0f3ff'"));
+  PauseW2B21(base::Milliseconds(1600));
+  ASSERT_EQ(content::Visibility::HIDDEN, contents->GetVisibility())
+      << "the premise: the page stayed off the screen";
+  ASSERT_TRUE(row()->color());
+  ASSERT_TRUE(stedding::PageColorsMatch(*row()->color(), kHeader))
+      << "the row changed while the page was off the screen";
+
+  contents->WasShown();
+  EXPECT_TRUE(WaitForTheRow(kLaterHeader))
+      << "back on screen, the page's edge was not read again";
+}
+
+}  // namespace
