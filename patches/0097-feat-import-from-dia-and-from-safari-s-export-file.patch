+ImportsAllowed AllowedImports(const PrefService& prefs) {
+  ImportsAllowed allowed;
+  allowed.bookmarks = !ManagedOff(prefs, ::prefs::kImportBookmarks) &&
+                      !ManagedOff(prefs, bookmarks::prefs::kEditBookmarksEnabled);
+  allowed.history = !ManagedOff(prefs, ::prefs::kImportHistory) &&
+                    !ManagedOn(prefs, ::prefs::kSavingBrowserHistoryDisabled);
+  allowed.passwords =
+      !ManagedOff(prefs, ::prefs::kImportSavedPasswords) &&
+      !ManagedOff(prefs, password_manager::prefs::kCredentialsEnableService);
+  return allowed;
+}
+
+BookmarkMergeResult MergeImportedBookmarks(
+    bookmarks::BookmarkModel& model,
+    PrefService& prefs,
+    std::string_view source_key,
+    const std::u16string& folder_title,
+    const std::u16string& toolbar_title,
+    const std::vector<user_data_importer::ImportedBookmarkEntry>& entries) {
+  CHECK(model.loaded());
+  BookmarkMergeResult result;
+  const bool any = std::ranges::any_of(
+      entries, [](const user_data_importer::ImportedBookmarkEntry& entry) {
+        return entry.is_folder || IsWebPage(entry.url);
+      });
+  if (!any) {
+    return result;
+  }
+  model.BeginExtensiveChanges();
+  const bookmarks::BookmarkNode* const root =
+      SourceFolder(model, prefs, source_key, folder_title);
+  FolderIndex index(model);
+  for (const user_data_importer::ImportedBookmarkEntry& entry : entries) {
+    if (!entry.is_folder && !IsWebPage(entry.url)) {
+      continue;
+    }
+    const bookmarks::BookmarkNode* parent = root;
+    if (entry.in_toolbar) {
+      parent = index.Folder(parent, toolbar_title);
+    }
+    for (const std::u16string& name : entry.path) {
+      parent = index.Folder(parent, name);
+    }
+    if (entry.is_folder) {
+      index.Folder(parent, entry.title);
+      continue;
+    }
+    if (index.AddPage(parent, entry.title, entry.url, entry.creation_time)) {
+      ++result.added;
+    } else {
+      ++result.already_there;
+    }
+  }
+  model.EndExtensiveChanges();
+  return result;
+}
