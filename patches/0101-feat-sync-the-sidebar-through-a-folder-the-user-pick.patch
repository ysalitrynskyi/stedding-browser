+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * @fileoverview
+ * 'settings-stedding-sync-section' is the "Sync through a folder" box of
+ * Settings > Stedding > Spaces (docs/features/sidebar-file.md Sf7-Sf41):
+ * off by default; Set up… picks a folder and shows a sheet before anything
+ * is written; once on, the folder, one status line, at most one problem,
+ * the rows that wait for the user, the recent changes with Undo and the
+ * backups. Stedding makes no network request for any of it.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+
+import type {CrCheckboxElement} from 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {WebUiListenerMixinLit} from 'chrome://resources/cr_elements/web_ui_listener_mixin_lit.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './stedding_sync_section.css.js';
+import {getHtml} from './stedding_sync_section.html.js';
+
+/** A row that waits for the user (Sf20-Sf25, Sf28). */
+export interface SteddingSyncDecision {
+  id: string;
+  kind: string;
+  device?: string;
+  added?: number;
+  removed?: number;
+  spaceName?: string;
+  turnOn?: boolean;
+  pages?: number;
+  name?: string;
+  count?: number;
+}
+
+/** One batch from another computer (Sf35). */
+export interface SteddingSyncJournalEntry {
+  id: string;
+  device: string;
+  added: number;
+  removed: number;
+  changed: number;
+  replacedLocal: boolean;
+  agoMs: number;
+}
+
+export interface SteddingSyncPeer {
+  device: string;
+  agoMs: number;
+}
+
+/** What the browser reports (SidebarSyncService::GetStatus). */
+export interface SteddingSyncStatus {
+  available: boolean;
+  enabled: boolean;
+  ready?: boolean;
+  folder: string;
+  device: string;
+  problem?: string;
+  problemDevice?: string;
+  peers?: SteddingSyncPeer[];
+  journal?: SteddingSyncJournalEntry[];
+  decisions?: SteddingSyncDecision[];
+  backups?: string[];
+  deferred?: number;
+}
+
+export interface SteddingSyncComputer {
+  device: string;
+  spaces: number;
+  pins: number;
+  folders: number;
+  essentials: number;
+  updatedMs: number;
+}
+
+export interface SteddingSyncPair {
+  label: string;
+  kind: string;
+}
+
+/** The sheet's content, or a refusal (Sf8, Sf9). */
+export interface SteddingSyncPreview {
+  refusal?: string;
+  dir?: string;
+  computers?: SteddingSyncComputer[];
+  newer?: string[];
+  here?: {spaces: number, pins: number};
+  pairs?: SteddingSyncPair[];
+  deviceName?: string;
+}
+
+// Sf8: the sentence for each refusal of a picked folder.
+const REFUSALS: Record<string, string> = {
+  inside: 'steddingSyncRefusedInside',
+  missing: 'steddingSyncRefusedMissing',
+  unwritable: 'steddingSyncRefusedUnwritable',
+  denied: 'steddingSyncRefusedDenied',
+};
+
+// Sf31: the sentence for each problem, most important first in the browser.
+const PROBLEMS: Record<string, string> = {
+  ledgerLost: 'steddingSyncProblemLedgerLost',
+  unreachable: 'steddingSyncProblemUnreachable',
+  denied: 'steddingSyncProblemDenied',
+  writeFailed: 'steddingSyncProblemWriteFailed',
+  waiting: 'steddingSyncProblemWaiting',
+  newer: 'steddingSyncProblemNewer',
+  clockAhead: 'steddingSyncProblemClockAhead',
+  unreadable: 'steddingSyncProblemUnreadable',
+  noWatch: 'steddingSyncProblemNoWatch',
+};
+
+const SettingsSteddingSyncSectionElementBase =
+    WebUiListenerMixinLit(CrLitElement);
+
+export class SettingsSteddingSyncSectionElement extends
+    SettingsSteddingSyncSectionElementBase {
+  static get is() {
+    return 'settings-stedding-sync-section';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      status_: {type: Object},
+      preview_: {type: Object},
+      refusal_: {type: String},
+      pairChecks_: {type: Array},
+      removeOwnFile_: {type: Boolean},
+      deviceName_: {type: String},
+      pendingDelete_: {type: Object},
+    };
+  }
+
+  protected accessor status_: SteddingSyncStatus|null = null;
+  protected accessor preview_: SteddingSyncPreview|null = null;
+  protected accessor refusal_: string = '';
+  protected accessor pairChecks_: boolean[] = [];
+  protected accessor removeOwnFile_: boolean = false;
+  protected accessor deviceName_: string = '';
+  protected accessor pendingDelete_: SteddingSyncDecision|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addWebUiListener(
+        'stedding-sidebar-sync-changed',
+        (status: SteddingSyncStatus) => this.status_ = status);
+    this.addWebUiListener(
+        'stedding-sidebar-sync-preview',
+        (preview: SteddingSyncPreview) => this.onPreview_(preview));
+    sendWithPromise('steddingSidebarSyncStatus').then((status: unknown) => {
+      this.status_ = status as SteddingSyncStatus;
+    });
+  }
+
+  private dialog_(id: string): CrDialogElement {
+    return this.shadowRoot.querySelector<CrDialogElement>(`#${id}`)!;
+  }
+
+  // Sf8: a refusal is one sentence; otherwise the sheet (Sf9).
+  private onPreview_(preview: SteddingSyncPreview) {
+    if (preview.refusal) {
+      this.refusal_ = loadTimeData.getString(
+          REFUSALS[preview.refusal] || 'steddingSyncRefusedMissing');
+      return;
+    }
+    this.refusal_ = '';
+    this.preview_ = preview;
+    this.deviceName_ = preview.deviceName || '';
+    this.pairChecks_ = (preview.pairs || []).map(() => true);
+    this.dialog_('joinDialog').showModal();
+  }
+
+  protected hasPeers_(): boolean {
+    return !!this.preview_?.computers?.length;
+  }
+
+  protected previewLines_(): string[] {
+    const preview = this.preview_;
+    if (!preview) {
+      return [];
+    }
+    if (!this.hasPeers_()) {
+      return [loadTimeData.getStringF('steddingSyncEmptyFolder',
+                                      preview.dir || '')];
+    }
+    const lines = (preview.computers || [])
+                      .map(
+                          computer => loadTimeData.getStringF(
+                              'steddingSyncComputer', computer.device,
+                              computer.spaces, computer.pins, computer.folders,
+                              computer.essentials));
+    for (const device of preview.newer || []) {
+      lines.push(loadTimeData.getStringF('steddingSyncProblemNewer', device));
+    }
+    if (preview.here) {
+      lines.push(loadTimeData.getStringF(
+          'steddingSyncHere', preview.here.spaces, preview.here.pins));
+    }
+    return lines;
+  }
+
+  protected onJoinDeviceInput_(e: Event) {
+    this.deviceName_ = (e.target as CrInputElement).value;
+  }
+
+  protected onPairChange_(e: Event) {
+    const box = e.target as CrCheckboxElement;
+    const index = Number(box.dataset['index']);
+    const checks = this.pairChecks_.slice();
+    checks[index] = box.checked;
+    this.pairChecks_ = checks;
+  }
+
+  protected onSetUpClick_() {
+    this.refusal_ = '';
+    chrome.send('steddingChooseSyncFolder');
+  }
+
+  protected onCombineClick_() {
+    const accepted: number[] = [];
+    this.pairChecks_.forEach((checked, index) => {
+      if (checked) {
+        accepted.push(index);
+      }
+    });
+    chrome.send('steddingConfirmSyncJoin',
+                ['combine', this.deviceName_.trim(), accepted]);
+    this.preview_ = null;
+    this.dialog_('joinDialog').close();
+  }
+
+  protected onKeepBothClick_() {
+    chrome.send('steddingConfirmSyncJoin',
+                ['keepBoth', this.deviceName_.trim(), []]);
+    this.preview_ = null;
+    this.dialog_('joinDialog').close();
+  }
+
+  protected onJoinCancelClick_() {
+    this.dialog_('joinDialog').close();
+  }
+
+  // Escape, or Cancel: sync stays off and nothing was written (Sf9).
+  protected onJoinDialogClose_() {
+    if (this.preview_) {
+      this.preview_ = null;
+      chrome.send('steddingCancelSyncJoin');
+    }
+  }
+
+  protected folderLine_(): string {
+    return loadTimeData.getStringF('steddingSyncFolder',
+                                   this.status_?.folder || '');
+  }
+
+  protected statusLine_(): string {
+    const status = this.status_;
+    const peers = status?.peers || [];
+    if (!peers.length) {
+      return loadTimeData.getString('steddingSyncAlone');
+    }
+    let line = loadTimeData.getStringF(
+        'steddingSyncWith', peers.map(peer => peer.device).join(', '));
+    const last = status?.journal?.[0];
+    if (last) {
+      line += ' ' + this.journalLine_(last);
+      if (last.replacedLocal) {
+        line += ' ' + loadTimeData.getString('steddingSyncReplacedLocal');
+      }
+    }
+    return line;
+  }
+
+  // Sf31: at most one problem, the most important first.
+  protected problemLine_(): string {
+    const problem = this.status_?.problem;
+    if (!problem) {
+      return '';
+    }
+    const key = PROBLEMS[problem];
+    return key ? loadTimeData.getStringF(key, this.status_?.problemDevice || '') :
+                 '';
+  }
+
+  protected decisions_(): SteddingSyncDecision[] {
+    return this.status_?.decisions || [];
+  }
+
+  protected journal_(): SteddingSyncJournalEntry[] {
+    return this.status_?.journal || [];
+  }
+
+  protected backups_(): string[] {
+    return this.status_?.backups || [];
+  }
+
+  protected journalLine_(entry: SteddingSyncJournalEntry): string {
+    return loadTimeData.getStringF('steddingSyncJournalEntry', entry.device,
+                                   entry.added, entry.removed, entry.changed);
+  }
+
+  protected undoLabel_(entry: SteddingSyncJournalEntry): string {
+    return loadTimeData.getStringF('steddingSyncUndoNamed',
+                                   this.journalLine_(entry));
+  }
+
+  protected importLabel_(name: string): string {
+    return loadTimeData.getStringF('steddingSyncImportNamed', name);
+  }
+
+  protected decisionLine_(row: SteddingSyncDecision): string {
+    switch (row.kind) {
+      case 'batch':
+        return loadTimeData.getStringF('steddingSyncDecisionBatch',
+                                       row.device || '', row.removed || 0,
+                                       row.added || 0);
+      case 'spaceDeleted':
+        return loadTimeData.getStringF('steddingSyncDecisionSpace',
+                                       row.spaceName || '', row.device || '');
+      case 'isolation':
+        return loadTimeData.getStringF(
+            row.turnOn ? 'steddingSyncDecisionIsolationOn' :
+                         'steddingSyncDecisionIsolationOff',
+            row.spaceName || '', row.pages || 0);
+      case 'move':
+        return loadTimeData.getStringF('steddingSyncDecisionMove',
+                                       row.name || '');
+      case 'notHere':
+        return loadTimeData.getStringF('steddingSyncDecisionNotHere',
+                                       row.count || 0);
+      case 'conflictCopy':
+        return loadTimeData.getStringF('steddingSyncDecisionCopy',
+                                       row.name || '');
+    }
+    return '';
+  }
+
+  protected decisionButtons_(row: SteddingSyncDecision):
+      Array<{choice: string, label: string}> {
+    const label = (key: string) => loadTimeData.getString(key);
+    switch (row.kind) {
+      case 'batch':
+        return [
+          {choice: 'apply', label: label('steddingSyncApply')},
+          {choice: 'keep', label: label('steddingSyncKeep')},
+        ];
+      case 'spaceDeleted':
+        return [
+          {choice: 'deleteHere', label: label('steddingSyncDeleteHere')},
+          {choice: 'keep', label: label('steddingSyncKeep')},
+        ];
+      case 'isolation':
+        return [
+          {
+            choice: 'turn',
+            label: label(row.turnOn ? 'steddingSyncTurnOn' :
+                                      'steddingSyncTurnOff'),
+          },
+          {choice: 'keep', label: label('steddingSyncNotOnThisComputer')},
+        ];
+      case 'move':
+        return [{choice: 'move', label: label('steddingSyncMoveNow')}];
+      case 'notHere':
+        return [{choice: 'bring', label: label('steddingSyncBringHere')}];
+      case 'conflictCopy':
+        return [
+          {choice: 'show', label: label('steddingSyncShowInFolder')},
+          {choice: 'dismiss', label: label('steddingSyncDismiss')},
+        ];
+    }
+    return [];
+  }
+
+  protected onDecisionClick_(e: Event) {
+    const button = e.currentTarget as HTMLElement;
+    const id = button.dataset['id'] || '';
+    const choice = button.dataset['choice'] || '';
+    const row = this.decisions_().find(each => each.id === id);
+    if (!row) {
+      return;
+    }
+    // Sf23: Delete here asks the usual question first.
+    if (choice === 'deleteHere') {
+      this.pendingDelete_ = row;
+      this.dialog_('deleteDialog').showModal();
+      return;
+    }
+    if (choice === 'show') {
+      chrome.send('steddingShowSyncConflict', [row.name || '']);
+      return;
+    }
+    chrome.send('steddingResolveSyncDecision', [id, choice]);
+  }
+
+  protected deleteTitle_(): string {
+    return loadTimeData.getStringF('steddingSyncDeleteTitle',
+                                   this.pendingDelete_?.spaceName || '');
+  }
+
+  protected onDeleteCancelClick_() {
+    this.pendingDelete_ = null;
+    this.dialog_('deleteDialog').close();
+  }
+
+  protected onDeleteConfirmClick_() {
+    if (this.pendingDelete_) {
+      chrome.send('steddingResolveSyncDecision',
+                  [this.pendingDelete_.id, 'apply']);
+    }
+    this.pendingDelete_ = null;
+    this.dialog_('deleteDialog').close();
+  }
+
+  protected onUndoClick_(e: Event) {
+    chrome.send('steddingUndoSyncBatch',
+                [(e.currentTarget as HTMLElement).dataset['id'] || '']);
+  }
+
+  protected onImportBackupClick_(e: Event) {
+    chrome.send('steddingImportSyncBackup',
+                [(e.currentTarget as HTMLElement).dataset['name'] || '']);
+  }
+
+  protected onDeviceChange_(e: Event) {
+    chrome.send('steddingSetSyncDevice', [(e.target as CrInputElement).value]);
+  }
+
+  protected onSyncNowClick_() {
+    chrome.send('steddingSyncNow');
+  }
+
+  protected onShowFolderClick_() {
+    chrome.send('steddingShowSyncFolder');
+  }
+
+  protected onStopClick_() {
+    this.removeOwnFile_ = false;
+    this.dialog_('stopDialog').showModal();
+  }
+
+  protected onRemoveOwnFileChange_(e: Event) {
+    this.removeOwnFile_ = (e.target as CrCheckboxElement).checked;
+  }
+
+  protected onStopCancelClick_() {
+    this.dialog_('stopDialog').close();
+  }
+
+  // Sf37: nothing in the sidebar changes; the file goes only when ticked.
+  protected onStopConfirmClick_() {
+    chrome.send('steddingStopSync', [this.removeOwnFile_]);
+    this.dialog_('stopDialog').close();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-stedding-sync-section': SettingsSteddingSyncSectionElement;
+  }
+}
+
+customElements.define(
+    SettingsSteddingSyncSectionElement.is, SettingsSteddingSyncSectionElement);
