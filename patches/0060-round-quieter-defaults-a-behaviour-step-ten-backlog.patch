+    }
+    const auto& closed =
+        static_cast<const sessions::tab_restore::Split&>(*entry);
+    if (closed.split_id == split) {
+      return closed.id;
+    }
+  }
+  return std::nullopt;
+}
+
+std::vector<SessionID> UndoOrder(
+    const sessions::TabRestoreService::Entries& entries,
+    const std::vector<SessionID>& offered) {
+  std::vector<SessionID> order;
+  for (const std::unique_ptr<sessions::tab_restore::Entry>& entry : entries) {
+    if (std::ranges::find(offered, entry->id) != offered.end()) {
+      order.push_back(entry->id);
+    }
+  }
+  return order;
+}
+
+std::u16string ClosedTabsToastText(size_t tabs, const std::u16string& title) {
+  if (tabs == 1 && !title.empty()) {
+    // A placeholder, not a message pattern: a page title may hold braces.
+    return l10n_util::GetStringFUTF16(
+        IDS_STEDDING_TAB_CLOSED_TOAST_BODY,
+        gfx::TruncateString(title, kToastTitleLength, gfx::WORD_BREAK));
+  }
+  return l10n_util::GetPluralStringFUTF16(IDS_STEDDING_TABS_CLOSED_TOAST_BODY,
+                                          static_cast<int>(tabs));
+}
+
+DEFINE_USER_DATA(ClosedTabsUndo);
+
+// static
+ClosedTabsUndo* ClosedTabsUndo::From(BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+ClosedTabsUndo::ClosedTabsUndo(BrowserWindowInterface& browser)
+    : browser_(browser) {
+  scoped_user_data_.emplace(browser.GetUnownedUserDataHost(), *this);
+  if (TabStripModel* const strip = browser_->GetTabStripModel()) {
+    strip->AddObserver(this);
+  }
+}
+
+ClosedTabsUndo::~ClosedTabsUndo() {
+  if (TabStripModel* const strip = browser_->GetTabStripModel()) {
+    strip->RemoveObserver(this);
+  }
+}
+
+bool ClosedTabsUndo::WindowClosing() const {
+  const TabStripModel* const strip = browser_->GetTabStripModel();
+  if (!strip || strip->closing_all()) {
+    return true;
+  }
+  const DesktopBrowserWindowCapabilities* const capabilities =
+      browser_->capabilities();
+  return capabilities && capabilities->IsAttemptingToCloseBrowser();
+}
+
+void ClosedTabsUndo::OnTabWillBeRemoved(tabs::TabInterface* tab, int index) {
+  // A removed tab no longer knows its split, and a split closed whole is
+  // found in the list by its split's id (tabs R25). Both panes are noted at
+  // the first: the split may be gone by the time the second leaves.
+  if (!tab || WindowClosing()) {
+    return;
+  }
+  const std::optional<split_tabs::SplitTabId> split = tab->GetSplit();
+  if (!split) {
+    return;
+  }
+  for (tabs::TabInterface* const pane : *browser_->GetTabStripModel()) {
+    if (pane->GetSplit() == split) {
+      leaving_splits_.insert_or_assign(pane->GetHandle(), *split);
+    }
+  }
+}
+
+void ClosedTabsUndo::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() != TabStripModelChange::kRemoved) {
+    return;
+  }
+  const std::map<tabs::TabHandle, split_tabs::SplitTabId> splits =
+      std::exchange(leaving_splits_, {});
+  // tabs R26: a window closing or the app quitting records a window, and
+  // its tabs get no entries of their own.
+  if (WindowClosing()) {
+    return;
+  }
+  // A close is undone through the recently-closed list; a private window
+  // has none (private V3), and a close with no entry made none.
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfileIfExisting(browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+  const sessions::TabRestoreService::Entries& entries = service->entries();
+  const bool undo_toast_on = UndoToastOn(browser_->GetProfile()->GetPrefs());
+
+  bool gathered = false;
+  for (const TabStripModelChange::RemovedTab& removed :
+       change.GetRemove()->contents) {
+    std::optional<SessionID> id = removed.session_id;
+    if (!id && removed.tab) {
+      if (const auto split = splits.find(removed.tab->GetHandle());
+          split != splits.end()) {
+        id = FindClosedSplit(entries, split->second);
+      }
+    }
+    const std::optional<ClosedEntry> entry =
+        id ? DescribeClosedEntry(entries, *id) : std::nullopt;
+
+    LeavingTab leaving;
+    leaving.closed =
+        removed.remove_reason == TabRemovedReason::kDeleted ||
+        removed.remove_reason == TabRemovedReason::kDeletedAndExpandSidePanel;
+    leaving.user_gesture =
+        removed.contents && removed.contents->GetClosedByUserGesture();
+    leaving.recorded = entry.has_value();
+    leaving.undo_toast_on = undo_toast_on;
+    leaving.reason = entry ? entry->reason : std::string();
+    if (!OffersUndo(leaving)) {
+      continue;
+    }
+
+    // The tab on screen when the close began. Clear closes one tab at a
+    // time, and a tab the strip shows after one of them may be the next to
+    // go: only the first counts.
+    bool on_screen = removed.tab && removed.tab == selection.old_tab;
+    for (const Closed& closed : gathering_) {
+      on_screen = on_screen && !closed.on_screen;
+    }
+
+    if (gathering_.empty()) {
+      // R27: the Space the close was made in, shown again by an Undo that
+      // has no tab to show.
+      if (spaces::SpaceModel* const model =
+              spaces::SpaceModel::From(&*browser_)) {
+        gathering_space_ = model->active_id();
+      }
+    }
+    // A split's two panes name one entry.
+    const auto same = std::ranges::find_if(
+        gathering_, [&](const Closed& closed) { return closed.id == *id; });
+    if (same != gathering_.end()) {
+      same->on_screen = same->on_screen || on_screen;
+    } else {
+      Closed closed;
+      closed.id = *id;
+      closed.tabs = entry->tabs;
+      closed.title = entry->title;
+      closed.on_screen = on_screen;
+      gathering_.push_back(std::move(closed));
+    }
+    gathered = true;
+  }
+
+  // R25: what one verb closes in one turn is one close, Clear's one-by-one
+  // closes included. The flush runs after the Space model's own settling,
+  // which was posted first.
+  if (gathered && !flush_posted_) {
+    flush_posted_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ClosedTabsUndo::Flush,
+                                  weak_factory_.GetWeakPtr()));
+  }
+}
+
+void ClosedTabsUndo::Flush() {
+  flush_posted_ = false;
+  std::vector<Closed> gathered = std::exchange(gathering_, {});
+  const std::optional<spaces::SpaceId> space =
+      std::exchange(gathering_space_, std::nullopt);
+  if (gathered.empty() || WindowClosing() ||
+      browser_->GetTabStripModel()->empty()) {
+    return;
+  }
+  // R30: the setting was turned off since the close.
+  if (!UndoToastOn(browser_->GetProfile()->GetPrefs())) {
+    return;
+  }
+  ToastController* const toasts = ToastController::From(&*browser_);
+  if (!toasts) {
+    return;
+  }
+  size_t count = 0;
+  for (const Closed& closed : gathered) {
+    count += closed.tabs;
+  }
+  // One tab is named; a split closed whole counts both panes.
+  std::u16string title;
+  if (gathered.size() == 1 && gathered.front().tabs == 1) {
+    title = gathered.front().title;
+  }
+  // A later close replaces the toast and its Undo; the earlier close stays
+  // in ⇧⌘T's list.
+  offered_ = std::move(gathered);
+  offered_space_ = space;
+  ToastParams params(ToastId::kSteddingTabsClosed);
+  params.body_string_override = ClosedTabsToastText(count, title);
+  toasts->MaybeShowToast(std::move(params));
+}
+
+size_t ClosedTabsUndo::Undo() {
+  // Once: a second press, or one after a later close took the toast, does
+  // nothing to this close.
+  const std::vector<Closed> offered = std::exchange(offered_, {});
+  const std::optional<spaces::SpaceId> space =
+      std::exchange(offered_space_, std::nullopt);
+  if (offered.empty()) {
+    return 0;
+  }
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser_->GetProfile());
+  sessions::LiveTabContext* const context =
+      BrowserLiveTabContext::FindContextWithID(browser_->GetSessionID());
+  TabStripModel* const strip = browser_->GetTabStripModel();
+  if (!service || !context || !strip) {
+    return 0;
+  }
+
+  // What each entry says, read first: a restore deletes its entry.
+  std::vector<SessionID> ids;
+  for (const Closed& closed : offered) {
+    ids.push_back(closed.id);
+  }
+  struct Step {
+    ClosedEntry entry;
+    bool on_screen = false;
+  };
+  std::vector<Step> steps;
+  for (const SessionID id : UndoOrder(service->entries(), ids)) {
+    std::optional<ClosedEntry> entry =
+        DescribeClosedEntry(service->entries(), id);
+    if (!entry) {
+      continue;
+    }
+    Step step;
+    step.entry = std::move(*entry);
+    for (const Closed& closed : offered) {
+      step.on_screen = step.on_screen || (closed.id == id && closed.on_screen);
+    }
+    steps.push_back(std::move(step));
+  }
+
+  size_t restored = 0;
+  std::optional<tabs::TabHandle> shown;
+  for (const Step& step : steps) {
+    // In the background, as RestoreArchivedTab restores: a hidden tab loads
+    // nothing until it is in its Space and its jar, and only the tab that
+    // was on screen is shown, once, below. Each tab comes back in its Space,
+    // jar and folder from the entry's extra data, as for ⇧⌘T.
+    // Nothing when the entry is gone: no tab came back.
+    const std::vector<sessions::LiveTab*> live =
+        service
+            ->RestoreEntryById(context, step.entry.id,
+                               WindowOpenDisposition::NEW_BACKGROUND_TAB)
+            .value_or(std::vector<sessions::LiveTab*>());
+    for (const sessions::LiveTab* const live_tab : live) {
+      if (live_tab) {
+        ++restored;
+      }
+    }
+    tabs::TabInterface* const tab = FindRestoredTab(*strip, live);
+    if (!tab) {
+      continue;
+    }
+    // A tab restored with a disposition lands at the end; it goes back to
+    // the index it was closed at, which puts a tab of a folder back in the
+    // folder. A split stays where it lands: a move would unsplit it.
+    if (!step.entry.split && !tab->IsSplit() && step.entry.index >= 0) {
+      const int from = strip->GetIndexOfTab(tab);
+      const int to = std::min(step.entry.index, strip->count() - 1);
+      if (from != TabStripModel::kNoTab && from != to) {
+        strip->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+      }
+    }
+    if (step.on_screen && !shown) {
+      shown = tab->GetHandle();
+    }
+  }
+
+  // The tab that was on screen is on screen again, and its Space with it,
+  // in that order, so the Space has nothing to settle. Without one, the
+  // Space the close was made in is shown again.
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(&*browser_);
+  if (tabs::TabInterface* const tab = shown ? shown->Get() : nullptr) {
+    if (const int index = strip->GetIndexOfTab(tab);
+        index != TabStripModel::kNoTab) {
+      strip->ActivateTabAt(index);
+    }
+    // An essential is in every Space and changes none.
+    if (model && !tab->IsPinned()) {
+      // A copy: the switch may refile tabs while it reads the id.
+      const spaces::SpaceId tab_space = model->SpaceForTab(tab);
+      model->SetActiveSpace(tab_space);
+    }
+  } else if (model && space && model->GetSpace(*space) &&
+             *space != model->active_id()) {
+    model->SetActiveSpace(*space);
+  }
+  return restored;
+}
+
+}  // namespace stedding
