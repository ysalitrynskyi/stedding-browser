+
+// clean-links Cl14: SafeSearch's parameters go on a Google search, home or
+// SafeSearch settings page, at the end, once; anything else is left alone.
+TEST(CleanLinkTest, AddsGoogleSafeSearchToGoogleSearchOnly) {
+  EXPECT_EQ(GURL("https://www.google.com/search?q=x&safe=active&ssui=on"),
+            WithGoogleSafeSearch(GURL("https://www.google.com/search?q=x")));
+  EXPECT_EQ(
+      GURL("https://www.google.com/search?q=x&safe=active&ssui=on"),
+      WithGoogleSafeSearch(
+          GURL("https://www.google.com/search?q=x&safe=active&ssui=on")));
+  EXPECT_EQ(GURL("https://www.google.com/url?q=https://a.test/"),
+            WithGoogleSafeSearch(
+                GURL("https://www.google.com/url?q=https://a.test/")));
+  EXPECT_EQ(GURL("https://a.test/search?q=x"),
+            WithGoogleSafeSearch(GURL("https://a.test/search?q=x")));
