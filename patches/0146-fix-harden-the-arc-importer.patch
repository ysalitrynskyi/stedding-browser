+// import I6 (BACKLOG S-160): Arc's history comes whether or not its sidebar can
+// be read: with no file, and with one that is no sidebar. The summary and the
+// result line say the sidebar could not be read. Nothing was offered, and
+// nothing came.
+IN_PROC_BROWSER_TEST_F(ArcImportTest, HistoryComesWithoutASidebar) {
+  ASSERT_NO_FATAL_FAILURE(WriteHistory());
+  content::WebContents* const page = OpenSettings();
+  ASSERT_TRUE(page);
+  const GURL read("https://read.example/");
+  const auto import_once = [&]() {
+    const std::string summary =
+        content::EvalJs(page, kArcSummary).ExtractString();
+    EXPECT_NE(std::string::npos, summary.find("sidebar could not be read"))
+        << summary;
+    EXPECT_NE(std::string::npos, summary.find("history and passwords"))
+        << summary;
+    return ImportFromSettings(page);
+  };
+  {
+    SCOPED_TRACE("no sidebar file");
+    const std::string line = import_once();
+    EXPECT_NE(std::string::npos, line.find("2 history entries")) << line;
+    EXPECT_NE(std::string::npos, line.find("sidebar could not be read")) << line;
+    EXPECT_EQ(1u, VisitsTo(read));
+    EXPECT_EQ(1u, spaces::SpaceModel::From(browser())->size());
+  }
+  {
+    SCOPED_TRACE("a sidebar file that does not parse");
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::WriteFile(
+        arc_.Append(FILE_PATH_LITERAL("StorableSidebar.json")), "{ not json"));
+  }
+  {
+    const std::string line = import_once();
+    EXPECT_NE(std::string::npos, line.find("sidebar could not be read")) << line;
+    EXPECT_EQ(1u, VisitsTo(read)) << "nothing twice (I22)";
+  }
+}
