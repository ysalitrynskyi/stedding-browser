+std::vector<SwitcherSessionLine> SpaceSwitcherView::SessionLines() const {
+  // The rail stacks its chips: no line joins them there (ShowIsolationMark
+  // gives them their badges). Nor does a row hidden under the rename field.
+  if (collapsed_ || !icon_row_ || !icon_row_->GetVisible() ||
+      !model_->registry()) {
+    return {};
+  }
+  std::vector<SwitcherSpan> spans;
+  std::vector<std::string> sessions;
+  for (const auto& [chip, id] : chips_) {
+    spans.push_back({chip->x(), chip->width()});
+    sessions.push_back(model_->SessionOf(id));
+  }
+  return SwitcherSessionLines(spans, sessions);
+}
+
+void SpaceSwitcherView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  const std::vector<SwitcherSessionLine> lines = SessionLines();
+  if (lines.empty()) {
+    return;
+  }
+  // sessions S32, spaces B38 (GitHub issue 99, BACKLOG S-477): the lanes
+  // start under the lowest chip, the active one when the others are dots.
+  int bottom = 0;
+  for (const auto& [chip, id] : chips_) {
+    bottom = std::max(bottom, chip->bounds().bottom());
+  }
+  const gfx::RectF row(icon_row_->bounds());
+  // The shade for the sidebar's ground, the badges' ring (ShowIsolationMark).
+  // The faint connector: 35% of it on a light ground; a dark one takes more,
+  // where 35% barely showed (the owner, 2026-11-13).
+  const SkColor ground = GetColorProvider()->GetColor(ui::kColorFrameActive);
+  const SkAlpha faint = color_utils::IsDark(ground) ? 0x8C : 0x59;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  for (const SwitcherSessionLine& line : lines) {
+    const SkColor color = SessionColorForGround(
+        SessionSlot(*model_->registry(), line.session), ground);
+    const float top = row.y() + bottom + kSwitcherSessionStroke +
+                      line.lane * kSwitcherSessionLanePitch;
+    // The spans are the row's own, before mirroring for a right-to-left UI.
+    const auto drawn = [&](const SwitcherSpan& span, float y, float height) {
+      return gfx::RectF(
+          row.x() +
+              icon_row_->GetMirroredXWithWidthInView(span.start, span.extent),
+          y,
+          span.extent, height);
+    };
+    flags.setColor(SkColorSetA(color, faint));
+    for (const SwitcherSpan& connector : line.connectors) {
+      canvas->DrawRect(
+          drawn(connector,
+                top + (kSwitcherSessionStroke - kSwitcherSessionConnector) /
+                          2.0f,
+                kSwitcherSessionConnector),
+          flags);
+    }
+    flags.setColor(color);
+    for (const SwitcherSpan& segment : line.segments) {
+      canvas->DrawRoundRect(drawn(segment, top, kSwitcherSessionStroke),
+                            kSwitcherSessionStroke / 2.0f, flags);
+    }
+  }
+}
