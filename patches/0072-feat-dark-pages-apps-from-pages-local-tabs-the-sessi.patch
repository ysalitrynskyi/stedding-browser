+// BACKLOG S-232 (folders F7): in the open sidebar, rows dragged the
+// pointer's way from above a folder onto its header -- moves in steps, the
+// window laying out between two -- join the folder, the header lit under
+// them until the drop: one row, and a selection of two. The drag's reorder
+// used to move the rows past the whole folder at the drag's first step, the
+// folder slid up into their place, and the drop landed beside it. The
+// reorder still takes a row across a folder once the pointer has crossed
+// the folder: a row dragged on below the folder lands after it, and one
+// dragged up past the header lands before it, neither of them in it.
+IN_PROC_BROWSER_TEST_F(TabDropTest, RowsFromAboveJoinTheFolderAtItsHeader) {
+  // The window's first tab stays above the folder throughout.
+  tabs::TabInterface* const first = tab_strip_model()->GetActiveTab();
+  ASSERT_TRUE(first);
+  tabs::TabInterface* const a = Open("a-from-above.test");
+  tabs::TabInterface* const b = Open("b-from-above.test");
+  tabs::TabInterface* const c = Open("c-from-above.test");
+  tabs::TabInterface* const past = Open("past-from-above.test");
+  tabs::TabInterface* const f1 = Open("f1-from-above.test");
+  tabs::TabInterface* const below = Open("below-from-above.test");
+  tabs::TabInterface* const up = Open("up-from-above.test");
+  // The folder is made once every tab is open: a tab opened while the
+  // folder's last tab is active lands inside the folder (folders F25).
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({Index(f1)});
+  ASSERT_TRUE(folder);
+  ASSERT_FALSE(IsIn(below, folder));
+  ASSERT_FALSE(IsIn(up, folder));
+  ASSERT_FALSE(vertical_tab_strip_state_controller()->IsCollapsed());
+  ASSERT_TRUE(ShownWhole({first, a, b, c, past, f1, below, up}))
+      << "the window is too short for the test's rows";
+
+  {
+    SCOPED_TRACE("a row from above joins at the header");
+    const Kept kept = KeptOf(a);
+    const gfx::Point to = HeaderCentre(folder);
+    PointerPressAndMove(RowCentre(a), to);
+    EXPECT_TRUE(HeaderLit(folder))
+        << "the header is not lit under the row: the drag moved the folder "
+           "away from the pointer";
+    Release(to);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return IsIn(a, folder); }))
+        << "the row from above did not join the folder";
+    ExpectKept(a, kept);
+    EXPECT_FALSE(HeaderLit(folder)) << "the header stays lit after the drop";
+    EXPECT_EQ(1u, WindowCount()) << "a window tore off";
+  }
+
+  {
+    SCOPED_TRACE("two selected rows from above join together");
+    tab_strip_model()->ActivateTabAt(Index(b));
+    tab_strip_model()->SelectTabAt(Index(c));
+    ASSERT_EQ(2u, tab_strip_model()->selection_model().size());
+    const gfx::Point to = HeaderCentre(folder);
+    PointerPressAndMove(RowCentre(b), to);
+    EXPECT_TRUE(HeaderLit(folder)) << "the header is not lit under the rows";
+    Release(to);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return IsIn(b, folder) && IsIn(c, folder);
+    })) << "not all of the selection joined the folder";
+    EXPECT_EQ(1u, WindowCount()) << "a window tore off";
+  }
+
+  {
+    SCOPED_TRACE("a row dragged on past the header lands after the folder");
+    PointerDrag(RowCentre(past), RowCentre(below));
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_FALSE(IsIn(past, folder)) << "a drop below the folder joined it";
+    for (tabs::TabInterface* const inside : {f1, a, b, c}) {
+      EXPECT_LT(Index(inside), Index(past))
+          << "the row stayed above the folder";
+    }
+  }
+
+  {
+    SCOPED_TRACE("a row dragged up past the header lands before the folder");
+    PointerDrag(RowCentre(up), RowCentre(first));
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_FALSE(IsIn(up, folder)) << "a drop above the folder joined it";
+    EXPECT_LT(Index(up), Index(f1)) << "the row stayed below the folder";
+  }
+}
