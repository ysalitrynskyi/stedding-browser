@@ -0,0 +1,232 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/space_model.h"
+
+#include <string>
+
+#include "components/tabs/public/mock_tab_interface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+namespace {
+
+constexpr SkColor kRed = SkColorSetRGB(0xFF, 0x00, 0x00);
+constexpr SkColor kBlue = SkColorSetRGB(0x00, 0x00, 0xFF);
+
+TEST(SpaceModelTest, StartsWithExactlyOneActiveSpace) {
+  SpaceModel model;
+  EXPECT_EQ(1u, model.size());
+  ASSERT_TRUE(model.active_space());
+  EXPECT_EQ(model.active_space()->id(), model.active_id());
+}
+
+TEST(SpaceModelTest, AddsAndFindsSpaces) {
+  SpaceModel model;
+  Space* work = model.AddSpace("Work", kRed);
+  ASSERT_TRUE(work);
+  EXPECT_EQ(2u, model.size());
+  EXPECT_EQ(work, model.GetSpace(work->id()));
+  EXPECT_EQ("Work", work->name());
+  EXPECT_EQ(kRed, work->color());
+}
+
+TEST(SpaceModelTest, DistinctSpacesGetDistinctIds) {
+  SpaceModel model;
+  EXPECT_NE(model.AddSpace("A", kRed)->id(), model.AddSpace("B", kBlue)->id());
+}
+
+TEST(SpaceModelTest, ActivatingChangesActiveId) {
+  SpaceModel model;
+  const SpaceId original = model.active_id();
+  Space* other = model.AddSpace("Other", kBlue);
+  model.SetActiveSpace(other->id());
+  EXPECT_EQ(other->id(), model.active_id());
+  EXPECT_NE(original, model.active_id());
+}
+
+// A window must always have somewhere for its tabs to be, so these two removals
+// are refused rather than half-handled.
+TEST(SpaceModelTest, RefusesToRemoveTheLastSpace) {
+  SpaceModel model;
+  EXPECT_FALSE(model.RemoveSpace(model.active_id()));
+  EXPECT_EQ(1u, model.size());
+}
+
+TEST(SpaceModelTest, RefusesToRemoveTheActiveSpace) {
+  SpaceModel model;
+  model.AddSpace("Other", kBlue);
+  EXPECT_FALSE(model.RemoveSpace(model.active_id()));
+  EXPECT_EQ(2u, model.size());
+}
+
+TEST(SpaceModelTest, RemovesAnInactiveSpace) {
+  SpaceModel model;
+  Space* other = model.AddSpace("Other", kBlue);
+  const SpaceId id = other->id();
+  EXPECT_TRUE(model.RemoveSpace(id));
+  EXPECT_EQ(1u, model.size());
+  EXPECT_FALSE(model.GetSpace(id));
+}
+
+TEST(SpaceModelTest, RenameAndRecolour) {
+  SpaceModel model;
+  Space* space = model.AddSpace("Old", kRed);
+  model.SetSpaceName(space->id(), "New");
+  model.SetSpaceColor(space->id(), kBlue);
+  EXPECT_EQ("New", space->name());
+  EXPECT_EQ(kBlue, space->color());
+}
+
+class CountingObserver : public SpaceModel::Observer {
+ public:
+  void OnSpaceAdded(const SpaceId& id) override { ++added; }
+  void OnSpaceRemoved(const SpaceId& id) override { ++removed; }
+  void OnActiveSpaceChanged(const SpaceId& from, const SpaceId& to) override {
+    ++activated;
+  }
+  int added = 0;
+  int removed = 0;
+  int activated = 0;
+};
+
+TEST(SpaceModelTest, NotifiesObservers) {
+  SpaceModel model;
+  CountingObserver observer;
+  model.AddObserver(&observer);
+
+  Space* space = model.AddSpace("Work", kRed);
+  EXPECT_EQ(1, observer.added);
+
+  model.SetActiveSpace(space->id());
+  EXPECT_EQ(1, observer.activated);
+
+  // Re-activating the same Space is not a change and must not notify.
+  model.SetActiveSpace(space->id());
+  EXPECT_EQ(1, observer.activated);
+
+  model.RemoveObserver(&observer);
+}
+
+
+// Tab membership. Spaces filter one tab strip (ADR 0015), so which Space a tab
+// belongs to is a fact this model owns.
+
+TEST(SpaceModelTest, TabJoinsTheActiveSpaceTheFirstTimeItIsAsked) {
+  SpaceModel model;
+  tabs::MockTabInterface tab;
+  EXPECT_EQ(model.active_id(), model.SpaceForTab(&tab));
+}
+
+TEST(SpaceModelTest, TabStaysInItsSpaceWhenTheActiveSpaceChanges) {
+  SpaceModel model;
+  tabs::MockTabInterface tab;
+  const SpaceId home = model.SpaceForTab(&tab);
+
+  Space* const work = model.AddSpace("Work", kRed);
+  model.SetActiveSpace(work->id());
+
+  EXPECT_EQ(home, model.SpaceForTab(&tab))
+      << "switching Space must not move tabs between Spaces";
+  EXPECT_FALSE(model.IsTabInActiveSpace(&tab));
+
+  model.SetActiveSpace(home);
+  EXPECT_TRUE(model.IsTabInActiveSpace(&tab));
+}
+
+TEST(SpaceModelTest, NewTabsJoinWhicheverSpaceIsActive) {
+  SpaceModel model;
+  Space* const work = model.AddSpace("Work", kRed);
+  model.SetActiveSpace(work->id());
+
+  tabs::MockTabInterface tab;
+  EXPECT_EQ(work->id(), model.SpaceForTab(&tab));
+  EXPECT_TRUE(model.IsTabInActiveSpace(&tab));
+}
+
+TEST(SpaceModelTest, MovesATabBetweenSpaces) {
+  SpaceModel model;
+  tabs::MockTabInterface tab;
+  model.SpaceForTab(&tab);
+
+  Space* const work = model.AddSpace("Work", kRed);
+  model.SetSpaceForTab(&tab, work->id());
+
+  EXPECT_EQ(work->id(), model.SpaceForTab(&tab));
+  EXPECT_FALSE(model.IsTabInActiveSpace(&tab));
+}
+
+TEST(SpaceModelTest, RefusesToMoveATabToASpaceThatDoesNotExist) {
+  SpaceModel model;
+  tabs::MockTabInterface tab;
+  const SpaceId home = model.SpaceForTab(&tab);
+
+  model.SetSpaceForTab(&tab, SpaceId::GenerateNew());
+
+  EXPECT_EQ(home, model.SpaceForTab(&tab));
+}
+
+TEST(SpaceModelTest, ATabTheModelHasNeverSeenIsVisible) {
+  SpaceModel model;
+  tabs::MockTabInterface stranger;
+  // A window whose tabs predate Spaces must not blink out of existence.
+  EXPECT_TRUE(model.IsTabInActiveSpace(&stranger));
+  EXPECT_TRUE(model.IsTabInActiveSpace(nullptr));
+}
+
+
+// Persistence. Spaces are written into the session so they survive a restart;
+// see ADR 0015.
+
+TEST(SpaceModelTest, SurvivesASerializeRestoreRoundTrip) {
+  SpaceModel written;
+  Space* const work = written.AddSpace("Work", kRed);
+  written.SetSpaceIcon(work->id(), "\xF0\x9F\x92\xBC");
+  written.AddSpace("Play", kBlue);
+  written.SetActiveSpace(work->id());
+
+  SpaceModel read;
+  read.RestoreFrom(written.Serialize());
+
+  ASSERT_EQ(written.size(), read.size());
+  EXPECT_EQ(written.active_id(), read.active_id());
+  for (size_t i = 0; i < written.size(); ++i) {
+    EXPECT_EQ(written.spaces()[i]->id(), read.spaces()[i]->id());
+    EXPECT_EQ(written.spaces()[i]->name(), read.spaces()[i]->name());
+    EXPECT_EQ(written.spaces()[i]->icon(), read.spaces()[i]->icon());
+    EXPECT_EQ(written.spaces()[i]->color(), read.spaces()[i]->color());
+  }
+}
+
+TEST(SpaceModelTest, RestoreFromNonsenseLeavesTheWindowUsable) {
+  // A session written by another version must not leave a window with no
+  // Space at all.
+  for (const char* data : {"", "not json", "{}", R"({"spaces":[]})",
+                           R"({"spaces":[{"id":"nonsense"}]})"}) {
+    SpaceModel model;
+    const SpaceId original = model.active_id();
+    model.RestoreFrom(data);
+    EXPECT_EQ(1u, model.size()) << "input: " << data;
+    EXPECT_EQ(original, model.active_id()) << "input: " << data;
+  }
+}
+
+TEST(SpaceModelTest, RestoreFallsBackWhenTheActiveSpaceIsUnknown) {
+  // A session naming an active Space that is not in its own list must still
+  // leave the window pointing at something.
+  const std::string first = SpaceId::GenerateNew().ToString();
+  const std::string stray = SpaceId::GenerateNew().ToString();
+  const std::string data = R"({"spaces":[{"id":")" + first +
+                           R"(","name":"Work","icon":"","color":0}],)" +
+                           R"("active":")" + stray + R"("})";
+
+  SpaceModel model;
+  model.RestoreFrom(data);
+
+  ASSERT_EQ(1u, model.size());
+  EXPECT_EQ(model.spaces().front()->id(), model.active_id());
+}
+
+}  // namespace
+}  // namespace spaces
diff --git a/chrome/browser/ui/spaces/space_model_window_unittest.cc b/chrome/browser/ui/spaces/space_model_window_unittest.cc
new file mode 100644
index 0000000000000..78a9cfed94856
--- /dev/null
+++ b/chrome/browser/ui/spaces/space_model_window_unittest.cc
@@ -0,0 +1,283 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Behaviour tests for Spaces against a real Browser and TabStripModel. Each
+// test names the behaviour id from docs/features/spaces.md it proves. The
+// model-only tests live in space_model_unittest.cc; these are the ones that
+// need a window, because they are about what the user sees and what happens
+// to the active tab.
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/tabs/tab_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+constexpr SkColor kBlue = SkColorSetRGB(0x00, 0x00, 0xFF);
+
+class SpaceWindowTest : public BrowserWithTestWindowTest {
+ protected:
+  SpaceModel& model() {
+    SpaceModel* const model = SpaceModel::From(browser());
+    CHECK(model) << "a normal window must own a SpaceModel";
+    return *model;
+  }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+
+  // Opens a tab the way the fixture does (foreground, index 0) and returns it.
+  tabs::TabInterface* OpenTab() {
+    AddTab(browser(), GURL("https://example.com/"));
+    return tabs().GetActiveTab();
+  }
+
+  // Inserts a tab that carries session restore data, as a restored tab does.
+  // TabModel's constructor attaches the tab helpers, the same as in the real
+  // restore path.
+  tabs::TabInterface* RestoreTab(const std::string& space_id) {
+    std::unique_ptr<content::WebContents> contents =
+        content::WebContents::Create(
+            content::WebContents::CreateParams(profile()));
+    TabSpaceRestoreData::CreateForWebContents(contents.get(), space_id,
+                                              /*space_pinned=*/false);
+    tabs().AppendTab(
+        std::make_unique<tabs::TabModel>(std::move(contents), &tabs()),
+        /*foreground=*/true);
+    return tabs().GetActiveTab();
+  }
+
+  std::vector<tabs::TabInterface*> TabsIn(const SpaceId& id) {
+    std::vector<tabs::TabInterface*> out;
+    for (int i = 0; i < tabs().count(); ++i) {
+      tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+      if (model().SpaceForTab(tab) == id) {
+        out.push_back(tab);
+      }
+    }
+    return out;
+  }
+};
+
+// B1
+TEST_F(SpaceWindowTest, NewTabJoinsTheActiveSpace) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  EXPECT_EQ(home, model().SpaceForTab(a));
+
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const b = OpenTab();
+  EXPECT_EQ(work->id(), model().SpaceForTab(b));
+  EXPECT_EQ(home, model().SpaceForTab(a)) << "opening in Work must not move a";
+}
+
+// B1
+TEST_F(SpaceWindowTest, ATabIsVisibleOnlyInItsSpace) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const b = OpenTab();
+
+  EXPECT_FALSE(model().IsTabInActiveSpace(a));
+  EXPECT_TRUE(model().IsTabInActiveSpace(b));
+  EXPECT_TRUE(tabs().IsTabHidden(tabs().GetIndexOfTab(a)))
+      << "the tab strip must agree that a is hidden in Work";
+
+  model().SetActiveSpace(home);
+  EXPECT_TRUE(model().IsTabInActiveSpace(a));
+  EXPECT_FALSE(model().IsTabInActiveSpace(b));
+}
+
+// B2
+TEST_F(SpaceWindowTest, RestoredTabReturnsToItsSpace) {
+  const SpaceId home = model().active_id();
+  Space* const work = model().AddSpace("Work", kBlue);
+  // The window is looking at Home; the restored tab says it was in Work.
+  ASSERT_EQ(home, model().active_id());
+  tabs::TabInterface* const restored = RestoreTab(work->id().ToString());
+  EXPECT_EQ(work->id(), model().SpaceForTab(restored));
+}
+
+// B2
+TEST_F(SpaceWindowTest, RestoredTabWhoseSpaceIsGoneJoinsTheActiveSpace) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const restored =
+      RestoreTab(SpaceId::GenerateNew().ToString());
+  EXPECT_EQ(home, model().SpaceForTab(restored));
+  EXPECT_TRUE(model().IsTabInActiveSpace(restored))
+      << "a tab whose Space is gone must not vanish";
+}
+
+// B3
+TEST_F(SpaceWindowTest, SwitchingActivatesATabInTheTargetSpace) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  // Work was empty, so the switch opened a tab there (see the next test);
+  // b is a second tab in Work and the one the user is on.
+  tabs::TabInterface* const opened = tabs().GetActiveTab();
+  tabs::TabInterface* const b = OpenTab();
+  ASSERT_EQ(b, tabs().GetActiveTab());
+  ASSERT_EQ(3, tabs().count());
+
+  model().SetActiveSpace(home);
+  EXPECT_EQ(a, tabs().GetActiveTab())
+      << "the content pane must show a tab from the Space the sidebar shows";
+
+  model().SetActiveSpace(work->id());
+  EXPECT_EQ(b, tabs().GetActiveTab())
+      << "coming back lands on the tab the user left, not the first in order";
+  EXPECT_NE(opened, tabs().GetActiveTab());
+  EXPECT_EQ(3, tabs().count()) << "switching between populated Spaces opens nothing";
+}
+
+// B3
+TEST_F(SpaceWindowTest, SwitchingToAnEmptySpaceOpensANewTabThere) {
+  tabs::TabInterface* const a = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+
+  ASSERT_EQ(2, tabs().count());
+  tabs::TabInterface* const active = tabs().GetActiveTab();
+  EXPECT_NE(a, active);
+  EXPECT_EQ(work->id(), model().SpaceForTab(active));
+  EXPECT_TRUE(model().IsTabInActiveSpace(active));
+}
+
+// B4
+TEST_F(SpaceWindowTest, ClosingTheLastTabOfASpaceOpensANewTabThere) {
+  tabs::TabInterface* const a = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  ASSERT_EQ(2, tabs().count());
+  tabs::TabInterface* const only_in_work = tabs().GetActiveTab();
+  ASSERT_EQ(work->id(), model().SpaceForTab(only_in_work));
+
+  tabs().CloseWebContentsAt(tabs().GetIndexOfTab(only_in_work),
+                            TabCloseTypes::CLOSE_USER_GESTURE);
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(work->id(), model().active_id()) << "closing a tab is not a switch";
+  ASSERT_EQ(2, tabs().count()) << "a replacement tab must open";
+  tabs::TabInterface* const active = tabs().GetActiveTab();
+  EXPECT_NE(a, active) << "the active tab must not be one from another Space";
+  EXPECT_EQ(work->id(), model().SpaceForTab(active));
+}
+
+// B5
+TEST_F(SpaceWindowTest, DeletingASpaceMovesItsTabsToTheActiveSpace) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  const SpaceId work_id = work->id();
+  model().SetActiveSpace(work_id);
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  model().SetActiveSpace(home);
+  // a in Home; the tab the switch opened plus b and c in Work.
+  const int before = tabs().count();
+  ASSERT_EQ(4, before);
+  ASSERT_EQ(3u, TabsIn(work_id).size());
+
+  ASSERT_TRUE(model().RemoveSpace(work_id));
+  EXPECT_EQ(before, tabs().count()) << "deleting a Space must not close tabs";
+  EXPECT_EQ(home, model().SpaceForTab(a));
+  EXPECT_EQ(home, model().SpaceForTab(b));
+  EXPECT_EQ(home, model().SpaceForTab(c));
+  EXPECT_TRUE(model().IsTabInActiveSpace(b));
+  EXPECT_TRUE(model().IsTabInActiveSpace(c));
+  EXPECT_EQ(4u, TabsIn(home).size());
+}
+
+// B6
+TEST_F(SpaceWindowTest, EssentialsTabsAreInEverySpace) {
+  tabs::TabInterface* const essential = OpenTab();
+  tabs().SetTabPinned(tabs().GetIndexOfTab(essential), true);
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+
+  EXPECT_TRUE(model().IsTabInActiveSpace(essential));
+  EXPECT_EQ(1, tabs().count())
+      << "an essentials tab counts as visible, so no new tab is needed";
+  EXPECT_EQ(essential, tabs().GetActiveTab());
+}
+
+// B7
+TEST_F(SpaceWindowTest, NextTabSkipsOtherSpaces) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const b = OpenTab();
+  model().SetActiveSpace(home);
+  tabs::TabInterface* const c = OpenTab();
+  // The fixture inserts at index 0, so the strip reads c, b, a.
+  ASSERT_EQ(c, tabs().GetTabAtIndex(0));
+  ASSERT_EQ(b, tabs().GetTabAtIndex(1));
+  ASSERT_EQ(a, tabs().GetTabAtIndex(2));
+  ASSERT_EQ(c, tabs().GetActiveTab());
+
+  tabs().SelectNextTab();
+  EXPECT_EQ(a, tabs().GetActiveTab()) << "b is in Work and must be skipped";
+  tabs().SelectNextTab();
+  EXPECT_EQ(c, tabs().GetActiveTab());
+  tabs().SelectPreviousTab();
+  EXPECT_EQ(a, tabs().GetActiveTab());
+}
+
+// B8
+TEST_F(SpaceWindowTest, MovingATabNotifiesObservers) {
+  class Recorder : public SpaceModel::Observer {
+   public:
+    void OnTabSpaceChanged(tabs::TabInterface* tab) override {
+      moved.push_back(tab);
+    }
+    std::vector<tabs::TabInterface*> moved;
+  };
+
+  tabs::TabInterface* const a = OpenTab();
+  Space* const work = model().AddSpace("Work", kBlue);
+  Recorder recorder;
+  model().AddObserver(&recorder);
+  model().SetSpaceForTab(a, work->id());
+  model().RemoveObserver(&recorder);
+
+  ASSERT_EQ(1u, recorder.moved.size());
+  EXPECT_EQ(a, recorder.moved[0]);
+  EXPECT_FALSE(model().IsTabInActiveSpace(a));
+}
+
+
+// B14: popup windows have no Spaces. The fixture builds the popup the way
+// TestWithBrowserView does for hosted apps: through its typed constructor,
+// not by constructing a second Browser by hand.
+class PopupSpaceTest : public BrowserWithTestWindowTest {
+ public:
+  PopupSpaceTest() : BrowserWithTestWindowTest(Browser::TYPE_POPUP) {}
+};
+
+TEST_F(PopupSpaceTest, PopupWindowsHaveNoSpaces) {
+  EXPECT_EQ(nullptr, SpaceModel::From(browser()));
+  // Tabs still come and go without a model to observe them.
+  AddTab(browser(), GURL("https://example.com/"));
+  EXPECT_EQ(1, browser()->tab_strip_model()->count());
+  EXPECT_EQ(nullptr, SpaceModel::From(browser()));
+}
+}  // namespace
+}  // namespace spaces
