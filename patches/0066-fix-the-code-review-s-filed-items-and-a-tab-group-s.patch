+// came back (BACKLOG S-207).
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, UndoOfAFoldersLastTabStaysOutOfAGroup) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  OpenLoaded("a.test");
+  tabs::TabInterface* const b = OpenLoaded("b.test");
+  OpenLoaded("c.test");
+  OpenLoaded("d.test");
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({tab_strip_model()->GetIndexOfTab(b)});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Reading");
+  ClearClosedTabs();
+  stedding::ClosedTabsUndo* const undo =
+      stedding::ClosedTabsUndo::From(browser());
+  ASSERT_TRUE(undo);
+
+  // The folder's last tab, closed by the user: the folder goes with it.
+  tab_strip_model()->CloseWebContentsAt(
+      tab_strip_model()->GetIndexOfTab(b),
+      TabCloseTypes::CLOSE_USER_GESTURE |
+          TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  ASSERT_EQ(4, tab_strip_model()->count());
+  // a, c and d make a group, which covers b's old index, 2.
+  tab_strip_model()->AddToNewGroup({1, 2, 3});
+
+  size_t back = 0;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    back = undo->Undo();
+    return back > 0;
+  })) << "the toast offered no undo";
+  EXPECT_EQ(1u, back);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return HostsInFolder("Reading", false) == "b.test "; }))
+      << "the folder did not come back";
+  for (int i = 0; i < tab_strip_model()->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(i);
+    if (tab->GetContents()->GetLastCommittedURL().host() == "b.test") {
+      EXPECT_FALSE(tab->GetGroup()) << "the tab joined the group";
+    }
+  }
+}
+
 }  // namespace
