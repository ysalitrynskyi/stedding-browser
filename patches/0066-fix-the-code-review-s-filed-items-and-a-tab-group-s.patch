diff --git a/chrome/test/stedding/shortcut_file_mac_browsertest.mm b/chrome/test/stedding/shortcut_file_mac_browsertest.mm
new file mode 100644
index 0000000000000..c0708f512e5cd
--- /dev/null
+++ b/chrome/test/stedding/shortcut_file_mac_browsertest.mm
@@ -0,0 +1,143 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A Chrome shortcut file (.crwebloc) opened from Finder opens its target the
+// way any address another app hands over opens: in a little window while the
+// setting is on and no route takes it (little E1), and otherwise as a tab in
+// the Space chosen for links from other apps (routing D3). The file's own
+// address was the one checked and marked, and the target became a tab in the
+// active Space (BACKLOG S-202).
+
+#import <Cocoa/Cocoa.h>
+
+#include <tuple>
+
+#include "base/files/file_path.h"
+#include "base/files/safe_base_name.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/test/run_until.h"
+#include "base/threading/thread_restrictions.h"
+#import "chrome/browser/app_controller_mac.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/shortcuts/chrome_webloc_file.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/little_window.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "net/base/apple/url_conversions.h"
+#include "net/base/filename_util.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "url/gurl.h"
+
+namespace {
+
+class ShortcutFileTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // The AppController is the application's delegate.
+    std::ignore = AppController.sharedController;
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+  }
+
+  // Writes a shortcut file to `target` for this profile and opens it the way
+  // Finder does.
+  void OpenShortcutFile(const GURL& target, const char* name) {
+    base::FilePath file;
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      file = dir_.GetPath().AppendASCII(name);
+      ASSERT_TRUE(shortcuts::ChromeWeblocFile(
+                      target, *base::SafeBaseName::Create(
+                                  browser()->GetProfile()->GetPath()))
+                      .SaveToFile(file));
+    }
+    [NSApp.delegate application:NSApp
+                       openURLs:@[ net::NSURLWithGURL(
+                                    net::FilePathToFileURL(file)) ]];
+  }
+
+  // The little window showing `url`, if one is open.
+  static BrowserWindowInterface* LittleWindowShowing(const GURL& url) {
+    BrowserWindowInterface* found = nullptr;
+    ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+        [&](BrowserWindowInterface* window) {
+          content::WebContents* const contents =
+              window->GetTabStripModel()
+                  ? window->GetTabStripModel()->GetActiveWebContents()
+                  : nullptr;
+          if (stedding::IsLittleWindow(window) && contents &&
+              contents->GetVisibleURL() == url) {
+            found = window;
+            return false;
+          }
+          return true;
+        });
+    return found;
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+IN_PROC_BROWSER_TEST_F(ShortcutFileTest, ItsTargetOpensAsALinkFromAnotherApp) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  const int count = tabs->count();
+  {
+    SCOPED_TRACE("little windows on: the target opens small");
+    prefs->SetBoolean(stedding::prefs::kLittleEnabled, true);
+    const GURL target = embedded_test_server()->GetURL("/title1.html");
+    OpenShortcutFile(target, "little.crwebloc");
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return LittleWindowShowing(target) != nullptr; }))
+        << "the shortcut's target opened as a tab, not a little window";
+    EXPECT_EQ(count, tabs->count());
+  }
+  {
+    SCOPED_TRACE("little windows off: the default Space for other apps");
+    prefs->SetBoolean(stedding::prefs::kLittleEnabled, false);
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model);
+    const spaces::SpaceId home = model->active_id();
+    spaces::Space* const mail = model->AddSpace("Mail", SK_ColorGREEN);
+    ASSERT_TRUE(mail);
+    const spaces::SpaceId mail_id = mail->id();
+    prefs->SetString(stedding::prefs::kExternalDefaultSpace,
+                     mail_id.ToString());
+    ASSERT_TRUE(model->SetActiveSpace(home));
+    const GURL target = embedded_test_server()->GetURL("/title2.html");
+    OpenShortcutFile(target, "tab.crwebloc");
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      for (int i = 0; i < tabs->count(); ++i) {
+        if (tabs->GetWebContentsAt(i)->GetVisibleURL() == target) {
+          return true;
+        }
+      }
+      return false;
+    }));
+    tabs::TabInterface* opened = nullptr;
+    for (int i = 0; i < tabs->count(); ++i) {
+      if (tabs->GetWebContentsAt(i)->GetVisibleURL() == target) {
+        opened = tabs->GetTabAtIndex(i);
+      }
+    }
+    ASSERT_TRUE(opened);
+    EXPECT_EQ(mail_id, model->SpaceForTab(opened))
+        << "the target stayed in the active Space";
+  }
+}
+
+}  // namespace
