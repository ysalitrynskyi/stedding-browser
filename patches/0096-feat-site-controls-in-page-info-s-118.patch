+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/site_controls.h"
+
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/spaces/isolation_mark.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// gtest wants every test of a suite on the same fixture.
+class SiteControlsRulesTest : public testing::Test {
+ protected:
+  // Work's session is on; Old's was turned off, its token kept (sessions
+  // S7).
+  const std::vector<SpaceJarEntry> spaces_ = {
+      {u"Home", "", false},
+      {u"Work", "5f0c2d1e9a7b4c3d", true},
+      {u"Old", "0a1b2c3d4e5f6a7b", false},
+  };
+};
+
+// site-controls Si1, Si7, Si8, Si9: a tab of a normal or private tabbed
+// window gets the controls, and nothing else does; the session row only
+// where the profile's Spaces are; Clear and Darken <site> only on a web page;
+// Darken <site> only while dark pages is on.
+TEST_F(SiteControlsRulesTest, WhichWindowsAndPagesGetWhichRows) {
+  const GURL web("https://www.example.com/a");
+  {
+    SCOPED_TRACE("popups, app windows, little windows, peeks, side panels");
+    const SiteControlsRows rows =
+        RowsFor({SiteControlsWindow::kOther, web, /*dark_pages_on=*/true});
+    EXPECT_FALSE(rows.strip);
+    EXPECT_FALSE(rows.session);
+    EXPECT_FALSE(rows.clear_data);
+    EXPECT_FALSE(rows.dark_switch);
+    EXPECT_FALSE(rows.dark_site);
+  }
+  {
+    SCOPED_TRACE("a tab of a window with Spaces");
+    const SiteControlsRows rows =
+        RowsFor({SiteControlsWindow::kTab, web, /*dark_pages_on=*/false});
+    EXPECT_TRUE(rows.strip);
+    EXPECT_TRUE(rows.session);
+    EXPECT_TRUE(rows.clear_data);
+    EXPECT_TRUE(rows.dark_switch);
+    EXPECT_FALSE(rows.dark_site) << "Darken <site> waits for the switch";
+    EXPECT_TRUE(RowsFor({SiteControlsWindow::kTab, web, /*dark_pages_on=*/true})
+                    .dark_site);
+  }
+  for (const SiteControlsWindow window :
+       {SiteControlsWindow::kPrivateTab,
+        SiteControlsWindow::kTabWithoutSpaces}) {
+    SCOPED_TRACE("a private window or a Blank Window");
+    const SiteControlsRows rows = RowsFor({window, web, true});
+    EXPECT_TRUE(rows.strip);
+    EXPECT_FALSE(rows.session) << "no Spaces, no jars to name (S32)";
+    EXPECT_TRUE(rows.clear_data);
+    EXPECT_TRUE(rows.dark_switch);
+    EXPECT_TRUE(rows.dark_site);
+  }
+  for (const char* spec :
+       {"data:text/html,<p>x</p>", "about:blank", "blob:https://a.test/0f6a"}) {
+    SCOPED_TRACE(spec);
+    const SiteControlsRows rows =
+        RowsFor({SiteControlsWindow::kTab, GURL(spec), true});
+    EXPECT_TRUE(rows.strip);
+    EXPECT_TRUE(rows.session);
+    EXPECT_FALSE(rows.clear_data) << "not a web page: no site to clear";
+    EXPECT_TRUE(rows.dark_switch);
+    EXPECT_FALSE(rows.dark_site) << "not a web page: no site to darken";
+  }
+}
+
+// site-controls Si7: the row names the jar the page lives in. The profile's
+// jar is the shared session; a Space's jar with its session on is that Space,
+// marked; one whose session was turned off is that Space's previous session,
+// unmarked, as S32 marks only a session that is on; a jar no Space names is
+// an independent session, unmarked.
+TEST_F(SiteControlsRulesTest, TheSessionIsTheJarThePageLivesIn) {
+  const SessionName shared = SessionNameFor(false, "", spaces_);
+  EXPECT_EQ(u"Shared session", shared.text);
+  EXPECT_FALSE(shared.marked);
+  EXPECT_EQ(shared, SessionNameFor(false, "5f0c2d1e9a7b4c3d", spaces_))
+      << "a jar that is not a Space's is the shared session, whatever it is "
+         "called";
+
+  const SessionName work = SessionNameFor(true, "5f0c2d1e9a7b4c3d", spaces_);
+  EXPECT_EQ(spaces::NameWithIsolationMark(u"Work"), work.text);
+  EXPECT_EQ(u"Work · Independent session", work.text);
+  EXPECT_TRUE(work.marked);
+
+  const SessionName old = SessionNameFor(true, "0a1b2c3d4e5f6a7b", spaces_);
+  EXPECT_EQ(u"Old · Previous independent session", old.text);
+  EXPECT_FALSE(old.marked) << "S32 marks only a session that is on";
+
+  const SessionName orphan = SessionNameFor(true, "ffffffffffffffff", spaces_);
+  EXPECT_EQ(spaces::IsolationMarkName(), orphan.text);
+  EXPECT_FALSE(orphan.marked);
+
+  EXPECT_FALSE(SessionNameFor(true, "", spaces_).marked)
+      << "Home's empty token names no jar";
+}
+
+// site-controls Si8: the question names the site and the jar its data goes
+// from, the same jar the session row names, and says the user is signed out.
+TEST_F(SiteControlsRulesTest, TheClearQuestionNamesTheSiteAndTheJar) {
+  const ClearSiteDataQuestion work = ClearSiteDataQuestionFor(
+      u"example.com", false, true, "5f0c2d1e9a7b4c3d", spaces_);
+  EXPECT_EQ(u"Clear data for example.com?", work.title);
+  EXPECT_EQ(u"Clear and Reload", work.action);
+  EXPECT_NE(std::u16string::npos, work.body.find(u"example.com"));
+  EXPECT_NE(std::u16string::npos, work.body.find(u"Work"));
+  EXPECT_NE(std::u16string::npos, work.body.find(u"signed out"));
+  EXPECT_NE(std::u16string::npos, work.body.find(u"permissions stay"));
+
+  const ClearSiteDataQuestion old = ClearSiteDataQuestionFor(
+      u"example.com", false, true, "0a1b2c3d4e5f6a7b", spaces_);
+  EXPECT_NE(std::u16string::npos, old.body.find(u"Old"))
+      << "the jar the page lives in, whether or not its session is on now";
+
+  const ClearSiteDataQuestion shared =
+      ClearSiteDataQuestionFor(u"example.com", false, false, "", spaces_);
+  EXPECT_NE(std::u16string::npos, shared.body.find(u"shared session"));
+  EXPECT_EQ(std::u16string::npos, shared.body.find(u"Work"));
+
+  const ClearSiteDataQuestion orphan = ClearSiteDataQuestionFor(
+      u"example.com", false, true, "ffffffffffffffff", spaces_);
+  EXPECT_NE(std::u16string::npos, orphan.body.find(u"independent session"));
+
+  const ClearSiteDataQuestion private_session =
+      ClearSiteDataQuestionFor(u"example.com", true, false, "", spaces_);
+  EXPECT_NE(std::u16string::npos,
+            private_session.body.find(u"private session"));
+  EXPECT_NE(std::u16string::npos, private_session.body.find(u"signed out"));
+}
+
+// site-controls Si6: camera and microphone are listed on a page that may ask
+// for them -- https, or http on this machine -- and nowhere else.
+TEST_F(SiteControlsRulesTest, CameraAndMicrophoneAreListedOnWebPagesOnly) {
+  const std::vector<ContentSettingsType> media = {
+      ContentSettingsType::MEDIASTREAM_CAMERA,
+      ContentSettingsType::MEDIASTREAM_MIC};
+  EXPECT_EQ(media, AlwaysListedPermissions(GURL("https://example.com/")));
+  EXPECT_EQ(media, AlwaysListedPermissions(GURL("http://localhost:8080/")));
+  EXPECT_EQ(media, AlwaysListedPermissions(GURL("http://127.0.0.1/x")));
+  for (const char* spec :
+       {"http://example.com/", "file:///tmp/a.html", "data:text/html,x",
+        "about:blank", "chrome://settings/", "not a url"}) {
+    EXPECT_TRUE(AlwaysListedPermissions(GURL(spec)).empty()) << spec;
+  }
+}
+
+}  // namespace
+}  // namespace stedding
