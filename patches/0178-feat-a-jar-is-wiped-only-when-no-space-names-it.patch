+// sessions S38 (ADR 0032): two Spaces of one session put their tabs in one
+// partition; a third does not.
+TEST_F(SharedSessionWindowTest, TwoSpacesOfASessionShareAPartition) {
+  const SpaceId home = model().active_id();
+  const SpaceId mail = model().AddSpace("Mail", kBlue)->id();
+  const SpaceId docs = model().AddSpace("Docs", kBlue)->id();
+  const SpaceId alone = model().AddSpace("Alone", kBlue)->id();
+  const std::string jar = ShareSession(mail, docs);
+  model().SetSpaceIsolated(alone, true);
+
+  const auto in_mail = PartitionOf(OpenTabIn(mail));
+  const auto in_docs = PartitionOf(OpenTabIn(docs));
+  EXPECT_EQ(jar, in_mail.partition_name());
+  EXPECT_EQ(in_mail, in_docs);
+  EXPECT_NE(in_mail, PartitionOf(OpenTabIn(alone)));
+  EXPECT_FALSE(IsSpaceStoragePartition(PartitionOf(OpenTabIn(home))));
+  EXPECT_EQ(jar, model().SessionOf(docs));
+  EXPECT_TRUE(model().SpacesShareSession(mail, docs));
+  EXPECT_FALSE(model().SpacesShareSession(mail, alone));
+  EXPECT_FALSE(model().SpacesShareSession(mail, home));
+  EXPECT_TRUE(model().SpacesShareSession(home, home));
+}
