 // page (H13), else the page.
 GURL PinnedSiteFor(BrowserWindowInterface* browser, tabs::TabInterface* tab);
 
+// H15: "Edit Pinned Address" saves `home` as the pin's home, written to the
+// session (H2), and loads it in the pin at once, as Reset to Pinned Page does;
+// the selection and the active tab stay. Works on a pin of either tier, one
+// without a web home (H13) included. Returns false with nothing changed when
+// `home` is no web page, the window has no Spaces, or the tab is not a pin.
+bool SetHomeAndGo(BrowserWindowInterface* browser,
+                  tabs::TabInterface* tab,
+                  const GURL& home);
+
+// What a middle click on a sidebar row does (H16).
+enum class MiddleClickAction {
+  // Close the tab, as Chromium does: the row is not a pin.
+  kClose,
+  // Load the pin's home, as Reset to Pinned Page does; never close it.
+  kGoHome,
+  // Nothing: a pin without a web home (H13), a pin in a window without
+  // Spaces, or no tab.
+  kNothing,
+};
+MiddleClickAction MiddleClickActionFor(BrowserWindowInterface* browser,
+                                       const tabs::TabInterface* tab);
+
 }  // namespace stedding
 
 #endif  // CHROME_BROWSER_UI_STEDDING_PIN_LIFECYCLE_H_
