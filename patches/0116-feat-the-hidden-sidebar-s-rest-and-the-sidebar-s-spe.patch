diff --git a/chrome/browser/ui/stedding/motion.cc b/chrome/browser/ui/stedding/motion.cc
index 92b8bb0c314a7..13565d5398187 100644
--- a/chrome/browser/ui/stedding/motion.cc
+++ b/chrome/browser/ui/stedding/motion.cc
@@ -24,6 +24,24 @@ bool ShouldAnimate(const PrefService* prefs) {
   return !prefs || prefs->GetBoolean(prefs::kUiAnimate);
 }
 
+double SidebarMotionScale(const PrefService* prefs) {
+  if (!prefs) {
+    return 1.0;
+  }
+  switch (prefs->GetInteger(prefs::kSidebarAnimationSpeed)) {
+    case prefs::kSidebarAnimationFast:
+      return 0.5;
+    case prefs::kSidebarAnimationInstant:
+      return 0.0;
+    default:
+      return 1.0;
+  }
+}
+
+bool ShouldAnimateSidebar(const PrefService* prefs) {
+  return ShouldAnimate(prefs) && SidebarMotionScale(prefs) > 0.0;
+}
