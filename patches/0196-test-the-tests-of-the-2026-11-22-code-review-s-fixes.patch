+using tabs::VerticalTabStripCollapseState;
+
+// Runs the loop for `delay`, so a timer due in that time has its turn.
+void RunForW2B26(base::TimeDelta delay) {
+  base::RunLoop loop;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, loop.QuitClosure(), delay);
+  loop.Run();
+}
+
+std::string DescribeW2B26(const std::vector<VerticalTabStripCollapseState>&
+                              states) {
+  std::string text;
+  for (const VerticalTabStripCollapseState state : states) {
+    switch (state) {
+      case VerticalTabStripCollapseState::kCollapsed:
+        base::StrAppend(&text, {" collapsed"});
+        break;
+      case VerticalTabStripCollapseState::kCollapsing:
+        base::StrAppend(&text, {" collapsing"});
+        break;
+      case VerticalTabStripCollapseState::kExpanded:
+        base::StrAppend(&text, {" expanded"});
+        break;
+    }
+  }
+  return text.empty() ? " nothing" : text;
+}
+
+// Whether the watchers heard the sidebar collapsing before they heard it
+// collapsed.
+testing::AssertionResult CollapsingThenCollapsedW2B26(
+    const std::vector<VerticalTabStripCollapseState>& heard) {
+  const auto collapsing = std::find(heard.begin(), heard.end(),
+                                    VerticalTabStripCollapseState::kCollapsing);
+  const auto collapsed = std::find(heard.begin(), heard.end(),
+                                   VerticalTabStripCollapseState::kCollapsed);
+  if (collapsing != heard.end() && collapsed != heard.end() &&
+      collapsing < collapsed) {
+    return testing::AssertionSuccess();
+  }
+  return testing::AssertionFailure()
+         << "the watchers heard" << DescribeW2B26(heard);
+}
+
+class SidebarStatesW2B26Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* window() { return browser_view()->GetWidget(); }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  tabs::VerticalTabStripStateController* controller() {
+    return vertical_tab_strip_state_controller();
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  bool Animating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+  // Waits until the sidebar has come to rest open, or closed.
+  [[nodiscard]] bool Settled(bool collapsed) {
+    return base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(window());
+      return !Animating() && controller()->IsCollapsed() == collapsed;
+    });
+  }
+  ui::MouseEvent MouseEventAtTheStrip(ui::EventType type) {
+    const gfx::Point centre = region()->GetLocalBounds().CenterPoint();
+    return ui::MouseEvent(type, centre, centre, base::TimeTicks::Now(),
+                          ui::EF_NONE, ui::EF_NONE);
+  }
+};
+
+// P34-1c, sidebar panels Pn4: ⌘S with the History panel open closes the
+// panel, then the sidebar, and the strip's watchers -- the rows, the
+// containers, the strip's own margins -- hear that it is collapsing as the
+// motion starts, as they do on a plain ⌘S. The collapse that waited for the
+// panel to go started its motion without a word to them, and they all kept
+// the open form until it ended.
+IN_PROC_BROWSER_TEST_F(SidebarStatesW2B26Test,
+                       CmdSWithAPanelOpenTellsTheWatchersItIsCollapsing) {
+  // A remote desktop session, as the PC's runs are, turns rich animations
+  // off, and a collapse with no motion has no collapsing step to hear.
+  const auto rich_animations =
+      gfx::AnimationTestApi::SetRichAnimationRenderMode(
+          gfx::Animation::RichAnimationRenderMode::FORCE_ENABLED);
+  const auto full_motion =
+      gfx::AnimationTestApi::SetPrefersReducedMotionForTesting(false);
+  prefs()->SetBoolean(stedding::prefs::kUiAnimate, true);
+  prefs()->SetInteger(stedding::prefs::kSidebarAnimationSpeed,
+                      stedding::prefs::kSidebarAnimationNormal);
+  prefs()->SetBoolean(stedding::prefs::kSidebarLibraryPanels, true);
+  ASSERT_TRUE(Settled(/*collapsed=*/false));
+
+  std::vector<VerticalTabStripCollapseState> heard;
+  const base::CallbackListSubscription subscription =
+      controller()->RegisterOnCollapseChanged(base::BindLambdaForTesting(
+          [&](VerticalTabStripCollapseState state) {
+            heard.push_back(state);
+          }));
+
+  {
+    SCOPED_TRACE("no panel");
+    heard.clear();
+    ASSERT_TRUE(
+        chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS_COLLAPSE));
+    ASSERT_TRUE(Settled(/*collapsed=*/true));
+    EXPECT_TRUE(CollapsingThenCollapsedW2B26(heard));
+    ASSERT_TRUE(
+        chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS_COLLAPSE));
+    ASSERT_TRUE(Settled(/*collapsed=*/false));
+  }
+  {
+    SCOPED_TRACE("the History panel open");
+    stedding::SidebarPanels* const panels =
+        stedding::SidebarPanels::From(browser());
+    ASSERT_TRUE(panels);
+    ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(window());
+      return panels->open() == stedding::SidebarPanel::kHistory &&
+             region()->sidebar_panel_view_for_testing() != nullptr;
+    })) << "the History panel did not open in the sidebar";
+    heard.clear();
+    ASSERT_TRUE(
+        chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS_COLLAPSE));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(window());
+      return panels->open() == stedding::SidebarPanel::kNone &&
+             region()->sidebar_panel_view_for_testing() == nullptr;
+    })) << "the panel stayed";
+    ASSERT_TRUE(Settled(/*collapsed=*/true)) << "the sidebar stayed open";
+    EXPECT_TRUE(CollapsingThenCollapsedW2B26(heard));
+  }
+}
+
+// P34-1a, sidebar Y11: a lock that holds the rail closed -- the omnibox's
+// popup takes one -- ends the pause that was running when it came. The
+// pause had gone on, and opened the rail over the page under the lock once
+// it ran out; released, the lock leaves a pointer still on the rail its
+// pause again.
+IN_PROC_BROWSER_TEST_F(SidebarStatesW2B26Test,
+                       AForceCollapseLockEndsTheRailsPause) {
+  AppendTab();
+  prefs()->SetInteger(stedding::prefs::kSidebarClosedForm,
+                      stedding::prefs::kSidebarClosedToIcons);
+  prefs()->SetInteger(stedding::prefs::kSidebarHoverDelayMs, 250);
+  controller()->SetExpandOnHoverEnabled(true);
+  stedding::test::PointerStandIn pointer(region());
+  controller()->RequestCollapse(true);
+  ASSERT_TRUE(Settled(/*collapsed=*/true));
+  ASSERT_FALSE(region()->IsHiddenCompletely());
+  ASSERT_FALSE(region()->is_expanded_on_hover());
+
+  // The pointer comes to rest on the rail: its pause starts.
+  pointer.On();
+  region()->OnMouseEntered(MouseEventAtTheStrip(ui::EventType::kMouseEntered));
+  region()->OnMouseMoved(MouseEventAtTheStrip(ui::EventType::kMouseMoved));
+  ASSERT_FALSE(region()->is_expanded_on_hover()) << "opened before the pause";
+  {
+    const std::unique_ptr<ExpandOnHoverLock> lock =
+        region()->GetExpandOnHoverLock(ExpandOnHoverLockType::kForceCollapse);
+    RunForW2B26(base::Milliseconds(600));
+    EXPECT_FALSE(region()->is_expanded_on_hover())
+        << "the pause opened the rail under a lock that holds it closed";
+  }
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return region()->is_expanded_on_hover(); }))
+      << "released, the lock left the pointer on the rail no pause";
+
+  pointer.Off();
+  region()->OnMouseExited(MouseEventAtTheStrip(ui::EventType::kMouseExited));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return !region()->is_expanded_on_hover() && !Animating(); }));
+}
