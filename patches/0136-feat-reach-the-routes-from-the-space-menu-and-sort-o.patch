@@ -2998,6 +2998,56 @@ std::optional<SpaceId> SpaceModel::RouteTab(tabs::TabInterface* tab,
   return target;
 }
 
+std::vector<std::pair<tabs::TabInterface*, SpaceId>>
+SpaceModel::TabsRoutesWouldMove() {
+  std::vector<std::pair<tabs::TabInterface*, SpaceId>> moves;
+  if (!tab_strip_model_) {
+    return moves;
+  }
+  for (int i = 0; i < tab_strip_model_->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(i);
+    bool in_a_folder = false;
+    for (const tabs::TabCollection* each = tab->GetParentCollection(); each;
+         each = each->GetParentCollection()) {
+      in_a_folder |= each->type() == tabs::TabCollection::Type::FOLDER;
+    }
+    // Each of these was put where it is (routing D16).
+    if (tab->IsPinned() || IsSpacePinned(tab) || tab->IsSplit() ||
+        in_a_folder) {
+      continue;
+    }
+    content::WebContents* const contents = tab->GetContents();
+    const GURL committed = contents->GetLastCommittedURL();
+    const GURL url =
+        committed.is_valid() ? committed : contents->GetVisibleURL();
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      continue;
+    }
+    const std::optional<SpaceId> target =
+        RouteTargetFor(url, /*external=*/false, /*search=*/false);
+    if (target && *target != SpaceForTab(tab)) {
+      moves.emplace_back(tab, *target);
+    }
+  }
+  return moves;
+}
+
+size_t SpaceModel::CountTabsRoutesWouldMove() {
+  return TabsRoutesWouldMove().size();
+}
+
+size_t SpaceModel::SortOpenTabsByRoutes() {
+  const std::vector<std::pair<tabs::TabInterface*, SpaceId>> moves =
+      TabsRoutesWouldMove();
+  for (const auto& [tab, target] : moves) {
+    SetSpaceForTab(tab, target);
+  }
+  // The window stays on the Space it shows: a tab that left it hands the
+  // selection on as a move does, and no Space comes on screen unasked.
+  EnsureActiveSpaceHasAVisibleTab(/*essential_gives_way=*/false);
+  return moves.size();
+}
