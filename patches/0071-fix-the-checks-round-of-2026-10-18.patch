+// The row of `menu` that runs `command_id` and shows, or nothing.
+std::optional<size_t> ShownRow(const ui::MenuModel* menu, int command_id) {
+  for (size_t index = 0; index < menu->GetItemCount(); ++index) {
+    if (menu->GetCommandIdAt(index) == command_id && menu->IsVisibleAt(index)) {
+      return index;
+    }
+  }
+  return std::nullopt;
+}
+
+// Whether `menu` shows the row for `command_id`, labelled `label_id` when one
+// is given: the check of Chromium's SystemMenuModelBuilderVerticalTabsTest.
+bool ShowsRow(const ui::MenuModel* menu,
+              int command_id,
+              std::optional<int> label_id) {
+  const std::optional<size_t> row = ShownRow(menu, command_id);
+  return row && (!label_id || menu->GetLabelAt(*row) ==
+                                  l10n_util::GetStringUTF16(*label_id));
+}
