+void InfoBarView::ApplySteddingForm() {
+  const int refresh_margin = ChromeLayoutProvider::Get()->GetDistanceMetric(
+      views::DISTANCE_UNRELATED_CONTROL_HORIZONTAL);
+  if (stedding_pill_) {
+    // The pill; round it, the page shows.
+    SetBackground(std::make_unique<SteddingPillBackground>());
+  } else {
+    SetBackground(views::CreateSolidBackground(kColorInfoBarBackground));
+  }
+  layer()->SetFillsBoundsOpaquely(!stedding_pill_);
+  static_cast<views::FlexLayout*>(GetLayoutManager())
+      ->SetInteriorMargin(stedding_pill_
+                              ? SteddingPillMargins() +
+                                    gfx::Insets::VH(0, refresh_margin)
+                              : gfx::Insets::VH(0, refresh_margin));
+  SetTargetHeight(
+      ChromeLayoutProvider::Get()->GetDistanceMetric(DISTANCE_INFOBAR_HEIGHT) +
+      (stedding_pill_ ? SteddingPillMargins().height() : 0));
+}
