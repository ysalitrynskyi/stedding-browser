@@ -0,0 +1,79 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/make_app.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/web_applications/web_app_dialog_utils.h"
+#include "chrome/browser/ui/web_applications/web_app_launch_utils.h"
+#include "chrome/browser/ui/web_applications/web_app_ui_utils.h"
+#include "chrome/browser/web_applications/web_app_install_params.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/text_utils.h"
+
+namespace stedding {
+
+bool CanMakeApp(BrowserWindowInterface* browser) {
+  // CanCreateWebApp reads the window's active page without asking for one.
+  if (!browser || !browser->GetTabStripModel() ||
+      !browser->GetTabStripModel()->GetActiveWebContents()) {
+    return false;
+  }
+  MakeAppWindow window;
+  window.normal =
+      browser->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL;
+  window.off_the_record = browser->GetProfile()->IsOffTheRecord();
+  // Neither question is asked of a window the command is never offered in:
+  // web apps refuse an off-the-record profile before they look at its page.
+  if (window.normal && !window.off_the_record) {
+    window.can_create_app = web_app::CanCreateWebApp(browser);
+    window.opens_in_app = !web_app::GetOpenPWALabel(browser).empty();
+  }
+  return IsMakeAppOffered(window);
+}
+
+std::u16string MakeAppTitle(BrowserWindowInterface* browser,
+                            MakeAppSurface surface) {
+  std::u16string install_label;
+  std::u16string open_label;
+  if (CanMakeApp(browser)) {
+    install_label = web_app::GetInstallPWALabel(browser);
+    open_label = web_app::GetOpenPWALabel(browser);
+  }
+  // Chromium's labels carry the mnemonic its menus underline on Windows
+  // ("&Open in <App>", an app name's own "&" doubled). Neither surface that
+  // asks here draws one -- the Mac's File menu and the command bar -- so the
+  // marks go and the name keeps its "&" (Wa1, Wa3).
+  return gfx::RemoveAccelerator(MakeAppRowTitle(kMakeAppPlatform, surface,
+                                                install_label, open_label));
+}
+
+void RunMakeApp(BrowserWindowInterface* browser) {
+  if (!CanMakeApp(browser)) {
+    return;
+  }
+  // The app menu's order: an install when Chromium offers one, else "Open in
+  // <App>" (Wa3), which keeps the jar rule of Wa14
+  // (ReparentWebAppForActiveTab).
+  if (web_app::GetInstallPWALabel(browser).empty() &&
+      !web_app::GetOpenPWALabel(browser).empty()) {
+    web_app::ReparentWebAppForActiveTab(browser);
+    return;
+  }
+  // Otherwise the row read the install's words (MakeAppRowTitle), and the
+  // install runs, also where Chromium's app menu would name neither: a page
+  // whose own manifest is an app already installed while the page is
+  // outside that app's scope, or one whose installability check finished
+  // after the window last set the command's state (Wa4). The install shows
+  // its dialog there as it does for any page; an app set to open in a tab
+  // becomes a window app.
+  if (web_app::CanCreateWebApp(browser)) {
+    web_app::CreateWebAppFromCurrentWebContents(
+        browser, web_app::WebAppInstallFlow::kInstallSite);
+  }
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/make_app.h b/chrome/browser/ui/stedding/make_app.h
new file mode 100644
index 0000000000000..a9bb2e2e71fd4
--- /dev/null
+++ b/chrome/browser/ui/stedding/make_app.h
@@ -0,0 +1,40 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_MAKE_APP_H_
+#define CHROME_BROWSER_UI_STEDDING_MAKE_APP_H_
+
+#include <string>
+
+#include "chrome/browser/ui/stedding/make_app_rules.h"
+
+class BrowserWindowInterface;
+
+namespace stedding {
+
+// The command that makes an app from a page (docs/features/web-apps.md):
+// IDC_STEDDING_MAKE_APP, which the Mac's File menu and the command bar run;
+// the app menu keeps Chromium's IDC_INSTALL_PWA row with the same words.
+// Both run Chromium's own install: a page with an installable manifest
+// installs as that app, any other page as a "do it yourself" app.
+
+// web apps Wa4: whether the command is offered for `browser` and the page
+// its active tab shows (IsMakeAppOffered).
+bool CanMakeApp(BrowserWindowInterface* browser);
+
+// web apps Wa1-Wa3: the row's words for `browser`'s active tab on
+// `surface` (MakeAppRowTitle), as the Mac's File menu and the command bar
+// show them: without the "&" mnemonic marks of Chromium's menu labels.
+std::u16string MakeAppTitle(BrowserWindowInterface* browser,
+                            MakeAppSurface surface);
+
+// web apps Wa3, Wa5, Wa6: runs the command for `browser`'s active tab:
+// "Open in <App>" for a page that is an app's already and offers no install,
+// else the install dialog. What it runs is what MakeAppTitle names. Does
+// nothing where the command is not offered.
+void RunMakeApp(BrowserWindowInterface* browser);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_MAKE_APP_H_
diff --git a/chrome/browser/ui/stedding/make_app_rules.cc b/chrome/browser/ui/stedding/make_app_rules.cc
new file mode 100644
index 0000000000000..ede5c68fb7b90
--- /dev/null
+++ b/chrome/browser/ui/stedding/make_app_rules.cc
@@ -0,0 +1,54 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/make_app_rules.h"
+
+#include <utility>
+
+#include "chrome/grit/generated_resources.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace stedding {
+
+std::u16string MakeAppRowTitle(MakeAppPlatform platform,
+                               MakeAppSurface surface,
+                               std::u16string_view install_label,
+                               std::u16string_view open_label) {
+  // Wa3: a page that is an installed app's opens in it.
+  if (install_label.empty() && !open_label.empty()) {
+    return std::u16string(open_label);
+  }
+  // Wa1: Safari's words, for a page with a manifest too: whatever the page
+  // names, the Mac makes it a window of its own with a tile in the Dock.
+  if (platform == MakeAppPlatform::kMac) {
+    return l10n_util::GetStringUTF16(IDS_STEDDING_ADD_TO_DOCK);
+  }
+  // Wa2: the command bar's rows are in title case; a menu keeps Chromium's
+  // sentence case, "Install <App>…" for a site whose manifest names one.
+  if (surface == MakeAppSurface::kCommandBar) {
+    return u"Install Page as App…";
+  }
+  return install_label.empty()
+             ? l10n_util::GetStringUTF16(IDS_INSTALL_DIY_TO_OS_LAUNCH_SURFACE)
+             : std::u16string(install_label);
+}
+
+bool IsMakeAppOffered(const MakeAppWindow& window) {
+  return window.normal && !window.off_the_record &&
+         (window.can_create_app || window.opens_in_app);
+}
+
+std::u16string MakeAppDialogTitle(MakeAppPlatform platform,
+                                  std::u16string chromium_title) {
+  return platform == MakeAppPlatform::kMac ? u"Add to Dock"
+                                           : std::move(chromium_title);
+}
+
+std::u16string MakeAppDialogButton(MakeAppPlatform platform,
+                                   std::u16string chromium_button) {
+  return platform == MakeAppPlatform::kMac ? u"Add"
+                                           : std::move(chromium_button);
+}
+
+}  // namespace stedding
diff --git a/chrome/browser/ui/stedding/make_app_rules.h b/chrome/browser/ui/stedding/make_app_rules.h
new file mode 100644
index 0000000000000..024df912dcbcb
--- /dev/null
+++ b/chrome/browser/ui/stedding/make_app_rules.h
@@ -0,0 +1,73 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_MAKE_APP_RULES_H_
+#define CHROME_BROWSER_UI_STEDDING_MAKE_APP_RULES_H_
+
+#include <string>
+#include <string_view>
+
+#include "build/build_config.h"
+
+namespace stedding {
+
+// Making an app from a page (docs/features/web-apps.md): Safari's "Add to
+// Dock…" on the Mac, Chromium's "Install page as app…" on Windows. These are
+// the rules alone, with no window or page behind them, so the app menu can
+// word its row without depending on the web-app code (make_app.h holds the
+// command).
+
+enum class MakeAppPlatform { kMac, kOther };
+
+#if BUILDFLAG(IS_MAC)
+inline constexpr MakeAppPlatform kMakeAppPlatform = MakeAppPlatform::kMac;
+#else
+inline constexpr MakeAppPlatform kMakeAppPlatform = MakeAppPlatform::kOther;
+#endif
+
+// Where the row is drawn: a menu (the app menu, the Mac's File menu) or the
+// command bar, whose rows are in title case (menus M1).
+enum class MakeAppSurface { kMenu, kCommandBar };
+
+// web apps Wa1-Wa3: the row's words. `install_label` is Chromium's for the
+// page ("Install page as app…", "Install <App>…", or empty where nothing can
+// be installed or the page is an installed app's), `open_label` Chromium's
+// "Open in <App>" for a page that is an app's already (else empty). As the
+// app menu does, an install comes first; then "Open in <App>"; else the words
+// for making one: "Add to Dock…" on the Mac; on Windows Chromium's own in a
+// menu and "Install Page as App…" in the command bar.
+std::u16string MakeAppRowTitle(MakeAppPlatform platform,
+                               MakeAppSurface surface,
+                               std::u16string_view install_label,
+                               std::u16string_view open_label);
+
+// What decides whether the command is offered in a window.
+struct MakeAppWindow {
+  // A tabbed window, a Blank Window included; not a popup, a little window
+  // (a popup too) or an app's window.
+  bool normal = false;
+  // A private window or a Guest window: web apps refuse an off-the-record
+  // profile (AreWebAppsUserInstallable).
+  bool off_the_record = false;
+  // web_app::CanCreateWebApp: an http or https page that loaded, not crashed,
+  // not an error page, not a browser page.
+  bool can_create_app = false;
+  // The page is an installed app's, which opens in a window of its own.
+  bool opens_in_app = false;
+};
+
+// web apps Wa4: whether the command is offered in `window`.
+bool IsMakeAppOffered(const MakeAppWindow& window);
+
+// web apps Wa5: the install dialog's title and its button. On the Mac,
+// Safari's "Add to Dock" and "Add", for a page with a manifest too; elsewhere
+// Chromium's own, `chromium_title` and `chromium_button`.
+std::u16string MakeAppDialogTitle(MakeAppPlatform platform,
+                                  std::u16string chromium_title);
+std::u16string MakeAppDialogButton(MakeAppPlatform platform,
+                                   std::u16string chromium_button);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_MAKE_APP_RULES_H_
diff --git a/chrome/browser/ui/stedding/make_app_unittest.cc b/chrome/browser/ui/stedding/make_app_unittest.cc
new file mode 100644
index 0000000000000..b3a633a763f38
--- /dev/null
+++ b/chrome/browser/ui/stedding/make_app_unittest.cc
@@ -0,0 +1,99 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/make_app_rules.h"
+
+#include "chrome/grit/generated_resources.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/l10n/l10n_util.h"
+
+namespace stedding {
+namespace {
+
+constexpr char16_t kDiy[] = u"Install page as app…";
+constexpr char16_t kSite[] = u"Install Mail…";
+constexpr char16_t kOpen[] = u"Open in Mail";
+
+// web apps Wa1-Wa3: the Mac says Safari's "Add to Dock…" in every menu and
+// the command bar, for a page with a manifest too; Windows keeps Chromium's
+// words in its menu, "Install <App>…" for a site that names one, and the
+// command bar's title case. A page that is an app's already reads "Open in
+// <App>" everywhere, and an install Chromium offers comes first, as in the
+// app menu.
+TEST(MakeAppRulesTest, TheRowsWordsFollowThePlatformAndThePage) {
+  const std::u16string add_to_dock =
+      l10n_util::GetStringUTF16(IDS_STEDDING_ADD_TO_DOCK);
+  EXPECT_EQ(u"Add to Dock…", add_to_dock);
+
+  for (MakeAppSurface surface :
+       {MakeAppSurface::kMenu, MakeAppSurface::kCommandBar}) {
+    EXPECT_EQ(add_to_dock,
+              MakeAppRowTitle(MakeAppPlatform::kMac, surface, kDiy, u""));
+    EXPECT_EQ(add_to_dock,
+              MakeAppRowTitle(MakeAppPlatform::kMac, surface, kSite, u""));
+    EXPECT_EQ(kOpen,
+              MakeAppRowTitle(MakeAppPlatform::kMac, surface, u"", kOpen));
+    EXPECT_EQ(kOpen,
+              MakeAppRowTitle(MakeAppPlatform::kOther, surface, u"", kOpen));
+    // Nothing to install and no app: the words for making one, which the
+    // command's state then shows disabled or leaves out.
+    EXPECT_EQ(add_to_dock,
+              MakeAppRowTitle(MakeAppPlatform::kMac, surface, u"", u""));
+    // An install comes first, as in the app menu.
+    EXPECT_EQ(add_to_dock,
+              MakeAppRowTitle(MakeAppPlatform::kMac, surface, kDiy, kOpen));
+  }
+
+  EXPECT_EQ(kDiy, MakeAppRowTitle(MakeAppPlatform::kOther,
+                                  MakeAppSurface::kMenu, kDiy, u""));
+  EXPECT_EQ(kSite, MakeAppRowTitle(MakeAppPlatform::kOther,
+                                   MakeAppSurface::kMenu, kSite, u""));
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_INSTALL_DIY_TO_OS_LAUNCH_SURFACE),
+            MakeAppRowTitle(MakeAppPlatform::kOther, MakeAppSurface::kMenu,
+                            u"", u""));
+  EXPECT_EQ(kSite, MakeAppRowTitle(MakeAppPlatform::kOther,
+                                   MakeAppSurface::kMenu, kSite, kOpen));
+  for (std::u16string_view install : {kDiy, kSite}) {
+    EXPECT_EQ(u"Install Page as App…",
+              MakeAppRowTitle(MakeAppPlatform::kOther,
+                              MakeAppSurface::kCommandBar, install, u""));
+  }
+}
+
+// web apps Wa4: offered in a normal window -- a Blank Window is one -- on a
+// page Chromium can make an app of, or one that is an app's already; never
+// in a private or Guest window, a popup, a little window or an app's window.
+TEST(MakeAppRulesTest, OfferedOnlyInANormalWindowOnAWebPage) {
+  EXPECT_TRUE(IsMakeAppOffered({.normal = true, .can_create_app = true}));
+  EXPECT_TRUE(IsMakeAppOffered({.normal = true, .opens_in_app = true}));
+  EXPECT_TRUE(IsMakeAppOffered(
+      {.normal = true, .can_create_app = true, .opens_in_app = true}));
+
+  // chrome://settings, an error page, a crashed page, about:blank.
+  EXPECT_FALSE(IsMakeAppOffered({.normal = true}));
+  // A private window, a Guest window.
+  EXPECT_FALSE(IsMakeAppOffered(
+      {.normal = true, .off_the_record = true, .can_create_app = true}));
+  EXPECT_FALSE(IsMakeAppOffered(
+      {.normal = true, .off_the_record = true, .opens_in_app = true}));
+  // A popup, a little window, an app's window.
+  EXPECT_FALSE(IsMakeAppOffered({.can_create_app = true}));
+  EXPECT_FALSE(IsMakeAppOffered({.opens_in_app = true}));
+  EXPECT_FALSE(IsMakeAppOffered(MakeAppWindow()));
+}
+
+// web apps Wa5: the install dialog says "Add to Dock" and "Add" on the Mac,
+// whatever Chromium's own dialog would say; elsewhere Chromium's words stay.
+TEST(MakeAppRulesTest, TheDialogSaysAddToDockOnTheMac) {
+  EXPECT_EQ(u"Add to Dock",
+            MakeAppDialogTitle(MakeAppPlatform::kMac, u"Install app"));
+  EXPECT_EQ(u"Add", MakeAppDialogButton(MakeAppPlatform::kMac, u"Install"));
+  EXPECT_EQ(u"Install app",
+            MakeAppDialogTitle(MakeAppPlatform::kOther, u"Install app"));
+  EXPECT_EQ(u"Install",
+            MakeAppDialogButton(MakeAppPlatform::kOther, u"Install"));
+}
+
+}  // namespace
+}  // namespace stedding
