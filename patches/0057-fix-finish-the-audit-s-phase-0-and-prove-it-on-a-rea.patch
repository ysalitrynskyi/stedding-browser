+// Stedding folders F19: Close Folder's Tabs closes every tab of a collapsed
+// folder in one batch. The active tab leaves the folder first, for the
+// nearest visible tab after it, so no other tab of the folder is shown.
+TEST_F(TabStripModelTest, CloseFolderTabsClosesACollapsedFolderAtOnce) {
+  class Recorder : public TabStripModelObserver {
+   public:
+    void OnTabStripModelChanged(
+        TabStripModel* tab_strip_model,
+        const TabStripModelChange& change,
+        const TabStripSelectionChange& selection) override {
+      if (change.type() == TabStripModelChange::kRemoved) {
+        ++removals;
+      }
+      if (selection.active_tab_changed() && selection.new_tab) {
+        activated.push_back(selection.new_tab->GetHandle());
+      }
+    }
+    int removals = 0;
+    std::vector<tabs::TabHandle> activated;
+  };
+
+  PrepareTabs(tabstrip(), 5);
