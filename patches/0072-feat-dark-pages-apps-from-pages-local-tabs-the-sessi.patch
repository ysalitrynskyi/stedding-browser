@@ -0,0 +1,110 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_APP_JAR_H_
+#define CHROME_BROWSER_UI_SPACES_APP_JAR_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "content/public/browser/storage_partition_config.h"
+
+class GURL;
+
+namespace content {
+class BrowserContext;
+class SiteInstance;
+class WebContents;
+}  // namespace content
+
+namespace spaces {
+
+class SpaceModel;
+
+// An app made from a page keeps the session of the Space it was made in
+// (docs/features/web-apps.md Wa11-Wa15; the jar is recorded with the app by
+// the install command, chrome/common/stedding/web_apps.h). These are the
+// answers the browser's windows, its restore and its uninstall ask of that
+// record.
+
+// web apps Wa11, Wa13: the partition the pages `app_id` opens on its own are
+// made in: its Space's jar while that Space keeps it, else nullopt, the
+// profile's shared jar.
+std::optional<content::StoragePartitionConfig> StoragePartitionConfigForApp(
+    content::BrowserContext* browser_context,
+    std::string_view app_id);
+
+// web apps Wa11, Wa12: the SiteInstance for a page of `app_id` at `url` that
+// has no opener -- a launch from the Dock, Spotlight, the Start menu or
+// chrome://apps, a restored or reopened app window -- fixed in the app's
+// Space jar when it has one and `url` is a web page (PageBelongsInSpaceJar);
+// null otherwise, so the caller keeps its own choice.
+scoped_refptr<content::SiteInstance> SiteInstanceForAppPage(
+    content::BrowserContext* browser_context,
+    std::string_view app_id,
+    const GURL& url);
+
+// web apps Wa6, Wa14, Wa15: whether `contents` lives in the jar `app_id`'s
+// pages are made in: both the shared jar, or both the same Space's jar.
+bool ContentsAreInAppJar(content::WebContents* contents,
+                         std::string_view app_id);
+
+// web apps Wa6, Wa14: whether the tab showing `contents` stays where it is
+// when it would move into `app_id`'s window, the app opening a window of its
+// own at its address instead: an essential or a Space pin keeps its place in
+// the sidebar, a split's pane keeps its split, and a page in another jar
+// than the app's would take that jar into the app.
+bool TabStaysOutOfApp(content::WebContents* contents, std::string_view app_id);
+
+// web apps Wa14: the Space of `model` a page leaving an app window belongs
+// in, by the jar it lives in, `partition`: the Space keeping that jar; for
+// the shared jar, the active Space when it shares it, else the first Space
+// in the switcher that does. Nullopt when no Space of `model` fits.
+std::optional<SpaceId> SpaceForAppPage(
+    const SpaceModel& model,
+    const content::StoragePartitionConfig& partition);
+
+// web apps Wa14: whether a new window that follows the profile's Space list
+// has a Space for a page in `partition`: one keeping that jar with its own
+// session on or, for the shared jar, one that shares it. A Blank Window
+// always has one for the shared jar and never for a Space's.
+bool SpaceListHasSpaceForJar(content::BrowserContext* browser_context,
+                             const content::StoragePartitionConfig& partition);
+
+// web apps Wa5: the install dialog's line naming the session the app will
+// open in, for the page `contents` it is made from: "Opens with the session
+// of “Work”." when that page lives in the jar a Space keeps with its own
+// session on, the Space named as its window names it; empty otherwise, when
+// the app will use the shared session.
+std::u16string AppSessionLine(content::WebContents* contents);
+
+// web apps Wa18: what the uninstall dialog's "Also clear data" adds for an
+// app that kept a Space's own session, where clearing the site signs that
+// Space's tabs out of it too: "This also signs the tabs of “Work” out of the
+// site."; empty for an app on the shared session.
+std::u16string AppClearDataSpaceNote(content::BrowserContext* browser_context,
+                                     std::string_view app_id);
+
+// web apps Wa18: the "Also clear data" label with the note after it, as two
+// sentences; the label alone when there is no note. Chromium's label ends
+// without a full stop: "Remove this app's data from Stedding. This also signs
+// the tabs of “Work” out of the site."
+std::u16string WithClearDataSpaceNote(std::u16string_view label,
+                                      std::u16string_view note);
+
+// web apps Wa13: the sentence a question adds for the apps of `names`, which
+// will use the shared session `when`: "“Mail” and “Calendar” will then use
+// the shared session." An app's name is its site's choice: each goes in
+// quoted and as spaces::NameInSentence gives it, so it reads as a name and
+// cannot add a sentence to the question, or reorder it. Empty for no app.
+std::u16string AppsKeepingSessionLine(const std::vector<std::u16string>& names,
+                                      std::u16string_view when);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_APP_JAR_H_
diff --git a/chrome/browser/ui/spaces/app_jars_unittest.cc b/chrome/browser/ui/spaces/app_jars_unittest.cc
new file mode 100644
index 0000000000000..a05527e8ac01c
--- /dev/null
+++ b/chrome/browser/ui/spaces/app_jars_unittest.cc
@@ -0,0 +1,163 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/spaces/app_jar.h"
+#include "chrome/browser/ui/spaces/isolation_mark.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/common/stedding/space_partitions.h"
+#include "chrome/common/stedding/web_apps.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace spaces {
+namespace {
+
+constexpr char kMail[] = "mailappid";
+constexpr char kNotes[] = "notesappid";
+
+class AppJarsTest : public testing::Test {
+ protected:
+  AppJarsTest() {
+    prefs_.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+    prefs_.registry()->RegisterDictionaryPref(stedding::kAppJarsPref);
+  }
+
+  TestingPrefServiceSimple prefs_;
+};
+
+// web apps Wa11: the install command records the jar of the tab the app is
+// made from only when it is a Space's own; a tab on the shared jar, or in
+// any other partition, leaves no record, and forgets the one an earlier
+// install of the same app left.
+TEST_F(AppJarsTest, RecordsOnlyASpacesJar) {
+  stedding::RecordAppJarForPartition(prefs_, kMail,
+                                     stedding::kSpacePartitionDomain, "jarA");
+  EXPECT_EQ("jarA", stedding::RecordedAppJar(prefs_, kMail));
+
+  // The shared jar is the default partition: no domain, no name.
+  stedding::RecordAppJarForPartition(prefs_, kNotes, "", "");
+  EXPECT_EQ("", stedding::RecordedAppJar(prefs_, kNotes));
+  EXPECT_FALSE(prefs_.GetDict(stedding::kAppJarsPref).Find(kNotes));
+
+  // An extension's or an isolated web app's partition is no Space's.
+  stedding::RecordAppJarForPartition(prefs_, kNotes, "someextension", "x");
+  EXPECT_FALSE(prefs_.GetDict(stedding::kAppJarsPref).Find(kNotes));
+  // The Spaces' domain without a name is the domain alone, no jar.
+  stedding::RecordAppJarForPartition(prefs_, kNotes,
+                                     stedding::kSpacePartitionDomain, "");
+  EXPECT_FALSE(prefs_.GetDict(stedding::kAppJarsPref).Find(kNotes));
+
+  // Made again from a shared Space: the old record goes.
+  stedding::RecordAppJarForPartition(prefs_, kMail, "", "");
+  EXPECT_EQ("", stedding::RecordedAppJar(prefs_, kMail));
+  EXPECT_TRUE(prefs_.GetDict(stedding::kAppJarsPref).empty());
+
+  // Forgetting (an uninstall, Wa18) takes the one app's record only.
+  stedding::RecordAppJarForPartition(prefs_, kMail,
+                                     stedding::kSpacePartitionDomain, "jarA");
+  stedding::RecordAppJarForPartition(prefs_, kNotes,
+                                     stedding::kSpacePartitionDomain, "jarA");
+  EXPECT_THAT(stedding::AppsRecordingJar(prefs_, "jarA"),
+              testing::ElementsAre(kMail, kNotes));
+  stedding::ForgetAppJar(prefs_, kMail);
+  EXPECT_THAT(stedding::AppsRecordingJar(prefs_, "jarA"),
+              testing::ElementsAre(kNotes));
+  EXPECT_TRUE(stedding::AppsRecordingJar(prefs_, "").empty());
+
+  // A profile without the preference -- a type with no Spaces -- records
+  // nothing and answers nothing.
+  TestingPrefServiceSimple bare;
+  stedding::RecordAppJarForPartition(bare, kMail,
+                                     stedding::kSpacePartitionDomain, "jarA");
+  EXPECT_EQ("", stedding::RecordedAppJar(bare, kMail));
+  EXPECT_EQ("", stedding::AppJarInUse(bare, kMail));
+}
+
+// web apps Wa11, Wa13: an app's pages use its recorded jar only while a
+// Space of the profile still keeps it with its own session on; deleting
+// that Space, or turning its session off, gives the shared jar from the
+// next page on, and turning it on again gives the jar back.
+TEST_F(AppJarsTest, AGoneOrSharedSpaceGivesTheSharedJar) {
+  SpaceRegistry registry(&prefs_);
+  const SpaceId work = registry.Add("Work", SK_ColorBLUE);
+  registry.Add("Home", SK_ColorGREEN);
+  registry.EnsureIsolated(work);
+  const std::string jar = registry.Find(work)->profile_id;
+  ASSERT_FALSE(jar.empty());
+
+  EXPECT_EQ("", stedding::AppJarInUse(prefs_, kMail)) << "no record yet";
+  stedding::RecordAppJarForPartition(prefs_, kMail,
+                                     stedding::kSpacePartitionDomain, jar);
+  EXPECT_EQ(jar, stedding::AppJarInUse(prefs_, kMail));
+
+  registry.SetIsolated(work, false);
+  EXPECT_EQ("", stedding::AppJarInUse(prefs_, kMail))
+      << "the Space's own session is off";
+  EXPECT_EQ(jar, stedding::RecordedAppJar(prefs_, kMail))
+      << "the record stays for when it is on again";
+  registry.SetIsolated(work, true);
+  EXPECT_EQ(jar, stedding::AppJarInUse(prefs_, kMail));
+
+  ASSERT_TRUE(registry.Remove(work));
+  EXPECT_EQ("", stedding::AppJarInUse(prefs_, kMail)) << "the Space is gone";
+
+  // A jar no Space ever named -- a Blank Window's Space, whose list is
+  // never written -- is the shared jar too.
+  stedding::RecordAppJarForPartition(prefs_, kNotes,
+                                     stedding::kSpacePartitionDomain, "blank");
+  EXPECT_EQ("", stedding::AppJarInUse(prefs_, kNotes));
+
+  // A registry from before the isolation flag (beta 7) reads a jar name as
+  // its session on (sessions S19).
+  base::ListValue old_registry;
+  old_registry.Append(base::DictValue().Set("profile", "oldjar"));
+  base::DictValue jars;
+  jars.Set(kMail, "oldjar");
+  EXPECT_EQ("oldjar", stedding::AppJarInUse(jars, old_registry, kMail));
+}
+
+// web apps Wa13 (BACKLOG S-351): the sentence a question adds for the apps
+// keeping a Space's session names each app quoted, as a name: an app's name
+// is its site's choice, and one that read "Cookies and logins will be kept."
+// added that sentence to the question about erasing them, and a line break
+// or a direction override in it started a line or reordered the question.
+TEST(AppsKeepingSessionLineTest, EachAppIsANameInTheSentence) {
+  EXPECT_EQ(u"", AppsKeepingSessionLine({}, u"then use the shared session."));
+  EXPECT_EQ(u"\u201CMail\u201D will then use the shared session.",
+            AppsKeepingSessionLine({u"Mail"}, u"then use the shared session."));
+  EXPECT_EQ(u"\u201CMail\u201D, \u201CNotes\u201D and "
+            u"\u201CCalendar\u201D will then use the shared session.",
+            AppsKeepingSessionLine({u"Mail", u"Notes", u"Calendar"},
+                                   u"then use the shared session."));
+  EXPECT_EQ(u"\u201CCookies and logins will be kept. Really\u201D will then "
+            u"use the shared session.",
+            AppsKeepingSessionLine(
+                {u"Cookies and logins will be kept.\n\u202EReally"},
+                u"then use the shared session."));
+}
+
+// The names other people chose, inside a sentence: no line breaks, no
+// controls that embed, override or isolate the text's direction.
+TEST(AppsKeepingSessionLineTest, ANameInASentenceKeepsToItsPlace) {
+  EXPECT_EQ(u"Work", NameInSentence(u"Work"));
+  EXPECT_EQ(u"Work Nothing is deleted.",
+            NameInSentence(u"Work\r\nNothing is deleted.\n"));
+  EXPECT_EQ(u"Workexplained",
+            NameInSentence(u"\u202AWork\u202E\u2067explained\u2069\u202C"));
+  EXPECT_EQ(u"a b", NameInSentence(u"a\u2028b"));
+  constexpr char16_t kHebrew[] = u"\u05E2\u05D1\u05D5\u05D3\u05D4";
+  EXPECT_EQ(kHebrew, NameInSentence(kHebrew))
+      << "a name in a right-to-left script is kept as it is";
+}
