+// clean-links Cl3: how deep a redirect page inside a redirect page is
+// unwrapped.
+constexpr int kMaxUnwrapDepth = 3;
+
+// clean-links Cl3: the parameters that may name a redirect page's target,
+// in the order they are tried.
+constexpr std::string_view kGoogleTarget[] = {"q", "url"};
+constexpr std::string_view kUTarget[] = {"u"};
+constexpr std::string_view kUrlTarget[] = {"url"};
+constexpr std::string_view kQTarget[] = {"q"};
+
+// clean-links Cl3: the parameters of |url| that may name its target, when
+// |url| is a known redirect page; empty otherwise. Hosts are matched exactly,
+// on the scheme's own port, so a page that only looks like one is left
+// alone.
+base::span<const std::string_view> TargetParametersOf(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS() || !url.has_query() || url.has_port()) {
+    return {};
+  }
+  const std::string_view host = url.host();
+  const std::string_view path = url.path();
+  // www.google.<tld>/url: search results carry the target in q=, and the
+  // usual form of a shared result carries an empty q= with the target in
+  // url=, so both are tried.
+  if (path == "/url" && google_util::IsGoogleDomainUrl(
+                             url, google_util::DISALLOW_SUBDOMAIN,
+                             google_util::DISALLOW_NON_STANDARD_PORTS)) {
+    return kGoogleTarget;
+  }
+  if ((host == "l.facebook.com" || host == "lm.facebook.com" ||
+       host == "l.messenger.com") &&
+      path == "/l.php") {
+    return kUTarget;
+  }
+  if (host == "l.instagram.com" && path == "/") {
+    return kUTarget;
+  }
+  if (host == "out.reddit.com") {
+    return kUrlTarget;
+  }
+  if ((host == "www.youtube.com" || host == "youtube.com" ||
+       host == "m.youtube.com") &&
+      path == "/redirect") {
+    return kQTarget;
+  }
+  return {};
+}
+
+// One level of Cl3: the decoded http(s) target of |url| in the first of its
+// target parameters that holds one, or nothing.
+std::optional<GURL> UnwrapOnce(const GURL& url) {
+  for (std::string_view parameter : TargetParametersOf(url)) {
+    std::string value;
+    if (!net::GetValueForKeyInQuery(url, parameter, &value)) {
+      continue;
+    }
+    GURL target(base::TrimWhitespaceASCII(value, base::TRIM_ALL));
+    if (target.is_valid() && target.SchemeIsHTTPOrHTTPS()) {
+      return target;
+    }
+  }
+  return std::nullopt;
+}
