+namespace {
+
+using testing::NiceMock;
+using testing::Return;
+using testing::ReturnRefOfCopy;
+
+// sidebar-panels Pn19 (BACKLOG S-489): the downloads bubble's menu, the one
+// a right-click in the toast opens, runs the Downloads panel's verbs. Their
+// ids are not DownloadCommands; the menu counted every command it ran in a
+// table of those, read past it for the panel's, and the release build ended
+// at Move to Trash (2026-11-14). The panel's verbs run, and are not counted.
+TEST(DownloadUiContextMenuViewSteddingTest, ThePanelsVerbsRunFromTheBubble) {
+  content::BrowserTaskEnvironment task_environment;
+  TestingProfile profile;
+  NiceMock<download::MockDownloadItem> item;
+  content::DownloadItemUtils::AttachInfoForTesting(&item, &profile, nullptr);
+  const base::FilePath path(FILE_PATH_LITERAL("a-file.pdf"));
+  ON_CALL(item, GetState())
+      .WillByDefault(Return(download::DownloadItem::COMPLETE));
+  ON_CALL(item, GetTargetFilePath()).WillByDefault(ReturnRefOfCopy(path));
+  ON_CALL(item, GetFileExternallyRemoved()).WillByDefault(Return(false));
+  auto download = DownloadItemModel::Wrap(&item);
+  DownloadUiContextMenuView menu(download->GetWeakPtr());
+  ui::SimpleMenuModel::Delegate& delegate = menu;
+  base::HistogramTester histograms;
+
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+  base::FilePath trashed;
+  stedding::SetMoveToTrashForTesting(
+      base::BindLambdaForTesting([&](const base::FilePath& file) {
+        trashed = file;
+        return true;
+      }));
+  delegate.ExecuteCommand(DownloadUiContextMenu::kSteddingMoveToTrash, 0);
+  task_environment.RunUntilIdle();
+  stedding::SetMoveToTrashForTesting(
+      base::RepeatingCallback<bool(const base::FilePath&)>());
+  EXPECT_EQ(path, trashed) << "the file did not go to the Trash";
+#endif
+
+  EXPECT_CALL(item, Remove()).Times(1);
+  delegate.ExecuteCommand(DownloadUiContextMenu::kSteddingRemoveFromList, 0);
+  histograms.ExpectTotalCount("Download.ContextMenuAction", 0);
+}
