+    return content::EvalJs(page, OnThePageW2B02(R"(
+      const section = pick('settings-stedding-sync-section');
+      const root = section && section.shadowRoot;
+      const dialog = root && root.querySelector('#placeDialog');
+      if (!dialog) {
+        return '';
+      }
+      const inputs = [...dialog.querySelectorAll('cr-input')];
+      const failure = root.querySelector('#placeFailure');
+      return [section.placeTesting_, dialog.open,
+              inputs.length > 0 && inputs.every(input => !input.disabled),
+              failure ? failure.textContent.trim() : '',
+              !root.querySelector('#placeTest').disabled].join('|');)"))
+        .ExtractString();
+  }
+
+  net::EmbeddedTestServer server_;
+  sb::FakePlace place_{sb::PlaceKind::kWebDav};
+  std::atomic<int> asked_{0};
