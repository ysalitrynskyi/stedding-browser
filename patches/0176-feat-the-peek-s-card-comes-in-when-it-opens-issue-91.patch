+        page_(page.GetWeakPtr()) {}
+
+  base::WeakPtr<content::WebContents> page_;
+
+  friend WebContentsUserData;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ShownOver);
+
+}  // namespace
+
+ExtensionVisiblePage::ExtensionVisiblePage(content::WebContents* contents)
+    : content::WebContentsUserData<ExtensionVisiblePage>(*contents) {}
+
+ExtensionVisiblePage::~ExtensionVisiblePage() = default;
+
+// static
+void ExtensionVisiblePage::AddObserver(Observer* observer) {
+  Observers().AddObserver(observer);
+}
+
+// static
+void ExtensionVisiblePage::RemoveObserver(Observer* observer) {
+  Observers().RemoveObserver(observer);
+}
+
+// static
+void ExtensionVisiblePage::ShowOver(content::WebContents& page,
+                                    content::WebContents& tab_page) {
+  ExtensionVisiblePage* const mark =
+      ExtensionVisiblePage::GetOrCreateForWebContents(&page);
+  if (mark->over_.get() == &tab_page) {
+    return;
+  }
+  if (content::WebContents* const before = mark->over_.get()) {
+    before->RemoveUserData(ShownOver::UserDataKey());
+  }
+  mark->over_ = tab_page.GetWeakPtr();
+  tab_page.RemoveUserData(ShownOver::UserDataKey());
+  ShownOver::CreateForWebContents(&tab_page, page);
+  for (Observer& observer : Observers()) {
+    observer.OnPageShownOver(page, tab_page);
+  }
+}
+
+// static
+void ExtensionVisiblePage::StopShowingOver(content::WebContents& page,
+                                           bool kept) {
+  ExtensionVisiblePage* const mark = ExtensionVisiblePage::FromWebContents(&page);
+  if (!mark || !mark->over_) {
+    return;
+  }
+  content::WebContents* const tab_page = mark->over_.get();
+  mark->over_.reset();
+  tab_page->RemoveUserData(ShownOver::UserDataKey());
+  if (kept) {
+    return;
+  }
+  for (Observer& observer : Observers()) {
+    observer.OnPageClosedOver(page, tab_page);
+  }
+}
+
+// static
+content::WebContents* ExtensionVisiblePage::PageShownOver(
+    content::WebContents* tab_page) {
+  const ShownOver* const shown =
+      tab_page ? ShownOver::FromWebContents(tab_page) : nullptr;
+  return shown ? shown->page() : nullptr;
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ExtensionVisiblePage);
+
+}  // namespace stedding
