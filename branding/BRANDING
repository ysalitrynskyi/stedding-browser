# Replaces chrome/app/theme/chromium/BRANDING in the Chromium checkout.
#
# This file drives most of the macOS bundle: CFBundleIdentifier, the app and helper
# names, and the copyright string. The identifier is fixed by
# docs/decisions/0009-macos-bundle-identifier.md and must not be changed casually —
# macOS keys the profile directory and keychain access off it.
#
# @LASTCHANGE_YEAR@ is substituted by Chromium's build; leave it alone.

COMPANY_FULLNAME=The Stedding Authors
COMPANY_SHORTNAME=The Stedding Authors
PRODUCT_FULLNAME=Stedding
PRODUCT_SHORTNAME=Stedding
PRODUCT_INSTALLER_FULLNAME=Stedding Installer
PRODUCT_INSTALLER_SHORTNAME=Stedding Installer
COPYRIGHT=Copyright @LASTCHANGE_YEAR@ The Stedding Authors. All rights reserved.
MAC_BUNDLE_ID=dev.stedding.Stedding
MAC_CREATOR_CODE=Cr24
MAC_TEAM_ID=
