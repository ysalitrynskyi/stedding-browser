+  // five others carried a later time, the wall clock having run ahead when
+  // they were made, and its path still came back as written.
+  size_t kept = 1;
+  for (const base::FilePath& backup : ListBackups(profile_dir)) {
+    if (backup == path) {
+      continue;
+    }
+    if (kept < kBackupsKept) {
+      ++kept;
+      continue;
+    }
+    base::DeleteFile(backup);
   }
   return path;
