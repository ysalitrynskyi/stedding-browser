From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Mon, 31 Aug 2026 23:22:55 -0400
Subject: style the command bar to the reference

A near-black rounded panel, a slightly lighter field, and the first result --
the one Enter takes -- shown as chosen rather than left for the user to guess.

The colours are literals rather than theme ids because the overlay is its own
surface floating over the page; taking the toolbar's colours would tie it to
chrome it is not part of.

Why: the bar was functional but looked like a plain list, which is not what the
reference shows and not what a user would trust as the way in to everything.
Removable when: Stedding has its own colour tokens for surfaces that float over
content, at which point these literals become ids.
---
 .../ui/views/commandbar/command_bar_view.cc   | 26 ++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/ui/views/commandbar/command_bar_view.cc b/chrome/browser/ui/views/commandbar/command_bar_view.cc
index 21b908d8815bf..5befa21018ee9 100644
--- a/chrome/browser/ui/views/commandbar/command_bar_view.cc
+++ b/chrome/browser/ui/views/commandbar/command_bar_view.cc
@@ -37,9 +37,20 @@ namespace {
 
 constexpr int kBarWidth = 720;
 constexpr int kListHeight = 320;
-constexpr int kRowHeight = 44;
+constexpr int kRowHeight = 48;
+constexpr int kFieldHeight = 52;
+constexpr int kPanelRadius = 16;
+constexpr int kRowRadius = 10;
+constexpr int kPanelInset = 14;
 constexpr size_t kMaxResults = 8;
 
+// The overlay is its own surface floating over the page, so it does not take
+// the toolbar's colours. These match the reference: a near-black panel with a
+// slightly lighter field.
+constexpr SkColor kPanelColor = SkColorSetRGB(0x22, 0x23, 0x27);
+constexpr SkColor kFieldColor = SkColorSetRGB(0x2C, 0x2D, 0x33);
+constexpr SkColor kSelectedRowColor = SkColorSetRGB(0x4B, 0x4D, 0xE8);
+
 bool Matches(const std::u16string& haystack, const std::u16string& needle) {
   if (needle.empty()) {
     return true;
@@ -81,7 +92,9 @@ void CommandBarView::Show(Browser* browser) {
 }
 
 CommandBarView::CommandBarView(Browser* browser) : browser_(browser) {
-  SetBorder(views::CreateEmptyBorder(gfx::Insets(12)));
+  SetBackground(
+      views::CreateRoundedRectBackground(kPanelColor, kPanelRadius));
+  SetBorder(views::CreateEmptyBorder(gfx::Insets(kPanelInset)));
   AddAccelerator(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE));
 }
 
@@ -94,7 +107,9 @@ void CommandBarView::BuildContents() {
   auto field = std::make_unique<views::Textfield>();
   field->set_controller(this);
   field->SetPlaceholderText(u"Search or Enter URL...");
-  field->SetPreferredSize(gfx::Size(kBarWidth, 40));
+  field->SetPreferredSize(gfx::Size(kBarWidth, kFieldHeight));
+  field->SetBackgroundColor(kFieldColor);
+  field->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, 12)));
   field_ = AddChildView(std::move(field));
 
   auto list = std::make_unique<views::ScrollView>();
@@ -163,6 +178,11 @@ void CommandBarView::UpdateResults(const std::u16string& query) {
         result.title + u"   —   " + trailing);
     row->SetHorizontalAlignment(gfx::ALIGN_LEFT);
     row->SetPreferredSize(gfx::Size(kBarWidth, kRowHeight));
+    // The first result is what Enter takes, so it is the one shown as chosen.
+    if (contents->children().empty()) {
+      row->SetBackground(
+          views::CreateRoundedRectBackground(kSelectedRowColor, kRowRadius));
+    }
     contents->AddChildView(std::move(row));
   }
   contents->InvalidateLayout();
