+void PageThemeColorController::OnSampleTimer() {
+  const base::TimeTicks now = base::TimeTicks::Now();
+  while (!sample_due_.empty() &&
+         *sample_due_.begin() <= now + base::Milliseconds(30)) {
+    sample_due_.erase(sample_due_.begin());
+  }
+  SampleTop();
+  if (!sample_due_.empty()) {
+    sample_timer_.Start(FROM_HERE,
+                        std::max(*sample_due_.begin() - now, base::TimeDelta()),
+                        this, &PageThemeColorController::OnSampleTimer);
+  }
