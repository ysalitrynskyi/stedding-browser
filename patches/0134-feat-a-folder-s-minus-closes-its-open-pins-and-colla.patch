+std::vector<tabs::TabInterface*> OpenPinsInFolder(
+    BrowserWindowInterface* browser,
+    const tabs::FolderTabCollection* folder) {
+  std::vector<tabs::TabInterface*> open;
+  spaces::SpaceModel* const model =
+      browser ? spaces::SpaceModel::From(browser) : nullptr;
+  if (!model || !model->IsFolderSpacePinned(folder)) {
+    return open;
+  }
+  for (tabs::TabInterface* const tab : folder->GetTabsRecursive()) {
+    if (!IsAsleep(tab) && model->IsTabInActiveSpace(tab)) {
+      open.push_back(tab);
+    }
+  }
+  return open;
+}
+
+void CloseOpenPinsAndCollapse(BrowserWindowInterface* browser,
+                              tabs::FolderTabCollection* folder) {
+  const std::vector<tabs::TabInterface*> open =
+      OpenPinsInFolder(browser, folder);
+  if (open.empty()) {
+    return;
+  }
+  // By its handle: a page's answer can come after the folder has gone.
+  const tabs::TabCollection::Handle handle = folder->GetHandle();
+  if (SleepOrLeaveToClose(browser, open,
+                          base::BindOnce(&CollapseFolderAfterClose, handle))) {
+    return;
+  }
+  // H9: Cmd-W closes a pin here, so the press closes the open ones, as Close
+  // Folder's Tabs closes a folder's (F19), and what is left collapses. A page
+  // that asks answers Chromium's close, and the folder does not wait for it.
+  browser->GetTabStripModel()->CloseTabsOfFolder(folder, open);
+  CollapseFolderAfterClose(handle, browser);
+}
