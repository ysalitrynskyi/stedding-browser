+class LiveFoldersTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  struct Answer {
+    int status = net::HTTP_OK;
+    std::string body = live_folders::recorded::kNothing;
+  };
+
+  // The test factory answers from before the browser starts: a folder made
+  // in a PRE_ step refreshes as the next start opens its token.
+  void SetUpInProcessBrowserTestFixture() override {
+    VerticalTabsBrowserTestMixin<
+        InProcessBrowserTest>::SetUpInProcessBrowserTestFixture();
+    const std::string name =
+        testing::UnitTest::GetInstance()->current_test_info()->name();
+    if (name.find("ComeBack") != std::string::npos) {
+      AnswerTheFirstList();
+    }
+    factory_.SetInterceptor(
+        base::BindLambdaForTesting([this](const network::ResourceRequest& r) {
+          Seen seen;
+          seen.url = r.url;
+          seen.authorization =
+              r.headers.GetHeader("Authorization").value_or("");
+          seen.cookie = r.headers.GetHeader("Cookie").value_or("");
+          seen.credentials_omitted =
+              r.credentials_mode == network::mojom::CredentialsMode::kOmit;
+          seen_.push_back(seen);
+          std::string q;
+          net::GetValueForKeyInQuery(r.url, "q", &q);
+          const std::string who = q.substr(q.rfind(' ') + 1);
+          const Answer answer =
+              answers_.contains(who) ? answers_[who] : Answer();
+          factory_.AddResponse(r.url.spec(), answer.body,
+                               static_cast<net::HttpStatusCode>(answer.status));
+        }));
+    LiveFolderService::SetURLLoaderFactoryForTesting(
+        factory_.GetSafeWeakWrapper());
+  }
+
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    // The store is filled from the first window a turn after it settles
+    // (windows G19); a folder is made only into a filled store.
+    ASSERT_TRUE(base::test::RunUntil([&] { return Store().ready(); }));
+  }
+
+  void TearDownOnMainThread() override {
+    LiveFolderService::SetURLLoaderFactoryForTesting(nullptr);
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::TearDownOnMainThread();
+  }
+
+  Profile* profile() { return browser()->GetProfile(); }
+
+  LiveFolderService& Service() {
+    LiveFolderService* const service =
+        live_folders::LiveFolderServiceFactory::GetForProfile(profile());
+    CHECK(service);
+    return *service;
+  }
+
+  spaces::PinStore& Store() {
+    spaces::PinStore* const store =
+        spaces::PinStoreFactory::GetForProfile(profile());
+    CHECK(store);
+    return *store;
+  }
+
+  static spaces::SpaceModel& Model(BrowserWindowInterface* window) {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(window);
+    CHECK(model);
+    return *model;
+  }
+
+  // The answers of a refresh: the person opened #42 and #7, is asked to
+  // review #45, and is mentioned in #42.
+  void AnswerTheFirstList() {
+    answers_["author:@me"] = {net::HTTP_OK, live_folders::recorded::kAuthored};
+    answers_["review-requested:@me"] = {
+        net::HTTP_OK, live_folders::recorded::kReviewRequested};
+    answers_["mentions:@me"] = {net::HTTP_OK,
+                                live_folders::recorded::kMentioned};
+  }
+
+  Failure Make() {
+    base::test::TestFuture<Failure> made;
+    Service().Make(kToken, Model(browser()).active_id(), made.GetCallback());
+    return made.Get();
+  }
+
+  // Lf4's refresh without the minute's wait, which the scheduler's own tests
+  // cover; waits for its answer.
+  void RefreshAndWait() {
+    const size_t before = seen_.size();
+    Service().RefreshNowForTesting();
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return seen_.size() >= before + 4 && !Service().refreshing_for_testing();
+    }));
+    base::RunLoop().RunUntilIdle();
+  }
+
+  // The window's rows of the live folder, in the strip's order.
+  static std::vector<tabs::TabInterface*> LiveRows(
+      BrowserWindowInterface* window) {
+    std::vector<tabs::TabInterface*> rows;
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      if (live_folders::IsLiveRowToken(
+              stedding::TabToken(tab->GetContents()))) {
+        rows.push_back(tab);
+      }
+    }
+    return rows;
+  }
+
+  // Lf5, Lf8: the tabs of `window` at `url`, whatever their token: a row
+  // that should have closed is found even after it was given a new one.
+  static size_t TabsAt(BrowserWindowInterface* window, const GURL& url) {
+    size_t count = 0;
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      content::WebContents* const contents =
+          strip->GetTabAtIndex(i)->GetContents();
+      count += contents->GetVisibleURL() == url ||
+               contents->GetLastCommittedURL() == url;
+    }
+    return count;
+  }
+
+  static std::vector<std::u16string> Names(
+      const std::vector<tabs::TabInterface*>& rows) {
+    std::vector<std::u16string> names;
+    for (tabs::TabInterface* tab : rows) {
+      names.push_back(stedding::TabName(tab->GetContents()));
+    }
+    return names;
+  }
+
+  static const tabs::FolderTabCollection* FolderOf(tabs::TabInterface* tab) {
+    const tabs::TabCollection* const parent = tab->GetParentCollection();
+    return parent && parent->type() == tabs::TabCollection::Type::FOLDER
+               ? static_cast<const tabs::FolderTabCollection*>(parent)
+               : nullptr;
+  }
+
+  static bool Asleep(tabs::TabInterface* tab) {
+    content::WebContents* const contents = tab->GetContents();
+    return contents->WasDiscarded() ||
+           contents->GetController().NeedsReload();
+  }
+
+  // The drawn header of `folder` in the browser's window, once the rows are
+  // in place.
+  FolderView* DrawnFolder(const tabs::FolderTabCollection* folder) {
+    views::Widget* const widget =
+        BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+    views::test::RunScheduledLayout(widget);
+    return stedding::test::FindDrawnFolder(widget->GetRootView(), folder);
+  }
+
+  BrowserWindowInterface* OpenWindow() {
+    ui_test_utils::BrowserCreatedObserver opened;
+    chrome::ExecuteCommand(browser(), IDC_NEW_WINDOW);
+    BrowserWindowInterface* const window = opened.Wait();
+    EXPECT_TRUE(window);
+    base::RunLoop().RunUntilIdle();
+    return window;
+  }
+
+  struct Seen {
+    GURL url;
+    std::string authorization;
+    std::string cookie;
+    bool credentials_omitted = false;
+  };
+
+  network::TestURLLoaderFactory factory_;
+  std::map<std::string, Answer> answers_;
+  std::vector<Seen> seen_;
+};
