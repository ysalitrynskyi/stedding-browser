+// toolbar T62 (BACKLOG S-468, GitHub issue 101): a page that dims itself
+// under its own dialog leaves the row its colour. The header is blue; a click
+// puts a dark layer over the whole page, as Discord's profile card does, and
+// the row stays blue; it stays blue when the layer goes, and a later click
+// that turns the header green still turns the row green.
+IN_PROC_BROWSER_TEST_F(PageColourRowTest, APagesOwnDimmingLeavesTheRowAlone) {
+  constexpr SkColor kBlue = SkColorSetRGB(0x19, 0x76, 0xd2);
+  constexpr SkColor kGreen = SkColorSetRGB(0x38, 0x8e, 0x3c);
+  stedding::SetDarkPagesOn(browser()->GetProfile(), false);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(),
+      GURL("data:text/html,<body style='margin:0'>"
+           "<div id=h style='height:60px;background:%231976d2'></div>"
+           "<p>A header, and a dialog over a dark layer</p><script>"
+           "let clicks=0;addEventListener('mousedown',()=>{++clicks;"
+           "if(clicks==1){const d=document.createElement('div');d.id='dim';"
+           "d.style='position:fixed;inset:0;background:rgba(0,0,0,0.6)';"
+           "document.body.append(d);}"
+           "if(clicks==2){document.getElementById('dim').remove();}"
+           "if(clicks==3){document.getElementById('h').style.background="
+           "'%23388e3c';}});</script></body>")));
+  ASSERT_TRUE(WaitForTheRow(kBlue)) << "the header's blue colours the row";
+
+  int reads = 0;
+  row()->HoldTopReadsForTesting(
+      base::BindLambdaForTesting([&](base::OnceClosure take) {
+        std::move(take).Run();
+        ++reads;
+      }));
+  // A click asks for three reads of the edge (T31); two of them are made
+  // well after the page has painted what the click changed.
+  const auto click = [&]() {
+    const int before = reads;
+    content::SimulateMouseClickAt(page(), 0,
+                                  blink::WebMouseEvent::Button::kLeft,
+                                  gfx::Point(200, 200));
+    return base::test::RunUntil([&]() { return reads >= before + 2; });
+  };
+  {
+    SCOPED_TRACE("the page's dark layer");
+    ASSERT_TRUE(click()) << "the edge was not read after the click";
+    ASSERT_EQ(true, content::EvalJs(page(), "!!document.getElementById('dim')"));
+    EXPECT_TRUE(WaitForTheRow(kBlue)) << "the row went dark with the page";
+  }
+  {
+    SCOPED_TRACE("the layer goes");
+    ASSERT_TRUE(click()) << "the edge was not read after the click";
+    ASSERT_EQ(false,
+              content::EvalJs(page(), "!!document.getElementById('dim')"));
+    EXPECT_TRUE(WaitForTheRow(kBlue));
+  }
+  {
+    SCOPED_TRACE("the header changes colour");
+    ASSERT_TRUE(click()) << "the edge was not read after the click";
+    EXPECT_TRUE(WaitForTheRow(kGreen)) << "a real change is still followed";
+  }
+  row()->HoldTopReadsForTesting(
+      base::RepeatingCallback<void(base::OnceClosure)>());
+}
