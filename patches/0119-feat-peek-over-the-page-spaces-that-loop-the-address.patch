+      page, Url("b.test", "/title2.html")));
+  EXPECT_EQ(page, stedding::PeekOverPageOfActiveTab(browser()));
+  ASSERT_EQ(2, page->GetController().GetEntryCount());
+  ASSERT_TRUE(content::ExecJs(page, "window.kept = 1;"));
