+// tabs R14, import I3 (BACKLOG S-431, GitHub issue 80): a name given in Arc is
+// the tab's name. It stays when the page loads, and when the tab closes back to
+// its pin, for a pin, a pin in a folder and an essential. It was the title of a
+// page not yet loaded: the page's own replaced it for good.
+IN_PROC_BROWSER_TEST_F(ArcImportTest, ANameGivenInArcOutlivesThePage) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::WriteFile(
+        arc_.Append(FILE_PATH_LITERAL("StorableSidebar.json")),
+        base::ReplaceStringPlaceholders(
+            kArcNamedTabs,
+            {embedded_test_server()->GetURL("/title1.html").spec(),
+             embedded_test_server()->GetURL("/title2.html").spec(),
+             embedded_test_server()->GetURL("/title3.html").spec()},
+            nullptr)));
+  }
+  content::WebContents* const page = OpenSettings();
+  ASSERT_TRUE(page);
+  ImportFromSettings(page);
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  const auto tab_at = [&](std::string_view path) -> tabs::TabInterface* {
+    const GURL url = embedded_test_server()->GetURL(path);
+    for (int i = 0; i < strip->count(); ++i) {
+      if (strip->GetWebContentsAt(i)->GetVisibleURL() == url) {
+        return strip->GetTabAtIndex(i);
+      }
+    }
+    return nullptr;
+  };
+  for (const auto& [path, name] :
+       std::vector<std::pair<std::string_view, std::u16string_view>>{
+           {"/title1.html", u"My pin"},
+           {"/title2.html", u"My doc"},
+           {"/title3.html", u"My essential"}}) {
+    SCOPED_TRACE(path);
+    tabs::TabInterface* const tab = tab_at(path);
+    ASSERT_TRUE(tab);
+    EXPECT_EQ(name, stedding::TabName(tab->GetContents()))
+        << "unloaded, before it is opened";
+    content::TestNavigationObserver loaded(tab->GetContents());
+    strip->ActivateTabAt(strip->GetIndexOfTab(tab));
+    loaded.Wait();
+    EXPECT_NE(name, tab->GetContents()->GetTitle()) << "the page has its own";
+    EXPECT_EQ(name, stedding::TabName(tab->GetContents())) << "the page's load";
+    EXPECT_EQ(name, TabUIHelper::From(tab)->GetTitle()) << "what the row shows";
+
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return strip->GetIndexOfTab(tab) != TabStripModel::kNoTab &&
+             strip->GetActiveTab() != tab;
+    })) << "it closes back to its pin";
+    EXPECT_EQ(name, stedding::TabName(tab->GetContents())) << "back at its pin";
+    EXPECT_EQ(name, TabUIHelper::From(tab)->GetTitle());
+  }
+}
