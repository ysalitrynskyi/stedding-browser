+
+// The command bar in a right-to-left window (docs/features/commandbar.md K20,
+// PLAN.md SPC-6): it sits over the page card, centred, with the sidebar open
+// at the window's right.
+
+#include <cstdlib>
+
+#include "base/command_line.h"
+#include "base/i18n/base_i18n_switches.h"
+#include "base/i18n/rtl.h"
+#include "base/run_loop.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_commands.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/views/commandbar/command_bar_view.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "content/public/test/browser_test.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+class CommandBarRtlW2B23Test : public InProcessBrowserTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(switches::kForceUIDirection,
+                                    switches::kForceDirectionRTL);
+  }
+};
+
+// P31-1e; commandbar K20. The bar was placed from the page card's bounds as
+// painted, which a right-to-left window mirrors, and its own bounds were then
+// mirrored again: with the sidebar open, at the window's right, the bar was
+// centred over the card's mirror image, off centre by the sidebar's width
+// and over the sidebar. It sits over the card, centred on it.
+IN_PROC_BROWSER_TEST_F(CommandBarRtlW2B23Test, TheBarSitsOverThePageCard) {
+  ASSERT_TRUE(base::i18n::IsRTL());
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(view);
+  tabs::VerticalTabStripStateController* const sidebar =
+      tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(sidebar && sidebar->ShouldDisplayVerticalTabs());
+  ASSERT_FALSE(sidebar->IsCollapsed()) << "the premise: the sidebar is open";
+  view->GetWidget()->SetBounds(gfx::Rect(0, 0, 1200, 700));
+  views::test::RunScheduledLayout(view);
+
+  const gfx::Rect card = view->contents_container()->GetBoundsInScreen();
+  const gfx::Rect window = view->GetBoundsInScreen();
+  ASSERT_GT(std::abs(card.CenterPoint().x() - window.CenterPoint().x()), 40)
+      << "the premise: the sidebar takes a side of the window; the card is "
+      << card.ToString() << " in " << window.ToString();
+
+  chrome::ExecuteCommand(browser(), IDC_NEW_TAB);  // Cmd-T
+  stedding::CommandBarView* const bar =
+      stedding::CommandBarView::GetOpenBar(view);
+  ASSERT_TRUE(bar) << "Cmd-T opened no bar";
+  views::test::RunScheduledLayout(view);
+
+  const gfx::Rect placed = bar->GetBoundsInScreen();
+  EXPECT_NEAR(card.CenterPoint().x(), placed.CenterPoint().x(), 2)
+      << "the bar " << placed.ToString() << " is not centred on the card "
+      << card.ToString();
+  EXPECT_GE(placed.x(), card.x())
+      << "the bar " << placed.ToString() << " runs past the card "
+      << card.ToString();
+  EXPECT_LE(placed.right(), card.right())
+      << "the bar " << placed.ToString() << " runs past the card "
+      << card.ToString();
+  bar->Close();
+  base::RunLoop().RunUntilIdle();
+}
+
+}  // namespace
