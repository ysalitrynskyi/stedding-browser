+  recent_moves_.clear();
+  space_swipe_.on_end.Run(offset, flick);
+}
+
+bool VerticalTabStripFocusSwipeController::SpaceSwipeIsFlick() const {
+  if (recent_moves_.size() < 2) {
+    return false;
+  }
+  float distance = 0.0f;
+  for (const auto& move : recent_moves_) {
+    distance += move.second;
+  }
+  const base::TimeDelta span =
+      recent_moves_.back().first - recent_moves_.front().first;
+  // Moves too close together to time -- a burst the system delivered at
+  // once -- say nothing about speed.
+  if (span < kFlickMinSpan) {
+    return false;
+  }
+  // A flick goes the way the swipe went.
+  return std::abs(distance) / static_cast<float>(span.InMillisecondsF()) >=
+             kFlickSpeed &&
+         (distance < 0) == (cumulative_x_ < 0);
+}
