+// Pn9: the list follows a download live -- in progress with its progress,
+// then finished -- and the search narrows it.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsTest, DownloadsSearchesAndUpdatesLive) {
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_DOWNLOADS));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kDownloads));
+  download::DownloadItem* const item = StartSlowDownload();
+  ASSERT_TRUE(item);
+  const std::string id = base::NumberToString(item->GetId());
+  ASSERT_TRUE(WaitForRows(1));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(), RowFor("id", id) + ".dataset.state")
+               .ExtractString() == "kInProgress";
+  }));
+  EXPECT_EQ(true, content::EvalJs(panel_page(),
+                                  "!!" + RowFor("id", id) +
+                                      ".querySelector('.progress')"));
+
+  content::DownloadTestObserverTerminal done(
+      manager(), 1, content::DownloadTestObserver::ON_DANGEROUS_DOWNLOAD_FAIL);
+  ui_test_utils::NavigateToURLWithDisposition(
+      browser(),
+      embedded_test_server()->GetURL(
+          content::SlowDownloadHttpResponse::kFinishSlowResponseUrl),
+      WindowOpenDisposition::NEW_BACKGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_NO_WAIT);
+  done.WaitForFinished();
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(), RowFor("id", id) + ".dataset.state")
+               .ExtractString() == "kComplete";
+  })) << "the row did not follow the download to its end";
+
+  Search("no-such-download-anywhere");
+  EXPECT_TRUE(WaitForRows(0));
+  Search("");
+  EXPECT_TRUE(WaitForRows(1));
+}
