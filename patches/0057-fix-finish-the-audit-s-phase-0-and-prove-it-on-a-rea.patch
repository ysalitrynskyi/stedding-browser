+// Every moment on the way through a change at which the active tab is one
+// the sidebar hides: a tab of another Space than the active one. Checked at
+// each notification of the strip and of the Spaces, not once it settled.
+class HiddenActiveTabWatcher : public TabStripModelObserver,
+                               public spaces::SpaceModel::Observer {
+ public:
+  HiddenActiveTabWatcher(TabStripModel* strip, spaces::SpaceModel* model)
+      : strip_(strip), model_(model) {
+    strip->AddObserver(this);
+    observation_.Observe(model);
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* strip,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    Check("a strip change");
+  }
+
+  // spaces::SpaceModel::Observer:
+  void OnActiveSpaceChanged(const spaces::SpaceId& from,
+                            const spaces::SpaceId& to) override {
+    Check("a Space change");
+  }
+  void OnTabSpaceChanged(tabs::TabInterface* tab) override {
+    Check("a tab's Space change");
+  }
+  void OnSpaceModelDestroying() override { observation_.Reset(); }
+
+  const std::vector<std::string>& seen() const { return seen_; }
+  // What the test is doing, for the record of a hidden tab.
+  void set_step(std::string step) { step_ = std::move(step); }
+
+ private:
+  void Check(const char* when) {
+    tabs::TabInterface* const active = strip_->GetActiveTab();
+    if (active && observation_.IsObserving() &&
+        !model_->IsTabInActiveSpace(active)) {
+      seen_.push_back(step_ + ", " + when);
+    }
+  }
+
+  raw_ptr<TabStripModel> strip_;
+  raw_ptr<spaces::SpaceModel> model_;
+  base::ScopedObservation<spaces::SpaceModel, spaces::SpaceModel::Observer>
+      observation_{this};
+  std::vector<std::string> seen_;
+  std::string step_;
+};
