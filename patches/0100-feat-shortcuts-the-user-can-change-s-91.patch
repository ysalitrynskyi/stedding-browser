+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_service.h"
+
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/stedding/shortcut_catalog.h"
+#include "chrome/browser/ui/stedding/shortcut_chord.h"
+#include "chrome/browser/ui/stedding/shortcut_editor.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/testing_pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace stedding::shortcuts {
+namespace {
+
+class ShortcutServiceTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    prefs::RegisterLocalStatePrefs(local_state_.registry());
+  }
+  void TearDown() override { SetSystemHotKeysForTesting(nullptr); }
+
+  TestingPrefServiceSimple local_state_;
+};
+
+// docs/features/shortcuts.md Z10: Local State starts with no entry, and the
+// rows have their defaults.
+TEST_F(ShortcutServiceTest, NothingIsStoredUntilARowChanges) {
+  EXPECT_TRUE(local_state_.GetDict(prefs::kShortcutsUser).empty());
+  EXPECT_TRUE(Resolve(local_state_.GetDict(prefs::kShortcutsUser)).empty());
+  const RowState state = RowStateOf(&local_state_, *EntryForName("new-tab"));
+  EXPECT_FALSE(state.changed);
+  EXPECT_EQ(state.defaults, state.chords);
+  EXPECT_FALSE(state.defaults.empty());
+}
+
+// Z15: a shortcut macOS has on (read on this machine; injected here) is
+// refused, and nothing is written.
+TEST_F(ShortcutServiceTest, ASystemShortcutIsRefused) {
+  const Chord chord(ui::VKEY_J, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                                    ui::EF_SHIFT_DOWN);
+  const std::vector<Chord> hot_keys = {chord};
+  SetSystemHotKeysForTesting(&hot_keys);
+  OutsideHolders outside;
+  outside.system_hotkey = IsSystemHotKey(chord);
+  EXPECT_TRUE(outside.system_hotkey);
+  EXPECT_FALSE(IsSystemHotKey(Chord(ui::VKEY_K, ui::EF_CONTROL_DOWN)));
+  const CheckResult result = AddShortcut(
+      &local_state_, *EntryForName("clear-space"), chord, /*replace=*/true,
+      outside);
+  EXPECT_EQ(CheckKind::kRefused, result.kind);
+  EXPECT_NE(std::u16string::npos, result.message.find(u"macOS"))
+      << base::UTF16ToUTF8(result.message);
+  EXPECT_TRUE(local_state_.GetDict(prefs::kShortcutsUser).empty());
+}
+
+// Z15: an extension's chord, found in any profile on the machine, is refused
+// with the extension's name and the page where its keys change.
+TEST_F(ShortcutServiceTest, AnExtensionsChordIsRefused) {
+  const Chord chord(ui::VKEY_J, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                                    ui::EF_SHIFT_DOWN);
+  OutsideHolders outside;
+  outside.extension = u"Notes Keeper";
+  const CheckResult result =
+      CheckShortcut(&local_state_, *EntryForName("clear-space"), chord, outside);
+  EXPECT_EQ(CheckKind::kRefused, result.kind);
+  EXPECT_NE(std::u16string::npos, result.message.find(u"“Notes Keeper”"));
+  EXPECT_NE(std::u16string::npos,
+            result.message.find(u"chrome://extensions/shortcuts"));
+}
+
+// Z5, Z10: the service's writes land in Local State, keyed by name.
+TEST_F(ShortcutServiceTest, WritesGoToLocalState) {
+  const Entry& clear = *EntryForName("clear-space");
+  const Chord chord(ui::VKEY_J, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+                                    ui::EF_SHIFT_DOWN);
+  ASSERT_EQ(CheckKind::kOk,
+            AddShortcut(&local_state_, clear, chord, /*replace=*/false,
+                        OutsideHolders())
+                .kind);
+  EXPECT_TRUE(local_state_.GetDict(prefs::kShortcutsUser)
+                  .FindDictByDottedPath("commands.clear-space"));
+  EXPECT_TRUE(Resolve(local_state_.GetDict(prefs::kShortcutsUser))
+                  .IsChanged(clear.command));
+  ASSERT_TRUE(SetShortcutOff(&local_state_, clear, true));
+  EXPECT_TRUE(RowStateOf(&local_state_, clear).off);
+  ASSERT_TRUE(ResetShortcut(&local_state_, clear));
+  EXPECT_FALSE(RowStateOf(&local_state_, clear).changed);
+  ASSERT_TRUE(SetShortcutOff(&local_state_, clear, true));
+  ResetAllShortcuts(&local_state_);
+  EXPECT_FALSE(RowStateOf(&local_state_, clear).changed);
+}
+
+}  // namespace
+}  // namespace stedding::shortcuts
