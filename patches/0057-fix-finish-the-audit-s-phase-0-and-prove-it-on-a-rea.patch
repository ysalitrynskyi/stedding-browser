+std::vector<bool> TabStripLayoutHelper::SlotsFilteredOut() const {
+  std::vector<bool> filtered_out(slots_.size(), false);
+  std::set<tab_groups::TabGroupId> groups_with_an_open_tab;
+  std::set<tab_groups::TabGroupId> groups_with_a_shown_tab;
+  // Open tabs are numbered as the model numbers them; a closing tab has left
+  // the model already.
+  int model_index = 0;
+  for (size_t i = 0; i < slots_.size(); ++i) {
+    if (slots_[i].type != TabSlotView::ViewType::kTab ||
+        slots_[i].state.IsClosed()) {
+      continue;
