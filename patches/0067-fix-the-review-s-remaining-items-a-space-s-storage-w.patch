diff --git a/chrome/test/data/stedding/space_worker.html b/chrome/test/data/stedding/space_worker.html
new file mode 100644
index 0000000000000..7efb49ae5e299
--- /dev/null
+++ b/chrome/test/data/stedding/space_worker.html
@@ -0,0 +1,26 @@
+<!doctype html>
+<!-- Copyright 2026 The Stedding Authors
+     Use of this source code is governed by a BSD-style license that can be
+     found in the LICENSE file. -->
+<!-- A page whose service worker shows a notification and, when it is
+     clicked, opens a window (chrome/test/stedding/space_worker_browsertest.cc).
+     What the worker reports arrives in `messages`. -->
+<title>Space worker</title>
+<script>
+  window.messages = [];
+  navigator.serviceWorker.addEventListener(
+      'message', (event) => window.messages.push(event.data));
+  navigator.serviceWorker.startMessages();
+
+  async function register() {
+    await navigator.serviceWorker.register('space_worker.js');
+    await navigator.serviceWorker.ready;
+    return 'registered';
+  }
+
+  async function show() {
+    const registration = await navigator.serviceWorker.ready;
+    await registration.showNotification('Space', {tag: 'space'});
+    return 'shown';
+  }
+</script>
diff --git a/chrome/test/data/stedding/space_worker.js b/chrome/test/data/stedding/space_worker.js
new file mode 100644
index 0000000000000..3eba08d8106cc
--- /dev/null
+++ b/chrome/test/data/stedding/space_worker.js
@@ -0,0 +1,29 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Service worker for space_worker.html. A click on its notification opens a
+// window on the cookie echo and tells every page of the origin what happened.
+
+async function tell(message) {
+  const pages = await clients.matchAll(
+      {includeUncontrolled: true, type: 'window'});
+  for (const page of pages) {
+    page.postMessage(message);
+  }
+}
+
+self.addEventListener('install', () => self.skipWaiting());
+
+self.addEventListener('notificationclick', (event) => {
+  event.notification.close();
+  event.waitUntil((async () => {
+    await tell('clicked');
+    try {
+      const opened = await clients.openWindow('/echoheader?Cookie');
+      await tell(opened ? 'opened' : 'opened but not a client');
+    } catch (error) {
+      await tell('open failed: ' + error);
+    }
+  })());
+});
