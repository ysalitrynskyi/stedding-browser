+// toolbar T39 (2026-10-20): the extensions chord as the keyboard sends it on
+// the Mac, through the application's event queue -- where the bar's watch
+// on the held modifier sees each key before the window does -- and then the
+// window: Cmd down, E, then Escape with Cmd still down closes the bar, which
+// lists Manage Extensions alone, and letting go of Cmd runs nothing; so does
+// Cmd-Period, since macOS 27 lists Cmd-Escape among its system shortcuts and
+// a keyboard's did not reach the bar (it stayed open until a plain Escape).
+IN_PROC_BROWSER_TEST_F(SpaceKeysTest, EscapeWithTheExtensionsChordHeld) {
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(view);
+  view->GetWidget()->Activate();
+  NSWindow* const window =
+      view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  const auto post = [&](ui::KeyboardCode key, bool down, NSUInteger flags) {
+    NSEvent* const event =
+        cocoa_test_event_utils::SynthesizeKeyEvent(window, down, key, flags);
+    ASSERT_TRUE(event);
+    [NSApp postEvent:event atStart:NO];
+  };
+  post(ui::VKEY_COMMAND, true, NSEventModifierFlagCommand);
+  post(ui::VKEY_E, true, NSEventModifierFlagCommand);
+  post(ui::VKEY_E, false, NSEventModifierFlagCommand);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    stedding::CommandBarView* const bar =
+        stedding::CommandBarView::GetOpenBar(view);
+    return bar && bar->holding_chord_for_testing();
+  })) << "Cmd-E opened no bar";
+  post(ui::VKEY_ESCAPE, true, NSEventModifierFlagCommand);
+  post(ui::VKEY_ESCAPE, false, NSEventModifierFlagCommand);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !stedding::CommandBarView::GetOpenBar(view);
+  })) << "Escape with Cmd down left the bar open";
+  post(ui::VKEY_COMMAND, false, 0);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(stedding::CommandBarView::GetOpenBar(view));
+
+  // macOS 27 lists Cmd-Escape among its system shortcuts: Cmd-Period, the
+  // Mac's cancel, closes the bar too, ahead of the main menu's Stop, which
+  // has the chord.
+  post(ui::VKEY_COMMAND, true, NSEventModifierFlagCommand);
+  post(ui::VKEY_E, true, NSEventModifierFlagCommand);
+  post(ui::VKEY_E, false, NSEventModifierFlagCommand);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    stedding::CommandBarView* const bar =
+        stedding::CommandBarView::GetOpenBar(view);
+    return bar && bar->holding_chord_for_testing();
+  })) << "Cmd-E opened no bar";
+  post(ui::VKEY_OEM_PERIOD, true, NSEventModifierFlagCommand);
+  post(ui::VKEY_OEM_PERIOD, false, NSEventModifierFlagCommand);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !stedding::CommandBarView::GetOpenBar(view);
+  })) << "Cmd-Period with Cmd down left the bar open";
+  post(ui::VKEY_COMMAND, false, 0);
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(stedding::CommandBarView::GetOpenBar(view));
+}
+
 }  // namespace
