+std::optional<FolderView::DropPlace> FolderView::PlaceAtTheEndOf(
+    FolderView& target) {
+  tabs::FolderTabCollection* const into = target.folder();
+  tabs::FolderTabCollection* const folder = this->folder();
+  BrowserWindowInterface* const window = GetBrowserWindow();
+  TabStripModel* const model = window ? window->GetTabStripModel() : nullptr;
+  // Not into a folder of its own, nor deeper than folders nest (F39).
+  if (!into || !folder || !model || !model->CanMoveFolderInto(folder, into)) {
+    return std::nullopt;
+  }
+  DropPlace place;
+  place.into = into->GetHandle();
+  place.child_index = into->ChildCount();
+  place.target = &target;
+  // Already its last row: a release there moves nothing.
+  place.moves = into->ChildCount() == 0 ||
+                !IsChild(into->GetChildren().back(), folder);
+  return place;
+}
