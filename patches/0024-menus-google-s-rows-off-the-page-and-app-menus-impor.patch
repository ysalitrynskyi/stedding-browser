+      tab ? spaces::SpaceModel::From(tab->GetBrowserWindowInterface())
+          : nullptr;
+  if (!model) {
+    return std::u16string();
+  }
+  const std::optional<GURL> home = model->HomeUrl(tab);
+  if (!home) {
+    return std::u16string();
+  }
+  const std::u16string where =
+      tab->IsPinned()
+          ? u"Essentials"
+          : u"Pinned in " + model->DisplayName(model->SpaceForTab(tab));
+  return where + u" \u00B7 home " + base::UTF8ToUTF16(home->host());
+}
