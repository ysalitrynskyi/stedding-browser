+    EXPECT_EQ(page.bottom(), start.bottom());
+    EXPECT_EQ(page.bottom(), end.bottom());
+    EXPECT_EQ(stedding::kCardGutter.Get(), end.x() - start.right())
+        << "the pages are a card gutter apart";
+    // Each pane is cut as the page was: square under the row, the card's
+    // radius at its foot, or square where there is no gutter.
+    for (ContentsContainerView* const pane :
+         multi->contents_container_views()) {
+      EXPECT_EQ(multi->GetBackgroundRadii(), pane->GetRoundedCorners());
+    }
+    tabs->RemoveSplit(split);
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      views::test::RunScheduledLayout(browser_view()->GetWidget());
+      return !multi->IsInSplitView();
+    }));
+  }
+}
