+       press < 10 && !sidebar->Contains(focus->GetFocusedView()); ++press) {
+    chrome::ExecuteCommand(browser(), IDC_FOCUS_NEXT_PANE);
+  }
+  ASSERT_TRUE(sidebar->Contains(focus->GetFocusedView()))
+      << "F6 never brought the focus to the sidebar";
+
+  // Tab until Clear has the focus, and the way it went, to say where it
+  // stopped if it never does. The sidebar holds a few dozen controls at most.
+  std::vector<std::string> went;
+  for (int press = 0; press < 60 && !line->HasFocus(); ++press) {
+    ui::KeyEvent tab_key(ui::EventType::kKeyPressed, ui::VKEY_TAB,
+                         ui::EF_NONE);
+    widget->OnKeyEvent(&tab_key);
+    const views::View* const now = focus->GetFocusedView();
+    went.emplace_back(now ? now->GetClassName() : "nothing");
+  }
+  ASSERT_TRUE(line->HasFocus())
+      << "Tab never reached Clear; it went " << base::JoinString(went, ", ");
+  // The button's role is ClearLineTest.ClearIsAButtonTheKeyboardReaches's.
+  EXPECT_EQ(u"Clear", line->GetViewAccessibility().GetCachedName());
+
+  ui::KeyEvent enter(ui::EventType::kKeyPressed, ui::VKEY_RETURN, ui::EF_NONE);
+  widget->OnKeyEvent(&enter);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return tabs->count() == 1; }))
+      << "Return on Clear closed no tab";
+  EXPECT_EQ(kept, tabs->GetTabAtIndex(0)) << "the pinned run stays";
+}
