new file mode 100644
index 0000000000000..58043d249fd7a
--- /dev/null
+++ b/chrome/browser/ui/views/frame/stedding_window_buttons_mac.mm
@@ -0,0 +1,187 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "chrome/browser/ui/views/frame/stedding_window_buttons_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include <set>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/vertical_tab_strip_region_view.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+#include "ui/views/event_monitor.h"
+#include "ui/views/view_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace stedding {
+
+namespace {
+
+std::optional<gfx::Point>& PointerForTesting() {
+  static std::optional<gfx::Point> point;
+  return point;
+}
+
+std::set<WindowButtonsOverPageMac*>& Instances() {
+  static base::NoDestructor<std::set<WindowButtonsOverPageMac*>> instances;
+  return *instances;
+}
+
+constexpr NSWindowButton kLights[] = {
+    NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton};
+
+VerticalTabStripRegionView* StripOf(BrowserView* browser_view) {
+  if (!browser_view) {
+    return nullptr;
+  }
+  for (views::View* const child : browser_view->children()) {
+    if (auto* const strip =
+            views::AsViewClass<VerticalTabStripRegionView>(child)) {
+      return strip;
+    }
+  }
+  return nullptr;
+}
+
+}  // namespace
+
+// static
+void WindowButtonsOverPageMac::SetPointerForTesting(
+    std::optional<gfx::Point> screen_point) {
+  PointerForTesting() = screen_point;
+}
+
+// static
+void WindowButtonsOverPageMac::UpdateAllForTesting() {
+  for (WindowButtonsOverPageMac* const instance : Instances()) {
+    instance->Update();
+  }
+}
+
+WindowButtonsOverPageMac::WindowButtonsOverPageMac(BrowserView* browser_view,
+                                                   NSWindow* window)
+    : browser_view_(browser_view), window_(window) {
+  Instances().insert(this);
+  if (views::Widget* const widget =
+          browser_view_ ? browser_view_->GetWidget() : nullptr;
+      widget && widget->GetNativeWindow()) {
+    pointer_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        this, widget->GetNativeWindow(),
+        {ui::EventType::kMouseMoved, ui::EventType::kMouseExited});
+  }
+  Update();
+}
+
+WindowButtonsOverPageMac::~WindowButtonsOverPageMac() {
+  Instances().erase(this);
+  pointer_monitor_.reset();
+  view_observations_.RemoveAllObservations();
+  // A window this no longer looks after keeps its lights.
+  SetLightsHidden(false);
+}
+
+void WindowButtonsOverPageMac::ObserveViews() {
+  if (!browser_view_) {
+    return;
+  }
+  // The strip's bounds change as the sidebar closes to nothing, opens or
+  // slides in over the page; the row's visibility, and the top container's
+  // height, as the row hides or shows. The window may be made before the
+  // browser's views are, so each is looked for again until it is found.
+  views::View* const views_to_observe[] = {StripOf(browser_view_),
+                                           browser_view_->toolbar(),
+                                           (browser_view_->toolbar() ? browser_view_->toolbar()->parent() : nullptr)};
+  for (views::View* const view : views_to_observe) {
+    if (view && !view_observations_.IsObservingSource(view)) {
+      view_observations_.AddObservation(view);
+    }
+  }
+}
+
+void WindowButtonsOverPageMac::Update() {
+  ObserveViews();
+  SetLightsHidden(LightsAreOverThePage() && !PointerIsNearTheLights());
+}
+
+void WindowButtonsOverPageMac::OnEvent(const ui::Event& event) {
+  Update();
+}
+
+void WindowButtonsOverPageMac::OnViewBoundsChanged(
+    views::View* observed_view) {
+  Update();
+}
+
+void WindowButtonsOverPageMac::OnViewVisibilityChanged(
+    views::View* observed_view,
+    views::View* starting_view, bool visible) {
+  Update();
+}
+
+void WindowButtonsOverPageMac::OnViewIsDeleting(views::View* observed_view) {
+  view_observations_.RemoveObservation(observed_view);
+}
+
+bool WindowButtonsOverPageMac::LightsAreOverThePage() const {
+  if (!browser_view_ || !window_) {
+    return false;
+  }
+  // macOS's full screen hides the lights with the title bar and brings them
+  // in with the row; that is its own (sidebar Y17, Y41).
+  const views::Widget* const widget = browser_view_->GetWidget();
+  if (!widget || widget->IsFullscreen()) {
+    return false;
+  }
+  // The sidebar hidden completely and not slid in over the page: a sidebar
+  // slid in starts under the lights (Y52), and they show over its top.
+  const VerticalTabStripRegionView* const strip = StripOf(browser_view_);
+  if (!strip || !strip->GetVisible() || !strip->IsHiddenCompletely() ||
+      strip->is_expanded_on_hover()) {
+    return false;
+  }
+  // The row hidden: shown, the lights sit on its bar (Y19).
+  return !browser_view_->IsToolbarVisible();
+}
+
+bool WindowButtonsOverPageMac::PointerIsNearTheLights() const {
+  if (!window_) {
+    return false;
+  }
+  // The lights' place in screen points: their frames, hidden or not, and a
+  // margin round them, so the pointer shows them before it reaches one.
+  NSRect place = NSZeroRect;
+  for (const NSWindowButton kind : kLights) {
+    NSButton* const button = [window_ standardWindowButton:kind];
+    if (!button) {
+      continue;
+    }
+    const NSRect in_window = [button convertRect:button.bounds toView:nil];
+    place = NSUnionRect(place, [window_ convertRectToScreen:in_window]);
+  }
+  if (NSIsEmptyRect(place)) {
+    return false;
+  }
+  place = NSInsetRect(place, -kRevealMargin, -kRevealMargin);
+  const NSPoint pointer = PointerForTesting()
+                              ? gfx::ScreenPointToNSPoint(*PointerForTesting())
+                              : [NSEvent mouseLocation];
+  return NSPointInRect(pointer, place);
+}
+
+void WindowButtonsOverPageMac::SetLightsHidden(bool hidden) {
+  if (!window_ || hidden == lights_hidden_) {
+    return;
+  }
+  lights_hidden_ = hidden;
+  for (const NSWindowButton kind : kLights) {
+    [[window_ standardWindowButton:kind] setHidden:hidden];
+  }
+}
+
+}  // namespace stedding
