+// Site controls (docs/features/site-controls.md, BACKLOG S-118; toolbar
+// T47): Stedding's controls in Chromium's page info, which the site chip
+// (toolbar T5) and the command bar's View Site Information (commandbar K33)
+// open. PageInfoMainView adds the strip under its header and the rows before
+// "Site settings"; it is built again each time the user comes back from a
+// subpage, and so are they.
+
+// Si1: which window the page `contents` shows is in, as the panel's rules
+// read it: a tab of a normal tabbed window -- not a little window, not a
+// peek -- in a normal or a private profile, with or without the profile's
+// Spaces; anything else is kOther, as it is while the Stedding window style
+// is off.
+SiteControlsWindow SiteControlsWindowFor(content::WebContents* contents);
+
+// Si10: what Chromium's Extensions row in page info runs for `contents`'s
+// window: the extensions menu, once page info has closed. Null when the
+// window has no extensions container (extensions turned off) or is not a
+// tabbed window the controls are for, so Chromium draws no row that does
+// nothing.
+base::RepeatingClosure SiteControlsExtensionsCallback(
+    content::WebContents* contents);
+
+// Si2-Si5: copy link, copy title, mute and picture in picture on the left;
+// zoom out, the zoom (a button that resets it) and zoom in on the right.
+class SiteControlsStripView : public views::View {
+  METADATA_HEADER(SiteControlsStripView, views::View)
+
+ public:
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kCopyLinkElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kCopyTitleElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kMuteElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kPictureInPictureElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kZoomOutElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kZoomResetElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kZoomInElementId);
+
+  enum class Action {
+    kCopyLink,
+    // An Option-click (Alt-click) on Copy link: the Markdown link (L7).
+    kCopyMarkdownLink,
+    kCopyTitle,
+    kToggleMute,
+    kTogglePictureInPicture,
+    kZoomOut,
+    kZoomReset,
+    kZoomIn,
+  };
+
+  // Si4: what the picture-in-picture key would do (media_keys.h).
+  enum class PictureInPicture { kNothing, kEnter, kExit };
+
+  struct State {
+    // Si2: whether the window's Copy link command is on: the sharing policy
+    // that turns off Shift-Cmd-C turns this off too (copy-link L7).
+    bool copy_link_enabled = true;
+    // Si4: whether the mute key would mute (MuteKeyWouldMute).
+    bool mute_would_mute = true;
+    PictureInPicture picture_in_picture = PictureInPicture::kNothing;
+    // Si5: the tab's zoom, in percent.
+    int zoom_percent = 100;
+  };
+
+  // The page and the window the strip acts on. A test gives its own.
+  class Delegate {
+   public:
+    virtual ~Delegate() = default;
+    // Called once, before the first GetState(): the strip to keep current
+    // when the page's state changes.
+    virtual void SetStrip(SiteControlsStripView* strip) {}
+    virtual State GetState() = 0;
+    // The window's chord for `command_id` as its menus print it (the Mac's
+    // or Windows' own accelerator tables), or empty when it has none.
+    virtual std::u16string ChordFor(int command_id) = 0;
+    virtual void Run(Action action) = 0;
+  };
+
+  explicit SiteControlsStripView(std::unique_ptr<Delegate> delegate);
+  SiteControlsStripView(const SiteControlsStripView&) = delete;
+  SiteControlsStripView& operator=(const SiteControlsStripView&) = delete;
+  ~SiteControlsStripView() override;
+
+  // Reads the state again: Mute's words and icon, Picture in picture's
+  // words and whether it is enabled, the zoom.
+  void Update();
+
+  views::ImageButton* copy_link() { return copy_link_; }
+  views::ImageButton* copy_title() { return copy_title_; }
+  views::ImageButton* mute() { return mute_; }
+  views::ImageButton* picture_in_picture() { return picture_in_picture_; }
+  views::ImageButton* zoom_out() { return zoom_out_; }
+  views::LabelButton* zoom_reset() { return zoom_reset_; }
+  views::ImageButton* zoom_in() { return zoom_in_; }
+
+ private:
+  views::ImageButton* AddIconButton(Action action,
+                                    ui::ElementIdentifier id,
+                                    views::View* parent);
+  void OnPressed(Action action, const ui::Event& event);
+  // The tooltip: the action's name, and its chord after it when it has one.
+  std::u16string Tooltip(const std::u16string& name, int command_id);
+
+  std::unique_ptr<Delegate> delegate_;
+  raw_ptr<views::ImageButton> copy_link_ = nullptr;
+  raw_ptr<views::ImageButton> copy_title_ = nullptr;
+  raw_ptr<views::ImageButton> mute_ = nullptr;
+  raw_ptr<views::ImageButton> picture_in_picture_ = nullptr;
+  raw_ptr<views::ImageButton> zoom_out_ = nullptr;
+  raw_ptr<views::LabelButton> zoom_reset_ = nullptr;
+  raw_ptr<views::ImageButton> zoom_in_ = nullptr;
+};
+
+// Si7-Si9: the session row, Clear site data, and the dark pages rows.
+class SiteControlsRowsView : public views::View {
+  METADATA_HEADER(SiteControlsRowsView, views::View)
+
+ public:
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kSessionElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kClearDataElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kDarkPagesElementId);
+  DECLARE_CLASS_ELEMENT_IDENTIFIER_VALUE(kDarkSiteElementId);
+
+  struct State {
+    State();
+    State(const State&);
+    State& operator=(const State&);
+    ~State();
+
+    // Si7: the session row's words, or none (no row).
+    std::optional<SessionName> session;
+    // Si8: whether Clear site data is offered.
+    bool clear_data = false;
+    // Si9: the Dark pages switch, and its state.
+    bool dark_switch = false;
+    bool dark_pages_on = false;
+    // Si9: the site Darken <site> names, or none (no row), and its state.
+    std::optional<std::u16string> dark_site;
+    bool site_darkened = false;
+  };
+
+  class Delegate {
+   public:
+    virtual ~Delegate() = default;
+    // Called once, before the first GetState(): the rows to keep current
+    // when the state changes elsewhere.
+    virtual void SetRows(SiteControlsRowsView* rows) {}
+    virtual State GetState() = 0;
+    virtual void ClearSiteData() = 0;
+    virtual void SetDarkPagesOn(bool on) = 0;
+    virtual void SetSiteDarkened(bool darkened) = 0;
+  };
+
+  explicit SiteControlsRowsView(std::unique_ptr<Delegate> delegate);
+  SiteControlsRowsView(const SiteControlsRowsView&) = delete;
+  SiteControlsRowsView& operator=(const SiteControlsRowsView&) = delete;
+  ~SiteControlsRowsView() override;
+
+  // Reads the state again: the session's words and mark, which rows show,
+  // and the switches.
+  void Update();
+
+  RichControlsContainerView* session_row() { return session_row_; }
+  IsolationMarkView* session_mark() { return session_mark_; }
+  RichHoverButton* clear_data() { return clear_data_; }
+  RichControlsContainerView* dark_pages_row() { return dark_pages_row_; }
+  views::ToggleButton* dark_pages() { return dark_pages_; }
+  RichControlsContainerView* dark_site_row() { return dark_site_row_; }
+  views::ToggleButton* dark_site() { return dark_site_; }
+
+ private:
+  std::unique_ptr<Delegate> delegate_;
+  raw_ptr<RichControlsContainerView> session_row_ = nullptr;
+  raw_ptr<IsolationMarkView> session_mark_ = nullptr;
+  raw_ptr<RichHoverButton> clear_data_ = nullptr;
+  raw_ptr<RichControlsContainerView> dark_pages_row_ = nullptr;
+  raw_ptr<views::ToggleButton> dark_pages_ = nullptr;
+  raw_ptr<RichControlsContainerView> dark_site_row_ = nullptr;
+  raw_ptr<views::ToggleButton> dark_site_ = nullptr;
+};
+
+// The strip and the rows for the page info of `contents`, or null when
+// RowsFor() says nothing of them applies (Si1). `navigation_handler` is the
+// page info bubble, which the strip and Clear close.
+std::unique_ptr<views::View> MaybeCreateSiteControlsStrip(
+    content::WebContents* contents,
+    PageInfoNavigationHandler* navigation_handler);
+std::unique_ptr<views::View> MaybeCreateSiteControlsRows(
+    content::WebContents* contents,
+    PageInfoNavigationHandler* navigation_handler);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PAGE_INFO_STEDDING_SITE_CONTROLS_VIEW_H_
