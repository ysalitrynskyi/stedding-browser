+}  // namespace
+
+// The blocking side: the open archive, or the folder, and the bookmark parser,
+// which must stay on one sequence.
+class SafariExportWorker {
+ public:
+  explicit SafariExportWorker(
+      std::unique_ptr<user_data_importer::ContentBookmarkParser> parser)
+      : parser_(std::move(parser)) {}
+  SafariExportWorker(const SafariExportWorker&) = delete;
+  SafariExportWorker& operator=(const SafariExportWorker&) = delete;
+  ~SafariExportWorker() = default;
+
+  using OpenedCallback = base::OnceCallback<void(SafariExportRead)>;
+
+  void Open(base::FilePath path, OpenedCallback done) {
+    zip_.reset();
+    folder_.clear();
+    SafariExportRead read;
+    base::FilePath bookmarks_file;
+    if (base::DirectoryExists(path)) {
+      read.summary.opened = true;
+      folder_ = path;
+      bookmarks_file = ReadFolder(path, read);
+    } else {
+      const std::string utf8 = path.AsUTF8Unsafe();
+      const std::vector<uint8_t> bytes(utf8.begin(), utf8.end());
+      rust::Box<user_data_importer::ResultOfZipFileArchive> opened =
+          user_data_importer::new_archive(base::SpanToRustSlice(bytes));
+      if (opened->err()) {
+        std::move(done).Run(std::move(read));
+        return;
+      }
+      zip_.emplace(opened->unwrap());
+      read.summary.opened = true;
+      bookmarks_file = ReadArchive(read);
+    }
+    if (bookmarks_file.empty() || !parser_) {
+      std::move(done).Run(std::move(read));
+      return;
+    }
+    // import I35: in the utility process. A parser that dies answers with
+    // an error rather than never.
+    BookmarkParser::BookmarkParsingCallback parsed =
+        mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+            base::BindOnce(&SafariExportWorker::OnBookmarksParsed,
+                           weak_factory_.GetWeakPtr(), std::move(read),
+                           std::move(done)),
+            BookmarkParser::BookmarkParsingResult(
+                base::unexpected(BookmarkParser::BookmarkParsingError::kOther)));
+    parser_->Parse(bookmarks_file, std::move(parsed));
+  }
+
+  SafariHistoryRead ReadHistory(base::Time now, size_t cap) {
+    if (!folder_.empty()) {
+      return ReadSafariHistoryFolder(folder_, now, cap);
+    }
+    SafariHistoryRead read;
+    if (!zip_) {
+      return read;
+    }
+    (*zip_)->parse_safari_history(
+        std::make_unique<CollectSafariVisits>(now, cap, read.rows, read.capped),
+        kHistoryBatch);
+    if (read.rows.size() > cap) {
+      read.capped = true;
+    }
+    KeepNewestRows(read.rows, cap);
+    return read;
+  }
+
+ private:
+  // import I34: an unzipped export, file by file. Returns the bookmarks
+  // file to parse, if there is one that is not too big.
+  base::FilePath ReadFolder(const base::FilePath& dir, SafariExportRead& read) {
+    base::FilePath bookmarks;
+    bool passwords_seen = false;
+    for (const base::FilePath& file : ExportFilesIn(dir)) {
+      // A size that cannot be read is over every limit: read as 0, it let
+      // the read run without one (BACKLOG S-346).
+      const std::optional<int64_t> known = base::GetFileSize(file);
+      const uint64_t size = known && *known >= 0
+                                ? static_cast<uint64_t>(*known)
+                                : std::numeric_limits<uint64_t>::max();
+      switch (KindOfSafariExportFile(file)) {
+        case SafariExportFile::kBookmarks:
+          if (!bookmarks.empty() || read.summary.bookmarks_too_big) {
+            break;
+          }
+          if (size > kMaxSafariBookmarksBytes) {
+            read.summary.bookmarks_too_big = true;
+          } else {
+            bookmarks = file;
+          }
+          break;
+        case SafariExportFile::kPasswords:
+          if (passwords_seen) {
+            break;
+          }
+          passwords_seen = true;
+          if (size > kMaxSafariPasswordsBytes) {
+            read.summary.passwords_too_big = true;
+          } else if (!base::ReadFileToStringWithMaxSize(
+                         file, &read.passwords_csv,
+                         kMaxSafariPasswordsBytes)) {
+            // Grown past the limit since its size was read, or unreadable.
+            if (read.passwords_csv.size() >= kMaxSafariPasswordsBytes) {
+              read.summary.passwords_too_big = true;
+            } else {
+              read.summary.passwords_unreadable = true;
+            }
+            read.passwords_csv.clear();
+          }
+          break;
+        case SafariExportFile::kHistory:
+          if (size > kMaxSafariHistoryFileBytes) {
+            ++read.summary.history_files_too_big;
+          } else {
+            read.summary.history = true;
+          }
+          break;
+        case SafariExportFile::kPaymentCards:
+          read.summary.cards = true;
+          break;
+        case SafariExportFile::kOther:
+          break;
+      }
+    }
+    return bookmarks;
+  }
+
+  // import I35: the archive, each part's size checked before it is unzipped.
+  // Returns the bookmarks page, written to a file of its own for the parser.
+  base::FilePath ReadArchive(SafariExportRead& read) {
+    using user_data_importer::FileType;
+    base::FilePath bookmarks;
+    const uint64_t bookmarks_size =
+        (*zip_)->get_file_size_bytes(FileType::Bookmarks);
+    if (bookmarks_size > kMaxSafariBookmarksBytes) {
+      read.summary.bookmarks_too_big = true;
+    } else if (bookmarks_size > 0) {
+      std::string html;
+      if ((*zip_)->unzip(FileType::Bookmarks, html) && !html.empty() &&
+          (temp_.IsValid() || temp_.CreateUniqueTempDir())) {
+        const base::FilePath file =
+            temp_.GetPath().Append(FILE_PATH_LITERAL("Bookmarks.html"));
+        if (base::WriteFile(file, html)) {
+          bookmarks = file;
+        }
+      }
+    }
+    const uint64_t passwords_size =
+        (*zip_)->get_file_size_bytes(FileType::Passwords);
+    if (passwords_size > kMaxSafariPasswordsBytes) {
+      read.summary.passwords_too_big = true;
+    } else if (passwords_size > 0 &&
+               !(*zip_)->unzip(FileType::Passwords, read.passwords_csv)) {
+      read.summary.passwords_unreadable = true;
+      read.passwords_csv.clear();
+    }
+    read.summary.history =
+        (*zip_)->get_file_size_bytes(FileType::SafariHistory) > 0;
+    // Its size only: the cards themselves are never read.
+    read.summary.cards =
+        (*zip_)->get_file_size_bytes(FileType::PaymentCards) > 0;
+    return bookmarks;
+  }
+
+  void OnBookmarksParsed(SafariExportRead read,
+                         OpenedCallback done,
+                         BookmarkParser::BookmarkParsingResult result) {
+    // The copy unzipped for the parser is not kept.
+    if (temp_.IsValid()) {
+      base::DeleteFile(
+          temp_.GetPath().Append(FILE_PATH_LITERAL("Bookmarks.html")));
+    }
+    if (result.has_value()) {
+      read.bookmarks = std::move(result->bookmarks);
+      // import I37: the Reading List, where a parser gives it apart, is a
+      // folder of bookmarks: Stedding's menus hide Chromium's reading list.
+      for (ImportedBookmarkEntry& entry : result->reading_list) {
+        entry.in_toolbar = false;
+        entry.path.insert(entry.path.begin(),
+                          std::u16string(u"Reading List"));
+        read.bookmarks.push_back(std::move(entry));
+      }
+      read.summary.bookmarks = CountPages(read.bookmarks);
+    }
+    std::move(done).Run(std::move(read));
+  }
+
+  std::optional<rust::Box<user_data_importer::ZipFileArchive>> zip_;
+  base::FilePath folder_;
+  std::unique_ptr<user_data_importer::ContentBookmarkParser> parser_;
+  base::ScopedTempDir temp_;
+  base::WeakPtrFactory<SafariExportWorker> weak_factory_{this};
+};
+
+bool SafariExportSummary::HoldsAnything() const {
+  return bookmarks > 0 || history || passwords > 0 || cards ||
+         bookmarks_too_big || passwords_too_big || too_many_passwords ||
+         history_files_too_big > 0;
+}
+
+std::u16string SummariseSafariExport(const SafariExportSummary& summary) {
+  if (!summary.opened || !summary.HoldsAnything()) {
+    return u"This is not a file Safari exported, or it holds nothing "
+           u"Stedding can bring in.";
+  }
+  std::vector<std::u16string> parts;
+  if (summary.bookmarks > 0) {
+    parts.push_back(CountOf(summary.bookmarks, u"bookmark", u"bookmarks"));
+  }
+  if (summary.history) {
+    parts.push_back(u"history");
+  }
+  if (summary.passwords > 0) {
+    parts.push_back(CountOf(summary.passwords, u"password", u"passwords"));
+  }
+  std::u16string line;
+  if (!parts.empty()) {
+    line = u"In the file: " + ListInWords(parts) + u".";
+  }
+  const auto add = [&line](std::u16string_view sentence) {
+    if (!line.empty()) {
+      line.push_back(u' ');
+    }
+    line.append(sentence);
+  };
+  if (summary.bookmarks_too_big) {
+    add(u"Its bookmarks are over 32 MB and cannot be read.");
+  }
+  if (summary.passwords_too_big) {
+    add(u"Its passwords file is over 1,000 KB, more than Stedding reads at "
+        u"once.");
+  } else if (summary.too_many_passwords) {
+    add(u"It holds more than 3,000 passwords, more than Stedding brings in "
+        u"at once.");
+  } else if (summary.passwords_unreadable) {
+    add(u"Its passwords file cannot be read.");
+  }
+  if (summary.history_files_too_big > 0) {
+    add(CountOf(summary.history_files_too_big, u"history file is",
+                u"history files are") +
+        u" over 64 MB and left out.");
+  }
+  if (summary.cards) {
+    add(u"Payment cards in the file are not imported.");
+  }
+  return line;
+}
+
+std::u16string DescribeSafariExportResult(const SafariExportResult& result) {
+  if (result.already_running) {
+    return u"Safari's export is being imported already.";
+  }
+  if (result.not_prepared) {
+    return u"Choose Safari's export first.";
+  }
+  std::vector<std::u16string> parts;
+  if (result.bookmarks > 0) {
+    parts.push_back(CountOf(result.bookmarks, u"bookmark", u"bookmarks"));
+  }
+  if (result.history > 0) {
+    parts.push_back(
+        CountOf(result.history, u"history entry", u"history entries"));
+  }
+  if (result.passwords.added > 0) {
+    parts.push_back(
+        CountOf(result.passwords.added, u"password", u"passwords"));
+  }
+  std::u16string line =
+      parts.empty() ? std::u16string(u"Nothing new came in from Safari.")
+                    : u"Brought in from Safari: " + ListInWords(parts) + u".";
+  const auto add = [&line](const std::u16string& sentence) {
+    line.push_back(u' ');
+    line.append(sentence);
+  };
+  if (result.bookmarks_already > 0) {
+    add(CountOf(result.bookmarks_already, u"bookmark was", u"bookmarks were") +
+        u" there already.");
+  }
+  if (result.history_capped) {
+    add(u"Only the newest 100,000 history entries were read.");
+  }
+  if (result.history_files_too_big > 0) {
+    add(CountOf(result.history_files_too_big, u"history file over 64 MB was",
+                u"history files over 64 MB were") +
+        u" left out.");
+  }
+  if (result.passwords.kept > 0) {
+    add(CountOf(result.passwords.kept, u"password", u"passwords") +
+        u" saved with another password " +
+        (result.passwords.kept == 1 ? u"was" : u"were") +
+        u" kept as saved.");
+  }
+  if (result.passwords.already_saved > 0) {
+    add(CountOf(result.passwords.already_saved, u"password was",
+                u"passwords were") +
+        u" saved already.");
+  }
+  if (result.passwords.refused > 0) {
+    add(CountOf(result.passwords.refused, u"row", u"rows") +
+        u" of the passwords file could not be used.");
+  }
+  if (result.passwords.unavailable) {
+    add(u"This profile cannot save passwords.");
+  }
+  if (result.passwords_blocked) {
+    add(u"Your administrator has turned off importing passwords.");
+  } else if (!result.passwords_asked && result.passwords_in_file > 0) {
+    add(u"Passwords were left out: tick Passwords to bring them in.");
+  } else if (result.passwords_asked && result.passwords_in_file > 0) {
+    add(u"The export holds your passwords as plain text; you can delete it "
+        u"now.");
+  }
+  if (result.bookmarks_blocked) {
+    add(u"Your administrator has turned off importing bookmarks.");
+  }
+  if (result.history_blocked) {
+    add(u"Your administrator has turned off importing history.");
+  }
+  if (result.cards) {
+    add(u"Payment cards are not imported.");
+  }
+  return line;
+}
+
+std::optional<history::URLRow> SafariHistoryRow(const SafariVisit& visit,
+                                                base::Time now) {
+  const GURL url(visit.url);
+  if (!url.is_valid() || !IsWebScheme(url)) {
+    return std::nullopt;
+  }
+  if (visit.time_usec == 0 ||
+      visit.time_usec >
+          static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
+    return std::nullopt;
+  }
+  const base::Time when =
+      base::Time::UnixEpoch() +
+      base::Microseconds(static_cast<int64_t>(visit.time_usec));
+  // Kept for 90 days, and not from ahead of now: such a visit sorted as the
+  // newest, filled the cap ahead of every real one, and outlived the expiry
+  // (BACKLOG S-346).
+  if (when < OldestKeptVisit(now) || when > LatestKeptVisit(now)) {
+    return std::nullopt;
+  }
+  // A hop that redirected on to another page is not a page that was seen.
+  if (!visit.destination_url.empty() &&
+      IsRedirect(url, GURL(visit.destination_url))) {
+    return std::nullopt;
+  }
+  if (!visit.source_url.empty() && !visit.destination_url.empty()) {
+    const GURL source(visit.source_url);
+    const GURL destination(visit.destination_url);
+    if ((source.has_scheme() && !IsWebScheme(source)) ||
+        (destination.has_scheme() && !IsWebScheme(destination)) ||
+        IsRedirect(source, destination)) {
+      return std::nullopt;
+    }
+  }
+  history::URLRow row(url);
+  row.set_title(base::UTF8ToUTF16(visit.title));
+  row.set_visit_count(static_cast<int>(std::clamp<uint64_t>(
+      visit.visit_count, 1, std::numeric_limits<int>::max())));
+  row.set_typed_count(0);
+  row.set_last_visit(when);
+  return row;
+}
+
+void KeepNewestRows(history::URLRows& rows, size_t cap) {
+  std::ranges::sort(rows, std::ranges::greater(), &history::URLRow::last_visit);
+  if (rows.size() > cap) {
+    rows.erase(rows.begin() + static_cast<ptrdiff_t>(cap), rows.end());
+  }
+}
+
+SafariHistoryRead::SafariHistoryRead() = default;
+SafariHistoryRead::SafariHistoryRead(SafariHistoryRead&&) = default;
+SafariHistoryRead& SafariHistoryRead::operator=(SafariHistoryRead&&) = default;
+SafariHistoryRead::~SafariHistoryRead() = default;
+
+SafariHistoryRead ReadSafariHistoryFolder(const base::FilePath& dir,
+                                          base::Time now,
+                                          size_t cap,
+                                          uint64_t max_file_bytes) {
+  SafariHistoryRead read;
+  for (const base::FilePath& file : ExportFilesIn(dir)) {
+    if (KindOfSafariExportFile(file) != SafariExportFile::kHistory) {
+      continue;
+    }
+    // A size that cannot be read is no size under the limit, and the read
+    // stops at the limit whatever the size said (BACKLOG S-346).
+    const std::optional<int64_t> size = base::GetFileSize(file);
+    if (!size || *size < 0 || static_cast<uint64_t>(*size) > max_file_bytes) {
+      ++read.files_too_big;
+      continue;
+    }
+    std::string json;
+    if (!base::ReadFileToStringWithMaxSize(file, &json, max_file_bytes)) {
+      if (json.size() >= max_file_bytes) {
+        ++read.files_too_big;
+      }
+      continue;
+    }
+    const std::optional<base::DictValue> root =
+        base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+    json.clear();
+    if (!root) {
+      continue;
+    }
+    const std::string* const type =
+        root->FindStringByDottedPath("metadata.data_type");
+    const base::ListValue* const entries = root->FindList("history");
+    if (!type || *type != "history" || !entries) {
+      continue;
+    }
+    for (const base::Value& item : *entries) {
+      const base::DictValue* const entry = item.GetIfDict();
+      if (!entry) {
+        continue;
+      }
+      SafariVisit visit;
+      visit.url = StringOr(*entry, "url");
+      visit.title = StringOr(*entry, "title");
+      visit.source_url = StringOr(*entry, "source_url");
+      visit.destination_url = StringOr(*entry, "destination_url");
+      visit.time_usec = ToUint64(entry->Find("time_usec")).value_or(0);
+      visit.visit_count = ToUint64(entry->Find("visit_count")).value_or(1);
+      Collect(visit, now, cap, read.rows, read.capped);
+    }
+  }
+  if (read.rows.size() > cap) {
+    read.capped = true;
+  }
+  KeepNewestRows(read.rows, cap);
+  return read;
+}
+
+SafariExportFile KindOfSafariExportFile(const base::FilePath& file) {
+  const std::string name = file.BaseName().AsUTF8Unsafe();
+  if (name.empty() || name.front() == '.') {
+    return SafariExportFile::kOther;
+  }
+  if (file.MatchesFinalExtension(FILE_PATH_LITERAL(".html"))) {
+    return SafariExportFile::kBookmarks;
+  }
+  if (file.MatchesFinalExtension(FILE_PATH_LITERAL(".csv"))) {
+    return SafariExportFile::kPasswords;
+  }
+  if (!file.MatchesFinalExtension(FILE_PATH_LITERAL(".json"))) {
+    return SafariExportFile::kOther;
+  }
+  // The metadata comes first in each of Safari's files, so the file is read
+  // a little at a time and no further than the chunk that ends the type the
+  // metadata names: a payment cards file's cards are not read in.
+  base::File json(file, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!json.IsValid()) {
+    return SafariExportFile::kOther;
+  }
+  std::string head;
+  std::optional<std::string> type;
+  std::array<uint8_t, kJsonChunkBytes> chunk = {};
+  while (head.size() < kJsonHeadBytes) {
+    const std::optional<size_t> read = json.ReadAtCurrentPos(chunk);
+    if (!read || *read == 0) {
+      break;
+    }
+    head.append(base::as_string_view(
+        base::span<const uint8_t>(chunk).first(*read)));
+    type = JsonDataType(head);
+    if (type) {
+      break;
+    }
+  }
+  if (type == "history") {
+    return SafariExportFile::kHistory;
+  }
+  if (type == "payment_cards") {
+    return SafariExportFile::kPaymentCards;
+  }
+  return SafariExportFile::kOther;
+}
