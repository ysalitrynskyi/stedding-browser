+// I11, spaces B6: `nodes` as essentials, unloaded, after those already
+// here: the shared row's when `own` is none, else the ones Space `own` has
+// as its own -- which it keeps only while it has its own session. Twelve at
+// most in a row (I11). Nothing open now under an id comes in twice: an
+// essential open in the window was inserted again at every import of a
+// file that held it (docs/history/plan-2026-09-26.md WEB-F29).
+void InsertEssentials(ApplyContext& ctx,
+                      const std::vector<Node>& nodes,
+                      const std::optional<SpaceId>& own) {
+  if (nodes.empty()) {
+    return;
+  }
+  size_t in_row = 0;
+  for (int i = 0; i < ctx.tabs->count(); ++i) {
+    const tabs::TabInterface* const tab = ctx.tabs->GetTabAtIndex(i);
+    const bool counts =
+        own ? (ctx.model->IsOwnEssential(tab) &&
+               ctx.model->FindSpaceForTab(tab) == *own)
+            : ctx.model->IsSharedEssential(tab);
+    if (counts) {
+      ++in_row;
+    }
+  }
+  for (const Node& node : nodes) {
+    if (node.kind != Node::Kind::kTab) {
+      continue;
+    }
+    if (Present(ctx, node.arc_id)) {
+      ++ctx.result->skipped;
+      continue;
+    }
+    if (!IsImportablePage(node.url)) {
+      continue;
+    }
+    if (in_row >= kMaxEssentials) {
+      break;
+    }
+    tabs::TabInterface* const tab =
+        InsertUnloaded(ctx.tabs, ctx.profile, node);
+    if (!tab) {
+      continue;
+    }
+    // A tab pinned in a Space with its own session is that Space's own
+    // essential (spaces B6): a shared one is pinned from a Space without
+    // one, when there is such a Space.
+    if (own) {
+      ctx.model->SetSpaceForTab(tab, *own);
+    } else if (const std::optional<SpaceId> shared =
+                   ctx.model->SpaceForSharedEssentials();
+               shared &&
+               ctx.model->SpaceIsIsolated(ctx.model->SpaceForTab(tab))) {
+      ctx.model->SetSpaceForTab(tab, *shared);
+    }
+    AdoptToken(ctx, tab, node.arc_id);
+    ctx.tabs->SetTabPinned(ctx.tabs->GetIndexOfTab(tab), true);
+    Remember(ctx, node.arc_id);
+    ++ctx.result->essentials;
+    ++in_row;
+  }
+}
