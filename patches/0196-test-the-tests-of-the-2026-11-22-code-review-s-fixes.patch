+  content::RenderFrameHost* const second =
+      ui_test_utils::NavigateToURLWithDisposition(
+          browser(), GURL(kSettingsUrl),
+          WindowOpenDisposition::kNewBackgroundTab,
+          ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP);
+  ASSERT_TRUE(second);
+  ASSERT_EQ(first, browser()->GetTabStripModel()->GetActiveWebContents());
+
+  // The first page: Set up WebDAV, the form filled as a person types it,
+  // and Test and continue.
+  constexpr char kStartTest[] = R"(
+    (async () => {
+      const deep = (root, selector) => {
+        const found = root.querySelector(selector);
+        if (found) {
+          return found;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          const inner =
+              element.shadowRoot && deep(element.shadowRoot, selector);
+          if (inner) {
+            return inner;
+          }
+        }
+        return null;
+      };
+      const wait = async what => {
+        for (let i = 0; i < 200; ++i) {
+          const value = what();
+          if (value) {
+            return value;
+          }
+          await new Promise(done => setTimeout(done, 25));
+        }
+        return null;
+      };
+      const section = await wait(
+          () => deep(document, 'settings-stedding-sync-section'));
+      const button = await wait(
+          () => section.shadowRoot.querySelector('#syncSetUp-webdav'));
+      if (!button) {
+        return 'no WebDAV row';
+      }
+      button.click();
+      await section.updateComplete;
+      const root = section.shadowRoot;
+      const dialog = root.querySelector('#placeDialog');
+      const form = $1;
+      for (const name of Object.keys(form)) {
+        if (name === 'kind') {
+          continue;
+        }
+        const input = dialog.querySelector('[data-field="' + name + '"]');
+        input.value = form[name];
+        input.dispatchEvent(new Event('input', {bubbles: true}));
+        await input.updateComplete;
+      }
+      const test = root.querySelector('#placeTest');
+      await wait(() => !test.disabled);
+      if (test.disabled) {
+        return 'the test cannot start';
+      }
+      test.click();
+      await section.updateComplete;
+      return 'testing ' + section.placeTesting_;
+    })()
+  )";
+  const base::DictValue form = place_.Form(server_.base_url());
+  ASSERT_EQ("testing true",
+            content::EvalJs(first, content::JsReplace(kStartTest, form)));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return asked_.load() > 0; }))
+      << "the first page's test never reached the place";
+
+  // The second page starts a test of its own while the first runs: it is
+  // told to wait, and the first page's test is cancelled.
+  constexpr char kSecondTest[] = R"(
+    import('chrome://resources/js/cr.js')
+        .then(cr => cr.sendWithPromise('steddingTestSyncPlace', $1))
+        .then(answer => answer.failure || 'none')
+  )";
+  ASSERT_EQ("busy",
+            content::EvalJs(second, content::JsReplace(kSecondTest, form)));
+
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return FormState(first) ==
+           "false|true|true|Stedding is still finishing with the last place. "
+           "Try again in a moment.|true";
+  })) << "the form stays on Testing: " << FormState(first);
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/audit_w2_b03_browsertest.cc b/chrome/test/stedding/audit_w2_b03_browsertest.cc
new file mode 100644
index 0000000000000..c19545c84b156
--- /dev/null
+++ b/chrome/test/stedding/audit_w2_b03_browsertest.cc
@@ -0,0 +1,319 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The archived tabs page, chrome://stedding-archive (docs/features/archive.md
+// A9): its Space filter when the choice it is on has gone, where the focus
+// goes when the list is drawn again, and one heading for each day.
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/strings/string_split.h"
+#include "base/test/run_until.h"
+#include "base/time/time.h"
+#include "base/time/time_override.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/tab_restore_service_factory.h"
+#include "chrome/browser/ui/archive/archive_mark.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/session_id.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+// How far from the system's wall clock base::Time::Now() reads while a test
+// closes a tab on another day.
+base::TimeDelta g_wall_clock_offset_w2b03;
+
+base::Time WallClockOffsetW2B03() {
+  return base::subtle::TimeNowIgnoringOverride() + g_wall_clock_offset_w2b03;
+}
+
+// Adds a closed tab of `url` and `title`, closed at `when`, behind what the
+// list of closed tabs holds, as an import of Arc's archive does (import I7).
+void AddRowBehindW2B03(sessions::TabRestoreService& service,
+                       const GURL& url,
+                       const std::u16string& title,
+                       base::Time when,
+                       std::map<std::string, std::string> extra_data) {
+  sessions::SerializedNavigationEntry page;
+  page.set_index(0);
+  page.set_virtual_url(url);
+  page.set_title(title);
+  page.set_timestamp(when);
+  auto row = std::make_unique<sessions::tab_restore::Tab>();
+  row->navigations.push_back(page);
+  row->current_navigation_index = 0;
+  row->timestamp = when;
+  row->extra_data = std::move(extra_data);
+  std::vector<std::unique_ptr<sessions::tab_restore::Tab>> rows;
+  rows.push_back(std::move(row));
+  std::vector<SessionID> added;
+  service.AddClosedTabs(std::move(rows), &added);
+  EXPECT_EQ(1u, added.size()) << "the list did not take the row";
+}
+
+// The hosts of the page's rows, top to bottom, without ".test" and the port:
+// "third|second|first". A row's line starts with its host.
+constexpr char kRowHostsW2B03[] = R"((() => {
+  return [...document.querySelectorAll('.row')].map(row => {
+    const meta = row.querySelector('.meta').textContent;
+    return meta.split(' ')[0].split('.')[0];
+  }).join('|');
+})())";
+
+// What has the focus: "BUTTON Forget of second" for a row's button, else the
+// focused element's tag.
+constexpr char kFocusW2B03[] = R"((() => {
+  const active = document.activeElement;
+  const row = active ? active.closest('.row') : null;
+  if (!row) {
+    return active ? active.tagName : 'none';
+  }
+  const meta = row.querySelector('.meta').textContent;
+  return active.tagName + ' ' + active.textContent + ' of ' +
+      meta.split(' ')[0].split('.')[0];
+})())";
+
+// Marks what the list shows now; kRedrawnW2B03 says when a redraw replaced
+// it.
+constexpr char kMarkListW2B03[] =
+    "document.querySelector('#app > div').firstElementChild"
+    "    .setAttribute('data-before', '');";
+constexpr char kRedrawnW2B03[] = "!document.querySelector('[data-before]')";
+
+class ArchivePageW2B03Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title1.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  void Close(tabs::TabInterface* tab) {
+    tabs()->CloseWebContentsAt(tabs()->GetIndexOfTab(tab),
+                               TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+
+  // The profile's list of closed tabs, loaded, as an import needs it.
+  sessions::TabRestoreService* LoadedService() {
+    sessions::TabRestoreService* const service =
+        TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+    if (!service) {
+      return nullptr;
+    }
+    service->LoadTabsFromLastSession();
+    EXPECT_TRUE(base::test::RunUntil([&]() { return service->IsLoaded(); }));
+    return service;
+  }
+
+  // chrome://stedding-archive in a new tab in front, once it lists `count`
+  // rows.
+  content::WebContents* OpenArchivePage(int count) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), GURL("chrome://stedding-archive"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    content::WebContents* const page = tabs()->GetActiveWebContents();
+    EXPECT_TRUE(base::test::RunUntil([&]() { return Rows(page) == count; }))
+        << "the page lists " << Rows(page) << " rows";
+    return page;
+  }
+
+  int Rows(content::WebContents* page) {
+    return content::EvalJs(page, "document.querySelectorAll('.row').length")
+        .ExtractInt();
+  }
+
+  std::string RowHosts(content::WebContents* page) {
+    return content::EvalJs(page, kRowHostsW2B03).ExtractString();
+  }
+};
+
+// P04-1g, archive A9: a deleted Space is a filter choice while a row names
+// it. With the filter on it, once its last row is forgotten the menu reads
+// "All Spaces" and the list shows everything, a tab closed after that too.
+// The filter stayed on the gone choice under a menu reading "All Spaces", and
+// the list said "Nothing matches." to every row there was and every tab
+// closed later.
+IN_PROC_BROWSER_TEST_F(ArchivePageW2B03Test,
+                       AFilterOnAGoneSpaceFallsBackToAllSpaces) {
+  sessions::TabRestoreService* const service = LoadedService();
+  ASSERT_TRUE(service);
+  Close(Open("plain.test"));
+  tabs::TabInterface* const later = Open("later.test");
+  // A row of a Space no window has any more.
+  const std::string gone = spaces::SpaceId::GenerateNew().ToString();
+  AddRowBehindW2B03(*service, GURL("https://gone.test/"), u"Gone page",
+                    base::Time::Now(),
+                    {{spaces::kSessionTabSpaceKey, gone},
+                     {stedding::kArchiveSpaceNameKey, "Gone"}});
+
+  content::WebContents* const page = OpenArchivePage(2);
+  ASSERT_EQ("plain|gone", RowHosts(page));
+  ASSERT_TRUE(
+      content::EvalJs(
+          page, "!!document.querySelector('.row').querySelector('.space')")
+          .ExtractBool())
+      << "the plain close names no Space, and any filter would show it";
+
+  ASSERT_TRUE(content::ExecJs(page, "const select ="
+                                    "    document.querySelector('select');"
+                                    "select.value = '" +
+                                        gone +
+                                        "';"
+                                        "select.dispatchEvent("
+                                        "    new Event('change'));"));
+  ASSERT_EQ(gone,
+            content::EvalJs(page, "document.querySelector('select').value")
+                .ExtractString())
+      << "the gone Space is no choice";
+  ASSERT_EQ("gone", RowHosts(page)) << "the filter did not filter";
+
+  // Forget its last row.
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "[...document.querySelector('.row').querySelectorAll('button')]"
+      "    .find(button => button.textContent === 'Forget').click();"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return RowHosts(page).find("gone") == std::string::npos;
+  })) << "the row was not forgotten";
+  EXPECT_EQ("",
+            content::EvalJs(page, "document.querySelector('select').value")
+                .ExtractString());
+  EXPECT_EQ("plain", RowHosts(page))
+      << "the list says: "
+      << content::EvalJs(page,
+                         "document.querySelector('#app > div').textContent")
+             .ExtractString();
+
+  // A tab closed after that is listed.
+  ASSERT_TRUE(content::ExecJs(page, kMarkListW2B03));
+  Close(later);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, kRedrawnW2B03).ExtractBool();
+  })) << "the list was not drawn again";
+  EXPECT_EQ("later|plain", RowHosts(page))
+      << "the list says: "
+      << content::EvalJs(page,
+                         "document.querySelector('#app > div').textContent")
+             .ExtractString();
+}
+
+// P04-1l, archive A9: a change to the closed tabs redraws the list and
+// leaves the focus where the reader has it. On a row's button, it stays on
+// that row's button when another tab closes, and goes to the same button of
+// the row below when its own row is forgotten. Every redraw made new buttons
+// and the focus fell to the page, so the next Tab started again at the top.
+IN_PROC_BROWSER_TEST_F(ArchivePageW2B03Test,
+                       ARowButtonKeepsTheFocusAsTheListChanges) {
+  tabs::TabInterface* const first = Open("first.test");
+  tabs::TabInterface* const second = Open("second.test");
+  tabs::TabInterface* const third = Open("third.test");
+  tabs::TabInterface* const fourth = Open("fourth.test");
+  Close(first);
+  Close(second);
+  Close(third);
+  content::WebContents* const page = OpenArchivePage(3);
+  ASSERT_EQ("third|second|first", RowHosts(page));
+
+  // The reader is on the second row's Forget.
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "[...document.querySelectorAll('.row')[1].querySelectorAll('button')]"
+      "    .find(button => button.textContent === 'Forget').focus();"));
+  ASSERT_EQ("BUTTON Forget of second",
+            content::EvalJs(page, kFocusW2B03).ExtractString());
+
+  // Another tab closes, and its row comes in above.
+  Close(fourth);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Rows(page) == 4; }));
+  ASSERT_EQ("fourth|third|second|first", RowHosts(page));
+  EXPECT_EQ("BUTTON Forget of second",
+            content::EvalJs(page, kFocusW2B03).ExtractString())
+      << "the focus left the row's button";
+
+  // The reader forgets that row: the focus goes to the row now in its place.
+  ASSERT_TRUE(content::ExecJs(page, "document.activeElement.click();"));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Rows(page) == 3; }));
+  ASSERT_EQ("fourth|third|first", RowHosts(page));
+  EXPECT_EQ("BUTTON Forget of first",
+            content::EvalJs(page, kFocusW2B03).ExtractString())
+      << "the focus fell out of the list";
+}
+
+// P04-1h, archive A9: the page groups by day, one heading for each day,
+// newest first, whatever the order of the list of closed tabs. An import of
+// Arc's archive puts its rows behind the person's own closes, with Arc's
+// dates (import I7); each day of rows came under a heading of its own, so
+// "Today" came again under an older day.
+IN_PROC_BROWSER_TEST_F(ArchivePageW2B03Test, EachDayHasOneHeading) {
+  sessions::TabRestoreService* const service = LoadedService();
+  ASSERT_TRUE(service);
+  tabs::TabInterface* const old = Open("old.test");
+  tabs::TabInterface* const today = Open("today.test");
+  Open("open.test");
+  // Closed three days ago...
+  g_wall_clock_offset_w2b03 = -base::Days(3);
+  {
+    base::subtle::ScopedTimeClockOverrides wall_clock(
+        &WallClockOffsetW2B03, /*time_ticks_override=*/nullptr,
+        /*thread_ticks_override=*/nullptr);
+    Close(old);
+  }
+  g_wall_clock_offset_w2b03 = base::TimeDelta();
+  // ...and today.
+  Close(today);
+  // A row of Arc's archive, archived in Arc today, comes in behind them.
+  AddRowBehindW2B03(
+      *service, GURL("https://imported.test/"), u"Imported page",
+      base::Time::Now(),
+      {{stedding::kArchiveReasonKey,
+        stedding::ArchiveReasonName(stedding::ArchiveReason::kImport)}});
+
+  content::WebContents* const page = OpenArchivePage(3);
+  const std::string headings =
+      content::EvalJs(page,
+                      "[...document.querySelectorAll('.day')]"
+                      "    .map(day => day.textContent).join('|')")
+          .ExtractString();
+  const std::vector<std::string> days = base::SplitString(
+      headings, "|", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  ASSERT_EQ(2u, days.size()) << headings;
+  EXPECT_EQ("Today", days[0]) << headings;
+  EXPECT_NE("Today", days[1]) << headings;
+  // Today's rows keep the list's order under their heading.
+  EXPECT_EQ("today|imported|old", RowHosts(page));
+}
+
+}  // namespace
