+    ASSERT_TRUE(content::WaitForLoadStop(tab->GetContents()));
+    ASSERT_TRUE(spaces::IsSpaceStoragePartition(JarOf(tab)))
+        << "the form's page is in Work's jar";
+  }
+
+  // Every request the server had for `path` (with its query), in order.
+  std::vector<SeenRequestW2B15> SeenFor(const std::string& path) {
+    base::AutoLock lock(lock_);
+    const auto it = seen_.find(path);
+    return it == seen_.end() ? std::vector<SeenRequestW2B15>() : it->second;
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  spaces::SpaceId work_ = spaces::SpaceId::GenerateNew();
+  extensions::TestExtensionDir extension_dir_;
+  GURL extension_page_;
+
+ private:
+  // The server's thread.
+  void OnRequest(const net::test_server::HttpRequest& request) {
+    SeenRequestW2B15 seen;
+    seen.post = request.method == net::test_server::METHOD_POST;
+    seen.content_type = HeaderOfW2B15(request, "Content-Type");
+    seen.cookie = HeaderOfW2B15(request, "Cookie");
+    seen.body = request.content;
+    base::AutoLock lock(lock_);
+    seen_[request.GetURL().PathForRequest()].push_back(std::move(seen));
+  }
+
+  base::Lock lock_;
+  std::map<std::string, std::vector<SeenRequestW2B15>> seen_ GUARDED_BY(lock_);
+};
+
+// P17-1c, sessions S20: a form an extension's page sends with POST from a
+// Space with a session of its own goes out once, in the Space's jar, with
+// the Content-Type its form gave it, so the server reads note=typed. A reload
+// of the page it brought sends the form again from history the same way.
+// The form went out with its body and no Content-Type, and so did a reload.
+IN_PROC_BROWSER_TEST_F(SpaceJarFormW2B15Test,
+                       AFormMadeAgainInTheSpacesJarKeepsItsContentType) {
+  tabs::TabInterface* tab = nullptr;
+  ASSERT_NO_FATAL_FAILURE(OpenExtensionPageInWork(&tab));
+  const std::string path = "/echo?w2b15-urlencoded";
+  ASSERT_NO_FATAL_FAILURE(SendFormAndWait(tab, Url("b.test", path),
+                                          "application/x-www-form-urlencoded"));
+
+  {
+    SCOPED_TRACE("The form, made again in Work's jar");
+    const std::vector<SeenRequestW2B15> sent = SeenFor(path);
+    ASSERT_EQ(1u, sent.size()) << "the form goes out once";
+    EXPECT_TRUE(sent[0].post);
+    EXPECT_EQ("jar=work", sent[0].cookie) << "the form goes in Work's jar";
+    EXPECT_EQ("note=typed", sent[0].body);
+    EXPECT_EQ("application/x-www-form-urlencoded", sent[0].content_type)
+        << "the server cannot read a body that does not say what it is";
+  }
+
+  {
+    SCOPED_TRACE("A reload sends the form again from history");
+    content::WebContents* const contents = tab->GetContents();
+    contents->GetController().Reload(content::ReloadType::NORMAL,
+                                     /*check_for_repost=*/false);
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return SeenFor(path).size() == 2u; }));
+    ASSERT_TRUE(content::WaitForLoadStop(contents));
+    const std::vector<SeenRequestW2B15> sent = SeenFor(path);
+    ASSERT_EQ(2u, sent.size());
+    EXPECT_TRUE(sent[1].post);
+    EXPECT_EQ("jar=work", sent[1].cookie);
+    EXPECT_EQ("note=typed", sent[1].body);
+    EXPECT_EQ("application/x-www-form-urlencoded", sent[1].content_type)
+        << "the tab's history kept no Content-Type for the form";
+  }
+}
+
+// P17-1c, sessions S20: a form answered with 303 See Other lands on a page
+// fetched with GET, and a reload of that page sends no form Content-Type
+// with its GET. A guard for the fix: a form's type carried in the load's own
+// headers stayed with the entry through the redirect and went out again with
+// every reload.
+IN_PROC_BROWSER_TEST_F(SpaceJarFormW2B15Test,
+                       AReloadAfterASeeOtherSendsNoFormType) {
+  tabs::TabInterface* tab = nullptr;
+  ASSERT_NO_FATAL_FAILURE(OpenExtensionPageInWork(&tab));
+  const std::string landing = "/echo?w2b15-landing";
+  const GURL target = Url("b.test", landing);
+  const GURL action = Url("b.test", "/server-redirect-303?" + target.spec());
+  content::WebContents* const page = tab->GetContents();
+  content::ExecuteScriptAsync(
+      page, content::JsReplace(
+                "(() => {"
+                "  const form = document.createElement('form');"
+                "  form.method = 'post';"
+                "  form.action = $1;"
+                "  const note = document.createElement('input');"
+                "  note.name = 'note';"
+                "  note.value = 'typed';"
+                "  form.appendChild(note);"
+                "  document.body.appendChild(form);"
+                "  form.submit();"
+                "})();",
+                action));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return tab->GetContents() != page &&
+           tab->GetContents()->GetLastCommittedURL() == target;
+  })) << "the form's redirect did not land in contents made again for it";
+  content::WebContents* const contents = tab->GetContents();
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  {
+    const std::vector<SeenRequestW2B15> sent = SeenFor(landing);
+    ASSERT_EQ(1u, sent.size());
+    EXPECT_FALSE(sent[0].post) << "303 See Other is followed with GET";
+    EXPECT_EQ("jar=work", sent[0].cookie);
+    EXPECT_EQ("", sent[0].content_type);
+  }
+
+  contents->GetController().Reload(content::ReloadType::NORMAL,
+                                   /*check_for_repost=*/false);
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return SeenFor(landing).size() == 2u; }));
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  const std::vector<SeenRequestW2B15> sent = SeenFor(landing);
+  ASSERT_EQ(2u, sent.size());
+  EXPECT_FALSE(sent[1].post);
+  EXPECT_EQ("", sent[1].content_type)
+      << "the reload of the page the form led to sent the form's type";
+}
+
+// P17-1c, sessions S20: a multipart form made again in the Space's jar keeps
+// its Content-Type with the boundary its body is cut by.
+IN_PROC_BROWSER_TEST_F(SpaceJarFormW2B15Test,
+                       AMultipartFormMadeAgainKeepsItsBoundary) {
+  tabs::TabInterface* tab = nullptr;
+  ASSERT_NO_FATAL_FAILURE(OpenExtensionPageInWork(&tab));
+  const std::string path = "/echo?w2b15-multipart";
+  ASSERT_NO_FATAL_FAILURE(
+      SendFormAndWait(tab, Url("b.test", path), "multipart/form-data"));
+
+  const std::vector<SeenRequestW2B15> sent = SeenFor(path);
+  ASSERT_EQ(1u, sent.size()) << "the form goes out once";
+  EXPECT_TRUE(sent[0].post);
+  EXPECT_EQ("jar=work", sent[0].cookie) << "the form goes in Work's jar";
+  constexpr std::string_view kMultipart = "multipart/form-data; boundary=";
+  ASSERT_TRUE(base::StartsWith(sent[0].content_type, kMultipart))
+      << "sent as \"" << sent[0].content_type << "\"";
+  const std::string boundary =
+      sent[0].content_type.substr(kMultipart.size());
+  ASSERT_FALSE(boundary.empty());
+  EXPECT_NE(std::string::npos, sent[0].body.find("--" + boundary))
+      << "the body is not cut by the boundary the request names";
+  EXPECT_NE(std::string::npos, sent[0].body.find("name=\"note\""));
+  EXPECT_NE(std::string::npos, sent[0].body.find("typed"));
+}
