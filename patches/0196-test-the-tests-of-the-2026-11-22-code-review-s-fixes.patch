+// found in the LICENSE file.
+
+// A page sent from a little window into the main window stays there when an
+// installed app takes its links (little E2, E7; web apps Wa15); a little
+// window saved on a display that has gone comes back on screen (little E12);
+// the next link replaces a peek over the page whose page runs a handler as
+// it is left (peek P13, P20); a region capture of a crashed tab says it
+// failed (screenshot C10).
+
+#include <cstdlib>
+#include <memory>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/run_loop.h"
+#include "base/strings/utf_string_conversions.h"
