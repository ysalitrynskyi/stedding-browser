+// P16-1c; Sf43, Sf47: Test and continue against a server that does not
+// answer, Cancel, a folder joined instead, then Stop syncing, all before
+// the request ends. Once it ends, Test and continue works again. Its end
+// was dropped with the folder's sync, and every later test on the profile
+// answered "busy" until Stedding was restarted.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPlaceW2B13Test,
+                       ATestCancelledBeforeStopSyncingLeavesTheNextTestFree) {
+  base::test::TestFuture<base::DictValue> tested;
+  service()->TestPlace(place_->Form(hung_.base_url(), sb::FakePlace::kSecret),
+                       tested.GetCallback());
+  service()->CancelJoin();
+
+  base::ScopedTempDir folder;
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(folder.CreateUniqueTempDir());
+  }
+  base::test::TestFuture<base::DictValue> preview;
+  service()->PreviewJoin(folder.GetPath(), preview.GetCallback());
+  ASSERT_FALSE(preview.Take().FindString("refusal"));
+  ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/true, "This one", {}));
+  ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  service()->Stop(/*remove_own_file=*/false);
+  ASSERT_FALSE(service()->enabled());
+
+  // The server goes, and the request that waited on it ends.
+  ASSERT_TRUE(hung_.ShutdownAndWaitUntilComplete());
+  EXPECT_TRUE(tested.Wait()) << "the cancelled test never answered";
+  if (tested.IsReady()) {
+    EXPECT_EQ("cancelled", Failure(tested.Get()));
+  }
+
+  base::test::TestFuture<base::DictValue> again;
+  service()->TestPlace(place_->Form(server_.base_url(), sb::FakePlace::kSecret),
+                       again.GetCallback());
+  const base::DictValue answer = again.Take();
+  EXPECT_EQ("", Failure(answer))
+      << "a test after Stop syncing was refused as busy";
+  EXPECT_TRUE(answer.FindString("dir"));
+  service()->CancelJoin();
+  // Sf49: the `Stedding Sidebar` the passing test made goes.
+  EXPECT_TRUE(base::test::RunUntil([&] { return !place_->HasFolder(); }));
+}
