diff --git a/chrome/browser/ui/stedding_ui_metrics.h b/chrome/browser/ui/stedding_ui_metrics.h
new file mode 100644
index 0000000000000..93887808ad816
--- /dev/null
+++ b/chrome/browser/ui/stedding_ui_metrics.h
@@ -0,0 +1,69 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_UI_METRICS_H_
+#define CHROME_BROWSER_UI_STEDDING_UI_METRICS_H_
+
+#include "base/feature_list.h"
+#include "base/metrics/field_trial_params.h"
+
+// The numbers that make the window look like Arc rather than like Chromium.
+//
+// These are feature parameters rather than constants for one reason: matching a
+// reference screenshot means trying values and looking at the result, and a
+// constant costs a compile and a link for every value tried. As parameters they
+// can be swept from the command line against a build that is already made:
+//
+//   tooling/capture-ui --features \
+//     'SteddingArcStyleWindow:contents_corner_radius/16/vertical_tab_height/48'
+//
+// The defaults here are the shipping values, taken from docs/UI-SPEC.md. The
+// override path exists for iteration; nothing in the product depends on it.
+namespace stedding {
+
+BASE_DECLARE_FEATURE(kArcStyleWindow);
+
+// Radius of the contents corner nearest the tab strip, in DIPs.
+BASE_DECLARE_FEATURE_PARAM(int, kContentsCornerRadius);
+
+// Height of one tab row in the vertical tab strip, in DIPs.
+BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabHeight);
+
+// Radius of the active tab's pill in the vertical tab strip, in DIPs.
+BASE_DECLARE_FEATURE_PARAM(int, kVerticalTabCornerRadius);
+
+// Height of the location bar, in DIPs. With the toolbar margin below, this
+// sets how tall the toolbar strip is: Chromium's 34 plus 6 above and below
+// gives 46, and the reference is thinner than that.
+BASE_DECLARE_FEATURE_PARAM(int, kLocationBarHeight);
+
+// Space above and below the toolbar's contents, in DIPs.
+BASE_DECLARE_FEATURE_PARAM(int, kToolbarVerticalMargin);
+
+// Padding inside a toolbar button, in DIPs. Together with the icon this is what
+// really floors the toolbar's height: the strip is as tall as its tallest
+// child, and a button is its icon plus this on each side.
+BASE_DECLARE_FEATURE_PARAM(int, kToolbarButtonInset);
+
+// Height of a toolbar button, in DIPs. This, not the location bar, is what
+// actually sets the toolbar's floor -- the strip is as tall as its tallest
+// child, and the back button is that child.
+BASE_DECLARE_FEATURE_PARAM(int, kToolbarButtonHeight);
+
+// Width of the location bar, in DIPs. Chromium lets the bar fill the toolbar,
+// which is why it cannot be centred: there is no leftover width for spacers to
+// take. Capping its preferred width is what makes centring possible.
+BASE_DECLARE_FEATURE_PARAM(int, kLocationBarWidth);
+
+// Size of a tab's favicon, in DIPs. gfx::kFaviconSize is 16 and global, so this
+// resizes the slot in the tab only; the image is drawn scaled to the slot.
+BASE_DECLARE_FEATURE_PARAM(int, kTabFaviconSize);
+
+// Size of a toolbar button's icon, in DIPs. Chromium uses 20; 18 is part of
+// what brings the toolbar to the reference's height.
+BASE_DECLARE_FEATURE_PARAM(int, kToolbarButtonIconSize);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_UI_METRICS_H_
