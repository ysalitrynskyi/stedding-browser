+// `view`'s bounds in the browser view, whose background paints the row.
+gfx::RectF InWindowW2B25(BrowserView* window, views::View* view) {
+  gfx::RectF bounds(view->GetLocalBounds());
+  views::View::ConvertRectToTarget(view, window, &bounds);
+  return bounds;
+}
+
+// A page whose background is `colour`, six hex digits.
+GURL PageInW2B25(const char* colour) {
+  return GURL(base::StrCat({"data:text/html,<body style='margin:0;"
+                            "background:%23",
+                            colour, "'><p>A page</p></body>"}));
+}
