+// `body`, run on the settings page with `pick(selector)`: the first element
+// that matches anywhere on the page, through every shadow root, or null.
+std::string OnThePage(std::string_view body) {
+  return base::StrCat({R"(
+    (() => {
+      const find = (root, selector) => {
+        const hit = root.querySelector(selector);
+        if (hit) {
+          return hit;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot, selector);
+            if (found) {
+              return found;
+            }
+          }
+        }
+        return null;
+      };
+      const pick = selector => find(document, selector);
+    )",
+                       body, R"(
+    })()
+  )"});
+}
