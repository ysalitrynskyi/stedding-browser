+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_FILE_TRASH_H_
+#define CHROME_BROWSER_UI_STEDDING_FILE_TRASH_H_
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace stedding {
+
+// docs/features/sidebar-panels.md Pn11: moves the file at `path` to the
+// system's Trash (the Recycle Bin on Windows), from where the user can put
+// it back. It never deletes the file outright: where the system would not
+// keep it -- a volume with no Trash or Recycle Bin, a network share, a file
+// larger than the Recycle Bin takes -- nothing happens and it returns false.
+// Blocking; run it on a runner CreateFileTrashTaskRunner made. When
+// `trashed_path` is not null it receives where the file went, where the
+// system says so, for a test to clean up after itself.
+bool MoveToTrash(const base::FilePath& path, base::FilePath* trashed_path);
+
+// A runner MoveToTrash may run on: one that may block, COM-initialised on
+// Windows, where the move is the shell's.
+scoped_refptr<base::SequencedTaskRunner> CreateFileTrashTaskRunner();
+
+// Moves `path` on a runner of its own and answers `done` on the calling
+// sequence: true when the file is in the Trash.
+void MoveToTrashThen(const base::FilePath& path,
+                     base::OnceCallback<void(bool)> done);
+
+// A stand-in for MoveToTrash in MoveToTrashThen, so a browser test moves no
+// file of the machine's into its real Trash; a null callback restores the
+// real one. Called on the UI thread.
+void SetMoveToTrashForTesting(
+    base::RepeatingCallback<bool(const base::FilePath&)> move);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_FILE_TRASH_H_
