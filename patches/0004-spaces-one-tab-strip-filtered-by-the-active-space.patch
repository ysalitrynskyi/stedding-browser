diff --git a/chrome/browser/ui/spaces/session_rebuild_unittest.cc b/chrome/browser/ui/spaces/session_rebuild_unittest.cc
new file mode 100644
index 0000000000000..7a78f98bf4bbb
--- /dev/null
+++ b/chrome/browser/ui/spaces/session_rebuild_unittest.cc
@@ -0,0 +1,136 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The session log is rebuilt from the live browser at startup and every
+// kWritesPerReset writes. Everything Stedding keeps in session extra data --
+// the Space list, each tab's Space and per-Space pin, each tab's folder path
+// -- has to be re-emitted by that rebuild or it survives one restart only.
+// spaces B9 depends on this; the folder half is in
+// stedding_folder_session_unittest.cc.
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "chrome/browser/sessions/stedding_session_rebuild.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/serialized_navigation_entry_test_helper.h"
+#include "components/sessions/core/session_command.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/sessions/core/session_types.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace spaces {
+namespace {
+
+class SessionRebuildTest : public BrowserWithTestWindowTest {
+ protected:
+  SpaceModel& model() { return *SpaceModel::From(browser()); }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+
+  // Replays what the rebuild would write, plus the minimum of Chromium's own
+  // commands for the window to be considered valid, and returns the window as
+  // restore would see it.
+  std::unique_ptr<sessions::SessionWindow> RebuildAndRestore() {
+    std::vector<std::unique_ptr<sessions::SessionCommand>> commands;
+    const SessionID window_id = browser()->GetSessionID();
+    commands.push_back(sessions::CreateSetWindowTypeCommand(
+        window_id, sessions::SessionWindow::TYPE_NORMAL));
+    for (int i = 0; i < tabs().count(); ++i) {
+      const SessionID tab_id = sessions::SessionTabHelper::IdForTab(
+          tabs().GetTabAtIndex(i)->GetContents());
+      commands.push_back(sessions::CreateSetTabWindowCommand(window_id, tab_id));
+      commands.push_back(sessions::CreateSetTabIndexInWindowCommand(tab_id, i));
+      commands.push_back(sessions::CreateUpdateTabNavigationCommand(
+          tab_id,
+          sessions::SerializedNavigationEntryTestHelper::
+              CreateNavigationForTest()));
+    }
+    commands.push_back(sessions::CreateSetSelectedTabInWindowCommand(window_id, 0));
+
+    for (auto& command : stedding::CollectSessionRebuildCommands(browser())) {
+      commands.push_back(std::move(command));
+    }
+
+    std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+    SessionID active = SessionID::InvalidValue();
+    std::string platform_session_id;
+    std::set<SessionID> discarded;
+    sessions::RestoreSessionFromCommands(commands, &windows, &active,
+                                         &platform_session_id, &discarded);
+    CHECK_EQ(1u, windows.size()) << "the rebuilt window must survive restore";
+    return std::move(windows[0]);
+  }
+
+  static const std::string& ExtraData(
+      const std::map<std::string, std::string>& data,
+      const std::string& key) {
+    static const std::string kNone;
+    const auto it = data.find(key);
+    return it == data.end() ? kNone : it->second;
+  }
+};
+
+// B9: the Space list and the active Space come back through a rebuild.
+TEST_F(SessionRebuildTest, RebuildReemitsTheSpaceList) {
+  AddTab(browser(), GURL("https://example.com/"));
+  Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  model().SetActiveSpace(work->id());
+
+  const std::unique_ptr<sessions::SessionWindow> window = RebuildAndRestore();
+  const std::string& spaces = ExtraData(window->extra_data, kSessionSpacesKey);
+  ASSERT_FALSE(spaces.empty()) << "the window's Space list was dropped";
+
+  SpaceModel replay;
+  replay.RestoreFrom(spaces);
+  EXPECT_EQ(2u, replay.size());
+  EXPECT_EQ(work->id(), replay.active_id());
+  EXPECT_EQ("Work", replay.GetSpace(work->id())->name());
+}
+
+// B9: every tab's Space and per-Space pin come back through a rebuild.
+TEST_F(SessionRebuildTest, RebuildReemitsEachTabsSpaceAndPin) {
+  const SpaceId home = model().active_id();
+  AddTab(browser(), GURL("https://example.com/"));
+  tabs::TabInterface* const in_home = tabs().GetActiveTab();
+  Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  model().SetActiveSpace(work->id());
+  AddTab(browser(), GURL("https://example.org/"));
+  tabs::TabInterface* const in_work = tabs().GetActiveTab();
+  model().SetSpacePinned(in_work, true);
+
+  const std::unique_ptr<sessions::SessionWindow> window = RebuildAndRestore();
+  ASSERT_EQ(static_cast<size_t>(tabs().count()), window->tabs.size());
+
+  for (const auto& tab : window->tabs) {
+    const std::string& space = ExtraData(tab->extra_data, kSessionTabSpaceKey);
+    const std::string& pin = ExtraData(tab->extra_data, kSessionTabSpacePinKey);
+    // Match the restored tab back to the live one by session id.
+    if (tab->tab_id == sessions::SessionTabHelper::IdForTab(
+                           in_home->GetContents())) {
+      EXPECT_EQ(home.ToString(), space);
+      EXPECT_TRUE(pin.empty());
+    } else if (tab->tab_id == sessions::SessionTabHelper::IdForTab(
+                                  in_work->GetContents())) {
+      EXPECT_EQ(work->id().ToString(), space);
+      EXPECT_EQ("1", pin);
+    } else {
+      // The tab the switch to the empty Work Space opened (B3).
+      EXPECT_EQ(work->id().ToString(), space);
+      EXPECT_TRUE(pin.empty());
+    }
+  }
+}
+
+}  // namespace
+}  // namespace spaces
