+#include "chrome/browser/ui/spaces/clipboard_fence.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+namespace {
+
+class ClipboardFenceTest : public testing::Test {
+ protected:
+  void SetUp() override { ResetClipboardFenceForTesting(); }
+  void TearDown() override { ResetClipboardFenceForTesting(); }
+};
+
+TEST_F(ClipboardFenceTest, CopyRecordsTheJar) {
+  EXPECT_FALSE(PasteNeedsConfirm("abc"));
+  RecordCopyFromJar("abc");
+  EXPECT_FALSE(PasteNeedsConfirm("abc"));
+}
+
+TEST_F(ClipboardFenceTest, CrossJarPasteConfirms) {
+  RecordCopyFromJar("work");
+  EXPECT_TRUE(PasteNeedsConfirm("mail"));
+  EXPECT_FALSE(PasteNeedsConfirm("work"));
+  EXPECT_FALSE(PasteNeedsConfirm(""));
+  RecordCopyFromJar("");
+  EXPECT_TRUE(PasteNeedsConfirm("work"));
+  EXPECT_FALSE(PasteNeedsConfirm(""));
+}
+
+}  // namespace
