+// splits J5: a tab that joins a Space pin in a split stays in the pinned run,
+// pinned too, since a split is one row (J1). One pane pinned and one not left
+// the row half a pin.
+TEST_F(SpaceWindowTest, ATabThatJoinsAPinInASplitIsPinned) {
+  tabs::TabInterface* const pin = OpenTab();
+  tabs::TabInterface* const loose = OpenTab();
+  model().SetSpacePinned(pin, true);
+  ASSERT_TRUE(model().IsSpacePinned(pin));
+  ASSERT_FALSE(model().IsSpacePinned(loose));
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+  tabs().AddToNewSplit({tabs().GetIndexOfTab(loose)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(pin->IsSplit());
+  EXPECT_TRUE(model().IsSpacePinned(pin));
+  EXPECT_TRUE(model().IsSpacePinned(loose)) << "half a pin";
+  EXPECT_EQ(pin->GetSplit(), loose->GetSplit());
+
+  // A tab swapped into the split is pinned too.
+  tabs::TabInterface* const swapped = OpenTab();
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(loose));
+  tabs().UpdateTabInSplit(loose, tabs().GetIndexOfTab(swapped),
+                          TabStripModel::SplitUpdateType::kSwap);
+  ASSERT_EQ(pin->GetSplit(), swapped->GetSplit());
+  EXPECT_TRUE(model().IsSpacePinned(swapped)) << "a swap left half a pin";
+}
