diff --git a/chrome/browser/ui/color/stedding_color_mixer.cc b/chrome/browser/ui/color/stedding_color_mixer.cc
index 642f868d65241..1d47b56b4bc94 100644
--- a/chrome/browser/ui/color/stedding_color_mixer.cc
+++ b/chrome/browser/ui/color/stedding_color_mixer.cc
@@ -88,6 +88,14 @@ void AddSteddingColorMixer(ui::ColorProvider* provider,
     mixer[kColorTabBackgroundActiveFrameInactive] =
         ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x24);
   }
+  // An inactive row has no fill of its own: the ground shows through, the
+  // essentials card included. Chromium's Material mixer gives inactive rows
+  // kColorSysHeader, and its field-trial testing config had been hiding that
+  // in every beta up to 4 -- beta 4's own app draws the fill when run with
+  // --disable-field-trial-config -- so the first build with the config off
+  // (privacy Q10) filled every row (the Mac pass, 2026-09-10).
+  mixer[kColorTabBackgroundInactiveFrameActive] = {SK_ColorTRANSPARENT};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {SK_ColorTRANSPARENT};
   mixer[kColorTabBackgroundInactiveHoverFrameActive] =
       ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x10);
   mixer[kColorTabBackgroundInactiveHoverFrameInactive] =
diff --git a/chrome/browser/ui/color/stedding_color_mixer_unittest.cc b/chrome/browser/ui/color/stedding_color_mixer_unittest.cc
index aa20595387829..fa15e53f7a682 100644
--- a/chrome/browser/ui/color/stedding_color_mixer_unittest.cc
+++ b/chrome/browser/ui/color/stedding_color_mixer_unittest.cc
@@ -5,8 +5,10 @@
 #include "chrome/browser/ui/color/stedding_color_mixer.h"
 
 #include "base/test/scoped_feature_list.h"
+#include "chrome/browser/ui/color/chrome_color_id.h"
 #include "chrome/browser/ui/stedding_ui_metrics.h"
 #include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
 #include "ui/color/color_id.h"
 #include "ui/color/color_provider.h"
 #include "ui/color/color_provider_key.h"
@@ -35,4 +37,24 @@ TEST(SteddingColorMixerTest, PrivateWindowsAreGraphite) {
   EXPECT_NE(kSteddingPrivateWindow, tinted.GetColor(ui::kColorFrameActive));
 }
 
+// tabs R23: an inactive row has no fill of its own in either colour mode,
+// whatever Chromium's tab-strip mixers hand out. Chromium's field-trial
+// testing config had been hiding the Material fill in every beta up to 4;
+// the first build with the config off (privacy Q10) filled every row.
+TEST(SteddingColorMixerTest, InactiveRowsHaveNoFill) {
+  base::test::ScopedFeatureList features(stedding::kArcStyleWindow);
+  for (const auto mode : {ui::ColorProviderKey::ColorMode::kDark,
+                          ui::ColorProviderKey::ColorMode::kLight}) {
+    ui::ColorProviderKey key;
+    key.color_mode = mode;
+    ui::ColorProvider provider;
+    AddSteddingColorMixer(&provider, key);
+    provider.GenerateColorMapForTesting();
+    EXPECT_EQ(0u, SkColorGetA(provider.GetColor(
+                      kColorTabBackgroundInactiveFrameActive)));
+    EXPECT_EQ(0u, SkColorGetA(provider.GetColor(
+                      kColorTabBackgroundInactiveFrameInactive)));
+  }
+}
+
 }  // namespace
