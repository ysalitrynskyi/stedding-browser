+namespace {
+
+// A page colour the row would take (toolbar T3, T7), set by hand: the tests
+// do not read what the page paints.
+constexpr SkColor kPageColourW2B24 = SkColorSetRGB(0x11, 0x22, 0x33);
+
+#if BUILDFLAG(IS_WIN)
+// What the frame answers over the box of its own caption buttons, hidden
+// while Stedding's stand in for them, at every point 2 DIP apart that the
+// window's client leaves to the frame (HTNOWHERE): the empty parts of the
+// sidebar's top row, the gutter above the page.
+struct CaptionBoxSweepW2B24 {
+  // The box, in the widget.
+  gfx::Rect box;
+  int checked = 0;
+  std::vector<std::string> wrong;
+};
+
+CaptionBoxSweepW2B24 SweepHiddenCaptionBoxW2B24(views::Widget* widget) {
+  CaptionBoxSweepW2B24 sweep;
+  const BrowserFrameViewWin* const frame =
+      views::AsViewClass<BrowserFrameViewWin>(
+          widget->non_client_view()->frame_view());
+  if (!frame) {
+    sweep.wrong.push_back("the window does not draw Windows' caption buttons");
+    return sweep;
+  }
+  const views::View* const captions =
+      frame->caption_button_container_for_testing();
+  const gfx::Rect box =
+      captions->ConvertRectToWidget(captions->GetLocalBounds());
+  sweep.box = box;
+  views::ClientView* const client = widget->client_view();
+  for (int y = box.y(); y < box.bottom(); y += 2) {
+    for (int x = box.x(); x < box.right(); x += 2) {
+      const gfx::Point point(x, y);
+      if (client->NonClientHitTest(point) != HTNOWHERE) {
+        continue;
+      }
+      ++sweep.checked;
+      // A caption, or the frame's edge to resize by: never a hidden
+      // button, and never nothing at all.
+      const int component = widget->GetNonClientComponent(point);
+      if (component == HTMINBUTTON || component == HTMAXBUTTON ||
+          component == HTCLOSE || component == HTNOWHERE) {
+        sweep.wrong.push_back(point.ToString() + ": " +
+                              base::NumberToString(component));
+      }
+    }
+  }
+  return sweep;
+}
+
+class SidebarAddressW2B24Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  VerticalTabStripTopContainer* top() {
+    return browser_view()
+        ->vertical_tab_strip_region_view_for_testing()
+        ->top_button_container_for_testing();
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  bool FrameButtonsShown() {
+    const BrowserFrameViewWin* const frame =
+        views::AsViewClass<BrowserFrameViewWin>(
+            browser_view()->GetWidget()->non_client_view()->frame_view());
+    return frame && frame->caption_button_container_for_testing()->GetVisible();
+  }
+  void Settle() {
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+  }
+};
+
+// P32-1d, sidebar Y48: with the address in the open sidebar at the window's
+// trailing edge, the window's buttons are the sidebar's and the frame hides
+// its own. The top row's empty parts over the hidden buttons' box are the
+// window's caption, so a drag there moves the window and a double click
+// maximizes it: they answered as the hidden minimize, maximize and close
+// buttons, or as nothing.
+IN_PROC_BROWSER_TEST_F(SidebarAddressW2B24Test,
+                       TheHiddenCaptionButtonsTakeNoPointInTheSidebar) {
+  prefs()->SetBoolean(stedding::prefs::kSidebarOnRight, true);
+  Settle();
+  prefs()->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    return top()->ShowsWindowButtons() && !FrameButtonsShown() &&
+           !browser_view()->IsToolbarVisible();
+  })) << "the sidebar did not take the window's buttons";
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+
+  const CaptionBoxSweepW2B24 sweep =
+      SweepHiddenCaptionBoxW2B24(browser_view()->GetWidget());
+  EXPECT_GT(sweep.checked, 0)
+      << "no point of the hidden buttons' box " << sweep.box.ToString()
+      << " is left to the frame";
+  EXPECT_TRUE(sweep.wrong.empty())
+      << sweep.wrong.size() << " of " << sweep.checked << " points of "
+      << sweep.box.ToString() << " are a hidden button's or nothing: "
+      << base::JoinString(sweep.wrong, ", ");
+}
+#endif  // BUILDFLAG(IS_WIN)
+
+class CompactRowW2B24Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  void SetUpOnMainThread() override {
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    // The row comes in at once; the tests hold the slide at the frames they
+    // look at.
+    prefs()->SetInteger(stedding::prefs::kSidebarAnimationSpeed,
+                        stedding::prefs::kSidebarAnimationInstant);
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("a.test", "/title1.html")));
+    ASSERT_TRUE(reveal());
+    // The pointer goes into a window the test runner need not have made
+    // the active one.
+    reveal()->set_ignore_activation_for_testing(true);
+  }
+
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  views::Widget* widget() { return browser_view()->GetWidget(); }
+  stedding::TopRowReveal* reveal() {
+    return browser_view()->stedding_top_row_reveal();
+  }
+  tabs::VerticalTabStripStateController* controller() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  bool RowShows() { return browser_view()->IsToolbarVisible(); }
+
+  void Settle() {
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !BrowserAnimationController::From(browser())->IsAnimating(
+          TabStripAnimations::kVerticalTabStrip);
+    }));
+    views::test::RunScheduledLayout(widget());
+  }
+
+  // Closes the sidebar to the rail, "Show the address row only on hover"
+  // on: the row hides and the page takes the window's top, past the card's
+  // gutter beside the rail.
+  void CloseToTheRail() {
+    prefs()->SetInteger(stedding::prefs::kSidebarClosedForm,
+                        stedding::prefs::kSidebarClosedToIcons);
+    prefs()->SetBoolean(stedding::prefs::kToolbarHideInCompact, true);
+    if (!controller()->IsCollapsed()) {
+      controller()->RequestCollapse(true);
+    }
+    Settle();
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return !RowShows();
+    })) << "the row stayed with the sidebar closed";
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return Page().y() ==
+             VerticalTabStripRegionView::SteddingCardGutter(browser_view());
+    })) << "the page does not take the window's top: it starts at "
+        << Page().y();
+    ASSERT_GT(Page().y(), 0) << "no gutter beside the rail";
+  }
+
+  // `view`'s bounds in the browser view.
+  gfx::Rect InWindow(views::View* view) {
+    gfx::Point origin;
+    views::View::ConvertPointToTarget(view, browser_view(), &origin);
+    return gfx::Rect(origin, view->size());
+  }
+  gfx::Rect Page() { return InWindow(browser_view()->contents_container()); }
+
+  // The pointer at `point`, in the browser view, as the window hears it.
+  void MoveTo(ui::test::EventGenerator& generator, gfx::Point point) {
+#if BUILDFLAG(IS_MAC)
+    generator.set_target(ui::test::EventGenerator::Target::APPLICATION);
+#endif
+    views::View::ConvertPointToScreen(browser_view(), &point);
+    generator.MoveMouseTo(point);
+    base::RunLoop().RunUntilIdle();
+  }
+
+  // Brings the row in from the window's top, over the page's middle. The
+  // pointer stays at the window's top, on the row however little of it is
+  // in, so the row stays over the page.
+  void RevealFromTheTop(ui::test::EventGenerator& generator) {
+    MoveTo(generator, gfx::Point(Page().CenterPoint().x(), 0));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(widget());
+      return RowShows() && reveal()->OverPage() && reveal()->Shown() == 1;
+    })) << "the rest at the window's top did not bring the row in";
+  }
+
+  // The row held at `shown` of its slide and the window laid out there,
+  // twice: a frame of the slide lays out against the top container's place
+  // in the frame before it.
+  void HoldAt(double shown) {
+    reveal()->SetShownForTesting(shown);
+    views::test::RunScheduledLayout(widget());
+    browser_view()->InvalidateLayout();
+    views::test::RunScheduledLayout(widget());
+  }
+};
