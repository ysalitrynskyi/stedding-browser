+// clean-links Cl3: each known redirect page gives its decoded target, a
+// wrapper inside a wrapper is unwrapped, and the target is taken as written
+// (its own tracking parameters are CleanLink's business).
+TEST(CleanLinkTest, UnwrapsKnownRedirectHops) {
+  struct Case {
+    const char* in;
+    const char* out;
+  };
+  const Case kCases[] = {
+      {"https://www.google.com/url?sa=t&q=https%3A%2F%2Fa.test%2Fp%3Fx%3D1"
+       "&usg=abc",
+       "https://a.test/p?x=1"},
+      {"https://www.google.co.uk/url?url=https://a.test/p&sa=t",
+       "https://a.test/p"},
+      {"https://google.com/url?q=http://a.test/", "http://a.test/"},
+      // The usual form of a shared result: an empty q= and the target in
+      // url=.
+      {"https://www.google.com/url?sa=t&rct=j&q=&esrc=s&source=web&cd=&url="
+       "https%3A%2F%2Fa.test%2Fs%3Fk%3D1&usg=abc",
+       "https://a.test/s?k=1"},
+      // A q= that is no address gives way to url=; a q= that is one wins.
+      {"https://www.google.com/url?q=hello&url=https%3A%2F%2Fa.test%2Fu",
+       "https://a.test/u"},
+      {"https://www.google.com/url?q=https%3A%2F%2Fa.test%2Fq&url=https%3A%2F"
+       "%2Fb.test%2Fu",
+       "https://a.test/q"},
+      {"https://l.facebook.com/l.php?u=https%3A%2F%2Fa.test%2F%3Futm_source"
+       "%3Dfb&h=xyz",
+       "https://a.test/?utm_source=fb"},
+      {"https://lm.facebook.com/l.php?u=https%3A%2F%2Fa.test%2F",
+       "https://a.test/"},
+      {"https://l.messenger.com/l.php?u=https%3A%2F%2Fa.test%2Fm",
+       "https://a.test/m"},
+      {"https://l.instagram.com/?u=https%3A%2F%2Fa.test%2Fi&e=1",
+       "https://a.test/i"},
+      {"https://out.reddit.com/t3_abc?url=https%3A%2F%2Fa.test%2Fr&token=1",
+       "https://a.test/r"},
+      {"https://www.youtube.com/redirect?event=video&q=https%3A%2F%2Fa.test"
+       "%2Fy",
+       "https://a.test/y"},
+      // Nested: Google's /url around Facebook's l.php around the target.
+      {"https://www.google.com/url?q=https%3A%2F%2Fl.facebook.com%2Fl.php%3Fu"
+       "%3Dhttps%253A%252F%252Fa.test%252Fn",
+       "https://a.test/n"},
+  };
+  for (const Case& row : kCases) {
+    SCOPED_TRACE(row.in);
+    const std::optional<GURL> target = UnwrapRedirectHop(GURL(row.in));
+    ASSERT_TRUE(target);
+    EXPECT_EQ(GURL(row.out), *target);
