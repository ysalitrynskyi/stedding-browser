+// Sf69 (review finding): a file whose parts an older Stedding here already
+// read, unchanged since, is read again once after the update, so its parts
+// count before the boxes are ticked.
+IN_PROC_BROWSER_TEST_F(SidebarSyncPartsTest, APartReadBeforeAnUpdateIsReadAgain) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  sb::FileParts parts;
+  parts.settings = Setting(p::kUiAnimate, base::Value(false), NowMs());
+  WritePeer(PeerState(space, NowMs()), 1, parts);
+  const base::FilePath file = sync_dir().AppendASCII(sb::FileNameFor(kPeer));
+  std::string with_parts;
+  base::Time mtime;
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(base::ReadFileToString(file, &with_parts));
+    // What an older Stedding sees: the same bytes, the part under a key it
+    // does not read.
+    std::string unread = with_parts;
+    const size_t at = unread.find("\"settings\":");
+    ASSERT_NE(std::string::npos, at);
+    unread.replace(at, 11, "\"setxxxxx\":");
+    ASSERT_TRUE(base::WriteFile(file, unread));
+    mtime = base::Time::Now() - base::Hours(1);
+    ASSERT_TRUE(base::TouchFile(file, mtime, mtime));
+  }
+  sb::JoinParts off;
+  off.settings = false;
+  off.extensions = false;
+  Join(off);
+  Scan();
+  {
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(base::WriteFile(file, with_parts));
+    ASSERT_TRUE(base::TouchFile(file, mtime, mtime));
+  }
+  Scan();
+  ASSERT_TRUE(service()->GetStatus().FindList("settingsThere")->empty())
+      << "the unchanged file was read";
+  service()->ForgetPartsReadForTesting();
+  Scan();
+  const base::DictValue status = service()->GetStatus();
+  const base::ListValue* const there = status.FindList("settingsThere");
+  ASSERT_TRUE(there);
+  ASSERT_EQ(1u, there->size());
+  EXPECT_EQ("Office PC", (*there)[0].GetString());
+}
