   return net::IsCertStatusError(GetVisibleSecurityState()->cert_status);
 }
 
+bool ChromeLocationBarModelDelegate::ShouldTrimDisplayUrlAfterHostName() const {
+  // With "Always show full URLs" off, Stedding shows the bare host in the
+  // steady state, as Arc does; see docs/UI-SPEC.md. The full URL, including
+  // scheme and path, comes back once the user types or moves in the omnibox.
+  // Stedding registers the preference on (toolbar T28), so this is the path of
+  // a user who turned it off.
+  //
+  // This repeats the body of `ShouldPreventElision()` rather than calling it,
+  // because that override is non-const. Keep the two in step: whenever the user
+  // has asked to always see the full URL, or the certificate is bad, the host
+  // alone is not enough to judge the page by and nothing may be trimmed.
+  Profile* const profile = GetProfile();
+  if (profile && profile->GetPrefs()->GetBoolean(
+                     omnibox::kPreventUrlElisionsInOmnibox)) {
+    return false;
+  }
+  return !net::IsCertStatusError(GetVisibleSecurityState()->cert_status);
+}
+
 bool ChromeLocationBarModelDelegate::ShouldDisplayURL() const {
   // Note: The order here is important.
   // - The WebUI test must come before the extension scheme test because there
@@ -316,5 +335,9 @@ TemplateURLService* ChromeLocationBarModelDelegate::GetTemplateURLService() {
 // static
 void ChromeLocationBarModelDelegate::RegisterProfilePrefs(
     user_prefs::PrefRegistrySyncable* registry) {
-  registry->RegisterBooleanPref(omnibox::kPreventUrlElisionsInOmnibox, false);
+  // Stedding (docs/features/toolbar.md T28): the address bar shows the whole
+  // address, scheme and path included, from the first launch. Chromium
+  // registers "Always show full URLs" off. The address bar's context menu
+  // still turns it off, and a policy can still set it either way.
+  registry->RegisterBooleanPref(omnibox::kPreventUrlElisionsInOmnibox, true);
 }
