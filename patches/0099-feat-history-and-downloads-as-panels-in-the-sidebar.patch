+namespace stedding {
+
+// docs/features/sidebar-panels.md: the panels that take the tab list's place
+// in the sidebar's column.
+enum class SidebarPanel { kNone, kHistory, kDownloads };
+
+// The panels' page, chrome://stedding-library, one path for each panel.
+inline constexpr char kLibraryHost[] = "stedding-library";
+inline constexpr char kLibraryURL[] = "chrome://stedding-library/";
+inline constexpr char kLibraryHistoryURL[] =
+    "chrome://stedding-library/history";
+inline constexpr char kLibraryDownloadsURL[] =
+    "chrome://stedding-library/downloads";
+
+// Pn4: while a panel is open the open sidebar is drawn at least this wide.
+inline constexpr int kSidebarPanelMinWidth = 340;
+// Pn4: below this width the panel's page is not drawn: the rail, the slide
+// out over the page and a strip folded back while the address bar's list is
+// open would squeeze it into a column it cannot be read in.
+inline constexpr int kSidebarPanelDrawnMinWidth = 240;
+
+// Pn4: the width an open sidebar is drawn at: the user's own width, or the
+// panel's least width while a panel is open and the user's is narrower. The
+// user's width itself is never changed.
+int SidebarOpenWidth(int user_width, bool panel_open);
+
+// Pn6: the History panel's ranges.
+enum class HistoryRange { kAll, kToday, kWeek, kMonth };
+
+// The range a page names: "all", "today", "week" or "month".
+std::optional<HistoryRange> HistoryRangeFromName(std::string_view name);
+
+// Pn6: where `range` starts, as seen at `now` in the machine's time zone:
+// local midnight today, six days ago or 29 days ago. None for kAll.
+std::optional<base::Time> HistoryRangeStart(HistoryRange range,
+                                            base::Time now);
+
+// Pn1-Pn3: which panel a window shows. One per window with a sidebar of
+// Spaces, owned by its sidebar (VerticalTabStripRegionView) and found through
+// the window's user data, so the window's commands -- the keys, the menus,
+// the command bar's rows -- can open a panel without the views. Windows with
+// no Spaces (private and Guest windows, popups, apps, little windows) have
+// none, and their commands open Chromium's pages.
+class SidebarPanels {
+ public:
+  DECLARE_USER_DATA(SidebarPanels);
+
+  class Observer : public base::CheckedObserver {
+   public:
+    // The open panel changed from `previous` to `now`.
+    virtual void OnSidebarPanelChanged(SidebarPanel previous,
+                                       SidebarPanel now) {}
+    // Pn14: the profile's "Open History and Downloads in the sidebar"
+    // changed.
+    virtual void OnSidebarPanelsEnabledChanged(bool enabled) {}
+  };
+
+  // Whether the window can show a panel right now: its sidebar is the
+  // window's strip and is drawn. The sidebar answers.
+  using CanShowCallback = base::RepeatingCallback<bool()>;
+
+  // The panels of `browser`, or null for a window that has none.
+  static SidebarPanels* From(BrowserWindowInterface* browser);
+
+  // `host` is the window's user data, `prefs` its profile's.
+  SidebarPanels(ui::UnownedUserDataHost& host,
+                PrefService& prefs,
+                CanShowCallback can_show);
+  SidebarPanels(const SidebarPanels&) = delete;
+  SidebarPanels& operator=(const SidebarPanels&) = delete;
+  ~SidebarPanels();
+
+  // Pn1, Pn2: opens `panel`, switches to it from the other one, or closes it
+  // when it is the one open. False, with nothing changed, when the window
+  // cannot show a panel now or the setting is off (Pn3, Pn14): the caller
+  // then opens Chromium's page.
+  bool Toggle(SidebarPanel panel);
+  // Opens `panel`, or switches to it; true when it is open afterwards.
+  bool Open(SidebarPanel panel);
+  // Closes the open panel, if any.
+  void Close();
+
+  SidebarPanel open() const { return open_; }
+  bool IsOpen() const { return open_ != SidebarPanel::kNone; }
+
+  // Pn14: the profile's setting.
+  bool IsEnabled() const;
+  // Whether a panel can open now: the setting is on and the window can show
+  // it.
+  bool CanShow() const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+ private:
+  void Set(SidebarPanel panel);
+  void OnEnabledChanged();
+
+  const raw_ref<PrefService> prefs_;
+  CanShowCallback can_show_;
+  SidebarPanel open_ = SidebarPanel::kNone;
+  base::ObserverList<Observer> observers_;
+  PrefChangeRegistrar registrar_;
+  ui::ScopedUnownedUserData<SidebarPanels> scoped_user_data_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SIDEBAR_PANELS_H_
diff --git a/chrome/browser/ui/stedding/sidebar_panels_unittest.cc b/chrome/browser/ui/stedding/sidebar_panels_unittest.cc
new file mode 100644
index 0000000000000..d21aebbf93965
--- /dev/null
+++ b/chrome/browser/ui/stedding/sidebar_panels_unittest.cc
@@ -0,0 +1,158 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/sidebar_panels.h"
+
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/unowned_user_data/unowned_user_data_host.h"
+
+namespace stedding {
+namespace {
+
+class Recorder : public SidebarPanels::Observer {
+ public:
+  void OnSidebarPanelChanged(SidebarPanel previous,
+                             SidebarPanel now) override {
+    changes.emplace_back(previous, now);
+  }
+  void OnSidebarPanelsEnabledChanged(bool enabled) override {
+    enabled_changes.push_back(enabled);
+  }
+
+  std::vector<std::pair<SidebarPanel, SidebarPanel>> changes;
+  std::vector<bool> enabled_changes;
+};
+
+class SidebarPanelsModelTest : public testing::Test {
+ protected:
+  SidebarPanelsModelTest() {
+    prefs::RegisterProfilePrefs(prefs_.registry());
+    panels_.emplace(host_, prefs_,
+                    base::BindRepeating([](const bool* can_show) {
+                      return *can_show;
+                    }, base::Unretained(&can_show_)));
+    panels_->AddObserver(&recorder_);
+  }
+  ~SidebarPanelsModelTest() override { panels_->RemoveObserver(&recorder_); }
+
+  SidebarPanels& panels() { return *panels_; }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+  ui::UnownedUserDataHost host_;
+  bool can_show_ = true;
+  Recorder recorder_;
+  std::optional<SidebarPanels> panels_;
+};
+
+// Pn1, Pn2: a key opens its panel, the other key switches to the other
+// panel, the same key again closes it. The window's user data finds the
+// panels.
+TEST_F(SidebarPanelsModelTest, ToggleOpensSwitchesAndCloses) {
+  EXPECT_EQ(&panels(), SidebarPanels::Get(host_));
+  EXPECT_EQ(SidebarPanel::kNone, panels().open());
+
+  EXPECT_TRUE(panels().Toggle(SidebarPanel::kHistory));
+  EXPECT_EQ(SidebarPanel::kHistory, panels().open());
+  EXPECT_TRUE(panels().Toggle(SidebarPanel::kDownloads));
+  EXPECT_EQ(SidebarPanel::kDownloads, panels().open());
+  EXPECT_TRUE(panels().Toggle(SidebarPanel::kDownloads));
+  EXPECT_EQ(SidebarPanel::kNone, panels().open());
+  EXPECT_FALSE(panels().IsOpen());
+
+  const std::vector<std::pair<SidebarPanel, SidebarPanel>> expected = {
+      {SidebarPanel::kNone, SidebarPanel::kHistory},
+      {SidebarPanel::kHistory, SidebarPanel::kDownloads},
+      {SidebarPanel::kDownloads, SidebarPanel::kNone},
+  };
+  EXPECT_EQ(expected, recorder_.changes);
+
+  // Closing what is closed tells nobody.
+  panels().Close();
+  EXPECT_EQ(3u, recorder_.changes.size());
+}
+
+// Pn3, Pn14: a window that cannot show a panel, or a profile with the
+// setting off, refuses, so the caller opens Chromium's page; turning the
+// setting off closes an open panel.
+TEST_F(SidebarPanelsModelTest, NoSidebarFallsBackToThePage) {
+  // On by default (Pn14).
+  EXPECT_TRUE(panels().IsEnabled());
+
+  can_show_ = false;
+  EXPECT_FALSE(panels().CanShow());
+  EXPECT_FALSE(panels().Toggle(SidebarPanel::kHistory));
+  EXPECT_EQ(SidebarPanel::kNone, panels().open());
+
+  can_show_ = true;
+  ASSERT_TRUE(panels().Toggle(SidebarPanel::kHistory));
+  prefs_.SetBoolean(prefs::kSidebarLibraryPanels, false);
+  EXPECT_EQ(SidebarPanel::kNone, panels().open())
+      << "turning the setting off left the panel open";
+  EXPECT_EQ(std::vector<bool>{false}, recorder_.enabled_changes);
+  EXPECT_FALSE(panels().Toggle(SidebarPanel::kDownloads));
+  EXPECT_EQ(SidebarPanel::kNone, panels().open());
+
+  prefs_.SetBoolean(prefs::kSidebarLibraryPanels, true);
+  EXPECT_TRUE(panels().Toggle(SidebarPanel::kDownloads));
+}
+
+// Pn4: an open panel widens a narrow sidebar to its least width and leaves
+// a wider one alone; closed, the user's width is the width.
+TEST(SidebarPanelWidthTest, APanelWidensANarrowSidebarOnly) {
+  EXPECT_EQ(kSidebarPanelMinWidth, SidebarOpenWidth(200, /*panel_open=*/true));
+  EXPECT_EQ(kSidebarPanelMinWidth,
+            SidebarOpenWidth(kSidebarPanelMinWidth, /*panel_open=*/true));
+  EXPECT_EQ(420, SidebarOpenWidth(420, /*panel_open=*/true));
+  EXPECT_EQ(200, SidebarOpenWidth(200, /*panel_open=*/false));
+  EXPECT_LT(kSidebarPanelDrawnMinWidth, kSidebarPanelMinWidth);
+}
+
+// Pn6: Today starts at local midnight, This Week at midnight six days ago
+// and This Month at midnight 29 days ago; All has no start. The page names
+// the ranges, and an unknown name is none of them.
+TEST(LibraryRangeTest, EachRangeStartsAtLocalMidnight) {
+  const base::Time now = base::Time::Now();
+  EXPECT_FALSE(HistoryRangeStart(HistoryRange::kAll, now).has_value());
+
+  const std::optional<base::Time> today =
+      HistoryRangeStart(HistoryRange::kToday, now);
+  ASSERT_TRUE(today.has_value());
+  EXPECT_EQ(now.LocalMidnight(), *today);
+  EXPECT_LE(*today, now);
+
+  const struct {
+    HistoryRange range;
+    int days;
+  } kCases[] = {{HistoryRange::kWeek, 6}, {HistoryRange::kMonth, 29}};
+  for (const auto& test_case : kCases) {
+    const std::optional<base::Time> start =
+        HistoryRangeStart(test_case.range, now);
+    ASSERT_TRUE(start.has_value());
+    // A midnight...
+    EXPECT_EQ(start->LocalMidnight(), *start) << test_case.days;
+    // ...`days` calendar days before today's, whatever summer time did in
+    // between: within an hour of `days` whole days.
+    const base::TimeDelta back = *today - *start;
+    EXPECT_LE((back - base::Days(test_case.days)).magnitude(), base::Hours(1))
+        << test_case.days << " days back measured " << back;
+  }
+
+  EXPECT_EQ(HistoryRange::kAll, HistoryRangeFromName("all"));
+  EXPECT_EQ(HistoryRange::kToday, HistoryRangeFromName("today"));
+  EXPECT_EQ(HistoryRange::kWeek, HistoryRangeFromName("week"));
+  EXPECT_EQ(HistoryRange::kMonth, HistoryRangeFromName("month"));
+  EXPECT_FALSE(HistoryRangeFromName("year").has_value());
+  EXPECT_FALSE(HistoryRangeFromName("").has_value());
+}
+
+}  // namespace
+}  // namespace stedding
