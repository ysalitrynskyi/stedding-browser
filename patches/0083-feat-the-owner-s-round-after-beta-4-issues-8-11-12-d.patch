+void TabHoverCardController::UpdateResourceLine(
+    HoverCardAnchorTarget* anchor_target) {
+  if (!hover_card_ || anchor_target != target_tab_) {
+    return;
+  }
+  if (!std::holds_alternative<TabCardData>(anchor_target->data())) {
+    // A tab group header's card has no line.
+    StopResourceLine();
+    hover_card_->SetResourceLine(std::u16string());
+    return;
+  }
+  const bool asleep =
+      std::get<TabCardData>(anchor_target->data()).is_tab_discarded;
+
+  // The card has just shown on this tab or moved to it: no line until the
+  // wait is over. Each caller fits the card to its content after this.
+  if (resource_line_phase_ == ResourceLinePhase::kIdle) {
+    hover_card_->SetResourceLine(std::u16string());
+    resource_line_asleep_ = asleep;
+    resource_line_phase_ = ResourceLinePhase::kWaiting;
+    resource_line_timer_.Start(
+        FROM_HERE, resource_line_delay_ - GetResourceLineLead(),
+        base::BindOnce(&TabHoverCardController::OnResourceLineTimer,
+                       base::Unretained(this)));
+    return;
+  }
+
+  // The tab went to sleep or woke while its card was up.
+  if (asleep == resource_line_asleep_) {
+    return;
+  }
+  resource_line_asleep_ = asleep;
+  resource_sampler_.reset();
+  if (resource_line_phase_ == ResourceLinePhase::kWaiting) {
+    return;
+  }
+  if (!asleep) {
+    StartResourceSampler();
+  }
+  if (resource_line_phase_ == ResourceLinePhase::kShown) {
+    // Awake again, the line comes back with the tab's first figures.
+    hover_card_->SetResourceLine(asleep ? stedding::TabResourceLineAsleep()
+                                        : std::u16string());
+  }
