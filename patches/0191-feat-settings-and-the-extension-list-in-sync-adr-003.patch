+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_sync_extensions.h"
+
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/values.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_parts.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/extension_builder.h"
+#include "extensions/common/mojom/manifest.mojom-shared.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+// docs/features/sidebar-file.md Sf63-Sf68 (ADR 0037): which extensions
+// travel, and what another computer offers.
+namespace spaces::sidebar_sync {
+namespace {
+
+using extensions::ExtensionBuilder;
+using extensions::mojom::ManifestLocation;
+using ::testing::ElementsAre;
+using ::testing::UnorderedElementsAre;
+
+// Two computers' install ids and three Web Store ids (32 letters a to p).
+constexpr char kOffice[] = "0123456789abcdef";
+constexpr char kLaptop[] = "fedcba9876543210";
+constexpr char kBlocker[] = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+constexpr char kNotes[] = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
+constexpr char kReader[] = "cccccccccccccccccccccccccccccccc";
+
+scoped_refptr<const extensions::Extension> Make(
+    ExtensionBuilder builder,
+    ManifestLocation location,
+    bool from_webstore) {
+  builder.SetLocation(location);
+  if (from_webstore) {
+    builder.AddFlags(extensions::Extension::FROM_WEBSTORE);
+  }
+  return builder.Build();
+}
+
+std::vector<std::string> IdsOf(const std::vector<ExtensionOffer>& offers) {
+  std::vector<std::string> ids;
+  for (const ExtensionOffer& offer : offers) {
+    ids.push_back(offer.id);
+  }
+  return ids;
+}
+
+const ExtensionOffer* OfferOf(const std::vector<ExtensionOffer>& offers,
+                              const std::string& id) {
+  for (const ExtensionOffer& offer : offers) {
+    if (offer.id == id) {
+      return &offer;
+    }
+  }
+  return nullptr;
+}
+
+// Sf63: only an extension the person installed from the Chrome Web Store
+// travels. Unpacked ones, ones a policy or another program put here,
+// Chromium's own components, a crx from elsewhere, themes and apps stay.
+TEST(SidebarSyncExtensionsTest, OnlyWebStoreExtensionsTravel) {
+  EXPECT_TRUE(IsWebStoreExtension(*Make(ExtensionBuilder("From the store"),
+                                        ManifestLocation::kInternal,
+                                        /*from_webstore=*/true)));
+
+  EXPECT_FALSE(IsWebStoreExtension(*Make(ExtensionBuilder("Another store"),
+                                         ManifestLocation::kInternal,
+                                         /*from_webstore=*/false)));
+  EXPECT_FALSE(IsWebStoreExtension(*Make(ExtensionBuilder("Unpacked"),
+                                         ManifestLocation::kUnpacked,
+                                         /*from_webstore=*/false)));
+  EXPECT_FALSE(IsWebStoreExtension(*Make(
+      ExtensionBuilder("By policy"), ManifestLocation::kExternalPolicyDownload,
+      /*from_webstore=*/true)));
+  EXPECT_FALSE(IsWebStoreExtension(*Make(ExtensionBuilder("Forced"),
+                                         ManifestLocation::kExternalPolicy,
+                                         /*from_webstore=*/true)));
+  EXPECT_FALSE(IsWebStoreExtension(*Make(ExtensionBuilder("Another program"),
+                                         ManifestLocation::kExternalPref,
+                                         /*from_webstore=*/true)));
+  EXPECT_FALSE(IsWebStoreExtension(*Make(ExtensionBuilder("In the registry"),
+                                         ManifestLocation::kExternalRegistry,
+                                         /*from_webstore=*/true)));
+  EXPECT_FALSE(IsWebStoreExtension(*Make(ExtensionBuilder("A component"),
+                                         ManifestLocation::kComponent,
+                                         /*from_webstore=*/false)));
+  EXPECT_FALSE(IsWebStoreExtension(*Make(ExtensionBuilder("Command line"),
+                                         ManifestLocation::kCommandLine,
+                                         /*from_webstore=*/false)));
+
+  ExtensionBuilder theme("A theme");
+  theme.SetManifestKey("theme", base::DictValue());
+  EXPECT_FALSE(IsWebStoreExtension(*Make(std::move(theme),
+                                         ManifestLocation::kInternal,
+                                         /*from_webstore=*/true)));
+  EXPECT_FALSE(IsWebStoreExtension(
+      *Make(ExtensionBuilder("An app", ExtensionBuilder::Type::PLATFORM_APP),
+            ManifestLocation::kInternal, /*from_webstore=*/true)));
+}
+
+// Sf64: each extension another computer has and this one lacks is offered
+// once, named, with every computer that has it; one installed here is not.
+TEST(SidebarSyncExtensionsTest, AnExtensionThisComputerLacksIsOffered) {
+  const std::map<std::string, std::vector<ExtensionEntry>> peers = {
+      {kOffice, {{kBlocker, "Blocker"}, {kNotes, "Notes"}}},
+      {kLaptop, {{kBlocker, "Blocker"}, {kReader, "Reader"}}},
+  };
+  const std::vector<ExtensionOffer> offers =
+      ExtensionOffers(peers, /*installed_here=*/{kReader},
+                      /*declined=*/{}, /*uninstalled_here=*/{});
+  EXPECT_THAT(IdsOf(offers), ElementsAre(kBlocker, kNotes));
+  const ExtensionOffer* const blocker = OfferOf(offers, kBlocker);
+  ASSERT_TRUE(blocker);
+  EXPECT_EQ("Blocker", blocker->name);
+  EXPECT_THAT(blocker->installs, UnorderedElementsAre(kOffice, kLaptop));
+  const ExtensionOffer* const notes = OfferOf(offers, kNotes);
+  ASSERT_TRUE(notes);
+  EXPECT_THAT(notes->installs, ElementsAre(kOffice));
+
+  // Nothing is offered when this computer has them all, or no other
+  // computer lists any.
+  EXPECT_TRUE(ExtensionOffers(peers, {kBlocker, kNotes, kReader}, {}, {})
+                  .empty());
+  EXPECT_TRUE(ExtensionOffers({}, {}, {}, {}).empty());
+}
+
+// Sf65: an offer declined in the confirmation is not made again from that
+// computer. Another computer that lists it still offers it.
+TEST(SidebarSyncExtensionsTest,
+     ADeclinedExtensionIsNotOfferedAgainFromThatComputer) {
+  std::map<std::string, std::vector<ExtensionEntry>> peers = {
+      {kOffice, {{kBlocker, "Blocker"}}},
+  };
+  const std::set<std::string> declined = {DeclineKey(kOffice, kBlocker)};
+  EXPECT_TRUE(ExtensionOffers(peers, {}, declined, {}).empty());
+
+  peers[kLaptop] = {{kBlocker, "Blocker"}};
+  const std::vector<ExtensionOffer> offers =
+      ExtensionOffers(peers, {}, declined, {});
+  ASSERT_EQ(1u, offers.size());
+  EXPECT_EQ(kBlocker, offers[0].id);
+  EXPECT_THAT(offers[0].installs, ElementsAre(kLaptop));
+
+  // The decline is by computer and by extension: it says nothing of the
+  // office computer's other extensions.
+  EXPECT_NE(DeclineKey(kOffice, kBlocker), DeclineKey(kLaptop, kBlocker));
+  EXPECT_NE(DeclineKey(kOffice, kBlocker), DeclineKey(kOffice, kNotes));
+}
+
+// Sf66: an extension the person uninstalled on this computer is not offered
+// here again, from any computer.
+TEST(SidebarSyncExtensionsTest, AnExtensionUninstalledHereIsNotOffered) {
+  const std::map<std::string, std::vector<ExtensionEntry>> peers = {
+      {kOffice, {{kBlocker, "Blocker"}, {kNotes, "Notes"}}},
+      {kLaptop, {{kBlocker, "Blocker"}}},
+  };
+  const std::vector<ExtensionOffer> offers =
+      ExtensionOffers(peers, {}, {}, /*uninstalled_here=*/{kBlocker});
+  EXPECT_THAT(IdsOf(offers), ElementsAre(kNotes));
+}
+
+// Sf63: the list carries each extension's id and name, nothing else, and a
+// list from another computer is not trusted.
+TEST(SidebarSyncExtensionsTest, TheListCarriesIdAndNameAlone) {
+  const base::ListValue written =
+      ExtensionsToValue({{kNotes, "Notes"}, {kBlocker, "Blocker"}});
+  ASSERT_EQ(2u, written.size());
+  for (const base::Value& entry : written) {
+    ASSERT_TRUE(entry.is_dict());
+    EXPECT_EQ(2u, entry.GetDict().size());
+    EXPECT_TRUE(entry.GetDict().FindString("id"));
+    EXPECT_TRUE(entry.GetDict().FindString("name"));
+  }
+  // By id.
+  EXPECT_EQ(kBlocker, *written[0].GetDict().FindString("id"));
+  const std::optional<std::vector<ExtensionEntry>> read =
+      ExtensionsFromValue(base::Value(written.Clone()));
+  ASSERT_TRUE(read);
+  EXPECT_THAT(*read, ElementsAre(ExtensionEntry{kBlocker, "Blocker"},
+                                 ExtensionEntry{kNotes, "Notes"}));
+
+  // A bad entry is dropped alone: an id that is no Web Store id, an entry
+  // with no id, one that is no dictionary.
+  base::ListValue mixed = written.Clone();
+  mixed.Append(base::DictValue().Set("id", "../../etc").Set("name", "Bad"));
+  mixed.Append(base::DictValue().Set("id", "ABCDEFGHIJKLMNOPABCDEFGHIJKLMNOP")
+                   .Set("name", "Capitals"));
+  mixed.Append(base::DictValue().Set("name", "No id"));
+  mixed.Append("not a dictionary");
+  const std::optional<std::vector<ExtensionEntry>> kept =
+      ExtensionsFromValue(base::Value(std::move(mixed)));
+  ASSERT_TRUE(kept);
+  EXPECT_THAT(*kept, ElementsAre(ExtensionEntry{kBlocker, "Blocker"},
+                                 ExtensionEntry{kNotes, "Notes"}));
+  EXPECT_FALSE(IsExtensionId("../../etc"));
+  EXPECT_FALSE(IsExtensionId("ABCDEFGHIJKLMNOPABCDEFGHIJKLMNOP"));
+  EXPECT_TRUE(IsExtensionId(kReader));
+
+  // Not a list, or a list past its cap, is not read at all.
+  EXPECT_FALSE(ExtensionsFromValue(base::Value("text")));
+  EXPECT_FALSE(ExtensionsFromValue(base::Value(base::DictValue())));
+  base::ListValue too_many;
+  for (size_t i = 0; i <= kMaxPartEntries; ++i) {
+    too_many.Append(base::DictValue().Set("id", kBlocker).Set("name", "B"));
+  }
+  EXPECT_FALSE(ExtensionsFromValue(base::Value(std::move(too_many))));
+}
