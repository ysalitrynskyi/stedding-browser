+// P33-1a, toolbar T64: the row brought in over the page stays while a bubble
+// opened from it has the window's activation, the pointer over the page. As
+// the bubble took the activation the window's focus went to nothing, which
+// sent the row away as if the keyboard had left it: the bubble lost the row
+// it was opened from, and back in the window the focus was in a row no
+// longer drawn.
+IN_PROC_BROWSER_TEST_F(CompactRowActivationB24Test,
+                       ABubbleOpenedFromTheRowKeepsItOverThePage) {
+  bookmarks::test::WaitForBookmarkModelToLoad(
+      BookmarkModelFactory::GetForBrowserContext(browser()->GetProfile()));
+  ASSERT_NO_FATAL_FAILURE(CloseTo(stedding::prefs::kSidebarClosedHidden));
+  widget()->Activate();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return widget()->IsActive(); }))
+      << "the window did not become the active one";
+  ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                     widget()->GetNativeWindow());
+  MoveTo(generator, Page().CenterPoint());
+
+  // Move the focus to the toolbar: the row comes in, and the field takes the
+  // focus.
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_FOCUS_TOOLBAR));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    return RowShows() && reveal()->OverPage();
+  })) << "the keyboard did not bring the row in";
+  browser_view()->GetLocationBarView()->FocusLocation(
+      /*is_user_initiated=*/true, /*clear_focus_if_failed=*/false);
+  views::FocusManager* const focus = widget()->GetFocusManager();
+  ASSERT_TRUE(
+      browser_view()->top_container()->Contains(focus->GetFocusedView()))
+      << "the field took no focus";
+
+  // Bookmark This Tab: its bubble opens from the row's star and takes the
+  // activation.
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_BOOKMARK_THIS_TAB));
+  views::Widget* bubble = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::BubbleDialogDelegate* const delegate =
+        BookmarkBubbleView::bookmark_bubble();
+    bubble = delegate ? delegate->GetWidget() : nullptr;
+    return bubble && bubble->IsVisible();
+  })) << "no bookmark bubble opened";
+  bubble->Activate();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return bubble->IsActive() && !widget()->IsActive(); }))
+      << "the bubble did not take the activation";
+
+  PastTheRest();
+  EXPECT_TRUE(RowShows()) << "the row went while its bubble was open";
+  EXPECT_TRUE(reveal()->OverPage());
+  BookmarkBubbleView::Hide();
+}
