+// commandbar K23: whether `match`, the omnibox's default match for `typed`,
+// completes the field to a site. It must be allowed to be the default, not
+// be a search, and the typed text plus its inline completion must spell the
+// start of the site's host, or all of it when a port or a path follows. That
+// rules out a completion from a page's title or a shortcut's text, and an
+// answer left over from an earlier text.
+bool CompletesToSite(const AutocompleteMatch& match,
+                     std::u16string_view typed) {
+  if (!match.allowed_to_be_default_match ||
+      match.inline_autocompletion.empty() ||
+      AutocompleteMatch::IsSearchType(match.type) ||
+      !match.destination_url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  static constexpr std::u16string_view kSchemes[] = {u"https://", u"http://"};
+  static constexpr std::u16string_view kWww = u"www.";
+  const std::u16string shown = base::ToLowerASCII(
+      std::u16string(typed) + match.inline_autocompletion);
+  std::u16string_view rest = shown;
+  for (const std::u16string_view scheme : kSchemes) {
+    if (rest.starts_with(scheme)) {
+      rest.remove_prefix(scheme.size());
+      break;
+    }
+  }
+  if (rest.starts_with(kWww)) {
+    rest.remove_prefix(kWww.size());
+  }
+  // GURL::host() is a view into the URL's spec.
+  const std::u16string host = base::ToLowerASCII(
+      url_formatter::IDNToUnicode(match.destination_url.host()));
+  std::u16string_view site = host;
+  if (site.starts_with(kWww)) {
+    site.remove_prefix(kWww.size());
+  }
+  const size_t end = rest.find_first_of(u":/");
+  const std::u16string_view shown_host = rest.substr(0, end);
+  if (shown_host.empty()) {
+    return false;
+  }
+  return end == std::u16string_view::npos ? site.starts_with(shown_host)
+                                          : site == shown_host;
+}
