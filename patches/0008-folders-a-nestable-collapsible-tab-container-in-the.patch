@@ -0,0 +1,196 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/common/folder_view.h"
+
+#include <memory>
+#include <utility>
+#include <variant>
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/views/tabs/common/tab_collection_node.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/events/event.h"
+#include "ui/gfx/font_list.h"
+#include "ui/views/background.h"
+#include "ui/views/controls/label.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/views/layout/box_layout.h"
+#include "ui/views/layout/layout_provider.h"
+#include "ui/views/view_class_properties.h"
+
+namespace {
+
+constexpr int kIndent = 14;
+constexpr int kHeaderInset = 8;
+constexpr SkColor kHeaderText = SkColorSetA(SK_ColorWHITE, 0xD8);
+constexpr SkColor kChevronText = SkColorSetA(SK_ColorWHITE, 0x99);
+constexpr SkColor kDropHighlight = SkColorSetA(SK_ColorWHITE, 0x2E);
+constexpr int kDropHighlightRadius = 8;
+
+tabs::FolderTabCollection* FolderFromNode(TabCollectionNode* node) {
+  CHECK(node);
+  // The node data is const; the folder's name and collapse state are ours to
+  // change, which is the entire purpose of this view.
+  return const_cast<tabs::FolderTabCollection*>(
+      static_cast<const tabs::FolderTabCollection*>(
+          std::get<tabs::ConstDanglingUntriagedTabCollection>(
+              node->GetNodeData())));
+}
+
+}  // namespace
+
+// The header row: chevron + name. Single click collapses, double click
+// renames.
+class FolderView::HeaderView : public views::View {
+  METADATA_HEADER(HeaderView, views::View)
+
+ public:
+  explicit HeaderView(FolderView* owner) : owner_(owner) {
+    auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal,
+        gfx::Insets::VH(0, kHeaderInset), 6));
+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kCenter);
+    SetPreferredSize(
+        gfx::Size(0, GetLayoutConstant(LayoutConstant::kVerticalTabHeight)));
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override { return true; }
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (!GetLocalBounds().Contains(event.location())) {
+      return;
+    }
+    if (event.GetClickCount() >= 2) {
+      owner_->BeginRename();
+    } else {
+      owner_->ToggleCollapsed();
+    }
+  }
+
+ private:
+  const raw_ptr<FolderView> owner_;
+};
+
+FolderView::FolderView(TabCollectionNode* collection_node)
+    : collection_node_(collection_node) {
+  auto* const layout = SetLayoutManager(std::make_unique<views::BoxLayout>(
+      views::BoxLayout::Orientation::kVertical));
+  layout->SetDefaultFlex(0);
+
+  auto header = std::make_unique<HeaderView>(this);
+  chevron_ = header->AddChildView(std::make_unique<views::Label>());
+  chevron_->SetEnabledColor(kChevronText);
+  name_ = header->AddChildView(std::make_unique<views::Label>());
+  name_->SetEnabledColor(kHeaderText);
+  name_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+  auto rename = std::make_unique<views::Textfield>();
+  rename->set_controller(this);
+  rename->SetVisible(false);
+  rename_field_ = header->AddChildView(std::move(rename));
+
+  header_ = AddChildView(std::move(header));
+  UpdateHeader();
+}
+
+FolderView::~FolderView() = default;
+
+tabs::FolderTabCollection* FolderView::folder() const {
+  return FolderFromNode(collection_node_);
+}
+
+gfx::Rect FolderView::GetHeaderBoundsInScreen() const {
+  return header_ ? header_->GetBoundsInScreen() : gfx::Rect();
+}
+
+void FolderView::SetDropHighlight(bool highlighted) {
+  if (!header_) {
+    return;
+  }
+  header_->SetBackground(highlighted
+                             ? views::CreateRoundedRectBackground(
+                                   kDropHighlight, kDropHighlightRadius)
+                             : nullptr);
+  header_->SchedulePaint();
+}
+
+void FolderView::ViewHierarchyChanged(
+    const views::ViewHierarchyChangedDetails& details) {
+  views::View::ViewHierarchyChanged(details);
+  if (!details.is_add || details.parent != this ||
+      details.child == header_) {
+    return;
+  }
+  // Tabs and nested folders sit indented under the header, as the reference
+  // draws them.
+  details.child->SetProperty(views::kMarginsKey,
+                             gfx::Insets::TLBR(0, kIndent, 0, 0));
+  details.child->SetVisible(!folder()->collapsed());
+}
+
+void FolderView::ToggleCollapsed() {
+  folder()->SetCollapsed(!folder()->collapsed());
+  ApplyCollapsed();
+}
+
+void FolderView::ApplyCollapsed() {
+  const bool collapsed = folder()->collapsed();
+  for (views::View* child : children()) {
+    if (child != header_) {
+      child->SetVisible(!collapsed);
+    }
+  }
+  UpdateHeader();
+  PreferredSizeChanged();
+}
+
+void FolderView::UpdateHeader() {
+  chevron_->SetText(folder()->collapsed() ? u"▸" : u"▾");
+  const std::string& title = folder()->title();
+  name_->SetText(title.empty() ? u"New Folder" : base::UTF8ToUTF16(title));
+}
+
+void FolderView::BeginRename() {
+  rename_field_->SetText(base::UTF8ToUTF16(folder()->title()));
+  chevron_->SetVisible(false);
+  name_->SetVisible(false);
+  rename_field_->SetVisible(true);
+  rename_field_->RequestFocus();
+  rename_field_->SelectAll(false);
+}
+
+void FolderView::EndRename(bool commit) {
+  if (commit) {
+    folder()->SetTitle(base::UTF16ToUTF8(rename_field_->GetText()));
+  }
+  rename_field_->SetVisible(false);
+  chevron_->SetVisible(true);
+  name_->SetVisible(true);
+  UpdateHeader();
+}
+
+bool FolderView::HandleKeyEvent(views::Textfield* sender,
+                                const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    EndRename(/*commit=*/true);
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    EndRename(/*commit=*/false);
+    return true;
+  }
+  return false;
+}
+
+BEGIN_METADATA(FolderView, HeaderView)
+END_METADATA
+
+BEGIN_METADATA(FolderView)
+END_METADATA
