+// toolbar T18 (GitHub issue 14, BACKLOG S-275): the address keeps its place
+// when the field takes focus and while it is edited, as long as it fits; an
+// address that fills the field takes Chromium's place at the field's left
+// edge, and a short one is gathered on the middle again. It had jumped to
+// the field's left edge as soon as the field took focus.
+IN_PROC_BROWSER_TEST_F(AddressBandTest, TheAddressKeepsItsPlaceWhenEdited) {
+  OmniboxViewViews* const omnibox = bar()->omnibox_view();
+  // The site chip's text slides in and out; the cluster is measured once it
+  // has settled, not half way through the slide.
+  const auto settled = [&]() {
+    return base::test::RunUntil([&]() {
+      views::test::RunScheduledLayout(view());
+      return !bar()->location_icon_view()->is_animating_label();
+    });
+  };
+  ASSERT_TRUE(settled());
+  const int at_rest = omnibox->bounds().CenterPoint().x();
+  const int rest_x = omnibox->x();
+  int focused_x = 0;
+  {
+    SCOPED_TRACE("the field takes focus");
+    chrome::FocusLocationBar(browser());
+    ASSERT_TRUE(base::test::RunUntil([&]() { return omnibox->HasFocus(); }));
+    ASSERT_TRUE(settled());
+    // The chip beside it may change with the focus, a few DIP either way;
+    // the left edge it had jumped to is hundreds of DIP away.
+    EXPECT_NEAR(at_rest, omnibox->bounds().CenterPoint().x(), 12)
+        << "the address moved when the field took focus";
+    focused_x = omnibox->x();
+  }
+  int filled_x = 0;
+  {
+    SCOPED_TRACE("an address that fills the field");
+    omnibox->SetUserText(std::u16string(400, u'w'), /*update_popup=*/false);
+    views::test::RunScheduledLayout(view());
+    filled_x = omnibox->x();
+    EXPECT_LT(filled_x, rest_x) << "a full field's address is not at its left";
+    EXPECT_GT(focused_x - filled_x, 40)
+        << "the focused address sat at the field's left edge";
+  }
+  {
+    SCOPED_TRACE("a short address while editing");
+    omnibox->SetUserText(u"a.test", /*update_popup=*/false);
+    views::test::RunScheduledLayout(view());
+    EXPECT_GT(omnibox->x(), filled_x)
+        << "a short address is not gathered on the middle while edited";
+  }
+  omnibox->RevertAll();
+  view()->GetFocusManager()->ClearFocus();
+  views::test::RunScheduledLayout(view());
+  EXPECT_GT(omnibox->x(), filled_x)
+      << "the address is not gathered on the middle after the edit";
+}
