+  {
+    // S in D4, after x, sits five folders down.
+    SCOPED_TRACE("at the cap");
+    EXPECT_TRUE(tabstrip()->MoveFolderInto(single, d4, 1));
+    EXPECT_EQ(d4, single->GetParentCollection());
+    EXPECT_EQ(single, z->GetParentCollection());
+    EXPECT_EQ(1, tabstrip()->GetIndexOfTab(z));
+    EXPECT_EQ(2, tabstrip()->GetIndexOfTab(y));
+    // P1 in D3, before D4: P2 is five down too.
+    EXPECT_TRUE(tabstrip()->MoveFolderInto(p1, d3, 0));
+    EXPECT_EQ(d3, p1->GetParentCollection());
+    EXPECT_EQ(p1, p2->GetParentCollection());
