+  tabs::TabInterface* const pin = OpenPin("a.test");
+  tabs::FolderTabCollection* const folder = FolderOf({pin});
+  ASSERT_TRUE(folder);
+  OpenLoaded("b.test");
+  FolderView* const header = DrawnFolder(folder);
+  ASSERT_TRUE(header);
+  views::Label* const name = header->name_for_testing();
+  const gfx::Point away = DrawnRow(pin)->GetBoundsInScreen().CenterPoint();
