+++ b/chrome/test/stedding/audit_b08_browsertest.cc
@@ -0,0 +1,170 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// An address entered in the search box of a fresh tab's own page
+// (chrome://new-tab-page) follows the routes and the Space's jar the way an
+// address typed in the address bar does (docs/features/routing.md D2,
+// PLAN.md CMD-8). The tab gets new contents in that jar before the address
+// loads; the page whose search box asked for the address is still alive when
+// that call returns, and goes a turn later. The search box belongs to that
+// page: deleted under it, the box's own code ran on freed memory as the call
+// returned.
+
+#include <optional>
+#include <string>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_router.h"
+#include "chrome/browser/ui/spaces/space_storage_partition.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/page_navigator.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "content/public/test/test_utils.h"
+#include "net/dns/mock_host_resolver.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+// A Space with a session of its own, Work, beside the shared Home.
+class FreshTabSearchBoxB08Test : public InProcessBrowserTest {
+ protected:
+  void TearDownOnMainThread() override {
+    model_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    model_ = spaces::SpaceModel::From(browser());
+    ASSERT_TRUE(model_);
+    home_ = model_->active_id();
+    work_ = model_->AddSpace("Work", SK_ColorBLUE)->id();
+    model_->SetSpaceIsolated(work_, true);
+    ASSERT_TRUE(model_->SpaceIsIsolated(work_));
+  }
+
+  GURL Url(const std::string& host, const std::string& path) {
+    return embedded_test_server()->GetURL(host, path);
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  // chrome://new-tab-page, typed by hand, in its own tab of the Space on
+  // screen: the new tab page with a search box of its own.
+  tabs::TabInterface* OpenNewTabPageWithSearchBox() {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), GURL(chrome::kChromeUINewTabPageURL),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    tabs::TabInterface* const tab = tabs()->GetActiveTab();
+    EXPECT_EQ(GURL(chrome::kChromeUINewTabPageURL),
+              tab->GetContents()->GetLastCommittedURL());
+    // The browser's own pages keep the profile's jar in every Space.
+    EXPECT_FALSE(spaces::IsSpaceStoragePartition(
+        spaces::StoragePartitionConfigForWebContents(tab->GetContents())));
+    return tab;
+  }
+
+  // What the page's search box does with an address the user typed in it
+  // and entered: it asks the page's own contents to open it in their tab
+  // (SearchboxOmniboxClient::OnAutocompleteAccept).
+  static void EnterInSearchBox(content::WebContents* page, const GURL& url) {
+    page->OpenURL(content::OpenURLParams::CreateBrowserInitiated(
+                      url, WindowOpenDisposition::kCurrentTab,
+                      ui::PageTransitionFromInt(
+                          ui::PAGE_TRANSITION_TYPED |
+                          ui::PAGE_TRANSITION_FROM_ADDRESS_BAR)),
+                  /*navigation_handle_callback=*/{});
+  }
+
+  content::StoragePartitionConfig WorkJar() {
+    const std::optional<content::StoragePartitionConfig> jar =
+        spaces::StoragePartitionConfigForSpace(browser()->GetProfile(),
+                                               model_->registry(), work_);
+    EXPECT_TRUE(jar.has_value());
+    return jar.value_or(content::StoragePartitionConfig::CreateDefault(
+        browser()->GetProfile()));
+  }
+
+  raw_ptr<spaces::SpaceModel> model_ = nullptr;
+  spaces::SpaceId home_ = spaces::SpaceId::GenerateNew();
+  spaces::SpaceId work_ = spaces::SpaceId::GenerateNew();
+};
+
+// P09-1f, routing D2 (PLAN.md CMD-8): in a Space with a session of its own,
+// an address entered in the search box of chrome://new-tab-page loads in new
+// contents in the Space's jar. The page, which owns the search box, is still
+// alive when the search box's call returns, and is deleted after.
+IN_PROC_BROWSER_TEST_F(FreshTabSearchBoxB08Test,
+                       ThePageWhoseSearchBoxOpensAnAddressOutlivesTheCall) {
+  ASSERT_TRUE(model_->SetActiveSpace(work_));
+  tabs::TabInterface* const tab = OpenNewTabPageWithSearchBox();
+  ASSERT_EQ(work_, model_->FindSpaceForTab(tab));
+  content::WebContents* const page = tab->GetContents();
+  const GURL address = Url("b.test", "/title1.html");
+
+  content::WebContentsDestroyedWatcher gone(page);
+  EnterInSearchBox(page, address);
+  EXPECT_FALSE(gone.IsDestroyed())
+      << "the page was deleted while its search box was still on the stack";
+  EXPECT_NE(page, tab->GetContents()) << "new contents, in the Space's jar";
+
+  gone.Wait();
+  content::WebContents* const moved = tab->GetContents();
+  ASSERT_TRUE(content::WaitForLoadStop(moved));
+  EXPECT_EQ(address, moved->GetLastCommittedURL());
+  EXPECT_EQ(work_, model_->FindSpaceForTab(tab));
+  EXPECT_EQ(WorkJar(), spaces::StoragePartitionConfigForWebContents(moved));
+}
+
+// P09-1f, routing D2 (PLAN.md CMD-8): the same from a shared Space, for an
+// address a route sends to the Space with its own session: the tab moves
+// there in that Space's jar, and the page that asked is deleted only after
+// the call returns.
+IN_PROC_BROWSER_TEST_F(FreshTabSearchBoxB08Test,
+                       ThePageWhoseSearchBoxOpensARoutedAddressOutlivesTheCall) {
+  spaces::Route route;
+  route.match = spaces::Route::Match::kHost;
+  route.pattern = "routed.test";
+  route.space = work_.ToString();
+  spaces::AddRoute(browser()->GetProfile()->GetPrefs(), route);
+  ASSERT_EQ(home_, model_->active_id());
+  tabs::TabInterface* const tab = OpenNewTabPageWithSearchBox();
+  ASSERT_EQ(home_, model_->FindSpaceForTab(tab));
+  content::WebContents* const page = tab->GetContents();
+  const GURL address = Url("routed.test", "/title1.html");
+
+  content::WebContentsDestroyedWatcher gone(page);
+  EnterInSearchBox(page, address);
+  EXPECT_FALSE(gone.IsDestroyed())
+      << "the page was deleted while its search box was still on the stack";
+  EXPECT_EQ(work_, model_->FindSpaceForTab(tab));
+
+  gone.Wait();
+  content::WebContents* const moved = tab->GetContents();
+  ASSERT_TRUE(content::WaitForLoadStop(moved));
+  EXPECT_EQ(address, moved->GetLastCommittedURL());
+  EXPECT_EQ(work_, model_->FindSpaceForTab(tab));
+  EXPECT_EQ(WorkJar(), spaces::StoragePartitionConfigForWebContents(moved));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/audit_b09_browsertest.cc b/chrome/test/stedding/audit_b09_browsertest.cc
