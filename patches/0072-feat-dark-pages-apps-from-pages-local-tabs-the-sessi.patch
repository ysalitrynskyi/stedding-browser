+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/isolation_mark_view.h"
+
+#include <memory>
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/color/color_id.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view.h"
+
+namespace stedding {
+namespace {
+
+// sessions S32: the glyph follows the Space's name with a gap of its own,
+// centred on the line, and a name too long for both gives up its end, so the
+// mark is never pushed out of the row or drawn over the text.
+TEST(IsolationMarkViewTest, TheGlyphFollowsTheTextAndTheTextMakesRoom) {
+  {
+    SCOPED_TRACE("a short name");
+    const MarkAfterText placed =
+        PlaceMarkAfterText(gfx::Rect(8, 0, 60, 30), /*trailing_edge=*/200);
+    EXPECT_EQ(gfx::Rect(8, 0, 60, 30), placed.label);
+    EXPECT_EQ(gfx::Rect(74, 8, 14, 14), placed.mark);
+  }
+  {
+    SCOPED_TRACE("a name that fills the row");
+    const MarkAfterText placed =
+        PlaceMarkAfterText(gfx::Rect(8, 0, 192, 30), /*trailing_edge=*/200);
+    EXPECT_EQ(gfx::Rect(8, 0, 172, 30), placed.label);
+    EXPECT_EQ(gfx::Rect(186, 8, 14, 14), placed.mark);
+    EXPECT_EQ(200, placed.mark.right()) << "the mark ends at the edge";
+    EXPECT_LE(placed.label.right(), placed.mark.x()) << "never over the text";
+  }
+  {
+    SCOPED_TRACE("a label with no room at all");
+    const MarkAfterText placed =
+        PlaceMarkAfterText(gfx::Rect(190, 0, 10, 30), /*trailing_edge=*/200);
+    EXPECT_EQ(0, placed.label.width());
+    EXPECT_EQ(200, placed.mark.right());
+  }
+}
+
+// sessions S32, spaces B38: the badge sits over the bottom trailing corner of
+// the Space's glyph, standing a third out of it, and never leaves its host.
+TEST(IsolationMarkViewTest, TheBadgeSitsOnTheGlyphsCornerInsideItsHost) {
+  {
+    SCOPED_TRACE("a 24 DIP chip with its 16 DIP glyph in the middle");
+    EXPECT_EQ(gfx::Rect(12, 12, 12, 12),
+              PlaceBadge(gfx::Rect(4, 4, 16, 16), gfx::Rect(0, 0, 24, 24)));
+  }
+  {
+    SCOPED_TRACE("the rail's title row, its glyph a size up");
+    EXPECT_EQ(gfx::Rect(27, 18, 12, 12),
+              PlaceBadge(gfx::Rect(13, 4, 22, 22), gfx::Rect(0, 0, 48, 30)));
+  }
+  {
+    SCOPED_TRACE("a glyph against the host's corner");
+    EXPECT_EQ(gfx::Rect(36, 18, 12, 12),
+              PlaceBadge(gfx::Rect(30, 10, 18, 20), gfx::Rect(0, 0, 48, 30)));
+  }
+}
+
+// sessions S32: the mark is drawn, not named, and takes no event: its host's
+// description says it once, and its host keeps the click, the hover and the
+// tooltip under it.
+TEST(IsolationMarkViewTest, TheMarkIsDrawnNotNamed) {
+  views::View host;
+  EXPECT_FALSE(FindShownIsolationMark(&host));
+  auto* const mark = host.AddChildView(std::make_unique<IsolationMarkView>(
+      IsolationMarkView::Form::kGlyph, ui::kColorLabelForeground,
+      ui::kColorFrameActive));
+  EXPECT_TRUE(mark->GetViewAccessibility().GetIsIgnored());
+  EXPECT_FALSE(mark->GetCanProcessEventsWithinSubtree());
+  EXPECT_EQ(gfx::Size(IsolationMarkView::kGlyphSize,
+                      IsolationMarkView::kGlyphSize),
+            mark->GetPreferredSize());
+  mark->SetForm(IsolationMarkView::Form::kBadge);
+  EXPECT_EQ(gfx::Size(IsolationMarkView::kBadgeSize,
+                      IsolationMarkView::kBadgeSize),
+            mark->GetPreferredSize());
+  EXPECT_EQ(mark, FindShownIsolationMark(&host));
+  mark->SetVisible(false);
+  EXPECT_FALSE(FindShownIsolationMark(&host)) << "a hidden mark shows nothing";
+}
+
+}  // namespace
+}  // namespace stedding
