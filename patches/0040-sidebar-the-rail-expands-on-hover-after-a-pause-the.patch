   }
@@ -1473,6 +1496,16 @@ void VerticalTabStripRegionView::ResetExpandOnHoverTimers() {
   }
 }
 
+base::TimeDelta VerticalTabStripRegionView::SteddingHoverDelay() const {
+  if (!base::FeatureList::IsEnabled(stedding::kArcStyleWindow) ||
+      !browser_view() || !browser_view()->browser()) {
+    return base::TimeDelta();
+  }
+  return base::Milliseconds(
+      std::max(0, browser_view()->browser()->GetProfile()->GetPrefs()->GetInteger(
+                      stedding::prefs::kSidebarHoverDelayMs)));
+}
