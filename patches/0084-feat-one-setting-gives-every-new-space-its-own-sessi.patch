+  // sessions S35 (BACKLOG S-274): turned on, the setting gives the Spaces
+  // made from now on their own session, and asks whether the Spaces that
+  // share one now should have theirs too, saying what that reloads (S10).
+  // Turned off, it changes no Space: each keeps its own switch.
+  protected async onSpacesOwnSessionChange_(e: Event) {
+    if (!(e.target as SettingsToggleButtonElement).checked) {
+      return;
+    }
+    const shared =
+        this.spaces_.filter(space => space.canIsolate && !space.isolated);
+    if (shared.length === 0) {
+      return;
+    }
+    let pages = 0;
+    for (const space of shared) {
+      pages += Number(await sendWithPromise(
+                   'steddingCountSpacePages', space.id)) ||
+          0;
+    }
+    this.pendingOwnSession_ = {ids: shared.map(space => space.id), pages};
+    await this.updateComplete;
+    this.ownSessionDialog_().showModal();
+  }
+
+  private ownSessionDialog_(): CrDialogElement {
+    return this.shadowRoot.querySelector<CrDialogElement>(
+        '#ownSessionDialog')!;
+  }
+
+  protected ownSessionBody_(): string {
+    const pending = this.pendingOwnSession_;
+    if (!pending) {
+      return '';
+    }
+    const spaces = pending.ids.length === 1 ?
+        loadTimeData.getString('steddingOwnSessionOneSpace') :
+        loadTimeData.getStringF(
+            'steddingOwnSessionSpaces', String(pending.ids.length));
+    if (pending.pages === 0) {
+      return spaces;
+    }
+    const pages = pending.pages === 1 ?
+        loadTimeData.getString('steddingOwnSessionOnePage') :
+        loadTimeData.getStringF(
+            'steddingOwnSessionPages', String(pending.pages));
+    return `${spaces} ${pages}`;
+  }
+
+  protected onOwnSessionConfirmClick_() {
+    const pending = this.pendingOwnSession_;
+    this.ownSessionDialog_().close();
+    for (const id of pending?.ids || []) {
+      chrome.send('steddingSetSpaceIsolated', [id, true]);
+    }
+  }
+
+  protected onOwnSessionCancelClick_() {
+    this.ownSessionDialog_().cancel();
+  }
+
+  protected onOwnSessionDialogClose_() {
+    this.pendingOwnSession_ = null;
+  }
