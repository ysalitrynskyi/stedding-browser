+tabs::TabInterface* ParentBackReturnsTo(content::WebContents* contents) {
+  tabs::TabInterface* const tab =
+      contents ? tabs::TabInterface::MaybeGetFromContents(contents) : nullptr;
+  BrowserWindowInterface* const window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  const TabStripModel* const strip =
+      window ? window->GetTabStripModel() : nullptr;
+  if (!strip || !NestsChildren(*strip) || tab->IsSplit() || IsPin(tab) ||
+      contents->GetController().CanGoBack()) {
+    return nullptr;
+  }
+  return ParentInStrip(*strip, contents);
+}
+
+bool CloseBackToParent(content::WebContents* contents) {
+  tabs::TabInterface* const parent = ParentBackReturnsTo(contents);
+  if (!parent) {
+    return false;
+  }
+  TabStripModel* const strip =
+      parent->GetBrowserWindowInterface()->GetTabStripModel();
+  strip->ActivateTabAt(strip->GetIndexOfTab(parent));
+  strip->CloseWebContentsAt(strip->GetIndexOfWebContents(contents),
+                            TabCloseTypes::CLOSE_USER_GESTURE |
+                                TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  return true;
+}
+
+bool ClosingOthersKeeps(const TabStripModel& model,
+                        const tabs::TabInterface* invoked,
+                        const tabs::TabInterface* tab) {
+  if (TabParentToken(tab->GetContents()).empty() || !NestsChildren(model)) {
+    return false;
+  }
+  if (DescendsFrom(model, tab, invoked)) {
+    return true;
+  }
+  if (!model.IsTabSelected(model.GetIndexOfTab(invoked))) {
+    return false;
+  }
+  for (int i = 0; i < model.count(); ++i) {
+    if (model.IsTabSelected(i) &&
+        DescendsFrom(model, tab, model.GetTabAtIndex(i))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool HasChildTabs(const TabStripModel& model, const tabs::TabInterface* tab) {
+  const std::string token = tab ? TabToken(tab->GetContents()) : std::string();
+  if (token.empty() || IsPin(tab)) {
+    return false;
+  }
+  for (int i = 0; i < model.count(); ++i) {
+    if (TabParentToken(model.GetWebContentsAt(i)) == token) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ChildrenFolded(const content::WebContents* contents) {
+  const TabParentData* const data =
+      contents ? TabParentData::FromWebContents(contents) : nullptr;
+  return data && data->children_folded();
+}
+
+void SetChildrenFolded(tabs::TabInterface* parent, bool folded) {
+  content::WebContents* const contents =
+      parent ? parent->GetContents() : nullptr;
+  if (!contents || ChildrenFolded(contents) == folded) {
+    return;
+  }
+  DataFor(contents).set_children_folded(folded);
+  Write(parent->GetBrowserWindowInterface(), contents,
+        kSessionChildrenFoldedKey, folded ? "1" : std::string());
+  ParentsChangedCallbacks().Notify();
+}
+
+bool FoldedAway(
+    const TabStripModel& model,
+    const tabs::TabInterface* tab,
+    base::FunctionRef<bool(const tabs::TabInterface*)> parent_shown) {
+  if (!tab || TabParentToken(tab->GetContents()).empty() ||
+      !NestsChildren(model) || IsPin(tab)) {
+    return false;
+  }
+  const tabs::TabInterface* const active = model.GetActiveTab();
+  if (tab == active ||
+      (active && tab->IsSplit() && tab->GetSplit() == active->GetSplit())) {
+    return false;
