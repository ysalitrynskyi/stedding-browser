+
+// sessions S11
+TEST_F(SpaceWindowTest, WindowOpenFromIsolatedTabKeepsThePartition) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceIsolated(work->id(), true);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const opener = OpenTab();
+  const auto jar = PartitionOf(opener);
+  ASSERT_TRUE(IsSpaceStoragePartition(jar));
+  NavigateParams params(browser(), GURL("https://example.com/opened"),
