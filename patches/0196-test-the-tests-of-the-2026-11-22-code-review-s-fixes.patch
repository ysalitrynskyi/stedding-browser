+class SessionQuestionW2B28Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  spaces::SpaceRegistry& registry() {
+    return *spaces::SpaceRegistryFactory::GetForProfile(browser()->GetProfile());
+  }
+
+  // Space "Work" with a session of its own, which no row of the sessions list
+  // names yet, so it goes by the Space's name (sessions S37), and a page open
+  // in it, so a change of session asks first (S40).
+  spaces::SpaceId WorkWithItsOwnSession() {
+    const spaces::SpaceId work = model()->AddSpace("Work", SK_ColorBLUE)->id();
+    model()->SetSpaceIsolated(work, true);
+    EXPECT_TRUE(model()->SetActiveSpace(work));
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL("jar.test", "/title1.html"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    EXPECT_EQ(1, model()->CountPagesAJarChangeReloads(work));
+    return work;
+  }
+
+  // The name of the session Space `id` is in now.
+  std::string SessionNameOf(const spaces::SpaceId& id) {
+    const std::optional<spaces::SessionEntry> session =
+        registry().FindSession(model()->SessionOf(id));
+    return session ? session->name : std::string();
+  }
+
+  // Space menu › Session › New Session… for `id`, with `typed` in the name
+  // field when given, then Create. Returns the question that follows, open.
+  views::Widget* NewSessionQuestion(const spaces::SpaceId& id,
+                                    std::optional<std::u16string> typed) {
+    views::Widget* const asked = DialogShownDuringW2B28(
+        base::BindLambdaForTesting(
+            [&]() { spaces::NewSessionInDialog(browser(), id); }));
+    if (!asked) {
+      ADD_FAILURE() << "no dialog asked for the session's name";
+      return nullptr;
+    }
+    views::Textfield* const field = TextfieldUnderW2B28(asked->GetRootView());
+    if (!field) {
+      ADD_FAILURE() << "the dialog has no name field";
+      return nullptr;
+    }
+    // The field starts with the Space's name (sessions S39).
+    EXPECT_EQ(model()->DisplayName(id), std::u16string(field->GetText()));
+    if (typed) {
+      field->SetText(*typed);
+    }
+    return DialogShownDuringW2B28(base::BindLambdaForTesting(
+        [&]() { AnswerW2B28(asked, /*accept=*/true); }));
+  }
+};
+
+// P37-1a; sessions S37, S40: New Session… with the name the field starts
+// with. The Space's own session already goes by "Work", so the new one is
+// "Work 2", and the question names "Work 2". It named "Work", the session
+// the Space was leaving.
+IN_PROC_BROWSER_TEST_F(SessionQuestionW2B28Test,
+                       TheQuestionNamesTheNameTheNewSessionGets) {
+  const spaces::SpaceId work = WorkWithItsOwnSession();
+  views::Widget* const question = NewSessionQuestion(work, std::nullopt);
+  ASSERT_TRUE(question) << "the move did not ask";
+  EXPECT_EQ(u"Move “Work” to the session “Work 2”?",
+            TitleOfW2B28(question));
+  AnswerW2B28(question, /*accept=*/true);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return SessionNameOf(work) == "Work 2";
+  })) << "the Space is in the session \"" << SessionNameOf(work) << "\"";
+}
+
+// P37-1a; sessions S37, S39: a name of spaces alone is no name. The Space's
+// name is taken, as Edit Space takes it, and the question names what the
+// session will be called. The question said to the session “” and the
+// session was called "Session".
+IN_PROC_BROWSER_TEST_F(SessionQuestionW2B28Test,
+                       ABlankNewSessionNameTakesTheSpacesName) {
+  const spaces::SpaceId work = WorkWithItsOwnSession();
+  views::Widget* const question =
+      NewSessionQuestion(work, std::u16string(u"   "));
+  ASSERT_TRUE(question) << "the move did not ask";
+  EXPECT_EQ(u"Move “Work” to the session “Work 2”?",
+            TitleOfW2B28(question));
+  AnswerW2B28(question, /*accept=*/true);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return SessionNameOf(work) == "Work 2";
+  })) << "the Space is in the session \"" << SessionNameOf(work) << "\"";
+}
