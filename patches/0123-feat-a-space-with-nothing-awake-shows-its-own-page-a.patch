+// tabs R66 (BACKLOG S-396, GitHub issue 72): Cmd-W on a Space's only row, a
+// pin, leaves nothing awake there, and the window shows the Space with no
+// page: a stand-in the sidebar does not list, on chrome://stedding-space,
+// which names the Space and follows its name. Showing a row closes it; an
+// address it goes to makes it an ordinary row. The session keeps none.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ASpaceWithNothingAwakeShowsItsPage) {
+  const spaces::SpaceId solo = model().AddSpace("Solo", SK_ColorGREEN)->id();
+  tabs::TabInterface* const pin = AddBlankTab();
+  model().MoveTabsToSpace({pin}, solo);
+  ASSERT_TRUE(model().SetActiveSpace(solo));
+  model().SetSpacePinned(pin, true);
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+  ASSERT_EQ(pin, tabs().GetActiveTab());
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  const int count = tabs().count();
+
+  const auto sleep_the_pin = [&]() -> tabs::TabInterface* {
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);  // Cmd-W
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return pin->GetContents()->WasDiscarded(); }))
+        << "the pin did not sleep";
+    return tabs().GetActiveTab();
+  };
+
+  {
+    SCOPED_TRACE("Cmd-W on the Space's only row");
+    tabs::TabInterface* const page = sleep_the_pin();
+    ASSERT_TRUE(page);
+    ASSERT_NE(pin, page);
+    EXPECT_TRUE(stedding::IsEmptySpaceStandIn(page));
+    EXPECT_EQ(count + 1, tabs().count());
+    EXPECT_EQ(solo, model().SpaceForTab(page));
+    EXPECT_TRUE(tabs().IsTabHidden(tabs().GetIndexOfTab(page)))
+        << "the sidebar lists the Space's page as a row";
+    content::WebContents* const contents = page->GetContents();
+    EXPECT_EQ(GURL(stedding::kEmptySpaceURL), contents->GetVisibleURL());
+    ASSERT_TRUE(content::WaitForLoadStop(contents));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(contents,
+                             "document.getElementById('title').textContent")
+                 .ExtractString() == "Nothing open in Solo";
+    })) << "the page does not name the Space";
+    model().SetSpaceName(solo, "Quiet");
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return content::EvalJs(contents,
+                             "document.getElementById('title').textContent")
+                 .ExtractString() == "Nothing open in Quiet";
+    })) << "the page did not follow the Space's new name";
+    EXPECT_FALSE(ShouldTrackURLForRestore(GURL(stedding::kEmptySpaceURL)))
+        << "the session would keep the Space's page";
+  }
+
+  {
+    SCOPED_TRACE("a click on the pin closes the page");
+    content::WebContentsDestroyedWatcher gone(tabs().GetActiveWebContents());
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+    gone.Wait();
+    EXPECT_EQ(pin, tabs().GetActiveTab());
+    EXPECT_EQ(count, tabs().count()) << "a row was left behind";
+  }
+
+  {
+    SCOPED_TRACE("an address typed on the page makes it a row");
+    tabs::TabInterface* const page = sleep_the_pin();
+    ASSERT_TRUE(stedding::IsEmptySpaceStandIn(page));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                             GURL(url::kAboutBlankURL)));
+    EXPECT_EQ(page, tabs().GetActiveTab());
+    EXPECT_FALSE(stedding::IsEmptySpaceStandIn(page));
+    EXPECT_FALSE(tabs().IsTabHidden(tabs().GetIndexOfTab(page)))
+        << "the tab the user went somewhere in has no row";
+    EXPECT_EQ(count + 1, tabs().count());
+  }
+}
