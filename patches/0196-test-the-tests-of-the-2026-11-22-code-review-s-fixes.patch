+// P38-1d; tabs R14 (BACKLOG S-149, S-438): a rename ended by the sidebar
+// taking the rail's form gives the keys back to the page, as Enter, Escape
+// and a click away do. The field was hidden with the focus in it, which then
+// went to the next view in the window's order, and the next key typed went
+// there.
+IN_PROC_BROWSER_TEST_F(SidebarSpaceW2B28Test,
+                       ARenameTheRailEndsLeavesThePageFocused) {
+  ASSERT_TRUE(model());
+  const spaces::SpaceId home = model()->active_id();
+  model()->AddSpace("Work", SK_ColorBLUE);
+  // The rail itself, not the sidebar a hover opens over the page: the Mac
+  // asks the real pointer, wherever it is.
+  controller()->SetExpandOnHoverEnabled(false);
+  // With no full keyboard access, the Mac's default, only the views that
+  // always take focus can take it.
+  widget()->GetFocusManager()->SetKeyboardAccessible(false);
+  views::View* const page = browser_view()->GetActiveContentsWebView();
+  ASSERT_TRUE(page);
+
+  ASSERT_NO_FATAL_FAILURE(RenameFromChip(home));
+  views::test::RunScheduledLayout(widget());
+  views::Textfield* const field = views::AsViewClass<views::Textfield>(
+      widget()->GetFocusManager()->GetFocusedView());
+  ASSERT_TRUE(field && field->IsDrawn()) << "no rename began";
+  field->SetText(u"Desk");
+
+  ASSERT_NO_FATAL_FAILURE(SetRail(true));
+  EXPECT_FALSE(field->IsDrawn()) << "the rename stayed open in the rail";
+  const views::View* const focused =
+      widget()->GetFocusManager()->GetFocusedView();
+  EXPECT_EQ(page, focused) << "the keys went to "
+                           << (focused ? focused->GetClassName() : "nothing");
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    const spaces::Space* const space = model()->GetSpace(home);
+    return space && space->name() == "Desk";
+  })) << "the collapse dropped what was typed";
+}
+
+// P37-1b: the rail's Rename Space names the Space in its title as every
+// other question about a Space does (NameInSentence, isolation_mark.h): no
+// bidi override, which turned the rest of the title round, closing quote
+// included, and no line break. A name sidebar sync or an import wrote may
+// hold either.
+IN_PROC_BROWSER_TEST_F(SidebarSpaceW2B28Test,
+                       TheRailsRenameTitleNamesTheSpaceCleaned) {
+  ASSERT_TRUE(model());
+  const spaces::SpaceId home = model()->active_id();
+  model()->AddSpace("Work", SK_ColorBLUE);
+  const std::u16string raw = u"De\u202Esk\n";
+  model()->SetSpaceName(home, base::UTF16ToUTF8(raw));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return model()->DisplayName(home) == raw; }))
+      << "the Space did not take the name as written";
+  controller()->SetExpandOnHoverEnabled(false);
+  ASSERT_NO_FATAL_FAILURE(SetRail(true));
+  // The row in the rail's form, as it is by the time a pointer can reach a
+  // chip: the collapse's last frame leaves the layout pending. 120 DIP is
+  // room for a name; the rail is about a chip and a half wide.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(widget());
+    spaces::SpaceSwitcherView* const switcher = Switcher();
+    return switcher && switcher->width() < 120;
+  })) << "the switcher never took the rail's form";
+
+  views::Widget* const dialog = DialogShownDuringW2B28(
+      base::BindLambdaForTesting([&]() { RenameFromChip(home); }));
+  ASSERT_TRUE(dialog) << "no rename dialog over the rail";
+  const std::u16string title = TitleOfW2B28(dialog);
+  EXPECT_EQ(std::u16string::npos, title.find(u'\u202E')) << title;
+  EXPECT_EQ(std::u16string::npos, title.find(u'\n')) << title;
+  EXPECT_EQ(u"Rename “Desk”", title);
+  AnswerW2B28(dialog, /*accept=*/false);
+  EXPECT_EQ(raw, model()->DisplayName(home)) << "Cancel renamed the Space";
