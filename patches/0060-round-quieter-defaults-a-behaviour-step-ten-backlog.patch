+      })())"));
+  EXPECT_EQ("archiveHours=0,closedForm=0,sleepMinutes=60",
+            content::EvalJs(page, kCheckedPills));
+}
+
+// welcome W12: a click writes its preference at once, without Next or
+// Finish, so the archiver, the sidebar and the Space model act on it now. The
+// clicked pills are the checked ones, and the last one keeps the focus.
+IN_PROC_BROWSER_TEST_F(WelcomeFlowTest, EachBehaviourChoiceIsWrittenAtOnce) {
+  PrefService* const pref_service = browser()->GetProfile()->GetPrefs();
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  EXPECT_EQ("0,0,0", content::EvalJs(page, kBehaviourOnceSettled));
+  ASSERT_EQ("", GoTo(page, ".choices"));
+  ASSERT_TRUE(content::ExecJs(page, R"(
+      for (const [name, value] of
+           [['archiveHours', 24], ['closedForm', 1], ['sleepMinutes', 15]]) {
+        document.querySelector(
+            `.pill[data-name="${name}"][data-value="${value}"]`).click();
+      })"));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return pref_service->GetInteger(stedding::prefs::kArchiveIdleHours) ==
+               24 &&
+           pref_service->GetInteger(stedding::prefs::kSidebarClosedForm) ==
+               stedding::prefs::kSidebarClosedHidden &&
+           pref_service->GetInteger(stedding::prefs::kSpaceSleepMinutes) == 15;
+  }));
+  EXPECT_EQ("archiveHours=24,closedForm=1,sleepMinutes=15",
+            content::EvalJs(page, kCheckedPills));
+  EXPECT_EQ("sleepMinutes=15", content::EvalJs(page, R"(
+      document.activeElement.dataset.name + '=' +
+          document.activeElement.dataset.value)"));
+  EXPECT_EQ("Step 4 of 6",
+            content::EvalJs(
+                page, "document.querySelector('footer .status').textContent"));
+  EXPECT_FALSE(pref_service->GetBoolean(stedding::prefs::kWelcomeShown));
+}
+
+// welcome W12: an answer that comes late (the Arc check, the importer's list,
+// the default-browser check, an import's progress) redraws the whole flow,
+// and the control that had the focus keeps it. On the Mac,
+// EachBehaviourChoiceIsWrittenAtOnce found the focus on the page in four
+// runs of five (2026-10-12).
+IN_PROC_BROWSER_TEST_F(WelcomeFlowTest, ALateAnswerKeepsTheFocus) {
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  ASSERT_EQ("", GoTo(page, ".choices"));
+  EXPECT_EQ("closedForm=1", content::EvalJs(page, R"(
+      (() => {
+        document.querySelector(
+            '.pill[data-name="closedForm"][data-value="1"]').focus();
+        cr.webUIListenerCallback('default-browser-changed', 'not-default');
+        const focused = document.activeElement;
+        return focused.dataset.name + '=' + focused.dataset.value;
+      })())"));
+}
+
+// welcome W2 (S-77) in two regions: France's list of eight engines and the
+// United States' list of five.
+class WelcomeEnginesTest : public InProcessBrowserTest,
+                           public testing::WithParamInterface<std::string> {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    InProcessBrowserTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(switches::kSearchEngineChoiceCountry,
+                                    GetParam());
+  }
+};
+
+// welcome W2 (S-77): every engine on step 1 shows its own mark, drawn by the
+// page. Each tile's mark is one Stedding knows (none falls back to an
+// initial), no two tiles share one, and the step holds no image: the globe
+// Chromium drew for every engine is gone.
+IN_PROC_BROWSER_TEST_P(WelcomeEnginesTest, EachEngineShowsItsOwnMark) {
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page,
+                           "document.querySelectorAll('main .tile').length")
+               .ExtractInt() > 0;
+  }));
+  const std::string marks = content::EvalJs(page, R"(
+      [...document.querySelectorAll('main .tile')]
+          .map(tile => tile.querySelector('.engine-mark')?.dataset.mark ??
+                       'none')
+          .join(','))")
+                                .ExtractString();
+  const std::vector<std::string> list = base::SplitString(
+      marks, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  const std::set<std::string> distinct(list.begin(), list.end());
+  EXPECT_GE(list.size(), 5U) << marks;
+  EXPECT_EQ(list.size(), distinct.size()) << marks;
+  EXPECT_FALSE(distinct.contains("initial")) << marks;
+  EXPECT_FALSE(distinct.contains("none")) << marks;
+  EXPECT_FALSE(distinct.contains("")) << marks;
+  EXPECT_EQ(0, content::EvalJs(page,
+                               "document.querySelectorAll('main img').length"));
+}
+
+INSTANTIATE_TEST_SUITE_P(, WelcomeEnginesTest, testing::Values("FR", "US"));
+
 }  // namespace
