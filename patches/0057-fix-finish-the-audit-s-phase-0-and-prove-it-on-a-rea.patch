+// menus M8: with four Spaces, "Move to Space" names the three others and
+// "Always Open <site> in" all four; every id past them is disabled, and an
+// essential takes neither submenu.
+TEST_F(TabMenuVerbsTest, MoveAndRouteEntriesAreRangeChecked) {
+  tabs::TabInterface* const tab = OpenTab(GURL("https://docs.example.com/a"));
+  HaveSpaces(4);
+  ASSERT_EQ(4u, space_model().size());
+
+  EXPECT_TRUE(Enabled(tab, TabStripModel::CommandSteddingMoveToSpaceMenu));
+  EXPECT_TRUE(Enabled(tab, TabStripModel::CommandSteddingRouteToSpaceMenu));
+  for (int id = kMoveFirst; id <= kMoveLast; ++id) {
+    EXPECT_EQ(id - kMoveFirst < 3, Enabled(tab, id))
+        << "Move to Space entry " << id - kMoveFirst;
+  }
+  for (int id = kRouteFirst; id <= kRouteLast; ++id) {
+    EXPECT_EQ(id - kRouteFirst < 4, Enabled(tab, id))
+        << "Always Open entry " << id - kRouteFirst;
+  }
+
+  tabs().SetTabPinned(IndexOf(tab), true);
+  EXPECT_FALSE(Enabled(tab, TabStripModel::CommandSteddingMoveToSpaceMenu));
+  EXPECT_FALSE(Enabled(tab, TabStripModel::CommandSteddingRouteToSpaceMenu));
+  for (int id = kMoveFirst; id <= kMoveLast; ++id) {
+    EXPECT_FALSE(Enabled(tab, id));
+  }
+  for (int id = kRouteFirst; id <= kRouteLast; ++id) {
+    EXPECT_FALSE(Enabled(tab, id));
+  }
+}
+
+// menus M1, M8: the third "Move to Space" entry moves the tab to the third
+// other Space and the window follows it. An entry past the Spaces the window
+// has does nothing; it used to reach NOTREACHED from the horizontal strip.
+TEST_F(TabMenuVerbsTest, TheThirdMoveEntryMovesTheTabAndTheWindowFollows) {
+  tabs::TabInterface* const tab = OpenTab();
+  HaveSpaces(4);
+  // The active Space is the first; the others are the second to the fourth.
+  const spaces::SpaceId third_other = space_model().spaces()[3]->id();
+
+  Execute(tab, kMoveFirst + 2);
+  EXPECT_EQ(third_other, space_model().SpaceForTab(tab));
+  EXPECT_EQ(third_other, space_model().active_id());
+
+  Execute(tab, kMoveFirst + 5);
+  Execute(tab, kMoveLast);
+  EXPECT_EQ(third_other, space_model().SpaceForTab(tab));
+  EXPECT_EQ(third_other, space_model().active_id());
+}
+
+// routing D5, menus M8: the third "Always Open <site> in" entry writes a site
+// rule for the third Space and routes the tab there now.
+TEST_F(TabMenuVerbsTest, TheThirdRouteEntryWritesTheRuleAndRoutesTheTab) {
+  const GURL url("https://docs.example.com/a");
+  tabs::TabInterface* const tab = OpenTab(url);
+  HaveSpaces(4);
+  const spaces::SpaceId third = space_model().spaces()[2]->id();
+
+  Execute(tab, kRouteFirst + 2);
+  // The switch that follows a route waits a turn (SpaceModel::RouteTab).
+  base::RunLoop().RunUntilIdle();
+
+  const std::vector<spaces::Route> routes =
+      spaces::ReadRoutes(profile()->GetPrefs());
+  ASSERT_EQ(1u, routes.size());
+  EXPECT_EQ(spaces::SiteRouteFor(url, third.ToString()), routes[0]);
+  EXPECT_EQ(third, space_model().SpaceForTab(tab));
+  EXPECT_EQ(third, space_model().active_id());
+
+  Execute(tab, kRouteFirst + 4);
+  Execute(tab, kRouteLast);
+  EXPECT_EQ(1u, spaces::ReadRoutes(profile()->GetPrefs()).size());
+}
