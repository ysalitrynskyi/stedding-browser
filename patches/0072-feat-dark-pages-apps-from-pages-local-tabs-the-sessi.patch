+namespace spaces {
+
+const gfx::VectorIcon& IsolationMarkIcon() {
+  // The cookie of Chromium's site-data rows (page_info_main_view.cc), in the
+  // same generation as the icons around it.
+  return features::IsRoundedIconsEnabled()
+             ? vector_icons::kCookieIcon
+             : vector_icons::kCookieChromeRefreshOldIcon;
+}
+
+std::u16string IsolationMarkName() {
+  return l10n_util::GetStringUTF16(IDS_STEDDING_ISOLATION_MARK_NAME);
+}
+
+std::u16string NameWithIsolationMark(const std::u16string& name) {
+  return l10n_util::GetStringFUTF16(IDS_STEDDING_ISOLATION_MARK_AFTER_NAME,
+                                    name);
+}
+
+std::u16string IsolationMarkDescription() {
+  return l10n_util::GetStringUTF16(IDS_STEDDING_ISOLATION_MARK_DESCRIPTION);
+}
+
+std::u16string IsolationMarkEssentialsNote() {
+  return l10n_util::GetStringUTF16(IDS_STEDDING_ISOLATION_MARK_ESSENTIALS);
+}
+
+std::u16string NameInSentence(std::u16string_view name) {
+  std::u16string text;
+  text.reserve(name.size());
+  for (const char16_t c : name) {
+    // The embeddings and overrides (U+202A to U+202E) and the isolates
+    // (U+2066 to U+2069).
+    if ((c >= 0x202A && c <= 0x202E) || (c >= 0x2066 && c <= 0x2069)) {
+      continue;
+    }
+    // C0 and C1 controls, a line break among them, and the line and
+    // paragraph separators.
+    if (c < 0x20 || (c >= 0x7F && c < 0xA0) || c == 0x2028 || c == 0x2029) {
+      text.push_back(u' ');
+      continue;
+    }
+    text.push_back(c);
+  }
+  return base::CollapseWhitespace(text,
+                                  /*trim_sequences_with_line_breaks=*/false);
+}
+
+}  // namespace spaces
