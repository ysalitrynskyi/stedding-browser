+
+// docs/features/sidebar-file.md Sf12, Sf26, Sf29, Sf35, Sf37: what each
+// install keeps in its profile, never in the shared folder: the merged
+// sidebar in the file's own format, what this computer alone knows about
+// it, the journal for Undo and the backups taken before a join or a held
+// batch.
+namespace spaces::sidebar_sync {
+
+// The folder in the profile that holds the ledger, the journal and the
+// backups. No name in it matches "sidebar-*.json" or a peer's name.
+inline constexpr char kLedgerFolderName[] = "Stedding Sidebar Sync";
+
+// Sf29: the last writes of this install's own file, to tell an echo a sync
+// tool brought back from a copy of the profile writing under the same id.
+inline constexpr size_t kRecentWrites = 16;
+// Sf35.
+inline constexpr size_t kJournalEntries = 10;
+inline constexpr size_t kBackupsKept = 5;
+
+struct WriteRecord {
+  std::string nonce;
+  int64_t seq = 0;
+  int64_t written_ms = 0;
+};
+
+enum class OwnFileKind {
+  // What this install wrote last, or nothing at all.
+  kOurs,
+  // An older copy brought back (a restore, a slow upload): ignored and
+  // written over at the next write.
+  kEcho,
+  // Another install writing under this id (a copied profile): this install
+  // takes a new id and leaves that file alone.
+  kCopy,
+};
+OwnFileKind ClassifyOwnFile(const FileMeta& found,
+                            const std::vector<WriteRecord>& recent,
+                            int64_t our_seq);
+
+// What this install last read of a peer's file.
+struct PeerStat {
+  PeerStat();
+  PeerStat(const PeerStat& other);
+  PeerStat& operator=(const PeerStat& other);
+  ~PeerStat();
+
+  int64_t mtime_ms = 0;
+  int64_t size = 0;
+  int64_t seq = 0;
+  int64_t written_ms = 0;
+  int64_t read_ms = 0;
+  std::string device;
+};
+
+// Sf35: one batch from another computer, with what it replaced.
+struct JournalEntry {
+  JournalEntry();
+  JournalEntry(const JournalEntry& other);
+  JournalEntry& operator=(const JournalEntry& other);
+  ~JournalEntry();
+
+  std::string id;
+  int64_t applied_ms = 0;
+  std::string device;
+  size_t added = 0;
+  size_t removed = 0;
+  size_t changed = 0;
+  // Sf15: one of the changes replaced an edit made here since this install
+  // last read that computer.
+  bool replaced_local_edit = false;
+  // The records and lists as they were before the batch; `absent` the ids
+  // the batch added.
+  State before;
+  std::vector<std::string> absent;
+};
+
+struct Ledger {
+  Ledger();
+  Ledger(const Ledger& other);
+  Ledger(Ledger&& other);
+  Ledger& operator=(const Ledger& other);
+  Ledger& operator=(Ledger&& other);
+  ~Ledger();
+
+  State state;
+  int64_t hlc = 0;
+  int64_t joined_ms = 0;
+  int64_t seq = 0;
+  std::vector<WriteRecord> recent;
+  // Sf26: when each tombstone arrived here.
+  std::map<std::string, int64_t> tombstone_received;
+  // By install id.
+  std::map<std::string, PeerStat> peers;
+  // Sf21: the tabs sync put here that have not been opened here.
+  std::set<std::string> inserted_unopened;
+  // Sf17, Sf14: items another computer added that wait for a window.
+  std::set<std::string> pending_adds;
+  // Sf24: a Space whose own session this computer keeps as it is ("Not on
+  // this computer"), with the remote value that was answered.
+  std::map<std::string, std::string> isolation_kept;
+  // Sf28: conflict copies the user dismissed.
+  std::set<std::string> dismissed_files;
+  // Sf31: this install's own file is behind the ledger.
+  bool folder_behind = false;
+  std::vector<JournalEntry> journal;
+
+  // Records `write` and keeps the last kRecentWrites.
+  void NoteWrite(const WriteRecord& write);
+  // Sf35: the last kJournalEntries batches of the last 30 days.
+  void TrimJournal(int64_t now_ms);
+  // Sf26: notes when each tombstone first arrived.
+  void NoteTombstones(int64_t now_ms);
+};
+
+base::DictValue LedgerToValue(const Ledger& ledger);
+std::optional<Ledger> LedgerFromValue(const base::DictValue& value);
+
+// Blocking. `profile_dir`/kLedgerFolderName/ledger.json.
+base::FilePath LedgerPath(const base::FilePath& profile_dir);
+std::optional<Ledger> ReadLedger(const base::FilePath& profile_dir);
+bool WriteLedgerJson(const base::FilePath& profile_dir,
+                     const std::string& json);
+// Sf37: forgets the ledger, the journal and the backups.
+void DeleteLedger(const base::FilePath& profile_dir);
+
+// Sf9, Sf22, Sf35: writes `json` (an Export all Spaces file) as
+// backups/before-sync-<UTC>.json and keeps the newest kBackupsKept. Blocking.
+base::FilePath WriteBackup(const base::FilePath& profile_dir,
+                           const std::string& json,
+                           base::Time now);
+// The backups, newest first. Blocking.
+std::vector<base::FilePath> ListBackups(const base::FilePath& profile_dir);
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_LEDGER_H_
