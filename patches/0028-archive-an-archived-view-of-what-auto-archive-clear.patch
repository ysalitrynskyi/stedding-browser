index 0000000000000..9ad979b0691ca
--- /dev/null
+++ b/chrome/browser/ui/archive/archive_mark.cc
@@ -0,0 +1,85 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/archive/archive_mark.h"
+
+#include <string_view>
+
+#include "base/no_destructor.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace stedding {
+
+namespace {
+
+class ArchiveMark : public content::WebContentsUserData<ArchiveMark> {
+ public:
+  ~ArchiveMark() override = default;
+  ArchiveReason reason() const { return reason_; }
+  void set_reason(ArchiveReason reason) { reason_ = reason; }
+
+ private:
+  friend class content::WebContentsUserData<ArchiveMark>;
+  ArchiveMark(content::WebContents* contents, ArchiveReason reason)
+      : content::WebContentsUserData<ArchiveMark>(*contents), reason_(reason) {}
+
+  ArchiveReason reason_;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(ArchiveMark);
+
+ArchiveMarkObserver& ObserverForTesting() {
+  static base::NoDestructor<ArchiveMarkObserver> observer;
+  return *observer;
+}
+
+}  // namespace
+
+const char* ArchiveReasonName(ArchiveReason reason) {
+  switch (reason) {
+    case ArchiveReason::kAuto:
+      return "auto";
+    case ArchiveReason::kClear:
+      return "clear";
+  }
+  return "auto";
+}
+
+std::optional<ArchiveReason> ArchiveReasonFromName(std::string_view name) {
+  if (name == "auto") {
+    return ArchiveReason::kAuto;
+  }
+  if (name == "clear") {
+    return ArchiveReason::kClear;
+  }
+  return std::nullopt;
+}
+
+void MarkForArchive(content::WebContents* contents, ArchiveReason reason) {
+  if (!contents) {
+    return;
+  }
+  if (ArchiveMark* const mark = ArchiveMark::FromWebContents(contents)) {
+    mark->set_reason(reason);
+  } else {
+    ArchiveMark::CreateForWebContents(contents, reason);
+  }
+  if (ObserverForTesting()) {
+    ObserverForTesting().Run(contents, reason);
+  }
+}
+
+std::optional<ArchiveReason> ArchiveMarkOf(content::WebContents* contents) {
+  const ArchiveMark* const mark =
+      contents ? ArchiveMark::FromWebContents(contents) : nullptr;
+  return mark ? std::optional<ArchiveReason>(mark->reason()) : std::nullopt;
+}
+
+void SetArchiveMarkObserverForTesting(ArchiveMarkObserver observer) {
+  ObserverForTesting() = std::move(observer);
+}
+
+}  // namespace stedding
