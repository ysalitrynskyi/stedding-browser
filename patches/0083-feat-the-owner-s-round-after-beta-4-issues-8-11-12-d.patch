+// folders F39 (the owner, 2026-10-22): a folder's header dragged onto the
+// middle of another folder's header puts the folder into that one, at its
+// end, whole: its tabs in it, in their order. While the pointer is on the
+// header, that header is lit and no bar shows; the light goes with the
+// release. The new nesting is what a restart reads: each tab's saved folder
+// path names the folder it went into, then its own (folders F5, F17). A
+// folder's header could not be dragged into another folder.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       AFolderDraggedOntoAFoldersHeaderGoesIntoIt) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  // "Continue where you left off", as ChildTabsTest sets it for what a
+  // restart reads.
+  SessionStartupPref::SetStartupPref(
+      browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  CloseDownToOne();
+  stedding::test::KeepAboveOtherWindows(widget());
+  tabs::TabInterface* const a = OpenLoaded("a.test");
+  tabs::TabInterface* const b = OpenLoaded("b.test");
+  tabs::TabInterface* const c = OpenLoaded("c.test");
+  tabs::TabInterface* const d = OpenLoaded("d.test");
+  // [start, Reading[a, b], Later[c, d]]: the folders made once every tab is
+  // open, as a tab opened from a folder's last tab joins it (F25).
+  tabs::FolderTabCollection* const reading =
+      tab_strip_model()->AddToNewFolder({IndexOf(a), IndexOf(b)});
+  ASSERT_TRUE(reading);
+  reading->SetTitle("Reading");
+  tabs::FolderTabCollection* const later =
+      tab_strip_model()->AddToNewFolder({IndexOf(c), IndexOf(d)});
+  ASSERT_TRUE(later);
+  later->SetTitle("Later");
+  tab_strip_model()->ActivateTabAt(0);
+
+  {
+    SCOPED_TRACE("Reading's header dragged onto the middle of Later's");
+    const gfx::Point onto = HeaderCentre(later);
+    PressAndDragHeader(reading, onto);
+    EXPECT_TRUE(IsLit(later)) << "the folder it would go into is not lit";
+    EXPECT_FALSE(IsLit(reading));
+    EXPECT_FALSE(RowDropBarShown(reading)) << "a bar shows a place between rows";
+    ReleaseAt(onto);
+    EXPECT_FALSE(IsLit(later)) << "the light stayed on after the release";
+    EXPECT_EQ(later, reading->GetParentCollection());
+    EXPECT_EQ(std::optional<size_t>(2), later->GetIndexOfCollection(reading))
+        << "not at Later's end";
+    EXPECT_EQ(reading, a->GetParentCollection()) << "the folder lost a tab";
+    EXPECT_EQ(reading, b->GetParentCollection());
+    EXPECT_EQ(later, c->GetParentCollection());
+    EXPECT_EQ(later, d->GetParentCollection());
+    // start, c, d, a, b
+    EXPECT_LT(IndexOf(c), IndexOf(d));
+    EXPECT_LT(IndexOf(d), IndexOf(a));
+    EXPECT_LT(IndexOf(a), IndexOf(b));
+    EXPECT_FALSE(reading->collapsed()) << "the drag toggled the folder";
+    EXPECT_FALSE(later->collapsed());
+    EXPECT_TRUE(DrawnRow(a)) << "the moved folder's rows are not drawn";
+  }
+
+  {
+    SCOPED_TRACE("what a restart reads");
+    const std::map<SessionID, std::string> saved = FolderPathsARestartReads();
+    for (tabs::TabInterface* const tab : {a, b}) {
+      const auto it =
+          saved.find(sessions::SessionTabHelper::IdForTab(tab->GetContents()));
+      ASSERT_NE(saved.end(), it) << "no folder path saved for a tab";
+      EXPECT_EQ(stedding::FolderPathForTab(tab), it->second);
+      const size_t outer = it->second.find(later->id().ToString());
+      const size_t inner = it->second.find(reading->id().ToString());
+      ASSERT_NE(std::string::npos, outer) << it->second;
+      ASSERT_NE(std::string::npos, inner) << it->second;
+      EXPECT_LT(outer, inner)
+          << "the folder it went into is not first: " << it->second;
+    }
+  }
