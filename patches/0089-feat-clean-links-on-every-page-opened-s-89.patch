+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/clean_links.h"
+
+#include <string>
+#include <vector>
+
+#include "base/values.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace stedding {
+
+bool CleanLinksOn(const PrefService& service) {
+  return service.GetBoolean(prefs::kCleanLinks);
+}
+
+std::vector<std::string> CleanLinksKeptSites(const PrefService& service) {
+  std::vector<std::string> sites;
+  for (const base::Value& entry :
+       service.GetList(prefs::kCleanLinksKeptSites)) {
+    if (entry.is_string() && !entry.GetString().empty()) {
+      sites.push_back(entry.GetString());
+    }
+  }
+  return sites;
+}
+
+void AddCleanLinksKeptSite(PrefService& service, const std::string& site) {
+  if (site.empty() ||
+      service.GetList(prefs::kCleanLinksKeptSites).contains(site)) {
+    return;
+  }
+  ScopedListPrefUpdate update(service, prefs::kCleanLinksKeptSites);
+  update->Append(site);
+}
+
+void RemoveCleanLinksKeptSite(PrefService& service, const std::string& site) {
+  if (!service.GetList(prefs::kCleanLinksKeptSites).contains(site)) {
+    return;
+  }
+  ScopedListPrefUpdate update(service, prefs::kCleanLinksKeptSites);
+  update->EraseValue(base::Value(site));
+}
+
+}  // namespace stedding
