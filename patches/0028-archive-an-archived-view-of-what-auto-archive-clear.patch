diff --git a/chrome/browser/ui/archive/archived_tabs.cc b/chrome/browser/ui/archive/archived_tabs.cc
new file mode 100644
index 0000000000000..ab21698e38fb1
--- /dev/null
+++ b/chrome/browser/ui/archive/archived_tabs.cc
@@ -0,0 +1,196 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/archive/archived_tabs.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/token.h"
+#include "chrome/browser/ui/archive/archive_mark.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_colors.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/tab_space_restore_data.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/prefs/pref_service.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/live_tab.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/tab_restore_types.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+
+namespace stedding {
+
+namespace {
+
+std::string Lookup(const std::map<std::string, std::string>& extra_data,
+                   const char* key) {
+  const auto it = extra_data.find(key);
+  return it == extra_data.end() ? std::string() : it->second;
+}
+
+}  // namespace
+
+void PopulateArchiveExtraData(tabs::TabInterface* tab,
+                              std::map<std::string, std::string>* extra_data) {
+  if (!tab || !extra_data) {
+    return;
+  }
+  if (const std::optional<ArchiveReason> reason =
+          ArchiveMarkOf(tab->GetContents())) {
+    (*extra_data)[kArchiveReasonKey] = ArchiveReasonName(*reason);
+  }
+  spaces::SpaceModel* const model =
+      spaces::SpaceModel::From(tab->GetBrowserWindowInterface());
+  if (model && !tab->IsPinned()) {
+    (*extra_data)[kArchiveSpaceNameKey] =
+        base::UTF16ToUTF8(model->DisplayName(model->SpaceForTab(tab)));
+  }
+}
+
+ArchivedTab::ArchivedTab() = default;
+ArchivedTab::ArchivedTab(const ArchivedTab& other) = default;
+ArchivedTab& ArchivedTab::operator=(const ArchivedTab& other) = default;
+ArchivedTab::~ArchivedTab() = default;
+
+std::vector<ArchivedTab> ListArchivedTabs(
+    const sessions::TabRestoreService::Entries& entries,
+    base::Time now,
+    base::TimeDelta keep) {
+  std::vector<ArchivedTab> out;
+  for (const std::unique_ptr<sessions::tab_restore::Entry>& entry : entries) {
+    if (entry->type != sessions::tab_restore::TAB) {
+      continue;
+    }
+    const auto& tab = static_cast<const sessions::tab_restore::Tab&>(*entry);
+    if (tab.navigations.empty()) {
+      continue;
+    }
+    if (!tab.timestamp.is_null() && now - tab.timestamp > keep) {
+      continue;
+    }
+    const sessions::SerializedNavigationEntry& current =
+        tab.navigations[tab.normalized_navigation_index()];
+    ArchivedTab row;
+    row.id = tab.id;
+    row.title = current.title();
+    row.url = current.virtual_url();
+    if (row.title.empty()) {
+      row.title = base::UTF8ToUTF16(row.url.spec());
+    }
+    row.time = tab.timestamp;
+    row.space_id = Lookup(tab.extra_data, spaces::kSessionTabSpaceKey);
+    row.space_name = Lookup(tab.extra_data, kArchiveSpaceNameKey);
+    row.folder_path = Lookup(tab.extra_data, "stedding.folderpath");
+    row.reason = Lookup(tab.extra_data, kArchiveReasonKey);
+    out.push_back(std::move(row));
+  }
+  return out;
+}
+
+base::DictValue ArchivedTabToValue(const ArchivedTab& tab) {
+  base::DictValue value;
+  value.Set("id", base::NumberToString(tab.id.id()));
+  value.Set("title", tab.title);
+  value.Set("url", tab.url.spec());
+  value.Set("time", tab.time.InMillisecondsFSinceUnixEpoch());
+  value.Set("spaceId", tab.space_id);
+  value.Set("spaceName", tab.space_name);
+  value.Set("folderPath", tab.folder_path);
+  value.Set("reason", tab.reason);
+  return value;
+}
+
+base::TimeDelta ArchiveRetention(const PrefService* prefs) {
+  const int days = prefs ? prefs->GetInteger(prefs::kArchiveKeepDays) : 30;
+  return base::Days(days > 0 ? days : 30);
+}
+
+spaces::SpaceId SpaceForRestore(spaces::SpaceModel* model,
+                                const std::string& space_id,
+                                const std::string& space_name) {
+  CHECK(model);
+  if (const std::optional<spaces::SpaceId> id =
+          spaces::SpaceId::FromOptionalToken(base::Token::FromString(space_id));
+      id && model->GetSpace(*id)) {
+    return *id;
+  }
+  if (space_name.empty()) {
+    return model->active_id();
+  }
+  for (const std::unique_ptr<spaces::Space>& space : model->spaces()) {
+    if (base::UTF16ToUTF8(model->DisplayName(space->id())) == space_name) {
+      return space->id();
+    }
+  }
+  // Gone: it comes back with its name, in the next colour of the ring.
+  spaces::Space* const made = model->AddSpace(
+      space_name,
+      spaces::kSpaceColors.at(model->size() % spaces::kSpaceColors.size())
+          .color);
+  return made->id();
+}
+
+bool RestoreArchivedTab(BrowserWindowInterface* browser,
+                        sessions::LiveTabContext* context,
+                        sessions::TabRestoreService* service,
+                        SessionID id) {
+  if (!browser || !context || !service) {
+    return false;
+  }
+  std::string space_id;
+  std::string space_name;
+  bool found = false;
+  for (const std::unique_ptr<sessions::tab_restore::Entry>& entry :
+       service->entries()) {
+    if (entry->id == id && entry->type == sessions::tab_restore::TAB) {
+      space_id = Lookup(entry->extra_data, spaces::kSessionTabSpaceKey);
+      space_name = Lookup(entry->extra_data, kArchiveSpaceNameKey);
+      found = true;
+      break;
+    }
+  }
+  if (!found) {
+    return false;
+  }
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+  // The Space first, so the restored tab's own restore data names one that
+  // exists (spaces B2 would otherwise file it in the active Space).
+  std::optional<spaces::SpaceId> target;
+  if (model) {
+    target = SpaceForRestore(model, space_id, space_name);
+  }
+  const std::vector<sessions::LiveTab*> live = service->RestoreEntryById(
+      context, id, WindowOpenDisposition::NEW_BACKGROUND_TAB);
+  if (live.empty()) {
+    return false;
+  }
+  if (!model || !target) {
+    return true;
+  }
+  // A live tab names its WebContents only by session id; the strip has it.
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  for (sessions::LiveTab* live_tab : live) {
+    const SessionID live_id = live_tab->GetSessionID();
+    for (int i = 0; i < tabs->count(); ++i) {
+      tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+      if (sessions::SessionTabHelper::IdForTab(tab->GetContents()) != live_id) {
+        continue;
+      }
+      model->SetSpaceForTab(tab, *target);
+      model->SetActiveSpace(*target);
+      tabs->ActivateTabAt(i);
+      break;
+    }
+  }
+  return true;
+}
+
+}  // namespace stedding
