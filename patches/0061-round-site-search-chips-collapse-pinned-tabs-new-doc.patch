+// pins H17, spaces B33: Collapse Pinned Tabs hides the Space's pins through
+// the strip's one rule, TabStripModel::IsTabHidden, but for the one on
+// screen: the selected pin keeps its row, and it alone. The loose tab and
+// the essential stay, tab traversal passes over the hidden pins, and Expand
+// Pinned Tabs brings them back. Nothing is unpinned or moved.
+TEST_F(SpaceWindowTest, ACollapsedPinnedRunHidesItsPinsButTheSelectedOne) {
+  tabs::TabInterface* const essential = OpenTab();
+  tabs().SetTabPinned(tabs().GetIndexOfTab(essential), true);
+  tabs::TabInterface* const loose = OpenTab();
+  tabs::TabInterface* const pin_a = OpenTab();
+  model().SetSpacePinned(pin_a, true);
+  tabs::TabInterface* const pin_b = OpenTab();
+  model().SetSpacePinned(pin_b, true);
+  const auto index = [this](const tabs::TabInterface* tab) {
+    return tabs().GetIndexOfTab(tab);
+  };
+  const auto hidden = [this, &index](const tabs::TabInterface* tab) {
+    return tabs().IsTabHidden(index(tab));
+  };
+  // The essential, the run of two pins, the loose tab.
+  ASSERT_EQ(0, index(essential));
+  ASSERT_EQ(1, index(pin_a));
+  ASSERT_EQ(2, index(pin_b));
+  ASSERT_EQ(3, index(loose));
+  tabs().ActivateTabAt(index(loose));
+  const SpaceId home = model().active_id();
+  ASSERT_TRUE(model().HasSpacePins(home));
+  ASSERT_FALSE(hidden(pin_a));
+
+  model().SetPinsCollapsed(home, true);
+  EXPECT_TRUE(model().ArePinsCollapsed(home));
+  EXPECT_TRUE(hidden(pin_a));
+  EXPECT_TRUE(hidden(pin_b));
+  EXPECT_FALSE(hidden(loose));
+  EXPECT_FALSE(hidden(essential)) << "an essential is not the Space's pin";
+  EXPECT_TRUE(model().IsSpacePinned(pin_a)) << "collapsing unpins nothing";
+  EXPECT_EQ(1, index(pin_a)) << "and moves nothing";
+
+  // Traversal walks the rows on screen: from the loose tab it wraps to the
+  // essential, and from there it passes over both pins.
+  tabs().SelectNextTab();
+  EXPECT_EQ(essential, tabs().GetActiveTab());
+  tabs().SelectNextTab();
+  EXPECT_EQ(loose, tabs().GetActiveTab());
+
+  // The selected pin keeps its row; the other pin stays hidden, and leaving
+  // the pin hides it again.
+  tabs().ActivateTabAt(index(pin_a));
+  EXPECT_FALSE(hidden(pin_a));
+  EXPECT_TRUE(hidden(pin_b));
+  tabs().ActivateTabAt(index(loose));
+  EXPECT_TRUE(hidden(pin_a));
+
+  model().SetPinsCollapsed(home, false);
+  EXPECT_FALSE(model().ArePinsCollapsed(home));
+  EXPECT_FALSE(hidden(pin_a));
+  EXPECT_FALSE(hidden(pin_b));
+}
+
+// pins H17, windows G1: the collapse belongs to the Space, so every window
+// showing it follows, and it is kept in the registry with the Space's name
+// and colour, which is what brings it back after a restart.
+TEST_F(SpaceWindowTest, ACollapsedPinnedRunReachesEveryWindow) {
+  ASSERT_TRUE(model().follows_registry());
+  const SpaceId home = model().active_id();
+  std::unique_ptr<BrowserWindowInterface> second =
+      CreateBrowser(profile(), Browser::TYPE_NORMAL, /*hosted_app=*/false);
+  SpaceModel* const other = SpaceModel::From(second.get());
+  ASSERT_TRUE(other);
+  ASSERT_TRUE(other->GetSpace(home));
+  EXPECT_FALSE(other->ArePinsCollapsed(home));
+
+  model().SetPinsCollapsed(home, true);
+  EXPECT_TRUE(model().ArePinsCollapsed(home));
+  EXPECT_TRUE(other->ArePinsCollapsed(home)) << "collapsed in one, in all";
+  const RegistryEntry* const entry = model().registry()->Find(home);
+  ASSERT_TRUE(entry);
+  EXPECT_TRUE(entry->pins_collapsed);
+
+  other->SetPinsCollapsed(home, false);
+  EXPECT_FALSE(model().ArePinsCollapsed(home));
+  EXPECT_FALSE(model().registry()->Find(home)->pins_collapsed);
+  second->GetTabStripModel()->CloseAllTabs();
+}
