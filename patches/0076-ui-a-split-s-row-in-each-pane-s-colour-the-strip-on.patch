+// toolbar T41: a split's row as the window's background paints it, along
+// the row's middle, against the colours each part should have: over each
+// pane up to the blend that pane's colour, and over the gap between them a
+// colour between the two in every channel where they differ.
+testing::AssertionResult SplitRowReads(BrowserView* window,
+                                       SkColor left,
+                                       SkColor right) {
+  views::test::RunScheduledLayout(window);
+  MultiContentsView* const panes = window->multi_contents_view();
+  if (!panes || !panes->IsInSplitView()) {
+    return testing::AssertionFailure() << "no split on screen";
+  }
+  const auto bounds_of = [window](views::View* pane) {
+    gfx::RectF bounds(pane->GetLocalBounds());
+    views::View::ConvertRectToTarget(pane, window, &bounds);
+    return gfx::ToEnclosingRect(bounds);
+  };
+  gfx::Rect first = bounds_of(panes->contents_container_views()[0]);
+  gfx::Rect second = bounds_of(panes->contents_container_views()[1]);
+  if (first.x() > second.x()) {
+    std::swap(first, second);
+  }
+  gfx::RectF toolbar(window->toolbar()->GetLocalBounds());
+  views::View::ConvertRectToTarget(window->toolbar(), window, &toolbar);
+  const int y = static_cast<int>(toolbar.CenterPoint().y());
+
+  gfx::Canvas canvas(window->size(), 1.0f, /*is_opaque=*/true);
+  window->background()->Paint(&canvas, window);
+  const SkBitmap& row = canvas.GetBitmap();
+  // The blend runs 6 DIP past each side of the gap.
+  const struct {
+    const char* where;
+    int x;
+    SkColor want;
+  } solid[] = {
+      {"over the left pane's middle", first.CenterPoint().x(), left},
+      {"over the left pane, before the blend", first.right() - 8, left},
+      {"over the right pane, after the blend", second.x() + 8, right},
+      {"over the right pane's middle", second.CenterPoint().x(), right},
+  };
+  for (const auto& point : solid) {
+    const SkColor got = row.getColor(point.x, y);
+    if (got != point.want) {
+      return testing::AssertionFailure()
+             << point.where << " (x " << point.x << ") the row is "
+             << color_utils::SkColorToRgbaString(got) << ", not "
+             << color_utils::SkColorToRgbaString(point.want) << "; panes "
+             << first.ToString() << " and " << second.ToString();
+    }
+  }
+  if (left != right) {
+    const int middle = (first.right() + second.x()) / 2;
+    const SkColor got = row.getColor(middle, y);
+    const auto between = [](U8CPU value, U8CPU a, U8CPU b) {
+      return a == b ? value == a : std::min(a, b) < value && value < std::max(a, b);
+    };
+    if (!between(SkColorGetR(got), SkColorGetR(left), SkColorGetR(right)) ||
+        !between(SkColorGetG(got), SkColorGetG(left), SkColorGetG(right)) ||
+        !between(SkColorGetB(got), SkColorGetB(left), SkColorGetB(right))) {
+      return testing::AssertionFailure()
+             << "over the gap (x " << middle << ") the row is "
+             << color_utils::SkColorToRgbaString(got)
+             << ", not a blend of the two";
+    }
+  }
+  return testing::AssertionSuccess();
+}
