+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_VIDEO_POP_OUT_H_
+#define CHROME_BROWSER_UI_STEDDING_VIDEO_POP_OUT_H_
+
+#include "base/memory/raw_ref.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_observer.h"
+
+class BrowserWindowInterface;
+
+namespace content {
+class WebContents;
+}
+
+namespace stedding {
+
+// docs/features/player.md Mp2, Mp4 (BACKLOG S-95): with "Pop out a playing
+// video when you leave its tab" on (`stedding.player.pop_out`), leaving a
+// tab whose page plays a video with sound puts that video in picture in
+// picture, as the picture-in-picture key does (Mp5), and showing the tab
+// again puts it back in the page. Chromium's own automatic picture in
+// picture never fires for such a video here: it waits for a Safe Browsing
+// check of the page, and Stedding has none (BACKLOG S-75).
+//
+// One per tabbed window. It watches which tab is active: a tab chosen in the
+// strip, a Space shown (which shows another tab), a tab closed.
+class VideoPopOut : public TabStripModelObserver {
+ public:
+  explicit VideoPopOut(BrowserWindowInterface& browser);
+  VideoPopOut(const VideoPopOut&) = delete;
+  VideoPopOut& operator=(const VideoPopOut&) = delete;
+  ~VideoPopOut() override;
+
+  // Whether `contents` plays a video with sound that picture in picture can
+  // take now: playing, a player with both sound and picture, neither the tab
+  // nor the page muted, and the page's media session offering picture in
+  // picture. Not while the page already shows picture in picture.
+  static bool PlaysVideoWithSound(content::WebContents* contents);
+
+  // The page whose video this window popped out, while it is out.
+  content::WebContents* popped_out_for_testing() const {
+    return popped_.get();
+  }
+
+ private:
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(
+      TabStripModel* tab_strip_model,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override;
+
+  // Whether `contents` is on screen in this window: the active tab's page,
+  // or the other pane of its split.
+  bool IsShown(content::WebContents* contents) const;
+
+  bool IsOn() const;
+
+  const raw_ref<BrowserWindowInterface> browser_;
+  base::WeakPtr<content::WebContents> popped_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_VIDEO_POP_OUT_H_
