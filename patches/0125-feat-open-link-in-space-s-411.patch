+// menus M14 (GitHub issue 75): while one is alive, the tab Navigate() makes
+// is filed in `space` and made in its jar, whatever a route says: the page
+// menu's Open Link in Space holds one around its OpenURL, which makes the
+// tab before it returns. Ignored when the window has no such Space. UI
+// thread only.
+class ScopedNewTabSpace {
+ public:
+  explicit ScopedNewTabSpace(const SpaceId& space);
+  ScopedNewTabSpace(const ScopedNewTabSpace&) = delete;
+  ScopedNewTabSpace& operator=(const ScopedNewTabSpace&) = delete;
+  ~ScopedNewTabSpace();
+
+  // The Space named while one is alive, else null.
+  static const SpaceId* Current();
+
+ private:
+  const SpaceId space_;
+  const raw_ptr<const ScopedNewTabSpace> previous_;
+};
