+// Lf8, Lf10: nothing is asked of GitHub before the folder is made, nor after
+// it is deleted; deleting it forgets the token.
+IN_PROC_BROWSER_TEST_F(LiveFoldersTest,
+                       NoRequestBeforeItIsMadeOrAfterItIsDeleted) {
+  // A window coming to the front, a second window, a Refresh: nothing.
+  BrowserWindowInterface* const second = OpenWindow();
+  Service().RefreshNow();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(Service().on());
+  EXPECT_TRUE(seen_.empty()) << "a request before the folder was made";
+
+  // Lf1: a paste that cannot be a token asks GitHub nothing.
+  for (const char* paste : {"", "   ", "ghp_abc def", "Bearer ghp_abc",
+                            "https://github.com/settings/tokens"}) {
+    base::test::TestFuture<Failure> made;
+    Service().Make(paste, Model(browser()).active_id(), made.GetCallback());
+    EXPECT_EQ(Failure::kToken, made.Get()) << paste;
+  }
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(Service().on());
+  EXPECT_TRUE(seen_.empty()) << "a request for a paste that is no token";
+
+  AnswerTheFirstList();
+  ASSERT_EQ(Failure::kNone, Make());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return LiveRows(second).size() == FirstList().size(); }));
+  ASSERT_EQ(4u, seen_.size());
+  EXPECT_FALSE(
+      profile()->GetPrefs()->GetString(live_folders::kGitHubTokenPref).empty());
+
+  ASSERT_TRUE(live_folders::RunCommand(profile(),
+                                       live_folders::Command::kDelete));
+  EXPECT_FALSE(Service().on());
+  EXPECT_TRUE(
+      profile()->GetPrefs()->GetString(live_folders::kGitHubTokenPref).empty());
+  EXPECT_TRUE(profile()
+                  ->GetPrefs()
+                  ->GetDict(live_folders::kGitHubFolderPref)
+                  .empty());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return LiveRows(browser()).empty() && LiveRows(second).empty();
+  })) << "a row outlived the folder";
+  // Every row was asleep: none is left under any token, in either window.
+  for (BrowserWindowInterface* window : {browser(), second}) {
+    EXPECT_EQ(0u, TabsAt(window, Fuel7Url()));
+    EXPECT_EQ(0u, TabsAt(window, Rocket42Url()));
+    EXPECT_EQ(0u, TabsAt(window, Rocket45Url()));
+  }
+  EXPECT_FALSE(live_folders::NoteFor(profile(), std::string()));
+
+  Service().RefreshNow();
+  Service().RefreshNowForTesting();
+  OpenWindow();
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(4u, seen_.size()) << "a request after the folder was deleted";
+  EXPECT_FALSE(
+      live_folders::RunCommand(profile(), live_folders::Command::kRefresh));
+}
