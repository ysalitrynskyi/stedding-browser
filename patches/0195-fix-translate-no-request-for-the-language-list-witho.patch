 components/translate/core/browser/BUILD.gn    |  1 +
 .../core/browser/translate_language_list.cc   | 11 ++++++
 .../translate_language_list_unittest.cc       | 39 +++++++++++++++++++
 3 files changed, 51 insertions(+)

