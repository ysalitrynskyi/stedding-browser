+TabDragTarget* VerticalTabStripRegionView::GetTabDragTarget(
+    const gfx::Point& point_in_screen) {
+  // A tab dropped on a Space icon moves to that Space. Off by default; see
+  // stedding::kDragTabsToSpaces.
+  if (space_drag_target_ && space_switcher_ &&
+      space_switcher_->GetBoundsInScreen().Contains(point_in_screen)) {
+    space_drag_target_->SetHoveredSpace(
+        space_switcher_->SpaceAtScreenPoint(point_in_screen));
+    return space_drag_target_.get();
+  }
+  return BaseTabStripRegionView::GetTabDragTarget(point_in_screen);
+}
