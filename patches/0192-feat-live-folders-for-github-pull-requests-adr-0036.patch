+// Lf2: while the folder is on, a new token replaces the old one: the folder
+// keeps its id, its name and the rows the person removed, and the new token
+// is the one sent.
+IN_PROC_BROWSER_TEST_F(LiveFoldersTest, ANewTokenReplacesTheOld) {
+  AnswerTheFirstList();
+  ASSERT_EQ(Failure::kNone, Make());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return LiveRows(browser()).size() == FirstList().size(); }));
+  const std::string folder_id = Service().folder_id();
+  // The person renames the folder, and then takes a row out: two changes,
+  // each published from the window in its own turn (windows G13).
+  const_cast<tabs::FolderTabCollection*>(FolderOf(LiveRows(browser())[0]))
+      ->SetTitle("Reviews");
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const spaces::PinRecord* const record =
+        Store().Find(stedding::TabToken(LiveRows(browser())[0]->GetContents()));
+    return record && record->folder_path.find("Reviews") != std::string::npos;
+  })) << "the folder's new name did not reach the store";
+  Model(browser()).SetSpacePinned(LiveRows(browser())[2], false);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return LiveRows(browser()).size() == 2u; }))
+      << "the row taken out is still a row";
+  const std::string old_sealed =
+      profile()->GetPrefs()->GetString(live_folders::kGitHubTokenPref);
+
+  for (const char* who : {"author:@me", "assignee:@me",
+                          "review-requested:@me", "mentions:@me"}) {
+    answers_[who] = {net::HTTP_UNAUTHORIZED,
+                     live_folders::recorded::kBadCredentials};
+  }
+  RefreshAndWait();
+  ASSERT_EQ(Failure::kToken, Service().failure());
+
+  answers_.clear();
+  AnswerTheFirstList();
+  const size_t before = seen_.size();
+  base::test::TestFuture<Failure> replaced;
+  Service().MakeInActiveSpace(kOtherToken, replaced.GetCallback());
+  ASSERT_EQ(Failure::kNone, replaced.Get());
+  ASSERT_EQ(before + 4, seen_.size());
+  EXPECT_EQ(std::string("Bearer ") + kOtherToken,
+            seen_.back().authorization);
+  EXPECT_TRUE(Service().on());
+  EXPECT_EQ(Failure::kNone, Service().failure());
+  EXPECT_EQ(folder_id, Service().folder_id());
+  EXPECT_NE(old_sealed,
+            profile()->GetPrefs()->GetString(live_folders::kGitHubTokenPref));
+  EXPECT_EQ(2u, LiveRows(browser()).size()) << "the removed row came back";
+  EXPECT_EQ("Reviews", FolderOf(LiveRows(browser())[0])->title());
+
+  // A paste that is no token is refused and changes nothing.
+  base::test::TestFuture<Failure> refused;
+  Service().MakeInActiveSpace("not a token", refused.GetCallback());
+  EXPECT_EQ(Failure::kToken, refused.Get());
+  EXPECT_EQ(before + 4, seen_.size());
+}
