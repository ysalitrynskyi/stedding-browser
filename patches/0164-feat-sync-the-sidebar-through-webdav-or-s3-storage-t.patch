+std::unique_ptr<SidebarSyncService::PendingPlace>
+SidebarSyncService::MakePendingPlace(sidebar_sync::Place place,
+                                     sidebar_sync::PlaceSignIn sign_in) {
+  auto pending = std::make_unique<PendingPlace>();
+  pending->client = std::make_unique<sidebar_sync::PlaceClient>(
+      place, sign_in, PlaceFactory(), clock_);
+  pending->place = std::move(place);
+  pending->sign_in = std::move(sign_in);
+  return pending;
+}
