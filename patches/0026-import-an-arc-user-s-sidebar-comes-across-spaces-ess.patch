+using Node = ArcImportPlan::Node;
+
+void CountNodes(const std::vector<Node>& nodes, size_t* tabs, size_t* folders) {
+  for (const Node& node : nodes) {
+    if (node.kind == Node::Kind::kTab) {
+      ++*tabs;
+    } else {
+      ++*folders;
+      CountNodes(node.children, tabs, folders);
+    }
+  }
+}
+
+// Arc's item, before the tree is built.
+struct ArcItem {
+  enum class Kind { kTab, kList, kContainer };
+  Kind kind = Kind::kTab;
+  std::string id;
+  std::string parent;
+  std::vector<std::string> children;
+  std::u16string title;
+  GURL url;
+  std::string container_type;
+};
+
+// Arc's lists alternate an id string with its dict.
+std::vector<const base::DictValue*> DictsOf(const base::ListValue* list) {
+  std::vector<const base::DictValue*> out;
+  if (!list) {
+    return out;
+  }
+  for (const base::Value& value : *list) {
+    if (const base::DictValue* dict = value.GetIfDict()) {
+      out.push_back(dict);
+    }
+  }
+  return out;
+}
+
+std::string StringAt(const base::DictValue& dict, std::string_view key) {
+  const std::string* value = dict.FindString(key);
+  return value ? *value : std::string();
+}
+
+// The first string inside a value, depth first: Arc's profile binding is a
+// small nest whose leaf is the name.
+std::string FirstString(const base::Value& value);
+
+std::string FirstString(const base::DictValue& dict) {
+  for (const auto [key, child] : dict) {
+    const std::string found = FirstString(child);
+    if (!found.empty()) {
+      return found;
+    }
+  }
+  return std::string();
+}
+
+std::string FirstString(const base::ListValue& list) {
+  for (const base::Value& child : list) {
+    const std::string found = FirstString(child);
+    if (!found.empty()) {
+      return found;
+    }
+  }
+  return std::string();
+}
+
+std::string FirstString(const base::Value& value) {
+  if (value.is_string()) {
+    return value.GetString();
+  }
+  if (const base::DictValue* dict = value.GetIfDict()) {
+    return FirstString(*dict);
+  }
+  if (const base::ListValue* list = value.GetIfList()) {
+    return FirstString(*list);
+  }
+  return std::string();
+}
+
+std::optional<ArcItem> ParseItem(const base::DictValue& dict) {
+  ArcItem item;
+  item.id = StringAt(dict, "id");
+  if (item.id.empty()) {
+    return std::nullopt;
+  }
+  item.parent = StringAt(dict, "parentID");
+  if (const base::ListValue* children = dict.FindList("childrenIds")) {
+    for (const base::Value& child : *children) {
+      if (child.is_string()) {
+        item.children.push_back(child.GetString());
+      }
+    }
+  }
+  item.title = base::UTF8ToUTF16(StringAt(dict, "title"));
+  const base::DictValue* data = dict.FindDict("data");
+  if (!data) {
+    return std::nullopt;
+  }
+  if (const base::DictValue* tab = data->FindDict("tab")) {
+    item.kind = ArcItem::Kind::kTab;
+    item.url = GURL(StringAt(*tab, "savedURL"));
+    const std::string saved_title = StringAt(*tab, "savedTitle");
+    if (!saved_title.empty()) {
+      item.title = base::UTF8ToUTF16(saved_title);
+    }
+    return item;
+  }
+  if (data->contains("list")) {
+    item.kind = ArcItem::Kind::kList;
+    return item;
+  }
+  if (const base::DictValue* container = data->FindDict("itemContainer")) {
+    item.kind = ArcItem::Kind::kContainer;
+    if (const base::DictValue* type = container->FindDict("containerType")) {
+      if (!type->empty()) {
+        item.container_type = type->begin()->first;
+      }
+    } else {
+      item.container_type = StringAt(*container, "containerType");
+    }
+    return item;
+  }
+  return std::nullopt;
+}
+
+// The nodes under `parent`, in Arc's order; lists nest.
+std::vector<Node> BuildChildren(const ArcItem& parent,
+                                const std::map<std::string, ArcItem>& items,
+                                int depth) {
+  std::vector<Node> out;
+  if (depth > 16) {
+    return out;
+  }
+  for (const std::string& child_id : parent.children) {
+    const auto it = items.find(child_id);
+    if (it == items.end()) {
+      continue;
+    }
+    const ArcItem& child = it->second;
+    Node node;
+    node.arc_id = child.id;
+    node.title = child.title;
+    if (child.kind == ArcItem::Kind::kTab) {
+      if (!child.url.is_valid()) {
+        continue;
+      }
+      node.kind = Node::Kind::kTab;
+      node.url = child.url;
+      out.push_back(std::move(node));
+    } else if (child.kind == ArcItem::Kind::kList) {
+      node.kind = Node::Kind::kFolder;
+      node.children = BuildChildren(child, items, depth + 1);
+      out.push_back(std::move(node));
+    }
+  }
+  return out;
+}
+
+std::optional<SkColor> ThemeColor(const base::DictValue& space) {
+  const base::DictValue* tone = space.FindDictByDottedPath(
+      "customInfo.windowTheme.primaryColorPalette.midTone");
+  if (!tone) {
+    return std::nullopt;
+  }
+  const auto channel = [tone](std::string_view key) {
+    const std::optional<double> value = tone->FindDouble(key);
+    return static_cast<int>(std::clamp(value.value_or(0.0), 0.0, 1.0) * 255.0 +
+                            0.5);
+  };
+  return NearestSpaceColor(
+      SkColorSetRGB(channel("red"), channel("green"), channel("blue")));
+}
