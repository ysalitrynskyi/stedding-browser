+            SpaceIconFromText(u"\U0001F468‍\U0001F469‍\U0001F467 "
+                              u"home"))
+      << "a family joined with zero-width joiners";
+  EXPECT_EQ("✈️", SpaceIconFromText(u"✈️ trips"))
+      << "an emoji's presentation selector";
