+// A13: a window closed on its own, asked as it closes. The session keeps the
+// last window of a profile to restore until another window of the profile
+// opens, on every platform: on the Mac the browser runs on with no window
+// and a quit then reopens it, off the Mac that close usually ends the run.
+// Another window it tracks, a normal one or a little window, makes the close
+// final, and a window closing all its tabs is not another. A private window
+// and a little window are never marked.
+IN_PROC_BROWSER_TEST_F(ArchiveReopenTest,
+                       TheLastWindowOfAProfileReopensUnlessAWindowOpens) {
+  constexpr stedding::NextLaunch kLast =
+      stedding::NextLaunch::kReopensItUnlessAWindowOpens;
+  constexpr stedding::NextLaunch kClosed = stedding::NextLaunch::kLeavesItClosed;
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_TRUE(SessionServiceFactory::GetForProfileIfExisting(profile))
+      << "with no session service, every close reads as a quit's";
+  EXPECT_EQ(kLast, stedding::NextLaunchReopens(browser()));
+  SessionStartupPref::SetStartupPref(
+      profile, SessionStartupPref(SessionStartupPref::DEFAULT));
+  EXPECT_EQ(kClosed, stedding::NextLaunchReopens(browser()))
+      << "the New Tab page at startup: the window's tabs are closed";
+  SessionStartupPref::SetStartupPref(
+      profile, SessionStartupPref(SessionStartupPref::LAST));
+
+  // A private window is never restored, and is not one of the profile's.
+  BrowserWindowInterface* const private_window = CreateIncognitoBrowser();
+  ASSERT_TRUE(private_window);
+  EXPECT_EQ(kClosed, stedding::NextLaunchReopens(private_window));
+  EXPECT_EQ(kLast, stedding::NextLaunchReopens(browser()))
+      << "a private window kept the profile's window from being its last";
+  CloseBrowserSynchronously(private_window);
+
+  // With a second window open, the close of either is final.
+  BrowserWindowInterface* const second = CreateBrowser(profile);
+  ASSERT_TRUE(second);
+  EXPECT_EQ(kClosed, stedding::NextLaunchReopens(browser()));
+  EXPECT_EQ(kClosed, stedding::NextLaunchReopens(second));
+  // Until it closes all its tabs: one still running its beforeunload handler
+  // keeps it on the list, but the session counts it among its closing
+  // windows, and the first window is the last again.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      second, embedded_test_server()->GetURL("closing.test",
+                                             "/emptybeforeunload.html")));
+  content::WebContents* const unloading =
+      second->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return unloading->NeedToFireBeforeUnloadOrUnloadEvents(); }));
+  ui_test_utils::BrowserDestroyedObserver second_gone(second);
+  second->GetTabStripModel()->CloseAllTabs();
+  ASSERT_EQ(1, second->GetTabStripModel()->count())
+      << "the tab closed before its handler ran";
+  ASSERT_FALSE(second->IsDeleteScheduled());
+  EXPECT_EQ(kLast, stedding::NextLaunchReopens(browser()))
+      << "a window closing all its tabs counted as one still open";
+  second_gone.Wait();
+
+  // A little window is a popup the session keeps: beside it, the window's
+  // close is final, and the little window itself is never marked.
+  BrowserWindowInterface* const little = CreateBrowserForPopup(profile);
+  ASSERT_TRUE(little);
+  EXPECT_EQ(kClosed, stedding::NextLaunchReopens(little));
+  EXPECT_EQ(kClosed, stedding::NextLaunchReopens(browser()));
+  CloseBrowserSynchronously(little);
+
+  // A Blank Window (windows G4), the profile's only window once the first
+  // one has closed.
+  ui_test_utils::BrowserCreatedObserver opened;
+  chrome::ExecuteCommand(browser(), IDC_STEDDING_NEW_BLANK_WINDOW);
+  BrowserWindowInterface* const blank = opened.Wait();
+  ASSERT_TRUE(blank);
+  const spaces::SpaceModel* const blank_model = spaces::SpaceModel::From(blank);
+  ASSERT_TRUE(blank_model);
+  ASSERT_FALSE(blank_model->follows_registry());
+  EXPECT_EQ(kClosed, stedding::NextLaunchReopens(blank));
+  CloseBrowserSynchronously(browser());
+  SetBrowser(blank);
+  EXPECT_EQ(kLast, stedding::NextLaunchReopens(blank));
+}
+
+// A13, A15 (BACKLOG S-230, the Mac's commonest flow): the profile's last
+// window closed on its own, as ⇧⌘W or its close button closes it, the run
+// going on with no window of the profile, and then the quit. A private
+// window keeps the run going here as the Mac's browser runs on: the session
+// does not count it, and keeps the last window to restore. Its tabs are
+// marked as the window closes, and ⇧⌘T could still bring it back.
+IN_PROC_BROWSER_TEST_F(ArchiveReopenTest,
+                       PRE_ALastWindowClosedBeforeAQuitIsNotArchived) {
+  Profile* const profile = browser()->GetProfile();
+  Open("lone-a.test");
+  Open("lone-b.test");
+  tabs::TabInterface* const closed = Open("lone-closed.test");
+  const tabs::TabHandle closed_handle = closed->GetHandle();
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);  // ⌘W
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !closed_handle.Get(); }));
+
+  BrowserWindowInterface* const private_window = CreateIncognitoBrowser();
+  ASSERT_TRUE(private_window);
+  CloseBrowserSynchronously(browser());
+  SetBrowser(private_window);
+
+  const sessions::tab_restore::Window* const window =
+      WindowWith("lone-a.test", profile);
+  ASSERT_TRUE(window) << "the close was not recorded";
+  EXPECT_EQ(stedding::kArchiveReopensUnlessAWindowOpens, MarkOf(*window))
+      << "the profile's last window was taken for a final close";
+  EXPECT_FALSE(stedding::NextLaunchReopened(*window))
+      << "⇧⌘T with no window open must still bring the window back";
+  sessions::TabRestoreService* const list =
+      TabRestoreServiceFactory::GetForProfile(profile);
+  ASSERT_TRUE(list);
+  EXPECT_EQ(list->entries().begin(), stedding::MostRecentClose(list->entries()))
+      << "the window is the most recent close";
+}
+
+// The launch after it: the session brought the window back. None of its tabs
+// is in the archive or the bar; ⇧⌘T reopens the tab closed with ⌘W, not a
+// second copy of the window, and the Recently Closed menu does not offer it.
+IN_PROC_BROWSER_TEST_F(ArchiveReopenTest,
+                       ALastWindowClosedBeforeAQuitIsNotArchived) {
+  ASSERT_NO_FATAL_FAILURE(WaitForTheLastRunsEntries());
+  ASSERT_TRUE(Find("lone-a.test")) << "the session did not come back";
+  ASSERT_TRUE(Find("lone-b.test"));
+  EXPECT_EQ(0u, ArchiveRowsFor("lone-a.test"))
+      << "a tab open again is listed as closed";
+  EXPECT_EQ(0u, ArchiveRowsFor("lone-b.test"));
+  EXPECT_EQ(0u, BarArchivedRowsFor(u"lone-a"))
+      << "the bar lists the open tab as archived";
+  EXPECT_EQ(1u, ArchiveRowsFor("lone-closed.test"));
+  const sessions::tab_restore::Window* const window = WindowWith("lone-a.test");
