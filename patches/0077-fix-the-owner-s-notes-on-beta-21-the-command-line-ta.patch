+    LOG(INFO) << "[motion] space switch: " << meter.BracketBreakdown();
+  }
+  // What a re-theme of the window costs, which a switch between two Spaces
+  // of different colours asks for (spaces B36).
+  for (const SkColor color : {SK_ColorRED, SK_ColorBLUE}) {
+    widget()->SetUserColorOverride(color);
+    base::ElapsedTimer theming;
+    widget()->ThemeChanged();
+    LOG(INFO) << "[motion] window theme change: "
+              << theming.Elapsed().InMillisecondsF() << " ms";
+  }
+}
+
+// The layer named `name` at or under `layer`, or null.
+ui::Layer* FindLayerNamed(ui::Layer* layer, std::string_view name) {
+  if (layer->name() == name) {
+    return layer;
+  }
+  for (ui::Layer* const child : layer->children()) {
+    if (ui::Layer* const found = FindLayerNamed(child, name)) {
+      return found;
+    }
+  }
+  return nullptr;
+}
+
+// How many images `buffer` draws, nested recordings included, that cover at
+// least half of `size` (DIPs) each way: a picture of the whole list, not a
+// favicon. An image drawn at its own size is counted by its pixels, which are
+// at least its DIPs.
+int LargeImages(const cc::PaintOpBuffer& buffer, const gfx::Size& size) {
+  int count = 0;
+  for (const cc::PaintOp& op : buffer) {
+    if (op.GetType() == cc::PaintOpType::kDrawImageRect) {
+      const SkRect& dst = static_cast<const cc::DrawImageRectOp&>(op).dst;
+      if (dst.width() >= size.width() / 2.0f &&
+          dst.height() >= size.height() / 2.0f) {
+        ++count;
+      }
+    } else if (op.GetType() == cc::PaintOpType::kDrawImage) {
+      const cc::PaintImage& image =
+          static_cast<const cc::DrawImageOp&>(op).image;
+      if (image.width() >= size.width() / 2 &&
+          image.height() >= size.height() / 2) {
+        ++count;
+      }
+    } else if (op.GetType() == cc::PaintOpType::kDrawRecord) {
+      count += LargeImages(
+          static_cast<const cc::DrawRecordOp&>(op).record.buffer(), size);
+    }
+  }
+  return count;
+}
+
+// spaces B32, B36, motion O7 (by hand on the Mac, 2026-10-21, seen once): a
+// Space switch just after the sidebar's motions slides like any other. The
+// pass that saw it collapsed, expanded and collapsed the sidebar, opened the
+// rail's hover overlay, expanded it and switched with Ctrl+2: the title
+// changed at once, the old rows stood still for about 430 ms, then the new
+// list was there in one frame. Here the same motions, then switches, at once,
+// a while after, and to a Space whose page is asleep and loads as it is
+// shown: each draws the Space left at the list's size, starts the list's
+// slide, and has the compositor present frames all through it, none more than
+// 100 ms after the one before.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest,
+                       ASpaceSwitchAfterTheSidebarsMotionsSlides) {
+  if (!Animates()) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId home = model->active_id();
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(8));
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->SetActiveSpace(work);
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(2));
+  model->SetActiveSpace(home);
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+
+  browser()->GetProfile()->GetPrefs()->SetInteger(
+      stedding::prefs::kSidebarHoverDelayMs, 50);
+  vertical_tab_strip_state_controller()->SetExpandOnHoverEnabled(true);
+  // The played pointer stands in for the machine's real one (BACKLOG S-221).
+  stedding::test::PointerStandIn pointer(region());
+  const auto collapse = [&](bool collapsed) {
+    vertical_tab_strip_state_controller()->RequestCollapse(collapsed);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !StripAnimating(); }));
+    views::test::RunScheduledLayout(widget());
+  };
+  const auto hover_overlay = [&]() {
+    pointer.On();
+    region()->OnMouseEntered(
+        MouseEvent(ui::EventType::kMouseEntered, region()));
+    region()->OnMouseMoved(MouseEvent(ui::EventType::kMouseMoved, region()));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return region()->is_expanded_on_hover() && !StripAnimating();
+    }));
+    pointer.Off();
+    region()->OnMouseExited(MouseEvent(ui::EventType::kMouseExited, region()));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return !region()->is_expanded_on_hover() && !StripAnimating();
+    }));
+  };
+  const auto motions = [&]() {
+    ASSERT_NO_FATAL_FAILURE(collapse(true));
+    ASSERT_NO_FATAL_FAILURE(collapse(false));
+    ASSERT_NO_FATAL_FAILURE(collapse(true));
+    ASSERT_NO_FATAL_FAILURE(hover_overlay());
+    ASSERT_NO_FATAL_FAILURE(collapse(false));
+  };
+  const auto timed_switch = [&](const spaces::SpaceId& to,
+                                const std::string& name) {
+    SCOPED_TRACE(name);
+    views::View* const list = strip()->unpinned_tabs_scroll_view();
+    ASSERT_TRUE(list && list->IsDrawn());
+    const gfx::Size size = list->size();
+    ASSERT_FALSE(size.IsEmpty()) << "the list has no size";
+    FrameMeter meter;
+    meter.Start(compositor());
+    const base::TimeTicks start = base::TimeTicks::Now();
+    model->SetActiveSpace(to);
+    const base::TimeDelta switch_time = base::TimeTicks::Now() - start;
+    ASSERT_TRUE(list->layer() && list->layer()->parent());
+    ui::Layer* const snapshot =
+        FindLayerNamed(list->layer()->parent(), "SpaceSlideSnapshot");
+    ASSERT_TRUE(snapshot) << "no layer for the Space left";
+    EXPECT_EQ(list->layer()->bounds(), snapshot->bounds())
+        << "the Space left was drawn at another size than the list's";
+    EXPECT_TRUE(list->layer()->GetAnimator()->is_animating())
+        << "the new list does not slide in";
+    base::TimeTicks slid_at;
+    ASSERT_TRUE(RunUntilSettled(meter, base::BindLambdaForTesting([&]() {
+      const bool slid = !list->layer()->GetAnimator()->is_animating();
+      if (slid && slid_at.is_null()) {
+        slid_at = base::TimeTicks::Now();
+      }
+      return slid;
+    })));
+    meter.Stop();
+    Log(meter, base::StringPrintf("%s (the switch itself %.2f ms)",
+                                  name.c_str(),
+                                  switch_time.InMillisecondsF()));
+    // The frames that reached the screen from the switch to the slide's end.
+    int during = 0;
+    base::TimeDelta longest;
+    base::TimeTicks last = start;
+    for (const base::TimeTicks at : meter.presented()) {
+      if (at < start) {
+        continue;
+      }
+      longest = std::max(longest, at - last);
+      last = at;
+      if (at <= slid_at) {
+        ++during;
+      }
+    }
+    LOG(INFO) << "[motion] " << name << ": slid in "
+              << (slid_at - start).InMillisecondsF() << " ms, " << during
+              << " frames presented, the longest wait "
+              << longest.InMillisecondsF() << " ms";
+    EXPECT_LT(longest, base::Milliseconds(100))
+        << "the slide stood still and then cut to its end";
+    EXPECT_GE(during, 4) << "the slide was not drawn";
+  };
+
+  ASSERT_NO_FATAL_FAILURE(motions());
+  ASSERT_NO_FATAL_FAILURE(timed_switch(work, "the first switch, at once"));
+  ASSERT_NO_FATAL_FAILURE(timed_switch(home, "back"));
+  ASSERT_NO_FATAL_FAILURE(motions());
+  {
+    FrameMeter wait;
+    wait.Start(compositor());
+    ASSERT_TRUE(RunFrames(wait, 60));
+    wait.Stop();
+  }
+  ASSERT_NO_FATAL_FAILURE(timed_switch(work, "after a second"));
+  ASSERT_NO_FATAL_FAILURE(timed_switch(home, "back again"));
+
+  // As in that pass, the Space entered shows a page that is not loaded, as
+  // a tab restored asleep is: the switch loads it.
+  std::vector<tabs::TabInterface*> asleep;
+  for (int i = 0; i < tab_strip_model()->count(); ++i) {
+    tabs::TabInterface* const tab = tab_strip_model()->GetTabAtIndex(i);
+    if (model->SpaceForTab(tab) == work) {
+      asleep.push_back(tab);
+    }
+  }
+  ASSERT_FALSE(asleep.empty());
+  stedding::SleepTabList(asleep);
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return std::ranges::all_of(asleep, [](tabs::TabInterface* tab) {
+      return tab->GetContents()->WasDiscarded();
+    });
+  }));
+  ASSERT_NO_FATAL_FAILURE(motions());
+  ASSERT_NO_FATAL_FAILURE(
+      timed_switch(work, "to a Space whose page sleeps, at once"));
+}
+
+// motion O7: the Space being left slides out as a recording of what its rows
+// painted, which the compositor rasters with the rest of the window; the
+// switch draws no picture of the list on the UI thread. The recording shows
+// the rows.
+IN_PROC_BROWSER_TEST_F(MotionFramesTest, TheSpaceLeftIsARecordingOfItsRows) {
+  if (!Animates()) {
+    GTEST_SKIP() << "the machine asks for reduced motion";
+  }
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  const spaces::SpaceId first = model->active_id();
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(6));
+  const spaces::SpaceId second = model->AddSpace("Two", SK_ColorBLUE)->id();
+  model->SetActiveSpace(second);
+  ASSERT_NO_FATAL_FAILURE(OpenTitledTabs(2));
+  model->SetActiveSpace(first);
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  views::View* const list = strip()->unpinned_tabs_scroll_view();
+  ASSERT_TRUE(list);
+
+  model->SetActiveSpace(second);
+  ASSERT_TRUE(list->layer() && list->layer()->parent());
+  ui::Layer* const snapshot =
+      FindLayerNamed(list->layer()->parent(), "SpaceSlideSnapshot");
+  ASSERT_TRUE(snapshot) << "no layer for the Space left";
+  ASSERT_TRUE(snapshot->delegate());
+  const float scale = snapshot->device_scale_factor();
+  const bool pixel_canvas = compositor()->is_pixel_canvas();
+
+  // Painted as the compositor paints it: no picture of the list in it.
+  auto ops = base::MakeRefCounted<cc::DisplayItemList>();
+  {
+    ui::PaintContext context(ops.get(), scale, gfx::Rect(snapshot->size()),
+                             pixel_canvas);
+    snapshot->delegate()->OnPaintLayer(context);
+  }
+  ops->Finalize();
+  EXPECT_EQ(0, LargeImages(ops->paint_op_buffer(), snapshot->size()))
+      << "the Space left was drawn as a bitmap on the UI thread";
+
+  // And rastered, it shows the rows: ink over a part of it.
+  SkBitmap bitmap;
+  {
+    ui::CanvasPainter painter(&bitmap, snapshot->size(), scale,
+                              SK_ColorTRANSPARENT, pixel_canvas);
+    snapshot->delegate()->OnPaintLayer(painter.context());
+  }
+  ASSERT_FALSE(bitmap.drawsNothing());
+  int inked = 0;
+  for (int y = 0; y < bitmap.height(); ++y) {
+    for (int x = 0; x < bitmap.width(); ++x) {
+      inked += SkColorGetA(bitmap.getColor(x, y)) > 0;
+    }
+  }
+  EXPECT_GT(inked, bitmap.width() * bitmap.height() / 100)
+      << "the recording of the Space left draws nothing";
+}
