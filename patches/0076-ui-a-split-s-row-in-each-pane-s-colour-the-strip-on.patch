+// tabs R52: each half of a split is as wide as any other tab, so a split
+// takes two tabs' room and its titles are not cut beside wide tabs; it
+// shrinks with the others when the strip fills. Chromium gave the two halves
+// one tab's room, and "Left pane" read "Left par" beside a wide "Inbox".
+IN_PROC_BROWSER_TEST_F(HorizontalStripTest, ASplitHalfIsAsWideAsATab) {
+  browser_view()->GetWidget()->SetBounds(gfx::Rect(
+      display::Screen::Get()->GetPrimaryDisplay().work_area().origin(),
+      gfx::Size(1600, 900)));
+  const auto open_titled = [&](const std::string& host) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title2.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  };
+  open_titled("one.test");
+  open_titled("two.test");
+  open_titled("three.test");
+  open_titled("left.test");
+  open_titled("right.test");
+  const int left = tab_strip_model()->count() - 2;
+  tab_strip_model()->ActivateTabAt(left);
+  tab_strip_model()->AddToNewSplit(
+      {left + 1}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  tabs::TabInterface* const left_half = tab_strip_model()->GetTabAtIndex(left);
+  tabs::TabInterface* const right_half =
+      tab_strip_model()->GetTabAtIndex(left + 1);
+  ASSERT_TRUE(left_half->IsSplit());
+  // Tabs opened later can land before the split: the halves are found by tab.
+  const auto half = [&](tabs::TabInterface* tab) {
+    return tab_strip_model()->GetIndexOfTab(tab);
+  };
+  ShowStrip(Scheme::kLight);
+  const auto settle = [&]() {
+    strip()->StopAnimating();
+    views::test::RunScheduledLayout(browser_view());
+  };
+  const auto width_of = [&](int index) { return strip()->tab_at(index)->width(); };
+  const auto title_fits = [&](int index) {
+    TabTitle* const title = FindFirst<TabTitle>(strip()->tab_at(index));
+    return title && title->GetVisible() && !title->GetText().empty() &&
+           title->width() >= title->GetPreferredSize({}).width();
+  };
+  {
+    SCOPED_TRACE("a wide strip");
+    settle();
+    const int plain = width_of(1);
+    EXPECT_NEAR(plain, width_of(half(left_half)), 1);
+    EXPECT_NEAR(plain, width_of(half(right_half)), 1);
+    for (const int index : {1, half(left_half), half(right_half)}) {
+      EXPECT_TRUE(title_fits(index)) << "the title of tab " << index
+                                     << " is cut";
+    }
+  }
+  {
+    SCOPED_TRACE("a crowded strip");
+    const int preferred = width_of(1);
+    for (int i = 0; i < 24; ++i) {
+      chrome::AddTabAt(browser(), GURL(url::kAboutBlankURL), -1,
+                       /*foreground=*/false);
+    }
+    // Every tab compared is inactive: the active one keeps a minimum of its
+    // own.
+    tab_strip_model()->ActivateTabAt(tab_strip_model()->count() - 1);
+    settle();
+    const int plain = width_of(1);
+    EXPECT_LT(plain, preferred) << "the strip did not fill";
+    EXPECT_NEAR(plain, width_of(half(left_half)), 1);
+    EXPECT_NEAR(plain, width_of(half(right_half)), 1);
+  }
+}
