+// The indices of `tab` and of every tab that has to move with it. A split
+// moves whole: a pane moved on its own leaves a split of one tab behind.
+std::vector<int> IndicesMovingWith(const TabStripModel& strip,
+                                   const tabs::TabInterface& tab) {
+  std::vector<int> indices;
+  if (const std::optional<split_tabs::SplitTabId> split = tab.GetSplit()) {
+    for (const tabs::TabInterface* const pane :
+         strip.GetSplitData(*split)->ListTabs()) {
+      indices.push_back(strip.GetIndexOfTab(pane));
+    }
+    std::ranges::sort(indices);
+  } else {
+    indices.push_back(strip.GetIndexOfTab(&tab));
+  }
+  return indices;
+}
+
+// Every folder under `collection`, at any depth, by id.
+void CollectFolders(const tabs::TabCollection* collection,
+                    std::map<std::string, tabs::FolderTabCollection*>* out) {
+  for (const tabs::Child& child : collection->GetChildren()) {
+    const auto* const holder =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (!holder) {
+      continue;
+    }
+    tabs::TabCollection* const nested = holder->get();
+    if (nested->type() == tabs::TabCollection::Type::FOLDER) {
+      auto* const folder = static_cast<tabs::FolderTabCollection*>(nested);
+      out->emplace(folder->id().ToString(), folder);
+    }
+    CollectFolders(nested, out);
+  }
+}
+
+// The window's folders by id. The strip hands out its tree read-only; the
+// folders go back to it, to the strip's own folder calls.
+std::map<std::string, tabs::FolderTabCollection*> FoldersById(
+    const TabStripModel& strip) {
+  std::map<std::string, tabs::FolderTabCollection*> folders;
+  CollectFolders(strip.Root(), &folders);
+  return folders;
+}
