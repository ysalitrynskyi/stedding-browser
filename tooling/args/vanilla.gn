# Stedding — vanilla comparison build (macOS arm64).
#
# Identical to official.gn on purpose: QUALITY.md budgets are overheads relative to
# vanilla Chromium at the same pin and configuration, so the only variable allowed
# to differ is the patch series. Build it from the checkout detached at the pin
# with branding reverted (docs/perf/README.md); build-chromium checks the tree.

target_os  = "mac"
target_cpu = "arm64"

is_official_build  = true
is_component_build = false

# Shipping builds are stripped; symbols are archived separately when we start
# symbolising crash reports (not before M7 — see docs/PRIVACY.md on crash reporting).
symbol_level       = 0
blink_symbol_level = 0
v8_symbol_level    = 0

use_remoteexec = false

# Proprietary codecs: H.264, AAC, MP3, and the MP4 container.
#
# Upstream defaults these off, which is why a vanilla Chromium cannot play a
# large share of the web's video. A browser people are asked to use every day
# has to play what the web actually serves, so they are on.
#
# This is a licensing position, not a build flag. Distributing binaries that
# decode AVC/H.264 and AAC carries patent obligations, administered by Via LA.
# The decision, and who owns it, is recorded in
# docs/decisions/0008-proprietary-codecs.md.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
