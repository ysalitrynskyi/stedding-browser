+// Arc's archive of `count` pages, none in a Space: p0 archived last, each
+// one after it a second earlier.
+std::string ArchiveOfW2B09(size_t count) {
+  std::string items;
+  for (size_t i = 0; i < count; ++i) {
+    base::StrAppend(
+        &items,
+        {i ? ", " : "", "\"item-", base::NumberToString(i),
+         "\", {\"reason\": \"auto\", \"archivedAt\": ",
+         base::NumberToString(800000000 - static_cast<int64_t>(i)),
+         ", \"sidebarItem\": {\"data\": {\"tab\": {\"savedURL\": "
+         "\"https://p",
+         base::NumberToString(i),
