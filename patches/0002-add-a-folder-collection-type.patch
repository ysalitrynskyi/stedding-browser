+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class TabCollectionNode;
+
+// Renders a FolderTabCollection in the tab strip.
+//
+// Deliberately minimal for now: it is a plain container that lays its children
+// out vertically, so a folder appears in the sidebar as an indented run of its
+// tabs. The header row, the collapse affordance and the drop target belong with
+// the sidebar work and are not here yet — a folder that renders as a bare
+// container is obviously unfinished, which is better than one that looks
+// finished and behaves wrongly.
+class FolderView : public views::View {
+  METADATA_HEADER(FolderView, views::View)
+
+ public:
+  explicit FolderView(TabCollectionNode* collection_node);
+  FolderView(const FolderView&) = delete;
+  FolderView& operator=(const FolderView&) = delete;
+  ~FolderView() override;
+
+ private:
+  const raw_ptr<TabCollectionNode> collection_node_;
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_TABS_COMMON_FOLDER_VIEW_H_
