+class PrefService;
+
+namespace stedding::shortcuts {
+
+// docs/features/shortcuts.md Z10, Z11: reads the user's chords from Local
+// State once and keeps them in force: every change of the preference resolves
+// them again (SetCurrent), every window reloads its accelerators through the
+// change callbacks, and on the Mac the menu bar takes them. Called once at
+// startup, after Local State is loaded and before the Mac's menu is built
+// and any window opens. Safe to call again; later calls do nothing.
+void EnsureShortcutsInstalled(PrefService* local_state);
+// Lets go of Local State as the browser shuts down, before it is gone: the
+// watch is a pointer to it.
+void StopWatchingShortcuts();
+
+// The rows as the block shows them, from the stored value.
+RowState RowStateOf(PrefService* local_state, const Entry& entry);
+
+// The block's edits, written to Local State; the change applies through the
+// preference's observer before they return.
+CheckResult CheckShortcut(PrefService* local_state,
+                          const Entry& entry,
+                          const Chord& chord,
+                          const OutsideHolders& outside);
+CheckResult AddShortcut(PrefService* local_state,
+                        const Entry& entry,
+                        const Chord& chord,
+                        bool replace,
+                        const OutsideHolders& outside);
+bool RemoveShortcut(PrefService* local_state,
+                    const Entry& entry,
+                    const Chord& chord);
+bool SetShortcutOff(PrefService* local_state, const Entry& entry, bool off);
+bool ResetShortcut(PrefService* local_state, const Entry& entry);
+void ResetAllShortcuts(PrefService* local_state);
+// Z23: the layout of the number keys.
+bool SetNumberKeys(PrefService* local_state, NumberKeys layout);
+
+// Z15 on the Mac: whether macOS has `chord` enabled as one of its own
+// shortcuts (System Settings, Keyboard, Keyboard Shortcuts), read from this
+// Mac alone. False elsewhere.
+bool IsSystemHotKey(const Chord& chord);
+
+// Replaces the system's shortcuts IsSystemHotKey reads, for a test; null
+// reads the system's again.
+void SetSystemHotKeysForTesting(const std::vector<Chord>* hot_keys);
+
+}  // namespace stedding::shortcuts
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SHORTCUT_SERVICE_H_
