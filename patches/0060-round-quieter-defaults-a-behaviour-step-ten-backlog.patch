+
+// The open sidebar's handle: 12 DIP wide, reaching 6 DIP past its edge over
+// the card's gutter (sidebar Y18). Events land at its middle, in its own
+// coordinates.
+constexpr int kHandleWidth = 12;
+constexpr int kHandleHeight = 240;
+constexpr int kReach = 6;
+constexpr gfx::Point kMiddle(kHandleWidth / 2, kHandleHeight / 2);
+constexpr int kButtons = ui::EF_LEFT_MOUSE_BUTTON | ui::EF_RIGHT_MOUSE_BUTTON;
+
+// Hears the drags, as the sidebar does.
+class RecordingDelegate : public views::ResizeAreaDelegate {
+ public:
+  void OnResize(int resize_amount, bool done_resizing) override {
+    ++resizes;
+    last_amount = resize_amount;
+    done = done_resizing;
+  }
+
+  int resizes = 0;
+  int last_amount = 0;
+  bool done = false;
+};
+
+// sidebar Y22. The handle's handlers are called directly with events built
+// here, as the root view would call them, so nothing depends on the real
+// cursor or an event generator (which ResizeArea's own tests turn off on the
+// Mac). The window is never shown, so no real pointer reaches it; the rest is
+// timed on the mock clock.
+class SidebarResizeHandleTest : public views::ViewsTestBase {
+ public:
+  SidebarResizeHandleTest()
+      : views::ViewsTestBase(
+            base::test::TaskEnvironment::TimeSource::MOCK_TIME) {}
+
+ protected:
+  void SetUp() override {
+    views::ViewsTestBase::SetUp();
+    widget_ = CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    widget_->SetBounds(gfx::Rect(0, 0, 300, 260));
+    auto contents = std::make_unique<views::View>();
+    handle_ = contents->AddChildView(std::make_unique<SidebarResizeHandle>(
+        &delegate_, ui::kColorSysOutline,
+        base::BindRepeating(&SidebarResizeHandleTest::OnReset,
+                            base::Unretained(this))));
+    handle_->SetBounds(100, 0, kHandleWidth, kHandleHeight);
+    handle_->SetReach(kReach);
+    widget_->SetContentsView(std::move(contents));
+  }
+
+  void TearDown() override {
+    handle_ = nullptr;
+    widget_.reset();
+    views::ViewsTestBase::TearDown();
+  }
+
+  // A mouse event at the handle's middle, moved `dx` along the resize axis.
+  static ui::MouseEvent MakeMouse(ui::EventType type,
+                                  int flags,
+                                  int changed_button_flags,
+                                  int dx = 0) {
+    const gfx::Point point(kMiddle.x() + dx, kMiddle.y());
+    return ui::MouseEvent(type, point, point, base::TimeTicks::Now(), flags,
+                          changed_button_flags);
+  }
+
+  void Enter() {
+    handle_->OnMouseEntered(
+        MakeMouse(ui::EventType::kMouseEntered, ui::EF_NONE, ui::EF_NONE));
+  }
+  void Move() {
+    handle_->OnMouseMoved(
+        MakeMouse(ui::EventType::kMouseMoved, ui::EF_NONE, ui::EF_NONE));
+  }
+  void Exit() {
+    handle_->OnMouseExited(
+        MakeMouse(ui::EventType::kMouseExited, ui::EF_NONE, ui::EF_NONE));
+  }
+  bool Press(int flags) {
+    return handle_->OnMousePressed(
+        MakeMouse(ui::EventType::kMousePressed, flags, flags & kButtons));
+  }
+  void Drag(int dx) {
+    handle_->OnMouseDragged(MakeMouse(ui::EventType::kMouseDragged,
+                                      ui::EF_LEFT_MOUSE_BUTTON, ui::EF_NONE,
+                                      dx));
+  }
+  void Release(int flags, int dx = 0) {
+    handle_->OnMouseReleased(MakeMouse(ui::EventType::kMouseReleased, flags,
+                                       flags & kButtons, dx));
+  }
+  // A left click; `click_flags` marks it as the second or third of a run.
+  void Click(int click_flags) {
+    Press(ui::EF_LEFT_MOUSE_BUTTON | click_flags);
+    Release(ui::EF_LEFT_MOUSE_BUTTON | click_flags);
+  }
+  // A tap that is the `tap_count`th in a run; true if the handle took it.
+  bool Tap(int tap_count) {
+    ui::GestureEventDetails details(ui::EventType::kGestureTap);
+    details.set_tap_count(tap_count);
+    ui::GestureEvent tap(kMiddle.x(), kMiddle.y(), ui::EF_NONE,
+                         base::TimeTicks::Now(), details);
+    handle_->OnGestureEvent(&tap);
+    return tap.handled();
+  }
+  void Rest(base::TimeDelta delta) { task_environment()->FastForwardBy(delta); }
+
+  void OnReset() { ++resets_; }
+
+  RecordingDelegate delegate_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<SidebarResizeHandle> handle_ = nullptr;
+  int resets_ = 0;
+};
+
+// The bar shows once the pointer has stayed on the edge for the rest delay,
+// goes the moment it leaves, and never shows for a pointer that only crosses
+// the edge.
+TEST_F(SidebarResizeHandleTest, TheBarShowsAfterARest) {
+  Enter();
+  EXPECT_FALSE(handle_->IsBarShowing());
+  Rest(SidebarResizeHandle::kRestDelay - base::Milliseconds(1));
+  EXPECT_FALSE(handle_->IsBarShowing()) << "not before the rest is over";
+  Rest(base::Milliseconds(1));
+  EXPECT_TRUE(handle_->IsBarShowing());
+  Exit();
+  EXPECT_FALSE(handle_->IsBarShowing()) << "leaving the edge hides it at once";
+
+  // A pointer on its way across the edge.
+  Enter();
+  Rest(SidebarResizeHandle::kRestDelay / 2);
+  Exit();
+  Rest(SidebarResizeHandle::kRestDelay * 2);
+  EXPECT_FALSE(handle_->IsBarShowing()) << "a crossing shows nothing";
+}
+
+// A left press shows the bar with no wait, and it stays through the drag and
+// after the release until the pointer leaves the edge. Only a left press
+// does: the handle does not take the others.
+TEST_F(SidebarResizeHandleTest, APressShowsTheBarAtOnceAndADragKeepsIt) {
+  EXPECT_FALSE(Press(ui::EF_RIGHT_MOUSE_BUTTON));
+  EXPECT_FALSE(handle_->IsBarShowing());
+
+  ASSERT_TRUE(Press(ui::EF_LEFT_MOUSE_BUTTON));
+  EXPECT_TRUE(handle_->IsBarShowing()) << "a press shows it with no wait";
+  Drag(-20);
+  EXPECT_GT(delegate_.resizes, 0) << "the drag reaches the sidebar";
+  EXPECT_EQ(-20, delegate_.last_amount);
+  EXPECT_FALSE(delegate_.done);
+  EXPECT_TRUE(handle_->IsBarShowing()) << "and the bar stays through it";
+
+  Release(ui::EF_LEFT_MOUSE_BUTTON, -20);
+  EXPECT_TRUE(delegate_.done);
+  EXPECT_EQ(-20, delegate_.last_amount);
+  EXPECT_EQ(0, resets_) << "a drag is not a reset";
+  EXPECT_TRUE(handle_->IsBarShowing()) << "it stays while the pointer does";
+  Exit();
+  EXPECT_FALSE(handle_->IsBarShowing());
+}
+
+// A left double click resets the width, once, and the bar goes with the edge
+// that moved out from under the pointer. A single click, a right double click
+// and a triple click do not.
+TEST_F(SidebarResizeHandleTest, ADoubleClickResetsTheWidth) {
+  Click(ui::EF_NONE);
+  EXPECT_EQ(0, resets_) << "a single click";
+
+  Click(ui::EF_IS_DOUBLE_CLICK);
+  EXPECT_EQ(1, resets_);
+  EXPECT_EQ(0, delegate_.resizes) << "nothing was dragged on the way";
+  EXPECT_FALSE(handle_->IsBarShowing());
+
+  // The pointer is still on the edge: its next move starts a new rest.
+  Move();
+  EXPECT_FALSE(handle_->IsBarShowing());
+  Rest(SidebarResizeHandle::kRestDelay);
+  EXPECT_TRUE(handle_->IsBarShowing());
+
+  EXPECT_FALSE(Press(ui::EF_RIGHT_MOUSE_BUTTON | ui::EF_IS_DOUBLE_CLICK));
+  Release(ui::EF_RIGHT_MOUSE_BUTTON | ui::EF_IS_DOUBLE_CLICK);
+  EXPECT_EQ(1, resets_) << "a right double click";
+  Click(ui::EF_IS_TRIPLE_CLICK);
+  EXPECT_EQ(1, resets_) << "a triple click";
+}
+
+// A double click whose second press drags stays a resize, as with Chromium's
+// split-view handle.
+TEST_F(SidebarResizeHandleTest, ADoubleClickThatDragsIsAResize) {
+  Click(ui::EF_NONE);
+  ASSERT_TRUE(Press(ui::EF_LEFT_MOUSE_BUTTON | ui::EF_IS_DOUBLE_CLICK));
+  Drag(-20);
+  Release(ui::EF_LEFT_MOUSE_BUTTON | ui::EF_IS_DOUBLE_CLICK, -20);
+  EXPECT_TRUE(delegate_.done) << "the drag ends as any drag does";
+  EXPECT_EQ(-20, delegate_.last_amount);
+  EXPECT_EQ(0, resets_) << "and leaves the width where it was dragged";
+}
+
+// On a touch screen a double tap does what a double click does.
+TEST_F(SidebarResizeHandleTest, ADoubleTapResetsTheWidth) {
+  EXPECT_FALSE(Tap(1));
+  EXPECT_EQ(0, resets_) << "a single tap";
+  EXPECT_TRUE(Tap(2)) << "the handle takes the double tap";
+  EXPECT_EQ(1, resets_);
+}
+
+// The bar lies in the middle of the stretch the handle reaches over, toward
+// the page: the card's gutter. Where that stretch is narrower than the bar
+// (no gutter), the bar runs along the inside of the handle's trailing edge.
+// It is a picture on a layer of its own that takes no events and is not in
+// the accessibility tree.
+TEST_F(SidebarResizeHandleTest, TheBarLiesOnTheReachTowardThePage) {
+  views::View* const bar = handle_->bar_for_testing();
+  EXPECT_TRUE(bar->layer());
+  EXPECT_FALSE(bar->GetCanProcessEventsWithinSubtree());
+  EXPECT_TRUE(bar->GetViewAccessibility().GetIsIgnored());
+
+  // 12 + (6 - 3) / 2, and the edge's height less 8 DIP at each end.
+  EXPECT_EQ(gfx::Rect(13, 8, 3, 224), bar->GetMirroredBounds());
+  EXPECT_GE(bar->GetMirroredBounds().x(), kHandleWidth) << "past the handle";
+  EXPECT_LE(bar->GetMirroredBounds().right(), kHandleWidth + kReach)
+      << "inside the reach";
+
+  handle_->SetReach(0);
+  EXPECT_EQ(gfx::Rect(9, 8, 3, 224), bar->GetMirroredBounds())
+      << "no gutter: inside the trailing edge";
+
+  // The rail's handle is 2 DIP wide.
+  handle_->SetBounds(100, 0, 2, kHandleHeight);
+  handle_->SetReach(kReach);
+  EXPECT_EQ(gfx::Rect(3, 8, 3, 224), bar->GetMirroredBounds());
+  handle_->SetReach(2);
+  EXPECT_EQ(gfx::Rect(-1, 8, 3, 224), bar->GetMirroredBounds())
+      << "a reach narrower than the bar counts as none";
+  handle_->SetReach(0);
+  EXPECT_EQ(gfx::Rect(-1, 8, 3, 224), bar->GetMirroredBounds());
+
+  // The bar follows the edge's height, and a very short edge has none.
+  handle_->SetBounds(100, 0, 2, 100);
+  EXPECT_EQ(84, bar->height());
+  handle_->SetBounds(100, 0, 2, 10);
+  EXPECT_EQ(0, bar->height());
+}
+
+// Right to left the sidebar is on the right, and the bar lies left of the
+// handle, on the gutter against the card.
+TEST_F(SidebarResizeHandleTest, RightToLeftTheBarIsOnTheLeft) {
+  base::test::ScopedRestoreICUDefaultLocale locale("he");
+  ASSERT_TRUE(handle_->GetMirrored());
+  const gfx::Rect bar = handle_->bar_for_testing()->GetMirroredBounds();
+  EXPECT_EQ(-4, bar.x());
+  EXPECT_EQ(-1, bar.right());
+  EXPECT_GE(bar.x(), -kReach) << "inside the reach";
+}
+
+// A handle that goes away while its bar shows, or while a rest is under way,
+// comes back with no bar and no rest: the sidebar hidden, a rail that expands
+// on hover, full screen.
+TEST_F(SidebarResizeHandleTest, AHiddenHandleForgetsTheRest) {
+  Enter();
+  Rest(SidebarResizeHandle::kRestDelay);
+  ASSERT_TRUE(handle_->IsBarShowing());
+  handle_->SetVisible(false);
+  EXPECT_FALSE(handle_->IsBarShowing());
+  handle_->SetVisible(true);
+  EXPECT_FALSE(handle_->IsBarShowing()) << "the handle comes back bare";
+  EXPECT_FALSE(handle_->bar_for_testing()->layer()->visible())
+      << "showing the handle again does not show the bar's layer";
+
+  Enter();
+  Rest(SidebarResizeHandle::kRestDelay / 2);
+  handle_->SetVisible(false);
+  handle_->SetVisible(true);
+  Rest(SidebarResizeHandle::kRestDelay);
+  EXPECT_FALSE(handle_->IsBarShowing()) << "the rest stopped with the handle";
+
+  // The pointer's next move on the edge starts a new rest.
+  Move();
+  Rest(SidebarResizeHandle::kRestDelay);
+  EXPECT_TRUE(handle_->IsBarShowing());
+}
