+
+  void OnTabStripModelChanged(
+      TabStripModel* strip,
+      const TabStripModelChange& change,
+      const TabStripSelectionChange& selection) override {
+    if (tabs::TabInterface* const active = strip->GetActiveTab()) {
+      shown_.insert(active->GetHandle());
+    }
+  }
+
+  bool Showed(const tabs::TabInterface* tab) const {
+    return shown_.contains(tab->GetHandle());
+  }
