+// Pn9: a download in progress pauses, resumes and is cancelled from its
+// row.
+IN_PROC_BROWSER_TEST_F(SidebarPanelsTest, DownloadsRowVerbs) {
+  download::DownloadItem* const item = StartSlowDownload();
+  ASSERT_TRUE(item);
+  const std::string id = base::NumberToString(item->GetId());
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_DOWNLOADS));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kDownloads));
+  ASSERT_TRUE(WaitForRows(1));
+
+  const auto press = [&](const std::string& action) {
+    return content::ExecJs(
+        panel_page(),
+        RowFor("id", id) +
+            content::JsReplace(
+                ".querySelector('[data-action=\"' + $1 + '\"]')", action) +
+            ".click()");
+  };
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(),
+                           "!!" + RowFor("id", id) +
+                               ".querySelector('[data-action=pause]')")
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(press("pause"));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return item->IsPaused(); }))
+      << "Pause did not pause it";
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(),
+                           "!!" + RowFor("id", id) +
+                               ".querySelector('[data-action=resume]')")
+        .ExtractBool();
+  }));
+  ASSERT_TRUE(press("resume"));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !item->IsPaused(); }))
+      << "Resume did not resume it";
+  ASSERT_TRUE(press("cancel"));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return item->GetState() == download::DownloadItem::CANCELLED;
+  })) << "Cancel did not cancel it";
+}
