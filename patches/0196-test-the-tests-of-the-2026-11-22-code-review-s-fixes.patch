+// windows G10 (BACKLOG S-323): with the New Tab page at startup, a launch
+// brings back each normal window's sidebar alone and leaves its loose tabs
+// closed.
+class StartupKeepsTheSidebarB06Test : public InProcessBrowserTest {
+ public:
+  // A launch with no address of its own, as a person's is: the fixture's
+  // about:blank would take the place of the New Tab page.
+  StartupKeepsTheSidebarB06Test() {
+    set_open_about_blank_on_browser_launch(false);
+  }
+
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    if (browser()) {
+      SessionStartupPref::SetStartupPref(
+          browser()->GetProfile(),
+          SessionStartupPref(SessionStartupPref::DEFAULT));
+    }
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+
+  GURL Url(const std::string& host) {
+    return embedded_test_server()->GetURL(host, "/title1.html");
+  }
+
+  // A new foreground tab on `host`, loaded.
+  tabs::TabInterface* Open(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), Url(host), WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // How many tabs of the window show `host`.
+  int Count(const std::string& host) {
+    int count = 0;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      count += ShownUrl(tabs()->GetWebContentsAt(i)).host() == host;
+    }
+    return count;
+  }
+};
+
+// The run before the launch: an essential, which keeps the window, and a tab
+// group made of two loose tabs, as an extension's chrome.tabs.group or Add
+// Tab to New Group makes one.
+IN_PROC_BROWSER_TEST_F(StartupKeepsTheSidebarB06Test,
+                       PRE_AGroupOfLooseTabsDoesNotStopTheLaunch) {
+  ASSERT_TRUE(tabs()->SupportsTabGroups());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("essential.test")));
+  tabs()->SetTabPinned(0, true);
+  tabs::TabInterface* const first = Open("grouped-a.test");
+  tabs::TabInterface* const second = Open("grouped-b.test");
+  tabs()->AddToNewGroup(
+      {tabs()->GetIndexOfTab(first), tabs()->GetIndexOfTab(second)});
+  ASSERT_EQ(1u, tabs()->group_model()->ListTabGroups().size());
+  ASSERT_TRUE(first->GetGroup().has_value());
+  ASSERT_EQ(first->GetGroup(), second->GetGroup());
+}
+
+// P06-1a; windows G10: the group's tabs are loose, so they stay closed, and
+// the group with them; the essential comes back and the launch goes on. The
+// group had stayed in the saved window with none of its tabs, and restoring
+// its look stopped the browser at startup, every launch after it too.
+IN_PROC_BROWSER_TEST_F(StartupKeepsTheSidebarB06Test,
+                       AGroupOfLooseTabsDoesNotStopTheLaunch) {
+  ASSERT_TRUE(browser()) << "the launch made no window";
+  EXPECT_EQ(1, Count("essential.test"))
+      << "the essential did not come back once";
+  EXPECT_EQ(0, Count("grouped-a.test")) << "a loose tab came back";
+  EXPECT_EQ(0, Count("grouped-b.test")) << "a loose tab came back";
+  EXPECT_TRUE(tabs()->group_model()->ListTabGroups().empty())
+      << "a group came back without its tabs";
+}
