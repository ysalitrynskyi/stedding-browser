+// folders F44: the second click of a double click on the - lands on the header
+// once the - has gone, and does nothing: it had opened the folder again.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, ASecondClickOnTheMinusDoesNothing) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  CloseDownToOne();
+  tabs::TabInterface* const pin = OpenPin("a.test");
+  tabs::FolderTabCollection* const folder = FolderOf({pin});
+  ASSERT_TRUE(folder);
+  OpenLoaded("b.test");
+  views::View* const minus = MinusUnderThePointer(folder);
+  ASSERT_TRUE(minus && minus->GetVisible());
+  const gfx::Point centre = minus->GetBoundsInScreen().CenterPoint();
+  const base::TimeTicks clicked = ui::EventTimeForNow();
+  ASSERT_TRUE(PressMinus(folder));
+  ASSERT_TRUE(WaitUntilAsleep(pin));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return folder->collapsed(); }));
+  views::test::RunScheduledLayout(widget());
+  ASSERT_FALSE(minus->GetVisible());
+
+  // At a double click's pace, whatever this machine took. The window has
+  // dropped the mark of a double click: its first press went to the -.
+  views::View* const root = widget()->GetRootView();
+  gfx::Point in_root = centre;
+  views::View::ConvertPointFromScreen(root, &in_root);
+  const auto second_click = [&](ui::EventType type) {
+    return ui::MouseEvent(type, in_root, in_root,
+                          clicked + base::Milliseconds(150),
+                          ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON);
+  };
+  root->OnMousePressed(second_click(ui::EventType::kMousePressed));
+  root->OnMouseReleased(second_click(ui::EventType::kMouseReleased));
+  EXPECT_TRUE(folder->collapsed()) << "the second click opened the folder";
+
+  stedding::test::ClickLeftMouse(widget(), centre);
+  EXPECT_FALSE(folder->collapsed()) << "the next click is a click";
+}
