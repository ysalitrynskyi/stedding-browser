+#include "content/public/browser/web_contents.h"
+#include "third_party/blink/public/mojom/window_features/window_features.mojom.h"
+#include "ui/base/base_window.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr int kLittleWidth = 1000;
+constexpr int kLittleHeight = 700;
+
+}  // namespace
+
+bool ShouldOpenLittle(const PrefService* prefs, const GURL& url) {
+  if (!prefs || !url.SchemeIsHTTPOrHTTPS()) {
+    return false;
+  }
+  if (!prefs->GetBoolean(prefs::kLittleEnabled)) {
+    return false;
+  }
+  return !spaces::RouteFor(spaces::ReadRoutes(prefs), url).has_value();
+}
+
+void MarkLittleWindow(BrowserWindowInterface* window) {
+  // The mark lives on the window's features, so it goes with the window.
+  if (window) {
+    window->GetFeatures().set_little_window(true);
+  }
+}
+
+bool IsLittleWindow(const BrowserWindowInterface* window) {
+  return window && window->GetFeatures().little_window();
+}
+
+BrowserWindowInterface* LastActiveNormalWindow(Profile* profile) {
+  BrowserWindowInterface* found = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        if (window->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL &&
+            !window->GetProfile()->IsOffTheRecord() &&
+            (!profile || window->GetProfile() == profile)) {
+          found = window;
+          return false;
+        }
+        return true;
+      });
+  return found;
+}
+
+BrowserWindowInterface* OpenLittleWindow(Profile* profile,
+                                         const GURL& url,
+                                         BrowserWindowInterface* anchor) {
+  if (!profile) {
+    return nullptr;
+  }
+  if (!anchor) {
+    anchor = LastActiveNormalWindow(profile);
+  }
+  BrowserWindowCreateParams params(BrowserWindowInterface::Type::TYPE_POPUP,
+                                   *profile, /*from_user_gesture=*/true);
+  gfx::Rect bounds(kLittleWidth, kLittleHeight);
+  if (anchor && anchor->GetWindow()) {
+    const gfx::Rect over = anchor->GetWindow()->GetBounds();
+    bounds.set_width(std::min(kLittleWidth, std::max(400, over.width() - 80)));
+    bounds.set_height(
+        std::min(kLittleHeight, std::max(300, over.height() - 80)));
+    bounds.set_origin(
+        gfx::Point(over.x() + (over.width() - bounds.width()) / 2,
+                   over.y() + (over.height() - bounds.height()) / 2));
+  }
+  params.initial_bounds = bounds;
+  BrowserWindowInterface* const window = CreateBrowserWindow(std::move(params));
+  if (!window) {
+    return nullptr;
+  }
+  MarkLittleWindow(window);
+  NavigateParams navigate(window, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  navigate.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  Navigate(&navigate);
+  window->GetWindow()->Show();
+  return window;
+}
+
+bool PromoteLittleWindow(BrowserWindowInterface* little,
+                         BrowserWindowInterface* target,
+                         std::optional<spaces::SpaceId> space,
+                         bool split) {
+  if (!little || !IsLittleWindow(little)) {
+    return false;
+  }
+  if (!target) {
+    target = LastActiveNormalWindow(little->GetProfile());
+  }
+  spaces::SpaceModel* const model =
+      target ? spaces::SpaceModel::From(target) : nullptr;
+  TabStripModel* const from = little->GetTabStripModel();
+  if (!model || !from || from->empty()) {
+    return false;
+  }
+  const spaces::SpaceId destination = space.value_or(model->active_id());
+  if (!model->GetSpace(destination)) {
+    return false;
+  }
+  std::unique_ptr<content::WebContents> contents =
+      from->DetachWebContentsAtForInsertion(from->active_index());
+  if (!contents) {
+    return false;
+  }
+  const GURL url = contents->GetLastCommittedURL().is_empty()
+                       ? contents->GetVisibleURL()
+                       : contents->GetLastCommittedURL();
+  // The page lands in its Space before the window looks at it; routing
+  // stays out of the way (its rule already had its say, E1).
+  spaces::SpaceModel::ScopedRoutingPause no_routing(model);
+  model->SetActiveSpace(destination);
+  content::WebContents* const raw = contents.get();
+  chrome::AddWebContents(target, nullptr, std::move(contents), url,
+                         split ? WindowOpenDisposition::NEW_SPLIT_VIEW
+                               : WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                         blink::mojom::WindowFeatures());
+  if (tabs::TabInterface* const tab =
+          tabs::TabInterface::MaybeGetFromContents(raw)) {
+    model->SetSpaceForTab(tab, destination);
+  }
+  target->GetWindow()->Activate();
+  if (little->GetWindow()) {
+    little->GetWindow()->Close();
+  }
+  return true;
+}
+
+}  // namespace stedding
