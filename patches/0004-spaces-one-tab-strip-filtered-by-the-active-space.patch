@@ -0,0 +1,421 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/spaces/space_switcher_view.h"
+
+#include <array>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tabs/public/tab_interface.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/gfx/color_utils.h"
+#include "ui/views/background.h"
+#include "cc/paint/paint_flags.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/image/canvas_image_source.h"
+#include "ui/views/controls/button/label_button.h"
+#include "ui/menus/simple_menu_model.h"
+#include "ui/views/controls/menu/menu_runner.h"
+#include "ui/views/controls/textfield/textfield.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/views/layout/fill_layout.h"
+#include "ui/views/layout/flex_layout.h"
+#include "ui/views/layout/layout_types.h"
+
+namespace spaces {
+namespace {
+
+// From docs/UI-SPEC.md, measured against the reference: a row of small icons at
+// the bottom of the sidebar, not named pills at the top.
+constexpr int kIconSize = 28;
+constexpr int kRowInset = 12;
+constexpr int kRowHeight = kIconSize + 2 * 8;
+
+// How much of a Space's colour an inactive icon shows. The active Space is the
+// only one that should read as selected.
+constexpr SkAlpha kInactiveAlpha = 0x55;
+
+// Colours for the Spaces a user makes, walked in order so two Spaces made in a
+// row do not look alike.
+// The icons offered in a Space's context menu. A short, distinct set beats a
+// full emoji picker here: the icon only has to tell one Space from four others
+// in a row of 24 DIP chips.
+constexpr auto kIconChoices = std::to_array<const char*>({
+    "\xF0\x9F\x8F\xA0",  // house
+    "\xF0\x9F\x92\xBC",  // briefcase
+    "\xF0\x9F\x93\x9A",  // books
+    "\xF0\x9F\x8E\xA8",  // palette
+    "\xF0\x9F\x94\xAC",  // microscope
+    "\xF0\x9F\x8E\xB5",  // note
+});
+
+// The colour swatch drawn beside a colour's name in the context menu.
+constexpr int kSwatchSize = 16;
+
+class SwatchSource : public gfx::CanvasImageSource {
+ public:
+  explicit SwatchSource(SkColor color)
+      : gfx::CanvasImageSource(gfx::Size(kSwatchSize, kSwatchSize)),
+        color_(color) {}
+  void Draw(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(color_);
+    canvas->DrawCircle(gfx::PointF(kSwatchSize / 2.0f, kSwatchSize / 2.0f),
+                       kSwatchSize / 2.0f - 1, flags);
+  }
+
+ private:
+  const SkColor color_;
+};
+
+// Command ids: the icon choices occupy a block, then the rest.
+constexpr int kFirstIconCommand = 100;
+constexpr int kMoveTabHereCommand = 149;
+constexpr int kFirstColorCommand = 150;
+constexpr int kRenameSpaceCommand = 199;
+constexpr int kRemoveSpaceCommand = 200;
+
+constexpr auto kNewSpaceColors = std::to_array<SkColor>({
+    SkColorSetRGB(0x5B, 0x6B, 0x8C), SkColorSetRGB(0x7A, 0x5B, 0x8C),
+    SkColorSetRGB(0x5B, 0x8C, 0x74), SkColorSetRGB(0x8C, 0x6B, 0x5B),
+    SkColorSetRGB(0x8C, 0x5B, 0x63),
+});
+
+// A chip that reports hover, so the row can float the Space's name above it.
+class SpaceChipButton : public views::LabelButton {
+  METADATA_HEADER(SpaceChipButton, views::LabelButton)
+
+ public:
+  SpaceChipButton(PressedCallback pressed,
+                  std::u16string icon,
+                  base::RepeatingCallback<void(bool)> hovered)
+      : views::LabelButton(std::move(pressed), std::move(icon)),
+        hovered_(std::move(hovered)) {}
+  ~SpaceChipButton() override = default;
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    views::LabelButton::OnMouseEntered(event);
+    hovered_.Run(true);
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    views::LabelButton::OnMouseExited(event);
+    hovered_.Run(false);
+  }
+
+ private:
+  base::RepeatingCallback<void(bool)> hovered_;
+};
+
+BEGIN_METADATA(SpaceChipButton)
+END_METADATA
+
+}  // namespace
+
+SpaceSwitcherView::SpaceSwitcherView(SpaceModel& model, Browser& browser)
+    : model_(model), browser_(browser) {
+  SetLayoutManager(std::make_unique<views::FillLayout>());
+
+  // Renaming happens in place: the icon row swaps for a field of the same
+  // height, so nothing below moves.
+  auto rename = std::make_unique<views::Textfield>();
+  rename->set_controller(this);
+  rename->SetVisible(false);
+  rename_field_ = AddChildView(std::move(rename));
+
+  auto row = std::make_unique<views::View>();
+  row->SetLayoutManager(std::make_unique<views::FlexLayout>())
+      ->SetOrientation(views::LayoutOrientation::kHorizontal)
+      .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+      .SetInteriorMargin(gfx::Insets::VH(0, kRowInset));
+  icon_row_ = AddChildView(std::move(row));
+
+  // The sidebar lays its children out vertically and stretches anything that
+  // does not declare a size. This row is exactly one chip tall.
+  SetPreferredSize(gfx::Size(0, kRowHeight));
+  SetProperty(views::kFlexBehaviorKey,
+              views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                                       views::MaximumFlexSizeRule::kPreferred));
+
+  observation_.Observe(&model);
+  Rebuild();
+}
+
+SpaceSwitcherView::~SpaceSwitcherView() = default;
+
+void SpaceSwitcherView::Rebuild() {
+  if (!icon_row_) {
+    return;
+  }
+  icon_row_->RemoveAllChildViews();
+  chips_.clear();
+
+  const views::FlexSpecification stretch(
+      views::MinimumFlexSizeRule::kScaleToZero,
+      views::MaximumFlexSizeRule::kUnbounded);
+  const auto add_spacer = [&] {
+    icon_row_->AddChildView(std::make_unique<views::View>())
+        ->SetProperty(views::kFlexBehaviorKey, stretch);
+  };
+
+  const auto& spaces = model_->spaces();
+  for (size_t i = 0; i < spaces.size(); ++i) {
+    const Space& space = *spaces[i];
+    const bool active = space.id() == model_->active_id();
+
+    const std::u16string name = model_->DisplayName(space.id());
+    // A Space the user has not given an icon still gets a glyph, taken from
+    // the same list the context menu offers, so chips are never blank discs.
+    const std::string glyph =
+        space.icon().empty()
+            ? std::string(kIconChoices.at(i % kIconChoices.size()))
+            : space.icon();
+    auto button = std::make_unique<SpaceChipButton>(
+        base::BindRepeating(&SpaceSwitcherView::OnSpacePressed,
+                            base::Unretained(this), space.id()),
+        base::UTF8ToUTF16(glyph),
+        base::BindRepeating(
+            [](SpaceSwitcherView* self, size_t chip_index,
+               std::u16string name, bool entered) {
+              if (!self->hover_callback_) {
+                return;
+              }
+              gfx::Rect bounds;
+              if (entered && chip_index < self->chips_.size()) {
+                gfx::RectF rect_f(
+                    self->chips_[chip_index].first->bounds());
+                views::View::ConvertRectToTarget(self->icon_row_,
+                                                 self->parent(), &rect_f);
+                bounds = gfx::ToEnclosingRect(rect_f);
+              }
+              self->hover_callback_.Run(entered ? name : std::u16string(),
+                                        bounds);
+            },
+            base::Unretained(this), i, name));
+    button->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    button->SetPreferredSize(gfx::Size(kIconSize, kIconSize));
+    button->SetTooltipText(name);
+    button->set_context_menu_controller(this);
+    // The chip carries the Space's colour; the emoji sits on top when one is
+    // set. Inactive Spaces are muted so the row reads as one control with a
+    // current selection.
+    button->SetBackground(views::CreateRoundedRectBackground(
+        active ? space.color() : SkColorSetA(space.color(), kInactiveAlpha),
+        kIconSize / 2));
+    chips_.emplace_back(
+        icon_row_->AddChildView(std::move(button)), space.id());
+    // A flexible spacer after every chip spreads the row across the sidebar,
+    // as the reference does, instead of cramming the chips into the corner.
+    add_spacer();
+  }
+
+  auto add = std::make_unique<views::LabelButton>(
+      base::BindRepeating(&SpaceSwitcherView::OnNewSpacePressed,
+                          base::Unretained(this)),
+      u"+");
+  add->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+  add->SetPreferredSize(gfx::Size(kIconSize, kIconSize));
+  add->SetTooltipText(u"New Space");
+  icon_row_->AddChildView(std::move(add));
+}
+
+void SpaceSwitcherView::ShowContextMenuForViewImpl(
+    views::View* source,
+    const gfx::Point& point,
+    ui::mojom::MenuSourceType source_type) {
+  const auto it = std::find_if(
+      chips_.begin(), chips_.end(),
+      [source](const auto& chip) { return chip.first == source; });
+  if (it == chips_.end()) {
+    return;
+  }
+  menu_space_ = it->second;
+
+  menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+  // Each icon with the word it stands for: a bare emoji in a menu row reads
+  // as a mistake.
+  static constexpr auto kIconNames = std::to_array<const char16_t*>(
+      {u"Home", u"Work", u"Study", u"Design", u"Research", u"Music"});
+  for (size_t i = 0; i < kIconChoices.size(); ++i) {
+    menu_model_->AddItem(
+        kFirstIconCommand + static_cast<int>(i),
+        base::UTF8ToUTF16(std::string(kIconChoices.at(i))) + u"   " +
+            kIconNames.at(i));
+  }
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItem(kMoveTabHereCommand, u"Move Current Tab Here");
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  static constexpr auto kColorNames = std::to_array<const char16_t*>({
+      u"Slate", u"Plum", u"Moss", u"Clay", u"Rose"});
+  for (size_t i = 0; i < kNewSpaceColors.size(); ++i) {
+    // A swatch of the colour beside its name.
+    const SkColor color = kNewSpaceColors.at(i);
+    menu_model_->AddItemWithIcon(
+        kFirstColorCommand + static_cast<int>(i), kColorNames.at(i),
+        // A plain image, not a generator: Cocoa's menu controller refuses
+        // generator-backed icons (NOTREACHED), and a swatch has no theme
+        // dependence anyway.
+        ui::ImageModel::FromImageSkia(
+            gfx::CanvasImageSource::MakeImageSkia<SwatchSource>(color)));
+  }
+  menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+  menu_model_->AddItem(kRenameSpaceCommand, u"Rename Space");
+  menu_model_->AddItem(kRemoveSpaceCommand, u"Delete Space");
+
+  menu_runner_ = std::make_unique<views::MenuRunner>(
+      menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+  menu_runner_->RunMenuAt(GetWidget(), nullptr, gfx::Rect(point, gfx::Size()),
+                          views::MenuAnchorPosition::kTopLeft, source_type);
+}
+
+void SpaceSwitcherView::ExecuteCommand(int command_id, int event_flags) {
+  if (!menu_space_) {
+    return;
+  }
+  if (command_id == kMoveTabHereCommand) {
+    if (tabs::TabInterface* const tab =
+            browser_->tab_strip_model()->GetActiveTab()) {
+      model_->SetSpaceForTab(tab, *menu_space_);
+      model_->SetActiveSpace(*menu_space_);
+    }
+    return;
+  }
+  if (command_id == kRenameSpaceCommand) {
+    BeginRename(*menu_space_);
+    return;
+  }
+  if (command_id == kRemoveSpaceCommand) {
+    model_->RemoveSpace(*menu_space_);
+    return;
+  }
+  if (command_id >= kFirstColorCommand && command_id < kRenameSpaceCommand) {
+    const size_t choice = static_cast<size_t>(command_id - kFirstColorCommand);
+    if (choice < kNewSpaceColors.size()) {
+      model_->SetSpaceColor(*menu_space_, kNewSpaceColors.at(choice));
+    }
+    return;
+  }
+  const size_t choice = static_cast<size_t>(command_id - kFirstIconCommand);
+  if (choice < kIconChoices.size()) {
+    model_->SetSpaceIcon(*menu_space_, std::string(kIconChoices.at(choice)));
+  }
+}
+
+bool SpaceSwitcherView::IsCommandIdEnabled(int command_id) const {
+  // The last Space cannot be deleted: a window must always have one.
+  if (command_id == kRemoveSpaceCommand) {
+    return model_->size() > 1;
+  }
+  if (command_id == kMoveTabHereCommand) {
+    // Pinned tabs are the essentials row and are in every Space already, so
+    // there is nowhere to move one to.
+    tabs::TabInterface* const tab =
+        browser_->tab_strip_model()->GetActiveTab();
+    return menu_space_ && tab && !tab->IsPinned() &&
+           const_cast<SpaceModel&>(*model_).SpaceForTab(tab) != *menu_space_;
+  }
+  return true;
+}
+
+std::optional<SpaceId> SpaceSwitcherView::SpaceAtScreenPoint(
+    const gfx::Point& point_in_screen) const {
+  for (const auto& [view, id] : chips_) {
+    if (view->GetBoundsInScreen().Contains(point_in_screen)) {
+      return id;
+    }
+  }
+  return std::nullopt;
+}
+
+void SpaceSwitcherView::BeginRename(const SpaceId& id) {
+  const Space* const space = model_->GetSpace(id);
+  if (!space || !rename_field_ || !icon_row_) {
+    return;
+  }
+  renaming_ = id;
+  rename_field_->SetText(base::UTF8ToUTF16(space->name()));
+  icon_row_->SetVisible(false);
+  rename_field_->SetVisible(true);
+  rename_field_->RequestFocus();
+  rename_field_->SelectAll(false);
+}
+
+void SpaceSwitcherView::EndRename(bool commit) {
+  if (!renaming_ || !rename_field_) {
+    return;
+  }
+  if (commit) {
+    model_->SetSpaceName(*renaming_,
+                         base::UTF16ToUTF8(rename_field_->GetText()));
+  }
+  renaming_.reset();
+  rename_field_->SetVisible(false);
+  icon_row_->SetVisible(true);
+}
+
+bool SpaceSwitcherView::HandleKeyEvent(views::Textfield* sender,
+                                       const ui::KeyEvent& event) {
+  if (event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    EndRename(/*commit=*/true);
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    EndRename(/*commit=*/false);
+    return true;
+  }
+  return false;
+}
+
+void SpaceSwitcherView::OnSpacePressed(const SpaceId& id) {
+  model_->SetActiveSpace(id);
+}
+
+void SpaceSwitcherView::OnNewSpacePressed() {
+  const size_t index = model_->size() % kNewSpaceColors.size();
+  Space* const space =
+      model_->AddSpace(std::string(), kNewSpaceColors.at(index));
+  // Switching to a new Space is the point of making one: it starts empty, and
+  // the next tab opened lands in it.
+  model_->SetActiveSpace(space->id());
+}
+
+void SpaceSwitcherView::OnSpaceAdded(const SpaceId& id) {
+  Rebuild();
+}
+
+void SpaceSwitcherView::OnSpaceRemoved(const SpaceId& id) {
+  Rebuild();
+}
+
+void SpaceSwitcherView::OnActiveSpaceChanged(const SpaceId& from,
+                                             const SpaceId& to) {
+  Rebuild();
+}
+
+void SpaceSwitcherView::OnSpaceMetadataChanged(const SpaceId& id) {
+  Rebuild();
+}
+
+void SpaceSwitcherView::OnThemeChanged() {
+  views::View::OnThemeChanged();
+  Rebuild();
+}
+
+BEGIN_METADATA(SpaceSwitcherView)
+END_METADATA
+
+}  // namespace spaces
