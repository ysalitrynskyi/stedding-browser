+    EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget));
+    views::test::RunScheduledLayout(widget);
+    return stedding::test::FindDrawnRow(widget->GetRootView(), sleepy);
+  };
+  // The favicon is drawn at the slept rows' strength (R4).
+  const auto expect_dimmed = [&](const char* after) {
+    base::RunLoop().RunUntilIdle();
+    TabView* const drawn = row();
+    ASSERT_TRUE(drawn) << after;
+    EXPECT_NEAR(stedding::kSleptIconOpacity,
+                DrawnStrength(drawn->GetTabIconForTesting()), 0.03f)
+        << "the favicon is not dimmed after " << after
