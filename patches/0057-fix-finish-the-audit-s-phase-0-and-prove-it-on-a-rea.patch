diff --git a/chrome/browser/ui/stedding/tab_menu_verbs.cc b/chrome/browser/ui/stedding/tab_menu_verbs.cc
new file mode 100644
index 0000000000000..8c1e9cf9c0a95
--- /dev/null
+++ b/chrome/browser/ui/stedding/tab_menu_verbs.cc
@@ -0,0 +1,260 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/tab_menu_verbs.h"
+
+#include <cstddef>
+#include <memory>
+#include <vector>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_router.h"
+#include "chrome/browser/ui/stedding/copy_link.h"
+#include "chrome/browser/ui/stedding/menu_rules.h"
+#include "chrome/browser/ui/stedding/pin_home.h"
+#include "chrome/browser/ui/stedding/pin_lifecycle.h"
+#include "chrome/browser/ui/stedding/sleep_tabs.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr int kMoveFirst = TabStripModel::CommandSteddingMoveToSpaceFirst;
+constexpr int kMoveLast = TabStripModel::CommandSteddingMoveToSpaceLast;
+constexpr int kRouteFirst = TabStripModel::CommandSteddingRouteToSpaceFirst;
+constexpr int kRouteLast = TabStripModel::CommandSteddingRouteToSpaceLast;
+
+bool IsMoveEntry(int command_id) {
+  return command_id >= kMoveFirst && command_id <= kMoveLast;
+}
+
+bool IsRouteEntry(int command_id) {
+  return command_id >= kRouteFirst && command_id <= kRouteLast;
+}
+
+BrowserWindowInterface* WindowOf(const TabStripModel& tabs) {
+  return tabs.delegate() ? tabs.delegate()->GetBrowserWindowInterface()
+                         : nullptr;
+}
+
+// Null in a window without Spaces.
+spaces::SpaceModel* SpacesOf(const TabStripModel& tabs) {
+  return spaces::SpaceModel::From(WindowOf(tabs));
+}
+
+// What a "Move to Space" entry can name: every Space but the active one, in
+// switcher order -- the list the menu was built from (menus M1).
+std::vector<spaces::SpaceId> OtherSpaces(const spaces::SpaceModel& model) {
+  std::vector<spaces::SpaceId> others;
+  for (const std::unique_ptr<spaces::Space>& space : model.spaces()) {
+    if (space->id() != model.active_id()) {
+      others.push_back(space->id());
+    }
+  }
+  return others;
+}
+
+// The page an "Always Open <site> in" rule is written for, or an empty URL
+// when the tab shows nothing a site rule can match (routing D5).
+GURL RoutableUrl(const tabs::TabInterface* tab) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  const GURL url = contents ? contents->GetLastCommittedURL() : GURL();
+  return url.SchemeIsHTTPOrHTTPS() ? url : GURL();
+}
+
+}  // namespace
+
+bool IsTabMenuVerb(const TabStripModel& tabs, int command_id) {
+  if (IsMoveEntry(command_id) || IsRouteEntry(command_id)) {
+    return true;
+  }
+  switch (command_id) {
+    case TabStripModel::CommandSpacePin:
+    case TabStripModel::CommandSpaceUnpin:
+    case TabStripModel::CommandSteddingRenameTab:
+    case TabStripModel::CommandSteddingSleepTab:
+    case TabStripModel::CommandSteddingSleepOthersInSpace:
+    case TabStripModel::CommandSteddingResetToHome:
+    case TabStripModel::CommandSteddingSetHome:
+    case TabStripModel::CommandSteddingCopyMarkdownLink:
+    case TabStripModel::CommandSteddingMoveToSpaceMenu:
+    case TabStripModel::CommandSteddingRouteToSpaceMenu:
+      return true;
+    case TabStripModel::CommandCopyURL:
+      // A web app's window keeps Chromium's Copy URL; everywhere else it is
+      // Stedding's clean copy (copy-link L4), never chrome::CopyURL, which
+      // copies the tracking parameters too.
+      return !tabs.delegate() || !tabs.delegate()->IsForWebApp();
+    default:
+      return false;
+  }
+}
+
+bool IsTabMenuVerbEnabled(const TabStripModel& tabs,
+                          int index,
+                          int command_id,
+                          RenameInPlace rename) {
+  if (!tabs.ContainsIndex(index) || !IsTabMenuVerb(tabs, command_id)) {
+    return false;
+  }
+  tabs::TabInterface* const tab = tabs.GetTabAtIndex(index);
+  if (!tab) {
+    return false;
+  }
+  spaces::SpaceModel* const space_model = SpacesOf(tabs);
+
+  // An essential is in every Space already (spaces B6), so neither submenu
+  // takes it; an entry past the window's Spaces names nothing.
+  if (IsMoveEntry(command_id)) {
+    return space_model && !tab->IsPinned() &&
+           static_cast<size_t>(command_id - kMoveFirst) <
+               OtherSpaces(*space_model).size();
+  }
+  if (IsRouteEntry(command_id)) {
+    return space_model && !tab->IsPinned() && RoutableUrl(tab).is_valid() &&
+           static_cast<size_t>(command_id - kRouteFirst) < space_model->size();
+  }
+
+  switch (command_id) {
+    case TabStripModel::CommandSteddingMoveToSpaceMenu:
+      return space_model && !tab->IsPinned() && space_model->size() > 1;
+    case TabStripModel::CommandSteddingRouteToSpaceMenu:
+      return space_model && !tab->IsPinned() && RoutableUrl(tab).is_valid();
+    case TabStripModel::CommandSpacePin:
+    case TabStripModel::CommandSpaceUnpin: {
+      // Exactly one of the pair, and neither on an essential (spaces B28).
+      if (!space_model || tab->IsPinned()) {
+        return false;
+      }
+      const bool pinned = space_model->IsSpacePinned(tab);
+      return command_id == TabStripModel::CommandSpacePin ? !pinned : pinned;
+    }
+    case TabStripModel::CommandSteddingRenameTab:
+      return rename == RenameInPlace::kAvailable;
+    case TabStripModel::CommandSteddingSleepTab:
+      return !TabsToSleep(WindowOf(tabs), tab, SleepScope::kThisTab).empty();
+    case TabStripModel::CommandSteddingSleepOthersInSpace:
+      return !TabsToSleep(WindowOf(tabs), tab, SleepScope::kOthersInSpace)
+                  .empty();
+    case TabStripModel::CommandSteddingResetToHome:
+      // Only a pin of either tier has a home (pins H1).
+      return space_model && space_model->HomeUrl(tab).has_value();
+    case TabStripModel::CommandSteddingSetHome:
+      // Only a web page can be a pin's home (pins H13); SpaceModel refuses
+      // any other, so the row does not offer it.
+      return space_model && tab->GetContents() &&
+             (tab->IsPinned() || space_model->IsSpacePinned(tab)) &&
+             IsAllowedPinHome(tab->GetContents()->GetLastCommittedURL());
+    case TabStripModel::CommandCopyURL:
+    case TabStripModel::CommandSteddingCopyMarkdownLink:
+      return tab->GetContents() != nullptr;
+    default:
+      return false;
+  }
+}
+
+void ExecuteTabMenuVerb(TabStripModel& tabs, int index, int command_id) {
+  if (!IsTabMenuVerbEnabled(tabs, index, command_id,
+                            RenameInPlace::kUnavailable)) {
+    return;
+  }
+  tabs::TabInterface* const tab = tabs.GetTabAtIndex(index);
+  BrowserWindowInterface* const window = WindowOf(tabs);
+  spaces::SpaceModel* const space_model = SpacesOf(tabs);
+  // The rows a verb takes: the selection when the tab is part of it (R21).
+  const std::vector<tabs::TabInterface*> selection =
+      tabs.GetTabsForContextMenuCommand(index);
+
+  if (IsMoveEntry(command_id)) {
+    // menus M1: the i-th Space other than the active one. The selection
+    // moves and the window follows it, as the command bar's row does.
+    const spaces::SpaceId target =
+        OtherSpaces(*space_model)[command_id - kMoveFirst];
+    for (tabs::TabInterface* const each : selection) {
+      if (!each->IsPinned()) {
+        space_model->SetSpaceForTab(each, target);
+      }
+    }
+    space_model->SetActiveSpace(target);
+    return;
+  }
+  if (IsRouteEntry(command_id)) {
+    // routing D5: the i-th Space in switcher order gets a site rule for each
+    // selected page, and the pages go there now.
+    const spaces::SpaceId target =
+        space_model->spaces()[command_id - kRouteFirst]->id();
+    PrefService* const prefs = tabs.profile()->GetPrefs();
+    for (tabs::TabInterface* const each : selection) {
+      const GURL url = RoutableUrl(each);
+      if (each->IsPinned() || !url.is_valid()) {
+        continue;
+      }
+      spaces::AddRoute(prefs, spaces::SiteRouteFor(url, target.ToString()));
+      space_model->RouteTab(each, url, /*foreground=*/true, /*external=*/false);
+    }
+    return;
+  }
+
+  switch (command_id) {
+    case TabStripModel::CommandSpacePin:
+    case TabStripModel::CommandSpaceUnpin: {
+      // The model moves a newly pinned tab under the Clear line itself, so
+      // the menu and Cmd-D (spaces B21) cannot disagree.
+      const bool pin = command_id == TabStripModel::CommandSpacePin;
+      for (tabs::TabInterface* const each : selection) {
+        if (!each->IsPinned()) {
+          space_model->SetSpacePinned(each, pin);
+        }
+      }
+      return;
+    }
+    case TabStripModel::CommandSteddingSleepTab:
+      SleepTabs(window, tab, SleepScope::kThisTab);
+      return;
+    case TabStripModel::CommandSteddingSleepOthersInSpace:
+      SleepTabs(window, tab, SleepScope::kOthersInSpace);
+      return;
+    case TabStripModel::CommandSteddingResetToHome:
+      ResetToHome(window, tab);
+      return;
+    case TabStripModel::CommandSteddingSetHome:
+      space_model->SetHomeUrl(tab, tab->GetContents()->GetLastCommittedURL());
+      return;
+    case TabStripModel::CommandCopyURL:
+    case TabStripModel::CommandSteddingCopyMarkdownLink:
+      CopyLink(window, tab->GetContents(),
+               command_id == TabStripModel::CommandCopyURL
+                   ? LinkFormat::kPlain
+                   : LinkFormat::kMarkdown);
+      return;
+    default:
+      // The two submenu rows open their submenus.
+      return;
+  }
+}
+
+bool IsTabMenuRowVisible(const TabStripModel& tabs, int index, int command_id) {
+  const tabs::TabInterface* const tab =
+      tabs.ContainsIndex(index) ? tabs.GetTabAtIndex(index) : nullptr;
+  TabRowKind kind = TabRowKind::kPlain;
+  if (tab && tab->IsPinned()) {
+    kind = TabRowKind::kEssential;
+  } else if (const spaces::SpaceModel* const space_model = SpacesOf(tabs);
+             space_model && tab && space_model->IsSpacePinned(tab)) {
+    kind = TabRowKind::kSpacePinned;
+  }
+  return IsTabMenuCommandVisible(kind, command_id);
+}
+
+}  // namespace stedding
