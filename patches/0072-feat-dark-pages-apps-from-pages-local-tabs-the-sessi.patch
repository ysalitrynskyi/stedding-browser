+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_TEST_STEDDING_WEB_APP_TEST_BASE_H_
+#define CHROME_TEST_STEDDING_WEB_APP_TEST_BASE_H_
+
+#include "build/build_config.h"
+#include "chrome/browser/ui/web_applications/web_app_browsertest_base.h"
+
+#if BUILDFLAG(IS_MAC)
+#include "chrome/browser/web_applications/os_integration/mac/web_app_shortcut_mac.h"
+#endif
+
+namespace stedding {
+
+// The base of Stedding's browser tests of apps made from pages
+// (docs/features/web-apps.md): Chromium's web-app fixture, which fakes the
+// operating system's side (OsIntegrationTestOverride: no launcher reaches
+// ~/Applications, no shortcut the Start menu), with one rule more on the Mac
+// (Wa7). Chromium starts an app's launcher ("shim") whenever the app's
+// window opens, as on a user's Mac; under this base the launchers are still
+// made, in a temporary folder where a test finds them, but none is started
+// and none is registered with LaunchServices. A started launcher is a real
+// app on the machine running the tests, with a Dock icon, and it crashed
+// when its test ended before it reached the browser.
+class WebAppBrowserTest : public web_app::WebAppBrowserTestBase {
+ public:
+  // Before the fixture is made: Chromium's fixture picks the launchers'
+  // folder as it is made.
+  static void SetUpTestSuite() {
+    web_app::WebAppBrowserTestBase::SetUpTestSuite();
+#if BUILDFLAG(IS_MAC)
+    web_app::SetAppShimLaunchDisabledForTesting(true);
+#endif
+  }
+
+  static void TearDownTestSuite() {
+#if BUILDFLAG(IS_MAC)
+    web_app::SetAppShimLaunchDisabledForTesting(false);
+#endif
+    web_app::WebAppBrowserTestBase::TearDownTestSuite();
+  }
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_TEST_STEDDING_WEB_APP_TEST_BASE_H_
