+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_DOWNLOADS_NUDGE_H_
+#define CHROME_BROWSER_UI_STEDDING_DOWNLOADS_NUDGE_H_
+
+#include <cstdint>
+#include <memory>
+#include <set>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "components/download/content/public/all_download_item_notifier.h"
+
+class PrefService;
+
+namespace content {
+class DownloadManager;
+}  // namespace content
+
+namespace download {
+class DownloadItem;
+}  // namespace download
+
+namespace stedding {
+
+// docs/features/sidebar-panels.md Pn13: the sidebar's downloads button
+// nudges once when a download finishes. This watches the profile's
+// downloads and runs `nudge` for each one that finishes after it was seen in
+// progress, when stedding::ShouldAnimate says the window may move (motion
+// O1). The window does the moving; this decides when.
+class DownloadsNudge : public download::AllDownloadItemNotifier::Observer {
+ public:
+  // `manager` may be null: a test then plays the downloads to the observer's
+  // methods itself. `prefs` is the profile's.
+  DownloadsNudge(content::DownloadManager* manager,
+                 const PrefService* prefs,
+                 base::RepeatingClosure nudge);
+  DownloadsNudge(const DownloadsNudge&) = delete;
+  DownloadsNudge& operator=(const DownloadsNudge&) = delete;
+  ~DownloadsNudge() override;
+
+  // download::AllDownloadItemNotifier::Observer:
+  void OnDownloadCreated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override;
+  void OnDownloadUpdated(content::DownloadManager* manager,
+                         download::DownloadItem* item) override;
+  void OnDownloadRemoved(content::DownloadManager* manager,
+                         download::DownloadItem* item) override;
+  void OnDownloadDestroyed(content::DownloadManager* manager,
+                           download::DownloadItem* item) override;
+
+ private:
+  raw_ptr<const PrefService> prefs_;
+  base::RepeatingClosure nudge_;
+  // The downloads seen in progress, by id, until they end.
+  std::set<uint32_t> in_progress_;
+  std::unique_ptr<download::AllDownloadItemNotifier> notifier_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_DOWNLOADS_NUDGE_H_
diff --git a/chrome/browser/ui/stedding/downloads_nudge_unittest.cc b/chrome/browser/ui/stedding/downloads_nudge_unittest.cc
new file mode 100644
index 0000000000000..226bd4a6569d0
--- /dev/null
+++ b/chrome/browser/ui/stedding/downloads_nudge_unittest.cc
@@ -0,0 +1,102 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/downloads_nudge.h"
+
+#include "base/functional/bind.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/download/public/common/mock_download_item.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/animation/animation.h"
+
+namespace stedding {
+namespace {
+
+using ::testing::NiceMock;
+using ::testing::Return;
+
+class DownloadsNudgeTest : public testing::Test {
+ protected:
+  DownloadsNudgeTest() {
+    prefs::RegisterProfilePrefs(prefs_.registry());
+    gfx::Animation::SetPrefersReducedMotionForTesting(false);
+    ON_CALL(item_, GetId()).WillByDefault(Return(7u));
+  }
+  ~DownloadsNudgeTest() override {
+    gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  }
+
+  // Plays `item_` in `state` to `nudge`.
+  void Play(DownloadsNudge& nudge,
+            download::DownloadItem::DownloadState state,
+            bool created = false) {
+    ON_CALL(item_, GetState()).WillByDefault(Return(state));
+    if (created) {
+      nudge.OnDownloadCreated(nullptr, &item_);
+    } else {
+      nudge.OnDownloadUpdated(nullptr, &item_);
+    }
+  }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+  NiceMock<download::MockDownloadItem> item_;
+  int nudges_ = 0;
+  base::RepeatingClosure CountNudges() {
+    return base::BindRepeating([](int* nudges) { ++*nudges; },
+                               base::Unretained(&nudges_));
+  }
+};
+
+// Pn13: a download seen in progress nudges once when it finishes; later
+// updates of the finished download, one that was already finished when the
+// window first heard of it, and one that was cancelled do not.
+TEST_F(DownloadsNudgeTest, NudgesOnceWhenADownloadFinishes) {
+  DownloadsNudge nudge(/*manager=*/nullptr, &prefs_, CountNudges());
+
+  Play(nudge, download::DownloadItem::IN_PROGRESS, /*created=*/true);
+  Play(nudge, download::DownloadItem::IN_PROGRESS);
+  EXPECT_EQ(0, nudges_);
+  Play(nudge, download::DownloadItem::COMPLETE);
+  EXPECT_EQ(1, nudges_);
+  Play(nudge, download::DownloadItem::COMPLETE);
+  EXPECT_EQ(1, nudges_) << "a second update of a finished download nudged";
+
+  // Restored from history, already finished: never seen running.
+  DownloadsNudge restored(/*manager=*/nullptr, &prefs_, CountNudges());
+  Play(restored, download::DownloadItem::COMPLETE, /*created=*/true);
+  EXPECT_EQ(1, nudges_);
+
+  // Cancelled, then the same id finishing would be a new download's start.
+  Play(nudge, download::DownloadItem::IN_PROGRESS);
+  Play(nudge, download::DownloadItem::CANCELLED);
+  Play(nudge, download::DownloadItem::COMPLETE);
+  EXPECT_EQ(1, nudges_);
+}
+
+// Pn13, motion O1: with motion off -- the animation setting or the
+// system's Reduce Motion -- a finish does not move the button.
+TEST_F(DownloadsNudgeTest, StillWhenMotionIsOff) {
+  DownloadsNudge nudge(/*manager=*/nullptr, &prefs_, CountNudges());
+
+  prefs_.SetBoolean(prefs::kUiAnimate, false);
+  Play(nudge, download::DownloadItem::IN_PROGRESS);
+  Play(nudge, download::DownloadItem::COMPLETE);
+  EXPECT_EQ(0, nudges_) << "the animation setting is off";
+
+  prefs_.SetBoolean(prefs::kUiAnimate, true);
+  gfx::Animation::SetPrefersReducedMotionForTesting(true);
+  Play(nudge, download::DownloadItem::IN_PROGRESS);
+  Play(nudge, download::DownloadItem::COMPLETE);
+  EXPECT_EQ(0, nudges_) << "the system asks for reduced motion";
+
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  Play(nudge, download::DownloadItem::IN_PROGRESS);
+  Play(nudge, download::DownloadItem::COMPLETE);
+  EXPECT_EQ(1, nudges_);
+}
+
+}  // namespace
+}  // namespace stedding
