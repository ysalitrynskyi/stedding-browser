+  EXPECT_EQ(gfx::Rect(350, 160, 1200, 800),
+            LittleWindowBounds(window, gfx::Size(), work_area));
+  // The user's size, centred on the window.
+  EXPECT_EQ(gfx::Rect(650, 310, 600, 500),
+            LittleWindowBounds(window, gfx::Size(600, 500), work_area));
