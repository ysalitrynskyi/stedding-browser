diff --git a/chrome/browser/ui/color/stedding_color_mixer.cc b/chrome/browser/ui/color/stedding_color_mixer.cc
index 03f147e17b45d..0c498f66de71f 100644
--- a/chrome/browser/ui/color/stedding_color_mixer.cc
+++ b/chrome/browser/ui/color/stedding_color_mixer.cc
@@ -92,4 +92,40 @@ void AddSteddingColorMixer(ui::ColorProvider* provider,
       ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x20);
   mixer[kColorTabBackgroundSelectedHoverFrameInactive] =
       ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x20);
+
+  // No ring around split panes (page U6): Arc draws none, and the
+  // page-coloured bar says which pane is active. The row-text tint at the
+  // selected-row alpha keeps a whisper of an edge that follows light, dark
+  // and the Space tint; the 3 px drag-target highlight keeps its own id (U7).
+  mixer[kColorMultiContentsViewActiveContentOutline] =
+      ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x18);
+  mixer[kColorMultiContentsViewInactiveContentOutline] =
+      ui::SetAlpha(kColorTabForegroundActiveFrameActive, 0x18);
+
+  // The link status pill is part of the card (page U1): the dialog surface
+  // for its ground, secondary text, a hairline in the separator tint.
+  mixer[kColorStatusBubbleBackgroundFrameActive] = {ui::kColorDialogBackground};
+  mixer[kColorStatusBubbleBackgroundFrameInactive] = {
+      ui::kColorDialogBackground};
+  mixer[kColorStatusBubbleForegroundFrameActive] = {
+      ui::kColorSecondaryForeground};
+  mixer[kColorStatusBubbleForegroundFrameInactive] = {
+      ui::kColorSecondaryForeground};
+  mixer[kColorStatusBubbleShadow] = {ui::kColorSeparator};
+
+  // The find bar takes the dialog colours the command bar uses (page U3), not
+  // the Material textfield grey.
+  mixer[kColorFindBarBackground] = {ui::kColorDialogBackground};
+  mixer[kColorFindBarForeground] = {ui::kColorLabelForeground};
+  mixer[kColorFindBarMatchCount] = {ui::kColorSecondaryForeground};
+  mixer[kColorFindBarButtonIcon] = {ui::kColorIcon};
+  mixer[kColorFindBarButtonIconHovered] = {ui::kColorIcon};
+  mixer[kColorFindBarButtonIconDisabled] = {ui::kColorIconDisabled};
+
+  // Toasts match the window rather than inverting it (screenshot C6): the
+  // dialog surface, its text, the accent for the action. One style for every
+  // Stedding toast.
+  mixer[ui::kColorToastBackgroundProminent] = {ui::kColorDialogBackground};
+  mixer[ui::kColorToastForeground] = {ui::kColorLabelForeground};
+  mixer[ui::kColorToastButton] = {ui::kColorAccent};
 }
