+// I3: a tab that shows its title and loads on its first activation, the way
+// session restore creates the tabs it does not load (unloaded_tab.h). A name
+// the person gave it in Arc is its name, as a rename here makes one, so it
+// outlives the page's title (tabs R14-R17).
+tabs::TabInterface* InsertUnloaded(ApplyContext& ctx, const Node& node) {
+  tabs::TabInterface* const tab =
+      InsertUnloadedTab(ctx.tabs, ctx.profile, node.url, node.title);
+  if (tab && !node.name.empty()) {
+    stedding::SetTabName(ctx.browser, tab, node.name);
+    if (TabUIHelper* const helper = TabUIHelper::From(tab)) {
+      helper->TabNameChanged();
+    }
+  }
+  return tab;
+}
