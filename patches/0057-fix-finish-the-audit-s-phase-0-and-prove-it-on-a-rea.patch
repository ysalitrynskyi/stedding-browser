+// Stedding (PLAN.md TAB-11): a folder's title and collapse reach the root's
+// observers, once per real change, so the header and the session hear of a
+// rename or a collapse whoever made it.
+TEST_F(TabCollectionObserverTest, FolderDataChangesReachTheRoot) {
+  auto owned = std::make_unique<FolderTabCollection>(
+      FolderId::GenerateNew(), "Reading", /*collapsed=*/false);
+  FolderTabCollection* const folder = owned.get();
+  folder->AddTab(CreateMockTab(), 0);
+  GetTabstripCollection()->InsertTabCollectionAt(std::move(owned), 0,
+                                                 /*pinned=*/false,
+                                                 std::nullopt);
+  MockTabCollectionObserver& observer = GetObserver();
+  const TabCollection::Handle handle = folder->GetHandle();
+
+  EXPECT_CALL(observer, OnCollectionDataChanged(handle)).Times(2);
+  folder->SetTitle("Later");
+  folder->SetCollapsed(true);
+  testing::Mock::VerifyAndClearExpectations(&observer);
+
+  // Nothing changed, so nobody hears anything.
+  EXPECT_CALL(observer, OnCollectionDataChanged).Times(0);
+  folder->SetTitle("Later");
+  folder->SetCollapsed(true);
+  EXPECT_EQ("Later", folder->title());
+  EXPECT_TRUE(folder->collapsed());
+}
+
 }  // namespace tabs
