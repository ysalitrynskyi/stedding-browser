+// P38-1b, spaces B25: at overflow the chips grow back to full size while the
+// pointer is on the row, and stay so when it moves off a chip onto the row's
+// own room, under the chip here; a gap between two chips is the same room.
+// They went back to dots there, and the chip aimed at moved away. The
+// pointer leaving the row from a chip still turns them back to dots.
+IN_PROC_BROWSER_TEST_F(SpaceSwitcherB28Test,
+                       OverflowChipsStayFullWhileThePointerIsOnTheRow) {
+  views::View* const root = widget()->GetRootView();
+  views::test::RunScheduledLayout(widget());
+  spaces::SpaceSwitcherView* const switcher = Switcher();
+  ASSERT_TRUE(switcher);
+  const spaces::SpaceId first = model()->active_id();
+  // Enough Spaces that the inactive chips are dots (spaces B24).
+  for (int added = 0; added < 40 && Dots() == 0; ++added) {
+    ASSERT_TRUE(model()->AddSpace("More " + base::NumberToString(added),
+                                  SK_ColorGRAY));
+  }
+  // The Space tint's theme change, a turn later, rebuilds the row.
+  base::RunLoop().RunUntilIdle();
+  views::test::RunScheduledLayout(widget());
+  ASSERT_GT(Dots(), 0) << "the row never turned to dots";
+  ASSERT_EQ(first, model()->active_id());
+  ASSERT_GE(model()->size(), 2u);
+  // The second Space's chip, near the row's start: a dot.
+  const spaces::SpaceId aimed = model()->spaces()[1]->id();
+  views::View* const chip = switcher->ChipForTesting(aimed);
+  ASSERT_TRUE(chip);
+  ASSERT_EQ(spaces::kSwitcherDot, chip->GetPreferredSize().width());
+
+  {
+    SCOPED_TRACE("the pointer on a dot");
+    const gfx::Point on_dot = InRoot(chip->GetBoundsInScreen().CenterPoint());
+    ASSERT_EQ(chip, root->GetEventHandlerForPoint(on_dot));
+    MovePointerTo(on_dot);
+    EXPECT_EQ(0, Dots()) << "the pointer on the row left dots";
+  }
+
+  {
+    SCOPED_TRACE("the pointer under the chip, on the row");
+    views::test::RunScheduledLayout(widget());
+    ASSERT_EQ(chip, switcher->ChipForTesting(aimed)) << "the row was rebuilt";
+    const gfx::Rect chip_box = chip->GetBoundsInScreen();
+    const gfx::Rect row_box = switcher->GetBoundsInScreen();
+    ASSERT_GT(row_box.bottom() - chip_box.bottom(), 2)
+        << "no room under the chip: " << chip_box.ToString() << " in "
+        << row_box.ToString();
+    const gfx::Point under = InRoot(gfx::Point(
+        chip_box.CenterPoint().x(), (chip_box.bottom() + row_box.bottom()) / 2));
+    ASSERT_EQ(switcher->icon_row_for_testing(),
+              root->GetEventHandlerForPoint(under))
+        << "the point is not on the row's own room";
+    MovePointerTo(under);
+    EXPECT_EQ(0, Dots())
+        << "the chips turned back to dots with the pointer on the row";
+  }
+
+  {
+    SCOPED_TRACE("the pointer leaves the row from a chip");
+    views::test::RunScheduledLayout(widget());
+    const gfx::Point on_chip = InRoot(chip->GetBoundsInScreen().CenterPoint());
+    ASSERT_EQ(chip, root->GetEventHandlerForPoint(on_chip));
+    MovePointerTo(on_chip);
+    const gfx::Point page = root->GetLocalBounds().CenterPoint();
+    ASSERT_FALSE(
+        switcher->ConvertRectToWidget(switcher->GetLocalBounds()).Contains(
+            page));
+    MovePointerTo(page);
+    EXPECT_GT(Dots(), 0) << "the chips stayed full with the pointer off the row";
+  }
+}
