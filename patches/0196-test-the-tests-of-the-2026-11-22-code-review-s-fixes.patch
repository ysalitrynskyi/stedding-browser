+namespace {
+
+using WindowLightsW2B26Test =
+    VerticalTabsBrowserTestMixin<InProcessBrowserTest>;
+
+// The three traffic lights' box in screen coordinates, top-left origin like
+// views'.
+gfx::Rect LightsInScreenW2B26(NSWindow* window) {
+  NSRect in_window = NSZeroRect;
+  for (const NSWindowButton type :
+       {NSWindowCloseButton, NSWindowMiniaturizeButton, NSWindowZoomButton}) {
+    NSButton* const button = [window standardWindowButton:type];
+    if (!button) {
+      continue;
+    }
+    in_window =
+        NSUnionRect(in_window, [button convertRect:button.bounds toView:nil]);
+  }
+  return gfx::ScreenRectFromNSRect([window convertRectToScreen:in_window]);
+}
+
+// P34-1g, sidebar Y55: with the sidebar hidden and the address row hidden,
+// the lights a rest at the window's top showed hide when the pointer leaves
+// the window from them -- up to the menu bar, or off the window's left --
+// as they do when it leaves them for the page. The window hears no moves
+// outside it, and they had stayed over the page's corner until the pointer
+// next moved inside the window.
+IN_PROC_BROWSER_TEST_F(WindowLightsW2B26Test,
+                       TheLightsHideWhenThePointerLeavesTheWindowFromThem) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser());
+  views::Widget* const widget = browser_view->GetWidget();
+  NSWindow* const window = widget->GetNativeWindow().GetNativeNSWindow();
+  ASSERT_TRUE(window);
+  VerticalTabStripRegionView* const region =
+      browser_view->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(region);
+  tabs::VerticalTabStripStateController* const sidebar =
+      tabs::VerticalTabStripStateController::From(browser());
+  ASSERT_TRUE(sidebar);
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+
+  sidebar->SetExpandOnHoverEnabled(false);
+  prefs->SetInteger(stedding::prefs::kSidebarClosedForm,
+                    stedding::prefs::kSidebarClosedHidden);
+  prefs->SetBoolean(stedding::prefs::kSidebarAddressInSidebar, true);
+  prefs->SetBoolean(stedding::prefs::kToolbarHideWithSidebar, true);
+  if (!sidebar->IsCollapsed()) {
+    sidebar->RequestCollapse(true);
+  }
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    views::test::RunScheduledLayout(widget);
+    return !BrowserAnimationController::From(browser())->IsAnimating(
+               TabStripAnimations::kVerticalTabStrip) &&
+           sidebar->IsCollapsed();
+  }));
+  ASSERT_FALSE(browser_view->IsToolbarVisible());
+
+  const gfx::Rect lights = LightsInScreenW2B26(window);
+  ASSERT_FALSE(lights.IsEmpty());
+  const gfx::Rect view_bounds = browser_view->GetBoundsInScreen();
+  const gfx::Rect window_bounds = widget->GetWindowBoundsInScreen();
+  region->PlayWindowPointerForTesting(view_bounds.CenterPoint(),
+                                      /*pressed=*/false);
+  ASSERT_TRUE(region->lights_hidden_for_testing())
+      << "the lights do not lie over the page alone";
+
+  // A rest at the window's top over them shows them.
+  const auto show_them = [&] {
+    region->PlayWindowPointerForTesting(
+        gfx::Point(lights.CenterPoint().x(), view_bounds.y() + 2),
+        /*pressed=*/false);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&] { return !region->lights_hidden_for_testing(); }))
+        << "a rest at the window's top did not show them";
+  };
+
+  {
+    SCOPED_TRACE("up, out of the window's top");
+    ASSERT_NO_FATAL_FAILURE(show_them());
+    region->PlayWindowPointerExitForTesting(
+        gfx::Point(lights.CenterPoint().x(), window_bounds.y() - 1));
+    EXPECT_TRUE(region->lights_hidden_for_testing())
+        << "the lights stayed over the page";
+  }
+  {
+    SCOPED_TRACE("left, out of the window's side");
+    ASSERT_NO_FATAL_FAILURE(show_them());
+    region->PlayWindowPointerExitForTesting(
+        gfx::Point(window_bounds.x() - 1, lights.CenterPoint().y()));
+    EXPECT_TRUE(region->lights_hidden_for_testing())
+        << "the lights stayed over the page";
+  }
+  {
+    SCOPED_TRACE("back over the page");
+    ASSERT_NO_FATAL_FAILURE(show_them());
+    region->PlayWindowPointerForTesting(view_bounds.CenterPoint(),
+                                        /*pressed=*/false);
+    EXPECT_TRUE(region->lights_hidden_for_testing());
+  }
+  region->SetPointerForTesting(std::nullopt);
+}
+
+}  // namespace
