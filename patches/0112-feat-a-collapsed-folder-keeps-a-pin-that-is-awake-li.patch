+  const RegistryEntry* const back = registry->Find(work);
+  ASSERT_TRUE(back);
+  EXPECT_EQ(token, back->profile_id) << "the Space came back without its jar";
+  EXPECT_TRUE(back->isolated) << "its Independent session came back off";
+  EXPECT_TRUE(other->SpaceIsIsolated(work));
