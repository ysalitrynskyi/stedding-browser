+// site-controls Si5: plus gives 110% on the label and on the tab, with no
+// zoom bubble over the panel, which stays; the percentage resets to 100%;
+// Cmd-plus pressed with the panel open shows at once.
+IN_PROC_BROWSER_TEST_F(SiteControlsTest, ZoomStepsAndFollowsTheKeys) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("site.test")));
+  views::BubbleDialogDelegateView* const panel = OpenFromTheChip();
+  SiteControlsStripView* const strip = Strip(panel);
+  ASSERT_TRUE(strip);
+  zoom::ZoomController* const zoom =
+      zoom::ZoomController::FromWebContents(page());
+  ASSERT_TRUE(zoom);
+  EXPECT_EQ(u"100%", strip->zoom_reset()->GetText());
+
+  Click(strip->zoom_in());
+  EXPECT_EQ(110, zoom->GetZoomPercent());
+  EXPECT_EQ(u"110%", strip->zoom_reset()->GetText());
+  EXPECT_EQ(u"Reset zoom, 110%",
+            strip->zoom_reset()->GetViewAccessibility().GetCachedName());
+  base::RunLoop().RunUntilIdle();
+  ZoomBubbleCoordinator* const zoom_bubble =
+      ZoomBubbleCoordinator::From(browser());
+  EXPECT_FALSE(zoom_bubble && zoom_bubble->IsShowing())
+      << "the zoom bubble opened over the panel";
+  EXPECT_EQ(panel, PageInfoBubbleViewBase::GetPageInfoBubbleForTesting())
+      << "the panel closed";
+
+  Click(strip->zoom_reset());
+  EXPECT_EQ(100, zoom->GetZoomPercent());
+  EXPECT_EQ(u"100%", strip->zoom_reset()->GetText());
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_ZOOM_PLUS));
+  EXPECT_EQ(u"110%", strip->zoom_reset()->GetText())
+      << "the key pressed with the panel open, the zoom did not follow";
+  ClosePanel();
+  chrome::ExecuteCommand(browser(), IDC_ZOOM_NORMAL);
