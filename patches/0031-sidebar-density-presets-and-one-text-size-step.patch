+int& TextSizeInForce() {
+  static int size = 0;
+  return size;
+}
+
+// The vertical room a row needs around its text: the pill's insets and a
+// little air, so a larger title never clips (Y2).
+constexpr int kRowTextInsets = 22;
+
+}  // namespace
+
+SidebarMetrics MetricsForDensity(SidebarDensity density) {
+  switch (density) {
+    case SidebarDensity::kComfortable:
+      return {kVerticalTabHeight.Get(), kVerticalTabPinnedHeight.Get(),
+              kTabFaviconSize.Get(), kVerticalTabCornerRadius.Get()};
+    case SidebarDensity::kCompact:
+      return {36, 40, 16, 8};
+    case SidebarDensity::kDense:
+      return {30, 34, 16, 6};
+  }
+  return {kVerticalTabHeight.Get(), kVerticalTabPinnedHeight.Get(),
+          kTabFaviconSize.Get(), kVerticalTabCornerRadius.Get()};
+}
+
+void SetSidebarDensity(SidebarDensity density) {
+  DensityInForce() = density;
+}
+
+SidebarDensity GetSidebarDensity() {
+  return DensityInForce();
+}
+
+void SetSidebarTextSize(int size) {
+  TextSizeInForce() = size > 0 ? size : 0;
+}
+
+int GetSidebarTextSize() {
+  return TextSizeInForce();
+}
+
+int SidebarRowHeight() {
+  const int preset = MetricsForDensity(DensityInForce()).row_height;
+  const int text = TextSizeInForce();
+  return text > 0 ? std::max(preset, text + kRowTextInsets) : preset;
+}
+
+int SidebarPinnedHeight() {
+  return MetricsForDensity(DensityInForce()).pinned_height;
+}
+
+int SidebarFaviconSize() {
+  return MetricsForDensity(DensityInForce()).favicon_size;
+}
+
+int SidebarCornerRadius() {
+  return MetricsForDensity(DensityInForce()).corner_radius;
+}
 }  // namespace stedding
