+SafariExportImporter::SafariExportImporter(
+    std::unique_ptr<user_data_importer::ContentBookmarkParser> bookmark_parser,
+    mojo::PendingRemote<password_manager::mojom::CSVPasswordParser> csv_parser)
+    : worker_(base::ThreadPool::CreateSequencedTaskRunner(
+                  {base::MayBlock(), base::TaskPriority::USER_VISIBLE}),
+              std::move(bookmark_parser)),
+      csv_parser_for_testing_(std::move(csv_parser)) {}
