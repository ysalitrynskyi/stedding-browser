+namespace {
+
+// windows G12: Show Here. The page keeps what it has; a Space with its own
+// session takes it in as any tab from another window (sessions S9).
+void ShowTabHere(BrowserWindowInterface* here, tabs::TabHandle handle) {
+  tabs::TabInterface* const tab = handle.Get();
+  BrowserWindowInterface* const there =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!there || there == here) {
+    return;
+  }
+  chrome::MoveTabsToExistingWindow(
+      there, here, {there->GetTabStripModel()->GetIndexOfTab(tab)});
+  SpaceModel* const model = SpaceModel::From(here);
+  if (model && !tab->IsPinned()) {
+    model->MoveTabsToSpace({tab}, model->active_id());
+    // A Space pin keeps its place above the Clear line (pins H14).
+    if (model->IsSpacePinned(tab)) {
+      model->MoveToSpacePinBoundary(tab);
+    }
+  }
+  TabStripModel* const strip = here->GetTabStripModel();
+  if (const int index = strip->GetIndexOfTab(tab);
+      index != TabStripModel::kNoTab) {
+    strip->ActivateTabAt(index);
+  }
+}
+
+// windows G12: Go to Window. A tab of a Space that window is not showing
+// brings that Space with it, as the bar's own row does in this window.
+void ShowTabWhereItIs(tabs::TabHandle handle) {
+  tabs::TabInterface* const tab = handle.Get();
+  BrowserWindowInterface* const there =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (!there) {
+    return;
+  }
+  SpaceModel* const model = SpaceModel::From(there);
+  if (model && !tab->IsPinned()) {
+    model->SetActiveSpace(model->SpaceForTab(tab), tab);
+  }
+  TabStripModel* const strip = there->GetTabStripModel();
+  strip->ActivateTabAt(strip->GetIndexOfTab(tab));
+  there->GetWindow()->Activate();
+}
+
+}  // namespace
+
+void AskWhereToShowTab(BrowserWindowInterface* window,
+                       tabs::TabInterface* tab) {
+  ui::BaseWindow* const base_window = window ? window->GetWindow() : nullptr;
+  if (!base_window || !tab) {
+    return;
+  }
+  const tabs::TabHandle handle = tab->GetHandle();
+  std::u16string name = stedding::TabName(tab->GetContents());
+  if (name.empty()) {
+    name = tab->GetTitle();
+  }
+  ui::DialogModel::Builder builder;
+  ui::DialogModel* const dialog = builder.model();
+  constrained_window::ShowBrowserModal(
+      builder.SetInternalName("SteddingTabElsewhereDialog")
+          .SetTitle(
+              l10n_util::GetStringUTF16(IDS_STEDDING_TAB_ELSEWHERE_TITLE))
+          .AddParagraph(ui::DialogModelLabel(std::move(name)))
+          .AddOkButton(base::BindOnce(&ShowTabHere, window, handle),
+                       ui::DialogModel::Button::Params().SetLabel(
+                           l10n_util::GetStringUTF16(
+                               IDS_STEDDING_TAB_ELSEWHERE_SHOW_HERE)))
+          .AddCancelButton(base::DoNothing())
+          .AddExtraButton(
+              base::BindRepeating(
+                  [](ui::DialogModel* dialog, tabs::TabHandle handle,
+                     const ui::Event&) {
+                    ShowTabWhereItIs(handle);
+                    dialog->host()->Close();
+                  },
+                  base::Unretained(dialog), handle),
+              ui::DialogModel::Button::Params().SetLabel(
+                  l10n_util::GetStringUTF16(
+                      IDS_STEDDING_TAB_ELSEWHERE_GO_TO_WINDOW)))
+          .Build(),
+      base_window->GetNativeWindow());
+}
