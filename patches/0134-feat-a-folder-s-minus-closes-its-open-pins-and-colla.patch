+// folders F44: no - where a press would do nothing or would delete rows: a
+// folder of plain rows, a folder with nothing open; and none in the rail,
+// during a rename or Change Icon, while the header is dragged, or under a tab
+// dragged over it.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, TheMinusShowsOnlyWhereItCanDoSomething) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  CloseDownToOne();
+  tabs::TabInterface* const pin = OpenPin("a.test");
+  tabs::TabInterface* const other_pin = OpenPin("b.test");
+  tabs::FolderTabCollection* const pinned = FolderOf({pin, other_pin});
+  ASSERT_TRUE(pinned);
+  tabs::TabInterface* const plain = OpenLoaded("c.test");
+  tabs::TabInterface* const other_plain = OpenLoaded("d.test");
+  tabs::FolderTabCollection* const loose = FolderOf({plain, other_plain});
+  ASSERT_TRUE(loose);
+  tabs::TabInterface* const elsewhere = OpenLoaded("e.test");
+  ASSERT_EQ(elsewhere, tab_strip_model()->GetActiveTab());
+  FolderView::SetOpensEmojiPanelForTesting(false);
+
+  {
+    SCOPED_TRACE("a folder of plain rows");
+    views::View* const minus = MinusUnderThePointer(loose);
+    ASSERT_TRUE(minus);
+    EXPECT_FALSE(minus->GetVisible());
+  }
+  {
+    SCOPED_TRACE("a rename");
+    FolderView* const header = DrawnFolder(pinned);
+    ASSERT_TRUE(header);
+    views::View* const minus = MinusUnderThePointer(pinned);
+    ASSERT_TRUE(minus->GetVisible());
+    header->ExecuteCommand(FolderView::kRenameCommand, 0);
+    EXPECT_FALSE(minus->GetVisible()) << "the - stayed beside the field";
+    header->rename_field_for_testing()->SetText(u"Work");
+    ui::KeyEvent enter(ui::EventType::kKeyPressed, ui::VKEY_RETURN,
+                       ui::EF_NONE);
+    header->HandleKeyEvent(header->rename_field_for_testing(), enter);
+    EXPECT_TRUE(minus->GetVisible()) << "the - did not come back";
+    header->ExecuteCommand(FolderView::kIconCommand, 0);
+    EXPECT_FALSE(minus->GetVisible()) << "the - stayed beside the icon's field";
+    ui::KeyEvent escape(ui::EventType::kKeyPressed, ui::VKEY_ESCAPE,
+                        ui::EF_NONE);
+    header->HandleKeyEvent(header->rename_field_for_testing(), escape);
+    EXPECT_TRUE(minus->GetVisible());
+  }
+  {
+    SCOPED_TRACE("a tab dragged over the header");
+    FolderView* const header = DrawnFolder(pinned);
+    ASSERT_TRUE(header);
+    views::View* const minus = MinusUnderThePointer(pinned);
+    ASSERT_TRUE(minus->GetVisible());
+    header->SetDropHighlight(true);
+    EXPECT_FALSE(minus->GetVisible());
+    header->SetDropHighlight(false);
+    EXPECT_TRUE(minus->GetVisible());
+  }
+  {
+    SCOPED_TRACE("a drag of the header");
+    FolderView* const header = DrawnFolder(pinned);
+    ASSERT_TRUE(header);
+    views::View* const minus = MinusUnderThePointer(pinned);
+    ASSERT_TRUE(minus->GetVisible());
+    const gfx::Point start = header->GetHeaderBoundsInScreen().CenterPoint();
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMousePressed,
+                                  start);
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseDragged,
+                                  start + gfx::Vector2d(0, 12));
+    ASSERT_TRUE(header->header_dragging_for_testing());
+    EXPECT_FALSE(minus->GetVisible()) << "the - stayed on a dragged header";
+    stedding::test::SendLeftMouse(widget(), ui::EventType::kMouseReleased,
+                                  start);
+    EXPECT_FALSE(header->header_dragging_for_testing());
+  }
+  {
+    SCOPED_TRACE("nothing open");
+    ASSERT_EQ(elsewhere, tab_strip_model()->GetActiveTab());
+    stedding::UnloadTabNow(pin);
+    stedding::UnloadTabNow(other_pin);
+    ASSERT_TRUE(WaitUntilAsleep(pin));
+    ASSERT_TRUE(WaitUntilAsleep(other_pin));
+    views::View* const minus = MinusUnderThePointer(pinned);
+    ASSERT_TRUE(minus);
+    EXPECT_TRUE(base::test::RunUntil([&]() { return !minus->GetVisible(); }))
+        << "a - with no open pin, under a pointer that did not move";
+    // One wakes: the - comes back at the pointer's next move.
+    tab_strip_model()->ActivateTabAt(IndexOf(pin));
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return !pin->GetContents()->WasDiscarded(); }));
+    views::View* const again = MinusUnderThePointer(pinned);
+    ASSERT_TRUE(again);
+    EXPECT_TRUE(again->GetVisible()) << "no - on a pin that woke";
+  }
+  {
+    SCOPED_TRACE("the rail");
+    tabs::VerticalTabStripStateController::From(browser())->RequestCollapse(
+        true);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return VerticalTabStripRegionView::IsRailWidth(
+          BrowserView::GetBrowserViewForBrowser(browser())
+              ->vertical_tab_strip_region_view_for_testing()
+              ->width());
+    }));
+    views::View* const minus = MinusUnderThePointer(pinned);
+    ASSERT_TRUE(minus);
+    EXPECT_FALSE(minus->GetVisible()) << "a - in the rail";
+  }
+}
