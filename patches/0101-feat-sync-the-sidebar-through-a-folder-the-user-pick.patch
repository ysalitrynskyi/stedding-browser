+Record::Record() = default;
+Record::Record(Kind kind) : kind(kind) {}
+Record::Record(const Record& other) = default;
+Record::Record(Record&& other) = default;
+Record& Record::operator=(const Record& other) = default;
+Record& Record::operator=(Record&& other) = default;
+Record::~Record() = default;
+
+Stamp Record::Latest() const {
+  Stamp latest{std::numeric_limits<int64_t>::min(), std::string()};
+  for (const auto& [name, field] : f) {
+    latest = std::max(latest, field.s);
+  }
+  return latest;
+}
+
+bool Record::Alive() const {
+  return !del || *del < Latest();
+}
+
+const std::string& Record::Get(std::string_view field) const {
+  const auto it = f.find(std::string(field));
+  return it == f.end() ? EmptyString() : it->second.v;
+}
