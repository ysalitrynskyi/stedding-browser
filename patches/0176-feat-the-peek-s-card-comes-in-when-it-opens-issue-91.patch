@@ -248,6 +249,53 @@ class PeekOverPageTest : public InProcessBrowserTest {
   }
 };
 
+// motion O10 (GitHub issue 91): the card comes in when the peek opens, from
+// nothing, and is whole once the motion ends. With motion off (O1, the
+// "Animate the sidebar and overlays" switch, or the system's Reduce Motion)
+// it shows as it is, as every peek did.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, TheCardComesInAndStillDoesNot) {
+  gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  ASSERT_NO_FATAL_FAILURE(OpenPin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  {
+    SCOPED_TRACE("motion on");
+    ClickLink();
+    stedding::PeekOverlay* const peek = WaitForPeek(pin);
+    ASSERT_TRUE(peek);
+    // Under load the motion may be over by now: whether it ran is the test.
+    EXPECT_TRUE(peek->came_in_for_testing())
+        << "the card showed with no motion";
+    ASSERT_TRUE(base::test::RunUntil([&] { return !peek->appearing(); }));
+    EXPECT_EQ(1.0f, peek->opacity_for_testing());
+    Press(peek->view()->close_button());
+    ASSERT_TRUE(WaitForNoPeek(pin));
+  }
+  {
+    SCOPED_TRACE("motion off in Settings");
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kUiAnimate, false);
+    ClickLink();
+    stedding::PeekOverlay* const peek = WaitForPeek(pin);
+    ASSERT_TRUE(peek);
+    EXPECT_FALSE(peek->came_in_for_testing());
+    EXPECT_EQ(1.0f, peek->opacity_for_testing());
+    Press(peek->view()->close_button());
+    ASSERT_TRUE(WaitForNoPeek(pin));
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kUiAnimate, true);
+  }
+  {
+    SCOPED_TRACE("Reduce Motion on");
+    gfx::Animation::SetPrefersReducedMotionForTesting(true);
+    ClickLink();
+    stedding::PeekOverlay* const peek = WaitForPeek(pin);
+    ASSERT_TRUE(peek);
+    EXPECT_FALSE(peek->came_in_for_testing());
+    EXPECT_EQ(1.0f, peek->opacity_for_testing());
+    gfx::Animation::SetPrefersReducedMotionForTesting(false);
+  }
+}
