+std::vector<SwitcherSpan> SpaceSwitcherView::ChipSpans() const {
+  // Along the row's own axis: the rail stacks the chips, so there it is y;
+  // measuring x there sent every drag to the first place (PLAN.md SPC-6).
+  std::vector<SwitcherSpan> spans;
+  for (const auto& chip : chips_) {
