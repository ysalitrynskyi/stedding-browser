@@ -559,6 +559,100 @@ IN_PROC_BROWSER_TEST_F(SidebarSyncTest, OnlyTheUsersOwnRemovalTravels) {
 // Sf25: a loaded pin another computer moves out of a Space with its own
 // session onto the shared essentials row, which is in the profile's
 // session, waits for Move now like a move into another Space's session.
+// sessions S51: two Spaces another computer made in one session arrive on one
+// new jar here, by the session's id, with no question: they have no tabs to
+// move and nobody loses anything.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, ASpaceMadeBySyncJoinsItsSessionById) {
+  const std::string session = base::Token::CreateRandom().ToString();
+  const std::string mail = base::Token::CreateRandom().ToString();
+  const std::string docs = base::Token::CreateRandom().ToString();
+  const int64_t start = NowMs();
+  const sb::Stamp stamp{start, kPeer};
+  sb::State peer = PeerState(mail, {}, start, "Mail");
+  sb::Record second = peer.records[mail];
+  second.f[sb::kFieldName] = sb::Field{"Docs", stamp};
+  peer.records[docs] = second;
+  peer.lists[sb::kSpacesList].order = {mail, docs};
+  for (const std::string& id : {mail, docs}) {
+    peer.records[id].f[sb::kFieldIsolated] = sb::Field{"1", stamp};
+    peer.records[id].f[sb::kFieldSession] =
+        sb::Field{sb::SessionFieldValue(session, "Work"), stamp};
+  }
+  WritePeer(peer, 1);
+  Join(/*combine=*/false);
+
+  EXPECT_EQ(session, model().SessionOf(SpaceOf(mail)));
+  EXPECT_EQ(session, model().SessionOf(SpaceOf(docs)));
+  ASSERT_TRUE(model().registry()->FindSession(session));
+  EXPECT_EQ("Work", model().registry()->FindSession(session)->name);
+}
+
+// sessions S51, Sf24: an existing Space never moves on its own. Another
+// computer's session is a row; "Not on this computer" holds until a newer
+// change; Join here moves it and erases nothing.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest,
+                       AnExistingSpaceAsksBeforeItJoinsASession) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  const std::string session = base::Token::CreateRandom().ToString();
+  const int64_t start = NowMs();
+  sb::State peer = PeerState(space, {}, start, "Work");
+  peer.records[space].f[sb::kFieldIsolated] =
+      sb::Field{"1", sb::Stamp{start, kPeer}};
+  WritePeer(peer, 1);
+  Join(/*combine=*/false);
+  const spaces::SpaceId id = SpaceOf(space);
+  const std::string own = model().SessionOf(id);
+  ASSERT_FALSE(own.empty());
+
+  const sb::Stamp later{NowMs() + 60'000, kPeer};
+  peer.records[space].f[sb::kFieldSession] =
+      sb::Field{sb::SessionFieldValue(session, "Shared work"), later};
+  WritePeer(peer, 2);
+  Scan();
+  EXPECT_EQ(own, model().SessionOf(id)) << "it moved without a yes";
+  const std::string row = "isolation:" + space;
+  ASSERT_TRUE(Decision(row)) << "no row";
+  EXPECT_EQ("Shared work", *Decision(row)->FindString("sessionName"));
+
+  ASSERT_TRUE(service()->ResolveDecision(row, "keep"));
+  Scan();
+  EXPECT_FALSE(Decision(row)) << "Not on this computer holds";
+  EXPECT_EQ(own, model().SessionOf(id));
+
+  const std::string next = base::Token::CreateRandom().ToString();
+  peer.records[space].f[sb::kFieldSession] = sb::Field{
+      sb::SessionFieldValue(next, "Next"), sb::Stamp{NowMs() + 120'000, kPeer}};
+  WritePeer(peer, 3);
+  Scan();
+  ASSERT_TRUE(Decision(row)) << "a newer change asks again";
+
+  ASSERT_TRUE(service()->ResolveDecision(row, "turn"));
+  EXPECT_EQ(next, model().SessionOf(id));
+  EXPECT_TRUE(model().registry()->FindSession(own))
+      << "what this computer was signed in to is kept";
+}
+
+// sessions S51: two computers that each made a session called Work have two
+// sessions. A Space joins a jar under the id it was given, never the name.
+IN_PROC_BROWSER_TEST_F(SidebarSyncTest, TwoSessionsOfOneNameStayTwo) {
+  const std::string here = model().MakeSession("Work");
+  const std::string there = base::Token::CreateRandom().ToString();
+  const std::string mail = base::Token::CreateRandom().ToString();
+  const int64_t start = NowMs();
+  sb::State peer = PeerState(mail, {}, start, "Mail");
+  peer.records[mail].f[sb::kFieldIsolated] =
+      sb::Field{"1", sb::Stamp{start, kPeer}};
+  peer.records[mail].f[sb::kFieldSession] =
+      sb::Field{sb::SessionFieldValue(there, "Work"), sb::Stamp{start, kPeer}};
+  WritePeer(peer, 1);
+  Join(/*combine=*/false);
+
+  EXPECT_EQ(there, model().SessionOf(SpaceOf(mail)));
+  EXPECT_NE(here, model().SessionOf(SpaceOf(mail)));
+  EXPECT_EQ("Work", model().registry()->FindSession(here)->name);
+  EXPECT_EQ("Work 2", model().registry()->FindSession(there)->name);
+}
+
