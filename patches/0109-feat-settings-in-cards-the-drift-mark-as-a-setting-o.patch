+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(),
+                                           GURL("chrome://settings/stedding")));
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  const std::string field = content::JsReplace(
+      "pick('cr-input.route-add[data-id=\"' + $1 + '\"]')", home);
+  const auto type = [&](const std::string& text) {
+    return content::ExecJs(
+        page, OnThePage(content::JsReplace(
+                  "const field = " + field +
+                      "; field.value = $1;"
+                      " field.dispatchEvent(new Event('change'));",
+                  text)));
+  };
+  const auto field_reads = [&]() {
+    return content::EvalJs(page, OnThePage("const field = " + field +
+                                           "; return field.value + '|' +"
+                                           " String(field.invalid);"))
+        .ExtractString();
+  };
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page, OnThePage("return !!" + field + ";"))
+        .ExtractBool();
+  })) << "the Space has no field";
+
+  ASSERT_TRUE(type("https://"));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return field_reads() == "https://|true"; }))
+      << field_reads();
+  EXPECT_TRUE(spaces::ReadRoutes(prefs).empty());
+
+  ASSERT_TRUE(type("github.com"));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return field_reads() == "|false"; }))
+      << field_reads();
+  const std::vector<spaces::Route> routes = spaces::ReadRoutes(prefs);
+  ASSERT_EQ(1u, routes.size());
+  EXPECT_EQ("github.com", routes.front().pattern);
+}
