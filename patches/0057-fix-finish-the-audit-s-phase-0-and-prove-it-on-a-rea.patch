+// PLAN.md WEB-7, archive A8: the same through the two ways a person
+// restores. A tab signed in to a site, in a folder of an unnamed Space with
+// its own jar, closes; the Spaces are reordered; then the archive page's
+// Restore button, or ⌘T's archived row, brings it back into that Space and
+// folder, still signed in, with nothing from the shared jar.
+class ArchiveRestoreTest : public RestoreTest {
+ protected:
+  // Closes the signed-in tab and reorders the Spaces.
+  void CloseASignedInFolderTab() {
+    spaces::SpaceModel* const m = model();
+    ASSERT_TRUE(m);
+    home_ = m->active_id();
+    work_ = m->AddSpace(std::string(), SK_ColorBLUE)->id();
+    m->SetSpaceIsolated(work_, true);
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(),
+        embedded_test_server()->GetURL("site.test", "/set-cookie?who=shared")));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("home.test")));
+
+    ASSERT_TRUE(m->SetActiveSpace(work_));
+    tabs::TabInterface* const kept = Open("kept.test");
+    tabs::TabInterface* const closed = Open("site.test");
+    ASSERT_TRUE(content::NavigateToURL(
+        closed->GetContents(),
+        embedded_test_server()->GetURL("site.test", "/set-cookie?who=work")));
+    // A page with a title, still signed in.
+    ASSERT_TRUE(content::NavigateToURL(
+        closed->GetContents(),
+        embedded_test_server()->GetURL("site.test", "/title2.html")));
+    folder_ = tabs()->AddToNewFolder({Index(kept), Index(closed)});
+    ASSERT_TRUE(folder_);
+    tabs()->CloseWebContentsAt(Index(closed),
+                               TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+    ASSERT_TRUE(m->SetActiveSpace(home_));
+    ASSERT_TRUE(m->MoveSpace(work_, -1));
+    ASSERT_EQ(work_, m->spaces()[0]->id()) << "the Spaces were reordered";
+  }
+
+  void ExpectItBackInItsSpaceFolderAndJar() {
+    ASSERT_TRUE(base::test::RunUntil([&]() { return Find("site.test"); }));
+    tabs::TabInterface* const back = Find("site.test");
+    EXPECT_EQ(work_, model()->SpaceForTab(back));
+    EXPECT_EQ(folder_, FolderOf(back)) << "back in its folder";
+    EXPECT_TRUE(spaces::IsSpaceStoragePartition(
+        spaces::StoragePartitionConfigForWebContents(back->GetContents())));
+    ASSERT_TRUE(content::NavigateToURL(
+        back->GetContents(),
+        embedded_test_server()->GetURL("site.test", "/echoheader?Cookie")));
+    EXPECT_EQ("who=work",
+              content::EvalJs(back->GetContents(), "document.body.innerText"))
+        << "signed in as in the Space, and nothing from the shared jar";
+  }
+
+  SpaceId home_ = SpaceId::GenerateNew();
+  SpaceId work_ = SpaceId::GenerateNew();
+  raw_ptr<const tabs::FolderTabCollection> folder_ = nullptr;
+};
+
+IN_PROC_BROWSER_TEST_F(ArchiveRestoreTest, TheArchivePageRestoresIt) {
+  CloseASignedInFolderTab();
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), GURL("chrome://stedding-archive"),
+      WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const page = tabs()->GetActiveWebContents();
+  const std::string row =
+      "[...document.querySelectorAll('.row')].find(row =>"
+      "  row.querySelector('.title').textContent === 'Title Of Awesomeness')";
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return content::EvalJs(page, "!!" + row).ExtractBool(); }));
+  // The row's own Restore button, as a click on it.
+  ASSERT_TRUE(content::ExecJs(page, row + ".querySelector('button').click()"));
+  ExpectItBackInItsSpaceFolderAndJar();
+}
+
+IN_PROC_BROWSER_TEST_F(ArchiveRestoreTest, TheCommandBarRestoresIt) {
+  CloseASignedInFolderTab();
+  chrome::ExecuteCommand(browser(), IDC_NEW_TAB);  // ⌘T
+  stedding::CommandBarView* const bar = stedding::CommandBarView::GetOpenBar(
+      BrowserView::GetBrowserViewForBrowser(browser()));
+  ASSERT_TRUE(bar);
+  bar->field_for_testing()->SetText(u"Awesomeness");
+  bar->ContentsChanged(bar->field_for_testing(), u"Awesomeness");
+  std::optional<size_t> archived;
+  for (size_t i = 0; i < bar->row_count_for_testing(); ++i) {
+    if (bar->row_title_for_testing(i) == u"Title Of Awesomeness" &&
+        bar->row_detail_for_testing(i).starts_with(u"Archived")) {
+      archived = i;
+      break;
+    }
+  }
+  ASSERT_TRUE(archived.has_value()) << "the closed tab is listed";
+  views::View* const field = bar->field_for_testing();
+  for (size_t i = 0; i < *archived; ++i) {
+    field->OnKeyPressed(
+        ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_DOWN, ui::EF_NONE));
+  }
+  ASSERT_EQ(*archived, bar->selected_row_for_testing());
+  field->OnKeyPressed(
+      ui::KeyEvent(ui::EventType::kKeyPressed, ui::VKEY_RETURN, ui::EF_NONE));
+  ExpectItBackInItsSpaceFolderAndJar();
+}
+
+// PLAN.md TAB-12: a window closed with its folders and reopened from History
+// has them again.
+IN_PROC_BROWSER_TEST_F(RestoreTest, AWindowFromHistoryHasItsFolders) {
+  BrowserWindowInterface* const second = CreateBrowser(browser()->GetProfile());
+  TabStripModel* const strip = second->GetTabStripModel();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(second, Url("w1.test")));
+  for (const char* host : {"w2.test", "w3.test"}) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        second, Url(host), WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  }
+  tabs::FolderTabCollection* const folder = strip->AddToNewFolder({1, 2});
+  ASSERT_TRUE(folder);
+  folder->SetTitle("Kept");
+  CloseBrowserSynchronously(second);
+
+  ui_test_utils::BrowserCreatedObserver reopened;
+  chrome::RestoreTab(browser());
+  BrowserWindowInterface* const window = reopened.Wait();
+  ASSERT_TRUE(window);
+  TabStripModel* const again = window->GetTabStripModel();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    if (again->count() != 3) {
+      return false;
+    }
+    const tabs::TabCollection* const parent =
+        again->GetTabAtIndex(1)->GetParentCollection();
+    return parent && parent->type() == tabs::TabCollection::Type::FOLDER &&
+           again->GetTabAtIndex(2)->GetParentCollection() == parent;
+  })) << "the folder came back with its two tabs";
+  const auto* const kept = static_cast<const tabs::FolderTabCollection*>(
+      again->GetTabAtIndex(1)->GetParentCollection());
+  EXPECT_EQ("Kept", kept->title());
+  EXPECT_NE(again->GetTabAtIndex(0)->GetParentCollection(),
+            again->GetTabAtIndex(1)->GetParentCollection());
+}
+
+// TST-4, PLAN.md WEB-7: ⌘⇧T brings a closed tab back to its Space, in its
+// Space's jar, with its name.
+IN_PROC_BROWSER_TEST_F(RestoreTest, ReopeningAClosedTabBringsItBackToItsSpace) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const SpaceId home = m->active_id();
+  const SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+  m->SetSpaceIsolated(work, true);
+  ASSERT_TRUE(m->SetActiveSpace(work));
+  tabs::TabInterface* const tab = Open("closed.test");
+  stedding::SetTabName(browser(), tab, u"Notes");
+  ASSERT_TRUE(spaces::IsSpaceStoragePartition(
+      spaces::StoragePartitionConfigForWebContents(tab->GetContents())));
+  ASSERT_TRUE(m->SetActiveSpace(home));
+  tabs()->CloseWebContentsAt(Index(tab),
+                             TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  ASSERT_FALSE(Find("closed.test"));
+
+  ui_test_utils::TabAddedWaiter added(browser());
+  chrome::RestoreTab(browser());
+  added.Wait();
+
+  tabs::TabInterface* const back = Find("closed.test");
+  ASSERT_TRUE(back);
+  EXPECT_EQ(work, m->SpaceForTab(back));
+  EXPECT_TRUE(spaces::IsSpaceStoragePartition(
+      spaces::StoragePartitionConfigForWebContents(back->GetContents())))
+      << "back in its Space's jar, not the shared one";
+  EXPECT_EQ(u"Notes", stedding::TabName(back->GetContents()));
+}
+
+}  // namespace
diff --git a/chrome/test/stedding/screenshot_browsertest.cc b/chrome/test/stedding/screenshot_browsertest.cc
new file mode 100644
index 0000000000000..04357fddfa31c
--- /dev/null
+++ b/chrome/test/stedding/screenshot_browsertest.cc
@@ -0,0 +1,143 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// The screenshot commands on a real page (docs/features/screenshot.md,
+// PLAN.md WIN-2): a capture writes its PNG, and a tab or a private window
+// that goes away while a capture runs leaves the capture nothing to touch.
+// Captures land in a temporary Downloads folder, never the real one.
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/callback.h"
+#include "base/location.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/test/run_until.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/time/time.h"
+#include "chrome/browser/download/download_prefs.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/screenshot/screenshot_capture.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/browser_test.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/clipboard/clipboard.h"
+#include "ui/base/clipboard/test/test_clipboard.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+class ScreenshotCaptureTest : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(downloads_.CreateUniqueTempDir());
+    UseTemporaryDownloads(browser()->GetProfile());
+    // A capture is copied too: to a test clipboard, not the machine's own.
+    ui::TestClipboard::CreateForCurrentThread();
+  }
+
+  void TearDownOnMainThread() override {
+    ui::Clipboard::DestroyClipboardForCurrentThread();
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  void UseTemporaryDownloads(Profile* profile) {
+    profile->GetPrefs()->SetFilePath(prefs::kDownloadDefaultDirectory,
+                                     downloads_.GetPath());
+  }
+
+  int PngCount() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    int count = 0;
+    base::FileEnumerator files(downloads_.GetPath(), /*recursive=*/false,
+                               base::FileEnumerator::FILES,
+                               FILE_PATH_LITERAL("*.png"));
+    for (base::FilePath path = files.Next(); !path.empty();
+         path = files.Next()) {
+      ++count;
+    }
+    return count;
+  }
+
+  // Lets every step a capture posted run, the copy's own time-out included.
+  void Settle(base::TimeDelta for_how_long) {
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, run_loop.QuitClosure(), for_how_long);
+    run_loop.Run();
+  }
+
+  base::ScopedTempDir downloads_;
+};
+
+IN_PROC_BROWSER_TEST_F(ScreenshotCaptureTest, AFullPageCaptureWritesAFile) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kFullPage);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return PngCount() == 1; }));
+}
+
+// PLAN.md WIN-2: two captures within a second leave two files, not one
+// written over the other.
+IN_PROC_BROWSER_TEST_F(ScreenshotCaptureTest, TwoQuickCapturesLeaveTwoFiles) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kVisible);
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kVisible);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return PngCount() == 2; }));
+  Settle(base::Seconds(1));
+  EXPECT_EQ(2, PngCount());
+}
+
+IN_PROC_BROWSER_TEST_F(ScreenshotCaptureTest, ClosingTheTabMidCaptureIsSafe) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title1.html")));
+  // A second tab keeps the window when the first goes. It need not finish
+  // loading: a background tab's renderer runs at a low priority on the Mac.
+  chrome::AddTabAt(browser(), embedded_test_server()->GetURL("/title2.html"),
+                   /*index=*/-1, /*foreground=*/false);
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  tabs->ActivateTabAt(0);
+
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kFullPage);
+  tabs->CloseWebContentsAt(0, TabCloseTypes::CLOSE_NONE);
+  Settle(base::Seconds(2));
+
+  EXPECT_EQ(1, tabs->count());
+  // A capture started on the tab still there works.
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kVisible);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return PngCount() >= 1; }));
+}
+
+IN_PROC_BROWSER_TEST_F(ScreenshotCaptureTest,
+                       ClosingAPrivateWindowMidCaptureIsSafe) {
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+  UseTemporaryDownloads(incognito->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      incognito, embedded_test_server()->GetURL("/title1.html")));
+
+  stedding::CaptureScreenshot(incognito, stedding::CaptureMode::kFullPage);
+  CloseBrowserSynchronously(incognito);
+  Settle(base::Seconds(2));
+
+  // The regular window is untouched and still captures.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/title2.html")));
+  stedding::CaptureScreenshot(browser(), stedding::CaptureMode::kVisible);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return PngCount() >= 1; }));
+}
+
+}  // namespace
