+void SpaceModel::SetFocus(bool focus) {
+  in_focus_ = focus;
+}
+
+void SpaceModel::SetShareCoat(bool coat) {
+  share_coat_ = coat;
+}
+
+Space* SpaceModel::AddThrowawaySpace() {
+  Space* const space = AddSpace("Throwaway", SK_ColorGRAY);
+  if (!space) {
+    return nullptr;
+  }
+  if (registry_) {
+    registry_->EnsureThrowaway(space->id());
+    if (const RegistryEntry* const entry = registry_->Find(space->id())) {
+      isolated_jars_[space->id()] = entry->profile_id;
+    }
+  }
+  return space;
+}
+
+bool SpaceModel::SpaceIsThrowaway(const SpaceId& id) const {
+  if (!registry_) {
+    return false;
+  }
+  const RegistryEntry* const entry = registry_->Find(id);
+  return entry && entry->in_memory;
+}
