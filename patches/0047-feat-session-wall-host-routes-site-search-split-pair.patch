+// splits J1: both panes re-emit the same stedding.split token.
+TEST_F(SessionRebuildTest, SplitIdSurvivesRebuild) {
+  AddTab(browser(), GURL("https://example.com/a"));
+  tabs::TabInterface* const a = tabs().GetActiveTab();
+  AddTab(browser(), GURL("https://example.com/b"));
+  tabs::TabInterface* const b = tabs().GetActiveTab();
+  tabs().AddToNewSplit({tabs().GetIndexOfTab(a)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(a->IsSplit() && b->IsSplit());
+  const std::string token = a->GetSplit()->ToString();
+
+  const std::unique_ptr<sessions::SessionWindow> window = RebuildAndRestore();
+  int found = 0;
+  for (const auto& tab : window->tabs) {
+    const std::string& split = ExtraData(tab->extra_data, kSessionTabSplitKey);
+    if (tab->tab_id ==
+            sessions::SessionTabHelper::IdForTab(a->GetContents()) ||
+        tab->tab_id ==
+            sessions::SessionTabHelper::IdForTab(b->GetContents())) {
+      EXPECT_EQ(token, split);
+      ++found;
+    }
+  }
+  EXPECT_EQ(2, found);
+}
