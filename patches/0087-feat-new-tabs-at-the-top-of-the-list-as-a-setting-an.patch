+// static
+std::vector<SkColor> EditSpaceView::PaletteColors() {
+  std::vector<SkColor> colors;
+  for (const SpaceColorChoice& choice : kSpaceColors) {
+    colors.push_back(color_utils::AlphaBlend(SK_ColorBLACK, choice.color,
+                                             static_cast<SkAlpha>(0.30 * 255)));
+  }
+  for (const SpaceColorChoice& choice : kSpaceColors) {
+    colors.push_back(choice.color);
+  }
+  for (const SpaceColorChoice& choice : kSpaceColors) {
+    colors.push_back(color_utils::AlphaBlend(SK_ColorWHITE, choice.color,
+                                             static_cast<SkAlpha>(0.45 * 255)));
+  }
+  return colors;
+}
