From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Thu, 24 Sep 2026 08:27:26 -0400
Subject: spaces: the list slides in from the side of the Space being entered

Changing Space swapped the sidebar's rows in one frame; Arc animates the
change, and the operator read the swap as "no animation for scroll
between spaces" (round 10, 2026-09-24).

The Space's own rows -- its pins, tabs and folders, the unpinned list --
now come in from the side of the Space being entered: from the right for
a Space later in the switcher, from the left for an earlier one,
mirrored in a right-to-left UI, 36 DIP and a fade over 200 ms with an
ease-out, whatever changed the Space (the switcher, the keys, the
swipe). The essentials above stay still. Nothing moves when
stedding::ShouldAnimate() says no (motion O1).

The tab visibility controller, which swaps the rows, reports the two
Spaces after it does; the region view animates the list's layer.

Why: docs/features/spaces.md B32.
Removable when: never; the slide is Stedding's.
---
 chrome/browser/ui/stedding/motion.cc          |  8 +++
 chrome/browser/ui/stedding/motion.h           | 10 ++++
 chrome/browser/ui/stedding/motion_unittest.cc | 11 ++++
 .../frame/vertical_tab_strip_region_view.cc   | 54 +++++++++++++++++++
 .../frame/vertical_tab_strip_region_view.h    |  4 ++
 .../spaces/space_tab_visibility_controller.cc |  3 ++
 .../spaces/space_tab_visibility_controller.h  |  9 ++++
 7 files changed, 99 insertions(+)

diff --git a/chrome/browser/ui/stedding/motion.cc b/chrome/browser/ui/stedding/motion.cc
index efaf4c2385034..fcf19696c5c3e 100644
--- a/chrome/browser/ui/stedding/motion.cc
+++ b/chrome/browser/ui/stedding/motion.cc
@@ -21,4 +21,12 @@ bool ShouldAnimate(const PrefService* prefs) {
   return !prefs || prefs->GetBoolean(prefs::kUiAnimate);
 }
 
+int SpaceSlideDirection(int from_index, int to_index, bool rtl) {
+  if (from_index < 0 || to_index < 0 || from_index == to_index) {
+    return 0;
+  }
+  const int direction = to_index > from_index ? 1 : -1;
+  return rtl ? -direction : direction;
+}
+
 }  // namespace stedding
diff --git a/chrome/browser/ui/stedding/motion.h b/chrome/browser/ui/stedding/motion.h
index 35e1d7fb7248c..f97b05c8051b3 100644
--- a/chrome/browser/ui/stedding/motion.h
+++ b/chrome/browser/ui/stedding/motion.h
@@ -16,6 +16,16 @@ namespace stedding {
 // profile's; null means no profile is at hand and only the system decides.
 bool ShouldAnimate(const PrefService* prefs);
 
+// docs/features/spaces.md B32: when the active Space changes, the sidebar's
+// list slides in from the side of the Space being entered. +1 means from the
+// right (a Space later in the switcher), -1 from the left, 0 no slide (the
+// same Space, or an index that is not known). Mirrored under right-to-left.
+int SpaceSlideDirection(int from_index, int to_index, bool rtl);
+
+// How far the list starts from its place, and how long it takes to settle.
+inline constexpr int kSpaceSlideOffsetDip = 36;
+inline constexpr int kSpaceSlideDurationMs = 200;
+
 }  // namespace stedding
 
 #endif  // CHROME_BROWSER_UI_STEDDING_MOTION_H_
diff --git a/chrome/browser/ui/stedding/motion_unittest.cc b/chrome/browser/ui/stedding/motion_unittest.cc
index e1f0cfcc1917a..09749bb9c2354 100644
--- a/chrome/browser/ui/stedding/motion_unittest.cc
+++ b/chrome/browser/ui/stedding/motion_unittest.cc
@@ -49,4 +49,15 @@ TEST_F(MotionTest, CaptureParameterStillsIt) {
 }
 
 }  // namespace
+// Spaces B32: the next Space comes in from the right, the previous one from
+// the left, mirrored in a right-to-left UI; nothing slides for the same Space.
+TEST(SpaceSlideTest, ComesInFromTheSideOfTheSpaceBeingEntered) {
+  EXPECT_EQ(1, SpaceSlideDirection(0, 1, /*rtl=*/false));
+  EXPECT_EQ(1, SpaceSlideDirection(0, 3, /*rtl=*/false));
+  EXPECT_EQ(-1, SpaceSlideDirection(2, 1, /*rtl=*/false));
+  EXPECT_EQ(-1, SpaceSlideDirection(0, 1, /*rtl=*/true));
+  EXPECT_EQ(0, SpaceSlideDirection(1, 1, /*rtl=*/false));
+  EXPECT_EQ(0, SpaceSlideDirection(-1, 1, /*rtl=*/false));
+}
+
 }  // namespace stedding
