@@ -0,0 +1,274 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/stedding_library/stedding_library_handler.h"
+
+#include <cstdint>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/time/time.h"
+#include "chrome/browser/history/history_utils.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/file_trash.h"
+#include "chrome/browser/ui/stedding/sidebar_panels.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/webui/webui_embedding_context.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/download/public/common/download_item.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/download_manager.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "net/base/url_util.h"
+#include "ui/base/clipboard/clipboard_buffer.h"
+#include "ui/base/clipboard/file_info.h"
+#include "ui/base/clipboard/scoped_clipboard_writer.h"
+#include "ui/base/page_transition_types.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+// The first argument of a promise's message: its callback id.
+const std::string* CallbackId(const base::ListValue& args) {
+  return args.empty() ? nullptr : args[0].GetIfString();
+}
+
+}  // namespace
+
+LibraryHandler::LibraryHandler() = default;
+LibraryHandler::~LibraryHandler() = default;
+
+void LibraryHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "openUrl", base::BindRepeating(&LibraryHandler::HandleOpenUrl,
+                                     base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "copyFile", base::BindRepeating(&LibraryHandler::HandleCopyFile,
+                                      base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "moveToTrash", base::BindRepeating(&LibraryHandler::HandleMoveToTrash,
+                                         base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "closePanel", base::BindRepeating(&LibraryHandler::HandleClosePanel,
+                                        base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "openAsPage", base::BindRepeating(&LibraryHandler::HandleOpenAsPage,
+                                        base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "rangeStart", base::BindRepeating(&LibraryHandler::HandleRangeStart,
+                                        base::Unretained(this)));
+}
+
+BrowserWindowInterface* LibraryHandler::GetBrowser() {
+  return webui::GetBrowserWindowInterface(web_ui()->GetWebContents());
+}
+
+download::DownloadItem* LibraryHandler::FinishedDownload(
+    const base::Value& id) {
+  const std::string* const text = id.GetIfString();
+  uint32_t value = 0;
+  if (!text || !base::StringToUint(*text, &value)) {
+    return nullptr;
+  }
+  content::DownloadManager* const manager =
+      Profile::FromWebUI(web_ui())->GetDownloadManager();
+  // The id is the one the Downloads page's list gives each row (its
+  // DownloadsListTracker), the download's number.
+  download::DownloadItem* const item =
+      manager ? manager->GetDownload(value) : nullptr;
+  // Pn12: a file whose deep scan failed is not "dangerous" to Chromium, but
+  // its Downloads page and bubble open it only from their warning.
+  if (!item || item->GetState() != download::DownloadItem::COMPLETE ||
+      item->GetFileExternallyRemoved() || item->IsDangerous() ||
+      item->GetDangerType() ==
+          download::DOWNLOAD_DANGER_TYPE_DEEP_SCANNED_FAILED ||
+      item->GetTargetFilePath().empty()) {
+    return nullptr;
+  }
+  return item;
+}
+
+void LibraryHandler::HandleOpenUrl(const base::ListValue& args) {
+  if (args.size() != 2U) {
+    return;
+  }
+  const std::string* const text = args[0].GetIfString();
+  const std::string* const how = args[1].GetIfString();
+  if (!text || !how) {
+    return;
+  }
+  const GURL url(*text);
+  // A row is a page the user visited, and history keeps no other kind, so
+  // the page may ask to open nothing a row could not hold: no script
+  // address, no chrome: page (the panel's own, or chrome://quit and
+  // chrome://restart, which quit or restart the browser; chrome://crash and
+  // chrome://kill, which go to the tab's renderer), no view-source: or
+  // about:. The check is the one Chromium's own history page makes before
+  // it opens a row (BACKLOG S-347).
+  if (!CanAddURLToHistory(url)) {
+    return;
+  }
+  BrowserWindowInterface* const browser = GetBrowser();
+  if (!browser) {
+    return;
+  }
+  WindowOpenDisposition disposition = WindowOpenDisposition::CURRENT_TAB;
+  if (*how == "background") {
+    disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+  } else if (*how == "window") {
+    disposition = WindowOpenDisposition::NEW_WINDOW;
+  } else if (*how != "current") {
+    return;
+  }
+  // Pn7: a row opens in the active tab, unless that tab is pinned -- an
+  // essential or a pin of its Space -- whose page it would carry off (pins
+  // H4); then in a new tab beside it, where a link from the pin opens. The
+  // transition below names no place, and the tab had gone to the end of the
+  // strip, past the other pins and the tabs after them (BACKLOG S-347).
+  int index = -1;
+  if (disposition == WindowOpenDisposition::CURRENT_TAB) {
+    TabStripModel* const strip = browser->GetTabStripModel();
+    const tabs::TabInterface* const active =
+        strip ? strip->GetActiveTab() : nullptr;
+    const spaces::SpaceModel* const model = spaces::SpaceModel::From(browser);
+    if (!active || active->IsPinned() ||
+        (model && model->IsSpacePinned(active))) {
+      disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      if (active) {
+        index = strip->GetIndexOfTab(active) + 1;
+      }
+    }
+  }
+  // The transition of a page chosen from the browser's own lists, as a
+  // bookmark is: not a typed address, so it does not count toward the
+  // address bar's typed suggestions.
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = disposition;
+  params.tabstrip_index = index;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+}
+
+void LibraryHandler::HandleCopyFile(const base::ListValue& args) {
+  const std::string* const callback_id = CallbackId(args);
+  if (!callback_id || args.size() != 2U) {
+    return;
+  }
+  bool copied = false;
+  if (download::DownloadItem* const item = FinishedDownload(args[1])) {
+    // Pn10: the file itself, for Finder, Explorer or a mail to paste.
+    // WriteFilenames puts paths where pages could read them; this one is a
+    // file the user downloaded and asked, by this menu, to copy.
+    ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+    writer.WriteFilenames(ui::FileInfosToURIList(
+        {ui::FileInfo(item->GetTargetFilePath(), base::FilePath())}));
+    copied = true;
+  }
+  AllowJavascript();
+  ResolveJavascriptCallback(base::Value(*callback_id), base::Value(copied));
+}
+
+void LibraryHandler::HandleMoveToTrash(const base::ListValue& args) {
+  const std::string* const callback_id = CallbackId(args);
+  if (!callback_id || args.size() != 2U) {
+    return;
+  }
+  AllowJavascript();
+  download::DownloadItem* const item = FinishedDownload(args[1]);
+  if (!item) {
+    ResolveJavascriptCallback(base::Value(*callback_id), base::Value(false));
+    return;
+  }
+  // Pn11: off the UI thread; the answer comes back here.
+  MoveToTrashThen(item->GetTargetFilePath(),
+                  base::BindOnce(&LibraryHandler::OnMovedToTrash,
+                                 weak_factory_.GetWeakPtr(), *callback_id));
+}
+
+void LibraryHandler::OnMovedToTrash(std::string callback_id, bool moved) {
+  if (moved) {
+    // The row stays and reads as removed, as a file deleted by hand does:
+    // the downloads look for their files again and tell the list.
+    if (content::DownloadManager* const manager =
+            Profile::FromWebUI(web_ui())->GetDownloadManager()) {
+      manager->CheckForHistoryFilesRemoval();
+    }
+  }
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(base::Value(callback_id), base::Value(moved));
+  }
+}
+
+void LibraryHandler::HandleClosePanel(const base::ListValue& args) {
+  // Pn5. The sidebar drops the panel's view after this message returns,
+  // never under it.
+  if (SidebarPanels* const panels = SidebarPanels::From(GetBrowser())) {
+    panels->Close();
+  }
+}
+
+void LibraryHandler::HandleOpenAsPage(const base::ListValue& args) {
+  if (args.size() != 2U) {
+    return;
+  }
+  const std::string* const kind = args[0].GetIfString();
+  const std::string* const query = args[1].GetIfString();
+  BrowserWindowInterface* const browser = GetBrowser();
+  if (!kind || !query || !browser) {
+    return;
+  }
+  GURL url;
+  if (*kind == "history") {
+    // Pn5: the search typed in the panel carries over.
+    url = GURL(chrome::kChromeUIHistoryURL);
+    if (!query->empty()) {
+      url = net::AppendQueryParameter(url, "q", *query);
+    }
+  } else if (*kind == "downloads") {
+    url = GURL(chrome::kChromeUIDownloadsURL);
+  } else {
+    return;
+  }
+  // The page's tab if one is open, brought to its search; a new one if not.
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+  params.disposition = WindowOpenDisposition::SINGLETON_TAB;
+  params.path_behavior = NavigateParams::IGNORE_AND_NAVIGATE;
+  params.window_action = NavigateParams::WindowAction::kShowWindow;
+  Navigate(&params);
+  if (SidebarPanels* const panels = SidebarPanels::From(browser)) {
+    panels->Close();
+  }
+}
+
+void LibraryHandler::HandleRangeStart(const base::ListValue& args) {
+  const std::string* const callback_id = CallbackId(args);
+  if (!callback_id || args.size() != 2U || !args[1].is_string()) {
+    return;
+  }
+  const std::optional<HistoryRange> range =
+      HistoryRangeFromName(args[1].GetString());
+  if (!range) {
+    return;
+  }
+  AllowJavascript();
+  const std::optional<base::Time> start =
+      HistoryRangeStart(*range, base::Time::Now());
+  ResolveJavascriptCallback(
+      base::Value(*callback_id),
+      start ? base::Value(start->InMillisecondsFSinceUnixEpoch())
+            : base::Value());
+}
+
+}  // namespace stedding
