+// docs/features/peek.md: a link from a pinned tab that leaves its site opens
+// in a peek, a little window (docs/features/little.md) over the pinned tab's
+// window. The page is a whole tab, in the pinned tab's jar; Open as Tab and
+// Open in Split View move it into the window as it is, Escape closes it, and
+// so does a click on the window it came from.
+
+// The link a peek loads, as the page asked for it (peek P11, PLAN.md
+// CMD-10): its initiator, referrer and gesture go with it, so the page loads
+// as it would have in the pinned tab.
+struct PeekLink {
+  PeekLink();
+  PeekLink(const PeekLink&);
+  PeekLink& operator=(const PeekLink&);
+  ~PeekLink();
+
+  GURL url;
+  content::Referrer referrer;
+  std::optional<url::Origin> initiator_origin;
+  std::optional<blink::LocalFrameToken> initiator_frame_token;
+  content::ChildProcessId initiator_process_id;
+  scoped_refptr<content::SiteInstance> source_site_instance;
+  bool user_gesture = false;
+};
+
+// P6: opens `link` in a peek over the window of `source`, the page made in
+// `source`'s jar. A peek already over that window closes first (P13).
+// Returns the peek, or null when none opened: the window could not be made,
+// or the link is the one whose peek a click on `source`'s window has just
+// closed (P14).
+BrowserWindowInterface* OpenPeek(tabs::TabInterface* source,
+                                 const PeekLink& link);
+
+// P8: the same for a page the source made itself (window.open, a link with
+// an opener), which already shares its jar.
+BrowserWindowInterface* OpenPeekWithContents(
+    tabs::TabInterface* source,
+    std::unique_ptr<content::WebContents> contents,
+    const GURL& url);
+
+// Whether `window` is a peek: a little window whose page a peek opened.
+bool IsPeekWindow(const BrowserWindowInterface* window);
+
+// The pinned tab a peek's page came from; null when it is gone, or when
+// `window` is not a peek.
+tabs::TabInterface* PeekSourceOf(const BrowserWindowInterface* window);
+
+// P9: whether the peek's page can go into a split beside the pinned tab it
+// came from. An essential cannot take a pair (it would pin the page), nor a
+// tab already in a split; their peeks offer Open as Tab alone.
+bool PeekCanSplit(const BrowserWindowInterface* window);
+
+// The peek open over `window`, or null.
+BrowserWindowInterface* PeekOver(const BrowserWindowInterface* window);
+
+// The page leaves the peek (a promotion): it stops being one, and a click on
+// the source's window no longer closes the window it is in.
+void ForgetPeek(content::WebContents* contents);
+
+// P7, P9: the names of the peek's two ways into the window, on its row and
+// in its page menu.
+std::u16string PeekOpenAsTabLabel();
+std::u16string PeekOpenInSplitLabel();
+
+}  // namespace stedding
