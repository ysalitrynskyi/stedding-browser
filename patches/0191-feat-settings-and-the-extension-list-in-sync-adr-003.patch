+// else the other computers together, so the count is always true.
+std::u16string MessageFor(size_t count,
+                          const std::vector<std::string>& devices) {
+  const bool one = devices.size() == 1;
+  const std::u16string who =
+      one ? (devices[0].empty() ? u"Another computer"
+                                : base::UTF8ToUTF16(devices[0]))
+          : u"Your other computers";
+  const std::u16string verb = one ? u" has " : u" have ";
+  if (count == 1) {
+    return base::StrCat(
+        {who, verb, u"an extension this computer does not have."});
+  }
+  return base::StrCat({who, verb, base::NumberToString16(count),
+                       u" extensions this computer does not have."});
+}
+
+}  // namespace
+
+bool ShowSyncedExtensionsBar(BrowserWindowInterface* window,
+                             size_t count,
+                             const std::vector<std::string>& devices) {
+  if (!window || count == 0 || devices.empty() ||
+      window->GetType() != BrowserWindowInterface::TYPE_NORMAL ||
+      window->GetProfile()->IsOffTheRecord()) {
+    return false;
+  }
+  TabStripModel* const tabs = window->GetTabStripModel();
+  content::WebContents* const page =
+      tabs ? tabs->GetActiveWebContents() : nullptr;
+  infobars::ContentInfoBarManager* const manager =
+      page ? infobars::ContentInfoBarManager::FromWebContents(page) : nullptr;
+  if (!manager) {
+    return false;
+  }
+  if (!manager->AddInfoBar(CreateConfirmInfoBar(
+          std::make_unique<SyncedExtensionsDelegate>(
+              MessageFor(count, devices))))) {
+    return false;
+  }
+  ++g_shown;
+  LastText() = MessageFor(count, devices);
+  return true;
+}
+
+std::u16string SyncedExtensionsBarTextForTesting() {
+  return LastText();
+}
+
+int SyncedExtensionsBarsShownForTesting() {
+  return g_shown;
+}
+
+}  // namespace stedding
