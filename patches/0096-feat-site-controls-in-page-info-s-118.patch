+// site-controls Si1: the site chip and the command bar's View Site
+// Information, the latter with the row hidden, open the same panel, the
+// strip and the rows in it; coming back from the Cookies subpage brings them
+// back.
+IN_PROC_BROWSER_TEST_F(SiteControlsTest, TheChipAndTheBarOpenTheSamePanel) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("site.test")));
+  {
+    SCOPED_TRACE("the site chip");
+    views::BubbleDialogDelegateView* const panel = OpenFromTheChip();
+    ASSERT_TRUE(panel);
+    EXPECT_TRUE(Strip(panel));
+    EXPECT_TRUE(Rows(panel));
+    ASSERT_EQ(PageInfoBubbleViewBase::BUBBLE_PAGE_INFO,
+              PageInfoBubbleViewBase::GetShownBubbleType());
+    auto* const bubble = static_cast<PageInfoBubbleView*>(panel);
+    bubble->OpenCookiesPage();
+    EXPECT_FALSE(Strip(panel)) << "the Cookies subpage has no strip";
+    bubble->OpenMainPage(base::DoNothing());
+    EXPECT_TRUE(Strip(panel)) << "back from Cookies, the strip is back";
+    EXPECT_TRUE(Rows(panel)) << "back from Cookies, the rows are back";
+    ClosePanel();
+  }
+  {
+    SCOPED_TRACE("View Site Information with the row hidden");
+    ASSERT_TRUE(
+        chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    ASSERT_FALSE(browser_view()->toolbar()->IsDrawn());
+    stedding::ShowSiteInformation(browser());
+    views::BubbleDialogDelegateView* const panel = WaitForPanel();
+    ASSERT_TRUE(panel);
+    EXPECT_TRUE(Strip(panel));
+    EXPECT_TRUE(Rows(panel));
+    ClosePanel();
+    ASSERT_TRUE(
+        chrome::ExecuteCommand(browser(), IDC_STEDDING_TOGGLE_ADDRESS_ROW));
+  }
+  {
+    SCOPED_TRACE("App Info's page info keeps Chromium's");
+    ASSERT_TRUE(ShowPageInfoDialog(page(), base::DoNothing(),
+                                   bubble_anchor_util::Anchor::kAppMenuButton));
+    views::BubbleDialogDelegateView* const panel = WaitForPanel();
+    ASSERT_TRUE(panel);
+    EXPECT_FALSE(Strip(panel));
+    EXPECT_FALSE(Rows(panel));
+    ClosePanel();
+  }
+}
