+// import I48: importing from Settings brings Arc's route to the Space it names,
+// and a link there follows it. A second import adds no route.
+IN_PROC_BROWSER_TEST_F(ArcImportTest, ArcsRoutesComeAcrossOnce) {
+  WriteSidebar(R"("tab-doc-a")");
+  WriteRouting();
+  content::WebContents* const page = OpenSettings();
+  ASSERT_TRUE(page);
+  const std::string line = ImportFromSettings(page);
+  EXPECT_NE(std::string::npos, line.find("1 route")) << line;
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  std::vector<spaces::Route> routes = spaces::ReadRoutes(prefs);
+  ASSERT_EQ(1u, routes.size());
+  EXPECT_EQ(spaces::Route::Match::kContains, routes[0].match);
+  EXPECT_EQ("routed.example", routes[0].pattern);
+  spaces::Space* const work = SpaceNamed("Work");
+  ASSERT_TRUE(work);
+  EXPECT_EQ(work->id().ToString(), routes[0].space);
+
+  EXPECT_EQ(std::string::npos, ImportFromSettings(page).find("route"));
+  EXPECT_EQ(1u, spaces::ReadRoutes(prefs).size());
+}
