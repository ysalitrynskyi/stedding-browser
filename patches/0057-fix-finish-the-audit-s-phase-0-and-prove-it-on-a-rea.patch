+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/private_window.h"
+
+#include <memory>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/test/base/testing_profile.h"
+#include "content/public/test/browser_task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+class PrivateWindowTest : public testing::Test {
+ private:
+  content::BrowserTaskEnvironment task_environment_;
+};
+
+// private.md V1, V7: an incognito profile's windows are private; a normal
+// profile's are not.
+TEST_F(PrivateWindowTest, IncognitoIsPrivate) {
+  std::unique_ptr<TestingProfile> profile = TestingProfile::Builder().Build();
+  EXPECT_FALSE(IsPrivateWindow(nullptr));
+  EXPECT_FALSE(IsPrivateWindow(profile.get()));
+
+  TestingProfile* const incognito =
+      TestingProfile::Builder().BuildIncognito(profile.get());
+  ASSERT_TRUE(incognito->IsOffTheRecord());
+  EXPECT_TRUE(IsPrivateWindow(incognito));
+}
+
+// private.md V7: Guest browses off the record and is not private, and
+// neither is an off-the-record profile made for something else (a
+// non-primary one). "Off the record" was the old test, and it labelled
+// Guest "Private" without the coat (PLAN.md WIN-F8).
+TEST_F(PrivateWindowTest, OffTheRecordAloneIsNotPrivate) {
+  std::unique_ptr<TestingProfile> guest =
+      TestingProfile::Builder().SetGuestSession().Build();
+  EXPECT_FALSE(IsPrivateWindow(guest.get()));
+  Profile* const guest_browsing =
+      guest->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  ASSERT_TRUE(guest_browsing->IsOffTheRecord());
+  EXPECT_FALSE(IsPrivateWindow(guest_browsing));
+
+  std::unique_ptr<TestingProfile> profile = TestingProfile::Builder().Build();
+  TestingProfile* const other = TestingProfile::Builder().BuildOffTheRecord(
+      profile.get(), Profile::OTRProfileID::CreateUniqueForTesting());
+  ASSERT_TRUE(other->IsOffTheRecord());
+  EXPECT_FALSE(IsPrivateWindow(other));
+}
+
+}  // namespace
+}  // namespace stedding
