+base::ListValue ChordsAsValue(const std::vector<shortcuts::Chord>& chords) {
+  base::ListValue list;
+  for (const shortcuts::Chord& chord : chords) {
+    base::DictValue entry;
+    entry.Set("value", shortcuts::ChordToString(chord));
+    entry.Set("text", shortcuts::ChordText(chord));
+    list.Append(std::move(entry));
+  }
+  return list;
+}
+
+base::ListValue TextsAsValue(const std::vector<shortcuts::Chord>& chords) {
+  base::ListValue list;
+  for (const shortcuts::Chord& chord : chords) {
+    list.Append(shortcuts::ChordText(chord));
+  }
+  return list;
+}
+
+// Z17: a family's nine chords as one chip, "⌘1 – ⌘9".
+std::u16string FamilyText(const std::vector<shortcuts::Chord>& chords) {
+  if (chords.empty()) {
+    return std::u16string();
+  }
+  // The keypad's twins follow the digits; the range is the first and the
+  // last of the digit row's.
+  std::vector<shortcuts::Chord> digits;
+  for (const shortcuts::Chord& chord : chords) {
+    if (chord.key >= ui::VKEY_0 && chord.key <= ui::VKEY_9) {
+      digits.push_back(chord);
+    }
+  }
+  const std::vector<shortcuts::Chord>& range = digits.empty() ? chords : digits;
+  if (range.size() == 1) {
+    return shortcuts::ChordText(range.front());
+  }
+  return base::StrCat({shortcuts::ChordText(range.front()), u" – ",
+                       shortcuts::ChordText(range.back())});
+}
+
+base::DictValue RowAsValue(const shortcuts::Entry& entry,
+                           const shortcuts::RowState& state) {
+  base::DictValue row;
+  row.Set("name", entry.name);
+  row.Set("label", entry.label);
+  const bool family = entry.flags & shortcuts::kFamily;
+  if (family) {
+    base::ListValue chords;
+    base::DictValue chip;
+    chip.Set("value", std::string());
+    chip.Set("text", FamilyText(state.defaults));
+    chords.Append(std::move(chip));
+    row.Set("chords", std::move(chords));
+  } else {
+    row.Set("chords", ChordsAsValue(state.chords));
+  }
+  if (family) {
+    base::ListValue defaults;
+    defaults.Append(FamilyText(state.defaults));
+    row.Set("defaults", std::move(defaults));
+  } else {
+    row.Set("defaults", TextsAsValue(state.defaults));
+  }
+  row.Set("lost", TextsAsValue(state.lost));
+  row.Set("off", state.off);
+  row.Set("changed", state.changed);
+  row.Set("rebind", shortcuts::CanRebind(entry));
+  row.Set("toggle", shortcuts::CanTurnOff(entry));
+  row.Set("held", !!(entry.flags & shortcuts::kHeld));
+  row.Set("family", family);
+#if BUILDFLAG(IS_MAC)
+  row.Set("macos", shortcuts::MenuRowHasAppShortcut(entry.command));
+#else
+  row.Set("macos", false);
+#endif
+  return row;
+}
+
+std::string CheckKindName(shortcuts::CheckKind kind) {
+  switch (kind) {
+    case shortcuts::CheckKind::kOk:
+      return "ok";
+    case shortcuts::CheckKind::kSame:
+      return "same";
+    case shortcuts::CheckKind::kConflict:
+      return "conflict";
+    case shortcuts::CheckKind::kRefused:
+      return "refused";
+  }
+  return "refused";
+}
+
+base::DictValue CheckAsValue(const shortcuts::CheckResult& result,
+                             const shortcuts::Chord& chord) {
+  base::DictValue value;
+  value.Set("kind", CheckKindName(result.kind));
+  value.Set("message", result.message);
+  value.Set("value", shortcuts::ChordToString(chord));
+  value.Set("text", shortcuts::ChordText(chord));
+  value.Set("other", result.other ? std::u16string(result.other->label)
+                                  : std::u16string());
+  return value;
+}
+
+shortcuts::OutsideHolders OutsideHoldersOf(const shortcuts::Chord& chord) {
+  shortcuts::OutsideHolders outside;
+  outside.system_hotkey = shortcuts::IsSystemHotKey(chord);
+  outside.extension = ExtensionHoldingChord(chord);
+  return outside;
+}
+
+bool Matches(const ui::Accelerator& accelerator,
+             const shortcuts::Chord& chord) {
+  return accelerator.key_code() != ui::VKEY_UNKNOWN &&
+         shortcuts::FromAccelerator(accelerator) == chord;
+}
