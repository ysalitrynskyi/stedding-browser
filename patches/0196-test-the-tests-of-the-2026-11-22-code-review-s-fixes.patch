+// Little windows and peeks over the page.
+class LittleWindowB19Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), embedded_test_server()->GetURL("/title1.html")));
+  }
+};
+
+// P23-1b; little E12: a closed little window whose saved place is on a
+// display that has gone since -- unplugged, or the laptop undocked -- comes
+// back on a display that is there, at its size. It came back focused but
+// off screen.
+IN_PROC_BROWSER_TEST_F(LittleWindowB19Test,
+                       AReopenedLittleWindowFromAGoneDisplayComesBackOnScreen) {
+  const gfx::Rect gone(-20000, -20000, 800, 600);
+  ASSERT_FALSE(display::Screen::Get()
+                   ->GetDisplayMatching(gone)
+                   .work_area()
+                   .Intersects(gone))
+      << "the test's display reaches the gone display's place";
+  BrowserWindowInterface* const window =
+      stedding::ReopenClosedLittleWindow(browser()->GetProfile(), gone);
+  ASSERT_TRUE(window);
+  ASSERT_TRUE(stedding::IsLittleWindow(window));
+  const gfx::Rect bounds = window->GetWindow()->GetBounds();
+  const gfx::Rect work_area =
+      display::Screen::Get()->GetDisplayMatching(bounds).work_area();
+  EXPECT_TRUE(work_area.Intersects(bounds))
+      << bounds.ToString() << " is on no display; the display's work area is "
+      << work_area.ToString();
+  // Within 2 DIP: a fractional scale factor rounds a window's size.
+  EXPECT_LE(std::abs(bounds.width() - gone.width()), 2) << bounds.ToString();
+  EXPECT_LE(std::abs(bounds.height() - gone.height()), 2) << bounds.ToString();
+}
+
+// Whether `bounds` are `want` to within 2 DIP each way: a fractional scale
+// factor rounds a window's place and size.
+bool NearlyB19(const gfx::Rect& bounds, const gfx::Rect& want) {
+  return std::abs(bounds.x() - want.x()) <= 2 &&
+         std::abs(bounds.y() - want.y()) <= 2 &&
+         std::abs(bounds.width() - want.width()) <= 2 &&
+         std::abs(bounds.height() - want.height()) <= 2;
+}
+
+// little E12: a closed little window whose saved place leaves only a strip of
+// it on its display -- 10 DIP past the right edge of the rightmost display --
+// comes back fitted onto that display, at its size; one saved well on its
+// display comes back exactly where it was. Only a window wholly off every
+// display was fitted, so the first came back with its title bar out of reach.
+IN_PROC_BROWSER_TEST_F(LittleWindowB19Test,
+                       AReopenedLittleWindowMostlyOffItsDisplayIsFittedOnIt) {
+  display::Display rightmost;
+  for (const display::Display& each :
+       display::Screen::Get()->GetAllDisplays()) {
+    if (!rightmost.is_valid() ||
+        each.work_area().right() > rightmost.work_area().right()) {
+      rightmost = each;
+    }
+  }
+  ASSERT_TRUE(rightmost.is_valid());
+  const gfx::Rect work_area = rightmost.work_area();
+  ASSERT_GE(work_area.width(), 700) << work_area.ToString();
+  ASSERT_GE(work_area.height(), 500) << work_area.ToString();
+
+  // Saved well on the display: kept as it was.
+  const gfx::Rect on(work_area.x() + 40, work_area.y() + 40, 600, 400);
+  ASSERT_TRUE(work_area.Contains(on));
+  BrowserWindowInterface* const kept =
+      stedding::ReopenClosedLittleWindow(browser()->GetProfile(), on);
+  ASSERT_TRUE(kept);
+  ASSERT_TRUE(stedding::IsLittleWindow(kept));
+  EXPECT_TRUE(NearlyB19(kept->GetWindow()->GetBounds(), on))
+      << kept->GetWindow()->GetBounds().ToString() << " is not where it was, "
+      << on.ToString();
+
+  // Saved with 10 DIP of it on the display, the rest past its right edge,
+  // where no display is: fitted onto the display, at its size.
+  const gfx::Rect off(work_area.right() - 10, work_area.y() + 40, 600, 400);
+  ASSERT_EQ(rightmost.id(),
+            display::Screen::Get()->GetDisplayMatching(off).id());
+  BrowserWindowInterface* const fitted =
+      stedding::ReopenClosedLittleWindow(browser()->GetProfile(), off);
+  ASSERT_TRUE(fitted);
+  ASSERT_TRUE(stedding::IsLittleWindow(fitted));
+  const gfx::Rect want(work_area.right() - off.width(), off.y(), off.width(),
+                       off.height());
+  EXPECT_TRUE(NearlyB19(fitted->GetWindow()->GetBounds(), want))
+      << fitted->GetWindow()->GetBounds().ToString()
+      << " is not fitted onto the display's work area " << work_area.ToString();
+}
+
+// P24-1a; peek P13, P20, little E11: with links from other apps opening as a
+// peek over the page, the next link replaces the peek whose page has a
+// handler that runs as it is left (pagehide here, as most sites have). The
+// link was dropped and opened in a little window, and the first peek closed
+// a moment later by itself.
+IN_PROC_BROWSER_TEST_F(LittleWindowB19Test,
+                       TheNextLinkReplacesAPeekWhosePageRunsAsItIsLeft) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(stedding::prefs::kLittleAsPeek, true);
+  ASSERT_NE(stedding::prefs::kPeekStyleSmallWindow,
+            prefs->GetInteger(stedding::prefs::kPeekStyle))
+      << "Show a peek is not over the page";
+  const GURL first_url = embedded_test_server()->GetURL("/title2.html");
+  const GURL next_url = embedded_test_server()->GetURL("/title3.html");
+
+  EXPECT_EQ(browser(), stedding::OpenLittleWindow(browser()->GetProfile(),
+                                                  first_url, browser(),
+                                                  /*untrusted_launch=*/false));
+  content::WebContents* page = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    page = stedding::PeekOverPageOfActiveTab(browser());
+    return page != nullptr;
+  })) << "no peek over the window's page";
+  ASSERT_TRUE(content::WaitForLoadStop(page));
+  ASSERT_EQ(first_url, page->GetLastCommittedURL());
+  ASSERT_TRUE(
+      content::ExecJs(page, "window.addEventListener('pagehide', () => {});"));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return page->NeedToFireBeforeUnloadOrUnloadEvents(); }));
+
+  // A null window would have the caller open the link as a tab as well.
+  EXPECT_EQ(browser(), stedding::OpenLittleWindow(browser()->GetProfile(),
+                                                  next_url, browser(),
+                                                  /*untrusted_launch=*/false))
+      << "the link opened somewhere else";
+  EXPECT_EQ(0, LittleWindowCountB19()) << "the link opened in a little window";
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    content::WebContents* const now =
+        stedding::PeekOverPageOfActiveTab(browser());
+    return now && now->GetVisibleURL() == next_url;
+  })) << "the next link did not replace the peek";
+  EXPECT_EQ(0, LittleWindowCountB19());
+
+  ASSERT_TRUE(stedding::RunPeekOverPageCommand(browser(),
+                                               stedding::PeekCommand::kClose));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return stedding::PeekOverPageOfActiveTab(browser()) == nullptr;
+  }));
+}
+
+// Captures into a temporary Downloads folder.
+class RegionCaptureB19Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(downloads_.CreateUniqueTempDir());
+    browser()->GetProfile()->GetPrefs()->SetFilePath(
+        prefs::kDownloadDefaultDirectory, downloads_.GetPath());
+  }
+
+  void TearDownOnMainThread() override {
+    FlushCaptures();
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  // Every capture ending posted so far has run.
+  static void FlushCaptures() {
+    base::RunLoop run_loop;
+    stedding::FlushCapturesForTesting(run_loop.QuitClosure());
+    run_loop.Run();
+  }
+
+  // The toast `id` in `window`, reading `text`.
+  static void WaitForToast(BrowserWindowInterface* window,
+                           ToastId id,
+                           const std::u16string& text) {
+    ToastController* const toasts = ToastController::From(window);
+    ASSERT_TRUE(toasts);
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      toasts::ToastView* const view = toasts->GetToastViewForTesting();
+      return toasts->IsShowingToast() && toasts->GetCurrentToastId() == id &&
+             view && view->label_for_testing() &&
+             view->label_for_testing()->GetText() == text;
+    })) << "no toast reading " << base::UTF16ToUTF8(text);
+    toasts->GetToastCloseTimerForTesting()->Stop();
+  }
+
+  base::ScopedTempDir downloads_;
+};
+
+// P25-1a; screenshot C10: Capture a Region on a tab whose page has crashed
+// ends in the "Couldn't take the screenshot" toast, as the visible and full
+// page captures do. On the Mac the browser crashed: the selection's overlay
+// was hung from the widget of a page view the crashed tab no longer has.
+IN_PROC_BROWSER_TEST_F(RegionCaptureB19Test,
+                       ARegionOfACrashedTabSaysTheCaptureFailed) {
