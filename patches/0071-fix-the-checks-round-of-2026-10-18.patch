+void TabStripView::BeginSpaceTitleRename(
+    const std::u16string& name,
+    const std::u16string& shown_as,
+    base::OnceCallback<void(std::u16string)> done) {
+  if (!space_title_field_ || !space_title_row_ ||
+      !space_title_row_->GetVisible()) {
+    return;
+  }
+  EndSpaceTitleRename(/*commit=*/true);
+  space_title_done_ = std::move(done);
+  space_title_field_->SetText(name);
+  space_title_field_->SetPlaceholderText(shown_as);
+  space_title_field_->SetVisible(true);
+  InvalidateLayout();
+  space_title_field_->RequestFocus();
+  space_title_field_->SelectAll(false);
+}
+
+void TabStripView::EndSpaceTitleRename(bool commit) {
+  if (!space_title_field_ || !space_title_field_->GetVisible()) {
+    return;
+  }
+  std::u16string typed(space_title_field_->GetText());
+  base::OnceCallback<void(std::u16string)> done = std::move(space_title_done_);
+  space_title_field_->SetVisible(false);
+  InvalidateLayout();
+  if (commit && done) {
+    std::move(done).Run(std::move(typed));
+  }
+}
+
+bool TabStripView::HandleKeyEvent(views::Textfield* sender,
+                                  const ui::KeyEvent& event) {
+  if (sender != space_title_field_ ||
+      event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  if (event.key_code() == ui::VKEY_RETURN) {
+    EndSpaceTitleRename(/*commit=*/true);
+    return true;
+  }
+  if (event.key_code() == ui::VKEY_ESCAPE) {
+    EndSpaceTitleRename(/*commit=*/false);
+    return true;
+  }
+  return false;
+}
