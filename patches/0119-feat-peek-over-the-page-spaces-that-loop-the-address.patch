+bool PeeksShowOverThePage(tabs::TabInterface* source) {
+  if (!OverPageHost() || !source || !source->GetContents()) {
+    return false;
+  }
+  const PrefService* const prefs =
+      Profile::FromBrowserContext(source->GetContents()->GetBrowserContext())
+          ->GetPrefs();
+  return prefs->GetInteger(prefs::kPeekStyle) != prefs::kPeekStyleSmallWindow;
+}
+
+content::WebContents* PeekOverPageOfActiveTab(BrowserWindowInterface* window) {
+  PeekOverPageHost* const host = OverPageHost();
+  TabStripModel* const tabs = window ? window->GetTabStripModel() : nullptr;
+  tabs::TabInterface* const active = tabs ? tabs->GetActiveTab() : nullptr;
+  return host && active ? host->PageOver(active) : nullptr;
+}
+
+tabs::TabInterface* PeekOverPageSourceOf(content::WebContents* page) {
+  PeekOverPageHost* const host = OverPageHost();
+  // A peek's page in a little window is a tab of it; one over the page is
+  // no tab.
+  if (!host || !page || tabs::TabInterface::MaybeGetFromContents(page)) {
+    return nullptr;
+  }
+  const PeekPage* const peek_page = PeekPage::FromWebContents(page);
+  tabs::TabInterface* const source = peek_page ? peek_page->source() : nullptr;
+  return source && host->PageOver(source) == page ? source : nullptr;
+}
