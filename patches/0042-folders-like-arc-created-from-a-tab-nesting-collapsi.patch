+// Stedding folders: tabs move into a new folder, stay in the strip, and
+// folders nest.
+TEST_F(TabStripModelTest, AddToNewFolderKeepsTabsAndNests) {
+  ASSERT_NO_FATAL_FAILURE(
+      PrepareTabstripForSelectionTest(tabstrip(), 4, 0, {0}));
+  ASSERT_EQ(4, tabstrip()->count());
+
+  tabs::TabInterface* const moved_a = tabstrip()->GetTabAtIndex(1);
+  tabs::TabInterface* const moved_b = tabstrip()->GetTabAtIndex(2);
+
+  tabs::FolderTabCollection* const folder =
+      tabstrip()->AddToNewFolder({1, 2});
+  ASSERT_NE(nullptr, folder);
+
+  // No tab was lost, and the folder holds exactly the two moved tabs.
+  EXPECT_EQ(4, tabstrip()->count());
+  EXPECT_EQ(2, folder->TabCountRecursive());
+  EXPECT_EQ(folder, moved_a->GetParentCollection());
+  EXPECT_EQ(folder, moved_b->GetParentCollection());
+
+  // Nesting: a folder created with a parent lands inside that parent.
+  tabs::FolderTabCollection* const child =
+      tabstrip()->AddToNewFolder({tabstrip()->GetIndexOfTab(moved_b)}, folder);
+  ASSERT_NE(nullptr, child);
+  EXPECT_EQ(4, tabstrip()->count());
+  EXPECT_EQ(folder, child->GetParentCollection());
+  EXPECT_EQ(child, moved_b->GetParentCollection());
+  EXPECT_EQ(2, folder->TabCountRecursive())
+      << "the nested tab still counts inside the outer folder";
+}
