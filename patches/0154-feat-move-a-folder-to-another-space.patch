+// folders F47 (the owner, 2026-11-05): Move to Space on the header's menu has
+// a row for each other Space, in switcher order, and takes the folder there
+// whole, and the window with it. With one Space there is no row.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest,
+                       MoveToSpaceOnTheHeaderMenuTakesTheFolder) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  CloseDownToOne();
+  tabs::TabInterface* const rest = tab_strip_model()->GetTabAtIndex(0);
+  tabs::TabInterface* const a = OpenLoaded("a.test");
+  tabs::TabInterface* const b = OpenLoaded("b.test");
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({IndexOf(a), IndexOf(b)});
+  ASSERT_TRUE(folder);
+  const auto row_of = [](ui::SimpleMenuModel* menu) {
+    return menu->GetIndexOfCommandId(FolderView::kMoveToSpaceMenuCommand);
+  };
+  EXPECT_FALSE(row_of(DrawnFolder(folder)->menu_model_for_testing()).has_value())
+      << "a row with nowhere to go";
+
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  const spaces::SpaceId home = model->active_id();
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  model->AddSpace("Later", SK_ColorRED);
+  ui::SimpleMenuModel* const menu =
+      DrawnFolder(folder)->menu_model_for_testing();
+  const std::optional<size_t> row = row_of(menu);
+  ASSERT_TRUE(row.has_value()) << "no row with another Space to go to";
+  EXPECT_EQ(u"Move to Space", menu->GetLabelAt(*row));
+  ui::MenuModel* const rows = menu->GetSubmenuModelAt(*row);
+  ASSERT_TRUE(rows);
+  ASSERT_EQ(2u, rows->GetItemCount()) << "the folder's own Space is a row";
+  EXPECT_EQ(u"Work", rows->GetLabelAt(0));
+  EXPECT_EQ(u"Later", rows->GetLabelAt(1));
+
+  rows->ActivatedAt(0);
+  ASSERT_TRUE(
+      base::test::RunUntil([&]() { return model->active_id() == work; }));
+  EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  EXPECT_EQ(work, model->SpaceForTab(a));
+  EXPECT_EQ(work, model->SpaceForTab(b));
+  EXPECT_EQ(home, model->SpaceForTab(rest));
+  EXPECT_EQ(folder, a->GetParentCollection()) << "the folder lost a tab";
+  EXPECT_EQ(folder, b->GetParentCollection());
+  FolderView* const there = DrawnFolder(folder);
+  ASSERT_TRUE(there) << "the folder is not drawn in its new Space";
+  EXPECT_TRUE(there->IsDrawn());
+  EXPECT_TRUE(DrawnRow(a));
+  EXPECT_EQ(b, tab_strip_model()->GetActiveTab())
+      << "the folder's tab on screen left the screen";
+}
+
+// folders F48 (the owner, 2026-11-05): a header dragged onto another Space's
+// chip lights it, and the release takes the folder there, whole, and the
+// window with it. On its own Space's chip nothing lights and nothing moves: the
+// release moved a folder to the end of its list.
+IN_PROC_BROWSER_TEST_F(FolderTabsTest, AHeaderDroppedOnAChipTakesTheFolderThere) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  CloseDownToOne();
+  tabs::TabInterface* const rest = tab_strip_model()->GetTabAtIndex(0);
+  tabs::TabInterface* const a = OpenLoaded("a.test");
+  tabs::TabInterface* const b = OpenLoaded("b.test");
+  tabs::TabInterface* const after = OpenLoaded("c.test");
+  // The folder made once every tab is open, as a tab opened from a folder's
+  // last tab joins it (F25).
+  tabs::FolderTabCollection* const folder =
+      tab_strip_model()->AddToNewFolder({IndexOf(a), IndexOf(b)});
+  ASSERT_TRUE(folder);
+  tab_strip_model()->ActivateTabAt(IndexOf(rest));
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  const spaces::SpaceId home = model->active_id();
+  const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+  EXPECT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  spaces::SpaceSwitcherView* const switcher =
+      stedding::test::FindDrawnSwitcher(widget()->GetRootView());
+  ASSERT_TRUE(switcher);
+  views::View* const home_chip = switcher->ChipForTesting(home);
+  views::View* const work_chip = switcher->ChipForTesting(work);
+  ASSERT_TRUE(home_chip && home_chip->IsDrawn());
+  ASSERT_TRUE(work_chip && work_chip->IsDrawn());
+  const gfx::Point on_home = home_chip->GetBoundsInScreen().CenterPoint();
+  const gfx::Point on_work = work_chip->GetBoundsInScreen().CenterPoint();
+
+  {
+    SCOPED_TRACE("on its own Space's chip");
+    const int at = IndexOf(a);
+    PressAndDragHeader(folder, on_home);
+    EXPECT_EQ(std::nullopt, switcher->drop_target_for_testing())
+        << "a chip that takes no drop is lit";
+    EXPECT_FALSE(RowDropBarShown(folder)) << "a place shown under the chips";
+    ReleaseAt(on_home);
+    EXPECT_EQ(home, model->active_id());
+    EXPECT_EQ(home, model->SpaceForTab(a));
+    EXPECT_EQ(at, IndexOf(a)) << "the release moved the folder along its list";
+  }
+  {
+    SCOPED_TRACE("on another Space's chip");
+    PressAndDragHeader(folder, on_work);
+    EXPECT_EQ(work, switcher->drop_target_for_testing())
+        << "the chip that would take the drop is not lit";
+    ReleaseAt(on_work);
+    EXPECT_EQ(std::nullopt, switcher->drop_target_for_testing())
+        << "the light stayed on after the release";
+    ASSERT_TRUE(
+        base::test::RunUntil([&]() { return model->active_id() == work; }));
+    EXPECT_EQ(work, model->SpaceForTab(a));
+    EXPECT_EQ(work, model->SpaceForTab(b));
+    EXPECT_EQ(home, model->SpaceForTab(rest));
+    EXPECT_EQ(home, model->SpaceForTab(after));
+    EXPECT_EQ(folder, a->GetParentCollection());
+    EXPECT_EQ(folder, b->GetParentCollection());
+    EXPECT_TRUE(DrawnFolder(folder)) << "the folder is not drawn in its Space";
+  }
+}
