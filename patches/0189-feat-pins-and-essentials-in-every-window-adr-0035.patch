+const PinRecord* PinStore::Find(const std::string& id) const {
+  const auto it = std::ranges::find_if(
+      records_, [&](const PinRecord& record) { return record.id == id; });
+  return it == records_.end() ? nullptr : &*it;
+}
+
+void PinStore::Publish(const std::vector<std::string>& order,
+                       const std::vector<PinRecord>& changed,
+                       const std::set<std::string>& removed) {
+  if (!ready_) {
+    return;
+  }
+  std::map<std::string, PinRecord> by_id;
+  for (const PinRecord& record : records_) {
+    by_id.emplace(record.id, record);
+  }
+  bool any = false;
+  bool titles = false;
+  for (const std::string& id : removed) {
+    any |= by_id.erase(id) > 0;
+  }
+  for (const PinRecord& record : changed) {
+    if (record.id.empty() || removed.contains(record.id)) {
+      continue;
+    }
+    auto it = by_id.find(record.id);
+    if (it == by_id.end()) {
+      by_id.emplace(record.id, record);
+      any = true;
+    } else if (!it->second.SameExceptTitle(record)) {
+      it->second = record;
+      any = true;
+    } else if (it->second.title != record.title) {
+      it->second.title = record.title;
+      titles = true;
+    }
+  }
+  const std::vector<std::string> current = IdsOf(records_);
+  std::vector<std::string> published;
+  std::set<std::string> seen;
+  for (const std::string& id : order) {
+    if (by_id.contains(id) && seen.insert(id).second) {
+      published.push_back(id);
+    }
+  }
+  // A record `changed` brings that `order` lacks keeps its place; a new one
+  // goes at the end.
+  for (const PinRecord& record : changed) {
+    if (by_id.contains(record.id) &&
+        !std::ranges::contains(current, record.id) &&
+        seen.insert(record.id).second) {
+      published.push_back(record.id);
+    }
+  }
+  // windows G13: each run (the essentials, or a Space's pins) merges on its
+  // own, so the order a window sends for one run never moves another run's
+  // rows. The runs keep the place they first have in the store.
+  std::vector<std::string> keys;
+  std::map<std::string, std::vector<std::string>> current_runs;
+  std::map<std::string, std::vector<std::string>> published_runs;
+  for (const std::string& id : current) {
+    const auto it = by_id.find(id);
+    if (it == by_id.end()) {
+      continue;
+    }
+    const std::string key = RunOf(it->second);
+    if (!current_runs.contains(key)) {
+      keys.push_back(key);
+    }
+    current_runs[key].push_back(id);
+  }
+  for (const std::string& id : published) {
+    const std::string key = RunOf(by_id.at(id));
+    if (!current_runs.contains(key) && !published_runs.contains(key)) {
+      keys.push_back(key);
+    }
+    published_runs[key].push_back(id);
+  }
+  std::vector<std::string> merged;
+  for (const std::string& key : keys) {
+    const std::vector<std::string>& was = current_runs[key];
+    const std::vector<std::string> run =
+        MergeOrder(was, published_runs[key], removed);
+    any |= run != was;
+    merged.insert(merged.end(), run.begin(), run.end());
+  }
+  if (!any && !titles) {
+    return;
+  }
+  std::vector<PinRecord> records;
+  records.reserve(merged.size());
+  for (const std::string& id : merged) {
+    auto it = by_id.find(id);
+    if (it != by_id.end()) {
+      records.push_back(std::move(it->second));
+    }
+  }
+  records_ = std::move(records);
+  // A title alone tells no window and writes nothing: pages retitle as they
+  // load. It is what an asleep tab shows, and it is written with the next
+  // real change.
+  if (any) {
+    Changed();
+  }
+}
+
+PinChanges PinStore::ChangesSince(const std::vector<PinRecord>& held,
+                                  const std::vector<PinRecord>& now) const {
+  std::map<std::string, const PinRecord*> before;
+  for (const PinRecord& record : held) {
+    before.emplace(record.id, &record);
+  }
+  std::map<std::string, int> tabs;
+  for (const PinRecord& record : now) {
+    ++tabs[record.id];
+  }
+  // A record the window speaks for: one it held that the store still has, or
+  // one it made that the store does not know yet, with one tab there.
+  const auto ours = [&](const std::string& id) {
+    const auto count = tabs.find(id);
+    return !id.empty() && count != tabs.end() && count->second == 1 &&
+           before.contains(id) == (Find(id) != nullptr);
+  };
+  PinChanges changes;
+  std::map<std::string, std::vector<std::string>> runs;
+  for (const PinRecord& record : now) {
+    if (!ours(record.id)) {
+      continue;
+    }
+    runs[RunOf(record)].push_back(record.id);
+    const auto it = before.find(record.id);
+    if (it == before.end()) {
+      changes.changed.push_back(record);
+      continue;
+    }
+    // Three ways: the store's record, with only the fields this window
+    // changed since it held it. A field another window changed meanwhile,
+    // which this window has not followed yet, stays as the store has it, and
+    // a title alone stays a title.
+    const PinRecord& was = *it->second;
+    PinRecord merged = *Find(record.id);
+    const PinRecord& theirs = *Find(record.id);
+    const auto same_part = [](const PinRecord& a, const PinRecord& b) {
+      return a.tier == b.tier && a.has_space == b.has_space &&
+             (!a.has_space || a.space == b.space);
+    };
+    if (!same_part(record, was)) {
+      merged.tier = record.tier;
+      merged.has_space = record.has_space;
+      merged.space = record.space;
+    }
+    if (record.folder_path != was.folder_path) {
+      merged.folder_path = record.folder_path;
+    }
+    if (record.home != was.home) {
+      merged.home = record.home;
+    }
+    if (record.page != was.page) {
+      merged.page = record.page;
+    }
+    if (record.name != was.name) {
+      merged.name = record.name;
+    }
+    if (record.title != was.title) {
+      merged.title = record.title;
+    }
+    if (record.separator != was.separator) {
+      merged.separator = record.separator;
+    }
+    // The row's tier and Space go as one. When both windows changed them, or
+    // the fields of two windows make a row neither had (a Space pin of no
+    // Space), this window's place is taken whole, folders included.
+    if ((!same_part(record, was) && !same_part(theirs, was)) ||
+        (merged.tier == PinTier::kSpacePin && !merged.has_space)) {
+      merged.tier = record.tier;
+      merged.has_space = record.has_space;
+      merged.space = record.space;
+      merged.folder_path = record.folder_path;
+    }
+    // An essential is in no folder (folders F38).
+    if (merged.tier == PinTier::kEssential) {
+      merged.folder_path.clear();
+    }
+    if (!(merged == theirs)) {
+      changes.changed.push_back(std::move(merged));
+    }
+  }
+  std::map<std::string, std::vector<std::string>> runs_before;
+  for (const PinRecord& record : held) {
+    runs_before[RunOf(record)].push_back(record.id);
+  }
+  std::map<std::string, size_t> place;
+  for (size_t i = 0; i < records_.size(); ++i) {
+    place.emplace(records_[i].id, i);
+  }
+  for (const auto& [run, ids] : runs) {
+    const std::vector<std::string>& had = runs_before[run];
+    // The rows the run had and still has, as the window has them now and as
+    // it had them.
+    std::vector<std::string> kept;
+    for (const std::string& id : ids) {
+      if (std::ranges::contains(had, id)) {
+        kept.push_back(id);
+      }
+    }
+    std::vector<std::string> was;
+    for (const std::string& id : had) {
+      if (std::ranges::contains(ids, id)) {
+        was.push_back(id);
+      }
+    }
+    if (kept != was) {
+      // The window reordered the run: its order goes out whole.
+      changes.order.insert(changes.order.end(), ids.begin(), ids.end());
+      continue;
+    }
+    if (kept.size() == ids.size()) {
+      continue;
+    }
+    // Only rows new to the run: the rows it had keep the store's order, which
+    // the window may not have followed (a run with a split, windows G13), and
+    // each new row goes after the row before it in the window.
+    std::vector<std::string> placed = kept;
+    std::ranges::sort(placed, [&](const std::string& a, const std::string& b) {
+      return place[a] < place[b];
+    });
+    for (size_t i = 0; i < ids.size(); ++i) {
+      if (std::ranges::contains(kept, ids[i])) {
+        continue;
+      }
+      auto at = placed.begin();
+      for (size_t j = i; j > 0; --j) {
+        const auto previous = std::ranges::find(placed, ids[j - 1]);
+        if (previous != placed.end()) {
+          at = previous + 1;
+          break;
+        }
+      }
+      placed.insert(at, ids[i]);
+    }
+    changes.order.insert(changes.order.end(), placed.begin(), placed.end());
+  }
+  return changes;
+}
+
+std::vector<std::map<std::string, std::string>> PinStore::Fill(
+    const std::vector<std::vector<PinRecord>>& windows) {
+  std::vector<std::map<std::string, std::string>> ids(windows.size());
+  if (ready_) {
+    return ids;
+  }
+  std::vector<PinRecord> records;
+  // For each record, the window that gave it, so a window never matches its
+  // own rows: two pins of one home in one window stay two.
+  std::vector<size_t> made_by;
+  std::set<std::string> used;
+  const auto position = [&](const std::string& id) {
+    return static_cast<size_t>(
+        std::ranges::find_if(records,
+                             [&](const PinRecord& r) { return r.id == id; }) -
+        records.begin());
+  };
+  for (size_t w = 0; w < windows.size(); ++w) {
+    std::set<size_t> matched;
+    // Each row's record id, and the record a new row makes.
+    std::vector<std::string> order;
+    std::vector<std::optional<PinRecord>> fresh;
+    for (const PinRecord& row : windows[w]) {
+      const std::optional<MergeKey> key = KeyOf(row);
+      std::optional<size_t> same;
+      for (size_t i = 0; key && i < records.size(); ++i) {
+        if (made_by[i] != w && !matched.contains(i) &&
+            KeyOf(records[i]) == key) {
+          same = i;
+          break;
+        }
+      }
+      if (same) {
+        matched.insert(*same);
+        ids[w][row.id] = records[*same].id;
+        order.push_back(records[*same].id);
+        fresh.push_back(std::nullopt);
+        continue;
+      }
+      PinRecord record = row;
+      if (record.id.empty() || used.contains(record.id)) {
+        record.id = stedding::NewTabToken();
+      }
+      used.insert(record.id);
+      ids[w][row.id] = record.id;
+      order.push_back(record.id);
+      fresh.push_back(std::move(record));
+    }
+    // A new record goes after the row it followed in its window; a window's
+    // first row, if new, goes before the next row the store already has. The
+    // records earlier windows gave keep their order.
+    for (size_t k = 0; k < order.size(); ++k) {
+      if (!fresh[k]) {
+        continue;
+      }
+      size_t at = records.size();
+      if (k > 0) {
+        at = position(order[k - 1]) + 1;
+      } else {
+        for (size_t j = k + 1; j < order.size(); ++j) {
+          if (!fresh[j]) {
+            at = position(order[j]);
+            break;
+          }
+        }
+      }
+      records.insert(records.begin() + at, std::move(*fresh[k]));
+      made_by.insert(made_by.begin() + at, w);
+    }
+  }
+  records_ = std::move(records);
+  ready_ = true;
+  Changed();
+  return ids;
+}
+
+void PinStore::MoveSpace(const SpaceId& from,
+                         const SpaceId& to,
+                         bool to_has_own_session) {
+  std::vector<PinRecord> moved;
+  std::vector<PinRecord> kept;
+  for (PinRecord& record : records_) {
+    if (record.has_space && record.space == from) {
+      record.space = to;
+      // ADR 0028: an own essential stays one only on a Space with a session
+      // of its own; elsewhere it becomes that Space's pin.
+      if (record.tier == PinTier::kEssential && !to_has_own_session) {
+        record.tier = PinTier::kSpacePin;
+      }
+      moved.push_back(std::move(record));
+    } else {
+      kept.push_back(std::move(record));
+    }
+  }
+  if (moved.empty()) {
+    records_ = std::move(kept);
+    return;
+  }
+  // After the last record that is `to`'s.
+  size_t at = kept.size();
+  for (size_t i = kept.size(); i > 0; --i) {
+    if (kept[i - 1].has_space && kept[i - 1].space == to) {
+      at = i;
+      break;
+    }
+  }
+  kept.insert(kept.begin() + at, std::make_move_iterator(moved.begin()),
+              std::make_move_iterator(moved.end()));
+  records_ = std::move(kept);
+  Changed();
+}
+
+void PinStore::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void PinStore::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void PinStore::Changed() {
+  if (prefs_) {
+    prefs_->SetList(stedding::prefs::kPinStore, ToValue(records_));
+    prefs_->SetBoolean(stedding::prefs::kPinStoreReady, ready_);
+  }
+  // A window told of a change may publish one of its own at once (a reconcile
+  // with a publish pending), which changes the store again while the windows
+  // are still being told. Each is told again once the round is over, not
+  // inside it.
+  if (notifying_) {
+    changed_again_ = true;
+    return;
+  }
+  base::AutoReset<bool> notifying(&notifying_, true);
+  do {
+    changed_again_ = false;
+    for (Observer& observer : observers_) {
+      observer.OnPinStoreChanged();
+    }
+  } while (changed_again_);
+}
+
+// static
+std::vector<std::string> PinStore::MergeOrder(
+    const std::vector<std::string>& current,
+    const std::vector<std::string>& published,
+    const std::set<std::string>& removed) {
+  const std::set<std::string> in_published(published.begin(), published.end());
+  // An id the window lacks rides after the nearest id before it that the
+  // window has; one with none before it leads.
+  std::vector<std::string> front;
+  std::map<std::string, std::vector<std::string>> after;
+  const std::string* anchor = nullptr;
+  for (const std::string& id : current) {
+    if (removed.contains(id)) {
+      continue;
+    }
+    if (in_published.contains(id)) {
+      anchor = &id;
+      continue;
+    }
+    (anchor ? after[*anchor] : front).push_back(id);
+  }
+  std::vector<std::string> merged = std::move(front);
+  std::set<std::string> seen(merged.begin(), merged.end());
+  for (const std::string& id : published) {
+    if (removed.contains(id) || !seen.insert(id).second) {
+      continue;
+    }
+    merged.push_back(id);
+    if (auto it = after.find(id); it != after.end()) {
+      for (const std::string& riding : it->second) {
+        if (seen.insert(riding).second) {
+          merged.push_back(riding);
+        }
+      }
+    }
+  }
+  return merged;
+}
+
+// static
+base::ListValue PinStore::ToValue(const std::vector<PinRecord>& records) {
+  base::ListValue list;
+  for (const PinRecord& record : records) {
+    base::DictValue dict;
+    dict.Set(kId, record.id);
+    dict.Set(kTier, record.tier == PinTier::kEssential ? kTierEssential
+                                                        : kTierPin);
+    if (record.has_space) {
+      dict.Set(kSpace, record.space.ToString());
+    }
+    dict.Set(kHome, record.home.spec());
+    if (record.page.is_valid()) {
+      dict.Set(kPage, record.page.spec());
+    }
+    if (!record.name.empty()) {
+      dict.Set(kName, base::UTF16ToUTF8(record.name));
+    }
+    if (!record.title.empty()) {
+      dict.Set(kTitle, base::UTF16ToUTF8(record.title));
+    }
+    if (!record.folder_path.empty()) {
+      dict.Set(kFolder, record.folder_path);
+    }
+    if (record.separator) {
+      dict.Set(kSeparator, true);
+    }
+    list.Append(std::move(dict));
+  }
+  return list;
+}
+
+// static
+std::vector<PinRecord> PinStore::FromValue(const base::ListValue& value) {
+  std::vector<PinRecord> records;
+  std::set<std::string> ids;
+  for (const base::Value& item : value) {
+    const base::DictValue* const dict = item.GetIfDict();
+    const std::string* const id = dict ? dict->FindString(kId) : nullptr;
+    if (!id || id->empty() || !ids.insert(*id).second) {
+      continue;
+    }
+    PinRecord record;
+    record.id = *id;
+    const std::string* const tier = dict->FindString(kTier);
+    record.tier = tier && *tier == kTierEssential ? PinTier::kEssential
+                                                  : PinTier::kSpacePin;
+    if (const std::string* const space = dict->FindString(kSpace)) {
+      if (const std::optional<base::Token> token =
+              base::Token::FromString(*space)) {
+        record.space = SpaceId::FromRawToken(*token);
+        record.has_space = true;
+      }
+    }
+    // A Space pin belongs to a Space; one whose Space did not read is dropped
+    // rather than shown in a Space it never had.
+    if (record.tier == PinTier::kSpacePin && !record.has_space) {
+      continue;
+    }
+    if (const std::string* const home = dict->FindString(kHome)) {
+      record.home = GURL(*home);
+    }
+    if (const std::string* const page = dict->FindString(kPage)) {
+      record.page = GURL(*page);
+    }
+    if (const std::string* const name = dict->FindString(kName)) {
+      record.name = base::UTF8ToUTF16(*name);
+    }
+    if (const std::string* const title = dict->FindString(kTitle)) {
+      record.title = base::UTF8ToUTF16(*title);
+    }
+    if (const std::string* const folder = dict->FindString(kFolder)) {
+      record.folder_path = *folder;
+    }
+    record.separator = dict->FindBool(kSeparator).value_or(false);
+    records.push_back(std::move(record));
+  }
+  return records;
+}
+
+}  // namespace spaces
diff --git a/chrome/browser/ui/spaces/pin_store.h b/chrome/browser/ui/spaces/pin_store.h
new file mode 100644
index 0000000000000..63feeffeee367
--- /dev/null
+++ b/chrome/browser/ui/spaces/pin_store.h
@@ -0,0 +1,183 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_PIN_STORE_H_
+#define CHROME_BROWSER_UI_SPACES_PIN_STORE_H_
+
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/values.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "url/gurl.h"
+
+class PrefService;
+
+namespace spaces {
+
+// windows G2 (ADR 0035): the tier of a pinned row.
+enum class PinTier {
+  kSpacePin,
+  kEssential,
+};
+
+// windows G2: one Space pin or one essential, as the profile has it. Every
+// window that follows the registry shows it as a tab of its own.
+struct PinRecord {
+  PinRecord();
+  PinRecord(const PinRecord& other);
+  PinRecord& operator=(const PinRecord& other);
+  PinRecord(PinRecord&& other);
+  PinRecord& operator=(PinRecord&& other);
+  ~PinRecord();
+
+  bool operator==(const PinRecord& other) const;
+  // Everything but the title, which follows page loads and is written with
+  // the next real change (windows G13).
+  bool SameExceptTitle(const PinRecord& other) const;
+
+  // The tab token sync and the sidebar file already use (`stedding.tab_token`):
+  // each window's tab of this record carries it.
+  std::string id;
+  PinTier tier = PinTier::kSpacePin;
+  // A Space pin's Space. For an essential, the Space it is the own essential
+  // of (ADR 0028); none for a shared essential.
+  SpaceId space = SpaceId::CreateEmpty();
+  bool has_space = false;
+  GURL home;
+  // For a row with no web home (a local file, pins H13), the page it shows,
+  // which another window's tab of it opens; empty otherwise.
+  GURL page;
+  // The name the person gave it (pins H15); empty for none.
+  std::u16string name;
+  // The page's title as last seen, for a window's asleep tab of it.
+  std::u16string title;
+  // folders F38: for a pin in a pinned folder, the folder's path as the
+  // session keeps it (`stedding.folderpath`); empty for none.
+  std::string folder_path;
+  // The separator above the row (sidebar Y-rows; the sidebar file keeps it).
+  bool separator = false;
+};
+
+// windows G13, G15: what a window publishes after a change made there
+// (PinStore::ChangesSince).
+struct PinChanges {
+  PinChanges();
+  PinChanges(const PinChanges& other);
+  PinChanges& operator=(const PinChanges& other);
+  PinChanges(PinChanges&& other);
+  PinChanges& operator=(PinChanges&& other);
+  ~PinChanges();
+
+  // The ids of each run whose order changed there, in the window's order.
+  std::vector<std::string> order;
+  std::vector<PinRecord> changed;
+};
+
+// windows G2, G13 (ADR 0035): the profile's pinned run and essentials, kept
+// beside the Space registry in the preference stedding.pins.store, written on
+// every change. Each window's SpaceModel publishes what changed there and
+// follows what changed elsewhere.
+class PinStore : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // The records changed in some way; a window re-reads them whole.
+    virtual void OnPinStoreChanged() {}
+  };
+
+  // A store with no PrefService (a test's) is never written.
+  explicit PinStore(PrefService* prefs);
+  PinStore(const PinStore&) = delete;
+  PinStore& operator=(const PinStore&) = delete;
+  ~PinStore() override;
+
+  // In the profile's order: each window takes its runs from it.
+  const std::vector<PinRecord>& records() const { return records_; }
+  const PinRecord* Find(const std::string& id) const;
+  // windows G19: whether the store has been filled once, from the windows the
+  // session brought back. Until then a window publishes nothing.
+  bool ready() const { return ready_; }
+
+  // windows G13, G15: what changed in a window. `order` is the ids of the
+  // runs whose order changed there, in the window's order; each run (the
+  // essentials, or a Space's pins) merges on its own, so one run's order
+  // never moves another's rows. A record of the run the window lacks (a tab
+  // moved away) keeps its place after the record it followed, and an id the
+  // store does not know and `changed` does not bring is ignored. Each of
+  // `changed`, the records whose tab changed there, is added or updated; one
+  // `order` lacks keeps its place, and a new one goes at the end. A record the
+  // window did not touch is never written back from it (ChangesSince). Only
+  // `removed` removes: a tab missing from a window is never a removal. Tells
+  // the observers if anything but a title changed.
+  void Publish(const std::vector<std::string>& order,
+               const std::vector<PinRecord>& changed,
+               const std::set<std::string>& removed);
+
+  // windows G13, G15, G16: what a window that held `held` at its last
+  // reconcile or publish and has `now` sends, each in its strip's order. Sent
+  // are a record it held, and the store still has, whose fields changed
+  // there, as the store has it with only those fields changed; a record made
+  // there, which neither `held` nor the store has; and the ids of each run
+  // (the essentials, or a Space's pins) whose rows it reordered there. A run
+  // that only gained rows keeps the store's order, each new row after the
+  // row it follows in the window. Not sent: a record removed from the store
+  // since (the removal elsewhere wins, and the window lets its tab go), a tab
+  // of a record that came from another window (the window puts it in the
+  // record's place), and a record the window has two tabs of (the window keeps
+  // one).
+  PinChanges ChangesSince(const std::vector<PinRecord>& held,
+                          const std::vector<PinRecord>& now) const;
+
+  // windows G19: the first fill, from every window the session brought back,
+  // in session order, each in its own order. A later window's Space pin with
+  // the home and Space of a record an earlier window gave, or its essential
+  // with that home and Space, is that record, once per window. Returns, for
+  // each window, the ids its tabs must take: a tab's id that maps to another
+  // is the same record. Marks the store ready even with nothing to fill.
+  std::vector<std::map<std::string, std::string>> Fill(
+      const std::vector<std::vector<PinRecord>>& windows);
+
+  // windows G21: the records of a deleted Space move once, to `to`, after its
+  // last record. Its own essentials stay own essentials when `to` has a
+  // session of its own, and become `to`'s Space pins otherwise (ADR 0028).
+  void MoveSpace(const SpaceId& from,
+                 const SpaceId& to,
+                 bool to_has_own_session);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  static base::ListValue ToValue(const std::vector<PinRecord>& records);
+  static std::vector<PinRecord> FromValue(const base::ListValue& value);
+
+  // windows G13: the ids in `published` (a window's order) merged into
+  // `current`: published ids take their order, an id only `current` has keeps
+  // its place after the id it followed there, and `removed` ids go.
+  static std::vector<std::string> MergeOrder(
+      const std::vector<std::string>& current,
+      const std::vector<std::string>& published,
+      const std::set<std::string>& removed);
+
+ private:
+  void Changed();
+
+  const raw_ptr<PrefService> prefs_;
+  std::vector<PinRecord> records_;
+  bool ready_ = false;
+  base::ObserverList<Observer> observers_;
+  // Changed() is telling the observers; a change meanwhile is told after.
+  bool notifying_ = false;
+  bool changed_again_ = false;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_PIN_STORE_H_
