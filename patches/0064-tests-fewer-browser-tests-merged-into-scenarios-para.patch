+// S-137: a row brought back before a restart keeps the close's batch and
+// its order. The next row of that close counts it. The slot is not saved
+// on the open tab: a startup rebuild would place it again.
+TEST_F(FolderSessionTest, ARowBroughtBackBeforeARestartIsCounted) {
+  for (int i = 0; i < 4; ++i) {
+    AddTab(browser(), GURL("https://example.com/"));
+  }
+  TabStripModel* const tabs = browser()->tab_strip_model();
+  ASSERT_EQ(4, tabs->count());
+  // F[a, b, d]. c is the row still to come back.
+  tabs::TabInterface* const a = tabs->GetTabAtIndex(0);
+  tabs::TabInterface* const b = tabs->GetTabAtIndex(1);
+  tabs::TabInterface* const d = tabs->GetTabAtIndex(2);
+  tabs::TabInterface* const c = tabs->GetTabAtIndex(3);
+  tabs::FolderTabCollection* const folder = tabs->AddToNewFolder({0, 1, 2});
+  ASSERT_NE(nullptr, folder);
+  spaces::ClosedFolderPlace::CreateForWebContents(a->GetContents(), "batch-1",
+                                                   0);
+
+  const std::unique_ptr<sessions::SessionWindow> window =
+      RebuildAndRestore(browser());
+  const auto extra_of = [&](tabs::TabInterface* tab)
+      -> std::map<std::string, std::string> {
+    const SessionID id =
+        sessions::SessionTabHelper::IdForTab(tab->GetContents());
+    for (const auto& saved : window->tabs) {
+      if (saved->tab_id == id) {
+        return saved->extra_data;
+      }
+    }
+    return {};
+  };
+  const std::map<std::string, std::string> saved = extra_of(a);
+  const std::map<std::string, std::string> survivor = extra_of(b);
+  const auto batch = saved.find(kClosedFolderKey);
+  const auto order = saved.find(kClosedFolderOrderKey);
+  const auto path = saved.find(kSessionTabFolderPathKey);
+  ASSERT_NE(batch, saved.end());
+  ASSERT_NE(order, saved.end());
+  ASSERT_NE(path, saved.end());
+  EXPECT_EQ("batch-1", batch->second);
+  EXPECT_EQ("0", order->second);
+  EXPECT_EQ(saved.end(), saved.find(kClosedFolderSlotKey));
+  EXPECT_FALSE(path->second.empty());
+  EXPECT_EQ(survivor.end(), survivor.find(kClosedFolderKey));
+
+  // The next start: the mark comes back from that entry, and not a slot.
+  a->GetContents()->RemoveUserData(spaces::ClosedFolderPlace::UserDataKey());
+  ASSERT_EQ(nullptr,
+            spaces::ClosedFolderPlace::FromWebContents(a->GetContents()));
+  spaces::RestoreSpaceFromExtraData(a->GetContents(), saved);
+  const spaces::ClosedFolderPlace* const brought_back =
+      spaces::ClosedFolderPlace::FromWebContents(a->GetContents());
+  ASSERT_NE(nullptr, brought_back);
+  EXPECT_EQ("batch-1", brought_back->batch());
+  EXPECT_EQ(0, brought_back->order());
+  const spaces::FolderRestorePath* const parked =
+      spaces::FolderRestorePath::FromWebContents(a->GetContents());
+  ASSERT_NE(nullptr, parked);
+  EXPECT_TRUE(parked->slots().empty());
+
+  // c's close left one survivor before it. With a already back, c lands
+  // after b. Without the mark it would land before b.
+  const std::map<std::string, std::string> closed = {
+      {kSessionTabFolderPathKey, path->second},
+      {kClosedFolderKey, "batch-1"},
+      {kClosedFolderOrderKey, "1"},
+      {kClosedFolderSlotKey, "1"},
+  };
+  spaces::RestoreSpaceFromExtraData(c->GetContents(), closed);
+
+  FolderSessionService service(*browser());
+  service.OnSessionRestored(profile(), tabs->count());
+
+  EXPECT_EQ(folder, a->GetParentCollection());
+  EXPECT_EQ(folder, b->GetParentCollection());
+  EXPECT_EQ(folder, c->GetParentCollection());
+  EXPECT_EQ(folder, d->GetParentCollection());
+  ASSERT_TRUE(folder->GetIndexOfTabRecursive(a).has_value());
+  ASSERT_TRUE(folder->GetIndexOfTabRecursive(b).has_value());
+  ASSERT_TRUE(folder->GetIndexOfTabRecursive(c).has_value());
+  ASSERT_TRUE(folder->GetIndexOfTabRecursive(d).has_value());
+  EXPECT_EQ(0u, folder->GetIndexOfTabRecursive(a).value());
+  EXPECT_EQ(1u, folder->GetIndexOfTabRecursive(b).value());
+  EXPECT_EQ(2u, folder->GetIndexOfTabRecursive(c).value());
+  EXPECT_EQ(3u, folder->GetIndexOfTabRecursive(d).value());
+}
+
 }  // namespace
 }  // namespace stedding
