@@ -0,0 +1,212 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_backup.h"
+
+#include <string>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_colors.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace spaces {
+namespace {
+
+class SidebarBackupTest : public BrowserWithTestWindowTest {
+ protected:
+  SpaceModel& model() { return *SpaceModel::From(browser()); }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  tabs::TabInterface* Open(const char* url) {
+    AddTab(browser(), GURL(url));
+    return tabs().GetActiveTab();
+  }
+};
+
+// I17: every field a sidebar has.
+TEST_F(SidebarBackupTest, SnapshotCarriesEveryField) {
+  Space* const work = model().AddSpace("Work", kSpaceColors[1].color);
+  model().SetSpaceIcon(work->id(), "💼");
+  tabs::TabInterface* const essential = Open("https://e.example/");
+  tabs().SetTabPinned(0, true);
+  tabs::TabInterface* const plain = Open("https://plain.example/");
+  tabs::TabInterface* const pinned = Open("https://pin.example/");
+  model().SetSpacePinned(pinned, true);
+  tabs::TabInterface* const in_folder = Open("https://f.example/");
+  stedding::SetTabName(browser(), in_folder, u"My name");
+  tabs::FolderTabCollection* const folder =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(in_folder)});
+  folder->SetTitle("Docs");
+  (void)essential;
+  (void)plain;
+
+  const ArcImportPlan plan = SnapshotSidebar(browser());
+  ASSERT_EQ(1u, plan.essentials.size());
+  EXPECT_EQ(GURL("https://e.example/"), plan.essentials[0].url);
+  ASSERT_EQ(2u, plan.spaces.size()) << "the default Space and Work, in order";
+  EXPECT_EQ("Space 1", plan.spaces[0].title);
+  EXPECT_EQ("Work", plan.spaces[1].title);
+  EXPECT_EQ("💼", plan.spaces[1].emoji);
+  EXPECT_EQ(kSpaceColors[1].color, *plan.spaces[1].color);
+  const ArcImportPlan::Space& home = plan.spaces[0];
+  ASSERT_EQ(2u, home.pinned.size()) << "the pin, then the folder";
+  EXPECT_EQ(ArcImportPlan::Node::Kind::kTab, home.pinned[0].kind);
+  EXPECT_EQ(GURL("https://pin.example/"), home.pinned[0].url) << "its home";
+  EXPECT_EQ(ArcImportPlan::Node::Kind::kFolder, home.pinned[1].kind);
+  EXPECT_EQ(u"Docs", home.pinned[1].title);
+  ASSERT_EQ(1u, home.pinned[1].children.size());
+  EXPECT_EQ(u"My name", home.pinned[1].children[0].title) << "tabs R15";
+  ASSERT_EQ(1u, home.unpinned.size());
+  EXPECT_EQ(GURL("https://plain.example/"), home.unpinned[0].url);
+}
+
+// I18: the file is the importer's format; what is written is read back
+// whole.
+TEST_F(SidebarBackupTest, RoundTripIsIdentity) {
+  Space* const work = model().AddSpace("Work", kSpaceColors[2].color);
+  model().SetSpaceIcon(work->id(), "💼");
+  Open("https://a.example/");
+  tabs::TabInterface* const pinned = Open("https://pin.example/");
+  model().SetSpacePinned(pinned, true);
+  tabs::TabInterface* const in_folder = Open("https://f.example/");
+  tabs().AddToNewFolder({tabs().GetIndexOfTab(in_folder)})->SetTitle("Docs");
+  const ArcImportPlan before = SnapshotSidebar(browser());
+  const std::optional<ArcImportPlan> after =
+      ParseArcSidebar(PlanToJson(before));
+  ASSERT_TRUE(after.has_value());
+  ASSERT_EQ(before.spaces.size(), after->spaces.size());
+  for (size_t i = 0; i < before.spaces.size(); ++i) {
+    EXPECT_EQ(before.spaces[i].arc_id, after->spaces[i].arc_id);
+    EXPECT_EQ(before.spaces[i].title, after->spaces[i].title);
+    EXPECT_EQ(before.spaces[i].emoji, after->spaces[i].emoji);
+    EXPECT_EQ(before.spaces[i].color, after->spaces[i].color);
+    ASSERT_EQ(before.spaces[i].pinned.size(), after->spaces[i].pinned.size());
+    ASSERT_EQ(before.spaces[i].unpinned.size(),
+              after->spaces[i].unpinned.size());
+    for (size_t j = 0; j < before.spaces[i].pinned.size(); ++j) {
+      EXPECT_EQ(before.spaces[i].pinned[j].kind,
+                after->spaces[i].pinned[j].kind);
+      EXPECT_EQ(before.spaces[i].pinned[j].arc_id,
+                after->spaces[i].pinned[j].arc_id);
+      EXPECT_EQ(before.spaces[i].pinned[j].title,
+                after->spaces[i].pinned[j].title);
+      EXPECT_EQ(before.spaces[i].pinned[j].url, after->spaces[i].pinned[j].url);
+      EXPECT_EQ(before.spaces[i].pinned[j].children.size(),
+                after->spaces[i].pinned[j].children.size());
+    }
+  }
+  EXPECT_EQ(before.essentials.size(), after->essentials.size());
+}
+
+// I19: a restore adds what is missing and closes nothing.
+TEST_F(SidebarBackupTest, RestoreClosesNothing) {
+  tabs::TabInterface* const kept = Open("https://kept.example/");
+  Open("https://lost.example/");
+  const std::string json = PlanToJson(SnapshotSidebar(browser()));
+  tabs().CloseWebContentsAt(tabs().GetIndexOfTab(tabs().GetActiveTab()),
+                            TabCloseTypes::CLOSE_NONE);
+  ASSERT_EQ(1, tabs().count());
+  const std::optional<ArcImportPlan> plan = ParseArcSidebar(json);
+  ASSERT_TRUE(plan.has_value());
+  const ArcImportResult result =
+      ApplyArcImport(browser(), *plan, ArcImportOptions());
+  EXPECT_EQ(1u, result.tabs) << "the lost tab came back";
+  EXPECT_EQ(0u, result.spaces) << "the Space is its own, by id";
+  EXPECT_EQ(2, tabs().count());
+  EXPECT_EQ(kept, tabs().GetTabAtIndex(tabs().GetIndexOfTab(kept)))
+      << "the open tab was left alone";
+  EXPECT_EQ(1u, model().size());
+}
+
+// I20: one Space exported reads back as one Space.
+TEST_F(SidebarBackupTest, ExportOneSpaceImportsBack) {
+  Space* const work = model().AddSpace("Work", kSpaceColors[3].color);
+  model().SetActiveSpace(work->id());
+  Open("https://work.example/");
+  const ArcImportPlan one = SnapshotSpace(browser(), work->id());
+  ASSERT_EQ(1u, one.spaces.size());
+  EXPECT_EQ("Work", one.spaces[0].title);
+  const std::optional<ArcImportPlan> back = ParseArcSidebar(PlanToJson(one));
+  ASSERT_TRUE(back.has_value());
+  ASSERT_EQ(1u, back->spaces.size());
+  EXPECT_EQ("Work", back->spaces[0].title);
+  ASSERT_EQ(1u, back->spaces[0].unpinned.size());
+  EXPECT_EQ(GURL("https://work.example/"), back->spaces[0].unpinned[0].url);
+  EXPECT_TRUE(back->essentials.empty());
+}
+
+// PRODUCT §1's schedule, over a year of hourly files.
+TEST(SidebarBackupScheduleTest, KeepsTenTodayThenDaysWeeksMonths) {
+  const base::Time now = base::Time::Now();
+  std::vector<base::Time> times;
+  for (int hours = 0; hours < 24 * 400; ++hours) {
+    times.push_back(now - base::Hours(hours));
+  }
+  const std::vector<bool> keep = KeepUnderSchedule(times, now);
+  int today = 0;
+  int days = 0;
+  int weeks = 0;
+  int months = 0;
+  int older = 0;
+  for (size_t i = 0; i < times.size(); ++i) {
+    if (!keep[i]) {
+      continue;
+    }
+    const base::TimeDelta age = now - times[i];
+    if (age < base::Days(1)) {
+      ++today;
+    } else if (age < base::Days(11)) {
+      ++days;
+    } else if (age < base::Days(11 + 28)) {
+      ++weeks;
+    } else if (age < base::Days(11 + 28 + 360)) {
+      ++months;
+    } else {
+      ++older;
+    }
+  }
+  EXPECT_EQ(10, today);
+  EXPECT_EQ(10, days);
+  EXPECT_EQ(4, weeks);
+  EXPECT_EQ(12, months);
+  EXPECT_EQ(0, older);
+}
+
+TEST(SidebarBackupScheduleTest, FileNamesCarryTheirTime) {
+  base::Time::Exploded exploded = {};
+  exploded.year = 2026;
+  exploded.month = 9;
+  exploded.day_of_month = 5;
+  exploded.hour = 14;
+  exploded.minute = 30;
+  exploded.second = 7;
+  base::Time when;
+  ASSERT_TRUE(base::Time::FromLocalExploded(exploded, &when));
+  const base::FilePath name = BackupFileName(when);
+  EXPECT_EQ("sidebar-20260905-143007.json", name.value());
+  EXPECT_EQ(when, *TimeFromBackupFileName(base::FilePath("/x/y").Append(name)));
+  EXPECT_FALSE(TimeFromBackupFileName(base::FilePath("/x/other.json")));
+
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  WriteBackup(dir.GetPath(), "{}", when);
+  WriteBackup(dir.GetPath(), "{}", when + base::Minutes(1));
+  const std::vector<BackupFile> files = ListBackups(dir.GetPath());
+  ASSERT_EQ(2u, files.size());
+  EXPECT_EQ(when + base::Minutes(1), files[0].time) << "newest first";
+}
+
+}  // namespace
+}  // namespace spaces
