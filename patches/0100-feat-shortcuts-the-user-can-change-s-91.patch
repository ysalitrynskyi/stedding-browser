+// The block as the page draws it: `body` runs with `editor`, the element, and
+// `rows`, its rows by name.
+std::string OnTheBlock(const std::string& body) {
+  return R"(
+    (() => {
+      const find = root => {
+        const hit = root.querySelector('settings-stedding-shortcuts-editor');
+        if (hit) {
+          return hit;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          if (element.shadowRoot) {
+            const found = find(element.shadowRoot);
+            if (found) {
+              return found;
+            }
+          }
+        }
+        return null;
+      };
+      const editor = find(document);
+      if (!editor || !editor.shadowRoot) {
+        return '';
+      }
+      const rows = name => editor.shadowRoot.querySelector(
+          '.shortcut-row[data-name="' + name + '"]');
+      )" +
+         body + R"(
+    })()
+  )";
+}
