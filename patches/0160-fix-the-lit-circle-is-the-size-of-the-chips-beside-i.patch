@@ -42,6 +42,21 @@ std::optional<SkColor> UniformTopEdgeColor(const SkBitmap& strip);
 // other is not worth re-theming the window: every channel within two.
 bool PageColorsMatch(SkColor a, SkColor b);
 
+// toolbar T62 (BACKLOG S-468, GitHub issue 101): whether `after` is `before`
+// under a dark layer the page put over itself, as a page does under its own
+// dialog: every channel darker by about the same share of its light, the
+// brightest channel keeping between kPageDimLeastKept and kPageDimMostKept of
+// it. `before` must be bright enough for a dimming to show (its brightest
+// channel kPageDimMinBrightness or more). The layer may be tinted: each
+// channel may stray from the shared share by kPageDimSlack plus
+// kPageDimTintSlack times the share taken away.
+inline constexpr int kPageDimMinBrightness = 48;
+inline constexpr double kPageDimLeastKept = 0.05;
+inline constexpr double kPageDimMostKept = 0.97;
+inline constexpr int kPageDimSlack = 8;
+inline constexpr int kPageDimTintSlack = 24;
+bool IsDimmedEdge(SkColor before, SkColor after);
+
 }  // namespace stedding
 
 #endif  // CHROME_BROWSER_UI_STEDDING_THEME_PAGE_TOP_COLOR_H_
