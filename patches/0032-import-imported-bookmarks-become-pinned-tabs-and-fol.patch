+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_BOOKMARKS_TO_PINS_H_
+#define CHROME_BROWSER_UI_SPACES_BOOKMARKS_TO_PINS_H_
+
+#include <vector>
+
+#include "chrome/browser/ui/spaces/arc_sidebar_importer.h"
+
+class BrowserWindowInterface;
+
+namespace bookmarks {
+class BookmarkModel;
+}
+
+namespace stedding {
+
+// docs/features/import.md I13: the bookmark tree as a plan's nodes -- the
+// bookmark bar's first, then Other bookmarks; every folder a folder, every
+// bookmark a tab. Ids are "bookmark:<id>", so a second run adds nothing.
+std::vector<spaces::ArcImportPlan::Node> NodesFromBookmarks(
+    const bookmarks::BookmarkModel& model);
+
+// I13, I14: turns the profile's bookmarks into Space-pinned tabs and folders
+// in `browser`'s active Space, and hides the bookmark bar and the star from
+// then on (stedding.bookmarks.converted). Nothing happens without a loaded
+// bookmark model or without a Space model.
+spaces::ArcImportResult ConvertBookmarksToPins(BrowserWindowInterface* browser);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_SPACES_BOOKMARKS_TO_PINS_H_
