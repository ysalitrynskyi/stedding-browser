+  Open("stay-grid.test");
+  while (m->size() < 6) {
+    m->AddSpace(base::StrCat({"G", base::NumberToString(m->size())}),
+                SK_ColorGREEN);
+  }
+  std::vector<spaces::SpaceId> order;
+  for (const auto& space : m->spaces()) {
+    order.push_back(space->id());
+  }
+  ASSERT_EQ(home, order.front());
+  ASSERT_NO_FATAL_FAILURE(CollapseToTheRail());
+  views::test::RunScheduledLayout(widget());
+  spaces::SpaceSwitcherView* const switcher =
+      stedding::test::FindDrawnSwitcher(root());
+  ASSERT_TRUE(switcher);
+  const auto box = [&](const spaces::SpaceId& id) {
+    views::View* const chip = switcher->ChipForTesting(id);
+    return chip ? chip->GetBoundsInScreen() : gfx::Rect();
+  };
+  ASSERT_EQ(spaces::kSwitcherChip, box(home).width()) << "no lead";
+  ASSERT_EQ(spaces::kSwitcherDot, box(order[2]).width()) << "no grid";
+  ASSERT_EQ(box(order[1]).y(), box(order[2]).y()) << "no line of two";
+  const spaces::SpaceId lit = order[2];
+  std::map<spaces::SpaceId, gfx::Rect> before;
+  for (const spaces::SpaceId& id : order) {
+    before[id] = box(id);
+  }
+  const gfx::Point on_dot = box(lit).CenterPoint();
+  const gfx::Point from = RowCentre(dragged);
+  const auto others_in_place = [&]() {
+    std::vector<size_t> moved;
+    for (size_t i = 0; i < order.size(); ++i) {
