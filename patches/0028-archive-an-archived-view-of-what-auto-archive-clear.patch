+#include "ui/webui/webui_util.h"
+
+namespace stedding {
+
+ArchiveUI::ArchiveUI(content::WebUI* web_ui) : content::WebUIController(web_ui) {
+  Profile* const profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* const source = content::WebUIDataSource::CreateAndAdd(
+      profile, kArchiveHost);
+  webui::SetupWebUIDataSource(source, kSteddingArchiveResources,
+                              IDR_STEDDING_ARCHIVE_STEDDING_ARCHIVE_HTML);
+  web_ui->AddMessageHandler(std::make_unique<ArchiveHandler>());
+}
+
+ArchiveUI::~ArchiveUI() = default;
+
+ArchiveUIConfig::ArchiveUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kArchiveHost) {}
+
+}  // namespace stedding
