+# Copyright 2026 The Stedding Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+assert(!is_android)
+
+# Ad and tracker blocking (docs/features/blocker.md,
+# docs/decisions/0030-ad-and-tracker-blocking.md): the switch and the
+# exceptions for a site, the filter lists fetched at run time and converted
+# into Chromium's subresource filter ruleset, and the throttle that turns the
+# filter on for each page. Nothing of the window's, so the toolbar, the
+# command bar, Settings and the browser's start can all use it.
+source_set("blocker") {
+  public = [
+    "blocker.h",
+    "blocker_activation_throttle.h",
+    "blocker_convert.h",
+    "blocker_lists.h",
+    "blocker_rules.h",
+  ]
+  sources = [
+    "blocker.cc",
+    "blocker_activation_throttle.cc",
+    "blocker_convert.cc",
+    "blocker_lists.cc",
+    "blocker_rules.cc",
+  ]
+  public_deps = [
+    "//base",
+    "//components/content_settings/core/browser",
+    "//components/content_settings/core/common",
+    "//components/prefs",
+    "//components/subresource_filter/core/browser",
+    "//content/public/browser",
+    "//services/network/public/cpp",
+    "//url",
+  ]
+  deps = [
+    "//chrome/browser:browser_process",
+    "//chrome/browser/content_settings:content_settings_factory",
+    "//chrome/browser/profiles:profile",
+    "//chrome/browser/ui/stedding:dark_pages",
+    "//chrome/browser/ui/stedding:prefs",
+    "//chrome/common",
+    "//components/subresource_filter/content/browser",
+    "//components/subresource_filter/core/common",
+    "//components/subresource_filter/core/mojom",
+    "//components/subresource_filter/tools/rule_parser",
+    "//components/url_pattern_index",
+    "//crypto",
+    "//net",
+    "//services/network/public/mojom",
+    "//third_party/protobuf:protobuf_lite",
+  ]
+}
+
+# The rules, the lists' schedule and the converter, without a browser: a
+# test URL loader factory and a scratch folder stand in for the network and
+# the profile's folder (blocker Bk1-Bk3, Bk5, Bk8).
+source_set("unit_tests") {
+  testonly = true
+  sources = [
+    "blocker_convert_unittest.cc",
+    "blocker_lists_unittest.cc",
+    "blocker_rules_unittest.cc",
+  ]
+  deps = [
+    ":blocker",
+    "//base",
