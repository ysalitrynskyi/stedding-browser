+void PartsToBlock(const FileParts& parts, base::DictValue& block) {
+  if (parts.settings) {
+    block.Set(kSettingsPartKey, SettingsToValue(*parts.settings));
+  }
+  if (parts.extensions) {
+    block.Set(kExtensionsPartKey, ExtensionsToValue(*parts.extensions));
+  }
+}
+
+FileParts PartsFromBlock(const base::DictValue& block) {
+  FileParts parts;
+  if (const base::Value* const settings = block.Find(kSettingsPartKey)) {
+    parts.settings = SettingsFromValue(*settings);
+  }
+  if (const base::Value* const extensions = block.Find(kExtensionsPartKey)) {
+    parts.extensions = ExtensionsFromValue(*extensions);
+  }
+  return parts;
+}
