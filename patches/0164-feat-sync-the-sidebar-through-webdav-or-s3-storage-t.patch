+base::DictValue FailureAnswer(std::string_view failure,
+                              const std::string& region = std::string()) {
+  base::DictValue answer;
+  answer.Set("failure", failure);
+  answer.Set("region", region);
+  return answer;
+}
+
+base::DictValue CheckAnswer(const sidebar_sync::PlaceCheck::Result& result) {
+  return result.failure == sidebar_sync::PlaceFailure::kNone
+             ? base::DictValue()
+             : FailureAnswer(sidebar_sync::PlaceFailureName(result.failure),
+                             result.region);
+}
