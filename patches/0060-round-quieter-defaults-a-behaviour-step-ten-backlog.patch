+// docs/features/tabs.md R25-R27, R30 (BACKLOG S-97): a close the user makes
+// shows a toast, and its Undo brings that close back in place, through the
+// recently-closed list.
+class UndoCloseTest : public RestoreTest {
+ protected:
+  // A new foreground tab on `host` showing a page titled "Title Of
+  // Awesomeness", loaded.
+  tabs::TabInterface* OpenTitled(const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, "/title2.html"),
+        WindowOpenDisposition::NEW_FOREGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  ToastController* toasts() { return ToastController::From(browser()); }
+
+  bool UndoToastShowing() {
+    return toasts() &&
+           toasts()->GetCurrentToastId() == ToastId::kSteddingTabsClosed;
+  }
+
+  // Runs what is already posted: a close's toast is posted in the close's
+  // turn, so after this it shows or it never will.
+  void RunPostedTasks() {
+    base::RunLoop run_loop;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, run_loop.QuitClosure());
+    run_loop.Run();
+  }
+
+  // The undo toast, reading `text`, with its Undo button.
+  void WaitForUndoToast(const std::u16string& text) {
+    ASSERT_TRUE(toasts());
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      toasts::ToastView* const view = toasts()->GetToastViewForTesting();
+      return UndoToastShowing() && view && view->label_for_testing() &&
+             view->label_for_testing()->GetText() == text;
+    })) << "the toast reads " << base::UTF16ToUTF8(text);
+    ASSERT_TRUE(toasts()->GetToastViewForTesting()->action_button_for_testing())
+        << "with an Undo button";
+    // Held for the steps that follow: on a slow build Chromium's 8 seconds
+    // can run out between the close and the press.
+    toasts()->GetToastCloseTimerForTesting()->Stop();
+  }
+
+  // The toast's Undo, as a click on it.
+  void PressUndo() {
+    ASSERT_TRUE(toasts());
+    toasts::ToastView* const view = toasts()->GetToastViewForTesting();
+    ASSERT_TRUE(view);
+    views::MdTextButton* const undo = view->action_button_for_testing();
+    ASSERT_TRUE(undo);
+    views::test::ButtonTestApi(undo).NotifyClick(ui::MouseEvent(
+        ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+        base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+        ui::EF_LEFT_MOUSE_BUTTON));
+  }
+
+  std::string HostOf(tabs::TabInterface* tab) {
+    return tab ? std::string(tab->GetContents()->GetLastCommittedURL().host())
+               : std::string();
+  }
+};
