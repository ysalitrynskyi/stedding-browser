+void SetSpaceSessionAfterAsking(BrowserWindowInterface* window,
+                                const SpaceId& id,
+                                const std::string& session,
+                                const std::string& new_name) {
+  // Shared is the session turned off: S10's question, its words included.
+  if (session.empty() && new_name.empty()) {
+    SetSpaceIsolatedAfterAsking(window, id, /*isolated=*/false);
+    return;
+  }
+  SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+  if (!model || !model->GetSpace(id) || !model->registry()) {
+    return;
+  }
+  // The model may go with its window while the question is open, and the
+  // session with another window's Delete Session: the answer looks both up
+  // again.
+  base::OnceClosure apply = base::BindOnce(
+      [](base::WeakPtr<SpaceModel> model, SpaceId id, std::string session,
+         std::string new_name) {
+        if (!model || !model->GetSpace(id)) {
+          return;
+        }
+        if (session.empty()) {
+          session = model->MakeSession(new_name);
+        } else if (!model->registry()->FindSession(session)) {
+          return;
+        }
+        model->SetSpaceSession(id, session);
+      },
+      model->GetWeakPtr(), id, session, new_name);
+  const int pages = model->CountPagesAJarChangeReloads(id);
+  // sessions S52: the apps made in the Space keep its session while a Space
+  // does, and otherwise take the shared one.
+  const std::vector<std::u16string> apps =
+      model->SpaceIsIsolated(id) && !AnotherSpaceUsesSessionOf(*model, id)
+          ? AppsKeepingSessionOf(window, *model, id)
+          : std::vector<std::u16string>();
+  if (pages == 0 && apps.empty()) {
+    std::move(apply).Run();
+    return;
+  }
+  const std::u16string name = NameInSentence(model->DisplayName(id));
+  const std::u16string target =
+      session.empty() ? NameInSentence(base::UTF8ToUTF16(new_name))
+                      : SessionNameInSentence(*model, session);
+  std::u16string body;
+  if (pages > 0) {
+    body = base::StrCat(
+        {pages == 1 ? std::u16string(u"Its open page reloads")
+                    : base::StrCat({u"Its ", base::NumberToString16(pages),
+                                    u" open pages reload"}),
+         u" with the cookies of that session. A page holding changes you have "
+         u"not saved keeps them until you leave it."});
+  }
+  if (!apps.empty()) {
+    const std::u16string line = AppsKeepingSessionLine(
+        apps, u"use the shared session while no Space is in the one it left.");
+    body = body.empty() ? line : base::StrCat({body, u" ", line});
+  }
+  ConfirmInWindow(window,
+                  base::StrCat({u"Move \u201C", name, u"\u201D to the session "
+                                u"\u201C", target, u"\u201D?"}),
+                  std::move(body), u"Move", std::move(apply));
+}
+
+void NewSessionInDialog(BrowserWindowInterface* window, const SpaceId& id) {
+  SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+  ui::BaseWindow* const base_window = window ? window->GetWindow() : nullptr;
+  if (!model || !model->GetSpace(id) || !model->registry() || !base_window) {
+    return;
+  }
+  ui::DialogModel::Builder builder;
+  ui::DialogModel* const dialog = builder.model();
+  const std::u16string name = model->DisplayName(id);
+  base::OnceClosure create = base::BindOnce(
+      [](BrowserWindowInterface* window, base::WeakPtr<SpaceModel> model,
+         SpaceId id, ui::DialogModel* dialog) {
+        if (!model || !model->GetSpace(id)) {
+          return;
+        }
+        std::u16string name =
+            dialog->GetTextfieldByUniqueId(kSessionNameFieldId)->text();
+        if (name.empty()) {
+          name = model->DisplayName(id);
+        }
+        SetSpaceSessionAfterAsking(window, id, std::string(),
+                                   base::UTF16ToUTF8(name));
+      },
+      base::Unretained(window), model->GetWeakPtr(), id,
+      base::Unretained(dialog));
+  constrained_window::ShowBrowserModal(
+      builder.SetInternalName("SteddingNewSessionDialog")
+          .SetTitle(base::StrCat({u"New session for \u201C",
+                                  NameInSentence(name), u"\u201D"}))
+          .AddTextfield(kSessionNameFieldId, std::u16string(), name,
+                        ui::DialogModelTextfield::Params().SetAccessibleName(
+                            u"Session name"))
+          .AddOkButton(std::move(create),
+                       ui::DialogModel::Button::Params().SetLabel(u"Create"))
+          .AddCancelButton(base::DoNothing())
+          .SetInitiallyFocusedField(kSessionNameFieldId)
+          .Build(),
+      base_window->GetNativeWindow());
+}
+
+void ClearSessionAfterAsking(BrowserWindowInterface* window,
+                             const SpaceId& id) {
+  SpaceModel* const model = window ? SpaceModel::From(window) : nullptr;
+  if (!model || !model->SpaceIsIsolated(id)) {
+    return;
+  }
+  const std::vector<SpaceId> others = OthersNamingSessionOf(*model, id);
+  std::u16string title;
+  std::u16string body;
+  if (others.empty()) {
+    title = base::StrCat({u"Clear the independent session of \u201C",
+                          NameInSentence(model->DisplayName(id)),
+                          u"\u201D?"});
+    body =
+        u"Its cookies, logins and site data are erased and its tabs reload "
+        u"signed out. The Space and its tabs stay.";
+  } else {
+    // sessions S46: it signs out every Space that shares the jar.
+    std::vector<SpaceId> all = others;
+    all.insert(all.begin(), id);
+    title = base::StrCat({u"Clear the session \u201C",
+                          SessionNameInSentence(*model, model->SessionOf(id)),
+                          u"\u201D?"});
+    body = base::StrCat(
+        {u"Its cookies, logins and site data are erased for ",
+         QuotedSpaces(*model, all),
+         u", which share it, and their tabs reload signed out. The Spaces and "
