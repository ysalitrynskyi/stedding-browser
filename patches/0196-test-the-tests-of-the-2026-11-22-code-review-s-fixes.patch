+
+// The address a closed tab's record shows.
+GURL RecordedUrlW2B06(const sessions::tab_restore::Tab& tab) {
+  return tab.navigations.empty()
+             ? GURL()
+             : tab.navigations[tab.normalized_navigation_index()]
+                   .virtual_url();
+}
+
+// `key` of a closed tab's extra data, or "".
+std::string ExtraW2B06(const sessions::tab_restore::Tab& tab,
+                       const char* key) {
+  const auto it = tab.extra_data.find(key);
+  return it == tab.extra_data.end() ? std::string() : it->second;
+}
+
+// How many of `model`'s Spaces have `name` as their own name.
+int SpacesNamedW2B06(const spaces::SpaceModel& model, const std::string& name) {
+  int count = 0;
+  for (const std::unique_ptr<spaces::Space>& space : model.spaces()) {
+    count += space->name() == name;
+  }
+  return count;
+}
+
+// archive A9, windows G4: the archive's Restore makes a Space again only for
+// a Space that is gone. A Blank Window keeps Spaces of its own, which no
+// other window has, and has none of the profile's.
+class ArchiveRestoreW2B06Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+  sessions::TabRestoreService* service() {
+    return TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  }
+
+  GURL Url(const std::string& host) {
+    return embedded_test_server()->GetURL(host, "/title1.html");
+  }
+
+  // A new foreground tab of `window` on `host`, loaded.
+  tabs::TabInterface* Open(BrowserWindowInterface* window,
+                           const std::string& host) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        window, Url(host), WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return window->GetTabStripModel()->GetActiveTab();
+  }
+
+  // The tab of `window` showing `host`, or null.
+  static tabs::TabInterface* Find(BrowserWindowInterface* window,
+                                  const std::string& host) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    for (int i = 0; i < strip->count(); ++i) {
+      tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+      if (ShownUrlW2B06(tab->GetContents()).host() == host) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  // Closes `tab` of `window` as ⌘W does, into the recently-closed list.
+  static void CloseIntoTheList(BrowserWindowInterface* window,
+                               tabs::TabInterface* tab) {
+    TabStripModel* const strip = window->GetTabStripModel();
+    strip->CloseWebContentsAt(strip->GetIndexOfTab(tab),
+                              TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  }
+
+  // The recently-closed record of the tab on `host` closed on its own, or
+  // null.
+  const sessions::tab_restore::Tab* ClosedTab(const std::string& host) {
+    for (const std::unique_ptr<sessions::tab_restore::Entry>& entry :
+         service()->entries()) {
+      if (entry->type != sessions::tab_restore::TAB) {
+        continue;
+      }
+      const auto& tab = static_cast<const sessions::tab_restore::Tab&>(*entry);
+      if (RecordedUrlW2B06(tab).host() == host) {
+        return &tab;
+      }
+    }
+    return nullptr;
+  }
+
+  // A Blank Window (windows G4), opened as its command opens one.
+  BrowserWindowInterface* OpenBlankWindow() {
+    // The window opens inside the command, so the waiter comes first.
+    ui_test_utils::BrowserCreatedObserver opened;
+    chrome::ExecuteCommand(browser(), IDC_STEDDING_NEW_BLANK_WINDOW);
+    BrowserWindowInterface* const blank = opened.Wait();
+    EXPECT_TRUE(blank);
+    const spaces::SpaceModel* const blank_model =
+        blank ? spaces::SpaceModel::From(blank) : nullptr;
+    EXPECT_TRUE(blank_model);
+    EXPECT_TRUE(blank_model && !blank_model->follows_registry())
+        << "the window follows the profile's Spaces";
+    return blank_model && !blank_model->follows_registry() ? blank : nullptr;
+  }
+
+  // What the archive page's Restore and the command bar's archived row do
+  // with entry `id`, in `window`.
+  bool RestoreFromTheArchive(BrowserWindowInterface* window, SessionID id) {
+    const bool restored = stedding::RestoreArchivedTab(
+        window, BrowserLiveTabContext::From(window), service(), id);
+    base::RunLoop().RunUntilIdle();
+    return restored;
+  }
+};
+
+// P06-1f; archive A9, windows G4: a tab closed in a Blank Window's Space
+// "Scratch" and restored from the archive in a window of the profile comes
+// back in the Space that window shows. Scratch is still the Blank Window's,
+// so nothing is made for it: the profile's list of Spaces is as it was. The
+// restore read Scratch as deleted and added it to the profile's list, so to
+// every window of the profile. A Space deleted everywhere still comes back
+// by its own name.
+IN_PROC_BROWSER_TEST_F(ArchiveRestoreW2B06Test,
+                       RestoreOfABlankWindowsTabMakesNoSpaceForTheProfile) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  ASSERT_TRUE(m->registry());
+  const SpaceId home = m->active_id();
+
+  BrowserWindowInterface* const blank = OpenBlankWindow();
+  ASSERT_TRUE(blank);
+  spaces::SpaceModel* const blank_model = spaces::SpaceModel::From(blank);
+  spaces::Space* const made = blank_model->AddSpace("Scratch", SK_ColorRED);
+  ASSERT_TRUE(made);
+  const SpaceId scratch = made->id();
+  ASSERT_TRUE(blank_model->SetActiveSpace(scratch));
+  tabs::TabInterface* const closing = Open(blank, "scratch.test");
+  ASSERT_TRUE(closing);
+  // Not the Space's last tab, so its close opens nothing in its place.
+  ASSERT_TRUE(Open(blank, "scratch-kept.test"));
+  ASSERT_EQ(scratch, blank_model->SpaceForTab(closing));
+  CloseIntoTheList(blank, closing);
+  const sessions::tab_restore::Tab* const record = ClosedTab("scratch.test");
+  ASSERT_TRUE(record) << "the close was not recorded";
+  ASSERT_EQ(scratch.ToString(), ExtraW2B06(*record, spaces::kSessionTabSpaceKey))
+      << "the record does not name the Blank Window's Space";
+  ASSERT_EQ("Scratch", ExtraW2B06(*record, stedding::kArchiveSpaceRawNameKey));
+  const SessionID entry = record->id;
+
+  const size_t profile_spaces = m->registry()->entries().size();
+  const size_t window_spaces = m->size();
+  const size_t blank_spaces = blank_model->size();
+  ASSERT_TRUE(RestoreFromTheArchive(browser(), entry));
+  tabs::TabInterface* const back = Find(browser(), "scratch.test");
+  ASSERT_TRUE(back) << "the tab did not come back in the profile's window";
+  EXPECT_EQ(profile_spaces, m->registry()->entries().size())
+      << "a Space was added to the profile's list";
+  EXPECT_EQ(window_spaces, m->size());
+  EXPECT_EQ(0, SpacesNamedW2B06(*m, "Scratch"))
+      << "the Blank Window's Space was made again in the profile's window";
+  EXPECT_EQ(home, m->SpaceForTab(back)) << "not in the Space on screen";
+  EXPECT_EQ(home, m->active_id());
+  EXPECT_EQ(blank_spaces, blank_model->size());
+  EXPECT_TRUE(blank_model->GetSpace(scratch)) << "Scratch left its window";
+
+  {
+    SCOPED_TRACE("a Space deleted everywhere comes back by its own name");
+    const SpaceId gone = m->AddSpace("Gone", SK_ColorGREEN)->id();
+    ASSERT_TRUE(m->SetActiveSpace(gone));
+    tabs::TabInterface* const filed = Open(browser(), "gone.test");
+    ASSERT_TRUE(filed);
+    ASSERT_TRUE(Open(browser(), "gone-kept.test"));
+    ASSERT_EQ(gone, m->SpaceForTab(filed));
+    CloseIntoTheList(browser(), filed);
+    const sessions::tab_restore::Tab* const gone_record = ClosedTab("gone.test");
+    ASSERT_TRUE(gone_record) << "the close was not recorded";
+    const SessionID gone_entry = gone_record->id;
+    ASSERT_TRUE(m->SetActiveSpace(home));
+    ASSERT_TRUE(m->RemoveSpace(gone));
+    base::RunLoop().RunUntilIdle();
+    ASSERT_FALSE(m->GetSpace(gone));
+    ASSERT_EQ(0, SpacesNamedW2B06(*m, "Gone"));
+
+    ASSERT_TRUE(RestoreFromTheArchive(browser(), gone_entry));
+    tabs::TabInterface* const again = Find(browser(), "gone.test");
+    ASSERT_TRUE(again) << "the tab did not come back";
+    EXPECT_EQ(1, SpacesNamedW2B06(*m, "Gone"))
+        << "the deleted Space did not come back by its name";
+    const spaces::Space* const remade = m->GetSpace(m->SpaceForTab(again));
+    ASSERT_TRUE(remade);
+    EXPECT_EQ("Gone", remade->name()) << "not back in the Space made again";
+    EXPECT_EQ(0, SpacesNamedW2B06(*blank_model, "Gone"));
+  }
+}
+
+// P06-1f; archive A9, windows G4: a tab closed in the profile's Space "Work"
+// and restored from the archive in a Blank Window comes back in the Space
+// the Blank Window shows. Work was never deleted, so the Blank Window gains
+// no Space: it made a Space "Work" of its own and showed it.
+IN_PROC_BROWSER_TEST_F(ArchiveRestoreW2B06Test,
+                       RestoreInABlankWindowMakesNoCopyOfAProfileSpace) {
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  ASSERT_TRUE(m->registry());
+  const SpaceId home = m->active_id();
+  const SpaceId work = m->AddSpace("Work", SK_ColorBLUE)->id();
+  ASSERT_TRUE(m->SetActiveSpace(work));
+  tabs::TabInterface* const closing = Open(browser(), "work.test");
+  ASSERT_TRUE(closing);
+  ASSERT_TRUE(Open(browser(), "work-kept.test"));
+  ASSERT_EQ(work, m->SpaceForTab(closing));
+  CloseIntoTheList(browser(), closing);
+  const sessions::tab_restore::Tab* const record = ClosedTab("work.test");
+  ASSERT_TRUE(record) << "the close was not recorded";
+  ASSERT_EQ("Work", ExtraW2B06(*record, stedding::kArchiveSpaceRawNameKey));
+  const SessionID entry = record->id;
+  ASSERT_TRUE(m->SetActiveSpace(home));
+
+  BrowserWindowInterface* const blank = OpenBlankWindow();
+  ASSERT_TRUE(blank);
+  spaces::SpaceModel* const blank_model = spaces::SpaceModel::From(blank);
+  ASSERT_EQ(0, SpacesNamedW2B06(*blank_model, "Work"));
+  const SpaceId shown = blank_model->active_id();
+  const size_t blank_spaces = blank_model->size();
+  const size_t profile_spaces = m->registry()->entries().size();
+
+  ASSERT_TRUE(RestoreFromTheArchive(blank, entry));
+  tabs::TabInterface* const back = Find(blank, "work.test");
+  ASSERT_TRUE(back) << "the tab did not come back in the Blank Window";
+  EXPECT_EQ(0, SpacesNamedW2B06(*blank_model, "Work"))
+      << "the profile's Space was made again in the Blank Window";
+  EXPECT_EQ(blank_spaces, blank_model->size());
+  EXPECT_EQ(shown, blank_model->SpaceForTab(back))
+      << "not in the Space the Blank Window shows";
+  EXPECT_EQ(shown, blank_model->active_id());
+  EXPECT_EQ(profile_spaces, m->registry()->entries().size());
+  EXPECT_TRUE(m->GetSpace(work)) << "Work left the profile's window";
+}
+
+// tabs R25, R30: the undo toast after a close the user makes. It is off by
+// default; this turns "Offer Undo after closing tabs" on.
+class UndoToastW2B06Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    host_resolver()->AddRule("*", "127.0.0.1");
+    ASSERT_TRUE(embedded_test_server()->Start());
+    browser()->GetProfile()->GetPrefs()->SetBoolean(
+        stedding::prefs::kUndoToast, true);
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  int Index(const tabs::TabInterface* tab) {
+    return tabs()->GetIndexOfTab(tab);
+  }
+
+  // A new foreground tab on `path` of `host`, loaded.
+  tabs::TabInterface* Open(const std::string& host, const std::string& path) {
+    EXPECT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), embedded_test_server()->GetURL(host, path),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    return tabs()->GetActiveTab();
+  }
+
+  // How many tabs of the window show `host`.
+  int Count(const std::string& host) {
+    int count = 0;
+    for (int i = 0; i < tabs()->count(); ++i) {
+      count += ShownUrlW2B06(tabs()->GetWebContentsAt(i)).host() == host;
+    }
+    return count;
+  }
+
+  ToastController* toasts() { return ToastController::From(browser()); }
+
+  // The undo toast, reading `text`. Its timer is held for the steps that
+  // follow: on a slow build its 8 seconds can run out between them.
+  void WaitForUndoToast(const std::u16string& text) {
+    ASSERT_TRUE(toasts());
+    std::u16string shown;
+    const bool read = base::test::RunUntil([&]() {
+      toasts::ToastView* const view = toasts()->GetToastViewForTesting();
+      if (toasts()->GetCurrentToastId() != ToastId::kSteddingTabsClosed ||
+          !view || !view->label_for_testing()) {
+        return false;
+      }
+      shown = std::u16string(view->label_for_testing()->GetText());
+      return shown == text;
+    });
+    ASSERT_TRUE(read) << "the toast reads \"" << base::UTF16ToUTF8(shown)
+                      << "\", not \"" << base::UTF16ToUTF8(text) << "\"";
+    toasts()->GetToastCloseTimerForTesting()->Stop();
+  }
+
+  // The toast's Undo, as a click on it.
+  void PressUndo() {
+    ASSERT_TRUE(toasts());
+    toasts::ToastView* const view = toasts()->GetToastViewForTesting();
+    ASSERT_TRUE(view);
+    views::MdTextButton* const undo = view->action_button_for_testing();
+    ASSERT_TRUE(undo);
+    views::test::ButtonTestApi(undo).NotifyClick(ui::MouseEvent(
+        ui::EventType::kMousePressed, gfx::Point(), gfx::Point(),
+        base::TimeTicks::Now(), ui::EF_LEFT_MOUSE_BUTTON,
+        ui::EF_LEFT_MOUSE_BUTTON));
+  }
+};
+
+// P07-1b; tabs R25, archive A15: a split closed from its tab menu whose
+// page asks "Leave site?", answered Stay, closed one tab, and the toast then
+// says so: it names the pane that closed, and its Undo brings that pane back
+// alone. The toast kept "2 tabs closed", counted before the page answered.
+IN_PROC_BROWSER_TEST_F(UndoToastW2B06Test,
+                       ASplitPageThatStaysLeavesTheToastNamingOneTab) {
+  sessions::TabRestoreService* const service =
+      TabRestoreServiceFactory::GetForProfile(browser()->GetProfile());
+  ASSERT_TRUE(service);
+  tabs::TabInterface* const left = Open("left.test", "/title2.html");
+  tabs::TabInterface* const asking = Open("asking.test", "/title1.html");
+  tabs()->ActivateTabAt(Index(left));
+  tabs()->AddToNewSplit({Index(asking)}, split_tabs::SplitTabVisualData(),
+                        split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  ASSERT_TRUE(left->IsSplit() && left->GetSplit() == asking->GetSplit());
+  const tabs::TabHandle left_handle = left->GetHandle();
+  content::WebContents* const page = asking->GetContents();
+  // The page asks once: the close of the window at the test's end does not
+  // ask again.
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "window.addEventListener('beforeunload', e => {"
+      "  if (window.asked) { return; }"
+      "  window.asked = true;"
+      "  e.preventDefault();"
+      "  e.returnValue = '';"
+      "});"));
+  // The user activation "Leave site?" needs, and no hang timer.
+  content::PrepContentsForBeforeUnloadTest(page);
+
+  // The menu of a split that is not selected acts on both of its panes.
+  tabs()->ActivateTabAt(0);
+  ASSERT_FALSE(tabs()->IsTabSelected(Index(left)));
+  tabs()->ExecuteContextMenuCommand(Index(left),
+                                    TabStripModel::CommandCloseTab);
+  javascript_dialogs::AppModalDialogController* const dialog =
+      ui_test_utils::WaitForAppModalDialog();
+  ASSERT_TRUE(dialog);
+  ASSERT_TRUE(dialog->is_before_unload_dialog());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !left_handle.Get(); }))
+      << "the pane with no question did not close";
+  // While the page asks, the close is the whole split.
+  ASSERT_NO_FATAL_FAILURE(WaitForUndoToast(u"2 tabs closed"));
+
+  dialog->view()->CancelAppModalDialog();  // Stay.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !service->entries().empty() &&
+           service->entries().front()->type == sessions::tab_restore::TAB;
+  })) << "the split's record still holds the page that stayed";
+  ASSERT_NE(TabStripModel::kNoTab, Index(asking)) << "Stay closed the page";
+  ASSERT_NO_FATAL_FAILURE(WaitForUndoToast(u"“Title Of Awesomeness” closed"));
+
+  ASSERT_NO_FATAL_FAILURE(PressUndo());
+  ASSERT_TRUE(base::test::RunUntil([&]() { return Count("left.test") == 1; }))
+      << "Undo did not bring back the pane that closed";
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, Count("left.test"));
+  EXPECT_EQ(1, Count("asking.test")) << "Undo opened the page that stayed";
+}
+
+}  // namespace
