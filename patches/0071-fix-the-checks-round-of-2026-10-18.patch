+// archive A1 (PLAN.md TST-18): a system sleep counts as idle time, as Arc
+// archives a tab left overnight. Asleep, a Mac's monotonic clock stands still
+// while the wall clock goes on: here the wall clock alone moves on, and a
+// sweep on the system's clocks, as the window's own archiver runs, takes the
+// tab nobody looked at once the threshold has passed. The idle time was
+// monotonic time, so a night asleep counted for nothing.
+IN_PROC_BROWSER_TEST_F(ArchiveSweepTest, ASleepCountsAsIdleTime) {
+  tabs::TabInterface* const left = Open("left.test");
+  tabs::TabInterface* const next = Open("next.test");
+  ASSERT_EQ(next, tabs()->GetActiveTab());
+  // A second archiver of the window's strip, on the system's clocks.
+  stedding::TabArchiver archiver(*browser(),
+                                 *browser()->GetProfile()->GetPrefs());
+
+  SweepWithTheWallClockAhead(archiver, base::Hours(5));
+  ASSERT_TRUE(IsOpen(left)) << "archived before the threshold";
+  SweepWithTheWallClockAhead(archiver, base::Hours(7));
+  EXPECT_FALSE(IsOpen(left)) << "the night asleep did not count";
+  EXPECT_TRUE(IsOpen(next)) << "the tab on screen";
+}
+
+// archive A1, A2 (PLAN.md TST-18): the time since a tab was last looked at
+// goes on across restarts, the time the browser was closed included, as a
+// night asleep does. A tab left before a quit, and not looked at since, is
+// archived once the threshold has passed, two restarts later; a tab opened
+// after the restarts counts from then. The idle time started again at every
+// launch, so a browser restarted more often than the threshold archived
+// nothing.
+class ArchiveIdleRestartTest : public ArchiveSweepTest {
+ public:
+  // Each start opens what the session holds and nothing else: the harness's
+  // own blank tab, opened after a restore and selected, is a tab the user
+  // never had.
+  ArchiveIdleRestartTest() { set_open_about_blank_on_browser_launch(false); }
+
+ protected:
+  void SetUpOnMainThread() override {
+    ArchiveSweepTest::SetUpOnMainThread();
+    SessionStartupPref::SetStartupPref(
+        browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  }
+
+  // When the first run's user left the tab, kept in the profile's folder for
+  // the runs after it.
+  base::FilePath LeftAtFile() {
+    return browser()->GetProfile()->GetPath().AppendASCII(
+        "stedding_left_at.txt");
+  }
+
+  // The tab showing `host`, loaded or restored and not yet loaded.
+  tabs::TabInterface* Find(const std::string& host) {
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      const content::NavigationEntry* const entry =
+          tab->GetContents()->GetController().GetLastCommittedEntry();
+      const GURL url =
+          entry ? entry->GetURL() : tab->GetContents()->GetVisibleURL();
+      if (url.host() == host) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(ArchiveIdleRestartTest,
+                       PRE_PRE_TheIdleTimeSurvivesARestart) {
+  // The window's first tab: a restore makes it active on the way, before the
+  // tab the user was on.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("left.test", "/title1.html")));
+  // The user leaves it for another tab, then quits.
+  Open("next.test");
+  ASSERT_EQ(2, tabs()->count());
+  base::ScopedAllowBlockingForTesting allow_blocking;
+  ASSERT_TRUE(base::WriteFile(
+      LeftAtFile(),
+      base::NumberToString(
+          base::Time::Now().ToDeltaSinceWindowsEpoch().InMicroseconds())));
+}
+
+// A run in between in which nobody looks at the tab. The session is rebuilt
+// at every start, and a key not written again then lasts one restart only.
+IN_PROC_BROWSER_TEST_F(ArchiveIdleRestartTest,
+                       PRE_TheIdleTimeSurvivesARestart) {
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return Find("left.test") && Find("next.test");
+  })) << "the session did not come back";
+  EXPECT_EQ(Find("next.test"), tabs()->GetActiveTab())
+      << "the restore selected "
+      << tabs()->GetActiveTab()->GetContents()->GetVisibleURL() << " of "
+      << tabs()->count();
+}
+
+IN_PROC_BROWSER_TEST_F(ArchiveIdleRestartTest, TheIdleTimeSurvivesARestart) {
+  tabs::TabInterface* left = nullptr;
+  tabs::TabInterface* next = nullptr;
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    left = Find("left.test");
+    next = Find("next.test");
+    return left && next;
+  })) << "the session did not come back";
+  ASSERT_EQ(next, tabs()->GetActiveTab())
+      << "the restore selected "
+      << tabs()->GetActiveTab()->GetContents()->GetVisibleURL() << " of "
+      << tabs()->count();
+  base::Time left_at;
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    std::string saved;
+    ASSERT_TRUE(base::ReadFileToString(LeftAtFile(), &saved));
+    int64_t microseconds = 0;
+    ASSERT_TRUE(base::StringToInt64(saved, &microseconds));
+    left_at = base::Time::FromDeltaSinceWindowsEpoch(
+        base::Microseconds(microseconds));
+  }
+  // A tab of this run, opened and left.
+  tabs::TabInterface* const fresh = Open("fresh.test");
+  tabs()->ActivateTabAt(tabs()->GetIndexOfTab(next));
+  const base::TimeDelta closed = base::Time::Now() - left_at;
+  ASSERT_GT(closed, base::Seconds(1)) << "two restarts took no time";
+
+  // A second archiver of the window's strip, on the system's clocks.
+  stedding::TabArchiver archiver(*browser(),
+                                 *browser()->GetProfile()->GetPrefs());
+  // Six hours less half the time since the tab was left: counted from this
+  // run's start, it has idled less than the threshold; counted from when the
+  // user left it, more.
+  SweepWithTheWallClockAhead(archiver, base::Hours(6) - closed / 2);
+  EXPECT_FALSE(IsOpen(left)) << "the time before the restarts did not count";
+  EXPECT_TRUE(IsOpen(next)) << "the tab on screen";
+  EXPECT_TRUE(IsOpen(fresh)) << "a tab of this run counted from before it";
+}
+
 }  // namespace
