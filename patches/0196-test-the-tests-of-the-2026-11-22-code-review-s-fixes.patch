+// P36-1b, peek P20, P25: Back and the zoom keys pressed in a peek over the
+// page act on the peek's page, as reload does, and the pinned page under it
+// stays as it was. They went to the window's active tab, the pinned tab:
+// Back took the pin back, which could close the peek and lose its page, and
+// Zoom In zoomed the pinned site while nothing changed in the peek.
+IN_PROC_BROWSER_TEST_F(PeekOverPageB27Test,
+                       BackAndZoomKeysInAPeekActOnThePeeksPage) {
+  ASSERT_NO_FATAL_FAILURE(
+      OpenPin(Url("b.test", "/title3.html"), /*history=*/true));
+  tabs::TabInterface* const pin = tab();
+  content::WebContents* const pinned_page = pin->GetContents();
+  ASSERT_EQ(2, pinned_page->GetController().GetEntryCount());
+  const int pin_entry = pinned_page->GetController().GetLastCommittedEntryIndex();
+  const GURL pinned_url = pinned_page->GetLastCommittedURL();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  content::WebContents* const page = peek->page();
+  // A link inside the peek stays in it.
+  ASSERT_TRUE(content::NavigateToURLFromRenderer(
+      page, Url("b.test", "/title2.html")));
+  ASSERT_EQ(2, page->GetController().GetEntryCount());
+  ASSERT_EQ(1, page->GetController().GetLastCommittedEntryIndex());
+  const base::WeakPtr<content::WebContents> alive = page->GetWeakPtr();
+
+  {
+    SCOPED_TRACE("Back");
+    EXPECT_TRUE(page->GetDelegate()->HandleKeyboardEvent(page, BackKeyB27()))
+        << "no one took the key";
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return !alive ||
+             (alive->GetController().GetLastCommittedEntryIndex() == 0 &&
+              !alive->IsLoading());
+    })) << "the peek's page did not go back";
+    ASSERT_TRUE(alive) << "the peek closed, and its page went with it";
+    EXPECT_EQ(0, page->GetController().GetLastCommittedEntryIndex());
+    EXPECT_EQ(pin_entry,
+              pinned_page->GetController().GetLastCommittedEntryIndex())
+        << "the pin under the peek went back";
+    EXPECT_EQ(pinned_url, pinned_page->GetLastCommittedURL());
+    ASSERT_EQ(peek, stedding::PeekOverlay::ForSource(pin))
+        << "Back closed the peek";
+  }
+  {
+    SCOPED_TRACE("Zoom In");
+    const double pinned_zoom = content::HostZoomMap::GetZoomLevel(pinned_page);
+    const double before = content::HostZoomMap::GetZoomLevel(page);
+    EXPECT_TRUE(
+        page->GetDelegate()->HandleKeyboardEvent(page, ZoomInKeyB27()))
+        << "no one took the key";
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return alive && content::HostZoomMap::GetZoomLevel(alive.get()) > before;
+    })) << "the peek's page did not zoom in";
+    EXPECT_EQ(pinned_zoom, content::HostZoomMap::GetZoomLevel(pinned_page))
+        << "the pin under the peek zoomed";
+    EXPECT_EQ(peek, stedding::PeekOverlay::ForSource(pin))
+        << "the zoom closed the peek";
+  }
+}
