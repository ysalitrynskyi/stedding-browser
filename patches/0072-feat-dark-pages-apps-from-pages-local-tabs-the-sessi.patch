@@ -0,0 +1,52 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_APP_RECORDS_KEEPER_H_
+#define CHROME_BROWSER_UI_STEDDING_APP_RECORDS_KEEPER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/supports_user_data.h"
+#include "chrome/browser/web_applications/web_app_install_manager.h"
+#include "chrome/browser/web_applications/web_app_install_manager_observer.h"
+
+class Profile;
+
+namespace stedding {
+
+// What Stedding keeps about an app made from a page goes with the app
+// (docs/features/web-apps.md Wa18): the jar it recorded (Wa11) and, on the
+// Mac, the Dock tile Stedding added (Wa7). One per profile, kept on the
+// profile while its web apps run.
+class AppRecordsKeeper : public base::SupportsUserData::Data,
+                         public web_app::WebAppInstallManagerObserver {
+ public:
+  AppRecordsKeeper(const AppRecordsKeeper&) = delete;
+  AppRecordsKeeper& operator=(const AppRecordsKeeper&) = delete;
+  ~AppRecordsKeeper() override;
+
+  // Starts keeping `profile`'s records, once; `install_manager` is its web
+  // apps' own, which the keeper listens to from then on, a new one included.
+  static void EnsureForProfile(Profile* profile,
+                               web_app::WebAppInstallManager& install_manager);
+
+  // web_app::WebAppInstallManagerObserver:
+  void OnWebAppUninstalled(
+      const webapps::AppId& app_id,
+      webapps::WebappUninstallSource uninstall_source) override;
+  void OnWebAppInstallManagerDestroyed() override;
+
+ private:
+  AppRecordsKeeper(Profile* profile,
+                   web_app::WebAppInstallManager& install_manager);
+
+  const raw_ptr<Profile> profile_;
+  base::ScopedObservation<web_app::WebAppInstallManager,
+                          web_app::WebAppInstallManagerObserver>
+      observation_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_APP_RECORDS_KEEPER_H_
diff --git a/chrome/browser/ui/stedding/dark_pages.cc b/chrome/browser/ui/stedding/dark_pages.cc
new file mode 100644
index 0000000000000..cd1c1f986757a
--- /dev/null
+++ b/chrome/browser/ui/stedding/dark_pages.cc
@@ -0,0 +1,481 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/dark_pages.h"
+
+#include <algorithm>
+#include <cmath>
+#include <string>
+#include <tuple>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/content_settings/host_content_settings_map_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "chrome/common/url_constants.h"
+#include "components/content_settings/core/common/content_settings.h"
+#include "components/content_settings/core/common/content_settings_types.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/url_constants.h"
+#include "extensions/common/constants.h"
+#include "net/base/registry_controlled_domains/registry_controlled_domain.h"
+#include "third_party/blink/public/common/web_preferences/web_preferences.h"
+#include "ui/gfx/color_conversions.h"
+#include "url/gurl.h"
+#include "url/url_constants.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr ContentSettingsType kType =
+    ContentSettingsType::AUTO_DARK_WEB_CONTENT;
+
+// The subdomain wildcard of a list entry (Dk13), as ContentSettingsPattern
+// writes it.
+constexpr std::string_view kSubdomains = "[*.]";
+
+HostContentSettingsMap* MapFor(Profile* profile) {
+  return profile ? HostContentSettingsMapFactory::GetForProfile(profile)
+                 : nullptr;
+}
+
+// Dk13: `host` and its subdomains, or an IP address alone; nothing when the
+// result is not a pattern the content setting takes.
+std::optional<ContentSettingsPattern> PatternForHost(std::string_view host,
+                                                     bool is_ip_address) {
+  if (host.empty()) {
+    return std::nullopt;
+  }
+  const ContentSettingsPattern pattern = ContentSettingsPattern::FromString(
+      is_ip_address ? std::string(host) : base::StrCat({kSubdomains, host}));
+  if (!pattern.IsValid()) {
+    return std::nullopt;
+  }
+  return pattern;
+}
+
+}  // namespace
+
+bool IsNeverDarkenedUrl(const GURL& url) {
+  return url.SchemeIs(content::kChromeUIScheme) ||
+         url.SchemeIs(content::kChromeUIUntrustedScheme) ||
+         url.SchemeIs(chrome::kChromeSearchScheme) ||
+         url.SchemeIs(content::kChromeDevToolsScheme) ||
+         url.SchemeIs(extensions::kExtensionScheme);
+}
+
+GURL DarkPagesUrlFor(content::WebContents* contents) {
+  if (!contents) {
+    return GURL();
+  }
+  GURL url = contents->GetLastCommittedURL();
+  content::NavigationEntry* const committed =
+      contents->GetController().GetLastCommittedEntry();
+  const DarkPagesTabHelper* const helper =
+      DarkPagesTabHelper::FromWebContents(contents);
+  if (helper && helper->committing_url()) {
+    // Dk7: a page ready to commit is the one whose renderer is about to be
+    // given its preferences; the page it replaces is going.
+    url = *helper->committing_url();
+  } else if (url.is_empty() || !committed || committed->IsInitialEntry()) {
+    // A new tab whose first page has not committed yet: the address it is
+    // loading decides, so the page that comes is darkened from its first
+    // frame (Dk7) and not one frame later.
+    const GURL& visible = contents->GetVisibleURL();
+    if (!visible.is_empty()) {
+      url = visible;
+    }
+  }
+  // Dk11: a source view is the page's own site.
+  if (url.SchemeIs(content::kViewSourceScheme)) {
+    url = GURL(url.GetContent());
+  }
+  return url;
+}
+
+bool DarkPagesOn(Profile* profile) {
+  return profile && profile->GetOriginalProfile()->GetPrefs()->GetBoolean(
+                        prefs::kWebKitForceDarkModeEnabled);
+}
+
+void SetDarkPagesOn(Profile* profile, bool on) {
+  if (!profile) {
+    return;
+  }
+  // A private window's PrefService is an overlay: a write there would stay in
+  // its memory, and the normal windows would not follow (Dk1).
+  profile->GetOriginalProfile()->GetPrefs()->SetBoolean(
+      prefs::kWebKitForceDarkModeEnabled, on);
+}
+
+bool DarkPagesApplyToUrl(Profile* profile, const GURL& url) {
+  if (!DarkPagesOn(profile) || IsNeverDarkenedUrl(url)) {
+    return false;
+  }
+  HostContentSettingsMap* const map = MapFor(profile);
+  return !map ||
+         map->GetContentSetting(url, url, kType) == CONTENT_SETTING_ALLOW;
+}
+
+bool DarkPagesApplyTo(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  return DarkPagesApplyToUrl(
+      Profile::FromBrowserContext(contents->GetBrowserContext()),
+      DarkPagesUrlFor(contents));
+}
+
+DarkPagesMode GetDarkPagesMode(Profile* profile) {
+  HostContentSettingsMap* const map =
+      MapFor(profile ? profile->GetOriginalProfile() : nullptr);
+  return map && map->GetDefaultContentSetting(kType) == CONTENT_SETTING_BLOCK
+             ? DarkPagesMode::kOnlyThese
+             : DarkPagesMode::kAllExcept;
+}
+
+void SetDarkPagesMode(Profile* profile, DarkPagesMode mode) {
+  // The default is the profile's own: an off-the-record map may not set it.
+  HostContentSettingsMap* const map =
+      MapFor(profile ? profile->GetOriginalProfile() : nullptr);
+  if (!map) {
+    return;
+  }
+  map->SetDefaultContentSetting(kType, mode == DarkPagesMode::kOnlyThese
+                                           ? CONTENT_SETTING_BLOCK
+                                           : CONTENT_SETTING_ALLOW);
+}
+
+std::optional<ContentSettingsPattern> DarkPagesSitePatternFor(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty()) {
+    return std::nullopt;
+  }
+  if (url.HostIsIPAddress()) {
+    return PatternForHost(url.host(), /*is_ip_address=*/true);
+  }
+  // The registrable domain, private registries counted, as Clear Site
+  // Cookies scopes a site (commandbar K24); a host with no known registry
+  // (localhost, b.test) as it is.
+  std::string domain = net::registry_controlled_domains::GetDomainAndRegistry(
+      url, net::registry_controlled_domains::INCLUDE_PRIVATE_REGISTRIES);
+  if (domain.empty()) {
+    domain = std::string(url.host());
+  }
+  return PatternForHost(domain, /*is_ip_address=*/false);
+}
+
+std::optional<ContentSettingsPattern> DarkPagesSitePatternFromTyped(
+    std::string_view typed) {
+  std::string text =
+      base::ToLowerASCII(base::TrimWhitespaceASCII(typed, base::TRIM_ALL));
+  // "*.example.com" and the pattern's own "[*.]example.com" both name the
+  // host with its subdomains, which every entry does.
+  for (std::string_view prefix : {kSubdomains, std::string_view("*.")}) {
+    if (text.starts_with(prefix)) {
+      text.erase(0, prefix.size());
+      break;
+    }
+  }
+  if (text.empty() || text.starts_with("/")) {
+    return std::nullopt;
+  }
+  // A typed host has no scheme; a URL keeps its own, which must be a web
+  // page's (a browser page or a file is no site).
+  const GURL url(text.find("://") == std::string::npos
+                     ? base::StrCat({url::kHttpScheme, "://", text})
+                     : text);
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty()) {
+    return std::nullopt;
+  }
+  return PatternForHost(url.host(), url.HostIsIPAddress());
+}
+
+std::string DarkPagesSiteName(const ContentSettingsPattern& pattern) {
+  std::string name = pattern.ToString();
+  if (name.starts_with(kSubdomains)) {
+    name.erase(0, kSubdomains.size());
+  }
+  return name;
+}
+
+bool CanChooseDarkPagesForSite(content::WebContents* contents) {
+  if (!contents || !DarkPagesOn(Profile::FromBrowserContext(
+                       contents->GetBrowserContext()))) {
+    return false;
+  }
+  return DarkPagesSitePatternFor(DarkPagesUrlFor(contents)).has_value();
+}
+
+bool IsSiteDarkened(content::WebContents* contents) {
+  if (!contents) {
+    return false;
+  }
+  const GURL url = DarkPagesUrlFor(contents);
+  HostContentSettingsMap* const map =
+      MapFor(Profile::FromBrowserContext(contents->GetBrowserContext()));
+  return !IsNeverDarkenedUrl(url) &&
+         (!map ||
+          map->GetContentSetting(url, url, kType) == CONTENT_SETTING_ALLOW);
+}
+
+void SetSiteDarkened(content::WebContents* contents, bool darkened) {
+  if (!contents) {
+    return;
+  }
+  Profile* const profile =
+      Profile::FromBrowserContext(contents->GetBrowserContext());
+  const GURL url = DarkPagesUrlFor(contents);
+  const std::optional<ContentSettingsPattern> site =
+      DarkPagesSitePatternFor(url);
+  HostContentSettingsMap* const map = MapFor(profile);
+  if (!site || !map) {
+    return;
+  }
+  const ContentSetting wanted =
+      darkened ? CONTENT_SETTING_ALLOW : CONTENT_SETTING_BLOCK;
+  if (profile->IsOffTheRecord()) {
+    // Dk21: the private session's own entry. Its map reads its own entries
+    // before the ones it inherits, keeps them in memory, and drops them with
+    // the private profile.
+    map->SetContentSettingCustomScope(*site, ContentSettingsPattern::Wildcard(),
+                                      kType, wanted);
+    return;
+  }
+  // Dk12: a site is on at most one list. An entry that names this page (one
+  // typed for a subdomain, say) would outrank the site's own, so it goes;
+  // then the site gets an entry only when the mode alone does not give it
+  // what was asked. A broader entry that also matches (github.io for
+  // spec.github.io) is outranked by the site's own and covers other sites:
+  // it stays (Dk15). It was deleted with the rest.
+  for (const ContentSettingPatternSource& entry :
+       map->GetSettingsForOneType(kType)) {
+    const ContentSettingsPattern::Relation relation =
+        site->Compare(entry.primary_pattern);
+    if (entry.source == content_settings::mojom::ProviderType::kPrefProvider &&
+        !entry.incognito && entry.primary_pattern.Matches(url) &&
+        (relation == ContentSettingsPattern::IDENTITY ||
+         relation == ContentSettingsPattern::SUCCESSOR)) {
+      map->SetContentSettingCustomScope(entry.primary_pattern,
+                                        entry.secondary_pattern, kType,
+                                        CONTENT_SETTING_DEFAULT);
+    }
+  }
+  if (map->GetContentSetting(url, url, kType) != wanted) {
+    map->SetContentSettingCustomScope(*site, ContentSettingsPattern::Wildcard(),
+                                      kType, wanted);
+  }
+}
+
+std::vector<ContentSettingsPattern> GetDarkPagesSites(Profile* profile,
+                                                      DarkPagesMode mode) {
+  std::vector<ContentSettingsPattern> sites;
+  HostContentSettingsMap* const map =
+      MapFor(profile ? profile->GetOriginalProfile() : nullptr);
+  if (!map) {
+    return sites;
+  }
+  const ContentSetting listed = mode == DarkPagesMode::kAllExcept
+                                    ? CONTENT_SETTING_BLOCK
+                                    : CONTENT_SETTING_ALLOW;
+  for (const ContentSettingPatternSource& entry :
+       map->GetSettingsForOneType(kType)) {
+    if (entry.source == content_settings::mojom::ProviderType::kPrefProvider &&
+        !entry.incognito && entry.GetContentSetting() == listed) {
+      sites.push_back(entry.primary_pattern);
+    }
+  }
+  std::ranges::sort(sites, [](const ContentSettingsPattern& a,
+                              const ContentSettingsPattern& b) {
+    return DarkPagesSiteName(a) < DarkPagesSiteName(b);
+  });
+  return sites;
+}
+
+void AddDarkPagesSite(Profile* profile,
+                      DarkPagesMode mode,
+                      const ContentSettingsPattern& pattern) {
+  HostContentSettingsMap* const map =
+      MapFor(profile ? profile->GetOriginalProfile() : nullptr);
+  if (!map || !pattern.IsValid()) {
+    return;
+  }
+  // One entry per pattern: writing the other value moves the site from the
+  // other list to this one.
+  map->SetContentSettingCustomScope(
+      pattern, ContentSettingsPattern::Wildcard(), kType,
+      mode == DarkPagesMode::kAllExcept ? CONTENT_SETTING_BLOCK
+                                        : CONTENT_SETTING_ALLOW);
+}
+
+void RemoveDarkPagesSite(Profile* profile,
+                         const ContentSettingsPattern& pattern) {
+  HostContentSettingsMap* const map =
+      MapFor(profile ? profile->GetOriginalProfile() : nullptr);
+  if (!map || !pattern.IsValid()) {
+    return;
+  }
+  map->SetContentSettingCustomScope(pattern, ContentSettingsPattern::Wildcard(),
+                                    kType, CONTENT_SETTING_DEFAULT);
+}
+
+bool BlinkDarkensBackground(SkColor color) {
+  // Blink's DarkModeColorClassifier::CalculateColorBrightness.
+  const int brightness = (static_cast<int>(SkColorGetR(color)) * 299 +
+                          static_cast<int>(SkColorGetG(color)) * 587 +
+                          static_cast<int>(SkColorGetB(color)) * 114) /
+                         1000;
+  return brightness > kBlinkBackgroundBrightnessThreshold;
+}
+
+SkColor DarkenLikeBlink(SkColor color) {
+  // Blink's LABColorFilter::InvertColor (dark_mode_color_filter.cc).
+  const auto [x, y, z] = gfx::SRGBToXYZD50(SkColorGetR(color) / 255.0f,
+                                           SkColorGetG(color) / 255.0f,
+                                           SkColorGetB(color) / 255.0f);
+  auto [l, a, b] = gfx::XYZD50ToLab(x, y, z);
+  l = std::min(110.0f - l, 100.0f);
+  const auto [x2, y2, z2] = gfx::LabToXYZD50(l, a, b);
+  auto [r2, g2, b2] = gfx::XYZD50ToSRGB(x2, y2, z2);
+  const auto channel = [](float value) -> U8CPU {
+    return static_cast<U8CPU>(
+        std::lround(std::clamp(value, 0.0f, 1.0f) * 255.0f));
+  };
+  U8CPU red = channel(r2);
+  U8CPU green = channel(g2);
+  U8CPU blue = channel(b2);
+  // Blink's AdjustGray: a grey between 18 and 32 goes to 18, the dark
+  // surface colour Material recommends, so white gives #121212.
+  if (red == green && red == blue && red < 32 && red > 18) {
+    red = green = blue = 18;
+  }
+  return SkColorSetARGB(SkColorGetA(color), red, green, blue);
+}
+
+SkColor ThemeColorUnderDarkPages(SkColor theme_color, bool page_darkened) {
+  // A light-blue theme colour over a page darkened to #121212 gave a
+  // light-blue bar (research L4); inverted like the page it is a dark blue.
+  // Only a colour Blink would invert as a background is: a brand blue such
+  // as #4285f4 keeps its colour in the darkened page's header, and so in the
+  // bar over it.
+  return page_darkened && BlinkDarkensBackground(theme_color)
+             ? DarkenLikeBlink(theme_color)
+             : theme_color;
+}
+
+DarkPagesWatcher::DarkPagesWatcher(Profile* profile,
+                                   base::RepeatingClosure on_change)
+    : on_change_(std::move(on_change)) {
+  if (!profile) {
+    return;
+  }
+  registrar_.Init(profile->GetOriginalProfile()->GetPrefs());
+  registrar_.Add(prefs::kWebKitForceDarkModeEnabled, on_change_);
+  if (HostContentSettingsMap* const map = MapFor(profile)) {
+    settings_.Observe(map);
+  }
+}
+
+DarkPagesWatcher::~DarkPagesWatcher() = default;
+
+void DarkPagesWatcher::OnContentSettingChanged(
+    const ContentSettingsPattern& primary_pattern,
+    const ContentSettingsPattern& secondary_pattern,
+    ContentSettingsTypeSet content_type_set) {
+  if (content_type_set.Contains(kType)) {
+    on_change_.Run();
+  }
+}
+
+DarkPagesTabHelper::DarkPagesTabHelper(content::WebContents* contents)
+    : content::WebContentsUserData<DarkPagesTabHelper>(*contents),
+      content::WebContentsObserver(contents) {
+  if (HostContentSettingsMap* const map =
+          MapFor(Profile::FromBrowserContext(contents->GetBrowserContext()))) {
+    settings_.Observe(map);
+  }
+}
+
+DarkPagesTabHelper::~DarkPagesTabHelper() = default;
+
+void DarkPagesTabHelper::ReadyToCommitNavigation(
+    content::NavigationHandle* navigation) {
+  if (!navigation->IsInPrimaryMainFrame() || navigation->IsSameDocument()) {
+    return;
+  }
+  // Dk7: from here the page being committed decides (DarkPagesUrlFor). When
+  // its decision is not the one the tab's preferences hold, they are sent
+  // again now, to every renderer of the tab and so to the coming page's,
+  // ahead of the commit: its first frame is drawn the way its site is. The
+  // page going may restyle a moment before it is replaced, the same way the
+  // coming page then shows.
+  committing_url_ = navigation->GetURL();
+  committing_navigation_id_ = navigation->GetNavigationId();
+  content::WebContents& contents = GetWebContents();
+  if (contents.GetOrCreateWebPreferences().force_dark_mode_enabled !=
+      DarkPagesApplyTo(&contents)) {
+    contents.OnWebPreferencesChanged();
+  }
+}
+
+void DarkPagesTabHelper::DidFinishNavigation(
+    content::NavigationHandle* navigation) {
+  if (!committing_url_ ||
+      navigation->GetNavigationId() != committing_navigation_id_) {
+    return;
+  }
+  committing_url_.reset();
+  committing_navigation_id_ = 0;
+  // A committed page is the last committed one now, and Chromium recomputes
+  // the preferences for it (OverrideWebPreferencesAfterNavigation). One that
+  // did not commit leaves the page that stayed, whose decision comes back.
+  if (!navigation->HasCommitted()) {
+    UpdateWebPreferences();
+  }
+}
+
+void DarkPagesTabHelper::OnContentSettingChanged(
+    const ContentSettingsPattern& primary_pattern,
+    const ContentSettingsPattern& secondary_pattern,
+    ContentSettingsTypeSet content_type_set) {
+  if (!content_type_set.Contains(kType) || update_pending_) {
+    return;
+  }
+  // A mode change comes with the wildcard; an entry reaches only the tabs on
+  // the site it names (Dk14).
+  if (!primary_pattern.MatchesAllHosts() &&
+      !primary_pattern.Matches(DarkPagesUrlFor(&GetWebContents()))) {
+    return;
+  }
+  // After the writer's other changes, as PrefsTabHelper does for a
+  // preference: Settings may write an entry and remove another at once.
+  update_pending_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&DarkPagesTabHelper::UpdateWebPreferences,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void DarkPagesTabHelper::UpdateWebPreferences() {
+  update_pending_ = false;
+  content::WebContents& contents = GetWebContents();
+  // Only a page whose decision changed restyles (Dk14: other tabs are left
+  // alone).
+  if (contents.GetOrCreateWebPreferences().force_dark_mode_enabled !=
+      DarkPagesApplyTo(&contents)) {
+    contents.OnWebPreferencesChanged();
+  }
+}
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(DarkPagesTabHelper);
+
+}  // namespace stedding
