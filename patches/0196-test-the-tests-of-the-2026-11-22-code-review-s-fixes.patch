index 0000000000000..fc849dda2598c
--- /dev/null
+++ b/chrome/test/stedding/audit_b02_browsertest.cc
@@ -0,0 +1,354 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Delete here's question in Settings (docs/features/sidebar-file.md Sf23),
+// as a person answers it: a folder in a temporary directory stands for the
+// shared one, and another computer's file is written into it by the test.
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/strings/strcat.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/time/time.h"
+#include "base/token.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_service.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_service_factory.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_state.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+namespace sb = spaces::sidebar_sync;
+
+// The other computer's install id.
+constexpr char kOtherComputer[] = "0123456789abcdef";
+
+int64_t NowMs() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+spaces::SpaceId SpaceOf(const std::string& id) {
+  return *spaces::SpaceId::FromOptionalToken(base::Token::FromString(id));
+}
+
+// A script for the Settings page. `body` runs with `section`, the sync box,
+// and its `root`; `wait`, which calls its function until it gives something
+// true and gives that, or null after five seconds; `cr`; and, for Delete
+// here's question, `deleteHere()`, the waiting row's Delete here… button,
+// `rowText()`, that row's text, `dialog()` and `title()`, the question.
+std::string OnSyncSection(std::string_view body) {
+  return base::StrCat({R"js(
+    (async () => {
+      const deep = (root, selector) => {
+        const found = root.querySelector(selector);
+        if (found) {
+          return found;
+        }
+        for (const element of root.querySelectorAll('*')) {
+          const inner =
+              element.shadowRoot && deep(element.shadowRoot, selector);
+          if (inner) {
+            return inner;
+          }
+        }
+        return null;
+      };
+      const wait = async what => {
+        for (let i = 0; i < 200; ++i) {
+          const value = what();
+          if (value) {
+            return value;
+          }
+          await new Promise(done => setTimeout(done, 25));
+        }
+        return null;
+      };
+      const cr = await import('chrome://resources/js/cr.js');
+      const section = await wait(
+          () => deep(document, 'settings-stedding-sync-section'));
+      if (!section) {
+        return 'no sync box';
+      }
+      const root = section.shadowRoot;
+      const deleteHere =
+          () => root.querySelector('cr-button[data-choice="deleteHere"]');
+      const rowText =
+          () => deleteHere() ? deleteHere().parentElement.textContent : '';
+      const dialog = () => root.querySelector('#deleteDialog');
+      const title =
+          () => dialog().querySelector('[slot="title"]').textContent.trim();
+  )js",
+                       body, R"js(
+    })()
+  )js"});
+}
+
+// The user clicks the row's Delete here…; the question opens.
+constexpr char kAskDeleteHere[] = R"js(
+      const button = await wait(deleteHere);
+      if (!button) {
+        return 'no Delete here button';
+      }
+      button.click();
+      await wait(() => dialog() && dialog().open);
+      await section.updateComplete;
+      // What the page knew when the question was asked.
+      window.askedStatusB02 = section.status_;
+      return [dialog().open ? 'open' : 'closed', title()].join(' | ');
+)js";
+
+class SidebarSyncDeleteQuestionB02Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+  spaces::SpaceRegistry& registry() {
+    return *spaces::SpaceRegistryFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  base::FilePath sync_dir() {
+    return shared_.GetPath().AppendASCII(sb::kSyncFolderName);
+  }
+
+  void AddSpace(const std::string& id,
+                const std::string& name,
+                const sb::Stamp& stamp) {
+    sb::Record space(sb::Kind::kSpace);
+    space.f[sb::kFieldName] = sb::Field{name, stamp};
+    space.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+    space.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+    peer_.records[id] = space;
+  }
+
+  // The other computer's file, its write number `seq`.
+  void WritePeer(int64_t seq) {
+    base::ScopedAllowBlockingForTesting allow;
+    sb::FileMeta meta;
+    meta.format = sb::kFormat;
+    meta.install = kOtherComputer;
+    meta.device = "Office PC";
+    meta.seq = seq;
+    meta.nonce = sb::MakeInstallId();
+    meta.written_ms = NowMs();
+    meta.hlc = peer_.MaxTime();
+    meta.joined_ms = 1;
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(base::WriteFile(
+        sync_dir().AppendASCII(sb::FileNameFor(kOtherComputer)),
+        sb::SerializeSyncFile(peer_, meta)));
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  // The Spaces the waiting row for the other computer's batch names, sorted;
+  // nullopt when no row waits for it.
+  std::optional<std::vector<std::string>> AskedSpaces() {
+    const base::DictValue status = service()->GetStatus();
+    const base::ListValue* const decisions = status.FindList("decisions");
+    if (!decisions) {
+      return std::nullopt;
+    }
+    for (const base::Value& row : *decisions) {
+      const std::string* const id = row.GetDict().FindString("id");
+      if (!id || *id != base::StrCat({"batch:", kOtherComputer})) {
+        continue;
+      }
+      std::vector<std::string> names;
+      if (const base::ListValue* const list =
+              row.GetDict().FindList("spaceNames")) {
+        for (const base::Value& name : *list) {
+          names.push_back(name.GetString());
+        }
+      }
+      std::ranges::sort(names);
+      return names;
+    }
+    return std::nullopt;
+  }
+
+  // The other computer has Home, Travel and Recipes, and this one joins its
+  // folder; then that computer deletes Travel, and the deletion waits here.
+  void JoinThenTravelIsDeletedThere() {
+    start_ = NowMs();
+    const sb::Stamp stamp{start_, kOtherComputer};
+    AddSpace(home_, "Home", stamp);
+    AddSpace(travel_, "Travel", stamp);
+    AddSpace(recipes_, "Recipes", stamp);
+    peer_.lists[sb::kSpacesList].order = {home_, travel_, recipes_};
+    peer_.lists[sb::kSpacesList].s = stamp;
+    ASSERT_NO_FATAL_FAILURE(WritePeer(1));
+
+    base::test::TestFuture<base::DictValue> preview;
+    service()->PreviewJoin(shared_.GetPath(), preview.GetCallback());
+    ASSERT_FALSE(preview.Get().FindString("refusal"));
+    ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/false, "Test computer", {}));
+    ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+    ASSERT_TRUE(registry().Find(SpaceOf(travel_)));
+    ASSERT_TRUE(registry().Find(SpaceOf(recipes_)));
+    // Settings opens in a Space the batch leaves alone.
+    ASSERT_TRUE(model().SetActiveSpace(SpaceOf(home_)));
+
+    peer_.records[travel_].del = sb::Stamp{start_ + 60'000, kOtherComputer};
+    ASSERT_NO_FATAL_FAILURE(WritePeer(2));
+    ASSERT_NO_FATAL_FAILURE(Scan());
+    const std::optional<std::vector<std::string>> asked = AskedSpaces();
+    ASSERT_TRUE(asked) << "the deletion did not wait";
+    ASSERT_EQ(std::vector<std::string>{"Travel"}, *asked);
+  }
+
+  // While the question is open, the other computer deletes Recipes too; its
+  // newer file replaces the batch that waits.
+  void RecipesIsDeletedThereToo() {
+    peer_.records[recipes_].del = sb::Stamp{start_ + 120'000, kOtherComputer};
+    ASSERT_NO_FATAL_FAILURE(WritePeer(3));
+    ASSERT_NO_FATAL_FAILURE(Scan());
+    const std::optional<std::vector<std::string>> asked = AskedSpaces();
+    ASSERT_TRUE(asked);
+    ASSERT_EQ((std::vector<std::string>{"Recipes", "Travel"}), *asked);
+  }
+
+  content::WebContents* OpenSettings() {
+    if (!ui_test_utils::NavigateToURLWithDisposition(
+            browser(), GURL("chrome://settings/stedding"),
+            WindowOpenDisposition::kNewForegroundTab,
+            ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP)) {
+      return nullptr;
+    }
+    return browser()->GetTabStripModel()->GetActiveWebContents();
+  }
+
+  base::ScopedTempDir shared_;
+  sb::State peer_;
+  int64_t start_ = 0;
+  const std::string home_ = base::Token::CreateRandom().ToString();
+  const std::string travel_ = base::Token::CreateRandom().ToString();
+  const std::string recipes_ = base::Token::CreateRandom().ToString();
+};
+
+// P03-1a, Sf23: Delete here applies only what its question named. When the
+// other computer deletes another Space while the question is open, confirming
+// asks again, naming both, and nothing is deleted until that is answered. The
+// confirm applied whatever batch was waiting then, deleting a Space the
+// question never named.
+IN_PROC_BROWSER_TEST_F(SidebarSyncDeleteQuestionB02Test,
+                       DeleteHereAsksAgainWhenTheBatchGrewWhileItWasAsked) {
+  ASSERT_NO_FATAL_FAILURE(JoinThenTravelIsDeletedThere());
+  content::WebContents* const page = OpenSettings();
+  ASSERT_TRUE(page);
+  ASSERT_EQ("open | Delete Travel here?",
+            content::EvalJs(page, OnSyncSection(kAskDeleteHere)));
+
+  ASSERT_NO_FATAL_FAILURE(RecipesIsDeletedThereToo());
+  constexpr char kConfirm[] = R"js(
+      if (!await wait(() => rowText().includes('Recipes'))) {
+        return 'the row never named Recipes';
+      }
+      root.querySelector('#deleteConfirm').click();
+      // Whatever the click sent, the browser has answered once this has.
+      await cr.sendWithPromise('steddingSidebarSyncStatus');
+      await section.updateComplete;
+      const asked = title();
+      return [dialog().open ? 'open' : 'closed',
+              asked.includes('Travel') ? 'Travel' : '-',
+              asked.includes('Recipes') ? 'Recipes' : '-'].join(' | ');
+  )js";
+  ASSERT_EQ("open | Travel | Recipes",
+            content::EvalJs(page, OnSyncSection(kConfirm)))
+      << "the question was not asked again with the row as it is now";
+  EXPECT_TRUE(registry().Find(SpaceOf(travel_)));
+  EXPECT_TRUE(registry().Find(SpaceOf(recipes_)))
+      << "a Space the question never named was deleted";
+  const std::optional<std::vector<std::string>> asked = AskedSpaces();
+  ASSERT_TRUE(asked) << "the batch no longer waits";
+  EXPECT_EQ((std::vector<std::string>{"Recipes", "Travel"}), *asked);
+
+  // The question asked again is answered: both go, Home stays.
+  constexpr char kConfirmAgain[] = R"js(
+      root.querySelector('#deleteConfirm').click();
+      await wait(() => !dialog().open);
+      await cr.sendWithPromise('steddingSidebarSyncStatus');
+      return dialog().open ? 'open' : 'closed';
+  )js";
+  EXPECT_EQ("closed", content::EvalJs(page, OnSyncSection(kConfirmAgain)));
+  EXPECT_TRUE(base::test::RunUntil([&] {
+    return !registry().Find(SpaceOf(travel_)) &&
+           !registry().Find(SpaceOf(recipes_));
+  })) << "the answered question deleted nothing";
+  EXPECT_TRUE(registry().Find(SpaceOf(home_)));
+  EXPECT_FALSE(AskedSpaces());
+}
+
+// P03-1a, Sf23: an answer the page sends before the newer batch reached it is
+// refused by the browser, and the row as it is now is asked about instead.
+// The browser applied the newer batch whole.
+IN_PROC_BROWSER_TEST_F(SidebarSyncDeleteQuestionB02Test,
+                       AnAnswerToAnOlderDeleteQuestionIsRefused) {
+  ASSERT_NO_FATAL_FAILURE(JoinThenTravelIsDeletedThere());
+  content::WebContents* const page = OpenSettings();
+  ASSERT_TRUE(page);
+  ASSERT_EQ("open | Delete Travel here?",
+            content::EvalJs(page, OnSyncSection(kAskDeleteHere)));
+
+  ASSERT_NO_FATAL_FAILURE(RecipesIsDeletedThereToo());
+  constexpr char kConfirmFromTheOlderPage[] = R"js(
+      if (!await wait(() => rowText().includes('Recipes'))) {
+        return 'the row never named Recipes';
+      }
+      // As on a page the newer batch had not reached when the user
+      // confirmed: the status the question was asked from, then Delete here.
+      section.status_ = window.askedStatusB02;
+      section.onDeleteConfirmClick_();
+      await cr.sendWithPromise('steddingSidebarSyncStatus');
+      // The row as it is now comes back, to be asked about.
+      return await wait(() => rowText().includes('Recipes')) ? 'asked again' :
+                                                               'no row';
+  )js";
+  EXPECT_EQ("asked again",
+            content::EvalJs(page, OnSyncSection(kConfirmFromTheOlderPage)));
+  EXPECT_TRUE(registry().Find(SpaceOf(travel_)));
+  EXPECT_TRUE(registry().Find(SpaceOf(recipes_)))
+      << "a Space the question never named was deleted";
+  const std::optional<std::vector<std::string>> asked = AskedSpaces();
+  ASSERT_TRUE(asked) << "the newer batch was taken without being asked";
+  EXPECT_EQ((std::vector<std::string>{"Recipes", "Travel"}), *asked);
+}
+
+}  // namespace
