+// docs/features/sidebar-file.md Sf7-Sf41: the "Sync through a folder" box.
+// Every control is a button, an input or a checkbox with its own name, so
+// each is reached by Tab and read by a screen reader (Sf7).
+export function getHtml(this: SettingsSteddingSyncSectionElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+${this.status_?.available ? html`
+<div class="settings-box continuation" id="sidebarSync">
+  <div class="flex">
+    <div class="label" id="syncLabel">$i18n{steddingSyncLabel}</div>
+    ${this.status_.enabled ? html`
+      <div class="secondary" id="syncFolder">${this.folderLine_()}</div>
+      <div class="secondary" id="syncStatus">${this.statusLine_()}</div>
+      ${this.problemLine_() ? html`
+        <div class="secondary sync-problem" id="syncProblem" role="status">
+          ${this.problemLine_()}
+        </div>` : ''}
+      <div class="sync-row">
+        <cr-input id="syncDevice" class="flex"
+            label="$i18n{steddingSyncDeviceLabel}"
+            .value="${this.status_.device || ''}"
+            @change="${this.onDeviceChange_}">
+        </cr-input>
+      </div>
+      <div class="sync-buttons">
+        <cr-button id="syncNow" @click="${this.onSyncNowClick_}">
+          $i18n{steddingSyncNow}
+        </cr-button>
+        <cr-button id="syncShowFolder" @click="${this.onShowFolderClick_}">
+          $i18n{steddingSyncShowFolder}
+        </cr-button>
+        <cr-button id="syncStop" @click="${this.onStopClick_}">
+          $i18n{steddingSyncStop}
+        </cr-button>
+      </div>
+      ${this.decisions_().map(row => html`
+        <div class="sync-row" role="group"
+            aria-label="${this.decisionLine_(row)}">
+          <div class="flex secondary">${this.decisionLine_(row)}</div>
+          ${this.decisionButtons_(row).map(button => html`
+            <cr-button data-id="${row.id}" data-choice="${button.choice}"
+                @click="${this.onDecisionClick_}">
+              ${button.label}
+            </cr-button>`)}
+        </div>`)}
+      ${this.journal_().length ? html`
+        <div class="label sync-list-label">$i18n{steddingSyncRecentLabel}</div>
+        ${this.journal_().map(entry => html`
+          <div class="sync-row">
+            <div class="flex secondary">${this.journalLine_(entry)}</div>
+            <cr-button data-id="${entry.id}" @click="${this.onUndoClick_}"
+                aria-label="${this.undoLabel_(entry)}">
+              $i18n{steddingSyncUndo}
+            </cr-button>
+          </div>`)}` : ''}
+      ${this.backups_().length ? html`
+        <div class="label sync-list-label">$i18n{steddingSyncBackupsLabel}</div>
+        ${this.backups_().map(name => html`
+          <div class="sync-row">
+            <div class="flex secondary">${name}</div>
+            <cr-button data-name="${name}" @click="${this.onImportBackupClick_}"
+                aria-label="${this.importLabel_(name)}">
+              $i18n{steddingSyncImport}
+            </cr-button>
+          </div>`)}` : ''}
+    ` : html`
+      <div class="secondary">$i18n{steddingSyncSubLabel}</div>
+      ${this.refusal_ ? html`
+        <div class="secondary sync-problem" id="syncRefusal" role="status">
+          ${this.refusal_}
+        </div>` : ''}
+    `}
+  </div>
+  ${!this.status_.enabled ? html`
+    <cr-button id="syncSetUp" @click="${this.onSetUpClick_}">
+      $i18n{steddingSyncSetUp}
+    </cr-button>` : ''}
+</div>` : ''}
+<cr-dialog id="joinDialog" @close="${this.onJoinDialogClose_}">
+  <div slot="title">$i18n{steddingSyncLabel}</div>
+  <div slot="body">
+    <cr-input id="joinDevice" label="$i18n{steddingSyncDeviceLabel}"
+        .value="${this.deviceName_}" @input="${this.onJoinDeviceInput_}">
+    </cr-input>
+    ${this.previewLines_().map(line => html`
+      <div class="secondary">${line}</div>`)}
+    ${this.preview_?.pairs?.length ? html`
+      <div class="label sync-list-label">$i18n{steddingSyncPairsLabel}</div>
+      <div class="sync-pairs">
+        ${this.preview_.pairs.map((pair, index) => html`
+          <cr-checkbox data-index="${index}" ?checked="${this.pairChecks_[index]}"
+              @change="${this.onPairChange_}">
+            ${pair.label}
+          </cr-checkbox>`)}
+      </div>` : ''}
+    <div class="secondary">$i18n{steddingSyncBackupNote}</div>
+  </div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" @click="${this.onJoinCancelClick_}">
+      $i18n{steddingSyncCancel}
+    </cr-button>
+    ${this.hasPeers_() ? html`
+      <cr-button id="joinKeepBoth" @click="${this.onKeepBothClick_}">
+        $i18n{steddingSyncKeepBoth}
+      </cr-button>
+      <cr-button id="joinCombine" class="action-button"
+          @click="${this.onCombineClick_}">
+        $i18n{steddingSyncCombine}
+      </cr-button>` : html`
+      <cr-button id="joinStart" class="action-button"
+          @click="${this.onCombineClick_}">
+        $i18n{steddingSyncStart}
+      </cr-button>`}
+  </div>
+</cr-dialog>
+<cr-dialog id="stopDialog">
+  <div slot="title">$i18n{steddingSyncStopTitle}</div>
+  <div slot="body">
+    <div class="secondary">$i18n{steddingSyncStopBody}</div>
+    <cr-checkbox id="stopRemoveFile" ?checked="${this.removeOwnFile_}"
+        @change="${this.onRemoveOwnFileChange_}">
+      $i18n{steddingSyncStopRemoveFile}
+    </cr-checkbox>
+  </div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" @click="${this.onStopCancelClick_}">
+      $i18n{steddingSyncCancel}
+    </cr-button>
+    <cr-button id="stopConfirm" class="action-button"
+        @click="${this.onStopConfirmClick_}">
+      $i18n{steddingSyncStop}
+    </cr-button>
+  </div>
+</cr-dialog>
+<cr-dialog id="deleteDialog">
+  <div slot="title">${this.deleteTitle_()}</div>
+  <div slot="body">
+    <div class="secondary">$i18n{steddingSyncDeleteBody}</div>
+  </div>
+  <div slot="button-container">
+    <cr-button class="cancel-button" @click="${this.onDeleteCancelClick_}">
+      $i18n{steddingSyncCancel}
+    </cr-button>
+    <cr-button id="deleteConfirm" class="action-button"
+        @click="${this.onDeleteConfirmClick_}">
+      $i18n{steddingSyncDeleteHere}
+    </cr-button>
+  </div>
+</cr-dialog>
+<!--_html_template_end_-->`;
+  // clang-format on
+}
