+  if (chosen.passwords > 0) {
+    choices.append(checkbox('Passwords', state.safariPasswords,
+                            'safari-passwords',
+                            v => state.safariPasswords = v));
+  }
+  const button = el('button', 'primary',
+      state.safariStatus === 'inProgress' ? 'Importing\u2026' :
+      state.safariStatus ? 'Imported' : 'Import');
+  button.dataset['focus'] = 'safari-import';
+  button.disabled = state.safariStatus !== '';
+  button.addEventListener('click', () => {
+    state.safariStatus = 'inProgress';
+    render();
+    sendWithPromise('importSafariExport', state.safariBookmarks,
+                    state.safariHistory, state.safariPasswords)
+        .then((line: unknown) => {
+          state.safariStatus = String(line);
+          render();
+        });
+  });
+  choices.append(button);
+  block.append(choices);
+  if (chosen.passwords > 0) {
+    block.append(el('div', 'hint',
+        'They are in the file as plain text. Stedding brings them in only ' +
