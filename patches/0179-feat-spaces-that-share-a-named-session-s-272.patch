+// The Spaces of `ids` as a sentence names them.
+std::u16string QuotedSpaces(const SpaceModel& model,
+                            const std::vector<SpaceId>& ids) {
+  std::vector<std::u16string> names;
+  for (const SpaceId& id : ids) {
+    names.push_back(model.DisplayName(id));
+  }
+  return QuotedNamesInSentence(names);
+}
+
+// sessions S41, S42: the other Spaces that name the session `id` is in, its
+// on or off, in the list's order. Nothing for a Space with no jar.
+std::vector<SpaceId> OthersNamingSessionOf(const SpaceModel& model,
+                                           const SpaceId& id) {
+  std::vector<SpaceId> others;
+  const SpaceRegistry* const registry = model.registry();
+  const RegistryEntry* const entry = registry ? registry->Find(id) : nullptr;
+  if (!entry || entry->profile_id.empty()) {
+    return others;
+  }
+  for (const RegistryEntry& each : registry->entries()) {
+    if (each.id != id && each.profile_id == entry->profile_id) {
+      others.push_back(each.id);
+    }
+  }
+  return others;
+}
+
+// sessions S52: whether another Space has the session of `id` on, so the
+// apps made in it keep it when `id` leaves.
+bool AnotherSpaceUsesSessionOf(const SpaceModel& model, const SpaceId& id) {
+  const std::string session = model.SessionOf(id);
+  return std::ranges::any_of(
+      OthersNamingSessionOf(model, id), [&](const SpaceId& other) {
+        return !session.empty() && model.SessionOf(other) == session;
+      });
+}
+
+// The name a session goes by inside a sentence.
+std::u16string SessionNameInSentence(const SpaceModel& model,
+                                     const std::string& session) {
+  const std::optional<SessionEntry> found =
+      model.registry() ? model.registry()->FindSession(session) : std::nullopt;
+  return found ? NameInSentence(base::UTF8ToUTF16(found->name))
+               : std::u16string();
+}
 
