+class EmptySpacePageW2B04Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  spaces::SpaceModel& model() {
+    spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+    CHECK(model) << "a normal window has Spaces";
+    return *model;
+  }
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+
+  // Shows a new empty Space, whose page is then on screen, and returns that
+  // page once its support link is drawn and takes input.
+  content::WebContents* ShowAnEmptySpace(const std::string& name) {
+    // A window tall enough for the page's foot line, which a short one hides.
+    browser_view()->GetWidget()->SetBounds(gfx::Rect(0, 0, 1280, 900));
+    const spaces::SpaceId empty = model().AddSpace(name, SK_ColorGREEN)->id();
+    if (!model().SetActiveSpace(empty)) {
+      return nullptr;
+    }
+    tabs::TabInterface* const page = tabs().GetActiveTab();
+    if (!page || !stedding::IsEmptySpaceStandIn(page)) {
+      return nullptr;
+    }
+    content::WebContents* const contents = page->GetContents();
+    if (!content::WaitForLoadStop(contents) ||
+        !base::test::RunUntil([&]() {
+          return content::EvalJs(
+                     contents,
+                     "document.getElementById('support')"
+                     ".getBoundingClientRect().height > 0 && "
+                     "document.getElementById('title').textContent !== ''")
+              .ExtractBool();
+        })) {
+      return nullptr;
+    }
+    content::SimulateEndOfPaintHoldingOnPrimaryMainFrame(contents);
+    return contents;
+  }
+
+  // The address of a tab the support link opened: GitHub Sponsors, or a copy
+  // of the Space's page that is not the stand-in. "" while there is none.
+  std::string Opened() {
+    for (int i = 0; i < tabs().count(); ++i) {
+      tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+      if (stedding::IsEmptySpaceStandIn(tab)) {
+        continue;
+      }
+      const GURL url = tab->GetContents()->GetVisibleURL();
+      if (url.host() == stedding::kEmptySpaceHost ||
+          url.host() == "github.com") {
+        return url.spec();
+      }
+    }
+    return std::string();
+  }
+};
+
+// P04-1j, tabs R66: a middle click on the Space page's "support it" opens
+// GitHub Sponsors, as a click does. The link's own address was the page's,
+// so a middle click opened chrome://stedding-space in a background tab: a
+// row of its own in the sidebar, another "Nothing open" page.
+IN_PROC_BROWSER_TEST_F(EmptySpacePageW2B04Test,
+                       AMiddleClickOnSupportOpensNoCopyOfThePage) {
+  content::WebContents* const page = ShowAnEmptySpace("Empty");
+  ASSERT_TRUE(page) << "the Space's page did not show its support link";
+  ASSERT_EQ("", Opened());
+
+  const std::string rect =
+      "document.getElementById('support').getBoundingClientRect()";
+  const int x =
+      content::EvalJs(page,
+                      "(r => Math.round(r.left + r.width / 2))(" + rect + ")")
+          .ExtractInt();
+  const int y =
+      content::EvalJs(page,
+                      "(r => Math.round(r.top + r.height / 2))(" + rect + ")")
+          .ExtractInt();
+  ASSERT_EQ(true, content::EvalJs(
+                      page, content::JsReplace(
+                                "document.getElementById('support').contains("
+                                "    document.elementFromPoint($1, $2))",
+                                x, y)))
+      << "the point is not on the link";
+
+  content::SimulateMouseClickAt(page, /*modifiers=*/0,
+                                blink::WebMouseEvent::Button::kMiddle,
+                                gfx::Point(x, y));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !Opened().empty(); }))
+      << "the middle click opened nothing";
+  const GURL opened(Opened());
+  EXPECT_EQ("github.com", opened.host())
+      << "the middle click opened " << opened;
+}
+
+// P04-1j, tabs R66: the support link, no longer one with an address of its
+// own, still opens GitHub Sponsors from the keyboard's Enter.
+IN_PROC_BROWSER_TEST_F(EmptySpacePageW2B04Test, EnterOnSupportOpensSponsors) {
+  content::WebContents* const page = ShowAnEmptySpace("Empty");
+  ASSERT_TRUE(page) << "the Space's page did not show its support link";
+  ASSERT_EQ("", Opened());
+  ASSERT_TRUE(content::ExecJs(
+      page,
+      "{ const link = document.getElementById('support');"
+      "  link.focus();"
+      "  link.dispatchEvent(new KeyboardEvent("
+      "      'keydown', {key: 'Enter', bubbles: true, cancelable: true})); }"));
+  ASSERT_TRUE(base::test::RunUntil([&]() { return !Opened().empty(); }))
+      << "Enter on the link opened nothing";
+  const GURL opened(Opened());
+  EXPECT_EQ("github.com", opened.host()) << "Enter opened " << opened;
+}
