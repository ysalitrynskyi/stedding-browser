+#ifndef CHROME_BROWSER_UI_VIEWS_SPACES_CLEAR_TABS_ROW_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_SPACES_CLEAR_TABS_ROW_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+
+class Browser;
+
+namespace spaces {
+
+// The hairline above the new-tab row, with a Clear at its trailing end.
+//
+// Clear closes the tabs of the Space you are looking at, leaving pinned tabs --
+// the essentials, which belong to every Space -- alone. It is the reference's
+// way of emptying a Space without closing its window.
+class ClearTabsRowView : public views::View {
+  METADATA_HEADER(ClearTabsRowView, views::View)
+
+ public:
+  explicit ClearTabsRowView(Browser* browser);
+  ClearTabsRowView(const ClearTabsRowView&) = delete;
+  ClearTabsRowView& operator=(const ClearTabsRowView&) = delete;
+  ~ClearTabsRowView() override;
+
+ private:
+  void OnClearPressed();
+
+  const raw_ptr<Browser> browser_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SPACES_CLEAR_TABS_ROW_VIEW_H_
