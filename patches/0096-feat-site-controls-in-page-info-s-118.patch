+// site-controls Si9: the Dark pages switch turns the profile's switch on and
+// brings Darken <site>; turning that off keeps the page light; the chord
+// pressed with the panel open flips the switch row and takes Darken <site>
+// away.
+IN_PROC_BROWSER_TEST_F(SiteControlsTest, TheDarkRowsFollowTheSwitchAndTheSite) {
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_FALSE(stedding::DarkPagesOn(profile));
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("site.test")));
+  SiteControlsRowsView* const rows = Rows(OpenFromTheChip());
+  ASSERT_TRUE(rows);
+  EXPECT_TRUE(rows->dark_pages_row()->GetVisible());
+  EXPECT_FALSE(rows->dark_pages()->GetIsOn());
+  EXPECT_FALSE(rows->dark_site_row()->GetVisible());
+
+  Click(rows->dark_pages());
+  EXPECT_TRUE(stedding::DarkPagesOn(profile)) << "the switch is the moon's";
+  EXPECT_TRUE(rows->dark_site_row()->GetVisible());
+  EXPECT_EQ(u"Darken site.test", rows->dark_site_row()->GetTitleForTesting());
+  EXPECT_TRUE(rows->dark_site()->GetIsOn());
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return page()->GetOrCreateWebPreferences().force_dark_mode_enabled;
+  })) << "the page is not darkened";
+
+  Click(rows->dark_site());
+  EXPECT_FALSE(stedding::IsSiteDarkened(page()));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !page()->GetOrCreateWebPreferences().force_dark_mode_enabled;
