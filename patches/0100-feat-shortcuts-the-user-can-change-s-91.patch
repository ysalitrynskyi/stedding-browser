index 0000000000000..bc0804033a1f9
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_hotkeys_mac.mm
@@ -0,0 +1,74 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_hotkeys_mac.h"
+
+#include <Carbon/Carbon.h>
+
+#include <vector>
+
+#include "base/apple/foundation_util.h"
+#include "base/apple/scoped_cftyperef.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_code_conversion_mac.h"
+
+namespace stedding::shortcuts {
+
+std::vector<Chord> ReadEnabledSystemHotKeys() {
+  std::vector<Chord> hot_keys;
+  CFArrayRef raw = nullptr;
+  if (CopySymbolicHotKeys(&raw) != noErr || !raw) {
+    return hot_keys;
+  }
+  base::apple::ScopedCFTypeRef<CFArrayRef> list(raw);
+  for (CFIndex i = 0; i < CFArrayGetCount(list.get()); ++i) {
+    CFDictionaryRef const entry = base::apple::CFCast<CFDictionaryRef>(
+        CFArrayGetValueAtIndex(list.get(), i));
+    if (!entry) {
+      continue;
+    }
+    CFBooleanRef const enabled =
+        base::apple::GetValueFromDictionary<CFBooleanRef>(
+            entry, kHISymbolicHotKeyEnabled);
+    CFNumberRef const code = base::apple::GetValueFromDictionary<CFNumberRef>(
+        entry, kHISymbolicHotKeyCode);
+    CFNumberRef const carbon_modifiers =
+        base::apple::GetValueFromDictionary<CFNumberRef>(
+            entry, kHISymbolicHotKeyModifiers);
+    if (!enabled || !CFBooleanGetValue(enabled) || !code ||
+        !carbon_modifiers) {
+      continue;
+    }
+    int key_code = 0;
+    int modifier_bits = 0;
+    if (!CFNumberGetValue(code, kCFNumberIntType, &key_code) ||
+        !CFNumberGetValue(carbon_modifiers, kCFNumberIntType,
+                          &modifier_bits) ||
+        key_code < 0 || key_code > 0xFF) {
+      continue;
+    }
+    const ui::KeyboardCode key =
+        ui::KeyboardCodeFromKeyCode(static_cast<unsigned short>(key_code));
+    if (key == ui::VKEY_UNKNOWN) {
+      continue;
+    }
+    int modifiers = 0;
+    if (modifier_bits & cmdKey) {
+      modifiers |= ui::EF_COMMAND_DOWN;
+    }
+    if (modifier_bits & shiftKey) {
+      modifiers |= ui::EF_SHIFT_DOWN;
+    }
+    if (modifier_bits & optionKey) {
+      modifiers |= ui::EF_ALT_DOWN;
+    }
+    if (modifier_bits & controlKey) {
+      modifiers |= ui::EF_CONTROL_DOWN;
+    }
+    hot_keys.emplace_back(key, modifiers);
+  }
+  return hot_keys;
+}
+
+}  // namespace stedding::shortcuts
