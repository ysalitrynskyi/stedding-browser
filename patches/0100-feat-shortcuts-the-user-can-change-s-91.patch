+// The editable block (shortcuts Z5) through the page's own messages, on a
+// Local State of the test's.
+class SteddingShortcutsHandlerTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    prefs::RegisterLocalStatePrefs(local_state_.registry());
+    auto handler = std::make_unique<SteddingShortcutsHandler>(&local_state_);
+    handler_ = handler.get();
+    web_ui_.AddMessageHandler(std::move(handler));
+  }
+
+  void TearDown() override { shortcuts::SetCurrent(shortcuts::UserShortcuts()); }
+
+  // Sends `message` with a callback id first; the value it resolves with.
+  base::Value Send(const std::string& message, base::ListValue args) {
+    base::ListValue with_id;
+    with_id.Append("id");
+    for (base::Value& arg : args) {
+      with_id.Append(std::move(arg));
+    }
+    web_ui_.HandleReceivedMessage(message, with_id);
+    const content::TestWebUI::CallData& call = *web_ui_.call_data().back();
+    EXPECT_EQ("cr.webUIResponse", call.function_name());
+    EXPECT_EQ(true, call.arg2()->GetIfBool()) << message;
+    return call.arg3() ? call.arg3()->Clone() : base::Value();
+  }
+
+  // The row named `name` as the page receives it.
+  base::DictValue RowNamed(const std::string& name) {
+    const base::Value groups = Send("steddingGetShortcutRows", {});
+    for (const base::Value& group : groups.GetList()) {
+      for (const base::Value& row : *group.GetDict().FindList("rows")) {
+        if (*row.GetDict().FindString("name") == name) {
+          return row.GetDict().Clone();
+        }
+      }
+    }
+    ADD_FAILURE() << "no row " << name;
+    return base::DictValue();
+  }
+
+  static base::ListValue Args(std::initializer_list<base::Value> values) {
+    base::ListValue list;
+    for (const base::Value& value : values) {
+      list.Append(value.Clone());
+    }
+    return list;
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  TestingPrefServiceSimple local_state_;
+  content::TestWebUI web_ui_;
+  raw_ptr<SteddingShortcutsHandler> handler_ = nullptr;
+};
+
+// shortcuts Z5: a row is checked, takes a chord, loses one, is turned off
+// and on, is reset, and Reset all puts every row back; each change is in
+// Local State.
+TEST_F(SteddingShortcutsHandlerTest, AddRemoveOffResetAndResetAll) {
+  const shortcuts::Chord chord(
+      ui::VKEY_J, ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_SHIFT_DOWN);
+  base::DictValue row = RowNamed("clear-space");
+  EXPECT_FALSE(*row.FindBool("changed"));
+  EXPECT_TRUE(*row.FindBool("rebind"));
+  EXPECT_TRUE(*row.FindBool("toggle"));
+  ASSERT_FALSE(row.FindList("chords")->empty());
+  const std::string shipped =
+      *(*row.FindList("chords"))[0].GetDict().FindString("value");
+
+  const base::Value check =
+      Send("steddingCheckShortcut",
+           Args({base::Value("clear-space"), base::Value(static_cast<int>(ui::VKEY_J)),
+                 base::Value(true), base::Value(true), base::Value(true),
+                 base::Value(false)}));
+  EXPECT_EQ("ok", *check.GetDict().FindString("kind"));
+  EXPECT_EQ(shortcuts::ChordToString(chord),
+            *check.GetDict().FindString("value"));
+
+  const base::Value added =
+      Send("steddingAddShortcut",
+           Args({base::Value("clear-space"),
+                 base::Value(shortcuts::ChordToString(chord)),
+                 base::Value(false)}));
+  EXPECT_EQ("ok", *added.GetDict().FindString("kind"));
+  EXPECT_EQ(base::Value(true),
+            Send("steddingRemoveShortcut",
+                 Args({base::Value("clear-space"), base::Value(shipped)})));
+  row = RowNamed("clear-space");
+  EXPECT_TRUE(*row.FindBool("changed"));
+  ASSERT_EQ(1u, row.FindList("chords")->size());
+  EXPECT_EQ(shortcuts::ChordToString(chord),
+            *(*row.FindList("chords"))[0].GetDict().FindString("value"));
+  EXPECT_TRUE(local_state_.GetDict(prefs::kShortcutsUser)
+                  .FindDictByDottedPath("commands.clear-space"));
+
+  EXPECT_EQ(base::Value(true),
+            Send("steddingSetShortcutOff",
+                 Args({base::Value("clear-space"), base::Value(true)})));
+  EXPECT_TRUE(*RowNamed("clear-space").FindBool("off"));
+  EXPECT_EQ(base::Value(true),
+            Send("steddingSetShortcutOff",
+                 Args({base::Value("clear-space"), base::Value(false)})));
+  EXPECT_FALSE(*RowNamed("clear-space").FindBool("off"));
+
+  EXPECT_EQ(base::Value(true),
+            Send("steddingResetShortcut", Args({base::Value("clear-space")})));
+  EXPECT_FALSE(*RowNamed("clear-space").FindBool("changed"));
+
+  Send("steddingSetShortcutOff",
+       Args({base::Value("next-space"), base::Value(true)}));
+  Send("steddingSetShortcutOff",
+       Args({base::Value("clear-space"), base::Value(true)}));
+  EXPECT_EQ(base::Value(true), Send("steddingResetAllShortcuts", {}));
+  EXPECT_FALSE(*RowNamed("next-space").FindBool("changed"));
+  EXPECT_FALSE(*RowNamed("clear-space").FindBool("changed"));
+
+  // A fixed row is read-only; a row the page names wrongly changes nothing.
+  base::DictValue quit = RowNamed("close-window");
+  EXPECT_FALSE(*quit.FindBool("rebind"));
+  EXPECT_FALSE(*quit.FindBool("toggle"));
+  EXPECT_EQ(base::Value(false),
+            Send("steddingResetShortcut", Args({base::Value("no-such-row")})));
+}
