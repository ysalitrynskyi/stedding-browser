+#if BUILDFLAG(IS_WIN)
+// Stedding little E1, E10: opens each of `tabs`, links another app handed
+// over, in a little window over the last-active window of `profile`, or on
+// its own with none. One the profile may not open that way becomes a tab of
+// that window, the ordinary way (E6).
+void OpenLittleTabs(Profile* profile, const StartupTabs& tabs) {
+  for (const StartupTab& tab : tabs) {
+    if (stedding::OpenLittleWindow(profile, tab.url, /*anchor=*/nullptr,
+                                   tab.is_untrusted_launch)) {
+      continue;
+    }
+    spaces::MarkExternalOpen(tab.url);
+    BrowserWindowInterface* const window =
+        stedding::LastActiveNormalWindow(profile);
+    if (!window) {
+      continue;
+    }
+    NavigateParams params(window, tab.url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+    if (tab.is_untrusted_launch) {
+      // As OpenTabsInBrowser does: nothing vouches for the address.
+      params.initiator_origin = url::Origin();
+    }
+    params.disposition = WindowOpenDisposition::kNewForegroundTab;
+    Navigate(&params);
+  }
+}
+
+// Stedding little E10: links another app handed over while Stedding ran with
+// no window open, kept on their profile while the session restore that
+// launch began brings its windows back. A little window opens over the
+// last-active window, and there was none yet: the links were dropped. They
+// open once the restore is over, over the window it brought back, as they do
+// at startup.
+class LittleTabsAwaitingRestore : public base::SupportsUserData::Data {
+ public:
+  explicit LittleTabsAwaitingRestore(Profile* profile)
+      : profile_(profile),
+        restored_(SessionRestore::RegisterOnSessionRestoredCallback(
+            base::BindRepeating(&LittleTabsAwaitingRestore::OnRestored,
+                                base::Unretained(this)))) {}
+  LittleTabsAwaitingRestore(const LittleTabsAwaitingRestore&) = delete;
+  LittleTabsAwaitingRestore& operator=(const LittleTabsAwaitingRestore&) =
+      delete;
+  ~LittleTabsAwaitingRestore() override = default;
+
+  // Keeps `tabs` on `profile` until its restore is over.
+  static void Keep(Profile* profile, const StartupTabs& tabs) {
+    auto* awaiting = static_cast<LittleTabsAwaitingRestore*>(
+        profile->GetUserData(kUserDataKey));
+    if (!awaiting) {
+      auto made = std::make_unique<LittleTabsAwaitingRestore>(profile);
+      awaiting = made.get();
+      profile->SetUserData(kUserDataKey, std::move(made));
+    }
+    AppendTabs(tabs, &awaiting->tabs_);
+  }
+
+ private:
+  static constexpr char kUserDataKey[] = "stedding.little.awaiting_restore";
+
+  void OnRestored(Profile* restored, int /*tab_count*/) {
+    if (restored != profile_) {
+      return;
+    }
+    // A turn later, once the restore is over and the window it brought back
+    // is on screen.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&LittleTabsAwaitingRestore::Open,
+                                  profile_->GetWeakPtr()));
+  }
+
+  static void Open(base::WeakPtr<Profile> profile) {
+    if (!profile) {
+      return;
+    }
+    auto* const awaiting = static_cast<LittleTabsAwaitingRestore*>(
+        profile->GetUserData(kUserDataKey));
+    if (!awaiting) {
+      return;
+    }
+    const StartupTabs tabs = std::move(awaiting->tabs_);
+    profile->RemoveUserData(kUserDataKey);
+    OpenLittleTabs(profile.get(), tabs);
+  }
+
+  const raw_ptr<Profile> profile_;
+  StartupTabs tabs_;
+  base::CallbackListSubscription restored_;
+};
+#endif  // BUILDFLAG(IS_WIN)
+
 }  // namespace
 
