+// tabs R4, folders F12 (BACKLOG S-316): a page's colour does not reach the
+// rows' text. The page bar sets kColorToolbarText for the address row; rows
+// measured from it shifted a shade whenever a page's colour arrived, and a
+// folder's header was drawn again for it.
+TEST(SteddingColorMixerTest, APagesColourLeavesTheRowsTextAlone) {
+  base::test::ScopedFeatureList features(stedding::kArcStyleWindow);
+  for (const auto mode : {ui::ColorProviderKey::ColorMode::kDark,
+                          ui::ColorProviderKey::ColorMode::kLight}) {
+    ui::ColorProviderKey key;
+    key.color_mode = mode;
+    const auto row_text = [&](std::optional<SkColor> page_text) {
+      ui::ColorProvider provider;
+      ui::AddColorMixers(&provider, key);
+      AddChromeColorMixers(&provider, key);
+      // As the page bar's supplier does, after every other mixer.
+      if (page_text) {
+        provider.AddMixer()[kColorToolbarText] =
+            ui::ColorTransform(SkColor{*page_text});
+      }
+      provider.GenerateColorMapForTesting();
+      return provider.GetColor(kColorTabForegroundInactiveFrameActive);
+    };
+    const SkColor plain = row_text(std::nullopt);
+    EXPECT_EQ(plain, row_text(SK_ColorBLACK)) << "a light page's colour";
+    EXPECT_EQ(plain, row_text(SK_ColorWHITE)) << "a dark page's colour";
+  }
+}
