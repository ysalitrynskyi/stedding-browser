+                       PRE_ASessionCookieInASpacesJarOutlivesARestart) {
+  SessionStartupPref::SetStartupPref(
+      browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  ASSERT_TRUE(model());
+  const spaces::SpaceId home = model()->active_id();
+  model()->SetSpaceName(home, "Home");
+  const spaces::SpaceId work = model()->AddSpace("Work", SK_ColorBLUE)->id();
+  model()->SetSpaceIsolated(work, true);
+
+  // A cookie with no expiry, set by the page itself, so the pages the
+  // restart brings back set nothing again: the profile's jar from a tab of
+  // Home, Work's own jar from a tab of Work.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("/title1.html")));
+  ASSERT_TRUE(content::ExecJs(tabs()->GetActiveWebContents(),
+                              "document.cookie = 'signed=home'"));
+  ASSERT_EQ("signed=home", CookieSeenInANewTab());
+  ASSERT_TRUE(model()->SetActiveSpace(work));
