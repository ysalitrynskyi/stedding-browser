+namespace {
+
+// Stedding (docs/features/toolbar.md T32): macOS 26 and later back the
+// full-screen title bar, which holds the address row, with a scroll pocket
+// whose hard edge draws a separator: a one-pixel vibrant line across the
+// whole window under the row, over the sidebar, the page and the card's
+// gutter (the owner, 2026-10-18), which the blank -separatorView below does
+// not keep away. Neither the window's separator style, a transparent title
+// bar nor the accessory's soft scroll edge turns it off; the pocket's own
+// (private) switch does. Asked again whenever the title bar may have laid
+// its pocket out anew; a macOS without one has nothing to turn off.
+void HideTitlebarPocketSeparators(NSWindow* window) {
+  if (!remote_cocoa::IsNSToolbarFullScreenWindow(window)) {
+    return;
+  }
+  Class const pocket_class = NSClassFromString(@"NSScrollPocket");
+  NSView* const frame_view = window.contentView.superview;
+  if (!pocket_class || !frame_view ||
+      ![pocket_class instancesRespondToSelector:NSSelectorFromString(
+                                                    @"setAllowsSeparator:")]) {
+    return;
+  }
+  NSMutableArray<NSView*>* const views =
+      [NSMutableArray arrayWithObject:frame_view];
+  while (views.count) {
+    NSView* const view = views.lastObject;
+    [views removeLastObject];
+    if ([view isKindOfClass:pocket_class] &&
+        [[view valueForKey:@"allowsSeparator"] boolValue]) {
+      [view setValue:@NO forKey:@"allowsSeparator"];
+    }
+    [views addObjectsFromArray:view.subviews];
+  }
+}
