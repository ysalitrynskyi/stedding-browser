+namespace {
+// switcher X1: how much of a Space's past is kept; the strip shows five.
+constexpr size_t kHistoryCap = 40;
+constexpr size_t kCycleLength = 5;
+}  // namespace
+
+SpaceModel::Cycle::Cycle(SpaceId in_space) : space(std::move(in_space)) {}
+SpaceModel::Cycle::Cycle(Cycle&& other) = default;
+SpaceModel::Cycle& SpaceModel::Cycle::operator=(Cycle&& other) = default;
+SpaceModel::Cycle::~Cycle() = default;
+
+void SpaceModel::RecordActivation(tabs::TabInterface* tab) {
+  if (!tab || cycle_ || !IsTabInActiveSpace(tab)) {
+    return;
+  }
+  std::vector<tabs::TabHandle>& history = history_[active_id_];
+  std::erase(history, tab->GetHandle());
+  history.insert(history.begin(), tab->GetHandle());
+  if (history.size() > kHistoryCap) {
+    history.resize(kHistoryCap);
+  }
+}
+
+std::vector<tabs::TabInterface*> SpaceModel::RecentTabs(const SpaceId& id,
+                                                        size_t limit) const {
+  std::vector<tabs::TabInterface*> out;
+  if (!tab_strip_model_) {
+    return out;
+  }
+  std::vector<split_tabs::SplitTabId> splits_seen;
+  // Still in this Space, or an essential, which is in every Space; a split
+  // counts once.
+  const auto take = [&](tabs::TabInterface* tab) {
+    if (!tab->IsPinned()) {
+      const auto member = tab_spaces_.find(tab->GetHandle());
+      if (member == tab_spaces_.end() || member->second != id) {
+        return false;
+      }
+    }
+    if (const std::optional<split_tabs::SplitTabId> split = tab->GetSplit()) {
+      if (std::ranges::find(splits_seen, *split) != splits_seen.end()) {
+        return false;
+      }
+      splits_seen.push_back(*split);
+    }
+    out.push_back(tab);
+    return true;
+  };
+  if (const auto it = history_.find(id); it != history_.end()) {
+    for (const tabs::TabHandle& handle : it->second) {
+      tabs::TabInterface* const tab = handle.Get();
+      if (!tab ||
+          tab_strip_model_->GetIndexOfTab(tab) == TabStripModel::kNoTab) {
+        continue;
+      }
+      take(tab);
+      if (out.size() >= limit) {
+        return out;
+      }
+    }
+  }
+  // Then the tabs the user never activated, in sidebar order, skipping the
+  // ones a collapsed folder hides.
+  for (int i = 0; i < tab_strip_model_->count() && out.size() < limit; ++i) {
+    tabs::TabInterface* const tab = tab_strip_model_->GetTabAtIndex(i);
+    if (std::ranges::find(out, tab) != out.end() ||
+        tab_strip_model_->IsTabHidden(i)) {
+      continue;
+    }
+    take(tab);
+  }
+  return out;
+}
+
+bool SpaceModel::CycleRecent(int delta) {
+  if (!tab_strip_model_ || delta == 0) {
+    return false;
+  }
+  if (!cycle_) {
+    std::vector<tabs::TabInterface*> recent =
+        RecentTabs(active_id_, kCycleLength);
+    // The run starts on the active tab, whatever the history says.
+    if (tabs::TabInterface* const active = tab_strip_model_->GetActiveTab()) {
+      std::erase(recent, active);
+      recent.insert(recent.begin(), active);
+      if (recent.size() > kCycleLength) {
+        recent.resize(kCycleLength);
+      }
+    }
+    if (recent.size() < 2) {
+      return false;
+    }
+    Cycle cycle(active_id_);
+    for (tabs::TabInterface* const tab : recent) {
+      cycle.tabs.push_back(tab->GetHandle());
+    }
+    cycle.origin = recent.front()->GetHandle();
+    cycle_ = std::move(cycle);
+  }
+  std::erase_if(cycle_->tabs,
+                [](const tabs::TabHandle& handle) { return !handle.Get(); });
+  const int n = static_cast<int>(cycle_->tabs.size());
+  if (n < 2) {
+    cycle_.reset();
+    return false;
+  }
+  int position = (static_cast<int>(cycle_->position) + delta) % n;
+  if (position < 0) {
+    position += n;
+  }
+  cycle_->position = static_cast<size_t>(position);
+  const int index =
+      tab_strip_model_->GetIndexOfTab(cycle_->tabs[cycle_->position].Get());
+  if (index != TabStripModel::kNoTab) {
+    tab_strip_model_->ActivateTabAt(
+        index, TabStripUserGestureDetails(
+                   TabStripUserGestureDetails::GestureType::kKeyboard));
+  }
+  return true;
+}
+
+void SpaceModel::EndCycle() {
+  if (!cycle_) {
+    return;
+  }
+  cycle_.reset();
+  if (tab_strip_model_) {
+    RecordActivation(tab_strip_model_->GetActiveTab());
+  }
+}
+
+void SpaceModel::CancelCycle() {
+  if (!cycle_) {
+    return;
+  }
+  tabs::TabInterface* const origin = cycle_->origin.Get();
+  cycle_.reset();
+  if (!tab_strip_model_ || !origin) {
+    return;
+  }
+  const int index = tab_strip_model_->GetIndexOfTab(origin);
+  if (index != TabStripModel::kNoTab) {
+    tab_strip_model_->ActivateTabAt(
+        index, TabStripUserGestureDetails(
+                   TabStripUserGestureDetails::GestureType::kOther));
+  }
+}
+
+std::vector<tabs::TabInterface*> SpaceModel::cycle_tabs() const {
+  std::vector<tabs::TabInterface*> out;
+  if (!cycle_) {
+    return out;
+  }
+  for (const tabs::TabHandle& handle : cycle_->tabs) {
+    if (tabs::TabInterface* const tab = handle.Get()) {
+      out.push_back(tab);
+    }
+  }
+  return out;
+}
+
+size_t SpaceModel::cycle_position() const {
+  return cycle_ ? cycle_->position : 0;
+}
