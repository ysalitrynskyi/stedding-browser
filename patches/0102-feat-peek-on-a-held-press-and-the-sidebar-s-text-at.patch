+// P10, P18: the settings the decision reads, and the press the link was
+// followed with.
+void ReadSettings(content::WebContents* source, PeekSignals& signals) {
+  const PrefService* const prefs =
+      Profile::FromBrowserContext(source->GetBrowserContext())->GetPrefs();
+  signals.peek_enabled = prefs->GetBoolean(stedding::prefs::kPeekEnabled);
+  signals.hold_delay =
+      base::Milliseconds(prefs->GetInteger(stedding::prefs::kPeekHoldDelayMs));
+  if (const PeekPress* const press = PeekPress::FromWebContents(source)) {
+    signals.press = press->LastPressBefore(base::TimeTicks::Now());
+  }
+}
