+// backlog S-68, commandbar K20: in a window of 1035 DIP with the sidebar open
+// the page card is about 670 DIP and the bar's own 744 ran past the window's
+// right edge, its corner cut flat. The bar is never wider than the card less a
+// margin each side, and follows the window while it is open.
+IN_PROC_BROWSER_TEST_F(CommandBarTest, TheBarStaysInsideANarrowWindow) {
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser());
+  view->GetWidget()->SetBounds(gfx::Rect(0, 0, 1035, 700));
+  views::test::RunScheduledLayout(view);
+  stedding::CommandBarView* const bar = OpenBar();
+  ASSERT_TRUE(bar);
+  views::test::RunScheduledLayout(view);
+
+  const auto card = [&]() {
+    gfx::RectF rect(view->contents_container()->GetLocalBounds());
+    views::View::ConvertRectToTarget(view->contents_container(), bar->parent(),
+                                     &rect);
+    return gfx::ToEnclosingRect(rect);
+  };
+  const int natural = bar->GetPreferredSize().width();
+  ASSERT_LT(card().width(), natural) << "the premise: the card is narrower";
+  EXPECT_GE(bar->x(), card().x());
+  EXPECT_LE(bar->bounds().right(), card().right());
+  EXPECT_LT(bar->width(), natural) << "it gave way";
+
+  view->GetWidget()->SetBounds(gfx::Rect(0, 0, 1800, 700));
+  views::test::RunScheduledLayout(view);
+  ASSERT_GT(card().width(), natural + 32);
+  EXPECT_EQ(natural, bar->width()) << "a wide window gives it its own width";
+  bar->Close();
+}
