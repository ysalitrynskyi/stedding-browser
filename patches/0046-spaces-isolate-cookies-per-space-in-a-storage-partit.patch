+content::StoragePartitionConfig PartitionOf(tabs::TabInterface* tab) {
+  return StoragePartitionConfigForWebContents(tab->GetContents());
+}
+
+// sessions S4
+TEST_F(SpaceWindowTest, IsolatedSpaceTabUsesItsPartition) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  ASSERT_TRUE(model().registry());
+  model().SetSpaceIsolated(work->id(), true);
+  ASSERT_TRUE(model().SpaceIsIsolated(work->id()));
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const tab = OpenTab();
+  EXPECT_EQ(work->id(), model().SpaceForTab(tab));
+  const auto& config = PartitionOf(tab);
+  EXPECT_TRUE(IsSpaceStoragePartition(config)) << config;
+  EXPECT_EQ(model().registry()->Find(work->id())->profile_id,
+            config.partition_name());
+}
+
+// sessions S5
+TEST_F(SpaceWindowTest, SharedSpaceStaysOnDefaultPartition) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceIsolated(work->id(), true);
+  tabs::TabInterface* const home_tab = OpenTab();
+  EXPECT_FALSE(IsSpaceStoragePartition(PartitionOf(home_tab)))
+      << PartitionOf(home_tab);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const work_tab = OpenTab();
+  EXPECT_TRUE(IsSpaceStoragePartition(PartitionOf(work_tab)));
+  EXPECT_NE(PartitionOf(home_tab), PartitionOf(work_tab));
+}
+
+// sessions S6
+TEST_F(SpaceWindowTest, TwoIsolatedSpacesDoNotShareAPartition) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  Space* const mail = model().AddSpace("Mail", SK_ColorGREEN);
+  model().SetSpaceIsolated(work->id(), true);
+  model().SetSpaceIsolated(mail->id(), true);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const work_tab = OpenTab();
+  model().SetActiveSpace(mail->id());
+  tabs::TabInterface* const mail_tab = OpenTab();
+  EXPECT_TRUE(IsSpaceStoragePartition(PartitionOf(work_tab)));
+  EXPECT_TRUE(IsSpaceStoragePartition(PartitionOf(mail_tab)));
+  EXPECT_NE(PartitionOf(work_tab).partition_name(),
+            PartitionOf(mail_tab).partition_name());
+}
+
+// sessions S7
+TEST_F(SpaceWindowTest, TurningIsolationOffUsesTheDefaultPartition) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceIsolated(work->id(), true);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const isolated = OpenTab();
