+// R60: a parent's children fold away under it, the row counting them. What is
+// on screen keeps its row, and a press on the count, or a closed parent, shows
+// them again.
+IN_PROC_BROWSER_TEST_F(ChildTabsTest, AParentsChildrenFoldAwayWithIt) {
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Url("a.test")));
+  tabs::TabInterface* const page = tabs()->GetActiveTab();
+  tabs::TabInterface* const child = OpenLinkFrom(page, "b.test");
+  ASSERT_TRUE(child);
+  tabs::TabInterface* const grandchild = OpenLinkFrom(child, "c.test");
+  ASSERT_TRUE(grandchild);
+  chrome::AddTabAt(browser(), Url("d.test"), /*index=*/-1,
+                   /*foreground=*/false);
+  tabs::TabInterface* const other = tabs()->GetTabAtIndex(tabs()->count() - 1);
+  const auto index = [&](tabs::TabInterface* tab) {
+    return tabs()->GetIndexOfTab(tab);
+  };
+  const auto hidden = [&](tabs::TabInterface* tab) {
+    return tabs()->IsTabHidden(index(tab));
+  };
+  constexpr int kFold = TabStripModel::CommandSteddingFoldChildTabs;
+  constexpr int kUnfold = TabStripModel::CommandSteddingUnfoldChildTabs;
+  tabs()->ActivateTabAt(index(page));
+  ASSERT_TRUE(stedding::IsTabMenuRowVisible(*tabs(), index(page), kFold));
+  EXPECT_FALSE(stedding::IsTabMenuRowVisible(*tabs(), index(page), kUnfold));
+  EXPECT_FALSE(stedding::IsTabMenuRowVisible(*tabs(), index(other), kFold))
+      << "a row with no children has nothing to fold";
+
+  stedding::ExecuteTabMenuVerb(*tabs(), index(page), kFold);
+  EXPECT_TRUE(hidden(child));
+  EXPECT_TRUE(hidden(grandchild));
+  EXPECT_FALSE(hidden(other));
+  EXPECT_FALSE(DrawnRow(child)) << "the child still has a row";
+  TabView* row = DrawnRow(page);
+  ASSERT_TRUE(row);
+  EXPECT_TRUE(row->fold_badge_for_testing()->GetVisible());
+  EXPECT_EQ(u"+2", row->fold_badge_for_testing()->GetText());
+  EXPECT_TRUE(stedding::IsTabMenuRowVisible(*tabs(), index(page), kUnfold));
+  EXPECT_FALSE(stedding::IsTabMenuRowVisible(*tabs(), index(page), kFold));
+
+  {
+    SCOPED_TRACE("what is on screen keeps its row");
+    tabs()->ActivateTabAt(index(child));
+    EXPECT_FALSE(hidden(child));
+    EXPECT_TRUE(hidden(grandchild));
+    tabs()->ActivateTabAt(index(page));
+    EXPECT_TRUE(hidden(child));
+  }
+  {
+    SCOPED_TRACE("a press on the count unfolds");
+    row = DrawnRow(page);
+    ASSERT_TRUE(row);
+    stedding::test::ClickLeftMouse(
+        widget(), row->fold_badge_for_testing()->GetBoundsInScreen().CenterPoint());
+    EXPECT_TRUE(base::test::RunUntil(
+        [&]() { return !stedding::ChildrenFolded(page->GetContents()); }));
+    EXPECT_FALSE(hidden(child));
+    EXPECT_FALSE(hidden(grandchild));
+    EXPECT_EQ(page, tabs()->GetActiveTab());
+  }
+  {
+    SCOPED_TRACE("a closed parent's children come up");
+    stedding::ExecuteTabMenuVerb(*tabs(), index(page), kFold);
+    ASSERT_TRUE(hidden(child));
+    tabs()->CloseWebContentsAt(index(page), TabCloseTypes::CLOSE_NONE);
+    EXPECT_FALSE(hidden(child));
+    EXPECT_FALSE(hidden(grandchild));
+  }
+}
