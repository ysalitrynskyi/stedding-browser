+class SidebarEdgeB26Test
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  tabs::VerticalTabStripStateController* controller() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+
+  bool Animating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+  void SettleB26() {
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+  }
+
+  // What the slide-away reads, for a check on it that fails.
+  std::string HoverStateB26() {
+    const auto yes = [](bool value) { return value ? "yes" : "no"; };
+    views::FocusManager* const focus = region()->GetFocusManager();
+    return base::StrCat(
+        {"expanded on hover ", yes(region()->is_expanded_on_hover()),
+         ", animating ", yes(Animating()), ", strip ",
+         region()->GetBoundsInScreen().ToString(), ", hidden completely ",
+         yes(region()->IsHiddenCompletely()), ", focus in the strip ",
+         yes(focus && region()->Contains(focus->GetFocusedView()))});
+  }
+
+  // Closed to nothing, with the sidebar's own switch to expand on hover off:
+  // only the edge brings it back.
+  void HideTheSidebarB26() {
+    controller()->SetExpandOnHoverEnabled(false);
+    prefs()->SetInteger(stedding::prefs::kSidebarClosedForm,
+                        stedding::prefs::kSidebarClosedHidden);
+    if (!controller()->IsCollapsed()) {
+      controller()->RequestCollapse(true);
+    }
+    SettleB26();
+    ASSERT_TRUE(controller()->IsCollapsed());
+    ASSERT_TRUE(region()->IsHiddenCompletely());
+  }
+
+  // The sidebar's edge of the browser view at mid height, in the view's own
+  // coordinates, and the same point on the screen.
+  gfx::Point LeadingEdgeB26() {
+    return gfx::Point(region()->IsOnRight() ? browser_view()->width() - 2 : 2,
+                      browser_view()->height() / 2);
+  }
+  gfx::Point ToScreenB26(gfx::Point point) {
+    views::View::ConvertPointToScreen(browser_view(), &point);
+    return point;
+  }
+  // On the page, well past the sidebar's open width, on the screen.
+  gfx::Point PastTheOpenSidebarB26() {
+    const int past = controller()->GetUncollapsedWidth() + 60;
+    return ToScreenB26(gfx::Point(
+        region()->IsOnRight() ? browser_view()->width() - past : past,
+        browser_view()->height() / 2));
+  }
+  // Out of the window, past the sidebar's edge, on the screen.
+  gfx::Point OutOfTheWindowB26() {
+    const gfx::Rect window =
+        browser_view()->GetWidget()->GetWindowBoundsInScreen();
+    return gfx::Point(
+        region()->IsOnRight() ? window.right() + 40 : window.x() - 40,
+        window.CenterPoint().y());
+  }
+
+  // The pointer rests within the edge until the sidebar slides in under it.
+  // The strip has heard no move: the pointer came there over the page.
+  void RevealB26() {
+    region()->SetHoveredForTesting(false);
+    region()->SetPointerForTesting(ToScreenB26(LeadingEdgeB26()));
+    region()->OnPointerAtForTesting(LeadingEdgeB26());
+    ASSERT_TRUE(region()->is_expanded_on_hover()) << HoverStateB26();
+  }
+
+  // Back to a hidden sidebar at rest, whatever a step left: the strip hears
+  // the pointer leave it.
+  void SlideAwayB26() {
+    region()->SetHoveredForTesting(false);
+    if (region()->is_expanded_on_hover()) {
+      const gfx::Point centre = region()->GetLocalBounds().CenterPoint();
+      region()->OnMouseExited(ui::MouseEvent(
+          ui::EventType::kMouseExited, centre, centre, base::TimeTicks::Now(),
+          ui::EF_NONE, ui::EF_NONE));
