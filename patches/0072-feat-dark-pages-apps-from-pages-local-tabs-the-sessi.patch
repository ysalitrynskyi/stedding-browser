+// local tabs Lt2: the mark follows the committed page. A typed address that
+// has not committed changes nothing; another site takes the mark away; back
+// in history brings it back; a same-document navigation keeps it; and the
+// error page of a dev server that is down is still local.
+IN_PROC_BROWSER_TEST_F(LocalTabsTest, TheMarkFollowsTheCommittedPage) {
+  tabs::TabInterface* const tab = Open(Local());
+  content::WebContents* const contents = tab->GetContents();
+  EXPECT_TRUE(Taped(tab));
+  EXPECT_EQ(LocalHost(), HostLineOf(tab));
+
+  {
+    SCOPED_TRACE("an address that has not committed");
+    content::TestNavigationManager pending(contents, Site());
+    contents->GetController().LoadURL(Site(), content::Referrer(),
+                                      ui::PAGE_TRANSITION_TYPED, std::string());
+    ASSERT_TRUE(pending.WaitForRequestStart());
+    EXPECT_TRUE(Taped(tab)) << "nothing has committed yet";
+    EXPECT_EQ(LocalHost(), HostLineOf(tab));
+    ASSERT_TRUE(pending.WaitForNavigationFinished());
+  }
+  {
+    SCOPED_TRACE("another site committed");
+    ASSERT_TRUE(content::WaitForLoadStop(contents));
+    ASSERT_EQ(Site(), contents->GetLastCommittedURL());
+    EXPECT_FALSE(Taped(tab));
+    EXPECT_EQ(u"", HostLineOf(tab));
+    EXPECT_EQ(0, TapedRows());
+  }
+  {
+    SCOPED_TRACE("back in history");
+    content::TestNavigationObserver back(contents);
+    chrome::GoBack(browser(), WindowOpenDisposition::CURRENT_TAB);
+    back.Wait();
+    ASSERT_EQ(Local(), contents->GetLastCommittedURL());
+    EXPECT_TRUE(Taped(tab));
+    EXPECT_EQ(LocalHost(), HostLineOf(tab));
+  }
+  {
+    SCOPED_TRACE("a same-document navigation");
+    ASSERT_TRUE(
+        content::ExecJs(contents, "history.pushState({}, '', '/elsewhere');"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      TabView* const row = RowNow(tab);
+      return row && row->data().last_committed_url.path() == "/elsewhere";
+    }));
+    EXPECT_TRUE(Taped(tab));
+    EXPECT_EQ(LocalHost(), HostLineOf(tab));
+  }
+  {
+    SCOPED_TRACE("a dev server that is down");
+    net::EmbeddedTestServer stopped;
+    ASSERT_TRUE(stopped.Start());
+    const GURL down = stopped.GetURL("localhost", "/title2.html");
+    ASSERT_TRUE(stopped.ShutdownAndWaitUntilComplete());
+    ui_test_utils::NavigateToURLWithDisposition(
+        browser(), down, WindowOpenDisposition::CURRENT_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP);
+    ASSERT_EQ(down, contents->GetLastCommittedURL());
+    EXPECT_TRUE(Taped(tab)) << "the error page is the local page's";
+    EXPECT_EQ(base::StrCat({u"Local: localhost:",
+                            base::NumberToString16(down.EffectiveIntPort())}),
+              DescriptionOf(tab));
+  }
+}
+
+// Lt3: the tape is on the active local row alone and moves with it: the
+// next-tab command, a click on a plain row and a click on a local one. It
+// never shows on two rows at once, and a selected row that is not the
+// active one keeps its selection fill alone.
+IN_PROC_BROWSER_TEST_F(LocalTabsTest, TheTapeFollowsTheActiveRow) {
+  tabs::TabInterface* const site = Open(Site());
+  tabs::TabInterface* const first = Open(Local("/title2.html"));
+  tabs::TabInterface* const second = Open(Local("/title3.html"));
+
+  EXPECT_TRUE(Taped(second));
+  EXPECT_FALSE(Taped(first));
+  EXPECT_EQ(1, TapedRows());
+  EXPECT_EQ(LocalHost(), HostLineOf(first))
+      << "a local row in the background keeps its host line";
+
+  {
+    // From the tab before the first local one, whichever that is.
+    SCOPED_TRACE("the next-tab command");
+    const int count = tab_strip_model()->count();
+    tab_strip_model()->ActivateTabAt((IndexOf(first) + count - 1) % count);
+    EXPECT_EQ(0, TapedRows());
+    chrome::SelectNextTab(browser());
+    ASSERT_EQ(first, tab_strip_model()->GetActiveTab());
+    EXPECT_TRUE(Taped(first));
+    EXPECT_EQ(1, TapedRows());
+  }
+  const auto click = [&](tabs::TabInterface* tab) {
+    TabView* const row = Row(tab);
+    ASSERT_TRUE(row);
+    stedding::test::ClickLeftMouse(widget(),
+                                   row->GetBoundsInScreen().CenterPoint());
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return tab_strip_model()->GetActiveTab() == tab; }));
+  };
+  {
+    SCOPED_TRACE("a click on the plain row");
+    ASSERT_NO_FATAL_FAILURE(click(site));
+    EXPECT_EQ(0, TapedRows());
+  }
+  {
+    SCOPED_TRACE("a click on the second local row");
+    ASSERT_NO_FATAL_FAILURE(click(second));
+    EXPECT_TRUE(Taped(second));
+    EXPECT_FALSE(Taped(first));
+    EXPECT_EQ(1, TapedRows());
+  }
+  {
+    SCOPED_TRACE("a selected row that is not active");
+    // SelectTabAt adds a tab to the selection and makes it the active tab:
+    // the second call brings the second tab back on screen and leaves the
+    // first one selected.
+    tab_strip_model()->SelectTabAt(IndexOf(first));
+    tab_strip_model()->SelectTabAt(IndexOf(second));
+    ASSERT_TRUE(first->IsSelected());
+    ASSERT_EQ(second, tab_strip_model()->GetActiveTab());
+    EXPECT_FALSE(Taped(first));
+    EXPECT_EQ(1, TapedRows());
+  }
+}
+
+// Lt5: a local row shows the hover card's domain -- host and port -- under
+// its title, in the title's column and colour at 85%, with room below. It
+// goes when the tab leaves for another site, and a loaded local page with no
+// title of its own, titled with its address, does not say it twice.
+IN_PROC_BROWSER_TEST_F(LocalTabsTest, ALocalRowShowsItsHostUnderTheTitle) {
+  tabs::TabInterface* const tab = Open(Local());
+  {
+    TabView* const row = Row(tab);
+    ASSERT_TRUE(row);
+    views::Label* const line = row->host_line_for_testing();
+    ASSERT_TRUE(line);
+    ASSERT_TRUE(line->IsDrawn());
+    EXPECT_EQ(LocalHost(), line->GetText());
+    const views::View* const title = row->title_for_testing();
+    EXPECT_EQ(title->x(), line->x()) << "the title's column";
+    EXPECT_EQ(title->width(), line->width());
+    EXPECT_GT(line->y(), title->bounds().CenterPoint().y()) << "under it";
+    EXPECT_LE(line->bounds().bottom(),
+              row->height() - stedding::kHostLineMinGap);
+    EXPECT_EQ(
+        stedding::HostLineColor(row->title_for_testing()->GetEnabledColor()),
+        line->GetEnabledColor());
+  }
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Site()));
+  EXPECT_EQ(u"", HostLineOf(tab)) << "another site";
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), Local("/title1.html")));
+  EXPECT_TRUE(Taped(tab)) << "still local";
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    TabView* const row = RowNow(tab);
+    return row && HostLineText(row).empty();
+  })) << "an untitled page is its address: " << HostLineOf(tab);
+}
+
+// Lt5: following a link in a dev site does not move the row. Between the
+// navigation's commit and the page's <title> the tab is titled with its
+// address; the host line stays through that, and the title does not move
+// when the page's own title arrives. A page that never names itself gives
+// the host line up once it has loaded, not before.
+IN_PROC_BROWSER_TEST_F(LocalTabsTest, TheHostLineStaysThroughANavigation) {
+  net::EmbeddedTestServer dev_server;
+  net::test_server::ControllableHttpResponse titled(&dev_server, "/next");
+  net::test_server::ControllableHttpResponse untitled(&dev_server, "/bare");
+  dev_server.ServeFilesFromSourceDirectory(GetChromeTestDataDir());
+  ASSERT_TRUE(dev_server.Start());
+  const std::u16string host = base::StrCat(
+      {u"localhost:", base::NumberToString16(dev_server.port())});
+
+  tabs::TabInterface* const tab =
+      Open(dev_server.GetURL("localhost", "/title2.html"));
+  content::WebContents* const contents = tab->GetContents();
+  ASSERT_EQ(host, HostLineOf(tab));
+  const auto title_top = [&]() {
+    TabView* const row = Row(tab);
+    return row ? row->title_for_testing()->y() : -1;
+  };
+  const int top = title_top();
+
+  // A link's navigation to `path`, committed with the page's head open and
+  // no <title> in it yet: the page is still loading.
+  const auto commit_without_title =
+      [&](net::test_server::ControllableHttpResponse& response,
+          const std::string& path) {
+        const GURL url = dev_server.GetURL("localhost", path);
+        content::TestNavigationObserver committed(contents);
+        committed.set_wait_event(
+            content::TestNavigationObserver::WaitEvent::kNavigationFinished);
+        contents->GetController().LoadURL(url, content::Referrer(),
+                                          ui::PAGE_TRANSITION_LINK,
+                                          std::string());
+        response.WaitForRequest();
+        response.Send(
+            "HTTP/1.1 200 OK\r\n"
+            "Content-Type: text/html; charset=utf-8\r\n"
+            "\r\n"
+            "<!doctype html><html><head>");
+        committed.WaitForNavigationFinished();
+        ASSERT_EQ(url, contents->GetLastCommittedURL());
+        ASSERT_TRUE(contents->IsLoading());
+        const std::u16string address =
+            base::StrCat({host, base::UTF8ToUTF16(path)});
+        ASSERT_TRUE(base::test::RunUntil([&]() {
+          TabView* const row = RowNow(tab);
+          return row && row->title_for_testing()->GetText() == address;
+        })) << "titled with its address while it loads";
+      };
+
+  {
+    SCOPED_TRACE("a page with a title");
+    ASSERT_NO_FATAL_FAILURE(commit_without_title(titled, "/next"));
+    EXPECT_EQ(host, HostLineOf(tab)) << "the host line stays through it";
+    EXPECT_EQ(top, title_top()) << "and the title does not move";
+    titled.Send("<title>Next page</title></head><body>Next</body></html>");
+    titled.Done();
+    ASSERT_TRUE(content::WaitForLoadStop(contents));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      TabView* const row = RowNow(tab);
+      return row && row->title_for_testing()->GetText() == u"Next page";
+    }));
+    EXPECT_EQ(host, HostLineOf(tab));
+    EXPECT_EQ(top, title_top()) << "the page's own title arrives in place";
+  }
+  {
+    SCOPED_TRACE("a page with no title");
+    ASSERT_NO_FATAL_FAILURE(commit_without_title(untitled, "/bare"));
+    EXPECT_EQ(host, HostLineOf(tab)) << "not taken for untitled while it loads";
+    untitled.Send("</head><body>No title</body></html>");
+    untitled.Done();
+    ASSERT_TRUE(content::WaitForLoadStop(contents));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      TabView* const row = RowNow(tab);
+      return row && HostLineText(row).empty();
+    })) << "loaded, its title is its address, which names the host already";
+  }
+}
+
+// Lt6: no row changes height for being local. At each density and at the
+// text sizes 12 and 15, a local row and a plain one are as tall, and their
+// titles start and end at the same x; the host line shows on every
+// Comfortable row and on no Compact or Dense one, inside the row with 2 DIP
+// above and below, and the favicon stays centred.
+IN_PROC_BROWSER_TEST_F(LocalTabsTest, EveryDensityKeepsTheRowHeight) {
+  tabs::TabInterface* const local = Open(Local());
+  tabs::TabInterface* const plain = Open(Site());
+  for (const int density : {0, 1, 2}) {
+    for (const int text_size : {0, 12, 15}) {
+      SCOPED_TRACE(
+          base::StrCat({"density ", base::NumberToString(density),
+                        ", text size ", base::NumberToString(text_size)}));
+      ASSERT_NO_FATAL_FAILURE(SetDensity(density, text_size));
+      TabView* const local_row = Row(local);
+      TabView* const plain_row = Row(plain);
+      ASSERT_TRUE(local_row);
+      ASSERT_TRUE(plain_row);
+      EXPECT_EQ(plain_row->height(), local_row->height());
+      EXPECT_EQ(stedding::SidebarRowHeight(), local_row->height());
+      const views::View* const local_title = local_row->title_for_testing();
+      const views::View* const plain_title = plain_row->title_for_testing();
+      EXPECT_EQ(plain_title->x(), local_title->x());
+      EXPECT_EQ(plain_title->width(), local_title->width());
+      EXPECT_EQ(plain_row->GetTabIconForTesting()->bounds(),
+                local_row->GetTabIconForTesting()->bounds());
+
+      views::Label* const line = local_row->host_line_for_testing();
+      ASSERT_TRUE(line);
+      const bool shows = density == 0;
+      EXPECT_EQ(shows, !HostLineOf(local).empty())
+          << (shows ? "Comfortable has two lines" : "one line here");
+      if (shows) {
+        const int title_text =
+            local_row->title_for_testing()->font_list().GetHeight();
+        const int text_top =
+            local_title->y() + (local_title->height() - title_text) / 2;
+        EXPECT_GE(text_top, stedding::kHostLineMinGap);
+        EXPECT_LE(line->bounds().bottom(),
+                  local_row->height() - stedding::kHostLineMinGap);
+      } else {
+        EXPECT_EQ(plain_title->y(), local_title->y())
+            << "a one-line row's title sits where a plain row's does";
+      }
+    }
+  }
+  ASSERT_NO_FATAL_FAILURE(SetDensity(0, 0));
+}
