+// site-controls Si3: Copy title writes the page's own title as plain text;
+// a page with none gives its host, never the formatted address with its
+// query; a private window's copy is marked off the record.
+TEST_F(CopyLinkTest, CopyTitleWritesThePagesTitle) {
+  Load("https://a.test/page?utm_source=mail", u"  A Page\nTitle  ");
+  EXPECT_EQ(u"A Page Title", WriteTitleToClipboard(web_contents()));
+  EXPECT_EQ(u"A Page Title", ClipboardText());
+  EXPECT_TRUE(ClipboardHtml().empty()) << "plain text only";
+  EXPECT_FALSE(clipboard()->last_write_off_the_record());
+
+  Load("https://b.test/x?utm_source=mail&fbclid=abc", u"");
+  EXPECT_EQ(u"b.test", WriteTitleToClipboard(web_contents()));
+  EXPECT_EQ(u"b.test", ClipboardText());
+
+  std::unique_ptr<content::WebContents> private_page =
+      content::WebContentsTester::CreateTestWebContents(
+          profile()->GetPrimaryOTRProfile(/*create_if_needed=*/true), nullptr);
+  Load(private_page.get(), "https://p.test/secret", u"Secret");
+  EXPECT_EQ(u"Secret", WriteTitleToClipboard(private_page.get()));
+  EXPECT_TRUE(clipboard()->last_write_off_the_record());
+
+  EXPECT_TRUE(WriteTitleToClipboard(nullptr).empty());
+}
+
 }  // namespace
 }  // namespace stedding
