+// P33-1e; toolbar T41: stacked, the row sits over the upper pane alone, one
+// surface in that page's colour as a row outside a split is, all the way to
+// its end: over a side panel's column too, which the row spans and the
+// panes do not. It was cut at the upper pane's right edge into two pieces of
+// the one colour, each with its own rounded top corners, and the window's
+// ground showed in a notch between them at the top of the row.
+IN_PROC_BROWSER_TEST_F(StackedSplitRowW2B25Test,
+                       AStackedRowIsOneSurfaceBesideASidePanel) {
+  stedding::SetDarkPagesOn(browser()->GetProfile(), false);
+  TabStripModel* const tabs = browser()->GetTabStripModel();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), PageInW2B25("112233")));
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), PageInW2B25("ee8800"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  content::WebContents* const first = tabs->GetWebContentsAt(0);
+  content::WebContents* const second = tabs->GetWebContentsAt(1);
+  tabs->ActivateTabAt(0);
+  const split_tabs::SplitTabId split =
+      tabs->AddToNewSplit({1}, split_tabs::SplitTabVisualData(),
+                          split_tabs::SplitTabCreatedSource::kTabContextMenu);
+  tabs->UpdateSplitLayout(split, split_tabs::SplitTabLayout::kStacked);
+  MultiContentsView* const multi = view()->multi_contents_view();
+  ASSERT_TRUE(multi);
+  // Both pages painted, each with its colour: a first paint that comes later
+  // reads a page's colour again.
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(view());
+    return multi->IsInSplitView() &&
+           multi->GetSplitLayout() == split_tabs::SplitTabLayout::kStacked &&
+           first->CompletedFirstVisuallyNonEmptyPaint() &&
+           second->CompletedFirstVisuallyNonEmptyPaint() &&
+           row()->ColorOf(first).has_value() &&
+           row()->ColorOf(second).has_value();
+  })) << "the premise: a stacked split, both pages with a colour";
+  const auto pane_of = [&](content::WebContents* contents) {
+    return InWindowW2B25(view(), multi->GetContentsContainerViewFor(contents));
+  };
+  const auto upper = [&]() {
+    return pane_of(first).y() <= pane_of(second).y() ? first : second;
+  };
+
+  // A side panel on the window's right, Chromium's own bookmarks.
+  browser()->GetProfile()->GetPrefs()->SetBoolean(
+      prefs::kSidePanelHorizontalAlignment, true);
+  SidePanelUI* const side_panel = SidePanelUI::From(browser());
+  ASSERT_TRUE(side_panel);
+  side_panel->SetNoDelaysForTesting(true);
+  side_panel->DisableAnimationsForTesting();
+  side_panel->Show(SidePanelEntryId::kBookmarks);
+  const float radius =
+      static_cast<float>(stedding::kContentsCornerRadius.Get());
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    views::test::RunScheduledLayout(view());
+    return side_panel->IsSidePanelShowing() &&
+           stedding::PageBarSurface(view()).right() >
+               pane_of(upper()).right() + 3 * radius;
+  })) << "the premise: with the side panel open the row runs on past the "
+         "upper pane; the row is at "
+      << stedding::PageBarSurface(view()).ToString()
+      << ", the upper pane at " << pane_of(upper()).ToString();
+
+  const gfx::RectF surface = stedding::PageBarSurface(view());
+  const gfx::RectF pane = pane_of(upper());
+  const SkColor colour = *row()->ColorOf(upper());
+  gfx::Canvas canvas(view()->size(), 1.0f, /*is_opaque=*/true);
+  view()->background()->Paint(&canvas, view());
+  const SkBitmap& painted = canvas.GetBitmap();
+  // Just under the row's top edge, where a rounded corner leaves the ground.
+  const int y = base::ClampCeil(surface.y()) + 2;
+  const int middle = base::ClampRound(pane.CenterPoint().x());
+  ASSERT_EQ(colour, painted.getColor(middle, y))
+      << "the premise: over the upper pane's middle the row is "
+      << color_utils::SkColorToRgbaString(painted.getColor(middle, y))
+      << ", not its page's " << color_utils::SkColorToRgbaString(colour);
+  const int edge = base::ClampRound(pane.right());
+  for (const int x : {edge - 1, edge, edge + 1}) {
+    EXPECT_EQ(colour, painted.getColor(x, y))
+        << "at x " << x << ", by the upper pane's right edge at "
+        << pane.right() << ", the top of the row is "
+        << color_utils::SkColorToRgbaString(painted.getColor(x, y))
+        << ", not its page's " << color_utils::SkColorToRgbaString(colour);
+  }
+}
