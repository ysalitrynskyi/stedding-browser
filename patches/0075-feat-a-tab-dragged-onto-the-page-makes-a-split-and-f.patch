+// toolbar T39: the chord opens the bar on the extension rows alone, the first
+// chosen; each further press of it, and the chord's Down, chooses the next,
+// and its Up the one before, wrapping; letting go of the modifier runs the
+// chosen one. Escape closes the bar and runs nothing; a tap runs the first.
+TEST_F(ExtensionRowsTest, TheExtensionsChordCyclesAndReleaseRuns) {
+  AddTab(browser(), GURL("https://example.com/"));
+  const auto scoped_rows = SetExtensionActionRowsForTesting(&rows_);
+  views::View host;
+  const auto scoped_host = CommandBarView::SetHostForTesting(&host);
+
+  {
+    SCOPED_TRACE("press, press again, the arrows, let go");
+    CommandBarView* const bar = PressTheChord(host);
+    ASSERT_TRUE(bar);
+    EXPECT_EQ(CommandBarView::Mode::kActions, bar->mode_for_testing());
+    EXPECT_EQ((std::vector<std::u16string>{u"Alpha", u"Beta", u"Gamma"}),
+              Titles(*bar));
+    EXPECT_EQ(0u, bar->selected_row_for_testing());
+    EXPECT_TRUE(bar->holding_chord_for_testing());
+    EXPECT_EQ(bar, PressTheChord(host));
+    EXPECT_EQ(1u, bar->selected_row_for_testing());
+    PressTheChord(host);
+    EXPECT_EQ(2u, bar->selected_row_for_testing());
+    PressTheChord(host);
+    EXPECT_EQ(0u, bar->selected_row_for_testing()) << "wraps to the first";
+    EXPECT_TRUE(
+        bar->AcceleratorPressed(ui::Accelerator(ui::VKEY_UP, kChordModifiers)));
+    EXPECT_EQ(2u, bar->selected_row_for_testing()) << "wraps to the last";
+    EXPECT_TRUE(bar->AcceleratorPressed(
+        ui::Accelerator(ui::VKEY_DOWN, kChordModifiers)));
+    EXPECT_EQ(0u, bar->selected_row_for_testing());
+    EXPECT_TRUE(bar->AcceleratorPressed(
+        ui::Accelerator(ui::VKEY_DOWN, kChordModifiers)));
+    EXPECT_TRUE(runs_.empty()) << "nothing runs while the chord is held";
+    bar->OnHeldChordEvent(ChordKeyReleased());
+    EXPECT_EQ(std::vector<std::u16string>{u"Beta"}, runs_);
+    EXPECT_TRUE(bar->closing_for_testing());
+    base::RunLoop().RunUntilIdle();
+    EXPECT_FALSE(CommandBarView::GetOpenBar(&host));
+  }
+  runs_.clear();
+  {
+    SCOPED_TRACE("Escape with the modifier down");
+    CommandBarView* const bar = PressTheChord(host);
+    ASSERT_TRUE(bar);
+    PressTheChord(host);
+    EXPECT_TRUE(bar->AcceleratorPressed(
+        ui::Accelerator(ui::VKEY_ESCAPE, kChordModifiers)));
+    EXPECT_TRUE(bar->closing_for_testing());
+    bar->OnHeldChordEvent(ChordKeyReleased());
+    EXPECT_TRUE(runs_.empty());
+    base::RunLoop().RunUntilIdle();
+  }
+#if BUILDFLAG(IS_MAC)
+  {
+    // macOS 27 lists Cmd-Escape among its system shortcuts; Cmd-Period is
+    // the Mac's cancel.
+    SCOPED_TRACE("Cmd-Period with the modifier down");
+    CommandBarView* const bar = PressTheChord(host);
+    ASSERT_TRUE(bar);
+    PressTheChord(host);
+    EXPECT_TRUE(bar->AcceleratorPressed(
+        ui::Accelerator(ui::VKEY_OEM_PERIOD, ui::EF_COMMAND_DOWN)));
+    EXPECT_TRUE(bar->closing_for_testing());
+    bar->OnHeldChordEvent(ChordKeyReleased());
+    EXPECT_TRUE(runs_.empty());
+    base::RunLoop().RunUntilIdle();
+  }
+#endif
+  {
+    SCOPED_TRACE("a tap runs the first");
+    CommandBarView* const bar = PressTheChord(host);
+    ASSERT_TRUE(bar);
+    bar->OnHeldChordEvent(ChordKeyReleased());
+    EXPECT_EQ(std::vector<std::u16string>{u"Alpha"}, runs_);
+    base::RunLoop().RunUntilIdle();
+  }
+  runs_.clear();
+  {
+    SCOPED_TRACE("a key without the modifier ends the hold; the bar stays");
+    CommandBarView* const bar = PressTheChord(host);
+    ASSERT_TRUE(bar);
+    bar->OnHeldChordEvent(Press(ui::VKEY_B));
+    EXPECT_FALSE(bar->holding_chord_for_testing());
+    bar->OnHeldChordEvent(ChordKeyReleased());
+    EXPECT_TRUE(runs_.empty());
+    EXPECT_FALSE(bar->closing_for_testing());
+    // Plain Escape closes the chord's bar too, without a stop in tabs mode.
+    EXPECT_TRUE(
+        bar->AcceleratorPressed(ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE)));
+    EXPECT_TRUE(bar->closing_for_testing());
+    base::RunLoop().RunUntilIdle();
+  }
+  {
+    SCOPED_TRACE("the chord on a bar already open lists the extensions");
+    CommandBarView::Show(browser(), CommandBarView::Mode::kTabs);
+    CommandBarView* const bar = CommandBarView::GetOpenBar(&host);
+    ASSERT_TRUE(bar);
+    bar->ContentsChanged(bar->field_for_testing(), u"example");
+    EXPECT_EQ(bar, PressTheChord(host));
+    EXPECT_EQ((std::vector<std::u16string>{u"Alpha", u"Beta", u"Gamma"}),
+              Titles(*bar));
+    EXPECT_TRUE(bar->field_for_testing()->GetText().empty());
+    EXPECT_TRUE(bar->holding_chord_for_testing());
+    bar->Close();
+    base::RunLoop().RunUntilIdle();
+  }
+}
