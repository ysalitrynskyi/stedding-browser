+// updates Up25 (BACKLOG S-420): a download the user is watching that fails or
+// stalls starts over ten seconds later, and the page goes on saying Updating.
+// Only the third failure is said, in Stedding's words: Sparkle's end in "try
+// again later", and the About page goes on to say how to try now.
+TEST_F(AppUpdaterMacTest, AWatchedDownloadGetsThreeTriesBeforeItFails) {
+  Launch(base::Hours(2));
+  updater_->CheckNow();
+  ASSERT_TRUE(Driver());
+  ASSERT_EQ(1, sparkle_.user_checks);
+  for (int tries = 1; tries < kUpdateDownloadTries; ++tries) {
+    SCOPED_TRACE(tries);
+    FindForTheUser();
+    ASSERT_EQ(AppUpdater::State::kDownloading, updater_->state());
+    EndWatchedAttempt(SparkleError(kDownloadError), /*download_failed=*/true);
+    EXPECT_EQ(AppUpdater::State::kDownloading, updater_->state());
+    EXPECT_TRUE(updater_->error().empty());
+    EXPECT_EQ(0, updater_->progress()) << "the next try starts from nothing";
+    task_environment_.FastForwardBy(kUpdateDownloadRetryDelay -
+                                    base::Seconds(1));
+    EXPECT_EQ(tries, sparkle_.user_checks) << "too soon";
+    task_environment_.FastForwardBy(base::Seconds(1));
+    EXPECT_EQ(tries + 1, sparkle_.user_checks);
+  }
+  FindForTheUser();
+  EndWatchedAttempt(SparkleError(kDownloadError), /*download_failed=*/true);
+  EXPECT_EQ(AppUpdater::State::kFailed, updater_->state());
+  EXPECT_EQ(u"The new version could not be downloaded.", updater_->error());
+  task_environment_.FastForwardBy(base::Hours(1));
+  EXPECT_EQ(kUpdateDownloadTries, sparkle_.user_checks);
+
+  // The About page's next check is a new attempt with its own three tries.
+  updater_->CheckNow();
+  EXPECT_EQ(kUpdateDownloadTries + 1, sparkle_.user_checks);
+  FindForTheUser();
+  EndWatchedAttempt(SparkleError(kDownloadError), /*download_failed=*/true);
+  EXPECT_EQ(AppUpdater::State::kDownloading, updater_->state());
+}
