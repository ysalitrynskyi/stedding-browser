+// welcome W2 (BACKLOG S-349): an engine id the step's list does not hold is
+// dropped while Chromium's chooser is live; its choice service stopped the
+// browser on one (a CHECK), which any script on the page could send. A
+// tile's own id, sent after them, still sets the engine.
+IN_PROC_BROWSER_TEST_P(WelcomeChooserTest, AnIdOffTheListIsDropped) {
+  Profile* const profile = browser()->GetProfile();
+  ASSERT_TRUE(SearchEngineChoiceDialogServiceFactory::GetForProfile(profile))
+      << "Chromium builds no chooser for this profile";
+  TemplateURLService* const template_urls =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  ASSERT_TRUE(template_urls);
+  search_test_utils::WaitForTemplateURLServiceToLoad(template_urls);
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  ASSERT_TRUE(PastTheWelcomeScreen(page));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(page,
+                           "document.querySelectorAll('main .tile').length")
+               .ExtractInt() > 0;
+  }));
+  const auto default_id = [&]() {
+    const TemplateURL* const current =
+        template_urls->GetDefaultSearchProvider();
+    return current ? current->prepopulate_id() : -1;
+  };
+  // A tile whose engine is not the one searches go to now.
+  const std::string ids = content::EvalJs(page, R"(
+      [...document.querySelectorAll('main .tile')]
+          .map(tile => tile.dataset.focus.replace('engine-', ''))
+          .join(','))")
+                              .ExtractString();
+  int pick = -1;
+  for (const std::string& id : base::SplitString(
+           ids, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    int value = 0;
+    if (base::StringToInt(id, &value) && value != default_id()) {
+      pick = value;
+      break;
+    }
+  }
+  ASSERT_GT(pick, 0) << ids;
+
+  // No engine, and one past every built-in engine; then the tile, whose
+  // message the browser reads after theirs.
+  ASSERT_TRUE(content::ExecJs(page,
+                              "chrome.send('setSearchEngine', [0]);"
+                              "chrome.send('setSearchEngine', [999999]);"));
+  ASSERT_TRUE(content::ExecJs(
+      page, content::JsReplace(
+                "document.querySelector("
+                "    'main [data-focus=\"engine-' + $1 + '\"]').click()",
+                pick)));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return default_id() == pick; }))
+      << "the tile did not set the engine";
+}
