   PointerRestingAt& operator=(const PointerRestingAt&) = delete;
   ~PointerRestingAt() override {
+#if defined(USE_AURA)
+    aura::Env::GetInstance()->SetLastMouseLocation(real_mouse_location_);
+#endif
+    ui::PlatformEventSource::SetIgnoreNativePlatformEvents(
+        ignored_native_events_);
     display::Screen::SetScreenInstance(nullptr);
     display::Screen::SetScreenInstance(real_);
   }
@@ -220,6 +247,10 @@ class PointerRestingAt : public display::Screen {
  private:
