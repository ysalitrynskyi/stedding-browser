@@ -0,0 +1,147 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/tab_parents.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_interface.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// Rows in one run that nest up to the full depth.
+NestRow Row(std::string token, std::string parent, uintptr_t run = 0) {
+  return {std::move(token), std::move(parent), run, kMaxNestDepth};
+}
+
+// tabs R57: a child sits one level under its parent, a grandchild two, and a
+// second child of the same parent comes back to the first child's level.
+TEST(TabParentsTest, ChildrenNestUnderTheirParent) {
+  EXPECT_EQ((std::vector<int>{0, 1, 2, 1, 0}),
+            NestDepths({Row("p", ""), Row("c1", "p"), Row("g", "c1"),
+                        Row("c2", "p"), Row("q", "")}));
+}
+
+// R57: a child nests only while every row between it and its parent
+// descends from the parent: a row of its own, or one moved in between, puts
+// the child back at the left.
+TEST(TabParentsTest, ARowBetweenPartsAChildFromItsParent) {
+  EXPECT_EQ((std::vector<int>{0, 0, 0}),
+            NestDepths({Row("p", ""), Row("x", ""), Row("c", "p")}));
+  // Another parent's child in between parts it too.
+  EXPECT_EQ((std::vector<int>{0, 0, 1, 0}),
+            NestDepths({Row("p", ""), Row("q", ""), Row("d", "q"),
+                        Row("c", "p")}));
+}
+
+// R59: a child whose parent is gone, or in another run (a folder), sits at
+// the left.
+TEST(TabParentsTest, AChildWithoutItsParentBesideItSitsAtTheLeft) {
+  EXPECT_EQ((std::vector<int>{0, 0}),
+            NestDepths({Row("x", ""), Row("c", "closed")}));
+  constexpr uintptr_t kStrip = 1;
+  constexpr uintptr_t kFolder = 2;
+  EXPECT_EQ((std::vector<int>{0, 0}),
+            NestDepths({Row("p", "", kStrip), Row("c", "p", kFolder)}));
+  // In one folder they nest as in the strip.
+  EXPECT_EQ((std::vector<int>{0, 1}),
+            NestDepths({Row("p", "", kFolder), Row("c", "p", kFolder)}));
+}
+
+// R57: folders and children share one depth: a row at its limit has its
+// children beside it.
+TEST(TabParentsTest, ARowAtItsLimitHasItsChildrenBesideIt) {
+  std::vector<NestRow> rows = {Row("a", "")};
+  for (int i = 1; i <= kMaxNestDepth + 2; ++i) {
+    rows.push_back(Row("t" + std::to_string(i),
+                       i == 1 ? "a" : "t" + std::to_string(i - 1)));
+  }
+  std::vector<int> want = {0};
+  for (int i = 1; i <= kMaxNestDepth + 2; ++i) {
+    want.push_back(std::min(i, kMaxNestDepth));
+  }
+  EXPECT_EQ(want, NestDepths(rows));
+
+  // Two folders deep, a child may go three levels further.
+  std::vector<NestRow> deep;
+  for (int i = 0; i < 6; ++i) {
+    deep.push_back({"d" + std::to_string(i),
+                    i ? "d" + std::to_string(i - 1) : "", /*run=*/2,
+                    kMaxNestDepth - 2});
+  }
+  EXPECT_EQ((std::vector<int>{0, 1, 2, 3, 3, 3}), NestDepths(deep));
+}
+
+class TabParentsStripTest : public BrowserWithTestWindowTest {
+ protected:
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+  tabs::TabInterface* Open(const char* url) {
+    AddTab(browser(), GURL(url));
+    return tabs().GetActiveTab();
+  }
+};
+
+// R56, R58: a parent gets a token once, its children keep it, and a
+// restored tab reads both back from the session's extra data.
+TEST_F(TabParentsStripTest, ParentsGetATokenAndRestoreReadsBoth) {
+  tabs::TabInterface* const parent = Open("https://example.com/");
+  tabs::TabInterface* const first = Open("https://example.com/1");
+  tabs::TabInterface* const second = Open("https://example.com/2");
+  EXPECT_EQ("", TabToken(parent->GetContents()));
+  SetTabParent(browser(), first, parent);
+  const std::string token = TabToken(parent->GetContents());
+  EXPECT_FALSE(token.empty());
+  SetTabParent(browser(), second, parent);
+  EXPECT_EQ(token, TabToken(parent->GetContents())) << "one token a parent";
+  EXPECT_EQ(token, TabParentToken(first->GetContents()));
+  EXPECT_EQ(token, TabParentToken(second->GetContents()));
+
+  tabs::TabInterface* const restored = Open("https://example.com/r");
+  RestoreTabParentFromExtraData(restored->GetContents(), {{"other", "x"}});
+  EXPECT_EQ("", TabParentToken(restored->GetContents()));
+  RestoreTabParentFromExtraData(
+      restored->GetContents(),
+      {{kSessionTabTokenKey, "own"}, {kSessionTabParentKey, token}});
+  EXPECT_EQ("own", TabToken(restored->GetContents()));
+  EXPECT_EQ(token, TabParentToken(restored->GetContents()));
+}
+
+// R59: when a parent closes, its children take its own parent, and a top
+// level parent's children go to the left.
+TEST_F(TabParentsStripTest, AClosedParentsChildrenMoveUp) {
+  tabs::TabInterface* const root = Open("https://example.com/");
+  tabs::TabInterface* const middle = Open("https://example.com/m");
+  tabs::TabInterface* const leaf = Open("https://example.com/l");
+  SetTabParent(browser(), middle, root);
+  SetTabParent(browser(), leaf, middle);
+  ReparentChildrenOf(browser(), middle->GetContents());
+  EXPECT_EQ(TabToken(root->GetContents()), TabParentToken(leaf->GetContents()));
+  ReparentChildrenOf(browser(), root->GetContents());
+  EXPECT_EQ("", TabParentToken(leaf->GetContents()));
+  EXPECT_EQ("", TabParentToken(middle->GetContents()));
+}
+
+// sessions S9: new contents in a tab's place (a jar change, a pin's reset)
+// keep its place in the tree.
+TEST_F(TabParentsStripTest, ReplacedContentsKeepTheirPlace) {
+  tabs::TabInterface* const parent = Open("https://example.com/");
+  tabs::TabInterface* const child = Open("https://example.com/c");
+  tabs::TabInterface* const other = Open("https://example.com/o");
+  SetTabParent(browser(), child, parent);
+  CarryTabParent(child->GetContents(), other->GetContents());
+  EXPECT_EQ(TabToken(parent->GetContents()),
+            TabParentToken(other->GetContents()));
+}
