@@ -0,0 +1,58 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_STEDDING_ARCHIVE_STEDDING_ARCHIVE_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_STEDDING_ARCHIVE_STEDDING_ARCHIVE_HANDLER_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "components/sessions/core/tab_restore_service.h"
+#include "components/sessions/core/tab_restore_service_observer.h"
+#include "content/public/browser/web_ui_message_handler.h"
+
+class BrowserWindowInterface;
+
+namespace stedding {
+
+// The page's messages (docs/features/archive.md A9):
+//   getArchivedTabs(callback) -> {tabs: [...], spaces: [{id, name}]}
+//   restoreArchivedTab(id), removeArchivedTab(id), clearArchive()
+// and the listener "archive-changed" when Chromium's list changes.
+class ArchiveHandler : public content::WebUIMessageHandler,
+                       public sessions::TabRestoreServiceObserver {
+ public:
+  ArchiveHandler();
+  ArchiveHandler(const ArchiveHandler&) = delete;
+  ArchiveHandler& operator=(const ArchiveHandler&) = delete;
+  ~ArchiveHandler() override;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // sessions::TabRestoreServiceObserver:
+  void TabRestoreServiceChanged(sessions::TabRestoreService* service) override;
+  void TabRestoreServiceDestroyed(
+      sessions::TabRestoreService* service) override;
+
+ private:
+  BrowserWindowInterface* GetBrowser();
+  sessions::TabRestoreService* GetService();
+  base::DictValue Snapshot();
+
+  void HandleGetArchivedTabs(const base::ListValue& args);
+  void HandleRestoreArchivedTab(const base::ListValue& args);
+  void HandleRemoveArchivedTab(const base::ListValue& args);
+  void HandleClearArchive(const base::ListValue& args);
+
+  base::ScopedObservation<sessions::TabRestoreService,
+                          sessions::TabRestoreServiceObserver>
+      observation_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_WEBUI_STEDDING_ARCHIVE_STEDDING_ARCHIVE_HANDLER_H_
