+// shortcuts Z24 (BACKLOG S-157): Cmd-D in a private window, which has no
+// Spaces, bookmarks the page as Chromium's does, pressed the way the keyboard
+// sends it, through the application's event queue and the main menu. The
+// Spaces menu's pin row, which carries the chord, was enabled only in a window
+// with Spaces, so the press found it disabled and did nothing: seen on the
+// notarized 0.4.0 beta 17 (2026-11-10), where Ctrl+D on Windows worked.
+IN_PROC_BROWSER_TEST_F(SpaceKeysTest, CmdDBookmarksThePageInAPrivateWindow) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL page = embedded_test_server()->GetURL("/title1.html");
+  BrowserWindowInterface* const incognito = CreateIncognitoBrowser();
+  ASSERT_TRUE(incognito);
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(incognito, page));
+  bookmarks::BookmarkModel* const bookmarks =
+      BookmarkModelFactory::GetForBrowserContext(browser()->GetProfile());
+  bookmarks::test::WaitForBookmarkModelToLoad(bookmarks);
+  ASSERT_FALSE(bookmarks->IsBookmarked(page));
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(incognito);
+  ASSERT_TRUE(view);
+  view->GetWidget()->Activate();
+  ASSERT_TRUE(base::test::RunUntil([&]() { return view->GetWidget()->IsActive(); }))
+      << "the private window never became the active one";
+  NSWindow* const window =
+      view->GetWidget()->GetNativeWindow().GetNativeNSWindow();
+  const auto post = [&](ui::KeyboardCode key, bool down, NSUInteger flags) {
+    NSEvent* const event =
+        cocoa_test_event_utils::SynthesizeKeyEvent(window, down, key, flags);
+    ASSERT_TRUE(event);
+    [NSApp postEvent:event atStart:NO];
+  };
+  post(ui::VKEY_COMMAND, true, NSEventModifierFlagCommand);
+  post(ui::VKEY_D, true, NSEventModifierFlagCommand);
+  post(ui::VKEY_D, false, NSEventModifierFlagCommand);
+  post(ui::VKEY_COMMAND, false, 0);
+  EXPECT_TRUE(base::test::RunUntil([&]() { return bookmarks->IsBookmarked(page); }))
+      << "Cmd-D in a private window bookmarked nothing";
+}
