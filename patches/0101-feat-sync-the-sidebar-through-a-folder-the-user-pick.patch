+#ifndef CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_FILE_H_
+#define CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_FILE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/files/file_path.h"
+#include "chrome/browser/ui/spaces/arc_sidebar_importer.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_state.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+// docs/features/sidebar-file.md Sf8, Sf12, Sf28-Sf30, Sf33, Sf34, Sf38: the
+// files in the folder the user picked. Each install writes one, under its
+// own name; every other is read, never trusted, and parsed off the UI
+// thread.
+namespace spaces::sidebar_sync {
+
+// A file is at most this large, and holds at most this many records (Sf33).
+inline constexpr size_t kMaxFileBytes = 4 * 1024 * 1024;
+inline constexpr size_t kMaxRecords = 5000;
+inline constexpr size_t kMaxTextLength = 256;
+inline constexpr size_t kMaxUrlLength = 8 * 1024;
+
+// The folder made inside the one the user picked (Sf8).
+inline constexpr char kSyncFolderName[] = "Stedding Sidebar";
+inline constexpr char kFilePrefix[] = "stedding-sidebar-";
+
+// 16 lowercase hex characters.
+bool IsInstallId(std::string_view id);
+std::string MakeInstallId();
+// "stedding-sidebar-<install>.json".
+std::string FileNameFor(std::string_view install);
+// Sf9: "Mac" or "Windows PC" and four hex characters of the install id; the
+// computer's own name is never written unless the user types it.
+std::string DefaultDeviceName(std::string_view install);
+
+// Sf8: the folder the files live in: `picked` itself when it already is a
+// "Stedding Sidebar" folder or holds sidebar files, else "Stedding Sidebar"
+// inside it.
+base::FilePath SyncDirFor(const base::FilePath& picked,
+                          bool picked_holds_sidebar_files);
+
+// Sf28: what a name in the folder is.
+enum class EntryKind {
+  // This install's own file.
+  kOwn,
+  // Another install's file, read and merged.
+  kPeer,
+  // A copy a sync tool made of a file ("stedding-sidebar-<id> 2.json",
+  // ".sync-conflict-", "(conflicted copy)", "-COMPUTER", "(1)"): named in
+  // Settings, never applied, never deleted.
+  kConflictCopy,
+  // Anything else: temporary files, ".icloud" stubs, other files.
+  kIgnore,
+};
+EntryKind ClassifyFolderEntry(std::string_view name,
+                              std::string_view own_install);
+// The install id a peer's name carries; empty for any other name.
+std::string InstallOfName(std::string_view name);
+
+// "#RRGGBB" and back.
+std::string ColorToText(SkColor color);
+std::optional<SkColor> ColorFromHex(std::string_view text);
+
+// The "stedding_sync" block's own fields.
+struct FileMeta {
+  FileMeta();
+  FileMeta(const FileMeta& other);
+  FileMeta& operator=(const FileMeta& other);
+  ~FileMeta();
+
+  int format = kFormat;
+  std::string install;
+  std::string device;
+  int64_t seq = 0;
+  std::string nonce;
+  int64_t written_ms = 0;
+  int64_t hlc = 0;
+  int64_t joined_ms = 0;
+};
+
+enum class ParseStatus {
+  kOk,
+  // Sf34: a later Stedding wrote it; its name and device are read.
+  kNewerFormat,
+  // A sidebar file with no sync block: an export, not a peer.
+  kNotOurs,
+  kTooLarge,
+  kMalformed,
+};
+
+struct ParsedFile {
+  ParsedFile();
+  ParsedFile(const ParsedFile& other);
+  ParsedFile(ParsedFile&& other);
+  ParsedFile& operator=(const ParsedFile& other);
+  ParsedFile& operator=(ParsedFile&& other);
+  ~ParsedFile();
+
+  ParseStatus status = ParseStatus::kMalformed;
+  FileMeta meta;
+  State state;
+};
+
+// Sf33, Sf34: the whole file or nothing. Every id, parent, list and length
+// is checked; a home that is no web page is dropped; a parent cycle, a
+// folder nested past kMaxNestDepth or an id twice in a list refuses the
+// file.
+ParsedFile ParseSyncFile(std::string_view json);
+
+// Sf38: the ledger as the Export all Spaces format, which Import sidebar…
+// reads on a computer that does not sync.
+ArcImportPlan LedgerToPlan(const State& state);
+
+// Sf12, Sf38: the file an install writes: the plan's body and the
+// "stedding_sync" block.
+std::string SerializeSyncFile(const State& state, const FileMeta& meta);
+
+// Sf30: whether `path` is a file a cloud provider has not downloaded
+// (iCloud Drive's dataless files on the Mac, OneDrive's placeholders on
+// Windows). Blocking.
+bool IsPlaceholderFile(const base::FilePath& path);
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_FILE_H_
