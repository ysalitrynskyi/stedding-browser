@@ -0,0 +1,126 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/tab_names.h"
+
+#include <memory>
+#include <string>
+#include <tuple>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/sessions/stedding_session_rebuild.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/sessions/content/session_tab_helper.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+namespace stedding {
+namespace {
+
+// The name rides on the WebContents, so it follows the tab through pin and
+// unpin (R17) and is there before the TabInterface exists on restore.
+class TabNameData : public content::WebContentsUserData<TabNameData> {
+ public:
+  ~TabNameData() override = default;
+
+  const std::u16string& name() const { return name_; }
+  void set_name(std::u16string name) { name_ = std::move(name); }
+
+ private:
+  friend class content::WebContentsUserData<TabNameData>;
+  TabNameData(content::WebContents* contents, std::u16string name)
+      : content::WebContentsUserData<TabNameData>(*contents),
+        name_(std::move(name)) {}
+
+  std::u16string name_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(TabNameData);
+
+void AppendRebuildCommands(BrowserWindowInterface* browser,
+                           SessionRebuildCommands* commands) {
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  for (int i = 0; i < tabs->count(); ++i) {
+    content::WebContents* const contents = tabs->GetWebContentsAt(i);
+    const std::u16string name = TabName(contents);
+    if (name.empty()) {
+      continue;
+    }
+    const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+    if (!tab_id.is_valid()) {
+      continue;
+    }
+    commands->push_back(sessions::CreateAddTabExtraDataCommand(
+        tab_id, kSessionTabNameKey, base::UTF16ToUTF8(name)));
+  }
+}
+
+}  // namespace
+
+std::u16string TabName(const content::WebContents* contents) {
+  const TabNameData* const data =
+      contents ? TabNameData::FromWebContents(contents) : nullptr;
+  return data ? data->name() : std::u16string();
+}
+
+void SetTabName(BrowserWindowInterface* browser,
+                tabs::TabInterface* tab,
+                std::u16string name) {
+  content::WebContents* const contents = tab ? tab->GetContents() : nullptr;
+  if (!contents) {
+    return;
+  }
+  TabNameData* const data = TabNameData::FromWebContents(contents);
+  if (name.empty()) {
+    if (data) {
+      contents->RemoveUserData(TabNameData::UserDataKey());
+    }
+  } else if (data) {
+    data->set_name(name);
+  } else {
+    TabNameData::CreateForWebContents(contents, name);
+  }
+  // Written now and re-emitted on every rebuild (R16); an empty value clears
+  // the key for a restore that reads this log before the next rebuild.
+  SessionService* const session_service =
+      browser ? SessionServiceFactory::GetForProfile(browser->GetProfile())
+              : nullptr;
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (session_service && tab_id.is_valid()) {
+    session_service->AddTabExtraData(browser->GetSessionID(), tab_id,
+                                     kSessionTabNameKey,
+                                     base::UTF16ToUTF8(name));
+  }
+}
+
+void RestoreTabNameFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data) {
+  const auto it = extra_data.find(kSessionTabNameKey);
+  if (it == extra_data.end() || it->second.empty() || !contents) {
+    return;
+  }
+  TabNameData::CreateForWebContents(contents, base::UTF8ToUTF16(it->second));
+}
+
+void RegisterTabNameSessionRebuild() {
+  static const bool registered = [] {
+    AddSessionRebuildProvider("tab_names",
+                              base::BindRepeating(&AppendRebuildCommands));
+    return true;
+  }();
+  std::ignore = registered;
+}
+
+}  // namespace stedding
