+#include "components/bookmarks/test/bookmark_test_helpers.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+class BookmarksToPinsTest : public BrowserWithTestWindowTest {
+ protected:
+  TestingProfile::TestingFactories GetTestingFactories() override {
+    return {TestingProfile::TestingFactory{
+        BookmarkModelFactory::GetInstance(),
+        BookmarkModelFactory::GetDefaultFactory()}};
+  }
+
+  bookmarks::BookmarkModel* model() {
+    bookmarks::BookmarkModel* const model =
+        BookmarkModelFactory::GetForBrowserContext(profile());
+    bookmarks::test::WaitForBookmarkModelToLoad(model);
+    return model;
+  }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+};
+
+// I13: the bar's bookmarks first, folders nested, every bookmark a pin.
+TEST_F(BookmarksToPinsTest, FolderTreeBecomesPinnedFolders) {
+  bookmarks::BookmarkModel* const bookmarks = model();
+  const bookmarks::BookmarkNode* const bar = bookmarks->bookmark_bar_node();
+  const bookmarks::BookmarkNode* const docs =
+      bookmarks->AddFolder(bar, 0, u"Docs");
+  bookmarks->AddURL(docs, 0, u"A", GURL("https://a.example/"));
+  bookmarks->AddURL(bar, 1, u"B", GURL("https://b.example/"));
+  bookmarks->AddURL(bookmarks->other_node(), 0, u"C",
+                    GURL("https://c.example/"));
+  bookmarks->AddFolder(bar, 2, u"Empty");
+
+  const std::vector<spaces::ArcImportPlan::Node> nodes =
+      NodesFromBookmarks(*bookmarks);
+  ASSERT_EQ(3u, nodes.size()) << "the empty folder is skipped";
+  EXPECT_EQ(spaces::ArcImportPlan::Node::Kind::kFolder, nodes[0].kind);
+  EXPECT_EQ(u"Docs", nodes[0].title);
+  EXPECT_EQ(u"B", nodes[1].title);
+  EXPECT_EQ(u"C", nodes[2].title) << "Other bookmarks after the bar";
+
+  const spaces::ArcImportResult result = ConvertBookmarksToPins(browser());
+  EXPECT_EQ(3u, result.tabs);
+  EXPECT_EQ(1u, result.folders);
+  spaces::SpaceModel& spaces = *spaces::SpaceModel::From(browser());
+  int pinned = 0;
+  int in_folder = 0;
+  for (int i = 0; i < tabs().count(); ++i) {
+    tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+    if (spaces.IsSpacePinned(tab)) {
+      ++pinned;
+      EXPECT_TRUE(spaces.HomeUrl(tab).has_value()) << "pins H1";
+    }
+    const tabs::TabCollection* const parent = tab->GetParentCollection();
+    if (parent && parent->type() == tabs::TabCollection::Type::FOLDER) {
+      ++in_folder;
+      EXPECT_EQ("Docs",
+                static_cast<const tabs::FolderTabCollection*>(parent)->title());
+    }
+    EXPECT_TRUE(tab->GetContents()->WasDiscarded()) << "unloaded (I3)";
+  }
+  EXPECT_EQ(2, pinned) << "B and C are Space-pinned";
+  EXPECT_EQ(1, in_folder) << "A sits in the Docs folder";
+
+  const spaces::ArcImportResult again = ConvertBookmarksToPins(browser());
+  EXPECT_EQ(0u, again.tabs) << "idempotent on the bookmark ids";
+  EXPECT_EQ(0u, again.folders);
+}
+
+// I14: the conversion hides the bookmark bar and the star from then on.
+TEST_F(BookmarksToPinsTest, ConversionHidesTheBar) {
+  model();
+  EXPECT_FALSE(profile()->GetPrefs()->GetBoolean(prefs::kBookmarksConverted));
+  ConvertBookmarksToPins(browser());
+  EXPECT_TRUE(profile()->GetPrefs()->GetBoolean(prefs::kBookmarksConverted));
+}
+
+}  // namespace
+}  // namespace stedding
