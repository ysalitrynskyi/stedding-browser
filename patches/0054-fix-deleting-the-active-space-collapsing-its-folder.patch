+bool FolderView::HoldsActiveTab(const views::View* child) const {
+  if (auto* const tab_view = views::AsViewClass<TabView>(child)) {
+    const tabs::TabInterface* const tab = tab_view->GetTabInterface();
+    return tab && tab->IsActivated();
+  }
+  if (auto* const nested = views::AsViewClass<FolderView>(child)) {
+    tabs::FolderTabCollection* const inner = nested->folder();
+    if (!inner) {
+      return false;
+    }
+    for (tabs::TabInterface* const tab : inner->GetTabsRecursive()) {
+      if (tab && tab->IsActivated()) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
 void FolderView::ApplyCollapsed() {
   tabs::FolderTabCollection* const f = folder();
   if (!f) {
     return;
   }
-  const bool collapsed = f->collapsed();
+  ApplyChildren(f->collapsed());
+  UpdateHeader();
+  PreferredSizeChanged();
+}
+
+void FolderView::ApplyChildren(bool only_active) {
   for (views::View* child : children()) {
-    if (child != header_) {
-      child->SetVisible(!collapsed);
+    if (child == header_) {
+      continue;
+    }
+    if (!only_active) {
+      child->SetVisible(true);
+      if (auto* const nested = views::AsViewClass<FolderView>(child)) {
+        nested->ApplyCollapsed();
+      }
+      continue;
+    }
+    // The active tab stays under the header. Collapsing does not switch tabs.
+    const bool keep = HoldsActiveTab(child);
+    child->SetVisible(keep);
+    if (keep) {
+      if (auto* const nested = views::AsViewClass<FolderView>(child)) {
+        nested->ApplyChildren(true);
+        nested->PreferredSizeChanged();
+      }
     }
   }
-  UpdateHeader();
-  PreferredSizeChanged();
