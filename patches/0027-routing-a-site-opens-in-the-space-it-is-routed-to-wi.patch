+namespace {
+
+// Stedding routing D2: a typed address in a fresh tab -- one that has shown
+// nothing but a new-tab page -- follows the routes, the way a new tab does.
+// The peek check runs first (D6); a peek never reaches here.
+void MaybeRouteFreshTab(NavigateParams* params) {
+  if (params->disposition != WindowOpenDisposition::CURRENT_TAB ||
+      !params->url.is_valid() ||
+      !(ui::PageTransitionCoreTypeIs(params->transition,
+                                     ui::PAGE_TRANSITION_TYPED) ||
+        ui::PageTransitionCoreTypeIs(params->transition,
+                                     ui::PAGE_TRANSITION_GENERATED))) {
+    return;
+  }
+  content::WebContents* contents = params->source_contents;
+  if (!contents && params->browser) {
+    contents = params->browser->tab_strip_model()->GetActiveWebContents();
+  }
+  if (!contents) {
+    return;
+  }
+  const GURL& shown = contents->GetLastCommittedURL();
+  if (!shown.is_empty() && !shown.SchemeIs("chrome") &&
+      !shown.SchemeIs("about")) {
+    return;
+  }
+  tabs::TabInterface* const tab =
+      tabs::TabInterface::MaybeGetFromContents(contents);
+  BrowserWindowInterface* const window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  if (spaces::SpaceModel* const model =
+          window ? spaces::SpaceModel::From(window) : nullptr) {
+    model->RouteFreshTab(tab, params->url);
+  }
+}
+
+}  // namespace
+
 base::WeakPtr<content::NavigationHandle> Navigate(NavigateParams* params) {
   // Stedding: a link from a pinned tab that wants a new tab peeks instead
   // (docs/features/peek.md, P8).
   if (stedding::MaybePeekInsteadOfNewTab(params)) {
     return nullptr;
   }
+  MaybeRouteFreshTab(params);
   AdditionalParams additional_params;
   return internal::NavigateImpl(params, additional_params);
 }
