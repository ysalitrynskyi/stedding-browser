+
+class PrefService;
+
+namespace stedding {
+
+// The one answer to "should this animate" for every Stedding animation
+// (docs/features/motion.md O1): false when macOS Reduce Motion is on, when
+// the "Animate the sidebar and overlays" preference is off, or when a capture
+// asks for the still path (the reduce_motion parameter). |prefs| is the
+// profile's; null means no profile is at hand and only the system decides.
+bool ShouldAnimate(const PrefService* prefs);
+
+}  // namespace stedding
