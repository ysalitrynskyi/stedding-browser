+// import I39: with Passwords ticked, a login the profile saves with another
+// password keeps the saved one; the other login comes in; the line counts
+// both.
+IN_PROC_BROWSER_TEST_F(SafariExportImportTest, AConflictKeepsTheSavedPassword) {
+  Profile* const profile = browser()->GetProfile();
+  scoped_refptr<password_manager::PasswordStoreInterface> store =
+      ProfilePasswordStoreFactory::GetForProfile(
+          profile, ServiceAccessType::EXPLICIT_ACCESS);
+  ASSERT_TRUE(store);
+  password_manager::PasswordForm saved;
+  saved.url = GURL("https://safari-login.example/");
+  saved.signon_realm = "https://safari-login.example/";
+  saved.username_value = u"ann";
+  saved.password_value =
+      password_manager::PasswordString(std::u16string(u"saved-before"));
+  saved.in_store = password_manager::PasswordForm::Store::kProfileStore;
+  base::RunLoop added;
+  store->AddLogin(password_manager::FromPasswordForm(std::move(saved)),
+                  added.QuitClosure());
+  added.Run();
+
+  stedding::SafariExportParts parts;
+  parts.passwords = true;
+  const stedding::SafariExportResult result = ImportDirectly(parts);
+  EXPECT_EQ(1u, result.passwords.added);
+  EXPECT_EQ(1u, result.passwords.kept);
+  EXPECT_EQ(u"saved-before",
+            PasswordFor(profile, "https://safari-login.example/", u"ann"));
+  EXPECT_EQ(u"newone",
+            PasswordFor(profile, "https://safari-other.example/", u"bob"));
+  EXPECT_NE(std::u16string::npos,
+            stedding::DescribeSafariExportResult(result).find(
+                u"1 password saved with another password was kept as saved."));
+}
