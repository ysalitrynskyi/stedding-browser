+std::optional<FolderView::DropPlace> FolderView::DropPlaceAt(
+    const gfx::Point& screen_point) const {
+  TabStripCollectionController* const controller =
+      collection_node_ ? collection_node_->GetController() : nullptr;
+  tabs::FolderTabCollection* const folder = this->folder();
+  // A top-level folder's view is a row of the unpinned block's container.
+  const UnpinnedTabContainerView* const container =
+      views::AsViewClass<UnpinnedTabContainerView>(parent());
+  const std::optional<bool> above = IsAboveClearLine(screen_point);
+  if (!controller || !folder || !container || !above) {
+    return std::nullopt;
+  }
+  const gfx::Rect strip = container->GetBoundsInScreen();
+  if (screen_point.x() < strip.x() || screen_point.x() >= strip.right()) {
+    return std::nullopt;
+  }
+  // The container's rows by the tabs they draw: a row is a tab, a split, a
+  // group or a folder, and the first tab of each of the block's own rows
+  // names it.
+  std::map<const tabs::TabInterface*, const views::View*> row_of_tab;
+  for (const views::View* const row : container->children()) {
+    std::vector<const views::View*> pending = {row};
+    while (!pending.empty()) {
+      const views::View* const view = pending.back();
+      pending.pop_back();
+      if (const auto* const tab_view = views::AsViewClass<TabView>(view)) {
+        row_of_tab.emplace(tab_view->GetTabInterface(), row);
+        continue;
+      }
+      for (const views::View* const child : view->children()) {
+        pending.push_back(child);
+      }
+    }
+  }
+  const auto drawn_row = [&](const tabs::Child& child) -> const views::View* {
+    const tabs::TabInterface* first = nullptr;
+    if (const auto* const tab = std::get_if<tabs::ScopedTab>(&child)) {
+      first = tab->get();
+    } else if (const tabs::TabCollection* const collection =
+                   std::get<std::unique_ptr<tabs::TabCollection>>(child).get();
+               collection->TabCountRecursive() > 0) {
+      first = collection->GetTabAtIndexRecursive(0);
+    }
+    const auto it = row_of_tab.find(first);
+    if (it == row_of_tab.end() || !it->second->IsDrawn() ||
+        it->second->bounds().IsEmpty()) {
+      return nullptr;
+    }
+    return it->second;
+  };
+  // The place: before the first row on screen whose middle is below the
+  // pointer, as a dragged tab row takes its place, the folder aside; after
+  // the last one when there is none. Rows of the run are over the line and
+  // the others under it, so the line decides the folder's pin as well.
+  const tabs::TabCollection* const top = folder->GetParentCollection();
+  if (!top) {
+    return std::nullopt;
+  }
+  DropPlace place;
+  place.pinned = *above;
+  const views::View* previous = nullptr;
+  const views::View* next = nullptr;
+  size_t index = 0;
+  std::optional<size_t> slot;
+  std::optional<size_t> from;
+  for (const tabs::Child& child : top->GetChildren()) {
+    if (const auto* const collection =
+            std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+        collection && collection->get() == folder) {
+      from = index;
+      continue;
+    }
+    if (const views::View* const row = drawn_row(child); row && !slot) {
+      if (screen_point.y() < row->GetBoundsInScreen().CenterPoint().y()) {
+        slot = index;
+        next = row;
+      } else {
+        previous = row;
+        place.slot = index + 1;
+      }
+    }
+    ++index;
+  }
+  if (slot) {
+    place.slot = *slot;
+  }
+  // The bar sits in the gap on the folder's side of the line: under the row
+  // before it in the run, over the row after it below the line, or else
+  // under the "+ New Tab" row, which ends the boundary.
+  constexpr int kHalfGap = 1;
+  const views::View* const new_tab_row = container->space_boundary_new_tab_row();
+  if (place.pinned) {
+    place.indicator_y = previous ? previous->bounds().bottom() + kHalfGap
+                        : next   ? next->bounds().y() - kHalfGap
+                                 : 0;
+  } else if (next) {
+    place.indicator_y = next->bounds().y() - kHalfGap;
+  } else {
+    int bottom = previous ? previous->bounds().bottom() : 0;
+    if (new_tab_row && new_tab_row->GetVisible()) {
+      bottom = std::max(bottom, new_tab_row->bounds().bottom());
+    }
+    place.indicator_y = bottom + kHalfGap;
+  }
+  place.moves = place.pinned != controller->IsFolderPinned(folder) ||
+                !from || place.slot != *from;
+  return place;
+}
+
+void FolderView::ShowDropIndicator(const std::optional<DropPlace>& place) {
+  // Lit while a release would move the folder, as a header is lit while a
+  // tab dragged over it would drop in (F7).
+  const bool moves = place && place->moves;
+  SetDropHighlight(moves);
+  if (auto* const container =
+          views::AsViewClass<UnpinnedTabContainerView>(parent())) {
+    container->SetRowDropIndicator(
+        moves ? std::optional<int>(place->indicator_y) : std::nullopt);
+  }
+}
