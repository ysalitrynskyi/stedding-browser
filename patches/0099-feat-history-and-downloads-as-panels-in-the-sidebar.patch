+base::ListValue ShortcutRowsAsValue(PrefService* local_state) {
+  base::ListValue groups;
+  if (!local_state) {
+    return groups;
+  }
+  const std::vector<shortcuts::Binding> defaults =
+      shortcuts::DefaultBindings();
+  base::DictValue stored =
+      local_state->GetDict(prefs::kShortcutsUser).Clone();
+  const shortcuts::ShortcutEditor editor(stored, defaults);
+  std::optional<shortcuts::Group> current_group;
+  base::ListValue rows;
+  const auto flush = [&]() {
+    if (current_group && !rows.empty()) {
+      base::DictValue group;
+      group.Set("title", shortcuts::GroupTitle(*current_group));
+      group.Set("rows", std::move(rows));
+      groups.Append(std::move(group));
+    }
+    rows = base::ListValue();
+  };
+  for (const shortcuts::Entry& entry : shortcuts::Catalog()) {
+    if (entry.flags & shortcuts::kHidden) {
+      continue;
+    }
+    const shortcuts::RowState state = editor.StateOf(entry);
+    // A row this platform binds nothing to, and the user never touched, is
+    // not this platform's (a Linux tab group's chord on the Mac).
+    if (state.defaults.empty() && !state.changed) {
+      continue;
+    }
+    if (current_group != entry.group) {
+      flush();
+      current_group = entry.group;
+    }
+    rows.Append(RowAsValue(entry, state));
+  }
+  flush();
+  return groups;
+}
+
+std::u16string ExtensionHoldingChord(const shortcuts::Chord& chord) {
+  ProfileManager* const profile_manager =
+      g_browser_process ? g_browser_process->profile_manager() : nullptr;
+  if (!profile_manager) {
+    return std::u16string();
+  }
+  for (Profile* profile : profile_manager->GetLoadedProfiles()) {
+    extensions::CommandService* const commands =
+        extensions::CommandService::Get(profile);
+    extensions::ExtensionRegistry* const registry =
+        extensions::ExtensionRegistry::Get(profile);
+    if (!commands || !registry) {
+      continue;
+    }
+    for (const auto& extension : registry->enabled_extensions()) {
+      ui::CommandMap named;
+      if (commands->GetNamedCommands(
+              extension->id(), extensions::CommandService::ACTIVE,
+              extensions::CommandService::ANY_SCOPE, &named)) {
+        for (const auto& [name, command] : named) {
+          if (Matches(command.accelerator(), chord)) {
+            return base::UTF8ToUTF16(extension->name());
+          }
+        }
+      }
+      const extensions::ActionInfo* const info =
+          extensions::ActionInfo::GetExtensionActionInfo(extension.get());
+      extensions::Command action;
+      if (info &&
+          commands->GetExtensionActionCommand(
+              extension->id(), info->type, extensions::CommandService::ACTIVE,
+              &action, /*active=*/nullptr) &&
+          Matches(action.accelerator(), chord)) {
+        return base::UTF8ToUTF16(extension->name());
+      }
+    }
+  }
+  return std::u16string();
+}
