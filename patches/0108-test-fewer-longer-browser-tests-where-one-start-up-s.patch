+// Dk4, Dk5: what a page says of its own colours comes first: its own dark
+// theme, an error page's own dark styles, and `only light`.
+IN_PROC_BROWSER_TEST_F(DarkPagesTest, ThePagesOwnColourSchemeComesFirst) {
+  // Dk4: a darkened page is told the reader prefers dark, in a light window,
+  // so a site with a dark theme of its own draws it instead of an inversion.
+  [&] {
+    SCOPED_TRACE("a site with its own dark theme uses it");
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(
+        browser(), Url("a.test", "/dark/own_theme")));
+    constexpr char kPrefersDark[] =
+        "matchMedia('(prefers-color-scheme: dark)').matches";
+    ASSERT_EQ(false, content::EvalJs(page(), kPrefersDark)) << "a light window";
+    stedding::SetDarkPagesOn(profile(), true);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return content::EvalJs(page(), kPrefersDark).ExtractBool(); }));
+    EXPECT_EQ("rgb(30, 41, 59)",
+              content::EvalJs(
+                  page(), "getComputedStyle(document.body).backgroundColor"));
+    EXPECT_TRUE(
+        WaitForPixel(page(), gfx::Point(300, 400), SkColorSetRGB(30, 41, 59)))
+        << "the site's own dark background, not #121212";
+  }();
+
+  // Dk4: an error page of a darkened site uses its own dark styles.
+  [&] {
+    SCOPED_TRACE("an error page is dark");
+    ASSERT_NO_FATAL_FAILURE(StartOver());
+    stedding::SetDarkPagesOn(profile(), true);
+    // A port nothing listens on: the network error page for that address.
+    const GURL nowhere("http://a.test:1/");
+    std::ignore = ui_test_utils::NavigateToURL(browser(), nowhere);
+    ASSERT_EQ(nowhere, page()->GetLastCommittedURL());
+    ASSERT_EQ(content::PAGE_TYPE_ERROR,
+              page()->GetController().GetLastCommittedEntry()->GetPageType());
+    EXPECT_TRUE(ForcedDark(page()));
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      const std::optional<SkColor> colour = PixelAt(page(), gfx::Point(5, 5));
+      // Opaque: a pixel read before anything was drawn is transparent, and
+      // a transparent black would pass for dark.
+      return colour && SkColorGetA(*colour) == SK_AlphaOPAQUE &&
+             color_utils::IsDark(*colour);
+    })) << "the error page is drawn dark";
+  }();
+
+  // Dk5: a page that asks for `only light` stays light, in a light and in a
+  // dark window, and so does such a frame on a darkened page.
+  [&] {
+    SCOPED_TRACE("an only-light page stays light");
