+class CommandBarViewTest : public BrowserWithTestWindowTest {
+ protected:
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+  TabStripModel& tabs() { return *browser()->tab_strip_model(); }
+
+  // A "gh" keyword: typed text that goes somewhere known without the
+  // omnibox's classifier, which unit tests do not have (K18).
+  void AddGitHubKeyword() {
+    TemplateURLServiceFactory::GetInstance()->SetTestingFactoryAndUse(
+        profile(),
+        base::BindRepeating(&TemplateURLServiceFactory::BuildInstanceFor));
+    TemplateURLData data;
+    data.SetShortName(u"GitHub");
+    data.SetKeyword(u"gh");
+    data.SetURL("https://github.com/search?q={searchTerms}");
+    TemplateURLServiceFactory::GetForProfile(profile())->Add(
+        std::make_unique<TemplateURL>(data));
+  }
+};
+
+// spaces B13: the bar lists tabs from every Space, and choosing one in
+// another Space switches to that Space and activates the tab.
+TEST_F(CommandBarViewTest, ChoosingATabInAnotherSpaceSwitchesToIt) {
+  const spaces::SpaceId home = model().active_id();
+  AddTab(browser(), GURL("https://example.com/"));
+  tabs::TabInterface* const in_home = tabs().GetActiveTab();
+  spaces::Space* const work = model().AddSpace("Work", SK_ColorBLUE);
+  model().SetActiveSpace(work->id());
+  AddTab(browser(), GURL("https://example.org/"));
+  tabs::TabInterface* const in_work = tabs().GetActiveTab();
+  model().SetActiveSpace(home);
+  ASSERT_EQ(in_home, tabs().GetActiveTab());
+
+  // Not shown in a window; the model half needs no widget.
+  auto bar = std::make_unique<CommandBarView>(browser());
+  // Every tab, in strip order: the fixture inserts at index 0, so the Work
+  // tabs come first. The tab the switch opened in Work is there too.
+  ASSERT_EQ(static_cast<size_t>(tabs().count()),
+            bar->result_count_for_testing());
+
+  Down(*bar, tabs().GetIndexOfTab(in_work));
+  EXPECT_TRUE(Enter(*bar));
+  EXPECT_EQ(work->id(), model().active_id());
+  EXPECT_EQ(in_work, tabs().GetActiveTab());
+}
+
+// commandbar K2, K5: a tab row keeps its tab, not its place in the strip. A
+// tab closed while the bar is open moves no other tab under the chosen row,
+// and a row whose tab has closed does nothing.
+TEST_F(CommandBarViewTest, EnterFollowsTheTabNotItsIndex) {
+  AddTab(browser(), GURL("https://a.example/"));
+  AddTab(browser(), GURL("https://b.example/"));
+  AddTab(browser(), GURL("https://c.example/"));
+  // The fixture inserts at index 0: the strip is c, b, a, and c is active.
+  tabs::TabInterface* const c = tabs().GetTabAtIndex(0);
+  tabs::TabInterface* const a = tabs().GetTabAtIndex(2);
+
+  auto bar = std::make_unique<CommandBarView>(browser());
+  ASSERT_EQ(3u, bar->row_count_for_testing());
+  Down(*bar, 2);
+  ASSERT_EQ(2u, bar->selected_row_for_testing());
+  // b closes in the background, and a moves up to index 1.
+  tabs().CloseWebContentsAt(1, TabCloseTypes::CLOSE_NONE);
+  EXPECT_TRUE(Enter(*bar));
+  EXPECT_EQ(a, tabs().GetActiveTab());
+
+  AddTab(browser(), GURL("https://d.example/"));
+  // The strip is d, c, a, and d is active.
+  tabs::TabInterface* const d = tabs().GetActiveTab();
+  auto again = std::make_unique<CommandBarView>(browser());
+  ASSERT_EQ(3u, again->row_count_for_testing());
+  Down(*again);
+  // The chosen row's tab, c, closes, and a takes its index.
+  tabs().CloseWebContentsAt(tabs().GetIndexOfTab(c),
+                            TabCloseTypes::CLOSE_NONE);
+  EXPECT_TRUE(Enter(*again));
+  EXPECT_EQ(d, tabs().GetActiveTab());
+  EXPECT_FALSE(again->closing_for_testing());
+}
 
