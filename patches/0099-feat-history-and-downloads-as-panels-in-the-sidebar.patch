+
+namespace stedding {
+
+LibraryUI::LibraryUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui, /*enable_chrome_send=*/true) {
+  Profile* const profile = Profile::FromWebUI(web_ui);
+  content::WebUIDataSource* const source =
+      content::WebUIDataSource::CreateAndAdd(profile, kLibraryHost);
+  // Every path (/history, /downloads) is the one page; it reads which panel
+  // it is from its path.
+  webui::SetupWebUIDataSource(source, kSteddingLibraryResources,
+                              IDR_STEDDING_LIBRARY_STEDDING_LIBRARY_HTML);
+
+  // Pn8: site icons from the local favicon cache alone (the page asks with
+  // allowGoogleServerFallback=0) and file icons from the system. The
+  // Downloads page's handler adds the file icons' source itself.
+  content::URLDataSource::Add(
+      profile, std::make_unique<FaviconSource>(
+                   profile, chrome::FaviconUrlFormat::kFavicon2));
+  content::URLDataSource::Add(profile, std::make_unique<ThemeSource>(profile));
+
+  // The panel's words. Stedding's interface is in English for now
+  // (docs/QUALITY.md), as Settings' Stedding page is.
+  source->AddString("historyTitle", "History");
+  source->AddString("downloadsTitle", "Downloads");
+  source->AddString("searchHistory", "Search history");
+  source->AddString("searchDownloads", "Search downloads");
+  source->AddString("openAsPage", "Open as Page");
+  source->AddString("closePanel", "Close");
+  source->AddString("rangeAll", "All");
+  source->AddString("rangeToday", "Today");
+  source->AddString("rangeWeek", "This Week");
+  source->AddString("rangeMonth", "This Month");
+  source->AddString("noHistory", "Pages you visit show here.");
+  source->AddString("noHistoryFound", "No pages match.");
+  source->AddString("noDownloads", "Files you download show here.");
+  source->AddString("noDownloadsFound", "No downloads match.");
+  source->AddString("today", "Today");
+  source->AddString("yesterday", "Yesterday");
+  source->AddString("rowMenu", "More actions");
+  source->AddString("open", "Open");
+  source->AddString("openInNewTab", "Open in New Tab");
+  source->AddString("remove", "Remove");
+  source->AddString("copyFile", "Copy File");
+  source->AddString("removeFromList", "Remove from List");
+  source->AddString("pause", "Pause");
+  source->AddString("resume", "Resume");
+  source->AddString("cancel", "Cancel");
+  source->AddString("retry", "Retry");
+  source->AddString("fileRemoved", "Deleted");
+  source->AddString("trashFailed",
+                    "Could not be moved; the file is where it was.");
+  source->AddString("dangerous",
+                    "This file may be harmful. The Downloads page says why, "
+                    "and lets you keep or delete it.");
+  source->AddString("reviewInDownloads", "Review in Downloads");
+#if BUILDFLAG(IS_MAC)
+  source->AddString("showInFolder", "Show in Finder");
+  source->AddString("moveToTrash", "Move to Trash");
+#else
+  source->AddString("showInFolder", "Show in Folder");
+  source->AddString("moveToTrash", "Move to Recycle Bin");
+#endif
+  // Pn11: only where the system has a Trash this build can reach.
+  source->AddBoolean("canTrash", BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN));
+  // Pn7, Pn9: History's Remove and Downloads' Remove from List follow the
+  // policy that lets a profile delete its history, as Chromium's pages do.
+  const bool allow_deleting =
+      profile->GetPrefs()->GetBoolean(::prefs::kAllowDeletingBrowserHistory);
+  source->AddBoolean("allowDeletingHistory",
+                     allow_deleting && !profile->IsChild());
+
+  web_ui->AddMessageHandler(std::make_unique<LibraryHandler>());
+}
+
+LibraryUI::~LibraryUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(LibraryUI)
+
+void LibraryUI::BindInterface(
+    mojo::PendingReceiver<history::mojom::PageHandler> pending_page_handler) {
+  history_handler_ = std::make_unique<BrowsingHistoryHandler>(
+      std::move(pending_page_handler), Profile::FromWebUI(web_ui()),
+      web_ui()->GetWebContents());
+}
+
+void LibraryUI::BindInterface(
+    mojo::PendingReceiver<downloads::mojom::PageHandlerFactory> receiver) {
+  downloads_factory_.reset();
+  downloads_factory_.Bind(std::move(receiver));
+}
+
+void LibraryUI::CreatePageHandler(
+    mojo::PendingRemote<downloads::mojom::Page> page,
+    mojo::PendingReceiver<downloads::mojom::PageHandler> receiver) {
+  Profile* const profile = Profile::FromWebUI(web_ui());
+  // As chrome://downloads does: the profile's download history is read in
+  // first, so the panel lists finished downloads from earlier runs.
+  if (DownloadCoreService* const service =
+          DownloadCoreServiceFactory::GetForBrowserContext(profile)) {
+    service->InitializeHistory(
+        DownloadCoreService::DownloadHistoryLoadTrigger::kDownloadsPage);
+  }
+  downloads_handler_ = std::make_unique<DownloadsDOMHandler>(
+      std::move(receiver), std::move(page), profile->GetDownloadManager(),
+      web_ui());
+}
+
+LibraryUIConfig::LibraryUIConfig()
+    : DefaultWebUIConfig(content::kChromeUIScheme, kLibraryHost) {}
+
+}  // namespace stedding
