@@ -352,6 +352,50 @@ RewriteDockPlistResult RewriteDockPlist(NSDictionary* dock_plist,
   return {.status = AddIconStatus::kSuccess, .result_plist = new_plist};
 }
 
+// Stedding web apps Wa18: the plist without the tiles for `installed_path`,
+// in the kept apps and the recent ones.
+RewriteDockPlistResult RemoveIconFromDockPlist(NSDictionary* dock_plist,
+                                               NSString* installed_path) {
+  NSArray* original_persistent_apps =
+      AppListFromDockPlist(dock_plist, kDockPersistentAppsKey);
+  NSArray* original_recent_apps =
+      AppListFromDockPlist(dock_plist, kDockRecentAppsKey);
+  if (!original_persistent_apps || !original_recent_apps || !installed_path) {
+    return {.status = AddIconStatus::kFailure};
+  }
+  NSMutableArray* persistent_apps = [original_persistent_apps mutableCopy];
+  NSMutableArray* recent_apps = [original_recent_apps mutableCopy];
+  NSArray<NSString*>* persistent_app_paths = PathsFromAppList(persistent_apps);
+  NSArray<NSString*>* recent_app_paths = PathsFromAppList(recent_apps);
+  if (!persistent_app_paths || !recent_app_paths) {
+    return {.status = AddIconStatus::kFailure};
+  }
+
+  // The Dock keeps a bundle as a directory URL; its path and the one given
+  // may differ by a trailing slash.
+  NSString* wanted = installed_path.stringByStandardizingPath;
+  BOOL (^is_wanted)(NSString*, NSUInteger, BOOL*) =
+      ^BOOL(NSString* app_path, NSUInteger idx, BOOL* stop) {
+        return app_path.length &&
+               [app_path.stringByStandardizingPath isEqualToString:wanted];
+      };
+  NSIndexSet* persistent_matches =
+      [persistent_app_paths indexesOfObjectsPassingTest:is_wanted];
+  NSIndexSet* recent_matches =
+      [recent_app_paths indexesOfObjectsPassingTest:is_wanted];
+  if (!persistent_matches.count && !recent_matches.count) {
+    return {.status = AddIconStatus::kAlreadyPresent};
+  }
+  [persistent_apps removeObjectsAtIndexes:persistent_matches];
+  [recent_apps removeObjectsAtIndexes:recent_matches];
+
+  NSMutableDictionary* new_plist =
+      [NSMutableDictionary dictionaryWithDictionary:dock_plist];
+  new_plist[kDockPersistentAppsKey] = persistent_apps;
+  new_plist[kDockRecentAppsKey] = recent_apps;
+  return {.status = AddIconStatus::kSuccess, .result_plist = new_plist};
+}
+
 }  // namespace
 
 ChromeInDockStatus ChromeIsInTheDock() {
@@ -405,4 +449,25 @@ RewriteDockPlistResult RewriteDockPlistForTesting(NSDictionary* dock_plist,
   return RewriteDockPlist(dock_plist, installed_path, dmg_app_path);
 }
 
+AddIconStatus RemoveIcon(NSString* installed_path) {
+  @autoreleasepool {
+    RewriteDockPlistResult result =
+        RemoveIconFromDockPlist(DockPlistFromUserDefaults(), installed_path);
+    if (result.status == AddIconStatus::kSuccess) {
+      CHECK(result.result_plist);
+      [NSUserDefaults.standardUserDefaults
+          setPersistentDomain:result.result_plist
+                      forName:kDockDomain];
+      Restart();
+    }
+    return result.status;
+  }
+}
+
+RewriteDockPlistResult RemoveIconFromDockPlistForTesting(
+    NSDictionary* dock_plist,
+    NSString* installed_path) {
+  return RemoveIconFromDockPlist(dock_plist, installed_path);
+}
+
 }  // namespace dock
diff --git a/chrome/browser/mac/dock_tile_unittest.mm b/chrome/browser/mac/dock_tile_unittest.mm
new file mode 100644
index 0000000000000..cdb169ea7129c
--- /dev/null
+++ b/chrome/browser/mac/dock_tile_unittest.mm
@@ -0,0 +1,127 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import <Foundation/Foundation.h>
+
+#include "base/apple/foundation_util.h"
+#import "chrome/browser/mac/dock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#import "testing/gtest_mac.h"
+
+namespace dock {
+namespace {
+
+// Safari, a web browser by its own Info.plist (NSUserActivityTypes), at the
+// path macOS keeps it on every Mac a test runs on.
+NSString* const kSafari =
+    @"/System/Volumes/Preboot/Cryptexes/App/System/Applications/Safari.app";
+NSString* const kNotes = @"/System/Applications/Notes.app";
+// The apps folder under the home folder of whoever runs the test, so no one
+// person's path is written into the source.
+NSString* AppsFolder() {
+  return [NSHomeDirectory()
+      stringByAppendingPathComponent:@"Applications/Stedding Apps.localized"];
+}
+
+NSString* AppPath(NSString* name) {
+  return [AppsFolder() stringByAppendingPathComponent:name];
+}
+
+// A tile as the Dock writes one: a directory URL in the CFURL property-list
+// form its file-data keys hold.
+NSDictionary* Tile(NSString* path) {
+  NSURL* url = [NSURL fileURLWithPath:path isDirectory:YES];
+  return @{
+    @"tile-data" : @{
+      @"file-data" :
+          @{@"_CFURLString" : url.absoluteString, @"_CFURLStringType" : @15}
+    },
+    @"tile-type" : @"file-tile"
+  };
+}
+
+NSDictionary* DockPlist(NSArray<NSString*>* kept, NSArray<NSString*>* recent) {
+  NSMutableArray* kept_tiles = [NSMutableArray array];
+  for (NSString* path in kept) {
+    [kept_tiles addObject:Tile(path)];
+  }
+  NSMutableArray* recent_tiles = [NSMutableArray array];
+  for (NSString* path in recent) {
+    [recent_tiles addObject:Tile(path)];
+  }
+  return @{@"persistent-apps" : kept_tiles, @"recent-apps" : recent_tiles};
+}
+
+// The paths of the tiles of `plist`'s list `key`, in order.
+NSArray<NSString*>* Paths(NSDictionary* plist, NSString* key) {
+  NSMutableArray<NSString*>* paths = [NSMutableArray array];
+  for (NSDictionary* tile in base::apple::ObjCCastStrict<NSArray>(plist[key])) {
+    NSString* url = tile[@"tile-data"][@"file-data"][@"_CFURLString"];
+    [paths addObject:[NSURL URLWithString:url].path];
+  }
+  return paths;
+}
+
+// Stedding web apps Wa7: an app's tile goes after the last web browser in
+// the Dock, before the apps that follow it, and the plist keeps everything
+// else as it was.
+TEST(DockTileTest, AnAppsTileGoesAfterTheLastBrowser) {
+  NSString* const app = AppPath(@"Example Mail.app");
+  NSDictionary* const before = DockPlist(@[ kSafari, kNotes ], @[]);
+  RewriteDockPlistResult result =
+      RewriteDockPlistForTesting(before, app, /*dmg_app_path=*/nil);
+  ASSERT_EQ(AddIconStatus::kSuccess, result.status);
+  EXPECT_NSEQ((@[ kSafari, app, kNotes ]),
+              Paths(result.result_plist, @"persistent-apps"));
+  EXPECT_NSEQ(@[], Paths(result.result_plist, @"recent-apps"));
+
+  // Added again, nothing changes and the Dock is not restarted.
+  RewriteDockPlistResult again =
+      RewriteDockPlistForTesting(result.result_plist, app, nil);
+  EXPECT_EQ(AddIconStatus::kAlreadyPresent, again.status);
+  EXPECT_EQ(nil, again.result_plist);
+
+  // No browser in the Dock: the tile goes last.
+  RewriteDockPlistResult no_browser =
+      RewriteDockPlistForTesting(DockPlist(@[ kNotes ], @[]), app, nil);
+  ASSERT_EQ(AddIconStatus::kSuccess, no_browser.status);
+  EXPECT_NSEQ((@[ kNotes, app ]),
+              Paths(no_browser.result_plist, @"persistent-apps"));
+}
+
+// Stedding web apps Wa18: removing an app takes its tiles, kept and recent,
+// and no other: another app's tile with a near name stays, and a Dock with
+// no tile for it is left alone.
+TEST(DockTileTest, RemovingTakesOnlyThatTile) {
+  NSString* const app = AppPath(@"Example Mail.app");
+  NSString* const other = AppPath(@"Example Mail 2.app");
+  NSDictionary* const before =
+      DockPlist(@[ kSafari, app, other, kNotes ], @[ app, kNotes ]);
+
+  RewriteDockPlistResult result =
+      RemoveIconFromDockPlistForTesting(before, app);
+  ASSERT_EQ(AddIconStatus::kSuccess, result.status);
+  EXPECT_NSEQ((@[ kSafari, other, kNotes ]),
+              Paths(result.result_plist, @"persistent-apps"));
+  EXPECT_NSEQ(@[ kNotes ], Paths(result.result_plist, @"recent-apps"));
+
+  // The path as the Dock keeps it, a directory with a trailing slash, names
+  // the same tile.
+  RewriteDockPlistResult with_slash = RemoveIconFromDockPlistForTesting(
+      before, [other stringByAppendingString:@"/"]);
+  ASSERT_EQ(AddIconStatus::kSuccess, with_slash.status);
+  EXPECT_NSEQ((@[ kSafari, app, kNotes ]),
+              Paths(with_slash.result_plist, @"persistent-apps"));
+
+  RewriteDockPlistResult none =
+      RemoveIconFromDockPlistForTesting(result.result_plist, app);
+  EXPECT_EQ(AddIconStatus::kAlreadyPresent, none.status);
+  EXPECT_EQ(nil, none.result_plist);
+
+  RewriteDockPlistResult broken = RemoveIconFromDockPlistForTesting(@{}, app);
+  EXPECT_EQ(AddIconStatus::kFailure, broken.status);
+}
+
+}  // namespace
+}  // namespace dock
