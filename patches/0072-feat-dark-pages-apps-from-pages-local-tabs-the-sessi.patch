index 0000000000000..31d82550ce71d
--- /dev/null
+++ b/chrome/browser/ui/stedding/dark_pages_unittest.cc
@@ -0,0 +1,274 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/dark_pages.h"
+
+#include <cstdlib>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/test/base/testing_profile.h"
+#include "components/content_settings/core/common/content_settings_pattern.h"
+#include "content/public/test/browser_task_environment.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/gfx/color_utils.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// The entry as Settings names it, or "" when there is none.
+std::string Entry(const std::optional<ContentSettingsPattern>& pattern) {
+  return pattern ? pattern->ToString() : std::string();
+}
+
+std::vector<std::string> Names(const std::vector<ContentSettingsPattern>& in) {
+  std::vector<std::string> out;
+  for (const ContentSettingsPattern& pattern : in) {
+    out.push_back(DarkPagesSiteName(pattern));
+  }
+  return out;
+}
+
+bool Near(U8CPU channel, U8CPU expected) {
+  return std::abs(static_cast<int>(channel) - static_cast<int>(expected)) <= 1;
+}
+
+// One fixture for the suite: the rules read the profile's switch and its
+// content settings.
+class DarkPagesRulesTest : public testing::Test {
+ protected:
+  bool Darkened(const char* spec) {
+    return DarkPagesApplyToUrl(&profile_, GURL(spec));
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  TestingProfile profile_;
+};
+
+// Dk1, Dk9, Dk12: off in a fresh profile; on, every page but the browser's
+// own is darkened in "all sites, except these", a Block entry keeps its site
+// light, and in "only these sites" only an Allow entry's site is darkened.
+TEST_F(DarkPagesRulesTest, TheSwitchTheModeAndTheListsDecideEachPage) {
+  EXPECT_FALSE(DarkPagesOn(&profile_)) << "a page looks as its author made it";
+  EXPECT_FALSE(Darkened("https://www.example.com/"));
+
+  SetDarkPagesOn(&profile_, true);
+  ASSERT_TRUE(DarkPagesOn(&profile_));
+  ASSERT_EQ(DarkPagesMode::kAllExcept, GetDarkPagesMode(&profile_))
+      << "all sites is the default";
+  for (const char* spec :
+       {"https://www.example.com/a", "http://other.org:8080/",
+        "file:///tmp/a.html", "data:text/html,<p>x</p>", "about:blank",
+        "http://localhost:3000/", "http://127.0.0.1:8000/"}) {
+    EXPECT_TRUE(Darkened(spec)) << spec;
+  }
+  // Dk9: never, whatever the lists say.
+  for (const char* spec :
+       {"chrome://settings/", "chrome://new-tab-page-third-party/",
+        "chrome://archive/", "chrome-untrusted://print/",
+        "chrome-search://local-ntp/local-ntp.html",
+        "devtools://devtools/bundled/inspector.html",
+        "chrome-extension://abcdefghijklmnopabcdefghijklmnop/options.html"}) {
+    EXPECT_FALSE(Darkened(spec)) << spec;
+  }
+
+  // All sites, except: the listed site is light on any scheme, port and
+  // subdomain; the others stay dark.
+  AddDarkPagesSite(&profile_, DarkPagesMode::kAllExcept,
+                   *DarkPagesSitePatternFor(GURL("https://www.example.com/")));
+  EXPECT_FALSE(Darkened("https://www.example.com/a"));
+  EXPECT_FALSE(Darkened("http://example.com:8080/"));
+  EXPECT_FALSE(Darkened("https://news.example.com/"));
+  EXPECT_TRUE(Darkened("http://other.org:8080/"));
+  EXPECT_EQ(std::vector<std::string>{"example.com"},
+            Names(GetDarkPagesSites(&profile_, DarkPagesMode::kAllExcept)));
+  EXPECT_TRUE(GetDarkPagesSites(&profile_, DarkPagesMode::kOnlyThese).empty());
+
+  // Only these sites: nothing unlisted is darkened, the light list's site
+  // neither; an Allow entry darkens its site.
+  SetDarkPagesMode(&profile_, DarkPagesMode::kOnlyThese);
+  ASSERT_EQ(DarkPagesMode::kOnlyThese, GetDarkPagesMode(&profile_));
+  EXPECT_FALSE(Darkened("http://other.org:8080/"));
+  EXPECT_FALSE(Darkened("https://www.example.com/a"));
+  EXPECT_FALSE(Darkened("file:///tmp/a.html"));
+  AddDarkPagesSite(&profile_, DarkPagesMode::kOnlyThese,
+                   *DarkPagesSitePatternFor(GURL("https://other.org/")));
+  EXPECT_TRUE(Darkened("http://other.org:8080/"));
+  EXPECT_TRUE(Darkened("https://www.other.org/"));
+  EXPECT_EQ(std::vector<std::string>{"other.org"},
+            Names(GetDarkPagesSites(&profile_, DarkPagesMode::kOnlyThese)));
+  // Dk12: a change of mode keeps both lists.
+  EXPECT_EQ(std::vector<std::string>{"example.com"},
+            Names(GetDarkPagesSites(&profile_, DarkPagesMode::kAllExcept)));
+  EXPECT_FALSE(Darkened("chrome://settings/"));
+
+  // The switch rules over both.
+  SetDarkPagesOn(&profile_, false);
+  EXPECT_FALSE(Darkened("http://other.org:8080/"));
+}
+
+// Dk12: a site is on at most one list; putting it on one takes it off the
+// other, and removing it takes it off both.
+TEST_F(DarkPagesRulesTest, ASiteIsOnOneListAtATime) {
+  const ContentSettingsPattern site =
+      *DarkPagesSitePatternFor(GURL("https://example.com/"));
+  AddDarkPagesSite(&profile_, DarkPagesMode::kAllExcept, site);
+  AddDarkPagesSite(&profile_, DarkPagesMode::kOnlyThese, site);
+  EXPECT_TRUE(GetDarkPagesSites(&profile_, DarkPagesMode::kAllExcept).empty());
+  EXPECT_EQ(std::vector<std::string>{"example.com"},
+            Names(GetDarkPagesSites(&profile_, DarkPagesMode::kOnlyThese)));
+  RemoveDarkPagesSite(&profile_, site);
+  EXPECT_TRUE(GetDarkPagesSites(&profile_, DarkPagesMode::kAllExcept).empty());
+  EXPECT_TRUE(GetDarkPagesSites(&profile_, DarkPagesMode::kOnlyThese).empty());
+}
+
+// Dk1, Dk21: a private profile reads the profile's switch, mode and lists;
+// turning the switch from it writes the profile's own switch.
+TEST_F(DarkPagesRulesTest, APrivateProfileFollowsTheProfile) {
+  Profile* const otr = profile_.GetPrimaryOTRProfile(/*create_if_needed=*/true);
+  SetDarkPagesOn(otr, true);
+  EXPECT_TRUE(DarkPagesOn(&profile_)) << "written to the original profile";
+  EXPECT_TRUE(DarkPagesOn(otr));
+  EXPECT_TRUE(DarkPagesApplyToUrl(otr, GURL("https://example.com/")));
+  AddDarkPagesSite(&profile_, DarkPagesMode::kAllExcept,
+                   *DarkPagesSitePatternFor(GURL("https://example.com/")));
+  EXPECT_FALSE(DarkPagesApplyToUrl(otr, GURL("https://example.com/")))
+      << "the private window inherits the list";
+  EXPECT_FALSE(DarkPagesApplyToUrl(otr, GURL("chrome://settings/")));
+  SetDarkPagesOn(&profile_, false);
+  EXPECT_FALSE(DarkPagesOn(otr));
+}
+
+// Dk13: a page's entry is its registrable domain with every subdomain, the
+// rule Clear Site Cookies uses (commandbar K24); an IP address as it is; and
+// nothing for a page that is not an http or https page.
+TEST_F(DarkPagesRulesTest, ASiteIsTheRegistrableDomain) {
+  EXPECT_EQ("[*.]example.co.uk", Entry(DarkPagesSitePatternFor(GURL(
+                                     "https://www.news.example.co.uk/a?b=c"))));
+  EXPECT_EQ("[*.]example.com",
+            Entry(DarkPagesSitePatternFor(GURL("http://example.com:8080/"))));
+  EXPECT_EQ("[*.]foo.github.io",
+            Entry(DarkPagesSitePatternFor(GURL("https://www.foo.github.io/"))))
+      << "github.io is a private registry";
+  EXPECT_EQ("127.0.0.1",
+            Entry(DarkPagesSitePatternFor(GURL("http://127.0.0.1:8000/x"))));
+  EXPECT_EQ("[::1]",
+            Entry(DarkPagesSitePatternFor(GURL("http://[::1]:3000/"))));
+  EXPECT_EQ("[*.]localhost",
+            Entry(DarkPagesSitePatternFor(GURL("http://localhost:3000/"))));
+  EXPECT_EQ("[*.]b.test",
+            Entry(DarkPagesSitePatternFor(GURL("http://b.test/echo"))));
+  for (const char* spec :
+       {"about:blank", "chrome://settings/", "file:///tmp/a.html",
+        "data:text/html,<p>x</p>",
+        "chrome-extension://abcdefghijklmnopabcdefghijklmnop/a.html", ""}) {
+    EXPECT_FALSE(DarkPagesSitePatternFor(GURL(spec))) << spec;
+  }
+  EXPECT_EQ("example.co.uk", DarkPagesSiteName(*DarkPagesSitePatternFor(
+                                 GURL("https://www.news.example.co.uk/"))));
+  EXPECT_EQ(
+      "127.0.0.1",
+      DarkPagesSiteName(*DarkPagesSitePatternFor(GURL("http://127.0.0.1/"))));
+}
+
+// Dk13: what Settings accepts: a host, a URL cut to its host, "*.host" and
+// an IP address; an empty, a path-only and a browser page's entry are
+// refused.
+TEST_F(DarkPagesRulesTest, TypedEntriesAreNormalised) {
+  EXPECT_EQ("[*.]example.com",
+            Entry(DarkPagesSitePatternFromTyped("example.com")));
+  EXPECT_EQ("[*.]news.example.com",
+            Entry(DarkPagesSitePatternFromTyped("  News.Example.com ")));
+  EXPECT_EQ("[*.]www.example.com",
+            Entry(DarkPagesSitePatternFromTyped(
+                "https://www.example.com/path?q=1#top")));
+  EXPECT_EQ("[*.]example.org",
+            Entry(DarkPagesSitePatternFromTyped("*.example.org")));
+  EXPECT_EQ("[*.]example.org",
+            Entry(DarkPagesSitePatternFromTyped("[*.]example.org")));
+  EXPECT_EQ("192.168.1.10",
+            Entry(DarkPagesSitePatternFromTyped("192.168.1.10")));
+  EXPECT_EQ("192.168.1.10",
+            Entry(DarkPagesSitePatternFromTyped("http://192.168.1.10:8080/")));
+  EXPECT_EQ("[::1]", Entry(DarkPagesSitePatternFromTyped("[::1]")));
+  EXPECT_EQ("[*.]localhost", Entry(DarkPagesSitePatternFromTyped("localhost")));
+  EXPECT_EQ("[*.]localhost",
+            Entry(DarkPagesSitePatternFromTyped("localhost:3000")));
+  for (const char* typed :
+       {"", "   ", "/news", "/", "*.", "chrome://settings",
+        "chrome://settings/appearance", "file:///tmp/a.html",
+        "chrome-extension://abcdefghijklmnopabcdefghijklmnop/"}) {
+    EXPECT_FALSE(DarkPagesSitePatternFromTyped(typed)) << "'" << typed << "'";
+  }
+}
+
+// Dk8: a theme colour is inverted the way Blink inverts the page: white gives
+// #121212, a light blue a dark blue, black a light colour; alpha is kept.
+TEST_F(DarkPagesRulesTest, ThemeColoursInvertLikeBlink) {
+  const SkColor white = DarkenLikeBlink(SK_ColorWHITE);
+  EXPECT_TRUE(Near(SkColorGetR(white), 0x12) &&
+              Near(SkColorGetG(white), 0x12) && Near(SkColorGetB(white), 0x12))
+      << std::hex << white;
+  EXPECT_EQ(SK_AlphaOPAQUE, SkColorGetA(white));
+
+  const SkColor light_blue = DarkenLikeBlink(SkColorSetRGB(0xe8, 0xf0, 0xfe));
+  EXPECT_TRUE(color_utils::IsDark(light_blue)) << std::hex << light_blue;
+  EXPECT_GT(SkColorGetB(light_blue), SkColorGetR(light_blue))
+      << "the hue is kept";
+
+  EXPECT_FALSE(color_utils::IsDark(DarkenLikeBlink(SK_ColorBLACK)));
+  EXPECT_EQ(
+      0x80u,
+      SkColorGetA(DarkenLikeBlink(SkColorSetARGB(0x80, 0xff, 0xff, 0xff))));
+}
+
+// Dk8: the background Blink inverts is one whose brightness, by its own
+// weights, is over 205: white and a pale blue are, Google blue (126), a
+// light material blue (164) and a dark grey are not.
+TEST_F(DarkPagesRulesTest, OnlyABrightBackgroundIsInvertedLikeBlink) {
+  EXPECT_TRUE(BlinkDarkensBackground(SK_ColorWHITE));
+  EXPECT_TRUE(BlinkDarkensBackground(SkColorSetRGB(0xe8, 0xf0, 0xfe)));
+  EXPECT_FALSE(BlinkDarkensBackground(SkColorSetRGB(0x42, 0x85, 0xf4)));
+  EXPECT_FALSE(BlinkDarkensBackground(SkColorSetRGB(0x64, 0xb5, 0xf6)));
+  EXPECT_FALSE(BlinkDarkensBackground(SkColorSetRGB(0x20, 0x21, 0x24)));
+  // The edge: brightness 205 is kept, 206 inverted.
+  EXPECT_FALSE(BlinkDarkensBackground(SkColorSetRGB(205, 205, 205)));
+  EXPECT_TRUE(BlinkDarkensBackground(SkColorSetRGB(206, 206, 206)));
+}
+
+// Dk8, web apps Wa9: the colour the address row and an app window's title
+// bar take from a declared colour. Over a darkened page a pale one is
+// inverted like the page and a mid-tone or a dark one kept; over a page that
+// is not darkened every colour is used as declared.
+TEST_F(DarkPagesRulesTest, ADeclaredColourIsDarkenedOnlyOverADarkenedPage) {
+  const SkColor pale_blue = SkColorSetRGB(0xe8, 0xf0, 0xfe);
+  const SkColor google_blue = SkColorSetRGB(0x42, 0x85, 0xf4);
+  const SkColor material_blue = SkColorSetRGB(0x64, 0xb5, 0xf6);
+  const SkColor dark_grey = SkColorSetRGB(0x20, 0x21, 0x24);
+
+  EXPECT_EQ(DarkenLikeBlink(pale_blue),
+            ThemeColorUnderDarkPages(pale_blue, /*page_darkened=*/true));
+  EXPECT_TRUE(color_utils::IsDark(
+      ThemeColorUnderDarkPages(pale_blue, /*page_darkened=*/true)))
+      << "never a light bar over a dark page";
+  EXPECT_EQ(DarkenLikeBlink(SK_ColorWHITE),
+            ThemeColorUnderDarkPages(SK_ColorWHITE, /*page_darkened=*/true));
+  for (const SkColor kept : {google_blue, material_blue, dark_grey}) {
+    EXPECT_EQ(kept, ThemeColorUnderDarkPages(kept, /*page_darkened=*/true))
+        << std::hex << kept;
+  }
+  for (const SkColor declared :
+       {pale_blue, SK_ColorWHITE, google_blue, material_blue, dark_grey}) {
+    EXPECT_EQ(declared,
+              ThemeColorUnderDarkPages(declared, /*page_darkened=*/false))
+        << std::hex << declared;
+  }
+}
+
+}  // namespace
+}  // namespace stedding
