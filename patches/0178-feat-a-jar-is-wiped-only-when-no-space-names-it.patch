+// sessions S44: a pending wipe left by a quit keeps off a jar a session row
+// names, as it does a jar a Space names.
+TEST_F(SharedSessionWindowTest, APendingWipeLeavesAJarASessionNames) {
+  PrefService* const prefs = profile()->GetPrefs();
+  const std::string jar = registry().AddSession("Kept");
