@@ -0,0 +1,172 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/isolation_mark_view.h"
+
+#include <algorithm>
+
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/spaces/isolation_mark.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/gfx/paint_vector_icon.h"
+#include "ui/gfx/vector_icon_types.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/view_utils.h"
+
+namespace stedding {
+namespace {
+
+// The badge's ring, in the ground's colour, between the emoji under it and
+// its disc.
+constexpr float kBadgeRing = 1.5f;
+// The glyph cut out of the badge's disc. The cookie's drawing fills about
+// five sixths of its square, so at 8 DIP it keeps a margin inside a 9 DIP
+// disc.
+constexpr int kBadgeGlyphSize = 8;
+
+// Paints `icon` at `size`, centred on `centre`.
+void PaintIconAt(gfx::Canvas* canvas,
+                 const gfx::VectorIcon& icon,
+                 int size,
+                 const gfx::PointF& centre,
+                 SkColor color) {
+  canvas->Save();
+  canvas->Translate(gfx::Vector2d(static_cast<int>(centre.x() - size / 2.0f),
+                                  static_cast<int>(centre.y() - size / 2.0f)));
+  gfx::PaintVectorIcon(canvas, icon, size, color);
+  canvas->Restore();
+}
+
+}  // namespace
+
+IsolationMarkView::IsolationMarkView(Form form,
+                                     ui::ColorId ink,
+                                     ui::ColorId ground)
+    : form_(form), ink_(ink), ground_(ground) {
+  // The host takes the pointer: its click, its hover and its tooltip, which
+  // a child under the pointer would otherwise answer for, with nothing.
+  SetCanProcessEventsWithinSubtree(false);
+  // The host's description says it, after the Space's name.
+  GetViewAccessibility().SetIsIgnored(true);
+}
+
+IsolationMarkView::~IsolationMarkView() = default;
+
+void IsolationMarkView::SetForm(Form form) {
+  if (form_ == form) {
+    return;
+  }
+  form_ = form;
+  PreferredSizeChanged();
+  SchedulePaint();
+}
+
+void IsolationMarkView::SetAlpha(SkAlpha alpha) {
+  if (alpha_ == alpha) {
+    return;
+  }
+  alpha_ = alpha;
+  SchedulePaint();
+}
+
+gfx::Size IsolationMarkView::CalculatePreferredSize(
+    const views::SizeBounds& available_size) const {
+  const int size = form_ == Form::kGlyph ? kGlyphSize : kBadgeSize;
+  return gfx::Size(size, size);
+}
+
+void IsolationMarkView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  const ui::ColorProvider* const colors = GetColorProvider();
+  if (!colors || alpha_ == SK_AlphaTRANSPARENT || size().IsEmpty()) {
+    return;
+  }
+  const SkColor ink = colors->GetColor(ink_);
+  const bool faded = alpha_ != SK_AlphaOPAQUE;
+  if (faded) {
+    // One layer for the whole mark: the ring, the disc and the cut-out fade
+    // together, so the glyph does not show the disc through itself.
+    canvas->SaveLayerAlpha(alpha_);
+  }
+  if (form_ == Form::kGlyph) {
+    PaintIconAt(canvas, spaces::IsolationMarkIcon(),
+                std::min(width(), height()),
+                gfx::RectF(GetLocalBounds()).CenterPoint(), ink);
+  } else {
+    PaintBadge(canvas, ink, colors->GetColor(ground_));
+  }
+  if (faded) {
+    canvas->Restore();
+  }
+}
+
+void IsolationMarkView::PaintBadge(gfx::Canvas* canvas,
+                                   SkColor ink,
+                                   SkColor ground) const {
+  const gfx::RectF bounds(GetLocalBounds());
+  const gfx::PointF centre = bounds.CenterPoint();
+  const float radius = std::min(bounds.width(), bounds.height()) / 2.0f;
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setStyle(cc::PaintFlags::kFill_Style);
+  // The ring first, a disc of the ground: it separates the badge from the
+  // Space's own glyph under it, whatever colours that emoji has.
+  flags.setColor(ground);
+  canvas->DrawCircle(centre, radius, flags);
+  flags.setColor(ink);
+  canvas->DrawCircle(centre, radius - kBadgeRing, flags);
+  PaintIconAt(canvas, spaces::IsolationMarkIcon(), kBadgeGlyphSize, centre,
+              ground);
+}
+
+MarkAfterText PlaceMarkAfterText(const gfx::Rect& label, int trailing_edge) {
+  constexpr int kSize = IsolationMarkView::kGlyphSize;
+  constexpr int kGap = IsolationMarkView::kGapAfterText;
+  MarkAfterText placed{label, gfx::Rect()};
+  // The furthest the text may run and leave the mark its room.
+  const int text_end = trailing_edge - kGap - kSize;
+  if (placed.label.right() > text_end) {
+    placed.label.set_width(std::max(0, text_end - placed.label.x()));
+  }
+  // A label that starts past that point has nothing left to give: the mark
+  // still ends at the edge.
+  placed.mark = gfx::Rect(
+      std::min(placed.label.right() + kGap, trailing_edge - kSize),
+      label.y() + (label.height() - kSize) / 2, kSize, kSize);
+  return placed;
+}
+
+gfx::Rect PlaceBadge(const gfx::Rect& glyph, const gfx::Rect& host) {
+  constexpr int kSize = IsolationMarkView::kBadgeSize;
+  constexpr int kOut = kSize / 3;
+  int x = glyph.right() + kOut - kSize;
+  int y = glyph.bottom() + kOut - kSize;
+  x = std::max(host.x(), std::min(x, host.right() - kSize));
+  y = std::max(host.y(), std::min(y, host.bottom() - kSize));
+  return gfx::Rect(x, y, kSize, kSize);
+}
+
+IsolationMarkView* FindShownIsolationMark(views::View* host) {
+  if (!host) {
+    return nullptr;
+  }
+  for (views::View* const child : host->children()) {
+    auto* const mark = views::AsViewClass<IsolationMarkView>(child);
+    if (mark && mark->GetVisible()) {
+      return mark;
+    }
+  }
+  return nullptr;
+}
+
+BEGIN_METADATA(IsolationMarkView)
+END_METADATA
+
+}  // namespace stedding
