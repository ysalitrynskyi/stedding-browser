+// P9, P20: a pin in its Space can take a split: the bar and the page menu
+// offer it, and the page goes beside the pin. Cmd-O over another peek keeps
+// that one as a tab.
+IN_PROC_BROWSER_TEST_F(PeekOverPageTest, OpenInSplitPairsThePageWithItsPin) {
+  ASSERT_NO_FATAL_FAILURE(
+      OpenPin(Url("b.test", "/title3.html"), /*in_space=*/true));
+  tabs::TabInterface* const pin = tab();
+  ClickLink();
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  EXPECT_TRUE(peek->view()->split_button()->GetVisible());
+  content::WebContents* const page = peek->page();
+  Press(peek->view()->split_button());
+  ASSERT_TRUE(WaitForNoPeek(pin));
+  tabs::TabInterface* const kept = tabs::TabInterface::MaybeGetFromContents(page);
+  ASSERT_TRUE(kept);
+  EXPECT_TRUE(kept->IsSplit());
+  EXPECT_TRUE(pin->IsSplit());
+  EXPECT_EQ(pin->GetSplit(), kept->GetSplit());
+}
