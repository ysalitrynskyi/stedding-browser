+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "chrome/test/stedding/sidebar_test_util.h"
+#include "components/prefs/pref_service.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/tracing_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "third_party/skia/include/core/SkRect.h"
+#include "ui/base/window_open_disposition.h"
+#include "ui/compositor/canvas_painter.h"
+#include "ui/compositor/compositor.h"
+#include "ui/compositor/compositor_animation_observer.h"
+#include "ui/compositor/compositor_observer.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/layer_animator.h"
+#include "ui/compositor/layer_delegate.h"
+#include "ui/compositor/paint_context.h"
+#include "ui/events/base_event_utils.h"
+#include "ui/events/event.h"
+#include "ui/gfx/animation/tween.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/gfx/presentation_feedback.h"
+#include "ui/views/bubble/bubble_frame_view.h"
+#include "ui/views/controls/scroll_view.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/native_widget.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/widget/widget_observer.h"
+#include "url/gurl.h"
+
+namespace {
+
+using trace_analyzer::Query;
+using trace_analyzer::TraceEvent;
+
+// The events the meter reads. The views' own: a view laid out after its
+// bounds changed, after SetBounds with a layout pending, by its parent's
+// layout pass, or as the root of its widget; a view painted. The meter's
+// own: a step of the compositor's animation clock, and a commit, which ends a
+// main frame that changed something.
+constexpr char kStep[] = "SteddingMotionStep";
+constexpr char kCommit[] = "SteddingMotionCommit";
+constexpr const char* kViewLayouts[] = {"View::Layout(bounds_changed)",
+                                        "View::Layout(set_bounds)",
+                                        "View::LayoutChildren"};
+constexpr char kRootLayout[] = "Widget::LayoutRootViewIfNecessary";
+constexpr char kPaint[] = "View::Paint";
+constexpr char kWindowMove[] = "Widget::OnNativeWidgetMove";
+// A test's bracket around a call, and Stedding's own steps a breakdown names.
+constexpr char kBracket[] = "SteddingMotionBracket";
+constexpr const char* kSteddingSteps[] = {"Stedding::SnapshotOutgoingSpace",
+                                          "Stedding::SlideInSpaceList"};
+
+// What the UI thread did for one main frame that committed.
+struct FrameWork {
+  int layouts = 0;
+  int paints = 0;
+  int window_moves = 0;
+  double layout_ms = 0;
+  double paint_ms = 0;
+  // From the frame's step of the animation clock to its commit: the
+  // animations' steps, the layout, the paint and the rest.
+  double main_frame_ms = 0;
+};
+
+// Measures the frames of one animation (see the file comment). Tracing runs
+// from Start() to Stop(); the compositor given to Observe() supplies the
+// frame clock and the commits.
+class FrameMeter : public ui::CompositorAnimationObserver,
+                   public ui::CompositorObserver {
+ public:
+  FrameMeter() = default;
+  FrameMeter(const FrameMeter&) = delete;
+  FrameMeter& operator=(const FrameMeter&) = delete;
+  ~FrameMeter() override { StopObserving(); }
+
+  // Starts tracing the views' events and observing `compositor`.
+  void Start(ui::Compositor* compositor) {
+    StartTracing();
+    Observe(compositor);
+  }
+
+  void StartTracing() {
+    base::RunLoop started;
+    CHECK(content::TracingController::GetInstance()->StartTracing(
+        base::trace_event::TraceConfig("views,ui", ""), started.QuitClosure()));
+    started.Run();
+    timer_ = base::ElapsedTimer();
+  }
+
+  void Observe(ui::Compositor* compositor) {
+    StopObserving();
+    compositor_ = compositor;
+    refresh_rate_ = compositor->refresh_rate();
+    compositor->AddObserver(this);
+    compositor->AddAnimationObserver(this);
+  }
+
+  // Stops tracing and reads the trace.
+  void Stop() {
+    elapsed_ = timer_.Elapsed();
+    StopObserving();
+    std::string json;
+    base::RunLoop stopped;
+    CHECK(content::TracingController::GetInstance()->StopTracing(
+        content::TracingController::CreateStringEndpoint(base::BindOnce(
+            [](std::string* out, base::OnceClosure quit,
+               std::unique_ptr<std::string> trace) {
+              *out = std::move(*trace);
+              std::move(quit).Run();
+            },
+            &json, stopped.QuitClosure()))));
+    stopped.Run();
+    Read(json);
+  }
+
+  // Frames the compositor began while observed.
+  int steps() const { return steps_; }
+  int commits() const { return static_cast<int>(frames_.size()); }
+  // When each frame the compositor presented while observed reached the
+  // screen.
+  const std::vector<base::TimeTicks>& presented() const { return presented_; }
+  const std::vector<FrameWork>& frames() const { return frames_; }
+
+  int MaxLayouts() const { return Max(&FrameWork::layouts); }
+  int MaxPaints() const { return Max(&FrameWork::paints); }
+  // What the UI thread did inside the test's bracket (Bracket()): its
+  // length, and the time of the outermost layouts and paints and of
+  // Stedding's own steps in it.
+  std::string BracketBreakdown() const {
+    std::string out;
+    for (const Span& bracket : spans_) {
+      if (bracket.name != kBracket) {
+        continue;
+      }
+      std::map<std::string, double> inside;
+      double layout_end = -1, paint_end = -1;
+      for (const Span& span : spans_) {
+        if (span.start < bracket.start || span.end > bracket.end ||
+            &span == &bracket) {
+          continue;
+        }
+        if (span.name == kPaint) {
+          if (span.start >= paint_end) {
+            inside["paint"] += span.end - span.start;
+            paint_end = span.end;
+          }
+        } else if (span.name == kRootLayout ||
+                   std::ranges::find(kViewLayouts, span.name) !=
+                       std::end(kViewLayouts)) {
+          if (span.start >= layout_end) {
+            inside["layout"] += span.end - span.start;
+            layout_end = span.end;
+          }
+        } else if (std::ranges::find(kSteddingSteps, span.name) !=
+                   std::end(kSteddingSteps)) {
+          inside[span.name] += span.end - span.start;
+        }
+      }
+      base::StrAppend(
+          &out, {"bracket ",
+                 base::StringPrintf("%.2f ms:",
+                                    (bracket.end - bracket.start) / 1000.0)});
+      for (const auto& [name, us] : inside) {
+        base::StrAppend(
+            &out, {" ", name, " ", base::StringPrintf("%.2f", us / 1000.0)});
+      }
+      base::StrAppend(&out, {";"});
+    }
+    return out;
+  }
+
+  // The layouts of the `index`th commit's frame, outermost first, each with
+  // its depth, down to `max_depth`: which views a frame laid out, and how
+  // many times.
+  std::string FrameLayouts(int index, int max_depth) const {
+    double frame_start = -1, frame_end = -1;
+    int commits = 0;
+    for (const Span& span : spans_) {
+      if (span.name == kCommit) {
+        if (commits == index) {
+          frame_end = span.start;
+          break;
+        }
+        frame_start = span.start;
+        ++commits;
+      }
+    }
+    if (frame_end < 0) {
+      return "no such frame";
+    }
+    std::string out;
+    std::vector<double> ends;
+    for (const Span& span : spans_) {
+      if (span.start < frame_start || span.start > frame_end ||
+          (span.name != kRootLayout &&
+           std::ranges::find(kViewLayouts, span.name) ==
+               std::end(kViewLayouts))) {
+        continue;
+      }
+      while (!ends.empty() && span.start >= ends.back()) {
+        ends.pop_back();
+      }
+      const int depth = static_cast<int>(ends.size());
+      ends.push_back(span.end);
+      if (depth <= max_depth) {
+        base::StrAppend(
+            &out, {" ", base::NumberToString(depth), ":",
+                   span.name == kRootLayout ? "(root)" : span.class_name});
+      }
+    }
+    return out;
+  }
+
+  // Layouts by the class of the view laid out, over the whole run.
+  const std::map<std::string, int>& laid_out() const { return laid_out_; }
+  const std::map<std::string, int>& painted() const { return painted_; }
+  int LaidOut(std::string_view class_name) const {
+    const auto it = laid_out_.find(std::string(class_name));
+    return it == laid_out_.end() ? 0 : it->second;
+  }
+
+  // One line for the log: `name`, then the run's numbers.
+  std::string Summary(std::string_view name) const {
+    double layout = 0, paint = 0, main = 0, max_layout = 0, max_paint = 0,
+           max_main = 0;
+    int layouts = 0, paints = 0, moves = 0, late = 0, busy = 0;
+    const double vsync_ms = refresh_rate_ > 0 ? 1000.0 / refresh_rate_ : 0;
+    for (const FrameWork& f : frames_) {
+      if (vsync_ms > 0 && f.main_frame_ms > vsync_ms) {
+        ++late;
+      }
+      // The single-threaded compositor commits every frame it begins; the
+      // frames that laid out, painted or moved a window are the animation's.
+      if (!f.layouts && !f.paints && !f.window_moves) {
+        continue;
+      }
+      ++busy;
+      layouts += f.layouts;
+      paints += f.paints;
+      moves += f.window_moves;
+      layout += f.layout_ms;
+      paint += f.paint_ms;
+      main += f.main_frame_ms;
+      max_layout = std::max(max_layout, f.layout_ms);
+      max_paint = std::max(max_paint, f.paint_ms);
+      max_main = std::max(max_main, f.main_frame_ms);
+    }
+    const double n = std::max(1, busy);
+    double longest_gap = 0;
+    for (size_t i = 1; i < presented_.size(); ++i) {
+      longest_gap = std::max(
+          longest_gap, (presented_[i] - presented_[i - 1]).InMillisecondsF());
+    }
+    std::string line = base::StringPrintf(
+        "[motion] %s: %.0f ms, %.0f Hz, %d frames begun, %d committed, %d "
+        "busy, %zu presented (longest gap %.1f ms); per busy frame: %.1f views "
+        "laid out (max %d), %.1f painted (max %d); layout %.2f ms (max "
+        "%.2f), paint %.2f ms (max %.2f), main frame %.2f ms (max %.2f), "
+        "%d over a vsync",
+        std::string(name).c_str(), elapsed_.InMillisecondsF(), refresh_rate_,
+        steps_, commits(), busy, presented_.size(), longest_gap, layouts / n,
+        MaxLayouts(), paints / n, MaxPaints(), layout / n, max_layout,
+        paint / n, max_paint, main / n, max_main, late);
+    if (moves) {
+      base::StrAppend(&line, {"; window moves ", base::NumberToString(moves)});
+    }
+    base::StrAppend(
+        &line, {"; laid out: ", Top(laid_out_), "; painted: ", Top(painted_)});
+    return line;
+  }
+
+ private:
+  // ui::CompositorAnimationObserver:
+  void OnAnimationStep(base::TimeTicks timestamp) override {
+    TRACE_EVENT_INSTANT("views", kStep);
+    ++steps_;
+  }
+  void OnCompositingShuttingDown(ui::Compositor* compositor) override {
+    StopObserving();
+  }
+
+  // ui::CompositorObserver:
+  void OnCompositingDidCommit(ui::Compositor* compositor) override {
+    TRACE_EVENT_INSTANT("views", kCommit);
+  }
+  void OnDidPresentCompositorFrame(
+      ui::Compositor* compositor,
+      uint32_t frame_token,
+      const gfx::PresentationFeedback& feedback) override {
+    if (!feedback.failed()) {
+      presented_.push_back(feedback.timestamp);
+    }
+  }
+
+  void StopObserving() {
+    if (!compositor_) {
+      return;
+    }
+    compositor_->RemoveAnimationObserver(this);
+    compositor_->RemoveObserver(this);
+    compositor_ = nullptr;
+  }
+
+  static std::string ClassOf(const TraceEvent& event) {
+    std::string name;
+    event.GetArgAsString("class", &name);
+    return name.empty() ? std::string("?") : name;
+  }
+
+  void Read(const std::string& json) {
+    std::unique_ptr<trace_analyzer::TraceAnalyzer> analyzer =
+        trace_analyzer::TraceAnalyzer::Create(json);
+    CHECK(analyzer);
+    Query wanted =
+        Query::EventNameIs(kStep) || Query::EventNameIs(kCommit) ||
+        Query::EventNameIs(kRootLayout) || Query::EventNameIs(kPaint) ||
+        Query::EventNameIs(kWindowMove) || Query::EventNameIs(kBracket);
+    for (const char* layout : kViewLayouts) {
+      wanted = wanted || Query::EventNameIs(layout);
+    }
+    for (const char* step : kSteddingSteps) {
+      wanted = wanted || Query::EventNameIs(step);
+    }
+    trace_analyzer::TraceEventVector events;
+    analyzer->FindEvents(wanted, &events);
+    std::ranges::stable_sort(events, {}, &TraceEvent::timestamp);
+
+    FrameWork frame;
+    double step_at = -1;
+    double layout_end = -1;
+    double paint_end = -1;
+    for (const TraceEvent* const event : events) {
+      const std::string& name = event->name;
+      const double end = event->timestamp + event->duration;
+      spans_.push_back({name, event->timestamp, end, ClassOf(*event)});
+      if (name == kBracket ||
+          std::ranges::find(kSteddingSteps, name) != std::end(kSteddingSteps)) {
+        continue;
+      }
+      if (name == kStep) {
+        step_at = event->timestamp;
+      } else if (name == kCommit) {
+        frame.main_frame_ms =
+            step_at >= 0 ? (event->timestamp - step_at) / 1000.0 : 0;
+        frames_.push_back(frame);
+        frame = FrameWork();
+        step_at = -1;
+      } else if (name == kPaint) {
+        ++frame.paints;
+        ++painted_[ClassOf(*event)];
+        if (event->timestamp >= paint_end) {
+          frame.paint_ms += event->duration / 1000.0;
+          paint_end = end;
+        }
+      } else if (name == kWindowMove) {
+        ++frame.window_moves;
+      } else {
+        // A layout: of a view, or the root of a widget.
+        ++frame.layouts;
+        ++laid_out_[name == kRootLayout ? std::string("(root)")
+                                        : ClassOf(*event)];
+        if (event->timestamp >= layout_end) {
+          frame.layout_ms += event->duration / 1000.0;
+          layout_end = end;
+        }
+      }
+    }
+  }
+
+  int Max(int FrameWork::* field) const {
+    int most = 0;
+    for (const FrameWork& f : frames_) {
+      most = std::max(most, f.*field);
+    }
+    return most;
+  }
+
+  // The twelve classes counted most, with their counts.
+  static std::string Top(const std::map<std::string, int>& counts) {
+    std::vector<std::pair<int, std::string>> sorted;
+    for (const auto& [name, count] : counts) {
+      sorted.emplace_back(count, name);
+    }
+    std::ranges::sort(sorted, std::greater<>());
+    std::string out;
+    for (size_t i = 0; i < sorted.size() && i < 12; ++i) {
+      base::StrAppend(&out, {i ? ", " : "", sorted[i].second, " ",
+                             base::NumberToString(sorted[i].first)});
+    }
+    return out;
+  }
+
+  raw_ptr<ui::Compositor> compositor_ = nullptr;
+  float refresh_rate_ = 0;
+  base::ElapsedTimer timer_;
+  base::TimeDelta elapsed_;
+  int steps_ = 0;
+  std::vector<base::TimeTicks> presented_;
+  std::vector<FrameWork> frames_;
+  // Every event read, by name, start and end in microseconds.
+  struct Span {
+    std::string name;
+    double start = 0;
+    double end = 0;
+    std::string class_name;
+  };
+  std::vector<Span> spans_;
+  std::map<std::string, int> laid_out_;
+  std::map<std::string, int> painted_;
+};
