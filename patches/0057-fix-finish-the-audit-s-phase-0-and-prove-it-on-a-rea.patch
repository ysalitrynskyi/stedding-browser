+bool NeedsOtherJar(content::WebContents* contents,
+                   const GURL& url,
+                   const SpaceRegistry* registry,
+                   const SpaceId& id,
+                   bool essential) {
+  if (!contents) {
+    return false;
+  }
+  const std::optional<content::StoragePartitionConfig> target =
+      essential || !PageBelongsInSpaceJar(url)
+          ? std::nullopt
+          : StoragePartitionConfigForSpace(contents->GetBrowserContext(),
+                                           registry, id);
+  return !SameJar(StoragePartitionConfigForWebContents(contents), target);
