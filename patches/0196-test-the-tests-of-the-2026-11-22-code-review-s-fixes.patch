+// P33-1c, toolbar T64: while the address row slides in over the page beside
+// the rail, everything but the row stays as it is with the row hidden: the
+// rail's toggle and the rows under it too. The strip took the toolbar's
+// height through the top container's place in the slide, and on Windows the
+// toggle and the rows jumped 4 DIP up and eased back as the row came in.
+IN_PROC_BROWSER_TEST_F(CompactRowW2B24Test, TheRailStaysPutWhileTheRowSlides) {
+  ASSERT_NO_FATAL_FAILURE(CloseToTheRail());
+  VerticalTabStripRegionView* const strip =
+      browser_view()->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(strip);
+  VerticalTabStripTopContainer* const rail_top =
+      strip->top_button_container_for_testing();
+  ASSERT_TRUE(rail_top);
+  views::View* const toggle = rail_top->GetCollapseButton();
+  ASSERT_TRUE(toggle && toggle->IsDrawn());
+  const gfx::Rect toggle_hidden = InWindow(toggle);
+  const gfx::Rect top_row_hidden = InWindow(rail_top);
+
+  ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                     widget()->GetNativeWindow());
+  ASSERT_NO_FATAL_FAILURE(RevealFromTheTop(generator));
+  for (const double shown : {0.1, 0.25, 0.4, 0.5, 0.6, 0.75, 0.9, 1.0}) {
+    SCOPED_TRACE(testing::Message() << "the row " << shown << " in");
+    HoldAt(shown);
+    ASSERT_TRUE(reveal()->OverPage()) << "the row went";
+    EXPECT_EQ(toggle_hidden, InWindow(toggle)) << "the rail's toggle moved";
+    EXPECT_EQ(top_row_hidden, InWindow(rail_top))
+        << "the rail's top row moved, and its rows with it";
+  }
+}
+
+// P33-1d, toolbar T64, T16: while the row is over the page but has not yet
+// reached the card's top -- the start of its slide in, the end of its slide
+// away -- the row is not the card's top. The page keeps its rounded top on
+// the window's ground, and the window paints no page colour into the gutter
+// above it: the row draws its own bar as it comes (PaintOverlayPageBar). The
+// page's top had been cut square and the gutter painted in its colour.
+IN_PROC_BROWSER_TEST_F(CompactRowW2B24Test,
+                       TheCardKeepsItsRoundedTopUntilTheRowReachesIt) {
+  ASSERT_NO_FATAL_FAILURE(CloseToTheRail());
+  content::WebContents* const page =
+      browser()->GetTabStripModel()->GetActiveWebContents();
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return page->CompletedFirstVisuallyNonEmptyPaint() && !page->IsLoading();
+  }));
+  stedding::PageThemeColorController* const colours =
+      stedding::PageThemeColorController::From(browser());
+  ASSERT_TRUE(colours);
+  ui::test::EventGenerator generator(views::GetRootWindow(widget()),
+                                     widget()->GetNativeWindow());
+  ASSERT_NO_FATAL_FAILURE(RevealFromTheTop(generator));
+
+  views::View* const top = browser_view()->top_container();
+  MultiContentsView* const card = browser_view()->multi_contents_view();
+  ASSERT_TRUE(top && card);
+  int checked = 0;
+  for (int step = 1; step <= 20; ++step) {
+    const double shown = step * 0.02;
+    // Set again before each frame, in the same turn as the frame's layout:
+    // nothing reads the page's top edge in between.
+    colours->SetColorForTesting(kPageColourW2B24);
+    HoldAt(shown);
+    ASSERT_TRUE(reveal()->OverPage()) << "the row went at " << shown;
+    ASSERT_TRUE(colours->color().has_value());
+    const gfx::Rect row = InWindow(top);
+    const int page_top = Page().y();
+    if (row.bottom() >= page_top) {
+      continue;
+    }
+    ++checked;
+    SCOPED_TRACE(testing::Message()
+                 << "the row " << shown << " in, at " << row.ToString()
+                 << ", the page from " << page_top);
+    const gfx::RoundedCornersF corners = card->GetBackgroundRadii();
+    EXPECT_GT(corners.upper_left(), 0.f) << "the page's top is cut square";
+    EXPECT_GT(corners.upper_right(), 0.f) << "the page's top is cut square";
+    const gfx::RectF surface = stedding::PageBarSurface(browser_view());
+    EXPECT_TRUE(surface.IsEmpty() || surface.bottom() <= row.bottom())
+        << "the page's colour runs below the row, into the gutter: "
+        << surface.ToString();
+  }
+  EXPECT_GT(checked, 0) << "the row was over the page's top at every frame";
+}
