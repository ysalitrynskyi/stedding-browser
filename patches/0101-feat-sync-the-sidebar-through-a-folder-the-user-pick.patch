+#include <set>
+#include <string>
+#include <vector>
+
+#include "chrome/browser/ui/spaces/sidebar_sync_state.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace spaces::sidebar_sync {
+
+// docs/features/sidebar-file.md Sf17, Sf39: a window that takes part in
+// sync: an ordinary window of `profile` that follows the profile's Spaces.
+// Never a Blank Window, a private window, the little window or a peek.
+bool IsRegistryWindow(BrowserWindowInterface* window, Profile* profile);
+std::vector<BrowserWindowInterface*> RegistryWindows(Profile* profile);
+
+// Sf12, Sf36: the synced sidebar as this install shows it now -- the
+// profile's Spaces with their name, icon, colours and own session; every
+// registry window's Space pins, pinned folders and essentials, with each
+// pin's home and own name and its place -- under the ids `resolved` gives
+// them. A pin or an essential with no token gets one. Open tabs, titles,
+// addresses, splits and collapsed states are not read.
+LocalView BuildLocalView(Profile* profile,
+                         const std::map<std::string, std::string>& resolved);
+
+// The synced id of `tab` (its canonical "tab:<token>"), empty when it has
+// no token.
+std::string SyncIdOfTab(const tabs::TabInterface* tab,
+                        const std::map<std::string, std::string>& resolved);
+
+// Sf18: the ids open in a little window or a peek of `profile`: a pin moved
+// there is a move, not a deletion.
+std::set<std::string> IdsOutsideRegistryWindows(
+    Profile* profile,
+    const std::map<std::string, std::string>& resolved);
+
+// Sf18: `id` and every folder it sat in, as `view` had them.
+std::vector<std::string> WithEnclosingFolders(const LocalView& view,
+                                              const std::string& id);
+
+}  // namespace spaces::sidebar_sync
+
+#endif  // CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_TRACKER_H_
