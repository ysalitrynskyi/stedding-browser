+// pins H3 (BACKLOG S-435): a quit begun while a pin's page asks "Leave site?"
+// waits for the same answer, as a window close does. Stay keeps the browser
+// and the pin; Leave goes on with the quit. Leave put the pin to sleep and left
+// the browser open, the quit forgotten.
+IN_PROC_BROWSER_TEST_F(SidebarClickTest,
+                       AQuitWhileAPinAsksLeaveSiteTakesTheAnswer) {
+  const GURL asks =
+      embedded_test_server()->GetURL("home.test", "/beforeunload.html");
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  TabStripModel* const tabs = tab_strip_model();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), asks));
+  ASSERT_EQ(1, tabs->count());
+  tabs::TabInterface* const pin = tabs->GetActiveTab();
+  model->SetSpacePinned(pin, true);
+  content::WebContents* const page = pin->GetContents();
+  content::PrepContentsForBeforeUnloadTest(page);
+  BrowserWindowInterface* const window = browser();
+
+  {
+    SCOPED_TRACE("Stay keeps the browser and the pin");
+    chrome::ExecuteCommand(window, IDC_CLOSE_TAB);  // Cmd-W
+    javascript_dialogs::AppModalDialogController* const dialog =
+        ui_test_utils::WaitForAppModalDialog();
+    ASSERT_TRUE(dialog);
+    chrome::CloseAllBrowsersAndQuit();
+    ASSERT_TRUE(browser_shutdown::IsTryingToQuit());
+    dialog->view()->CancelAppModalDialog();  // Stay.
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return !browser_shutdown::IsTryingToQuit(); }))
+        << "Stay did not cancel the quit";
+    EXPECT_EQ(page, pin->GetContents()) << "Stay unloaded the pin";
+    EXPECT_FALSE(page->WasDiscarded());
+    EXPECT_TRUE(model->IsSpacePinned(pin));
+  }
+
+  {
+    SCOPED_TRACE("Leave goes on with the quit");
+    chrome::ExecuteCommand(window, IDC_CLOSE_TAB);  // Cmd-W
+    javascript_dialogs::AppModalDialogController* const dialog =
+        ui_test_utils::WaitForAppModalDialog();
+    ASSERT_TRUE(dialog);
+    chrome::CloseAllBrowsersAndQuit();
+    ASSERT_TRUE(browser_shutdown::IsTryingToQuit());
+    dialog->view()->AcceptAppModalDialog();  // Leave.
+    ui_test_utils::WaitForBrowserToClose(window);
+  }
+}
+
 // The tab menu fits each kind of row, its Edit Pinned Address opens over the
 // window, and the range a Shift-click selects, which the menu counts and
 // Cmd-W closes, holds only the rows shown.
@@ -3433,4 +3485,158 @@ IN_PROC_BROWSER_TEST_F(SidebarSelectionTest,
   }
 }
 
+// tabs R20 (the owner, 2026-11-09): a Shift-click selects every row from the
+// anchor to the row clicked, as the sidebar draws them, whatever the rows are
+// and wherever the anchor came from. Each case starts from one plain click.
+IN_PROC_BROWSER_TEST_F(SidebarSelectionTest, AShiftClickTakesTheRowsBetween) {
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  tabs::TabInterface* const a = Open("a.test");
+  tabs::TabInterface* const b = Open("b.test");
+  tabs::TabInterface* const c = Open("c.test");
+  tabs::TabInterface* const d = Open("d.test");
+  WaitForRowsToSettle();
+
+  const auto selected = [&]() {
+    std::string out;
+    for (int i = 0; i < tab_strip_model()->count(); ++i) {
+      if (tab_strip_model()->IsTabSelected(i)) {
+        out += base::NumberToString(i) + " ";
+      }
+    }
+    return out + "(active " +
+           base::NumberToString(tab_strip_model()->active_index()) + ")";
+  };
+  const auto expect_selected = [&](std::vector<tabs::TabInterface*> in,
+                                   std::vector<tabs::TabInterface*> out) {
+    for (tabs::TabInterface* const tab : in) {
+      EXPECT_TRUE(tab_strip_model()->IsTabSelected(Index(tab)))
+          << "tab " << Index(tab) << " is not selected; selected: "
+          << selected();
+    }
+    for (tabs::TabInterface* const tab : out) {
+      EXPECT_FALSE(tab_strip_model()->IsTabSelected(Index(tab)))
+          << "tab " << Index(tab) << " is selected; selected: " << selected();
+    }
+  };
+  const auto centre = [&](tabs::TabInterface* tab) {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    TabView* const row = RowFor(Index(tab));
+    CHECK(row);
+    return row->GetBoundsInScreen().CenterPoint();
+  };
+
+  {
+    SCOPED_TRACE("the active row is the anchor, with no click first");
+    ASSERT_EQ(d, tab_strip_model()->GetActiveTab());
+    ClickAt(centre(b), ui::EF_SHIFT_DOWN);
+    expect_selected({b, c, d}, {a});
+  }
+  {
+    SCOPED_TRACE("a click, then a Shift-click below");
+    ClickAt(centre(a));
+    ClickAt(centre(c), ui::EF_SHIFT_DOWN);
+    expect_selected({a, b, c}, {d});
+  }
+  {
+    SCOPED_TRACE("a click, then a Shift-click above");
+    ClickAt(centre(d));
+    ClickAt(centre(a), ui::EF_SHIFT_DOWN);
+    expect_selected({a, b, c, d}, {});
+  }
+  {
+    SCOPED_TRACE("rows asleep");
+    ClickAt(centre(a));
+    stedding::SleepTabList({b, c, d});
+    WaitForRowsToSettle();
+    ClickAt(centre(d), ui::EF_SHIFT_DOWN);
+    expect_selected({a, b, c, d}, {});
+  }
+  {
+    SCOPED_TRACE("Space pins");
+    ClickAt(centre(a));
+    model->SetSpacePinned(b, true);
+    model->SetSpacePinned(c, true);
+    model->SetSpacePinned(d, true);
+    WaitForRowsToSettle();
+    ClickAt(centre(b));
+    ClickAt(centre(d), ui::EF_SHIFT_DOWN);
+    expect_selected({b, c, d}, {a});
+  }
+  {
+    SCOPED_TRACE("a pin to a row under the Clear line");
+    ClickAt(centre(c));
+    ClickAt(centre(a), ui::EF_SHIFT_DOWN);
+    expect_selected({c, d, a}, {b});
+  }
+  {
+    SCOPED_TRACE("after a Space switch and back: the row landed on");
+    const spaces::SpaceId home = model->active_id();
+    const spaces::SpaceId work = model->AddSpace("Work", SK_ColorBLUE)->id();
+    ASSERT_TRUE(model->SetActiveSpace(work));
+    ASSERT_TRUE(model->SetActiveSpace(home));
+    WaitForRowsToSettle();
+    ClickAt(centre(b), ui::EF_SHIFT_DOWN);
+    EXPECT_LT(1u, tab_strip_model()->selection_model().size())
+        << "selected: " << selected();
+  }
+  {
+    SCOPED_TRACE("essentials");
+    model->SetSpacePinned(b, false);
+    model->SetSpacePinned(c, false);
+    model->SetSpacePinned(d, false);
+    tab_strip_model()->SetTabPinned(Index(b), true);
+    tab_strip_model()->SetTabPinned(Index(c), true);
+    tab_strip_model()->SetTabPinned(Index(d), true);
+    WaitForRowsToSettle();
+    ClickAt(centre(b));
+    ClickAt(centre(d), ui::EF_SHIFT_DOWN);
+    expect_selected({b, c, d}, {});
+  }
+}
