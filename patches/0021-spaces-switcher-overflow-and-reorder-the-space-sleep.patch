+++ b/chrome/browser/ui/views/spaces/space_switcher_rules.h
@@ -0,0 +1,31 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_RULES_H_
+#define CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_RULES_H_
+
+#include <cstddef>
+
+namespace spaces {
+
+// The switcher row's metrics (space_switcher_view.cc): a chip, the gap
+// between chips, the row's side inset, and the dot an inactive chip shrinks
+// to at overflow (docs/features/spaces.md B24).
+inline constexpr int kSwitcherChip = 24;
+inline constexpr int kSwitcherChipGap = 12;
+inline constexpr int kSwitcherRowInset = 12;
+inline constexpr int kSwitcherDot = 6;
+
+// True when `chip_count` chips plus the "+" would not fit a row `row_width`
+// wide at full size.
+bool SwitcherOverflows(int row_width, size_t chip_count);
+
+// The width a chip takes: full while the row has room, while it is the
+// active Space, or while the pointer rests on the row (B25); a dot
+// otherwise.
+int SwitcherChipWidth(bool overflow, bool active, bool row_hovered);
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_VIEWS_SPACES_SPACE_SWITCHER_RULES_H_
