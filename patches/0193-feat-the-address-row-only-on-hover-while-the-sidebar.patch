+++ b/chrome/browser/ui/stedding/address_row_rules_unittest.cc
@@ -107,6 +107,50 @@ TEST(AddressRowRulesTest, Visibility) {
     signals.override = false;
     EXPECT_TRUE(ShouldShowAddressRow(signals));
   }
+  // T64 (GitHub issue 120): "Show the address row only on hover" hides the
+  // row with the collapsed sidebar, Windows' caption buttons or not (they go
+  // to the window's corner), and shows it while it is brought in over the
+  // page. A localhost page, shift-cmd-D and the row beside the camera keep
+  // their word; the open sidebar keeps the row.
+  struct CompactCase {
+    const char* name;
+    bool collapsed;
+    bool revealed;
+    bool localhost;
+    bool caption_buttons_over_row;
+    std::optional<bool> override;
+    bool show;
+  };
+  const CompactCase kCompactCases[] = {
+      {"collapsed: hidden", true, false, false, false, std::nullopt, false},
+      {"T22: the caption buttons do not keep it", true, false, false, true,
+       std::nullopt, false},
+      {"brought in: shown", true, true, false, false, std::nullopt, true},
+      {"open: shown", false, false, false, false, std::nullopt, true},
+      {"T11: localhost keeps it", true, false, true, false, std::nullopt,
+       true},
+      {"T10: the toggle shows it", true, false, false, false, true, true},
+      {"T10: the toggle hides it", true, true, false, false, false, false},
+  };
+  for (const CompactCase& row : kCompactCases) {
+    SCOPED_TRACE(row.name);
+    AddressRowSignals signals;
+    signals.hide_in_compact = true;
+    signals.sidebar_collapsed = row.collapsed;
+    signals.sidebar_open = !row.collapsed;
+    signals.revealed = row.revealed;
+    signals.localhost = row.localhost;
+    signals.caption_buttons_over_row = row.caption_buttons_over_row;
+    signals.override = row.override;
+    EXPECT_EQ(row.show, ShouldShowAddressRow(signals));
+  }
+  {
+    AddressRowSignals signals;
+    signals.hide_in_compact = true;
+    signals.sidebar_collapsed = true;
+    signals.camera_row = true;
+    EXPECT_TRUE(ShouldShowAddressRow(signals)) << "T57 beside the camera";
+  }
   // Which pages are localhost pages is the local-tabs rule, tested with it
   // (LocalPagesTest.LocalIsTheLoopbackHostsOverHttp).
 }
