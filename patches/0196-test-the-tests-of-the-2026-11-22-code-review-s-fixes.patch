+// P22-1a, peek P26: a peek's page is a tab to extensions, and its close a
+// tab removed, also when the pin under it slept meanwhile. A sleep replaces
+// the pin's page, and the close then told extensions nothing: they kept a
+// tab id that no longer existed.
+IN_PROC_BROWSER_TEST_F(PeekSleepW2B18Test,
+                       APeekWhosePinSleptIsRemovedWhenItCloses) {
+  extensions::TestExtensionDir dir;
+  dir.WriteManifest(R"({
+      "name": "Hears the tabs",
+      "version": "1",
+      "manifest_version": 3,
+      "background": {"service_worker": "background.js"},
+      "permissions": ["tabs"]
+  })");
+  dir.WriteFile(FILE_PATH_LITERAL("background.js"), R"(
+      const heard = [];
+      chrome.tabs.onCreated.addListener(
+          tab => heard.push('created ' + tab.id));
+      chrome.tabs.onRemoved.addListener(id => heard.push('removed ' + id));
+      self.told = () => heard.join(',');
+  )");
+  extensions::ChromeTestExtensionLoader loader(browser()->GetProfile());
+  scoped_refptr<const extensions::Extension> extension =
+      loader.LoadExtension(dir.UnpackedPath());
+  ASSERT_TRUE(extension);
+
+  ASSERT_NO_FATAL_FAILURE(OpenSpacePin(Url("b.test", "/title3.html")));
+  tabs::TabInterface* const pin = tab();
+  ASSERT_TRUE(content::ExecJs(contents(),
+                              "document.getElementById('link').click();"));
+  stedding::PeekOverlay* const peek = WaitForPeek(pin);
+  ASSERT_TRUE(peek);
+  const std::string page_id = base::NumberToString(
+      sessions::SessionTabHelper::IdForTab(peek->page()).id());
+  std::string told;
+  ASSERT_TRUE(HeardW2B18(browser()->GetProfile(), extension->id(),
+                         "created " + page_id, told))
+      << "the extension was not told of the peek's page: " << told;
+
+  // Another tab on screen, and the pin sleeps: Sleep Other Tabs, the
+  // Space's timer and the idle sweep all sleep through SleepTabList.
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), Url("c.test", "/title1.html"),
+      WindowOpenDisposition::kNewForegroundTab,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  ASSERT_NE(pin, tab());
+  stedding::SleepTabList({pin});
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return pin->GetContents() && pin->GetContents()->WasDiscarded();
+  })) << "the pin did not sleep";
+
+  // Back to the pin, and the peek closes: by the wake's reload, or by its
+  // close button.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(pin));
+  if (stedding::PeekOverlay* const still =
+          stedding::PeekOverlay::ForSource(pin)) {
+    Press(still->view()->close_button());
+  }
+  ASSERT_TRUE(WaitForNoPeek(pin));
+  EXPECT_TRUE(HeardW2B18(browser()->GetProfile(), extension->id(),
+                         "removed " + page_id, told))
+      << "the extension was not told the peek's page closed: " << told;
+}
+
+// The logins in the profile's own store.
+std::vector<password_manager::StoredCredential> LoginsW2B18(Profile* profile) {
+  scoped_refptr<password_manager::PasswordStoreInterface> store =
+      ProfilePasswordStoreFactory::GetForProfile(
+          profile, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!store) {
+    ADD_FAILURE() << "no password store";
+    return {};
+  }
+  password_manager::PasswordStoreResultsObserver observer;
+  store->GetAllLogins(observer.GetWeakPtr());
+  return observer.WaitForResults();
+}
+
+std::optional<std::u16string> PasswordForW2B18(Profile* profile,
+                                               std::string_view realm,
+                                               std::u16string_view username) {
+  for (const password_manager::StoredCredential& login :
+       LoginsW2B18(profile)) {
+    if (login.signon_realm == realm && login.username_value == username) {
+      return login.password_value.value();
+    }
+  }
+  return std::nullopt;
+}
+
+class PasswordImportW2B18Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+  }
+
+  void TearDownOnMainThread() override {
+    {
+      base::ScopedAllowBlockingForTesting allow_blocking;
+      EXPECT_TRUE(dir_.Delete());
+    }
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  // Saves a login on the form at `url` into the profile's own store.
+  void Save(std::string_view url,
+            std::string_view realm,
+            std::u16string_view username,
+            std::u16string_view password) {
+    scoped_refptr<password_manager::PasswordStoreInterface> store =
+        ProfilePasswordStoreFactory::GetForProfile(
+            browser()->GetProfile(), ServiceAccessType::EXPLICIT_ACCESS);
+    ASSERT_TRUE(store);
+    password_manager::PasswordForm form;
+    form.url = GURL(url);
+    form.signon_realm = std::string(realm);
+    form.username_value = std::u16string(username);
+    form.password_value =
+        password_manager::PasswordString(std::u16string(password));
+    form.in_store = password_manager::PasswordForm::Store::kProfileStore;
+    base::RunLoop added;
+    store->AddLogin(password_manager::FromPasswordForm(std::move(form)),
+                    added.QuitClosure());
+    added.Run();
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+// P23-1e, import I39, I42: a row saved already with its password, whose
+// site and username also have a saved login with another password, is
+// counted as saved already, and the new logins beside it as added. Chromium's
+// importer takes such a row as a conflict and does not count it as imported,
+// and the line said one login fewer had come in: none, for one new login.
+IN_PROC_BROWSER_TEST_F(PasswordImportW2B18Test,
+                       ARowWithTwoSavedPasswordsLeavesTheCountWhole) {
+  Profile* const profile = browser()->GetProfile();
+  // One site and username saved on two forms, with two passwords.
+  ASSERT_NO_FATAL_FAILURE(Save("https://pair-login.example/first",
+                               "https://pair-login.example/", u"ann", u"one"));
+  ASSERT_NO_FATAL_FAILURE(Save("https://pair-login.example/second",
+                               "https://pair-login.example/", u"ann", u"two"));
+  ASSERT_EQ(2u, LoginsW2B18(profile).size());
+
+  base::FilePath folder;
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    folder = dir_.GetPath().AppendASCII("Pair Export");
+    ASSERT_TRUE(base::CreateDirectory(folder));
+    ASSERT_TRUE(base::WriteFile(
+        folder.AppendASCII("Passwords.csv"),
+        "Title,URL,Username,Password,Notes,OTPAuth\n"
+        "a,https://pair-login.example/,ann,one,,\n"
+        "b,https://pair-new.example/,bob,three,,\n"));
+  }
+  auto importer = std::make_unique<stedding::SafariExportImporter>();
+  base::test::TestFuture<stedding::SafariExportSummary> prepared;
+  importer->Prepare(
+      folder, prepared.GetCallback<const stedding::SafariExportSummary&>());
+  ASSERT_TRUE(prepared.Wait());
+  stedding::SafariExportParts parts;
+  parts.passwords = true;
+  base::test::TestFuture<stedding::SafariExportResult> done;
+  stedding::SafariExportImporter::Commit(
+      std::move(importer), *profile, parts,
+      done.GetCallback<const stedding::SafariExportResult&>());
+  const stedding::SafariExportResult result = done.Get();
+
+  EXPECT_EQ(1u, result.passwords.already_saved);
+  EXPECT_EQ(1u, result.passwords.added) << "the new login was not counted";
+  EXPECT_EQ(0u, result.passwords.kept);
+  EXPECT_EQ(u"three",
+            PasswordForW2B18(profile, "https://pair-new.example/", u"bob"));
+  EXPECT_EQ(3u, LoginsW2B18(profile).size())
+      << "a saved login was changed, or one came in twice";
+}
+
+}  // namespace
