+// A Space icon that reports hover, so the row can name it above.
+class SpaceIconButton : public views::LabelButton {
+  METADATA_HEADER(SpaceIconButton, views::LabelButton)
+
+ public:
+  SpaceIconButton(PressedCallback pressed,
+                  std::u16string icon,
+                  base::RepeatingCallback<void(bool)> hovered)
+      : views::LabelButton(std::move(pressed), std::move(icon)),
+        hovered_(std::move(hovered)) {}
+  ~SpaceIconButton() override = default;
+
+  void OnMouseEntered(const ui::MouseEvent& event) override {
+    views::LabelButton::OnMouseEntered(event);
+    hovered_.Run(true);
+  }
+  void OnMouseExited(const ui::MouseEvent& event) override {
+    views::LabelButton::OnMouseExited(event);
+    hovered_.Run(false);
+  }
+
+ private:
+  base::RepeatingCallback<void(bool)> hovered_;
+};
+
+BEGIN_METADATA(SpaceIconButton)
+END_METADATA
+
