diff --git a/components/sessions/content/session_tab_helper_unittest.cc b/components/sessions/content/session_tab_helper_unittest.cc
new file mode 100644
index 0000000000000..59b0bbeb573ec
--- /dev/null
+++ b/components/sessions/content/session_tab_helper_unittest.cc
@@ -0,0 +1,221 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/sessions/content/session_tab_helper.h"
+
+#include <string>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "components/sessions/content/session_tab_helper_delegate.h"
+#include "components/sessions/core/serialized_navigation_entry.h"
+#include "components/sessions/core/serialized_user_agent_override.h"
+#include "components/sessions/core/session_id.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/navigation_simulator.h"
+#include "content/public/test/test_renderer_host.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace sessions {
+namespace {
+
+// Keeps every entry the helper writes to the session, and when it was
+// written.
+class RecordingDelegate : public SessionTabHelperDelegate {
+ public:
+  void SetTabUserAgentOverride(
+      SessionID window_id,
+      SessionID tab_id,
+      const SerializedUserAgentOverride& user_agent_override) override {}
+  void SetSelectedNavigationIndex(SessionID window_id,
+                                  SessionID tab_id,
+                                  int index) override {}
+  void UpdateTabNavigation(
+      SessionID window_id,
+      SessionID tab_id,
+      const SerializedNavigationEntry& navigation) override {
+    navigations.push_back(navigation);
+    times.push_back(base::TimeTicks::Now());
+  }
+  void TabNavigationPathPruned(SessionID window_id,
+                               SessionID tab_id,
+                               int index,
+                               int count) override {}
+  void TabNavigationPathEntriesDeleted(SessionID window_id,
+                                       SessionID tab_id) override {}
+
+  void Clear() {
+    navigations.clear();
+    times.clear();
+  }
+
+  std::vector<SerializedNavigationEntry> navigations;
+  std::vector<base::TimeTicks> times;
+};
+
+class SessionTabHelperTest : public content::RenderViewHostTestHarness {
+ protected:
+  // The clock is mocked so that the title write limit (tabs R31) can be
+  // stepped through.
+  SessionTabHelperTest()
+      : content::RenderViewHostTestHarness(
+            base::test::TaskEnvironment::TimeSource::MOCK_TIME) {}
+
+  void SetUp() override {
+    content::RenderViewHostTestHarness::SetUp();
+    SessionTabHelper::CreateForWebContents(
+        web_contents(),
+        base::BindRepeating(
+            [](RecordingDelegate* delegate, content::WebContents*)
+                -> SessionTabHelperDelegate* { return delegate; },
+            base::Unretained(&delegate_)));
+  }
+
+  content::NavigationController& controller() {
+    return web_contents()->GetController();
+  }
+
+  void SetTitle(content::NavigationEntry* entry, const std::u16string& title) {
+    web_contents()->UpdateTitleForEntry(entry, title);
+  }
+
+  RecordingDelegate delegate_;
+};
+
+// tabs R31 (BACKLOG S-229): the title a page sets is written to the session
+// when it is set, with the entry's own index. The commit wrote the entry
+// before the page had a title, and nothing else would have written it again
+// for a page that is never scrolled, changed or left.
+TEST_F(SessionTabHelperTest, ATitleThePageSetsReachesTheSession) {
+  const GURL url("https://d.test/d.html");
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(web_contents(),
+                                                             url);
+  ASSERT_FALSE(delegate_.navigations.empty());
+  EXPECT_EQ(std::u16string(), delegate_.navigations.back().title());
+  delegate_.Clear();
+
+  SetTitle(controller().GetLastCommittedEntry(), u"Page D");
+  ASSERT_EQ(1u, delegate_.navigations.size());
+  EXPECT_EQ(u"Page D", delegate_.navigations[0].title());
+  EXPECT_EQ(url, delegate_.navigations[0].virtual_url());
+  EXPECT_EQ(controller().GetLastCommittedEntryIndex(),
+            delegate_.navigations[0].index());
+}
+
+// An entry behind the current one keeps its own index: a title set for it is
+// written there, not over the page on screen.
+TEST_F(SessionTabHelperTest, AnEarlierEntrysTitleKeepsItsIndex) {
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://c.test/c.html"));
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://d.test/d.html"));
+  ASSERT_EQ(2, controller().GetEntryCount());
+  delegate_.Clear();
+
+  SetTitle(controller().GetEntryAtIndex(0), u"Page C");
+  ASSERT_EQ(1u, delegate_.navigations.size());
+  EXPECT_EQ(0, delegate_.navigations[0].index());
+  EXPECT_EQ(u"Page C", delegate_.navigations[0].title());
+  EXPECT_EQ(GURL("https://c.test/c.html"),
+            delegate_.navigations[0].virtual_url());
+}
+
+// tabs R31: a page that keeps changing its title (a clock, a blinking
+// "(1) New message") is written at most once per kTitleWriteInterval, and the
+// last title it set is written when the interval ends. Without the limit,
+// every change was a session write.
+TEST_F(SessionTabHelperTest,
+       ATitleThatKeepsChangingIsWrittenAtMostOncePerInterval) {
+  const base::TimeDelta interval = SessionTabHelper::kTitleWriteInterval;
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://clock.test/"));
+  content::NavigationEntry* entry = controller().GetLastCommittedEntry();
+  delegate_.Clear();
+
+  // The first title is written at once.
+  SetTitle(entry, u"Tick 0");
+  ASSERT_EQ(1u, delegate_.navigations.size());
+  EXPECT_EQ(u"Tick 0", delegate_.navigations[0].title());
+
+  // Fifty more inside one second write nothing yet.
+  for (int tick = 1; tick <= 50; ++tick) {
+    task_environment()->FastForwardBy(base::Milliseconds(20));
+    SetTitle(entry, u"Tick " + base::NumberToString16(tick));
+  }
+  EXPECT_EQ(1u, delegate_.navigations.size());
+
+  // When the interval ends, the last of them is written, once, at the
+  // entry's own index.
+  task_environment()->FastForwardBy(interval);
+  ASSERT_EQ(2u, delegate_.navigations.size());
+  EXPECT_EQ(u"Tick 50", delegate_.navigations[1].title());
+  EXPECT_EQ(controller().GetLastCommittedEntryIndex(),
+            delegate_.navigations[1].index());
+  EXPECT_EQ(interval, delegate_.times[1] - delegate_.times[0]);
+
+  // A clock that ticks every second for a minute: no two writes closer than
+  // the interval, and the session ends with the last time it showed.
+  delegate_.Clear();
+  constexpr int kSeconds = 60;
+  for (int second = 0; second < kSeconds; ++second) {
+    task_environment()->FastForwardBy(base::Seconds(1));
+    SetTitle(entry, u"Clock " + base::NumberToString16(second));
+  }
+  task_environment()->FastForwardBy(interval);
+  ASSERT_FALSE(delegate_.navigations.empty());
+  EXPECT_LE(delegate_.navigations.size(),
+            static_cast<size_t>(kSeconds / interval.InSeconds() + 1));
+  for (size_t i = 1; i < delegate_.times.size(); ++i) {
+    EXPECT_GE(delegate_.times[i] - delegate_.times[i - 1], interval);
+  }
+  EXPECT_EQ(u"Clock " + base::NumberToString16(kSeconds - 1),
+            delegate_.navigations.back().title());
+
+  // A title that went back to the one written before the interval ended is
+  // not written again.
+  delegate_.Clear();
+  task_environment()->FastForwardBy(interval);
+  SetTitle(entry, u"Clock 0");
+  ASSERT_EQ(1u, delegate_.navigations.size());
+  SetTitle(entry, u"Clock 1");
+  SetTitle(entry, u"Clock 0");
+  task_environment()->FastForwardBy(interval);
+  EXPECT_EQ(1u, delegate_.navigations.size());
+}
+
+// tabs R31: the limit is per entry. Another entry's first title is written at
+// once, even inside the interval of the entry before it, and the title that
+// entry was still owed is written first.
+TEST_F(SessionTabHelperTest, AnotherEntrysFirstTitleIsWrittenAtOnce) {
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://c.test/c.html"));
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://d.test/d.html"));
+  ASSERT_EQ(2, controller().GetEntryCount());
+  delegate_.Clear();
+
+  SetTitle(controller().GetEntryAtIndex(0), u"Page C");
+  SetTitle(controller().GetEntryAtIndex(0), u"(1) Page C");
+  ASSERT_EQ(1u, delegate_.navigations.size());
+
+  SetTitle(controller().GetEntryAtIndex(1), u"Page D");
+  ASSERT_EQ(3u, delegate_.navigations.size());
+  EXPECT_EQ(0, delegate_.navigations[1].index());
+  EXPECT_EQ(u"(1) Page C", delegate_.navigations[1].title());
+  EXPECT_EQ(1, delegate_.navigations[2].index());
+  EXPECT_EQ(u"Page D", delegate_.navigations[2].title());
+
+  // Nothing is left owed.
+  task_environment()->FastForwardBy(SessionTabHelper::kTitleWriteInterval);
+  EXPECT_EQ(3u, delegate_.navigations.size());
+}
+
+}  // namespace
+}  // namespace sessions
