+  Activate(loose);
+  EXPECT_TRUE(outer_view->GetVisible());
+  EXPECT_FALSE(inner_view->GetVisible())
+      << "the collapsed folder takes the row back once another tab is active";
+  EXPECT_TRUE(IsHidden(inner_tab));
