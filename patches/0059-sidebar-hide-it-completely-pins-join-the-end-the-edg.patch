 }
 
+// Stedding (BACKLOG S-73): a translucent background is read over the frame
+// it sits on. The dark sidebar's active row is a light tint over a dark
+// ground; read as light by its own channels, it took the dark globe.
+TEST_F(DefaultFaviconModelTest, ATranslucentBackgroundIsReadOverTheFrame) {
+  const auto initializer = [&](ui::ColorProvider* provider,
+                               const ui::ColorProviderKey& key) {
+    ui::ColorMixer& mixer = provider->AddMixer();
+    mixer[ui::kColorFrameActive] = {kDarkColor};
+    mixer[ui::kColorBubbleBackground] = {SkColorSetA(kLightColor, 0x24)};
+  };
+  AddInitializer(base::BindRepeating(initializer));
+  auto* color_provider =
+      GetColorProvider(ui::ColorProviderKey::ColorMode::kDark);
+  const auto favicon_image = GetDefaultFaviconModel(ui::kColorBubbleBackground)
+                                 .Rasterize(color_provider);
+  EXPECT_TRUE(GetDefaultFaviconForColorScheme(/*is_dark=*/true)
+                  .BackedBySameObjectAs(favicon_image));
+}
