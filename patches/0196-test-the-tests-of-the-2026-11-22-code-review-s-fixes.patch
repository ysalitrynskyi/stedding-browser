diff --git a/chrome/browser/ui/stedding/audit_b19_unittest.cc b/chrome/browser/ui/stedding/audit_b19_unittest.cc
new file mode 100644
index 0000000000000..3b3ab244bc4e1
--- /dev/null
+++ b/chrome/browser/ui/stedding/audit_b19_unittest.cc
@@ -0,0 +1,314 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Safari's export (docs/features/import.md I34, I35): an archive's parts are
+// read no further than their limits, whatever sizes the archive declares for
+// them; on Windows, a file of an unzipped export that is a cloud file is
+// read, and a link is not.
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/run_loop.h"
+#include "build/build_config.h"
+#include "chrome/browser/ui/stedding/safari_export_importer.h"
+#include "components/password_manager/services/csv_password/fake_password_parser_service.h"
+#include "components/user_data_importer/content/content_bookmark_parser.h"
+#include "components/user_data_importer/content/fake_bookmark_html_parser.h"
+#include "content/public/test/browser_task_environment.h"
+#include "mojo/public/cpp/bindings/pending_remote.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/zlib/zlib.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <windows.h>
+#endif
+
+namespace stedding {
+namespace {
+
+constexpr char kBookmarksHtmlB19[] = R"(<!DOCTYPE NETSCAPE-Bookmark-file-1>
+<HTML>
+<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">
+<TITLE>Bookmarks</TITLE>
+<H1>Bookmarks</H1>
+<DT><H3 id="BookmarksBar">Favorites</H3>
+<DL><p>
+	<DT><A HREF="https://fav.example/">Fav</A>
+</DL><p>
+<DT><H3 id="com.apple.ReadingList">Reading List</H3>
+<DL><p>
+	<DT><A HREF="https://later.example/">Later</A>
+</DL><p>
+<DT><A HREF="https://loose.example/">Loose</A>
+</HTML>
+)";
+
+constexpr char kPasswordsCsvB19[] =
+    "Title,URL,Username,Password,Notes,OTPAuth\n"
+    "a,https://a.example/,ann,one,,\n"
+    "b,https://b.example/,bob,two,,\n";
+
+// 2024-01-01 in a ZIP header's MS-DOS date.
+constexpr uint16_t kDosDateB19 = ((2024 - 1980) << 9) | (1 << 5) | 1;
+
+// `data` deflated, as a ZIP archive stores a file: no zlib header.
+std::string RawDeflateB19(std::string_view data) {
+  z_stream stream = {};
+  EXPECT_EQ(Z_OK, deflateInit2(&stream, Z_DEFAULT_COMPRESSION, Z_DEFLATED,
+                               -MAX_WBITS, 8, Z_DEFAULT_STRATEGY));
+  std::string deflated(
+      deflateBound(&stream, base::checked_cast<uLong>(data.size())), '\0');
+  stream.next_in = reinterpret_cast<Bytef*>(const_cast<char*>(data.data()));
+  stream.avail_in = base::checked_cast<uInt>(data.size());
+  stream.next_out = reinterpret_cast<Bytef*>(deflated.data());
+  stream.avail_out = base::checked_cast<uInt>(deflated.size());
+  EXPECT_EQ(Z_STREAM_END, deflate(&stream, Z_FINISH));
+  deflated.resize(stream.total_out);
+  deflateEnd(&stream);
+  return deflated;
+}
+
+uint32_t Crc32B19(std::string_view data) {
+  return static_cast<uint32_t>(
+      crc32(crc32(0L, Z_NULL, 0), reinterpret_cast<const Bytef*>(data.data()),
+            base::checked_cast<uInt>(data.size())));
+}
+
+// Little-endian, as a ZIP header holds its numbers.
+void Put16B19(std::string& out, uint16_t value) {
+  out.push_back(static_cast<char>(value & 0xff));
+  out.push_back(static_cast<char>((value >> 8) & 0xff));
+}
+
+void Put32B19(std::string& out, uint32_t value) {
+  Put16B19(out, static_cast<uint16_t>(value & 0xffff));
+  Put16B19(out, static_cast<uint16_t>((value >> 16) & 0xffff));
+}
+
+// A file of an archive: what it inflates to, and the size its headers say
+// it inflates to. `data` outlives the archive's writing.
+struct ArchivedFileB19 {
+  std::string name;
+  std::string_view data;
+  uint32_t declared_size = 0;
+};
+
+// A file whose headers declare its true size.
+ArchivedFileB19 HonestFileB19(std::string name, std::string_view data) {
+  return {std::move(name), data, base::checked_cast<uint32_t>(data.size())};
+}
+
+// A ZIP archive of `files`, each deflated, its headers declaring each file's
+// `declared_size` as the size it inflates to; its checksums are right.
+std::string ArchiveOfB19(const std::vector<ArchivedFileB19>& files) {
+  std::string archive;
+  std::string directory;
+  for (const ArchivedFileB19& file : files) {
+    const std::string deflated = RawDeflateB19(file.data);
+    const uint32_t crc = Crc32B19(file.data);
+    const uint32_t offset = base::checked_cast<uint32_t>(archive.size());
+    const uint16_t name_size = base::checked_cast<uint16_t>(file.name.size());
+    // Local file header.
+    Put32B19(archive, 0x04034b50);
+    Put16B19(archive, 20);  // Version needed to extract.
+    Put16B19(archive, 0);   // Flags.
+    Put16B19(archive, 8);   // Deflated.
+    Put16B19(archive, 0);   // Time.
+    Put16B19(archive, kDosDateB19);
+    Put32B19(archive, crc);
+    Put32B19(archive, base::checked_cast<uint32_t>(deflated.size()));
+    Put32B19(archive, file.declared_size);
+    Put16B19(archive, name_size);
+    Put16B19(archive, 0);  // Extra field.
+    archive += file.name;
+    archive += deflated;
+    // Its central directory header.
+    Put32B19(directory, 0x02014b50);
+    Put16B19(directory, 20);  // Version made by.
+    Put16B19(directory, 20);  // Version needed to extract.
+    Put16B19(directory, 0);   // Flags.
+    Put16B19(directory, 8);   // Deflated.
+    Put16B19(directory, 0);   // Time.
+    Put16B19(directory, kDosDateB19);
+    Put32B19(directory, crc);
+    Put32B19(directory, base::checked_cast<uint32_t>(deflated.size()));
+    Put32B19(directory, file.declared_size);
+    Put16B19(directory, name_size);
+    Put16B19(directory, 0);  // Extra field.
+    Put16B19(directory, 0);  // Comment.
+    Put16B19(directory, 0);  // Disk.
+    Put16B19(directory, 0);  // Internal attributes.
+    Put32B19(directory, 0);  // External attributes.
+    Put32B19(directory, offset);
+    directory += file.name;
+  }
+  const uint32_t directory_offset =
+      base::checked_cast<uint32_t>(archive.size());
+  const uint16_t count = base::checked_cast<uint16_t>(files.size());
+  archive += directory;
+  // End of central directory.
+  Put32B19(archive, 0x06054b50);
+  Put16B19(archive, 0);  // This disk.
+  Put16B19(archive, 0);  // The directory's disk.
+  Put16B19(archive, count);
+  Put16B19(archive, count);
+  Put32B19(archive, base::checked_cast<uint32_t>(directory.size()));
+  Put32B19(archive, directory_offset);
+  Put16B19(archive, 0);  // Comment.
+  return archive;
+}
+
+// The bookmarks page and the passwords file, parsed in this process by the
+// parsers' own code, as the utility process would.
+class SafariArchiveLimitB19Test : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+
+  void TearDown() override {
+    bookmark_receivers_.clear();
+    csv_receivers_.clear();
+    task_environment_.RunUntilIdle();
+  }
+
+  std::unique_ptr<SafariExportImporter> MakeImporter() {
+    auto bookmark_parser =
+        std::make_unique<user_data_importer::ContentBookmarkParser>();
+    mojo::PendingRemote<user_data_importer::mojom::BookmarkHtmlParser>
+        bookmarks_remote;
+    bookmark_receivers_.push_back(
+        std::make_unique<
+            mojo::Receiver<user_data_importer::mojom::BookmarkHtmlParser>>(
+            &bookmark_html_parser_,
+            bookmarks_remote.InitWithNewPipeAndPassReceiver()));
+    bookmark_parser->SetServiceForTesting(std::move(bookmarks_remote));
+    mojo::PendingRemote<password_manager::mojom::CSVPasswordParser>
+        csv_remote;
+    csv_receivers_.push_back(
+        std::make_unique<
+            mojo::Receiver<password_manager::mojom::CSVPasswordParser>>(
+            &csv_parser_, csv_remote.InitWithNewPipeAndPassReceiver()));
+    return std::make_unique<SafariExportImporter>(std::move(bookmark_parser),
+                                                  std::move(csv_remote));
+  }
+
+  SafariExportSummary Prepare(SafariExportImporter& importer,
+                              const base::FilePath& path) {
+    SafariExportSummary summary;
+    base::RunLoop loop;
+    importer.Prepare(path, base::BindOnce(
+                               [](SafariExportSummary* out,
+                                  base::OnceClosure quit,
+                                  const SafariExportSummary& got) {
+                                 *out = got;
+                                 std::move(quit).Run();
+                               },
+                               &summary, loop.QuitClosure()));
+    loop.Run();
+    return summary;
+  }
+
+  // `files` written as an archive, export.zip.
+  base::FilePath WriteArchive(const std::vector<ArchivedFileB19>& files) {
+    const base::FilePath path = dir_.GetPath().AppendASCII("export.zip");
+    EXPECT_TRUE(base::WriteFile(path, ArchiveOfB19(files)));
+    return path;
+  }
+
+  base::ScopedTempDir dir_;
+  content::BrowserTaskEnvironment task_environment_;
+  user_data_importer::FakeBookmarkHtmlParser bookmark_html_parser_;
+  password_manager::FakePasswordParserService csv_parser_;
+  std::vector<std::unique_ptr<
+      mojo::Receiver<user_data_importer::mojom::BookmarkHtmlParser>>>
+      bookmark_receivers_;
+  std::vector<std::unique_ptr<
+      mojo::Receiver<password_manager::mojom::CSVPasswordParser>>>
+      csv_receivers_;
+};
+
+// P25-1b; import I35: an archive's bookmarks page that inflates past the
+// 32 MB limit is refused as too big, and nothing of it reaches the parser,
+// though the archive declares it 1 KB. It was inflated whole, as far as it
+// went, into the browser's memory. A part that holds what it declares is
+// still read.
+TEST_F(SafariArchiveLimitB19Test,
+       ABookmarksPageThatInflatesPastItsLimitIsRefused) {
+  const std::string big(
+      static_cast<size_t>(kMaxSafariBookmarksBytes) + 1024 * 1024, 'a');
+  const base::FilePath archive =
+      WriteArchive({{"Bookmarks.html", big, /*declared_size=*/1024},
+                    HonestFileB19("Passwords.csv", kPasswordsCsvB19)});
+  std::unique_ptr<SafariExportImporter> importer = MakeImporter();
+  const SafariExportSummary summary = Prepare(*importer, archive);
+  EXPECT_TRUE(summary.opened);
+  EXPECT_TRUE(summary.bookmarks_too_big)
+      << "the page past the limit was read as the archive declared it";
+  EXPECT_EQ(0u, summary.bookmarks);
+  EXPECT_TRUE(importer->bookmarks().empty());
+  EXPECT_LE(bookmark_html_parser_.last_html().size(), kMaxSafariBookmarksBytes)
+      << "the parser was given the page past its limit";
+  EXPECT_FALSE(summary.passwords_too_big);
+  EXPECT_FALSE(summary.passwords_unreadable);
+  EXPECT_EQ(2u, summary.passwords);
+}
+
+// P25-1b; import I35: the same for the passwords file over 1,000 KB, which
+// the archive declares 64 bytes: refused as too big, none of it kept.
+TEST_F(SafariArchiveLimitB19Test,
+       APasswordsFileThatInflatesPastItsLimitIsRefused) {
+  std::string big = "Title,URL,Username,Password,Notes,OTPAuth\n";
+  while (big.size() <= kMaxSafariPasswordsBytes + 1024) {
+    big += "x,https://x.example/,user,password,,\n";
+  }
+  const base::FilePath archive =
+      WriteArchive({HonestFileB19("Bookmarks.html", kBookmarksHtmlB19),
+                    {"Passwords.csv", big, /*declared_size=*/64}});
+  std::unique_ptr<SafariExportImporter> importer = MakeImporter();
+  const SafariExportSummary summary = Prepare(*importer, archive);
+  EXPECT_TRUE(summary.opened);
+  EXPECT_TRUE(summary.passwords_too_big)
+      << "the file past the limit was read as the archive declared it";
+  EXPECT_EQ(0u, summary.passwords);
+  EXPECT_TRUE(importer->passwords().empty());
+  EXPECT_FALSE(summary.bookmarks_too_big);
+  EXPECT_EQ(3u, summary.bookmarks);
+}
+
+#if BUILDFLAG(IS_WIN)
+// P25-1c; import I34: in an unzipped export on Windows, a cloud file -- a
+// OneDrive or iCloud Drive file, downloaded or not, which is a reparse point
+// too -- is read like any file; a symbolic link or a junction is not. Every
+// file of an export kept in OneDrive had been skipped, and the folder read
+// as holding nothing.
+TEST(SafariExportLinkB19Test, ACloudFileIsReadAndALinkIsNot) {
+  // IO_REPARSE_TAG_CLOUD and IO_REPARSE_TAG_CLOUD_6, the tags cloud files
+  // carry.
+  constexpr uint32_t kCloudTag = 0x9000001A;
+  constexpr uint32_t kCloud6Tag = 0x9000601A;
+  EXPECT_FALSE(IsSafariExportFolderLink(FILE_ATTRIBUTE_REPARSE_POINT,
+                                        kCloudTag));
+  EXPECT_FALSE(IsSafariExportFolderLink(
+      FILE_ATTRIBUTE_REPARSE_POINT | FILE_ATTRIBUTE_ARCHIVE, kCloud6Tag));
+  EXPECT_FALSE(IsSafariExportFolderLink(FILE_ATTRIBUTE_NORMAL, 0));
+  EXPECT_FALSE(IsSafariExportFolderLink(FILE_ATTRIBUTE_ARCHIVE, 0));
+  EXPECT_TRUE(IsSafariExportFolderLink(FILE_ATTRIBUTE_REPARSE_POINT,
+                                       IO_REPARSE_TAG_SYMLINK));
+  EXPECT_TRUE(IsSafariExportFolderLink(FILE_ATTRIBUTE_REPARSE_POINT,
+                                       IO_REPARSE_TAG_MOUNT_POINT));
+}
+#endif  // BUILDFLAG(IS_WIN)
+
