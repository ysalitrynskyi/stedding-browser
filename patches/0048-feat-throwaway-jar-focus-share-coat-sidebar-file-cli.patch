+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/spaces/sidebar_file.h"
+
+#include "base/token.h"
+
+namespace spaces {
+
+base::DictValue SidebarFileFromCatalog(
+    const std::vector<RegistryEntry>& spaces,
+    const std::vector<Route>& routes) {
+  base::DictValue file;
+  file.Set("kind", kSidebarFileKind);
+  file.Set("version", kSidebarFileVersion);
+  base::ListValue space_list;
+  for (const RegistryEntry& entry : spaces) {
+    base::DictValue dict;
+    dict.Set("id", entry.id.ToString());
+    dict.Set("name", entry.name);
+    dict.Set("icon", entry.icon);
+    dict.Set("color", static_cast<int>(entry.color));
+    dict.Set("color_chosen", entry.color_chosen);
+    dict.Set("isolated", !entry.profile_id.empty());
+    space_list.Append(std::move(dict));
+  }
+  file.Set("spaces", std::move(space_list));
+  file.Set("routes", RoutesToValue(routes));
+  return file;
+}
+
+bool SidebarFileToCatalog(const base::DictValue& file,
+                          std::vector<RegistryEntry>* spaces,
+                          std::vector<Route>* routes) {
+  if (!spaces || !routes) {
+    return false;
+  }
+  const std::string* const kind = file.FindString("kind");
+  if (!kind || *kind != kSidebarFileKind) {
+    return false;
+  }
+  if (file.FindInt("version").value_or(0) != kSidebarFileVersion) {
+    return false;
+  }
+  spaces->clear();
+  routes->clear();
+  if (const base::ListValue* const list = file.FindList("spaces")) {
+    for (const base::Value& item : *list) {
+      const base::DictValue* const dict = item.GetIfDict();
+      if (!dict) {
+        continue;
+      }
+      const std::string* const id_text = dict->FindString("id");
+      const std::optional<base::Token> token =
+          id_text ? base::Token::FromString(*id_text) : std::nullopt;
+      if (!token) {
+        continue;
+      }
+      const std::string* const name = dict->FindString("name");
+      RegistryEntry entry(
+          SpaceId::FromRawToken(*token), name ? *name : std::string(),
+          static_cast<SkColor>(dict->FindInt("color").value_or(0)));
+      if (const std::string* const icon = dict->FindString("icon")) {
+        entry.icon = *icon;
+      }
+      entry.color_chosen = dict->FindBool("color_chosen").value_or(false);
+      if (dict->FindBool("isolated").value_or(false)) {
+        entry.profile_id = "1";
+      }
+      spaces->push_back(std::move(entry));
+    }
+  }
+  if (const base::ListValue* const list = file.FindList("routes")) {
+    *routes = RoutesFromValue(*list);
+  }
+  return true;
+}
+
+}  // namespace spaces
