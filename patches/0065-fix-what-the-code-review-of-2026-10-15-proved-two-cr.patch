+// import I22: a row with no visit time is no visit and stays out; the
+// history service DCHECKs a time on every row it is given.
+TEST(ArcDataImporterTest, ARowWithNoVisitTimeStaysOut) {
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath path = dir.GetPath().AppendASCII("History");
+  {
+    sql::Database db(sql::Database::Tag("Test"));
+    ASSERT_TRUE(db.Open(path));
+    ASSERT_TRUE(db.Execute(
+        "CREATE TABLE urls(id INTEGER PRIMARY KEY, url LONGVARCHAR, "
+        "title LONGVARCHAR, visit_count INTEGER DEFAULT 0 NOT NULL, "
+        "typed_count INTEGER DEFAULT 0 NOT NULL, last_visit_time INTEGER, "
+        "hidden INTEGER DEFAULT 0 NOT NULL)"));
+    ASSERT_TRUE(db.Execute(
+        "INSERT INTO urls VALUES (1, 'https://example.com/', 'Example', 3, 1, "
+        "13300000000000000, 0)"));
+    ASSERT_TRUE(db.Execute(
+        "INSERT INTO urls VALUES (2, 'https://zero.example/', 'Zero', 1, 0, "
+        "0, 0)"));
+    ASSERT_TRUE(db.Execute(
+        "INSERT INTO urls VALUES (3, 'https://null.example/', 'Null', 1, 0, "
+        "NULL, 0)"));
+  }
+  const history::URLRows rows = ReadArcHistory(path);
+  ASSERT_EQ(1u, rows.size());
+  EXPECT_EQ(GURL("https://example.com/"), rows[0].url());
+  EXPECT_FALSE(rows[0].last_visit().is_null());
+}
