+// "Research / Papers", for the archive's row.
+std::string FolderTitles(const std::string& path) {
+  std::string titles;
+  for (const FolderStep& step : ParseFolderPath(path)) {
+    if (step.title.empty()) {
+      continue;
+    }
+    if (!titles.empty()) {
+      titles += " / ";
+    }
+    titles += step.title;
+  }
+  return titles;
