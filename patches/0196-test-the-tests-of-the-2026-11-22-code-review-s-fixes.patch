+// P13-1c, sidebar-file Sf17: a pin another computer dragged out of a pinned
+// folder into a new folder at the top of the run is in that new folder here,
+// and the new folder is in the run. It was made inside the folder the pin
+// had left, and the two sidebars differed for good.
+IN_PROC_BROWSER_TEST_F(SidebarSyncB11Test,
+                       APinMovedIntoANewFolderElsewhereIsNotNestedHere) {
+  ASSERT_NO_FATAL_FAILURE(Join());
+  const std::string space = model().active_id().ToString();
+  tabs::TabInterface* const moved = OpenPin();
+  ASSERT_TRUE(moved);
+  tabs::TabInterface* const stays = OpenPin();
+  ASSERT_TRUE(stays);
+  tabs::FolderTabCollection* const old_folder =
+      MakePinnedFolder({moved, stays});
+  ASSERT_TRUE(old_folder);
+  ASSERT_EQ(old_folder, moved->GetParentCollection());
+  ASSERT_EQ(old_folder, stays->GetParentCollection());
+  // Another tab in front (Sf21).
+  ASSERT_TRUE(OpenTabInFront());
+  service()->CommitForTesting();
+  const std::string old_id = spaces::FolderSyncId(old_folder->id());
+  const std::string moved_id = IdOf(moved);
+  ASSERT_TRUE(LedgerRecord(moved_id));
+  ASSERT_EQ(old_id, LedgerRecord(moved_id)->Get(sb::kFieldParent));
+
+  // On the other computer the pin goes into a new folder, at the top of the
+  // run; the folder it left keeps its other pin.
+  const tabs::FolderId made = tabs::FolderId::GenerateNew();
+  const std::string new_id = spaces::FolderSyncId(made);
+  const sb::Stamp later{NowMsB11() + 60'000, kOfficeB11};
+  sb::State office = service()->ledger_for_testing()->state;
+  sb::Record new_folder(sb::Kind::kFolder);
+  new_folder.f[sb::kFieldTitle] = sb::Field{"New", later};
+  new_folder.f[sb::kFieldIcon] = sb::Field{"", later};
+  new_folder.f[sb::kFieldParent] = sb::Field{sb::PinsListOf(space), later};
+  office.records[new_id] = new_folder;
+  office.records[moved_id].f[sb::kFieldParent] = sb::Field{new_id, later};
+  office.lists[new_id].order = {moved_id};
+  office.lists[new_id].s = later;
+  std::erase(office.lists[old_id].order, moved_id);
+  office.lists[old_id].s = later;
+  std::vector<std::string>& run = office.lists[sb::PinsListOf(space)].order;
+  run.insert(run.begin(), new_id);
+  office.lists[sb::PinsListOf(space)].s = later;
+  ASSERT_NO_FATAL_FAILURE(WriteOffice(office, 1));
+  ASSERT_NO_FATAL_FAILURE(Scan());
+
+  const tabs::TabCollection* const holder = moved->GetParentCollection();
+  ASSERT_TRUE(holder);
+  ASSERT_EQ(tabs::TabCollection::Type::FOLDER, holder->type());
+  const auto* const now_in =
+      static_cast<const tabs::FolderTabCollection*>(holder);
+  EXPECT_EQ(made.ToString(), now_in->id().ToString());
+  ASSERT_TRUE(now_in->GetParentCollection());
+  EXPECT_NE(tabs::TabCollection::Type::FOLDER,
+            now_in->GetParentCollection()->type())
+      << "the new folder was made inside the folder the pin left";
+  EXPECT_TRUE(model().IsSpacePinned(moved));
+  EXPECT_EQ(old_folder, stays->GetParentCollection());
+  const sb::LocalView view = sb::BuildLocalView(browser()->GetProfile(), {});
+  ASSERT_TRUE(view.items.contains(new_id));
+  EXPECT_EQ(sb::PinsListOf(space),
+            view.items.at(new_id).fields.at(sb::kFieldParent));
+}
