+  Profile* const profile = browser()->GetProfile();
+  SearchEngineChoiceDialogService* const dialogs =
+      SearchEngineChoiceDialogServiceFactory::GetForProfile(profile);
+  search_engines::SearchEngineChoiceService* const choices =
+      search_engines::SearchEngineChoiceServiceFactory::GetForProfile(profile);
+  TemplateURLService* const template_urls =
+      TemplateURLServiceFactory::GetForProfile(profile);
+  ASSERT_TRUE(dialogs) << "Chromium builds no chooser for this profile";
+  ASSERT_TRUE(choices);
+  ASSERT_TRUE(template_urls);
+  search_test_utils::WaitForTemplateURLServiceToLoad(template_urls);
+  const auto conditions = [&]() {
+    return choices->GetDynamicChoiceScreenConditions(
+        *template_urls, {.allow_unknown_current_location = true});
+  };
+  {
+    SCOPED_TRACE("a fresh profile owes a choice and searches with DuckDuckGo");
+    ASSERT_TRUE(regional_capabilities::IsEligible(conditions()));
+    ASSERT_TRUE(template_urls->GetDefaultSearchProvider());
+    ASSERT_EQ("duckduckgo.com",
+              template_urls->GetDefaultSearchProvider()
+                  ->GenerateSearchURL(template_urls->search_terms_data())
+                  .host());
+  }
+  content::WebContents* const page = OpenWelcome(*browser());
+  ASSERT_TRUE(page);
+  {
+    SCOPED_TRACE("Skip on step 1");
+    ASSERT_EQ("Step 1 of 6",
+              content::EvalJs(page,
+                              "document.querySelector('footer .status')"
+                              ".textContent"));
+    ASSERT_TRUE(content::ExecJs(
+        page, "document.querySelector('[data-focus=\"skip\"]').click()"));
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      return profile->GetPrefs()->GetBoolean(stedding::prefs::kWelcomeShown);
+    }));
+  }
+  {
+    SCOPED_TRACE("the next page opens with no chooser");
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("about:blank")));
+    EXPECT_FALSE(dialogs->IsShowingDialog(*browser()));
+  }
+  {
+    SCOPED_TRACE("DuckDuckGo is kept and the choice is recorded");
+    EXPECT_EQ(regional_capabilities::SearchEngineChoiceScreenConditions::
+                  kAlreadyCompleted,
+              conditions());
+    ASSERT_TRUE(template_urls->GetDefaultSearchProvider());
+    EXPECT_EQ("duckduckgo.com",
+              template_urls->GetDefaultSearchProvider()
+                  ->GenerateSearchURL(template_urls->search_terms_data())
+                  .host());
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(, WelcomeChooserTest, testing::Values("FR", "CN"));
+
