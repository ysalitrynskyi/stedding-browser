+// sessions S20 (BACKLOG S-338): blob: and filesystem: data is read only in the
+// jar that made it, and an address another app opens loads nothing in the
+// tab: a page at one stays in the jar its tab is in. Moved to the profile's
+// jar, a blob: page of a Space with its own session was cancelled and loaded
+// again where its blob is not, and a mailto: link moved the page it was
+// clicked on into the shared jar. A view-source page goes by the page it
+// shows: in the Space's jar for a web page, the profile's for the browser's
+// own.
+TEST(SpaceStoragePartitionTest, ABlobOrAnotherAppsAddressStaysInItsTabsJar) {
+  for (const char* url :
+       {"blob:https://example.com/9c1d5e1a-7b5e-4f0e-9d39-0a1b2c3d4e5f",
+        "filesystem:https://example.com/temporary/a.html",
+        "mailto:someone@example.com", "tel:+15555550123",
+        "zoommtg://example.zoom.us/join?confno=1"}) {
+    EXPECT_TRUE(PageStaysInItsJar(GURL(url))) << url;
+    EXPECT_FALSE(PageBelongsInSpaceJar(GURL(url))) << url;
+  }
+  for (const char* url :
+       {"https://example.com/", "about:blank", "data:text/html,a",
+        "chrome://settings/", "chrome://newtab/",
+        "chrome-extension://abcdefghijklmnopabcdefghijklmnop/options.html",
+        "devtools://devtools/bundled/inspector.html",
+        "view-source:https://example.com/", "view-source:chrome://settings/"}) {
+    EXPECT_FALSE(PageStaysInItsJar(GURL(url))) << url;
+  }
+  EXPECT_TRUE(PageBelongsInSpaceJar(GURL("view-source:https://example.com/")));
+  EXPECT_FALSE(PageBelongsInSpaceJar(GURL("view-source:chrome://settings/")));
+}
