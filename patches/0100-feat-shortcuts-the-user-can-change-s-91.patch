+#ifndef CHROME_BROWSER_UI_STEDDING_SHORTCUT_CATALOG_H_
+#define CHROME_BROWSER_UI_STEDDING_SHORTCUT_CATALOG_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+
+namespace stedding::shortcuts {
+
+// docs/features/shortcuts.md Z5, Z16: every command a chord of the shipped
+// tables reaches, one row each, in the order the Shortcuts block shows them.
+// A row is named by a stable name, never by its command number: the names
+// are what Local State keeps (Z10), so a name, once shipped, never changes.
+
+enum class Group {
+  kSpaces,
+  kTabs,
+  kPage,
+  kNavigation,
+  kFind,
+  kWindows,
+  kDeveloper,
+  kTextEditing,
+};
+
+// The group's title, as the block heads it.
+std::u16string GroupTitle(Group group);
+
+enum EntryFlags : int {
+  kNoFlags = 0,
+  // Read-only on every platform: no recorder, no switch (Z16).
+  kFixed = 1 << 0,
+  // Read-only on the Mac alone: ⌘W, whose File menu row the app moves
+  // between Close Tab and Close Window; full screen on ⌃⌘F with Fn; ⌘,.
+  kFixedOnMac = 1 << 1,
+  // Used by holding the keys: the chord needs Ctrl, Alt or Cmd (Z18).
+  kHeld = 1 << 2,
+  // Nine commands on one row, with a switch and no recorder (Z17).
+  kFamily = 1 << 3,
+  // Its keys are another row's chords with Shift (Z18): read-only.
+  kFollows = 1 << 4,
+  // Never shown: a second command on the same chord (Paste in the page's
+  // menu), or a developer's debug key.
+  kHidden = 1 << 5,
+  // The chord may not hold Shift, since the row that follows it adds Shift.
+  kNoShift = 1 << 6,
+};
+
+struct Entry {
+  // The stable name Local State keys the row by (Z10).
+  const char* name;
+  // The row's command; for a family, its first member.
+  int command;
+  const char16_t* label;
+  Group group;
+  int flags = kNoFlags;
+  // A command whose chord this one shares on purpose: the two are one
+  // command to the conflict check and the table test (Z13).
+  int alias_of = 0;
+};
+
+// Every row, in the block's order.
+base::span<const Entry> Catalog();
+
+// The row of `command`: a family's row for each of its nine commands, the
+// leader's row for none. Null when no row holds the command.
+const Entry* EntryForCommand(int command);
+const Entry* EntryForName(std::string_view name);
+
+// The commands a row stands for: a family's nine, else its one command.
+std::vector<int> MembersOf(const Entry& entry);
+
+// The command whose chords a kFollows row takes, with Shift added.
+int LeaderOf(const Entry& entry);
+
+// Whether the row can be changed on this platform at all.
+bool IsFixed(const Entry& entry);
+// Whether the row takes new chords (not fixed, not a family, not a
+// follower).
+bool CanRebind(const Entry& entry);
+// Whether the row has a switch (not fixed, not a follower).
+bool CanTurnOff(const Entry& entry);
+
+// The command a chord conflict is about: the alias's command for an alias.
+int ConflictCommand(int command);
+
+// This platform's shipped tables, every binding: on the Mac the menu's key
+// equivalents (accelerators_cocoa.mm), then the chords coded by key
+// (global_keyboard_shortcuts_mac.mm), then the views table; elsewhere the
+// standard cut, copy and paste, then the views table (accelerator_table.cc).
+// The user's chords are not in it.
+std::vector<Binding> DefaultBindings();
+
+// `command`'s chords in `defaults`, in table order, each once.
+std::vector<Chord> DefaultChordsFor(int command,
+                                    const std::vector<Binding>& defaults);
+std::vector<Chord> DefaultChordsFor(int command);
+
+// The default chord the menus would name for `command`, as the lookup did
+// before any user chord: on the Mac the coded table's first, then the
+// menu's; elsewhere cut, copy and paste, then the table's first. The
+// reference (Z1-Z3, Z21) is built from it.
+std::optional<Chord> DefaultMenuChordFor(int command);
+
+}  // namespace stedding::shortcuts
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SHORTCUT_CATALOG_H_
