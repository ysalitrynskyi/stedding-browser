+#include "ui/views/test/views_test_utils.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+class SidebarFormsTest
+    : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
+ protected:
+  BrowserView* browser_view() {
+    return BrowserView::GetBrowserViewForBrowser(browser());
+  }
+  VerticalTabStripRegionView* region() {
+    return browser_view()->vertical_tab_strip_region_view_for_testing();
+  }
+  tabs::VerticalTabStripStateController* controller() {
+    return tabs::VerticalTabStripStateController::From(browser());
+  }
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+  views::View* root() { return browser_view()->GetWidget()->GetRootView(); }
+
+  bool Animating() {
+    return BrowserAnimationController::From(browser())->IsAnimating(
+        TabStripAnimations::kVerticalTabStrip);
+  }
+  void Settle() {
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !Animating(); }));
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+  }
+
+  // `view`'s bounds in the root view's coordinates.
+  gfx::Rect InRoot(views::View* view) {
+    return views::View::ConvertRectToTarget(view, root(),
+                                            view->GetLocalBounds());
+  }
+  gfx::Rect Page() {
+    return InRoot(browser_view()->contents_web_view_for_testing());
+  }
+  gfx::Rect Strip() { return InRoot(region()); }
+  gfx::Rect Row() { return InRoot(browser_view()->toolbar()); }
+  gfx::Rect Window() { return InRoot(browser_view()); }
+
+  // The open sidebar's top row, measured before a test closes it.
+  int open_top_height_ = 0;
+
+  // The leading edge of the browser view, at mid height, in its own
+  // physical coordinates: the left, or the right in a right-to-left layout.
+  gfx::Point LeadingEdge() {
+    return gfx::Point(
+        base::i18n::IsRTL() ? browser_view()->width() - 2 : 2,
+        browser_view()->height() / 2);
+  }
+
+  void CloseTo(int form) {
+    prefs()->SetInteger(stedding::prefs::kSidebarClosedForm, form);
+    if (!controller()->IsCollapsed()) {
+      controller()->RequestCollapse(true);
+    }
+    Settle();
+    ASSERT_TRUE(controller()->IsCollapsed());
+  }
+};
+
+// sidebar Y19: closed to nothing, the strip takes no width and the page card
+// keeps no gutter and no rounded corner: page and address row run from the
+// window's leading edge to its trailing one, and down to its bottom. Opened
+// again, the strip, the gutters and the corners come back.
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, HiddenTheWindowIsThePage) {
+  AppendTab();
+  Settle();
+  const int gutter = stedding::kCardGutter.Get();
+  const gfx::Rect open_page = Page();
+  ASSERT_GT(Strip().width(), 0);
+  ASSERT_EQ(Strip().right() + gutter, open_page.x())
+      << "open, the card sits a gutter past the sidebar";
+
+  CloseTo(stedding::prefs::kSidebarClosedHidden);
+  EXPECT_TRUE(region()->IsHiddenCompletely());
+  EXPECT_EQ(0, region()->width()) << "the strip takes no width";
+  EXPECT_EQ(Window().x(), Page().x()) << "the page starts at the window's edge";
+  EXPECT_EQ(Window().right(), Page().right());
+  EXPECT_EQ(Window().bottom(), Page().bottom());
+  EXPECT_EQ(Window().x(), Row().x()) << "so does the address row";
+  EXPECT_EQ(gfx::RoundedCornersF(),
+            browser_view()->multi_contents_view()->GetBackgroundRadii())
+      << "no rounded corner on the card";
+
+  // The rail is the other closed form: back to its width and the gutters.
+  prefs()->SetInteger(stedding::prefs::kSidebarClosedForm,
+                      stedding::prefs::kSidebarClosedToIcons);
+  Settle();
+  EXPECT_FALSE(region()->IsHiddenCompletely());
+  EXPECT_EQ(VerticalTabStripRegionView::kCollapsedWidth, region()->width());
+  EXPECT_EQ(Strip().right() + gutter, Page().x());
+
+  // Ctrl+S (or Cmd+S) opens it from either form, gutters and all.
+  prefs()->SetInteger(stedding::prefs::kSidebarClosedForm,
+                      stedding::prefs::kSidebarClosedHidden);
+  Settle();
+  ASSERT_EQ(0, region()->width());
+  chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS_COLLAPSE);
+  Settle();
+  EXPECT_FALSE(controller()->IsCollapsed());
+  EXPECT_EQ(open_page, Page()) << "the page is back where it was";
+  EXPECT_NE(gfx::RoundedCornersF(),
+            browser_view()->multi_contents_view()->GetBackgroundRadii());
+
+  // And closes it to the chosen form.
+  chrome::ExecuteCommand(browser(), IDC_TOGGLE_VERTICAL_TABS_COLLAPSE);
+  Settle();
+  EXPECT_TRUE(region()->IsHiddenCompletely());
+  EXPECT_EQ(Window().x(), Page().x());
+}
+
+// sidebar Y19: hidden, the pointer at the window's leading edge slides the
+// sidebar in over the page, which stays where it is, and leaving the sidebar
+// slides it away again. No expand-on-hover switch is needed: it is the way
+// back to a hidden sidebar with the pointer.
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, TheLeadingEdgeSlidesItInOverThePage) {
+  AppendTab();
+  Settle();
+  open_top_height_ = region()->top_button_container_for_testing()->height();
+  controller()->SetExpandOnHoverEnabled(false);
+  CloseTo(stedding::prefs::kSidebarClosedHidden);
+  const gfx::Rect page = Page();
+  ASSERT_EQ(Window().x(), page.x());
+  // Hidden, the strip clips its rows and buttons, several on layers of their
+  // own: they painted past its edge over the page, the rail's glyphs in a
+  // column and the toggle over Back (real use, 2026-10-10).
+  EXPECT_TRUE(region()->layer()->GetMasksToBounds());
+
+  // A point away from the edge does nothing; one within it slides the
+  // sidebar in.
+  const int middle = browser_view()->height() / 2;
+  region()->OnPointerAtForTesting(gfx::Point(40, middle));
+  EXPECT_FALSE(region()->is_expanded_on_hover());
+  region()->OnPointerAtForTesting(gfx::Point(2, middle));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return region()->is_expanded_on_hover() && !Animating(); }));
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  EXPECT_GT(region()->width(), VerticalTabStripRegionView::kCollapsedWidth)
+      << "the sidebar slides in at its open width";
+  EXPECT_EQ(page, Page()) << "over the page, which does not move";
+  EXPECT_TRUE(controller()->IsCollapsed()) << "and stays closed by state";
+  EXPECT_FALSE(region()->layer()->GetMasksToBounds())
+      << "resting open over the page, its edge's shadow shows";
+  // Drawn open, its top row is the open sidebar's, not the rail's stack:
+  // stacked, the buttons left an empty band some 70 DIP tall.
+  views::View* const top = region()->top_button_container_for_testing();
+  EXPECT_LE(top->height(), open_top_height_)
+      << "the top row as tall as the open sidebar's";
+
+  const gfx::Point centre = region()->GetLocalBounds().CenterPoint();
+  region()->OnMouseExited(ui::MouseEvent(ui::EventType::kMouseExited, centre,
+                                         centre, base::TimeTicks::Now(),
+                                         ui::EF_NONE, ui::EF_NONE));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return !region()->is_expanded_on_hover() && !Animating(); }));
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  EXPECT_EQ(0, region()->width()) << "leaving it slides it away";
+}
+
+// sidebar Y18: the handle that resizes the sidebar answers on the card's
+// gutter, right up to the card's edge, and not on the page. It stopped at
+// the strip's own edge, a gutter short of the edge a person aims at.
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, TheHandleReachesTheCardsEdge) {
+  AppendTab();
+  Settle();
+  views::View* const handle = region()->resize_area_for_testing();
+  ASSERT_TRUE(handle->GetVisible());
+  const int y = Page().CenterPoint().y();
+  for (int x = Strip().right() - 4; x < Page().x(); ++x) {
+    EXPECT_EQ(handle, root()->GetEventHandlerForPoint(gfx::Point(x, y)))
+        << "x " << x << ": strip ends at " << Strip().right()
+        << ", the card starts at " << Page().x();
+  }
+  EXPECT_NE(handle,
+            root()->GetEventHandlerForPoint(gfx::Point(Page().x() + 1, y)))
+      << "the page itself is the page's";
+
+  // The rail with expand-on-hover off keeps a handle, on its gutter too.
+  controller()->SetExpandOnHoverEnabled(false);
+  CloseTo(stedding::prefs::kSidebarClosedToIcons);
+  ASSERT_TRUE(handle->GetVisible());
+  for (int x = Strip().right(); x < Page().x(); ++x) {
+    EXPECT_EQ(handle, root()->GetEventHandlerForPoint(gfx::Point(x, y)))
+        << "rail, x " << x;
+  }
+
+  // Hidden there is no handle at all.
+  CloseTo(stedding::prefs::kSidebarClosedHidden);
+  EXPECT_FALSE(handle->GetVisible());
+  EXPECT_NE(handle, root()->GetEventHandlerForPoint(gfx::Point(1, y)));
+}
+
+// BACKLOG S-69: a page in a full screen of its own -- a video's button, the
+// Fullscreen API -- takes the screen edge to edge: no card gutter around it,
+// no rounded corner. The gutter left a band of the window's ground on three
+// sides of a full-screen video (Windows, 2026-09-30). Leaving full screen
+// gives the card its gutters back.
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, APageInItsOwnFullScreenIsEdgeToEdge) {
+  AppendTab();
+  Settle();
+  ASSERT_EQ(stedding::kCardGutter.Get(),
+            VerticalTabStripRegionView::SteddingCardGutter(browser_view()));
+  content::WebContents* const contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  contents->GetDelegate()->EnterFullscreenModeForTab(
+      contents->GetPrimaryMainFrame(), {});
+  ui_test_utils::FullscreenWaiter(browser(), {.tab_fullscreen = true}).Wait();
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+
+  EXPECT_EQ(0, VerticalTabStripRegionView::SteddingCardGutter(browser_view()));
+  EXPECT_EQ(Window().x(), Page().x());
+  EXPECT_EQ(Window().right(), Page().right());
+  EXPECT_EQ(Window().bottom(), Page().bottom());
+  EXPECT_EQ(gfx::RoundedCornersF(),
+            browser_view()->multi_contents_view()->GetBackgroundRadii());
+
+  contents->GetDelegate()->ExitFullscreenModeForTab(contents);
+  ui_test_utils::FullscreenWaiter(
+      browser(), ui_test_utils::FullscreenWaiter::kNoFullscreen)
+      .Wait();
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  EXPECT_EQ(stedding::kCardGutter.Get(),
+            VerticalTabStripRegionView::SteddingCardGutter(browser_view()));
+  EXPECT_EQ(Strip().right() + stedding::kCardGutter.Get(), Page().x());
+}
+
+// The same for a full screen of the window's own with no address row: F11 on
+// Windows and Linux hides the sidebar and the row, and the page's card kept
+// its gutters and rounded corners on four sides. Where full screen keeps the
+// row (macOS), the card keeps its gutters.
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, AFullScreenWithNoRowIsEdgeToEdge) {
+  AppendTab();
+  Settle();
+  ui_test_utils::ToggleFullscreenModeAndWait(browser());
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  if (browser_view()->IsToolbarVisible()) {
+    EXPECT_EQ(stedding::kCardGutter.Get(),
+              VerticalTabStripRegionView::SteddingCardGutter(browser_view()));
+  } else {
+    EXPECT_EQ(0,
+              VerticalTabStripRegionView::SteddingCardGutter(browser_view()));
+    EXPECT_EQ(Window().x(), Page().x());
+    EXPECT_EQ(Window().y(), Page().y());
+    EXPECT_EQ(Window().right(), Page().right());
+    EXPECT_EQ(Window().bottom(), Page().bottom());
+    EXPECT_EQ(gfx::RoundedCornersF(),
+              browser_view()->multi_contents_view()->GetBackgroundRadii());
+  }
+  ui_test_utils::ToggleFullscreenModeAndWait(browser());
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  EXPECT_EQ(stedding::kCardGutter.Get(),
+            VerticalTabStripRegionView::SteddingCardGutter(browser_view()));
+}
+
+// The rail's toggle sits directly over its rows. Stedding hides the combo of
+// tab-search and tab-group buttons, and the rail's stacked top still counted
+// the combo's buttons, which stay visible inside it: an empty band of the
+// combo's height lay under the toggle (real use, 2026-10-10).
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, TheRailHasNoBandUnderItsToggle) {
+  AppendTab();
+  CloseTo(stedding::prefs::kSidebarClosedToIcons);
+  views::View* const top = region()->top_button_container_for_testing();
+  views::View* const toggle =
+      region()->top_button_container_for_testing()->GetCollapseButton();
+  ASSERT_TRUE(toggle && toggle->GetVisible());
+  EXPECT_LE(top->height(), toggle->bounds().bottom() + 12)
+      << "the top container ends just under the toggle; it is "
+      << top->height() << " DIP tall around a toggle ending at "
+      << toggle->bounds().bottom();
+}
+
+// The toggle's tooltip names the chord the sidebar answers to: Cmd+S or
+// Ctrl+S, as in Arc. It named Chromium 155's Ctrl+Shift+L, which Stedding
+// does not bind, and the command bar showed that chord too (real use,
+// 2026-10-10).
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, TheToggleNamesTheSidebarsChord) {
+  AppendTab();
+  Settle();
+  ui::Accelerator accelerator;
+  ASSERT_TRUE(browser_view()->GetAccelerator(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE,
+                                             &accelerator));
+  EXPECT_EQ(ui::VKEY_S, accelerator.key_code());
+  auto* const toggle = static_cast<views::Button*>(
+      region()->top_button_container_for_testing()->GetCollapseButton());
+  const std::u16string tooltip = toggle->GetTooltipText();
+  EXPECT_NE(std::u16string::npos, tooltip.find(accelerator.GetShortcutText()))
+      << base::UTF16ToUTF8(tooltip);
+  EXPECT_EQ(std::u16string::npos, tooltip.find(u"L)"))
+      << base::UTF16ToUTF8(tooltip);
+}
+
+// The edge opens only a hidden sidebar the window shows. In a page's own
+// full screen the strip is not drawn; a reveal there left the sidebar open
+// over the page once full screen ended, with no mouse exit to close it.
+IN_PROC_BROWSER_TEST_F(SidebarFormsTest, TheEdgeDoesNothingInFullScreen) {
+  AppendTab();
+  CloseTo(stedding::prefs::kSidebarClosedHidden);
+  content::WebContents* const contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  contents->GetDelegate()->EnterFullscreenModeForTab(
+      contents->GetPrimaryMainFrame(), {});
+  ui_test_utils::FullscreenWaiter(browser(), {.tab_fullscreen = true}).Wait();
+  views::test::RunScheduledLayout(browser_view()->GetWidget());
+  region()->OnPointerAtForTesting(LeadingEdge());
+  base::RunLoop().RunUntilIdle();
+  EXPECT_FALSE(region()->is_expanded_on_hover());
+  contents->GetDelegate()->ExitFullscreenModeForTab(contents);
+  ui_test_utils::FullscreenWaiter(
+      browser(), ui_test_utils::FullscreenWaiter::kNoFullscreen)
+      .Wait();
+}
+
+// Right to left the sidebar is on the right: the handle reaches over the
+// gutter on its left to the card's edge, and the window's right edge slides
+// a hidden sidebar in. Both were the left-to-right sides until a review
+// read them (2026-10-11).
+class SidebarFormsRtlTest : public SidebarFormsTest {
+ protected:
+  void SetUpCommandLine(base::CommandLine* command_line) override {
+    SidebarFormsTest::SetUpCommandLine(command_line);
+    command_line->AppendSwitchASCII(switches::kForceUIDirection,
+                                    switches::kForceDirectionRTL);
+  }
+};
+
+IN_PROC_BROWSER_TEST_F(SidebarFormsRtlTest, TheHandleAndTheEdgeAreMirrored) {
+  ASSERT_TRUE(base::i18n::IsRTL());
+  AppendTab();
+  Settle();
+  views::View* const handle = region()->resize_area_for_testing();
+  ASSERT_TRUE(handle->GetVisible());
+  const int y = Page().CenterPoint().y();
+  ASSERT_LT(Page().right(), Strip().x()) << "the sidebar on the right";
+  for (int x = Page().right(); x < Strip().x() + 4; ++x) {
+    EXPECT_EQ(handle, root()->GetEventHandlerForPoint(gfx::Point(x, y)))
+        << "x " << x << ": the card ends at " << Page().right()
+        << ", the strip starts at " << Strip().x();
+  }
+  EXPECT_NE(handle,
+            root()->GetEventHandlerForPoint(gfx::Point(Page().right() - 2, y)));
+
+  CloseTo(stedding::prefs::kSidebarClosedHidden);
+  region()->OnPointerAtForTesting(
+      gfx::Point(2, browser_view()->height() / 2));
+  EXPECT_FALSE(region()->is_expanded_on_hover()) << "not the left edge";
+  region()->OnPointerAtForTesting(LeadingEdge());
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return region()->is_expanded_on_hover() && !Animating(); }));
+}
+
+}  // namespace
