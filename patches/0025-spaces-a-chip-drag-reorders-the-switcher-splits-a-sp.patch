+// splits J4: a split's panes take a Space, a pin and a sleep together.
+TEST_F(SpaceWindowTest, SplitPanesTakeVerbsTogether) {
+  const SpaceId home = model().active_id();
+  tabs::TabInterface* const a = OpenTab();
+  tabs::TabInterface* const b = OpenTab();
+  tabs::TabInterface* const c = OpenTab();
+  tabs().AddToNewSplit({tabs().GetIndexOfTab(b)},
+                       split_tabs::SplitTabVisualData(),
+                       split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(b->IsSplit() && c->IsSplit());
+  EXPECT_EQ(2u, model().SplitPeers(b).size());
+  EXPECT_EQ(1u, model().SplitPeers(a).size());
+
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetSpaceForTab(b, work->id());
+  EXPECT_EQ(work->id(), model().SpaceForTab(b));
+  EXPECT_EQ(work->id(), model().SpaceForTab(c)) << "the pane's peer follows";
+  EXPECT_EQ(home, model().SpaceForTab(a));
+
+  model().SetSpacePinned(c, true);
+  EXPECT_TRUE(model().IsSpacePinned(b));
+  EXPECT_TRUE(model().IsSpacePinned(c));
+  EXPECT_TRUE(model().HomeUrl(b).has_value());
+  model().SetSpacePinned(b, false);
+  EXPECT_FALSE(model().IsSpacePinned(c));
+
+  // The selection carries both panes, so a sleep takes both (tabs R21);
+  // the panes live in Work now, so the window goes there first.
+  model().SetActiveSpace(work->id());
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(b),
+                       TabStripUserGestureDetails(
+                           TabStripUserGestureDetails::GestureType::kOther));
+  const std::vector<tabs::TabInterface*> doomed =
+      stedding::TabsToSleep(browser(), b, stedding::SleepScope::kThisTab);
+  EXPECT_NE(doomed.end(), std::ranges::find(doomed, c));
+}
