+namespace {
+
+// windows G10 (BACKLOG S-323): with the New Tab page or specific pages, the
+// next launch brings back a window's sidebar alone, unless a restart is
+// pending, which restores the whole session whatever the setting.
+bool NextLaunchKeepsTheSidebarOnly(Profile* profile) {
+  if (!profile ||
+      !SessionStartupPref::GetStartupPref(profile).ShouldRestoreTheSidebarOnly()) {
+    return false;
+  }
+  const PrefService* const local_state =
+      g_browser_process ? g_browser_process->local_state() : nullptr;
+  return !(local_state &&
+           local_state->GetBoolean(::prefs::kRestartLastSessionOnShutdown));
+}
+
+// What such a launch keeps: an essential, a Space's pin, a tab in a folder,
+// and a split any of whose tabs is one of them (session_restore.cc,
+// KeepTheSidebarsOnly).
+bool IsSidebarTab(tabs::TabInterface* tab) {
+  if (tab->IsPinned() || !FolderPathForTab(tab).empty()) {
+    return true;
+  }
+  const spaces::SpaceModel* const model =
+      spaces::SpaceModel::From(tab->GetBrowserWindowInterface());
+  return model && model->IsSpacePinned(tab);
+}
+
+bool NextLaunchKeeps(tabs::TabInterface* tab) {
+  BrowserWindowInterface* const window = tab->GetBrowserWindowInterface();
+  if (!window || !NextLaunchKeepsTheSidebarOnly(window->GetProfile())) {
+    return true;
+  }
+  if (IsSidebarTab(tab)) {
+    return true;
+  }
+  if (const std::optional<split_tabs::SplitTabId> split = tab->GetSplit()) {
+    if (const split_tabs::SplitTabData* const data =
+            window->GetTabStripModel()->GetSplitData(*split)) {
+      for (tabs::TabInterface* const other : data->ListTabs()) {
+        if (IsSidebarTab(other)) {
+          return true;
+        }
+      }
+    }
+  }
+  return false;
+}
+
