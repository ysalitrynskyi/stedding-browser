+      browser_view_->GetWidget()->IsClosed()) {
+    return;
+  }
+  // A bubble open from the sidebar's button goes with the button.
+  if (bubble_delegate_ && stedding_anchor_view_ &&
+      bubble_delegate_->GetAnchorView() == stedding_anchor_view_ &&
+      !SteddingAnchorView()) {
+    CloseDialog(views::Widget::ClosedReason::kUnspecified);
+  }
+  if (stedding_shown_) {
+    Show();
