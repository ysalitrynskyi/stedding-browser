+  }
+  ASSERT_NE(-1, command);
+  ASSERT_TRUE(stedding::IsTabMenuVerbEnabled(
+      tabs(), IndexOf(routed), command, stedding::RenameInPlace::kUnavailable));
+  stedding::ExecuteTabMenuVerb(tabs(), IndexOf(routed), command);
+  task_environment()->RunUntilIdle();
+
+  EXPECT_EQ(work, model().FindSpaceForTab(routed));
+  EXPECT_FALSE(IsInAFolder(routed))
