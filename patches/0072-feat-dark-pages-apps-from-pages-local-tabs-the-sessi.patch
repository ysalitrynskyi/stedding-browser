+
+// A row the next start restores without loading reads the title its page set
+// (docs/features/tabs.md R31, BACKLOG S-229). The core loop's fixture
+// (tooling/acceptance/mac/templates/10-setup.steps): six local pages opened
+// into Home, Page B moved into a new folder, Pages E and F moved to Work and
+// Play by the key that moves a tab to the next Space, then a quit. After the
+// relaunch Page D's row read "d.html": the session had kept the empty title
+// each page had at its commit, so only the rows the restore went on to load
+// came back with their pages' titles. Which rows those are depends on the
+// machine (Chromium's background loader starts four tabs, then more only
+// while its checks allow, free memory among them), so the rows are read as
+// the restore leaves them, before any restored page can load, and so is the
+// session the restart read.
+//
+// The pages live in the profile's folder, where the run after the restart
+// finds them at the addresses the session saved.
+
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "base/threading/thread_restrictions.h"
+#include "chrome/browser/prefs/session_startup_pref.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/sessions/session_service.h"
+#include "chrome/browser/sessions/session_service_factory.h"
+#include "chrome/browser/sessions/session_service_test_helper.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/spaces/space.h"
+#include "chrome/browser/ui/spaces/space_commands.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/tab_ui_helper.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/sessions/core/command_storage_manager.h"
+#include "components/sessions/core/command_storage_read_status.h"
+#include "components/sessions/core/session_command.h"
+#include "components/sessions/core/session_id.h"
+#include "components/sessions/core/session_service_commands.h"
+#include "components/sessions/core/session_types.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "net/base/filename_util.h"
+#include "third_party/skia/include/core/SkColor.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+using spaces::SpaceId;
+
+// The fixture's pages, Page A to Page F.
+constexpr std::string_view kPages = "abcdef";
+
+std::string FileName(char page) {
+  return std::string(1, page) + ".html";
+}
+
+std::u16string Title(char page) {
+  return u"Page " +
+         base::ASCIIToUTF16(std::string(1, base::ToUpperASCII(page)));
+}
+
+// The Space the fixture leaves each page in.
+std::string SpaceOf(char page) {
+  switch (page) {
+    case 'e':
+      return "Work";
+    case 'f':
+      return "Play";
+    default:
+      return "Home";
+  }
+}
+
+class RestoredTitleTest : public InProcessBrowserTest {
+ protected:
+  void SetUpInProcessBrowserTestFixture() override {
+    InProcessBrowserTest::SetUpInProcessBrowserTestFixture();
+    // Before the browser starts, so the startup restore is heard.
+    restored_subscription_ =
+        SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+            &RestoredTitleTest::OnSessionRestored, base::Unretained(this)));
+  }
+
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    SessionStartupPref::SetStartupPref(
+        browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
+  }
+
+  TabStripModel* tabs() { return browser()->GetTabStripModel(); }
+  spaces::SpaceModel* model() { return spaces::SpaceModel::From(browser()); }
+
+  base::FilePath PagesDir() {
+    return browser()->GetProfile()->GetPath().AppendASCII(
+        "stedding_title_pages");
+  }
+
+  GURL PageUrl(char page) {
+    return net::FilePathToFileURL(PagesDir().AppendASCII(FileName(page)));
+  }
+
+  // The fixture's own pages (tooling/acceptance/mac/pages): a title and a
+  // line of text, nothing that scrolls or keeps form state.
+  void WritePages() {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(base::CreateDirectory(PagesDir()));
+    for (const char page : kPages) {
+      const std::string title = base::UTF16ToUTF8(Title(page));
+      ASSERT_TRUE(base::WriteFile(
+          PagesDir().AppendASCII(FileName(page)),
+          "<!doctype html><meta charset=\"utf-8\"><title>" + title +
+              "</title><body style=\"font:48px sans-serif;margin:40px\">" +
+              title + "</body>"));
+    }
+  }
+
+  // The tab of `page` in this window's one strip, whatever Space it is in.
+  tabs::TabInterface* Find(char page) {
+    for (int i = 0; i < tabs()->count(); ++i) {
+      tabs::TabInterface* const tab = tabs()->GetTabAtIndex(i);
+      if (tab->GetContents()->GetVisibleURL().ExtractFileName() ==
+          FileName(page)) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  int Index(tabs::TabInterface* tab) { return tabs()->GetIndexOfTab(tab); }
+
+  // The title each restored row reads, by its page's file name, taken when
+  // the restore has made the tabs and no restored page has committed yet: a
+  // commit needs the renderer, and the restore notifies before it returns.
+  std::map<std::string, std::u16string> restored_titles_;
+
+ private:
+  void OnSessionRestored(Profile* profile, int num_tabs_restored) {
+    // Only the startup restore's rows count. A later notification (another
+    // restore of any kind) would read pages that have loaded since and could
+    // pass without the fix.
+    if (heard_restore_) {
+      return;
+    }
+    heard_restore_ = true;
+    for (BrowserWindowInterface* const window :
+         GetAllBrowserWindowInterfaces()) {
+      if (window->GetProfile() != profile) {
+        continue;
+      }
+      TabStripModel* const strip = window->GetTabStripModel();
+      for (int i = 0; i < strip->count(); ++i) {
+        tabs::TabInterface* const tab = strip->GetTabAtIndex(i);
+        const std::string file_name =
+            tab->GetContents()->GetVisibleURL().ExtractFileName();
+        restored_titles_[file_name] = TabUIHelper::From(tab)->GetTitle();
+      }
+    }
+  }
+
+  bool heard_restore_ = false;
+  base::CallbackListSubscription restored_subscription_;
+};
+
+// The first run: the fixture's state, every row reading its page's title.
+IN_PROC_BROWSER_TEST_F(RestoredTitleTest, PRE_AnUnloadedRowReadsItsPagesTitle) {
+  WritePages();
+  spaces::SpaceModel* const m = model();
+  ASSERT_TRUE(m);
+  const SpaceId home = m->active_id();
+  m->SetSpaceName(home, "Home");
+  const SpaceId work = m->AddSpace("Work", SK_ColorGREEN)->id();
+  const SpaceId play = m->AddSpace("Play", SK_ColorBLUE)->id();
+
+  // The pages open in Home as pages from the command line do: the first in
+  // front, the others behind it, every one loaded.
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), PageUrl('a')));
+  for (const char page : kPages.substr(1)) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), PageUrl(page), WindowOpenDisposition::NEW_BACKGROUND_TAB,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  }
+  for (const char page : kPages) {
+    SCOPED_TRACE(page);
+    tabs::TabInterface* const tab = Find(page);
+    ASSERT_TRUE(tab);
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return tab->GetContents()->GetTitle() == Title(page); }));
+  }
+
+  // Page B into a new folder, as the command bar's Move Tab to New Folder
+  // does it, on the selected tab.
+  tabs()->ActivateTabAt(Index(Find('b')));
+  tabs()->ExecuteContextMenuCommand(tabs()->active_index(),
+                                    TabStripModel::CommandMoveTabToNewFolder);
+  const tabs::TabCollection* const folder = Find('b')->GetParentCollection();
+  ASSERT_TRUE(folder);
+  ASSERT_EQ(tabs::TabCollection::Type::FOLDER, folder->type());
+
+  // Page E to Work and Page F on to Play by the key's command (⌥⇧⌘→), the
+  // window following each move; then Home again, on Page A.
+  tabs()->ActivateTabAt(Index(Find('e')));
+  spaces::MoveActiveTabToNeighbourSpace(browser(), /*forward=*/true);
+  ASSERT_EQ(work, m->SpaceForTab(Find('e')));
+  m->SetActiveSpaceByIndex(0);
+  ASSERT_EQ(home, m->active_id());
+  tabs()->ActivateTabAt(Index(Find('f')));
+  spaces::MoveActiveTabToNeighbourSpace(browser(), /*forward=*/true);
+  spaces::MoveActiveTabToNeighbourSpace(browser(), /*forward=*/true);
+  ASSERT_EQ(play, m->SpaceForTab(Find('f')));
+  m->SetActiveSpaceByIndex(0);
+  ASSERT_EQ(home, m->active_id());
+  tabs()->ActivateTabAt(Index(Find('a')));
+
+  // Before the quit every row reads its page's title (setup-02-open.png).
+  for (const char page : kPages) {
+    SCOPED_TRACE(page);
+    EXPECT_EQ(Title(page), TabUIHelper::From(Find(page))->GetTitle());
+  }
+}
+
+// After the restart every row reads its page's title from the first frame,
+// Page C and Page D included, whether or not the restore goes on to load it.
+IN_PROC_BROWSER_TEST_F(RestoredTitleTest, AnUnloadedRowReadsItsPagesTitle) {
+  {
+    SCOPED_TRACE("the rows as the restore made them");
+    for (const char page : kPages) {
+      SCOPED_TRACE(page);
+      const auto it = restored_titles_.find(FileName(page));
+      ASSERT_NE(it, restored_titles_.end()) << "not restored";
+      EXPECT_EQ(Title(page), it->second);
+    }
+  }
+
+  {
+    SCOPED_TRACE("the session the restart read");
+    SessionService* const service =
+        SessionServiceFactory::GetForProfile(browser()->GetProfile());
+    ASSERT_TRUE(service);
+    SessionServiceTestHelper helper(service);
+    base::test::TestFuture<
+        std::vector<std::unique_ptr<sessions::SessionCommand>>,
+        sessions::CommandStorageReadStatus>
+        read;
+    helper.command_storage_manager()->GetLastSessionCommands(
+        read.GetCallback());
+    auto [commands, read_status] = read.Take();
+    ASSERT_EQ(read_status, sessions::CommandStorageReadStatus::kSuccess);
+    std::vector<std::unique_ptr<sessions::SessionWindow>> windows;
+    SessionID active = SessionID::InvalidValue();
+    std::string platform;
+    std::set<SessionID> discarded;
+    sessions::RestoreSessionFromCommands(commands, &windows, &active, &platform,
+                                         &discarded);
+    std::map<std::string, std::u16string> saved;
+    for (const auto& window : windows) {
+      for (const auto& tab : window->tabs) {
+        if (tab->navigations.empty()) {
+          continue;
+        }
+        const sessions::SerializedNavigationEntry& entry =
+            tab->navigations[tab->normalized_navigation_index()];
+        saved[entry.virtual_url().ExtractFileName()] = entry.title();
+      }
+    }
+    for (const char page : kPages) {
+      SCOPED_TRACE(page);
+      const auto it = saved.find(FileName(page));
+      ASSERT_NE(it, saved.end()) << "not saved";
+      EXPECT_EQ(Title(page), it->second);
+    }
+  }
+
+  {
+    SCOPED_TRACE("the window as it was left");
+    spaces::SpaceModel* const m = model();
+    ASSERT_TRUE(m);
+    for (const char page : kPages) {
+      SCOPED_TRACE(page);
+      tabs::TabInterface* const tab = Find(page);
+      ASSERT_TRUE(tab);
+      EXPECT_EQ(Title(page), TabUIHelper::From(tab)->GetTitle());
+      EXPECT_EQ(SpaceOf(page), m->GetSpace(m->SpaceForTab(tab))->name());
+    }
+    const tabs::TabCollection* const folder = Find('b')->GetParentCollection();
+    ASSERT_TRUE(folder);
+    EXPECT_EQ(tabs::TabCollection::Type::FOLDER, folder->type());
+  }
+}
+
+}  // namespace
