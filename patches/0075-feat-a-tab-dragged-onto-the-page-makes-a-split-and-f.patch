+void CommandBarView::OnHeldChordEvent(const ui::Event& event) {
+  if (!holding_chord_ || closing_) {
+    return;
+  }
+  // The pointer takes over: the bar stays, and a click runs what it hits.
+  if (event.IsMouseEvent()) {
+    EndHold();
+    return;
+  }
+  if (!event.IsKeyEvent()) {
+    return;
+  }
+  const ui::KeyEvent& key = *event.AsKeyEvent();
+  if (key.type() == ui::EventType::kKeyReleased) {
+    if (!IsExtensionsChordModifier(key.key_code())) {
+      return;
+    }
+    // Letting go runs the chosen extension, as a click on its button would.
+    // With none to list, the bar stays open on Manage Extensions.
+    EndHold();
+    if (selected_ < rows_.size() && rows_[selected_].kind == RowKind::kAction &&
+        actions_.at(rows_[selected_].action).extension) {
+      RunRow(selected_);
+    }
+    return;
+  }
+  if (key.type() != ui::EventType::kKeyPressed ||
+      IsExtensionsChordModifier(key.key_code())) {
+    return;
+  }
+  // A key without the modifier: its release went elsewhere, and the hold is
+  // over; the key is the field's.
+  if ((key.flags() & kExtensionsChordModifiers) != kExtensionsChordModifiers) {
+    EndHold();
+  }
+}
+
+std::vector<ui::Accelerator> CommandBarView::HeldChordAccelerators() const {
+  return {ui::Accelerator(ui::VKEY_DOWN, kExtensionsChordModifiers),
+          ui::Accelerator(ui::VKEY_UP, kExtensionsChordModifiers),
+          ui::Accelerator(ui::VKEY_ESCAPE, kExtensionsChordModifiers)};
+}
+
+void CommandBarView::HoldChord() {
+  if (holding_chord_ || closing_) {
+    return;
+  }
+  holding_chord_ = true;
+  if (views::Widget* const widget = GetWidget();
+      widget && widget->GetNativeWindow()) {
+    chord_watcher_ = std::make_unique<ChordWatcher>(this);
+    chord_monitor_ = views::EventMonitor::CreateWindowMonitor(
+        chord_watcher_.get(), widget->GetNativeWindow(),
+        {ui::EventType::kKeyPressed, ui::EventType::kKeyReleased,
+         ui::EventType::kMousePressed});
+  }
+  // The modifier is down, so the arrows and Escape arrive with it: the bar's
+  // own keys, ahead of the window's (Ctrl+Alt with an arrow walks the tabs
+  // on Windows, windows N7).
+  for (const ui::Accelerator& accelerator : HeldChordAccelerators()) {
+    AddAccelerator(accelerator);
+  }
+#if BUILDFLAG(IS_MAC)
+  // Ahead of the main menu: the window's key equivalents ask the focus
+  // manager's priority handlers before the menu, whose Stop has Cmd-Period.
+  if (views::FocusManager* const focus_manager = GetFocusManager()) {
+    focus_manager->RegisterAccelerator(
+        kHeldChordCancel, ui::AcceleratorManager::kHighPriority, this);
+    cancel_chord_manager_ = focus_manager;
+  }
+#endif
+}
+
+void CommandBarView::EndHold() {
+  if (!holding_chord_) {
+    return;
+  }
+  holding_chord_ = false;
+  chord_monitor_.reset();
+  chord_watcher_.reset();
+  for (const ui::Accelerator& accelerator : HeldChordAccelerators()) {
+    RemoveAccelerator(accelerator);
+  }
+#if BUILDFLAG(IS_MAC)
+  if (cancel_chord_manager_) {
+    cancel_chord_manager_->UnregisterAccelerator(kHeldChordCancel, this);
+    cancel_chord_manager_ = nullptr;
+  }
+#endif
+}
