+
+// A launch that starts a new profile because the old one could not come across
+// (another browser has it, or the copy failed) makes a key of its own: its
+// profile is empty, with nothing sealed with Chromium's key. It had copied
+// Chromium's (BACKLOG S-208). Quitting, a move that happened, and a profile
+// another launch moved in meanwhile keep the answer taken before the move.
+TEST(ChromePaths, ANewProfileAfterAFailedMoveMakesItsOwnKey) {
+  LegacyProfileFixture fixture;
+  LegacyProfileFixture::WriteProfile(fixture.legacy(), "Default",
+                                     LegacyProfileFixture::kSteddingPrefs);
+  const base::FilePath none;
+  const bool before = SteddingDataMayUseLegacyKeychainKey(
+      fixture.legacy(), fixture.target(), none);
+  ASSERT_TRUE(before) << "an unmoved Stedding profile in Chromium's folder";
+
+  EXPECT_FALSE(SteddingDataMayUseLegacyKeychainKeyAfterMove(
+      before, LegacyProfileMigration::kLegacyInUse, /*go_on=*/true,
+      fixture.target()));
+  EXPECT_FALSE(SteddingDataMayUseLegacyKeychainKeyAfterMove(
+      before, LegacyProfileMigration::kFailed, /*go_on=*/true,
+      fixture.target()));
+  EXPECT_TRUE(SteddingDataMayUseLegacyKeychainKeyAfterMove(
+      before, LegacyProfileMigration::kFailed, /*go_on=*/false,
+      fixture.target()))
+      << "a launch that quits starts nothing";
+  EXPECT_TRUE(SteddingDataMayUseLegacyKeychainKeyAfterMove(
+      before, LegacyProfileMigration::kMigrated, /*go_on=*/true,
+      fixture.target()))
+      << "a moved profile keeps Chromium's key";
+
+  LegacyProfileFixture::WriteProfile(fixture.target(), "Default",
+                                     LegacyProfileFixture::kSteddingPrefs);
+  EXPECT_TRUE(SteddingDataMayUseLegacyKeychainKeyAfterMove(
+      before, LegacyProfileMigration::kFailed, /*go_on=*/true,
+      fixture.target()))
+      << "another launch moved the profile in first";
+}
