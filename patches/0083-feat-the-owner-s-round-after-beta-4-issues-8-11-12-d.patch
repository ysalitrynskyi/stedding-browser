+// folders F38, pins H14 (the owner, 2026-10-22): a link opened from a tab of
+// a folder nested in a pinned folder -- in the background, as a middle click
+// or a Cmd-click does, or in front, as a link that opens its own tab does --
+// leaves both folders for the first place under the line, and the pinned
+// folder stays in the run with every tab of it a pin. The new tab stayed in
+// the nested folder, a loose tab among pins, and the folder left the run,
+// drawn under the line with its tabs.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ALinkFromANestedPinnedFolderLeavesItInTheRun) {
+  tabs::TabInterface* const pin = tabs().GetActiveTab();
+  model().SetSpacePinned(pin, true);
+  // A row that stays under the line throughout, so the line is drawn.
+  AddBlankTab();
+  tabs::TabInterface* const first = AddBlankTab();
+  tabs::TabInterface* const second = AddBlankTab();
+  tabs::TabInterface* const third = AddBlankTab();
+  tabs::FolderTabCollection* const folder =
+      tabs().AddToNewFolder({tabs().GetIndexOfTab(first),
+                             tabs().GetIndexOfTab(second),
+                             tabs().GetIndexOfTab(third)});
+  ASSERT_TRUE(folder);
+  // The command on tabs already in a folder nests (folders F2).
+  tabs::FolderTabCollection* const nested = tabs().AddToNewFolder(
+      {tabs().GetIndexOfTab(second), tabs().GetIndexOfTab(third)});
+  ASSERT_TRUE(nested);
+  ASSERT_EQ(folder, nested->GetParentCollection());
+  ASSERT_TRUE(model().CanPinFolder(folder));
+  model().SetFolderSpacePinned(folder, true);
+  ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  ASSERT_TRUE(model().IsFolderSpacePinned(folder));
+  ASSERT_TRUE(IsAboveTheLine(third));
+
+  const auto in_a_folder = [&](const tabs::TabInterface* tab) {
+    return tab->GetParentCollection() == folder ||
+           tab->GetParentCollection() == nested;
+  };
+  for (const auto& [from, disposition] :
+       {std::pair(third, WindowOpenDisposition::NEW_BACKGROUND_TAB),
+        std::pair(first, WindowOpenDisposition::NEW_FOREGROUND_TAB)}) {
+    SCOPED_TRACE(from == third ? "from the nested folder, in the background"
+                               : "from the folder, in front");
+    tabs().ActivateTabAt(tabs().GetIndexOfTab(from));
+    NavigateParams params(browser(), GURL("about:blank#child"),
+                          ui::PAGE_TRANSITION_LINK);
+    params.disposition = disposition;
+    params.source_contents = from->GetContents();
+    Navigate(&params);
+    tabs::TabInterface* const opened =
+        tabs().GetTabForWebContents(params.navigated_or_inserted_contents);
+    ASSERT_TRUE(opened);
+    ASSERT_TRUE(base::test::RunUntil([&]() { return !in_a_folder(opened); }))
+        << "the new tab stayed in the pinned folder";
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+    EXPECT_FALSE(model().IsSpacePinned(opened));
+    EXPECT_FALSE(IsAboveTheLine(opened));
+    EXPECT_TRUE(model().IsFolderSpacePinned(folder))
+        << "the folder left the run";
+    EXPECT_EQ(folder, second->GetParentCollection()->GetParentCollection());
+    EXPECT_TRUE(IsAboveTheLine(first));
+    EXPECT_TRUE(IsAboveTheLine(third)) << "the nested folder left the run";
+    EXPECT_EQ(tabs().GetIndexOfTab(third) + 1, tabs().GetIndexOfTab(opened))
+        << "not just after the run";
+    tabs().CloseWebContentsAt(tabs().GetIndexOfTab(opened),
+                              TabCloseTypes::CLOSE_NONE);
+    ASSERT_TRUE(stedding::test::WaitForRowsToSettle(widget()));
+  }
+}
