diff --git a/chrome/browser/ui/stedding/little_window.cc b/chrome/browser/ui/stedding/little_window.cc
index f42ba28dca181..05a0d42971adf 100644
--- a/chrome/browser/ui/stedding/little_window.cc
+++ b/chrome/browser/ui/stedding/little_window.cc
@@ -74,6 +74,15 @@ std::map<SessionID, OpenedLittleWindow>& OpenedLittleWindows() {
   return *windows;
 }
 
+// E12 (BACKLOG S-456): the bounds each little window was last given, or last
+// saved at once the user moved or resized it. At a fractional scale a window
+// measures a DIP off the bounds it was given, and saving what it measured
+// grew it a DIP at every launch.
+std::map<SessionID, gfx::Rect>& GivenLittleBounds() {
+  static base::NoDestructor<std::map<SessionID, gfx::Rect>> bounds;
+  return *bounds;
+}
+
 // E1: the screen bounds of `anchor`'s window; empty when there is no anchor
 // on screen to open over.
 gfx::Rect WindowBoundsOf(BrowserWindowInterface* anchor) {
@@ -191,10 +200,44 @@ BrowserWindowInterface* CreateLittleWindow(Profile* profile,
   // set aside: on the Mac it took the last window's place and size, 22 DIP
   // down and right, so a little window was never little. Set once it is
   // made, they hold.
-  window->GetWindow()->SetBounds(bounds);
+  GiveLittleWindowBounds(window, bounds);
   return window;
 }
 
+void GiveLittleWindowBounds(BrowserWindowInterface* window,
+                            const gfx::Rect& bounds) {
+  if (!window || bounds.IsEmpty()) {
+    return;
+  }
+  GivenLittleBounds()[window->GetSessionID()] = bounds;
+  window->GetWindow()->SetBounds(bounds);
+}
+
+gfx::Rect LittleWindowBoundsToSave(BrowserWindowInterface* window,
+                                   const gfx::Rect& measured,
+                                   bool closing) {
+  std::map<SessionID, gfx::Rect>& given = GivenLittleBounds();
+  const auto it = window ? given.find(window->GetSessionID()) : given.end();
+  if (it == given.end()) {
+    return measured;
+  }
+  const gfx::Rect& was = it->second;
+  const bool same = std::abs(was.x() - measured.x()) <= 1 &&
+                    std::abs(was.y() - measured.y()) <= 1 &&
+                    std::abs(was.width() - measured.width()) <= 1 &&
+                    std::abs(was.height() - measured.height()) <= 1;
+  gfx::Rect saved = measured;
+  if (same) {
+    saved = was;
+  } else {
+    it->second = measured;
+  }
+  if (closing) {
+    given.erase(it);
+  }
+  return saved;
+}
+
 BrowserWindowInterface* OpenLittleWindow(Profile* profile,
                                          const GURL& url,
                                          BrowserWindowInterface* anchor,
