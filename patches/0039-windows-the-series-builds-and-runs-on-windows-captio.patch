+    row->SetText(rail ? std::u16string() : u"Archived");
+    row->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(0, rail ? 0 : 18)));
+    row->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(
+            vector_icons::kHistoryIcon, kColorTabForegroundInactiveFrameActive,
+            stedding::SidebarFaviconSize() + (rail ? 4 : 0)));
+  }
+  if (space_switcher_) {
+    space_switcher_->SetCollapsed(rail);
+  }
+  // The downloads button and the switcher stack in the rail instead of
+  // sharing a row the rail is too narrow for (the plus ended up over the page).
+  if (bottom_row_layout_) {
+    bottom_row_layout_->SetOrientation(
+        rail ? views::BoxLayout::Orientation::kVertical
+             : views::BoxLayout::Orientation::kHorizontal);
+  }
+  if (downloads_button_) {
+    downloads_button_->SetProperty(
+        views::kMarginsKey,
+        rail ? gfx::Insets::TLBR(0, 0, 8, 0) : gfx::Insets::TLBR(0, 10, 0, 0));
+  }
+  if (bottom_row_ && space_switcher_) {
+    int height = space_switcher_->GetPreferredSize().height();
+    if (rail && downloads_button_) {
+      height += downloads_button_->GetPreferredSize().height() + 8;
+    }
+    bottom_row_->SetPreferredSize(gfx::Size(0, height));
+  }
+}
