+ChromiumBookmarks ReadChromiumBookmarks(const base::FilePath& bookmarks_file,
+                                        size_t cap,
+                                        size_t max_depth) {
+  ChromiumBookmarks out;
+  const std::optional<int64_t> size = base::GetFileSize(bookmarks_file);
+  if (!size) {
+    return out;
+  }
+  std::string json;
+  if (*size > kMaxChromiumBookmarksBytes ||
+      !base::ReadFileToString(bookmarks_file, &json)) {
+    out.unreadable = true;
+    return out;
+  }
+  // JSONReader refuses a tree nested past its own limit whole; the file is
+  // then unreadable, and the result line says so.
+  const std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  const base::DictValue* const roots = root ? root->FindDict("roots") : nullptr;
+  if (!roots) {
+    out.unreadable = true;
+    return out;
+  }
+  struct Root {
+    const char* key;
+    bool toolbar;
+    const char16_t* folder;
+  };
+  constexpr Root kRoots[] = {
+      {"bookmark_bar", true, nullptr},
+      {"other", false, nullptr},
+      {"synced", false, u"Mobile bookmarks"},
+  };
+  size_t nodes = 0;
+  for (const Root& entry : kRoots) {
+    const base::DictValue* const node = roots->FindDict(entry.key);
+    const base::ListValue* const children =
+        node ? node->FindList("children") : nullptr;
+    if (!children) {
+      continue;
+    }
+    std::vector<std::u16string> path;
+    if (entry.folder) {
+      path.emplace_back(entry.folder);
+    }
+    WalkBookmarks(*children, path, entry.toolbar, path.size(), cap, max_depth,
+                  nodes, out);
+  }
+  return out;
+}
+
+std::u16string SummariseChromiumProfile(const ChromiumProfileSummary& summary) {
+  std::vector<std::u16string> parts;
+  if (summary.bookmarks > 0) {
+    parts.push_back(
+        stedding::CountOf(summary.bookmarks, u"bookmark", u"bookmarks"));
+  }
+  if (summary.history) {
+    parts.push_back(u"history");
+  }
+  if (summary.passwords > 0) {
+    parts.push_back(stedding::CountOf(summary.passwords, u"saved password",
+                                      u"saved passwords"));
+  }
+  if (parts.empty()) {
+    return u"Nothing to bring over";
+  }
+  return stedding::ListInWords(parts);
+}
