index 0000000000000..4fce2cea3d64a
--- /dev/null
+++ b/chrome/test/stedding/audit_w2_b11_browsertest.cc
@@ -0,0 +1,515 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Sync through a folder (docs/features/sidebar-file.md): an essential another
+// computer filed as a Space's own, in a Space with no session of its own
+// here, and an extension that uninstalls itself. A folder in a temporary
+// directory stands for the shared one, and another computer's file is
+// written into it by the test. A test store on this machine stands in for
+// the Web Store: no request leaves the machine.
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/scoped_observation.h"
+#include "base/test/run_until.h"
+#include "base/test/test_future.h"
+#include "base/threading/thread_restrictions.h"
+#include "base/time/time.h"
+#include "base/token.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "chrome/browser/extensions/webstore_installer_test.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/sidebar_ids.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_file.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_ledger.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_parts.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_service.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_service_factory.h"
+#include "chrome/browser/ui/spaces/sidebar_sync_state.h"
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/spaces/space_registry.h"
+#include "chrome/browser/ui/spaces/space_registry_factory.h"
+#include "chrome/browser/ui/stedding/tab_parents.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "chrome/test/base/ui_test_utils.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+#include "extensions/browser/api/management/management_api.h"
+#include "extensions/browser/api_test_utils.h"
+#include "extensions/browser/extension_function.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/webstore_data_fetcher.h"
+#include "extensions/common/extension.h"
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+
+namespace {
+
+namespace sb = spaces::sidebar_sync;
+
+// The other computer.
+constexpr char kOfficeW2B11[] = "0123456789abcdef";
+constexpr char kOfficeDeviceW2B11[] = "Office PC";
+
+int64_t NowMsW2B11() {
+  return base::Time::Now().InMillisecondsSinceUnixEpoch();
+}
+
+spaces::SpaceId SpaceOfW2B11(const std::string& id) {
+  return *spaces::SpaceId::FromOptionalToken(base::Token::FromString(id));
+}
+
+std::string NewTabIdW2B11() {
+  return spaces::TabSyncId(base::Uuid::GenerateRandomV4().AsLowercaseString());
+}
+
+// Another computer's sidebar: one Space with no session of its own, stamped
+// `t`.
+sb::State OfficeStateW2B11(const std::string& space, int64_t t) {
+  sb::State state;
+  const sb::Stamp stamp{t, kOfficeW2B11};
+  sb::Record record(sb::Kind::kSpace);
+  record.f[sb::kFieldName] = sb::Field{"Office Space", stamp};
+  record.f[sb::kFieldColor] = sb::Field{"#3366FF", stamp};
+  record.f[sb::kFieldIsolated] = sb::Field{"0", stamp};
+  state.records[space] = record;
+  state.lists[sb::kSpacesList].order = {space};
+  state.lists[sb::kSpacesList].s = stamp;
+  state.lists[sb::PinsListOf(space)].s = stamp;
+  return state;
+}
+
+// Counts what the Spaces tell the windows about one tab: a filing, a home or
+// its part as an essential changed.
+class TabSpaceChangesW2B11 : public spaces::SpaceModel::Observer {
+ public:
+  TabSpaceChangesW2B11(spaces::SpaceModel* model, tabs::TabInterface* tab)
+      : tab_(tab) {
+    observation_.Observe(model);
+  }
+  TabSpaceChangesW2B11(const TabSpaceChangesW2B11&) = delete;
+  TabSpaceChangesW2B11& operator=(const TabSpaceChangesW2B11&) = delete;
+  ~TabSpaceChangesW2B11() override = default;
+
+  int count() const { return count_; }
+
+  // spaces::SpaceModel::Observer:
+  void OnTabSpaceChanged(tabs::TabInterface* tab) override {
+    if (tab == tab_) {
+      ++count_;
+    }
+  }
+  void OnSpaceModelDestroying() override { observation_.Reset(); }
+
+ private:
+  raw_ptr<tabs::TabInterface> tab_;
+  int count_ = 0;
+  base::ScopedObservation<spaces::SpaceModel, spaces::SpaceModel::Observer>
+      observation_{this};
+};
+
+class SidebarSyncW2B11Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  spaces::SpaceModel& model() { return *spaces::SpaceModel::From(browser()); }
+  TabStripModel& tabs() { return *browser()->GetTabStripModel(); }
+  spaces::SpaceRegistry& registry() {
+    return *spaces::SpaceRegistryFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  base::FilePath sync_dir() {
+    return shared_.GetPath().AppendASCII(sb::kSyncFolderName);
+  }
+
+  // The other computer's file, written now.
+  void WriteOffice(const sb::State& state, int64_t seq) {
+    base::ScopedAllowBlockingForTesting allow;
+    sb::FileMeta meta;
+    meta.install = kOfficeW2B11;
+    meta.device = kOfficeDeviceW2B11;
+    meta.seq = seq;
+    meta.nonce = sb::MakeInstallId();
+    meta.written_ms = NowMsW2B11();
+    meta.hlc = state.MaxTime();
+    meta.joined_ms = 1;
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(
+        base::WriteFile(sync_dir().AppendASCII(sb::FileNameFor(kOfficeW2B11)),
+                        sb::SerializeSyncFile(state, meta)));
+  }
+
+  // The join is made once its backup is written (Sf9).
+  void Join() {
+    base::test::TestFuture<base::DictValue> preview;
+    service()->PreviewJoin(shared_.GetPath(), preview.GetCallback());
+    const base::DictValue sheet = preview.Take();
+    ASSERT_FALSE(sheet.FindString("refusal"));
+    ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/false, "Test computer", {}));
+    ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  const sb::Record* LedgerRecord(const std::string& id) {
+    const sb::Ledger* const ledger = service()->ledger_for_testing();
+    if (!ledger) {
+      return nullptr;
+    }
+    const auto it = ledger->state.records.find(id);
+    return it == ledger->state.records.end() ? nullptr : &it->second;
+  }
+
+  tabs::TabInterface* TabWithToken(const std::string& id) {
+    for (int i = 0; i < tabs().count(); ++i) {
+      tabs::TabInterface* const tab = tabs().GetTabAtIndex(i);
+      if (spaces::TabSyncId(stedding::TabToken(tab->GetContents())) == id) {
+        return tab;
+      }
+    }
+    return nullptr;
+  }
+
+  base::ScopedTempDir shared_;
+};
+
+// P13-1h, sidebar-file Sf17, Sf21, spaces B6: an essential another computer
+// filed as a Space's own essential, in a Space that has no session of its
+// own here, is a shared essential here, and stays so: a read of the folder
+// that changes nothing leaves it alone, and while it is the tab on screen no
+// change of it waits for the person to leave it. It was moved to where it
+// already was at every read, the windows told and its session entry written
+// again, and while it was on screen every tab switch ran the whole apply.
+IN_PROC_BROWSER_TEST_F(SidebarSyncW2B11Test,
+                       AnOwnEssentialOfASpaceWithNoSessionHereIsNotMovedAgain) {
+  const std::string space = base::Token::CreateRandom().ToString();
+  const std::string essential = NewTabIdW2B11();
+  const int64_t start = NowMsW2B11();
+  // The other computer's Space comes here, with no session of its own.
+  ASSERT_NO_FATAL_FAILURE(WriteOffice(OfficeStateW2B11(space, start), 1));
+  ASSERT_NO_FATAL_FAILURE(Join());
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  const spaces::SpaceId id = SpaceOfW2B11(space);
+  ASSERT_TRUE(registry().Find(id));
+  ASSERT_FALSE(model().SpaceIsIsolated(id));
+
+  // There the Space takes a session of its own, and an essential of its own.
+  // Here the session waits for the person's answer (Sf24), so the essential
+  // is a shared one.
+  const sb::Stamp later{start + 60'000, kOfficeW2B11};
+  sb::State office = OfficeStateW2B11(space, start);
+  office.records[space].f[sb::kFieldIsolated] = sb::Field{"1", later};
+  sb::Record own(sb::Kind::kTab);
+  own.f[sb::kFieldHome] = sb::Field{"https://office.example/own", later};
+  own.f[sb::kFieldName] = sb::Field{"", later};
+  own.f[sb::kFieldParent] = sb::Field{sb::OwnEssentialsListOf(space), later};
+  office.records[essential] = own;
+  office.lists[sb::OwnEssentialsListOf(space)].order = {essential};
+  office.lists[sb::OwnEssentialsListOf(space)].s = later;
+  ASSERT_NO_FATAL_FAILURE(WriteOffice(office, 2));
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  ASSERT_FALSE(model().SpaceIsIsolated(id))
+      << "the session was taken without the person's answer";
+  tabs::TabInterface* const tab = TabWithToken(essential);
+  ASSERT_TRUE(tab);
+  ASSERT_TRUE(tab->IsPinned());
+  ASSERT_TRUE(model().IsSharedEssential(tab));
+  ASSERT_NE(tab, tabs().GetActiveTab());
+  // The first read that finds it here.
+  ASSERT_NO_FATAL_FAILURE(Scan());
+
+  // Reads of the folder that change nothing leave it alone.
+  {
+    TabSpaceChangesW2B11 changes(&model(), tab);
+    ASSERT_NO_FATAL_FAILURE(Scan());
+    ASSERT_NO_FATAL_FAILURE(Scan());
+    EXPECT_EQ(0, changes.count())
+        << "moved to where it already is at each read of the folder";
+  }
+  EXPECT_TRUE(tab->IsPinned());
+  EXPECT_TRUE(model().IsSharedEssential(tab));
+  // The ledger still says where the other computer put it.
+  ASSERT_TRUE(LedgerRecord(essential));
+  EXPECT_EQ(sb::OwnEssentialsListOf(space),
+            LedgerRecord(essential)->Get(sb::kFieldParent));
+
+  // On screen, nothing of it waits for the person to leave it.
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(tab));
+  ASSERT_EQ(tab, tabs().GetActiveTab());
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  const std::optional<int> deferred =
+      service()->GetStatus().FindInt("deferred");
+  ASSERT_TRUE(deferred);
+  EXPECT_EQ(0, *deferred)
+      << "a move waits for the person to leave the tab, and every tab switch "
+         "applies the whole sidebar again";
+  EXPECT_TRUE(model().IsSharedEssential(tab));
+}
+
+// The test store: Chromium's own Web Store test data, the crx and its key.
+constexpr char kWebstoreDomainW2B11[] = "cws.com";
+constexpr char kAppDomainW2B11[] = "app.com";
+constexpr char kNonAppDomainW2B11[] = "nonapp.com";
+constexpr char kTestDataPathW2B11[] =
+    "extensions/api_test/webstore_inline_install";
+constexpr char kCrxFilenameW2B11[] = "extension.crx";
+// The extension that crx holds, and the store's answer about it: the crx's
+// own manifest, which the install checks the download against.
+constexpr char kExtensionIdW2B11[] = "ecglahbcnmdpdciemllbhojghbkagdje";
+constexpr char kExtensionNameW2B11[] = "Inline Install Test Extension";
+constexpr char kManifestW2B11[] = R"({
+  "name": "Inline Install Test Extension",
+  "version": "0.1",
+  "manifest_version": 2,
+  "icons": {"128": "icon.png"},
+  "permissions":["tabs"]
+})";
+
+std::unique_ptr<extensions::FetchItemSnippetResponse> StoreAnswerW2B11() {
+  auto answer = std::make_unique<extensions::FetchItemSnippetResponse>();
+  answer->set_item_id(kExtensionIdW2B11);
+  answer->set_title(kExtensionNameW2B11);
+  answer->set_manifest(kManifestW2B11);
+  answer->set_logo_uri("webstore_inline_install/extension/icon.png");
+  answer->set_user_count_string("371,674");
+  answer->set_rating_count_string("788");
+  answer->set_rating_count(788);
+  answer->set_average_rating(4.36);
+  return answer;
+}
+
+std::vector<sb::ExtensionEntry> TheListW2B11() {
+  return {sb::ExtensionEntry{kExtensionIdW2B11, kExtensionNameW2B11}};
+}
+
+class SidebarSyncExtensionsW2B11Test : public WebstoreInstallerTest {
+ public:
+  SidebarSyncExtensionsW2B11Test()
+      : WebstoreInstallerTest(kWebstoreDomainW2B11,
+                              kTestDataPathW2B11,
+                              kCrxFilenameW2B11,
+                              kAppDomainW2B11,
+                              kNonAppDomainW2B11) {}
+
+ protected:
+  void SetUpOnMainThread() override {
+    WebstoreInstallerTest::SetUpOnMainThread();
+    store_answer_ = StoreAnswerW2B11();
+    extensions::WebstoreDataFetcher::SetMockItemSnippetReponseForTesting(
+        store_answer_.get());
+    space_ = base::Token::CreateRandom().ToString();
+    start_ = NowMsW2B11();
+    base::ScopedAllowBlockingForTesting allow;
+    ASSERT_TRUE(shared_.CreateUniqueTempDir());
+  }
+
+  void TearDownOnMainThread() override {
+    extensions::WebstoreDataFetcher::SetMockItemSnippetReponseForTesting(
+        nullptr);
+    WebstoreInstallerTest::TearDownOnMainThread();
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+  extensions::ExtensionRegistry* registry() {
+    return extensions::ExtensionRegistry::Get(browser()->GetProfile());
+  }
+  base::FilePath sync_dir() {
+    return shared_.GetPath().AppendASCII(sb::kSyncFolderName);
+  }
+
+  // The other computer's file, listing `list`.
+  void WritePeer(int64_t seq, std::vector<sb::ExtensionEntry> list) {
+    base::ScopedAllowBlockingForTesting allow;
+    const sb::State state = OfficeStateW2B11(space_, start_);
+    sb::FileMeta meta;
+    meta.format = sb::kFormat;
+    meta.install = kOfficeW2B11;
+    meta.device = kOfficeDeviceW2B11;
+    meta.seq = seq;
+    meta.nonce = sb::MakeInstallId();
+    meta.written_ms = NowMsW2B11();
+    meta.hlc = state.MaxTime();
+    meta.joined_ms = 1;
+    sb::FileParts parts;
+    parts.extensions = std::move(list);
+    ASSERT_TRUE(base::CreateDirectory(sync_dir()));
+    ASSERT_TRUE(
+        base::WriteFile(sync_dir().AppendASCII(sb::FileNameFor(kOfficeW2B11)),
+                        sb::SerializeSyncFile(state, meta, parts)));
+  }
+
+  // A new join, each box on as the sheet starts them (Sf58).
+  void Join() {
+    base::test::TestFuture<base::DictValue> preview;
+    service()->PreviewJoin(shared_.GetPath(), preview.GetCallback());
+    ASSERT_FALSE(preview.Take().FindString("refusal"));
+    ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/false, "Test computer", {},
+                                       sb::JoinParts()));
+    ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  // Whether Settings offers `id`.
+  bool Offered(const std::string& id) {
+    base::DictValue status = service()->GetStatus();
+    if (const base::ListValue* const offers =
+            status.FindList("extensionOffers")) {
+      for (const base::Value& offer : *offers) {
+        const std::string* const each = offer.GetDict().FindString("id");
+        if (each && *each == id) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+
+  bool Installed(const std::string& id) {
+    return registry()->GetInstalledExtension(id) != nullptr;
+  }
+  bool Enabled(const std::string& id) {
+    return registry()->enabled_extensions().GetByID(id) != nullptr;
+  }
+
+  bool RecordedAsUninstalledHere(const std::string& id) {
+    const sb::Ledger* const ledger = service()->ledger_for_testing();
+    return ledger && ledger->extension_uninstalled.contains(id);
+  }
+
+  // What the offer's Install button sends.
+  void PressInstall(const std::string& id) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+        browser(), GURL("chrome://settings/stedding"),
+        WindowOpenDisposition::kNewForegroundTab,
+        ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+    content::WebContents* const settings =
+        browser()->GetTabStripModel()->GetActiveWebContents();
+    ASSERT_TRUE(settings);
+    ASSERT_TRUE(content::ExecJs(
+        settings,
+        content::JsReplace(
+            "chrome.send('steddingInstallSyncedExtension', [$1]);", id)));
+  }
+
+  // Joins with the other computer's list and installs the extension through
+  // the offer, the confirmation answered yes: a Web Store extension.
+  void InstallThroughTheOffer() {
+    ASSERT_NO_FATAL_FAILURE(WritePeer(1, TheListW2B11()));
+    ASSERT_NO_FATAL_FAILURE(Join());
+    ASSERT_NO_FATAL_FAILURE(Scan());
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return Offered(kExtensionIdW2B11); }));
+    AutoAcceptInstall();
+    ASSERT_NO_FATAL_FAILURE(PressInstall(kExtensionIdW2B11));
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return Enabled(kExtensionIdW2B11); }));
+    ASSERT_TRUE(
+        base::test::RunUntil([&] { return !Offered(kExtensionIdW2B11); }));
+    ASSERT_FALSE(RecordedAsUninstalledHere(kExtensionIdW2B11));
+  }
+
+  // The extension's own chrome.management.uninstallSelf(`args`), as the
+  // browser runs it.
+  bool UninstallItself(const scoped_refptr<const extensions::Extension>& self,
+                       const std::string& args) {
+    auto function =
+        base::MakeRefCounted<extensions::ManagementUninstallSelfFunction>();
+    function->set_extension(self);
+    const bool done = extensions::api_test_utils::RunFunction(
+        function, args, browser()->GetProfile());
+    EXPECT_TRUE(done) << function->GetError();
+    return done;
+  }
+
+  base::ScopedTempDir shared_;
+  std::string space_;
+  int64_t start_ = 0;
+  std::unique_ptr<extensions::FetchItemSnippetResponse> store_answer_;
+};
+
+// P13-1i, sidebar-file Sf66: an extension that removes itself with no dialog
+// (chrome.management.uninstallSelf() without showConfirmDialog, as one does
+// when it retires) was not uninstalled by the person: while another computer
+// lists it, it is offered here again. It was kept from this computer for
+// good, as an extension the person uninstalled is.
+IN_PROC_BROWSER_TEST_F(SidebarSyncExtensionsW2B11Test,
+                       AnExtensionThatUninstallsItselfIsOfferedAgain) {
+  ASSERT_NO_FATAL_FAILURE(InstallThroughTheOffer());
+  const scoped_refptr<const extensions::Extension> self =
+      registry()->enabled_extensions().GetByID(kExtensionIdW2B11);
+  ASSERT_TRUE(self);
+
+  ASSERT_TRUE(UninstallItself(self, "[]"));
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return !Installed(kExtensionIdW2B11); }));
+  EXPECT_FALSE(RecordedAsUninstalledHere(kExtensionIdW2B11))
+      << "taken as the person's own uninstall";
+
+  ASSERT_NO_FATAL_FAILURE(WritePeer(2, TheListW2B11()));
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  EXPECT_TRUE(Offered(kExtensionIdW2B11)) << "never offered here again";
+  EXPECT_FALSE(Installed(kExtensionIdW2B11));
+}
+
+// P13-1i, Sf66: one that asks to remove itself, and the person says yes in
+// Chromium's dialog, was uninstalled by the person: it is not offered here
+// again. (This passes before the fix as after: the fix tells the two apart.)
+IN_PROC_BROWSER_TEST_F(SidebarSyncExtensionsW2B11Test,
+                       AnExtensionRemovedThroughItsDialogIsNotOfferedAgain) {
+  ASSERT_NO_FATAL_FAILURE(InstallThroughTheOffer());
+  const scoped_refptr<const extensions::Extension> self =
+      registry()->enabled_extensions().GetByID(kExtensionIdW2B11);
+  ASSERT_TRUE(self);
+
+  // The dialog's yes.
+  AutoAcceptInstall();
+  {
+    ExtensionFunction::ScopedUserGestureForTests gesture;
+    ASSERT_TRUE(UninstallItself(self, R"([{"showConfirmDialog": true}])"));
+  }
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return !Installed(kExtensionIdW2B11); }));
+  EXPECT_TRUE(RecordedAsUninstalledHere(kExtensionIdW2B11));
+
+  ASSERT_NO_FATAL_FAILURE(WritePeer(2, TheListW2B11()));
+  ASSERT_NO_FATAL_FAILURE(Scan());
+  EXPECT_FALSE(Offered(kExtensionIdW2B11));
+  EXPECT_FALSE(Installed(kExtensionIdW2B11));
+}
+
+}  // namespace
