+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_PRIVACY_DEFAULTS_H_
+#define CHROME_BROWSER_UI_STEDDING_PRIVACY_DEFAULTS_H_
+
+#include <string>
+#include <string_view>
+
+namespace base {
+class CommandLine;
+}
+class PrefService;
+
+namespace stedding {
+
+// docs/features/privacy.md Q4: Chromium sends Sec-GPC: 1 and answers
+// navigator.globalPrivacyControl behind the feature GlobalPrivacyControlForce,
+// which every process reads from its command line at startup. The local-state
+// preference stedding.privacy.gpc becomes that feature here, where Chromium
+// turns chrome://flags into switches.
+inline constexpr char kGlobalPrivacyControlFeature[] =
+    "GlobalPrivacyControlForce";
+
+// --enable-features with the GPC feature added (or not); the existing list
+// is kept.
+std::string EnableFeaturesWithGlobalPrivacyControl(std::string_view existing,
+                                                   bool on);
+
+void ApplyGlobalPrivacyControl(const PrefService* local_state,
+                               base::CommandLine* command_line);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_PRIVACY_DEFAULTS_H_
