+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SHORTCUT_MENU_MAC_H_
+#define CHROME_BROWSER_UI_STEDDING_SHORTCUT_MENU_MAC_H_
+
+namespace stedding::shortcuts {
+
+// docs/features/shortcuts.md Z11 on the Mac: the menu bar's rows take the
+// user's chords at once. Walks the main menu: every row of a Chromium command
+// the user's chords touch shows the command's first chord, or none when it is
+// off or its chord went to another command; a row whose change was reset gets
+// its shipped key back. A row with an App Shortcut the user set in System
+// Settings is left as macOS set it. A row shown with ⌥ or ⇧ under another
+// (Print Using System Dialog under Print, Reload Without Cache under Reload)
+// stays folded under it while the two chords still differ by that key alone,
+// and shows as a row of its own once they do not. The main menu is built with
+// the user's chords already (AcceleratorsCocoa), so this runs on a change.
+void ApplyShortcutsToMainMenu();
+
+// Whether the menu row of `command` has an App Shortcut the user set in
+// System Settings (NSUserKeyEquivalents): macOS sets that row's key, and the
+// Shortcuts block says so (Z15).
+bool MenuRowHasAppShortcut(int command);
+
+}  // namespace stedding::shortcuts
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SHORTCUT_MENU_MAC_H_
diff --git a/chrome/browser/ui/stedding/shortcut_menu_mac.mm b/chrome/browser/ui/stedding/shortcut_menu_mac.mm
new file mode 100644
index 0000000000000..8356e2eec2a53
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_menu_mac.mm
@@ -0,0 +1,194 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_menu_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include <optional>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "chrome/browser/global_keyboard_shortcuts_mac.h"
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+#include "ui/base/accelerators/accelerator.h"
+#import "ui/base/accelerators/platform_accelerator_cocoa.h"
+#import "ui/base/cocoa/command_dispatcher.h"
+#import "ui/base/cocoa/nsmenuitem_additions.h"
+
+namespace stedding::shortcuts {
+
+namespace {
+
+// A row as it was before the first change: its key, its modifiers and
+// whether it showed folded under the row above.
+struct Original {
+  NSMenuItem* __strong item;
+  NSString* __strong key;
+  NSEventModifierFlags mask;
+  BOOL alternate;
+};
+
+std::vector<Original>& Originals() {
+  static base::NoDestructor<std::vector<Original>> originals;
+  return *originals;
+}
+
+std::optional<size_t> OriginalIndex(NSMenuItem* item) {
+  const std::vector<Original>& originals = Originals();
+  for (size_t i = 0; i < originals.size(); ++i) {
+    if (originals[i].item == item) {
+      return i;
+    }
+  }
+  return std::nullopt;
+}
+
+size_t Remember(NSMenuItem* item) {
+  if (std::optional<size_t> index = OriginalIndex(item)) {
+    return *index;
+  }
+  Originals().push_back({item, item.keyEquivalent ? item.keyEquivalent : @"",
+                         item.keyEquivalentModifierMask, item.isAlternate});
+  return Originals().size() - 1;
+}
+
+bool IsCommandRow(NSMenuItem* item) {
+  return item.tag > 0 && (item.action == @selector(commandDispatch:) ||
+                          item.action == @selector
+                          (commandDispatchUsingKeyModifiers:));
+}
+
+// Z15: an App Shortcut the user set for this row's title in System Settings.
+bool HasUserKeyEquivalent(NSMenuItem* item) {
+  NSString* const title = item.title;
+  if (title.length == 0) {
+    return false;
+  }
+  NSDictionary* const user_equivalents = [NSUserDefaults.standardUserDefaults
+      dictionaryForKey:@"NSUserKeyEquivalents"];
+  return user_equivalents[title] != nil;
+}
+
+std::optional<Chord> ShippedMenuChord(int command) {
+  ui::Accelerator shipped;
+  if (!GetDefaultMacMenuAcceleratorForCommandId(command, &shipped)) {
+    return std::nullopt;
+  }
+  return Chord(shipped.key_code(), shipped.modifiers());
+}
+
+void Restore(const Original& original) {
+  [original.item cr_setKeyEquivalent:original.key
+                        modifierMask:original.mask];
+}
+
+void Show(NSMenuItem* item, const std::optional<Chord>& chord) {
+  if (!chord) {
+    [item cr_clearKeyEquivalent];
+    return;
+  }
+  KeyEquivalentAndModifierMask* const equivalent =
+      ui::GetKeyEquivalentAndModifierMaskFromAccelerator(
+          ui::Accelerator(chord->key, chord->modifiers));
+  [item cr_setKeyEquivalent:equivalent.keyEquivalent
+               modifierMask:equivalent.modifierMask];
+}
+
+// AppKit folds a row under the one above when both have one key and differ
+// in the modifiers alone; Shift may be in the key's case.
+bool FoldsUnder(NSMenuItem* above, NSMenuItem* item) {
+  NSString* const above_key = above.keyEquivalent.lowercaseString;
+  NSString* const key = item.keyEquivalent.lowercaseString;
+  if (![above_key isEqualToString:key]) {
+    return false;
+  }
+  return above.keyEquivalentModifierMask != item.keyEquivalentModifierMask ||
+         ![above.keyEquivalent isEqualToString:item.keyEquivalent];
+}
+
+void ApplyToRow(NSMenuItem* item) {
+  if (!IsCommandRow(item) || HasUserKeyEquivalent(item)) {
+    return;
+  }
+  const int command = static_cast<int>(item.tag);
+  const std::optional<Chord> shipped = ShippedMenuChord(command);
+  const std::optional<size_t> known = OriginalIndex(item);
+  const UserShortcuts& user = Current();
+  // A row without a shipped chord in the tables keeps the key its builder
+  // gave it unless the user changed or turned off its command.
+  const bool touched =
+      shipped ? IsTouched(command, shipped)
+              : (user.IsChanged(command) || user.IsOff(command));
+  if (!touched) {
+    if (known) {
+      Restore(Originals()[*known]);
+    }
+    return;
+  }
+  Remember(item);
+  Show(item, MenuChordFor(command, shipped));
+}
+
+void ApplyToMenu(NSMenu* menu) {
+  NSArray<NSMenuItem*>* const items = menu.itemArray;
+  for (NSMenuItem* item in items) {
+    if (item.hasSubmenu) {
+      if (item.submenu != NSApp.servicesMenu) {
+        ApplyToMenu(item.submenu);
+      }
+      continue;
+    }
+    ApplyToRow(item);
+  }
+  // The folded rows, once both rows of a pair are as they now are.
+  for (NSUInteger i = 1; i < items.count; ++i) {
+    NSMenuItem* const above = items[i - 1];
+    NSMenuItem* const item = items[i];
+    const std::optional<size_t> known = OriginalIndex(item);
+    const bool was_folded =
+        known ? Originals()[*known].alternate : item.isAlternate;
+    if (!was_folded || (!known && !OriginalIndex(above))) {
+      continue;
+    }
+    if (!known) {
+      Remember(item);
+    }
+    item.alternate = FoldsUnder(above, item);
+  }
+}
+
+NSMenuItem* CommandRowInMenu(NSMenu* menu, int command) {
+  for (NSMenuItem* item in menu.itemArray) {
+    if (item.hasSubmenu) {
+      if (NSMenuItem* const found = CommandRowInMenu(item.submenu, command)) {
+        return found;
+      }
+      continue;
+    }
+    if (IsCommandRow(item) && item.tag == command) {
+      return item;
+    }
+  }
+  return nil;
+}
+
+}  // namespace
+
+void ApplyShortcutsToMainMenu() {
+  NSMenu* const main_menu = NSApp.mainMenu;
+  if (!main_menu) {
+    return;
+  }
+  ApplyToMenu(main_menu);
+}
+
+bool MenuRowHasAppShortcut(int command) {
+  NSMenu* const main_menu = NSApp.mainMenu;
+  NSMenuItem* const row =
+      main_menu ? CommandRowInMenu(main_menu, command) : nil;
+  return row && HasUserKeyEquivalent(row);
+}
+
+}  // namespace stedding::shortcuts
diff --git a/chrome/browser/ui/stedding/shortcut_overrides.cc b/chrome/browser/ui/stedding/shortcut_overrides.cc
new file mode 100644
index 0000000000000..4a924ad4eda7c
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_overrides.cc
@@ -0,0 +1,213 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+
+#include <cstdint>
+#include <utility>
+
+#include "base/functional/callback.h"
+#include "base/no_destructor.h"
+#include "build/build_config.h"
+
+namespace stedding::shortcuts {
+
+namespace {
+
+struct State {
+  UserShortcuts current;
+  int generation = 0;
+  base::RepeatingClosureList callbacks;
+  // The recording window's address, compared and never followed.
+  uintptr_t recording_target = 0;
+};
+
+State& GetState() {
+  static base::NoDestructor<State> state;
+  return *state;
+}
+
+}  // namespace
+
+UserShortcuts::UserShortcuts() = default;
+UserShortcuts::UserShortcuts(const UserShortcuts&) = default;
+UserShortcuts& UserShortcuts::operator=(const UserShortcuts&) = default;
+UserShortcuts::UserShortcuts(UserShortcuts&&) = default;
+UserShortcuts& UserShortcuts::operator=(UserShortcuts&&) = default;
+UserShortcuts::~UserShortcuts() = default;
+
+int UserShortcuts::CommandFor(const Chord& chord) const {
+  for (const auto& [command, command_chords] : chords) {
+    if (off.contains(command)) {
+      continue;
+    }
+    for (const Chord& user_chord : command_chords) {
+      if (user_chord == chord) {
+        return command;
+      }
+    }
+  }
+  return 0;
+}
+
+bool UserShortcuts::KeepsDefault(int command, const Chord& chord) const {
+  if (IsChanged(command) || IsOff(command)) {
+    return false;
+  }
+  return CommandFor(chord) == 0;
+}
+
+const UserShortcuts& Current() {
+  return GetState().current;
+}
+
+void SetCurrent(UserShortcuts shortcuts) {
+  State& state = GetState();
+  if (state.current == shortcuts) {
+    return;
+  }
+  state.current = std::move(shortcuts);
+  ++state.generation;
+  state.callbacks.Notify();
+}
+
+int Generation() {
+  return GetState().generation;
+}
+
+base::CallbackListSubscription AddChangedCallback(
+    base::RepeatingClosure callback) {
+  return GetState().callbacks.Add(std::move(callback));
+}
+
+std::vector<Binding> Apply(const std::vector<Binding>& defaults,
+                           const UserShortcuts& user,
+                           bool append_user_chords) {
+  std::vector<Binding> effective;
+  effective.reserve(defaults.size());
+  for (const Binding& binding : defaults) {
+    if (user.KeepsDefault(binding.command, binding.chord)) {
+      effective.push_back(binding);
+    }
+  }
+  if (append_user_chords) {
+    for (const auto& [command, command_chords] : user.chords) {
+      if (user.IsOff(command)) {
+        continue;
+      }
+      for (const Chord& chord : command_chords) {
+        effective.push_back({command, chord});
+      }
+    }
+  }
+  return effective;
+}
+
+std::vector<Binding> ApplyForViewsTable(const std::vector<Binding>& defaults) {
+  const UserShortcuts& user = Current();
+#if BUILDFLAG(IS_MAC)
+  std::vector<Binding> effective =
+      Apply(defaults, user, /*append_user_chords=*/false);
+  constexpr int kKeyEquivalentModifiers =
+      ui::EF_COMMAND_DOWN | ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN;
+  for (const auto& [command, command_chords] : user.chords) {
+    if (user.IsOff(command)) {
+      continue;
+    }
+    for (const Chord& chord : command_chords) {
+      if (!(chord.modifiers & kKeyEquivalentModifiers)) {
+        effective.push_back({command, chord});
+      }
+    }
+  }
+  return effective;
+#else
+  return Apply(defaults, user);
+#endif
+}
+
+std::optional<Chord> MenuChordFor(int command,
+                                  const std::optional<Chord>& default_chord) {
+  const UserShortcuts& user = Current();
+  if (user.IsOff(command)) {
+    return std::nullopt;
+  }
+  if (auto it = user.chords.find(command); it != user.chords.end()) {
+    if (it->second.empty()) {
+      return std::nullopt;
+    }
+    return it->second.front();
+  }
+  if (default_chord && user.CommandFor(*default_chord) != 0) {
+    return std::nullopt;
+  }
+  return default_chord;
+}
+
+bool IsTouched(int command, const std::optional<Chord>& default_chord) {
+  const UserShortcuts& user = Current();
+  return user.IsChanged(command) || user.IsOff(command) ||
+         (default_chord && user.CommandFor(*default_chord) != 0);
+}
+
+bool IsOff(int command) {
+  return Current().IsOff(command);
+}
+
+bool IsOnPlatformKey(int command, bool ships_on_it) {
+  const UserShortcuts& user = Current();
+  if (user.IsOff(command)) {
+    return false;
+  }
+  const auto it = user.chords.find(command);
+  if (it == user.chords.end()) {
+    return ships_on_it;
+  }
+  return !it->second.empty() &&
+         it->second.front().modifiers == ui::EF_PLATFORM_ACCELERATOR;
+}
+
+void SetRecordingTarget(const void* target) {
+  GetState().recording_target = reinterpret_cast<uintptr_t>(target);
+}
+
+bool IsRecording() {
+  return GetState().recording_target != 0;
+}
+
+bool IsRecordingIn(const void* target) {
+  return target &&
+         GetState().recording_target == reinterpret_cast<uintptr_t>(target);
+}
+
+int HeldModifiers(int chord_modifiers) {
+  return chord_modifiers &
+         (ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN);
+}
+
+bool IsHeldModifierKey(ui::KeyboardCode key, int held_modifiers) {
+  if ((held_modifiers & ui::EF_CONTROL_DOWN) &&
+      (key == ui::VKEY_CONTROL || key == ui::VKEY_LCONTROL ||
+       key == ui::VKEY_RCONTROL)) {
+    return true;
+  }
+  if ((held_modifiers & ui::EF_ALT_DOWN) &&
+      (key == ui::VKEY_MENU || key == ui::VKEY_LMENU ||
+       key == ui::VKEY_RMENU)) {
+    return true;
+  }
+  if ((held_modifiers & ui::EF_COMMAND_DOWN) &&
+      (key == ui::VKEY_COMMAND || key == ui::VKEY_RWIN ||
+       key == ui::VKEY_APPS)) {
+    return true;
+  }
+  return false;
+}
+
+bool HoldsModifiers(int event_flags, int held_modifiers) {
+  return held_modifiers != 0 &&
+         (event_flags & held_modifiers) == held_modifiers;
+}
+
+}  // namespace stedding::shortcuts
diff --git a/chrome/browser/ui/stedding/shortcut_overrides.h b/chrome/browser/ui/stedding/shortcut_overrides.h
new file mode 100644
index 0000000000000..6f94383eff8b2
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_overrides.h
@@ -0,0 +1,155 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_SHORTCUT_OVERRIDES_H_
+#define CHROME_BROWSER_UI_STEDDING_SHORTCUT_OVERRIDES_H_
+
+#include <compare>
+#include <map>
+#include <optional>
+#include <set>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+// The user's own chords over the shipped tables (docs/features/shortcuts.md
+// Z10-Z20). This is the one overlay every lookup point reads: the views
+// accelerator table, the Mac's menu and non-menu tables, the command bar,
+// the held keys. It knows only commands and keys, so the lowest tables can
+// depend on it without a cycle; the catalog, the preference and the checks
+// live in shortcut_catalog.h, shortcut_editor.h and shortcut_service.h.
+namespace stedding::shortcuts {
+
+// The modifiers a chord keeps; everything else in an event's flags (a
+// repeat, an extended key) is not part of the chord.
+inline constexpr int kChordModifierMask =
+    ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN | ui::EF_ALT_DOWN |
+    ui::EF_COMMAND_DOWN | ui::EF_FUNCTION_DOWN | ui::EF_ALTGR_DOWN;
+
+// One key with its modifiers, as the tables bind it.
+struct Chord {
+  constexpr Chord() = default;
+  constexpr Chord(ui::KeyboardCode key_code, int flags)
+      : key(key_code), modifiers(flags & kChordModifierMask) {}
+
+  friend bool operator==(const Chord&, const Chord&) = default;
+  friend auto operator<=>(const Chord&, const Chord&) = default;
+
+  ui::KeyboardCode key = ui::VKEY_UNKNOWN;
+  int modifiers = 0;
+};
+
+// A command on a chord, one row of a table.
+struct Binding {
+  friend bool operator==(const Binding&, const Binding&) = default;
+
+  int command = 0;
+  Chord chord;
+};
+
+// What the user changed, resolved against the catalog: the chords of every
+// command whose keys the user set, which replace all its defaults, and the
+// commands turned off. A command in neither keeps its defaults, except a
+// default chord the user gave to another command (Z20).
+struct UserShortcuts {
+  UserShortcuts();
+  UserShortcuts(const UserShortcuts&);
+  UserShortcuts& operator=(const UserShortcuts&);
+  UserShortcuts(UserShortcuts&&);
+  UserShortcuts& operator=(UserShortcuts&&);
+  ~UserShortcuts();
+
+  friend bool operator==(const UserShortcuts&, const UserShortcuts&) = default;
+
+  bool empty() const { return chords.empty() && off.empty(); }
+  bool IsChanged(int command) const { return chords.contains(command); }
+  bool IsOff(int command) const { return off.contains(command); }
+  // The command a user chord belongs to, or 0 when no user chord is `chord`.
+  int CommandFor(const Chord& chord) const;
+  // Whether `command` keeps its default `chord`: it is neither changed nor
+  // off, and no user chord took that chord.
+  bool KeepsDefault(int command, const Chord& chord) const;
+
+  std::map<int, std::vector<Chord>> chords;
+  std::set<int> off;
+};
+
+// The set in force. Empty until the service reads the preference, and in a
+// process that has none (a Mac app shim keeps the defaults).
+const UserShortcuts& Current();
+
+// Replaces the set in force. When it differs, the generation goes up and
+// every changed callback runs, synchronously: the windows reload their
+// accelerators, the Mac's menu takes the new chords (Z11).
+void SetCurrent(UserShortcuts shortcuts);
+
+// Goes up on every change; caches of an effective table compare it.
+int Generation();
+
+// Runs `callback` after every change of the set in force.
+[[nodiscard]] base::CallbackListSubscription AddChangedCallback(
+    base::RepeatingClosure callback);
+
+// The effective table: `defaults` without the bindings of changed or off
+// commands and without default chords a user chord took, then the user's
+// chords. With `append_user_chords` false the user's chords are not added
+// (the Mac's views table, which holds only keys without Cmd, Ctrl or Alt,
+// takes only such user chords: see `ForViewsTable`).
+std::vector<Binding> Apply(const std::vector<Binding>& defaults,
+                           const UserShortcuts& user,
+                           bool append_user_chords = true);
+
+// Apply() for the views accelerator table (accelerator_table.cc): every user
+// chord on Windows and Linux; on the Mac, where every chord with Cmd, Ctrl or
+// Alt is a key equivalent handled before the views table, only those without.
+std::vector<Binding> ApplyForViewsTable(const std::vector<Binding>& defaults);
+
+// The chord a Mac menu row for `command` shows, given the row's default:
+// the user's first chord, nothing when the command is off or its default was
+// taken, else the default.
+std::optional<Chord> MenuChordFor(int command,
+                                  const std::optional<Chord>& default_chord);
+
+// Whether the overlay changes anything about `command`, whose default menu
+// chord is `default_chord`: changed, off, or its default taken.
+bool IsTouched(int command, const std::optional<Chord>& default_chord);
+
+// Whether the user turned `command` off (Z17: with the row-number chords off,
+// holding Cmd shows no numbers).
+bool IsOff(int command);
+
+// Z17, Z23: whether `command` is on and its first chord holds the platform's
+// key (⌘ on the Mac, Ctrl elsewhere); unchanged, whether it `ships_on_it`. A
+// layout of the number keys may move the rows off that key and the Spaces
+// onto it: holding the key numbers what it reaches.
+bool IsOnPlatformKey(int command, bool ships_on_it);
+
+// Recording (Z19). While a settings page records a chord, its window's keys
+// go to the page: the views focus manager is suspended for that window, and
+// the Mac's command dispatcher passes every key equivalent of that window to
+// the page and drops what the page leaves. `target` is the window's
+// views::Widget, compared by address only.
+void SetRecordingTarget(const void* target);
+bool IsRecording();
+bool IsRecordingIn(const void* target);
+
+// The held commands (Z18): the modifiers that keep a run going are the
+// chord's Ctrl, Alt and Cmd; Shift only steps the other way.
+int HeldModifiers(int chord_modifiers);
+
+// Whether `key` is one of the modifier keys in `held_modifiers` (either Ctrl,
+// either Alt, either Cmd or Windows key; the Mac reports the right Command
+// key as VKEY_APPS).
+bool IsHeldModifierKey(ui::KeyboardCode key, int held_modifiers);
+
+// Whether an event with `event_flags` still has every modifier of
+// `held_modifiers` down.
+bool HoldsModifiers(int event_flags, int held_modifiers);
+
+}  // namespace stedding::shortcuts
+
+#endif  // CHROME_BROWSER_UI_STEDDING_SHORTCUT_OVERRIDES_H_
diff --git a/chrome/browser/ui/stedding/shortcut_overrides_unittest.cc b/chrome/browser/ui/stedding/shortcut_overrides_unittest.cc
new file mode 100644
index 0000000000000..9b02e22ea122f
--- /dev/null
+++ b/chrome/browser/ui/stedding/shortcut_overrides_unittest.cc
@@ -0,0 +1,477 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/shortcut_overrides.h"
+
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "build/build_config.h"
+#include "chrome/app/chrome_command_ids.h"
+#include "chrome/browser/ui/stedding/shortcut_catalog.h"
+#include "chrome/browser/ui/stedding/shortcut_chord.h"
+#include "chrome/browser/ui/stedding/shortcut_editor.h"
+#include "chrome/browser/ui/stedding/stedding_command_ids.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+
+namespace stedding::shortcuts {
+namespace {
+
+constexpr int kCtrl = ui::EF_CONTROL_DOWN;
+constexpr int kAlt = ui::EF_ALT_DOWN;
+constexpr int kShift = ui::EF_SHIFT_DOWN;
+
+Chord CtrlAlt(ui::KeyboardCode key) {
+  return Chord(key, kCtrl | kAlt);
+}
+
+// A shipped table of the test's own, the same on every platform, so the
+// rules are tested apart from what a release binds.
+std::vector<Binding> TestDefaults() {
+  return {
+      {IDC_NEW_TAB, CtrlAlt(ui::VKEY_T)},
+      {IDC_STEDDING_CLEAR_SPACE, CtrlAlt(ui::VKEY_K)},
+      {IDC_STEDDING_SPACE_NEXT, CtrlAlt(ui::VKEY_N)},
+      {IDC_STEDDING_SPACE_NEXT, CtrlAlt(ui::VKEY_RIGHT)},
+      {IDC_SELECT_TAB_0, CtrlAlt(ui::VKEY_1)},
+      {IDC_SELECT_TAB_1, CtrlAlt(ui::VKEY_2)},
+      {IDC_SELECT_LAST_TAB, CtrlAlt(ui::VKEY_9)},
+      {IDC_CYCLE_TO_NEXT_TAB, Chord(ui::VKEY_TAB, kCtrl)},
+      {IDC_CYCLE_TO_PREV_TAB, Chord(ui::VKEY_TAB, kCtrl | kShift)},
+      {IDC_STEDDING_RUN_EXTENSION, CtrlAlt(ui::VKEY_E)},
+      {IDC_CLOSE_WINDOW, CtrlAlt(ui::VKEY_W)},
+  };
+}
+
+const Entry& Row(const char* name) {
+  const Entry* const entry = EntryForName(name);
+  CHECK(entry) << name;
+  return *entry;
+}
+
+// A stored entry with these keys.
+base::DictValue Keys(base::ListValue keys) {
+  base::DictValue entry;
+  entry.Set("keys", std::move(keys));
+  return entry;
+}
+
+std::vector<Chord> ChordsOf(const std::vector<Binding>& table, int command) {
+  std::vector<Chord> chords;
+  for (const Binding& binding : table) {
+    if (binding.command == command) {
+      chords.push_back(binding.chord);
+    }
+  }
+  return chords;
+}
+
+class ShortcutOverridesTest : public testing::Test {
+ protected:
+  void TearDown() override { SetCurrent(UserShortcuts()); }
+
+  // The table in force for what `stored_` says.
+  std::vector<Binding> Effective() const {
+    return Apply(defaults_, Resolve(stored_));
+  }
+
+  base::DictValue stored_;
+  std::vector<Binding> defaults_ = TestDefaults();
+  ShortcutEditor editor_{stored_, TestDefaults()};
+};
+
+// docs/features/shortcuts.md Z5, Z10: a row's own chords replace all its
+// defaults; the other rows keep theirs.
+TEST_F(ShortcutOverridesTest, AUserChordReplacesTheDefaults) {
+  ASSERT_EQ(CheckKind::kOk,
+            editor_.Add(Row("next-space"), CtrlAlt(ui::VKEY_J),
+                        /*replace=*/false)
+                .kind);
+  ASSERT_TRUE(editor_.Remove(Row("next-space"), CtrlAlt(ui::VKEY_N)));
+  ASSERT_TRUE(editor_.Remove(Row("next-space"), CtrlAlt(ui::VKEY_RIGHT)));
+  const std::vector<Binding> table = Effective();
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_J)},
+            ChordsOf(table, IDC_STEDDING_SPACE_NEXT));
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_T)},
+            ChordsOf(table, IDC_NEW_TAB));
+  // Stored by name, with the chord as text (Z10).
+  const base::ListValue* const keys =
+      stored_.FindDictByDottedPath("commands.next-space")->FindList("keys");
+  ASSERT_TRUE(keys);
+  ASSERT_EQ(1u, keys->size());
+  EXPECT_EQ("Ctrl+Alt+J", (*keys)[0].GetString());
+  EXPECT_EQ(kFormatVersion, stored_.FindInt("v"));
+  EXPECT_TRUE(editor_.StateOf(Row("next-space")).changed);
+}
+
+// Z5: the switch turns every chord of the row off and keeps them for when it
+// is turned on again.
+TEST_F(ShortcutOverridesTest, OffRemovesEveryChordAndKeepsTheList) {
+  ASSERT_TRUE(editor_.SetOff(Row("next-space"), true));
+  EXPECT_TRUE(ChordsOf(Effective(), IDC_STEDDING_SPACE_NEXT).empty());
+  EXPECT_TRUE(Resolve(stored_).IsOff(IDC_STEDDING_SPACE_NEXT));
+  const RowState off = editor_.StateOf(Row("next-space"));
+  EXPECT_TRUE(off.off);
+  EXPECT_EQ((std::vector<Chord>{CtrlAlt(ui::VKEY_N), CtrlAlt(ui::VKEY_RIGHT)}),
+            off.chords);
+
+  ASSERT_TRUE(editor_.SetOff(Row("next-space"), false));
+  EXPECT_EQ((std::vector<Chord>{CtrlAlt(ui::VKEY_N), CtrlAlt(ui::VKEY_RIGHT)}),
+            ChordsOf(Effective(), IDC_STEDDING_SPACE_NEXT));
+  EXPECT_FALSE(stored_.FindDictByDottedPath("commands.next-space"))
+      << "back to the defaults, so no entry";
+}
+
+// Z5, Z21: Reset puts the row's defaults back; Reset all puts every row's.
+TEST_F(ShortcutOverridesTest, ResetPutsTheDefaultsBack) {
+  ASSERT_EQ(CheckKind::kOk, editor_.Add(Row("new-tab"), CtrlAlt(ui::VKEY_J),
+                                        /*replace=*/false)
+                                .kind);
+  ASSERT_TRUE(editor_.SetOff(Row("clear-space"), true));
+  EXPECT_TRUE(editor_.StateOf(Row("new-tab")).changed);
+  ASSERT_TRUE(editor_.Reset(Row("new-tab")));
+  EXPECT_FALSE(editor_.StateOf(Row("new-tab")).changed);
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_T)},
+            ChordsOf(Effective(), IDC_NEW_TAB));
+  EXPECT_TRUE(editor_.StateOf(Row("clear-space")).off);
+
+  editor_.ResetAll();
+  EXPECT_FALSE(editor_.StateOf(Row("clear-space")).off);
+  EXPECT_EQ(TestDefaults(), Effective());
+}
+
+// Z12: a chord another row has is named before it is taken.
+TEST_F(ShortcutOverridesTest, AConflictNamesTheOtherCommand) {
+  const CheckResult result =
+      editor_.Check(Row("new-tab"), CtrlAlt(ui::VKEY_K));
+  EXPECT_EQ(CheckKind::kConflict, result.kind);
+  EXPECT_EQ(&Row("clear-space"), result.other.get());
+  EXPECT_NE(std::u16string::npos, result.message.find(Row("clear-space").label))
+      << base::UTF16ToUTF8(result.message);
+  EXPECT_EQ(CheckKind::kSame,
+            editor_.Check(Row("new-tab"), CtrlAlt(ui::VKEY_T)).kind);
+  // A fixed row's chord is not offered at all.
+  EXPECT_EQ(CheckKind::kRefused,
+            editor_.Check(Row("new-tab"), CtrlAlt(ui::VKEY_W)).kind);
+}
+
+// Z12: Replace moves the chord; the other row keeps its other chords, and
+// with none left it is off. Without Replace nothing changes. Two rows never
+// share a chord.
+TEST_F(ShortcutOverridesTest, ReplaceTakesTheChordFromTheOther) {
+  EXPECT_EQ(CheckKind::kConflict,
+            editor_.Add(Row("new-tab"), CtrlAlt(ui::VKEY_N), /*replace=*/false)
+                .kind);
+  EXPECT_EQ(TestDefaults(), Effective()) << "Cancel leaves both as they were";
+
+  EXPECT_EQ(CheckKind::kConflict,
+            editor_.Add(Row("new-tab"), CtrlAlt(ui::VKEY_N), /*replace=*/true)
+                .kind);
+  std::vector<Binding> table = Effective();
+  EXPECT_EQ((std::vector<Chord>{CtrlAlt(ui::VKEY_T), CtrlAlt(ui::VKEY_N)}),
+            ChordsOf(table, IDC_NEW_TAB));
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_RIGHT)},
+            ChordsOf(table, IDC_STEDDING_SPACE_NEXT));
+
+  ASSERT_EQ(CheckKind::kConflict,
+            editor_
+                .Add(Row("new-tab"), CtrlAlt(ui::VKEY_RIGHT), /*replace=*/true)
+                .kind);
+  table = Effective();
+  EXPECT_TRUE(ChordsOf(table, IDC_STEDDING_SPACE_NEXT).empty());
+  EXPECT_TRUE(editor_.StateOf(Row("next-space")).off);
+  for (const Binding& binding : table) {
+    int holders = 0;
+    for (const Binding& other : table) {
+      holders += other.chord == binding.chord ? 1 : 0;
+    }
+    EXPECT_EQ(1, holders) << ChordToString(binding.chord);
+  }
+}
+
+// Z20: a chord the user chose stays theirs when a later release ships a
+// default on it; the row that lost it says so.
+TEST_F(ShortcutOverridesTest, AUserChordBeatsANewDefault) {
+  ASSERT_EQ(CheckKind::kOk, editor_.Add(Row("new-tab"), CtrlAlt(ui::VKEY_J),
+                                        /*replace=*/false)
+                                .kind);
+  std::vector<Binding> later = TestDefaults();
+  later.push_back({IDC_STEDDING_CLEAR_SPACE, CtrlAlt(ui::VKEY_J)});
+  ShortcutEditor next_release(stored_, later);
+  const std::vector<Binding> table = Apply(later, Resolve(stored_));
+  EXPECT_EQ((std::vector<Chord>{CtrlAlt(ui::VKEY_T), CtrlAlt(ui::VKEY_J)}),
+            ChordsOf(table, IDC_NEW_TAB));
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_K)},
+            ChordsOf(table, IDC_STEDDING_CLEAR_SPACE));
+  const RowState clear = next_release.StateOf(Row("clear-space"));
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_J)}, clear.lost);
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_K)}, clear.chords);
+}
+
+// Z10: an entry naming no row, a fixed row's entry and a chord that cannot be
+// read are ignored and left in place; two rows claiming one chord leave it
+// with the first in the catalog's order.
+TEST_F(ShortcutOverridesTest, UnknownNamesAndBadChordsAreIgnored) {
+  base::DictValue commands;
+  base::ListValue unknown_keys;
+  unknown_keys.Append("Ctrl+Alt+Q");
+  commands.Set("no-such-row", Keys(std::move(unknown_keys)));
+  base::ListValue new_tab_keys;
+  new_tab_keys.Append("Ctrl+Alt+J");
+  new_tab_keys.Append("Bogus+Q");
+  new_tab_keys.Append(5);
+  new_tab_keys.Append("Ctrl+Alt+L");
+  commands.Set("new-tab", Keys(std::move(new_tab_keys)));
+  base::ListValue sidebar_keys;
+  sidebar_keys.Append("Ctrl+Alt+L");
+  commands.Set("toggle-sidebar", Keys(std::move(sidebar_keys)));
+  base::ListValue close_keys;
+  close_keys.Append("Ctrl+Alt+Q");
+  commands.Set("close-window", Keys(std::move(close_keys)));
+  stored_.Set("v", 1);
+  stored_.Set("commands", std::move(commands));
+
+  const UserShortcuts user = Resolve(stored_);
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_J)}, user.chords.at(IDC_NEW_TAB))
+      << "the unreadable keys dropped, Ctrl+Alt+L kept by the first row";
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_L)},
+            user.chords.at(IDC_TOGGLE_VERTICAL_TABS_COLLAPSE));
+  EXPECT_FALSE(user.IsChanged(IDC_CLOSE_WINDOW)) << "a fixed row";
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_W)},
+            ChordsOf(Apply(defaults_, user), IDC_CLOSE_WINDOW));
+
+  editor_.ResetAll();
+  EXPECT_TRUE(stored_.FindDictByDottedPath("commands.no-such-row"))
+      << "a later release's row is left for it";
+  EXPECT_FALSE(stored_.FindDictByDottedPath("commands.new-tab"));
+}
+
+// Z18: the held commands need a modifier that is held, the recent tabs a
+// chord without Shift, whose Shift twin goes the other way round.
+TEST_F(ShortcutOverridesTest, HeldCommandsNeedAHeldModifier) {
+  EXPECT_EQ(CheckKind::kRefused,
+            editor_.Check(Row("run-extension"), Chord(ui::VKEY_F8, 0)).kind);
+  EXPECT_EQ(CheckKind::kRefused,
+            editor_.Check(Row("recent-tab"), Chord(ui::VKEY_J, kCtrl | kShift))
+                .kind);
+  EXPECT_EQ(CheckKind::kRefused,
+            editor_.Check(Row("recent-tab-back"), CtrlAlt(ui::VKEY_J)).kind)
+      << "it follows Most Recent Tab";
+  // Ctrl+Alt+K itself is Clear's.
+  EXPECT_EQ(CheckKind::kConflict,
+            editor_.Check(Row("recent-tab"), CtrlAlt(ui::VKEY_K)).kind);
+
+  ASSERT_EQ(CheckKind::kOk, editor_.Add(Row("recent-tab"), CtrlAlt(ui::VKEY_J),
+                                        /*replace=*/false)
+                                .kind);
+  ASSERT_TRUE(editor_.Remove(Row("recent-tab"), Chord(ui::VKEY_TAB, kCtrl)));
+  const std::vector<Binding> table = Effective();
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_J)},
+            ChordsOf(table, IDC_CYCLE_TO_NEXT_TAB));
+  EXPECT_EQ(std::vector<Chord>{Chord(ui::VKEY_J, kCtrl | kAlt | kShift)},
+            ChordsOf(table, IDC_CYCLE_TO_PREV_TAB));
+
+  // The run is held by the chord's Ctrl and Alt, not by Shift.
+  const int held = HeldModifiers(kCtrl | kAlt | kShift);
+  EXPECT_EQ(kCtrl | kAlt, held);
+  EXPECT_TRUE(IsHeldModifierKey(ui::VKEY_LMENU, held));
+  EXPECT_TRUE(IsHeldModifierKey(ui::VKEY_RCONTROL, held));
+  EXPECT_FALSE(IsHeldModifierKey(ui::VKEY_SHIFT, held));
+  EXPECT_FALSE(IsHeldModifierKey(ui::VKEY_COMMAND, held));
+  EXPECT_TRUE(HoldsModifiers(kCtrl | kAlt | kShift, held));
+  EXPECT_FALSE(HoldsModifiers(kCtrl, held));
+  EXPECT_TRUE(IsHeldModifierKey(ui::VKEY_APPS, ui::EF_COMMAND_DOWN))
+      << "the Mac's right Command key";
+}
+
+// Z17: the row numbers and the Spaces are one row each; the switch turns the
+// nine off together, and they cannot be rebound.
+TEST_F(ShortcutOverridesTest, FamiliesTurnOffTogether) {
+  EXPECT_EQ(CheckKind::kRefused,
+            editor_.Check(Row("new-tab"), CtrlAlt(ui::VKEY_1)).kind)
+      << "a row number's chord, while they are on";
+  EXPECT_EQ(CheckKind::kRefused,
+            editor_.Check(Row("tab-by-number"), CtrlAlt(ui::VKEY_J)).kind);
+
+  ASSERT_TRUE(editor_.SetOff(Row("tab-by-number"), true));
+  const UserShortcuts user = Resolve(stored_);
+  for (int command :
+       {IDC_SELECT_TAB_0, IDC_SELECT_TAB_1, IDC_SELECT_TAB_2,
+        IDC_SELECT_TAB_3, IDC_SELECT_TAB_4, IDC_SELECT_TAB_5,
+        IDC_SELECT_TAB_6, IDC_SELECT_TAB_7, IDC_SELECT_LAST_TAB}) {
+    EXPECT_TRUE(user.IsOff(command)) << command;
+  }
+  const std::vector<Binding> table = Effective();
+  EXPECT_TRUE(ChordsOf(table, IDC_SELECT_TAB_0).empty());
+  EXPECT_TRUE(ChordsOf(table, IDC_SELECT_LAST_TAB).empty());
+  EXPECT_EQ(CheckKind::kOk,
+            editor_.Check(Row("new-tab"), CtrlAlt(ui::VKEY_1)).kind)
+      << "free once the row numbers are off";
+
+  SetCurrent(user);
+  EXPECT_TRUE(IsOff(IDC_SELECT_TAB_0)) << "holding the key shows no numbers";
+}
+
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+// Z23 (GitHub issue 13): a layout of the number keys moves both sets of nine
+// at once, the digit and the number pad's twin; it takes a chord another row
+// was given, it gives none to a set that is off, and the Space row shows its
+// keys. A name it cannot read, and Reset all, are the shipped layout.
+TEST_F(ShortcutOverridesTest, TheNumberKeysMoveBothSets) {
+#if BUILDFLAG(IS_MAC)
+  constexpr int kFirst = ui::EF_COMMAND_DOWN;
+  constexpr int kSecond = ui::EF_CONTROL_DOWN;
+  constexpr int kThird = ui::EF_CONTROL_DOWN | ui::EF_COMMAND_DOWN;
+#else
+  constexpr int kFirst = kCtrl;
+  constexpr int kSecond = kAlt;
+  constexpr int kThird = kAlt | kShift;
+#endif
+  // A chord a set takes in the layouts with the third key, given to a row
+  // first.
+  ASSERT_EQ(CheckKind::kOk,
+            editor_.Add(Row("new-tab"), Chord(ui::VKEY_5, kThird),
+                        /*replace=*/false)
+                .kind);
+  ASSERT_FALSE(stored_.FindString(kNumberKeysKey));
+
+  struct Layout {
+    NumberKeys layout;
+    int rows;
+    int spaces;
+  };
+  for (const Layout& expected :
+       {Layout{NumberKeys::kSpacesFirst, kSecond, kFirst},
+        Layout{NumberKeys::kRowsFirstSpacesThird, kFirst, kThird},
+        Layout{NumberKeys::kSpacesFirstRowsThird, kThird, kFirst}}) {
+    SCOPED_TRACE(NumberKeysName(expected.layout));
+    ASSERT_TRUE(editor_.SetNumberKeys(expected.layout));
+    ASSERT_TRUE(stored_.FindString(kNumberKeysKey));
+    EXPECT_EQ(NumberKeysName(expected.layout),
+              *stored_.FindString(kNumberKeysKey));
+    const std::vector<Binding> table = Effective();
+    EXPECT_EQ((std::vector<Chord>{Chord(ui::VKEY_1, expected.rows),
+                                  Chord(ui::VKEY_NUMPAD1, expected.rows)}),
+              ChordsOf(table, IDC_SELECT_TAB_0));
+    EXPECT_EQ((std::vector<Chord>{Chord(ui::VKEY_9, expected.rows),
+                                  Chord(ui::VKEY_NUMPAD9, expected.rows)}),
+              ChordsOf(table, IDC_SELECT_LAST_TAB));
+    EXPECT_EQ((std::vector<Chord>{Chord(ui::VKEY_1, expected.spaces),
+                                  Chord(ui::VKEY_NUMPAD1, expected.spaces)}),
+              ChordsOf(table, IDC_STEDDING_SPACE_1));
+    EXPECT_EQ((std::vector<Chord>{Chord(ui::VKEY_9, expected.spaces),
+                                  Chord(ui::VKEY_NUMPAD9, expected.spaces)}),
+              ChordsOf(table, IDC_STEDDING_SPACE_9));
+    // The other row keeps the chord only while neither set wants it.
+    const bool third_taken =
+        expected.rows == kThird || expected.spaces == kThird;
+    EXPECT_EQ(third_taken ? std::vector<Chord>{CtrlAlt(ui::VKEY_T)}
+                           : (std::vector<Chord>{CtrlAlt(ui::VKEY_T),
+                                                 Chord(ui::VKEY_5, kThird)}),
+              ChordsOf(table, IDC_NEW_TAB));
+    // Z17: while the set is on, no other row may take one of its chords.
+    EXPECT_EQ(CheckKind::kRefused,
+              editor_
+                  .Check(Row("clear-space"), Chord(ui::VKEY_2, expected.spaces))
+                  .kind);
+    const RowState space_row = editor_.StateOf(Row("space-by-number"));
+    ASSERT_FALSE(space_row.chords.empty());
+    EXPECT_EQ(Chord(ui::VKEY_1, expected.spaces), space_row.chords.front());
+    EXPECT_FALSE(space_row.changed) << "the menu, not Reset, undoes a layout";
+  }
+
+  // A set that is off keeps no chord, and its keys are free.
+  ASSERT_TRUE(editor_.SetNumberKeys(NumberKeys::kSpacesFirst));
+  ASSERT_TRUE(editor_.SetOff(Row("space-by-number"), true));
+  EXPECT_TRUE(ChordsOf(Effective(), IDC_STEDDING_SPACE_1).empty());
+  EXPECT_EQ(CheckKind::kOk,
+            editor_.Check(Row("clear-space"), Chord(ui::VKEY_2, kFirst)).kind);
+  EXPECT_EQ(Chord(ui::VKEY_1, kFirst),
+            editor_.StateOf(Row("space-by-number")).chords.front())
+      << "the row still names the keys it has when turned on";
+
+  // Holding the platform's key numbers the rows only while they keep it.
+  SetCurrent(Resolve(stored_));
+  EXPECT_FALSE(IsOnPlatformKey(IDC_SELECT_TAB_0, /*ships_on_it=*/true));
+  EXPECT_FALSE(IsOnPlatformKey(IDC_STEDDING_SPACE_1, /*ships_on_it=*/false))
+      << "the Spaces are off";
+  ASSERT_TRUE(editor_.SetOff(Row("space-by-number"), false));
+  SetCurrent(Resolve(stored_));
+  EXPECT_TRUE(IsOnPlatformKey(IDC_STEDDING_SPACE_1, /*ships_on_it=*/false));
+
+  stored_.Set(kNumberKeysKey, "sideways");
+  EXPECT_EQ(NumberKeys::kRowsFirst, NumberKeysOf(stored_));
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_1)},
+            ChordsOf(Effective(), IDC_SELECT_TAB_0));
+
+  ASSERT_TRUE(editor_.SetNumberKeys(NumberKeys::kSpacesFirst));
+  editor_.ResetAll();
+  EXPECT_FALSE(stored_.FindString(kNumberKeysKey));
+  EXPECT_EQ(std::vector<Chord>{CtrlAlt(ui::VKEY_1)},
+            ChordsOf(Effective(), IDC_SELECT_TAB_0));
+  SetCurrent(Resolve(stored_));
+  EXPECT_TRUE(IsOnPlatformKey(IDC_SELECT_TAB_0, /*ships_on_it=*/true));
+}
+#endif  // BUILDFLAG(IS_MAC) || BUILDFLAG(IS_WIN)
+
+// Z11: a change bumps the generation and runs the callbacks at once; the same
+// set again does nothing.
+TEST_F(ShortcutOverridesTest, AChangeRunsTheCallbacks) {
+  int runs = 0;
+  const base::CallbackListSubscription subscription = AddChangedCallback(
+      base::BindRepeating([](int* count) { ++*count; }, &runs));
+  const int before = Generation();
+  UserShortcuts user;
+  user.chords[IDC_NEW_TAB] = {CtrlAlt(ui::VKEY_J)};
+  SetCurrent(user);
+  EXPECT_EQ(1, runs);
+  EXPECT_EQ(before + 1, Generation());
+  SetCurrent(user);
+  EXPECT_EQ(1, runs);
+  EXPECT_EQ(IDC_NEW_TAB, Current().CommandFor(CtrlAlt(ui::VKEY_J)));
+}
+
+// Z11 on the Mac: a menu row shows the user's first chord, nothing when the
+// command is off or its default went to another command, else its default.
+TEST_F(ShortcutOverridesTest, TheMenuChordFollowsTheUser) {
+  UserShortcuts user;
+  user.chords[IDC_NEW_TAB] = {CtrlAlt(ui::VKEY_J), CtrlAlt(ui::VKEY_L)};
+  user.chords[IDC_STEDDING_CLEAR_SPACE] = {CtrlAlt(ui::VKEY_N)};
+  user.off.insert(IDC_STEDDING_SPACE_PREVIOUS);
+  SetCurrent(user);
+  EXPECT_EQ(CtrlAlt(ui::VKEY_J), MenuChordFor(IDC_NEW_TAB, CtrlAlt(ui::VKEY_T)));
+  EXPECT_FALSE(
+      MenuChordFor(IDC_STEDDING_SPACE_PREVIOUS, CtrlAlt(ui::VKEY_LEFT))
+          .has_value());
+  EXPECT_FALSE(
+      MenuChordFor(IDC_STEDDING_SPACE_NEXT, CtrlAlt(ui::VKEY_N)).has_value())
+      << "Clear took Next Space's chord";
+  EXPECT_EQ(CtrlAlt(ui::VKEY_W),
+            MenuChordFor(IDC_CLOSE_WINDOW, CtrlAlt(ui::VKEY_W)));
+  EXPECT_TRUE(IsTouched(IDC_STEDDING_SPACE_NEXT, CtrlAlt(ui::VKEY_N)));
+  EXPECT_FALSE(IsTouched(IDC_CLOSE_WINDOW, CtrlAlt(ui::VKEY_W)));
+}
+
+// Z19: one window records at a time, named by its address.
+TEST_F(ShortcutOverridesTest, RecordingNamesItsWindow) {
+  int window = 0;
+  int other = 0;
+  EXPECT_FALSE(IsRecording());
+  SetRecordingTarget(&window);
+  EXPECT_TRUE(IsRecordingIn(&window));
+  EXPECT_FALSE(IsRecordingIn(&other));
+  EXPECT_FALSE(IsRecordingIn(nullptr));
+  SetRecordingTarget(nullptr);
+  EXPECT_FALSE(IsRecording());
+}
+
+}  // namespace
+}  // namespace stedding::shortcuts
diff --git a/chrome/browser/ui/stedding/shortcut_recording.cc b/chrome/browser/ui/stedding/shortcut_recording.cc
