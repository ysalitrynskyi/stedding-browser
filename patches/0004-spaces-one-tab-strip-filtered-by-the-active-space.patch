--- /dev/null
+++ b/chrome/browser/ui/spaces/space.h
@@ -0,0 +1,56 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_SPACES_SPACE_H_
+#define CHROME_BROWSER_UI_SPACES_SPACE_H_
+
+#include <string>
+
+#include "chrome/browser/ui/spaces/space_id.h"
+#include "third_party/skia/include/core/SkColor.h"
+
+namespace spaces {
+
+// One Space: a named, iconed set of tabs the user switches between.
+//
+// A Space owns no tabs. Every tab in the window lives in the window's one
+// TabStripModel whatever Space it belongs to, and switching Space changes only
+// which of them are shown -- see ADR 0015. An earlier design had each inactive
+// Space park its own tab tree; that was dropped because Chromium's session
+// service rebuilds its log from the live tab strip every 250 writes, so parked
+// tabs would vanish at the next compaction.
+//
+// Which tabs belong to which Space is therefore SpaceModel's business, not
+// this class's. A Space is its identity: a name, a colour, and an icon.
+class Space {
+ public:
+  Space(SpaceId id, std::string name, SkColor color);
+  ~Space();
+  Space(const Space&) = delete;
+  Space& operator=(const Space&) = delete;
+
+  const SpaceId& id() const { return id_; }
+
+  const std::string& name() const { return name_; }
+  void SetName(std::string name);
+
+  SkColor color() const { return color_; }
+  void SetColor(SkColor color);
+
+  // A short string the user picks to identify the Space in the switcher --
+  // typically one emoji. Empty until they choose one, in which case the
+  // switcher shows a dot in the Space's colour instead.
+  const std::string& icon() const { return icon_; }
+  void SetIcon(std::string icon);
+
+ private:
+  const SpaceId id_;
+  std::string name_;
+  SkColor color_;
+  std::string icon_;
+};
+
+}  // namespace spaces
+
+#endif  // CHROME_BROWSER_UI_SPACES_SPACE_H_
