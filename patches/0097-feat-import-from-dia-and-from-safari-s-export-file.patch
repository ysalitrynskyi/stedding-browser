+// import I35: an archive whose parts are not what they claim names what it
+// cannot read and brings in nothing from it; a file that is no archive at
+// all, and holds nothing, says it is not an export.
+TEST_F(SafariExportImporterPrepareTest, AGarbageArchiveSaysSo) {
+  std::unique_ptr<SafariExportImporter> importer = MakeImporter();
+  const SafariExportSummary garbage =
+      Prepare(*importer, Archive("garbage_test_archive.zip"));
+  EXPECT_TRUE(garbage.opened);
+  EXPECT_EQ(0u, garbage.bookmarks);
+  EXPECT_EQ(0u, garbage.passwords);
+  EXPECT_TRUE(garbage.passwords_unreadable);
+  EXPECT_TRUE(importer->passwords().empty());
+  EXPECT_NE(std::u16string::npos,
+            SummariseSafariExport(garbage).find(
+                u"Its passwords file cannot be read."));
+
+  base::ScopedTempDir dir;
+  ASSERT_TRUE(dir.CreateUniqueTempDir());
+  const base::FilePath text = dir.GetPath().AppendASCII("notes.zip");
+  ASSERT_TRUE(base::WriteFile(text, "not an archive"));
+  const SafariExportSummary none = Prepare(*importer, text);
+  EXPECT_FALSE(none.opened);
+  EXPECT_FALSE(importer->prepared());
