diff --git a/chrome/browser/ui/views/tabs/hovercard/tab_resource_line.cc b/chrome/browser/ui/views/tabs/hovercard/tab_resource_line.cc
new file mode 100644
index 0000000000000..cba8b94597908
--- /dev/null
+++ b/chrome/browser/ui/views/tabs/hovercard/tab_resource_line.cc
@@ -0,0 +1,171 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/tabs/hovercard/tab_resource_line.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "chrome/browser/task_manager/task_manager_interface.h"
+#include "components/performance_manager/public/resource_attribution/query_results.h"
+#include "components/performance_manager/public/resource_attribution/resource_types.h"
+#include "components/sessions/core/session_id.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/text/bytes_formatting.h"
+
+namespace stedding {
+
+namespace {
+
+// The separator the card's other Stedding line uses (pins H8).
+constexpr char16_t kSeparator[] = u" \u00B7 ";
+
+}  // namespace
+
+std::u16string FormatTabResourceLine(const TabResourceFigures& figures) {
+  if (!figures.memory.has_value() || !figures.memory->is_positive()) {
+    return std::u16string();
+  }
+  std::u16string line = ui::FormatBytes(*figures.memory);
+  if (figures.cpu_percent.has_value()) {
+    line += kSeparator;
+    line += u"CPU ";
+    line += base::NumberToString16(
+        base::ClampRound<int>(std::max(0.0, *figures.cpu_percent)));
+    line += u"%";
+  }
+  if (figures.network_per_second.has_value()) {
+    line += kSeparator;
+    line += ui::FormatSpeed(*figures.network_per_second);
+  }
+  return line;
+}
+
+std::u16string TabResourceLineAsleep() {
+  return u"Asleep";
+}
+
+std::optional<double> CpuPercentBetween(base::TimeDelta cpu_before,
+                                        base::TimeTicks read_before,
+                                        base::TimeDelta cpu_after,
+                                        base::TimeTicks read_after) {
+  const base::TimeDelta wall = read_after - read_before;
+  if (!wall.is_positive()) {
+    return std::nullopt;
+  }
+  const base::TimeDelta used = cpu_after - cpu_before;
+  if (!used.is_positive()) {
+    return 0.0;
+  }
+  return 100.0 * (used / wall);
+}
+
+TabResourceSampler::TabResourceSampler(content::WebContents* contents,
+                                       base::TimeDelta interval,
+                                       FiguresCallback on_update)
+    : task_manager::TaskManagerObserver(
+          interval,
+          task_manager::REFRESH_TYPE_NETWORK_USAGE),
+      contents_(contents->GetWeakPtr()),
+      page_(resource_attribution::PageContext::FromWebContents(contents)),
+      on_update_(std::move(on_update)) {
+  if (page_.has_value()) {
+    query_.emplace(
+        resource_attribution::QueryBuilder()
+            .AddResourceContext(*page_)
+            .AddResourceType(resource_attribution::ResourceType::kCPUTime)
+            .AddResourceType(resource_attribution::ResourceType::kMemorySummary)
+            .CreateScopedQuery());
+    query_observation_.Observe(&*query_);
+    // A reading now, then one every interval. Asked before the repeating
+    // query starts: a one-off memory query due within two seconds of the
+    // query's own timer is dropped.
+    query_->QueryOnce();
+    query_->Start(interval);
+  }
+  // Starts the task manager if nothing else runs it, in which case its first
+  // refresh runs in this call. OnTasksRefreshed() passes over the first
+  // refresh it hears of, whenever it comes.
+  task_manager::TaskManagerInterface::GetTaskManager()->AddObserver(this);
+}
+
+TabResourceSampler::~TabResourceSampler() {
+  // Stops the task manager if nothing else needs it, and with it the network
+  // service's reports of every request's bytes.
+  if (observed_task_manager()) {
+    observed_task_manager()->RemoveObserver(this);
+  }
+}
+
+void TabResourceSampler::OnResourceUsageUpdated(
+    const resource_attribution::QueryResultMap& results) {
+  if (!page_.has_value()) {
+    return;
+  }
+  const auto it = results.find(resource_attribution::ResourceContext(*page_));
+  if (it == results.end()) {
+    return;
+  }
+  const resource_attribution::QueryResults& result = it->second;
+  bool changed = false;
+  if (result.memory_summary_result.has_value() &&
+      result.memory_summary_result->private_footprint.is_positive()) {
+    figures_.memory = result.memory_summary_result->private_footprint;
+    changed = true;
+  }
+  if (result.cpu_time_result.has_value()) {
+    const base::TimeDelta cpu = result.cpu_time_result->cumulative_cpu;
+    const base::TimeTicks read =
+        result.cpu_time_result->metadata.measurement_time;
+    if (last_cpu_.has_value()) {
+      const std::optional<double> percent =
+          CpuPercentBetween(*last_cpu_, last_cpu_read_, cpu, read);
+      if (percent.has_value()) {
+        figures_.cpu_percent = percent;
+        changed = true;
+      }
+    }
+    last_cpu_ = cpu;
+    last_cpu_read_ = read;
+  }
+  if (changed) {
+    on_update_.Run(figures_);
+  }
+}
+
+void TabResourceSampler::OnTasksRefreshed(
+    const task_manager::TaskIdList& task_ids) {
+  if (!network_interval_started_) {
+    network_interval_started_ = true;
+    return;
+  }
+  task_manager::TaskManagerInterface* const task_manager =
+      observed_task_manager();
+  content::WebContents* const contents = contents_.get();
+  if (!task_manager || !contents) {
+    return;
+  }
+  // The page's main frame is one task; each of its frames in another
+  // process is another, under the same tab id.
+  const task_manager::TaskId main_task =
+      task_manager->GetTaskIdForWebContents(contents);
+  if (main_task < 0 || !task_manager->IsTaskValid(main_task)) {
+    return;
+  }
+  const SessionID tab_id = task_manager->GetTabId(main_task);
+  base::ByteSize rate = task_manager->GetNetworkUsage(main_task);
+  if (tab_id.is_valid()) {
+    for (const task_manager::TaskId task : task_ids) {
+      if (task != main_task && task_manager->GetTabId(task) == tab_id) {
+        rate += task_manager->GetNetworkUsage(task);
+      }
+    }
+  }
+  figures_.network_per_second = rate;
+  on_update_.Run(figures_);
+}
+
+}  // namespace stedding
