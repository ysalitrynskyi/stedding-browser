+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_WEBUI_STEDDING_WELCOME_WELCOME_HOST_H_
+#define CHROME_BROWSER_UI_WEBUI_STEDDING_WELCOME_WELCOME_HOST_H_
+
+#include "base/memory/weak_ptr.h"
+#include "content/public/browser/web_contents_user_data.h"
+
+class BrowserWindowInterface;
+
+namespace stedding {
+
+// The window the welcome flow floats over, attached to the flow's
+// WebContents by the dialog that hosts it. The page is not a tab, so the
+// usual "which browser holds this tab" lookup finds nothing; this is how the
+// handler reaches the window's Spaces (welcome W7) and opens settings.
+class WelcomeHost : public content::WebContentsUserData<WelcomeHost> {
+ public:
+  ~WelcomeHost() override;
+
+  // The window, or null once it has closed.
+  BrowserWindowInterface* browser() const { return browser_.get(); }
+
+ private:
+  friend class content::WebContentsUserData<WelcomeHost>;
+  WelcomeHost(content::WebContents* contents, BrowserWindowInterface* browser);
+
+  base::WeakPtr<BrowserWindowInterface> browser_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_WEBUI_STEDDING_WELCOME_WELCOME_HOST_H_
