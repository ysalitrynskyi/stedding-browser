+// the sidebar. The rail floats no name; the tooltip names the Space there.
+// The chip's accessible name is the Space's in both.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, AChipShowsItsNameOnce) {
+  MakeThreeSpaces();
+  views::Widget* const window = browser_view()->GetWidget();
+  views::test::RunScheduledLayout(window);
+  VerticalTabStripRegionView* const region =
+      browser_view()->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(region);
+  views::Label* const pill = region->space_hover_pill_for_testing();
+  ASSERT_TRUE(pill);
+  const std::u16string name = model()->DisplayName(ids_[1]);
+  ASSERT_EQ(u"Two", name);
+
+  // The pointer rests on a chip, as after a drop on it.
+  const auto rest_on = [&](views::View* view) {
+    views::View* const root = window->GetRootView();
+    gfx::Point point = view->GetBoundsInScreen().CenterPoint();
+    views::View::ConvertPointFromScreen(root, &point);
+    ui::MouseEvent move(ui::EventType::kMouseMoved, point, point,
+                        ui::EventTimeForNow(), ui::EF_NONE, ui::EF_NONE);
+    root->OnMouseMoved(move);
+  };
+  views::View* chip = Switcher()->ChipForTesting(ids_[1]);
+  ASSERT_TRUE(chip);
+  rest_on(chip);
+  EXPECT_TRUE(pill->GetVisible()) << "no floating name";
+  EXPECT_EQ(name, pill->GetText());
+  EXPECT_EQ(std::u16string(), chip->GetTooltipText())
+      << "the chip names its Space twice";
+  EXPECT_EQ(name, chip->GetViewAccessibility().GetCachedName());
+  views::View* const other = Switcher()->ChipForTesting(ids_[2]);
+  ASSERT_TRUE(other);
+  EXPECT_EQ(std::u16string(), other->GetTooltipText());
+
+  // The rail. Expand-on-hover would leave it; it stays collapsed.
+  vertical_tab_strip_state_controller()->SetExpandOnHoverEnabled(false);
+  Collapse();
+  views::test::RunScheduledLayout(window);
+  chip = Switcher()->ChipForTesting(ids_[1]);
+  ASSERT_TRUE(chip);
+  rest_on(chip);
+  EXPECT_FALSE(pill->GetVisible()) << "a floating name in the rail";
+  EXPECT_EQ(name, chip->GetTooltipText()) << "the rail's chip has no name";
+  EXPECT_EQ(name, chip->GetViewAccessibility().GetCachedName());
+}
