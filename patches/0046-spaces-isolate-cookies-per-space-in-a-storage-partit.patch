+// sessions S2: turning isolation on writes a token that survives the round
+// trip; a second EnsureIsolated leaves it.
+TEST(SpaceRegistryTest, IsolatedProfileIdRoundTrips) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  SpaceId work_id = SpaceId::CreateEmpty();
+  std::string first_id;
+  {
+    SpaceRegistry registry(&prefs);
+    work_id = registry.Add("Work", SK_ColorBLUE);
+    EXPECT_TRUE(registry.Find(work_id)->profile_id.empty());
+    registry.EnsureIsolated(work_id);
+    first_id = registry.Find(work_id)->profile_id;
+    EXPECT_FALSE(first_id.empty());
+    registry.EnsureIsolated(work_id);
+    EXPECT_EQ(first_id, registry.Find(work_id)->profile_id);
+  }
+  SpaceRegistry again(&prefs);
+  ASSERT_EQ(1u, again.entries().size());
+  EXPECT_EQ(first_id, again.Find(work_id)->profile_id);
+  again.SetProfileId(work_id, std::string());
+  EXPECT_TRUE(again.Find(work_id)->profile_id.empty());
+}
+
+// sessions S3
+TEST(SpaceRegistryTest, TwoIsolatedSpacesGetDifferentIds) {
+  TestingPrefServiceSimple prefs;
+  prefs.registry()->RegisterListPref(stedding::prefs::kSpaceRegistry);
+  SpaceRegistry registry(&prefs);
+  const SpaceId a = registry.Add("A", SK_ColorBLUE);
+  const SpaceId b = registry.Add("B", SK_ColorGREEN);
+  registry.EnsureIsolated(a);
+  registry.EnsureIsolated(b);
+  EXPECT_NE(registry.Find(a)->profile_id, registry.Find(b)->profile_id);
+  EXPECT_FALSE(registry.Find(a)->profile_id.empty());
+  EXPECT_FALSE(registry.Find(b)->profile_id.empty());
+}
