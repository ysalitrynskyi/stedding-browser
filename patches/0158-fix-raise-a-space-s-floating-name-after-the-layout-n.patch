 class SpaceSwitchTest
     : public VerticalTabsBrowserTestMixin<InProcessBrowserTest> {
  protected:
@@ -2286,6 +2308,45 @@ IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, AChipShowsItsNameOnce) {
   EXPECT_EQ(name, chip->GetViewAccessibility().GetCachedName());
 }
 
+// BACKLOG S-440: removing a closed row synthesizes a mouse move inside the
+// window's layout (TabCollectionAnimatingLayoutManager), and a chip that takes
+// its first hover there floated its name by reordering the sidebar's children
+// while the sidebar's layout walked them, a CHECK in every build.
+IN_PROC_BROWSER_TEST_F(SpaceSwitchTest, AChipHoveredDuringALayoutFloatsItsName) {
+  MakeThreeSpaces();
+  views::Widget* const window = browser_view()->GetWidget();
+  VerticalTabStripRegionView* const region =
+      browser_view()->vertical_tab_strip_region_view_for_testing();
+  ASSERT_TRUE(region);
+  views::Label* const pill = region->space_hover_pill_for_testing();
+  ASSERT_TRUE(pill);
+  views::View* const chip = Switcher()->ChipForTesting(ids_[1]);
+  ASSERT_TRUE(chip);
+  // Last among the children, so that the name has somewhere to go.
+  auto* const during = region->AddChildView(std::make_unique<CallsDuringLayout>());
+  views::test::RunScheduledLayout(window);
+  ASSERT_NE(pill, region->children().back().get());
+
+  during->on_layout = base::BindLambdaForTesting([&]() {
+    views::View* const root = window->GetRootView();
+    gfx::Point point = chip->GetBoundsInScreen().CenterPoint();
+    views::View::ConvertPointFromScreen(root, &point);
+    ui::MouseEvent move(ui::EventType::kMouseMoved, point, point,
+                        ui::EventTimeForNow(), ui::EF_NONE, ui::EF_NONE);
+    root->OnMouseMoved(move);
+  });
+  during->InvalidateLayout();
+  views::test::RunScheduledLayout(window);
+  EXPECT_FALSE(during->on_layout) << "no layout ran the hover";
+  EXPECT_TRUE(pill->GetVisible()) << "no floating name";
+  EXPECT_EQ(u"Two", pill->GetText());
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return region->children().back().get() == pill; }))
+      << "the name stayed under what came after it";
+
+  region->RemoveChildViewT(during);
+}
+
