+
+bool SpaceTabVisibilityController::SelectionHoldsAHiddenRow() const {
+  const TabStripModel& strip = *tab_strip_model_;
+  const int active = strip.active_index();
+  for (int i = 0; i < strip.count(); ++i) {
+    if (i != active && strip.IsTabSelected(i) && strip.IsTabHidden(i)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void SpaceTabVisibilityController::PostDropHiddenRowsFromSelection() {
+  // tabs R20 (PLAN.md TST-8): a row the sidebar stops drawing leaves the
+  // selection, so a verb on the selection -- Cmd-W, the Space keys, Copy
+  // Link, Pin -- never reaches a tab the user cannot see. A folder collapsed
+  // over a selected row, or a pinned run folded away, had left that tab
+  // selected; Shift-click ranges already skip hidden rows (TAB-10). A turn
+  // later, as this pass may run inside the strip's own notification.
+  if (drop_posted_ || tab_strip_model_->closing_all() ||
+      !SelectionHoldsAHiddenRow()) {
+    return;
+  }
+  drop_posted_ = true;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&SpaceTabVisibilityController::DropHiddenRowsFromSelection,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void SpaceTabVisibilityController::DropHiddenRowsFromSelection() {
+  drop_posted_ = false;
+  TabStripModel& strip = *tab_strip_model_;
+  if (strip.closing_all()) {
+    return;
+  }
+  std::vector<tabs::TabHandle> hidden;
+  const int active = strip.active_index();
+  for (int i = 0; i < strip.count(); ++i) {
+    if (i != active && strip.IsTabSelected(i) && strip.IsTabHidden(i)) {
+      hidden.push_back(strip.GetTabAtIndex(i)->GetHandle());
+    }
+  }
+  for (const tabs::TabHandle& handle : hidden) {
+    tabs::TabInterface* const tab = handle.Get();
+    const int index = tab ? strip.GetIndexOfTab(tab) : TabStripModel::kNoTab;
+    // A split's two panes leave together, so the second may be gone already.
+    if (index != TabStripModel::kNoTab && strip.IsTabSelected(index)) {
+      strip.DeselectTabAt(index);
+    }
+  }
 }
 
