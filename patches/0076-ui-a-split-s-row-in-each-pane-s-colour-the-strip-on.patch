-PageBarColorSupplier::PageBarColorSupplier(SkColor page) : page_(page) {}
+SkColor SplitRowForeground(SkColor first, SkColor second) {
+  const SkColor single = color_utils::GetColorWithMaxContrast(first);
+  if (single == color_utils::GetColorWithMaxContrast(second)) {
+    // Both colours on the same side of the contrast line: the near-black or
+    // the white reads better on both than any grey between them.
+    return single;
+  }
+  // The grey whose contrast with the two colours is the same: its luminance
+  // plus 0.05 is the geometric mean of theirs, encoded back to sRGB.
+  const float luminance =
+      std::sqrt((color_utils::GetRelativeLuminance(first) + 0.05f) *
+                (color_utils::GetRelativeLuminance(second) + 0.05f)) -
+      0.05f;
+  const float linear = std::clamp(luminance, 0.f, 1.f);
+  const float encoded = linear <= 0.0031308f
+                            ? 12.92f * linear
+                            : 1.055f * std::pow(linear, 1.f / 2.4f) - 0.055f;
+  const U8CPU level = static_cast<U8CPU>(std::lround(encoded * 255.f));
+  const std::array<SkColor, 3> candidates = {
+      color_utils::GetColorWithMaxContrast(SK_ColorWHITE), SK_ColorWHITE,
+      SkColorSetRGB(level, level, level)};
+  const auto worse = [&](SkColor foreground) {
+    return std::min(color_utils::GetContrastRatio(foreground, first),
+                    color_utils::GetContrastRatio(foreground, second));
+  };
+  return *std::ranges::max_element(candidates, {}, worse);
+}
