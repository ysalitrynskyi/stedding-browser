+  flags.setStrokeWidth(stedding::kLocalTapeStroke);
+  // A solid near-black line with yellow dashes over it: the two colours meet
+  // with no gap between them and no seam where the outline starts.
+  flags.setColor(stedding::kLocalTapeDark);
+  canvas->DrawRoundRect(bounds, radius, flags);
+  const float dash =
+      stedding::LocalTapeDashInterval(bounds.width(), bounds.height(), radius);
+  const float intervals[] = {dash, dash};
+  flags.setColor(stedding::kLocalTapeYellow);
+  flags.setPathEffect(cc::PathEffect::MakeDash(intervals, 2, 0));
