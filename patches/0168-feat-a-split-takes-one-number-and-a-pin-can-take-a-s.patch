 // to a focused group's tabs and the pinned ones while a group is focused.
+namespace {
+
+// splits J2: a key that names a split goes to the pane used last, as Ctrl-Tab
+// does.
+tabs::TabInterface* PaneForNumberKey(BrowserWindowInterface* browser,
+                                     tabs::TabInterface* tab) {
+  spaces::SpaceModel* const spaces = spaces::SpaceModel::From(browser);
+  if (spaces && tab->IsSplit()) {
+    for (tabs::TabInterface* const recent :
+         spaces->RecentTabs(spaces->active_id(),
+                            std::numeric_limits<size_t>::max())) {
+      if (recent->GetSplit() == tab->GetSplit()) {
+        return recent;
+      }
+    }
+  }
+  return tab;
+}
