+int SessionSlot(const SpaceRegistry& registry, std::string_view session) {
+  // The named rows first, in the list's own order, which only grows at its
+  // end; then the sessions with no row, a Space's own (S2), by their first
+  // Space. A session's place, and so its slot, does not move when one is
+  // added after it.
+  std::vector<std::string> order = registry.SessionRowIds();
+  for (const SessionEntry& entry : registry.Sessions()) {
+    if (!entry.has_row) {
+      order.push_back(entry.id);
+    }
+  }
+  std::bitset<kSessionSlots> taken;
+  for (const std::string& id : order) {
+    if (taken.all()) {
+      taken.reset();
+    }
+    size_t slot = base::PersistentHash(id) % kSessionSlots;
+    while (taken.test(slot)) {
+      slot = (slot + 1) % kSessionSlots;
+    }
+    if (id == session) {
+      return static_cast<int>(slot);
+    }
+    taken.set(slot);
+  }
+  // A session the registry does not know yet: the slot its id hashes to.
+  return static_cast<int>(base::PersistentHash(session) % kSessionSlots);
+}
+
+std::optional<int> SessionSlotForSpace(const SpaceRegistry* registry,
+                                       const SpaceId& id) {
+  const RegistryEntry* const entry = registry ? registry->Find(id) : nullptr;
+  if (!entry || !entry->isolated || entry->profile_id.empty()) {
+    return std::nullopt;
+  }
+  return SessionSlot(*registry, entry->profile_id);
+}
