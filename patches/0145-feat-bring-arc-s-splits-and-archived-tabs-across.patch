+// import I7: a row an Arc import brought keeps Arc's date, and the archive keeps
+// it from the import, or an older archive would come in out of sight.
+TEST(ArchivePageTest, AnImportedRowAgesFromItsImport) {
+  const base::Time now = base::Time::Now();
+  const auto imported = [&](int id, base::Time when, base::Time at) {
+    std::unique_ptr<sessions::tab_restore::Tab> tab =
+        ClosedTab(id, "https://arc.example/", u"Arc", when, "import");
+    tab->extra_data[kArchiveImportedAtKey] = base::NumberToString(
+        at.ToDeltaSinceWindowsEpoch().InMicroseconds());
+    return tab;
+  };
+  sessions::TabRestoreService::Entries entries;
+  entries.push_back(imported(1, now - base::Days(200), now - base::Days(1)));
+  entries.push_back(imported(2, now - base::Days(200), now - base::Days(40)));
+  const std::vector<ArchivedTab> shown =
+      ListArchivedTabs(entries, now, base::Days(30));
+  ASSERT_EQ(1u, shown.size());
+  EXPECT_EQ(now - base::Days(200), shown[0].time) << "Arc's date";
+  EXPECT_EQ("import", shown[0].reason);
+}
