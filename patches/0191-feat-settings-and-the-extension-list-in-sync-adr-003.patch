+#ifndef CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_PARTS_H_
+#define CHROME_BROWSER_UI_SPACES_SIDEBAR_SYNC_PARTS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/values.h"
