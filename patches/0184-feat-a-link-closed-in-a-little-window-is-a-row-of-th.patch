--- a/chrome/browser/resources/stedding_archive/app.ts
+++ b/chrome/browser/resources/stedding_archive/app.ts
@@ -115,11 +115,20 @@ function hostOf(url: string): string {
   }
 }
 
+// A17: the filter's choice for links closed in little windows, which belong
+// to no Space. Not a Space id, which is a GUID.
+const LITTLE_WINDOWS = 'little-windows';
+
 // The filter goes by the Space's id: names repeat and change, so two Spaces
 // of one name were one choice, and a renamed Space lost its rows (BACKLOG
 // S-187). A row from before ids were recorded goes by the name it showed.
 function matches(tab: ArchivedTab): boolean {
-  if (state.space) {
+  // A17: Arc's "Little Arc" filter.
+  if (state.space === LITTLE_WINDOWS) {
+    if (tab.closedWith !== 'little') {
+      return false;
+    }
+  } else if (state.space) {
     if (tab.spaceId ? tab.spaceId !== state.space :
                       tab.spaceName !== nameOfSpace(state.space)) {
       return false;
@@ -153,16 +162,29 @@ function nameOfSpace(id: string): string {
 function closedWithText(tab: ArchivedTab): string {
   switch (tab.closedWith) {
     case 'window':
-      return ` · in a closed window of ${tab.closedCount} tabs`;
+      return tab.closedCount > 1 ?
+          ` · in a closed window of ${tab.closedCount} tabs` :
+          ' · in a closed window';
+    case 'little':
+      return ' · from a little window';
     case 'split':
       return ' · in a closed split';
     case 'group':
-      return ` · in a closed group of ${tab.closedCount} tabs`;
+      return tab.closedCount > 1 ?
+          ` · in a closed group of ${tab.closedCount} tabs` :
+          ' · in a closed group';
     default:
       return '';
   }
 }
 
+// Forget drops the whole close (BACKLOG S-187), so its button names it; a
+// little window held its one link.
+function closeNoun(tab: ArchivedTab): string {
+  return ['window', 'split', 'group'].includes(tab.closedWith) ?
+      tab.closedWith : '';
+}
+
 // The page's own parts, made once: an update redraws the Space menu's
 // choices and the list, and leaves the search field, the focus and the
 // scroll where the reader has them. Every update rebuilt the page and put
@@ -209,6 +231,13 @@ function renderSpaceMenu(select: HTMLSelectElement) {
   const all = el('option', undefined, 'All Spaces');
   all.value = '';
   const options = [all];
+  if (state.space === LITTLE_WINDOWS ||
+      state.tabs.some(tab => tab.closedWith === 'little')) {
+    const little = el('option', undefined, 'Little windows');
+    little.value = LITTLE_WINDOWS;
+    little.selected = state.space === LITTLE_WINDOWS;
+    options.push(little);
+  }
   for (const space of spaceChoices()) {
     const option = el('option', undefined, space.markedName || space.name);
     option.value = space.id;
@@ -263,10 +292,10 @@ function renderList(list: HTMLElement) {
     restore.addEventListener('click', () => chrome.send('restoreArchivedTab', [tab.id]));
     row.append(restore);
     // Chromium's list forgets a close made whole as one: the button says so.
-    const remove = el('button', undefined,
-        tab.closedWith ? `Forget ${tab.closedWith}` : 'Forget');
-    remove.setAttribute('aria-label', tab.closedWith ?
-        `Forget the closed ${tab.closedWith} this tab was in` : 'Forget this tab');
+    const noun = closeNoun(tab);
+    const remove = el('button', undefined, noun ? `Forget ${noun}` : 'Forget');
+    remove.setAttribute('aria-label', noun ?
+        `Forget the closed ${noun} this tab was in` : 'Forget this tab');
     remove.addEventListener('click', () => chrome.send('removeArchivedTab', [tab.id]));
     row.append(remove);
     list.append(row);
