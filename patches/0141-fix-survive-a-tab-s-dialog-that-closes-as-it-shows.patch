 // How many browser windows are open: a peek over the page makes none.
@@ -77,6 +86,37 @@ int WindowCount() {
   return windows;
 }
 
+#if defined(USE_AURA)
+// Closes `widget` as its window shows: what runs as a dialog's window comes
+// forward may do that (docs/features/tabs.md R67). Its window's observers may,
+// as NativeWidgetAura::Show says. An observer of the widget may not: ~Widget
+// checks that no such notification is on the stack.
+class CloseAsItShows : public aura::WindowObserver {
+ public:
+  explicit CloseAsItShows(views::Widget* widget) : widget_(widget) {
+    observation_.Observe(widget->GetNativeWindow());
+  }
+  bool closed() const { return closed_; }
+
+ private:
+  // aura::WindowObserver:
+  void OnWindowVisibilityChanged(aura::Window* window, bool visible) override {
+    if (!visible || !observation_.IsObservingSource(window)) {
+      return;
+    }
+    observation_.Reset();
+    closed_ = true;
+    widget_.ExtractAsDangling()->Close();
+  }
+  void OnWindowDestroying(aura::Window*) override { observation_.Reset(); }
+
+  raw_ptr<views::Widget> widget_;
+  bool closed_ = false;
+  base::ScopedObservation<aura::Window, aura::WindowObserver> observation_{
+      this};
+};
+#endif  // defined(USE_AURA)
