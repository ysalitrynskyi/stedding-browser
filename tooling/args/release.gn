# Stedding — developer release build (macOS arm64).
#
# What this is for: day-to-day work. Optimised, no debug symbols, single binary.
# Builds in a fraction of the time of an official build and produces a Chromium.app
# that behaves like a shipping browser for functional testing.
#
# What it is NOT: a shipping configuration. Releases use official.gn (PGO + LTO).
# Performance numbers must never be quoted from this config.

target_os  = "mac"
target_cpu = "arm64"

is_debug           = false
is_component_build = false

# Symbols dominate both link time and disk usage and we do not ship this build.
symbol_level       = 0
blink_symbol_level = 0
v8_symbol_level    = 0

# Google's remote execution backends are not available to us (see docs/ARCHITECTURE.md,
# "Build system"). Everything is built locally.
use_remoteexec = false

# Match release semantics: DCHECKs off.
dcheck_always_on = false
