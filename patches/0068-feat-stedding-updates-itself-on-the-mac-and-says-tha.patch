+    SetVersion(std::move(version));
+    SetState(state);
+  }
+  void SetDownloadProgress(int progress) { SetProgress(progress); }
+  void Fail(std::u16string error) {
+    SetError(std::move(error));
+    SetState(State::kFailed);
+  }
+
+  // AppUpdater:
+  void CheckNow() override;
+  void InstallNow() override;
+
+  int checks = 0;
+  int installs = 0;
+};
