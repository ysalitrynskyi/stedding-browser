+IN_PROC_BROWSER_TEST_F(SidebarPanelsTest, HistoryRowOpensAndItsMenuRemoves) {
+  ui_test_utils::WaitForHistoryToLoad(history());
+  const GURL a = embedded_test_server()->GetURL("a.test", "/title1.html");
+  const GURL b = embedded_test_server()->GetURL("b.test", "/title2.html");
+  AddVisit(a, u"Page A", base::Time::Now() - base::Seconds(10));
+  AddVisit(b, u"Page B", base::Time::Now() - base::Seconds(20));
+  history::BlockUntilHistoryProcessesPendingRequests(history());
+
+  ASSERT_TRUE(chrome::ExecuteCommand(browser(), IDC_SHOW_HISTORY));
+  ASSERT_TRUE(WaitForPanel(SidebarPanel::kHistory));
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return content::EvalJs(panel_page(), "!!" + RowFor("url", a.spec()))
+        .ExtractBool();
+  }));
+  const int tab_count = tabs()->count();
+
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(), RowFor("url", a.spec()) + ".querySelector('.row-main')"
+                                              ".click()"));
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return tabs()->GetActiveWebContents()->GetLastCommittedURL() == a;
+  })) << "the row did not open in the active tab";
+  EXPECT_EQ(tab_count, tabs()->count());
+
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(),
+      RowFor("url", b.spec()) +
+          ".querySelector('.row-main').dispatchEvent(new MouseEvent("
+          "    'click', {bubbles: true, ctrlKey: true, metaKey: true}))"));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return tabs()->count() == tab_count + 1; }))
+      << "⌘-click opened no background tab";
+  EXPECT_EQ(a, tabs()->GetActiveWebContents()->GetLastCommittedURL())
+      << "the background tab took the focus";
+
+  // A pinned tab keeps its page.
+  tabs()->SetTabPinned(tabs()->active_index(), true);
+  const int before_pinned_open = tabs()->count();
+  ASSERT_TRUE(content::ExecJs(
+      panel_page(), RowFor("url", b.spec()) + ".querySelector('.row-main')"
+                                              ".click()"));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return tabs()->count() == before_pinned_open + 1; }))
+      << "the row took the pinned tab";
+  EXPECT_EQ(a, tabs()->GetWebContentsAt(0)->GetLastCommittedURL());
+
+  RunMenu("url", b.spec(), "remove");
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return !content::EvalJs(panel_page(), "!!" + RowFor("url", b.spec()))
+                .ExtractBool();
+  })) << "Remove left the row";
+}
