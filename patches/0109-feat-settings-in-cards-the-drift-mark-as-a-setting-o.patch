+// pins H28 (GitHub issue 36): "Mark pinned tabs that left their page" is off
+// on a fresh profile: a drifted essential's card shows no dot and, under the
+// pointer, no reset control, while a drifted Space pin's row keeps its slash.
+// Turned on, the dot and the control come at once, and go again when it is
+// turned off. The dot read as a notification, and the control drew clicks
+// meant for the card.
+IN_PROC_BROWSER_TEST_F(SidebarRailTest, TheDriftMarkIsTheSettingsChoice) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  ASSERT_FALSE(prefs->GetBoolean(stedding::prefs::kMarkDriftedPins));
+  const GURL home = embedded_test_server()->GetURL("/title1.html");
+  const GURL away = embedded_test_server()->GetURL("/title2.html");
+  spaces::SpaceModel* const model = spaces::SpaceModel::From(browser());
+  ASSERT_TRUE(model);
+  TabStripModel* const strip = tab_strip_model();
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), home));
+  tabs::TabInterface* const space_pin = strip->GetActiveTab();
+  model->SetSpacePinned(space_pin, true);
+  ASSERT_TRUE(ui_test_utils::NavigateToURLWithDisposition(
+      browser(), home, WindowOpenDisposition::NEW_FOREGROUND_TAB,
+      ui_test_utils::BROWSER_TEST_WAIT_FOR_LOAD_STOP));
+  tabs::TabInterface* const essential = strip->GetActiveTab();
+  strip->SetTabPinned(strip->GetIndexOfTab(essential), true);
+  for (tabs::TabInterface* const tab : {space_pin, essential}) {
+    strip->ActivateTabAt(strip->GetIndexOfTab(tab));
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), away));
+  }
+  AppendTab();
+
+  // The card's reset control, shown while the pointer rests on the card.
+  const auto reset_shown = [&]() {
+    views::test::RunScheduledLayout(browser_view()->GetWidget());
+    TabView* const card = stedding::test::FindDrawnRow(
+        browser_view()->GetWidget()->GetRootView(), essential);
+    EXPECT_TRUE(card) << "no card for the essential";
+    if (!card) {
+      return false;
+    }
+    const gfx::Point centre = card->GetLocalBounds().CenterPoint();
+    // As the window delivers it, through views::View.
+    views::View* const view = card;
+    view->OnMouseEntered(ui::MouseEvent(ui::EventType::kMouseEntered, centre,
+                                        centre, base::TimeTicks::Now(),
+                                        ui::EF_NONE, ui::EF_NONE));
+    bool shown = false;
+    for (const views::View* const child : card->children()) {
+      if (const auto* const label = views::AsViewClass<views::Label>(
+              const_cast<views::View*>(child));
+          label && label->GetText() == u"\u21BA") {
+        shown = label->GetVisible();
+      }
+    }
+    view->OnMouseExited(ui::MouseEvent(ui::EventType::kMouseExited, centre,
+                                       centre, base::TimeTicks::Now(),
+                                       ui::EF_NONE, ui::EF_NONE));
+    return shown;
+  };
+
+  {
+    SCOPED_TRACE("off, as on a fresh profile");
+    EXPECT_FALSE(MarksOf(essential).dot);
+    EXPECT_FALSE(reset_shown());
+    EXPECT_TRUE(MarksOf(space_pin).slash) << "the row's slash went too";
+  }
+  {
+    SCOPED_TRACE("turned on");
+    prefs->SetBoolean(stedding::prefs::kMarkDriftedPins, true);
+    EXPECT_TRUE(MarksOf(essential).dot);
+    EXPECT_TRUE(reset_shown());
+    EXPECT_TRUE(MarksOf(space_pin).slash);
+  }
+  {
+    SCOPED_TRACE("turned off again");
+    prefs->SetBoolean(stedding::prefs::kMarkDriftedPins, false);
+    EXPECT_FALSE(MarksOf(essential).dot);
+    EXPECT_FALSE(reset_shown());
+  }
+}
