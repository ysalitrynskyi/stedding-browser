+SidebarSyncService::~SidebarSyncService() = default;
+
+void SidebarSyncService::Shutdown() {
+  if (ready_ && ledger_) {
+    Commit();
+    SaveLedger();
+  }
+  StopObserving();
+  prefs_.RemoveAll();
+}
