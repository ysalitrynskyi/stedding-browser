+namespace {
+// The retain set for every folder move: whole folders and splits travel as
+// units, exactly as splits do in MoveTabsRecursive.
+const TabCollection::TypeEnumSet& FolderMoveRetainSet() {
+  static const TabCollection::TypeEnumSet kRetain = {
+      TabCollection::Type::SPLIT, TabCollection::Type::FOLDER};
+  return kRetain;
+}
