+// folders F3 (GitHub issue 78): a collapse keeps listed the pins selected in
+// the folder, to put the rest away and keep working in those. They stay while
+// awake, after another tab is on screen, until the folder opens.
+TEST_F(SpaceWindowTest, ACollapseKeepsTheSelectedPinsListed) {
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  std::vector<tabs::TabInterface*> pins;
+  for (int i = 0; i < 3; ++i) {
+    pins.push_back(OpenTab());
+    model().SetSpacePinned(pins.back(), true);
+  }
+  auto index = [&](tabs::TabInterface* tab) {
+    return tabs().GetIndexOfTab(tab);
+  };
+  std::vector<int> indices = {index(pins[0]), index(pins[1]), index(pins[2])};
+  std::ranges::sort(indices);
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(indices);
+  ASSERT_NE(nullptr, folder);
+  tabs::TabInterface* const loose = OpenTab();
+  // pins[0] on screen and pins[1] selected with it, as a Ctrl-click (a
+  // Cmd-click) on its row leaves them.
+  ui::ListSelectionModel selection;
+  selection.AddIndexToSelection(index(pins[0]));
+  selection.AddIndexToSelection(index(pins[1]));
+  selection.set_active(index(pins[0]));
+  selection.set_anchor(index(pins[0]));
+  tabs().SetSelectionFromModel(selection);
+  ASSERT_TRUE(tabs().IsTabSelected(index(pins[0])));
+  ASSERT_TRUE(tabs().IsTabSelected(index(pins[1])));
+  ASSERT_FALSE(tabs().IsTabSelected(index(pins[2])));
+
+  folder->SetCollapsed(true);
+  for (int i : {0, 1}) {
+    EXPECT_FALSE(tabs().IsTabHidden(index(pins[i])))
+        << "the collapse folded selected pin " << i;
+  }
+  EXPECT_TRUE(tabs().IsTabHidden(index(pins[2])))
+      << "the collapse left a pin that was not selected listed";
+
+  tabs().ActivateTabAt(index(loose));
+  ASSERT_FALSE(tabs().IsTabSelected(index(pins[1])));
+  for (int i : {0, 1}) {
+    EXPECT_FALSE(tabs().IsTabHidden(index(pins[i])))
+        << "selected pin " << i << " folded once another tab was on screen";
+  }
+
+  // Selected no more, they fold at the next collapse.
+  folder->SetCollapsed(false);
+  folder->SetCollapsed(true);
+  for (int i : {0, 1, 2}) {
+    EXPECT_TRUE(tabs().IsTabHidden(index(pins[i])))
+        << "the next collapse left pin " << i << " listed";
+  }
+}
+
+// folders F3 (GitHub issue 78): with "Keep open tabs out of a collapsed
+// folder" on, a collapse keeps every pin that is awake listed; asleep, it
+// folds, and a tab that is not a pin folds as before.
+TEST_F(SpaceWindowTest, TheSettingKeepsOpenPinsOutOfACollapsedFolder) {
+  profile()->GetPrefs()->SetBoolean(stedding::prefs::kCollapseKeepsOpenPins,
+                                    true);
+  Space* const work = model().AddSpace("Work", kBlue);
+  model().SetActiveSpace(work->id());
+  tabs::TabInterface* const awake = OpenTab();
+  model().SetSpacePinned(awake, true);
+  tabs::TabInterface* const asleep = OpenTab();
+  model().SetSpacePinned(asleep, true);
+  tabs::TabInterface* const not_a_pin = OpenTab();
+  model().SetSpaceForTab(not_a_pin, work->id());
+  std::vector<int> indices = {tabs().GetIndexOfTab(awake),
+                              tabs().GetIndexOfTab(asleep),
+                              tabs().GetIndexOfTab(not_a_pin)};
+  std::ranges::sort(indices);
+  tabs::FolderTabCollection* const folder = tabs().AddToNewFolder(indices);
+  ASSERT_NE(nullptr, folder);
+  tabs::TabInterface* const loose = OpenTab();
+  tabs().ActivateTabAt(tabs().GetIndexOfTab(loose));
+  asleep->GetContents()->SetWasDiscarded(true);
+
+  folder->SetCollapsed(true);
+  EXPECT_FALSE(tabs().IsTabHidden(tabs().GetIndexOfTab(awake)))
+      << "the collapse folded a pin that is awake";
+  EXPECT_TRUE(tabs().IsTabHidden(tabs().GetIndexOfTab(asleep)))
+      << "the collapse listed a pin that is asleep";
+  EXPECT_TRUE(tabs().IsTabHidden(tabs().GetIndexOfTab(not_a_pin)))
+      << "the collapse listed a tab that is not a pin";
+
+  awake->GetContents()->SetWasDiscarded(true);
+  EXPECT_TRUE(tabs().IsTabHidden(tabs().GetIndexOfTab(awake)))
+      << "the pin stayed listed once asleep";
+}
