+
+  for (const bool from_the_foot : {false, true}) {
+    SCOPED_TRACE(from_the_foot ? "from the rail's foot"
+                               : "from outside the window");
+    leave_the_window();
+    region->SetHoveredForTesting(true);
+    TabView* const rail_row = RowOf(first);
+    ASSERT_TRUE(rail_row);
+    const gfx::Point pointer = rail_row->GetBoundsInScreen().CenterPoint();
+    if (from_the_foot) {
+      views::View* const switcher = stedding::test::FindDrawnSwitcher(root);
+      ASSERT_TRUE(switcher) << "no Space switcher at the rail's foot";
+      const gfx::Point foot = switcher->GetBoundsInScreen().CenterPoint();
+      gfx::Point in_root = foot;
+      views::View::ConvertPointFromScreen(root, &in_root);
+      views::View* const under_foot = root->GetEventHandlerForPoint(in_root);
+      views::View* rows = rail_row->parent();
+      while (rows && !views::IsViewClass<views::ScrollView>(rows)) {
+        rows = rows->parent();
+      }
+      ASSERT_TRUE(rows && region->Contains(under_foot) &&
+                  !rows->Contains(under_foot))
+          << "the rail's foot is not on the strip outside its rows";
+      move_to(foot);
+    }
+    move_to(pointer);
+    {
+      SCOPED_TRACE("the rail's pause");
+      EXPECT_TRUE(
+          base::test::RunUntil([&]() { return shows_the_card_of(rail_row); }))
+          << "no card on the rail row";
+      EXPECT_FALSE(region->is_expanded_on_hover())
+          << "the card came only once the sidebar had opened over the page";
+    }
+    {
+      SCOPED_TRACE("opened over the page, the pointer still");
+      ASSERT_TRUE(base::test::RunUntil([&]() {
+        return region->is_expanded_on_hover() &&
+               !BrowserAnimationController::From(browser())->IsAnimating(
+                   TabStripAnimations::kVerticalTabStrip);
+      })) << "the sidebar did not open on hover";
+      TabView* const under = row_at(pointer);
+      ASSERT_TRUE(under) << "no row under the pointer";
+      EXPECT_TRUE(
+          base::test::RunUntil([&]() { return shows_the_card_of(under); }))
+          << "no card on the row under the still pointer";
+    }
+    {
+      SCOPED_TRACE("the next row the pointer enters");
+      views::test::RunScheduledLayout(widget());
+      TabView* const next = RowOf(second);
+      ASSERT_TRUE(next);
+      move_to(next->GetBoundsInScreen().CenterPoint());
+      EXPECT_TRUE(
+          base::test::RunUntil([&]() { return shows_the_card_of(next); }))
+          << "no card on the next row";
+    }
+    region->SetHoveredForTesting(false);
+    leave_the_window();
+    Unhover();
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return !region->is_expanded_on_hover() &&
+             !BrowserAnimationController::From(browser())->IsAnimating(
+                 TabStripAnimations::kVerticalTabStrip);
+    })) << "the sidebar stayed open after the pointer left";
+  }
+  region->SetHoveredForTesting(std::nullopt);
+  region->SetPointerForTesting(std::nullopt);
+}
