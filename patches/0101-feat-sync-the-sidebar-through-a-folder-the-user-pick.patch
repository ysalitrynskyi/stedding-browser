+const std::string& EmptyString() {
+  static const base::NoDestructor<std::string> empty;
+  return *empty;
+}
+
+// A list's order with the ids `keep` holds, in their order.
+std::vector<std::string> Filtered(const std::vector<std::string>& order,
+                                  const std::set<std::string>& keep) {
+  std::vector<std::string> out;
+  for (const std::string& id : order) {
+    if (keep.contains(id)) {
+      out.push_back(id);
+    }
+  }
+  return out;
+}
+
+// Merges `from` into `into` field by field (Sf15). True when `into` changed.
+bool MergeRecord(Record& into, const Record& from) {
+  bool changed = false;
+  for (const auto& [name, field] : from.f) {
+    auto it = into.f.find(name);
+    if (it == into.f.end() || it->second.s < field.s) {
+      into.f[name] = field;
+      changed = true;
+    }
+  }
+  if (from.del && (!into.del || *into.del < *from.del)) {
+    into.del = from.del;
+    changed = true;
+  }
+  for (const auto& [key, json] : from.x) {
+    if (into.x.emplace(key, json).second) {
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+void StampAll(Record& record, const LocalItem& item, const Stamp& stamp) {
+  for (const auto& [name, value] : item.fields) {
+    record.f[name] = Field{value, stamp};
+  }
+}
+
+base::ListValue StampToList(const Stamp& stamp) {
+  base::ListValue list;
+  list.Append(static_cast<double>(stamp.t));
+  list.Append(stamp.w);
+  return list;
+}
+
+// Times are whole milliseconds a double holds exactly (Sf33).
+std::optional<int64_t> TimeFrom(const base::Value& value) {
+  const std::optional<double> number = value.GetIfDouble();
+  if (!number || !std::isfinite(*number) || std::trunc(*number) != *number ||
+      std::fabs(*number) > 9007199254740991.0) {
+    return std::nullopt;
+  }
+  return static_cast<int64_t>(*number);
+}
+
+std::optional<Stamp> StampFrom(const base::Value& value, size_t offset) {
+  const base::ListValue* const list = value.GetIfList();
+  if (!list || list->size() != offset + 2 || !(*list)[offset + 1].is_string()) {
+    return std::nullopt;
+  }
+  const std::optional<int64_t> t = TimeFrom((*list)[offset]);
+  if (!t) {
+    return std::nullopt;
+  }
+  return Stamp{*t, (*list)[offset + 1].GetString()};
+}
+
+// Sf10: a Space's name as pairing compares it, case-folded the same way in
+// every language. Lowercasing follows the computer's language (Turkish
+// lowers "I" to a dotless "ı"), so two computers could pair differently.
+std::string PairingName(std::string_view name) {
+  std::u16string text = base::UTF8ToUTF16(name);
+  base::TrimWhitespace(text, base::TRIM_ALL, &text);
+  return base::UTF16ToUTF8(base::i18n::FoldCase(text));
+}
+
+// The ids of `ids` whose key `key_of` gives occurs once.
+std::map<std::string, std::string> UniqueByKey(
+    const std::vector<std::string>& ids,
+    const std::function<std::string(const std::string&)>& key_of) {
+  std::map<std::string, std::string> unique;
+  std::set<std::string> seen_twice;
+  for (const std::string& id : ids) {
+    const std::string key = key_of(id);
+    if (key.empty() || seen_twice.contains(key)) {
+      continue;
+    }
+    if (!unique.emplace(key, id).second) {
+      unique.erase(key);
+      seen_twice.insert(key);
+    }
+  }
+  return unique;
+}
