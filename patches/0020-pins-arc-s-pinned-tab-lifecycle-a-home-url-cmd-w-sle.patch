new file mode 100644
index 0000000000000..d8f1a0b823d52
--- /dev/null
+++ b/chrome/browser/ui/stedding/pin_lifecycle_unittest.cc
@@ -0,0 +1,26 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/pin_lifecycle.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+namespace {
+
+// pins H4: a different origin or path is a drift; the query and the fragment
+// are not.
+TEST(PinLifecycleTest, DriftIsOriginOrPath) {
+  const GURL home("https://mail.test/inbox?folder=1#top");
+  EXPECT_FALSE(HasDriftedFromHome(home, GURL("https://mail.test/inbox")));
+  EXPECT_FALSE(HasDriftedFromHome(home, GURL("https://mail.test/inbox?x=2#a")));
+  EXPECT_TRUE(HasDriftedFromHome(home, GURL("https://mail.test/settings")));
+  EXPECT_TRUE(HasDriftedFromHome(home, GURL("https://other.test/inbox")));
+  EXPECT_TRUE(HasDriftedFromHome(home, GURL("http://mail.test/inbox")));
+  EXPECT_FALSE(HasDriftedFromHome(GURL(), GURL("https://mail.test/")));
+}
+
+}  // namespace
+}  // namespace stedding
