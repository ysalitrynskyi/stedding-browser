+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/blocker/blocker_lists.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/test/task_environment.h"
+#include "base/time/time.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "components/prefs/testing_pref_service.h"
+#include "components/subresource_filter/core/browser/ruleset_version.h"
+#include "content/public/test/browser_task_environment.h"
+#include "net/http/http_request_headers.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_status_code.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/url_loader_completion_status.h"
+#include "services/network/public/cpp/weak_wrapper_shared_url_loader_factory.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "services/network/test/test_url_loader_factory.h"
+#include "services/network/test/test_utils.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr char kEasyListUrl[] = "https://lists.test/easylist.txt";
+constexpr char kEasyPrivacyUrl[] = "https://lists.test/easyprivacy.txt";
+
+// A list in EasyList's format, written for these tests.
+constexpr char kList[] =
+    "[Adblock Plus 2.0]\n"
+    "! Title: A test list\n"
+    "! Expires: 2 days (update frequency)\n"
+    "||ads.example^\n"
+    "||track.example^$third-party\n";
+
+class BlockerListsTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    prefs::RegisterLocalStatePrefs(local_state_.registry());
+    ASSERT_TRUE(dir_.CreateUniqueTempDir());
+    BlockerLists::Environment environment;
+    environment.local_state = &local_state_;
+    environment.dir = dir_.GetPath();
+    environment.url_loader_factory = factory_.GetSafeWeakWrapper();
+    environment.list_base = GURL("https://lists.test/");
+    environment.minimum_rules = 1;
+    environment.launch_delay = base::Seconds(10);
+    environment.publish = base::BindRepeating(
+        [](std::vector<subresource_filter::UnindexedRulesetInfo>* published,
+           const subresource_filter::UnindexedRulesetInfo& info) {
+          published->push_back(info);
+        },
+        base::Unretained(&published_));
+    environment.indexed_version = base::BindRepeating(
+        [](const std::string* indexed) { return *indexed; },
+        base::Unretained(&indexed_));
+    lists_ = std::make_unique<BlockerLists>(std::move(environment));
+    lists_->Start();
+  }
+
+  void TurnOn() {
+    local_state_.SetBoolean(prefs::kBlockerEnabled, true);
+    task_environment_.RunUntilIdle();
+  }
+
+  // Answers the pending request for `url` with the list and an ETag.
+  void Answer(const char* url, const std::string& etag) {
+    network::mojom::URLResponseHeadPtr head =
+        network::CreateURLResponseHead(net::HTTP_OK);
+    head->headers->SetHeader("ETag", etag);
+    ASSERT_TRUE(factory_.SimulateResponseForPendingRequest(
+        GURL(url), network::URLLoaderCompletionStatus(), std::move(head),
+        kList));
+    task_environment_.RunUntilIdle();
+  }
+
+  const network::ResourceRequest* Pending(const char* url) {
+    const network::ResourceRequest* request = nullptr;
+    return factory_.IsPending(url, &request) ? request : nullptr;
+  }
+
+  content::BrowserTaskEnvironment task_environment_{
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  TestingPrefServiceSimple local_state_;
+  base::ScopedTempDir dir_;
+  network::TestURLLoaderFactory factory_;
+  std::vector<subresource_filter::UnindexedRulesetInfo> published_;
+  std::string indexed_;
+  std::unique_ptr<BlockerLists> lists_;
+};
+
+}  // namespace
+
+// Bk2, Bk12: off by default, nothing is fetched, however long the browser
+// runs. Turned on, both lists are fetched at once; turned off again, the
+// fetch under way is dropped and nothing more is asked.
+TEST_F(BlockerListsTest, NothingIsFetchedWhileTheSwitchIsOff) {
+  task_environment_.FastForwardBy(base::Days(30));
+  EXPECT_EQ(0, lists_->fetches_started_for_testing());
+  EXPECT_EQ(0u, factory_.total_requests());
+
+  TurnOn();
+  EXPECT_EQ(2, lists_->fetches_started_for_testing());
+  const network::ResourceRequest* const request = Pending(kEasyListUrl);
+  ASSERT_TRUE(request);
+  EXPECT_TRUE(Pending(kEasyPrivacyUrl));
+  // Bk12: nothing about the user: no cookies, no cache, no query.
+  EXPECT_EQ(network::mojom::CredentialsMode::kOmit,
+            request->credentials_mode);
+  EXPECT_TRUE(request->url.query().empty());
+  EXPECT_FALSE(request->headers.HasHeader(net::HttpRequestHeaders::kCookie));
+
+  local_state_.SetBoolean(prefs::kBlockerEnabled, false);
+  task_environment_.FastForwardBy(base::Days(30));
+  EXPECT_EQ(2, lists_->fetches_started_for_testing());
+  EXPECT_TRUE(published_.empty());
+}
+
+// Bk2, Bk3: a list fetched is stored and converted, and the ruleset handed
+// to the ruleset service; the list's Expires line sets its next fetch, which
+// is conditional on the ETag it came with.
+TEST_F(BlockerListsTest, TheExpiresLineSetsTheNextFetch) {
+  TurnOn();
+  const base::Time fetched = base::Time::Now();
+  Answer(kEasyListUrl, "\"one\"");
+  Answer(kEasyPrivacyUrl, "\"two\"");
+  EXPECT_EQ(fetched + base::Days(2), lists_->NextFetchForTesting("easylist"));
+  EXPECT_TRUE(base::PathExists(dir_.GetPath().AppendASCII("easylist.txt")));
+  ASSERT_FALSE(published_.empty());
+  EXPECT_TRUE(base::PathExists(published_.back().ruleset_path));
+  EXPECT_TRUE(base::PathExists(published_.back().license_path));
+  const BlockerLists::Status status = lists_->GetStatus();
+  EXPECT_TRUE(status.has_ruleset);
+  EXPECT_EQ(4, status.url_rules) << "two rules from each list";
+
+  task_environment_.FastForwardBy(base::Days(2) - base::Minutes(1));
+  EXPECT_FALSE(Pending(kEasyListUrl));
+  task_environment_.FastForwardBy(base::Minutes(2));
+  const network::ResourceRequest* const again = Pending(kEasyListUrl);
+  ASSERT_TRUE(again);
+  EXPECT_EQ("\"one\"",
+            again->headers.GetHeader(net::HttpRequestHeaders::kIfNoneMatch));
+}
+
+// Bk2: a 304 keeps the stored list and the ruleset; the list is next asked
+// for after its expiry again. "Update lists now" asks at once.
+TEST_F(BlockerListsTest, ANotModifiedAnswerKeepsTheList) {
+  TurnOn();
+  Answer(kEasyListUrl, "\"one\"");
+  Answer(kEasyPrivacyUrl, "\"two\"");
+  ASSERT_FALSE(published_.empty());
+  indexed_ = published_.back().content_version;
+  const size_t published = published_.size();
+
+  lists_->UpdateNow();
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(Pending(kEasyListUrl));
+  const base::Time asked = base::Time::Now();
+  ASSERT_TRUE(factory_.SimulateResponseForPendingRequest(
+      GURL(kEasyListUrl), network::URLLoaderCompletionStatus(),
+      network::CreateURLResponseHead(net::HTTP_NOT_MODIFIED), ""));
+  ASSERT_TRUE(factory_.SimulateResponseForPendingRequest(
+      GURL(kEasyPrivacyUrl), network::URLLoaderCompletionStatus(),
+      network::CreateURLResponseHead(net::HTTP_NOT_MODIFIED), ""));
+  task_environment_.RunUntilIdle();
+
+  EXPECT_EQ(published, published_.size()) << "nothing new to index";
+  EXPECT_EQ(asked + base::Days(2), lists_->NextFetchForTesting("easylist"));
+  std::string stored;
+  ASSERT_TRUE(base::ReadFileToString(
+      dir_.GetPath().AppendASCII("easylist.txt"), &stored));
+  EXPECT_EQ(kList, stored);
+  EXPECT_FALSE(lists_->GetStatus().lists[0].failing);
+}
+
+// Bk2, Bk3: a failed fetch, or an answer that is no filter list, is tried
+// again after an hour, then after two.
+TEST_F(BlockerListsTest, AFailedFetchRetriesWithBackoff) {
+  TurnOn();
+  base::Time failed = base::Time::Now();
+  ASSERT_TRUE(factory_.SimulateResponseForPendingRequest(
+      GURL(kEasyListUrl),
+      network::URLLoaderCompletionStatus(net::ERR_CONNECTION_REFUSED),
+      network::CreateURLResponseHead(net::HTTP_OK), ""));
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(failed + base::Hours(1), lists_->NextFetchForTesting("easylist"));
+  EXPECT_TRUE(lists_->GetStatus().lists[0].failing);
+
+  task_environment_.FastForwardBy(base::Hours(1));
+  ASSERT_TRUE(Pending(kEasyListUrl));
+  failed = base::Time::Now();
+  // A captive portal's page under the list's address.
+  ASSERT_TRUE(factory_.SimulateResponseForPendingRequest(
+      GURL(kEasyListUrl), network::URLLoaderCompletionStatus(),
+      network::CreateURLResponseHead(net::HTTP_OK),
+      "<html><body>Sign in to the network</body></html>"));
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(failed + base::Hours(2), lists_->NextFetchForTesting("easylist"));
+  EXPECT_FALSE(base::PathExists(dir_.GetPath().AppendASCII("easylist.txt")));
+  EXPECT_TRUE(published_.empty());
+}
+
+// Bk11, Bk3: a ruleset made at an earlier run that the service never
+// indexed (a quit or a crash while indexing) is made again at launch, under
+// a new salt, so a version the service's crash sentinel bars is not asked
+// for again.
+TEST_F(BlockerListsTest, ARulesetNeverIndexedIsMadeAgainAtLaunch) {
+  TurnOn();
+  Answer(kEasyListUrl, "\"one\"");
+  Answer(kEasyPrivacyUrl, "\"two\"");
+  ASSERT_FALSE(published_.empty());
+  const std::string first = published_.back().content_version;
+  indexed_ = "an older version";
+
+  BlockerLists::Environment environment;
+  environment.local_state = &local_state_;
+  environment.dir = dir_.GetPath();
+  environment.url_loader_factory = factory_.GetSafeWeakWrapper();
+  environment.list_base = GURL("https://lists.test/");
+  environment.minimum_rules = 1;
+  environment.publish = base::BindRepeating(
+      [](std::vector<subresource_filter::UnindexedRulesetInfo>* published,
+         const subresource_filter::UnindexedRulesetInfo& info) {
+        published->push_back(info);
+      },
+      base::Unretained(&published_));
+  environment.indexed_version = base::BindRepeating(
+      [](const std::string* indexed) { return *indexed; },
+      base::Unretained(&indexed_));
+  lists_ = std::make_unique<BlockerLists>(std::move(environment));
+  lists_->Start();
+  task_environment_.RunUntilIdle();
+  ASSERT_FALSE(published_.empty());
+  EXPECT_NE(first, published_.back().content_version);
+}
+
+}  // namespace stedding
