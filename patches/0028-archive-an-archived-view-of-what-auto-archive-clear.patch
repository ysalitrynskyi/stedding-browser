+namespace stedding {
+
+// docs/features/archive.md A8: why a tab left the sidebar. Set on the
+// WebContents just before the close, read while Chromium records the closed
+// tab, so the archive knows a sweep from a Clear from a plain ⌘W.
+enum class ArchiveReason { kAuto, kClear };
+
+inline constexpr char kArchiveReasonKey[] = "stedding.archive.reason";
+
+const char* ArchiveReasonName(ArchiveReason reason);
+std::optional<ArchiveReason> ArchiveReasonFromName(std::string_view name);
+
+void MarkForArchive(content::WebContents* contents, ArchiveReason reason);
+std::optional<ArchiveReason> ArchiveMarkOf(content::WebContents* contents);
+
+// Tests watch the marks go on, since the tab is gone a moment later.
+using ArchiveMarkObserver =
+    base::RepeatingCallback<void(content::WebContents*, ArchiveReason)>;
+void SetArchiveMarkObserverForTesting(ArchiveMarkObserver observer);
+
+}  // namespace stedding
