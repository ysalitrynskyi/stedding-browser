+// Stedding (toolbar T48, sidebar Y29): the empty row either side of a centred
+// address field. It holds nothing, so a press there moves the window, as on
+// any other empty part of the row.
+class SteddingRowSpacer : public views::View {
+  METADATA_HEADER(SteddingRowSpacer, views::View)
+};
+
+BEGIN_METADATA(SteddingRowSpacer)
+END_METADATA
+
+// Stedding (toolbar T49, GitHub issue 14): side by side, the active pane's
+// part of the row, its left edge and its right, in `toolbar`'s coordinates.
+// Nothing outside a split, or with the panes stacked, where the row is the
+// upper pane's alone and the page is the whole row.
+std::optional<std::pair<int, int>> SteddingActivePaneSpan(
+    BrowserView* browser_view,
+    const views::View* toolbar) {
+  MultiContentsView* const panes =
+      browser_view ? browser_view->multi_contents_view() : nullptr;
+  if (!panes || !panes->IsInSplitView() ||
+      panes->GetSplitLayout() != split_tabs::SplitTabLayout::kSideBySide ||
+      !toolbar->GetWidget()) {
+    return std::nullopt;
+  }
+  const ContentsContainerView* const pane =
+      panes->GetActiveContentsContainerView();
+  if (!pane || !pane->GetVisible() || !pane->GetWidget()) {
+    return std::nullopt;
+  }
+  // Through the screen: in full screen on the Mac the row is in an overlay
+  // widget of its own (toolbar T24).
+  gfx::Point left;
+  gfx::Point right(pane->width(), 0);
+  views::View::ConvertPointToScreen(pane, &left);
+  views::View::ConvertPointToScreen(pane, &right);
+  views::View::ConvertPointFromScreen(toolbar, &left);
+  views::View::ConvertPointFromScreen(toolbar, &right);
+  return std::make_pair(left.x(), right.x());
+}
