+// windows G15: a pin removed in one window (pins H29's Remove closes it)
+// leaves every window: an asleep copy closes without a trace. Reopening it
+// makes it a record again, in every window.
+IN_PROC_BROWSER_TEST_F(PinsEveryWindowTest, ARemovedPinLeavesEveryWindow) {
+  tabs::TabInterface* const pin = PinPage(browser(), Page("/title1.html"));
+  BrowserWindowInterface* const second = OpenWindow();
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(second).size() == 1u; }));
+  TabStripModel* const there = second->GetTabStripModel();
+  const int there_before = there->count();
+
+  // As Remove closes it: into Recently Closed, so it can be reopened.
+  TabStripModel* const strip = browser()->GetTabStripModel();
+  strip->CloseWebContentsAt(strip->GetIndexOfTab(pin),
+                            TabCloseTypes::CLOSE_USER_GESTURE |
+                                TabCloseTypes::CLOSE_CREATE_HISTORICAL_TAB);
+  ASSERT_TRUE(base::test::RunUntil([&] { return Pins(second).empty(); }))
+      << "the second window kept the removed pin";
+  EXPECT_EQ(there_before - 1, there->count());
+  EXPECT_TRUE(Store().records().empty());
+
+  // Reopen Closed Tab brings the pin back, and with it every window's copy.
+  // The second window's copy closed without a trace: what reopens is the
+  // first window's pin, in the first window.
+  const int here_before = strip->count();
+  chrome::ExecuteCommand(browser(), IDC_RESTORE_TAB);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return strip->count() == here_before + 1; }))
+      << "nothing was reopened in the first window";
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Pins(browser()).size() == 1u; }))
+      << "the reopened tab is no pin";
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return Store().records().size() == 1u; }))
+      << "the reopened pin is no record";
+  ASSERT_TRUE(base::test::RunUntil([&] { return Pins(second).size() == 1u; }))
+      << "the second window lacks the reopened pin";
+  EXPECT_EQ(1u, Store().records().size());
+  EXPECT_EQ(Token(Pins(browser()).front()), Token(Pins(second).front()));
+}
