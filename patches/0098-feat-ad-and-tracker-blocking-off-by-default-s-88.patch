+
+#ifndef CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_LISTS_H_
+#define CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_LISTS_H_
+
+#include <cstddef>
+#include <functional>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/time/time.h"
+#include "base/timer/wall_clock_timer.h"
+#include "base/values.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "url/gurl.h"
+
+class PrefService;
+
+namespace base {
+class UpdateableSequencedTaskRunner;
+}  // namespace base
+
+namespace network {
+class SharedURLLoaderFactory;
+class SimpleURLLoader;
+}  // namespace network
+
+namespace subresource_filter {
+struct UnindexedRulesetInfo;
+}  // namespace subresource_filter
+
+namespace stedding {
+
+struct ConvertResult;
+
+// docs/features/blocker.md Bk2, Bk3, Bk9, Bk12: the filter lists, fetched at
+// run time and only while blocking is on, and the ruleset made from them.
+// One for the browser, owned by the process (StartBlocker).
+//
+// Each list is fetched when its own "! Expires:" line says (Bk2), with a
+// conditional request that carries nothing about the user (Bk12): no cookies,
+// no cache, no query string. A 304 keeps the stored list. A failed fetch is
+// tried again after an hour, then after twice as long each time, up to the
+// list's own expiry. A changed list is converted (blocker_convert.h) on a
+// background sequence and handed to Chromium's ruleset service, which indexes
+// it and publishes it to every renderer (Bk3). Nothing is fetched or
+// converted while the switch is off, or for a list that is off.
+class BlockerLists {
+ public:
+  // One list Stedding offers: its id in the state, its name and where it
+  // comes from, as Settings and the LICENSE file name it; its file below the
+  // list base; and the local-state preference that turns it on.
+  struct ListSpec {
+    std::string_view id;
+    std::string_view name;
+    std::string_view file;
+    std::string_view homepage;
+    std::string_view licence;
+    const char* pref;
+  };
+  static const std::vector<ListSpec>& Specs();
+
+  // Where the lists come from and where they go; the tests give their own.
+  struct Environment {
+    Environment();
+    Environment(Environment&&);
+    Environment& operator=(Environment&&);
+    ~Environment();
+
+    raw_ptr<PrefService> local_state = nullptr;
+    // <user data>/Stedding Blocker: the downloaded lists, and the converted
+    // ruleset in its "ruleset" folder.
+    base::FilePath dir;
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory;
+    // https://easylist.to/easylist/ in the product.
+    GURL list_base;
+    // The fewest URL rules a list must give to be taken as whole (Bk3).
+    size_t minimum_rules = 1000;
+    // At launch a due fetch waits this long, so it is not part of the
+    // browser's start.
+    base::TimeDelta launch_delay = base::Seconds(10);
+    // Hands a converted ruleset to Chromium's ruleset service.
+    base::RepeatingCallback<void(
+        const subresource_filter::UnindexedRulesetInfo&)>
+        publish;
+    // The content version the ruleset service last indexed.
+    base::RepeatingCallback<std::string()> indexed_version;
+  };
+
+  // What Settings and the button show (Bk6, Bk9).
+  struct ListStatus {
+    std::string id;
+    std::string name;
+    std::string homepage;
+    std::string licence;
+    bool enabled = false;
+    // The last fetch that brought or confirmed the list; null before one.
+    base::Time fetched;
+    // The last fetch failed and a retry is waiting.
+    bool failing = false;
+  };
+  struct Status {
+    Status();
+    Status(const Status&);
+    Status& operator=(const Status&);
+    ~Status();
+
+    bool on = false;
+    // A fetch or a conversion is under way.
+    bool busy = false;
+    // A ruleset has been made from the lists; false on a fresh install until
+    // the first one arrives (Bk11).
+    bool has_ruleset = false;
+    // The content version of the ruleset made last; empty before one.
+    std::string content_version;
+    base::Time updated;
+    int url_rules = 0;
+    int skipped_lines = 0;
+    std::vector<ListStatus> lists;
+  };
+
+  class Observer : public base::CheckedObserver {
+   public:
+    virtual void OnBlockerListsChanged() = 0;
+  };
+
+  explicit BlockerLists(Environment environment);
+  BlockerLists(const BlockerLists&) = delete;
+  BlockerLists& operator=(const BlockerLists&) = delete;
+  ~BlockerLists();
+
+  // The browser's, or null before StartBlocker and in a process with none.
+  static BlockerLists* Get();
+  static void SetInstance(BlockerLists* lists);
+
+  // Watches the switch and the lists' preferences; while blocking is on,
+  // schedules the fetches and makes a ruleset the ruleset service does not
+  // have yet.
+  void Start();
+
+  // Bk9, Bk10: "Update lists now": every list that is on is fetched at once,
+  // whatever its expiry, at user-visible priority. Nothing while the switch
+  // is off.
+  void UpdateNow();
+
+  Status GetStatus() const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // The time a list is next fetched, null when none is scheduled.
+  base::Time NextFetchForTesting(std::string_view id) const;
+  int fetches_started_for_testing() const { return fetches_started_; }
+
+ private:
+  // The state kept in local state (prefs::kBlockerLists): each list's
+  // validators, times and failures, the ruleset last made, and the salt.
+  const base::DictValue& State() const;
+  const base::DictValue* ListState(const ListSpec& spec) const;
+  const ListSpec* SpecFor(std::string_view id) const;
+  bool ListOn(const ListSpec& spec) const;
+  bool HasStoredList(const ListSpec& spec) const;
+  base::FilePath ListPath(const ListSpec& spec) const;
+  // When a list is due: null (now) for one never stored.
+  base::Time NextFetch(const ListSpec& spec) const;
+
+  // The content version of the ruleset last made here, or empty.
+  std::string RecordedVersion() const;
+  // A list is stored but no ruleset was made from it, or the ruleset made
+  // last is not the one the ruleset service has indexed.
+  bool RulesetMissing() const;
+  // A version the service never indexed may be barred by its crash
+  // sentinel; a new salt gives the same lists a new version.
+  void BumpSaltIfRecorded();
+
+  void OnPrefsChanged();
+  // Arms the timer for the earliest list that is due.
+  void Schedule();
+  void FetchDue();
+  void Fetch(const ListSpec& spec, bool user_visible);
+  void OnFetched(std::string id, base::FilePath download);
+  void OnNotModified(const std::string& id);
+  void OnStored(std::string id,
+                std::string etag,
+                std::string last_modified,
+                std::optional<base::TimeDelta> expiry);
+  void FetchFailed(const std::string& id);
+  // Converts every list that is on and stored, unless one is converting.
+  void Convert();
+  void OnConverted(const ConvertResult& result);
+  void NotifyChanged();
+
+  Environment env_;
+  PrefChangeRegistrar registrar_;
+  base::WallClockTimer timer_;
+  scoped_refptr<base::UpdateableSequencedTaskRunner> file_task_runner_;
+  std::map<std::string, std::unique_ptr<network::SimpleURLLoader>, std::less<>>
+      loaders_;
+  // At launch, a list already due waits for `launch_delay`; once the switch
+  // has been turned on here, it does not.
+  bool at_launch_ = true;
+  base::Time start_time_;
+  bool converting_ = false;
+  bool convert_again_ = false;
+  bool was_on_ = false;
+  int fetches_started_ = 0;
+  base::ObserverList<Observer> observers_;
+  base::WeakPtrFactory<BlockerLists> weak_factory_{this};
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_BLOCKER_BLOCKER_LISTS_H_
