+
+#include "chrome/browser/ui/spaces/sidebar_sync_ledger.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+
+namespace spaces::sidebar_sync {
+
+namespace {
+
+constexpr char kLedgerFile[] = "ledger.json";
+constexpr char kBackupsFolder[] = "backups";
+constexpr char kBackupPrefix[] = "before-sync-";
+constexpr size_t kMaxLedgerBytes = 64 * 1024 * 1024;
+constexpr int64_t kJournalKeepMs = base::Days(30).InMilliseconds();
+
+// A whole number a double holds exactly, as the sidebar file reads one
+// (Sf33); anything else is as if absent. A number past int64_t would be
+// undefined to cast.
+std::optional<int64_t> WholeNumber(const base::Value& value) {
+  const std::optional<double> number = value.GetIfDouble();
+  if (!number || !std::isfinite(*number) || std::trunc(*number) != *number ||
+      std::fabs(*number) > static_cast<double>(kMaxTime)) {
+    return std::nullopt;
+  }
+  return static_cast<int64_t>(*number);
+}
+
+std::optional<int64_t> WholeNumber(const base::DictValue& dict,
+                                   std::string_view key) {
+  const base::Value* const value = dict.Find(key);
+  return value ? WholeNumber(*value) : std::nullopt;
+}
+
+base::ListValue StringsToList(const std::set<std::string>& strings) {
+  base::ListValue list;
+  for (const std::string& value : strings) {
+    list.Append(value);
+  }
+  return list;
+}
+
+std::set<std::string> StringsFrom(const base::DictValue& dict,
+                                  std::string_view key) {
+  std::set<std::string> out;
+  if (const base::ListValue* const list = dict.FindList(key)) {
+    for (const base::Value& value : *list) {
+      if (value.is_string()) {
+        out.insert(value.GetString());
+      }
+    }
+  }
+  return out;
+}
+
+base::DictValue JournalToValue(const JournalEntry& entry) {
+  base::DictValue value;
+  value.Set("id", entry.id);
+  value.Set("applied_ms", static_cast<double>(entry.applied_ms));
+  value.Set("device", entry.device);
+  value.Set("added", static_cast<int>(entry.added));
+  value.Set("removed", static_cast<int>(entry.removed));
+  value.Set("changed", static_cast<int>(entry.changed));
+  value.Set("replaced_local_edit", entry.replaced_local_edit);
+  value.Set("before", StateToValue(entry.before));
+  base::ListValue absent;
+  for (const std::string& id : entry.absent) {
+    absent.Append(id);
+  }
+  value.Set("absent", std::move(absent));
+  return value;
+}
+
+std::optional<JournalEntry> JournalFromValue(const base::DictValue& value) {
+  JournalEntry entry;
+  const std::string* const id = value.FindString("id");
+  const std::string* const device = value.FindString("device");
+  const std::optional<int64_t> applied = WholeNumber(value, "applied_ms");
+  const base::DictValue* const before = value.FindDict("before");
+  std::optional<State> state = before ? StateFromValue(*before) : std::nullopt;
+  if (!id || !device || !applied || !state) {
+    return std::nullopt;
+  }
+  entry.id = *id;
+  entry.device = *device;
+  entry.applied_ms = *applied;
+  entry.added = static_cast<size_t>(value.FindInt("added").value_or(0));
+  entry.removed = static_cast<size_t>(value.FindInt("removed").value_or(0));
+  entry.changed = static_cast<size_t>(value.FindInt("changed").value_or(0));
+  entry.replaced_local_edit =
+      value.FindBool("replaced_local_edit").value_or(false);
+  entry.before = std::move(*state);
+  const std::set<std::string> absent = StringsFrom(value, "absent");
+  entry.absent.assign(absent.begin(), absent.end());
+  return entry;
+}
+
+base::FilePath LedgerDir(const base::FilePath& profile_dir) {
+  return profile_dir.AppendASCII(kLedgerFolderName);
+}
+
+}  // namespace
+
+OwnFileKind ClassifyOwnFile(const FileMeta& found,
+                            const std::vector<WriteRecord>& recent,
+                            int64_t our_seq) {
+  const auto known = std::ranges::find_if(
+      recent,
+      [&](const WriteRecord& write) { return write.nonce == found.nonce; });
+  if (known != recent.end()) {
+    return known + 1 == recent.end() ? OwnFileKind::kOurs : OwnFileKind::kEcho;
+  }
+  if (recent.empty() && our_seq == 0 && found.seq == 0) {
+    return OwnFileKind::kOurs;
+  }
+  // A write this install never made, past its own number, or at it once
+  // this install's own write at that number is noted, is a copy of the
+  // profile writing too. Each write is noted before it is made
+  // (SidebarSyncService::WriteOwnFile); a ledger from before that may hold
+  // a number whose write was never noted, and a file at that number is then
+  // taken for an old echo. Only an older number is always an echo.
+  if (found.seq > our_seq) {
+    return OwnFileKind::kCopy;
+  }
+  const bool ours_noted = !recent.empty() && recent.back().seq == our_seq;
+  return found.seq == our_seq && ours_noted ? OwnFileKind::kCopy
+                                            : OwnFileKind::kEcho;
+}
+
+PeerStat::PeerStat() = default;
+PeerStat::PeerStat(const PeerStat& other) = default;
+PeerStat& PeerStat::operator=(const PeerStat& other) = default;
+PeerStat::~PeerStat() = default;
+
+JournalEntry::JournalEntry() = default;
+JournalEntry::JournalEntry(const JournalEntry& other) = default;
+JournalEntry& JournalEntry::operator=(const JournalEntry& other) = default;
+JournalEntry::~JournalEntry() = default;
+
+Ledger::Ledger() = default;
+Ledger::Ledger(const Ledger& other) = default;
+Ledger::Ledger(Ledger&& other) = default;
+Ledger& Ledger::operator=(const Ledger& other) = default;
+Ledger& Ledger::operator=(Ledger&& other) = default;
+Ledger::~Ledger() = default;
+
+void Ledger::NoteWrite(const WriteRecord& write) {
+  recent.push_back(write);
+  if (recent.size() > kRecentWrites) {
+    recent.erase(recent.begin(),
+                 recent.begin() +
+                     static_cast<ptrdiff_t>(recent.size() - kRecentWrites));
+  }
+}
+
+void Ledger::TrimJournal(int64_t now_ms) {
+  std::erase_if(journal, [now_ms](const JournalEntry& entry) {
+    return now_ms - entry.applied_ms > kJournalKeepMs;
+  });
+  if (journal.size() > kJournalEntries) {
+    journal.erase(journal.begin(),
+                  journal.begin() +
+                      static_cast<ptrdiff_t>(journal.size() - kJournalEntries));
+  }
+}
+
+void Ledger::NoteTombstones(int64_t now_ms) {
+  for (const auto& [id, record] : state.records) {
+    if (!record.Alive()) {
+      tombstone_received.emplace(id, now_ms);
+    } else {
+      tombstone_received.erase(id);
+    }
+  }
+  std::erase_if(tombstone_received, [this](const auto& entry) {
+    return !state.records.contains(entry.first);
+  });
+}
+
+base::DictValue LedgerToValue(const Ledger& ledger) {
+  base::DictValue sync = StateToValue(ledger.state);
+  sync.Set("format", kFormat);
+  sync.Set("hlc", static_cast<double>(ledger.hlc));
+  sync.Set("joined_ms", static_cast<double>(ledger.joined_ms));
+  sync.Set("seq", static_cast<double>(ledger.seq));
+
+  base::DictValue local;
+  base::ListValue recent;
+  for (const WriteRecord& write : ledger.recent) {
+    base::DictValue entry;
+    entry.Set("nonce", write.nonce);
+    entry.Set("seq", static_cast<double>(write.seq));
+    entry.Set("written_ms", static_cast<double>(write.written_ms));
+    recent.Append(std::move(entry));
+  }
+  local.Set("recent", std::move(recent));
+  base::DictValue received;
+  for (const auto& [id, when] : ledger.tombstone_received) {
+    received.Set(id, static_cast<double>(when));
+  }
+  local.Set("tombstone_received", std::move(received));
+  base::DictValue peers;
+  for (const auto& [install, stat] : ledger.peers) {
+    base::DictValue entry;
+    entry.Set("mtime_ms", static_cast<double>(stat.mtime_ms));
+    entry.Set("size", static_cast<double>(stat.size));
+    entry.Set("seq", static_cast<double>(stat.seq));
+    entry.Set("written_ms", static_cast<double>(stat.written_ms));
+    entry.Set("read_ms", static_cast<double>(stat.read_ms));
+    entry.Set("device", stat.device);
+    peers.Set(install, std::move(entry));
+  }
+  local.Set("peers", std::move(peers));
+  local.Set("inserted_unopened", StringsToList(ledger.inserted_unopened));
+  local.Set("pending_adds", StringsToList(ledger.pending_adds));
+  base::DictValue kept;
+  for (const auto& [id, value] : ledger.isolation_kept) {
+    kept.Set(id, value);
+  }
+  local.Set("isolation_kept", std::move(kept));
+  local.Set("dismissed_files", StringsToList(ledger.dismissed_files));
+  local.Set("folder_behind", ledger.folder_behind);
+  base::ListValue journal;
+  for (const JournalEntry& entry : ledger.journal) {
+    journal.Append(JournalToValue(entry));
+  }
+  local.Set("journal", std::move(journal));
+
+  base::DictValue root;
+  root.Set("stedding_sync", std::move(sync));
+  root.Set("local", std::move(local));
+  return root;
+}
+
+std::optional<Ledger> LedgerFromValue(const base::DictValue& value) {
+  const base::DictValue* const sync = value.FindDict("stedding_sync");
+  const base::DictValue* const local = value.FindDict("local");
+  if (!sync || !local || sync->FindInt("format").value_or(0) != kFormat) {
+    return std::nullopt;
+  }
+  std::optional<State> state = StateFromValue(*sync);
+  if (!state) {
+    return std::nullopt;
+  }
+  Ledger ledger;
+  ledger.state = std::move(*state);
+  ledger.hlc = WholeNumber(*sync, "hlc").value_or(0);
+  ledger.joined_ms = WholeNumber(*sync, "joined_ms").value_or(0);
+  ledger.seq = WholeNumber(*sync, "seq").value_or(0);
+  if (const base::ListValue* const recent = local->FindList("recent")) {
+    for (const base::Value& entry : *recent) {
+      const base::DictValue* const dict = entry.GetIfDict();
+      const std::string* const nonce = dict ? dict->FindString("nonce") : nullptr;
+      if (!nonce) {
+        continue;
+      }
+      ledger.recent.push_back(
+          WriteRecord{*nonce, WholeNumber(*dict, "seq").value_or(0),
+                      WholeNumber(*dict, "written_ms").value_or(0)});
+    }
+  }
+  if (const base::DictValue* const received =
+          local->FindDict("tombstone_received")) {
+    for (const auto [id, when] : *received) {
+      if (const std::optional<int64_t> time = WholeNumber(when)) {
+        ledger.tombstone_received[id] = *time;
+      }
+    }
+  }
+  if (const base::DictValue* const peers = local->FindDict("peers")) {
+    for (const auto [install, entry] : *peers) {
+      const base::DictValue* const dict = entry.GetIfDict();
+      if (!dict || !IsInstallId(install)) {
+        continue;
+      }
+      PeerStat stat;
+      stat.mtime_ms = WholeNumber(*dict, "mtime_ms").value_or(0);
+      stat.size = WholeNumber(*dict, "size").value_or(0);
+      stat.seq = WholeNumber(*dict, "seq").value_or(0);
+      stat.written_ms = WholeNumber(*dict, "written_ms").value_or(0);
+      stat.read_ms = WholeNumber(*dict, "read_ms").value_or(0);
+      if (const std::string* const device = dict->FindString("device")) {
+        stat.device = *device;
+      }
+      ledger.peers[install] = std::move(stat);
+    }
+  }
+  ledger.inserted_unopened = StringsFrom(*local, "inserted_unopened");
+  ledger.pending_adds = StringsFrom(*local, "pending_adds");
+  if (const base::DictValue* const kept = local->FindDict("isolation_kept")) {
+    for (const auto [id, kept_value] : *kept) {
+      if (kept_value.is_string()) {
+        ledger.isolation_kept[id] = kept_value.GetString();
+      }
+    }
+  }
+  ledger.dismissed_files = StringsFrom(*local, "dismissed_files");
+  ledger.folder_behind = local->FindBool("folder_behind").value_or(false);
+  if (const base::ListValue* const journal = local->FindList("journal")) {
+    for (const base::Value& entry : *journal) {
+      if (const base::DictValue* const dict = entry.GetIfDict()) {
+        if (std::optional<JournalEntry> parsed = JournalFromValue(*dict)) {
+          ledger.journal.push_back(std::move(*parsed));
+        }
+      }
+    }
+  }
+  return ledger;
+}
+
+base::FilePath LedgerPath(const base::FilePath& profile_dir) {
+  return LedgerDir(profile_dir).AppendASCII(kLedgerFile);
+}
+
+std::optional<Ledger> ReadLedger(const base::FilePath& profile_dir) {
+  std::string json;
+  if (!base::ReadFileToStringWithMaxSize(LedgerPath(profile_dir), &json,
+                                         kMaxLedgerBytes)) {
+    return std::nullopt;
+  }
+  std::optional<base::DictValue> value =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  return value ? LedgerFromValue(*value) : std::nullopt;
+}
+
+bool WriteLedgerJson(const base::FilePath& profile_dir,
+                     const std::string& json) {
+  const base::FilePath dir = LedgerDir(profile_dir);
+  return base::CreateDirectory(dir) &&
+         base::ImportantFileWriter::WriteFileAtomically(
+             dir.AppendASCII(kLedgerFile), json);
+}
+
+void DeleteLedger(const base::FilePath& profile_dir) {
+  base::DeletePathRecursively(LedgerDir(profile_dir));
+}
+
+base::FilePath WriteBackup(const base::FilePath& profile_dir,
+                           const std::string& json,
+                           base::Time now) {
+  const base::FilePath dir =
+      LedgerDir(profile_dir).AppendASCII(kBackupsFolder);
+  if (!base::CreateDirectory(dir)) {
+    return base::FilePath();
+  }
+  base::Time::Exploded exploded;
+  now.UTCExplode(&exploded);
+  const base::FilePath path = base::GetUniquePath(dir.AppendASCII(
+      base::StringPrintf("%s%04d%02d%02d-%02d%02d%02d.json", kBackupPrefix,
+                         exploded.year, exploded.month, exploded.day_of_month,
+                         exploded.hour, exploded.minute, exploded.second)));
+  if (path.empty() ||
+      !base::ImportantFileWriter::WriteFileAtomically(path, json)) {
+    return base::FilePath();
+  }
+  const std::vector<base::FilePath> backups = ListBackups(profile_dir);
+  for (size_t i = kBackupsKept; i < backups.size(); ++i) {
+    base::DeleteFile(backups[i]);
+  }
+  return path;
+}
+
+std::vector<base::FilePath> ListBackups(const base::FilePath& profile_dir) {
+  std::vector<base::FilePath> backups;
+  base::FileEnumerator files(
+      LedgerDir(profile_dir).AppendASCII(kBackupsFolder), false,
+      base::FileEnumerator::FILES);
+  for (base::FilePath path = files.Next(); !path.empty();
+       path = files.Next()) {
+    const std::string name = path.BaseName().AsUTF8Unsafe();
+    if (base::StartsWith(name, kBackupPrefix) &&
+        base::EndsWith(name, ".json")) {
+      backups.push_back(path);
+    }
+  }
+  // Newest first. The names sort by time, but a backup made in the same
+  // second as another is "<time> (N).json" (base::GetUniquePath), newer the
+  // larger N, and as text " (1)" sorts below ".json": that put the newer one
+  // after the older, and the rotation deleted it (BACKLOG S-353).
+  const auto made = [](const base::FilePath& path) {
+    std::string name = path.BaseName().AsUTF8Unsafe();
+    name = name.substr(strlen(kBackupPrefix),
+                       name.size() - strlen(kBackupPrefix) - strlen(".json"));
+    int copy = 0;
+    if (const size_t open = name.find(" (");
+        open != std::string::npos && name.back() == ')' &&
+        base::StringToInt(
+            std::string_view(name).substr(open + 2, name.size() - open - 3),
+            &copy)) {
+      name.resize(open);
+    } else {
+      copy = 0;
+    }
+    return std::make_pair(std::move(name), copy);
+  };
+  std::ranges::sort(backups, std::ranges::greater(), made);
+  return backups;
+}
+
+}  // namespace spaces::sidebar_sync
