+++ b/chrome/browser/ui/views/stedding_welcome/welcome_dialog_view.cc
@@ -0,0 +1,157 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding_welcome/welcome_dialog_view.h"
+
+#include <memory>
+#include <set>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/platform_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_window.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/browser/ui/webui/stedding_welcome/stedding_welcome_ui.h"
+#include "chrome/common/chrome_switches.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "ui/base/mojom/dialog_button.mojom.h"
+#include "ui/base/mojom/ui_base_types.mojom.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/controls/webview/webview.h"
+#include "ui/views/layout/fill_layout.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+#include "ui/views/window/dialog_delegate.h"
+#include "url/gurl.h"
+
+namespace stedding {
+
+namespace {
+
+constexpr int kWidth = 960;
+constexpr int kHeight = 640;
+
+// Forces the flow regardless of the preference and of --no-first-run.
+constexpr char kForceWelcomeSwitch[] = "stedding-welcome";
+
+// Profiles with a welcome dialog open right now.
+std::set<const Profile*>& OpenDialogs() {
+  static base::NoDestructor<std::set<const Profile*>> dialogs;
+  return *dialogs;
+}
+
+// The welcome page in a dialog that floats over the browser window as its
+// child: a plain DialogDelegate whose contents view is a WebView. The dialog
+// owns its widget and deletes itself once the window has closed. Two things
+// it deliberately is not: a window-modal sheet, because Chromium refuses to
+// quit while the active window has a sheet attached (AppController's
+// keyWindowIsModal), and a WebDialogView, which answers the first close
+// request with "not yet" while it runs beforeunload. The dialog closes when
+// the page records the flow as seen (the preference flips in WelcomeHandler).
+class WelcomeDialog : public views::DialogDelegate {
+ public:
+  explicit WelcomeDialog(Profile* profile) : profile_(profile) {
+    OpenDialogs().insert(profile);
+    SetButtons(static_cast<int>(ui::mojom::DialogButton::kNone));
+    SetModalType(ui::mojom::ModalType::kNone);
+    SetShowCloseButton(false);
+    SetShowTitle(false);
+    SetOwnershipOfNewWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+
+    auto contents = std::make_unique<views::View>();
+    contents->SetLayoutManager(std::make_unique<views::FillLayout>());
+    web_view_ =
+        contents->AddChildView(std::make_unique<views::WebView>(profile));
+    web_view_->SetPreferredSize(gfx::Size(kWidth, kHeight));
+    web_view_->LoadInitialURL(GURL(kWelcomeURL));
+    SetContentsView(std::move(contents));
+
+    registrar_.Init(profile->GetPrefs());
+    registrar_.Add(prefs::kWelcomeShown,
+                   base::BindRepeating(&WelcomeDialog::OnFinished,
+                                       base::Unretained(this)));
+  }
+  WelcomeDialog(const WelcomeDialog&) = delete;
+  WelcomeDialog& operator=(const WelcomeDialog&) = delete;
+  ~WelcomeDialog() override { OpenDialogs().erase(profile_); }
+
+  void Show(Browser& browser) {
+    const gfx::NativeWindow parent = browser.GetWindow()->GetNativeWindow();
+    widget_ = base::WrapUnique(views::DialogDelegate::CreateDialogWidget(
+        this, gfx::NativeWindow(), platform_util::GetViewForWindow(parent)));
+    widget_->CenterWindow(widget_->GetContentsView()->GetPreferredSize());
+    widget_->Show();
+    // A child window is not key on its own; without this the first click
+    // only brings it forward and typing goes to the browser behind it.
+    widget_->Activate();
+    web_view_->RequestFocus();
+  }
+
+  // views::DialogDelegate:
+  void WindowClosing() override {
+    // The window is going away for any reason (Finish, Skip, the window
+    // closing, Quit); the dialog follows once the close has unwound.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                  this);
+  }
+
+ private:
+  void OnFinished() {
+    if (widget_ && !widget_->IsClosed()) {
+      widget_->Close();
+    }
+  }
+
+  const raw_ptr<const Profile> profile_;
+  raw_ptr<views::WebView> web_view_ = nullptr;
+  std::unique_ptr<views::Widget> widget_;
+  PrefChangeRegistrar registrar_;
+};
+
+void ShowWelcomeDialogIfOpen(base::WeakPtr<BrowserWindowInterface> window) {
+  if (!window || OpenDialogs().contains(window->GetProfile())) {
+    return;
+  }
+  if (Browser* const browser = window->GetBrowserForMigrationOnly()) {
+    ShowWelcomeDialog(*browser);
+  }
+}
+
+}  // namespace
+
+void ShowWelcomeDialog(Browser& browser) {
+  // Owned by itself until its window has closed (WindowClosing).
+  (new WelcomeDialog(browser.GetProfile()))->Show(browser);
+}
+
+void MaybeShowWelcomeDialog(Browser& browser) {
+  Profile* const profile = browser.GetProfile();
+  if (browser.GetType() != BrowserWindowInterface::TYPE_NORMAL || !profile ||
+      profile->IsOffTheRecord() || OpenDialogs().contains(profile)) {
+    return;
+  }
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  const bool forced = command_line.HasSwitch(kForceWelcomeSwitch);
+  if (!forced && (command_line.HasSwitch(switches::kNoFirstRun) ||
+                  profile->GetPrefs()->GetBoolean(prefs::kWelcomeShown))) {
+    return;
+  }
+  // BrowserView::Show runs before the startup tabs are settled; the dialog
+  // wants a shown window, so it opens on the next turn of the loop.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&ShowWelcomeDialogIfOpen, browser.GetWeakPtr()));
+}
+
+}  // namespace stedding
