+
+#include "base/i18n/case_conversion.h"
+#include "base/i18n/string_compare.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/spaces/space_model.h"
+#include "chrome/browser/ui/stedding/tab_names.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/tabs/public/folder_tab_collection.h"
+#include "components/tabs/public/tab_collection.h"
+#include "components/tabs/public/tab_collection_types.h"
+#include "components/tabs/public/tab_interface.h"
+#include "third_party/icu/source/i18n/unicode/coll.h"
+#include "url/gurl.h"
+
+namespace spaces {
+
+namespace {
+
+// Every folder under `collection`, outermost first. The strip hands out its
+// tree read-only; the folders go back to their own setters, as the folder
+// session does (stedding_folder_session.cc).
+void CollectFolders(const tabs::TabCollection& collection,
+                    std::vector<tabs::FolderTabCollection*>& out) {
+  for (const tabs::Child& child : collection.GetChildren()) {
+    const auto* const holder =
+        std::get_if<std::unique_ptr<tabs::TabCollection>>(&child);
+    if (!holder) {
+      continue;
+    }
+    tabs::TabCollection* const nested = holder->get();
+    if (nested->type() == tabs::TabCollection::Type::FOLDER) {
+      out.push_back(static_cast<tabs::FolderTabCollection*>(nested));
+    }
+    CollectFolders(*nested, out);
+  }
+}
+
+// Whether a collapsed folder above `collection` hides its header: the rule
+// SpaceTabVisibilityController draws the rows by.
+bool InCollapsedFolder(const tabs::TabCollection& collection) {
+  for (const tabs::TabCollection* parent = collection.GetParentCollection();
+       parent; parent = parent->GetParentCollection()) {
+    if (parent->type() == tabs::TabCollection::Type::FOLDER &&
+        static_cast<const tabs::FolderTabCollection*>(parent)->collapsed()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// folders F30: the folders that hold a tab of the active Space (F20), nested
+// ones included. A window without a Space model (a private window) has every
+// tab in the one Space it shows. Popup and app windows have no folders to
+// act on.
+std::vector<tabs::FolderTabCollection*> FoldersOfActiveSpace(
+    BrowserWindowInterface* browser) {
+  std::vector<tabs::FolderTabCollection*> folders;
+  if (!browser ||
+      browser->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return folders;
+  }
+  TabStripModel* const strip = browser->GetTabStripModel();
+  if (!strip || !strip->Root()) {
+    return folders;
+  }
+  CollectFolders(*strip->Root(), folders);
+  const SpaceModel* const model = SpaceModel::From(browser);
+  if (!model) {
+    return folders;
+  }
+  std::erase_if(folders, [model](const tabs::FolderTabCollection* folder) {
+    return std::ranges::none_of(folder->GetTabsRecursive(),
+                                [model](const tabs::TabInterface* tab) {
+                                  return model->IsTabInActiveSpace(tab);
+                                });
+  });
+  return folders;
+}
+
+}  // namespace
+
+bool CanCollapseAllFolders(BrowserWindowInterface* browser) {
+  return std::ranges::any_of(FoldersOfActiveSpace(browser),
+                             [](const tabs::FolderTabCollection* folder) {
+                               return !folder->collapsed() &&
+                                      !InCollapsedFolder(*folder);
+                             });
+}
+
+bool CanExpandAllFolders(BrowserWindowInterface* browser) {
+  return std::ranges::any_of(FoldersOfActiveSpace(browser),
+                             [](const tabs::FolderTabCollection* folder) {
+                               return folder->collapsed();
+                             });
+}
+
+void CollapseAllFolders(BrowserWindowInterface* browser) {
+  // SetCollapsed does nothing for a folder already collapsed, and tells the
+  // header, the rows and the session about the rest (F18).
+  for (tabs::FolderTabCollection* const folder :
+       FoldersOfActiveSpace(browser)) {
+    folder->SetCollapsed(true);
+  }
+}
+
+void ExpandAllFolders(BrowserWindowInterface* browser) {
+  for (tabs::FolderTabCollection* const folder :
+       FoldersOfActiveSpace(browser)) {
+    folder->SetCollapsed(false);
+  }
+}
+
+void ToggleAllFolders(BrowserWindowInterface* browser) {
+  if (CanCollapseAllFolders(browser)) {
+    CollapseAllFolders(browser);
+  } else {
+    ExpandAllFolders(browser);
+  }
+}
+
+std::vector<size_t> AlphabeticalOrder(
+    const tabs::FolderTabCollection& folder,
+    base::FunctionRef<std::u16string(const tabs::TabInterface&)> name_of) {
+  struct Row {
+    size_t index = 0;
+    bool is_folder = false;
+    std::u16string name;
+  };
+  std::vector<Row> rows;
+  const tabs::ChildrenVector& children = folder.GetChildren();
+  rows.reserve(children.size());
+  for (size_t i = 0; i < children.size(); ++i) {
+    const tabs::Child& child = children[i];
+    if (const auto* tab = std::get_if<tabs::ScopedTab>(&child)) {
+      rows.push_back({.index = i, .is_folder = false, .name = name_of(**tab)});
+      continue;
+    }
+    const tabs::TabCollection* const collection =
+        std::get<std::unique_ptr<tabs::TabCollection>>(child).get();
+    if (collection->type() == tabs::TabCollection::Type::FOLDER) {
+      // The name the header shows (folder_view.cc).
+      const std::string& title =
+          static_cast<const tabs::FolderTabCollection*>(collection)->title();
+      rows.push_back(
+          {.index = i,
+           .is_folder = true,
+           .name = title.empty() ? u"New Folder" : base::UTF8ToUTF16(title)});
+      continue;
+    }
+    // A split goes by its first pane, the one its row names first.
+    const tabs::TabInterface* const first =
+        collection->TabCountRecursive() > 0
+            ? collection->GetTabAtIndexRecursive(0)
+            : nullptr;
+    rows.push_back({.index = i,
+                    .is_folder = false,
+                    .name = first ? name_of(*first) : std::u16string()});
+  }
+
+  // Case is ignored and accents are not: the locale's collator at secondary
+  // strength, as the bookmark manager's sort uses the locale's collator.
+  UErrorCode error = U_ZERO_ERROR;
+  std::unique_ptr<icu::Collator> collator(icu::Collator::createInstance(error));
+  if (U_FAILURE(error)) {
+    collator.reset();
+  }
+  if (collator) {
+    collator->setStrength(icu::Collator::SECONDARY);
+  }
+  const auto name_less = [&collator](const std::u16string& a,
+                                     const std::u16string& b) {
+    if (collator) {
+      return base::i18n::CompareString16WithCollator(*collator, a, b) ==
+             UCOL_LESS;
+    }
+    return base::i18n::FoldCase(a) < base::i18n::FoldCase(b);
+  };
+  std::ranges::stable_sort(rows, [&name_less](const Row& a, const Row& b) {
+    if (a.is_folder != b.is_folder) {
+      return a.is_folder;
+    }
+    return name_less(a.name, b.name);
+  });
+
+  std::vector<size_t> order;
+  order.reserve(rows.size());
+  for (const Row& row : rows) {
+    order.push_back(row.index);
+  }
+  return order;
+}
+
+void AlphabetizeFolder(TabStripModel& strip,
+                       tabs::FolderTabCollection* folder) {
+  if (!folder || folder->ChildCount() < 2) {
+    return;
+  }
+  // The command bar's rule (commandbar K2): the name the user gave the tab
+  // (tabs R15), then the page title -- the title its row shows.
+  const std::vector<size_t> order =
+      AlphabeticalOrder(*folder, [](const tabs::TabInterface& tab) {
+        std::u16string name = stedding::TabName(tab.GetContents());
+        return name.empty() ? tab.GetTitle() : name;
+      });
+  strip.ReorderFolder(folder, order);
+}
+
+tabs::TabInterface* NewTabInFolder(TabStripModel& strip,
+                                   tabs::FolderTabCollection* folder) {
+  // A folder with no tab has left the tree, and takes nothing (F26).
+  if (!folder || folder->TabCountRecursive() == 0 || !strip.delegate()) {
+    return nullptr;
+  }
+  const int count = strip.count();
+  // The New Tab page, opened in the active Space as "+ New Tab" opens it
+  // (ClearActiveSpace opens the same page the same way).
+  strip.delegate()->AddTabAt(GURL(chrome::kChromeUINewTabURL), /*index=*/-1,
+                             /*foreground=*/true);
+  tabs::TabInterface* const tab = strip.GetActiveTab();
+  if (strip.count() != count + 1 || !tab || tab->IsPinned()) {
+    return nullptr;
+  }
+  // The folder's last row: MoveTabsToFolder appends after its last child,
+  // so after a nested folder rather than inside it.
+  if (strip.MoveTabsToFolder({strip.GetIndexOfTab(tab)}, folder)) {
+    folder->SetCollapsed(false);
+  }
+  return tab;
+}
+
+}  // namespace spaces
