+bool RecordLocalEdits(State& ledger,
+                      const LocalView* before,
+                      const LocalView& now,
+                      const std::set<std::string>& tombstones,
+                      const Stamp& stamp) {
+  bool changed = false;
+  for (const auto& [id, item] : now.items) {
+    auto it = ledger.records.find(id);
+    if (it == ledger.records.end()) {
+      Record record(item.kind);
+      StampAll(record, item, stamp);
+      ledger.records.emplace(id, std::move(record));
+      changed = true;
+      continue;
+    }
+    Record& record = it->second;
+    const LocalItem* const seen =
+        before && before->items.contains(id) ? &before->items.at(id) : nullptr;
+    if (!record.Alive()) {
+      // Removed here and back again: the user reopened it. Removed by
+      // another computer: the applier takes it out of the sidebar, unless
+      // the user edits it first, which keeps it (Sf26).
+      if (record.del && record.del->w == stamp.w && !seen) {
+        StampAll(record, item, stamp);
+        changed = true;
+        continue;
+      }
+    }
+    for (const auto& [name, value] : item.fields) {
+      const auto field = record.f.find(name);
+      bool edited = false;
+      if (field == record.f.end()) {
+        edited = true;
+      } else if (seen) {
+        const auto was = seen->fields.find(name);
+        edited = was != seen->fields.end() && was->second != value &&
+                 field->second.v != value;
+      }
+      if (edited) {
+        record.f[name] = Field{value, stamp};
+        changed = true;
+      }
+    }
+  }
+  for (const std::string& id : tombstones) {
+    auto it = ledger.records.find(id);
+    if (it != ledger.records.end() && it->second.Alive() &&
+        !now.items.contains(id)) {
+      it->second.del = stamp;
+      changed = true;
+    }
+  }
+  for (const auto& [container, order] : now.lists) {
+    auto it = ledger.lists.find(container);
+    const std::vector<std::string>* const seen_order =
+        before && before->lists.contains(container)
+            ? &before->lists.at(container)
+            : nullptr;
+    bool edited = false;
+    if (it == ledger.lists.end()) {
+      edited = !order.empty();
+    } else {
+      const std::set<std::string> here(order.begin(), order.end());
+      const std::vector<std::string> ledger_here =
+          Filtered(it->second.order, here);
+      if (ledger_here != order) {
+        if (seen_order) {
+          // Only a change made here since the last look: a newer order from
+          // another computer not shown yet is not undone.
+          edited = *seen_order != order;
+        } else {
+          const std::set<std::string> known(it->second.order.begin(),
+                                            it->second.order.end());
+          edited = std::ranges::any_of(order, [&](const std::string& id) {
+            return !known.contains(id);
+          });
+        }
+      }
+    }
+    if (edited) {
+      List list;
+      list.order = it == ledger.lists.end()
+                       ? order
+                       : MergeOrder(order, it->second.order);
+      list.s = stamp;
+      ledger.lists[container] = std::move(list);
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+std::vector<std::string> MergeOrder(const std::vector<std::string>& winner,
+                                    const std::vector<std::string>& other) {
+  std::vector<std::string> out;
+  std::set<std::string> in_out;
+  for (const std::string& id : winner) {
+    if (in_out.insert(id).second) {
+      out.push_back(id);
+    }
+  }
+  for (size_t i = 0; i < other.size(); ++i) {
+    const std::string& id = other[i];
+    if (in_out.contains(id)) {
+      continue;
+    }
+    // The nearest id before it in `other` that the result holds.
+    auto place = out.end();
+    for (size_t j = i; j > 0; --j) {
+      const auto found = std::ranges::find(out, other[j - 1]);
+      if (found != out.end()) {
+        place = found + 1;
+        break;
+      }
+    }
+    out.insert(place, id);
+    in_out.insert(id);
+  }
+  return out;
+}
+
+bool MergeState(State& into, const State& peer) {
+  bool changed = false;
+  for (const auto& [id, record] : peer.records) {
+    auto it = into.records.find(id);
+    if (it == into.records.end()) {
+      into.records.emplace(id, record);
+      changed = true;
+      continue;
+    }
+    changed |= MergeRecord(it->second, record);
+  }
+  for (const auto& [container, list] : peer.lists) {
+    auto it = into.lists.find(container);
+    if (it == into.lists.end()) {
+      into.lists.emplace(container, list);
+      changed = true;
+      continue;
+    }
+    if (it->second.s < list.s) {
+      std::vector<std::string> order = MergeOrder(list.order, it->second.order);
+      it->second.order = std::move(order);
+      it->second.s = list.s;
+      changed = true;
+    } else {
+      std::vector<std::string> order = MergeOrder(it->second.order, list.order);
+      if (order != it->second.order) {
+        it->second.order = std::move(order);
+        changed = true;
+      }
+    }
+  }
+  for (const auto& [from, to] : peer.aliases) {
+    auto it = into.aliases.find(from);
+    if (it == into.aliases.end()) {
+      into.aliases.emplace(from, to);
+      changed = true;
+    } else if (to < it->second) {
+      it->second = to;
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+Batch::Batch() = default;
+Batch::Batch(const Batch& other) = default;
+Batch& Batch::operator=(const Batch& other) = default;
+Batch::~Batch() = default;
+
+bool Batch::empty() const {
+  return added.empty() && removed.empty() && changed.empty() &&
+         reordered.empty();
+}
+
+Batch Diff(const State& before, const State& after) {
+  Batch batch;
+  for (const auto& [id, record] : after.records) {
+    const Record* const was = before.FindAlive(id);
+    if (record.Alive() && !was) {
+      batch.added.push_back(id);
+      continue;
+    }
+    if (!record.Alive() && was) {
+      batch.removed.push_back(id);
+      if (record.kind == Kind::kSpace) {
+        ++batch.removed_spaces;
+      } else if (record.kind == Kind::kTab) {
+        ++batch.removed_tabs;
+      }
+      continue;
+    }
+    if (!record.Alive() || !was) {
+      continue;
+    }
+    for (const auto& [name, field] : record.f) {
+      if (was->Get(name) != field.v) {
+        batch.changed[id].insert(name);
+      }
+    }
+  }
+  for (const auto& [container, list] : after.lists) {
+    const auto it = before.lists.find(container);
+    if (it != before.lists.end() && it->second.s != list.s) {
+      batch.reordered.push_back(container);
+    }
+  }
+  return batch;
+}
+
+bool ShouldHold(const Batch& batch, const State& before) {
+  if (batch.removed_spaces > 0 || batch.removed.size() >= kHoldRemovals ||
+      batch.added.size() > kHoldAdditions) {
+    return true;
+  }
+  const size_t pins = before.AliveTabCount();
+  return batch.removed_tabs > 0 && batch.removed_tabs * 3 >= pins;
+}
+
+bool ClockFarAhead(int64_t written_ms, int64_t now_ms) {
+  // Not `written_ms - now_ms`: State::MaxTime() of an empty state is the
+  // smallest int64_t, and the difference would overflow.
+  return written_ms > now_ms + kSkewLimitMs;
+}
+
+std::map<std::string, std::string> ResolveAliases(
+    const std::map<std::string, std::string>& aliases) {
+  // Union-find over every id an alias names; each set's smallest id wins.
+  std::map<std::string, std::string> parent;
+  std::function<std::string(const std::string&)> find =
+      [&](const std::string& id) -> std::string {
+    auto it = parent.find(id);
+    if (it == parent.end()) {
+      parent[id] = id;
+      return id;
+    }
+    if (it->second == id) {
+      return id;
+    }
+    const std::string root = find(it->second);
+    parent[id] = root;
+    return root;
+  };
+  for (const auto& [from, to] : aliases) {
+    const std::string a = find(from);
+    const std::string b = find(to);
+    if (a == b) {
+      continue;
+    }
+    if (a < b) {
+      parent[b] = a;
+    } else {
+      parent[a] = b;
+    }
+  }
+  std::map<std::string, std::string> resolved;
+  for (const auto& [id, unused] : std::map<std::string, std::string>(parent)) {
+    const std::string root = find(id);
+    if (root != id) {
+      resolved[id] = root;
+    }
+  }
+  return resolved;
+}
+
+std::string Canonical(const std::map<std::string, std::string>& resolved,
+                      const std::string& id) {
+  if (const auto it = resolved.find(id); it != resolved.end()) {
+    return it->second;
+  }
+  const std::string space = SpaceOfList(id);
+  if (!space.empty()) {
+    const auto it = resolved.find(space);
+    if (it != resolved.end()) {
+      return std::string(kSpacePrefix) + it->second +
+             id.substr(std::string_view(kSpacePrefix).size() + space.size());
+    }
+  }
+  return id;
+}
+
+State Canonicalize(const State& state,
+                   const std::map<std::string, std::string>& resolved) {
+  if (resolved.empty()) {
+    return state;
+  }
+  State out;
+  out.aliases = state.aliases;
+  for (const auto& [id, record] : state.records) {
+    Record copy = record;
+    if (auto parent = copy.f.find(kFieldParent); parent != copy.f.end()) {
+      parent->second.v = Canonical(resolved, parent->second.v);
+    }
+    const std::string key = Canonical(resolved, id);
+    auto it = out.records.find(key);
+    if (it == out.records.end()) {
+      out.records.emplace(key, std::move(copy));
+    } else {
+      MergeRecord(it->second, copy);
+    }
+  }
+  for (const auto& [container, list] : state.lists) {
+    List copy;
+    copy.s = list.s;
+    std::set<std::string> seen;
+    for (const std::string& id : list.order) {
+      std::string key = Canonical(resolved, id);
+      if (seen.insert(key).second) {
+        copy.order.push_back(std::move(key));
+      }
+    }
+    const std::string key = Canonical(resolved, container);
+    auto it = out.lists.find(key);
+    if (it == out.lists.end()) {
+      out.lists.emplace(key, std::move(copy));
+    } else if (it->second.s < copy.s) {
+      copy.order = MergeOrder(copy.order, it->second.order);
+      it->second = std::move(copy);
+    } else {
+      it->second.order = MergeOrder(it->second.order, copy.order);
+    }
+  }
+  return out;
+}
+
+LocalView CanonicalView(const LocalView& view,
+                        const std::map<std::string, std::string>& resolved) {
+  if (resolved.empty()) {
+    return view;
+  }
+  LocalView out;
+  for (const auto& [id, item] : view.items) {
+    LocalItem copy = item;
+    if (auto parent = copy.fields.find(kFieldParent);
+        parent != copy.fields.end()) {
+      parent->second = Canonical(resolved, parent->second);
+    }
+    out.items.try_emplace(Canonical(resolved, id), copy);
+  }
+  for (const auto& [container, order] : view.lists) {
+    std::vector<std::string>& list = out.lists[Canonical(resolved, container)];
+    for (const std::string& id : order) {
+      std::string key = Canonical(resolved, id);
+      if (std::ranges::find(list, key) == list.end()) {
+        list.push_back(std::move(key));
+      }
+    }
+  }
+  return out;
+}
+
+Pair::Pair() = default;
+Pair::Pair(const Pair& other) = default;
+Pair& Pair::operator=(const Pair& other) = default;
+Pair::~Pair() = default;
+
+namespace {
+
+// Pairs the children of two paired containers, folders recursing.
+void PairChildren(const State& local,
+                  const State& peers,
+                  const std::string& local_container,
+                  const std::string& peer_container,
+                  bool essentials,
+                  std::vector<Pair>* pairs) {
+  const auto tabs_of = [](const State& state, const std::string& container) {
+    std::vector<std::string> ids;
+    for (const std::string& id : state.ChildrenOf(container)) {
+      if (state.records.at(id).kind == Kind::kTab) {
+        ids.push_back(id);
+      }
+    }
+    return ids;
+  };
+  const auto folders_of = [](const State& state,
+                             const std::string& container) {
+    std::vector<std::string> ids;
+    for (const std::string& id : state.ChildrenOf(container)) {
+      if (state.records.at(id).kind == Kind::kFolder) {
+        ids.push_back(id);
+      }
+    }
+    return ids;
+  };
+  // An essential pairs by its home; a pin by its home and its own name.
+  const auto tab_key = [essentials](const State& state) {
+    return [records = &state.records,
+            essentials](const std::string& id) -> std::string {
+      const Record& record = records->at(id);
+      if (record.Get(kFieldHome).empty()) {
+        return std::string();
+      }
+      return essentials ? record.Get(kFieldHome)
+                        : record.Get(kFieldHome) + "\n" +
+                              record.Get(kFieldName);
+    };
+  };
+  const std::map<std::string, std::string> local_tabs =
+      UniqueByKey(tabs_of(local, local_container), tab_key(local));
+  const std::map<std::string, std::string> peer_tabs =
+      UniqueByKey(tabs_of(peers, peer_container), tab_key(peers));
+  for (const auto& [key, local_id] : local_tabs) {
+    const auto peer = peer_tabs.find(key);
+    if (peer == peer_tabs.end() || peer->second == local_id) {
+      continue;
+    }
+    Pair pair;
+    pair.local_id = local_id;
+    pair.peer_id = peer->second;
+    pair.kind = Kind::kTab;
+    const Record& record = local.records.at(local_id);
+    pair.label = record.Get(kFieldName).empty() ? record.Get(kFieldHome)
+                                                : record.Get(kFieldName);
+    pairs->push_back(std::move(pair));
+  }
+  if (essentials) {
+    return;
+  }
+  const auto title_key = [](const State& state) {
+    return [records = &state.records](const std::string& id) {
+      return PairingName(records->at(id).Get(kFieldTitle));
+    };
+  };
+  const std::map<std::string, std::string> local_folders =
+      UniqueByKey(folders_of(local, local_container), title_key(local));
+  const std::map<std::string, std::string> peer_folders =
+      UniqueByKey(folders_of(peers, peer_container), title_key(peers));
+  for (const auto& [key, local_id] : local_folders) {
+    const auto peer = peer_folders.find(key);
+    if (peer == peer_folders.end() || peer->second == local_id) {
+      continue;
+    }
+    Pair pair;
+    pair.local_id = local_id;
+    pair.peer_id = peer->second;
+    pair.kind = Kind::kFolder;
+    pair.label = local.records.at(local_id).Get(kFieldTitle);
+    pairs->push_back(std::move(pair));
+    PairChildren(local, peers, local_id, peer->second, false, pairs);
+  }
+}
+
+}  // namespace
+
+std::vector<Pair> ProposePairs(const State& local, const State& peers) {
+  std::vector<Pair> pairs;
+  const auto spaces_of = [](const State& state, const State& other) {
+    std::vector<std::string> ids;
+    for (const auto& [id, record] : state.records) {
+      // Only an install's own Spaces: one both already share is no pair.
+      if (record.kind == Kind::kSpace && record.Alive() &&
+          !other.records.contains(id)) {
+        ids.push_back(id);
+      }
+    }
+    return ids;
+  };
+  const auto name_key = [](const State& state) {
+    return [records = &state.records](const std::string& id) {
+      return PairingName(records->at(id).Get(kFieldName));
+    };
+  };
+  const std::map<std::string, std::string> local_spaces =
+      UniqueByKey(spaces_of(local, peers), name_key(local));
+  const std::map<std::string, std::string> peer_spaces =
+      UniqueByKey(spaces_of(peers, local), name_key(peers));
+  for (const auto& [key, local_id] : local_spaces) {
+    const auto peer = peer_spaces.find(key);
+    if (peer == peer_spaces.end()) {
+      continue;
+    }
+    Pair pair;
+    pair.local_id = local_id;
+    pair.peer_id = peer->second;
+    pair.kind = Kind::kSpace;
+    pair.label = local.records.at(local_id).Get(kFieldName);
+    pairs.push_back(std::move(pair));
+    PairChildren(local, peers, PinsListOf(local_id), PinsListOf(peer->second),
+                 false, &pairs);
+    PairChildren(local, peers, OwnEssentialsListOf(local_id),
+                 OwnEssentialsListOf(peer->second), true, &pairs);
+  }
+  PairChildren(local, peers, kEssentialsList, kEssentialsList, true, &pairs);
+  return pairs;
+}
+
+std::map<std::string, std::string> AliasesFor(
+    const std::vector<Pair>& accepted) {
+  std::map<std::string, std::string> aliases;
+  for (const Pair& pair : accepted) {
+    if (pair.local_id == pair.peer_id) {
+      continue;
+    }
+    // Not `small`: Windows headers define it as a macro.
+    const auto [lower, higher] = std::minmax(pair.local_id, pair.peer_id);
+    aliases[higher] = lower;
+  }
+  return aliases;
+}
+
+bool PruneTombstones(State& state,
+                     const std::map<std::string, int64_t>& received,
+                     int64_t now_ms,
+                     const std::set<std::string>& held) {
+  const size_t before = state.records.size();
+  std::erase_if(state.records, [&](const auto& entry) {
+    const auto& [id, record] = entry;
+    if (record.Alive() || held.contains(id)) {
+      return false;
+    }
+    const auto when = received.find(id);
+    return when != received.end() && now_ms - when->second > kTombstoneKeepMs;
+  });
+  return state.records.size() != before;
+}
+
+bool MoveEssentialsPastTheCap(State& state, const Stamp& stamp) {
+  const std::vector<std::string> row = state.ChildrenOf(kEssentialsList);
+  if (row.size() <= kEssentialsCap) {
+    return false;
+  }
+  // The first Space in the list's order that is alive.
+  std::string first;
+  if (const auto it = state.lists.find(kSpacesList); it != state.lists.end()) {
+    for (const std::string& id : it->second.order) {
+      const Record* const record = state.FindAlive(id);
+      if (record && record->kind == Kind::kSpace) {
+        first = id;
+        break;
+      }
+    }
+  }
+  if (first.empty()) {
+    for (const auto& [id, record] : state.records) {
+      if (record.kind == Kind::kSpace && record.Alive()) {
+        first = id;
+        break;
+      }
+    }
+  }
+  if (first.empty()) {
+    return false;
+  }
+  const std::string pins = PinsListOf(first);
+  List& run = state.lists[pins];
+  for (size_t i = kEssentialsCap; i < row.size(); ++i) {
+    state.records[row[i]].f[kFieldParent] = Field{pins, stamp};
+    if (std::ranges::find(run.order, row[i]) == run.order.end()) {
+      run.order.push_back(row[i]);
+    }
+  }
+  run.s = std::max(run.s, stamp);
+  return true;
+}
+
+base::DictValue StateToValue(const State& state) {
+  base::DictValue records;
+  for (const auto& [id, record] : state.records) {
+    base::DictValue entry;
+    // Unknown keys first, so a known key always wins (Sf34).
+    for (const auto& [key, json] : record.x) {
+      if (std::optional<base::Value> value =
+              base::JSONReader::Read(json, base::JSON_PARSE_RFC)) {
+        entry.Set(key, std::move(*value));
+      }
+    }
+    entry.Set("k", KindName(record.kind));
+    base::DictValue fields;
+    for (const auto& [name, field] : record.f) {
+      base::ListValue triple;
+      triple.Append(field.v);
+      triple.Append(static_cast<double>(field.s.t));
+      triple.Append(field.s.w);
+      fields.Set(name, std::move(triple));
+    }
+    entry.Set("f", std::move(fields));
+    if (record.del) {
+      entry.Set("del", StampToList(*record.del));
+    }
+    records.Set(id, std::move(entry));
+  }
+  base::DictValue lists;
+  for (const auto& [container, list] : state.lists) {
+    base::DictValue entry;
+    base::ListValue order;
+    for (const std::string& id : list.order) {
+      order.Append(id);
+    }
+    entry.Set("order", std::move(order));
+    entry.Set("t", static_cast<double>(list.s.t));
+    entry.Set("w", list.s.w);
+    lists.Set(container, std::move(entry));
+  }
+  base::DictValue aliases;
+  for (const auto& [from, to] : state.aliases) {
+    aliases.Set(from, to);
+  }
+  base::DictValue out;
+  out.Set("records", std::move(records));
+  out.Set("lists", std::move(lists));
+  out.Set("aliases", std::move(aliases));
+  return out;
+}
+
+std::optional<State> StateFromValue(const base::DictValue& value) {
+  State state;
+  const base::DictValue* const records = value.FindDict("records");
+  const base::DictValue* const lists = value.FindDict("lists");
+  if (!records || !lists) {
+    return std::nullopt;
+  }
+  for (const auto [id, entry_value] : *records) {
+    const base::DictValue* const entry = entry_value.GetIfDict();
+    if (!entry || id.empty()) {
+      return std::nullopt;
+    }
+    const std::string* const kind_name = entry->FindString("k");
+    const std::optional<Kind> kind =
+        kind_name ? KindFromName(*kind_name) : std::nullopt;
+    const base::DictValue* const fields = entry->FindDict("f");
+    if (!kind || !fields) {
+      return std::nullopt;
+    }
+    Record record(*kind);
+    for (const auto [name, triple] : *fields) {
+      const base::ListValue* const list = triple.GetIfList();
+      if (!list || list->size() != 3 || !(*list)[0].is_string()) {
+        return std::nullopt;
+      }
+      const std::optional<Stamp> stamp = StampFrom(triple, 1);
+      if (!stamp) {
+        return std::nullopt;
+      }
+      record.f[name] = Field{(*list)[0].GetString(), *stamp};
+    }
+    if (const base::Value* const del = entry->Find("del")) {
+      record.del = StampFrom(*del, 0);
+      if (!record.del) {
+        return std::nullopt;
+      }
+    }
+    for (const auto [key, unknown] : *entry) {
+      if (key == "k" || key == "f" || key == "del") {
+        continue;
+      }
+      std::string json;
+      if (base::JSONWriter::Write(unknown, &json)) {
+        record.x[key] = std::move(json);
+      }
+    }
+    state.records.emplace(id, std::move(record));
+  }
+  for (const auto [container, entry_value] : *lists) {
+    const base::DictValue* const entry = entry_value.GetIfDict();
+    const base::ListValue* const order =
+        entry ? entry->FindList("order") : nullptr;
+    const base::Value* const t = entry ? entry->Find("t") : nullptr;
+    const std::string* const w = entry ? entry->FindString("w") : nullptr;
+    const std::optional<int64_t> time = t ? TimeFrom(*t) : std::nullopt;
+    if (!order || !time || !w) {
+      return std::nullopt;
+    }
+    List list;
+    list.s = Stamp{*time, *w};
+    for (const base::Value& id : *order) {
+      if (!id.is_string()) {
+        return std::nullopt;
+      }
+      list.order.push_back(id.GetString());
+    }
+    state.lists.emplace(container, std::move(list));
+  }
+  if (const base::DictValue* const aliases = value.FindDict("aliases")) {
+    for (const auto [from, to] : *aliases) {
+      if (!to.is_string()) {
+        return std::nullopt;
+      }
+      state.aliases[from] = to.GetString();
+    }
+  }
+  return state;
+}
