@@ -0,0 +1,37 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/address_row.h"
+
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/prefs/pref_service.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding {
+namespace {
+
+using AddressRowTest = BrowserWithTestWindowTest;
+
+// T10, T12: a normal window has the controller; the toggle overrides the
+// rule until the sidebar changes, and the setting off shows the row.
+TEST_F(AddressRowTest, ToggleOverridesUntilTheSidebarChanges) {
+  AddressRow* const row = AddressRow::From(browser());
+  ASSERT_TRUE(row);
+  EXPECT_TRUE(row->IsVisible()) << "expanded sidebar: shown";
+  EXPECT_FALSE(row->override_for_testing().has_value());
+  row->Toggle();
+  EXPECT_FALSE(row->IsVisible());
+  EXPECT_EQ(false, row->override_for_testing());
+  row->Toggle();
+  EXPECT_TRUE(row->IsVisible());
+  EXPECT_EQ(true, row->override_for_testing());
+  profile()->GetPrefs()->SetBoolean(prefs::kToolbarHideWithSidebar, false);
+  row->Toggle();
+  EXPECT_FALSE(row->IsVisible()) << "T12: the toggle still works";
+}
+
+}  // namespace
+}  // namespace stedding
