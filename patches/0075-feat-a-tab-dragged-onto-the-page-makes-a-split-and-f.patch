+// GitHub issue 7, splits J10-J11: with vertical tabs off, a tab of the
+// horizontal strip dropped on the page makes the same split, the half lit
+// on the way.
+IN_PROC_BROWSER_TEST_F(TabDropTest, AHorizontalTabDroppedOnThePageMakesASplit) {
+  tabs::TabInterface* const dragged = Open("horizontal-dragged.test");
+  tabs::TabInterface* const shown = Open("horizontal-shown.test");
+  ExitVerticalTabsMode();
+  ASSERT_FALSE(
+      vertical_tab_strip_state_controller()->ShouldDisplayVerticalTabs());
+  TabStrip* const strip = browser_view()->horizontal_tab_strip_for_testing();
+  ASSERT_TRUE(strip);
+  views::test::RunScheduledLayout(widget());
+  Tab* const tab = strip->tab_at(Index(dragged));
+  ASSERT_TRUE(tab && tab->IsDrawn());
+  spaces::PageSplitDragTarget* const target =
+      spaces::PageSplitDragTarget::From(browser());
+  ASSERT_TRUE(target);
+  const PageHalves halves = HalvesOf(browser_view());
+  const Kept kept = KeptOf(dragged);
+
+  PressAndMove(tab->GetBoundsInScreen().CenterPoint(), halves.right);
+  EXPECT_EQ(stedding::SplitDropSide::kEnd, target->lit_side());
+  EXPECT_FALSE(target->GetHighlightBoundsInScreenForTesting().IsEmpty());
+  EXPECT_EQ(shown, tab_strip_model()->GetActiveTab());
+  EXPECT_EQ(1u, WindowCount()) << "a window tore off over the page";
+  Release(halves.right);
+  ASSERT_TRUE(base::test::RunUntil([&]() { return dragged->IsSplit(); }))
+      << "the drop made no split";
+  EXPECT_EQ(dragged->GetSplit(), shown->GetSplit());
+  EXPECT_EQ(shown,
+            tab_strip_model()->GetSplitData(*shown->GetSplit())->ListTabs()[0]);
+  EXPECT_EQ(dragged, tab_strip_model()->GetActiveTab());
+  ExpectKept(dragged, kept);
+  EXPECT_EQ(1u, WindowCount());
+  EnterVerticalTabsMode();
+}
