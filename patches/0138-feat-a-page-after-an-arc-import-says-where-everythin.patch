+// import I47: every way into an import ends here, once, so each opens the
+// page once: what the page will say is written first.
+void FinishImport(base::WeakPtr<BrowserWindowInterface> browser,
+                  ArcImportDoneCallback done,
+                  std::optional<ArcImportResult> result) {
+  if (browser && result) {
+    base::DictValue last;
+    last.Set("routes", static_cast<int>(result->routes));
+    last.Set("routes_left_out", static_cast<int>(result->routes_left_out));
+    browser->GetProfile()->GetPrefs()->SetDict(
+        stedding::prefs::kArcLastImport, std::move(last));
+    ShowFromArcPage(browser.get());
+  }
+  std::move(done).Run(result);
+}
+
 }  // namespace
 
+void ShowFromArcPage(BrowserWindowInterface* browser) {
+  TabStripModel* const tabs = browser->GetTabStripModel();
+  const GURL page(kFromArcPage);
+  for (int i = 0; i < tabs->count(); ++i) {
+    tabs::TabInterface* const tab = tabs->GetTabAtIndex(i);
+    if (tab->GetContents()->GetVisibleURL() != page) {
+      continue;
+    }
+    if (SpaceModel* const model = SpaceModel::From(browser)) {
+      model->SetActiveSpace(model->SpaceForTab(tab), tab);
+    }
+    tabs->ActivateTabAt(tabs->GetIndexOfTab(tab));
+    tab->GetContents()->GetController().Reload(content::ReloadType::NORMAL,
+                                               /*check_for_repost=*/false);
+    return;
+  }
+  browser->OpenGURL(page, WindowOpenDisposition::NEW_FOREGROUND_TAB);
+}
+
