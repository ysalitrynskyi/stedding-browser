new file mode 100644
index 0000000000000..1f4d5d9daeb33
--- /dev/null
+++ b/chrome/browser/ui/stedding/tab_parents.h
@@ -0,0 +1,97 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_STEDDING_TAB_PARENTS_H_
+#define CHROME_BROWSER_UI_STEDDING_TAB_PARENTS_H_
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+class BrowserWindowInterface;
+class TabStripModel;
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace tabs {
+class TabInterface;
+}  // namespace tabs
+
+namespace stedding {
+
+// Child tabs (docs/features/tabs.md R56-R60): a tab opened from a link in
+// another tab sits indented under it in the sidebar. Each tab that has
+// children gets a token of its own, and each child keeps its parent's token;
+// both ride on the WebContents and are written to the session as per-tab
+// extra data, so the tree survives a restart.
+inline constexpr char kSessionTabTokenKey[] = "stedding.tab_token";
+inline constexpr char kSessionTabParentKey[] = "stedding.parent";
+
+// The deepest a row nests, folders and children together (R57).
+inline constexpr int kMaxNestDepth = 5;
+
+// The tab's own token, empty while it has never had a child.
+std::string TabToken(const content::WebContents* contents);
+
+// The token of the tab `contents` was opened from, empty for a tab with no
+// parent.
+std::string TabParentToken(const content::WebContents* contents);
+
+// R56: the tab a tab inserted into `model` at `index` is a child of, or null:
+// the page whose own window.open made it, or the tab a link was opened from
+// in a new tab; not for a new tab, a bookmark, a duplicate or a drop, and
+// never an essential's or for an essential.
+tabs::TabInterface* ParentOfNewTab(const TabStripModel& model, int index);
+
+// Makes `child` a child of `parent`, giving `parent` a token when it has none,
+// and writes both to the session.
+void SetTabParent(BrowserWindowInterface* browser,
+                  tabs::TabInterface* child,
+                  tabs::TabInterface* parent);
+
+// R59: when a parent closes, each of its children takes the parent's own
+// parent, or none, and moves up a level in its place. `closed` is the closing
+// parent's contents, still alive while the strip reports the removal. The
+// session learns the new places with its next rewrite.
+void ReparentChildrenOf(BrowserWindowInterface* browser,
+                        const content::WebContents* closed);
+
+// sessions S9: the tokens ride on the WebContents, so when a tab's contents
+// are replaced (a jar change, a pin's reset) they move to the new ones.
+void CarryTabParent(content::WebContents* from, content::WebContents* to);
+
+// Session restore: adopt the tokens stored with a restored tab, if any.
+void RestoreTabParentFromExtraData(
+    content::WebContents* contents,
+    const std::map<std::string, std::string>& extra_data);
+
+// Registers the session-rebuild provider once per process
+// (chrome/browser/sessions/stedding_session_rebuild.h).
+void RegisterTabParentSessionRebuild();
+
+// One row of the sidebar, in the order drawn, for NestDepths.
+struct NestRow {
+  // The row's own token and its parent's, empty when it has none.
+  std::string token;
+  std::string parent;
+  // Names the collection the row sits in (the strip's own, or a folder): a
+  // child nests only beside its parent, in the same one.
+  uintptr_t run = 0;
+  // The deepest the row may nest: kMaxNestDepth less its folders.
+  int limit = 0;
+};
+
+// R57: the depth each row is drawn at under its parent, in order. A row
+// nests one level under its parent while every row between them descends
+// from the parent too, in the same run; a row moved away from its parent, a
+// parent closed or in another run, puts it back at the left. A row at its
+// limit has its children beside it, at the same depth.
+std::vector<int> NestDepths(const std::vector<NestRow>& rows);
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_STEDDING_TAB_PARENTS_H_
