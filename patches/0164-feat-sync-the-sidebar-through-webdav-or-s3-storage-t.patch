+class SidebarSyncPlaceTestBase : public InProcessBrowserTest,
+                                 public testing::WithParamInterface<PlaceKind> {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    place_ = std::make_unique<FakePlace>(GetParam());
+    server_.RegisterRequestHandler(base::BindRepeating(
+        &AnswerWith, base::Unretained(place_.get()), base::Unretained(&hang_)));
+    ASSERT_TRUE(server_.Start());
+  }
+
+  void TearDownOnMainThread() override {
+    sb::PlaceClient::SetTimeoutForTesting(sb::kPlaceRequestTimeout);
+    if (service()->enabled() && !keep_syncing_) {
+      service()->Stop(/*remove_own_file=*/false);
+    }
+    ASSERT_TRUE(server_.ShutdownAndWaitUntilComplete());
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
+
+  spaces::SidebarSyncService* service() {
+    return spaces::SidebarSyncServiceFactory::GetForProfile(
+        browser()->GetProfile());
+  }
+
+  PrefService* prefs() { return browser()->GetProfile()->GetPrefs(); }
+
+  base::DictValue Test(const std::string& secret = FakePlace::kSecret) {
+    base::test::TestFuture<base::DictValue> answer;
+    service()->TestPlace(place_->Form(server_.base_url(), secret),
+                         answer.GetCallback());
+    return answer.Take();
+  }
+
+  std::string Failure(const base::DictValue& answer) {
+    const std::string* const failure = answer.FindString("failure");
+    return failure ? *failure : std::string();
+  }
+
+  void Join() {
+    const base::DictValue answer = Test();
+    ASSERT_EQ(Failure(answer), "");
+    ASSERT_TRUE(service()->ConfirmJoin(/*combine=*/true, "This one", {}));
+    ASSERT_TRUE(base::test::RunUntil([&] { return service()->enabled(); }));
+    ASSERT_TRUE(base::test::RunUntil([&] {
+      return place_->Files().contains(OwnName());
+    }));
+  }
+
+  std::string OwnName() {
+    return sb::FileNameFor(
+        prefs()->GetString(stedding::prefs::kSidebarSyncInstallId));
+  }
+
+  void Scan() {
+    base::test::TestFuture<void> done;
+    service()->ScanForTesting(done.GetCallback());
+    ASSERT_TRUE(done.Wait());
+  }
+
+  std::string Problem() {
+    const base::DictValue status = service()->GetStatus();
+    const std::string* const problem = status.FindString("problem");
+    return problem ? *problem : std::string();
+  }
+
+  bool LedgerHasSpaceNamed(const std::string& name) {
+    const sb::Ledger* const ledger = service()->ledger_for_testing();
+    if (!ledger) {
+      return false;
+    }
+    for (const auto& [id, record] : ledger->state.records) {
+      if (record.kind == sb::Kind::kSpace &&
+          record.Get(sb::kFieldName) == name) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  net::EmbeddedTestServer server_;
+  std::unique_ptr<FakePlace> place_;
+  bool hang_ = false;
+  // A PRE_ test leaves sync on for the next run.
+  bool keep_syncing_ = false;
+};
