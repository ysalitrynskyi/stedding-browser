new file mode 100644
index 0000000000000..ae9a002562710
--- /dev/null
+++ b/chrome/browser/ui/views/stedding/update_pill_unittest.cc
@@ -0,0 +1,124 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/stedding/update_pill.h"
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "chrome/browser/ui/stedding/fake_app_updater.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/base/models/image_model.h"
+#include "ui/events/base_event_utils.h"
+#include "ui/events/event.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/views/accessibility/view_accessibility.h"
+#include "ui/views/test/views_test_base.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace stedding {
+namespace {
+
+using State = AppUpdater::State;
+
+class UpdatePillTest : public views::ViewsTestBase {
+ protected:
+  void SetUp() override {
+    views::ViewsTestBase::SetUp();
+    widget_ = CreateTestWidget(views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+    sidebar_ = widget_->SetContentsView(std::make_unique<views::View>());
+    pill_ = AddUpdatePill(*sidebar_);
+    widget_->Show();
+  }
+
+  void TearDown() override {
+    pill_ = nullptr;
+    sidebar_ = nullptr;
+    widget_.reset();
+    views::ViewsTestBase::TearDown();
+  }
+
+  void Click() {
+    const gfx::Point center = pill_->GetLocalBounds().CenterPoint();
+    pill_->OnMousePressed(ui::MouseEvent(
+        ui::EventType::kMousePressed, center, center, ui::EventTimeForNow(),
+        ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON));
+    pill_->OnMouseReleased(ui::MouseEvent(
+        ui::EventType::kMouseReleased, center, center, ui::EventTimeForNow(),
+        ui::EF_LEFT_MOUSE_BUTTON, ui::EF_LEFT_MOUSE_BUTTON));
+  }
+
+  bool HasIcon() {
+    const std::optional<ui::ImageModel>& image =
+        pill_->GetImageModel(views::Button::STATE_NORMAL);
+    return image && !image->IsEmpty();
+  }
+
+  // Constructed before the widget, so it outlives the pill that watches it.
+  FakeAppUpdater updater_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::View> sidebar_ = nullptr;
+  raw_ptr<UpdatePill> pill_ = nullptr;
+};
+
+// updates Up3: the pill shows Arc's words while a version waits, and only
+// then; a click restarts into it.
+TEST_F(UpdatePillTest, ShowsWhileAVersionWaitsAndRestartsOnClick) {
+  ASSERT_TRUE(pill_);
+  EXPECT_EQ(pill_, FindUpdatePill(*sidebar_));
+  for (const State state : {State::kIdle, State::kChecking, State::kUpToDate,
+                            State::kDownloading, State::kFailed}) {
+    updater_.Set(state);
+    EXPECT_FALSE(pill_->GetVisible()) << static_cast<int>(state);
+  }
+  updater_.Set(State::kReady, u"0.2.0-beta.16");
+  EXPECT_TRUE(pill_->GetVisible());
+  EXPECT_TRUE(pill_->GetEnabled());
+  EXPECT_EQ(u"New Stedding Version Available", pill_->GetText());
+  EXPECT_EQ(u"Restart to update Stedding to 0.2.0-beta.16",
+            pill_->GetRenderedTooltipText(gfx::Point()));
+  pill_->SetBoundsRect(gfx::Rect(0, 0, 220, 36));
+  Click();
+  EXPECT_EQ(1, updater_.installs);
+}
+
+// updates Up4: a version whose install waits for the go-ahead shows the same
+// pill; restarting shows it greyed until the browser quits.
+TEST_F(UpdatePillTest, AvailableShowsThePillAndInstallingGreysIt) {
+  updater_.Set(State::kAvailable);
+  EXPECT_TRUE(pill_->GetVisible());
+  EXPECT_TRUE(pill_->GetEnabled());
+  updater_.Set(State::kInstalling);
+  EXPECT_TRUE(pill_->GetVisible());
+  EXPECT_FALSE(pill_->GetEnabled());
+  EXPECT_EQ(u"Restarting…", pill_->GetText());
+}
+
+// updates Up3: the rail draws the icon alone and names the pill for
+// VoiceOver; the open sidebar gets the words back.
+TEST_F(UpdatePillTest, TheRailShowsTheIconAlone) {
+  updater_.Set(State::kReady);
+  pill_->SetRailForm(true);
+  EXPECT_TRUE(pill_->GetText().empty());
+  EXPECT_TRUE(HasIcon());
+  EXPECT_EQ(u"Restart to update Stedding",
+            pill_->GetViewAccessibility().GetCachedName());
+  pill_->SetRailForm(false);
+  EXPECT_EQ(u"New Stedding Version Available", pill_->GetText());
+  EXPECT_FALSE(HasIcon());
+}
+
+// No updater, no pill: Windows, a build without Sparkle.
+TEST_F(UpdatePillTest, NoUpdaterNoPill) {
+  AppUpdater::SetForTesting(nullptr);
+  views::View other;
+  EXPECT_FALSE(AddUpdatePill(other));
+  EXPECT_FALSE(FindUpdatePill(other));
+  AppUpdater::SetForTesting(&updater_);
+}
+
+}  // namespace
+}  // namespace stedding
