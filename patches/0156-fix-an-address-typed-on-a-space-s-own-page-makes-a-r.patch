+// tabs R66, copy-link L9 (BACKLOG S-470): a Space's own page shows no
+// address, so Copy Link has nothing to copy there. It had put
+// chrome://stedding-space/ on the clipboard and said "Link copied"; the
+// clipboard now keeps what it held and no toast shows.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, ASpacesPageHasNoLinkToCopy) {
+  ui::TestClipboard::CreateForCurrentThread();
+  const spaces::SpaceId empty = model().AddSpace("Empty", SK_ColorGREEN)->id();
+  ASSERT_TRUE(model().SetActiveSpace(empty));
+  tabs::TabInterface* const page = tabs().GetActiveTab();
+  ASSERT_TRUE(stedding::IsEmptySpaceStandIn(page)) << "a New Tab opened";
+  ASSERT_TRUE(content::WaitForLoadStop(page->GetContents()));
+  ToastController* const toasts = ToastController::From(browser());
+  ASSERT_TRUE(toasts);
+  for (const int command : {IDC_COPY_URL, IDC_STEDDING_COPY_MARKDOWN_LINK}) {
+    ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+        .WriteText(u"held");
+    chrome::ExecuteCommand(browser(), command);
+    base::test::TestFuture<std::u16string> text;
+    ui::Clipboard::GetForCurrentThread()->ReadText(
+        ui::ClipboardBuffer::kCopyPaste, /*data_dst=*/std::nullopt,
+        text.GetCallback());
+    EXPECT_EQ(u"held", text.Get()) << "command " << command;
+    // A copy's toast comes up after the copy, not with it.
+    base::RunLoop wait;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, wait.QuitClosure(), base::Seconds(1));
+    wait.Run();
+    EXPECT_FALSE(toasts->IsShowingToast()) << "a toast after " << command;
+  }
+  ui::Clipboard::DestroyClipboardForCurrentThread();
+}
+
+// tabs R66: an address typed on a Space's own page makes the tab an ordinary
+// row. It stayed unlisted until the Space was left and shown again.
+IN_PROC_BROWSER_TEST_F(PinnedRunTest, AnAddressTypedOnTheSpacesPageMakesARow) {
+  const spaces::SpaceId empty = model().AddSpace("Empty", SK_ColorGREEN)->id();
+  ASSERT_TRUE(model().SetActiveSpace(empty));
+  tabs::TabInterface* const page = tabs().GetActiveTab();
+  ASSERT_TRUE(stedding::IsEmptySpaceStandIn(page)) << "a New Tab opened";
+  ASSERT_TRUE(content::WaitForLoadStop(page->GetContents()));
+  EXPECT_TRUE(base::test::RunUntil([&]() { return !RowShown(page); }))
+      << "the Space's page has a row";
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), GURL("data:text/html,<title>Typed</title>")));
+
+  EXPECT_FALSE(stedding::IsEmptySpaceStandIn(page));
+  EXPECT_EQ(page, tabs().GetActiveTab());
+  EXPECT_TRUE(base::test::RunUntil([&]() { return RowShown(page); }))
+      << "the page has no row until the Space is left";
+}
