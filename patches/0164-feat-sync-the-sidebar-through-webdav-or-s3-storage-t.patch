+// Sf47, Sf49: a passing test leads to the sheet, with no probe left and
+// nothing written; the sheet names the place, and Cancel leaves no trace.
+IN_PROC_BROWSER_TEST_P(SidebarSyncPlaceTest, ThePassingTestLeadsToTheSheet) {
+  const base::DictValue answer = Test();
+  EXPECT_EQ(Failure(answer), "");
+  ASSERT_TRUE(answer.FindString("dir"));
+  EXPECT_NE(answer.FindString("dir")->find(server_.base_url().host()),
+            std::string::npos);
+  EXPECT_NE(answer.FindString("dir")->find(
+                GetParam() == PlaceKind::kS3 ? FakePlace::kBucket : "dav"),
+            std::string::npos);
+  EXPECT_EQ(*answer.FindString("place"),
+            GetParam() == PlaceKind::kS3 ? "s3" : "webdav");
+  EXPECT_TRUE(place_->Files().empty());
+  EXPECT_FALSE(service()->enabled());
+  EXPECT_EQ(place_->HasFolder(), GetParam() == PlaceKind::kWebDav);
+
+  service()->CancelJoin();
+  // Sf49: a `Stedding Sidebar` the test made goes.
+  EXPECT_TRUE(
+      base::test::RunUntil([&] { return !place_->HasFolder(); }));
+  EXPECT_FALSE(service()->ConfirmJoin(true, "x", {}));
+  EXPECT_FALSE(service()->enabled());
+  EXPECT_TRUE(prefs()->GetDict(stedding::prefs::kSidebarSyncPlace).empty());
+  EXPECT_TRUE(
+      prefs()->GetString(stedding::prefs::kSidebarSyncPlaceSignIn).empty());
+}
