#!/usr/bin/env python3
"""Repository hygiene checks.

Everything here is a rule this project has already written down somewhere, turned
into something a machine can fail on:

  links    every relative markdown link resolves to a file that exists
  adrs     ADRs are numbered, unique, contiguous, and structurally complete
  paths    no absolute machine paths or personal data in tracked files
  ignored  nothing tracked that .gitignore says should not be
  patches  the patch series is contiguous, numbered, and each patch has a header
  version  the Chromium pin is well formed and referenced from exactly one place
  traps    HANDOFF's traps are numbered contiguously and every citation resolves
  tests    every test a 'built' behaviour row names exists in the patch series, and
           every test a spec row or BACKLOG cites is in a tooling/dev filter
  wiring   every source the series adds is in a GN sources list, so it compiles
  truth    docs carry no known-stale phrases, feature specs are well formed, and
           every backlog id cited anywhere exists in BACKLOG.md

Run: tooling/check-repo [check ...]     (no arguments: run everything)
Exit status is the number of failures, capped at 125.
"""

from __future__ import annotations

import fnmatch
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FAILURES: list[str] = []


def fail(where: str, message: str) -> None:
    FAILURES.append(f"{where}: {message}")


def tracked_files() -> list[Path]:
    out = subprocess.run(
        ["git", "-C", str(ROOT), "ls-files", "-z"],
        capture_output=True, text=True, check=True,
    ).stdout
    return [ROOT / p for p in out.split("\0") if p]


# --------------------------------------------------------------------------- links

LINK_RE = re.compile(r"\[[^\]]*\]\(([^)]+)\)")
# Code fences and inline code spans hold example paths and literal Markdown that are
# deliberately not links.
CODE_FENCE_RE = re.compile(r"```.*?```", re.DOTALL)
CODE_SPAN_RE = re.compile(r"`[^`\n]*`")


def check_links() -> None:
    for md in sorted(ROOT.rglob("*.md")):
        if ".git" in md.parts:
            continue
        text = CODE_SPAN_RE.sub("", CODE_FENCE_RE.sub("", md.read_text(encoding="utf-8")))
        for target in LINK_RE.findall(text):
            target = target.strip()
            if target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            path = (md.parent / target.split("#", 1)[0]).resolve()
            if not path.exists():
                fail(md.relative_to(ROOT).as_posix(), f"broken link -> {target}")


# ---------------------------------------------------------------------------- ADRs

ADR_NAME_RE = re.compile(r"^(\d{4})-[a-z0-9]+(?:-[a-z0-9]+)*\.md$")
ADR_TITLE_RE = re.compile(r"^# (\d{4}) — .+$")
ADR_SECTIONS = ("## Context", "## Decision", "## Consequences")


def check_adrs() -> None:
    adr_dir = ROOT / "docs" / "decisions"
    if not adr_dir.is_dir():
        return
    seen: dict[str, str] = {}
    for adr in sorted(adr_dir.glob("*.md")):
        if adr.name == "README.md":
            continue
        rel = adr.relative_to(ROOT).as_posix()
        m = ADR_NAME_RE.match(adr.name)
        if not m:
            fail(rel, "filename must be NNNN-short-slug.md (lowercase, hyphenated)")
            continue
        number = m.group(1)
        if number in seen:
            fail(rel, f"ADR number {number} already used by {seen[number]}")
        seen[number] = rel

        lines = adr.read_text(encoding="utf-8").splitlines()
        if not lines:
            fail(rel, "empty")
            continue

        title = ADR_TITLE_RE.match(lines[0])
        if not title:
            fail(rel, "first line must be '# NNNN — Title' (em dash)")
        elif title.group(1) != number:
            fail(rel, f"title says {title.group(1)} but the filename says {number}")

        head = "\n".join(lines[:8])
        if not re.search(r"^Status: \S", head, re.M):
            fail(rel, "missing 'Status:' line in the header")
        if not re.search(r"^Date: \d{4}-\d{2}-\d{2}$", head, re.M):
            fail(rel, "missing or malformed 'Date: YYYY-MM-DD' line")

        body = "\n".join(lines)
        for section in ADR_SECTIONS:
            if section not in body:
                fail(rel, f"missing section '{section}'")

    if seen:
        numbers = sorted(int(n) for n in seen)
        expected = list(range(1, len(numbers) + 1))
        if numbers != expected:
            missing = sorted(set(expected) - set(numbers))
            fail("docs/decisions", f"ADR numbering is not contiguous from 0001 (gaps: {missing})")


# --------------------------------------------------------------------------- paths

# This repository is public. AGENTS.md forbids machine-specific paths and personal
# operational data; these patterns are the mechanical part of that rule.
FORBIDDEN = [
    (re.compile(r"/Users/(?!<)[a-z][a-z0-9_.-]*/"), "absolute macOS home path"),
    (re.compile(r"/home/(?!<)[a-z][a-z0-9_.-]*/"), "absolute Linux home path"),
    # Over-escaped once: r"C:\\\\Users\\\\" is the regex C:\\Users\\, which matches a
    # DOUBLED backslash and so never fired on an actual path. Verified against
    # C:\Users\<name> and against a JSON-escaped C:\\Users\\<name>, which also
    # occurs. The placeholder form is what a document is allowed to write, and it is
    # why this comment does not trip its own check.
    (re.compile(r"[Cc]:\\{1,2}[Uu]sers\\{1,2}[A-Za-z]"), "absolute Windows home path"),
    # The owner's own layout of their machine; a document names a placeholder.
    # Split so this line does not match itself.
    (re.compile(r"~/" + r"work\b"), "machine-specific path (the owner's work folder)"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "private key"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{16,}"), "GitHub token"),
    (re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "AWS access key id"),
    (re.compile(r"\bsk-[A-Za-z0-9]{20,}"), "API secret key"),
]

SKIP_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".icns", ".ico", ".pdf", ".zip"}


def check_paths() -> None:
    for path in tracked_files():
        if path.suffix.lower() in SKIP_SUFFIXES or not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        rel = path.relative_to(ROOT).as_posix()
        for line_no, line in enumerate(text.splitlines(), 1):
            for pattern, label in FORBIDDEN:
                if pattern.search(line):
                    fail(f"{rel}:{line_no}", f"{label} in a public repository")


# ------------------------------------------------------------------------- ignored

def check_ignored() -> None:
    """A file added before its ignore rule stays tracked forever, because .gitignore
    only governs untracked files. Two .pyc files lived in the history that way. If a
    path matches .gitignore, it does not belong in the repository."""
    paths = [p.relative_to(ROOT).as_posix() for p in tracked_files()]
    if not paths:
        return
    # --no-index because check-ignore skips paths that are in the index by default,
    # and paths in the index are the only ones this check is about. NUL-separated
    # both ways: line mode hands back CR-terminated paths on Windows and quotes
    # any path with a space in it.
    result = subprocess.run(
        ["git", "-C", str(ROOT), "check-ignore", "--stdin", "-z", "--no-index"],
        input="\0".join(paths).encode(),
        capture_output=True,
    )
    # check-ignore exits 0 when something matched, 1 when nothing did, >1 on error.
    if result.returncode > 1:
        fail("git check-ignore", result.stderr.strip() or "failed")
        return
    for path in result.stdout.decode(errors="replace").split("\0"):
        if path:
            fail(path, "is tracked but .gitignore says it should not be")


# ------------------------------------------------------------------------- patches

PATCH_NAME_RE = re.compile(r"^(\d{4})-[a-z0-9]+(?:-[a-z0-9]+)*\.patch$")


def check_patches() -> None:
    patch_dir = ROOT / "patches"
    if not patch_dir.is_dir():
        return
    numbers: list[int] = []
    for patch in sorted(patch_dir.glob("*.patch")):
        rel = patch.relative_to(ROOT).as_posix()
        m = PATCH_NAME_RE.match(patch.name)
        if not m:
            fail(rel, "filename must be NNNN-short-slug.patch")
            continue
        numbers.append(int(m.group(1)))
        # docs/ARCHITECTURE.md: every patch carries a header saying what, why, and
        # what would let us delete it.
        text = patch.read_text(encoding="utf-8", errors="replace")
        for field in ("Subject:", "Why:", "Removable when:"):
            if field not in text:
                fail(rel, f"patch header is missing '{field}'")
    if numbers and sorted(numbers) != list(range(1, len(numbers) + 1)):
        fail("patches", "series must be numbered contiguously from 0001")


# ------------------------------------------------------------------------- version

def check_version() -> None:
    pin = ROOT / "tooling" / "chromium-version"
    if not pin.is_file():
        fail("tooling/chromium-version", "missing: the Chromium pin has no source of truth")
        return
    values = {}
    for line in pin.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            values[k.strip()] = v.strip()

    tag = values.get("CHROMIUM_TAG", "")
    if not re.fullmatch(r"\d+\.\d+\.\d+\.\d+", tag):
        fail("tooling/chromium-version", f"CHROMIUM_TAG is not a Chromium version: {tag!r}")
    if not re.fullmatch(r"[0-9a-f]{40}", values.get("CHROMIUM_COMMIT", "")):
        fail("tooling/chromium-version", "CHROMIUM_COMMIT must be a full 40-character sha")
    if tag and values.get("CHROMIUM_MILESTONE") != tag.split(".", 1)[0]:
        fail("tooling/chromium-version", "CHROMIUM_MILESTONE does not match CHROMIUM_TAG")

    # ADR 0007: the pin lives in exactly one place. Anything else quoting a full
    # Chromium version number is a second source of truth waiting to go stale.
    if tag:
        for path in tracked_files():
            rel = path.relative_to(ROOT).as_posix()
            if rel == "tooling/chromium-version" or path.suffix.lower() in SKIP_SUFFIXES:
                continue
            if not path.is_file():
                continue
            try:
                text = path.read_text(encoding="utf-8")
            except (UnicodeDecodeError, OSError):
                continue
            for line_no, line in enumerate(text.splitlines(), 1):
                # Documentation may cite the pin, and a measurement record must
                # name the version it measured; scripts and configs may not.
                if tag in line and not rel.endswith(".md") and not rel.startswith("docs/perf/"):
                    fail(f"{rel}:{line_no}",
                         "hard-codes the Chromium version; read tooling/chromium-version instead")


# macOS ships bash 3.2 and `#!/usr/bin/env bash` resolves to it. Anything that needs
# bash 4 works on the author's machine via Homebrew and fails on a stock one — which
# is exactly the machine a new contributor has.
BASH4_ONLY = [
    (re.compile(r"\bmapfile\b"), "mapfile (bash 4+); use a while-read loop"),
    (re.compile(r"\breadarray\b"), "readarray (bash 4+); use a while-read loop"),
    (re.compile(r"\bdeclare\s+-A\b"), "associative arrays (bash 4+)"),
    (re.compile(r"\$\{[A-Za-z_][A-Za-z0-9_]*,,"), "${var,,} lowercasing (bash 4+); use tr"),
    (re.compile(r"\$\{[A-Za-z_][A-Za-z0-9_]*\^\^"), "${var^^} uppercasing (bash 4+); use tr"),
]


def check_shell() -> None:
    tooling = ROOT / "tooling"
    if not tooling.is_dir():
        return
    for path in sorted(tooling.rglob("*")):
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if not text.startswith("#!") or "bash" not in text.splitlines()[0]:
            continue
        rel = path.relative_to(ROOT).as_posix()
        for line_no, line in enumerate(text.splitlines(), 1):
            if line.lstrip().startswith("#"):
                continue
            for pattern, label in BASH4_ONLY:
                if pattern.search(line):
                    fail(f"{rel}:{line_no}", f"uses {label}")


# --------------------------------------------------------------------------- truth

# Phrases that were true once and then stayed in a document after the repo moved
# on. Each one cost a reader a wrong belief; a machine can refuse them.
STALE_PHRASES = [
    ("patches/README.md", "Empty so far"),
    ("docs/HANDOFF.md", "tests currently green"),
    ("AGENTS.md", "tests green in"),
    # Written while M0 was true and left standing through five published pre-releases.
    # A security policy that says nothing is shipped tells a reporter the wrong scope,
    # and a contributor guide that says there is no browser yet turns people away from
    # the most useful thing they can do, which is run the beta and say what is wrong.
    ("SECURITY.md", "there are no shipped binaries yet"),
    ("SECURITY.md", "No versions have been released"),
    ("CONTRIBUTING.md", "milestone M0"),
    ("CONTRIBUTING.md", "no installable browser yet"),
    ("docs/COMPETITORS.md", "We don't exist as a product yet"),
    ("docs/ROADMAP.md", "Outstanding: the network audit"),
]

# A behaviour row is | <letter><n> | text | test | state |. The letter is the spec's
# series (B for spaces, Z for shortcuts, ...); "planned" is a row from docs/ROUND6-PLAN.md
# whose test is named but not yet green.
# Ids are a capital and a number (T3), or a capital, a small letter and a
# number (Cf1) in the specs that share a first letter with another.
BEHAVIOUR_ROW = re.compile(r"^\| ([A-Z][a-z]?\d+) \| (.+?) \| (.+?) \| (built|partial|gap|planned|withdrawn)(?: · [^|]+)? \|$")
BACKLOG_ID = re.compile(r"\bS-(\d+)\b")


def check_truth() -> None:
    for rel, phrase in STALE_PHRASES:
        path = ROOT / rel
        if path.exists() and phrase in path.read_text(encoding="utf-8"):
            fail(rel, f"contains {phrase!r}, which is no longer true")

    # Numbers in prose are hand-typed numbers. tooling/status generates them.
    for rel in ("AGENTS.md", "docs/HANDOFF.md"):
        text = (ROOT / rel).read_text(encoding="utf-8")
        for m in re.finditer(r"\b(\d+) tests\b", text):
            fail(rel, f"hand-typed test count {m.group(0)!r}; use tooling/status")

    # Feature specs: every behaviour row has an id, a test column and a state.
    for spec in sorted((ROOT / "docs" / "features").glob("*.md")):
        seen: set[str] = set()
        for n, line in enumerate(spec.read_text(encoding="utf-8").splitlines(), 1):
            if not re.match(r"^\| [A-Z][a-z]?\d+ \|", line):
                continue
            m = BEHAVIOUR_ROW.match(line)
            if not m:
                fail(f"{spec.relative_to(ROOT)}:{n}", "behaviour row must be | <id> | text | test | built|partial|gap|planned|withdrawn |")
                continue
            bid, _, test, state = m.groups()
            if bid in seen:
                fail(f"{spec.relative_to(ROOT)}:{n}", f"duplicate behaviour id {bid}")
            seen.add(bid)
            if state == "built" and test.strip().lower().startswith("none"):
                fail(f"{spec.relative_to(ROOT)}:{n}", f"{bid} is 'built' with no test")
            if state == "gap" and not test.strip().lower().startswith("none"):
                fail(f"{spec.relative_to(ROOT)}:{n}", f"{bid} is 'gap' but names a test")
            if state == "planned" and test.strip().lower().startswith("none"):
                fail(f"{spec.relative_to(ROOT)}:{n}", f"{bid} is 'planned' with no test named")
            # A cut behaviour has no test; naming one reads as proof of it.
            if state == "withdrawn" and not test.strip().lower().startswith("none"):
                fail(f"{spec.relative_to(ROOT)}:{n}", f"{bid} is 'withdrawn' but names a test")

    # Backlog ids cited anywhere must exist.
    backlog = (ROOT / "BACKLOG.md").read_text(encoding="utf-8")
    known = set(BACKLOG_ID.findall(backlog))
    for path in tracked_files():
        if path.suffix != ".md" or path.name == "BACKLOG.md":
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        for m in BACKLOG_ID.finditer(text):
            if m.group(1) not in known:
                # as_posix: the rest of this file reports posix paths, and a Windows run
                # was printing docs\features\x.md next to docs/features/y.md.
                fail(path.relative_to(ROOT).as_posix(),
                     f"cites S-{m.group(1)}, which is not in BACKLOG.md")


# --------------------------------------------------------------------------- traps

TRAP_ITEM = re.compile(r"^(\d+)\. \*\*")
TRAP_CITATION = re.compile(r"\btrap (\d+)\b", re.I)


def check_traps() -> None:
    """docs/HANDOFF.md numbers its traps and the rest of the repo cites them by number.
    The list had been written as three markdown lists in a row, so 5-9, 22 and 23 each
    named two different traps and "trap 22" meant three things depending on who wrote
    it. Numbers used as identifiers have to be unique and resolvable."""
    handoff = ROOT / "docs" / "HANDOFF.md"
    if not handoff.is_file():
        return
    lines = handoff.read_text(encoding="utf-8").splitlines()
    try:
        start = next(i for i, l in enumerate(lines) if l.startswith("## Traps this project"))
        end = next(i for i, l in enumerate(lines) if i > start and l.startswith("## "))
    except StopIteration:
        fail("docs/HANDOFF.md", "no traps section to check")
        return

    numbers = [int(m.group(1)) for l in lines[start:end] if (m := TRAP_ITEM.match(l))]
    if not numbers:
        fail("docs/HANDOFF.md", "the traps section lists no numbered traps")
        return
    if numbers != list(range(1, len(numbers) + 1)):
        fail("docs/HANDOFF.md",
             f"traps must be numbered contiguously from 1; got {numbers}")
    known = set(numbers)

    for path in tracked_files():
        if path.suffix != ".md":
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        rel = path.relative_to(ROOT).as_posix()
        for line_no, line in enumerate(text.splitlines(), 1):
            for m in TRAP_CITATION.finditer(line):
                if int(m.group(1)) not in known:
                    fail(f"{rel}:{line_no}",
                         f"cites trap {m.group(1)}, which docs/HANDOFF.md does not have")


# --------------------------------------------------------------------------- eol

BINARY_SUFFIXES = {".png", ".icns", ".ico", ".dmg", ".jpg", ".jpeg", ".gif", ".pdf",
                   ".woff", ".woff2", ".ttf", ".otf", ".zip"}


def check_eol() -> None:
    """Every tracked text file ends its lines with LF. The Windows PC wrote CRLF into
    three docs and two patch headers (2026-09-10), and the next edit on the Mac then
    rewrote every line of BACKLOG.md, hiding a one-row change in a 75-line diff.
    .gitattributes now says LF on every machine; this says so before a commit lands."""
    for path in tracked_files():
        if path.suffix.lower() in BINARY_SUFFIXES:
            continue
        try:
            data = path.read_bytes()
        except OSError:
            continue
        if b"\0" in data[:8000]:
            continue
        crs = data.count(b"\r")
        if crs:
            fail(path.relative_to(ROOT).as_posix(),
                 f"{crs} CR byte(s): line endings are LF here (.gitattributes)")


# --------------------------------------------------------------------------- tests

# TEST(Suite, Name) and the wrapped TEST_F(Suite,\n    Name) form clang-format
# produces once the line is too long. Both are added lines in the patch series, which
# is the only place this repository holds code.
TEST_MACRO = r"(TEST|TEST_F|TEST_P|IN_PROC_BROWSER_TEST_F|IN_PROC_BROWSER_TEST_P)"
TEST_ONE_LINE = re.compile(r"^([+-])" + TEST_MACRO + r"\(\s*([A-Za-z_]\w*)\s*,\s*([A-Za-z_]\w*)\s*\)")
TEST_OPEN = re.compile(r"^([+-])" + TEST_MACRO + r"\(\s*([A-Za-z_]\w*)\s*,\s*$")
TEST_CONT = re.compile(r"^[+-]\s*([A-Za-z_]\w*)\s*\)")
# gtest's own filter syntax, which is what these citations are meant to be pasted into.
TEST_REF = re.compile(r"\b([A-Z][A-Za-z0-9_]*(?:Test|Tests))\.([A-Za-z_*][\w*]*)")


def test_definitions() -> dict[tuple[str, str], tuple[str, str]]:
    """(suite, name) -> (macro, file) for every test the whole series defines. A
    later patch that deletes a test takes it out again, so a spec cannot cite a
    test that no longer exists; one that moves it records its new file."""
    if _DEFINITIONS:
        return _DEFINITIONS[0]
    defs: dict[tuple[str, str], tuple[str, str]] = {}
    for patch in sorted((ROOT / "patches").glob("*.patch")):
        added: list[tuple[str, str, str, str]] = []
        removed: list[tuple[str, str]] = []
        pending = None
        path = ""
        for raw in patch.read_text(encoding="utf-8", errors="replace").splitlines():
            if raw.startswith("diff --git "):
                path = raw.split(" b/", 1)[-1]
                pending = None
                continue
            m = TEST_ONE_LINE.match(raw)
            if m:
                if m.group(1) == "+":
                    added.append((m.group(3), m.group(4), m.group(2), path))
                else:
                    removed.append((m.group(3), m.group(4)))
                pending = None
                continue
            m = TEST_OPEN.match(raw)
            if m:
                pending = (m.group(1), m.group(2), m.group(3), path)
                continue
            if pending:
                cont = TEST_CONT.match(raw)
                if cont:
                    sign, macro, suite, where = pending
                    if sign == "+":
                        added.append((suite, cont.group(1), macro, where))
                    else:
                        removed.append((suite, cont.group(1)))
                pending = None
        for suite, name in removed:
            defs.pop((suite, name), None)
        for suite, name, macro, where in added:
            defs[(suite, name)] = (macro, where)
    _DEFINITIONS.append(defs)
    return defs


_DEFINITIONS: list[dict[tuple[str, str], tuple[str, str]]] = []


def tests_in_series() -> dict[str, set[str]]:
    """Suite -> test names, for every test the whole series defines."""
    suites: dict[str, set[str]] = {}
    for suite, name in test_definitions():
        suites.setdefault(suite, set()).add(name)
    return suites


def gtest_pattern(pattern: str) -> re.Pattern[str]:
    """gtest's filter syntax: * is any run of characters, ? one; nothing else."""
    return re.compile(re.escape(pattern).replace(r"\*", ".*").replace(r"\?", "."))


# tooling/dev's name:filter tables: unit_tests, and components_unittests.
DEV_FILTER_TABLE = re.compile(r"^(FEATURE_FILTERS|COMPONENT_FILTERS)='\n(.*?)^'", re.S | re.M)
# Stedding's own browser tests; `tooling/dev test browser` runs all of them.
BROWSER_TEST_DIR = "chrome/test/stedding/"


def dev_filter_parts() -> list[str] | None:
    """Every part that selects tests in tooling/dev's filters, or None when the
    tables cannot be found."""
    dev = ROOT / "tooling" / "dev"
    if not dev.is_file():
        return None
    tables = {m.group(1): m.group(2)
              for m in DEV_FILTER_TABLE.finditer(dev.read_text(encoding="utf-8"))}
    if "FEATURE_FILTERS" not in tables:
        return None
    parts: list[str] = []
    for table in tables.values():
        for line in table.splitlines():
            _, sep, flt = line.strip().partition(":")
            if sep:
                # "A:B-C:D" selects A and B; C and D only exclude.
                parts += [p for p in flt.split("-", 1)[0].split(":") if p]
    return parts


def check_tests() -> None:
    """A 'built' row must name a test that exists, and every test a spec row or
    BACKLOG cites must be one a sweep runs.

    AGENTS.md: a behaviour is shipped when its test in docs/features/<feature>.md is
    green. A row that names a test which is not in the series reads as shipped and
    cannot be run: pasting the name into --gtest_filter matches nothing and says so
    quietly, with exit status 0. Twelve rows had drifted this way -- four naming the
    right test under the wrong suite after it moved, the rest naming a test that was
    renamed or never written.

    Only 'built' is checked for existence. A 'planned' row names the test that will
    prove it, which is the point of the state, and check_truth already requires it
    to name one.

    Existing is not enough: six tests that 'built' rows cite as proof were in no
    tooling/dev filter, so no sweep ever ran them (PLAN.md REPO-2). So every test
    the series defines that a spec row (any state) or BACKLOG cites must match a
    part of a tooling/dev filter, or be one of Stedding's browser tests in
    chrome/test/stedding, which `tooling/dev test browser` runs whole. A citation
    of a test the series does not define is left to the existence rule above.
    Which binary holds a test is checked when it runs: `tooling/dev test` lists
    each filter part first and stops when one matches nothing.
    """
    specs = sorted((ROOT / "docs" / "features").glob("*.md"))
    if not specs:
        return
    suites = tests_in_series()
    if not suites:
        fail("patches", "no tests found in the series; the spec check cannot mean anything")
        return

    citations: list[tuple[str, int, str, str, str]] = []  # (file, line, id, suite, name)
    for spec in specs:
        rel = spec.relative_to(ROOT).as_posix()
        for line_no, line in enumerate(spec.read_text(encoding="utf-8").splitlines(), 1):
            m = BEHAVIOUR_ROW.match(line)
            if not m:
                continue
            bid, _, test_column, state = m.groups()
            for suite, name in sorted(set(TEST_REF.findall(test_column))):
                citations.append((rel, line_no, bid, suite, name))
                if state != "built":
                    continue
                known = suites.get(suite, set())
                if any(fnmatch.fnmatchcase(n, name) for n in known):
                    continue
                bare = name.strip("*")
                elsewhere = sorted(s for s, names in suites.items() if bare in names)
                hint = f"; it is {elsewhere[0]}.{bare}" if elsewhere else ""
                fail(f"{rel}:{line_no}",
                     f"{bid} is 'built' and names {suite}.{name}, "
                     f"which the series does not define{hint}")
    backlog = ROOT / "BACKLOG.md"
    if backlog.is_file():
        for line_no, line in enumerate(backlog.read_text(encoding="utf-8").splitlines(), 1):
            row = re.match(r"^\| (S-\d+) \|", line)
            for suite, name in sorted(set(TEST_REF.findall(line))):
                citations.append(("BACKLOG.md", line_no, row.group(1) if row else "this line",
                                  suite, name))

    parts = dev_filter_parts()
    if parts is None:
        fail("tooling/dev", "no FEATURE_FILTERS table found; cannot check that cited tests run")
        return
    selectors = [gtest_pattern(p) for p in dict.fromkeys(parts)]
    definitions = sorted(test_definitions().items())
    reported: set[tuple[str, int, str]] = set()
    for rel, line_no, bid, suite, name in citations:
        cited = gtest_pattern(f"{suite}.{name}")
        for (def_suite, def_name), (macro, path) in definitions:
            full = f"{def_suite}.{def_name}"
            if not cited.fullmatch(full) or (rel, line_no, full) in reported:
                continue
            if path.startswith(BROWSER_TEST_DIR):
                continue
            if macro.startswith("IN_PROC_BROWSER_TEST"):
                problem = (f"is a browser test outside {BROWSER_TEST_DIR} ({path}), "
                           "which no tooling/dev leg runs")
            elif any(s.fullmatch(full) for s in selectors):
                continue
            else:
                problem = ("matches no filter in tooling/dev, so no sweep runs it; add it to "
                           "its feature's line (COMPONENT_FILTERS if it lives in "
                           "components_unittests)")
            reported.add((rel, line_no, full))
            fail(f"{rel}:{line_no}", f"{bid} cites {full}, which {problem}")


# ------------------------------------------------------------------------- wiring

GN_SOURCE = re.compile(r'"([^"]+\.(?:cc|mm))"')


def check_wiring() -> None:
    """Every source file the series adds must be listed in a GN sources list.

    A .cc that no target compiles is dead code carried through every rebase. A
    _unittest.cc that no target compiles is worse: the feature spec says the
    behaviour is proven by it, `check_tests` above confirms the test exists, and
    nothing ever runs it. Adding the file and forgetting the BUILD.gn line is one
    edit, and neither the compiler nor the test runner says a word.

    GN spells a sources list several ways and all of them count:

        sources = [ "one.cc" ]                      on one line
        sources = [\\n  "a.cc",\\n  "b.cc",\\n]     one per line
        sources += [ ... ]                          appended to an existing target
        "subdir/name.cc"                            with a path prefix

    so the match is any quoted .cc/.mm token on a line the series adds to a .gn or
    .gni file, compared by basename.
    """
    patch_dir = ROOT / "patches"
    if not patch_dir.is_dir():
        return

    created: list[tuple[str, str]] = []
    listed: set[str] = set()
    for patch in sorted(patch_dir.glob("*.patch")):
        rel = patch.relative_to(ROOT).as_posix()
        in_gn = False
        for line in patch.read_text(encoding="utf-8", errors="replace").splitlines():
            if line.startswith("diff --git "):
                in_gn = line.endswith((".gn", ".gni"))
                continue
            if line.startswith(" create mode "):
                path = line.split()[-1]
                if path.endswith((".cc", ".mm")):
                    created.append((path, rel))
                continue
            if in_gn and line.startswith("+"):
                for token in GN_SOURCE.findall(line):
                    listed.add(token.rsplit("/", 1)[-1])

    for path, rel in created:
        if path.rsplit("/", 1)[-1] not in listed:
            fail(rel, f"adds {path} but no GN sources list in the series names it, "
                      "so nothing compiles it")


CHECKS = {
    "shell": check_shell,
    "links": check_links,
    "adrs": check_adrs,
    "paths": check_paths,
    "ignored": check_ignored,
    "patches": check_patches,
    "version": check_version,
    "traps": check_traps,
    "eol": check_eol,
    "truth": check_truth,
    "tests": check_tests,
    "wiring": check_wiring,
}


def main(argv: list[str]) -> int:
    requested = argv[1:] or list(CHECKS)
    unknown = [c for c in requested if c not in CHECKS]
    if unknown:
        print(f"unknown check(s): {', '.join(unknown)}", file=sys.stderr)
        print(f"available: {', '.join(CHECKS)}", file=sys.stderr)
        return 2

    for name in requested:
        before = len(FAILURES)
        CHECKS[name]()
        status = "FAIL" if len(FAILURES) > before else "ok"
        print(f"  {status:<4} {name}")

    if FAILURES:
        print(f"\n{len(FAILURES)} problem(s):\n", file=sys.stderr)
        for f in FAILURES:
            print(f"  {f}", file=sys.stderr)
        return min(len(FAILURES), 125)
    print("\nall checks passed")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
