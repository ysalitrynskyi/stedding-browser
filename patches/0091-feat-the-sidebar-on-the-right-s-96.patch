+// Y40: with the window against the screen's right edge, as a maximized one
+// is, there is no room for the arrow right of the sidebar; it points at the
+// sidebar from inside the sidebar's left edge instead, on the screen. With
+// the sidebar on the left the same window has room, and the arrow stays
+// left of the sidebar.
+IN_PROC_BROWSER_TEST_F(SidebarRightTest, TheDropArrowStaysOnTheScreen) {
+  AppendTab();
+  Settle();
+  const gfx::Rect screen =
+      display::Screen::Get()
+          ->GetDisplayNearestView(browser_view()->GetWidget()->GetNativeView())
+          .bounds();
+  // Narrower than the screen, so that the sidebar on the left has room.
+  const int width = std::min(900, screen.width() - 100);
+  const int height = std::min(700, screen.height());
+  ui_test_utils::SetAndWaitForBounds(
+      *browser(),
+      gfx::Rect(screen.right() - width, screen.y(), width, height));
+  Settle();
+  // Where the arrow may go, as the strip measures it.
+  gfx::Rect room =
+      display::Screen::Get()
+          ->GetDisplayNearestView(browser_view()->GetWidget()->GetNativeView())
+          .bounds();
+  DropArrow::MaybeAdjustDisplayBounds(room);
+
+  BrowserRootView::DropIndex index;
+  index.index = browser()->tab_strip_model()->count();
+  index.relative_to_index =
+      BrowserRootView::DropIndex::RelativeToIndex::kInsertBeforeIndex;
+  DropArrow::Direction direction = DropArrow::Direction::kDown;
+  const gfx::Point at = region()->GetLinkDropArrowPosition(index, &direction);
+  ASSERT_EQ(DropArrow::Direction::kLeft, direction);
+  ASSERT_GT(at.x() + 2 * DropArrow::kSize, room.right())
+      << "the window does not reach the screen's right edge, so this checked "
+         "nothing: the strip ends at "
+      << at.x() << ", the screen at " << room.right();
+
+  gfx::Rect arrow = region()->GetLinkDropBoundsForTesting(index, &direction);
+  EXPECT_EQ(DropArrow::Direction::kRight, direction)
+      << "the arrow turns to point from the sidebar's left edge";
+  EXPECT_EQ(region()->GetBoundsInScreen().x(), arrow.x());
+  EXPECT_TRUE(room.Contains(arrow))
+      << arrow.ToString() << " is not on the screen " << room.ToString();
+
+  prefs()->SetBoolean(stedding::prefs::kSidebarOnRight, false);
+  Settle();
+  arrow = region()->GetLinkDropBoundsForTesting(index, &direction);
+  EXPECT_EQ(DropArrow::Direction::kRight, direction)
+      << "on the left, the same window has room left of the sidebar";
+  EXPECT_EQ(region()->GetBoundsInScreen().x() - DropArrow::kSize, arrow.x());
+  EXPECT_TRUE(room.Contains(arrow))
+      << arrow.ToString() << " is not on the screen " << room.ToString();
