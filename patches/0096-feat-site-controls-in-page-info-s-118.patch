+RichControlsContainerView* AddToggleRow(views::View* parent,
+                                        const gfx::VectorIcon& icon,
+                                        ui::ElementIdentifier id,
+                                        base::RepeatingClosure on_pressed,
+                                        raw_ptr<views::ToggleButton>* toggle) {
+  auto row = std::make_unique<RichControlsContainerView>();
+  row->SetIcon(PageInfoViewFactory::GetImageModel(icon));
+  row->SetTitleTextStyleAndColor(views::style::STYLE_BODY_3_MEDIUM,
+                                 kColorPageInfoForeground);
+  auto button = std::make_unique<views::ToggleButton>(std::move(on_pressed));
+  button->SetProperty(views::kElementIdentifierKey, id);
+  *toggle = row->AddControl(std::move(button));
+  return parent->AddChildView(std::move(row));
+}
