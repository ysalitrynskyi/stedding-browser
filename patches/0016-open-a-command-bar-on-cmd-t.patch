+#ifndef CHROME_BROWSER_UI_VIEWS_COMMANDBAR_COMMAND_BAR_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_COMMANDBAR_COMMAND_BAR_VIEW_H_
+
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "ui/base/metadata/metadata_header_macros.h"
+#include "ui/views/view.h"
+#include "ui/views/controls/textfield/textfield_controller.h"
+
+class Browser;
+
+namespace views {
+class ScrollView;
+class Textfield;
+}  // namespace views
+
+namespace stedding {
+
+// The overlay that ⌘T opens: a search field over a list of things to go to.
+//
+// It searches every Space, not only the active one, and says which Space a
+// result is in when that is not the one you are looking at. That is the payoff
+// of ADR 0015 keeping all Spaces' tabs in one TabStripModel: finding a tab in
+// another Space costs nothing.
+class CommandBarView : public views::View,
+                       public views::TextfieldController {
+  METADATA_HEADER(CommandBarView, views::View)
+
+ public:
+  // Opens the command bar for `browser`.
+  static void Show(Browser* browser);
+
+  explicit CommandBarView(Browser* browser);
+
+  CommandBarView(const CommandBarView&) = delete;
+  CommandBarView& operator=(const CommandBarView&) = delete;
+  ~CommandBarView() override;
+
+  // views::TextfieldController:
+  void ContentsChanged(views::Textfield* sender,
+                       const std::u16string& new_contents) override;
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override;
+
+  // views::View:
+  void AddedToWidget() override;
+  bool AcceleratorPressed(const ui::Accelerator& accelerator) override;
+
+ private:
+  // One thing the user can go to.
+  struct Result {
+    // Index in the tab strip, or -1 when this is "open what you typed".
+    int tab_index;
+    std::u16string title;
+    // The Space this tab is in, shown only when it is not the active one.
+    std::u16string space;
+  };
+
+  // Builds the field and the list. Called once, from AddedToWidget().
+  void BuildContents();
+
+  // Rebuilds the result list for `query`.
+  void UpdateResults(const std::u16string& query);
+
+  // Goes to `result` and closes. Not named Accept: DialogDelegate already has
+  // a virtual of that name and this would hide it.
+  void GoTo(const Result& result);
+
+  // Opens whatever is in the field: a URL if it looks like one, a search
+  // otherwise.
+  void OpenTypedText();
+
+  const raw_ptr<Browser> browser_;
+  raw_ptr<views::Textfield> field_ = nullptr;
+  raw_ptr<views::ScrollView> list_ = nullptr;
+  std::vector<Result> results_;
+};
+
+}  // namespace stedding
+
+#endif  // CHROME_BROWSER_UI_VIEWS_COMMANDBAR_COMMAND_BAR_VIEW_H_
