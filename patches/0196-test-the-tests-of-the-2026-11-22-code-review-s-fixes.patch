+// docs/features/little.md E11 and docs/features/peek.md P12: a link from
+// another app that opens as a peek in a small window over a minimised window
+// opens over that window where it comes back, as it does over a window on
+// screen. Windows measures a minimised window at -32000, -32000, and the
+// peek was placed from that: at its smallest, in a corner of a display, not
+// over the window.
+
+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+
+#include <algorithm>
+#include <cstdlib>
+
+#include "base/test/run_until.h"
+#include "base/time/time.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/stedding/little_window.h"
+#include "chrome/browser/ui/stedding/peek.h"
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/test/browser_test.h"
+#include "net/test/embedded_test_server/embedded_test_server.h"
+#include "ui/base/base_window.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect.h"
+#include "url/gurl.h"
+
+namespace {
+
+// peek P12: the peek covers the window it came from but for 72 DIP at the
+// sides and 48 at the top and bottom, at least 400 by 300, centred.
+gfx::Rect PeekBoundsOverW2B19(const gfx::Rect& over) {
+  gfx::Rect expected = over;
+  expected.Inset(gfx::Insets::VH(48, 72));
+  expected.set_width(std::max(400, expected.width()));
+  expected.set_height(std::max(300, expected.height()));
+  expected.set_x(over.x() + (over.width() - expected.width()) / 2);
+  expected.set_y(over.y() + (over.height() - expected.height()) / 2);
+  return expected;
+}
+
+// Whether `a` and `b` are the same bounds but for the DIP a window can
+// measure off the bounds it was given at a fractional scale.
+bool NearlySameBoundsW2B19(const gfx::Rect& a, const gfx::Rect& b) {
+  constexpr int kSlack = 2;
+  return std::abs(a.x() - b.x()) <= kSlack &&
+         std::abs(a.y() - b.y()) <= kSlack &&
+         std::abs(a.right() - b.right()) <= kSlack &&
+         std::abs(a.bottom() - b.bottom()) <= kSlack;
+}
+
+class LittleWindowPeekW2B19Test : public InProcessBrowserTest {
+ protected:
+  void SetUpOnMainThread() override {
+    InProcessBrowserTest::SetUpOnMainThread();
+    ASSERT_TRUE(embedded_test_server()->Start());
+  }
+};
+
+// P23-1c; little E11, peek P12: with "Open links from other apps as a peek"
+// on and "Show a peek" in a small window, a link from another app while the
+// window is minimised opens its peek over the window as it comes back, not
+// from the place Windows gives a minimised window.
+IN_PROC_BROWSER_TEST_F(LittleWindowPeekW2B19Test,
+                       ALinkPeeksOverAMinimisedWindowWhereItComesBack) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(stedding::prefs::kLittleAsPeek, true);
+  prefs->SetInteger(stedding::prefs::kPeekStyle,
+                    stedding::prefs::kPeekStyleSmallWindow);
+  // The link brings the window back and to the front (E11); that activation
+  // keeps the peek however slow the build, not only in its first 750 ms
+  // (peek P14).
+  stedding::SetPeekOpeningGraceForTesting(base::Seconds(30));
+
+  const gfx::Rect over = browser()->GetWindow()->GetBounds();
+  ASSERT_FALSE(over.IsEmpty());
+  browser()->GetWindow()->Minimize();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return browser()->GetWindow()->IsMinimized(); }))
+      << "the window did not minimise";
+
+  BrowserWindowInterface* const peek = stedding::OpenLittleWindow(
+      browser()->GetProfile(), embedded_test_server()->GetURL("/title2.html"),
+      /*anchor=*/nullptr, /*untrusted_launch=*/false);
+  ASSERT_TRUE(peek);
+  ASSERT_TRUE(stedding::IsPeekWindow(peek)) << "no peek opened";
+  EXPECT_EQ(peek, stedding::PeekOver(browser()));
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return !browser()->GetWindow()->IsMinimized(); }))
+      << "the window did not come back";
+
+  const gfx::Rect expected = PeekBoundsOverW2B19(over);
+  const gfx::Rect placed = peek->GetWindow()->GetBounds();
+  EXPECT_TRUE(NearlySameBoundsW2B19(expected, placed))
+      << "the peek is at " << placed.ToString() << ", not "
+      << expected.ToString() << " over the window at " << over.ToString();
+  EXPECT_TRUE(over.Contains(placed))
+      << "the peek at " << placed.ToString() << " is not over the window at "
+      << over.ToString();
+
+  CloseBrowserSynchronously(peek);
+  stedding::SetPeekOpeningGraceForTesting(base::Milliseconds(750));
+  prefs->ClearPref(stedding::prefs::kPeekStyle);
+  prefs->ClearPref(stedding::prefs::kLittleAsPeek);
+}
+
+// P23-1c; little E11, peek P12: the same for a window minimised while it was
+// maximised. It comes back maximised, and the peek is over all of it, not
+// over the smaller bounds the window had before it was maximised, which
+// Windows keeps as a minimised window's restored ones.
+IN_PROC_BROWSER_TEST_F(LittleWindowPeekW2B19Test,
+                       ALinkPeeksOverAMaximisedWindowMinimisedAsItComesBack) {
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  prefs->SetBoolean(stedding::prefs::kLittleAsPeek, true);
+  prefs->SetInteger(stedding::prefs::kPeekStyle,
+                    stedding::prefs::kPeekStyleSmallWindow);
+  stedding::SetPeekOpeningGraceForTesting(base::Seconds(30));
+
+  const gfx::Rect normal = browser()->GetWindow()->GetBounds();
+  browser()->GetWindow()->Maximize();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return browser()->GetWindow()->IsMaximized(); }))
+      << "the window did not maximise";
+  const gfx::Rect over = browser()->GetWindow()->GetBounds();
+  ASSERT_NE(normal, over) << "maximised, the window is no larger";
+  browser()->GetWindow()->Minimize();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return browser()->GetWindow()->IsMinimized(); }))
+      << "the window did not minimise";
+
+  BrowserWindowInterface* const peek = stedding::OpenLittleWindow(
+      browser()->GetProfile(), embedded_test_server()->GetURL("/title2.html"),
+      /*anchor=*/nullptr, /*untrusted_launch=*/false);
+  ASSERT_TRUE(peek);
+  ASSERT_TRUE(stedding::IsPeekWindow(peek)) << "no peek opened";
+  EXPECT_TRUE(base::test::RunUntil(
+      [&]() { return browser()->GetWindow()->IsMaximized(); }))
+      << "the window did not come back maximised";
+
+  const gfx::Rect expected = PeekBoundsOverW2B19(over);
+  const gfx::Rect placed = peek->GetWindow()->GetBounds();
+  EXPECT_TRUE(NearlySameBoundsW2B19(expected, placed))
+      << "the peek is at " << placed.ToString() << ", not "
+      << expected.ToString() << " over the window at " << over.ToString()
+      << " (before it was maximised: " << normal.ToString() << ")";
+
+  CloseBrowserSynchronously(peek);
+  stedding::SetPeekOpeningGraceForTesting(base::Milliseconds(750));
+  prefs->ClearPref(stedding::prefs::kPeekStyle);
+  prefs->ClearPref(stedding::prefs::kLittleAsPeek);
+}
+
+}  // namespace
+
+#endif  // BUILDFLAG(IS_WIN)
