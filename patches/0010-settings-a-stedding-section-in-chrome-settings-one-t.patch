@@ -0,0 +1,26 @@
+// Copyright 2026 The Stedding Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/stedding/stedding_prefs.h"
+
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace stedding::prefs {
+namespace {
+
+// settings T2: every Stedding preference registers and defaults to on, so
+// a fresh profile behaves as the feature specs describe and each toggle in
+// the section starts on.
+TEST(SteddingPrefsTest, EveryPreferenceRegistersAndDefaultsToOn) {
+  sync_preferences::TestingPrefServiceSyncable service;
+  RegisterProfilePrefs(service.registry());
+  for (const char* name : {kNewTabShowHint, kNewTabShowShortcuts, kPeekEnabled}) {
+    ASSERT_TRUE(service.FindPreference(name)) << name;
+    EXPECT_TRUE(service.GetBoolean(name)) << name;
+  }
+}
+
+}  // namespace
+}  // namespace stedding::prefs
