From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Fri, 6 Nov 2026 13:16:56 -0500
Subject: fix: the DRM notice is shorter and does not wait behind another bar

In a window about 1030 DIP wide the sentence was cut before it said what it
meant, and a bar already up held the one place of its priority, so the notice
waited until that bar closed. The sentence is shorter, and the notice takes the
higher priority, which has room for two.

Why: seen on beta 11 on Windows (BACKLOG S-437, drm-notice Dn1).

Removable when: the DRM notice goes.
---
 chrome/browser/ui/stedding/drm_notice.cc      |  8 ++++-
 .../test/stedding/drm_notice_browsertest.cc   | 34 ++++++++++++++++++-
 2 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/ui/stedding/drm_notice.cc b/chrome/browser/ui/stedding/drm_notice.cc
index 8f7a66e093b55..1bc49fd06a327 100644
--- a/chrome/browser/ui/stedding/drm_notice.cc
+++ b/chrome/browser/ui/stedding/drm_notice.cc
@@ -40,7 +40,7 @@ namespace {
 
 // Stedding's own strings are not localised yet.
 constexpr char16_t kMessage[] =
-    u"This site uses DRM to protect its video, which Stedding can't play yet.";
+    u"Stedding can't play this site's DRM video yet.";
 constexpr char16_t kDontShowAgain[] = u"Don't show again";
 #if BUILDFLAG(IS_MAC)
 constexpr char16_t kOpenElsewhere[] = u"Open in Safari";
@@ -109,6 +109,12 @@ class DrmNoticeDelegate : public ConfirmInfoBarDelegate {
     return STEDDING_DRM_NOTICE_INFOBAR_DELEGATE;
   }
   std::u16string GetMessageText() const override { return kMessage; }
+  // Dn1 (BACKLOG S-437): the page does not work and this says why, so it does
+  // not wait behind a bar like "isn't your default browser", which holds the
+  // only place of its priority until it is closed.
+  InfobarPriority GetPriority() const override {
+    return InfobarPriority::kCriticalSecurity;
+  }
   int GetButtons() const override {
     return can_open_elsewhere_ ? BUTTON_OK : BUTTON_NONE;
   }
diff --git a/chrome/test/stedding/drm_notice_browsertest.cc b/chrome/test/stedding/drm_notice_browsertest.cc
index f9641a86eaf1b..07104fbe99f8f 100644
--- a/chrome/test/stedding/drm_notice_browsertest.cc
+++ b/chrome/test/stedding/drm_notice_browsertest.cc
@@ -21,6 +21,7 @@
 #include "base/test/bind.h"
 #include "base/test/run_until.h"
 #include "build/build_config.h"
+#include "chrome/browser/infobars/confirm_infobar_creator.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/stedding/little_window.h"
@@ -58,7 +59,7 @@
 namespace {
 
 constexpr char16_t kMessage[] =
-    u"This site uses DRM to protect its video, which Stedding can't play yet.";
+    u"Stedding can't play this site's DRM video yet.";
 
 // The page's DRM bars: one at most, whatever the test did.
 std::vector<infobars::InfoBar*> BarsOn(content::WebContents* page) {
@@ -208,6 +209,37 @@ class DrmNoticeTest : public InProcessBrowserTest {
   content::ContentMockCertVerifier mock_cert_verifier_;
 };
 
+// A bar of the usual priority that outlives a navigation, as "isn't your
+// default browser" does.
+class OtherBarDelegate : public ConfirmInfoBarDelegate {
+ public:
+  infobars::InfoBarDelegate::InfoBarIdentifier GetIdentifier() const override {
+    return infobars::InfoBarDelegate::TEST_INFOBAR;
+  }
+  std::u16string GetMessageText() const override { return u"Another bar"; }
+  int GetButtons() const override { return BUTTON_NONE; }
+  bool ShouldExpire(const NavigationDetails& details) const override {
+    return false;
+  }
+};
+
+// Dn1 (BACKLOG S-437): a bar already up does not hold the notice back. That bar
+// held the one place of its priority, and the notice waited until it closed.
+IN_PROC_BROWSER_TEST_F(DrmNoticeTest, AnotherBarDoesNotHoldTheNoticeBack) {
+  infobars::ContentInfoBarManager* const manager =
+      infobars::ContentInfoBarManager::FromWebContents(contents());
+  ASSERT_TRUE(manager);
+  ASSERT_TRUE(manager->AddInfoBar(
+      CreateConfirmInfoBar(std::make_unique<OtherBarDelegate>())));
+  ASSERT_NO_FATAL_FAILURE(Open(Url("www.netflix.com")));
+  infobars::InfoBar* const bar = BarOn(contents());
+  ASSERT_TRUE(bar);
+  views::View* const view = ViewOf(bar);
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return view->IsDrawn() && view->height() > 0;
+  })) << "the notice waits behind the other bar";
+}
+
 // Dn1: the bar comes up on a listed site, says why, and shows; the page is
 // there and answers.
 IN_PROC_BROWSER_TEST_F(DrmNoticeTest, AListedSiteShowsTheBarAndThePageLoads) {
