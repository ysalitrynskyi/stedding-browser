+
+bool TabStripCollection::CanMoveTabsIntoFolder(
+    const std::vector<int>& tab_indices,
+    const FolderTabCollection* folder) {
+  CHECK(folder);
+  // A folder cannot be moved into itself or into one of its own descendants:
+  // that would detach a subtree from the tree it is being put into.
+  for (const ChildPtr& node :
+       GetTabsAndCollectionsForMove(tab_indices, FolderMoveRetainSet())) {
+    if (!std::holds_alternative<DanglingUntriagedTabCollection>(node)) {
+      continue;
+    }
+    const TabCollection* const moving =
+        std::get<DanglingUntriagedTabCollection>(node);
+    for (const TabCollection* c = folder; c; c = c->GetParentCollection()) {
+      if (c == moving) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool TabStripCollection::MoveTabsIntoFolderRecursive(
+    const std::vector<int>& tab_indices,
+    FolderTabCollection* folder) {
+  if (!CanMoveTabsIntoFolder(tab_indices, folder)) {
+    return false;
+  }
+  MoveNodesIntoFolder(
+      GetTabsAndCollectionsForMove(tab_indices, FolderMoveRetainSet()), folder,
+      {folder->GetHandle(), folder->ChildCount()});
+  return true;
+}
+
+void TabStripCollection::MoveNodesIntoFolder(ChildrenPtrs nodes,
+                                             FolderTabCollection* folder,
+                                             TabCollection::Position position) {
+  CHECK(folder);
+  for (auto& node : nodes) {
+    TabCollection* src_parent_collection = nullptr;
+    if (std::holds_alternative<DanglingUntriagedTabInterface>(node)) {
+      TabInterface* tab_ptr = std::get<DanglingUntriagedTabInterface>(node);
+      src_parent_collection = tab_ptr->GetParentCollection(GetPassKey());
+      MoveTabImpl(tab_ptr, position);
+    } else {
+      TabCollection* collection_ptr =
+          std::get<DanglingUntriagedTabCollection>(node);
+      src_parent_collection = collection_ptr->GetParentCollection();
+      MoveCollectionImpl(collection_ptr, position);
+    }
+
+    // Remove previous collection if needed. This also notifies the
+    // collection is removed.
+    if (src_parent_collection != unpinned_collection_ &&
+        src_parent_collection != pinned_collection_ &&
+        src_parent_collection->TabCountRecursive() == 0) {
+      RemoveTabCollectionImpl(src_parent_collection);
+    }
+
+    position = GetNodePosition(node);
+    position.index += 1;
+  }
+}
