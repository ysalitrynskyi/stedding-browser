+IN_PROC_BROWSER_TEST_F(WelcomeFlowW2B05Test,
+                       TheQuietFocusStaysQuietAfterLateAnswers) {
+  content::WebContents* const page = OpenWelcomeW2B05(*browser(), {});
+  ASSERT_TRUE(page);
+  ASSERT_EQ("settled", content::EvalJs(page, kSettledW2B05));
+  constexpr char kFocused[] = R"(
+      (() => {
+        const focused = document.activeElement;
+        return focused && focused !== document.body
+            ? focused.dataset.focus + ':' + focused.textContent
+            : 'nothing';
