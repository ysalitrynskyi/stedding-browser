+// dark-pages Dk8: a page whose top edge is many colours gives the row its
+// theme colour, a light blue. Under dark pages that colour is inverted the
+// way Blink inverts the page, so the row is a dark blue over the darkened
+// page and never the light blue over a dark one (research L4), in a light
+// window and in a dark one. The switch off gives the row the declared
+// colour back.
+IN_PROC_BROWSER_TEST_F(PageColourRowTest, TheRowFollowsADarkenedPage) {
+  constexpr SkColor kThemeColour = SkColorSetRGB(0xe8, 0xf0, 0xfe);
+  const GURL striped(
+      "data:text/html,<meta name='theme-color' content='%23e8f0fe'>"
+      "<body style='margin:0'><div style='height:60px;background:"
+      "linear-gradient(90deg,%23d32f2f,%231976d2,%23388e3c,%23fbc02d)'>"
+      "</div><p>Striped header</p></body>");
+  Profile* const profile = browser()->GetProfile();
+  for (const ThemeService::BrowserColorScheme scheme :
+       {ThemeService::BrowserColorScheme::kLight,
+        ThemeService::BrowserColorScheme::kDark}) {
+    SCOPED_TRACE(scheme == ThemeService::BrowserColorScheme::kLight
+                     ? "light window"
+                     : "dark window");
+    ThemeServiceFactory::GetForProfile(profile)->SetBrowserColorScheme(scheme);
+    stedding::SetDarkPagesOn(profile, false);
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), striped));
+    ASSERT_TRUE(WaitForTheRow(kThemeColour))
+        << "the declared colour colours the row";
+
+    stedding::SetDarkPagesOn(profile, true);
+    EXPECT_TRUE(base::test::RunUntil([&]() {
+      return row()->color() && color_utils::IsDark(*row()->color());
+    })) << "the row is dark over the darkened page";
+    ASSERT_TRUE(row()->color());
+    EXPECT_TRUE(stedding::PageColorsMatch(
+        *row()->color(), stedding::DarkenLikeBlink(kThemeColour)))
+        << std::hex << *row()->color();
+    EXPECT_GT(SkColorGetB(*row()->color()), SkColorGetR(*row()->color()))
+        << "a dark blue, the theme colour's hue";
+
+    stedding::SetDarkPagesOn(profile, false);
+    EXPECT_TRUE(WaitForTheRow(kThemeColour))
+        << "the switch off gives the declared colour back";
+  }
+}
