+class VerticalTabStripRegionView::SpaceTint
+    : public spaces::SpaceModel::Observer {
+ public:
+  // `model` is the window's and outlives the window's views; `host` is the
+  // view whose widget wears the tint.
+  SpaceTint(spaces::SpaceModel& model, views::View& host)
+      : model_(model), host_(host) {
+    observation_.Observe(&model);
