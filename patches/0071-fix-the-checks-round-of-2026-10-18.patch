+  // layout, which showing the toolbar's button must not re-enter.
+  stedding_hand_over_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&DownloadToolbarUIController::HandOverToTheButtonOnScreen,
+                     weak_factory_.GetWeakPtr()));
