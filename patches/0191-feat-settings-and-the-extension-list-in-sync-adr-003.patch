+std::optional<base::Value> SettingToWire(const SettingRule& rule,
+                                         const base::Value& local,
+                                         const SpaceMap& spaces) {
+  switch (rule.shape) {
+    case SettingShape::kPlain:
+      return local.Clone();
+    case SettingShape::kSpace: {
+      if (!local.is_string()) {
+        return std::nullopt;
+      }
+      if (local.GetString().empty()) {
+        return base::Value(std::string());
+      }
+      const auto it = spaces.to_shared.find(local.GetString());
+      if (it == spaces.to_shared.end()) {
+        return std::nullopt;
+      }
+      return base::Value(it->second);
+    }
+    case SettingShape::kRoutes: {
+      base::ListValue wire;
+      if (!local.is_list()) {
+        return base::Value(std::move(wire));
+      }
+      for (const base::Value& entry : local.GetList()) {
+        const base::DictValue* const rule_dict = entry.GetIfDict();
+        const std::string* const space =
+            rule_dict ? rule_dict->FindString(kSpaceKey) : nullptr;
+        if (!space) {
+          continue;
+        }
+        const auto it = spaces.to_shared.find(*space);
+        if (it == spaces.to_shared.end()) {
+          // Sf61: a rule to a Space that is not synced stays here.
+          continue;
+        }
+        base::DictValue copy = rule_dict->Clone();
+        copy.Set(kSpaceKey, it->second);
+        wire.Append(std::move(copy));
+      }
+      return base::Value(std::move(wire));
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<base::Value> SettingFromWire(const SettingRule& rule,
+                                           const base::Value& wire,
+                                           const base::Value& local,
+                                           const SpaceMap& spaces) {
+  switch (rule.shape) {
+    case SettingShape::kPlain:
+      return wire.Clone();
+    case SettingShape::kSpace: {
+      if (!wire.is_string()) {
+        return std::nullopt;
+      }
+      if (wire.GetString().empty()) {
+        return base::Value(std::string());
+      }
+      const auto it = spaces.to_local.find(
+          Canonical(spaces.resolved, wire.GetString()));
+      if (it == spaces.to_local.end()) {
+        return std::nullopt;
+      }
+      return base::Value(it->second);
+    }
+    case SettingShape::kRoutes: {
+      if (!wire.is_list()) {
+        return std::nullopt;
+      }
+      base::ListValue out;
+      for (const base::Value& entry : wire.GetList()) {
+        const base::DictValue* const rule_dict = entry.GetIfDict();
+        const std::string* const space =
+            rule_dict ? rule_dict->FindString(kSpaceKey) : nullptr;
+        if (!space) {
+          continue;
+        }
+        const auto it =
+            spaces.to_local.find(Canonical(spaces.resolved, *space));
+        if (it == spaces.to_local.end()) {
+          // A Space this computer does not have yet: it comes with the
+          // sidebar, and the rule with the next read.
+          continue;
+        }
+        base::DictValue copy = rule_dict->Clone();
+        copy.Set(kSpaceKey, it->second);
+        out.Append(std::move(copy));
+      }
+      // Sf61: this computer's rules to Spaces that are not synced stay, and
+      // no other computer removes them.
+      if (local.is_list()) {
+        for (const base::Value& entry : local.GetList()) {
+          const base::DictValue* const rule_dict = entry.GetIfDict();
+          const std::string* const space =
+              rule_dict ? rule_dict->FindString(kSpaceKey) : nullptr;
+          if (space && !spaces.to_shared.contains(*space)) {
+            out.Append(entry.Clone());
+          }
+        }
+      }
+      return base::Value(std::move(out));
+    }
+  }
+  return std::nullopt;
+}
+
+bool CanonicalizeSettings(Settings& settings,
+                          const std::map<std::string, std::string>& resolved) {
+  if (resolved.empty()) {
+    return false;
+  }
+  bool changed = false;
+  for (auto& [path, field] : settings) {
+    const SettingRule* const rule = FindSettingRule(path);
+    if (!rule || rule->shape == SettingShape::kPlain) {
+      continue;
+    }
+    std::optional<base::Value> value =
+        base::JSONReader::Read(field.json, base::JSON_PARSE_RFC);
+    if (!value) {
+      continue;
+    }
+    if (rule->shape == SettingShape::kSpace) {
+      if (value->is_string()) {
+        *value = base::Value(Canonical(resolved, value->GetString()));
+      }
+    } else if (value->is_list()) {
+      for (base::Value& entry : value->GetList()) {
+        base::DictValue* const route = entry.GetIfDict();
+        const std::string* const space =
+            route ? route->FindString(kSpaceKey) : nullptr;
+        if (space) {
+          route->Set(kSpaceKey, Canonical(resolved, *space));
+        }
+      }
+    }
+    std::string json = SettingJson(*value);
+    if (json != field.json) {
+      field.json = std::move(json);
+      changed = true;
+    }
+  }
+  return changed;
+}
+
+bool IsExtensionId(std::string_view id) {
+  return id.size() == 32 && std::ranges::all_of(id, [](char c) {
+           return c >= 'a' && c <= 'p';
+         });
+}
+
+base::ListValue ExtensionsToValue(const std::vector<ExtensionEntry>& list) {
+  std::vector<ExtensionEntry> sorted = list;
+  std::ranges::sort(sorted, {}, &ExtensionEntry::id);
+  base::ListValue out;
+  for (const ExtensionEntry& entry : sorted) {
+    base::DictValue dict;
+    dict.Set("id", entry.id);
+    dict.Set("name", entry.name);
+    out.Append(std::move(dict));
+  }
+  return out;
+}
+
+std::optional<std::vector<ExtensionEntry>> ExtensionsFromValue(
+    const base::Value& value) {
+  const base::ListValue* const list = value.GetIfList();
+  if (!list || list->size() > kMaxPartEntries) {
+    return std::nullopt;
+  }
+  std::vector<ExtensionEntry> out;
+  for (const base::Value& entry : *list) {
+    const base::DictValue* const dict = entry.GetIfDict();
+    const std::string* const id = dict ? dict->FindString("id") : nullptr;
+    if (!id || !IsExtensionId(*id)) {
+      continue;
+    }
+    const std::string* const name = dict->FindString("name");
+    std::string kept;
+    if (name) {
+      base::TruncateUTF8ToByteSize(*name, kMaxTextLength, &kept);
+    }
+    out.push_back(ExtensionEntry{*id, std::move(kept)});
+  }
+  return out;
+}
