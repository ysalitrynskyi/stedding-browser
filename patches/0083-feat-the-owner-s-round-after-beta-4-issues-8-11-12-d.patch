+// copy-link L7 (GitHub issue 48): a little window, whose row is the main
+// window's (little E8), has the button, and it copies as a normal window's
+// does: a click the link without its trackers, with the check mark and the
+// toast (L5), an Option-click the Markdown link. Another popup has none;
+// ⇧⌘C is its way to copy.
+IN_PROC_BROWSER_TEST_F(CopyLinkTest, ALittleWindowHasTheButtonAPopupNone) {
+  BrowserWindowInterface* const little = stedding::OpenLittleWindow(
+      browser()->GetProfile(),
+      embedded_test_server()->GetURL(
+          "shop.test", "/empty.html?utm_source=mail&fbclid=abc&item=7"),
+      /*anchor=*/nullptr, /*untrusted_launch=*/false);
+  ASSERT_TRUE(little);
+  ASSERT_TRUE(stedding::IsLittleWindow(little));
+  ASSERT_TRUE(content::WaitForLoadStop(
+      little->GetTabStripModel()->GetActiveWebContents()));
+  ASSERT_TRUE(WaitForButton(little, true))
+      << "no Copy Link button in a little window";
+  page_actions::PageActionView* const button = ButtonOf(little);
+  EXPECT_EQ(u"Copy Link", button->GetViewAccessibility().GetCachedName());
+  const std::u16string clean = base::UTF8ToUTF16(
+      embedded_test_server()->GetURL("shop.test", "/empty.html?item=7").spec());
+  Click(button, ui::EF_NONE);
+  EXPECT_TRUE(ShowsTheCheckMark(button)) << "no check mark after the click";
+  EXPECT_EQ(clean, ClipboardText());
+  EXPECT_FALSE(clipboard()->last_write_off_the_record());
