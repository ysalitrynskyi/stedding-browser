#!/usr/bin/env bash
# Run shellcheck over every shell script in tooling/, exactly as CI does.
#
# This exists because CI and a developer machine had two separate definitions of
# "the shellcheck step", and they disagreed: a local Homebrew shellcheck passed
# while CI's older build failed on SC2015. A check you cannot reproduce locally
# is a check that gets pushed past. CI calls this script, so there is one
# definition and one behaviour.
#
# Note that shellcheck versions differ between machines and CI. Findings are not
# suppressed by severity here — if a finding is wrong, silence it at the line
# with a shellcheck directive and a reason, so the exception is visible.

set -euo pipefail

cd "$(cd "$(dirname "$0")/.." && pwd)"

scripts=()
while IFS= read -r f; do
  [ -n "$f" ] || continue
  scripts+=("$f")
done < <(
  # --others so a script that is written but not yet committed is checked too;
  # otherwise the first CI run after adding one is the first time it is seen.
  git ls-files --cached --others --exclude-standard 'tooling/*' | sort -u |
    while IFS= read -r f; do
    head -1 "$f" | grep -q '^#!.*\(bash\|sh\)$' && printf '%s\n' "$f"
  done
)
# lib.sh is sourced rather than executed, so it has no shebang of its own.
scripts+=(tooling/lib.sh)

pinned="$(cat tooling/shellcheck-version)"
found="$(shellcheck --version | awk '/^version:/{print $2}')"
printf 'shellcheck %s (pinned %s)\n' "$found" "$pinned"
if [ "$found" != "$pinned" ]; then
  # Versions disagree about real findings: 0.9.0 reports SC2015 on `[ a ] && [ b ] || c`
  # and 0.11.0 does not. A local pass under a different version is not evidence
  # that CI will pass, which is how this check stayed red once already.
  printf '!! local shellcheck is %s but CI runs %s; a pass here is not a pass there.\n' \
    "$found" "$pinned" >&2
  printf '   Install the pinned version, or expect CI to disagree.\n' >&2
fi
printf '  %s\n' "${scripts[@]}"

shellcheck -x "${scripts[@]}"

for f in "${scripts[@]}"; do
  bash -n "$f"
done

echo "shell checks passed"
