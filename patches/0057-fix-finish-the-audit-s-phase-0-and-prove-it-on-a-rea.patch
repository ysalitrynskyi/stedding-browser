+void TabStrip::OnTabFilterChanged(bool animate) {
+  if (!tab_container_) {
+    return;
+  }
+  // As for a focused group, the layout asks the controller which tabs take no
+  // room (IsTabFilteredOut). The visibility pass hides those at once rather
+  // than when they have shrunk, so a tab of another Space never takes a click
+  // or the keyboard focus on its way out.
+  UpdateHoverCard(nullptr, HoverCardUpdateType::kAnimating);
+  if (animate || drag_context_->IsDragSessionActive()) {
+    tab_container_->AnimateToIdealBounds();
+    tab_container_->SetTabSlotVisibility();
+  } else {
+    tab_container_->CompleteAnimationAndLayout();
+  }
+  SchedulePaint();
+}
