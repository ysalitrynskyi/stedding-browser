+// A9: the tabs of a window and of a split closed whole are rows too, each
+// saying what it closed with, at the close's time. They were not listed, and
+// Clear archive deleted them unseen (BACKLOG S-187).
+TEST(ArchivePageTest, AClosedWindowsAndSplitsTabsAreRows) {
+  const base::Time now = base::Time::Now();
+  sessions::TabRestoreService::Entries entries;
+  auto window = std::make_unique<sessions::tab_restore::Window>();
+  window->id = SessionID::FromSerializedValue(10);
+  window->timestamp = now - base::Hours(1);
+  window->tabs.push_back(ClosedTab(11, "https://w1.example/", u"W1",
+                                   base::Time(), nullptr));
+  window->tabs.push_back(ClosedTab(12, "https://w2.example/", u"W2",
+                                   base::Time(), nullptr));
+  entries.push_back(std::move(window));
+  auto split = std::make_unique<sessions::tab_restore::Split>();
+  split->id = SessionID::FromSerializedValue(20);
+  split->timestamp = now - base::Hours(2);
+  split->tabs.push_back(ClosedTab(21, "https://s1.example/", u"S1",
+                                  base::Time(), nullptr));
+  split->tabs.push_back(ClosedTab(22, "https://s2.example/", u"S2",
+                                  base::Time(), nullptr));
+  entries.push_back(std::move(split));
+
+  const std::vector<ArchivedTab> shown =
+      ListArchivedTabs(entries, now, base::Days(30));
+  ASSERT_EQ(4u, shown.size());
+  EXPECT_EQ(u"W1", shown[0].title);
+  EXPECT_EQ(SessionID::FromSerializedValue(11), shown[0].id)
+      << "the tab's own id, which restores it alone";
+  EXPECT_EQ("window", shown[0].closed_with);
+  EXPECT_EQ(2, shown[0].closed_count);
+  EXPECT_EQ(now - base::Hours(1), shown[0].time) << "the window's time";
+  EXPECT_EQ(u"S2", shown[3].title);
+  EXPECT_EQ("split", shown[3].closed_with);
+  const base::DictValue value = ArchivedTabToValue(shown[3]);
+  const std::string* const closed_with = value.FindString("closedWith");
+  ASSERT_TRUE(closed_with);
+  EXPECT_EQ("split", *closed_with);
+  EXPECT_EQ(0u,
+            ListArchivedTabs(entries, now, base::Minutes(30)).size())
+      << "the retention reads the close's time";
+}
