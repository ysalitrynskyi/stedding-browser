+  before.lists[PinsListOf(kWork)] = {kPinA, kFolder};
+  before.lists[kFolder] = {kPinB};
+  State state = StateOf(before, 100, kOffice);
+  ASSERT_FALSE(state.records.at(kFolder).f.contains(kFieldIcon));
+
+  LocalView now = before;
+  now.items[kFolder].fields[kFieldIcon] = "";
