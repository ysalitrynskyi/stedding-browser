+// commandbar K41 (CMD-22): a screen reader hears a dialog with a name.
+TEST_F(CommandBarViewTest, TheBarIsADialogToAScreenReader) {
+  AddTab(browser(), GURL("https://example.com/"));
+  auto bar = std::make_unique<CommandBarView>(browser());
+  ui::AXNodeData data;
+  bar->GetViewAccessibility().GetAccessibleNodeData(&data);
+  EXPECT_EQ(ax::mojom::Role::kDialog, data.role);
+  EXPECT_EQ("Command bar",
+            data.GetStringAttribute(ax::mojom::StringAttribute::kName));
+}
+
+// commandbar K42 (CMD-23): Enter in an empty bar opens the New Tab page, and
+// a row chosen with an arrow key still runs. It went to the row on top, the
+// tab already on screen, so nothing opened.
+TEST_F(CommandBarViewTest, EnterInAnEmptyBarOpensANewTab) {
+  AddTab(browser(), GURL("https://example.com/a"));
+  AddTab(browser(), GURL("https://example.com/b"));
+  {
+    auto bar = std::make_unique<CommandBarView>(browser());
+    ASSERT_GT(bar->row_count_for_testing(), 0u);
+    const int before = tabs().count();
+    EXPECT_TRUE(Enter(*bar));
+    EXPECT_EQ(before + 1, tabs().count());
+  }
+  {
+    auto bar = std::make_unique<CommandBarView>(browser());
+    const int before = tabs().count();
+    Down(*bar);
+    EXPECT_TRUE(Enter(*bar));
+    EXPECT_EQ(before, tabs().count()) << "a chosen row opened a tab";
+  }
+}
+
