+namespace {
+
+SpaceModel* ModelOf(tabs::TabInterface* tab) {
+  BrowserWindowInterface* const window =
+      tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return window ? SpaceModel::From(window) : nullptr;
+}
+
+void RebindLeftTab(
+    tabs::TabHandle handle,
+    std::unique_ptr<content::NavigationController::LoadURLParams> load,
+    int history_offset) {
+  tabs::TabInterface* const tab = handle.Get();
+  if (SpaceModel* const model = ModelOf(tab)) {
+    model->RebindLeftTab(tab, std::move(load), history_offset);
+  }
+}
+
+}  // namespace
+
+// static
+void SpaceJarNavigationThrottle::MaybeCreateAndAdd(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& handle = registry.GetNavigationHandle();
+  // Only a tab of a window with Spaces has a Space's jar to be in.
+  if (handle.IsInPrimaryMainFrame() &&
+      ModelOf(tabs::TabInterface::MaybeGetFromContents(
+          handle.GetWebContents()))) {
+    registry.AddThrottle(
+        std::make_unique<SpaceJarNavigationThrottle>(registry));
+  }
+}
+
+SpaceJarNavigationThrottle::SpaceJarNavigationThrottle(
+    content::NavigationThrottleRegistry& registry)
+    : content::NavigationThrottle(registry) {}
+
+SpaceJarNavigationThrottle::~SpaceJarNavigationThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+SpaceJarNavigationThrottle::WillStartRequest() {
+  content::NavigationHandle* const handle = navigation_handle();
+  content::WebContents* const contents = handle->GetWebContents();
+  tabs::TabInterface* const tab =
+      tabs::TabInterface::MaybeGetFromContents(contents);
+  SpaceModel* const model = ModelOf(tab);
+  const std::optional<SpaceId> space =
+      model ? model->FindSpaceForTab(tab) : std::nullopt;
+  if (!space || !NeedsOtherJar(contents, handle->GetURL(), model->registry(),
+                               *space, tab->IsPinned())) {
+    return PROCEED;
+  }
+  // A form a web page sends goes with the session the page was filled in:
+  // made again in the other jar it could arrive signed out, and what was
+  // typed would be lost. The tab moves at its next navigation instead.
+  if (handle->IsPost() &&
+      PageBelongsInSpaceJar(contents->GetLastCommittedURL())) {
+    return PROCEED;
+  }
+  std::unique_ptr<content::NavigationController::LoadURLParams> load;
+  // A step back or forward keeps its offset; a new page's is 1, which is not
+  // a step anywhere.
+  const bool history = handle->IsHistory();
+  const int history_offset = history ? handle->GetNavigationEntryOffset() : 0;
+  if (handle->GetReloadType() == content::ReloadType::NONE && !history) {
+    load = std::make_unique<content::NavigationController::LoadURLParams>(
+        handle->GetURL());
+    const blink::mojom::Referrer& referrer = handle->GetReferrer();
+    load->referrer = content::Referrer(referrer.url, referrer.policy);
+    load->transition_type = handle->GetPageTransition();
+    load->initiator_origin = handle->GetInitiatorOrigin();
+    load->is_renderer_initiated = handle->IsRendererInitiated();
+    load->has_user_gesture = handle->HasUserGesture();
+    if (handle->IsPost()) {
+      load->load_type = content::NavigationController::LOAD_TYPE_HTTP_POST;
+      load->post_data = handle->GetPostData();
+    }
+  }
+  // The contents go with the rebind, and this navigation with them: the
+  // rebind waits a turn, until the cancel is done.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&RebindLeftTab, tab->GetHandle(),
+                                std::move(load), history_offset));
+  return CANCEL_AND_IGNORE;
+}
+
