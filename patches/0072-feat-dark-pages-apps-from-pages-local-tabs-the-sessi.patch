+// Every drawn row under `root`.
+void CollectDrawnRows(views::View* root, std::vector<TabView*>& rows) {
+  if (TabView* const row = views::AsViewClass<TabView>(root);
+      row && row->IsDrawn()) {
+    rows.push_back(row);
+  }
+  for (views::View* const child : root->children()) {
+    CollectDrawnRows(child, rows);
+  }
+}
