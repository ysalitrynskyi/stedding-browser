From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yevhen Salitrynskyi <ysalitrynskyi@gmail.com>
Date: Fri, 6 Nov 2026 13:17:00 -0500
Subject: fix: a little window keeps its size through a second restart

Nothing moves a restored window, so a launch's session held no bounds for a
little window it brought back, and the launch after it made the window at a new
window's size, over the main window. The restored window now writes the bounds
it came back with. Seen on the Mac as 1120 by 704 coming back at 1400 by 914,
and reproduced there on a real quit and launch; a browser test's quit writes the
bounds anyway, so its three launches pass either way.

Why: seen on beta 11 (BACKLOG S-436, little E12).

Removable when: little windows are no longer kept in the session.
---
 chrome/browser/sessions/session_restore.cc    |  5 ++
 .../stedding/little_window_browsertest.cc     | 58 +++++++++++++------
 2 files changed, 46 insertions(+), 17 deletions(-)

diff --git a/chrome/browser/sessions/session_restore.cc b/chrome/browser/sessions/session_restore.cc
index 641877b8018d3..28febc470ee64 100644
--- a/chrome/browser/sessions/session_restore.cc
+++ b/chrome/browser/sessions/session_restore.cc
@@ -76,6 +76,7 @@
 #include "chrome/browser/ui/browser_window/public/create_browser_window.h"
 #include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
 #include "chrome/browser/ui/browser_window/public/profile_browser_collection.h"
+#include "chrome/browser/ui/browser_window_state.h"
 #include "chrome/browser/ui/navigator/browser_navigator.h"
 #include "chrome/browser/ui/navigator/browser_navigator_params.h"
 #include "chrome/browser/ui/startup/startup_browser_creator.h"
@@ -1550,6 +1551,10 @@ class SessionRestoreImpl : public BrowserCollectionObserver {
       stedding::SetNextWindowLittle(false);
       stedding::MarkLittleWindow(browser_window);
       stedding::KeepLittleWindowInSession(browser_window);
+      // little E12 (BACKLOG S-436): nothing moves a restored window, so this
+      // launch's session would hold no bounds for it, and the next launch
+      // would bring it back at a new window's size.
+      chrome::SaveWindowPlacement(browser_window, bounds, show_state);
     }
     if (auto* manager =
             InitialWebUIWindowMetricsManager::From(browser_window)) {
diff --git a/chrome/test/stedding/little_window_browsertest.cc b/chrome/test/stedding/little_window_browsertest.cc
index 1a86c815dae05..d03f320901af9 100644
--- a/chrome/test/stedding/little_window_browsertest.cc
+++ b/chrome/test/stedding/little_window_browsertest.cc
@@ -751,10 +751,34 @@ class LittleWindowRestoreTest : public InProcessBrowserTest {
     SessionStartupPref::SetStartupPref(
         browser()->GetProfile(), SessionStartupPref(SessionStartupPref::LAST));
   }
+
+  void ExpectALittleWindowCameBack() {
+    BrowserWindowInterface* popup = nullptr;
+    ASSERT_TRUE(base::test::RunUntil([&]() {
+      for (BrowserWindowInterface* const window :
+           GetAllBrowserWindowInterfaces()) {
+        if (window->GetType() == BrowserWindowInterface::TYPE_POPUP) {
+          popup = window;
+        }
+      }
+      return popup != nullptr;
+    })) << "the little window did not come back";
+    EXPECT_TRUE(stedding::IsLittleWindow(popup))
+        << "it came back as a plain popup";
+    const PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+    EXPECT_EQ(gfx::Size(prefs->GetInteger(stedding::prefs::kLittleWidth),
+                        prefs->GetInteger(stedding::prefs::kLittleHeight)),
+              popup->GetWindow()->GetBounds().size())
+        << "it came back at another size";
+    EXPECT_EQ(embedded_test_server()->GetURL("/title1.html").path(),
+              popup->GetTabStripModel()->GetActiveWebContents()
+                  ->GetVisibleURL()
+                  .path());
+  }
 };
 
 IN_PROC_BROWSER_TEST_F(LittleWindowRestoreTest,
-                       PRE_ALittleWindowComesBackLittle) {
+                       PRE_PRE_ALittleWindowComesBackLittle) {
   BrowserWindowInterface* const little = stedding::OpenLittleWindow(
       browser()->GetProfile(), embedded_test_server()->GetURL("/title1.html"),
       browser(), /*untrusted_launch=*/false);
@@ -763,25 +787,25 @@ IN_PROC_BROWSER_TEST_F(LittleWindowRestoreTest,
   // Loaded, so the session has its page: a tab with none is left out.
   ASSERT_TRUE(content::WaitForLoadStop(
       little->GetTabStripModel()->GetActiveWebContents()));
+  // little E12 (BACKLOG S-436): the size it opened at, as the next launch
+  // reads it. These two are the size of a little window the user resized,
+  // and nothing here reads them again.
+  PrefService* const prefs = browser()->GetProfile()->GetPrefs();
+  const gfx::Size size = little->GetWindow()->GetBounds().size();
+  prefs->SetInteger(stedding::prefs::kLittleWidth, size.width());
+  prefs->SetInteger(stedding::prefs::kLittleHeight, size.height());
+}
+
+// little E12 (BACKLOG S-436): twice. A window restored is never moved, so this
+// launch's session had no bounds for it, and the launch after it came back at
+// a new window's size.
+IN_PROC_BROWSER_TEST_F(LittleWindowRestoreTest,
+                       PRE_ALittleWindowComesBackLittle) {
+  ExpectALittleWindowCameBack();
 }
 
 IN_PROC_BROWSER_TEST_F(LittleWindowRestoreTest, ALittleWindowComesBackLittle) {
-  BrowserWindowInterface* popup = nullptr;
-  ASSERT_TRUE(base::test::RunUntil([&]() {
-    for (BrowserWindowInterface* const window :
-         GetAllBrowserWindowInterfaces()) {
-      if (window->GetType() == BrowserWindowInterface::TYPE_POPUP) {
-        popup = window;
-      }
-    }
-    return popup != nullptr;
-  })) << "the little window did not come back";
-  EXPECT_TRUE(stedding::IsLittleWindow(popup))
-      << "it came back as a plain popup";
-  EXPECT_EQ(embedded_test_server()->GetURL("/title1.html").path(),
-            popup->GetTabStripModel()->GetActiveWebContents()
-                ->GetVisibleURL()
-                .path());
+  ExpectALittleWindowCameBack();
 }
 
 }  // namespace
